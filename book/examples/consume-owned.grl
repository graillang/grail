fn total_lengths(items: string[]) -> u64 {
    mut total: u64 = 0;
    for item in items { // Each iteration owns its element; the vector is consumed.
        total += item.len();
    }
    return total;
}
fn main() {
    mut words: string[] = string[];
    words.push("alpha");
    words.push("be");
    println(total_lengths(words));
    kept := string["one", "three"];
    mut letters: u64 = 0;
    for word in &kept { // Borrowing keeps the vector usable afterwards.
        letters += word.len();
    }
    println(letters);
    println(kept.len());
}
