struct Stats {
    low: i32,
    high: i32,
    mean: f64
}
fn stats(values: i32[]) -> Stats {
    mut low = values[0];
    mut high = values[0];
    mut total: i32 = 0;
    for v in values {
        if v < low { low = v; }
        if v > high { high = v; }
        total += v;
    }
    Stats { low, high, mean: f64(total) / f64(values.len()) }
}
fn label(temp: i32) -> string {
    return match temp {
        t if t < 0 => "freezing",
        0..15 => "cold",
        15..25 => "mild",
        _ => "hot"
    };
}
fn main() {
    s := stats(i32[12, -3, 21, 30]);
    println("low {} high {} mean {:.1}", s.low, s.high, s.mean);
    for t in i32[s.low, 12, s.high] {
        println("{:>4} {}", t, label(t));
    }
    println("{} {}", s.low, s.high);
}
