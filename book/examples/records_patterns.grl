struct Stats {
    low: i32,
    high: i32,
    mean: f64
}
fn stats(values: i32[]) -> Stats {
    mut low = values[0];
    mut high = values[0];
    mut total: i32 = 0;
    for v in values {
        if v < low {
            low = v;
        }
        if v > high {
            high = v;
        }
        total += v;
    }
    return Stats { low, high, mean: f64(total) / f64(values.len()) };
}
fn label(temp: i32) -> string {
    match temp {
        t if t < 0 => {
            return "freezing";
        },
        0..15 => {
            return "cold";
        },
        15..25 => {
            return "mild";
        },
        _ => {
            return "hot";
        },
    }
}
fn main() {
    stats := stats(i32[12, -3, 21, 30]);
    low := stats.low;
    high := stats.high;
    mean := stats.mean;
    println("low {} high {} mean {:.1}", low, high, mean);
    for t in i32[low, 12, high] {
        println("{:>4} {}", t, label(t));
    }
    println("{} {}", low, high);
}
