enum Result { Ok(bytes), Err(string) }
fn make(flag: num) -> Result {
    if flag { return Result::Err("missing"); }
    return Result::Ok(bytes[]);
}
fn forward(flag: num) -> Result {
    value := make(flag)?; // Return Err early, or move out the Ok payload.
    return Result::Ok(value);
}
fn main() {
    ok := forward(false)!; // Abort on Err; use only when failure is a bug.
    assert(ok.len()==0);
    match forward(true) {
        Ok(data)=>{ println(data.len()); return (); }, Err(message)=>{ println(message.len()); return (); }
    }
}
