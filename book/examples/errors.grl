fn make(flag: bool) -> u8[] |? string {
    return if flag { "missing" } else { u8[] };
}
fn forward(flag: bool) -> u8[] |? string {
    return make(flag)?; // Return the string early, or move out the byte vector.
}
fn main() {
    ok := forward(false)!; // Abort on failure; use only when failure is a bug.
    assert(ok.len() == 0);
    match forward(true) {
        data: u8[] => println(data.len()),
        message: string => println(message.len())
    }
}
