fn make(flag: u64) -> u8[] |? string {
    if flag {
        return "missing";
    }
    return u8[];
}
fn forward(flag: u64) -> u8[] |? string {
    value := make(flag)?; // Return the string early, or move out the byte vector.
    return value;
}
fn main() {
    ok := forward(false)!; // Abort on failure; use only when failure is a bug.
    assert(ok.len() == 0);
    match forward(true) {
        data: u8[] => {
            println(data.len());
            return ();
        },
        message: string => {
            println(message.len());
            return ();
        }
    }
}
