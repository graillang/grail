fn make(flag: num) -> u8[] | string {
    if flag { return "missing".text(); }
    return u8[];
}
fn forward(flag: num) -> u8[] | string {
    value := make(flag)?; // Return the string early, or move out the byte vector.
    return value;
}
fn main() {
    ok := forward(false)!; // Abort on failure; use only when failure is a bug.
    assert(ok.len()==0);
    match forward(true) {
        u8[](data)=>{ println(data.len()); return (); }, string(message)=>{ println(message.len()); return (); }
    }
}
