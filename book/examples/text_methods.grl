use strings;
fn initials(name: string) -> string {
    mut out = "";
    parts := name.split(' ');
    for part in &parts {
        if !part.is_empty() {
            out = out + part[: 1];
        }
    }
    return out.to_upper();
}
fn main() {
    line := "  name = Ada Lovelace  ";
    clean := line.trim();
    println("[{}]", clean);
    if clean.starts_with("name") && clean.contains("=") {
        fields := clean.split('=');
        value := fields[1].trim();
        println("value: {}", value);
        println("upper: {}", value.to_upper());
        println("replaced: {}", value.replace("Ada", "Augusta Ada"));
    }
    greeting := "Hello, " + "world";
    println(greeting == "Hello, world");
    println("apple" < "banana");
    println(initials("ada lovelace"));
}
