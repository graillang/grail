use authority;

fn main() {
    // The grant is a value: read files under this example's scratch directory.
    a := authority::open_read(".")!;
    data := authority::read_file(&a, "note.txt")!;
    println(data.len());
    // The same call outside the grant is refused before any file is opened.
    mut denied = 0;
    match authority::read_file(&a, "../outside.txt") {
        e: authority::Error => { denied = 1; },
        _ => {}
    }
    println(denied);
    // A read grant carries no write permission.
    mut refused = 0;
    match authority::write_file(&a, "copy.txt", "x") {
        e: authority::Error => { refused = 1; },
        _ => {}
    }
    println(refused);
}
