use strings;

fn main() {
    text := "aé€👋".text();
    println("{} bytes, {} characters", text.len(), strings::char_count(view(text)));
    for pair in strings::char_indices(view(text)).collect() {
        (at, c) := pair; // A binding destructures a tuple; a `for` header does not yet.
        println("{} {}", at, u64(c));
    }
    mut back = u8[];
    it := strings::chars(view(text));
    for c in it {
        strings::push_char(&mut back, c);
    }
    println("round trip: {}", strings::is_utf8(view(back)));
    bad := u8[104, 226, 130, 65, 255];
    println("valid: {}", strings::is_utf8(view(bad)));
    match strings::utf8_error(view(bad)) {
        Some(at) => println("first bad byte: {}", at),
        None => println("valid")
    }
    mut lossy = u8[];
    broken := strings::chars(view(bad));
    for c in broken {
        strings::push_char(&mut lossy, c);
    }
    println(lossy);
    println("{} {}", strings::is_char_boundary(view(text), 3), strings::is_char_boundary(view(text), 4));
}
