use strings;

fn main() {
    text := "aé€👋".text();
    println("{} bytes, {} characters", text.len(), view(text).char_count());
    for pair in view(text).char_indices().collect() {
        (at, c) := pair; // A binding destructures a tuple; a `for` header does not yet.
        println("{} {}", at, u64(c));
    }
    mut back = u8[];
    it := text.chars();
    for c in it {
        back.push_char(c);
    }
    println("round trip: {}", view(back).is_utf8());
    bad := u8[104, 226, 130, 65, 255];
    println("valid: {}", view(bad).is_utf8());
    match view(bad).utf8_error() {
        Some(at) => println("first bad byte: {}", at),
        None => println("valid")
    }
    mut lossy = u8[];
    broken := bad.chars();
    for c in broken {
        lossy.push_char(c);
    }
    println(lossy);
    println("{} {}", view(text).is_char_boundary(3), view(text).is_char_boundary(4));
}
