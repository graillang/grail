// A value parameter is part of which function is called: `rotl<13>` and `rotl<17>` are two
// functions, each with its constant baked in, as `max<u8>` and `max<u64>` are.
fn rotl < @k: u64 > (x: u64) -> u64 {
    // Checked once per instantiation, while compiling.
    @assert(k < 64, "rotate amount out of range");
    if k == 0 {
        return x;
    }
    (x << k) | (x >> (64 - k))
}

fn checksum < @seed: u64 > (bytes: u8[]) -> u64 {
    mut h = seed;
    for b in &bytes {
        h = rotl<5>(h) ^ u64(b);
    }
    h
}

fn main() -> u64 {
    println(rotl<13>(1));
    println(rotl<17>(1));
    println(checksum<7>(u8[1, 2, 3]));
    0
}
