enum Outcome {
    Good(u8[]),
    Empty
}
fn make(flag: bool) -> Outcome {
    if flag {
        return Outcome::Good(u8[7]);
    }
    return Outcome::Empty;
}
fn main() {
    match make(true) {
        Good(data) => {
            println(data.len());
            return ();
        },
        Empty => {
            println(0);
            return ();
        }
    }
}
