module enums;
enum Outcome { Good(bytes), Empty }
fn make(flag: num) -> Outcome {
    if flag { let data = bytes(); push(data, 7); return Outcome::Good(data); }
    return Outcome::Empty;
}
fn main() {
    match make(1) {
        Good(data)=>{ println(len(data)); return (); }, Empty=>{ println(0); return (); }
    }
}
