use core;
struct Holder<T, U> {
    first: T,
    second: U?
}
fn main() {
    holder := Holder { first: 42, second: core::some(u8[]) };
    match holder.second {
        Some(value) => {
            assert(value.len() == 0);
        },
        None => {
            assert(0);
        }
    }
    empty: u64? := core::none<u64>();
    drop(empty);
    println(holder.first);
}
