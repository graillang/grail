module generic_types_example;
struct Pair<type T, type U> { first: T, second: U }
enum Option<type T> { Some(T), None }
fn main() {
    let pair = Pair<num, bytes>{first: 42, second: bytes()};
    let some = Option<bytes>::Some(pair.second);
    match some {
        Some(value)=>{ assert(len(value)==0); }, None=>{ assert(0); }
    }
    let empty = Option<num>::None;
    drop(empty);
    println(pair.first);
}
