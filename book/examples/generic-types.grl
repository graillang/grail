struct Pair<T, U> { first: T, second: U }
enum Option<T> { Some(T), None }
fn main() {
    pair := Pair{first: 42, second: bytes[]};
    some := Option::Some(pair.second);
    match some {
        Some(value)=>{ assert(value.len()==0); }, None=>{ assert(0); }
    }
    empty := Option<num>::None;
    drop(empty);
    println(pair.first);
}
