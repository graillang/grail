fn average(values: f64[]) -> f64 {
    mut total = 0.0;
    for v in values {
        total += v;
    }
    total / f64(values.len())
}
fn main() {
    println(0.1 + 0.2);
    println(average(f64[2.5, 3.0, 4.75]));
    side := 2.0;
    println("diagonal {}", (side * side * 2.0).sqrt());
    println(i64(-7.9));
    println(1.0 / 0.0);
}
