// Constants are computed while compiling. `@` marks the forms that decide something before the
// program runs.
const PAGE: u64 = 4 * 1024;
MASK := PAGE - 1;
VERBOSE := false;

// A C-layout record: its size is a fact of the target, so it can be asserted.
extern "C" record Header {
    magic: u32,
    flags: u16,
    kind: u8,
    pad: u8,
    size: u64
}
@assert(size_of(Header) == 16, "Header is read from disk as 16 bytes");

// Only one of these definitions exists in any build.
@if target.os == .windows {
    fn separator() -> string {
        "\\"
    }
} else {
    fn separator() -> string {
        "/"
    }
}

fn round_up(n: u64) -> u64 {
    (n + MASK) & (MASK ^ 18446744073709551615)
}

fn main() -> u64 {
    @assert((PAGE & MASK) == 0, "PAGE must be a power of two");
    println(round_up(5000));
    println("path{}to", separator());
    @if VERBOSE {
        println("verbose build");
    }
    println(size_of(u32) + size_of(Header));
    0
}
