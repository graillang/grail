const PAGE: u64 = 4096;
static MASK: u64 = PAGE - 1;
static NAME: string = "grail";
static SQUARES: u64[] = @squares();

fn squares() -> u64[] {
    mut v = u64[];
    for i in 8 {
        v.push(i * i);
    }
    v
}

fn sum(v: &u64[]) -> u64 {
    mut total = 0;
    for i in v.len() {
        total += v[i];
    }
    total
}

fn main() -> u64 {
    println(MASK);
    println(NAME);
    println(SQUARES[3]);
    println(sum(SQUARES));
    0
}
