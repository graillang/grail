struct Counter {
    name: string,
    count: u32,
}
impl Counter {
    fn new(name: string) -> Counter {
        return Counter { name: name, count: 0 };
    }
    fn add<a>(self: ref_mut<a, Counter>, amount: u32) {
        self.count = self.count + amount;
    }
    fn report<a>(self: ref<a, Counter>) -> string {
        return format("{} = {}", self.name, self.count);
    }
}
fn main() {
    mut visits = Counter::new("visits".text());
    for day in 1..4 {
        visits.add(u32(day));
    }
    println(visits.report());
    if visits.count > 5 {
        println("busy week");
    } else if visits.count > 0 {
        println("quiet week");
    }
}
