use core;
use iter;

fn main() -> u64 {
    // Adapters are lazy: nothing runs until the loop or `collect` pulls items through.
    squares := iter::collect(iter::map(iter::upto(1, 6), |x: u64| -> u64 x * x));
    println(squares.len());
    mut evens = 0;
    for e in iter::filter(iter::upto(0, 10), |x: &u64| -> bool *x % 2 == 0) {
        evens = evens + e;
    }
    println(evens);
    // `take` stops a long (here, 900-item) source after three items.
    for p in iter::enumerate(iter::take(iter::upto(100, 1000), 3)) {
        println("{}: {}", p.index, p.value);
    }
    for z in iter::zip(iter::upto(1, 4), iter::of(squares)) {
        println("{} squared is {}", z.left, z.right);
    }
    return 0;
}
