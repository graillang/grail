use core;
use iter;

fn main() -> u64 {
    // Adapters are lazy: nothing runs until the loop or `collect` pulls items through.
    squares := iter::upto(1, 6).map(|x: u64| -> u64 x * x).collect();
    println(squares.len());
    mut evens = 0;
    for e in iter::upto(0, 10).filter(|x: &u64| -> bool *x % 2 == 0) {
        evens = evens + e;
    }
    println(evens);
    // `take` stops a long (here, 900-item) source after three items.
    for p in iter::upto(100, 1000).take(3).enumerate() {
        println("{}: {}", p.0, p.1);
    }
    for z in iter::upto(1, 4).zip(iter::of(squares)) {
        println("{} squared is {}", z.0, z.1);
    }
    0
}
