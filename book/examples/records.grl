struct Message {
    body: u8[],
    label: string
}
fn main() {
    body := u8[];
    label := "note";
    message := Message { body, label };
    moved := message.body; // Partial move; label is still owned by message.
    assert(message.label.len() == 4);
    println(moved.len() + message.label.len());
}
