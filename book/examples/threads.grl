use thread;
fn third(v: (&u64[])) -> u64 {
    v[2]
}
fn main() {
    // A thread owns what its closure captured and hands back an owned result at the join.
    numbers := u64[10, 20, 30, 40];
    worker := thread::spawn<u64>(thread::config(), |ctx: (&thread::Ctx)| -> u64 {
        mut total = 0;
        for i in numbers.len() {
            total += numbers[i];
        }
        total
    })!;
    println(worker.join());

    // A check that fails on a thread ends that thread, not the program: the failure is a value.
    short := u64[1, 2];
    failing := thread::spawn<u64>(thread::config(), |ctx: (&thread::Ctx)| -> u64 { third(&short) })!;
    match failing.try_join() {
        v: u64 => println(v),
        f: TaskFailure => {
            println("failed: {}", f.message);
        }
    }

    // A named thread pinned to processor 0. The name is a label; the pin is a contract, so the OS
    // may refuse it, and then `spawn` says so instead of running the closure somewhere else.
    mut cfg = thread::config();
    cfg.name = "render".text();
    cfg.affinity = Some(thread::cpus(u64[0]));
    match thread::spawn<u64>(cfg, |ctx: (&thread::Ctx)| -> u64 { 7 }) {
        t: thread::Thread<u64> => {
            t.join();
            println("the OS answered the pin");
        },
        e: thread::Error => {
            println("the OS answered the pin");
        }
    }
}
