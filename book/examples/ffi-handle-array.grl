// An array of handles: a record of `handle` fields is laid out contiguously, so the record's
// address is the array C writes into. This is how `pCommandBuffers` and `pSwapchains` reach a
// submit or present call - C fills the slots through `&mut`, or Grail seeds them from handles it
// already holds.
//
// `book/ffi/handle-array.c` is the C side, compiled by clang beside this file.
handle CommandBuffer;

extern "C" record CommandBuffers {
    b0: CommandBuffer,
    b1: CommandBuffer,
    b2: CommandBuffer,
    b3: CommandBuffer
}

extern "C" lib "handle-array.o" fn c_alloc_buffers(out: &mut CommandBuffers) -> i64;
extern "C" lib "handle-array.o" fn c_sum_buffers(buffers: CommandBuffers) -> i64;
extern "C" lib "handle-array.o" fn c_first(buffers: CommandBuffers) -> CommandBuffer;

fn main() -> u64 {
    // No Grail code can construct a handle, so the array starts as storage rather than as a value:
    // `&mut buffers` is a valid `struct command_buffers *`, every slot reads as the null handle,
    // and reading a field before C wrote one is refused - zeroed bytes are not an initialised
    // handle.
    mut buffers: CommandBuffers;
    mut count: i64 = 0;
    unsafe {
        count = c_alloc_buffers(&mut buffers);
    }
    println(count); // 4

    // The fields are values now. A record parameter is the address of its fields, so the same
    // array goes back to C without a copy.
    mut total: i64 = 0;
    unsafe {
        total = c_sum_buffers(buffers);
    }
    println(total); // 4097 + 4098 + 4099 + 4100

    // A second array built from handles the program already holds: the slots are seeded by the
    // program, not filled by C.
    mut seeded = CommandBuffers {
        b0: buffers.b0,
        b1: buffers.b0,
        b2: buffers.b0,
        b3: buffers.b3
    };
    mut seeded_total: i64 = 0;
    unsafe {
        seeded_total = c_sum_buffers(seeded);
    }
    println(seeded_total); // 4097 * 3 + 4100

    // Handles compare by identity, so the handle read out of the array is provably the handle C
    // wrote into it.
    mut back: CommandBuffer;
    unsafe {
        back = c_first(buffers);
    }
    mut same: u64 = 0;
    if buffers.b0 == back { same = 1; }
    println(same); // 1
    return 0;
}
