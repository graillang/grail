// This is an intentional compile error.
//
// An `extern "C"` record declared without an initializer is storage: `sizeof(struct)` zeroed
// bytes, so `&mut caps` is a valid pointer for C to fill and a field C does not overwrite reads 0.
// The binding still holds no *value*, though, and reading a field before a foreign call or an
// assignment wrote one is refused - which is what keeps a zeroed handle from being read as one.
extern "C" record Caps { width: u32, height: u32 } fn main() -> u64 {
    mut caps: Caps;
    println(caps.width);
    0
}
