fn rect(area: u64, width: u64, height: u64) -> u64 {
    return area + width * height;
}
fn scaled(value: u64, by: u64 = 2, plus: u64 = 0) -> u64 {
    return value * by + plus;
}
fn main() {
    println(rect(width: 3, height: 4, area: 0));
    println(rect(1, height: 2, width: 5));
    println(scaled(5));
    println(scaled(5, plus: 7));
}
