use core;

// A record with `next(self: &mut Self) -> T?` is an iterator: `for x in it` calls `next` until it
// returns None.
struct Countdown {
    n: u64
}
impl Countdown {
    fn next(self: &mut Self) -> u64? {
        if self.n == 0 {
            return None;
        }
        self.n = self.n - 1;
        return Some(self.n);
    }
}

// An iterator that borrows a vector hands out references into it; while it lives, the vector
// cannot be changed.
struct Items<a> {
    items: (&a u64[]),
    pos: u64
}
impl<a> Items<a> {
    fn next(self: &mut Self) -> (&a u64)? {
        if self.pos < self.items.len() {
            p := self.pos;
            self.pos = p + 1;
            return Some(&self.items[p]);
        }
        return None;
    }
}

fn main() -> u64 {
    // `&mut it` lends the iterator to the loop, so it can carry on afterwards.
    mut count = Countdown { n: 5 };
    for x in &mut count {
        if x == 2 {
            break;
        }
        println(x);
    }
    for x in &mut count {
        println("then {}", x);
    }
    prices := u64[120, 80, 45];
    mut total = 0;
    for p in Items { items: &prices, pos: 0 } {
        total = total + *p;
    }
    println("total {}", total);
    return 0;
}
