fn stats(values: i32[]) -> (i32, i32, f64) {
    mut low = values[0];
    mut high = values[0];
    mut total: i32 = 0;
    for v in values {
        if v < low {
            low = v;
        }
        if v > high {
            high = v;
        }
        total += v;
    }
    return (low, high, f64(total) / f64(values.len()));
}
fn label(temp: i32) -> string {
    match temp {
        t if t < 0 => {
            return "freezing".text();
        },
        0..15 => {
            return "cold".text();
        },
        15..25 => {
            return "mild".text();
        },
        _ => {
            return "hot".text();
        },
    }
}
fn main() {
    (low, high, mean) := stats(i32[12, -3, 21, 30]);
    println("low {} high {} mean {:.1}", low, high, mean);
    for t in i32[low, 12, high] {
        println("{:>4} {}", t, label(t));
    }
    println((low, high));
}
