// A C pointer made from a record is a borrow of that record, held for as long as the pointer is:
// here `info` keeps the pointer, so `app` cannot be replaced until `info`'s last use.
extern "C" record AppInfo {
    api_version: u32,
    flags: u32,
} extern "C" record CreateInfo {
    s_type: u32,
    pad: u32,
    p_app: CPtr,
    count: u32,
} extern "C" lib "record-pointers.o" fn book_create(info: CreateInfo) -> i64;

fn main() -> u64 {
    mut app = AppInfo { api_version: 1, flags: 0 };
    mut info = CreateInfo { s_type: 0, pad: 0, p_app: cnull(), count: 7 };
    unsafe {
        info.p_app = cptr(&app);
    }
    app = AppInfo { api_version: 2, flags: 0 }; // info still points at the old app below.
    mut created: i64 = 0;
    unsafe {
        created = book_create(info);
    }
    println(created);
    0
}
