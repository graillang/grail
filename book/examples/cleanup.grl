fn work(flag: num) -> num {
    scratch := u8[1];
    if flag {
        return scratch.len();
    } // scratch is freed on this edge too.
    return 0;
}
fn main() {
    for i in 3 {
        temporary := "iteration";
        if i == 1 {
            continue;
        } // temporary is freed before the next iteration.
        assert(temporary.len() == 9);
    }
    finished := u8[];
    drop(finished); // Optional early release; using it again is an error.
    println(work(true));
}
