module cleanup;
fn work(flag: num) -> num {
    var scratch = bytes(); push(scratch, 1);
    if flag { return len(scratch); } // scratch is freed on this edge too.
    return 0;
}
fn main() {
    for i in 3 {
        temporary := "iteration";
        if i==1 { continue; } // temporary is freed before the next iteration.
        assert(len(temporary)==9);
    }
    finished := bytes();
    drop(finished); // Optional early release; using it again is an error.
    println(work(1));
}
