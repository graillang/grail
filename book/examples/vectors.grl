module vectors;
fn main() {
    let values = vec<num>();
    vec_push(values, 10); vec_push(values, 20);
    let slot = vec_get(values, 0); // A reference, not a copied element.
    let first = load(slot);
    vec_push(values, 30);       // slot's last use has ended.
    let last = vec_pop(values);
    println(first+last+len(values));
}
