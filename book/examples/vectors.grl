module vectors;
fn main() {
    var values = vec<num>();
    vec_push(values, 10); vec_push(values, 20);
    slot := vec_get(values, 0); // A reference, not a copied element.
    first := load(slot);
    vec_push(values, 30);       // slot's last use has ended.
    last := vec_pop(values);
    println(first+last+len(values));
}
