const ORIGIN_NAME: string = "origin";
const LIMIT: i32 = 10;

struct Point {
    x: i32,
    y: i32,
}
impl Point {
    fn show(self: &Point) -> string {
        if self.x == 0 && self.y == 0 {
            return ORIGIN_NAME;
        }
        format("({}, {})", self.x, self.y)
    }
    fn inside(self: &Point) -> bool {
        self.x >= -LIMIT && self.x <= LIMIT && self.y >= -LIMIT && self.y <= LIMIT
    }
}
fn main() {
    points := Point[Point { x: 0, y: 0 }, Point { x: 3, y: -4 }, Point { x: 20, y: 1 }];
    for i in points.len() {
        point := &points[i];
        println("{} inside: {}", point, point.inside());
    }
    initial := 'G';
    println(initial);
}
