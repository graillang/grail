fn apply_twice(f: Fn(u64) -> u64, x: u64) -> u64 {
    return f(f(x));
}
fn make_adder(n: u64) -> Fn(u64) -> u64 {
    return |x: u64| -> u64 x + n;
}
fn main() {
    offset := 10;
    add_offset := |x: u64| -> u64 x + offset;
    println(add_offset(5));
    println(apply_twice(make_adder(3), 1));
    words := "grail";
    length := || -> u64 words.len();
    println(length());
}
