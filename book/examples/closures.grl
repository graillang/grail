fn apply_twice(f: Fn(num) -> num, x: num) -> num {
    return f(f(x));
}
fn make_adder(n: num) -> Fn(num) -> num {
    return |x: num| -> num x + n;
}
fn main() {
    offset := 10;
    add_offset := |x: num| -> num x + offset;
    println(add_offset(5));
    println(apply_twice(make_adder(3), 1));
    words := "grail";
    length := || -> num words.len();
    println(length());
}
