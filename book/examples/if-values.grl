fn word(n: u64) -> string {
    if n == 0 {
        "zero"
    } else if n == 1 {
        "one"
    } else {
        "many"
    }
}
fn show(n: u64) {
    println("{}", n);
}
fn main() {
    for i in 3 {
        println("{}", word(i));
    }
    show(if 2 < 3 {
        base := 40;
        base + 2
    } else { 0 });
}
