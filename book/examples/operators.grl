fn main() {
    var value = 10;
    value += 2;
    value *= 3;
    value -= 6;
    value /= 5;
    value %= 4;
    value **= 3;
    println(value);

    println(2 ** 3 ** 2); // 2 ** (3 ** 2), not (2 ** 3) ** 2.
    println(17 / 5);      // Unsigned integer division.
    println(7 ^ 3);       // Bitwise XOR, not exponentiation.
    assert(2 ** 64 == 0); // num multiplication wraps.
    assert(0 ** 0 == 1);
}
