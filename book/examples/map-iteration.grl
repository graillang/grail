use hashmap;

fn main() {
    mut counts: [string: u64] = ["cat": 1, "dog": 2, "emu": 3];
    for key, value in &counts {
        println("{} {}", key, value);
    }
    for key, value in &mut counts {
        *value = *value * 10;
    }
    for key, value in &counts {
        println("{} {}", key, value);
    }
    println(counts.len());
}
