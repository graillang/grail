use vecs;
struct Task {
    name: string,
    priority: u64,
    minutes: u64
}
fn main() {
    mut tasks = Task[
        Task { name: "write tests", priority: 2, minutes: 30 },
        Task { name: "fix crash", priority: 3, minutes: 45 },
        Task { name: "update docs", priority: 1, minutes: 20 },
        Task { name: "review patch", priority: 2, minutes: 15 }
    ];
    // Highest priority first; equal priorities keep their order (the sort is stable).
    vecs::sort_by(&mut tasks, |a: &Task, b: &Task| -> bool a.priority > b.priority);
    budget := 90;
    mut used = 0;
    for task in &tasks {
        if used + task.minutes <= budget {
            used += task.minutes;
            println("{} ({} min)", task.name, task.minutes);
        }
    }
    println("{} of {} minutes planned", used, budget);
}
