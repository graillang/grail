struct Shared { counter: atomic<num>, total: mutex<num> }
fn add<a>(total: ref_mut<a, num>, amount: num) -> num {
    exchange(total, load(total) + amount);
    return load(total);
}
fn work<a>(id: num, shared: ref<a, Shared>) -> num {
    for i in 1000 {
        shared.counter.fetch_add(1);
        shared.total.lock_with(1, add);
    }
    return id * id;
}
fn main() {
    shared := Shared { counter: atomic(0), total: mutex(0) };
    squares := parallel_map(num[1, 2, 3, 4], borrow(shared), work);
    println(squares[3]);
    println(shared.counter.load());
    println(shared.total.lock_with(0, add));
}
