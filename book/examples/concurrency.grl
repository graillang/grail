struct Shared {
    counter: atomic<u64>,
    total: mutex<u64>
}
fn add(total: &mut u64, amount: u64) -> u64 {
    exchange(total, load(total) + amount);
    return load(total);
}
fn work(id: u64, shared: &Shared) -> u64 {
    for i in 1000 {
        shared.counter.fetch_add(1);
        shared.total.lock_with(1, add);
    }
    return id * id;
}
fn main() {
    shared := Shared { counter: atomic(0), total: mutex(0) };
    squares := parallel_map(u64[1, 2, 3, 4], borrow(shared), work);
    println(squares[3]);
    println(shared.counter.load());
    println(shared.total.lock_with(0, add));
}
