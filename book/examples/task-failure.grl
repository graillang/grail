use host;
fn work(n: u64, base: u64) -> u64 {
    n + base
}
fn failing(n: u64, base: u64) -> u64 {
    task_fail(view("bad input"));
    0
}
fn body<s>(sc: (&s Scope<u64>), base: u64) -> u64 {
    t := spawn(sc, 0, failing);
    match try_join(t) {
        v: u64 => println(v),
        f: TaskFailure => {
            // The failure is a value: its text, what failed (`f.kind`) and where (`f.site`).
            host::print(f.message);
            host::print(view("\n"));
        }
    }
    u := spawn(sc, 5, work);
    join(u)
}
fn main() {
    println(task_scope(2, body));
}
