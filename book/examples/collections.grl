use hashmap;
use vecs;
use order;

struct Score {
    name: string,
    points: u32,
}
impl order::Ord for Score {
    fn less<a, b>(left: ref<a, Self>, right: ref<b, Self>) -> bool {
        return left.points > right.points;
    }
}
fn main() {
    mut counts = hashmap::with_seed<string, num>(1, 2);
    mut words = strings_of(&"the cat and the hat");
    vecs::reverse(borrow_mut(words));
    while words.len() != 0 {
        word := words.pop();
        if hashmap::contains(borrow(counts), borrow(word)) {
            n := hashmap::get_mut(borrow_mut(counts), borrow(word))!;
            exchange(n, load(n) + 1);
        } else {
            hashmap::insert(borrow_mut(counts), word, 1);
        }
    }
    for i in hashmap::len(borrow(counts)) {
        println("{}: {}", hashmap::key_at(borrow(counts), i), load(hashmap::value_at(borrow(counts), i)));
    }
    mut scores = vec<Score>[Score { name: "ada".text(), points: 7 }, Score { name: "bo".text(), points: 12 }];
    scores.push(Score { name: "cy".text(), points: 9 });
    vecs::sort(borrow_mut(scores));
    for i in scores.len() {
        s := &scores[i];
        println("{} {}", s.name, s.points);
    }
    mut primes = vec<num>[7, 2, 5, 3];
    vecs::sort(borrow_mut(primes));
    println(primes);
}
fn strings_of<a>(text: read<a>) -> vec<string> {
    mut words = vec<string>[];
    mut current = bytes[];
    for b in text {
        if b == ' ' {
            words.push(current.text());
            current = bytes[];
        } else {
            current.push(b);
        }
    }
    words.push(current.text());
    return words;
}
