use hashmap;
use vecs;
use order::Ord;

struct Score {
    name: string,
    points: u32,
}
impl Ord for Score {
    fn less(left: &Self, right: &Self) -> bool {
        return left.points > right.points;
    }
}
fn main() {
    mut counts = hashmap::with_seed<string, num>(1, 2);
    mut words = strings_of(&"the cat and the hat");
    vecs::reverse(borrow_mut(words));
    while words.len() != 0 {
        word := words.pop();
        if hashmap::contains(borrow(counts), borrow(word)) {
            n := hashmap::get_mut(borrow_mut(counts), borrow(word))!;
            exchange(n, load(n) + 1);
        } else {
            hashmap::insert(borrow_mut(counts), word, 1);
        }
    }
    for i in hashmap::len(borrow(counts)) {
        println(
            "{}: {}",
            hashmap::key_at(borrow(counts), i),
            load(hashmap::value_at(borrow(counts), i))
        );
    }
    mut scores = Score[Score { name: "ada", points: 7 }, Score { name: "bo", points: 12 }];
    scores.push(Score { name: "cy", points: 9 });
    vecs::sort(borrow_mut(scores));
    for i in scores.len() {
        s := &scores[i];
        println("{} {}", s.name, s.points);
    }
    mut primes = num[7, 2, 5, 3];
    vecs::sort(borrow_mut(primes));
    println(primes);
}
fn strings_of(text: read<a>) -> string[] {
    mut words = string[];
    mut current = u8[];
    for b in text {
        if b == ' ' {
            words.push(current.text());
            current = u8[];
        } else {
            current.push(b);
        }
    }
    words.push(current.text());
    return words;
}
