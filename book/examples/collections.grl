use hashmap;
use vecs;
use order::Ord;

struct Score {
    name: string,
    points: u32,
}
impl Ord for Score {
    fn less(left: &Self, right: &Self) -> bool {
        return left.points > right.points;
    }
}
fn main() {
    mut counts: [string: u64] = ["the": 2, "cat": 1, "hat": 1];
    println(counts.len());
    println(counts["the"]);
    counts["cat"] += 1;
    println(counts["cat"]);
    counts["dog"] = 2;
    println(counts["dog"]);
    println(counts.contains(borrow("cat")));
    println(counts.get(borrow("the"))!);
    match counts.entry(borrow("hat")) {
        Some(entry) => {
            println("{} {}", entry.key, load(entry.value));
        },
        None => {
            println("absent");
        },
    }
    println(counts.remove(borrow("hat"))!);
    println(counts.len());
    empty: [string: u64] := [:];
    println(empty.len());

    mut scores = Score[Score { name: "ada", points: 7 }, Score { name: "bo", points: 12 }];
    scores.push(Score { name: "cy", points: 9 });
    vecs::sort(borrow_mut(scores));
    for i in scores.len() {
        s := &scores[i];
        println("{} {}", s.name, s.points);
    }
    mut primes = u64[7, 2, 5, 3];
    vecs::sort(borrow_mut(primes));
    println(primes);
}
