// A job handle: spawn now, wait later. `parallel_spawn` returns a `Job<R>`, `parallel_join` takes
// the result, and the handle may outlive the statement that started the work.
use pool;

fn main() {
    // The job starts immediately and runs on a pool worker while this thread keeps going.
    job := parallel_spawn(|| -> u64 {
        mut total = 0;
        for i in 1000 { total = total + i; }
        total
    });

    // Work that does not need the result, done while the job runs.
    mut squares = u64[];
    for i in 4 { squares.push(i * i); }

    // Waiting takes the owned result out of the handle and frees the job's record.
    println(parallel_join(job));
    println(squares.len());

    // Two live handles, joined in the opposite order from the order they started in: a result
    // belongs to its own handle, not to the order the jobs finished.
    a := parallel_spawn(|| -> u64 {
        mut p = 1;
        for i in 7 { p = p * 6; }
        p
    });
    b := parallel_spawn(|| -> u64 {
        mut p = 1;
        for i in 5 { p = p * 4; }
        p
    });
    println(parallel_join(b));
    println(parallel_join(a));
}
