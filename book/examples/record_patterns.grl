struct Order {
    id: u64,
    items: u64[],
    note: string
}
fn items_of(order: &Order) -> u64 {
    match order {
        Order { items,..} => {
            return items.len();
        }
    }
}
fn restock(order: &mut Order, count: u64) {
    match order {
        Order { items,..} => {
            items.push(count);
        }
    }
}
fn main() {
    mut order = Order { id: 7, items: u64[2, 3, 5], note: "rush" };
    println("{} items", items_of(&order));
    restock(&mut order, 7);
    match order {
        Order { id, items, note } => {
            println("order {}: {} items, note {}", id, items.len(), note.len());
        }
    }
}
