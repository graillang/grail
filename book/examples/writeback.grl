module writeback_example;
fn replace<a, type T>(slot: ref_mut<a, T>, value: T) -> T {
    return exchange(slot, value);
}
fn main() {
    var first = bytes(); push(first, 1);
    var second = bytes(); push(second, 2);
    var current = read(first);
    previous := replace(borrow_mut(current), read(second));
    assert(at(previous, 0)==1);
    println(at(current, 0));
}
