interface Peek { fn peek(self: &Self) -> u64; }
struct N { n: u64 }
impl Peek for N { fn peek(self: &Self) -> u64 { return self.n; } }
handle Hd;
struct HH { h: Hd }
impl Peek for HH { fn peek(self: &Self) -> u64 { return 1; } }
fn body<s>(sc: (&s Scope<u64>), base: u64) -> u64 { return 1; }
fn total(p: dyn Peek, c: u64) -> u64 { return p.peek(); }
fn b2<s>(sc: (&s Scope<u64>), base: u64) -> u64 { p: dyn Peek = N { n: 3 }; t := spawn(sc, p, total); return join(t); }
fn main() { println(task_scope(1, b2)); }
