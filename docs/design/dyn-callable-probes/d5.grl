interface Peek { fn peek(self: &Self) -> u64; }
struct N { n: u64 }
impl Peek for N { fn peek(self: &Self) -> u64 { return self.n; } }
handle Hd;
struct HH { h: Hd }
impl Peek for HH { fn peek(self: &Self) -> u64 { return 1; } }
struct Hold<a> { p: (&a dyn Peek) }
fn eat(n: N) -> u64 { return n.n; }
fn main() { n := N { n: 4 }; h := Hold { p: &n }; println(eat(n)); println(h.p.peek()); }
