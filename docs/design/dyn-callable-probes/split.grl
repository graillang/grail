use iter;
use host;
fn main() {
    n := 10000000;
    mut v = u64[];
    for i in n { v.push(i); }
    t0 := host::now_ms();
    w := v.copy();
    t1 := host::now_ms();
    a := iter::of(w).fold(0, |s: u64, x: u64| -> u64 wrapping_add(s, x));
    t2 := host::now_ms();
    b := iter::of(v.copy()).map(|x: u64| -> u64 x * 2).fold(0, |s: u64, x: u64| -> u64 wrapping_add(s, x));
    t3 := host::now_ms();
    d := iter::of(v.copy()).filter(|x: &u64| -> bool *x % 3 == 0).fold(0, |s: u64, x: u64| -> u64 wrapping_add(s, x));
    t4 := host::now_ms();
    println("{} {} {}", a, b, d);
    println("copy {} ms, of+fold {} ms, +map {} ms, +filter {} ms", t1 - t0, t2 - t1, t3 - t2, t4 - t3);
}
