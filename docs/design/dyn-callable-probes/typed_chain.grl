use iter;
use host;
fn main() {
    n := 10000000;
    mut v = u64[];
    for i in n { v.push(i); }
    mut best = 1000000;
    mut best_loop = 1000000;
    mut a: u64 = 0;
    mut b: u64 = 0;
    for round in 5 {
        w := v.copy();
        t0 := host::now_ms();
        a = iter::over(w).map(|x: u64| -> u64 x * 2).filter(|x: &u64| -> bool *x % 3 == 0).fold(0, |s: u64, x: u64| -> u64 wrapping_add(s, x));
        t1 := host::now_ms();
        mut s2: u64 = 0;
        for i in v.len() { y := v[i] * 2; if y % 3 == 0 { s2 = wrapping_add(s2, y); } }
        b = s2;
        t2 := host::now_ms();
        if t1 - t0 < best { best = t1 - t0; }
        if t2 - t1 < best_loop { best_loop = t2 - t1; }
    }
    println("{} {}", a, b);
    println("typed chain {} ms, hand loop {} ms", best, best_loop);
}
