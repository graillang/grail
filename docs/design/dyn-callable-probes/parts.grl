use iter;
use host;
fn mk(n: u64) -> u64[] { mut v = u64[]; for i in n { v.push(i); } return v; }
fn main() {
    n := 10000000;
    mut v = mk(n);
    t0 := host::now_ms();
    mut s: u64 = 0;
    while let Some(x) = v.pop() { s = wrapping_add(s, x); }
    t1 := host::now_ms();
    mut w = mk(n);
    t2 := host::now_ms();
    mut f = || -> u64? { return w.pop(); };
    mut s2: u64 = 0;
    while let Some(x) = f() { s2 = wrapping_add(s2, x); }
    t3 := host::now_ms();
    mut it = iter::of(mk(n));
    t4 := host::now_ms();
    mut s3: u64 = 0;
    while let Some(x) = it.next() { s3 = wrapping_add(s3, x); }
    t5 := host::now_ms();
    t6 := host::now_ms();
    built := iter::of(mk(n));
    t7 := host::now_ms();
    s4 := built.fold(0, |a: u64, x: u64| -> u64 wrapping_add(a, x));
    t8 := host::now_ms();
    println("{} {} {} {}", s, s2, s3, s4);
    println("pop loop {} ms, pop via closure {} ms, Iter.next loop {} ms, of() build {} ms, fold {} ms", t1 - t0, t3 - t2, t5 - t4, t7 - t6, t8 - t7);
}
