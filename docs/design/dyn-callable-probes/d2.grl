interface Peek { fn peek(self: &Self) -> u64; }
struct N { n: u64 }
impl Peek for N { fn peek(self: &Self) -> u64 { return self.n; } }
handle Hd;
struct HH { h: Hd }
impl Peek for HH { fn peek(self: &Self) -> u64 { return 1; } }
fn go(p: dyn Peek, u: u64) -> u64 { return p.peek(); }
fn main() { mut v = (dyn Peek)[]; v.push(N { n: 4 }); out := parallel_map(v, 0, go); println(out[0]); }
