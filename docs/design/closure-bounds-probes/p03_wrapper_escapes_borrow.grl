// pool::spawn's promise: "a callback that captured a borrow is refused". Through the wrapper the
// closure's regions are erased at the `Fn()->R` parameter, so the job can outlive the frame.
use pool;
fn make() -> Job<u64> {
    mut data = u64[1, 2, 3, 4];
    view := &data;
    return pool::spawn(|| -> u64 { mut t = 0; for i in 2000000 { t = t + view[i % 4]; } return t; });
}
fn main() {
    j := make();
    mut junk = u64[];
    for i in 100000 { junk.push(i); }
    println(pool::wait(j));
}
