// The pattern a scoped spawn reduces to: a borrow stored, through a reference parameter, into
// storage whose type names the borrow's lifetime. The loan must stay live while the holder is.
struct Holder<d> { r: (&d u64[]) }
fn put<a, d>(h: (&a mut Holder<d>), r: (&d u64[])) -> unit { h.r = r; }
fn eat(v: u64[]) -> u64 { return v.len(); }
fn main() {
    mut data = u64[1, 2, 3, 4];
    mut other = u64[9];
    mut h = Holder { r: &other };
    put(&mut h, &data);
    println(eat(data));
    println(h.r.len());
}
