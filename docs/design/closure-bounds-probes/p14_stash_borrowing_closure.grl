// A callee that keeps the closure somewhere other than its result.
struct Q { items: (Fn()->u64)[] }
fn stash<a>(q: (&a mut Q), f: Fn()->u64) -> unit { q.items.push(f); }
fn fill<a>(q: (&a mut Q)) -> unit {
    mut data = u64[41, 2, 3, 4];
    view := &data;
    stash(&mut q, || -> u64 view[0] + 1);
}
fn main() {
    mut q = Q { items: (Fn()->u64)[] };
    fill(&mut q);
    mut junk = u64[9, 9, 9, 9, 9, 9];
    f := q.items.pop()!;
    println(f());
}
