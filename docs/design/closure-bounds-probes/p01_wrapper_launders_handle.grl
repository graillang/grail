// A library wrapper over parallel_spawn: the closure captures a thread-affine handle.
// Direct `parallel_spawn(|| ...)` refuses this capture; through the wrapper?
handle H;
fn keep(h: (&H), x: u64) -> u64 { return x; }
fn my_spawn<R:Send>(f: Fn()->R) -> Job<R> { return parallel_spawn(f); }
fn main() {
    mut h: H;
    j := my_spawn(|| -> u64 keep(&h, 1));
    println(parallel_join(j));
}
