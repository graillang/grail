// call_bonds hands a borrowing closure argument's loan to the call's result. Does that hold the
// borrowed data in place?
fn id(f: Fn()->u64) -> Fn()->u64 { return f; }
fn eat(v: u64[]) -> u64 { return v.len(); }
fn main() {
    mut data = u64[1, 2, 3, 4];
    view := &data;
    g := id(|| -> u64 view[0]);
    println(eat(data));
    println(g());
}
