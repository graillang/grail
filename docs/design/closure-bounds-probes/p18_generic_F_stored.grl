// A closure kept un-erased in a generic record: the record's Send bound sees the capture.
handle H;
fn keep(h: (&H), x: u64) -> u64 { return x; }
struct Boxed<F> { f: F }
fn needs_send<T:Send>(t: T) -> u64 { return 7; }
fn main() {
    mut h: H;
    println(needs_send(Boxed { f: || -> u64 5 }));
    println(needs_send(Boxed { f: || -> u64 keep(&h, 1) }));
}
