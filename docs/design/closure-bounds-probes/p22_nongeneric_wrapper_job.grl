// p13 without the generic: is the lost loan a property of the generic call or of the Job result?
fn sp(f: Fn()->u64) -> Job<u64> { return parallel_spawn(f); }
fn eat(v: u64[]) -> u64 { return v.len(); }
fn main() {
    mut data = u64[1, 2, 3, 4];
    view := &data;
    j := sp(|| -> u64 view[0]);
    println(eat(data));
    println(parallel_join(j));
}
