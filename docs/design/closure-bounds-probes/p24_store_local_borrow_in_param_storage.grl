// The refusing half: a callee stores a borrow of its OWN local into the caller's holder.
struct Holder<d> { r: (&d u64[]) }
fn put<a, d>(h: (&a mut Holder<d>), r: (&d u64[])) -> unit { h.r = r; }
fn fill<a, d>(h: (&a mut Holder<d>)) -> unit {
    mut local = u64[1, 2, 3];
    put(&mut h, &local);
}
fn main() {
    mut other = u64[9];
    mut h = Holder { r: &other };
    fill(&mut h);
    println(h.r.len());
}
