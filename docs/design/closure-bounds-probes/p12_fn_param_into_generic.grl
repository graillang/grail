// The erased `Fn()->u64` parameter forwarded to a `F: Send` generic: nothing left to check.
handle H;
fn keep(h: (&H), x: u64) -> u64 { return x; }
fn needs_send<F:Send>(f: F) -> u64 { return 7; }
fn wrapper(f: Fn()->u64) -> u64 { return needs_send(f); }
fn main() {
    mut h: H;
    println(wrapper(|| -> u64 keep(&h, 1)));
}
