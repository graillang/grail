// What `F: Send` / `F: Share` say about a closure holding an exclusive borrow today.
fn needs_send<F:Send>(f: F) -> u64 { return 1; }
fn needs_share<F:Share>(f: F) -> u64 { return 2; }
fn main() {
    mut a = u64[1, 2, 3];
    ra := &mut a;
    println(needs_send(|| -> u64 { ra[0] = 5; return 1; }));
    mut b = u64[1, 2, 3];
    rb := &mut b;
    println(needs_share(|| -> u64 rb[0]));
}
