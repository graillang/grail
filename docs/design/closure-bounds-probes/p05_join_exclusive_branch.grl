// What the SIMD/layout note asks for: one branch of a join writes through an exclusive borrow.
use pool;
fn main() {
    mut a = u64[1, 2, 3];
    mut b = u64[4, 5, 6];
    ra := &mut a;
    rb := &mut b;
    p := pool::join(|| -> u64 { ra[0] = 10; return 1; }, || -> u64 { rb[0] = 20; return 2; });
    println(a[0] + b[0] + p.first + p.second);
}
