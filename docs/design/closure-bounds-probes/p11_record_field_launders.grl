// A record with a field typed `Fn()->u64` is "Send": the field's type has no environment.
handle H;
fn keep(h: (&H), x: u64) -> u64 { return x; }
struct Work { run: Fn()->u64 }
fn go(w: Work, unused: u64) -> u64 { f := &w.run; return f(); }
fn main() {
    mut h: H;
    mut items = Work[];
    items.push(Work { run: || -> u64 keep(&h, 1) });
    out := parallel_map(items, 0, go);
    println(out[0]);
}
