// The Job returned by the wrapper holds the closure's loan (call_bonds): moving `data` is refused.
use pool;
fn eat(v: u64[]) -> u64 { return v.len(); }
fn main() {
    mut data = u64[1, 2, 3, 4];
    view := &data;
    j := pool::spawn(|| -> u64 view[0]);
    println(eat(data));
    println(pool::wait(j));
}
