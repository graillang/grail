use host;
fn reader(n: u64, c: u64) -> u64 {
    mut total = 0;
    for i in 100 { total += host::read_file("/proc/self/comm").len(); }
    return total;
}
fn body<s>(sc: (&s Scope<u64>), c: u64) -> u64 {
    a := spawn(sc, 0, reader);
    return join(a);
}
fn main() {
    t0 := host::now_ms();
    r := task_scope(0, body);
    t1 := host::now_ms();
    mut total = 0;
    for i in 100 { total += host::read_file("/proc/self/comm").len(); }
    t2 := host::now_ms();
    println(format("100 host::read_file in a task: {} ms; on the main thread: {} ms", t1 - t0, t2 - t1));
}
