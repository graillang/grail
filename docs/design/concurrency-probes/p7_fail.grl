use host;
use pool;
fn bad(n: u64, c: u64) -> u64 { v := u64[1]; return v[n]; }
fn body<s>(sc: (&s Scope<u64>), c: u64) -> u64 {
    a := spawn(sc, 5, bad);
    match try_join(a) {
        v: u64 => { return v; },
        f: TaskFailure => { host::print(view("task failure contained: ")); host::print(f.message); host::print(view("\n")); return 0; }
    }
}
fn main() {
    task_scope(0, body);
    r := pool::run<u64>(2, |i: u64| -> u64 bad(i + 5, 0));
    println("unreachable");
}
