use host;
use pool;
fn threads() -> u64 {
    s := host::read_file("/proc/self/status");
    // find "Threads:\t"
    mut i = 0;
    while i + 8 < s.len() {
        if s[i] == 84 && s[i+1] == 104 && s[i+2] == 114 && s[i+3] == 101 && s[i+4] == 97 && s[i+5] == 100 && s[i+6] == 115 && s[i+7] == 58 {
            mut j = i + 8;
            mut n = 0;
            while s[j] < 48 || s[j] > 57 { j += 1; }
            while s[j] >= 48 && s[j] <= 57 { n = n * 10 + (s[j] - 48); j += 1; }
            return n;
        }
        i += 1;
    }
    return 0;
}
fn in_task(n: u64, c: u64) -> u64 {
    return host::worker_id();
}
fn nested(n: u64, c: u64) -> u64 {
    ids := pool::run<u64>(4, |i: u64| -> u64 host::worker_id());
    return ids[0] + ids[1] + ids[2] + ids[3];
}
fn body<s>(sc: (&s Scope<u64>), base: u64) -> u64 {
    a := spawn(sc, 0, in_task);
    return join(a);
}
fn body2<s>(sc: (&s Scope<u64>), base: u64) -> u64 {
    a := spawn(sc, 0, nested);
    return join(a);
}
fn main() {
    println(format("start: threads={}", threads()));
    println(format("host::workers()={} -> threads={}", host::workers(), threads()));
    println(format("task worker_id={} -> threads={}", task_scope(0, body), threads()));
    ids := pool::run<u64>(4, |i: u64| -> u64 host::worker_id());
    println(format("pool job worker_id={} -> threads={}", ids[0], threads()));
    println(format("pool jobs submitted from a task: sum of worker_id={} -> threads={}", task_scope(0, body2), threads()));
}
