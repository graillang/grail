{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Grail",
  "scopeName": "source.grail",
  "fileTypes": [
    "grl"
  ],
  "patterns": [
    {
      "match": "//.*",
      "name": "comment.line.double-slash.grail"
    },
    {
      "name": "comment.block.grail",
      "match": "/\\*.*?(?:\\*/|$)"
    },
    {
      "match": "(\")((?:[^\"\\\\\\n]|\\\\.)*)(\")",
      "name": "string.quoted.double.grail",
      "captures": {
        "1": {
          "name": "punctuation.definition.string.begin.grail"
        },
        "2": {
          "patterns": [
            {
              "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|[\"\\\\/bfnrt0])",
              "name": "constant.character.escape.grail"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.string.end.grail"
        }
      }
    },
    {
      "match": "(')(\\\\(?:u\\{[0-9a-fA-F]+\\}|.)|[^'\\\\\\n])(')",
      "name": "string.quoted.single.grail",
      "captures": {
        "1": {
          "name": "punctuation.definition.string.begin.grail"
        },
        "2": {
          "patterns": [
            {
              "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)",
              "name": "constant.character.escape.grail"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.string.end.grail"
        }
      }
    },
    {
      "match": "\\b0(?:[xX][0-9a-fA-F_]+|[bB][01_]+|[oO][0-7_]+)(?:u8|u16|u32|u64|i8|i16|i32|i64|f32|f64)?\\b",
      "name": "constant.numeric.grail"
    },
    {
      "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][-+]?[0-9]+)?(?:u8|u16|u32|u64|i8|i16|i32|i64|f32|f64)?\\b",
      "name": "constant.numeric.grail"
    },
    {
      "match": "(@)(if|for|assert|embed|name|expr)\\b",
      "name": "meta.attribute.grail",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.grail"
        },
        "2": {
          "name": "keyword.control.grail"
        }
      }
    },
    {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "name": "meta.attribute.grail",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.grail"
        }
      }
    },
    {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.grail"
        },
        "2": {
          "name": "entity.name.function.grail"
        }
      }
    },
    {
      "match": "\\b(struct|enum|interface|handle|record|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.grail"
        },
        "2": {
          "name": "entity.name.type.grail"
        }
      }
    },
    {
      "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(;)",
      "captures": {
        "1": {
          "name": "storage.type.grail"
        },
        "2": {
          "name": "entity.name.namespace.grail"
        },
        "3": {
          "name": "punctuation.terminator.statement.grail"
        }
      }
    },
    {
      "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)\\s*(;)",
      "captures": {
        "1": {
          "name": "keyword.control.import.grail"
        },
        "2": {
          "name": "entity.name.namespace.grail"
        },
        "3": {
          "name": "punctuation.terminator.statement.grail"
        }
      }
    },
    {
      "match": "\\b(extern)\\s+(\"(?:[^\"\\\\\\n]|\\\\.)*\")(?:\\s+(lib)\\s+(\"(?:[^\"\\\\\\n]|\\\\.)*\"))?",
      "name": "meta.extern.grail",
      "captures": {
        "1": {
          "name": "storage.type.grail"
        },
        "2": {
          "name": "string.quoted.double.grail"
        },
        "3": {
          "name": "keyword.other.lib.grail"
        },
        "4": {
          "name": "string.quoted.double.grail"
        }
      }
    },
    {
      "match": "\\b(const|static)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.grail"
        },
        "2": {
          "name": "variable.other.constant.grail"
        }
      }
    },
    {
      "match": "(\\|)(\\s*)(\\|)(?=\\s*(?:->|\\{))",
      "name": "meta.function.closure.grail",
      "captures": {
        "1": {
          "name": "punctuation.section.closure.begin.grail"
        },
        "2": {
          "patterns": [
            {
              "include": "#closureParams"
            }
          ]
        },
        "3": {
          "name": "punctuation.section.closure.end.grail"
        }
      }
    },
    {
      "match": "(\\|)([^|\\n]*?)(\\|)(?=\\s*(?:->|\\{))",
      "name": "meta.function.closure.grail",
      "captures": {
        "1": {
          "name": "punctuation.section.closure.begin.grail"
        },
        "2": {
          "patterns": [
            {
              "include": "#closureParams"
            }
          ]
        },
        "3": {
          "name": "punctuation.section.closure.end.grail"
        }
      }
    },
    {
      "match": "(\\|)([^|\\n]*?:[^|\\n]*?)(\\|)",
      "name": "meta.function.closure.grail",
      "captures": {
        "1": {
          "name": "punctuation.section.closure.begin.grail"
        },
        "2": {
          "patterns": [
            {
              "include": "#closureParams"
            }
          ]
        },
        "3": {
          "name": "punctuation.section.closure.end.grail"
        }
      }
    },
    {
      "match": "(<)(?!(?:mut|fn|bool|char|string|unit|u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|[A-Z])\\b)([a-z][A-Za-z0-9_]*)((?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)(\\s*)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.typeparameters.begin.grail"
        },
        "2": {
          "name": "storage.modifier.lifetime.grail"
        },
        "3": {
          "patterns": [
            {
              "match": "[a-z][A-Za-z0-9_]*",
              "name": "storage.modifier.lifetime.grail"
            },
            {
              "match": "[A-Z][A-Za-z0-9_]*",
              "name": "entity.name.type.grail"
            },
            {
              "match": ",",
              "name": "punctuation.separator.comma.grail"
            }
          ]
        },
        "5": {
          "name": "punctuation.definition.typeparameters.end.grail"
        }
      }
    },
    {
      "match": "(&)(\\s*)(?!(?:mut|fn)\\b)([a-z][A-Za-z0-9_]*)(?=\\s+(?:mut\\b|&|\\[|\\(|[A-Z]|(?:bool|char|string|unit|u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|Fn|FnMut|cfn)\\b))",
      "captures": {
        "1": {
          "name": "keyword.operator.grail"
        },
        "3": {
          "name": "storage.modifier.lifetime.grail"
        }
      }
    },
    {
      "match": "\\b(fn|struct|enum|interface|impl|handle|module|use|const|static|extern|type|record|cfn)\\b",
      "name": "storage.type.grail"
    },
    {
      "match": "\\b(pub|mut)\\b",
      "name": "storage.modifier.grail"
    },
    {
      "match": "\\b(if|else|while|loop|for|in|match|return|break|continue|unsafe|let)\\b",
      "name": "keyword.control.grail"
    },
    {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.grail"
    },
    {
      "match": "\\b(Some|None)\\b",
      "name": "constant.language.grail"
    },
    {
      "match": "\\b(self)\\b",
      "name": "variable.language.self.grail"
    },
    {
      "match": "\\b(Self)\\b",
      "name": "support.type.grail"
    },
    {
      "match": "\\b(?:bool|char|string|unit|u8|u16|u32|u64|i8|i16|i32|i64|isize|f32|f64)\\b",
      "name": "support.type.grail"
    },
    {
      "match": "\\b(?:CStr|CPtr|CMutPtr|FnMut|Fn|Atomic|Mutex|Scope|Task|Job|CancelToken)\\b",
      "name": "support.type.grail"
    },
    {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "name": "entity.name.function.grail"
    },
    {
      "match": "\\b([A-Z][a-z][A-Za-z0-9_]*|[A-Z])\\b",
      "name": "entity.name.type.grail"
    },
    {
      "match": "(->|=>|::|\\|\\?|\\*\\*=|:=|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|\\*\\*|<<|>>|\\.\\.)",
      "name": "keyword.operator.grail"
    },
    {
      "match": "([=+\\-*/%<>&|^!?])",
      "name": "keyword.operator.grail"
    },
    {
      "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.separator.period.grail"
        },
        "2": {
          "name": "variable.other.property.grail"
        }
      }
    },
    {
      "match": "\\.",
      "name": "punctuation.separator.period.grail"
    },
    {
      "match": "\\{",
      "name": "punctuation.section.block.begin.grail"
    },
    {
      "match": "\\}",
      "name": "punctuation.section.block.end.grail"
    },
    {
      "match": "\\(",
      "name": "punctuation.section.parens.begin.grail"
    },
    {
      "match": "\\)",
      "name": "punctuation.section.parens.end.grail"
    },
    {
      "match": "\\[",
      "name": "punctuation.section.brackets.begin.grail"
    },
    {
      "match": "\\]",
      "name": "punctuation.section.brackets.end.grail"
    },
    {
      "match": ",",
      "name": "punctuation.separator.comma.grail"
    },
    {
      "match": ";",
      "name": "punctuation.terminator.statement.grail"
    },
    {
      "match": ":",
      "name": "punctuation.separator.colon.grail"
    }
  ],
  "repository": {
    "closureParams": {
      "patterns": [
        {
          "match": "&",
          "name": "keyword.operator.grail"
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)",
          "name": "variable.parameter.grail"
        },
        {
          "match": "\\b(?:bool|char|string|unit|u8|u16|u32|u64|i8|i16|i32|i64|isize|f32|f64)\\b",
          "name": "support.type.grail"
        },
        {
          "match": "\\b(?:CStr|CPtr|CMutPtr|FnMut|Fn|Atomic|Mutex|Scope|Task|Job|CancelToken)\\b",
          "name": "support.type.grail"
        },
        {
          "match": "\\b([A-Z][a-z][A-Za-z0-9_]*|[A-Z])\\b",
          "name": "entity.name.type.grail"
        },
        {
          "match": "(&)(\\s*)(?!(?:mut|fn)\\b)([a-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.grail"
            },
            "3": {
              "name": "storage.modifier.lifetime.grail"
            }
          }
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.grail"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.grail"
        }
      ]
    }
  }
}
