/research/experiments/*/target/
# Downloaded third-party papers/pages; keep source metadata and distilled findings instead.
/research/evidence/prior-art03-20261030/downloads/
# Local book HTML, example executables and test scratch.
/.work/
# `grail doc`'s default output.
/docs/api/
