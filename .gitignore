# Read-only third-party research checkouts and bulky source snapshots.
/research/repos/
/research/evidence/zig/
/research/evidence/zig-current/
# Downloaded paper and extracted text; provenance is recorded in JSON.
/research/evidence/mutable-value-semantics-2022.pdf
/research/evidence/mutable-value-semantics-2022.txt
# Generated experiment binaries, caches, compiler output and local build trees.
/research/experiments/*/.work/
/research/experiments/*/__pycache__/
/research/experiments/*/target/
