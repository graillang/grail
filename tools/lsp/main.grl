module grail_lsp;
use host;
use json;
use analysis;

// The Grail language server: JSON-RPC 2.0 over stdio (`Content-Length` framing).
//
// Scope, stated plainly because `initialize` advertises exactly this and nothing else:
//
//   * full-text synchronisation (open/change/close) and pushed diagnostics;
//   * `textDocument/definition` for declarations in the same document;
//   * `textDocument/hover` for the type, signature and documentation at a position;
//   * `textDocument/completion` for names in scope, fields, variants and parameters;
//   * `textDocument/rename` and `textDocument/prepareRename`, across the open documents.
//
// The last four are answered by `analysis.grl`, which reads the open buffers: the
// declarations they make, the bindings in scope and the type of an expression. Where it
// cannot be sure - a module whose source is not open, an expression it cannot type - the
// answer is nothing, never a guess.
//
// Diagnostics are not invented here. The open buffer is written to a scratch file and
// `grail check --diagnostics-json <records> <file>` is run on it; the compiler appends one
// JSON record per diagnostic - `file`, `line`, `col`, `col_end`, `code`, `message` - and
// this server maps the position into an LSP range in UTF-16 code units. Nothing is parsed
// out of the compiler's printed text. A clean check publishes `[]`, which is how a fixed
// buffer clears its squiggles. Nothing is published when the
// compiler cannot be run at all: that is reported with `window/showMessage` instead.
//
// Requests are answered from `lib/json.grl` (strict parsing, exact integers) and every
// response is written as bytes built by hand, so an id, a uri or a compiler message can
// never break the framing. Malformed input - a bad frame, a bad position, a name that
// cannot be renamed - is answered with the JSON-RPC error that describes it; the server
// has no path that aborts on a client message.

// ---------------------------------------------------------------------------
// bytes
// ---------------------------------------------------------------------------

fn no_index() -> u64 {
    return 9223372036854775807;
}
fn eq<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn has_suffix<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() < y.len() {
        return false;
    }
    offset := x.len() - y.len();
    for i in y.len() {
        if x[offset + i] != y[i] {
            return false;
        }
    }
    return true;
}
fn copy_bytes<a>(text: &a [u8]) -> u8[] {
    mut out = u8[];
    for i in text.len() {
        out.push(text[i]);
    }
    return out;
}
fn put<a, b>(out: &a mut u8[], text: &b [u8]) {
    for i in text.len() {
        out.push(text[i]);
    }
}
fn put_num<a>(out: &a mut u8[], value: u64) {
    text := format("{}", value);
    put(&mut out, &text);
}
fn put_int<a>(out: &a mut u8[], value: i64) {
    text := format("{}", value);
    put(&mut out, &text);
}
fn hex_digit(value: u64) -> u64 {
    if value < 10 {
        return 48 + value;
    }
    return 87 + value;
}
// A JSON string: quotes, backslashes and the escapes JSON requires.
fn put_string<a, b>(out: &a mut u8[], text: &b [u8]) {
    out.push(34);
    for i in text.len() {
        b := text[i];
        if b == 34 {
            put(&mut out, view("\\\""));
        } else if b == 92 {
            put(&mut out, view("\\\\"));
        } else if b == 10 {
            put(&mut out, view("\\n"));
        } else if b == 13 {
            put(&mut out, view("\\r"));
        } else if b == 9 {
            put(&mut out, view("\\t"));
        } else if b < 32 {
            put(&mut out, view("\\u00"));
            out.push(hex_digit(b / 16));
            out.push(hex_digit(b % 16));
        } else {
            out.push(b);
        }
    }
    out.push(34);
}
fn is_digit(c: u64) -> bool {
    return (47 < c) && (c < 58);
}

// ---------------------------------------------------------------------------
// framing
// ---------------------------------------------------------------------------

const LIMIT: u64 = 16777216;

// Index of the `\r\n\r\n` that ends the header block, or `no_index()`.
fn header_end<a>(buffer: &a [u8]) -> u64 {
    if buffer.len() < 4 {
        return no_index();
    }
    mut i = 0;
    while i + 4 <= buffer.len() {
        if (buffer[i] == 13) && (buffer[i + 1] == 10) {
            if (buffer[i + 2] == 13) && (buffer[i + 3] == 10) {
                return i;
            }
        }
        i += 1;
    }
    return no_index();
}
// Where the next header line begins (a `Content-Length` line at the start of a line).
// Used to resynchronise after a frame that carried no usable length.
fn header_start<a>(buffer: &a [u8]) -> u64 {
    mut i = 0;
    while i < buffer.len() {
        if ((i == 0) || (buffer[i - 1] == 10)) && (i + 15 <= buffer.len()) {
            if lower_equals(buffer[i: i + 15], view("content-length:")) {
                return i;
            }
        }
        i += 1;
    }
    return no_index();
}
fn lower_equals<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        mut c = x[i];
        if (64 < c) && (c < 91) {
            c += 32;
        }
        if c != y[i] {
            return false;
        }
    }
    return true;
}
// The `Content-Length` value of a header block, or `no_index()` when it is absent,
// not a number, out of range, or followed by junk.
fn content_length<a>(header: &a [u8]) -> u64 {
    mut i = 0;
    while i < header.len() {
        start := i;
        while (i < header.len()) && (header[i] != 10) {
            i += 1;
        }
        mut end = i;
        if i < header.len() {
            i += 1;
        }
        if (start < end) && (header[end - 1] == 13) {
            end -= 1;
        }
        mut colon = start;
        while colon < end {
            if header[colon] == 58 {
                break;
            }
            colon += 1;
        }
        if (start < colon) && (colon < end) {
            if lower_equals(header[start: colon], view("content-length")) {
                mut j = colon + 1;
                while (j < end) && (header[j] == 32) {
                    j += 1;
                }
                mut value = 0;
                mut digits = 0;
                while (j < end) && is_digit(header[j]) {
                    value = value * 10 + (header[j] - 48);
                    digits += 1;
                    if LIMIT < value {
                        return no_index();
                    }
                    j += 1;
                }
                if digits == 0 {
                    return no_index();
                }
                while (j < end) && (header[j] == 32) {
                    j += 1;
                }
                if j < end {
                    return no_index();
                }
                return value;
            }
        }
    }
    return no_index();
}

// ---------------------------------------------------------------------------
// documents
// ---------------------------------------------------------------------------

struct Document {
    uri: u8[],
    text: u8[],
    version: i64,
    versioned: bool
}
struct Snapshot {
    uri: u8[],
    text: u8[],
    version: i64,
    versioned: bool
}
struct Diagnostic {
    line: u64,
    start: u64,
    end: u64,
    message: u8[]
}
struct Server {
    pending: u8[],
    docs: Document[],
    state: u64,
    serial: u64,
    reported: bool
}

fn server_new() -> Server {
    return Server { pending: u8[], docs: Document[], state: 0, serial: 0, reported: false };
}
fn find_document<a>(docs: (&a Document[]), uri: &b [u8]) -> u64 {
    for i in docs.len() {
        d := &docs[i];
        if eq(d.uri, uri) {
            return i;
        }
    }
    return no_index();
}
fn snapshot_at<a>(docs: (&a Document[]), index: u64) -> Snapshot {
    d := &docs[index];
    return Snapshot {
        uri: d.uri.copy(),
        text: d.text.copy(),
        version: d.version,
        versioned: d.versioned,
    };
}

// ---------------------------------------------------------------------------
// utf-16 mapping
// ---------------------------------------------------------------------------

// The bytes of document line `line` (0-based), without its newline.
fn line_bytes<a>(text: &a [u8], line: u64) -> (&a [u8]) {
    mut current = 0;
    mut start = 0;
    mut i = 0;
    while i < text.len() {
        if text[i] == 10 {
            if current == line {
                mut end = i;
                if (start < end) && (text[end - 1] == 13) {
                    end -= 1;
                }
                return text[start: end];
            }
            current += 1;
            start = i + 1;
        }
        i += 1;
    }
    return text[start: text.len()];
}
// UTF-16 code units in the first `bytes` bytes of `line`. A truncated sequence counts as
// one unit, so a bad offset still names a position inside the line.
fn utf16_prefix<a>(line: &a [u8], bytes: u64) -> u64 {
    mut limit = bytes;
    if line.len() < limit {
        limit = line.len();
    }
    mut units = 0;
    mut i = 0;
    while i < limit {
        b := line[i];
        if b < 128 {
            i += 1;
        } else if b < 224 {
            i += 2;
        } else if b < 240 {
            i += 3;
        } else {
            units += 1;
            i += 4;
        }
        units += 1;
    }
    return units;
}
fn utf16_len<a>(line: &a [u8]) -> u64 {
    return utf16_prefix(line, line.len());
}
// The byte offset of UTF-16 position `units` in `line`, clamped to the line.
fn utf16_offset<a>(line: &a [u8], units: u64) -> u64 {
    mut seen = 0;
    mut i = 0;
    while (i < line.len()) && (seen < units) {
        b := line[i];
        mut width = 1;
        mut weight = 1;
        if b < 128 {
            width = 1;
        } else if b < 224 {
            width = 2;
        } else if b < 240 {
            width = 3;
        } else {
            width = 4;
            weight = 2;
        }
        if units < seen + weight {
            return i;
        }
        seen += weight;
        i += width;
    }
    if line.len() < i {
        return line.len();
    }
    return i;
}

// ---------------------------------------------------------------------------
// compiler diagnostics
// ---------------------------------------------------------------------------

struct Check {
    diagnostics: Diagnostic[],
    status: u64,
    failed: bool
}

fn temp_root() -> u8[] {
    value := host::env(view("TMPDIR"));
    if value.len() != 0 {
        return value;
    }
    if host::exists(view("/tmp")) != 0 {
        return copy_bytes(view("/tmp"));
    }
    return copy_bytes(view("."));
}
fn path_join<a, b>(dir: &a [u8], name: &b [u8]) -> u8[] {
    mut out = copy_bytes(dir);
    if !has_suffix(view(out), view("/")) {
        out.push(47);
    }
    for i in name.len() {
        out.push(name[i]);
    }
    return out;
}
// The compiler is this server's own tree unless the environment names one.
fn compiler_path() -> u8[] {
    value := host::env(view("GRAIL_LSP_COMPILER"));
    if value.len() != 0 {
        return value;
    }
    other := host::env(view("GRAIL_COMPILER"));
    if other.len() != 0 {
        return other;
    }
    return copy_bytes(view("grail"));
}
fn name_char(c: u64) -> bool {
    if (64 < c) && (c < 91) {
        return true;
    }
    if (96 < c) && (c < 123) {
        return true;
    }
    if is_digit(c) {
        return true;
    }
    return (c == 46) || (c == 95) || (c == 45);
}
// A scratch file name for the buffer: the uri's last segment, sanitised, always `.grl`.
fn buffer_name(uri: &[u8]) -> u8[] {
    mut start = 0;
    for i in uri.len() {
        if uri[i] == 47 {
            start = i + 1;
        }
    }
    mut name = u8[];
    mut i = start;
    while i < uri.len() {
        c := uri[i];
        if name_char(c) {
            name.push(c);
        } else {
            name.push(95);
        }
        i += 1;
    }
    if !has_suffix(view(name), view(".grl")) {
        put(&mut name, view(".grl"));
    }
    return name;
}

// One record of the compiler's structured diagnostics, mapped onto the buffer. The record names the
// file it is about, so a diagnostic the compiler found somewhere else is not put on this buffer; its
// `col` and `col_end` are 1-based byte positions, which become the UTF-16 offsets an LSP range wants.
fn diagnostic_record(record: &[u8], name: &[u8], text: &[u8]) -> (Diagnostic)? {
    match json::parse(record) {
        value: json::Value => {
            file := text_or(&value, view("file"));
            if !eq(view(file), view(name)) {
                return None;
            }
            line := int_or(&value, view("line"), 0);
            column := int_or(&value, view("col"), 0);
            finish := int_or(&value, view("col_end"), 0);
            if (line < 1) || (column < 1) {
                return None;
            }
            if finish <= column {
                finish = column + 1;
            }
            message := text_or(&value, view("message"));
            if message.len() == 0 {
                return None;
            }
            number := u64(line);
            doc_line := line_bytes(text, number - 1);
            total := utf16_len(doc_line);
            mut units_start = utf16_prefix(doc_line, u64(column) - 1);
            mut units_stop = utf16_prefix(doc_line, u64(finish) - 1);
            if total < units_start {
                units_start = total;
            }
            if total < units_stop {
                units_stop = total;
            }
            if units_stop <= units_start {
                units_stop = units_start + 1;
                if total < units_stop {
                    units_stop = total;
                }
            }
            return Some(
                Diagnostic { line: number - 1, start: units_start, end: units_stop, message: message }
            );
        },
        error: json::Error => {
            return None;
        }
    }
}
// One record per line, in the order the compiler reported them.
fn parse_records(records: &[u8], name: &[u8], text: &[u8]) -> Diagnostic[] {
    mut found = Diagnostic[];
    mut i = 0;
    while i < records.len() {
        start := i;
        while (i < records.len()) && (records[i] != 10) {
            i += 1;
        }
        mut end = i;
        if i < records.len() {
            i += 1;
        }
        if (start < end) && (records[end - 1] == 13) {
            end -= 1;
        }
        record := records[start: end];
        if 0 < record.len() {
            match diagnostic_record(record, name, text) {
                Some(diagnostic) => {
                    found.push(diagnostic);
                },
                None => {}
            }
        }
    }
    return found;
}

// Compile the buffer in a scratch directory and read the records back. `host::command` inherits
// this process's stdio, and this process's stdout is the JSON-RPC channel, so the check runs under
// `sh -c` with the child's own output redirected to a log inside its own working directory; the
// diagnostics arrive in the records file instead. Nothing is written into the user's tree.
fn run_check(uri: &[u8], text: &[u8], serial: u64) -> Check {
    root := temp_root();
    // Unique per process (start time) and per check (serial), so two servers never share
    // a scratch directory.
    stamp := format("grail-lsp-{}-{}", host::now_ms(), serial);
    dir := path_join(view(root), &stamp);
    name := buffer_name(uri);
    path := path_join(view(dir), view(name));
    out_path := path_join(view(dir), view("diagnostics.log"));
    records_path := path_join(view(dir), view("diagnostics.jsonl"));
    host::mkdir(view(dir));
    written := host::write_file(view(path), text);
    if written != 0 {
        host::remove(view(dir), 1);
        return Check { diagnostics: Diagnostic[], status: 1, failed: true };
    }
    exe := compiler_path();
    mut command = u8[][];
    command.push(copy_bytes(view("sh")));
    command.push(copy_bytes(view("-c")));
    command.push(copy_bytes(view("cd \"$1\" || exit 125; exec \"$2\" check --diagnostics-json \"$5\" \"$3\" >\"$4\" 2>&1")));
    command.push(copy_bytes(view("grail-lsp")));
    command.push(copy_bytes(view(dir)));
    command.push(exe);
    command.push(copy_bytes(view(name)));
    command.push(copy_bytes(view(out_path)));
    command.push(copy_bytes(view(records_path)));
    status := host::command(command);
    records := host::read_file(view(records_path));
    diagnostics := parse_records(view(records), view(name), text);
    target_dir := path_join(view(dir), view("target"));
    host::remove(view(records_path), 0);
    host::remove(view(out_path), 0);
    host::remove(view(target_dir), 1);
    host::remove(view(path), 0);
    host::remove(view(dir), 1);
    problems := diagnostics.len();
    return Check { diagnostics: diagnostics, status: status, // A non-zero status with no diagnostic line is the compiler failing, not the
    // buffer being wrong: that is reported, never turned into an empty diagnostic list.
    failed: (status != 0) && (problems == 0) };
}

// ---------------------------------------------------------------------------
// responses
// ---------------------------------------------------------------------------

fn send_body(body: u8[]) {
    mut frame = u8[];
    header := format("Content-Length: {}\r\n\r\n", body.len());
    put(&mut frame, &header);
    put(&mut frame, view(body));
    host::write_fd(1, view(frame));
}
fn send_result(id: u8[], result: &[u8]) {
    mut body = u8[];
    put(&mut body, view("{\"jsonrpc\":\"2.0\",\"id\":"));
    put(&mut body, view(id));
    put(&mut body, view(",\"result\":"));
    put(&mut body, result);
    put(&mut body, view("}"));
    send_body(body);
}
fn send_error(id: u8[], code: i64, message: &[u8]) {
    mut body = u8[];
    put(&mut body, view("{\"jsonrpc\":\"2.0\",\"id\":"));
    put(&mut body, view(id));
    put(&mut body, view(",\"error\":{\"code\":"));
    put_int(&mut body, code);
    put(&mut body, view(",\"message\":"));
    put_string(&mut body, message);
    put(&mut body, view("}}"));
    send_body(body);
}
fn publish(uri: &[u8], version: i64, versioned: bool, diagnostics: Diagnostic[]) {
    mut body = u8[];
    put(
        &mut body,
        view(
            "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":"
        )
    );
    put_string(&mut body, uri);
    if versioned {
        put(&mut body, view(",\"version\":"));
        put_int(&mut body, version);
    }
    put(&mut body, view(",\"diagnostics\":["));
    for i in diagnostics.len() {
        mut d = &diagnostics[i];
        if 0 < i {
            body.push(44);
        }
        put(&mut body, view("{\"range\":{\"start\":{\"line\":"));
        put_num(&mut body, d.line);
        put(&mut body, view(",\"character\":"));
        put_num(&mut body, d.start);
        put(&mut body, view("},\"end\":{\"line\":"));
        put_num(&mut body, d.line);
        put(&mut body, view(",\"character\":"));
        put_num(&mut body, d.end);
        put(
            &mut body,
            view("}},\"severity\":1,\"source\":\"grail\",\"code\":\"compiler\",\"message\":")
        );
        put_string(&mut body, view(d.message));
        put(&mut body, view("}"));
    }
    put(&mut body, view("]}}"));
    send_body(body);
}
// The one message that is not a diagnostic: the compiler could not be run at all.
// It is sent once, and diagnostics stay as they were instead of being invented.
fn report_environment(s: &mut Server, status: u64) {
    if s.reported {
        return ();
    }
    s.reported = true;
    exe := compiler_path();
    note := format(
        "grail lsp: could not run '{} check' (exit {}); set GRAIL_LSP_COMPILER to a Grail executable",
        exe.text(),
        status
    );
    mut body = u8[];
    put(
        &mut body,
        view(
            "{\"jsonrpc\":\"2.0\",\"method\":\"window/showMessage\",\"params\":{\"type\":1,\"message\":"
        )
    );
    put_string(&mut body, view(note));
    put(&mut body, view("}}"));
    send_body(body);
}

// ---------------------------------------------------------------------------
// documents and requests
// ---------------------------------------------------------------------------

fn text_member<a, b>(value: (&a json::Value), key: &b [u8]) -> (u8[])? {
    match value.get(key) {
        Some(member) => {
            match member.as_str() {
                Some(text) => {
                    return Some(text.copy());
                },
                None => {
                    return None;
                }
            }
        },
        None => {
            return None;
        }
    }
}
fn text_or<a, b>(value: (&a json::Value), key: &b [u8]) -> u8[] {
    match text_member(value, key) {
        Some(text) => {
            return text;
        },
        None => {
            return u8[];
        }
    }
}
fn int_member<a, b>(value: (&a json::Value), key: &b [u8]) -> (i64)? {
    match value.get(key) {
        Some(member) => {
            return member.as_i64();
        },
        None => {
            return None;
        }
    }
}
fn int_or<a, b>(value: (&a json::Value), key: &b [u8], fallback: i64) -> i64 {
    match int_member(value, key) {
        Some(number) => {
            return number;
        },
        None => {
            return fallback;
        }
    }
}
fn has_member<a, b>(value: (&a json::Value), key: &b [u8]) -> bool {
    match value.get(key) {
        Some(found) => {
            return true;
        },
        None => {
            return false;
        }
    }
}
fn id_bytes(msg: &json::Value) -> (u8[])? {
    match msg.get(view("id")) {
        Some(value) => {
            text := json::to_text(value);
            return Some(text.copy());
        },
        None => {
            return None;
        }
    }
}
// An error answer, unless the message was a notification (which never gets one).
fn answer_error(msg: &json::Value, code: i64, text: &[u8]) {
    match id_bytes(msg) {
        Some(id) => {
            send_error(id, code, text);
        },
        None => {
            return ();
        }
    }
}

fn check_document(s: &mut Server, index: u64) {
    if s.docs.len() <= index {
        return ();
    }
    snapshot := snapshot_at(&s.docs, index);
    s.serial += 1;
    outcome := run_check(view(snapshot.uri), view(snapshot.text), s.serial);
    if outcome.failed {
        report_environment(s, outcome.status);
        return ();
    }
    publish(view(snapshot.uri), snapshot.version, snapshot.versioned, outcome.diagnostics);
}

fn store_document(s: &mut Server, uri: u8[], text: u8[], version: i64, versioned: bool) -> u64 {
    index := find_document(&s.docs, view(uri));
    if index != no_index() {
        mut d = &mut s.docs[index];
        exchange(&mut d.text, text);
        exchange(&mut d.version, version);
        exchange(&mut d.versioned, versioned);
        return index;
    }
    s.docs.push(Document { uri: uri, text: text, version: version, versioned: versioned });
    return s.docs.len() - 1;
}

fn open_document(s: &mut Server, document: (&json::Value)) {
    uri := text_or(document, view("uri"));
    if uri.len() == 0 {
        return ();
    }
    text := text_or(document, view("text"));
    version := int_or(document, view("version"), 0);
    versioned := has_member(document, view("version"));
    index := store_document(s, uri, text, version, versioned);
    check_document(s, index);
}
fn handle_open(s: &mut Server, msg: &json::Value) {
    match msg.get(view("params")) {
        Some(params) => {
            match params.get(view("textDocument")) {
                Some(document) => {
                    open_document(s, document);
                },
                None => {
                    return ();
                }
            }
        },
        None => {
            return ();
        }
    }
}
// Full-text synchronisation: the first content change carries the whole buffer.
fn changed_text(params: (&json::Value)) -> (u8[])? {
    match params.get(view("contentChanges")) {
        Some(changes) => {
            match changes.at(0) {
                Some(change) => {
                    if has_member(change, view("text")) {
                        return Some(text_or(change, view("text")));
                    }
                    return None;
                },
                None => {
                    return None;
                }
            }
        },
        None => {
            return None;
        }
    }
}
fn handle_change(s: &mut Server, msg: &json::Value) {
    match msg.get(view("params")) {
        Some(params) => {
            match params.get(view("textDocument")) {
                Some(document) => {
                    uri := text_or(document, view("uri"));
                    if uri.len() == 0 {
                        return ();
                    }
                    index := find_document(&s.docs, view(uri));
                    if index == no_index() {
                        return ();
                    }
                    match changed_text(params) {
                        Some(text) => {
                            version := int_or(document, view("version"), 0);
                            versioned := has_member(document, view("version"));
                            mut d = &mut s.docs[index];
                            exchange(&mut d.text, text);
                            exchange(&mut d.version, version);
                            exchange(&mut d.versioned, versioned);
                            check_document(s, index);
                        },
                        None => {
                            return ();
                        }
                    }
                },
                None => {
                    return ();
                }
            }
        },
        None => {
            return ();
        }
    }
}
fn handle_close(s: &mut Server, msg: &json::Value) {
    match msg.get(view("params")) {
        Some(params) => {
            match params.get(view("textDocument")) {
                Some(document) => {
                    uri := text_or(document, view("uri"));
                    if uri.len() == 0 {
                        return ();
                    }
                    index := find_document(&s.docs, view(uri));
                    if index == no_index() {
                        return ();
                    }
                    mut kept = Document[];
                    for i in s.docs.len() {
                        if i != index {
                            d := &s.docs[i];
                            kept.push(
                                Document {
                                    uri: d.uri.copy(),
                                    text: d.text.copy(),
                                    version: d.version,
                                    versioned: d.versioned,
                                }
                            );
                        }
                    }
                    exchange(&mut s.docs, kept);
                    publish(view(uri), 0, false, Diagnostic[]);
                },
                None => {
                    return ();
                }
            }
        },
        None => {
            return ();
        }
    }
}

// ---------------------------------------------------------------------------
// requests answered from the open documents
// ---------------------------------------------------------------------------

// Every open document, analysed. A request re-reads them instead of caching anything, so
// what an answer reflects is exactly what the editor last sent - there is no index to go
// stale and no state to invalidate.
fn sources_of(s: &mut Server) -> analysis::Source[] {
    mut sources = analysis::Source[];
    for i in s.docs.len() {
        d := &s.docs[i];
        sources.push(analysis::source_new(view(d.text)));
    }
    return sources;
}
// The declarations of every document except `skip`: the world a request may consult for a
// type, a field or an imported name.
fn world_of(sources: (&analysis::Source[]), skip: u64) -> analysis::Item[] {
    mut items = analysis::Item[];
    for i in sources.len() {
        if i != skip {
            for k in sources[i].items.len() {
                items.push(analysis::item_copy(&sources[i].items[k]));
            }
        }
    }
    return items;
}
// The byte offset where document line `line` (0-based) starts, or no_index() past the end.
fn line_start(text: &[u8], line: u64) -> u64 {
    mut current = 0;
    mut start = 0;
    mut i = 0;
    while i < text.len() {
        if text[i] == 10 {
            if current == line {
                return start;
            }
            current += 1;
            start = i + 1;
        }
        i += 1;
    }
    if current == line {
        return start;
    }
    return no_index();
}
fn line_of(text: &[u8], offset: u64) -> u64 {
    mut line = 0;
    mut i = 0;
    while i < text.len() {
        if offset <= i {
            break;
        }
        if text[i] == 10 {
            line += 1;
        }
        i += 1;
    }
    return line;
}
// Byte offset of an LSP position, or no_index() when the position is outside the buffer.
// The character is a UTF-16 code unit count, so it is converted through the line it lands
// on: a line with non-ASCII text has fewer bytes than code units for its tail.
fn document_offset(text: &[u8], line: i64, character: i64) -> u64 {
    if line < 0 || character < 0 {
        return no_index();
    }
    row := u64(line);
    start := line_start(text, row);
    if start == no_index() {
        return no_index();
    }
    content := line_bytes(text, row);
    units := utf16_len(content);
    if u64(character) > units {
        return no_index();
    }
    return start + utf16_offset(content, u64(character));
}
fn put_position(out: (&mut u8[]), text: &[u8], offset: u64) {
    row := line_of(text, offset);
    start := line_start(text, row);
    content := line_bytes(text, row);
    column := utf16_prefix(content, offset - start);
    put(out, view("{\"line\":"));
    put_num(out, row);
    put(out, view(",\"character\":"));
    put_num(out, column);
    put(out, view("}"));
}
fn put_range(out: (&mut u8[]), text: &[u8], lo: u64, hi: u64) {
    put(out, view("{\"start\":"));
    put_position(out, text, lo);
    put(out, view(",\"end\":"));
    put_position(out, text, hi);
    put(out, view("}"));
}
struct Request {
    uri: u8[],
    index: u64,
    offset: u64
}
fn invalid<a>(msg: &json::Value, method: &[u8], what: &a [u8]) {
    mut note = u8[];
    put(&mut note, view("invalid params: "));
    put(&mut note, method);
    put(&mut note, view(" "));
    put(&mut note, what);
    answer_error(msg, -32602, view(note));
}
// The document and position a request names. Answers the request itself when it is
// malformed, so a bad position is an LSP error and never a crash; None means "answered".
fn prepare(s: &mut Server, msg: &json::Value, method: &[u8]) -> (Request)? {
    match msg.get(view("params")) {
        Some(params) => {
            match params.get(view("textDocument")) {
                Some(document) => {
                    match params.get(view("position")) {
                        Some(position) => {
                            uri := text_or(document, view("uri"));
                            if uri.len() == 0 {
                                invalid(msg, method, view("needs a textDocument with a uri"));
                                return None;
                            }
                            line := int_or(position, view("line"), -1);
                            character := int_or(position, view("character"), -1);
                            if line < 0 || character < 0 {
                                invalid(msg, method, view("needs a position with line and character"));
                                return None;
                            }
                            index := find_document(&s.docs, view(uri));
                            if index == no_index() {
                                match id_bytes(msg) {
                                    Some(id) => {
                                        send_result(id, view("null"));
                                    },
                                    None => {}
                                }
                                return None;
                            }
                            d := &s.docs[index];
                            offset := document_offset(view(d.text), line, character);
                            if offset == no_index() {
                                invalid(msg, method, view("names a position outside the document"));
                                return None;
                            }
                            return Some(Request { uri: uri, index: index, offset: offset });
                        },
                        None => {
                            invalid(msg, method, view("needs a position"));
                            return None;
                        }
                    }
                },
                None => {
                    invalid(msg, method, view("needs a textDocument"));
                    return None;
                }
            }
        },
        None => {
            invalid(msg, method, view("needs params"));
            return None;
        }
    }
}

// --- definition -------------------------------------------------------------

fn handle_definition(s: &mut Server, msg: &json::Value) {
    match prepare(s, msg, view("textDocument/definition")) {
        Some(request) => {
            match id_bytes(msg) {
                Some(id) => {
                    sources := sources_of(s);
                    target := analysis::definition(&sources[request.index], request.offset);
                    if target == no_index() {
                        send_result(id, view("null"));
                        return ();
                    }
                    src := &sources[request.index];
                    lo := src.tokens[target].start;
                    hi := src.tokens[target].end;
                    d := &s.docs[request.index];
                    mut result = u8[];
                    put(&mut result, view("{\"uri\":"));
                    put_string(&mut result, view(d.uri));
                    put(&mut result, view(",\"range\":"));
                    put_range(&mut result, view(d.text), lo, hi);
                    put(&mut result, view("}"));
                    send_result(id, view(result));
                },
                None => {
                    return ();
                }
            }
        },
        None => {}
    }
}

// --- hover ------------------------------------------------------------------

fn handle_hover(s: &mut Server, msg: &json::Value) {
    match prepare(s, msg, view("textDocument/hover")) {
        Some(request) => {
            match id_bytes(msg) {
                Some(id) => {
                    sources := sources_of(s);
                    others := world_of(&sources, request.index);
                    hit := analysis::hover(&sources[request.index], &others, request.offset);
                    if hit.text.len() == 0 {
                        send_result(id, view("null"));
                        return ();
                    }
                    d := &s.docs[request.index];
                    mut result = u8[];
                    put(&mut result, view("{\"contents\":{\"kind\":\"markdown\",\"value\":"));
                    put_string(&mut result, view(hit.text));
                    put(&mut result, view("},\"range\":"));
                    put_range(&mut result, view(d.text), hit.lo, hit.hi);
                    put(&mut result, view("}"));
                    send_result(id, view(result));
                },
                None => {
                    return ();
                }
            }
        },
        None => {}
    }
}

// --- completion -------------------------------------------------------------

fn handle_completion(s: &mut Server, msg: &json::Value) {
    match prepare(s, msg, view("textDocument/completion")) {
        Some(request) => {
            match id_bytes(msg) {
                Some(id) => {
                    sources := sources_of(s);
                    others := world_of(&sources, request.index);
                    items := analysis::completions(&sources[request.index], &others, request.offset);
                    mut result = u8[];
                    put(&mut result, view("{\"isIncomplete\":false,\"items\":["));
                    for i in items.len() {
                        if 0 < i {
                            result.push(44);
                        }
                        put(&mut result, view("{\"label\":"));
                        put_string(&mut result, view(items[i].label));
                        put(&mut result, view(",\"kind\":"));
                        put_num(&mut result, items[i].kind);
                        if 0 < items[i].detail.len() {
                            put(&mut result, view(",\"detail\":"));
                            put_string(&mut result, view(items[i].detail));
                        }
                        put(&mut result, view(",\"sortText\":"));
                        put_string(&mut result, view(items[i].sort));
                        put(&mut result, view("}"));
                    }
                    put(&mut result, view("]}"));
                    send_result(id, view(result));
                },
                None => {
                    return ();
                }
            }
        },
        None => {}
    }
}

// --- rename -----------------------------------------------------------------

// The document that declares a target. A target resolved from a use names the module it
// came from; more than one document with that name is ambiguous and is refused.
fn defining_document(sources: (&analysis::Source[]), target: (&analysis::Target)) -> u64 {
    mut found = no_index();
    for i in sources.len() {
        for k in sources[i].items.len() {
            item := &sources[i].items[k];
            if eq(item.name, view(target.name)) {
                if eq(item.module, view(target.module)) {
                    if found != no_index() {
                        return no_index();
                    }
                    found = i;
                }
            }
        }
    }
    return found;
}
fn rename_edit(
    s: &mut Server,
    sources: (&analysis::Source[]),
    request: (&Request),
    target: (&analysis::Target),
    new_name: &[u8]
) -> (u8[])? {
    mut home = no_index();
    if target.decl != no_index() {
        home = request.index;
    } else {
        home = defining_document(sources, target);
        if home == no_index() {
            return None;
        }
    }
    mut body = u8[];
    put(&mut body, view("{\"changes\":{"));
    mut files = 0;
    for i in s.docs.len() {
        src := &sources[i];
        mut spans = analysis::Span[];
        if target.kind == analysis::R_LOCAL {
            if i == request.index {
                spans = analysis::local_spans(src, target.decl);
            }
        } else {
            if target.kind == analysis::R_ITEM {
                mut others = world_of(sources, i);
                mut decl = no_index();
                if i == home {
                    decl = target.decl;
                    if decl == no_index() {
                        decl = item_token(&sources[i], view(target.name));
                    }
                }
                spans = analysis::item_spans(src, view(target.module), view(target.name), decl, i == home);
            } else {
                if target.kind == analysis::R_FIELD {
                    mut others = world_of(sources, i);
                    spans = analysis::field_spans(
                        src,
                        &others,
                        view(target.module),
                        view(target.record),
                        view(target.name)
                    );
                }
            }
        }
        if 0 < spans.len() {
            if 0 < files {
                body.push(44);
            }
            files += 1;
            d := &s.docs[i];
            put_string(&mut body, view(d.uri));
            put(&mut body, view(":["));
            for k in spans.len() {
                if 0 < k {
                    body.push(44);
                }
                put(&mut body, view("{\"range\":"));
                put_range(&mut body, view(d.text), spans[k].lo, spans[k].hi);
                put(&mut body, view(",\"newText\":"));
                put_string(&mut body, new_name);
                body.push(125);
            }
            body.push(93);
        }
    }
    put(&mut body, view("}}"));
    if files == 0 {
        return None;
    }
    return Some(body);
}
fn item_token(s: &analysis::Source, name: &[u8]) -> u64 {
    for i in s.items.len() {
        if eq(s.items[i].name, name) {
            return s.items[i].token;
        }
    }
    return no_index();
}
fn handle_prepare_rename(s: &mut Server, msg: &json::Value) {
    match prepare(s, msg, view("textDocument/prepareRename")) {
        Some(request) => {
            match id_bytes(msg) {
                Some(id) => {
                    sources := sources_of(s);
                    others := world_of(&sources, request.index);
                    target := analysis::rename_target(&sources[request.index], &others, request.offset);
                    if target.kind == 0 {
                        if 0 < target.refusal.len() {
                            send_error(id, -32001, view(target.refusal));
                        } else {
                            send_result(id, view("null"));
                        }
                        return ();
                    }
                    at := analysis::ident_at(&sources[request.index], request.offset);
                    src := &sources[request.index];
                    if at == no_index() {
                        send_result(id, view("null"));
                        return ();
                    }
                    d := &s.docs[request.index];
                    mut result = u8[];
                    put(&mut result, view("{\"range\":"));
                    put_range(&mut result, view(d.text), src.tokens[at].start, src.tokens[at].end);
                    put(&mut result, view(",\"placeholder\":"));
                    put_string(&mut result, view(target.name));
                    put(&mut result, view("}"));
                    send_result(id, view(result));
                },
                None => {
                    return ();
                }
            }
        },
        None => {}
    }
}
// A rename's new name must be something the language can spell as an identifier.
fn name_is_identifier(name: &[u8]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for i in name.len() {
        c := name[i];
        if !((64 < c) && (c < 91)) {
            if !((96 < c) && (c < 123)) {
                if !((47 < c) && (c < 58)) {
                    if c != 95 {
                        return false;
                    }
                }
            }
        }
        if i == 0 {
            if (47 < c) && (c < 58) {
                return false;
            }
        }
    }
    return true;
}
fn handle_rename(s: &mut Server, msg: &json::Value) {
    match prepare(s, msg, view("textDocument/rename")) {
        Some(request) => {
            match id_bytes(msg) {
                Some(id) => {
                    mut new_name = u8[];
                    match msg.get(view("params")) {
                        Some(params) => {
                            new_name = text_or(params, view("newName"));
                        },
                        None => {}
                    }
                    if !name_is_identifier(view(new_name)) {
                        send_error(id, -32602, view("invalid params: textDocument/rename needs an identifier as newName"));
                        return ();
                    }
                    sources := sources_of(s);
                    others := world_of(&sources, request.index);
                    target := analysis::rename_target(&sources[request.index], &others, request.offset);
                    if target.kind == 0 {
                        if 0 < target.refusal.len() {
                            send_error(id, -32001, view(target.refusal));
                        } else {
                            send_error(id, -32001, view("nothing here can be renamed"));
                        }
                        return ();
                    }
                    match rename_edit(s, &sources, &request, &target, view(new_name)) {
                        Some(edit) => {
                            send_result(id, view(edit));
                        },
                        None => {
                            send_error(
                                id,
                                -32001,
                                view("the declaration of this name is not in an open document")
                            );
                        }
                    }
                },
                None => {
                    return ();
                }
            }
        },
        None => {}
    }
}

const SERVER_VERSION: string = "0.1.0";

fn initialize_result() -> u8[] {
    mut out = u8[];
    put(
        &mut out,
        view(
            "{\"capabilities\":{\"textDocumentSync\":{\"openClose\":true,\"change\":1},\"definitionProvider\":true,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\",\":\"],\"resolveProvider\":false},\"renameProvider\":{\"prepareProvider\":true}},\"serverInfo\":{\"name\":\"grail-lsp\",\"version\":\""
        )
    );
    put(&mut out, view(SERVER_VERSION));
    put(&mut out, view("\"}}"));
    return out;
}
fn handle_initialize(s: &mut Server, msg: &json::Value) {
    match id_bytes(msg) {
        Some(id) => {
            if s.state != 0 {
                send_error(id, -32600, view("initialize has already been received"));
                return ();
            }
            s.state = 1;
            result := initialize_result();
            send_result(id, view(result));
        },
        None => {
            return ();
        }
    }
}
fn handle_shutdown(s: &mut Server, msg: &json::Value) {
    match id_bytes(msg) {
        Some(id) => {
            s.state = 2;
            send_result(id, view("null"));
        },
        None => {
            return ();
        }
    }
}
fn exit_server(s: &mut Server) {
    if s.state == 2 {
        host::exit(0);
    }
    host::exit(1);
}
fn route_named<a>(s: &mut Server, msg: &json::Value, name: &a string) {
    if name == "initialize" {
        handle_initialize(s, msg);
        return ();
    }
    if name == "initialized" {
        return ();
    }
    if name == "shutdown" {
        handle_shutdown(s, msg);
        return ();
    }
    if name == "exit" {
        exit_server(s);
        return ();
    }
    if name == "$/cancelRequest" {
        return ();
    }
    if s.state == 0 {
        answer_error(msg, -32002, view("server not initialized"));
        return ();
    }
    if s.state == 2 {
        answer_error(msg, -32600, view("server is shutting down"));
        return ();
    }
    if name == "textDocument/didOpen" {
        handle_open(s, msg);
        return ();
    }
    if name == "textDocument/didChange" {
        handle_change(s, msg);
        return ();
    }
    if name == "textDocument/didClose" {
        handle_close(s, msg);
        return ();
    }
    if name == "textDocument/definition" {
        handle_definition(s, msg);
        return ();
    }
    if name == "textDocument/hover" {
        handle_hover(s, msg);
        return ();
    }
    if name == "textDocument/completion" {
        handle_completion(s, msg);
        return ();
    }
    if name == "textDocument/prepareRename" {
        handle_prepare_rename(s, msg);
        return ();
    }
    if name == "textDocument/rename" {
        handle_rename(s, msg);
        return ();
    }
    answer_error(msg, -32601, view("method not found"));
}
fn dispatch(s: &mut Server, msg: &json::Value) {
    match msg.get(view("method")) {
        Some(method) => {
            match method.as_str() {
                Some(name) => {
                    route_named(s, msg, name);
                },
                None => {
                    answer_error(msg, -32600, view("invalid request: method must be a string"));
                }
            }
        },
        None => {
            // A response, or an object with no method: nothing is pending, so ignore it.
            return ();
        }
    }
}
fn receive(s: &mut Server, body: &[u8]) {
    match json::parse(body) {
        value: json::Value => {
            dispatch(s, &value);
        },
        error: json::Error => {
            send_error(copy_bytes(view("null")), -32700, view("parse error"));
        }
    }
}

// ---------------------------------------------------------------------------
// framing loop
// ---------------------------------------------------------------------------

fn drop_prefix(s: &mut Server, count: u64) {
    mut kept = u8[];
    mut i = count;
    while i < s.pending.len() {
        kept.push(s.pending[i]);
        i += 1;
    }
    exchange(&mut s.pending, kept);
}
fn pump(s: &mut Server) {
    while true {
        end := header_end(view(s.pending));
        if end == no_index() {
            if 65536 < s.pending.len() {
                exchange(&mut s.pending, u8[]);
                send_error(
                    copy_bytes(view("null")),
                    -32700,
                    view("invalid frame: no header terminator")
                );
            }
            return ();
        }
        start := end + 4;
        length := content_length(s.pending[0: end]);
        if length == no_index() {
            // The frame cannot be bounded, so it is answered and discarded. Whatever is left
            // is unattributable unless a header line starts it, and is dropped in that case
            // too; the next frame that arrives is then read from its own header.
            drop_prefix(s, start);
            next := header_start(view(s.pending));
            if next != no_index() {
                drop_prefix(s, next);
            } else {
                exchange(&mut s.pending, u8[]);
            }
            send_error(
                copy_bytes(view("null")),
                -32700,
                view("invalid frame: Content-Length is missing or malformed")
            );
            continue;
        }
        total := start + length;
        if s.pending.len() < total {
            return ();
        }
        mut body = u8[];
        for i in length {
            body.push(s.pending[start + i]);
        }
        drop_prefix(s, total);
        receive(s, view(body));
    }
}
fn main() -> u64 {
    mut server = server_new();
    while true {
        chunk := host::read_fd(0, 65536);
        if chunk.len() == 0 {
            return 0;
        }
        for i in chunk.len() {
            server.pending.push(chunk[i]);
        }
        pump(&mut server);
    }
    return 0;
}
