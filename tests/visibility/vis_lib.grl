module vis_lib;

// Visibility: what carries `pub` is this module's surface; the rest is its own.
pub struct Point {
    x: u64,
    y: u64
}

struct Secret {
    v: u64
}

pub const limit: u64 = 10;
const hidden: u64 = 7;

pub fn make(x: u64) -> Point {
    return Point { x: x, y: helper(x) };
}

fn helper(x: u64) -> u64 {
    s := Secret { v: x + hidden };
    return s.v;
}

// A public generic whose body uses a private helper: an importer instantiates it, so the helper
// travels in the interface, marked private.
pub fn twice_all<T>(items: T[], f: Fn(T) -> u64) -> u64 {
    mut total = 0;
    mut rest = items;
    while rest.len() != 0 {
        total = total + double(f(rest.pop()));
    }
    return total;
}

fn double(x: u64) -> u64 {
    return x * 2;
}

impl Point {
    pub fn sum<a>(self: (&a Point)) -> u64 {
        return self.x + self.y + self.offset();
    }
    fn offset<a>(self: (&a Point)) -> u64 {
        return 0;
    }
}
