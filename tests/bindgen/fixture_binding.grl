module fixture;

// Generated by `grail bindgen` from tests/bindgen/fixture.h.
//
// C and Grail types cross as: `char` is u8, `int` is i32, `long` is i64 on a
// 64-bit LP64 host (-M llp64 for Win64), pointers are CPtr (const pointee) or
// CMutPtr, `const char *` is CStr, a struct pointer is CPtr, and a function
// pointer is cfn. A struct passed by pointer is a CPtr or the record itself; a
// struct passed by value needs `byval` at the call site.
// Function-like macros and file-scope variables are not bindings (Grail has no
// macros and no extern globals); run with --strict to refuse them instead.

