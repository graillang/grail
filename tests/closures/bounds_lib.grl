module bounds_lib;

// A library whose signatures state what the closures they take may capture; an importer checks its
// calls against these rows alone (docs/design/closure-bounds.md).
pub struct Work { run: Fn<Send, Owned>() -> u64 }
pub fn make(f: Fn<Send, Owned>() -> u64) -> Work { return Work { run: f }; }
pub fn run_all(items: Work[]) -> u64 {
    out := parallel_map(items, 0, one);
    mut t = 0;
    for i in out.len() { t += out[i]; }
    return t;
}
fn one(w: Work, unused: u64) -> u64 { f := &w.run; return f(); }
pub fn keep<T: Send + Owned>(t: T) -> T { return t; }
