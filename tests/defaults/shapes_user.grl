use shapes;
struct Sq { s: u64 }
impl shapes::Shape for Sq {
    fn area(self: &Self) -> u64 { return self.s * self.s; }
    fn name(self: &Self) -> u64 { return 9; }
}
struct Dot { n: u64 }
impl shapes::Shape for Dot {
    fn area(self: &Self) -> u64 { return self.n; }
}
fn main() {
    q := Sq { s: 3 };
    println(q.double_area());
    println(q.name());
    println(q.summary());
    d := Dot { n: 5 };
    println(d.name());
    println(shapes::describe(&d));
}
