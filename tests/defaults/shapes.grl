module shapes;

// An interface whose default methods are compiled for implementations in other modules.
pub interface Shape {
    fn area(self: &Self) -> u64;
    // A default that calls a required method.
    fn double_area(self: &Self) -> u64 { return self.area() * 2; }
    // A default an implementation overrides.
    fn name(self: &Self) -> u64 { return 7; }
    // A default calling another default.
    fn summary(self: &Self) -> u64 { return self.double_area() + self.name(); }
}
pub fn describe<T: Shape>(t: (&T)) -> u64 { return t.summary(); }
