module ffi_callback_words;

// C calling back into Grail with eight word arguments. AArch64 (x0-x7) and RISC-V 64 (a0-a7) pass
// all eight in registers, so the callback prologue reads them; the weights make a parameter read
// from the wrong register change the sum. Executed on those two targets only - x86-64 SysV passes
// the seventh and eighth words on the stack, which the callback prologue does not read, so the
// compiler refuses the shape there instead of reading a register that holds something else.
extern "C" fn g_words8(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64) -> i64 {
    return a0 + 2 * a1 + 3 * a2 + 4 * a3 + 5 * a4 + 6 * a5 + 7 * a6 + 8 * a7;
}
extern "C" lib "shim.o" fn c_call_words8(cb: cfn(i64, i64, i64, i64, i64, i64, i64, i64) -> i64) -> i64;

fn main() -> u64 {
    unsafe {
        println(c_call_words8(g_words8));
    }
    return 0;
}
