// C calls Grail callbacks whose parameters and results are floats and narrow integers: the
// callback prologue reads each parameter from the register (or stack slot) the platform C
// convention put it in, widens f32 and extends narrow integers.
extern "C" fn g_fmix(a: f64, b: i8, c: f32, d: u16, e: i64, f: f32) -> f64 {
    return a + f64(b) * 10.0 + f64(c) + f64(d) + f64(e) + f64(f);
}
extern "C" fn g_f32(x: f32, y: f32) -> f32 {
    return x * y;
}
extern "C" lib "shim.o" fn c_call_fmix(cb: cfn(f64, i8, f32, u16, i64, f32) -> f64) -> f64;
extern "C" lib "shim.o" fn c_call_f32(cb: cfn(f32, f32) -> f32) -> f32;

fn main() -> u64 {
    unsafe {
        println(c_call_fmix(g_fmix));
        println(c_call_f32(g_f32));
    }
    return 0;
}
