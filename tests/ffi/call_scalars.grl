module ffi_call_scalars;

// `extern "C"` declares a symbol the host linker resolves. The `lib` input is a
// linker input resolved next to this source file; the compiler emits it as a
// `// grail-link:` note that the build tooling obeys. `as` renames the linker
// symbol without renaming the Grail function.
extern "C" lib "shim.o" fn c_add(a: i64, b: i64) -> i64;
extern "C" lib "shim.o" as "c_mul" fn scale(a: i64, b: i64) -> i64;
extern "C" lib "shim.o" fn c_negate(v: i64) -> i64;
extern "C" lib "shim.o" fn c_sum4(a: i64, b: i64, c: i64, d: i64) -> i64;
extern "C" lib "shim.o" fn c_choose(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64;
extern "C" lib "shim.o" fn c_identity(v: u64) -> u64;

fn main() -> u64 {
    mut total: i64 = 0;
    mut seen: u64 = 0;
    unsafe {
        total = c_add(19, 23);
        total = total + scale(2, 3);
        total = total + c_negate(-1);
        total = total + c_sum4(1, 2, 3, 4);
        total = total + c_choose(9, 1, 9, 1, 9, 1);
        seen = c_identity(7);
    }
    println(total);
    println(seen);
    if seen != 7 {
        return 1;
    }
    if total != 83 {
        return 1;
    }
    return 0;
}
