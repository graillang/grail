module ffi_call_words;

// More than six word arguments. The per-target integer register file decides where the seventh and
// eighth words go - registers on AAPCS64 and RISC-V 64, the outgoing stack area on x86-64 SysV - and
// the ninth word is on the stack everywhere. Every C twin weights its arguments by position, so a
// word that is dropped, duplicated or read from the wrong place changes the printed sum.
extern "C" lib "shim.o" fn c_words7(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) -> i64;
extern "C" lib "shim.o" fn c_words8(
    a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64
) -> i64;
extern "C" lib "shim.o" fn c_words9(
    a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64
) -> i64;
extern "C" lib "shim.o" fn c_words9_order(
    a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64
) -> i64;
extern "C" lib "shim.o" fn c_words8n(a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32, a6: i32, a7: i32) -> i32;

// A value the compiler cannot fold: each argument below is produced by a Grail call immediately
// before the foreign call, so the seventh and eighth words are moved into the last argument
// registers by a store the optimizer must keep alive across the call.
fn step(x: i64) -> i64 {
    return x * 3 + 1;
}

fn main() -> u64 {
    unsafe {
        println(c_words7(1, 2, 3, 4, 5, 6, 7));
        println(c_words8(1, 2, 3, 4, 5, 6, 7, 8));
        println(c_words9(1, 2, 3, 4, 5, 6, 7, 8, 9));
        println(c_words9_order(1, 2, 3, 4, 5, 6, 7, 8, 9));
        println(c_words8n(1, 2, 3, 4, 5, 6, 7, 8));
        println(c_words9(step(1), step(2), step(3), step(4), step(5), step(6), step(7), step(8), step(9)));
        println(c_words8(step(9), step(8), step(7), step(6), step(5), step(4), step(3), step(2)));
        println(c_words7(step(2), step(4), step(6), step(8), step(10), step(12), step(14)));
    }
    return 0;
}
