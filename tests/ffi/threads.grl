module ffi_threads;
use pool;

// Foreign calls from runtime-created threads (a pool worker, a green task's scheduler thread) run
// on that thread's own glibc TCB: libc state that lives in the TCB - errno, pthread_self, the
// malloc tcache - is the calling thread's, not the main thread's.
handle Block;

extern "C" lib "thread_shim.o" fn ts_errno_hold(value: i64) -> i64;
extern "C" lib "thread_shim.o" fn ts_arrived() -> i64;
extern "C" lib "thread_shim.o" fn ts_errno() -> i64;
extern "C" lib "c" fn getpid() -> i32;
extern "C" lib "c" fn strlen(s: CStr) -> u64;
extern "C" lib "c" fn malloc(size: u64) -> Block;
extern "C" lib "c" fn free(block: Block) -> unit;
extern "C" lib "c" fn close(fd: i32) -> i32;
extern "C" lib "c" fn pthread_self() -> u64;

// The libc calls a worker or a task makes, folded into one checked word: 1 when getpid matches the
// main thread's, strlen counts, malloc returns storage, close(-1) leaves EBADF (9) in this thread's
// errno, and pthread_self names a thread other than the main one.
fn probe(pid: i32, main_self: u64) -> u64 {
    mut ok: u64 = 1;
    unsafe {
        if getpid() != pid {
            ok = 0;
        }
        if strlen(cstr("seven\0")) != 5 {
            ok = 0;
        }
        block := malloc(64);
        free(block);
        bad: i32 := -1;
        if close(bad) != bad {
            ok = 0;
        }
        if ts_errno() != 9 {
            ok = 0;
        }
        if pthread_self() == main_self {
            ok = 0;
        }
    }
    return ok;
}
fn task_probe(item: u64, unused: u64) -> u64 {
    mut pid: i32 = 0;
    unsafe {
        pid = getpid();
    }
    return probe(pid, item);
}
fn body<s>(sc: (&s Scope<u64>), main_self: u64) -> u64 {
    a := spawn(sc, main_self, task_probe);
    return join(a);
}

fn main() -> u64 {
    mut pid: i32 = 0;
    mut main_self: u64 = 0;
    unsafe {
        pid = getpid();
        main_self = pthread_self();
    }
    // 1. A pool worker.
    worker := pool::wait(pool::spawn(|| -> u64 probe(pid, main_self)));
    println(worker);
    // 2. A spawned green task, on a scheduler thread.
    println(task_scope(main_self, body));
    // 3. errno isolation: the main thread and a worker each set errno and hold it while the other
    //    sets its own; each reads back its own value.
    other := pool::spawn(|| -> i64 {
        mut seen: i64 = 0;
        unsafe {
            seen = ts_errno_hold(21);
        }
        return seen;
    });
    mut mine: i64 = 0;
    unsafe {
        mine = ts_errno_hold(42);
    }
    theirs := pool::wait(other);
    println(mine);
    println(theirs);
    unsafe {
        println(ts_arrived());
    }
    if (worker != 1) || (mine != 42) || (theirs != 21) {
        return 1;
    }
    return 0;
}
