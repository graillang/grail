// A COM method with more than four arguments and floats: the vtable slot is read as a typed
// `cfn`, so the call uses the full platform convention (Win64: four registers, the rest on the
// stack, floats in xmm slots), the same lowering as any other C call.
extern "C" lib "shim.o" fn c_com_object() -> u64;
extern "C" lib "shim.o" as "c_com_slot" fn add_slot(object: u64, index: u64) -> cfn(u64, i64) -> i64;
extern "C" lib "shim.o" as "c_com_slot" fn many_slot(object: u64, index: u64) -> cfn(u64, i64, i64, i64, f64, i64, f32, i64) -> i64;

fn main() -> u64 {
    unsafe {
        object := c_com_object();
        add := add_slot(object, 0);
        println(add(object, 7));
        many := many_slot(object, 1);
        quarter: f32 := 0.25;
        println(many(object, 1, 2, 3, 0.5, 4, quarter, 5));
    }
    return 0;
}
