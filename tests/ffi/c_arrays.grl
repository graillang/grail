module ffi_c_arrays;

// A C array inside a C record is declared `f: [T; N]` and laid out inline, as C lays it out: it is a
// fixed-size array, indexed in place, borrowed as a slice and assigned whole.
extern "C" record Pt { x: i32, w: f32 }
extern "C" record Dev { kind: u16, name: [u8; 16], ids: [u32; 4], weights: [f32; 3], pts: [Pt; 2], deltas: [i8; 3], tail: i64 }

extern "C" lib "shim.o" fn c_ca_fill(d: &mut Dev) -> unit;
extern "C" lib "shim.o" fn c_ca_sum(d: &mut Dev) -> i64;
extern "C" lib "shim.o" fn c_ca_size() -> u64;
extern "C" lib "shim.o" fn c_ca_greeting() -> CStr;
extern "C" lib "shim.o" fn c_ca_null() -> CStr;
extern "C" lib "shim.o" fn c_ca_names() -> CPtr;
extern "C" lib "shim.o" fn c_ca_name_count() -> u64;
extern "C" lib "shim.o" fn c_ca_ints() -> CPtr;
extern "C" lib "shim.o" fn c_ca_pts() -> CPtr;

// A fixed C char buffer holds a NUL-terminated name: the bytes up to the first NUL.
fn until_nul(b: &[u8]) -> u8[] {
    mut out = u8[];
    for x in b {
        if x == 0 {
            return out;
        }
        out.push(x);
    }
    return out;
}

fn main() -> u64 {
    @assert(size_of(Dev) == 80, "Dev has C's layout");
    mut d = Dev { kind: 0, name: [0; 16], ids: [0; 4], weights: [0.0; 3], pts: [Pt { x: 0, w: 0.0 }, Pt { x: 0, w: 0.0 }], deltas: [0; 3], tail: 0 };
    unsafe {
        println(c_ca_size());
        c_ca_fill(&mut d);
    }
    println(until_nul(&d.name).text());
    ids := d.ids;
    println("{} {} {}", ids.len(), ids[0], ids[3]);
    w := d.weights;
    println("{} {}", w[0], w[2]);
    pts := d.pts;
    println("{} {}", pts[0].x, pts[1].w);
    deltas := d.deltas;
    println("{} {}", deltas[0], deltas[2]);
    println(d.tail);
    // Assign a whole array back; C sees the new elements.
    mut more = d.ids;
    more[3] = 1000;
    d.ids = more;
    unsafe {
        println(c_ca_sum(&mut d));
        println(cstr_bytes(c_ca_greeting()).text());
        println(cstr_bytes(c_ca_null()).len());
        // A C array handed out by pointer and length: copied into a bounds-checked vector.
        names := cslice(CStr, c_ca_names(), c_ca_name_count());
        for i in names.len() {
            println(cstr_bytes(names[i]).text());
        }
        ints := cslice(i32, c_ca_ints(), 4);
        println("{} {}", ints[1], ints[3]);
        ps := cslice(Pt, c_ca_pts(), 2);
        println("{} {}", ps[1].x, ps[0].w);
    }
    return 0;
}
