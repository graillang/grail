// C records returned by value: an 8-byte record in one register, a 16-byte record in two
// (by hidden pointer on Win64), and a 24-byte record through a hidden result pointer, which
// shifts the arguments on SysV, Win64 and RV64 but is x8 on AAPCS64.
extern "C" record Pair32 { a: i32, b: i32 }
extern "C" record Span16 { start: i64, len: i64 }
extern "C" record Triple { x: i64, y: i64, z: i32 }
extern "C" lib "shim.o" fn c_make_pair(a: i32, b: i32) -> Pair32;
extern "C" lib "shim.o" fn c_make_span(start: i64, len: i64) -> Span16;
extern "C" lib "shim.o" fn c_make_triple(x: i64, y: i64, z: i32, scale: f64) -> Triple;

fn main() -> u64 {
    unsafe {
        p := c_make_pair(-7, 300000);
        println(p.a);
        println(p.b);
        s := c_make_span(4096, -12);
        println(s.start);
        println(s.len);
        t := c_make_triple(21, -5, 77, 2.0);
        println(t.x);
        println(t.y);
        println(t.z);
    }
    return 0;
}
