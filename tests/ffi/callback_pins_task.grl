module callback_pins_task;
use host;
// A Grail callback that C called from a green task may wait - here it sleeps - and the task must
// come back to the same OS thread, because C's frames are on its stack and C's thread-locals belong
// to that thread. 200 tasks on 4 workers each call into C, which calls back, which sleeps; C then
// checks that pthread_self() did not change under its frame. Before pinning, a task resumed on
// whichever worker took it, and most of these came back on another thread.
// grail-link: thread_shim.o
// grail-link: c
extern "C" lib "c" fn pthread_self() -> u64;
extern "C" lib "thread_shim.o" fn ts_same_thread_apply(callback: cfn(i64) -> i64, value: i64) -> i64;

extern "C" fn napping(value: i64) -> i64 {
    host::sleep_ms(1 + u64(value) % 3);
    return value + 1;
}
fn call(n: u64, unused: u64) -> u64 {
    mut r: i64 = 0;
    unsafe {
        r = ts_same_thread_apply(napping, i64(n));
    }
    if r < 0 { return 1; }
    return 0;
}
fn body<s>(sc: (&s Scope<u64>), count: u64) -> u64 {
    mut hs = Task<u64>[];
    for i in count { hs.push(spawn(sc, i, call)); }
    mut moved = 0;
    while hs.len() != 0 { moved += join(hs.pop()!); }
    return moved;
}
fn main() {
    println(task_scope(200, body));
}
