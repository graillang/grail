// C records with float fields returned by value: SysV per-eightbyte SSE/INTEGER classes,
// AAPCS64 homogeneous float aggregates, RV64 flattened float+int fields, and the integer and
// hidden-pointer paths, as the shim's comment lays out per ABI.
extern "C" record Vec2 { x: f32, y: f32 }
extern "C" record Vec3d { x: f64, y: f64, z: f64 }
extern "C" record Fi { f: f32, i: i32 }
extern "C" record Di { d: f64, i: i64 }
extern "C" record Quad { a: f32, b: f32, c: f32, d: f32 }
extern "C" lib "shim.o" fn c_vec2(x: f32, y: f32) -> Vec2;
extern "C" lib "shim.o" fn c_vec3d(s: f64) -> Vec3d;
extern "C" lib "shim.o" fn c_fi(f: f32, i: i32) -> Fi;
extern "C" lib "shim.o" fn c_di(d: f64, i: i64) -> Di;
extern "C" lib "shim.o" fn c_quad(s: f32) -> Quad;

fn main() -> u64 {
    unsafe {
        v := c_vec2(1.5, -2.25);
        println(v.x);
        println(v.y);
        w := c_vec3d(0.5);
        println(w.x + w.y + w.z);
        f := c_fi(0.75, -9);
        println(f.f);
        println(f.i);
        d := c_di(3.125, 1234567890123);
        println(d.d);
        println(d.i);
        q := c_quad(10.0);
        println(q.a + q.b + q.c + q.d);
    }
    return 0;
}
