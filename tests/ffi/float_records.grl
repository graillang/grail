// C records with float and double fields, passed by pointer: Grail writes f32/f64 fields the C
// side reads at C's offsets, and reads back fields C wrote. f32 fields are 4-byte binary32.
extern "C" record Viewport { x: f32, y: f32, width: f32, height: f32, min_depth: f32, max_depth: f32, flags: i32, scale: f64 }
extern "C" lib "shim.o" fn c_viewport_area(v: Viewport) -> f64;
extern "C" lib "shim.o" fn c_viewport_fill(v: Viewport) -> unit;

fn main() -> u64 {
    mut v = Viewport { x: 0.0, y: 0.0, width: 800.0, height: 600.0, min_depth: 0.25, max_depth: 0.5, flags: 3, scale: 2.0 };
    unsafe {
        println(c_viewport_area(v));
        c_viewport_fill(v);
    }
    println(v.x);
    println(v.y);
    println(v.width);
    println(v.max_depth);
    println(v.flags);
    println(v.scale);
    v.height = 0.5;
    unsafe {
        println(c_viewport_area(v));
    }
    return 0;
}
