// Every method name of the atomics family runs (docs/design/concurrency-stages-5-7.md, "Stage 7"):
// each load, store, read-modify-write and compare-exchange under each ordering it has a name for.
@no_alloc
@no_panic
fn every<a>(c: (&a Atomic<u64>), f: (&a Atomic<bool>), s: (&a Atomic<i32>)) -> u64 {
    mut t = 0;
    t = wrapping_add(t, c.load());
    t = wrapping_add(t, c.load_relaxed());
    t = wrapping_add(t, c.load_acquire());
    c.store(1);
    c.store_relaxed(2);
    c.store_release(3);
    t = wrapping_add(t, c.swap(5));
    t = wrapping_add(t, c.swap_relaxed(5));
    t = wrapping_add(t, c.swap_acquire(5));
    t = wrapping_add(t, c.swap_release(5));
    t = wrapping_add(t, c.swap_acqrel(5));
    t = wrapping_add(t, c.fetch_add(3));
    t = wrapping_add(t, c.fetch_add_relaxed(3));
    t = wrapping_add(t, c.fetch_add_acquire(3));
    t = wrapping_add(t, c.fetch_add_release(3));
    t = wrapping_add(t, c.fetch_add_acqrel(3));
    t = wrapping_add(t, c.fetch_sub(1));
    t = wrapping_add(t, c.fetch_sub_relaxed(1));
    t = wrapping_add(t, c.fetch_sub_acquire(1));
    t = wrapping_add(t, c.fetch_sub_release(1));
    t = wrapping_add(t, c.fetch_sub_acqrel(1));
    t = wrapping_add(t, c.fetch_and(255));
    t = wrapping_add(t, c.fetch_and_relaxed(255));
    t = wrapping_add(t, c.fetch_and_acquire(255));
    t = wrapping_add(t, c.fetch_and_release(255));
    t = wrapping_add(t, c.fetch_and_acqrel(255));
    t = wrapping_add(t, c.fetch_or(64));
    t = wrapping_add(t, c.fetch_or_relaxed(64));
    t = wrapping_add(t, c.fetch_or_acquire(64));
    t = wrapping_add(t, c.fetch_or_release(64));
    t = wrapping_add(t, c.fetch_or_acqrel(64));
    t = wrapping_add(t, c.fetch_xor(1));
    t = wrapping_add(t, c.fetch_xor_relaxed(1));
    t = wrapping_add(t, c.fetch_xor_acquire(1));
    t = wrapping_add(t, c.fetch_xor_release(1));
    t = wrapping_add(t, c.fetch_xor_acqrel(1));
    t = wrapping_add(t, c.fetch_min(1000));
    t = wrapping_add(t, c.fetch_min_relaxed(1000));
    t = wrapping_add(t, c.fetch_min_acquire(1000));
    t = wrapping_add(t, c.fetch_min_release(1000));
    t = wrapping_add(t, c.fetch_min_acqrel(1000));
    t = wrapping_add(t, c.fetch_max(2));
    t = wrapping_add(t, c.fetch_max_relaxed(2));
    t = wrapping_add(t, c.fetch_max_acquire(2));
    t = wrapping_add(t, c.fetch_max_release(2));
    t = wrapping_add(t, c.fetch_max_acqrel(2));
    t = wrapping_add(t, c.compare_exchange(c.load(), 9));
    if c.compare_exchange_weak(9, 10) {
        t = wrapping_add(t, 1);
    }
    t = wrapping_add(t, c.compare_exchange_relaxed(c.load(), 9));
    if c.compare_exchange_weak_relaxed(9, 10) {
        t = wrapping_add(t, 1);
    }
    t = wrapping_add(t, c.compare_exchange_acquire(c.load(), 9));
    if c.compare_exchange_weak_acquire(9, 10) {
        t = wrapping_add(t, 1);
    }
    t = wrapping_add(t, c.compare_exchange_release(c.load(), 9));
    if c.compare_exchange_weak_release(9, 10) {
        t = wrapping_add(t, 1);
    }
    t = wrapping_add(t, c.compare_exchange_acqrel(c.load(), 9));
    if c.compare_exchange_weak_acqrel(9, 10) {
        t = wrapping_add(t, 1);
    }
    if f.swap(true) {
        t = wrapping_add(t, 1);
    }
    if f.swap_relaxed(true) {
        t = wrapping_add(t, 1);
    }
    if f.swap_acquire(true) {
        t = wrapping_add(t, 1);
    }
    if f.swap_release(true) {
        t = wrapping_add(t, 1);
    }
    if f.swap_acqrel(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_and(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_and_relaxed(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_and_acquire(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_and_release(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_and_acqrel(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_or(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_or_relaxed(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_or_acquire(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_or_release(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_or_acqrel(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_xor(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_xor_relaxed(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_xor_acquire(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_xor_release(true) {
        t = wrapping_add(t, 1);
    }
    if f.fetch_xor_acqrel(true) {
        t = wrapping_add(t, 1);
    }
    if s.fetch_min(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_min_relaxed(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_min_acquire(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_min_release(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_min_acqrel(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_max(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_max_relaxed(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_max_acquire(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_max_release(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_max_acqrel(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_add(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_add_relaxed(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_add_acquire(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_add_release(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_add_acqrel(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_sub(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_sub_relaxed(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_sub_acquire(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_sub_release(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    if s.fetch_sub_acqrel(-3) < 0 {
        t = wrapping_add(t, 1);
    }
    fence();
    fence_acquire();
    fence_release();
    spin_hint();
    return t;
}
fn main() {
    c := Atomic::new(0);
    f := Atomic::new(false);
    s := Atomic::new(i32(0));
    println(every(&c, &f, &s));
    println(c.load());
    println(f.load());
    println(s.load());
}
