// Every width of `Atomic<T>` wraps at its own size, and fetch_min/fetch_max compare as T does:
// signed for i8..i64, unsigned for u8..u64, at the boundaries of each width.
fn main() {
    a8 := Atomic::new(u8(250));
    println(a8.fetch_add(10));
    println(a8.load());
    println(a8.fetch_sub(5));
    println(a8.load());
    println(a8.fetch_max(255));
    println(a8.fetch_min(0));
    println(a8.load());

    s8 := Atomic::new(i8(127));
    println(s8.fetch_add(1));
    println(s8.load());
    println(s8.fetch_sub(1));
    println(s8.load());
    println(s8.fetch_max(i8(-1)));
    println(s8.fetch_min(i8(-128)));
    println(s8.fetch_max(i8(0)));
    println(s8.load());

    a16 := Atomic::new(u16(65535));
    println(a16.fetch_add(1));
    println(a16.load());
    println(a16.fetch_max(u16(32768)));
    println(a16.fetch_min(u16(32767)));
    println(a16.load());

    s16 := Atomic::new(i16(-32768));
    println(s16.fetch_sub(1));
    println(s16.load());
    println(s16.fetch_min(i16(-32768)));
    println(s16.fetch_max(i16(32767)));
    println(s16.load());

    a32 := Atomic::new(u32(4294967295));
    println(a32.fetch_add(2));
    println(a32.load());
    println(a32.fetch_max(u32(2147483648)));
    println(a32.fetch_min(u32(2147483647)));
    println(a32.load());

    s32 := Atomic::new(i32(2147483647));
    println(s32.fetch_add(1));
    println(s32.load());
    println(s32.fetch_max(i32(-1)));
    println(s32.fetch_min(i32(-2147483648)));
    println(s32.load());

    a64 := Atomic::new(18446744073709551615);
    println(a64.fetch_add(1));
    println(a64.load());
    println(a64.fetch_max(9223372036854775808));
    println(a64.fetch_min(9223372036854775807));
    println(a64.load());

    s64 := Atomic::new(i64(9223372036854775807));
    println(s64.fetch_add(1));
    println(s64.load());
    println(s64.fetch_max(i64(-1)));
    println(s64.fetch_min(i64(-9223372036854775808)));
    println(s64.fetch_max(i64(0)));
    println(s64.load());

    bits := Atomic::new(u8(12));
    println(bits.fetch_and(10));
    println(bits.fetch_or(3));
    println(bits.fetch_xor(255));
    println(bits.swap(7));
    println(bits.compare_exchange(7, 9));
    println(bits.compare_exchange(7, 11));
    println(bits.load());

    flag := Atomic::new(false);
    println(flag.swap(true));
    println(flag.fetch_and(true));
    println(flag.fetch_xor(true));
    println(flag.fetch_or(false));
    println(flag.compare_exchange(false, true));
    println(flag.load());
}
