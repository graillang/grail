// A `@no_alloc` function may fail - an index past the end - and its failure allocates nothing on
// any route: here it runs as a parallel job inside a task, so the failure takes the job-failure
// path (the drain, the publish, the containment), and the task's try_join reports it. The
// formatting of the message and the site happens in the joiner, which is allowed to allocate.
use host;
use pool;

@no_alloc
fn leaf(s: &mut [u64]) {
    s[s.len()] = 1;
}
fn work(n: u64, unused: u64) -> u64 {
    mut v = u64[1, 2, 3, 4, 5, 6, 7, 8];
    pool::split_mut<u64>(&mut v[0: 8], 2, leaf);
    return v[0];
}
fn body<s>(sc: (&s Scope<u64>), unused: u64) -> u64 {
    t := spawn(sc, 0, work);
    match try_join(t) {
        v: u64 => println(v),
        f: TaskFailure => {
            host::print(f.message);
            host::print(view("\n"));
        }
    }
    return 1;
}
fn main() {
    println(task_scope(0, body));
}
