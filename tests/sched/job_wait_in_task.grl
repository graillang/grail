// A job that waits must not hold a worker, and a task waiting for that job must not either. Every
// worker's task forks one job that sleeps 300 ms; a ticker task sleeping 10 ms at a time keeps
// ticking throughout. With jobs on a pool of their own the waiting tasks each put a scheduler
// thread to sleep and the ticker stalled for the whole 300 ms.
use host;
use pool;

fn blocker(n: u64, unused: u64) -> u64 {
    r := pool::run<u64>(1, |i: u64| -> u64 { host::sleep_ms(300); return i + 1; });
    return r[0];
}
fn ticker(n: u64, unused: u64) -> u64 {
    mut worst = 0;
    mut last = host::now_ms();
    for i in 40 {
        host::sleep_ms(10);
        now := host::now_ms();
        if now - last > worst { worst = now - last; }
        last = now;
    }
    return worst;
}
fn body<s>(sc: (&s Scope<u64>), unused: u64) -> u64 {
    t := spawn(sc, 0, ticker);
    host::sleep_ms(30);
    mut hs = Task<u64>[];
    for i in host::workers() { hs.push(spawn(sc, i, blocker)); }
    mut total = 0;
    while let Some(h) = hs.pop() { total += join(h); }
    assert(total == host::workers());
    worst := join(t);
    assert(worst < 150);
    return 1;
}
fn main() {
    println(task_scope(0, body));
}
