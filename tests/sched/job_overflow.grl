// Deep recursion inside a job runs into the guard page of the stack the job borrowed. It is
// reported as a stack overflow with status 134, as it is for a task and for the main thread - not
// as an unexplained SIGSEGV, which is what a job on a pool thread used to be.
use pool;

fn deep(n: u64) -> u64 {
    if n == 0 { return 0; }
    return deep(n - 1) + 1;
}
fn main() {
    println("before");
    r := pool::wait(pool::spawn<u64>(|| -> u64 deep(100000000)));
    println(r);
}
