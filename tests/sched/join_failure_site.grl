// A failure in a branch of `pool::join` that another worker ran is reported, at the task's
// try_join, with the statement that failed and the user's own `pool::join` call as the join - not
// the line inside lib/pool.grl that forks the branch.
use host;
use pool;

fn bad(n: u64) -> u64 {
    v := u64[1];
    return v[n];
}
fn work(n: u64, unused: u64) -> u64 {
    started := Atomic::new(0);
    flag := &started;
    seen := &started;
    p := pool::join<u64,u64>(|| -> u64 { flag.store(1); host::sleep_ms(20); return bad(7); }, || -> u64 {
        t0 := host::now_ms();
        while seen.load() == 0 && host::now_ms() - t0 < 1000 {}
        return 1;
    });
    return p.first + p.second;
}
// Each line of a site, as its marker and the file name without directories: the corpus runs
// from a staged, renamed copy, so the directories are not the source tree's.
fn print_tails(bytes: u8[]) {
    mut line = u8[];
    for i in bytes.len() {
        b := bytes[i];
        if b == 10 {
            mut start = 0;
            mut first = line.len();
            for k in line.len() {
                if line[k] == 47 {
                    start = k + 1;
                    if first == line.len() { first = k; }
                }
                // The corpus also renames the file `N-files-0-NAME`: keep NAME.
                if line[k] == 45 && first < k { start = k + 1; }
            }
            mut keep = 0;
            for k in first {
                if line[k] == 32 { keep = k + 1; }
            }
            if first == line.len() { keep = 0; start = 0; }
            mut out = u8[];
            for k in keep { out.push(line[k]); }
            for k in line.len() - start { out.push(line[start + k]); }
            println(out.text());
            line = u8[];
        } else {
            line.push(b);
        }
    }
}
fn body<s>(sc: (&s Scope<u64>), unused: u64) -> u64 {
    t := spawn(sc, 0, work);
    match try_join(t) {
        v: u64 => println(v),
        f: TaskFailure => {
            host::print(f.message);
            host::print(view("\n"));
            print_tails(f.site);
        }
    }
    return 1;
}
fn main() {
    println(task_scope(0, body));
}
