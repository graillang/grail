// A task calling host::read_file must not stall the others: the blocking file I/O runs with the
// task's worker handed to another thread (rt_offload), so another task runs meanwhile. The reader
// reads a file that main wrote, then waits - sleeping, so it parks - for a word the writer task sets.
// Whether the writer ran during the read or after it is not fixed (the read may finish first), so the
// reader waits for the word rather than racing it; the joined sum (5 * 100 + 10 bytes + 1) proves the
// read returned the file and the writer was not starved.
unsafe module runtime;
use host;
fn reader(n: u64, word: u64) -> u64 {
    text := host::read_file(view("offload-probe.txt"));
    bytes := text.len();
    rt_drop_seq(text);
    while raw_atomic_load(word) == 0 {
        host::sleep_ms(1);
    }
    return raw_atomic_load(word) * 100 + bytes + n;
}
fn writer(n: u64, word: u64) -> u64 {
    raw_atomic_store(word, 5);
    return n;
}
fn body<s>(sc: (&s Scope<u64>), word: u64) -> u64 {
    slow := spawn(sc, 1, reader);
    fast := spawn(sc, 1, writer);
    return join(slow) + join(fast);
}
fn main() {
    assert(host::write_file(view("offload-probe.txt"), view("0123456789")) == 0);
    word := rt_alloc(8);
    raw_store(word, 0);
    println(task_scope(word, body));
    rt_free(word);
}
