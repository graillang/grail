// The regression the Windows readiness work fixes: spawn, task_scope and parallel_map used to abort
// the process on Windows because the scheduler's epoll_create failed there. This program uses all
// three and is executed on Linux and, under Wine, on windows-x86_64.
use host;
fn doubled(n: u64, c: u64) -> u64 {
    return n * 2;
}
fn add_one(n: u64, c: u64) -> u64 {
    return n + 1;
}
fn body<s>(sc: (&s Scope<u64>), base: u64) -> u64 {
    first := spawn(sc, base, doubled);
    second := spawn(sc, base + 1, doubled);
    return join(first) + join(second);
}
fn main() {
    println(task_scope(10, body));
    items := u64[1, 2, 3];
    raised := parallel_map(items, 0, add_one);
    mut total = 0;
    for i in raised.len() {
        total += raised[i];
    }
    println(total);
}
