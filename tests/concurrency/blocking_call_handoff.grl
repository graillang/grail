// The documented way out of B3: rt_blocking_call hands a blocking operation to a dedicated OS thread
// and suspends the task, so no worker is lost and no warning is emitted. Same two tasks as
// blocking_call.grl: the spinner still runs while the call blocks, and the run is silent on stderr.
unsafe module runtime;
use host;
extern "C" lib "c" fn usleep(us: u32) -> i32;
fn blocking_call(us: u64, unused: u64) -> u64 {
    unsafe {
        usleep(u32(us));
    }
    return 0;
}
fn blocker(n: u64, word: u64) -> u64 {
    rt_blocking_call(blocking_call, 120000, 0);
    rt_atomic_store(word, 1);
    return n;
}
fn spinner(n: u64, word: u64) -> u64 {
    mut i = 0;
    while rt_atomic_load(word) == 0 {
        rt_atomic_fetch_add(word + 8, 1);
        i += 1;
    }
    return i;
}
fn body<s>(sc: (&s Scope<u64>), word: u64) -> u64 {
    first := spawn(sc, 1, blocker);
    second := spawn(sc, 2, spinner);
    return join(first) + join(second);
}
fn main() {
    word := rt_alloc(16);
    raw_store(word, 0);
    raw_store(word + 8, 0);
    total := task_scope(word, body);
    assert(rt_atomic_load(word + 8) > 0);
    assert(total > 2);
    rt_free(word);
    println(42);
}
