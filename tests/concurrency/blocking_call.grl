// A `blocking` foreign call does not take a worker with it. With one worker, `blocker` calls libc
// usleep for 120 ms - declared `extern "C" blocking` - and `spinner`, queued behind it on the same
// single worker, still runs while it sleeps: the worker was given to a spare thread for the call
// (rt_blocking_enter). Before stage 6 the call held the only worker and the spinner waited for it.
// The three words are plain runtime memory: word 0 = done, word 8 = spinner iterations while the
// blocker slept, word 16 = measured block time.
unsafe module runtime;
use host;
extern "C" blocking lib "c" fn usleep(us: u32) -> i32;
fn blocker(n: u64, word: u64) -> u64 {
    started := host::now_ms();
    unsafe {
        usleep(120000);
    }
    raw_store(word + 16, host::now_ms() - started);
    raw_atomic_store(word, 1);
    return n;
}
fn spinner(n: u64, word: u64) -> u64 {
    mut i = 0;
    while raw_atomic_load(word) == 0 {
        raw_atomic_fetch_add(word + 8, 1);
        i += 1;
    }
    return i;
}
fn body<s>(sc: (&s Scope<u64>), word: u64) -> u64 {
    first := spawn(sc, 1, blocker);
    second := spawn(sc, 2, spinner);
    return join(first) + join(second);
}
fn main() {
    word := rt_alloc(24);
    raw_store(word, 0);
    raw_store(word + 8, 0);
    raw_store(word + 16, 0);
    total := task_scope(word, body);
    assert(raw_atomic_load(word + 8) > 0);
    assert(raw_load(word + 16) >= 100);
    assert(total > 2);
    rt_free(word);
    println(42);
}
