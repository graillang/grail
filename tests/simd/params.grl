// A vector as a function's first parameter (frame slot 0, which simd_emit once read as "no operand"),
// passed, returned and summed.
fn id(a: f32x4) -> f32x4 {
    return a;
}
fn two(a: f32x4, b: f32x4) -> f32x4 {
    return a + b;
}
fn take(a: f32x4) -> f32 {
    return a.sum();
}
fn main() {
    x := f32x4::new(1.0, 2.0, 3.0, 4.0);
    println(take(x));
    println(id(x).sum());
    println(two(x, x).sum());
}
