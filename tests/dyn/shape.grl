// A module whose interface carries a borrowed interface object in its signatures: `&dyn Shape` and
// `&mut dyn Shape` must travel through the interface file as well as through its source.
module shape;

pub interface Shape {
    fn area(self: &Self) -> u64;
    fn grow(self: &mut Self, by: u64) -> unit;
}
pub struct Square {
    side: u64,
}
pub struct Circle {
    r: u64,
}
impl Shape for Square {
    fn area(self: &Self) -> u64 {
        return self.side * self.side;
    }
    fn grow(self: &mut Self, by: u64) -> unit {
        self.side = self.side + by;
        return ();
    }
}
impl Shape for Circle {
    fn area(self: &Self) -> u64 {
        return 3 * self.r * self.r;
    }
    fn grow(self: &mut Self, by: u64) -> unit {
        self.r = self.r + by;
        return ();
    }
}
pub fn area_of(s: &dyn Shape) -> u64 {
    return s.area();
}
pub fn grow_twice(s: &mut dyn Shape) {
    s.grow(1);
    s.grow(1);
    return ();
}
pub fn circle(r: u64) -> Circle {
    return Circle { r: r };
}
pub fn square(side: u64) -> Square {
    return Square { side: side };
}
