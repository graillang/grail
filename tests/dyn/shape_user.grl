use shape;

fn main() {
    c := shape::circle(2);
    mut q = shape::square(3);
    println("{} {}", shape::area_of(&c), shape::area_of(&q));
    shape::grow_twice(&mut q);
    println("{}", q.side);
    mut v = (&dyn shape::Shape)[];
    v.push(&c);
    v.push(&q);
    println("{}", v[0].area() + v[1].area());
}
