// Results come back in input order whatever order the jobs finish in. Job 0 sleeps longest, so a
// completion-ordered implementation would return [3, 2, 1, 0]; the correct answer is [0, 1, 2, 3].
use pool;

fn slow(x: u64) -> u64 {
    host::sleep_ms((4 - x) * 25);
    return x;
}
fn main() {
    ordered := pool::map<u64,u64>(u64[0, 1, 2, 3], slow);
    println(ordered);
}
