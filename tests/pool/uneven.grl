// Uneven work: one long job among trivial ones. Nothing may deadlock and the long job's result
// must still land in its own slot.
use pool;

fn work(x: u64) -> u64 {
    if x == 0 {
        mut total = 0;
        for i in 2000000 { total += i; }
        return total;
    }
    return x;
}
fn main() {
    results := pool::map<u64,u64>(u64[0, 1, 2, 3, 4, 5, 6, 7], work);
    println(results);
}
