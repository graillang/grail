// Declarations whose symbols used to carry a run's table index: an inherent method
// (`.inherent_<decl>`), an interface implementation (`.impl_<n>`) and an interface's own unit. A
// module compiled alone numbers its tables differently from the module that calls it, so the
// symbols have to spell the declaration instead. `pair` instantiates `twice` inside its own body, so
// the nested instantiation is emitted by whoever asked for `pair`.
module units_shapes;

pub interface Area {
    fn area<a>(value: (&a Self)) -> u64;
}

pub struct Rect {
    w: u64,
    h: u64
}

impl Rect {
    pub fn perimeter(self: &Self) -> u64 {
        return 2 * (self.w + self.h);
    }
}

impl Area for Rect {
    fn area<a>(value: (&a Self)) -> u64 {
        return value.w * value.h;
    }
}

pub fn make(w: u64, h: u64) -> Rect {
    return Rect { w: w, h: h };
}

pub fn twice<T>(value: T) -> T {
    return value;
}

pub fn pair<T>(value: T) -> T {
    return twice<T>(value);
}
