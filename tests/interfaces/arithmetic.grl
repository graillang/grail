module arithmetic;

// Inherent methods on a *written* type, with no `main`: this module can only be compiled as a
// module, and the only way an importer can call these methods is through the interface.
impl u8[] {
    pub fn first_byte(&self) -> u8 {
        return self[0];
    }
    pub fn byte_total(&self) -> u64 {
        mut total = 0;
        for b in self {
            total = total + u64(b);
        }
        return total;
    }
}

impl [u64] {
    pub fn total(&self) -> u64 {
        mut total = 0;
        for i in self.len() {
            total = total + self[i];
        }
        return total;
    }
}

// A private method travels nowhere, and a public one that a bare `impl<T> T[]` block gives a
// written type still has to name its own parameter in the interface.
impl<T> T[] {
    pub fn doubled_len(&self) -> u64 {
        return self.len() * 2;
    }
}
