// A module whose public surface is built out of a *qualified* enum from another module: a borrowed
// parameter, a record field, a return type and a generic instantiation of it. An earlier interface
// format spelled types as text and one of these signatures (`&a tls::Error`) did not survive the
// round trip, so this fixture is the case that bit us and `ifc-qualified-enum` compiles it twice.
module ifc_qual;

pub enum Error {
    Closed,
    Again
}

pub struct Attempt {
    last: Error,
    count: u64
}

// A qualified enum in a borrowed parameter, with a refinement on the neighbouring one: the type, the
// predicate and the parameter's name all travel in the same declaration.
pub fn seen<a>(e: (&a Error), n: u64 where n % 2 == 0) -> u64 {
    return n;
}

pub fn first() -> Error {
    return Error::Closed;
}

pub fn attempts() -> Attempt {
    return Attempt { last: Error::Closed, count: 0 };
}

pub fn twice<T>(value: T) -> T {
    return value;
}
