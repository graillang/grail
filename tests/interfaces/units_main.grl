// Calls each kind of declaration of another module compiled in another run: if any symbol were
// named by a table index the link would fail or call the wrong body.
use units_shapes;

pub fn main() -> u64 {
    r := units_shapes::make(3, 4);
    println(r.perimeter());
    println(units_shapes::Area::area(&r));
    println(units_shapes::pair<u64>(7));
    return 0;
}
