module fx_eff_lib;

// A claimed function in its own module: the interface records the claim (`effects 1 0 0`) and the
// importing module trusts the definition module's own proof.
@no_alloc
pub fn total(v: &u64[]) -> u64 {
    mut t = 0;
    for i in v.len() {
        t = t + v[i];
    }
    return t;
}
