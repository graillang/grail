// A module the static interface tests import: one baked static of each stage-1 kind, and a private
// one (docs/design/module-values.md). `table_user` reads them through `table.iface`, which carries
// each static's name, type and tier but no value: the storage is in this module's object.
module table;

pub static ROUNDS: u64 = 12;
pub static ENABLED: bool = true;
pub static LABEL: string = "table";
pub static SQUARES: u64[] = @squares();
static HIDDEN: u64 = 7;

fn squares() -> u64[] {
    mut v = u64[];
    for i in 6 {
        v.push(i * i);
    }
    return v;
}

pub fn hidden_plus(n: u64) -> u64 {
    return HIDDEN + n;
}
