// A dependency whose refined parameter travels in its interface: the caller owes it wherever the
// module is read from. Used by the case that builds an *entry from source* against a directory of
// dependency interfaces, where the entry has no interface of its own.
module sep_required;

// `@strict`: the refinement is proved where the call is, so a caller in another module that cannot
// prove it is refused at compile time - which is the refusal this case's build has to reach.
@strict
pub fn take(align: u64 where align % 16 == 0) -> u64 {
    return align;
}
