module ext_twice;

// An interface that gives built-in types a method (Rust's extension-trait pattern): `x.twice()`
// resolves only in a module that declares the interface or has `use ext_twice;`.
pub interface Twice {
    fn twice(&self) -> u64;
}
impl Twice for u64 {
    fn twice(&self) -> u64 {
        return *self * 2;
    }
}
impl Twice for char {
    fn twice(&self) -> u64 {
        return u64(*self) * 2;
    }
}
impl Twice for bool {
    fn twice(&self) -> u64 {
        if *self {
            return 2;
        }
        return 0;
    }
}
impl Twice for (u64, u64) {
    fn twice(&self) -> u64 {
        return (self.0 + self.1) * 2;
    }
}
// A module that uses ext_twice, and so may call the method.
pub fn doubled(x: u64) -> u64 {
    return x.twice();
}
