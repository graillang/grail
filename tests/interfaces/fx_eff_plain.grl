module fx_eff_plain;  // fuzz: refused

pub fn size() -> u64 {
    return 1;
}

// No claim: the interface records no `effects` row for this function, so an importer that calls it
// from an `@no_alloc` function cannot trust it and is refused.
pub fn grow(v: &mut u64[]) -> unit {
    v.push(1);
    return ();
}
