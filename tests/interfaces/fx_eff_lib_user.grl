module main;
use fx_eff_lib;

// The claim lives in the definition module and travels in its interface: this caller is accepted
// because the interface records the proof, not because it re-derives it.
@no_alloc
fn mine(v: &u64[]) -> u64 {
    return fx_eff_lib::total(v);
}

fn main() -> u64 {
    v := u64[1, 2, 3];
    println("{}", mine(&v));
    return 0;
}
