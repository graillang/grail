// Emits `strictgen.iface` for the strict-generic case without instantiating the template: a reject
// case's own entry is the thing the rejection is about, so the interface comes from here. It declares
// its own module so the emit run does not write a `main.iface` for a different source.
module strictgen_idle;

use strictgen;

pub fn main() -> u64 {
    return 0;
}
