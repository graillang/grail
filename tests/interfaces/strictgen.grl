// A module whose generic carries `@strict`: the mode travels in the interface row, so a build that
// instantiates the template compiles its body the way this module asked for.
module strictgen;

pub fn take(align: u64 where align % 16 == 0) -> u64 {
    return align;
}

@strict
pub fn pick<T>(x: T) -> u64 {
    return take(seventeen());
}
fn seventeen() -> u64 {
    return 17;
}
