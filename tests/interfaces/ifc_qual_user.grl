// Compiled twice by `tests/native-cases.json`: against `ifc_qual.grl`, and against its interface
// alone. Every reference below names a qualified enum through another module's surface.
use ifc_qual;

pub fn main() -> u64 {
    e := ifc_qual::first();
    println(ifc_qual::seen(&e, 4));
    a := ifc_qual::attempts();
    println(a.count);
    println(ifc_qual::twice<u64>(41));
    e2 := ifc_qual::twice<ifc_qual::Error>(e);
    println(ifc_qual::seen(&e2, 6));
    return 0;
}
