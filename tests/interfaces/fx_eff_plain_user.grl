module main;  // fuzz: refused
use fx_eff_plain;

// `grow` allocates and claims nothing, so this caller's claim cannot be proved - from source or from
// the interface, which carries no `effects` row for it.
@no_alloc
fn mine(v: &mut u64[]) -> unit {
    fx_eff_plain::grow(v);
    return ();
}

fn main() -> u64 {
    mut v = u64[];
    mine(&mut v);
    println("{}", v.len());
    return 0;
}
