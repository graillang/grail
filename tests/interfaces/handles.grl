// Capability metadata across an instantiation: `File` is audited shareable and `Lock` is not, and
// `fan` only compiles because its parameter is bounded by `Share`. A caller that instantiates it on
// `Lock` must be refused by name - the bound and both classifications travel in the interface.
module handles;

pub handle File: transferable, shareable;
pub handle Lock: transferable;

pub fn make_file() -> File {
    mut h: File;
    return h;
}

pub fn make_lock() -> Lock {
    mut h: Lock;
    return h;
}

pub fn fan<T: Share>(value: T, items: u64[]) -> u64 {
    r := parallel_map(items, &value, pick<T>);
    return u64(r.len());
}

pub fn pick<T>(x: u64, c: (&T)) -> u64 {
    return x;
}
