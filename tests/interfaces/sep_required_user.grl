// The entry of the "an entry needs no interface of its own" case: compiled from source, against
// `sep_required.iface` alone. The call below cannot prove the refinement, so the build refuses it -
// and it must reach that refusal rather than "has no interface for module `main`".
use sep_required;

// `@strict` here: the caller is where the refinement is owed, so an argument that cannot be proved
// is a compile error rather than a runtime check.
@strict
pub fn main() -> u64 {
    println(sep_required::take(17));
    return 0;
}
