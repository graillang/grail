// The emit run of the case above: it writes `sep_required.iface` and its own `sep_idle.iface`, and
// writes nothing for the entry - which is the point. It declares a module of its own so the emit run
// does not write a `main.iface` for a source that is not the entry.
module sep_idle;

use sep_required;

pub fn main() -> u64 {
    return 0;
}
