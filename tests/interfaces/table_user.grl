// Compiled twice by `tests/native-cases.json`: against `table.grl`, and against `table.iface`.
use table;

fn total(v: &u64[]) -> u64 {
    mut t = 0;
    for i in v.len() {
        t += v[i];
    }
    return t;
}

pub fn main() -> u64 {
    println(table::ROUNDS);
    println(table::ENABLED);
    println(table::LABEL);
    println(total(table::SQUARES));
    println(table::SQUARES[5]);
    println(table::hidden_plus(1));
    return 0;
}
