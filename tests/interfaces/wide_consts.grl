module wide_consts;

// Constants whose interface record needs all ten bytes of a LEB128 number: bit 63 set.
pub const U64_MAX: u64 = 18446744073709551615;
pub const TWO_63: u64 = 9223372036854775808;
pub const FNV_OFFSET: u64 = 14695981039346656037;
pub const I64_MIN: i64 = -9223372036854775808;
pub const MINUS_ONE: i64 = -1;
