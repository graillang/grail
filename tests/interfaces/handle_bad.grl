// `Lock` is transferable but not shareable: instantiating `handles::fan` on it would put a
// thread-affine handle into a parallel context, so the bound refuses it by name.
use handles;

pub fn main() -> u64 {
    lock := handles::make_lock();
    println(handles::fan<handles::Lock>(lock, u64[1, 2, 3, 4]));
    return 0;
}
