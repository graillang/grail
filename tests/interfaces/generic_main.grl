// The entry module of the stage-3 proof: it instantiates the same generic a third time and calls
// both importers, so the linked program only behaves if the one emitted body is the right one.
use generic;
use generic_a;
use generic_b;

pub fn main() -> u64 {
    println(generic::twice<u64>(1) + generic_a::a_value() + generic_b::b_value());
    return 0;
}
