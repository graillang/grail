// A module the interface tests import: a record with an inherent method, an enum, a type alias, a
// constant and functions with borrowed parameters. Its interface is read by `pair_user`, which must
// be checked exactly as if it had the source.
module pair;

pub struct Pair {
    left: u64,
    right: u64
}

pub enum Which {
    First,
    Second(u64)
}

pub type Row = Pair;

pub const SCALE: u64 = 3;

impl Pair {
    pub fn sum<a>(self: (&a Pair)) -> u64 {
        return self.left + self.right;
    }
}

pub fn make(left: u64, right: u64) -> Pair {
    return Pair { left: left, right: right };
}

pub fn flatten(which: Which) -> u64 {
    match which {
        First => {
            return 0;
        },
        Second(value) => {
            return value;
        }
    }
}
