// Compiled twice by `tests/native-cases.json`: against `refined.grl`, and against `refined.iface`.
// `take`'s refinement is carried by the interface, and the argument's own constant discharges it.
use refined;

pub fn main() -> u64 {
    println(refined::take(16));
    n := 32;
    println(refined::take(n));
    return 0;
}
