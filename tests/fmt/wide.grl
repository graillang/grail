// Expressions wide enough that the formatter must wrap them at a binary operator - comparisons,
// `&&` `||`, arithmetic, `<<` `>>` and a range bound. Its output has to parse again: a line break
// may not split `<<` or `>>` (each is two tokens) or start a line with `<` or `>`, which reads as
// generic brackets.
fn wide(alpha_value: u64, beta_value: u64, gamma_value: u64, delta_value: u64) -> bool {
    return (alpha_value < beta_value) && (beta_value < gamma_value) && (gamma_value < delta_value) && (alpha_value > 1);
}
fn wider(alpha_value: u64, beta_value: u64, gamma_value: u64, delta_value: u64) -> u64 {
    if alpha_value + beta_value * gamma_value - delta_value / alpha_value < beta_value + gamma_value + delta_value + alpha_value * 2 {
        return 1;
    }
    if alpha_value * beta_value + gamma_value * delta_value + alpha_value * gamma_value > beta_value * delta_value + 77 {
        return 2;
    }
    if (alpha_value <= beta_value) || (beta_value >= gamma_value) || (gamma_value <= delta_value) || (alpha_value >= 9) {
        return 3;
    }
    return alpha_value + beta_value + gamma_value + delta_value + alpha_value * beta_value + gamma_value * delta_value;
}
// A shift is two tokens (`<` `<`): the line must never break between them, nor start with either.
fn packed(delta: u64) -> u64 {
    return ((delta >> 12) & 1) << 31 | ((delta >> 5) & 0x3f) << 25 | ((delta >> 1) & 0xf) << 8 | ((delta >> 11) & 1) << 7;
}
// `>>` is two tokens too, and `..` must stay whole when a range bound wraps.
fn unpacked(word: u64, alpha_value: u64, beta_value: u64) -> u64 {
    mut total = 0;
    for i in 0..alpha_value + beta_value * alpha_value + beta_value * beta_value + alpha_value * alpha_value + beta_value {
        total = total + i;
    }
    return total + ((word >> 31) & 1) | ((word >> 25) & 0x3f) << 5 | ((word >> 8) & 0xf) << 1 | ((word >> 7) & 1) << 11;
}
fn main() {
    println("{} {} {} {}", wide(1, 2, 3, 4), wider(1, 2, 3, 4), packed(4096), unpacked(4096, 2, 3));
}
