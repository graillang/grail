module messy;
// Leading comment survives.
pub struct Pair<T> {
    first: T,
    second: T
}
enum Shape {
    Circle(num),
    Square(num),
    Empty
}
interface Area {
    fn area<a>(shape: ref<a, Self>) -> num;
}
impl Area for Shape {
    fn area<a>(shape: ref<a, Self>) -> num {
        match load(shape) {
            Circle(r) => {
                return 3 * r * r;
            },
            Square(s) => {
                return s * s;
            },
            Empty => {
                return 0;
            }
        }
    }
}

fn generic<a, T: Send>(value: ref<a, vec<T>>, count: num) -> num {
    return value.len() + count;
} // trailing comment
fn main() {
    p := Pair { first: 1, second: 2 };
    mut total = -p.first + p.second * 2;
    v := vec<num>[1, 2, 3];
    total += generic(&v, 4);
    if total > 10 {
        println(total);
    } else {
        if total < 0 {
            println(0);
        } else {
            println(total);
        }
    }
    // A call that does not fit on one line is broken with one argument per line:
    result := some_function_with_a_long_name(
        first_argument_value,
        second_argument_value,
        third_argument_value
    );
    while total != 0 {
        total -= 1;
    }
}
