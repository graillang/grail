module messy;
// Leading comment survives.
pub struct Pair<T> {
    first: T,
    second: T
}
enum Shape {
    Circle(u64),
    Square(u64),
    Empty
}
interface Area {
    fn area<a>(shape: (&a Self)) -> u64;
}
impl Area for Shape {
    fn area<a>(shape: (&a Self)) -> u64 {
        match *shape {
            Circle(r) => {
                return 3 * r * r;
            },
            Square(s) => {
                return s * s;
            },
            Empty => {
                return 0;
            }
        }
    }
}

fn generic<a, T: Send>(value: (&a T[]), count: u64) -> u64 {
    value.len() + count
} // trailing comment
fn main() {
    p := Pair { first: 1, second: 2 };
    mut total = -p.first + p.second * 2;
    v := u64[1, 2, 3];
    total += generic(&v, 4);
    if total > 10 {
        println(total);
    } else {
        if total < 0 {
            println(0);
        } else {
            println(total);
        }
    }
    // A call that does not fit on one line is broken with one argument per line:
    result := some_function_with_a_long_name(
        first_argument_value,
        second_argument_value,
        third_argument_value
    );
    while total != 0 {
        total -= 1;
    }
}
struct Config {
    name: u8[],
    host: u8[],
    port: u64,
    timeout: u64,
    retries: u64,
    verbose: u64
}
enum Request {
    Ready,
    Failed(u64)
}
// Long calls, chains, operator chains, record literals and match arms are broken for reading.
fn dispatch(shape: Shape, options: Config, headers: Config, attempts: u64) -> u64 {
    request := build_request_from_configuration(options, headers, attempts)
        .with_timeout(30)
        .with_retries(3)
        .parse_body_as_json();
    admitted := first_long_condition(options, headers)
        && second_long_condition(options, headers)
        && third_long_condition(options);
    match *shape {
        VeryLongVariantName(first_payload, second_payload) =>
            some_really_long_function_call(first_payload, second_payload),
        _ => 0
    }
    configuration := Config {
        name: u8[],
        host: u8[],
        port: 8080,
        timeout: 30,
        retries: 3,
        verbose: 1,
    };
    register_handler(
        some_rather_long_argument_name,
        another_rather_long_argument_name,
        and_a_third_long_argument
    );
    for day in 1..4 {
        println(day);
    }
    request
}

// A shift inside parentheses after `<` is not a generic argument list.
fn halve(n: u64) -> u64 {
    mut i = 0;
    while i < (n >> 1) {
        i += 1;
    }
    i
}
// Tail expressions: a body's final `return x;` becomes `x`; early returns, `return ();` and a
// returned `if` stay; a brace holding statements is laid out as a block wherever it is.
fn tails(n: u64) -> u64 {
    if n > 9 {
        return 9;
    }
    f := |a: u64| -> u64 {
        b := a + 1;
        b
    };
    k := if n > 2 {
        t := n / 2;
        t + 1
    } else {
        0
    };
    f(k)
}
fn tail_if(n: u64) -> u64 {
    return if n > 1 { 1 } else { 2 };
}
fn tail_unit() {
    println("done");
    return ();
}
