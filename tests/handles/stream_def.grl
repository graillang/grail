// An opaque C handle declared in one module, for the cross-module case: `stream_user` names
// `stream_def::Stream` in its own signatures and fields.
module stream_def;

handle Stream;

extern "C" lib "c" fn fopen(path: CStr, mode: CStr) -> Stream;
extern "C" lib "c" fn fclose(stream: Stream) -> i32;
extern "C" lib "c" fn fileno(stream: Stream) -> i32;
