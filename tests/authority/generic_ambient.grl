// The same generic body without an opt-in is still an ambient host reference, even when the
// module that instantiates it declares `use host;`.
fn read_len<T>(path: &[u8], value: T) -> u64 {
    data := host::read_file(path);
    return data.len();
}
fn main() {
    println(read_len("note.txt", 1));
}
