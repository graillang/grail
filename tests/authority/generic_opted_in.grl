// A generic body is compiled on its own, after every module has been read, so the switch must
// remember this module's opt-in rather than use the last module parsed.
use host;

fn read_len<T>(path: &[u8], value: T) -> u64 {
    data := host::read_file(path);
    return data.len();
}
fn main() {
    println(read_len("note.txt", 1));
}
