use zlib;
use fs;
use io;

// Inflates every stream in tests/lib/zlib (generated by CPython's zlib at every level and
// strategy, plus a raw DEFLATE stream) and compares the bytes; `reject` streams must fail.
// argv: the corpus directory. Returns the number of failures.

fn read_corpus<a>(path: &a [u8]) -> u8[] {
    match fs::read(path) {
        d: u8[] => { return d; },
        e: fs::Error => { println("cannot read a corpus file"); return u8[]; }
    }
}
fn same<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn child_path<a, b>(dir: &a [u8], name: &b [u8]) -> u8[] {
    mut out = dir.copy();
    out.push(47);
    for i in name.len() {
        out.push(name[i]);
    }
    return out;
}

fn with_suffix<a, b, c>(dir: &a [u8], name: &b [u8], suffix: &c [u8]) -> u8[] {
    mut out = child_path(dir, name);
    for i in suffix.len() {
        out.push(suffix[i]);
    }
    return out;
}

fn main(dir: &[u8]) -> u64 {
    base := dir.copy();
    manifest := read_corpus(&child_path(&base, "manifest.txt"));
    mut failures: u64 = 0;
    mut cases: u64 = 0;
    mut start: u64 = 0;
    for i in manifest.len() {
        if manifest[i] != 10 {
            continue;
        }
        mut space = start;
        while manifest[space] != 32 {
            space += 1;
        }
        kind := manifest[start: space].copy();
        name := manifest[space + 1: i].copy();
        start = i + 1;
        input := with_suffix(&base, &name, ".in");
        output := with_suffix(&base, &name, ".out");
        data := read_corpus(&input);
        want := read_corpus(&output);
        mut got: u8[]? = None;
        if same(&kind, "raw") {
            got = zlib::inflate_raw(&data);
        } else {
            got = zlib::inflate(&data);
        }
        cases += 1;
        if same(&kind, "reject") {
            if got.is_some() {
                println("FAIL {} was accepted", name.text());
                failures += 1;
            }
            continue;
        }
        match got {
            Some(bytes) => {
                if same(&bytes, &want) == false {
                    println("FAIL {} ({} bytes, want {})", name.text(), bytes.len(), want.len());
                    failures += 1;
                }
            },
            None => {
                println("FAIL {} rejected", name.text());
                failures += 1;
            }
        }
    }
    println("{} cases, {} failures", cases, failures);
    return failures;
}
