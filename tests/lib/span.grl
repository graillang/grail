// A span is a range that carries the slice it was made from (docs/design/range-values.md): the
// bytes it names come out of that slice, so a range its slice does not have is refused where the
// span is made and nothing here has to re-check an end against a length.
use span;

fn equals<b, c>(r: &b span::Span<c>, w: &b [u8]) -> bool {
    return r.same_as(w);
}

fn main() {
    mut checks = 0;
    stored := u8[1, 2, 3, 4];
    name := u8[2, 3];
    r := span::span_of(&stored, 1, 3);
    // A range inside its slice: length, comparison and the bytes it names.
    assert(r.len() == 2);
    checks += 1;
    assert(r.same_as(&name));
    checks += 1;
    assert(!r.same_as(&u8[2]));
    checks += 1;
    assert(r.bytes().len() == 2);
    checks += 1;
    assert(r.bytes() == &stored[1..3]);
    checks += 1;
    // The same span through a helper: the range travels as one value, so the helper cannot be
    // handed a second, unrelated end.
    assert(equals(&r, &name));
    checks += 1;
    assert(!equals(&r, &u8[2, 9, 9]));
    checks += 1;
    // A range the slice does not have is refused when the span is made: it names no bytes, so it
    // compares unequal and reports no length.
    over := span::span_of(&stored, 2, 9);
    assert(over.len() == 0);
    checks += 1;
    assert(!over.same_as(&u8[3, 4, 5]));
    checks += 1;
    backwards := span::span_of(&stored, 3, 1);
    assert(backwards.len() == 0);
    checks += 1;
    // The ends are free inside the slice: the whole slice, an empty span at the end, and adjacent
    // spans that partition it.
    all := span::span_of(&stored, 0, 4);
    assert(all.len() == 4);
    checks += 1;
    assert(all.bytes() == &stored);
    checks += 1;
    empty := span::span_of(&stored, 2, 2);
    assert(empty.len() == 0);
    checks += 1;
    left := span::span_of(&stored, 0, 2);
    right := span::span_of(&stored, 2, 4);
    assert(left.len() + right.len() == all.len());
    checks += 1;
    assert(left.bytes()[1] == 2);
    checks += 1;
    assert(right.bytes()[0] == 3);
    checks += 1;
    // A text is a byte view too, and a byte view of a view keeps the same spelling.
    text := "hello";
    word := span::span_of(&text, 1, 4);
    assert(word.bytes() == &text[1..4]);
    checks += 1;
    assert(word.same_as(&"ell"));
    checks += 1;
    inner := span::span_of(&text, 0, 5);
    assert(inner.len() == 5);
    checks += 1;
    println("span ok: {} checks", checks);
}
