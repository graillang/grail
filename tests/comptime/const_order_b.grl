// A module constant read from a module later on the command line (tests/native-cases.json:
// const-cross-module-later-file).
module const_order_b;
const doubled: u64 = const_order_a::base * 2;
const limit: f32 = const_order_a::pitch;
pub fn get() -> u64 { return doubled; }
pub fn pitch() -> f32 { return limit; }
