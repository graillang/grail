// A program the size of a compiler module set fails a check deep in it; the report names the
// failing statement and its callers (the failure report block is mapped, not part of rt_state).
use bulk0;
use bulk1;
use bulk2;
use bulk3;
use bulk4;
use bulk5;
use bulk6;
use bulk7;

pub fn main() -> u64 {
    mut t = 0;
    t += bulk0::f0(t);
    t += bulk1::f1(t);
    t += bulk2::f2(t);
    t += bulk3::f3(t);
    t += bulk4::f4(t);
    t += bulk5::f5(t);
    t += bulk6::f6(t);
    t += bulk7::f7(t);
    v := u64[1, 2, 3];
    println(bulk7::pick(&v, t + 7));
    return 0;
}
