extern "C" record Pt { x: i32, y: i32, w: f32 }
struct Inner {
    id: u64,
    tag: string
}
struct Outer {
    count: u64,
    ratio: f64,
    inner: Inner,
    label: string
}
fn show(o: &Outer, p: &Pt, v: &u64[], s: &string) -> u64 {
    total := o.count + v.len() + s.len();
    return total;
}
fn main() -> u64 {
    o := Outer { count: 7, ratio: 2.5, inner: Inner { id: 42, tag: "inner-tag" }, label: "outer-label" };
    p := Pt { x: -3, y: 9, w: 1.5 };
    v := u64[10, 20, 30];
    s := "hello debugger";
    println(show(&o, &p, &v, &s));
    return 0;
}
