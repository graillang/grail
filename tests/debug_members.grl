extern "C" record Pt { x: i32, y: i32, w: f32 }
struct Inner {
    id: u64,
    tag: string
}
struct Pos {
    row: u64,
    col: i64
}
struct Outer {
    count: u64,
    ratio: f64,
    inner: Inner,
    pos: Pos,
    label: string
}
fn show(o: &Outer, p: &Pt, v: &u64[], s: &string, q: &Pos, ps: &Pos[]) -> u64 {
    total := o.count + v.len() + s.len() + q.row + ps.len();
    return total;
}
fn main() -> u64 {
    o := Outer { count: 7, ratio: 2.5, inner: Inner { id: 42, tag: "inner-tag" }, pos: Pos { row: 3, col: -4 }, label: "outer-label" };
    p := Pt { x: -3, y: 9, w: 1.5 };
    v := u64[10, 20, 30];
    s := "hello debugger";
    q := Pos { row: 11, col: -12 };
    ps := Pos[Pos { row: 21, col: -22 }, Pos { row: 31, col: -32 }];
    println(show(&o, &p, &v, &s, &q, &ps));
    return 0;
}
