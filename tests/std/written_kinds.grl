// Standard-library impls (this directory holds core.grl, so this file is a standard module) on every
// kind of built-in receiver: an integer, `bool`, `char`, a raw pointer, `T?`, a tuple and `Mutex<T>`.
impl i16 {
    pub fn fx_halved(self) -> i16 {
        return self / 2;
    }
}
impl bool {
    pub fn fx_bit(self) -> u64 {
        if self {
            return 1;
        }
        return 0;
    }
}
impl char {
    pub fn fx_code(self) -> u64 {
        return u64(self);
    }
}
impl<T> * mut T {
    pub fn fx_word(self) -> u64 {
        return unsafe { self.addr() } % 8;
    }
}
impl<T> T? {
    pub fn fx_count(&self) -> u64 {
        if self.is_some() {
            return 1;
        }
        return 0;
    }
}
impl(u64, u64) {
    pub fn fx_sum(self) -> u64 {
        return self.0 + self.1;
    }
}
impl<T> Mutex<T> {
    pub fn fx_tag(&self) -> u64 {
        return 7;
    }
}
// An associated function of a scalar is called through the type, as `f64::from_bits(b)` is.
impl f64 {
    pub fn fx_unit() -> f64 {
        return 1.0;
    }
}
fn main() {
    h: i16 = -9;
    println(h.fx_halved());
    println(true.fx_bit());
    c: char = 'A';
    println(c.fx_code());
    println('B'.fx_code());
    mut v = u64[1, 2];
    p := unsafe { ptr_of(&mut v) };
    println(p.fx_word());
    some: u64? = Some(3);
    none: u64? = None;
    println(some.fx_count() + none.fx_count());
    println((4, 5).fx_sum());
    m := Mutex::new(9);
    println(m.fx_tag());
    println(f64::fx_unit());
    // The built-in names still answer on the same receivers.
    println(c.is_alphabetic());
    println(some.unwrap_or(0));
}
