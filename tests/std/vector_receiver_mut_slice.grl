// A standard-library fixture (see core.grl here): only the standard library may write an inherent
// impl for a built-in type, which is what this case exercises (postfix-lib-vector-receiver-mut-slice-needs-mut-binding).
impl [u64] {
    fn bump_first(&mut self) {
        self[0] = self[0] + 1;
    }
}
fn main() {
    v := u64[4, 5];
    v.bump_first();
}
