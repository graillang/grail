// A standard-library fixture (see core.grl here): only the standard library may write an inherent
// impl for a built-in type, which is what this case exercises (postfix-lib-vector-receiver-reaches-slice-impl).
impl<T> [T] {
    fn halves(&self) -> u64 {
        return self.len() / 2;
    }
}
impl [u64] {
    fn bump_first(&mut self) {
        self[0] = self[0] + 1;
    }
}
fn main() {
    mut v = u64[4, 5, 6, 7];
    println(v.halves());
    v.bump_first();
    println(v[0]);
    s := &v[1..3];
    println(s.halves());
}
