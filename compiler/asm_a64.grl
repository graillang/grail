module asm_a64;
use asm_x86;

// The AArch64 half of the internal assembler (docs/design/compile-speed.md, stage 4): the
// instructions machine.grl's AArch64 lowering writes, encoded as LLVM's MC layer encodes them.
// Every instruction is one 32-bit word, so nothing is relaxed; a field that names a label is a
// fixup (asm_x86 holds them, `resolve` below fills them in or turns them into relocations).
// The reader, sections, symbols and the ELF writer are asm_x86's; it calls `instruction` for a
// line on this target.

// Fixup kinds, past asm_x86's.
pub fn fx_call26() -> u64 {
    return 20;
}
pub fn fx_jump26() -> u64 {
    return 21;
}
pub fn fx_cond19() -> u64 {
    return 22;
}
pub fn fx_adrp() -> u64 {
    return 23;
}
pub fn fx_lo12() -> u64 {
    return 24;
}
pub fn fx_tprel_hi12() -> u64 {
    return 25;
}
pub fn fx_tprel_lo12() -> u64 {
    return 26;
}
pub fn fx_adr21() -> u64 {
    return 27;
}

// A register at the cursor: its number (31 for sp and the zero register) plus 32 times its class
// (1 w, 2 x, 3 sp, 4 d, 5 s); 0 when there is none.
fn reg<a>(o: (&a mut asm_x86::A)) -> u64 {
    asm_x86::skip(&mut o);
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    n := e - a0;
    if n < 2 {
        return 0;
    }
    c := o.src[a0];
    if (n == 2) && (c == 's') && (o.src[a0 + 1] == 'p') {
        o.at = e;
        return 31 + 32 * 3;
    }
    if (n == 3) && (o.src[a0 + 1] == 'z') && (o.src[a0 + 2] == 'r') {
        if c == 'x' {
            o.at = e;
            return 31 + 32 * 2;
        }
        if c == 'w' {
            o.at = e;
            return 31 + 32 * 1;
        }
        return 0;
    }
    mut cls = 0;
    if c == 'w' {
        cls = 1;
    } else if c == 'x' {
        cls = 2;
    } else if c == 'd' {
        cls = 4;
    } else if c == 's' {
        cls = 5;
    } else {
        return 0;
    }
    mut v = 0;
    for i in n - 1 {
        d := o.src[a0 + 1 + i];
        if (d < '0') || (d > '9') {
            return 0;
        }
        v = v * 10 + d - '0';
    }
    if v > 31 {
        return 0;
    }
    o.at = e;
    return v + 32 * cls;
}

fn need_reg<a>(o: (&a mut asm_x86::A)) -> u64 {
    r := reg(&mut o);
    if r == 0 {
        asm_x86::fail(&mut o, view("expected a register"));
    }
    return r;
}

fn comma<a>(o: (&a mut asm_x86::A)) {
    asm_x86::expect(&mut o, ',');
}

fn rn(r: u64) -> u64 {
    return r & 31;
}

// 1 when the register is a 64-bit one (x or sp), the `sf` bit.
fn sf(r: u64) -> u64 {
    k := r >> 5;
    if (k == 2) || (k == 3) {
        return 1;
    }
    return 0;
}

fn word<a>(o: (&a mut asm_x86::A), w: u64) {
    asm_x86::emit_le(&mut o, w & 0xffffffff, 4);
}

// A constant expression: numbers, `.set` symbols, unary minus and + - & | << >> with parentheses,
// C's precedence. Every symbol must already be a constant.
fn primary<a>(o: (&a mut asm_x86::A)) -> u64 {
    asm_x86::skip(&mut o);
    c := asm_x86::peek(&o);
    if c == '(' {
        o.at += 1;
        v := expr_or(&mut o);
        asm_x86::expect(&mut o, ')');
        return v;
    }
    if c == '-' {
        o.at += 1;
        return wrapping_sub(0, primary(&mut o));
    }
    if c == '~' {
        o.at += 1;
        return primary(&mut o) ^ 0xffffffffffffffff;
    }
    if (c >= '0') && (c <= '9') {
        return asm_x86::number(&mut o);
    }
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    if e == a0 {
        asm_x86::fail(&mut o, view("expected a constant"));
        return 0;
    }
    sym := asm_x86::symbol(&mut o, a0, e);
    o.at = e;
    if o.sym_sec[sym] != asm_x86::abs_section() {
        asm_x86::fail(&mut o, view("a symbol in a constant that no `.set` gave a value yet"));
        return 0;
    }
    return o.sym_pos[sym];
}

fn expr_mul<a>(o: (&a mut asm_x86::A)) -> u64 {
    mut v = primary(&mut o);
    loop {
        asm_x86::skip(&mut o);
        c := asm_x86::peek(&o);
        if c == '*' {
            o.at += 1;
            v = wrapping_mul(v, primary(&mut o));
        } else if (c == '/') || (c == '%') {
            o.at += 1;
            d := primary(&mut o);
            if d == 0 {
                asm_x86::fail(&mut o, view("division by zero in a constant"));
                return 0;
            }
            // Signed, as the assembler's expressions are.
            neg_v := (v >> 63) != 0;
            neg_d := (d >> 63) != 0;
            mut a = v;
            if neg_v {
                a = wrapping_sub(0, v);
            }
            mut b = d;
            if neg_d {
                b = wrapping_sub(0, d);
            }
            if c == '/' {
                v = a / b;
                if neg_v != neg_d {
                    v = wrapping_sub(0, v);
                }
            } else {
                v = a % b;
                if neg_v {
                    v = wrapping_sub(0, v);
                }
            }
        } else {
            return v;
        }
    }
}

fn expr_add<a>(o: (&a mut asm_x86::A)) -> u64 {
    mut v = expr_mul(&mut o);
    loop {
        asm_x86::skip(&mut o);
        c := asm_x86::peek(&o);
        if c == '+' {
            o.at += 1;
            v = wrapping_add(v, expr_mul(&mut o));
        } else if c == '-' {
            o.at += 1;
            v = wrapping_sub(v, expr_mul(&mut o));
        } else {
            return v;
        }
    }
}

fn expr_shift<a>(o: (&a mut asm_x86::A)) -> u64 {
    mut v = expr_add(&mut o);
    loop {
        asm_x86::skip(&mut o);
        c := asm_x86::peek(&o);
        if (c == '>') && (asm_x86::peek1(&o) == '>') {
            o.at += 2;
            s := expr_add(&mut o);
            if s < 64 {
                v = v >> s;
            } else {
                v = 0;
            }
        } else if (c == '<') && (asm_x86::peek1(&o) == '<') {
            o.at += 2;
            s := expr_add(&mut o);
            if s < 64 {
                v = v << s;
            } else {
                v = 0;
            }
        } else {
            return v;
        }
    }
}

fn expr_and<a>(o: (&a mut asm_x86::A)) -> u64 {
    mut v = expr_shift(&mut o);
    loop {
        asm_x86::skip(&mut o);
        if asm_x86::peek(&o) == '&' {
            o.at += 1;
            v = v & expr_shift(&mut o);
        } else {
            return v;
        }
    }
}

fn expr_or<a>(o: (&a mut asm_x86::A)) -> u64 {
    mut v = expr_and(&mut o);
    loop {
        asm_x86::skip(&mut o);
        if asm_x86::peek(&o) == '|' {
            o.at += 1;
            v = v | expr_and(&mut o);
        } else {
            return v;
        }
    }
}

// `#expr` (the `#` optional).
fn imm<a>(o: (&a mut asm_x86::A)) -> u64 {
    asm_x86::skip(&mut o);
    if asm_x86::peek(&o) == '#' {
        o.at += 1;
    }
    return expr_or(&mut o);
}

// `, lsl #n` after an operand, or 0.
fn opt_lsl<a>(o: (&a mut asm_x86::A)) -> u64 {
    asm_x86::skip(&mut o);
    if asm_x86::peek(&o) != ',' {
        return 0;
    }
    o.at += 1;
    asm_x86::skip(&mut o);
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    if !asm_x86::at_src(&o, a0, e, view("lsl")) {
        asm_x86::fail(&mut o, view("expected `lsl`"));
        return 0;
    }
    o.at = e;
    return imm(&mut o);
}

// A condition code name at the cursor (after `b.` or as cset's operand).
fn cond<a>(o: (&a mut asm_x86::A), a0: u64, e: u64) -> u64 {
    names := u8[][view("eq").copy(), view("ne").copy(), view("hs").copy(), view("lo").copy(), view("mi").copy(), view("pl").copy(), view("vs").copy(), view("vc").copy(), view("hi").copy(), view("ls").copy(), view("ge").copy(), view("lt").copy(), view("gt").copy(), view("le").copy(), view("al").copy()];
    for i in names.len() {
        if asm_x86::at_src(&o, a0, e, view(names[i])) {
            return i;
        }
    }
    if asm_x86::at_src(&o, a0, e, view("cs")) {
        return 2;
    }
    if asm_x86::at_src(&o, a0, e, view("cc")) {
        return 3;
    }
    asm_x86::fail(&mut o, view("unknown condition"));
    return 0;
}

// A label operand: a fixup of `kind` at the instruction about to be emitted. `1f`/`1b` name the
// next / previous numeric label 1.
fn label_ref<a>(o: (&a mut asm_x86::A), kind: u64) {
    asm_x86::skip(&mut o);
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    if e == a0 {
        asm_x86::fail(&mut o, view("expected a label"));
        return ();
    }
    mut sym = 0;
    last := o.src[e - 1];
    if (e - a0 >= 2) && asm_x86::all_digits(&o, a0, e - 1) && ((last == 'f') || (last == 'b')) {
        sym = asm_x86::numeric_ref(&mut o, a0, e - 1, last == 'f');
    } else {
        sym = asm_x86::symbol(&mut o, a0, e);
    }
    o.at = e;
    mut add = 0;
    asm_x86::skip(&mut o);
    if (asm_x86::peek(&o) == '+') || (asm_x86::peek(&o) == '-') {
        neg := asm_x86::peek(&o) == '-';
        o.at += 1;
        n := asm_x86::number(&mut o);
        if neg {
            add = wrapping_sub(0, n);
        } else {
            add = n;
        }
    }
    asm_x86::fixup(&mut o, sym, kind, add);
}

// `:lo12:sym` / `#:tprel_hi12:sym` style operands.
fn modified<a>(o: (&a mut asm_x86::A)) -> u64 {
    asm_x86::skip(&mut o);
    if asm_x86::peek(&o) == '#' {
        o.at += 1;
    }
    asm_x86::expect(&mut o, ':');
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    o.at = e;
    asm_x86::expect(&mut o, ':');
    if asm_x86::at_src(&o, a0, e, view("lo12")) {
        return fx_lo12();
    }
    if asm_x86::at_src(&o, a0, e, view("tprel_hi12")) {
        return fx_tprel_hi12();
    }
    if asm_x86::at_src(&o, a0, e, view("tprel_lo12_nc")) {
        return fx_tprel_lo12();
    }
    asm_x86::fail(&mut o, view("unsupported relocation modifier"));
    return 0;
}

// The bitmask immediate encoding (N:immr:imms) of v for a `size`-bit operation, or a value with
// bit 63 set when v has none.
fn bitmask(v0: u64, size: u64) -> u64 {
    mut v = v0;
    if size == 32 {
        v = v & 0xffffffff;
        v = v | (v << 32);
    }
    if (v == 0) || (v == 0xffffffffffffffff) {
        return 1 << 63;
    }
    // The smallest repeating element.
    mut e: u64 = 64;
    while e > 2 {
        half := e / 2;
        mask := (1 << half) - 1;
        if (v & mask) != ((v >> half) & mask) {
            break;
        }
        e = half;
    }
    mut emask: u64 = 0xffffffffffffffff;
    if e < 64 {
        emask = (1 << e) - 1;
    }
    elem := v & emask;
    // Rotate so the element is ones followed by zeros at the bottom: count the ones, find the
    // rotation that makes it 0..01..1.
    mut ones = 0;
    for i in e {
        if ((elem >> i) & 1) != 0 {
            ones += 1;
        }
    }
    target := (1 << ones) - 1;
    mut r = 0;
    while r < e {
        // Rotate elem right by r within e bits.
        mut rot = elem;
        if r != 0 {
            rot = ((elem >> r) | (elem << (e - r))) & emask;
        }
        if rot == target {
            break;
        }
        r += 1;
    }
    if r == e {
        return 1 << 63;
    }
    mut n = 0;
    if e == 64 {
        n = 1;
    }
    immr := (e - r) % e;
    // imms: the element size marker (high bits) and ones - 1.
    mut imms = (ones - 1) | ((0x3f ^ (e * 2 - 1)) & 0x3f);
    if e == 64 {
        imms = ones - 1;
    }
    return (n << 12) | (immr << 6) | (imms & 0x3f);
}

// A memory operand: `[Xn]`, `[Xn,#imm]`, `[Xn,#imm]!` (mode 2) or `[Xn],#imm` (mode 3).
fn mem<a>(o: (&a mut asm_x86::A), base: (&mut u64), off: (&mut u64), mode: (&mut u64)) {
    asm_x86::expect(&mut o, '[');
    *base = need_reg(&mut o);
    *off = 0;
    *mode = 0;
    asm_x86::skip(&mut o);
    if asm_x86::peek(&o) == ',' {
        o.at += 1;
        *off = imm(&mut o);
        *mode = 1;
    }
    asm_x86::expect(&mut o, ']');
    asm_x86::skip(&mut o);
    if asm_x86::peek(&o) == '!' {
        o.at += 1;
        *mode = 2;
    } else if asm_x86::peek(&o) == ',' {
        o.at += 1;
        *off = imm(&mut o);
        *mode = 3;
    }
}

fn three<a>(o: (&a mut asm_x86::A), op: u64) -> u64 {
    d := need_reg(&mut o);
    comma(&mut o);
    n := need_reg(&mut o);
    comma(&mut o);
    m := need_reg(&mut o);
    return op | (sf(d) << 31) | (rn(m) << 16) | (rn(n) << 5) | rn(d);
}

// add/sub/adds/subs: `op` is 0 add, 1 adds, 2 sub, 3 subs.
fn addsub<a>(o: (&a mut asm_x86::A), op0: u64, cmp: bool) {
    mut op = op0;
    mut d = 31 + 64;
    if !cmp {
        d = need_reg(&mut o);
        comma(&mut o);
    }
    n := need_reg(&mut o);
    comma(&mut o);
    asm_x86::skip(&mut o);
    if cmp {
        d = 31 + 32 * (1 + sf(n));
    }
    c := asm_x86::peek(&o);
    if (c == ':') || ((c == '#') && (asm_x86::peek1(&o) == ':')) {
        kind := modified(&mut o);
        mut w = 0x11000000 | (op << 29) | (sf(d) << 31) | (rn(n) << 5) | rn(d);
        if kind == fx_tprel_hi12() {
            w = w | (1 << 22);
        }
        a0 := o.at;
        e := asm_x86::name_end(&mut o);
        sym := asm_x86::symbol(&mut o, a0, e);
        o.at = e;
        mut add = 0;
        asm_x86::skip(&mut o);
        if asm_x86::peek(&o) == '+' {
            o.at += 1;
            add = asm_x86::number(&mut o);
        }
        asm_x86::fixup(&mut o, sym, kind, add);
        word(&mut o, w);
        return ();
    }
    if (c == '#') || ((c >= '0') && (c <= '9')) || (c == '-') {
        mut v = imm(&mut o);
        mut sh = opt_lsl(&mut o);
        // A negative immediate is the other operation (cmp x, #-1 is cmn x, #1).
        if (v >> 63) != 0 {
            v = wrapping_sub(0, v);
            op = op ^ 2;
        }
        if (sh == 0) && (v > 4095) && ((v & 4095) == 0) && (v < (4096 << 12)) {
            v = v >> 12;
            sh = 12;
        }
        if v > 4095 {
            asm_x86::fail(&mut o, view("an add/sub immediate out of range"));
            return ();
        }
        mut s = 0;
        if sh == 12 {
            s = 1;
        }
        word(&mut o, 0x11000000 | (op << 29) | (sf(d) << 31) | (s << 22) | (v << 10) | (rn(n) << 5) | rn(d));
        return ();
    }
    m := need_reg(&mut o);
    amount := opt_lsl(&mut o);
    if ((d >> 5) == 3) || ((n >> 5) == 3) {
        // With sp, the extended-register form (uxtx).
        word(&mut o, 0x0b200000 | (op << 29) | (sf(d) << 31) | (rn(m) << 16) | (3 << 13) | (amount << 10) | (rn(n) << 5) | rn(d));
        return ();
    }
    word(&mut o, 0x0b000000 | (op << 29) | (sf(d) << 31) | (rn(m) << 16) | (amount << 10) | (rn(n) << 5) | rn(d));
}

// Logical shifted register / immediate: opc 0 and, 1 orr, 2 eor, 3 ands.
fn logical<a>(o: (&a mut asm_x86::A), opc: u64, tst: bool) {
    mut d = 0;
    if !tst {
        d = need_reg(&mut o);
        comma(&mut o);
    }
    n := need_reg(&mut o);
    comma(&mut o);
    if tst {
        d = 31 + 32 * (1 + sf(n));
    }
    asm_x86::skip(&mut o);
    if asm_x86::peek(&o) == '#' {
        v := imm(&mut o);
        mut size = 32;
        if sf(d) != 0 {
            size = 64;
        }
        b := bitmask(v, size);
        if (b >> 63) != 0 {
            asm_x86::fail(&mut o, view("not a logical immediate"));
            return ();
        }
        word(&mut o, 0x12000000 | (opc << 29) | (sf(d) << 31) | (b << 10) | (rn(n) << 5) | rn(d));
        return ();
    }
    m := need_reg(&mut o);
    amount := opt_lsl(&mut o);
    word(&mut o, 0x0a000000 | (opc << 29) | (sf(d) << 31) | (rn(m) << 16) | (amount << 10) | (rn(n) << 5) | rn(d));
}

fn movw<a>(o: (&a mut asm_x86::A), opc: u64) {
    d := need_reg(&mut o);
    comma(&mut o);
    v := imm(&mut o);
    sh := opt_lsl(&mut o);
    word(&mut o, 0x12800000 | (opc << 29) | (sf(d) << 31) | ((sh / 16) << 21) | ((v & 0xffff) << 5) | rn(d));
}

fn mov<a>(o: (&a mut asm_x86::A)) {
    d := need_reg(&mut o);
    comma(&mut o);
    asm_x86::skip(&mut o);
    if asm_x86::peek(&o) == '#' {
        v := imm(&mut o);
        mut mask: u64 = 0xffffffffffffffff;
        if sf(d) == 0 {
            mask = 0xffffffff;
        }
        // movz, then movn, then a logical immediate - LLVM's order.
        for hw in 4 {
            if (sf(d) == 0) && (hw >= 2) {
                break;
            }
            if (v & mask & (0xffffffffffffffff ^ (0xffff << (16 * hw)))) == 0 {
                word(&mut o, 0x52800000 | (sf(d) << 31) | (hw << 21) | (((v >> (16 * hw)) & 0xffff) << 5) | rn(d));
                return ();
            }
        }
        inv := (v ^ 0xffffffffffffffff) & mask;
        for hw in 4 {
            if (sf(d) == 0) && (hw >= 2) {
                break;
            }
            if (inv & (0xffffffffffffffff ^ (0xffff << (16 * hw)))) == 0 {
                word(&mut o, 0x12800000 | (sf(d) << 31) | (hw << 21) | (((inv >> (16 * hw)) & 0xffff) << 5) | rn(d));
                return ();
            }
        }
        mut size = 32;
        if sf(d) != 0 {
            size = 64;
        }
        b := bitmask(v, size);
        if (b >> 63) != 0 {
            asm_x86::fail(&mut o, view("a mov immediate that needs more than one instruction"));
            return ();
        }
        word(&mut o, 0x32000000 | (sf(d) << 31) | (b << 10) | (31 << 5) | rn(d));
        return ();
    }
    m := need_reg(&mut o);
    k := m >> 5;
    if (k == 4) || (k == 5) || ((d >> 5) == 4) || ((d >> 5) == 5) {
        asm_x86::fail(&mut o, view("mov between float registers: use fmov"));
        return ();
    }
    if ((d >> 5) == 3) || (k == 3) {
        word(&mut o, 0x11000000 | (sf(d) << 31) | (rn(m) << 5) | rn(d));
        return ();
    }
    word(&mut o, 0x2a0003e0 | (sf(d) << 31) | (rn(m) << 16) | rn(d));
}

// Loads and stores of a general register: size 3 (x), 2 (w), 0 (byte); load 1 or 0.
fn ldst<a>(o: (&a mut asm_x86::A), size0: u64, load: u64) {
    t := need_reg(&mut o);
    comma(&mut o);
    mut size = size0;
    if (size == 3) && (sf(t) == 0) {
        size = 2;
    }
    // A float register: the SIMD&FP form (V); d is 64-bit, s 32-bit.
    mut v = 0;
    if (t >> 5) == 4 {
        size = 3;
        v = 0x04000000;
    } else if (t >> 5) == 5 {
        size = 2;
        v = 0x04000000;
    }
    mut base = 0;
    mut off = 0;
    mut mode = 0;
    mem(&mut o, &mut base, &mut off, &mut mode);
    scale := 1 << size;
    if (mode == 2) || (mode == 3) {
        mut idx = 1;
        if mode == 2 {
            idx = 3;
        }
        word(&mut o, 0x38000000 | v | (size << 30) | (load << 22) | ((off & 0x1ff) << 12) | (idx << 10) | (rn(base) << 5) | rn(t));
        return ();
    }
    if ((off >> 63) == 0) && ((off % scale) == 0) && (off / scale < 4096) {
        word(&mut o, 0x39000000 | v | (size << 30) | (load << 22) | ((off / scale) << 10) | (rn(base) << 5) | rn(t));
        return ();
    }
    // An unscaled offset (ldur/stur).
    word(&mut o, 0x38000000 | v | (size << 30) | (load << 22) | ((off & 0x1ff) << 12) | (rn(base) << 5) | rn(t));
}

fn pair<a>(o: (&a mut asm_x86::A), load: u64) {
    t1 := need_reg(&mut o);
    comma(&mut o);
    t2 := need_reg(&mut o);
    comma(&mut o);
    mut base = 0;
    mut off = 0;
    mut mode = 0;
    mem(&mut o, &mut base, &mut off, &mut mode);
    mut kind = 2;
    if mode == 2 {
        kind = 3;
    } else if mode == 3 {
        kind = 1;
    }
    mut opc = 2;
    mut scale = 8;
    mut v = 0;
    if sf(t1) == 0 {
        opc = 0;
        scale = 4;
    }
    // A pair of float registers: the SIMD&FP form (V), opc 01 for d and 00 for s.
    if (t1 >> 5) == 4 {
        opc = 1;
        scale = 8;
        v = 0x04000000;
    } else if (t1 >> 5) == 5 {
        opc = 0;
        scale = 4;
        v = 0x04000000;
    }
    imm7 := (off / scale) & 0x7f;
    if (off >> 63) != 0 {
        word(&mut o, 0x28000000 | v | (opc << 30) | (kind << 23) | (load << 22) | ((wrapping_sub(0, wrapping_sub(0, off) / scale) & 0x7f) << 15) | (rn(t2) << 10) | (rn(base) << 5) | rn(t1));
        return ();
    }
    word(&mut o, 0x28000000 | v | (opc << 30) | (kind << 23) | (load << 22) | (imm7 << 15) | (rn(t2) << 10) | (rn(base) << 5) | rn(t1));
}

fn simple<a, b>(o: (&a asm_x86::A), a0: u64, e: u64, w: &b [u8]) -> bool {
    return asm_x86::at_src(&o, a0, e, w);
}

// Float data processing: `ty` 1 for d, 0 for s registers.
fn fty(r: u64) -> u64 {
    if (r >> 5) == 4 {
        return 1;
    }
    return 0;
}

pub fn instruction<a>(o: (&a mut asm_x86::A), a0: u64, e: u64) {
    o.at = e;
    if simple(&o, a0, e, view("mov")) {
        mov(&mut o);
    } else if simple(&o, a0, e, view("add")) {
        addsub(&mut o, 0, false);
    } else if simple(&o, a0, e, view("adds")) {
        addsub(&mut o, 1, false);
    } else if simple(&o, a0, e, view("sub")) {
        addsub(&mut o, 2, false);
    } else if simple(&o, a0, e, view("subs")) {
        addsub(&mut o, 3, false);
    } else if simple(&o, a0, e, view("cmp")) {
        addsub(&mut o, 3, true);
    } else if simple(&o, a0, e, view("cmn")) {
        addsub(&mut o, 1, true);
    } else if simple(&o, a0, e, view("movz")) {
        movw(&mut o, 2);
    } else if simple(&o, a0, e, view("movn")) {
        movw(&mut o, 0);
    } else if simple(&o, a0, e, view("movk")) {
        movw(&mut o, 3);
    } else if simple(&o, a0, e, view("ldr")) {
        ldst(&mut o, 3, 1);
    } else if simple(&o, a0, e, view("str")) {
        ldst(&mut o, 3, 0);
    } else if simple(&o, a0, e, view("ldrb")) {
        ldst(&mut o, 0, 1);
    } else if simple(&o, a0, e, view("strb")) {
        ldst(&mut o, 0, 0);
    } else if simple(&o, a0, e, view("ldrh")) {
        ldst(&mut o, 1, 1);
    } else if simple(&o, a0, e, view("strh")) {
        ldst(&mut o, 1, 0);
    } else if simple(&o, a0, e, view("ldp")) {
        pair(&mut o, 1);
    } else if simple(&o, a0, e, view("stp")) {
        pair(&mut o, 0);
    } else if simple(&o, a0, e, view("b")) {
        label_ref(&mut o, fx_jump26());
        word(&mut o, 0x14000000);
    } else if simple(&o, a0, e, view("bl")) {
        label_ref(&mut o, fx_call26());
        word(&mut o, 0x94000000);
    } else if (e - a0 > 2) && (o.src[a0] == 'b') && (o.src[a0 + 1] == '.') {
        cc := cond(&mut o, a0 + 2, e);
        label_ref(&mut o, fx_cond19());
        word(&mut o, 0x54000000 | cc);
    } else if simple(&o, a0, e, view("cbz")) || simple(&o, a0, e, view("cbnz")) {
        t := need_reg(&mut o);
        comma(&mut o);
        label_ref(&mut o, fx_cond19());
        mut op = 0x34000000;
        if e - a0 == 4 {
            op = 0x35000000;
        }
        word(&mut o, op | (sf(t) << 31) | rn(t));
    } else if simple(&o, a0, e, view("ret")) {
        word(&mut o, 0xd65f03c0);
    } else if simple(&o, a0, e, view("blr")) {
        w__ := 0xd63f0000 | (rn(need_reg(&mut o)) << 5);
        word(&mut o, w__);
    } else if simple(&o, a0, e, view("br")) {
        w__ := 0xd61f0000 | (rn(need_reg(&mut o)) << 5);
        word(&mut o, w__);
    } else if simple(&o, a0, e, view("cset")) {
        d := need_reg(&mut o);
        comma(&mut o);
        asm_x86::skip(&mut o);
        c0 := o.at;
        ce := asm_x86::name_end(&mut o);
        o.at = ce;
        cc := cond(&mut o, c0, ce);
        word(&mut o, 0x1a9f07e0 | (sf(d) << 31) | ((cc ^ 1) << 12) | rn(d));
    } else if simple(&o, a0, e, view("eor")) {
        logical(&mut o, 2, false);
    } else if simple(&o, a0, e, view("and")) {
        logical(&mut o, 0, false);
    } else if simple(&o, a0, e, view("orr")) {
        logical(&mut o, 1, false);
    } else if simple(&o, a0, e, view("ands")) {
        logical(&mut o, 3, false);
    } else if simple(&o, a0, e, view("tst")) {
        logical(&mut o, 3, true);
    } else if simple(&o, a0, e, view("udiv")) {
        w__ := three(&mut o, 0x1ac00800);
        word(&mut o, w__);
    } else if simple(&o, a0, e, view("sdiv")) {
        w__ := three(&mut o, 0x1ac00c00);
        word(&mut o, w__);
    } else if simple(&o, a0, e, view("lsl")) || simple(&o, a0, e, view("lsr")) || simple(&o, a0, e, view("asr")) {
        mut kind = 0;
        if simple(&o, a0, e, view("lsr")) {
            kind = 1;
        } else if simple(&o, a0, e, view("asr")) {
            kind = 2;
        }
        d := need_reg(&mut o);
        comma(&mut o);
        n := need_reg(&mut o);
        comma(&mut o);
        asm_x86::skip(&mut o);
        if asm_x86::peek(&o) == '#' {
            s := imm(&mut o);
            mut bits = 32;
            if sf(d) != 0 {
                bits = 64;
            }
            nbit := sf(d);
            if kind == 0 {
                word(&mut o, 0x53000000 | (sf(d) << 31) | (nbit << 22) | (((bits - s) % bits) << 16) | ((bits - 1 - s) << 10) | (rn(n) << 5) | rn(d));
            } else if kind == 1 {
                word(&mut o, 0x53000000 | (sf(d) << 31) | (nbit << 22) | (s << 16) | ((bits - 1) << 10) | (rn(n) << 5) | rn(d));
            } else {
                word(&mut o, 0x13000000 | (sf(d) << 31) | (nbit << 22) | (s << 16) | ((bits - 1) << 10) | (rn(n) << 5) | rn(d));
            }
        } else {
            mm := need_reg(&mut o);
            word(&mut o, 0x1ac02000 | (sf(d) << 31) | (rn(mm) << 16) | (kind << 10) | (rn(n) << 5) | rn(d));
        }
    } else if simple(&o, a0, e, view("mul")) {
        w__ := three(&mut o, 0x1b007c00);
        word(&mut o, w__);
    } else if simple(&o, a0, e, view("umulh")) {
        w__ := three(&mut o, 0x1bc07c00) | (1 << 31);
        word(&mut o, w__);
    } else if simple(&o, a0, e, view("smulh")) {
        w__ := three(&mut o, 0x1b407c00) | (1 << 31);
        word(&mut o, w__);
    } else if simple(&o, a0, e, view("msub")) || simple(&o, a0, e, view("madd")) {
        d := need_reg(&mut o);
        comma(&mut o);
        n := need_reg(&mut o);
        comma(&mut o);
        mm := need_reg(&mut o);
        comma(&mut o);
        ra := need_reg(&mut o);
        mut op = 0x1b000000;
        if simple(&o, a0, e, view("msub")) {
            op = 0x1b008000;
        }
        word(&mut o, op | (sf(d) << 31) | (rn(mm) << 16) | (rn(ra) << 10) | (rn(n) << 5) | rn(d));
    } else if simple(&o, a0, e, view("bfi")) {
        d := need_reg(&mut o);
        comma(&mut o);
        n := need_reg(&mut o);
        comma(&mut o);
        lsb := imm(&mut o);
        comma(&mut o);
        width := imm(&mut o);
        mut bits = 32;
        if sf(d) != 0 {
            bits = 64;
        }
        word(&mut o, 0x33000000 | (sf(d) << 31) | (sf(d) << 22) | (((bits - lsb) % bits) << 16) | ((width - 1) << 10) | (rn(n) << 5) | rn(d));
    } else if simple(&o, a0, e, view("adrp")) {
        d := need_reg(&mut o);
        comma(&mut o);
        label_ref(&mut o, fx_adrp());
        word(&mut o, 0x90000000 | rn(d));
    } else if simple(&o, a0, e, view("adr")) {
        d := need_reg(&mut o);
        comma(&mut o);
        label_ref(&mut o, fx_adr21());
        word(&mut o, 0x10000000 | rn(d));
    } else if simple(&o, a0, e, view("svc")) {
        w__ := 0xd4000001 | (imm(&mut o) << 5);
        word(&mut o, w__);
    } else if simple(&o, a0, e, view("brk")) {
        w__ := 0xd4200000 | (imm(&mut o) << 5);
        word(&mut o, w__);
    } else if simple(&o, a0, e, view("ldar")) || simple(&o, a0, e, view("stlr")) || simple(&o, a0, e, view("ldaxr")) {
        t := need_reg(&mut o);
        comma(&mut o);
        asm_x86::expect(&mut o, '[');
        n := need_reg(&mut o);
        asm_x86::expect(&mut o, ']');
        mut op = 0x88dffc00;
        if simple(&o, a0, e, view("stlr")) {
            op = 0x889ffc00;
        } else if simple(&o, a0, e, view("ldaxr")) {
            op = 0x885ffc00;
        }
        word(&mut o, op | (sf(t) << 30) | (rn(n) << 5) | rn(t));
    } else if simple(&o, a0, e, view("stlxr")) {
        st := need_reg(&mut o);
        comma(&mut o);
        t := need_reg(&mut o);
        comma(&mut o);
        asm_x86::expect(&mut o, '[');
        n := need_reg(&mut o);
        asm_x86::expect(&mut o, ']');
        word(&mut o, 0x8800fc00 | (sf(t) << 30) | (rn(st) << 16) | (rn(n) << 5) | rn(t));
    } else if simple(&o, a0, e, view("clrex")) {
        word(&mut o, 0xd5033f5f);
    } else if simple(&o, a0, e, view("dmb")) {
        asm_x86::skip(&mut o);
        b0 := o.at;
        be := asm_x86::name_end(&mut o);
        o.at = be;
        if asm_x86::at_src(&o, b0, be, view("ish")) {
            word(&mut o, 0xd5033bbf);
        } else if asm_x86::at_src(&o, b0, be, view("ishld")) {
            word(&mut o, 0xd50339bf);
        } else if asm_x86::at_src(&o, b0, be, view("ishst")) {
            word(&mut o, 0xd5033abf);
        } else {
            asm_x86::fail(&mut o, view("unsupported barrier"));
        }
    } else if simple(&o, a0, e, view("mrs")) {
        t := need_reg(&mut o);
        comma(&mut o);
        asm_x86::skip(&mut o);
        o.at = asm_x86::name_end(&mut o);
        word(&mut o, 0xd53bd040 | rn(t));
    } else if simple(&o, a0, e, view("msr")) {
        asm_x86::skip(&mut o);
        o.at = asm_x86::name_end(&mut o);
        comma(&mut o);
        t := need_reg(&mut o);
        word(&mut o, 0xd51bd040 | rn(t));
    } else if simple(&o, a0, e, view("fmov")) {
        d := need_reg(&mut o);
        comma(&mut o);
        n := need_reg(&mut o);
        dk := d >> 5;
        nk := n >> 5;
        if ((dk == 4) || (dk == 5)) && ((nk == 4) || (nk == 5)) {
            word(&mut o, 0x1e204000 | (fty(d) << 22) | (rn(n) << 5) | rn(d));
        } else if (dk == 4) || (dk == 5) {
            word(&mut o, 0x1e270000 | (sf(n) << 31) | (fty(d) << 22) | (rn(n) << 5) | rn(d));
        } else {
            word(&mut o, 0x1e260000 | (sf(d) << 31) | (fty(n) << 22) | (rn(n) << 5) | rn(d));
        }
    } else if simple(&o, a0, e, view("fadd")) || simple(&o, a0, e, view("fsub")) || simple(&o, a0, e, view("fmul")) || simple(&o, a0, e, view("fdiv")) {
        mut op = 0x1e202800;
        if simple(&o, a0, e, view("fsub")) {
            op = 0x1e203800;
        } else if simple(&o, a0, e, view("fmul")) {
            op = 0x1e200800;
        } else if simple(&o, a0, e, view("fdiv")) {
            op = 0x1e201800;
        }
        d := need_reg(&mut o);
        comma(&mut o);
        n := need_reg(&mut o);
        comma(&mut o);
        mm := need_reg(&mut o);
        word(&mut o, op | (fty(d) << 22) | (rn(mm) << 16) | (rn(n) << 5) | rn(d));
    } else if simple(&o, a0, e, view("fsqrt")) || simple(&o, a0, e, view("fneg")) || simple(&o, a0, e, view("fabs")) {
        mut op = 0x1e21c000;
        if simple(&o, a0, e, view("fneg")) {
            op = 0x1e214000;
        } else if simple(&o, a0, e, view("fabs")) {
            op = 0x1e20c000;
        }
        d := need_reg(&mut o);
        comma(&mut o);
        n := need_reg(&mut o);
        word(&mut o, op | (fty(d) << 22) | (rn(n) << 5) | rn(d));
    } else if simple(&o, a0, e, view("fcmp")) {
        n := need_reg(&mut o);
        comma(&mut o);
        mm := need_reg(&mut o);
        word(&mut o, 0x1e202000 | (fty(n) << 22) | (rn(mm) << 16) | (rn(n) << 5));
    } else if simple(&o, a0, e, view("fcvt")) {
        d := need_reg(&mut o);
        comma(&mut o);
        n := need_reg(&mut o);
        // d <- s: opc 01 from type 00; s <- d: opc 00 from type 01.
        mut w = 0x1e224000 | (rn(n) << 5) | rn(d);
        if fty(d) == 1 {
            w = 0x1e22c000 | (rn(n) << 5) | rn(d);
        } else {
            w = 0x1e624000 | (rn(n) << 5) | rn(d);
        }
        word(&mut o, w);
    } else if simple(&o, a0, e, view("scvtf")) || simple(&o, a0, e, view("ucvtf")) {
        d := need_reg(&mut o);
        comma(&mut o);
        n := need_reg(&mut o);
        mut op = 0x1e220000;
        if simple(&o, a0, e, view("ucvtf")) {
            op = 0x1e230000;
        }
        word(&mut o, op | (sf(n) << 31) | (fty(d) << 22) | (rn(n) << 5) | rn(d));
    } else if simple(&o, a0, e, view("fcvtzs")) || simple(&o, a0, e, view("fcvtzu")) {
        d := need_reg(&mut o);
        comma(&mut o);
        n := need_reg(&mut o);
        mut op = 0x1e380000;
        if simple(&o, a0, e, view("fcvtzu")) {
            op = 0x1e390000;
        }
        word(&mut o, op | (sf(d) << 31) | (fty(n) << 22) | (rn(n) << 5) | rn(d));
    } else {
        asm_x86::fail(&mut o, view("unsupported instruction"));
    }
}
