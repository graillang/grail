module ownership;

// Ownership state is separate from emitted register numbers. Places form storage trees;
// loans name storage and optional exclusive ancestors. Indices are one-based; zero is absent.
// Status: 0 uninitialized, 1 definitely live, 2 moved/ended, 3 maybe live.
// Errors: 1 unknown, 2 not definitely live, 3 conflicting loan, 4 no write authority,
//         5 partially moved aggregate, 6 live child loan, 7 incompatible control-flow shape.
// This is the checker core, not yet frontend enforcement or a language soundness proof.
pub struct Place {
    parent: u64,
    status: u64,
    copy: u64
}
pub struct Loan {
    source: u64,
    parent: u64,
    mode: u64,
    live: u64
}
pub struct State {
    places: Place[],
    loans: Loan[]
}

pub fn new() -> State {
    return State { places: Place[], loans: Loan[] };
}
pub fn root<a>(s: (&a mut State), copy: u64, initialized: u64) -> u64 {
    s.places.push(Place { parent: 0, status: initialized, copy: copy });
    return s.places.len();
}
pub fn field<a>(s: (&a mut State), parent: u64, copy: u64) -> u64 {
    if parent == 0 || s.places.len() < parent {
        return 0;
    }
    mut p = &s.places[parent - 1];
    status := p.status;
    s.places.push(Place { parent: parent, status: status, copy: copy });
    return s.places.len();
}
fn parent_of<a>(s: (&a State), id: u64) -> u64 {
    mut p = &s.places[id - 1];
    return p.parent;
}
pub fn status<a>(s: (&a State), id: u64) -> u64 {
    if id == 0 || s.places.len() < id {
        return 0;
    }
    mut p = &s.places[id - 1];
    return p.status;
}
pub fn ancestor<a>(s: (&a State), outer: u64, inner: u64) -> bool {
    if outer == 0 || inner == 0 || s.places.len() < inner || s.places.len() < outer {
        return false;
    }
    mut p = inner;
    while p != 0 {
        if p == outer {
            return true;
        }
        p = parent_of(&s, p);
    }
    return false;
}
fn overlaps<a>(s: (&a State), a: u64, b: u64) -> bool {
    return ancestor(&s, a, b) || ancestor(&s, b, a);
}
fn present<a>(s: (&a State), id: u64) -> u64 {
    if id == 0 || s.places.len() < id {
        return 1;
    }
    mut p = id;
    while p != 0 {
        if status(&s, p) != 1 {
            return 2;
        }
        p = parent_of(&s, p);
    }
    return 0;
}
fn complete<a>(s: (&a State), id: u64) -> u64 {
    e := present(&s, id);
    if e != 0 {
        return e;
    }
    for i in s.places.len() {
        if ancestor(&s, id, i + 1) {
            if status(&s, i + 1) != 1 {
                return 5;
            }
        }
    }
    return 0;
}
fn conflict<a>(s: (&a State), id: u64, exclusive: u64) -> u64 {
    for i in s.loans.len() {
        mut l = &s.loans[i];
        source := l.source;
        live := l.live;
        mode := l.mode;
        if live != 0 {
            if (exclusive + mode) != 0 {
                if overlaps(&s, id, source) {
                    return 3;
                }
            }
        }
    }
    return 0;
}
pub fn read(s: (&a State), id: u64) -> u64 {
    e := complete(&s, id);
    if e != 0 {
        return e;
    }
    return conflict(&s, id, 0);
}
fn set_tree<a>(s: (&a mut State), id: u64, status: u64) -> unit {
    for i in s.places.len() {
        if ancestor(&s, id, i + 1) {
            mut p = &mut s.places[i];
            exchange(&mut p.status, status);
        }
    }
    return ();
}
pub fn take<a>(s: (&a mut State), id: u64) -> u64 {
    e := complete(&s, id);
    if e != 0 {
        return e;
    }
    mut p = &s.places[id - 1];
    copy := p.copy;
    c := conflict(&s, id, copy == 0);
    if c != 0 {
        return c;
    }
    if copy == 0 {
        set_tree(&mut s, id, 2);
    }
    return 0;
}
// Compiler-generated cleanup may close possibly initialized storage; emitted flags guard frees.
pub fn cleanup<a>(s: (&a mut State), id: u64) -> u64 {
    if id == 0 || s.places.len() < id {
        return 1;
    }
    if status(&s, id) == 2 {
        return 0;
    }
    c := conflict(&s, id, 1);
    if c != 0 {
        return c;
    }
    set_tree(&mut s, id, 2);
    return 0;
}
pub fn drop_value<a>(s: (&a mut State), id: u64) -> u64 {
    e := present(&s, id);
    if e != 0 {
        return e;
    }
    return cleanup(&mut s, id);
}
pub fn initialize<a>(s: (&a mut State), id: u64) -> u64 {
    if id == 0 || s.places.len() < id {
        return 1;
    }
    parent := parent_of(&s, id);
    if parent != 0 {
        e := present(&s, parent);
        if e != 0 {
            return e;
        }
    }
    c := conflict(&s, id, 1);
    if c != 0 {
        return c;
    }
    set_tree(&mut s, id, 1);
    return 0;
}
// Negative errors are not represented by loan IDs: zero means borrow denied, with no mutation.
pub fn borrow_place<a>(s: (&a mut State), id: u64, mode: u64) -> u64 {
    if 1 < mode {
        return 0;
    }
    if complete(&s, id) != 0 {
        return 0;
    }
    if conflict(&s, id, mode) != 0 {
        return 0;
    }
    s.loans.push(Loan { source: id, parent: 0, mode: mode, live: 1 });
    return s.loans.len();
}
fn loan_parent<a>(s: (&a State), id: u64) -> u64 {
    mut l = &s.loans[id - 1];
    return l.parent;
}
fn loan_ancestor<a>(s: (&a State), outer: u64, inner: u64) -> bool {
    mut p = inner;
    while p != 0 {
        if p == outer {
            return true;
        }
        p = loan_parent(&s, p);
    }
    return false;
}
pub fn use_loan<a>(s: (&a State), id: u64, write: u64) -> u64 {
    if id == 0 || s.loans.len() < id {
        return 1;
    }
    mut l = &s.loans[id - 1];
    live := l.live;
    mode := l.mode;
    if live == 0 {
        return 2;
    }
    if write != 0 && mode == 0 {
        return 4;
    }
    if mode != 0 {
        for i in s.loans.len() {
            child := &s.loans[i];
            active := child.live;
            if active != 0 && i + 1 != id {
                if loan_ancestor(&s, id, i + 1) {
                    return 6;
                }
            }
        }
    }
    return 0;
}
pub fn reborrow<a>(s: (&a mut State), parent: u64, mode: u64) -> u64 {
    if 1 < mode {
        return 0;
    }
    if use_loan(&s, parent, mode) != 0 {
        return 0;
    }
    mut l = &s.loans[parent - 1];
    source := l.source;
    pmode := l.mode;
    gp := l.parent;
    mut authority = parent;
    if pmode == 0 {
        authority = gp;
    }
    for i in s.loans.len() {
        other := &s.loans[i];
        live := other.live;
        omode := other.mode;
        osource := other.source;
        if live != 0 && i + 1 != parent {
            if !loan_ancestor(&s, i + 1, parent) {
                if mode != 0 || omode != 0 {
                    if overlaps(&s, source, osource) {
                        return 0;
                    }
                }
            }
        }
    }
    s.loans.push(Loan { source: source, parent: authority, mode: mode, live: 1 });
    return s.loans.len();
}
pub fn end_loan<a>(s: (&a mut State), id: u64) -> u64 {
    if id == 0 || s.loans.len() < id {
        return 1;
    }
    mut l = &s.loans[id - 1];
    if l.live == 0 {
        return 2;
    }
    for i in s.loans.len() {
        child := &s.loans[i];
        active := child.live;
        if active != 0 && i + 1 != id {
            if loan_ancestor(&s, id, i + 1) {
                return 6;
            }
        }
    }
    mut p = &mut s.loans[id - 1];
    exchange(&mut p.live, 0);
    return 0;
}
pub fn snapshot<a>(s: (&a State)) -> State {
    mut places = Place[];
    mut loans = Loan[];
    for i in s.places.len() {
        mut p = &s.places[i];
        places.push(Place { parent: p.parent, status: p.status, copy: p.copy });
    }
    for i in s.loans.len() {
        mut l = &s.loans[i];
        loans.push(Loan { source: l.source, parent: l.parent, mode: l.mode, live: l.live });
    }
    return State { places: places, loans: loans };
}
// Conservative join: definitely initialized places intersect, possible live loans union.
// Different storage/authority shapes are rejected instead of pretending they are interchangeable.
pub fn join<a, b>(s: (&a mut State), other: (&b State)) -> u64 {
    if s.places.len() != other.places.len() || s.loans.len() != other.loans.len() {
        return 7;
    }
    for i in s.places.len() {
        mut a = &s.places[i];
        b := &other.places[i];
        if a.parent != b.parent || a.copy != b.copy {
            return 7;
        }
    }
    for i in s.loans.len() {
        mut a = &s.loans[i];
        b := &other.loans[i];
        if a.source != b.source || a.parent != b.parent || a.mode != b.mode {
            return 7;
        }
    }
    for i in s.places.len() {
        mut a = &s.places[i];
        old := a.status;
        b := &other.places[i];
        incoming := b.status;
        if old != incoming {
            mut a = &mut s.places[i];
            exchange(&mut a.status, 3);
        }
    }
    for i in s.loans.len() {
        mut a = &s.loans[i];
        live := a.live;
        b := &other.loans[i];
        incoming := b.live;
        if live == 0 && incoming != 0 {
            mut a = &mut s.loans[i];
            exchange(&mut a.live, 1);
        }
    }
    return 0;
}
// Restore an earlier control-flow point without reusing place IDs allocated in another arm.
// Newly seen fields of old storage inherit the parent's state; arm-local roots are dead.
pub fn restore<a, b>(s: (&a mut State), saved: (&b State)) -> unit {
    for i in s.places.len() {
        mut state = 2;
        if i < saved.places.len() {
            mut p = &saved.places[i];
            state = p.status;
        } else {
            mut p = &s.places[i];
            parent := p.parent;
            if parent != 0 {
                state = status(&s, parent);
            }
        }
        mut p = &mut s.places[i];
        exchange(&mut p.status, state);
    }
    for i in s.loans.len() {
        mut live = 0;
        if i < saved.loans.len() {
            mut l = &saved.loans[i];
            live = l.live;
        }
        mut l = &mut s.loans[i];
        exchange(&mut l.live, live);
    }
    return ();
}
fn inherited_status<a, b>(s: (&a State), saved: (&b State), id: u64) -> u64 {
    mut p = id;
    while p != 0 {
        if p < saved.places.len() + 1 {
            v := &saved.places[p - 1];
            return v.status;
        }
        p = parent_of(&s, p);
    }
    return 2;
}
pub fn merge<a, b>(s: (&a mut State), saved: (&b State)) -> unit {
    mut i = s.places.len();
    while i < saved.places.len() {
        mut p = &saved.places[i];
        parent := p.parent;
        copy := p.copy;
        mut state = 2;
        if parent != 0 {
            state = status(&s, parent);
        }
        s.places.push(Place { parent: parent, status: state, copy: copy });
        i = i + 1;
    }
    for i in s.places.len() {
        old := status(&s, i + 1);
        incoming := inherited_status(&s, &saved, i + 1);
        if old != incoming {
            mut p = &mut s.places[i];
            exchange(&mut p.status, 3);
        }
    }
    mut j = s.loans.len();
    while j < saved.loans.len() {
        mut l = &saved.loans[j];
        s.loans.push(Loan { source: l.source, parent: l.parent, mode: l.mode, live: 0 });
        j = j + 1;
    }
    for i in saved.loans.len() {
        if i < s.loans.len() {
            mut l = &saved.loans[i];
            live := l.live;
            if live != 0 {
                mut l = &mut s.loans[i];
                exchange(&mut l.live, 1);
            }
        }
    }
    return ();
}
// Entry storage cannot be consumed on a repeating backedge. Dead loop-local roots are irrelevant.
pub fn backedge<a, b>(s: (&a State), entry: (&b State)) -> u64 {
    for i in entry.places.len() {
        mut p = &entry.places[i];
        if p.status == 1 {
            if complete(&s, i + 1) != 0 {
                return 2;
            }
        }
    }
    for i in entry.loans.len() {
        old := &entry.loans[i];
        live := old.live;
        if i < s.loans.len() {
            current := &s.loans[i];
            if current.live != live {
                return 3;
            }
        }
    }
    mut i = entry.loans.len();
    while i < s.loans.len() {
        current := &s.loans[i];
        live := current.live;
        mode := current.mode;
        source := current.source;
        parent := current.parent;
        if live != 0 {
            mut stable = 0;
            if mode == 0 {
                for j in entry.loans.len() {
                    old := &entry.loans[j];
                    if old.live != 0
                        && old.mode == 0
                        && old.source == source
                        && old.parent == parent {
                        stable = 1;
                        break;
                    }
                }
            }
            if stable == 0 {
                return 3;
            }
        }
        i = i + 1;
    }
    return 0;
}
// Access through an existing loan may project disjoint fields even when a sibling is reborrowed.
// The parent authority and its ancestors are ignored; every other overlapping loan still counts.
pub fn access_loan<a>(s: (&a State), parent: u64, target: u64, write: u64) -> u64 {
    if parent == 0 || s.loans.len() < parent {
        return 1;
    }
    mut p = &s.loans[parent - 1];
    live := p.live;
    mode := p.mode;
    source := p.source;
    if live == 0 {
        return 2;
    }
    if write != 0 && mode == 0 {
        return 4;
    }
    if !ancestor(&s, source, target) {
        return 4;
    }
    e := complete(&s, target);
    if e != 0 {
        return e;
    }
    for i in s.loans.len() {
        mut l = &s.loans[i];
        active := l.live;
        m := l.mode;
        mut p = l.source;
        if active != 0 {
            if !loan_ancestor(&s, i + 1, parent) {
                if write != 0 || m != 0 {
                    if overlaps(&s, target, p) {
                        return 3;
                    }
                }
            }
        }
    }
    return 0;
}
pub fn reborrow_place<a>(s: (&a mut State), parent: u64, target: u64, mode: u64) -> u64 {
    if 1 < mode {
        return 0;
    }
    if access_loan(&s, parent, target, mode) != 0 {
        return 0;
    }
    mut p = &s.loans[parent - 1];
    pmode := p.mode;
    gp := p.parent;
    mut authority = parent;
    if pmode == 0 {
        authority = gp;
    }
    s.loans.push(Loan { source: target, parent: authority, mode: mode, live: 1 });
    return s.loans.len();
}
pub fn can_cleanup<a>(s: (&a State), id: u64) -> bool {
    if id == 0 || s.places.len() < id {
        return false;
    }
    return conflict(&s, id, 1) == 0;
}
