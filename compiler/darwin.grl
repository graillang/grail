unsafe module runtime;

// macOS system boundary: this module is compiled only for Mach-O targets and is where every
// libSystem call lives. Linux builds never include it, so ELF objects carry no Apple imports.
// The runtime's semantic operation numbers are decoded here into libSystem entry points. A name is
// a C name (Mach-O adds the leading underscore); a name that already starts with '_' is used as the
// final symbol, which is how libc internals such as __error are reached. Every call uses the C word
// ABI, and libSystem's (-1, errno) result is converted back to the negative-errno convention the
// rest of the runtime expects.
// libSystem signals failure with -1; the runtime's negative-errno test is the same predicate.
// Native system-call numbers stay behind this portable runtime boundary.
// Operation IDs are stable runtime identifiers, not the target's Linux syscall ABI.
fn rt_syscall(n: u64, a: u64, b: u64, c: u64) -> u64 {
    // This module is the Mach-O platform layer: the runtime calls the libSystem bridge directly,
    // so the compiler needs no Darwin branch in raw_syscall.
    return rt_call(n, a, b, c);
}

// Trusted native runtime, entirely Grail. Raw intrinsics below are the compiler/OS boundary.
// All runtime values are words. Sequence = {data,length,capacity}; allocation header = {class,link}.
// Process state: argc,argv,envp,live allocation count,arena chain; allocator bins start at byte 256.
// Freed blocks return to segregated free lists; mapped arenas are unmapped by rt_shutdown.

fn rt_syscall4(n: u64, a: u64, b: u64, c: u64, d: u64) -> u64 {
    // This module is the Mach-O platform layer: the runtime calls the libSystem bridge directly,
    // so the compiler needs no Darwin branch in raw_syscall.
    return rt_call4(n, a, b, c, d);
}
// Abort's last step: _exit, which runs no atexit handlers, no C++ destructors and no stdio flush.
fn rt_hard_exit(code: u64) -> u64 {
    rt_syscall(231, code, 0, 0);
    return 0;
}
// The running image: _NSGetExecutablePath fills the caller's buffer and reports its size, so the
// buffer is handed over as a one-word out-parameter holding `size`.
fn rt_exe_path(buf: u64, size: u64) -> u64 {
    slot := rt_alloc(16);
    raw_store(slot, size - 1);
    r := raw_import("NSGetExecutablePath", buf, slot);
    n := raw_load(slot);
    rt_free(slot);
    if r != 0 {
        return wrapping_sub(0, 34);
    }
    raw_putbyte(buf + n, 0);
    return n;
}
fn rt_readlinkat(path: u64, buf: u64, size: u64) -> u64 {
    return rt_os_result(raw_import("readlink", path, buf, size));
}
fn rt_faccessat(path: u64) -> u64 {
