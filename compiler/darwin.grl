// O_* bits carry different values in the Linux and Darwin ABIs; access modes agree.
fn rt_os_open_flags(flags: u64) -> u64 {
    mut out = flags & 3;
    if (flags & 64) != 0 {
        out = out | 512;
    }
    if (flags & 128) != 0 {
        out = out | 2048;
    }
    if (flags & 512) != 0 {
        out = out | 1024;
    }
    if (flags & 1024) != 0 {
        out = out | 8;
    }
    if (flags & 2048) != 0 {
        out = out | 4;
    }
    if (flags & 65536) != 0 {
        out = out | 1048576;
    }
    if (flags & 524288) != 0 {
        out = out | 16777216;
    }
    return out;
}
fn rt_os_clock(id: u64) -> u64 {
    if id == 1 {
        return 6;
    }
    if id == 3 {
        return 12;
    }
    return id;
}
// Darwin reports a processor count, while the caller counts bits in a cpu_set buffer.
fn rt_os_cpus(n: u64, buf: u64) -> u64 {
