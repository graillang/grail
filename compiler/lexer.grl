module lexer;

// Stable token kinds: 0 EOF, 1 identifier (keywords included), 2 decimal
// number, 3 string literal (including both quotes), 4 byte character literal, 5 float literal. Single-byte punctuation
// uses its ASCII byte value: (){}[]<>,:;=+-*%&^.!?
// Multibyte punctuation: 256 ->, 257 =>, 258 ==, 259 !=, 260 ::, 261 :=, 262 +=, 263 -=,
// 264 *=, 265 /=, 266 %=, 267 **, 268 **=, 269 <=, 270 >=, 273 &&, 274 ||, 275 ^=.
// A token is the byte range [start, end) of the source, the EOF token the empty range at
// len(source), and where it starts, 1-based (`col` counts bytes). It holds no view of the source:
// one per token was an allocation per token, and the parser keeps these tokens as they are.
pub struct Token {
    kind: u64,
    start: u64,
    end: u64,
    line: u64,
    col: u64
}

fn letter(c: u64) -> bool {
    return ((64 < c) && (c < 91)) || ((96 < c) && (c < 123)) || (c == 95);
}
fn digit(c: u64) -> bool {
    return (47 < c) && (c < 58);
}
fn whitespace(c: u64) -> bool {
    return (c == 32) || (c == 9) || (c == 10) || (c == 12) || (c == 13);
}
// What may follow a tick-prefixed name and still make it a lifetime rather than a character literal
// that never closed: `>` `,` `)` ` ` `&` `[` `|` `;` and a line break.
fn lifetime_stop(c: u64) -> bool {
    return (c == 62) || (c == 44) || (c == 41) || (c == 32) || (c == 38) || (c == 91) || (c == 124) || (c == 59) || (c == 10);
}
fn punctuation(c: u64) -> bool {
    return (c == 40)
        || (c == 41)
        || (c == 91)
        || (c == 93)
        || (c == 123)
        || (c == 125)
        || (c == 60)
        || (c == 62)
        || (c == 44)
        || (c == 58)
        || (c == 59)
        || (c == 61)
        || (c == 43)
        || (c == 45)
        || (c == 42)
        || (c == 47)
        || (c == 37)
        || (c == 38)
        || (c == 94)
        || (c == 46)
        || (c == 33)
        || (c == 63)
        || (c == 124)
        || (c == 64);
}
fn pair_kind(c: u64, d: u64) -> u64 {
    // Every pair below ends in one of `= > : * & |`: any other second byte is no pair.
    if (d != 61) && (d != 62) && (d != 58) && (d != 42) && (d != 38) && (d != 124) {
        return 0;
    }
    if (c == 45) & (d == 62) {
        return 256;
    }
    if (c == 61) & (d == 62) {
        return 257;
    }
    if (c == 61) & (d == 61) {
        return 258;
    }
    if (c == 33) & (d == 61) {
        return 259;
    }
    if (c == 58) & (d == 58) {
        return 260;
    }
    if (c == 58) & (d == 61) {
        return 261;
    }
    if (c == 43) & (d == 61) {
        return 262;
    }
    if (c == 45) & (d == 61) {
        return 263;
    }
    if (c == 42) & (d == 61) {
        return 264;
    }
    if (c == 47) & (d == 61) {
        return 265;
    }
    if (c == 37) & (d == 61) {
        return 266;
    }
    if (c == 42) & (d == 42) {
        return 267;
    }
    if (c == 60) & (d == 61) {
        return 269;
    }
    if (c == 62) & (d == 61) {
        return 270;
    }
    if (c == 38) & (d == 38) {
        return 273;
    }
    if (c == 124) & (d == 124) {
        return 274;
    }
    if (c == 94) & (d == 61) {
        return 275;
    }
    return 0;
}

// This is the seed's lexical boundary scanner, not string decoding: a
// backslash protects the following byte, including a quote or backslash.
// Escape validity and decoded UTF-8 validity belong to the literal parser.
// Non-ASCII bytes are accepted inside strings/comments, not identifiers.
// A literal the scanner cannot finish is a token the compiler reports: 998 an ill-formed character
// literal, 996 an unclosed string, 995 a string holding a raw control byte, 994 a block comment
// (`/* ... */`, which nests) that is not closed before the end of the file. Nothing in here aborts
// on user input - an assert on source text is a compiler bug, not a refusal (docs/diagnostics.md).
pub fn tokenize<a>(source: &a [u8]) -> Token[] {
    mut tokens = Token[];
    size := source.len();
    mut i = 0;
    // The line and column of byte `at`, carried forward to each token's start.
    mut at = 0;
    mut line = 1;
    mut col = 1;
    while i < size {
        c := source[i];
        // whitespace(c), written out for the loop every byte passes through: space, tab, newline,
        // form feed and carriage return are bits 32, 9, 10, 12 and 13 of the mask.
        if (c < 33) && (((4294981120 >> c) & 1) != 0) {
            i = i + 1;
            continue;
        }
        if c == 47 {
            mut comment = 0;
            if i + 1 < size {
                if source[i + 1] == 47 {
                    comment = 1;
                }
            }
            if comment != 0 {
                i = i + 2;
                while i < size {
                    if source[i] == 10 {
                        break;
                    }
                    i = i + 1;
                }
                continue;
            }
            // `/* ... */` nests: each `/*` inside needs its own `*/`, so a block that already
            // holds a comment can be commented out whole.
            if (i + 1 < size) && (source[i + 1] == 42) {
                open := i;
                mut depth = 0;
                while i < size {
                    if (source[i] == 47) && (i + 1 < size) && (source[i + 1] == 42) {
                        depth = depth + 1;
                        i = i + 2;
                    } else if (source[i] == 42) && (i + 1 < size) && (source[i + 1] == 47) {
                        depth = depth - 1;
                        i = i + 2;
                        if depth == 0 {
                            break;
                        }
                    } else {
                        i = i + 1;
                    }
                }
                if depth != 0 {
                    // Unclosed: one error token at the opening `/*`, reported by the compiler.
                    while at < open {
                        if source[at] == 10 {
                            line = line + 1;
                            col = 1;
                        } else {
                            col = col + 1;
                        }
                        at = at + 1;
                    }
                    tokens.push(Token { kind: 994, start: open, end: open + 2, line: line, col: col });
                    i = size;
                }
                continue;
            }
        }
        start := i;
        mut kind = 0;
        // 'a', '\n', '\u{e9}', 'é': a character literal (token kind 4).
        if c == 39 {
            kind = 4;
            i = i + 1;
            // 0 = nothing to scan, 1 = one character and a closing quote, 2 = more than one
            // character before the quote. Only 1 is a character literal.
            mut body = 0;
            if i < size {
                body = 1;
                if source[i] == 92 {
                    i = i + 1;
                    if i == size {
                        body = 0;
                    } else {
                        if source[i] == 117 {
                            while i < size {
                                if source[i] == 125 {
                                    break;
                                }
                                i = i + 1;
                            }
                        }
                        i = i + 1;
                    }
                } else {
                    lead := source[i];
                    i = i + 1;
                    if 191 < lead {
                        while i < size {
                            if (source[i] & 192) != 128 {
                                break;
                            }
                            i = i + 1;
                        }
                    }
                }
            }
            mut form = 0;
            if (body != 0) & (i < size) {
                if source[i] == 39 {
                    i = i + 1;
                    form = 1;
                } else {
                    // `<'a>` / `&'a u64`: one quote and then a name, with no quote closing it.
                    // Grail's lifetimes take no tick (`<a>`, `&a`), so this is a mistake of its own,
                    // not a character literal, and it gets a token of its own (997) when a delimiter
                    // follows the name.
                    mut stop = i;
                    mut name_end = 0;
                    body_ch := source[start + 1];
                    if letter(body_ch) || (body_ch == 95) {
                        if stop < size {
                            if !lifetime_stop(source[stop]) {
                                while stop < size {
                                    if !letter(source[stop]) && !digit(source[stop]) {
                                        break;
                                    }
                                    stop = stop + 1;
                                }
                            }
                            if stop < size {
                                if lifetime_stop(source[stop]) {
                                    name_end = stop;
                                }
                            }
                        }
                    }
                    if name_end != 0 {
                        kind = 997;
                        i = name_end;
                    } else {
                        // `'ab'`: stop at the closing quote on this line so the span the compiler
                        // quotes is the literal, not the rest of the file.
                        mut q = i;
                        while (q < size) & (source[q] != 10) {
                            if source[q] == 39 {
                                i = q + 1;
                                form = 2;
                                break;
                            }
                            q = q + 1;
                        }
                    }
                }
            }
            // 997 already answered this quote (a tick-prefixed name); only a quote that really is
            // an unfinished character literal becomes 998, and only then does it swallow the run.
            if (form != 1) & (kind != 997) {
                kind = 998;
                if form == 0 {
                    i = size;
                }
            }
        } else {
            if c == 34 {
                kind = 3;
                i = i + 1;
                mut closed = 0;
                while i < size {
                    b := source[i];
                    if b == 34 {
                        i = i + 1;
                        closed = 1;
                        break;
                    }
                    if b < 32 {
                        // A literal newline is the mistake a string with no closing quote makes,
                        // so it is reported as unclosed; any other control byte is reported as the
                        // byte it is. Either way it is a token the compiler reports, not an abort.
                        if b == 10 {
                            kind = 996;
                        } else {
                            kind = 995;
                            i = i + 1;
                        }
                        closed = 1;
                        break;
                    }
                    if b == 92 {
                        i = i + 1;
                        if i == size {
                            break;
                        }
                    }
                    i = i + 1;
                }
                if closed == 0 {
                    kind = 996;
                    i = size;
                }
            } else {
                // letter(c) and digit(b) written out: a letter's byte with bit 5 set is `a`..`z`; the
                // subtraction wraps, so anything below `a` lands far above.
                if (wrapping_sub(c | 32, 97) < 26) || (c == 95) {
                    kind = 1;
                    i = i + 1;
                    while i < size {
                        b := source[i];
                        if !((wrapping_sub(b | 32, 97) < 26) || (b == 95) || (wrapping_sub(b, 48) < 10)) {
                            break;
                        }
                        i = i + 1;
                    }
                } else {
                    if digit(c) {
                        kind = 2;
                        // A number right after `.` is a tuple field (`t.0.1`): it never takes a fraction.
                        after_dot := (i > 0) && (source[i - 1] == 46);
                        i = i + 1;
                        // 0x1F, 0b1010, 0o17 and digit separators (1_000_000); validated by the parser.
                        mut radix = 0;
                        if (c == 48) & (i < size) {
                            r := source[i];
                            if r == 120 || r == 98 || r == 111 {
                                radix = 1;
                                i = i + 1;
                            }
                        }
                        while i < size {
                            b := source[i];
                            if radix != 0 {
                                if !(digit(b)
                                    || ((96 < b) && (b < 103))
                                    || ((64 < b) && (b < 71))
                                    || (b == 95)) {
                                    break;
                                }
                            } else {
                                if !digit(b) && b != 95 {
                                    break;
                                }
                            }
                            i = i + 1;
                        }
                        // 1e9, 2.5e-3: an exponent alone also makes a float literal.
                        if (radix == 0) & (i + 1 < size) {
                            if source[i] == 101 || source[i] == 69 {
                                mut j = i + 1;
                                if source[j] == 43 || source[j] == 45 {
                                    j = j + 1;
                                }
                                if j < size {
                                    if digit(source[j]) {
                                        kind = 5;
                                        i = j;
                                        while i < size {
                                            if !digit(source[i]) {
                                                break;
                                            }
                                            i = i + 1;
                                        }
                                    }
                                }
                            }
                        }
                        // 1.5, 2.0e-3: a float literal (token kind 5). `1..4` stays a range.
                        if (i + 1 < size) && !after_dot {
                            if source[i] == 46 {
                                if digit(source[i + 1]) {
                                    kind = 5;
                                    i = i + 1;
                                    while i < size {
                                        if !digit(source[i]) {
                                            break;
                                        }
                                        i = i + 1;
                                    }
                                    if i + 1 < size {
                                        if source[i] == 101 || source[i] == 69 {
                                            mut j = i + 1;
                                            if source[j] == 43 || source[j] == 45 {
                                                j = j + 1;
                                            }
                                            if j < size {
                                                if digit(source[j]) {
                                                    i = j;
                                                    while i < size {
                                                        if !digit(source[i]) {
                                                            break;
                                                        }
                                                        i = i + 1;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        if i + 1 < size {
                            kind = pair_kind(c, source[i + 1]);
                        }
                        // x!==y is postfix unwrap followed by ==, not != followed by =.
                        if (kind == 259) & (i + 2 < size) {
                            if source[i + 2] == 61 {
                                kind = 0;
                            }
                        }
                        if kind != 0 {
                            i = i + 2;
                            if kind == 267 {
                                if i < size {
                                    if source[i] == 61 {
                                        kind = 268;
                                        i = i + 1;
                                    }
                                }
                            }
                        } else {
                            // A character the language has no use for is a token of its own (kind
                            // 999, one whole UTF-8 character), which the compiler reports with its
                            // position instead of the lexer aborting without a word.
                            kind = c;
                            if !punctuation(c) {
                                kind = 999;
                            }
                            i = i + 1;
                            if 191 < c {
                                while (i < size) && ((source[i] & 192) == 128) {
                                    i = i + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        while at < start {
            if source[at] == 10 {
                line += 1;
                col = 1;
            } else {
                col += 1;
            }
            at += 1;
        }
        tokens.push(Token { kind: kind, start: start, end: i, line: line, col: col });
    }
    while at < size {
        if source[at] == 10 {
            line += 1;
            col = 1;
        } else {
            col += 1;
        }
        at += 1;
    }
    tokens.push(Token { kind: 0, start: size, end: size, line: line, col: col });
    return tokens;
}
