module lexer;

// Stable token kinds: 0 EOF, 1 identifier (keywords included), 2 decimal
// number, 3 string literal (including both quotes), 4 byte character literal, 5 float literal. Single-byte punctuation
// uses its ASCII byte value: (){}[]<>,:;=+-*%&^.!?
// Multibyte punctuation: 256 ->, 257 =>, 258 ==, 259 !=, 260 ::, 261 :=, 262 +=, 263 -=,
// 264 *=, 265 /=, 266 %=, 267 **, 268 **=, 269 <=, 270 >=, 273 &&, 274 ||.
// All spans borrow source, including the empty EOF span at len(source).
pub struct Token<a> { kind:num, span:read<a>, start:num, end:num }

fn letter(c:num)->num {
    return ((64<c)&(c<91))+((96<c)&(c<123))+(c==95);
}
fn digit(c:num)->num { return (47<c)&(c<58); }
fn whitespace(c:num)->num {
    return (c==32)+(c==9)+(c==10)+(c==12)+(c==13);
}
fn punctuation(c:num)->num {
    return (c==40)+(c==41)+(c==91)+(c==93)+(c==123)+(c==125)+(c==60)+(c==62)
        +(c==44)+(c==58)+(c==59)+(c==61)+(c==43)+(c==45)
        +(c==42)+(c==47)+(c==37)+(c==38)+(c==94)+(c==46)+(c==33)+(c==63)+(c==124);
}
fn pair_kind(c:num,d:num)->num {
    if (c==45)&(d==62) { return 256; }
    if (c==61)&(d==62) { return 257; }
    if (c==61)&(d==61) { return 258; }
    if (c==33)&(d==61) { return 259; }
    if (c==58)&(d==58) { return 260; }
    if (c==58)&(d==61) { return 261; }
    if (c==43)&(d==61) { return 262; }
    if (c==45)&(d==61) { return 263; }
    if (c==42)&(d==61) { return 264; }
    if (c==47)&(d==61) { return 265; }
    if (c==37)&(d==61) { return 266; }
    if (c==42)&(d==42) { return 267; }
    if (c==60)&(d==61) { return 269; }
    if (c==62)&(d==61) { return 270; }
    if (c==38)&(d==38) { return 273; }
    if (c==124)&(d==124) { return 274; }
    return 0;
}

// This is the seed's lexical boundary scanner, not string decoding: a
// backslash protects the following byte, including a quote or backslash.
// Escape validity and decoded UTF-8 validity belong to the literal parser.
// Non-ASCII bytes are accepted inside strings/comments, not identifiers.
// Invalid characters, raw string control bytes and unclosed strings abort.
pub fn tokenize<a>(source:read<a>)->Token<a>[] {
    mut tokens =Token<a>[];
    size :=source.len();
    mut i=0;
    while i<size {
        c :=source[i];
        if whitespace(c) { i=i+1; continue; }
        if c==47 {
            mut comment=0;if i+1<size{if source[i+1]==47{comment=1;}}
            if comment{
            i=i+2;
            while i<size {
                if source[i]==10 { break; }
                i=i+1;
            }
            continue;
            }
        }
        start :=i;
        mut kind=0;
        // 'a', '\n', '\u{e9}', 'é': a character literal (token kind 4).
        if c==39 {
            kind=4;i=i+1;assert(i<size);
            if source[i]==92{i=i+1;assert(i<size);if source[i]==117{while i<size{if source[i]==125{break;}i=i+1;}}i=i+1;}
            else{lead :=source[i];i=i+1;if 191<lead{while i<size{if (source[i]&192)!=128{break;}i=i+1;}}}
            assert(i<size);assert(source[i]==39);i=i+1;
        } else {
        if c==34 {
            kind=3;
            i=i+1;
            mut closed=0;
            while i<size {
                b :=source[i];
                if b==34 { i=i+1; closed=1; break; }
                assert((b<32)==0);
                if b==92 {
                    i=i+1;
                    if i==size { break; }
                }
                i=i+1;
            }
            assert(closed);
        } else {
            if letter(c) {
                kind=1;
                i=i+1;
                while i<size {
                    b :=source[i];
                    if (letter(b)+digit(b))==0 { break; }
                    i=i+1;
                }
            } else {
                if digit(c) {
                    kind=2;
                    i=i+1;
                    // 0x1F, 0b1010, 0o17 and digit separators (1_000_000); validated by the parser.
                    mut radix=0;
                    if (c==48)&(i<size) { r :=source[i]; if (r==120)+(r==98)+(r==111) { radix=1; i=i+1; } }
                    while i<size {
                        b :=source[i];
                        if radix { if (digit(b)+((96<b)&(b<103))+((64<b)&(b<71))+(b==95))==0 { break; } }
                        else { if (digit(b)==0)&(b!=95) { break; } }
                        i=i+1;
                    }
                    // 1e9, 2.5e-3: an exponent alone also makes a float literal.
                    if (radix==0)&(i+1<size) { if (source[i]==101)+(source[i]==69) {
                        mut j=i+1;if (source[j]==43)+(source[j]==45) { j=j+1; }
                        if j<size { if digit(source[j]) { kind=5;i=j; while i<size { if digit(source[i])==0 { break; } i=i+1; } } }
                    } }
                    // 1.5, 2.0e-3: a float literal (token kind 5). `1..4` stays a range.
                    if i+1<size { if source[i]==46 { if digit(source[i+1]) {
                        kind=5;i=i+1;
                        while i<size { if digit(source[i])==0 { break; } i=i+1; }
                        if i+1<size { if (source[i]==101)+(source[i]==69) {
                            mut j=i+1;if (source[j]==43)+(source[j]==45) { j=j+1; }
                            if j<size { if digit(source[j]) { i=j; while i<size { if digit(source[i])==0 { break; } i=i+1; } } }
                        } }
                    } } }
                } else {
                    if i+1<size { kind=pair_kind(c,source[i+1]); }
                    // x!==y is postfix unwrap followed by ==, not != followed by =.
                    if (kind==259)&(i+2<size) { if source[i+2]==61 { kind=0; } }
                    if kind!=0 { i=i+2;if kind==267{if i<size{if source[i]==61{kind=268;i=i+1;}}} } else {
                        assert(punctuation(c));
                        kind=c;
                        i=i+1;
                    }
                }
            }
        }
        }
        tokens.push(Token{kind:kind,span:source[start:i],start:start,end:i});
    }
    tokens.push(Token{kind:0,span:source[size:size],start:size,end:size});
    return tokens;
}
