module elf;

// An ELF64 relocatable object, little-endian, as the internal assemblers write it
// (docs/design/compile-speed.md, stage 4). The caller hands over the finished content: sections in
// the order they were created, their relocations, and the symbol table already in output order
// (locals first). This module only lays the file out.
//
// The layout follows LLVM's object writer, so an object written here and clang's object from the
// same assembly can be compared section by section: the section header table is
// [null, .strtab, each content section followed by its .rela section, .symtab], one string table
// holds the section and the symbol names, and the file carries the content sections, then .symtab,
// then the relocation sections, then .strtab, then the section headers.

pub struct Obj {
    machine: u64,
    // e_flags (RISC-V: the float ABI).
    flags: u64,
    sec_name: u8[][],
    sec_type: u64[],
    sec_flags: u64[],
    sec_align: u64[],
    sec_data: u8[][],
    // The size of a section with no file content (SHT_NOBITS); the others use their data's length.
    sec_size: u64[],
    // The entry size (1 for a string table that may be merged, `.debug_line_str`), else 0.
    sec_entsize: u64[],
    // Relocations: the content section they patch, the offset, the ELF type, the index of the symbol
    // in `sym_*` (0 is the null symbol) and the addend. Each section's relocations are in offset
    // order.
    r_sec: u64[],
    r_off: u64[],
    r_type: u64[],
    r_sym: u64[],
    r_add: u64[],
    // Symbols after the null one, in output order. `sym_sec` is the content section's index plus 1,
    // 0 for undefined and `abs` for an absolute value.
    sym_name: u8[][],
    sym_info: u64[],
    // st_other: the visibility (1 internal, 2 hidden, 3 protected).
    sym_other: u64[],
    sym_sec: u64[],
    sym_value: u64[],
    sym_size: u64[],
    nlocal: u64
}

pub fn abs() -> u64 {
    return 0xfff1;
}

// A common symbol's section index (`.comm`): its value is the alignment, its size the size.
pub fn common() -> u64 {
    return 0xfff2;
}

pub fn new(machine: u64) -> Obj {
    return Obj {
        machine: machine,
        flags: 0,
        sec_name: u8[][],
        sec_type: u64[],
        sec_flags: u64[],
        sec_align: u64[],
        sec_data: u8[][],
        sec_size: u64[],
        sec_entsize: u64[],
        r_sec: u64[],
        r_off: u64[],
        r_type: u64[],
        r_sym: u64[],
        r_add: u64[],
        sym_name: u8[][],
        sym_info: u64[],
        sym_other: u64[],
        sym_sec: u64[],
        sym_value: u64[],
        sym_size: u64[],
        nlocal: 0
    };
}

fn w8<a>(out: (&a mut u8[]), v: u64) {
    out.push(v & 255);
}
fn w16<a>(out: (&a mut u8[]), v: u64) {
    out.push(v & 255);
    out.push((v >> 8) & 255);
}
fn w32<a>(out: (&a mut u8[]), v: u64) {
    out.push(v & 255);
    out.push((v >> 8) & 255);
    out.push((v >> 16) & 255);
    out.push((v >> 24) & 255);
}
fn w64<a>(out: (&a mut u8[]), v: u64) {
    w32(&mut out, v & 0xffffffff);
    w32(&mut out, v >> 32);
}
fn pad<a>(out: (&a mut u8[]), align: u64) {
    if align > 1 {
        while out.len() % align != 0 {
            out.push(0);
        }
    }
}
fn name<a, b>(strtab: (&a mut u8[]), text: &b [u8]) -> u64 {
    at := strtab.len();
    strtab.append(text);
    strtab.push(0);
    return at;
}

pub fn write<a>(o: (&a Obj)) -> u8[] {
    n := o.sec_name.len();
    // Which content sections have relocations, and the header index of every section.
    mut nrel = u64[];
    for k in n {
        nrel.push(0);
    }
    for i in o.r_sec.len() {
        nrel[o.r_sec[i]] = nrel[o.r_sec[i]] + 1;
    }
    mut index = u64[];
    mut rindex = u64[];
    mut next = 2;
    for k in n {
        index.push(next);
        next += 1;
        if nrel[k] != 0 {
            rindex.push(next);
            next += 1;
        } else {
            rindex.push(0);
        }
    }
    symtab_index := next;
    shnum := next + 1;
    // The string table: section names (".rela" + the name for a relocation section, as LLVM spells
    // it, so `grail_sites` gets `.relagrail_sites`), then symbol names.
    mut strtab = u8[];
    strtab.push(0);
    strtab_name := name(&mut strtab, view(".strtab"));
    symtab_name := name(&mut strtab, view(".symtab"));
    mut sname = u64[];
    mut rname = u64[];
    for k in n {
        sname.push(name(&mut strtab, view(o.sec_name[k])));
        if nrel[k] != 0 {
            mut rn = u8[];
            rn.append(view(".rela"));
            rn.append(view(o.sec_name[k]));
            rname.push(name(&mut strtab, view(rn)));
        } else {
            rname.push(0);
        }
    }
    mut symname = u64[];
    for i in o.sym_name.len() {
        symname.push(name(&mut strtab, view(o.sym_name[i])));
    }
    // The file: header, content sections, .symtab, relocation sections, .strtab, headers.
    mut out = u8[];
    for i in 64 {
        out.push(0);
    }
    mut off = u64[];
    for k in n {
        pad(&mut out, o.sec_align[k]);
        off.push(out.len());
        if o.sec_type[k] != 8 {
            out.append(view(o.sec_data[k]));
        }
    }
    pad(&mut out, 8);
    symtab_off := out.len();
    for i in 24 {
        out.push(0);
    }
    for i in o.sym_name.len() {
        w32(&mut out, symname[i]);
        w8(&mut out, o.sym_info[i]);
        w8(&mut out, o.sym_other[i]);
        s := o.sym_sec[i];
        if s == 0 {
            w16(&mut out, 0);
        } else if (s == abs()) || (s == common()) {
            w16(&mut out, s);
        } else {
            w16(&mut out, index[s - 1]);
        }
        w64(&mut out, o.sym_value[i]);
        w64(&mut out, o.sym_size[i]);
    }
    symtab_size := out.len() - symtab_off;
    // Relocations are grouped by section; within one, the caller's order is kept.
    mut first = u64[];
    mut at = 0;
    for k in n {
        first.push(at);
        at += nrel[k];
    }
    mut order = u64[];
    for i in o.r_sec.len() {
        order.push(0);
    }
    mut fill = first.copy();
    for i in o.r_sec.len() {
        k := o.r_sec[i];
        order[fill[k]] = i;
        fill[k] = fill[k] + 1;
    }
    mut roff = u64[];
    for k in n {
        roff.push(out.len());
        mut j = first[k];
        while j < first[k] + nrel[k] {
            i := order[j];
            w64(&mut out, o.r_off[i]);
            w64(&mut out, (o.r_sym[i] << 32) | o.r_type[i]);
            w64(&mut out, o.r_add[i]);
            j += 1;
        }
    }
    strtab_off := out.len();
    out.append(view(strtab));
    pad(&mut out, 8);
    shoff := out.len();
    // Section headers.
    for i in 64 {
        out.push(0);
    }
    header(&mut out, strtab_name, 3, 0, strtab_off, strtab.len(), 0, 0, 1, 0);
    for k in n {
        mut size = o.sec_size[k];
        if o.sec_type[k] != 8 {
            size = o.sec_data[k].len();
        }
        header(&mut out, sname[k], o.sec_type[k], o.sec_flags[k], off[k], size, 0, 0, o.sec_align[k], o.sec_entsize[k]);
        if nrel[k] != 0 {
            header(&mut out, rname[k], 4, 0x40, roff[k], nrel[k] * 24, symtab_index, index[k], 8, 24);
        }
    }
    header(&mut out, symtab_name, 2, 0, symtab_off, symtab_size, 1, o.nlocal + 1, 8, 24);
    // The ELF header, now that every offset is known.
    mut h = u8[];
    h.push(0x7f);
    h.push('E');
    h.push('L');
    h.push('F');
    h.push(2);
    h.push(1);
    h.push(1);
    for i in 9 {
        h.push(0);
    }
    w16(&mut h, 1);
    w16(&mut h, o.machine);
    w32(&mut h, 1);
    w64(&mut h, 0);
    w64(&mut h, 0);
    w64(&mut h, shoff);
    w32(&mut h, o.flags);
    w16(&mut h, 64);
    w16(&mut h, 0);
    w16(&mut h, 0);
    w16(&mut h, 64);
    w16(&mut h, shnum);
    w16(&mut h, 1);
    for i in 64 {
        out[i] = h[i];
    }
    return out;
}

fn header<a>(out: (&a mut u8[]), nm: u64, ty: u64, flags: u64, off: u64, size: u64, link: u64, info: u64, align: u64, entsize: u64) {
    w32(&mut out, nm);
    w32(&mut out, ty);
    w64(&mut out, flags);
    w64(&mut out, 0);
    w64(&mut out, off);
    w64(&mut out, size);
    w32(&mut out, link);
    w32(&mut out, info);
    w64(&mut out, align);
    w64(&mut out, entsize);
}
