 if k==1{let line=imm(borrow_mut(c),newline);invoke(borrow_mut(c),read("rt_print_number"),two(value.t,line));}
 else{
 if (k!=3)&(k!=4)&(k!=5){fail(borrow_mut(c),read("print requires num, string, bytes or a byte view"));}
 let ty=intern_full(borrow_mut(c),5,0,0,vec<num>());let slot=apply(borrow_mut(c),read("rt_view"),one(value.t));own(borrow_mut(c),slot,ty);view_bonds(borrow_mut(c),slot,value.t,0);move_out(borrow_mut(c),val(slot,ty));invoke(borrow_mut(c),read("f_host_print"),one(slot));close_loans(borrow_mut(c));release_temporary(borrow_mut(c),original);
 if newline{invoke(borrow_mut(c),read("rt_print_newline"),vec<num>());}
 }
 return val(imm(borrow_mut(c),0),1);
}
fn builtin<a>(c:ref_mut<a,C>,id:num)->Val {
