    if same(view(first), view("Ok")) & same(view(last), view("Err")) {
        valid = 1;
    }
    if same(view(first), view("Some")) & same(view(last), view("None")) {
        valid = 1;
    }
    if same(view(last), view("Ok")) & same(view(first), view("Err")) {
        valid = 1;
        k = 1;
    }
    if same(view(last), view("Some")) & same(view(first), view("None")) {
        valid = 1;
        k = 1;
