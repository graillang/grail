// Checked emission for parsed calls and compiler-prepared collection operations.
fn emit_resolved_call<a>(
    c: (&a mut C),
    index: u64,
    map: u64[],
    args: u64[],
    argtypes: u64[],
    sources: u64[]
) -> Val {
    mut f = index;
    info := &c.funcs[f - 1];
    template_ret := info.ret;
    count := info.count;
    template_first := info.first;
    types := info.types;
    contract := info.contract;
    m := info.module.copy();
    name := info.name.copy();
    ext := info.ext;
    ffi_symbol := info.symbol.copy();
    bounds := function_bounds(&c, f - 1);
    require_constraints(&mut c, &map, &bounds);
    requirements := function_constraints(&c, f - 1);
    require_interfaces(&mut c, &map, &requirements);
    // Inference binds types; it does not authorize erasing callable lifetime contracts.
    if c.raw == 0 {
        for i in count {
            formal := c.params[template_first + i];
            mut expected = formal;
            if types != 0 {
                expected = bind_types(&mut c, formal, &map);
            }
            actual := argtypes[i];
            require_type(&mut c, actual, expected);
        }
