fn bind_loan<a>(c:ref_mut<a,C>,value:num,source:num,target:num,mode:num)->unit {
 if c.raw{return ();}if target==0{fail(borrow_mut(c),read("borrow target is not tracked"));}
 var authority=authority_of(borrow_mut(c),source);source_id :=resource(borrow_mut(c),source);if source_id!=0{var r =vec_get(c.resources,source_id-1);ty :=r.ty;if ty_kind(borrow_mut(c),ty)==7{authority=source+1;}}var loan=0;
 if authority!=0{
 if mode{var r =resource(borrow_mut(c),authority-1);info :=vec_get(c.resources,r-1);ty :=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),read("mutable borrow through readonly frame"));}}
 parent :=authority_loan(borrow_mut(c),authority,target);if parent==0{fail(borrow_mut(c),read("reference has no access authority"));}
 loan=ownership::reborrow_place(borrow_mut(c.check),parent,target,mode);
