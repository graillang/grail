fn is_bool<a>(c: (&a mut C), ty: u64) -> bool {
    return ty_kind(&mut c, ty) == 19;
}
// Copy scalars: u64, sized integers and bool are loaded by value from collections.
fn scalar<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
