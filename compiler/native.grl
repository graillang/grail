        if x86 {
            o(&mut c, view("addq $"));
            on(&mut c, area);
            o(&mut c, view(",%rsp\n"));
        } else {
            o(&mut c, view("cunstack "));
            on(&mut c, area);
            c.out.push(10);
        }
