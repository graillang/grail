    oldc := c.cont;
    oldmark := c.loopmark;
    oldstart := c.loop_start;
    oldend := c.loop_end;
    exchange(&mut c.loop_start, c.pos);
    exchange(&mut c.loop_end, loopend);
    loopmark := c.resources.len();
    exchange(&mut c.loopmark, loopmark);
    oldloop := exchange(&mut c.loopcheck, ownership::snapshot(&c.check));
    oldbreak := exchange(&mut c.breaks, ownership::new());
    oldhas := c.hasbreak;
    exchange(&mut c.hasbreak, 0);
    exchange(&mut c.brk, end);
    exchange(&mut c.cont, step);
    mark(&mut c, head);
    get(&mut c, e, view("%rcx"));
    get(&mut c, i, view("%rax"));
    o(&mut c, view("cmpq %rcx,%rax\n"));
