fn view_bonds<a>(c:ref_mut<a,C>,slot:num,source:num,mode:num)->unit {
 if c.raw{return ();}root :=place_of(borrow_mut(c),source);holder :=place_of(borrow_mut(c),slot);
 if root==0{fail(borrow_mut(c),read("view source is not tracked"));}
 source_index :=resource(borrow_mut(c),source);var r =vec_get(c.resources,source_index-1);ty :=r.ty;
 if ty_kind(borrow_mut(c),ty)==5{
 if mode{index :=resource(borrow_mut(c),source);var r =vec_get(c.resources,index-1);base :=r.base;authority :=r.authority;
