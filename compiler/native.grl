                next = text[i + 1];
            }
            if (b == 123) & (next == 123) {
                piece.push(123);
                i += 2;
                continue;
            }
            if (b == 125) & (next == 125) {
                piece.push(125);
                i += 2;
                continue;
            }
            if (b == 123) & (next == 58) {
                // {:[fill][<^>][0][width][.precision]} (precision: f64 decimals, rounded half to even like Rust).
                sp := parse_spec(&mut c, view(text), i);
                print_raw(&mut c, view(piece));
                piece = u8[];
                end := sp.end;
                acc := invoke(&mut c, view("rt_new"), u64[]);
                format_spec_arg(&mut c, acc, sp);
                zero := imm(&mut c, 0);
                invoke(&mut c, view("rt_print_acc"), two(acc, zero));
                i = end;
                continue;
            }
            if (b == 123) & (next == 125) {
                print_raw(&mut c, view(piece));
                piece = u8[];
                if !eat(&mut c, view(",")) {
                    fail(&mut c, view("missing argument for {} in format string"));
                }
                value := expr(&mut c, 0);
                print_value(&mut c, value, 0);
                i += 2;
                continue;
            }
            if (b == 123) || (b == 125) {
                format_brace_refuse(&mut c, view(text), i);
            }
            piece.push(b);
            i += 1;
        }
        print_raw(&mut c, view(piece));
        if is(&mut c, view(",")) {
            fail(&mut c, view("more arguments than {} placeholders in format string"));
        }
        expect(&mut c, view(")"));
        if newline != 0 {
            invoke(&mut c, view("rt_print_newline"), u64[]);
        }
        return val(imm(&mut c, 0), 1);
    }
    // `println("{n}")`: a lone literal is printed as it is written, so a name in braces prints the
    // braces - which is never what was meant when that name is a binding in scope.
    if (kind(&mut c) == 3) & (next_kind(&mut c) == 41) {
        lone := decode_literal(&mut c, c.pos);
        for i in lone.len() {
            if lone[i] == 123 {
                inside := brace_name(view(lone), i);
                if (inside.len() != 0) && (find_local(&mut c, view(inside)) != 0) {
                    format_name_refuse(&mut c, view(inside));
                }
            }
        }
    }
    input := expr(&mut c, 0);
    expect(&mut c, view(")"));
    print_value(&mut c, input, newline);
    return val(imm(&mut c, 0), 1);
}
// The name inside `{name}` at `at`, or empty when the braces there do not hold exactly a name.
fn brace_name<a>(text: &a [u8], at: u64) -> u8[] {
    mut out = u8[];
    mut i = at + 1;
    while i < text.len() {
        b := text[i];
        if b == 125 {
            return out;
        }
        letter := ((64 < b) && (b < 91)) || ((96 < b) && (b < 123)) || (b == 95);
        digit := (47 < b) && (b < 58);
        if !(letter || (digit && (out.len() != 0))) {
            return u8[];
        }
        out.push(b);
        i += 1;
    }
    return u8[];
}
// `{n}` where a placeholder was meant: Grail's placeholder is `{}` and takes its value from the
// argument list.
fn format_name_refuse<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    mut msg = copy_bytes(view("`{"));
    push_bytes(&mut msg, name);
    push_bytes(&mut msg, view("}` is not a placeholder: write `{}` and pass `"));
    push_bytes(&mut msg, name);
    push_bytes(&mut msg, view("` as an argument"));
    diag_help(&mut c, view("to print the braces themselves, write `{{` and `}}` in a string that has arguments, or pass the text as one (`println(\"{}\", \"{n}\")`)"));
    fail(&mut c, view(msg));
    return ();
}
// A brace in a format string that opens no placeholder.
fn format_brace_refuse<a, b>(c: (&a mut C), text: &b [u8], at: u64) -> unit {
    if text[at] == 123 {
        inside := brace_name(text, at);
        if inside.len() != 0 {
            format_name_refuse(&mut c, view(inside));
        }
    }
    fail(&mut c, view("unmatched brace in format string (use {{ or }})"));
    return ();
}
// format("x = {}", x) -> string, with the same compile-time placeholder checks as print.
fn format_builtin<a>(c: (&a mut C)) -> Val {
    expect(&mut c, view("("));
    acc := invoke(&mut c, view("rt_new"), u64[]);
    // The buffer becomes the string itself; it is checked to be UTF-8 only when an argument may
    // have written bytes that are not.
    raw := format_pieces(&mut c, acc);
    if raw {
        invoke(&mut c, view("rt_utf8"), one(acc));
    }
    return own(&mut c, acc, 3);
}
// The literal and its arguments up to the closing `)`, appended to the byte buffer `acc`: what
// `format(...)` builds into a fresh buffer and `out.append_format(...)` into `out`. True when an
// argument may have written bytes that are not UTF-8 (a byte vector, a view, a record or vector
// shown through its fields, a padded spec); numbers, bools, chars and strings never do.
fn format_pieces<a>(c: (&a mut C), acc: u64) -> bool {
    mut raw = false;
    if kind(&mut c) != 3 {
        fail(&mut c, view("format needs a string literal"));
    }
    text := decode_literal(&mut c, c.pos);
    advance(&mut c);
    mut piece = u8[];
    mut i = 0;
    while i < text.len() {
        b := text[i];
        mut next = 0;
        if i + 1 < text.len() {
            next = text[i + 1];
        }
        if (b == 123) & (next == 123) {
            piece.push(123);
            i += 2;
            continue;
        }
        if (b == 125) & (next == 125) {
            piece.push(125);
            i += 2;
            continue;
        }
        if (b == 123) & (next == 58) {
            sp := parse_spec(&mut c, view(text), i);
            format_raw(&mut c, acc, view(piece));
            piece = u8[];
            end := sp.end;
            format_spec_arg(&mut c, acc, sp);
            raw = true;
            i = end;
            continue;
        }
        if (b == 123) & (next == 125) {
            format_raw(&mut c, acc, view(piece));
            piece = u8[];
            if !eat(&mut c, view(",")) {
                fail(&mut c, view("missing argument for {} in format string"));
            }
            input := expr(&mut c, 0);
            ak := ty_kind(&mut c, input.ty);
            if !((input.ty == 0) || (ak == 1) || (ak == 4) || (ak == 18) || (ak == 19) || (ak == 21) || (ak == 22)) {
                raw = true;
            }
            format_arg(&mut c, acc, input);
            i += 2;
            continue;
        }
        if (b == 123) || (b == 125) {
            format_brace_refuse(&mut c, view(text), i);
        }
        piece.push(b);
        i += 1;
    }
    format_raw(&mut c, acc, view(piece));
    if is(&mut c, view(",")) {
        fail(&mut c, view("more arguments than {} placeholders in format string"));
    }
    expect(&mut c, view(")"));
    return raw;
}
fn format_raw<a, b>(c: (&a mut C), acc: u64, piece: &b [u8]) -> unit {
    if piece.len() == 0 {
        return ();
    }
    l := label(&mut c);
    rodata(&mut c);
    mark(&mut c, l);
    for i in piece.len() {
        o(&mut c, view(".byte "));
        on(&mut c, piece[i]);
        c.out.push(10);
    }
    o(&mut c, view(".popsection\nleaq "));
    lname(&mut c, l);
    o(&mut c, view("(%rip),%rax\n"));
    ptr := save(&mut c);
    n := imm(&mut c, piece.len());
    invoke(&mut c, view("rt_fmt_raw"), three(acc, ptr, n));
    return ();
}
// A value with no text form, named: the refusal used to list the types that print and leave the
// reader to work out which one this was not.
fn print_refuse<a>(c: (&a mut C), ty: u64) -> unit {
    mut msg = copy_bytes(view("`"));
    push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
    push_bytes(&mut msg, view("` has no text form"));
    if ty_kind(&mut c, ty) == 8 {
        diag_help(&mut c, view("give the type a `show` method (`fn show(self: &T) -> string`); a record whose fields all print gets one by default"));
    } else {
        diag_help(&mut c, view("numbers, bool, char, text, byte views, vectors of those and records of those print as they are"));
    }
    fail(&mut c, view(msg));
    return ();
}
// The default text of a record that has no `show`: its name and its fields in declaration order,
// `Point { x: 1, y: 2 }`, and `(1, "a")` for a tuple. Each field is written the way a vector
// element is (text in quotes, nested vectors and records inside), or through its own `show`. False
// when the type has no such form - an enum, an extern record, or a field of a type with none - and
// then the caller's own refusal stands.
fn record_text<a>(c: (&a mut C), acc: u64, value: u64, ty: u64, depth: u64) -> bool {
    if is_array(&mut c, ty) & (depth <= 8) {
        if !record_text_ok(&mut c, ty, depth) {
            return false;
        }
        array_text(&mut c, acc, value, base_type(&mut c, ty), depth);
        return true;
    }
    if (ty_kind(&mut c, ty) != 8) || (depth > 8) {
        return false;
    }
    d := ty_arg(&mut c, ty);
    if (c.decls[d].is_enum != 0) || (c.decls[d].opaque != 0) || (c.decls[d].c_layout != 0) {
        return false;
    }
    count := c.decls[d].count;
    first := c.decls[d].first;
    tuple := same(view(c.decls[d].module), view(".tuple"));
    // Every field is checked before anything is emitted, so a refusal leaves no half-built text.
    for i in count {
        fty := field_type(&mut c, ty, i);
        if (element_code(&mut c, fty) == 0) && !record_text_ok(&mut c, fty, depth + 1) {
            return false;
        }
    }
    if tuple {
        format_raw(&mut c, acc, view("("));
    } else {
        mut head = c.decls[d].name.copy();
        if count == 0 {
            format_raw(&mut c, acc, view(head));
            return true;
        }
        push_bytes(&mut head, view(" { "));
        format_raw(&mut c, acc, view(head));
    }
    for i in count {
        if i != 0 {
            format_raw(&mut c, acc, view(", "));
        }
        if !tuple {
            mut label_text = c.fields[first + i].name.copy();
            push_bytes(&mut label_text, view(": "));
            format_raw(&mut c, acc, view(label_text));
        }
        fty := field_type(&mut c, ty, i);
        part := field_load(&mut c, value, ty, i, 0);
        code := element_code(&mut c, fty);
        if code != 0 {
            cv := imm(&mut c, code);
            invoke(&mut c, view("rt_fmt_value"), three(acc, part, cv));
        } else {
            record_text(&mut c, acc, part, fty, depth + 1);
        }
    }
    if tuple {
        format_raw(&mut c, acc, view(")"));
    } else {
        format_raw(&mut c, acc, view(" }"));
    }
    return true;
}
// Whether `record_text` has a form for `ty` (the same walk, emitting nothing).
fn record_text_ok<a>(c: (&a mut C), ty: u64, depth: u64) -> bool {
    if is_array(&mut c, ty) & (depth <= 8) {
        elem := array_elem(&mut c, ty);
        return (element_code(&mut c, elem) != 0) || record_text_ok(&mut c, elem, depth + 1);
    }
    if (ty_kind(&mut c, ty) != 8) || (depth > 8) {
        return false;
    }
    d := ty_arg(&mut c, ty);
    if (c.decls[d].is_enum != 0) || (c.decls[d].opaque != 0) || (c.decls[d].c_layout != 0) {
        return false;
    }
    count := c.decls[d].count;
    for i in count {
        fty := field_type(&mut c, ty, i);
        if (element_code(&mut c, fty) == 0) && !record_text_ok(&mut c, fty, depth + 1) {
            return false;
        }
    }
    return true;
}
// Element format codes for printing vectors: 1 u64, 2 bool, 3 f64, 4 text/bytes, 5 nested vector,
// 256+ sized integer (int_code); 0 means not printable.
fn element_code<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(&mut c, ty);
    if ty == 0 {
        return 1;
    }
    if k == 19 {
        return 2;
    }
    if k == 21 {
        if is_f32(&mut c, ty) {
            return 7;
        }
        return 3;
    }
    if k == 22 {
        return 6;
    }
    if (k == 3) || (k == 4) || (k == 5) {
        return 4;
    }
    if k == 18 {
        return 1024 + int_code(&mut c, ty);
    }
    if (k == 6) || (k == 27) {
        inner := ty_arg(&mut c, ty);
        sub := element_code(&mut c, inner);
        if sub == 0 {
            return 0;
        }
        if narrow_code(&mut c, inner) != 0 {
            // 4-byte elements (f32[], u32[], i32[]).
            return 4096 * sub + 8;
        }
        return 4096 * sub + 5;
    }
    return 0;
}
fn format_arg<a>(c: (&a mut C), acc: u64, input: Val) -> bool {
    original := input.t;
    inty := input.ty;
    value := deref(&mut c, input);
    mut k = ty_kind(&mut c, value.ty);
    observe(&mut c, value.t);
    kind0 := k;
    shown := show_value(&mut c, original, inty, value.ty);
    if shown.ty != NO_TYPE {
        invoke(&mut c, view("rt_fmt_seq"), two(acc, shown.t));
        release_temporary(&mut c, shown.t);
        k = 0;
    }
    if k == 21 {
        mut f = "rt_fmt_f64";
        if is_f32(&mut c, value.ty) {
            f = "rt_fmt_f32";
        }
        invoke(&mut c, view(f), two(acc, value.t));
        k = 0;
    }
    if k == 22 {
        invoke(&mut c, view("rt_push_utf8"), two(acc, value.t));
        k = 0;
    }
    if (k == 6) || (k == 27) {
        code := element_code(&mut c, value.ty);
        if code == 0 {
            fail(
                &mut c,
                view("format arguments must be u64, sized integers, bool, text, byte views or have show()")
            );
        }
        cv := imm(&mut c, code);
        invoke(&mut c, view("rt_fmt_value"), three(acc, value.t, cv));
        k = 0;
    }
    if k == 1 {
        invoke(&mut c, view("rt_fmt_num"), two(acc, value.t));
    } else {
        if k == 19 {
            invoke(&mut c, view("rt_fmt_bool"), two(acc, value.t));
        } else {
            if k == 18 {
                code := int_code(&mut c, value.ty);
                cv := imm(&mut c, code);
                invoke(&mut c, view("rt_fmt_int"), three(acc, value.t, cv));
            } else {
                if (k == 3) || (k == 4) || (k == 5) {
                    invoke(&mut c, view("rt_fmt_seq"), two(acc, value.t));
                } else {
                    if k != 0 {
                        if !record_text(&mut c, acc, value.t, value.ty, 0) {
                            print_refuse(&mut c, value.ty);
                        }
                    }
                }
            }
        }
    }
    release_temporary(&mut c, original);
    return (kind0 == 1) || (kind0 == 18) || (kind0 == 21);
}
struct FormatSpec {
    precision: u64,
    width: u64,
    align: u64,
    zero: u64,
    fill: u64,
    end: u64
}
// {:[fill][<^>][0][width][.precision]} ; precision 18446744073709551615 = none.
fn parse_spec<a, b>(c: (&a mut C), text: &b [u8], start: u64) -> FormatSpec {
    mut i = start + 2;
    mut sp = FormatSpec {
        precision: 18446744073709551615,
        width: 0,
        align: 0,
        zero: 0,
        fill: 32,
        end: 0,
    };
    if i + 1 < text.len() {
        x := text[i + 1];
        if (x == 60) || (x == 62) || (x == 94) {
            if text[i] != 125 {
                sp.fill = text[i];
                i += 1;
            }
        }
    }
    if i < text.len() {
        x := text[i];
        if x == 60 {
            sp.align = 1;
            i += 1;
        } else {
            if x == 62 {
                sp.align = 2;
                i += 1;
            } else {
                if x == 94 {
                    sp.align = 3;
                    i += 1;
                }
            }
        }
    }
    if i < text.len() {
        if text[i] == 48 {
            sp.zero = 1;
            i += 1;
        }
    }
    while i < text.len() {
        d := text[i];
        if (d < 48) || (57 < d) {
            break;
        }
        sp.width = sp.width * 10 + d - 48;
        if 1000 < sp.width {
            fail(&mut c, view("format width too large"));
        }
        i += 1;
    }
    if i < text.len() {
        if text[i] == 46 {
            i += 1;
            mut n = 0;
            mut any = 0;
            while i < text.len() {
                d := text[i];
                if (d < 48) || (57 < d) {
                    break;
                }
                n = n * 10 + d - 48;
                any = 1;
                if 300 < n {
                    fail(&mut c, view("format precision too large"));
                }
                i += 1;
            }
            if any == 0 {
                fail(&mut c, view("bad format spec (expected {:.N})"));
            }
            sp.precision = n;
        }
    }
    if !(i < text.len()) {
        fail(&mut c, view("bad format spec (expected {:[fill][<^>][0][width][.precision]})"));
    }
    if text[i] != 125 {
        fail(&mut c, view("bad format spec (expected {:[fill][<^>][0][width][.precision]})"));
    }
    sp.end = i + 1;
    return sp;
}
// Formats the next argument per spec and appends it (padded) to acc.
fn format_spec_arg<a>(c: (&a mut C), acc: u64, sp: FormatSpec) -> unit {
    if !eat(&mut c, view(",")) {
        fail(&mut c, view("missing argument for {} in format string"));
    }
    value := expr(&mut c, 0);
    tmp := invoke(&mut c, view("rt_new"), u64[]);
    mut numeric = true;
    if sp.precision != 18446744073709551615 {
        if !is_float(&mut c, value.ty) {
            fail(&mut c, view("{:.N} needs an f64 argument"));
        }
        dv := imm(&mut c, sp.precision);
        invoke(&mut c, view("rt_fmt_f64_fixed"), three(tmp, value.t, dv));
    } else {
        numeric = format_arg(&mut c, tmp, value);
    }
    mut align = sp.align;
    if align == 0 {
        if numeric {
            align = 2;
        } else {
            align = 1;
        }
    }
    mut args = u64[];
    args.push(acc);
    args.push(tmp);
    w := imm(&mut c, sp.width);
    args.push(w);
    al := imm(&mut c, align);
    args.push(al);
    z := imm(&mut c, sp.zero & u64(numeric));
    args.push(z);
    f := imm(&mut c, sp.fill);
    args.push(f);
    invoke(&mut c, view("rt_fmt_pad"), args);
    return ();
}
fn is_hex_digit(d: u64) -> bool {
    return ((47 < d) && (d < 58)) || ((64 < d) && (d < 71)) || ((96 < d) && (d < 103));
}
// The bytes of a string literal with its escapes decoded. Accepted escapes: \n \r \t \0 \\
// \" \' , \xHH (two hex digits, at most 7F, so the text stays valid UTF-8) and \u{H...} (a
// Unicode scalar value, 1-6 hex digits with optional _ separators, encoded as UTF-8). Any other
// escape is a compile error rather than being kept as literal text.
fn decode_literal<a>(c: (&a mut C), p: u64) -> u8[] {
    t := &c.toks[p];
    st := t.start;
    en := t.end;
    mut out = u8[];
    mut i = st + 1;
    while i < en - 1 {
        b := c.src[i];
        if b != 92 {
            out.push(b);
            i = i + 1;
            continue;
        }
        i = i + 1;
        e := c.src[i];
        mut done = 0;
        if e == 110 {
            out.push(10);
            done = 1;
        }
        if e == 114 {
            out.push(13);
            done = 1;
        }
        if e == 116 {
            out.push(9);
            done = 1;
        }
        if e == 48 {
            out.push(0);
            done = 1;
        }
        if (e == 92) || (e == 34) || (e == 39) {
            out.push(e);
            done = 1;
        }
        if e == 120 {
            if i + 2 >= en - 1 || !is_hex_digit(c.src[i + 1]) || !is_hex_digit(c.src[i + 2]) {
                fail(&mut c, view("\\x escape needs two hex digits"));
            }
            v := hex(c.src[i + 1]) * 16 + hex(c.src[i + 2]);
            if 127 < v {
                fail(&mut c, view("\\x escape above \\x7F would make invalid UTF-8; use \\u{...}"));
            }
            out.push(v);
            i = i + 2;
            done = 1;
        }
        if e == 117 {
            if c.src[i + 1] != 123 {
                fail(&mut c, view("\\u escape needs braces: \\u{...}"));
            }
            mut j = i + 2;
            mut v = 0;
            mut digits = 0;
            while (j < en - 1) & (c.src[j] != 125) {
                d := c.src[j];
                if d != 95 {
                    if !is_hex_digit(d) {
                        fail(&mut c, view("invalid hex digit in \\u{...} escape"));
                    }
                    v = v * 16 + hex(d);
                    digits += 1;
                    if (6 < digits) || (1114111 < v) {
                        fail(&mut c, view("\\u{...} escape is above U+10FFFF"));
                    }
                }
                j += 1;
            }
            if (j >= en - 1) || (digits == 0) {
                fail(&mut c, view("unterminated or empty \\u{...} escape"));
            }
            if (55295 < v) & (v < 57344) {
                fail(&mut c, view("\\u{...} escape is a surrogate, not a Unicode scalar value"));
            }
            if v < 128 {
                out.push(v);
            } else {
                if v < 2048 {
                    out.push(192 | (v >> 6));
                    out.push(128 | (v & 63));
                } else {
                    if v < 65536 {
                        out.push(224 | (v >> 12));
                        out.push(128 | ((v >> 6) & 63));
                        out.push(128 | (v & 63));
                    } else {
                        out.push(240 | (v >> 18));
                        out.push(128 | ((v >> 12) & 63));
                        out.push(128 | ((v >> 6) & 63));
                        out.push(128 | (v & 63));
                    }
                }
            }
            i = j;
            done = 1;
        }
        if done == 0 {
            fail(&mut c, view("unknown escape in string literal"));
        }
        i = i + 1;
    }
    return out;
}
fn print_raw<a, b>(c: (&a mut C), piece: &b [u8]) -> unit {
    if piece.len() == 0 {
        return ();
    }
    l := label(&mut c);
    rodata(&mut c);
    mark(&mut c, l);
    for i in piece.len() {
        o(&mut c, view(".byte "));
        on(&mut c, piece[i]);
        c.out.push(10);
    }
    o(&mut c, view(".popsection\nleaq "));
    lname(&mut c, l);
    o(&mut c, view("(%rip),%rax\n"));
    ptr := save(&mut c);
    n := imm(&mut c, piece.len());
    invoke(&mut c, view("rt_print_raw"), two(ptr, n));
    return ();
}
fn print_value<a>(c: (&a mut C), input: Val, newline: u64) -> unit {
    original := input.t;
    inty := input.ty;
    value := deref(&mut c, input);
    k := ty_kind(&mut c, value.ty);
    observe(&mut c, value.t);
    shown := show_value(&mut c, original, inty, value.ty);
    if shown.ty != NO_TYPE {
        print_value(&mut c, shown, newline);
        return ();
    }
    if k == 21 {
        line := imm(&mut c, newline);
        mut f = "rt_print_f64";
        if is_f32(&mut c, value.ty) {
            f = "rt_print_f32";
        }
        invoke(&mut c, view(f), two(value.t, line));
        release_temporary(&mut c, original);
        return ();
    }
    if k == 22 {
        line := imm(&mut c, newline);
        invoke(&mut c, view("rt_print_char"), two(value.t, line));
        release_temporary(&mut c, original);
        return ();
    }
    if (k == 6) || (k == 27) {
        code := element_code(&mut c, value.ty);
        if code == 0 {
            fail(&mut c, view("print requires vector elements that can be printed"));
        }
        acc := invoke(&mut c, view("rt_new"), u64[]);
        cv := imm(&mut c, code);
        invoke(&mut c, view("rt_fmt_value"), three(acc, value.t, cv));
        line := imm(&mut c, newline);
        invoke(&mut c, view("rt_print_acc"), two(acc, line));
        release_temporary(&mut c, original);
        return ();
    }
    if k == 1 {
        mut line = imm(&mut c, newline);
        invoke(&mut c, view("rt_print_number"), two(value.t, line));
    } else {
        if k == 19 {
            mut line = imm(&mut c, newline);
            invoke(&mut c, view("rt_print_bool"), two(value.t, line));
        } else {
            if k == 18 {
                mut line = imm(&mut c, newline);
                code := int_code(&mut c, value.ty);
                cv := imm(&mut c, code);
                invoke(&mut c, view("rt_print_int"), three(value.t, line, cv));
            } else {
                if (k != 3) & (k != 4) & (k != 5) {
                    if record_text_ok(&mut c, value.ty, 0) {
                        acc := invoke(&mut c, view("rt_new"), u64[]);
                        record_text(&mut c, acc, value.t, value.ty, 0);
                        line := imm(&mut c, newline);
                        invoke(&mut c, view("rt_print_acc"), two(acc, line));
                        release_temporary(&mut c, original);
                        return ();
                    }
                    print_refuse(&mut c, value.ty);
                }
                ty := intern_full(&mut c, 5, 0, 0, u64[]);
                slot := apply(&mut c, view("rt_view"), one(value.t));
                own(&mut c, slot, ty);
                view_bonds(&mut c, slot, value.t, 0, false);
                move_out(&mut c, val(slot, ty));
                invoke(&mut c, view("f_host_print"), one(slot));
                close_loans(&mut c);
                release_temporary(&mut c, original);
                if newline != 0 {
                    invoke(&mut c, view("rt_print_newline"), u64[]);
                }
            }
        }
    }
    return ();
}
// `exchange(&mut place, value)` is two-phase like an ordinary call: when the value argument names a
// place the written one overlaps, it is evaluated before the `&mut` is taken, so that read sees the
// value from before the swap (`exchange(&mut p, p + 1)` stores the old `p` plus one and returns the
// old `p`). Only a plain `&mut path` is deferred, exactly as for call arguments: the address of
// anything else was already computed where that reference was made. A sibling field does not make
// the value a reader of the place (`exchange(&mut c.f, c.g)` keeps the order it is written in), so
// every exchange that needs no temporary compiles as it did before. A value taken from the very
// place that is written is still refused - `exchange(&mut a, a)` names the same storage twice.
fn exchange_builtin<a>(c: (&a mut C)) -> Val {
    ranges := argument_ranges(&mut c);
    mut defer = false;
    if ranges.len() == 5 {
        path := mut_path(&mut c, &ranges, 0);
        if path.len() != 0 {
            if path_mentioned(&mut c, &ranges, 1, &path) {
                defer = true;
            }
        }
    }
    mut a = val(0, 0);
    mut b = val(0, 0);
    mut start = 0;
    mut end = 0;
    if defer {
        // The value argument first: its reads and loans end before the `&mut` starts.
        exchange(&mut c.pos, ranges[2]);
        start = c.pos;
        b = expr(&mut c, 0);
        end = c.pos;
        after := c.pos;
        exchange(&mut c.pos, ranges[0]);
        a = expr(&mut c, 0);
        observe(&mut c, a.t);
        exchange(&mut c.pos, after);
    } else {
        a = expr(&mut c, 0);
        observe(&mut c, a.t);
        expect(&mut c, view(","));
        start = c.pos;
        // The referent's type is the value's expected type: `exchange(&mut a, [0.0; 4])`.
        mut want = NO_TYPE;
        if (c.raw == 0) && (ty_kind(&mut c, a.ty) == 7) {
            want = ty_arg(&mut c, a.ty);
        }
        b = expr_expected(&mut c, 0, want);
        end = c.pos;
    }
    expect(&mut c, view(")"));
    if c.raw == 0 {
        if ty_kind(&mut c, a.ty) != 7 {
            fail(&mut c, view("exchange requires typed reference"));
        }
        expected := ty_arg(&mut c, a.ty);
        b = adopt_value(&mut c, b, start, end, expected);
        // The write would discard the value the argument named, so the place itself is refused.
        // (`exchange(&mut a, &mut a)` already fails while the second `&mut` is taken.)
        destination := target_of(&mut c, a.t);
        source := place_of(&mut c, b.t);
        if (source != 0) & (source == destination) {
            exchange(&mut c.pos, start);
            fail(&mut c, view("exchange cannot take its new value from the place it replaces"));
        }
    }
    return exchange_into(&mut c, a, b);
}
// Stores b through the mutable reference a and returns the previous (owned) value.
fn exchange_into<a>(c: (&a mut C), a: Val, b: Val) -> Val {
    ty := ty_arg(&mut c, a.ty);
    if c.raw == 0 {
        require_type(&mut c, b.ty, ty);
        destination := target_of(&mut c, a.t);
        frame_storage(&mut c, a.t, destination);
        source := place_of(&mut c, b.t);
        check_writeback(&mut c, destination, ty, source);
    }
    require_write(&mut c, a.t);
    destination := target_of(&mut c, a.t);
    seed_storage(&mut c, destination, ty);
    if subword(&mut c, ty) {
        // A plain sub-word value, possibly in tagged narrow storage: read the old value, write the new.
        old := ref_load(&mut c, a.t, ty);
        ref_store(&mut c, a.t, ty, b.t);
        move_out(&mut c, val(b.t, b.ty));
        own(&mut c, old, ty);
        return val(old, ty);
    }
    mut slot = 0;
    if direct(&mut c, ty) {
        // The reference is the record: its words and the new value's change places, and the new
        // value's storage, which now holds the old words, is what comes back.
        swap_records(&mut c, a.t, b.t, ty);
        get(&mut c, b.t, view("%rax"));
        slot = save(&mut c);
    } else {
        slot = apply(&mut c, view("rt_xchg"), two(a.t, b.t));
    }
    own(&mut c, slot, ty);
    result := place_of(&mut c, slot);
    return_bonds(&mut c, destination, result, 0);
    source := place_of(&mut c, b.t);
    storage_bonds(&mut c, source, destination);
    move_out(&mut c, val(b.t, b.ty));
    if c.raw == 0 {
        stored_source(&mut c, slot, ty);
    }
    return val(slot, ty);
}
// `cptr(&r)` / `cptr_mut(&mut r)` for an `extern "C"` record: one pointer word holding the address
// of the record's own fields, which is what C means by `const R *` / `R *`. Used for a parameter
// typed `CPtr`/`CMutPtr` and for a record field that points at another struct
// (`VkRenderPassCreateInfo::pAttachments`). The borrow is the ordinary call-scoped one: the record
// cannot be moved, dropped, or borrowed again while the pointer is live, and the pointer carries no
// length or lifetime, which is why the whole expression sits in an `unsafe` block.
fn cptr_record<a>(c: (&a mut C), reference: u64, x: Val, writable: u64) -> Val {
    if is_c_record(&mut c, x.ty) == 0 {
        fail(
            &mut c,
            view("cptr takes the address of an extern \"C\" record; a Grail record has no C layout")
        );
    }
    if c.raw == 0 {
        place := place_of(&mut c, x.t);
        if borrowed_temporary(&mut c, place) {
            // Nothing names the storage a temporary lives in, so nothing tells the caller how long
            // the pointer stays valid: C may keep it, and the hidden binding dies with the block.
            fail(
                &mut c,
                view("cptr needs a named record: the address of a temporary would not outlive the pointer")
            );
        }
    }
    if writable != 0 {
        require_write(&mut c, x.t);
        // A writable pointer is a promise that C writes it, so the storage holds a value afterwards.
        target := place_of(&mut c, x.t);
        ownership::filled(&mut c.check, target);
    } else {
        observe(&mut c, x.t);
    }
    // The slot's own word is the address of the record's fields: `deref` already loaded it out of
    // the borrow - a whole binding's record pointer, or an embedded field's interior address - so
    // the pointer is a word copy and not a projection of the record. For a byte sequence the slot
    // holds a view record, one word further out, which is why `rt_view_ptr` reads that one.
    get(&mut c, x.t, view("%rax"));
    slot := save(&mut c);
    ty := intern_full(&mut c, 26, 0, writable, u64[]);
    pointer_borrow(&mut c, slot, ty, reference, x.t, writable);
    return val(slot, ty);
}
// 1 when `place` belongs to the hidden binding `borrow_temporary` created for `&expr`, i.e. the
// record the caller is taking the address of is not a name.
fn borrowed_temporary<a>(c: (&a mut C), place: u64) -> bool {
    if place == 0 {
        return false;
    }
    for i in c.locals.len() {
        l := &c.locals[i];
        name := l.name.copy();
        id := l.id;
        if same(view(name), view(".borrowed")) & (place_of(&mut c, id) == place) {
            return true;
        }
    }
    return false;
}
// ---- C pointers made from Grail storage --------------------------------------------------------
// `cptr`/`cptr_mut` of a record or of bytes is a borrow of that storage, the same loan a reference
// holds: the pointer value is a holder of it (a bond from its own place), the loan follows the
// pointer into bindings, record fields, closure environments and moves of whatever holds it, and it
// ends only once nothing that holds the pointer is live. While it is live the storage cannot be
// assigned, moved, dropped or (for a `cptr_mut`) used through another path, and a pointer that
// would outlive it - returned, or kept in something that outlives the storage - is refused.
// `pointers` remembers which loans are C pointers, so those conflicts can say so by name.
fn pointer_borrow<a>(c: (&a mut C), slot: u64, ty: u64, reference: u64, storage: u64, writable: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    holder := pointer_place(&mut c, slot, ty);
    // `cptr(&r)`, `cptr(view)`: the operand is a reference that already holds the loan, so the
    // pointer holds it too. `cptr(bytes)` of an owned sequence borrows the binding itself.
    source := place_of(&mut c, reference);
    if (writable == 0) & (source != 0) & !is_local_slot(&mut c, reference) {
        // `cptr(&mut v)` is a read-only pointer: the `&mut` temporary exists only to make it, so its
        // exclusive loan becomes the shared one the pointer holds, and `v` stays readable.
        for i in c.bonds.len() {
            b := &c.bonds[i];
            h := b.holder;
            loan := b.loan;
            guard := b.guard;
            if (h == source) & (guard == 0) & (loan_live(&mut c, loan) != 0) {
                ownership::share(&mut c.check, loan);
            }
        }
    }
    if (source != 0) & has_bonds(&mut c, source) {
        transfer_bonds(&mut c, source, holder);
    } else {
        target := place_of(&mut c, storage);
        if target == 0 {
            return ();
        }
        bind_loan(&mut c, slot, storage, target, writable);
    }
    pointer_loans(&mut c, holder, writable);
    return ();
}
// Record every live loan `holder` holds as a C-pointer loan made here.
fn pointer_loans<a>(c: (&a mut C), holder: u64, writable: u64) -> unit {
    at := c.pos;
    for i in c.bonds.len() {
        b := &c.bonds[i];
        h := b.holder;
        loan := b.loan;
        guard := b.guard;
        if (h == holder) & (guard == 0) {
            if loan_live(&mut c, loan) != 0 {
                c.pointers.push(Pointer { loan: loan, at: at, writable: writable });
            }
        }
    }
    return ();
}
// The place of a C pointer value: a copy root, so reading it never moves it.
fn pointer_place<a>(c: (&a mut C), slot: u64, ty: u64) -> u64 {
    place := ownership::root(&mut c.check, 1, 1);
    c
        .resources
        .push(
            Resource {
                slot: slot,
                ty: ty,
                flag: 0,
                base: 0,
                field: 0,
                via: 0,
                place: place,
                target: 0,
                authority: 0
            }
        );
    return place;
}
// Hand `src`'s C-pointer loans to `dst` when a value that may hold a pointer is copied or moved
// (`q := p`, `m := info`): the copy points at the same storage, so it holds the same loans.
fn pointer_copy<a>(c: (&a mut C), src: u64, dst: u64, ty: u64) -> unit {
    if (c.raw != 0) || (src == 0) || (dst == 0) || (c.pointers.len() == 0) {
        return ();
    }
    if contains_borrow(&mut c, ty, 0) {
        return ();
    }
    pointer_transfer(&mut c, src, dst);
    return ();
}
// Every live C-pointer loan held inside `src` is held by `dst` as well.
fn pointer_transfer<a>(c: (&a mut C), src: u64, dst: u64) -> unit {
    if (src == 0) || (dst == 0) {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        b := &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if ownership::ancestor(&c.check, src, holder) {
            if (loan_live(&mut c, loan) != 0) & (is_pointer_loan(&mut c, loan) != 0) {
                bond_kind(&mut c, dst, loan, guard);
            }
        }
    }
    return ();
}
fn holds_pointer<a>(c: (&a mut C), src: u64) -> bool {
    if src == 0 {
        return false;
    }
    for i in c.bonds.len() {
        b := &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if ownership::ancestor(&c.check, src, holder) {
            if (loan_live(&mut c, loan) != 0) & (is_pointer_loan(&mut c, loan) != 0) {
                return true;
            }
        }
    }
    return false;
}
// 1 when a value of `ty` can keep a C pointer: the pointer itself, a record or container with one
// inside, or a closure (its captures are not in its type).
fn pointer_carrier<a>(c: (&a mut C), ty: u64) -> bool {
    mut trail = u64[];
    return pointer_walk(&mut c, ty, &mut trail);
}
fn pointer_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> bool {
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if (k == 26) || (k == 20) {
        return true;
    }
    if (k == 10) || (k == 6) || (k == 13) || (k == 29) {
        return pointer_walk(&mut c, arg, &mut trail);
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return false;
            }
        }
        trail.push(ty);
        d := &c.decls[arg];
        count := d.count;
        for i in count {
            t := field_type(&mut c, ty, i);
            if pointer_walk(&mut c, t, &mut trail) {
                trail.pop()!;
                return true;
            }
        }
        trail.pop()!;
    }
    return false;
}
// A Grail callee sees its pointer parameters as plain words and is not checked against them, so the
// caller assumes the worst: the result, and the referent of every `&mut` argument, may keep any C
// pointer an argument carried in. `fn keep(p: CPtr) -> CPtr` therefore cannot launder a borrow.
fn pointer_results<a, b>(c: (&a mut C), rslot: u64, rty: u64, first: u64, args: (&b u64[])) -> unit {
    if (c.raw != 0) || (c.pointers.len() == 0) {
        return ();
    }
    mut holder = place_of(&mut c, rslot);
    keep := pointer_carrier(&mut c, rty);
    for i in args.len() {
        src := place_of(&mut c, args[i]);
        if holds_pointer(&mut c, src) {
            if keep {
                if (holder == 0) & (ty_kind(&mut c, rty) == 26) {
                    holder = pointer_place(&mut c, rslot, rty);
                }
                pointer_transfer(&mut c, src, holder);
            }
            for j in args.len() {
                formal := c.params[first + j];
                if (ty_kind(&mut c, formal) == 7) & (ty_mode(&mut c, formal) != 0) {
                    inner := ty_arg(&mut c, formal);
                    if pointer_carrier(&mut c, inner) {
                        referent := target_of(&mut c, args[j]);
                        pointer_transfer(&mut c, src, referent);
                    }
                }
            }
        }
    }
    return ();
}
// A returned value holds the C-pointer loan `loan` on storage that does not outlive the call.
fn pointer_escape<a>(c: (&a mut C), loan: u64) -> unit {
    n := is_pointer_loan(&mut c, loan);
    if n == 0 {
        return ();
    }
    p := &c.pointers[n - 1];
    at := p.at;
    writable := p.writable;
    l := &c.check.loans[loan - 1];
    source := l.source;
    subject := place_name(&mut c, source);
    mut msg = u8[];
    if subject.len() != 0 {
        dput(&mut msg, view("cannot return a C pointer to `"));
        dput(&mut msg, view(subject));
        dput(&mut msg, view("`: the pointer would outlive it"));
    } else {
        dput(&mut msg, view("cannot return a C pointer to borrowed storage: the pointer would outlive the borrow"));
    }
    dput(&mut msg, view(" (made by "));
    if writable != 0 {
        dput(&mut msg, view("cptr_mut"));
    } else {
        dput(&mut msg, view("cptr"));
    }
    dput(&mut msg, view(" at line "));
    decimal(&mut msg, token_line(&mut c, at));
    dput(&mut msg, view(")"));
    fail(&mut c, view(msg));
    return ();
}
fn is_pointer_loan<a>(c: (&a mut C), loan: u64) -> u64 {
    for i in c.pointers.len() {
        p := &c.pointers[i];
        if p.loan == loan {
            return i + 1;
        }
    }
    return 0;
}
// The binding whose storage contains `place` (`app`, or `info` for a field of it), or the binding
// whose referent does (`*out`). Empty when the place is a temporary nobody named.
fn place_name<a>(c: (&a mut C), place: u64) -> u8[] {
    // The local that owns the storage names it first (`v`, not `*r` for an `r := &v`); a name
    // through a reference is the fallback, for storage this function reaches only by reference.
    mut k = c.locals.len();
    while k != 0 {
        k = k - 1;
        id := c.locals[k].id;
        name := c.locals[k].name.copy();
        if (name.len() != 0) & (name[0] != 46) {
            root := place_of(&mut c, id);
            if (root != 0) & ownership::ancestor(&c.check, root, place) {
                return name;
            }
        }
    }
    mut i = c.locals.len();
    while i != 0 {
        i = i - 1;
        l := &c.locals[i];
        id := l.id;
        name := l.name.copy();
        if (name.len() != 0) & (name[0] != 46) {
            target := target_of(&mut c, id);
            if (target != 0) & ownership::ancestor(&c.check, target, place) {
                mut deref = u8[];
                deref.push(42);
                dput(&mut deref, view(name));
                return deref;
            }
        }
    }
    return u8[];
}
// The loop backedge check (`ownership::backedge`) refuses a body that consumes what the loop
// entered with: the second iteration would use a moved value. It names the value it refuses, offers
// the three ways out of it, and puts the caret on the loop's closing brace - the edge that repeats.
// `what` describes the edge ("loop backedge consumes entry storage", "continue consumes ...").
fn fail_backedge<a, b>(c: (&a mut C), what: &b [u8]) -> unit {
    entry := ownership::snapshot(&c.loopcheck);
    place := ownership::consumed_entry(&c.check, &entry);
    name := place_name(&mut c, place);
    mut msg = copy_bytes(view(what));
    mut help = u8[];
    if name.len() == 0 {
        push_bytes(&mut msg, view(": a value the loop enters with is moved in the body, so a second iteration would use a moved value"));
        help = copy_bytes(view("copy it (`x.copy()`), borrow it (`view(x)`), or move it before the loop"));
    } else {
        push_bytes(&mut msg, view(": `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view("` is moved out of it, so a second iteration would use a moved value"));
        help = copy_bytes(view("copy it (`"));
        push_bytes(&mut help, view(name));
        push_bytes(&mut help, view(".copy()`), borrow it (`view("));
        push_bytes(&mut help, view(name));
        push_bytes(&mut help, view(")`), or move it before the loop"));
    }
    diag_help(&mut c, view(help));
    // The check runs once the body has been parsed, so the position is one token past the loop's
    // last token. The statement that repeats is the loop, so the caret belongs on its `}`.
    mut at = c.pos;
    if 0 < at {
        if kind_at(&mut c, at - 1) == 125 {
            at = at - 1;
        }
    }
    exchange(&mut c.pos, at);
    fail(&mut c, view(msg));
}
// The line of the token at `at`, for "made by cptr at line N".
fn token_line<a>(c: (&a mut C), at: u64) -> u64 {
    t := &c.toks[at];
    st := t.start;
    mut line = 1;
    for i in st {
        if c.src[i] == 10 {
            line += 1;
        }
    }
    return line;
}
// If a live C pointer borrows storage overlapping `place`, fail naming the storage, the binding
// that holds the pointer and the line of the `cptr` that made it; otherwise return and let the
// caller report the ordinary conflict. `action` is the verb phrase: "assign to", "move", ...
// `reading` restricts the check to writable pointers (a read conflicts only with `cptr_mut`).
// The token naming `name` in the declaration that a local's `born` position follows: the binding
// is recorded after its initializer, so the name sits a little before it.
fn decl_token<a, b>(c: (&a mut C), from: u64, name: &b [u8]) -> u64 {
    mut at = from;
    mut steps = 0;
    while (0 < at) & (steps < 256) {
        at -= 1;
        steps += 1;
        if (kind_at(&mut c, at) == 1) & same(view(tok_text(&mut c, at)), view(name)) {
            return at;
        }
    }
    return from;
}
// The newest local named `name`, or 0.
fn local_named<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    mut i = c.locals.len();
    while 0 < i {
        i -= 1;
        if same(view(c.locals[i].name), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
// Labels for a write that a live borrow forbids: where each local holding a borrow of `place`
// took it, and where that local is used next - the use that keeps the borrow alive.
fn borrow_context<a, b>(c: (&a mut C), place: u64, action: &b [u8]) -> unit {
    if (place == 0) || (c.raw != 0) {
        return ();
    }
    mut subject = place_name(&mut c, place);
    mut found = false;
    for i in c.check.loans.len() {
        l := &c.check.loans[i];
        live := l.live;
        source := l.source;
        if (live != 0) & (ownership::ancestor(&c.check, place, source) || ownership::ancestor(&c.check, source, place)) {
            for j in c.bonds.len() {
                b := &c.bonds[j];
                h := b.holder;
                if (b.loan == i + 1) & !found {
                    state := ownership::status(&c.check, h);
                    if (state == 1) || (state == 3) {
                        holder := place_name(&mut c, h);
                        local := local_named(&mut c, view(holder));
                        if (holder.len() != 0) & (local != 0) {
                            born := c.locals[local - 1].born;
                            last := c.locals[local - 1].last;
                            at := decl_token(&mut c, born, view(holder));
                            mut text = copy_bytes(view("`"));
                            push_bytes(&mut text, view(holder));
                            push_bytes(&mut text, view("` borrows `"));
                            push_bytes(&mut text, view(subject));
                            push_bytes(&mut text, view("` here"));
                            diag_label(&mut c, at, view(text));
                            if last > c.pos {
                                mut later = copy_bytes(view("the borrow is still in use here"));
                                diag_label(&mut c, last, view(later));
                            }
                            mut help = copy_bytes(view("finish using `"));
                            push_bytes(&mut help, view(holder));
                            push_bytes(&mut help, view("` before you "));
                            push_bytes(&mut help, action);
                            push_bytes(&mut help, view(" `"));
                            push_bytes(&mut help, view(subject));
                            push_bytes(&mut help, view("`, or borrow it again afterwards"));
                            diag_help(&mut c, view(help));
                            found = true;
                            // The conflict is found once the statement is parsed; point at its
                            // start (`v.push(3)`), not at the token after it.
                            mut start = c.pos;
                            while 0 < start {
                                k := kind_at(&mut c, start - 1);
                                if (k == 59) || (k == 123) || (k == 125) {
                                    break;
                                }
                                start -= 1;
                            }
                            if start < c.pos {
                                exchange(&mut c.pos, start);
                            }
                        }
                    }
                }
            }
        }
    }
    return ();
}
fn pointer_conflict<a, b>(c: (&a mut C), place: u64, action: &b [u8], reading: u64) -> unit {
    if (c.raw != 0) || (place == 0) {
        return ();
    }
    for i in c.pointers.len() {
        p := &c.pointers[i];
        loan := p.loan;
        at := p.at;
        writable := p.writable;
        l := &c.check.loans[loan - 1];
        live := l.live;
        source := l.source;
        mut relevant = live != 0;
        if (reading != 0) & (writable == 0) {
            relevant = false;
        }
        if relevant & (ownership::ancestor(&c.check, place, source) || ownership::ancestor(&c.check, source, place)) {
            mut holder = u8[];
            for j in c.bonds.len() {
                b := &c.bonds[j];
                h := b.holder;
                if (b.loan == loan) & (holder.len() == 0) {
                    state := ownership::status(&c.check, h);
                    if (state == 1) || (state == 3) {
                        holder = place_name(&mut c, h);
                    }
                }
            }
            mut subject = place_name(&mut c, source);
            if subject.len() == 0 {
                subject = place_name(&mut c, place);
            }
            mut msg = u8[];
            if action.len() == 0 {
                dput(&mut msg, view("`"));
                dput(&mut msg, view(subject));
                dput(&mut msg, view("` goes out of scope while a C pointer to it is live"));
            } else {
                dput(&mut msg, view("cannot "));
                dput(&mut msg, action);
                dput(&mut msg, view(" `"));
                dput(&mut msg, view(subject));
                dput(&mut msg, view("` while a C pointer to it is live"));
            }
            if holder.len() != 0 {
                dput(&mut msg, view(" in `"));
                dput(&mut msg, view(holder));
                dput(&mut msg, view("`"));
            }
            dput(&mut msg, view(" (made by "));
            if writable != 0 {
                dput(&mut msg, view("cptr_mut"));
            } else {
                dput(&mut msg, view("cptr"));
            }
            dput(&mut msg, view(" at line "));
            decimal(&mut msg, token_line(&mut c, at));
            dput(&mut msg, view(")"));
            fail(&mut c, view(msg));
        }
    }
    return ();
}
