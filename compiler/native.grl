                    }
                }
                if compatible == 0 {
                    require_type(&mut c, x.ty, result);
                }
            }
            validate_return(&mut c, val(xt, x.ty));
            move_out(&mut c, val(xt, x.ty));
            cleanup(&mut c, 0);
            get(&mut c, xt, view("%rax"));
            o(&mut c, view("leave\nret\n"));
