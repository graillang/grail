module native;
use lexer;
use host;
use ownership;
use machine;
use optimize;
use cli;

// Direct Linux native compiler: one checked word stream, target instruction selection in machine.grl.
// Usage: native OUT.s ENTRY.grl [MODULE.grl...]. The first public function of the
// first file is the entry; it takes nothing or argv[1] as a byte view. Move/initialization
// checks, loans/lifetimes, captured-storage writeback and deterministic drops are active.
// Generic types/functions use typed specialization. Include runtime.grl as source.
// Type ids: 0 u64, 1 unit, 2 bytes, 3 string, 4 view; others are interned below.
// Type kinds: 1 u64, 2 unit, 3 bytes, 4 string, 5 view, 6 vec(arg), 7 ref(arg),
// 8 named(decl, args), 9 opaque template parameter, 10 opaque bound parameter (arg, identity),
// 11 Atomic<u64>, 12 capture-free typed function pointer, 13 Mutex<T>, 14 Scope<C>, 15 interface proof,
// 16 Task<R>, 17 CancelToken, 18 sized integer (arg bits, mode signed), 19 bool, 20 closure Fn(..)->R, 21 f64.

struct Tok {
    kind: u64,
    start: u64,
    end: u64
}
struct Ty {
    kind: u64,
    arg: u64,
    mode: u64,
    regions: u64[],
    args: u64[]
}
struct Decl {
    module: u8[],
    name: u8[],
    is_enum: u64,
    first: u64,
    count: u64,
    regions: u64,
    types: u64,
    success: u64,
    bounds: u64[],
    constraints: u64[][]
}
struct Import {
    module: u8[],
    name: u8[]
}
struct Alias {
    module: u8[],
    name: u8[],
    ty: u64
}
struct Field {
    name: u8[],
    ty: u64
}
struct Func {
    module: u8[],
    name: u8[],
    first: u64,
    count: u64,
    ret: u64,
    types: u64,
    regions: u64,
    file: u64,
    pos: u64,
    raw: u64,
    bounds: u64[],
    constraints: u64[][],
    contract: u64,
    owner: u64
}
struct Interface {
    module: u8[],
    name: u8[],
    defined: u64,
    methods: u64[]
}
struct Implementation {
    contract: u64,
    ty: u64,
    module: u8[],
    methods: u64[]
}
struct Closure {
    decl: u64,
    start: u64,
    file: u64,
    module: u8[],
    captures: u8[][],
    names: u8[][],
    params: u64[],
    ret: u64,
    symbol: u8[],
    tnames: u8[][],
    bindings: u64[]
}
struct ImplParams {
    decl: u64,
    rnames: u8[][],
    tnames: u8[][],
    bounds: u64[],
    interfaces: u64[][],
    self_ty: u64
}
struct Constant {
    module: u8[],
    name: u8[],
    ty: u64,
    value: u64,
    text: u8[]
}
struct Spec {
    template: u64,
    args: u64[],
    first: u64,
    ret: u64
}
// flex: an untyped integer literal binding (`x := 5`) whose uses adopt their context's integer
// type; lit/neg hold the literal. A mutable one settles at its first assignment.
// origin: declared from a bare literal (name token at `at`); a committed one may still learn its
// type from a later sized use, which recompiles the function with a hint.
struct Local {
    name: u8[],
    ty: u64,
    id: u64,
    last: u64,
    born: u64,
    mutable: u64,
    flex: u64,
    lit: u64,
    neg: u64,
    origin: u64,
    at: u64
}
struct Val {
    t: u64,
    ty: u64
}
struct Resource {
    slot: u64,
    ty: u64,
    flag: u64,
    base: u64,
    field: u64,
    via: u64,
    place: u64,
    target: u64,
    authority: u64
}
struct Bond {
    holder: u64,
    loan: u64,
    guard: u64
}
struct Origin {
    place: u64,
    region: u64
}
struct Member {
    base: u64,
    field: u64,
    place: u64
}
struct C {
    src: u8[],
    toks: Tok[],
    pos: u64,
    out: u8[],
    module: u8[],
    target: u64,
    arg_offset: u64,
    overflow: u64,
    default_u64: u64,
    default_u64_flag: u64,
    specs: Spec[],
    bindings: u64[],
    current_spec: u64,
    validating: u64,
    alias_next: u64,
    types: Ty[],
    decls: Decl[],
    aliases: Alias[],
    imports: Import[],
    fields: Field[],
    funcs: Func[],
    params: u64[],
    locals: Local[],
    next: u64,
    entry: u64,
    file: u64,
    label: u64,
    brk: u64,
    cont: u64,
    raw: u64,
    rnames: u8[][],
    tnames: u8[][],
    closures: Closure[],
    closure_env: u64,
    inherent: u64,
    constants: Constant[],
    impl_params: ImplParams[],
    receiver: u64,
    receiver_ty: u64,
    has_receiver: u64,
    lit_start: u64,
    lit_end: u64,
    lit_value: u64,
    hints: u64[],
    tolerant: u64,
    retry: u64,
    attempts: u64,
    cf_start: u64,
    cf_end: u64,
    cf_local: u64,
    bce_index: u8[],
    bce_base: u8[],
    lit_negative: u64,
    flit_start: u64,
    flit_end: u64,
    flit_tok: u64,
    flit_neg: u64,
    type_bounds: u64[],
    type_interfaces: u64[][],
    interfaces: Interface[],
    implementations: Implementation[],
    self_type: u64,
    current_impl: u64,
    headers_complete: u64,
    resources: Resource[],
    loopmark: u64,
    result: u64,
    check: ownership::State,
    members: Member[],
    terminated: u64,
    loopcheck: ownership::State,
    breaks: ownership::State,
    hasbreak: u64,
    bonds: Bond[],
    origins: Origin[],
    scope_end: u64,
    loop_start: u64,
    loop_end: u64,
    no_union: u64,
    parsing_input: u64,
    output_region: u64,
    receiver_region: u64,
    input_regions: u64[],
    none_start: u64,
    none_end: u64
}

fn same<a, b>(x: &a [u8], y: &b [u8]) -> u64 {
    if x.len() != y.len() {
        return 0;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return 0;
        }
    }
    return 1;
}
fn div(n: u64, d: u64) -> u64 {
    mut q = 0;
    mut r = n;
    while (r < d) == 0 {
        mut m = d;
        mut k = 1;
        while 1 {
            if 9223372036854775807 < m {
                break;
            }
            if r < m + m {
                break;
            }
            m = m + m;
            k = k + k;
        }
        r = r - m;
        q = q + k;
    }
    return q;
}

// ---- output ----
fn o<a, b>(c: (&a mut C), s: &b [u8]) -> unit {
    for i in s.len() {
        c.out.push(s[i]);
    }
    return ();
}
fn on<a>(c: (&a mut C), n: u64) -> unit {
    if 9 < n {
        on(borrow_mut(c), div(n, 10));
    }
    c.out.push(48 + n % 10);
    return ();
}

fn fresh<a>(c: (&a mut C)) -> u64 {
    id := c.next;
    exchange(borrow_mut(c.next), id + 1);
    return id;
}

fn val(t: u64, ty: u64) -> Val {
    return Val { t: t, ty: ty };
}

// Every intermediate and binding has an rbp-relative eight-byte stack slot.
fn stack_slot<a>(c: (&a mut C), id: u64) -> unit {
    c.out.push(45);
    on(borrow_mut(c), (id + 1) * 8);
    o(borrow_mut(c), &"(%rbp)");
    return ();
}
fn save<a>(c: (&a mut C)) -> u64 {
    n := fresh(borrow_mut(c));
    o(borrow_mut(c), &"movq %rax,");
    stack_slot(borrow_mut(c), n);
    c.out.push(10);
    return n;
}
fn get<a, b>(c: (&a mut C), id: u64, reg: &b [u8]) -> unit {
    o(borrow_mut(c), &"movq ");
    stack_slot(borrow_mut(c), id);
    c.out.push(44);
    o(borrow_mut(c), reg);
    c.out.push(10);
    return ();
}
fn label<a>(c: (&a mut C)) -> u64 {
    n := c.label;
    exchange(borrow_mut(c.label), n + 1);
    return n;
}
fn lname<a>(c: (&a mut C), n: u64) -> unit {
    o(borrow_mut(c), &".L");
    on(borrow_mut(c), n);
    return ();
}
fn mark<a>(c: (&a mut C), n: u64) -> unit {
    lname(borrow_mut(c), n);
    o(borrow_mut(c), &":\n");
    return ();
}
fn jump<a, b>(c: (&a mut C), op: &b [u8], n: u64) -> unit {
    o(borrow_mut(c), op);
    c.out.push(32);
    lname(borrow_mut(c), n);
    c.out.push(10);
    return ();
}

fn argreg(i: u64) -> string {
    if i == 0 {
        return "%rdi";
    }
    if i == 1 {
        return "%rsi";
    }
    if i == 2 {
        return "%rdx";
    }
    if i == 3 {
        return "%rcx";
    }
    if i == 4 {
        return "%r8";
    }
    return "%r9";
}
fn imm<a>(c: (&a mut C), n: u64) -> u64 {
    o(borrow_mut(c), &"movabsq $");
    on(borrow_mut(c), n);
    o(borrow_mut(c), &",%rax\n");
    return save(borrow_mut(c));
}
fn invoke<a, b>(c: (&a mut C), name: &b [u8], args: u64[]) -> u64 {
    if 6 < args.len() {
        fail(borrow_mut(c), &"native call exceeds six arguments");
    }
    for i in args.len() {
        mut r = argreg(i);
        get(borrow_mut(c), args[i], &r);
    }
    o(borrow_mut(c), &"call ");
    o(borrow_mut(c), name);
    c.out.push(10);
    return save(borrow_mut(c));
}

// Owned values have independent stack flags. Aliased field loads are not owners until moved.
fn needs_drop<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    return (k == 3)
        + (k == 4)
        + (k == 5)
        + (k == 6)
        + (k == 8)
        + (k == 9)
        + (k == 10)
        + (k == 11)
        + (k == 13)
        + (k == 16)
        + (k == 20);
}
fn resource<a>(c: (&a mut C), slot: u64) -> u64 {
    mut i = c.resources.len();
    while i {
        i = i - 1;
        mut r = &c.resources[i];
        if r.slot == slot {
            return i + 1;
        }
    }
    return 0;
}
fn own<a>(c: (&a mut C), slot: u64, ty: u64) -> Val {
    if c.raw == 0 {
        k := ty_kind(borrow_mut(c), ty);
        drops := needs_drop(borrow_mut(c), ty);
        if drops + (k == 7) {
            mut flag = 0;
            if drops {
                flag = imm(borrow_mut(c), 1) + 1;
            }
            place := ownership::root(borrow_mut(c.check), 0, 1);
            c
                .resources
                .push(
                    Resource {
                        slot: slot,
                        ty: ty,
                        flag: flag,
                        base: 0,
                        field: 0,
                        via: 0,
                        place: place,
                        target: 0,
                        authority: 0,
                    }
                );
        }
    }
    return val(slot, ty);
}
// A bond says that a live value retains a loan. Moves append bonds to the new holder;
// historical bonds remain for flow restoration, but dead holders do not keep loans alive.
fn bond_kind<a>(c: (&a mut C), holder: u64, loan: u64, guard: u64) -> unit {
    if (holder == 0) + (loan == 0) {
        return ();
    }
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        if (b.holder == holder) & (b.loan == loan) & (b.guard == guard) {
            return ();
        }
    }
    c.bonds.push(Bond { holder: holder, loan: loan, guard: guard });
    return ();
}
fn bond<a>(c: (&a mut C), holder: u64, loan: u64) -> unit {
    bond_kind(borrow_mut(c), holder, loan, 0);
    return ();
}
fn loan_live<a>(c: (&a mut C), loan: u64) -> u64 {
    mut l = &c.check.loans[loan - 1];
    return l.live;
}
fn transfer_bonds<a>(c: (&a mut C), src: u64, dst: u64) -> unit {
    if (src == 0) + (dst == 0) {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if loan_live(borrow_mut(c), loan) {
            if ownership::ancestor(borrow(c.check), src, holder) {
                bond_kind(borrow_mut(c), dst, loan, guard);
            }
        }
    }
    return ();
}
fn return_bonds<a>(c: (&a mut C), src: u64, dst: u64, aggregate: u64) -> unit {
    if (src == 0) + (dst == 0) {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if loan_live(borrow_mut(c), loan) {
            if ownership::ancestor(borrow(c.check), src, holder) {
                mut role = guard;
                if aggregate {
                    role = 1;
                }
                if guard == 3 {
                    role = 3;
                }
                if aggregate == 3 {
                    role = 3;
                }
                bond_kind(borrow_mut(c), dst, loan, role);
            }
        }
    }
    return ();
}
fn close_loans<a>(c: (&a mut C)) -> unit {
    mut changed = 1;
    while changed {
        changed = 0;
        mut i = c.check.loans.len();
        while i {
            i = i - 1;
            mut l = &c.check.loans[i];
            live := l.live;
            if live {
                mut held = 0;
                for j in c.bonds.len() {
                    mut b = &c.bonds[j];
                    loan := b.loan;
                    holder := b.holder;
                    if loan == i + 1 {
                        state := ownership::status(borrow(c.check), holder);
                        if (state == 1) + (state == 3) {
                            held = 1;
                            break;
                        }
                    }
                }
                if held == 0 {
                    if ownership::end_loan(borrow_mut(c.check), i + 1) == 0 {
                        changed = 1;
                    }
                }
            }
        }
        for j in c.origins.len() {
            o := &c.origins[j];
            root := o.place;
            region := o.region;
            if region == 18446744073709551615 {
                if ownership::status(borrow(c.check), root) == 1 {
                    mut reached = 0;
                    for k in c.check.loans.len() {
                        mut l = &c.check.loans[k];
                        live := l.live;
                        source := l.source;
                        if live {
                            if ownership::ancestor(borrow(c.check), root, source) {
                                reached = 1;
                                break;
                            }
                        }
                    }
                    if reached == 0 {
                        ownership::cleanup(borrow_mut(c.check), root);
                        changed = 1;
                    }
                }
            }
        }
    }
    return ();
}
fn member_place<a>(c: (&a mut C), root: u64, field: u64, ty: u64) -> u64 {
    if root == 0 {
        return 0;
    }
    for i in c.members.len() {
        m := &c.members[i];
        if (m.base == root) & (m.field == field) {
            return m.place;
        }
    }
    kind := ty_kind(borrow_mut(c), ty);
    copy := (needs_drop(borrow_mut(c), ty) == 0) & (kind != 7);
    place := ownership::field(borrow_mut(c.check), root, copy);
    c.members.push(Member { base: root, field: field, place: place });
    return place;
}
fn target_of<a>(c: (&a mut C), slot: u64) -> u64 {
    n := resource(borrow_mut(c), slot);
    if n == 0 {
        return 0;
    }
    mut r = &c.resources[n - 1];
    return r.target;
}
fn authority_of<a>(c: (&a mut C), slot: u64) -> u64 {
    n := resource(borrow_mut(c), slot);
    if n == 0 {
        return 0;
    }
    mut r = &c.resources[n - 1];
    return r.authority;
}
fn authority_loan<a>(c: (&a mut C), slot: u64, target: u64) -> u64 {
    holder := place_of(borrow_mut(c), slot - 1);
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        h := b.holder;
        loan := b.loan;
        if (holder == h) & (b.guard == 0) {
            mut l = &c.check.loans[loan - 1];
            live := l.live;
            source := l.source;
            if live {
                if ownership::ancestor(borrow(c.check), source, target) {
                    return loan;
                }
            }
        }
    }
    return 0;
}
fn set_target<a>(c: (&a mut C), slot: u64, target: u64, authority: u64) -> unit {
    n := resource(borrow_mut(c), slot);
    if n != 0 {
        mut r = &mut c.resources[n - 1];
        exchange(borrow_mut(r.target), target);
        exchange(borrow_mut(r.authority), authority);
    }
    return ();
}
fn add_region<a>(rs: (&a mut u64[]), r: u64) -> unit {
    for i in rs.len() {
        if rs[i] == r {
            return ();
        }
    }
    rs.push(r);
    return ();
}
// Lifetime parameters inside the declared type (not concrete borrow targets).
// Recursive nominal types (enum Tree { Node(Branch) }, struct Branch { left: Tree }) are walked once:
// a type already on the path adds nothing beyond its own region arguments.
fn type_caps<a>(c: (&a mut C), ty: u64, depth: u64) -> u64[] {
    mut trail = u64[];
    return caps_walk(borrow_mut(c), ty, borrow_mut(trail));
}
fn caps_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> u64[] {
    mut rs = type_regions(borrow_mut(c), ty);
    k := ty_kind(borrow_mut(c), ty);
    arg := ty_arg(borrow_mut(c), ty);
    if (k == 6) + (k == 7) + (k == 10) + (k == 13) + (k == 14) + (k == 16) {
        inner := caps_walk(borrow_mut(c), arg, borrow_mut(trail));
        for i in inner.len() {
            mut r = inner[i];
            add_region(borrow_mut(rs), r);
        }
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return rs;
            }
        }
        trail.push(ty);
        d := &c.decls[arg];
        count := d.count;
        for i in count {
            f := field_type(borrow_mut(c), ty, i);
            inner := caps_walk(borrow_mut(c), f, borrow_mut(trail));
            for j in inner.len() {
                mut r = inner[j];
                add_region(borrow_mut(rs), r);
            }
        }
        trail.pop();
    }
    return rs;
}
fn intersects<a, b>(a: (&a u64[]), b: (&b u64[])) -> u64 {
    for i in a.len() {
        mut r = a[i];
        for j in b.len() {
            if b[j] == r {
                return 1;
            }
        }
    }
    return 0;
}
fn normalize_readonly<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    k := ty_kind(borrow_mut(c), ty);
    if (k != 5) & (k != 7) {
        return ();
    }
    if ty_mode(borrow_mut(c), ty) {
        return ();
    }
    root := place_of(borrow_mut(c), slot);
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if (holder == root) & (guard == 0) {
            mut l = &c.check.loans[loan - 1];
            mode := l.mode;
            live := l.live;
            if live {
                if mode {
                    child := ownership::reborrow(borrow_mut(c.check), loan, 0);
                    if child == 0 {
                        fail(borrow_mut(c), &"readonly result cannot borrow suspended authority");
                    }
                    mut b = &mut c.bonds[i];
                    exchange(borrow_mut(b.guard), 1);
                    bond(borrow_mut(c), root, child);
                }
            }
        }
    }
    return ();
}
fn call_bonds<a>(
    c: (&a mut C),
    result: Val,
    first: u64,
    args: (&a u64[]),
    capture_type: u64
) -> unit {
    if c.raw {
        return ();
    }
    captures := type_caps(borrow_mut(c), capture_type, 0);
    holder := place_of(borrow_mut(c), result.t);
    resultkind := ty_kind(borrow_mut(c), result.ty);
    aggregate := resultkind != 5;
    for i in args.len() {
        slot := args[i];
        source := place_of(borrow_mut(c), slot);
        ty := c.params[first + i];
        kind := ty_kind(borrow_mut(c), ty);
        mut rs = type_caps(borrow_mut(c), ty, 0);
        if kind == 7 {
            rs = type_regions(borrow_mut(c), ty);
        }
        if intersects(borrow(rs), borrow(captures)) {
            mut role = u64(aggregate);
            if (kind == 7) & (resultkind == 7) {
                role = 3;
            }
            return_bonds(borrow_mut(c), source, holder, role);
        }
        if kind == 7 {
            inner := ty_arg(borrow_mut(c), ty);
            data := type_caps(borrow_mut(c), inner, 0);
            if intersects(borrow(data), borrow(captures)) {
                storage := target_of(borrow_mut(c), slot);
                return_bonds(borrow_mut(c), storage, holder, aggregate);
            }
        }
    }
    if ty_kind(borrow_mut(c), result.ty) == 7 {
        stored_source(borrow_mut(c), result.t, result.ty);
        if target_of(borrow_mut(c), result.t) == 0 {
            fail(borrow_mut(c), &"reference result has no declared frame source");
        }
    }
    k := ty_kind(borrow_mut(c), result.ty);
    if (k == 5) + (k == 7) {
        stored_source(borrow_mut(c), result.t, result.ty);
        if has_bonds(borrow_mut(c), holder) == 0 {
            fail(borrow_mut(c), &"borrowed result has no declared input source");
        }
    }
    normalize_readonly(borrow_mut(c), result.t, result.ty);
    close_loans(borrow_mut(c));
    return ();
}
// Weak updates retain historical guards across branch restoration. External storage
// accepts only origins explicitly present in its invariant data-lifetime contract.
fn check_writeback<a>(c: (&a mut C), destination: u64, ty: u64, source: u64) -> unit {
    if c.raw {
        return ();
    }
    if contains_borrow(borrow_mut(c), ty, 0) == 0 {
        return ();
    }
    region := region_of(borrow_mut(c), destination);
    if region == 0 {
        return ();
    }
    if region == 18446744073709551615 {
        mut found = 0;
        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            holder := b.holder;
            guard := b.guard;
            loan := b.loan;
            if (guard == 3) & ownership::ancestor(borrow(c.check), destination, holder) {
                if loan_live(borrow_mut(c), loan) {
                    mut l = &c.check.loans[loan - 1];
                    source := l.source;
                    mut r = region_of(borrow_mut(c), source);
                    if r != 18446744073709551615 {
                        if r != 0 {
                            fail(
                                borrow_mut(c),
                                &"opaque external captured storage has no concrete invariant contract"
                            );
                        }
                        found = 1;
                    }
                }
            }
        }
        if found == 0 {
            fail(borrow_mut(c), &"opaque captured storage lacks a checked local frame");
        }
        return ();
    }
    allowed := type_caps(borrow_mut(c), ty, 0);
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if ownership::ancestor(borrow(c.check), source, holder) {
            if loan_live(borrow_mut(c), loan) {
                mut l = &c.check.loans[loan - 1];
                origin := l.source;
                mut r = region_of(borrow_mut(c), origin);
                if r != 18446744073709551615 {
                    mut found = 0;
                    for j in allowed.len() {
                        if allowed[j] == r {
                            found = 1;
