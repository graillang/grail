        single := u64(is_f32(&mut c, ty));
        mut value = float_op_call(&mut c, op, old, v.t, single);
        if single != 0 {
            value = invoke(&mut c, view("rt_f32_round"), one(value));
        }
        return val(value, ty);
    }
    if ty_kind(&mut c, ty) == 18 {
        if c.raw == 0 {
            require_type(&mut c, v.ty, ty);
        }
        r := int_binary(&mut c, op, old, v.t, ty);
        return val(r.t, ty);
    }
    if c.raw == 0 {
        require_type(&mut c, ty, 0);
        require_type(&mut c, v.ty, 0);
    }
    value := binary(&mut c, op, old, v.t);
