        source :=place_of(borrow_mut(c),b.t);storage_bonds(borrow_mut(c),source,destination);move_out(borrow_mut(c),val(b.t,b.ty));
        if c.raw==0{stored_source(borrow_mut(c),slot,ty);}return val(slot,ty);
