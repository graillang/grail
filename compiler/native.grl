fn mutex_type<a>(c: (&a mut C), payload: u64) -> u64 {
    // Guarded payloads cannot hold borrows yet: a writer could otherwise store a loan that
    // outlives its source after the lock is released. Lifetime-parameterized mutexes are future work.
