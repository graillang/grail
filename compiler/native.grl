                mut ireg = 99;
                if ints < nint {
                    ireg = ints;
                    ints = ints + 1;
                }
                if (ireg == 99) & apple_arm & (suffix.len() != 0) {
                    fail(&mut c, view("macOS arm64 packs stack arguments; a narrow integer stack argument is not supported"));
                }
                // RV64 passes a 32-bit argument sign-extended even when it is unsigned; Grail keeps
                // u32 zero-extended, so it is converted at the boundary.
                rv_u32 := (abi == 3) & same(view(suffix), view("u32"));
                direct := words == 1 && ireg != 99 && !rv_u32;
                if direct {
                    get(&mut c, args[i], view(ffi_int_reg(abi, ireg)));
                } else {
                    get(&mut c, args[i], view("%rax"));
                    if words == 2 {
                        if w == 0 {
                            o(&mut c, view("movq (%rax),%rax\n"));
                        } else {
                            o(&mut c, view("movq 8(%rax),%rax\n"));
                        }
                    }
                    if rv_u32 {
                        o(&mut c, view("cext s32\n"));
                    }
                    if ireg != 99 {
                        o(&mut c, view("movq %rax,"));
                        o(&mut c, view(ffi_int_reg(abi, ireg)));
                        c.out.push(10);
                    } else {
                        ffi_store_stack(&mut c, x86, base + next * 8);
                        next = next + 1;
                    }
                }
            }
        }
    }
    if (rmode == 2) & (abi == 2) {
        get(&mut c, rslot, view("%rax"));
        o(&mut c, view("csret\n"));
    }
    if (abi == 0) & (fixed < args.len()) {
        // SysV variadic callees read the number of vector registers used from %al.
        o(&mut c, view("movl $"));
        on(&mut c, floats);
        o(&mut c, view(",%eax\n"));
    }
    if symbol.len() == 0 {
        get(&mut c, target, view("%rax"));
        o(&mut c, view("call *%rax\n"));
    } else {
        o(&mut c, view("call "));
        o(&mut c, view(symbol));
        c.out.push(10);
    }
    if (ret != 1) & (rmode == 0) {
        if is_float(&mut c, ret) {
