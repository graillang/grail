                held := move_value(&mut c, v);
                done := label(&mut c);
                for i in mapping.len() {
                    next := label(&mut c);
                    get(&mut c, held.t, view("%rax"));
                    o(&mut c, view("cmpq $"));
                    on(&mut c, i);
                    o(&mut c, view(",(%rax)\n"));
                    jump(&mut c, view("jne"), next);
                    o(&mut c, view("movq $"));
                    on(&mut c, mapping[i]);
                    o(&mut c, view(",(%rax)\n"));
                    jump(&mut c, view("jmp"), done);
                    mark(&mut c, next);
