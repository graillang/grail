fn release<a>(c: (&a mut C), index: u64) -> unit {
    mut r = &c.resources[index];
    flag := r.flag;
    slot := r.slot;
    ty := r.ty;
    place := r.place;
    base := r.base;
    if flag == 0 {
        if base == 0 {
            if place != 0 {
                if ownership::cleanup(&mut c.check, place) != 0 {
                    pointer_conflict(&mut c, place, view(""), 0);
                    fail(&mut c, view("storage ends while borrowed"));
                }
                close_loans(&mut c);
            }
        }
        return ();
    }
    // A join outcome that is still owned here is about to be dropped: that is a discarded failure
    // unless the program says `ignore_failure` (docs/design/task-failure-containment.md).
    require_handled(&mut c, ty, place);
    if place != 0 {
        if ownership::cleanup(&mut c.check, place) != 0 {
            pointer_conflict(&mut c, place, view(""), 0);
            fail(&mut c, view("cleanup conflicts with live loan"));
        }
    }
    done := label(&mut c);
    o(&mut c, view("cmpq $0,"));
    stack_slot(&mut c, flag - 1);
    c.out.push(10);
    jump(&mut c, view("je"), done);
    o(&mut c, view("movq $0,"));
    stack_slot(&mut c, flag - 1);
    c.out.push(10);
