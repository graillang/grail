                index := resource(&mut c, input);
                if index == 0 {
                    fail(&mut c, view("method receiver must be a variable, field or reference"));
                }
                info := &c.resources[index - 1];
                base := info.base;
                field := info.field;
                via := info.via;
                referent_place := info.place;
                if base == 0 {
                    fail(&mut c, view("method receiver must be a variable, field or reference"));
                }
                b := base - 1;
                // A loaded referent (including map[key]) is already addressed by its
                // base reference. Reborrow that authority, not a fictitious child of
                // the reference holder; ordinary record fields take the path below.
                owner := resource(&mut c, b);
                if owner != 0 {
                    basety := c.resources[owner - 1].ty;
                    if ty_kind(&mut c, basety) == 7 {
                        target := target_of(&mut c, b);
                        inner := ty_arg(&mut c, basety);
                        if target == referent_place && same_type(&mut c, inner, xty) {
