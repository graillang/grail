// Canonical specialization keys erase opaque body aliases and lift captured lifetimes
// into fresh signature slots, disjoint from explicitly named function lifetimes.
fn canonical_type<a, b>(c: (&a mut C), ty: u64, next: (&b mut u64)) -> u64 {
    k := ty_kind(&mut c, ty);
    mut arg = ty_arg(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    if k == 10 {
        return canonical_type(&mut c, arg, &mut next);
    }
    if (k == 6) || (k == 27) || (k == 7) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) || (k == 29)
        || (k == 34) {
        arg = canonical_type(&mut c, arg, &mut next);
    }
    mut args = type_args(&mut c, ty);
    for i in args.len() {
        t := args[i];
        a := canonical_type(&mut c, t, &mut next);
        exchange(&mut args[i], a);
    }
    old := type_regions(&mut c, ty);
    mut count = old.len();
    if (k == 5) || (k == 7) || (k == 27) {
        count = 1;
    }
    if k == 8 {
        d := &c.decls[arg];
        count = d.regions;
    }
    mut rs = u64[];
    for i in count {
        n := load(next) + 1;
        exchange(&mut next, n);
        rs.push(n);
    }
    env := ty_env(&mut c, ty);
    return intern_env(&mut c, k, arg, mode, rs, args, env);
}
fn decimal<a>(out: (&a mut u8[]), n: u64) -> unit {
    if 9 < n {
        decimal(&mut out, div(n, 10));
    }
    out.push(48 + n % 10);
    return ();
}
// The key a specialisation is deduplicated by: the template's identity plus the canonical spelling
// of its type arguments. `canonical_type` has already erased aliases and lifted captured lifetimes
// into fresh slots, so the spelling is a function of the types alone - not of the order
// instantiations were met in, of which other modules share the build, or of which compiler run this
// is. That is what lets one module emit the body and every other module reference it, in whatever
// order the modules are compiled (B1 stage 3).
fn special_key<a>(c: (&a mut C), index: u64) -> u8[] {
    f := &c.funcs[c.specs[index].template];
    mut module = f.module.copy();
    mut name = f.name.copy();
    mut args = u64[];
    for i in c.specs[index].args.len() {
        args.push(c.specs[index].args[i]);
    }
    mut out = u8[];
    push_bytes(&mut out, view(module));
    out.push(58);
    out.push(58);
    push_bytes(&mut out, view(name));
    for i in args.len() {
        out.push(32);
        type_key(&mut c, &mut out, args[i], 0);
    }
    return out;
}
// A specialisation's symbol: the template's name and the first 64 bits of the SHA-256 of its key, as
// 16 lowercase hex characters. A position in this run's `c.specs` would not survive separate
// compilation - the importer and the defining module do not build that list in the same order - so
// the name is derived from the key instead.
fn special_name<a>(c: (&a mut C), index: u64) -> u8[] {
    mut out = c.funcs[c.specs[index].template].name.copy();
    out.push(36);
