    if k == 8 {
        d := ty_arg(&mut c, ty);
        decl := &c.decls[d];
        count := decl.count;
        enum_decl := decl.is_enum;
        if enum_decl == 0 {
            mut acc = imm(&mut c, 1);
            for i in count {
                fty := field_type(&mut c, ty, i);
                mut a = 0;
                mut b = 0;
                if c.decls[d].c_layout != 0 {
                    a = cfield_load(&mut c, x, d, i, 0);
