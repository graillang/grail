// match on an integer or bool: `0 => {..}`, `1 | 2 => {..}`, `'a' => {..}`, `_ => {..}`.
fn scalar_match<a>(c: (&a mut C), s: Val) -> unit {
    xt := s.t;
    ty := s.ty;
    observe(borrow_mut(c), xt);
    boolean := is_bool(borrow_mut(c), ty);
    mut before = ownership::snapshot(borrow(c.check));
    mut exits = ownership::new();
    mut have = 0;
    mut seen = u64[];
    mut default = 0;
    end := label(borrow_mut(c));
    expect(borrow_mut(c), &"{");
    while eat(borrow_mut(c), &"}") == 0 {
        ownership::restore(borrow_mut(c.check), borrow(before));
        exchange(borrow_mut(c.terminated), 0);
        next := label(borrow_mut(c));
        body := label(borrow_mut(c));
        mut binding = u8[];
        mut wildcard = 0;
        if eat(borrow_mut(c), &"_") {
            wildcard = 1;
        } else {
            if (kind(borrow_mut(c)) == 1)
                & (is(borrow_mut(c), &"true") == 0)
                & (is(borrow_mut(c), &"false") == 0) {
                binding = ident(borrow_mut(c));
                wildcard = 1;
            }
        }
        // `if` after a pattern adds a guard; a guarded arm never makes the match exhaustive.
        if wildcard {
            if is(borrow_mut(c), &"if") == 0 {
                if default {
                    fail(borrow_mut(c), &"duplicate catch-all arm");
                }
                default = 1;
            }
        } else {
            while true {
                negative := eat(borrow_mut(c), &"-");
                here := c.pos;
                k := kind(borrow_mut(c));
                mut value = 0;
                if boolean {
                    if negative {
                        fail(borrow_mut(c), &"bool patterns are true or false");
                    }
                    if is(borrow_mut(c), &"true") {
                        value = 1;
                    } else {
                        if is(borrow_mut(c), &"false") == 0 {
                            fail(borrow_mut(c), &"bool patterns are true or false");
                        }
                    }
                    advance(borrow_mut(c));
                } else {
                    if k == 2 {
                        t := tok_text(borrow_mut(c), here);
                        value = literal_value(borrow_mut(c), &t);
                        advance(borrow_mut(c));
                    } else {
                        if k == 4 {
                            value = char_literal(borrow_mut(c), here);
                            advance(borrow_mut(c));
                        } else {
                            fail(
                                borrow_mut(c),
                                &"match patterns must be integer or character literals (or _)"
                            );
                        }
                    }
                    if literal_fits(borrow_mut(c), ty, value, negative) == 0 {
                        fail(borrow_mut(c), &"match pattern out of range for the value's type");
                    }
