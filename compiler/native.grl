                index := resource(&mut c, input);
                if index != 0 {
                    info := &c.resources[index - 1];
                    if (info.base == 0) & (info.place != 0) {
                        temporary = 1;
                    }
                }
            }
            if is_local_slot(&mut c, input) || temporary != 0 {
                if mode != 0 && temporary == 0 {
                    require_mutable_binding(&mut c, input, 1);
                }
                target := place_of(&mut c, input);
                o(&mut c, view("leaq "));
                stack_slot(&mut c, input);
                o(&mut c, view(",%rax\n"));
