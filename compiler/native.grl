        d := ty_arg(&mut c, base.ty);
        decl := &c.decls[d];
        if decl.is_enum != 0 {
            fail(&mut c, view("enum payload requires match or unwrap"));
        }
        k := find_field(&mut c, d, view(f));
        fty := field_type(&mut c, base.ty, k);
        last := (kind(&mut c) != 46) & (address != 0);
        // `address` 1 and 2 ask for a reference to the field, 3 for the place an assignment
        // writes: the address of the field's word, whatever the field holds. A reference to a
        // record field is the record's address - the field's word, loaded.
        place := address == 3;
        mut n = 0;
        if c.decls[d].c_layout != 0 {
            more := kind(&mut c) == 46;
            exchange(&mut c.cfield_more, more);
            n = cfield_load(&mut c, b, d, k, last);
        } else {
            if last & !place {
                n = field_reference(&mut c, b, base.ty, k);
            } else {
                n = field_load(&mut c, b, base.ty, k, last);
            }
            if last & subword(&mut c, fty) {
                // Every field of a Grail record is at least a word: the address is untagged.
                c.word_refs.push(n);
            }
        }
        if last {
            // 2 is a `&mut` of the field, 3 the place an assignment writes (assign_field_path).
            if address >= 2 {
                if c.ref_assign_target != 0 {
                    exchange(&mut c.ref_assign_d, d + 1);
                    exchange(&mut c.ref_assign_k, k);
                    exchange(&mut c.ref_assign_base, b);
                    exchange(&mut c.ref_assign_rty, base.ty);
                } else {
                    if ref_field_refined(&mut c, d, k) {
                        ref_field_loan_fail(&mut c, d, k);
                    }
                }
            }
            ty := reference_type(&mut c, fty, address >= 2);
            mut ref = n;
            // Only a C-layout container embeds the record's bytes. A plain record's field is a
            // word holding the record's own address, so `n` (that word's address) already is the
            // reference; a proxy over it would add a level and write into the container's words.
            outer := c.decls[d].c_layout;
            holder := base.ty;
            embeds := ((is_c_record(&mut c, fty) != 0) & (outer != 0)) || inline_field(&mut c, holder, k);
            if place & embeds {
                // An embedded record has no slot of its own: its bytes are interior to the
                // containing struct, and `n` holds their address. A reference is a pointer to a
                // slot that holds the record's address, so the place is a proxy slot holding the
                // interior address, and the reference points at it. That keeps `ref_load`'s one
                // representation ("load the record's address through the reference") valid on
                // both sides of a call - `&mut o.inner` used to read the first field as an address
                // and fault in the callee.
                o(&mut c, view("leaq "));
                stack_slot(&mut c, n);
                o(&mut c, view(",%rax\n"));
                ref = save(&mut c);
                c.embedded.push(ref);
                c.embedded.push(fty);
            }
            root := place_of(&mut c, b);
            target := member_place(&mut c, root, k, fty);
            authority := authority_of(&mut c, b);
            if c.raw == 0 {
                c
                    .resources
                    .push(
                        Resource {
                            slot: ref,
                            ty: ty,
                            flag: 0,
                            base: b + 1,
                            field: k,
                            via: via,
                            place: 0,
                            target: target,
                            authority: authority,
                        }
                    );
            }
            return val(ref, ty);
        }
        outer_c := c.decls[d].c_layout;
        next_dot := kind(&mut c) == 46;
        inner_c := is_c_record(&mut c, fty);
        raw_fty := field_ty(&mut c, d, k);
        if (outer_c != 0) & (address == 0) & (ty_kind(&mut c, raw_fty) == 32) & !next_dot & (kind(&mut c) != 91) {
            // A C array field read whole is a copy (cfield_load): reading it reads the container, and
            // the reader owns the copy.
            observe(&mut c, b);
            own(&mut c, n, fty);
            return val(n, fty);
        }
        if outer_c != 0 && address == 0 && !next_dot && inner_c {
            // A copied-out embedded C record is a fresh value, independent of the field's place:
            // reading it is a read of the containing record, and the copy is owned by the reader.
            observe(&mut c, b);
            own(&mut c, n, fty);
            return val(n, fty);
        }
        alias_field(&mut c, n, fty, b, k, via);
        t = n;
        ty = fty;
    }
    observe(&mut c, t);
    return val(t, ty);
}
fn place<a>(c: (&a mut C), write: u64, slot: u64) -> Val {
    name := ident(&mut c);
    mut l = find_local(&mut c, view(name));
    if l == 0 {
        return capture_place(&mut c, view(name), write);
    }
    id := local_id(&mut c, l - 1);
    ty := local_ty(&mut c, l - 1);
    commit_flex(&mut c, l - 1);
    next := kind(&mut c);
    // `&mut r` on a shared reference binds the slot (never the referent): a whole-binding borrow
    // of a reference is its own storage. Field and index borrows still go through the referent.
    if slot != 0
        && write != 0
        && ty_kind(&mut c, ty) == 7
        && ty_mode(&mut c, ty) == 0
        && next != 46
        && next != 91 {
        return reference_slot(&mut c, id, ty);
    }
    if write != 0 {
        require_mutable_binding(&mut c, id, 1);
    }
    if ty_kind(&mut c, ty) == 7 {
        if write != 0 {
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("mutable reborrow of shared reference"));
            }
        }
    }
    if kind(&mut c) == 46 {
        mut v = field_path(&mut c, id, ty, 1 + write);
        target := target_of(&mut c, v.t);
        mut r = resource(&mut c, v.t);
        info := &c.resources[r - 1];
        base := info.base - 1;
        return borrow_reference(&mut c, v.t, v.ty, base, target, write);
    }
    return place_slot(&mut c, id, ty, write);
}
// Borrow of a whole binding: references reborrow their referent, other values borrow the slot.
fn place_slot<a>(c: (&a mut C), id: u64, ty: u64, write: u64) -> Val {
    target := place_of(&mut c, id);
    mut referent = ty;
    mut source = target;
    mut slot = 0;
    if ty_kind(&mut c, ty) == 7 {
        source = target_of(&mut c, id);
        referent = ty_arg(&mut c, ty);
        get(&mut c, id, view("%rax"));
        slot = save(&mut c);
    } else {
        slot = slot_reference(&mut c, id, ty);
    }
    mut out = reference_type(&mut c, referent, write);
    return borrow_reference(&mut c, slot, out, id, source, write);
}
// `&mut r` where `r` holds a reference borrows the binding's own slot, not its referent: the
// result is `&mut &T`, which lets a callee replace which referent `r` holds without gaining write
// access to the old referent. The old referent stays reachable read-only through the reference
// that `exchange` hands back.
fn reference_slot<a>(c: (&a mut C), id: u64, ty: u64) -> Val {
    if binding_mode(&c, id) != 2 {
        fail(&mut c, view("owned storage mutation requires mut"));
    }
    target := place_of(&mut c, id);
    o(&mut c, view("leaq "));
    stack_slot(&mut c, id);
    o(&mut c, view(",%rax\n"));
    slot := save(&mut c);
    out := reference_type(&mut c, ty, 1);
    own(&mut c, slot, out);
    loan := ownership::borrow_place(&mut c.check, target, 1);
    if loan == 0 {
        fail(&mut c, view("borrow conflicts with active access"));
    }
    holder := place_of(&mut c, slot);
    bond(&mut c, holder, loan);
    set_target(&mut c, slot, target, slot + 1);
    return val(slot, out);
}
// `&x`, `&x.f.g` and `&xs[i]` name places; anything else is a temporary.
fn borrow_place_ahead<a>(c: (&a mut C)) -> bool {
    if kind(&mut c) != 1 {
        return false;
    }
    p := c.pos;
    name := tok_text(&mut c, p);
    mut j = p + 1;
    while (kind_at(&mut c, j) == 46) & (kind_at(&mut c, j + 1) == 1) {
        j = j + 2;
    }
    k := kind_at(&mut c, j);
    if (k == 91) & (j == p + 1) {
        // `u64[1,2]` is a type-first literal, not indexing a local.
        if find_local(&mut c, view(name)) == 0 {
            if simple_type_head(&mut c, view(name)) {
                return false;
            }
            m := module_copy(&mut c);
            if find_decl(&mut c, view(m), view(name)) != 0 {
                return false;
            }
        }
    }
    // A named place remains a place before commas, semicolons and operators too.
    // Only a following call consumes an expression here (e.g. &make_value()).
    if k != 40 {
        if find_local(&mut c, view(name)) != 0 {
            return true;
        }
        if c.closure_env != 0 {
            closure := &c.closures[c.closure_env - 1];
            for i in closure.captures.len() {
                captured := &closure.captures[i];
                if same(view(captured), view(name)) {
                    return true;
                }
            }
        }
    }
    return (k == 41) || (k == 91);
}
// `&f(x)`: the temporary is held by a hidden binding until the end of the enclosing
// block (like `t := f(x); &t`), so the reference may be used after the statement.
fn borrow_temporary<a>(c: (&a mut C), write: u64) -> Val {
    v := expr(&mut c, 0);
    if ty_kind(&mut c, v.ty) == 7 {
        if write != 0 {
            if ty_mode(&mut c, v.ty) == 0 {
                fail(&mut c, view("mutable reborrow of shared reference"));
            }
        }
    }
    held := move_value(&mut c, v);
    bind(&mut c, copy_bytes(view(".borrowed")), held.ty, held.t, write);
    return place_slot(&mut c, held.t, held.ty, write);
}
fn hex(b: u64) -> u64 {
    if b < 58 {
        return b - 48;
    }
    if b < 71 {
        return b - 55;
    }
    return b - 87;
}
// view("literal") without building anything at run time: the literal's bytes, a `u8[]` object
// for them and the view descriptor all live in read-only data, each behind a block header whose
// state 2 marks it static (rt_free leaves those alone). The string object is the view's tracked
// source, exactly as the owned temporary would be, so borrow checking is unchanged. Mach-O keeps
// it in __DATA,__const because the objects hold absolute pointers.
fn static_literal_view<a>(c: (&a mut C)) -> Val {
    bytes := decode_literal(&mut c, c.pos);
    advance(&mut c);
    data := label(&mut c);
    text := label(&mut c);
    desc := label(&mut c);
    if c.plat == 1 {
        o(&mut c, view(".pushsection __DATA,__const\n"));
    } else {
        o(&mut c, view(".pushsection .rodata\n"));
    }
    // Each object starts at a multiple of 16, as an allocated block does: that is what lets the
    // runtime tell a view's own record from a header by its address (rt_view_record).
    o(&mut c, view(".p2align 4\n.quad 0\n.quad 2\n"));
    mark(&mut c, data);
    for i in bytes.len() {
        o(&mut c, view(".byte "));
        on(&mut c, bytes[i]);
        c.out.push(10);
    }
    o(&mut c, view(".byte 0\n.p2align 4\n.quad 0\n.quad 2\n"));
    mark(&mut c, text);
    o(&mut c, view(".quad "));
    lname(&mut c, data);
    o(&mut c, view("\n.quad "));
    on(&mut c, bytes.len());
    o(&mut c, view("\n.quad "));
    on(&mut c, bytes.len());
    o(&mut c, view("\n.p2align 4\n.quad 0\n.quad 2\n"));
    mark(&mut c, desc);
    o(&mut c, view(".quad "));
    lname(&mut c, data);
    o(&mut c, view("\n.quad "));
    on(&mut c, bytes.len());
    o(&mut c, view("\n.popsection\nleaq "));
    lname(&mut c, text);
    o(&mut c, view("(%rip),%rax\n"));
    source := save(&mut c);
    own(&mut c, source, 3);
    o(&mut c, view("leaq "));
    lname(&mut c, desc);
    o(&mut c, view("(%rip),%rax\n"));
    slot := save(&mut c);
    ty := intern_full(&mut c, 5, 0, 0, u64[]);
    own(&mut c, slot, ty);
    view_bonds(&mut c, slot, source, 0, false);
    release_temporary(&mut c, source);
    return val(slot, ty);
}
// `cstr("literal")`: a pointer to NUL-terminated bytes in read-only static storage. The
// literal must end in NUL itself (`"name\0"`), which is checked now rather than at run time.
fn static_literal_cstr<a>(c: (&a mut C)) -> Val {
    bytes := decode_literal(&mut c, c.pos);
    if (bytes.len() == 0) || (bytes[bytes.len() - 1] != 0) {
        fail(&mut c, view("cstr of a literal requires the literal to end in a NUL byte (\\0)"));
    }
    advance(&mut c);
    expect(&mut c, view(")"));
    data := label(&mut c);
    if c.plat == 1 {
        o(&mut c, view(".pushsection __TEXT,__cstring\n"));
    } else {
        o(&mut c, view(".pushsection .rodata\n"));
    }
    mark(&mut c, data);
    for i in bytes.len() {
        o(&mut c, view(".byte "));
        on(&mut c, bytes[i]);
        c.out.push(10);
    }
    o(&mut c, view(".popsection\nleaq "));
    lname(&mut c, data);
    o(&mut c, view("(%rip),%rax\n"));
    slot := save(&mut c);
    return val(slot, intern(&mut c, 24, 0));
}
// `@embed("path")`: the bytes of a file, read while compiling and placed in the program as
// read-only data, as a `u8[]`. The path is relative to the source file that names it. A build that
// embeds a file is not served from the build cache, which keys on sources only.
fn embed_file<a>(c: (&a mut C)) -> Val {
    advance(&mut c);
    advance(&mut c);
    expect(&mut c, view("("));
    if kind(&mut c) != 3 {
        fail(&mut c, view("@embed takes a path string"));
    }
    rel := decode_literal(&mut c, c.pos);
    advance(&mut c);
    expect(&mut c, view(")"));
    mut path = rel.copy();
    if (rel.len() == 0) || (rel[0] != 47) {
        mut base = u8[];
        if c.file < 1000000 {
            base = input_path(&c, c.file);
        }
        mut cut = 0;
        for i in base.len() {
            if base[i] == 47 {
                cut = i + 1;
            }
        }
        mut joined = u8[];
        for i in cut {
            joined.push(base[i]);
        }
        push_bytes(&mut joined, view(rel));
        path = joined;
    }
    if host::exists(view(path)) == 0 {
        mut msg = copy_bytes(view("@embed cannot read "));
        push_bytes(&mut msg, view(path));
        fail(&mut c, view(msg));
    }
    exchange(&mut c.embed_used, 1);
    bytes := host::read_file(view(path));
    ptr := rodata_bytes(&mut c, &bytes);
    n := imm(&mut c, bytes.len());
    t := invoke(&mut c, view("rt_bytes_from"), two(ptr, n));
    return own(&mut c, t, 2);
}
fn string_lit<a>(c: (&a mut C)) -> Val {
    bytes := decode_literal(&mut c, c.pos);
    advance(&mut c);
    return string_from_bytes(&mut c, &bytes);
}
// The bytes as read-only data, and the address of the first one.
fn rodata_bytes<a, b>(c: (&a mut C), bytes: (&b u8[])) -> u64 {
    mut l = label(&mut c);
    rodata(&mut c);
    mark(&mut c, l);
    for i in bytes.len() {
        o(&mut c, view(".byte "));
        on(&mut c, bytes[i]);
        c.out.push(10);
    }
    o(&mut c, view(".byte 0\n.popsection\nleaq "));
    lname(&mut c, l);
    o(&mut c, view("(%rip),%rax\n"));
    return save(&mut c);
}
// Whether `bytes` is well-formed UTF-8, by the rules rt_utf8 checks at run time: a literal that
// passes needs no check when the program makes a string of it.
fn utf8_well_formed<a>(bytes: (&a u8[])) -> bool {
    n := bytes.len();
    mut i: u64 = 0;
    while i < n {
        b := u64(bytes[i]);
        if b < 128 {
            i += 1;
            continue;
        }
        mut count: u64 = 0;
        if (193 < b) & (b < 224) {
            count = 2;
        }
        if (223 < b) & (b < 240) {
            count = 3;
        }
        if (239 < b) & (b < 245) {
            count = 4;
        }
        if (count == 0) || (n < i + count) {
            return false;
        }
        second := u64(bytes[i + 1]);
        if (second < 128) || (191 < second) {
            return false;
        }
        if ((b == 224) & (second < 160)) || ((b == 237) & (159 < second)) || ((b == 240) & (second < 144)) || ((b == 244) & (143 < second)) {
            return false;
        }
        for k in count - 2 {
            next := u64(bytes[i + 2 + k]);
            if (next < 128) || (191 < next) {
                return false;
            }
        }
        i += count;
    }
    return true;
}
fn string_from_bytes<a, b>(c: (&a mut C), bytes: (&b u8[])) -> Val {
    ptr := rodata_bytes(&mut c, bytes);
    n := imm(&mut c, bytes.len());
    mut f = "rt_string_lit";
    if utf8_well_formed(&bytes) {
        f = "rt_lit";
    }
    t := invoke(&mut c, view(f), two(ptr, n));
    return own(&mut c, t, 3);
}
// A callable bound's parameters and result against the signature of the closure given for it: only
// the unbound type parameters are fixed, and nothing is checked here (require_interfaces does).
fn infer_callable<a, b>(c: (&a mut C), bound: u64, actual: u64, map: (&b mut u64[])) -> unit {
    bp := type_args(&mut c, bound);
    ap := type_args(&mut c, actual);
    if bp.len() != ap.len() {
        return ();
    }
    for i in bp.len() {
        if (ty_kind(&mut c, bp[i]) == 9) && (ty_arg(&mut c, bp[i]) < map.len()) && (map[ty_arg(&mut c, bp[i])] == NO_TYPE) {
            exchange(&mut map[ty_arg(&mut c, bp[i])], ap[i]);
        }
    }
    br := ty_arg(&mut c, bound);
    if (ty_kind(&mut c, br) == 9) && (ty_arg(&mut c, br) < map.len()) && (map[ty_arg(&mut c, br)] == NO_TYPE) {
        exchange(&mut map[ty_arg(&mut c, br)], ty_arg(&mut c, actual));
    }
    return ();
}
fn infer_type<a, b>(c: (&a mut C), formal: u64, actual: u64, map: (&b mut u64[])) -> unit {
