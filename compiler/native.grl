module native;
use lexer;
use host;
use ownership;
use machine;
use optimize;
use llvm;
use cli;

// Direct Linux native compiler: one checked word stream, target instruction selection in machine.grl.
// Usage: native OUT.s ENTRY.grl [MODULE.grl...]. The first public function of the
// first file is the entry; it takes nothing or argv[1] as a byte view. Move/initialization
// checks, loans/lifetimes, captured-storage writeback and deterministic drops are active.
// Generic types/functions use typed specialization. Include runtime.grl as source.
// Type ids: 0 u64, 1 unit, 2 bytes, 3 string, 4 view; others are interned below.
// Type kinds: 1 u64, 2 unit, 3 bytes, 4 string, 5 view, 6 vec(arg), 7 ref(arg),
// 8 named(decl, args), 9 opaque template parameter, 10 opaque bound parameter (arg, identity),
// 11 Atomic<u64>, 12 capture-free typed function pointer, 13 Mutex<T>, 14 Scope<C>, 15 interface proof,
// 16 Task<R>, 17 CancelToken, 18 sized integer (arg bits, mode signed), 19 bool, 20 closure Fn(..)->R, 21 f64.

struct Tok {
    kind: u64,
    start: u64,
    end: u64
}
struct Ty {
    kind: u64,
    arg: u64,
    mode: u64,
    regions: u64[],
    args: u64[]
}
struct Decl {
    module: u8[],
    name: u8[],
    is_enum: u64,
    // 1 for `handle Name;`: a one-word opaque foreign handle, not a layout.
    opaque: u64,
    // 1 for `extern record`: fields use C layout (natural alignment, padding).
    c_layout: u64,
    first: u64,
    count: u64,
    regions: u64,
    types: u64,
    success: u64,
    bounds: u64[],
    constraints: u64[][]
}
struct Import {
    module: u8[],
    name: u8[]
}
struct Alias {
    module: u8[],
    name: u8[],
    ty: u64
}
struct Field {
    name: u8[],
    ty: u64
}
struct Func {
    module: u8[],
    name: u8[],
    first: u64,
    count: u64,
    ret: u64,
    types: u64,
    regions: u64,
    file: u64,
    pos: u64,
    raw: u64,
    bounds: u64[],
    constraints: u64[][],
    contract: u64,
    owner: u64,
    // 1 when this is an `extern "C"` declaration: no body, and `symbol` is the
    // linker-visible C name (unmangled).
    ext: u64,
    symbol: u8[]
}
struct Interface {
    module: u8[],
    name: u8[],
    defined: u64,
    methods: u64[]
}
struct Implementation {
    contract: u64,
    ty: u64,
    module: u8[],
    methods: u64[]
}
struct Closure {
    decl: u64,
    start: u64,
    file: u64,
    module: u8[],
    captures: u8[][],
    names: u8[][],
    params: u64[],
    ret: u64,
    symbol: u8[],
    tnames: u8[][],
    bindings: u64[],
    // Lifetimes the parameters introduced (`|x: &T|`): regions 2.. of the closure's own namespace.
    regions: u64,
    // The captures the body writes, one flag per entry of `captures`. Only a written capture is
    // mutable in the body, and a closure with any written capture is `FnMut` (mode 1), not `Fn`.
    written: u64[],
    mode: u64
}
struct ImplParams {
    decl: u64,
    rnames: u8[][],
    tnames: u8[][],
    bounds: u64[],
    interfaces: u64[][],
    self_ty: u64
}
struct Constant {
    module: u8[],
    name: u8[],
    ty: u64,
    value: u64,
    text: u8[]
}
struct Spec {
    template: u64,
    args: u64[],
    first: u64,
    ret: u64
}
// flex: an untyped integer literal binding (`x := 5`) whose uses adopt their context's integer
// type; lit/neg hold the literal. A mutable one settles at its first assignment.
// origin: declared from a bare literal (name token at `at`); a committed one may still learn its
// type from a later sized use, which recompiles the function with a hint.
struct Local {
    name: u8[],
    ty: u64,
    id: u64,
    last: u64,
    born: u64,
    mutable: u64,
    flex: u64,
    lit: u64,
    neg: u64,
    origin: u64,
    at: u64
}
struct Val {
    t: u64,
    ty: u64
}
struct Resource {
    slot: u64,
    ty: u64,
    flag: u64,
    base: u64,
    field: u64,
    via: u64,
    place: u64,
    target: u64,
    authority: u64
}
struct Bond {
    holder: u64,
    loan: u64,
    guard: u64
}
struct Origin {
    place: u64,
    region: u64
}
struct Member {
    base: u64,
    field: u64,
    place: u64
}
struct DebugVar {
    name: u8[],
    slot: u64,
    line: u64,
    param: u64,
    // DWARF base type of the value in the 8-byte slot: name, DW_ATE encoding, byte size.
    tname: u8[],
    tenc: u64,
    tsize: u64
}
struct DebugSite {
    file: u64,
    line: u64,
    start: u64,
    end: u64,
    params: u64
}
struct DebugFunc {
    name: u8[],
    module: u8[],
    file: u64,
    line: u64,
    start: u64,
    end: u64,
    params: u64,
    vars: DebugVar[]
}
struct C {
    src: u8[],
    toks: Tok[],
    pos: u64,
    out: u8[],
    // 1 (--split): mark module boundaries in `out` and write one assembly file per module.
    split: u64,
    // The module of the run being emitted, so a marker opens a run only when the module changes.
    part: u8[],
    // Where the markers ended up in the optimized stream, and the module each names.
    marks: u64[],
    part_names: u8[][],
    module: u8[],
    target: u64,
    plat: u64,
    // Emit .file/.loc DWARF line info (Linux x86-64 native output only).
    debug: u64,
    // 1: lower the raw word stream to LLVM IR (compiler/llvm.grl) instead of optimize/machine.
    backend: u64,
    // Typed-IR facts for that lifter (docs/design/typed-ir.md). They travel beside `out`, never in
    // it: an absent fact means the untyped word lowering, so no stream change can affect
    // optimize.grl, machine.grl or the native backend.
    facts: llvm::Facts,
    // Body symbol of the function being emitted; facts are keyed by it.
    facts_fn: u8[],
    // Ordinal of the next `call rt_f64_op` in the function being emitted, and of the one most
    // recently emitted (its site, which knows the opcode, records the fact after the call).
    f64_ops: u64,
    call_ord: u64,
    // F1: per-callee call counters and the ordinal of the call just emitted, which is the key a
    // call-argument fact carries (docs/design/typed-ir.md).
    f1_names: u8[][],
    f1_counts: u64[],
    f1_ord: u64,
    // 1 with --verify-facts: the lifter checks every word a fact treats as an f32, and every word
    // it treats as a sequence header.
    verify_facts: u64,
    // --f1-what=N: a test aid that records a deliberately wrong F1 kind for every binding, so the
    // checks --verify-facts emits can be shown to fire (docs/design/typed-ir.md, "Tests that catch
    // a wrong fact"). 0, the default, records the type the front end actually has.
    f1_what: u64,
    debug_funcs: DebugFunc[],
    debug_vars: DebugVar[],
    arg_offset: u64,
    // The file being parsed sits in the standard-library directory (one containing core.grl).
    file_std: u64,
    // Modules declared by standard-library files; they compile in the stdlib's own modes.
    std_modules: u8[][],
    overflow: u64,
    default_u64: u64,
    default_u64_flag: u64,
    // Reference dialect is independent of the internal numeric default.
    typed_refs: u64,
    // The bool/integer rule is always enforced; 1 is the survey mode (`--strict-bool-report`).
    strict_bool_report: u64,
    typed_refs_flag: u64,
    exports: u8[][],
    export_hits: u64[],
    specs: Spec[],
    bindings: u64[],
    current_spec: u64,
    validating: u64,
    // Named-parameter count of the variadic extern call being lowered; 0 otherwise.
    ffi_fixed: u64,
    // Slots holding the address of a narrow (non-8-byte or f32) C-layout record field, paired
    // with the field type: stores and compound loads through them use the field's width.
    caddr: u64[],
    // An exported callback's float result: 0 none, 1 f64, 2 f32 (returned in xmm0/d0/fa0).
    export_fret: u64,
    // Set for one cfield_load: another `.field` projection follows this one.
    cfield_more: u64,
    alias_next: u64,
    types: Ty[],
    decls: Decl[],
    aliases: Alias[],
    imports: Import[],
    fields: Field[],
    funcs: Func[],
    params: u64[],
    locals: Local[],
    next: u64,
    entry: u64,
    file: u64,
    label: u64,
    brk: u64,
    cont: u64,
    raw: u64,
    // Lexical `unsafe { ... }` depth. Foreign calls are rejected at depth 0.
    unsafe_depth: u64,
    // Linker inputs declared by `extern "C" lib "..."`, deduplicated in order.
    libs: u8[][],
    // Set while an `extern "C" fn` definition is handed to the function parser:
    // 2 means C-callable with the given unmangled symbol.
    pending_ext: u64,
    pending_symbol: u8[],
    // Slot holding the host TLS base inside an exported function's body, or 0.
    export_tls: u64,
    rnames: u8[][],
    tnames: u8[][],
    closures: Closure[],
    fn_thunk_used: u64,
    closure_env: u64,
    inherent: u64,
    constants: Constant[],
    impl_params: ImplParams[],
    receiver: u64,
    receiver_ty: u64,
    has_receiver: u64,
    lit_start: u64,
    lit_end: u64,
    lit_value: u64,
    hints: u64[],
    tolerant: u64,
    retry: u64,
    attempts: u64,
    cf_start: u64,
    cf_end: u64,
    cf_local: u64,
    bce_index: u8[],
    bce_base: u8[],
    lit_negative: u64,
    // Span of the most recent byte read (`bytes[i]`): an untyped word known to be 0..255.
    byte_start: u64,
    byte_end: u64,
    flit_start: u64,
    flit_end: u64,
    flit_tok: u64,
    flit_neg: u64,
    type_bounds: u64[],
    type_interfaces: u64[][],
    interfaces: Interface[],
    implementations: Implementation[],
    self_type: u64,
    current_impl: u64,
    headers_complete: u64,
    resources: Resource[],
    loopmark: u64,
    result: u64,
    check: ownership::State,
    members: Member[],
    terminated: u64,
    loopcheck: ownership::State,
    breaks: ownership::State,
    hasbreak: u64,
    bonds: Bond[],
    origins: Origin[],
    scope_end: u64,
    loop_start: u64,
    loop_end: u64,
    no_union: u64,
    parsing_input: u64,
    output_region: u64,
    receiver_region: u64,
    input_regions: u64[],
    none_start: u64,
    none_end: u64,
    deny_ambient: u64,
    host_optin: u64,
    host_modules: u8[][]
}

fn same<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn div(n: u64, d: u64) -> u64 {
    mut q = 0;
    mut r = n;
    while !(r < d) {
        mut m = d;
        mut k = 1;
        while true {
            if 9223372036854775807 < m {
                break;
            }
            if r < m + m {
                break;
            }
            m = m + m;
            k = k + k;
        }
        r = r - m;
        q = q + k;
    }
    return q;
}

// ---- output ----
fn o<a, b>(c: (&a mut C), s: &b [u8]) -> unit {
    for i in s.len() {
        c.out.push(s[i]);
    }
    return ();
}
fn on<a>(c: (&a mut C), n: u64) -> unit {
    if 9 < n {
        on(&mut c, div(n, 10));
    }
    c.out.push(48 + n % 10);
    return ();
}
// Escape a path for an assembler .file directive (quotes and backslashes).
fn emit_path<a, b>(c: (&a mut C), path: &b [u8]) -> unit {
    for i in path.len() {
        b := path[i];
        if (b == 92) || (b == 34) {
            c.out.push(92);
        }
        c.out.push(b);
    }
    return ();
}

// ---- per-module emission (B1 stage 1) ----
// `--split` writes one assembly file per module instead of one for the whole program. Emission stays
// a single stream, because the whole-program optimizer, generic specialisation and closure lowering
// all reach across modules; the stream is split after lowering, at the boundaries recorded here. A
// marker line opens a run of one module's code and carries the `.text` directive that starts its
// file. Markers are top-level lines, so optimize copies them through untouched and reports where
// they landed; the parts minus those markers are the single-file stream, which is what
// tools/split-test.mjs checks.
fn part<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    if c.split == 0 {
        return ();
    }
    if same(view(c.part), view(name)) {
        // Still the same module: the run continues, and its file already has its `.text`.
        return ();
    }
    c.part = name.copy();
    o(&mut c, view(".grail_part "));
    o(&mut c, name);
    o(&mut c, view("\n.text\n"));
    return ();
}
// Decimal digits of a synthetic module suffix plus one, or 0 when the suffix is not a number.
fn module_index<a>(name: &a [u8], from: u64) -> u64 {
    if name.len() <= from {
        return 0;
    }
    mut n = 0;
    mut i = from;
    while i < name.len() {
        d := name[i];
        if (d < 48) || (57 < d) {
            return 0;
        }
        n = n * 10 + (d - 48);
        i += 1;
    }
    return n + 1;
}
// The source module of an emission unit. `.impl_N` and `.inherent_N` are mangling names for one
// declaration inside a file, not modules a build could name, so they resolve to the module that
// file declares; every other name is already the module.
fn unit_module<a, b>(c: (&a mut C), m: &b [u8]) -> u8[] {
    if starts_with(view(m), view(".impl_")) {
        n := module_index(view(m), 6);
        if (n != 0) & (n <= c.implementations.len()) {
            return c.implementations[n - 1].module.copy();
        }
    }
    if starts_with(view(m), view(".inherent_")) {
        n := module_index(view(m), 10);
        if (n != 0) & (n <= c.decls.len()) {
            return c.decls[n - 1].module.copy();
        }
    }
    return m.copy();
}
// A part file name: `STEM.NNN.module.s`, numbered in stream order so the manifest order is also the
// order `ls` shows. Characters that are not identifier-safe become '_' (a module name is an
// identifier, so this only guards against a name that failed to resolve).
fn part_file<a, b, d>(stem: &a [u8], seq: u64, name: &b [u8], ext: &d [u8]) -> u8[] {
    mut out = stem.copy();
    out.push(46);
    if seq < 10 {
        push_bytes(&mut out, view("00"));
    } else {
        if seq < 100 {
            out.push(48);
        }
    }
    decimal(&mut out, seq);
    out.push(46);
    for i in name.len() {
        b := name[i];
        if ((97 <= b) & (b <= 122)) || ((65 <= b) & (b <= 90)) || ((48 <= b) & (b <= 57)) || (b == 95) {
            out.push(b);
        } else {
            out.push(95);
        }
    }
    push_bytes(&mut out, view(ext));
    return out;
}
// `PATH.s` -> `PATH`: the stem the part files and the manifest are named from.
fn path_stem<a>(path: &a [u8]) -> u8[] {
    mut n = path.len();
    if (n > 1) & (path[n - 1] == 115) & (path[n - 2] == 46) {
        n = n - 2;
    }
    mut out = u8[];
    for i in n {
        out.push(path[i]);
    }
    return out;
}
// Write the parts of one lowered image plus the manifest the driver reads back: the part files in
// link order, then the `// grail-link:` request that a single-file build carries at the head of its
// assembly. The optimizer reported where each marker landed, so a part is written as a slice of the
// stream — splitting costs no copy — and every run already starts with its own `.text` directive.
fn write_parts<a, b, d>(c: (&a mut C), path: &b [u8], text: &d [u8]) -> u64 {
    stem := path_stem(view(path));
    mut files = u8[][];
    mut status: u64 = 0;
    for k in c.marks.len() {
        // Past the `.grail_part NAME` line: the run begins at the `.text` directive under it.
        start := c.marks[k] + 12 + c.part_names[k].len() + 1;
        mut end = text.len();
        if k + 1 < c.marks.len() {
            end = c.marks[k + 1];
        }
        if end > start {
            file := part_file(view(stem), files.len(), view(c.part_names[k]), view(".s"));
            if host::write_file(view(file), view((text[start: end]))) != 0 {
                status = 1;
            }
            files.push(file);
        }
    }
    if files.len() == 0 {
        fail(&mut c, view("--split produced no module output"));
    }
    mut manifest = copy_bytes(view("// grail-parts 1\n"));
    for i in files.len() {
        push_bytes(&mut manifest, view(files[i]));
        manifest.push(10);
    }
    for i in c.libs.len() {
        push_bytes(&mut manifest, view("// grail-link: "));
        push_bytes(&mut manifest, view(c.libs[i]));
        manifest.push(10);
    }
    mut manifest_path = u8[];
    push_bytes(&mut manifest_path, view(stem));
    push_bytes(&mut manifest_path, view(".parts"));
    if host::write_file(view(manifest_path), view(manifest)) != 0 {
        status = 1;
    }
    return status;
}
// The one assembly write point: the whole-program image when --split is off, one file per module
// plus a manifest when it is on.
fn write_image<a, b, d>(c: (&a mut C), path: &b [u8], image: &d [u8]) -> u64 {
    if c.split != 0 {
        return write_parts(&mut c, view(path), view(image));
    }
    return host::write_file(view(path), view(with_link_notes(&c.libs, view(image))));
}
fn contains_text<a, b>(text: &a [u8], needle: &b [u8]) -> bool {
    if needle.len() > text.len() {
        return false;
    }
    mut i = 0;
    while i + needle.len() <= text.len() {
        mut j = 0;
        mut ok = 1;
        while j < needle.len() {
            if text[i + j] != needle[j] {
                ok = 0;
            }
            j += 1;
        }
        if ok != 0 {
            return true;
        }
        i += 1;
    }
    return false;
}
// `.loc` before a literal section switch is dropped by the assembler, so re-assert the last
// source location after every `.popsection`. This keeps the first statement of a function on the
// line table even when it starts by pushing a string literal.
fn debug_locs<a>(text: &a [u8]) -> u8[] {
    mut out = u8[];
    mut loc = u8[];
    mut line = u8[];
    for i in text.len() {
        b := text[i];
        line.push(b);
        if b == 10 {
            if starts_with(view(line), view(".loc ")) || starts_with(view(line), view(".cv_loc ")) {
                mut fresh = u8[];
                for k in line.len() {
                    fresh.push(line[k]);
                }
                exchange(&mut loc, fresh);
            }
            for k in line.len() {
                out.push(line[k]);
            }
            if contains_text(view(line), view(".popsection")) {
                for k in loc.len() {
                    out.push(loc[k]);
                }
            }
            exchange(&mut line, u8[]);
        }
    }
    if line.len() != 0 {
        for k in line.len() {
            out.push(line[k]);
        }
    }
    return out;
}
fn source_line<a>(c: &a C, pos: u64) -> u64 {
    mut line = 1;
    if c.toks.len() <= pos {
        return line;
    }
    st := c.toks[pos].start;
    for i in st {
        if c.src[i] == 10 {
            line += 1;
        }
    }
    return line;
}
// ---- DWARF .debug_info emission (Linux x86-64) ----
fn dput<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
    return ();
}
fn dnum<a>(out: (&a mut u8[]), n: u64) -> unit {
    if 9 < n {
        dnum(&mut out, div(n, 10));
    }
    out.push(48 + n % 10);
    return ();
}
fn duleb<a>(out: (&a mut u8[]), n: u64) -> unit {
    dput(&mut out, view(".uleb128 "));
    dnum(&mut out, n);
    dput(&mut out, view("\n"));
    return ();
}
fn dpath<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    for i in text.len() {
        b := text[i];
        if (b == 92) || (b == 34) {
            out.push(92);
        }
        out.push(b);
    }
    return ();
}
fn dstring<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    dput(&mut out, view(".asciz \""));
    dpath(&mut out, text);
    dput(&mut out, view("\"\n"));
    return ();
}
fn dattr<a>(out: (&a mut u8[]), code: u64, form: u64) -> unit {
    dput(&mut out, view(".uleb128 "));
    dnum(&mut out, code);
    dput(&mut out, view("\n.uleb128 "));
    dnum(&mut out, form);
    dput(&mut out, view("\n"));
    return ();
}
// Raw SLEB128 bytes for a negative value -n (n > 0), using exact floor division.
fn sleb_neg<a>(out: (&a mut u8[]), n: u64) -> unit {
    mut v: i64 = 0 - i64(n);
    while true {
        mut b: i64 = v % 128;
        if b < 0 {
            b = b + 128;
        }
        v = (v - b) / 128;
        if ((v == 0) && (b < 64)) || ((v == i64(0) - i64(1)) && (64 <= b)) {
            out.push(u64(b));
            return ();
        }
        out.push(u64(b + 128));
    }
}
// DW_OP_fbreg with a SLEB128 -offset, where offset is the rbp slot distance.
fn dlocation<a>(out: (&a mut u8[]), slot: u64) -> unit {
    mut expr = u8[];
    expr.push(145);
    sleb_neg(&mut expr, (slot + 1) * 8);
    duleb(&mut out, expr.len());
    for i in expr.len() {
        dput(&mut out, view(".byte "));
        dnum(&mut out, expr[i]);
        dput(&mut out, view("\n"));
    }
    return ();
}
// DWARF base types for a Grail value held in an 8-byte slot. Integers, floats, bool and char
// are exact (all targets are little-endian, so a narrow value's bytes start the slot; an f32
// slot holds the binary64 word of its value and is described as an 8-byte float); a
// string, record or other owned value is shown as its 8-byte handle, named after its type.
fn debug_type_name<a>(c: (&a mut C), ty: u64) -> u8[] {
    mut out = u8[];
    if ty == 0 {
        push_bytes(&mut out, view("u64"));
        return out;
    }
    k := ty_kind(&mut c, ty);
    if k == 18 {
        if ty_mode(&mut c, ty) != 0 {
            out.push(105);
        } else {
            out.push(117);
        }
        decimal(&mut out, ty_arg(&mut c, ty));
        return out;
    }
    if k == 21 {
        if is_f32(&mut c, ty) {
            push_bytes(&mut out, view("f32"));
        } else {
            push_bytes(&mut out, view("f64"));
        }
        return out;
    }
    if k == 19 {
        push_bytes(&mut out, view("bool"));
        return out;
    }
    if k == 22 {
        push_bytes(&mut out, view("char"));
        return out;
    }
    if k == 3 {
        push_bytes(&mut out, view("string"));
        return out;
    }
    if k == 8 {
        d := ty_arg(&mut c, ty);
        push_bytes(&mut out, view(c.decls[d].name));
        return out;
    }
    push_bytes(&mut out, view("word"));
    return out;
}
fn debug_type_encoding<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 7;
    }
    k := ty_kind(&mut c, ty);
    if k == 18 {
        if ty_mode(&mut c, ty) != 0 {
            return 5;
        }
        return 7;
    }
    if k == 21 {
        return 4;
    }
    if k == 19 {
        return 2;
    }
    if k == 22 {
        return 16;
    }
    return 7;
}
fn debug_type_size<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    if k == 18 {
        return ty_arg(&mut c, ty) / 8;
    }
    // An f32 value is held as the binary64 word of its value, so its slot reads as a double.
    if k == 22 {
        return 4;
    }
    return 8;
}
fn record_debug_func<a, b, d>(c: (&a mut C), name: &b [u8], module: &d [u8], site: &DebugSite) -> unit {
    mut vars = DebugVar[];
    for i in c.debug_vars.len() {
        l := &c.debug_vars[i];
        vars.push(
            DebugVar {
                name: copy_bytes(view(l.name)),
                slot: l.slot,
                line: l.line,
                param: l.param,
                tname: copy_bytes(view(l.tname)),
                tenc: l.tenc,
                tsize: l.tsize
            }
        );
    }
    c
        .debug_funcs
        .push(
            DebugFunc {
                name: copy_bytes(view(name)),
                module: copy_bytes(view(module)),
                file: site.file,
                line: site.line,
                start: site.start,
                end: site.end,
                params: site.params,
                vars: vars
            }
        );
    return ();
}
// CodeView type index for a debug slot: a predefined base type (so no .debug$T stream is needed).
// Owned values (strings, records, vectors) are shown as their 64-bit handle, as in DWARF.
fn cv_type<a>(v: &a DebugVar) -> u64 {
    if v.tenc == 4 {
        // T_REAL64 (an f32 slot holds the binary64 word of its value).
        return 65;
    }
    if v.tenc == 2 {
        // T_BOOL08
        return 48;
    }
    if v.tenc == 16 {
        // T_CHAR32
        return 123;
    }
    if v.tenc == 5 {
        // T_CHAR, T_SHORT, T_INT4, T_QUAD
        if v.tsize == 1 {
            return 16;
        }
        if v.tsize == 2 {
            return 17;
        }
        if v.tsize == 4 {
            return 116;
        }
        return 19;
    }
    name := view(v.tname);
    if (2 <= name.len()) & (name[0] == 117) & (48 <= name[1]) & (name[1] <= 57) {
        // T_UCHAR, T_USHORT, T_UINT4, T_UQUAD
        if v.tsize == 1 {
            return 32;
        }
        if v.tsize == 2 {
            return 33;
        }
        if v.tsize == 4 {
            return 117;
        }
        return 35;
    }
    if same(name, view("word")) {
        return 35;
    }
    // T_64PVOID
    return 1539;
}
fn cv_label<a>(out: (&a mut u8[]), name: &a [u8], i: u64, j: u64) -> unit {
    push_bytes(&mut out, view(".Lcv"));
    push_bytes(&mut out, name);
    decimal(&mut out, i);
    out.push(95);
    decimal(&mut out, j);
    return ();
}
// A CodeView symbol record: the 2-byte length, then kind and body up to a 4-byte boundary.
fn cv_record_start<a>(out: (&a mut u8[]), i: u64, j: u64, kind: u64) -> unit {
    push_bytes(&mut out, view(".short "));
    cv_label(&mut out, view("e"), i, j);
    out.push(45);
    cv_label(&mut out, view("s"), i, j);
    out.push(10);
    cv_label(&mut out, view("s"), i, j);
    push_bytes(&mut out, view(":\n.short "));
    decimal(&mut out, kind);
    out.push(10);
    return ();
}
fn cv_record_end<a>(out: (&a mut u8[]), i: u64, j: u64) -> unit {
    push_bytes(&mut out, view(".p2align 2\n"));
    cv_label(&mut out, view("e"), i, j);
    push_bytes(&mut out, view(":\n"));
    return ();
}
// The DEBUG_S_SYMBOLS subsection: per function an S_GPROC32 over its .L range, an S_FRAMEPROC
// naming rbp as the frame register, an S_REGREL32 per parameter and local at rbp-8*(slot+1)
// (the slot DWARF's fbreg describes), and S_END. lld-link links the scopes into the PDB.
fn codeview_symbols<a>(c: &a C) -> u8[] {
    mut out = u8[];
    push_bytes(&mut out, view(".long 241\n.long .Lcvsyms_end-.Lcvsyms\n.Lcvsyms:\n"));
    for i in c.debug_funcs.len() {
        f := &c.debug_funcs[i];
        fstart := f.start;
        fend := f.end;
        mut range = u8[];
        push_bytes(&mut range, view(".long .L"));
        decimal(&mut range, fend);
        push_bytes(&mut range, view("-.L"));
        decimal(&mut range, fstart);
        range.push(10);
        cv_record_start(&mut out, i, 0, 4368);
        // parent, end, next: lld-link fills the scope links.
        push_bytes(&mut out, view(".long 0\n.long 0\n.long 0\n"));
        push_bytes(&mut out, view(range));
        push_bytes(&mut out, view(".long 0\n"));
        push_bytes(&mut out, view(range));
        push_bytes(&mut out, view(".long 0\n.secrel32 .L"));
        decimal(&mut out, fstart);
        push_bytes(&mut out, view("\n.secidx .L"));
        decimal(&mut out, fstart);
        push_bytes(&mut out, view("\n.byte 0\n.asciz \""));
        if f.module.len() != 0 {
            push_bytes(&mut out, view(f.module));
            push_bytes(&mut out, view("::"));
        }
        push_bytes(&mut out, view(f.name));
        push_bytes(&mut out, view("\"\n"));
        cv_record_end(&mut out, i, 0);
        // S_FRAMEPROC: locals and parameters are addressed from rbp (encoded register 2).
        cv_record_start(&mut out, i, 1, 4114);
        push_bytes(&mut out, view(".long 0\n.long 0\n.long 0\n.long 0\n.long 0\n.short 0\n.long 163840\n"));
        cv_record_end(&mut out, i, 1);
        for j in f.vars.len() {
            v := &f.vars[j];
            cv_record_start(&mut out, i, j + 2, 4369);
            push_bytes(&mut out, view(".long -"));
            decimal(&mut out, (v.slot + 1) * 8);
            push_bytes(&mut out, view("\n.long "));
            decimal(&mut out, cv_type(&v));
            // CV_AMD64_RBP
            push_bytes(&mut out, view("\n.short 334\n.asciz \""));
            push_bytes(&mut out, view(v.name));
            push_bytes(&mut out, view("\"\n"));
            cv_record_end(&mut out, i, j + 2);
        }
        push_bytes(&mut out, view(".short 2\n.short 6\n"));
    }
    push_bytes(&mut out, view(".Lcvsyms_end:\n"));
    return out;
}
fn debug_sections<a, b>(c: &a C, entry: &b [u8]) -> u8[] {
    mut out = u8[];
    if c.debug == 0 {
        return out;
    }
    dput(&mut out, view(".section .debug_abbrev,\"\",@progbits\n"));
    dput(&mut out, view(".Ldebug_abbrev:\n"));
    // 1: compile unit, children.
    duleb(&mut out, 1);
    dput(&mut out, view(".uleb128 17\n.byte 1\n"));
    dattr(&mut out, 0x25, 0x08);
    dattr(&mut out, 0x13, 0x0b);
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x1b, 0x08);
    dattr(&mut out, 0x11, 0x01);
    dattr(&mut out, 0x12, 0x07);
    dattr(&mut out, 0x10, 0x17);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 2: subprogram, children.
    duleb(&mut out, 2);
    dput(&mut out, view(".uleb128 46\n.byte 1\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x6e, 0x08);
    dattr(&mut out, 0x11, 0x01);
    dattr(&mut out, 0x12, 0x07);
    dattr(&mut out, 0x3a, 0x0b);
    dattr(&mut out, 0x3b, 0x0f);
    dattr(&mut out, 0x40, 0x18);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 3: formal parameter, no children.
    duleb(&mut out, 3);
    dput(&mut out, view(".uleb128 5\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x02, 0x18);
    dattr(&mut out, 0x3b, 0x0f);
    dattr(&mut out, 0x49, 0x13);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 4: local variable, no children.
    duleb(&mut out, 4);
    dput(&mut out, view(".uleb128 52\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x02, 0x18);
    dattr(&mut out, 0x3b, 0x0f);
    dattr(&mut out, 0x49, 0x13);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 5: base type: name, encoding, byte size.
    duleb(&mut out, 5);
    dput(&mut out, view(".uleb128 36\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x3e, 0x0b);
    dattr(&mut out, 0x0b, 0x0b);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    dput(&mut out, view(".byte 0\n"));

    dput(&mut out, view(".section .debug_info,\"\",@progbits\n"));
    dput(&mut out, view(".long .Ldebug_cu_end-.Ldebug_cu_start\n"));
    dput(&mut out, view(".Ldebug_cu_start:\n.short 4\n.long .Ldebug_abbrev\n.byte 8\n"));
    duleb(&mut out, 1);
    dstring(&mut out, view("grail"));
    dput(&mut out, view(".byte 12\n"));
    dstring(&mut out, entry);
    dstring(&mut out, view("."));
    mut first_start = 0;
    mut last_end = 0;
    if c.debug_funcs.len() != 0 {
        first_start = c.debug_funcs[0].start;
        last_end = c.debug_funcs[c.debug_funcs.len() - 1].end;
    }
    if c.debug_funcs.len() == 0 {
        dput(&mut out, view(".quad 0\n.quad 0\n.long 0\n"));
    } else {
        dput(&mut out, view(".quad .L"));
        dnum(&mut out, first_start);
        dput(&mut out, view("\n.quad .L"));
        dnum(&mut out, last_end);
        dput(&mut out, view("-.L"));
        dnum(&mut out, first_start);
        dput(&mut out, view("\n.long 0\n"));
    }
    // One base-type DIE per distinct type name, labelled .Ldebug_type_N; DW_AT_type is the
    // CU-relative offset (from the unit length field, four bytes before .Ldebug_cu_start).
    mut tnames = u8[][];
    for i in c.debug_funcs.len() {
        f := &c.debug_funcs[i];
        for j in f.vars.len() {
            v := &f.vars[j];
            if debug_type_index(&tnames, view(v.tname)) == tnames.len() {
                tnames.push(copy_bytes(view(v.tname)));
                dput(&mut out, view(".Ldebug_type_"));
                dnum(&mut out, tnames.len() - 1);
                dput(&mut out, view(":\n"));
                duleb(&mut out, 5);
                dstring(&mut out, view(v.tname));
                dput(&mut out, view(".byte "));
                dnum(&mut out, v.tenc);
                dput(&mut out, view("\n.byte "));
                dnum(&mut out, v.tsize);
                dput(&mut out, view("\n"));
            }
        }
    }

    for i in c.debug_funcs.len() {
        f := &c.debug_funcs[i];
        duleb(&mut out, 2);
        dstring(&mut out, view(f.name));
        mut link = u8[];
        dput(&mut link, view("f_"));
        for k in f.module.len() {
            link.push(f.module[k]);
        }
        link.push(95);
        for k in f.name.len() {
            link.push(f.name[k]);
        }
        dstring(&mut out, view(link));
        dput(&mut out, view(".quad .L"));
        dnum(&mut out, f.start);
        dput(&mut out, view("\n.quad .L"));
        dnum(&mut out, f.end);
        dput(&mut out, view("-.L"));
        dnum(&mut out, f.start);
        dput(&mut out, view("\n.byte "));
        dnum(&mut out, f.file);
        dput(&mut out, view("\n.uleb128 "));
        dnum(&mut out, f.line);
        // DW_AT_frame_base: the frame-pointer register (rbp = DWARF 6, x29 = 29, s0 = x8).
        dput(&mut out, view("\n.byte 1\n.byte "));
        if c.target == 1 {
            dnum(&mut out, 80 + 29);
        } else {
            if c.target == 2 {
                dnum(&mut out, 80 + 8);
            } else {
                dnum(&mut out, 80 + 6);
            }
        }
        dput(&mut out, view("\n"));
        for j in f.vars.len() {
            v := &f.vars[j];
            mut code = 4;
            if v.param != 0 {
                code = 3;
            }
            duleb(&mut out, code);
            dstring(&mut out, view(v.name));
            dlocation(&mut out, v.slot);
            dput(&mut out, view(".uleb128 "));
            dnum(&mut out, v.line);
            dput(&mut out, view("\n.long .Ldebug_type_"));
            dnum(&mut out, debug_type_index(&tnames, view(v.tname)));
            dput(&mut out, view("-.Ldebug_cu_start+4\n"));
        }
        dput(&mut out, view(".byte 0\n"));
    }
    dput(&mut out, view(".byte 0\n.Ldebug_cu_end:\n"));
    return out;
}
fn debug_type_index<a, b>(names: &a u8[][], name: &b [u8]) -> u64 {
    for i in names.len() {
        if same(view(names[i]), view(name)) {
            return i;
        }
    }
    return names.len();
}
// Source line/column of the current token. The assembler turns .loc into .debug_line.
fn emit_loc<a>(c: (&a mut C)) -> unit {
    if c.debug == 0 {
        return ();
    }
    p := c.pos;
    if c.toks.len() <= p {
        return ();
    }
    t := &c.toks[p];
    st := t.start;
    mut line = 1;
    mut column = 1;
    for i in st {
        if c.src[i] == 10 {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    file := c.file - 1;
    if c.target == 3 {
        if c.validating != 0 {
            return (); // no function id is open while validating
        }
        fid := c.debug_funcs.len();
        o(&mut c, view(".cv_loc "));
        on(&mut c, fid);
        c.out.push(32);
    } else {
        o(&mut c, view(".loc "));
    }
    on(&mut c, file);
    c.out.push(32);
    on(&mut c, line);
    c.out.push(32);
    on(&mut c, column);
    c.out.push(10);
    return ();
}
// 0 is ELF/Linux syscalls, 1 is Mach-O/macOS libSystem. CPU selection stays in `target`.
fn darwin<a>(c: (&a mut C)) -> u64 {
    return c.plat;
}
// Mach-O names every C symbol with a leading underscore; ELF does not.
fn sym<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    if c.plat == 1 {
        c.out.push(95);
    }
    o(&mut c, name);
    return ();
}
fn rodata<a>(c: (&a mut C)) -> unit {
    if c.plat == 1 {
        o(&mut c, view(".pushsection __TEXT,__const\n"));
        return ();
    }
    o(&mut c, view(".pushsection .rodata\n"));
    return ();
}
fn copy_to<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    for i in s.len() {
        out.push(s[i]);
    }
    return ();
}
// Mach-O gives every C symbol a leading underscore. Direct calls and address materialisation
// emitted from compiler literals use the bare Grail name, so they are prefixed in one place;
// imported libSystem symbols already carry the underscore and are left alone.
fn darwin_line<a, b>(out: (&a mut u8[]), line: &b [u8]) -> unit {
    mut space = line.len();
    for i in line.len() {
        if line[i] == 32 {
            space = i;
            break;
        }
    }
    if space == line.len() {
        copy_to(&mut out, line);
        return ();
    }
    op := line[: space];
    rest := line[space + 1:];
    mut bare = 0;
    if rest.len() != 0 {
        if ((65 <= rest[0]) && (rest[0] <= 90)) || ((97 <= rest[0]) && (rest[0] <= 122)) {
            bare = 1;
        }
    }
    if (same(view(op), view("call")) || same(view(op), view("leaq"))) && bare != 0 {
        copy_to(&mut out, line[: space + 1]);
        out.push(95);
        copy_to(&mut out, rest);
        return ();
    }
    copy_to(&mut out, line);
    return ();
}
fn darwinify<a>(input: &a [u8]) -> u8[] {
    mut out = u8[];
    mut start = 0;
    for i in input.len() {
        if input[i] == 10 {
            darwin_line(&mut out, view(input[start: i]));
            out.push(10);
            start = i + 1;
        }
    }
    return out;
}
// The token text already holds the quotes; symbol names never need escapes.
fn symbol_literal<a>(c: (&a mut C)) -> u8[] {
    if kind(&mut c) != 3 {
        fail(&mut c, view("expected an imported symbol name string"));
    }
    p := c.pos;
    t := tok_text(&mut c, p);
    advance(&mut c);
    if t.len() < 3 {
        fail(&mut c, view("empty imported symbol name"));
    }
    return (t[1: t.len() - 1]).copy();
}

fn fresh<a>(c: (&a mut C)) -> u64 {
    id := c.next;
    exchange(&mut c.next, id + 1);
    return id;
}

fn val(t: u64, ty: u64) -> Val {
    return Val { t: t, ty: ty };
}

// Every intermediate and binding has an rbp-relative eight-byte stack slot.
fn stack_slot<a>(c: (&a mut C), id: u64) -> unit {
    c.out.push(45);
    on(&mut c, (id + 1) * 8);
    o(&mut c, view("(%rbp)"));
    return ();
}
// ---- host TLS bridge (Linux x86-64) ----
// The runtime installs its worker record as the hardware thread pointer
// (`arch_prctl(ARCH_SET_FS)`), which is where the dynamic loader keeps its TCB
// (errno, tcache, stack guard). Foreign calls therefore run on the loader's TLS
// base and exported callbacks run on Grail's, restoring the other on the way out.
// Linux keeps libc's TCB in the thread pointer the Grail runtime also uses (x86-64 FS base,
// AArch64 tpidr_el0, RISC-V tp), so foreign calls and callbacks swap it. x86-64 needs the
// arch_prctl system call; AArch64 and RISC-V write the register directly (tpget/tpset).
fn tls_bridge<a>(c: (&a mut C)) -> bool {
    return (c.plat == 0) && ((c.target == 0) || (c.target == 1) || (c.target == 2));
}
fn tls_bss<a>(c: (&a mut C)) -> unit {
    if c.split != 0 {
        o(&mut c, view(".globl rt_state\n.globl rt_host_tls\n.globl rt_grail_tls\n"));
    }
    if tls_bridge(&mut c) {
        o(&mut c, view("ud2\n.bss\n.p2align 3\nrt_state: .zero 4096\nrt_host_tls: .zero 8\nrt_grail_tls: .zero 8\n"));
    } else {
        o(&mut c, view("ud2\n.bss\n.p2align 3\nrt_state: .zero 4096\n"));
    }
    o(&mut c, view(".section .note.GNU-stack,\"\",@progbits\n"));
    return ();
}
fn tls_capture<a>(c: (&a mut C)) -> unit {
    if c.target != 0 {
        o(&mut c, view("tpget\nmovq %rax,rt_host_tls(%rip)\n"));
        return ();
    }
    o(&mut c, view("movl $4099,%edi\nleaq rt_host_tls(%rip),%rsi\nmovl $158,%eax\nsyscall\n"));
    return ();
}
fn tls_get<a>(c: (&a mut C), slot: u64) -> unit {
    if c.target != 0 {
        o(&mut c, view("tpget\nmovq %rax,"));
        stack_slot(&mut c, slot);
        c.out.push(10);
        return ();
    }
    o(&mut c, view("movl $4099,%edi\nleaq "));
    stack_slot(&mut c, slot);
    o(&mut c, view(",%rsi\nmovl $158,%eax\nsyscall\n"));
    return ();
}
fn tls_set_global<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    o(&mut c, view("movq "));
    o(&mut c, name);
    if c.target != 0 {
        o(&mut c, view("(%rip),%rdi\ntpset\n"));
        return ();
    }
    o(&mut c, view("(%rip),%rsi\nmovl $4098,%edi\nmovl $158,%eax\nsyscall\n"));
    return ();
}
fn tls_set_slot<a>(c: (&a mut C), slot: u64) -> unit {
    o(&mut c, view("movq "));
    stack_slot(&mut c, slot);
    if c.target != 0 {
        o(&mut c, view(",%rdi\ntpset\n"));
        return ();
    }
    o(&mut c, view(",%rsi\nmovl $4098,%edi\nmovl $158,%eax\nsyscall\n"));
    return ();
}
fn save<a>(c: (&a mut C)) -> u64 {
    n := fresh(&mut c);
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, n);
    c.out.push(10);
    return n;
}
fn get<a, b>(c: (&a mut C), id: u64, reg: &b [u8]) -> unit {
    o(&mut c, view("movq "));
    stack_slot(&mut c, id);
    c.out.push(44);
    o(&mut c, reg);
    c.out.push(10);
    return ();
}
fn label<a>(c: (&a mut C)) -> u64 {
    n := c.label;
    exchange(&mut c.label, n + 1);
    return n;
}
fn lname<a>(c: (&a mut C), n: u64) -> unit {
    o(&mut c, view(".L"));
    on(&mut c, n);
    return ();
}
fn mark<a>(c: (&a mut C), n: u64) -> unit {
    lname(&mut c, n);
    o(&mut c, view(":\n"));
    return ();
}
fn jump<a, b>(c: (&a mut C), op: &b [u8], n: u64) -> unit {
    o(&mut c, op);
    c.out.push(32);
    lname(&mut c, n);
    c.out.push(10);
    return ();
}

// Win32 imports the compiler may name. The value is the fixed argument count; the runtime layer
// passes exactly that many words. Unknown names are rejected at compile time.
fn win32_arity<a>(name: (&a [u8])) -> u64 {
    if same(view(name), view("ExitProcess")) {
        return 1;
    }
    if same(view(name), view("ExitThread")) {
        return 1;
    }
    if same(view(name), view("GetStdHandle")) {
        return 1;
    }
    if same(view(name), view("GetCommandLineA")) {
        return 0;
    }
    if same(view(name), view("GetEnvironmentStringsA")) {
        return 0;
    }
    if same(view(name), view("GetEnvironmentVariableA")) {
        return 3;
    }
    if same(view(name), view("GetCurrentProcessId")) {
        return 0;
    }
    if same(view(name), view("GetLastError")) {
        return 0;
    }
    if same(view(name), view("GetFileAttributesA")) {
        return 1;
    }
    if same(view(name), view("GetSystemTimeAsFileTime")) {
        return 1;
    }
    if same(view(name), view("GetTickCount64")) {
        return 0;
    }
    if same(view(name), view("WriteFile")) {
        return 5;
    }
    if same(view(name), view("ReadFile")) {
        return 5;
    }
    if same(view(name), view("CreateFileA")) {
        return 7;
    }
    if same(view(name), view("CloseHandle")) {
        return 1;
    }
    if same(view(name), view("FlushFileBuffers")) {
        return 1;
    }
    if same(view(name), view("VirtualAlloc")) {
        return 4;
    }
    if same(view(name), view("CreateThread")) {
        return 6;
    }
    if same(view(name), view("WaitForSingleObject")) {
        return 2;
    }
    if same(view(name), view("WaitOnAddress")) {
        return 4;
    }
    if same(view(name), view("WakeByAddressSingle")) {
        return 1;
    }
    if same(view(name), view("WakeByAddressAll")) {
        return 1;
    }
    if same(view(name), view("CoInitializeEx")) {
        return 2;
    }
    if same(view(name), view("CoUninitialize")) {
        return 0;
    }
    if same(view(name), view("VirtualFree")) {
        return 3;
    }
    if same(view(name), view("Sleep")) {
        return 1;
    }
    if same(view(name), view("SwitchToThread")) {
        return 0;
    }
    if same(view(name), view("DeleteFileA")) {
        return 1;
    }
    if same(view(name), view("RemoveDirectoryA")) {
        return 1;
    }
    if same(view(name), view("CreateDirectoryA")) {
        return 2;
    }
    if same(view(name), view("MoveFileA")) {
        return 2;
    }
    if same(view(name), view("TerminateProcess")) {
        return 2;
    }
    if same(view(name), view("SetFilePointerEx")) {
        return 4;
    }
    return 18446744073709551615;
}
fn raw_arguments<a>(c: (&a mut C)) -> u64[] {
    mut args = u64[];
    if eat(&mut c, view(")")) {
        return args;
    }
    while true {
        mut v = expr(&mut c, 0);
        get(&mut c, v.t, view("%rax"));
        n := save(&mut c);
        args.push(n);
        if eat(&mut c, view(")")) {
            break;
        }
        expect(&mut c, view(","));
    }
    return args;
}
// ---- PE/COFF unwind data ------------------------------------------------------------------
// The COFF assembler needs absolute prologue values, but frame sizes are only known after code
// generation. The Windows target bypasses the ELF optimizer, so every emitted function has the
// fixed prologue `pushq %rbp / movq %rsp,%rbp / subq $.F<n>,%rsp`. Frame labels restart per
// function, so sizes are collected in emission order and consumed by the .def functions in the
// same order (one `.set .F<n>, <bytes>` line per function).
struct WinUnwind {
    out: u8[],
    symbol: u8[],
    frames: u64[],
    frame_at: u64,
    state: u64
}
fn span_is<a, b>(s: &a [u8], a: u64, e: u64, t: &b [u8]) -> bool {
    if e - a != t.len() {
        return false;
    }
    for i in t.len() {
        if s[a + i] != t[i] {
            return false;
        }
    }
    return true;
}
fn span_has<a, b>(s: &a [u8], a: u64, e: u64, t: &b [u8]) -> bool {
    if e - a < t.len() {
        return false;
    }
    for i in t.len() {
        if s[a + i] != t[i] {
            return false;
        }
    }
    return true;
}
fn span_copy<a>(s: &a [u8], a: u64, e: u64) -> u8[] {
    mut out = u8[];
    for i in e - a {
        out.push(s[a + i]);
    }
    return out;
}
fn put_text(out: (&mut u8[]), t: &[u8]) -> unit {
    for i in t.len() {
        out.push(t[i]);
    }
    return ();
}
fn put_number(out: (&mut u8[]), n: u64) -> unit {
    if 9 < n {
        put_number(&mut out, div(n, 10));
    }
    out.push(48 + n % 10);
    return ();
}
fn push_line(out: (&mut u8[]), text: &[u8], a: u64, e: u64) -> unit {
    for i in e - a {
        out.push(text[a + i]);
    }
    out.push(10);
    return ();
}
fn win_number<a>(s: &a [u8], a: u64, e: u64) -> u64 {
    mut n = 0;
    mut i = a;
    while i < e {
        n = n * 10 + (s[i] - 48);
        i = i + 1;
    }
    return n;
}
fn win_frames<a>(text: &a [u8]) -> u64[] {
    mut frames = u64[];
    mut start = 0;
    mut i = 0;
    while i < text.len() {
        if text[i] == 10 {
            e := i;
            if span_has(view(text), start, e, view(".set .F")) {
                mut comma = start + 5;
                while (comma < e) & (text[comma] != 44) {
                    comma = comma + 1;
                }
                if comma < e {
                    mut digit = comma + 1;
                    if (digit < e) & (text[digit] == 32) {
                        digit = digit + 1;
                    }
                    frames.push(win_number(view(text), digit, e));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return frames;
}
fn win_unwind_line<a, b>(u: (&a mut WinUnwind), text: &b [u8], a: u64, e: u64) -> unit {
    if span_has(view(text), a, e, view(".def ")) {
        u.symbol = span_copy(view(text), a + 5, e);
        u.state = 1;
        push_line(&mut u.out, view(text), a, e);
        return ();
    }
    // Debug builds put a .L range label before the function label and CodeView directives
    // (.cv_func_id, .cv_loc) inside the prologue; neither changes the unwind description.
    if (u.state == 1) || (u.state == 2) {
        if span_has(view(text), a, e, view(".cv_")) {
            push_line(&mut u.out, view(text), a, e);
            return ();
        }
    }
    if u.state == 1 {
        if 2 < e - a {
            if (text[a] == 46) & (text[a + 1] == 76) & (text[e - 1] == 58) {
                push_line(&mut u.out, view(text), a, e);
                return ();
            }
        }
    }
    if u.state == 1 {
        if 0 < e - a {
            if text[e - 1] == 58 {
                push_line(&mut u.out, view(text), a, e);
                put_text(&mut u.out, view(".seh_proc "));
                for i in u.symbol.len() {
                    u.out.push(u.symbol[i]);
                }
                u.out.push(10);
                u.state = 2;
                return ();
            }
        }
    }
    if u.state == 2 {
        if span_is(view(text), a, e, view("pushq %rbp")) {
            push_line(&mut u.out, view(text), a, e);
            put_text(&mut u.out, view(".seh_pushreg %rbp\n"));
            return ();
        }
        if span_is(view(text), a, e, view("movq %rsp,%rbp")) {
            push_line(&mut u.out, view(text), a, e);
            put_text(&mut u.out, view(".seh_setframe %rbp, 0\n"));
            return ();
        }
        if span_has(view(text), a, e, view("subq $.F")) {
            mut frame = 0;
            if u.frame_at < u.frames.len() {
                frame = u.frames[u.frame_at];
            }
            u.frame_at = u.frame_at + 1;
            push_line(&mut u.out, view(text), a, e);
            put_text(&mut u.out, view(".seh_stackalloc "));
            put_number(&mut u.out, frame);
            put_text(&mut u.out, view("\n.seh_endprologue\n"));
            u.state = 3;
            return ();
        }
        // A non-standard prologue keeps no unwind description rather than an inaccurate one.
        u.state = 0;
    }
    if u.state == 3 {
        if span_has(view(text), a, e, view(".set ")) {
            put_text(&mut u.out, view(".seh_endproc\n"));
            u.state = 0;
        }
    }
    push_line(&mut u.out, view(text), a, e);
    return ();
}
// ---- Windows ARM64 unwind data -------------------------------------------------------------
// The ARM64 assembler encodes .seh_* directives into a packed record or a full .xdata structure,
// and validates that the directives cover exactly the prologue bytes. This pass therefore only
// describes the prologue the lowering produced; a function whose shape does not match is left
// without a record instead of getting a wrong one (leaf functions need no record at all).
fn arm_saved_reg<a>(text: &a [u8], a: u64, e: u64) -> u64 {
    if !span_has(view(text), a, e, view("str x")) {
        return 0;
    }
    if !span_has(view(text), a, e, view(",[sp,#-16]!")) {
        return 0;
    }
    mut i = a + 5;
    mut n = 0;
    mut scanning = 1;
    while scanning != 0 {
        if e <= i {
            scanning = 0;
        } else {
            if text[i] == 44 {
                scanning = 0;
            } else {
                if (48 <= text[i]) & (text[i] <= 57) {
                    n = n * 10 + (text[i] - 48);
                }
                i = i + 1;
            }
        }
    }
    if (18 < n) & (n < 29) {
        return n;
    }
    return 0;
}
fn arm_lines<a>(text: &a [u8]) -> u64[] {
    // Pairs of (start, end) offsets flattened into one array.
    mut lines = u64[];
    mut i = 0;
    mut start = 0;
    while i < text.len() {
        if text[i] == 10 {
            lines.push(start);
            lines.push(i);
            start = i + 1;
        }
        i = i + 1;
    }
    if start < text.len() {
        lines.push(start);
        lines.push(text.len());
    }
    return lines;
}
fn arm_unwind<a>(text: &a [u8]) -> u8[] {
    lines := arm_lines(view(text));
    n := lines.len() / 2;
    frames := win_frames(view(text));
    mut syms = u8[][];
    mut ends = u64[];
    mut frame_of = u64[];
    mut kinds = u64[];
    mut at = 0;
    mut li = 0;
    while li < n {
        a := lines[li * 2];
        e := lines[li * 2 + 1];
        if span_has(view(text), a, e, view(".def ")) {
            sym := span_copy(view(text), a + 5, e);
            mut body = li + 1;
            mut found = 0;
            while (found == 0) & (body < n) {
                ba := lines[body * 2];
                be := lines[body * 2 + 1];
                if 0 < be - ba {
                    if text[be - 1] == 58 {
                        found = 1;
                    }
                }
                if found == 0 {
                    body = body + 1;
                }
            }
            mut stop = li + 1;
            while stop < n {
                a2 := lines[stop * 2];
                e2 := lines[stop * 2 + 1];
                if span_has(view(text), a2, e2, view(".def ")) {
                    break;
                }
                if span_has(view(text), a2, e2, view(".bss")) {
                    break;
                }
                stop = stop + 1;
            }
            mut frame = 0;
            if at < frames.len() {
                frame = frames[at];
            }
            at = at + 1;
            mut stp = 0;
            mut fp = 0;
            mut sub = 0;
            mut j = body + 1;
            while j < stop {
                x := lines[j * 2];
                y := lines[j * 2 + 1];
                if span_is(view(text), x, y, view("stp x29,x30,[sp,#-16]!")) {
                    stp = 1;
                }
                if span_is(view(text), x, y, view("mov x29,x10")) {
                    fp = 1;
                }
                if span_is(view(text), x, y, view("sub sp,sp,x10")) {
                    sub = 1;
                }
                j = j + 1;
            }
            mut kind = 0;
            if (stp & fp & sub) != 0 {
                kind = 1;
            }
            syms.push(sym);
            ends.push(stop);
            frame_of.push(frame);
            kinds.push(kind);
            li = stop;
            continue;
        }
        li = li + 1;
    }
    // Frame values are positional, so a mismatch means the shape is not understood: keep the
    // assembly unchanged rather than describe the wrong function.
    if (syms.len() != frames.len()) || (syms.len() == 0) {
        return text.copy();
    }
    mut out = u8[];
    mut cur = 0;
    mut prologue = 0;
    li = 0;
    while li < n {
        if cur < syms.len() {
            if li == ends[cur] {
                arm_close(&mut out, kinds[cur]);
                cur = cur + 1;
                prologue = 0;
            }
        }
        a := lines[li * 2];
        e := lines[li * 2 + 1];
        if cur < syms.len() {
            mut skip = 0;
            if kinds[cur] != 1 {
                skip = 1;
            }
            if skip != 0 {
                push_line(&mut out, view(text), a, e);
                li = li + 1;
                continue;
            }
            mut done = 0;
            if prologue == 0 {
                mut is_label = 0;
                if 0 < e - a {
                    if text[e - 1] == 58 {
                        is_label = 1;
                    }
                }
                if is_label != 0 {
                    mut sym = syms[cur].copy();
                    if span_is(view(text), a, e - 1, view(sym)) {
                        push_line(&mut out, view(text), a, e);
                        put_text(&mut out, view(".seh_proc "));
                        for k in sym.len() {
                            out.push(sym[k]);
                        }
                        out.push(10);
                        prologue = 1;
                        done = 1;
                    }
                }
            } else {
                if span_is(view(text), a, e, view("stp x29,x30,[sp,#-16]!")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_save_regp x29, 0\n"));
                    done = 1;
                }
                if span_is(view(text), a, e, view("mov x10,sp")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_nop\n"));
                    done = 1;
                }
                if span_is(view(text), a, e, view("mov x29,x10")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_set_fp\n"));
                    done = 1;
                }
                if span_has(view(text), a, e, view("movz x10,#((.F")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_nop\n"));
                    done = 1;
                }
                if span_has(view(text), a, e, view("movk x10,#(((")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_nop\n"));
                    done = 1;
                }
                if span_is(view(text), a, e, view("sub sp,sp,x10")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_stackalloc "));
                    put_number(&mut out, frame_of[cur]);
                    put_text(&mut out, view("\n.seh_endprologue\n"));
                    prologue = 0;
                    done = 1;
                }
                saved := arm_saved_reg(view(text), a, e);
                if saved != 0 {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_save_reg x"));
                    put_number(&mut out, saved);
                    put_text(&mut out, view(", 0\n"));
                    done = 1;
                }
            }
            if done != 0 {
                li = li + 1;
                continue;
            }
        }
        push_line(&mut out, view(text), a, e);
        li = li + 1;
    }
    if cur < syms.len() {
        arm_close(&mut out, kinds[cur]);
    }
    return out;
}
// The assembler turns the prologue directives into a full .xdata record.
fn arm_close<a>(out: (&a mut u8[]), kind: u64) -> unit {
    if kind == 1 {
        put_text(&mut out, view(".seh_endproc\n"));
    }
    return ();
}
fn win_unwind<a>(text: &a [u8]) -> u8[] {
    mut u = WinUnwind { out: u8[], symbol: u8[], frames: win_frames(view(text)), frame_at: 0, state: 0 };
    mut start = 0;
    mut i = 0;
    while i < text.len() {
        if text[i] == 10 {
            win_unwind_line(&mut u, view(text), start, i);
            start = i + 1;
        }
        i = i + 1;
    }
    if start < text.len() {
        win_unwind_line(&mut u, view(text), start, text.len());
    }
    return u.out;
}

// PE/COFF objects carry no ELF symbol type; MSVC-style .def records the function class.
fn func_directive<a, b, d>(c: (&a mut C), m: &b [u8], name: &b [u8], symbol: &d [u8], export: u64) -> unit {
    // Mach-O defines a symbol by its label and carries neither .type nor .def records.
    if c.plat == 1 {
        return ();
    }
    // --split assembles one object per module, so a definition another part calls has to be visible
    // to the linker: every function becomes global. The code is unchanged, and the single-file
    // build keeps its local symbols.
    if c.split != 0 {
        o(&mut c, view(".globl "));
        export_name(&mut c, view(m), view(name), view(symbol), export);
        o(&mut c, view("\n"));
    }
    if (c.target == 3) || (c.target == 4) {
        o(&mut c, view(".def "));
        export_name(&mut c, view(m), view(name), view(symbol), export);
        o(&mut c, view("\n.scl 2\n.type 32\n.endef\n"));
        return ();
    }
    o(&mut c, view(".type "));
    export_name(&mut c, view(m), view(name), view(symbol), export);
    o(&mut c, view(",@function\n"));
    return ();
}
fn argreg(i: u64) -> string {
    if i == 0 {
        return "%rdi";
    }
    if i == 1 {
        return "%rsi";
    }
    if i == 2 {
        return "%rdx";
    }
    if i == 3 {
        return "%rcx";
    }
    if i == 4 {
        return "%r8";
    }
    return "%r9";
}
fn imm<a>(c: (&a mut C), n: u64) -> u64 {
    o(&mut c, view("movabsq $"));
    on(&mut c, n);
    o(&mut c, view(",%rax\n"));
    return save(&mut c);
}
// Grail's own calling convention passes six words in registers. A call with more arguments keeps
// the first five in registers and passes the rest in a heap record whose address is the sixth
// register; the callee copies them into its frame and frees the record. ABI-neutral: only
// register moves and loads/stores through a pointer, which every target lowers.
fn load_call_args<a, b>(c: (&a mut C), args: (&b u64[]), shift: u64) -> unit {
    total := args.len() + shift;
    if total <= 6 {
        for i in args.len() {
            r := argreg(i + shift);
            get(&mut c, args[i], view(r));
        }
        return ();
    }
    extra := total - 5;
    n := imm(&mut c, extra);
    record := invoke(&mut c, view("rt_rec"), one(n));
    for k in extra {
        get(&mut c, record, view("%rcx"));
        get(&mut c, args[5 - shift + k], view("%rax"));
        o(&mut c, view("movq %rax,"));
        on(&mut c, k * 8);
        o(&mut c, view("(%rcx)\n"));
    }
    for i in 5 - shift {
        r := argreg(i + shift);
        get(&mut c, args[i], view(r));
    }
    get(&mut c, record, view("%r9"));
    return ();
}
// Prologue: parameter i of `count` into frame slot i (see load_call_args for more than six).
fn store_params<a>(c: (&a mut C), count: u64) -> unit {
    mut regs = count;
    if 6 < count {
        regs = 5;
    }
    for i in regs {
        reg := argreg(i);
        o(&mut c, view("movq "));
        o(&mut c, view(reg));
        c.out.push(44);
        stack_slot(&mut c, i);
        c.out.push(10);
    }
    if 6 < count {
        for k in count - 5 {
            o(&mut c, view("movq "));
            on(&mut c, k * 8);
            o(&mut c, view("(%r9),%rax\nmovq %rax,"));
            stack_slot(&mut c, 5 + k);
            c.out.push(10);
        }
        o(&mut c, view("movq %r9,%rdi\ncall rt_free\n"));
    }
    return ();
}
fn invoke<a, b>(c: (&a mut C), name: &b [u8], args: u64[]) -> u64 {
    if 6 < args.len() {
        // Runtime helpers take at most six words; more would need the spill record.
        fail(&mut c, view("runtime call exceeds six arguments"));
    }
    for i in args.len() {
        mut r = argreg(i);
        get(&mut c, args[i], view(r));
    }
    o(&mut c, view("call "));
    o(&mut c, name);
    c.out.push(10);
    if same(view(name), view("rt_f64_op")) {
        n := c.f64_ops;
        exchange(&mut c.call_ord, n);
        exchange(&mut c.f64_ops, n + 1);
    }
    // The ordinal of this call among the calls to the same callee in this function; the lifter
    // counts the same calls in the same order, so the two agree without either seeing the other.
    mut hit = 0;
    for i in c.f1_names.len() {
        if same(view(c.f1_names[i]), view(name)) {
            n := c.f1_counts[i];
            exchange(&mut c.f1_ord, n);
            exchange(&mut c.f1_counts[i], n + 1);
            hit = 1;
        }
    }
    if hit == 0 {
        exchange(&mut c.f1_ord, 0);
        c.f1_names.push(copy_bytes(view(name)));
        c.f1_counts.push(1);
    }
    return save(&mut c);
}

// Owned values have independent stack flags. Aliased field loads are not owners until moved.
fn needs_drop<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    return (k == 3)
        || (k == 4)
        || (k == 5)
        || (k == 27)
        || (k == 6)
        || (k == 8)
        || (k == 9)
        || (k == 10)
        || (k == 11)
        || (k == 13)
        || (k == 16)
        || (k == 20);
}
fn resource<a>(c: (&a mut C), slot: u64) -> u64 {
    mut i = c.resources.len();
    while i != 0 {
        i = i - 1;
        mut r = &c.resources[i];
        if r.slot == slot {
            return i + 1;
        }
    }
    return 0;
}
fn own<a>(c: (&a mut C), slot: u64, ty: u64) -> Val {
    if c.raw == 0 {
        k := ty_kind(&mut c, ty);
        drops := needs_drop(&mut c, ty);
        if drops || k == 7 {
            mut flag = 0;
            if drops {
                flag = imm(&mut c, 1) + 1;
            }
            place := ownership::root(&mut c.check, 0, 1);
            c
                .resources
                .push(
                    Resource {
                        slot: slot,
                        ty: ty,
                        flag: flag,
                        base: 0,
                        field: 0,
                        via: 0,
                        place: place,
                        target: 0,
                        authority: 0,
                    }
