    // The formal's bounds are known even while its type variables are not: check them against the
    // closure now, while it still has its environment, and let the value carry them from here.
    want := fm & CLOSURE_BOUNDS;
    if !closure_bounds_hold(&mut c, v.ty, want) {
        closure_bound_fail(&mut c, v.ty, want);
