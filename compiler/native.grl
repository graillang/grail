        }
    }
    constraints := function_bounds(borrow(c), index);
    require_constraints(borrow_mut(c), borrow(map), borrow(constraints));
    requirements := function_constraints(borrow(c), index);
    require_interfaces(borrow_mut(c), borrow(map), borrow(requirements));
    mut params = u64[];
    for i in count {
        formal := c.params[first + i];
        bound := bind_types(borrow_mut(c), formal, borrow(map));
        params.push(bound);
    }
    result := bind_types(borrow_mut(c), ret, borrow(map));
    ty := intern_args(borrow_mut(c), 12, result, 0, u64[], params);
    if c.validating {
        return val(imm(borrow_mut(c), 0), ty);
    }
    if contract {
        self := map[0];
        actual := resolve_interface_method(borrow_mut(c), contract, self, &name);
        f := &c.funcs[actual];
