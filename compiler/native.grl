// Bools and integers do not mix (Go, Zig and Rust reject all of these): `&`, `|`, `^` between a bool and
// an integer (`code & (a == 0)` is 2 & 1 == 0), arithmetic on bools (`true + true`), and an integer
// condition (`if n`). Logic is `&&`, `||` and `!`; integers compare explicitly (`n != 0`).
fn strict_bool_check<a>(c: (&a mut C), k: u64, left: u64, right: u64) -> unit {
    lb := is_bool(&mut c, left);
    rb := is_bool(&mut c, right);
    if !lb && !rb {
        return ();
    }
    if lb && rb && (is_comparison(k) || k == 38 || k == 124 || k == 94) {
        return ();
    }
    if lb && rb {
        strict_bool_fail(&mut c, view("arithmetic on bools; use && and || for logic"));
        return ();
    }
    strict_bool_fail(&mut c, view("bool and integer do not mix; use && / || / ! for logic and compare integers explicitly"));
    return ();
}
fn strict_condition<a>(c: (&a mut C), ty: u64) -> unit {
    if !is_bool(&mut c, ty) {
        strict_bool_fail(&mut c, view("a condition must be a bool; compare explicitly (n != 0)"));
    }
    return ();
}
// `==` operands of one record type, or vectors/slices with the same element type in any mix
// (a slice compares with the vector it was cut from, as in Rust).
fn comparable_sequences<a>(c: (&a mut C), left: u64, right: u64) -> u64 {
    if same_type(&mut c, left, right) != 0 {
        return 1;
    }
    lk := ty_kind(&mut c, left);
    rk := ty_kind(&mut c, right);
    if ((lk == 6) || (lk == 27)) && ((rk == 6) || (rk == 27)) {
        le := ty_arg(&mut c, left);
        re := ty_arg(&mut c, right);
        return same_type(&mut c, le, re);
    }
    return 0;
}
// Enforced by default; `--strict-bool-report` prints file:line:column and keeps compiling.
fn strict_bool_fail<a, b>(c: (&a mut C), msg: &b [u8]) -> unit {
    if c.strict_bool_report == 0 {
        fail(&mut c, msg);
        return ();
    }
    p := c.pos;
    t := &c.toks[p];
    st := t.start;
    mut line = 1;
    mut column = 1;
    for i in st {
        if c.src[i] == 10 {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    path := file_path(&mut c, c.file);
    println("{}:{}:{}: {}", view(path), line, column, msg);
    return ();
}
// ---- statements ----
fn block<a>(c: (&a mut C)) -> unit {
    end := block_end(&mut c, c.pos);
    oldend := c.scope_end;
    exchange(&mut c.scope_end, end);
    expect(&mut c, view("{"));
    // One scope of facts per block: what a condition or an arm's pattern stated for it holds here,
    // and a binding's shadowing of a name it mentions ends with it (docs/design/refinements.md).
    pv_ir_open(&mut c);
    mark := c.locals.len();
    mut owners = c.resources.len();
    while !is(&mut c, view("}")) {
        stmt(&mut c);
    }
    advance(&mut c);
    cleanup(&mut c, owners);
    pop_locals(&mut c, mark);
    pv_ir_close(&mut c);
    exchange(&mut c.scope_end, oldend);
    return ();
}
// Last-use ending may retire the lhs reference while parsing the rhs. Retain its
// concrete capability until the store; the pin has no runtime-owned descriptor.
fn pin_assignment<a>(c: (&a mut C), target: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    index := resource(&mut c, target);
    if index == 0 {
        return ();
    }
    r := &c.resources[index - 1];
    authority := r.authority;
    if authority != 0 {
        source := place_of(&mut c, authority - 1);
        if source != 0 {
            slot := imm(&mut c, 0);
            ty := reference_type(&mut c, 0, 0);
            own(&mut c, slot, ty);
            holder := place_of(&mut c, slot);
            return_bonds(&mut c, source, holder, 1);
        }
    }
    return ();
}
fn reserve_compound<a>(c: (&a mut C), slot: u64, through: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    mut place = place_of(&mut c, slot);
    mut authority = authority_of(&mut c, slot);
    if through != 0 {
        place = target_of(&mut c, slot);
    } else {
        authority = 0;
        if place == 0 {
            place = ownership::root(&mut c.check, 1, 1);
            c
                .resources
                .push(
                    Resource {
                        slot: slot,
                        ty: 0,
                        flag: 0,
                        base: 0,
                        field: 0,
                        via: 0,
                        place: place,
                        target: 0,
                        authority: 0,
                    }
                );
        }
    }
    if ownership::status(&c.check, place) != 1 {
        fail(&mut c, view("compound assignment requires initialized numeric storage"));
    }
    mut loan = 0;
    if authority != 0 {
        parent := authority_loan(&mut c, authority, place);
        loan = ownership::reborrow_place(&mut c.check, parent, place, 0);
    } else {
        loan = ownership::borrow_place(&mut c.check, place, 0);
    }
    if loan == 0 {
        borrow_context(&mut c, place, view("modify"));
        fail(&mut c, view("compound assignment target conflicts with live borrow"));
    }
    pin := imm(&mut c, 0);
    ty := reference_type(&mut c, 0, 0);
    own(&mut c, pin, ty);
    holder := place_of(&mut c, pin);
    bond(&mut c, holder, loan);
    return resource(&mut c, pin);
}
fn compound_operator(k: u64) -> u64 {
    if k == 262 {
        return 43;
    }
    if k == 263 {
        return 45;
    }
    if k == 264 {
        return 42;
    }
    if k == 265 {
        return 47;
    }
    if k == 266 {
        return 37;
    }
    return 267;
}
// `xs[i] = v;`, `s.items[i] += v;`, `buf[i] = b;`: the operator token position, or 0.
// Scans an assignment target `name(.f)*(  [..] | .f )*` followed by an assignment operator.
// Returns [operator position, start of the last accessor, bracket groups, 1 if the last accessor
// is a field] or [0, 0, 0, 0] when the statement is not such an assignment.
fn assign_chain<a>(c: (&a mut C)) -> u64[] {
    none := u64[0, 0, 0, 0];
    if kind(&mut c) != 1 {
        return none;
    }
    mut e = c.pos + 1;
    mut groups: u64 = 0;
    mut last: u64 = 0;
    mut field: u64 = 0;
    while true {
        k := kind_at(&mut c, e);
        if (k == 46) & (kind_at(&mut c, e + 1) == 1) {
            // A method call (`.f(`) is not an assignment target.
            if kind_at(&mut c, e + 2) == 40 {
                return none;
            }
            last = e;
            field = 1;
            e = e + 2;
            continue;
        }
        if k == 91 {
            last = e;
            field = 0;
            groups += 1;
            mut depth = 0;
            while true {
                kk := kind_at(&mut c, e);
                if (kk == 0) || (kk == 59) {
                    return none;
                }
                if kk == 91 {
                    depth = depth + 1;
                }
                if kk == 93 {
                    depth = depth - 1;
                    if depth == 0 {
                        break;
                    }
                }
                e = e + 1;
            }
            e = e + 1;
            continue;
        }
        break;
    }
    k := kind_at(&mut c, e);
    if (groups != 0) && ((k == 61) || ((261 < k) && (k < 267)) || (k == 268)) {
        return u64[e, last, groups, field];
    }
    return none;
}
fn index_assignment_ahead<a>(c: (&a mut C)) -> u64 {
    chain := assign_chain(&mut c);
    if chain[3] != 0 {
        return 0;
    }
    return chain[0];
}
// `v[i].f = x`, `v[i][j].f.g += x`: a field store through an indexed place.
fn chained_field_assignment_ahead<a>(c: (&a mut C)) -> bool {
    chain := assign_chain(&mut c);
    return (chain[0] != 0) && (chain[3] != 0);
}
// Combines an old numeric value with an operand for a compound assignment of type ty.
fn compound_value<a>(c: (&a mut C), op: u64, old: u64, v: Val, ty: u64) -> Val {
    if (c.raw == 0) & is_float(&mut c, ty) {
        require_type(&mut c, v.ty, ty);
        if (op != 43) & (op != 45) & (op != 42) & (op != 47) {
            fail(&mut c, view("operator not defined for floats"));
        }
        single := u64(is_f32(&mut c, ty));
        mut value = float_arith(&mut c, op, old, v.t, single);
        return val(value, ty);
    }
    if ty_kind(&mut c, ty) == 18 {
        if c.raw == 0 {
            require_type(&mut c, v.ty, ty);
        }
        r := int_binary(&mut c, op, old, v.t, ty);
        return val(r.t, ty);
    }
    if c.raw == 0 {
        require_type(&mut c, ty, 0);
        require_type(&mut c, v.ty, 0);
    }
    value := binary(&mut c, op, old, v.t);
    return val(value, 0);
}
// Look ahead through named fields without evaluating the target or key.
fn map_assignment_ahead<a>(c: (&a mut C)) -> bool {
    pos := c.pos;
    name := tok_text(&mut c, pos);
    local := find_local(&mut c, view(name));
    if local == 0 {
        return false;
    }
    mut ty = local_ty(&mut c, local - 1);
    mut q = pos + 1;
    while kind_at(&mut c, q) == 46 {
        while ty_kind(&mut c, ty) == 7 {
            ty = ty_arg(&mut c, ty);
