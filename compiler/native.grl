fn seed_storage<a>(c: (&a mut C), storage: u64, ty: u64) -> unit {
    region := region_of(borrow_mut(c), storage);
    if (region == 0) + (region == 18446744073709551615) {
        return ();
    }
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        if ownership::ancestor(borrow(c.check), storage, holder) {
            return ();
        }
    }
    k := ty_kind(borrow_mut(c), ty);
    if (k == 5) + (k == 7) {
        slot := imm(borrow_mut(c), 0);
        c
            .resources
            .push(
                Resource {
                    slot: slot,
                    ty: ty,
                    flag: 0,
                    base: 1,
                    field: 0,
                    via: 1,
                    place: storage,
                    target: 0,
                    authority: 0,
                }
            );
        stored_source(borrow_mut(c), slot, ty);
        return ();
    }
    caps := type_caps(borrow_mut(c), ty, 0);
    for i in caps.len() {
        mut r = caps[i];
        source := external_place(borrow_mut(c), r, 0);
        loan := ownership::borrow_place(borrow_mut(c.check), source, 0);
        bond_kind(borrow_mut(c), storage, loan, 1);
    }
    return ();
}
fn frame_storage<a>(c: (&a mut C), slot: u64, destination: u64) -> unit {
    root := place_of(borrow_mut(c), slot);
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        guard := b.guard;
        loan := b.loan;
        if (holder == root) & guard {
            if loan_live(borrow_mut(c), loan) {
                bond_kind(borrow_mut(c), destination, loan, guard);
            }
        }
    }
    return ();
}
fn storage_bonds<a>(c: (&a mut C), source: u64, destination: u64) -> unit {
    mut owners = u64[];
    n := c.bonds.len();
    if region_of(borrow_mut(c), destination) == 18446744073709551615 {
        for i in n {
            mut b = &c.bonds[i];
            holder := b.holder;
            guard := b.guard;
            loan := b.loan;
            if (guard == 3) & ownership::ancestor(borrow(c.check), destination, holder) {
                if loan_live(borrow_mut(c), loan) {
                    mut l = &c.check.loans[loan - 1];
                    owner := l.source;
                    if region_of(borrow_mut(c), owner) == 0 {
                        owners.push(owner);
                    }
                }
            }
        }
    }
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if ownership::ancestor(borrow(c.check), source, holder) {
            if ((source == destination) & (guard == 3)) == 0 {
                if loan_live(borrow_mut(c), loan) {
                    mut role = guard;
                    if role == 3 {
                        role = 1;
                    }
                    bond_kind(borrow_mut(c), destination, loan, role);
                    for j in owners.len() {
                        owner := owners[j];
                        bond_kind(borrow_mut(c), owner, loan, 1);
                    }
                }
            }
        }
    }
    return ();
}
fn writeback_source<a>(c: (&a mut C), destination: u64, ty: u64, source: u64) -> unit {
    check_writeback(borrow_mut(c), destination, ty, source);
    storage_bonds(borrow_mut(c), source, destination);
    return ();
}
fn call_writebacks<a, b, d>(
    c: (&a mut C),
    first: u64,
    args: (&b u64[]),
    actuals: (&d u64[])
) -> unit {
    if c.raw {
        return ();
    }
    for i in args.len() {
        formal := c.params[first + i];
        k := ty_kind(borrow_mut(c), formal);
        mode := ty_mode(borrow_mut(c), formal);
        if (k == 7) & mode {
            inner := ty_arg(borrow_mut(c), formal);
            if contains_borrow(borrow_mut(c), inner, 0) {
                mut rs = type_caps(borrow_mut(c), inner, 0);
                slot := args[i];
                destination := target_of(borrow_mut(c), slot);
                actual := actuals[i];
                storage := ty_arg(borrow_mut(c), actual);
                frame_storage(borrow_mut(c), slot, destination);
                seed_storage(borrow_mut(c), destination, storage);
                for j in args.len() {
                    ty := c.params[first + j];
                    kind := ty_kind(borrow_mut(c), ty);
                    argument := args[j];
                    mut caps = type_caps(borrow_mut(c), ty, 0);
                    if kind == 7 {
                        caps = type_regions(borrow_mut(c), ty);
                    }
                    if intersects(borrow(rs), borrow(caps)) {
                        source := place_of(borrow_mut(c), argument);
                        writeback_source(borrow_mut(c), destination, storage, source);
                    }
                    if kind == 7 {
                        inner := ty_arg(borrow_mut(c), ty);
                        data := type_caps(borrow_mut(c), inner, 0);
                        if intersects(borrow(rs), borrow(data)) {
                            mut source = target_of(borrow_mut(c), argument);
                            actual := actuals[j];
                            inner := ty_arg(borrow_mut(c), actual);
                            seed_storage(borrow_mut(c), source, inner);
                            if (region_of(borrow_mut(c), source) == 18446744073709551615)
                                & (source != destination) {
                                source = place_of(borrow_mut(c), argument);
                            }
                            writeback_source(borrow_mut(c), destination, storage, source);
                        }
                    }
                }
            }
        }
    }
    return ();
}
fn block_end<a>(c: (&a mut C), start: u64) -> u64 {
    mut i = start;
    mut depth = 0;
    while i < c.toks.len() {
        k := kind_at(borrow_mut(c), i);
        if k == 123 {
            depth = depth + 1;
        }
        if k == 125 {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    fail(borrow_mut(c), &"unclosed block");
    return start;
}
fn last_name<a, b>(c: (&a mut C), name: &b [u8], from: u64, to: u64) -> u64 {
    mut last = 0;
    if from {
        last = from - 1;
    }
    mut i = from;
    mut depth = 0;
    mut base = 0;
    mut pending = 0;
    mut hidden = 0;
    mut skip = 0;
    if from < c.toks.len() {
        if kind_at(borrow_mut(c), from) == 123 {
            base = 1;
        }
    }
    while i < to {
        t := &c.toks[i];
        kind := t.kind;
        st := t.start;
        en := t.end;
        if kind == 123 {
            depth = depth + 1;
        }
        // A scan can start inside an enclosing group; its closing brace ends this scope.
        if kind == 125 {
            if depth == 0 {
                break;
            }
            if hidden == depth + 1 {
                hidden = 0;
            }
            depth = depth - 1;
        }
        if (kind == 1) & (hidden == 0) & (pending == 0) {
            token := tok_text(borrow_mut(c), i);
            if same(&token, &"mut") {
                mut declaration = 1;
                if i != 0 {
                    if kind_at(borrow_mut(c), i - 1) == 38 {
                        declaration = 0;
                    }
                }
                if declaration {
                    declared := tok_text(borrow_mut(c), i + 1);
                    if same(&declared, &name) {
                        pending = depth + 1;
                        skip = i + 1;
                    }
                }
            }
            if kind_at(borrow_mut(c), i + 1) == 261 {
                if same(&token, &name) {
                    pending = depth + 1;
                    skip = i;
                }
            }
        }
        mut use = 1;
        if i != 0 {
            prev := kind_at(borrow_mut(c), i - 1);
            if (prev == 46) + (prev == 260) {
                use = 0;
            }
        }
        mut next = kind_at(borrow_mut(c), i + 1);
        if (next == 58) + (next == 40) + (next == 260) + (next == 261) {
            use = 0;
        }
        if (kind == 1) & (en - st == name.len()) & (i != skip) & (hidden == 0) & use {
            mut matched = 1;
            mut j = 0;
            while j < en - st {
                if c.src[st + j] != name[j] {
                    matched = 0;
                    break;
                }
                j = j + 1;
            }
            if matched {
                last = i;
            }
        }
        if (pending != 0) & (kind == 59) & (depth + 1 == pending) {
            if depth == base {
                break;
            }
            hidden = pending;
            pending = 0;
        }
        i = i + 1;
    }
    return last;
}
fn is_local_slot<a>(c: (&a mut C), slot: u64) -> u64 {
    for i in c.locals.len() {
        mut l = &c.locals[i];
        if l.id == slot {
            return 1;
        }
    }
    return 0;
}
fn release_temporary<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw {
        return ();
    }
    if is_local_slot(borrow_mut(c), slot) {
        return ();
    }
    mut r = resource(borrow_mut(c), slot);
    if r == 0 {
        return ();
    }
    info := &c.resources[r - 1];
    place := info.place;
    base := info.base;
    if (base == 0) & (place != 0) {
        if ownership::can_cleanup(borrow(c.check), place) {
            release(borrow_mut(c), r - 1);
