    mut args = u64[];
    args.push(acc);
    args.push(tmp);
    w := imm(borrow_mut(c), sp.width);
    args.push(w);
    al := imm(borrow_mut(c), align);
    args.push(al);
    z := imm(borrow_mut(c), sp.zero & numeric);
