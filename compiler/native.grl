    mut back = c.pos;
    while (0 < back) & !((kind_at(&mut c, back) == 1) & same(view(tok_text(&mut c, back)), view(first))) {
        back -= 1;
    }
    exchange(&mut c.pos, back);
    guess := suggest_name(&mut c, view(m), view(first));
    if guess.len() != 0 {
        mut help = copy_bytes(view("a name with a similar spelling is in scope: `"));
        push_bytes(&mut help, view(guess));
        push_bytes(&mut help, view("`"));
        diag_help(&mut c, view(help));
    }
    fail(&mut c, view("undefined name"));
