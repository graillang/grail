// Calling an `FnMut` value needs exclusive access to the closure: its environment is reachable
// only through that value, so a second call (or a live shared borrow of the closure) would alias
// what the first one writes. The loan is taken on the closure's own storage and ends when the call
// returns; bonding it to that storage keeps `close_loans` from ending it early while the arguments
// are evaluated.
fn call_access<a>(c: (&a mut C), slot: u64) -> u64 {
