fn after_next_kind<a>(c: (&a mut C)) -> u64 {
    p := c.pos;
    return kind_at(&mut c, p + 2);
}
fn simple_type_head<a, b>(c: (&a mut C), name: &b [u8]) -> bool {
    n := name.copy();
    if int_name(view(n)) != 0 {
        return true;
    }
    if same(view(n), view("u64")) {
        return true;
    }
    if same(view(n), view("fn")) {
        return true;
    }
    if same(view(n), view("Fn")) {
        return true;
    }
    if same(view(n), view("FnMut")) {
        return true;
    }
    if same(view(n), view("bool")) {
        return true;
    }
    if same(view(n), view("f64")) {
        return true;
    }
    if same(view(n), view("f32")) {
        return true;
    }
    if same(view(n), view("char")) {
        return true;
    }
    if same(view(n), view("string")) {
        return true;
    }
    if same(view(n), view("unit")) {
        return true;
    }
    if same(view(n), view("Mutex")) {
        return true;
    }
    if same(view(n), view("Atomic")) {
        return true;
    }
    if same(view(n), view("Scope")) {
        return true;
    }
    if same(view(n), view("Task")) {
        return true;
    }
    if same(view(n), view("CancelToken")) {
        return true;
    }
    if same(view(n), view("read")) {
        return true;
    }
    if same(view(n), view("Self")) & ((c.self_type != 0)) {
        return true;
    }
    for i in c.tnames.len() {
        t := &c.tnames[i];
        if same(view(t), view(n)) {
            return true;
        }
    }
    return false;
}
// `Name[` or `Name<...>[` in expression position: a type-first collection literal.
fn type_literal_ahead<a, b>(c: (&a mut C), name: &b [u8]) -> bool {
    p := c.pos;
    if kind_at(&mut c, p) == 60 {
        mut depth = 0;
        mut q = p;
        while q < c.toks.len() {
            k := kind_at(&mut c, q);
            if k == 60 {
                depth += 1;
            }
            if k == 62 {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }
            q += 1;
        }
        if kind_at(&mut c, q + 1) != 91 {
            return false;
        }
    } else {
        if kind_at(&mut c, p) != 91 {
            return false;
        }
    }
    n := name.copy();
    if find_local(&mut c, view(n)) != 0 {
        return false;
    }
    if simple_type_head(&mut c, view(n)) {
        return true;
    }
    m := module_copy(&mut c);
    return find_decl(&mut c, view(m), view(n)) != 0;
}
fn finish_type_literal<a>(c: (&a mut C), ty: u64) -> Val {
    mut out = ty;
    while is(&mut c, view("[")) {
        here := c.pos + 1;
        if kind_at(&mut c, here) != 93 {
            break;
        }
        advance(&mut c);
        advance(&mut c);
        out = vec_of(&mut c, out);
    }
    if is(&mut c, view("[")) {
        mut cty = vec_of(&mut c, out);
        return collection_literal(&mut c, cty, (cty == 2));
    }
    slot := apply(&mut c, view("rt_new"), u64[]);
    own(&mut c, slot, out);
    return val(slot, out);
