fn bound_or_unknown<a, b>(c: (&a mut C), ty: u64, map: (&b u64[])) -> u64 {
    if map.len() == 0 {
        return ty;
    }
    if mentions_unbound(&mut c, ty, &map) {
        return NO_TYPE;
    }
    bound := bind_types(&mut c, ty, &map);
    // A type argument bound to a reference carries no lifetime, and a closure's reference
    // parameter needs one of its own: leave it to the closure to write (`|k: (&a K)|`), so the
    // message is the one that asks for the annotation.
    bk := ty_kind(&mut c, bound);
    if ((bk == 5) || (bk == 7) || (bk == 27)) && (type_regions(&mut c, bound).len() == 0) {
        return NO_TYPE;
    }
