        if same(&name, &"swap") {
            i := expr(borrow_mut(c), 0);
            require_type(borrow_mut(c), i.ty, 0);
            expect(borrow_mut(c), &",");
            j := expr(borrow_mut(c), 0);
            require_type(borrow_mut(c), j.ty, 0);
            expect(borrow_mut(c), &")");
            require_write(borrow_mut(c), xt);
            invoke(borrow_mut(c), &"rt_vec_swap", three(xt, i.t, j.t));
            return val(imm(borrow_mut(c), 0), 1);
        }
