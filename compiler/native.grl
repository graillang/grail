// 'a', '\n', '\u{1F600}', 'é' (UTF-8): the Unicode scalar value of a character literal token.
fn char_literal<a>(c: (&a mut C), tok: u64) -> u64 {
    t := tok_text(&mut c, tok);
    b := t[1];
    if b == 92 {
        e := t[2];
        if e == 110 {
            return 10;
        }
        if e == 116 {
            return 9;
        }
        if e == 114 {
            return 13;
        }
        if e == 48 {
            return 0;
        }
        if e == 117 {
            mut v = 0;
            mut i = 4;
            while i + 2 < t.len() {
                d := t[i];
                if d != 95 {
                    v = v * 16 + hex(d);
                    if 1114111 < v {
                        fail(&mut c, view("invalid character literal"));
                    }
                }
                i += 1;
            }
            if (55295 < v) & (v < 57344) {
                fail(&mut c, view("invalid character literal"));
            }
            return v;
        }
        return e;
    }
    if b < 128 {
        return b;
    }
    mut need = 1;
    mut v = b & 31;
    if 223 < b {
        need = 2;
        v = b & 15;
    }
    if 239 < b {
        need = 3;
        v = b & 7;
    }
    for i in need {
        v = v * 64 + (t[2 + i] & 63);
    }
    return v;
}
fn literal_value<a, b>(c: (&a mut C), t: &b [u8]) -> u64 {
    mut radix = 10;
    mut i = 0;
    if 2 < t.len() {
        if t[0] == 48 {
            r := t[1];
            if r == 120 {
                radix = 16;
                i = 2;
            }
            if r == 98 {
                radix = 2;
                i = 2;
            }
            if r == 111 {
                radix = 8;
                i = 2;
            }
        }
    }
    mut v = 0;
    mut any = 0;
    while i < t.len() {
        d := t[i];
        i += 1;
        if d == 95 {
            continue;
        }
        mut digit = 99;
        if (47 < d) & (d < 58) {
            digit = d - 48;
        }
        if (96 < d) & (d < 103) {
            digit = d - 87;
        }
        if (64 < d) & (d < 71) {
            digit = d - 55;
        }
        if !(digit < radix) {
            fail(&mut c, view("invalid digit in integer literal"));
        }
        if (18446744073709551615 - digit) / radix < v {
            fail(&mut c, view("integer literal exceeds 64 bits"));
        }
        v = v * radix + digit;
        any = 1;
    }
    if any == 0 {
        fail(&mut c, view("integer literal has no digits"));
    }
    return v;
}
// Literal metadata: the token span of the most recent bare literal and its (possibly negated) value.
fn literal_fits<a>(c: (&a mut C), ty: u64, value: u64, negative: u64) -> u64 {
    if ty == 0 {
        return negative == 0;
