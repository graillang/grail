fn bound_signature<a,b>(c:ref_mut<a,C>,index:num,arguments:ref<b,vec<num>>)->num{
 f :=&c.funcs[index];first :=f.first;count :=f.count;ret :=f.ret;mut params=vec<num>[];
 for i in count{ty :=c.params[first+i];bound :=bind_types(borrow_mut(c),ty,borrow(arguments));params.push(bound);}result :=bind_types(borrow_mut(c),ret,borrow(arguments));return intern_args(borrow_mut(c),12,result,0,vec<num>[],params);
}
fn resolve_interface_method<a,b>(c:ref_mut<a,C>,contract:num,ty:num,name:read<b>)->num{
 implementation :=find_implementation(borrow_mut(c),contract,ty);if implementation==0{fail(borrow_mut(c),&"missing interface implementation");}
 item :=&c.implementations[implementation-1];methods :=copy_numbers(borrow(item.methods));for i in methods.len(){index :=methods[i];f :=&c.funcs[index];if same(&f.name,&name){return index;}}
 fail(borrow_mut(c),&"missing interface method");return 0;
}
fn check_interfaces<a>(c:ref_mut<a,C>)->unit{
 for i in c.interfaces.len(){item :=&c.interfaces[i];defined :=item.defined;module :=item.module.copy();name :=item.name.copy();if defined==0{fail(borrow_mut(c),&"unknown interface in generic bound");}if find_decl(borrow_mut(c),&module,&name){fail(borrow_mut(c),&"interface and nominal type names conflict");}}
 for i in c.implementations.len(){item :=&c.implementations[i];contract :=item.contract;ty :=item.ty;methods :=copy_numbers(borrow(item.methods));interface :=&c.interfaces[contract-1];expected :=copy_numbers(borrow(interface.methods));
 if methods.len()!=expected.len(){fail(borrow_mut(c),&"interface implementation method count");}
 for j in expected.len(){abstract :=expected[j];f :=&c.funcs[abstract];name :=f.name.copy();actual :=resolve_interface_method(borrow_mut(c),contract,ty,&name);mut arguments=vec<num>[ty];signature :=bound_signature(borrow_mut(c),abstract,borrow(arguments));mut empty=vec<num>[];concrete :=bound_signature(borrow_mut(c),actual,borrow(empty));require_type(borrow_mut(c),concrete,signature);}}
 return ();
}
fn interface_call<a,b>(c:ref_mut<a,C>,contract:num,name:read<b>)->Val{module :=private_module(&".interface_",contract);return call(borrow_mut(c),&module,&name);}
fn toplevel<a>(c:ref_mut<a,C>,pass:num)->unit {
    raw :=eat(borrow_mut(c),&"unsafe");
    exchange(borrow_mut(c.raw),raw);
    mut m="main".copy();
    if eat(borrow_mut(c),&"module"){m=ident(borrow_mut(c));expect(borrow_mut(c),&";");}
    else{if (c.file!=2)+raw{fail(borrow_mut(c),&"dependency files require an explicit module");}}
    if same(&m,&"runtime"){if raw==0{fail(borrow_mut(c),&"runtime module must be explicitly unsafe");}}
    if raw { if same(&m,&"runtime")==0 { fail(borrow_mut(c),&"unsafe module reserved for runtime"); } }
    exchange(borrow_mut(c.module),m);
    while eat(borrow_mut(c),&"use") {
        ident(borrow_mut(c));
        expect(borrow_mut(c),&";");
    }
    while kind(borrow_mut(c))!=0 {
        public :=eat(borrow_mut(c),&"pub");
        if is(borrow_mut(c),&"interface"){interface_declaration(borrow_mut(c),pass);}
        else{if is(borrow_mut(c),&"impl"){implementation(borrow_mut(c),pass);}
        else{if is(borrow_mut(c),&"struct")+is(borrow_mut(c),&"enum") {
            decl(borrow_mut(c),pass);
        } else {
            func(borrow_mut(c),pass,public);
        }}}
    }
    return ();
}

// ---- expressions: eight-byte stack slots; left-to-right operands ----
fn deref<a>(c:ref_mut<a,C>,v:Val)->Val {
 mut t=v.t;mut ty=v.ty;
 while ty_kind(borrow_mut(c),ty)==7{
 old :=t;target :=target_of(borrow_mut(c),old);
 get(borrow_mut(c),t,&"%rax");o(borrow_mut(c),&"movq (%rax),%rax\n");t=save(borrow_mut(c));ty=ty_arg(borrow_mut(c),ty);
 if c.raw==0{if target==0{fail(borrow_mut(c),&"reference target is not tracked");}
 c.resources.push(Resource{slot:t,ty:ty,flag:0,base:old+1,field:0,via:1,place:target,target:0,authority:old+1});
 owner :=place_of(borrow_mut(c),old);n :=c.bonds.len();
 for i in n{mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if (holder==owner)&guard{bond_kind(borrow_mut(c),target,loan,guard);}}
 stored_source(borrow_mut(c),t,ty);}
 }
 return val(t,ty);
}
fn find_local<a,b>(c:ref_mut<a,C>,n:read<b>)->num {
    mut i=c.locals.len();
    while 0<i {
        i=i-1;
        mut l =&c.locals[i];
        if same(&l.name,&n) { return i+1; }
    }
    return 0;
}
fn local_id<a>(c:ref_mut<a,C>,i:num)->num { mut l =&c.locals[i]; return l.id; }
fn local_ty<a>(c:ref_mut<a,C>,i:num)->num { mut l =&c.locals[i]; return l.ty; }
fn pop_locals<a>(c:ref_mut<a,C>,mark:num)->unit {
    while mark<c.locals.len() { c.locals.pop(); }
    return ();
}
// Loads, addresses and stores record fields.
fn rec_load<a>(c:ref_mut<a,C>,base:num,k:num,address:num)->num{
 get(borrow_mut(c),base,&"%rax");
 if address{o(borrow_mut(c),&"leaq ");}else{o(borrow_mut(c),&"movq ");}
 on(borrow_mut(c),k*8);o(borrow_mut(c),&"(%rax),%rax\n");return save(borrow_mut(c));
}
fn rec_store<a>(c:ref_mut<a,C>,base:num,k:num,value:num)->unit{
 get(borrow_mut(c),base,&"%rcx");get(borrow_mut(c),value,&"%rax");
 o(borrow_mut(c),&"movq %rax,");on(borrow_mut(c),k*8);o(borrow_mut(c),&"(%rcx)\n");return ();
}
fn field_path<a>(c:ref_mut<a,C>,id:num,lty:num,address:num)->Val{
 mut t=id;mut ty=lty;mut via=0;
 while is(borrow_mut(c),&"."){if after_next_kind(borrow_mut(c))==40{break;}advance(borrow_mut(c));
 f :=ident(borrow_mut(c));if ty_kind(borrow_mut(c),ty)==7{via=1;}base :=deref(borrow_mut(c),val(t,ty));mut b =base.t;
 if ty_kind(borrow_mut(c),base.ty)!=8{fail(borrow_mut(c),&"field projection requires record");}
 d :=ty_arg(borrow_mut(c),base.ty);decl :=&c.decls[d];if decl.is_enum{fail(borrow_mut(c),&"enum payload requires match or unwrap");}k :=find_field(borrow_mut(c),d,&f);fty :=field_type(borrow_mut(c),base.ty,k);
 last :=(kind(borrow_mut(c))!=46)&(address!=0);n :=rec_load(borrow_mut(c),b,k,last);
 if last{
 ty :=reference_type(borrow_mut(c),fty,address==2);root :=place_of(borrow_mut(c),b);target :=member_place(borrow_mut(c),root,k,fty);authority :=authority_of(borrow_mut(c),b);
 if c.raw==0{c.resources.push(Resource{slot:n,ty:ty,flag:0,base:b+1,field:k,via:via,place:0,target:target,authority:authority});}
 return val(n,ty);}
 alias_field(borrow_mut(c),n,fty,b,k,via);t=n;ty=fty;}
 observe(borrow_mut(c),t);return val(t,ty);
}
fn place<a>(c:ref_mut<a,C>,write:num)->Val {
 name :=ident(borrow_mut(c));mut l =find_local(borrow_mut(c),&name);if l==0{fail(borrow_mut(c),&"unknown borrowed place");}
 id :=local_id(borrow_mut(c),l-1);ty :=local_ty(borrow_mut(c),l-1);
 if write{require_mutable_binding(borrow_mut(c),id,1);}
 if ty_kind(borrow_mut(c),ty)==7{if write{if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),&"mutable reborrow of shared reference");}}}
 if kind(borrow_mut(c))==46{
 mut v =field_path(borrow_mut(c),id,ty,1+write);target :=target_of(borrow_mut(c),v.t);mut r =resource(borrow_mut(c),v.t);info :=&c.resources[r-1];base :=info.base-1;
 return borrow_reference(borrow_mut(c),v.t,v.ty,base,target,write);}
 target :=place_of(borrow_mut(c),id);mut referent=ty;mut source=target;
 if ty_kind(borrow_mut(c),ty)==7{
 source=target_of(borrow_mut(c),id);referent=ty_arg(borrow_mut(c),ty);get(borrow_mut(c),id,&"%rax");
 }else{o(borrow_mut(c),&"leaq ");stack_slot(borrow_mut(c),id);o(borrow_mut(c),&",%rax\n");}
 slot :=save(borrow_mut(c));mut out =reference_type(borrow_mut(c),referent,write);
 return borrow_reference(borrow_mut(c),slot,out,id,source,write);
}
fn hex(b:num)->num {
    if b<58 { return b-48; }
    if b<71 { return b-55; }
    return b-87;
}
fn string_lit<a>(c:ref_mut<a,C>)->Val{
 p :=c.pos;t :=&c.toks[p];st :=t.start;en :=t.end;advance(borrow_mut(c));
 mut l =label(borrow_mut(c));o(borrow_mut(c),&".pushsection .rodata\n");mark(borrow_mut(c),l);
 mut i=st+1;mut count=0;
 while i<en-1{
 mut b=c.src[i];
 if b==92{i=i+1;e :=c.src[i];b=e;
 if e==110{b=10;}if e==114{b=13;}if e==116{b=9;}if e==48{b=0;}
 if e==120{h :=hex(c.src[i+1]);lo :=hex(c.src[i+2]);b=h*16+lo;i=i+2;}}
 o(borrow_mut(c),&".byte ");on(borrow_mut(c),b);c.out.push(10);count=count+1;i=i+1;}
 o(borrow_mut(c),&".byte 0\n.popsection\nleaq ");lname(borrow_mut(c),l);o(borrow_mut(c),&"(%rip),%rax\n");
 ptr :=save(borrow_mut(c));n :=imm(borrow_mut(c),count);
 t :=invoke(borrow_mut(c),&"rt_string_lit",two(ptr,n));return own(borrow_mut(c),t,3);
}
fn infer_type<a,b>(c:ref_mut<a,C>,formal:num,actual:num,map:ref_mut<b,vec<num>>)->unit {
 k :=ty_kind(borrow_mut(c),formal);arg :=ty_arg(borrow_mut(c),formal);
 if k==9{
 old :=map[arg];if old==18446744073709551615{exchange(&mut map[arg],actual);}else{require_type(borrow_mut(c),actual,old);}return ();}
 ak :=ty_kind(borrow_mut(c),actual);if k!=ak{fail(borrow_mut(c),&"generic argument shape mismatch");}
 if k==7{fm :=ty_mode(borrow_mut(c),formal);am :=ty_mode(borrow_mut(c),actual);if fm!=am{fail(borrow_mut(c),&"generic reference mode mismatch");}}
 if (k==6)+(k==7){aa :=ty_arg(borrow_mut(c),actual);infer_type(borrow_mut(c),arg,aa,borrow_mut(map));return ();}
 if k==12{
 result :=ty_arg(borrow_mut(c),actual);infer_type(borrow_mut(c),arg,result,borrow_mut(map));
 fs :=type_args(borrow_mut(c),formal);as :=type_args(borrow_mut(c),actual);if fs.len()!=as.len(){fail(borrow_mut(c),&"callable argument arity mismatch");}
 for i in fs.len(){f :=fs[i];a :=as[i];infer_type(borrow_mut(c),f,a,borrow_mut(map));}return ();}
 if k==8{
 aa :=ty_arg(borrow_mut(c),actual);if arg!=aa{fail(borrow_mut(c),&"generic nominal mismatch");}
 fa :=type_args(borrow_mut(c),formal);ax :=type_args(borrow_mut(c),actual);if fa.len()!=ax.len(){fail(borrow_mut(c),&"generic arity mismatch");}
 for i in fa.len(){f :=fa[i];a :=ax[i];infer_type(borrow_mut(c),f,a,borrow_mut(map));}return ();}
 require_type(borrow_mut(c),actual,formal);return ();
}
fn constructor_hint<a>(c:ref_mut<a,C>,decl:num,explicit:num)->num {
 if explicit!=18446744073709551615{return explicit;}
 result :=c.result;if ty_kind(borrow_mut(c),result)==8{if ty_arg(borrow_mut(c),result)==decl{return result;}}
