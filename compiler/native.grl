        tls_get(&mut c, tls);
        tls_set_global(&mut c, view("rt_host_tls"));
    }
    if area != 0 {
        if x86 {
            o(&mut c, view("subq $"));
            on(&mut c, area);
            o(&mut c, view(",%rsp\n"));
        } else {
            o(&mut c, view("cstack "));
            on(&mut c, area);
            c.out.push(10);
        }
    }
    ints = shift;
    floats = 0;
    mut next = 0;
    if shift != 0 {
        get(&mut c, rslot, view(ffi_int_reg(abi, 0)));
