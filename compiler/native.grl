    if (narrow != 0) & (is_c_record(&mut c, narrow) == 0) {
        caddr_store(&mut c, r, narrow, value);
        return ();
    }
    if !subword(&mut c, ty) {
        get(&mut c, value, view("%rax"));
        get(&mut c, r, view("%rcx"));
        o(&mut c, view("movq %rax,(%rcx)\n"));
        return ();
    }
    word := label(&mut c);
    done := label(&mut c);
    get(&mut c, r, view("%rax"));
    o(&mut c, view("movq %rax,%rcx\nshrq $63,%rcx\ntestq %rcx,%rcx\n"));
    jump(&mut c, view("jz"), word);
    o(&mut c, view("shlq $1,%rax\nshrq $1,%rax\n"));
    at := save(&mut c);
    concrete := base_type(&mut c, ty);
    caddr_store(&mut c, at, concrete, value);
    jump(&mut c, view("jmp"), done);
    mark(&mut c, word);
    get(&mut c, value, view("%rax"));
    get(&mut c, r, view("%rcx"));
    o(&mut c, view("movq %rax,(%rcx)\n"));
    mark(&mut c, done);
