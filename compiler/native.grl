    bits := ty_arg(&mut c, ty);
    signed := ty_mode(&mut c, ty);
    mut max = 18446744073709551615;
    if bits < 64 {
        max = 1;
        for i in bits {
            max = max * 2;
        }
        max = max - 1;
    }
    half := max / 2;
    mut top = max;
    if signed != 0 {
        out.push(45);
        push_bytes(&mut out, view(decimal_bytes(half + 1)));
        top = half;
    } else {
        out.push(48);
    }
    push_bytes(&mut out, view("..="));
    push_bytes(&mut out, view(decimal_bytes(top)));
