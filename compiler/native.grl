// cannot widen against a formal it cannot bind, so the closure's own signature is widened to
// `FnMut` first and inference then reads the same parameter and result types from it.
fn widen_to_fnmut_formal<a>(c: (&a mut C), v: Val, formal: u64) -> Val {
    if (ty_kind(&mut c, v.ty) != 20) || (ty_kind(&mut c, formal) != 20) {
        return v;
