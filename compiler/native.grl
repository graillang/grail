            owner := private_module(view(".inherent_"), d - 1);
            if find_func(&mut c, view(owner), view(third)) != 0 {
                return call(&mut c, view(owner), view(third));
            }
            return variant(&mut c, d - 1, view(third), NO_TYPE);
        }
        interface := find_interface(&c, view(m), view(first));
        if interface != 0 {
            return interface_call(&mut c, interface, view(second));
        }
        d := find_decl(&mut c, view(m), view(first));
        if d != 0 {
            owner := private_module(view(".inherent_"), d - 1);
            if find_func(&mut c, view(owner), view(second)) != 0 {
                return call(&mut c, view(owner), view(second));
            }
        }
        if d != 0 {
            return variant(&mut c, d - 1, view(second), NO_TYPE);
        }
        mut r = find_decl(&mut c, view(first), view(second));
        if (r != 0) & is(&mut c, view("{")) {
