        while true {
            mut estart = c.pos;
            mut v = val(given.t, given.ty);
            mut eend = gend;
            if pending {
                estart = gstart;
                pending = false;
            } else {
                if (c.raw == 0) & (bytes == 0) & is(&mut c, view("[")) {
                    // A nested untyped literal reads its type from this one's element type, so
                    // `rows: u64[][] = [[1], []]` needs no type on the inner literals.
                    v = expr_expected(&mut c, 0, ty_arg(&mut c, ty));
                } else {
                    v = expr(&mut c, 0);
                }
                eend = c.pos;
            }
            if c.raw == 0 {
                mut expected = 0;
                if bytes == 0 {
                    expected = ty_arg(&mut c, ty);
                }
                v = adopt_value(&mut c, v, estart, eend, expected);
                if (bytes == 0) || (v.ty != int_type(&mut c, 8, 0)) {
                    require_type(&mut c, v.ty, expected);
                }
                if bytes != 0 {
                    adopt_literal(&mut c, estart, eend, int_type(&mut c, 8, 0));
                }
            }
            if first != 0 && is(&mut c, view(";")) {
                // `T[v; n]`: n copies of a plain value, built in one reservation.
                advance(&mut c);
                if (c.raw == 0) & (bytes == 0) {
                    element := ty_arg(&mut c, ty);
                    if needs_drop(&mut c, element) {
                        fail(&mut c, view("a repeated element must be a plain value; build owned elements with push"));
                    }
                }
                nstart := c.pos;
                mut count = expr(&mut c, 0);
                nend := c.pos;
                if c.raw == 0 {
                    count = adopt_value(&mut c, count, nstart, nend, 0);
                    require_type(&mut c, count.ty, 0);
                }
                expect(&mut c, view("]"));
                mut fill = "rt_fill";
                if bytes != 0 {
                    fill = "rt_fillb";
                }
                code := narrow_vector(&mut c, ty);
                if code != 0 {
                    fill = "rt_fill4";
                }
                unit := narrow_encode(&mut c, code, v.t);
                mut args = two(slot, unit);
                args.push(count.t);
                invoke(&mut c, view(fill), args);
                return val(slot, ty);
            }
            value := v.t;
            source := place_of(&mut c, value);
            move_out(&mut c, val(value, v.ty));
            mut f = "rt_push";
            if bytes != 0 {
                // A u8 element always fits; an untyped word is range-checked at run time.
                f = "rt_pushb_checked";
                if v.ty == int_type(&mut c, 8, 0) {
                    f = "rt_pushb";
                }
            }
            code := narrow_vector(&mut c, ty);
            if code != 0 {
                f = "rt_push4";
            }
            mut width = 0;
            if bytes == 0 {
                width = flat_bytes(&mut c, ty_arg(&mut c, base_type(&mut c, ty)));
            }
            if width != 0 {
                invoke(&mut c, view(flat_push(&mut c, v.ty)), three(slot, value, imm(&mut c, width)));
            } else {
                unit := narrow_encode(&mut c, code, value);
                invoke(&mut c, view(f), two(slot, unit));
            }
            target := place_of(&mut c, slot);
            transfer_bonds(&mut c, source, target);
            first = 0;
            if eat(&mut c, view("]")) {
                break;
            }
            expect(&mut c, view(","));
            if eat(&mut c, view("]")) {
                break;
            }
        }
    }
    return val(slot, ty);
}
// `&place` and `&mut place` create typed references; indexing still returns element refs.
// Ends the non-owning temporaries created since `mark` (views and references made to pass
// arguments), except `keep`. Called once a value that holds no borrow has been computed, so later
// parts of the same statement may use what those temporaries borrowed: an assignment's place after
// its right side (`b.words[i] = f(&b)`), a record field after an earlier field (`M { n: f(&x), x }`),
// a loop body after its count. They own nothing, so no code is emitted.
fn end_temporaries<a>(c: (&a mut C), mark: u64, keep: u64) -> unit {
    release_temporaries(&mut c, mark, keep);
    close_loans(&mut c);
    expire_locals(&mut c);
    return ();
}
// The release half alone, for use inside a larger expression (a record field), where closing loans
// and expiring locals could end a borrow the enclosing expression still holds.
fn release_temporaries<a>(c: (&a mut C), mark: u64, keep: u64) -> unit {
    mut r = c.resources.len();
    while mark < r {
        r = r - 1;
        info := &c.resources[r];
        flag := info.flag;
        slot := info.slot;
        if (flag == 0) & (slot != keep) & !is_local_slot(&mut c, slot) {
            release(&mut c, r);
        }
    }
    return ();
}
fn reference_borrow<a>(c: (&a mut C), write: u64) -> Val {
    if c.raw == 0 {
        // `&s` / `&mut s` on a slice binding reborrows the slice (Rust's implicit reborrow): a slice
        // of the same elements, shared or exclusive, borrowing from `s`; the binding itself is not
        // written, so it needs no `mut`.
        here := c.pos;
        name := tok_text(&mut c, here);
        l := find_local(&mut c, view(name));
        after := kind_at(&mut c, here + 1);
        if (l != 0) & (after != 91) & (after != 46) & (after != 40) {
            lt := local_ty(&mut c, l - 1);
            if ty_kind(&mut c, lt) == 27 {
                if write != 0 && ty_mode(&mut c, lt) == 0 {
                    fail(&mut c, view("&mut of a readonly slice"));
                }
                advance(&mut c);
                info := &c.locals[l - 1];
                source := info.id;
                observe(&mut c, source);
                result := apply(&mut c, view("rt_view"), one(source));
                elem := ty_arg(&mut c, lt);
                sty := intern_full(&mut c, 27, elem, write, u64[]);
                own(&mut c, result, sty);
                view_bonds(&mut c, result, source, write, false);
                return val(result, sty);
            }
        }
    }
    if !borrow_place_ahead(&mut c) {
        return borrow_temporary(&mut c, write);
    }
    // `&mut s[i]` through a binding holding a slice or byte view borrows through the view's own
    // capability (as `s[i] = x` does): the binding is read, not written, so it needs no `mut`.
    mut through_view = 0;
    if c.raw == 0 {
        here := c.pos;
        name := tok_text(&mut c, here);
        l := find_local(&mut c, view(name));
        if (l != 0) & (kind_at(&mut c, here + 1) == 91) {
            lt := local_ty(&mut c, l - 1);
            lk := ty_kind(&mut c, lt);
            if (lk == 5) || (lk == 27) {
                if write != 0 && ty_mode(&mut c, lt) == 0 {
                    fail(&mut c, view("writing an element needs a mutable slice or view"));
                }
                through_view = 1;
            }
        }
    }
    mut v = val(0, 0);
    if through_view != 0 {
        v = primary(&mut c, NO_TYPE);
    } else {
        v = place(&mut c, write, 1);
    }
    // `&mut cs[i].data`, `&grid[y][x]`: the rest of the accessor chain is borrowed too.
    stop := borrow_chain_end(&mut c);
    if stop != c.pos {
        v = chain_walk_mode(&mut c, v, stop, write);
    }
    tag_narrow_borrow(&mut c, v.t);
    return v;
}
// Borrowing narrow storage (an element of f32[]/u32[]/i32[], a byte, a narrow C-record field):
// the reference is the address with its top bit set, so reads and writes through it use the
// referent's width (see `ref_load`). Word storage is never tagged.
fn tag_narrow_borrow<a>(c: (&a mut C), slot: u64) -> unit {
    narrow := caddr_ty(&mut c, slot);
    if (c.raw != 0) || (narrow == 0) {
        return ();
    }
    // A record or an array is reached by its address: a reference to one is never tagged.
    if (is_c_record(&mut c, narrow) != 0) || is_array(&mut c, narrow) {
        return ();
    }
    get(&mut c, slot, view("%rax"));
    o(&mut c, view("movq $1,%rcx\nshlq $63,%rcx\norq %rcx,%rax\nmovq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    // The slot now holds a tagged reference; it is no longer a bare narrow address.
    mut i = c.caddr.len();
    while 1 < i {
        i = i - 2;
        if c.caddr[i] == slot {
            c.caddr[i] = 18446744073709551615;
        }
    }
    return ();
}
// A type narrow storage can hold: f32 or an 8-, 16- or 32-bit integer.
fn subword<a>(c: (&a mut C), alias: u64) -> bool {
    if (c.raw != 0) || (alias == 0) {
        return false;
    }
    ty := base_type(&mut c, alias);
    if is_f32(&mut c, ty) {
        return true;
    }
    if ty_kind(&mut c, ty) == 18 {
        return ty_arg(&mut c, ty) < 64;
    }
    return false;
}
// Reads the `ty` value a reference slot points at: word storage with an 8-byte load, tagged narrow
// storage with the type's width and encoding.
// A reference to a record is the record's own address - the word a value of the record type holds
// - and not the address of a word holding it (docs/design/unboxed-values.md, stage 1a). So a record
// is reached through a reference with one load fewer, a reference to a local record is the local's
// word, and what is written through one replaces the record's words. Enums, vectors and scalars
// keep the address of their word.
fn direct<a>(c: (&a mut C), alias: u64) -> bool {
    if c.raw != 0 {
        return false;
    }
    ty := base_type(&mut c, alias);
    // An array value is the address of its bytes, as a record's is.
    if ty_kind(&mut c, ty) == 32 {
        return true;
    }
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    index := ty_arg(&mut c, ty);
    if c.decls[index].is_enum != 0 {
        // A small enum is frame words like a record, so its reference is their address too.
        return small_enum(&mut c, ty);
    }
    d := &c.decls[index];
    // A closure's environment is not a record value anyone holds: its code is called with the
    // address of the word holding the object (indirect_call), and that stays the closure ABI.
    return !same(view(d.module), view(".closure"));
}
// The reference to the `ty` held in the word at the address in `at`: for a record the word itself,
// loaded; for anything else the word's address, which `at` already is.
fn word_reference<a>(c: (&a mut C), at: u64, ty: u64) -> u64 {
    if !direct(&mut c, ty) {
        return at;
    }
    get(&mut c, at, view("%rax"));
    o(&mut c, view("movq (%rax),%rax\n"));
    return save(&mut c);
}
// The reference to the `ty` a frame slot holds: the slot's word for a record, its address otherwise.
fn slot_reference<a>(c: (&a mut C), id: u64, ty: u64) -> u64 {
    if direct(&mut c, ty) {
        get(&mut c, id, view("%rax"));
    } else {
        o(&mut c, view("leaq "));
        stack_slot(&mut c, id);
        o(&mut c, view(",%rax\n"));
    }
    return save(&mut c);
}
// The size in bytes of the storage a record's address names: a word per field, or the C size of
// an `extern "C"` record (which, embedded in another, is not a whole number of words).
fn record_bytes<a>(c: (&a mut C), alias: u64) -> u64 {
    if is_array(&mut c, alias) {
        return array_bytes(&mut c, alias);
    }
    ty := base_type(&mut c, alias);
    d := ty_arg(&mut c, ty);
    if c.decls[d].c_layout != 0 {
        return ffi_record_size(&mut c, d);
    }
    return record_words(&mut c, ty) * 8;
}
// Exchanges the contents of the two `ty` records whose addresses are in `x` and `y`. Up to four
// whole words are moved in line; anything else is the runtime's loop.
fn swap_records<a>(c: (&a mut C), x: u64, y: u64, ty: u64) -> unit {
    bytes := record_bytes(&mut c, ty);
    if (bytes % 8 != 0) || (32 < bytes) {
        n := imm(&mut c, bytes);
        invoke(&mut c, view("rt_swap"), three(x, y, n));
        return ();
    }
    get(&mut c, x, view("%rcx"));
    get(&mut c, y, view("%rdx"));
    for k in bytes / 8 {
        o(&mut c, view("movq "));
        on(&mut c, k * 8);
        o(&mut c, view("(%rcx),%rax\nmovq "));
        on(&mut c, k * 8);
        o(&mut c, view("(%rdx),%r10\nmovq %r10,"));
        on(&mut c, k * 8);
        o(&mut c, view("(%rcx)\nmovq %rax,"));
        on(&mut c, k * 8);
        o(&mut c, view("(%rdx)\n"));
    }
    return ();
}
fn is_word_ref<a>(c: (&a C), slot: u64) -> bool {
    for i in c.word_refs.len() {
        if c.word_refs[i] == slot {
            return true;
        }
    }
    return false;
}
fn ref_load<a>(c: (&a mut C), r: u64, ty: u64) -> u64 {
    if direct(&mut c, ty) {
        get(&mut c, r, view("%rax"));
        return save(&mut c);
    }
    if is_word_ref(&c, r) {
        get(&mut c, r, view("%rax"));
        o(&mut c, view("movq (%rax),%rax\n"));
        return save(&mut c);
    }
    narrow := caddr_ty(&mut c, r);
    if (narrow != 0) & (is_c_record(&mut c, narrow) == 0) {
        return caddr_load(&mut c, r, narrow);
    }
    if !subword(&mut c, ty) {
        get(&mut c, r, view("%rax"));
        o(&mut c, view("movq (%rax),%rax\n"));
        return save(&mut c);
    }
    word := label(&mut c);
    done := label(&mut c);
    get(&mut c, r, view("%rax"));
    o(&mut c, view("movq %rax,%rcx\nshrq $63,%rcx\ntestq %rcx,%rcx\n"));
    jump(&mut c, view("jz"), word);
    o(&mut c, view("shlq $1,%rax\nshrq $1,%rax\n"));
    at := save(&mut c);
    concrete := base_type(&mut c, ty);
    v := caddr_load(&mut c, at, concrete);
    get(&mut c, v, view("%rax"));
    jump(&mut c, view("jmp"), done);
    mark(&mut c, word);
    o(&mut c, view("movq (%rax),%rax\n"));
    mark(&mut c, done);
    return save(&mut c);
}
// Writes `value` (a `ty`) into the word a place addresses: `r` is the address of the word that holds
// the value, which is what a reference to anything but a record is, and what an assignment's target
// is for a record too (field_path, address 3) - the word is replaced, the old record is not written.
fn ref_store<a>(c: (&a mut C), r: u64, ty: u64, value: u64) -> unit {
    narrow := caddr_ty(&mut c, r);
    if narrow != 0 {
        caddr_store(&mut c, r, narrow, value);
        return ();
    }
    if framed(&mut c, ty) & embedded_place(&mut c, r) {
        // An inline record's place: the new value's words replace the old ones (an owning one was
        // dropped in place first, by the assignment).
        get(&mut c, r, view("%rax"));
        o(&mut c, view("movq (%rax),%rax\n"));
        dst := save(&mut c);
        copy_into(&mut c, dst, value, ty);
        return ();
    }
    if is_c_record(&mut c, ty) != 0 {
        // A record written through a reference replaces the referenced bytes: the destination is
        // the address the reference loads - a binding's own record, or an embedded field's interior
        // address - so the value's bytes are copied there and its buffer is released. Storing the
        // pointer would leave the fields untouched and leak the value.
        get(&mut c, r, view("%rax"));
        o(&mut c, view("movq (%rax),%rax\n"));
        dst := save(&mut c);
        caddr_store(&mut c, dst, ty, value);
        return ();
    }
    if !subword(&mut c, ty) || is_word_ref(&c, r) {
        get(&mut c, value, view("%rax"));
        get(&mut c, r, view("%rcx"));
        o(&mut c, view("movq %rax,(%rcx)\n"));
        return ();
    }
    word := label(&mut c);
    done := label(&mut c);
    get(&mut c, r, view("%rax"));
    o(&mut c, view("movq %rax,%rcx\nshrq $63,%rcx\ntestq %rcx,%rcx\n"));
    jump(&mut c, view("jz"), word);
    o(&mut c, view("shlq $1,%rax\nshrq $1,%rax\n"));
    at := save(&mut c);
    concrete := base_type(&mut c, ty);
    caddr_store(&mut c, at, concrete, value);
    jump(&mut c, view("jmp"), done);
    mark(&mut c, word);
    get(&mut c, value, view("%rax"));
    get(&mut c, r, view("%rcx"));
    o(&mut c, view("movq %rax,(%rcx)\n"));
    mark(&mut c, done);
    return ();
}
// From c.pos: the end of a run of `[...]` groups and `.field` accessors (stopping before a
// method call `.m(`).
fn borrow_chain_end<a>(c: (&a mut C)) -> u64 {
    mut e = c.pos;
    while true {
        k := kind_at(&mut c, e);
        if (k == 46) & (kind_at(&mut c, e + 1) == 1) & (kind_at(&mut c, e + 2) != 40) {
            e = e + 2;
            continue;
        }
        if k == 91 {
            mut depth = 0;
            while true {
                kk := kind_at(&mut c, e);
                if (kk == 0) || (kk == 59) {
                    return e;
                }
                if kk == 91 {
                    depth = depth + 1;
                }
                if kk == 93 {
                    depth = depth - 1;
                    if depth == 0 {
                        break;
                    }
                }
                e = e + 1;
            }
            e = e + 1;
            continue;
        }
        break;
    }
    return e;
}
fn after_next_kind<a>(c: (&a mut C)) -> u64 {
    return kind_at(&mut c, c.pos + 2);
}
fn simple_type_head<a, b>(c: (&a mut C), name: &b [u8]) -> bool {
    n := name.copy();
    if int_name(view(n)) != 0 {
        return true;
    }
    if same(view(n), view("u64")) {
        return true;
    }
    if same(view(n), view("fn")) {
        return true;
    }
    if same(view(n), view("Fn")) {
        return true;
    }
    if same(view(n), view("FnMut")) {
        return true;
    }
    if same(view(n), view("bool")) {
        return true;
    }
    if same(view(n), view("f64")) {
        return true;
    }
    if same(view(n), view("f32")) {
        return true;
    }
    if same(view(n), view("char")) {
        return true;
    }
    if same(view(n), view("string")) {
        return true;
    }
    if same(view(n), view("unit")) {
        return true;
    }
    if same(view(n), view("Mutex")) {
        return true;
    }
    if is_simd_name(view(n)) {
        return true;
    }
    if same(view(n), view("Atomic")) {
        return true;
    }
    if same(view(n), view("Scope")) {
        return true;
    }
    if same(view(n), view("Task")) {
        return true;
    }
    if same(view(n), view("CancelToken")) {
        return true;
    }
    if same(view(n), view("read")) {
        return true;
    }
    if same(view(n), view("Self")) & ((c.self_type != NO_TYPE)) {
        return true;
    }
    for i in c.tnames.len() {
        t := &c.tnames[i];
        if same(view(t), view(n)) {
            return true;
        }
    }
    return false;
}
// `Name[` or `Name<...>[` in expression position: a type-first collection literal.
// The `<`/`>` matching of the loaded token stream, made once per file: a stack of the open `<`, each
// `>` closing the latest, which is where a walk from that `<` counting the two would stop.
fn angle_sync<a>(c: (&a mut C)) -> unit {
    if c.angle_ok != 0 {
        return ();
    }
    n := c.toks.len();
    mut close = u64[n; n];
    mut open = u64[];
    for i in n {
        k := c.toks[i].kind;
        if k == 60 {
            open.push(i);
        }
        if (k == 62) & (open.len() != 0) {
            close[open.pop()!] = i;
        }
    }
    exchange(&mut c.angle_close, close);
    exchange(&mut c.angle_ok, 1);
    return ();
}
fn type_literal_ahead<a, b>(c: (&a mut C), name: &b [u8]) -> bool {
    p := c.pos;
    if kind_at(&mut c, p) == 60 {
        // The `>` that brings the count of `<` minus `>` back to where it was before this `<`
        // (angle_sync): every `a < b` asked this, and with no `>` after it the walk went to the end
        // of the file.
        angle_sync(&mut c);
        q := c.angle_close[p];
        if kind_at(&mut c, q + 1) != 91 {
            return false;
        }
    } else {
        if kind_at(&mut c, p) != 91 {
            return false;
        }
    }
    n := name.copy();
    if find_local(&mut c, view(n)) != 0 {
        return false;
    }
    if simple_type_head(&mut c, view(n)) {
        return true;
    }
    m := module_copy(&mut c);
    return find_decl(&mut c, view(m), view(n)) != 0;
}
fn finish_type_literal<a>(c: (&a mut C), ty: u64) -> Val {
    mut out = ty;
    while is(&mut c, view("[")) {
        if kind_at(&mut c, c.pos + 1) != 93 {
            break;
        }
        advance(&mut c);
        advance(&mut c);
        out = vec_of(&mut c, out);
    }
    if is(&mut c, view("[")) {
        mut cty = vec_of(&mut c, out);
        return collection_literal(&mut c, cty, (cty == 2));
    }
    slot := apply(&mut c, view("rt_new"), u64[]);
    own(&mut c, slot, out);
    return val(slot, out);
}
// `T[]` for some `T` (and `u8[]`, which is type 2).
fn is_vector_type<a>(c: (&a mut C), ty: u64) -> bool {
    if ty == NO_TYPE {
        return false;
    }
    return (ty == 2) || (ty_kind(&mut c, ty) == 6);
}
// The `T?` a `pop()` answers: `Some(element)` when the collection had one (`had` is its length
// before the pop), `None` when it was empty. The runtime builds the option, so the generated code
// has no branch and the element's ownership passes straight into it.
// An element taken out of an inline vector lands in frame words of the site when it is a framed
// record (not an array, which has its own unboxing, and not a C record, whose value is a box).
fn pop_in_place<a>(c: (&a mut C), ty: u64) -> bool {
    return framed(&mut c, ty) && !is_array(&mut c, ty) && (is_c_record(&mut c, ty) == 0);
}
fn option_of<a>(c: (&a mut C), ty: u64) -> u64 {
    mut oa = u64[];
    oa.push(ty);
    return named_type(&mut c, copy_bytes(view("result")), copy_bytes(view("Option")), oa);
}
fn inline_option<a>(c: (&a mut C), ty: u64) -> bool {
    opt := option_of(&mut c, ty);
    return framed(&mut c, opt) && inline_payload(&mut c, opt, ty);
}
fn option_pop_in_place<a>(c: (&a mut C), xt: u64, width: u64, ty: u64) -> Val {
    opt := option_of(&mut c, ty);
    d := ty_arg(&mut c, opt);
    some := success_variant(&mut c, d);
    slot := frame_alloc(&mut c, enum_words(&mut c, base_type(&mut c, opt)));
    get(&mut c, slot, view("%rax"));
    o(&mut c, view("leaq 8(%rax),%rax\n"));
    at := save(&mut c);
    had := apply(&mut c, view("rt_popw_quiet_into"), three(xt, imm(&mut c, width), at));
    // The tag is `some` when there was an element.
    get(&mut c, had, view("%rax"));
    if some == 0 {
        o(&mut c, view("xorq $1,%rax\n"));
    }
    get(&mut c, slot, view("%rcx"));
    o(&mut c, view("movq %rax,(%rcx)\n"));
    own(&mut c, slot, opt);
    return val(slot, opt);
}
fn pop_option<a>(c: (&a mut C), had: u64, element: u64, ty: u64) -> Val {
    mut oa = u64[];
    oa.push(ty);
    opt := named_type(&mut c, copy_bytes(view("result")), copy_bytes(view("Option")), oa);
    d := ty_arg(&mut c, opt);
    some := success_variant(&mut c, d);
    if framed(&mut c, opt) {
        // {tag, element}: the tag is `some` when the collection had an element.
        tag := imm(&mut c, some);
        empty := label(&mut c);
        get(&mut c, had, view("%rax"));
        o(&mut c, view("testq %rax,%rax\n"));
        jump(&mut c, view("jnz"), empty);
        o(&mut c, view("movq $"));
        on(&mut c, 1 - some);
        o(&mut c, view(","));
        stack_slot(&mut c, tag);
        c.out.push(10);
        mark(&mut c, empty);
        if inline_payload(&mut c, opt, ty) {
            // The element came out of an inline vector as a box (or 0 when it was empty): its words
            // are copied in only when there was one, and the box freed.
            zero := imm(&mut c, 0);
            slot := enum_frame(&mut c, tag, zero, opt, 1);
            skip := label(&mut c);
            get(&mut c, had, view("%rax"));
            o(&mut c, view("testq %rax,%rax\n"));
            jump(&mut c, view("jz"), skip);
            words := record_words(&mut c, base_type(&mut c, ty));
            get(&mut c, element, view("%rdx"));
            get(&mut c, slot, view("%rcx"));
            for k in words {
                o(&mut c, view("movq "));
                on(&mut c, k * 8);
                o(&mut c, view("(%rdx),%rax\nmovq %rax,"));
                on(&mut c, 8 + k * 8);
                o(&mut c, view("(%rcx)\n"));
            }
            invoke(&mut c, view("rt_free"), one(element));
            mark(&mut c, skip);
            own(&mut c, slot, opt);
            return val(slot, opt);
        }
        slot := enum_frame(&mut c, tag, element, opt, ty);
        own(&mut c, slot, opt);
        return val(slot, opt);
    }
    mut args = two(had, element);
    args.push(imm(&mut c, some));
    args.push(imm(&mut c, 1 - some));
    slot := invoke(&mut c, view("rt_pop_option"), args);
    own(&mut c, slot, opt);
    return val(slot, opt);
}
// Maps remain ordinary nominal library values; only their concise surface is compiler-owned.
fn is_map_type<a>(c: (&a mut C), ty: u64) -> bool {
    if ty == NO_TYPE {
        return false;
    }
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    d := ty_arg(&mut c, ty);
    item := &c.decls[d];
    return same(view(item.module), view("hashmap")) & same(view(item.name), view("Map"));
}
fn map_call<a, b>(c: (&a mut C), name: &b [u8], ty: u64, values: Val[]) -> Val {
    f := find_func(&mut c, view("hashmap"), name);
    if f == 0 {
        fail(&mut c, view("map operation needs its standard library helper"));
    }
    mut types = type_args(&mut c, ty);
    info := &c.funcs[f - 1];
    first := info.first;
    count := info.count;
    if count != values.len() {
        fail(&mut c, view("map helper argument count"));
    }
    mut args = u64[];
    mut actuals = u64[];
    mut sources = u64[];
    for i in values.len() {
        v := val(values[i].t, values[i].ty);
        expected := bind_types(&mut c, c.params[first + i], &types);
        require_type(&mut c, v.ty, expected);
        if ty_kind(&mut c, v.ty) == 7 {
            observe(&mut c, v.t);
        }
        held := move_value(&mut c, v);
        args.push(held.t);
        actuals.push(held.ty);
        sources.push(held.t);
    }
    return emit_resolved_call(&mut c, f, types, args, actuals, sources, 0);
}
fn map_new<a>(c: (&a mut C), ty: u64) -> Val {
    first := invoke(&mut c, view("rt_random_seed"), u64[]);
    second := invoke(&mut c, view("rt_random_seed"), u64[]);
    mut args = Val[];
    args.push(val(first, 0));
    args.push(val(second, 0));
    return map_call(&mut c, view("with_seed"), ty, args);
}
fn context_value<a>(c: (&a mut C), expected: u64) -> Val {
    start := c.pos;
    mut v = expr_expected(&mut c, 0, expected);
    end := c.pos;
    if expected != NO_TYPE {
        v = adopt_value(&mut c, v, start, end, expected);
        require_type(&mut c, v.ty, expected);
    } else {
        if (c.none_start == start) & (c.none_end == end) {
            fail(&mut c, view("map literal optional needs an expected type"));
        }
    }
    return v;
}
fn map_literal_insert<a>(c: (&a mut C), map: Val, key: Val, value: Val) -> unit {
    receiver := place_slot(&mut c, map.t, map.ty, 1);
    mut args = Val[];
    args.push(receiver);
    args.push(key);
    args.push(value);
    old := map_call(&mut c, view("map_insert"), map.ty, args);
    r := resource(&mut c, old.t);
    if r != 0 {
        release(&mut c, r - 1);
    }
    close_loans(&mut c);
    return ();
}
fn map_expression<a>(c: (&a mut C), expected: u64) -> Val {
    // A type-headed constructor is identified by its following () or ::, not capitalization.
    mut q = c.pos;
    mut depth = 0;
    while q < c.toks.len() {
        k := kind_at(&mut c, q);
        if k == 91 {
            depth += 1;
        }
        if k == 93 {
            depth -= 1;
            if depth == 0 {
                break;
            }
        }
        if k == 0 {
            fail(&mut c, view("unclosed map expression"));
        }
        q += 1;
    }
    following := kind_at(&mut c, q + 1);
    if (following == 40) || (following == 260) {
        ty := parse_type(&mut c);
        if !is_map_type(&mut c, ty) {
            fail(&mut c, view("map constructor needs [K: V]"));
        }
        if eat(&mut c, view("::")) {
            name := ident(&mut c);
            if !same(view(name), view("with_seed")) {
                fail(&mut c, view("unknown map constructor"));
            }
            expect(&mut c, view("("));
            first := context_value(&mut c, 0);
            expect(&mut c, view(","));
            second := context_value(&mut c, 0);
            expect(&mut c, view(")"));
            mut args = Val[];
            args.push(first);
            args.push(second);
            return map_call(&mut c, view("with_seed"), ty, args);
        }
        expect(&mut c, view("("));
        expect(&mut c, view(")"));
        return map_new(&mut c, ty);
    }
    // An untyped literal: the colon decides. `[1, 2, 3]` is a vector, `["a": 1]` a map, and the two
    // empty forms `[]` and `[:]` name no element, so they need the type the context expects. A type
    // the context fixes is honoured first: a vector type reads the literal as `T[...]` would.
    if is_vector_type(&mut c, expected) {
        return collection_literal(&mut c, expected, u64(expected == 2));
    }
    // An array is expected: the literal is that array (an untyped literal with nothing expected
    // stays a vector).
    if is_array(&mut c, expected) {
        return array_literal(&mut c, expected);
    }
    expect(&mut c, view("["));
    mut ty = expected;
    mut keyty = NO_TYPE;
    mut valuety = NO_TYPE;
    if is_map_type(&mut c, ty) {
        types := type_args(&mut c, ty);
        keyty = types[0];
        valuety = types[1];
    }
    if eat(&mut c, view(":")) {
        expect(&mut c, view("]"));
        if keyty == NO_TYPE {
            fail(&mut c, view("empty map [:] needs a map expected type"));
        }
        return map_new(&mut c, ty);
    }
    if is(&mut c, view("]")) {
        diag_help(&mut c, view("name the element type (`u64[]`) or give the binding a type (`v: u64[] = []`)"));
        fail(&mut c, view("empty `[]` needs a vector expected type"));
    }
    kstart := c.pos;
    key := context_value(&mut c, keyty);
    kend := c.pos;
    if (keyty == NO_TYPE) && !is(&mut c, view(":")) {
        // No colon after the first element: a vector of that element's type.
        vty := vec_of(&mut c, key.ty);
        return collection_body(&mut c, vty, u64(vty == 2), true, key, kstart, kend);
    }
    expect(&mut c, view(":"));
    value := context_value(&mut c, valuety);
    if keyty == NO_TYPE {
        keyty = key.ty;
        valuety = value.ty;
        mut types = u64[];
        types.push(keyty);
        types.push(valuety);
        ty = named_type(&mut c, copy_bytes(view("hashmap")), copy_bytes(view("Map")), types);
    }
    map := map_new(&mut c, ty);
    map_literal_insert(&mut c, val(map.t, map.ty), key, value);
    while eat(&mut c, view(",")) {
        if is(&mut c, view("]")) {
            break;
        }
        nextkey := context_value(&mut c, keyty);
        expect(&mut c, view(":"));
        nextvalue := context_value(&mut c, valuety);
        map_literal_insert(&mut c, val(map.t, map.ty), nextkey, nextvalue);
    }
    expect(&mut c, view("]"));
    return map;
}

// `expected` is the type the place this value goes into has (NO_TYPE when the context fixes none):
// a closure literal reads it as its signature hint, and an `if`/`match` in expression position hands
// it to its arms, so a literal, a `None` or a narrower integer adopts the type the context wants.
fn primary<a>(c: (&a mut C), expected: u64) -> Val {
    k := kind(&mut c);
    // An `if` written where a value is required. The statement form is what `statement_body` parses,
    // and it sees an `if` that begins a statement first, so this one path covers an initializer, an
    // argument, a `return`, a record field and a match arm.
    if (k == 1) & is(&mut c, view("if")) {
        return if_value(&mut c, expected, 0, NO_TYPE);
    }
    // The same for `match`: `x := match n { 0 => 1, _ => 2 };`.
    if (k == 1) & is(&mut c, view("match")) {
        return match_value(&mut c, expected);
    }
    // And for `unsafe`: `count := unsafe { c_alloc_buffers(&mut buffers) };`. The statement form is a
    // block; this is the value form, and it takes the same lexical boundary - the depth is raised for
    // the expression and restored after it, so move, drop and borrow rules still apply inside.
    if (k == 1) & is(&mut c, view("unsafe")) & is_at(&mut c, c.pos + 1, view("{")) {
        advance(&mut c);
        expect(&mut c, view("{"));
        depth := c.unsafe_depth;
        exchange(&mut c.unsafe_depth, depth + 1);
        v := expr(&mut c, 0);
        expect(&mut c, view("}"));
        exchange(&mut c.unsafe_depth, depth);
        return v;
    }
    // `@expr`: the next operand, folded at compile time (stage C1: literals, constants, size_of,
    // align_of and target; a call in it is the run tier, C3).
    if (k == 64) & is_at(&mut c, c.pos + 1, view("embed")) {
        return embed_file(&mut c);
    }
    if (k == 1) & (c.ct_loop_names.len() != 0) & (next_kind(&mut c) == 46) {
        loop_name := tok_text(&mut c, c.pos);
        b := ct_loop_binding(&mut c, view(loop_name));
        if b != 0 {
            advance(&mut c);
            advance(&mut c);
            what := ident(&mut c);
            if same(view(what), view("name")) {
                field_name := ct_loop_field_name(&mut c, b);
                return string_from_bytes(&mut c, &field_name);
            }
            if same(view(what), view("index")) {
                return val(imm(&mut c, c.ct_loop_index[b - 1]), int_type(&mut c, 64, 0));
            }
            fail(&mut c, view("a field from @for has .name and .index (and x.@f for the value)"));
        }
    }
    if (k == 64) & (c.probe_mode != 0) {
        // Inside a probe, `@f(...)` is the same value computed now: call it, rather than start
        // another probe (which would compile this same program again).
        after_at := c.pos + 1;
        exchange(&mut c.pos, after_at);
        if ct_call_ahead(&mut c) {
            return primary(&mut c, expected);
        }
        exchange(&mut c.pos, after_at - 1);
    }
    if k == 64 {
        advance(&mut c);
        v := ct_primary(&mut c);
        if v.ty == ct_tag_ty() {
            fail(&mut c, view("a target tag is not a value a program can hold; compare it in @if"));
        }
        return val(imm(&mut c, v.value), v.ty);
    }
    if (k == 1) & (c.tnames.len() != 0) {
        // A value parameter (`n` in `fn f<@n: u64>`) reads as its constant. Checked before every
        // other name, because the parameter also lives in the type-parameter table, where other
        // paths would take it for a type.
        name_text := tok_text(&mut c, c.pos);
        vp := value_param(&mut c, view(name_text));
        if (vp != 0) & (next_kind(&mut c) != 40) {
            advance(&mut c);
            v := value_param_value(&mut c, vp - 1);
            exchange(&mut c.ct_unbound, 0);
            return val(imm(&mut c, v.value), c.type_bounds[vp - 1] / 8);
        }
    }
    if (k == 1) & (is(&mut c, view("size_of")) || is(&mut c, view("align_of"))) & (next_kind(&mut c) == 40) {
        align := u64(is(&mut c, view("align_of")));
        advance(&mut c);
        n := ct_layout(&mut c, align);
        return val(imm(&mut c, n), 0);
    }
    if k == 267 {
        // `**r` for `r: &&T` (what `filter` hands its predicate over reference items): the inner
        // reference is only passed through, never kept, so it needs no loan of its own.
        advance(&mut c);
        r := expr(&mut c, 10);
        observe(&mut c, r.t);
        if ty_kind(&mut c, r.ty) != 7 {
            fail(&mut c, view("* requires a typed reference"));
        }
        inner := ty_arg(&mut c, r.ty);
        if (ty_kind(&mut c, inner) != 7) || (ty_mode(&mut c, inner) != 0) {
            fail(&mut c, view("** needs a reference to a shared reference"));
        }
        n := ref_load(&mut c, r.t, inner);
        release_temporary(&mut c, r.t);
        target := ty_arg(&mut c, inner);
        if needs_drop(&mut c, target) {
            fail(&mut c, view("cannot copy an owned value out of a reference; use exchange"));
        }
        k2 := ty_kind(&mut c, target);
        if (k2 == 5) || (k2 == 27) || (k2 == 7) {
            fail(&mut c, view("** copies a plain value; borrow views and references through one level"));
        }
        m := ref_load(&mut c, n, target);
        return val(m, target);
    }
    if k == 42 {
        // `*r`: dereference; postfix accessors bind tighter (`*r.f` is `*(r.f)`).
        advance(&mut c);
        r := expr(&mut c, 10);
        return deref_value(&mut c, r);
    }
    if k == 38 {
        advance(&mut c);
        write := u64(eat(&mut c, view("mut")));
        return reference_borrow(&mut c, write);
    }
    if k == 40 {
        // `(TYPE)[...]` / `(TYPE)[]`: a literal whose element type needs parentheses.
        head := c.pos + 1;
        headtext := tok_text(&mut c, head);
        if simple_type_head(&mut c, view(headtext))
            || (kind_at(&mut c, head) == 38)
            || (kind_at(&mut c, head) == 91) {
            mut depth = 0;
            mut q = c.pos;
            while q < c.toks.len() {
                kk := kind_at(&mut c, q);
                if kk == 40 {
                    depth += 1;
                }
                if kk == 41 {
                    depth -= 1;
                    if depth == 0 {
                        break;
                    }
                }
                q += 1;
            }
            if kind_at(&mut c, q + 1) == 91 {
                // `(T)[...]` or a tuple type `(A, B)[...]`.
                ty := parse_type_base(&mut c);
                return finish_type_literal(&mut c, ty);
