fn storage_bonds<a>(c: (&a mut C), source: u64, destination: u64) -> unit {
    mut owners = u64[];
    n := c.bonds.len();
    if region_of(&mut c, destination) == 18446744073709551615 {
        for i in n {
            mut b = &c.bonds[i];
            holder := b.holder;
            guard := b.guard;
            loan := b.loan;
            if (guard == 3) & ownership::ancestor(&c.check, destination, holder) {
