        }
        shadow := find_local(&mut c, view(first));
        if (b != 0) & (shadow != 0) {
            mut callable = local_ty(&mut c, shadow - 1);
            while ty_kind(&mut c, callable) == 7 {
                callable = ty_arg(&mut c, callable);
            }
            ck := ty_kind(&mut c, callable);
            if (ck == 12) || (ck == 20) || (ck == 25) {
                b = 0;
            }
        }
        if b != 0 {
            return builtin(&mut c, b);
        }
        local := find_local(&mut c, view(first));
        if local != 0 {
            slot := local_id(&mut c, local - 1);
            ty := local_ty(&mut c, local - 1);
            mut callable = ty;
            while ty_kind(&mut c, callable) == 7 {
                callable = ty_arg(&mut c, callable);
            }
            if (ty_kind(&mut c, callable) == 12) || (ty_kind(&mut c, callable) == 20) || (ty_kind(&mut c, callable) == 25) {
                return indirect_call(&mut c, val(slot, ty), 0);
            }
        }
        // A value of a callable-bound type parameter (`f: F` with `F: FnMut(T) -> U`) in a generic
        // body: called with the bound's signature. A specialisation binds `F` to the closure's own
        // type and takes the branch above.
        if local != 0 {
            outer := local_ty(&mut c, local - 1);
            // `g := &mut self.f` with `f: F`: the reference's referent is the callable parameter.
            mut pty = outer;
            if ty_kind(&mut c, pty) == 7 {
                pty = ty_arg(&mut c, pty);
            }
            bound := param_callable(&mut c, pty);
            if bound != NO_TYPE {
                slot := local_id(&mut c, local - 1);
                // In a specialisation the call keeps the closure's own environment (so it is
                // direct) and takes the bound's signature with the specialisation's bindings
                // (`T`, `U` as the body sees them), so arguments and result line up with the body.
                mut calltype = bound;
                if ty_kind(&mut c, pty) == 10 {
                    sig := spec_callable_signature(&mut c, pty);
                    if (sig != NO_TYPE) && (ty_kind(&mut c, bound) == 20) {
                        calltype = intern_env(&mut c, 20, ty_arg(&mut c, sig), ty_mode(&mut c, bound), type_regions(&mut c, bound), type_args(&mut c, sig), ty_env(&mut c, bound));
                    }
                    // A named function given for F: called through its pointer with the bound's
                    // signature, as the body sees it.
                    if (sig != NO_TYPE) && (ty_kind(&mut c, bound) == 12) {
                        calltype = intern_args(&mut c, 12, ty_arg(&mut c, sig), 0, u64[], type_args(&mut c, sig));
                    }
                }
                if ty_kind(&mut c, outer) == 7 {
                    viaref := intern_full(&mut c, 7, calltype, ty_mode(&mut c, outer), type_regions(&mut c, outer));
                    return indirect_call(&mut c, val(slot, viaref), 0);
                }
                return indirect_call(&mut c, val(slot, calltype), 0);
            }
        }
        if local == 0 {
            captured := capture_field(&mut c, view(first), 0, 0);
            if captured.ty != NO_TYPE {
                ck := ty_kind(&mut c, captured.ty);
                if (ck == 12) || (ck == 20) || (ck == 25) {
                    return indirect_call(&mut c, captured, 0);
                }
            }
        }
        return call(&mut c, view(m), view(first));
    }
    mut l = find_local(&mut c, view(first));
    if l != 0 {
        id := local_id(&mut c, l - 1);
        ty := local_ty(&mut c, l - 1);
        if kind(&mut c) != 46 {
            observe(&mut c, id);
            // An untyped literal binding reads as its literal, so the use site may adopt a type.
            if (c.raw == 0) & flex_read(&mut c, l - 1) {
                entry := &c.locals[l - 1];
                value := entry.lit;
                negative := entry.neg;
                floating := entry.flex == 2;
                p := c.pos;
                if floating {
                    exchange(&mut c.flit_start, p - 1);
                    exchange(&mut c.flit_end, p);
                    exchange(&mut c.flit_tok, value);
                    exchange(&mut c.flit_neg, negative);
                } else {
                    exchange(&mut c.lit_start, p - 1);
                    exchange(&mut c.lit_end, p);
                    exchange(&mut c.lit_value, value);
                    exchange(&mut c.lit_negative, negative);
                }
            }
        } else {
            commit_flex(&mut c, l - 1);
        }
        if (c.raw == 0) & (kind(&mut c) != 46) {
            entry := &c.locals[l - 1];
            if entry.origin != 0 {
                if !flex_read(&mut c, l - 1) {
                    p := c.pos;
                    exchange(&mut c.cf_start, p - 1);
                    exchange(&mut c.cf_end, p);
                    exchange(&mut c.cf_local, l);
                }
            }
        }
        return field_path(&mut c, id, ty, 0);
    }
    captured := capture_field(&mut c, view(first), 0, 0);
    if captured.ty != NO_TYPE {
        // A captured shared reference, view or slice read as a value is re-borrowed - `load(&name)`,
        // which keeps the loan it came from - so it can be passed on, bound or returned without
