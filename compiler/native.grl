        advance(&mut c);
        r := expr(&mut c, 10);
        return deref_value(&mut c, r);
    }
    if k == 38 {
        if c.typed_refs == 0 {
            return view_borrow(&mut c);
        }
        advance(&mut c);
        write := u64(eat(&mut c, view("mut")));
        return reference_borrow(&mut c, write);
    }
    if k == 40 {
