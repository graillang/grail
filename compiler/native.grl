        }
        loan = ownership::reborrow_place(&mut c.check, parent, place, 1);
    } else {
        loan = ownership::borrow_place(&mut c.check, place, 1);
    }
    if loan == 0 {
        fail(
            &mut c,
            view("calling a FnMut closure needs exclusive access to the closure: it is already borrowed or being called")
        );
    }
    bond(&mut c, place, loan);
