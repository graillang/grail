                ffi_store_stack(&mut c, x86, base + next * 8);
                next = next + 1;
                o(&mut c, view("movq 8(%r10),%rax\n"));
            }
            ffi_store_stack(&mut c, x86, base + next * 8);
            next = next + 1;
            continue;
        }
        if is_float(&mut c, ty) & rv_var {
            // Promoted to double and moved as its bits through the integer path.
            get(&mut c, args[i], view("%rax"));
            if ints < 8 {
                o(&mut c, view("movq %rax,"));
                o(&mut c, view(ffi_int_reg(abi, ints)));
                c.out.push(10);
                ints = ints + 1;
            } else {
                ffi_store_stack(&mut c, x86, base + next * 8);
                next = next + 1;
            }
            continue;
        }
        if is_float(&mut c, ty) {
            // A variadic float is promoted to double (Grail already holds the double's value).
            single := is_f32(&mut c, ty) && !variadic_arg;
            mut freg = 99;
            mut ireg = 99;
            if abi == 1 {
