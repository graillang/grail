    let f=vec_get(c.funcs,e-1);
    let m=copy_bytes(read(f.module));
    let name=copy_bytes(read(f.name));
    let count=f.count;let result=f.ret;let first=f.first;
    let named_main=same(read(name),read("main"));
    if named_main{if (result!=0)&(result!=1){fail(borrow_mut(c),read("main must return unit or num"));}}else{if result!=0{fail(borrow_mut(c),read("executable entry must return num"));}}
