    held := move_value(&mut c, v);
    slot := held.t;
    get(&mut c, slot, view("%rax"));
    // The sign bit as a zero test: AArch64/RV64 lowering emulates the zero and carry flags only.
    o(&mut c, view("shrq $63,%rax\ntestq %rax,%rax\n"));
