    for i in c.members.len() {
        m := &c.members[i];
        if (m.base == root) & (m.field == field) {
            return m.place;
        }
    }
    kind := ty_kind(&mut c, ty);
    copy := !needs_drop(&mut c, ty) & (kind != 7);
    place := ownership::field(&mut c.check, root, copy);
    c.members.push(Member { base: root, field: field, place: place });
