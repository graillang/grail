// Element format codes for printing vectors: 1 u64, 2 bool, 3 f64, 4 text/bytes, 5 nested vector,
// 256+ sized integer (int_code); 0 means not printable.
fn element_code<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    if ty == 0 {
        return 1;
    }
    if k == 19 {
        return 2;
    }
    if k == 21 {
        if is_f32(borrow_mut(c), ty) {
            return 7;
        }
        return 3;
    }
    if k == 22 {
        return 6;
    }
    if (k == 3) + (k == 4) + (k == 5) {
        return 4;
    }
    if k == 18 {
        return 1024 + int_code(borrow_mut(c), ty);
    }
    if k == 6 {
        inner := ty_arg(borrow_mut(c), ty);
        sub := element_code(borrow_mut(c), inner);
        if sub == 0 {
            return 0;
        }
        return 4096 * sub + 5;
    }
    return 0;
}
fn format_precision<a, b>(c: (&a mut C), text: &b [u8], start: u64) -> u64 {
    mut i = start + 2;
    if (i < text.len()) == 0 {
        fail(borrow_mut(c), &"bad format spec (expected {:.N})");
    }
    if text[i] != 46 {
        fail(borrow_mut(c), &"bad format spec (expected {:.N})");
    }
    i += 1;
    mut n = 0;
    mut any = 0;
    while i < text.len() {
        d := text[i];
        if (d < 48) + (57 < d) {
            break;
        }
        n = n * 10 + d - 48;
        any = 1;
        if 300 < n {
            fail(borrow_mut(c), &"format precision too large");
        }
        i += 1;
    }
    if any == 0 {
        fail(borrow_mut(c), &"bad format spec (expected {:.N})");
    }
    if (i < text.len()) == 0 {
        fail(borrow_mut(c), &"bad format spec (expected {:.N})");
    }
    if text[i] != 125 {
        fail(borrow_mut(c), &"bad format spec (expected {:.N})");
    }
    return n;
}
fn format_precision_end<a>(text: &a [u8], start: u64) -> u64 {
    mut i = start;
    while text[i] != 125 {
