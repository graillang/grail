        }
    }
    return ();
}
fn return_bonds<a>(c: (&a mut C), src: u64, dst: u64, aggregate: u64) -> unit {
    if (src == 0) || (dst == 0) {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if loan_live(&mut c, loan) != 0 {
            if ownership::ancestor(&c.check, src, holder) {
                mut role = guard;
                if aggregate != 0 {
                    role = 1;
                }
                if guard == 3 {
                    role = 3;
                }
                if aggregate == 3 {
                    role = 3;
                }
                bond_kind(&mut c, dst, loan, role);
            }
        }
    }
    return ();
}
fn close_loans<a>(c: (&a mut C)) -> unit {
    mut changed = 1;
    while changed != 0 {
        changed = 0;
        mut i = c.check.loans.len();
        while i != 0 {
            i = i - 1;
            mut l = &c.check.loans[i];
            live := l.live;
            if live != 0 {
                mut held = 0;
                for j in c.bonds.len() {
                    mut b = &c.bonds[j];
                    loan := b.loan;
                    holder := b.holder;
                    if loan == i + 1 {
                        state := ownership::status(&c.check, holder);
                        if (state == 1) || (state == 3) {
                            held = 1;
                            break;
                        }
                    }
                }
                if held == 0 {
                    if ownership::end_loan(&mut c.check, i + 1) == 0 {
                        changed = 1;
                    }
                }
            }
        }
        for j in c.origins.len() {
            o := &c.origins[j];
            root := o.place;
            region := o.region;
            if region == 18446744073709551615 {
                // An anonymous origin (the referent behind a returned reference) ends once no
                // live loan reaches into it. After a branch join it may be "maybe live" (3): it
                // ended on one path only, which is just as dead once nothing reaches it.
                ostate := ownership::status(&c.check, root);
                if (ostate == 1) || (ostate == 3) {
                    mut reached = 0;
                    for k in c.check.loans.len() {
                        mut l = &c.check.loans[k];
                        live := l.live;
                        source := l.source;
                        if live != 0 {
                            if ownership::ancestor(&c.check, root, source) {
                                reached = 1;
                                break;
                            }
