fn move_out<a>(c: (&a mut C), v: Val) -> unit {
    if c.raw != 0 {
        return ();
    }
    materialise(&mut c, v.t, v.ty);
    if !affine(&mut c, v.ty) {
        return ();
    }
    index := resource(&mut c, v.t);
    if index == 0 {
        fail(&mut c, view("owned value lacks ownership record"));
    }
    // Moving a field out of an owned record leaves a hole its drop helper would walk. A record with a
    // user `Drop` is opaque to that walk, so the move is refused (`match &p` borrows instead).
    base_slot := c.resources[index - 1].base;
    via_slot := c.resources[index - 1].via;
    if (base_slot != 0) & (via_slot == 0) {
        parent := resource(&mut c, base_slot - 1);
        if parent != 0 {
            // stays: `c.resources[parent - 1]` is a borrowed element (see drop_hook_symbol).
            pty := c.resources[parent - 1].ty;
            if drop_type(&mut c, pty) != 0 {
                fail(&mut c, view("a field cannot be moved out of a value that implements Drop"));
            }
        }
