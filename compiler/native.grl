        }
        if !(is(&mut c, view("(")) || is(&mut c, view("<"))) {
            function := find_func(&mut c, view(first), view(second));
            if function != 0 {
                return function_value(&mut c, function - 1);
            }
            constant := constant_value(&mut c, view(first), view(second));
            if constant.ty != NO_TYPE {
