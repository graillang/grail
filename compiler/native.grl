                if ints < 4 {
                    ints = ints + 1;
                } else {
                    stack = stack + 1;
                }
            } else {
                if floats < 8 {
                    floats = floats + 1;
                } else {
                    if (abi == 3) & (ints < 8) {
                        ints = ints + 1;
                    } else {
                        stack = stack + 1;
                    }
                }
