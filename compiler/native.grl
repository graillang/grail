                    on(borrow_mut(c), value);
                    o(borrow_mut(c), &",%rcx\n");
                    get(borrow_mut(c), xt, &"%rax");
                    o(borrow_mut(c), &"subq %rcx,%rax\n");
                    width := wrapping_sub(high, value);
                    o(borrow_mut(c), &"movabsq $");
                    on(borrow_mut(c), width);
