        arity = 4;
    }
    if id == 109 {
        arity = 5;
    }
    if (id == 111) + (id == 115) + (id == 116) {
        arity = 2;
    }
    if id == 112 {
        arity = 3;
    }
    if (id == 117) + (id == 118) {
        arity = 3;
    }
    if id == 119 {
        arity = 4;
    }
    if id == 120 {
        arity = 0;
    }
