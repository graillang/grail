// one word for everything else (a record, vector or string value is a pointer to its storage).
fn ptr_width<a>(c: (&a mut C), pointee: u64) -> u64 {
    k := ty_kind(&mut c, pointee);
    if k == 21 {
        fail(&mut c, view("read and write do not reinterpret a float pointee yet; use an f64[] view"));
    }
    if k == 18 {
        bits := ty_arg(&mut c, pointee) / 8;
        if bits == 8 {
            return 8;
        }
        return bits;
    }
    return 8;
}
