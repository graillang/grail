    if (narrow != 0) & (is_c_record(&mut c, narrow) == 0) {
        return caddr_load(&mut c, r, narrow);
    }
    if !subword(&mut c, ty) {
        get(&mut c, r, view("%rax"));
        o(&mut c, view("movq (%rax),%rax\n"));
        return save(&mut c);
    }
    word := label(&mut c);
    done := label(&mut c);
    get(&mut c, r, view("%rax"));
    o(&mut c, view("movq %rax,%rcx\nshrq $63,%rcx\ntestq %rcx,%rcx\n"));
    jump(&mut c, view("jz"), word);
    o(&mut c, view("shlq $1,%rax\nshrq $1,%rax\n"));
    at := save(&mut c);
    concrete := base_type(&mut c, ty);
    v := caddr_load(&mut c, at, concrete);
    get(&mut c, v, view("%rax"));
    jump(&mut c, view("jmp"), done);
    mark(&mut c, word);
    o(&mut c, view("movq (%rax),%rax\n"));
    mark(&mut c, done);
    return save(&mut c);
}
// Writes `value` (a `ty`) through a reference slot, as `ref_load` reads.
fn ref_store<a>(c: (&a mut C), r: u64, ty: u64, value: u64) -> unit {
