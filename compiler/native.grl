        mut raw_bits = 0;
        if (named == 0) & starts_with(view(first), view("wrapping_")) {
            rest := first[9:].copy();
            named = int_name(view(rest));
            if named != 0 {
                wrapping = 1;
            }
        }
        if (named == 0) & same(view(first), view("bits")) {
            named = 64;
            raw_bits = 1;
        }
        if named != 0 {
            if (find_local(&mut c, view(first)) == 0)
                & (find_func(&mut c, view(m), view(first)) == 0) {
                advance(&mut c);
                value := expr(&mut c, 0);
                expect(&mut c, view(")"));
                mut source = value.ty;
                if !(integer(&mut c, source)
                    || is_bool(&mut c, source)
                    || is_float(&mut c, source)
                    || is_char(&mut c, source)) {
                    fail(&mut c, view("integer conversion needs an integer"));
                }
                if is_char(&mut c, source) {
                    source = int_type(&mut c, 32, 0);
                }
                ty := int_type_named(&mut c, named);
                if raw_bits != 0 {
                    return val(value.t, 0);
                }
                if is_float(&mut c, source) {
                    if wrapping != 0 {
                        fail(&mut c, view("wrapping conversion from f64 is not supported"));
                    }
                    to := int_code(&mut c, ty);
                    tv := imm(&mut c, to);
                    slot := invoke(&mut c, view("rt_int_from_f64"), two(value.t, tv));
                    return val(slot, ty);
                }
                from := int_code(&mut c, source);
                mut to = int_code(&mut c, ty);
                if wrapping != 0 {
                    to = (to % 512) + 512;
                }
                fv := imm(&mut c, from);
                tv := imm(&mut c, to);
                slot := invoke(&mut c, view("rt_int_cast"), three(value.t, fv, tv));
                return val(slot, ty);
            }
        }
        if c.typed_refs != 0 {
            if same(view(first), view("borrow")) {
                fail(&mut c, view("borrow was removed; write &value"));
            }
            if same(view(first), view("borrow_mut")) {
                fail(&mut c, view("borrow_mut was removed; write &mut value"));
            }
        }
        // A function of this module, or a callable local (closure, function pointer), named like a
        // builtin shadows it, as predeclared identifiers are in Go.
        mut b = builtin_id(view(first));
        here := module_copy(&mut c);
        if (b != 0) & (find_func(&mut c, view(here), view(first)) != 0) {
            b = 0;
        }
        shadow := find_local(&mut c, view(first));
        if (b != 0) & (shadow != 0) {
            mut callable = local_ty(&mut c, shadow - 1);
            while ty_kind(&mut c, callable) == 7 {
                callable = ty_arg(&mut c, callable);
            }
            ck := ty_kind(&mut c, callable);
            if (ck == 12) || (ck == 20) || (ck == 25) {
