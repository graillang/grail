    decl := fn_value_decl(&mut c);
    record := intern_args(&mut c, 8, decl, 0, u64[], u64[]);
    sz := imm(&mut c, 3);
    obj := invoke(&mut c, view("rt_rec"), one(sz));
    o(&mut c, view("leaq grail_fn_thunk(%rip),%rax\n"));
    code := save(&mut c);
    rec_store(&mut c, obj, 0, code);
    o(&mut c, view("leaq "));
    drop_name(&mut c, record);
    o(&mut c, view("(%rip),%rax\n"));
