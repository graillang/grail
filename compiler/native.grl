fn is_comparison(k: u64) -> bool {
    return (k == 258) || (k == 259) || (k == 60) || (k == 62) || (k == 269) || (k == 270);
}
fn prec(k: u64) -> u64 {
    if k == 274 {
        return 1;
    }
    if k == 273 {
        return 2;
    }
    if (k == 38) || (k == 124) {
        return 3;
    }
    if k == 94 {
        return 4;
    }
    if is_comparison(k) {
        return 5;
    }
    if (k == 271) || (k == 272) {
        return 6;
    }
    if (k == 43) || (k == 45) {
        return 7;
    }
    if (k == 42) || (k == 37) || (k == 47) {
        return 8;
    }
    if k == 267 {
        return 9;
    }
    return 0;
}
// `?` on `S |? F` yields the union of S and remaps each F by identity.
fn success_members<a>(c: (&a mut C), ty: u64) -> u64 {
    args := type_args(&mut c, ty);
    s := result_success_count(&mut c, ty);
    if s == 1 {
        return args[0];
    }
    mut members = u64[];
    for i in s {
        members.push(args[i]);
    }
    return make_union(&mut c, members, 0, copy_bytes(view(".union")), view("Union"));
}
fn propagate_result_union<a>(c: (&a mut C), x: Val, unwrap: u64) -> Val {
    xt := x.t;
    ty := x.ty;
    args := type_args(&mut c, ty);
    s := result_success_count(&mut c, ty);
    result := c.result;
    mut failure_targets = u64[];
    if unwrap == 0 {
        if !is_result_union(&mut c, result) {
            fail(&mut c, view("result propagation requires a result return type"));
        }
        returned := type_args(&mut c, result);
        rs := result_success_count(&mut c, result);
        for i in s..args.len() {
            mut found = 0;
            mut target = 0;
            for j in rs..returned.len() {
                if same_type(&mut c, args[i], returned[j]) != 0 {
                    found += 1;
                    target = j;
                }
            }
            if found != 1 {
                fail(&mut c, view("result failure type is not in the return failure set"));
            }
            failure_targets.push(target);
        }
    }
    success := label(&mut c);
    failure := label(&mut c);
    get(&mut c, xt, view("%rax"));
    o(&mut c, view("cmpq $"));
    on(&mut c, s);
    o(&mut c, view(",(%rax)\n"));
    jump(&mut c, view("jb"), success);
    jump(&mut c, view("jmp"), failure);
    // Failure path.
    before := ownership::snapshot(&c.check);
    mark(&mut c, failure);
    if unwrap != 0 {
        o(&mut c, view("call rt_abort\n"));
    } else {
        for i in s..args.len() {
            next := label(&mut c);
            get(&mut c, xt, view("%rax"));
            o(&mut c, view("cmpq $"));
            on(&mut c, i);
            o(&mut c, view(",(%rax)\n"));
            jump(&mut c, view("jne"), next);
            target := imm(&mut c, failure_targets[i - s]);
            move_out(&mut c, val(xt, ty));
            source := place_of(&mut c, xt);
            ns := invoke(&mut c, view("rt_enum_retag"), two(xt, target));
            own(&mut c, ns, result);
            dest := place_of(&mut c, ns);
            transfer_bonds(&mut c, source, dest);
            validate_return(&mut c, val(ns, result));
            move_out(&mut c, val(ns, result));
            cleanup(&mut c, 0);
            get(&mut c, ns, view("%rax"));
            o(&mut c, view("leave\nret\n"));
            mark(&mut c, next);
        }
        o(&mut c, view("call rt_abort\n"));
    }
    ownership::restore(&mut c.check, &before);
    // Success path.
    mark(&mut c, success);
    sty := success_members(&mut c, ty);
    if s == 1 {
        payload := rec_load(&mut c, xt, 1, 0);
        move_out(&mut c, val(xt, ty));
        invoke(&mut c, view("rt_free"), one(xt));
        source := place_of(&mut c, xt);
        own(&mut c, payload, sty);
        dest := place_of(&mut c, payload);
        transfer_bonds(&mut c, source, dest);
        stored_source(&mut c, payload, sty);
        return val(payload, sty);
    } else {
        tag := rec_load(&mut c, xt, 0, 0);
        move_out(&mut c, val(xt, ty));
        source := place_of(&mut c, xt);
        ns := invoke(&mut c, view("rt_enum_retag"), two(xt, tag));
        own(&mut c, ns, sty);
        dest := place_of(&mut c, ns);
        transfer_bonds(&mut c, source, dest);
        stored_source(&mut c, ns, sty);
        return val(ns, sty);
    }
}
// A union's first member is success; other members propagate by type.
fn propagate_union<a>(c: (&a mut C), x: Val, unwrap: u64) -> Val {
    xt := x.t;
    args := type_args(&mut c, x.ty);
    result := c.result;
    mut targets = u64[];
    if unwrap == 0 {
        if !is_union(&mut c, result) {
            fail(&mut c, view("union propagation requires a union return type"));
        }
        returned := type_args(&mut c, result);
        for i in args.len() {
            mut target = 0;
            mut found = 0;
            if i != 0 {
                for j in returned.len() {
                    if same_type(&mut c, args[i], returned[j]) != 0 {
                        found += 1;
                        target = j;
                    }
                }
            }
            if (i != 0) && ((found != 1) || (target == 0)) {
                fail(&mut c, view("union failure type is not a failure in return type"));
            }
            targets.push(target);
        }
    }
    get(&mut c, xt, view("%rax"));
    o(&mut c, view("cmpq $0,(%rax)\n"));
    ok := label(&mut c);
    jump(&mut c, view("je"), ok);
    before := ownership::snapshot(&c.check);
    if unwrap != 0 {
        o(&mut c, view("call rt_abort\n"));
    } else {
        endmap := label(&mut c);
        for i in args.len() {
            if i != 0 {
                next := label(&mut c);
                get(&mut c, xt, view("%rax"));
                o(&mut c, view("cmpq $"));
                on(&mut c, i);
                o(&mut c, view(",(%rax)\n"));
                jump(&mut c, view("jne"), next);
                o(&mut c, view("movq $"));
                on(&mut c, targets[i]);
                o(&mut c, view(",(%rax)\n"));
                jump(&mut c, view("jmp"), endmap);
                mark(&mut c, next);
            }
        }
        o(&mut c, view("call rt_abort\n"));
        mark(&mut c, endmap);
        validate_return(&mut c, val(xt, x.ty));
        move_out(&mut c, val(xt, x.ty));
        cleanup(&mut c, 0);
        get(&mut c, xt, view("%rax"));
        o(&mut c, view("leave\nret\n"));
    }
    mark(&mut c, ok);
    ownership::restore(&mut c.check, &before);
    n := rec_load(&mut c, xt, 1, 0);
    move_out(&mut c, val(xt, x.ty));
    invoke(&mut c, view("rt_free"), one(xt));
    ty := args[0];
    own(&mut c, n, ty);
    source := place_of(&mut c, xt);
    dest := place_of(&mut c, n);
    if contains_borrow(&mut c, ty, 0) {
        transfer_bonds(&mut c, source, dest);
    }
    stored_source(&mut c, n, ty);
    return val(n, ty);
}
