fn builtin_id<a>(n: &a [u8]) -> u64 {
    if same(view(n), view("Atomic")) {
        return 30;
    }
    if same(view(n), view("Mutex")) {
        return 31;
    }
    if same(view(n), view("parallel_map")) {
        return 32;
    }
    if same(view(n), view("parallel_for_chunks")) {
        return 43;
    }
    if same(view(n), view("parallel_spawn")) {
        return 44;
    }
    if same(view(n), view("parallel_join")) {
        return 45;
    }
    if same(view(n), view("task_scope")) {
        return 33;
    }
    if same(view(n), view("spawn")) {
        return 34;
    }
    if same(view(n), view("join")) {
        return 35;
    }
    if same(view(n), view("try_join")) {
        return 55;
    }
    if same(view(n), view("task_fail")) {
        return 56;
    }
    if same(view(n), view("ignore_failure")) {
        return 57;
    }
    if same(view(n), view("format")) {
        return 36;
    }
    if same(view(n), view("view")) {
        return 37;
    }
    if same(view(n), view("cstr")) {
        return 39;
    }
    if same(view(n), view("cptr")) {
        return 40;
    }
    if same(view(n), view("cptr_mut")) {
        return 41;
    }
    if same(view(n), view("cnull")) {
        return 42;
    }
    if same(view(n), view("cstr_bytes")) {
        return 46;
    }
    if same(view(n), view("cslice")) {
        return 47;
    }
    if same(view(n), view("ptr_of")) {
        return 48;
    }
    if same(view(n), view("alloc")) {
        return 49;
    }
    if same(view(n), view("free")) {
        return 50;
    }
    if same(view(n), view("ptr_from_addr")) {
        return 51;
    }
    if same(view(n), view("view_mut")) {
        return 38;
    }
    if same(view(n), view("borrow")) {
        return 13;
    }
    if same(view(n), view("borrow_mut")) {
        return 14;
    }
    if same(view(n), view("load")) {
        return 15;
    }
    if same(view(n), view("exchange")) {
        return 16;
    }
    if same(view(n), view("wrapping_add")) {
        return 19;
    }
    if same(view(n), view("wrapping_sub")) {
