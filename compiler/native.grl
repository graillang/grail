            }
            fail(&mut c, view("undefined assignment"));
        }
        entry := &c.locals[l - 1];
        mutable := entry.mutable;
        if mutable == 0 {
            if kind(&mut c) != 46 {
                fail(&mut c, view("assignment requires mut"));
            }
