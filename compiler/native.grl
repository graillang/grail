        mut bound = expr(borrow_mut(c), 0);
        bend := c.pos;
        if c.raw == 0 {
            bound = adopt_value(borrow_mut(c), bound, bstart, bend, 0);
            require_type(borrow_mut(c), bound.ty, 0);
        }
        get(borrow_mut(c), bound.t, &"%rax");
        start = save(borrow_mut(c));
    }
    if eat(borrow_mut(c), &":") {
        mut end = 0;
        if is(borrow_mut(c), &"]") {
            end = apply(borrow_mut(c), &"rt_len", one(slot));
        } else {
            bstart := c.pos;
            mut bound = expr(borrow_mut(c), 0);
            bend := c.pos;
            if c.raw == 0 {
                bound = adopt_value(borrow_mut(c), bound, bstart, bend, 0);
                require_type(borrow_mut(c), bound.ty, 0);
            }
            end = bound.t;
        }
        expect(borrow_mut(c), &"]");
