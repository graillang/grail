        }
        advance(&mut c);
        if eat(&mut c, view(")")) {
            return val(imm(&mut c, 0), 1);
        }
        mut v = expr(&mut c, 0);
        expect(&mut c, view(")"));
        return v;
    }
    if k == 3 {
