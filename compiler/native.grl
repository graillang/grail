        block(borrow_mut(c));
        pop_locals(borrow_mut(c), mark);
        if c.terminated == 0 {
            edge := ownership::snapshot(borrow(c.check));
            if have {
                ownership::merge(borrow_mut(exits), borrow(edge));
            } else {
                exits = edge;
                have = 1;
            }
        }
        jump(borrow_mut(c), &"jmp", end);
        mark(borrow_mut(c), next);
        if eat(borrow_mut(c), &",") == 0 {
            expect(borrow_mut(c), &"}");
            break;
        }
    }
    complete := default + (boolean & (seen.len() == 2));
    if complete == 0 {
        fail(borrow_mut(c), &"non-exhaustive match (add a _ arm)");
    }
    o(borrow_mut(c), &"call rt_abort\n");
    mark(borrow_mut(c), end);
    if have {
        ownership::restore(borrow_mut(c.check), borrow(exits));
        exchange(borrow_mut(c.terminated), 0);
    } else {
        exchange(borrow_mut(c.terminated), 1);
    }
    return ();
