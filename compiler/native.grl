// Bools and integers do not mix (Go, Zig and Rust reject all of these): `&`, `|`, `^` between a bool and
// an integer (`code & (a == 0)` is 2 & 1 == 0), arithmetic on bools (`true + true`), and an integer
// condition (`if n`). Logic is `&&`, `||` and `!`; integers compare explicitly (`n != 0`).
fn strict_bool_check<a>(c: (&a mut C), k: u64, left: u64, right: u64) -> unit {
    lb := is_bool(&mut c, left);
    rb := is_bool(&mut c, right);
    if !lb && !rb {
        return ();
    }
    if lb && rb && (is_comparison(k) || k == 38 || k == 124 || k == 94) {
        return ();
    }
    if lb && rb {
        strict_bool_fail(&mut c, view("arithmetic on bools; use && and || for logic"));
        return ();
    }
    strict_bool_fail(&mut c, view("bool and integer do not mix; use && / || / ! for logic and compare integers explicitly"));
    return ();
}
fn strict_condition<a>(c: (&a mut C), ty: u64) -> unit {
    if !is_bool(&mut c, ty) {
        strict_bool_fail(&mut c, view("a condition must be a bool; compare explicitly (n != 0)"));
    }
    return ();
}
// `==` operands of one record type, or vectors/slices with the same element type in any mix
// (a slice compares with the vector it was cut from, as in Rust).
fn comparable_sequences<a>(c: (&a mut C), left: u64, right: u64) -> u64 {
    if same_type(&mut c, left, right) != 0 {
        return 1;
    }
    lk := ty_kind(&mut c, left);
    rk := ty_kind(&mut c, right);
    if ((lk == 6) || (lk == 27)) && ((rk == 6) || (rk == 27)) {
        le := ty_arg(&mut c, left);
        re := ty_arg(&mut c, right);
        return same_type(&mut c, le, re);
    }
    return 0;
}
// Enforced by default; `--strict-bool-report` prints file:line:column and keeps compiling.
fn strict_bool_fail<a, b>(c: (&a mut C), msg: &b [u8]) -> unit {
    if c.strict_bool_report == 0 {
        fail(&mut c, msg);
        return ();
    }
    p := c.pos;
    t := &c.toks[p];
    st := t.start;
    mut line = 1;
    mut column = 1;
    for i in st {
        if c.src[i] == 10 {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    path := host::arg(c.file + c.arg_offset);
    println("{}:{}:{}: {}", view(path), line, column, msg);
    return ();
}
// ---- statements ----
fn block<a>(c: (&a mut C)) -> unit {
    start := c.pos;
    end := block_end(&mut c, start);
    oldend := c.scope_end;
    exchange(&mut c.scope_end, end);
    expect(&mut c, view("{"));
    mark := c.locals.len();
    mut owners = c.resources.len();
    while !is(&mut c, view("}")) {
        stmt(&mut c);
    }
    advance(&mut c);
    cleanup(&mut c, owners);
    pop_locals(&mut c, mark);
    exchange(&mut c.scope_end, oldend);
    return ();
}
// Last-use ending may retire the lhs reference while parsing the rhs. Retain its
// concrete capability until the store; the pin has no runtime-owned descriptor.
fn pin_assignment<a>(c: (&a mut C), target: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    index := resource(&mut c, target);
    if index == 0 {
        return ();
    }
    r := &c.resources[index - 1];
    authority := r.authority;
    if authority != 0 {
        source := place_of(&mut c, authority - 1);
        if source != 0 {
            slot := imm(&mut c, 0);
            ty := reference_type(&mut c, 0, 0);
            own(&mut c, slot, ty);
            holder := place_of(&mut c, slot);
            return_bonds(&mut c, source, holder, 1);
        }
    }
    return ();
}
fn reserve_compound<a>(c: (&a mut C), slot: u64, through: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    mut place = place_of(&mut c, slot);
    mut authority = authority_of(&mut c, slot);
    if through != 0 {
        place = target_of(&mut c, slot);
    } else {
        authority = 0;
        if place == 0 {
            place = ownership::root(&mut c.check, 1, 1);
            c
                .resources
                .push(
                    Resource {
                        slot: slot,
                        ty: 0,
                        flag: 0,
                        base: 0,
                        field: 0,
                        via: 0,
                        place: place,
                        target: 0,
                        authority: 0,
                    }
                );
        }
    }
    if ownership::status(&c.check, place) != 1 {
        fail(&mut c, view("compound assignment requires initialized numeric storage"));
    }
    mut loan = 0;
    if authority != 0 {
        parent := authority_loan(&mut c, authority, place);
        loan = ownership::reborrow_place(&mut c.check, parent, place, 0);
    } else {
        loan = ownership::borrow_place(&mut c.check, place, 0);
