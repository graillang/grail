    args.push(dropper);
    slot := invoke(&mut c, view("rt_task_spawn"), args);
    ty := intern(&mut c, 16, result);
    release_temporary(&mut c, input);
    release_temporary(&mut c, sref);
    close_loans(&mut c);
    return own(&mut c, slot, ty);
}
fn join_builtin<a>(c: (&a mut C), handle: Val) -> Val {
    expect(&mut c, view(")"));
