                stack_slot(&mut c, n);
                o(&mut c, view(",%rax\n"));
                ref = save(&mut c);
                c.embedded.push(ref);
                c.embedded.push(fty);
            }
            root := place_of(&mut c, b);
            target := member_place(&mut c, root, k, fty);
            authority := authority_of(&mut c, b);
            if c.raw == 0 {
                c
                    .resources
                    .push(
                        Resource {
                            slot: ref,
                            ty: ty,
                            flag: 0,
                            base: b + 1,
                            field: k,
                            via: via,
                            place: 0,
                            target: target,
                            authority: authority,
                        }
                    );
            }
            return val(ref, ty);
        }
        outer_c := c.decls[d].c_layout;
        next_dot := kind(&mut c) == 46;
        inner_c := is_c_record(&mut c, fty);
        raw_fty := field_ty(&mut c, d, k);
        if (outer_c != 0) & (address == 0) & (ty_kind(&mut c, raw_fty) == 32) {
            // A C array field read whole is a fresh vector (rt_carray_load copied the elements out):
            // reading it reads the container, and the reader owns the copy.
            observe(&mut c, b);
            own(&mut c, n, fty);
            return val(n, fty);
        }
        if outer_c != 0 && address == 0 && !next_dot && inner_c {
            // A copied-out embedded C record is a fresh value, independent of the field's place:
            // reading it is a read of the containing record, and the copy is owned by the reader.
            observe(&mut c, b);
            own(&mut c, n, fty);
            return val(n, fty);
