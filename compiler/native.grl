            }
        }
        if !known {
            c.dyn_ifaces.push(id);
        }
        return intern_args(&mut c, 33, id, dyn_bits, dyn_regions, fixed);
    }
    // `&&T`, which the lexer reads as one `&&` token: a shared reference to `&T`, elided lifetime.
    if eat(&mut c, view("&&")) {
        inner := parse_reference(&mut c);
        mut r = 0;
        if c.parsing_input != 0 {
            r = fresh_lifetime(&mut c);
            note_input_region(&mut c, r);
        } else {
            if c.output_region == 0 {
                fail(&mut c, view("elided output reference needs one input lifetime"));
            }
            r = c.output_region;
        }
        mut rs = u64[];
        rs.push(r);
        return intern_full(&mut c, 7, inner, 0, rs);
    }
    if eat(&mut c, view("(")) {
