module native;
use lexer;
use host;
use ownership;

// Direct Linux x86-64 backend: Grail function bodies lower directly to assembly.
// Usage: native OUT.s ENTRY.grl [MODULE.grl...]. The first public function of the
// first file is the entry; it takes nothing or argv[1] as a byte view. Move/initialization
// checks, loans/lifetimes, captured-storage writeback and deterministic drops are active.
// Generic types/functions use typed specialization. Include runtime.grl as source.
// Type ids: 0 num, 1 unit, 2 bytes, 3 string, 4 view; others are interned below.
// Type kinds: 1 num, 2 unit, 3 bytes, 4 string, 5 view, 6 vec(arg), 7 ref(arg),
// 8 named(decl, args), 9 opaque template parameter, 10 opaque bound parameter (arg, identity).

struct Tok { kind:num, start:num, end:num }
struct Ty { kind:num, arg:num, mode:num, regions:vec<num>, args:vec<num> }
struct Decl { module:bytes, name:bytes, is_enum:num, first:num, count:num, regions:num, types:num }
struct Field { name:bytes, ty:num }
struct Func { module:bytes, name:bytes, first:num, count:num, ret:num, types:num, regions:num, file:num, pos:num, raw:num }
struct Spec { template:num, args:vec<num>, first:num, ret:num }
struct Local { name:bytes, ty:num, id:num, last:num, born:num, mutable:num }
struct Val { t:num, ty:num }
struct Resource { slot:num, ty:num, flag:num, base:num, field:num, via:num, place:num, target:num, authority:num }
struct Bond { holder:num, loan:num, guard:num }
struct Origin { place:num, region:num }
struct Member { base:num, field:num, place:num }
struct C {
    src:bytes, toks:vec<Tok>, pos:num, out:vec<num>, module:bytes,
    specs:vec<Spec>, bindings:vec<num>, current_spec:num, validating:num, alias_next:num, types:vec<Ty>, decls:vec<Decl>, fields:vec<Field>, funcs:vec<Func>, params:vec<num>,
    locals:vec<Local>, next:num, entry:num, file:num, label:num, brk:num, cont:num, raw:num, rnames:vec<bytes>, tnames:vec<bytes>, resources:vec<Resource>, loopmark:num, result:num, check:ownership::State, members:vec<Member>, terminated:num, loopcheck:ownership::State, breaks:ownership::State, hasbreak:num, bonds:vec<Bond>, origins:vec<Origin>, scope_end:num, loop_start:num, loop_end:num
}

fn same<a,b>(x:read<a>,y:read<b>)->num {
    if len(x)!=len(y) { return 0; }
    for i in len(x) { if at(x,i)!=at(y,i) { return 0; } }
    return 1;
}
fn div(n:num,d:num)->num {
    var q=0;
    var r=n;
    while (r<d)==0 {
        var m=d;
        var k=1;
        while ((r<m+m)==0)&((m+m<m)==0) { m=m+m; k=k+k; }
        r=r-m;
        q=q+k;
    }
    return q;
}

// ---- output ----
fn o<a,b>(c:ref_mut<a,C>,s:read<b>)->unit {
    for i in len(s) { vec_push(c.out,at(s,i)); }
    return ();
}
fn on<a>(c:ref_mut<a,C>,n:num)->unit {
    if 9<n { on(borrow_mut(c),div(n,10)); }
    vec_push(c.out,48+n%10);
    return ();
}

fn fresh<a>(c:ref_mut<a,C>)->num {
    let id=c.next;
    exchange(borrow_mut(c.next),id+1);
    return id;
}

fn val(t:num,ty:num)->Val { return Val{t:t,ty:ty}; }

// Every intermediate and binding has an rbp-relative eight-byte stack slot.
fn stack_slot<a>(c:ref_mut<a,C>,id:num)->unit {
    vec_push(c.out,45); on(borrow_mut(c),(id+1)*8); o(borrow_mut(c),read("(%rbp)")); return ();
}
fn save<a>(c:ref_mut<a,C>)->num {
    let n=fresh(borrow_mut(c)); o(borrow_mut(c),read("movq %rax,"));
    stack_slot(borrow_mut(c),n); vec_push(c.out,10); return n;
}
fn get<a,b>(c:ref_mut<a,C>,id:num,reg:read<b>)->unit {
    o(borrow_mut(c),read("movq ")); stack_slot(borrow_mut(c),id); vec_push(c.out,44);
    o(borrow_mut(c),reg); vec_push(c.out,10); return ();
}
fn label<a>(c:ref_mut<a,C>)->num {
    let n=c.label; exchange(borrow_mut(c.label),n+1); return n;
}
fn lname<a>(c:ref_mut<a,C>,n:num)->unit { o(borrow_mut(c),read(".L")); on(borrow_mut(c),n); return (); }
fn mark<a>(c:ref_mut<a,C>,n:num)->unit { lname(borrow_mut(c),n); o(borrow_mut(c),read(":\n")); return (); }
fn jump<a,b>(c:ref_mut<a,C>,op:read<b>,n:num)->unit {
    o(borrow_mut(c),op); vec_push(c.out,32); lname(borrow_mut(c),n); vec_push(c.out,10); return ();
}

fn argreg(i:num)->string {
 if i==0{return "%rdi";} if i==1{return "%rsi";} if i==2{return "%rdx";}
 if i==3{return "%rcx";} if i==4{return "%r8";} return "%r9";
}
fn imm<a>(c:ref_mut<a,C>,n:num)->num {
 o(borrow_mut(c),read("movabsq $"));on(borrow_mut(c),n);o(borrow_mut(c),read(",%rax\n"));return save(borrow_mut(c));
}
fn invoke<a,b>(c:ref_mut<a,C>,name:read<b>,args:vec<num>)->num {
 if 6<len(args){fail(borrow_mut(c),read("native call exceeds six arguments"));}
 for i in len(args){let r=argreg(i);get(borrow_mut(c),load(vec_get(args,i)),read(r));}
 o(borrow_mut(c),read("call "));o(borrow_mut(c),name);vec_push(c.out,10);return save(borrow_mut(c));
}

// Owned values have independent stack flags. Aliased field loads are not owners until moved.
fn needs_drop<a>(c:ref_mut<a,C>,ty:num)->num {
 let k=ty_kind(borrow_mut(c),ty);return (k==3)+(k==4)+(k==5)+(k==6)+(k==8)+(k==9)+(k==10);
}
fn resource<a>(c:ref_mut<a,C>,slot:num)->num {
 var i=len(c.resources);while i {i=i-1;let r=vec_get(c.resources,i);if r.slot==slot{return i+1;}}return 0;
}
fn own<a>(c:ref_mut<a,C>,slot:num,ty:num)->Val {
 if c.raw==0 {let k=ty_kind(borrow_mut(c),ty);let drops=needs_drop(borrow_mut(c),ty);if drops+(k==7){
 var flag=0;if drops{flag=imm(borrow_mut(c),1)+1;}let place=ownership::root(borrow_mut(c.check),0,1);
 vec_push(c.resources,Resource{slot:slot,ty:ty,flag:flag,base:0,field:0,via:0,place:place,target:0,authority:0});}}
 return val(slot,ty);
}
// A bond says that a live value retains a loan. Moves append bonds to the new holder;
// historical bonds remain for flow restoration, but dead holders do not keep loans alive.
fn bond_kind<a>(c:ref_mut<a,C>,holder:num,loan:num,guard:num)->unit {
 if (holder==0)+(loan==0){return ();}
 for i in len(c.bonds){let b=vec_get(c.bonds,i);if (b.holder==holder)&(b.loan==loan)&(b.guard==guard){return ();}}
 vec_push(c.bonds,Bond{holder:holder,loan:loan,guard:guard});return ();
}
fn bond<a>(c:ref_mut<a,C>,holder:num,loan:num)->unit {bond_kind(borrow_mut(c),holder,loan,0);return ();}
fn loan_live<a>(c:ref_mut<a,C>,loan:num)->num{let l=vec_get(c.check.loans,loan-1);return l.live;}
fn transfer_bonds<a>(c:ref_mut<a,C>,src:num,dst:num)->unit {
 if (src==0)+(dst==0){return ();}let n=len(c.bonds);
 for i in n{let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;let guard=b.guard;
 if loan_live(borrow_mut(c),loan){if ownership::ancestor(borrow(c.check),src,holder){bond_kind(borrow_mut(c),dst,loan,guard);}}}
 return ();
}
fn return_bonds<a>(c:ref_mut<a,C>,src:num,dst:num,aggregate:num)->unit {
 if (src==0)+(dst==0){return ();}let n=len(c.bonds);
 for i in n{let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;let guard=b.guard;
 if loan_live(borrow_mut(c),loan){if ownership::ancestor(borrow(c.check),src,holder){var role=guard;if aggregate{role=1;}if guard==3{role=3;}if aggregate==3{role=3;}bond_kind(borrow_mut(c),dst,loan,role);}}}
 return ();
}
fn close_loans<a>(c:ref_mut<a,C>)->unit {
 var changed=1;
 while changed{
 changed=0;var i=len(c.check.loans);
 while i{
 i=i-1;let l=vec_get(c.check.loans,i);let live=l.live;
 if live{var held=0;
 for j in len(c.bonds){let b=vec_get(c.bonds,j);let loan=b.loan;let holder=b.holder;
 if loan==i+1{let state=ownership::status(borrow(c.check),holder);if (state==1)+(state==3){held=1;break;}}}
 if held==0{if ownership::end_loan(borrow_mut(c.check),i+1)==0{changed=1;}}}
 }
 for j in len(c.origins){let o=vec_get(c.origins,j);let root=o.place;let region=o.region;
 if region==18446744073709551615{if ownership::status(borrow(c.check),root)==1{
 var reached=0;
 for k in len(c.check.loans){let l=vec_get(c.check.loans,k);let live=l.live;let source=l.source;
 if live{if ownership::ancestor(borrow(c.check),root,source){reached=1;break;}}}
 if reached==0{ownership::cleanup(borrow_mut(c.check),root);changed=1;}
 }}}
 }
 return ();
}
fn member_place<a>(c:ref_mut<a,C>,root:num,field:num,ty:num)->num {
 if root==0{return 0;}
 for i in len(c.members){let m=vec_get(c.members,i);if (m.base==root)&(m.field==field){return m.place;}}
 let kind=ty_kind(borrow_mut(c),ty);let copy=(needs_drop(borrow_mut(c),ty)==0)&(kind!=7);
 let place=ownership::field(borrow_mut(c.check),root,copy);
 vec_push(c.members,Member{base:root,field:field,place:place});return place;
}
fn target_of<a>(c:ref_mut<a,C>,slot:num)->num {
 let n=resource(borrow_mut(c),slot);if n==0{return 0;}let r=vec_get(c.resources,n-1);return r.target;
}
fn authority_of<a>(c:ref_mut<a,C>,slot:num)->num {
 let n=resource(borrow_mut(c),slot);if n==0{return 0;}let r=vec_get(c.resources,n-1);return r.authority;
}
fn authority_loan<a>(c:ref_mut<a,C>,slot:num,target:num)->num {
 let holder=place_of(borrow_mut(c),slot-1);
 for i in len(c.bonds){let b=vec_get(c.bonds,i);let h=b.holder;let loan=b.loan;
 if (holder==h)&(b.guard==0){let l=vec_get(c.check.loans,loan-1);let live=l.live;let source=l.source;
 if live{if ownership::ancestor(borrow(c.check),source,target){return loan;}}}}
 return 0;
}
fn set_target<a>(c:ref_mut<a,C>,slot:num,target:num,authority:num)->unit {
 let n=resource(borrow_mut(c),slot);if n!=0{
 let r=vec_get_mut(c.resources,n-1);exchange(borrow_mut(r.target),target);exchange(borrow_mut(r.authority),authority);}
 return ();
}
fn add_region<a>(rs:ref_mut<a,vec<num>>,r:num)->unit {
 for i in len(rs){if load(vec_get(rs,i))==r{return ();}}vec_push(rs,r);return ();
}
// Lifetime parameters inside the declared type (not concrete borrow targets).
fn type_caps<a>(c:ref_mut<a,C>,ty:num,depth:num)->vec<num> {
 if 64<depth{fail(borrow_mut(c),read("capture type nesting limit"));}
 let rs=type_regions(borrow_mut(c),ty);let k=ty_kind(borrow_mut(c),ty);let arg=ty_arg(borrow_mut(c),ty);
 if (k==6)+(k==7)+(k==10){let inner=type_caps(borrow_mut(c),arg,depth+1);
 for i in len(inner){let r=load(vec_get(inner,i));add_region(borrow_mut(rs),r);}}
 if k==8{let d=vec_get(c.decls,arg);let count=d.count;
 for i in count{let f=field_type(borrow_mut(c),ty,i);let inner=type_caps(borrow_mut(c),f,depth+1);
 for j in len(inner){let r=load(vec_get(inner,j));add_region(borrow_mut(rs),r);}}}
 return rs;
}
fn intersects<a,b>(a:ref<a,vec<num>>,b:ref<b,vec<num>>)->num {
 for i in len(a){let r=load(vec_get(a,i));for j in len(b){if load(vec_get(b,j))==r{return 1;}}}return 0;
}
fn normalize_readonly<a>(c:ref_mut<a,C>,slot:num,ty:num)->unit {
 let k=ty_kind(borrow_mut(c),ty);if (k!=5)&(k!=7){return ();}if ty_mode(borrow_mut(c),ty){return ();}
 let root=place_of(borrow_mut(c),slot);let n=len(c.bonds);
 for i in n{let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;let guard=b.guard;
 if (holder==root)&(guard==0){let l=vec_get(c.check.loans,loan-1);let mode=l.mode;let live=l.live;
 if live{
 if mode{let child=ownership::reborrow(borrow_mut(c.check),loan,0);if child==0{fail(borrow_mut(c),read("readonly result cannot borrow suspended authority"));}
 let b=vec_get_mut(c.bonds,i);exchange(borrow_mut(b.guard),1);bond(borrow_mut(c),root,child);}}}}
 return ();
}
fn call_bonds<a>(c:ref_mut<a,C>,result:Val,first:num,args:ref<a,vec<num>>,capture_type:num)->unit {
 if c.raw{return ();}let captures=type_caps(borrow_mut(c),capture_type,0);let holder=place_of(borrow_mut(c),result.t);let resultkind=ty_kind(borrow_mut(c),result.ty);let aggregate=resultkind!=5;
 for i in len(args){
 let slot=load(vec_get(args,i));let source=place_of(borrow_mut(c),slot);let ty=load(vec_get(c.params,first+i));let kind=ty_kind(borrow_mut(c),ty);
 var rs=type_caps(borrow_mut(c),ty,0);if kind==7{rs=type_regions(borrow_mut(c),ty);}
 if intersects(borrow(rs),borrow(captures)){
 var role=aggregate;if (kind==7)&(resultkind==7){role=3;}return_bonds(borrow_mut(c),source,holder,role);}
 if kind==7{
 let inner=ty_arg(borrow_mut(c),ty);let data=type_caps(borrow_mut(c),inner,0);
 if intersects(borrow(data),borrow(captures)){let storage=target_of(borrow_mut(c),slot);return_bonds(borrow_mut(c),storage,holder,aggregate);}}
 }
 if ty_kind(borrow_mut(c),result.ty)==7{stored_source(borrow_mut(c),result.t,result.ty);if target_of(borrow_mut(c),result.t)==0{fail(borrow_mut(c),read("reference result has no declared frame source"));}}
 let k=ty_kind(borrow_mut(c),result.ty);if (k==5)+(k==7){stored_source(borrow_mut(c),result.t,result.ty);if has_bonds(borrow_mut(c),holder)==0{fail(borrow_mut(c),read("borrowed result has no declared input source"));}}
 normalize_readonly(borrow_mut(c),result.t,result.ty);close_loans(borrow_mut(c));return ();
}
// Weak updates retain historical guards across branch restoration. External storage
// accepts only origins explicitly present in its invariant data-lifetime contract.
fn check_writeback<a>(c:ref_mut<a,C>,destination:num,ty:num,source:num)->unit{
 if c.raw{return ();}if contains_borrow(borrow_mut(c),ty,0)==0{return ();}
 let region=region_of(borrow_mut(c),destination);if region==0{return ();}
 if region==18446744073709551615{
 var found=0;for i in len(c.bonds){let b=vec_get(c.bonds,i);let holder=b.holder;let guard=b.guard;let loan=b.loan;
 if (guard==3)&ownership::ancestor(borrow(c.check),destination,holder){if loan_live(borrow_mut(c),loan){let l=vec_get(c.check.loans,loan-1);let source=l.source;let r=region_of(borrow_mut(c),source);
 if r!=18446744073709551615{if r!=0{fail(borrow_mut(c),read("opaque external captured storage has no concrete invariant contract"));}found=1;}}}}
 if found==0{fail(borrow_mut(c),read("opaque captured storage lacks a checked local frame"));}return ();
 }
 let allowed=type_caps(borrow_mut(c),ty,0);
 for i in len(c.bonds){let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;
 if ownership::ancestor(borrow(c.check),source,holder){if loan_live(borrow_mut(c),loan){let l=vec_get(c.check.loans,loan-1);let origin=l.source;let r=region_of(borrow_mut(c),origin);
 if r!=18446744073709551615{var found=0;for j in len(allowed){if load(vec_get(allowed,j))==r{found=1;}}
 if (r==0)+(found==0){fail(borrow_mut(c),read("captured writeback violates invariant lifetime"));}}}}}
 return ();
}
fn seed_storage<a>(c:ref_mut<a,C>,storage:num,ty:num)->unit{
 let region=region_of(borrow_mut(c),storage);if (region==0)+(region==18446744073709551615){return ();}
 for i in len(c.bonds){let b=vec_get(c.bonds,i);let holder=b.holder;if ownership::ancestor(borrow(c.check),storage,holder){return ();}}
 let k=ty_kind(borrow_mut(c),ty);if (k==5)+(k==7){let slot=imm(borrow_mut(c),0);
 vec_push(c.resources,Resource{slot:slot,ty:ty,flag:0,base:1,field:0,via:1,place:storage,target:0,authority:0});stored_source(borrow_mut(c),slot,ty);return ();}
 let caps=type_caps(borrow_mut(c),ty,0);for i in len(caps){let r=load(vec_get(caps,i));let source=external_place(borrow_mut(c),r,0);let loan=ownership::borrow_place(borrow_mut(c.check),source,0);bond_kind(borrow_mut(c),storage,loan,1);}return ();
}
fn frame_storage<a>(c:ref_mut<a,C>,slot:num,destination:num)->unit{
 let root=place_of(borrow_mut(c),slot);let n=len(c.bonds);for i in n{let b=vec_get(c.bonds,i);let holder=b.holder;let guard=b.guard;let loan=b.loan;
 if (holder==root)&guard{if loan_live(borrow_mut(c),loan){bond_kind(borrow_mut(c),destination,loan,guard);}}}return ();
}
fn storage_bonds<a>(c:ref_mut<a,C>,source:num,destination:num)->unit{
 let owners=vec<num>();let n=len(c.bonds);
 if region_of(borrow_mut(c),destination)==18446744073709551615{
 for i in n{let b=vec_get(c.bonds,i);let holder=b.holder;let guard=b.guard;let loan=b.loan;
 if (guard==3)&ownership::ancestor(borrow(c.check),destination,holder){if loan_live(borrow_mut(c),loan){let l=vec_get(c.check.loans,loan-1);let owner=l.source;if region_of(borrow_mut(c),owner)==0{vec_push(owners,owner);}}}}}
 for i in n{let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;let guard=b.guard;
 if ownership::ancestor(borrow(c.check),source,holder){if ((source==destination)&(guard==3))==0{if loan_live(borrow_mut(c),loan){var role=guard;if role==3{role=1;}bond_kind(borrow_mut(c),destination,loan,role);
 for j in len(owners){let owner=load(vec_get(owners,j));bond_kind(borrow_mut(c),owner,loan,1);}}}}}
 return ();
}
fn writeback_source<a>(c:ref_mut<a,C>,destination:num,ty:num,source:num)->unit{
 check_writeback(borrow_mut(c),destination,ty,source);storage_bonds(borrow_mut(c),source,destination);return ();
}
fn call_writebacks<a,b,d>(c:ref_mut<a,C>,first:num,args:ref<b,vec<num>>,actuals:ref<d,vec<num>>)->unit{
 if c.raw{return ();}
 for i in len(args){let formal=load(vec_get(c.params,first+i));let k=ty_kind(borrow_mut(c),formal);let mode=ty_mode(borrow_mut(c),formal);
 if (k==7)&mode{let inner=ty_arg(borrow_mut(c),formal);if contains_borrow(borrow_mut(c),inner,0){
 let rs=type_caps(borrow_mut(c),inner,0);let slot=load(vec_get(args,i));let destination=target_of(borrow_mut(c),slot);let actual=load(vec_get(actuals,i));let storage=ty_arg(borrow_mut(c),actual);frame_storage(borrow_mut(c),slot,destination);seed_storage(borrow_mut(c),destination,storage);
 for j in len(args){let ty=load(vec_get(c.params,first+j));let kind=ty_kind(borrow_mut(c),ty);let argument=load(vec_get(args,j));
 var caps=type_caps(borrow_mut(c),ty,0);if kind==7{caps=type_regions(borrow_mut(c),ty);}
 if intersects(borrow(rs),borrow(caps)){let source=place_of(borrow_mut(c),argument);writeback_source(borrow_mut(c),destination,storage,source);}
 if kind==7{let inner=ty_arg(borrow_mut(c),ty);let data=type_caps(borrow_mut(c),inner,0);
 if intersects(borrow(rs),borrow(data)){var source=target_of(borrow_mut(c),argument);let actual=load(vec_get(actuals,j));let inner=ty_arg(borrow_mut(c),actual);seed_storage(borrow_mut(c),source,inner);
 if (region_of(borrow_mut(c),source)==18446744073709551615)&(source!=destination){source=place_of(borrow_mut(c),argument);}writeback_source(borrow_mut(c),destination,storage,source);}}
 }
 }}}
 return ();
}
fn block_end<a>(c:ref_mut<a,C>,start:num)->num {
 var i=start;var depth=0;
 while i<len(c.toks){let k=kind_at(borrow_mut(c),i);if k==123{depth=depth+1;}if k==125{depth=depth-1;if depth==0{return i;}}i=i+1;}
 fail(borrow_mut(c),read("unclosed block"));return start;
}
fn last_name<a,b>(c:ref_mut<a,C>,name:read<b>,from:num,to:num)->num {
 var last=from;var i=from;var depth=0;var base=0;var pending=0;var hidden=0;var skip=0;
 if from<len(c.toks){if kind_at(borrow_mut(c),from)==123{base=1;}}
 while i<to{
 let t=vec_get(c.toks,i);let kind=t.kind;let st=t.start;let en=t.end;
 if kind==123{depth=depth+1;}
 if kind==125{if hidden==depth+1{hidden=0;}depth=depth-1;}
 if (kind==1)&(hidden==0)&(pending==0){
 let token=tok_text(borrow_mut(c),i);
 if same(read(token),read("let"))+same(read(token),read("var")){
 let declared=tok_text(borrow_mut(c),i+1);if same(read(declared),read(name)){pending=depth+1;skip=i+1;}}
 }
 var use=1;if i!=0{let prev=kind_at(borrow_mut(c),i-1);if (prev==46)+(prev==260){use=0;}}
 let next=kind_at(borrow_mut(c),i+1);if (next==58)+(next==40)+(next==260){use=0;}
 if (kind==1)&(en-st==len(name))&(i!=skip)&(hidden==0)&use{var matched=1;var j=0;
 while j<en-st{if at(read(c.src),st+j)!=at(name,j){matched=0;break;}j=j+1;}
 if matched{last=i;}}
 if (pending!=0)&(kind==59)&(depth+1==pending){if depth==base{break;}hidden=pending;pending=0;}
 i=i+1;
 }
 return last;
}
fn is_local_slot<a>(c:ref_mut<a,C>,slot:num)->num {
 for i in len(c.locals){let l=vec_get(c.locals,i);if l.id==slot{return 1;}}return 0;
}
fn release_temporary<a>(c:ref_mut<a,C>,slot:num)->unit {
 if c.raw{return ();}if is_local_slot(borrow_mut(c),slot){return ();}
 let r=resource(borrow_mut(c),slot);if r==0{return ();}let info=vec_get(c.resources,r-1);let place=info.place;let base=info.base;
 if (base==0)&(place!=0){if ownership::can_cleanup(borrow(c.check),place){release(borrow_mut(c),r-1);}}return ();
}
fn expire_locals<a>(c:ref_mut<a,C>)->unit {
 if c.raw{return ();}for i in len(c.locals){
 let l=vec_get(c.locals,i);let slot=l.id;let ty=l.ty;let last=l.last;let born=l.born;
 let k=ty_kind(borrow_mut(c),ty);var carrier=(k==5)+(k==7);let root=place_of(borrow_mut(c),slot);
 if (k==6)+(k==8){for j in len(c.bonds){let b=vec_get(c.bonds,j);let holder=b.holder;if ownership::ancestor(borrow(c.check),root,holder){carrier=1;break;}}}
 if carrier{if last<c.pos+1{
 var defer=0;if c.loop_end{if (born<c.loop_start)&(last<c.loop_end){defer=1;}}
 if defer==0{let r=resource(borrow_mut(c),slot);if r!=0{let info=vec_get(c.resources,r-1);let place=info.place;
 if place!=0{if ownership::can_cleanup(borrow(c.check),place){if (k==6)+(k==8){ownership::cleanup(borrow_mut(c.check),place);close_loans(borrow_mut(c));}else{release(borrow_mut(c),r-1);}}}}}
 }}
 }return ();
}
fn require_write<a>(c:ref_mut<a,C>,slot:num)->unit {
 if c.raw{return ();}let index=resource(borrow_mut(c),slot);if index==0{fail(borrow_mut(c),read("mutation target is not tracked"));}
 let r=vec_get(c.resources,index-1);let ty=r.ty;let place=r.place;let authority=r.authority;let target=r.target;
 let k=ty_kind(borrow_mut(c),ty);
 if (k==7)&(place==0){
 if authority!=0{let r=resource(borrow_mut(c),authority-1);let info=vec_get(c.resources,r-1);let ty=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),read("write through readonly frame"));}
 let loan=authority_loan(borrow_mut(c),authority,target);if loan==0{fail(borrow_mut(c),read("field write has no authority"));}if ownership::access_loan(borrow(c.check),loan,target,1)!=0{fail(borrow_mut(c),read("field write conflicts with active loan"));}}
 else{if ownership::initialize(borrow_mut(c.check),target)!=0{fail(borrow_mut(c),read("field assignment conflicts with live borrow or moved storage"));}}return ();}
 if (k==5)+(k==7){if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),read("mutation through readonly reference"));}var allowed=0;
 for i in len(c.bonds){let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;let guard=b.guard;
 if (guard==0)&ownership::ancestor(borrow(c.check),holder,place){if loan_live(borrow_mut(c),loan){allowed=1;if ownership::use_loan(borrow(c.check),loan,1)!=0{fail(borrow_mut(c),read("write authority is suspended"));}}}}if allowed==0{fail(borrow_mut(c),read("write lacks checked source"));}
 }else{
 if authority!=0{let r=resource(borrow_mut(c),authority-1);let info=vec_get(c.resources,r-1);let ty=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),read("mutation through readonly frame"));}
 let loan=authority_loan(borrow_mut(c),authority,place);if loan==0{fail(borrow_mut(c),read("write has no reference authority"));}
 if ownership::access_loan(borrow(c.check),loan,place,1)!=0{fail(borrow_mut(c),read("write conflicts with active loan"));}
 }else{let loan=ownership::borrow_place(borrow_mut(c.check),place,1);if loan==0{fail(borrow_mut(c),read("mutation conflicts with live borrow"));}ownership::end_loan(borrow_mut(c.check),loan);}}
 return ();
}
fn region_of<a>(c:ref_mut<a,C>,place:num)->num {
 for i in len(c.origins){let o=vec_get(c.origins,i);let root=o.place;let region=o.region;
 if ownership::ancestor(borrow(c.check),root,place){return region;}}
 return 0;
}
fn external_place<a>(c:ref_mut<a,C>,region:num,copy:num)->num {
 let p=ownership::root(borrow_mut(c.check),copy,1);vec_push(c.origins,Origin{place:p,region:region});return p;
}
fn add_external_capture<a>(c:ref_mut<a,C>,holder:num,region:num,mode:num)->num {
 let source=external_place(borrow_mut(c),region,0);let loan=ownership::borrow_place(borrow_mut(c.check),source,mode);
 bond(borrow_mut(c),holder,loan);return source;
}
fn init_parameter<a>(c:ref_mut<a,C>,slot:num,ty:num)->unit {
 if c.raw{return ();}let holder=place_of(borrow_mut(c),slot);let k=ty_kind(borrow_mut(c),ty);
 let rs=type_regions(borrow_mut(c),ty);let mode=ty_mode(borrow_mut(c),ty);
 if (k==5)+(k==7){
 if len(rs)!=1{fail(borrow_mut(c),read("parameter requires a declared lifetime"));}
 let r=load(vec_get(rs,0));let source=add_external_capture(borrow_mut(c),holder,r,mode);
 if k==7{set_target(borrow_mut(c),slot,source,slot+1);}return ();}
 let captures=type_caps(borrow_mut(c),ty,0);
 for i in len(captures){let r=load(vec_get(captures,i));let target=external_place(borrow_mut(c),r,0);let loan=ownership::borrow_place(borrow_mut(c.check),target,0);bond_kind(borrow_mut(c),holder,loan,1);}return ();
}
fn has_bonds<a>(c:ref_mut<a,C>,holder:num)->num {
 for i in len(c.bonds){let b=vec_get(c.bonds,i);let h=b.holder;let guard=b.guard;let loan=b.loan;if (h==holder)&(guard==0){if loan_live(borrow_mut(c),loan){return 1;}}}return 0;
}
// Stored captures in an abstract input referent have their declared data lifetime,
// distinct from the lifetime of the outer reference frame.
fn stored_source<a>(c:ref_mut<a,C>,slot:num,ty:num)->unit {
 let place=place_of(borrow_mut(c),slot);if place==0{return ();}
 let k=ty_kind(borrow_mut(c),ty);if (k!=5)&(k!=7){return ();}
 if has_bonds(borrow_mut(c),place){if k==7{
 for i in len(c.bonds){let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;let guard=b.guard;
 if (holder==place)&(guard==0){if loan_live(borrow_mut(c),loan){let l=vec_get(c.check.loans,loan-1);let source=l.source;let authority=authority_of(borrow_mut(c),slot);set_target(borrow_mut(c),slot,source,authority);break;}}}}return ();}
 var guarded=0;let n=len(c.bonds);
 for i in n{let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;let guard=b.guard;
 if guard{if loan_live(borrow_mut(c),loan){if ownership::ancestor(borrow(c.check),holder,place){bond_kind(borrow_mut(c),place,loan,guard);guarded=1;}}}}
 if guarded{
 let mode=ty_mode(borrow_mut(c),ty);let source=external_place(borrow_mut(c),18446744073709551615,0);let loan=ownership::borrow_place(borrow_mut(c.check),source,mode);bond(borrow_mut(c),place,loan);
 if k==7{var authority=authority_of(borrow_mut(c),slot);let r=resource(borrow_mut(c),slot);let info=vec_get(c.resources,r-1);if info.base==0{authority=slot+1;}set_target(borrow_mut(c),slot,source,authority);}return ();}
 if region_of(borrow_mut(c),place)==0{return ();}
 let rs=type_regions(borrow_mut(c),ty);if len(rs)!=1{fail(borrow_mut(c),read("stored capture lifetime missing"));}
 let r=load(vec_get(rs,0));let mode=ty_mode(borrow_mut(c),ty);let target=add_external_capture(borrow_mut(c),place,r,mode);
 if k==7{let authority=authority_of(borrow_mut(c),slot);set_target(borrow_mut(c),slot,target,authority);}return ();
}
fn bind_loan<a>(c:ref_mut<a,C>,value:num,source:num,target:num,mode:num)->unit {
 if c.raw{return ();}if target==0{fail(borrow_mut(c),read("borrow target is not tracked"));}
 var authority=authority_of(borrow_mut(c),source);let source_id=resource(borrow_mut(c),source);if source_id!=0{let r=vec_get(c.resources,source_id-1);let ty=r.ty;if ty_kind(borrow_mut(c),ty)==7{authority=source+1;}}var loan=0;
 if authority!=0{
 if mode{let r=resource(borrow_mut(c),authority-1);let info=vec_get(c.resources,r-1);let ty=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),read("mutable borrow through readonly frame"));}}
 let parent=authority_loan(borrow_mut(c),authority,target);if parent==0{fail(borrow_mut(c),read("reference has no access authority"));}
 loan=ownership::reborrow_place(borrow_mut(c.check),parent,target,mode);
 let owner=place_of(borrow_mut(c),authority-1);let holder=place_of(borrow_mut(c),value);let n=len(c.bonds);
 for i in n{let b=vec_get(c.bonds,i);let old=b.loan;let h=b.holder;let guard=b.guard;if (h==owner)&(guard!=0){bond_kind(borrow_mut(c),holder,old,1);}
 if (h==owner)&(old!=parent)&(guard==0){if loan_live(borrow_mut(c),old){
 let extra=ownership::reborrow(borrow_mut(c.check),old,mode);if extra==0{fail(borrow_mut(c),read("ambiguous reborrow lacks authority"));}bond(borrow_mut(c),holder,extra);}}}
 }else{loan=ownership::borrow_place(borrow_mut(c.check),target,mode);}
 if loan==0{fail(borrow_mut(c),read("borrow conflicts with active access"));}
 let holder=place_of(borrow_mut(c),value);bond(borrow_mut(c),holder,loan);return ();
}
fn borrow_reference<a>(c:ref_mut<a,C>,slot:num,ty:num,source:num,target:num,mode:num)->Val {
 own(borrow_mut(c),slot,ty);bind_loan(borrow_mut(c),slot,source,target,mode);set_target(borrow_mut(c),slot,target,slot+1);return val(slot,ty);
}
fn view_bonds<a>(c:ref_mut<a,C>,slot:num,source:num,mode:num)->unit {
 if c.raw{return ();}let root=place_of(borrow_mut(c),source);let holder=place_of(borrow_mut(c),slot);
 if root==0{fail(borrow_mut(c),read("view source is not tracked"));}
 let source_index=resource(borrow_mut(c),source);let r=vec_get(c.resources,source_index-1);let ty=r.ty;
 if ty_kind(borrow_mut(c),ty)==5{
 if mode{let index=resource(borrow_mut(c),source);let r=vec_get(c.resources,index-1);let base=r.base;let authority=r.authority;
 if base!=0{if authority!=0{let r=resource(borrow_mut(c),authority-1);let info=vec_get(c.resources,r-1);let ty=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),read("unique field reborrow through readonly frame"));}
 let parent=authority_loan(borrow_mut(c),authority,root);if ownership::access_loan(borrow(c.check),parent,root,1)!=0{fail(borrow_mut(c),read("unique field reborrow requires mutable frame"));}}
 else{if ownership::can_cleanup(borrow(c.check),root)==0{fail(borrow_mut(c),read("field frame is shared"));}}}}
 var found=0;let n=len(c.bonds);
 for i in n{let b=vec_get(c.bonds,i);let h=b.holder;let parent=b.loan;let guard=b.guard;
 if loan_live(borrow_mut(c),parent){if ownership::ancestor(borrow(c.check),h,root){if guard{bond_kind(borrow_mut(c),holder,parent,1);}else{let loan=ownership::reborrow(borrow_mut(c.check),parent,mode);if loan==0{fail(borrow_mut(c),read("view reborrow lacks authority"));}bond(borrow_mut(c),holder,loan);found=1;}}}}
 if found==0{fail(borrow_mut(c),read("view has no lifetime source"));}
 }else{bind_loan(borrow_mut(c),slot,source,root,mode);}return ();
}
fn validate_return<a>(c:ref_mut<a,C>,v:Val)->unit {
 if c.raw{return ();}if contains_borrow(borrow_mut(c),v.ty,0)==0{return ();}let place=place_of(borrow_mut(c),v.t);if place==0{return ();}
 let result=c.result;let rs=type_caps(borrow_mut(c),result,0);var found=0;
 for i in len(c.bonds){let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;
 if ownership::ancestor(borrow(c.check),place,holder){if loan_live(borrow_mut(c),loan){
 let l=vec_get(c.check.loans,loan-1);let source=l.source;let region=region_of(borrow_mut(c),source);var allowed=0;
 for j in len(rs){if load(vec_get(rs,j))==region{allowed=1;}}
 if region!=18446744073709551615{if (region==0)+(allowed==0){fail(borrow_mut(c),read("returned borrow escapes its declared input lifetime"));}}found=1;}}}
 let k=ty_kind(borrow_mut(c),v.ty);if (k==5)+(k==7){if found==0{fail(borrow_mut(c),read("returned reference has no checked source"));}}return ();
}
fn place_of<a>(c:ref_mut<a,C>,slot:num)->num {
 let r=resource(borrow_mut(c),slot);if r==0{return 0;}let r=vec_get(c.resources,r-1);return r.place;
}
fn observe<a>(c:ref_mut<a,C>,slot:num)->unit {
 if c.raw{return ();}let place=place_of(borrow_mut(c),slot);if place==0{return ();}
 let authority=authority_of(borrow_mut(c),slot);let index=resource(borrow_mut(c),slot);let info=vec_get(c.resources,index-1);let base=info.base;let ty=info.ty;
 if (authority!=0)&(base!=0){
 let loan=authority_loan(borrow_mut(c),authority,place);
 if loan==0{fail(borrow_mut(c),read("access has no live reference authority"));}
 if ownership::access_loan(borrow(c.check),loan,place,0)!=0{fail(borrow_mut(c),read("reference access conflicts with active borrow"));}
 }else{if ownership::read(borrow(c.check),place)!=0{fail(borrow_mut(c),read("use of moved, borrowed or partially initialized value"));}}
 let k=ty_kind(borrow_mut(c),ty);if (k==5)+(k==7){var checked=0;
 for i in len(c.bonds){let b=vec_get(c.bonds,i);let h=b.holder;let loan=b.loan;let guard=b.guard;
 if (guard==0)&ownership::ancestor(borrow(c.check),h,place){if loan_live(borrow_mut(c),loan){checked=1;if ownership::use_loan(borrow(c.check),loan,0)!=0{fail(borrow_mut(c),read("reference is suspended or expired"));}}}}if checked==0{fail(borrow_mut(c),read("reference lacks checked source"));}}
 return ();
}
fn inherit_guards<a>(c:ref_mut<a,C>,place:num)->unit {
 if place==0{return ();}let n=len(c.bonds);
 for i in n{let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;
 if holder!=place{if ownership::ancestor(borrow(c.check),holder,place){bond_kind(borrow_mut(c),place,loan,1);}}}return ();
}
fn capture_authority<a>(c:ref_mut<a,C>,place:num)->unit {
 if place==0{return ();}
 for i in len(c.bonds){let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;let guard=b.guard;
 if guard==0{if loan_live(borrow_mut(c),loan){if ownership::ancestor(borrow(c.check),place,holder){
 if ownership::use_loan(borrow(c.check),loan,0)!=0{fail(borrow_mut(c),read("captured authority is suspended"));}}}}}
 return ();
}
fn alias_field<a>(c:ref_mut<a,C>,slot:num,ty:num,base:num,field:num,via:num)->Val {
 if c.raw==0{
 let root=place_of(borrow_mut(c),base);let place=member_place(borrow_mut(c),root,field,ty);let authority=authority_of(borrow_mut(c),base);
 vec_push(c.resources,Resource{slot:slot,ty:ty,flag:0,base:base+1,field:field,via:via,place:place,target:0,authority:authority});if contains_borrow(borrow_mut(c),ty,0){inherit_guards(borrow_mut(c),place);}stored_source(borrow_mut(c),slot,ty);
 }
 return val(slot,ty);
}
fn drop_name<a>(c:ref_mut<a,C>,ty:num)->unit {o(borrow_mut(c),read(".D"));on(borrow_mut(c),ty);return ();}
fn release<a>(c:ref_mut<a,C>,index:num)->unit {
 let r=vec_get(c.resources,index);let flag=r.flag;let slot=r.slot;let ty=r.ty;let place=r.place;let base=r.base;
 if flag==0{if base==0{if place!=0{if ownership::cleanup(borrow_mut(c.check),place)!=0{fail(borrow_mut(c),read("storage ends while borrowed"));}close_loans(borrow_mut(c));}}return ();}
 if place!=0{if ownership::cleanup(borrow_mut(c.check),place)!=0{fail(borrow_mut(c),read("cleanup conflicts with live loan"));}}
 let done=label(borrow_mut(c));
 o(borrow_mut(c),read("cmpq $0,"));stack_slot(borrow_mut(c),flag-1);vec_push(c.out,10);jump(borrow_mut(c),read("je"),done);
 o(borrow_mut(c),read("movq $0,"));stack_slot(borrow_mut(c),flag-1);vec_push(c.out,10);
 get(borrow_mut(c),slot,read("%rdi"));o(borrow_mut(c),read("call "));drop_name(borrow_mut(c),ty);vec_push(c.out,10);mark(borrow_mut(c),done);close_loans(borrow_mut(c));return ();
}
fn cleanup<a>(c:ref_mut<a,C>,mark:num)->unit {
 if c.raw{return ();}var i=len(c.resources);while mark<i{i=i-1;release(borrow_mut(c),i);}return ();
}
fn move_out<a>(c:ref_mut<a,C>,v:Val)->unit {
 if c.raw{return ();}if needs_drop(borrow_mut(c),v.ty)==0{if ty_kind(borrow_mut(c),v.ty)!=7{return ();}}
 let index=resource(borrow_mut(c),v.t);if index==0{fail(borrow_mut(c),read("owned value lacks ownership record"));}
 let r=vec_get(c.resources,index-1);let flag=r.flag;let base=r.base;let field=r.field;let via=r.via;let place=r.place;
 if place!=0{capture_authority(borrow_mut(c),place);if ownership::take(borrow_mut(c.check),place)!=0{fail(borrow_mut(c),read("move of unavailable or borrowed value"));}}
 if flag!=0{o(borrow_mut(c),read("movq $0,"));stack_slot(borrow_mut(c),flag-1);vec_push(c.out,10);}else{
 if base!=0{if via{fail(borrow_mut(c),read("cannot move owned field through reference"));}
 let zero=imm(borrow_mut(c),0);rec_store(borrow_mut(c),base-1,field,zero);}}
 return ();
}
fn move_value<a>(c:ref_mut<a,C>,v:Val)->Val {
 get(borrow_mut(c),v.t,read("%rax"));let slot=save(borrow_mut(c));let old=place_of(borrow_mut(c),v.t);let target=target_of(borrow_mut(c),v.t);move_out(borrow_mut(c),val(v.t,v.ty));
 own(borrow_mut(c),slot,v.ty);let dst=place_of(borrow_mut(c),slot);let kind=ty_kind(borrow_mut(c),v.ty);if contains_borrow(borrow_mut(c),v.ty,0){return_bonds(borrow_mut(c),old,dst,(kind==6)+(kind==8));}if ty_kind(borrow_mut(c),v.ty)==7{set_target(borrow_mut(c),slot,target,slot+1);}return val(slot,v.ty);
}
// ---- tokens ----
fn kind<a>(c:ref_mut<a,C>)->num {
    let p=c.pos;
    let t=vec_get(c.toks,p);
    return t.kind;
}
fn kind_at<a>(c:ref_mut<a,C>,i:num)->num {
    let t=vec_get(c.toks,i);
    return t.kind;
}
fn advance<a>(c:ref_mut<a,C>)->unit {
    let p=c.pos+1;
    exchange(borrow_mut(c.pos),p);
    return ();
}
fn tok_text<a>(c:ref_mut<a,C>,i:num)->bytes {
    let t=vec_get(c.toks,i);
    let st=t.start;
    let en=t.end;
    return copy_bytes(slice(read(c.src),st,en));
}
fn is<a,b>(c:ref_mut<a,C>,s:read<b>)->num {
    let p=c.pos;
    let t=tok_text(borrow_mut(c),p);
    return same(read(t),s);
}
fn fail<a,b>(c:ref_mut<a,C>,msg:read<b>)->unit {
    let p=c.pos;
    let m=tok_text(borrow_mut(c),p);
    let t=vec_get(c.toks,p);
    let st=t.start;
    exchange(borrow_mut(c.out),vec<num>());
    o(borrow_mut(c),read("native: "));
    o(borrow_mut(c),msg);
    o(borrow_mut(c),read(" at byte "));
    on(borrow_mut(c),st);
    o(borrow_mut(c),read(" near '"));
    o(borrow_mut(c),read(m));
    o(borrow_mut(c),read("'\n"));
    let line=bytes();
    for i in len(c.out) { push(line,load(vec_get(c.out,i))); }
    host::print(read(line));
    assert(0);
    return ();
}
fn eat<a,b>(c:ref_mut<a,C>,s:read<b>)->num {
    if is(borrow_mut(c),s) { advance(borrow_mut(c)); return 1; }
    return 0;
}
fn expect<a,b>(c:ref_mut<a,C>,s:read<b>)->unit {
    let want=copy_bytes(read(s));
    if eat(borrow_mut(c),s)==0 {
        let msg="expected ";
        append_text(msg,read(want));
        fail(borrow_mut(c),read(msg));
    }
    return ();
}
fn ident<a>(c:ref_mut<a,C>)->bytes {
    if kind(borrow_mut(c))!=1 { fail(borrow_mut(c),read("expected identifier")); }
    let p=c.pos;
    let t=tok_text(borrow_mut(c),p);
    advance(borrow_mut(c));
    return t;
}
// Skips a balanced {...} group starting at the current '{'.
fn skip_braces<a>(c:ref_mut<a,C>)->unit {
    var depth=0;
    while 1 {
        let k=kind(borrow_mut(c));
        if k==123 { depth=depth+1; }
        if k==125 { depth=depth-1; }
        if k==0 { fail(borrow_mut(c),read("unclosed {")); }
        advance(borrow_mut(c));
        if depth==0 { return (); }
    }
    return ();
}
fn load_file<a>(c:ref_mut<a,C>,index:num)->unit {
    let path=host::arg(index);
    let src=host::read_file(read(path));
    let toks=vec<Tok>();
    let lexed=lexer::tokenize(read(src));
    for i in len(lexed) {
        let t=vec_get(lexed,i);
        vec_push(toks,Tok{kind:t.kind,start:t.start,end:t.end});
    }
    drop(lexed);
    exchange(borrow_mut(c.toks),toks);
    exchange(borrow_mut(c.src),src);
    exchange(borrow_mut(c.pos),0);
    return ();
}

// ---- types and declarations ----
fn numbers_equal<a,b>(a:ref<a,vec<num>>,b:ref<b,vec<num>>)->num {
 if len(a)!=len(b){return 0;}for i in len(a){if load(vec_get(a,i))!=load(vec_get(b,i)){return 0;}}return 1;
}
fn intern_args<a>(c:ref_mut<a,C>,k:num,arg:num,mode:num,regions:vec<num>,args:vec<num>)->num {
 for i in len(c.types){let t=vec_get(c.types,i);
 if (t.kind==k)&(t.arg==arg)&(t.mode==mode){if numbers_equal(borrow(t.regions),borrow(regions)){if numbers_equal(borrow(t.args),borrow(args)){return i;}}}}
 vec_push(c.types,Ty{kind:k,arg:arg,mode:mode,regions:regions,args:args});return len(c.types)-1;
}
fn intern_full<a>(c:ref_mut<a,C>,k:num,arg:num,mode:num,regions:vec<num>)->num {
 return intern_args(borrow_mut(c),k,arg,mode,regions,vec<num>());
}
fn type_args<a>(c:ref_mut<a,C>,ty:num)->vec<num>{
 let args=vec<num>();let t=vec_get(c.types,ty);for i in len(t.args){vec_push(args,load(vec_get(t.args,i)));}return args;
}
fn intern<a>(c:ref_mut<a,C>,k:num,arg:num)->num {return intern_full(borrow_mut(c),k,arg,0,vec<num>());}
fn region_id<a>(c:ref_mut<a,C>)->num {
 let n=ident(borrow_mut(c));
 for i in len(c.rnames){let r=vec_get(c.rnames,i);if same(read(r),read(n)){return i+1;}}
 fail(borrow_mut(c),read("undeclared lifetime"));return 0;
}
fn lifetime_parameters<a>(c:ref_mut<a,C>)->unit {
 exchange(borrow_mut(c.rnames),vec<bytes>());exchange(borrow_mut(c.tnames),vec<bytes>());
 if eat(borrow_mut(c),read("<")){while 1{
 let is_type=eat(borrow_mut(c),read("type"));let n=ident(borrow_mut(c));
 if is_type{
 for i in len(c.tnames){let t=vec_get(c.tnames,i);if same(read(t),read(n)){fail(borrow_mut(c),read("duplicate type parameter"));}}
 vec_push(c.tnames,n);
 }else{
 if len(c.tnames)!=0{fail(borrow_mut(c),read("lifetimes must precede type parameters"));}
 for i in len(c.rnames){let r=vec_get(c.rnames,i);if same(read(r),read(n)){fail(borrow_mut(c),read("duplicate lifetime"));}}
 vec_push(c.rnames,n);
 }
 if eat(borrow_mut(c),read(">")){break;}expect(borrow_mut(c),read(","));}}
 return ();
}
fn lifetime_arguments<a>(c:ref_mut<a,C>)->vec<num> {
 let rs=vec<num>();if eat(borrow_mut(c),read("<")){while 1{
 let r=region_id(borrow_mut(c));vec_push(rs,r);
 if eat(borrow_mut(c),read(">")){break;}expect(borrow_mut(c),read(","));}}
 return rs;
}
fn nominal_type<a>(c:ref_mut<a,C>,d:num)->num {
 let decl=vec_get(c.decls,d);let count=decl.regions;let types=decl.types;
 let rs=vec<num>();let args=vec<num>();
 if count+types{
 expect(borrow_mut(c),read("<"));
 for i in count+types{if i!=0{expect(borrow_mut(c),read(","));}
 if i<count{let r=region_id(borrow_mut(c));vec_push(rs,r);}else{let t=parse_type(borrow_mut(c));vec_push(args,t);}}
 expect(borrow_mut(c),read(">"));
 }
 return intern_args(borrow_mut(c),8,d,0,rs,args);
}
fn ty_kind<a>(c:ref_mut<a,C>,ty:num)->num {
    let t=vec_get(c.types,ty);
    return t.kind;
}
fn ty_arg<a>(c:ref_mut<a,C>,ty:num)->num {
    let t=vec_get(c.types,ty);
    return t.arg;
}
fn ty_mode<a>(c:ref_mut<a,C>,ty:num)->num {let t=vec_get(c.types,ty);return t.mode;}
fn type_regions<a>(c:ref_mut<a,C>,ty:num)->vec<num>{
 let rs=vec<num>();let t=vec_get(c.types,ty);
 for i in len(t.regions){vec_push(rs,load(vec_get(t.regions,i)));}return rs;
}
fn substitute<a,b>(c:ref_mut<a,C>,ty:num,map:ref<b,vec<num>>)->num {
 let k=ty_kind(borrow_mut(c),ty);let mode=ty_mode(borrow_mut(c),ty);var arg=ty_arg(borrow_mut(c),ty);
 let rs=type_regions(borrow_mut(c),ty);
 if (k==6)+(k==7){arg=substitute(borrow_mut(c),arg,borrow(map));}
 for i in len(rs){let r=load(vec_get(rs,i));if r!=0{
 if len(map)<r{fail(borrow_mut(c),read("unbound stored lifetime"));}
 let n=load(vec_get(map,r-1));exchange(vec_get_mut(rs,i),n);}}
 let args=type_args(borrow_mut(c),ty);
 for i in len(args){let t=load(vec_get(args,i));let v=substitute(borrow_mut(c),t,borrow(map));exchange(vec_get_mut(args,i),v);}
 return intern_args(borrow_mut(c),k,arg,mode,rs,args);
}
fn bind_types<a,b>(c:ref_mut<a,C>,ty:num,map:ref<b,vec<num>>)->num {
 let k=ty_kind(borrow_mut(c),ty);let mode=ty_mode(borrow_mut(c),ty);var arg=ty_arg(borrow_mut(c),ty);
 if k==9{if len(map)<arg+1{fail(borrow_mut(c),read("unbound type parameter"));}return load(vec_get(map,arg));}
 if (k==6)+(k==7){arg=bind_types(borrow_mut(c),arg,borrow(map));}
 let args=type_args(borrow_mut(c),ty);for i in len(args){let t=load(vec_get(args,i));let v=bind_types(borrow_mut(c),t,borrow(map));exchange(vec_get_mut(args,i),v);}
 let rs=type_regions(borrow_mut(c),ty);return intern_args(borrow_mut(c),k,arg,mode,rs,args);
}
fn field_type<a>(c:ref_mut<a,C>,ty:num,index:num)->num {
 let d=ty_arg(borrow_mut(c),ty);let t=field_ty(borrow_mut(c),d,index);let rs=type_regions(borrow_mut(c),ty);let args=type_args(borrow_mut(c),ty);
 let field=bind_types(borrow_mut(c),t,borrow(args));if len(rs)==0{return field;}return substitute(borrow_mut(c),field,borrow(rs));
}
fn concrete_type<a>(c:ref_mut<a,C>,ty:num)->num {
 let k=ty_kind(borrow_mut(c),ty);if k==9{return 0;}let arg=ty_arg(borrow_mut(c),ty);
 if (k==6)+(k==7)+(k==10){if concrete_type(borrow_mut(c),arg)==0{return 0;}}
 let args=type_args(borrow_mut(c),ty);for i in len(args){let a=load(vec_get(args,i));if concrete_type(borrow_mut(c),a)==0{return 0;}}
 return 1;
}
fn reference_type<a>(c:ref_mut<a,C>,ty:num,mode:num)->num{return intern_full(borrow_mut(c),7,ty,mode,vec<num>());}
// Shape checking does not discharge lifetime obligations; the loan pass handles those separately.
fn same_type<a>(c:ref_mut<a,C>,x:num,y:num)->num {
 let a=ty_kind(borrow_mut(c),x);let b=ty_kind(borrow_mut(c),y);if a!=b{return 0;}
 let aa=ty_arg(borrow_mut(c),x);let bb=ty_arg(borrow_mut(c),y);
 if (a==5)+(a==7){let am=ty_mode(borrow_mut(c),x);let bm=ty_mode(borrow_mut(c),y);if am!=bm{return 0;}}
 if (a==6)+(a==7){return same_type(borrow_mut(c),aa,bb);}
 if a==8{if aa!=bb{return 0;}let ax=type_args(borrow_mut(c),x);let bx=type_args(borrow_mut(c),y);if len(ax)!=len(bx){return 0;}
 for i in len(ax){let x=load(vec_get(ax,i));let y=load(vec_get(bx,i));if same_type(borrow_mut(c),x,y)==0{return 0;}}}
 if a==9{return aa==bb;}if a==10{let am=ty_mode(borrow_mut(c),x);let bm=ty_mode(borrow_mut(c),y);return (aa==bb)&(am==bm);}return 1;
}
fn contains_borrow<a>(c:ref_mut<a,C>,ty:num,depth:num)->num {
 if 64<depth{fail(borrow_mut(c),read("recursive capture layout unsupported"));}
 let k=ty_kind(borrow_mut(c),ty);let arg=ty_arg(borrow_mut(c),ty);
 if (k==5)+(k==7){return 1;}if k==10{return contains_borrow(borrow_mut(c),arg,depth+1);}if k==6{return contains_borrow(borrow_mut(c),arg,depth+1);}
 if k==8{let d=vec_get(c.decls,arg);let count=d.count;
 for i in count{let t=field_type(borrow_mut(c),ty,i);if contains_borrow(borrow_mut(c),t,depth+1){return 1;}}}return 0;
}
fn require_type<a>(c:ref_mut<a,C>,actual:num,expected:num)->unit {
 if same_type(borrow_mut(c),actual,expected)==0{fail(borrow_mut(c),read("type mismatch"));}return ();
}
// Declaration index + 1, or 0.
fn find_decl<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->num {
    for i in len(c.decls) {
        let x=vec_get(c.decls,i);
        if same(read(x.module),read(m))&same(read(x.name),read(n)) { return i+1; }
    }
    return 0;
}
fn find_func<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->num {
    for i in len(c.funcs) {
        let x=vec_get(c.funcs,i);
        if same(read(x.module),read(m))&same(read(x.name),read(n)) { return i+1; }
    }
    return 0;
}
// Field index within decl, failing when absent.
fn find_field<a,b>(c:ref_mut<a,C>,decl:num,n:read<b>)->num {
    let d=vec_get(c.decls,decl);
    let first=d.first;
    let count=d.count;
    for i in count {
        let f=vec_get(c.fields,first+i);
        if same(read(f.name),read(n)) { return i; }
    }
    fail(borrow_mut(c),read("unknown field or variant"));
    return 0;
}
fn field_ty<a>(c:ref_mut<a,C>,decl:num,index:num)->num {
    let d=vec_get(c.decls,decl);
    let k=d.first+index;
    let f=vec_get(c.fields,k);
    return f.ty;
}
fn module_copy<a>(c:ref_mut<a,C>)->bytes { return copy_bytes(read(c.module)); }
fn parse_type<a>(c:ref_mut<a,C>)->num {
 let first=ident(borrow_mut(c));
 for i in len(c.tnames){let t=vec_get(c.tnames,i);if same(read(t),read(first)){if len(c.bindings){return load(vec_get(c.bindings,i));}return intern(borrow_mut(c),9,i);}}
 if eat(borrow_mut(c),read("::")){
 let n=ident(borrow_mut(c));let d=find_decl(borrow_mut(c),read(first),read(n));
 if d==0{fail(borrow_mut(c),read("unknown type"));}return nominal_type(borrow_mut(c),d-1);}
 if same(read(first),read("num")){return 0;}if same(read(first),read("unit")){return 1;}
 if same(read(first),read("bytes")){return 2;}if same(read(first),read("string")){return 3;}
 if same(read(first),read("read"))+same(read(first),read("mut")){
 let rs=lifetime_arguments(borrow_mut(c));if len(rs)!=1{fail(borrow_mut(c),read("view lifetime arity"));}
 let mode=same(read(first),read("mut"));return intern_full(borrow_mut(c),5,0,mode,rs);}
 if same(read(first),read("vec")){
 expect(borrow_mut(c),read("<"));let e=parse_type(borrow_mut(c));expect(borrow_mut(c),read(">"));return intern(borrow_mut(c),6,e);}
 if same(read(first),read("ref"))+same(read(first),read("ref_mut")){
 expect(borrow_mut(c),read("<"));let r=region_id(borrow_mut(c));expect(borrow_mut(c),read(","));
 let e=parse_type(borrow_mut(c));expect(borrow_mut(c),read(">"));let rs=vec<num>();vec_push(rs,r);
 let mode=same(read(first),read("ref_mut"));return intern_full(borrow_mut(c),7,e,mode,rs);}
 let m=module_copy(borrow_mut(c));let d=find_decl(borrow_mut(c),read(m),read(first));
 if d==0{fail(borrow_mut(c),read("unknown type"));}return nominal_type(borrow_mut(c),d-1);
}
// ---- top level: pass 1 names, pass 2 fields/signatures/prototypes, pass 3 bodies ----
fn mangle<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->unit {
    if same(read(m),read("runtime")) { o(borrow_mut(c),n); return (); }
    o(borrow_mut(c),read("f_")); o(borrow_mut(c),m); vec_push(c.out,95); o(borrow_mut(c),n); return ();
}
fn decl<a>(c:ref_mut<a,C>,pass:num)->unit {
    let is_enum=is(borrow_mut(c),read("enum"));
    advance(borrow_mut(c));
    let name=ident(borrow_mut(c));
    lifetime_parameters(borrow_mut(c));
    let regions=len(c.rnames);let types=len(c.tnames);
    if pass!=2 {
        if pass==1 {
            let m=module_copy(borrow_mut(c));
            vec_push(c.decls,Decl{module:m,name:name,is_enum:is_enum,first:0,count:0,regions:regions,types:types});
        }
        skip_braces(borrow_mut(c));
        eat(borrow_mut(c),read(";"));
        return ();
    }
    let m=module_copy(borrow_mut(c));
    let d=find_decl(borrow_mut(c),read(m),read(name));
    let first=len(c.fields);
    var count=0;
    expect(borrow_mut(c),read("{"));
    if eat(borrow_mut(c),read("}"))==0 {
        while 1 {
            let f=ident(borrow_mut(c));
            var ty=1;
            if is_enum {
                if eat(borrow_mut(c),read("(")) {
                    ty=parse_type(borrow_mut(c));
                    expect(borrow_mut(c),read(")"));
                }
            } else {
                expect(borrow_mut(c),read(":"));
                ty=parse_type(borrow_mut(c));
            }
            vec_push(c.fields,Field{name:f,ty:ty});
            count=count+1;
            if eat(borrow_mut(c),read("}")) { break; }
            expect(borrow_mut(c),read(","));
            if eat(borrow_mut(c),read("}")) { break; }
        }
    }
    eat(borrow_mut(c),read(";"));
    exchange(vec_get_mut(c.decls,d-1),Decl{module:m,name:name,is_enum:is_enum,first:first,count:count,regions:regions,types:types});
    return ();
}
fn bind<a>(c:ref_mut<a,C>,name:bytes,ty:num,id:num,mutable:num)->unit {
    if c.raw==0{if place_of(borrow_mut(c),id)==0{let kind=ty_kind(borrow_mut(c),ty);if (kind==1)+(kind==2){let place=ownership::root(borrow_mut(c.check),1,1);vec_push(c.resources,Resource{slot:id,ty:ty,flag:0,base:0,field:0,via:0,place:place,target:0,authority:0});}}}
    let from=c.pos;let to=c.scope_end;let last=last_name(borrow_mut(c),read(name),from,to);
    vec_push(c.locals,Local{name:name,ty:ty,id:id,last:last,born:from,mutable:mutable});
    return ();
}
fn func<a>(c:ref_mut<a,C>,pass:num,public:num)->unit {
 let position=c.pos;expect(borrow_mut(c),read("fn"));var name=ident(borrow_mut(c));lifetime_parameters(borrow_mut(c));
 if same(read(name),read("print"))+same(read(name),read("println")){fail(borrow_mut(c),read("print and println are reserved prelude names"));}
 let typecount=len(c.tnames);let regioncount=len(c.rnames);
 if (pass==3)&(typecount!=0){while kind(borrow_mut(c))!=123{advance(borrow_mut(c));}skip_braces(borrow_mut(c));return ();}
 if pass==1{while kind(borrow_mut(c))!=123{advance(borrow_mut(c));}skip_braces(borrow_mut(c));return ();}
 let m=module_copy(borrow_mut(c));exchange(borrow_mut(c.locals),vec<Local>());exchange(borrow_mut(c.resources),vec<Resource>());exchange(borrow_mut(c.next),0);
 exchange(borrow_mut(c.scope_end),0);exchange(borrow_mut(c.loop_start),0);exchange(borrow_mut(c.loop_end),0);
 exchange(borrow_mut(c.check),ownership::new());exchange(borrow_mut(c.members),vec<Member>());exchange(borrow_mut(c.terminated),0);exchange(borrow_mut(c.bonds),vec<Bond>());exchange(borrow_mut(c.origins),vec<Origin>());
 let first=len(c.params);var count=0;
 expect(borrow_mut(c),read("("));
 if eat(borrow_mut(c),read(")"))==0{while 1{
 let p=ident(borrow_mut(c));expect(borrow_mut(c),read(":"));let ty=parse_type(borrow_mut(c));
 if pass==2{vec_push(c.params,ty);}let id=fresh(borrow_mut(c));bind(borrow_mut(c),p,ty,id,0);count=count+1;
 if eat(borrow_mut(c),read(")")){break;}expect(borrow_mut(c),read(","));}}
 if 6<count{fail(borrow_mut(c),read("native function exceeds six parameters"));}
 var ret=1;if eat(borrow_mut(c),read("->")){ret=parse_type(borrow_mut(c));}exchange(borrow_mut(c.result),ret);
 if pass==2{
 if find_func(borrow_mut(c),read(m),read(name))!=0{fail(borrow_mut(c),read("duplicate function"));}
 let main=(c.file==2)&same(read(name),read("main"));
 if main{if (1<count)+(typecount!=0){fail(borrow_mut(c),read("main needs zero arguments or one readonly byte view and no type parameters"));}}
 let entry=main+((c.entry==0)&(c.file==2)&public&(count<2)&(typecount==0));
 let file=c.file;let raw=c.raw;vec_push(c.funcs,Func{module:m,name:name,first:first,count:count,ret:ret,types:typecount,regions:regioncount,file:file,pos:position,raw:raw});
 let index=len(c.funcs);if entry{exchange(borrow_mut(c.entry),index);}skip_braces(borrow_mut(c));return ();}
 if c.current_spec{let spec=c.current_spec;name=special_name(borrow_mut(c),spec-1);}
 let start=c.pos;let end=block_end(borrow_mut(c),start);exchange(borrow_mut(c.scope_end),end);
 for i in len(c.locals){let l=vec_get(c.locals,i);let name=copy_bytes(read(l.name));let last=last_name(borrow_mut(c),read(name),start,end);let l=vec_get_mut(c.locals,i);exchange(borrow_mut(l.last),last);}
 o(borrow_mut(c),read(".type "));mangle(borrow_mut(c),read(m),read(name));o(borrow_mut(c),read(",@function\n"));
 mangle(borrow_mut(c),read(m),read(name));o(borrow_mut(c),read(":\npushq %rbp\nmovq %rsp,%rbp\nsubq $.F"));
 let frame=label(borrow_mut(c));on(borrow_mut(c),frame);o(borrow_mut(c),read(",%rsp\n"));
 for i in count{let reg=argreg(i);o(borrow_mut(c),read("movq "));o(borrow_mut(c),read(reg));vec_push(c.out,44);stack_slot(borrow_mut(c),i);vec_push(c.out,10);}
 o(borrow_mut(c),read("leaq -.F"));on(borrow_mut(c),frame);o(borrow_mut(c),read("(%rbp),%rdi\nmovq $.F"));on(borrow_mut(c),frame);
 o(borrow_mut(c),read("/8-"));on(borrow_mut(c),count);o(borrow_mut(c),read(",%rcx\nxorl %eax,%eax\nrep stosq\n"));
 for i in count{let l=vec_get(c.locals,i);let slot=l.id;let ty=l.ty;own(borrow_mut(c),slot,ty);init_parameter(borrow_mut(c),slot,ty);}
 block(borrow_mut(c));if c.raw==0{if (c.terminated==0)&(ret!=1){fail(borrow_mut(c),read("function may fall through without return"));}}cleanup(borrow_mut(c),0);o(borrow_mut(c),read("xorq %rax,%rax\nleave\nret\n.set .F"));on(borrow_mut(c),frame);vec_push(c.out,44);
 let n=c.next;on(borrow_mut(c),div(n+1,2)*16);vec_push(c.out,10);return ();
}
fn toplevel<a>(c:ref_mut<a,C>,pass:num)->unit {
    let raw=eat(borrow_mut(c),read("unsafe"));
    exchange(borrow_mut(c.raw),raw);
    var m=copy_bytes(read("main"));
    if eat(borrow_mut(c),read("module")){m=ident(borrow_mut(c));expect(borrow_mut(c),read(";"));}
    else{if (c.file!=2)+raw{fail(borrow_mut(c),read("dependency files require an explicit module"));}}
    if same(read(m),read("runtime")){if raw==0{fail(borrow_mut(c),read("runtime module must be explicitly unsafe"));}}
    if raw { if same(read(m),read("runtime"))==0 { fail(borrow_mut(c),read("unsafe module reserved for runtime")); } }
    exchange(borrow_mut(c.module),m);
    while eat(borrow_mut(c),read("use")) {
        ident(borrow_mut(c));
        expect(borrow_mut(c),read(";"));
    }
    while kind(borrow_mut(c))!=0 {
        let public=eat(borrow_mut(c),read("pub"));
        if is(borrow_mut(c),read("struct"))+is(borrow_mut(c),read("enum")) {
            decl(borrow_mut(c),pass);
        } else {
            func(borrow_mut(c),pass,public);
        }
    }
    return ();
}

// ---- expressions: eight-byte stack slots; left-to-right operands ----
fn deref<a>(c:ref_mut<a,C>,v:Val)->Val {
 var t=v.t;var ty=v.ty;
 while ty_kind(borrow_mut(c),ty)==7{
 let old=t;let target=target_of(borrow_mut(c),old);
 get(borrow_mut(c),t,read("%rax"));o(borrow_mut(c),read("movq (%rax),%rax\n"));t=save(borrow_mut(c));ty=ty_arg(borrow_mut(c),ty);
 if c.raw==0{if target==0{fail(borrow_mut(c),read("reference target is not tracked"));}
 vec_push(c.resources,Resource{slot:t,ty:ty,flag:0,base:old+1,field:0,via:1,place:target,target:0,authority:old+1});
 let owner=place_of(borrow_mut(c),old);let n=len(c.bonds);
 for i in n{let b=vec_get(c.bonds,i);let holder=b.holder;let loan=b.loan;let guard=b.guard;
 if (holder==owner)&guard{bond_kind(borrow_mut(c),target,loan,guard);}}
 stored_source(borrow_mut(c),t,ty);}
 }
 return val(t,ty);
}
fn find_local<a,b>(c:ref_mut<a,C>,n:read<b>)->num {
    var i=len(c.locals);
    while 0<i {
        i=i-1;
        let l=vec_get(c.locals,i);
        if same(read(l.name),read(n)) { return i+1; }
    }
    return 0;
}
fn local_id<a>(c:ref_mut<a,C>,i:num)->num { let l=vec_get(c.locals,i); return l.id; }
fn local_ty<a>(c:ref_mut<a,C>,i:num)->num { let l=vec_get(c.locals,i); return l.ty; }
fn pop_locals<a>(c:ref_mut<a,C>,mark:num)->unit {
    while mark<len(c.locals) { vec_pop(c.locals); }
    return ();
}
// Loads, addresses and stores record fields.
fn rec_load<a>(c:ref_mut<a,C>,base:num,k:num,address:num)->num{
 get(borrow_mut(c),base,read("%rax"));
 if address{o(borrow_mut(c),read("leaq "));}else{o(borrow_mut(c),read("movq "));}
