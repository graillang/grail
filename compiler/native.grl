// A temporary scrutinee reference (`match &s`) lives in each arm only as long as the
// payload references bound from it: it becomes a hidden local that expires at the first
// statement boundary where nothing borrows from it, so the arm may then modify `s`.
fn arm_scrutinee<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if is_local_slot(&mut c, slot) {
        return ();
    }
    if resource(&mut c, slot) == 0 {
        return ();
    }
    c
        .locals
        .push(
            Local {
                name: copy_bytes(view(".scrutinee")),
                ty: ty,
                id: slot,
                last: c.pos,
                born: c.pos,
                mutable: 0,
                flex: 0,
                lit: 0,
                neg: 0,
                origin: 0,
                at: 0,
            }
        );
    return ();
}
// Whether a read of local index i still denotes its literal. A mutable binding qualifies only
// before any assignment can have run: not inside a loop opened after its declaration.
fn flex_read<a>(c: (&a mut C), i: u64) -> bool {
    l := &c.locals[i];
    if l.flex == 0 {
        return false;
    }
    if l.mutable == 0 {
        return true;
    }
    return c.loop_start < l.born + 1;
}
fn commit_flex<a>(c: (&a mut C), i: u64) -> unit {
    mut l = &mut c.locals[i];
    if l.mutable != 0 {
        exchange(&mut l.flex, 0);
    }
    return ();
}
// First assignment of a flexible mutable local: a sized integer value fixes its type.
fn settle_flex<a>(c: (&a mut C), i: u64, value_ty: u64) -> u64 {
