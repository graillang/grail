        value := record_member(&mut c, val(pair_slot, pair_type), view("value"));
        bind(&mut c, value_name.copy(), value.ty, value.t, 0);
    } else {
        mut args = Val[];
        args.push(place_slot(&mut c, refslot, refty, 0));
        args.push(val(i, 0));
        key := map_call(&mut c, view("key_at"), mapty, args);
        bind(&mut c, name.copy(), key.ty, key.t, 0);
