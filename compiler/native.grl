            }
        }
        if b != 0 {
            return builtin(&mut c, b);
        }
        local := find_local(&mut c, view(first));
        if local != 0 {
            slot := local_id(&mut c, local - 1);
            ty := local_ty(&mut c, local - 1);
            mut callable = ty;
            while ty_kind(&mut c, callable) == 7 {
                callable = ty_arg(&mut c, callable);
            }
            if (ty_kind(&mut c, callable) == 12) || (ty_kind(&mut c, callable) == 20) || (ty_kind(&mut c, callable) == 25) {
                return indirect_call(&mut c, val(slot, ty), 0);
            }
        }
        if local == 0 {
            captured := capture_field(&mut c, view(first), 0, 0);
            if captured.ty != 18446744073709551615 {
                ck := ty_kind(&mut c, captured.ty);
                if (ck == 12) || (ck == 20) || (ck == 25) {
                    return indirect_call(&mut c, captured, 0);
                }
            }
        }
        return call(&mut c, view(m), view(first));
    }
    mut l = find_local(&mut c, view(first));
    if l != 0 {
        id := local_id(&mut c, l - 1);
        ty := local_ty(&mut c, l - 1);
        if kind(&mut c) != 46 {
            observe(&mut c, id);
            // An untyped literal binding reads as its literal, so the use site may adopt a type.
            if (c.raw == 0) & flex_read(&mut c, l - 1) {
                entry := &c.locals[l - 1];
                value := entry.lit;
                negative := entry.neg;
                floating := entry.flex == 2;
                p := c.pos;
                if floating {
                    exchange(&mut c.flit_start, p - 1);
                    exchange(&mut c.flit_end, p);
                    exchange(&mut c.flit_tok, value);
                    exchange(&mut c.flit_neg, negative);
                } else {
                    exchange(&mut c.lit_start, p - 1);
                    exchange(&mut c.lit_end, p);
                    exchange(&mut c.lit_value, value);
                    exchange(&mut c.lit_negative, negative);
                }
            }
        } else {
            commit_flex(&mut c, l - 1);
        }
        if (c.raw == 0) & (kind(&mut c) != 46) {
            entry := &c.locals[l - 1];
            if entry.origin != 0 {
                if !flex_read(&mut c, l - 1) {
                    p := c.pos;
                    exchange(&mut c.cf_start, p - 1);
                    exchange(&mut c.cf_end, p);
                    exchange(&mut c.cf_local, l);
                }
            }
        }
        return field_path(&mut c, id, ty, 0);
    }
    captured := capture_field(&mut c, view(first), 0, 0);
    if captured.ty != 18446744073709551615 {
        return captured;
    }
    constant := constant_value(&mut c, view(m), view(first));
    if constant.ty != 18446744073709551615 {
        return constant;
    }
    function := find_func(&mut c, view(m), view(first));
    if function != 0 {
        return function_value(&mut c, function - 1);
    }
    mut r = find_decl(&mut c, view(m), view(first));
    if r != 0 {
        return record(&mut c, r - 1, 18446744073709551615);
    }
