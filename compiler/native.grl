    }
    caps := type_caps(&mut c, ty, 0);
    for i in caps.len() {
        mut r = caps[i];
        source := external_place(&mut c, r, 0);
        loan := ownership::borrow_place(&mut c.check, source, 0);
        bond_kind(&mut c, storage, loan, 1);
