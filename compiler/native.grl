// Integer literal text (decimal, 0x hex, 0b binary, 0o octal, with _ separators) -> value.
// 'a', '\n', '\u{1F600}', 'é' (UTF-8): the Unicode scalar value of a character literal token.
fn char_literal<a>(c: (&a mut C), tok: u64) -> u64 {
    t := tok_text(&mut c, tok);
    b := t[1];
    if b == 92 {
        e := t[2];
        if e == 110 {
            return 10;
        }
        if e == 116 {
            return 9;
        }
        if e == 114 {
            return 13;
        }
        if e == 48 {
            return 0;
        }
        if e == 117 {
            mut v = 0;
            mut i = 4;
            while i + 2 < t.len() {
                d := t[i];
                if d != 95 {
                    v = v * 16 + hex(d);
                    if 1114111 < v {
                        fail(&mut c, view("invalid character literal"));
                    }
                }
                i += 1;
            }
            if (55295 < v) & (v < 57344) {
                fail(&mut c, view("invalid character literal"));
            }
            return v;
        }
        return e;
    }
    if b < 128 {
        return b;
    }
    mut need = 1;
    mut v = b & 31;
    if 223 < b {
        need = 2;
        v = b & 15;
    }
    if 239 < b {
        need = 3;
        v = b & 7;
    }
    for i in need {
