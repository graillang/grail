        if same(view(first), view("core")) & (same(view(second), view("some")) || same(view(second), view("none"))) {
            fail(&mut c, view("use Some(value)/None, not core::some/core::none"));
        }
        if is(&mut c, view("<")) {
            d := find_decl(&mut c, view(first), view(second));
            if d != 0 {
