fn matching_paren<a>(c: (&a mut C), open: u64) -> u64 {
    mut depth = 0;
    mut j = open;
    while kind_at(&mut c, j) != 0 {
        k := kind_at(&mut c, j);
        if k == 40 {
            depth += 1;
        }
        if k == 41 {
            depth -= 1;
            if depth == 0 {
                return j;
            }
        }
        j += 1;
    }
    return 0;
}
fn tok_is_return<a>(c: (&a mut C), i: u64) -> bool {
    st := c.toks[i].start;
