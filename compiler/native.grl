            mut depth = 0;
            mut closed = 0;
            while p < end {
                kk := kind_at(&mut c, p);
                if (kk == 40) || (kk == 91) || (kk == 123) {
                    depth += 1;
                } else if (kk == 41) || (kk == 93) || (kk == 125) {
                    depth -= 1;
                    if depth == 0 {
                        p = p + 1;
                        closed = 1;
                        break;
