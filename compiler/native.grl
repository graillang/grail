                module: "host".copy(),
                name: name.copy(),
                first: first,
                count: count,
                ret: ret,
                types: 0,
                regions: 0,
                file: 0,
                pos: 0,
                raw: 0,
                unsafe_fn: 0,
                bounds: u64[],
                constraints: u64[][],
                contract: 0,
                owner: 0,
                ext: 0,
                symbol: u8[],
                body: u8[],
                ppreds: Pred[],
                rpred: no_pred(),
                pnames: u8[][],
                strict: 0,
                no_alloc: 0,
                no_panic: 0,
            }
        );
    return ();
}
fn drop_call<a>(c: (&a mut C), ty: u64) -> unit {
    // A body emitted without its bindings (a template's validation replay) cannot name a helper: the
    // name would be keyed by a type parameter, and no helper is emitted for one. The body that is
    // kept is the replayed one, where the type is the instantiation's.
    if needs_drop(&mut c, ty) {
        if !concrete_type(&mut c, ty) {
            return ();
        }
        drop_call_out(&mut c, ty);
    }
    return ();
}
// `// grail-link: INPUT` is the compiler's complete linker request; build tooling
// resolves relative object/archive/shared inputs against the declaring sources and
// passes bare names as -lNAME. Nothing else has to guess link inputs.
fn push_bytes<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    for i in s.len() {
        out.push(s[i]);
    }
    return ();
}
fn with_link_notes<a, b>(libs: (&a u8[][]), body: &b [u8]) -> u8[] {
    mut out = u8[];
    for i in libs.len() {
        push_bytes(&mut out, view("// grail-link: "));
        push_bytes(&mut out, view(libs[i]));
        out.push(10);
    }
    push_bytes(&mut out, view(body));
    return out;
}
fn emit_drops<a>(c: (&a mut C)) -> unit {
    // Drop helpers are not module code: they are this object's own helpers, so they get a part of
    // their own. A build made of several objects takes each module's code from exactly one object
    // and merges the helper parts, which is what the weak binding below allows.
    part(&mut c, view(".helpers"));
    mut all = u64[];
    for i in c.types.len() {
        all.push(i);
    }
    for i in c.drop_refs.len() {
        all.push(c.drop_refs[i]);
    }
    mut at = 0;
    mut ref_at = 0;
    // The walk interns types of its own (a field's type is built on demand) and the bodies it emits
    // name further helpers, so it keeps absorbing both: a helper that is named but never emitted is
    // an undefined symbol at link time.
    while true {
        while all.len() < c.types.len() {
            all.push(all.len());
        }
        while ref_at < c.drop_refs.len() {
            all.push(c.drop_refs[ref_at]);
            ref_at = ref_at + 1;
        }
        if at == all.len() {
            break;
        }
        ty := all[at];
        at = at + 1;
        kind := ty_kind(&mut c, ty);
        arg := ty_arg(&mut c, ty);
        if concrete_type(&mut c, ty) {
            if needs_drop(&mut c, ty) {
                // One definition per key, not per interned index: two indices can describe the same
                // drop - a view of one element type and a view of another both only release the
                // backing store - and the key is what decides identity. The body is a function of
                // exactly the components the key records, so the first definition serves both.
                if drop_taken(&mut c, ty) != 0 {
                    continue;
                }
                done := label(&mut c);
                hook := drop_hook_symbol(&mut c, ty);
                // Defined here and called from every module, and a pure function of the type it
                // drops - so the name is content-addressed and the binding is weak: two objects
                // that both emit it emit the same body, and the linker merges them. `--split`
                // needs the name visible across parts, and a build made of several objects needs it
                // too (B1 stage 3).
                fx_end(&mut c);
                helper_sym := drop_symbol(&mut c, ty);
                fx_helper(&mut c, view(helper_sym));
                weak_def(&mut c);
                drop_name(&mut c, ty);
                c.out.push(10);
                drop_name(&mut c, ty);
                o(&mut c, view(":\ntestq %rdi,%rdi\n"));
                jump(&mut c, view("jz"), done);
                o(
                    &mut c,
                    view("pushq %rbp\nmovq %rsp,%rbp\npushq %r12\npushq %r13\nmovq %rdi,%r12\n")
                );
                // The user's `drop` runs first, with the value as its receiver; the field walk below
                // releases what the fields own, as Rust does after a `Drop` impl has run.
                if hook.len() != 0 {
                    // A record's `&mut T` is the address of a cell holding the record pointer, not the
                    // pointer itself, so the receiver is one scratch word (two, to keep the call
                    // 16-byte aligned).
                    o(&mut c, view("subq $16,%rsp\nmovq %r12,(%rsp)\nmovq %rsp,%rdi\n"));
                    call_out(&mut c, view(hook));
                    o(&mut c, view("addq $16,%rsp\n"));
                }
                if (kind == 3) || (kind == 4) {
                    call_out(&mut c, view("rt_drop_seq"));
                }
                if (kind == 5) || (kind == 11) || (kind == 27) {
                    call_out(&mut c, view("rt_free"));
                }
                if kind == 16 {
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_task_abandon"));
                }
                if kind == 29 {
                    // A job handle is never abandoned: the wait is what owns the record, so dropping
                    // it takes the result and drops that. Leaving it to a leak would keep the job's
                    // captures and its result alive for the life of the process.
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_pool_wait"));
                    if needs_drop(&mut c, arg) {
                        o(&mut c, view("movq %rax,%rdi\n"));
                        drop_call(&mut c, arg);
                    }
                }
                if kind == 20 {
                    o(&mut c, view("movq %r12,%rdi\nmovq 8(%r12),%rax\n"));
                    call_dispatch_out(&mut c, view("call *%rax\n"));
                }
                if kind == 13 {
                    o(&mut c, view("movq 8(%r12),%rdi\n"));
                    drop_call(&mut c, arg);
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_free"));
                }
                if kind == 10 {
                    drop_call(&mut c, arg);
                }
                if kind == 33 {
                    // {value, vtable}: the vtable's first word drops the value (0 when nothing does).
                    skip := label(&mut c);
                    o(&mut c, view("movq 8(%r12),%rax\nmovq (%rax),%rax\ntestq %rax,%rax\n"));
                    jump(&mut c, view("jz"), skip);
                    o(&mut c, view("movq (%r12),%rdi\n"));
                    fx_vtable_drop(&mut c, arg);
                    o(&mut c, view("call *%rax\n"));
                    mark(&mut c, skip);
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_free"));
                }
                if kind == 6 {
                    if needs_drop(&mut c, arg) {
                        head := label(&mut c);
                        end := label(&mut c);
                        o(&mut c, view("xorq %r13,%r13\n"));
                        mark(&mut c, head);
                        o(&mut c, view("cmpq 8(%r12),%r13\n"));
                        jump(&mut c, view("jae"), end);
                        o(&mut c, view("movq (%r12),%rax\nmovq (%rax,%r13,8),%rdi\n"));
                        drop_call(&mut c, arg);
                        o(&mut c, view("incq %r13\n"));
                        jump(&mut c, view("jmp"), head);
                        mark(&mut c, end);
                    }
                    o(&mut c, view("movq %r12,%rdi\n"));
                call_out(&mut c, view("rt_drop_seq"));
                }
                if kind == 8 {
                    d := &c.decls[arg];
                    // A C-layout record's fields are plain bytes (embedded records included):
                    // only its own buffer is freed.
                    mut count = d.count;
                    if d.c_layout != 0 {
                        count = 0;
                    }
                    is_enum := d.is_enum;
                    for i in count {
                        t := field_type(&mut c, ty, i);
                        if needs_drop(&mut c, t) {
                            if is_enum != 0 {
                                skip := label(&mut c);
                                o(&mut c, view("cmpq $"));
                                on(&mut c, i);
                                o(&mut c, view(",(%r12)\n"));
                                jump(&mut c, view("jne"), skip);
                                o(&mut c, view("movq 8(%r12),%rdi\n"));
                                drop_call(&mut c, t);
                                mark(&mut c, skip);
                            } else {
                                o(&mut c, view("movq "));
                                on(&mut c, i * 8);
                                o(&mut c, view("(%r12),%rdi\n"));
                                drop_call(&mut c, t);
                            }
                        }
                    }
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_free"));
                }
                o(&mut c, view("popq %r13\npopq %r12\nleave\n"));
                mark(&mut c, done);
                o(&mut c, view("ret\n"));
            }
        }
    }
    return ();
}
fn emit_exit<a, b>(c: (&a mut C), argument: &b [u8]) -> unit {
    if c.target == 4 {
        // The lowering expands `winexit` into an indirect IAT call with ARM64 home space.
        o(&mut c, argument);
        o(&mut c, view("winexit\n"));
        return ();
    }
    if c.target == 3 {
        // Win64 passes the exit code in ECX; the import slot is a real indirect IAT call.
        win32_link(&mut c, view("ExitProcess"));
        o(&mut c, argument);
        o(&mut c, view("movl %edi,%ecx\ncall *__imp_ExitProcess(%rip)\nud2\n"));
        return ();
    
    }
    if c.plat == 1 {
        o(&mut c, argument);
        o(&mut c, view("call _exit\n"));
        return ();
    }
    mut number = 231;
    if c.target != 0 {
        number = 94;
    }
    o(&mut c, view("movl $"));
    on(&mut c, number);
    o(&mut c, view(",%eax\n"));
    o(&mut c, argument);
    o(&mut c, view("syscall\n"));
    return ();
}
// ---- module interfaces (B1 stage 2) ----
//
// An interface is the checked surface of one module: the declarations an importer needs to check a
// call, and nothing a body would carry. It is line-oriented text (docs/design/separate-compilation.md
// records the format, the ordering rule and the named limitations), written by
// `--emit-interface DIR`, read by `--interface DIR`, and compared declaration by declaration with
// the sources by `--verify-interface`.
//
// The one thing that must not be lost on the way through the file is the *audit result*: a handle's
// `Decl.transfer`/`Decl.share` and a closure type's `Ty.env` environment record. An importer that
// re-derived default-deny from the type alone would refuse a move the audited declaration allowed.

// ---- content digests ----
//
// SHA-256 (FIPS 180-4). The interface digests are what make "refuses to proceed when the sources it
// was built from changed" checkable, so they are a real cryptographic hash and not a checksum.
// The compiler is built without the standard library, so it carries its own; `lib/sha256.grl` is the
// user-facing twin with an incremental API. `tools/interface-test.mjs` checks every `source-sha256`
// line against the host's `sha256sum`, which is what keeps this copy honest.
const S256MASK: u64 = 4294967295;
fn s256_k() -> u64[] {
    return u64[
        0x428a2f98,
        0x71374491,
        0xb5c0fbcf,
        0xe9b5dba5,
        0x3956c25b,
        0x59f111f1,
        0x923f82a4,
        0xab1c5ed5,
        0xd807aa98,
        0x12835b01,
        0x243185be,
        0x550c7dc3,
        0x72be5d74,
        0x80deb1fe,
        0x9bdc06a7,
        0xc19bf174,
        0xe49b69c1,
        0xefbe4786,
        0x0fc19dc6,
        0x240ca1cc,
        0x2de92c6f,
        0x4a7484aa,
        0x5cb0a9dc,
        0x76f988da,
        0x983e5152,
        0xa831c66d,
        0xb00327c8,
        0xbf597fc7,
        0xc6e00bf3,
        0xd5a79147,
        0x06ca6351,
        0x14292967,
        0x27b70a85,
        0x2e1b2138,
        0x4d2c6dfc,
        0x53380d13,
        0x650a7354,
        0x766a0abb,
        0x81c2c92e,
        0x92722c85,
        0xa2bfe8a1,
        0xa81a664b,
        0xc24b8b70,
        0xc76c51a3,
        0xd192e819,
        0xd6990624,
        0xf40e3585,
        0x106aa070,
        0x19a4c116,
        0x1e376c08,
        0x2748774c,
        0x34b0bcb5,
        0x391c0cb3,
        0x4ed8aa4a,
        0x5b9cca4f,
        0x682e6ff3,
        0x748f82ee,
        0x78a5636f,
        0x84c87814,
        0x8cc70208,
        0x90befffa,
        0xa4506ceb,
        0xbef9a3f7,
        0xc67178f2
    ];
}
fn s256_rotr(x: u64, n: u64) -> u64 {
    return ((x >> n) | (x << (32 - n))) & S256MASK;
}
// Compresses the 64-byte block text[at:at+64] into `h`, using `w` as the message schedule.
fn s256_block(h: (&mut u64[]), text: &[u8], at: u64, w: (&mut u64[]), k: (&u64[])) {
    for t in 16 {
        o := at + t * 4;
        exchange(&mut w[t], (text[o] << 24) | (text[o + 1] << 16) | (text[o + 2] << 8) | text[o + 3]);
    }
    for t in 16..64 {
        x := w[t - 15];
        y := w[t - 2];
        s0 := s256_rotr(x, 7) ^ s256_rotr(x, 18) ^ (x >> 3);
        s1 := s256_rotr(y, 17) ^ s256_rotr(y, 19) ^ (y >> 10);
        packed := w[t - 16] + s0 + w[t - 7] + s1;
        exchange(&mut w[t], packed & S256MASK);
    }
    mut a: u64 = h[0];
    mut b: u64 = h[1];
    mut c: u64 = h[2];
    mut d: u64 = h[3];
    mut e: u64 = h[4];
    mut f: u64 = h[5];
    mut g: u64 = h[6];
    mut i: u64 = h[7];
    for t in 64 {
        s1 := s256_rotr(e, 6) ^ s256_rotr(e, 11) ^ s256_rotr(e, 25);
        ch := (e & f) ^ ((e ^ S256MASK) & g);
        t1 := i + s1 + ch + k[t] + w[t];
        s0 := s256_rotr(a, 2) ^ s256_rotr(a, 13) ^ s256_rotr(a, 22);
        maj := (a & b) ^ (a & c) ^ (b & c);
        i = g;
        g = f;
        f = e;
        e = (d + t1) & S256MASK;
        d = c;
        c = b;
        b = a;
        a = (t1 + s0 + maj) & S256MASK;
    }
    h0 := (h[0] + a) & S256MASK;
    h1 := (h[1] + b) & S256MASK;
    h2 := (h[2] + c) & S256MASK;
    h3 := (h[3] + d) & S256MASK;
    h4 := (h[4] + e) & S256MASK;
    h5 := (h[5] + f) & S256MASK;
    h6 := (h[6] + g) & S256MASK;
    h7 := (h[7] + i) & S256MASK;
    exchange(&mut h[0], h0);
    exchange(&mut h[1], h1);
    exchange(&mut h[2], h2);
    exchange(&mut h[3], h3);
    exchange(&mut h[4], h4);
    exchange(&mut h[5], h5);
    exchange(&mut h[6], h6);
    exchange(&mut h[7], h7);
    return ();
}
// The 32-byte SHA-256 digest of a byte view.
fn sha256<a>(data: &a [u8]) -> u8[] {
    mut h = u64[0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    k := s256_k();
    mut w = u64[];
    for i in 64 {
        w.push(0);
    }
    mut at: u64 = 0;
    while at + 64 <= data.len() {
        s256_block(&mut h, data, at, &mut w, &k);
        at += 64;
    }
    mut tail = u8[];
    for i in data.len() - at {
        tail.push(data[at + i]);
    }
    tail.push(128);
    while tail.len() % 64 != 56 {
        tail.push(0);
    }
    bits := data.len() * 8;
    for i in 8 {
        tail.push((bits >> (56 - i * 8)) & 255);
    }
    mut block: u64 = 0;
    while block < tail.len() {
        s256_block(&mut h, &tail, block, &mut w, &k);
        block += 64;
    }
    mut out = u8[];
    for i in 8 {
        word := h[i];
        out.push(word >> 24);
        out.push((word >> 16) & 255);
        out.push((word >> 8) & 255);
        out.push(word & 255);
    }
    return out;
}
// Lowercase hexadecimal, two characters per byte.
fn iface_hex<a>(bytes: &a [u8]) -> u8[] {
    digits := "0123456789abcdef";
    mut out = u8[];
    for i in bytes.len() {
        b := bytes[i];
        out.push(digits[b >> 4]);
        out.push(digits[b & 15]);
    }
    return out;
}
// The SHA-256 of a byte view as 64 lowercase hex characters.
pub fn iface_digest<a>(data: &a [u8]) -> u8[] {
    d := sha256(data);
    return iface_hex(&d);
}

// ---- the interface text format ----
//
// Grammar (docs/design/separate-compilation.md has the full description and a worked example):
//
//   file      := "// grail-interface 3" NL header+ declaration* "digest " HEX NL
//   type      := WORD [" " MODE] [" " "[" REGIONS "]"] PAYLOAD
//
// One word per store kind; MODE and REGIONS are written only when they are not 0 and empty, and the
// reader accepts them wherever they are legal, so the spelling of a type is a function of the type
// alone. `iface_roundtrip` reads back every type written and refuses to emit one the reader would
// rebuild differently, so the format cannot quietly reinterpret anything.

fn iface_before<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    mut i = 0;
    while (i < x.len()) & (i < y.len()) {
        if x[i] != y[i] {
            return x[i] < y[i];
        }
        i += 1;
    }
    return x.len() < y.len();
}
// Declarations are written in name order, so a review diff shows the declaration that changed
// rather than a reshuffled file.
fn iface_sorted<a>(names: (&a u8[][])) -> u64[] {
    mut order = u64[];
    mut used = u64[];
    for i in names.len() {
        used.push(0);
    }
    while order.len() < names.len() {
        mut best = names.len();
        for i in names.len() {
            if used[i] == 0 {
                if best == names.len() {
                    best = i;
                } else {
                    if iface_before(view(names[i]), view(names[best])) {
                        best = i;
                    }
                }
            }
        }
        exchange(&mut used[best], 1);
        order.push(best);
    }
    return order;
}
fn iface_ref<a, b>(out: (&a mut u8[]), m: &a [u8], n: &b [u8]) -> unit {
    push_bytes(&mut out, view(m));
    push_bytes(&mut out, view("::"));
    push_bytes(&mut out, view(n));
    return ();
}
fn iface_regions<a, b>(out: (&a mut u8[]), rs: (&b u64[])) -> unit {
    out.push(91);
    for i in rs.len() {
        if i != 0 {
            out.push(44);
        }
        decimal(&mut out, rs[i]);
    }
    out.push(93);
    return ();
}
// ` MODE` and ` [REGIONS]`, in the one order the reader expects.
fn iface_extra<a, b>(out: (&a mut u8[]), mode: u64, rs: (&b u64[])) -> unit {
    if mode != 0 {
        out.push(32);
        decimal(&mut out, mode);
    }
    if rs.len() != 0 {
        out.push(32);
        iface_regions(&mut out, &rs);
    }
    return ();
}
fn iface_type_list<a, b>(out: (&a mut u8[]), c: (&b mut C), args: (&b u64[])) -> unit {
    out.push(40);
    for i in args.len() {
        if i != 0 {
            out.push(44);
        }
        iface_type_raw(&mut out, &mut c, args[i]);
    }
    out.push(41);
    return ();
}
// The canonical spelling of one interned type: kind, mode, regions, arguments and, for a closure,
// its environment record. Nothing is dropped, because an importer that had to re-derive any of it
// could re-derive a different answer.
// The checked entry point: writes the type and then reads it back, refusing a spelling the reader
// would rebuild differently. Recursion goes through `iface_type_raw` so one type is verified once.
fn iface_type<a, b>(out: (&a mut u8[]), c: (&b mut C), ty: u64) -> unit {
    start := out.len();
    iface_type_raw(&mut out, &mut c, ty);
    // `--verify-interface` also proves that the writer and the reader agree about every type the
    // module's surface contains: the text just written is read back and must denote the same
    // interned type. It costs a re-parse per type, so an ordinary emit does not pay for it.
    if c.iface_verify == 0 {
        return ();
    }
    mut text = u8[];
    for i in out.len() - start {
        text.push(out[start + i]);
    }
    mut p = IPos { text: text.copy(), toks: iface_tokens(view(text)), at: 0, path: copy_bytes(view("<interface>")), line: 1 };
    back := iface_parse_type(&mut c, &mut p);
    if back != ty {
        mut msg = u8[];
        push_bytes(&mut msg, view("this interface format does not round-trip a type: wrote `"));
        push_bytes(&mut msg, view(text));
        push_bytes(&mut msg, view("` and read back a different one"));
        iface_refuse(view("<interface>"), view(msg));
    }
    return ();
}
fn iface_type_raw<a, b>(out: (&a mut u8[]), c: (&b mut C), ty: u64) -> unit {
    k := ty_kind(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    rs := type_regions(&mut c, ty);
    args := type_args(&mut c, ty);
    env := ty_env(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if k == 21 {
        // The width lives in the argument: 32 bits is f32, 0 is f64.
        if arg == 32 {
            push_bytes(&mut out, view("f32"));
        } else {
            push_bytes(&mut out, view("f64"));
        }
        return ();
    }
    if k == 31 {
        // A value parameter's binding (comptime C2): the constant itself.
        push_bytes(&mut out, view("(const "));
        decimal(&mut out, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if (k == 1) || (k == 2) || (k == 3) || (k == 4) || (k == 11) || (k == 17) || (k == 19) || (k == 22) || (k == 24) {
        push_bytes(&mut out, view(iface_plain_word(k)));
        return ();
    }
    if k == 5 {
        push_bytes(&mut out, view("(view"));
        iface_extra(&mut out, mode, &rs);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 18 {
        push_bytes(&mut out, view("(int "));
        decimal(&mut out, arg);
        if mode == 0 {
            push_bytes(&mut out, view("u)"));
        } else {
            push_bytes(&mut out, view("i)"));
        }
        return ();
    }
    if (k == 6) || (k == 13) || (k == 14) || (k == 16) || (k == 26) || (k == 27) || (k == 29) || (k == 34) {
        push_bytes(&mut out, view("("));
        push_bytes(&mut out, view(iface_plain_word(k)));
        iface_extra(&mut out, mode, &rs);
        out.push(32);
        iface_type_raw(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 7 {
        push_bytes(&mut out, view("(ref"));
        iface_extra(&mut out, mode, &rs);
        out.push(32);
        iface_type_raw(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 8 {
        // `T?` / `T | E` are structural: the compiler synthesises one declaration per member
        // count (`.union::Union2`, `.result::Result2_1`), so an interface states the members and
        // the reader rebuilds the same declaration by the same rule instead of naming an index.
        owner := c.decls[arg].module.copy();
        if same(view(owner), view(".outcome")) & same(view(c.decls[arg].name), view("Failure")) {
            // The synthesized failure record: rebuilt by the reader from its own rule, like the
            // union declarations beside it.
            push_bytes(&mut out, view("(outcomefail)"));
            return ();
        }
        if same(view(owner), view(".union")) || same(view(owner), view(".result"))
            || same(view(owner), view(".outcome")) {
            if same(view(owner), view(".union")) {
                push_bytes(&mut out, view("(union "));
            } else if same(view(owner), view(".outcome")) {
                push_bytes(&mut out, view("(outcome "));
            } else {
                push_bytes(&mut out, view("(result "));
            }
            decimal(&mut out, c.decls[arg].success);
            out.push(32);
            iface_type_list(&mut out, &mut c, &args);
            push_bytes(&mut out, view(")"));
            return ();
        }
        push_bytes(&mut out, view("(named "));
        iface_decl_ref(&mut out, &mut c, arg);
        iface_extra(&mut out, mode, &rs);
        for i in args.len() {
            out.push(32);
            iface_type_raw(&mut out, &mut c, args[i]);
        }
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 23 {
        push_bytes(&mut out, view("(handle "));
        iface_decl_ref(&mut out, &mut c, arg);
        iface_extra(&mut out, mode, &rs);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 28 {
        push_bytes(&mut out, view("(byval "));
        iface_decl_ref(&mut out, &mut c, arg);
        iface_extra(&mut out, mode, &rs);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 9 {
        // An opaque type parameter carries its bound bits in `mode` and the interface proofs it
        // satisfies in `args`, so both are written: a `T: Send + Ord` is not a plain `T`.
        push_bytes(&mut out, view("(tparam "));
        decimal(&mut out, arg);
        out.push(32);
        decimal(&mut out, mode);
        out.push(32);
        iface_regions(&mut out, &rs);
        for i in args.len() {
            out.push(32);
            iface_type_raw(&mut out, &mut c, args[i]);
        }
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 33 {
        push_bytes(&mut out, view("(dyn "));
        iface_interface_ref(&mut out, &mut c, arg);
        for i in args.len() {
            out.push(32);
            iface_type_raw(&mut out, &mut c, args[i]);
        }
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 35 {
        // A borrowed interface object's referent: the `dyn` type it names. The interface format
        // carries it inside the reference it belongs to, so `&dyn I` round-trips as `(ref ...)`.
        push_bytes(&mut out, view("(bobj "));
        iface_type_raw(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 30 {
        // `(assoc PARAM INTERFACE INDEX)`: the interface by name, since ids are this run's.
        push_bytes(&mut out, view("(assoc "));
        iface_type_raw(&mut out, &mut c, arg);
        out.push(32);
        iface_interface_ref(&mut out, &mut c, mode / 1024);
        out.push(32);
        decimal(&mut out, mode % 1024);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 10 {
        push_bytes(&mut out, view("(bound "));
        iface_type_raw(&mut out, &mut c, arg);
        out.push(32);
        decimal(&mut out, mode);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 15 {
        push_bytes(&mut out, view("(proof "));
        iface_interface_ref(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if (k == 12) || (k == 25) {
        push_bytes(&mut out, view("("));
        push_bytes(&mut out, view(iface_plain_word(k)));
        iface_extra(&mut out, mode, &rs);
        out.push(32);
        iface_type_list(&mut out, &mut c, &args);
        out.push(32);
        iface_type_raw(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 20 {
        push_bytes(&mut out, view("(closure"));
        iface_extra(&mut out, mode, &rs);
        out.push(32);
        iface_type_list(&mut out, &mut c, &args);
        out.push(32);
        iface_type_raw(&mut out, &mut c, arg);
        out.push(32);
        if env == 0 {
            out.push(48);
        } else {
            iface_type_raw(&mut out, &mut c, env);
        }
        push_bytes(&mut out, view(")"));
        return ();
    }
    // A store extension with no spelling: refuse rather than write something that reads back as a
    // different type. A caller that only asked *whether* a type has a spelling (`spell_lenient`)
    // records the gap and gets on with the build: naming a type must never be able to fail one.
    if c.spell_lenient != 0 {
        exchange(&mut c.spell_failed, 1);
        return ();
    }
    iface_refuse(view("<interface>"), view("this interface format cannot express a type of that kind"));
    return ();
}
// A path, a digest, a link input or a line of body text: arbitrary bytes have to lex as one token
// whatever they start with (a digest begins with a digit, and a digit-led token would lex as a
// number), so they are written as a quoted string. A body line carries spaces, quotes and braces, so
// the quote, the backslash and every byte outside printable ASCII are escaped - the lexer refuses a
// raw control byte inside a string.
fn iface_escape<a>(out: (&a mut u8[]), text: &a [u8]) -> unit {
    digits := "0123456789abcdef";
    for i in text.len() {
        b := text[i];
        if b == 34 {
            out.push(92);
            out.push(34);
        } else if b == 92 {
            out.push(92);
            out.push(92);
        } else if (b < 32) || (127 < b) {
            out.push(92);
            out.push(120);
            out.push(digits[b >> 4]);
            out.push(digits[b & 15]);
        } else {
            out.push(b);
        }
    }
    return ();
}
fn iface_quoted<a>(out: (&a mut u8[]), text: &a [u8]) -> unit {
    out.push(34);
    iface_escape(&mut out, view(text));
    out.push(34);
    return ();
}
fn iface_plain_word(k: u64) -> string {
    if k == 1 {
        return "u64";
    }
    if k == 2 {
        return "unit";
    }
    if k == 3 {
        return "bytes";
    }
    if k == 4 {
        return "string";
    }
    if k == 11 {
        return "atomic";
    }
    if k == 17 {
        return "cancel";
    }
    if k == 19 {
        return "bool";
    }
    if k == 21 {
        return "f64";
    }
    if k == 22 {
        return "char";
    }
    if k == 24 {
        return "cstr";
    }
    if k == 5 {
        return "view";
    }
    if k == 6 {
        return "vec";
    }
    if k == 12 {
        return "fn";
    }
    if k == 13 {
        return "mutex";
    }
    if k == 14 {
        return "scope";
    }
    if k == 16 {
        return "task";
    }
    if k == 25 {
        return "cfn";
    }
    if k == 26 {
        return "cptr";
    }
    if k == 34 {
        return "ptr";
    }
    if k == 27 {
        return "slice";
    }
    if k == 29 {
        return "job";
    }
    return "unknown";
}
// A nominal type (or environment record) by name: an importer rebuilds it through its own decl
// table, so the numeric index a store uses never crosses the file.
fn iface_decl_ref<a, b>(out: (&a mut u8[]), c: (&b mut C), decl: u64) -> unit {
    d := &c.decls[decl];
    m := d.module.copy();
    n := d.name.copy();
    if same(view(m), view(".closure")) {
        local := iface_env_name(&mut c, decl);
        iface_ref(&mut out, view(".closure"), view(local));
        return ();
    }
    iface_ref(&mut out, view(m), view(n));
    return ();
}
fn iface_interface_ref<a, b>(out: (&a mut u8[]), c: (&b mut C), id: u64) -> unit {
    item := &c.interfaces[id - 1];
    iface_ref(&mut out, view(item.module), view(item.name));
    return ();
}
// The name an environment record is given inside the file being written (`.closure::env1`), and the
// list of records the file therefore has to carry.
fn iface_env_name<a>(c: (&a mut C), decl: u64) -> u8[] {
    for i in c.iface_env.len() {
        if c.iface_env[i] == decl {
            return c.iface_env_names[i].copy();
        }
    }
    mut name = u8[];
    push_bytes(&mut name, view("env"));
    decimal(&mut name, c.iface_env.len() + 1);
    c.iface_env.push(decl);
    c.iface_env_names.push(name.copy());
    return name;
}

// ---- writing an interface ----
fn iface_line<a, b>(out: (&a mut u8[]), key: &a [u8], value: &b [u8]) -> unit {
    push_bytes(&mut out, view(key));
    out.push(32);
    push_bytes(&mut out, view(value));
    out.push(10);
    return ();
}
fn iface_key<a, b>(out: (&a mut u8[]), key: &a [u8], n: u64) -> unit {
    push_bytes(&mut out, view(key));
    out.push(32);
    decimal(&mut out, n);
    out.push(10);
    return ();
}
fn iface_target_word(target: u64, plat: u64) -> string {
    if plat != 0 {
        if target == 0 {
            return "macos-x86_64";
        }
        return "macos-aarch64";
    }
    if target == 1 {
        return "aarch64";
    }
    if target == 2 {
        return "riscv64";
    }
    if target == 3 {
        return "windows-x86_64";
    }
    if target == 4 {
        return "windows-aarch64";
    }
    return "x86_64";
}
// Declarations of one module, in name order. Declarations the compiler synthesises for itself
// (`.union`, `.result`, `.closure`, `.impl_N`, `.inherent_N`, `.interface_N`) never reach a file
// under their own module name; the two that an importer can name - environment records and
// inherent/interface methods - travel attached to the declaration they belong to.
fn iface_decl_ids<a, b>(c: (&a mut C), m: &b [u8]) -> u64[] {
    mut ids = u64[];
    for i in c.decls.len() {
        if same(view(c.decls[i].module), view(m)) {
            ids.push(i);
        }
    }
    return ids;
}
fn iface_func_ids<a, b>(c: (&a mut C), m: &b [u8]) -> u64[] {
    mut ids = u64[];
    for i in c.funcs.len() {
        if same(view(c.funcs[i].module), view(m)) {
            ids.push(i);
        }
    }
    return ids;
}
fn iface_sort_ids<a, b>(names: (&a u8[][]), ids: (&b u64[])) -> u64[] {
    order := iface_sorted(&names);
    mut out = u64[];
    for i in order.len() {
        out.push(ids[order[i]]);
    }
    return out;
}
fn iface_names_of_decls<a, b>(c: (&a mut C), ids: (&b u64[])) -> u8[][] {
    mut names = u8[][];
    for i in ids.len() {
        names.push(c.decls[ids[i]].name.copy());
    }
    return names;
}
fn iface_names_of_funcs<a, b>(c: (&a mut C), ids: (&b u64[])) -> u8[][] {
    mut names = u8[][];
    for i in ids.len() {
        names.push(c.funcs[ids[i]].name.copy());
    }
    return names;
}
// The parameter types of a function, in order.
fn iface_params<a>(c: (&a mut C), index: u64) -> u64[] {
    f := &c.funcs[index];
    mut out = u64[];
    for i in f.count {
        out.push(c.params[f.first + i]);
    }
    return out;
}
// `fn NAME <N> (T, T) -> T` plus the flags a caller needs. Per-parameter bounds, interface
// requirements and a generic template's body marker follow on their own lines, so they cost a
// line only when they exist.
fn iface_emit_func<a, b>(c: (&a mut C), out: (&a mut u8[]), index: u64, m: &b [u8], named: u64) -> unit {
    name := c.funcs[index].name.copy();
    ret := c.funcs[index].ret;
    types := c.funcs[index].types;
    lifetimes := c.funcs[index].regions;
    ext := c.funcs[index].ext;
    contract := c.funcs[index].contract;
    symbol := c.funcs[index].symbol.copy();
    contract := c.funcs[index].contract;
    mut own = copy_numbers(&c.funcs[index].bounds);
    mut reqs = u64[][];
    for i in c.funcs[index].constraints.len() {
        reqs.push(copy_numbers(&c.funcs[index].constraints[i]));
    }
    params := iface_params(&mut c, index);
    push_bytes(&mut out, view("fn "));
    if named != 0 {
        iface_ref(&mut out, view(m), view(name));
    } else {
        push_bytes(&mut out, view(name));
    }
    if types != 0 {
        push_bytes(&mut out, view(" <"));
        decimal(&mut out, types);
        push_bytes(&mut out, view(">"));
    }
    push_bytes(&mut out, view(" ("));
    for i in params.len() {
        if i != 0 {
            push_bytes(&mut out, view(", "));
        }
        iface_type(&mut out, &mut c, params[i]);
    }
    push_bytes(&mut out, view(") -> "));
    iface_type(&mut out, &mut c, ret);
    if ext != 0 {
        push_bytes(&mut out, view(" extern="));
        decimal(&mut out, ext);
        push_bytes(&mut out, view(" symbol="));
        push_bytes(&mut out, view(symbol));
    }
    out.push(10);
    if lifetimes != 0 {
        push_bytes(&mut out, view("lifetimes "));
        decimal(&mut out, lifetimes);
        out.push(10);
    }
    // `@strict` travels with the declaration too: a caller that instantiates this template gets the
    // mode the module that wrote it asked for.
    if c.funcs[index].strict != 0 {
        push_bytes(&mut out, view("strict 1"));
        out.push(10);
    }
    for i in own.len() {
        if own[i] != 0 {
            push_bytes(&mut out, view("bound "));
            decimal(&mut out, i);
            out.push(32);
            decimal(&mut out, own[i]);
            out.push(10);
        }
    }
    for i in reqs.len() {
        for j in reqs[i].len() {
            push_bytes(&mut out, view("require "));
            decimal(&mut out, i);
            out.push(32);
            iface_interface_ref(&mut out, &mut c, reqs[i][j]);
            out.push(10);
        }
    }
    // The refinements travel with the declaration: a caller in another module owes exactly the
    // predicates this module's own callers owe, checked by the same code.
    for i in c.funcs[index].ppreds.len() {
        mut pf = 0;
        mut plo = 0;
        mut phi = 0;
        if i < c.funcs[index].ppreds.len() {
            pp := &c.funcs[index].ppreds[i];
            pf = pp.file;
            plo = pp.lo;
            phi = pp.hi;
        }
        if phi == 0 {
            continue;
        }
        text := pred_text(&mut c, Pred { file: pf, lo: plo, hi: phi });
        push_bytes(&mut out, view("where "));
        decimal(&mut out, i);
        out.push(32);
        iface_quoted(&mut out, view(text));
        out.push(10);
        // The parameter's own name: a proof at a call site substitutes the arguments for it.
        if i < c.funcs[index].pnames.len() {
            pname := c.funcs[index].pnames[i].copy();
            if pname.len() != 0 {
                push_bytes(&mut out, view("pname "));
                decimal(&mut out, i);
                out.push(32);
                iface_quoted(&mut out, view(pname));
                out.push(10);
            }
        }
    }
    mut rpf = 0;
    mut rplo = 0;
    mut rphi = 0;
    rp := &c.funcs[index].rpred;
    rpf = rp.file;
    rplo = rp.lo;
    rphi = rp.hi;
    if rphi != 0 {
        text := pred_text(&mut c, Pred { file: rpf, lo: rplo, hi: rphi });
        push_bytes(&mut out, view("ensures "));
        iface_quoted(&mut out, view(text));
        out.push(10);
    }
    // The checked effects and `@strict`: an importer's proofs rely on the definition's own claims.
    fa := c.funcs[index].no_alloc;
    fp := c.funcs[index].no_panic;
    fs := c.funcs[index].strict;
    if (fa != 0) || (fp != 0) || (fs != 0) {
        push_bytes(&mut out, view("effects "));
        decimal(&mut out, fa);
        out.push(32);
        decimal(&mut out, fp);
        out.push(32);
        decimal(&mut out, fs);
        out.push(10);
    }
    if (types != 0) & (contract == 0) {
        // A generic template's body travels with the interface: without it a module that
        // instantiates the template cannot be compiled unless this module's source is on the
        // command line, which is what separate compilation has to remove. One quoted line per
        // source line, so a changed statement is a changed line in a review diff. An interface
        // method carries no body, and its one implicit type parameter is not a template.
        body := c.funcs[index].body.copy();
        if body.len() == 0 {
            // The declaration pass captures every template's text. A template without one is a
            // compiler bug, not a silent gap: an importer could not instantiate it.
            push_bytes(&mut out, view("body 0"));
            out.push(10);
            return ();
        }
        rows := iface_lines(&body);
        push_bytes(&mut out, view("body "));
        decimal(&mut out, rows.len());
        out.push(10);
        for i in rows.len() {
            push_bytes(&mut out, view("line "));
            iface_quoted(&mut out, view(rows[i]));
            out.push(10);
        }
    }
    return ();
}

// One type of a module: kind, type and lifetime parameter counts, the audited handle contract, and
// its fields or variants in declaration order.
fn iface_emit_decl<a, b>(c: (&a mut C), out: (&a mut u8[]), index: u64, m: &b [u8]) -> unit {
    name := c.decls[index].name.copy();
    is_enum := c.decls[index].is_enum;
    opaque := c.decls[index].opaque;
    transfer := c.decls[index].transfer;
    share := c.decls[index].share;
    c_layout := c.decls[index].c_layout;
    params := c.decls[index].types;
    lifetimes := c.decls[index].regions;
    first := c.decls[index].first;
    count := c.decls[index].count;
    mut own = copy_numbers(&c.decls[index].bounds);
    mut reqs = u64[][];
    for i in c.decls[index].constraints.len() {
        reqs.push(copy_numbers(&c.decls[index].constraints[i]));
    }
    push_bytes(&mut out, view("type "));
    iface_ref(&mut out, view(m), view(name));
    if opaque != 0 {
        push_bytes(&mut out, view(" handle"));
    } else {
        if is_enum != 0 {
            push_bytes(&mut out, view(" enum"));
        } else {
            if c_layout != 0 {
                push_bytes(&mut out, view(" record"));
            } else {
                push_bytes(&mut out, view(" struct"));
            }
        }
    }
    push_bytes(&mut out, view(" params="));
    decimal(&mut out, params);
    push_bytes(&mut out, view(" lifetimes="));
    decimal(&mut out, lifetimes);
    if opaque != 0 {
        // The audited foreign-resource contract: an importer must not re-derive default-deny for a
        // handle another module has already audited.
        push_bytes(&mut out, view(" transfer="));
        decimal(&mut out, transfer);
        push_bytes(&mut out, view(" share="));
        decimal(&mut out, share);
    }
    out.push(10);
    for i in own.len() {
        if own[i] != 0 {
            push_bytes(&mut out, view("bound "));
            decimal(&mut out, i);
            out.push(32);
            decimal(&mut out, own[i]);
            out.push(10);
        }
    }
    for i in reqs.len() {
        for j in reqs[i].len() {
            push_bytes(&mut out, view("require "));
            decimal(&mut out, i);
            out.push(32);
            iface_interface_ref(&mut out, &mut c, reqs[i][j]);
            out.push(10);
        }
    }
    for i in count {
        field := c.fields[first + i].name.copy();
        ty := c.fields[first + i].ty;
        if is_enum != 0 {
            push_bytes(&mut out, view("variant "));
        } else {
            push_bytes(&mut out, view("field "));
        }
        push_bytes(&mut out, view(field));
        out.push(32);
        iface_type(&mut out, &mut c, ty);
        out.push(10);
        // A field's refinement travels with it, so a construction in another module owes it.
        mut fpf = 0;
        mut fplo = 0;
        mut fphi = 0;
        if first + i < c.fields.len() {
            fp := &c.fields[first + i].pred;
            fpf = fp.file;
            fplo = fp.lo;
            fphi = fp.hi;
        }
        if fphi != 0 {
            text := pred_text(&mut c, Pred { file: fpf, lo: fplo, hi: fphi });
            push_bytes(&mut out, view("fwhere "));
            iface_quoted(&mut out, view(field));
            out.push(32);
            iface_quoted(&mut out, view(text));
            out.push(10);
        }
    }
    return ();
}

// An `impl<T> Foo<T>` carries its own parameters: an importer replays its generic methods, and those
// names and bounds are what the replayed body is checked against.
fn iface_emit_impl_params<a>(c: (&a mut C), out: (&a mut u8[]), owner: u64) -> unit {
    record := impl_record(&mut c, owner);
    if record == 0 {
        return ();
    }
    p := &c.impl_params[record - 1];
    lifetimes := p.rnames.len();
    params := p.tnames.len();
    if lifetimes == 0 && params == 0 {
        return ();
    }
    mut rnames = u8[][];
    for i in lifetimes {
        rnames.push(p.rnames[i].copy());
    }
    mut tnames = u8[][];
    for i in params {
        tnames.push(p.tnames[i].copy());
    }
    mut bounds = copy_numbers(&p.bounds);
    mut requirements = u64[][];
    for i in p.interfaces.len() {
        requirements.push(copy_numbers(&p.interfaces[i]));
    }
    push_bytes(&mut out, view(" params="));
    decimal(&mut out, params);
    push_bytes(&mut out, view(" lifetimes="));
    decimal(&mut out, lifetimes);
    out.push(10);
    for i in rnames.len() {
        push_bytes(&mut out, view("rname "));
        decimal(&mut out, i);
        out.push(32);
        push_bytes(&mut out, view(rnames[i]));
        out.push(10);
    }
    for i in tnames.len() {
        push_bytes(&mut out, view("ptype "));
        decimal(&mut out, i);
        out.push(32);
        push_bytes(&mut out, view(tnames[i]));
        out.push(10);
    }
    for i in bounds.len() {
        if bounds[i] != 0 {
            push_bytes(&mut out, view("bound "));
            decimal(&mut out, i);
            out.push(32);
            decimal(&mut out, bounds[i]);
            out.push(10);
        }
    }
    for i in requirements.len() {
        for j in requirements[i].len() {
            push_bytes(&mut out, view("require "));
            decimal(&mut out, i);
            out.push(32);
            iface_interface_ref(&mut out, &mut c, requirements[i][j]);
            out.push(10);
        }
    }
    return ();
}
// An environment record: the captured fields of a closure type, under a name local to this file.
fn iface_emit_env<a>(c: (&a mut C), out: (&a mut u8[]), decl: u64, local: &a [u8]) -> unit {
    first := c.decls[decl].first;
    count := c.decls[decl].count;
    push_bytes(&mut out, view("env "));
    push_bytes(&mut out, view(local));
    out.push(10);
    for i in count {
        field := c.fields[first + i].name.copy();
        ty := c.fields[first + i].ty;
        push_bytes(&mut out, view("field "));
        push_bytes(&mut out, view(field));
        out.push(32);
        iface_type(&mut out, &mut c, ty);
        out.push(10);
    }
    return ();
}
fn iface_emit_alias<a, b>(c: (&a mut C), out: (&a mut u8[]), index: u64) -> unit {
    a := c.aliases[index];
    module := a.module.copy();
    name := a.name.copy();
    ty := a.ty;
    if ty == NO_TYPE {
        iface_refuse(view("<interface>"), view("an unresolved type alias cannot be written to an interface"));
    }
    push_bytes(&mut out, view("alias "));
    iface_ref(&mut out, view(module), view(name));
    out.push(32);
    iface_type(&mut out, &mut c, ty);
    out.push(10);
    return ();
}
fn iface_emit_const<a, b>(c: (&a mut C), out: (&a mut u8[]), index: u64, m: &b [u8]) -> unit {
    module := c.constants[index].module.copy();
    name := c.constants[index].name.copy();
    ty := c.constants[index].ty;
    value := c.constants[index].value;
    text := c.constants[index].text.copy();
    push_bytes(&mut out, view("const "));
    iface_ref(&mut out, view(module), view(name));
    out.push(32);
    iface_type(&mut out, &mut c, ty);
    if (ty != 3) && (ty != 0) && (ct_seq_elem(&mut c, ty) != NO_TYPE) {
        push_bytes(&mut out, view(" seq "));
        decimal(&mut out, value);
        out.push(32);
        hex := iface_hex(&text);
        iface_quoted(&mut out, view(hex));
    } else if ty == 3 {
        push_bytes(&mut out, view(" str "));
        hex := iface_hex(&text);
        iface_quoted(&mut out, view(hex));
    } else {
        push_bytes(&mut out, view(" int "));
        decimal(&mut out, value);
    }
    out.push(10);
    return ();
}

// ---- reading an interface ----
//
// An interface is checked, not trusted: the format version, the module, the compiler modes, the
// source digest, the file's own digest and (through `interfaces.manifest`) the bytes that were
// written are all verified before a single declaration is installed. A refusal always names the
// module and what differs.
struct IPos {
    text: u8[],
    toks: Tok[],
    at: u64,
    path: u8[],
    line: u64
}
fn iface_refuse<a, b>(path: &a [u8], msg: &b [u8]) -> unit {
    host::print(view("grail: "));
    host::print(view(path));
    host::print(view(": "));
    host::print(view(msg));
    host::print(view("\n"));
    host::exit(1);
    return ();
}
fn iface_fail<a, b>(p: (&a IPos), msg: &b [u8]) -> unit {
    mut out = u8[];
    push_bytes(&mut out, view("grail: "));
    push_bytes(&mut out, view(p.path));
    out.push(58);
    decimal(&mut out, p.line);
    push_bytes(&mut out, view(": "));
    push_bytes(&mut out, view(msg));
    if p.text.len() != 0 {
        // The line the reader choked on, so a malformed interface is one message away from a fix.
        push_bytes(&mut out, view(" in `"));
        push_bytes(&mut out, view(iface_clip(view(p.text))));
        push_bytes(&mut out, view("`"));
    }
    out.push(10);
    host::print(view(out));
    host::exit(1);
    return ();
}
fn iface_lines<a>(text: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut start = 0;
    mut i = 0;
    while i <= text.len() {
        mut cut = 0;
        if i == text.len() {
            cut = 1;
        } else {
            if text[i] == 10 {
                cut = 1;
            }
        }
        if cut != 0 {
            mut line = u8[];
            for j in i - start {
                line.push(text[start + j]);
            }
            out.push(line);
            start = i + 1;
        }
        i += 1;
    }
    return out;
}
fn iface_tokens<a>(text: &a [u8]) -> Tok[] {
    lexed := lexer::tokenize(view(text));
    mut toks = Tok[];
    for i in lexed.len() {
        t := &lexed[i];
        toks.push(Tok { kind: t.kind, start: t.start, end: t.end });
    }
    return toks;
}
fn ip_kind<a>(p: (&a IPos)) -> u64 {
    return p.toks[p.at].kind;
}
fn ip_txt<a>(p: (&a IPos)) -> u8[] {
    t := &p.toks[p.at];
    mut out = u8[];
    for i in t.end - t.start {
        out.push(p.text[t.start + i]);
    }
    return out;
}
fn ip_done<a>(p: (&a IPos)) -> bool {
    return ip_kind(&p) == 0;
}
fn ip_take<a>(p: (&a mut IPos)) -> u8[] {
    t := ip_txt(&p);
    at := p.at + 1;
    exchange(&mut p.at, at);
    return t;
}
fn ip_word<a>(p: (&a mut IPos)) -> u8[] {
    if ip_kind(&p) != 1 {
        iface_fail(&p, view("expected a name"));
    }
    return ip_take(&mut p);
}
fn iface_decimal<a>(text: &a [u8]) -> u64 {
    mut n = 0;
    for i in text.len() {
        n = n * 10 + (text[i] - 48);
    }
    return n;
}
fn ip_number<a>(p: (&a mut IPos)) -> u64 {
    if ip_kind(&p) != 2 {
        iface_fail(&p, view("expected a number"));
    }
    t := ip_take(&mut p);
    return iface_decimal(&t);
}
// A quoted value: a path, a digest or a link input, taken byte for byte.
fn ip_quoted<a>(p: (&a mut IPos)) -> u8[] {
    if ip_kind(&p) != 3 {
        iface_fail(&p, view("expected a quoted value"));
    }
    t := ip_txt(&p);
    at := p.at + 1;
    exchange(&mut p.at, at);
    mut out = u8[];
    mut i = 1;
    while i + 1 < t.len() {
        b := t[i];
        if b != 92 {
            out.push(b);
            i += 1;
        } else {
            if (i + 1) < (t.len() - 1) {
                e := t[i + 1];
                if e == 92 {
                    out.push(92);
                    i += 2;
                } else if e == 34 {
                    out.push(34);
                    i += 2;
                } else if e == 120 {
                    if (i + 3) < t.len() {
                        hi := ip_hex(t[i + 2]);
                        lo := ip_hex(t[i + 3]);
                        if (hi == 99) || (lo == 99) {
                            iface_fail(&p, view("a hex escape needs two hex digits"));
                        }
                        out.push(hi * 16 + lo);
                        i += 4;
                    } else {
                        iface_fail(&p, view("a hex escape needs two hex digits"));
                    }
                } else {
                    iface_fail(&p, view("unknown escape in a quoted value"));
                }
            } else {
                iface_fail(&p, view("a quoted value ends with a backslash"));
            }
        }
    }
    return out;
}
// One hex digit, or 99 (not a digit) so the caller can refuse.
fn ip_hex(b: u64) -> u64 {
    if (48 <= b) & (b <= 57) {
        return b - 48;
    }
    if (97 <= b) & (b <= 102) {
        return b - 87;
    }
    return 99;
}
fn ip_is<a, b>(p: (&a IPos), word: &b [u8]) -> bool {
    if ip_kind(&p) == 0 {
        return false;
    }
    return same(view(ip_txt(&p)), view(word));
}
fn ip_eat<a, b>(p: (&a mut IPos), word: &b [u8]) -> bool {
    if ip_is(&p, view(word)) {
        at := p.at + 1;
        exchange(&mut p.at, at);
        return true;
    }
    return false;
}
fn ip_expect<a, b>(p: (&a mut IPos), word: &b [u8]) -> unit {
    if !ip_eat(&mut p, view(word)) {
        mut msg = u8[];
        push_bytes(&mut msg, view("expected '"));
        push_bytes(&mut msg, view(word));
        push_bytes(&mut msg, view("'"));
        iface_fail(&p, view(msg));
    }
    return ();
}
fn ip_ident<a>(p: (&a mut IPos)) -> u8[] {
    return ip_word(&mut p);
}
// `module::name`, and `.closure::env1` for an environment record.
fn ip_ref<a>(p: (&a mut IPos)) -> u8[] {
    mut out = u8[];
    if ip_eat(&mut p, view(".")) {
        out.push(46);
    }
    push_bytes(&mut out, view(ip_ident(&mut p)));
    ip_expect(&mut p, view("::"));
    push_bytes(&mut out, view("::"));
    push_bytes(&mut out, view(ip_ident(&mut p)));
    return out;
}
// `module::name` split at the first `::` (a module name may itself begin with `.`: `.closure`).
fn ip_ref_module<a>(ref: &a [u8]) -> u8[] {
    cut := ip_ref_cut(ref);
    mut out = u8[];
    for i in cut {
        out.push(ref[i]);
    }
    return out;
}
fn ip_ref_name<a>(ref: &a [u8]) -> u8[] {
    cut := ip_ref_cut(ref) + 2;
    mut out = u8[];
    mut i = cut;
    while i < ref.len() {
        out.push(ref[i]);
        i += 1;
    }
    return out;
}
fn ip_ref_cut<a>(ref: &a [u8]) -> u64 {
    mut i = 0;
    while i + 1 < ref.len() {
        if (ref[i] == 58) & (ref[i + 1] == 58) {
            return i;
        }
        i += 1;
    }
    return ref.len();
}
fn ip_regions<a>(p: (&a mut IPos)) -> u64[] {
    mut rs = u64[];
    if !ip_eat(&mut p, view("[")) {
        return rs;
    }
    while !ip_eat(&mut p, view("]")) {
        rs.push(ip_number(&mut p));
        ip_eat(&mut p, view(","));
    }
    return rs;
}
// The optional `MODE` and `[REGIONS]` every composite spelling accepts.
fn ip_mode<a>(p: (&a mut IPos)) -> u64 {
    if ip_kind(&p) == 2 {
        return ip_number(&mut p);
    }
    return 0;
}
fn ip_type_list<a>(c: (&a mut C), p: (&a mut IPos)) -> u64[] {
    mut out = u64[];
    ip_expect(&mut p, view("("));
    if ip_eat(&mut p, view(")")) {
        return out;
    }
    while true {
        out.push(iface_parse_type(&mut c, &mut p));
        if ip_eat(&mut p, view(")")) {
            break;
        }
        ip_expect(&mut p, view(","));
    }
    return out;
}
fn iface_find_decl<a, b, d, e>(c: (&a mut C), p: (&b mut IPos), module: &d [u8], name: &e [u8]) -> u64 {
    d := find_decl_internal(&mut c, view(module), view(name));
    if d == 0 {
        mut msg = u8[];
        push_bytes(&mut msg, view("names a type this program does not declare: "));
        push_bytes(&mut msg, view(module));
        push_bytes(&mut msg, view("::"));
        push_bytes(&mut msg, view(name));
        iface_fail(&p, view(msg));
    }
    return d - 1;
}
// A type, rebuilt exactly: the reader interns through the same constructors the source parser uses,
// so two spellings of one type denote one interned type and one type has one spelling.
fn iface_parse_type<a>(c: (&a mut C), p: (&a mut IPos)) -> u64 {
    if !ip_eat(&mut p, view("(")) {
        word := ip_word(&mut p);
        if ip_eat(&mut p, view("::")) {
            name := ip_word(&mut p);
            decl := iface_find_decl(&mut c, &mut p, view(word), view(name));
            return intern_args(&mut c, 8, decl, 0, u64[], u64[]);
        }
        k := iface_word_kind(view(word));
        if k == 0 {
            mut msg = u8[];
            push_bytes(&mut msg, view("unknown type word: "));
            push_bytes(&mut msg, view(word));
            iface_fail(&p, view(msg));
        }
        return intern_args(&mut c, k, iface_word_arg(view(word), k), 0, u64[], u64[]);
    }
    {
        head := ip_word(&mut p);
        if same(view(head), view("int")) {
            bits := ip_number(&mut p);
            sign := ip_word(&mut p);
            ip_expect(&mut p, view(")"));
            mut signed = 1;
            if same(view(sign), view("u")) {
                signed = 0;
            }
            return intern_args(&mut c, 18, bits, signed, u64[], u64[]);
        }
        if same(view(head), view("tparam")) {
            n := ip_number(&mut p);
            bounds := ip_number(&mut p);
            proofs := ip_regions(&mut p);
            mut args = u64[];
            while !ip_eat(&mut p, view(")")) {
                args.push(iface_parse_type(&mut c, &mut p));
            }
            return intern_args(&mut c, 9, n, bounds, proofs, args);
        }
        if same(view(head), view("outcomefail")) {
            ip_expect(&mut p, view(")"));
            return task_failure_type(&mut c);
        }
        if same(view(head), view("union")) || same(view(head), view("result"))
            || same(view(head), view("outcome")) {
            // `T?` / `T | E`: the member list is the whole type, and the compiler rebuilds the
            // declaration it synthesises for that member count.
            success := ip_number(&mut p);
            members := ip_type_list(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            if same(view(head), view("union")) {
                return make_union(&mut c, members, success, copy_bytes(view(".union")), view("Union"));
            }
            if same(view(head), view("outcome")) {
                return make_union(&mut c, members, success, copy_bytes(view(".outcome")), view("Outcome"));
            }
            return make_union(&mut c, members, success, copy_bytes(view(".result")), view("Result"));
        }
        mode := ip_mode(&mut p);
        rs := ip_regions(&mut p);
        if same(view(head), view("named")) {
            // `(named module::Name [mode] [regions] type...)`: the reference comes first, so a
            // declaration's identity is readable before its arguments.
            ref := ip_ref(&mut p);
            module := ip_ref_module(&ref);
            name := ip_ref_name(&ref);
            named_mode := ip_mode(&mut p);
            named_regions := ip_regions(&mut p);
            mut args = u64[];
            while !ip_eat(&mut p, view(")")) {
                args.push(iface_parse_type(&mut c, &mut p));
            }
            if same(view(module), view(".closure")) {
                return iface_env_type(&mut c, &mut p, view(name));
            }
            decl := iface_find_decl(&mut c, &mut p, view(module), view(name));
            return intern_args(&mut c, 8, decl, named_mode, named_regions, args);
        }
        if same(view(head), view("view")) {
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 5, 0, mode, rs, u64[]);
        }
        if same(view(head), view("ref")) {
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 7, t, mode, rs, u64[]);
        }
        if same(view(head), view("bobj")) {
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 35, t, 0, u64[], u64[]);
        }
        if same(view(head), view("vec")) {
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 6, t, mode, rs, u64[]);
        }
        if same(view(head), view("mutex")) {
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 13, t, mode, rs, u64[]);
        }
        if same(view(head), view("scope")) {
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 14, t, mode, rs, u64[]);
        }
        if same(view(head), view("task")) {
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 16, t, mode, rs, u64[]);
        }
        if same(view(head), view("cptr")) {
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 26, t, mode, rs, u64[]);
        }
        if same(view(head), view("ptr")) {
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 34, t, mode, rs, u64[]);
        }
        if same(view(head), view("slice")) {
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 27, t, mode, rs, u64[]);
        }
        if same(view(head), view("const")) {
            // A value parameter's binding: `(const N)`.
            n := ip_number(&mut p);
            ip_expect(&mut p, view(")"));
            return intern(&mut c, 31, n);
        }
        if same(view(head), view("job")) {
            // A pool job handle (`Job<T>`): its result type.
            t := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 29, t, mode, rs, u64[]);
        }
        if same(view(head), view("handle")) || same(view(head), view("byval")) {
            ref := ip_ref(&mut p);
            named_mode := ip_mode(&mut p);
            named_regions := ip_regions(&mut p);
            ip_expect(&mut p, view(")"));
            module := ip_ref_module(&ref);
            name := ip_ref_name(&ref);
            decl := iface_find_decl(&mut c, &mut p, view(module), view(name));
            if same(view(head), view("handle")) {
                return intern_args(&mut c, 23, decl, named_mode, named_regions, u64[]);
            }
            return intern_args(&mut c, 28, decl, named_mode, named_regions, u64[]);
        }
        if same(view(head), view("bound")) {
            t := iface_parse_type(&mut c, &mut p);
            n := ip_number(&mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 10, t, n, u64[], u64[]);
        }
        if same(view(head), view("dyn")) {
            ref := ip_ref(&mut p);
            mut fixed = u64[];
            while !ip_eat(&mut p, view(")")) {
                t := iface_parse_type(&mut c, &mut p);
                fixed.push(t);
            }
            id := find_interface(&c, view(ip_ref_module(&ref)), view(ip_ref_name(&ref)));
            if id == 0 {
                iface_fail(&p, view("names an interface this program does not declare"));
            }
            return intern_args(&mut c, 33, id, 0, u64[], fixed);
        }
        if same(view(head), view("assoc")) {
            t := iface_parse_type(&mut c, &mut p);
            ref := ip_ref(&mut p);
            n := ip_number(&mut p);
            ip_expect(&mut p, view(")"));
            module := ip_ref_module(&ref);
            name := ip_ref_name(&ref);
            id := find_interface(&c, view(module), view(name));
            if id == 0 {
                iface_fail(&p, view("names an interface this program does not declare"));
            }
            return intern_full(&mut c, 30, t, id * 1024 + n, u64[]);
        }
        if same(view(head), view("proof")) {
            ref := ip_ref(&mut p);
            ip_expect(&mut p, view(")"));
            module := ip_ref_module(&ref);
            name := ip_ref_name(&ref);
            id := find_interface(&c, view(module), view(name));
            if id == 0 {
                iface_fail(&p, view("names an interface this program does not declare"));
            }
            return intern_args(&mut c, 15, id, 0, u64[], u64[]);
        }
        if same(view(head), view("fn")) {
            params := ip_type_list(&mut c, &mut p);
            ret := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 12, ret, mode, rs, params);
        }
        if same(view(head), view("cfn")) {
            params := ip_type_list(&mut c, &mut p);
            ret := iface_parse_type(&mut c, &mut p);
            ip_expect(&mut p, view(")"));
            return intern_args(&mut c, 25, ret, mode, rs, params);
        }
        if same(view(head), view("closure")) {
            params := ip_type_list(&mut c, &mut p);
            ret := iface_parse_type(&mut c, &mut p);
            mut env = 0;
            if ip_kind(&p) == 2 {
                ip_number(&mut p);
            } else {
                env = iface_parse_type(&mut c, &mut p);
            }
            ip_expect(&mut p, view(")"));
            return intern_env(&mut c, 20, ret, mode, rs, params, env);
        }
        mut msg = u8[];
        push_bytes(&mut msg, view("unknown type form: "));
        push_bytes(&mut msg, view(head));
        iface_fail(&p, view(msg));
        return 0;
    }
}
fn iface_word_arg<a>(word: &a [u8], k: u64) -> u64 {
    // The two floats share a kind and differ in the argument that records their width.
    if (k == 21) & same(view(word), view("f32")) {
        return 32;
    }
    return 0;
}
fn iface_word_kind<a>(word: &a [u8]) -> u64 {
    if same(view(word), view("u64")) {
        return 1;
    }
    if same(view(word), view("unit")) {
        return 2;
    }
    if same(view(word), view("bytes")) {
        return 3;
    }
    if same(view(word), view("string")) {
        return 4;
    }
    if same(view(word), view("view")) {
        return 5;
    }
    if same(view(word), view("atomic")) {
        return 11;
    }
    if same(view(word), view("cancel")) {
        return 17;
    }
    if same(view(word), view("bool")) {
        return 19;
    }
    if same(view(word), view("f64")) || same(view(word), view("f32")) {
        return 21;
    }
    if same(view(word), view("char")) {
        return 22;
    }
    if same(view(word), view("cstr")) {
        return 24;
    }
    return 0;
}

// ---- one module's interface text ----
fn iface_join<a, b, d>(dir: &a [u8], name: &b [u8], ext: &d [u8]) -> u8[] {
    mut out = u8[];
    push_bytes(&mut out, view(dir));
    out.push(47);
    push_bytes(&mut out, view(name));
    push_bytes(&mut out, view(ext));
    return out;
}
fn iface_has_body<a, b>(c: (&a mut C), m: &b [u8]) -> u64 {
    for i in c.funcs.len() {
        if same(view(c.funcs[i].module), view(m)) & (c.funcs[i].types != 0) & (c.funcs[i].contract == 0) {
            return 1;
        }
    }
    return 0;
}
// The interface of one module, as text. Everything an importer needs to check a call to it and
// nothing a body would carry; the header states where it came from and the digest covers the file.
fn iface_span<a>(spans: (&a mut u64[]), start: u64, end: u64, kind: u64, index: u64, public: u64, owner: u64) -> unit {
    spans.push(start);
    spans.push(end);
    spans.push(kind);
    spans.push(index);
    spans.push(public);
    spans.push(owner);
    return ();
}
// The name an interface item is found by: what a kept span's text has to mention for a private item
// to be needed.
fn iface_span_name<a, b>(c: (&a mut C), spans: (&b u64[]), k: u64) -> u8[] {
    kind := spans[k * 6 + 2];
    index := spans[k * 6 + 3];
    if kind == 1 {
        return c.decls[index].name.copy();
    }
    if kind == 2 {
        return c.aliases[index].name.copy();
    }
    if kind == 3 {
        return c.constants[index].name.copy();
    }
    if (kind == 4) || (kind == 6) {
        return c.funcs[index].name.copy();
    }
    if kind == 7 {
        return c.interfaces[index].name.copy();
    }
    return u8[];
}
// True when `name` occurs in `text` as a whole identifier.
fn iface_mentions<a, b>(text: &a [u8], name: &b [u8]) -> bool {
    if name.len() == 0 {
        return false;
    }
    mut i = 0;
    while i + name.len() <= text.len() {
        mut hit = true;
        for j in name.len() {
            if text[i + j] != name[j] {
                hit = false;
                break;
            }
        }
        if hit {
            before_ok := (i == 0) || !ident_byte(text[i - 1]);
            after := i + name.len();
            after_ok := (after == text.len()) || !ident_byte(text[after]);
            if before_ok & after_ok {
                return true;
            }
        }
        i += 1;
    }
    return false;
}
fn ident_byte(b: u8) -> bool {
    return ((97 <= b) & (b <= 122)) || ((65 <= b) & (b <= 90)) || ((48 <= b) & (b <= 57)) || (b == 95);
}
// The public surface (separate-compilation.md, "Visibility"): every `pub` item, every implementation
// and closure environment, and the private items that text mentions - a public template's body that
// calls a private helper, a signature that names a private type - to a fixpoint. A carried private
// item gets a `private` line, so an importer can compile the template but cannot name the item.
fn iface_select<a, b, d>(c: (&a mut C), out: (&b u8[]), header_end: u64, spans: (&d u64[])) -> u8[] {
    n := spans.len() / 6;
    mut keep = u64[];
    for k in n {
        keep.push(spans[k * 6 + 4]);
    }
    mut changed = true;
    while changed {
        changed = false;
        mut kept = u8[];
        for k in n {
            if (keep[k] != 0) & (spans[k * 6 + 2] != 5) {
                for b in spans[k * 6]..spans[k * 6 + 1] {
                    kept.push(out[b]);
                }
            }
        }
        for k in n {
            if (keep[k] == 0) & (spans[k * 6 + 2] != 5) {
                name := iface_span_name(&mut c, spans, k);
                if iface_mentions(view(kept), view(name)) {
                    exchange(&mut keep[k], 1);
                    changed = true;
                }
            }
        }
    }
    // An `inherent` header is written when a method under it is.
    for k in n {
        if spans[k * 6 + 2] == 5 {
            mut any = 0;
            for j in n {
                if (spans[j * 6 + 2] == 6) & (spans[j * 6 + 5] == spans[k * 6 + 5]) & (keep[j] != 0) {
                    any = 1;
                }
            }
            exchange(&mut keep[k], any);
        }
    }
    mut text = u8[];
    for b in header_end {
        text.push(out[b]);
    }
    for k in n {
        if keep[k] != 0 {
            for b in spans[k * 6]..spans[k * 6 + 1] {
                text.push(out[b]);
            }
        }
    }
    for k in n {
        kind := spans[k * 6 + 2];
        if (keep[k] != 0) & (spans[k * 6 + 4] == 0) & (kind != 5) & (kind != 8) & (kind != 9) {
            push_bytes(&mut text, view("private "));
            if kind == 1 {
                push_bytes(&mut text, view("type "));
            }
            if kind == 2 {
                push_bytes(&mut text, view("alias "));
            }
            if kind == 3 {
                push_bytes(&mut text, view("const "));
            }
            if kind == 4 {
                push_bytes(&mut text, view("fn "));
            }
            if kind == 6 {
                push_bytes(&mut text, view("method "));
                owner := spans[k * 6 + 5];
                push_bytes(&mut text, view(c.decls[owner].name));
                text.push(32);
            }
            if kind == 7 {
                push_bytes(&mut text, view("interface "));
            }
            push_bytes(&mut text, view(iface_span_name(&mut c, spans, k)));
            text.push(10);
        }
    }
    return text;
}
fn iface_module_text<a, b, d>(c: (&a mut C), m: &b [u8], path: &d [u8], in_std: u64, unsafe_flag: u64, host_opt: u64) -> u8[] {
    exchange(&mut c.iface_env, u64[]);
    exchange(&mut c.iface_env_names, u8[][]);
    mut out = u8[];
    push_bytes(&mut out, view("// grail-interface 3\n"));
    iface_line(&mut out, view("module"), view(m));
    push_bytes(&mut out, view("source "));
    iface_quoted(&mut out, view(path));
    out.push(10);
    source := host::read_file(view(path));
    if source.len() == 0 {
        iface_refuse(view(path), view("cannot read the source this interface describes"));
    }
    digest := iface_digest(&source);
    push_bytes(&mut out, view("sha256 "));
    iface_quoted(&mut out, view(digest));
    out.push(10);
    // Typed references and the u64 default are the language's only modes, so these two words are
    // constants in the stamp: their job is to refuse an interface written by a compiler that still
    // had the legacy dialect or the i64 literal default, not to describe a choice this one makes.
    push_bytes(&mut out, view("mode typed_refs=1 default_u64=1"));
    push_bytes(&mut out, view(" overflow="));
    if c.overflow == 0 {
        push_bytes(&mut out, view("wrap"));
    } else {
        push_bytes(&mut out, view("checked"));
    }
    push_bytes(&mut out, view(" target="));
    push_bytes(&mut out, view(iface_target_word(c.target, c.plat)));
    out.push(10);
    iface_key(&mut out, view("unsafe"), unsafe_flag);
    iface_key(&mut out, view("std"), in_std);
    iface_key(&mut out, view("host"), host_opt);
    iface_key(&mut out, view("templates"), iface_has_body(&mut c, view(m)));
    for i in c.libs.len() {
        if same(view(c.lib_owner[i]), view(m)) {
            push_bytes(&mut out, view("link "));
            iface_quoted(&mut out, view(c.libs[i]));
            out.push(10);
        }
    }
    // Every item below is written as a span of `out`; the spans are then filtered to the public
    // surface (iface_select). spans: start, end, kind, index, public, owner decl.
    header_end := out.len();
    mut spans = u64[];
    // Nominal types, then aliases, then constants: a declaration an importer can name, with its
    // structure in declaration order.
    decls := iface_decl_ids(&mut c, view(m));
    names := iface_names_of_decls(&mut c, &decls);
    for i in iface_sort_ids(&names, &decls).len() {
        index := iface_sort_ids(&names, &decls)[i];
        start := out.len();
        iface_emit_decl(&mut c, &mut out, index, view(m));
        visible := c.decls[index].public;
        iface_span(&mut spans, start, out.len(), 1, index, visible, 0);
    }
    mut picks = u64[];
    mut pick_names = u8[][];
    for i in c.aliases.len() {
        if same(view(c.aliases[i].module), view(m)) {
            picks.push(i);
            pick_names.push(c.aliases[i].name.copy());
        }
    }
    for i in iface_sort_ids(&pick_names, &picks).len() {
        index := iface_sort_ids(&pick_names, &picks)[i];
        start := out.len();
        iface_emit_alias(&mut c, &mut out, index);
        visible := c.aliases[index].public;
        iface_span(&mut spans, start, out.len(), 2, index, visible, 0);
    }
    mut consts = u64[];
    mut const_names = u8[][];
    for i in c.constants.len() {
        if same(view(c.constants[i].module), view(m)) {
            consts.push(i);
            const_names.push(c.constants[i].name.copy());
        }
    }
    for i in iface_sort_ids(&const_names, &consts).len() {
        index := iface_sort_ids(&const_names, &consts)[i];
        start := out.len();
        iface_emit_const(&mut c, &mut out, index, view(m));
        visible := c.constants[index].public;
        iface_span(&mut spans, start, out.len(), 3, index, visible, 0);
    }
    // Module-level functions.
    funcs := iface_func_ids(&mut c, view(m));
    fnames := iface_names_of_funcs(&mut c, &funcs);
    for i in iface_sort_ids(&fnames, &funcs).len() {
        index := iface_sort_ids(&fnames, &funcs)[i];
        start := out.len();
        iface_emit_func(&mut c, &mut out, index, view(m), 1);
        visible := c.funcs[index].public;
        iface_span(&mut spans, start, out.len(), 4, index, visible, 0);
    }
    // Inherent methods, attached to the type that owns them.
    for i in iface_sort_ids(&names, &decls).len() {
        index := iface_sort_ids(&names, &decls)[i];
        owner := private_module(view(".inherent_"), index);
        methods := iface_func_ids(&mut c, view(owner));
        if methods.len() == 0 {
            continue;
        }
        head := out.len();
        push_bytes(&mut out, view("inherent "));
        iface_decl_ref(&mut out, &mut c, index);
        iface_emit_impl_params(&mut c, &mut out, index + 1);
        out.push(10);
        iface_span(&mut spans, head, out.len(), 5, index, 0, index);
        mnames := iface_names_of_funcs(&mut c, &methods);
        for j in iface_sort_ids(&mnames, &methods).len() {
            method := iface_sort_ids(&mnames, &methods)[j];
            start := out.len();
            iface_emit_func(&mut c, &mut out, method, view(owner), 0);
            visible := c.funcs[method].public;
            iface_span(&mut spans, start, out.len(), 6, method, visible, index);
        }
    }
    // Interface declarations and their methods.
    mut ifaces = u64[];
    mut iface_names = u8[][];
    for i in c.interfaces.len() {
        if same(view(c.interfaces[i].module), view(m)) {
            ifaces.push(i);
            iface_names.push(c.interfaces[i].name.copy());
        }
    }
    for i in iface_sort_ids(&iface_names, &ifaces).len() {
        index := iface_sort_ids(&iface_names, &ifaces)[i];
        start := out.len();
        push_bytes(&mut out, view("interface "));
        iface_interface_ref(&mut out, &mut c, index + 1);
        out.push(10);
        // The interfaces it extends.
        supers := copy_numbers(&c.interfaces[index].supers);
        for j in supers.len() {
            push_bytes(&mut out, view("super "));
            iface_interface_ref(&mut out, &mut c, supers[j]);
            out.push(10);
        }
        // Associated types in declaration order: a projection names one by index.
        assoc := copy_names(&c.interfaces[index].assoc);
        for j in assoc.len() {
            push_bytes(&mut out, view("assoc "));
            push_bytes(&mut out, view(assoc[j]));
            out.push(10);
        }
        owner := private_module(view(".interface_"), index + 1);
        methods := iface_func_ids(&mut c, view(owner));
        mnames := iface_names_of_funcs(&mut c, &methods);
        for j in iface_sort_ids(&mnames, &methods).len() {
            iface_emit_func(&mut c, &mut out, iface_sort_ids(&mnames, &methods)[j], view(owner), 0);
        }
        visible := c.interfaces[index].public;
        iface_span(&mut spans, start, out.len(), 7, index, visible, 0);
    }
    // Interface implementations owned by this module.
    mut impls = u64[];
    mut impl_names = u8[][];
    for i in c.implementations.len() {
        if same(view(c.implementations[i].module), view(m)) {
            impls.push(i);
            contract := c.implementations[i].contract;
            mut key = c.interfaces[contract - 1].module.copy();
            push_bytes(&mut key, view("::"));
            push_bytes(&mut key, view(c.interfaces[contract - 1].name));
            impl_names.push(key);
        }
    }
    for i in iface_sort_ids(&impl_names, &impls).len() {
        index := iface_sort_ids(&impl_names, &impls)[i];
        contract := c.implementations[index].contract;
        ty := c.implementations[index].ty;
        impl_start := out.len();
        push_bytes(&mut out, view("impl "));
        iface_interface_ref(&mut out, &mut c, contract);
        push_bytes(&mut out, view(" for "));
        iface_type(&mut out, &mut c, ty);
        // Only a named type has declaration parameters (an `impl<T> Ord for Pair<T>`); for `u64`,
        // bytes or a string the type's argument is a width or nothing, not a declaration, and reading
        // it as one picked up whatever declaration sat at that index.
        if ty_kind(&mut c, ty) == 8 {
            owner := ty_arg(&mut c, ty) + 1;
            iface_emit_impl_params(&mut c, &mut out, owner);
        }
        out.push(10);
        names := copy_names(&c.implementations[index].assoc_names);
        types := copy_numbers(&c.implementations[index].assoc_types);
        for j in names.len() {
            push_bytes(&mut out, view("assoctype "));
            push_bytes(&mut out, view(names[j]));
            out.push(32);
            iface_type(&mut out, &mut c, types[j]);
            out.push(10);
        }
        owner := private_module(view(".impl_"), index + 1);
        methods := iface_func_ids(&mut c, view(owner));
        mnames := iface_names_of_funcs(&mut c, &methods);
        for j in iface_sort_ids(&mnames, &methods).len() {
            iface_emit_func(&mut c, &mut out, iface_sort_ids(&mnames, &methods)[j], view(owner), 0);
        }
        // An implementation is as visible as the interface and the type it joins: always carried.
        iface_span(&mut spans, impl_start, out.len(), 8, index, 1, 0);
    }
    // Environment records a closure type in this surface carries. Writing a field can reach another
    // record, so this runs to a fixpoint.
    mut at = 0;
    env_start := out.len();
    while at < c.iface_env.len() {
        decl := c.iface_env[at];
        local := c.iface_env_names[at].copy();
        iface_emit_env(&mut c, &mut out, decl, view(local));
        at += 1;
    }
    iface_span(&mut spans, env_start, out.len(), 9, 0, 1, 0);
    out = iface_select(&mut c, &out, header_end, &spans);
    // Integrity: the digest covers every byte above it, so an edited file is refused by the reader
    // (and a second copy of the same bytes is recorded in interfaces.manifest).
    tail := iface_digest(&out);
    push_bytes(&mut out, view("digest "));
    iface_quoted(&mut out, view(tail));
    out.push(10);
    return out;
}
// Writes one interface per module of the program, plus the manifest that pins their bytes.
fn iface_emit_all<a>(c: (&a mut C)) -> unit {
    dir := c.iface_emit.copy();
    if dir.len() == 0 {
        return ();
    }
    host::mkdir(view(dir));
    mut manifest = u8[];
    push_bytes(&mut manifest, view("// grail-interfaces 1\n"));
    mut seen = u8[][];
    for i in c.iface_list.len() {
        m := c.iface_list[i].module.copy();
        path := c.iface_list[i].path.copy();
        in_std := c.iface_list[i].std;
        unsafe_flag := c.iface_list[i].unsafe;
        // Whether the module opted in to the ambient `host::` interface; recorded so a build that
        // reads the interface checks its bodies the same way.
        optin := u64(host_opted(&c, view(m)));
        mut done = 0;
        for j in seen.len() {
            if same(view(seen[j]), view(m)) {
                done = 1;
            }
        }
        // The runtime is the trusted base: it is compiled from source in every build, never read
        // from an interface, and two files declare it (runtime.grl and the platform module), so it
        // has no interface of its own.
        if same(view(m), view("runtime")) {
            continue;
        }
        if done != 0 {
            continue;
        }
        // A module read from an interface is described by the file it came from; this run has no
        // source to write it from and nothing new to say about it.
        if iface_owned(&mut c, view(m)) {
            continue;
        }
        seen.push(m.copy());
        text := iface_module_text(&mut c, view(m), view(path), in_std, unsafe_flag, optin);
        file := iface_join(view(dir), view(m), view(".iface"));
        written := host::write_file(view(file), view(text));
        if written != 0 {
            iface_refuse(view(file), view("cannot write an interface file"));
        }
        mut row = u8[];
        push_bytes(&mut row, view(m));
        out_push(&mut row, 32);
        push_bytes(&mut row, view(iface_digest(&text)));
        out_push(&mut row, 32);
        push_bytes(&mut row, view(iface_digest(&host::read_file(view(path)))));
        out_push(&mut row, 10);
        push_bytes(&mut manifest, view(row));
    }
    host::write_file(view(iface_join(view(dir), view("interfaces"), view(".manifest"))), view(manifest));
    return ();
}
fn out_push<a>(out: (&a mut u8[]), b: u64) -> unit {
    out.push(b);
    return ();
}

// ---- loading an interface ----
fn iface_starts<a, b>(text: &a [u8], prefix: &b [u8]) -> bool {
    if text.len() < prefix.len() {
        return false;
    }
    for i in prefix.len() {
        if text[i] != prefix[i] {
            return false;
        }
    }
    return true;
}
fn iface_at<a, b>(text: &a [u8], at: u64, word: &b [u8]) -> bool {
    if text.len() < at + word.len() {
        return false;
    }
    for i in word.len() {
        if text[at + i] != word[i] {
            return false;
        }
    }
    return true;
}
// The interface's own digest: everything above the digest line, byte for byte.
fn iface_self_check<a>(path: &a [u8], text: &a [u8]) -> unit {
    mut at = text.len();
    mut i = 0;
    while i + 8 < text.len() {
        if (text[i] == 10) & iface_at(view(text), i + 1, view("digest ")) {
            at = i + 1;
            break;
        }
        i += 1;
    }
    if at == text.len() {
        iface_refuse(view(path), view("has no digest line; it is not a complete interface"));
    }
    mut prefix = u8[];
    for k in at {
        prefix.push(text[k]);
    }
    mut tail = u8[];
    mut j = at + 8;
    while (j < text.len()) & (text[j] != 10) {
        if text[j] != 34 {
            tail.push(text[j]);
        }
        j += 1;
    }
    if !same(view(iface_digest(&prefix)), view(tail)) {
        iface_refuse(
            view(path),
            view("changed after it was written: the digest line does not match the file (edit or regenerate it with `grail check --interface DIR`)")
        );
    }
    return ();
}
// Every interface a build reads is checked against the manifest the emitting run wrote, so an
// interface that was edited *and* had its own digest line recomputed is still refused.
fn iface_check_manifest<a, b>(c: (&a mut C), dir: &b [u8]) -> unit {
    manifest := iface_join(view(dir), view("interfaces"), view(".manifest"));
    mut text = u8[];
    if host::exists(view(manifest)) != 0 {
        text = host::read_file(view(manifest));
    }
    if text.len() == 0 {
        iface_refuse(
            view(manifest),
            view("is missing: interfaces are checked against the manifest their emitting run wrote (run `grail check --interface DIR` again)")
        );
    }
    lines := iface_lines(&text);
    for i in lines.len() {
        line := lines[i].copy();
        if line.len() == 0 {
            continue;
        }
        if line[0] == 47 {
            // `// grail-interfaces 1`: a comment, not a module.
            continue;
        }
        mut module = u8[];
        mut want = u8[];
        mut part = 0;
        for k in line.len() {
            b := line[k];
            if b == 32 {
                if part == 2 {
                    break;
                }
                part += 1;
            } else if part == 0 {
                module.push(b);
            } else if part == 1 {
                want.push(b);
            }
        }
        if want.len() == 0 {
            continue;
        }
        file := iface_join(view(dir), view(module), view(".iface"));
        mut bytes = u8[];
        if host::exists(view(file)) != 0 {
            bytes = host::read_file(view(file));
        }
        if bytes.len() == 0 {
            iface_refuse(view(file), view("is missing but the manifest lists it"));
        }
        got := iface_digest(&bytes);
        if !same(view(got), view(want)) {
            mut msg = u8[];
            push_bytes(&mut msg, view("module `"));
            push_bytes(&mut msg, view(module));
            push_bytes(&mut msg, view("`: the interface file does not match the manifest (manifest says "));
            push_bytes(&mut msg, view(want));
            push_bytes(&mut msg, view(", the file is "));
            push_bytes(&mut msg, view(got));
            push_bytes(&mut msg, view("); it was edited or replaced after it was written"));
            iface_refuse(view(file), view(msg));
        }
    }
    return ();
}
// Reads one interface and installs its declarations, after every check. Returns the module name.
fn iface_load<a, b>(c: (&a mut C), path: &a [u8], source_path: &b [u8], phase: u64) -> u8[] {
    mut text = u8[];
    if host::exists(view(path)) != 0 {
        text = host::read_file(view(path));
    }
    if text.len() == 0 {
        iface_refuse(view(path), view("cannot read interface file"));
    }
    if !iface_starts(view(text), view("// grail-interface 3\n")) {
        if iface_starts(view(text), view("// grail-interface ")) {
            mut version = u8[];
            mut i = 19;
            while (i < text.len()) & (text[i] != 10) {
                version.push(text[i]);
                i += 1;
            }
            mut msg = u8[];
            push_bytes(&mut msg, view("was written in interface format "));
            push_bytes(&mut msg, view(version));
            push_bytes(&mut msg, view(", this compiler reads format 3"));
            iface_refuse(view(path), view(msg));
        }
        iface_refuse(view(path), view("is not an interface file (no `// grail-interface` header)"));
    }
    iface_self_check(view(path), view(text));
    lines := iface_lines(&text);
    mut module = u8[];
    mut session = u8[];
    mut unsafe_flag = 0;
    mut std_flag = 0;
    mut host_flag = 0;
    mut source_digest = u8[];
    mut mode_typed = 0;
    mut mode_default = 0;
    mut mode_overflow = u8[];
    mut mode_target = u8[];
    for i in lines.len() {
        line := lines[i].copy();
        if line.len() == 0 {
            continue;
        }
        mut p = IPos { text: line.copy(), toks: iface_tokens(view(line)), at: 0, path: path.copy(), line: i + 1 };
        if ip_done(&p) {
            continue;
        }
        key := ip_word(&mut p);
        if same(view(key), view("module")) {
            module = ip_word(&mut p);
        } else if same(view(key), view("source")) {
            // Informational: the file this program handed us is the authority, and its digest is
            // what has to match.
            session = ip_quoted(&mut p);
        } else if same(view(key), view("sha256")) {
            source_digest = ip_quoted(&mut p);
        } else if same(view(key), view("mode")) {
            while !ip_done(&p) {
                flag := ip_word(&mut p);
                if !ip_eat(&mut p, view("=")) {
                    iface_fail(&p, view("expected `=` in the mode line"));
                }
                if same(view(flag), view("typed_refs")) {
                    mode_typed = ip_number(&mut p);
                } else if same(view(flag), view("default_u64")) {
                    mode_default = ip_number(&mut p);
                } else if same(view(flag), view("overflow")) {
                    mode_overflow = ip_word(&mut p);
                } else if same(view(flag), view("target")) {
                    mode_target = ip_word(&mut p);
                } else {
                    ip_number(&mut p);
                }
            }
        } else if same(view(key), view("unsafe")) {
            unsafe_flag = ip_number(&mut p);
        } else if same(view(key), view("std")) {
            std_flag = ip_number(&mut p);
        } else if same(view(key), view("host")) {
            host_flag = ip_number(&mut p);
        } else if same(view(key), view("link")) {
            input := ip_quoted(&mut p);
            ffi_link(&mut c, view(input));
            last := c.lib_owner.len() - 1;
            exchange(&mut c.lib_owner[last], module.copy());
        }
    }
    // The module must be the one this file of the program declares.
    if module.len() == 0 {
        iface_refuse(view(path), view("has no module line"));
    }
    if same(view(module), view("runtime")) {
        iface_refuse(view(path), view("describes the runtime, which is compiled from source, not from an interface"));
    }
    if host_flag != 0 {
        mut known = 0;
        for i in c.host_modules.len() {
            if same(view(c.host_modules[i]), view(module)) {
                known = 1;
            }
        }
        if known == 0 {
            c.host_modules.push(module.copy());
        }
    }
    // Modes: an interface is only meaningful for the checker that would have produced it.
    if iface_target_word(c.target, c.plat) != mode_target {
        mut msg = u8[];
        push_bytes(&mut msg, view("was written for target "));
        push_bytes(&mut msg, view(mode_target));
        push_bytes(&mut msg, view(", this build targets "));
        push_bytes(&mut msg, view(iface_target_word(c.target, c.plat)));
        push_bytes(&mut msg, view("; re-emit it with `grail check --interface DIR`"));
        iface_refuse(view(path), view(msg));
    }
    mut overflow_word = "checked";
    if c.overflow == 0 {
        overflow_word = "wrap";
    }
    // Typed references and the u64 default have no switch any more, so any other value in the stamp
    // is an artifact of a compiler that still had the removed modes.
    if !same(view(mode_overflow), view(overflow_word)) || (mode_typed != 1) || (mode_default != 1) {
        mut msg = u8[];
        push_bytes(&mut msg, view("was written under compiler modes this one does not have (typed_refs="));
        decimal(&mut msg, mode_typed);
        push_bytes(&mut msg, view(" default_u64="));
        decimal(&mut msg, mode_default);
        push_bytes(&mut msg, view(" overflow="));
        push_bytes(&mut msg, view(mode_overflow));
        push_bytes(&mut msg, view("); re-emit it with `grail check --interface DIR`"));
        iface_refuse(view(path), view(msg));
    }
    // The sources this interface was built from must be the ones on this command line - when there
    // are any. `--use` reads an interface for a module whose source this build does not have, which
    // is the whole point of stage 3; the file's own digest is what remains. Phase 2 (the definition
    // sweep) has no source to check: phase 1 has already done it, once.
    if (phase != 2) & (source_path.len() != 0) {
        source := host::read_file(view(source_path));
        got := iface_digest(&source);
        if !same(view(got), view(source_digest)) {
        mut msg = u8[];
        push_bytes(&mut msg, view("module `"));
        push_bytes(&mut msg, view(module));
        push_bytes(&mut msg, view("` changed since this interface was written: the interface records source-sha256 "));
        push_bytes(&mut msg, view(source_digest));
        push_bytes(&mut msg, view(" for "));
        push_bytes(&mut msg, view(session));
        push_bytes(&mut msg, view(", but "));
        push_bytes(&mut msg, view(source_path));
        push_bytes(&mut msg, view(" is "));
        push_bytes(&mut msg, view(got));
        iface_refuse(view(path), view(msg));
        }
    }
    // Two passes: names first, so a declaration can refer to one declared after it (a record field
    // naming a type further down the file is ordinary), then fields and signatures.
    // Phase 1 registers every name the file declares (types, aliases, interfaces) and stops there:
    // module B's interface may name an interface declared by module C, and C's interface may not have
    // been read yet. Phase 2 installs fields and signatures once every name in the program exists.
    if phase == 1 {
        for i in lines.len() {
            iface_register(&mut c, view(lines[i]), view(path), i + 1, view(module));
        }
        c.iface_loaded.push(module.copy());
        c.iface_loaded_path.push(path.copy());
        c
            .iface_list
            .push(
                IModule {
                    module: module.copy(),
                    path: source_path.copy(),
                    std: std_flag,
                    unsafe: unsafe_flag,
                    host: host_flag
                }
            );
        return module;
    }
    mut state = IState {
        module: module.copy(),
        unsafe: unsafe_flag,
        source: iface_file_index(&mut c, view(source_path)),
        cur_decl: 18446744073709551615,
        first: 0,
        section: 0,
        owner: 0,
        contract: 0,
        implementation: 0,
        last_func: 0,
        last_decl: 0,
        impl_first: 0,
        impl_names: u8[][],
        body_func: 0,
        body_total: 0,
        body_left: 0,
        body_text: u8[],
        body_name: u8[]
    };
    funcs_before := c.funcs.len();
    // The interface names its own module's items, private ones included, and other modules' public
    // ones: reading it is the compiler's lookup, not the importer's.
    vis_was := exchange(&mut c.vis_off, 1);
    for i in lines.len() {
        iface_define(&mut c, &mut state, view(lines[i]), view(path), i + 1);
    }
    exchange(&mut c.vis_off, vis_was);
    if state.body_left != 0 {
        iface_refuse(view(path), view("ends in the middle of a body section; it is not a complete interface"));
    }
    // A template the file does not carry a body for could not be instantiated by anyone reading it.
    for i in c.funcs.len() - funcs_before {
        f := &c.funcs[funcs_before + i];
        if (f.types != 0) & (f.contract == 0) & (f.file < 1000000) {
            mut msg = u8[];
            push_bytes(&mut msg, view("carries no body for the generic template `"));
            push_bytes(&mut msg, view(f.name));
            push_bytes(&mut msg, view("`, so no importer can instantiate it"));
            iface_refuse(view(path), view(msg));
        }
    }
    // Now that every parameter name, bound and requirement is in place, give each implementation the
    // self type the source parse would have built (with its proofs), exactly once.
    for i in c.impl_params.len() {
        if c.impl_params[i].self_ty == NO_TYPE {
            iface_impl_self(&mut c, i);
        }
    }
    return module;
}

// Every interface in DIR that no file on the command line declares becomes part of this program:
// its declarations, and the bodies of its generic templates. Its *code* does not - it belongs to the
// object its own module was compiled into - so nothing is emitted for it here; that is what makes a
// generic body emitted once instead of once per importer.
fn iface_load_used<a, b>(c: (&a mut C), dir: &b [u8]) -> unit {
    entries := host::list_dir(view(dir));
    mut known = u8[][];
    count := host::argc() - c.arg_offset;
    mut i = 2;
    while i < count {
        path := host::arg(i + c.arg_offset);
        mut name = iface_scan(view(path));
        if name.len() == 0 {
            // The entry file is the one file that may omit its `module` line, and it is module
            // `main` when it does - the same rule the parser applies.
            if i == 2 {
                name = "main".copy();
            }
        }
        if name.len() != 0 {
            known.push(name);
        }
        i += 1;
    }
    for k in entries.len() {
        entry := entries[k].copy();
        if !iface_suffix(view(entry), view(".iface")) {
            continue;
        }
        mut file = u8[];
        push_bytes(&mut file, view(dir));
        file.push(47);
        push_bytes(&mut file, view(entry));
        name := iface_scan(view(file));
        if name.len() == 0 {
            continue;
        }
        mut have = 0;
        for j in known.len() {
            if same(view(known[j]), view(name)) {
                have = 1;
            }
        }
        for j in c.iface_used.len() {
            if same(view(c.iface_used[j]), view(name)) {
                have = 1;
            }
        }
        if have != 0 {
            continue;
        }
        module := iface_load(&mut c, view(file), view(""), 1);
        if !same(view(module), view(name)) {
            mut msg = u8[];
            push_bytes(&mut msg, view("describes module `"));
            push_bytes(&mut msg, view(module));
            push_bytes(&mut msg, view("`, but its own header names `"));
            push_bytes(&mut msg, view(name));
            push_bytes(&mut msg, view("`"));
            iface_refuse(view(file), view(msg));
        }
        c.iface_used.push(module.copy());
    }
    return ();
}
fn iface_suffix<a, b>(text: &a [u8], suffix: &b [u8]) -> bool {
    if text.len() < suffix.len() {
        return false;
    }
    for i in suffix.len() {
        if text[text.len() - suffix.len() + i] != suffix[i] {
            return false;
        }
    }
    return true;
}

// ---- installing declarations from interface lines ----
struct IState {
    module: u8[],
    unsafe: u64,
    source: u64,
    cur_decl: u64,
    first: u64,
    section: u64,
    owner: u64,
    contract: u64,
    implementation: u64,
    last_func: u64,
    last_decl: u64,
    impl_first: u64,
    impl_names: u8[][],
    body_func: u64,
    body_total: u64,
    body_left: u64,
    body_text: u8[],
    body_name: u8[]
}
fn ip_here<a, b>(line: &a [u8], path: &b [u8], n: u64) -> IPos {
    return IPos { text: line.copy(), toks: iface_tokens(view(line)), at: 0, path: path.copy(), line: n };
}
fn iface_register<a, b, d>(c: (&a mut C), line: &b [u8], path: &d [u8], n: u64, module: &d [u8]) -> unit {
    mut p = ip_here(view(line), view(path), n);
    if ip_done(&p) {
        return ();
    }
    word := ip_word(&mut p);
    if same(view(word), view("type")) {
        ref := ip_ref(&mut p);
        kind := ip_word(&mut p);
        mut params = u64[0];
        mut lifetimes = u64[0];
        mut transfer = u64[0];
        mut share = u64[0];
        iface_flags(&mut p, &mut params, &mut lifetimes, &mut transfer, &mut share);
        mut bounds = u64[];
        mut requirements = u64[][];
        for i in params[0] {
            bounds.push(0);
            requirements.push(u64[]);
        }
        item_public_14 := c.decl_public;
        c
            .decls
            .push(
                Decl {
                    public: item_public_14,
                    module: ip_ref_module(&ref),
                    name: ip_ref_name(&ref),
                    is_enum: u64(same(view(kind), view("enum"))),
                    opaque: u64(same(view(kind), view("handle"))),
                    transfer: transfer[0],
                    share: share[0],
                    c_layout: u64(same(view(kind), view("record"))),
                    first: 0,
                    count: 0,
                    drop: 0,
                    regions: lifetimes[0],
                    types: params[0],
                    success: 0,
                    bounds: bounds,
                    constraints: requirements,
                }
            );
        return ();
    }
    if same(view(word), view("env")) {
        local := ip_ident(&mut p);
        mut name = u8[];
        push_bytes(&mut name, view(module));
        name.push(95);
        push_bytes(&mut name, view(local));
        item_public_15 := c.decl_public;
        c
            .decls
            .push(
                Decl {
                    public: item_public_15,
                    module: copy_bytes(view(".closure")),
                    name: name,
                    is_enum: 0,
                    opaque: 0,
                    transfer: 0,
                    share: 0,
                    c_layout: 0,
                    first: 0,
                    count: 0,
                    drop: 0,
                    regions: 0,
                    types: 0,
                    success: 0,
                    bounds: u64[],
                    constraints: u64[][],
                }
            );
        c.iface_env.push(c.decls.len() - 1);
        c.iface_env_names.push(local.copy());
        return ();
    }
    if same(view(word), view("alias")) {
        ref := ip_ref(&mut p);
        m := ip_ref_module(&ref);
        name := ip_ref_name(&ref);
        if find_alias(&mut c, view(m), view(name)) != 0 {
            iface_fail(&p, view("declares a type alias twice"));
        }
        alias_public := c.decl_public;
        c.aliases.push(Alias { module: m, name: name, public: alias_public, ty: NO_TYPE });
        return ();
    }
    if same(view(word), view("interface")) {
        ref := ip_ref(&mut p);
        id := ensure_interface(&mut c, ip_ref_module(&ref), ip_ref_name(&ref));
        exchange(&mut c.interfaces[id - 1].defined, 1);
        return ();
    }
    return ();
}
// `params=N lifetimes=N transfer=N share=N` on a type line, in any order.
fn iface_flags<a>(p: (&a mut IPos), params: (&a mut u64[]), lifetimes: (&a mut u64[]), transfer: (&a mut u64[]), share: (&a mut u64[])) -> unit {
    while !ip_done(&p) {
        key := ip_word(&mut p);
        if !ip_eat(&mut p, view("=")) {
            iface_fail(&p, view("expected `=` in a declaration flag"));
        }
        n := ip_number(&mut p);
        if same(view(key), view("params")) {
            exchange(&mut params[0], n);
        } else {
            if same(view(key), view("lifetimes")) {
                exchange(&mut lifetimes[0], n);
            } else {
                if same(view(key), view("transfer")) {
                    exchange(&mut transfer[0], n);
                } else {
                    if same(view(key), view("share")) {
                        exchange(&mut share[0], n);
                    } else {
                        iface_fail(&p, view("unknown declaration flag"));
                    }
                }
            }
        }
    }
    return ();
}
// `private <kind> <name>`: an item this interface carries only because a public template's body
// uses it. It is defined like any other, then hidden from every module but its own.
fn iface_private<a>(c: (&a mut C), st: (&a mut IState), p: (&a mut IPos)) -> unit {
    what := ip_word(&mut p);
    name := ip_word(&mut p);
    m := st.module.copy();
    if same(view(what), view("fn")) {
        for i in c.funcs.len() {
            if same(view(c.funcs[i].module), view(m)) && same(view(c.funcs[i].name), view(name)) {
                exchange(&mut c.funcs[i].public, 0);
            }
        }
        return ();
    }
    if same(view(what), view("type")) {
        d := find_decl_internal(&mut c, view(m), view(name));
        if d == 0 {
            iface_fail(&p, view("private names an unknown type"));
        }
        exchange(&mut c.decls[d - 1].public, 0);
        return ();
    }
    if same(view(what), view("const")) {
        for i in c.constants.len() {
            if same(view(c.constants[i].module), view(m)) && same(view(c.constants[i].name), view(name)) {
                exchange(&mut c.constants[i].public, 0);
            }
        }
        return ();
    }
    if same(view(what), view("alias")) {
        for i in c.aliases.len() {
            if same(view(c.aliases[i].module), view(m)) && same(view(c.aliases[i].name), view(name)) {
                exchange(&mut c.aliases[i].public, 0);
            }
        }
        return ();
    }
    if same(view(what), view("method")) {
        // `private method Type name`: `name` is the type's own (inherent) method.
        method := ip_word(&mut p);
        d := find_decl_internal(&mut c, view(m), view(name));
        if d == 0 {
            iface_fail(&p, view("private method names an unknown type"));
        }
        owner := private_module(view(".inherent_"), d - 1);
        for i in c.funcs.len() {
            if same(view(c.funcs[i].module), view(owner)) && same(view(c.funcs[i].name), view(method)) {
                exchange(&mut c.funcs[i].public, 0);
            }
        }
        return ();
    }
    if same(view(what), view("interface")) {
        id := find_interface(&c, view(m), view(name));
        if id == 0 {
            iface_fail(&p, view("private names an unknown interface"));
        }
        exchange(&mut c.interfaces[id - 1].public, 0);
        return ();
    }
    iface_fail(&p, view("private takes fn, method, type, const, alias or interface"));
    return ();
}
fn iface_define<a, b, d>(c: (&a mut C), st: (&a mut IState), line: &b [u8], path: &d [u8], n: u64) -> unit {
    if st.body_left != 0 {
        iface_body_line(&mut c, &mut st, view(line), view(path), n);
        return ();
    }
    mut p = ip_here(view(line), view(path), n);
    if ip_done(&p) {
        return ();
    }
    word := ip_word(&mut p);
    if same(view(word), view("private")) {
        iface_private(&mut c, &mut st, &mut p);
        return ();
    }
    if same(view(word), view("type")) {
        ref := ip_ref(&mut p);
        found := find_decl_internal(&mut c, view(ip_ref_module(&ref)), view(ip_ref_name(&ref)));
        if found == 0 {
            iface_fail(&p, view("unknown type"));
        }
        exchange(&mut st.cur_decl, found - 1);
        exchange(&mut st.first, c.fields.len());
        exchange(&mut st.last_decl, found);
        exchange(&mut st.last_func, 0);
        return ();
    }
    if same(view(word), view("env")) {
        local := ip_ident(&mut p);
        decl := iface_env_decl(&mut c, view(local));
        if decl == 0 {
            iface_fail(&p, view("unknown environment record"));
        }
        exchange(&mut st.cur_decl, decl - 1);
        exchange(&mut st.first, c.fields.len());
        exchange(&mut st.last_decl, decl);
        exchange(&mut st.last_func, 0);
        return ();
    }
    if same(view(word), view("field")) || same(view(word), view("variant")) {
        name := ip_ident(&mut p);
        ty := iface_parse_type(&mut c, &mut p);
        if st.cur_decl == 18446744073709551615 {
            iface_fail(&p, view("a field must follow the type it belongs to"));
        }
        c.fields.push(Field { name: name, ty: ty, pred: no_pred() });
        count := st.cur_decl;
        d := &mut c.decls[st.cur_decl];
        exchange(&mut d.first, st.first);
        exchange(&mut d.count, c.fields.len() - st.first);
        return ();
    }
    if same(view(word), view("alias")) {
        ref := ip_ref(&mut p);
        ty := iface_parse_type(&mut c, &mut p);
        a := find_alias(&mut c, view(ip_ref_module(&ref)), view(ip_ref_name(&ref)));
        if a == 0 {
            iface_fail(&p, view("unknown type alias"));
        }
        exchange(&mut c.aliases[a - 1].ty, ty);
        return ();
    }
    if same(view(word), view("const")) {
        ref := ip_ref(&mut p);
        ty := iface_parse_type(&mut c, &mut p);
        kind := ip_ident(&mut p);
        mut value = 0;
        mut text = u8[];
        if same(view(kind), view("seq")) {
            value = ip_number(&mut p);
            hex := ip_quoted(&mut p);
            text = iface_unhex(&hex);
            if ct_seq_elem(&mut c, ty) == NO_TYPE {
                iface_fail(&p, view("a table constant needs a vector of integers or bytes"));
            }
        } else if same(view(kind), view("str")) {
            hex := ip_quoted(&mut p);
            text = iface_unhex(&hex);
            if ty != 3 {
                iface_fail(&p, view("a text constant needs type string"));
            }
        } else {
            if same(view(kind), view("int")) {
                value = ip_number(&mut p);
            } else {
                iface_fail(&p, view("constants are `int N`, `str HEX` or `seq N HEX`"));
            }
        }
        item_public_16 := c.decl_public;
        c
            .constants
            .push(
                Constant {
                    public: item_public_16,
                    module: ip_ref_module(&ref),
                    name: ip_ref_name(&ref),
                    ty: ty,
                    value: value,
                    text: text,
                }
            );
        return ();
    }
    if same(view(word), view("inherent")) {
        ref := ip_ref(&mut p);
        found := find_decl_internal(&mut c, view(ip_ref_module(&ref)), view(ip_ref_name(&ref)));
        if found == 0 {
            iface_fail(&p, view("inherent methods need a type of the same module"));
        }
        mut params = u64[0];
        mut lifetimes = u64[0];
        mut transfer = u64[0];
        mut share = u64[0];
        iface_flags(&mut p, &mut params, &mut lifetimes, &mut transfer, &mut share);
        exchange(&mut st.section, 1);
        exchange(&mut st.owner, found - 1);
        exchange(&mut st.last_func, 0);
        // A section header starts a new declaration: `require`/`bound` lines under it belong to the
        // implementation's own parameters, not to the type declared above it.
        exchange(&mut st.last_decl, 0);
        iface_impl_record(&mut c, &mut st, found, params[0], lifetimes[0]);
        return ();
    }
    if same(view(word), view("interface")) {
        ref := ip_ref(&mut p);
        id := find_interface(&c, view(ip_ref_module(&ref)), view(ip_ref_name(&ref)));
        if id == 0 {
            iface_fail(&p, view("unknown interface"));
        }
        exchange(&mut st.section, 2);
        exchange(&mut st.contract, id);
        exchange(&mut st.last_func, 0);
        exchange(&mut st.last_decl, 0);
        return ();
    }
    if same(view(word), view("impl")) {
        ref := ip_ref(&mut p);
        id := find_interface(&c, view(ip_ref_module(&ref)), view(ip_ref_name(&ref)));
        if id == 0 {
            iface_fail(&p, view("unknown interface"));
        }
        if !ip_eat(&mut p, view("for")) {
            iface_fail(&p, view("an implementation line is `impl I for T`"));
        }
        ty := iface_parse_type(&mut c, &mut p);
        mut params = u64[0];
        mut lifetimes = u64[0];
        mut transfer = u64[0];
        mut share = u64[0];
        iface_flags(&mut p, &mut params, &mut lifetimes, &mut transfer, &mut share);
        c
            .implementations
            .push(
                Implementation {
                    contract: id,
                    ty: ty,
                    module: st.module.copy(),
                    methods: u64[],
                    file: 0,
                    pos: 0,
                    assoc_names: u8[][],
                    assoc_types: u64[],
                }
            );
        // An importer that reads the implementation from a file gets the same declaration bit the
        // source parse set, so its drop glue calls the user `drop` too.
        if (c.drop_iface != 0) & (id == c.drop_iface) {
            drop_impl_registered(&mut c, ty);
        }
        exchange(&mut st.section, 3);
        exchange(&mut st.contract, id);
        exchange(&mut st.implementation, c.implementations.len());
        exchange(&mut st.last_func, 0);
        exchange(&mut st.last_decl, 0);
        // The source keys a generic interface implementation by its implementation id, not by
        // the declaration its type names (which is an inherent impl's key): an importer has to
        // find `impl<T> I for X<T>`'s parameters where `impl_param_types` looks for them.
        mut owner = ty_arg(&mut c, ty) + 1;
        if params[0] != 0 {
            owner = generic_impl_key(c.implementations.len());
        }
        iface_impl_record(&mut c, &mut st, owner, params[0], lifetimes[0]);
        if (params[0] != 0) && (c.impl_params.len() > st.impl_first) {
            // Keyed by the implementation, so the self type cannot be rebuilt from the key.
            last := c.impl_params.len() - 1;
            c.impl_params[last].self_ty = ty;
        }
        return ();
    }
    if same(view(word), view("assoc")) {
        if st.section != 2 {
            iface_fail(&p, view("an `assoc` line belongs to an interface"));
        }
        name := ip_ident(&mut p);
        known := copy_names(&c.interfaces[st.contract - 1].assoc);
        mut have = false;
        for j in known.len() {
            if same(view(known[j]), view(name)) {
                have = true;
            }
        }
        if !have {
            item := &mut c.interfaces[st.contract - 1];
            item.assoc.push(name);
        }
        return ();
    }
    if same(view(word), view("super")) {
        if st.section != 2 {
            iface_fail(&p, view("a `super` line belongs to an interface"));
        }
        ref := ip_ref(&mut p);
        sup := ensure_interface(&mut c, ip_ref_module(&ref), ip_ref_name(&ref));
        known := copy_numbers(&c.interfaces[st.contract - 1].supers);
        mut have = false;
        for j in known.len() {
            if known[j] == sup {
                have = true;
            }
        }
        if !have {
            item := &mut c.interfaces[st.contract - 1];
            item.supers.push(sup);
        }
        return ();
    }
    if same(view(word), view("assoctype")) {
        if st.section != 3 {
            iface_fail(&p, view("an `assoctype` line belongs to an implementation"));
        }
        name := ip_ident(&mut p);
        ty := iface_parse_type(&mut c, &mut p);
        item := &mut c.implementations[st.implementation - 1];
        item.assoc_names.push(name);
        item.assoc_types.push(ty);
        return ();
    }
    if same(view(word), view("rname")) || same(view(word), view("ptype")) {
        at := ip_number(&mut p);
        name := ip_ident(&mut p);
        // Lifetime names come first (they are stored in one list), type names after.
        if c.impl_params.len() == st.impl_first {
            iface_fail(&p, view("impl parameter names need an `impl` line"));
        }
        record := c.impl_params.len() - 1;
        if same(view(word), view("rname")) {
            c.impl_params[record].rnames.push(name);
        } else {
            c.impl_params[record].tnames.push(name);
        }
        return ();
    }
    if same(view(word), view("fn")) {
        iface_define_func(&mut c, &mut st, &mut p);
        return ();
    }
    if same(view(word), view("lifetimes")) {
        count := ip_number(&mut p);
        if st.last_func == 0 {
            iface_fail(&p, view("`lifetimes` must follow a function"));
        }
        exchange(&mut c.funcs[st.last_func - 1].regions, count);
        return ();
    }
    if same(view(word), view("strict")) {
        flag := ip_number(&mut p);
        if st.last_func == 0 {
            iface_fail(&p, view("`strict` must follow a function"));
        }
        exchange(&mut c.funcs[st.last_func - 1].strict, flag);
        return ();
    }
    if same(view(word), view("bound")) {
        at := ip_number(&mut p);
        bits := ip_number(&mut p);
        if st.last_func != 0 {
            index := st.last_func - 1;
            limit := c.funcs[index].bounds.len();
            if at < limit {
                mut f = &mut c.funcs[index];
                exchange(&mut f.bounds[at], bits);
            }
        } else {
            if st.last_decl != 0 {
                index := st.last_decl - 1;
                limit := c.decls[index].bounds.len();
                if at < limit {
                    mut d = &mut c.decls[index];
                    exchange(&mut d.bounds[at], bits);
                }
            } else {
                if (st.section == 1) || (st.section == 3) {
                    index := c.impl_params.len() - 1;
                    limit := c.impl_params[index].bounds.len();
                    if at < limit {
                        mut record = &mut c.impl_params[index];
                        exchange(&mut record.bounds[at], bits);
                    }
                } else {
                    iface_fail(&p, view("`bound` must follow a function or a type"));
                }
            }
        }
        return ();
    }
    if same(view(word), view("require")) {
        at := ip_number(&mut p);
        ref := ip_ref(&mut p);
        id := find_interface(&c, view(ip_ref_module(&ref)), view(ip_ref_name(&ref)));
        if id == 0 {
            iface_fail(&p, view("unknown interface"));
        }
        if st.last_func != 0 {
            index := st.last_func - 1;
            limit := c.funcs[index].constraints.len();
            if at < limit {
                mut f = &mut c.funcs[index];
                f.constraints[at].push(id);
            }
        } else {
            if st.last_decl != 0 {
                index := st.last_decl - 1;
                limit := c.decls[index].constraints.len();
                if at < limit {
                    mut d = &mut c.decls[index];
                    d.constraints[at].push(id);
                }
            } else {
                if (st.section == 1) || (st.section == 3) {
                    index := c.impl_params.len() - 1;
                    limit := c.impl_params[index].interfaces.len();
                    if at < limit {
                        mut record = &mut c.impl_params[index];
                        record.interfaces[at].push(id);
                    }
                } else {
                    iface_fail(&p, view("`require` must follow a function or a type"));
                }
            }
        }
        return ();
    }
    if same(view(word), view("where")) {
        // A parameter's predicate, carried as text and rebuilt as a virtual source.
        at := ip_number(&mut p);
        text := ip_quoted(&mut p);
        if st.last_func == 0 {
            iface_fail(&p, view("`where` must follow a function"));
        }
        index := st.last_func - 1;
        mut label = u8[];
        push_bytes(&mut label, view(path));
        label.push(58);
        push_bytes(&mut label, view(c.funcs[index].module));
        push_bytes(&mut label, view("::"));
        push_bytes(&mut label, view(c.funcs[index].name));
        label.push(35);
        decimal(&mut label, at);
        pred := pred_of_text(&mut c, view(label), view(text));
        f := &mut c.funcs[index];
        while f.ppreds.len() <= at {
            f.ppreds.push(no_pred());
        }
        exchange(&mut f.ppreds[at], pred);
        return ();
    }
    if same(view(word), view("pname")) {
        // A refined parameter's source name, so a call site in another module can prove the
        // predicate by substituting its own terms.
        at := ip_number(&mut p);
        name := ip_quoted(&mut p);
        if st.last_func == 0 {
            iface_fail(&p, view("`pname` must follow a function"));
        }
        index := st.last_func - 1;
        f := &mut c.funcs[index];
        while f.pnames.len() <= at {
            f.pnames.push(u8[]);
        }
        exchange(&mut f.pnames[at], name);
        return ();
    }
    if same(view(word), view("effects")) {
        fa := ip_number(&mut p);
        fp := ip_number(&mut p);
        fs := ip_number(&mut p);
        if st.last_func == 0 {
            iface_fail(&p, view("`effects` must follow a function"));
        }
        index := st.last_func - 1;
        f := &mut c.funcs[index];
        exchange(&mut f.no_alloc, fa);
        exchange(&mut f.no_panic, fp);
        exchange(&mut f.strict, fs);
        if (fa != 0) || (fp != 0) {
            exchange(&mut c.fx_any, 1);
        }
        return ();
    }
    if same(view(word), view("ensures")) {
        text := ip_quoted(&mut p);
        if st.last_func == 0 {
            iface_fail(&p, view("`ensures` must follow a function"));
        }
        index := st.last_func - 1;
        mut label = u8[];
        push_bytes(&mut label, view(path));
        label.push(58);
        push_bytes(&mut label, view(c.funcs[index].module));
        push_bytes(&mut label, view("::"));
        push_bytes(&mut label, view(c.funcs[index].name));
        push_bytes(&mut label, view("#result"));
        pred := pred_of_text(&mut c, view(label), view(text));
        exchange(&mut c.funcs[index].rpred, pred);
        return ();
    }
    if same(view(word), view("fwhere")) {
        name := ip_quoted(&mut p);
        text := ip_quoted(&mut p);
        if st.last_decl == 0 {
            iface_fail(&p, view("`fwhere` must follow a type"));
        }
        index := st.last_decl - 1;
        first := c.decls[index].first;
        count := c.decls[index].count;
        for i in count {
            if (first + i < c.fields.len()) & same(view(c.fields[first + i].name), view(name)) {
                mut label = u8[];
                push_bytes(&mut label, view(path));
                label.push(58);
                push_bytes(&mut label, view(c.decls[index].name));
                label.push(46);
                push_bytes(&mut label, view(name));
                pred := pred_of_text(&mut c, view(label), view(text));
                mut target = &mut c.fields[first + i];
                exchange(&mut target.pred, pred);
                return ();
            }
        }
        iface_fail(&p, view("`fwhere` names a field of this type"));
    }
    if same(view(word), view("body")) {
        // `body N` and the N `line` rows that follow are a generic template's own text. The rows
        // are rebuilt into a source file of this interface, so replay parses exactly what the
        // defining module parsed and the template needs no source of its own.
        count := ip_number(&mut p);
        if st.last_func == 0 {
            iface_fail(&p, view("`body` must follow a function"));
        }
        if !ip_done(&p) {
            iface_fail(&p, view("a body section is `body N` followed by N `line ...` rows"));
        }
        if count == 0 {
            iface_fail(&p, view("a generic template must carry its body"));
        }
        f := &c.funcs[st.last_func - 1];
        mut label = u8[];
        push_bytes(&mut label, view(path));
        label.push(58);
        push_bytes(&mut label, view(f.module));
        push_bytes(&mut label, view("::"));
        push_bytes(&mut label, view(f.name));
        st.body_func = st.last_func;
        st.body_total = count;
        st.body_left = count;
        exchange(&mut st.body_text, u8[]);
        exchange(&mut st.body_name, label);
        return ();
    }
    return ();
}
// One row of a body section: the template's next source line, quoted. When the last row arrives the
// text is registered as a file and the function is pointed at it with position 0, which is what
// `replay_function` needs to parse the declaration again.
fn iface_body_line<a, b, d>(c: (&a mut C), st: (&a mut IState), line: &b [u8], path: &d [u8], n: u64) -> unit {
    mut p = ip_here(view(line), view(path), n);
    if !ip_eat(&mut p, view("line")) {
        iface_fail(&p, view("a body section is `body N` followed by N `line ...` rows"));
    }
    row := ip_quoted(&mut p);
    if st.body_left != st.body_total {
        st.body_text.push(10);
    }
    push_bytes(&mut st.body_text, view(row));
    remaining := st.body_left - 1;
    st.body_left = remaining;
    if remaining == 0 {
        index := st.body_func - 1;
        name := st.body_name.copy();
        body := st.body_text.copy();
        file := virtual_source(&mut c, view(name), view(body));
        exchange(&mut c.funcs[index].file, file);
        exchange(&mut c.funcs[index].pos, 0);
        exchange(&mut st.body_text, u8[]);
    }
    return ();
}
// A source that came from an interface rather than from the command line. The base is far above any
// plausible argument count, so one index still tells the two apart everywhere a file is loaded or
// named in a diagnostic.
fn virtual_source<a, b>(c: (&a mut C), path: &b [u8], text: &b [u8]) -> u64 {
    c.virt_path.push(path.copy());
    c.virt_text.push(text.copy());
    return 1000000 + c.virt_text.len() - 1;
}
// `.closure::envN` names an environment record this file carries: an importer rebuilds it here as
// a fresh `.closure` declaration, so a closure type's captured fields survive the boundary.
fn iface_env_type<a, b, d>(c: (&a mut C), p: (&b mut IPos), local: &d [u8]) -> u64 {
    decl := iface_env_decl(&mut c, view(local));
    if decl == 0 {
        iface_fail(&p, view("unknown environment record"));
    }
    return intern_args(&mut c, 8, decl - 1, 0, u64[], u64[]);
}
// The parameter record of a generic implementation: `impl<T> Foo<T>` is checked against its own
// parameters when an importer replays one of its generic methods.
// The self type of an implementation (`impl<K: Hash + Equal, V> Map<K, V>` is `Map<K, V>`) has to
// carry the same bounds and interface proofs the source parse gives it: `validate_type_constraints`
// walks every nominal type in the store, so a bare `Map<K, V>` is a real type it would reject.
fn iface_impl_self<a>(c: (&a mut C), record: u64) -> unit {
    decl := c.impl_params[record].decl;
    params := c.impl_params[record].tnames.len();
    mut bounds = copy_numbers(&c.impl_params[record].bounds);
    mut reqs = u64[][];
    for i in c.impl_params[record].interfaces.len() {
        reqs.push(copy_numbers(&c.impl_params[record].interfaces[i]));
    }
    mut args = u64[];
    for i in params {
        mut proofs = u64[];
        if i < reqs.len() {
            for j in reqs[i].len() {
                proofs.push(intern_args(&mut c, 15, reqs[i][j], 0, u64[], u64[]));
            }
        }
        mut bits = 0;
        if i < bounds.len() {
            bits = bounds[i];
        }
        args.push(intern_args(&mut c, 9, i, bits, u64[], proofs));
    }
    self := intern_args(&mut c, 8, decl - 1, 0, u64[], args);
    mut item = &mut c.impl_params[record];
    exchange(&mut item.self_ty, self);
    return ();
}
fn iface_impl_record<a>(c: (&a mut C), st: (&a mut IState), owner: u64, params: u64, lifetimes: u64) -> unit {
    exchange(&mut st.impl_first, c.impl_params.len());
    if (params == 0) & (lifetimes == 0) {
        return ();
    }
    mut args = u64[];
    for i in params {
        args.push(intern_args(&mut c, 9, i, 0, u64[], u64[]));
    }
    mut bounds = u64[];
    mut requirements = u64[][];
    for i in params {
        bounds.push(0);
        requirements.push(u64[]);
    }
    c
        .impl_params
        .push(
            ImplParams {
                decl: owner,
                rnames: u8[][],
                tnames: u8[][],
                bounds: bounds,
                interfaces: requirements,
                self_ty: NO_TYPE,
            }
        );
    return ();
}
fn iface_env_decl<a, b>(c: (&a mut C), local: &b [u8]) -> u64 {
    for i in c.iface_env_names.len() {
        if same(view(c.iface_env_names[i]), view(local)) {
            return c.iface_env[i] + 1;
        }
    }
    return 0;
}
fn iface_unhex<a>(hex: &a [u8]) -> u8[] {
    mut out = u8[];
    mut i = 0;
    while i + 1 < hex.len() {
        out.push(iface_nibble(hex[i]) * 16 + iface_nibble(hex[i + 1]));
        i += 2;
    }
    return out;
}
fn iface_nibble(b: u64) -> u64 {
    if (47 < b) & (b < 58) {
        return b - 48;
    }
    return b - 87;
}
fn iface_file_index<a, b>(c: (&a mut C), path: &b [u8]) -> u64 {
    argc := host::argc();
    mut i = 2;
    while i < argc - c.arg_offset {
        if same(view(host::arg(i + c.arg_offset)), view(path)) {
            return i;
        }
        i += 1;
    }
    return 0;
}

fn iface_define_func<a>(c: (&a mut C), st: (&a mut IState), p: (&a mut IPos)) -> unit {
    mut name = u8[];
    mut module = u8[];
    if st.section == 0 {
        ref := ip_ref(&mut p);
        module = ip_ref_module(&ref);
        name = ip_ref_name(&ref);
    } else if st.section == 1 {
        name = ip_ident(&mut p);
        module = private_module(view(".inherent_"), st.owner);
    } else if st.section == 2 {
        name = ip_ident(&mut p);
        module = private_module(view(".interface_"), st.contract);
    } else {
        name = ip_ident(&mut p);
        module = private_module(view(".impl_"), st.implementation);
    }
    mut params = u64[0];
    if ip_eat(&mut p, view("<")) {
        exchange(&mut params[0], ip_number(&mut p));
        if !ip_eat(&mut p, view(">")) {
            iface_fail(&p, view("expected `>` after a type parameter count"));
        }
    }
    if find_func(&mut c, view(module), view(name)) != 0 {
        iface_fail(&p, view("declares a function twice"));
    }
    first := c.params.len();
    mut count = 0;
    ip_expect(&mut p, view("("));
    if !ip_eat(&mut p, view(")")) {
        while true {
            ty := iface_parse_type(&mut c, &mut p);
            c.params.push(ty);
            count += 1;
            if ip_eat(&mut p, view(")")) {
                break;
            }
            if !ip_eat(&mut p, view(",")) {
                iface_fail(&p, view("expected `,` or `)` in a parameter list"));
            }
        }
    }
    if !ip_eat(&mut p, view("->")) {
        iface_fail(&p, view("a function line is `fn NAME (T, ...) -> T`"));
    }
    ret := iface_parse_type(&mut c, &mut p);
    mut ext = 0;
    mut symbol = u8[];
    while !ip_done(&p) {
        key := ip_word(&mut p);
        if !ip_eat(&mut p, view("=")) {
            iface_fail(&p, view("expected `=` after a function flag"));
        }
        if same(view(key), view("extern")) {
            ext = ip_number(&mut p);
        } else if same(view(key), view("symbol")) {
            symbol = ip_ident(&mut p);
        } else {
            iface_fail(&p, view("unknown function flag"));
        }
    }
    mut types = params[0];
    mut owner = 0;
    mut contract = 0;
    if st.section == 1 {
        owner = st.owner + 1;
    }
    if (st.section == 3) && (st.implementation != 0) {
        // A generic implementation's method replays with the implementation's parameters, as the
        // source parse records them (method_owner).
        key := generic_impl_key(st.implementation);
        if impl_record(&mut c, key) != 0 {
            owner = key;
        }
    }
    if st.section == 2 {
        // An interface method is checked against its contract: one implicit type parameter and the
        // requirement that the implementing type satisfies the interface.
        contract = st.contract;
        types = 1;
    }
    mut bounds = u64[];
    mut requirements = u64[][];
    for i in types {
        bounds.push(0);
        requirements.push(u64[]);
    }
    if st.section == 2 {
        exchange(&mut bounds[0], 0);
        requirements[0].push(st.contract);
    }
    item_public_17 := c.decl_public;
    item_home_17 := st.module.copy();
    c
        .funcs
        .push(
            Func {
                public: item_public_17,
                home: item_home_17,
                module: module,
                name: name,
                first: first,
                count: count,
                ret: ret,
                types: types,
                regions: 0,
                file: st.source,
                pos: 0,
                raw: st.unsafe,
                unsafe_fn: 0,
                bounds: bounds,
                constraints: requirements,
                contract: contract,
                owner: owner,
                ext: ext,
                symbol: symbol,
                body: u8[],
                ppreds: Pred[],
                rpred: no_pred(),
                pnames: u8[][],
                strict: 0,
                no_alloc: 0,
                no_panic: 0,
            }
        );
    index := c.funcs.len() - 1;
    exchange(&mut st.last_func, c.funcs.len());
    exchange(&mut st.last_decl, 0);
    if st.section == 3 {
        // An implementation's method list is what dispatch walks.
        mut item = &mut c.implementations[st.implementation - 1];
        item.methods.push(index);
    }
    if st.section == 2 {
        // The interface's own method list is what `check_interfaces` compares an implementation
        // against, so it has to be as complete as the implementations are.
        mut item = &mut c.interfaces[st.contract - 1];
        item.methods.push(index);
    }
    return ();
}


// ---- the build path: emit, verify, or read instead of parsing ----
// The module a source file declares, found without parsing: `module NAME;` after optional
// whitespace, comments and `unsafe`. An empty name means the file is the entry (which may omit its
// module declaration) and is therefore always compiled from source.
fn iface_scan<a>(path: &a [u8]) -> u8[] {
    text := host::read_file(view(path));
    mut i = 0;
    mut name = u8[];
    while i < text.len() {
        c := text[i];
        if (c == 32) || (c == 9) || (c == 10) || (c == 13) || (c == 12) {
            i += 1;
        } else if (c == 47) & (i + 1 < text.len()) & (text[i + 1] == 47) {
            while (i < text.len()) & (text[i] != 10) {
                i += 1;
            }
        } else {
            mut word = u8[];
            while (i < text.len()) & iface_ident_byte(text[i]) {
                word.push(text[i]);
                i += 1;
            }
            if same(view(word), view("module")) {
                while (i < text.len()) & ((text[i] == 32) || (text[i] == 9)) {
                    i += 1;
                }
                while (i < text.len()) & iface_ident_byte(text[i]) {
                    name.push(text[i]);
                    i += 1;
                }
                return name;
            }
            if same(view(word), view("unsafe")) {
                // `unsafe module NAME;`: keep scanning.
                continue;
            }
            return u8[];
        }
    }
    return name;
}
fn iface_ident_byte(b: u64) -> bool {
    return ((64 < b) & (b < 91)) || ((96 < b) & (b < 123)) || ((47 < b) & (b < 58)) || (b == 95);
}
// Compares the interface on disk with the one this compiler would write from the sources it has
// just parsed: the third refusal of stage 2 - an interface that disagrees with its module.
// The `sha256 "..."` an interface file records for its source, or nothing.
fn iface_recorded_digest<a>(text: (&a u8[])) -> u8[] {
    rows := iface_lines(view(text));
    for i in rows.len() {
        row := rows[i].copy();
        if (row.len() > 9) && (row[0] == 115) && (row[1] == 104) && (row[2] == 97) && (row[6] == 32) && (row[7] == 34) {
            mut out = u8[];
            mut j = 8;
            while (j < row.len()) && (row[j] != 34) {
                out.push(row[j]);
                j += 1;
            }
            return out;
        }
    }
    return u8[];
}
fn iface_verify_module<a>(c: (&a mut C), index: u64) -> unit {
    m := c.iface_list[index].module.copy();
    path := c.iface_list[index].path.copy();
    in_std := c.iface_list[index].std;
    unsafe_flag := c.iface_list[index].unsafe;
    mut optin = 0;
    if host_opted(&c, view(m)) {
        optin = 1;
    }
    file := iface_join(view(c.iface_dir), view(m), view(".iface"));
    mut want = u8[];
    if host::exists(view(file)) != 0 {
        want = host::read_file(view(file));
    }
    if want.len() == 0 {
        mut msg = u8[];
        push_bytes(&mut msg, view("has no interface for module `"));
        push_bytes(&mut msg, view(m));
        push_bytes(&mut msg, view("` (expected this file); run `grail check --interface DIR` to write it"));
        iface_refuse(view(file), view(msg));
    }
    // A changed source is staleness, said as such, before any line of the surface is compared.
    recorded := iface_recorded_digest(&want);
    actual := iface_digest(&host::read_file(view(path)));
    if (recorded.len() != 0) && !same(view(recorded), view(actual)) {
        mut msg = u8[];
        push_bytes(&mut msg, view("module `"));
        push_bytes(&mut msg, view(m));
        push_bytes(&mut msg, view("` changed since this interface was written: the interface records source-sha256 "));
        push_bytes(&mut msg, view(recorded));
        push_bytes(&mut msg, view(", but "));
        push_bytes(&mut msg, view(path));
        push_bytes(&mut msg, view(" is "));
        push_bytes(&mut msg, view(actual));
        iface_refuse(view(file), view(msg));
    }
    got := iface_module_text(&mut c, view(m), view(path), in_std, unsafe_flag, optin);
    if same(view(want), view(got)) {
        return ();
    }
    lines_a := iface_lines(&want);
    lines_b := iface_lines(&got);
    mut at = 0;
    while (at < lines_a.len()) || (at < lines_b.len()) {
        mut left = u8[];
        mut right = u8[];
        if at < lines_a.len() {
            left = lines_a[at].copy();
        }
        if at < lines_b.len() {
            right = lines_b[at].copy();
        }
        if !same(view(left), view(right)) {
            mut msg = u8[];
            push_bytes(&mut msg, view("module `"));
            push_bytes(&mut msg, view(m));
            push_bytes(&mut msg, view("` does not match this interface: line "));
            decimal(&mut msg, at + 1);
            push_bytes(&mut msg, view(": the interface says `"));
            push_bytes(&mut msg, view(iface_clip(view(left))));
            push_bytes(&mut msg, view("`, the sources give `"));
            push_bytes(&mut msg, view(iface_clip(view(right))));
            push_bytes(&mut msg, view("`"));
            iface_refuse(view(file), view(msg));
        }
        at += 1;
    }
    // Identical lines but different bytes: the file has a different line layout.
    iface_refuse(view(file), view("does not match the module byte for byte; regenerate it with `grail check --interface DIR`"));
    return ();
}
// A long line is clipped so a diagnostic stays one line.
fn iface_clip<a>(line: &a [u8]) -> u8[] {
    mut out = u8[];
    mut i = 0;
    while (i < line.len()) & (i < 96) {
        out.push(line[i]);
        i += 1;
    }
    if 96 <= line.len() {
        push_bytes(&mut out, view(" …"));
    }
    return out;
}

pub fn main() -> u64 {
    mut c = C {
        src: u8[],
        toks: Tok[],
        pos: 0,
        out: u8[],
        split: 0,
        separate: 0,
        part: u8[],
        lpart: u8[],
        lunit: 0,
        lunits: u8[][],
        lnext: u64[],
        rnext: u64[],
        marks: u64[],
        part_names: u8[][],
        module: u8[],
        target: 0,
        plat: 0,
        debug: 0,
        backend: 0,
        facts: llvm::facts_new(),
        facts_fn: u8[],
        f64_ops: 0,
        call_ord: 0,
        f1_names: u8[][],
        f1_counts: u64[],
        f1_ord: 0,
        verify_facts: 0,
        range_facts: 0,
        no_sites: 0,
        f1_what: 0,
        debug_funcs: DebugFunc[],
        debug_vars: DebugVar[],
        debug_types: DebugType[],
        arg_offset: 0,
        overflow: 1,
        strict_bool_report: 0,
        exports: u8[][],
        export_hits: u64[],
        specs: Spec[],
        bindings: u64[],
        current_spec: 0,
        spec_closures: 0,
        validating: 0,
        ffi_fixed: 0,
        caddr: u64[],
        export_fret: 0,
        cfield_more: 0,
        alias_next: 1,
        types: Ty[],
        decls: Decl[],
        aliases: Alias[],
        imports: Import[],
        fields: Field[],
        funcs: Func[],
        params: u64[],
        locals: Local[],
        next: 0,
        entry: 0,
        file: 0,
        label: 1,
        brk: 0,
        cont: 0,
        raw: 0,
        unsafe_depth: 0,
        pending_unsafe: 0,
        in_return: 0,
        cptr_address: 0,
        embedded: u64[],
        libs: u8[][],
        pending_ext: 0,
        pending_symbol: u8[],
        export_tls: 0,
        export_adopt: 0,
        ct_pass: 0,
        ct_in_if: false,
        decl_public: 1,
        vis_off: 0,
        ct_unbound: 0,
        site_file: 0,
        site_off: 0,
        site_line: 1,
        site_col: 1,
        probe_mode: 0,
        ct_loop_names: u8[][],
        ct_loop_decls: u64[],
        ct_loop_index: u64[],
        embed_used: 0,
        skip_bodies: u64[],
        body_file: 0,
        body_pos: 0,
        reported: u8[][],
        export_copyback: u64[],
        rnames: u8[][],
        tnames: u8[][],
        closures: Closure[],
        fn_thunk_used: 0,
        closure_env: 0,
        hint_params: u64[],
        hint_ret: NO_TYPE,
        hint_set: 0,
        inherent: 0,
        constants: Constant[],
        impl_params: ImplParams[],
        receiver: 0,
        receiver_ty: NO_TYPE,
        has_receiver: 0,
        positional: 0,
        lazy_input: 0,
        lazy_inty: NO_TYPE,
        lazy_xty: NO_TYPE,
        lit_start: 0,
        lit_end: 0,
        lit_value: 0,
        hints: u64[],
        tolerant: 0,
        retry: 0,
        attempts: 0,
        cf_start: 0,
        cf_end: 0,
        cf_local: 0,
        bce_index: u8[],
        bce_base: u8[],
        cur_ppreds: Pred[],
        cur_rpred: no_pred(),
        body_lo: 0,
        body_hi: 0,
        pv_on: 0,
        pv_facts: Atom[],
        pv_marks: u64[],
        pv_trmarks: u64[],
        pv_trail: Atom[],
        pv_pending: Atom[],
        strict_refinements: 0,
        strict_modules: u8[][],
        strict_next: 0,
        strict_here: 0,
        cur_name: u8[],
        cur_file: 0,
        cur_pos: 0,
        ref_next: 0,
        lit_negative: 0,
        byte_start: 0,
        byte_end: 0,
        flit_start: 0,
        flit_end: 0,
        flit_tok: 0,
        flit_neg: 0,
        type_bounds: u64[],
        type_interfaces: u64[][],
        interfaces: Interface[],
        implementations: Implementation[],
        self_type: NO_TYPE,
        current_impl: 0,
        default_copies: u64[],
        assoc_eqs: u64[],
        func_eqs: u64[],
        vtables: u64[],
        dyn_ifaces: u64[],
        headers_complete: 0,
        resources: Resource[],
        loopmark: 0,
        result: NO_TYPE,
        check: ownership::new(),
        members: Member[],
        terminated: 0,
        loopcheck: ownership::new(),
        breaks: ownership::new(),
        hasbreak: 0,
        bonds: Bond[],
        pointers: Pointer[],
        origins: Origin[],
        scope_end: 0,
        loop_start: 0,
        loop_end: 0,
        no_union: 0,
        ignored_failure: 0,
        parsing_input: 0,
        output_region: 0,
        receiver_region: 0,
        input_regions: u64[],
        none_start: 0,
        none_end: 0,
        deny_ambient: 0,
        host_optin: 0,
        host_modules: u8[][],
        cap_denial: 0,
        cap_segs: u8[][],
        iface_dir: u8[],
        iface_use: u8[],
        no_entry: 0,
        iface_used: u8[][],
        body_module: u8[],
        drop_iface: 0,
        drop_generic: 0,
        drop_refs: u64[],
        drop_names: u8[][],
        spec_emitted: u8[][],
        spell_lenient: 0,
        spell_failed: 0,
        drop_emitted: u8[][],
        iface_emit: u8[],
        iface_verify: 0,
        iface_list: IModule[],
        iface_loaded: u8[][],
        iface_loaded_path: u8[][],
        iface_env: u64[],
        iface_env_names: u8[][],
        virt_path: u8[][],
        virt_text: u8[][],
        diag_labels: DiagLabel[],
        diag_help: u8[][],
        diag_primary: u8[],
        lib_owner: u8[][],
        fx_any: 0,
        fx_cur: 0,
        fx_syms: u8[][],
        fx_body: u64[],
        fx_attr_alloc: u64[],
        fx_attr_panic: u64[],
        fx_own_alloc: u64[],
        fx_own_panic: u64[],
        fx_alloc: u64[],
        fx_panic: u64[],
        fx_alloc_thru: u64[],
        fx_panic_thru: u64[],
        fx_fn_name: u8[][],
        fx_fn_file: u64[],
        fx_fn_pos: u64[],
        fx_edge_from: u64[],
        fx_edge_name: u8[][],
        fx_edge_to: u64[],
        fx_edge_kind: u64[],
        fx_edge_file: u64[],
        fx_edge_pos: u64[],
        fx_pending_alloc: 0,
        fx_pending_panic: 0,
        fx_bounded: 0,
        fx_out_start: 0,
        fx_trusted: 0,
        fx_calls: 0,
        fx_skip_lo: 0,
        fx_skip_hi: 0,
        fx_entry_panic: u64[],
        fx_edge_mark: 0,
    };
    exchange(&mut c.target, host::target());
    for k in 5 {
        intern(&mut c, k + 1, 0);
    }
    // `Drop` exists in every program, before any source is parsed (builtin_drop_interface).
    builtin_drop_interface(&mut c);
    host_fn(&mut c, view("target"), 0);
    host_fn(&mut c, view("argc"), 0);
    host_fn(&mut c, view("arg"), 2);
    host_fn(&mut c, view("read_file"), 2);
    host_fn(&mut c, view("write_file"), 0);
    host_fn(&mut c, view("print"), 1);
    host_fn(&mut c, view("print_num"), 1);
    host_fn(&mut c, view("newline"), 1);
    host_fn(&mut c, view("command"), 0);
    host_fn(&mut c, view("command_with"), 0);
    host_fn(&mut c, view("sleep_ms"), 1);
    host_fn(&mut c, view("now_ms"), 0);
    host_fn(&mut c, view("wall_ms"), 0);
    host_fn(&mut c, view("worker_id"), 0);
    host_fn(&mut c, view("workers"), 0);
    numbers := intern(&mut c, 6, 0);
    host_fn(&mut c, view("pipe"), numbers);
    host_fn(&mut c, view("read_fd"), 2);
    host_fn(&mut c, view("write_fd"), 0);
    host_fn(&mut c, view("close"), 0);
    host_fn(&mut c, view("env"), 2);
    host_fn(&mut c, view("exe_path"), 2);
    host_fn(&mut c, view("exists"), 0);
    host_fn(&mut c, view("mkdir"), 0);
    names := intern(&mut c, 6, 2);
    host_fn(&mut c, view("environment"), names);
    host_fn(&mut c, view("list_dir"), names);
    host_fn(&mut c, view("tcp_listen"), 0);
    host_fn(&mut c, view("tcp_port"), 0);
    host_fn(&mut c, view("tcp_accept"), 0);
    host_fn(&mut c, view("tcp_connect"), 0);
    host_fn(&mut c, view("open"), 0);
    host_fn(&mut c, view("exit"), 1);
    host_fn(&mut c, view("remove"), 0);
    host_fn(&mut c, view("create_dir"), 0);
    // The stack where it is called, one `  at NAME (FILE:LINE:COL)` line per frame, or no text when
    // this build carries no tables (runtime.grl rt_backtrace). Empty argument list, owned bytes.
    host_fn(&mut c, view("backtrace"), 2);
    argc := host::argc();
    mut offset = 0;
    if 1 < argc {
        first := host::arg(1);
        if cli::is_command(view(first)) {
            return cli::run();
        }
    }
    while offset + 1 < argc {
        option := host::arg(offset + 1);
        if same(view(option), view("--comptime-probe")) {
            // Internal: this compile builds the probe for a compile-time call. The probe file comes
            // first, so the program's own entry file (which may omit its `module` line) is second.
            exchange(&mut c.probe_mode, 1);
            offset += 1;
        } else if same(view(option), view("--skip-body")) {
            // Internal: a function body an earlier run of this same compile reported an error in
            // (`FILE:POS`). It is skipped, so the run goes on to the next error.
            if argc < offset + 3 {
                fail_option(&mut c, view("--skip-body needs FILE:POS"));
            }
            at := host::arg(offset + 2);
            mut f = 0;
            mut q = 0;
            mut seen_colon = false;
            for i in at.len() {
                ch := at[i];
                if ch == 58 {
                    seen_colon = true;
                } else if seen_colon {
                    q = q * 10 + u64(ch - 48);
                } else {
                    f = f * 10 + u64(ch - 48);
                }
            }
            c.skip_bodies.push(f);
            c.skip_bodies.push(q);
            offset += 2;
        } else if same(view(option), view("--reported")) {
            // Internal: a diagnostic an earlier run of this same compile already printed. A replay
            // that reaches it again is not printed and not counted a second time.
            if argc < offset + 3 {
                fail_option(&mut c, view("--reported needs a key"));
            }
            c.reported.push(copy_bytes(host::arg(offset + 2)));
            offset += 2;
        } else if same(view(option), view("--deny-ambient-host")) || same(view(option), view("--split")) {
            // --split: one assembly file per module. OUT.s is replaced by OUT.NNN.module.s files,
            // and OUT.parts lists them in link order for the driver.
            if same(view(option), view("--split")) {
                exchange(&mut c.split, 1);
            } else {
                exchange(&mut c.deny_ambient, 1);
            }
            offset += 1;
        } else if same(view(option), view("--interface")) || same(view(option), view("--emit-interface")) {
            // B1 stage 2: `--interface DIR` checks every module given as source against
            // `DIR/<module>.iface` (the source is compiled, and its interface must say what the
            // source says); `--emit-interface DIR` writes them. Building a module against other
            // modules' interfaces, without their source, is `--use`.
            if argc < offset + 3 {
                fail_option(&mut c, view("--interface and --emit-interface need a directory"));
            }
            if same(view(option), view("--interface")) {
                exchange(&mut c.iface_dir, host::arg(offset + 2));
                exchange(&mut c.iface_verify, 1);
            } else {
                exchange(&mut c.iface_emit, host::arg(offset + 2));
            }
            offset += 2;
        } else if same(view(option), view("--use")) {
            // B1 stage 3: a directory of interfaces to build *against*. A module whose source is not
            // on the command line is taken from its interface - declarations and generic bodies -
            // and its code is expected in its own object. This is what lets a module be compiled
            // without the source of the modules it imports.
            if argc < offset + 3 {
                fail_option(&mut c, view("--use needs a directory"));
            }
            exchange(&mut c.iface_use, host::arg(offset + 2));
            offset += 2;
        } else if same(view(option), view("--no-entry")) {
            // A run that emits one module's code for a link, not a program: no entry stub, so the
            // process state is defined once, by the run that holds the entry.
            exchange(&mut c.no_entry, 1);
            offset += 1;
        } else if same(view(option), view("--separate")) {
            // One object of a program (B1 stage 4): every definition global, so a part call binds
            // through the linker instead of staying a symbol of this stream.
            exchange(&mut c.separate, 1);
            offset += 1;
        } else if same(view(option), view("--verify-interface")) {
            // Check the interfaces on disk against the sources just parsed instead of trusting
            // either side: an interface that disagrees is refused, naming the declaration.
            exchange(&mut c.iface_verify, 1);
            offset += 1;
        } else {
        if same(view(option), view("--target")) {
            if argc < offset + 3 {
                fail_option(
                    &mut c,
                    view(
                        "--target needs x86_64, aarch64, riscv64, windows-x86_64, windows-aarch64, macos-x86_64 or macos-aarch64"
                    )
                );
            }
            target := host::arg(offset + 2);
            exchange(&mut c.plat, 0);
            if same(view(target), view("x86_64")) {
                exchange(&mut c.target, 0);
            } else {
                if same(view(target), view("aarch64")) {
                    exchange(&mut c.target, 1);
                } else {
                    if same(view(target), view("riscv64")) {
                        exchange(&mut c.target, 2);
                    } else {
                        if same(view(target), view("windows-x86_64")) {
                            exchange(&mut c.target, 3);
                        } else {
                            if same(view(target), view("windows-aarch64")) {
                                exchange(&mut c.target, 4);
                            } else {
                                if same(view(target), view("macos-x86_64")) {
                                    exchange(&mut c.target, 0);
                                    exchange(&mut c.plat, 1);
                                } else {
                                    if same(view(target), view("macos-aarch64")) {
                                        exchange(&mut c.target, 1);
                                        exchange(&mut c.plat, 1);
                                    } else {
                                        fail_option(
                                            &mut c,
                                            view(
                                                "unsupported target (expected x86_64, aarch64, riscv64, windows-x86_64, windows-aarch64, macos-x86_64 or macos-aarch64)"
                                            )
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
            }
            offset += 2;
        } else {
            if same(view(option), view("--overflow=wrap")) {
                exchange(&mut c.overflow, 0);
                offset += 1;
            } else {
                if same(view(option), view("--overflow=checked")) {
                    exchange(&mut c.overflow, 1);
                    offset += 1;
                } else {
                    if same(view(option), view("--export")) {
                        if argc < offset + 3 {
                            fail_option(&mut c, view("--export needs a function name"));
                        }
                        c.exports.push(host::arg(offset + 2));
                        c.export_hits.push(0);
                        offset += 2;
                    } else {
                    if same(view(option), view("--typed-refs")) || same(view(option), view("--default-u64")) {
                        // No-ops, kept for one release. Typed references and the u64 default are the
                        // language's only modes now, so a build script that still passes the old
                        // flags gets exactly the compiler it used to; the next release can drop them.
                        offset += 1;
                    } else {
                        if same(view(option), view("--strict-bool-report")) {
                            // Survey: report every bool/integer violation and keep compiling.
                            exchange(&mut c.strict_bool_report, 1);
                            offset += 1;
                        } else {
                            if same(view(option), view("--debug")) {
                                exchange(&mut c.debug, 1);
                                offset += 1;
                            } else {
                                if same(view(option), view("--backend=llvm")) {
                                    exchange(&mut c.backend, 1);
                                    offset += 1;
                                } else {
                                    if starts_with(view(option), view("--f1-what=")) {
                                        // A test aid: record a deliberately wrong F1 kind so the
                                        // --verify-facts checks can be shown to fire.
                                        mut n = 0;
                                        for d in option.len() - 10 {
                                            n = n * 10 + u64(option[10 + d]) - 48;
                                        }
                                        exchange(&mut c.f1_what, n);
                                        offset += 1;
                                    } else {
                                        if same(view(option), view("--strict-refinements")) {
                                            exchange(&mut c.strict_refinements, 1);
                                            offset += 1;
                                        } else {
                                        if same(view(option), view("--verify-facts")) {
                                            exchange(&mut c.verify_facts, 1);
                                            offset += 1;
                                        } else {
                                            if same(view(option), view("--range-facts")) {
                                                exchange(&mut c.range_facts, 1);
                                                offset += 1;
                                            } else if same(view(option), view("--no-error-sites")) {
                                                // No call-site table: runtime errors print their
                                                // message without a location (tools comparing a
                                                // build with a --split one byte for byte).
                                                exchange(&mut c.no_sites, 1);
                                                offset += 1;
                                            } else {
                                                break;
                                            }
                                        }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
        }
    }
    exchange(&mut c.arg_offset, offset);
    // Interfaces are checked against the manifest the emitting run wrote before anything reads one.
    mut iface_dir = c.iface_dir.copy();
    if iface_dir.len() != 0 {
        iface_check_manifest(&mut c, view(iface_dir));
    }
    if c.iface_use.len() != 0 {
        used := c.iface_use.copy();
        iface_load_used(&mut c, view(used));
    }
    n := argc - offset;
    if !(2 < n) {
        fail_option(
            &mut c,
            view(
                "usage: grail [--target ARCH] [--overflow=checked|wrap] [--debug] [--verify-facts] [--strict-refinements] [--deny-ambient-host] [--split] OUT.s ENTRY.grl MODULE.grl..."
            )
        );
    }
    // DWARF on Linux x86-64, AArch64 and RISC-V 64; CodeView line tables (a PDB through lld-link
    // /DEBUG) on Windows x86-64.
    if (c.debug != 0) && (((c.target == 4) || (c.plat != 0))) {
        fail_option(&mut c, view("--debug line info is only implemented for Linux and Windows x86_64"));
    }
    if (c.backend != 0) && (((c.target > 2) || (c.plat != 0) || (c.debug != 0))) {
        fail_option(&mut c, view("--backend=llvm is implemented for Linux x86_64, aarch64 and riscv64 without --debug"));
    }
    if (c.verify_facts != 0) && (c.backend == 0) {
        // On the native backend the flag checks the refinements the prover discharged: every one of
        // them still emits its runtime check, so a wrong proof aborts instead of going unnoticed.
        exchange(&mut c.verify_facts, 2);
    }
    if (c.range_facts != 0) && (c.backend == 0) {
        fail_option(&mut c, view("--range-facts derives range facts in the LLVM lifter; add --backend=llvm"));
    }
    // Splitting is a build-shape change on the native assembly path; the line tables and the LLVM
    // route inspect the whole stream, and the Mach-O/PE writers rewrite it after selection.
    if (c.split != 0) && ((c.target != 0) || (c.plat != 0) || (c.debug != 0) || (c.backend != 0)) {
        fail_option(
            &mut c,
            view("--split is implemented for the Linux x86_64 assembler path, without --debug")
        );
    }
    for pass in 3 {
        if pass == 1 {
            if c.plat == 1 {
                o(&mut c, view(".build_version macos, 11, 0\n"));
            }
            if c.debug != 0 {
                mut f = 2;
                while f < n {
                    path := host::arg(f + offset);
                    number := f - 1;
                    if c.target == 3 {
                        o(&mut c, view(".cv_file "));
                    } else {
                        o(&mut c, view(".file "));
                    }
                    on(&mut c, number);
                    o(&mut c, view(" \""));
                    emit_path(&mut c, view(path));
                    o(&mut c, view("\"\n"));
                    f += 1;
                }
            }
            // With --split every part file re-states `.text`; the stream carries no preamble.
            if c.split == 0 {
                o(&mut c, view(".text\n"));
            }
        }
        mut i = 2;
        while i < n {
            path := host::arg(i + offset);
            load_file(&mut c, i);
            exchange(&mut c.file, i);
            toplevel(&mut c, pass + 1);
            if pass == 0 {
                c
                    .iface_list
                    .push(
                        IModule {
                            module: module_copy(&mut c),
                            path: path.copy(),
                            std: in_std_dir(view(path)),
                            unsafe: c.raw,
                            host: 0
                        }
                    );
            }
            i = i + 1;
        }
        if pass == 2 {
            default_methods(&mut c, 3);
        }
        // The definition sweep for the interfaces read above, once every module's names exist.
        // `--interface` and `--use` both land here; the path each interface came from was recorded
        // when its names were registered.
        if (pass == 0) & (c.iface_verify == 0) {
            for k in c.iface_loaded.len() {
                file := c.iface_loaded_path[k].copy();
                iface_load(&mut c, view(file), view(""), 2);
            }
        }
        if pass == 1 {
            default_methods(&mut c, 2);
            exchange(&mut c.headers_complete, 1);
            check_interfaces(&mut c);
            validate_type_constraints(&mut c);
            if c.iface_verify != 0 {
                for j in c.iface_list.len() {
                    if !same(view(c.iface_list[j].module), view("runtime")) {
                        iface_verify_module(&mut c, j);
                    }
                }
            }
            iface_emit_all(&mut c);
        }
    }
    // Every definition has been emitted by now, so an --export name that never matched is a typo.
    for i in c.exports.len() {
        if c.export_hits[i] == 0 {
            host::print(view("grail: export '"));
            missing := &c.exports[i];
            host::print(view(missing));
            host::print(view("' is not defined by any function\n"));
            host::exit(1);
        }
    }
    // Requests are read once every declaration is known: a request names a template and the types
    // to instantiate it with, which is all `specialize` needs to add the body to this build.
    // Constants a compile-time call gives that nothing used are evaluated now (C3).
    resolve_all_pending(&mut c);
    emit_specializations(&mut c);
    // A closure body can instantiate a generic (`Some(x)` inside `|| ...`) and a specialisation can
    // create a closure, so the two are emitted to a fixpoint; request files are written once both
    // lists are complete.
    mut specs_done = c.specs.len();
    mut closures_done = emit_closures(&mut c, 0);
    while (specs_done < c.specs.len()) || (closures_done < c.closures.len()) {
        specs_done = drain_specs(&mut c, specs_done);
        closures_done = emit_closures(&mut c, closures_done);
    }
    emit_fn_thunk(&mut c);
    emit_drops(&mut c);
    // A drop helper can be the first thing to ask for a generic `Drop` implementation's
    // specialisation, so anything it requested is emitted before the helpers are written out.
    helpers_specs := c.specs.len();
    while (specs_done < c.specs.len()) || (closures_done < c.closures.len()) {
        specs_done = drain_specs(&mut c, specs_done);
        closures_done = emit_closures(&mut c, closures_done);
    }
    if specs_done != helpers_specs {
        // Those bodies can intern more types, and a type with no helper is an undefined symbol.
        emit_drops(&mut c);
    }
    emit_vtables(&mut c);
    // A vtable's drop slot is a helper too, and the bodies emitted above were the first to name
    // some types: one more sweep costs a walk of the type table and leaves no symbol undefined.
    emit_drops(&mut c);
    fx_end(&mut c);
    // Every body is emitted: the effect claims are settled over the whole call graph.
    fx_solve(&mut c);
    fx_report(&mut c);
    if c.skip_bodies.len() != 0 {
        // Every error this compile has is reported; the program is still rejected, and nothing it
        // would have written is.
        error_summary(c.reported.len());
        host::exit(1);
    }
    if c.no_entry != 0 {
        // A run that emits one module's code for a link, not a program (B1 stage 3): the entry stub
        // and the process state belong to the run that holds the entry, so the linker sees one
        // `_start` and one `rt_state` however many objects a build has. The stack note still has to
        // be here, or the linker is entitled to warn about an executable stack.
        o(&mut c, view(".section .note.GNU-stack,\"\",@progbits\n"));
    } else {
    e := c.entry;
    if e == 0 {
        fail(&mut c, view("no public entry function with at most one parameter"));
    }
    f := &c.funcs[e - 1];
    m := f.module.copy();
    name := f.name.copy();
    count := f.count;
    result := f.ret;
    first := f.first;
    named_main := same(view(name), view("main"));
    if named_main {
        if (result != 0) & (result != 1) {
            fail(&mut c, view("main must return unit or u64"));
        }
    } else {
        if result != 0 {
            fail(&mut c, view("executable entry must return u64"));
        }
    }
    if count == 1 {
        param := c.params[first];
        mode := ty_mode(&mut c, param);
        if ty_kind(&mut c, param) != 5 || mode != 0 {
            fail(&mut c, view("executable entry requires readonly argv view"));
        }
    }
    // The entry stub and the process state (rt_state, the TLS bases, .note.GNU-stack) exist once per
    // program and belong to no module, so they get their own synthetic part.
    part(&mut c, view("__start"));
    if (c.target == 3) {
        // A PE image starts without arguments: the loader leaves argv to the runtime, which reads
        // the Win32 command line. The process state words start empty and are filled by
        // rt_thread_init before the entry function runs. The thread bridge address is published
        // for CreateThread.
        o(
            &mut c,
            view(
                ".globl grail_entry\ngrail_entry:\nxorl %eax,%eax\nmovq %rax,rt_state(%rip)\nmovq %rax,rt_state+8(%rip)\nmovq %rax,rt_state+16(%rip)\nleaq rt_win_thread_start(%rip),%rax\nmovq %rax,rt_state+3392(%rip)\nandq $-16,%rsp\ncall rt_thread_init\nmovq rt_state(%rip),%rdi\n"
            )
        );
    } else {
    if c.target == 4 {
        o(
            &mut c,
            view(
                ".globl grail_entry\ngrail_entry:\nxorl %eax,%eax\nmovq %rax,rt_state(%rip)\nmovq %rax,rt_state+8(%rip)\nmovq %rax,rt_state+16(%rip)\nleaq rt_win_thread_start(%rip),%rax\nmovq %rax,rt_state+3392(%rip)\nandq $-16,%rsp\ncall rt_thread_init\nmovq rt_state(%rip),%rdi\n"
            )
        );
    
    } else {
        if c.plat == 1 {
            // libSystem's start calls _main(argc, argv, envp) with a 16-byte-aligned frame and an
            // installed stack guard; envp is the third argument here, not a stack slot.
            o(
                &mut c,
                view(".globl _main\n.p2align 4\n_main:\npushq %rbp\nmovq %rsp,%rbp\nmovq %rdi,_rt_state(%rip)\nmovq %rsi,_rt_state+8(%rip)\nmovq %rdx,_rt_state+16(%rip)\ncall _rt_thread_init\nmovq _rt_state(%rip),%rdi\n")
            );
        } else {
            o(
                &mut c,
                view(".globl _start\n_start:\nmovq (%rsp),%rdi\nleaq 8(%rsp),%rsi\nleaq 16(%rsp,%rdi,8),%rdx\nmovq %rdi,rt_state(%rip)\nmovq %rsi,rt_state+8(%rip)\nmovq %rdx,rt_state+16(%rip)\nandq $-16,%rsp\n")
            );
        }
    }
    }
    if site_table_on(&c) && (c.no_entry == 0) {
        // Where a runtime error can find the call-site table (runtime.grl rt_fail_where).
        o(&mut c, view("leaq rt_sites(%rip),%rax\nmovq %rax,rt_state+3400(%rip)\n"));
    }
    if tls_bridge(&mut c) {
        // Record the loader's TLS base before the runtime installs its own worker record.
        tls_capture(&mut c);
    }
    if (c.target != 3) & (c.target != 4) {
        if c.plat == 0 {
            o(&mut c, view("call rt_thread_init\nmovq rt_state(%rip),%rdi\n"));
        }
    }
    if count == 1 {
        ok := label(&mut c);
        o(&mut c, view("cmpq $2,%rdi\n"));
        jump(&mut c, view("je"), ok);
        emit_exit(&mut c, view("movl $2,%edi\n"));
        mark(&mut c, ok);
        o(
            &mut c,
            view("movl $1,%edi\ncall f_host_arg\nmovq %rax,%r12\nmovq %rax,%rdi\ncall rt_view\nmovq %rax,%rdi\n")
        );
    }
    o(&mut c, view("call "));
    mangle(&mut c, view(m), view(name));
    if count == 1 {
        o(&mut c, view("\nmovq %rax,%r13\nmovq %r12,%rdi\ncall rt_drop_seq\nmovq %r13,%rax"));
    }
    if named_main {
        if result == 0 {
            o(&mut c, view("\nmovq %rax,%r14\n"));
        } else {
            o(&mut c, view("\nxorq %r14,%r14\n"));
        }
    } else {
        o(&mut c, view("\nmovq %rax,%rdi\ncall rt_print_num\nxorq %r14,%r14\n"));
    }
    // The leak check: balanced -> return, a leak -> abort, a leak after a contained task failure ->
    // a note on fd 2 and a normal exit (rt_leak_exit; see task-failure-containment.md).
    o(&mut c, view("call rt_leak_exit\n"));
    o(&mut c, view("call rt_shutdown\n"));
    emit_exit(&mut c, view("movq %r14,%rdi\n"));
    if c.target == 3 {
        o(
            &mut c,
            view(
                "ud2\nrt_win_thread_start:\nsubq $56,%rsp\nmovq %rdi,32(%rsp)\nmovq %rsi,40(%rsp)\nmovq %rcx,%rdi\ncall rt_win_thread_main\nmovq 32(%rsp),%rdi\nmovq 40(%rsp),%rsi\naddq $56,%rsp\nret\n.bss\n.p2align 3\nrt_state: .zero 4096\n"
            )
        );
    } else {
    if c.target == 4 {
        // CreateThread's start routine on ARM64: the thread record arrives in x0, which is the
        // first argument register of Grail's lowered calls too, and x19-x28/d8-d15 are
        // callee-saved in both conventions; a framed call is the whole bridge.
        o(
            &mut c,
            view(
                "ud2\nrt_win_thread_start:\npushq %rbp\nmovq %rsp,%rbp\ncall rt_win_thread_main\npopq %rbp\nret\n.bss\n.p2align 3\nrt_state: .zero 4096\n"
            )
        );
    } else {
    if (c.target == 3) || (c.target == 4) {
        o(&mut c, view("ud2\n.bss\n.p2align 3\nrt_state: .zero 4096\n"));
    } else {
        if c.plat == 1 {
            o(
                &mut c,
                view("ud2\n.section __DATA,__bss\n.p2align 3\n_rt_state:\n.space 4096\n")
            );
        } else {
            tls_bss(&mut c);
        }
    }
    }
    }
    }
    mut out = u8[];
    if (c.debug != 0) || (c.backend != 0) {
        out = copy_bytes(view(c.out));
    } else {
        if c.split != 0 {
            out = optimize::optimize_parts(view(c.out), 1, &mut c.marks, &mut c.part_names);
        } else {
            out = optimize::optimize(view(c.out));
        }
    }
    if site_table_on(&c) {
        tabled := site_table(&mut c, view(out));
        out = tabled;
    }
    if c.plat == 1 {
        prefixed := darwinify(view(out));
        out = prefixed;
    }
    path := host::arg(1 + offset);
    target := c.target;
    if (target == 0) || (target == 3) {
        if target == 3 {
            // PE/COFF unwind data must be emitted from the final frame sizes.
            mut image = win_unwind(view(out));
            if c.debug != 0 {
                image = debug_locs(view(image));
                // CodeView: the symbol records (functions with their typed locals), one line table
                // per recorded function, then the file checksums and the string table they index;
                // lld-link /DEBUG builds the PDB from this section.
                mut index = u64[];
                types := codeview_types(&c, &mut index);
                push_bytes(&mut image, view(".section .debug$S,\"dr\"\n.p2align 2\n.long 4\n"));
                symbols := codeview_symbols(&c, &index);
                push_bytes(&mut image, view(symbols));
                for i in c.debug_funcs.len() {
                    push_bytes(&mut image, view(".cv_linetable "));
                    decimal(&mut image, i);
                    push_bytes(&mut image, view(", "));
                    fstart := c.debug_funcs[i].start;
                    fend := c.debug_funcs[i].end;
                    funit := c.debug_funcs[i].unit.copy();
                    dlabel(&mut image, view(funit), fstart);
                    push_bytes(&mut image, view(", "));
                    dlabel(&mut image, view(funit), fend);
                    image.push(10);
                }
                push_bytes(&mut image, view(".cv_filechecksums\n.cv_stringtable\n"));
                push_bytes(&mut image, view(types));
            }
            return write_image(&mut c, view(path), view(image));
        }
        if c.debug != 0 {
            out = debug_locs(view(out));
            sections := debug_sections(&c, view(host::arg(2 + offset)));
            for i in sections.len() {
                out.push(sections[i]);
            }
        }
        if c.backend != 0 {
            // LLVM IR for the lifted functions beside the native remainder: PATH.ll and PATH.
            lowered := llvm::lower(view(out), view("x86_64-unknown-linux-gnu"), &c.facts, c.verify_facts, c.range_facts);
            mut ir_path = copy_bytes(view(path));
            push_bytes(&mut ir_path, view(".ll"));
            written := host::write_file(view(ir_path), view(lowered.ir));
            if written != 0 {
                return written;
            }
            return write_image(&mut c, view(path), view(lowered.native));
        }
        return write_image(&mut c, view(path), view(out));
    }
    if c.debug != 0 {
        // The .loc/.file directives pass through instruction selection unchanged; the DWARF
        // sections refer only to labels, so they are appended after lowering.
        out = debug_locs(view(out));
    }
    if c.backend != 0 {
        // LLVM IR (PATH.ll) for the lifted functions; the remainder goes through the usual
        // instruction selection, followed by the calling-convention thunks.
        lowered := llvm::lower_for(view(out), target, &c.facts, c.verify_facts, c.range_facts);
        mut ir_path = copy_bytes(view(path));
        push_bytes(&mut ir_path, view(".ll"));
        written := host::write_file(view(ir_path), view(lowered.ir));
        if written != 0 {
            return written;
        }
        mut image = machine::lower(view(lowered.native), target, c.plat);
        push_bytes(&mut image, view(lowered.thunks));
        return write_image(&mut c, view(path), view(image));
    }
    mut native = machine::lower(view(out), target, c.plat);
    if c.debug != 0 {
        sections := debug_sections(&c, view(host::arg(2 + offset)));
        for i in sections.len() {
            native.push(sections[i]);
        }
    }
    if target == 4 {
        image := arm_unwind(view(native));
        return write_image(&mut c, view(path), view(image));
    }
    return write_image(&mut c, view(path), view(native));
}
