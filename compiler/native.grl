            target := host::arg(offset + 2);
            exchange(&mut c.plat, 0);
            if same(view(target), view("x86_64")) {
                exchange(&mut c.target, 0);
            } else {
                if same(view(target), view("aarch64")) {
                    exchange(&mut c.target, 1);
                } else {
                    if same(view(target), view("riscv64")) {
                        exchange(&mut c.target, 2);
                    } else {
                        if same(view(target), view("windows-x86_64")) {
                            exchange(&mut c.target, 3);
                        } else {
                            if same(view(target), view("windows-aarch64")) {
                                exchange(&mut c.target, 4);
                            } else {
                                if same(view(target), view("macos-x86_64")) {
                                    exchange(&mut c.target, 0);
                                    exchange(&mut c.plat, 1);
                                } else {
                                    if same(view(target), view("macos-aarch64")) {
                                        exchange(&mut c.target, 1);
                                        exchange(&mut c.plat, 1);
                                    } else {
                                        fail_option(
                                            &mut c,
                                            view(
                                                "unsupported target (expected x86_64, aarch64, riscv64, windows-x86_64, windows-aarch64, macos-x86_64 or macos-aarch64)"
                                            )
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
            }
            offset += 2;
        } else {
            if same(view(option), view("--overflow=wrap")) {
                exchange(&mut c.overflow, 0);
                offset += 1;
            } else {
                if same(view(option), view("--overflow=checked")) {
                    exchange(&mut c.overflow, 1);
                    offset += 1;
                } else {
                    if same(view(option), view("--export")) {
                        if argc < offset + 3 {
                            fail_option(&mut c, view("--export needs a function name"));
                        }
                        c.exports.push(host::arg(offset + 2));
                        c.export_hits.push(0);
                        offset += 2;
                    } else {
                    if same(view(option), view("--typed-refs")) || same(view(option), view("--strict-bool-report")) {
