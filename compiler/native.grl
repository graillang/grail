                argtypes.push(v.ty);
                held := move_value(&mut c, v);
                sources.push(held.t);
                args.push(held.t);
                if order.len() != 0 {
                    if c.pos != ranges[2 * order[slot_k] + 1] {
                        fail(&mut c, view("expected , or ) after an argument"));
