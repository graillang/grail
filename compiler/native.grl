// ---- sized integers: kind 18 (arg = bits, mode = signed). ----
fn starts_with<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() < y.len() {
        return false;
    }
    for i in y.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
// ---- exact decimal -> binary64 conversion for float literals (base 2^32 bignums) ----
fn big_mul_add<a>(x: (&a mut u64[]), m: u64, add: u64) -> unit {
    mut carry = add;
    for i in x.len() {
        t := x[i] * m + carry;
        exchange(&mut x[i], t % 4294967296);
        carry = t / 4294967296;
    }
    while carry != 0 {
        x.push(carry % 4294967296);
        carry = carry / 4294967296;
    }
    return ();
}
fn big_shl<a>(x: (&a u64[]), n: u64) -> u64[] {
    words := n / 32;
    bits := n % 32;
    mut out = u64[];
    for i in words {
        out.push(0);
    }
    mut carry = 0;
    mut scale = 1;
    for i in bits {
        scale = scale * 2;
    }
    for i in x.len() {
        t := x[i] * scale + carry;
        out.push(t % 4294967296);
        carry = t / 4294967296;
    }
    if carry != 0 {
        out.push(carry);
    }
    return out;
}
fn big_trim<a>(x: (&a mut u64[])) -> unit {
    while x.len() != 0 {
        if x[x.len() - 1] != 0 {
            break;
        }
        x.pop();
    }
    return ();
}
fn big_bits<a>(x: (&a u64[])) -> u64 {
    if x.len() == 0 {
        return 0;
    }
    mut top = x[x.len() - 1];
    mut b = 0;
    while top != 0 {
        top = top / 2;
        b += 1;
    }
    return (x.len() - 1) * 32 + b;
}
// 0 less, 1 equal, 2 greater (both trimmed)
fn big_cmp<a, b>(x: (&a u64[]), y: (&b u64[])) -> u64 {
    if x.len() < y.len() {
        return 0;
    }
    if y.len() < x.len() {
        return 2;
    }
    mut i = x.len();
    while 0 < i {
        i -= 1;
        if x[i] < y[i] {
            return 0;
        }
        if y[i] < x[i] {
            return 2;
        }
    }
    return 1;
}
fn big_sub<a, b>(x: (&a mut u64[]), y: (&b u64[])) -> unit {
    mut borrow = 0;
    for i in x.len() {
        mut sub = borrow;
        if i < y.len() {
            sub += y[i];
        }
        v := x[i];
        if v < sub {
            exchange(&mut x[i], v + 4294967296 - sub);
            borrow = 1;
        } else {
            exchange(&mut x[i], v - sub);
            borrow = 0;
        }
    }
    big_trim(&mut x);
    return ();
}
fn big_shr1<a>(x: (&a mut u64[])) -> unit {
    mut carry = 0;
    mut i = x.len();
    while 0 < i {
        i -= 1;
        v := x[i];
        exchange(&mut x[i], v / 2 + carry * 2147483648);
        carry = v % 2;
    }
    big_trim(&mut x);
    return ();
}
fn float_bits<a, b>(c: (&a mut C), text: &b [u8]) -> u64 {
