    if id == 50 {
        // `free(p)`: release an `alloc`ed block. Nothing in the types tracks whether the block is
        // still reachable from another pointer: that is the caller's contract, as in C.
        raw_pointer_gate(&mut c, view("free"));
        a := expr(&mut c, 0);
        expect(&mut c, view(")"));
        x := deref(&mut c, a);
        if ty_kind(&mut c, x.ty) != 34 {
            fail(&mut c, view("free takes a raw pointer"));
        }
        pslot := invoke(&mut c, view("rt_free"), one(x.t));
        return val(imm(&mut c, 0), intern(&mut c, 2, 0));
    }
    if id == 51 {
        // `ptr_from_addr(T, a)`: a `*mut T` at the address `a`. An address carries no provenance, so
        // the pointer it makes is the writable kind and the caller vouches for it.
        raw_pointer_gate(&mut c, view("ptr_from_addr"));
        elem := parse_type(&mut c);
        expect(&mut c, view(","));
        av := expr(&mut c, 0);
        expect(&mut c, view(")"));
        ax := deref(&mut c, av);
        if !integer(&mut c, ax.ty) {
            fail(&mut c, view("ptr_from_addr takes a u64 address"));
        }
        return val(ax.t, intern_full(&mut c, 34, elem, 1, u64[]));
    }
    if id == 47 {
        // `cslice(T, p, n)`: copy the `n` elements of C type `T` at `p` (a C array C handed out by
        // pointer and length) into a Grail vector, which is then bounds-checked like any other.
        // Unsafe: C must have handed out at least n elements, alive for the copy.
        if (c.raw == 0) & (c.unsafe_depth == 0) {
            fail(&mut c, view("cslice requires an unsafe block"));
        }
        elem := parse_type(&mut c);
        ek := ty_kind(&mut c, elem);
        if !integer(&mut c, elem) & !is_f32(&mut c, elem) & (is_c_record(&mut c, elem) == 0) & (ek != 24) & (ek != 26) {
            fail(&mut c, view("cslice copies integers, f32, CStr, CPtr or extern records"));
        }
