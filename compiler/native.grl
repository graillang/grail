        }
        return true;
    }
    return false;
}
// Index + 1 of `name` in `names`, or 0.
fn capture_index<a, b>(names: (&a u8[][]), name: &b [u8]) -> u64 {
    for j in names.len() {
        x := &names[j];
        if same(view(x), view(name)) {
            return j + 1;
        }
    }
    return 0;
}
// Index + 1 of a capture of the closure being compiled, or 0.
fn capture_of<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    current := c.closure_env;
    if current == 0 {
        return 0;
    }
    cl := &c.closures[current - 1];
    for j in cl.captures.len() {
        x := &cl.captures[j];
        if same(view(x), view(name)) {
            return j + 1;
        }
    }
    return 0;
