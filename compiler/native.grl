    if (ty_mode(&mut c, v.ty) != 0) || (ty_mode(&mut c, formal) != 1) {
        return v;
    }
    result := ty_arg(&mut c, v.ty);
    regions := type_regions(&mut c, v.ty);
    args := type_args(&mut c, v.ty);
    widened := intern_args(&mut c, 20, result, 1, regions, args);
    return move_as(&mut c, v, widened);
}
// `&mut Fn(...)` used where `&mut FnMut(...)` is expected: same referent, same loan, wider call
// contract. Only the reference's own type changes, so nothing is copied or re-owned.
fn reference_as_fnmut<a>(c: (&a mut C), slot: u64, ty: u64, expected: u64) -> u64 {
    if ty_mode(&mut c, ty) != 1 {
        return 0;
    }
    if ty_mode(&mut c, expected) != 1 {
        return 0;
    }
    inner := ty_arg(&mut c, ty);
    want := ty_arg(&mut c, expected);
    if fn_as_fnmut(&mut c, inner, want) == 0 {
        return 0;
