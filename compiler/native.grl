                        if same(view(option), view("--strict-bool-report")) {
                            exchange(&mut c.strict_bool_report, 1);
                        }
                        if same(view(option), view("--typed-refs")) {
                            exchange(&mut c.typed_refs_flag, 1);
                        }
                        offset += 1;
                    } else {

                        if same(view(option), view("--default-u64")) {
                            exchange(&mut c.default_u64, 1);
                            exchange(&mut c.default_u64_flag, 1);
                            offset += 1;
                        } else {
                            if same(view(option), view("--debug")) {
                                exchange(&mut c.debug, 1);
                                offset += 1;
                            } else {
                                if same(view(option), view("--backend=llvm")) {
                                    exchange(&mut c.backend, 1);
                                    offset += 1;
                                } else {
                                    if starts_with(view(option), view("--f1-what=")) {
                                        // A test aid: record a deliberately wrong F1 kind so the
                                        // --verify-facts checks can be shown to fire.
                                        mut n = 0;
                                        for d in option.len() - 10 {
                                            n = n * 10 + u64(option[10 + d]) - 48;
                                        }
                                        exchange(&mut c.f1_what, n);
                                        offset += 1;
                                    } else {
                                        if same(view(option), view("--verify-facts")) {
                                            exchange(&mut c.verify_facts, 1);
                                            offset += 1;
                                        } else {
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
        }
    }
    exchange(&mut c.arg_offset, offset);
    n := argc - offset;
    if !(2 < n) {
        fail_option(
            &mut c,
            view(
                "usage: grail [--target ARCH] [--overflow=checked|wrap] [--debug] [--backend=llvm [--verify-facts]] [--deny-ambient-host] [--split] OUT.s ENTRY.grl MODULE.grl..."
            )
        );
    }
    // DWARF on Linux x86-64, AArch64 and RISC-V 64; CodeView line tables (a PDB through lld-link
    // /DEBUG) on Windows x86-64.
    if (c.debug != 0) && (((c.target == 4) || (c.plat != 0))) {
        fail_option(&mut c, view("--debug line info is only implemented for Linux and Windows x86_64"));
    }
    if (c.backend != 0) && (((c.target > 2) || (c.plat != 0) || (c.debug != 0))) {
        fail_option(&mut c, view("--backend=llvm is implemented for Linux x86_64, aarch64 and riscv64 without --debug"));
    }
    if (c.verify_facts != 0) && (c.backend == 0) {
        fail_option(&mut c, view("--verify-facts checks the facts the LLVM lifter consumes; add --backend=llvm"));
    }
    // Splitting is a build-shape change on the native assembly path; the line tables and the LLVM
    // route inspect the whole stream, and the Mach-O/PE writers rewrite it after selection.
    if (c.split != 0) && ((c.target != 0) || (c.plat != 0) || (c.debug != 0) || (c.backend != 0)) {
        fail_option(
            &mut c,
            view("--split is implemented for the Linux x86_64 assembler path, without --debug")
        );
    }
    for pass in 3 {
        if pass == 1 {
            if c.plat == 1 {
                o(&mut c, view(".build_version macos, 11, 0\n"));
            }
            if c.debug != 0 {
                mut f = 2;
                while f < n {
                    path := host::arg(f + offset);
                    number := f - 1;
                    if c.target == 3 {
                        o(&mut c, view(".cv_file "));
                    } else {
                        o(&mut c, view(".file "));
                    }
                    on(&mut c, number);
                    o(&mut c, view(" \""));
                    emit_path(&mut c, view(path));
                    o(&mut c, view("\"\n"));
                    f += 1;
                }
            }
            // With --split every part file re-states `.text`; the stream carries no preamble.
            if c.split == 0 {
                o(&mut c, view(".text\n"));
            }
        }
        mut i = 2;
        while i < n {
            load_file(&mut c, i);
            exchange(&mut c.file, i);
            toplevel(&mut c, pass + 1);
            i = i + 1;
        }
        if pass == 1 {
            exchange(&mut c.headers_complete, 1);
            check_interfaces(&mut c);
            validate_type_constraints(&mut c);
        }
    }
    // Every definition has been emitted by now, so an --export name that never matched is a typo.
    for i in c.exports.len() {
        if c.export_hits[i] == 0 {
            host::print(view("grail: export '"));
            missing := &c.exports[i];
            host::print(view(missing));
            host::print(view("' is not defined by any function\n"));
            host::exit(1);
        }
    }
    emit_specializations(&mut c);
    emit_closures(&mut c);
    emit_fn_thunk(&mut c);
    emit_drops(&mut c);
    e := c.entry;
    if e == 0 {
        fail(&mut c, view("no public entry function with at most one parameter"));
    }
    f := &c.funcs[e - 1];
    m := f.module.copy();
    name := f.name.copy();
    count := f.count;
    result := f.ret;
    first := f.first;
    named_main := same(view(name), view("main"));
    if named_main {
        if (result != 0) & (result != 1) {
            fail(&mut c, view("main must return unit or u64"));
        }
    } else {
        if result != 0 {
            fail(&mut c, view("executable entry must return u64"));
        }
    }
    if count == 1 {
        param := c.params[first];
        mode := ty_mode(&mut c, param);
        if ty_kind(&mut c, param) != 5 || mode != 0 {
            fail(&mut c, view("executable entry requires readonly argv view"));
        }
    }
    // The entry stub and the process state (rt_state, the TLS bases, .note.GNU-stack) exist once per
    // program and belong to no module, so they get their own synthetic part.
    part(&mut c, view("__start"));
    if (c.target == 3) {
        // A PE image starts without arguments: the loader leaves argv to the runtime, which reads
        // the Win32 command line. The process state words start empty and are filled by
        // rt_thread_init before the entry function runs. The thread bridge address is published
        // for CreateThread.
        o(
            &mut c,
            view(
                ".globl grail_entry\ngrail_entry:\nxorl %eax,%eax\nmovq %rax,rt_state(%rip)\nmovq %rax,rt_state+8(%rip)\nmovq %rax,rt_state+16(%rip)\nleaq rt_win_thread_start(%rip),%rax\nmovq %rax,rt_state+3392(%rip)\nandq $-16,%rsp\ncall rt_thread_init\nmovq rt_state(%rip),%rdi\n"
            )
        );
    } else {
    if c.target == 4 {
        o(
            &mut c,
            view(
                ".globl grail_entry\ngrail_entry:\nxorl %eax,%eax\nmovq %rax,rt_state(%rip)\nmovq %rax,rt_state+8(%rip)\nmovq %rax,rt_state+16(%rip)\nleaq rt_win_thread_start(%rip),%rax\nmovq %rax,rt_state+3392(%rip)\nandq $-16,%rsp\ncall rt_thread_init\nmovq rt_state(%rip),%rdi\n"
            )
        );
    
    } else {
        if c.plat == 1 {
            // libSystem's start calls _main(argc, argv, envp) with a 16-byte-aligned frame and an
            // installed stack guard; envp is the third argument here, not a stack slot.
            o(
                &mut c,
                view(".globl _main\n.p2align 4\n_main:\npushq %rbp\nmovq %rsp,%rbp\nmovq %rdi,_rt_state(%rip)\nmovq %rsi,_rt_state+8(%rip)\nmovq %rdx,_rt_state+16(%rip)\ncall _rt_thread_init\nmovq _rt_state(%rip),%rdi\n")
            );
        } else {
            o(
                &mut c,
                view(".globl _start\n_start:\nmovq (%rsp),%rdi\nleaq 8(%rsp),%rsi\nleaq 16(%rsp,%rdi,8),%rdx\nmovq %rdi,rt_state(%rip)\nmovq %rsi,rt_state+8(%rip)\nmovq %rdx,rt_state+16(%rip)\nandq $-16,%rsp\n")
            );
        }
    }
    }
    if tls_bridge(&mut c) {
        // Record the loader's TLS base before the runtime installs its own worker record.
        tls_capture(&mut c);
    }
    if (c.target != 3) & (c.target != 4) {
        if c.plat == 0 {
            o(&mut c, view("call rt_thread_init\nmovq rt_state(%rip),%rdi\n"));
        }
    }
    if count == 1 {
        ok := label(&mut c);
        o(&mut c, view("cmpq $2,%rdi\n"));
        jump(&mut c, view("je"), ok);
        emit_exit(&mut c, view("movl $2,%edi\n"));
        mark(&mut c, ok);
        o(
            &mut c,
            view("movl $1,%edi\ncall f_host_arg\nmovq %rax,%r12\nmovq %rax,%rdi\ncall rt_view\nmovq %rax,%rdi\n")
        );
    }
    o(&mut c, view("call "));
    mangle(&mut c, view(m), view(name));
    if count == 1 {
        o(&mut c, view("\nmovq %rax,%r13\nmovq %r12,%rdi\ncall rt_drop_seq\nmovq %r13,%rax"));
    }
    if named_main {
        if result == 0 {
            o(&mut c, view("\nmovq %rax,%r14\n"));
        } else {
            o(&mut c, view("\nxorq %r14,%r14\n"));
        }
    } else {
        o(&mut c, view("\nmovq %rax,%rdi\ncall rt_print_num\nxorq %r14,%r14\n"));
    }
    o(&mut c, view("call rt_live\ntestq %rax,%rax\n"));
    balanced := label(&mut c);
    jump(&mut c, view("jz"), balanced);
    o(&mut c, view("call rt_abort\n"));
    mark(&mut c, balanced);
    o(&mut c, view("call rt_shutdown\n"));
    emit_exit(&mut c, view("movq %r14,%rdi\n"));
    if c.target == 3 {
        o(
            &mut c,
            view(
                "ud2\nrt_win_thread_start:\nsubq $56,%rsp\nmovq %rdi,32(%rsp)\nmovq %rsi,40(%rsp)\nmovq %rcx,%rdi\ncall rt_win_thread_main\nmovq 32(%rsp),%rdi\nmovq 40(%rsp),%rsi\naddq $56,%rsp\nret\n.bss\n.p2align 3\nrt_state: .zero 4096\n"
            )
        );
    } else {
    if c.target == 4 {
        // CreateThread's start routine on ARM64: the thread record arrives in x0, which is the
        // first argument register of Grail's lowered calls too, and x19-x28/d8-d15 are
        // callee-saved in both conventions; a framed call is the whole bridge.
        o(
            &mut c,
            view(
                "ud2\nrt_win_thread_start:\npushq %rbp\nmovq %rsp,%rbp\ncall rt_win_thread_main\npopq %rbp\nret\n.bss\n.p2align 3\nrt_state: .zero 4096\n"
            )
        );
    } else {
    if (c.target == 3) || (c.target == 4) {
        o(&mut c, view("ud2\n.bss\n.p2align 3\nrt_state: .zero 4096\n"));
    } else {
        if c.plat == 1 {
            o(
                &mut c,
                view("ud2\n.section __DATA,__bss\n.p2align 3\n_rt_state:\n.space 4096\n")
            );
        } else {
            tls_bss(&mut c);
        }
    }
    }
    }
    mut out = u8[];
    if (c.debug != 0) || (c.backend != 0) {
        out = copy_bytes(view(c.out));
    } else {
        if c.split != 0 {
            out = optimize::optimize_parts(view(c.out), 1, &mut c.marks, &mut c.part_names);
        } else {
            out = optimize::optimize(view(c.out));
        }
    }
    if c.plat == 1 {
        prefixed := darwinify(view(out));
        out = prefixed;
    }
    path := host::arg(1 + offset);
    target := c.target;
    if (target == 0) || (target == 3) {
        if target == 3 {
            // PE/COFF unwind data must be emitted from the final frame sizes.
            mut image = win_unwind(view(out));
            if c.debug != 0 {
                image = debug_locs(view(image));
                // CodeView: the symbol records (functions with their typed locals), one line table
                // per recorded function, then the file checksums and the string table they index;
                // lld-link /DEBUG builds the PDB from this section.
                push_bytes(&mut image, view(".section .debug$S,\"dr\"\n.p2align 2\n.long 4\n"));
                symbols := codeview_symbols(&c);
                push_bytes(&mut image, view(symbols));
                for i in c.debug_funcs.len() {
                    push_bytes(&mut image, view(".cv_linetable "));
                    decimal(&mut image, i);
                    push_bytes(&mut image, view(", .L"));
                    fstart := c.debug_funcs[i].start;
                    fend := c.debug_funcs[i].end;
                    decimal(&mut image, fstart);
                    push_bytes(&mut image, view(", .L"));
                    decimal(&mut image, fend);
                    image.push(10);
                }
                push_bytes(&mut image, view(".cv_filechecksums\n.cv_stringtable\n"));
            }
            return write_image(&mut c, view(path), view(image));
        }
        if c.debug != 0 {
            out = debug_locs(view(out));
            sections := debug_sections(&c, view(host::arg(2 + offset)));
            for i in sections.len() {
                out.push(sections[i]);
            }
        }
        if c.backend != 0 {
            // LLVM IR for the lifted functions beside the native remainder: PATH.ll and PATH.
            lowered := llvm::lower(view(out), view("x86_64-unknown-linux-gnu"), &c.facts, c.verify_facts);
            mut ir_path = copy_bytes(view(path));
            push_bytes(&mut ir_path, view(".ll"));
            written := host::write_file(view(ir_path), view(lowered.ir));
            if written != 0 {
                return written;
            }
            return write_image(&mut c, view(path), view(lowered.native));
        }
        return write_image(&mut c, view(path), view(out));
    }
    if c.debug != 0 {
        // The .loc/.file directives pass through instruction selection unchanged; the DWARF
        // sections refer only to labels, so they are appended after lowering.
        out = debug_locs(view(out));
    }
    if c.backend != 0 {
        // LLVM IR (PATH.ll) for the lifted functions; the remainder goes through the usual
        // instruction selection, followed by the calling-convention thunks.
        lowered := llvm::lower_for(view(out), target, &c.facts, c.verify_facts);
        mut ir_path = copy_bytes(view(path));
        push_bytes(&mut ir_path, view(".ll"));
        written := host::write_file(view(ir_path), view(lowered.ir));
        if written != 0 {
            return written;
        }
        mut image = machine::lower(view(lowered.native), target, c.plat);
        push_bytes(&mut image, view(lowered.thunks));
        return write_image(&mut c, view(path), view(image));
    }
    mut native = machine::lower(view(out), target, c.plat);
    if c.debug != 0 {
        sections := debug_sections(&c, view(host::arg(2 + offset)));
        for i in sections.len() {
            native.push(sections[i]);
        }
    }
    if target == 4 {
        image := arm_unwind(view(native));
        return write_image(&mut c, view(path), view(image));
    }
    return write_image(&mut c, view(path), view(native));
}
