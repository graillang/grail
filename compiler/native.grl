        return atomic_method(borrow_mut(c), val(xt, xty), &name);
    }
    if k == 13 {
        return mutex_method(borrow_mut(c), val(xt, xty), &name);
    }
    if k == 21 {
        expect(borrow_mut(c), &")");
        observe(borrow_mut(c), xt);
        mut f = "";
        if same(&name, &"sqrt") {
            f = "rt_f64_sqrt";
        }
        if same(&name, &"abs") {
            f = "rt_f64_abs";
        }
        if same(&name, &"floor") {
            f = "rt_f64_floor";
        }
        if same(&name, &"is_nan") {
            f = "rt_f64_is_nan";
        }
