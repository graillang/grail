                    // lo..hi (hi excluded): (x - lo) < (hi - lo) as unsigned words, correct for signed types too.
                    advance(borrow_mut(c));
                    advance(borrow_mut(c));
                    hneg := eat(borrow_mut(c), &"-");
                    there := c.pos;
                    hk := kind(borrow_mut(c));
                    mut high = 0;
                    if hk == 2 {
                        t := tok_text(borrow_mut(c), there);
                        high = literal_value(borrow_mut(c), &t);
                        advance(borrow_mut(c));
                    } else {
                        if hk == 4 {
                            high = char_literal(borrow_mut(c), there);
                            advance(borrow_mut(c));
                        } else {
                            fail(borrow_mut(c), &"range pattern needs an integer upper bound");
                        }
                    }
                    if literal_fits(borrow_mut(c), ty, high, hneg) == 0 {
                        fail(borrow_mut(c), &"match pattern out of range for the value's type");
                    }
                    if hneg {
                        high = wrapping_sub(0, high);
                    }
                    mut empty = 0;
                    if ty_kind(borrow_mut(c), ty) == 18 {
                        if ty_mode(borrow_mut(c), ty) {
                            empty = ((high ^ 9223372036854775808) < (value ^ 9223372036854775808))
                                + (high == value);
