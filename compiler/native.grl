        }
        expect(&mut c, view("("));
    }
    mut args = u64[];
    mut argtypes = u64[];
    mut sources = u64[];
    mut deferred = u64[];
    // Two token positions per parameter, in parameter order however the arguments were written.
    mut spans = u64[];
