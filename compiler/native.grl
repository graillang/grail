fn print_builtin<a>(c: (&a mut C), newline: u64) -> Val {
    expect(&mut c, view("("));
    if eat(&mut c, view(")")) {
        if newline == 0 {
            fail(&mut c, view("print requires an argument"));
        }
        invoke(&mut c, view("rt_print_newline"), u64[]);
        return val(imm(&mut c, 0), 1);
    }
    // print("x = {}, y = {}", x, y): the literal is split at compile time; {{ and }} are braces.
    if (kind(&mut c) == 3) & (next_kind(&mut c) == 44) {
        p := c.pos;
        text := decode_literal(&mut c, p);
        advance(&mut c);
        mut piece = u8[];
        mut i = 0;
        while i < text.len() {
            b := text[i];
            mut next = 0;
            if i + 1 < text.len() {
                next = text[i + 1];
            }
            if (b == 123) & (next == 123) {
                piece.push(123);
                i += 2;
                continue;
            }
            if (b == 125) & (next == 125) {
                piece.push(125);
                i += 2;
                continue;
            }
            if (b == 123) & (next == 58) {
                // {:[fill][<^>][0][width][.precision]} (precision: f64 decimals, rounded half to even like Rust).
                sp := parse_spec(&mut c, view(text), i);
                print_raw(&mut c, view(piece));
                piece = u8[];
                end := sp.end;
                acc := invoke(&mut c, view("rt_new"), u64[]);
                format_spec_arg(&mut c, acc, sp);
                zero := imm(&mut c, 0);
                invoke(&mut c, view("rt_print_acc"), two(acc, zero));
                i = end;
                continue;
            }
            if (b == 123) & (next == 125) {
                print_raw(&mut c, view(piece));
                piece = u8[];
                if !eat(&mut c, view(",")) {
                    fail(&mut c, view("missing argument for {} in format string"));
                }
                value := expr(&mut c, 0);
                print_value(&mut c, value, 0);
                i += 2;
                continue;
            }
            if (b == 123) || (b == 125) {
                fail(&mut c, view("unmatched brace in format string (use {{ or }})"));
            }
            piece.push(b);
            i += 1;
        }
        print_raw(&mut c, view(piece));
        if is(&mut c, view(",")) {
            fail(&mut c, view("more arguments than {} placeholders in format string"));
        }
        expect(&mut c, view(")"));
        if newline != 0 {
            invoke(&mut c, view("rt_print_newline"), u64[]);
        }
        return val(imm(&mut c, 0), 1);
    }
    input := expr(&mut c, 0);
    expect(&mut c, view(")"));
    print_value(&mut c, input, newline);
    return val(imm(&mut c, 0), 1);
}
// format("x = {}", x) -> string, with the same compile-time placeholder checks as print.
fn format_builtin<a>(c: (&a mut C)) -> Val {
    expect(&mut c, view("("));
    if kind(&mut c) != 3 {
        fail(&mut c, view("format needs a string literal"));
    }
    acc := invoke(&mut c, view("rt_new"), u64[]);
    p := c.pos;
    text := decode_literal(&mut c, p);
    advance(&mut c);
    mut piece = u8[];
    mut i = 0;
    while i < text.len() {
        b := text[i];
        mut next = 0;
        if i + 1 < text.len() {
            next = text[i + 1];
        }
        if (b == 123) & (next == 123) {
            piece.push(123);
            i += 2;
            continue;
        }
        if (b == 125) & (next == 125) {
            piece.push(125);
            i += 2;
            continue;
        }
        if (b == 123) & (next == 58) {
            sp := parse_spec(&mut c, view(text), i);
            format_raw(&mut c, acc, view(piece));
            piece = u8[];
            end := sp.end;
            format_spec_arg(&mut c, acc, sp);
            i = end;
            continue;
        }
        if (b == 123) & (next == 125) {
            format_raw(&mut c, acc, view(piece));
            piece = u8[];
            if !eat(&mut c, view(",")) {
                fail(&mut c, view("missing argument for {} in format string"));
            }
            input := expr(&mut c, 0);
            format_arg(&mut c, acc, input);
            i += 2;
            continue;
        }
        if (b == 123) || (b == 125) {
            fail(&mut c, view("unmatched brace in format string (use {{ or }})"));
        }
        piece.push(b);
        i += 1;
    }
    format_raw(&mut c, acc, view(piece));
    if is(&mut c, view(",")) {
        fail(&mut c, view("more arguments than {} placeholders in format string"));
    }
    expect(&mut c, view(")"));
    slot := invoke(&mut c, view("rt_fmt_finish"), one(acc));
    return own(&mut c, slot, 3);
}
fn format_raw<a, b>(c: (&a mut C), acc: u64, piece: &b [u8]) -> unit {
    if piece.len() == 0 {
        return ();
    }
    l := label(&mut c);
    rodata(&mut c);
    mark(&mut c, l);
    for i in piece.len() {
        o(&mut c, view(".byte "));
        on(&mut c, piece[i]);
        c.out.push(10);
    }
    o(&mut c, view(".popsection\nleaq "));
    lname(&mut c, l);
    o(&mut c, view("(%rip),%rax\n"));
    ptr := save(&mut c);
    n := imm(&mut c, piece.len());
    invoke(&mut c, view("rt_fmt_raw"), three(acc, ptr, n));
    return ();
}
// Element format codes for printing vectors: 1 u64, 2 bool, 3 f64, 4 text/bytes, 5 nested vector,
// 256+ sized integer (int_code); 0 means not printable.
fn element_code<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(&mut c, ty);
    if ty == 0 {
        return 1;
    }
    if k == 19 {
        return 2;
    }
    if k == 21 {
        if is_f32(&mut c, ty) {
            return 7;
        }
        return 3;
    }
    if k == 22 {
        return 6;
    }
    if (k == 3) || (k == 4) || (k == 5) {
        return 4;
    }
    if k == 18 {
        return 1024 + int_code(&mut c, ty);
    }
    if (k == 6) || (k == 27) {
        inner := ty_arg(&mut c, ty);
        sub := element_code(&mut c, inner);
        if sub == 0 {
            return 0;
        }
        if narrow_code(&mut c, inner) != 0 {
            // 4-byte elements (f32[], u32[], i32[]).
            return 4096 * sub + 8;
        }
        return 4096 * sub + 5;
    }
    return 0;
}
fn format_precision<a, b>(c: (&a mut C), text: &b [u8], start: u64) -> u64 {
    mut i = start + 2;
    if !(i < text.len()) {
        fail(&mut c, view("bad format spec (expected {:.N})"));
    }
    if text[i] != 46 {
        fail(&mut c, view("bad format spec (expected {:.N})"));
    }
    i += 1;
    mut n = 0;
    mut any = 0;
    while i < text.len() {
        d := text[i];
        if (d < 48) || (57 < d) {
            break;
        }
        n = n * 10 + d - 48;
        any = 1;
        if 300 < n {
            fail(&mut c, view("format precision too large"));
        }
        i += 1;
    }
    if any == 0 {
        fail(&mut c, view("bad format spec (expected {:.N})"));
    }
    if !(i < text.len()) {
        fail(&mut c, view("bad format spec (expected {:.N})"));
    }
    if text[i] != 125 {
        fail(&mut c, view("bad format spec (expected {:.N})"));
    }
    return n;
}
fn format_precision_end<a>(text: &a [u8], start: u64) -> u64 {
    mut i = start;
    while text[i] != 125 {
        i += 1;
    }
    return i + 1;
}
fn format_arg<a>(c: (&a mut C), acc: u64, input: Val) -> bool {
    original := input.t;
    inty := input.ty;
    value := deref(&mut c, input);
    mut k = ty_kind(&mut c, value.ty);
    observe(&mut c, value.t);
    kind0 := k;
    shown := show_value(&mut c, original, inty, value.ty);
    if shown.ty != 18446744073709551615 {
        invoke(&mut c, view("rt_fmt_seq"), two(acc, shown.t));
        release_temporary(&mut c, shown.t);
        k = 0;
    }
    if k == 21 {
        mut f = "rt_fmt_f64";
        if is_f32(&mut c, value.ty) {
            f = "rt_fmt_f32";
        }
        invoke(&mut c, view(f), two(acc, value.t));
        k = 0;
    }
    if k == 22 {
        invoke(&mut c, view("rt_push_utf8"), two(acc, value.t));
        k = 0;
    }
    if (k == 6) || (k == 27) {
        code := element_code(&mut c, value.ty);
        if code == 0 {
            fail(
                &mut c,
                view("format arguments must be u64, sized integers, bool, text, byte views or have show()")
            );
        }
        cv := imm(&mut c, code);
        invoke(&mut c, view("rt_fmt_value"), three(acc, value.t, cv));
        k = 0;
    }
    if k == 1 {
        invoke(&mut c, view("rt_fmt_num"), two(acc, value.t));
    } else {
        if k == 19 {
            invoke(&mut c, view("rt_fmt_bool"), two(acc, value.t));
        } else {
            if k == 18 {
                code := int_code(&mut c, value.ty);
                cv := imm(&mut c, code);
                invoke(&mut c, view("rt_fmt_int"), three(acc, value.t, cv));
            } else {
                if (k == 3) || (k == 4) || (k == 5) {
                    invoke(&mut c, view("rt_fmt_seq"), two(acc, value.t));
                } else {
                    if k != 0 {
                        fail(
                            &mut c,
                            view("format arguments must be u64, sized integers, bool, text, byte views or have show()")
                        );
                    }
                }
            }
        }
    }
    release_temporary(&mut c, original);
    return (kind0 == 1) || (kind0 == 18) || (kind0 == 21);
}
struct FormatSpec {
    precision: u64,
    width: u64,
    align: u64,
    zero: u64,
    fill: u64,
    end: u64
}
// {:[fill][<^>][0][width][.precision]} ; precision 18446744073709551615 = none.
fn parse_spec<a, b>(c: (&a mut C), text: &b [u8], start: u64) -> FormatSpec {
    mut i = start + 2;
    mut sp = FormatSpec {
        precision: 18446744073709551615,
        width: 0,
        align: 0,
        zero: 0,
        fill: 32,
        end: 0,
    };
    if i + 1 < text.len() {
        x := text[i + 1];
        if (x == 60) || (x == 62) || (x == 94) {
            if text[i] != 125 {
                sp.fill = text[i];
                i += 1;
            }
        }
    }
    if i < text.len() {
        x := text[i];
        if x == 60 {
            sp.align = 1;
            i += 1;
        } else {
            if x == 62 {
                sp.align = 2;
                i += 1;
            } else {
                if x == 94 {
                    sp.align = 3;
                    i += 1;
                }
            }
        }
    }
    if i < text.len() {
        if text[i] == 48 {
            sp.zero = 1;
            i += 1;
        }
    }
    while i < text.len() {
        d := text[i];
        if (d < 48) || (57 < d) {
            break;
        }
        sp.width = sp.width * 10 + d - 48;
        if 1000 < sp.width {
            fail(&mut c, view("format width too large"));
        }
        i += 1;
    }
    if i < text.len() {
        if text[i] == 46 {
            i += 1;
            mut n = 0;
            mut any = 0;
            while i < text.len() {
                d := text[i];
                if (d < 48) || (57 < d) {
                    break;
                }
                n = n * 10 + d - 48;
                any = 1;
                if 300 < n {
                    fail(&mut c, view("format precision too large"));
                }
                i += 1;
            }
            if any == 0 {
                fail(&mut c, view("bad format spec (expected {:.N})"));
            }
            sp.precision = n;
        }
    }
    if !(i < text.len()) {
        fail(&mut c, view("bad format spec (expected {:[fill][<^>][0][width][.precision]})"));
    }
    if text[i] != 125 {
        fail(&mut c, view("bad format spec (expected {:[fill][<^>][0][width][.precision]})"));
    }
    sp.end = i + 1;
    return sp;
}
// Formats the next argument per spec and appends it (padded) to acc.
fn format_spec_arg<a>(c: (&a mut C), acc: u64, sp: FormatSpec) -> unit {
    if !eat(&mut c, view(",")) {
        fail(&mut c, view("missing argument for {} in format string"));
    }
    value := expr(&mut c, 0);
    tmp := invoke(&mut c, view("rt_new"), u64[]);
    mut numeric = true;
    if sp.precision != 18446744073709551615 {
        if !is_float(&mut c, value.ty) {
            fail(&mut c, view("{:.N} needs an f64 argument"));
        }
        dv := imm(&mut c, sp.precision);
        invoke(&mut c, view("rt_fmt_f64_fixed"), three(tmp, value.t, dv));
    } else {
        numeric = format_arg(&mut c, tmp, value);
    }
    mut align = sp.align;
    if align == 0 {
        if numeric {
            align = 2;
        } else {
            align = 1;
        }
    }
    mut args = u64[];
    args.push(acc);
    args.push(tmp);
    w := imm(&mut c, sp.width);
    args.push(w);
    al := imm(&mut c, align);
    args.push(al);
    z := imm(&mut c, sp.zero & u64(numeric));
    args.push(z);
    f := imm(&mut c, sp.fill);
    args.push(f);
    invoke(&mut c, view("rt_fmt_pad"), args);
    return ();
}
fn is_hex_digit(d: u64) -> bool {
    return ((47 < d) && (d < 58)) || ((64 < d) && (d < 71)) || ((96 < d) && (d < 103));
}
// The bytes of a string literal with its escapes decoded. Accepted escapes: \n \r \t \0 \\
// \" \' , \xHH (two hex digits, at most 7F, so the text stays valid UTF-8) and \u{H...} (a
// Unicode scalar value, 1-6 hex digits with optional _ separators, encoded as UTF-8). Any other
// escape is a compile error rather than being kept as literal text.
fn decode_literal<a>(c: (&a mut C), p: u64) -> u8[] {
    t := &c.toks[p];
    st := t.start;
    en := t.end;
    mut out = u8[];
    mut i = st + 1;
    while i < en - 1 {
        b := c.src[i];
        if b != 92 {
            out.push(b);
            i = i + 1;
            continue;
        }
        i = i + 1;
        e := c.src[i];
        mut done = 0;
        if e == 110 {
            out.push(10);
            done = 1;
        }
        if e == 114 {
            out.push(13);
            done = 1;
        }
        if e == 116 {
            out.push(9);
            done = 1;
        }
        if e == 48 {
            out.push(0);
            done = 1;
        }
        if (e == 92) || (e == 34) || (e == 39) {
            out.push(e);
            done = 1;
        }
        if e == 120 {
            if i + 2 >= en - 1 || !is_hex_digit(c.src[i + 1]) || !is_hex_digit(c.src[i + 2]) {
                fail(&mut c, view("\\x escape needs two hex digits"));
            }
            v := hex(c.src[i + 1]) * 16 + hex(c.src[i + 2]);
            if 127 < v {
                fail(&mut c, view("\\x escape above \\x7F would make invalid UTF-8; use \\u{...}"));
            }
            out.push(v);
            i = i + 2;
            done = 1;
        }
        if e == 117 {
            if c.src[i + 1] != 123 {
                fail(&mut c, view("\\u escape needs braces: \\u{...}"));
            }
            mut j = i + 2;
            mut v = 0;
            mut digits = 0;
            while (j < en - 1) & (c.src[j] != 125) {
                d := c.src[j];
                if d != 95 {
                    if !is_hex_digit(d) {
                        fail(&mut c, view("invalid hex digit in \\u{...} escape"));
                    }
                    v = v * 16 + hex(d);
                    digits += 1;
                    if (6 < digits) || (1114111 < v) {
                        fail(&mut c, view("\\u{...} escape is above U+10FFFF"));
                    }
                }
                j += 1;
            }
            if (j >= en - 1) || (digits == 0) {
                fail(&mut c, view("unterminated or empty \\u{...} escape"));
            }
            if (55295 < v) & (v < 57344) {
                fail(&mut c, view("\\u{...} escape is a surrogate, not a Unicode scalar value"));
            }
            if v < 128 {
                out.push(v);
            } else {
                if v < 2048 {
                    out.push(192 | (v >> 6));
                    out.push(128 | (v & 63));
                } else {
                    if v < 65536 {
                        out.push(224 | (v >> 12));
                        out.push(128 | ((v >> 6) & 63));
                        out.push(128 | (v & 63));
                    } else {
                        out.push(240 | (v >> 18));
                        out.push(128 | ((v >> 12) & 63));
                        out.push(128 | ((v >> 6) & 63));
                        out.push(128 | (v & 63));
                    }
                }
            }
            i = j;
            done = 1;
        }
        if done == 0 {
            fail(&mut c, view("unknown escape in string literal"));
        }
        i = i + 1;
    }
    return out;
}
fn print_raw<a, b>(c: (&a mut C), piece: &b [u8]) -> unit {
    if piece.len() == 0 {
        return ();
    }
    l := label(&mut c);
    rodata(&mut c);
    mark(&mut c, l);
    for i in piece.len() {
        o(&mut c, view(".byte "));
        on(&mut c, piece[i]);
        c.out.push(10);
    }
    o(&mut c, view(".popsection\nleaq "));
    lname(&mut c, l);
    o(&mut c, view("(%rip),%rax\n"));
    ptr := save(&mut c);
    n := imm(&mut c, piece.len());
    invoke(&mut c, view("rt_print_raw"), two(ptr, n));
    return ();
}
