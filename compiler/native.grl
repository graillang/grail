        head := c.pos + 1;
        headtext := tok_text(&mut c, head);
        if simple_type_head(&mut c, view(headtext))
            || (kind_at(&mut c, head) == 38)
            || (kind_at(&mut c, head) == 91) {
            mut depth = 0;
            mut q = c.pos;
            while q < c.toks.len() {
                kk := kind_at(&mut c, q);
                if kk == 40 {
                    depth += 1;
                }
                if kk == 41 {
                    depth -= 1;
                    if depth == 0 {
                        break;
                    }
