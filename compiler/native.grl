                if x86 {
                    if single {
                        // Narrowed in its own register: no scratch, so nothing callee-saved is touched.
                        o(&mut c, view("movq %rax,%xmm"));
                        on(&mut c, freg);
                        o(&mut c, view("\ncvtsd2ss %xmm"));
                        on(&mut c, freg);
                        o(&mut c, view(",%xmm"));
                    } else {
                        o(&mut c, view("movq %rax,%xmm"));
                    }
                    on(&mut c, freg);
                    c.out.push(10);
                } else {
                    if single {
                        o(&mut c, view("cfarg32 "));
                    } else {
                        o(&mut c, view("cfarg64 "));
                    }
                    on(&mut c, freg);
                    c.out.push(10);
                }
            } else {
                if single {
                    if apple_arm {
                        fail(&mut c, view("macOS arm64 packs stack arguments; an f32 stack argument is not supported"));
                    }
                    ffi_f32_bits(&mut c, x86);
                }
                if ireg != 99 {
                    o(&mut c, view("movq %rax,"));
                    o(&mut c, view(ffi_int_reg(abi, ireg)));
                    c.out.push(10);
                } else {
                    ffi_store_stack(&mut c, x86, base + next * 8);
                    next = next + 1;
                }
            }
        } else {
            words := ffi_words(&mut c, ty);
            suffix := ffi_narrow(&mut c, ty);
