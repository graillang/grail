    }
    rs.push(r);
    return ();
}
// Lifetime parameters inside the declared type (not concrete borrow targets).
// Recursive nominal types (enum Tree { Node(Branch) }, struct Branch { left: Tree }) are walked once:
// a type already on the path adds nothing beyond its own region arguments.
fn type_caps<a>(c: (&a mut C), ty: u64, depth: u64) -> u64[] {
    mut trail = u64[];
    return caps_walk(&mut c, ty, &mut trail);
}
fn caps_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> u64[] {
    mut rs = type_regions(&mut c, ty);
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if (k == 6) || (k == 27) || (k == 7) || (k == 10) || (k == 13) || (k == 14) || (k == 16) {
        inner := caps_walk(&mut c, arg, &mut trail);
        for i in inner.len() {
            mut r = inner[i];
            add_region(&mut rs, r);
        }
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return rs;
            }
        }
        trail.push(ty);
        d := &c.decls[arg];
        count := d.count;
        for i in count {
            f := field_type(&mut c, ty, i);
            inner := caps_walk(&mut c, f, &mut trail);
            for j in inner.len() {
                mut r = inner[j];
                add_region(&mut rs, r);
            }
        }
        trail.pop();
    }
    return rs;
}
fn intersects<a, b>(a: (&a u64[]), b: (&b u64[])) -> bool {
    for i in a.len() {
        mut r = a[i];
        for j in b.len() {
            if b[j] == r {
                return true;
            }
        }
    }
    return false;
}
fn normalize_readonly<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    k := ty_kind(&mut c, ty);
    if (k != 5) & (k != 7) {
        return ();
    }
    if ty_mode(&mut c, ty) != 0 {
        return ();
    }
    root := place_of(&mut c, slot);
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if (holder == root) & (guard == 0) {
            mut l = &c.check.loans[loan - 1];
            mode := l.mode;
            live := l.live;
            if live != 0 {
                if mode != 0 {
                    child := ownership::reborrow(&mut c.check, loan, 0);
                    if child == 0 {
                        fail(&mut c, view("readonly result cannot borrow suspended authority"));
                    }
                    mut b = &mut c.bonds[i];
                    exchange(&mut b.guard, 1);
                    bond(&mut c, root, child);
