                vstart := c.pos;
                value := expr(&mut c, 0);
                vend := c.pos;
                expect(&mut c, view(")"));
                ty := char_type(&mut c);
                if (c.lit_start == vstart) & (c.lit_end == vend) & (value.ty == 0) {
                    if adopt_literal(&mut c, vstart, vend, ty) {
