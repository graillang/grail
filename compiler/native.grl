        cfield_more: 0,
        alias_next: 1,
        types: Ty[],
        decls: Decl[],
        aliases: Alias[],
        imports: Import[],
        fields: Field[],
        funcs: Func[],
        params: u64[],
        locals: Local[],
        next: 0,
        entry: 0,
        file: 0,
        label: 1,
        brk: 0,
        cont: 0,
        raw: 0,
        unsafe_depth: 0,
        libs: u8[][],
        pending_ext: 0,
        pending_symbol: u8[],
        export_tls: 0,
        rnames: u8[][],
        tnames: u8[][],
        closures: Closure[],
        fn_thunk_used: 0,
        closure_env: 0,
        inherent: 0,
        constants: Constant[],
        impl_params: ImplParams[],
        receiver: 0,
        receiver_ty: 0,
        has_receiver: 0,
        lit_start: 0,
        lit_end: 0,
        lit_value: 0,
        hints: u64[],
        tolerant: 0,
        retry: 0,
        attempts: 0,
        cf_start: 0,
        cf_end: 0,
        cf_local: 0,
        bce_index: u8[],
        bce_base: u8[],
        lit_negative: 0,
        byte_start: 0,
        byte_end: 0,
        flit_start: 0,
        flit_end: 0,
        flit_tok: 0,
        flit_neg: 0,
        type_bounds: u64[],
        type_interfaces: u64[][],
        interfaces: Interface[],
        implementations: Implementation[],
        self_type: 0,
        current_impl: 0,
        headers_complete: 0,
        resources: Resource[],
        loopmark: 0,
        result: 0,
        check: ownership::new(),
        members: Member[],
        terminated: 0,
        loopcheck: ownership::new(),
        breaks: ownership::new(),
        hasbreak: 0,
        bonds: Bond[],
        origins: Origin[],
        scope_end: 0,
        loop_start: 0,
        loop_end: 0,
        no_union: 0,
        parsing_input: 0,
        output_region: 0,
        receiver_region: 0,
        input_regions: u64[],
        none_start: 0,
        none_end: 0,
        deny_ambient: 0,
        host_optin: 0,
        host_modules: u8[][],
    };
    exchange(&mut c.target, host::target());
    for k in 5 {
        intern(&mut c, k + 1, 0);
    }
    host_fn(&mut c, view("target"), 0);
    host_fn(&mut c, view("argc"), 0);
    host_fn(&mut c, view("arg"), 2);
    host_fn(&mut c, view("read_file"), 2);
    host_fn(&mut c, view("write_file"), 0);
    host_fn(&mut c, view("print"), 1);
    host_fn(&mut c, view("print_num"), 1);
    host_fn(&mut c, view("newline"), 1);
    host_fn(&mut c, view("command"), 0);
    host_fn(&mut c, view("sleep_ms"), 1);
    host_fn(&mut c, view("now_ms"), 0);
    numbers := intern(&mut c, 6, 0);
    host_fn(&mut c, view("pipe"), numbers);
    host_fn(&mut c, view("read_fd"), 2);
    host_fn(&mut c, view("write_fd"), 0);
    host_fn(&mut c, view("close"), 0);
    host_fn(&mut c, view("env"), 2);
    host_fn(&mut c, view("exe_path"), 2);
    host_fn(&mut c, view("exists"), 0);
    host_fn(&mut c, view("mkdir"), 0);
    names := intern(&mut c, 6, 2);
    host_fn(&mut c, view("list_dir"), names);
    host_fn(&mut c, view("tcp_listen"), 0);
    host_fn(&mut c, view("tcp_port"), 0);
    host_fn(&mut c, view("tcp_accept"), 0);
    host_fn(&mut c, view("tcp_connect"), 0);
    host_fn(&mut c, view("open"), 0);
    host_fn(&mut c, view("exit"), 1);
    host_fn(&mut c, view("remove"), 0);
    host_fn(&mut c, view("create_dir"), 0);
    argc := host::argc();
    mut offset = 0;
    if 1 < argc {
        first := host::arg(1);
        if cli::is_command(view(first)) {
            return cli::run();
        }
    }
    while offset + 1 < argc {
        option := host::arg(offset + 1);
        if same(view(option), view("--deny-ambient-host")) || same(view(option), view("--split")) {
