            }
        }
    }
    return ();
}
// Bindings authorize writes to owned storage; explicit mutable capabilities authorize
// writes through their referents, without making the capability binding reassignable.
fn binding_mode<a>(c: (&a C), slot: u64) -> u64 {
    for i in c.locals.len() {
        entry := &c.locals[i];
        id := entry.id;
        mutable := entry.mutable;
        if id == slot {
            return mutable + 1;
        }
    }
    return 0;
}
fn require_mutable_binding<a>(c: (&a mut C), slot: u64, storage: u64) -> unit {
    if c.raw {
        return ();
    }
    mut current = slot;
    mut depth = 0;
    while depth < c.resources.len() + 1 {
        index := resource(borrow_mut(c), current);
        if index != 0 {
            mut r = &c.resources[index - 1];
            ty := r.ty;
            place := r.place;
            authority := r.authority;
            base := r.base;
            k := ty_kind(borrow_mut(c), ty);
            mode := ty_mode(borrow_mut(c), ty);
            if (k == 7) & (place != 0) {
                if mode {
                    return ();
                }
                fail(borrow_mut(c), &"mutation through readonly reference");
            }
            if (k == 5) & (storage == 0) {
                if mode {
                    return ();
                }
                fail(borrow_mut(c), &"mutation through readonly view");
            }
            if authority != 0 {
                a := resource(borrow_mut(c), authority - 1);
                if a != 0 {
                    info := &c.resources[a - 1];
                    at := info.ty;
                    if ty_kind(borrow_mut(c), at) == 7 {
                        if ty_mode(borrow_mut(c), at) {
                            return ();
                        }
                        fail(borrow_mut(c), &"mutation through readonly frame");
                    }
                }
            }
            binding := binding_mode(borrow(c), current);
            if binding == 1 {
                fail(borrow_mut(c), &"owned storage mutation requires mut");
            }
            if binding == 2 {
                return ();
            }
            if base == 0 {
                return ();
            }
            current = base - 1;
        } else {
            binding := binding_mode(borrow(c), current);
            if binding == 1 {
                fail(borrow_mut(c), &"owned storage mutation requires mut");
            }
            return ();
        }
        depth = depth + 1;
    }
    fail(borrow_mut(c), &"invalid mutation provenance");
    return ();
}
fn require_write<a>(c: (&a mut C), slot: u64) -> unit {
    require_mutable_binding(borrow_mut(c), slot, 0);
    if c.raw {
        return ();
    }
    index := resource(borrow_mut(c), slot);
    if index == 0 {
        fail(borrow_mut(c), &"mutation target is not tracked");
    }
    mut r = &c.resources[index - 1];
    ty := r.ty;
    place := r.place;
    authority := r.authority;
    target := r.target;
    k := ty_kind(borrow_mut(c), ty);
    if (k == 7) & (place == 0) {
        if authority != 0 {
            mut r = resource(borrow_mut(c), authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(borrow_mut(c), ty) == 0 {
                fail(borrow_mut(c), &"write through readonly frame");
            }
            loan := authority_loan(borrow_mut(c), authority, target);
            if loan == 0 {
                fail(borrow_mut(c), &"field write has no authority");
            }
            if ownership::access_loan(borrow(c.check), loan, target, 1) != 0 {
                fail(borrow_mut(c), &"field write conflicts with active loan");
            }
        } else {
            if ownership::initialize(borrow_mut(c.check), target) != 0 {
                fail(
                    borrow_mut(c),
                    &"field assignment conflicts with live borrow or moved storage"
                );
            }
        }
        return ();
    }
    if (k == 5) + (k == 7) {
        if ty_mode(borrow_mut(c), ty) == 0 {
            fail(borrow_mut(c), &"mutation through readonly reference");
        }
        mut allowed = 0;
        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            holder := b.holder;
            loan := b.loan;
            guard := b.guard;
            if (guard == 0) & ownership::ancestor(borrow(c.check), holder, place) {
                if loan_live(borrow_mut(c), loan) {
                    allowed = 1;
                    if ownership::use_loan(borrow(c.check), loan, 1) != 0 {
                        fail(borrow_mut(c), &"write authority is suspended");
                    }
                }
            }
        }
        if allowed == 0 {
            fail(borrow_mut(c), &"write lacks checked source");
        }
    } else {
        if authority != 0 {
            mut r = resource(borrow_mut(c), authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(borrow_mut(c), ty) == 0 {
                fail(borrow_mut(c), &"mutation through readonly frame");
            }
            loan := authority_loan(borrow_mut(c), authority, place);
            if loan == 0 {
                fail(borrow_mut(c), &"write has no reference authority");
            }
            if ownership::access_loan(borrow(c.check), loan, place, 1) != 0 {
                fail(borrow_mut(c), &"write conflicts with active loan");
            }
        } else {
            loan := ownership::borrow_place(borrow_mut(c.check), place, 1);
            if loan == 0 {
                fail(borrow_mut(c), &"mutation conflicts with live borrow");
            }
            ownership::end_loan(borrow_mut(c.check), loan);
        }
    }
    return ();
}
fn region_of<a>(c: (&a mut C), place: u64) -> u64 {
    for i in c.origins.len() {
        o := &c.origins[i];
        root := o.place;
        region := o.region;
        if ownership::ancestor(borrow(c.check), root, place) {
            return region;
        }
    }
    return 0;
}
fn external_place<a>(c: (&a mut C), region: u64, copy: u64) -> u64 {
    p := ownership::root(borrow_mut(c.check), copy, 1);
    c.origins.push(Origin { place: p, region: region });
    return p;
}
fn add_external_capture<a>(c: (&a mut C), holder: u64, region: u64, mode: u64) -> u64 {
    source := external_place(borrow_mut(c), region, 0);
    loan := ownership::borrow_place(borrow_mut(c.check), source, mode);
    bond(borrow_mut(c), holder, loan);
    return source;
}
fn init_parameter<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if c.raw {
        return ();
    }
    holder := place_of(borrow_mut(c), slot);
    k := ty_kind(borrow_mut(c), ty);
    mut rs = type_regions(borrow_mut(c), ty);
    mode := ty_mode(borrow_mut(c), ty);
    if (k == 5) + (k == 7) {
        if rs.len() != 1 {
            fail(borrow_mut(c), &"parameter requires a declared lifetime");
        }
        mut r = rs[0];
        source := add_external_capture(borrow_mut(c), holder, r, mode);
        if k == 7 {
            set_target(borrow_mut(c), slot, source, slot + 1);
        }
        return ();
    }
    captures := type_caps(borrow_mut(c), ty, 0);
    for i in captures.len() {
        mut r = captures[i];
        target := external_place(borrow_mut(c), r, 0);
        loan := ownership::borrow_place(borrow_mut(c.check), target, 0);
        bond_kind(borrow_mut(c), holder, loan, 1);
    }
    return ();
}
fn has_bonds<a>(c: (&a mut C), holder: u64) -> u64 {
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        h := b.holder;
        guard := b.guard;
        loan := b.loan;
        if (h == holder) & (guard == 0) {
            if loan_live(borrow_mut(c), loan) {
                return 1;
            }
        }
    }
    return 0;
}
// Stored captures in an abstract input referent have their declared data lifetime,
// distinct from the lifetime of the outer reference frame.
fn stored_source<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    place := place_of(borrow_mut(c), slot);
    if place == 0 {
        return ();
    }
    k := ty_kind(borrow_mut(c), ty);
    if (k != 5) & (k != 7) {
        return ();
    }
    if has_bonds(borrow_mut(c), place) {
        if k == 7 {
            for i in c.bonds.len() {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if (holder == place) & (guard == 0) {
                    if loan_live(borrow_mut(c), loan) {
                        mut l = &c.check.loans[loan - 1];
                        source := l.source;
                        authority := authority_of(borrow_mut(c), slot);
                        set_target(borrow_mut(c), slot, source, authority);
                        break;
                    }
                }
            }
        }
        return ();
    }
    mut guarded = 0;
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if guard {
            if loan_live(borrow_mut(c), loan) {
                if ownership::ancestor(borrow(c.check), holder, place) {
                    bond_kind(borrow_mut(c), place, loan, guard);
                    guarded = 1;
                }
            }
        }
    }
    if guarded {
        mode := ty_mode(borrow_mut(c), ty);
        source := external_place(borrow_mut(c), 18446744073709551615, 0);
        loan := ownership::borrow_place(borrow_mut(c.check), source, mode);
        bond(borrow_mut(c), place, loan);
        if k == 7 {
            mut authority = authority_of(borrow_mut(c), slot);
            mut r = resource(borrow_mut(c), slot);
            info := &c.resources[r - 1];
            if info.base == 0 {
                authority = slot + 1;
            }
            set_target(borrow_mut(c), slot, source, authority);
        }
        return ();
    }
    if region_of(borrow_mut(c), place) == 0 {
        return ();
    }
    mut rs = type_regions(borrow_mut(c), ty);
    if rs.len() != 1 {
        fail(borrow_mut(c), &"stored capture lifetime missing");
    }
    mut r = rs[0];
    mode := ty_mode(borrow_mut(c), ty);
    target := add_external_capture(borrow_mut(c), place, r, mode);
    if k == 7 {
        authority := authority_of(borrow_mut(c), slot);
        set_target(borrow_mut(c), slot, target, authority);
    }
    return ();
}
fn bind_loan<a>(c: (&a mut C), value: u64, source: u64, target: u64, mode: u64) -> unit {
    if c.raw {
        return ();
    }
    if target == 0 {
        fail(borrow_mut(c), &"borrow target is not tracked");
    }
    mut authority = authority_of(borrow_mut(c), source);
    source_id := resource(borrow_mut(c), source);
    if source_id != 0 {
        mut r = &c.resources[source_id - 1];
        ty := r.ty;
        if ty_kind(borrow_mut(c), ty) == 7 {
            authority = source + 1;
