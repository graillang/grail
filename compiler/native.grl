    // yields a `cfn` value: its symbol is already the C name.
    foreign := c.funcs[index].ext;
    if foreign == 1 {
        fail(&mut c, view("extern C declarations are not Grail function values"));
    }
    f := &c.funcs[index];
    types := f.types;
    raw := f.raw;
    first := f.first;
    count := f.count;
    result := f.ret;
    m := f.module.copy();
    name := f.name.copy();
    symbol := f.symbol.copy();
