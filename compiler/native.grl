    here := c.pos;
    after := kind_at(&mut c, here + 1);
    if (after != 44) & (after != 41) {
        return 0;
    }
    name := tok_text(&mut c, here);
    l := find_local(&mut c, view(name));
    if l == 0 {
        return 0;
    }
    ty := local_ty(&mut c, l - 1);
    k := ty_kind(&mut c, ty);
    if (k != 5) & (k != 7) {
        return 0;
    }
    if ty_mode(&mut c, ty) != 0 {
        return 2;
    }
    return 1;
