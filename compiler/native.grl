        // here rather than with the payload kinds because the interface format spells it without an
        // element and its drop does not depend on one either.
    } else if (k == 8) || (k == 23) || (k == 28) {
        // The nominal payload is already in the key.
    } else if (k == 18) || (k == 21) || (k == 31) {
        // An integer or float width is part of the type and is not a run-local choice.
        out.push(32);
        decimal(&mut out, arg);
    } else if k == 9 {
        // A type parameter's slot number is what the declaration counts, not what this run chose.
        out.push(32);
        decimal(&mut out, arg);
    } else if k == 33 {
        // An interface object: the interface by name, not by this run's index.
        out.push(32);
        push_bytes(&mut out, view(c.interfaces[arg - 1].module));
        push_bytes(&mut out, view("::"));
        push_bytes(&mut out, view(c.interfaces[arg - 1].name));
    } else {
        // A store extension this compiler does not know. Its payload is a type if the number points
        // into the type table, so walk it; either way the kind, the mode, the regions and the
        // arguments above are a function of the type, and the emitter's code for an unknown kind
        // depends on nothing else.
        if arg < c.types.len() {
            out.push(32);
            type_key(&mut c, &mut out, arg, depth + 1);
        } else {
            out.push(32);
            decimal(&mut out, arg);
        }
    }
    env := ty_env(&mut c, ty);
    if env != 0 {
        out.push(32);
        type_key(&mut c, &mut out, env, depth + 1);
    }
