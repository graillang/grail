fn infer_type<a, b>(c: (&a mut C), formal: u64, actual: u64, map: (&b mut u64[])) -> unit {
    k := ty_kind(&mut c, formal);
    arg := ty_arg(&mut c, formal);
    if k == 9 {
        old := map[arg];
        if old == 18446744073709551615 {
            exchange(&mut map[arg], actual);
        } else {
            require_type(&mut c, actual, old);
        }
        return ();
    }
    ak := ty_kind(&mut c, actual);
    if k != ak {
        fail(&mut c, view("generic argument shape mismatch"));
    }
    if k == 7 {
        fm := ty_mode(&mut c, formal);
        am := ty_mode(&mut c, actual);
        if fm != am {
            fail(&mut c, view("generic reference mode mismatch"));
        }
    }
    if (k == 6) || (k == 27) || (k == 7) || (k == 13) || (k == 14) || (k == 16) {
        aa := ty_arg(&mut c, actual);
        infer_type(&mut c, arg, aa, &mut map);
        return ();
    }
    if (k == 12) || (k == 20) {
        result := ty_arg(&mut c, actual);
        infer_type(&mut c, arg, result, &mut map);
        fs := type_args(&mut c, formal);
        as := type_args(&mut c, actual);
        if fs.len() != as.len() {
            fail(&mut c, view("callable argument arity mismatch"));
        }
        for i in fs.len() {
            f := fs[i];
            a := as[i];
            infer_type(&mut c, f, a, &mut map);
        }
        return ();
    }
    if k == 8 {
        aa := ty_arg(&mut c, actual);
        if arg != aa {
            fail(&mut c, view("generic nominal mismatch"));
        }
        fa := type_args(&mut c, formal);
        ax := type_args(&mut c, actual);
        if fa.len() != ax.len() {
            fail(&mut c, view("generic arity mismatch"));
        }
        for i in fa.len() {
            f := fa[i];
            a := ax[i];
            infer_type(&mut c, f, a, &mut map);
        }
        return ();
    }
    require_type(&mut c, actual, formal);
    return ();
}
fn infer_union_member<a, b>(
    c: (&a mut C),
    expected: u64,
    actual: u64,
    map: (&b mut u64[])
) -> unit {
