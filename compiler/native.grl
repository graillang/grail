module native;
use fncache;
use jobs;
use lexer;
use host;
use explain;
use ownership;
use machine;
use optimize;
use llvm;
use cli;
use asm_x86;

// Direct Linux native compiler: one checked word stream, target instruction selection in machine.grl.
// Usage: native OUT.s ENTRY.grl [MODULE.grl...]. The first public function of the
// first file is the entry; it takes nothing or argv[1] as a byte view. Move/initialization
// checks, loans/lifetimes, captured-storage writeback and deterministic drops are active.
// Generic types/functions use typed specialization. Include runtime.grl as source.
// Type ids: 0 u64, 1 unit, 2 bytes, 3 string, 4 view; others are interned below. Id 0 is a real
// type, so no id can mean "no type": `NO_TYPE` answers that, and every site that asks whether a
// type is known asks it directly instead of keeping a second flag beside the id (NO_TYPE below).
// Type kinds: 1 u64, 2 unit, 3 bytes, 4 string, 5 view, 6 vec(arg), 7 ref(arg),
// 8 named(decl, args), 9 opaque template parameter, 10 opaque bound parameter (arg, identity),
// 11 Atomic<u64>, 12 capture-free typed function pointer, 13 Mutex<T>, 14 Scope<C>, 15 interface proof,
// 16 Task<R>, 17 CancelToken, 18 sized integer (arg bits, mode signed), 19 bool, 20 closure Fn(..)->R, 21 f64,
// 22 char, 23 opaque foreign handle (arg = decl), 24 CStr, 25 cfn pointer, 26 bare C pointer,
// 27 slice (arg = element, mode 1 writable), 28 byval(extern record),
// 29 job (arg = result): a running pool job handle. Move-only, like Task<R>, and its drop waits.
// 33 interface object `dyn I` (arg = interface id): one word, a heap cell {value, vtable}; the
//    vtable is {drop, method 0, method 1, ...} for the concrete type (dyn_box, emit_vtables).
// 30 associated-type projection `T::Item` (arg = T, mode = interface id * 1024 + associated index):
//    only ever over a type parameter; binding T to a concrete type resolves it (project).
// 35 borrowed interface object marker: the referent of the kind-7 reference a `&dyn I` is (arg = the
//    `dyn` type, kind 33). A `&dyn I` value is one word, a handle to a 16-byte {data, vtable} pair in
//    the frame that built it (borrow_dyn): building one allocates nothing, and dispatch loads the
//    entry from the pair's vtable (call_typed), exactly as an owned `dyn I` does through its cell.

// ---- the "no type" sentinel ----------------------------------------------------------------------
// A type is an index into `c.types`, interned on demand: id 0 is u64, 1 unit, 2 bytes, 3 string,
// 4 view (the five every compile seeds, in `main`), so every id is a real type and an id can never
// also mean "no type". `NO_TYPE` is that answer instead: a value no table can hold, so one id
// carries both the answer and whether there is one, and no site needs a `found`/`have` flag beside
// it. Every `== 0` on a type id means u64 and only u64; every "is there a type?" is
// `== NO_TYPE`, and an accessor refuses a sentinel rather than indexing the table with it.
const NO_TYPE: u64 = 18446744073709551615;
// Two more values above the id space are pseudo-types, not ids: a compile-time target tag such as
// `.windows` (ct_tag_ty), and a constant whose value a compile-time call has not produced yet
// (ct_pending). Neither is ever an index into `c.types`.
const CT_TAG: u64 = 18446744073709551614;
const CT_PENDING: u64 = 18446744073709551613;
// Whether an id names a type a table can be indexed by. The three sentinels above are not types.
fn is_type_id(ty: u64) -> bool {
    return ty < CT_PENDING;
}

struct Ty {
    kind: u64,
    arg: u64,
    mode: u64,
    regions: u64[],
    args: u64[],
    // A closure (kind 20) is the only type whose behaviour depends on the values it carries: the
    // environment record (kind 8) holding its captures, or 0 for a capture-free `Fn(..)` signature.
    // It is part of the interned identity, because two closures with one signature but different
    // captures are different types, and a capability check has to reach the captures.
    env: u64
}
struct Decl {
    module: u8[],
    name: u8[],
    // The declaration's source position, for a duplicate that has to name the first one.
    declared_at: u8[],
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    is_enum: u64,
    // 1 for `handle Name;`: a one-word opaque foreign handle, not a layout.
    opaque: u64,
    // The audited foreign-resource contract of a `handle` (docs/ffi.md): may a value cross to
    // another thread (`transfer`), and may it be used concurrently (`share`)? Both default to 0, so
    // a handle nothing has been declared about is thread-affine - the safe answer for a foreign
    // resource we have not audited. Ignored for every non-handle declaration.
    transfer: u64,
    share: u64,
    // 1 for `extern record`: fields use C layout (natural alignment, padding).
    c_layout: u64,
    first: u64,
    count: u64,
    // 1 when an `impl Drop` in this program applies to every instantiation of this declaration: the
    // user's `drop` runs at the head of the type's compiler-generated drop helper. Asked about every
    // type `emit_drops` walks, so it is a per-declaration bit rather than a scan of the impl table.
    drop: u64,
    regions: u64,
    types: u64,
    success: u64,
    bounds: u64[],
    constraints: u64[][]
}
struct Import {
    module: u8[],
    name: u8[]
}
struct Alias {
    module: u8[],
    name: u8[],
    // "path.grl:12:5" of the declaration: a duplicate is refused by naming where the first one is,
    // and a token index from another file is not an index into this one (native.grl, position_text).
    declared_at: u8[],
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    ty: u64
}
struct Field {
    name: u8[],
    ty: u64,
    // `field: T where P`: the field's predicate, or no_pred() when it has none.
    pred: Pred
}
// A refinement predicate, kept as a token range in the file it was written in (docs/design/
// refinements.md). The range is never parsed where it is written: the obligation compiles the
// expression where the value enters, with the names bound to the values there.
struct Pred {
    // The file the tokens are in: a source file, or the virtual source an interface carries.
    file: u64,
    lo: u64,
    hi: u64
}
fn no_pred() -> Pred {
    return Pred { file: 0, lo: 0, hi: 0 };
}
fn copy_preds<a>(p: (&a Pred[])) -> Pred[] {
    mut out = Pred[];
    for i in p.len() {
        item := &p[i];
        out.push(Pred { file: item.file, lo: item.lo, hi: item.hi });
    }
    return out;
}
fn has_pred<a>(p: (&a Pred)) -> bool {
    return p.hi != 0;
}
struct Func {
    module: u8[],
    name: u8[],
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    // The source module that declared it (`module` is a synthetic owner for methods).
    home: u8[],
    first: u64,
    count: u64,
    ret: u64,
    types: u64,
    regions: u64,
    file: u64,
    pos: u64,
    raw: u64,
    // 1 for `unsafe fn`: its body is checked one unsafe level down, and a call to it from safe code
    // outside an `unsafe` block is refused.
    unsafe_fn: u64,
    bounds: u64[],
    constraints: u64[][],
    contract: u64,
    owner: u64,
    // 1 when this is an `extern "C"` declaration: no body, and `symbol` is the
    // linker-visible C name (unmangled).
    ext: u64,
    symbol: u8[],
    // The source text of a generic template's declaration, captured at the declaration pass so the
    // interface can carry it (B1 stage 3). Empty for everything else: only a template is replayed.
    body: u8[],
    // `p: T where P`, one per parameter in order, and `-> T ensures P` for the result.
    ppreds: Pred[],
    rpred: Pred,
    // The parameters' source names, parallel to `ppreds`: a call site needs them to put the
    // arguments' terms in the predicate's place, and an interface carries the ones a predicate uses.
    // Every parameter has one, because `f(x: 1)` names the slot it fills (docs/design/named-arguments.md).
    pnames: u8[][],
    // `y: u64 = 0`: each parameter's default value, parallel to `pnames`, as a token range in the file
    // it was written in - or in the virtual source an interface carried - and `no_pred()` when the
    // parameter has none. Nothing is parsed here: the default is compiled where the call is written.
    pdefaults: Pred[],
    // `@strict` before this declaration. It stays with the declaration, so a specialisation and a
    // body replayed from an interface are compiled in the mode the source asked for - not in
    // whatever mode the file that happens to instantiate them was scanned in.
    strict: u64,
    // 1 for `@no_alloc` and `@no_panic`: claims the compiler proves of the body and of everything it
    // calls (docs/design/effects.md). An interface carries them, so a caller in another module
    // relies on the definition's own proof.
    no_alloc: u64,
    no_panic: u64
}
struct Interface {
    module: u8[],
    name: u8[],
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    defined: u64,
    methods: u64[],
    // Per method, parallel to `methods`: the `fn` token of a default body + 1 (0: none), and the
    // file it is in. An implementation that leaves the method out gets this body (default_methods).
    defaults: u64[],
    default_files: u64[],
    // Associated types (`type Item;`), by index, and the interfaces each must implement
    // (`type Item: Ord;`).
    assoc: u8[][],
    assoc_bounds: u64[][],
    // `interface B: A + C`: interfaces every implementation of this one also implements.
    supers: u64[]
}
struct Implementation {
    contract: u64,
    ty: u64,
    module: u8[],
    methods: u64[],
    // Where `impl` is written + 1 (0: read from an interface file), for diagnostics.
    file: u64,
    pos: u64,
    // `type Item = u64;`: the associated types it gives, by name.
    assoc_names: u8[][],
    assoc_types: u64[]
}
struct Closure {
    decl: u64,
    start: u64,
    file: u64,
    module: u8[],
    captures: u8[][],
    names: u8[][],
    params: u64[],
    ret: u64,
    symbol: u8[],
    tnames: u8[][],
    bindings: u64[],
    // Lifetimes the parameters introduced (`|x: &T|`): regions 2.. of the closure's own namespace.
    regions: u64,
    // The captures the body writes, one flag per entry of `captures`. Only a written capture is
    // mutable in the body, and a closure with any written capture is `FnMut` (mode 1), not `Fn`.
    written: u64[],
    // A closure created while a specialisation is replayed belongs to that specialisation: every
    // object that emits the specialisation emits it too, under the same name, weak (B1 stage 4).
    weak: u64,
    // The part (module) its body is emitted into.
    unit: u8[],
    mode: u64,
    // The function body the closure was written in (`c.body_file`/`c.body_pos` when it was
    // recorded). Its body is emitted after every function, so an error in it is reported against
    // that body: the re-run that looks for the next error skips the enclosing function, which drops
    // the closure with it (next_error). Without it the re-run skipped whichever body happened to be
    // checked last, met the same error again and chained to the 20-run cap.
    body_file: u64,
    body_pos: u64
}
struct ImplParams {
    decl: u64,
    rnames: u8[][],
    tnames: u8[][],
    bounds: u64[],
    interfaces: u64[][],
    // The self type this implementation's parameters build, or NO_TYPE until iface_impl_self
    // builds it: the id says whether it exists, so there is no second flag to keep in step.
    self_ty: u64
}
struct Constant {
    module: u8[],
    name: u8[],
    // The declaration's source position, for a duplicate that has to name the first one.
    declared_at: u8[],
    // The file and token of the name, for a diagnostic about the declaration raised after the parse
    // has moved on (a compile-time call resolved at the end of the compile); 0 for an interface's.
    file: u64,
    at: u64,
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    ty: u64,
    value: u64,
    text: u8[]
}
// A run-tier value of the program: a module binding `NAME := f(...);` or a static `@f(...)`. Every
// probe defines a wrapper for each (ct_probe_wrappers), so code the probe compiles reads a value by
// calling its initialiser instead of starting another probe (docs/design/comptime-speed.md, R1).
// A value the build's batch probe computed (ct_batch), looked up by run_tier before it starts a probe.
struct CtDone {
    key: u8[],
    res: CTRes
}
struct CtCall {
    module: u8[],
    name: u8[],
    // The call's source text, unqualified, as written.
    text: u8[],
    is_static: u64
}
// A module static (docs/design/module-values.md): one object at one address, in the declaring
// module's object. Stage 1 is the baked tier only - the value is computed while compiling (a
// constant expression or `@f(...)`) and emitted as read-only data, so a read is an address and
// nothing runs, allocates or is freed.
struct Static {
    module: u8[],
    name: u8[],
    declared_at: u8[],
    file: u64,
    at: u64,
    public: u64,
    // NO_TYPE until the second pass parses the declared type.
    ty: u64,
    // 1 when the declaration came from an interface: another object defines the storage.
    imported: u64,
    // The initialiser's first token (after `=`), recorded in the second pass; 0 for an interface's.
    init_at: u64,
    // 0 not evaluated, 1 being evaluated, 2 evaluated (static_resolve).
    state: u64,
    // The evaluated initialiser: `ready` is 0 only inside the probe computing this static; `value`
    // is a scalar's word or a run-tier table's element count, `text` its bytes or printed form.
    ready: u64,
    value: u64,
    text: u8[],
    // What the prover may know of an imported static (from its interface): 0 nothing, 1 the value of
    // an integer static, 2 the length of a string or vector static; `fact` is that number.
    fact_kind: u64,
    fact: u64
}
struct Spec {
    template: u64,
    args: u64[],
    first: u64,
    ret: u64,
    // The module whose body instantiated the template: the one that references this symbol.
    requester: u8[]
}
// flex: an untyped integer literal binding (`x := 5`) whose uses adopt their context's integer
// type; lit/neg hold the literal. A mutable one settles at its first assignment.
// origin: declared from a bare literal (name token at `at`); a committed one may still learn its
// type from a later sized use, which recompiles the function with a hint.
struct Local {
    name: u8[],
    ty: u64,
    id: u64,
    last: u64,
    born: u64,
    mutable: u64,
    flex: u64,
    lit: u64,
    neg: u64,
    origin: u64,
    at: u64
}
struct Val {
    t: u64,
    ty: u64
}
struct Resource {
    slot: u64,
    ty: u64,
    flag: u64,
    base: u64,
    field: u64,
    via: u64,
    place: u64,
    target: u64,
    authority: u64
}
struct Bond {
    holder: u64,
    loan: u64,
    guard: u64
}
struct Origin {
    place: u64,
    region: u64
}
// A loan held by a C pointer made from Grail storage (`cptr`/`cptr_mut`): `at` is the token of the
// `cptr` that took it, so a conflict can say which pointer is still live.
struct Pointer {
    loan: u64,
    at: u64,
    writable: u64
}
struct Member {
    base: u64,
    field: u64,
    place: u64
}
struct DebugVar {
    name: u8[],
    slot: u64,
    line: u64,
    param: u64,
    // The variable's full DWARF type: an index into c.debug_types.
    ty: u64
}
// One DWARF type of the program's debug information:
//   kind 0 base type (enc, size)
//   kind 1 pointer to `pointee`
//   kind 2 structure of `size` bytes with `members`
//   kind 3 enumeration: `members` are its enumerators (name, offset = the tag value)
//   kind 4 typedef of `pointee`, named as the Grail type it names
struct DebugType {
    name: u8[],
    kind: u64,
    enc: u64,
    size: u64,
    pointee: u64,
    members: DebugMember[]
}
struct DebugMember {
    name: u8[],
    ty: u64,
    offset: u64
}
struct DebugSite {
    file: u64,
    line: u64,
    start: u64,
    end: u64,
    params: u64
}
struct DebugFunc {
    name: u8[],
    module: u8[],
    file: u64,
    line: u64,
    start: u64,
    end: u64,
    params: u64,
    vars: DebugVar[],
    // The label namespace this function's start and end labels were minted in (B1 stage 5): every
    // label is `.L<unit>_<n>`, where <unit> is `<unit prefix>_<function ordinal>`, so a table that names a label by its number alone would name one the
    // unit never emitted. Captured where the function is recorded, i.e. inside its own unit.
    unit: u8[]
}
// One module of the program, as an interface sees it.
struct IModule {
    module: u8[],
    path: u8[],
    // 1 when the file sits in the standard-library directory (it compiles in the stdlib's modes).
    std: u64,
    // 1 for `unsafe module ...` (the runtime and the platform modules).
    unsafe: u64,
    // 1 when the module declared `use host;`.
    host: u64
}
// Declared before `C` because the typed-IR fact walker (docs/design/refinements.md) keeps a list of
// them in the per-compile state: a fact is a comparison, a divisibility or a float class over named
// terms.
struct Atom {
    // 0 `<`, 1 `<=`, 2 `==`, 3 `%`, 4 `finite`, 5 `nan`.
    rel: u64,
    a: u8[],
    b: u8[],
    k: i64,
    // The constant each side adds in the source, while the atom is still as it was read (pv_atom):
    // `i + 1 < n` is `a: i, ao: 1`. A fact has neither - pv_settle moved each one into `k` where the
    // addition cannot wrap, or into the term's own spelling where it might.
    ao: i64,
    bo: i64
}
struct C {
    src: u8[],
    // The loaded file's tokens. Each knows where it starts (line, col), worked out once by the
    // lexer: every position a diagnostic, a debug row or a runtime-error site needs is a lookup.
    toks: lexer::Token[],
    pos: u64,
    out: u8[],
    // 1 (--split): mark module boundaries in `out` and write one assembly file per module.
    split: u64,
    // 1 (--separate): this run's code is one object of a program, not a program: every definition
    // becomes global so the linker can bind across objects. One file, and its own site table.
    separate: u64,
    // The module of the run being emitted, so a marker opens a run only when the module changes.
    part: u8[],
    // The label namespace of that unit: every label it mints is `.L<lpart>_<n>`, from a counter that
    // starts at 1 for each unit, so a unit's emitted text never depends on what was emitted before
    // it. The counters live per unit (`lunits`, `lnext`, `rnext`) rather than in one field, because
    // emission can leave a unit and come back - a specialisation requested mid-body is emitted after
    // the requesting function - and a reset on the way back would mint the same numbers twice.
    lpart: u8[],
    // 1-based index into `lunits` of the unit being emitted, or 0 before the first one.
    lunit: u64,
    lunits: u8[][],
    lnext: u64[],
    rnext: u64[],
    // The line the `.gpos` markers being written count from (site_base).
    gbase: u64,
    // A function's labels are its own: `.L<lpart>_<f>_<n>`, where `f` is the function's ordinal in
    // its unit (`fnext` counts them per unit) and `n` restarts at 1 with each function - so the text
    // of a body does not depend on how many labels the bodies before it minted, and an edit to one
    // body leaves every other body's text alone (docs/design/incremental-compilation.md). `fscope` is
    // the ordinal of the function being emitted, or 0 outside any: there the unit's own counters
    // above mint `.L<lpart>_<n>`, as for the helpers and tables a unit emits around its bodies.
    fscope: u64,
    fnext: u64[],
    // Where the markers ended up in the optimized stream, and the module each names.
    marks: u64[],
    part_names: u8[][],
    module: u8[],
    target: u64,
    plat: u64,
    // Emit .file/.loc DWARF line info (Linux x86-64 native output only).
    debug: u64,
    // 1: lower the raw word stream to LLVM IR (compiler/llvm.grl) instead of optimize/machine.
    backend: u64,
    // Typed-IR facts for that lifter (docs/design/typed-ir.md). They travel beside `out`, never in
    // it: an absent fact means the untyped word lowering, so no stream change can affect
    // optimize.grl, machine.grl or the native backend.
    facts: llvm::Facts,
    // Body symbol of the function being emitted; facts are keyed by it.
    facts_fn: u8[],
    // Ordinal of the next `call rt_f64_op` in the function being emitted, and of the one most
    // recently emitted (its site, which knows the opcode, records the fact after the call).
    f64_ops: u64,
    call_ord: u64,
    // F1: per-callee call counters and the ordinal of the call just emitted, which is the key a
    // call-argument fact carries (docs/design/typed-ir.md).
    f1_names: u8[][],
    f1_counts: u64[],
    f1_ord: u64,
    // Set by `site_kind` on a stream without a site table that the LLVM lifter reads: the check's
    // kind is already in %rdx, and the `call rt_abort` that follows is written as `call rt_trap`, so
    // the failure reports what failed instead of aborting silently.
    trap_next: u64,
    // 1 with --verify-facts: the lifter checks every word a fact treats as an f32, and every word
    // it treats as a sequence header.
    verify_facts: u64,
    // Slots holding a plain record that a holder boxed (an enum payload, a popped element, a call
    // result): owning one copies it into the frame and frees the box (materialise).
    boxed: u64[],
    // 1 with --range-facts: the LLVM lifter derives range facts and removes the bounds check a
    // fact proves redundant (docs/design/typed-ir.md). Off by default; see that document for why.
    range_facts: u64,
    // 1 with --emit-ir: write the typed IR of the optimized stream beside the assembly, one text
    // unit per emitted function (docs/design/typed-ir.md, "The serializer").
    emit_ir: u64,
    no_sites: u64,
    // `--check`: stop after the last diagnostic can have been given.
    check_only: u64,
    // A check-only run with no unit store writes no assembly, so the text emitters (`o`, `on`, the
    // slot and label spellers) write nothing while this is 1 (docs/design/compile-speed.md). The
    // stream is never read back in such a run, except by a diagnostic (`fail` turns this off) and
    // for a body's own label (func turns it off around that).
    quiet: u64,
    // --f1-what=N: a test aid that records a deliberately wrong F1 kind for every binding, so the
    // checks --verify-facts emits can be shown to fire (docs/design/typed-ir.md, "Tests that catch
    // a wrong fact"). 0, the default, records the type the front end actually has.
    f1_what: u64,
    // --forge-signature=SYMBOL:WORDS: a test aid that records SYMBOL's signature fact with WORDS
    // argument words, so the lifter's signature checks can be shown to fire. Empty by default.
    forge_sig: u8[],
    forge_words: u64,
    // 1 when the forged signature also drops the body's `dyn_result` fact.
    forge_result: u64,
    // The argument words of the call load_call_args last set up and where the text was then; the
    // next `call *%rax` with no call between records them (indirect_fact). And where the function
    // being emitted begins, to number its indirect calls as the lifter does.
    pending_words: u64,
    // --forge-indirect=SYMBOL (a test aid): that body's indirect facts are one word short.
    forge_indirect: u8[],
    pending_at: u64,
    fn_text_at: u64,
    debug_funcs: DebugFunc[],
    debug_vars: DebugVar[],
    debug_types: DebugType[],
    arg_offset: u64,
    overflow: u64,
    // The bool/integer rule is always enforced; 1 is the survey mode (`--strict-bool-report`).
    strict_bool_report: u64,
    exports: u8[][],
    export_hits: u64[],
    specs: Spec[],
    bindings: u64[],
    current_spec: u64,
    // Closures created so far by the specialisation being replayed: their names are ordinals within it.
    spec_closures: u64,
    validating: u64,
    // Named-parameter count of the variadic extern call being lowered; 0 otherwise.
    ffi_fixed: u64,
    // C symbols declared `extern "C" blocking`, and whether the call being emitted is one of them.
    ffi_blocking: u8[][],
    ffi_block_now: u64,
    // C symbols declared `extern "C" nonblocking`: promised never to block, so their calls carry no
    // foreign-call marker (a bare call, C-to-C cost) and the monitor never hands them off.
    ffi_nonblocking: u8[][],
    // Slots holding the address of a narrow (non-8-byte or f32) C-layout record field, paired
    // with the field type: stores and compound loads through them use the field's width.
    caddr: u64[],
    // Slots holding the address of a plain record stored inline in another (docs/design/
    // unboxed-values.md, stage 1b): the value is that interior address, which no one may own, so
    // a move or an owner of it first copies the words into a box of its own (materialise).
    interior: u64[],
    // 1 + the frame slot holding the hidden result address (needs_dest), or 0.
    result_dest: u64,
    // Slots holding the address of a field's word in a Grail record: a plain, untagged word address,
    // so a sub-word value there (an f32, a u8) is read and written as the word it is stored as.
    word_refs: u64[],
    // Slots holding frame words that only one value refers to, fresh from a constructor (a
    // temporary): moving such a value takes its words over instead of copying them.
    temps: u64[],
    // The result adapters this object needs (box_result_thunk): closure * 4 + words.
    box_thunks: u64[],
    // Per type id: 0 not yet known, else 1 + (1 if the type is a plain record) + (2 if it is a
    // record that stores a plain record inline).
    layout_memo: u64[],
    // Per type id, for a record that stores a plain record inline: for each field its word offset
    // times two, plus one when the field is itself inline, and then the record's size in words
    // times two. Empty until asked (field_layout). Types are never removed, so it never goes stale.
    layout_offsets: u64[][],
    // An exported callback's float result: 0 none, 1 f64, 2 f32 (returned in xmm0/d0/fa0).
    export_fret: u64,
    // Set for one cfield_load: another `.field` projection follows this one.
    cfield_more: u64,
    alias_next: u64,
    types: Ty[],
    decls: Decl[],
    aliases: Alias[],
    imports: Import[],
    fields: Field[],
    // The file whose tokens and text are in `toks`/`src` (index + 1; 0 for none), and the files
    // loaded before it (see load_file).
    file_loaded: u64,
    file_cache_index: u64[],
    file_cache_src: u8[][],
    file_cache_toks: lexer::Token[][],
    // The functions by module, for the interface writer (iface_func_ids): an open-addressed table
    // of groups (`fmod_slots` holds group + 1), each group's module, its key and its functions in
    // table order; `fmod_n` functions are filed. Functions are only ever appended.
    fmod_slots: u64[],
    fmod_keys: u64[],
    fmod_names: u8[][],
    fmod_ids: u64[][],
    fmod_n: u64,
    // The digest of each source file the interface writer has read this run, by path, and the
    // file's length: one sha256 per source instead of one per question (iface_source_digest).
    srcdig_paths: u8[][],
    srcdig_vals: u8[][],
    srcdig_lens: u64[],
    funcs: Func[],
    // The (module, name) index of `funcs` and of `decls` (see name_key).
    func_slots: u64[],
    func_keys: u64[],
    decl_slots: u64[],
    decl_keys: u64[],
    spec_slots: u64[],
    spec_keys: u64[],
    ty_slots: u64[],
    ty_keys: u64[],
    // What type_caps and contains_borrow remember, per type id (see type_walk_stamp).
    caps_stamp: u64[],
    caps_memo: u64[][],
    borrow_stamp: u64[],
    // What `resource` remembers: the latest record of each slot, and how much of the list it read.
    res_last: u64[],
    res_synced: u64,
    bond_head: u64[],
    bond_next: u64[],
    // The same bonds by holder (`bond_hhead[place]`, `bond_hnext[bond]`), and `bond_under[place]`
    // nonzero when some bond's holder is that place or lies inside it; `bond_unranged` when a holder
    // was not a place yet, which sends every question back to the whole list (bonds_sync).
    bond_hhead: u64[],
    bond_hnext: u64[],
    bond_under: u64[],
    bond_unranged: u64,
    // For each `<` of the loaded file, the `>` that closes it (or the token count when none does),
    // when `angle_ok` says the table is about the token stream there now (angle_sync).
    angle_close: u64[],
    angle_ok: u64,
    spec_em_slots: u64[],
    spec_em_keys: u64[],
    drop_em_slots: u64[],
    drop_em_keys: u64[],
    params: u64[],
    locals: Local[],
    next: u64,
    entry: u64,
    file: u64,
    label: u64,
    brk: u64,
    cont: u64,
    raw: u64,
    // Lexical `unsafe { ... }` depth. Foreign calls are rejected at depth 0.
    unsafe_depth: u64,
    // Set by a leading `unsafe` on a top-level item (`unsafe fn`, `unsafe struct ...`), consumed by
    // the declaration that owns it, so the hatch applies to one item at a time.
    pending_unsafe: u64,
    // 1 while the operand of a `return` is being checked: `p.as_ref()` may only be returned, since
    // the borrow it makes takes the function's result lifetime.
    in_return: u64,
    // Set while an operand of `cptr`/`cptr_mut` is being checked, so a borrow conflict inside it
    // is reported as the C aliasing it is. 1 for `cptr` (read-only), 2 for `cptr_mut` (writable).
    cptr_address: u64,
    // (slot, type) pairs for the proxy slots an embedded record's place uses: the slot holds the
    // address of bytes interior to its container, so writing through the place replaces those bytes
    // instead of storing a pointer into them.
    embedded: u64[],
    // Linker inputs declared by `extern "C" lib "..."`, deduplicated in order.
    libs: u8[][],
    // Set while an `extern "C" fn` definition is handed to the function parser:
    // 2 means C-callable with the given unmangled symbol.
    pending_ext: u64,
    pending_symbol: u8[],
    // Slot holding the host TLS base inside an exported function's body, or 0.
    export_tls: u64,
    export_adopt: u64,
    // The pass a module-level compile-time form runs in (0 inside a function body).
    ct_pass: u64,
    ct_in_if: bool,
    // `pub` on the declaration being parsed (1 for anything the compiler synthesises), and 1 while
    // the compiler reads interfaces or looks names up for itself, which skips the visibility check.
    decl_public: u64,
    vis_off: u64,
    // Set when a compile-time expression read a value parameter that is not bound yet.
    ct_unbound: u64,
    // 1 once a function's frame is larger than a page: the output then gets stack probes
    // (optimize::probe_frames). The largest array in the frame being compiled, and where it is.
    probes: u64,
    array_big: u64,
    array_big_at: u64,
    // Slots holding the address of array storage nothing is bound to yet (a literal's, a copy's).
    array_fresh: u64[],
    // site_pos's position cache (file, byte offset, line, column).
    // `--comptime-probe`: this compile builds the probe program for a compile-time call (C3).
    probe_mode: u64,
    // `@for f in fields(T)` bindings in scope, innermost last: name, decl, field index.
    ct_loop_names: u8[][],
    ct_loop_decls: u64[],
    ct_loop_index: u64[],
    // Set once a compile used `@embed`, which reads a file the build cache does not key on.
    embed_used: u64,
    // Several errors per compile (docs/diagnostics.md): the bodies an earlier run of this compile
    // already reported an error in, as file index and position pairs, skipped here; and the body
    // being checked now, which an error in it adds to that list.
    skip_bodies: u64[],
    body_file: u64,
    body_pos: u64,
    // The diagnostics this compile has already printed, as `file:line:column:message` keys carried
    // by `--reported` from one re-run to the next. A replayed generic body that reaches the same
    // error again is silent, and it counts once (docs/diagnostics.md).
    reported: u8[][],
    // A file to append structured diagnostics to (`--diagnostics-json FILE`), or empty. A driver
    // (watch mode, the language server) reads the fields it needs from it instead of parsing the
    // caret form; the caret form is still in the record, as `rendered`.
    diag_json: u8[],
    // Copy-backs for `p: &mut R` callback parameters: (C pointer slot, copy slot, bytes) triples.
    export_copyback: u64[],
    rnames: u8[][],
    tnames: u8[][],
    closures: Closure[],
    fn_thunk_used: u64,
    closure_env: u64,
    // What the next closure literal is expected to be (closure_hint): its parameter types and result,
    // each NO_TYPE when not known yet.
    hint_params: u64[],
    hint_ret: u64,
    // Whether closure_hint set a hint at all. Not a "is there a type" flag: every element of the
    // hint says NO_TYPE itself; this says whether a hint was given, which a hint that fixes nothing
    // does not tell apart from no hint.
    hint_set: u64,
    inherent: u64,
    // Inherent impls whose owner is a written type rather than a declaration of the module
    // (`impl u8[] { ... }`, `impl<T> T[] { ... }`): the owner type of each, in source order. The key
    // of one is `inherent_type_base()` plus its 1-based position here (inherent_type_base).
    inherent_types: u64[],
    constants: Constant[],
    statics: Static[],
    ct_calls: CtCall[],
    ct_done: CtDone[],
    // Where the batch probe writes the bodies each value reached (ct_write_deps), or empty.
    ct_deps_path: u8[],
    // Where a static read parks the result of a call it makes only for its effect.
    static_scratch: u64,
    impl_params: ImplParams[],
    receiver: u64,
    // The receiver type of the call being compiled, or NO_TYPE before it is prepared: id 0 is u64,
    // so a default of 0 would read as a u64 receiver.
    receiver_ty: u64,
    has_receiver: u64,
    // The next record() builds a tuple positionally.
    positional: u64,
    // A `&mut self` receiver call() borrows after its arguments (has_receiver 3).
    lazy_input: u64,
    // An operand whose call is deferred (`lazy_input`): its type, or NO_TYPE before it is taken.
    lazy_inty: u64,
    lazy_xty: u64,
    lit_start: u64,
    lit_end: u64,
    lit_value: u64,
    hints: u64[],
    tolerant: u64,
    retry: u64,
    attempts: u64,
    cf_start: u64,
    cf_end: u64,
    cf_local: u64,
    bce_index: u8[],
    bce_base: u8[],
    // The refinements of the function being compiled: its parameters' predicates and its `ensures`,
    // the source name of the declaration (a specialisation is reported under its template's name),
    // where it is written, and the serial that keeps each obligation's data labels apart.
    cur_ppreds: Pred[],
    cur_rpred: Pred,
    // The token range of the body being compiled: the facts the prover reads at a program point
    // start at its `{`. Zero inside a closure, where no enclosing function's facts hold.
    body_lo: u64,
    body_hi: u64,
    // The typed-IR fact walker (docs/design/refinements.md): `pv_on` says this body is maintaining
    // facts as it is compiled, `pv_facts` holds
    // the ones that hold at the current point, `pv_marks` and `pv_trmarks` one entry per open block,
    // `pv_trail` the atoms a binding's shadowing kill removed (they come back when the block that
    // made the binding closes), and `pv_pending` what a condition, a guard or an arm's pattern
    // states for the block about to open.
    pv_on: u64,
    pv_facts: Atom[],
    pv_marks: u64[],
    pv_trmarks: u64[],
    pv_trail: Atom[],
    // The block each `pv_trail` atom came back into: a fact a binding shadowed belongs to the block
    // that binding was made in, so only that block's close may restore it.
    pv_trown: u64[],
    pv_pending: Atom[],
    // The names a closure literal created in this body writes: a call in this body may write through
    // one of them, so no fact about them outlives a call (docs/design/refinements.md).
    pv_caps: u8[][],
    // 1 while a declaration's predicate is being read (see pv_read_pred).
    pv_pred_mode: u64,
    // 1 for the next subtraction `binary` emits: the facts show it cannot underflow.
    pv_arith_ok: u64,
    // The first token (+1) of the raw call argument being parsed as an address (raw_address_offset).
    addr_arg: u64,
    // 1 while an assignment's target path is read: its last field is written directly (and its
    // predicate owed there), not lent out, so `field_path` records it instead of refusing the loan.
    ref_assign_target: u64,
    // 1 once the body being emitted returned a two-word result (dyn_result): its wrapper returns the
    // same rax:rdx pair and says so too.
    dyn_result_seen: u64,
    // 1 while a refined function's body labels and declares itself: its symbol is `<name>.proved`,
    // and `<name>` is the checking wrapper emitted after it (ref_wrapper).
    proved_label: u64,
    // That field, one-based record declaration and zero-based index (0 when none was read).
    ref_assign_d: u64,
    ref_assign_k: u64,
    // The record the assignment's path ends in, and its type: a predicate across fields reads the
    // other fields from it when one of them is written.
    ref_assign_base: u64,
    ref_assign_rty: u64,
    // Strict refinements (docs/design/refinements.md): `--strict-refinements` for the whole program,
    // `@strict;` for a module (it stays with the module's name, so a replayed body keeps it), and
    // `@strict` on a declaration for the function that follows.
    strict_refinements: u64,
    strict_modules: u8[][],
    strict_next: u64,
    // The mode this body is compiled in: the declaration's `@strict`, or its template's when the
    // body is a specialisation or a replay.
    strict_here: u64,
    cur_name: u8[],
    cur_file: u64,
    cur_pos: u64,
    ref_next: u64,
    lit_negative: u64,
    // Span of the most recent byte read (`bytes[i]`): an untyped word known to be 0..255.
    byte_start: u64,
    byte_end: u64,
    flit_start: u64,
    flit_end: u64,
    flit_tok: u64,
    flit_neg: u64,
    type_bounds: u64[],
    type_interfaces: u64[][],
    interfaces: Interface[],
    implementations: Implementation[],
    // The type `Self` names inside the `impl` being parsed, or NO_TYPE outside one. The id itself
    // says whether there is a `Self`: no separate flag, no +1 offset to keep it clear of u64.
    self_type: u64,
    current_impl: u64,
    // Functions default_methods copied into an implementation from its interface.
    default_copies: u64[],
    // The current signature's associated-type equalities (param, interface*1024+index, type), and
    // every function's, by function index (func_eqs: index, param, mode, type).
    assoc_eqs: u64[],
    func_eqs: u64[],
    // `dyn I` objects this object builds: (interface, concrete type) pairs, and the interfaces
    // named as `dyn`, whose object safety check_interfaces checks.
    vtables: u64[],
    dyn_ifaces: u64[],
    headers_complete: u64,
    resources: Resource[],
    loopmark: u64,
    // The result type of the function whose body is being compiled, or NO_TYPE before any signature
    // has been read. Id 0 is u64, so a default of 0 would read as a u64 result.
    result: u64,
    check: ownership::State,
    members: Member[],
    terminated: u64,
    loopcheck: ownership::State,
    breaks: ownership::State,
    hasbreak: u64,
    bonds: Bond[],
    pointers: Pointer[],
    origins: Origin[],
    scope_end: u64,
    loop_start: u64,
    loop_end: u64,
    // An expression `match` (`x := match n { 0 => 1, _ => 2 }`): 1 while its arms are compiled (a
    // slot number can be 0, so the slot alone cannot say), the frame word every arm stores its
    // value into, the type the arms agreed on (NO_TYPE until one produces a value), the type the
    // surrounding place expects, and the token of the arm that fixed the type - what a later arm's
    // mismatch is reported against.
    arm_value: u64,
    arm_slot: u64,
    arm_ty: u64,
    arm_hint: u64,
    arm_at: u64,
    no_union: u64,
    // Set while the operand of `ignore_failure(...)` is evaluated: a join outcome may be dropped
    // there and nowhere else (docs/design/task-failure-containment.md).
    ignored_failure: u64,
    parsing_input: u64,
    output_region: u64,
    receiver_region: u64,
    input_regions: u64[],
    none_start: u64,
    none_end: u64,
    deny_ambient: u64,
    host_optin: u64,
    host_modules: u8[][],
    // Capability diagnostics for the parallel surface (docs/design/parallelism.md): the reason code
    // of the first denied leaf and the field path that reached it. `capability_begin` resets both,
    // so a rejection names the offending field instead of repeating the whole type.
    cap_denial: u64,
    cap_segs: u8[][],
    // Checked module interfaces (B1 stage 2, docs/design/separate-compilation.md). `iface_dir` is
    // the directory interfaces are read from, `iface_emit` the one they are written to, and
    // `iface_verify` asks for a declaration-by-declaration comparison with the sources instead of
    // trusting either side. Nothing here changes the whole-program path when all three are off.
    iface_dir: u8[],
    iface_use: u8[],
    // `--use-named` and `--use-module NAME` (repeatable): the modules whose interfaces this run
    // reads from the `--use` directory, in this order, and no others. A build that compiles modules at the same time names
    // them (the modules this one uses, and theirs), so a run neither depends on nor opens an
    // interface another run may still be writing. Without it every interface in the directory is
    // read, in name order.
    iface_only: u8[][],
    iface_only_on: u64,
    no_entry: u64,
    iface_used: u8[][],
    // The module whose body is being compiled right now, and the modules whose requested
    // specialisations this run emits (B1 stage 3).
    body_module: u8[],
    // The built-in `Drop` interface (`builtin_drop_interface`) and how many `impl Drop`s are generic
    // (an implementation no declaration's `drop` bit can answer for).
    drop_iface: u64,
    drop_generic: u64,
    // Every type a drop call names. emit_drops emits a helper for each of these as well as for every
    // interned type, so a reference can never outrun its definition.
    drop_refs: u64[],
    drop_names: u8[][],
    // By interned type: 1 once the drop walk has emitted its helper or found it emitted (emit_drops).
    drop_walked: u64[],
    spec_emitted: u8[][],
    spell_lenient: u64,
    spell_failed: u64,
    drop_emitted: u8[][],
    // Runtime bodies to inline across units: read from runtime.facts, or exported by the run that
    // emitted them (optimize::Shared).
    xinl: optimize::Shared,
    iface_emit: u8[],
    iface_verify: u64,
    // `--iface-dump FILE` renders a written interface's record tree and `--iface-roundtrip FILE`
    // proves that reading it back and writing it again reproduces the file byte for byte. Both are
    // read-only: neither parses a source nor emits code.
    iface_dump: u8[],
    iface_roundtrip: u8[],
    // Every module the program loaded, in command-line order, with what its interface records about
    // the file it came from.
    iface_list: IModule[],
    // Interfaces read with `--use`, waiting for their definition sweep.
    iface_loaded: u8[][],
    iface_loaded_path: u8[][],
    // Module roots (`--module-root DIR`, repeatable) and what they resolved
    // (docs/design/module-resolution.md). `mod_names` is every module the program has - the command
    // line's own names first - so a `use` of a name already there resolves to that file and no
    // other; `mod_files` holds the sources resolution added, after the command line's own, and
    // `mod_base` is how many arguments the command line gave, which is where that list starts.
    mod_roots: u8[][],
    mod_names: u8[][],
    mod_files: u8[][],
    mod_base: u64,
    mod_list: u64,
    mod_list_file: u8[],
    // Environment records (module `.closure`) the surface being emitted reaches, and the name each
    // is given inside the interface, so a reader can rebuild a closure type's captures exactly.
    iface_env: u64[],
    iface_env_names: u8[][],
    // Sources that did not come from the command line: a generic body an interface carried is
    // registered here as a file, so `load_file` and every diagnostic treat it like any other file.
    virt_path: u8[][],
    virt_text: u8[][],
    // The link inputs each module's `extern "C" lib "..."` declarations ask for. `libs` stays
    // program-wide (that is what the stream carries); this attributes them to a module so an
    // interface can re-request them.
    // Extra context for the next error (G11): secondary labels at other source positions, and
    // `help:` lines under the source excerpt. Set just before `fail`.
    diag_labels: DiagLabel[],
    diag_help: u8[][],
    // Text under the primary span (`expected `u64`, found `string``).
    diag_primary: u8[],
    lib_owner: u8[][],
    // ---- checked effects (G26, docs/design/effects.md) --------------------------------------------
    // One record per emitted body or read declaration: the claim `@no_alloc`/`@no_panic` makes, the
    // call edges the emitter recorded as it wrote the body, and the facts the fixpoint settles.
    fx_any: u64,
    fx_cur: u64,
    fx_syms: u8[][],
    // An open-addressed index over `fx_syms` (`index_add`), so a symbol's record is found in constant
    // time: every run records every body, and a linear scan per edge was quadratic in the program.
    fx_sym_slots: u64[],
    fx_sym_keys: u64[],
    // 1 when a symbol's facts came from an interface's summary: a callee whose body is in another
    // run, answered with what that run proved. Its own facts and witnesses are the row's.
    fx_row: u64[],
    // The interfaces this run wrote, kept so the summary can be added once the bodies are solved.
    iface_out_file: u8[][],
    iface_out_text: u8[][],
    iface_out_module: u8[][],
    fx_body: u64[],
    fx_attr_alloc: u64[],
    fx_attr_panic: u64[],
    fx_own_alloc: u64[],
    fx_own_panic: u64[],
    fx_alloc: u64[],
    fx_panic: u64[],
    fx_alloc_thru: u64[],
    fx_panic_thru: u64[],
    fx_fn_name: u8[][],
    fx_fn_file: u64[],
    fx_fn_pos: u64[],
    fx_edge_from: u64[],
    fx_edge_name: u8[][],
    fx_edge_to: u64[],
    fx_edge_kind: u64[],
    fx_edge_file: u64[],
    fx_edge_pos: u64[],
    // Why an edge names no callee - `interface `Shape``, `a closure`, `a function value`. Empty for
    // an edge that names its callee; an unknown edge's reason is what the refusal prints, so a
    // `@no_alloc` function that reaches one is told which one (docs/design/effects.md).
    fx_edge_why: u8[][],
    fx_pending_alloc: u64,
    fx_pending_panic: u64,
    fx_bounded: u64,
    // Whether the body being recorded is trusted code (the runtime, a drop helper) and how many calls
    // it has recorded.
    fx_trusted: u64,
    fx_calls: u64,
    // A refined parameter's check in the checked entry: the caller's obligation, not a body edge.
    fx_entry_panic: u64[],
    // Where the body's edge list started, so a retried body's discarded edges go with its bytes.
    fx_edge_mark: u64,
    // Per body that claimed an effect, in emission order: its symbol, the `call` instructions it
    // emitted.
    // `compile_end` holds the count against the calls the typed IR parses out of the same body.
    fx_body_sym: u8[][],
    fx_body_calls: u64[],
    // ---- the per-function codegen cache (`--fn-cache DIR`) ----------------------------------
    // The directory units are filed in, the two hashes every unit's key is built from (the option
    // vector and the declaration surface), where the cursor for a declaration's line has got to,
    // and what this run did with the store. All of it is inert when `fn_dir` is empty, which is
    // every run that did not ask for the cache.
    fn_dir: u8[],
    // The compiler's own identity, as the driver computed it (the digest of the binary it runs).
    // Empty for a hand-run compiler; the option vector then carries the executable's own path, size
    // and modification time instead.
    fn_id: u8[],
    // `--fn-cache-quiet`: use the store, print no report line.
    fn_quiet: u64,
    // `--object PATH`: assemble in this process (compiler/asm_x86.grl) and write the object to PATH;
    // the assembly file then carries only the `// grail-link:` notes the driver reads.
    object: u8[],
    fn_flags: u8[],
    fn_surface: u8[],
    fn_at_file: u64,
    fn_at_off: u64,
    fn_at_line: u64,
    fn_at_col: u64,
    // `--shift-declarations N`: tuple declarations synthesised before the first body (a test switch).
    shift_decls: u64,
    // Parallel bodies (par_start): 1 while forked workers compile bodies into units; this process's
    // part in it (0 the parent, k the k-th worker); how many processes; where each one's slice
    // starts (file and byte, one pair per process); 1 when bodies are dealt out in turn instead
    // (`GRAIL_BODY_SLICE=1`); the count of bodies walked so far. The parent keeps one pipe and one
    // child per worker, what each sent, how far it has read it, and whether it has (0 not yet, 1
    // whole, 2 not whole); a worker keeps what it will send. `par_fail` sends the rest of the walk
    // to this process.
    par_on: u64,
    par_me: u64,
    par_j: u64,
    par_cut_file: u64[],
    par_cut_off: u64[],
    par_rr: u64,
    par_n: u64,
    par_fds: u64[],
    par_pids: u64[],
    par_data: u8[][],
    par_at: u64[],
    par_read: u64[],
    par_buf: u8[],
    par_wfd: u64,
    par_fail: u64,
    par_jobs: jobs::Jobs,
    par_hits: u64,
    // Where the lines the optimiser's cut planning reads were written (optimize::plan_from).
    plan_at: u64[],
    // The types registrations spelled, already read in this run, by their bytes (fn_reg_type).
    reg_slots: u64[],
    reg_keys: u64[],
    reg_blobs: u8[][],
    reg_types: u64[],
    // The bodies applied from units, for the optimiser (ir::Known).
    known: ir::Known,
    // Armed (par_start) but not forked yet: the walk forks when par_decide finds the rest worth it,
    // over the source still ahead of it (par_fork).
    par_armed: u64,
    // When and where in the source the walk's first body began (par_decide), 0 before it.
    par_t0: u64,
    par_p0: u64,
    par_sizes: u64[],
    fn_hits: u64,
    fn_filed: u64,
    fn_kept: u64,
    // What the body being emitted asked of the run, for its unit (fn_reg_drop, fn_reg_spec): the
    // registrations as they will be filed, and the type each one named, to check the spelling
    // reads back as the same type. `fn_rec` is 1 while a body that may be filed is being emitted.
    fn_rec: u64,
    fn_regs: u8[],
    fn_reg_types: u64[],
    // One count per rule that keeps a body from being a unit (the FN_* indices): how often the
    // body being emitted did the thing (`fn_uses`, read by fn_marks), and how many bodies each rule
    // excluded in this run (`fn_why`, printed with the run's account).
    fn_uses: u64[],
    fn_why: u64[],
    // Sources that came from the command line with a `@derive` expansion appended to them
    // (docs/design/derives.md). The expansion is part of the file from the pass that can see the
    // declaration's fields, and every later load has to return the same bytes: a generic body is
    // replayed from its file after the passes are over, and its token positions must still name the
    // text they were recorded against.
    file_text: u8[][],
    // The derives `@derive(...)` asked of the declaration that follows, as a bit per derive, and
    // where the attribute was written (a diagnostic about the declaration points at it).
    derive_pending: u64,
    dr_pos: u64,
    // The generic parameters of the declaration a pending derive applies to - captured where the
    // declaration reads them, because a generated implementation repeats them - and which of them
    // occur in a field, which is where the derive's interface becomes a bound.
    dr_rnames: u8[][],
    dr_tnames: u8[][],
    dr_bounds: u64[],
    dr_constraints: u64[][],
    dr_used: u64[],
    // (declaration, derives) pairs, recorded when an expansion was generated and read again in the
    // pass where every implementation is known and the derives can be checked field by field.
    dr_applied: u64[],
    // The pass a derive is being expanded in, for --show-derives and for the call trace.
    dr_pass: u64,
    // The expansions this file's declarations asked for in the pass being parsed (dr_parse_tail).
    dr_tail: u8[],
    dr_trace: u64
}

fn same<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
// ---- Hashed lookup by (module, name) -------------------------------------------------------------
// The declaration tables (functions, types) are append-only vectors searched by a module and a name.
// A scan compared every entry, and each comparison built two views, so a program of N functions paid
// N comparisons per call it compiled: the whole build was quadratic in its declaration count
// (docs/design/compile-speed.md). Each table now has an open-addressed index beside it: `slots`
// holds entry index + 1 (0 is empty) and `keys[i]` is the hash entry `i` was filed under, so growing
// re-files without re-reading a name. The index is brought up to date by the lookup itself (the
// tables are pushed to from a dozen places, and none of them has to know): entries are filed in
// index order and never removed, so of two entries with one name the probe meets the earlier first,
// which is the answer the scan gave.
fn name_key<a, b>(m: &a [u8], n: &b [u8]) -> u64 {
    mut h: u64 = 14695981039346656037;
    for i in m.len() {
        h = wrapping_mul(h ^ u64(m[i]), 1099511628211);
    }
    // A byte no name holds, so (`ab`, `c`) and (`a`, `bc`) are different keys.
    h = wrapping_mul(h ^ 255, 1099511628211);
    for i in n.len() {
        h = wrapping_mul(h ^ u64(n[i]), 1099511628211);
    }
    return h;
}
fn index_file<a>(slots: (&a mut u64[]), key: u64, value: u64) -> unit {
    mask := slots.len() - 1;
    mut h = key & mask;
    while slots[h] != 0 {
        h = (h + 1) & mask;
    }
    slots[h] = value;
    return ();
}
// File entry `keys.len()` under `key`. The table stays at most half full.
fn index_add<a, b>(slots: (&a mut u64[]), keys: (&b mut u64[]), key: u64) -> unit {
    keys.push(key);
    if slots.len() < keys.len() * 2 {
        mut size = 64;
        while size < keys.len() * 4 {
            size = size * 2;
        }
        mut grown = u64[];
        for i in size {
            grown.push(0);
        }
        for i in keys.len() {
            index_file(&mut grown, keys[i], i + 1);
        }
        exchange(slots, grown);
        return ();
    }
    index_file(slots, key, keys.len());
    return ();
}
// Cut the index back to `len` entries. The entries leaving are the last ones filed, and linear
// probing undone last-in-first-out leaves the table exactly as it was before they were filed, so
// each is found by its own key and its slot is cleared.
fn index_cut<a, b>(slots: (&a mut u64[]), keys: (&b mut u64[]), len: u64) -> unit {
    while len < keys.len() {
        value := keys.len();
        key := keys.pop()!;
        mask := slots.len() - 1;
        mut h = key & mask;
        while slots[h] != value {
            h = (h + 1) & mask;
        }
        slots[h] = 0;
    }
    return ();
}
// The same index for a list of names (`list[i]` is filed under its own bytes). A list that was cut
// back since the last lookup is cut back here too.
fn names_sync<a, b, d>(slots: (&a mut u64[]), keys: (&b mut u64[]), list: (&d u8[][])) -> unit {
    if list.len() < keys.len() {
        index_cut(slots, keys, list.len());
    }
    while keys.len() < list.len() {
        key := name_key(view(""), view(list[keys.len()]));
        index_add(slots, keys, key);
    }
    return ();
}
// Index + 1 of `name` in `list`, or 0.
fn names_find<a, b, d, e>(
    slots: (&a mut u64[]),
    keys: (&b mut u64[]),
    list: (&d u8[][]),
    name: &e [u8]
) -> u64 {
    names_sync(slots, keys, list);
    if slots.len() == 0 {
        return 0;
    }
    key := name_key(view(""), name);
    mask := slots.len() - 1;
    mut h = key & mask;
    while slots[h] != 0 {
        i := slots[h] - 1;
        if keys[i] == key {
            if same(view(list[i]), name) {
                return i + 1;
            }
        }
        h = (h + 1) & mask;
    }
    return 0;
}
// A specialisation's key: its template and its canonical type arguments.
fn spec_hash<a>(template: u64, args: (&a u64[])) -> u64 {
    mut h: u64 = wrapping_mul(14695981039346656037 ^ template, 1099511628211);
    for i in args.len() {
        h = wrapping_mul(h ^ args[i], 1099511628211);
        h = h ^ (h >> 29);
    }
    return h;
}
fn spec_index_sync<a>(c: (&a mut C)) -> unit {
    if c.specs.len() < c.spec_keys.len() {
        // A speculative compile was undone (a closure's result inferred by compiling its body).
        index_cut(&mut c.spec_slots, &mut c.spec_keys, c.specs.len());
    }
    while c.spec_keys.len() < c.specs.len() {
        i := c.spec_keys.len();
        key := spec_hash(c.specs[i].template, &c.specs[i].args);
        index_add(&mut c.spec_slots, &mut c.spec_keys, key);
    }
    return ();
}
// Bring the function index up to the table: file every entry pushed since the last lookup.
fn func_index_sync<a>(c: (&a mut C)) -> unit {
    while c.func_keys.len() < c.funcs.len() {
        i := c.func_keys.len();
        key := name_key(view(c.funcs[i].module), view(c.funcs[i].name));
        index_add(&mut c.func_slots, &mut c.func_keys, key);
    }
    return ();
}
fn decl_index_sync<a>(c: (&a mut C)) -> unit {
    while c.decl_keys.len() < c.decls.len() {
        i := c.decl_keys.len();
        key := name_key(view(c.decls[i].module), view(c.decls[i].name));
        index_add(&mut c.decl_slots, &mut c.decl_keys, key);
    }
    return ();
}

// ---- output ----
fn o<a, b>(c: (&a mut C), s: &b [u8]) -> unit {
    if c.quiet != 0 {
        return ();
    }
    for i in s.len() {
        c.out.push(s[i]);
    }
    return ();
}
fn on<a>(c: (&a mut C), n: u64) -> unit {
    if c.quiet != 0 {
        return ();
    }
    if 9 < n {
        on(&mut c, n / 10);
    }
    c.out.push(48 + n % 10);
    return ();
}
// Escape a path for an assembler .file directive (quotes and backslashes).
fn emit_path<a, b>(c: (&a mut C), path: &b [u8]) -> unit {
    for i in path.len() {
        b := path[i];
        if (b == 92) || (b == 34) {
            c.out.push(92);
        }
        c.out.push(b);
    }
    return ();
}

// ---- per-module emission (B1 stage 1) ----
// `--split` writes one assembly file per module instead of one for the whole program. Emission stays
// a single stream, because the whole-program optimizer, generic specialisation and closure lowering
// all reach across modules; the stream is split after lowering, at the boundaries recorded here. A
// marker line opens a run of one module's code and carries the `.text` directive that starts its
// file. Markers are top-level lines, so optimize copies them through untouched and reports where
// they landed; the parts minus those markers are the single-file stream, which is what
// tools/split-test.mjs checks.
// The label namespace of an emission unit: its own name with anything that is not an identifier
// character replaced by '_', then eight hex digits of a hash of the name. Labels are file-local, so
// one file holding several units needs the prefix to keep them apart - and a unit's text must not
// depend on the units before it, which is what the per-unit counter (reset in `part`) gives.
fn unit_prefix<a>(name: &a [u8]) -> u8[] {
    mut out = u8[];
    for i in name.len() {
        b := name[i];
        if ((97 <= b) & (b <= 122)) || ((65 <= b) & (b <= 90)) || ((48 <= b) & (b <= 57)) || (b == 95) {
            out.push(b);
        } else {
            out.push(95);
        }
    }
    out.push(95);
    // A 32-bit hash kept below 2^32 so the multiply cannot overflow a checked build.
    mut h: u64 = 2166136261;
    for i in name.len() {
        h = (h * 131 + u64(name[i])) % 4294967291;
    }
    mut at: u64 = 28;
    loop {
        d := (h >> at) & 15;
        if d < 10 {
            out.push(48 + d);
        } else {
            out.push(87 + d);
        }
        if at == 0 {
            break;
        }
        at -= 4;
    }
    return out;
}
// 1 when the optimizer runs, so emission units are named in the stream it reads. `--debug` and the
// other backends read the stream untouched, so they get no marker and no label namespace.
fn unit_markers<a>(c: (&a C)) -> u64 {
    if (c.debug != 0) | (c.backend != 0) {
        return 0;
    }
    return 1;
}
fn part<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    if same(view(c.part), view(name)) {
        // Still the same module: the run continues, and its file already has its `.text`.
        return ();
    }
    c.part = name.copy();
    c.lpart = unit_prefix(view(name));
    mut k = 0;
    while k < c.lunits.len() {
        if same(view(c.lunits[k]), view(name)) {
            break;
        }
        k += 1;
    }
    if k == c.lunits.len() {
        c.lunits.push(name.copy());
        c.lnext.push(1);
        c.rnext.push(0);
        c.fnext.push(0);
    }
    c.lunit = k + 1;
    c.label = c.lnext[k];
    c.ref_next = c.rnext[k];
    if unit_markers(&c) != 0 {
        // The marker states the unit's name (what `--split` names a file after) and the label
        // prefix its code mints (what the optimizer has to recognise as this unit's labels).
        prefix := c.lpart.copy();
        c.plan_at.push(c.out.len());
        o(&mut c, view(".grail_part "));
        o(&mut c, name);
        c.out.push(32);
        o(&mut c, view(prefix));
        c.out.push(10);
        if c.split != 0 {
            o(&mut c, view(".text\n"));
        }
    }
    // Each module's literals start eight-aligned, in one file as in parts: a part object's section
    // is aligned on its own, so the single build pads where the split link will. Only an ELF build
    // is split, so only it needs the pad; a Mach-O build leaves the section to its literals, because
    // an empty pad must not bring one into being (`.rodata` is not a section name there at all).
    if c.plat == 0 {
        o(&mut c, view(".pushsection .rodata\n.p2align 3\n.popsection\n"));
    }
    return ();
}
// Decimal digits of a synthetic module suffix plus one, or 0 when the suffix is not a number.
fn module_index<a>(name: &a [u8], from: u64) -> u64 {
    if name.len() <= from {
        return 0;
    }
    mut n = 0;
    mut i = from;
    while i < name.len() {
        d := name[i];
        if (d < 48) || (57 < d) {
            return 0;
        }
        n = n * 10 + (d - 48);
        i += 1;
    }
    return n + 1;
}
// The source module of an emission unit. `.impl_N` and `.inherent_N` are mangling names for one
// declaration inside a file, not modules a build could name, so they resolve to the module that
// file declares; every other name is already the module.
fn unit_module<a, b>(c: (&a mut C), m: &b [u8]) -> u8[] {
    if starts_with(view(m), view(".impl_")) {
        // `.impl_K` is written from c.current_impl, which is 1-based (0 means none), so it names
        // implementations[K - 1]; module_index returns K + 1.
        n := module_index(view(m), 6);
        if (1 < n) & (n - 1 <= c.implementations.len()) {
            return c.implementations[n - 2].module.copy();
        }
    }
    if starts_with(view(m), view(".inherent_")) {
        n := module_index(view(m), 10);
        if (n != 0) & (n <= c.decls.len()) {
            return c.decls[n - 1].module.copy();
        }
    }
    return m.copy();
}
// A part file name: `STEM.NNN.module.s`, numbered in stream order so the manifest order is also the
// order `ls` shows. Characters that are not identifier-safe become '_' (a module name is an
// identifier, so this only guards against a name that failed to resolve).
fn part_file<a, b, d>(stem: &a [u8], seq: u64, name: &b [u8], ext: &d [u8]) -> u8[] {
    mut out = stem.copy();
    out.push(46);
    if seq < 10 {
        push_bytes(&mut out, view("00"));
    } else {
        if seq < 100 {
            out.push(48);
        }
    }
    decimal(&mut out, seq);
    out.push(46);
    for i in name.len() {
        b := name[i];
        if ((97 <= b) & (b <= 122)) || ((65 <= b) & (b <= 90)) || ((48 <= b) & (b <= 57)) || (b == 95) {
            out.push(b);
        } else {
            out.push(95);
        }
    }
    push_bytes(&mut out, view(ext));
    return out;
}
// `PATH.s` -> `PATH`: the stem the part files and the manifest are named from.
fn path_stem<a>(path: &a [u8]) -> u8[] {
    mut n = path.len();
    if (n > 1) & (path[n - 1] == 115) & (path[n - 2] == 46) {
        n = n - 2;
    }
    mut out = u8[];
    for i in n {
        out.push(path[i]);
    }
    return out;
}
// Write the parts of one lowered image plus the manifest the driver reads back: the part files in
// link order, then the `// grail-link:` request that a single-file build carries at the head of its
// assembly. The optimizer reported where each marker landed, so a part is written as a slice of the
// stream — splitting costs no copy — and every run already starts with its own `.text` directive.
fn write_parts<a, b, d>(c: (&a mut C), path: &b [u8], text: &d [u8]) -> u64 {
    stem := path_stem(view(path));
    mut files = u8[][];
    mut status: u64 = 0;
    for k in c.marks.len() {
        // Past the `.grail_part` line: the run begins at the `.text` directive under it. The offset
        // is found rather than computed, so the marker line may carry more than the module name.
        mut start = c.marks[k];
        while (start < text.len()) & (text[start] != 10) {
            start += 1;
        }
        start += 1;
        mut end = text.len();
        if k + 1 < c.marks.len() {
            end = c.marks[k + 1];
        }
        if end > start {
            file := part_file(view(stem), files.len(), view(c.part_names[k]), view(".s"));
            mut wrote = 0;
            // A part's frames are its own functions', so it is probed on its own (see write_image).
            mut piece = text[start: end].copy();
            if (c.probes != 0) & (c.backend == 0) {
                piece = optimize::probe_frames(view(piece), u64((c.target == 3) || (c.target == 4)));
            }
            if x86_atomics(&mut c, view(piece)) {
                wrote = host::write_file(view(file), view(machine::atomics_x86(view(piece))));
            } else {
                wrote = host::write_file(view(file), view(piece));
            }
            if wrote != 0 {
                status = 1;
            }
            files.push(file);
        }
    }
    if files.len() == 0 {
        fail(&mut c, view("--split produced no module output"));
    }
    mut manifest = copy_bytes(view("// grail-parts 1\n"));
    for i in files.len() {
        push_bytes(&mut manifest, view(files[i]));
        manifest.push(10);
    }
    for i in c.libs.len() {
        push_bytes(&mut manifest, view("// grail-link: "));
        push_bytes(&mut manifest, view(c.libs[i]));
        manifest.push(10);
    }
    mut manifest_path = u8[];
    push_bytes(&mut manifest_path, view(stem));
    push_bytes(&mut manifest_path, view(".parts"));
    if host::write_file(view(manifest_path), view(manifest)) != 0 {
        status = 1;
    }
    return status;
}
// The one assembly write point: the whole-program image when --split is off, one file per module
// plus a manifest when it is on.
// On x86-64 (ELF and PE) the `atom.*` lines are expanded here, the last step before the assembler
// (machine.grl `atomics_x86`): after the parts are cut, because the optimizer's part offsets are
// offsets into the unexpanded stream, and after the PE unwind and debug passes, which read the
// stream as it was emitted. Other targets lowered them in `machine::lower` or in LLVM IR.
fn x86_atomics<a, b>(c: (&a mut C), text: &b [u8]) -> bool {
    return ((c.target == 0) || (c.target == 3)) && machine::has_atomics(view(text));
}
fn write_image<a, b, d>(c: (&a mut C), path: &b [u8], image: &d [u8]) -> u64 {
    if c.split != 0 {
        return write_parts(&mut c, view(path), view(image));
    }
    // The in-process assembler lowers `atom.` lines as it reads them; text for clang is lowered here.
    if (c.object.len() == 0) && x86_atomics(&mut c, view(image)) {
        lowered := machine::atomics_x86(view(image));
        return write_assembled(&mut c, view(path), view(lowered));
    }
    return write_assembled(&mut c, view(path), view(image));
}
// The object for `image`. A build that names its compiler (`--fn-cache-id`, the driver's builds)
// keeps the function units of each object beside it (`OBJ.units`, headed by that identity) and
// replays the ones whose text did not move (asm_x86, function units). `GRAIL_ASM_UNITS_VERIFY=1`
// also assembles without them and refuses a difference.
fn assemble_object<a, b>(c: (&a mut C), image: &b [u8]) -> asm_x86::Result {
    // AArch64 (Linux): the same reader with asm_a64's encoder; no function units yet.
    if ((c.target == 1) || (c.target == 2)) && (c.plat == 0) {
        return asm_x86::assemble_for(c.target, copy_bytes(view(image)));
    }
    if c.fn_id.len() == 0 {
        return asm_x86::assemble(copy_bytes(view(image)));
    }
    mut pack_path = copy_bytes(view(c.object));
    push_bytes(&mut pack_path, view(".units"));
    mut header = copy_bytes(view("grail-units 2 "));
    push_bytes(&mut header, view(c.fn_id));
    header.push(10);
    mut previous = u8[];
    if host::exists(view(pack_path)) != 0 {
        pack := host::read_file(view(pack_path));
        if (pack.len() >= header.len()) && same(view(pack[0: header.len()]), view(header)) {
            previous.append(pack[header.len(): pack.len()]);
        }
    }
    r := asm_x86::assemble_units(copy_bytes(view(image)), previous);
    if r.error.len() != 0 {
        return r;
    }
    if host::env(view("GRAIL_ASM_UNITS_VERIFY")).len() != 0 {
        plain := asm_x86::assemble(copy_bytes(view(image)));
        if !same(view(plain.object), view(r.object)) {
            return asm_x86::Result { object: u8[], error: copy_bytes(view("an object assembled from function units differs from the plain assembly")), units: u8[], replayed: 0, encoded: 0 };
        }
    }
    mut out = header;
    push_bytes(&mut out, view(r.units));
    host::write_file(view(pack_path), view(out));
    return r;
}
// The image, as the object `--object` names (in-process assembly; the assembly file then keeps the
// link notes alone, which is all the driver reads of it), or as assembly text.
fn write_assembled<a, b, d>(c: (&a mut C), path: &b [u8], image: &d [u8]) -> u64 {
    if c.object.len() != 0 {
        r := assemble_object(&mut c, view(image));
        if r.error.len() != 0 {
            mut said = copy_bytes(view("the internal assembler: "));
            push_bytes(&mut said, view(r.error));
            fail(&mut c, view(said));
            return 1;
        }
        if host::write_file(view(c.object), view(r.object)) != 0 {
            return 1;
        }
        return host::write_file(view(path), view(with_link_notes(&c.libs, view(""))));
    }
    return host::write_file(view(path), view(with_link_notes(&c.libs, view(image))));
}
fn contains_text<a, b>(text: &a [u8], needle: &b [u8]) -> bool {
    if needle.len() > text.len() {
        return false;
    }
    mut i = 0;
    while i + needle.len() <= text.len() {
        mut j = 0;
        mut ok = 1;
        while j < needle.len() {
            if text[i + j] != needle[j] {
                ok = 0;
            }
            j += 1;
        }
        if ok != 0 {
            return true;
        }
        i += 1;
    }
    return false;
}
// `.loc` before a literal section switch is dropped by the assembler, so re-assert the last
// source location after every `.popsection`. This keeps the first statement of a function on the
// line table even when it starts by pushing a string literal.
fn debug_locs<a>(text: &a [u8]) -> u8[] {
    mut out = u8[];
    mut loc = u8[];
    mut line = u8[];
    for i in text.len() {
        b := text[i];
        line.push(b);
        if b == 10 {
            if starts_with(view(line), view(".loc ")) || starts_with(view(line), view(".cv_loc ")) {
                mut fresh = u8[];
                for k in line.len() {
                    fresh.push(line[k]);
                }
                exchange(&mut loc, fresh);
            }
            for k in line.len() {
                out.push(line[k]);
            }
            if contains_text(view(line), view(".popsection")) {
                for k in loc.len() {
                    out.push(loc[k]);
                }
            }
            exchange(&mut line, u8[]);
        }
    }
    if line.len() != 0 {
        for k in line.len() {
            out.push(line[k]);
        }
    }
    return out;
}
fn source_line<a>(c: &a C, pos: u64) -> u64 {
    if c.toks.len() <= pos {
        return 1;
    }
    return c.toks[pos].line;
}
// ---- DWARF .debug_info emission (Linux x86-64) ----
fn dput<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
    return ();
}
fn dnum<a>(out: (&a mut u8[]), n: u64) -> unit {
    if 9 < n {
        dnum(&mut out, n / 10);
    }
    out.push(48 + n % 10);
    return ();
}
fn duleb<a>(out: (&a mut u8[]), n: u64) -> unit {
    dput(&mut out, view(".uleb128 "));
    dnum(&mut out, n);
    dput(&mut out, view("\n"));
    return ();
}
fn dpath<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    for i in text.len() {
        b := text[i];
        if (b == 92) || (b == 34) {
            out.push(92);
        }
        out.push(b);
    }
    return ();
}
fn dstring<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    dput(&mut out, view(".asciz \""));
    dpath(&mut out, text);
    dput(&mut out, view("\"\n"));
    return ();
}
fn dattr<a>(out: (&a mut u8[]), code: u64, form: u64) -> unit {
    dput(&mut out, view(".uleb128 "));
    dnum(&mut out, code);
    dput(&mut out, view("\n.uleb128 "));
    dnum(&mut out, form);
    dput(&mut out, view("\n"));
    return ();
}
// Raw SLEB128 bytes for a negative value -n (n > 0), using exact floor division.
fn sleb_neg<a>(out: (&a mut u8[]), n: u64) -> unit {
    mut v: i64 = 0 - i64(n);
    while true {
        mut b: i64 = v % 128;
        if b < 0 {
            b = b + 128;
        }
        v = (v - b) / 128;
        if ((v == 0) && (b < 64)) || ((v == i64(0) - i64(1)) && (64 <= b)) {
            out.push(u64(b));
            return ();
        }
        out.push(u64(b + 128));
    }
}
// DW_OP_fbreg with a SLEB128 -offset, where offset is the rbp slot distance.
fn dlocation<a>(out: (&a mut u8[]), slot: u64) -> unit {
    mut expr = u8[];
    expr.push(145);
    sleb_neg(&mut expr, (slot + 1) * 8);
    duleb(&mut out, expr.len());
    for i in expr.len() {
        dput(&mut out, view(".byte "));
        dnum(&mut out, expr[i]);
        dput(&mut out, view("\n"));
    }
    return ();
}
// DWARF base types for a Grail value held in an 8-byte slot. Integers, floats, bool and char
// are exact (all targets are little-endian, so a narrow value's bytes start the slot; an f32
// slot holds the binary64 word of its value and is described as an 8-byte float); a
// string, record or other owned value is shown as its 8-byte handle, named after its type.
fn debug_type_name<a>(c: (&a mut C), ty: u64) -> u8[] {
    mut out = u8[];
    if ty == 0 {
        push_bytes(&mut out, view("u64"));
        return out;
    }
    k := ty_kind(&mut c, ty);
    if k == 18 {
        if ty_mode(&mut c, ty) != 0 {
            out.push(105);
        } else {
            out.push(117);
        }
        decimal(&mut out, ty_arg(&mut c, ty));
        return out;
    }
    if k == 21 {
        if is_f32(&mut c, ty) {
            push_bytes(&mut out, view("f32"));
        } else {
            push_bytes(&mut out, view("f64"));
        }
        return out;
    }
    if k == 19 {
        push_bytes(&mut out, view("bool"));
        return out;
    }
    if k == 22 {
        push_bytes(&mut out, view("char"));
        return out;
    }
    if k == 3 {
        push_bytes(&mut out, view("string"));
        return out;
    }
    if k == 8 {
        d := ty_arg(&mut c, ty);
        push_bytes(&mut out, view(c.decls[d].name));
        return out;
    }
    push_bytes(&mut out, view("word"));
    return out;
}
fn debug_type_encoding<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 7;
    }
    k := ty_kind(&mut c, ty);
    if k == 18 {
        if ty_mode(&mut c, ty) != 0 {
            return 5;
        }
        return 7;
    }
    if k == 21 {
        return 4;
    }
    if k == 19 {
        return 2;
    }
    if k == 22 {
        return 16;
    }
    return 7;
}
fn debug_type_size<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    if k == 18 {
        return ty_arg(&mut c, ty) / 8;
    }
    // An f32 value is held as the binary64 word of its value, so its slot reads as a double.
    if k == 22 {
        return 4;
    }
    return 8;
}
// The DWARF type of a value of Grail type `ty`, added to c.debug_types once (by name, kind and size)
// and returned as its index. A string, byte sequence or vector is a pointer to the runtime's 24-byte
// header {data, len, cap}, with `data` typed so a debugger prints the text or the elements; a Grail
// record is a pointer to its fields, one 8-byte word each; an extern "C" record is a pointer to its C
// layout, embedded records inline. A record that mentions itself is entered before its members, so
// the recursion ends. `c_layout` 1 describes a field of a C record (its C size, not a word).
fn debug_type_add<a>(c: (&a mut C), t: DebugType) -> u64 {
    for i in c.debug_types.len() {
        e := &c.debug_types[i];
        if same(view(e.name), view(t.name)) & (e.kind == t.kind) & (e.size == t.size) {
            return i;
        }
    }
    c.debug_types.push(t);
    return c.debug_types.len() - 1;
}
fn debug_base<a, b>(c: (&a mut C), name: &b [u8], enc: u64, size: u64) -> u64 {
    return debug_type_add(&mut c, DebugType { name: copy_bytes(name), kind: 0, enc: enc, size: size, pointee: 0, members: DebugMember[] });
}
fn debug_typedef<a, b>(c: (&a mut C), name: &b [u8], to: u64) -> u64 {
    return debug_type_add(&mut c, DebugType { name: copy_bytes(name), kind: 4, enc: 0, size: 0, pointee: to, members: DebugMember[] });
}
// The enumeration type of an enum's tag word: one enumerator per variant, valued by the tag the
// variant constructor stores (the variant's index in the declaration).
fn debug_enum_tag<a>(c: (&a mut C), ty: u64) -> u64 {
    d := ty_arg(&mut c, ty);
    mut name = c.decls[d].name.copy();
    push_bytes(&mut name, view(".tag"));
    mut members = DebugMember[];
    count := c.decls[d].count;
    for i in count {
        vname := c.fields[c.decls[d].first + i].name.copy();
        members.push(DebugMember { name: vname, ty: 0, offset: i });
    }
    return debug_type_add(&mut c, DebugType { name: name, kind: 3, enc: 0, size: 8, pointee: 0, members: members });
}
fn debug_pointer<a>(c: (&a mut C), to: u64) -> u64 {
    mut name = copy_bytes(view("*"));
    push_bytes(&mut name, view(c.debug_types[to].name));
    return debug_type_add(&mut c, DebugType { name: name, kind: 1, enc: 0, size: 8, pointee: to, members: DebugMember[] });
}
fn debug_header<a, b>(c: (&a mut C), name: &b [u8], data: u64) -> u64 {
    word := debug_base(&mut c, view("u64"), 7, 8);
    // `data` is a pointer to the first element, so `print *v.data@v.len` walks the elements at the
    // right stride. It is deliberately not a DW_TAG_array_type with a count: the length lives in
    // `len`, and an array type would have to state a length the header does not carry.
    mut members = DebugMember[];
    members.push(DebugMember { name: copy_bytes(view("data")), ty: debug_pointer(&mut c, data), offset: 0 });
    members.push(DebugMember { name: copy_bytes(view("len")), ty: word, offset: 8 });
    members.push(DebugMember { name: copy_bytes(view("cap")), ty: word, offset: 16 });
    s := debug_type_add(&mut c, DebugType { name: copy_bytes(name), kind: 2, enc: 0, size: 24, pointee: 0, members: members });
    return debug_pointer(&mut c, s);
}
fn debug_type_of<a>(c: (&a mut C), ty: u64, c_layout: u64) -> u64 {
    if ty == 0 {
        return debug_base(&mut c, view("u64"), 7, 8);
    }
    k := ty_kind(&mut c, ty);
    if (k == 3) || (k == 4) {
        text := debug_base(&mut c, view("char"), 8, 1);
        mut name = copy_bytes(view("string"));
        if k == 4 {
            name = copy_bytes(view("u8[]"));
        }
        return debug_header(&mut c, view(name), text);
    }
    if k == 6 {
        // Vector elements are 8-byte words: an element type narrower than a word would make a
        // debugger step through them at the wrong stride, so such elements read as words.
        elem := ty_arg(&mut c, ty);
        mut et = debug_type_of(&mut c, elem, 0);
        if (c.debug_types[et].kind == 0) & (c.debug_types[et].size != 8) {
            et = debug_base(&mut c, view("u64"), 7, 8);
        }
        // A plain record or a C record element is stored inline, its words (or C bytes) one after
        // another (unboxed-values.md, stage 1b): the element is the record itself, not a pointer.
        if flat_bytes(&mut c, elem) != 0 {
            et = c.debug_types[et].pointee;
        }
        mut name = debug_type_name(&mut c, elem);
        push_bytes(&mut name, view("[]"));
        return debug_header(&mut c, view(name), et);
    }
    if (k == 8) & (is_c_record(&mut c, ty) != 0) {
        d := ty_arg(&mut c, ty);
        name := c.decls[d].name.copy();
        size := ffi_record_size(&mut c, d);
        // Entered first, empty, so a field that names this record finds it; a record already entered
        // (or being filled further up this recursion) is not described twice.
        before := c.debug_types.len();
        s := debug_type_add(&mut c, DebugType { name: name, kind: 2, enc: 0, size: size, pointee: 0, members: DebugMember[] });
        if s < before {
            return debug_pointer(&mut c, s);
        }
        mut members = DebugMember[];
        count := c.decls[d].count;
        for i in count {
            fty := field_ty(&mut c, d, i);
            off := ffi_offset(&mut c, d, i);
            fname := c.fields[c.decls[d].first + i].name.copy();
            mut mt = 0;
            if is_c_record(&mut c, fty) != 0 {
                inner := debug_type_of(&mut c, fty, 1);
                mt = c.debug_types[inner].pointee;
            } else {
                mt = debug_type_of(&mut c, fty, 1);
            }
            members.push(DebugMember { name: fname, ty: mt, offset: off });
        }
        exchange(&mut c.debug_types[s].members, members);
        return debug_pointer(&mut c, s);
    }
    // `&` evaluates both sides, so the record test is nested: c.decls is indexed only for kind 8.
    mut plain_record = false;
    if k == 8 {
        rd := ty_arg(&mut c, ty);
        plain_record = c.decls[rd].is_enum == 0;
    }
    if plain_record {
        d := ty_arg(&mut c, ty);
        name := c.decls[d].name.copy();
        count := c.decls[d].count;
        before := c.debug_types.len();
        // The record's words as they are laid out: a plain record field is inline, its words where
        // field_word puts them (unboxed-values.md, stage 1b).
        words := record_words(&mut c, base_type(&mut c, ty));
        s := debug_type_add(&mut c, DebugType { name: name, kind: 2, enc: 0, size: 8 * words, pointee: 0, members: DebugMember[] });
        if s < before {
            return debug_pointer(&mut c, s);
        }
        mut members = DebugMember[];
        for i in count {
            fty := field_ty(&mut c, d, i);
            mut mt = debug_type_of(&mut c, fty, 0);
            if inline_field(&mut c, ty, i) {
                mt = c.debug_types[mt].pointee;
            }
            members.push(DebugMember { name: c.fields[c.decls[d].first + i].name.copy(), ty: mt, offset: 8 * field_word(&mut c, ty, i) });
        }
        exchange(&mut c.debug_types[s].members, members);
        return debug_pointer(&mut c, s);
    }
    if (c_layout != 0) & (k == 21) {
        // A C float field is a real binary32 (a Grail f32 slot holds the binary64 of its value).
        if is_f32(&mut c, ty) {
            return debug_base(&mut c, view("float"), 4, 4);
        }
    }
    // An enum value is a pointer to {tag, payload}: the tag is an enumeration type with the variant
    // names as enumerators, and the payload is left as the word it is, because which variant's type
    // it holds is the tag's answer, not this type's.
    mut enum_value = false;
    if k == 8 {
        ed := ty_arg(&mut c, ty);
        enum_value = c.decls[ed].is_enum != 0;
    }
    if enum_value {
        ed := ty_arg(&mut c, ty);
        name := c.decls[ed].name.copy();
        tag := debug_enum_tag(&mut c, ty);
        word := debug_base(&mut c, view("u64"), 7, 8);
        mut members = DebugMember[];
        members.push(DebugMember { name: copy_bytes(view("tag")), ty: tag, offset: 0 });
        members.push(DebugMember { name: copy_bytes(view("payload")), ty: word, offset: 8 });
        mut value_name = copy_bytes(view(name));
        push_bytes(&mut value_name, view(".value"));
        s := debug_type_add(&mut c, DebugType { name: value_name, kind: 2, enc: 0, size: 16, pointee: 0, members: members });
        return debug_typedef(&mut c, view(name), debug_pointer(&mut c, s));
    }
    if k == 5 {
        // A view: a pointer into someone else's bytes, and a length.
        text := debug_base(&mut c, view("char"), 8, 1);
        word := debug_base(&mut c, view("u64"), 7, 8);
        mut members = DebugMember[];
        members.push(DebugMember { name: copy_bytes(view("data")), ty: debug_pointer(&mut c, text), offset: 0 });
        members.push(DebugMember { name: copy_bytes(view("len")), ty: word, offset: 8 });
        return debug_type_add(&mut c, DebugType { name: copy_bytes(view("view")), kind: 2, enc: 0, size: 16, pointee: 0, members: members });
    }
    if k == 7 {
        // A reference is the address of its referent's word - except a reference to a record, which
        // is the record's own address (`direct`, unboxed-values.md stage 1a), so it is described as
        // the record value is: a pointer to its fields.
        referent := ty_arg(&mut c, ty);
        inner := debug_type_of(&mut c, referent, 0);
        if direct(&mut c, referent) {
            return inner;
        }
        return debug_pointer(&mut c, inner);
    }
    if (k != 18) & (k != 19) & (k != 21) & (k != 22) {
        // Enums, closures, handles, maps and the rest: described as the word they occupy until
        // they get a layout of their own here.
        return debug_base(&mut c, view("u64"), 7, 8);
    }
    name := debug_type_name(&mut c, ty);
    enc := debug_type_encoding(&mut c, ty);
    size := debug_type_size(&mut c, ty);
    return debug_base(&mut c, view(name), enc, size);
}
fn record_debug_func<a, b, d>(c: (&a mut C), name: &b [u8], module: &d [u8], site: &DebugSite) -> unit {
    mut vars = DebugVar[];
    for i in c.debug_vars.len() {
        l := &c.debug_vars[i];
        vars.push(
            DebugVar {
                name: copy_bytes(view(l.name)),
                slot: l.slot,
                line: l.line,
                param: l.param,
                ty: l.ty
            }
        );
    }
    // The function's labels are in its own numbering (scoped_number), and this runs inside it.
    mut unit = copy_bytes(view(c.lpart));
    if c.fscope != 0 {
        unit.push(95);
        decimal(&mut unit, c.fscope);
    }
    c
        .debug_funcs
        .push(
            DebugFunc {
                name: copy_bytes(view(name)),
                module: copy_bytes(view(module)),
                file: site.file,
                line: site.line,
                start: site.start,
                end: site.end,
                params: site.params,
                vars: vars,
                unit: unit
            }
        );
    return ();
}
fn cv_label<a>(out: (&a mut u8[]), name: &a [u8], i: u64, j: u64) -> unit {
    push_bytes(&mut out, view(".Lcv"));
    push_bytes(&mut out, name);
    decimal(&mut out, i);
    out.push(95);
    decimal(&mut out, j);
    return ();
}
// A CodeView symbol record: the 2-byte length, then kind and body up to a 4-byte boundary.
fn cv_record_start<a>(out: (&a mut u8[]), i: u64, j: u64, kind: u64) -> unit {
    push_bytes(&mut out, view(".short "));
    cv_label(&mut out, view("e"), i, j);
    out.push(45);
    cv_label(&mut out, view("s"), i, j);
    out.push(10);
    cv_label(&mut out, view("s"), i, j);
    push_bytes(&mut out, view(":\n.short "));
    decimal(&mut out, kind);
    out.push(10);
    return ();
}
fn cv_record_end<a>(out: (&a mut u8[]), i: u64, j: u64) -> unit {
    push_bytes(&mut out, view(".p2align 2\n"));
    cv_label(&mut out, view("e"), i, j);
    push_bytes(&mut out, view(":\n"));
    return ();
}
// ---- CodeView type records (.debug$T), built from c.debug_types ----
// Predefined CodeView index for a base type.
fn cv_base(t: &DebugType) -> u64 {
    if t.enc == 4 {
        if t.size == 4 {
            return 64;
        }
        return 65;
    }
    if t.enc == 2 {
        return 48;
    }
    if t.enc == 16 {
        return 123;
    }
    if t.enc == 8 {
        // T_RCHAR: text bytes, shown as characters.
        return 112;
    }
    if t.enc == 5 {
        if t.size == 1 { return 16; }
        if t.size == 2 { return 17; }
        if t.size == 4 { return 116; }
        return 19;
    }
    if t.size == 1 { return 32; }
    if t.size == 2 { return 33; }
    if t.size == 4 { return 117; }
    return 35;
}
fn cv_short(out: &mut u8[], v: u64) -> unit {
    push_bytes(&mut out, view(".short "));
    decimal(&mut out, v);
    out.push(10);
    return ();
}
fn cv_long(out: &mut u8[], v: u64) -> unit {
    push_bytes(&mut out, view(".long "));
    decimal(&mut out, v);
    out.push(10);
    return ();
}
fn cv_name(out: &mut u8[], name: &[u8]) -> unit {
    push_bytes(&mut out, view(".asciz \""));
    push_bytes(&mut out, view(name));
    push_bytes(&mut out, view("\"\n"));
    return ();
}
// LF_PADn bytes taking `used` up to a multiple of four.
fn cv_pad(out: &mut u8[], used: u64) -> unit {
    mut left = (4 - used % 4) % 4;
    while left > 0 {
        push_bytes(&mut out, view(".byte "));
        decimal(&mut out, 240 + left);
        out.push(10);
        left = left - 1;
    }
    return ();
}
// A numeric leaf: the value itself below 0x8000, else LF_ULONG and four bytes. Returns its size.
fn cv_numeric(out: &mut u8[], v: u64) -> u64 {
    if v < 32768 {
        cv_short(&mut out, v);
        return 2;
    }
    cv_short(&mut out, 32772);
    cv_long(&mut out, v);
    return 6;
}
fn cv_numeric_size(v: u64) -> u64 {
    if v < 32768 {
        return 2;
    }
    return 6;
}
// LF_STRUCTURE: `fwd` 1 for a forward reference (property 0x80, no field list, size 0).
fn cv_structure(out: &mut u8[], count: u64, fields: u64, size: u64, name: &[u8], fwd: u64) -> unit {
    payload := 2 + 2 + 2 + 4 + 4 + 4 + cv_numeric_size(size) + name.len() + 1;
    cv_short(&mut out, payload + (4 - (2 + payload) % 4) % 4);
    cv_short(&mut out, 5381);
    cv_short(&mut out, count);
    cv_short(&mut out, 128 * fwd);
    cv_long(&mut out, fields);
    cv_long(&mut out, 0);
    cv_long(&mut out, 0);
    cv_numeric(&mut out, size);
    cv_name(&mut out, name);
    cv_pad(&mut out, 2 + payload);
    return ();
}
// The type stream. Indices start at 0x1000 in emission order: every structure's forward reference,
// then every pointer (its pointee comes earlier in c.debug_types, so its index is known), then each
// structure's field list followed by its full definition. A pointer to a structure names the
// forward reference, which a debugger resolves by name to the definition - so a record that
// contains a pointer to itself is described without a cycle in the stream.
fn codeview_types<a>(c: &a C, index: (&mut u64[])) -> u8[] {
    mut out = u8[];
    push_bytes(&mut out, view(".section .debug$T,\"dr\"\n.p2align 2\n.long 4\n"));
    n := c.debug_types.len();
    mut fwd = u64[];
    mut next = 4096;
    for i in n {
        index.push(0);
        fwd.push(0);
    }
    for i in n {
        t := &c.debug_types[i];
        if t.kind == 0 {
            index[i] = cv_base(&t);
        }
        if t.kind == 3 {
            // CodeView has no tagged-enum record here: the tag word is an 8-byte unsigned integer.
            index[i] = 35;
        }
        if t.kind == 4 {
            // A typedef is transparent: the index of what it names is already known (a typedef of a
            // structure names the structure's forward reference).
            mut to = index[t.pointee];
            if c.debug_types[t.pointee].kind == 2 {
                to = fwd[t.pointee];
            }
            index[i] = to;
        }
        if t.kind == 2 {
            cv_structure(&mut out, 0, 0, 0, view(t.name), 1);
            fwd[i] = next;
            next = next + 1;
        }
    }
    for i in n {
        t := &c.debug_types[i];
        if t.kind == 1 {
            mut to = index[t.pointee];
            if c.debug_types[t.pointee].kind == 2 {
                to = fwd[t.pointee];
            }
            // LF_POINTER: referent, attributes CV_PTR_64 (0x0c) with size 8 in bits 13-18.
            cv_short(&mut out, 10);
            cv_short(&mut out, 4098);
            cv_long(&mut out, to);
            cv_long(&mut out, 65548);
            index[i] = next;
            next = next + 1;
        }
    }
    for i in n {
        t := &c.debug_types[i];
        if t.kind == 2 {
            // LF_FIELDLIST of LF_MEMBER (public), each padded to four bytes.
            mut body: u64 = 2;
            for j in t.members.len() {
                m := &t.members[j];
                one := 2 + 2 + 4 + cv_numeric_size(m.offset) + m.name.len() + 1;
                body = body + one + (4 - one % 4) % 4;
            }
            cv_short(&mut out, body);
            cv_short(&mut out, 4611);
            for j in t.members.len() {
                m := &t.members[j];
                mut ty = index[m.ty];
                if c.debug_types[m.ty].kind == 2 {
                    ty = fwd[m.ty];
                }
                cv_short(&mut out, 5389);
                cv_short(&mut out, 3);
                cv_long(&mut out, ty);
                cv_numeric(&mut out, m.offset);
                cv_name(&mut out, view(m.name));
                one := 2 + 2 + 4 + cv_numeric_size(m.offset) + m.name.len() + 1;
                cv_pad(&mut out, one);
            }
            fields := next;
            next = next + 1;
            cv_structure(&mut out, t.members.len(), fields, t.size, view(t.name), 0);
            index[i] = next;
            next = next + 1;
        }
    }
    return out;
}
// The DEBUG_S_SYMBOLS subsection: per function an S_GPROC32 over its .L range, an S_FRAMEPROC
// naming rbp as the frame register, an S_REGREL32 per parameter and local at rbp-8*(slot+1)
// (the slot DWARF's fbreg describes), and S_END. lld-link links the scopes into the PDB.
fn codeview_symbols<a>(c: &a C, index: (&u64[])) -> u8[] {
    mut out = u8[];
    push_bytes(&mut out, view(".long 241\n.long .Lcvsyms_end-.Lcvsyms\n.Lcvsyms:\n"));
    for i in c.debug_funcs.len() {
        f := &c.debug_funcs[i];
        fstart := f.start;
        fend := f.end;
        mut range = u8[];
        push_bytes(&mut range, view(".long "));
        dlabel(&mut range, view(f.unit), fend);
        range.push(45); // '-'
        dlabel(&mut range, view(f.unit), fstart);
        range.push(10);
        cv_record_start(&mut out, i, 0, 4368);
        // parent, end, next: lld-link fills the scope links.
        push_bytes(&mut out, view(".long 0\n.long 0\n.long 0\n"));
        push_bytes(&mut out, view(range));
        push_bytes(&mut out, view(".long 0\n"));
        push_bytes(&mut out, view(range));
        push_bytes(&mut out, view(".long 0\n.secrel32 "));
        dlabel(&mut out, view(f.unit), fstart);
        push_bytes(&mut out, view("\n.secidx "));
        dlabel(&mut out, view(f.unit), fstart);
        push_bytes(&mut out, view("\n.byte 0\n.asciz \""));
        if f.module.len() != 0 {
            push_bytes(&mut out, view(f.module));
            push_bytes(&mut out, view("::"));
        }
        push_bytes(&mut out, view(f.name));
        push_bytes(&mut out, view("\"\n"));
        cv_record_end(&mut out, i, 0);
        // S_FRAMEPROC: locals and parameters are addressed from rbp (encoded register 2).
        cv_record_start(&mut out, i, 1, 4114);
        push_bytes(&mut out, view(".long 0\n.long 0\n.long 0\n.long 0\n.long 0\n.short 0\n.long 163840\n"));
        cv_record_end(&mut out, i, 1);
        for j in f.vars.len() {
            v := &f.vars[j];
            cv_record_start(&mut out, i, j + 2, 4369);
            push_bytes(&mut out, view(".long -"));
            decimal(&mut out, (v.slot + 1) * 8);
            push_bytes(&mut out, view("\n.long "));
            decimal(&mut out, index[v.ty]);
            // CV_AMD64_RBP
            push_bytes(&mut out, view("\n.short 334\n.asciz \""));
            push_bytes(&mut out, view(v.name));
            push_bytes(&mut out, view("\"\n"));
            cv_record_end(&mut out, i, j + 2);
        }
        push_bytes(&mut out, view(".short 2\n.short 6\n"));
    }
    push_bytes(&mut out, view(".Lcvsyms_end:\n"));
    return out;
}
fn debug_sections<a, b>(c: &a C, entry: &b [u8]) -> u8[] {
    mut out = u8[];
    if c.debug == 0 {
        return out;
    }
    dput(&mut out, view(".section .debug_abbrev,\"\",@progbits\n"));
    dput(&mut out, view(".Ldebug_abbrev:\n"));
    // 1: compile unit, children.
    duleb(&mut out, 1);
    dput(&mut out, view(".uleb128 17\n.byte 1\n"));
    dattr(&mut out, 0x25, 0x08);
    dattr(&mut out, 0x13, 0x0b);
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x1b, 0x08);
    dattr(&mut out, 0x11, 0x01);
    dattr(&mut out, 0x12, 0x07);
    dattr(&mut out, 0x10, 0x17);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 2: subprogram, children.
    duleb(&mut out, 2);
    dput(&mut out, view(".uleb128 46\n.byte 1\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x6e, 0x08);
    dattr(&mut out, 0x11, 0x01);
    dattr(&mut out, 0x12, 0x07);
    dattr(&mut out, 0x3a, 0x0b);
    dattr(&mut out, 0x3b, 0x0f);
    dattr(&mut out, 0x40, 0x18);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 3: formal parameter, no children.
    duleb(&mut out, 3);
    dput(&mut out, view(".uleb128 5\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x02, 0x18);
    dattr(&mut out, 0x3b, 0x0f);
    dattr(&mut out, 0x49, 0x13);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 4: local variable, no children.
    duleb(&mut out, 4);
    dput(&mut out, view(".uleb128 52\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x02, 0x18);
    dattr(&mut out, 0x3b, 0x0f);
    dattr(&mut out, 0x49, 0x13);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 5: base type: name, encoding, byte size.
    duleb(&mut out, 5);
    dput(&mut out, view(".uleb128 36\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x3e, 0x0b);
    dattr(&mut out, 0x0b, 0x0b);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 6: pointer type: byte size, pointee.
    duleb(&mut out, 6);
    dput(&mut out, view(".uleb128 15\n.byte 0\n"));
    dattr(&mut out, 0x0b, 0x0b);
    dattr(&mut out, 0x49, 0x13);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 7: structure type: name, byte size; members as children.
    duleb(&mut out, 7);
    dput(&mut out, view(".uleb128 19\n.byte 1\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x0b, 0x0f);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 8: member: name, type, offset in the structure.
    duleb(&mut out, 8);
    dput(&mut out, view(".uleb128 13\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x49, 0x13);
    dattr(&mut out, 0x38, 0x0f);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 9: enumeration type: name, byte size; enumerators as children.
    duleb(&mut out, 9);
    dput(&mut out, view(".uleb128 4\n.byte 1\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x0b, 0x0f);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 10: enumerator: name, constant value (the tag the constructor stores).
    duleb(&mut out, 10);
    dput(&mut out, view(".uleb128 40\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x1c, 0x0b);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 11: typedef: name, type.
    duleb(&mut out, 11);
    dput(&mut out, view(".uleb128 22\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x49, 0x13);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    dput(&mut out, view(".byte 0\n"));

    dput(&mut out, view(".section .debug_info,\"\",@progbits\n"));
    dput(&mut out, view(".long .Ldebug_cu_end-.Ldebug_cu_start\n"));
    dput(&mut out, view(".Ldebug_cu_start:\n.short 4\n.long .Ldebug_abbrev\n.byte 8\n"));
    duleb(&mut out, 1);
    dstring(&mut out, view("grail"));
    dput(&mut out, view(".byte 12\n"));
    dstring(&mut out, entry);
    dstring(&mut out, view("."));
    mut first_start = 0;
    mut last_end = 0;
    mut first_unit = u8[];
    mut last_unit = u8[];
    if c.debug_funcs.len() != 0 {
        first_start = c.debug_funcs[0].start;
        first_unit = c.debug_funcs[0].unit.copy();
        last_end = c.debug_funcs[c.debug_funcs.len() - 1].end;
        last_unit = c.debug_funcs[c.debug_funcs.len() - 1].unit.copy();
    }
    if c.debug_funcs.len() == 0 {
        dput(&mut out, view(".quad 0\n.quad 0\n.long 0\n"));
    } else {
        dput(&mut out, view(".quad "));
        dlabel(&mut out, view(first_unit), first_start);
        dput(&mut out, view("\n.quad "));
        dlabel(&mut out, view(last_unit), last_end);
        dput(&mut out, view("-"));
        dlabel(&mut out, view(first_unit), first_start);
        dput(&mut out, view("\n.long 0\n"));
    }
    // One DIE per entry of c.debug_types, labelled .Ldebug_type_N; DW_AT_type is the CU-relative
    // offset (from the unit length field, four bytes before .Ldebug_cu_start).
    for i in c.debug_types.len() {
        t := &c.debug_types[i];
        dput(&mut out, view(".Ldebug_type_"));
        dnum(&mut out, i);
        dput(&mut out, view(":\n"));
        if t.kind == 0 {
            duleb(&mut out, 5);
            dstring(&mut out, view(t.name));
            dput(&mut out, view(".byte "));
            dnum(&mut out, t.enc);
            dput(&mut out, view("\n.byte "));
            dnum(&mut out, t.size);
            dput(&mut out, view("\n"));
        }
        if t.kind == 1 {
            duleb(&mut out, 6);
            dput(&mut out, view(".byte 8\n.long .Ldebug_type_"));
            dnum(&mut out, t.pointee);
            dput(&mut out, view("-.Ldebug_cu_start+4\n"));
        }
        if t.kind == 2 {
            duleb(&mut out, 7);
            dstring(&mut out, view(t.name));
            duleb(&mut out, t.size);
            for j in t.members.len() {
                m := &t.members[j];
                duleb(&mut out, 8);
                dstring(&mut out, view(m.name));
                dput(&mut out, view(".long .Ldebug_type_"));
                dnum(&mut out, m.ty);
                dput(&mut out, view("-.Ldebug_cu_start+4\n"));
                duleb(&mut out, m.offset);
            }
            dput(&mut out, view(".byte 0\n"));
        }
        if t.kind == 3 {
            duleb(&mut out, 9);
            dstring(&mut out, view(t.name));
            duleb(&mut out, t.size);
            for j in t.members.len() {
                m := &t.members[j];
                duleb(&mut out, 10);
                dstring(&mut out, view(m.name));
                duleb(&mut out, m.offset);
            }
            dput(&mut out, view(".byte 0\n"));
        }
        if t.kind == 4 {
            duleb(&mut out, 11);
            dstring(&mut out, view(t.name));
            dput(&mut out, view(".long .Ldebug_type_"));
            dnum(&mut out, t.pointee);
            dput(&mut out, view("-.Ldebug_cu_start+4\n"));
        }
    }

    for i in c.debug_funcs.len() {
        f := &c.debug_funcs[i];
        duleb(&mut out, 2);
        dstring(&mut out, view(f.name));
        mut link = u8[];
        dput(&mut link, view("f_"));
        for k in f.module.len() {
            link.push(f.module[k]);
        }
        link.push(95);
        for k in f.name.len() {
            link.push(f.name[k]);
        }
        dstring(&mut out, view(link));
        dput(&mut out, view(".quad "));
        dlabel(&mut out, view(f.unit), f.start);
        dput(&mut out, view("\n.quad "));
        dlabel(&mut out, view(f.unit), f.end);
        dput(&mut out, view("-"));
        dlabel(&mut out, view(f.unit), f.start);
        dput(&mut out, view("\n.byte "));
        dnum(&mut out, f.file);
        dput(&mut out, view("\n.uleb128 "));
        dnum(&mut out, f.line);
        // DW_AT_frame_base: the frame-pointer register (rbp = DWARF 6, x29 = 29, s0 = x8).
        dput(&mut out, view("\n.byte 1\n.byte "));
        if c.target == 1 {
            dnum(&mut out, 80 + 29);
        } else {
            if c.target == 2 {
                dnum(&mut out, 80 + 8);
            } else {
                dnum(&mut out, 80 + 6);
            }
        }
        dput(&mut out, view("\n"));
        for j in f.vars.len() {
            v := &f.vars[j];
            mut code = 4;
            if v.param != 0 {
                code = 3;
            }
            duleb(&mut out, code);
            dstring(&mut out, view(v.name));
            dlocation(&mut out, v.slot);
            dput(&mut out, view(".uleb128 "));
            dnum(&mut out, v.line);
            dput(&mut out, view("\n.long .Ldebug_type_"));
            dnum(&mut out, v.ty);
            dput(&mut out, view("-.Ldebug_cu_start+4\n"));
        }
        dput(&mut out, view(".byte 0\n"));
    }
    dput(&mut out, view(".byte 0\n.Ldebug_cu_end:\n"));
    return out;
}
// ---- runtime error locations -------------------------------------------------------------------
// Native Linux builds record where each statement is, so a failing check can say where it failed and
// where it was called from (runtime.grl rt_fail). The front end leaves `.gpos FILE LINE COL RAW`
// markers at statements and `.gkind K` before its own inline `call rt_abort`; the optimizer passes
// directives through untouched, and site_table turns them into labelled entries afterwards.
// Not with --split: its parts are slices of the image at offsets recorded before the markers would
// be removed. Not on macOS, which has no section to bracket. Windows puts the table in grouped PE
// sections (site_table) instead of the `grail_sites` section an ELF linker brackets for us.
fn site_table_on<a>(c: (&a C)) -> bool {
    return (c.plat == 0) && (c.backend == 0) && (c.debug == 0) && (c.split == 0) && (c.no_sites == 0);
}
// `.gbase LINE`: the line the `.gpos` markers after it count from. A function states its own first
// line before its body, so the body's markers say how far down the function a statement is and not
// how far down the file: a body's text is the same wherever in the file it stands.
fn site_base<a>(c: (&a mut C), line: u64) -> unit {
    exchange(&mut c.gbase, line);
    o(&mut c, view(".gbase "));
    on(&mut c, line);
    c.out.push(10);
    return ();
}
fn site_pos<a>(c: (&a mut C)) -> unit {
    p := c.pos;
    if c.toks.len() <= p {
        return ();
    }
    line := c.toks[p].line;
    col := c.toks[p].col;
    if line < c.gbase {
        // A statement from above the function being emitted (a body replayed from another place):
        // the base moves up to it, and the body's text now names a line of the file.
        fn_use(&mut c, FN_ABSOLUTE);
        site_base(&mut c, line);
    }
    // The last word says whether this is the unsafe runtime (runtime.grl, os-*.grl), whose sites a
    // failure report skips to find the program's own.
    o(&mut c, view(".gpos "));
    on(&mut c, c.file);
    c.out.push(32);
    on(&mut c, line - c.gbase);
    c.out.push(32);
    on(&mut c, col);
    c.out.push(32);
    raw := u64(c.raw != 0);
    on(&mut c, raw);
    c.out.push(10);
    return ();
}
// Before an inline `call rt_abort`: what the check was (runtime.grl rt_fail's kinds).
fn site_kind<a>(c: (&a mut C), kind: u64) -> unit {
    if site_table_on(&c) {
        o(&mut c, view(".gkind "));
        on(&mut c, kind);
        c.out.push(10);
    } else if (c.backend != 0) && (c.raw == 0) && (kind != 1) && (kind != 7) && (kind != 9) && (kind != 10) {
        // No site table will rewrite the abort (the LLVM backend): the kind goes to `rt_trap` here.
        // Only the kinds whose message needs no operands; an index or range check names its
        // operands, which only the site table's pattern finds.
        o(&mut c, view("movq $"));
        on(&mut c, kind);
        o(&mut c, view(",%rdx\n"));
        exchange(&mut c.trap_next, 1);
    }
    return ();
}
fn site_starts<a, b>(line: &a [u8], prefix: &b [u8]) -> bool {
    if line.len() < prefix.len() {
        return false;
    }
    for i in prefix.len() {
        if line[i] != prefix[i] {
            return false;
        }
    }
    return true;
}
fn site_contains<a, b>(line: &a [u8], part: &b [u8]) -> bool {
    mut i = 0;
    while i + part.len() <= line.len() {
        mut hit = true;
        for j in part.len() {
            if line[i + j] != part[j] {
                hit = false;
                break;
            }
        }
        if hit {
            return true;
        }
        i += 1;
    }
    return false;
}
fn site_words<a>(line: &a [u8]) -> u64[] {
    mut out = u64[];
    mut v = 0;
    mut digits = 0;
    for i in line.len() {
        ch := line[i];
        if (48 <= ch) & (ch <= 57) {
            v = v * 10 + u64(ch - 48);
            digits += 1;
        } else if digits != 0 {
            out.push(v);
            v = 0;
            digits = 0;
        }
    }
    if digits != 0 {
        out.push(v);
    }
    return out;
}
// A position's file name: a command-line input, or a generic body an interface carried (load_file).
fn site_path<a>(c: (&a C), index: u64) -> u8[] {
    return input_path(&c, index);
}
// Names a position's file relative to the working directory when it lies under it - `src/main.grl`,
// the form a reader wants, and the one that keeps a checkout's own location out of what the compiler
// emits (a seed built from absolute paths used to record them). Anything else keeps the form it was
// given. There is no cwd builtin, so the working directory is PWD, read once per table; an unset or
// unrelated PWD trims nothing.
fn site_relative<a, b>(path: &a [u8], cwd: &b [u8]) -> u8[] {
    if (cwd.len() == 0) || (path.len() <= cwd.len()) {
        return path.copy();
    }
    for i in cwd.len() {
        if path[i] != cwd[i] {
            return path.copy();
        }
    }
    mut start = cwd.len();
    if cwd[cwd.len() - 1] != 47 {
        if path[start] != 47 {
            return path.copy();
        }
        start += 1;
    }
    return (path[start: path.len()]).copy();
}
// Opens a range: the address an entry names, and the floor a frame's return address is looked up
// against.
// A label the emitted text minted, spelled the way `lname` spells it: the unit's namespace, then
// the unit's number. A debug table that spelled `.L<n>` named a label no unit emitted (B1 stage 5).
fn dlabel<a, b>(out: (&a mut u8[]), unit: &b [u8], n: u64) -> unit {
    push_bytes(&mut out, view(".L"));
    push_bytes(&mut out, view(unit));
    out.push(95);
    decimal(&mut out, n);
    return ();
}
fn site_label<a>(out: (&a mut u8[]), count: u64) -> unit {
    push_bytes(&mut out, view(".Lgs"));
    decimal(&mut out, count);
    push_bytes(&mut out, view(":\n"));
    return ();
}
// One entry: address, file name, line | col << 32. A file of zero names a range that says nothing
// (a function's prologue, the runtime's own code), which a failure report skips.
fn site_entry<a>(entries: (&a mut u8[]), count: u64, file: u64, flags: u64) -> unit {
    push_bytes(&mut entries, view(".quad .Lgs"));
    decimal(&mut entries, count);
    if file == 0 {
        push_bytes(&mut entries, view("\n.quad 0\n.quad 0\n"));
        return ();
    }
    push_bytes(&mut entries, view("\n.quad .Lgf"));
    decimal(&mut entries, file);
    push_bytes(&mut entries, view("\n.quad "));
    decimal(&mut entries, flags);
    entries.push(10);
    return ();
}
// A function's start address, which names the range a return address falls in.
fn site_func_label<a>(out: (&a mut u8[]), count: u64) -> unit {
    push_bytes(&mut out, view(".Lgn"));
    decimal(&mut out, count);
    push_bytes(&mut out, view(":\n"));
    return ();
}
// One function range: its start, and its name - zero for the runtime's own functions, whose frames
// a backtrace leaves out.
fn site_func_entry<a>(entries: (&a mut u8[]), count: u64, name: u64) -> unit {
    push_bytes(&mut entries, view(".quad .Lgn"));
    decimal(&mut entries, count);
    if name == 0 {
        push_bytes(&mut entries, view("\n.quad 0\n"));
        return ();
    }
    push_bytes(&mut entries, view("\n.quad .Lgh"));
    decimal(&mut entries, name);
    entries.push(10);
    return ();
}
// Turns the markers into the site table. Each statement gets a label, and the code from that label to
// the next names the statement: a frame whose return address is in it was called from there, which
// says where a check failed (the innermost such frame) and where it was called from (each frame
// above). The runtime's own statements are entered as ranges with no file - a failure report never
// names the runtime - and so is a function's prologue, which has no statement yet. An inline
// `call rt_abort` becomes `call rt_trap` with its kind.
// Whether text[a..e] starts with `prefix` / contains `part` (site_table reads lines in place).
fn site_at<a, b>(text: &a [u8], a: u64, e: u64, prefix: &b [u8]) -> bool {
    if e - a < prefix.len() {
        return false;
    }
    for i in prefix.len() {
        if text[a + i] != prefix[i] {
            return false;
        }
    }
    return true;
}
fn site_in<a, b>(text: &a [u8], a: u64, e: u64, part: &b [u8]) -> bool {
    mut i = a;
    while i + part.len() <= e {
        if site_at(text, i, e, part) {
            return true;
        }
        i += 1;
    }
    return false;
}
fn site_table<a, b>(c: (&a mut C), text: &b [u8]) -> u8[] {
    mut out = u8[];
    mut entries = u8[];
    mut files_std = u64[];
    mut files = u64[];
    mut cur_file = 0;
    mut cur_line = 0;
    mut cur_col = 0;
    // The line `.gpos` counts from, as the last `.gbase` gave it. `.gposa` is a position that does
    // not count from it: the optimizer writes those in a body it copied out of another function.
    mut base_line = 0;
    mut cur_internal = false;
    mut own_internal = true;
    mut seen_own = false;
    mut pending = 0;
    // The two code lines before this one, as ranges of `text`.
    mut p1a = 0;
    mut p1e = 0;
    mut p2a = 0;
    mut p2e = 0;
    mut pending_site = false;
    mut count = 0;
    // The function table (grail_funcs): one (start, name) entry per function, name 0 for the
    // runtime's own. A frame's return address names the function it lies in, so a backtrace of a
    // returned error can say which function created it.
    mut funcs = u8[];
    mut names = u8[];
    mut name_count = 0;
    mut func_count = 0;
    mut pending_func = 0;
    mut pending_name = u8[];
    // Lines are read in place, and what passes through unchanged is copied in runs: `pend` is the
    // first byte not yet copied to `out`. A line that is dropped or replaced, or that gets a label in
    // front of it, flushes the run before it.
    mut pend = 0;
    mut a = 0;
    n := text.len();
    while a < n {
        mut e = a;
        while (e < n) && (text[e] != 10) {
            e += 1;
        }
        if e == n {
            // A last line with no newline is copied as it is.
            break;
        }
        next := e + 1;
        if (e - a > 6) && (text[a] == 46) && (text[a + 1] == 103) {
            if site_at(text, a, e, view(".gbase ")) {
                w := site_words(text[a..e]);
                if w.len() == 1 {
                    base_line = w[0];
                }
                out.append(text[pend..a]);
                pend = next;
                a = next;
                continue;
            }
            absolute := site_at(text, a, e, view(".gposa "));
            if absolute || site_at(text, a, e, view(".gpos ")) {
                // A new statement: a kind its predecessor stated for an abort that is not there any
                // more is not this statement's.
                pending = 0;
                w := site_words(text[a..e]);
                if w.len() == 4 {
                    internal := w[3] != 0;
                    if !seen_own {
                        seen_own = true;
                        own_internal = internal;
                    }
                    // An inlined runtime body keeps its function's own position.
                    if !internal || own_internal {
                        cur_file = w[0];
                        cur_line = w[1];
                        if !absolute {
                            cur_line = base_line + w[1];
                        }
                        cur_col = w[2];
                        cur_internal = internal;
                    }
                    // The pending function's first statement names its table entry: the runtime's own
                    // functions have none, so a backtrace never prints `rt_` frames.
                    if pending_func != 0 {
                        mut func_name = 0;
                        if !internal {
                            name_count += 1;
                            func_name = name_count;
                            push_bytes(&mut names, view(".Lgh"));
                            decimal(&mut names, name_count);
                            push_bytes(&mut names, view(":\n.asciz \""));
                            for k in pending_name.len() {
                                ch := pending_name[k];
                                if (ch == 34) || (ch == 92) {
                                    names.push(92);
                                }
                                names.push(ch);
                            }
                            push_bytes(&mut names, view("\"\n"));
                        }
                        site_func_entry(&mut funcs, pending_func, func_name);
                        pending_func = 0;
                    }
                    // Held until the statement's first instruction: two statements with no code
                    // between them would otherwise open the same address, and the later one owns it.
                    pending_site = true;
                }
                out.append(text[pend..a]);
                pend = next;
                a = next;
                continue;
            }
            if site_at(text, a, e, view(".gkind ")) {
                w := site_words(text[a..e]);
                if w.len() == 1 {
                    pending = w[0];
                }
                out.append(text[pend..a]);
                pend = next;
                a = next;
                continue;
            }
        }
        directive := (a < e) && (text[a] == 46);
        // A function starts: positions are its own again, and the code up to its first statement -
        // its prologue - names no place.
        if (e - a > 1) && (text[e - 1] == 58) && !directive {
            seen_own = false;
            own_internal = true;
            cur_file = 0;
            pending_site = false;
            // Not the data labels, whose range would swallow code, and not the PE entry, which is
            // emitted as `.globl grail_entry` then `grail_entry:` and would get the label between.
            if !site_at(text, a, e, view("rt_state:")) && !site_at(text, a, e, view("rt_tls_record:")) && !site_at(text, a, e, view("grail_entry:")) {
                out.append(text[pend..a]);
                pend = a;
                site_label(&mut out, count);
                site_entry(&mut entries, count, 0, 0);
                count += 1;
                // This function's table entry waits for its first statement: only a `.gpos` says
                // whether the function belongs to the unsafe runtime, whose frames a backtrace skips
                // exactly as a failure report skips their statements.
                if pending_func != 0 {
                    site_func_entry(&mut funcs, pending_func, 0);
                }
                func_count += 1;
                site_func_label(&mut out, func_count);
                pending_func = func_count;
                pending_name = span_copy(text[a..e], 0, e - a - 1);
            }
        }
        if pending_site && !directive {
            pending_site = false;
            out.append(text[pend..a]);
            pend = a;
            site_label(&mut out, count);
            if (cur_file != 0) && !cur_internal {
                mut known = false;
                mut std = 0;
                for f in files.len() {
                    if files[f] == cur_file {
                        known = true;
                        std = files_std[f];
                    }
                }
                if !known {
                    files.push(cur_file);
                    // Bit 62 marks a standard-library statement: a report that wants the program's
                    // own place (where a job was joined) looks past those frames.
                    std = in_std_dir(view(site_path(&c, cur_file)));
                    files_std.push(std);
                }
                site_entry(&mut entries, count, cur_file, cur_line | (cur_col << 32) | (std << 62));
            } else {
                site_entry(&mut entries, count, 0, 0);
            }
            count += 1;
        }
        // Only a check in program code is rewritten: the runtime's own aborts (rt_fail ends in one)
        // stay plain, or a failing check would report itself forever.
        if (e - a == 13) && seen_own && !own_internal && site_at(text, a, e, view("call rt_abort")) {
            // An inlined accessor's bounds check is recognised by its shape before any pending
            // kind: a `.gkind` whose own abort the optimiser removed (a divisor it proved non-zero)
            // must not name the next check in the statement.
            mut kind = pending;
            if site_at(text, p1a, p1e, view("jb ")) && site_in(text, p2a, p2e, view("cmpq 8(%rdi),%rsi")) {
                kind = 1;
            }
            out.append(text[pend..a]);
            pend = next;
            push_bytes(&mut out, view("movq $"));
            decimal(&mut out, kind);
            push_bytes(&mut out, view(",%rdx\ncall rt_trap\n"));
            pending = 0;
        }
        if (a < e) && !directive {
            p2a = p1a;
            p2e = p1e;
            p1a = a;
            p1e = e;
        }
        a = next;
    }
    out.append(text[pend..n]);
    // A last function whose body holds no statement (the entry shim, a body of only calls emitted
    // without positions) keeps its range and no name.
    if pending_func != 0 {
        site_func_entry(&mut funcs, pending_func, 0);
        pending_func = 0;
    }
    // rt_sites(out, capacity): the descriptor the runtime walks frames with - the two tables'
    // bounds and the caller's frame pointer - and the length of it this call was given room for.
    // runtime.grl rt_sites_fill is the only caller. The body is Grail's pseudo text: it is x86-64 as
    // it stands, and machine::lower turns it into AArch64 or RISC-V for those targets.
    pe := (c.target == 3) || (c.target == 4);
    push_bytes(&mut out, view("\n.text\n"));
    if !pe {
        // An ELF or Mach-O linker gives the section its start and stop symbols; the helper is weak
        // because every object of a separately compiled program carries one and the linker keeps one.
        push_bytes(&mut out, view(".weak __start_grail_sites\n.weak __stop_grail_sites\n.weak __start_grail_funcs\n.weak __stop_grail_funcs\n.weak rt_sites\n"));
    }
    // Word 0 __start_grail_sites, 8 __stop_grail_sites and 16 the caller's rbp are the statement
    // table and the frame every runtime since the table existed reads; 24 __start_grail_funcs and
    // 32 __stop_grail_funcs add the function table `host::backtrace` names frames with. The layout
    // is append-only, and the second argument says how many words the caller's buffer holds:
    //
    //   capacity 0        the caller predates the argument: the three words it has room for
    //   capacity 1..2     less than a descriptor needs: write nothing, so nothing is overrun
    //   capacity 3..4     the statement table and the frame
    //   capacity 5 or up  all five
    //
    // The count of words written is the return value, so the runtime reads only what was written.
    // A runtime older than this compiler - a checked-in seed's - calls with 0 and a 24-byte
    // scratch: answering five words there is the overrun that corrupted an allocator header
    // (docs/design/task-failure-containment.md), and answering three is what keeps it impossible.
    push_bytes(&mut out, view("rt_sites:\ncmpq $3,%rsi\njb .Lrt_sites_none\nleaq __start_grail_sites(%rip),%rax\nmovq %rax,(%rdi)\nleaq __stop_grail_sites(%rip),%rax\nmovq %rax,8(%rdi)\nmovq %rbp,16(%rdi)\ncmpq $5,%rsi\njb .Lrt_sites_three\nleaq __start_grail_funcs(%rip),%rax\nmovq %rax,24(%rdi)\nleaq __stop_grail_funcs(%rip),%rax\nmovq %rax,32(%rdi)\nmovq $5,%rax\nret\n.Lrt_sites_three:\nmovq $3,%rax\nret\n.Lrt_sites_none:\nxorq %rax,%rax\nret\n"));
    // Past the end of the text the table says nothing: a frame whose return address is out there (in
    // libc above the image, say) is not one of the program's own.
    site_label(&mut out, count);
    site_entry(&mut entries, count, 0, 0);
    count += 1;
    if pe {
        // A PE linker provides no `__start_`/`__stop_` symbols, so the table is bracketed by the
        // grouped sections lld-link sorts and merges: `$a` holds the symbol that opens the merged
        // section, `$b` the entries, `$z` the symbol that closes it, so `__start` is the first entry
        // and `__stop` the byte past the last however many objects contribute. The markers are local
        // labels - a Windows program is one object, and rt_sites sits beside them - and `dr` makes
        // the merged section read-only data.
        push_bytes(&mut out, view("\n.section grail_sites$a,\"dr\"\n__start_grail_sites:\n.section grail_sites$b,\"dr\"\n.p2align 3\n"));
        push_bytes(&mut out, view(entries));
        push_bytes(&mut out, view(".section grail_sites$z,\"dr\"\n__stop_grail_sites:\n.section .rdata,\"dr\"\n"));
    } else {
        push_bytes(&mut out, view("\n.section grail_sites,\"a\"\n.p2align 3\n"));
        push_bytes(&mut out, view(entries));
        push_bytes(&mut out, view(".section .rodata\n"));
    }
    if pe {
        push_bytes(&mut out, view("\n.section grail_funcs$a,\"dr\"\n__start_grail_funcs:\n.section grail_funcs$b,\"dr\"\n.p2align 3\n"));
        push_bytes(&mut out, view(funcs));
        push_bytes(&mut out, view(".section grail_funcs$z,\"dr\"\n__stop_grail_funcs:\n.section .rdata,\"dr\"\n"));
    } else {
        push_bytes(&mut out, view("\n.section grail_funcs,\"a\"\n.p2align 3\n"));
        push_bytes(&mut out, view(funcs));
        push_bytes(&mut out, view(".section .rodata\n"));
    }
    cwd := host::env(view("PWD"));
    for f in files.len() {
        push_bytes(&mut out, view(".Lgf"));
        decimal(&mut out, files[f]);
        push_bytes(&mut out, view(":\n.asciz \""));
        given := site_path(&c, files[f]);
        path := site_relative(view(given), view(cwd));
        for k in path.len() {
            ch := path[k];
            if (ch == 34) || (ch == 92) {
                out.push(92);
            }
            out.push(ch);
        }
        push_bytes(&mut out, view("\"\n"));
    }
    push_bytes(&mut out, view(names));
    push_bytes(&mut out, view(".text\n"));
    return out;
}
// Source line/column of the current token. The assembler turns .loc into .debug_line.
fn emit_loc<a>(c: (&a mut C)) -> unit {
    if c.debug == 0 {
        if site_table_on(&c) && (c.validating == 0) {
            site_pos(&mut c);
        }
        return ();
    }
    p := c.pos;
    if c.toks.len() <= p {
        return ();
    }
    line := c.toks[p].line;
    column := c.toks[p].col;
    file := c.file - 1;
    if c.target == 3 {
        if c.validating != 0 {
            return (); // no function id is open while validating
        }
        fid := c.debug_funcs.len();
        o(&mut c, view(".cv_loc "));
        on(&mut c, fid);
        c.out.push(32);
    } else {
        o(&mut c, view(".loc "));
    }
    on(&mut c, file);
    c.out.push(32);
    on(&mut c, line);
    c.out.push(32);
    on(&mut c, column);
    c.out.push(10);
    return ();
}
// 0 is ELF/Linux syscalls, 1 is Mach-O/macOS libSystem. CPU selection stays in `target`.
fn darwin<a>(c: (&a mut C)) -> u64 {
    return c.plat;
}
// Mach-O names every C symbol with a leading underscore; ELF does not.
fn sym<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    spelling := sym_name(&c, view(name));
    push_bytes(&mut c.out, view(spelling));
    return ();
}
// The symbol `sym` writes, as a value: the effect facts have to name the bytes the emitter wrote.
fn sym_name<a, b>(c: (&a C), name: &b [u8]) -> u8[] {
    mut out = u8[];
    if c.plat == 1 {
        out.push(95);
    }
    push_bytes(&mut out, view(name));
    return out;
}
fn rodata<a>(c: (&a mut C)) -> unit {
    if c.plat == 1 {
        o(&mut c, view(".pushsection __TEXT,__const\n"));
        return ();
    }
    o(&mut c, view(".pushsection .rodata\n"));
    return ();
}
// A weak definition. ELF spells it `.weak`; Mach-O has no `.weak` for a definition - Darwin's
// assembler rejects it as an unknown directive - and spells it `.weak_definition`.
fn weak_def<a>(c: (&a mut C)) -> unit {
    if c.plat == 1 {
        o(&mut c, view(".weak_definition "));
        return ();
    }
    o(&mut c, view(".weak "));
    return ();
}
fn copy_to<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    for i in s.len() {
        out.push(s[i]);
    }
    return ();
}
// Mach-O gives every C symbol a leading underscore. Direct calls and address materialisation
// emitted from compiler literals use the bare Grail name, so they are prefixed in one place;
// imported libSystem symbols already carry the underscore and are left alone.
fn darwin_line<a, b>(out: (&a mut u8[]), line: &b [u8]) -> unit {
    mut space = line.len();
    for i in line.len() {
        if line[i] == 32 {
            space = i;
            break;
        }
    }
    if space == line.len() {
        copy_to(&mut out, line);
        return ();
    }
    op := line[: space];
    rest := line[space + 1:];
    mut bare = 0;
    if rest.len() != 0 {
        if ((65 <= rest[0]) && (rest[0] <= 90)) || ((97 <= rest[0]) && (rest[0] <= 122)) {
            bare = 1;
        }
    }
    if (same(view(op), view("call")) || same(view(op), view("leaq"))) && bare != 0 {
        copy_to(&mut out, line[: space + 1]);
        out.push(95);
        copy_to(&mut out, rest);
        return ();
    }
    copy_to(&mut out, line);
    return ();
}
fn darwinify<a>(input: &a [u8]) -> u8[] {
    mut out = u8[];
    mut start = 0;
    for i in input.len() {
        if input[i] == 10 {
            darwin_line(&mut out, view(input[start: i]));
            out.push(10);
            start = i + 1;
        }
    }
    return out;
}
// The token text already holds the quotes; symbol names never need escapes.
fn symbol_literal<a>(c: (&a mut C)) -> u8[] {
    if kind(&mut c) != 3 {
        fail(&mut c, view("expected an imported symbol name string"));
    }
    t := tok_text(&mut c, c.pos);
    advance(&mut c);
    if t.len() < 3 {
        fail(&mut c, view("empty imported symbol name"));
    }
    return (t[1: t.len() - 1]).copy();
}

fn fresh<a>(c: (&a mut C)) -> u64 {
    id := c.next;
    exchange(&mut c.next, id + 1);
    return id;
}

fn val(t: u64, ty: u64) -> Val {
    return Val { t: t, ty: ty };
}

// Every intermediate and binding has an rbp-relative eight-byte stack slot.
fn stack_slot<a>(c: (&a mut C), id: u64) -> unit {
    if c.quiet != 0 {
        return ();
    }
    c.out.push(45);
    on(&mut c, (id + 1) * 8);
    o(&mut c, view("(%rbp)"));
    return ();
}
// ---- host TLS bridge (Linux ELF: x86-64, AArch64, RISC-V 64) ----
// The runtime installs each OS thread's worker record as the hardware thread pointer (x86-64 FS
// base through arch_prctl, AArch64 tpidr_el0, RISC-V tp), which is also where a dynamically linked
// process keeps glibc's TCB (errno, malloc tcache, stack guard, DTV). Every thread therefore carries
// its own pair: the record (thread-pointer word 0 points to itself, as the x86-64 TLS ABI also
// requires of a TCB) and record word 56, the thread's libc TCB, or 0 when there is none (a static
// program, which never loaded libc). A foreign call runs on the calling thread's TCB and restores
// the record; a callback finds its thread's record through `rt_tls_record`, an initial-exec ELF TLS
// word that glibc allocates in every thread it creates, and runs on it.
//
// Runtime threads of a process that loaded libc are created by glibc (`pthread_create` through the
// rt_host_thread stub below), so each has a real TCB that glibc built, links and tears down itself;
// docs/design/decisions-b2-b6.md (B3) records why the runtime does not fabricate one.
fn tls_bridge<a>(c: (&a mut C)) -> bool {
    return (c.plat == 0) && ((c.target == 0) || (c.target == 1) || (c.target == 2));
}
// %rax = the current thread pointer: a Grail record or a libc TCB, both self-pointing on x86-64.
fn tp_read<a>(c: (&a mut C)) -> unit {
    if c.target == 0 {
        o(&mut c, view("movq %fs:0,%rax\n"));
    } else {
        o(&mut c, view("tpget\n"));
    }
    return ();
}
// Thread pointer := %rsi (clobbers %rax, %rdi; %rcx and %r11 too on x86-64).
fn tp_write<a>(c: (&a mut C)) -> unit {
    if c.target == 0 {
        o(&mut c, view("movl $4098,%edi\nmovl $158,%eax\nsyscall\n"));
    } else {
        o(&mut c, view("movq %rsi,%rdi\ntpset\n"));
    }
    return ();
}
// %rax = this thread's `rt_tls_record` word. Valid only while the thread pointer is a libc TCB.
fn tls_record_address<a>(c: (&a mut C)) -> unit {
    if c.target == 0 {
        o(&mut c, view("movq %fs:0,%rax\nleaq rt_tls_record@tpoff(%rax),%rax\n"));
    } else {
        o(&mut c, view("tlsaddr\n"));
    }
    return ();
}
// The run's code goes into an object of its own, either as one `--split` part or as the one file
// `--separate` writes: a definition another object calls has to be visible to the linker, so every
// function (and the process state) becomes global. The whole-program build keeps its local symbols.
fn own_object<a>(c: (&a C)) -> bool {
    return (c.split != 0) || (c.separate != 0);
}
fn tls_bss<a>(c: (&a mut C)) -> unit {
    if own_object(&c) {
        o(&mut c, view(".globl rt_state\n"));
        if tls_bridge(&mut c) {
            o(&mut c, view(".globl rt_tls_record\n"));
        }
    }
    if (own_object(&c) == false) & (c.backend != 0) & tls_bridge(&mut c) {
        // The LLVM half reads the TLS word by name in inline assembly (llvm.grl, the
        // thread-pointer read), from another object: it must be visible to the link.
        o(&mut c, view(".globl rt_tls_record\n.hidden rt_tls_record\n"));
    }
    o(&mut c, view("ud2\n"));
    if tls_bridge(&mut c) {
        tls_thread_stubs(&mut c);
    }
    o(&mut c, view(".bss\n.p2align 4\nrt_state: .zero 4096\n"));
    if tls_bridge(&mut c) {
        o(&mut c, view(".section .tbss,\"awT\",@nobits\n.p2align 3\nrt_tls_record: .zero 8\n"));
    }
    o(&mut c, view(".section .note.GNU-stack,\"\",@progbits\n"));
    return ();
}
// Thread creation through glibc. rt_host_thread(block, tid_word) is reached from the runtime's
// rt_thread_start (Grail calling convention; the address is the process-state word at 3216, which
// _start fills only when the process loaded libc and `pthread_create` is linked). `block` is
// {entry function, record} (rt_thread_main and the new thread's record); the joinable TID word goes
// into the word below it, is set to 1 here and cleared and futex-woken once the thread's Grail work
// has finished and it is back on its own TCB. pthread_create and pthread_detach run on the calling
// thread's TCB, like any foreign call.
//
// rt_host_thread_start is the start routine glibc calls on the new thread: it publishes the
// thread's TCB in record word 56 and the record in `rt_tls_record`, runs rt_thread_main, and
// returns to glibc on glibc's TCB so its own thread exit runs normally.
fn tls_thread_stubs<a>(c: (&a mut C)) -> unit {
    o(&mut c, view(".weak pthread_create\n.weak pthread_detach\n"));
    o(&mut c, view(".globl rt_host_thread\nrt_host_thread:\npushq %rbp\nmovq %rsp,%rbp\nsubq $48,%rsp\n"));
    o(&mut c, view("movq %rdi,-8(%rbp)\nmovq %rsi,-16(%rbp)\nmovq %rsi,-8(%rdi)\nmovl $1,%eax\nmovq %rax,(%rsi)\n"));
    // AArch64 and RV64 run Grail on the record and switch to the TCB around pthread_create; x86-64
    // already runs on the TCB (raw_tp_get), so it switches nothing.
    if c.target != 0 {
        tp_read(&mut c);
        o(&mut c, view("movq %rax,-24(%rbp)\nmovq 56(%rax),%rsi\n"));
        tp_write(&mut c);
    }
    o(&mut c, view("leaq -32(%rbp),%rdi\nxorl %esi,%esi\nleaq rt_host_thread_start(%rip),%rdx\nmovq -8(%rbp),%rcx\ncall pthread_create\nmovq %rax,-40(%rbp)\ntestq %rax,%rax\n"));
    failed := label(&mut c);
    jump(&mut c, view("jne"), failed);
    o(&mut c, view("movq -32(%rbp),%rdi\ncall pthread_detach\n"));
    mark(&mut c, failed);
    if c.target != 0 {
        o(&mut c, view("movq -24(%rbp),%rsi\n"));
        tp_write(&mut c);
    }
    o(&mut c, view("movq -40(%rbp),%rcx\nxorl %eax,%eax\nsubq %rcx,%rax\nleave\nret\n"));
    o(&mut c, view("rt_host_thread_start:\npushq %rbp\nmovq %rsp,%rbp\nsubq $16,%rsp\nmovq %rdi,-8(%rbp)\n"));
    tp_read(&mut c);
    o(&mut c, view("movq -8(%rbp),%rcx\nmovq 8(%rcx),%rcx\nmovq %rax,56(%rcx)\n"));
    tls_record_address(&mut c);
    o(&mut c, view("movq -8(%rbp),%rcx\nmovq 8(%rcx),%rcx\nmovq %rcx,(%rax)\nmovq %rcx,%rdi\ncall rt_thread_main\n"));
    if c.target != 0 {
        o(&mut c, view("movq -8(%rbp),%rcx\nmovq 8(%rcx),%rcx\nmovq 56(%rcx),%rsi\n"));
        tp_write(&mut c);
    }
    // Load the TID word's address before releasing it: once it reads 0 the joiner may unmap the
    // block and the record.
    o(&mut c, view("movq -8(%rbp),%rcx\nmovq -8(%rcx),%rdi\nmovq %rdi,-16(%rbp)\nxorl %eax,%eax\natom.store release u64\n"));
    if c.target == 0 {
        o(&mut c, view("movl $202,%eax\n"));
    } else {
        o(&mut c, view("movl $98,%eax\n"));
    }
    o(&mut c, view("movq -16(%rbp),%rdi\nmovl $1,%esi\nmovl $1,%edx\nsyscall\nxorl %eax,%eax\nleave\nret\n"));
    return ();
}
// In _start, before rt_thread_init installs the main record: record the loader's TLS base (0 in a
// static program) as the main record's word 56, and when there is one, publish the main record in
// this thread's `rt_tls_record` and arm the glibc thread path if `pthread_create` is linked.
fn tls_capture<a>(c: (&a mut C)) -> unit {
    if c.target == 0 {
        o(&mut c, view("movl $4099,%edi\nleaq rt_state+184(%rip),%rsi\nmovl $158,%eax\nsyscall\n"));
    } else {
        o(&mut c, view("tpget\nmovq %rax,rt_state+184(%rip)\n"));
    }
    done := label(&mut c);
    o(&mut c, view("movq rt_state+184(%rip),%rax\ntestq %rax,%rax\n"));
    jump(&mut c, view("je"), done);
    tls_record_address(&mut c);
    o(&mut c, view("leaq rt_state+128(%rip),%rcx\nmovq %rcx,(%rax)\nleaq pthread_create(%rip),%rax\ntestq %rax,%rax\n"));
    jump(&mut c, view("je"), done);
    o(&mut c, view("leaq rt_host_thread(%rip),%rax\nmovq %rax,rt_state+3216(%rip)\n"));
    mark(&mut c, done);
    return ();
}
// Foreign call entry: when this thread has a libc TCB, `slot` keeps the record and the thread
// pointer becomes the TCB; otherwise `slot` is 0 and nothing changes.
fn tls_enter_foreign<a>(c: (&a mut C), slot: u64) -> unit {
    if c.target == 0 {
        // x86-64: the thread pointer already is libc's TCB when there is one (raw_tp_get), so a
        // foreign call switches nothing and costs nothing beyond the call.
        return ();
    }
    o(&mut c, view("xorl %eax,%eax\nmovq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    tp_read(&mut c);
    o(&mut c, view("movq 56(%rax),%rsi\ntestq %rsi,%rsi\n"));
    done := label(&mut c);
    jump(&mut c, view("je"), done);
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    tp_write(&mut c);
    mark(&mut c, done);
    return ();
}
// Callback entry: in a process that loaded libc, the caller runs on a libc TCB whose
// `rt_tls_record` names this thread's record; `slot` keeps the caller's thread pointer. A thread
// with no record was created by C: the outermost callback on it adopts one (rt_adopt_record maps a
// record for this thread and the entry publishes it in `rt_tls_record`), keeps it in `adopt`, and
// the matching tls_leave_callback unpublishes and unmaps it, so the thread is again unknown to the
// runtime once C regains control. Nested callbacks on that thread find the published record and
// adopt nothing. In a static program the thread pointer already is the record and `slot` is 0.
fn tls_enter_callback<a>(c: (&a mut C), slot: u64, adopt: u64) -> unit {
    o(&mut c, view("xorl %eax,%eax\nmovq %rax,"));
    stack_slot(&mut c, slot);
    o(&mut c, view("\nmovq %rax,"));
    stack_slot(&mut c, adopt);
    c.out.push(10);
    done := label(&mut c);
    have := label(&mut c);
    o(&mut c, view("leaq rt_state(%rip),%rax\nmovq 184(%rax),%rax\ntestq %rax,%rax\n"));
    jump(&mut c, view("je"), done);
    tls_record_address(&mut c);
    o(&mut c, view("movq (%rax),%rsi\ntestq %rsi,%rsi\n"));
    jump(&mut c, view("jne"), have);
    call_out(&mut c, view("rt_adopt_record"));
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, adopt);
    c.out.push(10);
    tls_record_address(&mut c);
    o(&mut c, view("movq "));
    stack_slot(&mut c, adopt);
    o(&mut c, view(",%rsi\nmovq %rsi,(%rax)\n"));
    mark(&mut c, have);
    if c.target != 0 {
        // x86-64 keeps libc's TCB as the thread pointer; the record is reached through
        // `rt_tls_record`, which the lines above made sure names one.
        tp_read(&mut c);
        o(&mut c, view("movq %rax,"));
        stack_slot(&mut c, slot);
        c.out.push(10);
        tp_write(&mut c);
    }
    mark(&mut c, done);
    callback_pin(&mut c, view("addq"));
    return ();
}
// The foreign-call marker (rt_sysmon): %r11 = this thread's record, then the block's counter word.
fn ffi_marker_enter<a>(c: (&a mut C), slot: u64) -> unit {
    other := label(&mut c);
    have := label(&mut c);
    none := label(&mut c);
    done := label(&mut c);
    o(&mut c, view("cmpq $0,rt_state+184(%rip)\n"));
    jump(&mut c, view("je"), other);
    o(&mut c, view("movq %fs:rt_tls_record@tpoff,%r11\n"));
    jump(&mut c, view("jmp"), have);
    mark(&mut c, other);
    o(&mut c, view("movq %fs:0,%r11\n"));
    mark(&mut c, have);
    o(&mut c, view("cmpq $2,24(%r11)\n"));
    jump(&mut c, view("jne"), none);
    o(&mut c, view("movq 32(%r11),%r11\nmovq 320(%r11),%r11\nincq (%r11)\n"));
    jump(&mut c, view("jmp"), done);
    mark(&mut c, none);
    o(&mut c, view("xorl %r11d,%r11d\n"));
    mark(&mut c, done);
    o(&mut c, view("movq %r11,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    return ();
}
// The call's end: count out (a locked increment, because the monitor may have marked the word with
// its top bit at the same moment); a set top bit says the worker was given away during the call, and
// rt_foreign_lost makes this thread block-less and names the symbol once.
fn ffi_marker_leave<a, b>(c: (&a mut C), slot: u64, symbol: &b [u8]) -> unit {
    done := label(&mut c);
    o(&mut c, view("movq "));
    stack_slot(&mut c, slot);
    o(&mut c, view(",%r11\ntestq %r11,%r11\n"));
    jump(&mut c, view("je"), done);
    o(&mut c, view("lock incq (%r11)\n"));
    jump(&mut c, view("jns"), done);
    o(&mut c, view("subq $32,%rsp\nmovq %rax,(%rsp)\nmovq %rdx,8(%rsp)\nmovq %xmm0,%r10\nmovq %r10,16(%rsp)\nmovq %xmm1,%r10\nmovq %r10,24(%rsp)\n"));
    // The symbol's name, NUL-ended, as read-only data (as a `cstr` literal is emitted).
    name := label(&mut c);
    o(&mut c, view(".pushsection .rodata\n"));
    mark(&mut c, name);
    for i in symbol.len() {
        o(&mut c, view(".byte "));
        on(&mut c, symbol[i]);
        c.out.push(10);
    }
    o(&mut c, view(".byte 0\n.popsection\nleaq "));
    lname(&mut c, name);
    o(&mut c, view("(%rip),%rdi\n"));
    call_out(&mut c, view("rt_foreign_lost"));
    o(&mut c, view("movq 16(%rsp),%r10\nmovq %r10,%xmm0\nmovq 24(%rsp),%r10\nmovq %r10,%xmm1\nmovq (%rsp),%rax\nmovq 8(%rsp),%rdx\naddq $32,%rsp\n"));
    mark(&mut c, done);
    return ();
}
// While a callback runs there are C frames under it on this stack, so the task (if this thread is
// running one) must not resume on another thread: thread-record word 120 counts the callbacks this
// thread is inside, and rt_suspend blocks the thread instead of switching the task away while it
// is non-zero. Clobbers %rax only.
fn callback_pin<a, b>(c: (&a mut C), op: &b [u8]) -> unit {
    if c.target == 0 {
        other := label(&mut c);
        done := label(&mut c);
        o(&mut c, view("cmpq $0,rt_state+184(%rip)\n"));
        jump(&mut c, view("je"), other);
        o(&mut c, view("movq %fs:rt_tls_record@tpoff,%rax\n"));
        jump(&mut c, view("jmp"), done);
        mark(&mut c, other);
        o(&mut c, view("movq %fs:0,%rax\n"));
        mark(&mut c, done);
    } else {
        o(&mut c, view("tpget\n"));
    }
    o(&mut c, view(op));
    o(&mut c, view(" $1,120(%rax)\n"));
    return ();
}
// Leave a callback: restore the caller's thread pointer, then, if this entry adopted the thread,
// clear `rt_tls_record` (now on the caller's TCB, so the TLS word is addressable) and unmap the
// record. Runs before the return value is loaded, so it may clobber any register.
fn tls_leave_callback<a>(c: (&a mut C), slot: u64, adopt: u64) -> unit {
    callback_pin(&mut c, view("subq"));
    tls_leave(&mut c, slot);
    done := label(&mut c);
    o(&mut c, view("movq "));
    stack_slot(&mut c, adopt);
    o(&mut c, view(",%rdi\ntestq %rdi,%rdi\n"));
    jump(&mut c, view("je"), done);
    tls_record_address(&mut c);
    o(&mut c, view("xorl %ecx,%ecx\nmovq %rcx,(%rax)\nmovq "));
    stack_slot(&mut c, adopt);
    o(&mut c, view(",%rdi\n"));
    call_out(&mut c, view("rt_release_record"));
    mark(&mut c, done);
    return ();
}
// Before a callback's frame is torn down: copy each `p: &mut R` parameter's Grail copy back into
// the struct C passed (see the prologue). Runs before cleanup frees the copies; the copy slot is
// read at exit, so a record swapped in through `p` is the one written back.
fn callback_copy_back<a>(c: (&a mut C)) -> unit {
    n := c.export_copyback.len() / 3;
    for k in n {
        keep := c.export_copyback[3 * k];
        copy := c.export_copyback[3 * k + 1];
        bytes := imm(&mut c, c.export_copyback[3 * k + 2]);
        invoke(&mut c, view("rt_copy_bytes"), three(keep, copy, bytes));
    }
    return ();
}
// Undo either entry: restore the thread pointer `slot` saved, if it saved one.
fn tls_leave<a>(c: (&a mut C), slot: u64) -> unit {
    if c.target == 0 {
        return (); // x86-64 never switched (tls_enter_foreign, tls_enter_callback)
    }
    o(&mut c, view("movq "));
    stack_slot(&mut c, slot);
    o(&mut c, view(",%rsi\ntestq %rsi,%rsi\n"));
    done := label(&mut c);
    jump(&mut c, view("je"), done);
    tp_write(&mut c);
    mark(&mut c, done);
    return ();
}
fn save<a>(c: (&a mut C)) -> u64 {
    n := fresh(&mut c);
    if c.quiet != 0 {
        return n;
    }
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, n);
    c.out.push(10);
    return n;
}
// A `&dyn I` result's pair lives in the caller's frame, so it has a frame source: the region the
// reference type names. Call it once the slot is owned.
fn shape_pair_result<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if borrowed_object(&mut c, ty) == 0 {
        return ();
    }
    mut region = 0;
    rs := type_regions(&mut c, ty);
    if rs.len() != 0 {
        region = rs[0];
    }
    target := external_place(&mut c, region, 0);
    set_target(&mut c, slot, target, slot + 1);
    return ();
}
// A `&dyn I` comes back from a call as the pair's two words (%rax data, %rdx vtable), so the caller
// builds the pair in its own frame and holds the handle: a handle into the callee's frame would not
// outlive the return.
fn save_result<a>(c: (&a mut C), ret: u64) -> u64 {
    if (c.raw == 0) && is_simd(&mut c, ret) && (record_words(&mut c, base_type(&mut c, ret)) == 2) {
        // The two result words back into a vector through `simd.frompair` (see frame_result).
        lo := save(&mut c);
        o(&mut c, view("movq %rdx,%rax\n"));
        hi := save(&mut c);
        dst := frame_alloc(&mut c, 2);
        zero := imm(&mut c, 0);
        get(&mut c, zero, view("%rsi"));
        get(&mut c, zero, view("%rcx"));
        get(&mut c, dst, view("%rdi"));
        get(&mut c, hi, view("%rdx"));
        get(&mut c, lo, view("%rax"));
        mut line = copy_bytes(view("simd.frompair "));
        push_bytes(&mut line, view(simd_shape(&mut c, base_type(&mut c, ret))));
        line.push(10);
        o(&mut c, view(line));
        return dst;
    }
    if framed(&mut c, ret) {
        words := record_words(&mut c, base_type(&mut c, ret));
        if words <= 2 {
            // Word 0 in rax, word 1 in rdx (docs/design/unboxed-values.md, 3c): stored straight
            // into frame words of this call site.
            return frame_from_registers(&mut c, words);
        }
        // A larger result was written to the destination the call passed (call_dest): rax is it.
        slot := save(&mut c);
        if is_array(&mut c, ret) {
            // Nothing else holds the destination: a binding takes it as its own (bind_value).
            c.array_fresh.push(slot);
        }
        return slot;
    }
    if borrowed_object(&mut c, ret) == 0 {
        return save(&mut c);
    }
    // %rax is the data and %rdx the vtable of the returned pair.
    pair := dyn_pair_of_words(&mut c, view("%rax"), view("%rdx"));
    dyn_pair_handle(&mut c, pair);
    return save(&mut c);
}
fn get<a, b>(c: (&a mut C), id: u64, reg: &b [u8]) -> unit {
    if c.quiet != 0 {
        return ();
    }
    o(&mut c, view("movq "));
    stack_slot(&mut c, id);
    c.out.push(44);
    o(&mut c, reg);
    c.out.push(10);
    return ();
}
fn label<a>(c: (&a mut C)) -> u64 {
    n := c.label;
    exchange(&mut c.label, n + 1);
    k := c.lunit;
    // Inside a function the numbers are the function's; the unit's counter does not move.
    if (c.fscope == 0) & (k != 0) & (k <= c.lnext.len()) {
        c.lnext[k - 1] = n + 1;
    }
    return n;
}
// The next `.Lrfp`/`.Lrfr` number: the function's inside one, the unit's outside.
fn ref_number<a>(c: (&a mut C)) -> u64 {
    n := c.ref_next;
    exchange(&mut c.ref_next, n + 1);
    k := c.lunit;
    if (c.fscope == 0) & (k != 0) & (k <= c.rnext.len()) {
        c.rnext[k - 1] = n + 1;
    }
    return n;
}
// The ordinal the next function of the current unit takes.
fn scope_next<a>(c: (&a C)) -> u64 {
    k := c.lunit;
    if (k != 0) & (k <= c.fnext.len()) {
        return c.fnext[k - 1] + 1;
    }
    return 1;
}
// A function begins in the current unit: it takes the unit's next ordinal and numbers its labels
// and refinement strings from the start. A validating replay writes text that is thrown away, so it
// borrows the ordinal without spending it.
fn scope_begin<a>(c: (&a mut C)) -> unit {
    f := scope_next(&c);
    k := c.lunit;
    if (c.validating == 0) & (k != 0) & (k <= c.fnext.len()) {
        c.fnext[k - 1] = f;
    }
    exchange(&mut c.fscope, f);
    exchange(&mut c.label, 1);
    exchange(&mut c.ref_next, 0);
    return ();
}
// The function ends: the unit's own counters are current again.
fn scope_end<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.fscope, 0);
    k := c.lunit;
    if (k != 0) & (k <= c.lnext.len()) {
        exchange(&mut c.label, c.lnext[k - 1]);
        exchange(&mut c.ref_next, c.rnext[k - 1]);
    }
    return ();
}
// A discarded attempt gives its ordinal back, so the retry takes the same one.
fn scope_undo<a>(c: (&a mut C)) -> unit {
    k := c.lunit;
    if (c.fscope != 0) & (c.validating == 0) & (k != 0) & (k <= c.fnext.len()) {
        c.fnext[k - 1] = c.fnext[k - 1] - 1;
    }
    scope_end(&mut c);
    return ();
}
// `<unit prefix>_<n>` outside a function, `<unit prefix>_<f>_<n>` inside one: what follows `.L`,
// `.F`, `.Lrfp` and `.Lrfr`. Copies, because `o` borrows `c` mutably and the prefix is a field of it.
fn scoped_number<a>(c: (&a mut C), n: u64) -> unit {
    if c.quiet != 0 {
        return ();
    }
    prefix := c.lpart.copy();
    o(&mut c, view(prefix));
    c.out.push(95);
    if c.fscope != 0 {
        on(&mut c, c.fscope);
        c.out.push(95);
    }
    on(&mut c, n);
    return ();
}
fn lname<a>(c: (&a mut C), n: u64) -> unit {
    o(&mut c, view(".L"));
    scoped_number(&mut c, n);
    return ();
}
// The frame constant of a function: `.F<unit prefix>_<n>`, `.set` at its end. It is named in the
// unit's namespace like every other label because two units' counters can both reach `n` - and a
// shared `.F` name would let one function's frame size decide another function's displacements,
// since `.set` is one symbol per file (B1 stage 5).
fn fname<a>(c: (&a mut C), n: u64) -> unit {
    o(&mut c, view(".F"));
    scoped_number(&mut c, n);
    return ();
}
fn mark<a>(c: (&a mut C), n: u64) -> unit {
    lname(&mut c, n);
    o(&mut c, view(":\n"));
    return ();
}
fn jump<a, b>(c: (&a mut C), op: &b [u8], n: u64) -> unit {
    o(&mut c, op);
    c.out.push(32);
    lname(&mut c, n);
    c.out.push(10);
    return ();
}

// Win32 imports the compiler may name. The value is the fixed argument count; the runtime layer
// passes exactly that many words. Unknown names are rejected at compile time.
// The DLL that exports a Win32 entry point. The compiler names an import by symbol, but a PE image
// binds every symbol through an import descriptor of a named DLL, so the link request has to carry
// the pair - the same grouping tools/windows.mjs keeps for its cross-check.
fn win32_dll<a>(name: &a [u8]) -> u8[] {
    if same(view(name), view("WaitOnAddress")) || same(view(name), view("WakeByAddressSingle")) || same(view(name), view("WakeByAddressAll")) {
        return copy_bytes(view("kernelbase"));
    }
    if same(view(name), view("CoInitializeEx")) || same(view(name), view("CoUninitialize")) {
        return copy_bytes(view("combase"));
    }
    if win32_is_winsock(view(name)) {
        return copy_bytes(view("ws2_32"));
    }
    return copy_bytes(view("kernel32"));
}
// `// grail-link: import DLL SYMBOL` for one Win32 entry point the image calls, so a driver can build
// the import objects without a table of its own.
fn win32_link<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    dll := win32_dll(view(name));
    mut note = u8[];
    push_bytes(&mut note, view("import "));
    push_bytes(&mut note, view(dll));
    note.push(32);
    push_bytes(&mut note, view(name));
    ffi_link(&mut c, view(note));
    return ();
}
// The Winsock entry points the Windows platform layer calls. Grouped by library, because
// `raw_win32` writes one import note per call and the DLL name has to come from somewhere.
fn win32_is_winsock<a>(name: (&a [u8])) -> bool {
    if same(view(name), view("WSAStartup")) || same(view(name), view("WSACleanup")) {
        return true;
    }
    if same(view(name), view("WSAGetLastError")) || same(view(name), view("WSASocketW")) {
        return true;
    }
    if same(view(name), view("WSARecv")) || same(view(name), view("WSASend")) {
        return true;
    }
    if same(view(name), view("WSAGetOverlappedResult")) || same(view(name), view("WSAIoctl")) {
        return true;
    }
    if same(view(name), view("bind")) || same(view(name), view("listen")) {
        return true;
    }
    if same(view(name), view("connect")) || same(view(name), view("accept")) {
        return true;
    }
    if same(view(name), view("getsockname")) || same(view(name), view("setsockopt")) {
        return true;
    }
    return same(view(name), view("closesocket"));
}
fn win32_arity<a>(name: (&a [u8])) -> u64 {
    if same(view(name), view("ExitProcess")) {
        return 1;
    }
    if same(view(name), view("GetStdHandle")) {
        return 1;
    }
    if same(view(name), view("GetModuleFileNameW")) {
        return 3;
    }
    if same(view(name), view("GetCurrentDirectoryW")) {
        return 2;
    }
    if same(view(name), view("SetConsoleOutputCP")) || same(view(name), view("SetConsoleCP")) {
        return 1;
    }
    if same(view(name), view("GetCommandLineW")) {
        return 0;
    }
    if same(view(name), view("GetEnvironmentStringsW")) {
        return 0;
    }
    if same(view(name), view("FreeEnvironmentStringsW")) {
        return 1;
    }
    if same(view(name), view("GetCurrentProcessId")) {
        return 0;
    }
    if same(view(name), view("GetLastError")) {
        return 0;
    }
    if same(view(name), view("GetFileAttributesW")) {
        return 1;
    }
    if same(view(name), view("GetFileAttributesExW")) {
        return 3;
    }
    if same(view(name), view("MoveFileExW")) {
        return 3;
    }
    if same(view(name), view("CreatePipe")) {
        return 4;
    }
    if same(view(name), view("CreateSymbolicLinkW")) {
        return 3;
    }
    if same(view(name), view("GetExitCodeProcess")) {
        return 2;
    }
    if same(view(name), view("GetTickCount64")) {
        return 0;
    }
    if same(view(name), view("WriteFile")) {
        return 5;
    }
    if same(view(name), view("ReadFile")) {
        return 5;
    }
    if same(view(name), view("CreateFileW")) {
        return 7;
    }
    if same(view(name), view("CreateProcessW")) {
        return 10;
    }
    if same(view(name), view("CloseHandle")) {
        return 1;
    }
    if same(view(name), view("VirtualAlloc")) {
        return 4;
    }
    if same(view(name), view("CreateThread")) {
        return 6;
    }
    if same(view(name), view("WaitForSingleObject")) {
        return 2;
    }
    if same(view(name), view("WaitOnAddress")) {
        return 4;
    }
    if same(view(name), view("WakeByAddressSingle")) {
        return 1;
    }
    if same(view(name), view("WakeByAddressAll")) {
        return 1;
    }
    if same(view(name), view("CoInitializeEx")) {
        return 2;
    }
    if same(view(name), view("CoUninitialize")) {
        return 0;
    }
    if same(view(name), view("VirtualFree")) {
        return 3;
    }
    if same(view(name), view("Sleep")) {
        return 1;
    }
    if same(view(name), view("SwitchToThread")) {
        return 0;
    }
    if same(view(name), view("DeleteFileW")) {
        return 1;
    }
    if same(view(name), view("RemoveDirectoryW")) {
        return 1;
    }
    if same(view(name), view("CreateDirectoryW")) {
        return 2;
    }
    if same(view(name), view("FindFirstFileW")) {
        return 2;
    }
    if same(view(name), view("FindNextFileW")) {
        return 2;
    }
    if same(view(name), view("FindClose")) {
        return 1;
    }
    if same(view(name), view("TerminateProcess")) {
        return 2;
    }
    if same(view(name), view("CreateEventW")) {
        return 4;
    }
    if same(view(name), view("CancelIoEx")) {
        return 2;
    }
    if same(view(name), view("WSAStartup")) {
        return 2;
    }
    if same(view(name), view("WSACleanup")) {
        return 0;
    }
    if same(view(name), view("WSAGetLastError")) {
        return 0;
    }
    if same(view(name), view("WSASocketW")) {
        return 6;
    }
    if same(view(name), view("WSARecv")) {
        return 7;
    }
    if same(view(name), view("WSASend")) {
        return 7;
    }
    if same(view(name), view("WSAGetOverlappedResult")) {
        return 5;
    }
    if same(view(name), view("WSAIoctl")) {
        return 9;
    }
    if same(view(name), view("bind")) {
        return 3;
    }
    if same(view(name), view("listen")) {
        return 2;
    }
    if same(view(name), view("connect")) {
        return 3;
    }
    if same(view(name), view("accept")) {
        return 3;
    }
    if same(view(name), view("getsockname")) {
        return 3;
    }
    if same(view(name), view("setsockopt")) {
        return 5;
    }
    if same(view(name), view("closesocket")) {
        return 1;
    }
