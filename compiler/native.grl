// Checked emission for parsed calls and compiler-prepared collection operations.
fn emit_resolved_call<a>(
    c: (&a mut C),
    index: u64,
    map: u64[],
    args: u64[],
    argtypes: u64[],
    sources: u64[]
) -> Val {
    mut f = index;
    info := &c.funcs[f - 1];
    template_ret := info.ret;
    count := info.count;
    template_first := info.first;
    types := info.types;
    contract := info.contract;
    m := info.module.copy();
    name := info.name.copy();
    bounds := function_bounds(borrow(c), f - 1);
    require_constraints(borrow_mut(c), borrow(map), borrow(bounds));
    requirements := function_constraints(borrow(c), f - 1);
    require_interfaces(borrow_mut(c), borrow(map), borrow(requirements));
    // Inference binds types; it does not authorize erasing callable lifetime contracts.
    if c.raw == 0 {
        for i in count {
            formal := c.params[template_first + i];
            mut expected = formal;
            if types {
                expected = bind_types(borrow_mut(c), formal, borrow(map));
            }
            actual := argtypes[i];
            require_type(borrow_mut(c), actual, expected);
        }
    }
    mut ret = template_ret;
    mut first = template_first;
    mut signature_ret = template_ret;
    mut symbol = name.copy();
    mut destination = m.copy();
    if types {
        ret = bind_types(borrow_mut(c), template_ret, borrow(map));
        signature_ret = ret;
        if (c.validating == 0) & (contract == 0) {
            index := specialize(borrow_mut(c), f - 1, borrow(map));
            symbol = special_name(borrow_mut(c), index);
            spec := &c.specs[index];
            first = spec.first;
            signature_ret = spec.ret;
        } else {
            first = c.params.len();
            for i in count {
                t := c.params[template_first + i];
                bound := bind_types(borrow_mut(c), t, borrow(map));
                c.params.push(bound);
            }
        }
    }
    if contract {
        if c.validating == 0 {
            self := map[0];
            actual := resolve_interface_method(borrow_mut(c), contract, self, &name);
            f := &c.funcs[actual];
            destination = f.module.copy();
            symbol = f.name.copy();
        }
    }
    if 6 < args.len() {
        fail(borrow_mut(c), &"native call exceeds six arguments");
    }
    for i in args.len() {
        slot := args[i];
        ty := argtypes[i];
        move_out(borrow_mut(c), val(slot, ty));
