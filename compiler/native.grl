        if (c.raw == 0) & (c.unsafe_depth == 0) {
            fail(&mut c, view("cstr_bytes requires an unsafe block"));
        }
        a := expr(&mut c, 0);
        expect(&mut c, view(")"));
        x := deref(&mut c, a);
