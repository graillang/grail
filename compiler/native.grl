// ---- capturing closures: `|x: T, ...| -> R body`, type Fn(T,...)->R (kind 20) ----
// The value is an owned record {code, dropper, captures...}. Scalars are copied into it and owned
// values moved; a direct reference or view (`&T`, `&[T]`, `&mut T`) moves in as well, pointer and
// loan together, so the closure's type carries the regions it borrows and it cannot outlive them.
// The body is compiled afterwards as a separate function whose hidden first parameter is a shared
// reference to that record, so captures are read-only fields (no mutation, no moving out).
fn closure_free_name<a, b>(c: (&a mut C), name: &b [u8], params: (&a u8[][])) -> bool {
    for i in params.len() {
        p := &params[i];
        if same(view(p), view(name)) {
            return false;
        }
    }
    return true;
}
// A capture that is itself a reference or view: the pointer moves into the environment and the
// loan moves with it. An aggregate holding a loan - an iterator over a borrowed vector - moves in as
// the owned value it is, with its own layout and dropper; its loans move with it as well, so the
// closure carries their lifetimes: see capture_aggregate_regions.
fn capture_borrow<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        return true;
    }
    return false;
}
// A capture whose type cannot show a borrow but whose value holds one - a call-scoped closure
// parameter, a record with a closure field: its loans are the closure's too.
fn capture_hides_loan<a>(c: (&a mut C), slot: u64, ty: u64) -> bool {
    // An `Owned` closure type names whatever it borrows, so its loans are the ones its signature's
    // regions stand for; only a call-scoped one holds a loan its type cannot show.
    if (ty_kind(&mut c, ty) == 20) && (ty_env(&mut c, ty) == 0) && ((ty_mode(&mut c, ty) & CLOSURE_OWNED) != 0) {
        return false;
    }
