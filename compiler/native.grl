// `&place` and `&mut place` create typed references; indexing still returns element refs.
// Ends the non-owning temporaries created since `mark` (views and references made to pass
// arguments), except `keep`. Called once a value that holds no borrow has been computed, so later
// parts of the same statement may use what those temporaries borrowed: an assignment's place after
// its right side (`b.words[i] = f(&b)`), a record field after an earlier field (`M { n: f(&x), x }`),
// a loop body after its count. They own nothing, so no code is emitted.
fn end_temporaries<a>(c: (&a mut C), mark: u64, keep: u64) -> unit {
    release_temporaries(&mut c, mark, keep);
    close_loans(&mut c);
    expire_locals(&mut c);
    return ();
}
// The release half alone, for use inside a larger expression (a record field), where closing loans
// and expiring locals could end a borrow the enclosing expression still holds.
fn release_temporaries<a>(c: (&a mut C), mark: u64, keep: u64) -> unit {
    mut r = c.resources.len();
    while mark < r {
        r = r - 1;
        info := &c.resources[r];
        flag := info.flag;
        slot := info.slot;
        if (flag == 0) & (slot != keep) & !is_local_slot(&mut c, slot) {
            release(&mut c, r);
