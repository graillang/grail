}
fn simd_bits<a>(c: (&a mut C), ty: u64) -> u64 {
    e := simd_elem(&mut c, ty);
    if ty_kind(&mut c, e) == 21 {
        if is_f32(&mut c, e) {
            return 32;
        }
        return 64;
    }
    return ty_arg(&mut c, e);
}
fn simd_words<a>(c: (&a mut C), ty: u64) -> u64 {
    return simd_lanes(&mut c, ty) * simd_bits(&mut c, ty) / 64;
}
// The type's name, which is also the shape word of its `simd.` lines.
fn simd_shape<a>(c: (&a mut C), ty: u64) -> u8[] {
    mut out = u8[];
    if simd_is_mask(&mut c, ty) {
        out.push(109);
    } else if simd_float(&mut c, ty) {
        out.push(102);
    } else {
        out.push(105);
    }
    decimal(&mut out, simd_bits(&mut c, ty));
    out.push(120);
    decimal(&mut out, simd_lanes(&mut c, ty));
    return out;
}
// The mask a compare of `ty` gives: the same lane count and width.
fn simd_mask_of<a>(c: (&a mut C), ty: u64) -> u64 {
    return intern_full(&mut c, 36, int_type(&mut c, simd_bits(&mut c, ty), 1), simd_lanes(&mut c, ty) + 1024, u64[]);
}
// One `simd.OP SHAPE [K]` line over frame vectors: `dst` (a fresh vector of `rty`'s words when `rty`
// is a vector type), operand addresses in `a`, `b`, `third` (slots holding addresses, or SIMD_NONE),
// a scalar in `scalar` (or SIMD_NONE). Returns the result's slot: the vector, or the scalar left in %rax.
// An operand `simd_emit` does not take. Not 0: slot 0 is a function's first parameter.
const SIMD_NONE: u64 = 18446744073709551615;
fn simd_emit<a, b>(c: (&a mut C), op: &b [u8], shape_ty: u64, rty: u64, a: u64, b: u64, third: u64, scalar: u64, k: u64, scratch: bool) -> u64 {
    mut dst = 0;
    if is_simd(&mut c, rty) {
        dst = frame_alloc(&mut c, simd_words(&mut c, rty));
    } else if scratch {
        dst = frame_alloc(&mut c, simd_words(&mut c, shape_ty));
    } else {
        dst = imm(&mut c, 0);
    }
    zero := imm(&mut c, 0);
    get(&mut c, dst, view("%rdi"));
    if a != SIMD_NONE {
        get(&mut c, a, view("%rsi"));
    } else {
        get(&mut c, zero, view("%rsi"));
    }
    if b != SIMD_NONE {
        get(&mut c, b, view("%rdx"));
    } else {
        get(&mut c, zero, view("%rdx"));
    }
    if third != SIMD_NONE {
        get(&mut c, third, view("%rcx"));
    } else {
        get(&mut c, zero, view("%rcx"));
    }
    if scalar != SIMD_NONE {
        get(&mut c, scalar, view("%rax"));
    }
    mut line = copy_bytes(view("simd."));
    push_bytes(&mut line, op);
    line.push(32);
    push_bytes(&mut line, view(simd_shape(&mut c, shape_ty)));
    if same(view(op), view("lane")) {
        line.push(32);
        decimal(&mut line, k);
    }
    line.push(10);
    o(&mut c, view(line));
    if is_simd(&mut c, rty) {
        return dst;
    }
    return save(&mut c);
}
// The vector at the address in `src` copied into the vector storage at the address in `dst`.
fn simd_copy_to<a>(c: (&a mut C), dst: u64, src: u64, ty: u64) -> unit {
    zero := imm(&mut c, 0);
    get(&mut c, dst, view("%rdi"));
    get(&mut c, src, view("%rsi"));
    get(&mut c, zero, view("%rdx"));
    get(&mut c, zero, view("%rcx"));
    mut line = copy_bytes(view("simd.copy "));
    push_bytes(&mut line, view(simd_shape(&mut c, ty)));
    line.push(10);
    o(&mut c, view(line));
    return ();
}
// A scalar argument of the element type: a literal adopts it.
fn simd_scalar_arg<a>(c: (&a mut C), elem: u64) -> u64 {
    astart := c.pos;
    mut v = expr(&mut c, 0);
    aend := c.pos;
    if v.ty != elem {
        v = adopt_value(&mut c, v, astart, aend, elem);
    }
    require_type(&mut c, v.ty, elem);
    get(&mut c, v.t, view("%rax"));
    return save(&mut c);
}
fn simd_vector_arg<a>(c: (&a mut C), ty: u64) -> u64 {
    v := expr(&mut c, 0);
    require_type(&mut c, v.ty, ty);
    return v.t;
}
// The address of elements `i .. i + lanes` of `src` - a slice (`&[T]`, `&mut [T]`) or a fixed array
// behind a reference (`&[T; N]`, `&mut [T; N]`) of the vector's element type - checked once: the last
// index is bounds-checked as `src[i + lanes - 1]` would be (an `i` so large that the sum wraps fails the
// same check), then the first element's address is computed without a second check.
fn simd_elements<a>(c: (&a mut C), src: Val, index: u64, ty: u64, write: bool) -> u64 {
    elem := simd_elem(&mut c, ty);
    lanes := simd_lanes(&mut c, ty);
    width := simd_bits(&mut c, ty) / 8;
    get(&mut c, index, view("%rax"));
    o(&mut c, view("addq $"));
    on(&mut c, lanes - 1);
    o(&mut c, view(",%rax\n"));
    ok := label(&mut c);
    jump(&mut c, view("jnc"), ok);
    o(&mut c, view("movq $-1,%rax\n"));
    mark(&mut c, ok);
    last := save(&mut c);
    mut st = src.ty;
    if ty_kind(&mut c, st) == 7 {
        if write & (ty_mode(&mut c, st) == 0) {
            fail(&mut c, view("a SIMD store needs a mutable place: `&mut [T]` or `&mut [T; N]`"));
        }
        inner := base_type(&mut c, ty_arg(&mut c, st));
        if is_array(&mut c, inner) {
            if array_elem(&mut c, inner) != elem {
                fail(&mut c, view("the array's element type is not the vector's"));
            }
            array_element(&mut c, src.t, last, inner, false);
            return array_element(&mut c, src.t, index, inner, true);
        }
        st = inner;
    }
    if ty_kind(&mut c, st) == 27 {
        if ty_arg(&mut c, st) != elem {
            fail(&mut c, view("the slice's element type is not the vector's"));
        }
        if write & (ty_mode(&mut c, st) == 0) {
            fail(&mut c, view("a SIMD store needs a mutable place: `&mut [T]` or `&mut [T; N]`"));
        }
        // The typed accessors, with the header fact the LLVM lifter reads `data` and `len` from
        // once (F1): one check of the last lane against `len`, and the first lane's address.
        mut checked = "rt_slot";
        mut unchecked = "rt_slotu";
        if width == 4 {
            checked = "rt_slot4";
            unchecked = "rt_slot4u";
        }
        apply(&mut c, view(checked), two(src.t, last));
        fact_seq_arg(&mut c, view(checked), src.t, st);
        at := apply(&mut c, view(unchecked), two(src.t, index));
        fact_seq_arg(&mut c, view(unchecked), src.t, st);
        return at;
    }
    fail(&mut c, view("a SIMD load or store reads a slice (`&[T]`) or an array reference (`&[T; N]`); for a vector `v` write `&v[:]`"));
    return 0;
}
// `f32x4::splat(x)`, `f32x4::new(a, b, c, d)`, `f32x4::load(src, i)`; a mask has `splat(bool)`.
fn simd_static<a, b>(c: (&a mut C), ty: u64, name: &b [u8]) -> Val {
    expect(&mut c, view("("));
    elem := simd_elem(&mut c, ty);
    mask := simd_is_mask(&mut c, ty);
    if same(view(name), view("splat")) {
        mut s = 0;
        if mask {
            v := expr(&mut c, 0);
            require_type(&mut c, v.ty, bool_type(&mut c));
            // false 0, true all ones (the `simd.splat` of a mask does the negation).
            get(&mut c, v.t, view("%rax"));
            s = save(&mut c);
        } else {
            s = simd_scalar_arg(&mut c, elem);
        }
        expect(&mut c, view(")"));
        return val(simd_emit(&mut c, view("splat"), ty, ty, SIMD_NONE, SIMD_NONE, SIMD_NONE, s, 0, false), ty);
    }
    if same(view(name), view("new")) && !mask {
        lanes := simd_lanes(&mut c, ty);
        dst := frame_alloc(&mut c, simd_words(&mut c, ty));
        for i in lanes {
            if i != 0 {
                expect(&mut c, view(","));
            }
            s := simd_scalar_arg(&mut c, elem);
            zero := imm(&mut c, 0);
            get(&mut c, dst, view("%rdi"));
            get(&mut c, zero, view("%rsi"));
            get(&mut c, zero, view("%rdx"));
            get(&mut c, zero, view("%rcx"));
            get(&mut c, s, view("%rax"));
            mut line = copy_bytes(view("simd.insert "));
            push_bytes(&mut line, view(simd_shape(&mut c, ty)));
            line.push(32);
            decimal(&mut line, i);
            line.push(10);
            o(&mut c, view(line));
        }
        expect(&mut c, view(")"));
        return val(dst, ty);
    }
    if same(view(name), view("load")) && !mask {
        src := expr(&mut c, 0);
        expect(&mut c, view(","));
        index := simd_scalar_arg(&mut c, int_type(&mut c, 64, 0));
        expect(&mut c, view(")"));
        at := simd_elements(&mut c, src, index, ty, false);
        return val(simd_emit(&mut c, view("copy"), ty, ty, at, SIMD_NONE, SIMD_NONE, SIMD_NONE, 0, false), ty);
    }
    mut msg = copy_bytes(view("`"));
    push_bytes(&mut msg, view(simd_shape(&mut c, ty)));
    push_bytes(&mut msg, view("` has no constructor `"));
    push_bytes(&mut msg, name);
    push_bytes(&mut msg, view("`; its constructors are splat, new and load (a mask has splat)"));
    fail(&mut c, view(msg));
    return val(0, 0);
}
// A method of a vector or a mask (the receiver is evaluated and `(` read).
fn simd_method<a, b>(c: (&a mut C), value: Val, name: &b [u8]) -> Val {
    ty := base_type(&mut c, value.ty);
    elem := simd_elem(&mut c, ty);
    mask := simd_is_mask(&mut c, ty);
    float := simd_float(&mut c, ty);
    if same(view(name), view("sum")) && !mask {
        expect(&mut c, view(")"));
        return val(simd_emit(&mut c, view("sum"), ty, elem, value.t, SIMD_NONE, SIMD_NONE, SIMD_NONE, 0, true), elem);
    }
    if same(view(name), view("lane")) && !mask {
        // A constant lane: `v.lane(2)`.
        if kind(&mut c) != 2 {
            fail(&mut c, view("a lane index is an integer literal"));
        }
        text := tok_text(&mut c, c.pos);
        mut k = 0;
        for i in text.len() {
            if (text[i] < 48) || (57 < text[i]) {
                fail(&mut c, view("a lane index is an integer literal"));
            }
            k = k * 10 + text[i] - 48;
        }
        if simd_lanes(&mut c, ty) <= k {
            fail(&mut c, view("the lane index is past the vector's last lane"));
        }
        advance(&mut c);
        expect(&mut c, view(")"));
        return val(simd_emit(&mut c, view("lane"), ty, elem, value.t, SIMD_NONE, SIMD_NONE, SIMD_NONE, k, false), elem);
    }
    if same(view(name), view("store")) && !mask {
        dst := expr(&mut c, 0);
        expect(&mut c, view(","));
        index := simd_scalar_arg(&mut c, int_type(&mut c, 64, 0));
        expect(&mut c, view(")"));
        at := simd_elements(&mut c, dst, index, ty, true);
        // The copy's destination is the elements.
        simd_copy_to(&mut c, at, value.t, ty);
        return val(imm(&mut c, 0), intern(&mut c, 2, 0));
    }
    if (same(view(name), view("min")) || same(view(name), view("max"))) && !mask {
        other := simd_vector_arg(&mut c, ty);
        expect(&mut c, view(")"));
        return val(simd_emit(&mut c, name, ty, ty, value.t, other, SIMD_NONE, SIMD_NONE, 0, false), ty);
    }
    cmps := u8[][copy_bytes(view("eq")), copy_bytes(view("ne")), copy_bytes(view("lt")), copy_bytes(view("le")), copy_bytes(view("gt")), copy_bytes(view("ge"))];
    for i in cmps.len() {
        if same(view(name), view(cmps[i])) && !mask {
            other := simd_vector_arg(&mut c, ty);
            expect(&mut c, view(")"));
            mty := simd_mask_of(&mut c, ty);
            return val(simd_emit(&mut c, name, ty, mty, value.t, other, SIMD_NONE, SIMD_NONE, 0, false), mty);
        }
    }
    if mask && same(view(name), view("select")) {
        // `m.select(a, b)`: a's lane where m's is set, else b's. a and b are vectors of m's shape.
        a := expr(&mut c, 0);
        expect(&mut c, view(","));
        b := expr(&mut c, 0);
        expect(&mut c, view(")"));
        if !is_simd(&mut c, a.ty) || (simd_lanes(&mut c, a.ty) != simd_lanes(&mut c, ty)) || (simd_bits(&mut c, a.ty) != simd_bits(&mut c, ty)) || simd_is_mask(&mut c, a.ty) {
            fail(&mut c, view("select takes two vectors with the mask's lane count and width"));
        }
        require_type(&mut c, b.ty, a.ty);
        vty := base_type(&mut c, a.ty);
        return val(simd_emit(&mut c, view("select"), vty, vty, value.t, a.t, b.t, SIMD_NONE, 0, false), vty);
    }
    if mask && (same(view(name), view("any")) || same(view(name), view("all"))) {
        expect(&mut c, view(")"));
        return val(simd_emit(&mut c, name, ty, bool_type(&mut c), value.t, SIMD_NONE, SIMD_NONE, SIMD_NONE, 0, false), bool_type(&mut c));
    }
    if mask && same(view(name), view("not")) {
        expect(&mut c, view(")"));
        return val(simd_emit(&mut c, view("not"), ty, ty, value.t, SIMD_NONE, SIMD_NONE, SIMD_NONE, 0, false), ty);
    }
    mut msg = copy_bytes(view("`"));
    push_bytes(&mut msg, view(simd_shape(&mut c, ty)));
    push_bytes(&mut msg, view("` has no method `"));
    push_bytes(&mut msg, name);
    if mask {
        push_bytes(&mut msg, view("`; a mask's methods are select, any, all and not"));
    } else {
        push_bytes(&mut msg, view("`; its methods are sum, lane, store, min, max, eq, ne, lt, le, gt and ge"));
    }
    fail(&mut c, view(msg));
    return val(0, 0);
}
// `a OP b` on two vectors of one type: lane-wise + - * / on floats, + - * (wrapping) on integers,
// & | ^ on integers and masks. A comparison operator is refused: a lane-wise compare is a mask, and
// `.eq(b)`, `.lt(b)` and so on say so.
fn simd_binary<a>(c: (&a mut C), k: u64, left: u64, ty: u64, right: Val) -> Val {
    vty := base_type(&mut c, ty);
    if is_comparison(k) {
        fail(&mut c, view("a SIMD comparison is lane-wise and gives a mask: write `a.eq(b)`, `a.lt(b)` and so on"));
    }
    require_type(&mut c, right.ty, vty);
    mask := simd_is_mask(&mut c, vty);
    float := simd_float(&mut c, vty);
    mut op = "";
    if (k == 43) & !mask {
        op = "add";
    }
    if (k == 45) & !mask {
        op = "sub";
    }
    if (k == 42) & !mask {
        op = "mul";
    }
    if (k == 47) & float {
        op = "div";
    }
    if (k == 38) & !float {
        op = "and";
    }
    if (k == 124) & !float {
        op = "or";
    }
    if (k == 94) & !float {
        op = "xor";
    }
    if op.len() == 0 {
        mut msg = copy_bytes(view("this operator is not defined on `"));
        push_bytes(&mut msg, view(simd_shape(&mut c, vty)));
        push_bytes(&mut msg, view("`"));
        fail(&mut c, view(msg));
    }
    return val(simd_emit(&mut c, view(op), vty, vty, left, right.t, SIMD_NONE, SIMD_NONE, 0, false), vty);
}
fn atomic_element<a>(c: (&a mut C), ty: u64) -> bool {
    if (ty == 0) || is_bool(&mut c, ty) {
        return true;
    }
    if ty_kind(&mut c, ty) == 18 {
        bits := ty_arg(&mut c, ty);
        return (bits == 8) || (bits == 16) || (bits == 32) || (bits == 64);
    }
    return false;
}
// The width word of an `atom.*` line (machine.grl, "atomics") for an element type.
fn atomic_width<a>(c: (&a mut C), ty: u64) -> u8[] {
    mut out = u8[];
    if ty == 0 {
        push_bytes(&mut out, view("u64"));
        return out;
    }
    if is_bool(&mut c, ty) {
        push_bytes(&mut out, view("bool"));
        return out;
    }
    if ty_mode(&mut c, ty) != 0 {
        out.push(105);
    } else {
        out.push(117);
    }
    decimal(&mut out, ty_arg(&mut c, ty));
    return out;
}
// `name` is `base` alone or `base` followed by one of the ordering suffixes; the order it names
// (0 relaxed, 1 acquire, 2 release, 3 acqrel, 4 sequentially consistent), or 5 when it is not.
fn atomic_suffix<a, b>(name: &a [u8], base: &b [u8]) -> u64 {
    if name.len() < base.len() {
        return 5;
    }
    if !same(view(name[: base.len()]), view(base)) {
        return 5;
    }
    rest := name[base.len():];
    if rest.len() == 0 {
        return 4;
    }
    if same(view(rest), view("_relaxed")) {
        return 0;
    }
    if same(view(rest), view("_acquire")) {
        return 1;
    }
    if same(view(rest), view("_release")) {
        return 2;
    }
    if same(view(rest), view("_acqrel")) {
        return 3;
    }
    return 5;
}
fn atomic_no_method<a, b>(c: (&a mut C), ty: u64, name: &b [u8], valid: &b [u8]) -> unit {
    mut msg = source_type_name(&mut c, ty);
    push_bytes(&mut msg, view(" has no method `"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("`; "));
    push_bytes(&mut msg, view(valid));
    fail(&mut c, view(msg));
    return ();
}
// An `Atomic<T>` method is its `atom.*` op at the call site: no call, no allocation, no failure
// (docs/design/concurrency-stages-5-7.md, "Stage 7"). The ordering is the name's suffix and only
// the valid pairs have a name: loads take `_relaxed`/`_acquire`, stores `_relaxed`/`_release`,
// read-modify-writes and compare-exchanges all four; the bare name is sequentially consistent.
// `compare_exchange` returns the value it saw; `compare_exchange_weak` may fail spuriously and so
// returns whether it stored. `fetch_min`/`fetch_max` compare as `T` does (signed for `i*`).
fn atomic_method<a, b>(c: (&a mut C), value: Val, name: &b [u8]) -> Val {
    cell := value.t;
    elem := ty_arg(&mut c, value.ty);
    flag := is_bool(&mut c, elem);
    // kind: 1 load, 2 store, 3 rmw (with `op`), 4 strong compare-exchange, 5 weak.
    mut kind = 0;
    mut op = u8[];
    mut order = 5;
    loads := atomic_suffix(view(name), view("load"));
    if (loads == 0) || (loads == 1) || (loads == 4) {
        kind = 1;
        order = loads;
    }
    stores := atomic_suffix(view(name), view("store"));
    if (stores == 0) || (stores == 2) || (stores == 4) {
        kind = 2;
        order = stores;
    }
    rmws := u8[][copy_bytes(view("swap")), copy_bytes(view("fetch_add")), copy_bytes(view("fetch_sub")), copy_bytes(view("fetch_and")), copy_bytes(view("fetch_or")), copy_bytes(view("fetch_xor")), copy_bytes(view("fetch_min")), copy_bytes(view("fetch_max"))];
    ops := u8[][copy_bytes(view("xchg")), copy_bytes(view("add")), copy_bytes(view("sub")), copy_bytes(view("and")), copy_bytes(view("or")), copy_bytes(view("xor")), copy_bytes(view("min")), copy_bytes(view("max"))];
    for i in rmws.len() {
        r := atomic_suffix(view(name), view(rmws[i]));
        if r < 5 {
            kind = 3;
            op = ops[i].copy();
            order = r;
        }
    }
    // `compare_exchange` is a prefix of `compare_exchange_weak`: the weak name is tried second.
    strong := atomic_suffix(view(name), view("compare_exchange"));
    if strong < 5 {
        kind = 4;
        order = strong;
    }
    weak := atomic_suffix(view(name), view("compare_exchange_weak"));
    if weak < 5 {
        kind = 5;
        order = weak;
    }
    if kind == 0 {
        if (loads < 5) || ((4 <= name.len()) && same(view(name[: 4]), view("load"))) {
            atomic_no_method(&mut c, value.ty, view(name), view("the loads are load, load_relaxed and load_acquire"));
        }
        if (stores < 5) || ((5 <= name.len()) && same(view(name[: 5]), view("store"))) {
            atomic_no_method(&mut c, value.ty, view(name), view("the stores are store, store_relaxed and store_release"));
        }
        atomic_no_method(
            &mut c,
            value.ty,
            view(name),
            view(
                "its methods are load, store, swap, fetch_add, fetch_sub, fetch_and, fetch_or, fetch_xor, fetch_min, fetch_max, compare_exchange and compare_exchange_weak; read-modify-writes and compare-exchanges take _relaxed, _acquire, _release or _acqrel, loads _relaxed or _acquire, stores _relaxed or _release"
            )
        );
    }
    if flag & (kind == 3) & (same(view(op), view("add")) || same(view(op), view("sub")) || same(view(op), view("min")) || same(view(op), view("max"))) {
        atomic_no_method(&mut c, value.ty, view(name), view("an Atomic<bool> has load, store, swap, fetch_and, fetch_or, fetch_xor, compare_exchange and compare_exchange_weak"));
    }
    observe(&mut c, cell);
    mut keeper = 0;
    // Interior atomic mutation needs read authority, but its owner must remain
    // alive and at the same place throughout evaluation of every argument.
    if c.raw == 0 {
        target := place_of(&mut c, cell);
        ty := reference_type(&mut c, value.ty, 0);
        o(&mut c, view("leaq "));
        stack_slot(&mut c, cell);
        o(&mut c, view(",%rax\n"));
        keeper = save(&mut c);
        borrow_reference(&mut c, keeper, ty, cell, target, 0);
    }
    mut arity = 1;
    if kind == 1 {
        arity = 0;
    }
    if kind > 3 {
        arity = 2;
    }
    mut args = u64[];
    for i in arity {
        if i != 0 {
            expect(&mut c, view(","));
        }
        astart := c.pos;
        mut argument = expr(&mut c, 0);
        aend := c.pos;
        if c.raw == 0 {
            if (argument.ty != elem) && literal_target(&mut c, elem) {
                if adopt_literal(&mut c, astart, aend, elem) {
                    argument = val(argument.t, elem);
                }
            }
            require_type(&mut c, argument.ty, elem);
        }
        get(&mut c, argument.t, view("%rax"));
        snapshot := save(&mut c);
        args.push(snapshot);
    }
    expect(&mut c, view(")"));
    observe(&mut c, cell);
    if arity == 1 {
        get(&mut c, args[0], view("%rax"));
    }
    if arity == 2 {
        get(&mut c, args[0], view("%rax"));
        get(&mut c, args[1], view("%rcx"));
    }
    get(&mut c, cell, view("%rdi"));
    orders := u8[][copy_bytes(view("relaxed")), copy_bytes(view("acquire")), copy_bytes(view("release")), copy_bytes(view("acqrel")), copy_bytes(view("seqcst"))];
    mut line = copy_bytes(view("atom."));
    if kind == 1 {
        push_bytes(&mut line, view("load "));
    }
    if kind == 2 {
        push_bytes(&mut line, view("store "));
    }
    if kind == 3 {
        push_bytes(&mut line, view("rmw "));
        push_bytes(&mut line, view(op));
        line.push(32);
    }
    if kind == 4 {
        push_bytes(&mut line, view("cas "));
    }
    if kind == 5 {
        push_bytes(&mut line, view("casw "));
    }
    push_bytes(&mut line, view(orders[order]));
    line.push(32);
    push_bytes(&mut line, view(atomic_width(&mut c, elem)));
    line.push(10);
    o(&mut c, view(line));
    mut result = elem;
    if kind == 2 {
        result = 1;
        o(&mut c, view("xorq %rax,%rax\n"));
    }
    if kind == 5 {
        result = bool_type(&mut c);
    }
    slot := save(&mut c);
    if keeper != 0 {
        index := resource(&mut c, keeper);
        release(&mut c, index - 1);
    }
    return val(slot, result);
}
fn method_receiver<a>(c: (&a mut C), input: u64, inty: u64, xty: u64, formal: u64) -> Val {
    mut rv = input;
    mut rty = inty;
    if ty_kind(&mut c, formal) == 7 {
        if ty_kind(&mut c, inty) != 7 {
            mode := ty_mode(&mut c, formal);
            refty := reference_type(&mut c, xty, mode);
            mut temporary = 0;
            if !is_local_slot(&mut c, input) {
                index := resource(&mut c, input);
                if index != 0 {
                    info := &c.resources[index - 1];
                    if (info.base == 0) & (info.place != 0) {
                        temporary = 1;
                    }
                }
            }
            if is_local_slot(&mut c, input) || temporary != 0 {
                if mode != 0 && temporary == 0 {
                    require_mutable_binding(&mut c, input, 1);
                }
                target := place_of(&mut c, input);
                slot := slot_reference(&mut c, input, xty);
                r := borrow_reference(&mut c, slot, refty, input, target, mode);
                rv = r.t;
                rty = r.ty;
            } else {
                // A field receiver (a.b.method()) is borrowed in place, like &a.b.
                index := resource(&mut c, input);
                if index == 0 {
                    fail(&mut c, view("method receiver must be a variable, field or reference"));
                }
                info := &c.resources[index - 1];
                base := info.base;
                field := info.field;
                via := info.via;
                referent_place := info.place;
                if base == 0 {
                    fail(&mut c, view("method receiver must be a variable, field or reference"));
                }
                b := base - 1;
                // A loaded referent (including map[key]) is already addressed by its
                // base reference. Reborrow that authority, not a fictitious child of
                // the reference holder; ordinary record fields take the path below.
                owner := resource(&mut c, b);
                if owner != 0 {
                    basety := c.resources[owner - 1].ty;
                    if ty_kind(&mut c, basety) == 7 {
                        target := target_of(&mut c, b);
                        inner := ty_arg(&mut c, basety);
                        if target == referent_place && same_type(&mut c, inner, xty) {
                            return place_slot(&mut c, b, basety, mode);
                        }
                    }
                }
                if mode != 0 {
                    require_mutable_binding(&mut c, b, 0);
                    // `r.items.push(x)`: the autoref is a `&mut` of the field.
                    if owner != 0 {
                        oty := c.resources[owner - 1].ty;
                        rd := slot_record_decl(&mut c, oty);
                        if (rd != 18446744073709551615) && ref_field_refined(&mut c, rd, field) {
                            ref_field_loan_fail(&mut c, rd, field);
                        }
                    } else {
                        bd := slot_record_decl(&mut c, local_slot_ty(&mut c, b));
                        if (bd != 18446744073709551615) && ref_field_refined(&mut c, bd, field) {
                            ref_field_loan_fail(&mut c, bd, field);
                        }
                    }
                }
                holder := held_record(&mut c, b);
                n := field_reference(&mut c, b, holder, field);
                root := place_of(&mut c, b);
                target := member_place(&mut c, root, field, xty);
                authority := authority_of(&mut c, b);
                c
                    .resources
                    .push(
                        Resource {
                            slot: n,
                            ty: refty,
                            flag: 0,
                            base: b + 1,
                            field: field,
                            via: via,
                            place: 0,
                            target: target,
                            authority: authority,
                        }
                    );
                r := borrow_reference(&mut c, n, refty, b, target, mode);
                rv = r.t;
                rty = r.ty;
            }
        } else {
            // A reference receiver is reborrowed for the call, so the binding stays usable.
            mode := ty_mode(&mut c, formal);
            if mode != 0 && ty_mode(&mut c, inty) == 0 {
                fail(&mut c, view("method needs a mutable receiver but got a shared reference"));
            }
            refty := reference_type(&mut c, xty, mode);
            source := target_of(&mut c, input);
            get(&mut c, input, view("%rax"));
            slot := save(&mut c);
            r := borrow_reference(&mut c, slot, refty, input, source, mode);
            rv = r.t;
            rty = r.ty;
        }
    } else {
        if ty_kind(&mut c, inty) == 7 {
            fail(&mut c, view("method takes self by value but the receiver is a reference"));
        }
        // A slice receiver carries its writability in its type: a `&mut [T]` self cannot be
        // satisfied by a readable slice of the same elements, and a `&[T]` self is not something a
        // `&mut [T]` passes as - the two differ in mode and nothing here converts one to the other.
        fk := ty_kind(&mut c, formal);
        if ((fk == 27) || (fk == 5)) & (fk == ty_kind(&mut c, inty)) {
            fm := ty_mode(&mut c, formal);
            im := ty_mode(&mut c, inty);
            if (fm != 0) & (im == 0) {
                fail(&mut c, view("method needs a mutable receiver but got a shared reference"));
            }
            if (fm == 0) & (im != 0) {
                fail(&mut c, view("method takes a shared receiver but got a mutable reference"));
            }
        }
    }
    return val(rv, rty);
}
// Values whose type has an inherent `show(self: &a Self) -> string` print through it.
fn show_value<a>(c: (&a mut C), input: u64, inty: u64, xty: u64) -> Val {
    if ty_kind(&mut c, xty) != 8 {
        return val(0, NO_TYPE);
    }
    d := ty_arg(&mut c, xty);
    owner := private_module(view(".inherent_"), d);
    f := find_func(&mut c, view(owner), view("show"));
    if f == 0 {
        return val(0, NO_TYPE);
    }
    info := &c.funcs[f - 1];
    first := info.first;
    count := info.count;
    if count != 1 {
        fail(&mut c, view("show must take only self"));
    }
    formal := c.params[first];
    if ty_kind(&mut c, formal) != 7 {
        fail(&mut c, view("show must take self by reference"));
    }
    prepared := method_receiver(&mut c, input, inty, xty, formal);
    exchange(&mut c.receiver, prepared.t);
    exchange(&mut c.receiver_ty, prepared.ty);
    exchange(&mut c.has_receiver, 2);
    return call(&mut c, view(owner), view("show"));
}
// The iterator protocol: a record with an inherent `fn next(self: &mut Self) -> T?` is iterable,
// and `for x in it` is `while let Some(x) = it.next() { ... }`. An owned iterator is moved into a
// hidden mutable local that lives for the loop; `for x in &mut it` iterates a borrowed one and leaves
// it usable afterwards. Each `next` call reborrows the iterator, so an iterator that borrows a
// collection keeps that loan for the whole loop (the collection cannot be mutated in the body).
// Returns false, consuming nothing, when `v` is not such an iterator.
fn iterator_loop<a, b>(c: (&a mut C), name: u8[], vt: u64, vty: u64, loopbase: u64, names: (&b u8[][])) -> bool {
    mut xty = vty;
    if ty_kind(&mut c, xty) == 7 {
        xty = ty_arg(&mut c, xty);
    }
    if ty_kind(&mut c, xty) != 8 {
        return false;
    }
    d := ty_arg(&mut c, xty);
    if c.decls[d].is_enum != 0 {
        return false;
    }
    owner := private_module(view(".inherent_"), d);
    f := find_func(&mut c, view(owner), view("next"));
    if f == 0 {
        return false;
    }
    info := &c.funcs[f - 1];
    first := info.first;
    count := info.count;
    formal := c.params[first];
    if (count != 1) || (ty_kind(&mut c, formal) != 7) || (ty_mode(&mut c, formal) == 0) {
        fail(&mut c, view("for x in it needs fn next(self: &mut Self) -> T? on the iterator"));
    }
    if (ty_kind(&mut c, vty) == 7) & (ty_mode(&mut c, vty) == 0) {
        fail(&mut c, view("for x in &it needs &mut it: next advances the iterator"));
    }
    mark := c.locals.len();
    mut input = vt;
    inty := vty;
    if ty_kind(&mut c, vty) != 7 {
        owned := move_value(&mut c, val(vt, vty));
        bind(&mut c, copy_bytes(view("__iterator")), owned.ty, owned.t, 1);
        input = owned.t;
        mut open = c.pos;
        while kind_at(&mut c, open) != 123 {
            open = open + 1;
        }
        loopend := block_end(&mut c, open);
        last := c.locals.len() - 1;
        mut l = &mut c.locals[last];
        l.last = loopend;
    }
    pattern_loop(&mut c, false, 1, copy_bytes(view("Some")), name, 1, owner, input, inty, xty, formal, names);
    // Everything the iterable expression made ends with the loop: the hidden iterator is dropped,
    // and the `&mut it` reborrow of a lent iterator releases its loan.
    cleanup(&mut c, loopbase);
    pop_locals(&mut c, mark);
    return true;
}
// The body of `loop`, `while` and `while let` (and of `for x in it` over an iterator, which is
// `while let Some(x) = it.next()`): the header is already parsed. With `iter_owner` set, the
// pattern's scrutinee is a call of that module's `next` on `iter_input` instead of an expression.
fn pattern_loop<a, b>(
    c: (&a mut C),
    endless: bool,
    pattern: u64,
    variant: u8[],
    binding: u8[],
    has_binding: u64,
    iter_owner: u8[],
    iter_input: u64,
    iter_inty: u64,
    iter_xty: u64,
    iter_formal: u64,
    names: (&b u8[][])
) -> unit {
    // A fact scope of its own for the loop: the loop variable's binding is made before the body's
    // block opens, so the facts it shadows come back when the loop ends rather than at the close of
    // an unrelated later block (docs/design/refinements.md, "Facts over the typed IR").
    pv_ir_open(&mut c);
    head := label(&mut c);
    end := label(&mut c);
    oldb := c.brk;
    oldc := c.cont;
    oldmark := c.loopmark;
    oldstart := c.loop_start;
    oldend := c.loop_end;
    loopstart := c.pos;
    mut open = loopstart;
    while kind_at(&mut c, open) != 123 {
        open = open + 1;
    }
    loopend := block_end(&mut c, open);
    exchange(&mut c.loop_start, loopstart);
    exchange(&mut c.loop_end, loopend);
    exchange(&mut c.loopmark, c.resources.len());
    oldloop := exchange(&mut c.loopcheck, ownership::snapshot(&c.check));
    oldbreak := exchange(&mut c.breaks, ownership::new());
    oldhas := c.hasbreak;
    exchange(&mut c.hasbreak, 0);
    exchange(&mut c.brk, end);
    exchange(&mut c.cont, head);
    // The guard is evaluated again after every iteration, so what the body writes is forgotten
    // before the guard is compiled: a call in it is proved, and a constant in it is settled, only
    // from facts that hold at every evaluation.
    pv_loop_kill(&mut c, open, loopend);
    mark(&mut c, head);
    mut nomatch = 0;
    mut scrutinee = 0;
    mut scrutty = 0;
    mut payloads = 0;
    mut patmark = 0;
    if pattern != 0 {
        mut s = val(0, 0);
        if iter_owner.len() != 0 {
            // `for x in it`: the scrutinee is `it.next()`, called afresh at every iteration on a
            // reborrow of the iterator (iterator_loop).
            prepared := method_receiver(&mut c, iter_input, iter_inty, iter_xty, iter_formal);
            exchange(&mut c.receiver, prepared.t);
            exchange(&mut c.receiver_ty, prepared.ty);
            exchange(&mut c.has_receiver, 2);
            s = call(&mut c, view(iter_owner), view("next"));
        } else {
            s = expr(&mut c, 0);
        }
        x := deref(&mut c, s);
        xt := x.t;
        xty := x.ty;
        scrutinee = xt;
        scrutty = xty;
        if ty_kind(&mut c, xty) != 8 {
            fail(&mut c, view("while let requires an enum value"));
        }
        d := ty_arg(&mut c, xty);
        decl := &c.decls[d];
        if decl.is_enum == 0 {
            fail(&mut c, view("while let requires an enum value"));
        }
        k := find_field(&mut c, d, view(variant));
        pty := field_type(&mut c, xty, k);
        tag := rec_load(&mut c, xt, 0, 0);
        move_out(&mut c, val(xt, xty));
        nomatch = label(&mut c);
        get(&mut c, tag, view("%rax"));
        o(&mut c, view("cmpq $"));
        on(&mut c, k);
        o(&mut c, view(",%rax\n"));
        jump(&mut c, view("jne"), nomatch);
        patmark = c.locals.len();
        payloads = c.resources.len();
        payload := payload_load(&mut c, xt, xty, pty);
        own(&mut c, payload, pty);
        source := place_of(&mut c, xt);
        dest := place_of(&mut c, payload);
        if contains_borrow(&mut c, pty, 0) {
            transfer_bonds(&mut c, source, dest);
        }
        stored_source(&mut c, payload, pty);
        free_enum_shell(&mut c, xt, xty);
        if has_binding != 0 {
            bind(&mut c, binding.copy(), pty, payload, 0);
            if names.len() != 0 {
                tuple_element_bind(&mut c, names, pty, payload);
            }
        }
    }
    if !endless & (pattern == 0) {
        tests := c.resources.len();
        guard_at := c.pos;
        mut v = expr(&mut c, 0);
        guard_end := c.pos;
        if c.raw == 0 {
            require_type(&mut c, v.ty, 0);
            strict_condition(&mut c, v.ty);
        }
        cleanup(&mut c, tests);
        expire_locals(&mut c);
        // The guard holds on the body's paths, and only there: an iteration that exits did not
        // establish it for what follows the loop.
        mut guards = pv_ir_atoms(&mut c, guard_at, guard_end);
        pv_ir_statement(&mut c, guard_at, guard_end);
        pv_ir_pending(&mut c, &guards);
        get(&mut c, v.t, view("%rax"));
        o(&mut c, view("testq %rax,%rax\n"));
        jump(&mut c, view("jz"), end);
    }
    entry := ownership::snapshot(&c.check);
    exchange(&mut c.terminated, 0);
    block(&mut c);
    // The pattern's binding ends with each iteration, before the jump back: release it first, so
    // neither the backedge check nor the state the loop exits with still holds this iteration's
    // item (an iterator that hands out references left its last item's loan in the exit state,
    // and a second loop after it then saw that stale storage "consumed" on its own backedge).
    terminated := c.terminated;
    if pattern != 0 {
        cleanup(&mut c, payloads);
        pop_locals(&mut c, patmark);
    }
    if terminated == 0 {
        if !backedge_ok(&mut c, &ownership::snapshot(&c.loopcheck)) {
            fail_backedge(&mut c, view("loop backedge consumes entry storage"));
        }
    }
    // A body that always returns or continues reaches the exit only through the entry state
    // (and any breaks): its dead end state, where `return` dropped every local, must not be
    // merged in.
    if terminated != 0 {
        ownership::restore(&mut c.check, &entry);
    } else {
        ownership::merge(&mut c.check, &entry);
    }
    if c.hasbreak != 0 {
        ownership::merge(&mut c.check, &ownership::snapshot(&c.breaks));
    }
    exchange(&mut c.terminated, 0);
    jump(&mut c, view("jmp"), head);
    if pattern != 0 {
        mark(&mut c, nomatch);
        get(&mut c, scrutinee, view("%rdi"));
        drop_call(&mut c, scrutty);
    }
    mark(&mut c, end);
    broke := c.hasbreak;
    exchange(&mut c.brk, oldb);
    exchange(&mut c.cont, oldc);
    exchange(&mut c.loopmark, oldmark);
    exchange(&mut c.loopcheck, oldloop);
    exchange(&mut c.breaks, oldbreak);
    exchange(&mut c.hasbreak, oldhas);
    exchange(&mut c.loop_start, oldstart);
    exchange(&mut c.loop_end, oldend);
    if endless & (broke == 0) {
        exchange(&mut c.terminated, 1);
    }
    pv_ir_close(&mut c);
    return ();
}
// Built-in methods on string / bytes / views. Results are new values; `string` input gives `string`.
fn text_arg<a>(c: (&a mut C)) -> Val {
    v := expr(&mut c, 0);
    if !is_text(&mut c, v.ty) {
        fail(&mut c, view("text method argument must be text"));
    }
    return v;
}
fn text_method<a, b>(c: (&a mut C), xt: u64, k: u64, name: &b [u8]) -> Val {
    mut result = 2;
    if k == 4 {
        result = 3;
    }
    bt := bool_type(&mut c);
    if same(view(name), view("contains")) || same(view(name), view("starts_with")) || same(view(name), view("ends_with")) {
        arg := text_arg(&mut c);
        expect(&mut c, view(")"));
        mut f = "rt_seq_contains";
        if same(view(name), view("starts_with")) {
            f = "rt_seq_starts";
        }
        if same(view(name), view("ends_with")) {
            f = "rt_seq_ends";
        }
        r := invoke(&mut c, view(f), two(xt, arg.t));
        release_temporary(&mut c, arg.t);
        return val(r, bt);
    }
    if same(view(name), view("to_upper")) || same(view(name), view("to_lower")) {
        expect(&mut c, view(")"));
        mut f = "rt_seq_upper";
        if same(view(name), view("to_lower")) {
            f = "rt_seq_lower";
        }
        r := invoke(&mut c, view(f), one(xt));
        return own(&mut c, r, result);
    }
    if same(view(name), view("replace")) {
        from := text_arg(&mut c);
        expect(&mut c, view(","));
        to := text_arg(&mut c);
        expect(&mut c, view(")"));
        valid := imm(&mut c, k == 4);
        mut args = u64[];
        args.push(xt);
        args.push(from.t);
        args.push(to.t);
        args.push(valid);
        r := invoke(&mut c, view("rt_seq_replace"), args);
        release_temporary(&mut c, from.t);
        release_temporary(&mut c, to.t);
        return own(&mut c, r, result);
    }
    if same(view(name), view("repeat")) {
        n := expr(&mut c, 0);
        require_type(&mut c, n.ty, 0);
        expect(&mut c, view(")"));
        r := invoke(&mut c, view("rt_seq_repeat"), two(xt, n.t));
        return own(&mut c, r, result);
    }
    if same(view(name), view("chars")) {
        expect(&mut c, view(")"));
        r := invoke(&mut c, view("rt_seq_chars"), one(xt));
        ch := char_type(&mut c);
        vt := intern(&mut c, 6, ch);
        return own(&mut c, r, vt);
    }
    return val(0, NO_TYPE);
}
fn char_method<a>(n: &a [u8]) -> bool {
    return same(view(n), view("is_alphabetic"))
        || same(view(n), view("is_alphanumeric"))
        || same(view(n), view("is_ascii_digit"))
        || same(view(n), view("is_whitespace"))
        || same(view(n), view("is_uppercase"))
        || same(view(n), view("is_lowercase"))
        || same(view(n), view("is_ascii"))
        || same(view(n), view("to_uppercase"))
        || same(view(n), view("to_lowercase"))
        || same(view(n), view("len_utf8"));
}
// `*T` is one word: the natural width of a sized integer, 4 and 8 for f32 and f64, and one word for
// everything else, because a record, vector or string value is a pointer to its own storage.
fn ptr_stride<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(&mut c, ty);
    if k == 18 {
        return ty_arg(&mut c, ty) / 8;
    }
    if k == 21 {
        if ty_arg(&mut c, ty) == 32 {
            return 4;
        }
        return 8;
    }
    return 8;
}
// Every operation on a raw pointer reads or writes memory the checker has not followed, so each one
// needs an `unsafe` block. The type itself is spellable anywhere.
fn raw_pointer_gate<a, b>(c: (&a mut C), what: &b [u8]) -> unit {
    if (c.raw == 0) & (c.unsafe_depth == 0) {
        mut msg = copy_bytes(view("a raw pointer operation needs an unsafe block: "));
        push_bytes(&mut msg, view(what));
        fail(&mut c, view(msg));
    }
    return ();
}
// The methods of a `*T`. The receiver's word is the address; `name` is the method already read and
// `(` already expected.
fn pointer_method<a, d>(c: (&a mut C), value: Val, pty: u64, name: &d [u8]) -> Val {
    raw_pointer_gate(&mut c, view(name));
    word := value.t;
    x := deref(&mut c, value);
    address := x.t;
    pointee := ty_arg(&mut c, pty);
    mode := ty_mode(&mut c, pty);
    if same(view(name), view("addr")) {
        expect(&mut c, view(")"));
        release_temporary(&mut c, word);
        return val(address, 0);
    }
    if same(view(name), view("is_null")) {
        expect(&mut c, view(")"));
        get(&mut c, address, view("%rax"));
        o(&mut c, view("testq %rax,%rax\nsete %al\nmovzbq %al,%rax\n"));
        slot := save(&mut c);
        release_temporary(&mut c, word);
        return val(slot, bool_type(&mut c));
    }
    if same(view(name), view("cast")) {
        elem := parse_type(&mut c);
        expect(&mut c, view(")"));
        release_temporary(&mut c, word);
        return val(address, intern_full(&mut c, 34, elem, mode, u64[]));
    }
    if same(view(name), view("add")) || same(view(name), view("sub")) {
        nv := expr(&mut c, 0);
        expect(&mut c, view(")"));
        nx := deref(&mut c, nv);
        if !integer(&mut c, nx.ty) {
            fail(&mut c, view("add and sub take a step count"));
        }
        size := ptr_stride(&mut c, pointee);
        get(&mut c, nx.t, view("%rax"));
        o(&mut c, view("movq $"));
        on(&mut c, size);
        o(&mut c, view(",%rcx\nimulq %rcx,%rax\n"));
        step := save(&mut c);
        get(&mut c, address, view("%rax"));
        get(&mut c, step, view("%rcx"));
        if same(view(name), view("add")) {
            o(&mut c, view("addq %rcx,%rax\n"));
        } else {
            o(&mut c, view("subq %rcx,%rax\n"));
        }
        slot := save(&mut c);
        release_temporary(&mut c, word);
        return val(slot, pty);
    }
    if same(view(name), view("read")) {
        expect(&mut c, view(")"));
        slot := ptr_load(&mut c, address, pointee);
        // The value read out is the reader's: `ptr::read` duplicates ownership, so the result is an
        // owner with a drop flag of its own, which is what lets it be dropped or moved with the
        // ordinary rules (the reader owes the source a value it will not use twice).
        own(&mut c, slot, pointee);
        release_temporary(&mut c, word);
        return val(slot, pointee);
    }
    if same(view(name), view("write")) {
        if mode == 0 {
            fail(&mut c, view("write needs a *mut T; a *T only reads"));
        }
        v := expr(&mut c, 0);
        expect(&mut c, view(")"));
        ptr_store(&mut c, address, v.t, pointee);
