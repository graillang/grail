}
fn loan_live<a>(c: (&a mut C), loan: u64) -> u64 {
    mut l = &c.check.loans[loan - 1];
    return l.live;
}
fn transfer_bonds<a>(c: (&a mut C), src: u64, dst: u64) -> unit {
    if (src == 0) || (dst == 0) {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if loan_live(&mut c, loan) != 0 {
            if ownership::ancestor(&c.check, src, holder) {
                bond_kind(&mut c, dst, loan, guard);
