    formal := c.params[first];
    if ty_kind(&mut c, formal) != 7 {
        fail(&mut c, view("show must take self by reference"));
    }
    prepared := method_receiver(&mut c, input, inty, xty, formal);
    exchange(&mut c.receiver, prepared.t);
    exchange(&mut c.receiver_ty, prepared.ty);
