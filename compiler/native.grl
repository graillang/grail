    // binary32 cannot represent), so a first assignment inside a loop converts it once.
    if (flex == 2) & is_f32(&mut c, value_ty) {
        out = value_ty;
        text := tok_text(&mut c, lit);
        mut wide = float_bits_p(&mut c, view(text), 53);
        mut narrow = float_bits_p(&mut c, view(text), 24);
        if neg != 0 {
            wide = wide ^ 9223372036854775808;
            narrow = narrow ^ 9223372036854775808;
        }
        if wide != narrow {
            done := label(&mut c);
            o(&mut c, view("movabsq $"));
            on(&mut c, wide);
            o(&mut c, view(",%rcx\n"));
            get(&mut c, id, view("%rax"));
            o(&mut c, view("cmpq %rcx,%rax\n"));
