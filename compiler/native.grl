// Stores b through the mutable reference a and returns the previous (owned) value.
fn exchange_into<a>(c: (&a mut C), a: Val, b: Val) -> Val {
    ty := ty_arg(borrow_mut(c), a.ty);
    if c.raw == 0 {
        require_type(borrow_mut(c), b.ty, ty);
        destination := target_of(borrow_mut(c), a.t);
        frame_storage(borrow_mut(c), a.t, destination);
        source := place_of(borrow_mut(c), b.t);
        check_writeback(borrow_mut(c), destination, ty, source);
    }
    require_write(borrow_mut(c), a.t);
    destination := target_of(borrow_mut(c), a.t);
    seed_storage(borrow_mut(c), destination, ty);
    slot := apply(borrow_mut(c), &"rt_xchg", two(a.t, b.t));
    own(borrow_mut(c), slot, ty);
    result := place_of(borrow_mut(c), slot);
    return_bonds(borrow_mut(c), destination, result, 0);
    source := place_of(borrow_mut(c), b.t);
    storage_bonds(borrow_mut(c), source, destination);
    move_out(borrow_mut(c), val(b.t, b.ty));
    if c.raw == 0 {
        stored_source(borrow_mut(c), slot, ty);
    }
    return val(slot, ty);
}
