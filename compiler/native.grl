                    pending = depth + 1;
                    skip = i;
                }
            }
        }
        mut use = 1;
        if i != 0 {
            prev := kind_at(&mut c, i - 1);
            if (prev == 46) || (prev == 260) {
                use = 0;
            }
        }
        mut next = kind_at(&mut c, i + 1);
        if (next == 58) || (next == 40) || (next == 260) || (next == 261) {
            use = 0;
        }
        if kind == 1 && en - st == name.len() && i != skip && hidden == 0 && use != 0 {
            mut matched = 1;
            mut j = 0;
            while j < en - st {
                if c.src[st + j] != name[j] {
                    matched = 0;
                    break;
                }
                j = j + 1;
