        }
        if (k == 60) + (k == 62) + (k == 269) + (k == 270) {
            o(borrow_mut(c), &"setb %al\n");
        }
        o(borrow_mut(c), &"movzbq %al,%rax\n");
        if (k == 269) + (k == 270) {
            o(borrow_mut(c), &"xorq $1,%rax\n");
        }
    }
    return save(borrow_mut(c));
}
// `for i in a..v.len() { .. v[i] .. }`: the body never names v except as v[..] or v.len(), so the
// length cannot change and v[i] is in bounds. Returns v's name, or empty when not provable.
fn len_bound_ahead<a, b>(c: (&a mut C), name: &b [u8]) -> u8[] {
    p := c.pos;
    if c.toks.len() < p + 7 {
        return u8[];
    }
    if (kind_at(borrow_mut(c), p) != 1)
        + (kind_at(borrow_mut(c), p + 1) != 46)
        + (kind_at(borrow_mut(c), p + 3) != 40)
        + (kind_at(borrow_mut(c), p + 4) != 41)
        + (kind_at(borrow_mut(c), p + 5) != 123) {
        return u8[];
    }
    method := tok_text(borrow_mut(c), p + 2);
    if same(&method, &"len") == 0 {
        return u8[];
    }
    base := tok_text(borrow_mut(c), p);
    if find_local(borrow_mut(c), &base) == 0 {
        return u8[];
    }
    end := block_end(borrow_mut(c), p + 5);
    mut j = p + 6;
    while j < end {
        k := kind_at(borrow_mut(c), j);
        if (k == 124) + (k == 274) {
            return u8[];
        }
        if k == 1 {
            t := tok_text(borrow_mut(c), j);
            if same(&t, &"for") + same(&t, &"mut") {
                nt := tok_text(borrow_mut(c), j + 1);
                if same(&nt, &name) + same(&nt, &base) {
                    return u8[];
                }
            }
            if same(&t, &name) {
                if kind_at(borrow_mut(c), j + 1) == 261 {
                    return u8[];
                }
            }
            if same(&t, &base) {
                mut ok = 0;
                nk := kind_at(borrow_mut(c), j + 1);
                if nk == 91 {
                    ok = 1;
                }
                if (nk == 46) & (j + 5 < c.toks.len()) {
                    if (kind_at(borrow_mut(c), j + 3) == 40)
                        & (kind_at(borrow_mut(c), j + 4) == 41) {
                        m := tok_text(borrow_mut(c), j + 2);
                        if same(&m, &"len") {
                            ok = 1;
                        }
                    }
                }
                if (j != 0) & ok {
                    pk := kind_at(borrow_mut(c), j - 1);
                    if (pk == 46) + (pk == 38) {
                        ok = 0;
                    }
                }
                if ok == 0 {
                    return u8[];
                }
            }
        }
        j += 1;
    }
    return base.copy();
}
// Whether `[ i ]` at the cursor indexes the proven base with the proven loop variable.
fn proven_index<a>(c: (&a mut C), value: Val) -> u64 {
    if c.bce_index.len() == 0 {
        return false;
    }
    p := c.pos;
    if c.toks.len() < p + 3 {
        return false;
    }
    if (kind_at(borrow_mut(c), p + 1) != 1) + (kind_at(borrow_mut(c), p + 2) != 93) {
        return false;
    }
    t := tok_text(borrow_mut(c), p + 1);
    ix := c.bce_index.copy();
    if same(&t, &ix) == 0 {
        return false;
    }
    base := c.bce_base.copy();
    l := find_local(borrow_mut(c), &base);
    if l == 0 {
        return false;
    }
    return local_id(borrow_mut(c), l - 1) == value.t;
}
// Exactly one dereference: map indexing exposes a V place, including when V is itself a reference.
fn map_read_place<a>(c: (&a mut C), reference: Val) -> Val {
    old := reference.t;
    ty := ty_arg(borrow_mut(c), reference.ty);
    target := target_of(borrow_mut(c), old);
    if target == 0 {
        fail(borrow_mut(c), &"map index has no tracked reference target");
    }
    get(borrow_mut(c), old, &"%rax");
    o(borrow_mut(c), &"movq (%rax),%rax\n");
    slot := save(borrow_mut(c));
    c
        .resources
        .push(
            Resource {
                slot: slot,
                ty: ty,
                flag: 0,
                base: old + 1,
                field: 0,
                via: 1,
                place: target,
                target: 0,
                authority: old + 1,
            }
        );
    owner := place_of(borrow_mut(c), old);
    n := c.bonds.len();
    for i in n {
        b := &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if (holder == owner) & guard {
            bond_kind(borrow_mut(c), target, loan, guard);
        }
    }
    stored_source(borrow_mut(c), slot, ty);
    return val(slot, ty);
}
fn map_key<a>(c: (&a mut C), keyty: u64) -> Val {
    start := c.pos;
    mut key = expr_expected(borrow_mut(c), 0, keyty);
    end := c.pos;
    if ty_kind(borrow_mut(c), key.ty) == 7 {
        inner := ty_arg(borrow_mut(c), key.ty);
        require_type(borrow_mut(c), inner, keyty);
    } else {
        key = adopt_value(borrow_mut(c), key, start, end, keyty);
        require_type(borrow_mut(c), key.ty, keyty);
    }
    // Scalar expression results have no drop resource until bound. Give this
    // borrowed key argument a tracked copyable place without inventing an owner.
    if place_of(borrow_mut(c), key.t) == 0 {
        if scalar(borrow_mut(c), key.ty) == 0 {
            fail(borrow_mut(c), &"map lookup key has no tracked place");
        }
        place := ownership::root(borrow_mut(c.check), 1, 1);
        c
            .resources
            .push(
                Resource {
                    slot: key.t,
                    ty: key.ty,
                    flag: 0,
                    base: 0,
                    field: 0,
                    via: 0,
                    place: place,
                    target: 0,
                    authority: 0,
                }
            );
    }
    return key;
}
// '[' has already been consumed. Borrow keys; never turn required lookup into insertion.
fn map_index<a>(c: (&a mut C), value: Val, mapty: u64, access: u64) -> Val {
    mode := access == 2;
    formal := reference_type(borrow_mut(c), mapty, mode);
    receiver := method_receiver(borrow_mut(c), value.t, value.ty, mapty, formal);
    types := type_args(borrow_mut(c), mapty);
    keyty := types[0];
    key := map_key(borrow_mut(c), keyty);
    expect(borrow_mut(c), &"]");
    keyformal := reference_type(borrow_mut(c), keyty, 0);
    keyref := method_receiver(borrow_mut(c), key.t, key.ty, keyty, keyformal);
    mut args = Val[];
    args.push(receiver);
    args.push(keyref);
    mut name = "map_get";
    if mode {
        name = "map_get_mut";
    }
    optional := map_call(borrow_mut(c), name, mapty, args);
    result := propagate(borrow_mut(c), optional, 1);
    release_temporary(borrow_mut(c), key.t);
    if access != 0 {
        return result;
    }
    return map_read_place(borrow_mut(c), result);
}

fn index_view<a>(c: (&a mut C), value: Val, access: u64) -> Val {
    unchecked := (c.raw == 0) & proven_index(borrow_mut(c), val(value.t, value.ty));
    advance(borrow_mut(c));
    input := value.t;
    inty := value.ty;
    x := deref(borrow_mut(c), value);
    if is_map_type(borrow_mut(c), x.ty) {
        return map_index(borrow_mut(c), val(input, inty), x.ty, access);
    }
    if ty_kind(borrow_mut(c), x.ty) == 6 {
        xt := x.t;
        xty := x.ty;
        bstart := c.pos;
        mut bound = expr(borrow_mut(c), 0);
        bend := c.pos;
        if c.raw == 0 {
            bound = adopt_value(borrow_mut(c), bound, bstart, bend, 0);
        }
        index := bound.t;
        expect(borrow_mut(c), &"]");
