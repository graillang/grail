                slot := invoke(&mut c, view("rt_f64_from_int"), two(value.t, fv));
                return val(slot, ty);
            }
        }
        if same(view(first), view("f32")) {
            if (find_local(&mut c, view(first)) == 0)
                & (find_func(&mut c, view(m), view(first)) == 0) {
                advance(&mut c);
                vstart := c.pos;
                mut value = expr(&mut c, 0);
                vend := c.pos;
                expect(&mut c, view(")"));
                ty := f32_type(&mut c);
                value = adopt_float(&mut c, value, vstart, vend, ty);
                source := value.ty;
                if is_f32(&mut c, source) {
