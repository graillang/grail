                param = intern_args(&mut c, 9, i, bounds, u64[], proofs);
            }
            // `T::Item`: an associated type of one of T's bounds.
            if is(&mut c, view("::")) && (next_kind(&mut c) == 1) {
                advance(&mut c);
                assoc_name := ident(&mut c);
                return assoc_type(&mut c, param, view(assoc_name));
