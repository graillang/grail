fn int_name<a>(n: &a [u8]) -> u64 {
    if same(view(n), view("u8")) {
        return 8;
    }
    if same(view(n), view("u16")) {
        return 16;
    }
    if same(view(n), view("u32")) {
        return 32;
    }
    if same(view(n), view("u64")) {
        return 64;
    }
    if same(view(n), view("i8")) {
        return 264;
    }
    if same(view(n), view("i16")) {
        return 272;
    }
    if same(view(n), view("i32")) {
        return 288;
    }
    if same(view(n), view("i64")) || same(view(n), view("isize")) {
        return 320;
    }
    return 0;
}
