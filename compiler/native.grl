// passed as a callable): a capture-free closure object {code, drop, target} whose code is the
// shared adapter `grail_fn_thunk` (emitted once, see emit_fn_thunk). The signatures must match up to
// renaming of lifetimes, so `fn less<a, b>(x: (&a T), y: (&b T))` is an `Fn(&T, &T) -> bool`.
fn function_as_closure<a>(c: (&a mut C), v: Val, expected: u64) -> Val {
    params := type_args(&mut c, v.ty);
    result := ty_arg(&mut c, v.ty);
    mode := ty_mode(&mut c, expected);
    as_closure := intern_args(&mut c, 20, result, mode, u64[], params);
    if same_type(&mut c, as_closure, expected) == 0 {
        return v;
