// The environment field is declared in the environment's own lifetime (`env` is region 1): the body
// re-borrows the captured reference from the environment, never from the enclosing function's
// lifetime names, which do not exist there.
fn capture_field_type<a>(c: (&a mut C), ty: u64) -> u64 {
    mut rs = u64[];
    rs.push(1);
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    return intern_args(&mut c, k, arg, mode, rs, u64[]);
}
// `=`, `+=`, `-=`, `*=`, `/=`, `%=` or `**=`.
fn is_assign_kind(k: u64) -> bool {
    return (k == 61) || ((261 < k) && (k < 267)) || (k == 268);
}
// Whether a place rooted just past `j` (`.field` and `[index]` steps) is assigned to: the body
// stores into the capture itself, a field of it, or an element of it.
fn place_assign_after<a>(c: (&a mut C), j: u64, end: u64) -> bool {
    mut p = j;
    while p < end {
        k := kind_at(&mut c, p);
        if k == 46 {
            if kind_at(&mut c, p + 1) != 1 {
                return false;
            }
            p = p + 2;
        } else if k == 91 {
            mut depth = 0;
            mut closed = 0;
            while p < end {
                kk := kind_at(&mut c, p);
                if (kk == 40) || (kk == 91) || (kk == 123) {
                    depth += 1;
                } else if (kk == 41) || (kk == 93) || (kk == 125) {
                    depth -= 1;
                    if depth == 0 {
                        p = p + 1;
                        closed = 1;
                        break;
                    }
                    if depth < 0 {
                        return false;
                    }
                }
                p = p + 1;
            }
            if closed == 0 {
                return false;
            }
        } else {
            break;
        }
    }
    return is_assign_kind(kind_at(&mut c, p));
}
// Container methods that never mutate their receiver. Anything not named here is treated as a
// write, so a closure calling it needs exclusive access rather than silently aliasing.
fn read_only_method<a>(n: &a [u8]) -> bool {
    return same(view(n), view("len"))
        || same(view(n), view("is_empty"))
        || same(view(n), view("contains"))
        || same(view(n), view("first"))
        || same(view(n), view("last"))
        || same(view(n), view("get"))
        || same(view(n), view("position"))
        || same(view(n), view("index_of"))
        || same(view(n), view("keys"))
        || same(view(n), view("values"))
        || same(view(n), view("entries"))
        || same(view(n), view("upper"))
        || same(view(n), view("lower"))
        || same(view(n), view("to_uppercase"))
        || same(view(n), view("to_lowercase"))
        || same(view(n), view("trim"))
        || same(view(n), view("chars"))
        || same(view(n), view("split"))
        || same(view(n), view("repeat"))
        || same(view(n), view("starts_with"))
        || same(view(n), view("ends_with"))
        || same(view(n), view("size"))
        || same(view(n), view("capacity"));
}
// Whether the use of a capture at token `i` writes it. A write is a store to the capture or to a
// place rooted at it (`n = ...`, `n += ...`, `r.f = ...`, `v[i] = ...`, `*r = ...`, which is the
// same shape), a mutable borrow of it (`&mut n`), or a method call that may mutate its receiver.
// A shared reference or view can only be read through, so its methods stay reads.
fn capture_written_at<a>(c: (&a mut C), i: u64, end: u64, ty: u64) -> bool {
    if place_assign_after(&mut c, i + 1, end) {
        return true;
    }
    if i > 1 {
        // `&mut n`: an exclusive borrow of the capture, so the environment must be exclusive too.
        if (kind_at(&mut c, i - 2) == 38) & same(view(tok_text(&mut c, i - 1)), view("mut")) {
            return true;
        }
    }
    if (kind_at(&mut c, i + 1) == 46) & (kind_at(&mut c, i + 3) == 40) {
        k := ty_kind(&mut c, ty);
        if ((k == 5) || (k == 7) || (k == 27)) & (ty_mode(&mut c, ty) == 0) {
            return false;
        }
        if (ty_kind(&mut c, ty) != 8) & (ty_kind(&mut c, ty) != 20) {
            m := tok_text(&mut c, i + 2);
            if read_only_method(view(m)) {
                return false;
