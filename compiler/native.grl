fn decode_literal<a>(c: (&a mut C), p: u64) -> u8[] {
    t := &c.toks[p];
    st := t.start;
    en := t.end;
    mut out = u8[];
    mut i = st + 1;
    while i < en - 1 {
        mut b = c.src[i];
        if b == 92 {
            i = i + 1;
            e := c.src[i];
            b = e;
            if e == 110 {
                b = 10;
            }
            if e == 114 {
                b = 13;
            }
            if e == 116 {
                b = 9;
            }
            if e == 48 {
                b = 0;
            }
            if e == 120 {
                h := hex(c.src[i + 1]);
                lo := hex(c.src[i + 2]);
                b = h * 16 + lo;
                i = i + 2;
            }
        }
        out.push(b);
        i = i + 1;
    }
    return out;
}
