                o(&mut c, view("leaq "));
                lname(&mut c, resume);
                o(
                    &mut c,
                    view("(%rip),%rax\npushq %rbp\npushq %rbx\npushq %r12\npushq %r13\npushq %r14\npushq %r15\npushq %rax\nmovq %rsp,(%rdi)\nmovq %rsi,%rsp\npopq %rax\npopq %r15\npopq %r14\npopq %r13\npopq %r12\npopq %rbx\npopq %rbp\njmp *%rax\n")
