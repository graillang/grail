    let b=expr(borrow_mut(c),0);
    let bt=b.t;
    if id==7 {
        expect(borrow_mut(c),read(")"));
        let slot=apply(borrow_mut(c),read("rt_at"),two(xt,bt));release_temporary(borrow_mut(c),input);return val(slot,0);
    }
    if id==9 {
        expect(borrow_mut(c),read(")"));
        if c.raw==0{if ty_kind(borrow_mut(c),xty)!=6{fail(borrow_mut(c),read("push requires vector"));}let expected=ty_arg(borrow_mut(c),xty);require_type(borrow_mut(c),b.ty,expected);
