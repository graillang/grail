            require_type(borrow_mut(c), b.ty, 0);
        } else {
            expected := ty_arg(borrow_mut(c), xty);
            require_type(borrow_mut(c), b.ty, expected);
            target := place_of(borrow_mut(c), xt);
            source := place_of(borrow_mut(c), bt);
            check_writeback(borrow_mut(c), target, expected, source);
