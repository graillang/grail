 if main{if (1<count)+(typecount!=0){fail(borrow_mut(c),&"main needs zero arguments or one readonly byte view and no type parameters");}}
 entry :=main+((c.current_impl==0)&(c.entry==0)&(c.file==2)&public&(count<2)&(typecount==0));
 file :=c.file;raw :=c.raw;bounds :=copy_numbers(borrow(c.type_bounds));constraints :=copy_constraints(borrow(c.type_interfaces));c.funcs.push(Func{module:m,name:name,first:first,count:count,ret:ret,types:typecount,regions:regioncount,file:file,pos:position,raw:raw,bounds:bounds,constraints:constraints,contract:0});
 index :=c.funcs.len();if entry{exchange(borrow_mut(c.entry),index);}skip_braces(borrow_mut(c));return ();}
 if c.current_spec{spec :=c.current_spec;name=special_name(borrow_mut(c),spec-1);}
 start :=c.pos;end :=block_end(borrow_mut(c),start);exchange(borrow_mut(c.scope_end),end);
 for i in c.locals.len(){mut l =&c.locals[i];name :=l.name.copy();last :=last_name(borrow_mut(c),&name,start,end);mut l =&mut c.locals[i];exchange(borrow_mut(l.last),last);}
 o(borrow_mut(c),&".type ");mangle(borrow_mut(c),&m,&name);o(borrow_mut(c),&",@function\n");
 mangle(borrow_mut(c),&m,&name);o(borrow_mut(c),&":\npushq %rbp\nmovq %rsp,%rbp\nsubq $.F");
