    v := capture_field(&mut c, view(name), 1, write);
    if v.ty == 18446744073709551615 {
        fail(
            &mut c,
            view("reference needs a variable or field (bind the value first: x := ...; &x)")
        );
    }
    target := target_of(&mut c, v.t);
    r := resource(&mut c, v.t);
    info := &c.resources[r - 1];
    base := info.base - 1;
    before := c.check.loans.len();
    mut ref = borrow_reference(&mut c, v.t, v.ty, base, target, write);
    // A reborrow from the environment's own authority records no bond of its own: the reference
    // holds the loan to the field, so the store through it must find that loan here.
    after := c.check.loans.len();
    if after > before {
        holder := place_of(&mut c, ref.t);
        bond(&mut c, holder, after);
