    }
    mut p = 0;
    if is_comparison(k) {
        p = 3;
    }
    get(&mut c, right, view("%rcx"));
    get(&mut c, left, view("%rax"));
    if k == 43 {
        o(&mut c, view("addq %rcx,%rax\n"));
    }
    if k == 45 {
        o(&mut c, view("subq %rcx,%rax\n"));
    }
    if k == 42 {
        o(&mut c, view("mulq %rcx\n"));
    }
    if ((k == 43) || (k == 45) || (k == 42)) && (((c.overflow != 0) || (c.raw != 0))) {
        ok := label(&mut c);
        jump(&mut c, view("jnc"), ok);
        o(&mut c, view("call rt_abort\n"));
        mark(&mut c, ok);
    }
    if k == 38 {
        o(&mut c, view("andq %rcx,%rax\n"));
    }
    if k == 124 {
        o(&mut c, view("orq %rcx,%rax\n"));
    }
    if (k == 271) || (k == 272) {
