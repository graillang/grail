                                                fail(
                                                    borrow_mut(c),
                                                    &"operator not defined for char (compare, or convert with u32(c))"
                                                );
                                            }
                                            t = binary(borrow_mut(c), k, snap, right.t);
                                            ty = bool_type(borrow_mut(c));
                                        } else {
                                            if (c.raw == 0) & (ty_kind(borrow_mut(c), ty) == 18) {
                                                require_type(borrow_mut(c), rty, ty);
                                                if (k == 38)
                                                    + (k == 94)
                                                    + (k == 124)
                                                    + (k == 271)
                                                    + (k == 272)
                                                    + is_comparison(k)
                                                    + (k == 43)
                                                    + (k == 45)
                                                    + (k == 42)
                                                    + (k == 47)
                                                    + (k == 37)
                                                    + (k == 267) {
                                                    result := int_binary(
                                                        borrow_mut(c),
                                                        k,
                                                        snap,
                                                        right.t,
                                                        ty
                                                    );
                                                    t = result.t;
                                                    ty = result.ty;
                                                } else {
                                                    fail(
                                                        borrow_mut(c),
                                                        &"operator not defined for sized integers"
                                                    );
                                                }
                                            } else {
                                                if c.raw == 0 {
                                                    require_type(borrow_mut(c), ty, 0);
                                                    require_type(borrow_mut(c), rty, 0);
                                                }
                                                both := is_bool(borrow_mut(c), ty)
                                                    & is_bool(borrow_mut(c), rty);
                                                t = binary(borrow_mut(c), k, snap, right.t);
                                                ty = 0;
                                                if is_comparison(k)
                                                    + (
                                                        both & ((k == 38) + (k == 124) + (k == 94))
                                                    ) {
                                                    ty = bool_type(borrow_mut(c));
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return val(t, ty);
}

// ---- statements ----
fn block<a>(c: (&a mut C)) -> unit {
    start := c.pos;
    end := block_end(borrow_mut(c), start);
    oldend := c.scope_end;
    exchange(borrow_mut(c.scope_end), end);
    expect(borrow_mut(c), &"{");
    mark := c.locals.len();
    mut owners = c.resources.len();
    while is(borrow_mut(c), &"}") == 0 {
        stmt(borrow_mut(c));
    }
    advance(borrow_mut(c));
    cleanup(borrow_mut(c), owners);
    pop_locals(borrow_mut(c), mark);
    exchange(borrow_mut(c.scope_end), oldend);
    return ();
}
// Last-use ending may retire the lhs reference while parsing the rhs. Retain its
// concrete capability until the store; the pin has no runtime-owned descriptor.
fn pin_assignment<a>(c: (&a mut C), target: u64) -> unit {
    if c.raw {
        return ();
    }
    index := resource(borrow_mut(c), target);
    if index == 0 {
        return ();
    }
    r := &c.resources[index - 1];
    authority := r.authority;
    if authority != 0 {
        source := place_of(borrow_mut(c), authority - 1);
        if source != 0 {
            slot := imm(borrow_mut(c), 0);
            ty := reference_type(borrow_mut(c), 0, 0);
            own(borrow_mut(c), slot, ty);
            holder := place_of(borrow_mut(c), slot);
            return_bonds(borrow_mut(c), source, holder, 1);
        }
    }
    return ();
}
fn reserve_compound<a>(c: (&a mut C), slot: u64, through: u64) -> u64 {
    if c.raw {
        return 0;
    }
    mut place = place_of(borrow_mut(c), slot);
    mut authority = authority_of(borrow_mut(c), slot);
    if through {
        place = target_of(borrow_mut(c), slot);
    } else {
        authority = 0;
        if place == 0 {
            place = ownership::root(borrow_mut(c.check), 1, 1);
            c
                .resources
                .push(
                    Resource {
                        slot: slot,
                        ty: 0,
                        flag: 0,
                        base: 0,
                        field: 0,
                        via: 0,
                        place: place,
                        target: 0,
                        authority: 0,
                    }
                );
        }
    }
    if ownership::status(borrow(c.check), place) != 1 {
        fail(borrow_mut(c), &"compound assignment requires initialized numeric storage");
    }
    mut loan = 0;
    if authority {
        parent := authority_loan(borrow_mut(c), authority, place);
        loan = ownership::reborrow_place(borrow_mut(c.check), parent, place, 0);
    } else {
        loan = ownership::borrow_place(borrow_mut(c.check), place, 0);
    }
    if loan == 0 {
        fail(borrow_mut(c), &"compound assignment target conflicts with live borrow");
    }
    pin := imm(borrow_mut(c), 0);
    ty := reference_type(borrow_mut(c), 0, 0);
    own(borrow_mut(c), pin, ty);
    holder := place_of(borrow_mut(c), pin);
    bond(borrow_mut(c), holder, loan);
    return resource(borrow_mut(c), pin);
}
fn compound_operator(k: u64) -> u64 {
    if k == 262 {
        return 43;
    }
    if k == 263 {
        return 45;
    }
    if k == 264 {
        return 42;
    }
    if k == 265 {
        return 47;
    }
    if k == 266 {
        return 37;
    }
    return 267;
}
// `xs[i] = v;`, `s.items[i] += v;`, `buf[i] = b;`: the operator token position, or 0.
fn index_assignment_ahead<a>(c: (&a mut C)) -> u64 {
    if kind(borrow_mut(c)) != 1 {
        return 0;
    }
    mut e = c.pos + 1;
    while (kind_at(borrow_mut(c), e) == 46) & (kind_at(borrow_mut(c), e + 1) == 1) {
        e = e + 2;
    }
    if kind_at(borrow_mut(c), e) != 91 {
        return 0;
    }
    mut depth = 0;
    while true {
        k := kind_at(borrow_mut(c), e);
        if k == 0 {
            return 0;
        }
        if k == 91 {
            depth = depth + 1;
        }
        if k == 93 {
            depth = depth - 1;
            if depth == 0 {
                break;
            }
        }
        if k == 59 {
            return 0;
        }
        e = e + 1;
    }
    k := kind_at(borrow_mut(c), e + 1);
    if (k == 61) + ((261 < k) & (k < 267)) + (k == 268) {
        return e + 1;
    }
    return 0;
}
// Combines an old numeric value with an operand for a compound assignment of type ty.
fn compound_value<a>(c: (&a mut C), op: u64, old: u64, v: Val, ty: u64) -> Val {
    if (c.raw == 0) & is_float(borrow_mut(c), ty) {
        require_type(borrow_mut(c), v.ty, ty);
        if (op != 43) & (op != 45) & (op != 42) & (op != 47) {
            fail(borrow_mut(c), &"operator not defined for floats");
        }
        opv := imm(borrow_mut(c), op);
        mut value = invoke(borrow_mut(c), &"rt_f64_op", three(opv, old, v.t));
        if is_f32(borrow_mut(c), ty) {
            value = invoke(borrow_mut(c), &"rt_f32_round", one(value));
        }
        return val(value, ty);
    }
    if (c.raw == 0) & (ty_kind(borrow_mut(c), ty) == 18) {
        require_type(borrow_mut(c), v.ty, ty);
        r := int_binary(borrow_mut(c), op, old, v.t, ty);
        return val(r.t, ty);
    }
    if c.raw == 0 {
        require_type(borrow_mut(c), ty, 0);
        require_type(borrow_mut(c), v.ty, 0);
    }
    value := binary(borrow_mut(c), op, old, v.t);
    return val(value, 0);
}
// Look ahead through named fields without evaluating the target or key.
fn map_assignment_ahead<a>(c: (&a mut C)) -> u64 {
    pos := c.pos;
    name := tok_text(borrow_mut(c), pos);
    local := find_local(borrow_mut(c), &name);
    if local == 0 {
        return 0;
    }
    mut ty = local_ty(borrow_mut(c), local - 1);
    mut q = pos + 1;
    while kind_at(borrow_mut(c), q) == 46 {
        while ty_kind(borrow_mut(c), ty) == 7 {
            ty = ty_arg(borrow_mut(c), ty);
        }
        if ty_kind(borrow_mut(c), ty) != 8 {
            return 0;
        }
        name := tok_text(borrow_mut(c), q + 1);
        decl := ty_arg(borrow_mut(c), ty);
        field := find_field(borrow_mut(c), decl, &name);
        ty = field_type(borrow_mut(c), ty, field);
        q += 2;
    }
    while ty_kind(borrow_mut(c), ty) == 7 {
        ty = ty_arg(borrow_mut(c), ty);
    }
    return is_map_type(borrow_mut(c), ty);
}
fn map_lookup<a>(c: (&a mut C), ty: u64, receiver: Val, key: Val, mode: u64) -> Val {
    mut args = Val[];
    args.push(receiver);
    args.push(key);
    mut name = "map_get";
    if mode {
        name = "map_get_mut";
    }
    optional := map_call(borrow_mut(c), name, ty, args);
    return propagate(borrow_mut(c), optional, 1);
}
fn release_slot<a>(c: (&a mut C), slot: u64) -> unit {
    r := resource(borrow_mut(c), slot);
    if r != 0 {
        release(borrow_mut(c), r - 1);
    }
    return ();
}
// Map targets reserve shared access while evaluating the RHS. No bucket address is retained
// across insertion, and the receiver/key/RHS are each evaluated once in source order.
fn map_index_assignment<a>(c: (&a mut C)) -> unit {
    base := primary(borrow_mut(c));
    mut mapty = base.ty;
    while ty_kind(borrow_mut(c), mapty) == 7 {
        mapty = ty_arg(borrow_mut(c), mapty);
    }
    require_mutable_binding(borrow_mut(c), base.t, 0);
    formal := reference_type(borrow_mut(c), mapty, 0);
    reservation := method_receiver(borrow_mut(c), base.t, base.ty, mapty, formal);
    expect(borrow_mut(c), &"[");
    types := type_args(borrow_mut(c), mapty);
    keyty := types[0];
    valuety := types[1];
    oppos := index_assignment_operator(borrow_mut(c));
    operator := kind_at(borrow_mut(c), oppos);
    mut key = val(0, 0);
    mut keypin = val(0, 0);
    mut oldref = val(0, 0);
    mut oldvalue = 0;
    if operator == 61 {
        value := context_value(borrow_mut(c), keyty);
        key = move_value(borrow_mut(c), value);
    } else {
        value := map_key(borrow_mut(c), keyty);
        key = val(value.t, value.ty);
        keyformal := reference_type(borrow_mut(c), keyty, 0);
        keypin = method_receiver(borrow_mut(c), value.t, value.ty, keyty, keyformal);
        receiver := place_slot(borrow_mut(c), reservation.t, reservation.ty, 0);
        keyref := place_slot(borrow_mut(c), keypin.t, keypin.ty, 0);
        oldref = map_lookup(borrow_mut(c), mapty, receiver, keyref, 0);
        if (integer(borrow_mut(c), valuety) + is_float(borrow_mut(c), valuety)) == 0 {
            fail(borrow_mut(c), &"compound map assignment needs numeric values");
        }
        get(borrow_mut(c), oldref.t, &"%rax");
        o(borrow_mut(c), &"movq (%rax),%rax\n");
        oldvalue = save(borrow_mut(c));
    }
    expect(borrow_mut(c), &"]");
    advance(borrow_mut(c));
    temps := c.resources.len();
    value := context_value(borrow_mut(c), valuety);
    expect(borrow_mut(c), &";");
    temp_end := c.resources.len();
    mut held = move_value(borrow_mut(c), value);
    // Materialize the RHS before ending its expression-only loans. References retained in
    // held keep their loans alive and therefore still prevent an invalid map mutation.
    mut j = temp_end;
    while temps < j {
        j -= 1;
        slot := c.resources[j].slot;
        if is_local_slot(borrow_mut(c), slot) == 0 {
            release(borrow_mut(c), j);
        }
    }
    if operator != 61 {
        release_slot(borrow_mut(c), oldref.t);
    }
    release_slot(borrow_mut(c), reservation.t);
    close_loans(borrow_mut(c));
    mutableformal := reference_type(borrow_mut(c), mapty, 1);
    receiver := method_receiver(borrow_mut(c), base.t, base.ty, mapty, mutableformal);
    if operator == 61 {
        mut args = Val[];
        args.push(receiver);
        args.push(key);
        args.push(held);
        old := map_call(borrow_mut(c), &"map_insert", mapty, args);
        release_slot(borrow_mut(c), old.t);
    } else {
        op := compound_operator(operator);
        held = compound_value(borrow_mut(c), op, oldvalue, held, valuety);
        keyref := place_slot(borrow_mut(c), keypin.t, keypin.ty, 0);
        target := map_lookup(borrow_mut(c), mapty, receiver, keyref, 1);
        old := exchange_into(borrow_mut(c), target, held);
        release_slot(borrow_mut(c), old.t);
        release_slot(borrow_mut(c), keypin.t);
        release_temporary(borrow_mut(c), key.t);
    }
    return ();
}
// Current cursor is the key expression, after '['. Find the outer closing bracket.
fn index_assignment_operator<a>(c: (&a mut C)) -> u64 {
    mut q = c.pos;
    mut depth = 0;
    while true {
        k := kind_at(borrow_mut(c), q);
        if k == 0 {
            fail(borrow_mut(c), &"unclosed map index assignment");
        }
        if k == 91 {
            depth += 1;
        }
        if k == 93 {
            if depth == 0 {
                return q + 1;
            }
            depth -= 1;
        }
        q += 1;
    }
    return 0;
}

// Legacy vector/byte assignment evaluates RHS before parsing its mutable target.
fn index_assignment<a>(c: (&a mut C)) -> unit {
    start := c.pos;
    oppos := index_assignment_ahead(borrow_mut(c));
    operator := kind_at(borrow_mut(c), oppos);
    exchange(borrow_mut(c.pos), oppos + 1);
    vstart := c.pos;
    mut v = expr(borrow_mut(c), 0);
    vend := c.pos;
    expect(borrow_mut(c), &";");
    after := c.pos;
    ls := c.lit_start;
    le := c.lit_end;
    lv := c.lit_value;
    ln := c.lit_negative;
    fs := c.flit_start;
    fe := c.flit_end;
    ft := c.flit_tok;
    fneg := c.flit_neg;
    exchange(borrow_mut(c.pos), start);
    // A binding holding a mutable view/reference writes through its capability (no `mut` needed).
    mut capability = 0;
    name := tok_text(borrow_mut(c), start);
    l := find_local(borrow_mut(c), &name);
    if (l != 0) & (kind_at(borrow_mut(c), start + 1) == 91) {
        lt := local_ty(borrow_mut(c), l - 1);
        lk := ty_kind(borrow_mut(c), lt);
        if ((lk == 5) + (lk == 7)) & (ty_mode(borrow_mut(c), lt) != 0) {
            capability = 1;
        }
    }
    mut base = val(0, 0);
    if capability {
        base = primary(borrow_mut(c));
    } else {
        base = place(borrow_mut(c), 1);
    }
    x := deref(borrow_mut(c), val(base.t, base.ty));
    k := ty_kind(borrow_mut(c), x.ty);
    mut op = 0;
    if operator != 61 {
        op = compound_operator(operator);
    }
    if k == 6 {
        elem := ty_arg(borrow_mut(c), x.ty);
        r := index_view(borrow_mut(c), base, 2);
        exchange(borrow_mut(c.lit_start), ls);
        exchange(borrow_mut(c.lit_end), le);
        exchange(borrow_mut(c.lit_value), lv);
        exchange(borrow_mut(c.lit_negative), ln);
        exchange(borrow_mut(c.flit_start), fs);
        exchange(borrow_mut(c.flit_end), fe);
        exchange(borrow_mut(c.flit_tok), ft);
        exchange(borrow_mut(c.flit_neg), fneg);
        if c.raw == 0 {
            v = adopt_value(borrow_mut(c), v, vstart, vend, elem);
        }
        if operator != 61 {
            if c.raw == 0 {
                if (integer(borrow_mut(c), elem) + is_float(borrow_mut(c), elem)) == 0 {
                    fail(borrow_mut(c), &"compound assignment needs numeric elements");
                }
            }
            get(borrow_mut(c), r.t, &"%rax");
            o(borrow_mut(c), &"movq (%rax),%rax\n");
            old := save(borrow_mut(c));
            v = compound_value(borrow_mut(c), op, old, v, elem);
        }
        exchange_into(borrow_mut(c), r, v);
    } else {
        // Bytes: buf[i] = b stores the low byte of a u8/u64 value.
        if c.raw == 0 {
            if (k != 3) & ((k != 5) + (ty_mode(borrow_mut(c), x.ty) == 0)) {
                fail(
                    borrow_mut(c),
                    &"index assignment needs a vector, bytes or a mutable byte view"
                );
            }
        }
        expect(borrow_mut(c), &"[");
        index := expr(borrow_mut(c), 0);
        if c.raw == 0 {
            require_type(borrow_mut(c), index.ty, 0);
        }
        expect(borrow_mut(c), &"]");
        exchange(borrow_mut(c.lit_start), ls);
        exchange(borrow_mut(c.lit_end), le);
        exchange(borrow_mut(c.lit_value), lv);
        exchange(borrow_mut(c.lit_negative), ln);
        u := int_type(borrow_mut(c), 8, 0);
        if c.raw == 0 {
            if (c.lit_start == vstart) & (c.lit_end == vend) & (v.ty == 0) {
                if adopt_literal(borrow_mut(c), vstart, vend, u) {
                    v = val(v.t, u);
                }
            }
            if v.ty != u {
                require_type(borrow_mut(c), v.ty, 0);
            }
        }
        if operator != 61 {
            old := invoke(borrow_mut(c), &"rt_atb", two(x.t, index.t));
            v = compound_value(borrow_mut(c), op, old, val(v.t, 0), 0);
        }
        require_write(borrow_mut(c), x.t);
        mut args = two(x.t, index.t);
        args.push(v.t);
        // A u64 value must fit in a byte; u8 values always do.
        if v.ty != u {
            lim := imm(borrow_mut(c), 256);
            get(borrow_mut(c), lim, &"%rcx");
            get(borrow_mut(c), v.t, &"%rax");
            o(borrow_mut(c), &"cmpq %rcx,%rax\n");
            ok := label(borrow_mut(c));
            jump(borrow_mut(c), &"jb", ok);
            o(borrow_mut(c), &"call rt_abort\n");
            mark(borrow_mut(c), ok);
        }
        invoke(borrow_mut(c), &"rt_write", args);
    }
    exchange(borrow_mut(c.pos), after);
    return ();
}
fn assignment_ahead<a>(c: (&a mut C)) -> u64 {
    if kind(borrow_mut(c)) != 1 {
        return 0;
    }
    mut e = c.pos + 1;
    while kind_at(borrow_mut(c), e) == 46 {
        e = e + 2;
    }
    k := kind_at(borrow_mut(c), e);
    return (k == 61) + ((261 < k) & (k < 267)) + (k == 268);
}
// Evaluates one argument to its dereferenced value.
fn operand<a>(c: (&a mut C)) -> Val {
    mut v = expr(borrow_mut(c), 0);
    return deref(borrow_mut(c), v);
}
fn write_statement<a>(c: (&a mut C)) -> unit {
    temps := c.resources.len();
    expect(borrow_mut(c), &"(");
    mut args = u64[];
    for i in 3 {
        if i != 0 {
            expect(borrow_mut(c), &",");
        }
        value := operand(borrow_mut(c));
        v := value.t;
        ty := value.ty;
        if c.raw == 0 {
            if i == 0 {
                k := ty_kind(borrow_mut(c), ty);
                if (k != 5) + (ty_mode(borrow_mut(c), ty) == 0) {
                    fail(borrow_mut(c), &"write requires mutable byte view");
                }
            } else {
                require_type(borrow_mut(c), ty, 0);
            }
        }
        get(borrow_mut(c), v, &"%rax");
        snap := save(borrow_mut(c));
        r := resource(borrow_mut(c), v);
        if r != 0 {
            old := &c.resources[r - 1];
            ty := old.ty;
            place := old.place;
            authority := old.authority;
            c
                .resources
                .push(
                    Resource {
                        slot: snap,
                        ty: ty,
                        flag: 0,
                        base: v + 1,
                        field: 0,
                        via: 1,
                        place: place,
                        target: 0,
                        authority: authority,
                    }
                );
        }
        args.push(snap);
    }
    expect(borrow_mut(c), &")");
    expect(borrow_mut(c), &";");
    first := args[0];
    require_write(borrow_mut(c), first);
    invoke(borrow_mut(c), &"rt_write", args);
    cleanup(borrow_mut(c), temps);
    return ();
}
// if let Variant(binding) = value { ... } else { ... }: consumes value like match; the else
// branch drops it (so a different variant's payload is cleaned up).
fn if_let<a>(c: (&a mut C)) -> unit {
    name := ident(borrow_mut(c));
    mut binding = u8[];
    mut has_binding = 0;
    if eat(borrow_mut(c), &"(") {
        if eat(borrow_mut(c), &"_") == 0 {
            binding = ident(borrow_mut(c));
            has_binding = 1;
        }
        expect(borrow_mut(c), &")");
    }
    expect(borrow_mut(c), &"=");
    tests := c.resources.len();
    s := expr(borrow_mut(c), 0);
    x := deref(borrow_mut(c), s);
    xt := x.t;
    xty := x.ty;
    if ty_kind(borrow_mut(c), xty) != 8 {
        fail(borrow_mut(c), &"if let requires an enum value");
    }
    d := ty_arg(borrow_mut(c), xty);
    decl := &c.decls[d];
    if decl.is_enum == 0 {
        fail(borrow_mut(c), &"if let requires an enum value");
    }
    k := find_field(borrow_mut(c), d, &name);
    pty := field_type(borrow_mut(c), xty, k);
    tag := rec_load(borrow_mut(c), xt, 0, 0);
    move_out(borrow_mut(c), val(xt, xty));
    before := ownership::snapshot(borrow(c.check));
    no := label(borrow_mut(c));
    end := label(borrow_mut(c));
    get(borrow_mut(c), tag, &"%rax");
    o(borrow_mut(c), &"cmpq $");
    on(borrow_mut(c), k);
    o(borrow_mut(c), &",%rax\n");
    jump(borrow_mut(c), &"jne", no);
    mark := c.locals.len();
    payloads := c.resources.len();
    payload := rec_load(borrow_mut(c), xt, 1, 0);
    own(borrow_mut(c), payload, pty);
    source := place_of(borrow_mut(c), xt);
    dest := place_of(borrow_mut(c), payload);
    if contains_borrow(borrow_mut(c), pty, 0) {
        transfer_bonds(borrow_mut(c), source, dest);
    }
    stored_source(borrow_mut(c), payload, pty);
    invoke(borrow_mut(c), &"rt_free", one(xt));
    if has_binding {
        bind(borrow_mut(c), binding, pty, payload, 0);
    }
