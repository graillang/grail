fn host_fn<a,b>(c:ref_mut<a,C>,name:read<b>,ret:num)->unit {
 let first=len(c.params);
 if same(read(name),read("arg")){vec_push(c.params,0);}
 if same(read(name),read("read_file"))+same(read(name),read("print")){vec_push(c.params,4);}
 if same(read(name),read("write_file")){vec_push(c.params,4);vec_push(c.params,4);}
 if same(read(name),read("command")){let ty=intern(borrow_mut(c),6,2);vec_push(c.params,ty);}
