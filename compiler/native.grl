                expect(&mut c, view(","));
            }
        }
        for j in fixed.len() {
            if fixed[j] == NO_TYPE {
                fail(&mut c, view("a dyn type names every associated type of its interface: dyn I<Item = T>"));
            }
        }
        mut known = false;
        for i in c.dyn_ifaces.len() {
            if c.dyn_ifaces[i] == id {
