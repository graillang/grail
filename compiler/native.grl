        mark := c.locals.len();
        if binding.len() {
            bind(borrow_mut(c), binding, ty, xt, 0);
        }
        if eat(borrow_mut(c), &"if") {
            tests := c.resources.len();
            g := expr(borrow_mut(c), 0);
            if (is_bool(borrow_mut(c), g.ty) + (g.ty == 0)) == 0 {
                fail(borrow_mut(c), &"match guard must be a bool");
            }
            cleanup(borrow_mut(c), tests);
            get(borrow_mut(c), g.t, &"%rax");
            o(borrow_mut(c), &"testq %rax,%rax\n");
