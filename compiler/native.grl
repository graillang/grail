// Canonical specialization keys erase opaque body aliases and lift captured lifetimes
// into fresh signature slots, disjoint from explicitly named function lifetimes.
fn canonical_type<a, b>(c: (&a mut C), ty: u64, next: (&b mut u64)) -> u64 {
    k := ty_kind(&mut c, ty);
    mut arg = ty_arg(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    if k == 10 {
        return canonical_type(&mut c, arg, &mut next);
    }
    if (k == 6) || (k == 27) || (k == 7) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) || (k == 29)
        || (k == 34) {
        arg = canonical_type(&mut c, arg, &mut next);
    }
    mut args = type_args(&mut c, ty);
    for i in args.len() {
        t := args[i];
        a := canonical_type(&mut c, t, &mut next);
        exchange(&mut args[i], a);
    }
    old := type_regions(&mut c, ty);
    mut count = old.len();
    if (k == 5) || (k == 7) || (k == 27) {
        count = 1;
    }
    if k == 8 {
        d := &c.decls[arg];
        count = d.regions;
    }
    mut rs = u64[];
    for i in count {
        n := load(next) + 1;
        exchange(&mut next, n);
        rs.push(n);
    }
    env := ty_env(&mut c, ty);
    return intern_env(&mut c, k, arg, mode, rs, args, env);
}
fn decimal<a>(out: (&a mut u8[]), n: u64) -> unit {
    if 9 < n {
        decimal(&mut out, n / 10);
    }
    out.push(48 + n % 10);
    return ();
}
// The key a specialisation is deduplicated by: the template's identity plus the canonical spelling
// of its type arguments. `canonical_type` has already erased aliases and lifted captured lifetimes
// into fresh slots, so the spelling is a function of the types alone - not of the order
// instantiations were met in, of which other modules share the build, or of which compiler run this
// is. That is what lets one module emit the body and every other module reference it, in whatever
// order the modules are compiled (B1 stage 3).
fn special_key<a>(c: (&a mut C), index: u64) -> u8[] {
    f := &c.funcs[c.specs[index].template];
    mut module = f.module.copy();
    mut name = f.name.copy();
    mut args = u64[];
    for i in c.specs[index].args.len() {
        args.push(c.specs[index].args[i]);
    }
    mut out = u8[];
    push_bytes(&mut out, view(module));
    out.push(58);
    out.push(58);
    push_bytes(&mut out, view(name));
    for i in args.len() {
        out.push(32);
        type_key(&mut c, &mut out, args[i], 0);
    }
    return out;
}
// A specialisation's symbol: the template's name and the first 64 bits of the SHA-256 of its key, as
// 16 lowercase hex characters. A position in this run's `c.specs` would not survive separate
// compilation - the importer and the defining module do not build that list in the same order - so
// the name is derived from the key instead.
fn special_name<a>(c: (&a mut C), index: u64) -> u8[] {
    mut out = c.funcs[c.specs[index].template].name.copy();
    out.push(36);
    key := special_key(&mut c, index);
    digest := iface_digest(&key);
    for i in 16 {
        out.push(digest[i]);
    }
    return out;
}
fn specialize<a, b>(c: (&a mut C), template: u64, map: (&b u64[])) -> u64 {
    if c.fn_rec != 0 {
        // Every request, not only the one that creates the entry: a body that names a
        // specialisation another body asked for first must still ask when it is replayed alone.
        asked := copy_numbers(map);
        fn_reg_spec(&mut c, template, &asked);
    }
    f := &c.funcs[template];
    mut next = f.regions;
    first := f.first;
    count := f.count;
    ret := f.ret;
    mut args = u64[];
    for i in map.len() {
        t := map[i];
        a := canonical_type(&mut c, t, &mut next);
        args.push(a);
    }
    spec_index_sync(&mut c);
    if c.spec_slots.len() != 0 {
        key := spec_hash(template, &args);
        mask := c.spec_slots.len() - 1;
        mut h = key & mask;
        while c.spec_slots[h] != 0 {
            i := c.spec_slots[h] - 1;
            if c.spec_keys[i] == key {
                old := &c.specs[i];
                if old.template == template {
                    if numbers_equal(&old.args, &args) {
                        return i;
                    }
                }
            }
            h = (h + 1) & mask;
        }
    }
    // The limit is what stops a generic that instantiates itself at an ever larger type
    // (`f<T>` calling `f<T[]>`); a real program's instantiations are counted in thousands, and the
    // lookup above no longer scans them.
    if 65536 < c.specs.len() {
        fail(&mut c, view("generic specialization expansion limit"));
    }
    start := c.params.len();
    for i in count {
        bound := bind_types(&mut c, c.params[first + i], &args);
        c.params.push(bound);
    }
    result := bind_types(&mut c, ret, &args);
    index := c.specs.len();
    c.specs.push(Spec { template: template, args: args, first: start, ret: result, requester: c.body_module.copy() });
    return index;
}
fn replay_function<a>(c: (&a mut C), template: u64) -> unit {
    f := &c.funcs[template];
    file := f.file;
    pos := f.pos;
    raw := f.raw;
    mut module = f.module.copy();
    home := f.home.copy();
    owner := f.owner;
    mut generic_impl = 0;
    if inherent_is_type_key(owner) {
        // A method of a written-type inherent impl (`impl<T> T[]`): its body is written in the
        // impl's own module, and its `Self` is the impl's type with this instantiation's arguments.
        module = home;
        exchange(&mut c.inherent, owner);
        st := impl_self(&mut c, owner);
        exchange(&mut c.self_type, st);
    } else if owner >= generic_impl_key(0) {
        // A method of a generic interface implementation: its home module, and the implementation
        // it belongs to (so its own parameters are prepended again).
        generic_impl = owner - generic_impl_key(0);
        module = home;
        exchange(&mut c.current_impl, generic_impl);
        st := impl_self(&mut c, owner);
        exchange(&mut c.self_type, st);
    } else if owner != 0 {
        d := &c.decls[owner - 1];
        module = d.module.copy();
        exchange(&mut c.inherent, owner);
        st := impl_self(&mut c, owner);
        exchange(&mut c.self_type, st);
    }
    load_file(&mut c, file);
    exchange(&mut c.file, file);
    exchange(&mut c.pos, pos);
    exchange(&mut c.raw, raw);
    exchange(&mut c.module, module);
    exchange(&mut c.host_optin, u64(host_opted(&c, view(c.module))));
    func(&mut c, 4, 0);
    exchange(&mut c.inherent, 0);
    exchange(&mut c.self_type, NO_TYPE);
    if generic_impl != 0 {
        exchange(&mut c.current_impl, 0);
    }
    return ();
}
fn emit_specializations<a>(c: (&a mut C)) -> unit {
    // Validate even unused templates with affine, opaque type variables. Discard only
    // generated code; failed checking still aborts before publishing any output.
    count := c.funcs.len();
    exchange(&mut c.validating, 1);
    for i in count {
        f := &c.funcs[i];
        types := f.types;
        contract := f.contract;
        mut owner = f.module.copy();
        // A template this run instantiates is replayed here even when another module owns it: that
        // replay is the check the caller owes the instantiation, and it is what refuses a generic
        // instantiated on a type the caller may not share. Only the *code* belongs to the owner.
        mut check = !iface_owned(&mut c, view(owner));
        if !check {
            check = instantiated(&mut c, i);
        }
        if (types != 0) & (contract == 0) & check {
            saved := c.out.len();
            part_mark := c.part.copy();
            part_lpart := c.lpart.copy();
            part_lunit := c.lunit;
            part_label := c.label;
            part_ref := c.ref_next;
            replay_function(&mut c, i);
            c.out.truncate(saved);
            exchange(&mut c.part, part_mark);
            exchange(&mut c.lpart, part_lpart);
            exchange(&mut c.label, part_label);
            exchange(&mut c.ref_next, part_ref);
            c.lunit = part_lunit;
            if (part_lunit != 0) & (part_lunit <= c.lnext.len()) {
                c.lnext[part_lunit - 1] = part_label;
                c.rnext[part_lunit - 1] = part_ref;
            }
        }
    }
    exchange(&mut c.validating, 0);
    drain_specs(&mut c, 0);
    return ();
}
// Emits the specialisations requested from `from` onward - including any requested while emitting
// them - and returns how many there are. Closures and specialisations can each request the other,
// so the caller alternates this with emit_closures until neither list grows.
fn drain_specs<a>(c: (&a mut C), from: u64) -> u64 {
    mut i = from;
    while i < c.specs.len() {
        spec := &c.specs[i];
        template := spec.template;
        // Every run emits the specialisations its own code asks for, whichever module defines the
        // template - replayed from that module's interface when its source is not part of this run.
        // The body is weak and content-addressed, so every object that asks for one key emits the
        // same body under the same name and the linker keeps one (B1 stage 4).
        // One definition per key, not per entry in `c.specs`: two interned argument lists can
        // describe the same type - a capturing closure whose environment record was synthesised
        // twice has the same captures and a different declaration index - and the key is what
        // decides identity, so the first emission serves both. The call sites already reference the
        // same symbol, so emitting twice would be a duplicate definition.
        if spec_taken(&mut c, i) != 0 {
            i = i + 1;
            continue;
        }
        mut args = type_args_for_spec(&mut c, i);
        mut bindings = u64[];
        for j in args.len() {
            base := args[j];
            identity := c.alias_next;
            exchange(&mut c.alias_next, identity + 1);
            alias := intern_full(&mut c, 10, base, identity, u64[]);
            bindings.push(alias);
        }
        exchange(&mut c.bindings, bindings);
        exchange(&mut c.current_spec, i + 1);
        exchange(&mut c.spec_closures, 0);
        replay_function(&mut c, template);
        exchange(&mut c.bindings, u64[]);
        exchange(&mut c.current_spec, 0);
        i = i + 1;
    }
    return i;
}
// True when this module's surface and bodies came from an interface rather than from a file on the
// command line: its code belongs to its own object.
fn iface_owned<a, b>(c: (&a mut C), m: &b [u8]) -> bool {
    for i in c.iface_used.len() {
        if same(view(c.iface_used[i]), view(m)) {
            return true;
        }
    }
    return false;
}
// True when this run instantiates that template, so its body has to be replayed here even if the
// module that defines it is another object.
fn instantiated<a>(c: (&a mut C), template: u64) -> bool {
    for i in c.specs.len() {
        if c.specs[i].template == template {
            return true;
        }
    }
    return false;
}
fn type_args_for_spec<a>(c: (&a mut C), index: u64) -> u64[] {
    spec := &c.specs[index];
    mut out = u64[];
    for i in spec.args.len() {
        out.push(spec.args[i]);
    }
    return out;
}
// Whether the method call whose `.` is at `dot` has a plain local receiver (`c.m(...)`) that one
// of its arguments names; c.pos is just past the `(`.
fn receiver_read_by_args<a>(c: (&a mut C), dot: u64) -> bool {
    if dot < 2 {
        return false;
    }
    if (kind_at(&mut c, dot - 1) != 1) || (kind_at(&mut c, dot - 2) == 46) || (kind_at(&mut c, dot - 2) == 260) {
        return false;
    }
    root := tok_text(&mut c, dot - 1);
    if find_local(&mut c, view(root)) == 0 {
        return false;
    }
    ranges := argument_ranges(&mut c);
    if ranges.len() < 3 {
        return false;
    }
    close := ranges[ranges.len() - 1];
    for q in c.pos..close {
        if (kind_at(&mut c, q) == 1) && same(view(tok_text(&mut c, q)), view(root)) {
            return true;
        }
    }
    return false;
}
// The token range [start, end) of each argument of the call whose `(` was just read, then the
// position of its `)`, flattened: start0, end0, start1, end1, ..., close. Empty when the list
// cannot be scanned simply: a closure holds commas of its own (`|a, b|`), and `|` is also the
// bitwise-or operator, so a list holding one is not split here - `call` then reads it positionally.
fn argument_ranges<a>(c: (&a mut C)) -> u64[] {
    mut out = u64[];
    mut depth = 0;
    mut at = c.pos;
    mut begin = at;
    while true {
        k := kind_at(&mut c, at);
        if k == 0 {
            return u64[];
        }
        if (k == 124) || (k == 274) {
            return u64[];
        }
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        } else if (k == 41) || (k == 93) || (k == 125) {
            if depth == 0 {
                out.push(begin);
                out.push(at);
                out.push(at);
                return out;
            }
            depth -= 1;
        } else if (k == 44) && (depth == 0) {
            out.push(begin);
            out.push(at);
            begin = at + 1;
        }
        at += 1;
    }
    return out;
}
// The parameter of function `f` named `name`, 1-based, or 0 when the declaration has none.
fn param_slot<a, b>(c: (&a C), f: u64, name: &b [u8]) -> u64 {
    info := &c.funcs[f - 1];
    for i in info.pnames.len() {
        if same(view(info.pnames[i]), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
// The name of parameter `p` of function `f`, for a diagnostic that has to point at a parameter.
fn param_name<a>(c: (&a C), f: u64, p: u64) -> u8[] {
    info := &c.funcs[f - 1];
    if p < info.pnames.len() {
        return info.pnames[p].copy();
    }
    mut out = u8[];
    decimal(&mut out, p);
    return out;
}
// The parameter each written argument fills, one entry per argument in written order: the slot a
// named argument names, or the next parameter after the previous positional one. Every refusal the
// argument list owes is made here, before any argument compiles, so a call that names one parameter
// wrongly is reported once instead of after five arguments have emitted code.
fn call_slots<a, b, d>(c: (&a mut C), f: u64, ranges: (&b u64[]), base: u64, callee: &d [u8]) -> u64[] {
    count := c.funcs[f - 1].count;
    // Copied out: the scan below holds `c` mutably, and a loan of the declaration would forbid it.
    names := copy_names(&c.funcs[f - 1].pnames);
    n := (ranges.len() - 1) / 2;
    mut out = u64[];
    // Which parameters the call already has a value for: the receiver's slot, and each argument read
    // so far, so a repeated name is caught where it is written.
    mut used = u64[];
    for i in count {
        used.push(0);
    }
    for i in base {
        exchange(&mut used[i], 1);
    }
    mut next = base;
    mut named = 0;
    for i in n {
        at := ranges[2 * i];
        end := ranges[2 * i + 1];
        mut slot = next;
        // `name: value` - an identifier and one colon. `::` is a path, not a name.
        mut named_here = 0;
        if at + 1 < end {
            if kind_at(&mut c, at) == 1 {
                if kind_at(&mut c, at + 1) == 58 {
                    named_here = 1;
                }
            }
        }
        if named_here != 0 {
            name := tok_text(&mut c, at);
            slot = param_slot(&c, f, view(name));
            if slot == 0 {
                mut msg = copy_bytes(view("no parameter named `"));
                push_bytes(&mut msg, view(name));
                push_bytes(&mut msg, view("` in `"));
                push_bytes(&mut msg, view(callee));
                push_bytes(&mut msg, view("`"));
                mut help = copy_bytes(view("its parameters are "));
                for j in names.len() {
                    if j != 0 {
                        push_bytes(&mut help, view(", "));
                    }
                    push_bytes(&mut help, view("`"));
                    push_bytes(&mut help, view(names[j]));
                    push_bytes(&mut help, view("`"));
                }
                if names.len() == 0 {
                    push_bytes(&mut help, view("none"));
                }
                diag_help(&mut c, view(help));
                exchange(&mut c.pos, at);
                fail(&mut c, view(msg));
            }
            slot -= 1;
            if slot < base {
                mut msg = copy_bytes(view("parameter `"));
                push_bytes(&mut msg, view(name));
                push_bytes(&mut msg, view("` of `"));
                push_bytes(&mut msg, view(callee));
                push_bytes(&mut msg, view("` is the receiver, which the call already supplies"));
                exchange(&mut c.pos, at);
                fail(&mut c, view(msg));
            }
            named = 1;
        } else if named != 0 {
            exchange(&mut c.pos, at);
            fail(&mut c, view("a positional argument cannot follow a named one: write the named arguments last, or name this one too"));
        } else {
            next += 1;
        }
        if slot < count {
            if used[slot] != 0 {
                mut msg = copy_bytes(view("parameter `"));
                push_bytes(&mut msg, view(names[slot]));
                push_bytes(&mut msg, view("` of `"));
                push_bytes(&mut msg, view(callee));
                push_bytes(&mut msg, view("` is given twice"));
                exchange(&mut c.pos, at);
                fail(&mut c, view(msg));
            }
            exchange(&mut used[slot], 1);
        }
        // A pair per argument: the parameter it fills, and 1 when the source reads `name: value` (so
        // the parse below starts at the value, after the colon).
        out.push(slot);
        out.push(named_here);
    }
    return out;
}
// The order to take the arguments in: unchanged (empty) unless an argument is `&mut path` and
// another argument mentions the path's root, in which case such arguments go last.
// The dotted fields of an argument that is a plain `&mut x` or `&mut x.f.g` - a path with no call
// or index, so taking its address later changes nothing but the loan's start - or empty when the
// argument is anything else.
fn mut_path<a, b>(c: (&a mut C), ranges: (&b u64[]), i: u64) -> u8[][] {
    a := ranges[2 * i];
    b := ranges[2 * i + 1];
    mut simple = (b >= a + 3) && (kind_at(&mut c, a) == 38) && is_at(&mut c, a + 1, view("mut")) && (kind_at(&mut c, a + 2) == 1);
    mut q = a + 3;
    while simple && (q < b) {
        if (kind_at(&mut c, q) == 46) && (q + 1 < b) && (kind_at(&mut c, q + 1) == 1) {
            q += 2;
        } else {
            simple = false;
        }
    }
    mut path = u8[][];
    if !simple {
        return path;
    }
    path.push(tok_text(&mut c, a + 2));
    mut p = a + 3;
    while p < b {
        path.push(tok_text(&mut c, p + 1));
        p += 2;
    }
    return path;
}
// 1 when argument `i` names `root` as a plain identifier anywhere among its tokens.
fn argument_mentions<a, b, d>(c: (&a mut C), ranges: (&b u64[]), i: u64, root: &d [u8]) -> bool {
    start := ranges[2 * i];
    end := ranges[2 * i + 1];
    for q in start..end {
        if (kind_at(&mut c, q) == 1) && same(view(tok_text(&mut c, q)), view(root)) {
            return true;
        }
    }
    return false;
}
// 1 when argument `i` names a place that overlaps `path`: a dotted path in it that `path` is a
// prefix of, or that is a prefix of `path`, since a loan of one then covers the other. `c.r[i]`
// counts as `c.r`, and a sibling field (`c.g` against `c.f`) does not overlap.
fn path_mentioned<a, b, d>(c: (&a mut C), ranges: (&b u64[]), i: u64, path: (&d u8[][])) -> bool {
    start := ranges[2 * i];
    end := ranges[2 * i + 1];
    root := path[0].copy();
    mut q = start;
    while q < end {
        if (kind_at(&mut c, q) == 1) && same(view(tok_text(&mut c, q)), view(root)) {
            mut j = 1;
            mut r = q + 1;
            mut mismatch = false;
            while (j < path.len()) & !mismatch {
                if (kind_at(&mut c, r) == 46) && (kind_at(&mut c, r + 1) == 1) {
                    if same(view(tok_text(&mut c, r + 1)), view(path[j])) {
                        j += 1;
                        r += 2;
                    } else {
                        mismatch = true;
                    }
                } else {
                    break;
                }
            }
            if !mismatch {
                return true;
            }
            q = r;
        } else {
            q += 1;
        }
    }
    return false;
}
fn two_phase_order<a, b>(c: (&a mut C), ranges: (&b u64[])) -> u64[] {
    if ranges.len() < 5 {
        return u64[];
    }
    n := (ranges.len() - 1) / 2;
    mut late = u64[];
    mut roots = u8[][];
    for i in n {
        path := mut_path(&mut c, ranges, i);
        if path.len() != 0 {
            root := path[0].copy();
            late.push(i);
            roots.push(root);
        }
    }
    if late.len() == 0 {
        return u64[];
    }
    // Only when another argument reads the same root: everywhere else the order stays as written.
    mut needed = false;
    for j in late.len() {
        for i in n {
            if i != late[j] {
                if argument_mentions(&mut c, ranges, i, view(roots[j])) {
                    needed = true;
                }
            }
        }
    }
    if !needed {
        return u64[];
    }
    mut order = u64[];
    for i in n {
        mut is_late = false;
        for j in late.len() {
            if late[j] == i {
                is_late = true;
            }
        }
        if !is_late {
            order.push(i);
        }
    }
    for j in late.len() {
        order.push(late[j]);
    }
    return order;
}
fn call<a, b, d>(c: (&a mut C), m: &b [u8], name: &d [u8]) -> Val {
