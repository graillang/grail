        }
    }
    if is(&mut c, view("(")) {
        if same(view(first), view("f64")) {
            if (find_local(&mut c, view(first)) == 0)
                & (find_func(&mut c, view(m), view(first)) == 0) {
                advance(&mut c);
                value := expr(&mut c, 0);
                expect(&mut c, view(")"));
                source := value.ty;
                ty := float_type(&mut c);
                if is_float(&mut c, source) {
                    return val(value.t, ty);
                }
                if !integer(&mut c, source) {
                    fail(&mut c, view("f64 conversion needs an integer or f64"));
                }
                from := int_code(&mut c, source);
                fv := imm(&mut c, from);
                // A signed source, or an unsigned one narrower than the word, is a non-negative or
                // sign-extended i64: one conversion. A u64 above 2^63 needs the runtime's halving.
                if float_inline(&c) && ((((from / 256) & 1) != 0) || ((from & 255) < 64)) {
                    return val(float_emit(&mut c, 130, value.t, 0), ty);
