    for i in c.tnames.len() {
        t := &c.tnames[i];
        if same(view(t), view(first)) {
            if (i < c.type_bounds.len()) && ((c.type_bounds[i] & 4) != 0) {
                fail(&mut c, view("this is a value parameter, not a type"));
