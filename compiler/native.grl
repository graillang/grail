// Bindings authorize writes to owned storage; explicit mutable capabilities authorize
// writes through their referents, without making the capability binding reassignable.
fn binding_mode<a>(c:ref<a,C>,slot:num)->num{
 for i in len(c.locals){entry :=vec_get(c.locals,i);id :=entry.id;mutable :=entry.mutable;if id==slot{return mutable+1;}}return 0;
}
fn require_mutable_binding<a>(c:ref_mut<a,C>,slot:num,storage:num)->unit{
 if c.raw{return ();}var current=slot;var depth=0;
 while depth<len(c.resources)+1{
 index :=resource(borrow_mut(c),current);
 if index!=0{var r =vec_get(c.resources,index-1);ty :=r.ty;place :=r.place;authority :=r.authority;base :=r.base;
 k :=ty_kind(borrow_mut(c),ty);mode :=ty_mode(borrow_mut(c),ty);
 if (k==7)&(place!=0){if mode{return ();}fail(borrow_mut(c),read("mutation through readonly reference"));}
 if (k==5)&(storage==0){if mode{return ();}fail(borrow_mut(c),read("mutation through readonly view"));}
 if authority!=0{a :=resource(borrow_mut(c),authority-1);if a!=0{info :=vec_get(c.resources,a-1);at :=info.ty;if ty_kind(borrow_mut(c),at)==7{if ty_mode(borrow_mut(c),at){return ();}fail(borrow_mut(c),read("mutation through readonly frame"));}}}
 binding :=binding_mode(borrow(c),current);if binding==1{fail(borrow_mut(c),read("owned storage mutation requires var"));}if binding==2{return ();}
 if base==0{return ();}current=base-1;
 }else{binding :=binding_mode(borrow(c),current);if binding==1{fail(borrow_mut(c),read("owned storage mutation requires var"));}return ();}depth=depth+1;
 }
 fail(borrow_mut(c),read("invalid mutation provenance"));return ();
}
fn require_write<a>(c:ref_mut<a,C>,slot:num)->unit {
