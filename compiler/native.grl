fn literal_value<a, b>(c: (&a mut C), t: &b [u8]) -> u64 {
    mut radix = 10;
    mut i = 0;
    if 2 < t.len() {
        if t[0] == 48 {
            r := t[1];
            if r == 120 {
                radix = 16;
                i = 2;
            }
            if r == 98 {
                radix = 2;
                i = 2;
            }
            if r == 111 {
                radix = 8;
                i = 2;
            }
