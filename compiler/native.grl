// Current cursor is the key expression, after '['. Find the outer closing bracket.
fn index_assignment_operator<a>(c: (&a mut C)) -> u64 {
    mut q = c.pos;
    mut depth = 0;
    while true {
        k := kind_at(&mut c, q);
        if k == 0 {
            fail(&mut c, view("unclosed map index assignment"));
        }
        if k == 91 {
            depth += 1;
        }
        if k == 93 {
            if depth == 0 {
                return q + 1;
            }
            depth -= 1;
        }
        q += 1;
    }
    return 0;
}

fn mutating_method_name<a>(c: (&a mut C), name: &a [u8], elem: u64) -> u64 {
    builtin := u8[][copy_bytes(view("push")), copy_bytes(view("pop")), copy_bytes(view("insert")), copy_bytes(view("remove")), copy_bytes(view("clear")), copy_bytes(view("truncate")), copy_bytes(view("append")), copy_bytes(view("sort")), copy_bytes(view("reverse")), copy_bytes(view("swap")), copy_bytes(view("extend")), copy_bytes(view("get_mut")), copy_bytes(view("entry")), copy_bytes(view("retain"))];
    for i in builtin.len() {
        if same(view(builtin[i]), view(name)) {
            return 1;
        }
    }
    // A user method of the element's own type whose receiver is `self: &mut ...`.
    for i in c.funcs.len() {
        f := &c.funcs[i];
        if (f.owner != 0) & (f.count != 0) & same(view(f.name), view(name)) {
            first := f.first;
            owner := f.owner;
            pty := c.params[first];
            if (ty_kind(&mut c, pty) == 7) & (ty_mode(&mut c, pty) != 0) & (elem != 0) {
                if (ty_kind(&mut c, elem) == 8) & (ty_arg(&mut c, elem) == owner - 1) {
                    return 1;
                }
            }
        }
    }
    return 0;
}
// At `[`: whether the matching `]` is followed by `(.field)*.method(` with a mutating method.
fn mutating_call_after_index<a>(c: (&a mut C), elem: u64) -> u64 {
    mut q = c.pos;
    mut depth = 0;
    while true {
        k := kind_at(&mut c, q);
        if (k == 0) || (k == 59) {
            return 0;
        }
        if k == 91 {
            depth = depth + 1;
        }
        if k == 93 {
            depth = depth - 1;
            if depth == 0 {
                break;
            }
        }
        q = q + 1;
    }
    q = q + 1;
    while (kind_at(&mut c, q) == 46) & (kind_at(&mut c, q + 1) == 1) {
        if kind_at(&mut c, q + 2) == 40 {
            name := tok_text(&mut c, q + 1);
            return mutating_method_name(&mut c, view(name), elem);
        }
        q = q + 2;
    }
    return 0;
}
// 1 + write mode when the next argument is exactly a reference/view binding (`name` followed by
// `,` or `)`), else 0.
fn reborrow_argument<a>(c: (&a mut C)) -> u64 {
