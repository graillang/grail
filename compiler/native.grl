module native;
use lexer;
use host;
use explain;
use ownership;
use machine;
use optimize;
use llvm;
use cli;

// Direct Linux native compiler: one checked word stream, target instruction selection in machine.grl.
// Usage: native OUT.s ENTRY.grl [MODULE.grl...]. The first public function of the
// first file is the entry; it takes nothing or argv[1] as a byte view. Move/initialization
// checks, loans/lifetimes, captured-storage writeback and deterministic drops are active.
// Generic types/functions use typed specialization. Include runtime.grl as source.
// Type ids: 0 u64, 1 unit, 2 bytes, 3 string, 4 view; others are interned below. Id 0 is a real
// type, so no id can mean "no type": `NO_TYPE` answers that, and every site that asks whether a
// type is known asks it directly instead of keeping a second flag beside the id (NO_TYPE below).
// Type kinds: 1 u64, 2 unit, 3 bytes, 4 string, 5 view, 6 vec(arg), 7 ref(arg),
// 8 named(decl, args), 9 opaque template parameter, 10 opaque bound parameter (arg, identity),
// 11 Atomic<u64>, 12 capture-free typed function pointer, 13 Mutex<T>, 14 Scope<C>, 15 interface proof,
// 16 Task<R>, 17 CancelToken, 18 sized integer (arg bits, mode signed), 19 bool, 20 closure Fn(..)->R, 21 f64,
// 22 char, 23 opaque foreign handle (arg = decl), 24 CStr, 25 cfn pointer, 26 bare C pointer,
// 27 slice (arg = element, mode 1 writable), 28 byval(extern record),
// 29 job (arg = result): a running pool job handle. Move-only, like Task<R>, and its drop waits.
// 33 interface object `dyn I` (arg = interface id): one word, a heap cell {value, vtable}; the
//    vtable is {drop, method 0, method 1, ...} for the concrete type (dyn_box, emit_vtables).
// 30 associated-type projection `T::Item` (arg = T, mode = interface id * 1024 + associated index):
//    only ever over a type parameter; binding T to a concrete type resolves it (project).
// 35 borrowed interface object marker: the referent of the kind-7 reference a `&dyn I` is (arg = the
//    `dyn` type, kind 33). A `&dyn I` value is one word, a handle to a 16-byte {data, vtable} pair in
//    the frame that built it (borrow_dyn): building one allocates nothing, and dispatch loads the
//    entry from the pair's vtable (call_typed), exactly as an owned `dyn I` does through its cell.

// ---- the "no type" sentinel ----------------------------------------------------------------------
// A type is an index into `c.types`, interned on demand: id 0 is u64, 1 unit, 2 bytes, 3 string,
// 4 view (the five every compile seeds, in `main`), so every id is a real type and an id can never
// also mean "no type". `NO_TYPE` is that answer instead: a value no table can hold, so one id
// carries both the answer and whether there is one, and no site needs a `found`/`have` flag beside
// it. Every `== 0` on a type id means u64 and only u64; every "is there a type?" is
// `== NO_TYPE`, and an accessor refuses a sentinel rather than indexing the table with it.
const NO_TYPE: u64 = 18446744073709551615;
// Two more values above the id space are pseudo-types, not ids: a compile-time target tag such as
// `.windows` (ct_tag_ty), and a constant whose value a compile-time call has not produced yet
// (ct_pending). Neither is ever an index into `c.types`.
const CT_TAG: u64 = 18446744073709551614;
const CT_PENDING: u64 = 18446744073709551613;
// Whether an id names a type a table can be indexed by. The three sentinels above are not types.
fn is_type_id(ty: u64) -> bool {
    return ty < CT_PENDING;
}

struct Tok {
    kind: u64,
    start: u64,
    end: u64
}
struct Ty {
    kind: u64,
    arg: u64,
    mode: u64,
    regions: u64[],
    args: u64[],
    // A closure (kind 20) is the only type whose behaviour depends on the values it carries: the
    // environment record (kind 8) holding its captures, or 0 for a capture-free `Fn(..)` signature.
    // It is part of the interned identity, because two closures with one signature but different
    // captures are different types, and a capability check has to reach the captures.
    env: u64
}
struct Decl {
    module: u8[],
    name: u8[],
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    is_enum: u64,
    // 1 for `handle Name;`: a one-word opaque foreign handle, not a layout.
    opaque: u64,
    // The audited foreign-resource contract of a `handle` (docs/ffi.md): may a value cross to
    // another thread (`transfer`), and may it be used concurrently (`share`)? Both default to 0, so
    // a handle nothing has been declared about is thread-affine - the safe answer for a foreign
    // resource we have not audited. Ignored for every non-handle declaration.
    transfer: u64,
    share: u64,
    // 1 for `extern record`: fields use C layout (natural alignment, padding).
    c_layout: u64,
    first: u64,
    count: u64,
    // 1 when an `impl Drop` in this program applies to every instantiation of this declaration: the
    // user's `drop` runs at the head of the type's compiler-generated drop helper. Asked about every
    // type `emit_drops` walks, so it is a per-declaration bit rather than a scan of the impl table.
    drop: u64,
    regions: u64,
    types: u64,
    success: u64,
    bounds: u64[],
    constraints: u64[][]
}
struct Import {
    module: u8[],
    name: u8[]
}
struct Alias {
    module: u8[],
    name: u8[],
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    ty: u64
}
struct Field {
    name: u8[],
    ty: u64,
    // `field: T where P`: the field's predicate, or no_pred() when it has none.
    pred: Pred
}
// A refinement predicate, kept as a token range in the file it was written in (docs/design/
// refinements.md). The range is never parsed where it is written: the obligation compiles the
// expression where the value enters, with the names bound to the values there.
struct Pred {
    // The file the tokens are in: a source file, or the virtual source an interface carries.
    file: u64,
    lo: u64,
    hi: u64
}
fn no_pred() -> Pred {
    return Pred { file: 0, lo: 0, hi: 0 };
}
fn copy_preds<a>(p: (&a Pred[])) -> Pred[] {
    mut out = Pred[];
    for i in p.len() {
        item := &p[i];
        out.push(Pred { file: item.file, lo: item.lo, hi: item.hi });
    }
    return out;
}
fn has_pred<a>(p: (&a Pred)) -> bool {
    return p.hi != 0;
}
struct Func {
    module: u8[],
    name: u8[],
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    // The source module that declared it (`module` is a synthetic owner for methods).
    home: u8[],
    first: u64,
    count: u64,
    ret: u64,
    types: u64,
    regions: u64,
    file: u64,
    pos: u64,
    raw: u64,
    // 1 for `unsafe fn`: its body is checked one unsafe level down, and a call to it from safe code
    // outside an `unsafe` block is refused.
    unsafe_fn: u64,
    bounds: u64[],
    constraints: u64[][],
    contract: u64,
    owner: u64,
    // 1 when this is an `extern "C"` declaration: no body, and `symbol` is the
    // linker-visible C name (unmangled).
    ext: u64,
    symbol: u8[],
    // The source text of a generic template's declaration, captured at the declaration pass so the
    // interface can carry it (B1 stage 3). Empty for everything else: only a template is replayed.
    body: u8[],
    // `p: T where P`, one per parameter in order, and `-> T ensures P` for the result.
    ppreds: Pred[],
    rpred: Pred,
    // The parameters' source names, parallel to `ppreds`: a call site needs them to put the
    // arguments' terms in the predicate's place, and an interface carries the ones a predicate uses.
    pnames: u8[][],
    // `@strict` before this declaration. It stays with the declaration, so a specialisation and a
    // body replayed from an interface are compiled in the mode the source asked for - not in
    // whatever mode the file that happens to instantiate them was scanned in.
    strict: u64,
    // 1 for `@no_alloc` and `@no_panic`: claims the compiler proves of the body and of everything it
    // calls (docs/design/effects.md). An interface carries them, so a caller in another module
    // relies on the definition's own proof.
    no_alloc: u64,
    no_panic: u64
}
struct Interface {
    module: u8[],
    name: u8[],
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    defined: u64,
    methods: u64[],
    // Per method, parallel to `methods`: the `fn` token of a default body + 1 (0: none), and the
    // file it is in. An implementation that leaves the method out gets this body (default_methods).
    defaults: u64[],
    default_files: u64[],
    // Associated types (`type Item;`), by index, and the interfaces each must implement
    // (`type Item: Ord;`).
    assoc: u8[][],
    assoc_bounds: u64[][],
    // `interface B: A + C`: interfaces every implementation of this one also implements.
    supers: u64[]
}
struct Implementation {
    contract: u64,
    ty: u64,
    module: u8[],
    methods: u64[],
    // Where `impl` is written + 1 (0: read from an interface file), for diagnostics.
    file: u64,
    pos: u64,
    // `type Item = u64;`: the associated types it gives, by name.
    assoc_names: u8[][],
    assoc_types: u64[]
}
struct Closure {
    decl: u64,
    start: u64,
    file: u64,
    module: u8[],
    captures: u8[][],
    names: u8[][],
    params: u64[],
    ret: u64,
    symbol: u8[],
    tnames: u8[][],
    bindings: u64[],
    // Lifetimes the parameters introduced (`|x: &T|`): regions 2.. of the closure's own namespace.
    regions: u64,
    // The captures the body writes, one flag per entry of `captures`. Only a written capture is
    // mutable in the body, and a closure with any written capture is `FnMut` (mode 1), not `Fn`.
    written: u64[],
    // A closure created while a specialisation is replayed belongs to that specialisation: every
    // object that emits the specialisation emits it too, under the same name, weak (B1 stage 4).
    weak: u64,
    // The part (module) its body is emitted into.
    unit: u8[],
    mode: u64
}
struct ImplParams {
    decl: u64,
    rnames: u8[][],
    tnames: u8[][],
    bounds: u64[],
    interfaces: u64[][],
    // The self type this implementation's parameters build, or NO_TYPE until iface_impl_self
    // builds it: the id says whether it exists, so there is no second flag to keep in step.
    self_ty: u64
}
struct Constant {
    module: u8[],
    name: u8[],
    // 0 when declared without `pub`: private to `module` (separate-compilation.md, "Visibility").
    public: u64,
    ty: u64,
    value: u64,
    text: u8[]
}
struct Spec {
    template: u64,
    args: u64[],
    first: u64,
    ret: u64,
    // The module whose body instantiated the template: the one that references this symbol.
    requester: u8[]
}
// flex: an untyped integer literal binding (`x := 5`) whose uses adopt their context's integer
// type; lit/neg hold the literal. A mutable one settles at its first assignment.
// origin: declared from a bare literal (name token at `at`); a committed one may still learn its
// type from a later sized use, which recompiles the function with a hint.
struct Local {
    name: u8[],
    ty: u64,
    id: u64,
    last: u64,
    born: u64,
    mutable: u64,
    flex: u64,
    lit: u64,
    neg: u64,
    origin: u64,
    at: u64
}
struct Val {
    t: u64,
    ty: u64
}
struct Resource {
    slot: u64,
    ty: u64,
    flag: u64,
    base: u64,
    field: u64,
    via: u64,
    place: u64,
    target: u64,
    authority: u64
}
struct Bond {
    holder: u64,
    loan: u64,
    guard: u64
}
struct Origin {
    place: u64,
    region: u64
}
// A loan held by a C pointer made from Grail storage (`cptr`/`cptr_mut`): `at` is the token of the
// `cptr` that took it, so a conflict can say which pointer is still live.
struct Pointer {
    loan: u64,
    at: u64,
    writable: u64
}
struct Member {
    base: u64,
    field: u64,
    place: u64
}
struct DebugVar {
    name: u8[],
    slot: u64,
    line: u64,
    param: u64,
    // DWARF base type of the value in the 8-byte slot: name, DW_ATE encoding, byte size.
    tname: u8[],
    tenc: u64,
    tsize: u64,
    // The variable's full DWARF type: an index into c.debug_types.
    ty: u64
}
// One DWARF type of the program's debug information. kind 0 is a base type (enc, size); 1 a
// pointer to `pointee`; 2 a structure of `size` bytes with `members`.
struct DebugType {
    name: u8[],
    kind: u64,
    enc: u64,
    size: u64,
    pointee: u64,
    members: DebugMember[]
}
struct DebugMember {
    name: u8[],
    ty: u64,
    offset: u64
}
struct DebugSite {
    file: u64,
    line: u64,
    start: u64,
    end: u64,
    params: u64
}
struct DebugFunc {
    name: u8[],
    module: u8[],
    file: u64,
    line: u64,
    start: u64,
    end: u64,
    params: u64,
    vars: DebugVar[],
    // The label namespace this function's start and end labels were minted in (B1 stage 5): every
    // label is `.L<unit>_<n>`, so a table that names a label by its number alone would name one the
    // unit never emitted. Captured where the function is recorded, i.e. inside its own unit.
    unit: u8[]
}
// One module of the program, as an interface sees it.
struct IModule {
    module: u8[],
    path: u8[],
    // 1 when the file sits in the standard-library directory (it compiles in the stdlib's modes).
    std: u64,
    // 1 for `unsafe module ...` (the runtime and the platform modules).
    unsafe: u64,
    // 1 when the module declared `use host;`.
    host: u64
}
// Declared before `C` because the typed-IR fact walker (docs/design/refinements.md) keeps a list of
// them in the per-compile state: a fact is a comparison, a divisibility or a float class over named
// terms.
struct Atom {
    // 0 `<`, 1 `<=`, 2 `==`, 3 `%`, 4 `finite`, 5 `nan`.
    rel: u64,
    a: u8[],
    b: u8[],
    k: i64
}
struct C {
    src: u8[],
    toks: Tok[],
    pos: u64,
    out: u8[],
    // 1 (--split): mark module boundaries in `out` and write one assembly file per module.
    split: u64,
    // 1 (--separate): this run's code is one object of a program, not a program: every definition
    // becomes global so the linker can bind across objects. One file, and its own site table.
    separate: u64,
    // The module of the run being emitted, so a marker opens a run only when the module changes.
    part: u8[],
    // The label namespace of that unit: every label it mints is `.L<lpart>_<n>`, from a counter that
    // starts at 1 for each unit, so a unit's emitted text never depends on what was emitted before
    // it. The counters live per unit (`lunits`, `lnext`, `rnext`) rather than in one field, because
    // emission can leave a unit and come back - a specialisation requested mid-body is emitted after
    // the requesting function - and a reset on the way back would mint the same numbers twice.
    lpart: u8[],
    // 1-based index into `lunits` of the unit being emitted, or 0 before the first one.
    lunit: u64,
    lunits: u8[][],
    lnext: u64[],
    rnext: u64[],
    // Where the markers ended up in the optimized stream, and the module each names.
    marks: u64[],
    part_names: u8[][],
    module: u8[],
    target: u64,
    plat: u64,
    // Emit .file/.loc DWARF line info (Linux x86-64 native output only).
    debug: u64,
    // 1: lower the raw word stream to LLVM IR (compiler/llvm.grl) instead of optimize/machine.
    backend: u64,
    // Typed-IR facts for that lifter (docs/design/typed-ir.md). They travel beside `out`, never in
    // it: an absent fact means the untyped word lowering, so no stream change can affect
    // optimize.grl, machine.grl or the native backend.
    facts: llvm::Facts,
    // Body symbol of the function being emitted; facts are keyed by it.
    facts_fn: u8[],
    // Ordinal of the next `call rt_f64_op` in the function being emitted, and of the one most
    // recently emitted (its site, which knows the opcode, records the fact after the call).
    f64_ops: u64,
    call_ord: u64,
    // F1: per-callee call counters and the ordinal of the call just emitted, which is the key a
    // call-argument fact carries (docs/design/typed-ir.md).
    f1_names: u8[][],
    f1_counts: u64[],
    f1_ord: u64,
    // 1 with --verify-facts: the lifter checks every word a fact treats as an f32, and every word
    // it treats as a sequence header.
    verify_facts: u64,
    // 1 with --range-facts: the LLVM lifter derives range facts and removes the bounds check a
    // fact proves redundant (docs/design/typed-ir.md). Off by default; see that document for why.
    range_facts: u64,
    no_sites: u64,
    // --f1-what=N: a test aid that records a deliberately wrong F1 kind for every binding, so the
    // checks --verify-facts emits can be shown to fire (docs/design/typed-ir.md, "Tests that catch
    // a wrong fact"). 0, the default, records the type the front end actually has.
    f1_what: u64,
    debug_funcs: DebugFunc[],
    debug_vars: DebugVar[],
    debug_types: DebugType[],
    arg_offset: u64,
    overflow: u64,
    // The bool/integer rule is always enforced; 1 is the survey mode (`--strict-bool-report`).
    strict_bool_report: u64,
    exports: u8[][],
    export_hits: u64[],
    specs: Spec[],
    bindings: u64[],
    current_spec: u64,
    // Closures created so far by the specialisation being replayed: their names are ordinals within it.
    spec_closures: u64,
    validating: u64,
    // Named-parameter count of the variadic extern call being lowered; 0 otherwise.
    ffi_fixed: u64,
    // Slots holding the address of a narrow (non-8-byte or f32) C-layout record field, paired
    // with the field type: stores and compound loads through them use the field's width.
    caddr: u64[],
    // An exported callback's float result: 0 none, 1 f64, 2 f32 (returned in xmm0/d0/fa0).
    export_fret: u64,
    // Set for one cfield_load: another `.field` projection follows this one.
    cfield_more: u64,
    alias_next: u64,
    types: Ty[],
    decls: Decl[],
    aliases: Alias[],
    imports: Import[],
    fields: Field[],
    funcs: Func[],
    params: u64[],
    locals: Local[],
    next: u64,
    entry: u64,
    file: u64,
    label: u64,
    brk: u64,
    cont: u64,
    raw: u64,
    // Lexical `unsafe { ... }` depth. Foreign calls are rejected at depth 0.
    unsafe_depth: u64,
    // Set by a leading `unsafe` on a top-level item (`unsafe fn`, `unsafe struct ...`), consumed by
    // the declaration that owns it, so the hatch applies to one item at a time.
    pending_unsafe: u64,
    // 1 while the operand of a `return` is being checked: `p.as_ref()` may only be returned, since
    // the borrow it makes takes the function's result lifetime.
    in_return: u64,
    // Set while an operand of `cptr`/`cptr_mut` is being checked, so a borrow conflict inside it
    // is reported as the C aliasing it is. 1 for `cptr` (read-only), 2 for `cptr_mut` (writable).
    cptr_address: u64,
    // (slot, type) pairs for the proxy slots an embedded record's place uses: the slot holds the
    // address of bytes interior to its container, so writing through the place replaces those bytes
    // instead of storing a pointer into them.
    embedded: u64[],
    // Linker inputs declared by `extern "C" lib "..."`, deduplicated in order.
    libs: u8[][],
    // Set while an `extern "C" fn` definition is handed to the function parser:
    // 2 means C-callable with the given unmangled symbol.
    pending_ext: u64,
    pending_symbol: u8[],
    // Slot holding the host TLS base inside an exported function's body, or 0.
    export_tls: u64,
    export_adopt: u64,
    // The pass a module-level compile-time form runs in (0 inside a function body).
    ct_pass: u64,
    ct_in_if: bool,
    // `pub` on the declaration being parsed (1 for anything the compiler synthesises), and 1 while
    // the compiler reads interfaces or looks names up for itself, which skips the visibility check.
    decl_public: u64,
    vis_off: u64,
    // Set when a compile-time expression read a value parameter that is not bound yet.
    ct_unbound: u64,
    // site_pos's position cache (file, byte offset, line, column).
    site_file: u64,
    site_off: u64,
    site_line: u64,
    site_col: u64,
    // `--comptime-probe`: this compile builds the probe program for a compile-time call (C3).
    probe_mode: u64,
    // `@for f in fields(T)` bindings in scope, innermost last: name, decl, field index.
    ct_loop_names: u8[][],
    ct_loop_decls: u64[],
    ct_loop_index: u64[],
    // Set once a compile used `@embed`, which reads a file the build cache does not key on.
    embed_used: u64,
    // Several errors per compile (docs/diagnostics.md): the bodies an earlier run of this compile
    // already reported an error in, as file index and position pairs, skipped here; and the body
    // being checked now, which an error in it adds to that list.
    skip_bodies: u64[],
    body_file: u64,
    body_pos: u64,
    // The diagnostics this compile has already printed, as `file:line:column:message` keys carried
    // by `--reported` from one re-run to the next. A replayed generic body that reaches the same
    // error again is silent, and it counts once (docs/diagnostics.md).
    reported: u8[][],
    // Copy-backs for `p: &mut R` callback parameters: (C pointer slot, copy slot, bytes) triples.
    export_copyback: u64[],
    rnames: u8[][],
    tnames: u8[][],
    closures: Closure[],
    fn_thunk_used: u64,
    closure_env: u64,
    // What the next closure literal is expected to be (closure_hint): its parameter types and result,
    // each NO_TYPE when not known yet.
    hint_params: u64[],
    hint_ret: u64,
    // Whether closure_hint set a hint at all. Not a "is there a type" flag: every element of the
    // hint says NO_TYPE itself; this says whether a hint was given, which a hint that fixes nothing
    // does not tell apart from no hint.
    hint_set: u64,
    inherent: u64,
    constants: Constant[],
    impl_params: ImplParams[],
    receiver: u64,
    // The receiver type of the call being compiled, or NO_TYPE before it is prepared: id 0 is u64,
    // so a default of 0 would read as a u64 receiver.
    receiver_ty: u64,
    has_receiver: u64,
    // The next record() builds a tuple positionally.
    positional: u64,
    // A `&mut self` receiver call() borrows after its arguments (has_receiver 3).
    lazy_input: u64,
    // An operand whose call is deferred (`lazy_input`): its type, or NO_TYPE before it is taken.
    lazy_inty: u64,
    lazy_xty: u64,
    lit_start: u64,
    lit_end: u64,
    lit_value: u64,
    hints: u64[],
    tolerant: u64,
    retry: u64,
    attempts: u64,
    cf_start: u64,
    cf_end: u64,
    cf_local: u64,
    bce_index: u8[],
    bce_base: u8[],
    // The refinements of the function being compiled: its parameters' predicates and its `ensures`,
    // the source name of the declaration (a specialisation is reported under its template's name),
    // where it is written, and the serial that keeps each obligation's data labels apart.
    cur_ppreds: Pred[],
    cur_rpred: Pred,
    // The token range of the body being compiled: the facts the prover reads at a program point
    // start at its `{`. Zero inside a closure, where no enclosing function's facts hold.
    body_lo: u64,
    body_hi: u64,
    // The typed-IR fact walker (docs/design/refinements.md): `pv_on` says this body is maintaining
    // facts as it is compiled, `pv_facts` holds
    // the ones that hold at the current point, `pv_marks` and `pv_trmarks` one entry per open block,
    // `pv_trail` the atoms a binding's shadowing kill removed (they come back when the block that
    // made the binding closes), and `pv_pending` what a condition, a guard or an arm's pattern
    // states for the block about to open.
    pv_on: u64,
    pv_facts: Atom[],
    pv_marks: u64[],
    pv_trmarks: u64[],
    pv_trail: Atom[],
    pv_pending: Atom[],
    // Strict refinements (docs/design/refinements.md): `--strict-refinements` for the whole program,
    // `@strict;` for a module (it stays with the module's name, so a replayed body keeps it), and
    // `@strict` on a declaration for the function that follows.
    strict_refinements: u64,
    strict_modules: u8[][],
    strict_next: u64,
    // The mode this body is compiled in: the declaration's `@strict`, or its template's when the
    // body is a specialisation or a replay.
    strict_here: u64,
    cur_name: u8[],
    cur_file: u64,
    cur_pos: u64,
    ref_next: u64,
    lit_negative: u64,
    // Span of the most recent byte read (`bytes[i]`): an untyped word known to be 0..255.
    byte_start: u64,
    byte_end: u64,
    flit_start: u64,
    flit_end: u64,
    flit_tok: u64,
    flit_neg: u64,
    type_bounds: u64[],
    type_interfaces: u64[][],
    interfaces: Interface[],
    implementations: Implementation[],
    // The type `Self` names inside the `impl` being parsed, or NO_TYPE outside one. The id itself
    // says whether there is a `Self`: no separate flag, no +1 offset to keep it clear of u64.
    self_type: u64,
    current_impl: u64,
    // Functions default_methods copied into an implementation from its interface.
    default_copies: u64[],
    // The current signature's associated-type equalities (param, interface*1024+index, type), and
    // every function's, by function index (func_eqs: index, param, mode, type).
    assoc_eqs: u64[],
    func_eqs: u64[],
    // `dyn I` objects this object builds: (interface, concrete type) pairs, and the interfaces
    // named as `dyn`, whose object safety check_interfaces checks.
    vtables: u64[],
    dyn_ifaces: u64[],
    headers_complete: u64,
    resources: Resource[],
    loopmark: u64,
    // The result type of the function whose body is being compiled, or NO_TYPE before any signature
    // has been read. Id 0 is u64, so a default of 0 would read as a u64 result.
    result: u64,
    check: ownership::State,
    members: Member[],
    terminated: u64,
    loopcheck: ownership::State,
    breaks: ownership::State,
    hasbreak: u64,
    bonds: Bond[],
    pointers: Pointer[],
    origins: Origin[],
    scope_end: u64,
    loop_start: u64,
    loop_end: u64,
    no_union: u64,
    // Set while the operand of `ignore_failure(...)` is evaluated: a join outcome may be dropped
    // there and nowhere else (docs/design/task-failure-containment.md).
    ignored_failure: u64,
    parsing_input: u64,
    output_region: u64,
    receiver_region: u64,
    input_regions: u64[],
    none_start: u64,
    none_end: u64,
    deny_ambient: u64,
    host_optin: u64,
    host_modules: u8[][],
    // Capability diagnostics for the parallel surface (docs/design/parallelism.md): the reason code
    // of the first denied leaf and the field path that reached it. `capability_begin` resets both,
    // so a rejection names the offending field instead of repeating the whole type.
    cap_denial: u64,
    cap_segs: u8[][],
    // Checked module interfaces (B1 stage 2, docs/design/separate-compilation.md). `iface_dir` is
    // the directory interfaces are read from, `iface_emit` the one they are written to, and
    // `iface_verify` asks for a declaration-by-declaration comparison with the sources instead of
    // trusting either side. Nothing here changes the whole-program path when all three are off.
    iface_dir: u8[],
    iface_use: u8[],
    no_entry: u64,
    iface_used: u8[][],
    // The module whose body is being compiled right now, and the modules whose requested
    // specialisations this run emits (B1 stage 3).
    body_module: u8[],
    // The built-in `Drop` interface (`builtin_drop_interface`) and how many `impl Drop`s are generic
    // (an implementation no declaration's `drop` bit can answer for).
    drop_iface: u64,
    drop_generic: u64,
    // Every type a drop call names. emit_drops emits a helper for each of these as well as for every
    // interned type, so a reference can never outrun its definition.
    drop_refs: u64[],
    drop_names: u8[][],
    spec_emitted: u8[][],
    spell_lenient: u64,
    spell_failed: u64,
    drop_emitted: u8[][],
    iface_emit: u8[],
    iface_verify: u64,
    // Every module the program loaded, in command-line order, with what its interface records about
    // the file it came from.
    iface_list: IModule[],
    // Interfaces read with `--use`, waiting for their definition sweep.
    iface_loaded: u8[][],
    iface_loaded_path: u8[][],
    // Environment records (module `.closure`) the surface being emitted reaches, and the name each
    // is given inside the interface, so a reader can rebuild a closure type's captures exactly.
    iface_env: u64[],
    iface_env_names: u8[][],
    // Sources that did not come from the command line: a generic body an interface carried is
    // registered here as a file, so `load_file` and every diagnostic treat it like any other file.
    virt_path: u8[][],
    virt_text: u8[][],
    // The link inputs each module's `extern "C" lib "..."` declarations ask for. `libs` stays
    // program-wide (that is what the stream carries); this attributes them to a module so an
    // interface can re-request them.
    // Extra context for the next error (G11): secondary labels at other source positions, and
    // `help:` lines under the source excerpt. Set just before `fail`.
    diag_labels: DiagLabel[],
    diag_help: u8[][],
    // Text under the primary span (`expected `u64`, found `string``).
    diag_primary: u8[],
    lib_owner: u8[][],
    // ---- checked effects (G26, docs/design/effects.md) --------------------------------------------
    // One record per emitted body or read declaration: the claim `@no_alloc`/`@no_panic` makes, the
    // call edges the emitter recorded as it wrote the body, and the facts the fixpoint settles.
    fx_any: u64,
    fx_cur: u64,
    fx_syms: u8[][],
    fx_body: u64[],
    fx_attr_alloc: u64[],
    fx_attr_panic: u64[],
    fx_own_alloc: u64[],
    fx_own_panic: u64[],
    fx_alloc: u64[],
    fx_panic: u64[],
    fx_alloc_thru: u64[],
    fx_panic_thru: u64[],
    fx_fn_name: u8[][],
    fx_fn_file: u64[],
    fx_fn_pos: u64[],
    fx_edge_from: u64[],
    fx_edge_name: u8[][],
    fx_edge_to: u64[],
    fx_edge_kind: u64[],
    fx_edge_file: u64[],
    fx_edge_pos: u64[],
    fx_pending_alloc: u64,
    fx_pending_panic: u64,
    fx_bounded: u64,
    // Where the body being recorded starts in `c.out`, whether it is trusted code (the runtime, a drop
    // helper), how many calls it has recorded, and the byte range of its `.proved` entry's replayed
    // prologue: bytes `fx_end`'s consistency check skips, because the checked entry already counted
    // them.
    fx_out_start: u64,
    fx_trusted: u64,
    fx_calls: u64,
    fx_skip_lo: u64,
    fx_skip_hi: u64,
    // A refined parameter's check in the checked entry: the caller's obligation, not a body edge.
    fx_entry_panic: u64[],
    // Where the body's edge list started, so a retried body's discarded edges go with its bytes.
    fx_edge_mark: u64
}

fn same<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn div(n: u64, d: u64) -> u64 {
    mut q = 0;
    mut r = n;
    while !(r < d) {
        mut m = d;
        mut k = 1;
        while true {
            if 9223372036854775807 < m {
                break;
            }
            if r < m + m {
                break;
            }
            m = m + m;
            k = k + k;
        }
        r = r - m;
        q = q + k;
    }
    return q;
}

// ---- output ----
fn o<a, b>(c: (&a mut C), s: &b [u8]) -> unit {
    for i in s.len() {
        c.out.push(s[i]);
    }
    return ();
}
fn on<a>(c: (&a mut C), n: u64) -> unit {
    if 9 < n {
        on(&mut c, div(n, 10));
    }
    c.out.push(48 + n % 10);
    return ();
}
// Escape a path for an assembler .file directive (quotes and backslashes).
fn emit_path<a, b>(c: (&a mut C), path: &b [u8]) -> unit {
    for i in path.len() {
        b := path[i];
        if (b == 92) || (b == 34) {
            c.out.push(92);
        }
        c.out.push(b);
    }
    return ();
}

// ---- per-module emission (B1 stage 1) ----
// `--split` writes one assembly file per module instead of one for the whole program. Emission stays
// a single stream, because the whole-program optimizer, generic specialisation and closure lowering
// all reach across modules; the stream is split after lowering, at the boundaries recorded here. A
// marker line opens a run of one module's code and carries the `.text` directive that starts its
// file. Markers are top-level lines, so optimize copies them through untouched and reports where
// they landed; the parts minus those markers are the single-file stream, which is what
// tools/split-test.mjs checks.
// The label namespace of an emission unit: its own name with anything that is not an identifier
// character replaced by '_', then eight hex digits of a hash of the name. Labels are file-local, so
// one file holding several units needs the prefix to keep them apart - and a unit's text must not
// depend on the units before it, which is what the per-unit counter (reset in `part`) gives.
fn unit_prefix<a>(name: &a [u8]) -> u8[] {
    mut out = u8[];
    for i in name.len() {
        b := name[i];
        if ((97 <= b) & (b <= 122)) || ((65 <= b) & (b <= 90)) || ((48 <= b) & (b <= 57)) || (b == 95) {
            out.push(b);
        } else {
            out.push(95);
        }
    }
    out.push(95);
    // A 32-bit hash kept below 2^32 so the multiply cannot overflow a checked build.
    mut h: u64 = 2166136261;
    for i in name.len() {
        h = (h * 131 + u64(name[i])) % 4294967291;
    }
    mut at: u64 = 28;
    loop {
        d := (h >> at) & 15;
        if d < 10 {
            out.push(48 + d);
        } else {
            out.push(87 + d);
        }
        if at == 0 {
            break;
        }
        at -= 4;
    }
    return out;
}
// 1 when the optimizer runs, so emission units are named in the stream it reads. `--debug` and the
// other backends read the stream untouched, so they get no marker and no label namespace.
fn unit_markers<a>(c: (&a C)) -> u64 {
    if (c.debug != 0) | (c.backend != 0) {
        return 0;
    }
    return 1;
}
fn part<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    if same(view(c.part), view(name)) {
        // Still the same module: the run continues, and its file already has its `.text`.
        return ();
    }
    c.part = name.copy();
    c.lpart = unit_prefix(view(name));
    mut k = 0;
    while k < c.lunits.len() {
        if same(view(c.lunits[k]), view(name)) {
            break;
        }
        k += 1;
    }
    if k == c.lunits.len() {
        c.lunits.push(name.copy());
        c.lnext.push(1);
        c.rnext.push(0);
    }
    c.lunit = k + 1;
    c.label = c.lnext[k];
    c.ref_next = c.rnext[k];
    if unit_markers(&c) != 0 {
        // The marker states the unit's name (what `--split` names a file after) and the label
        // prefix its code mints (what the optimizer has to recognise as this unit's labels).
        prefix := c.lpart.copy();
        o(&mut c, view(".grail_part "));
        o(&mut c, name);
        c.out.push(32);
        o(&mut c, view(prefix));
        c.out.push(10);
        if c.split != 0 {
            o(&mut c, view(".text\n"));
        }
    }
    // Each module's literals start eight-aligned, in one file as in parts: a part object's section
    // is aligned on its own, so the single build pads where the split link will. Only an ELF build
    // is split, so only it needs the pad; a Mach-O build leaves the section to its literals, because
    // an empty pad must not bring one into being (`.rodata` is not a section name there at all).
    if c.plat == 0 {
        o(&mut c, view(".pushsection .rodata\n.p2align 3\n.popsection\n"));
    }
    return ();
}
// Decimal digits of a synthetic module suffix plus one, or 0 when the suffix is not a number.
fn module_index<a>(name: &a [u8], from: u64) -> u64 {
    if name.len() <= from {
        return 0;
    }
    mut n = 0;
    mut i = from;
    while i < name.len() {
        d := name[i];
        if (d < 48) || (57 < d) {
            return 0;
        }
        n = n * 10 + (d - 48);
        i += 1;
    }
    return n + 1;
}
// The source module of an emission unit. `.impl_N` and `.inherent_N` are mangling names for one
// declaration inside a file, not modules a build could name, so they resolve to the module that
// file declares; every other name is already the module.
fn unit_module<a, b>(c: (&a mut C), m: &b [u8]) -> u8[] {
    if starts_with(view(m), view(".impl_")) {
        // `.impl_K` is written from c.current_impl, which is 1-based (0 means none), so it names
        // implementations[K - 1]; module_index returns K + 1.
        n := module_index(view(m), 6);
        if (1 < n) & (n - 1 <= c.implementations.len()) {
            return c.implementations[n - 2].module.copy();
        }
    }
    if starts_with(view(m), view(".inherent_")) {
        n := module_index(view(m), 10);
        if (n != 0) & (n <= c.decls.len()) {
            return c.decls[n - 1].module.copy();
        }
    }
    return m.copy();
}
// A part file name: `STEM.NNN.module.s`, numbered in stream order so the manifest order is also the
// order `ls` shows. Characters that are not identifier-safe become '_' (a module name is an
// identifier, so this only guards against a name that failed to resolve).
fn part_file<a, b, d>(stem: &a [u8], seq: u64, name: &b [u8], ext: &d [u8]) -> u8[] {
    mut out = stem.copy();
    out.push(46);
    if seq < 10 {
        push_bytes(&mut out, view("00"));
    } else {
        if seq < 100 {
            out.push(48);
        }
    }
    decimal(&mut out, seq);
    out.push(46);
    for i in name.len() {
        b := name[i];
        if ((97 <= b) & (b <= 122)) || ((65 <= b) & (b <= 90)) || ((48 <= b) & (b <= 57)) || (b == 95) {
            out.push(b);
        } else {
            out.push(95);
        }
    }
    push_bytes(&mut out, view(ext));
    return out;
}
// `PATH.s` -> `PATH`: the stem the part files and the manifest are named from.
fn path_stem<a>(path: &a [u8]) -> u8[] {
    mut n = path.len();
    if (n > 1) & (path[n - 1] == 115) & (path[n - 2] == 46) {
        n = n - 2;
    }
    mut out = u8[];
    for i in n {
        out.push(path[i]);
    }
    return out;
}
// Write the parts of one lowered image plus the manifest the driver reads back: the part files in
// link order, then the `// grail-link:` request that a single-file build carries at the head of its
// assembly. The optimizer reported where each marker landed, so a part is written as a slice of the
// stream — splitting costs no copy — and every run already starts with its own `.text` directive.
fn write_parts<a, b, d>(c: (&a mut C), path: &b [u8], text: &d [u8]) -> u64 {
    stem := path_stem(view(path));
    mut files = u8[][];
    mut status: u64 = 0;
    for k in c.marks.len() {
        // Past the `.grail_part` line: the run begins at the `.text` directive under it. The offset
        // is found rather than computed, so the marker line may carry more than the module name.
        mut start = c.marks[k];
        while (start < text.len()) & (text[start] != 10) {
            start += 1;
        }
        start += 1;
        mut end = text.len();
        if k + 1 < c.marks.len() {
            end = c.marks[k + 1];
        }
        if end > start {
            file := part_file(view(stem), files.len(), view(c.part_names[k]), view(".s"));
            if host::write_file(view(file), view((text[start: end]))) != 0 {
                status = 1;
            }
            files.push(file);
        }
    }
    if files.len() == 0 {
        fail(&mut c, view("--split produced no module output"));
    }
    mut manifest = copy_bytes(view("// grail-parts 1\n"));
    for i in files.len() {
        push_bytes(&mut manifest, view(files[i]));
        manifest.push(10);
    }
    for i in c.libs.len() {
        push_bytes(&mut manifest, view("// grail-link: "));
        push_bytes(&mut manifest, view(c.libs[i]));
        manifest.push(10);
    }
    mut manifest_path = u8[];
    push_bytes(&mut manifest_path, view(stem));
    push_bytes(&mut manifest_path, view(".parts"));
    if host::write_file(view(manifest_path), view(manifest)) != 0 {
        status = 1;
    }
    return status;
}
// The one assembly write point: the whole-program image when --split is off, one file per module
// plus a manifest when it is on.
fn write_image<a, b, d>(c: (&a mut C), path: &b [u8], image: &d [u8]) -> u64 {
    if c.split != 0 {
        return write_parts(&mut c, view(path), view(image));
    }
    return host::write_file(view(path), view(with_link_notes(&c.libs, view(image))));
}
fn contains_text<a, b>(text: &a [u8], needle: &b [u8]) -> bool {
    if needle.len() > text.len() {
        return false;
    }
    mut i = 0;
    while i + needle.len() <= text.len() {
        mut j = 0;
        mut ok = 1;
        while j < needle.len() {
            if text[i + j] != needle[j] {
                ok = 0;
            }
            j += 1;
        }
        if ok != 0 {
            return true;
        }
        i += 1;
    }
    return false;
}
// `.loc` before a literal section switch is dropped by the assembler, so re-assert the last
// source location after every `.popsection`. This keeps the first statement of a function on the
// line table even when it starts by pushing a string literal.
fn debug_locs<a>(text: &a [u8]) -> u8[] {
    mut out = u8[];
    mut loc = u8[];
    mut line = u8[];
    for i in text.len() {
        b := text[i];
        line.push(b);
        if b == 10 {
            if starts_with(view(line), view(".loc ")) || starts_with(view(line), view(".cv_loc ")) {
                mut fresh = u8[];
                for k in line.len() {
                    fresh.push(line[k]);
                }
                exchange(&mut loc, fresh);
            }
            for k in line.len() {
                out.push(line[k]);
            }
            if contains_text(view(line), view(".popsection")) {
                for k in loc.len() {
                    out.push(loc[k]);
                }
            }
            exchange(&mut line, u8[]);
        }
    }
    if line.len() != 0 {
        for k in line.len() {
            out.push(line[k]);
        }
    }
    return out;
}
fn source_line<a>(c: &a C, pos: u64) -> u64 {
    mut line = 1;
    if c.toks.len() <= pos {
        return line;
    }
    st := c.toks[pos].start;
    for i in st {
        if c.src[i] == 10 {
            line += 1;
        }
    }
    return line;
}
// ---- DWARF .debug_info emission (Linux x86-64) ----
fn dput<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
    return ();
}
fn dnum<a>(out: (&a mut u8[]), n: u64) -> unit {
    if 9 < n {
        dnum(&mut out, div(n, 10));
    }
    out.push(48 + n % 10);
    return ();
}
fn duleb<a>(out: (&a mut u8[]), n: u64) -> unit {
    dput(&mut out, view(".uleb128 "));
    dnum(&mut out, n);
    dput(&mut out, view("\n"));
    return ();
}
fn dpath<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    for i in text.len() {
        b := text[i];
        if (b == 92) || (b == 34) {
            out.push(92);
        }
        out.push(b);
    }
    return ();
}
fn dstring<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    dput(&mut out, view(".asciz \""));
    dpath(&mut out, text);
    dput(&mut out, view("\"\n"));
    return ();
}
fn dattr<a>(out: (&a mut u8[]), code: u64, form: u64) -> unit {
    dput(&mut out, view(".uleb128 "));
    dnum(&mut out, code);
    dput(&mut out, view("\n.uleb128 "));
    dnum(&mut out, form);
    dput(&mut out, view("\n"));
    return ();
}
// Raw SLEB128 bytes for a negative value -n (n > 0), using exact floor division.
fn sleb_neg<a>(out: (&a mut u8[]), n: u64) -> unit {
    mut v: i64 = 0 - i64(n);
    while true {
        mut b: i64 = v % 128;
        if b < 0 {
            b = b + 128;
        }
        v = (v - b) / 128;
        if ((v == 0) && (b < 64)) || ((v == i64(0) - i64(1)) && (64 <= b)) {
            out.push(u64(b));
            return ();
        }
        out.push(u64(b + 128));
    }
}
// DW_OP_fbreg with a SLEB128 -offset, where offset is the rbp slot distance.
fn dlocation<a>(out: (&a mut u8[]), slot: u64) -> unit {
    mut expr = u8[];
    expr.push(145);
    sleb_neg(&mut expr, (slot + 1) * 8);
    duleb(&mut out, expr.len());
    for i in expr.len() {
        dput(&mut out, view(".byte "));
        dnum(&mut out, expr[i]);
        dput(&mut out, view("\n"));
    }
    return ();
}
// DWARF base types for a Grail value held in an 8-byte slot. Integers, floats, bool and char
// are exact (all targets are little-endian, so a narrow value's bytes start the slot; an f32
// slot holds the binary64 word of its value and is described as an 8-byte float); a
// string, record or other owned value is shown as its 8-byte handle, named after its type.
fn debug_type_name<a>(c: (&a mut C), ty: u64) -> u8[] {
    mut out = u8[];
    if ty == 0 {
        push_bytes(&mut out, view("u64"));
        return out;
    }
    k := ty_kind(&mut c, ty);
    if k == 18 {
        if ty_mode(&mut c, ty) != 0 {
            out.push(105);
        } else {
            out.push(117);
        }
        decimal(&mut out, ty_arg(&mut c, ty));
        return out;
    }
    if k == 21 {
        if is_f32(&mut c, ty) {
            push_bytes(&mut out, view("f32"));
        } else {
            push_bytes(&mut out, view("f64"));
        }
        return out;
    }
    if k == 19 {
        push_bytes(&mut out, view("bool"));
        return out;
    }
    if k == 22 {
        push_bytes(&mut out, view("char"));
        return out;
    }
    if k == 3 {
        push_bytes(&mut out, view("string"));
        return out;
    }
    if k == 8 {
        d := ty_arg(&mut c, ty);
        push_bytes(&mut out, view(c.decls[d].name));
        return out;
    }
    push_bytes(&mut out, view("word"));
    return out;
}
fn debug_type_encoding<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 7;
    }
    k := ty_kind(&mut c, ty);
    if k == 18 {
        if ty_mode(&mut c, ty) != 0 {
            return 5;
        }
        return 7;
    }
    if k == 21 {
        return 4;
    }
    if k == 19 {
        return 2;
    }
    if k == 22 {
        return 16;
    }
    return 7;
}
fn debug_type_size<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    if k == 18 {
        return ty_arg(&mut c, ty) / 8;
    }
    // An f32 value is held as the binary64 word of its value, so its slot reads as a double.
    if k == 22 {
        return 4;
    }
    return 8;
}
// The DWARF type of a value of Grail type `ty`, added to c.debug_types once (by name, kind and size)
// and returned as its index. A string, byte sequence or vector is a pointer to the runtime's 24-byte
// header {data, len, cap}, with `data` typed so a debugger prints the text or the elements; a Grail
// record is a pointer to its fields, one 8-byte word each; an extern "C" record is a pointer to its C
// layout, embedded records inline. A record that mentions itself is entered before its members, so
// the recursion ends. `c_layout` 1 describes a field of a C record (its C size, not a word).
fn debug_type_add<a>(c: (&a mut C), t: DebugType) -> u64 {
    for i in c.debug_types.len() {
        e := &c.debug_types[i];
        if same(view(e.name), view(t.name)) & (e.kind == t.kind) & (e.size == t.size) {
            return i;
        }
    }
    c.debug_types.push(t);
    return c.debug_types.len() - 1;
}
fn debug_base<a, b>(c: (&a mut C), name: &b [u8], enc: u64, size: u64) -> u64 {
    return debug_type_add(&mut c, DebugType { name: copy_bytes(name), kind: 0, enc: enc, size: size, pointee: 0, members: DebugMember[] });
}
fn debug_pointer<a>(c: (&a mut C), to: u64) -> u64 {
    mut name = copy_bytes(view("*"));
    push_bytes(&mut name, view(c.debug_types[to].name));
    return debug_type_add(&mut c, DebugType { name: name, kind: 1, enc: 0, size: 8, pointee: to, members: DebugMember[] });
}
fn debug_header<a, b>(c: (&a mut C), name: &b [u8], data: u64) -> u64 {
    word := debug_base(&mut c, view("u64"), 7, 8);
    mut members = DebugMember[];
    members.push(DebugMember { name: copy_bytes(view("data")), ty: debug_pointer(&mut c, data), offset: 0 });
    members.push(DebugMember { name: copy_bytes(view("len")), ty: word, offset: 8 });
    members.push(DebugMember { name: copy_bytes(view("cap")), ty: word, offset: 16 });
    s := debug_type_add(&mut c, DebugType { name: copy_bytes(name), kind: 2, enc: 0, size: 24, pointee: 0, members: members });
    return debug_pointer(&mut c, s);
}
fn debug_type_of<a>(c: (&a mut C), ty: u64, c_layout: u64) -> u64 {
    if ty == 0 {
        return debug_base(&mut c, view("u64"), 7, 8);
    }
    k := ty_kind(&mut c, ty);
    if (k == 3) || (k == 4) {
        text := debug_base(&mut c, view("char"), 8, 1);
        mut name = copy_bytes(view("string"));
        if k == 4 {
            name = copy_bytes(view("u8[]"));
        }
        return debug_header(&mut c, view(name), text);
    }
    if k == 6 {
        // Vector elements are 8-byte words: an element type narrower than a word would make a
        // debugger step through them at the wrong stride, so such elements read as words.
        elem := ty_arg(&mut c, ty);
        mut et = debug_type_of(&mut c, elem, 0);
        if (c.debug_types[et].kind == 0) & (c.debug_types[et].size != 8) {
            et = debug_base(&mut c, view("u64"), 7, 8);
        }
        mut name = debug_type_name(&mut c, elem);
        push_bytes(&mut name, view("[]"));
        return debug_header(&mut c, view(name), et);
    }
    if (k == 8) & (is_c_record(&mut c, ty) != 0) {
        d := ty_arg(&mut c, ty);
        name := c.decls[d].name.copy();
        size := ffi_record_size(&mut c, d);
        // Entered first, empty, so a field that names this record finds it; a record already entered
        // (or being filled further up this recursion) is not described twice.
        before := c.debug_types.len();
        s := debug_type_add(&mut c, DebugType { name: name, kind: 2, enc: 0, size: size, pointee: 0, members: DebugMember[] });
        if s < before {
            return debug_pointer(&mut c, s);
        }
        mut members = DebugMember[];
        count := c.decls[d].count;
        for i in count {
            fty := field_ty(&mut c, d, i);
            off := ffi_offset(&mut c, d, i);
            fname := c.fields[c.decls[d].first + i].name.copy();
            mut mt = 0;
            if is_c_record(&mut c, fty) != 0 {
                inner := debug_type_of(&mut c, fty, 1);
                mt = c.debug_types[inner].pointee;
            } else {
                mt = debug_type_of(&mut c, fty, 1);
            }
            members.push(DebugMember { name: fname, ty: mt, offset: off });
        }
        exchange(&mut c.debug_types[s].members, members);
        return debug_pointer(&mut c, s);
    }
    // `&` evaluates both sides, so the record test is nested: c.decls is indexed only for kind 8.
    mut plain_record = false;
    if k == 8 {
        rd := ty_arg(&mut c, ty);
        plain_record = c.decls[rd].is_enum == 0;
    }
    if plain_record {
        d := ty_arg(&mut c, ty);
        name := c.decls[d].name.copy();
        count := c.decls[d].count;
        before := c.debug_types.len();
        s := debug_type_add(&mut c, DebugType { name: name, kind: 2, enc: 0, size: 8 * count, pointee: 0, members: DebugMember[] });
        if s < before {
            return debug_pointer(&mut c, s);
        }
        mut members = DebugMember[];
        for i in count {
            fty := field_ty(&mut c, d, i);
            members.push(DebugMember { name: c.fields[c.decls[d].first + i].name.copy(), ty: debug_type_of(&mut c, fty, 0), offset: 8 * i });
        }
        exchange(&mut c.debug_types[s].members, members);
        return debug_pointer(&mut c, s);
    }
    if (c_layout != 0) & (k == 21) {
        // A C float field is a real binary32 (a Grail f32 slot holds the binary64 of its value).
        if is_f32(&mut c, ty) {
            return debug_base(&mut c, view("float"), 4, 4);
        }
    }
    if k == 5 {
        // A view: a pointer into someone else's bytes, and a length.
        text := debug_base(&mut c, view("char"), 8, 1);
        word := debug_base(&mut c, view("u64"), 7, 8);
        mut members = DebugMember[];
        members.push(DebugMember { name: copy_bytes(view("data")), ty: debug_pointer(&mut c, text), offset: 0 });
        members.push(DebugMember { name: copy_bytes(view("len")), ty: word, offset: 8 });
        return debug_type_add(&mut c, DebugType { name: copy_bytes(view("view")), kind: 2, enc: 0, size: 16, pointee: 0, members: members });
    }
    if k == 7 {
        // A reference is the address of its referent's slot.
        referent := ty_arg(&mut c, ty);
        inner := debug_type_of(&mut c, referent, 0);
        return debug_pointer(&mut c, inner);
    }
    if (k != 18) & (k != 19) & (k != 21) & (k != 22) {
        // Enums, closures, handles, maps and the rest: described as the word they occupy until
        // they get a layout of their own here.
        return debug_base(&mut c, view("u64"), 7, 8);
    }
    name := debug_type_name(&mut c, ty);
    enc := debug_type_encoding(&mut c, ty);
    size := debug_type_size(&mut c, ty);
    return debug_base(&mut c, view(name), enc, size);
}
fn record_debug_func<a, b, d>(c: (&a mut C), name: &b [u8], module: &d [u8], site: &DebugSite) -> unit {
    mut vars = DebugVar[];
    for i in c.debug_vars.len() {
        l := &c.debug_vars[i];
        vars.push(
            DebugVar {
                name: copy_bytes(view(l.name)),
                slot: l.slot,
                line: l.line,
                param: l.param,
                tname: copy_bytes(view(l.tname)),
                tenc: l.tenc,
                tsize: l.tsize,
                ty: l.ty
            }
        );
    }
    c
        .debug_funcs
        .push(
            DebugFunc {
                name: copy_bytes(view(name)),
                module: copy_bytes(view(module)),
                file: site.file,
                line: site.line,
                start: site.start,
                end: site.end,
                params: site.params,
                vars: vars,
                unit: copy_bytes(view(c.lpart))
            }
        );
    return ();
}
fn cv_label<a>(out: (&a mut u8[]), name: &a [u8], i: u64, j: u64) -> unit {
    push_bytes(&mut out, view(".Lcv"));
    push_bytes(&mut out, name);
    decimal(&mut out, i);
    out.push(95);
    decimal(&mut out, j);
    return ();
}
// A CodeView symbol record: the 2-byte length, then kind and body up to a 4-byte boundary.
fn cv_record_start<a>(out: (&a mut u8[]), i: u64, j: u64, kind: u64) -> unit {
    push_bytes(&mut out, view(".short "));
    cv_label(&mut out, view("e"), i, j);
    out.push(45);
    cv_label(&mut out, view("s"), i, j);
    out.push(10);
    cv_label(&mut out, view("s"), i, j);
    push_bytes(&mut out, view(":\n.short "));
    decimal(&mut out, kind);
    out.push(10);
    return ();
}
fn cv_record_end<a>(out: (&a mut u8[]), i: u64, j: u64) -> unit {
    push_bytes(&mut out, view(".p2align 2\n"));
    cv_label(&mut out, view("e"), i, j);
    push_bytes(&mut out, view(":\n"));
    return ();
}
// ---- CodeView type records (.debug$T), built from c.debug_types ----
// Predefined CodeView index for a base type.
fn cv_base(t: &DebugType) -> u64 {
    if t.enc == 4 {
        if t.size == 4 {
            return 64;
        }
        return 65;
    }
    if t.enc == 2 {
        return 48;
    }
    if t.enc == 16 {
        return 123;
    }
    if t.enc == 8 {
        // T_RCHAR: text bytes, shown as characters.
        return 112;
    }
    if t.enc == 5 {
        if t.size == 1 { return 16; }
        if t.size == 2 { return 17; }
        if t.size == 4 { return 116; }
        return 19;
    }
    if t.size == 1 { return 32; }
    if t.size == 2 { return 33; }
    if t.size == 4 { return 117; }
    return 35;
}
fn cv_short(out: &mut u8[], v: u64) -> unit {
    push_bytes(&mut out, view(".short "));
    decimal(&mut out, v);
    out.push(10);
    return ();
}
fn cv_long(out: &mut u8[], v: u64) -> unit {
    push_bytes(&mut out, view(".long "));
    decimal(&mut out, v);
    out.push(10);
    return ();
}
fn cv_name(out: &mut u8[], name: &[u8]) -> unit {
    push_bytes(&mut out, view(".asciz \""));
    push_bytes(&mut out, view(name));
    push_bytes(&mut out, view("\"\n"));
    return ();
}
// LF_PADn bytes taking `used` up to a multiple of four.
fn cv_pad(out: &mut u8[], used: u64) -> unit {
    mut left = (4 - used % 4) % 4;
    while left > 0 {
        push_bytes(&mut out, view(".byte "));
        decimal(&mut out, 240 + left);
        out.push(10);
        left = left - 1;
    }
    return ();
}
// A numeric leaf: the value itself below 0x8000, else LF_ULONG and four bytes. Returns its size.
fn cv_numeric(out: &mut u8[], v: u64) -> u64 {
    if v < 32768 {
        cv_short(&mut out, v);
        return 2;
    }
    cv_short(&mut out, 32772);
    cv_long(&mut out, v);
    return 6;
}
fn cv_numeric_size(v: u64) -> u64 {
    if v < 32768 {
        return 2;
    }
    return 6;
}
// LF_STRUCTURE: `fwd` 1 for a forward reference (property 0x80, no field list, size 0).
fn cv_structure(out: &mut u8[], count: u64, fields: u64, size: u64, name: &[u8], fwd: u64) -> unit {
    payload := 2 + 2 + 2 + 4 + 4 + 4 + cv_numeric_size(size) + name.len() + 1;
    cv_short(&mut out, payload + (4 - (2 + payload) % 4) % 4);
    cv_short(&mut out, 5381);
    cv_short(&mut out, count);
    cv_short(&mut out, 128 * fwd);
    cv_long(&mut out, fields);
    cv_long(&mut out, 0);
    cv_long(&mut out, 0);
    cv_numeric(&mut out, size);
    cv_name(&mut out, name);
    cv_pad(&mut out, 2 + payload);
    return ();
}
// The type stream. Indices start at 0x1000 in emission order: every structure's forward reference,
// then every pointer (its pointee comes earlier in c.debug_types, so its index is known), then each
// structure's field list followed by its full definition. A pointer to a structure names the
// forward reference, which a debugger resolves by name to the definition - so a record that
// contains a pointer to itself is described without a cycle in the stream.
fn codeview_types<a>(c: &a C, index: (&mut u64[])) -> u8[] {
    mut out = u8[];
    push_bytes(&mut out, view(".section .debug$T,\"dr\"\n.p2align 2\n.long 4\n"));
    n := c.debug_types.len();
    mut fwd = u64[];
    mut next = 4096;
    for i in n {
        index.push(0);
        fwd.push(0);
    }
    for i in n {
        t := &c.debug_types[i];
        if t.kind == 0 {
            index[i] = cv_base(&t);
        }
        if t.kind == 2 {
            cv_structure(&mut out, 0, 0, 0, view(t.name), 1);
            fwd[i] = next;
            next = next + 1;
        }
    }
    for i in n {
        t := &c.debug_types[i];
        if t.kind == 1 {
            mut to = index[t.pointee];
            if c.debug_types[t.pointee].kind == 2 {
                to = fwd[t.pointee];
            }
            // LF_POINTER: referent, attributes CV_PTR_64 (0x0c) with size 8 in bits 13-18.
            cv_short(&mut out, 10);
            cv_short(&mut out, 4098);
            cv_long(&mut out, to);
            cv_long(&mut out, 65548);
            index[i] = next;
            next = next + 1;
        }
    }
    for i in n {
        t := &c.debug_types[i];
        if t.kind == 2 {
            // LF_FIELDLIST of LF_MEMBER (public), each padded to four bytes.
            mut body: u64 = 2;
            for j in t.members.len() {
                m := &t.members[j];
                one := 2 + 2 + 4 + cv_numeric_size(m.offset) + m.name.len() + 1;
                body = body + one + (4 - one % 4) % 4;
            }
            cv_short(&mut out, body);
            cv_short(&mut out, 4611);
            for j in t.members.len() {
                m := &t.members[j];
                mut ty = index[m.ty];
                if c.debug_types[m.ty].kind == 2 {
                    ty = fwd[m.ty];
                }
                cv_short(&mut out, 5389);
                cv_short(&mut out, 3);
                cv_long(&mut out, ty);
                cv_numeric(&mut out, m.offset);
                cv_name(&mut out, view(m.name));
                one := 2 + 2 + 4 + cv_numeric_size(m.offset) + m.name.len() + 1;
                cv_pad(&mut out, one);
            }
            fields := next;
            next = next + 1;
            cv_structure(&mut out, t.members.len(), fields, t.size, view(t.name), 0);
            index[i] = next;
            next = next + 1;
        }
    }
    return out;
}
// The DEBUG_S_SYMBOLS subsection: per function an S_GPROC32 over its .L range, an S_FRAMEPROC
// naming rbp as the frame register, an S_REGREL32 per parameter and local at rbp-8*(slot+1)
// (the slot DWARF's fbreg describes), and S_END. lld-link links the scopes into the PDB.
fn codeview_symbols<a>(c: &a C, index: (&u64[])) -> u8[] {
    mut out = u8[];
    push_bytes(&mut out, view(".long 241\n.long .Lcvsyms_end-.Lcvsyms\n.Lcvsyms:\n"));
    for i in c.debug_funcs.len() {
        f := &c.debug_funcs[i];
        fstart := f.start;
        fend := f.end;
        mut range = u8[];
        push_bytes(&mut range, view(".long "));
        dlabel(&mut range, view(f.unit), fend);
        range.push(45); // '-'
        dlabel(&mut range, view(f.unit), fstart);
        range.push(10);
        cv_record_start(&mut out, i, 0, 4368);
        // parent, end, next: lld-link fills the scope links.
        push_bytes(&mut out, view(".long 0\n.long 0\n.long 0\n"));
        push_bytes(&mut out, view(range));
        push_bytes(&mut out, view(".long 0\n"));
        push_bytes(&mut out, view(range));
        push_bytes(&mut out, view(".long 0\n.secrel32 "));
        dlabel(&mut out, view(f.unit), fstart);
        push_bytes(&mut out, view("\n.secidx "));
        dlabel(&mut out, view(f.unit), fstart);
        push_bytes(&mut out, view("\n.byte 0\n.asciz \""));
        if f.module.len() != 0 {
            push_bytes(&mut out, view(f.module));
            push_bytes(&mut out, view("::"));
        }
        push_bytes(&mut out, view(f.name));
        push_bytes(&mut out, view("\"\n"));
        cv_record_end(&mut out, i, 0);
        // S_FRAMEPROC: locals and parameters are addressed from rbp (encoded register 2).
        cv_record_start(&mut out, i, 1, 4114);
        push_bytes(&mut out, view(".long 0\n.long 0\n.long 0\n.long 0\n.long 0\n.short 0\n.long 163840\n"));
        cv_record_end(&mut out, i, 1);
        for j in f.vars.len() {
            v := &f.vars[j];
            cv_record_start(&mut out, i, j + 2, 4369);
            push_bytes(&mut out, view(".long -"));
            decimal(&mut out, (v.slot + 1) * 8);
            push_bytes(&mut out, view("\n.long "));
            decimal(&mut out, index[v.ty]);
            // CV_AMD64_RBP
            push_bytes(&mut out, view("\n.short 334\n.asciz \""));
            push_bytes(&mut out, view(v.name));
            push_bytes(&mut out, view("\"\n"));
            cv_record_end(&mut out, i, j + 2);
        }
        push_bytes(&mut out, view(".short 2\n.short 6\n"));
    }
    push_bytes(&mut out, view(".Lcvsyms_end:\n"));
    return out;
}
fn debug_sections<a, b>(c: &a C, entry: &b [u8]) -> u8[] {
    mut out = u8[];
    if c.debug == 0 {
        return out;
    }
    dput(&mut out, view(".section .debug_abbrev,\"\",@progbits\n"));
    dput(&mut out, view(".Ldebug_abbrev:\n"));
    // 1: compile unit, children.
    duleb(&mut out, 1);
    dput(&mut out, view(".uleb128 17\n.byte 1\n"));
    dattr(&mut out, 0x25, 0x08);
    dattr(&mut out, 0x13, 0x0b);
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x1b, 0x08);
    dattr(&mut out, 0x11, 0x01);
    dattr(&mut out, 0x12, 0x07);
    dattr(&mut out, 0x10, 0x17);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 2: subprogram, children.
    duleb(&mut out, 2);
    dput(&mut out, view(".uleb128 46\n.byte 1\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x6e, 0x08);
    dattr(&mut out, 0x11, 0x01);
    dattr(&mut out, 0x12, 0x07);
    dattr(&mut out, 0x3a, 0x0b);
    dattr(&mut out, 0x3b, 0x0f);
    dattr(&mut out, 0x40, 0x18);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 3: formal parameter, no children.
    duleb(&mut out, 3);
    dput(&mut out, view(".uleb128 5\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x02, 0x18);
    dattr(&mut out, 0x3b, 0x0f);
    dattr(&mut out, 0x49, 0x13);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 4: local variable, no children.
    duleb(&mut out, 4);
    dput(&mut out, view(".uleb128 52\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x02, 0x18);
    dattr(&mut out, 0x3b, 0x0f);
    dattr(&mut out, 0x49, 0x13);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 5: base type: name, encoding, byte size.
    duleb(&mut out, 5);
    dput(&mut out, view(".uleb128 36\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x3e, 0x0b);
    dattr(&mut out, 0x0b, 0x0b);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 6: pointer type: byte size, pointee.
    duleb(&mut out, 6);
    dput(&mut out, view(".uleb128 15\n.byte 0\n"));
    dattr(&mut out, 0x0b, 0x0b);
    dattr(&mut out, 0x49, 0x13);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 7: structure type: name, byte size; members as children.
    duleb(&mut out, 7);
    dput(&mut out, view(".uleb128 19\n.byte 1\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x0b, 0x0f);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    // 8: member: name, type, offset in the structure.
    duleb(&mut out, 8);
    dput(&mut out, view(".uleb128 13\n.byte 0\n"));
    dattr(&mut out, 0x03, 0x08);
    dattr(&mut out, 0x49, 0x13);
    dattr(&mut out, 0x38, 0x0f);
    dput(&mut out, view(".byte 0\n.byte 0\n"));
    dput(&mut out, view(".byte 0\n"));

    dput(&mut out, view(".section .debug_info,\"\",@progbits\n"));
    dput(&mut out, view(".long .Ldebug_cu_end-.Ldebug_cu_start\n"));
    dput(&mut out, view(".Ldebug_cu_start:\n.short 4\n.long .Ldebug_abbrev\n.byte 8\n"));
    duleb(&mut out, 1);
    dstring(&mut out, view("grail"));
    dput(&mut out, view(".byte 12\n"));
    dstring(&mut out, entry);
    dstring(&mut out, view("."));
    mut first_start = 0;
    mut last_end = 0;
    mut first_unit = u8[];
    mut last_unit = u8[];
    if c.debug_funcs.len() != 0 {
        first_start = c.debug_funcs[0].start;
        first_unit = c.debug_funcs[0].unit.copy();
        last_end = c.debug_funcs[c.debug_funcs.len() - 1].end;
        last_unit = c.debug_funcs[c.debug_funcs.len() - 1].unit.copy();
    }
    if c.debug_funcs.len() == 0 {
        dput(&mut out, view(".quad 0\n.quad 0\n.long 0\n"));
    } else {
        dput(&mut out, view(".quad "));
        dlabel(&mut out, view(first_unit), first_start);
        dput(&mut out, view("\n.quad "));
        dlabel(&mut out, view(last_unit), last_end);
        dput(&mut out, view("-"));
        dlabel(&mut out, view(first_unit), first_start);
        dput(&mut out, view("\n.long 0\n"));
    }
    // One DIE per entry of c.debug_types, labelled .Ldebug_type_N; DW_AT_type is the CU-relative
    // offset (from the unit length field, four bytes before .Ldebug_cu_start).
    for i in c.debug_types.len() {
        t := &c.debug_types[i];
        dput(&mut out, view(".Ldebug_type_"));
        dnum(&mut out, i);
        dput(&mut out, view(":\n"));
        if t.kind == 0 {
            duleb(&mut out, 5);
            dstring(&mut out, view(t.name));
            dput(&mut out, view(".byte "));
            dnum(&mut out, t.enc);
            dput(&mut out, view("\n.byte "));
            dnum(&mut out, t.size);
            dput(&mut out, view("\n"));
        }
        if t.kind == 1 {
            duleb(&mut out, 6);
            dput(&mut out, view(".byte 8\n.long .Ldebug_type_"));
            dnum(&mut out, t.pointee);
            dput(&mut out, view("-.Ldebug_cu_start+4\n"));
        }
        if t.kind == 2 {
            duleb(&mut out, 7);
            dstring(&mut out, view(t.name));
            duleb(&mut out, t.size);
            for j in t.members.len() {
                m := &t.members[j];
                duleb(&mut out, 8);
                dstring(&mut out, view(m.name));
                dput(&mut out, view(".long .Ldebug_type_"));
                dnum(&mut out, m.ty);
                dput(&mut out, view("-.Ldebug_cu_start+4\n"));
                duleb(&mut out, m.offset);
            }
            dput(&mut out, view(".byte 0\n"));
        }
    }

    for i in c.debug_funcs.len() {
        f := &c.debug_funcs[i];
        duleb(&mut out, 2);
        dstring(&mut out, view(f.name));
        mut link = u8[];
        dput(&mut link, view("f_"));
        for k in f.module.len() {
            link.push(f.module[k]);
        }
        link.push(95);
        for k in f.name.len() {
            link.push(f.name[k]);
        }
        dstring(&mut out, view(link));
        dput(&mut out, view(".quad "));
        dlabel(&mut out, view(f.unit), f.start);
        dput(&mut out, view("\n.quad "));
        dlabel(&mut out, view(f.unit), f.end);
        dput(&mut out, view("-"));
        dlabel(&mut out, view(f.unit), f.start);
        dput(&mut out, view("\n.byte "));
        dnum(&mut out, f.file);
        dput(&mut out, view("\n.uleb128 "));
        dnum(&mut out, f.line);
        // DW_AT_frame_base: the frame-pointer register (rbp = DWARF 6, x29 = 29, s0 = x8).
        dput(&mut out, view("\n.byte 1\n.byte "));
        if c.target == 1 {
            dnum(&mut out, 80 + 29);
        } else {
            if c.target == 2 {
                dnum(&mut out, 80 + 8);
            } else {
                dnum(&mut out, 80 + 6);
            }
        }
        dput(&mut out, view("\n"));
        for j in f.vars.len() {
            v := &f.vars[j];
            mut code = 4;
            if v.param != 0 {
                code = 3;
            }
            duleb(&mut out, code);
            dstring(&mut out, view(v.name));
            dlocation(&mut out, v.slot);
            dput(&mut out, view(".uleb128 "));
            dnum(&mut out, v.line);
            dput(&mut out, view("\n.long .Ldebug_type_"));
            dnum(&mut out, v.ty);
            dput(&mut out, view("-.Ldebug_cu_start+4\n"));
        }
        dput(&mut out, view(".byte 0\n"));
    }
    dput(&mut out, view(".byte 0\n.Ldebug_cu_end:\n"));
    return out;
}
// ---- runtime error locations -------------------------------------------------------------------
// Native Linux builds record where each statement is, so a failing check can say where it failed and
// where it was called from (runtime.grl rt_fail). The front end leaves `.gpos FILE LINE COL RAW`
// markers at statements and `.gkind K` before its own inline `call rt_abort`; the optimizer passes
// directives through untouched, and site_table turns them into labelled entries afterwards.
// Not with --split: its parts are slices of the image at offsets recorded before the markers would
// be removed. Not on macOS, which has no section to bracket. Windows puts the table in grouped PE
// sections (site_table) instead of the `grail_sites` section an ELF linker brackets for us.
fn site_table_on<a>(c: (&a C)) -> bool {
    return (c.plat == 0) && (c.backend == 0) && (c.debug == 0) && (c.split == 0) && (c.no_sites == 0);
}
fn site_pos<a>(c: (&a mut C)) -> unit {
    p := c.pos;
    if c.toks.len() <= p {
        return ();
    }
    st := c.toks[p].start;
    // Line and column, counted on from the last position in the same file (statements are mostly
    // visited in order; going back restarts from the top).
    if (c.site_file != c.file) || (st < c.site_off) {
        exchange(&mut c.site_file, c.file);
        exchange(&mut c.site_off, 0);
        exchange(&mut c.site_line, 1);
        exchange(&mut c.site_col, 1);
    }
    mut line = c.site_line;
    mut col = c.site_col;
    mut i = c.site_off;
    while (i < st) && (i < c.src.len()) {
        if c.src[i] == 10 {
            line += 1;
            col = 1;
        } else {
            col += 1;
        }
        i += 1;
    }
    exchange(&mut c.site_off, st);
    exchange(&mut c.site_line, line);
    exchange(&mut c.site_col, col);
    // The last word says whether this is the unsafe runtime (runtime.grl, os-*.grl), whose sites a
    // failure report skips to find the program's own.
    o(&mut c, view(".gpos "));
    on(&mut c, c.file);
    c.out.push(32);
    on(&mut c, line);
    c.out.push(32);
    on(&mut c, col);
    c.out.push(32);
    raw := u64(c.raw != 0);
    on(&mut c, raw);
    c.out.push(10);
    return ();
}
// Before an inline `call rt_abort`: what the check was (runtime.grl rt_fail's kinds).
fn site_kind<a>(c: (&a mut C), kind: u64) -> unit {
    if site_table_on(&c) {
        o(&mut c, view(".gkind "));
        on(&mut c, kind);
        c.out.push(10);
    }
    return ();
}
fn site_starts<a, b>(line: &a [u8], prefix: &b [u8]) -> bool {
    if line.len() < prefix.len() {
        return false;
    }
    for i in prefix.len() {
        if line[i] != prefix[i] {
            return false;
        }
    }
    return true;
}
fn site_contains<a, b>(line: &a [u8], part: &b [u8]) -> bool {
    mut i = 0;
    while i + part.len() <= line.len() {
        mut hit = true;
        for j in part.len() {
            if line[i + j] != part[j] {
                hit = false;
                break;
            }
        }
        if hit {
            return true;
        }
        i += 1;
    }
    return false;
}
fn site_words<a>(line: &a [u8]) -> u64[] {
    mut out = u64[];
    mut v = 0;
    mut digits = 0;
    for i in line.len() {
        ch := line[i];
        if (48 <= ch) & (ch <= 57) {
            v = v * 10 + u64(ch - 48);
            digits += 1;
        } else if digits != 0 {
            out.push(v);
            v = 0;
            digits = 0;
        }
    }
    if digits != 0 {
        out.push(v);
    }
    return out;
}
// A position's file name: a command-line input, or a generic body an interface carried (load_file).
fn site_path<a>(c: (&a C), index: u64) -> u8[] {
    if 1000000 <= index {
        return c.virt_path[index - 1000000].copy();
    }
    return host::arg(index + c.arg_offset);
}
// Names a position's file relative to the working directory when it lies under it - `src/main.grl`,
// the form a reader wants, and the one that keeps a checkout's own location out of what the compiler
// emits (a seed built from absolute paths used to record them). Anything else keeps the form it was
// given. There is no cwd builtin, so the working directory is PWD, read once per table; an unset or
// unrelated PWD trims nothing.
fn site_relative<a, b>(path: &a [u8], cwd: &b [u8]) -> u8[] {
    if (cwd.len() == 0) || (path.len() <= cwd.len()) {
        return path.copy();
    }
    for i in cwd.len() {
        if path[i] != cwd[i] {
            return path.copy();
        }
    }
    mut start = cwd.len();
    if cwd[cwd.len() - 1] != 47 {
        if path[start] != 47 {
            return path.copy();
        }
        start += 1;
    }
    return (path[start: path.len()]).copy();
}
// Opens a range: the address an entry names, and the floor a frame's return address is looked up
// against.
// A label the emitted text minted, spelled the way `lname` spells it: the unit's namespace, then
// the unit's number. A debug table that spelled `.L<n>` named a label no unit emitted (B1 stage 5).
fn dlabel<a, b>(out: (&a mut u8[]), unit: &b [u8], n: u64) -> unit {
    push_bytes(&mut out, view(".L"));
    push_bytes(&mut out, view(unit));
    out.push(95);
    decimal(&mut out, n);
    return ();
}
fn site_label<a>(out: (&a mut u8[]), count: u64) -> unit {
    push_bytes(&mut out, view(".Lgs"));
    decimal(&mut out, count);
    push_bytes(&mut out, view(":\n"));
    return ();
}
// One entry: address, file name, line | col << 32. A file of zero names a range that says nothing
// (a function's prologue, the runtime's own code), which a failure report skips.
fn site_entry<a>(entries: (&a mut u8[]), count: u64, file: u64, flags: u64) -> unit {
    push_bytes(&mut entries, view(".quad .Lgs"));
    decimal(&mut entries, count);
    if file == 0 {
        push_bytes(&mut entries, view("\n.quad 0\n.quad 0\n"));
        return ();
    }
    push_bytes(&mut entries, view("\n.quad .Lgf"));
    decimal(&mut entries, file);
    push_bytes(&mut entries, view("\n.quad "));
    decimal(&mut entries, flags);
    entries.push(10);
    return ();
}
// A function's start address, which names the range a return address falls in.
fn site_func_label<a>(out: (&a mut u8[]), count: u64) -> unit {
    push_bytes(&mut out, view(".Lgn"));
    decimal(&mut out, count);
    push_bytes(&mut out, view(":\n"));
    return ();
}
// One function range: its start, and its name - zero for the runtime's own functions, whose frames
// a backtrace leaves out.
fn site_func_entry<a>(entries: (&a mut u8[]), count: u64, name: u64) -> unit {
    push_bytes(&mut entries, view(".quad .Lgn"));
    decimal(&mut entries, count);
    if name == 0 {
        push_bytes(&mut entries, view("\n.quad 0\n"));
        return ();
    }
    push_bytes(&mut entries, view("\n.quad .Lgh"));
    decimal(&mut entries, name);
    entries.push(10);
    return ();
}
// Turns the markers into the site table. Each statement gets a label, and the code from that label to
// the next names the statement: a frame whose return address is in it was called from there, which
// says where a check failed (the innermost such frame) and where it was called from (each frame
// above). The runtime's own statements are entered as ranges with no file - a failure report never
// names the runtime - and so is a function's prologue, which has no statement yet. An inline
// `call rt_abort` becomes `call rt_trap` with its kind.
fn site_table<a, b>(c: (&a mut C), text: &b [u8]) -> u8[] {
    mut out = u8[];
    mut entries = u8[];
    mut files = u64[];
    mut cur_file = 0;
    mut cur_line = 0;
    mut cur_col = 0;
    mut cur_internal = false;
    mut own_internal = true;
    mut seen_own = false;
    mut pending = 0;
    mut prev1 = u8[];
    mut prev2 = u8[];
    mut pending_site = false;
    mut count = 0;
    mut line = u8[];
    // The function table (grail_funcs): one (start, name) entry per function, name 0 for the
    // runtime's own. A frame's return address names the function it lies in, so a backtrace of a
    // returned error can say which function created it.
    mut funcs = u8[];
    mut names = u8[];
    mut name_count = 0;
    mut func_count = 0;
    mut pending_func = 0;
    mut pending_name = u8[];
    for i in text.len() {
        b := text[i];
        if b != 10 {
            line.push(b);
            continue;
        }
        if site_starts(view(line), view(".gpos ")) {
            w := site_words(view(line));
            if w.len() == 4 {
                internal := w[3] != 0;
                if !seen_own {
                    seen_own = true;
                    own_internal = internal;
                }
                // An inlined runtime body keeps its function's own position.
                if !internal || own_internal {
                    cur_file = w[0];
                    cur_line = w[1];
                    cur_col = w[2];
                    cur_internal = internal;
                }
                // The pending function's first statement names its table entry: the runtime's own
                // functions have none, so a backtrace never prints `rt_` frames.
                if pending_func != 0 {
                    mut func_name = 0;
                    if !internal {
                        name_count += 1;
                        func_name = name_count;
                        push_bytes(&mut names, view(".Lgh"));
                        decimal(&mut names, name_count);
                        push_bytes(&mut names, view(":\n.asciz \""));
                        for k in pending_name.len() {
                            ch := pending_name[k];
                            if (ch == 34) || (ch == 92) {
                                names.push(92);
                            }
                            names.push(ch);
                        }
                        push_bytes(&mut names, view("\"\n"));
                    }
                    site_func_entry(&mut funcs, pending_func, func_name);
                    pending_func = 0;
                }
                // Held until the statement's first instruction: two statements with no code between
                // them would otherwise open the same address, and the later one owns it.
                pending_site = true;
            }
            line = u8[];
            continue;
        }
        if site_starts(view(line), view(".gkind ")) {
            w := site_words(view(line));
            if w.len() == 1 {
                pending = w[0];
            }
            line = u8[];
            continue;
        }
        // A function starts: positions are its own again, and the code up to its first statement -
        // its prologue - names no place.
        if (line.len() > 1) && (line[line.len() - 1] == 58) && !site_starts(view(line), view(".")) {
            seen_own = false;
            own_internal = true;
            cur_file = 0;
            pending_site = false;
            // Not the data labels, whose range would swallow code, and not the PE entry, which is
            // emitted as `.globl grail_entry` then `grail_entry:` and would get the label between.
            if !site_starts(view(line), view("rt_state:")) && !site_starts(view(line), view("rt_tls_record:")) && !site_starts(view(line), view("grail_entry:")) {
                site_label(&mut out, count);
                site_entry(&mut entries, count, 0, 0);
                count += 1;
                // This function's table entry waits for its first statement: only a `.gpos` says
                // whether the function belongs to the unsafe runtime, whose frames a backtrace skips
                // exactly as a failure report skips their statements.
                if pending_func != 0 {
                    site_func_entry(&mut funcs, pending_func, 0);
                }
                func_count += 1;
                site_func_label(&mut out, func_count);
                pending_func = func_count;
                pending_name = span_copy(view(line), 0, line.len() - 1);
            }
        }
        if pending_site && !site_starts(view(line), view(".")) {
            pending_site = false;
            site_label(&mut out, count);
            if (cur_file != 0) && !cur_internal {
                mut known = false;
                for f in files.len() {
                    if files[f] == cur_file {
                        known = true;
                    }
                }
                if !known {
                    files.push(cur_file);
                }
                site_entry(&mut entries, count, cur_file, cur_line | (cur_col << 32));
            } else {
                site_entry(&mut entries, count, 0, 0);
            }
            count += 1;
        }
        // Only a check in program code is rewritten: the runtime's own aborts (rt_fail ends in one)
        // stay plain, or a failing check would report itself forever.
        mut is_abort = site_starts(view(line), view("call rt_abort")) && (line.len() == 13) && seen_own && !own_internal;
        if is_abort {
            mut kind = pending;
            if (kind == 0) && site_starts(view(prev1), view("jb ")) && site_contains(view(prev2), view("cmpq 8(%rdi),%rsi")) {
                kind = 1;
            }
            push_bytes(&mut out, view("movq $"));
            decimal(&mut out, kind);
            push_bytes(&mut out, view(",%rdx\ncall rt_trap\n"));
            pending = 0;
        } else {
            push_bytes(&mut out, view(line));
            out.push(10);
        }
        if (line.len() != 0) && !site_starts(view(line), view(".")) {
            prev2 = prev1;
            prev1 = line;
        }
        line = u8[];
    }
    if line.len() != 0 {
        push_bytes(&mut out, view(line));
    }
    // A last function whose body holds no statement (the entry shim, a body of only calls emitted
    // without positions) keeps its range and no name.
    if pending_func != 0 {
        site_func_entry(&mut funcs, pending_func, 0);
        pending_func = 0;
    }
    // rt_sites(out): the table's bounds and the caller's frame pointer, for runtime.grl
    // rt_fail_where. The body is Grail's pseudo text: it is x86-64 as it stands, and machine::lower
    // turns it into AArch64 or RISC-V for those targets.
    pe := (c.target == 3) || (c.target == 4);
    push_bytes(&mut out, view("\n.text\n"));
    if !pe {
        // An ELF or Mach-O linker gives the section its start and stop symbols; the helper is weak
        // because every object of a separately compiled program carries one and the linker keeps one.
        push_bytes(&mut out, view(".weak __start_grail_sites\n.weak __stop_grail_sites\n.weak __start_grail_funcs\n.weak __stop_grail_funcs\n.weak rt_sites\n"));
    }
    // The five words are the two tables' bounds and the caller's frame pointer. A runtime that only
    // reads the first three (a seed-built one) is unaffected; one that reads all five names the
    // functions a stack walk finds.
    push_bytes(&mut out, view("rt_sites:\nleaq __start_grail_sites(%rip),%rax\nmovq %rax,(%rdi)\nleaq __stop_grail_sites(%rip),%rax\nmovq %rax,8(%rdi)\nmovq %rbp,16(%rdi)\nleaq __start_grail_funcs(%rip),%rax\nmovq %rax,24(%rdi)\nleaq __stop_grail_funcs(%rip),%rax\nmovq %rax,32(%rdi)\nxorq %rax,%rax\nret\n"));
    // Past the end of the text the table says nothing: a frame whose return address is out there (in
    // libc above the image, say) is not one of the program's own.
    site_label(&mut out, count);
    site_entry(&mut entries, count, 0, 0);
    count += 1;
    if pe {
        // A PE linker provides no `__start_`/`__stop_` symbols, so the table is bracketed by the
        // grouped sections lld-link sorts and merges: `$a` holds the symbol that opens the merged
        // section, `$b` the entries, `$z` the symbol that closes it, so `__start` is the first entry
        // and `__stop` the byte past the last however many objects contribute. The markers are local
        // labels - a Windows program is one object, and rt_sites sits beside them - and `dr` makes
        // the merged section read-only data.
        push_bytes(&mut out, view("\n.section grail_sites$a,\"dr\"\n__start_grail_sites:\n.section grail_sites$b,\"dr\"\n.p2align 3\n"));
        push_bytes(&mut out, view(entries));
        push_bytes(&mut out, view(".section grail_sites$z,\"dr\"\n__stop_grail_sites:\n.section .rdata,\"dr\"\n"));
    } else {
        push_bytes(&mut out, view("\n.section grail_sites,\"a\"\n.p2align 3\n"));
        push_bytes(&mut out, view(entries));
        push_bytes(&mut out, view(".section .rodata\n"));
    }
    if pe {
        push_bytes(&mut out, view("\n.section grail_funcs$a,\"dr\"\n__start_grail_funcs:\n.section grail_funcs$b,\"dr\"\n.p2align 3\n"));
        push_bytes(&mut out, view(funcs));
        push_bytes(&mut out, view(".section grail_funcs$z,\"dr\"\n__stop_grail_funcs:\n.section .rdata,\"dr\"\n"));
    } else {
        push_bytes(&mut out, view("\n.section grail_funcs,\"a\"\n.p2align 3\n"));
        push_bytes(&mut out, view(funcs));
        push_bytes(&mut out, view(".section .rodata\n"));
    }
    cwd := host::env(view("PWD"));
    for f in files.len() {
        push_bytes(&mut out, view(".Lgf"));
        decimal(&mut out, files[f]);
        push_bytes(&mut out, view(":\n.asciz \""));
        given := site_path(&c, files[f]);
        path := site_relative(view(given), view(cwd));
        for k in path.len() {
            ch := path[k];
            if (ch == 34) || (ch == 92) {
                out.push(92);
            }
            out.push(ch);
        }
        push_bytes(&mut out, view("\"\n"));
    }
    push_bytes(&mut out, view(names));
    push_bytes(&mut out, view(".text\n"));
    return out;
}
// Source line/column of the current token. The assembler turns .loc into .debug_line.
fn emit_loc<a>(c: (&a mut C)) -> unit {
    if c.debug == 0 {
        if site_table_on(&c) && (c.validating == 0) {
            site_pos(&mut c);
        }
        return ();
    }
    p := c.pos;
    if c.toks.len() <= p {
        return ();
    }
    t := &c.toks[p];
    st := t.start;
    mut line = 1;
    mut column = 1;
    for i in st {
        if c.src[i] == 10 {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    file := c.file - 1;
    if c.target == 3 {
        if c.validating != 0 {
            return (); // no function id is open while validating
        }
        fid := c.debug_funcs.len();
        o(&mut c, view(".cv_loc "));
        on(&mut c, fid);
        c.out.push(32);
    } else {
        o(&mut c, view(".loc "));
    }
    on(&mut c, file);
    c.out.push(32);
    on(&mut c, line);
    c.out.push(32);
    on(&mut c, column);
    c.out.push(10);
    return ();
}
// 0 is ELF/Linux syscalls, 1 is Mach-O/macOS libSystem. CPU selection stays in `target`.
fn darwin<a>(c: (&a mut C)) -> u64 {
    return c.plat;
}
// Mach-O names every C symbol with a leading underscore; ELF does not.
fn sym<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    spelling := sym_name(&c, view(name));
    push_bytes(&mut c.out, view(spelling));
    return ();
}
// The symbol `sym` writes, as a value: the effect facts have to name the bytes the emitter wrote.
fn sym_name<a, b>(c: (&a C), name: &b [u8]) -> u8[] {
    mut out = u8[];
    if c.plat == 1 {
        out.push(95);
    }
    push_bytes(&mut out, view(name));
    return out;
}
fn rodata<a>(c: (&a mut C)) -> unit {
    if c.plat == 1 {
        o(&mut c, view(".pushsection __TEXT,__const\n"));
        return ();
    }
    o(&mut c, view(".pushsection .rodata\n"));
    return ();
}
// A weak definition. ELF spells it `.weak`; Mach-O has no `.weak` for a definition - Darwin's
// assembler rejects it as an unknown directive - and spells it `.weak_definition`.
fn weak_def<a>(c: (&a mut C)) -> unit {
    if c.plat == 1 {
        o(&mut c, view(".weak_definition "));
        return ();
    }
    o(&mut c, view(".weak "));
    return ();
}
fn copy_to<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    for i in s.len() {
        out.push(s[i]);
    }
    return ();
}
// Mach-O gives every C symbol a leading underscore. Direct calls and address materialisation
// emitted from compiler literals use the bare Grail name, so they are prefixed in one place;
// imported libSystem symbols already carry the underscore and are left alone.
fn darwin_line<a, b>(out: (&a mut u8[]), line: &b [u8]) -> unit {
    mut space = line.len();
    for i in line.len() {
        if line[i] == 32 {
            space = i;
            break;
        }
    }
    if space == line.len() {
        copy_to(&mut out, line);
        return ();
    }
    op := line[: space];
    rest := line[space + 1:];
    mut bare = 0;
    if rest.len() != 0 {
        if ((65 <= rest[0]) && (rest[0] <= 90)) || ((97 <= rest[0]) && (rest[0] <= 122)) {
            bare = 1;
        }
    }
    if (same(view(op), view("call")) || same(view(op), view("leaq"))) && bare != 0 {
        copy_to(&mut out, line[: space + 1]);
        out.push(95);
        copy_to(&mut out, rest);
        return ();
    }
    copy_to(&mut out, line);
    return ();
}
fn darwinify<a>(input: &a [u8]) -> u8[] {
    mut out = u8[];
    mut start = 0;
    for i in input.len() {
        if input[i] == 10 {
            darwin_line(&mut out, view(input[start: i]));
            out.push(10);
            start = i + 1;
        }
    }
    return out;
}
// The token text already holds the quotes; symbol names never need escapes.
fn symbol_literal<a>(c: (&a mut C)) -> u8[] {
    if kind(&mut c) != 3 {
        fail(&mut c, view("expected an imported symbol name string"));
    }
    t := tok_text(&mut c, c.pos);
    advance(&mut c);
    if t.len() < 3 {
        fail(&mut c, view("empty imported symbol name"));
    }
    return (t[1: t.len() - 1]).copy();
}

fn fresh<a>(c: (&a mut C)) -> u64 {
    id := c.next;
    exchange(&mut c.next, id + 1);
    return id;
}

fn val(t: u64, ty: u64) -> Val {
    return Val { t: t, ty: ty };
}

// Every intermediate and binding has an rbp-relative eight-byte stack slot.
fn stack_slot<a>(c: (&a mut C), id: u64) -> unit {
    c.out.push(45);
    on(&mut c, (id + 1) * 8);
    o(&mut c, view("(%rbp)"));
    return ();
}
// ---- host TLS bridge (Linux ELF: x86-64, AArch64, RISC-V 64) ----
// The runtime installs each OS thread's worker record as the hardware thread pointer (x86-64 FS
// base through arch_prctl, AArch64 tpidr_el0, RISC-V tp), which is also where a dynamically linked
// process keeps glibc's TCB (errno, malloc tcache, stack guard, DTV). Every thread therefore carries
// its own pair: the record (thread-pointer word 0 points to itself, as the x86-64 TLS ABI also
// requires of a TCB) and record word 56, the thread's libc TCB, or 0 when there is none (a static
// program, which never loaded libc). A foreign call runs on the calling thread's TCB and restores
// the record; a callback finds its thread's record through `rt_tls_record`, an initial-exec ELF TLS
// word that glibc allocates in every thread it creates, and runs on it.
//
// Runtime threads of a process that loaded libc are created by glibc (`pthread_create` through the
// rt_host_thread stub below), so each has a real TCB that glibc built, links and tears down itself;
// docs/design/decisions-b2-b6.md (B3) records why the runtime does not fabricate one.
fn tls_bridge<a>(c: (&a mut C)) -> bool {
    return (c.plat == 0) && ((c.target == 0) || (c.target == 1) || (c.target == 2));
}
// %rax = the current thread pointer: a Grail record or a libc TCB, both self-pointing on x86-64.
fn tp_read<a>(c: (&a mut C)) -> unit {
    if c.target == 0 {
        o(&mut c, view("movq %fs:0,%rax\n"));
    } else {
        o(&mut c, view("tpget\n"));
    }
    return ();
}
// Thread pointer := %rsi (clobbers %rax, %rdi; %rcx and %r11 too on x86-64).
fn tp_write<a>(c: (&a mut C)) -> unit {
    if c.target == 0 {
        o(&mut c, view("movl $4098,%edi\nmovl $158,%eax\nsyscall\n"));
    } else {
        o(&mut c, view("movq %rsi,%rdi\ntpset\n"));
    }
    return ();
}
// %rax = this thread's `rt_tls_record` word. Valid only while the thread pointer is a libc TCB.
fn tls_record_address<a>(c: (&a mut C)) -> unit {
    if c.target == 0 {
        o(&mut c, view("movq %fs:0,%rax\nleaq rt_tls_record@tpoff(%rax),%rax\n"));
    } else {
        o(&mut c, view("tlsaddr\n"));
    }
    return ();
}
// The run's code goes into an object of its own, either as one `--split` part or as the one file
// `--separate` writes: a definition another object calls has to be visible to the linker, so every
// function (and the process state) becomes global. The whole-program build keeps its local symbols.
fn own_object<a>(c: (&a C)) -> bool {
    return (c.split != 0) || (c.separate != 0);
}
fn tls_bss<a>(c: (&a mut C)) -> unit {
    if own_object(&c) {
        o(&mut c, view(".globl rt_state\n"));
        if tls_bridge(&mut c) {
            o(&mut c, view(".globl rt_tls_record\n"));
        }
    }
    o(&mut c, view("ud2\n"));
    if tls_bridge(&mut c) {
        tls_thread_stubs(&mut c);
    }
    o(&mut c, view(".bss\n.p2align 3\nrt_state: .zero 4096\n"));
    if tls_bridge(&mut c) {
        o(&mut c, view(".section .tbss,\"awT\",@nobits\n.p2align 3\nrt_tls_record: .zero 8\n"));
    }
    o(&mut c, view(".section .note.GNU-stack,\"\",@progbits\n"));
    return ();
}
// Thread creation through glibc. rt_host_thread(block, tid_word) is reached from the runtime's
// rt_thread_start (Grail calling convention; the address is the process-state word at 3216, which
// _start fills only when the process loaded libc and `pthread_create` is linked). `block` is
// {entry function, record} (rt_thread_main and the new thread's record); the joinable TID word goes
// into the word below it, is set to 1 here and cleared and futex-woken once the thread's Grail work
// has finished and it is back on its own TCB. pthread_create and pthread_detach run on the calling
// thread's TCB, like any foreign call.
//
// rt_host_thread_start is the start routine glibc calls on the new thread: it publishes the
// thread's TCB in record word 56 and the record in `rt_tls_record`, runs rt_thread_main, and
// returns to glibc on glibc's TCB so its own thread exit runs normally.
fn tls_thread_stubs<a>(c: (&a mut C)) -> unit {
    o(&mut c, view(".weak pthread_create\n.weak pthread_detach\n"));
    o(&mut c, view(".globl rt_host_thread\nrt_host_thread:\npushq %rbp\nmovq %rsp,%rbp\nsubq $48,%rsp\n"));
    o(&mut c, view("movq %rdi,-8(%rbp)\nmovq %rsi,-16(%rbp)\nmovq %rsi,-8(%rdi)\nmovl $1,%eax\nmovq %rax,(%rsi)\n"));
    tp_read(&mut c);
    o(&mut c, view("movq %rax,-24(%rbp)\nmovq 56(%rax),%rsi\n"));
    tp_write(&mut c);
    o(&mut c, view("leaq -32(%rbp),%rdi\nxorl %esi,%esi\nleaq rt_host_thread_start(%rip),%rdx\nmovq -8(%rbp),%rcx\ncall pthread_create\nmovq %rax,-40(%rbp)\ntestq %rax,%rax\n"));
    failed := label(&mut c);
    jump(&mut c, view("jne"), failed);
    o(&mut c, view("movq -32(%rbp),%rdi\ncall pthread_detach\n"));
    mark(&mut c, failed);
    o(&mut c, view("movq -24(%rbp),%rsi\n"));
    tp_write(&mut c);
    o(&mut c, view("movq -40(%rbp),%rcx\nxorl %eax,%eax\nsubq %rcx,%rax\nleave\nret\n"));
    o(&mut c, view("rt_host_thread_start:\npushq %rbp\nmovq %rsp,%rbp\nsubq $16,%rsp\nmovq %rdi,-8(%rbp)\n"));
    tp_read(&mut c);
    o(&mut c, view("movq -8(%rbp),%rcx\nmovq 8(%rcx),%rcx\nmovq %rax,56(%rcx)\n"));
    tls_record_address(&mut c);
    o(&mut c, view("movq -8(%rbp),%rcx\nmovq 8(%rcx),%rcx\nmovq %rcx,(%rax)\nmovq %rcx,%rdi\ncall rt_thread_main\n"));
    o(&mut c, view("movq -8(%rbp),%rcx\nmovq 8(%rcx),%rcx\nmovq 56(%rcx),%rsi\n"));
    tp_write(&mut c);
    // Load the TID word's address before releasing it: once it reads 0 the joiner may unmap the
    // block and the record.
    o(&mut c, view("movq -8(%rbp),%rcx\nmovq -8(%rcx),%rdi\nmovq %rdi,-16(%rbp)\nxorl %eax,%eax\nsfence\nmovq %rax,(%rdi)\n"));
    if c.target == 0 {
        o(&mut c, view("movl $202,%eax\n"));
    } else {
        o(&mut c, view("movl $98,%eax\n"));
    }
    o(&mut c, view("movq -16(%rbp),%rdi\nmovl $1,%esi\nmovl $1,%edx\nsyscall\nxorl %eax,%eax\nleave\nret\n"));
    return ();
}
// In _start, before rt_thread_init installs the main record: record the loader's TLS base (0 in a
// static program) as the main record's word 56, and when there is one, publish the main record in
// this thread's `rt_tls_record` and arm the glibc thread path if `pthread_create` is linked.
fn tls_capture<a>(c: (&a mut C)) -> unit {
    if c.target == 0 {
        o(&mut c, view("movl $4099,%edi\nleaq rt_state+184(%rip),%rsi\nmovl $158,%eax\nsyscall\n"));
    } else {
        o(&mut c, view("tpget\nmovq %rax,rt_state+184(%rip)\n"));
    }
    done := label(&mut c);
    o(&mut c, view("movq rt_state+184(%rip),%rax\ntestq %rax,%rax\n"));
    jump(&mut c, view("je"), done);
    tls_record_address(&mut c);
    o(&mut c, view("leaq rt_state+128(%rip),%rcx\nmovq %rcx,(%rax)\nleaq pthread_create(%rip),%rax\ntestq %rax,%rax\n"));
    jump(&mut c, view("je"), done);
    o(&mut c, view("leaq rt_host_thread(%rip),%rax\nmovq %rax,rt_state+3216(%rip)\n"));
    mark(&mut c, done);
    return ();
}
// Foreign call entry: when this thread has a libc TCB, `slot` keeps the record and the thread
// pointer becomes the TCB; otherwise `slot` is 0 and nothing changes.
fn tls_enter_foreign<a>(c: (&a mut C), slot: u64) -> unit {
    o(&mut c, view("xorl %eax,%eax\nmovq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    tp_read(&mut c);
    o(&mut c, view("movq 56(%rax),%rsi\ntestq %rsi,%rsi\n"));
    done := label(&mut c);
    jump(&mut c, view("je"), done);
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    tp_write(&mut c);
    mark(&mut c, done);
    return ();
}
// Callback entry: in a process that loaded libc, the caller runs on a libc TCB whose
// `rt_tls_record` names this thread's record; `slot` keeps the caller's thread pointer. A thread
// with no record was created by C: the outermost callback on it adopts one (rt_adopt_record maps a
// record for this thread and the entry publishes it in `rt_tls_record`), keeps it in `adopt`, and
// the matching tls_leave_callback unpublishes and unmaps it, so the thread is again unknown to the
// runtime once C regains control. Nested callbacks on that thread find the published record and
// adopt nothing. In a static program the thread pointer already is the record and `slot` is 0.
fn tls_enter_callback<a>(c: (&a mut C), slot: u64, adopt: u64) -> unit {
    o(&mut c, view("xorl %eax,%eax\nmovq %rax,"));
    stack_slot(&mut c, slot);
    o(&mut c, view("\nmovq %rax,"));
    stack_slot(&mut c, adopt);
    c.out.push(10);
    done := label(&mut c);
    have := label(&mut c);
    o(&mut c, view("leaq rt_state(%rip),%rax\nmovq 184(%rax),%rax\ntestq %rax,%rax\n"));
    jump(&mut c, view("je"), done);
    tls_record_address(&mut c);
    o(&mut c, view("movq (%rax),%rsi\ntestq %rsi,%rsi\n"));
    jump(&mut c, view("jne"), have);
    call_out(&mut c, view("rt_adopt_record"));
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, adopt);
    c.out.push(10);
    tls_record_address(&mut c);
    o(&mut c, view("movq "));
    stack_slot(&mut c, adopt);
    o(&mut c, view(",%rsi\nmovq %rsi,(%rax)\n"));
    mark(&mut c, have);
    tp_read(&mut c);
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    tp_write(&mut c);
    mark(&mut c, done);
    return ();
}
// Leave a callback: restore the caller's thread pointer, then, if this entry adopted the thread,
// clear `rt_tls_record` (now on the caller's TCB, so the TLS word is addressable) and unmap the
// record. Runs before the return value is loaded, so it may clobber any register.
fn tls_leave_callback<a>(c: (&a mut C), slot: u64, adopt: u64) -> unit {
    tls_leave(&mut c, slot);
    done := label(&mut c);
    o(&mut c, view("movq "));
    stack_slot(&mut c, adopt);
    o(&mut c, view(",%rdi\ntestq %rdi,%rdi\n"));
    jump(&mut c, view("je"), done);
    tls_record_address(&mut c);
    o(&mut c, view("xorl %ecx,%ecx\nmovq %rcx,(%rax)\nmovq "));
    stack_slot(&mut c, adopt);
    o(&mut c, view(",%rdi\n"));
    call_out(&mut c, view("rt_release_record"));
    mark(&mut c, done);
    return ();
}
// Before a callback's frame is torn down: copy each `p: &mut R` parameter's Grail copy back into
// the struct C passed (see the prologue). Runs before cleanup frees the copies; the copy slot is
// read at exit, so a record swapped in through `p` is the one written back.
fn callback_copy_back<a>(c: (&a mut C)) -> unit {
    n := c.export_copyback.len() / 3;
    for k in n {
        keep := c.export_copyback[3 * k];
        copy := c.export_copyback[3 * k + 1];
        bytes := imm(&mut c, c.export_copyback[3 * k + 2]);
        invoke(&mut c, view("rt_copy_bytes"), three(keep, copy, bytes));
    }
    return ();
}
// Undo either entry: restore the thread pointer `slot` saved, if it saved one.
fn tls_leave<a>(c: (&a mut C), slot: u64) -> unit {
    o(&mut c, view("movq "));
    stack_slot(&mut c, slot);
    o(&mut c, view(",%rsi\ntestq %rsi,%rsi\n"));
    done := label(&mut c);
    jump(&mut c, view("je"), done);
    tp_write(&mut c);
    mark(&mut c, done);
    return ();
}
fn save<a>(c: (&a mut C)) -> u64 {
    n := fresh(&mut c);
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, n);
    c.out.push(10);
    return n;
}
// A `&dyn I` result's pair lives in the caller's frame, so it has a frame source: the region the
// reference type names. Call it once the slot is owned.
fn shape_pair_result<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if borrowed_object(&mut c, ty) == 0 {
        return ();
    }
    mut region = 0;
    rs := type_regions(&mut c, ty);
    if rs.len() != 0 {
        region = rs[0];
    }
    target := external_place(&mut c, region, 0);
    set_target(&mut c, slot, target, slot + 1);
    return ();
}
// A `&dyn I` comes back from a call as the pair's two words (%rax data, %rdx vtable), so the caller
// builds the pair in its own frame and holds the handle: a handle into the callee's frame would not
// outlive the return.
fn save_result<a>(c: (&a mut C), ret: u64) -> u64 {
    if borrowed_object(&mut c, ret) == 0 {
        return save(&mut c);
    }
    // %rax is the data and %rdx the vtable of the returned pair.
    pair := pair_new(&mut c);
    pair_store(&mut c, pair, 0, view("%rax"));
    pair_store(&mut c, pair, 1, view("%rdx"));
    pair_handle(&mut c, pair);
    return save(&mut c);
}
fn get<a, b>(c: (&a mut C), id: u64, reg: &b [u8]) -> unit {
    o(&mut c, view("movq "));
    stack_slot(&mut c, id);
    c.out.push(44);
    o(&mut c, reg);
    c.out.push(10);
    return ();
}
fn label<a>(c: (&a mut C)) -> u64 {
    n := c.label;
    exchange(&mut c.label, n + 1);
    k := c.lunit;
    if (k != 0) & (k <= c.lnext.len()) {
        c.lnext[k - 1] = n + 1;
    }
    return n;
}
fn lname<a>(c: (&a mut C), n: u64) -> unit {
    // A label is `.L<unit>_<n>`: the unit's namespace, then the unit's own counter. Copies, because
    // `o` borrows `c` mutably and the prefix is a field of it.
    prefix := c.lpart.copy();
    o(&mut c, view(".L"));
    o(&mut c, view(prefix));
    c.out.push(95);
    on(&mut c, n);
    return ();
}
// The frame constant of a function: `.F<unit prefix>_<n>`, `.set` at its end. It is named in the
// unit's namespace like every other label because two units' counters can both reach `n` - and a
// shared `.F` name would let one function's frame size decide another function's displacements,
// since `.set` is one symbol per file (B1 stage 5).
fn fname<a>(c: (&a mut C), n: u64) -> unit {
    prefix := c.lpart.copy();
    o(&mut c, view(".F"));
    o(&mut c, view(prefix));
    c.out.push(95);
    on(&mut c, n);
    return ();
}
fn mark<a>(c: (&a mut C), n: u64) -> unit {
    lname(&mut c, n);
    o(&mut c, view(":\n"));
    return ();
}
fn jump<a, b>(c: (&a mut C), op: &b [u8], n: u64) -> unit {
    o(&mut c, op);
    c.out.push(32);
    lname(&mut c, n);
    c.out.push(10);
    return ();
}

// Win32 imports the compiler may name. The value is the fixed argument count; the runtime layer
// passes exactly that many words. Unknown names are rejected at compile time.
// The DLL that exports a Win32 entry point. The compiler names an import by symbol, but a PE image
// binds every symbol through an import descriptor of a named DLL, so the link request has to carry
// the pair - the same grouping tools/windows.mjs keeps for its cross-check.
fn win32_dll<a>(name: &a [u8]) -> u8[] {
    if same(view(name), view("WaitOnAddress")) || same(view(name), view("WakeByAddressSingle")) || same(view(name), view("WakeByAddressAll")) {
        return copy_bytes(view("kernelbase"));
    }
    if same(view(name), view("CoInitializeEx")) || same(view(name), view("CoUninitialize")) {
        return copy_bytes(view("combase"));
    }
    return copy_bytes(view("kernel32"));
}
// `// grail-link: import DLL SYMBOL` for one Win32 entry point the image calls, so a driver can build
// the import objects without a table of its own.
fn win32_link<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    dll := win32_dll(view(name));
    mut note = u8[];
    push_bytes(&mut note, view("import "));
    push_bytes(&mut note, view(dll));
    note.push(32);
    push_bytes(&mut note, view(name));
    ffi_link(&mut c, view(note));
    return ();
}
fn win32_arity<a>(name: (&a [u8])) -> u64 {
    if same(view(name), view("ExitProcess")) {
        return 1;
    }
    if same(view(name), view("ExitThread")) {
        return 1;
    }
    if same(view(name), view("GetStdHandle")) {
        return 1;
    }
    if same(view(name), view("GetModuleFileNameA")) {
        return 3;
    }
    if same(view(name), view("GetCurrentDirectoryA")) {
        return 2;
    }
    if same(view(name), view("SetConsoleOutputCP")) || same(view(name), view("SetConsoleCP")) {
        return 1;
    }
    if same(view(name), view("GetCommandLineA")) {
        return 0;
    }
    if same(view(name), view("GetEnvironmentStringsA")) {
        return 0;
    }
    if same(view(name), view("GetEnvironmentVariableA")) {
        return 3;
    }
    if same(view(name), view("GetCurrentProcessId")) {
        return 0;
    }
    if same(view(name), view("GetLastError")) {
        return 0;
    }
    if same(view(name), view("GetFileAttributesA")) {
        return 1;
    }
    if same(view(name), view("GetExitCodeProcess")) {
        return 2;
    }
    if same(view(name), view("GetSystemTimeAsFileTime")) {
        return 1;
    }
    if same(view(name), view("GetTickCount64")) {
        return 0;
    }
    if same(view(name), view("WriteFile")) {
        return 5;
    }
    if same(view(name), view("ReadFile")) {
        return 5;
    }
    if same(view(name), view("CreateFileA")) {
        return 7;
    }
    if same(view(name), view("CreateProcessA")) {
        return 10;
    }
    if same(view(name), view("CloseHandle")) {
        return 1;
    }
    if same(view(name), view("FlushFileBuffers")) {
        return 1;
    }
    if same(view(name), view("VirtualAlloc")) {
        return 4;
    }
    if same(view(name), view("CreateThread")) {
        return 6;
    }
    if same(view(name), view("WaitForSingleObject")) {
        return 2;
    }
    if same(view(name), view("WaitOnAddress")) {
        return 4;
    }
    if same(view(name), view("WakeByAddressSingle")) {
        return 1;
    }
    if same(view(name), view("WakeByAddressAll")) {
        return 1;
    }
    if same(view(name), view("CoInitializeEx")) {
        return 2;
    }
    if same(view(name), view("CoUninitialize")) {
        return 0;
    }
    if same(view(name), view("VirtualFree")) {
        return 3;
    }
    if same(view(name), view("Sleep")) {
        return 1;
    }
    if same(view(name), view("SwitchToThread")) {
        return 0;
    }
    if same(view(name), view("DeleteFileA")) {
        return 1;
    }
    if same(view(name), view("RemoveDirectoryA")) {
        return 1;
    }
    if same(view(name), view("CreateDirectoryA")) {
        return 2;
    }
    if same(view(name), view("MoveFileA")) {
        return 2;
    }
    if same(view(name), view("TerminateProcess")) {
        return 2;
    }
    if same(view(name), view("SetFilePointerEx")) {
        return 4;
    }
    return 18446744073709551615;
}
fn raw_arguments<a>(c: (&a mut C)) -> u64[] {
    mut args = u64[];
    if eat(&mut c, view(")")) {
        return args;
    }
    while true {
        mut v = expr(&mut c, 0);
        get(&mut c, v.t, view("%rax"));
        n := save(&mut c);
        args.push(n);
        if eat(&mut c, view(")")) {
            break;
        }
        expect(&mut c, view(","));
    }
    return args;
}
// ---- PE/COFF unwind data ------------------------------------------------------------------
// The COFF assembler needs absolute prologue values, but frame sizes are only known after code
// generation. The Windows target bypasses the ELF optimizer, so every emitted function has the
// fixed prologue `pushq %rbp / movq %rsp,%rbp / subq $.F<n>,%rsp`. Frame labels restart per
// function, so sizes are collected in emission order and consumed by the .def functions in the
// same order (one `.set .F<n>, <bytes>` line per function).
struct WinUnwind {
    out: u8[],
    symbol: u8[],
    frames: u64[],
    frame_at: u64,
    state: u64
}
fn span_is<a, b>(s: &a [u8], a: u64, e: u64, t: &b [u8]) -> bool {
    if e - a != t.len() {
        return false;
    }
    for i in t.len() {
        if s[a + i] != t[i] {
            return false;
        }
    }
    return true;
}
fn span_has<a, b>(s: &a [u8], a: u64, e: u64, t: &b [u8]) -> bool {
    if e - a < t.len() {
        return false;
    }
    for i in t.len() {
        if s[a + i] != t[i] {
            return false;
        }
    }
    return true;
}
fn span_copy<a>(s: &a [u8], a: u64, e: u64) -> u8[] {
    mut out = u8[];
    for i in e - a {
        out.push(s[a + i]);
    }
    return out;
}
fn put_text(out: (&mut u8[]), t: &[u8]) -> unit {
    for i in t.len() {
        out.push(t[i]);
    }
    return ();
}
fn put_number(out: (&mut u8[]), n: u64) -> unit {
    if 9 < n {
        put_number(&mut out, div(n, 10));
    }
    out.push(48 + n % 10);
    return ();
}
fn push_line(out: (&mut u8[]), text: &[u8], a: u64, e: u64) -> unit {
    for i in e - a {
        out.push(text[a + i]);
    }
    out.push(10);
    return ();
}
fn win_number<a>(s: &a [u8], a: u64, e: u64) -> u64 {
    mut n = 0;
    mut i = a;
    while i < e {
        n = n * 10 + (s[i] - 48);
        i = i + 1;
    }
    return n;
}
fn win_frames<a>(text: &a [u8]) -> u64[] {
    mut frames = u64[];
    mut start = 0;
    mut i = 0;
    while i < text.len() {
        if text[i] == 10 {
            e := i;
            if span_has(view(text), start, e, view(".set .F")) {
                mut comma = start + 5;
                while (comma < e) & (text[comma] != 44) {
                    comma = comma + 1;
                }
                if comma < e {
                    mut digit = comma + 1;
                    if (digit < e) & (text[digit] == 32) {
                        digit = digit + 1;
                    }
                    frames.push(win_number(view(text), digit, e));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return frames;
}
fn win_unwind_line<a, b>(u: (&a mut WinUnwind), text: &b [u8], a: u64, e: u64) -> unit {
    if span_has(view(text), a, e, view(".def ")) {
        u.symbol = span_copy(view(text), a + 5, e);
        u.state = 1;
        push_line(&mut u.out, view(text), a, e);
        return ();
    }
    // Debug builds put a .L range label before the function label and CodeView directives
    // (.cv_func_id, .cv_loc) inside the prologue; neither changes the unwind description.
    if (u.state == 1) || (u.state == 2) {
        if span_has(view(text), a, e, view(".cv_")) {
            push_line(&mut u.out, view(text), a, e);
            return ();
        }
    }
    if u.state == 1 {
        if 2 < e - a {
            if (text[a] == 46) & (text[a + 1] == 76) & (text[e - 1] == 58) {
                push_line(&mut u.out, view(text), a, e);
                return ();
            }
        }
    }
    if u.state == 1 {
        if 0 < e - a {
            if text[e - 1] == 58 {
                push_line(&mut u.out, view(text), a, e);
                put_text(&mut u.out, view(".seh_proc "));
                for i in u.symbol.len() {
                    u.out.push(u.symbol[i]);
                }
                u.out.push(10);
                u.state = 2;
                return ();
            }
        }
    }
    if u.state == 2 {
        if span_is(view(text), a, e, view("pushq %rbp")) {
            push_line(&mut u.out, view(text), a, e);
            put_text(&mut u.out, view(".seh_pushreg %rbp\n"));
            return ();
        }
        if span_is(view(text), a, e, view("movq %rsp,%rbp")) {
            push_line(&mut u.out, view(text), a, e);
            put_text(&mut u.out, view(".seh_setframe %rbp, 0\n"));
            return ();
        }
        if span_has(view(text), a, e, view("subq $.F")) {
            mut frame = 0;
            if u.frame_at < u.frames.len() {
                frame = u.frames[u.frame_at];
            }
            u.frame_at = u.frame_at + 1;
            push_line(&mut u.out, view(text), a, e);
            put_text(&mut u.out, view(".seh_stackalloc "));
            put_number(&mut u.out, frame);
            put_text(&mut u.out, view("\n.seh_endprologue\n"));
            u.state = 3;
            return ();
        }
        // A non-standard prologue keeps no unwind description rather than an inaccurate one.
        u.state = 0;
    }
    if u.state == 3 {
        if span_has(view(text), a, e, view(".set ")) {
            put_text(&mut u.out, view(".seh_endproc\n"));
            u.state = 0;
        }
    }
    push_line(&mut u.out, view(text), a, e);
    return ();
}
// ---- Windows ARM64 unwind data -------------------------------------------------------------
// The ARM64 assembler encodes .seh_* directives into a packed record or a full .xdata structure,
// and validates that the directives cover exactly the prologue bytes. This pass therefore only
// describes the prologue the lowering produced; a function whose shape does not match is left
// without a record instead of getting a wrong one (leaf functions need no record at all).
fn arm_saved_reg<a>(text: &a [u8], a: u64, e: u64) -> u64 {
    if !span_has(view(text), a, e, view("str x")) {
        return 0;
    }
    if !span_has(view(text), a, e, view(",[sp,#-16]!")) {
        return 0;
    }
    mut i = a + 5;
    mut n = 0;
    mut scanning = 1;
    while scanning != 0 {
        if e <= i {
            scanning = 0;
        } else {
            if text[i] == 44 {
                scanning = 0;
            } else {
                if (48 <= text[i]) & (text[i] <= 57) {
                    n = n * 10 + (text[i] - 48);
                }
                i = i + 1;
            }
        }
    }
    if (18 < n) & (n < 29) {
        return n;
    }
    return 0;
}
fn arm_lines<a>(text: &a [u8]) -> u64[] {
    // Pairs of (start, end) offsets flattened into one array.
    mut lines = u64[];
    mut i = 0;
    mut start = 0;
    while i < text.len() {
        if text[i] == 10 {
            lines.push(start);
            lines.push(i);
            start = i + 1;
        }
        i = i + 1;
    }
    if start < text.len() {
        lines.push(start);
        lines.push(text.len());
    }
    return lines;
}
fn arm_unwind<a>(text: &a [u8]) -> u8[] {
    lines := arm_lines(view(text));
    n := lines.len() / 2;
    frames := win_frames(view(text));
    mut syms = u8[][];
    mut ends = u64[];
    mut frame_of = u64[];
    mut kinds = u64[];
    mut at = 0;
    mut li = 0;
    while li < n {
        a := lines[li * 2];
        e := lines[li * 2 + 1];
        if span_has(view(text), a, e, view(".def ")) {
            sym := span_copy(view(text), a + 5, e);
            mut body = li + 1;
            mut found = 0;
            while (found == 0) & (body < n) {
                ba := lines[body * 2];
                be := lines[body * 2 + 1];
                if 0 < be - ba {
                    if text[be - 1] == 58 {
                        found = 1;
                    }
                }
                if found == 0 {
                    body = body + 1;
                }
            }
            mut stop = li + 1;
            while stop < n {
                a2 := lines[stop * 2];
                e2 := lines[stop * 2 + 1];
                if span_has(view(text), a2, e2, view(".def ")) {
                    break;
                }
                if span_has(view(text), a2, e2, view(".bss")) {
                    break;
                }
                stop = stop + 1;
            }
            mut frame = 0;
            if at < frames.len() {
                frame = frames[at];
            }
            at = at + 1;
            mut stp = 0;
            mut fp = 0;
            mut sub = 0;
            mut j = body + 1;
            while j < stop {
                x := lines[j * 2];
                y := lines[j * 2 + 1];
                if span_is(view(text), x, y, view("stp x29,x30,[sp,#-16]!")) {
                    stp = 1;
                }
                if span_is(view(text), x, y, view("mov x29,x10")) {
                    fp = 1;
                }
                if span_is(view(text), x, y, view("sub sp,sp,x10")) {
                    sub = 1;
                }
                j = j + 1;
            }
            mut kind = 0;
            if (stp & fp & sub) != 0 {
                kind = 1;
            }
            syms.push(sym);
            ends.push(stop);
            frame_of.push(frame);
            kinds.push(kind);
            li = stop;
            continue;
        }
        li = li + 1;
    }
    // Frame values are positional, so a mismatch means the shape is not understood: keep the
    // assembly unchanged rather than describe the wrong function.
    if (syms.len() != frames.len()) || (syms.len() == 0) {
        return text.copy();
    }
    mut out = u8[];
    mut cur = 0;
    mut prologue = 0;
    li = 0;
    while li < n {
        if cur < syms.len() {
            if li == ends[cur] {
                arm_close(&mut out, kinds[cur]);
                cur = cur + 1;
                prologue = 0;
            }
        }
        a := lines[li * 2];
        e := lines[li * 2 + 1];
        if cur < syms.len() {
            mut skip = 0;
            if kinds[cur] != 1 {
                skip = 1;
            }
            if skip != 0 {
                push_line(&mut out, view(text), a, e);
                li = li + 1;
                continue;
            }
            mut done = 0;
            if prologue == 0 {
                mut is_label = 0;
                if 0 < e - a {
                    if text[e - 1] == 58 {
                        is_label = 1;
                    }
                }
                if is_label != 0 {
                    mut sym = syms[cur].copy();
                    if span_is(view(text), a, e - 1, view(sym)) {
                        push_line(&mut out, view(text), a, e);
                        put_text(&mut out, view(".seh_proc "));
                        for k in sym.len() {
                            out.push(sym[k]);
                        }
                        out.push(10);
                        prologue = 1;
                        done = 1;
                    }
                }
            } else {
                if span_is(view(text), a, e, view("stp x29,x30,[sp,#-16]!")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_save_regp x29, 0\n"));
                    done = 1;
                }
                if span_is(view(text), a, e, view("mov x10,sp")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_nop\n"));
                    done = 1;
                }
                if span_is(view(text), a, e, view("mov x29,x10")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_set_fp\n"));
                    done = 1;
                }
                if span_has(view(text), a, e, view("movz x10,#((.F")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_nop\n"));
                    done = 1;
                }
                if span_has(view(text), a, e, view("movk x10,#(((")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_nop\n"));
                    done = 1;
                }
                if span_is(view(text), a, e, view("sub sp,sp,x10")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_stackalloc "));
                    put_number(&mut out, frame_of[cur]);
                    put_text(&mut out, view("\n.seh_endprologue\n"));
                    prologue = 0;
                    done = 1;
                }
                saved := arm_saved_reg(view(text), a, e);
                if saved != 0 {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_save_reg x"));
                    put_number(&mut out, saved);
                    put_text(&mut out, view(", 0\n"));
                    done = 1;
                }
            }
            if done != 0 {
                li = li + 1;
                continue;
            }
        }
        push_line(&mut out, view(text), a, e);
        li = li + 1;
    }
    if cur < syms.len() {
        arm_close(&mut out, kinds[cur]);
    }
    return out;
}
// The assembler turns the prologue directives into a full .xdata record.
fn arm_close<a>(out: (&a mut u8[]), kind: u64) -> unit {
    if kind == 1 {
        put_text(&mut out, view(".seh_endproc\n"));
    }
    return ();
}
fn win_unwind<a>(text: &a [u8]) -> u8[] {
    mut u = WinUnwind { out: u8[], symbol: u8[], frames: win_frames(view(text)), frame_at: 0, state: 0 };
    mut start = 0;
    mut i = 0;
    while i < text.len() {
        if text[i] == 10 {
            win_unwind_line(&mut u, view(text), start, i);
            start = i + 1;
        }
        i = i + 1;
    }
    if start < text.len() {
        win_unwind_line(&mut u, view(text), start, text.len());
    }
    return u.out;
}

// PE/COFF objects carry no ELF symbol type; MSVC-style .def records the function class.
fn func_directive<a, b, d>(c: (&a mut C), m: &b [u8], name: &b [u8], symbol: &d [u8], export: u64) -> unit {
    // Mach-O defines a symbol by its label and carries neither .type nor .def records.
    if c.plat == 1 {
        return ();
    }
    // --split assembles one object per module, so a definition another part calls has to be visible
    // to the linker: every function becomes global. The code is unchanged, and the single-file
    // build keeps its local symbols.
    // A specialisation is emitted weak in every build shape (B1 stage 4): its binding is stated once,
    // here, so the assembler never sees a global symbol turn weak.
    if c.current_spec != 0 {
        o(&mut c, view(".weak "));
        export_name(&mut c, view(m), view(name), view(symbol), export);
        o(&mut c, view("\n"));
    } else if own_object(&c) {
        o(&mut c, view(".globl "));
        export_name(&mut c, view(m), view(name), view(symbol), export);
        o(&mut c, view("\n"));
    }
    if (c.target == 3) || (c.target == 4) {
        o(&mut c, view(".def "));
        export_name(&mut c, view(m), view(name), view(symbol), export);
        o(&mut c, view("\n.scl 2\n.type 32\n.endef\n"));
        return ();
    }
    o(&mut c, view(".type "));
    export_name(&mut c, view(m), view(name), view(symbol), export);
    o(&mut c, view(",@function\n"));
    return ();
}
fn argreg(i: u64) -> string {
    if i == 0 {
        return "%rdi";
    }
    if i == 1 {
        return "%rsi";
    }
    if i == 2 {
        return "%rdx";
    }
    if i == 3 {
        return "%rcx";
    }
    if i == 4 {
        return "%r8";
    }
    return "%r9";
}
fn imm<a>(c: (&a mut C), n: u64) -> u64 {
    o(&mut c, view("movabsq $"));
    on(&mut c, n);
    o(&mut c, view(",%rax\n"));
    return save(&mut c);
}
// Grail's own calling convention passes six words in registers. A call with more arguments keeps
// the first five in registers and passes the rest in a heap record whose address is the sixth
// register; the callee copies them into its frame and frees the record. ABI-neutral: only
// register moves and loads/stores through a pointer, which every target lowers.
fn load_call_args<a, b>(c: (&a mut C), args: (&b u64[]), shift: u64) -> unit {
    total := args.len() + shift;
    if total <= 6 {
        for i in args.len() {
            r := argreg(i + shift);
            get(&mut c, args[i], view(r));
        }
        return ();
    }
    extra := total - 5;
    n := imm(&mut c, extra);
    record := invoke(&mut c, view("rt_rec"), one(n));
    for k in extra {
        get(&mut c, record, view("%rcx"));
        get(&mut c, args[5 - shift + k], view("%rax"));
        o(&mut c, view("movq %rax,"));
        on(&mut c, k * 8);
        o(&mut c, view("(%rcx)\n"));
    }
    for i in 5 - shift {
        r := argreg(i + shift);
        get(&mut c, args[i], view(r));
    }
    get(&mut c, record, view("%r9"));
    return ();
}
// Prologue: parameter i of `count` into frame slot i (see load_call_args for more than six).
fn store_params<a>(c: (&a mut C), count: u64) -> unit {
    mut regs = count;
    if 6 < count {
        regs = 5;
    }
    for i in regs {
        reg := argreg(i);
        o(&mut c, view("movq "));
        o(&mut c, view(reg));
        c.out.push(44);
        stack_slot(&mut c, i);
        c.out.push(10);
    }
    if 6 < count {
        for k in count - 5 {
            o(&mut c, view("movq "));
            on(&mut c, k * 8);
            o(&mut c, view("(%r9),%rax\nmovq %rax,"));
            stack_slot(&mut c, 5 + k);
            c.out.push(10);
        }
        o(&mut c, view("movq %r9,%rdi\n"));
    call_out(&mut c, view("rt_free"));
    }
    return ();
}
fn invoke<a, b>(c: (&a mut C), name: &b [u8], args: u64[]) -> u64 {
    if 6 < args.len() {
        // Runtime helpers take at most six words; more would need the spill record.
        fail(&mut c, view("runtime call exceeds six arguments"));
    }
    for i in args.len() {
        mut r = argreg(i);
        get(&mut c, args[i], view(r));
    }
    call_out(&mut c, view(name));
    if same(view(name), view("rt_f64_op")) {
        n := c.f64_ops;
        exchange(&mut c.call_ord, n);
        exchange(&mut c.f64_ops, n + 1);
    }
    // The ordinal of this call among the calls to the same callee in this function; the lifter
    // counts the same calls in the same order, so the two agree without either seeing the other.
    mut hit = 0;
    for i in c.f1_names.len() {
        if same(view(c.f1_names[i]), view(name)) {
            n := c.f1_counts[i];
            exchange(&mut c.f1_ord, n);
            exchange(&mut c.f1_counts[i], n + 1);
            hit = 1;
        }
    }
    if hit == 0 {
        exchange(&mut c.f1_ord, 0);
        c.f1_names.push(copy_bytes(view(name)));
        c.f1_counts.push(1);
    }
    return save(&mut c);
}

// Owned values have independent stack flags. Aliased field loads are not owners until moved.
fn needs_drop<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    // A record or enum always owns its fields' storage, and an `impl Drop` adds its call at the head
    // of that helper. The declaration's bit answers the question in one read: emit_drops asks it for
    // every type, and every drop site asks it for every value.
    // The declaration is indexed only for a record: `&` evaluates both sides, and another kind's
    // argument is not a declaration index.
    if k == 8 {
        if c.decls[ty_arg(&mut c, ty)].drop != 0 {
            return true;
        }
    }
    return (k == 3)
        || (k == 4)
        || (k == 5)
        || (k == 27)
        || (k == 6)
        || (k == 8)
        || (k == 9)
        || (k == 10)
        || (k == 11)
        || (k == 13)
        || (k == 16)
        || (k == 20)
        || (k == 29)
        || (k == 30)
        || (k == 33);
}
fn resource<a>(c: (&a mut C), slot: u64) -> u64 {
    mut i = c.resources.len();
    while i != 0 {
        i = i - 1;
        mut r = &c.resources[i];
        if r.slot == slot {
            return i + 1;
        }
    }
    return 0;
}
// A parameter whose storage belongs to the caller rather than to this function: a C callback's
// extern-record parameter is the address of a struct C owns, so the value is readable (and writable,
// with the ordinary borrow rules) but nothing frees it on return. `flag: 0` is what `release` reads
// as "no drop glue"; the place is a fresh external root so loans and reads still have a subject.
fn borrow_parameter<a>(c: (&a mut C), slot: u64, ty: u64) -> Val {
    if c.raw == 0 {
        place := ownership::root(&mut c.check, 0, 1);
        c
            .resources
            .push(
                Resource {
                    slot: slot,
                    ty: ty,
                    flag: 0,
                    base: 0,
                    field: 0,
                    via: 0,
                    place: place,
                    target: 0,
                    authority: 0
                }
            );
    }
    return val(slot, ty);
}
fn own<a>(c: (&a mut C), slot: u64, ty: u64) -> Val {
    if c.raw == 0 {
        k := ty_kind(&mut c, ty);
        drops := needs_drop(&mut c, ty);
        if drops || k == 7 {
            mut flag = 0;
            if drops {
                flag = imm(&mut c, 1) + 1;
            }
            place := ownership::root(&mut c.check, 0, 1);
            c
                .resources
                .push(
                    Resource {
                        slot: slot,
                        ty: ty,
                        flag: flag,
                        base: 0,
                        field: 0,
                        via: 0,
                        place: place,
                        target: 0,
                        authority: 0,
                    }
                );
        }
    }
    return val(slot, ty);
}
// A bond says that a live value retains a loan. Moves append bonds to the new holder;
// historical bonds remain for flow restoration, but dead holders do not keep loans alive.
fn bond_kind<a>(c: (&a mut C), holder: u64, loan: u64, guard: u64) -> unit {
    if (holder == 0) || (loan == 0) {
        return ();
    }
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        if (b.holder == holder) & (b.loan == loan) & (b.guard == guard) {
            return ();
        }
    }
    c.bonds.push(Bond { holder: holder, loan: loan, guard: guard });
    return ();
}
fn bond<a>(c: (&a mut C), holder: u64, loan: u64) -> unit {
    bond_kind(&mut c, holder, loan, 0);
    return ();
}
fn loan_live<a>(c: (&a mut C), loan: u64) -> u64 {
    mut l = &c.check.loans[loan - 1];
    return l.live;
}
fn transfer_bonds<a>(c: (&a mut C), src: u64, dst: u64) -> unit {
    if (src == 0) || (dst == 0) {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if loan_live(&mut c, loan) != 0 {
            if ownership::ancestor(&c.check, src, holder) {
                bond_kind(&mut c, dst, loan, guard);
            }
        }
    }
    return ();
}
fn return_bonds<a>(c: (&a mut C), src: u64, dst: u64, aggregate: u64) -> unit {
    if (src == 0) || (dst == 0) {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if loan_live(&mut c, loan) != 0 {
            if ownership::ancestor(&c.check, src, holder) {
                mut role = guard;
                if aggregate != 0 {
                    role = 1;
                }
                if guard == 3 {
                    role = 3;
                }
                if aggregate == 3 {
                    role = 3;
                }
                bond_kind(&mut c, dst, loan, role);
            }
        }
