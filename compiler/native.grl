        // `cstr(sequence)` is the checked, zero-copy C string view: the bytes must
        // end in NUL (verified at runtime) and the cast is unsafe because C may keep
        // the pointer beyond the call.
        expect(&mut c, view(")"));
        if (c.raw == 0) & (c.unsafe_depth == 0) {
            fail(&mut c, view("cstr requires an unsafe block"));
        }
        operand := a.t;
        x := deref(&mut c, a);
        k := ty_kind(&mut c, x.ty);
        if (k != 2) & (k != 3) & (k != 4) & (k != 5) {
            fail(&mut c, view("cstr requires byte sequence or view"));
        }
