    inner := ty_arg(&mut c, ty);
    want := ty_arg(&mut c, expected);
    if fn_as_fnmut(&mut c, inner, want) == 0 {
        return 0;
    }
    index := resource(&mut c, slot);
    if index == 0 {
        return 0;
    }
    mut r = &mut c.resources[index - 1];
    exchange(&mut r.ty, expected);
    return 1;
}
// `move_value`, re-owning the moved value under a wider call contract (`Fn` used as `FnMut`).
fn move_as<a>(c: (&a mut C), v: Val, ty: u64) -> Val {
    get(&mut c, v.t, view("%rax"));
