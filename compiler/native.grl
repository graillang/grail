    result := ty_arg(&mut c, ty);
    regions := type_regions(&mut c, ty);
    args := type_args(&mut c, ty);
    widened := intern_args(&mut c, 20, result, 1, regions, args);
    if same_type(&mut c, widened, expected) == 0 {
        return 0;
    }
    return 1;
}
// `&mut Fn(...)` used where `&mut FnMut(...)` is expected: same referent, same loan, wider call
// contract. Only the reference's own type changes, so nothing is copied or re-owned.
fn reference_as_fnmut<a>(c: (&a mut C), slot: u64, ty: u64, expected: u64) -> u64 {
    if ty_mode(&mut c, ty) != 1 {
        return 0;
