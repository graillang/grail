// `xs[i] = v;`, `s.items[i] += v;`, `buf[i] = b;`: the operator token position, or 0.
// Scans an assignment target `name(.f)*(  [..] | .f )*` followed by an assignment operator.
// Returns [operator position, start of the last accessor, bracket groups, 1 if the last accessor
// is a field] or [0, 0, 0, 0] when the statement is not such an assignment.
fn assign_chain<a>(c: (&a mut C)) -> u64[] {
    none := u64[0, 0, 0, 0];
    if kind(&mut c) != 1 {
        return none;
    }
    mut e = c.pos + 1;
    mut groups: u64 = 0;
    mut last: u64 = 0;
    mut field: u64 = 0;
    while true {
        k := kind_at(&mut c, e);
        if (k == 46) & (kind_at(&mut c, e + 1) == 1) {
            // A method call (`.f(`) is not an assignment target.
            if kind_at(&mut c, e + 2) == 40 {
                return none;
            }
            last = e;
            field = 1;
            e = e + 2;
            continue;
        }
        if k == 91 {
            last = e;
            field = 0;
            groups += 1;
            mut depth = 0;
            while true {
                kk := kind_at(&mut c, e);
                if (kk == 0) || (kk == 59) {
                    return none;
                }
                if kk == 91 {
                    depth = depth + 1;
                }
                if kk == 93 {
                    depth = depth - 1;
                    if depth == 0 {
                        break;
                    }
                }
                e = e + 1;
            }
            e = e + 1;
            continue;
        }
        break;
    }
    k := kind_at(&mut c, e);
    if (groups != 0) && ((k == 61) || ((261 < k) && (k < 267)) || (k == 268)) {
        return u64[e, last, groups, field];
    }
    return none;
}
