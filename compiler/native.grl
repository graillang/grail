    own(&mut c, slot, ty);
    if !eat(&mut c, view("]")) {
        mut first = 1;
        while true {
            estart := c.pos;
            mut v = expr(&mut c, 0);
            eend := c.pos;
            if c.raw == 0 {
                mut expected = 0;
                if bytes == 0 {
                    expected = ty_arg(&mut c, ty);
                }
                v = adopt_value(&mut c, v, estart, eend, expected);
                if (bytes == 0) || (v.ty != int_type(&mut c, 8, 0)) {
                    require_type(&mut c, v.ty, expected);
