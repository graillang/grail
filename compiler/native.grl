        }
        d := find_decl(&mut c, view(first), view(n));
        if d == 0 {
            mut msg = copy_bytes(view("unknown type `"));
            push_bytes(&mut msg, view(first));
            push_bytes(&mut msg, view("::"));
            push_bytes(&mut msg, view(n));
            push_bytes(&mut msg, view("`"));
            fail(&mut c, view(msg));
        }
        return nominal_type(&mut c, d - 1);
    }
    if same(view(first), view("Fn")) || same(view(first), view("FnMut")) {
        // `Fn` is callable through a shared reference; `FnMut` needs exclusive access to the value.
        mut closure_regions = u64[];
        fnmut := u64(same(view(first), view("FnMut")))
            + closure_bounds_list(&mut c, same(view(first), view("FnMut")), &mut closure_regions);
        expect(&mut c, view("("));
        mut params = u64[];
        if !eat(&mut c, view(")")) {
            while true {
                ty := parse_type(&mut c);
                params.push(ty);
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        if 5 < params.len() {
            fail(&mut c, view("closure type exceeds five parameters"));
        }
        expect(&mut c, view("->"));
        result := parse_type(&mut c);
        return intern_args(&mut c, 20, result, fnmut, closure_regions, params);
    }
    if same(view(first), view("cfn")) {
        // C function pointer: one word, no environment, called with the C ABI. Only
        // `extern "C"` definitions have such an address, so a closure cannot sneak in.
        expect(&mut c, view("("));
        mut params = u64[];
        if !eat(&mut c, view(")")) {
            while true {
                mut ty = 0;
                if ffi_byval_ahead(&mut c) {
                    advance(&mut c);
                    ty = ffi_byval_parameter(&mut c);
                } else {
                    ty = parse_type(&mut c);
                }
                params.push(ty);
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        if 64 < params.len() {
            fail(&mut c, view("cfn type exceeds 64 arguments"));
        }
        for i in params.len() {
            // `&mut R` of an extern record is the C `R *` a callback writes through (copy-in/copy-out
            // in the callback, the record's own address at a call); any other out-parameter is a
            // declaration-only feature.
            if ffi_out_param(&mut c, params[i]) & (ffi_record_out_param(&mut c, params[i]) == 0) {
                fail(
                    &mut c,
                    view("an out-parameter is only for an extern \"C\" declaration; a cfn type cannot declare one")
                );
            }
            ffi_direct_param(
                &mut c,
                params[i],
                view("cfn parameters must be an integer, f32, f64, CStr, handle, byte view, cfn, extern record or byval record")
            );
        }
        expect(&mut c, view("->"));
        result := parse_type(&mut c);
        return intern_args(&mut c, 25, result, 0, u64[], params);
    }
    if same(view(first), view("fn")) {
        expect(&mut c, view("("));
        mut params = u64[];
        if !eat(&mut c, view(")")) {
            while true {
                ty := parse_type(&mut c);
                params.push(ty);
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        expect(&mut c, view("->"));
        result := parse_type(&mut c);
        return intern_args(&mut c, 12, result, 0, u64[], params);
    }
    named := int_name(view(first));
    if named != 0 {
        return int_type_named(&mut c, named);
    }
    if same(view(first), view("bool")) {
        return bool_type(&mut c);
    }
    if same(view(first), view("f64")) {
        return float_type(&mut c);
    }
    if same(view(first), view("f32")) {
        return f32_type(&mut c);
    }
    if same(view(first), view("char")) {
        return char_type(&mut c);
    }
    if same(view(first), view("u64")) {
        return 0;
    }
    if same(view(first), view("unit")) {
        return 1;
    }
    if same(view(first), view("string")) {
        return 3;
    }
    if same(view(first), view("CPtr")) || same(view(first), view("CMutPtr")) {
        // One word: a bare C data pointer (`const void *` / `void *`) into Grail-owned bytes,
        // made by `unsafe cptr(view)` / `unsafe cptr_mut(&mut bytes)`. Mode 1 is writable.
        mode := u64(same(view(first), view("CMutPtr")));
        return intern_full(&mut c, 26, 0, mode, u64[]);
    }
    if same(view(first), view("CStr")) {
        // One word: a NUL-terminated byte pointer owned by the C side. Building one
        // is `unsafe cstr(view)` because it asserts termination and lifetime.
        return intern(&mut c, 24, 0);
    }
    if same(view(first), view("read")) || same(view(first), view("mut")) {
        fail(&mut c, view("legacy byte-view types were removed; write &[u8] or &mut [u8]"));
    }
    // User declarations shadow the built-in generic types (a program may declare its own `Task`).
    here_module := module_copy(&mut c);
    shadowed := find_decl(&mut c, view(here_module), view(first)) != 0;
    if (shadowed == false) & is_simd_name(view(first)) {
        return simd_named(&mut c, view(first));
    }
    if (shadowed == false) & same(view(first), view("Atomic")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        if !atomic_element(&mut c, e) {
            fail(&mut c, view("Atomic<T> holds u8, u16, u32, u64, i8, i16, i32, i64 or bool"));
        }
        return intern(&mut c, 11, e);
    }
    if (shadowed == false) & same(view(first), view("Scope")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return intern(&mut c, 14, e);
    }
    if (shadowed == false) & same(view(first), view("Task")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return intern(&mut c, 16, e);
    }
    if (shadowed == false) & same(view(first), view("Job")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return intern(&mut c, 29, e);
    }
    if (shadowed == false) & same(view(first), view("CancelToken")) {
        return intern(&mut c, 17, 0);
    }
    if (shadowed == false) & same(view(first), view("TaskFailure")) {
        // What a `try_join` produces when the task failed: kind, message and site. A synthesized
        // record, named like the other built-in types (see task_failure_type).
        return task_failure_type(&mut c);
    }
    if (shadowed == false) & same(view(first), view("Mutex")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return mutex_type(&mut c, e);
    }

    mut m = module_copy(&mut c);
    a := find_alias(&mut c, view(m), view(first));
    if a != 0 {
        aty := c.aliases[a - 1].ty;
        if aty == NO_TYPE {
            fail(&mut c, view("recursive or unresolved type alias"));
        }
        return aty;
    }
    imported := resolve_import(&mut c, view(first));
    if imported.len() != 0 {
        m = imported;
    }
    d := find_decl(&mut c, view(m), view(first));
    if d == 0 {
        mut msg = copy_bytes(view("unknown type `"));
        push_bytes(&mut msg, view(first));
        push_bytes(&mut msg, view("`"));
        fail(&mut c, view(msg));
    }
    return nominal_type(&mut c, d - 1);
}
// ---- top level: pass 1 names, pass 2 fields/signatures/prototypes, pass 3 bodies ----
// --export NAME promotes the definition with that declared name to a global symbol. Matching is by
// declared name in any module, so the flag does not depend on mangling or on the object format.
fn exported<a, b>(c: (&a mut C), n: &b [u8]) -> u64 {
    mut hit = 0;
    for i in c.exports.len() {
        e := c.exports[i].copy();
        if same(view(e), view(n)) {
            cur := c.export_hits[i];
            mut h = &mut c.export_hits[i];
            exchange(&mut h, cur + 1);
            hit = 1;
        }
    }
    return hit;
}
fn mangle_into<a, b, d>(out: (&a mut u8[]), plat: u64, m: &b [u8], n: &d [u8]) -> unit {
    if plat == 1 {
        out.push(95);
    }
    if same(view(m), view("runtime")) {
        push_bytes(&mut out, n);
        return ();
    }
    push_bytes(&mut out, view("f_"));
    push_bytes(&mut out, m);
    out.push(95);
    push_bytes(&mut out, n);
    return ();
}
// The unit name a symbol spells. `.inherent_K`, `.impl_K` and `.interface_K` are positions in this
// run's declaration tables - good keys inside one run, but two runs that compile different modules
// number them differently, so a module calling another's method would name a symbol the other
// object never defines. The symbol spells the declaration instead: the type's module and name, the
// interface's module and name, and for an implementation also a digest of the implementing type
// (B1 stage 4).
// The unit a written-type inherent impl's methods are emitted under: a digest of the owner type as
// written (`.inherent_<key>` is a position in this run's tables, and cannot be a symbol).
fn inherent_type_unit<a>(c: (&a mut C), owner: u64) -> u8[] {
    mut out = copy_bytes(view(".inherent_type$"));
    ty := inherent_owner_type(&mut c, owner);
    mut key = u8[];
    type_key(&mut c, &mut key, ty, 0);
    digest := iface_digest(&key);
    for i in 16 {
        out.push(digest[i]);
    }
    return out;
}
fn symbol_unit<a, b>(c: (&a mut C), m: &b [u8]) -> u8[] {
    if starts_with(view(m), view(".inherent_")) {
        n := module_index(view(m), 10);
        // A written-type inherent impl has no declaration to spell, so it spells its owner type.
        if (n != 0) & inherent_is_type_key(n) {
            return inherent_type_unit(&mut c, n);
        }
        if (n != 0) & (n <= c.decls.len()) {
            mut out = copy_bytes(view(".inherent$"));
            push_bytes(&mut out, view(c.decls[n - 1].module));
            out.push(36);
            push_bytes(&mut out, view(c.decls[n - 1].name));
            return out;
        }
    }
    if starts_with(view(m), view(".impl_")) {
        n := module_index(view(m), 6);
        if (1 < n) & (n - 1 <= c.implementations.len()) {
            contract := c.implementations[n - 2].contract;
            ty := c.implementations[n - 2].ty;
            mut out = copy_bytes(view(".impl$"));
            push_bytes(&mut out, view(c.implementations[n - 2].module));
            out.push(36);
            if (contract != 0) & (contract <= c.interfaces.len()) {
                push_bytes(&mut out, view(c.interfaces[contract - 1].name));
            }
            out.push(36);
            mut key = u8[];
            type_key(&mut c, &mut key, ty, 0);
            digest := iface_digest(&key);
            for i in 16 {
                out.push(digest[i]);
            }
            return out;
        }
    }
    if starts_with(view(m), view(".interface_")) {
        n := module_index(view(m), 11);
        if (1 < n) & (n - 1 <= c.interfaces.len()) {
            mut out = copy_bytes(view(".interface$"));
            push_bytes(&mut out, view(c.interfaces[n - 2].module));
            out.push(36);
            push_bytes(&mut out, view(c.interfaces[n - 2].name));
            return out;
        }
    }
    return m.copy();
}
fn mangle<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> unit {
    spelling := mangle_name(&mut c, view(m), view(n));
    push_bytes(&mut c.out, view(spelling));
    return ();
}
// The symbol `mangle` writes, as a value: a call's edge has to name the symbol the call names.
fn mangle_name<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u8[] {
    plat := c.plat;
    unit := symbol_unit(&mut c, m);
    mut out = u8[];
    mangle_into(&mut out, plat, view(unit), n);
    return out;
}
// The symbol a function body is emitted under, as a value: the one thing the fact table is keyed
// by, and the only part of a body that is known before the body is parsed.
fn body_label<a, b, d, e>(c: (&a C), m: &b [u8], n: &d [u8], symbol: &e [u8], export: u64) -> u8[] {
    mut out = u8[];
    if export == 2 {
        if c.plat == 1 {
            out.push(95);
        }
        push_bytes(&mut out, symbol);
        if c.target == 3 {
            push_bytes(&mut out, view("_grail_body"));
        }
        return out;
    }
    mangle_into(&mut out, c.plat, m, n);
    return out;
}
fn alias_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("type"));
    mut at_name = c.pos;
    name := ident(&mut c);
    declared := position_text(&mut c, at_name);
    module := module_copy(&mut c);
    expect(&mut c, view("="));
    if pass == 1 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        expect(&mut c, view(";"));
        refuse_duplicate_type(&mut c, view("type alias"), view(module), view(name), at_name);
        alias_public := c.decl_public;
        c.aliases.push(Alias { module: module, name: name, declared_at: declared,  public: alias_public, ty: NO_TYPE });
        return ();
    }
    if pass == 3 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        expect(&mut c, view(";"));
        return ();
    }
    ty := parse_type(&mut c);
    expect(&mut c, view(";"));
    a := find_alias(&mut c, view(module), view(name));
    if a == 0 {
        fail(&mut c, view("unknown type alias"));
    }
    entry := &mut c.aliases[a - 1];
    exchange(&mut entry.ty, ty);
    return ();
}
// `handle Name;` declares an opaque C handle type. Safe code can bind, compare and
// pass it, but cannot construct, size, inspect or drop one: it is a foreign token.
fn handle_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("handle"));
    mut at_name = c.pos;
    name := ident(&mut c);
    declared := position_text(&mut c, at_name);
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    // The audited foreign-resource contract, stated where the handle is declared:
    //   handle File: transferable;              owned, movable, not concurrently usable
    //   handle Socket: transferable, shareable; safe to move and to use from several threads
    //   handle Window;                          thread-affine: neither (the default)
    // Nothing declared is neither, so an unaudited handle cannot reach a worker by accident.
    mut transfer = 0;
    mut share = 0;
    if eat(&mut c, view(":")) {
        mut more = 1;
        while more != 0 {
            if is(&mut c, view("transferable")) {
                transfer = 1;
            } else {
                if is(&mut c, view("shareable")) {
                    share = 1;
                } else {
                    fail(
                        &mut c,
                        view("a handle is classified `transferable` or `transferable, shareable`; a handle with no classification is thread-affine (neither)")
                    );
                }
            }
            advance(&mut c);
            more = u64(eat(&mut c, view(",")));
        }
    }
    if (share != 0) & (transfer == 0) {
        fail(
            &mut c,
            view("`shareable` implies `transferable`: a value that may be used on another thread may also be moved to it")
        );
    }
    expect(&mut c, view(";"));
    if pass != 1 {
        return ();
    }
    m := module_copy(&mut c);
    refuse_duplicate_type(&mut c, view("handle"), view(m), view(name), at_name);
    item_public_2 := c.decl_public;
    c
        .decls
        .push(
            Decl {
                public: item_public_2,
                module: m,
                name: name, declared_at: declared,
                is_enum: 0,
                opaque: 1,
                transfer: transfer,
                share: share,
                c_layout: 0,
                first: 0,
                count: 0,
                drop: 0,
                regions: 0,
                types: 0,
                success: 0,
                bounds: u64[],
                constraints: u64[][],
            }
        );
    return ();
}
// Does a value of `decl` need a value of `target` before it can exist? Only the edges a value
// cannot avoid are followed: a struct's value needs every field, so any field that needs `target`
// makes it impossible, while an enum's value needs one variant, so every variant has to need it.
// Everything else ends the walk, because it is a value on its own: a number, a view, a vector, a
// reference (it points at a record, it does not hold one), and `T?` - Option is an enum whose `None`
// is a value, so `next: T?` is how a recursive record is spelled here.
// `decl` refuses a record that contains itself by value (docs/design/frontend-robustness.md).
fn needs_record<a, b>(c: (&a mut C), target: u64, decl: u64, seen: (&b u64[]), depth: u64) -> bool {
    // A record graph deeper than this is not a person's program, and the walk is only a diagnostic.
    if 64 <= depth {
        return false;
    }
    for i in seen.len() {
        if seen[i] == decl {
            return false;
        }
    }
    count := c.decls[decl].count;
    if count == 0 {
        // A record this pass has not read yet: nothing is known about what it holds.
        return false;
    }
    first := c.decls[decl].first;
    is_enum := c.decls[decl].is_enum;
    mut path = u64[];
    for i in seen.len() {
        path.push(seen[i]);
    }
    path.push(decl);
    mut any = false;
    mut all = true;
    for i in count {
        fty := c.fields[first + i].ty;
        mut hit = false;
        if ty_kind(&mut c, fty) == 8 {
            inner := ty_arg(&mut c, fty);
            if inner == target {
                hit = true;
            } else {
                hit = needs_record(&mut c, target, inner, &path, depth + 1);
            }
        }
        if hit {
            any = true;
        } else {
            all = false;
        }
    }
    if is_enum != 0 {
        return all;
    }
    return any;
}
fn decl<a>(c: (&a mut C), pass: u64) -> unit {
    is_enum := u64(is(&mut c, view("enum")));
    advance(&mut c);
    mut at_name = c.pos;
    name := ident(&mut c);
    declared := position_text(&mut c, at_name);
    lifetime_parameters(&mut c);
    // `unsafe struct C<T>: transferable, shareable`: an audited capability contract for a record
    // that holds raw pointers or foreign state on purpose. The hook is the `unsafe` keyword, so a
    // plain `struct` cannot claim a classification by accident.
    unsafe_decl := exchange(&mut c.pending_unsafe, 0);
    mut transfer = 0;
    mut share = 0;
    if eat(&mut c, view(":")) {
        if unsafe_decl == 0 {
            fail(&mut c, view("a capability classification needs `unsafe struct`: `unsafe struct C<T>: transferable, shareable`"));
        }
        if is_enum != 0 {
            fail(&mut c, view("a capability classification is for a struct, not an enum"));
        }
        mut more = 1;
        while more != 0 {
            if is(&mut c, view("transferable")) {
                transfer = 1;
            } else {
                if is(&mut c, view("shareable")) {
                    share = 1;
                } else {
                    fail(
                        &mut c,
                        view("a struct is classified `transferable` or `transferable, shareable`; a struct with no classification stays thread-affine")
                    );
                }
            }
            advance(&mut c);
            more = u64(eat(&mut c, view(",")));
        }
    }
    if (share != 0) & (transfer == 0) {
        fail(
            &mut c,
            view("`shareable` implies `transferable`: a value that may be used on another thread may also be moved to it")
        );
    }
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    regions := c.rnames.len();
    types := c.tnames.len();
    bounds := copy_numbers(&c.type_bounds);
    constraints := copy_constraints(&c.type_interfaces);
    // `@derive(...)` before this declaration: the derives belong to it, and the parameters a
    // generated implementation repeats are the ones it just read.
    derive_bits := exchange(&mut c.derive_pending, 0);
    if derive_bits != 0 {
        exchange(&mut c.dr_rnames, copy_names(&c.rnames));
        exchange(&mut c.dr_tnames, copy_names(&c.tnames));
        exchange(&mut c.dr_bounds, copy_numbers(&c.type_bounds));
        exchange(&mut c.dr_constraints, copy_constraints(&c.type_interfaces));
    }
    if pass != 2 {
        if (pass == 3) & (derive_bits != 0) {
            // Every implementation in the build is known by the last pass, which is where a derive
            // is checked: a field whose type cannot do what the derive needs names itself.
            here := module_copy(&mut c);
            found := find_decl(&mut c, view(here), view(name));
            if found != 0 {
                dr_check(&mut c, found - 1, derive_bits);
            }
        }
        if pass == 1 {
            m := module_copy(&mut c);
            mut kind = copy_bytes(view("struct"));
            if is_enum != 0 {
                kind = copy_bytes(view("enum"));
            }
            refuse_duplicate_type(&mut c, view(kind), view(m), view(name), at_name);
            item_public_3 := c.decl_public;
            c
                .decls
                .push(
                    Decl {
                        public: item_public_3,
                        module: m,
                        name: name, declared_at: declared,
                        is_enum: is_enum,
                        opaque: 0,
                        transfer: transfer,
                        share: share,
                        c_layout: 0,
                        first: 0,
                        count: 0,
                        drop: 0,
                        regions: regions,
                        types: types,
                        success: 0,
                        bounds: bounds,
                        constraints: constraints,
                    }
                );
        }
        skip_braces(&mut c);
        eat(&mut c, view(";"));
        return ();
    }
    m := module_copy(&mut c);
    d := find_decl(&mut c, view(m), view(name));
    mut pending = Field[];
    // Where each field was declared, so a duplicate can label the first one. Enums share this loop:
    // their variants are fields, laid out in the same flat array.
    mut spots = u64[];
    mut count = 0;
    expect(&mut c, view("{"));
    if !eat(&mut c, view("}")) {
        while true {
            mut at_field = c.pos;
            f := ident(&mut c);
            mut ty = 1;
            mut fp = no_pred();
            if is_enum != 0 {
                if eat(&mut c, view("(")) {
                    ty = parse_type(&mut c);
                    expect(&mut c, view(")"));
                }
            } else {
                expect(&mut c, view(":"));
                ty = parse_type(&mut c);
                // `field: T where P`: the field's refinement (docs/design/refinements.md).
                if is(&mut c, view("where")) {
                    advance(&mut c);
                    fp = pred_scan(&mut c, view(","), view("}"));
                    ref_field_pred_rules(&mut c, view(f), ty, fp.lo, fp.hi, at_field);
                }
            }
            mut spot = 0;
            for i in pending.len() {
                if same(view(pending[i].name), view(f)) {
                    spot = i + 1;
                }
            }
            if spot != 0 {
                diag_label(&mut c, spots[spot - 1], view("the first one is here"));
                duplicate_field_fail(&mut c, view(name), view(f), is_enum, at_field);
            }
            if (is_enum != 0) && is_array(&mut c, ty) {
                array_stage_fail(&mut c, view("a variant's payload"));
            }
            spots.push(at_field);
            pending.push(Field { name: f, ty: ty, pred: fp });
            count = count + 1;
            if eat(&mut c, view("}")) {
                break;
            }
            expect(&mut c, view(","));
            if eat(&mut c, view("}")) {
                break;
            }
        }
    }
    eat(&mut c, view(";"));
    for i in pending.len() {
        plo := pending[i].pred.lo;
        phi := pending[i].pred.hi;
        if phi != 0 {
            ref_field_pred_names(&mut c, view(name), &pending, plo, phi);
        }
    }
    // A record that needs itself before it can exist has no value anyone can write: the field that
    // names it would need one first, so the type is uninhabited and the user is holding something
    // they can never build. This was accepted in silence (docs/design/frontend-robustness.md).
    mut closes = 0;
    mut field_name = u8[];
    mut any_needs = false;
    mut all_need = true;
    for i in pending.len() {
        mut hit = false;
        fty := pending[i].ty;
        if ty_kind(&mut c, fty) == 8 {
            inner := ty_arg(&mut c, fty);
            if inner == d - 1 {
                hit = true;
            } else {
                mut none = u64[];
                hit = needs_record(&mut c, d - 1, inner, &none, 1);
            }
        }
        if hit {
            any_needs = true;
            if closes == 0 {
                closes = spots[i];
                field_name = pending[i].name.copy();
            }
        } else {
            all_need = false;
        }
    }
    mut impossible = any_needs;
    if is_enum != 0 {
        impossible = all_need;
    }
    if impossible {
        if closes != 0 {
            exchange(&mut c.pos, closes);
        }
        mut said = copy_bytes(view("`"));
        push_bytes(&mut said, view(name));
        push_bytes(&mut said, view("` contains itself by value: "));
        if is_enum != 0 {
            push_bytes(&mut said, view("every variant carries the record itself, so no value of it can be built. Give it a variant with no payload, or hold the record behind a reference"));
        } else {
            push_bytes(&mut said, view("the field `"));
            push_bytes(&mut said, view(field_name));
            push_bytes(&mut said, view("` carries the record itself, so no value of it can be built. Break the cycle with an optional field (`"));
            push_bytes(&mut said, view(name));
            push_bytes(&mut said, view("?`, whose value can be `None`), a reference, or a vector"));
        }
        fail(&mut c, view(said));
    }
    mut reverse = Field[];
    while pending.len() != 0 {
        reverse.push(pending.pop()!);
    }
    first := c.fields.len();
    while reverse.len() != 0 {
        c.fields.push(reverse.pop()!);
    }
    carried := c.decls[d - 1].declared_at.copy();
    exchange(
        &mut c.decls[d - 1],
        Decl {
            public: c.decl_public,
            module: m,
            name: name, declared_at: carried,
            is_enum: is_enum,
            opaque: 0,
            transfer: transfer,
            share: share,
            c_layout: 0,
            first: first,
            count: count,
            drop: 0,
            regions: c.rnames.len(),
            types: types,
            success: 0,
            bounds: bounds,
            constraints: constraints,
        }
    );
    if derive_bits != 0 {
        exchange(&mut c.dr_pass, pass);
        dr_expand(&mut c, d - 1, derive_bits);
    }
    return ();
}
// Words that start a statement or expression inside a body; they cannot name a binding or
// parameter. Declaration heads (`fn`, `struct`, `module`, `use`, ...) are recognised only at the
// top level and may name bindings.
fn is_keyword<a>(name: &a [u8]) -> bool {
    // Asked of every binding: matched by length and then bytes, with nothing built per question.
    n := name.len();
    if n == 2 {
        return (name[0] == 105) && ((name[1] == 102) || (name[1] == 110));
    }
    if n == 3 {
        return ((name[0] == 109) && (name[1] == 117) && (name[2] == 116)) || ((name[0] == 102) && (name[1] == 111) && (name[2] == 114));
    }
    if n == 4 {
        return same(name, view("else")) || same(name, view("loop")) || same(name, view("true"));
    }
    if n == 5 {
        return same(name, view("while")) || same(name, view("match")) || same(name, view("break")) || same(name, view("false"));
    }
    if n == 6 {
        return same(name, view("return")) || same(name, view("unsafe"));
    }
    if n == 8 {
        return same(name, view("continue"));
    }
    return false;
}
fn bind<a>(c: (&a mut C), name: u8[], ty: u64, id: u64, mutable: u64) -> unit {
    // Every binding goes through here, so this is where the facts about the shadowed name stop being
    // about anything - and where they come back, when the block that made the binding closes.
    pv_ir_shadow(&mut c, view(name));
    if is_keyword(view(name)) {
        fail(&mut c, view("a keyword cannot name a binding"));
    }
    if c.raw == 0 {
        if place_of(&mut c, id) == 0 {
            kind := ty_kind(&mut c, ty);
            if (kind == 1) || (kind == 2) || (kind == 12) || (kind == 17) || (kind == 18) || (kind == 19) || (kind == 21) || (kind == 22) || (kind == 26)
                || ((kind == 32) && !array_moves(&mut c, ty)) {
                place := ownership::root(&mut c.check, 1, 1);
                c
                    .resources
                    .push(
                        Resource {
                            slot: id,
                            ty: ty,
                            flag: 0,
                            base: 0,
                            field: 0,
                            via: 0,
                            place: place,
                            target: 0,
                            authority: 0,
                        }
                    );
            }
        }
    }
    from := c.pos;
    last := last_name(&mut c, view(name), from, c.scope_end);
    mut debug_name = u8[];
    if c.debug != 0 {
        debug_name = copy_bytes(view(name));
    }
    c
        .locals
        .push(
            Local {
                name: name,
                ty: ty,
                id: id,
                last: last,
                born: from,
                mutable: mutable,
                flex: 0,
                lit: 0,
                neg: 0,
                origin: 0,
                at: 0,
            }
        );
    emit_slot_fact(&mut c, ty, id);
    if c.debug != 0 {
        line := source_line(&c, from);
        c
            .debug_vars
            .push(
                DebugVar {
                    name: debug_name,
                    slot: id,
                    line: line,
                    param: 0,
                    ty: debug_type_of(&mut c, ty, 0)
                }
            );
    }
    return ();
}
// Documents a typed-IR fact: a binding's frame slot holds an f32 (docs/design/typed-ir.md, F2).
// The table travels beside the word stream and only the LLVM lifter reads it; a slot reused for a
// non-f32 binding, or one the body touches in any way other than one eight-byte word at a time,
// is dropped there and keeps the untyped lowering.
// F1: `what` for a value whose word is a pointer to a sequence header -- 2/3/4 for a vector whose
// elements are 8, 4 or 1 bytes wide (`+16` is `cap`), 5 for a descriptor `{data, len}`, whose
// `+16` is uninitialised and must never be read -- and 0 for anything else.
fn header_what<a>(c: (&a mut C), ty: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    t := base_type(&mut c, ty);
    k := ty_kind(&mut c, t);
    if (k == 3) || (k == 4) {
        return 4;
    }
    // A typed slice (`&[T]`, `&mut [T]`) is a descriptor `{data, len}` that never changes while the
    // slice lives: element writes are all a `&mut [T]` permits, and the borrow checker refuses
    // whatever would move the vector under it (SEQ-STABLE, docs/design/release-builds-and-parity.md).
    if k == 27 {
        return 5;
    }
    if k != 6 {
        return 0;
    }
    e := ty_arg(&mut c, t);
    if narrow_code(&mut c, e) != 0 {
        return 3;
    }
    return 2;
}
// F1: the element width of a sequence header, which is not the header's own stride.
fn header_width<a>(c: (&a mut C), ty: u64) -> u64 {
    t := base_type(&mut c, ty);
    k := ty_kind(&mut c, t);
    if (k == 3) || (k == 4) {
        return 1;
    }
    e := ty_arg(&mut c, t);
    if narrow_code(&mut c, e) != 0 {
        return 4;
    }
    return 8;
}
// F1: argument 0 of the call just emitted is the header of `seq`, whose element type the word
// stream loses. The lifter types the accessor's parameter with it and reads `data`/`len` once.
fn fact_seq_arg<a>(c: (&a mut C), callee: &[u8], seq: u64, seqty: u64) -> unit {
    if !wants_facts(&c) {
        return ();
    }
    hw := header_what(&mut c, seqty);
    if hw == 0 {
        return ();
    }
    name := copy_bytes(view(c.facts_fn));
    cn := copy_bytes(callee);
    wd := header_width(&mut c, seqty);
    llvm::fact_header_arg(&mut c.facts, name, c.f1_ord, cn, hw, wd);
    return ();
}
// Whether this compile records type facts: always, outside an `unsafe module` and validation. The
// LLVM lifter reads them, the typed IR does for `--emit-ir`, and the native optimiser keeps a
// slice's `data` and `len` in registers from them (optimize.grl `desc_choose`).
fn wants_facts<a>(c: (&a C)) -> bool {
    return (c.validating == 0) && (c.raw == 0) && (c.facts_fn.len() != 0);
}
fn emit_slot_fact<a>(c: (&a mut C), ty: u64, slot: u64) -> unit {
    // An `unsafe module` type-checks nothing, so in one a slot's declared type says nothing about
    // what is written to it; the fact is only sound where the front end enforces the type.
    // The table is recorded for the LLVM lifter, and for the typed IR when `--emit-ir` asked for it
    // (`compiler/ir.grl` reads it for a slot's type); a plain native build records nothing.
    if !wants_facts(&c) {
        return ();
    }
    name := copy_bytes(view(c.facts_fn));
    hw := header_what(&mut c, ty);
    if c.f1_what != 0 {
        wd := header_width(&mut c, ty);
        llvm::fact_header_slot(&mut c.facts, name, slot, c.f1_what, wd);
        return ();
    }
    if hw != 0 {
        // The slot holds a sequence header: the pointer type and the element width are the fact.
        wd := header_width(&mut c, ty);
        llvm::fact_header_slot(&mut c.facts, name, slot, hw, wd);
        return ();
    }
    f32 := u64(is_f32(&mut c, ty));
    llvm::fact_slot(&mut c.facts, name, slot, f32);
    return ();
}
// One IEEE binary64 operation on the words in %rax (left) and %rcx (right), result in %rax: 123 add,
// 124 sub, 125 mul, 126 div, 127 less-than, 128 equal, 129 sqrt, 130 from a signed integer, 131 to a
// signed integer (truncating). SSE text on x86; elsewhere the `fop` line machine.grl expands.
fn float_text<a>(c: (&a mut C), id: u64) -> unit {
    mut name = "add";
    if id == 124 {
        name = "sub";
    }
    if id == 125 {
        name = "mul";
    }
    if id == 126 {
        name = "div";
    }
    if id == 127 {
        name = "lt";
    }
    if id == 128 {
        name = "eq";
    }
    if id == 129 {
        name = "sqrt";
    }
    if id == 130 {
        name = "fromi";
    }
    if id == 131 {
        name = "toi";
    }
    // The arithmetic and sqrt are SSE text on every target - machine.grl translates it for AArch64
    // and RISC-V like any other instruction - so the optimiser keeps their values in registers
    // everywhere. Compares and integer conversions produce integers and stay `fop` off x86.
    if (id < 127) || (id == 129) || (c.target == 0) || (c.target == 3) {
        if id < 127 {
            mut instr = "addsd";
            if id == 124 {
                instr = "subsd";
            }
            if id == 125 {
                instr = "mulsd";
            }
            if id == 126 {
                instr = "divsd";
            }
            o(&mut c, view("movq %rax,%xmm0\nmovq %rcx,%xmm1\n"));
            o(&mut c, view(instr));
            o(&mut c, view(" %xmm1,%xmm0\nmovq %xmm0,%rax\n"));
        }
        if id == 127 {
            o(
                &mut c,
                view("movq %rax,%xmm0\nmovq %rcx,%xmm1\nucomisd %xmm0,%xmm1\nseta %al\nmovzbq %al,%rax\n")
            );
        }
        if id == 128 {
            o(
                &mut c,
                view("movq %rax,%xmm0\nmovq %rcx,%xmm1\nucomisd %xmm1,%xmm0\nsete %al\nsetnp %cl\nandb %cl,%al\nmovzbq %al,%rax\n")
            );
        }
        if id == 129 {
            o(&mut c, view("movq %rax,%xmm0\nsqrtsd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
        }
        if id == 130 {
            o(&mut c, view("cvtsi2sdq %rax,%xmm0\nmovq %xmm0,%rax\n"));
        }
        if id == 131 {
            o(&mut c, view("movq %rax,%xmm0\ncvttsd2si %xmm0,%rax\n"));
        }
    } else {
        o(&mut c, view("fop "));
        o(&mut c, view(name));
        c.out.push(10);
    }
    return ();
}
// Whether float operations are emitted in line. The native backend does; the LLVM lifter keys on the
// calls (`rt_f64_op` with its F2 fact, `rt_f32_round`, `rt_f64_cmp`), so that stream keeps them, and
// the unsafe runtime is where the called forms are defined.
fn float_inline<a>(c: (&a C)) -> bool {
    return (c.backend == 0) && (c.emit_ir == 0) && (c.raw == 0);
}
// A float operation with the operands in frame slots: `id` as float_text numbers them, `rhs` unused
// for the one-operand forms.
fn float_emit<a>(c: (&a mut C), id: u64, lhs: u64, rhs: u64) -> u64 {
    get(&mut c, lhs, view("%rax"));
    if id < 129 {
        get(&mut c, rhs, view("%rcx"));
    }
    float_text(&mut c, id);
    return save(&mut c);
}
// A float comparison, 0 or 1: `k` is the operator token and `op` the slot already holding it, which
// the called form passes. NaN compares false under every operator but `!=`.
fn float_cmp_call<a>(c: (&a mut C), k: u64, op: u64, x: u64, y: u64) -> u64 {
    if !float_inline(&c) {
        return invoke(&mut c, view("rt_f64_cmp"), three(op, x, y));
    }
    if k == 60 {
        return float_emit(&mut c, 127, x, y);
    }
    if k == 62 {
        return float_emit(&mut c, 127, y, x);
    }
    if k == 258 {
        return float_emit(&mut c, 128, x, y);
    }
    if k == 259 {
        equal := float_emit(&mut c, 128, x, y);
        get(&mut c, equal, view("%rax"));
        o(&mut c, view("xorq $1,%rax\n"));
        return save(&mut c);
    }
    // `<=` and `>=`: less-than or equal, the two never both true.
    mut a = x;
    mut b = y;
    if k == 270 {
        a = y;
        b = x;
    }
    less := float_emit(&mut c, 127, a, b);
    equal := float_emit(&mut c, 128, a, b);
    get(&mut c, less, view("%rax"));
    get(&mut c, equal, view("%rcx"));
    o(&mut c, view("orq %rcx,%rax\n"));
    return save(&mut c);
}
// A float's sign bit flipped (`mask` the sign bit) or cleared (`mask` everything else).
fn float_sign<a>(c: (&a mut C), value: u64, negate: u64) -> u64 {
    mut mask = 9223372036854775807;
    if negate != 0 {
        mask = 9223372036854775808;
    }
    m := imm(&mut c, mask);
    get(&mut c, value, view("%rax"));
    get(&mut c, m, view("%rcx"));
    if negate != 0 {
        o(&mut c, view("xorq %rcx,%rax\n"));
    } else {
        o(&mut c, view("andq %rcx,%rax\n"));
    }
    return save(&mut c);
}
// `lhs op rhs` as the type computes it: the binary64 operation, and for f32 (`single`) its result
// rounded to f32. In line the two are one sequence, with no slot between the operation and its
// rounding.
fn float_arith<a>(c: (&a mut C), op: u64, lhs: u64, rhs: u64, single: u64) -> u64 {
    if (single == 0) || !float_inline(&c) {
        t := float_op_call(&mut c, op, lhs, rhs, single);
        if single != 0 {
            return f32_round(&mut c, t);
        }
        return t;
    }
    mut id = 123;
    if op == 45 {
        id = 124;
    }
    if op == 42 {
        id = 125;
    }
    if op == 47 {
        id = 126;
    }
    get(&mut c, lhs, view("%rax"));
    get(&mut c, rhs, view("%rcx"));
    mut instr = "addsd";
    if id == 124 {
        instr = "subsd";
    }
    if id == 125 {
        instr = "mulsd";
    }
    if id == 126 {
        instr = "divsd";
    }
    o(&mut c, view("movq %rax,%xmm0\nmovq %rcx,%xmm1\n"));
    o(&mut c, view(instr));
    o(&mut c, view(" %xmm1,%xmm0\ncvtsd2ss %xmm0,%xmm0\ncvtss2sd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
    return save(&mut c);
}
// A binary64 word rounded to the nearest f32 (ties to even) and widened again: the value every f32
// result is. The native backend rounds in hardware - one narrowing and one widening conversion, which
// is IEEE's rounding and so agrees with `rt_f32_round` on every non-NaN word; a NaN comes out a quiet
// NaN and its payload bits are not promised. The LLVM lifter keys on the call (it becomes
// `fptrunc` + `fpext`, llvm.grl), so that backend keeps it.
fn f32_round<a>(c: (&a mut C), value: u64) -> u64 {
    if (c.backend != 0) || (c.emit_ir != 0) {
        return invoke(&mut c, view("rt_f32_round"), one(value));
    }
    get(&mut c, value, view("%rax"));
    o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\ncvtss2sd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
    return save(&mut c);
}
// `op(lhs, rhs)` on floats. With `single` (both operands' static type is f32) the call carries the
// fact the LLVM lifter rewrites into real `f* float` arithmetic; an f64 call gets none and keeps
// the word lowering. `invoke` has just recorded which call this is, and the opcode travels with
// the fact so the lifter needs neither the immediate nor a second look at the word.
fn float_op_call<a>(c: (&a mut C), op: u64, lhs: u64, rhs: u64, single: u64) -> u64 {
    if float_inline(&c) {
        mut id = 123;
        if op == 45 {
            id = 124;
        }
        if op == 42 {
            id = 125;
        }
        if op == 47 {
            id = 126;
        }
        return float_emit(&mut c, id, lhs, rhs);
    }
    opv := imm(&mut c, op);
    t := invoke(&mut c, view("rt_f64_op"), three(opv, lhs, rhs));
    if (single != 0) & wants_facts(&c) {
        llvm::fact_op(&mut c.facts, copy_bytes(view(c.facts_fn)), c.call_ord, op);
    }
    return t;
}
// ---- v3 C FFI: foreign declarations ----
// `extern "C" [lib "INPUT"] [as "SYMBOL"] fn NAME(params) -> RESULT;` declares a
// symbol the host linker resolves. The declaration has no body and the call sites
// must sit inside an `unsafe { ... }` block. Only the C ABI is accepted; there is
// no implicit fallback to another convention.
// Number of C argument words a Grail parameter occupies. A byte view is the C
// pair (pointer, length); everything else in the accepted slice is one word.
fn ffi_words<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) == 5 {
        return 2;
    }
    if ty_kind(&mut c, ty) == 28 {
        // A `byval` record is the ABI's business, not a word count: the declaration's 64-word cap
        // counts its eightbytes, which is an upper bound on what any target passes.
        inner := ty_arg(&mut c, ty);
        d := ty_arg(&mut c, inner);
        return ffi_record_words(&mut c, d);
    }
    return 1;
}
// ---- direct extern calls: one lowering per C calling convention ----
// abi 0: SysV x86-64 (Linux and macOS); 1: Win64 (x86-64 PE); 2: AAPCS64 (Linux, macOS and
// Windows ARM64); 3: RV64 LP64D. Callbacks and calls through `cfn` values keep the narrower
// six-integer-word rule in ffi_param until their entry and indirect paths use the same classes.
fn ffi_abi<a>(c: (&a mut C)) -> u64 {
    if c.target == 3 {
        return 1;
    }
    if (c.target == 1) || (c.target == 4) {
        return 2;
    }
    if c.target == 2 {
        return 3;
    }
    return 0;
}
fn ffi_int_regs(abi: u64) -> u64 {
    if abi == 0 {
        return 6;
    }
    if abi == 1 {
        return 4;
    }
    return 8;
}
// Integer argument registers in the compiler's x86 spelling; machine.grl maps %r10/%r11 to the
// seventh and eighth AAPCS64/RV64 argument registers.
fn ffi_int_reg(abi: u64, i: u64) -> string {
    if abi == 1 {
        if i == 0 {
            return "%rcx";
        }
        if i == 1 {
            return "%rdx";
        }
        if i == 2 {
            return "%r8";
        }
        return "%r9";
    }
    if i == 6 {
        return "%r10";
    }
    if i == 7 {
        return "%r11";
    }
    return argreg(i);
}
// The suffix of a narrow integer: "s8".."u32", or "" for a 64-bit or non-integer type.
fn ffi_narrow<a>(c: (&a mut C), ty: u64) -> string {
    if ty_kind(&mut c, ty) != 18 {
        return "";
    }
    bits := ty_arg(&mut c, ty);
    signed := ty_mode(&mut c, ty);
    if bits == 8 {
        if signed != 0 {
            return "s8";
        }
        return "u8";
    }
    if bits == 16 {
        if signed != 0 {
            return "s16";
        }
        return "u16";
    }
    if bits == 32 {
        if signed != 0 {
            return "s32";
        }
        return "u32";
    }
    return "";
}
fn ffi_x86_extend<a, b>(c: (&a mut C), suffix: &b [u8]) -> unit {
    if same(view(suffix), view("s8")) {
        o(&mut c, view("movsbq %al,%rax\n"));
    }
    if same(view(suffix), view("s16")) {
        o(&mut c, view("movswq %ax,%rax\n"));
    }
    if same(view(suffix), view("s32")) {
        o(&mut c, view("movslq %eax,%rax\n"));
    }
    if same(view(suffix), view("u8")) {
        o(&mut c, view("movzbq %al,%rax\n"));
    }
    if same(view(suffix), view("u16")) {
        o(&mut c, view("movzwq %ax,%rax\n"));
    }
    if same(view(suffix), view("u32")) {
        o(&mut c, view("movl %eax,%eax\n"));
    }
    return ();
}
// A parameter of `extern "C" record` type spelled `v: byval R` passes the whole record by value;
// a bare `R` stays the C `R *`. The marker is its own parameter type - kind 28, wrapping the record
// type - so one declaration can use both spellings and every call site is checked against the one
// it names, while the value itself is checked as the record it wraps (see require_type).
fn ffi_byval<a>(c: (&a mut C), ty: u64) -> bool {
    return ty_kind(&mut c, ty) == 28;
}
// 1 when a `byval R` parameter follows: `byval` and then the start of a type, so a type that
// happens to be named `byval` is not mistaken for the marker.
fn ffi_byval_ahead<a>(c: (&a mut C)) -> bool {
    if !is(&mut c, view("byval")) {
        return false;
    }
    return token_starts_type(&mut c, c.pos + 1);
}
// Parses the record type after `byval` and returns the parameter type.
fn ffi_byval_parameter<a>(c: (&a mut C)) -> u64 {
    ty := parse_type(&mut c);
    if is_c_record(&mut c, ty) == 0 {
        fail(&mut c, view("byval must name an extern \"C\" record type; a bare record parameter is a pointer"));
    }
    return intern(&mut c, 28, ty);
}
fn ffi_direct_type<a>(c: (&a mut C), ty: u64) -> bool {
    if is_float(&mut c, ty) {
        return true;
    }
    if (ty_kind(&mut c, ty) == 18) & (ffi_narrow(&mut c, ty).len() != 0) {
        return true;
    }
    return false;
}
fn ffi_direct_param<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    if ffi_byval(&mut c, ty) {
        return ();
    }
    if ffi_direct_type(&mut c, ty) {
        return ();
    }
    ffi_param(&mut c, ty, what);
    return ();
}
fn ffi_direct_result<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    if ty != 1 {
        if ffi_direct_type(&mut c, ty) {
            return ();
        }
        // A C-layout record result is returned by value (registers or a hidden result pointer,
        // per ABI) into a fresh Grail record of the same layout.
        if ty_kind(&mut c, ty) == 8 {
            rd := ty_arg(&mut c, ty);
            if c.decls[rd].c_layout != 0 {
                return ();
            }
        }
    }
    ffi_result(&mut c, ty, what);
    return ();
}
// %rax -> the outgoing stack argument word at `offset` bytes above the stack pointer.
fn ffi_store_stack<a>(c: (&a mut C), x86: u64, offset: u64) -> unit {
    if x86 != 0 {
        o(&mut c, view("movq %rax,"));
        on(&mut c, offset);
        o(&mut c, view("(%rsp)\n"));
    } else {
        o(&mut c, view("cstarg "));
        on(&mut c, offset);
        c.out.push(10);
    }
    return ();
}
// The binary32 bits of the f32 value in %rax, left in %rax.
fn ffi_f32_bits<a>(c: (&a mut C), x86: u64) -> unit {
    if x86 != 0 {
        // xmm5 is volatile on Win64 and free here: a stack-bound f32 on Win64 comes after the four
        // register slots, and on SysV after xmm0-xmm7, where xmm8+ are free and volatile too.
        if c.target == 3 {
            o(&mut c, view("movq %rax,%xmm5\ncvtsd2ss %xmm5,%xmm5\nmovd %xmm5,%eax\n"));
            return ();
        }
        o(&mut c, view("movq %rax,%xmm15\ncvtsd2ss %xmm15,%xmm15\nmovd %xmm15,%eax\n"));
    } else {
        o(&mut c, view("cf32bits\n"));
    }
    return ();
}
// `symbol` names the callee; when it is empty, `target` is the slot holding a `cfn` address and
// the call is indirect (through %rax, which no C convention uses for an argument).
fn ffi_emit_call<a, b, d, e, f>(
    c: (&a mut C),
    args: &b u64[],
    argtypes: &d u64[],
    formals: &f u64[],
    ret: u64,
    symbol: &e [u8],
    target: u64
) -> Val {
    // c.ffi_fixed is the number of named parameters of a variadic callee (set by the caller for
    // that one call), or 0 for an ordinary one.
    mut fixed = args.len();
    if c.ffi_fixed != 0 {
        fixed = c.ffi_fixed;
    }
    exchange(&mut c.ffi_fixed, 0);
    block_mode := exchange(&mut c.ffi_block_now, 0);
    blocking := block_mode == 1;
    nonblocking := block_mode == 2;
    abi := ffi_abi(&mut c);
    x86 := abi < 2;
    nint := ffi_int_regs(abi);
    apple_arm := (abi == 2) & (c.plat == 1);
    // A C record result: 1 = returned in up to two integer registers, 2 = written through a
    // hidden pointer (rdi on SysV, rcx on Win64 and a0 on RV64, shifting the arguments; x8 on
    // AAPCS64, which does not). Records hold integer fields only, so every eightbyte is INTEGER.
    mut rmode = 0;
    mut rsize = 0;
    mut rslot = 0;
    // rmode 3: a record with float fields returned in registers per its classification (fplan
    // 1 SysV eightbytes, 2 AAPCS64 HFA, 3 RV64 flattened fields).
    mut rdecl = 0;
    mut fplan = 0;
    if ret != 1 {
        if ty_kind(&mut c, ret) == 8 {
            rd := ty_arg(&mut c, ret);
            rsize = ffi_record_size(&mut c, rd);
            nwords := ffi_record_words(&mut c, rd);
            words := imm(&mut c, nwords);
            rslot = invoke(&mut c, view("rt_rec"), one(words));
            rmode = 1;
            rdecl = rd;
            if ffi_record_has_float_deep(&mut c, rd) {
                fplan = ffi_float_plan(&mut c, rd, abi);
            }
            if fplan == 2 {
                // An AAPCS64 homogeneous float aggregate comes back in s0-s3/d0-d3 at any size.
                rmode = 3;
            }
            if (fplan == 3) & (rsize < 17) {
                rmode = 3;
            }
            if (fplan == 1) & (rsize < 17) {
                rmode = 3;
            }
            if rmode == 3 {
            } else {
            if abi == 1 {
                if (rsize != 1) & (rsize != 2) & (rsize != 4) & (rsize != 8) {
                    rmode = 2;
                }
            } else {
                if 16 < rsize {
                    rmode = 2;
                }
            }
            }
        }
    }
    mut shift = 0;
    if (rmode == 2) & (abi != 2) {
        shift = 1;
    }
    // First pass: how many argument words go to the stack. Win64 slots are positional: the
    // n-th argument uses the n-th register of its class or the n-th stack slot.
    mut ints = shift;
    mut floats = 0;
    mut stack = 0;
    // A `byval` argument's placement is decided here and replayed when the call is emitted, so the
    // two passes cannot disagree; its counters advance the same integer/float/stack allocation.
    mut copies = 0;
    mut plans = FFIPlan[];
    for i in args.len() {
        ty := argtypes[i];
        // RV64 passes variadic floating-point arguments in integer registers; Apple arm64 passes
        // every variadic argument on the stack in its own 8-byte slot.
        rv_var := (abi == 3) & (fixed < i + 1);
        apple_var := apple_arm & (fixed < i + 1);
        if (formals.len() > i) && ffi_byval(&mut c, formals[i]) {
            inner := ty_arg(&mut c, formals[i]);
            rd := ty_arg(&mut c, inner);
            plan := ffi_byval_plan(&mut c, rd, abi, ints, floats, stack, copies);
            ints = plan.ints;
            floats = plan.floats;
            stack = plan.stack;
            copies = plan.copies;
            plans.push(plan);
            continue;
        }
        plans.push(ffi_empty_plan());
        if apple_var {
            for w in ffi_words(&mut c, ty) {
                stack = stack + 1;
            }
            continue;
        }
        if is_float(&mut c, ty) && !rv_var {
            if abi == 1 {
                if ints < 4 {
                    ints = ints + 1;
                } else {
                    stack = stack + 1;
                }
            } else {
                if floats < 8 {
                    floats = floats + 1;
                } else {
                    if (abi == 3) & (ints < 8) {
                        ints = ints + 1;
                    } else {
                        stack = stack + 1;
                    }
                }
            }
        } else {
            for w in ffi_words(&mut c, ty) {
                if ints < nint {
                    ints = ints + 1;
                } else {
                    stack = stack + 1;
                }
            }
        }
    }
    mut base = 0;
    if abi == 1 {
        base = 32; // the callee's register home area
    }
    copy_base := (base + stack * 8 + 15) / 16 * 16;
    mut area = copy_base + copies;
    area = (area + 15) / 16 * 16;
    if 2048 < area {
        fail(&mut c, view("extern C call needs more than 2 KiB of stack arguments"));
    }
    mut tls = 0;
    if tls_bridge(&mut c) {
        tls = fresh(&mut c);
        if tls == 0 {
            // 0 below means "no thread pointer was saved", and it is also the first slot a function
            // hands out: a call with no arguments that opens its function would never restore the
            // record, and everything after it would run on libc's thread pointer.
            tls = fresh(&mut c);
        }
        tls_enter_foreign(&mut c, tls);
    }
    // A `blocking` call on x86-64 Linux gives this thread's worker (if it is one) to a spare thread
    // before the arguments are loaded - the runtime call clobbers the argument registers - and takes
    // a worker back after (rt_blocking_enter / rt_blocking_leave). Elsewhere it is a plain call.
    block_here := blocking & (c.target == 0) & (c.plat == 0);
    if block_here {
        call_out(&mut c, view("rt_blocking_enter"));
    }
    // Every other foreign call on x86-64 Linux marks the worker as inside a foreign call (an odd
    // count in the word block word 320 names), so the scheduler's monitor can give the worker away
    // if the call holds it for more than 10 ms (rt_sysmon). The word's address is kept in the call's
    // `tls` slot for the exit; 0 there means "not on a worker". Clobbers %rax and %r11 only, before
    // any argument register is loaded.
    marked := (!blocking) & (!nonblocking) & (c.target == 0) & (c.plat == 0) & (tls != 0);
    if marked {
        ffi_marker_enter(&mut c, tls);
    }
    if area != 0 {
        if x86 {
            o(&mut c, view("subq $"));
            on(&mut c, area);
            o(&mut c, view(",%rsp\n"));
        } else {
            o(&mut c, view("cstack "));
            on(&mut c, area);
            c.out.push(10);
        }
    }
    ints = shift;
    floats = 0;
    mut next = 0;
    if shift != 0 {
        get(&mut c, rslot, view(ffi_int_reg(abi, 0)));
    }
    for i in args.len() {
        ty := argtypes[i];
        variadic_arg := fixed < i + 1;
        rv_var := (abi == 3) & variadic_arg;
        if plans[i].byval != 0 {
            ffi_byval_emit(&mut c, args[i], &plans[i], copy_base, x86, abi);
            ints = plans[i].ints;
            floats = plans[i].floats;
            next = plans[i].stack;
            continue;
        }
        if apple_arm & variadic_arg {
            // Promoted value (int to 64 bits as Grail holds it, float to double) in an 8-byte slot.
            vwords := ffi_words(&mut c, ty);
            get(&mut c, args[i], view("%rax"));
            if vwords == 2 {
                o(&mut c, view("movq %rax,%r10\nmovq (%r10),%rax\n"));
                ffi_store_stack(&mut c, x86, base + next * 8);
                next = next + 1;
                o(&mut c, view("movq 8(%r10),%rax\n"));
            }
            ffi_store_stack(&mut c, x86, base + next * 8);
            next = next + 1;
            continue;
        }
        if is_float(&mut c, ty) & rv_var {
            // Promoted to double and moved as its bits through the integer path.
            get(&mut c, args[i], view("%rax"));
            if ints < 8 {
                o(&mut c, view("movq %rax,"));
                o(&mut c, view(ffi_int_reg(abi, ints)));
                c.out.push(10);
                ints = ints + 1;
            } else {
                ffi_store_stack(&mut c, x86, base + next * 8);
                next = next + 1;
            }
            continue;
        }
        if is_float(&mut c, ty) {
            // A variadic float is promoted to double (Grail already holds the double's value).
            single := is_f32(&mut c, ty) && !variadic_arg;
            mut freg = 99;
            mut ireg = 99;
            if abi == 1 {
                if ints < 4 {
                    freg = ints;
                    ints = ints + 1;
                }
            } else {
                if floats < 8 {
                    freg = floats;
                    floats = floats + 1;
                } else {
                    if (abi == 3) & (ints < 8) {
                        ireg = ints;
                        ints = ints + 1;
                    }
                }
            }
            get(&mut c, args[i], view("%rax"));
            if freg != 99 {
                if (abi == 1) & variadic_arg {
                    // Win64 variadics: the callee reads the integer register, so pass both.
                    o(&mut c, view("movq %rax,"));
                    o(&mut c, view(ffi_int_reg(abi, freg)));
                    c.out.push(10);
                }
                if x86 {
                    if single {
                        // Narrowed in its own register: no scratch, so nothing callee-saved is touched.
                        o(&mut c, view("movq %rax,%xmm"));
                        on(&mut c, freg);
                        o(&mut c, view("\ncvtsd2ss %xmm"));
                        on(&mut c, freg);
                        o(&mut c, view(",%xmm"));
                    } else {
                        o(&mut c, view("movq %rax,%xmm"));
                    }
                    on(&mut c, freg);
                    c.out.push(10);
                } else {
                    if single {
                        o(&mut c, view("cfarg32 "));
                    } else {
                        o(&mut c, view("cfarg64 "));
                    }
                    on(&mut c, freg);
                    c.out.push(10);
                }
            } else {
                if single {
                    if apple_arm {
                        fail(&mut c, view("macOS arm64 packs stack arguments; an f32 stack argument is not supported"));
                    }
                    ffi_f32_bits(&mut c, x86);
                }
                if ireg != 99 {
                    o(&mut c, view("movq %rax,"));
                    o(&mut c, view(ffi_int_reg(abi, ireg)));
                    c.out.push(10);
                } else {
                    ffi_store_stack(&mut c, x86, base + next * 8);
                    next = next + 1;
                }
            }
        } else {
            words := ffi_words(&mut c, ty);
            suffix := ffi_narrow(&mut c, ty);
            for w in words {
                mut ireg = 99;
                if ints < nint {
                    ireg = ints;
                    ints = ints + 1;
                }
                if (ireg == 99) & apple_arm & (suffix.len() != 0) {
                    fail(&mut c, view("macOS arm64 packs stack arguments; a narrow integer stack argument is not supported"));
                }
                // RV64 passes a 32-bit argument sign-extended even when it is unsigned; Grail keeps
                // u32 zero-extended, so it is converted at the boundary.
                rv_u32 := (abi == 3) & same(view(suffix), view("u32"));
                direct := words == 1 && ireg != 99 && !rv_u32;
                if direct {
                    get(&mut c, args[i], view(ffi_int_reg(abi, ireg)));
                } else {
                    get(&mut c, args[i], view("%rax"));
                    if words == 2 {
                        if w == 0 {
                            o(&mut c, view("movq (%rax),%rax\n"));
                        } else {
                            o(&mut c, view("movq 8(%rax),%rax\n"));
                        }
                    }
                    if rv_u32 {
                        o(&mut c, view("cext s32\n"));
                    }
                    if ireg != 99 {
                        o(&mut c, view("movq %rax,"));
                        o(&mut c, view(ffi_int_reg(abi, ireg)));
                        c.out.push(10);
                    } else {
                        ffi_store_stack(&mut c, x86, base + next * 8);
                        next = next + 1;
                    }
                }
            }
        }
    }
    if (rmode == 2) & (abi == 2) {
        get(&mut c, rslot, view("%rax"));
        o(&mut c, view("csret\n"));
    }
    if (abi == 0) & (fixed < args.len()) {
        // SysV variadic callees read the number of vector registers used from %al.
        o(&mut c, view("movl $"));
        on(&mut c, floats);
        o(&mut c, view(",%eax\n"));
    }
    if (symbol.len() != 0) && (area == 0) && (fixed == args.len()) && (rmode == 0) && (copies == 0) {
        ffi_signature_fact(&mut c, argtypes, ret, view(symbol), abi);
    }
    if symbol.len() == 0 {
        if c.target == 0 {
            // A C call through a `cfn` value. %r11 is no argument register, %al may already hold
            // the vector count of a variadic callee, and `call *%r11` is the spelling the LLVM
            // lifter keeps native: it lifts `call *%rax`, which is always the Grail convention.
            get(&mut c, target, view("%r11"));
            call_slot_out(&mut c, view("call *%r11\n"), view("a call through a C function pointer"));
        } else {
            get(&mut c, target, view("%rax"));
            call_slot_out(&mut c, view("call *%rax\n"), view("a closure call"));
        }
    } else {
        call_out(&mut c, view(symbol));
    }
    if marked {
        ffi_marker_leave(&mut c, tls, view(symbol));
    }
    if block_here {
        // The result registers survive the runtime call: rax, rdx, xmm0 and xmm1, in 32 bytes of
        // stack (the call's argument area is still allocated; 16-byte alignment is kept).
        o(&mut c, view("subq $32,%rsp\nmovq %rax,(%rsp)\nmovq %rdx,8(%rsp)\nmovq %xmm0,%r10\nmovq %r10,16(%rsp)\nmovq %xmm1,%r10\nmovq %r10,24(%rsp)\n"));
        call_out(&mut c, view("rt_blocking_leave"));
        o(&mut c, view("movq 16(%rsp),%r10\nmovq %r10,%xmm0\nmovq 24(%rsp),%r10\nmovq %r10,%xmm1\nmovq (%rsp),%rax\nmovq 8(%rsp),%rdx\naddq $32,%rsp\n"));
    }
    if (ret != 1) & (rmode == 0) {
        if is_float(&mut c, ret) {
            single := is_f32(&mut c, ret);
            if x86 {
                if single {
                    o(&mut c, view("cvtss2sd %xmm0,%xmm0\n"));
                }
                o(&mut c, view("movq %xmm0,%rax\n"));
            } else {
                if single {
                    o(&mut c, view("cfret32\n"));
                } else {
                    o(&mut c, view("cfret64\n"));
                }
            }
        } else {
            suffix := ffi_narrow(&mut c, ret);
            if suffix.len() != 0 {
                if x86 {
                    ffi_x86_extend(&mut c, view(suffix));
                } else {
                    o(&mut c, view("cext "));
                    o(&mut c, view(suffix));
                    c.out.push(10);
                }
            }
        }
    }
    if area != 0 {
        if x86 {
            o(&mut c, view("addq $"));
            on(&mut c, area);
            o(&mut c, view(",%rsp\n"));
        } else {
            o(&mut c, view("cunstack "));
            on(&mut c, area);
            c.out.push(10);
        }
    }
    if rmode == 3 {
        ffi_float_result(&mut c, rslot, rdecl, fplan);
    }
    if rmode != 0 {
        if rmode == 1 {
            // Word 0 is in %rax on every target; word 1 in %rdx on x86-64 and in x1/a1 (spelled
            // %rsi here) on AArch64 and RV64, which the call lowering leaves in place.
            get(&mut c, rslot, view("%r10"));
            o(&mut c, view("movq %rax,(%r10)\n"));
            if 8 < rsize {
                if x86 {
                    o(&mut c, view("movq %rdx,8(%r10)\n"));
                } else {
                    o(&mut c, view("movq %rsi,8(%r10)\n"));
                }
            }
        }
        if tls != 0 {
            tls_leave(&mut c, tls);
        }
        own(&mut c, rslot, ret);
        return val(rslot, ret);
    }
    slot := save(&mut c);
    if tls != 0 {
        tls_leave(&mut c, tls);
    }
    if ret != 1 {
        own(&mut c, slot, ret);
    }
    return val(slot, ret);
}
// A handle (kind 23) or bare pointer (kind 26) is the one kind of value C cannot produce as a
// result alone: the Vulkan/D3D12/Metal shape `vkCreateInstance(..., VkInstance *pInstance)` writes it
// through an out-parameter. The parameter is `&mut H` and the callee writes the new word into the
// caller's slot; a binding declared without an initializer starts as null, so the slot always has a
// defined value before the call.
fn ffi_out_slot_type<a>(c: (&a mut C), ty: u64) -> bool {
    // A handle or bare pointer is one word the callee writes; an extern "C" record is the C `R *`,
    // the address of the record's own fields, so the callee fills the struct in place and Grail
    // reads the typed fields afterwards.
    if is_c_record(&mut c, ty) != 0 {
        return true;
    }
    return (ty_kind(&mut c, ty) == 23) || (ty_kind(&mut c, ty) == 26);
}
// `p: &mut R` in an extern declaration: the C `R *`, written by the callee.
fn ffi_record_out_param<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) != 7 {
        return 0;
    }
    if ty_mode(&mut c, ty) == 0 {
        return 0;
    }
    inner := ty_arg(&mut c, ty);
    if is_c_record(&mut c, inner) != 0 {
        return inner;
    }
    return 0;
}
// `p: &mut Instance` in an extern declaration: a mutable borrow of a handle or bare pointer binding.
// Only a mutable borrow is a writable slot - `&H` would hand C a `const H *` it cannot store through.
fn ffi_out_param<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 7 {
        return false;
    }
    if ty_mode(&mut c, ty) == 0 {
        return false;
    }
    inner := ty_arg(&mut c, ty);
    return ffi_out_slot_type(&mut c, inner);
}
fn ffi_param<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    // u64 is the portable one-word type at index 0; i64/isize is the 64-bit signed
    // integer. Handles (kind 23) and CStr (kind 24) are one-word C pointers, and a
    // byte view (kind 5) is passed as pointer plus length.
    if ty == 0 {
        return ();
    }
    k := ty_kind(&mut c, ty);
    if (k == 18) & (ty_arg(&mut c, ty) == 64) {
        return ();
    }
    if (k == 23) || (k == 24) || (k == 5) || (k == 25) || (k == 26) {
        return ();
    }
    if k == 8 {
        // A record parameter is the C pointer to the struct's fields; Grail keeps
        // ownership of the allocation, so C must not free it.
        if c.decls[ty_arg(&mut c, ty)].c_layout != 0 {
            return ();
        }
    }
    if k == 7 {
        // A shared `&dyn I` is the C `const DynPair *`: one pointer to the 16-byte
        // `{data@0, vtable@8}` pair the handle already is (docs/design/fat-dyn.md), so it is the one
        // reference parameter that is a *reader* rather than an out-parameter. `&mut dyn I` is not
        // admitted: C writing a 16-byte pair is not part of the ABI.
        if (ty_mode(&mut c, ty) == 0) & (borrowed_object(&mut c, ty) != 0) {
            return ();
        }
        inner := ty_arg(&mut c, ty);
        if ffi_out_slot_type(&mut c, inner) {
            if ty_mode(&mut c, ty) != 0 {
                return ();
            }
            fail(&mut c, view("an extern C out-parameter needs &mut; a shared &H is the C const pointer"));
        }
        fail(
            &mut c,
            view("an extern C out-parameter must be &mut a handle, CPtr, CMutPtr or extern \"C\" record")
        );
    }
    fail(&mut c, what);
    return ();
}
fn ffi_result<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    // A result is one word: scalars, a C handle or a C string pointer. A byte view
    // result is rejected because C cannot produce a Grail view record.
    if (ty == 0) || (ty == 1) {
        return ();
    }
    k := ty_kind(&mut c, ty);
    if (k == 18) & (ty_arg(&mut c, ty) == 64) {
        return ();
    }
    if (k == 23) || (k == 24) || (k == 25) || (k == 26) {
        // A function-pointer result is how a dynamic loader hands back a resolved
        // symbol; the declaration states the signature the address is called with.
        return ();
    }
    fail(&mut c, what);
    return ();
}
// ---- C-layout records ----
// `extern record R { a: i64, b: i32 }` uses the C rules: natural alignment,
// padding between fields, tail padding to the record alignment, offsets equal to
// C's offsetof. Field access reads and writes exactly the field's width.
fn ffi_align_up(n: u64, a: u64) -> u64 {
    if a < 2 {
        return n;
    }
    r := n % a;
    if r == 0 {
        return n;
    }
    return n + a - r;
}
fn ffi_layout_fail<a>(c: (&a mut C)) -> unit {
    // Ordinary Grail records are heap pointers and cannot be embedded; extern records embed by
    // value (their bytes at the field's C offset).
    fail(&mut c, view("extern record fields must be 8/16/32/64-bit integers, f32, f64, handles, CStr or extern records"));
    return ();
}
fn is_c_record<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) != 8 {
        return 0;
    }
    d := ty_arg(&mut c, ty);
    if c.decls[d].is_enum != 0 {
        return 0;
    }
    return c.decls[d].c_layout;
}
fn ffi_field_align<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    if k == 32 {
        // An inline C array is aligned like its element.
        elem := ty_arg(&mut c, ty);
        return ffi_field_align(&mut c, elem);
    }
    // An embedded extern record: its bytes in place, with its own C alignment and size.
    if is_c_record(&mut c, ty) != 0 {
        inner := ty_arg(&mut c, ty);
        return ffi_record_align(&mut c, inner);
    }
    // f32 is C float (4 bytes), f64 is C double (8 bytes).
    if k == 21 {
        if is_f32(&mut c, ty) {
            return 4;
        }
        return 8;
    }
    if (k == 23) || (k == 24) || (k == 26) {
        return 8;
    }
    if k == 18 {
        bits := ty_arg(&mut c, ty);
        if (bits == 8) || (bits == 16) || (bits == 32) || (bits == 64) {
            return bits / 8;
        }
    }
    ffi_layout_fail(&mut c);
    return 0;
}
fn ffi_field_size<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    if k == 32 {
        // An inline C array: N elements back to back.
        elem := ty_arg(&mut c, ty);
        return ffi_field_size(&mut c, elem) * ty_mode(&mut c, ty);
    }
    // An embedded extern record: its bytes in place, with its own C alignment and size.
    if is_c_record(&mut c, ty) != 0 {
        inner := ty_arg(&mut c, ty);
        return ffi_record_size(&mut c, inner);
    }
    // f32 is C float (4 bytes), f64 is C double (8 bytes).
    if k == 21 {
        if is_f32(&mut c, ty) {
            return 4;
        }
        return 8;
    }
    if (k == 23) || (k == 24) || (k == 26) {
        return 8;
    }
    if k == 18 {
        bits := ty_arg(&mut c, ty);
        if (bits == 8) || (bits == 16) || (bits == 32) || (bits == 64) {
            return bits / 8;
        }
    }
    ffi_layout_fail(&mut c);
    return 0;
}
fn ffi_record_align<a>(c: (&a mut C), d: u64) -> u64 {
    count := c.decls[d].count;
    mut a = 1;
    mut i = 0;
    while i < count {
        ty := field_ty(&mut c, d, i);
        x := ffi_field_align(&mut c, ty);
        if a < x {
            a = x;
        }
        i = i + 1;
    }
    return a;
}
fn ffi_record_size<a>(c: (&a mut C), d: u64) -> u64 {
    count := c.decls[d].count;
    mut off = 0;
    mut i = 0;
    while i < count {
        ty := field_ty(&mut c, d, i);
        al := ffi_field_align(&mut c, ty);
        off = ffi_align_up(off, al) + ffi_field_size(&mut c, ty);
        i = i + 1;
    }
    return ffi_align_up(off, ffi_record_align(&mut c, d));
}
// Allocation granule: the record size rounded up to whole eight-byte words.
fn ffi_record_words<a>(c: (&a mut C), d: u64) -> u64 {
    return ffi_align_up(ffi_record_size(&mut c, d), 8) / 8;
}
fn ffi_offset<a>(c: (&a mut C), d: u64, k: u64) -> u64 {
    mut off = 0;
    mut i = 0;
    while i < k {
        ty := field_ty(&mut c, d, i);
        al := ffi_field_align(&mut c, ty);
        off = ffi_align_up(off, al) + ffi_field_size(&mut c, ty);
        i = i + 1;
    }
    ty := field_ty(&mut c, d, k);
    return ffi_align_up(off, ffi_field_align(&mut c, ty));
}
fn ffi_field<a>(c: (&a mut C), ty: u64) -> unit {
    ffi_field_size(&mut c, ty);
    return ();
}
fn ffi_record<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("record"));
    mut at_name = c.pos;
    name := ident(&mut c);
    declared := position_text(&mut c, at_name);
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    if pass != 2 {
        if pass == 1 {
            m := module_copy(&mut c);
            refuse_duplicate_type(&mut c, view("extern record"), view(m), view(name), at_name);
            item_public_5 := c.decl_public;
            c
                .decls
                .push(
                    Decl {
                        public: item_public_5,
                        module: m,
                        name: name, declared_at: declared,
                        is_enum: 0,
                        opaque: 0,
                        transfer: 0,
                        share: 0,
                        c_layout: 1,
                        first: 0,
                        count: 0,
                        drop: 0,
                        regions: 0,
                        types: 0,
                        success: 0,
                        bounds: u64[],
                        constraints: u64[][],
                    }
                );
        }
        while !is(&mut c, view("}")) {
            if kind(&mut c) == 0 {
                fail(&mut c, view("unterminated extern record"));
            }
            advance(&mut c);
        }
        advance(&mut c);
        eat(&mut c, view(";"));
        return ();
    }
    m := module_copy(&mut c);
    d := find_decl(&mut c, view(m), view(name));
    if d == 0 {
        fail(&mut c, view("unknown extern record"));
    }
    mut pending = Field[];
    mut count = 0;
    expect(&mut c, view("{"));
    if !eat(&mut c, view("}")) {
        while true {
            f := ident(&mut c);
            expect(&mut c, view(":"));
            ty := parse_type(&mut c);
            ffi_field(&mut c, ty);
            pending.push(Field { name: f, ty: ty, pred: no_pred() });
            count = count + 1;
            if eat(&mut c, view("}")) {
                break;
            }
            expect(&mut c, view(","));
            if eat(&mut c, view("}")) {
                break;
            }
        }
    }
    eat(&mut c, view(";"));
    mut reverse = Field[];
    while pending.len() != 0 {
        reverse.push(pending.pop()!);
    }
    first := c.fields.len();
    while reverse.len() != 0 {
        c.fields.push(reverse.pop()!);
    }
    carried := c.decls[d - 1].declared_at.copy();
    exchange(
        &mut c.decls[d - 1],
        Decl {
            public: c.decl_public,
            module: m,
            name: name, declared_at: carried,
            is_enum: 0,
            opaque: 0,
            transfer: 0,
            share: 0,
            c_layout: 1,
            first: first,
            count: count,
            drop: 0,
            regions: 0,
            types: 0,
            success: 0,
            bounds: u64[],
            constraints: u64[][],
        }
    );
    return ();
}
fn export_name<a, b, d, e>(c: (&a mut C), m: &b [u8], n: &d [u8], symbol: &e [u8], export: u64) -> unit {
    if export == 2 {
        // The C symbol may differ from the Grail name (`as "name"`). Mach-O C symbols carry a
        // leading underscore, which references already get (darwin_line) and definitions must too.
        if c.plat == 1 {
            c.out.push(95);
        }
        o(&mut c, symbol);
        return ();
    }
    mangle(&mut c, view(m), view(n));
    if c.proved_label != 0 {
        o(&mut c, view(".proved"));
    }
    return ();
}
// Does the declaration at `start` (the `fn` keyword) have a body? Scans to the first
// `{` or `;` at bracket depth zero, so a body can be handed to the normal function
// parser and a plain declaration stays a declaration.
fn extern_has_body<a>(c: (&a mut C), start: u64) -> u64 {
    mut i = start;
    mut depth = 0;
    while i < c.toks.len() {
        k := kind_at(&mut c, i);
        if (k == 40) || (k == 60) || (k == 91) {
            depth += 1;
        }
        if (k == 41) || (k == 62) || (k == 93) {
            if depth == 0 {
                // A closer with no opener: not a declaration this scan can read. The parser that
                // follows reports it where it is.
                return 0;
            }
            depth -= 1;
        }
        if depth == 0 {
            if k == 123 {
                return 1;
            }
            if (k == 59) || (k == 125) {
                return 0;
            }
        }
        i += 1;
    }
    return 0;
}
fn ffi_string<a, b>(c: (&a mut C), what: &b [u8]) -> u8[] {
    if kind(&mut c) != 3 {
        fail(&mut c, what);
    }
    p := c.pos;
    advance(&mut c);
    return decode_literal(&mut c, p);
}
fn ffi_link<a, b>(c: (&a mut C), input: &b [u8]) -> unit {
    // The link request is program-wide (it is emitted once, at the head of the stream), but an
    // interface has to know which module asked for it so a build that reads the module's
    // declarations instead of its source still asks the linker for the same input.
    fn_use(&mut c, FN_LINK);
    c.lib_owner.push(module_copy(&mut c));
    for i in c.libs.len() {
        if same(view(c.libs[i]), view(input)) {
            return ();
        }
    }
    c.libs.push(input.copy());
    return ();
}
// `&self`, `&mut self` and `self` at the start of a signature's parameter list: the receiver
// shorthand, desugared to `self: (&__self Self)`, `self: (&mut __self Self)` and `self: Self`.
// Consumes the tokens and returns (1, ty), or (0, 0) when an ordinary `name: type` follows. The
// region is fresh per method - the weakest relation that typechecks - and `Self` is the impl's type
// or the interface's own parameter, exactly what the written-out form spells.
// The reference type a `&self` / `&mut self` receiver has, for an impl whose owner is `owner`: the
// written `(&__self Self)`. A slice owner *is* a reference already (`&[T]` is kind 27, `&[u8]` kind
// 5), so `&self` on it is that slice reference with the method's fresh region - not a reference to a
// slice reference, which no value has.
fn receiver_reference<a>(c: (&a mut C), owner: u64, mode: u64, r: u64) -> u64 {
    mut rs = u64[];
    rs.push(r);
    k := ty_kind(&mut c, owner);
    if (k == 27) || (k == 5) {
        return intern_full(&mut c, k, ty_arg(&mut c, owner), mode, rs);
    }
    return intern_full(&mut c, 7, owner, mode, rs);
}
fn receiver_shorthand<a>(c: (&a mut C)) -> (u64, u64) {
    mut receiver = 0;
    if is(&mut c, view("&")) {
        receiver = 1;
    } else {
        if (kind(&mut c) == 1) & is_at(&mut c, c.pos, view("self")) {
            next := kind_at(&mut c, c.pos + 1);
            if (next == 41) || (next == 44) || (next == 59) {
                receiver = 2;
            }
        }
    }
    if receiver == 0 {
        return (0, 0);
    }
    if c.self_type == NO_TYPE {
        // Not `expected a name here`: the form is spelled right and is in the wrong place.
        fail(
            &mut c,
            view(
                "a receiver belongs to a method: `&self`, `&mut self` and `self` are written only in an `impl` block or an interface method, and a free function takes ordinary `name: type` parameters"
            )
        );
    }
    // The impl's type with this instantiation's arguments, exactly as the `Self` in a written
    // receiver is resolved: a replayed method of `impl<T> T[]` must see `T` bound, not the template.
    mut st = c.self_type;
    if c.bindings.len() != 0 {
        st = bind_types(&mut c, st, &copy_numbers(&c.bindings));
    }
    if receiver == 2 {
        advance(&mut c);
        return (1, st);
    }
    advance(&mut c);
    mut mode = 0;
    if eat(&mut c, view("mut")) {
        mode = 1;
    }
    word := ident(&mut c);
    if !same(view(word), view("self")) {
        fail(&mut c, view("`&` at the start of a parameter list is a receiver: write `&self` or `&mut self`"));
    }
    r := fresh_lifetime(&mut c);
    note_input_region(&mut c, r);
    return (1, receiver_reference(&mut c, st, mode, r));
}
fn extern_declaration<a>(c: (&a mut C), pass: u64, public: u64) -> unit {
    position := c.pos;
    expect(&mut c, view("extern"));
    abi := ffi_string(&mut c, view("extern requires a quoted ABI name"));
    if !same(view(abi), view("C")) {
        fail(&mut c, view("only extern \"C\" declarations are supported"));
    }
    mut input = u8[];
    mut symbol = u8[];
    mut blocking = 0;
    mut nonblocking = 0;
    while true {
        if eat(&mut c, view("nonblocking")) {
            // `extern "C" nonblocking fn ...`: the call never blocks (math, an engine API that only
            // records commands). It is a bare call; if it does block after all, the cost is latency -
            // its worker is held - never safety.
            nonblocking = 1;
        } else if eat(&mut c, view("blocking")) {
            // `extern "C" blocking fn ...`: the call may block for long (a read, a wait, a
            // vkQueuePresentKHR): on a worker it gives the worker to a spare thread for its duration.
            blocking = 1;
        } else if eat(&mut c, view("lib")) {
            input = ffi_string(&mut c, view("lib requires a quoted link input"));
        } else {
            if eat(&mut c, view("as")) {
                symbol = ffi_string(&mut c, view("as requires a quoted C symbol name"));
            } else {
                break;
            }
        }
    }
    if (0 < input.len()) & (symbol.len() == 0) & is(&mut c, view(";")) {
        // `extern "C" lib "c";`: a library this module needs linked although it calls nothing in
        // it directly - the C runtime a C++ shim it binds expects, say. A PE import names a symbol,
        // so on Windows there is nothing to request.
        advance(&mut c);
        if (c.target != 3) & (c.target != 4) {
            ffi_link(&mut c, view(input));
        }
        return ();
    }
    if is(&mut c, view("record")) {
        if 0 < input.len() + symbol.len() {
            fail(&mut c, view("extern record takes no lib or as clause"));
        }
        ffi_record(&mut c, pass);
        return ();
    }
    fn_position := c.pos;
    body := extern_has_body(&mut c, fn_position);
    expect(&mut c, view("fn"));
    name := ident(&mut c);
    if body != 0 {
        // `extern "C" fn name(...) -> R { ... }` defines a Grail function that C can
        // call: it is emitted with the stated (unmangled) symbol and its signature
        // must sit inside the C ABI slice. The normal function parser emits the body.
        mut exported = symbol;
        if exported.len() == 0 {
            exported = name.copy();
        }
        exchange(&mut c.pending_ext, 2);
        exchange(&mut c.pending_symbol, exported);
        exchange(&mut c.pos, fn_position);
        func(&mut c, pass, public);
        exchange(&mut c.pending_ext, 0);
        exchange(&mut c.pending_symbol, u8[]);
        return ();
    }
    if pass != 2 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        expect(&mut c, view(";"));
        return ();
    }
    if symbol.len() == 0 {
        symbol = name.copy();
    }
    if (blocking != 0) & (nonblocking != 0) {
        fail(&mut c, view("a foreign function is `blocking` or `nonblocking`, not both"));
    }
    if blocking != 0 {
        c.ffi_blocking.push(symbol.copy());
    }
    if nonblocking != 0 {
        c.ffi_nonblocking.push(symbol.copy());
    }
    // Byte-view parameters need an input lifetime context, exactly like a Grail
    // function signature; the region is irrelevant to the C ABI.
    exchange(&mut c.input_regions, u64[]);
    exchange(&mut c.receiver_region, 0);
    exchange(&mut c.parsing_input, 1);
    first := c.params.len();
    mut count = 0;
    mut words = 0;
    mut variadic = 0;
    // The fixed parameters' names, so a call can name its slots exactly as a Grail declaration's can
    // (docs/design/named-arguments.md). The `...` has no parameter and so no name.
    mut pnames = u8[][];
    expect(&mut c, view("("));
    if !eat(&mut c, view(")")) {
        while true {
            // `...` ends the fixed parameters of a variadic C function (printf-style).
            if eat(&mut c, view(".")) {
                expect(&mut c, view("."));
                expect(&mut c, view("."));
                if count == 0 {
                    fail(&mut c, view("a variadic extern C function needs at least one fixed parameter"));
                }
                variadic = 1;
                expect(&mut c, view(")"));
                break;
            }
            p := ident(&mut c);
            expect(&mut c, view(":"));
            mut ty = 0;
            if ffi_byval_ahead(&mut c) {
                advance(&mut c);
                ty = ffi_byval_parameter(&mut c);
            } else {
                ty = parse_type(&mut c);
            }
            ffi_direct_param(
                &mut c,
                ty,
                view("extern C parameters must be an integer, f32, f64, CStr, handle, byte view, cfn, extern record or byval record")
            );
            words = words + ffi_words(&mut c, ty);
            c.params.push(ty);
            pnames.push(p.copy());
            count = count + 1;
            if eat(&mut c, view(")")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    if 64 < words {
        fail(&mut c, view("extern C declaration exceeds 64 argument words"));
    }
    mut ret = 1;
    if eat(&mut c, view("->")) {
        ret = parse_type(&mut c);
        ffi_direct_result(&mut c, ret, view("extern C results must be an integer, f32, f64, unit, CStr, handle or cfn"));
    }
    expect(&mut c, view(";"));
    m := module_copy(&mut c);
    if find_func(&mut c, view(m), view(name)) != 0 {
        fail(&mut c, view(duplicate_msg(&mut c, view(name))));
    }
    if 0 < input.len() {
        if (c.target == 3) || (c.target == 4) {
            // A PE image binds each symbol to one DLL through the import table, so Windows tooling
            // needs the pair, not just the library: `// grail-link: import kernel32 LoadLibraryA`.
            mut note = u8[];
            push_bytes(&mut note, view("import "));
            push_bytes(&mut note, view(input));
            note.push(32);
            push_bytes(&mut note, view(symbol));
            ffi_link(&mut c, view(note));
        } else {
            ffi_link(&mut c, view(input));
        }
    }
    item_public_7 := c.decl_public;
    item_home_7 := module_copy(&mut c);
    c
        .funcs
        .push(
            Func {
                public: item_public_7,
                home: item_home_7,
                module: m,
                name: name,
                first: first,
                count: count,
                ret: ret,
                types: 0,
                regions: 0,
                file: c.file,
                pos: position,
                raw: c.raw,
                unsafe_fn: 0,
                bounds: u64[],
                constraints: u64[][],
                contract: 0,
                owner: 0,
                ext: 1 + variadic,
                symbol: symbol,
                body: u8[],
                ppreds: Pred[],
                rpred: no_pred(),
                pnames: copy_names(&pnames),
                pdefaults: Pred[],
                strict: 0,
                no_alloc: 0,
                no_panic: 0,
            }
        );
    return ();
}
// ---- the per-function codegen cache (docs/design/incremental-compilation.md) ---------------------
//
// A *unit* is one emitted function: the bytes `func` writes for it, the label numbers those bytes
// name, and the typed-IR facts its emission recorded. It is filed under a key that names every
// input those bytes are a function of, and replayed by copying them back when the key is found
// again - for that body the front end, the lowering and the emission are all skipped. The rule for
// which bodies are units, and why the rest are not, is written down in
// docs/design/incremental-compilation.md ("Per-function units"); `tools/cache-test.mjs` measures
// what it buys and compares every rebuilt image with a clean build's.
struct FnPlace {
    line: u64,
    col: u64
}

// Whether this run can file units at all: the directory the driver named, and a run-level shape
// this layer can describe. Every other condition is a property of the whole run, not of a body.
fn fn_on<a>(c: (&a C)) -> bool {
    // Units are made for the store, or to come back from a body worker (par_start).
    if (c.fn_dir.len() == 0) & (c.par_on == 0) {
        return false;
    }
    // No surface, no units: it is empty when a declaration had no interface spelling, and a key
    // that cannot say what the module declares is a key that would reuse a body on a guess.
    if c.fn_surface.len() == 0 {
        return false;
    }
    // The Linux x86-64 word stream is the shape this layer re-emits. A debug build inspects the
    // whole stream for line tables, the LLVM backend lifts it, and the PE/Mach-O writers rewrite it
    // after selection; the ARM and RISC-V selection is not what this cache was measured on.
    if (c.plat != 0) | (c.target != 0) | (c.debug != 0) | (c.backend != 0) | (c.emit_ir != 0) {
        return false;
    }
    // `--export` counts the definitions that matched it, and a replayed body is one it never sees.
    if c.exports.len() != 0 {
        return false;
    }
    // A validating run throws its code away.
    if c.validating != 0 {
        return false;
    }
    return true;
}

// Whether this body is a unit at its entry: the run can file units, this is not a specialisation
// replay (a later stage keys those by their own identity), and the part marker is already open -
// the first body of a part writes `.grail_part` and `.text` inside its own bytes.
fn fn_open<a, b>(c: (&a mut C), unit: &b [u8]) -> bool {
    if !fn_on(&c) {
        return false;
    }
    if c.current_spec != 0 {
        return false;
    }
    return true;
}

// Where a declaration starts, as `.gpos` will print it: its line and column in its file. Bodies are
// walked in source order, so the cursor moves forward; a position before it (a replay) restarts.
// The line and column are what makes a body edit inside one function leave every *later* function's
// key alone: byte offsets would shift with it, positions do not.
fn fn_place<a>(c: (&a mut C), pos: u64) -> FnPlace {
    mut st: u64 = 0;
    if c.toks.len() <= pos {
        return FnPlace { line: 0, col: 0 };
    }
    st = c.toks[pos].start;
    if (c.fn_at_file != c.file) | (st < c.fn_at_off) {
        exchange(&mut c.fn_at_file, c.file);
        exchange(&mut c.fn_at_off, 0);
        exchange(&mut c.fn_at_line, 1);
        exchange(&mut c.fn_at_col, 1);
    }
    mut line = c.fn_at_line;
    mut col = c.fn_at_col;
    mut i = c.fn_at_off;
    while (i < st) & (i < c.src.len()) {
        if c.src[i] == 10 {
            line += 1;
            col = 1;
        } else {
            col += 1;
        }
        i += 1;
    }
    exchange(&mut c.fn_at_off, st);
    exchange(&mut c.fn_at_line, line);
    exchange(&mut c.fn_at_col, col);
    return FnPlace { line: line, col: col };
}

// The rules that keep a body from being a unit in this pass, as indices into `fn_uses`/`fn_why`.
// Each is something the body hands the run that a unit does not record, so a replay that skipped it
// would leave a later step without it: a closure body, a vtable, a link input, a constant, the fn
// thunk and an effect record are emitted or settled later; a synthesised declaration (a tuple, a
// result union, a closure environment) changes the declaration table the bodies after it start
// with; a position spelled as text names a line of the file. Drop helpers and specialisations are
// not here: a unit records those and a replay asks again (fn_reg_drop, fn_reg_spec).
const FN_CLOSURE: u64 = 0;
const FN_VTABLE: u64 = 1;
const FN_LINK: u64 = 2;
const FN_CONSTANT: u64 = 3;
const FN_THUNK: u64 = 4;
const FN_ABSOLUTE: u64 = 5;
const FN_DECLARATION: u64 = 6;
const FN_UNSPELLED: u64 = 7;
const FN_FIRST: u64 = 8;
const FN_EFFECT: u64 = 9;
fn fn_rule_name(rule: u64) -> string {
    if rule == FN_CLOSURE {
        return "closure";
    }
    if rule == FN_VTABLE {
        return "vtable";
    }
    if rule == FN_LINK {
        return "link input";
    }
    if rule == FN_CONSTANT {
        return "constant";
    }
    if rule == FN_THUNK {
        return "fn thunk";
    }
    if rule == FN_ABSOLUTE {
        return "absolute position";
    }
    if rule == FN_DECLARATION {
        return "synthesised declaration";
    }
    if rule == FN_UNSPELLED {
        return "unspellable type";
    }
    if rule == FN_FIRST {
        return "first of part";
    }
    return "effect record";
}
// The body being emitted did something rule `rule` names. Every use counts, not only the first of
// the run: a body that uses a vtable an earlier body registered depends on it exactly as much.
fn fn_use<a>(c: (&a mut C), rule: u64) -> unit {
    c.fn_uses[rule] = c.fn_uses[rule] + 1;
    return ();
}
// Where every rule stands; a body is a unit when none of them moved while it was emitted.
fn fn_marks<a>(c: (&a C)) -> u64[] {
    mut m = c.fn_uses.copy();
    m[FN_CLOSURE] = c.closures.len();
    m[FN_CONSTANT] = c.constants.len();
    m[FN_DECLARATION] = c.decls.len();
    // An effect record is not here any more: a unit carries its body's (fx_unit_record).
    m[FN_EFFECT] = 0;
    return m;
}
// A type as a registration spells it: structurally, the way an interface does. False when the type
// has no such spelling.
fn fn_spell<a>(c: (&a mut C), out: (&a mut u8[]), ty: u64) -> bool {
    mut deps = u64[];
    old_lenient := exchange(&mut c.spell_lenient, 1);
    old_failed := exchange(&mut c.spell_failed, 0);
    iface_w_type(&mut c, &mut out, &mut deps, ty);
    failed := c.spell_failed;
    exchange(&mut c.spell_lenient, old_lenient);
    exchange(&mut c.spell_failed, old_failed);
    return failed == 0;
}
// The body names type `ty`'s drop helper: registration `1 <type>`.
fn fn_reg_drop<a>(c: (&a mut C), ty: u64) -> unit {
    if c.fn_rec == 0 {
        return ();
    }
    mut rec = u8[];
    rec.push(1);
    if !fn_spell(&mut c, &mut rec, ty) {
        fn_use(&mut c, FN_UNSPELLED);
        return ();
    }
    push_bytes(&mut c.fn_regs, view(rec));
    c.fn_reg_types.push(ty);
    return ();
}
// The body asks for `template` instantiated at `map`: registration `2 <template> <n> <type>...`.
// The template is its index in the function table, which the declaration surface in the key fixes.
fn fn_reg_spec<a, b>(c: (&a mut C), template: u64, map: (&b u64[])) -> unit {
    if c.fn_rec == 0 {
        return ();
    }
    mut rec = u8[];
    rec.push(2);
    iface_wv(&mut rec, template);
    iface_wv(&mut rec, map.len());
    for i in map.len() {
        if !fn_spell(&mut c, &mut rec, map[i]) {
            fn_use(&mut c, FN_UNSPELLED);
            return ();
        }
    }
    push_bytes(&mut c.fn_regs, view(rec));
    for i in map.len() {
        c.fn_reg_types.push(map[i]);
    }
    return ();
}
// One registration, read back: `kind` 1 names the drop helper of `types[0]`, 2 asks for `template`
// at `types`.
struct FnReg {
    kind: u64,
    template: u64,
    types: u64[],
    // Kind 3: the body's effect record (fx_unit_record), replayed by fx_unit_replay.
    data: u8[]
}
// The registrations of a unit, with every type interned in this run. `ok` goes to 0 when a record is
// not one this compiler writes, and then nothing of the unit may be applied.
fn fn_regs_read<a, b, d>(c: (&a mut C), data: &b [u8], ok: (&d mut u64)) -> FnReg[] {
    mut out = FnReg[];
    if data.len() == 0 {
        return out;
    }
    return fn_regs_decode(&mut c, data, ok);
}
fn fn_regs_decode<a, b, d>(c: (&a mut C), data: &b [u8], ok: (&d mut u64)) -> FnReg[] {
    mut out = FnReg[];
    mut p = IR { data: data.copy(), at: 0, stop: data.len(), path: copy_bytes(view("the unit store")), phase: 2, rtext: u8[], what: u8[] };
    while p.at < p.stop {
        kind := iface_r1(&mut p);
        if kind == 1 {
            ty := fn_reg_type(&mut p, &mut c);
            out.push(FnReg { kind: 1, template: 0, types: u64[ty], data: u8[] });
        } else if kind == 2 {
            template := iface_rv(&mut p);
            n := iface_rv(&mut p);
            if (c.funcs.len() <= template) | (p.stop < n) {
                exchange(ok, 0);
                return out;
            }
            mut types = u64[];
            for i in n {
                types.push(fn_reg_type(&mut p, &mut c));
            }
            out.push(FnReg { kind: 2, template: template, types: types, data: u8[] });
        } else if kind == 3 {
            data := iface_rs(&mut p);
            out.push(FnReg { kind: 3, template: 0, types: u64[], data: data });
        } else {
            exchange(ok, 0);
            return out;
        }
    }
    return out;
}
// One type of a registration. Bodies name the same types over and over (a string's drop helper,
// `same<u64>`), and reading a spelling interns it: the same bytes are the same type every time in
// a run, so a spelling read once is looked up by its bytes after that.
fn fn_reg_type<a, b>(p: (&a mut IR), c: (&b mut C)) -> u64 {
    start := p.at;
    // A type record is its tag, its length and that many bytes (iface_w_type).
    mut at = start + 1;
    mut len = 0;
    mut scale = 1;
    while (at < p.stop) && (scale < 72057594037927936) {
        b := u64(p.data[at]);
        at += 1;
        len = len + (b & 127) * scale;
        if (b & 128) == 0 {
            break;
        }
        scale = scale * 128;
    }
    end := at + len;
    if (p.stop < end) || (p.stop <= start) {
        return iface_r_type(&mut p, &mut c);
    }
    found := names_find(&mut c.reg_slots, &mut c.reg_keys, &c.reg_blobs, p.data[start..end]);
    if found != 0 {
        p.at = end;
        return c.reg_types[found - 1];
    }
    ty := iface_r_type(&mut p, &mut c);
    if p.at == end {
        c.reg_blobs.push(p.data[start..end].copy());
        c.reg_types.push(ty);
    }
    return ty;
}
// PRODUCE, the last step: what the body just emitted handed the run, as a unit. The text starts
// after the body's `.gbase` line; the facts are the ones recorded since `fact_mark`; the
// registrations are the ones `fn_reg_drop` and `fn_reg_spec` wrote down.
fn fn_unit_of<a>(c: (&a mut C), key: u8[], text_mark: u64, fact_mark: u64) -> fncache::Unit {
    // A check's unit has no text and no facts: a check writes neither, and a build refuses it.
    if c.check_only != 0 {
        return fncache::Unit { key: key, text: u8[], facts: u8[], regs: c.fn_regs.copy() };
    }
    mut text = u8[];
    text.append(c.out[text_mark..c.out.len()]);
    return fncache::Unit { key: key, text: text, facts: fn_facts_encode(&c, fact_mark), regs: c.fn_regs.copy() };
}
// APPLY: put a unit into the run, as the next function of the current part. The function takes its
// ordinal, states the line its positions count from, and then the unit is everything else: its
// text, its facts, and its registrations made again through the calls a fresh emission makes
// (drop_ref_name, specialize) - so the drop walk and the specialisation queue see the same requests
// in the same order whether the body was compiled in this run or in an earlier one.
fn fn_apply<a, b, d>(c: (&a mut C), u: (&b fncache::Unit), regs: (&d FnReg[]), line: u64, at: u64, claim_alloc: u64, claim_panic: u64) -> unit {
    k := c.lunit;
    if (k != 0) & (k <= c.fnext.len()) {
        c.fnext[k - 1] = c.fnext[k - 1] + 1;
    }
    if site_table_on(&c) {
        c.plan_at.push(c.out.len());
        site_base(&mut c, line);
    }
    text_at := c.out.len();
    // The body's opening line, for the cut planning (optimize::plan_from): within its first lines.
    mut k = 0;
    mut seen = 0;
    mut open = 0;
    mut found = 0;
    while (k + 6 < u.text.len()) & (seen < 4) {
        if (u.text[k] == 46) & (u.text[k + 1] == 116) & (u.text[k + 2] == 121) & (u.text[k + 3] == 112) & (u.text[k + 4] == 101) & (u.text[k + 5] == 32) {
            open = c.out.len() + k;
            found = 1;
            c.plan_at.push(open);
            break;
        }
        while (k < u.text.len()) & (u.text[k] != 10) {
            k += 1;
        }
        k += 1;
        seen += 1;
    }
    // And its closing line, the frame constant's `.set`, near the end: the optimiser takes the body
    // from these two lines and keys its memo by the unit (ir::Known); it checks both.
    if found != 0 {
        mut q = u.text.len();
        mut lines = 0;
        while (6 < q) & (lines < 64) {
            // `q` is the end of a line; its start is after the newline before it.
            mut p = q - 1;
            while (0 < p) && (u.text[p - 1] != 10) {
                p -= 1;
            }
            if (q - p > 6) & (u.text[p] == 46) & (u.text[p + 1] == 115) & (u.text[p + 2] == 101) & (u.text[p + 3] == 116) & (u.text[p + 4] == 32) & (u.text[p + 5] == 46) {
                // The frame's size is the number after the comma: a frame over a page asks the run
                // for stack probes (frame_limit), which a body compiled here would have asked for.
                mut size = 0;
                mut after = false;
                for x in p..q {
                    ch := u.text[x];
                    if ch == 44 {
                        after = true;
                    } else if after & (48 <= ch) & (ch <= 57) {
                        size = size * 10 + u64(ch - 48);
                    }
                }
                if 4096 < size {
                    exchange(&mut c.probes, 1);
                }
                c.known.open.push(open);
                c.known.end.push(c.out.len() + q);
                c.known.key.push(fncache::hash(view(u.key)));
                break;
            }
            if p == 0 {
                break;
            }
            q = p;
            lines += 1;
        }
    }
    // A check keeps no text and runs no optimiser, so a unit's text and facts are not put back.
    if c.check_only == 0 {
        c.out.append(view(u.text));
        fn_facts_restore(&mut c, view(u.facts));
    }
    for i in regs.len() {
        kind := regs[i].kind;
        template := regs[i].template;
        types := regs[i].types.copy();
        if kind == 1 {
            // What drop_ref_name does, without the copy of the name it returns: the helper is
            // requested, and its name is made now - making it can ask for a generic `Drop`
            // implementation's specialisation, and that request has to come at this point.
            c.drop_refs.push(types[0]);
            drop_symbol_known(&mut c, types[0]);
        } else if kind == 3 {
            fx_unit_replay(&mut c, view(regs[i].data), text_at, at, claim_alloc, claim_panic);
        } else {
            specialize(&mut c, template, &types);
        }
    }
    exchange(&mut c.hints, u64[]);
    return ();
}

// A unit's effect record: what the body's emission recorded (its own facts, its entry checks, its
// call edges and the count the IR check holds them to), so a replay hands the solver exactly what
// compiling the body would. Positions are kept relative - an edge's token to the `fn` token -
// because the unit is reused where lines above it moved. The
// claim is not kept: it is an attribute outside the unit's key text, so a replay takes it from the
// declaration as this run parsed it.
fn fx_unit_record<a, b>(c: (&a mut C), sym: &b [u8], text_mark: u64, at: u64, edge_at: u64) -> u8[] {
    k := fx_find(&mut c, view(sym));
    if (k == 0) || (c.fx_body_sym.len() == 0) {
        return u8[];
    }
    kk := k - 1;
    // The body's own entry, the latest one under its symbol: a refined function's unit holds two
    // bodies, `<sym>.proved` and its wrapper `<sym>`, each with its own record.
    mut last = c.fx_body_sym.len();
    mut i = c.fx_body_sym.len();
    while 0 < i {
        i -= 1;
        if same(view(c.fx_body_sym[i]), view(sym)) {
            last = i;
            break;
        }
    }
    if last == c.fx_body_sym.len() {
        return u8[];
    }
    mut out = u8[];
    iface_ws(&mut out, view(sym));
    iface_ws(&mut out, view(c.fx_fn_name[kk]));
    iface_w1(&mut out, c.fx_own_alloc[kk]);
    iface_w1(&mut out, c.fx_own_panic[kk]);
    iface_w1(&mut out, c.fx_entry_panic[kk]);
    iface_wv(&mut out, c.fx_body_calls[last]);
    mut n = 0;
    mut edges = u8[];
    for e in edge_at..c.fx_edge_from.len() {
        if c.fx_edge_from[e] != kk {
            continue;
        }
        iface_ws(&mut edges, view(c.fx_edge_name[e]));
        iface_wv(&mut edges, c.fx_edge_kind[e]);
        iface_ws(&mut edges, view(c.fx_edge_why[e]));
        mut delta = 0;
        if at <= c.fx_edge_pos[e] {
            delta = c.fx_edge_pos[e] - at;
        }
        iface_wv(&mut edges, delta);
        n += 1;
    }
    iface_wv(&mut out, n);
    push_bytes(&mut out, view(edges));
    return out;
}
// The record of a replayed body, put back as `fx_begin`, `fx_edge` and `fx_end` would have left it.
fn fx_unit_replay<a, b>(c: (&a mut C), data: &b [u8], text_at: u64, at: u64, claim_alloc: u64, claim_panic: u64) -> unit {
    mut p = IR { data: copy_bytes(view(data)), at: 0, stop: data.len(), path: copy_bytes(view("the unit store")), phase: 2, rtext: u8[], what: u8[] };
    sym := iface_rs(&mut p);
    shown := iface_rs(&mut p);
    own_a := iface_r1(&mut p);
    own_p := iface_r1(&mut p);
    entry := iface_r1(&mut p);
    calls := iface_rv(&mut p);
    k := fx_sym(&mut c, view(sym)) - 1;
    c.fx_body[k] = 1;
    c.fx_row[k] = 0;
    c.fx_alloc_thru[k] = 0;
    c.fx_panic_thru[k] = 0;
    c.fx_own_alloc[k] = own_a;
    c.fx_own_panic[k] = own_p;
    c.fx_entry_panic[k] = entry;
    if claim_alloc != 0 {
        c.fx_attr_alloc[k] = 1;
    }
    if claim_panic != 0 {
        c.fx_attr_panic[k] = 1;
    }
    c.fx_fn_name[k] = shown.copy();
    c.fx_fn_file[k] = c.file;
    c.fx_fn_pos[k] = at;
    n := iface_rv(&mut p);
    for i in n {
        name := iface_rs(&mut p);
        kind := iface_rv(&mut p);
        why := iface_rs(&mut p);
        delta := iface_rv(&mut p);
        c.fx_edge_from.push(k);
        c.fx_edge_name.push(name);
        c.fx_edge_to.push(0);
        c.fx_edge_kind.push(kind);
        c.fx_edge_file.push(c.file);
        c.fx_edge_pos.push(at + delta);
        c.fx_edge_why.push(why);
    }
    c.fx_body_sym.push(sym.copy());
    c.fx_body_calls.push(calls);
    return ();
}
// The key of one unit: a text record naming every input its bytes are a function of.
//
//   the unit (part) it is emitted into and the label prefix that part mints labels in;
//   the symbol the label spells;
//   the option vector (`--fn-cache` and the output path left out: nothing in the text is theirs);
//   the run's declaration surface (fn_surface_now: every name, type, layout and signature, no body);
//   the declaration's own source text, from `fn` to the closing brace;
//   its typed signature, spelled structurally (`iface_w_type`) after substitution;
//   the file's index and the column it starts at, which `.gpos` prints (the line is not here: a
//   body counts its positions from its own first line, which `.gbase` states outside its text);
//   its ordinal among the functions of its unit, which its labels spell.
// Not the number of declarations it starts with: no body's text depends on it, which
// `--shift-declarations` checks over the whole corpus (`tools/test-native.mjs --unit-identity`).
//
// An empty key means "not a unit": a type with no interface spelling cannot be named, and a unit
// keyed by a partial signature would be reused on a guess.
fn fn_key<a, b, d>(c: (&a mut C), unit: &b [u8], symbol: &d [u8], from: u64, to: u64, at: u64, count: u64, ret: u64) -> u8[] {
    mut sig = u8[];
    mut deps = u64[];
    old_lenient := exchange(&mut c.spell_lenient, 1);
    old_failed := exchange(&mut c.spell_failed, 0);
    for i in count {
        ty := c.locals[i].ty;
        iface_w_type(&mut c, &mut sig, &mut deps, ty);
    }
    iface_w_type(&mut c, &mut sig, &mut deps, ret);
    mut failed = c.spell_failed;
    exchange(&mut c.spell_lenient, old_lenient);
    exchange(&mut c.spell_failed, old_failed);
    if failed != 0 {
        return u8[];
    }
    place := fn_place(&mut c, at);
    mut key = u8[];
    push_bytes(&mut key, view("grail-fnkey 4\nunit "));
    push_bytes(&mut key, view(unit));
    push_bytes(&mut key, view("\nprefix "));
    push_bytes(&mut key, view(c.lpart));
    push_bytes(&mut key, view("\nsymbol "));
    push_bytes(&mut key, view(symbol));
    push_bytes(&mut key, view("\nflags "));
    push_bytes(&mut key, view(c.fn_flags));
    push_bytes(&mut key, view("\ncompiler "));
    push_bytes(&mut key, view(c.fn_id));
    push_bytes(&mut key, view("\nsurface "));
    push_bytes(&mut key, view(c.fn_surface));
    // The declaration and the signature as they are, each after its length: the key is hashed once,
    // for the file's name, rather than each piece being hashed into it first.
    push_bytes(&mut key, view("\ndecl "));
    push_bytes(&mut key, view(decimal_bytes(to - from)));
    key.push(32);
    key.append(c.src[from: to]);
    push_bytes(&mut key, view("\nsig "));
    push_bytes(&mut key, view(decimal_bytes(sig.len())));
    key.push(32);
    key.append(view(sig));
    push_bytes(&mut key, view("\nfile "));
    push_bytes(&mut key, view(decimal_bytes(c.file)));
    push_bytes(&mut key, view("\ncolumn "));
    push_bytes(&mut key, view(decimal_bytes(place.col)));
    push_bytes(&mut key, view("\nordinal "));
    push_bytes(&mut key, view(decimal_bytes(scope_next(&c))));
    push_bytes(&mut key, view("\nraw "));
    push_bytes(&mut key, view(decimal_bytes(c.raw)));
    key.push(10);
    return key;
}

// The declaration surface of this run: every declaration, alias, function signature, constant,
// import, interface and implementation, with no body among them. A body's emitted bytes are a
// function of this - a field offset, a drop bit, a symbol spelling and a constant's value all reach
// the text as numbers - so a change here invalidates every unit of the module, while an edit inside
// one body does not. The interfaces this run read contribute their surface (every byte before the
// trailer, which carries only source digests), exactly as the module key's own rule does.
fn fn_surface_now<a>(c: (&a mut C)) -> u8[] {
    mut out = u8[];
    old_lenient := exchange(&mut c.spell_lenient, 1);
    old_failed := exchange(&mut c.spell_failed, 0);
    mut deps = u64[];
    for i in c.decls.len() {
        m := c.decls[i].module.copy();
        n := c.decls[i].name.copy();
        iface_ws(&mut out, view(m));
        iface_ws(&mut out, view(n));
        iface_wv(&mut out, c.decls[i].is_enum);
        iface_wv(&mut out, c.decls[i].opaque);
        iface_wv(&mut out, c.decls[i].transfer);
        iface_wv(&mut out, c.decls[i].share);
        iface_wv(&mut out, c.decls[i].c_layout);
        iface_wv(&mut out, c.decls[i].drop);
        nf := c.decls[i].count;
        first := c.decls[i].first;
        iface_wv(&mut out, nf);
        for j in nf {
            fname := c.fields[first + j].name.copy();
            fty := c.fields[first + j].ty;
            iface_ws(&mut out, view(fname));
            iface_w_type(&mut c, &mut out, &mut deps, fty);
        }
    }
    for i in c.aliases.len() {
        m := c.aliases[i].module.copy();
        n := c.aliases[i].name.copy();
        pub := c.aliases[i].public;
        ty := c.aliases[i].ty;
        iface_ws(&mut out, view(m));
        iface_ws(&mut out, view(n));
        iface_wv(&mut out, pub);
        iface_w_type(&mut c, &mut out, &mut deps, ty);
    }
    for i in c.funcs.len() {
        m := c.funcs[i].module.copy();
        n := c.funcs[i].name.copy();
        home := c.funcs[i].home.copy();
        sym := c.funcs[i].symbol.copy();
        pub := c.funcs[i].public;
        npar := c.funcs[i].count;
        first := c.funcs[i].first;
        ret := c.funcs[i].ret;
        ext := c.funcs[i].ext;
        strict := c.funcs[i].strict;
        no_alloc := c.funcs[i].no_alloc;
        no_panic := c.funcs[i].no_panic;
        owner := c.funcs[i].owner;
        arity := c.funcs[i].types;
        iface_ws(&mut out, view(m));
        iface_ws(&mut out, view(n));
        iface_ws(&mut out, view(home));
        iface_ws(&mut out, view(sym));
        iface_wv(&mut out, pub);
        iface_wv(&mut out, ext);
        iface_wv(&mut out, strict);
        iface_wv(&mut out, no_alloc);
        iface_wv(&mut out, no_panic);
        iface_wv(&mut out, owner);
        iface_wv(&mut out, arity);
        iface_wv(&mut out, npar);
        for j in npar {
            pty := c.params[first + j];
            iface_w_type(&mut c, &mut out, &mut deps, pty);
        }
        iface_w_type(&mut c, &mut out, &mut deps, ret);
    }
    for i in c.constants.len() {
        m := c.constants[i].module.copy();
        n := c.constants[i].name.copy();
        text := c.constants[i].text.copy();
        pub := c.constants[i].public;
        ty := c.constants[i].ty;
        val := c.constants[i].value;
        if CT_PENDING <= ty {
            // A constant a compile-time call has yet to give: its value will reach the bodies that
            // name it, and nothing here can say what it will be - the function that computes it is
            // a body, and bodies are not part of the surface. No surface, no units.
            exchange(&mut c.spell_lenient, old_lenient);
            exchange(&mut c.spell_failed, old_failed);
            return u8[];
        }
        iface_ws(&mut out, view(m));
        iface_ws(&mut out, view(n));
        iface_ws(&mut out, view(text));
        iface_wv(&mut out, pub);
        iface_wv(&mut out, val);
        iface_w_type(&mut c, &mut out, &mut deps, ty);
    }
    // A static reaches a reader's text as its symbol and, through its type, as a load or a borrow;
    // its value and initialiser do not, so an edit to them rebuilds only the declaring module.
    for i in c.statics.len() {
        m := c.statics[i].module.copy();
        n := c.statics[i].name.copy();
        pub := c.statics[i].public;
        ty := c.statics[i].ty;
        iface_ws(&mut out, view("static"));
        iface_ws(&mut out, view(m));
        iface_ws(&mut out, view(n));
        iface_wv(&mut out, pub);
        iface_w_type(&mut c, &mut out, &mut deps, ty);
        // The prover reads an integer static's value and a table's length (stage 5), so a proof in a
        // reader's body, and the call it chose, depend on them.
        mut fact_kind = 0;
        mut fact = 0;
        static_fact(&mut c, i, &mut fact_kind, &mut fact);
        iface_wv(&mut out, fact_kind);
        iface_wv(&mut out, fact);
    }
    for i in c.imports.len() {
        m := c.imports[i].module.copy();
        n := c.imports[i].name.copy();
        iface_ws(&mut out, view(m));
        iface_ws(&mut out, view(n));
    }
    for i in c.interfaces.len() {
        m := c.interfaces[i].module.copy();
        n := c.interfaces[i].name.copy();
        pub := c.interfaces[i].public;
        methods := c.interfaces[i].methods.len();
        iface_ws(&mut out, view(m));
        iface_ws(&mut out, view(n));
        iface_wv(&mut out, pub);
        iface_wv(&mut out, methods);
    }
    for i in c.implementations.len() {
        m := c.implementations[i].module.copy();
        contract := c.implementations[i].contract;
        ty := c.implementations[i].ty;
        methods := c.implementations[i].methods.len();
        iface_ws(&mut out, view(m));
        iface_wv(&mut out, contract);
        iface_wv(&mut out, methods);
        iface_w_type(&mut c, &mut out, &mut deps, ty);
    }
    for i in c.iface_loaded_path.len() {
        p := c.iface_loaded_path[i].copy();
        text := host::read_file(view(p));
        iface_ws(&mut out, view(p));
        iface_ws(&mut out, view(iface_digest(view(iface_surface(view(text))))));
    }
    mut failed = c.spell_failed;
    exchange(&mut c.spell_lenient, old_lenient);
    exchange(&mut c.spell_failed, old_failed);
    if failed != 0 {
        // A declaration this compiler cannot spell: nothing in the run is keyed by the surface, so
        // nothing in it is a unit.
        return u8[];
    }
    return fncache::hash(view(out));
}

// The option vector as the driver spelled it: every argument except the output path (which reaches
// no emitted byte) and this layer's own directory. Hashing the words means a flag added later is in
// every unit's key by construction - the same argument `build_argv` rests on at the module level.
fn fn_flags_now<a>(c: (&a mut C)) -> u8[] {
    mut out = u8[];
    argc := host::argc();
    mut i = 0;
    while i < argc {
        w := host::arg(i);
        mut skip = 0;
        // The output path, and the path the compiler was started by: which compiler it is is the
        // `compiler` field of the key, not the spelling of its path (an absolute and a relative one
        // are one compiler).
        if (i == 1 + c.arg_offset) || (i == 0) {
            skip = 1;
        }
        // `--check` changes no body's text or registrations (a check stops after the bodies are
        // emitted), so a check's units and a build's are the same units.
        if same(view(w), view("--fn-cache")) || same(view(w), view("--fn-cache-id")) || same(view(w), view("--fn-cache-quiet")) || same(view(w), view("--check")) || same(view(w), view("--object")) {
            skip = 1;
        }
        if 0 < i {
            // `&` does not short-circuit, so the guard is its own branch: `i - 1` at 0 would wrap.
            prev := host::arg(i - 1);
            if same(view(prev), view("--fn-cache")) || same(view(prev), view("--fn-cache-id")) || same(view(prev), view("--object")) {
                skip = 1;
            }
        }
        if skip == 0 {
            iface_ws(&mut out, view(w));
        }
        i += 1;
    }
    // A hand-run compiler has no `--fn-cache-id`, so its executable stands in for one: the path it
    // is being run from, its size and its modification time. A unit is code *this* compiler emitted,
    // and replaying a previous compiler's would be exactly the stale splice this cache must not do.
    // With `--fn-cache-id` the driver has named the compiler by its content, and a binary renamed
    // into place again (same bytes, new time) is the same compiler.
    if c.fn_id.len() != 0 {
        return fncache::hash(view(out));
    }
    exe := host::exe_path();
    push_bytes(&mut out, view("exe "));
    push_bytes(&mut out, view(exe));
    parts := host::stat(view(exe), 1);
    if 2 < parts.len() {
        push_bytes(&mut out, view(" size "));
        push_bytes(&mut out, view(decimal_bytes(parts[2])));
    }
    if 5 < parts.len() {
        push_bytes(&mut out, view(" mtime "));
        push_bytes(&mut out, view(decimal_bytes(parts[4])));
        out.push(46);
        push_bytes(&mut out, view(decimal_bytes(parts[5])));
    }
    return fncache::hash(view(out));
}

// The typed-IR facts one body's emission recorded, framed for replay: kind, a, b, what, width, the
// body symbol and the callee, per fact. They are replayed, not recomputed: the fact table is what
// the optimizer's pair rules and the LLVM lifter read, so a body spliced without them would be
// optimised as if it had none.
fn fn_facts_encode<a>(c: (&a C), from: u64) -> u8[] {
    mut out = u8[];
    n := llvm::facts_len(&c.facts);
    mut count: u64 = 0;
    if from < n {
        count = n - from;
    }
    iface_wv(&mut out, count);
    for i in count {
        k := from + i;
        iface_wv(&mut out, llvm::fact_kind(&c.facts, k));
        iface_wv(&mut out, llvm::fact_slot_at(&c.facts, k));
        iface_wv(&mut out, llvm::fact_arg_b(&c.facts, k));
        iface_wv(&mut out, llvm::fact_what(&c.facts, k));
        iface_wv(&mut out, llvm::fact_width(&c.facts, k));
        nl := llvm::fact_name_len(&c.facts, k);
        iface_wv(&mut out, nl);
        for j in nl {
            out.push(llvm::fact_name_byte(&c.facts, k, j));
        }
        cl := llvm::fact_callee_len(&c.facts, k);
        iface_wv(&mut out, cl);
        for j in cl {
            out.push(llvm::fact_callee_byte(&c.facts, k, j));
        }
    }
    return out;
}

fn fn_facts_restore<a>(c: (&a mut C), data: &a [u8]) -> unit {
    mut r = fncache::Read { data: data.copy(), at: 0, ok: 1 };
    n := fncache::rv(&mut r);
    for i in n {
        k := fncache::rv(&mut r);
        a := fncache::rv(&mut r);
        b := fncache::rv(&mut r);
        what := fncache::rv(&mut r);
        width := fncache::rv(&mut r);
        name := fncache::rs(&mut r);
        callee := fncache::rs(&mut r);
        if r.ok != 0 {
            llvm::fact_restore(&mut c.facts, k, name, a, b, callee, what, width);
        }
    }
    return ();
}

// ---- parallel function bodies (docs/design/incremental-compilation.md, "Parallel bodies") -----
//
// After the declarations, a module's bodies are cut into slices and forked copies of this process
// compile the slices after the first into units, which come back through a pipe each; this process
// compiles the first slice itself and, as its walk reaches each later body, applies the unit a
// worker made for it - the route a cache hit takes - or compiles the body itself when there is
// none. The walk, its counters and its registrations are the ones one process has, and a unit's
// text depends only on its key, so the output is the same at any number of workers and any cut.
// Anything a worker does not finish - an error in a body, a crash - sends the rest of the walk to
// this process, which then reports what one process reports.
//
fn par_debug<a>(msg: &a [u8]) -> unit {
    if host::env(view("GRAIL_DEBUG")).len() != 0 {
        host::print(view(msg));
    }
    return ();
}
// Which process compiles body `n`, which starts at byte `off` of file `file`.
fn par_owner<a>(c: (&a C), file: u64, off: u64, n: u64) -> u64 {
    if c.par_rr != 0 {
        return n % c.par_j;
    }
    mut k = c.par_j - 1;
    while 0 < k {
        cf := c.par_cut_file[k];
        if (cf < file) || ((cf == file) && (c.par_cut_off[k] <= off)) {
            return k;
        }
        k -= 1;
    }
    return 0;
}
// Before the bodies: whether this run may compile them in parallel, and the source sizes the cuts are
// made over. Nothing is forked yet: with a store, most bodies of a rebuild are hits, which this
// process applies itself faster than a worker could send them, so the walk forks only when it has
// compiled some bodies the store did not have (par_fork) - at once when there is no store.
fn par_start<a>(c: (&a mut C), files: u64) -> unit {
    if (c.plat != 0) | (c.target != 0) | (c.debug != 0) | (c.backend != 0) | (c.emit_ir != 0) {
        return ();
    }
    if (c.fx_any != 0) | (c.exports.len() != 0) | (c.validating != 0) | (c.skip_bodies.len() != 0) {
        return ();
    }
    if (jobs::count() < 2) & (host::env(view("GRAIL_BODY_SLICE")).len() == 0) {
        return ();
    }
    // The size of each input, from the file system: reloading every file to measure it cost a
    // tokenisation of the whole program per run.
    mut sizes = u64[];
    mut i = 2;
    while i < files {
        parts := host::stat(view(input_path(&c, i)), 1);
        if 2 < parts.len() {
            sizes.push(parts[2]);
        } else {
            load_file(&mut c, i);
            sizes.push(c.src.len());
        }
        i += 1;
    }
    if c.fn_surface.len() == 0 {
        exchange(&mut c.fn_flags, fn_flags_now(&mut c));
        exchange(&mut c.fn_surface, fn_surface_now(&mut c));
    }
    if c.fn_surface.len() == 0 {
        return ();
    }
    exchange(&mut c.par_sizes, sizes);
    exchange(&mut c.par_armed, 1);
    exchange(&mut c.par_t0, 0);
    return ();
}
// The walk is at the body at byte `off` of file `file` and has compiled enough misses: fork workers
// for the source from here on. 1 in a worker (which skips this body: it is the parent's), 0 here.
// Where the walk is, in bytes of the source counted over the files in order.
fn par_pos<a>(c: (&a C), file: u64, off: u64) -> u64 {
    mut at = 0;
    for k in c.par_sizes.len() {
        if k + 2 < file {
            at += c.par_sizes[k];
        }
    }
    return at + off;
}
// This process's CPU time in milliseconds - user and system ticks from /proc/self/stat, which a
// loaded machine does not inflate the way it does the wall clock - or the monotonic clock where
// there is no such file.
fn par_cpu_ms() -> u64 {
    stat := host::read_file(view("/proc/self/stat"));
    mut close = stat.len();
    for i in stat.len() {
        if stat[i] == 41 {
            close = i;
        }
    }
    if stat.len() <= close {
        return host::now_ms();
    }
    // After the command's closing parenthesis: state, then ten fields, then utime and stime.
    mut field = 0;
    mut value = 0;
    mut ticks = 0;
    mut i = close + 2;
    while i < stat.len() {
        ch := stat[i];
        if ch == 32 {
            if (field == 11) || (field == 12) {
                ticks += value;
            }
            field += 1;
            value = 0;
            if 12 < field {
                break;
            }
        } else if (48 <= ch) & (ch <= 57) {
            value = value * 10 + u64(ch - 48);
        }
        i += 1;
    }
    return ticks * 10;
}
// How many processes the rest of the walk is worth, measured rather than guessed from sizes: the
// walk compiles on its own for its first 50 ms of CPU, and from how far through the source that
// took it estimates what the rest would take here. Under half a second it does not fork at all -
// a small module, or a rebuild whose bodies are mostly hits, is cheaper in one process - and above
// it, one process per 150 ms of the estimate, up to the job count. 0 means not yet, or never (the
// walk is then disarmed). GRAIL_BODY_SLICE forces workers at the first body.
fn par_decide<a>(c: (&a mut C), file: u64, off: u64) -> u64 {
    if host::env(view("GRAIL_BODY_SLICE")).len() != 0 {
        return jobs::count();
    }
    now := par_cpu_ms();
    pos := par_pos(&c, file, off);
    if c.par_t0 == 0 {
        exchange(&mut c.par_t0, now + 1);
        exchange(&mut c.par_p0, pos);
        return 0;
    }
    elapsed := now + 1 - c.par_t0;
    if elapsed < 50 {
        return 0;
    }
    mut total = 0;
    for k in c.par_sizes.len() {
        total += c.par_sizes[k];
    }
    done := pos - c.par_p0;
    if (done == 0) || (total <= pos) {
        exchange(&mut c.par_armed, 0);
        return 0;
    }
    estimate := (total - pos) * elapsed / done;
    if estimate < 500 {
        exchange(&mut c.par_armed, 0);
        return 0;
    }
    mut want = estimate / 150;
    if jobs::count() < want {
        want = jobs::count();
    }
    if want < 2 {
        exchange(&mut c.par_armed, 0);
        return 0;
    }
    return want;
}
fn par_fork<a>(c: (&a mut C), file: u64, off: u64, want: u64) -> u64 {
    exchange(&mut c.par_armed, 0);
    slice := host::env(view("GRAIL_BODY_SLICE"));
    // The bytes still ahead, over the files from this one on.
    mut ahead = u64[];
    mut total = 0;
    for k in c.par_sizes.len() {
        mut n = 0;
        if file < k + 2 {
            n = c.par_sizes[k];
        } else if file == k + 2 {
            if off < c.par_sizes[k] {
                n = c.par_sizes[k] - off;
            }
        }
        ahead.push(n);
        total += n;
    }
    if want < 2 {
        return 0;
    }
    mut js = jobs::open();
    j := jobs::workers(&mut js, want);
    if j < 2 {
        jobs::give_all(&mut js);
        return 0;
    }
    exchange(&mut c.par_j, j);
    exchange(&mut c.par_rr, u64(same(view(slice), view("1"))));
    // Slice k starts at the k-th j-th of what is ahead; slice 0 is this process's, from here.
    for k in j {
        want := total / j * k;
        mut at = 0;
        mut f = 0;
        while (f + 1 < ahead.len()) && (at + ahead[f] <= want) {
            at += ahead[f];
            f += 1;
        }
        mut base = 0;
        if f + 2 == file {
            base = off;
        }
        c.par_cut_file.push(f + 2);
        c.par_cut_off.push(base + want - at);
    }
    exchange(&mut c.par_on, 1);
    exchange(&mut c.par_n, 0);
    die := host::env(view("GRAIL_TEST_BODY_WORKER_DIE")).len() != 0;
    for k in j - 1 {
        pair := host::pipe();
        child := host::fork();
        if child == 0 {
            host::close(pair[0]);
            for r in c.par_fds.len() {
                host::close(c.par_fds[r]);
            }
            if die & (k == 0) {
                // The test of a worker that dies holding a token (tools/jobs-test.mjs).
                host::exit(9);
            }
            exchange(&mut c.par_me, k + 1);
            exchange(&mut c.par_wfd, pair[1]);
            exchange(&mut c.par_fds, u64[]);
            exchange(&mut c.par_pids, u64[]);
            exchange(&mut c.par_jobs, jobs::none());
            return 1;
        }
        host::close(pair[1]);
        if 9223372036854775807 < child {
            // No fork: whatever was started is still read and waited for, and this process does the
            // rest; the bodies after the last worker's slice are its own.
            host::close(pair[0]);
            exchange(&mut c.par_fail, 1);
            break;
        }
        c.par_fds.push(pair[0]);
        c.par_pids.push(child);
        c.par_data.push(u8[]);
        c.par_at.push(0);
        c.par_read.push(0);
    }
    exchange(&mut c.par_jobs, js);
    if c.par_fail != 0 {
        par_fall_back(&mut c, view("a body worker could not be started"));
    }
    return 0;
}
// What worker `k` sent, read and waited for once; its token goes back when it has been waited for.
fn par_collect<a>(c: (&a mut C), k: u64) -> unit {
    if c.par_read[k - 1] != 0 {
        return ();
    }
    fd := c.par_fds[k - 1];
    mut data = u8[];
    while true {
        chunk := host::read_fd(fd, 1048576);
        if chunk.len() == 0 {
            break;
        }
        data.append(view(chunk));
    }
    host::close(fd);
    status := host::wait(c.par_pids[k - 1]);
    mut what = copy_bytes(view("collected-"));
    decimal(&mut what, k);
    jobs::phase(view(what));
    jobs::give(&mut c.par_jobs);
    mut whole = (status == 0) & (8 <= data.len());
    if whole {
        mut end = 0;
        for b in 8 {
            end = end * 256 + u64(data[data.len() - 8 + b]);
        }
        whole = end == 4702111234474983745;
    }
    if whole {
        c.par_read[k - 1] = 1;
        exchange(&mut c.par_data[k - 1], data);
    } else {
        c.par_read[k - 1] = 2;
    }
    return ();
}
// Every worker read and waited for, and the rest of the walk this process's.
fn par_fall_back<a, b>(c: (&a mut C), why: &b [u8]) -> unit {
    exchange(&mut c.par_fail, 1);
    for k in c.par_fds.len() {
        par_collect(&mut c, k + 1);
    }
    mut line = copy_bytes(view("grail: "));
    push_bytes(&mut line, why);
    push_bytes(&mut line, view("; the rest of this module is compiled in one process\n"));
    par_debug(view(line));
    return ();
}
fn par_unexpected<a, b>(c: (&a mut C), why: &b [u8]) -> unit {
    if c.par_me == 0 {
        par_fall_back(&mut c, why);
    }
    return ();
}
// The next thing worker `owner` sent, which has to be for the body at `file`/`off`: its unit, with
// `outcome` 1 (made) or 2 (from the store); no unit when it is not one, or the worker did not finish.
fn par_take<a, b>(c: (&a mut C), owner: u64, file: u64, off: u64, outcome: (&b mut u64)) -> fncache::Unit {
    if c.par_fds.len() < owner {
        return fncache::none();
    }
    par_collect(&mut c, owner);
    if c.par_read[owner - 1] != 1 {
        par_fall_back(&mut c, view("a body worker did not finish"));
        return fncache::none();
    }
    mut r = fncache::Read { data: exchange(&mut c.par_data[owner - 1], u8[]), at: c.par_at[owner - 1], ok: 1 };
    got_file := fncache::rv(&mut r);
    got_off := fncache::rv(&mut r);
    kind := fncache::rv(&mut r);
    bytes := fncache::rs(&mut r);
    c.par_at[owner - 1] = r.at;
    exchange(&mut c.par_data[owner - 1], r.data);
    if (r.ok == 0) | (got_file != file) | (got_off != off) {
        par_fall_back(&mut c, view("a body worker sent the bodies out of order"));
        return fncache::none();
    }
    if kind == 0 {
        return fncache::none();
    }
    exchange(outcome, kind);
    u := fncache::decode_piped(bytes);
    if u.key.len() == 0 {
        par_fall_back(&mut c, view("a body worker sent a unit that does not decode"));
    }
    return u;
}
// A worker's account of one of its bodies: 0 not a unit, 1 a unit it made, 2 one from the store.
fn par_record<a, b>(c: (&a mut C), at_off: u64, kind: u64, u: (&b fncache::Unit)) -> unit {
    iface_wv(&mut c.par_buf, c.file);
    iface_wv(&mut c.par_buf, at_off);
    iface_wv(&mut c.par_buf, kind);
    if kind == 0 {
        iface_wv(&mut c.par_buf, 0);
    } else if c.check_only != 0 {
        // A check run writes no assembly and runs no optimiser: what the parent needs of a checked
        // body is that it checked, and what it asks of the run - its registrations.
        checked := fncache::Unit { key: u.key.copy(), text: u8[], facts: u8[], regs: u.regs.copy() };
        iface_ws(&mut c.par_buf, view(fncache::encode(&checked)));
    } else {
        iface_ws(&mut c.par_buf, view(fncache::encode(u)));
    }
    return ();
}
// A worker has walked past its slice: what it made goes to its parent, and it stops.
fn par_worker_finish<a>(c: (&a mut C)) -> unit {
    mut what = copy_bytes(view("worker-"));
    decimal(&mut what, c.par_me);
    push_bytes(&mut what, view("-done-sending-bytes-"));
    decimal(&mut what, c.par_buf.len());
    jobs::phase(view(what));
    mut end = 4702111234474983745;
    mut tail = u8[];
    for b in 8 {
        tail.push(end / 72057594037927936);
        end = (end % 72057594037927936) * 256;
    }
    c.par_buf.append(view(tail));
    host::write_fd(c.par_wfd, view(c.par_buf));
    host::close(c.par_wfd);
    host::exit(0);
    return ();
}
// The walk is over: every worker read and waited for, every token back.
fn par_end<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.par_armed, 0);
    if c.par_on == 0 {
        return ();
    }
    for k in c.par_fds.len() {
        par_collect(&mut c, k + 1);
    }
    jobs::give_all(&mut c.par_jobs);
    exchange(&mut c.par_on, 0);
    return ();
}
fn func<a>(c: (&a mut C), pass: u64, public: u64) -> unit {
    // A body's synthesised declarations (closure environments) are not the function's to hide.
    exchange(&mut c.decl_public, 1);
    position := c.pos;
    // The mode this body is compiled in. `@strict` on the declaration reaches it from the source or,
    // when the body is a specialisation or a replay, from the template that carries the flag.
    mut strict_here = c.strict_next;
    if c.current_spec != 0 {
        template := c.specs[c.current_spec - 1].template;
        if template < c.funcs.len() {
            strict_here = c.funcs[template].strict;
        }
    }
    exchange(&mut c.strict_here, strict_here);
    out_mark := c.out.len();
    fact_mark := llvm::facts_len(&c.facts);
    part_mark := c.part.copy();
    part_lpart := c.lpart.copy();
    part_lunit := c.lunit;
    part_label := c.label;
    part_ref := c.ref_next;
    closure_mark := c.closures.len();
    spec_closure_mark := c.spec_closures;
    mut dstart = 0;
    mut dend = 0;
    expect(&mut c, view("fn"));
    // `unsafe fn`: consumed here, whatever pass this is, so the next item does not inherit it.
    unsafe_fn := exchange(&mut c.pending_unsafe, 0);
    // `@no_alloc`/`@no_panic`: the claims this body has to prove (docs/design/effects.md).
    claimed_alloc := exchange(&mut c.fx_pending_alloc, 0);
    claimed_panic := exchange(&mut c.fx_pending_panic, 0);
    mut name = ident(&mut c);
    c.cur_name = name.copy();
    c.cur_file = c.file;
    c.cur_pos = position;
    // An impl for a written type may not take over a name the compiler already resolves on that
    // type: `v.len()` is how `for i in v.len()` is written, so its meaning is not an impl's to set.
    if (pass == 2) & inherent_is_type_key(c.inherent) {
        inherent_protocol_refused(&mut c, c.inherent, view(name), position + 1);
    }
    mut at_generics = c.pos;
    lifetime_parameters(&mut c);
    exchange(&mut c.input_regions, u64[]);
    exchange(&mut c.receiver_region, 0);
    exchange(&mut c.output_region, 0);
    exchange(&mut c.parsing_input, 1);
    if (c.inherent != 0) || (c.current_impl != 0) {
        prepend_impl_params(&mut c);
    }
    resolve_callable_bounds(&mut c);
    if same(view(name), view("print")) || same(view(name), view("println")) {
        fail(&mut c, view("print and println are reserved prelude names"));
    }
    typecount := c.tnames.len();
    regioncount := c.rnames.len();
    if c.pending_ext == 2 {
        mut at_generic = at_generics;
        if 0 < at_generic {
            if kind_at(&mut c, at_generic) == 60 {
                at_generic = at_generic + 1;
            }
        }
        if regioncount != 0 {
            first := c.rnames[0].copy();
            ffi_callback_concrete(&mut c, view("lifetime parameter"), view(first), at_generic);
        }
        if typecount != 0 {
            first := c.tnames[0].copy();
            ffi_callback_concrete(&mut c, view("type parameter"), view(first), at_generic);
        }
    }
    if (pass == 3) & (typecount != 0) {
        body_brace(&mut c, position);
        skip_braces(&mut c);
        return ();
    }
    if pass == 1 {
        body_brace(&mut c, position);
        skip_braces(&mut c);
        return ();
    }
    if (pass == 3) || (pass == 4) {
        // A body an earlier run reported an error in is not checked again: its signature still
        // stands for its callers, so the rest of the program is checked against it. Pass 4 replays
        // a generic template's body - for its validation and for each specialisation - and it is
        // the same source body, so the same record skips it and names it.
        here_file := c.file;
        for i in c.skip_bodies.len() / 2 {
            if (c.skip_bodies[2 * i] == here_file) & (c.skip_bodies[2 * i + 1] == position + 1) {
                body_brace(&mut c, position);
                skip_braces(&mut c);
                return ();
            }
        }
        exchange(&mut c.body_file, here_file);
        // Position + 1, so 0 still means "not in a body".
        exchange(&mut c.body_pos, position + 1);
    }
    mut m = module_copy(&mut c);
    // A specialisation is requested by the module whose body instantiates the template.
    mut asker = m.copy();
    if c.current_spec != 0 {
        // A specialisation the replayed body instantiates in turn is asked for by the same module
        // that asked for this one, and is emitted into its part (B1 stage 4).
        asker = c.specs[c.current_spec - 1].requester.copy();
    }
    exchange(&mut c.body_module, asker);
    export := c.pending_ext;
    export_symbol := c.pending_symbol.copy();
    if c.current_impl != 0 {
        m = private_module(view(".impl_"), c.current_impl);
    }
    if c.inherent != 0 {
        m = private_module(view(".inherent_"), c.inherent - 1);
    }
    exchange(&mut c.locals, Local[]);
    // The call-flex hint record indexes `locals` and names token positions of the function being
    // compiled, so it cannot outlive that function's token stream.
    exchange(&mut c.cf_start, 0);
    exchange(&mut c.cf_end, 0);
    exchange(&mut c.cf_local, 0);
    exchange(&mut c.none_start, 0);
    exchange(&mut c.none_end, 0);
    exchange(&mut c.debug_vars, DebugVar[]);
    exchange(&mut c.resources, Resource[]);
    resources_swapped(&mut c);
    exchange(&mut c.next, 0);
    // Facts are keyed by the symbol this body will be lifted under, and the `rt_f64_op` ordinals
    // restart with it. Both are known before the signature is parsed, so parameters get facts too.
    mut label = name.copy();
    if c.current_spec != 0 {
        label = special_name(&mut c, c.current_spec - 1);
    }
    sym_unit := symbol_unit(&mut c, view(m));
    exchange(&mut c.facts_fn, body_label(&c, view(sym_unit), view(label), view(export_symbol), export));
    exchange(&mut c.fn_text_at, c.out.len());
    exchange(&mut c.pending_words, 0);
    exchange(&mut c.f64_ops, 0);
    exchange(&mut c.call_ord, 0);
    // The F1 call ordinals are per callee *and per function*, exactly as the lifter counts them.
    exchange(&mut c.f1_names, u8[][]);
    exchange(&mut c.f1_counts, u64[]);
    exchange(&mut c.scope_end, 0);
    exchange(&mut c.loop_start, 0);
    exchange(&mut c.loop_end, 0);
    exchange(&mut c.check, ownership::new());
    exchange(&mut c.members, Member[]);
    exchange(&mut c.terminated, 0);
    exchange(&mut c.bonds, Bond[]);
    bonds_swapped(&mut c);
    exchange(&mut c.pointers, Pointer[]);
    exchange(&mut c.origins, Origin[]);
    first := c.params.len();
    mut count = 0;
    mut ppreds = Pred[];
    mut pnames = u8[][];
    mut pdefaults = Pred[];
    // Once a parameter has a default, every parameter after it needs one (`f(a: u64 = 1, b: u64)` is
    // refused): omitting arguments then always omits a suffix, which is what a positional call reads.
    mut seen_default = 0;
    mut first_default = u8[];
    // Where each parameter was declared, so a repeated name can label the first one.
    mut pspots = u64[];
    expect(&mut c, view("("));
    if !eat(&mut c, view(")")) {
        while true {
            mut at_param = c.pos;
            // `&self`, `&mut self` and `self` are the receiver shorthand; anything else is a
            // written `name: type` parameter (receiver_shorthand).
            recv := receiver_shorthand(&mut c);
            mut shorthand = recv.0;
            mut p = u8[];
            mut ty = recv.1;
            if shorthand != 0 {
                p = copy_bytes(view("self"));
            } else {
                p = ident(&mut c);
                ty = NO_TYPE;
            }
            mut dup_at = 0;
            for i in pnames.len() {
                if same(view(pnames[i]), view(p)) {
                    dup_at = pspots[i];
                }
            }
            if dup_at != 0 {
                diag_label(&mut c, dup_at, view("the first one is here"));
                mut fname = c.cur_name.copy();
                duplicate_param_fail(&mut c, view(fname), view(p), at_param);
            }
            pspots.push(at_param);
            if shorthand == 0 {
                expect(&mut c, view(":"));
                if ffi_byval_ahead(&mut c) {
                    fail(
                        &mut c,
                        view("byval is only for an extern \"C\" declaration parameter; a C callback cannot take a record by value yet")
                    );
                }
                ty = parse_type(&mut c);
            }
            if is_array(&mut c, ty) && (export != 0) {
                diag_help(&mut c, view("C takes an array parameter as a pointer: declare it `&[T; N]` or `&mut [T; N]`"));
                fail(&mut c, view("C cannot pass an array by value"));
            }
            // `p: T where P`: the parameter's refinement (docs/design/refinements.md).
            mut pp = no_pred();
            if (shorthand == 0) & is(&mut c, view("where")) {
                advance(&mut c);
                pp = pred_scan(&mut c, view(","), view(")"));
            }
            // `p: T = value`: what the parameter takes when a call leaves it out. Kept as its own
            // token range and compiled at the call site, exactly as a predicate is compiled where
            // the value enters (docs/design/named-arguments.md).
            mut dflt = no_pred();
            if is(&mut c, view("=")) {
                if export != 0 {
                    fail(
                        &mut c,
                        view("an `extern \"C\"` declaration cannot give a parameter a default: the C signature is the declaration, and C has no default arguments")
                    );
                }
                if same(view(p), view("self")) {
                    fail(&mut c, view("`self` cannot have a default value: the receiver supplies it"));
                }
                advance(&mut c);
                dflt = default_scan(&mut c);
                if seen_default == 0 {
                    first_default = p.copy();
                }
                seen_default = 1;
            } else if seen_default != 0 {
                // No gaps: a parameter with a default may not be followed by one without, so that
                // dropping arguments never means dropping one from the middle.
                mut text = copy_bytes(view("parameter `"));
                push_bytes(&mut text, view(p));
                push_bytes(&mut text, view("` has no default while `"));
                push_bytes(&mut text, view(first_default));
                push_bytes(&mut text, view("` before it does"));
                mut help = copy_bytes(view("give `"));
                push_bytes(&mut help, view(p));
                push_bytes(&mut help, view("` a default too, or move it before `"));
                push_bytes(&mut help, view(first_default));
                push_bytes(&mut help, view("`"));
                diag_help(&mut c, view(help));
                fail(&mut c, view(text));
            }
            ppreds.push(pp);
            pnames.push(p.copy());
            pdefaults.push(dflt);
            if same(view(p), view("self")) & (ty_kind(&mut c, ty) == 7) {
                rr := outer_region(&mut c, ty);
                exchange(&mut c.receiver_region, rr);
            }
            if pass == 2 {
                c.params.push(ty);
            }
            id := fresh(&mut c);
            bind(&mut c, p, ty, id, 0);
            if c.debug != 0 {
                n := c.debug_vars.len();
                if n != 0 {
                    mut v = &mut c.debug_vars[n - 1];
                    exchange(&mut v.param, 1);
                }
            }
            count = count + 1;
            if eat(&mut c, view(")")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    exchange(&mut c.parsing_input, 0);
    if c.receiver_region != 0 {
        exchange(&mut c.output_region, c.receiver_region);
    } else {
        if c.input_regions.len() == 1 {
            exchange(&mut c.output_region, c.input_regions[0]);
        }
    }
    mut ret = 1;
    mut rpred = no_pred();
    if eat(&mut c, view("->")) {
        ret = parse_type(&mut c);
        if is_array(&mut c, ret) && (export != 0) {
            fail(&mut c, view("C cannot return an array by value: return a record that holds it, or fill a `&mut [T; N]`"));
        }
        // `-> T ensures P`: the result's refinement, with `result` naming the value.
        if is(&mut c, view("ensures")) {
            advance(&mut c);
            rpred = pred_scan(&mut c, view("{"), view(";"));
        }
    }
    c.cur_ppreds = copy_preds(&ppreds);
    c.cur_rpred = Pred { file: rpred.file, lo: rpred.lo, hi: rpred.hi };
    exchange(&mut c.output_region, 0);
    exchange(&mut c.result, ret);
    if pass == 2 {
        if find_func(&mut c, view(m), view(name)) != 0 {
            // The name token sits right after `fn`, so the caret lands on the declaration itself
            // rather than on whatever the signature ended with.
            mut at_fn = position + 1;
            if (c.current_impl != 0) || (c.inherent != 0) {
                duplicate_method_fail(&mut c, view(name), at_fn);
            }
            exchange(&mut c.pos, at_fn);
            fail(&mut c, view(duplicate_msg(&mut c, view(name))));
        }
        if export != 0 {
            // The body is Grail, but C will call it: every parameter and the result
            // must live in the C ABI slice, and the symbol is the stated C name.
            ffi_callback_fits(&mut c, first, count);
            for i in count {
                formal := c.params[first + i];
                if ffi_out_param(&mut c, formal) & (ffi_record_out_param(&mut c, formal) == 0) {
                    // Grail has no deref-assignment, so a callback cannot store a word through the
                    // pointer C hands it; only a declaration Grail calls writes such a slot. A
                    // `&mut R` record parameter is the exception (bound by copy-in/copy-out below).
                    fail(
                        &mut c,
                        view("an out-parameter is only for an extern \"C\" declaration parameter; a C callback cannot take one")
                    );
                }
                // A byte view is two C argument words (pointer then length) and this entry reads one
                // word per parameter, so a view parameter would take the next parameter's word - and
                // where the pair lands differs by target (Win64 splits registers from the fifth
                // argument). There is no second word to read it from, so the shape is refused by
                // name with the spelling that works, before the generic type list below would admit
                // it as a legal foreign parameter.
                if 1 < ffi_words(&mut c, formal) {
                    mut text = copy_bytes(view("parameter `"));
                    push_bytes(&mut text, view(pnames[i]));
                    push_bytes(&mut text, view("` is a byte view, which C passes in two argument words (pointer then length); a C callback entry reads one argument word per parameter - take `"));
                    push_bytes(&mut text, view(pnames[i]));
                    push_bytes(&mut text, view(": CPtr` and a `u64` length, and copy the bytes with `cslice(u8, p, n)` inside an unsafe block"));
                    fail(&mut c, view(text));
                }
                if !(is_float(&mut c, formal) || ffi_narrow(&mut c, formal).len() != 0) {
                    ffi_param(
                        &mut c,
                        formal,
                        view("extern C callback parameters must be an integer, f32, f64, CStr, handle or cfn")
                    );
                }
            }
            if ret != 1 {
                if !(is_float(&mut c, ret) || ffi_narrow(&mut c, ret).len() != 0) {
                    ffi_result(&mut c, ret, view("extern C callback results must be an integer, f32, f64, unit, CStr or handle"));
                }
            }
            if export_symbol.len() == 0 {
                fail(&mut c, view("extern C definition needs a symbol"));
            }
        }
        main := (c.file == 2) & (c.current_impl == 0) & (c.inherent == 0) & same(view(name), view("main"));
        if main {
            if (1 < count) || (typecount != 0) {
                fail(
                    &mut c,
                    view("main needs zero arguments or one readonly byte view and no type parameters")
                );
            }
        }
        entry := main
            || (
                c.current_impl == 0
                    && c.inherent == 0
                    && c.entry == 0
                    && c.file == 2
                    && public != 0
                    && count < 2
                    && typecount == 0
                    && entry_shaped(&mut c, count, first)
            );
        file := c.file;
        raw := c.raw;
        bounds := copy_numbers(&c.type_bounds);
        constraints := copy_constraints(&c.type_interfaces);
        // A method of an interface implementation is as visible as the interface it implements.
        item_public_8 := public | u64(c.current_impl != 0);
        // Whose parameters a template replay restores: an inherent impl's type, or a generic
        // interface implementation (replay_function).
        mut method_owner = c.inherent;
        if (method_owner == 0) && (c.current_impl != 0) && (typecount != 0) {
            method_owner = generic_impl_key(c.current_impl);
        }
        item_home_8 := module_copy(&mut c);
        c
            .funcs
            .push(
                Func {
                    public: item_public_8,
                    home: item_home_8,
                    module: m,
                    name: name,
                    first: first,
                    count: count,
                    ret: ret,
                    types: typecount,
                    regions: c.rnames.len(),
                    file: file,
                    pos: position,
                    raw: raw,
                    unsafe_fn: unsafe_fn,
                    bounds: bounds,
                    constraints: constraints,
                    contract: 0,
                    owner: method_owner,
                    ext: export,
                    symbol: export_symbol,
                    body: u8[],
                    ppreds: copy_preds(&ppreds),
                    rpred: Pred { file: rpred.file, lo: rpred.lo, hi: rpred.hi },
                    pnames: copy_names(&pnames),
                    pdefaults: copy_preds(&pdefaults),
                    strict: c.strict_next,
                    no_alloc: claimed_alloc,
                    no_panic: claimed_panic,
                }
            );
        index := c.funcs.len();
        if entry {
            exchange(&mut c.entry, index);
        }
        eqs := copy_numbers(&c.assoc_eqs);
        for k in eqs.len() / 3 {
            c.func_eqs.push(index - 1);
            c.func_eqs.push(eqs[3 * k]);
            c.func_eqs.push(eqs[3 * k + 1]);
            c.func_eqs.push(eqs[3 * k + 2]);
        }
        // A generic template's body has to travel with its interface, because the module that
        // instantiates it may not have this file (B1 stage 3). Capture the declaration's own text
        // while this file is the loaded one: `position` is the `fn` token and `skip_braces` leaves
        // `c.pos` just past the closing brace.
        if typecount != 0 {
            from := c.toks[position].start;
            skip_braces(&mut c);
            // `index` is `c.funcs.len()` after the push, so the record is at `index - 1`.
            exchange(&mut c.funcs[index - 1].body, (c.src[from: c.toks[c.pos - 1].end]).copy());
        } else {
            skip_braces(&mut c);
        }
        return ();
    }
    if c.current_spec != 0 {
        name = special_name(&mut c, c.current_spec - 1);
    }
    start := c.pos;
    end := block_end(&mut c, start);
    exchange(&mut c.scope_end, end);
    // The facts an obligation may read start at this body's entry (pv_begin).
    exchange(&mut c.body_lo, start);
    exchange(&mut c.body_hi, end);
    // On Win64 a C caller passes rcx/rdx/r8/r9 (then the stack after a 32-byte home area) and
    // expects rdi, rsi and xmm6-xmm15 preserved; the body uses Grail's SysV-shaped convention. A
    // callback is therefore a Win64 thunk under the C symbol that saves those registers, moves
    // the arguments and calls the body, which is emitted under `<symbol>_grail_body`.
    mut unit = unit_module(&mut c, view(m));
    if c.current_spec != 0 {
        // A specialisation is emitted by the module that asked for it, whichever module defines the
        // template, and weak: every object that instantiates the same key emits the same body under
        // the same content-addressed name, and the linker keeps one (B1 stage 4).
        // stays: a vector element read is a loan, so it conflicts with the call's &mut.
        requester := c.specs[c.current_spec - 1].requester.copy();
        unit = unit_module(&mut c, view(requester));
    }
    // ---- the per-function codegen cache: replay this body if the store has it ----------------
    //
    // The key names the declaration's own source text and its typed signature, so nothing here has
    // parsed the body: a hit is a load and an apply (fn_apply), and it skips the body's tokens, its
    // checking, its lowering and its emission. A body that misses is emitted below, taken as a unit
    // at the end of this function, filed, and applied the same way.
    mut fn_key_text = u8[];
    mut fn_marks_at = u64[];
    mut fn_candidate = 0;
    mut fn_line = 0;
    if position < c.toks.len() {
        fn_line = c.toks[position].line;
    }
    fn_drop_mark := c.drop_refs.len();
    // Parallel bodies: which process this body is for. A worker skips the bodies that are not its
    // own - spending the function's ordinal as the process that compiles it does - and the parent
    // takes the unit a worker made for it (par_take), applied below like a hit.
    mut par_mine = 0;
    mut par_unit = fncache::none();
    mut par_outcome = 0;
    mut at_off = 0;
    if position < c.toks.len() {
        at_off = c.toks[position].start;
    }
    if (c.par_on != 0) & (pass == 3) & (c.current_spec == 0) & (c.validating == 0) {
        n := c.par_n;
        c.par_n = n + 1;
        owner := par_owner(&c, c.file, at_off, n);
        if c.par_me != 0 {
            if owner != c.par_me {
                if (c.par_rr == 0) & (c.par_me < owner) {
                    par_worker_finish(&mut c);
                }
                part(&mut c, view(unit));
                k := c.lunit;
                if (k != 0) & (k <= c.fnext.len()) {
                    c.fnext[k - 1] = c.fnext[k - 1] + 1;
                }
                skip_braces(&mut c);
                return ();
            }
            par_mine = 1;
        } else if (owner != 0) & (c.par_fail == 0) {
            par_unit = par_take(&mut c, owner, c.file, at_off, &mut par_outcome);
        }
    }
    // With no store, a unit is only something a worker hands this process; for a body this process
    // compiles itself there is nothing to key or to file.
    own_only := (c.fn_dir.len() == 0) & (c.par_me == 0) & (par_unit.key.len() == 0);
    if fn_open(&mut c, view(unit)) & !own_only {
        // The symbol the label will spell: `body_label` is the one spelling both `func_directive`
        // and the label use, so a unit's key names exactly the symbol its bytes define.
        fn_symbol := body_label(&c, view(m), view(name), view(export_symbol), export);
        // Hoisted: `fn_key` borrows `c` mutably, so no argument may read it.
        decl_from := c.toks[position].start;
        decl_to := c.toks[end].end;
        key := fn_key(&mut c, view(unit), view(fn_symbol), decl_from, decl_to, position, count, ret);
        if key.len() != 0 {
            from_worker := par_unit.key.len() != 0;
            mut hit = par_unit;
            if (hit.key.len() == 0) & (c.fn_dir.len() != 0) {
                if c.check_only != 0 {
                    hit = fncache::load_checked(view(c.fn_dir), view(fncache::hash(view(key))));
                } else {
                    hit = fncache::load(view(c.fn_dir), view(fncache::hash(view(key))));
                }
                par_outcome = 2;
            }
            if hit.key.len() != 0 {
                if same(view(hit.key), view(key)) {
                    // All of its registrations, or none of the unit.
                    mut readable = 1;
                    regs := fn_regs_read(&mut c, view(hit.regs), &mut readable);
                    if readable != 0 {
                        if par_mine != 0 {
                            par_record(&mut c, at_off, 2, &hit);
                        }
                        // The first body of a part opens it; the unit's text starts after that.
                        part(&mut c, view(unit));
                        // The signature's parameter facts were recorded on the way here, and the
                        // unit's facts hold them already: without this a replayed body carries them
                        // twice, its facts digest differs from a fresh emission's, and the
                        // optimiser's memo (optimize.grl one_body) misses for every unchanged body.
                        llvm::facts_truncate(&mut c.facts, fact_mark);
                        fn_apply(&mut c, &hit, &regs, fn_line, position, claimed_alloc, claimed_panic);
                        if par_outcome == 1 {
                            c.fn_filed = c.fn_filed + 1;
                        } else {
                            c.fn_hits = c.fn_hits + 1;
                        }
                        if from_worker {
                            c.par_hits = c.par_hits + 1;
                        }
                        skip_braces(&mut c);
                        return ();
                    }
                }
            }
            if from_worker {
                par_unexpected(&mut c, view("a worker's unit is not the unit of this body"));
            }
            fn_key_text = key;
            fn_marks_at = fn_marks(&c);
            fn_candidate = 1;
            exchange(&mut c.fn_rec, 1);
            exchange(&mut c.fn_regs, u8[]);
            exchange(&mut c.fn_reg_types, u64[]);
        } else {
            c.fn_why[FN_UNSPELLED] = c.fn_why[FN_UNSPELLED] + 1;
            c.fn_kept = c.fn_kept + 1;
        }
    }
    // This body was not a hit: whether the rest is worth workers (par_decide).
    if (c.par_armed != 0) & (pass == 3) & (c.current_spec == 0) & (c.validating == 0) {
        want := par_decide(&mut c, c.file, at_off);
        if want != 0 {
            if par_fork(&mut c, c.file, at_off, want) != 0 {
                // A worker: this body is the parent's.
                exchange(&mut c.fn_rec, 0);
                part(&mut c, view(unit));
                k := c.lunit;
                if (k != 0) & (k <= c.fnext.len()) {
                    c.fnext[k - 1] = c.fnext[k - 1] + 1;
                }
                skip_braces(&mut c);
                return ();
            }
        }
    }
    // Where each parameter is last used: only a body that is compiled here needs it, so a hit, a
    // body a worker skips and a body handed to a worker do not scan for it.
    for i in c.locals.len() {
        mut l = &c.locals[i];
        name := l.name.copy();
        last := last_name(&mut c, view(name), start, end);
        mut l = &mut c.locals[i];
        exchange(&mut l.last, last);
    }
    part(&mut c, view(unit));
    scope_begin(&mut c);
    // What a unit is taken back to: after the part's marker (the first body of a part writes it),
    // before the line that says where the function is.
    apply_mark := c.out.len();
    if site_table_on(&c) && (c.validating == 0) && (position < c.toks.len()) {
        c.plan_at.push(c.out.len());
        site_base(&mut c, fn_line);
    }
    // A unit's text starts here, after the line that says where the function is.
    text_mark := c.out.len();
    mut body_symbol = u8[];
    push_bytes(&mut body_symbol, view(export_symbol));
    if (c.target == 3) & (export == 2) {
        push_bytes(&mut body_symbol, view("_grail_body"));
        if exported(&mut c, view(name)) != 0 {
            o(&mut c, view(".globl "));
            o(&mut c, view(export_symbol));
            c.out.push(10);
        }
        o(&mut c, view(export_symbol));
        o(&mut c, view(":\npushq %rdi\npushq %rsi\nsubq $168,%rsp\n"));
        for x in 10 {
            o(&mut c, view("movdqu %xmm"));
            on(&mut c, x + 6);
            c.out.push(44);
            on(&mut c, x * 16);
            o(&mut c, view("(%rsp)\n"));
        }
        // Entry rsp + 40 holds argument five; after two pushes and 168 bytes it is rsp + 224.
        o(&mut c, view("movq %rcx,%rdi\nmovq %rdx,%rsi\nmovq %r8,%rdx\nmovq %r9,%rcx\nmovq 224(%rsp),%r8\nmovq 232(%rsp),%r9\ncall "));
        o(&mut c, view(body_symbol));
        c.out.push(10);
        for x in 10 {
            o(&mut c, view("movdqu "));
            on(&mut c, x * 16);
            o(&mut c, view("(%rsp),%xmm"));
