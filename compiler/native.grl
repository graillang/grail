fn interface_declaration<a>(c:ref_mut<a,C>,pass:num)->unit{
 if c.raw{fail(borrow_mut(c),&"unsafe runtime cannot publish safe interfaces");}
 expect(borrow_mut(c),&"interface");name :=ident(borrow_mut(c));
 if same(&name,&"Send")+same(&name,&"Share"){fail(borrow_mut(c),&"structural capability names are reserved");}
 module :=module_copy(borrow_mut(c));id :=ensure_interface(borrow_mut(c),module,name);
 if pass==1{item :=&c.interfaces[id-1];defined :=item.defined;if defined{fail(borrow_mut(c),&"duplicate interface");}item :=&mut c.interfaces[id-1];exchange(borrow_mut(item.defined),1);if is(borrow_mut(c),&"{")==0{fail(borrow_mut(c),&"expected interface body");}skip_braces(borrow_mut(c));return ();}
 if pass==3{skip_braces(borrow_mut(c));return ();}
 expect(borrow_mut(c),&"{");proof :=intern(borrow_mut(c),15,id);mut proofs=vec<num>[];proofs.push(proof);self :=intern_args(borrow_mut(c),9,0,0,vec<num>[],proofs);exchange(borrow_mut(c.self_type),self+1);
 while eat(borrow_mut(c),&"}")==0{
 expect(borrow_mut(c),&"fn");name :=ident(borrow_mut(c));lifetime_parameters(borrow_mut(c));if c.tnames.len(){fail(borrow_mut(c),&"interface method type parameters are not implemented yet");}
 module :=private_module(&".interface_",id);if find_func(borrow_mut(c),&module,&name){fail(borrow_mut(c),&"duplicate interface method");}
 first :=c.params.len();expect(borrow_mut(c),&"(");mut count=0;
 if eat(borrow_mut(c),&")")==0{while true{ident(borrow_mut(c));expect(borrow_mut(c),&":");ty :=parse_type(borrow_mut(c));c.params.push(ty);count+=1;if eat(borrow_mut(c),&")"){break;}expect(borrow_mut(c),&",");}}
 if 6<count{fail(borrow_mut(c),&"interface method exceeds six arguments");}mut ret=1;if eat(borrow_mut(c),&"->"){ret=parse_type(borrow_mut(c));}expect(borrow_mut(c),&";");
 mut bounds=vec<num>[0];mut requirements=vec<vec<num>>[];requirements.push(vec<num>[id]);regions :=c.rnames.len();
 c.funcs.push(Func{module:module,name:name,first:first,count:count,ret:ret,types:1,regions:regions,file:0,pos:0,raw:0,bounds:bounds,constraints:requirements,contract:id});
 index :=c.funcs.len()-1;item :=&mut c.interfaces[id-1];item.methods.push(index);
 }
 exchange(borrow_mut(c.self_type),0);return ();
}
fn implementation<a>(c:ref_mut<a,C>,pass:num)->unit{
 if c.raw{fail(borrow_mut(c),&"unsafe runtime cannot implement safe interfaces");}
 expect(borrow_mut(c),&"impl");if pass==1{while is(borrow_mut(c),&"{")==0{if kind(borrow_mut(c))==0{fail(borrow_mut(c),&"unclosed implementation");}advance(borrow_mut(c));}skip_braces(borrow_mut(c));return ();}
 exchange(borrow_mut(c.rnames),vec<bytes>[]);exchange(borrow_mut(c.tnames),vec<bytes>[]);exchange(borrow_mut(c.type_bounds),vec<num>[]);exchange(borrow_mut(c.type_interfaces),vec<vec<num>>[]);
 mut module=module_copy(borrow_mut(c));mut name=ident(borrow_mut(c));if eat(borrow_mut(c),&"::"){module=name;name=ident(borrow_mut(c));}
