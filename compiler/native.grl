// `*r` (and the `load` builtin): copies the referent of a typed reference. Only values that need no
// drop can be copied; a shared view referent is reborrowed.
fn deref_value<a>(c: (&a mut C), a: Val) -> Val {
    observe(&mut c, a.t);
    if c.raw == 0 {
        if ty_kind(&mut c, a.ty) != 7 {
            fail(&mut c, view("* requires a typed reference"));
        }
    }
    ty := ty_arg(&mut c, a.ty);
    n := ref_load(&mut c, a.t, ty);
    if c.raw == 0 {
        k := ty_kind(&mut c, ty);
        // A shared reference behind a shared reference is copied out like a shared view (Rust's
        // `&T: Copy`): the copy holds a shared reborrow of what the inner reference borrows. An
        // exclusive one would be a second `&mut`.
        if (k == 7) && ((ty_mode(&mut c, ty) != 0) || (ty_mode(&mut c, a.ty) != 0)) {
            fail(&mut c, view("indirect reference copies require explicit reborrow"));
        }
        if (k == 5) || (k == 27) || (k == 7) {
            if ty_mode(&mut c, ty) != 0 {
                fail(&mut c, view("cannot copy an exclusive view out of a reference; reborrow explicitly"));
            }
            mut slot = 0;
            if k == 7 {
                get(&mut c, n, view("%rax"));
                slot = save(&mut c);
                own(&mut c, slot, ty);
            } else {
                slot = invoke(&mut c, view("rt_view"), one(n));
                own(&mut c, slot, ty);
            }
            target := target_of(&mut c, a.t);
            c
                .resources
                .push(
                    Resource {
                        slot: n,
                        ty: ty,
                        flag: 0,
                        base: a.t + 1,
                        field: 0,
                        via: 1,
                        place: target,
                        target: 0,
                        authority: a.t + 1,
                    }
                );
            frame := place_of(&mut c, a.t);
            count := c.bonds.len();
            for i in count {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if holder == frame && guard != 0 {
                    bond_kind(&mut c, target, loan, guard);
                }
            }
            stored_source(&mut c, n, ty);
            view_bonds(&mut c, slot, n, 0, k == 7);
            if k == 7 {
                // The copy points where the inner reference points.
                inner_target := target_of(&mut c, n);
                if inner_target != 0 {
                    set_target(&mut c, slot, inner_target, 0);
