fn parse_raw_pointer<a>(c: (&a mut C)) -> u64 {
    if kind(&mut c) == 267 {
        advance(&mut c);
        inner := parse_type(&mut c);
        once := intern_full(&mut c, 34, inner, 0, u64[]);
        return intern_full(&mut c, 34, once, 0, u64[]);
    }
    expect(&mut c, view("*"));
    mode := u64(eat(&mut c, view("mut")));
    inner := parse_type(&mut c);
    return intern_full(&mut c, 34, inner, mode, u64[]);
