}
// The lifetimes the loans held anywhere inside a captured aggregate borrow.
fn capture_aggregate_regions<a, b>(c: (&a mut C), slot: u64, caps: (&b mut u64[])) -> unit {
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    for i in c.bonds.len() {
        holder := c.bonds[i].holder;
        loan := c.bonds[i].loan;
        if (loan_live(&mut c, loan) != 0) && ownership::ancestor(&c.check, place, holder) {
            // stays: `c.check.loans[loan - 1]` is a borrowed element (see drop_hook_symbol).
            source := c.check.loans[loan - 1].source;
            add_region(&mut caps, region_of(&mut c, source));
