// Whether a value of this type can hold a borrow its type does not show: a function value or an
// interface object (a closure that captured a reference), or something holding one.
fn may_hide_borrow<a>(c: (&a mut C), ty: u64) -> bool {
    mut trail = u64[];
    return hide_walk(&mut c, ty, &mut trail);
}
fn hide_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> bool {
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if (k == 12) || (k == 20) || (k == 25) || (k == 33) {
        return true;
    }
    // A job handle owns the closure it runs, whatever its result type is: `Job<u64>` shows no borrow
    // and the job may still be reading one. Walking only the result lost the loan a wrapper's
    // closure argument handed to the handle (call_bonds), so the borrowed value could be moved or
    // dropped while the job ran.
    if k == 29 {
        return true;
    }
    if (k == 10) || (k == 6) || (k == 13) || (k == 14) || (k == 16) {
        return hide_walk(&mut c, arg, &mut trail);
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return false;
            }
        }
        trail.push(ty);
        count := c.decls[arg].count;
        for i in count {
            t := field_type(&mut c, ty, i);
            if hide_walk(&mut c, t, &mut trail) {
                trail.pop()!;
                return true;
            }
        }
        trail.pop()!;
    }
    return false;
}
// Whether storage at or below `place` holds a live loan.
fn holds_live_loan<a>(c: (&a mut C), place: u64) -> bool {
    if place == 0 {
        return false;
    }
    for i in c.bonds.len() {
        holder := c.bonds[i].holder;
        // stays: `c.bonds[i]` is a borrowed element (see drop_hook_symbol).
        loan := c.bonds[i].loan;
        if ownership::ancestor(&c.check, place, holder) && (loan_live(&mut c, loan) != 0) {
            return true;
        }
    }
    return false;
}
fn move_value<a>(c: (&a mut C), v: Val) -> Val {
    materialise(&mut c, v.t, v.ty);
    mut slot = 0;
    if is_array(&mut c, v.ty) {
        // The bytes go into storage of the new holder's own (see array_storage).
        slot = array_fresh_copy(&mut c, v.t, v.ty);
    } else if framed(&mut c, v.ty) && take_temp(&mut c, v.t) {
        // A plain temporary (a constructor's fresh words): nothing else refers to them, and the
        // constructor runs again only once this binding or argument is gone, so they are taken over
        // - a struct literal bound with `mut s = S { .. }` is built in place.
        slot = v.t;
    } else if framed(&mut c, v.ty) {
        // The value moves into storage of its own here: a binding, an argument or a field never
        // shares the words of the place it came from, whose site may run again.
        slot = frame_copy(&mut c, v.t, v.ty);
    } else {
        get(&mut c, v.t, view("%rax"));
        slot = save(&mut c);
    }
    old := place_of(&mut c, v.t);
    target := target_of(&mut c, v.t);
    move_out(&mut c, val(v.t, v.ty));
    own(&mut c, slot, v.ty);
    mut dst = place_of(&mut c, slot);
    kind := ty_kind(&mut c, v.ty);
    // A value typed by a generic signature (`Iter<T>`, T still a parameter), or a generic call's result
    // that captured its arguments' loans (captured_bonds: an `Iter<u64>` mapping references), may hold
    // borrows its type does not show; its loans move with it all the same.
    if contains_borrow(&mut c, v.ty, 0) || !concrete_type(&mut c, v.ty) || (may_hide_borrow(&mut c, v.ty) && holds_live_loan(&mut c, old)) {
        return_bonds(&mut c, old, dst, u64(kind == 6 || kind == 8));
    } else {
        if (kind == 26) & (dst == 0) & (old != 0) & (c.raw == 0) {
            dst = pointer_place(&mut c, slot, v.ty);
        }
        pointer_copy(&mut c, old, dst, v.ty);
    }
    if ty_kind(&mut c, v.ty) == 7 {
        set_target(&mut c, slot, target, slot + 1);
    }
    return val(slot, v.ty);
}
// ---- tokens ----
// The kind at the cursor. Past the last token is the end of the file: the stream ends with one (kind
// 0), and a parser that has stepped over it - a search for a `{` that never arrives - has to see
// EOF, not fault. An unchecked index here was a compiler abort on a half-typed declaration
// (docs/design/frontend-robustness.md).
fn kind<a>(c: (&a mut C)) -> u64 {
    p := c.pos;
    if c.toks.len() <= p {
        return 0;
    }
    t := &c.toks[p];
    return t.kind;
}
fn next_kind<a>(c: (&a mut C)) -> u64 {
    return kind_at(&mut c, c.pos + 1);
}
fn kind_at<a>(c: (&a mut C), i: u64) -> u64 {
    if c.toks.len() < i + 1 {
        return 0;
    }
    t := &c.toks[i];
    return t.kind;
}
fn advance<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.pos, c.pos + 1);
    return ();
}
// The cursor's token text. Past the last token is the end of the file, which has no text.
fn tok_text<a>(c: (&a mut C), i: u64) -> u8[] {
    if c.toks.len() <= i {
        return u8[];
    }
    t := &c.toks[i];
    st := t.start;
    en := t.end;
    // Filled in place: a slice of the source and a copy of it was a view record more per token.
    n := en - st;
    mut out = u8[0; n];
    for k in n {
        out[k] = c.src[st + k];
    }
    return out;
}
// Whether the current token is spelled `s`, read from the source in place. `is` is asked for every
// keyword at every statement, and copying the token out to compare it was four allocations a
// question (docs/design/compile-speed.md). A position past the stream is the empty token, as
// `tok_text` has it. The loop is written out here, in `is_at` and in `eat` rather than shared:
// handing a view on to another function makes a new view record, which is the cost being removed.
fn is<a, b>(c: (&a mut C), s: &b [u8]) -> bool {
    i := c.pos;
    if c.toks.len() <= i {
        return s.len() == 0;
    }
    st := c.toks[i].start;
    if c.toks[i].end - st != s.len() {
        return false;
    }
    for k in s.len() {
        if c.src[st + k] != s[k] {
            return false;
        }
    }
    return true;
}
// Edit distance between two names (insertions, deletions, substitutions), for "did you mean".
fn edit_distance<a, b>(x: &a [u8], y: &b [u8]) -> u64 {
    mut row = u64[];
    for j in y.len() + 1 {
        row.push(j);
    }
    for i in x.len() {
        mut diagonal = row[0];
        row[0] = i + 1;
        for j in y.len() {
            above := row[j + 1];
            mut best = above + 1;
            if row[j] + 1 < best {
                best = row[j] + 1;
            }
            mut swap = diagonal;
            if x[i] != y[j] {
                swap = diagonal + 1;
            }
            if swap < best {
                best = swap;
            }
            row[j + 1] = best;
            diagonal = above;
        }
    }
    return row[y.len()];
}
// The closest name this scope could have meant: live locals, then this module's functions,
// constants and types. Close means at most a third of the name's length edited (at least one).
fn suggest_name<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> u8[] {
    mut limit = name.len() / 3;
    if limit == 0 {
        limit = 1;
    }
    mut best = u8[];
    mut best_cost = limit + 1;
    for i in c.locals.len() {
        candidate := c.locals[i].name.copy();
        if (candidate.len() != 0) & (candidate[0] != 46) {
            cost := edit_distance(view(name), view(candidate));
            if cost < best_cost {
                best_cost = cost;
                best = candidate;
            }
        }
    }
    for i in c.funcs.len() {
        if same(view(c.funcs[i].module), module) {
            candidate := c.funcs[i].name.copy();
            cost := edit_distance(view(name), view(candidate));
            if cost < best_cost {
                best_cost = cost;
                best = candidate;
            }
        }
    }
    for i in c.constants.len() {
        if same(view(c.constants[i].module), module) {
            candidate := c.constants[i].name.copy();
            cost := edit_distance(view(name), view(candidate));
            if cost < best_cost {
                best_cost = cost;
                best = candidate;
            }
        }
    }
    for i in c.decls.len() {
        if same(view(c.decls[i].module), module) {
            candidate := c.decls[i].name.copy();
            cost := edit_distance(view(name), view(candidate));
            if cost < best_cost {
                best_cost = cost;
                best = candidate;
            }
        }
    }
    return best;
}
// A secondary label: another source position that explains the error (`borrowed here`).
struct DiagLabel {
    pos: u64,
    file: u64,
    text: u8[]
}
fn diag_label<a, b>(c: (&a mut C), pos: u64, text: &b [u8]) -> unit {
    file := c.file;
    c.diag_labels.push(DiagLabel { pos: pos, file: file, text: text.copy() });
    return ();
}
fn diag_help<a, b>(c: (&a mut C), text: &b [u8]) -> unit {
    c.diag_help.push(text.copy());
    return ();
}
// "path.grl:12:5": where a declaration starts, formatted once when it is declared. A duplicate is
// refused by naming the first declaration, and that one may be in another file - whose token
// indexes are not indexes into the current file's stream, so the position is kept as text.
fn position_text<a>(c: (&a mut C), at: u64) -> u8[] {
    file := c.file;
    mut out = file_path(&mut c, file);
    mut tok = at;
    if c.toks.len() <= tok {
        tok = 0;
    }
    line := c.toks[tok].line;
    col := c.toks[tok].col;
    out.push(58);
    push_bytes(&mut out, view(decimal_bytes(line)));
    out.push(58);
    push_bytes(&mut out, view(decimal_bytes(col)));
    return out;
}
fn find_constant<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    for i in c.constants.len() {
        k := &c.constants[i];
        if same(view(k.module), view(m)) & same(view(k.name), view(n)) {
            return i + 1;
        }
    }
    return 0;
}
// Where `m::name` is already declared as a type, an alias or a constant, or "" when nothing is.
fn first_declared_at<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u8[] {
    d := find_decl(&mut c, view(m), view(n));
    if d != 0 {
        return c.decls[d - 1].declared_at.copy();
    }
    a := find_alias(&mut c, view(m), view(n));
    if a != 0 {
        return c.aliases[a - 1].declared_at.copy();
    }
    k := find_constant(&mut c, view(m), view(n));
    if k != 0 {
        return c.constants[k - 1].declared_at.copy();
    }
    st := find_static(&mut c, view(m), view(n));
    if st != 0 {
        return c.statics[st - 1].declared_at.copy();
    }
    return u8[];
}
// "a struct named `P` is already declared at input.grl:1:8: rename one, or remove it". Two
// declarations under one name in one module used to be accepted, and the second silently won.
fn duplicate_declared<a, b, d, e>(c: (&a mut C), kind: &b [u8], name: &d [u8], m: &e [u8], at: u64) -> unit {
    first := first_declared_at(&mut c, m, name);
    mut msg = copy_bytes(view("a "));
    push_bytes(&mut msg, view(kind));
    push_bytes(&mut msg, view(" named `"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("` is already declared"));
    if first.len() != 0 {
        push_bytes(&mut msg, view(" at "));
        push_bytes(&mut msg, view(first));
    }
    push_bytes(&mut msg, view(": rename one, or remove it"));
    exchange(&mut c.pos, at);
    fail(&mut c, view(msg));
}
// A second type, handle, alias or constant under a name this module already uses for a type.
fn refuse_duplicate_type<a, b, d, e>(c: (&a mut C), kind: &b [u8], m: &e [u8], name: &d [u8], at: u64) -> unit {
    if (find_decl(&mut c, view(m), view(name)) != 0) || (find_alias(&mut c, view(m), view(name)) != 0) {
        duplicate_declared(&mut c, view(kind), view(name), view(m), at);
    }
    return ();
}
fn refuse_duplicate_constant<a, b, d>(c: (&a mut C), m: &b [u8], name: &d [u8], at: u64) -> unit {
    if find_constant(&mut c, view(m), view(name)) != 0 {
        duplicate_declared(&mut c, view("constant"), view(name), view(m), at);
    }
    if find_static(&mut c, view(m), view(name)) != 0 {
        duplicate_declared(&mut c, view("static"), view(name), view(m), at);
    }
    return ();
}
fn find_static<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    for i in c.statics.len() {
        k := &c.statics[i];
        if same(view(k.module), view(m)) & same(view(k.name), view(n)) {
            return i + 1;
        }
    }
    return 0;
}
// A parameter list naming one binding twice: the second shadows the first for the whole body, so the
// first argument can never be read.
fn duplicate_param_fail<a, b, d>(c: (&a mut C), function: &b [u8], param: &d [u8], at: u64) -> unit {
    mut msg = copy_bytes(view("`"));
    push_bytes(&mut msg, view(function));
    push_bytes(&mut msg, view("` has two parameters named `"));
    push_bytes(&mut msg, view(param));
    push_bytes(&mut msg, view("`: rename the second, the first can never be read"));
    exchange(&mut c.pos, at);
    fail(&mut c, view(msg));
}
// Two methods with one name on one type: the second is not reachable through `receiver.name`, and
// "declared twice in this module" is the wrong sentence for something that is not in the module.
fn duplicate_method_fail<a, b>(c: (&a mut C), name: &b [u8], at: u64) -> unit {
    mut msg = copy_bytes(view("this type already has a method named `"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("`: rename one, or remove it"));
    exchange(&mut c.pos, at);
    fail(&mut c, view(msg));
}
// A C callback is exported under a fixed symbol with the C ABI: a generic parameter has no
// representation there. A lifetime (`a`) and a type parameter (`T`) used to be accepted and quietly
// ignored, which emitted a function C could not call.
fn ffi_callback_concrete<a, b, d>(c: (&a mut C), kind: &b [u8], name: &d [u8], at: u64) -> unit {
    mut msg = copy_bytes(view("an `extern \"C\"` callback cannot take a "));
    push_bytes(&mut msg, view(kind));
    push_bytes(&mut msg, view(": `"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("` has no C representation"));
    diag_help(&mut c, view("give the exported function a concrete signature C can call, or keep the generic a normal `fn` and call it from the callback"));
    exchange(&mut c.pos, at);
    fail(&mut c, view(msg));
}
// Two fields (or, for an enum, two variants) with one name: the second is unreachable through a
// `.name`, so it is refused rather than laid out behind the first.
fn duplicate_field_fail<a, b, d>(c: (&a mut C), owner: &b [u8], field: &d [u8], is_enum: u64, at: u64) -> unit {
    mut msg = copy_bytes(view("`"));
    push_bytes(&mut msg, view(owner));
    push_bytes(&mut msg, view("` has two "));
    if is_enum != 0 {
        push_bytes(&mut msg, view("variants"));
    } else {
        push_bytes(&mut msg, view("fields"));
    }
    push_bytes(&mut msg, view(" named `"));
    push_bytes(&mut msg, view(field));
    push_bytes(&mut msg, view("`: rename or remove the second, it can never be read"));
    exchange(&mut c.pos, at);
    fail(&mut c, view(msg));
}
// Line (1-based), column (1-based) and the bounds of the line holding byte `at` of `src`.
struct DiagPos {
    line: u64,
    column: u64,
    begin: u64,
    finish: u64
}
fn diag_pos(src: &u8[], at: u64) -> DiagPos {
    mut line = 1;
    mut column = 1;
    for i in at {
        if src[i] == 10 {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    mut begin = at;
    while 0 < begin {
        if src[begin - 1] == 10 {
            break;
        }
        begin -= 1;
    }
    mut finish = at;
    while finish < src.len() {
        if src[finish] == 10 {
            break;
        }
        finish += 1;
    }
    return DiagPos { line: line, column: column, begin: begin, finish: finish };
}
fn diag_digits(n: u64) -> u64 {
    mut d = 1;
    mut v = n;
    while 9 < v {
        v = v / 10;
        d += 1;
    }
    return d;
}
// `width` spaces then " | ", the gutter of a line without a number.
fn diag_gutter<a>(c: (&a mut C), width: u64) -> unit {
    for i in width {
        c.out.push(32);
    }
    o(&mut c, view(" |"));
    return ();
}
// One numbered source line and its underline: `^` for the primary span, `-` for a label.
fn diag_excerpt<a, b, d>(c: (&a mut C), width: u64, at: &d DiagPos, span: u64, mark: u8, label: &b [u8]) -> unit {
    n := diag_digits(at.line);
    for i in width - n {
        c.out.push(32);
    }
    on(&mut c, at.line);
    o(&mut c, view(" | "));
    for i in at.finish - at.begin {
        b := c.src[at.begin + i];
        if b == 9 {
            c.out.push(32);
        } else {
            c.out.push(b);
        }
    }
    c.out.push(10);
    diag_gutter(&mut c, width);
    c.out.push(32);
    for i in at.column - 1 {
        c.out.push(32);
    }
    for i in span {
        c.out.push(mark);
    }
    if label.len() != 0 {
        c.out.push(32);
        o(&mut c, label);
    }
    c.out.push(10);
    return ();
}
// Every compile error, rendered the way rustc does: the message, the location, the source line
// with the offending token underlined, any secondary labels (other lines that explain it, in source
// order), and `help:` / `note:` lines. A rejected program exits with status 1.
fn fail<a, b>(c: (&a mut C), msg: &b [u8]) -> unit {
    // A body worker reports nothing: its parent sees the short stream and compiles the module
    // itself, which reports the error exactly as a compile in one process does.
    if c.par_me != 0 {
        host::exit(3);
    }
    // The diagnostic is rendered through the emitters.
    exchange(&mut c.quiet, 0);
    p := c.pos;
    m := tok_text(&mut c, p);
    // The offending token's width: the caret run under the primary line, and the width a driver
    // draws for the diagnostic. Clamped the way the excerpt clamps it.
    mut span = m.len();
    if span == 0 {
        span = 1;
    }
    if 60 < span {
        span = 60;
    }
    // A refusal raised past the last token ("expected `{`, found the end of the file") points at
    // the end of the source, where the missing token belongs.
    mut st = c.src.len();
    if p < c.toks.len() {
        st = c.toks[p].start;
    }
    exchange(&mut c.out, u8[]);
    here := diag_pos(&c.src, st);
    file := c.file;
    path := file_path(&mut c, file);
    // One diagnostic per distinct (file, line, column, message). A generic template is replayed for
    // its validation and again for each specialisation, so the same source line can be reached
    // several times in one compile; only the first reach of it is printed, and only that one is
    // counted in the summary. The key is short enough to carry through `--reported`.
    mut key = copy_bytes(view(path));
    key.push(58);
    push_bytes(&mut key, view(decimal_bytes(here.line)));
    key.push(58);
    push_bytes(&mut key, view(decimal_bytes(here.column)));
    key.push(58);
    push_bytes(&mut key, view(msg));
    mut fresh = true;
    for i in c.reported.len() {
        if same(view(c.reported[i]), view(key)) {
            fresh = false;
        }
    }
    if !fresh {
        // Already reported by an earlier run: print nothing, count nothing, and still skip the
        // body, so this run goes on to the next error.
        next_error(&mut c, view(""));
        host::exit(1);
        return ();
    }
    c.reported.push(key.copy());
    // Labels in this file, by line, and the widest line number the excerpt prints.
    labels := exchange(&mut c.diag_labels, DiagLabel[]);
    helps := exchange(&mut c.diag_help, u8[][]);
    primary := exchange(&mut c.diag_primary, u8[]);
    mut width = diag_digits(here.line);
    mut shown = DiagLabel[];
    // Which labels have been drawn. This used to be `pos = 0` on the label just rendered, and a real
    // label on a file's *first* token was then read as "already drawn": the loop asked for the label
    // after the last one and indexed past it, so a refusal that labels token 0 - "this `fn` has no
    // body" at the top of a file - was a compiler abort (docs/design/frontend-robustness.md).
    mut rendered = u64[];
    for i in labels.len() {
        l := &labels[i];
        if (l.file == file) & (l.pos < c.toks.len()) & (l.pos != p) {
            lp := diag_pos(&c.src, c.toks[l.pos].start);
            if width < diag_digits(lp.line) {
                width = diag_digits(lp.line);
            }
            shown.push(DiagLabel { pos: l.pos, file: l.file, text: l.text.copy() });
            rendered.push(0);
        }
    }
    code := explain::code_of(msg);
    if code.len() == 0 {
        o(&mut c, view("error: "));
    } else {
        o(&mut c, view("error["));
        o(&mut c, view(code));
        o(&mut c, view("]: "));
    }
    o(&mut c, msg);
    c.out.push(10);
    for i in width {
        c.out.push(32);
    }
    o(&mut c, view("--> "));
    o(&mut c, view(path));
    c.out.push(58);
    on(&mut c, here.line);
    c.out.push(58);
    on(&mut c, here.column);
    c.out.push(10);
    diag_gutter(&mut c, width);
    c.out.push(10);
    // The primary line and the labels, in source order; a gap of more than one line is `...`.
    mut done = false;
    mut last_line = 0;
    mut k = 0;
    while (k < shown.len()) || !done {
        mut next_label = shown.len();
        mut best = 0;
        for j in shown.len() {
            lj := c.toks[shown[j].pos].start;
            if (rendered[j] == 0) & ((next_label == shown.len()) || (lj < best)) {
                next_label = j;
                best = lj;
            }
        }
        if !done & ((next_label == shown.len()) || (st <= best)) {
            if (last_line != 0) & (last_line + 1 < here.line) {
                o(&mut c, view("...\n"));
            }
            diag_excerpt(&mut c, width, &here, span, 94, view(primary));
            last_line = here.line;
            done = true;
            continue;
        }
        if next_label == shown.len() {
            // Nothing left to draw: every label is rendered and the primary line is out.
            done = true;
            continue;
        }
        lp := diag_pos(&c.src, best);
        if (last_line != 0) & (last_line + 1 < lp.line) {
            o(&mut c, view("...\n"));
        }
        ltok := shown[next_label].pos;
        mut lspan = tok_text(&mut c, ltok).len();
        if lspan == 0 {
            lspan = 1;
        }
        if 60 < lspan {
            lspan = 60;
        }
        text := shown[next_label].text.copy();
        diag_excerpt(&mut c, width, &lp, lspan, 45, view(text));
        last_line = lp.line;
        rendered[next_label] = 1;
        k += 1;
    }
    for i in helps.len() {
        diag_gutter(&mut c, width);
        c.out.push(10);
        for j in width {
            c.out.push(32);
        }
        o(&mut c, view(" = help: "));
        o(&mut c, view(helps[i]));
        c.out.push(10);
    }
    if c.diag_json.len() != 0 {
        diag_record(&mut c, view(path), here, span, view(code), view(msg));
    } else {
        host::print(view(c.out));
    }
    next_error(&mut c, view(key));
    // A rejected program is an ordinary failure (status 1), not a crash of the compiler.
    host::exit(1);
    return ();
}
// Refuse at a position in a file that may not be the one being read: the token stream an excerpt
// and a caret are drawn from is the loaded file's, so load it first. A refusal about a declaration
// has to point at that declaration, not at whatever file the last pass happened to read.
fn fail_in_file<a, b>(c: (&a mut C), file: u64, pos: u64, msg: &b [u8]) -> unit {
    if c.file != file {
        load_file(&mut c, file);
        exchange(&mut c.file, file);
    }
    exchange(&mut c.pos, pos);
    fail(&mut c, view(msg));
    return ();
}
// One diagnostic as a JSON object on its own line, appended to the listener's file
// (`--diagnostics-json FILE`). The fields come from the diagnostic itself - the position it was
// built with and the width of the token it points at, the message, and the code `grail explain`
// knows - not from the text the compiler would have printed; `rendered` carries that text for a driver that shows a human what the compiler had
// to say. One compile run appends the diagnostics it is the first to report: the re-runs that report
// the next error carry `--diagnostics-json` along, so a cycle's file holds every one of them.
fn diag_record<a, b, d, e>(c: (&a mut C), path: &b [u8], here: DiagPos, span: u64, code: &d [u8], msg: &e [u8]) -> unit {
    mut out = u8[];
    push_bytes(&mut out, view("{\"file\":\""));
    cli::json_text(&mut out, view(path));
    push_bytes(&mut out, view("\",\"line\":"));
    decimal(&mut out, here.line);
    push_bytes(&mut out, view(",\"col\":"));
    decimal(&mut out, here.column);
    // The end of the token the diagnostic points at: `col` plus its width, so a reader draws the
    // range the compiler underlines without reading the caret form.
    push_bytes(&mut out, view(",\"col_end\":"));
    decimal(&mut out, here.column + span);
    push_bytes(&mut out, view(",\"code\":\""));
    cli::json_text(&mut out, view(code));
    push_bytes(&mut out, view("\",\"message\":\""));
    cli::json_text(&mut out, view(msg));
    push_bytes(&mut out, view("\",\"rendered\":\""));
    rendered := copy_bytes(view(c.out));
    cli::json_text(&mut out, view(rendered));
    push_bytes(&mut out, view("\"}\n"));
    mut text = u8[];
    if host::exists(view(c.diag_json)) != 0 {
        text = host::read_file(view(c.diag_json));
    }
    push_bytes(&mut text, view(out));
    host::write_file(view(c.diag_json), view(text));
    return ();
}
// After an error in a function body: run this compile again with that body skipped, so it reports
// the next error too (up to 20). The program is rejected either way; nothing is written. An error
// outside any body - a declaration, a signature - ends the compile, since what follows it would
// mostly be consequences of it.
fn next_error<a, b>(c: (&a mut C), key: &b [u8]) -> unit {
    // A compile-time probe reports its first error and stops: the outer compile says which call did
    // not compile. Re-running a probe to find its next error re-ran every probe beneath it, so a
    // failure deep in a chain multiplied through every level (docs/design/comptime-speed.md).
    if c.probe_mode != 0 {
        return ();
    }
    // The cap is on runs, not on printed diagnostics: a chain that makes no progress still ends.
    attempts := c.skip_bodies.len() / 2 + 1;
    if (c.body_pos == 0) || (20 <= attempts) {
        error_summary(c.reported.len(), u64(c.diag_json.len() != 0));
        return ();
    }
    for i in c.skip_bodies.len() / 2 {
        if (c.skip_bodies[2 * i] == c.body_file) & (c.skip_bodies[2 * i + 1] == c.body_pos) {
            error_summary(c.reported.len(), u64(c.diag_json.len() != 0));
            return ();
        }
    }
    mut self = copy_bytes(view("/proc/self/exe"));
    if host::exists(view(self)) == 0 {
        self = host::arg(0);
    }
    mut run = u8[][self];
    mut at = decimal_bytes(c.body_file);
    at.push(58);
    push_bytes(&mut at, view(decimal_bytes(c.body_pos)));
    run.push(copy_bytes(view("--skip-body")));
    run.push(at);
    if key.len() != 0 {
        run.push(copy_bytes(view("--reported")));
        run.push(copy_bytes(key));
    }
    for i in host::argc() - 1 {
        run.push(host::arg(i + 1));
    }
    host::command(run);
    return ();
}
// `listener` is non-zero when a structured-diagnostics listener owns the output: the count below
// would be printed text, and the records already carry every diagnostic it would count.
fn error_summary(count: u64, listener: u64) -> unit {
    if count < 2 {
        return ();
    }
    if listener != 0 {
        // The records already say how many, one per diagnostic; a driver counts them.
        return ();
    }
    mut line = copy_bytes(view("error: aborting due to "));
    push_bytes(&mut line, view(decimal_bytes(count)));
    push_bytes(&mut line, view(" previous errors\n"));
    host::print(view(line));
    return ();
}
fn decimal_bytes(n: u64) -> u8[] {
    mut out = u8[];
    decimal(&mut out, n);
    return out;
}
// Command-line errors happen before any token stream exists, so they bypass the caret diagnostic.
fn fail_option<a, b>(c: (&a mut C), msg: &b [u8]) -> unit {
    o(&mut c, view("grail: "));
    o(&mut c, msg);
    c.out.push(10);
    host::print(view(c.out));
    host::exit(1);
    return ();
}
fn eat<a, b>(c: (&a mut C), s: &b [u8]) -> bool {
    i := c.pos;
    if c.toks.len() <= i {
        if s.len() != 0 {
            return false;
        }
    } else {
        st := c.toks[i].start;
        if c.toks[i].end - st != s.len() {
            return false;
        }
        for k in s.len() {
            if c.src[st + k] != s[k] {
                return false;
            }
        }
    }
    advance(&mut c);
    return true;
}
fn expect<a, b>(c: (&a mut C), s: &b [u8]) -> unit {
    if !eat(&mut c, s) {
        want := s.copy();
        mut msg = copy_bytes(view("expected `"));
        push_bytes(&mut msg, view(want));
        msg.push(96);
        push_bytes(&mut msg, view(found_msg(&mut c)));
        fail(&mut c, view(msg));
    }
    return ();
}
// ---- refinement predicates (docs/design/refinements.md) ------------------------------------------
// `p: T where P` and `-> T ensures P` keep P as a token range in the file it was written in - a
// source file, or the virtual source an interface carries. Nothing is parsed at the declaration: the
// obligation compiles the expression where the value enters (a call site, a record literal, a
// `return`), with the names bound to the values there.
//
// A predicate's text, its tokens separated by single spaces: what a runtime error and a diagnostic
// show.
fn pred_text<a>(c: (&a mut C), p: Pred) -> u8[] {
    mut out = u8[];
    if !has_pred(&p) {
        return out;
    }
    saved_file := c.file;
    saved_pos := c.pos;
    if saved_file != p.file {
        load_file(&mut c, p.file);
        exchange(&mut c.file, p.file);
    }
    // The predicate's own text, whitespace runs collapsed to one space: what the author wrote.
    from := c.toks[p.lo].start;
    to := c.toks[p.hi - 1].end;
    mut space = false;
    for i in from .. to {
        ch := c.src[i];
        if (ch == 10) || (ch == 9) || (ch == 13) || (ch == 32) {
            space = true;
        } else {
            if space & (out.len() != 0) {
                out.push(32);
            }
            space = false;
            out.push(ch);
        }
    }
    if (saved_file != p.file) & (saved_file != 0) {
        load_file(&mut c, saved_file);
        exchange(&mut c.file, saved_file);
        exchange(&mut c.pos, saved_pos);
    }
    return out;
}
// The pure calls a predicate may make: `len()` (through a `.`), `is_finite()` and `is_nan()`.
fn pred_pure_call<a, b, d>(name: &a [u8], before: &b [u8], dot: &d [u8]) -> bool {
    if same(view(name), view("is_finite")) || same(view(name), view("is_nan")) {
        return true;
    }
    return same(view(name), view("len")) & same(view(before), view(dot));
}
// Refuse a predicate that could run user code or have a side effect (docs/design/refinements.md,
// "Where predicates go"). The stop tokens are not part of the predicate.
fn pred_check<a, b, d>(c: (&a mut C), lo: u64, hi: u64, what: &b [u8], stop_a: &d [u8]) -> unit {
    if lo == hi {
        fail(&mut c, view(what));
    }
    mut i = lo;
    while i < hi {
        t := tok_text(&mut c, i);
        mut before = u8[];
        if i != 0 {
            before = tok_text(&mut c, i - 1);
        }
        if kind_at(&mut c, i) == 1 {
            mut after_ok = false;
            if i + 1 < c.toks.len() {
                after_ok = same(view(tok_text(&mut c, i + 1)), view("("));
            }
            if after_ok & !pred_pure_call(view(t), view(before), view(".")) {
                mut msg = "a refinement predicate cannot call a function: ";
                msg.append(view(t));
                msg.append(view(" is not pure"));
                fail(&mut c, view(msg));
            }
            if same(view(t), view("mut"))
                || same(view(t), view("return"))
                || same(view(t), view("while"))
                || same(view(t), view("for"))
                || same(view(t), view("loop"))
                || same(view(t), view("break"))
                || same(view(t), view("continue"))
                || same(view(t), view("drop")) {
                mut msg = "a refinement predicate cannot run a statement: ";
                msg.append(view(t));
                fail(&mut c, view(msg));
            }
        }
        if same(view(t), view("="))
            || same(view(t), view("+="))
            || same(view(t), view("-="))
            || same(view(t), view("*="))
            || same(view(t), view("/="))
            || same(view(t), view("%="))
            || same(view(t), view("&="))
            || same(view(t), view("|="))
            || same(view(t), view("^="))
            || same(view(t), view("<<="))
            || same(view(t), view(">>="))
            || same(view(t), view("|"))
            || same(view(t), view(";"))
            || same(view(t), view(stop_a)) {
            mut msg = "a refinement predicate cannot assign or branch: ";
            msg.append(view(t));
            fail(&mut c, view(msg));
        }
        i += 1;
    }
    return ();
}
// What a field predicate may say (docs/design/refinements.md, "Field predicates"): fields of its own
// record and nothing else - a parameter or a global would be read in the scope of whoever builds the
// record - each of them a number or an owned vector (its `len()`). The field's own type is checked
// here; the names, once the record's fields are all known (ref_field_pred_names).
fn ref_pred_type_ok<a>(c: (&a mut C), ty: u64) -> bool {
    t := base_type(&mut c, ty);
    k := ty_kind(&mut c, t);
    return (t == 0) || (k == 18) || (k == 21) || (k == 6);
}
fn ref_field_pred_rules<a, b>(c: (&a mut C), field: &b [u8], ty: u64, lo: u64, hi: u64, at: u64) -> unit {
    if !ref_pred_type_ok(&mut c, ty) {
        diag_label(&mut c, at, view("this field's type has no predicate the compiler checks"));
        fail(&mut c, view("a field predicate applies to an integer, a float or an owned vector (through `len()`)"));
    }
    return ();
}
// Every name a field predicate reads must be a field of the record, of a type a predicate checks.
fn ref_field_pred_names<a, b>(c: (&a mut C), record: &b [u8], fields: (&a Field[]), lo: u64, hi: u64) -> unit {
    mut i = lo;
    while i < hi {
        if kind_at(&mut c, i) == 1 {
            t2 := tok_text(&mut c, i);
            after_dot := (i > lo) && (kind_at(&mut c, i - 1) == 46);
            call := kind_at(&mut c, i + 1) == 40;
            word := same(view(t2), view("true")) || same(view(t2), view("false"));
            if !after_dot & !call & !word {
                mut found = 0;
                mut ty = 0;
                for j in fields.len() {
                    if same(view(fields[j].name), view(t2)) {
                        found = 1;
                        ty = fields[j].ty;
                    }
                }
                if found == 0 {
                    mut msg = copy_bytes(view("a field predicate may name only fields of its record: `"));
                    push_bytes(&mut msg, view(t2));
                    push_bytes(&mut msg, view("` is not a field of `"));
                    push_bytes(&mut msg, view(record));
                    push_bytes(&mut msg, view("`"));
                    exchange(&mut c.pos, i);
                    fail(&mut c, view(msg));
                }
                if !ref_pred_type_ok(&mut c, ty) {
                    mut msg = copy_bytes(view("a field predicate may read only integer, float and vector fields: `"));
                    push_bytes(&mut msg, view(t2));
                    push_bytes(&mut msg, view("` is not one"));
                    exchange(&mut c.pos, i);
                    fail(&mut c, view(msg));
                }
            }
        }
        i += 1;
    }
    return ();
}
// Read a predicate into a token range, up to (not including) one of the two stop tokens at bracket
// depth 0. `c.pos` is left on the stop token, so the caller still reads its own comma, brace or
// arrow.
fn pred_scan<a, b>(c: (&a mut C), stop_a: &a [u8], stop_b: &b [u8]) -> Pred {
    lo := c.pos;
    mut depth = 0;
    mut i = c.pos;
    while i < c.toks.len() {
        t := tok_text(&mut c, i);
        k := kind_at(&mut c, i);
        if depth == 0 && (same(view(t), view(stop_a)) || same(view(t), view(stop_b))) {
            break;
        }
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        }
        if (k == 41) || (k == 93) || (k == 125) {
            if depth == 0 {
                break;
            }
            depth -= 1;
        }
        i += 1;
    }
    if i == c.toks.len() {
        mut msg = "a refinement predicate is not closed: ";
        msg.append(view(stop_b));
        fail(&mut c, view(msg));
    }
    pred_check(&mut c, lo, i, view("a refinement predicate cannot be empty"), view(stop_a));
    exchange(&mut c.pos, i);
    return Pred { file: c.file, lo: lo, hi: i };
}
// The default value of a parameter, as a token range up to (not including) the `,` or `)` that ends
// it at bracket depth 0. `c.pos` is left on that separator, so the caller reads its own comma or
// paren. A closure's parameter list (`|a, b| x`) holds commas of its own at depth 0, so the bars are
// counted and a comma between them does not end the default.
fn default_scan<a>(c: (&a mut C)) -> Pred {
    lo := c.pos;
    mut depth = 0;
    mut bars = 0;
    mut i = c.pos;
    while i < c.toks.len() {
        k := kind_at(&mut c, i);
        if (depth == 0) & (bars % 2 == 0) & ((k == 44) || (k == 41)) {
            break;
        }
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        }
        if (k == 41) || (k == 93) || (k == 125) {
            if depth == 0 {
                break;
            }
            depth -= 1;
        }
        if k == 124 {
            bars += 1;
        }
        i += 1;
    }
    if i == c.toks.len() {
        fail(&mut c, view("a parameter's default value is not closed: it needs a `,` or `)` after it"));
    }
    if lo == i {
        fail(&mut c, view("`=` in a parameter list needs a value after it"));
    }
    exchange(&mut c.pos, i);
    return Pred { file: c.file, lo: lo, hi: i };
}
// A predicate carried by an interface: its text becomes a virtual source of its own, so the range is
// that file's whole token stream and replay compiles exactly what the defining module compiled.
fn pred_of_text<a, b, d>(c: (&a mut C), label: &b [u8], text: &d [u8]) -> Pred {
    file := virtual_source(&mut c, view(label), view(text));
    saved_file := c.file;
    saved_pos := c.pos;
    load_file(&mut c, file);
    n := c.toks.len();
    if saved_file != file {
        if saved_file != 0 {
            load_file(&mut c, saved_file);
        }
        exchange(&mut c.file, saved_file);
        exchange(&mut c.pos, saved_pos);
    }
    return Pred { file: file, lo: 0, hi: n };
}
// `file:line:col` of a token in `file`: where a declaration is written, for the requirement line.
fn src_where<a>(c: (&a mut C), file: u64, pos: u64) -> u8[] {
    // The text this returns names a line of the file, and it is going into the body's bytes.
    fn_use(&mut c, FN_ABSOLUTE);
    saved_file := c.file;
    saved_pos := c.pos;
    if (saved_file != file) & (file != 0) {
        load_file(&mut c, file);
        exchange(&mut c.file, file);
    }
    path := site_path(&c, file);
    mut line = 1;
    mut col = 1;
    mut stop = 0;
    if pos < c.toks.len() {
        stop = c.toks[pos].start;
    }
    for i in stop {
        if c.src[i] == 10 {
            line += 1;
            col = 1;
        } else {
            col += 1;
        }
    }
    mut out = path.copy();
    out.push(58);
    decimal(&mut out, line);
    out.push(58);
    decimal(&mut out, col);
    if (saved_file != file) & (file != 0) {
        load_file(&mut c, saved_file);
        exchange(&mut c.file, saved_file);
        exchange(&mut c.pos, saved_pos);
    }
    return out;
}
// A NUL-terminated string in read-only data, labelled so the check can name it. Mach-O puts a C
// string in __TEXT,__cstring, the section `cstr` uses; ELF has one .rodata for both.
fn ref_data<a, b, d>(c: (&a mut C), label: &b [u8], text: &d [u8]) -> unit {
    if c.plat == 1 {
        o(&mut c, view(".pushsection __TEXT,__cstring\n"));
    } else {
        o(&mut c, view(".pushsection .rodata\n"));
    }
    o(&mut c, view(label));
    o(&mut c, view(":\n.asciz \""));
    for i in text.len() {
        ch := text[i];
        if (ch == 34) || (ch == 92) {
            c.out.push(92);
        }
        if ch == 10 {
            c.out.push(92);
            c.out.push(110);
        } else {
            c.out.push(ch);
        }
    }
    o(&mut c, view("\"\n.popsection\n"));
    return ();
}
// Compile a predicate at its own position with `names` bound to the values in `slots`. The bindings
// are ordinary locals pushed for the predicate and dropped afterwards: a predicate only reads, and
// creating (or dropping) a value here would be a side effect it does not have.
fn pred_value<a, b, d, e>(c: (&a mut C), pred: Pred, names: (&b u8[][]), slots: (&d u64[]), tys: (&e u64[])) -> Val {
    saved_file := c.file;
    saved_pos := c.pos;
    if (saved_file != pred.file) & (pred.file != 0) {
        load_file(&mut c, pred.file);
        exchange(&mut c.file, pred.file);
    }
    mark := c.locals.len();
    for k in names.len() {
        c
            .locals
            .push(
                Local {
                    name: names[k].copy(),
                    ty: tys[k],
                    id: slots[k],
                    last: 1000000000,
                    born: 0,
                    mutable: 0,
                    flex: 0,
                    lit: 0,
                    neg: 0,
                    origin: 0,
                    at: 0,
                }
            );
    }
    exchange(&mut c.pos, pred.lo);
    v := expr(&mut c, 0);
    while mark < c.locals.len() {
        c.locals.pop()!;
    }
    if (saved_file != pred.file) & (pred.file != 0) {
        load_file(&mut c, saved_file);
        exchange(&mut c.file, saved_file);
    }
    exchange(&mut c.pos, saved_pos);
    return v;
}
// ` = required by <fn> at <where>` - the line a failure names after the location.
fn ref_requirement<a>(c: (&a mut C), fn_name: &a [u8], at: &a [u8]) -> u8[] {
    mut out = copy_bytes(view(" = required by "));
    push_bytes(&mut out, view(fn_name));
    push_bytes(&mut out, view(" at "));
    push_bytes(&mut out, view(at));
    out.push(10);
    return out;
}
// One obligation: `pred` must hold of the values in `slots`, or the program stops saying which
// predicate it violated and which function required it. An obligation the prover discharges emits no
// check at all (step 3's hook is `ref_proved`, which is false for now).
fn ref_check<a, b, d, e>(c: (&a mut C), pred: Pred, names: (&b u8[][]), slots: (&d u64[]), tys: (&e u64[]), fn_name: u8[], at_file: u64, at_pos: u64, proved: u64, at_entry: u64) -> unit {
    if !has_pred(&pred) {
        return ();
    }
    if c.validating != 0 {
        return ();
    }
    // A proved obligation needs no check: the proof is the whole of what it needs. `--verify-facts`
    // emits it anyway, so a prover bug shows up as a failing test rather than as a silent hole.
    if (proved != 0) & (c.verify_facts == 0) {
        return ();
    }
    n := ref_number(&mut c);
    v := pred_value(&mut c, Pred { file: pred.file, lo: pred.lo, hi: pred.hi }, &names, &slots, &tys);
    if c.raw == 0 {
        require_type(&mut c, v.ty, 0);
    }
    get(&mut c, v.t, view("%rax"));
    o(&mut c, view("testq %rax,%rax\n"));
    ok := label(&mut c);
    jump(&mut c, view("jnz"), ok);
    text := pred_text(&mut c, pred);
    at := src_where(&mut c, at_file, at_pos);
    req := ref_requirement(&mut c, view(fn_name), view(at));
    mut pred_label = copy_bytes(view(".Lrfp"));
    push_bytes(&mut pred_label, view(c.lpart));
    pred_label.push(95);
    mut req_label = copy_bytes(view(".Lrfr"));
    push_bytes(&mut req_label, view(c.lpart));
    req_label.push(95);
    if c.fscope != 0 {
        decimal(&mut pred_label, c.fscope);
        pred_label.push(95);
        decimal(&mut req_label, c.fscope);
        req_label.push(95);
    }
    decimal(&mut pred_label, n);
    decimal(&mut req_label, n);
    ref_data(&mut c, view(pred_label), view(text));
    ref_data(&mut c, view(req_label), view(req));
    o(&mut c, view("leaq "));
    o(&mut c, view(pred_label));
    o(&mut c, view("(%rip),%rdi\nleaq "));
    o(&mut c, view(req_label));
    if at_entry != 0 {
        call_entry_out(&mut c, view("(%rip),%rsi\ncall rt_refine\n"));
    } else {
        o(&mut c, view("(%rip),%rsi\n"));
        call_out(&mut c, view("rt_refine"));
    }
    mark(&mut c, ok);
    return ();
}
// The obligations at a value's entry into a function: each parameter's predicate, checked where the
// parameter is (so the values are the arguments'), with the call site as the location a failure
// reports - the frame above this one.
fn ref_params<a>(c: (&a mut C)) -> unit {
    if c.cur_ppreds.len() == 0 {
        return ();
    }
    mut emitted = 0;
    for i in c.cur_ppreds.len() {
        // Copied out: the predicate list is a field of `c`, which the check borrows.
        mut pf = 0;
        mut plo = 0;
        mut phi = 0;
        if i < c.cur_ppreds.len() {
            p := &c.cur_ppreds[i];
            pf = p.file;
            plo = p.lo;
            phi = p.hi;
        }
        if (phi == 0) || (i >= c.locals.len()) {
            continue;
        }
        mut none = u8[][];
        mut slots = u64[];
        mut tys = u64[];
        slot := local_id(&mut c, i);
        ty := local_ty(&mut c, i);
        slots.push(slot);
        tys.push(ty);
        name := c.cur_name.copy();
        at_file := c.cur_file;
        at_pos := c.cur_pos;
        ref_check(&mut c, Pred { file: pf, lo: plo, hi: phi }, &none, &slots, &tys, name, at_file, at_pos, 0, 1);
        emitted = emitted + 1;
    }
    if emitted != 0 {
        // The last check's own return address must not be the first statement's address, or a
        // failure would name that statement instead of the call: one jump keeps it in the prologue.
        past := label(&mut c);
        jump(&mut c, view("jmp"), past);
        mark(&mut c, past);
    }
    return ();
}
// How many parameters of the function being compiled carry a predicate.
fn ref_pred_count<a>(c: (&a mut C)) -> u64 {
    mut n = 0;
    for i in c.cur_ppreds.len() {
        if i < c.cur_ppreds.len() {
            p := &c.cur_ppreds[i];
            if p.hi != 0 {
                n += 1;
            }
        }
    }
    return n;
}
// The checking entry of a function with refined parameters, emitted after its body: an ordinary
// function `<name>` that stores the arguments, checks each parameter predicate (an entry fact of
// this record: the caller's obligation), puts the arguments back and calls `<name>.proved`, whose
// result it returns in `%rax`. Every unproved caller, a function value and a vtable reach it; a
// proved call skips it. Words past the sixth arrive on the stack and are passed on the same way.
fn ref_wrapper<a, b, d>(c: (&a mut C), m: &b [u8], name: &b [u8], body_symbol: &d [u8], export: u64, count: u64, position: u64, claimed_alloc: u64, claimed_panic: u64, entry_state: ownership::State) -> unit {
    after := exchange(&mut c.check, entry_state);
    func_directive(&mut c, view(m), view(name), view(body_symbol), export);
    label_at := c.out.len();
    body_text_at := exchange(&mut c.fn_text_at, label_at);
    export_name(&mut c, view(m), view(name), view(body_symbol), export);
    mut sym = u8[];
    for i in c.out.len() - label_at {
        sym.push(c.out[label_at + i]);
    }
    o(&mut c, view(":\n"));
    fx_begin(&mut c, view(sym), view(name), c.file, position, claimed_alloc, claimed_panic);
    // The wrapper's own facts key, and the body's two-word result passing through it in rax:rdx.
    body_facts := c.facts_fn.copy();
    if body_facts.len() != 0 {
        exchange(&mut c.facts_fn, sym.copy());
    }
    if c.dyn_result_seen != 0 {
        dyn_result(&mut c);
    }
    o(&mut c, view("pushq %rbp\nmovq %rsp,%rbp\n"));
    frame := label(&mut c);
    if c.target == 4 {
        o(&mut c, view("framesub "));
        fname(&mut c, frame);
        c.out.push(10);
    } else {
        o(&mut c, view("subq $"));
        fname(&mut c, frame);
        o(&mut c, view(",%rsp\n"));
    }
    // A result of more than two words comes with the caller's destination address after the
    // declared arguments (begin_result_dest): the wrapper keeps it in a slot of its own and hands it
    // on, so the body writes the caller's words.
    mut total = count;
    if c.result_dest != 0 {
        total = count + 1;
    }
    mut dslot = 0;
    if total != count {
        dslot = fresh(&mut c);
    }
    // Six words arrive in registers and the rest on the stack, word 6 + k at 16 + 8k(%rbp)
    // (load_call_args): all are stored for the checks, and handed on the same way.
    mut regs = total;
    if 6 < total {
        regs = 6;
    }
    for i in total {
        if i < 6 {
            o(&mut c, view("movq "));
            o(&mut c, view(argreg(i)));
            c.out.push(44);
        } else {
            o(&mut c, view("movq "));
            on(&mut c, 16 + (i - 6) * 8);
            o(&mut c, view("(%rbp),%rax\nmovq %rax,"));
        }
        if i < count {
            stack_slot(&mut c, i);
        } else {
            stack_slot(&mut c, dslot);
        }
        c.out.push(10);
    }
    ref_params(&mut c);
    mut area = 0;
    if 6 < total {
        extra := total - 6;
        area = 16 * ((extra + 1) / 2);
        x86 := (c.target == 0) || (c.target == 3);
        if x86 {
            o(&mut c, view("subq $"));
            on(&mut c, area);
            o(&mut c, view(",%rsp\n"));
        } else {
            o(&mut c, view("cstack "));
            on(&mut c, area);
            c.out.push(10);
        }
        for k in extra {
            o(&mut c, view("movq "));
            if 6 + k < count {
                stack_slot(&mut c, 6 + k);
            } else {
                stack_slot(&mut c, dslot);
            }
            o(&mut c, view(",%rax\n"));
            if x86 {
                ffi_store_stack(&mut c, 1, k * 8);
            } else {
                ffi_store_stack(&mut c, 0, k * 8);
            }
        }
    }
    for i in regs {
        o(&mut c, view("movq "));
        if i < count {
            stack_slot(&mut c, i);
        } else {
            stack_slot(&mut c, dslot);
        }
        c.out.push(44);
        o(&mut c, view(argreg(i)));
        c.out.push(10);
    }
    call_proved_out(&mut c, view(sym));
    release_call_args(&mut c, area);
    o(&mut c, view("leave\nret\n.set "));
    fname(&mut c, frame);
    c.out.push(44);
    on(&mut c, (c.next + 1) / 2 * 16);
    c.out.push(10);
    fx_end(&mut c);
    exchange(&mut c.check, after);
    if body_facts.len() != 0 {
        exchange(&mut c.facts_fn, body_facts);
    }
    exchange(&mut c.fn_text_at, body_text_at);
    return ();
}
// Whether field `k` of record `d` carries a predicate. Such a field is written only where the
// predicate is owed - a literal, `r.f = v` and `r.f op= v` - so no `&mut` to it may exist: through
// one, a write would reach the field with nothing to check it (docs/design/refinements.md, "Field
// predicates").
fn ref_field_refined<a>(c: (&a mut C), d: u64, k: u64) -> bool {
    if d >= c.decls.len() {
        return false;
    }
    if k >= c.decls[d].count {
        return false;
    }
    // Its own predicate, or any predicate of the record that reads it: a write through a loan would
    // skip either.
    count := c.decls[d].count;
    for j in count {
        if ref_pred_reads(&mut c, d, j, k) {
            return true;
        }
    }
    return false;
}
// The fields field `j`'s predicate reads, as field indices (its own included when it names itself).
// Empty when the field has no predicate.
fn ref_pred_fields<a>(c: (&a mut C), d: u64, j: u64) -> u64[] {
    mut out = u64[];
    f := c.decls[d].first + j;
    if f >= c.fields.len() {
        return out;
    }
    pf := c.fields[f].pred.file;
    plo := c.fields[f].pred.lo;
    phi := c.fields[f].pred.hi;
    if phi == 0 {
        return out;
    }
    text := pred_text(&mut c, Pred { file: pf, lo: plo, hi: phi });
    mut i = 0;
    while i < text.len() {
        ch := text[i];
        start_word := ((96 < ch) & (ch < 123)) || ((64 < ch) & (ch < 91)) || (ch == 95);
        if !start_word {
            i += 1;
            continue;
        }
        mut word = u8[];
        mut e = i;
        while e < text.len() {
            x := text[e];
            if ((96 < x) & (x < 123)) || ((64 < x) & (x < 91)) || (x == 95) || ((47 < x) & (x < 58)) {
                word.push(x);
                e += 1;
            } else {
                break;
            }
        }
        after_dot := (i > 0) && (text[i - 1] == 46);
        if !after_dot {
            idx := field_index(&mut c, d, view(word));
            if idx != 0 {
                mut seen = 0;
                for q in out.len() {
                    if out[q] == idx - 1 {
                        seen = 1;
                    }
                }
                if seen == 0 {
                    out.push(idx - 1);
                }
            }
        }
        i = e;
    }
    return out;
}
fn ref_pred_reads<a>(c: (&a mut C), d: u64, j: u64, k: u64) -> bool {
    fs := ref_pred_fields(&mut c, d, j);
    for q in fs.len() {
        if fs[q] == k {
            return true;
        }
    }
    return false;
}
// Whether field `j`'s predicate reads a field other than `j`: such a predicate is owed where every
// field it reads has its value (ref_field_cross), not where `j` alone is stored.
fn ref_pred_cross<a>(c: (&a mut C), d: u64, j: u64) -> bool {
    fs := ref_pred_fields(&mut c, d, j);
    for q in fs.len() {
        if fs[q] != j {
            return true;
        }
    }
    return false;
}
// Field `j`'s predicate across fields, over the values in `slots` (one per field of the record,
// indexed by field) with their terms. A field without a term makes the obligation unprovable: plain
// code checks it, strict mode refuses it.
fn ref_field_cross<a, b, e>(c: (&a mut C), d: u64, j: u64, rty: u64, slots_by_field: (&b u64[]), terms_by_field: (&e u8[][]), pos: u64, why: &b [u8]) -> unit {
    f := c.decls[d].first + j;
    pf := c.fields[f].pred.file;
    plo := c.fields[f].pred.lo;
    phi := c.fields[f].pred.hi;
    owner := c.decls[d].name.copy();
    mut who = owner.copy();
    who.push(46);
    push_bytes(&mut who, view(c.fields[f].name));
    fs := ref_pred_fields(&mut c, d, j);
    mut names = u8[][];
    mut slots = u64[];
    mut tys = u64[];
    mut terms = u8[][];
    mut all_terms = 1;
    for q in fs.len() {
        m := fs[q];
        names.push(c.fields[c.decls[d].first + m].name.copy());
        slots.push(slots_by_field[m]);
        tys.push(field_type(&mut c, rty, m));
        t := terms_by_field[m].copy();
        if t.len() == 0 {
            all_terms = 0;
        }
        terms.push(t);
    }
    mut proved = 0;
    report := u64(ref_strict(&c));
    need := pv_need(&mut c, view(who), pf, plo);
    if all_terms != 0 {
        proved = pv_proved(&mut c, Pred { file: pf, lo: plo, hi: phi }, &names, &terms, pos, report, view(need));
    }
    if (report != 0) & (proved == 0) {
        pv_strict_fail_why(&mut c, Pred { file: pf, lo: plo, hi: phi }, pos, view(need), view(why));
    }
    ref_check(&mut c, Pred { file: pf, lo: plo, hi: phi }, &names, &slots, &tys, who, pf, plo, proved, 0);
    return ();
}
// The refusal of a mutable borrow of a refined field, wherever the borrow is made.
fn ref_field_loan_fail<a>(c: (&a mut C), d: u64, k: u64) -> unit {
    mut msg = copy_bytes(view("cannot borrow the refined field `"));
    if (d < c.decls.len()) & (k < c.decls[d].count) {
        f := c.decls[d].first + k;
        push_bytes(&mut msg, view(c.decls[d].name));
        msg.push(46);
        push_bytes(&mut msg, view(c.fields[f].name));
    }
    push_bytes(&mut msg, view("` mutably: a write through the reference would skip its predicate; assign the field (`r.f = v`), which checks it"));
    fail(&mut c, view(msg));
    return ();
}
// The type of the local whose slot is `slot`, or the unit type's code when no local has it.
fn local_slot_ty<a>(c: (&a mut C), slot: u64) -> u64 {
    for i in c.locals.len() {
        if local_id(&mut c, i) == slot {
            return local_ty(&mut c, i);
        }
    }
    return 1;
}
// A receiver about to be mutated in place (`r.items.push(x)`, a `&mut self` method on `r.f`): when
// it is a field of a record and the field is refined, the call would write the field through a
// loan, so it is refused like `&mut r.f`.
fn ref_refuse_field_receiver<a>(c: (&a mut C), slot: u64) -> unit {
    index := resource(&mut c, slot);
    if index == 0 {
        return ();
    }
    base := c.resources[index - 1].base;
    field := c.resources[index - 1].field;
    if base == 0 {
        return ();
    }
    b := base - 1;
    owner := resource(&mut c, b);
    mut ty = 1;
    if owner != 0 {
        ty = c.resources[owner - 1].ty;
    } else {
        ty = local_slot_ty(&mut c, b);
    }
    d := slot_record_decl(&mut c, ty);
    if (d != 18446744073709551615) && ref_field_refined(&mut c, d, field) {
        ref_field_loan_fail(&mut c, d, field);
    }
    return ();
}
// The record declaration a slot holds, through any number of references; `NO_DECL` when it holds
// something else.
fn slot_record_decl<a>(c: (&a mut C), ty: u64) -> u64 {
    mut t = ty;
    while ty_kind(&mut c, t) == 7 {
        t = ty_arg(&mut c, t);
    }
    t = base_type(&mut c, t);
    if ty_kind(&mut c, t) != 8 {
        return 18446744073709551615;
    }
    return ty_arg(&mut c, t);
}
// `field: T where P` at the value's entry into a record: a literal must establish every refined
// field it fills, so `Ray { t_max: x }` is where the ray's invariant is owed.
fn ref_field<a, b>(c: (&a mut C), d: u64, k: u64, slot: u64, term: &b [u8], pos: u64) -> unit {
    f := c.decls[d].first + k;
    if f >= c.fields.len() {
        return ();
    }
    mut pf = 0;
    mut plo = 0;
    mut phi = 0;
    mut fname = u8[];
    mut fty = 0;
    mut owner = u8[];
    if f < c.fields.len() {
        p := &c.fields[f];
        pf = p.pred.file;
        plo = p.pred.lo;
        phi = p.pred.hi;
        fname = p.name.copy();
        fty = p.ty;
        owner = c.decls[d].name.copy();
    }
    if phi == 0 {
        return ();
    }
    if ref_pred_cross(&mut c, d, k) {
        return ();
    }
    mut who = u8[];
    push_bytes(&mut who, view(owner));
    who.push(46);
    push_bytes(&mut who, view(fname));
    mut names = u8[][fname];
    mut slots = u64[slot];
    mut tys = u64[fty];
    // The field's name stands for the value being stored: a proof reads the value's own term.
    mut terms = u8[][copy_bytes(view(term))];
    mut proved = 0;
    mut report = u64(ref_strict(&c));
    need := pv_need(&mut c, view(who), pf, plo);
    if term.len() != 0 {
        proved = pv_proved(&mut c, Pred { file: pf, lo: plo, hi: phi }, &names, &terms, pos, report, view(need));
    }
    if (report != 0) & (proved == 0) {
        // No term to read means no proof: strict mode refuses the literal itself.
        pv_strict_fail_why(&mut c, Pred { file: pf, lo: plo, hi: phi }, pos, view(need), view("the value is not a name or a constant"));
    }
    ref_check(&mut c, Pred { file: pf, lo: plo, hi: phi }, &names, &slots, &tys, who, pf, plo, proved, 0);
    return ();
}
// The same obligation at `r.f = v`: the field is named in the source, so its predicate is found by
// name in the record's declaration.
fn ref_field_named<a, b, d>(c: (&a mut C), ty: u64, fname: &b [u8], slot: u64, term: &d [u8], pos: u64) -> unit {
    mut shape = ty;
    if ty_kind(&mut c, shape) == 7 {
        shape = ty_arg(&mut c, shape);
    }
    if ty_kind(&mut c, shape) != 8 {
        return ();
    }
    d := ty_arg(&mut c, shape);
    if d >= c.decls.len() {
        return ();
    }
    first := c.decls[d].first;
    count := c.decls[d].count;
    for i in count {
        f := first + i;
        if f < c.fields.len() {
            if same(view(c.fields[f].name), view(fname)) {
                ref_field(&mut c, d, i, slot, term, pos);
                return ();
            }
        }
    }
    return ();
}
// `-> T ensures P` at every `return`: `result` is the value on its way out.
fn ref_result<a, b>(c: (&a mut C), slot: u64, ty: u64, term: &b [u8], pos: u64) -> unit {
    mut pf = 0;
    mut plo = 0;
    mut phi = 0;
    p := &c.cur_rpred;
    pf = p.file;
    plo = p.lo;
    phi = p.hi;
    if phi == 0 {
        return ();
    }
    mut names = u8[][copy_bytes(view("result"))];
    mut slots = u64[slot];
    mut tys = u64[ty];
    name := c.cur_name.copy();
    at_file := c.cur_file;
    at_pos := c.cur_pos;
    mut terms = u8[][copy_bytes(view(term))];
    mut proved = 0;
    mut report = u64(ref_strict(&c));
    need := pv_need(&mut c, view(name), at_file, at_pos);
    if term.len() != 0 {
        proved = pv_proved(&mut c, Pred { file: pf, lo: plo, hi: phi }, &names, &terms, pos, report, view(need));
    }
    if (report != 0) & (proved == 0) {
        pv_strict_fail_why(&mut c, Pred { file: pf, lo: plo, hi: phi }, pos, view(need), view("the returned value is not a name or a constant"));
    }
    ref_check(&mut c, Pred { file: pf, lo: plo, hi: phi }, &names, &slots, &tys, name, at_file, at_pos, proved, 0);
    return ();
}
// ---- the prover (docs/design/refinements.md, "The prover") ----------------------------------------
// An obligation is discharged from a small fact set read off the source tokens of the function being
// compiled, never inferred from the IR: what is proved is a property of the program the author wrote,
// and everything the prover cannot read it does not assume. So a check is removed only when a proof
// exists, and a program is never weaker than the checked one - the prover is an optimisation of a
// feature that is already sound.
//
// A term is a parameter's or local's name, a length spelled `v.len` (for `v.len()`), or a literal. An
// atom is `a < b + k`, `a <= b + k`, `a == b + k`, `a % k == 0`, `finite(a)` or `nan(a)`. Terms are
// compared by text: two occurrences of `i` in one function name the same variable unless a binding
// between them shadowed it, and a binding drops the facts that name it.
fn copy_atom_value<a>(x: (&a Atom)) -> Atom {
    return Atom { rel: x.rel, a: x.a.copy(), b: x.b.copy(), k: x.k, ao: x.ao, bo: x.bo };
}
// The weight of "no path": larger than any bound a fact can state, small enough that two of them
// added together stay inside i64.
fn pv_inf() -> i64 {
    return 4611686018427387904;
}
// Every sum of offsets in the prover goes through here. An offset is a signed 64-bit word, and a
// sum that left its range would be a wrong number in a proof; so a sum whose operands or result pass
// `2^60` in magnitude sets `bad`, and whoever asked abandons the atom or the path as "not proved".
// Inside the limit the addition is exact (`2^60 + 2^60` fits). The distances of the difference graph
// stay inside it too, since every one of them is such a sum, which keeps `pv_inf` out of reach.
fn pv_k_limit() -> i64 {
    return 1152921504606846976;
}
fn pv_k_sum<a>(x: i64, y: i64, bad: (&a mut u64)) -> i64 {
    limit := pv_k_limit();
    if (x > limit) || (y > limit) || (x < 0 - limit) || (y < 0 - limit) {
        exchange(bad, 1);
        return 0;
    }
    sum := x + y;
    if (sum > limit) || (sum < 0 - limit) {
        exchange(bad, 1);
        return 0;
    }
    return sum;
}
fn pv_tok<a>(c: (&a mut C), i: u64) -> u8[] {
    if i >= c.toks.len() {
        return u8[];
    }
    return tok_text(&mut c, i);
}
// A decimal the prover compares exactly: digits only, and short enough that its value is exact. A
// longer literal is left unread rather than modelled at the wrong value.
fn pv_digits<a>(t: &a [u8]) -> bool {
    if (t.len() == 0) || (15 < t.len()) {
        return false;
    }
    for i in t.len() {
        if (t[i] < 48) || (57 < t[i]) {
            return false;
        }
    }
    return true;
}
fn pv_number<a>(t: &a [u8]) -> i64 {
    mut v: i64 = 0;
    for i in t.len() {
        v = v * 10 + i64(t[i] - 48);
    }
    return v;
}
// A literal the prover may name as a value: an integer, or a float spelled with digits and one dot. A
// float literal is opaque - it is never ordered against another term - but a value can be `finite`.
fn pv_literal<a>(t: &a [u8]) -> bool {
    if pv_digits(view(t)) {
        return true;
    }
    if (t.len() == 0) || (15 < t.len()) {
        return false;
    }
    mut dot = 0;
    mut digits = 0;
    for i in t.len() {
        b := t[i];
        if b == 46 {
            dot += 1;
        } else {
            if (b < 48) || (57 < b) {
                return false;
            }
            digits += 1;
        }
    }
    return (dot == 1) & (digits != 0);
}
// A word the prover must not mistake for a variable.
fn pv_keyword<a>(t: &a [u8]) -> bool {
    // Every word below is two to eight bytes long.
    if (t.len() < 2) || (8 < t.len()) {
        return false;
    }
    return same(view(t), view("true"))
        || same(view(t), view("false"))
        || same(view(t), view("if"))
        || same(view(t), view("else"))
        || same(view(t), view("while"))
        || same(view(t), view("for"))
        || same(view(t), view("in"))
        || same(view(t), view("let"))
        || same(view(t), view("mut"))
        || same(view(t), view("return"))
        || same(view(t), view("assert"))
        || same(view(t), view("break"))
        || same(view(t), view("continue"))
        || same(view(t), view("loop"))
        || same(view(t), view("match"))
        || same(view(t), view("where"))
        || same(view(t), view("ensures"))
        || same(view(t), view("fn"));
}
// The term at `at`, with the number of tokens it spans in `used`: a name, `name.len()` or a literal.
// Empty text means the tokens there are not one this prover knows.
fn pv_term<a>(c: (&a mut C), at: u64, used: (&a mut u64)) -> u8[] {
    exchange(used, 1);
    if at >= c.toks.len() {
        return u8[];
    }
    k := kind_at(&mut c, at);
    if (k == 2) || (k == 5) {
        t := tok_text(&mut c, at);
        if pv_literal(view(t)) {
            return t;
        }
        return u8[];
    }
    if k != 1 {
        return u8[];
    }
    t := tok_text(&mut c, at);
    if pv_keyword(view(t)) {
        return u8[];
    }
    // `NAME.len()` is the length of the thing NAME names.
    if (kind_at(&mut c, at + 1) == 46) & (kind_at(&mut c, at + 2) == 1) & (kind_at(&mut c, at + 3) == 40) & (kind_at(&mut c, at + 4) == 41) {
        if is_at(&mut c, at + 2, view("len")) {
            // A static string's or table's length is a known number (module-values stage 5).
            known := pv_known_literal(&mut c, view(t), true);
            exchange(used, 5);
            if known.len() != 0 {
                return known;
            }
            mut out = t.copy();
            push_bytes(&mut out, view(".len"));
            return out;
        }
    }
    // `ROOT.FIELD` and `ROOT.FIELD.len()`, when nothing in this body can write the field: the term
    // is the path, and it means one value for as long as the binding lives (pv_field_stable).
    if (c.pv_pred_mode == 0) & (kind_at(&mut c, at + 1) == 46) & (kind_at(&mut c, at + 2) == 1) & (kind_at(&mut c, at + 3) != 40) {
        f := tok_text(&mut c, at + 2);
        if pv_field_stable(&mut c, view(t), view(f)) {
            mut out = t.copy();
            out.push(46);
            push_bytes(&mut out, view(f));
            exchange(used, 3);
            if (kind_at(&mut c, at + 3) == 46) & (kind_at(&mut c, at + 4) == 1) & (kind_at(&mut c, at + 5) == 40) & (kind_at(&mut c, at + 6) == 41) {
                if is_at(&mut c, at + 4, view("len")) {
                    push_bytes(&mut out, view(".len"));
                    exchange(used, 7);
                }
            }
            return out;
        }
    }
    // An integer static or constant is its value: a literal vertex, not a name.
    if (kind_at(&mut c, at + 1) != 40) && (kind_at(&mut c, at + 1) != 46) && (kind_at(&mut c, at + 1) != 260) {
        known := pv_known_literal(&mut c, view(t), false);
        if known.len() != 0 {
            return known;
        }
    }
    return t;
}
// Whether `root.field` names one value for the whole life of the binding `root`: the binding is not
// `mut`, it is a record or a shared reference to one (a `&mut` could be written through), and the
// field is itself a plain value or an owned vector - not a reference, through which someone else's
// write could arrive. A path that passes this needs no kill rule: nothing in the body can change it,
// and binding the root's name again hides it like any other fact about that name.
fn pv_field_stable<a, b, d>(c: (&a mut C), root: &b [u8], field: &d [u8]) -> bool {
    l := find_local(&mut c, root);
    if l == 0 {
        return false;
    }
    if c.locals[l - 1].mutable != 0 {
        return false;
    }
    lty := local_ty(&mut c, l - 1);
    if (ty_kind(&mut c, lty) == 7) && (ty_mode(&mut c, lty) != 0) {
        return false;
    }
    mut rty = lty;
    if ty_kind(&mut c, rty) == 7 {
        rty = ty_arg(&mut c, rty);
    }
    rty = base_type(&mut c, rty);
    if ty_kind(&mut c, rty) != 8 {
        return false;
    }
    d := ty_arg(&mut c, rty);
    if c.decls[d].is_enum != 0 {
        return false;
    }
    idx := field_index(&mut c, d, field);
    if idx == 0 {
        return false;
    }
    fty := field_type(&mut c, rty, idx - 1);
    fk := ty_kind(&mut c, fty);
    // An integer of any width, or an owned vector (whose length is the term).
    return (fty == 0) || (fk == 18) || (fty == 2) || (fk == 6);
}
// The predicate of `root.field` when the path is one value for the binding's life (pv_field_stable):
// every write of a refined field checks its predicate (a literal, `r.f = v`, `r.f op= v`) and no
// `&mut` to one exists, so a record the program holds satisfies it. `no_pred()` otherwise.
fn pv_field_pred<a, b, d>(c: (&a mut C), root: &b [u8], field: &d [u8]) -> Pred {
    if !pv_field_stable(&mut c, view(root), view(field)) {
        return no_pred();
    }
    l := find_local(&mut c, root);
    mut rty = local_ty(&mut c, l - 1);
    if ty_kind(&mut c, rty) == 7 {
        rty = ty_arg(&mut c, rty);
    }
    rty = base_type(&mut c, rty);
    d := ty_arg(&mut c, rty);
    idx := field_index(&mut c, d, view(field));
    if idx == 0 {
        return no_pred();
    }
    f := c.decls[d].first + idx - 1;
    if f >= c.fields.len() {
        return no_pred();
    }
    return Pred { file: c.fields[f].pred.file, lo: c.fields[f].pred.lo, hi: c.fields[f].pred.hi };
}
// What reading a refined field gives: for a term `root.field` or `root.field.len` the obligation
// names, the field's predicate with the field renamed to the path, settled with the facts and added
// to them. Only the roots pv_field_stable trusts qualify; a `mut` or `&mut` root gets nothing.
fn pv_field_facts<a, b>(c: (&a mut C), term: &b [u8], facts: (&a mut Atom[])) -> unit {
    mut root = u8[];
    mut field = u8[];
    mut dots = 0;
    for i in term.len() {
        ch := term[i];
        if (ch == 43) || (ch == 45) {
            return ();
        }
        if ch == 46 {
            dots += 1;
        } else {
            if dots == 0 {
                root.push(ch);
            }
            if dots == 1 {
                field.push(ch);
            }
        }
    }
    if (dots == 0) || (field.len() == 0) {
        return ();
    }
    // The record `root` holds, when the path is one the field-path rule trusts.
    if pv_field_pred(&mut c, view(root), view(field)).hi == 0 {
        // The field has no predicate of its own; another field's may still read it.
        if !pv_field_stable(&mut c, view(root), view(field)) {
            return ();
        }
    }
    l := find_local(&mut c, view(root));
    if l == 0 {
        return ();
    }
    d := slot_record_decl(&mut c, local_ty(&mut c, l - 1));
    if d == 18446744073709551615 {
        return ();
    }
    k0 := field_index(&mut c, d, view(field));
    if k0 == 0 {
        return ();
    }
    // Every predicate of the record that reads this field, with each field it reads renamed to its
    // path under `root` - and only when every one of those paths is one value too.
    mut renamed = Atom[];
    for j in c.decls[d].count {
        if !ref_pred_reads(&mut c, d, j, k0 - 1) {
            continue;
        }
        fs := ref_pred_fields(&mut c, d, j);
        mut names = u8[][];
        mut paths = u8[][];
        mut stable = 1;
        for q in fs.len() {
            m := fs[q];
            mname := c.fields[c.decls[d].first + m].name.copy();
            if !pv_field_stable(&mut c, view(root), view(mname)) {
                stable = 0;
            }
            mut path = root.copy();
            path.push(46);
            push_bytes(&mut path, view(mname));
            names.push(mname);
            paths.push(path);
        }
        if stable == 0 {
            continue;
        }
        f := c.decls[d].first + j;
        pred := Pred { file: c.fields[f].pred.file, lo: c.fields[f].pred.lo, hi: c.fields[f].pred.hi };
        mut atoms = Atom[];
        if !pv_read_pred(&mut c, pred, &mut atoms) {
            continue;
        }
        mut ok = 1;
        mut these = Atom[];
        for i in atoms.len() {
            x := &atoms[i];
            a := pv_rename(view(x.a), &names, &paths);
            mut b = u8[];
            if x.b.len() != 0 {
                b = pv_rename(view(x.b), &names, &paths);
                if b.len() == 0 {
                    ok = 0;
                }
            }
            if a.len() == 0 {
                ok = 0;
            }
            these.push(Atom { rel: x.rel, a: a, b: b, k: x.k, ao: x.ao, bo: x.bo });
        }
        if ok != 0 {
            for i in these.len() {
                renamed.push(copy_atom_value(&these[i]));
            }
        }
    }
    mut settled = Atom[];
    if pv_settle_all(&mut c, &renamed, &mut facts, &mut settled) {
        for j in settled.len() {
            pv_add(&mut facts, settled[j].rel, view(settled[j].a), view(settled[j].b), settled[j].k);
        }
    }
    return ();
}
// The atom at `at`, or false when the tokens there are not one this prover models. `>` is turned into
// its `<` form with the operands swapped, so one shape covers every comparison.
fn pv_atom<a>(c: (&a mut C), at: u64, atom: (&a mut Atom), used: (&a mut u64)) -> bool {
    exchange(used, 0);
    mut u1 = 0;
    mut t1 = pv_term(&mut c, at, &mut u1);
    if t1.len() == 0 {
        return false;
    }
    mut i = at + u1;
    // `x.is_finite()` / `x.is_nan()`
    if (kind_at(&mut c, i) == 46) & (kind_at(&mut c, i + 2) == 40) & (kind_at(&mut c, i + 3) == 41) {
        m := pv_tok(&mut c, i + 1);
        mut rel = 4;
        if same(view(m), view("is_nan")) {
            rel = 5;
        }
        if same(view(m), view("is_finite")) || same(view(m), view("is_nan")) {
            exchange(atom, Atom { rel: rel, a: t1, b: u8[], k: 0, ao: 0, bo: 0 });
            exchange(used, (i + 4) - at);
            return true;
        }
        return false;
    }
    // `a % k == 0`
    if kind_at(&mut c, i) == 37 {
        mut u2 = 0;
        mut t2 = pv_term(&mut c, i + 1, &mut u2);
        if !pv_digits(view(t2)) {
            return false;
        }
        mut j = i + 1 + u2;
        if kind_at(&mut c, j) != 258 {
            return false;
        }
        mut u3 = 0;
        mut t3 = pv_term(&mut c, j + 1, &mut u3);
        if !same(view(t3), view("0")) {
            return false;
        }
        exchange(atom, Atom { rel: 3, a: t1, b: u8[], k: pv_number(view(t2)), ao: 0, bo: 0 });
        exchange(used, (j + 1 + u3) - at);
        return true;
    }
    // A constant added to the left side. It stays beside its term: whether `x + 1 < y` may be read as
    // `x < y - 1` depends on whether `x + 1` can wrap, and that is settled where the facts are
    // (pv_settle), not here.
    mut left_k: i64 = 0;
    if (kind_at(&mut c, i) == 43) || (kind_at(&mut c, i) == 45) {
        lsign := kind_at(&mut c, i);
        mut ul = 0;
        tl := pv_term(&mut c, i + 1, &mut ul);
        if !pv_digits(view(tl)) {
            return false;
        }
        left_k = pv_number(view(tl));
        if lsign == 45 {
            left_k = 0 - left_k;
        }
        i = i + 1 + ul;
    }
    // A comparison. `>` swaps its operands, so `<`, `<=`, `==` and their mirrors share one shape.
    op := kind_at(&mut c, i);
    mut rel = 99;
    mut flip = 0;
    if op == 60 {
        rel = 0;
    }
    if op == 269 {
        rel = 1;
    }
    if op == 258 {
        rel = 2;
    }
    if op == 62 {
        rel = 0;
        flip = 1;
    }
    if op == 270 {
        rel = 1;
        flip = 1;
    }
    if rel == 99 {
        return false;
    }
    mut u2 = 0;
    mut t2 = pv_term(&mut c, i + 1, &mut u2);
    if t2.len() == 0 {
        return false;
    }
    mut j = i + 1 + u2;
    mut kk: i64 = 0;
    if (kind_at(&mut c, j) == 43) || (kind_at(&mut c, j) == 45) {
        sign := kind_at(&mut c, j);
        mut u3 = 0;
        mut t3 = pv_term(&mut c, j + 1, &mut u3);
        if !pv_digits(view(t3)) {
            return false;
        }
        kk = pv_number(view(t3));
        if sign == 45 {
            kk = 0 - kk;
        }
        j = j + 1 + u3;
    }
    // Two literals are folded here, where no fact is needed: `16 - 1` is `15`. A difference below
    // zero is a wrapped value this prover does not spell, so the atom is not read.
    if (left_k != 0) & pv_literal(view(t1)) {
        t1 = pv_fold(view(t1), left_k);
        left_k = 0;
    }
    if (kk != 0) & pv_literal(view(t2)) {
        t2 = pv_fold(view(t2), kk);
        kk = 0;
    }
    if (t1.len() == 0) || (t2.len() == 0) {
        return false;
    }
    if flip != 0 {
        // `x > y` is `y < x`, each side keeping its own constant.
        exchange(atom, Atom { rel: rel, a: t2, b: t1, k: 0, ao: kk, bo: left_k });
    } else {
        exchange(atom, Atom { rel: rel, a: t1, b: t2, k: 0, ao: left_k, bo: kk });
    }
    exchange(used, j - at);
    return true;
}
// ---- arithmetic that may wrap (docs/design/refinements.md, "Arithmetic in a predicate") -----------
// An atom is a statement over the integers about the values of its terms. A source side `t + c`
// denotes the wrapped value `(t + c) mod 2^64`, which is the integer `t + c` only when the addition
// cannot wrap. So a side with a constant is read in one of two ways, and the build's overflow mode
// is no part of the choice: where the facts prove the no-wrap condition the constant moves into the
// atom's `k`; where they do not, the whole expression is one opaque term (`i+1`, `v.len-1`) whose
// value is whatever the expression evaluates to, wrapped or not.
//
// A literal with a constant folded in: the digits of the sum, or empty when the literal is not an
// integer or the result is below zero.
fn pv_fold<a>(t: &a [u8], o: i64) -> u8[] {
    if !pv_digits(view(t)) {
        return u8[];
    }
    mut bad = 0;
    v := pv_k_sum(pv_number(view(t)), o, &mut bad);
    if (bad != 0) || (v < 0) {
        return u8[];
    }
    mut out = u8[];
    decimal(&mut out, u64(v));
    return out;
}
// Where an opaque term's constant starts: the index of its `+` or `-`, or 0 when the term has none.
// A name, a path and a literal contain neither sign.
fn pv_opaque_at<a>(t: &a [u8]) -> u64 {
    for i in t.len() {
        if (t[i] == 43) || (t[i] == 45) {
            return i;
        }
    }
    return 0;
}
// The canonical spelling of `t + o`: the base term, the sign, the digits, no spaces.
fn pv_opaque<a>(t: &a [u8], o: i64) -> u8[] {
    mut out = copy_bytes(view(t));
    if o < 0 {
        out.push(45);
        decimal(&mut out, u64(0 - o));
    } else {
        out.push(43);
        decimal(&mut out, u64(o));
    }
    return out;
}
// Whether a term is a `u64` in this body: an integer literal, a length, a `u64` local or parameter,
// a `u64` field of a record local, or an opaque term over one of those. The no-wrap conditions are
// stated for `u64`; a sized or signed term wraps at another boundary and is never normalised.
fn pv_u64_term<a, b>(c: (&a mut C), t: &b [u8]) -> bool {
    if pv_digits(view(t)) {
        return true;
    }
    mut n = pv_opaque_at(view(t));
    if n == 0 {
        n = t.len();
    }
    if (4 < n) && (t[n - 4] == 46) && (t[n - 3] == 108) && (t[n - 2] == 101) && (t[n - 1] == 110) {
        return true;
    }
    mut root = u8[];
    mut field = u8[];
    mut dotted = 0;
    for i in n {
        if (t[i] == 46) & (dotted == 0) {
            dotted = 1;
        } else {
            if dotted == 0 {
                root.push(t[i]);
            } else {
                field.push(t[i]);
            }
        }
    }
    l := find_local(&mut c, view(root));
    if l == 0 {
        return false;
    }
    mut ty = local_ty(&mut c, l - 1);
    if dotted == 0 {
        return ty == 0;
    }
    if ty_kind(&mut c, ty) == 7 {
        ty = ty_arg(&mut c, ty);
    }
    ty = base_type(&mut c, ty);
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    d := ty_arg(&mut c, ty);
    idx := field_index(&mut c, d, view(field));
    if idx == 0 {
        return false;
    }
    return field_type(&mut c, ty, idx - 1) == 0;
}
// The no-wrap condition of `t + o`, from the facts. For `o > 0` it is `NW+`: some `u64` term `y` in
// the facts has `t <= y - o`, and every `u64` is at most `2^64 - 1`, so `t + o` is too; or `t` is at
// most a literal the facts name. For `o < 0` it is `NW-`: the facts give the literal bound
// `-o <= t`.
fn pv_nw<a, b>(c: (&a mut C), facts: (&a Atom[]), t: &b [u8], o: i64) -> bool {
    if o == 0 {
        return true;
    }
    if !pv_u64_term(&mut c, view(t)) {
        return false;
    }
    if o < 0 {
        mut low = u8[];
        decimal(&mut low, u64(0 - o));
        return pv_implies(&facts, 1, view(low), view(t), 0);
    }
    for i in facts.len() {
        if 2 < facts[i].rel {
            continue;
        }
        for side in 2 {
            mut y = facts[i].a.copy();
            if side == 1 {
                y = facts[i].b.copy();
            }
            if (y.len() == 0) || same(view(y), view(t)) {
                continue;
            }
            if !pv_u64_term(&mut c, view(y)) {
                continue;
            }
            // A literal bound needs no room below it: the prover's literals and constants have at
            // most fifteen digits (pv_digits), so `t <= L` already puts `t + o` far below `2^64`.
            mut room = 0 - o;
            if pv_digits(view(y)) {
                room = 0;
            }
            if pv_implies(&facts, 1, view(t), view(y), room) {
                return true;
            }
        }
    }
    return false;
}
// One side `t + o` as a term and an integer offset (`k`): the term with its constant where the
// no-wrap condition follows from the facts, the opaque term with none where it does not. Empty when
// the side cannot be spelled: a constant on a term that is already opaque, or on a float literal.
fn pv_side<a, b, d>(c: (&a mut C), facts: (&a Atom[]), t: &b [u8], o: i64, k: (&d mut i64)) -> u8[] {
    exchange(k, 0);
    if o == 0 {
        return copy_bytes(view(t));
    }
    if pv_literal(view(t)) {
        return pv_fold(view(t), o);
    }
    if pv_nw(&mut c, &facts, view(t), o) {
        exchange(k, o);
        return copy_bytes(view(t));
    }
    if pv_opaque_at(view(t)) != 0 {
        return u8[];
    }
    return pv_opaque(view(t), o);
}
// An atom as it was read, turned into a fact with the facts in scope: each side through pv_side.
fn pv_settle<a, b>(c: (&a mut C), facts: (&a Atom[]), raw: (&b Atom), out: (&a mut Atom[])) -> bool {
    if (2 < raw.rel) || ((raw.ao == 0) & (raw.bo == 0)) {
        out.push(Atom { rel: raw.rel, a: raw.a.copy(), b: raw.b.copy(), k: raw.k, ao: 0, bo: 0 });
        return true;
    }
    mut ka: i64 = 0;
    mut kb: i64 = 0;
    x := pv_side(&mut c, &facts, view(raw.a), raw.ao, &mut ka);
    y := pv_side(&mut c, &facts, view(raw.b), raw.bo, &mut kb);
    if (x.len() == 0) || (y.len() == 0) {
        return false;
    }
    // `x + ka REL y + kb` is `x REL y + (kb - ka)`.
    mut bad = 0;
    k := pv_k_sum(pv_k_sum(raw.k, kb, &mut bad), 0 - ka, &mut bad);
    if bad != 0 {
        return false;
    }
    out.push(Atom { rel: raw.rel, a: x, b: y, k: k, ao: 0, bo: 0 });
    return true;
}
// A conjunction settled left to right into `facts`: every atom of it holds where it is stated, so an
// earlier one (`0 < i`) may be what shows a later one's subtraction cannot wrap (`i - 1 < n`). False
// when a side cannot be spelled, and then nothing was added.
fn pv_settle_all<a>(c: (&a mut C), raws: (&a Atom[]), facts: (&a mut Atom[]), out: (&a mut Atom[])) -> bool {
    mut work = Atom[];
    copy_atoms(&facts, &mut work);
    mut got = Atom[];
    for i in raws.len() {
        mut one = Atom[];
        if !pv_settle(&mut c, &work, &raws[i], &mut one) {
            return false;
        }
        for j in one.len() {
            got.push(copy_atom_value(&one[j]));
            if work.len() < 64 {
                work.push(copy_atom_value(&one[j]));
            }
        }
    }
    for i in got.len() {
        out.push(copy_atom_value(&got[i]));
    }
    return true;
}
// One side of an obligation, on the caller's terms. The parameter stands for the argument `x + o`
// (`o` is not zero only where the argument's own no-wrap condition was proved - pv_side did that),
// and the predicate adds `pa` to it. The sum is the integer `x + o + pa` when each step is known not
// to wrap: the argument's, and then the combined constant's (nothing to show when it is zero).
fn pv_oblige_side<a, b, d>(c: (&a mut C), facts: (&a Atom[]), x: &b [u8], o: i64, pa: i64, k: (&d mut i64)) -> u8[] {
    exchange(k, 0);
    mut bad = 0;
    total := pv_k_sum(o, pa, &mut bad);
    if bad != 0 {
        return u8[];
    }
    if total == 0 {
        return copy_bytes(view(x));
    }
    if o == 0 {
        return pv_side(&mut c, &facts, view(x), pa, &mut k);
    }
    if pv_nw(&mut c, &facts, view(x), total) {
        exchange(k, total);
        return copy_bytes(view(x));
    }
    return u8[];
}
// The atoms a predicate or a condition states, a conjunction only: a `||`, a `!` or an atom the
// prover cannot read means "nothing proved", which is the safe answer.
fn pv_atoms<a>(c: (&a mut C), lo: u64, hi: u64, out: (&a mut Atom[])) -> bool {
    mut i = lo;
    mut count = 0;
    while i < hi {
        k := kind_at(&mut c, i);
        if k == 273 {
            i += 1;
            continue;
        }
        if (k == 274) || (k == 33) || (k == 124) {
            return false;
        }
        if (k == 40) || (k == 41) {
            i += 1;
            continue;
        }
        mut atom = Atom { rel: 0, a: u8[], b: u8[], k: 0, ao: 0, bo: 0 };
        mut used = 0;
        if !pv_atom(&mut c, i, &mut atom, &mut used) {
            return false;
        }
        if used == 0 {
            return false;
        }
        if 16 <= out.len() {
            return false;
        }
        out.push(atom);
        count += 1;
        i += used;
    }
    return count != 0;
}
// Read a predicate's atoms where it is written. A predicate carried by an interface is its own
// virtual source, so the file is switched for the read and switched back.
fn pv_read_pred<a>(c: (&a mut C), pred: Pred, out: (&a mut Atom[])) -> bool {
    mut pf = pred.file;
    mut plo = pred.lo;
    mut phi = pred.hi;
    if (phi == 0) || (pf == 0) {
        return false;
    }
    saved_file := c.file;
    saved_pos := c.pos;
    if saved_file != pf {
        load_file(&mut c, pf);
        exchange(&mut c.file, pf);
    }
    // A predicate is written over its own function's names, not this body's: a field path in it
    // would be looked up among the wrong locals, so none is read while it is.
    exchange(&mut c.pv_pred_mode, 1);
    ok := pv_atoms(&mut c, plo, phi, &mut out);
    exchange(&mut c.pv_pred_mode, 0);
    if saved_file != pf {
        load_file(&mut c, saved_file);
        exchange(&mut c.file, saved_file);
        exchange(&mut c.pos, saved_pos);
    }
    return ok;
}
fn pv_add<a>(facts: (&a mut Atom[]), rel: u64, a: &a [u8], b: &a [u8], k: i64) -> unit {
    if 64 <= facts.len() {
        return ();
    }
    facts.push(Atom { rel: rel, a: copy_bytes(view(a)), b: copy_bytes(view(b)), k: k, ao: 0, bo: 0 });
    return ();
}
// Whether a term is `name` or something reached through it: `name.len`, `name.field`,
// `name.field.len`, and an opaque term over any of those (`name+1`, `name.len-1`), whose value
// changes when its base does.
fn pv_mentions<a, b>(term: &a [u8], name: &b [u8]) -> bool {
    if term.len() < name.len() {
        return false;
    }
    for i in name.len() {
        if term[i] != name[i] {
            return false;
        }
    }
    if term.len() == name.len() {
        return true;
    }
    next := term[name.len()];
    return (next == 46) || (next == 43) || (next == 45);
}
// Drop every fact that mentions a name, its length or a field of it: a binding of the name shadows
// what the facts said, and a write through it makes them false.
fn pv_kill<a>(facts: (&a mut Atom[]), name: &a [u8]) -> unit {
    // Most writes kill nothing: then the list stays as it is instead of being copied whole.
    mut any = false;
    for i in facts.len() {
        x := &facts[i];
        if pv_mentions(view(x.a), view(name)) || pv_mentions(view(x.b), view(name)) {
            any = true;
            break;
        }
    }
    if !any {
        return ();
    }
    mut keep = Atom[];
    for i in facts.len() {
        x := &facts[i];
        hit := pv_mentions(view(x.a), view(name)) || pv_mentions(view(x.b), view(name));
        if !hit {
            keep.push(copy_atom_value(&x));
        }
    }
    exchange(facts, keep);
    return ();
}
// What an `else` may assume from the condition that failed: only a single comparison has a negation
// that is itself one comparison, and anything else states nothing.
fn pv_negation<a>(atoms: (&a Atom[]), out: (&a mut Atom[])) -> unit {
    if atoms.len() != 1 {
        return ();
    }
    x := &atoms[0];
    rel := x.rel;
    a := x.a.copy();
    b := x.b.copy();
    k := x.k;
    if rel == 0 {
        // `!(a < b + k)` is `b <= a - k - 1`.
        mut bad = 0;
        nk := pv_k_sum(0 - k, i64(0) - i64(1), &mut bad);
        if bad == 0 {
            pv_add(&mut out, 1, view(b), view(a), nk);
        }
        return ();
    }
    if rel == 1 {
        // `!(a <= b + k)` is `b < a - k`.
        pv_add(&mut out, 0, view(b), view(a), 0 - k);
        return ();
    }
    return ();
}
// An index into the difference graph's term table, adding the term when it is new. `999` means the
// table is full, and then nothing that would need it is proved.
fn pv_term_index<a>(terms: (&a mut u8[][]), t: &a [u8]) -> u64 {
    for i in terms.len() {
        if same(view(terms[i]), view(t)) {
            return i;
        }
    }
    if 20 <= terms.len() {
        return 999;
    }
    terms.push(copy_bytes(view(t)));
    return terms.len() - 1;
}
// The literal a term stands for, when the facts say it equals one: `x := 16` answers `16 % 16`.
fn pv_resolve<a>(facts: (&a Atom[]), t: &a [u8]) -> u8[] {
    mut cur = copy_bytes(view(t));
    mut step = 0;
    while step < 4 {
        mut found = u8[];
        for i in facts.len() {
            if (facts[i].rel == 2) & (facts[i].k == 0) {
                if same(view(facts[i].a), view(cur)) & pv_literal(view(facts[i].b)) {
                    found = facts[i].b.copy();
                }
                if same(view(facts[i].b), view(cur)) & pv_literal(view(facts[i].a)) {
                    found = facts[i].a.copy();
                }
            }
        }
        if found.len() == 0 {
            return cur;
        }
        exchange(&mut cur, found);
        step += 1;
    }
    return cur;
}
// Whether `a REL b + k` follows from the facts: `%` divisibility, a float class, or the difference
// graph closed over the comparisons. Atoms are statements over the integers, with any `k`: a
// constant reached `k` only where its addition was shown not to wrap (pv_settle, pv_oblige_side).
fn pv_implies<a>(facts: (&a Atom[]), rel: u64, a: &a [u8], b: &a [u8], k: i64) -> bool {
    if rel == 4 {
        for i in facts.len() {
            if (facts[i].rel == 4) & same(view(facts[i].a), view(a)) {
                return true;
            }
        }
        // A literal with no `nan` or `inf` in its spelling is finite.
        return pv_literal(view(a));
    }
    if rel == 5 {
        for i in facts.len() {
            if (facts[i].rel == 5) & same(view(facts[i].a), view(a)) {
                return true;
            }
        }
        return false;
    }
    if rel == 3 {
        if (0 < k) & pv_digits(view(a)) & (pv_number(view(a)) % k == 0) {
            return true;
        }
        for i in facts.len() {
            if (facts[i].rel == 3) & same(view(facts[i].a), view(a)) {
                m := facts[i].k;
                if (0 < k) & (0 < m) & (m % k == 0) {
                    return true;
                }
            }
        }
        return false;
    }
    // An offset outside the range sums are exact in proves nothing (pv_k_sum).
    if (k > pv_k_limit()) || (k < 0 - pv_k_limit()) {
        return false;
    }
    // The difference graph: `d[j * n + i]` is the smallest `i - j` the facts allow, closed by
    // Floyd-Warshall over the terms the facts and the obligation mention. A literal is an exact
    // vertex, so `16` and `20` order each other.
    mut terms = u8[][];
    ai := pv_term_index(&mut terms, view(a));
    if ai == 999 {
        return false;
    }
    mut bi = 999;
    if b.len() != 0 {
        bi = pv_term_index(&mut terms, view(b));
        if bi == 999 {
            return false;
        }
    }
    for i in facts.len() {
        r := facts[i].rel;
        if (r == 4) || (r == 5) || (r == 3) {
            continue;
        }
        if (facts[i].a.len() == 0) || (facts[i].b.len() == 0) {
            continue;
        }
        xi := pv_term_index(&mut terms, view(facts[i].a));
        if xi == 999 {
            return false;
        }
        yi := pv_term_index(&mut terms, view(facts[i].b));
        if yi == 999 {
            return false;
        }
    }
    n := terms.len();
    mut d = i64[];
    for i in n * n {
        d.push(pv_inf());
    }
    for i in n {
        d[i * n + i] = 0;
    }
    // Literals are exact vertices: their difference is known without any fact.
    for i in n {
        for j in n {
            if pv_digits(view(terms[i])) & pv_digits(view(terms[j])) {
                d[j * n + i] = pv_number(view(terms[i])) - pv_number(view(terms[j]));
            }
        }
    }
    for i in facts.len() {
        r := facts[i].rel;
        if (r == 4) || (r == 5) || (r == 3) {
            continue;
        }
        if (facts[i].a.len() == 0) || (facts[i].b.len() == 0) {
            continue;
        }
        xi := pv_term_index(&mut terms, view(facts[i].a));
        yi := pv_term_index(&mut terms, view(facts[i].b));
        if (xi == 999) || (yi == 999) {
            return false;
        }
        mut w = facts[i].k;
        mut bad = 0;
        if r == 0 {
            // `a < b + k` is `a - b <= k - 1`.
            w = pv_k_sum(w, i64(0) - i64(1), &mut bad);
        } else {
            w = pv_k_sum(w, 0, &mut bad);
        }
        if bad != 0 {
            // A fact whose offset cannot be summed exactly is left out: fewer edges, fewer proofs.
            continue;
        }
        if w < d[yi * n + xi] {
            d[yi * n + xi] = w;
        }
        if r == 2 {
            if (0 - w) < d[xi * n + yi] {
                d[xi * n + yi] = 0 - w;
            }
        }
    }
    mut mid = 0;
    while mid < n {
        for u0 in n {
            A := d[u0 * n + mid];
            if A != pv_inf() {
                for w0 in n {
                    B := d[mid * n + w0];
                    if B != pv_inf() {
                        // A path whose length cannot be summed exactly is not a path.
                        mut bad = 0;
                        through := pv_k_sum(A, B, &mut bad);
                        if (bad == 0) && (through < d[u0 * n + w0]) {
                            d[u0 * n + w0] = through;
                        }
                    }
                }
            }
        }
        mid += 1;
    }
    if b.len() == 0 {
        // A comparison against the zero the atom leaves out: `a < 0` is `a - 0 <= -1`.
        if rel == 0 {
            return d[ai * n + ai] <= i64(0) - i64(1);
        }
        return false;
    }
    mut want: i64 = k;
    if rel == 0 {
        want = k - 1;
    }
    if !(d[bi * n + ai] <= want) {
        return false;
    }
    if rel == 2 {
        return d[ai * n + bi] <= 0 - k;
    }
    return true;
}
// Whether an obligation's atom follows from the facts, with a side the facts equate with a literal
// read as that literal.
fn pv_holds<a>(facts: (&a Atom[]), rel: u64, a: &a [u8], b: &a [u8], k: i64) -> bool {
    if (rel == 3) || (rel == 4) {
        r := pv_resolve(&facts, view(a));
        return pv_implies(&facts, rel, view(r), view(b), k);
    }
    return pv_implies(&facts, rel, view(a), view(b), k);
}
// The offset the argument bound to parameter `t` carries; a `t.len` or a name that is no parameter
// carries none.
fn pv_rename_off<a, b>(t: &a [u8], from: (&b u8[][]), offs: (&b i64[])) -> i64 {
    for i in from.len() {
        if same(view(from[i]), view(t)) {
            return offs[i];
        }
    }
    return 0;
}
// `name` (or `name.len`) with the callee's parameters renamed to the caller's terms. A length of a
// literal cannot be renamed, and says so with empty text.
fn pv_rename<a, b>(t: &a [u8], from: (&b u8[][]), to: (&b u8[][])) -> u8[] {
    if t.len() == 0 {
        return u8[];
    }
    for i in from.len() {
        if same(view(from[i]), view(t)) {
            return copy_bytes(view(to[i]));
        }
        mut len_form = from[i].copy();
        push_bytes(&mut len_form, view(".len"));
        if same(view(len_form), view(t)) {
            if pv_literal(view(to[i])) || (pv_opaque_at(view(to[i])) != 0) {
                return u8[];
            }
            mut out = to[i].copy();
            push_bytes(&mut out, view(".len"));
            return out;
        }
    }
    return copy_bytes(view(t));
}
// pv_rename, then a renamed `NAME.len` whose NAME is a static of known length read as that length -
// the same literal pv_term gives the caller's own `NAME.len()`, so the two sides meet.
fn pv_rename_known<a, b, d>(c: (&a mut C), t: &b [u8], from: (&d u8[][]), to: (&d u8[][])) -> u8[] {
    out := pv_rename(t, &from, &to);
    if (out.len() > 4) && same(view(slice_bytes(view(out), out.len() - 4, out.len())), view(".len")) {
        base := slice_bytes(view(out), 0, out.len() - 4);
        known := pv_known_literal(&mut c, view(base), true);
        if known.len() != 0 {
            return known;
        }
    }
    return out;
}
// The single term a source span names, or empty when it is anything else - arithmetic, a call, a
// field: an argument the prover cannot name is an obligation it cannot prove. A leading `&` borrows
// the term it names, whose value is still that term's.
fn pv_span_term<a>(c: (&a mut C), lo: u64, hi: u64) -> u8[] {
    mut i = lo;
    if (i < hi) & (kind_at(&mut c, i) == 38) {
        i += 1;
        if (i < hi) & (kind_at(&mut c, i) == 1) {
            if is_at(&mut c, i, view("mut")) {
                i += 1;
            }
        }
    }
    if i >= hi {
        return u8[];
    }
    mut used = 0;
    t := pv_term(&mut c, i, &mut used);
    if t.len() == 0 {
        return u8[];
    }
    if i + used != hi {
        return u8[];
    }
    return t;
}
// An argument's term and the constant added to it: `i`, `i + 1`, `v.len() - 1`. The constant is
// arithmetic the caller does before the call and it may wrap, so the caller of this settles it with
// the facts at the call (pv_side). Empty text when the span is anything else.
fn pv_span_term_off<a, b>(c: (&a mut C), lo: u64, hi: u64, off: (&b mut i64)) -> u8[] {
    exchange(off, 0);
    whole := pv_span_term(&mut c, lo, hi);
    if whole.len() != 0 {
        return whole;
    }
    if hi < lo + 3 {
        return u8[];
    }
    sign := kind_at(&mut c, hi - 2);
    if (sign != 43) & (sign != 45) {
        return u8[];
    }
    kd := kind_at(&mut c, hi - 1);
    if (kd != 2) & (kd != 5) {
        return u8[];
    }
    digits := tok_text(&mut c, hi - 1);
    if !pv_digits(view(digits)) {
        return u8[];
    }
    base := pv_span_term(&mut c, lo, hi - 2);
    if base.len() == 0 {
        return u8[];
    }
    mut k = pv_number(view(digits));
    if sign == 45 {
        k = 0 - k;
    }
    exchange(off, k);
    return base;
}
// Whether a span could write through a name it mentions: `&mut` takes an exclusive loan, and a call
// may write what it is given. A call site with such an argument proves nothing, since another
// argument's evaluation could change what the proof read.
fn pv_span_mutates<a>(c: (&a mut C), lo: u64, hi: u64) -> bool {
    mut i = lo;
    while i < hi {
        k := kind_at(&mut c, i);
        if k == 38 {
            if kind_at(&mut c, i + 1) == 1 {
                if is_at(&mut c, i + 1, view("mut")) {
                    return true;
                }
            }
        }
        if k == 1 {
            if kind_at(&mut c, i + 1) == 40 {
                // `.len()` and the other pure tests are spelled as calls and call nothing.
                called := tok_text(&mut c, i);
                if !((i > lo) && (kind_at(&mut c, i - 1) == 46) && pv_pure_test(view(called))) {
                    return true;
                }
            }
            if (kind_at(&mut c, i + 1) == 46) & (kind_at(&mut c, i + 3) == 40) {
                // A pure test reads its receiver: `v.len()` in an argument writes nothing.
                m := tok_text(&mut c, i + 2);
                if !pv_pure_test(view(m)) {
                    return true;
                }
            }
        }
        i += 1;
    }
    return false;
}
// The facts the function being compiled assumes at its body's start: each refined parameter's
// predicate holds here, because the entry checked it or the caller proved it.
fn pv_seed_params<a>(c: (&a mut C), facts: (&a mut Atom[])) -> unit {
    for i in c.cur_ppreds.len() {
        mut pf = 0;
        mut plo = 0;
        mut phi = 0;
        if i < c.cur_ppreds.len() {
            p := &c.cur_ppreds[i];
            pf = p.file;
            plo = p.lo;
            phi = p.hi;
        }
        if phi == 0 {
            continue;
        }
        mut atoms = Atom[];
        if pv_read_pred(&mut c, Pred { file: pf, lo: plo, hi: phi }, &mut atoms) {
            // What the entry checked is the wrapped value of each side, so a constant in the
            // predicate is settled like any other: with the predicates before it as the facts.
            mut settled = Atom[];
            if pv_settle_all(&mut c, &atoms, &mut facts, &mut settled) {
                for j in settled.len() {
                    pv_add(&mut facts, settled[j].rel, view(settled[j].a), view(settled[j].b), settled[j].k);
                }
            }
        }
    }
    return ();
}
// ---- facts over the typed IR (docs/design/refinements.md, "Facts over the typed IR") --------------
// The front end has no materialised tree to walk: a body is compiled once, statement by statement,
// and the facts are kept as it goes. Each hook below sits where the parser already knows the
// structure - a block, a binding, a condition, a loop guard, an arm, a call - so what a fact means is
// a resolved local and a resolved block, not a re-scan of the tokens from the body's `{` to the
// obligation. `pv_proved` and `pv_call_proved` read the live list instead of rebuilding it, which is
// what makes an arm's pattern, a shadowing `let` and a `for` guard exact.
fn pv_ir_live<a>(c: (&a C)) -> bool {
    if c.pv_on == 0 {
        return false;
    }
    if c.body_hi == 0 {
        return false;
    }
    return true;
}
fn copy_atoms<a>(from: (&a Atom[]), to: (&a mut Atom[])) -> unit {
    for i in from.len() {
        x := &from[i];
        to.push(copy_atom_value(&x));
    }
    return ();
}
// The facts that hold at the current point of the body being compiled.
fn pv_ir_read<a>(c: (&a mut C), facts: (&a mut Atom[])) -> unit {
    copy_atoms(&c.pv_facts, &mut facts);
    return ();
}
fn pv_ir_add_all<a>(c: (&a mut C), atoms: (&a Atom[])) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    for i in atoms.len() {
        x := &atoms[i];
        pv_add(&mut c.pv_facts, x.rel, view(x.a), view(x.b), x.k);
    }
    return ();
}
// Enter a block: the atoms it adds are dropped when it closes, and so is what a binding made inside it
// did to the facts about the name it shadowed.
fn pv_ir_open<a>(c: (&a mut C)) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    c.pv_marks.push(c.pv_facts.len());
    c.pv_trmarks.push(c.pv_trail.len());
    mut pending = exchange(&mut c.pv_pending, Atom[]);
    for i in pending.len() {
        x := &pending[i];
        pv_add(&mut c.pv_facts, x.rel, view(x.a), view(x.b), x.k);
    }
    return ();
}
fn pv_ir_close<a>(c: (&a mut C)) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    if c.pv_marks.len() == 0 {
        return ();
    }
    mark := c.pv_marks.pop()!;
    trmark := c.pv_trmarks.pop()!;
    while mark < c.pv_facts.len() {
        c.pv_facts.pop()!;
    }
    if trmark < c.pv_trail.len() {
        // Only the atoms a binding made *in this block* shadowed come back here. A binding made
        // between this block's open and its own binding's scope (a loop variable, whose `bind` runs
        // before the body's block opens) is owned by the block that holds the loop, so its facts are
        // not restored by an unrelated block's close: that resurrected a fact about a name whose
        // binding had already ended.
        mut back = Atom[];
        mut keep = Atom[];
        mut owners = u64[];
        for i in c.pv_trail.len() {
            x := &c.pv_trail[i];
            mut own = 0;
            if i < c.pv_trown.len() {
                own = c.pv_trown[i];
            }
            if trmark <= i {
                if own == trmark {
                    back.push(copy_atom_value(&x));
                }
            } else {
                keep.push(copy_atom_value(&x));
                owners.push(own);
            }
        }
        if back.len() != 0 || keep.len() != c.pv_trail.len() {
            exchange(&mut c.pv_trail, keep);
            exchange(&mut c.pv_trown, owners);
        }
        for i in back.len() {
            x := &back[i];
            pv_add(&mut c.pv_facts, x.rel, view(x.a), view(x.b), x.k);
        }
    }
    return ();
}
// What a condition, a loop guard or an arm's pattern states for the block about to open.
fn pv_ir_pending<a>(c: (&a mut C), atoms: (&a Atom[])) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    mut out = Atom[];
    copy_atoms(&atoms, &mut out);
    exchange(&mut c.pv_pending, out);
    return ();
}
// A binding of `name` in the current block: the name means the new value, so what the facts said
// about the old one is about nothing - until the block closes, where the old one is the name again.
fn pv_ir_shadow<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    // The block this binding is made in: its close is the one that may bring the facts back.
    mut owner = 0;
    if c.pv_trmarks.len() != 0 {
        owner = c.pv_trmarks[c.pv_trmarks.len() - 1];
    }
    mut keep = Atom[];
    for i in c.pv_facts.len() {
        x := &c.pv_facts[i];
        hit := pv_mentions(view(x.a), view(name)) || pv_mentions(view(x.b), view(name));
        if hit {
            c.pv_trail.push(copy_atom_value(&x));
            c.pv_trown.push(owner);
        } else {
            keep.push(copy_atom_value(&x));
        }
    }
    exchange(&mut c.pv_facts, keep);
    return ();
}
// A write to `name`: what the facts said is false from here on, and stays false, because the write
// may have happened before the block that holds it closes.
fn pv_ir_wrote<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    mut facts = exchange(&mut c.pv_facts, Atom[]);
    pv_kill(&mut facts, view(name));
    exchange(&mut c.pv_facts, facts);
    return ();
}
// The pure tests a predicate may use: spelled like a method call, but they read their receiver and
// write nothing, so a span that mentions one has not called anything.
fn pv_pure_test<a, b>(t: &b [u8]) -> bool {
    return same(view(t), view("len")) || same(view(t), view("is_finite")) || same(view(t), view("is_nan"));
}
// Whether a span mentions a call or a mutable loan: what it names may be written by it.
fn pv_span_calls<a>(c: (&a mut C), lo: u64, hi: u64) -> bool {
    mut i = lo;
    while i < hi {
        k := kind_at(&mut c, i);
        if k == 38 {
            if kind_at(&mut c, i + 1) == 1 {
                if is_at(&mut c, i + 1, view("mut")) {
                    return true;
                }
            }
        }
        if k == 1 {
            if kind_at(&mut c, i + 1) == 40 {
                // `x.len()`, `x.is_finite()` and `x.is_nan()` read their receiver and write nothing;
                // the method's own name is the token the `(` follows.
                mut pure = 0;
                if 0 < i {
                    if kind_at(&mut c, i - 1) == 46 {
                        n := tok_text(&mut c, i);
                        if pv_pure_test(view(n)) {
                            pure = 1;
                        }
                    }
                }
                if pure == 0 {
                    return true;
                }
            }
            if (kind_at(&mut c, i + 1) == 46) & (kind_at(&mut c, i + 3) == 40) {
                m := tok_text(&mut c, i + 2);
                if !pv_pure_test(view(m)) {
                    return true;
                }
            }
        }
        i += 1;
    }
    return false;
}
// Whether a span calls a closure: a name that resolves to a local of closure type, followed by `(`.
// A closure can only write a binding of this body if it captured it here, which is what `pv_caps`
// records, so this is the call whose writes that set answers for.
fn pv_span_calls_closure<a>(c: (&a mut C), lo: u64, hi: u64) -> bool {
    mut i = lo;
    while i < hi {
        if kind_at(&mut c, i) == 1 {
            if kind_at(&mut c, i + 1) == 40 {
                n := tok_text(&mut c, i);
                l := find_local(&mut c, view(n));
                if l != 0 {
                    if ty_kind(&mut c, local_ty(&mut c, l - 1)) == 20 {
                        return true;
                    }
                }
            }
        }
        i += 1;
    }
    return false;
}
// Record that a closure created in this body writes `name`: a call in this body may write through it.
fn pv_caps_add<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    for i in c.pv_caps.len() {
        if same(view(c.pv_caps[i]), view(name)) {
            return ();
        }
    }
    c.pv_caps.push(copy_bytes(view(name)));
    return ();
}
// Kill the facts about every name a closure of this body writes: after a call that may reach one,
// what those names meant before it is not what they mean now.
fn pv_caps_kill<a>(c: (&a mut C)) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    mut i = 0;
    while i < c.pv_caps.len() {
        n := c.pv_caps[i].copy();
        pv_ir_wrote(&mut c, view(n));
        i += 1;
    }
    return ();
}
// What a loop body's writes make false before the body is compiled. The body's own statements kill
// facts as they are compiled, but the first check site in the body runs before any of them, and on
// the second iteration a fact that held at the loop's entry no longer holds there. So every name the
// body assigns, mutably borrows or method-calls is killed here, before the body's block opens; the
// guard's own facts are added by the block that follows, and are true at every iteration.
fn pv_loop_kill<a>(c: (&a mut C), open: u64, end: u64) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    mut i = open + 1;
    while i < end {
        if kind_at(&mut c, i) == 1 {
            nk := kind_at(&mut c, i + 1);
            // `x = ...` and `x += ...` change what the name means from here on.
            mut hit = u64((nk == 61) || ((261 < nk) & (nk < 269)));
            if hit == 0 {
                // `x.m()` may write x; the pure tests read their receiver and write nothing.
                if (nk == 46) & (kind_at(&mut c, i + 3) == 40) {
                    m := tok_text(&mut c, i + 2);
                    if !pv_pure_test(view(m)) {
                        hit = 1;
                    }
                }
            }
            if (hit == 0) & (2 <= i) {
                // `&mut x` lends x out exclusively, so a call in the body may write it.
                if (kind_at(&mut c, i - 1) == 1) & (kind_at(&mut c, i - 2) == 38) {
                    if is_at(&mut c, i - 1, view("mut")) {
                        hit = 1;
                    }
                }
            }
            if hit != 0 {
                n := tok_text(&mut c, i);
                pv_ir_wrote(&mut c, view(n));
            }
        }
        i += 1;
    }
    if pv_span_calls_closure(&mut c, open, end) {
        pv_caps_kill(&mut c);
    }
    return ();
}
// The atoms a source span states, or nothing when it states none the prover reads. A span that calls
// or takes a mutable loan states nothing here: the call may write what its atoms would name.
fn pv_ir_atoms<a>(c: (&a mut C), lo: u64, hi: u64) -> Atom[] {
    mut out = Atom[];
    if lo >= hi {
        return out;
    }
    if pv_span_calls(&mut c, lo, hi) {
        return out;
    }
    mut raws = Atom[];
    if !pv_atoms(&mut c, lo, hi, &mut raws) {
        return out;
    }
    mut facts = Atom[];
    pv_ir_read(&mut c, &mut facts);
    if !pv_settle_all(&mut c, &raws, &mut facts, &mut out) {
        out = Atom[];
    }
    return out;
}
// A statement keyword whose own conditions and statements report what they do as they are compiled.
fn pv_compound<a, b>(t: &b [u8]) -> bool {
    if (t.len() < 2) || (6 < t.len()) {
        return false;
    }
    return same(view(t), view("if"))
        || same(view(t), view("match"))
        || same(view(t), view("while"))
        || same(view(t), view("loop"))
        || same(view(t), view("for"))
        || same(view(t), view("unsafe"));
}
// A statement that calls may write through the names it mentions, so what they meant before it is
// forgotten after it. A compound statement is not scanned here: its condition and its own statements
// report themselves, which is the precision the token walk could not have.
fn pv_ir_statement<a>(c: (&a mut C), lo: u64, hi: u64) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    if lo >= hi {
        return ();
    }
    k := kind_at(&mut c, lo);
    if k == 123 {
        return ();
    }
    if k == 1 {
        t := tok_text(&mut c, lo);
        if pv_compound(view(t)) {
            return ();
        }
    }
    if !pv_span_calls(&mut c, lo, hi) {
        return ();
    }
    mut i = lo;
    // A name written kills the facts that mention it; with none held there is nothing to kill.
    while (i < hi) & (c.pv_facts.len() != 0) {
        if kind_at(&mut c, i) == 1 {
            n := tok_text(&mut c, i);
            pv_ir_wrote(&mut c, view(n));
        }
        i += 1;
    }
    // A closure of this body writes its captures, not the argument it is given: the names in the
    // span do not cover those, so they are killed here (see `pv_caps`).
    if pv_span_calls_closure(&mut c, lo, hi) {
        pv_caps_kill(&mut c);
    }
    return ();
}
// `name == term` for a binding of a simple value: `n := 32` answers `n % 16 == 0`.
fn pv_ir_value<a, b>(c: (&a mut C), name: &b [u8], lo: u64, hi: u64) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    t := pv_span_term(&mut c, lo, hi);
    if t.len() == 0 {
        return ();
    }
    pv_add(&mut c.pv_facts, 2, view(name), view(t), 0);
    return ();
}
// `name == value` for an arm whose pattern is a single literal: `match n { 16 => ... }` states
// `n == 16` in that arm, and the arm's own block is what ends the fact.
fn pv_ir_literal<a, b>(c: (&a mut C), out: (&a mut Atom[]), name: &b [u8], value: u64) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    if name.len() == 0 {
        return ();
    }
    mut text = u8[];
    decimal(&mut text, value);
    pv_add(&mut out, 2, view(name), view(text), 0);
    return ();
}
// `lo <= name < hi` for a range pattern: `match n { 0..16 => ... }` states both bounds in that arm.
fn pv_ir_range<a, b>(c: (&a mut C), out: (&a mut Atom[]), name: &b [u8], lo: u64, hi: u64) -> unit {
    if !pv_ir_live(&c) {
        return ();
    }
    if name.len() == 0 {
        return ();
    }
    mut lo_text = u8[];
    decimal(&mut lo_text, lo);
    pv_add(&mut out, 1, view(lo_text), view(name), 0);
    mut hi_text = u8[];
    decimal(&mut hi_text, hi);
    pv_add(&mut out, 0, view(name), view(hi_text), 0);
    return ();
}
// Starting and finishing a body: a refined parameter holds at its entry (the entry checked it or the
// caller proved it, which is what a proved call means), and nothing of this body is left behind for
// the next one the compile emits.
fn pv_begin<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.pv_on, 0);
    exchange(&mut c.pv_facts, Atom[]);
    exchange(&mut c.pv_marks, u64[]);
    exchange(&mut c.pv_trmarks, u64[]);
    exchange(&mut c.pv_trail, Atom[]);
    exchange(&mut c.pv_pending, Atom[]);
    exchange(&mut c.pv_trown, u64[]);
    exchange(&mut c.pv_caps, u8[][]);
    if c.body_hi == 0 {
        return ();
    }
    if c.raw != 0 {
        return ();
    }
    if c.validating != 0 {
        return ();
    }
    exchange(&mut c.pv_on, 1);
    mut facts = Atom[];
    pv_seed_params(&mut c, &mut facts);
    exchange(&mut c.pv_facts, facts);
    return ();
}
fn pv_end<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.pv_on, 0);
    exchange(&mut c.pv_facts, Atom[]);
    exchange(&mut c.pv_marks, u64[]);
    exchange(&mut c.pv_trmarks, u64[]);
    exchange(&mut c.pv_trail, Atom[]);
    exchange(&mut c.pv_pending, Atom[]);
    exchange(&mut c.pv_trown, u64[]);
    exchange(&mut c.pv_caps, u8[][]);
    return ();
}
// The proof of one obligation: `pred`'s atoms, with `names` renamed to `terms`, all follow from the
// facts in scope at `pos`.
fn pv_proved<a, b>(c: (&a mut C), pred: Pred, names: (&a u8[][]), terms: (&a u8[][]), pos: u64, report: u64, need: &b [u8]) -> u64 {
    if (c.body_hi == 0) || (c.validating != 0) {
        return 0;
    }
    // The range is kept in locals: reading the predicate consumes the value.
    pf := pred.file;
    plo := pred.lo;
    phi := pred.hi;
    mut atoms = Atom[];
    if !pv_read_pred(&mut c, pred, &mut atoms) {
        return 0;
    }
    mut facts = Atom[];
    pv_ir_read(&mut c, &mut facts);
    for i in terms.len() {
        pv_field_facts(&mut c, view(terms[i]), &mut facts);
    }
    for j in atoms.len() {
        rel := atoms[j].rel;
        mut x = pv_rename_known(&mut c, view(atoms[j].a), &names, &terms);
        mut ok = x.len() != 0;
        mut y = u8[];
        if ok & (atoms[j].b.len() != 0) {
            y = pv_rename_known(&mut c, view(atoms[j].b), &names, &terms);
            ok = y.len() != 0;
        }
        // A constant in the predicate is arithmetic on the value: settled with the facts here.
        mut k = atoms[j].k;
        if ok & (rel <= 2) {
            mut ka: i64 = 0;
            mut kb: i64 = 0;
            x = pv_oblige_side(&mut c, &facts, view(x), 0, atoms[j].ao, &mut ka);
            y = pv_oblige_side(&mut c, &facts, view(y), 0, atoms[j].bo, &mut kb);
            mut bad = 0;
            k = pv_k_sum(pv_k_sum(k, kb, &mut bad), 0 - ka, &mut bad);
            ok = (x.len() != 0) & (y.len() != 0) & (bad == 0);
        }
        if ok {
            ok = pv_holds(&facts, rel, view(x), view(y), k);
        }
        if !ok {
            if report != 0 {
                // `pred` was consumed reading it; the diagnostic needs its range, not the value.
                pv_strict_fail(&mut c, Pred { file: pf, lo: plo, hi: phi }, pos, view(need));
            }
            return 0;
        }
    }
    return 1;
}
// Whether an obligation is false outright: its sides are integer literals, or names the facts equate
// with one (`n := 0`), and the comparison or the divisibility does not hold of them. Nothing else is
// judged false - an unproved obligation stays a check.
fn pv_false_literal<a, b>(facts: (&a Atom[]), rel: u64, x: &b [u8], y: &b [u8], k: i64) -> bool {
    a := pv_resolve(&facts, view(x));
    if !pv_digits(view(a)) {
        return false;
    }
    av := pv_number(view(a));
    if rel == 3 {
        return (0 < k) & (av % k != 0);
    }
    if rel > 2 {
        return false;
    }
    mut bv: i64 = 0;
    if y.len() != 0 {
        b := pv_resolve(&facts, view(y));
        if !pv_digits(view(b)) {
            return false;
        }
        bv = pv_number(view(b));
    }
    mut bad = 0;
    rhs := pv_k_sum(bv, k, &mut bad);
    if bad != 0 {
        return false;
    }
    if rel == 0 {
        return !(av < rhs);
    }
    if rel == 1 {
        return !(av <= rhs);
    }
    return av != rhs;
}
fn pv_false_fail<a, b>(c: (&a mut C), pred: Pred, pos: u64, need: &b [u8]) -> unit {
    text := pred_text(&mut c, pred);
    mut msg = copy_bytes(view("the refinement `"));
    push_bytes(&mut msg, view(text));
    push_bytes(&mut msg, view("` is false at this call: the arguments are constants that break it"));
    if need.len() != 0 {
        push_bytes(&mut msg, view("\n = "));
        push_bytes(&mut msg, view(need));
    }
    exchange(&mut c.pos, pos);
    fail(&mut c, view(msg));
    return ();
}
// A call the prover cannot discharge. Strict mode reports it here, at the call, with the predicate
// and the reason; otherwise the check stays and the call keeps the checked entry.
fn pv_call_give_up<a, b, d>(c: (&a mut C), report: u64, pred: Pred, at: u64, need: &b [u8], why: &d [u8]) -> u64 {
    if report != 0 {
        pv_strict_fail_why(&mut c, pred, at, view(need), view(why));
    }
    return 0;
}
// An addition or a subtraction the facts show cannot overflow: `hi - lo` with `lo <= hi` (which is
// also `i - 1` with `1 <= i`), and `t + c` with a literal `c` under `NW+` (pv_nw). Both operands must
// be single terms - the whole left side of the operator and the whole right side - so a chain
// (`a - b - c`) or a product proves nothing here. A proved operation has no overflow check in any
// build and is no failure of its function; `--verify-facts` emits the check anyway (`binary`).
fn pv_arith_proof<a>(c: (&a mut C), k: u64, lstart: u64, rstart: u64, rend: u64) -> unit {
    exchange(&mut c.pv_arith_ok, 0);
    if !pv_ir_live(&c) || (rstart == 0) || (rstart <= lstart) {
        return ();
    }
    left := pv_span_term(&mut c, lstart, rstart - 1);
    right := pv_span_term(&mut c, rstart, rend);
    if (left.len() == 0) || (right.len() == 0) {
        return ();
    }
    if !pv_u64_term(&mut c, view(left)) || !pv_u64_term(&mut c, view(right)) {
        return ();
    }
    mut facts = Atom[];
    pv_ir_read(&mut c, &mut facts);
    mut ok = false;
    if k == 45 {
        ok = pv_holds(&facts, 1, view(right), view(left), 0);
    } else {
        if pv_digits(view(right)) & !pv_digits(view(left)) {
            ok = pv_nw(&mut c, &facts, view(left), pv_number(view(right)));
        }
        if pv_digits(view(left)) & !pv_digits(view(right)) {
            ok = pv_nw(&mut c, &facts, view(right), pv_number(view(left)));
        }
    }
    if ok {
        exchange(&mut c.pv_arith_ok, 1);
    }
    return ();
}
// The proof of a call: every refined parameter's predicate, with its names replaced by the
// arguments' own terms, follows from the facts at the call. A function with no refined parameter
// needs no proof and is never routed to the second entry.
fn pv_call_proved<a>(c: (&a mut C), f: u64, count: u64, spans: (&a u64[]), at: u64, report: u64) -> u64 {
    if (f == 0) || (f > c.funcs.len()) || (c.body_hi == 0) {
        return 0;
    }
    mut any = 0;
    for i in c.funcs[f - 1].ppreds.len() {
        if i < c.funcs[f - 1].ppreds.len() {
            p := &c.funcs[f - 1].ppreds[i];
            if p.hi != 0 {
                any = 1;
            }
        }
    }
    if any == 0 {
        // Nothing is owed, so there is nothing to prove and nothing to report.
        return 0;
    }
    mut first = no_pred();
    for i in c.funcs[f - 1].ppreds.len() {
        if i < c.funcs[f - 1].ppreds.len() {
            p := &c.funcs[f - 1].ppreds[i];
            if (p.hi != 0) & !has_pred(&first) {
                first = Pred { file: p.file, lo: p.lo, hi: p.hi };
            }
        }
    }
    cname := c.funcs[f - 1].name.copy();
    cfile := c.funcs[f - 1].file;
    // stays: `c.funcs[f - 1]` is a borrowed element (see drop_hook_symbol).
    cpos := c.funcs[f - 1].pos;
    mut need = pv_need(&mut c, view(cname), cfile, cpos);
    mut names = u8[][];
    mut terms = u8[][];
    mut offs = i64[];
    mut facts = Atom[];
    pv_ir_read(&mut c, &mut facts);
    for i in count {
        if i >= c.funcs[f - 1].pnames.len() {
            return pv_call_give_up(&mut c, report, first, at, view(need), view("the parameter has no name to substitute"));
        }
        if (2 * i + 1) >= spans.len() {
            return pv_call_give_up(&mut c, report, first, at, view(need), view("the argument's source is unknown"));
        }
        nm := c.funcs[f - 1].pnames[i].copy();
        if nm.len() == 0 {
            return pv_call_give_up(&mut c, report, first, at, view(need), view("the parameter has no name to substitute"));
        }
        mut off: i64 = 0;
        base := pv_span_term_off(&mut c, spans[2 * i], spans[2 * i + 1], &mut off);
        if base.len() == 0 {
            return pv_call_give_up(&mut c, report, first, at, view(need), view("an argument is not a name, a constant or one of those plus a constant"));
        }
        // The parameter stands for the wrapped value of the argument: the term with an integer
        // offset where the argument's addition cannot wrap, the opaque term where it might.
        mut settled: i64 = 0;
        tm := pv_side(&mut c, &facts, view(base), off, &mut settled);
        if tm.len() == 0 {
            return pv_call_give_up(&mut c, report, first, at, view(need), view("an argument is not a name, a constant or one of those plus a constant"));
        }
        names.push(nm);
        terms.push(tm);
        offs.push(settled);
    }
    for i in terms.len() {
        pv_field_facts(&mut c, view(terms[i]), &mut facts);
    }
    for i in count {
        if pv_span_mutates(&mut c, spans[2 * i], spans[2 * i + 1]) {
            return pv_call_give_up(&mut c, report, first, at, view(need), view("an argument is borrowed or calls something"));
        }
    }
    for i in c.funcs[f - 1].ppreds.len() {
        mut pf = 0;
        mut plo = 0;
        mut phi = 0;
        if i < c.funcs[f - 1].ppreds.len() {
            p := &c.funcs[f - 1].ppreds[i];
            pf = p.file;
            plo = p.lo;
            phi = p.hi;
        }
        if phi == 0 {
            continue;
        }
        mut atoms = Atom[];
        if !pv_read_pred(&mut c, Pred { file: pf, lo: plo, hi: phi }, &mut atoms) {
            return pv_call_give_up(&mut c, report, Pred { file: pf, lo: plo, hi: phi }, at, view(need), view("the predicate is not a conjunction the prover reads"));
        }
        for j in atoms.len() {
            rel := atoms[j].rel;
            mut x = pv_rename_known(&mut c, view(atoms[j].a), &names, &terms);
            mut ok = x.len() != 0;
            mut y = u8[];
            if ok & (atoms[j].b.len() != 0) {
                y = pv_rename_known(&mut c, view(atoms[j].b), &names, &terms);
                ok = y.len() != 0;
            }
            // The arguments' own offsets, and the predicate's on top: the parameter `a` stands for
            // `x + oa`, the predicate reads `a + ao`, and each sum is an integer only where it is
            // shown not to wrap (pv_oblige_side). Then `x + ka REL y + kb + k` is
            // `x REL y + (k + kb - ka)`.
            oa := pv_rename_off(view(atoms[j].a), &names, &offs);
            ob := pv_rename_off(view(atoms[j].b), &names, &offs);
            mut k = atoms[j].k;
            if rel > 2 {
                // Only a comparison carries an offset; divisibility and a float class do not.
                if (oa != 0) || (ob != 0) {
                    ok = false;
                }
            } else {
                if ok {
                    mut ka: i64 = 0;
                    mut kb: i64 = 0;
                    x = pv_oblige_side(&mut c, &facts, view(x), oa, atoms[j].ao, &mut ka);
                    y = pv_oblige_side(&mut c, &facts, view(y), ob, atoms[j].bo, &mut kb);
                    mut bad = 0;
                    k = pv_k_sum(pv_k_sum(k, kb, &mut bad), 0 - ka, &mut bad);
                    ok = (x.len() != 0) & (y.len() != 0) & (bad == 0);
                }
            }
            if ok {
                if (rel <= 2) & (y.len() != 0) & same(view(x), view(y)) {
                    // One term on both sides: `t < t + k` is a statement about `k` alone.
                    ok = ((rel == 0) & (k >= 1)) || ((rel == 1) & (k >= 0)) || ((rel == 2) & (k == 0));
                } else {
                    ok = pv_holds(&facts, rel, view(x), view(y), k);
                }
            }
            if !ok & (x.len() != 0) & pv_false_literal(&facts, rel, view(x), view(y), k) {
                // Not unproved but disproved: the arguments are constants that break the predicate,
                // so the call can only fail. That is a wrong program in every mode.
                pv_false_fail(&mut c, Pred { file: pf, lo: plo, hi: phi }, at, view(need));
            }
            if !ok {
                return pv_call_give_up(&mut c, report, Pred { file: pf, lo: plo, hi: phi }, at, view(need), view("the facts at the call do not settle it"));
            }
        }
    }
    return 1;
}
// The base a `.len` term is the length of: `v.len` answers `v`, anything else answers empty.
fn pv_len_base<a>(t: &a [u8]) -> u8[] {
    n := t.len();
    if n <= 4 {
        return u8[];
    }
    if (t[n - 4] != 46) || (t[n - 3] != 108) || (t[n - 2] != 101) || (t[n - 1] != 110) {
        return u8[];
    }
    mut out = u8[];
    for i in 0 .. n - 4 {
        out.push(t[i]);
    }
    return out;
}
// Whether the body leaves a bound on a shared reference usable: neither name is written or bound
// again, no mutable loan of either appears, and the reference is only indexed or asked its length.
fn pv_bound_stable<a, b>(c: (&a mut C), index: &b [u8], base: &b [u8]) -> bool {
    mut i = c.body_lo;
    while i < c.body_hi {
        k := kind_at(&mut c, i);
        if k == 1 {
            t := tok_text(&mut c, i);
            // `match` arms and `let` patterns bind names the token walk cannot follow; a body with
            // either could index with a name this bound says nothing about.
            if same(view(t), view("match")) || same(view(t), view("let")) {
                return false;
            }
            if same(view(t), view(index)) || same(view(t), view(base)) {
                nk := kind_at(&mut c, i + 1);
                // A write of any kind makes what the entry knew about the name stale.
                if (nk == 61) || (nk == 262) || (nk == 263) || (nk == 264) || (nk == 265) || (nk == 266) || (nk == 268) {
                    return false;
                }
                if i >= 2 {
                    pk := kind_at(&mut c, i - 1);
                    if pk == 1 {
                        before := tok_text(&mut c, i - 1);
                        // `&mut NAME` is a loan a callee can write through.
                        if same(view(before), view("mut")) & (kind_at(&mut c, i - 2) == 38) {
                            return false;
                        }
                        // `mut NAME = ..`, `let NAME ..`, `for NAME in ..`: the name is bound again.
                        if same(view(before), view("mut")) || same(view(before), view("let")) || same(view(before), view("for")) {
                            return false;
                        }
                    }
                }
                // `v.push(x)` and its siblings can change what the bound was measured against.
                if same(view(t), view(base)) & (kind_at(&mut c, i + 1) == 46) & (kind_at(&mut c, i + 3) == 40) {
                    m := tok_text(&mut c, i + 2);
                    if !same(view(m), view("len")) {
                        return false;
                    }
                }
            }
        }
        i += 1;
    }
    return true;
}
// Whether this module compiles in strict mode: the flag, a `@strict;` in the module, or a `@strict`
// on the declaration being compiled.
fn ref_module_strict<a, b>(c: (&a C), m: &b [u8]) -> bool {
    for i in c.strict_modules.len() {
        if same(view(c.strict_modules[i]), view(m)) {
            return true;
        }
    }
    return false;
}
fn ref_strict<a>(c: (&a C)) -> bool {
    if c.strict_refinements != 0 {
        return true;
    }
    if c.strict_next != 0 {
        return true;
    }
    if c.strict_here != 0 {
        return true;
    }
    m := c.module.copy();
    return ref_module_strict(&c, view(m));
}
// `required by <fn> at <where>`: the second line of a strict-mode diagnostic.
fn pv_need<a, b>(c: (&a mut C), fn_name: &b [u8], at_file: u64, at_pos: u64) -> u8[] {
    mut out = copy_bytes(view("required by "));
    push_bytes(&mut out, view(fn_name));
    at := src_where(&mut c, at_file, at_pos);
    if at.len() != 0 {
        push_bytes(&mut out, view(" at "));
        push_bytes(&mut out, view(at));
    }
    return out;
}
// One atom as the diagnostic spells it, in the shape the prover reads.
fn pv_atom_text<a>(x: (&a Atom)) -> u8[] {
    mut out = u8[];
    push_bytes(&mut out, view(x.a));
    if x.rel == 4 {
        push_bytes(&mut out, view(".is_finite()"));
        return out;
    }
    if x.rel == 5 {
        push_bytes(&mut out, view(".is_nan()"));
        return out;
    }
    if x.rel == 3 {
        push_bytes(&mut out, view(" % "));
        decimal(&mut out, u64(x.k));
        push_bytes(&mut out, view(" == 0"));
        return out;
    }
    if x.rel == 0 {
        push_bytes(&mut out, view(" < "));
    }
    if x.rel == 1 {
        push_bytes(&mut out, view(" <= "));
    }
    if x.rel == 2 {
        push_bytes(&mut out, view(" == "));
    }
    push_bytes(&mut out, view(x.b));
    if x.k < 0 {
        push_bytes(&mut out, view(" - "));
        decimal(&mut out, u64(0 - x.k));
    } else {
        if 0 < x.k {
            push_bytes(&mut out, view(" + "));
            decimal(&mut out, u64(x.k));
        }
    }
    return out;
}
fn pv_facts_text<a>(facts: (&a Atom[])) -> u8[] {
    mut out = u8[];
    for i in facts.len() {
        push_bytes(&mut out, view("\n   "));
        item := &facts[i];
        push_bytes(&mut out, view(pv_atom_text(&item)));
    }
    if facts.len() == 0 {
        push_bytes(&mut out, view("\n   (none)"));
    }
    return out;
}
// Under strict mode an unproved obligation is a compile error, at the place the obligation is owed:
// the predicate, which declaration required it, and the facts the prover had.
fn pv_strict_fail<a, b>(c: (&a mut C), pred: Pred, pos: u64, need: &b [u8]) -> unit {
    pv_strict_fail_why(&mut c, pred, pos, view(need), view(""));
    return ();
}
fn pv_strict_fail_why<a, b, d>(c: (&a mut C), pred: Pred, pos: u64, need: &b [u8], why: &d [u8]) -> unit {
    // In a probe a static's value is not known while compiling (it is computed by the probe), so a
    // proof that needed it is missing there; the check stays, which is all the probe needs.
    if c.probe_mode != 0 {
        return ();
    }
    text := pred_text(&mut c, pred);
    mut facts = Atom[];
    pv_ir_read(&mut c, &mut facts);
    mut msg = copy_bytes(view("cannot prove the refinement `"));
    push_bytes(&mut msg, view(text));
    push_bytes(&mut msg, view("`"));
    if need.len() != 0 {
        push_bytes(&mut msg, view("\n = "));
        push_bytes(&mut msg, view(need));
    }
    if why.len() != 0 {
        push_bytes(&mut msg, view("\n = "));
        push_bytes(&mut msg, view(why));
    }
    push_bytes(&mut msg, view("\n = the facts in scope were:"));
    push_bytes(&mut msg, view(pv_facts_text(&facts)));
    exchange(&mut c.pos, pos);
    fail(&mut c, view(msg));
    return ();
}
// A refined parameter states a bound the body's indexing can use: `i < v.len()` on `v: &u64[]` is
// exactly what the check on `v[i]` needs, so the entry sets the pair a `for i in v.len()` loop sets
// (bce_index, bce_base) for this body. Nothing is assumed that the entry did not already check - the
// checked entry checks it, and a proved one had it proved - and a body that could make the bound
// stale sets nothing.
fn pv_bce<a>(c: (&a mut C)) -> unit {
    if (c.validating != 0) || (c.body_hi == 0) {
        return ();
    }
    for i in c.cur_ppreds.len() {
        mut pf = 0;
        mut plo = 0;
        mut phi = 0;
        if i < c.cur_ppreds.len() {
            p := &c.cur_ppreds[i];
            pf = p.file;
            plo = p.lo;
            phi = p.hi;
        }
        if phi == 0 {
            continue;
        }
        mut atoms = Atom[];
        if !pv_read_pred(&mut c, Pred { file: pf, lo: plo, hi: phi }, &mut atoms) {
            continue;
        }
        for j in atoms.len() {
            // Only `i < v.len()` bounds an index: a side with a constant is arithmetic that may
            // wrap, and any other comparison says nothing about an access.
            if (atoms[j].rel != 0) || (atoms[j].ao != 0) || (atoms[j].bo != 0) {
                continue;
            }
            index_name := atoms[j].a.copy();
            bound := pv_len_base(view(atoms[j].b));
            if (index_name.len() == 0) || (bound.len() == 0) {
                continue;
            }
            l := find_local(&mut c, view(bound));
            if l == 0 {
                continue;
            }
            bty := local_ty(&mut c, l - 1);
            k := ty_kind(&mut c, bty);
            // Only a shared reference (or a shared slice) has a length this function cannot change:
            // an owned vector could be pushed in the body.
            if !((k == 7) || (k == 27)) || (ty_mode(&mut c, bty) != 0) {
                continue;
            }
            if !pv_bound_stable(&mut c, view(index_name), view(bound)) {
                continue;
            }
            exchange(&mut c.bce_index, index_name);
            exchange(&mut c.bce_base, bound);
            return ();
        }
    }
    return ();
}
fn ident<a>(c: (&a mut C)) -> u8[] {
    if kind(&mut c) != 1 {
        mut msg = copy_bytes(view("expected a name here"));
        push_bytes(&mut msg, view(found_msg(&mut c)));
        fail(&mut c, view(msg));
    }
    t := tok_text(&mut c, c.pos);
    if same(view(t), view("true")) || same(view(t), view("false")) {
        fail(&mut c, view("truth keyword is not an identifier"));
    }
    advance(&mut c);
    return t;
}
// Skips a balanced {...} group starting at the current '{'.
// The `{` that opens a function body. A pass that is not checking this body still has to find where
// it ends, so it scans forward for the brace; a signature the file ends in has none, and the scan
// used to step over the end-of-file token and index past the token stream. It stops there now and
// the refusal names the `fn` (docs/design/frontend-robustness.md).
fn body_brace<a>(c: (&a mut C), position: u64) -> unit {
    while (kind(&mut c) != 123) & (kind(&mut c) != 0) {
        advance(&mut c);
    }
    if kind(&mut c) != 123 {
        diag_label(&mut c, position, view("this `fn` has no body"));
        expect(&mut c, view("{"));
    }
    return ();
}
fn skip_braces<a>(c: (&a mut C)) -> unit {
    mut depth = 0;
    opened := c.pos;
    while true {
        k := kind(&mut c);
        if k == 123 {
            depth = depth + 1;
        }
        if k == 125 {
            depth = depth - 1;
        }
        if k == 0 {
            diag_label(&mut c, opened, view("this `{` is never closed"));
            fail(&mut c, view("unclosed `{`: the block that starts here runs to the end of the file"));
        }
        advance(&mut c);
        if depth == 0 {
            return ();
        }
    }
    return ();
}
// The path a diagnostic or a `.file` directive names for a source index.
fn file_path<a>(c: (&a mut C), index: u64) -> u8[] {
    if 1000000 <= index {
        return c.virt_path[index - 1000000].copy();
    }
    mut out = u8[];
    path := input_path(&c, index);
    push_bytes(&mut out, view(path));
    return out;
}
// A literal the lexer could not finish arrives as a token (kind 998 a character literal, 996 an
// unclosed string, 995 a string holding a raw control byte) because the lexer has no diagnostic
// channel; this is where those tokens become errors. Before this, the lexer aborted on them and the
// reader saw "assertion failed" and a compiler source line.
fn fail_literal<a>(c: (&a mut C), at: u64, kind: u64) -> unit {
    exchange(&mut c.pos, at);
    text := tok_text(&mut c, at);
    if kind == 997 {
        // `<'a>`, `&'a`: a tick-prefixed name where Grail writes the name alone.
        mut msg = copy_bytes(view("`"));
        push_bytes(&mut msg, view(text));
        push_bytes(&mut msg, view("` is not a character literal, and it does not close as one"));
        diag_help(&mut c, view("for a character, close it (`'a'`); a lifetime takes no tick in Grail (`<'a>` is `<a>`, `&'a u64` is `&a u64`)"));
        fail(&mut c, view(msg));
    }
    if kind == 998 {
        if 2 <= text.len() {
            if text[text.len() - 1] == 39 {
                mut msg = copy_bytes(view("a character literal holds exactly one character: `"));
                push_bytes(&mut msg, view(text));
                push_bytes(&mut msg, view("` has more"));
                diag_help(&mut c, view("write the one character (`'a'`), or a string (`\"ab\"`) when the text is longer"));
                fail(&mut c, view(msg));
            }
        }
        fail(&mut c, view("unclosed character literal: add the closing `'`"));
    }
    if kind == 996 {
        fail(&mut c, view("unclosed string literal: add the closing `\"`"));
    }
    // 995: a raw control byte inside a string literal.
    mut seen = 0;
    for i in text.len() {
        if text[i] < 32 {
            seen = text[i];
        }
    }
    mut named = copy_bytes(view("a raw control byte"));
    mut escape = copy_bytes(view("a named escape"));
    if seen == 10 {
        named = copy_bytes(view("a raw line break"));
        escape = copy_bytes(view("`\\n`"));
    } else if seen == 9 {
        named = copy_bytes(view("a raw tab"));
        escape = copy_bytes(view("`\\t`"));
    } else if seen == 0 {
        named = copy_bytes(view("a raw NUL byte"));
        escape = copy_bytes(view("`\\0`"));
    }
    mut msg = copy_bytes(view("a string literal cannot hold "));
    push_bytes(&mut msg, view(named));
    push_bytes(&mut msg, view(": write the escape "));
    push_bytes(&mut msg, view(escape));
    push_bytes(&mut msg, view(" instead"));
    fail(&mut c, view(msg));
    return ();
}
fn load_file<a>(c: (&a mut C), index: u64) -> unit {
    // A generic body an interface carried is a file like any other from here on: it has its own
    // token stream and its own diagnostics, it just did not come from the command line.
    // The file that is loaded stays loaded, and a file that was loaded before comes back from the
    // cache: a specialisation is replayed in its template's file, and reading and tokenising that
    // file again for every one of them was most of a generic-heavy build
    // (docs/design/compile-speed.md).
    if c.file_loaded == index + 1 {
        load_file_reset(&mut c);
        return ();
    }
    exchange(&mut c.angle_ok, 0);
    if c.file_loaded != 0 {
        parked := c.file_loaded - 1;
        mut slot = c.file_cache_index.len();
        for i in c.file_cache_index.len() {
            if c.file_cache_index[i] == parked {
                slot = i;
                break;
            }
        }
        if slot == c.file_cache_index.len() {
            c.file_cache_index.push(parked);
            c.file_cache_src.push(u8[]);
            c.file_cache_toks.push(lexer::Token[]);
        }
        old_toks := exchange(&mut c.toks, lexer::Token[]);
        old_src := exchange(&mut c.src, u8[]);
        exchange(&mut c.file_cache_toks[slot], old_toks);
        exchange(&mut c.file_cache_src[slot], old_src);
        exchange(&mut c.file_loaded, 0);
    }
    for i in c.file_cache_index.len() {
        if c.file_cache_index[i] == index {
            // The entry stays in the list, empty, until this file is parked again.
            back_toks := exchange(&mut c.file_cache_toks[i], lexer::Token[]);
            back_src := exchange(&mut c.file_cache_src[i], u8[]);
            exchange(&mut c.toks, back_toks);
            exchange(&mut c.src, back_src);
            exchange(&mut c.file_loaded, index + 1);
            load_file_reset(&mut c);
            return ();
        }
    }
    mut path = u8[];
    mut src = u8[];
    if 1000000 <= index {
        path = c.virt_path[index - 1000000].copy();
        src = c.virt_text[index - 1000000].copy();
    } else {
        arg := input_path(&c, index);
        if host::exists(view(arg)) == 0 {
            host::print(view("grail: cannot read input file "));
            host::print(view(arg));
            host::print(view("\n"));
            host::exit(1);
        }
        push_bytes(&mut path, view(arg));
        mut cached = 0;
        if index < c.file_text.len() {
            // A file a `@derive` expanded into: the bytes this build has already seen, expansion
            // included, so a token position recorded in an earlier pass still names the same text.
            held := c.file_text[index].copy();
            if held.len() != 0 {
                src = held;
                cached = 1;
            }
        }
        if cached == 0 {
            if host::exists(view(arg)) == 0 {
                host::print(view("grail: cannot read input file "));
                host::print(view(arg));
                host::print(view("\n"));
                host::exit(1);
            }
            src = host::read_file(view(path));
        }
    }
    toks := lexer::tokenize(view(src));
    exchange(&mut c.toks, toks);
    exchange(&mut c.src, src);
    exchange(&mut c.pos, 0);
    for i in c.toks.len() {
        k := c.toks[i].kind;
        if (k == 999) || (k == 995) || (k == 996) || (k == 997) || (k == 998) {
            exchange(&mut c.pos, i);
            exchange(&mut c.file, index);
            if k != 999 {
                fail_literal(&mut c, i, k);
            }
            if c.src[c.toks[i].start] == 35 {
                fail(&mut c, view("`#` is not Grail syntax: comments start with //, and compile-time forms with @"));
            }
            fail(&mut c, view("unexpected character"));
        }
    }
    exchange(&mut c.file_loaded, index + 1);
    load_file_reset(&mut c);
    return ();
}
// What every load resets, fresh or from the cache. Token positions are indices into this file: a
// call-flex hint record or a `None` span from another file is stale.
fn load_file_reset<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.pos, 0);
    exchange(&mut c.cf_start, 0);
    exchange(&mut c.cf_end, 0);
    exchange(&mut c.cf_local, 0);
    exchange(&mut c.none_start, 0);
    exchange(&mut c.none_end, 0);
    return ();
}

// ---- types and declarations ----
fn numbers_equal<a, b>(a: (&a u64[]), b: (&b u64[])) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}
fn ty_hash<a, b>(k: u64, arg: u64, mode: u64, env: u64, regions: (&a u64[]), args: (&b u64[])) -> u64 {
    mut h: u64 = wrapping_mul(14695981039346656037 ^ k, 1099511628211);
    h = wrapping_mul(h ^ arg, 1099511628211);
    h = wrapping_mul(h ^ mode, 1099511628211);
    h = wrapping_mul(h ^ env, 1099511628211);
    for i in regions.len() {
        h = wrapping_mul(h ^ regions[i], 1099511628211);
    }
    h = wrapping_mul(h ^ 255, 1099511628211);
    for i in args.len() {
        h = wrapping_mul(h ^ args[i], 1099511628211);
    }
    return h ^ (h >> 29);
}
fn intern_env<a>(
    c: (&a mut C),
    k: u64,
    arg: u64,
    mode: u64,
    regions: u64[],
    args: u64[],
    env: u64
) -> u64 {
    if (k == 8) & (c.raw == 0) {
        for i in args.len() {
            if array_owned(&mut c, args[i]) {
                array_stage_fail(&mut c, view("a type argument, when its elements own data,"));
            }
        }
        // An enum's payload is one word until enums are inline (unboxed-values.md, stage 5).
        if c.decls[arg].is_enum != 0 {
            for i in args.len() {
                if is_array(&mut c, args[i]) {
                    array_stage_fail(&mut c, view("a type argument of an enum or an option"));
                }
            }
        }
    }
    // Types are interned, so this is asked for every type the checker builds: a hashed lookup in
    // an index kept beside the table, not a walk of every type the program has (see name_key).
    while c.ty_keys.len() < c.types.len() {
        old := &c.types[c.ty_keys.len()];
        index_add(&mut c.ty_slots, &mut c.ty_keys, ty_hash(old.kind, old.arg, old.mode, old.env, &old.regions, &old.args));
    }
    key := ty_hash(k, arg, mode, env, &regions, &args);
    if c.ty_slots.len() != 0 {
        mask := c.ty_slots.len() - 1;
        mut h = key & mask;
        while c.ty_slots[h] != 0 {
            i := c.ty_slots[h] - 1;
            if c.ty_keys[i] == key {
                t := &c.types[i];
                if (t.kind == k) & (t.arg == arg) & (t.mode == mode) & (t.env == env) {
                    if numbers_equal(&t.regions, &regions) {
                        if numbers_equal(&t.args, &args) {
                            return i;
                        }
                    }
                }
            }
            h = (h + 1) & mask;
        }
    }
    c.types.push(Ty { kind: k, arg: arg, mode: mode, regions: regions, args: args, env: env });
    return c.types.len() - 1;
}
fn intern_args<a>(c: (&a mut C), k: u64, arg: u64, mode: u64, regions: u64[], args: u64[]) -> u64 {
    return intern_env(&mut c, k, arg, mode, regions, args, 0);
}
// ---- closure bounds (docs/design/closure-bounds.md) ------------------------------------------------
// A closure type's `mode` is a set of bits: 1 `FnMut`, and the bounds a signature states about what
// the closure captured - 2 `Send`, 4 `Share`, 8 `Owned` (no capture holds a borrow). 16 marks the type
// of a closure expression seen while a generic template is validated: its environment is only built
// by a specialisation, so nothing is known of it yet and nothing is refused on its account.
// The spelling `Fn<Send, Share, Owned>(..)` lives in two functions: `closure_bound_bit` reads a
// name, `closure_bounds_text` writes the list.
const CLOSURE_FNMUT: u64 = 1;
const CLOSURE_SEND: u64 = 2;
const CLOSURE_SHARE: u64 = 4;
const CLOSURE_OWNED: u64 = 8;
const CLOSURE_UNBUILT: u64 = 16;
const CLOSURE_BOUNDS: u64 = 14;
fn closure_bound_bit<a>(name: &a [u8]) -> u64 {
    if same(name, view("Send")) {
        return CLOSURE_SEND;
    }
    if same(name, view("Share")) {
        return CLOSURE_SHARE;
    }
    if same(name, view("Owned")) {
        return CLOSURE_OWNED;
    }
    return 0;
}
fn closure_bounds_text<a>(out: (&a mut u8[]), mode: u64) -> unit {
    closure_bounds_text_named(&mut out, mode, view(""));
    return ();
}
fn closure_bounds_text_named<a, b>(out: (&a mut u8[]), mode: u64, region: &b [u8]) -> unit {
    if ((mode & CLOSURE_BOUNDS) == 0) & (region.len() == 0) {
        return ();
    }
    if (mode & CLOSURE_BOUNDS) == 0 {
        out.push(60);
        push_bytes(&mut out, region);
        out.push(62);
        return ();
    }
    out.push(60);
    mut some = false;
    if (mode & CLOSURE_SEND) != 0 {
        push_bytes(&mut out, view("Send"));
        some = true;
    }
    if (mode & CLOSURE_SHARE) != 0 {
        if some {
            push_bytes(&mut out, view(", "));
        }
        push_bytes(&mut out, view("Share"));
        some = true;
    }
    if (mode & CLOSURE_OWNED) != 0 {
        if some {
            push_bytes(&mut out, view(", "));
        }
        push_bytes(&mut out, view("Owned"));
    }
    if region.len() != 0 {
        push_bytes(&mut out, view(", "));
        push_bytes(&mut out, region);
    }
    out.push(62);
    return ();
}
// `<Send, Owned>` after `Fn` / `FnMut` in a type: the bound bits, 0 when there is no list.
// A lifetime in the list (`Fn<s>(..)`) is pushed onto `regions`: the closure's borrows come from
// `s`, which the type now carries like a reference's lifetime, so whatever holds the closure is
// labelled `s` and the ordinary region checks follow its loans (docs/design/closure-bounds.md, 2.4).
fn closure_bounds_list<a, b>(c: (&a mut C), fnmut: bool, regions: (&b mut u64[])) -> u64 {
    if !eat(&mut c, view("<")) {
        return 0;
    }
    mut bits = 0;
    while true {
        name := ident(&mut c);
        bit := closure_bound_bit(view(name));
        if bit == 0 {
            if (96 < name[0]) & (name[0] < 123) {
                mut found = 0;
                for i in c.rnames.len() {
                    if same(view(c.rnames[i]), view(name)) {
                        found = i + 1;
                    }
                }
                if found == 0 {
                    fail(&mut c, view("undeclared lifetime"));
                }
                if regions.len() != 0 {
                    fail(&mut c, view("a closure type names at most one lifetime: `Fn<s>(..)`"));
                }
                regions.push(found);
                if eat(&mut c, view(">")) {
                    break;
                }
                expect(&mut c, view(","));
                continue;
            }
            fail(&mut c, view("a closure type's bounds are `Send`, `Share`, `Owned` and one lifetime: write `Fn<Send>(..)`"));
        }
        if (bits & bit) != 0 {
            fail(&mut c, view("duplicate closure bound"));
        }
        bits += bit;
        if eat(&mut c, view(">")) {
            break;
        }
        expect(&mut c, view(","));
    }
    if ((bits & CLOSURE_OWNED) != 0) & (regions.len() != 0) {
        fail(&mut c, view("`Owned` and a lifetime cannot both bound a closure: `Owned` names no borrow beyond its signature, a lifetime names the one it may hold"));
    }
    if fnmut & ((bits & CLOSURE_SHARE) != 0) {
        fail(
            &mut c,
            view("`FnMut<Share>` is not a type: a closure that writes its captures cannot be shared by concurrent callers; use a Mutex, or `Fn<Share>`")
        );
    }
    return bits;
}
// Whether a closure value of type `actual` meets the bounds `want` (bits) states. A closure
// expression's type carries its environment, so its captures answer; a type from a signature has
// only what it says. Silent: the caller decides what to report.
fn closure_bounds_hold<a>(c: (&a mut C), actual: u64, want: u64) -> bool {
    am := ty_mode(&mut c, actual);
    if (am & CLOSURE_UNBUILT) != 0 {
        return true;
    }
    env := ty_env(&mut c, actual);
    if (want & CLOSURE_SEND) != 0 {
        if (am & CLOSURE_SEND) == 0 {
            if env == 0 {
                return false;
            }
            mut trail = u64[];
            if transfer_capability(&mut c, actual, 0, &mut trail, 0) == 0 {
                return false;
            }
        }
    }
    if (want & CLOSURE_SHARE) != 0 {
        if (am & CLOSURE_FNMUT) != 0 {
            return false;
        }
        if (am & CLOSURE_SHARE) == 0 {
            if env == 0 {
                return false;
            }
            mut trail = u64[];
            if transfer_capability(&mut c, actual, 1, &mut trail, 0) == 0 {
                return false;
            }
        }
    }
    if (want & CLOSURE_OWNED) != 0 {
        if (am & CLOSURE_OWNED) == 0 {
            if env == 0 {
                return false;
            }
            if closure_hidden_regions(&mut c, actual).len() != 0 {
                return false;
            }
        }
    }
    return true;
}
// THE `Owned` RULE (docs/design/closure-bounds.md, 2.1): every region of every borrow in a
// closure's environment appears among the regions of the closure's own type - its parameters or
// its result. A borrow the type does not name makes it not `Owned`. Anything that stores such a
// closure then carries the region in its own type (`Iter<(&a K)>`), and the ordinary region checks
// follow it; this is what `borrow_walk` already says of a closure type from a signature (a result
// naming a lifetime no parameter supplies is a borrow the value holds), now the one rule for both.
// Answers the captured regions the type does not name; empty when the closure is `Owned`.
fn closure_hidden_regions<a>(c: (&a mut C), ty: u64) -> u64[] {
    mut hidden = u64[];
    if ty_kind(&mut c, ty) != 20 {
        return hidden;
    }
    captured := type_regions(&mut c, ty);
    if captured.len() == 0 {
        return hidden;
    }
    mut trail = u64[];
    mut named = caps_walk(&mut c, ty_arg(&mut c, ty), &mut trail);
    params := type_args(&mut c, ty);
    for p in params.len() {
        more := caps_walk(&mut c, params[p], &mut trail);
        for i in more.len() {
            add_region(&mut named, more[i]);
        }
    }
    for i in captured.len() {
        mut seen = false;
        // Region 0 is a local of the enclosing function: no type can name it.
        if captured[i] != 0 {
            for j in named.len() {
                if named[j] == captured[i] {
                    seen = true;
                }
            }
        }
        if !seen {
            add_region(&mut hidden, captured[i]);
        }
    }
    return hidden;
}
// `actual` with the call mode and bounds of `expected`, and no environment: what the value's type
// becomes once it is converted. Equal to `expected` exactly when the two differ in nothing else.
fn closure_as<a>(c: (&a mut C), actual: u64, expected: u64) -> u64 {
    result := ty_arg(&mut c, actual);
    args := type_args(&mut c, actual);
    return intern_args(&mut c, 20, result, ty_mode(&mut c, expected), u64[], args);
}
// The conversion of a closure value to a closure type a signature wrote (rule 2.3 of the note):
// same parameters and result; `Fn` where `FnMut` is expected but not the reverse; and every bound
// the expected type states is met by the captures (or stated by the value's own type). 1 when the
// value converts, 0 when the two types differ in more than mode and bounds - the caller's ordinary
// mismatch. A bound that is not met is reported here, by name, because "type mismatch" would hide
// the capture that is the reason.
fn closure_converts<a>(c: (&a mut C), actual: u64, expected: u64) -> u64 {
    if (ty_kind(&mut c, actual) != 20) || (ty_kind(&mut c, expected) != 20) {
        return 0;
    }
    am := ty_mode(&mut c, actual);
    em := ty_mode(&mut c, expected);
    if ((am & CLOSURE_FNMUT) != 0) & ((em & CLOSURE_FNMUT) == 0) {
        return 0;
    }
    if (em & CLOSURE_UNBUILT) != 0 {
        return 0;
    }
    erased := closure_as(&mut c, actual, expected);
    mut map = u64[];
    if !callable_contract(&mut c, erased, expected, &mut map, 0) {
        return 0;
    }
    want := em & CLOSURE_BOUNDS;
    if closure_bounds_hold(&mut c, actual, want) {
        return 1;
    }
    closure_bound_fail(&mut c, actual, want);
    return 0;
}
fn closure_bound_fail<a>(c: (&a mut C), actual: u64, want: u64) -> unit {
    am := ty_mode(&mut c, actual);
    env := ty_env(&mut c, actual);
    if env == 0 {
        mut msg = copy_bytes(view("`"));
        push_bytes(&mut msg, view(source_type_name(&mut c, actual)));
        push_bytes(&mut msg, view("` does not say what it captured, so it cannot be used as `"));
        mut list = u8[];
        closure_bounds_text(&mut list, want);
        push_bytes(&mut msg, view("Fn"));
        push_bytes(&mut msg, view(list));
        push_bytes(&mut msg, view("(..)`: state the bound where this value's type is written"));
        fail(&mut c, view(msg));
    }
    if ((want & CLOSURE_SHARE) != 0) & ((am & CLOSURE_FNMUT) != 0) {
        fail(
            &mut c,
            view("a callback shared by concurrent workers must not write a captured value: an FnMut closure would race on its own environment; use a Mutex or return an owned result")
        );
    }
    if (want & CLOSURE_SHARE) != 0 {
        require_closure_captures(&mut c, actual, 1, view("closure capture"));
    }
    if (want & CLOSURE_SEND) != 0 {
        require_closure_captures(&mut c, actual, 0, view("closure capture"));
    }
    hidden := closure_hidden_regions(&mut c, actual);
    mut msg = copy_bytes(view("this closure captures a borrow its type does not name ("));
    mut r = 0;
    if hidden.len() != 0 {
        r = hidden[0];
    }
    if (r != 0) && (r <= c.rnames.len()) {
        push_bytes(&mut msg, view("lifetime `"));
        push_bytes(&mut msg, view(c.rnames[r - 1]));
        push_bytes(&mut msg, view("`"));
    } else {
        push_bytes(&mut msg, view("a local of this function"));
    }
    push_bytes(&mut msg, view("), and an `Owned` closure is required here: whatever keeps it sees only its type. Name the borrow in the closure's result type (`-> (&a T)`) so the type carries it, or move the value in"));
    fail(&mut c, view(msg));
    return ();
}
// A closure typed by a signature that states bounds but not `Owned`: a value converted to it may
// still hold the borrows it captured, which its type no longer shows.
fn closure_stated_borrower<a>(c: (&a mut C), ty: u64) -> bool {
    if (ty_kind(&mut c, ty) != 20) || (ty_env(&mut c, ty) != 0) {
        return false;
    }
    mode := ty_mode(&mut c, ty);
    return ((mode & CLOSURE_BOUNDS) != 0) & ((mode & CLOSURE_OWNED) == 0);
}
// Parameters that only a callable bound names (`impl<I, U, F: FnMut(I::Item) -> U> ... for Map<I, F>`:
// `U`) are fixed by the closure or function the bound parameter was bound to, as Rust's `Fn` bounds
// fix their output type.
fn infer_from_callables<a, b>(c: (&a mut C), sets: (&a u64[][]), map: (&b mut u64[])) -> unit {
    for i in sets.len() {
        if i < map.len() {
            bound := callable_in(&sets[i]);
            if (bound != NO_TYPE) && (map[i] != NO_TYPE) {
                actual := base_type(&mut c, map[i]);
                ak := ty_kind(&mut c, actual);
                if (ak == 20) || (ak == 12) {
                    infer_callable(&mut c, bound, actual, &mut map);
                }
            }
        }
    }
    return ();
}
// A callable bound is higher-ranked in its free lifetimes: a reference parameter whose lifetime the
// bound names nowhere else (`F: FnMut((&mut T), C) -> R`) is a fresh lifetime on every call, so the
// closure or function given for it must not tie that parameter's lifetime to anything else it can
// reach - another parameter (a context `C = &mut Out<'a>`), its result, or what it captured -
// or the callee's guarded `&mut T` could be stored where it outlives the call. Empty when `actual`
// is independent enough; otherwise the parameter index (1-based) that is tied.
fn callable_tied_param<a>(c: (&a mut C), actual: u64, bound: u64) -> u64 {
    ak := ty_kind(&mut c, actual);
    if (ak != 20) && (ak != 12) {
        return 0;
    }
    bp := type_args(&mut c, bound);
    ap := type_args(&mut c, actual);
    if bp.len() != ap.len() {
        return 0;
    }
    for i in bp.len() {
        bk := ty_kind(&mut c, bp[i]);
        if (bk != 5) && (bk != 7) && (bk != 27) {
            continue;
        }
        // The bound's own lifetime for this parameter: free unless something else in the bound
        // names it.
        mut trail = u64[];
        mine := caps_walk(&mut c, bp[i], &mut trail);
        mut others = u64[];
        for j in bp.len() {
            if j != i {
                mut t2 = u64[];
                more := caps_walk(&mut c, bp[j], &mut t2);
                for q in more.len() {
                    add_region(&mut others, more[q]);
                }
            }
        }
        mut t3 = u64[];
        res := caps_walk(&mut c, ty_arg(&mut c, bound), &mut t3);
        for q in res.len() {
            add_region(&mut others, res[q]);
        }
        mut free = true;
        for q in mine.len() {
            for r in others.len() {
                if mine[q] == others[r] {
                    free = false;
                }
            }
        }
        if !free {
            continue;
        }
        // The argument's lifetime for it must be named nowhere else the argument can reach.
        mut t4 = u64[];
        theirs := caps_walk(&mut c, ap[i], &mut t4);
        mut reach = u64[];
        for j in ap.len() {
            if j != i {
                mut t5 = u64[];
                more := caps_walk(&mut c, ap[j], &mut t5);
                for q in more.len() {
                    add_region(&mut reach, more[q]);
                }
            }
        }
        mut t6 = u64[];
        ares := caps_walk(&mut c, ty_arg(&mut c, actual), &mut t6);
        for q in ares.len() {
            add_region(&mut reach, ares[q]);
        }
        if ak == 20 {
            captured := type_regions(&mut c, actual);
            for q in captured.len() {
                add_region(&mut reach, captured[q]);
            }
        }
        for q in theirs.len() {
            for r in reach.len() {
                if (theirs[q] != 0) && (theirs[q] == reach[r]) {
                    return i + 1;
                }
            }
        }
    }
    return 0;
}
// One entry of a parameter's requirement set, met by `ty` with the parameters bound by `map`: an
// interface, or a callable bound (the closure or function `ty` converts to the bound).
fn meets_requirement<a, b>(c: (&a mut C), ty: u64, id: u64, map: (&b u64[])) -> bool {
    if CALLABLE_PENDING <= id {
        return true;
    }
    if CALLABLE_BOUND <= id {
        mut t = ty;
        if ty_kind(&mut c, t) == 10 {
            t = ty_arg(&mut c, t);
        }
        mut known = true;
        for i in map.len() {
            if map[i] == NO_TYPE {
                known = false;
            }
        }
        if !known {
            return (ty_kind(&mut c, t) == 20) || (ty_kind(&mut c, t) == 12);
        }
        bound := bind_types(&mut c, id - CALLABLE_BOUND, &map);
        if callable_tied_param(&mut c, t, bound) != 0 {
            return false;
        }
        if same_type(&mut c, t, bound) != 0 {
            return true;
        }
        if (ty_kind(&mut c, t) == 20) && (closure_bounds_hold(&mut c, t, ty_mode(&mut c, bound) & CLOSURE_BOUNDS)) {
            erased := closure_as(&mut c, t, bound);
            mut m = u64[];
            return callable_contract(&mut c, erased, bound, &mut m, 0);
        }
        if ty_kind(&mut c, t) == 12 {
            plain := intern_args(&mut c, 20, ty_arg(&mut c, t), ty_mode(&mut c, bound), u64[], type_args(&mut c, t));
            mut m = u64[];
            return callable_contract(&mut c, plain, bound, &mut m, 0);
        }
        return false;
    }
    return satisfies_interface(&mut c, ty, id);
}
// A callable bound on a type parameter (`F: FnMut(T) -> U`, docs/design/dyn-and-callable-bounds.md
// 2b) travels in the parameter's requirement set beside its interface ids, as this tag plus the
// bound's closure type, so every place that carries requirements carries it too.
const CALLABLE_BOUND: u64 = 1099511627776;
const CALLABLE_PENDING: u64 = 2199023255552;
fn callable_in<a>(set: (&a u64[])) -> u64 {
    for i in set.len() {
        if (CALLABLE_BOUND <= set[i]) & (set[i] < CALLABLE_PENDING) {
            return set[i] - CALLABLE_BOUND;
        }
    }
    return NO_TYPE;
}
// Past a callable bound in a generic list: to the `,`, `>` or `+` that ends it at depth zero (the
// `->` of its result is one token, so its `>` does not end it).
fn skip_callable_bound<a>(c: (&a mut C)) -> unit {
    mut depth = 0;
    while true {
        k := kind(&mut c);
        if k == 0 {
            return ();
        }
        if (depth == 0) && ((k == 44) || (k == 62) || (k == 43)) {
            return ();
        }
        if (k == 40) || (k == 91) || (k == 60) {
            depth += 1;
        }
        if (k == 41) || (k == 93) || (k == 62) {
            depth -= 1;
        }
        advance(&mut c);
    }
    return ();
}
// The callable bounds the generic list recorded by position, read now that every type parameter
// of the declaration (an impl's included) is in scope.
fn resolve_callable_bounds<a>(c: (&a mut C)) -> unit {
    for i in c.type_interfaces.len() {
        for j in c.type_interfaces[i].len() {
            entry := c.type_interfaces[i][j];
            if CALLABLE_PENDING <= entry {
                here := exchange(&mut c.pos, entry - CALLABLE_PENDING);
                // A bound is an input: an elided reference in it is a fresh input lifetime, as in a
                // parameter list (an impl header reads it outside one).
                was := exchange(&mut c.parsing_input, 1);
                bound := parse_type(&mut c);
                exchange(&mut c.parsing_input, was);
                exchange(&mut c.pos, here);
                c.type_interfaces[i][j] = CALLABLE_BOUND + bound;
            }
        }
    }
    return ();
}
// The callable bound a type parameter's own type carries (`F: FnMut(T) -> U`), or NO_TYPE.
fn param_callable<a>(c: (&a mut C), ty: u64) -> u64 {
    mut t = ty;
    // A generic body checks with each parameter as an opaque binding of it (kind 10).
    if ty_kind(&mut c, t) == 10 {
        t = ty_arg(&mut c, t);
    }
    // A specialisation's binding: the closure (or function) type itself.
    tk := ty_kind(&mut c, t);
    if (ty_kind(&mut c, ty) == 10) && ((tk == 20) || (tk == 12) || (tk == 25)) {
        return t;
    }
    if tk != 9 {
        return NO_TYPE;
    }
    args := type_args(&mut c, t);
    for i in args.len() {
        if ty_kind(&mut c, args[i]) == 20 {
            return args[i];
        }
    }
    return NO_TYPE;
}
// For a specialisation's binding `alias` of a callable-bound parameter: the bound with the
// specialisation's bindings substituted, or NO_TYPE.
fn spec_callable_signature<a>(c: (&a mut C), alias: u64) -> u64 {
    if (c.current_spec == 0) || (c.current_spec > c.specs.len()) {
        return NO_TYPE;
    }
    template := c.specs[c.current_spec - 1].template;
    for j in c.bindings.len() {
        if c.bindings[j] == alias {
            if j < c.funcs[template].constraints.len() {
                set := copy_numbers(&c.funcs[template].constraints[j]);
                bound := callable_in(&set);
                if bound != NO_TYPE {
                    bindings := copy_numbers(&c.bindings);
                    return bind_types(&mut c, bound, &bindings);
                }
            }
        }
    }
    return NO_TYPE;
}
// The callable bound of the type parameter `formal` of function `f` (index), or NO_TYPE.
fn callable_formal<a>(c: (&a mut C), f: u64, formal: u64) -> u64 {
    if ty_kind(&mut c, formal) != 9 {
        return NO_TYPE;
    }
    i := ty_arg(&mut c, formal);
    if i < c.funcs[f].constraints.len() {
        set := copy_numbers(&c.funcs[f].constraints[i]);
        return callable_in(&set);
    }
    return NO_TYPE;
}
// The environment record of a closure type, or 0 when it carries no captures.
fn ty_env<a>(c: (&a mut C), ty: u64) -> u64 {
    if !is_type_id(ty) {
        fail(&mut c, view("internal: no type where one is required"));
    }
    t := &c.types[ty];
    return t.env;
}
fn intern_full<a>(c: (&a mut C), k: u64, arg: u64, mode: u64, regions: u64[]) -> u64 {
    return intern_args(&mut c, k, arg, mode, regions, u64[]);
}
fn type_args<a>(c: (&a mut C), ty: u64) -> u64[] {
    mut args = u64[];
    if !is_type_id(ty) {
        fail(&mut c, view("internal: no type where one is required"));
    }
    t := &c.types[ty];
    for i in t.args.len() {
        args.push(t.args[i]);
    }
    return args;
}
fn intern<a>(c: (&a mut C), k: u64, arg: u64) -> u64 {
    return intern_full(&mut c, k, arg, 0, u64[]);
}
fn copy_numbers<a>(input: (&a u64[])) -> u64[] {
    mut out = u64[];
    for i in input.len() {
        out.push(input[i]);
    }
    return out;
}
// `transferable(T)` and `shareable(T)` for one type, derived structurally over Grail's types
// (docs/design/parallelism.md). Not a trait system and not a bound on every signature: a property of
// the type alone, computed where a value is about to cross a thread boundary.
//
// `shared` selects the question: 0 asks whether a value may cross to another worker (transferable),
// 1 whether concurrent shared access to it is allowed (shareable). One walk answers both because the
// recursion has the same shape; only the leaf rule and the borrow rule differ. The two are genuinely
// distinct - a movable-but-not-shareable decoder context is transferable and not shareable.
//
// A denial records why (`cap_denial`) and the field path that reached the leaf (`cap_segs`), so the
// diagnostic names the offending field. `capability_begin` resets both at each entry point.
fn transfer_capability<a, b>(
    c: (&a mut C),
    ty: u64,
    shared: u64,
    trail: (&b mut u64[]),
    depth: u64
) -> u64 {
    if 64 < depth {
        return deny(&mut c, 10);
    }
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    // Plain data: no foreign authority and no interior mutability.
    if (k == 1) || (k == 2) || (k == 3) || (k == 4) || (k == 11) || (k == 12) || (k == 17) || (k == 18) || (k == 19) || (k == 21) || (k == 22) {
        return true;
    }
    // A Scope is the thread that runs its body: it never leaves that thread.
    if k == 14 {
        return deny(&mut c, 3);
    }
    if (k == 5) || (k == 27) {
        if shared != 0 {
            if ty_mode(&mut c, ty) != 0 {
                return deny(&mut c, 4);
            }
        }
        // A typed slice reaches its elements, so sharing `&[T]` shares `T`: a `&[File]` reaches a
        // file handle even though the slice itself is only a borrowed view (docs/design/parallelism.md).
        if k == 27 {
            return transfer_capability(&mut c, arg, shared, &mut trail, depth + 1);
        }
        return true;
    }
    // An associated type of a parameter has no capability bounds to rely on.
    if k == 30 {
        return deny(&mut c, 8);
    }
    // An interface object is what its type says (`dyn<Send> I`): its concrete type is checked when
    // it is boxed, and a bare `dyn I` says nothing.
    if k == 33 {
        mut need = CLOSURE_SEND;
        if shared != 0 {
            need = CLOSURE_SHARE;
        }
        if (ty_mode(&mut c, ty) & need) != 0 {
            return true;
        }
        return deny(&mut c, 14);
    }
    // The referent of a `&dyn I`.
    if k == 35 {
        return transfer_capability(&mut c, arg, shared, &mut trail, depth + 1);
    }
    // A capability proof (kind 9) carries its own bits: 1 transferable, 2 shareable.
    if k == 9 {
        proof := ty_mode(&mut c, ty);
        mut bit = 1;
        if shared != 0 {
            bit = 2;
        }
        if (proof & bit) != 0 {
            return true;
        }
        return deny(&mut c, 8);
    }
    if k == 10 {
        return transfer_capability(&mut c, arg, shared, &mut trail, depth + 1);
    }
    // An audited foreign handle. Nothing declared means neither: a handle is thread-affine until its
    // own declaration says otherwise, and that default is the whole point of the audit.
    if k == 23 {
        tr := c.decls[arg].transfer;
        sh := c.decls[arg].share;
        if shared != 0 {
            if sh != 0 {
                return true;
            }
            if tr != 0 {
                return deny(&mut c, 2);
            }
            return deny(&mut c, 1);
        }
        if tr != 0 {
            return true;
        }
        if sh != 0 {
            return deny(&mut c, 2);
        }
        return deny(&mut c, 1);
    }
    // A C string and a bare C pointer reach foreign memory we have not audited, and a `cfn` pointer
    // is code we have not audited: all three stay unclassified, so all three are denied.
    if k == 24 {
        return deny(&mut c, 7);
    }
    if (k == 26) || (k == 34) {
        return deny(&mut c, 7);
    }
    if k == 25 {
        return deny(&mut c, 9);
    }
    // `byval(R)` states an ABI, not a second type: it classifies as R.
    if k == 28 {
        return transfer_capability(&mut c, arg, shared, &mut trail, depth + 1);
    }
    // A type already on the walk is its own cycle: assume it satisfies the property and let the
    // fields decide.
    key := ty * 2 + shared;
    for i in trail.len() {
        if trail[i] == key {
            return true;
        }
    }
    trail.push(key);
    mut allowed = 0;
    mut why = 7;
    if k == 6 {
        allowed = transfer_capability(&mut c, arg, shared, &mut trail, depth + 1);
    }
    // A mutex serializes access: sharing it only requires that its payload may move.
    if k == 13 {
        allowed = transfer_capability(&mut c, arg, 0, &mut trail, depth + 1);
    }
    // A task handle may move (joining is ownership-based) but never be shared.
    if k == 16 {
        if shared == 0 {
            allowed = transfer_capability(&mut c, arg, 0, &mut trail, depth + 1);
        } else {
            why = 6;
        }
    }
    // A pool job handle is the same shape: ownership-based joining, never shared. Sharing it would
    // let two threads wait on one record, and the second wait would free it twice.
    if k == 29 {
        if shared == 0 {
            allowed = transfer_capability(&mut c, arg, 0, &mut trail, depth + 1);
        } else {
            why = 11;
        }
    }
    if k == 7 {
        mode := ty_mode(&mut c, ty);
        if mode != 0 {
            if shared == 0 {
                allowed = transfer_capability(&mut c, arg, 0, &mut trail, depth + 1);
            } else {
                why = 5;
            }
        } else {
            // A shared reference is shareable only when its referent is: `&T` gives the holder
            // every method callable through `T`.
            allowed = transfer_capability(&mut c, arg, 1, &mut trail, depth + 1);
        }
    }
    if k == 8 {
        // An audited `unsafe struct ... : transferable, shareable` states the contract itself, and
        // the walk below would only deny it again for the pointer that made it unsafe. Every type
        // argument must still classify, as Rust requires of `unsafe impl<T: Send + Sync>`.
        mut audited = c.decls[arg].share;
        if shared == 0 {
            audited = c.decls[arg].transfer;
        }
        if audited != 0 {
            args := type_args(&mut c, ty);
            for i in args.len() {
                if transfer_capability(&mut c, args[i], shared, &mut trail, depth + 1) == 0 {
                    trail.pop()!;
                    return 0;
                }
            }
            trail.pop()!;
            return true;
        }
        count := c.decls[arg].count;
        first := c.decls[arg].first;
        allowed = 1;
        for i in count {
            name := c.fields[first + i].name.copy();
            field := field_type(&mut c, ty, i);
            c.cap_segs.push(name);
            if transfer_capability(&mut c, field, shared, &mut trail, depth + 1)
                == 0 {
                trail.pop()!;
                return 0;
            }
            c.cap_segs.pop()!;
        }
    }
    // A closure's environment counts, not just its signature: the captures are what a worker can
    // actually reach. `__code` and `__drop` are plain words, so walking every environment field
    // needs no special case; a capture name is pushed like a record field.
    if k == 20 {
        env := ty_env(&mut c, ty);
        allowed = 1;
        cm := ty_mode(&mut c, ty);
        // A closure that writes its captures cannot be shared, whatever they are.
        if (shared != 0) & ((cm & CLOSURE_FNMUT) != 0) & ((cm & CLOSURE_UNBUILT) == 0) {
            allowed = 0;
            why = 13;
        }
        // A closure type from a signature has no environment to walk: it is what it says it is,
        // and a bare `Fn(..)` says nothing (default-deny, like a handle).
        if (env == 0) & ((cm & CLOSURE_UNBUILT) == 0) {
            mut need = CLOSURE_SEND;
            if shared != 0 {
                need = CLOSURE_SHARE;
            }
            if (cm & need) == 0 {
                allowed = 0;
                if why != 13 {
                    why = 12;
                }
            }
        }
        if (env != 0) & (allowed != 0) {
            d := ty_arg(&mut c, env);
            count := c.decls[d].count;
            first := c.decls[d].first;
            for i in count {
                name := c.fields[first + i].name.copy();
                field := field_type(&mut c, env, i);
                c.cap_segs.push(name);
                if transfer_capability(&mut c, field, shared, &mut trail, depth + 1)
                    == 0 {
                    trail.pop()!;
                    return 0;
                }
                c.cap_segs.pop()!;
            }
        }
    }
    trail.pop()!;
    if allowed != 0 {
        return true;
    }
    return deny(&mut c, why);
}
// Records why the first denied leaf was denied, and denies. The codes are turned into words only
// when a diagnostic is built, so the walk itself allocates nothing.
//   1 a foreign handle with no audited classification (thread-affine)
//   2 a foreign handle declared transferable but not shareable (thread-affine)
//   3 a scope, bound to the thread running its body
//   4 a mutable slice or view, which cannot be shared
//   5 an exclusive borrow, which cannot be shared
//   6 a Task handle, which cannot be shared
//   7 a value of a foreign or unclassified kind
//   8 no capability proof for the type parameter
//   9 an unclassified C function pointer
//  10 a type that nests too deeply to classify
//  11 a job handle, which cannot be shared
//  12 a closure type from a signature that does not state the bound
//  13 an FnMut closure, which cannot be shared
//  14 an interface object whose dyn type states no Send / Share bound
fn deny<a>(c: (&a mut C), code: u64) -> u64 {
    if c.cap_denial == 0 {
        exchange(&mut c.cap_denial, code);
    }
    return 0;
}
fn capability_begin<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.cap_denial, 0);
    exchange(&mut c.cap_segs, u8[][]);
    return ();
}
// The dotted field path to the denied leaf, e.g. `decoder.context`.
fn dotted_path<a, b>(c: (&a mut C), out: (&b mut u8[])) -> unit {
    for i in c.cap_segs.len() {
        if i != 0 {
            out.push(46);
        }
        dput(&mut out, view(c.cap_segs[i]));
    }
    return ();
}
// Whether the denial text is an adjective that needs a subject (`file is thread-affine`) or a
// clause that already has one (`a mutable slice or view cannot be shared`).
fn cap_denial_adjective(code: u64) -> u64 {
    return u64((code == 1) || (code == 2));
}
fn cap_denial_text<a, b>(c: (&a mut C), out: (&b mut u8[])) -> unit {
    code := c.cap_denial;
    if code == 1 {
        dput(&mut out, view("thread-affine (a foreign handle with no audited classification)"));
    } else {
        if code == 2 {
            dput(&mut out, view("thread-affine (declared transferable, not shareable)"));
        } else {
            if code == 3 {
                dput(&mut out, view("the scope is bound to the thread running its body"));
            } else {
                if code == 4 {
                    dput(&mut out, view("a mutable slice or view cannot be shared"));
                } else {
                    if code == 5 {
                        dput(&mut out, view("an exclusive borrow cannot be shared"));
                    } else {
                        if code == 6 {
                            dput(&mut out, view("a Task handle cannot be shared"));
                        } else {
                            if code == 7 {
                                dput(&mut out, view("unclassified foreign authority"));
                            } else {
                                if code == 8 {
                                    dput(&mut out, view("no capability proof for the type parameter"));
                                } else {
                                    if code == 9 {
                                        dput(&mut out, view("an unclassified C function pointer"));
                                    } else {
                                        if code == 11 {
                                            dput(&mut out, view("a job handle cannot be shared"));
                                        } else if code == 12 {
                                            dput(&mut out, view("a closure whose type does not say what it captured (write `Fn<Send>(..)` or `Fn<Share>(..)` where the type is written)"));
                                        } else if code == 13 {
                                            dput(&mut out, view("an FnMut closure, which cannot be shared"));
                                        } else if code == 14 {
                                            dput(&mut out, view("an interface object whose type does not say what the value behind it may do (write `dyn<Send> I` or `dyn<Share> I`)"));
                                        } else {
                                            dput(&mut out, view("a type that nests too deeply to classify"));
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return ();
}
// `cannot transfer parallel_map item: file is thread-affine`, or for a named subject
// `cannot share closure capture `h`: h.file is thread-affine`. `name` is empty for a value that has
// no name in the diagnostic (an item or a result type).
fn capability_fail<a, b, d>(c: (&a mut C), shared: u64, subject: &b [u8], name: &d [u8]) -> unit {
    mut msg = u8[];
    dput(&mut msg, view("cannot "));
    if shared != 0 {
        dput(&mut msg, view("share "));
    } else {
        dput(&mut msg, view("transfer "));
    }
    dput(&mut msg, subject);
    if name.len() != 0 {
        // `closure capture `a`: a.file is thread-affine`. Only the adjective denials take `is`; the
        // ones that are already a clause (`a mutable slice or view cannot be shared`) read as a
        // sentence after the backticked name, which is where the name belongs.
        dput(&mut msg, view(" `"));
        dput(&mut msg, name);
        dput(&mut msg, view("`: "));
        if cap_denial_adjective(c.cap_denial) != 0 {
            dput(&mut msg, name);
            if c.cap_segs.len() != 0 {
                dput(&mut msg, view("."));
                dotted_path(&mut c, &mut msg);
            }
            dput(&mut msg, view(" is "));
        }
    } else {
        // `parallel_map item: file is thread-affine`
        dput(&mut msg, view(": "));
        if c.cap_segs.len() != 0 {
            dotted_path(&mut c, &mut msg);
            dput(&mut msg, view(" is "));
        }
    }
    cap_denial_text(&mut c, &mut msg);
    fail(&mut c, view(msg));
}
// A violated `Send`/`Share` bound names the type that violates it and why: an instantiation of a
// generic on a handle is where a caller could otherwise launder an unshareable type through it, so
// the refusal has to say which type and which audited classification refused it.
fn bound_fail<a, b>(c: (&a mut C), ty: u64, bound: &b [u8]) -> unit {
    mut msg = u8[];
    push_bytes(&mut msg, view("type does not satisfy "));
    push_bytes(&mut msg, view(bound));
    push_bytes(&mut msg, view(": "));
    name := source_type_name(&mut c, ty);
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view(" is "));
    cap_denial_text(&mut c, &mut msg);
    fail(&mut c, view(msg));
    return ();
}
// A type in the interface format's own spelling: a nominal type by `module::name`, anything else in
// the format's syntax. A message about a type the *author* wrote wants `source_type_name` instead -
// it spells `u8`, `f32`, `u8[]`, `&T`, and an own-module record without its module, and it falls back
// to this - so this one is for the places where the interface format is itself the subject (the
// round-trip refusal) and for the fallback.
fn type_name<a>(c: (&a mut C), ty: u64) -> u8[] {
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    mut out = u8[];
    // f32 and f64 are one store kind told apart by the width, the way `iface_type_raw` tells them
    // apart, so the plain-word arm below must not answer for the kind alone.
    if (k == 21) & (arg == 32) {
        push_bytes(&mut out, view("f32"));
        return out;
    }
    if (k == 8) || (k == 23) || (k == 28) {
        mut module = c.decls[arg].module.copy();
        mut name = c.decls[arg].name.copy();
        push_bytes(&mut out, view(module));
        push_bytes(&mut out, view("::"));
        push_bytes(&mut out, view(name));
        return out;
    }
    if (k == 1) || (k == 2) || (k == 3) || (k == 4) || (k == 17) || (k == 19) || (k == 21) || (k == 22)
        || (k == 24) {
        push_bytes(&mut out, view(iface_plain_word(k)));
        return out;
    }
    if k == 36 {
        push_bytes(&mut out, view(simd_shape(&mut c, ty)));
        return out;
    }
    if k == 11 {
        push_bytes(&mut out, view("Atomic<"));
        push_bytes(&mut out, view(type_name(&mut c, arg)));
        push_bytes(&mut out, view(">"));
        return out;
    }
    if k == 8 {
        d := ty_arg(&mut c, ty);
        if same(view(c.decls[d].module), view(".outcome")) {
            if same(view(c.decls[d].name), view("Failure")) {
                push_bytes(&mut out, view("TaskFailure"));
                return out;
            }
            args := type_args(&mut c, ty);
            if args.len() == 2 {
                push_bytes(&mut out, view(type_name(&mut c, args[0])));
                push_bytes(&mut out, view(" |? TaskFailure"));
                return out;
            }
        }
    }
    // Only a type the interface format can spell is handed to the writer: naming a type for a
    // diagnostic must not be able to fail where the diagnostic itself is the point.
    if iface_spellable(&mut c, ty) {
        iface_type_raw(&mut out, &mut c, ty);
        return out;
    }
    push_bytes(&mut out, view("a value of store kind "));
    decimal(&mut out, k);
    push_bytes(&mut out, view(" (this compiler cannot spell it)"));
    return out;
}
fn require_constraints<a, b, d>(c: (&a mut C), arguments: (&b u64[]), bounds: (&d u64[])) -> unit {
    if arguments.len() != bounds.len() {
        fail(&mut c, view("generic constraint arity"));
    }
    for i in bounds.len() {
        mask := bounds[i];
        ty := arguments[i];
        if (mask & 1) != 0 {
            mut trail = u64[];
            if transfer_capability(&mut c, ty, 0, &mut trail, 0) == 0 {
                bound_fail(&mut c, ty, view("Send"));
            }
        }
        if (mask & 2) != 0 {
            mut trail = u64[];
            if transfer_capability(&mut c, ty, 1, &mut trail, 0) == 0 {
                bound_fail(&mut c, ty, view("Share"));
            }
        }
        // `Owned` (bit 8; bit 4 marks a value parameter, whose upper bits are its type): the type
        // holds no borrow, and every type parameter inside it is itself known to be `Owned`.
        if ((mask & 4) == 0) & ((mask & 8) != 0) {
            mut trail = u64[];
            if !owned_walk(&mut c, ty, &mut trail) {
                mut msg = copy_bytes(view("type does not satisfy Owned: "));
                push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
                if contains_borrow(&mut c, ty, 0) {
                    push_bytes(&mut msg, view(" holds a borrow"));
                } else if may_hide_borrow(&mut c, ty) {
                    push_bytes(&mut msg, view(" holds a closure whose type does not say it is `Owned`, so it may hold a borrow"));
                } else {
                    push_bytes(&mut msg, view(" has a type parameter that is not known to be `Owned`"));
                }
                fail(&mut c, view(msg));
            }
        }
    }
    return ();
}
// Whether a type is known to hold no borrow: no reference, view or slice, no closure that borrows,
// and no type parameter without an `Owned` proof (bit 8 of its bounds).
fn owned_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> bool {
    if contains_borrow(&mut c, ty, 0) {
        return false;
    }
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if k == 9 {
        bits := ty_mode(&mut c, ty);
        return ((bits & 4) != 0) || ((bits & 8) != 0);
    }
    if (k == 30) || (k == 33) {
        return k == 33;
    }
    if (k == 10) || (k == 6) || (k == 13) || (k == 16) || (k == 29) || (k == 28) {
        return owned_walk(&mut c, arg, &mut trail);
    }
    if k == 20 {
        // A closure is `Owned` when its type says so, or - a closure expression - when every
        // borrow it captured is named in its type. A bare `Fn(..)` field says nothing, so a record
        // holding one (an `Iter<T>`) is not `Owned`: its hidden borrows travel by loan flow and
        // cannot cross a lifetime boundary (docs/design/closure-bounds.md, 6.1).
        mode := ty_mode(&mut c, ty);
        if (mode & CLOSURE_UNBUILT) == 0 {
            if ty_env(&mut c, ty) == 0 {
                if (mode & CLOSURE_OWNED) == 0 {
                    return false;
                }
            } else if closure_hidden_regions(&mut c, ty).len() != 0 {
                return false;
            }
        }
        if !owned_walk(&mut c, arg, &mut trail) {
            return false;
        }
    }
    if (k == 8) || (k == 20) || (k == 12) {
        for i in trail.len() {
            if trail[i] == ty {
                return true;
            }
        }
        trail.push(ty);
        if k == 8 {
            count := c.decls[arg].count;
            for i in count {
                t := field_type(&mut c, ty, i);
                if !owned_walk(&mut c, t, &mut trail) {
                    trail.pop()!;
                    return false;
                }
            }
        }
        trail.pop()!;
    }
    return true;
}
// Forward declarations are optimistically incomplete while collecting headers. Recheck
// every instantiated nominal type after all layouts are known, before generating bodies.
fn validate_type_constraints<a>(c: (&a mut C)) -> unit {
    mut i = 0;
    while i < c.types.len() {
        if ty_kind(&mut c, i) == 8 {
            decl := ty_arg(&mut c, i);
            arguments := type_args(&mut c, i);
            require_constraints(&mut c, &arguments, &declaration_bounds(&c, decl));
            require_interfaces(&mut c, &arguments, &declaration_constraints(&c, decl));
        }
        i += 1;
    }
    return ();
}
fn function_bounds<a>(c: (&a C), index: u64) -> u64[] {
    f := &c.funcs[index];
    return copy_numbers(&f.bounds);
}
fn declaration_bounds<a>(c: (&a C), index: u64) -> u64[] {
    d := &c.decls[index];
    return copy_numbers(&d.bounds);
}
fn copy_constraints<a>(input: (&a u64[][])) -> u64[][] {
    mut out = u64[][];
    for i in input.len() {
        out.push(copy_numbers(&input[i]));
    }
    return out;
}
fn function_constraints<a>(c: (&a C), index: u64) -> u64[][] {
    f := &c.funcs[index];
    return copy_constraints(&f.constraints);
}
fn declaration_constraints<a>(c: (&a C), index: u64) -> u64[][] {
    d := &c.decls[index];
    return copy_constraints(&d.constraints);
}
fn find_interface<a, b, d>(c: (&a C), module: &b [u8], name: &d [u8]) -> u64 {
    for i in c.interfaces.len() {
        item := &c.interfaces[i];
        if same(view(item.module), view(module)) & same(view(item.name), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
fn resolve_import<a, b>(c: (&a mut C), n: &b [u8]) -> u8[] {
    mut found = 0;
    mut module = u8[];
    for i in c.imports.len() {
        im_name := c.imports[i].name.copy();
        im_module := c.imports[i].module.copy();
        if same(view(im_name), view(n)) {
            found += 1;
            module = im_module;
        }
    }
    if found > 1 {
        fail(&mut c, view("ambiguous imported name"));
    }
    return module;
}
// An interface (a set of methods a type implements) is private to its module unless declared
// `pub`, like any other item: naming it in a bound, an `impl` or a call from elsewhere is refused.
fn interface_visible<a>(c: (&a mut C), id: u64) -> unit {
    if (id == 0) || (c.interfaces[id - 1].public != 0) || (c.interfaces[id - 1].defined == 0) {
        return ();
    }
    home := c.interfaces[id - 1].module.copy();
    // stays: `c.interfaces[id - 1]` is a borrowed element (see drop_hook_symbol).
    name := c.interfaces[id - 1].name.copy();
    require_visible(&mut c, view(home), view(name));
    return ();
}
fn ensure_interface<a>(c: (&a mut C), module: u8[], name: u8[]) -> u64 {
    existing := find_interface(&c, view(module), view(name));
    if existing != 0 {
        return existing;
    }
    c
        .interfaces
        .push(
            Interface {
                module: module,
                name: name,
                public: 1,
                defined: 0,
                methods: u64[],
                defaults: u64[],
                default_files: u64[],
                assoc: u8[][],
                assoc_bounds: u64[][],
                supers: u64[],
            }
        );
    return c.interfaces.len();
}
// ---- the built-in `Drop` interface --------------------------------------------------------------
// `impl Drop for T { fn drop(self: &mut T) { ... } }` states what a value's storage holds that its
// fields do not describe, and the compiler calls it from the drop helper it already generates for T,
// before the fields are released. The interface is built here instead of being declared in a source
// module, so every program has it without an import; it is registered before any source is parsed,
// so its id and its method's function index are the same in every run, and an interface file that
// spells it `.builtin::Drop` reads back as this one.
fn builtin_drop_interface<a>(c: (&a mut C)) -> unit {
    id := ensure_interface(&mut c, copy_bytes(view(".builtin")), copy_bytes(view("Drop")));
    // `fn drop(self: &mut Self) -> unit;` - Self is the interface's own type parameter (kind 9,
    // argument 0) carrying the proof that it implements Drop, exactly as `interface_declaration`
    // builds it, so an implementation's `fn drop(self: &mut T)` checks against it unchanged.
    proof := intern(&mut c, 15, id);
    mut proofs = u64[];
    proofs.push(proof);
    self := intern_args(&mut c, 9, 0, 0, u64[], proofs);
    region := fresh_lifetime(&mut c);
    mut rs = u64[];
    rs.push(region);
    receiver := intern_full(&mut c, 7, self, 1, rs);
    // The lifetime was allocated only to give the receiver a region: the run's region table starts
    // empty when the first module is parsed.
    exchange(&mut c.rnames, u8[][]);
    first := c.params.len();
    c.params.push(receiver);
    method_module := private_module(view(".interface_"), id);
    mut bounds = u64[0];
    mut requirements = u64[][];
    requirements.push(u64[id]);
    exchange(&mut c.drop_iface, id);
    c
        .funcs
        .push(
            Func {
                module: method_module,
                name: copy_bytes(view("drop")),
                public: 1,
                home: copy_bytes(view(".builtin")),
                first: first,
                count: 1,
                ret: 1,
                types: 1,
                regions: 1,
                file: 0,
                pos: 0,
                raw: 0,
                unsafe_fn: 0,
                bounds: bounds,
                constraints: requirements,
                contract: id,
                owner: 0,
                ext: 0,
                symbol: u8[],
                body: u8[],
                ppreds: Pred[],
                rpred: no_pred(),
                pnames: u8[][],
                pdefaults: Pred[],
                strict: 0,
                no_alloc: 0,
                no_panic: 0,
            }
        );
    index := c.funcs.len() - 1;
    item := &mut c.interfaces[id - 1];
    exchange(&mut item.defined, 1);
    exchange(&mut item.public, 1);
    item.methods.push(index);
    item.defaults.push(0);
    item.default_files.push(0);
    return ();
}
fn base_type<a>(c: (&a mut C), ty: u64) -> u64 {
    mut out = ty;
    while ty_kind(&mut c, out) == 10 {
        out = ty_arg(&mut c, out);
    }
    return out;
}
fn find_implementation<a>(c: (&a mut C), contract: u64, ty: u64) -> u64 {
    actual := base_type(&mut c, ty);
    for i in c.implementations.len() {
        item := &c.implementations[i];
        id := item.contract;
        other := item.ty;
        if id == contract {
            if same_type(&mut c, actual, other) != 0 {
                return i + 1;
            }
            // `impl<T: B> I for X<T>` answers for every X<U> with U satisfying B.
            if impl_record(&mut c, generic_impl_key(i + 1)) != 0 {
                bindings := impl_bindings(&mut c, i + 1, actual);
                if bindings.len() != 0 {
                    return i + 1;
                }
            }
        }
    }
    return 0;
}
// The implementation's parameters bound so its type is `actual`, with their bounds met; empty when
// it does not match (or is not generic).
fn impl_bindings<a>(c: (&a mut C), id: u64, actual: u64) -> u64[] {
    r := impl_record(&mut c, generic_impl_key(id));
    if r == 0 {
        return u64[];
    }
    count := c.impl_params[r - 1].tnames.len();
    pattern := c.implementations[id - 1].ty;
    mut map = u64[];
    for i in count {
        map.push(NO_TYPE);
    }
    if !type_matches(&mut c, pattern, actual, &mut map) {
        return u64[];
    }
    sets := copy_constraints(&c.impl_params[r - 1].interfaces);
    infer_from_callables(&mut c, &sets, &mut map);
    for i in count {
        if map[i] == NO_TYPE {
            return u64[];
        }
        if i < sets.len() {
            for k in sets[i].len() {
                bound := map[i];
                if !meets_requirement(&mut c, bound, sets[i][k], &map) {
                    return u64[];
                }
            }
        }
    }
    return map;
}
// Structural match of an implementation's type, whose parameters are type parameters, against a
// type; binds the parameters in `map`.
fn type_matches<a, b>(c: (&a mut C), pattern: u64, actual: u64, map: (&b mut u64[])) -> bool {
    pk := ty_kind(&mut c, pattern);
    if pk == 9 {
        i := ty_arg(&mut c, pattern);
        if map.len() <= i {
            return false;
        }
        if map[i] == NO_TYPE {
            exchange(&mut map[i], actual);
            return true;
        }
        old := map[i];
        return same_type(&mut c, old, actual) != 0;
    }
    if same_type(&mut c, pattern, actual) != 0 {
        return true;
    }
    a := base_type(&mut c, actual);
    if pk != ty_kind(&mut c, a) {
        return false;
    }
    if (pk == 6) || (pk == 7) || (pk == 27) || (pk == 13) || (pk == 14) || (pk == 16) || (pk == 29) {
        if ty_mode(&mut c, pattern) != ty_mode(&mut c, a) {
            return false;
        }
        pa := ty_arg(&mut c, pattern);
        aa := ty_arg(&mut c, a);
        return type_matches(&mut c, pa, aa, &mut map);
    }
    if pk == 8 {
        if ty_arg(&mut c, pattern) != ty_arg(&mut c, a) {
            return false;
        }
        pargs := type_args(&mut c, pattern);
        aargs := type_args(&mut c, a);
        if pargs.len() != aargs.len() {
            return false;
        }
        for k in pargs.len() {
            if !type_matches(&mut c, pargs[k], aargs[k], &mut map) {
                return false;
            }
        }
        return true;
    }
    return false;
}
// The symbol an interface method resolves to for `ty`: the method itself, or - in a generic
// implementation - its specialisation for the bindings that make the implementation fit `ty`.
fn interface_symbol<a, b>(c: (&a mut C), contract: u64, ty: u64, actual: u64, own: (&b u64[])) -> u8[] {
    if c.funcs[actual].types == 0 {
        return c.funcs[actual].name.copy();
    }
    implementation := find_implementation(&mut c, contract, ty);
    base := base_type(&mut c, ty);
    // The implementation's parameters (when it is generic), then the method's own.
    mut bindings = impl_bindings(&mut c, implementation, base);
    for k in own.len() {
        bindings.push(own[k]);
    }
    index := specialize(&mut c, actual, &bindings);
    return special_name(&mut c, index);
}
// The implementation's parameters as type parameters (kind 9), in order: the identity binding.
fn impl_param_types<a>(c: (&a mut C), id: u64) -> u64[] {
    r := impl_record(&mut c, generic_impl_key(id));
    mut out = u64[];
    if r == 0 {
        return out;
    }
    count := c.impl_params[r - 1].tnames.len();
    bounds := copy_numbers(&c.impl_params[r - 1].bounds);
    sets := copy_constraints(&c.impl_params[r - 1].interfaces);
    for i in count {
        mut proofs = u64[];
        if i < sets.len() {
            for k in sets[i].len() {
                if sets[i][k] < CALLABLE_BOUND {
                    proof := intern(&mut c, 15, sets[i][k]);
                    proofs.push(proof);
                } else if sets[i][k] < CALLABLE_PENDING {
                    // The same parameter type a name resolves to (it carries its callable bound).
                    proofs.push(sets[i][k] - CALLABLE_BOUND);
                }
            }
        }
        mut bound = 0;
        if i < bounds.len() {
            bound = bounds[i];
        }
        t := intern_args(&mut c, 9, i, bound, u64[], proofs);
        out.push(t);
    }
    return out;
}
// ---- interface inheritance --------------------------------------------------------------------------
// `interface B: A` (Rust's supertraits): implementing B requires implementing A, and anything known to
// implement B - a bound `T: B`, a `dyn B` - implements A too. `all_supers` is the transitive set.
fn all_supers<a>(c: (&a mut C), id: u64) -> u64[] {
    mut out = u64[];
    mut todo = copy_numbers(&c.interfaces[id - 1].supers);
    while todo.len() != 0 {
        s := todo.pop()!;
        mut seen = s == id;
        for i in out.len() {
            if out[i] == s {
                seen = true;
            }
        }
        if !seen {
            out.push(s);
            more := copy_numbers(&c.interfaces[s - 1].supers);
            for j in more.len() {
                todo.push(more[j]);
            }
        }
    }
    return out;
}
// Whether `id` is `contract` or extends it.
fn interface_implies<a>(c: (&a mut C), id: u64, contract: u64) -> bool {
    if id == contract {
        return true;
    }
    supers := all_supers(&mut c, id);
    for i in supers.len() {
        if supers[i] == contract {
            return true;
        }
    }
    return false;
}
// The interface an interface method belongs to (its module is `.interface_N`).
fn interface_of_method<a>(c: (&a mut C), index: u64) -> u64 {
    for i in c.interfaces.len() {
        methods := copy_numbers(&c.interfaces[i].methods);
        for j in methods.len() {
            if methods[j] == index {
                return i + 1;
            }
        }
    }
    return 0;
}
// A dyn object's methods in vtable order: the interface's own, then each super's (all_supers order).
fn dyn_methods<a>(c: (&a mut C), id: u64) -> u64[] {
    mut out = copy_numbers(&c.interfaces[id - 1].methods);
    supers := all_supers(&mut c, id);
    for i in supers.len() {
        more := copy_numbers(&c.interfaces[supers[i] - 1].methods);
        for j in more.len() {
            out.push(more[j]);
        }
    }
    return out;
}
fn satisfies_interface<a>(c: (&a mut C), ty: u64, contract: u64) -> bool {
    actual := base_type(&mut c, ty);
    // `T::Item` where the interface says `type Item: B;`.
    if ty_kind(&mut c, actual) == 30 {
        mode := ty_mode(&mut c, actual);
        owner := mode / 1024;
        j := mode % 1024;
        if j < c.interfaces[owner - 1].assoc_bounds.len() {
            bounds := copy_numbers(&c.interfaces[owner - 1].assoc_bounds[j]);
            for i in bounds.len() {
                if interface_implies(&mut c, bounds[i], contract) {
                    return true;
                }
            }
        }
        return false;
    }
    if (ty_kind(&mut c, actual) == 33) || (ty_kind(&mut c, actual) == 35) {
        // An owned object and a borrowed one both satisfy the interface they name.
        mut object = ty_arg(&mut c, actual);
        if ty_kind(&mut c, actual) == 35 {
            object = ty_arg(&mut c, object);
        }
        return interface_implies(&mut c, object, contract);
    }
    if ty_kind(&mut c, actual) == 9 {
        proofs := type_args(&mut c, actual);
        for i in proofs.len() {
            p := proofs[i];
            if ty_kind(&mut c, p) == 15 {
                bound := ty_arg(&mut c, p);
                if interface_implies(&mut c, bound, contract) {
                    return true;
                }
            }
        }
        return false;
    }
    if c.headers_complete == 0 {
        return true;
    }
    return find_implementation(&mut c, contract, actual) != 0;
}
fn require_interfaces<a, b, d>(c: (&a mut C), arguments: (&b u64[]), sets: (&d u64[][])) -> unit {
    if arguments.len() != sets.len() {
        fail(&mut c, view("interface constraint arity"));
    }
    for i in sets.len() {
        ty := arguments[i];
        set := &sets[i];
        for j in set.len() {
            id := set[j];
            if CALLABLE_PENDING <= id {
                continue;
            }
            if CALLABLE_BOUND <= id {
                // The argument is the closure (or function) a callable-bound parameter was given:
                // its own type must convert to the bound, with the call's type arguments in it.
                // Compared without a specialisation's aliases: the closure's own signature names the
                // plain types its bindings stand for.
                mut plain_args = u64[];
                for q in arguments.len() {
                    if arguments[q] == NO_TYPE {
                        plain_args.push(NO_TYPE);
                    } else {
                        plain_args.push(base_type(&mut c, arguments[q]));
                    }
                }
                bound := bind_types(&mut c, id - CALLABLE_BOUND, &plain_args);
                // A callable parameter passed on (`f: F` given to another `G: FnMut(..)`): its own
                // bound must meet this one.
                mut given = base_type(&mut c, ty);
                own := param_callable(&mut c, ty);
                if (own != NO_TYPE) && (ty_kind(&mut c, base_type(&mut c, ty)) == 9) {
                    given = own;
                }
                // A closure written inside a specialisation is typed by its aliases, one passed in
                // from outside by plain types: either form of the bound is met.
                aliased := bind_types(&mut c, id - CALLABLE_BOUND, &arguments);
                tied := callable_tied_param(&mut c, given, bound);
                if tied != 0 {
                    mut msg = copy_bytes(view("this argument does not meet the callable bound `"));
                    push_bytes(&mut msg, view(source_type_name(&mut c, bound)));
                    push_bytes(&mut msg, view("`: its parameter "));
                    decimal(&mut msg, tied);
                    push_bytes(&mut msg, view(" is a reference the bound gives it fresh on every call, but its lifetime is tied to another parameter, its result or a capture, so it could be kept past the call"));
                    fail(&mut c, view(msg));
                }
                if (same_type(&mut c, given, bound) == 0) && (closure_converts(&mut c, given, bound) == 0)
                    && (same_type(&mut c, given, aliased) == 0) && (closure_converts(&mut c, given, aliased) == 0) {
                    if !((ty_kind(&mut c, given) == 12) && (ty_kind(&mut c, bound) == 20)) {
                        mut msg = copy_bytes(view("this argument does not meet the callable bound `"));
                        push_bytes(&mut msg, view(source_type_name(&mut c, bound)));
                        push_bytes(&mut msg, view("`: it is `"));
                        push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
                        push_bytes(&mut msg, view("`"));
                        fail(&mut c, view(msg));
                    }
                }
                continue;
            }
            if !satisfies_interface(&mut c, ty, id) {
                // Name the bound and the type that fails it: "does not satisfy interface bound" alone
                // sends the reader looking for the wrong declaration.
                mut msg = u8[];
                push_bytes(&mut msg, view("type does not satisfy interface bound `"));
                if id <= c.interfaces.len() {
                    push_bytes(&mut msg, view(c.interfaces[id - 1].module));
                    push_bytes(&mut msg, view("::"));
                    push_bytes(&mut msg, view(c.interfaces[id - 1].name));
                }
                push_bytes(&mut msg, view("` (argument type kind "));
                decimal(&mut msg, ty_kind(&mut c, ty));
                push_bytes(&mut msg, view(", in module "));
                push_bytes(&mut msg, view(c.module));
                push_bytes(&mut msg, view(")"));
                fail(&mut c, view(msg));
            }
        }
    }
    return ();
}
fn private_module<a>(prefix: &a [u8], id: u64) -> u8[] {
    mut out = prefix.copy();
    decimal(&mut out, id);
    return out;
}
fn region_id<a>(c: (&a mut C)) -> u64 {
    n := ident(&mut c);
    for i in c.rnames.len() {
        mut r = &c.rnames[i];
        if same(view(r), view(n)) {
            return i + 1;
        }
    }
    fail(&mut c, view("undeclared lifetime"));
    return 0;
}
fn lifetime_parameters<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.assoc_eqs, u64[]);
    exchange(&mut c.rnames, u8[][]);
    exchange(&mut c.tnames, u8[][]);
    exchange(&mut c.type_bounds, u64[]);
    exchange(&mut c.type_interfaces, u64[][]);
    if eat(&mut c, view("<")) {
        while true {
            if eat(&mut c, view("@")) {
                // A value parameter (docs/design/comptime.md, C2): `@k: u64` in the generic list. It
                // is a type parameter whose binding is a type-level constant, so specialisation,
                // naming and interfaces handle it with no second mechanism; bounds bit 4 marks it
                // and the bits above carry its declared type.
                n := ident(&mut c);
                for i in c.tnames.len() {
                    if same(view(c.tnames[i]), view(n)) {
                        fail(&mut c, view("duplicate generic parameter"));
                    }
                }
                expect(&mut c, view(":"));
                vty := parse_type(&mut c);
                if !integer(&mut c, vty) & !is_bool(&mut c, vty) {
                    fail(&mut c, view("a value parameter is an integer or a bool"));
                }
                c.tnames.push(n);
                c.type_bounds.push(4 + 8 * vty);
                c.type_interfaces.push(u64[]);
                if eat(&mut c, view(">")) {
                    break;
                }
                expect(&mut c, view(","));
                continue;
            }
            n := ident(&mut c);
            is_type := (64 < n[0]) & (n[0] < 91);
            if is_type {
                for i in c.tnames.len() {
                    t := &c.tnames[i];
                    if same(view(t), view(n)) {
                        fail(&mut c, view("duplicate type parameter"));
                    }
                }
                mut bounds = 0;
                mut requirements = u64[];
                if eat(&mut c, view(":")) {
                    while true {
                        // `F: FnMut(T) -> U`: a callable bound, the closure type it names.
                        if (is(&mut c, view("Fn")) || is(&mut c, view("FnMut"))) && ((kind_at(&mut c, c.pos + 1) == 40) || (kind_at(&mut c, c.pos + 1) == 60)) {
                            // Read once the whole parameter scope exists (an impl's `T` is added
                            // after a method's own list): only its position is kept here.
                            for q in requirements.len() {
                                if CALLABLE_BOUND <= requirements[q] {
                                    fail(&mut c, view("a type parameter has at most one callable bound"));
                                }
                            }
                            requirements.push(CALLABLE_PENDING + c.pos);
                            skip_callable_bound(&mut c);
                            if !eat(&mut c, view("+")) {
                                break;
                            }
                            continue;
                        }
                        constraint := ident(&mut c);
                        mut bit = 0;
                        if same(view(constraint), view("Send")) & !is(&mut c, view("::")) {
                            bit = 1;
                        }
                        if same(view(constraint), view("Share")) & !is(&mut c, view("::")) {
                            bit = 2;
                        }
                        if same(view(constraint), view("Owned")) & !is(&mut c, view("::")) {
                            bit = 8;
                        }
                        if bit == 0 {
                            mut m = module_copy(&mut c);
                            mut n = constraint.copy();
                            mut qualified = 0;
                            if eat(&mut c, view("::")) {
                                qualified = 1;
                                m = constraint.copy();
                                n = ident(&mut c);
                            }
                            if qualified == 0 {
                                imported := resolve_import(&mut c, view(n));
                                if imported.len() != 0 {
                                    m = imported;
                                }
                            }
                            id := ensure_interface(&mut c, m, n);
                            interface_visible(&mut c, id);
                            for i in requirements.len() {
                                if requirements[i] == id {
                                    fail(&mut c, view("duplicate interface constraint"));
                                }
                            }
                            requirements.push(id);
                            // `Source<Item = u64>`: the bound fixes associated types.
                            if eat(&mut c, view("<")) {
                                while true {
                                    assoc_name := ident(&mut c);
                                    expect(&mut c, view("="));
                                    fixed := parse_type(&mut c);
                                    assoc := copy_names(&c.interfaces[id - 1].assoc);
                                    mut index = 18446744073709551615;
                                    for j in assoc.len() {
                                        if same(view(assoc[j]), view(assoc_name)) {
                                            index = j;
                                        }
                                    }
                                    // Before every interface's first pass (a signature read while
                                    // declarations are still being collected) the names are not known
                                    // yet; the signature is read again once they are.
                                    if (index == 18446744073709551615) && (c.interfaces[id - 1].defined != 0) {
                                        fail(&mut c, view("the interface has no associated type of that name"));
                                    }
                                    if index != 18446744073709551615 {
                                        param := c.tnames.len();
                                        c.assoc_eqs.push(param);
                                        c.assoc_eqs.push(id * 1024 + index);
                                        c.assoc_eqs.push(fixed);
                                    }
                                    if eat(&mut c, view(">")) {
                                        break;
                                    }
                                    expect(&mut c, view(","));
                                }
                            }
                        } else {
                            if (bounds & bit) != 0 {
                                fail(&mut c, view("duplicate structural constraint"));
                            }
                            bounds += bit;
                        }
                        if !eat(&mut c, view("+")) {
                            break;
                        }
                    }
                }
                c.tnames.push(n);
                c.type_bounds.push(bounds);
                c.type_interfaces.push(requirements);
            } else {
                if c.tnames.len() != 0 {
                    fail(&mut c, view("lifetimes must precede type parameters"));
                }
                for i in c.rnames.len() {
                    mut r = &c.rnames[i];
                    if same(view(r), view(n)) {
                        fail(&mut c, view("duplicate lifetime"));
                    }
                }
                c.rnames.push(n);
            }
            if eat(&mut c, view(">")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    return ();
}
// A value argument of a record type (`8` in `Ring<u64, 8>`): a value parameter in scope stands
// for its binding (or, in a template, for itself), anything else is a compile-time constant.
fn type_level_value<a>(c: (&a mut C)) -> u64 {
    if kind(&mut c) == 1 {
        name_text := tok_text(&mut c, c.pos);
        vp := value_param(&mut c, view(name_text));
        if vp != 0 {
            advance(&mut c);
            i := vp - 1;
            if c.bindings.len() != 0 {
                return c.bindings[i];
            }
            return intern_args(&mut c, 9, i, c.type_bounds[i], u64[], u64[]);
        }
    }
    v := ct_expr(&mut c, prec(62));
    if v.ty == ct_tag_ty() {
        fail(&mut c, view("a value argument is an integer or a bool, not a target tag"));
    }
    return intern(&mut c, 31, v.value);
}
fn nominal_type<a>(c: (&a mut C), d: u64) -> u64 {
    // An opaque handle is one word with no layout: it cannot be constructed,
    // inspected or dropped, only produced by C and handed back to C.
    if c.decls[d].opaque != 0 {
        return intern(&mut c, 23, d);
    }
    decl := &c.decls[d];
    count := decl.regions;
    types := decl.types;
    mut rs = u64[];
    mut args = u64[];
    if (count + types) != 0 {
        expect(&mut c, view("<"));
        for i in count + types {
            if i != 0 {
                expect(&mut c, view(","));
            }
            if i < count {
                mut r = region_id(&mut c);
                rs.push(r);
            } else {
                j := i - count;
                record_bounds := declaration_bounds(&c, d);
                if (j < record_bounds.len()) && ((record_bounds[j] & 4) != 0) {
                    args.push(type_level_value(&mut c));
                } else {
                    t := parse_type(&mut c);
                    args.push(t);
                }
            }
        }
        expect(&mut c, view(">"));
    }
    require_constraints(&mut c, &args, &declaration_bounds(&c, d));
    require_interfaces(&mut c, &args, &declaration_constraints(&c, d));
    return intern_args(&mut c, 8, d, 0, rs, args);
}
fn ty_kind<a>(c: (&a mut C), ty: u64) -> u64 {
    if !is_type_id(ty) {
        fail(&mut c, view("internal: no type where one is required"));
    }
    t := &c.types[ty];
    return t.kind;
}
fn ty_arg<a>(c: (&a mut C), ty: u64) -> u64 {
    if !is_type_id(ty) {
        fail(&mut c, view("internal: no type where one is required"));
    }
    t := &c.types[ty];
    return t.arg;
}
fn ty_mode<a>(c: (&a mut C), ty: u64) -> u64 {
    if !is_type_id(ty) {
        fail(&mut c, view("internal: no type where one is required"));
    }
    t := &c.types[ty];
    return t.mode;
}
fn type_regions<a>(c: (&a mut C), ty: u64) -> u64[] {
    mut rs = u64[];
    if !is_type_id(ty) {
        fail(&mut c, view("internal: no type where one is required"));
    }
    t := &c.types[ty];
    for i in t.regions.len() {
        rs.push(t.regions[i]);
    }
    return rs;
}
fn substitute<a, b>(c: (&a mut C), ty: u64, map: (&b u64[])) -> u64 {
    k := ty_kind(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    mut arg = ty_arg(&mut c, ty);
    mut rs = type_regions(&mut c, ty);
    if (k == 6) || (k == 27) || (k == 28) || (k == 7) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) || (k == 29) || (k == 35) {
        arg = substitute(&mut c, arg, &map);
    }
    for i in rs.len() {
        mut r = rs[i];
        if r != 0 {
            if map.len() < r {
                fail(&mut c, view("unbound stored lifetime"));
            }
            n := map[r - 1];
            exchange(&mut rs[i], n);
        }
    }
    mut args = type_args(&mut c, ty);
    for i in args.len() {
        t := args[i];
        mut v = substitute(&mut c, t, &map);
        exchange(&mut args[i], v);
    }
    env := ty_env(&mut c, ty);
    return intern_env(&mut c, k, arg, mode, rs, args, env);
}
// ---- interface objects (`dyn I`) ---------------------------------------------------------------------
// Rust's trait objects, owned: a `dyn I` is one word, a heap cell {value, vtable}. A value of a type
// implementing I becomes one where a `dyn I` is expected (dyn_box); a method called on it loads its
// entry from the vtable (emit_resolved_call); dropping it drops the value through the vtable and
// frees the cell. `&dyn I` and `&mut dyn I` are ordinary references to such a value.
fn dyn_box<a>(c: (&a mut C), v: Val, expected: u64) -> Val {
    id := ty_arg(&mut c, expected);
    concrete := base_type(&mut c, v.ty);
    kind := ty_kind(&mut c, concrete);
    if (kind == 9) || (kind == 30) {
        fail(&mut c, view("a dyn value needs a concrete type, not a type parameter"));
    }
    if find_implementation(&mut c, id, concrete) == 0 {
        fail(&mut c, view("this type does not implement the interface the dyn type names"));
    }
    // The type, or - for a value whose type cannot show a borrow it holds (a record with a closure
    // field) - the value itself: a `dyn` erases both. `dyn<s> I` may hold borrows: the cell keeps
    // the value's loans and carries `s`, so the region checks follow it.
    borrowing := type_regions(&mut c, expected).len() != 0;
    if !borrowing && (contains_borrow(&mut c, concrete, 0)
        || (may_hide_borrow(&mut c, concrete) && holds_live_loan(&mut c, place_of(&mut c, v.t)))) {
        fail(&mut c, view("a dyn value cannot hold borrowed data: its lifetime would be lost; write `dyn<s> I` to keep the borrow"));
    }
    // The bounds the dyn type states are met by the concrete type, checked here where it is known.
    dyn_bits := ty_mode(&mut c, expected);
    if (dyn_bits & CLOSURE_SEND) != 0 {
        require_capability_named(&mut c, concrete, 0, view("value boxed as `dyn<Send>`"));
    }
    if (dyn_bits & CLOSURE_SHARE) != 0 {
        require_capability_named(&mut c, concrete, 1, view("value boxed as `dyn<Share>`"));
    }
    source_place := place_of(&mut c, v.t);
    fixed := type_args(&mut c, expected);
    for j in fixed.len() {
        given := project(&mut c, concrete, id * 1024 + j);
        if same_type(&mut c, given, fixed[j]) == 0 {
            fail(&mut c, view("this type's associated type is not the one the dyn type fixes"));
        }
    }
    register_vtable(&mut c, id, concrete);
    observe(&mut c, v.t);
    mut value = v.t;
    if framed(&mut c, concrete) {
        value = frame_box(&mut c, v.t, concrete);
    }
    sz := imm(&mut c, 2);
    cell := invoke(&mut c, view("rt_rec"), one(sz));
    rec_store(&mut c, cell, 0, value);
    o(&mut c, view("leaq "));
    vt := cell_vtable_symbol(&mut c, id, concrete);
    push_bytes(&mut c.out, view(vt));
    o(&mut c, view("(%rip),%rax\n"));
    table := save(&mut c);
    rec_store(&mut c, cell, 1, table);
    move_out(&mut c, val(v.t, v.ty));
    own(&mut c, cell, expected);
    if borrowing {
        return_bonds(&mut c, source_place, place_of(&mut c, cell), 1);
    }
    return val(cell, expected);
}
// A `dyn<B> I` value used as `dyn<B'> I` with fewer bounds: the same cell and vtable, so nothing is
// converted. 1 when it may be.
fn dyn_converts<a>(c: (&a mut C), actual: u64, expected: u64) -> u64 {
    if (ty_kind(&mut c, actual) != 33) || (ty_kind(&mut c, expected) != 33) {
        return 0;
    }
    have := ty_mode(&mut c, actual);
    want := ty_mode(&mut c, expected);
    if (want & have) != want {
        return 0;
    }
    if (type_regions(&mut c, actual).len() != 0) && (type_regions(&mut c, expected).len() == 0) {
        return 0;
    }
    plain := intern_args(&mut c, 33, ty_arg(&mut c, actual), want, type_regions(&mut c, expected), type_args(&mut c, actual));
    return same_type(&mut c, plain, expected);
}
// Record the (interface, concrete type) pair whose vtable this program builds; both an owned `dyn I`
// and a `&dyn I` need one.
fn register_vtable<a>(c: (&a mut C), id: u64, concrete: u64) -> unit {
    fn_use(&mut c, FN_VTABLE);
    mut known = false;
    for i in c.vtables.len() / 2 {
        if (c.vtables[2 * i] == id) && (same_type(&mut c, c.vtables[2 * i + 1], concrete) != 0) {
            known = true;
        }
    }
    if !known {
        c.vtables.push(id);
        c.vtables.push(concrete);
        // A generic implementation's methods are specialised for this type now, while
        // specialisations are still being emitted; emit_vtables only names them.
        methods := dyn_methods(&mut c, id);
        for j in methods.len() {
            name := c.funcs[methods[j]].name.copy();
            owner := interface_of_method(&mut c, methods[j]);
            actual := resolve_interface_method(&mut c, owner, concrete, view(name));
            none := u64[];
            interface_symbol(&mut c, owner, concrete, actual, &none);
        }
    }
    return ();
}
// 1 when `ty` is `&dyn I` / `&mut dyn I`: a reference whose referent is the borrowed-object marker.
fn borrowed_object<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) != 7 {
        return 0;
    }
    inner := ty_arg(&mut c, ty);
    return u64(ty_kind(&mut c, inner) == 35);
}
// `&T`, `&mut T` or a reference to an owned `dyn I` where a `&dyn I` is expected: build a `DynPair`
// in two words of the current frame and hand back the handle to it. Nothing here allocates, and the
// object itself never moves or copies - mutation through a `&mut dyn` reaches it.
// The handle borrows what the reference borrowed (bind_loan reborrows it), so the referent cannot
// move or be dropped while the `&dyn` lives.
fn borrow_dyn<a>(c: (&a mut C), v: Val, expected: u64) -> Val {
    if ty_kind(&mut c, v.ty) != 7 {
        fail(&mut c, view("a borrowed interface object needs a reference to a value"));
    }
    mut referent = ty_arg(&mut c, v.ty);
    if ty_kind(&mut c, referent) == 33 {
        return borrow_owned_dyn(&mut c, v, expected);
    }
    want := ty_mode(&mut c, expected);
    have := ty_mode(&mut c, v.ty);
    if (want != 0) & (have == 0) {
        fail(&mut c, view("a shared reference cannot become a `&mut dyn`"));
    }
    marker := ty_arg(&mut c, expected);
    dyn_ty := ty_arg(&mut c, marker);
    id := ty_arg(&mut c, dyn_ty);
    referent = base_type(&mut c, referent);
    kind := ty_kind(&mut c, referent);
    if (kind == 9) || (kind == 30) {
        fail(&mut c, view("a borrowed interface object needs a concrete type, not a type parameter"));
    }
    if find_implementation(&mut c, id, referent) == 0 {
        fail(&mut c, view("this type does not implement the interface the dyn type names"));
    }
    fixed := type_args(&mut c, dyn_ty);
    for j in fixed.len() {
        given := project(&mut c, referent, id * 1024 + j);
        if same_type(&mut c, given, fixed[j]) == 0 {
            fail(&mut c, view("this type's associated type is not the one the dyn type fixes"));
        }
    }
    register_vtable(&mut c, id, referent);
    // Word 0 is the reference's own word - the address the concrete value lives at - stored before
    // anything else is computed, so the value the caller just produced is not reloaded; word 1 is
    // the vtable of the (interface, concrete) pair, a static symbol.
    pair := dyn_pair_slots(&mut c);
    get(&mut c, v.t, view("%rax"));
    dyn_pair_word(&mut c, pair, 0, view("%rax"));
    vt := vtable_symbol(&mut c, id, referent);
    o(&mut c, view("leaq "));
    push_bytes(&mut c.out, view(vt));
    o(&mut c, view("(%rip),%rax\n"));
    dyn_pair_word(&mut c, pair, 1, view("%rax"));
    dyn_pair_handle(&mut c, pair);
    handle := borrow_dyn_handle(&mut c, v, expected);
    return val(handle, expected);
}
// `&d`: an owned object's cell is the data word itself and word 1 is its vtable, so the pair is made
// from the object's own two words rather than from a new concrete type.
fn borrow_owned_dyn<a>(c: (&a mut C), v: Val, expected: u64) -> Val {
    want := ty_mode(&mut c, expected);
    have := ty_mode(&mut c, v.ty);
    if (want != 0) & (have == 0) {
        fail(&mut c, view("a shared reference cannot become a `&mut dyn`"));
    }
    // The reference points at the owned object's word, which is its cell: that cell is word 0 of the
    // pair (an `&T`-shaped data pointer - the cell's address is the address of cell[0], the value)
    // and its vtable is cell[1], at `+8`.
    get(&mut c, v.t, view("%rax"));
    o(&mut c, view("movq (%rax),%r10\nmovq 8(%r10),%rax\n"));
    pair := dyn_pair_of_words(&mut c, view("%r10"), view("%rax"));
    dyn_pair_handle(&mut c, pair);
    handle := borrow_dyn_handle(&mut c, v, expected);
    return val(handle, expected);
}
// A borrowed interface object is a `DynPair` (docs/design/fat-dyn.md): 16 bytes, 8-aligned, word 0 the
// data pointer (an `&T`-shaped word: the address the concrete value lives at) and word 1 its vtable.
// One is built in the borrowing frame and recorded for this function as a typed-IR fact, which is how
// both backends know the two words are one value. Nothing here allocates.
//
// Two adjacent slots, word 0 at the lower address so the handle is word 0's address and word 1 is at
// `+8`. Slot n is `-8(n+1)(%rbp)`, so the second word is allocated first and the first word takes the
// next number.
fn dyn_pair_slots<a>(c: (&a mut C)) -> u64 {
    second := fresh(&mut c);
    first := fresh(&mut c);
    if c.facts_fn.len() != 0 {
        llvm::fact_dyn_pair(&mut c.facts, copy_bytes(view(c.facts_fn)), first);
    }
    return first;
}
// `word` 0 (data) or 1 (the vtable, the slot above word 0) of the pair whose first word is `first`.
fn dyn_pair_word<a, b>(c: (&a mut C), first: u64, word: u64, reg: &b [u8]) -> unit {
    mut slot = first;
    if word != 0 {
        slot = first - 1;
    }
    o(&mut c, view("movq "));
    o(&mut c, reg);
    o(&mut c, view(","));
    stack_slot(&mut c, slot);
    c.out.push(10);
    return ();
}
// Both words already in registers: a returned pair (`%rax`/`%rdx`) or a borrowed owned object
// (`%r10` and its vtable at `8(%r10)`).
fn dyn_pair_of_words<a, b, d>(c: (&a mut C), data: &b [u8], table: &d [u8]) -> u64 {
    first := dyn_pair_slots(&mut c);
    dyn_pair_word(&mut c, first, 0, data);
    dyn_pair_word(&mut c, first, 1, table);
    return first;
}
// A returned `&dyn I` travels as the pair's two words - a 16-byte {ptr, ptr} aggregate in the two
// result registers, which is SysV's, AAPCS64's and RV64's own rule for one - because the pair lives
// in the returning frame. The fact keeps the second word live at the `ret`; the caller rebuilds the
// pair in its own frame (save_result).
fn dyn_result<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.dyn_result_seen, 1);
    if (c.forge_result != 0) && same(view(c.forge_sig), view(c.facts_fn)) {
        return ();
    }
    if c.facts_fn.len() != 0 {
        llvm::fact_dyn_result(&mut c.facts, copy_bytes(view(c.facts_fn)));
    }
    return ();
}
// %rax := the pair's address, which is the `&dyn I` handle: word 0 at `(%rax)`, word 1 at `8(%rax)`.
fn dyn_pair_handle<a>(c: (&a mut C), first: u64) -> unit {
    o(&mut c, view("leaq -"));
    on(&mut c, (first + 1) * 8);
    o(&mut c, view("(%rbp),%rax\n"));
    return ();
}
// The handle of the pair in %rax: it takes over the loans of the reference it was built from, so the
// borrow the `&T` held is the borrow the `&dyn` holds (same loan, same region, same source).
fn borrow_dyn_handle<a>(c: (&a mut C), v: Val, expected: u64) -> u64 {
    handle := save(&mut c);
    target := target_of(&mut c, v.t);
    own(&mut c, handle, expected);
    old := place_of(&mut c, v.t);
    dst := place_of(&mut c, handle);
    return_bonds(&mut c, old, dst, 0);
    set_target(&mut c, handle, target, handle + 1);
    return handle;
}
// A vtable's name is a function of the concrete type and the interface, like a drop helper's, so
// two objects that both build one emit the same weak definition.
fn vtable_symbol<a>(c: (&a mut C), id: u64, concrete: u64) -> u8[] {
    mut key = u8[];
    type_key(&mut c, &mut key, concrete, 0);
    push_bytes(&mut key, view(" as "));
    push_bytes(&mut key, view(c.interfaces[id - 1].module));
    push_bytes(&mut key, view("::"));
    push_bytes(&mut key, view(c.interfaces[id - 1].name));
    digest := iface_digest(&key);
    mut name = u8[];
    push_bytes(&mut name, view(".V"));
    for i in 16 {
        name.push(digest[i]);
    }
    return name;
}
// The vtable an owned `dyn I` cell carries. A method takes its receiver as `&T`, and a dispatch site
// has only the data word, without knowing the type behind it. For anything but a record that word
// is the cell's address - the address of the word holding the value, which is what `&T` is. For a
// record `&T` is the record's own address, which is the cell's *first word*; so a record boxed as
// `dyn` carries this table instead, whose entries load that word and call the method. A `&dyn` made
// from a `&T` keeps the plain table: its data word is already the reference. Everything else about
// the cell and the pair is docs/design/fat-dyn.md unchanged.
fn cell_vtable_symbol<a>(c: (&a mut C), id: u64, concrete: u64) -> u8[] {
    mut name = vtable_symbol(&mut c, id, concrete);
    if direct(&mut c, concrete) {
        name[1] = 67;
    }
    return name;
}
fn emit_vtables<a>(c: (&a mut C)) -> unit {
    if c.vtables.len() == 0 {
        return ();
    }
    mut thunks = u8[];
    o(&mut c, view(".data\n.p2align 3\n"));
    for i in c.vtables.len() / 2 {
        id := c.vtables[2 * i];
        concrete := c.vtables[2 * i + 1];
        vt := vtable_symbol(&mut c, id, concrete);
        weak_def(&mut c);
        push_bytes(&mut c.out, view(vt));
        c.out.push(10);
        push_bytes(&mut c.out, view(vt));
        o(&mut c, view(":\n.quad "));
        // A record also gets the table its owned `dyn` cell carries (cell_vtable_symbol): the same
        // drop word, and for each method an adapter that loads the record out of the cell.
        boxed := direct(&mut c, concrete);
        cell := cell_vtable_symbol(&mut c, id, concrete);
        mut entries = copy_bytes(view(".quad "));
        if needs_drop(&mut c, concrete) {
            drop_name(&mut c, concrete);
            if framed(&mut c, concrete) && !frame_drops(&mut c, concrete) {
                // The cell's value is the box dyn_box made: freeing it is the whole drop.
                push_bytes(&mut entries, view("rt_free"));
            } else {
                dropper := drop_ref_name(&mut c, concrete);
                push_bytes(&mut entries, view(dropper));
            }
        } else {
            o(&mut c, view("0"));
            entries.push(48);
        }
        c.out.push(10);
        entries.push(10);
        methods := dyn_methods(&mut c, id);
        for j in methods.len() {
            name := c.funcs[methods[j]].name.copy();
            owner := interface_of_method(&mut c, methods[j]);
            actual := resolve_interface_method(&mut c, owner, concrete, view(name));
            module := c.funcs[actual].module.copy();
            none := u64[];
            symbol := interface_symbol(&mut c, owner, concrete, actual, &none);
            o(&mut c, view(".quad "));
            mangle(&mut c, view(module), view(symbol));
            c.out.push(10);
            if boxed {
                target := mangle_name(&mut c, view(module), view(symbol));
                push_bytes(&mut entries, view(".quad "));
                push_bytes(&mut entries, view(cell));
                entries.push(95);
                decimal(&mut entries, j);
                entries.push(10);
                if c.plat == 1 {
                    push_bytes(&mut thunks, view(".weak_definition "));
                } else {
                    push_bytes(&mut thunks, view(".weak "));
                }
                push_bytes(&mut thunks, view(cell));
                thunks.push(95);
                decimal(&mut thunks, j);
                thunks.push(10);
                push_bytes(&mut thunks, view(cell));
                thunks.push(95);
                decimal(&mut thunks, j);
                // The receiver is the record the cell's first word holds; the method returns to the
                // dispatch site itself, so the adapter is a load and a jump (no frame of its own).
                // On the LLVM backend the method may be in the other object, which a direct `jmp`
                // cannot reach (`grail asm` relocates calls and RIP-relative operands, not jumps).
                if (c.backend != 0) && (c.target == 0) {
                    push_bytes(&mut thunks, view(":\nmovq (%rdi),%rdi\nleaq "));
                    push_bytes(&mut thunks, view(target));
                    push_bytes(&mut thunks, view("(%rip),%r11\njmp *%r11\n"));
                } else {
                    push_bytes(&mut thunks, view(":\nmovq (%rdi),%rdi\njmp "));
                    push_bytes(&mut thunks, view(target));
                    thunks.push(10);
                }
            }
        }
        if boxed {
            weak_def(&mut c);
            push_bytes(&mut c.out, view(cell));
            c.out.push(10);
            push_bytes(&mut c.out, view(cell));
            o(&mut c, view(":\n"));
            push_bytes(&mut c.out, view(entries));
        }
    }
    o(&mut c, view(".text\n"));
    push_bytes(&mut c.out, view(thunks));
    return ();
}
// Rust's object safety: every method takes the object by reference as its first parameter, and
// `Self` appears nowhere else - not in other parameters, not in the result - and the interface has
// no associated types, which a `dyn I` could not name.
fn check_object_safety<a>(c: (&a mut C), id: u64) -> unit {
    // A dyn object carries its supers' methods too (dyn_methods).
    methods := dyn_methods(&mut c, id);
    mut message = u8[];
    push_bytes(&mut message, view("interface `"));
    push_bytes(&mut message, view(c.interfaces[id - 1].name));
    push_bytes(&mut message, view("` cannot be used as dyn: "));
    for j in methods.len() {
        f := &c.funcs[methods[j]];
        first := f.first;
        count := f.count;
        ret := f.ret;
        fname := f.name.copy();
        // A generic method has no single vtable entry (Rust's rule).
        mut bad = (count == 0) || (f.types > 1);
        if !bad {
            receiver := c.params[first];
            referent := ty_arg(&mut c, receiver);
            bad = (ty_kind(&mut c, receiver) != 7) || mentions_self(&mut c, referent, 1);
        }
        for k in 1..count {
            if mentions_self(&mut c, c.params[first + k], 0) {
                bad = true;
            }
        }
        if mentions_self(&mut c, ret, 0) {
            bad = true;
        }
        if bad {
            push_bytes(&mut message, view("method `"));
            push_bytes(&mut message, view(fname));
            push_bytes(&mut message, view("` must take &self or &mut self first and use Self nowhere else"));
            fail(&mut c, view(message));
        }
    }
    return ();
}
// Whether a type mentions `Self` (type parameter 0 of an interface method). With `top` set, the
// type itself being `Self` is allowed (the referent of the receiver), only a nested use is not.
fn mentions_self<a>(c: (&a mut C), ty: u64, top: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 9) && (ty_arg(&mut c, ty) == 0) {
        return top == 0;
    }
    // `Self::Item`: the dyn type fixes it, so it is not a use of Self.
    if k == 30 {
        return false;
    }
    if (k == 6) || (k == 27) || (k == 7) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) || (k == 29) {
        inner := ty_arg(&mut c, ty);
        if mentions_self(&mut c, inner, 0) {
            return true;
        }
    }
    args := type_args(&mut c, ty);
    for i in args.len() {
        if ty_kind(&mut c, args[i]) != 15 {
            if mentions_self(&mut c, args[i], 0) {
                return true;
            }
        }
    }
    return false;
}
// ---- associated types -----------------------------------------------------------------------------
// `T::Item` for a type parameter `T` whose bounds declare `type Item;` is a projection type (kind 30);
// for a concrete type it is the type its implementation gives (`type Item = u64;`). Binding `T`
// resolves a projection (bind_types), so a specialisation only ever sees concrete types.
fn assoc_type<a, b>(c: (&a mut C), base: u64, name: &b [u8]) -> u64 {
    b := base_type(&mut c, base);
    k := ty_kind(&mut c, b);
    if (k == 9) || (k == 30) {
        proofs := type_args(&mut c, b);
        mut found = NO_TYPE;
        // `T: Source<Item = u64>` in this signature: T::Item is u64.
        if k == 9 {
            param := ty_arg(&mut c, b);
            for e in c.assoc_eqs.len() / 3 {
                if c.assoc_eqs[3 * e] == param {
                    mode := c.assoc_eqs[3 * e + 1];
                    contract := mode / 1024;
                    j := mode % 1024;
                    if (j < c.interfaces[contract - 1].assoc.len()) && same(view(c.interfaces[contract - 1].assoc[j]), view(name)) {
                        return c.assoc_eqs[3 * e + 2];
                    }
                }
            }
        }
        for i in proofs.len() {
            if ty_kind(&mut c, proofs[i]) == 15 {
                id := ty_arg(&mut c, proofs[i]);
                assoc := copy_names(&c.interfaces[id - 1].assoc);
                for j in assoc.len() {
                    if same(view(assoc[j]), view(name)) {
                        if found != NO_TYPE {
                            fail(&mut c, view("ambiguous associated type: several bounds declare it"));
                        }
                        found = intern_full(&mut c, 30, b, id * 1024 + j, u64[]);
                    }
                }
            }
        }
        if found == NO_TYPE {
            fail(&mut c, view("no associated type of that name in this parameter's bounds"));
        }
        return found;
    }
    // A concrete base: the answer is the one type the implementation gives, or NO_TYPE. The id
    // carries "found" itself, so there is no second flag to forget.
    mut found = NO_TYPE;
    for i in c.implementations.len() {
        item := &c.implementations[i];
        ity := item.ty;
        names := copy_names(&item.assoc_names);
        types := copy_numbers(&item.assoc_types);
        mut fits = same_type(&mut c, ity, b) != 0;
        // A generic implementation gives its associated type with its parameters bound.
        mut bindings = u64[];
        if !fits {
            bindings = impl_bindings(&mut c, i + 1, b);
            fits = bindings.len() != 0;
        }
        if fits {
            for j in names.len() {
                if same(view(names[j]), view(name)) {
                    mut given = types[j];
                    if bindings.len() != 0 {
                        given = bind_types(&mut c, given, &bindings);
                    }
                    if (found != NO_TYPE) && (same_type(&mut c, found, given) == 0) {
                        fail(&mut c, view("ambiguous associated type: several implementations give it"));
                    }
                    found = given;
                }
            }
        }
    }
    if found == NO_TYPE {
        fail(&mut c, view("no implementation of this type gives an associated type of that name"));
    }
    return found;
}
// A call's `T: Source<Item = X>` bounds: the argument's implementation must give X.
fn require_assoc_eqs<a, b>(c: (&a mut C), index: u64, map: (&b u64[])) -> unit {
    if c.validating != 0 {
        return ();
    }
    for e in c.func_eqs.len() / 4 {
        if c.func_eqs[4 * e] == index {
            param := c.func_eqs[4 * e + 1];
            mode := c.func_eqs[4 * e + 2];
            fixed := c.func_eqs[4 * e + 3];
            if param < map.len() {
                given := project(&mut c, map[param], mode);
                wanted := bind_types(&mut c, fixed, &map);
                if same_type(&mut c, given, wanted) == 0 {
                    mut message = u8[];
                    push_bytes(&mut message, view("associated type mismatch: the bound requires `"));
                    push_bytes(&mut message, view(source_type_name(&mut c, wanted)));
                    push_bytes(&mut message, view("`, the implementation gives `"));
                    push_bytes(&mut message, view(source_type_name(&mut c, given)));
                    push_bytes(&mut message, view("`"));
                    fail(&mut c, view(message));
                }
            }
        }
    }
    return ();
}
// The projection `base::(interface, index)` once `base` is bound: still a projection over a type
// parameter, otherwise what `base`'s implementation of the interface gives.
fn project<a>(c: (&a mut C), base: u64, mode: u64) -> u64 {
    mut b = base_type(&mut c, base);
    // A borrowed interface object names the same `dyn` type its marker carries, so `Self::Item`
    // through a `&dyn I` resolves exactly as it does through an owned one.
    if ty_kind(&mut c, b) == 35 {
        b = ty_arg(&mut c, b);
    }
    k := ty_kind(&mut c, b);
    // `dyn I<Item = T>` fixes its associated types.
    if (k == 33) && (ty_arg(&mut c, b) == mode / 1024) {
        fixed := type_args(&mut c, b);
        if mode % 1024 < fixed.len() {
            return fixed[mode % 1024];
        }
    }
    // A bound of the current signature may fix it (`I: Iterator<Item = u64>`).
    if k == 9 {
        param := ty_arg(&mut c, b);
        for e in c.assoc_eqs.len() / 3 {
            if (c.assoc_eqs[3 * e] == param) && (c.assoc_eqs[3 * e + 1] == mode) {
                return c.assoc_eqs[3 * e + 2];
            }
        }
    }
    if (k == 9) || (k == 30) {
        return intern_full(&mut c, 30, b, mode, u64[]);
    }
    contract := mode / 1024;
    index := mode % 1024;
    implementation := find_implementation(&mut c, contract, b);
    if implementation == 0 {
        fail(&mut c, view("missing interface implementation for an associated type"));
    }
    name := c.interfaces[contract - 1].assoc[index].copy();
    item := &c.implementations[implementation - 1];
    names := copy_names(&item.assoc_names);
    types := copy_numbers(&item.assoc_types);
    bindings := impl_bindings(&mut c, implementation, b);
    for j in names.len() {
        if same(view(names[j]), view(name)) {
            if bindings.len() != 0 {
                return bind_types(&mut c, types[j], &bindings);
            }
            return types[j];
        }
    }
    fail(&mut c, view("missing associated type in an interface implementation"));
    return 0;
}
fn bind_types<a, b>(c: (&a mut C), ty: u64, map: (&b u64[])) -> u64 {
    k := ty_kind(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    mut arg = ty_arg(&mut c, ty);
    if k == 9 {
        if map.len() < arg + 1 {
            fail(&mut c, view("unbound type parameter"));
        }
        return map[arg];
    }
    if k == 30 {
        base := bind_types(&mut c, arg, &map);
        return project(&mut c, base, mode);
    }
    if (k == 6) || (k == 27) || (k == 28) || (k == 7) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) || (k == 29)
        || (k == 32) || (k == 34) || (k == 35) || (k == 36) {
        arg = bind_types(&mut c, arg, &map);
    }
    if k == 32 {
        // An array whose length a value parameter gives: bound to a constant, it is the concrete
        // array `[T; N]` - one type, however it was reached.
        largs := type_args(&mut c, ty);
        if largs.len() == 1 {
            mut l = bind_types(&mut c, largs[0], &map);
            while (l != NO_TYPE) && is_type_id(l) && (ty_kind(&mut c, l) == 10) {
                l = ty_arg(&mut c, l);
            }
            if (l != NO_TYPE) && is_type_id(l) && (ty_kind(&mut c, l) == 31) {
                return intern_args(&mut c, 32, arg, ty_arg(&mut c, l), u64[], u64[]);
            }
            return intern_args(&mut c, 32, arg, 0, u64[], u64[l]);
        }
        return intern_args(&mut c, 32, arg, mode, u64[], u64[]);
    }
    mut args = type_args(&mut c, ty);
    for i in args.len() {
        t := args[i];
        mut v = bind_types(&mut c, t, &map);
        exchange(&mut args[i], v);
    }
    if is_union(&mut c, ty) {
        for i in args.len() {
            for j in i {
                left := base_type(&mut c, args[i]);
                right := base_type(&mut c, args[j]);
                if same_type(&mut c, left, right) != 0 {
                    fail_duplicate_member(&mut c, left);
                }
            }
        }
    }
    mut rs = type_regions(&mut c, ty);
    env := ty_env(&mut c, ty);
    return intern_env(&mut c, k, arg, mode, rs, args, env);
}
fn field_type<a>(c: (&a mut C), ty: u64, index: u64) -> u64 {
    d := ty_arg(&mut c, ty);
    mut t = field_ty(&mut c, d, index);
    mut rs = type_regions(&mut c, ty);
    mut args = type_args(&mut c, ty);
    field := bind_types(&mut c, t, &args);
    if rs.len() == 0 {
        return field;
    }
    return substitute(&mut c, field, &rs);
}
fn concrete_type<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 9) || (k == 30) {
        return false;
    }
    arg := ty_arg(&mut c, ty);
    if (k == 6) || (k == 27) || (k == 7) || (k == 10) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) || (k == 29)
        || (k == 32) || (k == 34) || (k == 35) || (k == 36) {
        if !concrete_type(&mut c, arg) {
            return false;
        }
    }
    mut args = type_args(&mut c, ty);
    for i in args.len() {
        a := args[i];
        if !concrete_type(&mut c, a) {
            return false;
        }
    }
    return true;
}
fn reference_type<a>(c: (&a mut C), ty: u64, mode: u64) -> u64 {
    return intern_full(&mut c, 7, ty, mode, u64[]);
}
// Shape checking does not discharge lifetime obligations; the loan pass handles those separately.
fn callable_contract<a, b>(
    c: (&a mut C),
    actual: u64,
    expected: u64,
    map: (&b mut u64[]),
    depth: u64
) -> bool {
    if 64 < depth {
        return false;
    }
    ak := ty_kind(&mut c, actual);
    ek := ty_kind(&mut c, expected);
    if ak != ek {
        return false;
    }
    aa := ty_arg(&mut c, actual);
    ea := ty_arg(&mut c, expected);
    if (ak == 5) || (ak == 7) || (ak == 27) || (ak == 10) {
        am := ty_mode(&mut c, actual);
        em := ty_mode(&mut c, expected);
        if am != em {
            return false;
        }
    }
    if ak == 20 {
        // The call mode is part of the type. So are the bounds, but a closure expression's own type
        // states none: its environment answers for it (closure_bounds_hold). Two signature types
        // must state the same ones - a container of `Fn<Send>` is not a container of `Fn`.
        am := ty_mode(&mut c, actual);
        em := ty_mode(&mut c, expected);
        if (am & CLOSURE_FNMUT) != (em & CLOSURE_FNMUT) {
            return false;
        }
        // Each closure expression is a type of its own: two of them are the same type only if they
        // are the same literal (the environment record names it), whatever their signatures - or a
        // `Keep<F>` built from one could be assigned one built from another, and calls through it,
        // which go straight to the first literal's body, would run the wrong closure.
        if (ty_env(&mut c, actual) != 0) && (ty_env(&mut c, expected) != 0) && (ty_env(&mut c, actual) != ty_env(&mut c, expected)) {
            return false;
        }
        if (ty_env(&mut c, actual) != 0) || ((am & CLOSURE_UNBUILT) != 0) {
            if !closure_bounds_hold(&mut c, actual, em & CLOSURE_BOUNDS) {
                return false;
            }
        } else if ((em & CLOSURE_UNBUILT) == 0) & ((am & CLOSURE_BOUNDS) != (em & CLOSURE_BOUNDS)) {
            return false;
        }
    }
    if (ak == 8) || (ak == 9) || (ak == 10) || (ak == 18) {
        if aa != ea {
            return false;
        }
    }
    if ak == 18 {
        if ty_mode(&mut c, actual) != ty_mode(&mut c, expected) {
            return false;
        }
    }
    ar := type_regions(&mut c, actual);
    er := type_regions(&mut c, expected);
    // A closure's own regions are the lifetimes it captured, not part of its signature: a closure
    // that borrows is accepted where a plain `Fn(...)` is expected. The loan stays on the value, so
    // letting the value outlive the borrow is still rejected elsewhere.
    if ak != 20 {
        if ar.len() != er.len() {
            return false;
        }
        for i in ar.len() {
            from := ar[i];
            to := er[i];
            mut seen = 0;
            for j in map.len() / 2 {
                if map[j * 2] == from {
                    if map[j * 2 + 1] != to {
                        return false;
                    }
                    seen = 1;
                    break;
                }
            }
            if seen == 0 {
                map.push(from);
                map.push(to);
            }
        }
    }
    if (ak == 6) || (ak == 27) || (ak == 28) || (ak == 7) || (ak == 12) || (ak == 13) || (ak == 14) || (ak == 16) || (ak == 20) || (ak == 29) {
        if !callable_contract(&mut c, aa, ea, &mut map, depth + 1) {
            return false;
        }
    }
    ax := type_args(&mut c, actual);
    ex := type_args(&mut c, expected);
    if ax.len() != ex.len() {
        return false;
    }
    for i in ax.len() {
        left := ax[i];
        right := ex[i];
        // A closure's reference parameter is a fresh input lifetime on every call, so an expected
        // parameter that names no lifetime - a type argument bound to a reference (`C` of
        // `Fn((&T), C)` given `&a K`), whose lifetime the binding does not carry - accepts any: only
        // the referent and the mode must match. Result positions are not relaxed.
        if (ak == 20) || (ak == 12) {
            lk := ty_kind(&mut c, left);
            if ((lk == 5) || (lk == 7) || (lk == 27)) && (ty_kind(&mut c, right) == lk)
                && (type_regions(&mut c, right).len() == 0) && (type_regions(&mut c, left).len() == 1)
                && (ty_mode(&mut c, left) == ty_mode(&mut c, right)) {
                if (lk == 5) || callable_contract(&mut c, ty_arg(&mut c, left), ty_arg(&mut c, right), &mut map, depth + 1) {
                    continue;
                }
                return false;
            }
        }
        if !callable_contract(&mut c, left, right, &mut map, depth + 1) {
            return false;
        }
    }
    return true;
}
fn same_type<a>(c: (&a mut C), x: u64, y: u64) -> u64 {
    a := ty_kind(&mut c, x);
    mut b = ty_kind(&mut c, y);
    if a != b {
        return 0;
    }
    if (a == 12) || (a == 20) || (a == 25) {
        mut map = u64[];
        return callable_contract(&mut c, x, y, &mut map, 0);
    }
    aa := ty_arg(&mut c, x);
    bb := ty_arg(&mut c, y);
    // An `Atomic<T>` is its element's (`Atomic<u8>` is not `Atomic<u64>`); a SIMD vector is its
    // element and lane count, and whether it is a mask.
    if a == 11 {
        return u64(aa == bb);
    }
    if a == 36 {
        return u64((aa == bb) & (ty_mode(&mut c, x) == ty_mode(&mut c, y)));
    }
    if (a == 5) || (a == 7) || (a == 27) || (a == 34) {
        am := ty_mode(&mut c, x);
        bm := ty_mode(&mut c, y);
        if am != bm {
            return 0;
        }
    }
    if (a == 6) || (a == 7) || (a == 27) || (a == 28) || (a == 13) || (a == 14) || (a == 16) || (a == 29) || (a == 34) {
        return same_type(&mut c, aa, bb);
    }
    if a == 8 {
        if aa != bb {
            return 0;
        }
        ax := type_args(&mut c, x);
        bx := type_args(&mut c, y);
        if ax.len() != bx.len() {
            return 0;
        }
        for i in ax.len() {
            x := ax[i];
            y := bx[i];
            if same_type(&mut c, x, y) == 0 {
                return 0;
            }
        }
    }
    if a == 18 {
        am := ty_mode(&mut c, x);
        bm := ty_mode(&mut c, y);
        return (aa == bb) & (am == bm);
    }
    if (a == 9) || (a == 21) {
        return aa == bb;
    }
    if a == 33 {
        if aa != bb {
            return 0;
        }
        if ty_mode(&mut c, x) != ty_mode(&mut c, y) {
            return 0;
        }
        if type_regions(&mut c, x).len() != type_regions(&mut c, y).len() {
            return 0;
        }
        xa := type_args(&mut c, x);
        ya := type_args(&mut c, y);
        if xa.len() != ya.len() {
            return 0;
        }
        for i in xa.len() {
            if same_type(&mut c, xa[i], ya[i]) == 0 {
                return 0;
            }
        }
        return 1;
    }
    if a == 30 {
        if ty_mode(&mut c, x) != ty_mode(&mut c, y) {
            return 0;
        }
        return same_type(&mut c, aa, bb);
    }
    if a == 10 {
        am := ty_mode(&mut c, x);
        bm := ty_mode(&mut c, y);
        return (aa == bb) & (am == bm);
    }
    return 1;
}
fn contains_borrow<a>(c: (&a mut C), ty: u64, depth: u64) -> bool {
    // Remembered per type, as type_caps is: the stamp's low bit carries the answer.
    stamp := type_walk_stamp(&c);
    if is_type_id(ty) {
        if ty < c.borrow_stamp.len() {
            if (c.borrow_stamp[ty] | 1) == (stamp | 1) {
                return (c.borrow_stamp[ty] & 1) != 0;
            }
        }
    }
    mut trail = u64[];
    found := borrow_walk(&mut c, ty, &mut trail);
    if is_type_id(ty) {
        while c.borrow_stamp.len() <= ty {
            c.borrow_stamp.push(0);
        }
        c.borrow_stamp[ty] = stamp + u64(found);
    }
    return found;
}
fn borrow_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> bool {
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    // `dyn<s> I` holds borrows from `s`.
    if (k == 33) && (type_regions(&mut c, ty).len() != 0) {
        return true;
    }
    if k == 5 || k == 7 || k == 27 {
        return true;
    }
    // A closure that captured a reference or view holds the loan: the regions it carries are the
    // lifetimes it depends on, so every borrow rule applies to the closure value itself.
    if k == 20 {
        rs := type_regions(&mut c, ty);
        if rs.len() != 0 {
            return true;
        }
        // A closure type from a signature carries no capture list, but one whose result names a
        // lifetime no parameter supplies (`Fn() -> &a T`) can only return a reference into what it
        // captured: it holds that borrow, and moving or binding it must keep the loan.
        result := caps_walk(&mut c, arg, &mut trail);
        mut supplied = u64[];
        params := type_args(&mut c, ty);
        for p in params.len() {
            more := caps_walk(&mut c, params[p], &mut trail);
            for i in more.len() {
                supplied.push(more[i]);
            }
        }
        for i in result.len() {
            mut found = false;
            for j in supplied.len() {
                if supplied[j] == result[i] {
                    found = true;
                }
            }
            if !found {
                return true;
            }
        }
        return false;
    }
    if k == 10 || k == 6 || k == 13 {
        return borrow_walk(&mut c, arg, &mut trail);
    }
    if k == 29 {
        return borrow_walk(&mut c, arg, &mut trail);
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return false;
            }
        }
        trail.push(ty);
        d := &c.decls[arg];
        count := d.count;
        for i in count {
            t := field_type(&mut c, ty, i);
            if borrow_walk(&mut c, t, &mut trail) {
                trail.pop()!;
                return true;
            }
        }
        trail.pop()!;
    }
    return false;
}
// A type as the programmer writes it: `u64`, `string`, `u8[]`, `&mut Pair<u64>`, `T?`. Falls back to
// the interface spelling for the kinds that have no surface syntax.
// The `&dyn I` type a borrowed object's value names, or 0 when it is not one: the value itself, or -
// for the `&(&dyn I)` an index of a vector of them yields - the element type it holds.
fn borrowed_object_type<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) != 7 {
        return 0;
    }
    inner := ty_arg(&mut c, ty);
    if ty_kind(&mut c, inner) == 35 {
        return ty;
    }
    if ty_kind(&mut c, inner) == 7 {
        more := ty_arg(&mut c, inner);
        if ty_kind(&mut c, more) == 35 {
            return inner;
        }
    }
    return 0;
}
fn source_type_name<a>(c: (&a mut C), ty: u64) -> u8[] {
    mut out = u8[];
    if ty == 0 {
        push_bytes(&mut out, view("u64"));
        return out;
    }
    // `T?` is spelled the way it is written, not as the `result::Option<T>` it names.
    if is_option_storage(&mut c, ty) {
        inner := type_args(&mut c, ty);
        if inner.len() == 1 {
            mut text = source_type_name(&mut c, inner[0]);
            text.push(63);
            return text;
        }
    }
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if k == 36 {
        push_bytes(&mut out, view(simd_shape(&mut c, ty)));
        return out;
    }
    if k == 11 {
        push_bytes(&mut out, view("Atomic<"));
        push_bytes(&mut out, view(source_type_name(&mut c, arg)));
        out.push(62);
        return out;
    }
    if k == 18 {
        if ty_mode(&mut c, ty) != 0 {
            out.push(105);
        } else {
            out.push(117);
        }
        decimal(&mut out, arg);
        return out;
    }
    if k == 21 {
        if arg == 32 {
            push_bytes(&mut out, view("f32"));
        } else {
            push_bytes(&mut out, view("f64"));
        }
        return out;
    }
    if k == 19 {
        push_bytes(&mut out, view("bool"));
        return out;
    }
    if k == 22 {
        push_bytes(&mut out, view("char"));
        return out;
    }
    // Kind 3 is `bytes` (a `u8[]`) and kind 4 is `string`: the two were swapped here, so a
    // diagnostic spelled `string` where the value was a byte vector and the other way round.
    if k == 3 {
        push_bytes(&mut out, view("u8[]"));
        return out;
    }
    if k == 4 {
        push_bytes(&mut out, view("string"));
        return out;
    }
    if k == 6 {
        inner := source_type_name(&mut c, arg);
        push_bytes(&mut out, view(inner));
        push_bytes(&mut out, view("[]"));
        return out;
    }
    if k == 32 {
        out.push(91);
        inner := source_type_name(&mut c, arg);
        push_bytes(&mut out, view(inner));
        push_bytes(&mut out, view("; "));
        if type_args(&mut c, ty).len() != 0 {
            out.push(78);
        } else {
            decimal(&mut out, ty_mode(&mut c, ty));
        }
        out.push(93);
        return out;
    }
    if k == 7 {
        out.push(38);
        if ty_mode(&mut c, ty) != 0 {
            push_bytes(&mut out, view("mut "));
        }
        inner := source_type_name(&mut c, arg);
        push_bytes(&mut out, view(inner));
        return out;
    }
    if (k == 9) && (arg < c.tnames.len()) {
        push_bytes(&mut out, view(c.tnames[arg]));
        return out;
    }
    if (k == 20) & (ty_env(&mut c, ty) == 0) {
        // A closure type as a signature writes it: `Fn<Send>(u64) -> u64`.
        mode := ty_mode(&mut c, ty);
        if (mode & CLOSURE_FNMUT) != 0 {
            push_bytes(&mut out, view("FnMut"));
        } else {
            push_bytes(&mut out, view("Fn"));
        }
        crs := type_regions(&mut c, ty);
        mut rname = u8[];
        if (crs.len() == 1) && (crs[0] != 0) && (crs[0] <= c.rnames.len()) {
            rname = c.rnames[crs[0] - 1].copy();
        }
        closure_bounds_text_named(&mut out, mode, view(rname));
        out.push(40);
        params := type_args(&mut c, ty);
        for i in params.len() {
            if i != 0 {
                push_bytes(&mut out, view(", "));
            }
            inner := source_type_name(&mut c, params[i]);
            push_bytes(&mut out, view(inner));
        }
        push_bytes(&mut out, view(") -> "));
        inner := source_type_name(&mut c, arg);
        push_bytes(&mut out, view(inner));
        return out;
    }
    if k == 33 {
        // `dyn<Send> Peek`, `dyn Iterator<Item = u64>`.
        push_bytes(&mut out, view("dyn"));
        drs := type_regions(&mut c, ty);
        mut rname = u8[];
        if (drs.len() == 1) && (drs[0] != 0) && (drs[0] <= c.rnames.len()) {
            rname = c.rnames[drs[0] - 1].copy();
        }
        closure_bounds_text_named(&mut out, ty_mode(&mut c, ty), view(rname));
        out.push(32);
        push_bytes(&mut out, view(c.interfaces[arg - 1].name));
        return out;
    }
    if k == 35 {
        // The referent of a borrowed interface object prints as the dyn type it names, so
        // `&dyn Shape` reads back as it was written.
        inner := source_type_name(&mut c, arg);
        push_bytes(&mut out, view(inner));
        return out;
    }
    if k == 8 {
        owner := c.decls[arg].module.copy();
        args := type_args(&mut c, ty);
        if same(view(owner), view(".union")) & (args.len() == 1) {
            inner := source_type_name(&mut c, args[0]);
            push_bytes(&mut out, view(inner));
            out.push(63);
            return out;
        }
        here := module_copy(&mut c);
        if !same(view(owner), view(here)) & (owner.len() != 0) & (owner[0] != 46) {
            push_bytes(&mut out, view(owner));
            push_bytes(&mut out, view("::"));
        }
        push_bytes(&mut out, view(c.decls[arg].name));
        if args.len() != 0 {
            out.push(60);
            for i in args.len() {
                if i != 0 {
                    push_bytes(&mut out, view(", "));
                }
                inner := source_type_name(&mut c, args[i]);
                push_bytes(&mut out, view(inner));
            }
            out.push(62);
        }
        return out;
    }
    return type_name(&mut c, ty);
}
fn require_type<a>(c: (&a mut C), actual: u64, expected: u64) -> unit {
    // While a type hint is pending the function is recompiled anyway; mismatches are not final.
    if c.tolerant != 0 {
        return ();
    }
    // A `byval` parameter is checked as the record it wraps: the marker states the ABI, not a
    // second type for the same layout.
    mut want = expected;
    if ffi_byval(&mut c, want) {
        want = ty_arg(&mut c, want);
    }
    if (want == 0) & is_bool(&mut c, actual) {
        return ();
    }
    if (ty_kind(&mut c, want) == 23) || (ty_kind(&mut c, actual) == 23) {
        // A handle carries no value of another type: C produces one and hands it back, and the only
        // things it can be compared with are handles of its own type.
        if same_type(&mut c, actual, want) != 0 {
            return ();
        }
        if (ty_kind(&mut c, want) == 23) & (ty_kind(&mut c, actual) == 23) {
            fail(&mut c, view("handles of different types do not mix"));
        }
        if ty_kind(&mut c, want) == 23 {
            fail(
                &mut c,
                view("a handle cannot be constructed or converted: only a foreign call produces one, and it passes back to C")
            );
        }
        fail(&mut c, view("a handle has no value in this context; pass it back to C or compare it with another handle"));
    }
    if same_type(&mut c, actual, want) == 0 {
        // A closure value used as a closure type that says less (or, for a closure expression, as
        // one whose bounds its captures meet): the same record, so nothing is converted.
        if closure_converts(&mut c, actual, want) != 0 {
            return ();
        }
        if dyn_converts(&mut c, actual, want) != 0 {
            return ();
        }
        if (ty_kind(&mut c, actual) == 33) && (ty_kind(&mut c, want) == 33) && (ty_arg(&mut c, actual) == ty_arg(&mut c, want)) {
            have := ty_mode(&mut c, actual);
            need := ty_mode(&mut c, want);
            if (need & have) != need {
                mut msg = copy_bytes(view("`"));
                push_bytes(&mut msg, view(source_type_name(&mut c, actual)));
                push_bytes(&mut msg, view("` does not say what the value behind it may do, so it cannot be used as `"));
                push_bytes(&mut msg, view(source_type_name(&mut c, want)));
                push_bytes(&mut msg, view("`: a bound is checked where the value is boxed, so state it there"));
                fail(&mut c, view(msg));
            }
            if (type_regions(&mut c, actual).len() != 0) && (type_regions(&mut c, want).len() == 0) {
                fail(&mut c, view("this `dyn` holds a borrow - it is `dyn<s> I` - and a bare `dyn I` holds none: keep the lifetime in the type"));
            }
        }
        // `Fn` and `FnMut` have the same signature and differ only in whether a call needs
        // exclusive access: say so instead of reporting a shape mismatch.
        if (ty_kind(&mut c, actual) == 20) & (ty_kind(&mut c, want) == 20) {
            am := ty_mode(&mut c, actual);
            em := ty_mode(&mut c, want);
            if ((am & CLOSURE_FNMUT) != 0) & ((em & CLOSURE_FNMUT) == 0) {
                shared := closure_as(&mut c, actual, want);
                if same_type(&mut c, shared, want) != 0 {
                    fail(
                        &mut c,
                        view("a closure that mutates a captured value is FnMut, not Fn: calling it needs exclusive access to the closure, so it cannot be used where a shared call is required")
                    );
                }
            }
        }
        mut said = copy_bytes(view("expected `"));
        wanted := source_type_name(&mut c, want);
        push_bytes(&mut said, view(wanted));
        push_bytes(&mut said, view("`, found `"));
        got := source_type_name(&mut c, actual);
        push_bytes(&mut said, view(got));
        push_bytes(&mut said, view("`"));
        exchange(&mut c.diag_primary, said);
        fail(&mut c, view("type mismatch"));
    }
    return ();
}
// Type alias index + 1, or 0.
fn find_alias<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    mut found = 0;
    for i in c.aliases.len() {
        a := &c.aliases[i];
        if same(view(a.module), view(m)) & same(view(a.name), view(n)) {
            found = i + 1;
            break;
        }
    }
    if (found != 0) && (c.aliases[found - 1].public == 0) {
        // stays: `c.aliases[found - 1]` is a borrowed element (see drop_hook_symbol).
        home := c.aliases[found - 1].module.copy();
        require_visible(&mut c, view(home), view(n));
    }
    return found;
}
// Declaration index + 1, or 0.
fn find_decl_internal<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    decl_index_sync(&mut c);
    if c.decl_slots.len() != 0 {
        key := name_key(m, n);
        mask := c.decl_slots.len() - 1;
        mut h = key & mask;
        while c.decl_slots[h] != 0 {
            i := c.decl_slots[h] - 1;
            if c.decl_keys[i] == key {
                x := &c.decls[i];
                if same(view(x.module), view(m)) & same(view(x.name), view(n)) {
                    return i + 1;
                }
            }
            h = (h + 1) & mask;
        }
    }
    // `.tuple::TupleN` (an interface file naming a tuple type): made on first use.
    if same(view(m), view(".tuple")) && (n.len() > 5) {
        mut count = 0;
        for i in 5..n.len() {
            count = count * 10 + u64(n[i] - 48);
        }
        return tuple_decl(&mut c, count) + 1;
    }
    return 0;
}
// ---- tuples --------------------------------------------------------------------------------------
// `(A, B)` is the generic record `.tuple::Tuple2<A, B>` with fields `0` and `1`, made the first time
// a tuple of that size is named: interning, ownership, drops, generics and interface files are the
// record's. `(a, b)` builds one (record, positionally), `t.0` reads a field, and `(x, y) := t;` takes
// it apart (tuple_destructure).
fn tuple_decl<a>(c: (&a mut C), count: u64) -> u64 {
    mut name = copy_bytes(view("Tuple"));
    decimal(&mut name, count);
    for i in c.decls.len() {
        x := &c.decls[i];
        if same(view(x.module), view(".tuple")) & same(view(x.name), view(name)) {
            return i;
        }
    }
    if (count < 2) || (count > 12) {
        fail(&mut c, view("a tuple has 2 to 12 elements"));
    }
    first := c.fields.len();
    mut bounds = u64[];
    mut constraints = u64[][];
    for i in count {
        mut field = u8[];
        decimal(&mut field, i);
        ty := intern_args(&mut c, 9, i, 0, u64[], u64[]);
        c.fields.push(Field { name: field, ty: ty, pred: no_pred() });
        bounds.push(0);
        constraints.push(u64[]);
    }
    c
        .decls
        .push(
            Decl {
                public: 1,
                module: copy_bytes(view(".tuple")),
                name: name, declared_at: u8[],
                is_enum: 0,
                opaque: 0,
                transfer: 0,
                share: 0,
                c_layout: 0,
                first: first,
                count: count,
                drop: 0,
                regions: 0,
                types: count,
                success: 0,
                bounds: bounds,
                constraints: constraints,
            }
        );
    return c.decls.len() - 1;
}
// The tuple record type of these element types.
fn tuple_type<a, b>(c: (&a mut C), elements: (&b u64[])) -> u64 {
    d := tuple_decl(&mut c, elements.len());
    return intern_args(&mut c, 8, d, 0, u64[], copy_numbers(&elements));
}
// Whether the parenthesis at c.pos opens a tuple: a comma at its own depth (not inside a closure's
// `|...|`) before its `)`.
fn tuple_ahead<a>(c: (&a mut C)) -> bool {
    mut depth = 0;
    mut q = c.pos;
    mut bars = 0;
    while q < c.toks.len() {
        k := kind_at(&mut c, q);
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        } else if (k == 41) || (k == 93) || (k == 125) {
            depth -= 1;
            if depth == 0 {
                return false;
            }
        } else if (k == 124) && (depth == 1) {
            bars += 1;
        } else if (k == 44) && (depth == 1) && (bars % 2 == 0) {
            return true;
        } else if (k == 59) && (depth <= 1) {
            return false;
        }
        q += 1;
    }
    return false;
}
// `( ident , ident ... ) :=` at c.pos.
fn tuple_pattern_ahead<a>(c: (&a mut C)) -> bool {
    mut q = c.pos + 1;
    while true {
        if kind_at(&mut c, q) != 1 {
            return false;
        }
        q += 1;
        if kind_at(&mut c, q) == 41 {
            return kind_at(&mut c, q + 1) == 261;
        }
        if kind_at(&mut c, q) != 44 {
            return false;
        }
        q += 1;
    }
    return false;
}
// The `)` matching the `(` at c.pos.
fn paren_close<a>(c: (&a mut C)) -> u64 {
    mut depth = 0;
    mut q = c.pos;
    while q < c.toks.len() {
        k := kind_at(&mut c, q);
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        } else if (k == 41) || (k == 93) || (k == 125) {
            depth -= 1;
            if depth == 0 {
                return q;
            }
        }
        q += 1;
    }
    return q;
}
// `( ident , ident ... )` at c.pos: the names a tuple pattern binds, in order.
fn pattern_names<a>(c: (&a mut C)) -> u8[][] {
    expect(&mut c, view("("));
    mut names = u8[][];
    while true {
        names.push(ident(&mut c));
        if eat(&mut c, view(")")) {
            break;
        }
        expect(&mut c, view(","));
    }
    return names;
}
// The pattern written back for a diagnostic: `(a, b)`.
fn pattern_text<a>(names: (&a u8[][])) -> u8[] {
    mut out = copy_bytes(view("("));
    for i in names.len() {
        if i != 0 {
            push_bytes(&mut out, view(", "));
        }
        push_bytes(&mut out, view(names[i]));
    }
    push_bytes(&mut out, view(")"));
    return out;
}
// `for (a, b) in xs`: the loop variable holds one element of `xs`, and each name in the pattern takes
// its field out of it with the steps `(a, b) := t` uses (tuple_destructure): the field is loaded,
// owned, bound, and the tuple itself is freed. `_` binds a position nothing reads, so what it held is
// dropped with the rest when the iteration ends.
fn tuple_element_bind<a, b>(c: (&a mut C), names: (&b u8[][]), ty: u64, slot: u64) -> unit {
    mut pattern = pattern_text(names);
    base := base_type(&mut c, ty);
    mut ok = ty_kind(&mut c, base) == 8;
    if ok {
        d := ty_arg(&mut c, base);
        ok = same(view(c.decls[d].module), view(".tuple"));
    }
    if !ok {
        // `for (a, b) in &xs` is the first thing a reader who wants to keep `xs` writes; naming a
        // reference's type would print the interface spelling, so it says what to write instead.
        if ty_kind(&mut c, ty) == 7 {
            mut msg = copy_bytes(view("for "));
            push_bytes(&mut msg, view(pattern));
            push_bytes(&mut msg, view(" takes an element apart, so the element cannot be borrowed: iterate the sequence itself (the element then moves out) or bind one name and read its fields"));
            fail(&mut c, view(msg));
            return ();
        }
        tname := source_type_name(&mut c, ty);
        mut msg = copy_bytes(view("for "));
        push_bytes(&mut msg, view(pattern));
        push_bytes(&mut msg, view(" needs tuple elements: the element type is `"));
        push_bytes(&mut msg, view(tname));
        push_bytes(&mut msg, view("`"));
        fail(&mut c, view(msg));
        return ();
    }
    d := ty_arg(&mut c, base);
    if c.decls[d].count != names.len() {
        mut msg = copy_bytes(view("the element is a "));
        decimal(&mut msg, c.decls[d].count);
        push_bytes(&mut msg, view("-tuple and the pattern names "));
        decimal(&mut msg, names.len());
        fail(&mut c, view(msg));
        return ();
    }
    if drop_type(&mut c, base) != 0 {
        fail(&mut c, view("a value that implements Drop cannot be destructured"));
        return ();
    }
    source := place_of(&mut c, slot);
    for i in names.len() {
        fty := field_type(&mut c, base, i);
        part := field_load(&mut c, slot, base, i, 0);
        own(&mut c, part, fty);
        dest := place_of(&mut c, part);
        if contains_borrow(&mut c, fty, 0) {
            transfer_bonds(&mut c, source, dest);
        }
        stored_source(&mut c, part, fty);
        bind(&mut c, names[i].copy(), fty, part, 0);
    }
    move_out(&mut c, val(slot, ty));
    if !framed(&mut c, ty) {
        // A plain record's words are its frame's: only a boxed record has a shell to free.
    invoke(&mut c, view("rt_free"), one(slot));
    }
    return ();
}
// `left, right := split_at_mut(s, mid);` (docs/design/simd-layout-parallel-loops.md 4.3): one
// exclusive slice in, two out - `s[0: mid]` and `s[mid: len]`, with `mid <= len` checked as it runs.
// The halves are reborrows of `s`'s loans in one sibling group (ownership::open_group), so the
// checker lets both be used at once without knowing any index: they are disjoint by construction.
// `s` itself, and its vector, are unusable while either half lives, as for any reborrow.
fn split_at_mut_statement<a>(c: (&a mut C)) -> unit {
    left := tok_text(&mut c, c.pos);
    right := tok_text(&mut c, c.pos + 2);
    exchange(&mut c.pos, c.pos + 5);
    expect(&mut c, view("("));
    sstart := c.pos;
    v := expr(&mut c, 0);
    expect(&mut c, view(","));
    m := expr(&mut c, 0);
    expect(&mut c, view(")"));
    expect(&mut c, view(";"));
    require_type(&mut c, m.ty, 0);
    k := ty_kind(&mut c, v.ty);
    if (c.raw != 0) || !((k == 27) || (k == 5)) || (ty_mode(&mut c, v.ty) == 0) {
        exchange(&mut c.pos, sstart);
        fail(&mut c, view("split_at_mut takes an exclusive slice: `&mut xs[a: b]` or a `&mut [T]`"));
    }
    elem := ty_arg(&mut c, v.ty);
    mut width = 8;
    if k == 5 {
        width = 1;
    } else if flat_bytes(&mut c, elem) != 0 {
        width = flat_bytes(&mut c, elem);
    } else if narrow_code(&mut c, elem) != 0 {
        width = 4;
    }
    observe(&mut c, v.t);
    len := apply(&mut c, view("rt_len"), one(v.t));
    ownership::open_group(&mut c.check);
    mut args = two(v.t, imm(&mut c, 0));
    args.push(m.t);
    args.push(imm(&mut c, width));
    lo := apply(&mut c, view("rt_vslice"), args);
    own(&mut c, lo, v.ty);
    view_bonds(&mut c, lo, v.t, 1, false);
    mut args2 = two(v.t, m.t);
    args2.push(len);
    args2.push(imm(&mut c, width));
    hi := apply(&mut c, view("rt_vslice"), args2);
    own(&mut c, hi, v.ty);
    view_bonds(&mut c, hi, v.t, 1, false);
    ownership::close_group(&mut c.check);
    // The argument holds the loans the halves reborrow: when it is a temporary (`&mut xs[0: n]`)
    // it lives on, under a name no program can spell, until the halves' scope ends.
    mut named = false;
    for i in c.locals.len() {
        if local_id(&mut c, i) == v.t {
            named = true;
        }
    }
    if !named {
        mut hidden = copy_bytes(view("split#"));
        decimal(&mut hidden, lo);
        bind(&mut c, hidden, v.ty, v.t, 0);
    }
    bind(&mut c, left, v.ty, lo, 0);
    bind(&mut c, right, v.ty, hi, 0);
    return ();
}
// `(a, b, c) := expr;` - a tuple's elements bound to new names; `_` skips one (it is dropped).
fn tuple_destructure<a>(c: (&a mut C)) -> unit {
    names := pattern_names(&mut c);
    expect(&mut c, view(":="));
    v := expr(&mut c, 0);
    expect(&mut c, view(";"));
    held := move_value(&mut c, v);
    ty := base_type(&mut c, held.ty);
    mut ok = ty_kind(&mut c, ty) == 8;
    if ok {
        d := ty_arg(&mut c, ty);
        ok = same(view(c.decls[d].module), view(".tuple")) && (c.decls[d].count == names.len());
    }
    if !ok {
        fail(&mut c, view("tuple pattern does not match the value's type"));
    }
    if drop_type(&mut c, ty) != 0 {
        fail(&mut c, view("a value that implements Drop cannot be destructured"));
    }
    source := place_of(&mut c, held.t);
    for i in names.len() {
        fty := field_type(&mut c, ty, i);
        part := field_load(&mut c, held.t, ty, i, 0);
        own(&mut c, part, fty);
        dest := place_of(&mut c, part);
        if contains_borrow(&mut c, fty, 0) {
            transfer_bonds(&mut c, source, dest);
        }
        stored_source(&mut c, part, fty);
        bind(&mut c, names[i].copy(), fty, part, 0);
    }
    move_out(&mut c, val(held.t, held.ty));
    if !framed(&mut c, held.ty) {
        // A plain record's words are its frame's: only a boxed record has a shell to free.
    invoke(&mut c, view("rt_free"), one(held.t));
    }
    return ();
}

// `{ x, y } := p;` - a record's named fields bound to new names. Only the named fields are bound
// and the rest are dropped with the record, which is stated in the book and pinned by a case.
fn record_pattern_ahead<a>(c: (&a mut C)) -> bool {
    mut q = c.pos + 1;
    while true {
        if kind_at(&mut c, q) != 1 {
            return false;
        }
        q += 1;
        if kind_at(&mut c, q) == 125 {
            return kind_at(&mut c, q + 1) == 261;
        }
        if kind_at(&mut c, q) != 44 {
            return false;
        }
        q += 1;
    }
    return false;
}
fn record_destructure<a>(c: (&a mut C)) -> unit {
    expect(&mut c, view("{"));
    mut names = u8[][];
    while true {
        names.push(ident(&mut c));
        if eat(&mut c, view("}")) {
            break;
        }
        expect(&mut c, view(","));
    }
    expect(&mut c, view(":="));
    v := expr(&mut c, 0);
    expect(&mut c, view(";"));
    held := move_value(&mut c, v);
    ty := base_type(&mut c, held.ty);
    if ty_kind(&mut c, ty) != 8 {
        fail(&mut c, view("this pattern binds a record's fields, and the value is not a record"));
    }
    d := ty_arg(&mut c, ty);
    // Refusals before any binding is made: a name the type does not have, and the same name twice.
    // Without the second, one binding silently shadows the other and the reader cannot tell which.
    mut slots = u64[];
    for i in names.len() {
        idx := field_index(&mut c, d, view(names[i]));
        if idx == 0 {
            fail_unknown_field(&mut c, view(names[i]));
        }
        for j in i {
            if same(view(names[j]), view(names[i])) {
                mut msg = u8[];
                push_bytes(&mut msg, view("this field is bound twice in one pattern: "));
                push_bytes(&mut msg, view(names[i]));
                fail(&mut c, view(msg));
            }
        }
        slots.push(idx - 1);
    }
    if drop_type(&mut c, ty) != 0 {
        fail(&mut c, view("a value that implements Drop cannot be destructured"));
    }
    source := place_of(&mut c, held.t);
    for i in names.len() {
        fty := field_type(&mut c, ty, slots[i]);
        part := field_load(&mut c, held.t, ty, slots[i], 0);
        own(&mut c, part, fty);
        dest := place_of(&mut c, part);
        if contains_borrow(&mut c, fty, 0) {
            transfer_bonds(&mut c, source, dest);
        }
        stored_source(&mut c, part, fty);
        bind(&mut c, names[i].copy(), fty, part, 0);
    }
    move_out(&mut c, val(held.t, held.ty));
    if !framed(&mut c, held.ty) {
        // A plain record's words are its frame's: only a boxed record has a shell to free.
    invoke(&mut c, view("rt_free"), one(held.t));
    }
    return ();
}

// These declarations back concise syntax and are not public nominal types.
fn find_decl<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    here := module_copy(&mut c);
    if same(view(m), view("hashmap")) & same(view(n), view("Map")) & !same(view(here), view("hashmap")) {
        return 0;
    }
    found := find_decl_internal(&mut c, m, n);
    if (found != 0) && (c.decls[found - 1].public == 0) {
        // stays: `c.decls[found - 1]` is a borrowed element (see drop_hook_symbol).
        home := c.decls[found - 1].module.copy();
        require_visible(&mut c, view(home), view(n));
    }
    return found;
}
fn find_func<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    mut found = 0;
    func_index_sync(&mut c);
    if c.func_slots.len() != 0 {
        key := name_key(m, n);
        mask := c.func_slots.len() - 1;
        mut h = key & mask;
        while c.func_slots[h] != 0 {
            i := c.func_slots[h] - 1;
            if c.func_keys[i] == key {
                x := &c.funcs[i];
                if same(view(x.module), view(m)) & same(view(x.name), view(n)) {
                    found = i + 1;
                    break;
                }
            }
            h = (h + 1) & mask;
        }
    }
    if (found != 0) && (c.funcs[found - 1].public == 0) {
        // stays: a vector element read is a loan, so it conflicts with the call's &mut.
        home := c.funcs[found - 1].home.copy();
        require_visible(&mut c, view(home), view(n));
    }
    return found;
}
// Visibility (docs/design/separate-compilation.md, "Visibility"): an item declared without `pub` is
// private to the module that declares it. Naming it from any other module is refused; the trusted
// runtime and the compiler's own lookups (`vis_off`: interfaces being read) are not checked.
fn require_visible<a, b, d>(c: (&a mut C), home: &b [u8], name: &d [u8]) -> unit {
    if c.vis_off != 0 {
        return ();
    }
    here := module_copy(&mut c);
    // The runtime is the trusted base on both sides: it reaches every module's items, and the unsafe
    // modules that call into it reach its own, which never take `pub`.
    if same(view(here), view(home)) || same(view(here), view("runtime")) || same(view(home), view("runtime")) {
        return ();
    }
    // A compile-time call is the module's own code run early: its probe may name private items.
    if (c.probe_mode != 0) & same(view(here), view("grail_probe")) {
        return ();
    }
    mut text = copy_bytes(view("`"));
    push_bytes(&mut text, view(name));
    push_bytes(&mut text, view("` is private to module `"));
    push_bytes(&mut text, view(home));
    push_bytes(&mut text, view("`"));
    mut help = copy_bytes(view("declare it `pub` in `"));
    push_bytes(&mut help, view(home));
    push_bytes(&mut help, view("` to use it from `"));
    push_bytes(&mut help, view(here));
    push_bytes(&mut help, view("`"));
    diag_help(&mut c, view(help));
    fail(&mut c, view(text));
    return ();
}
// "`f` is declared twice": "duplicate function" named neither the name nor what a reader should do
// about the second one.
fn duplicate_msg<a, b>(c: (&a mut C), name: &b [u8]) -> u8[] {
    mut msg = copy_bytes(view("`"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("` is declared twice in this module: rename one, or remove it"));
    return msg;
}
// Field index within decl, failing when absent.
fn find_field<a, b>(c: (&a mut C), decl: u64, n: &b [u8]) -> u64 {
    home := c.decls[decl].name.copy();
    d := &c.decls[decl];
    first := d.first;
    count := d.count;
    for i in count {
        f := &c.fields[first + i];
        if same(view(f.name), view(n)) {
            return i;
        }
    }
    enum := c.decls[decl].is_enum;
    mut msg = copy_bytes(view("`"));
    push_bytes(&mut msg, view(home));
    if enum != 0 {
        push_bytes(&mut msg, view("` has no variant `"));
    } else {
        push_bytes(&mut msg, view("` has no field `"));
    }
    push_bytes(&mut msg, view(n));
    push_bytes(&mut msg, view("`"));
    fail(&mut c, view(msg));
    return 0;
}
fn field_ty<a>(c: (&a mut C), decl: u64, index: u64) -> u64 {
    d := &c.decls[decl];
    k := d.first + index;
    f := &c.fields[k];
    return f.ty;
}
fn module_copy<a>(c: (&a mut C)) -> u8[] {
    return c.module.copy();
}
fn vec_of<a>(c: (&a mut C), e: u64) -> u64 {
    if (ty_kind(&mut c, e) == 18)
        & (ty_arg(&mut c, e) == 8)
        & (ty_mode(&mut c, e) == 0) {
        return 2;
    }
    return intern(&mut c, 6, e);
}
fn named_type<a>(c: (&a mut C), m: u8[], n: u8[], args: u64[]) -> u64 {
    mut d = find_decl_internal(&mut c, view(m), view(n));
    if d == 0 {
        fail(&mut c, view("concise type needs its standard library module"));
    }
    d = d - 1;
    decl := &c.decls[d];
    if (decl.regions != 0) || (decl.types != args.len()) {
        fail(&mut c, view("concise type has incompatible library declaration"));
    }
    require_constraints(&mut c, &args, &declaration_bounds(&c, d));
    require_interfaces(&mut c, &args, &declaration_constraints(&c, d));
    return intern_args(&mut c, 8, d, 0, u64[], args);
}
// Union members use an internal tagged layout, independent of library declarations.
fn is_ordinary_union<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    d := ty_arg(&mut c, ty);
    decl := &c.decls[d];
    return same(view(decl.module), view(".union"));
}
fn is_result_union<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    d := ty_arg(&mut c, ty);
    decl := &c.decls[d];
    // `.outcome` is a join's result union: `?` and member-type arms work on it exactly as on
    // `T |? E`, which is why containment needed no new type machinery.
    if same(view(decl.module), view(".outcome")) {
        return same(view(decl.name), view("Failure")) == false;
    }
    return same(view(decl.module), view(".result"));
}
fn is_union<a>(c: (&a mut C), ty: u64) -> bool {
    return is_ordinary_union(&mut c, ty) || is_result_union(&mut c, ty);
}
fn result_success_count<a>(c: (&a mut C), ty: u64) -> u64 {
    d := ty_arg(&mut c, ty);
    decl := &c.decls[d];
    return decl.success;
}
fn append_ordinary<a>(c: (&a mut C), ty: u64, args: (&a mut u64[])) -> unit {
    if is_ordinary_union(&mut c, ty) {
        items := type_args(&mut c, ty);
        for i in items.len() {
            args.push(items[i]);
        }
    } else {
        args.push(ty);
    }
    return ();
}
// A union (`A | B`) naming one type twice: no value could be told apart, so one of them has to be
// wrapped. "duplicate union member" named neither the type nor the way out.
fn fail_duplicate_member<a>(c: (&a mut C), ty: u64) -> unit {
    named := source_type_name(&mut c, ty);
    mut msg = copy_bytes(view("the type `"));
    push_bytes(&mut msg, view(named));
    push_bytes(&mut msg, view("` appears twice in this union, so no value could be told apart: wrap one of them in a struct"));
    fail(&mut c, view(msg));
}
fn check_distinct_members<a>(c: (&a mut C), args: (&a u64[]), success: u64) -> unit {
    for i in args.len() {
        for j in i {
            if same_type(&mut c, args[i], args[j]) != 0 {
                fail_duplicate_member(&mut c, args[i]);
            }
        }
        if (success != 0) & (i < success) {
            for j in success..args.len() {
                if same_type(&mut c, args[i], args[j]) != 0 {
                    fail(&mut c, view("overlapping result union"));
                }
            }
        }
    }
    return ();
}
fn make_union<a>(c: (&a mut C), args: u64[], success: u64, module: u8[], prefix: &a [u8]) -> u64 {
    check_distinct_members(&mut c, &args, success);
    mut name = prefix.copy();
    decimal(&mut name, args.len());
    if success != 0 {
        name.push(95);
        decimal(&mut name, success);
    }
    mut d = find_decl_internal(&mut c, view(module), view(name));
    if d == 0 {
        first := c.fields.len();
        for i in args.len() {
            mut field = u8[];
            decimal(&mut field, i);
            param := intern_args(&mut c, 9, i, 0, u64[], u64[]);
            c.fields.push(Field { name: field, ty: param, pred: no_pred() });
        }
        mut bounds = u64[];
        mut constraints = u64[][];
        for i in args.len() {
            bounds.push(0);
            constraints.push(u64[]);
        }
        item_public_1 := c.decl_public;
        c
            .decls
            .push(
                Decl {
                    public: item_public_1,
                    module: module,
                    name: name, declared_at: u8[],
                    is_enum: 1,
                    opaque: 0,
                    transfer: 0,
                    share: 0,
                    c_layout: 0,
                    first: first,
                    count: args.len(),
                    drop: 0,
                    regions: 0,
                    types: args.len(),
                    success: success,
                    bounds: bounds,
                    constraints: constraints,
                }
            );
        d = c.decls.len();
    }
    return intern_args(&mut c, 8, d - 1, 0, u64[], args);
}
fn result_union_type<a>(c: (&a mut C), successes: u64[], failures: u64[]) -> u64 {
    mut args = u64[];
    for i in successes.len() {
        append_ordinary(&mut c, successes[i], &mut args);
    }
    success := args.len();
    for i in failures.len() {
        append_ordinary(&mut c, failures[i], &mut args);
    }
    return make_union(&mut c, args, success, copy_bytes(view(".result")), view("Result"));
}

fn parse_type<a>(c: (&a mut C)) -> u64 {
    mut t = 0;
    // Maps participate in postfix and union composition like other types.
    if is(&mut c, view("[")) {
        advance(&mut c);
        k := parse_type(&mut c);
        if eat(&mut c, view(";")) {
            // `[T; N]`: N elements of T back to back, in C layout (docs/design/fixed-arrays.md).
            // `N` may be a value parameter (`fn f<@n: u64>(a: &[f32; n])`): bound, it is the constant;
            // in a template it is the parameter itself, carried as the array's one type argument
            // until a specialisation binds it (bind_types, infer_type).
            if (kind(&mut c) == 1) && (value_param(&mut c, view(tok_text(&mut c, c.pos))) != 0) && (kind_at(&mut c, c.pos + 1) == 93) {
                mut lenty = type_level_value(&mut c);
                // A binding may arrive behind an indirection (kind 10), as value_param_value says.
                while (lenty != NO_TYPE) && is_type_id(lenty) && (ty_kind(&mut c, lenty) == 10) {
                    lenty = ty_arg(&mut c, lenty);
                }
                expect(&mut c, view("]"));
                if ty_kind(&mut c, lenty) == 31 {
                    if ty_arg(&mut c, lenty) == 0 {
                        fail(&mut c, view("an array length is a positive integer constant"));
                    }
                    return type_suffixes(&mut c, intern_args(&mut c, 32, k, ty_arg(&mut c, lenty), u64[], u64[]));
                }
                return type_suffixes(&mut c, intern_args(&mut c, 32, k, 0, u64[], u64[lenty]));
            }
            n := ct_expr(&mut c, 0);
            if (n.ty != 0) || (n.value == 0) {
                fail(&mut c, view("an array length is a positive integer constant"));
            }
            expect(&mut c, view("]"));
            t = intern_args(&mut c, 32, k, n.value, u64[], u64[]);
        } else {
            expect(&mut c, view(":"));
            v := parse_type(&mut c);
            expect(&mut c, view("]"));
            mut ma = u64[];
            ma.push(k);
            ma.push(v);
            t = named_type(&mut c, copy_bytes(view("hashmap")), copy_bytes(view("Map")), ma);
        }
    } else {
        t = parse_type_base(&mut c);
    }
    while true {
        t = type_suffixes(&mut c, t);
        if !eat(&mut c, view("?")) {
            break;
        }
        mut oa = u64[];
        oa.push(t);
        // `T?` is the concise spelling of `result::Option<T>`, the one option type the language has.
        t = named_type(&mut c, copy_bytes(view("result")), copy_bytes(view("Option")), oa);
    }
    if c.no_union == 0 {
        mut members = u64[];
        append_ordinary(&mut c, t, &mut members);
        while is(&mut c, view("|")) {
            mut p = c.pos;
            if is_at(&mut c, p + 1, view("?")) {
                advance(&mut c);
                advance(&mut c);
                mut failures = u64[];
                mut f = parse_union_member(&mut c);
                append_ordinary(&mut c, f, &mut failures);
                while is(&mut c, view("|")) {
                    p = c.pos;
                    if is_at(&mut c, p + 1, view("?")) {
                        fail(&mut c, view("result union |? is non-associative"));
                    }
                    advance(&mut c);
                    f = parse_union_member(&mut c);
                    append_ordinary(&mut c, f, &mut failures);
                }
                return result_union_type(&mut c, members, failures);
            }
            advance(&mut c);
            m := parse_union_member(&mut c);
            append_ordinary(&mut c, m, &mut members);
        }
        if 1 < members.len() {
            return make_union(&mut c, members, 0, copy_bytes(view(".union")), view("Union"));
        }
    }
    return t;
}
fn parse_union_member<a>(c: (&a mut C)) -> u64 {
    old := exchange(&mut c.no_union, 1);
    t := parse_type(&mut c);
    exchange(&mut c.no_union, old);
    return t;
}
fn type_suffixes<a>(c: (&a mut C), base: u64) -> u64 {
    mut out = base;
    while is(&mut c, view("[")) {
        advance(&mut c);
        expect(&mut c, view("]"));
        out = vec_of(&mut c, out);
    }
    return out;
}
fn token_starts_type<a>(c: (&a mut C), p: u64) -> bool {
    k := kind_at(&mut c, p);
    if k == 1 {
        return true;
    }
    return (k == 40) || (k == 91) || (k == 38);
}
fn type_keyword<a>(c: (&a mut C), n: &a [u8]) -> bool {
    if same(view(n), view("bool")) || same(view(n), view("char")) || same(view(n), view("string")) || same(view(n), view("u64")) {
        return true;
    }
    if same(view(n), view("u8")) || same(view(n), view("u16")) || same(view(n), view("u32")) || same(view(n), view("u64")) {
        return true;
    }
    if same(view(n), view("i8"))
        || same(view(n), view("i16"))
        || same(view(n), view("i32"))
        || same(view(n), view("i64"))
        || same(view(n), view("isize")) {
        return true;
    }
    if same(view(n), view("f32")) || same(view(n), view("f64")) || same(view(n), view("unit")) || same(view(n), view("read")) {
        return true;
    }
    if same(view(n), view("mut")) || same(view(n), view("Atomic")) || same(view(n), view("Mutex")) || same(view(n), view("Scope")) || is_simd_name(view(n)) {
        return true;
    }
    return same(view(n), view("Task"))
        || same(view(n), view("Job"))
        || same(view(n), view("CancelToken"))
        || same(view(n), view("fn"))
        || same(view(n), view("Fn"))
        || same(view(n), view("FnMut"));
}
fn lifetime_candidate<a>(c: (&a mut C), p: u64) -> bool {
    if kind_at(&mut c, p) != 1 {
        return false;
    }
    n := tok_text(&mut c, p);
    if n.len() == 0 {
        return false;
    }
    if (n[0] < 97) || (122 < n[0]) {
        return false;
    }
    if type_keyword(&mut c, view(n)) {
        return false;
    }
    // `&dyn I` is a reference to an interface object, not lifetime `dyn`.
    if same(view(n), view("dyn")) && ((kind_at(&mut c, p + 1) == 1) || (kind_at(&mut c, p + 1) == 60)) {
        return false;
    }
    return token_starts_type(&mut c, p + 1) || is_at(&mut c, p + 1, view("mut"));
}
fn is_at<a, b>(c: (&a mut C), p: u64, text: &b [u8]) -> bool {
    if c.toks.len() <= p {
        return false;
    }
    st := c.toks[p].start;
    if c.toks[p].end - st != text.len() {
        return false;
    }
    for k in text.len() {
        if c.src[st + k] != text[k] {
            return false;
        }
    }
    return true;
}
fn lifetime_region<a>(c: (&a mut C), name: &a [u8]) -> u64 {
    for i in c.rnames.len() {
        r := &c.rnames[i];
        if same(view(r), view(name)) {
            return i + 1;
        }
    }
    if (name.len() != 0) & (96 < name[0]) & (name[0] < 123) {
        c.rnames.push(name.copy());
        return c.rnames.len();
    }
    fail(&mut c, view("undeclared lifetime"));
    return 0;
}
fn fresh_lifetime<a>(c: (&a mut C)) -> u64 {
    mut name = u8[];
    name.push(35);
    decimal(&mut name, c.rnames.len());
    c.rnames.push(name);
    return c.rnames.len();
}
fn slice_ahead<a>(c: (&a mut C), p: u64) -> bool {
    mut i = p + 1;
    mut depth = 0;
    while i < c.toks.len() {
        k := kind_at(&mut c, i);
        if k == 0 {
            return false;
        }
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        }
        if (k == 41) || (k == 93) || (k == 125) {
            if depth == 0 {
                return k == 93;
            }
            depth -= 1;
        }
        // `[K: V]` is a map and `[T; N]` an array, so `&` before either is a reference, not a slice.
        if (depth == 0) & ((k == 58) || (k == 59)) {
            return false;
        }
        i += 1;
    }
    return false;
}
fn parse_slice_reference<a>(c: (&a mut C), mode: u64, r: u64) -> u64 {
    expect(&mut c, view("["));
    elem := parse_type(&mut c);
    expect(&mut c, view("]"));
    mut rs = u64[];
    rs.push(r);
    if elem != int_type(&mut c, 8, 0) {
        // `&[T]` / `&mut [T]`: a typed slice of any other element type (docs/design/typed-slices.md).
        return intern_full(&mut c, 27, elem, mode, rs);
    }
    return intern_full(&mut c, 5, 0, mode, rs);
}
fn note_input_region<a>(c: (&a mut C), r: u64) -> unit {
    for i in c.input_regions.len() {
        if c.input_regions[i] == r {
            return ();
        }
    }
    c.input_regions.push(r);
    return ();
}
fn outer_region<a>(c: (&a mut C), ty: u64) -> u64 {
    rs := type_regions(&mut c, ty);
    if rs.len() == 0 {
        return 0;
    }
    return rs[0];
}
fn parse_reference<a>(c: (&a mut C)) -> u64 {
    mut mode = 0;
    mut r = 0;
    mut p = c.pos;
    if is(&mut c, view("mut")) {
        advance(&mut c);
        mode = 1;
        p = c.pos;
        if lifetime_candidate(&mut c, p) {
            fail(&mut c, view("write &a mut T, not &mut a T"));
        }
    } else {
        if lifetime_candidate(&mut c, p) {
            n := tok_text(&mut c, p);
            r = lifetime_region(&mut c, view(n));
            advance(&mut c);
            if eat(&mut c, view("mut")) {
                mode = 1;
            }
        }
    }
    if r == 0 {
        if c.parsing_input != 0 {
            r = fresh_lifetime(&mut c);
        } else if c.output_region != 0 {
            r = c.output_region;
        } else if dyn_type_ahead(&mut c) {
            // `r: &dyn I = &x` in a body names an inferred local borrow: like `&x`, the value carries
            // no named region, and the loan on the referent is what the checker follows.
        } else {
            fail(&mut c, view("elided output reference needs one input lifetime"));
        }
    }
    if c.parsing_input != 0 {
        note_input_region(&mut c, r);
    }
    p = c.pos;
    if is(&mut c, view("[")) & slice_ahead(&mut c, p) {
        return parse_slice_reference(&mut c, mode, r);
    }
    old := exchange(&mut c.no_union, 1);
    mut e = parse_type(&mut c);
    exchange(&mut c.no_union, old);
    // `&Self` in an impl whose owner is a slice is the slice reference itself, exactly as `&self`
    // is (receiver_reference): `Self` there names `&[T]`, which is already a reference.
    k := ty_kind(&mut c, e);
    if (e == c.self_type) & ((k == 27) || (k == 5)) {
        mut srs = u64[];
        srs.push(r);
        return intern_full(&mut c, k, ty_arg(&mut c, e), mode, srs);
    }
    if ty_kind(&mut c, e) == 33 {
        // `&dyn I` / `&mut dyn I`: a borrowed interface object, not a reference to an owned one. Its
        // referent is the borrowed-object marker (35), which is what the type system prints as `dyn
        // I` and what dispatch recognizes.
        e = intern_full(&mut c, 35, e, 0, u64[]);
    }
