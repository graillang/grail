        if k == 19 {
            invoke(borrow_mut(c), &"rt_fmt_bool", two(acc, value.t));
        } else {
            if k == 18 {
                code := int_code(borrow_mut(c), value.ty);
                cv := imm(borrow_mut(c), code);
                invoke(borrow_mut(c), &"rt_fmt_int", three(acc, value.t, cv));
            } else {
                if (k == 3) + (k == 4) + (k == 5) {
                    invoke(borrow_mut(c), &"rt_fmt_seq", two(acc, value.t));
                } else {
                    if k != 0 {
                        fail(
                            borrow_mut(c),
                            &"format arguments must be u64, sized integers, bool, text, byte views or have show()"
