            }
            return param;
        }
    }
    if same(view(first), view("Self")) & ((c.self_type != NO_TYPE)) {
        mut st = c.self_type;
        if c.bindings.len() != 0 {
            st = bind_types(&mut c, st, &copy_numbers(&c.bindings));
        }
        if is(&mut c, view("::")) && (next_kind(&mut c) == 1) {
            advance(&mut c);
            assoc_name := ident(&mut c);
            return assoc_type(&mut c, st, view(assoc_name));
        }
        return st;
    }
    if eat(&mut c, view("::")) {
        n := ident(&mut c);
        a := find_alias(&mut c, view(first), view(n));
        if a != 0 {
            aty := c.aliases[a - 1].ty;
            // An alias that names u64 has type id 0, so only NO_TYPE is unresolved here. Reading 0
            // as "no type" refused `module::Word` for `type Word = u64;`; this is the hazard.
            if aty == NO_TYPE {
                fail(&mut c, view("recursive or unresolved type alias"));
            }
            return aty;
        }
        d := find_decl(&mut c, view(first), view(n));
        if d == 0 {
            fail(&mut c, view("unknown type"));
        }
        return nominal_type(&mut c, d - 1);
    }
    if same(view(first), view("Fn")) || same(view(first), view("FnMut")) {
        // `Fn` is callable through a shared reference; `FnMut` needs exclusive access to the value.
        fnmut := u64(same(view(first), view("FnMut")));
        expect(&mut c, view("("));
        mut params = u64[];
        if !eat(&mut c, view(")")) {
            while true {
                ty := parse_type(&mut c);
                params.push(ty);
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        if 5 < params.len() {
            fail(&mut c, view("closure type exceeds five parameters"));
        }
        expect(&mut c, view("->"));
        result := parse_type(&mut c);
        return intern_args(&mut c, 20, result, fnmut, u64[], params);
    }
    if same(view(first), view("cfn")) {
        // C function pointer: one word, no environment, called with the C ABI. Only
        // `extern "C"` definitions have such an address, so a closure cannot sneak in.
        expect(&mut c, view("("));
        mut params = u64[];
        if !eat(&mut c, view(")")) {
            while true {
                mut ty = 0;
                if ffi_byval_ahead(&mut c) {
                    advance(&mut c);
                    ty = ffi_byval_parameter(&mut c);
                } else {
                    ty = parse_type(&mut c);
                }
                params.push(ty);
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        if 64 < params.len() {
            fail(&mut c, view("cfn type exceeds 64 arguments"));
        }
        for i in params.len() {
            // `&mut R` of an extern record is the C `R *` a callback writes through (copy-in/copy-out
            // in the callback, the record's own address at a call); any other out-parameter is a
            // declaration-only feature.
            if ffi_out_param(&mut c, params[i]) & (ffi_record_out_param(&mut c, params[i]) == 0) {
                fail(
                    &mut c,
                    view("an out-parameter is only for an extern \"C\" declaration; a cfn type cannot declare one")
                );
            }
            ffi_direct_param(
                &mut c,
                params[i],
                view("cfn parameters must be an integer, f32, f64, CStr, handle, byte view, cfn, extern record or byval record")
            );
        }
        expect(&mut c, view("->"));
        result := parse_type(&mut c);
        return intern_args(&mut c, 25, result, 0, u64[], params);
    }
    if same(view(first), view("fn")) {
        expect(&mut c, view("("));
        mut params = u64[];
        if !eat(&mut c, view(")")) {
            while true {
                ty := parse_type(&mut c);
                params.push(ty);
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        expect(&mut c, view("->"));
        result := parse_type(&mut c);
        return intern_args(&mut c, 12, result, 0, u64[], params);
    }
    named := int_name(view(first));
    if named != 0 {
        return int_type_named(&mut c, named);
    }
    if same(view(first), view("bool")) {
        return bool_type(&mut c);
    }
    if same(view(first), view("f64")) {
        return float_type(&mut c);
    }
    if same(view(first), view("f32")) {
        return f32_type(&mut c);
    }
    if same(view(first), view("char")) {
        return char_type(&mut c);
    }
    if same(view(first), view("u64")) {
        return 0;
    }
    if same(view(first), view("unit")) {
        return 1;
    }
    if same(view(first), view("string")) {
        return 3;
    }
    if same(view(first), view("CPtr")) || same(view(first), view("CMutPtr")) {
        // One word: a bare C data pointer (`const void *` / `void *`) into Grail-owned bytes,
        // made by `unsafe cptr(view)` / `unsafe cptr_mut(&mut bytes)`. Mode 1 is writable.
        mode := u64(same(view(first), view("CMutPtr")));
        return intern_full(&mut c, 26, 0, mode, u64[]);
    }
    if same(view(first), view("CStr")) {
        // One word: a NUL-terminated byte pointer owned by the C side. Building one
        // is `unsafe cstr(view)` because it asserts termination and lifetime.
        return intern(&mut c, 24, 0);
    }
    if same(view(first), view("read")) || same(view(first), view("mut")) {
        fail(&mut c, view("legacy byte-view types were removed; write &[u8] or &mut [u8]"));
    }
    // User declarations shadow the built-in generic types (a program may declare its own `Task`).
    here_module := module_copy(&mut c);
    shadowed := find_decl(&mut c, view(here_module), view(first)) != 0;
    if (shadowed == false) & same(view(first), view("Atomic")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        if e != 0 {
            fail(&mut c, view("Atomic currently requires u64 (one aligned 64-bit word)"));
        }
        return intern(&mut c, 11, 0);
    }
    if (shadowed == false) & same(view(first), view("Scope")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return intern(&mut c, 14, e);
    }
    if (shadowed == false) & same(view(first), view("Task")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return intern(&mut c, 16, e);
    }
    if (shadowed == false) & same(view(first), view("Job")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return intern(&mut c, 29, e);
    }
    if (shadowed == false) & same(view(first), view("CancelToken")) {
        return intern(&mut c, 17, 0);
    }
    if (shadowed == false) & same(view(first), view("TaskFailure")) {
        // What a `try_join` produces when the task failed: kind, message and site. A synthesized
        // record, named like the other built-in types (see task_failure_type).
        return task_failure_type(&mut c);
    }
    if (shadowed == false) & same(view(first), view("Mutex")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return mutex_type(&mut c, e);
    }

    mut m = module_copy(&mut c);
    a := find_alias(&mut c, view(m), view(first));
    if a != 0 {
        aty := c.aliases[a - 1].ty;
        if aty == NO_TYPE {
            fail(&mut c, view("recursive or unresolved type alias"));
        }
        return aty;
    }
    imported := resolve_import(&mut c, view(first));
    if imported.len() != 0 {
        m = imported;
    }
    d := find_decl(&mut c, view(m), view(first));
    if d == 0 {
        fail(&mut c, view("unknown type"));
    }
    return nominal_type(&mut c, d - 1);
}
// ---- top level: pass 1 names, pass 2 fields/signatures/prototypes, pass 3 bodies ----
// --export NAME promotes the definition with that declared name to a global symbol. Matching is by
// declared name in any module, so the flag does not depend on mangling or on the object format.
fn exported<a, b>(c: (&a mut C), n: &b [u8]) -> u64 {
    mut hit = 0;
    for i in c.exports.len() {
        e := c.exports[i].copy();
        if same(view(e), view(n)) {
            cur := c.export_hits[i];
            mut h = &mut c.export_hits[i];
            exchange(&mut h, cur + 1);
            hit = 1;
        }
    }
    return hit;
}
fn mangle_into<a, b, d>(out: (&a mut u8[]), plat: u64, m: &b [u8], n: &d [u8]) -> unit {
    if plat == 1 {
        out.push(95);
    }
    if same(view(m), view("runtime")) {
        push_bytes(&mut out, n);
        return ();
    }
    push_bytes(&mut out, view("f_"));
    push_bytes(&mut out, m);
    out.push(95);
    push_bytes(&mut out, n);
    return ();
}
// The unit name a symbol spells. `.inherent_K`, `.impl_K` and `.interface_K` are positions in this
// run's declaration tables - good keys inside one run, but two runs that compile different modules
// number them differently, so a module calling another's method would name a symbol the other
// object never defines. The symbol spells the declaration instead: the type's module and name, the
// interface's module and name, and for an implementation also a digest of the implementing type
// (B1 stage 4).
fn symbol_unit<a, b>(c: (&a mut C), m: &b [u8]) -> u8[] {
    if starts_with(view(m), view(".inherent_")) {
        n := module_index(view(m), 10);
        if (n != 0) & (n <= c.decls.len()) {
            mut out = copy_bytes(view(".inherent$"));
            push_bytes(&mut out, view(c.decls[n - 1].module));
            out.push(36);
            push_bytes(&mut out, view(c.decls[n - 1].name));
            return out;
        }
    }
    if starts_with(view(m), view(".impl_")) {
        n := module_index(view(m), 6);
        if (1 < n) & (n - 1 <= c.implementations.len()) {
            contract := c.implementations[n - 2].contract;
            ty := c.implementations[n - 2].ty;
            mut out = copy_bytes(view(".impl$"));
            push_bytes(&mut out, view(c.implementations[n - 2].module));
            out.push(36);
            if (contract != 0) & (contract <= c.interfaces.len()) {
                push_bytes(&mut out, view(c.interfaces[contract - 1].name));
            }
            out.push(36);
            mut key = u8[];
            type_key(&mut c, &mut key, ty, 0);
            digest := iface_digest(&key);
            for i in 16 {
                out.push(digest[i]);
            }
            return out;
        }
    }
    if starts_with(view(m), view(".interface_")) {
        n := module_index(view(m), 11);
        if (1 < n) & (n - 1 <= c.interfaces.len()) {
            mut out = copy_bytes(view(".interface$"));
            push_bytes(&mut out, view(c.interfaces[n - 2].module));
            out.push(36);
            push_bytes(&mut out, view(c.interfaces[n - 2].name));
            return out;
        }
    }
    return m.copy();
}
fn mangle<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> unit {
    spelling := mangle_name(&mut c, view(m), view(n));
    push_bytes(&mut c.out, view(spelling));
    return ();
}
// The symbol `mangle` writes, as a value: a call's edge has to name the symbol the call names.
fn mangle_name<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u8[] {
    plat := c.plat;
    unit := symbol_unit(&mut c, m);
    mut out = u8[];
    mangle_into(&mut out, plat, view(unit), n);
    return out;
}
// The symbol a function body is emitted under, as a value: the one thing the fact table is keyed
// by, and the only part of a body that is known before the body is parsed.
fn body_label<a, b, d, e>(c: (&a C), m: &b [u8], n: &d [u8], symbol: &e [u8], export: u64) -> u8[] {
    mut out = u8[];
    if export == 2 {
        if c.plat == 1 {
            out.push(95);
        }
        push_bytes(&mut out, symbol);
        if c.target == 3 {
            push_bytes(&mut out, view("_grail_body"));
        }
        return out;
    }
    mangle_into(&mut out, c.plat, m, n);
    return out;
}
fn alias_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("type"));
    name := ident(&mut c);
    module := module_copy(&mut c);
    expect(&mut c, view("="));
    if pass == 1 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        expect(&mut c, view(";"));
        if find_alias(&mut c, view(module), view(name)) != 0 {
            fail(&mut c, view("duplicate type alias"));
        }
        alias_public := c.decl_public;
        c.aliases.push(Alias { module: module, name: name, public: alias_public, ty: NO_TYPE });
        return ();
    }
    if pass == 3 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        expect(&mut c, view(";"));
        return ();
    }
    ty := parse_type(&mut c);
    expect(&mut c, view(";"));
    a := find_alias(&mut c, view(module), view(name));
    if a == 0 {
        fail(&mut c, view("unknown type alias"));
    }
    entry := &mut c.aliases[a - 1];
    exchange(&mut entry.ty, ty);
    return ();
}
// `handle Name;` declares an opaque C handle type. Safe code can bind, compare and
// pass it, but cannot construct, size, inspect or drop one: it is a foreign token.
fn handle_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("handle"));
    name := ident(&mut c);
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    // The audited foreign-resource contract, stated where the handle is declared:
    //   handle File: transferable;              owned, movable, not concurrently usable
    //   handle Socket: transferable, shareable; safe to move and to use from several threads
    //   handle Window;                          thread-affine: neither (the default)
    // Nothing declared is neither, so an unaudited handle cannot reach a worker by accident.
    mut transfer = 0;
    mut share = 0;
    if eat(&mut c, view(":")) {
        mut more = 1;
        while more != 0 {
            if is(&mut c, view("transferable")) {
                transfer = 1;
            } else {
                if is(&mut c, view("shareable")) {
                    share = 1;
                } else {
                    fail(
                        &mut c,
                        view("a handle is classified `transferable` or `transferable, shareable`; a handle with no classification is thread-affine (neither)")
                    );
                }
            }
            advance(&mut c);
            more = u64(eat(&mut c, view(",")));
        }
    }
    if (share != 0) & (transfer == 0) {
        fail(
            &mut c,
            view("`shareable` implies `transferable`: a value that may be used on another thread may also be moved to it")
        );
    }
    expect(&mut c, view(";"));
    if pass != 1 {
        return ();
    }
    m := module_copy(&mut c);
    if (find_decl(&mut c, view(m), view(name)) != 0) || (find_alias(&mut c, view(m), view(name)) != 0) {
        fail(&mut c, view("duplicate type"));
    }
    item_public_2 := c.decl_public;
    c
        .decls
        .push(
            Decl {
                public: item_public_2,
                module: m,
                name: name,
                is_enum: 0,
                opaque: 1,
                transfer: transfer,
                share: share,
                c_layout: 0,
                first: 0,
                count: 0,
                drop: 0,
                regions: 0,
                types: 0,
                success: 0,
                bounds: u64[],
                constraints: u64[][],
            }
        );
    return ();
}
fn decl<a>(c: (&a mut C), pass: u64) -> unit {
    is_enum := u64(is(&mut c, view("enum")));
    advance(&mut c);
    name := ident(&mut c);
    lifetime_parameters(&mut c);
    // `unsafe struct C<T>: transferable, shareable`: an audited capability contract for a record
    // that holds raw pointers or foreign state on purpose. The hook is the `unsafe` keyword, so a
    // plain `struct` cannot claim a classification by accident.
    unsafe_decl := exchange(&mut c.pending_unsafe, 0);
    mut transfer = 0;
    mut share = 0;
    if eat(&mut c, view(":")) {
        if unsafe_decl == 0 {
            fail(&mut c, view("a capability classification needs `unsafe struct`: `unsafe struct C<T>: transferable, shareable`"));
        }
        if is_enum != 0 {
            fail(&mut c, view("a capability classification is for a struct, not an enum"));
        }
        mut more = 1;
        while more != 0 {
            if is(&mut c, view("transferable")) {
                transfer = 1;
            } else {
                if is(&mut c, view("shareable")) {
                    share = 1;
                } else {
                    fail(
                        &mut c,
                        view("a struct is classified `transferable` or `transferable, shareable`; a struct with no classification stays thread-affine")
                    );
                }
            }
            advance(&mut c);
            more = u64(eat(&mut c, view(",")));
        }
    }
    if (share != 0) & (transfer == 0) {
        fail(
            &mut c,
            view("`shareable` implies `transferable`: a value that may be used on another thread may also be moved to it")
        );
    }
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    regions := c.rnames.len();
    types := c.tnames.len();
    bounds := copy_numbers(&c.type_bounds);
    constraints := copy_constraints(&c.type_interfaces);
    if pass != 2 {
        if pass == 1 {
            m := module_copy(&mut c);
            item_public_3 := c.decl_public;
            c
                .decls
                .push(
                    Decl {
                        public: item_public_3,
                        module: m,
                        name: name,
                        is_enum: is_enum,
                        opaque: 0,
                        transfer: transfer,
                        share: share,
                        c_layout: 0,
                        first: 0,
                        count: 0,
                        drop: 0,
                        regions: regions,
                        types: types,
                        success: 0,
                        bounds: bounds,
                        constraints: constraints,
                    }
                );
        }
        skip_braces(&mut c);
        eat(&mut c, view(";"));
        return ();
    }
    m := module_copy(&mut c);
    d := find_decl(&mut c, view(m), view(name));
    mut pending = Field[];
    mut count = 0;
    expect(&mut c, view("{"));
    if !eat(&mut c, view("}")) {
        while true {
            f := ident(&mut c);
            mut ty = 1;
            mut fp = no_pred();
            if is_enum != 0 {
                if eat(&mut c, view("(")) {
                    ty = parse_type(&mut c);
                    expect(&mut c, view(")"));
                }
            } else {
                expect(&mut c, view(":"));
                ty = parse_type(&mut c);
                // `field: T where P`: the field's refinement (docs/design/refinements.md).
                if is(&mut c, view("where")) {
                    advance(&mut c);
                    fp = pred_scan(&mut c, view(","), view("}"));
                }
            }
            pending.push(Field { name: f, ty: ty, pred: fp });
            count = count + 1;
            if eat(&mut c, view("}")) {
                break;
            }
            expect(&mut c, view(","));
            if eat(&mut c, view("}")) {
                break;
            }
        }
    }
    eat(&mut c, view(";"));
    mut reverse = Field[];
    while pending.len() != 0 {
        reverse.push(pending.pop());
    }
    first := c.fields.len();
    while reverse.len() != 0 {
        c.fields.push(reverse.pop());
    }
    item_public_4 := c.decl_public;
    exchange(
        &mut c.decls[d - 1],
        Decl {
            public: item_public_4,
            module: m,
            name: name,
            is_enum: is_enum,
            opaque: 0,
            transfer: transfer,
            share: share,
            c_layout: 0,
            first: first,
            count: count,
            drop: 0,
            regions: c.rnames.len(),
            types: types,
            success: 0,
            bounds: bounds,
            constraints: constraints,
        }
    );
    return ();
}
// Words that start a statement or expression inside a body; they cannot name a binding or
// parameter. Declaration heads (`fn`, `struct`, `module`, `use`, ...) are recognised only at the
// top level and may name bindings.
fn is_keyword<a>(name: &a [u8]) -> bool {
    words := u8[][copy_bytes(view("mut")), copy_bytes(view("if")), copy_bytes(view("else")), copy_bytes(view("while")), copy_bytes(view("for")), copy_bytes(view("in")), copy_bytes(view("loop")), copy_bytes(view("match")), copy_bytes(view("return")), copy_bytes(view("break")), copy_bytes(view("continue")), copy_bytes(view("unsafe")), copy_bytes(view("true")), copy_bytes(view("false"))];
    for i in words.len() {
        if same(view(words[i]), view(name)) {
            return true;
        }
    }
    return false;
}
fn bind<a>(c: (&a mut C), name: u8[], ty: u64, id: u64, mutable: u64) -> unit {
    // Every binding goes through here, so this is where the facts about the shadowed name stop being
    // about anything - and where they come back, when the block that made the binding closes.
    pv_ir_shadow(&mut c, view(name));
    if is_keyword(view(name)) {
        fail(&mut c, view("a keyword cannot name a binding"));
    }
    if c.raw == 0 {
        if place_of(&mut c, id) == 0 {
            kind := ty_kind(&mut c, ty);
            if (kind == 1) || (kind == 2) || (kind == 12) || (kind == 17) || (kind == 18) || (kind == 19) || (kind == 21) || (kind == 22) || (kind == 26) {
                place := ownership::root(&mut c.check, 1, 1);
                c
                    .resources
                    .push(
                        Resource {
                            slot: id,
                            ty: ty,
                            flag: 0,
                            base: 0,
                            field: 0,
                            via: 0,
                            place: place,
                            target: 0,
                            authority: 0,
                        }
                    );
            }
        }
    }
    from := c.pos;
    last := last_name(&mut c, view(name), from, c.scope_end);
    mut debug_name = u8[];
    if c.debug != 0 {
        debug_name = copy_bytes(view(name));
    }
    c
        .locals
        .push(
            Local {
                name: name,
                ty: ty,
                id: id,
                last: last,
                born: from,
                mutable: mutable,
                flex: 0,
                lit: 0,
                neg: 0,
                origin: 0,
                at: 0,
            }
        );
    emit_slot_fact(&mut c, ty, id);
    if c.debug != 0 {
        line := source_line(&c, from);
        c
            .debug_vars
            .push(
                DebugVar {
                    name: debug_name,
                    slot: id,
                    line: line,
                    param: 0,
                    tname: debug_type_name(&mut c, ty),
                    tenc: debug_type_encoding(&mut c, ty),
                    tsize: debug_type_size(&mut c, ty),
                    ty: debug_type_of(&mut c, ty, 0)
                }
            );
    }
    return ();
}
// Documents a typed-IR fact: a binding's frame slot holds an f32 (docs/design/typed-ir.md, F2).
// The table travels beside the word stream and only the LLVM lifter reads it; a slot reused for a
// non-f32 binding, or one the body touches in any way other than one eight-byte word at a time,
// is dropped there and keeps the untyped lowering.
// F1: `what` for a value whose word is a pointer to a sequence header -- 2/3/4 for a vector whose
// elements are 8, 4 or 1 bytes wide (`+16` is `cap`), 5 for a descriptor `{data, len}`, whose
// `+16` is uninitialised and must never be read -- and 0 for anything else.
fn header_what<a>(c: (&a mut C), ty: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    t := base_type(&mut c, ty);
    k := ty_kind(&mut c, t);
    if (k == 3) || (k == 4) {
        return 4;
    }
    if k != 6 {
        return 0;
    }
    e := ty_arg(&mut c, t);
    if narrow_code(&mut c, e) != 0 {
        return 3;
    }
    return 2;
}
// F1: the element width of a sequence header, which is not the header's own stride.
fn header_width<a>(c: (&a mut C), ty: u64) -> u64 {
    t := base_type(&mut c, ty);
    k := ty_kind(&mut c, t);
    if (k == 3) || (k == 4) {
        return 1;
    }
    e := ty_arg(&mut c, t);
    if narrow_code(&mut c, e) != 0 {
        return 4;
    }
    return 8;
}
// F1: argument 0 of the call just emitted is the header of `seq`, whose element type the word
// stream loses. The lifter types the accessor's parameter with it and reads `data`/`len` once.
fn fact_seq_arg<a>(c: (&a mut C), callee: &[u8], seq: u64, seqty: u64) -> unit {
    if (c.backend == 0) || (c.validating != 0) || (c.raw != 0) || (c.facts_fn.len() == 0) {
        return ();
    }
    hw := header_what(&mut c, seqty);
    if hw == 0 {
        return ();
    }
    name := copy_bytes(view(c.facts_fn));
    cn := copy_bytes(callee);
    wd := header_width(&mut c, seqty);
    llvm::fact_header_arg(&mut c.facts, name, c.f1_ord, cn, hw, wd);
    return ();
}
fn emit_slot_fact<a>(c: (&a mut C), ty: u64, slot: u64) -> unit {
    // An `unsafe module` type-checks nothing, so in one a slot's declared type says nothing about
    // what is written to it; the fact is only sound where the front end enforces the type.
    if (c.backend == 0) || (c.validating != 0) || (c.raw != 0) || (c.facts_fn.len() == 0) {
        return ();
    }
    name := copy_bytes(view(c.facts_fn));
    hw := header_what(&mut c, ty);
    if c.f1_what != 0 {
        wd := header_width(&mut c, ty);
        llvm::fact_header_slot(&mut c.facts, name, slot, c.f1_what, wd);
        return ();
    }
    if hw != 0 {
        // The slot holds a sequence header: the pointer type and the element width are the fact.
        wd := header_width(&mut c, ty);
        llvm::fact_header_slot(&mut c.facts, name, slot, hw, wd);
        return ();
    }
    f32 := u64(is_f32(&mut c, ty));
    llvm::fact_slot(&mut c.facts, name, slot, f32);
    return ();
}
// `op(lhs, rhs)` on floats. With `single` (both operands' static type is f32) the call carries the
// fact the LLVM lifter rewrites into real `f* float` arithmetic; an f64 call gets none and keeps
// the word lowering. `invoke` has just recorded which call this is, and the opcode travels with
// the fact so the lifter needs neither the immediate nor a second look at the word.
fn float_op_call<a>(c: (&a mut C), op: u64, lhs: u64, rhs: u64, single: u64) -> u64 {
    opv := imm(&mut c, op);
    t := invoke(&mut c, view("rt_f64_op"), three(opv, lhs, rhs));
    if (single != 0) & (c.backend != 0) & (c.validating == 0) & (c.facts_fn.len() != 0) {
        llvm::fact_op(&mut c.facts, copy_bytes(view(c.facts_fn)), c.call_ord, op);
    }
    return t;
}
// ---- v3 C FFI: foreign declarations ----
// `extern "C" [lib "INPUT"] [as "SYMBOL"] fn NAME(params) -> RESULT;` declares a
// symbol the host linker resolves. The declaration has no body and the call sites
// must sit inside an `unsafe { ... }` block. Only the C ABI is accepted; there is
// no implicit fallback to another convention.
// Number of C argument words a Grail parameter occupies. A byte view is the C
// pair (pointer, length); everything else in the accepted slice is one word.
fn ffi_words<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) == 5 {
        return 2;
    }
    if ty_kind(&mut c, ty) == 28 {
        // A `byval` record is the ABI's business, not a word count: the declaration's 64-word cap
        // counts its eightbytes, which is an upper bound on what any target passes.
        inner := ty_arg(&mut c, ty);
        d := ty_arg(&mut c, inner);
        return ffi_record_words(&mut c, d);
    }
    return 1;
}
// ---- direct extern calls: one lowering per C calling convention ----
// abi 0: SysV x86-64 (Linux and macOS); 1: Win64 (x86-64 PE); 2: AAPCS64 (Linux, macOS and
// Windows ARM64); 3: RV64 LP64D. Callbacks and calls through `cfn` values keep the narrower
// six-integer-word rule in ffi_param until their entry and indirect paths use the same classes.
fn ffi_abi<a>(c: (&a mut C)) -> u64 {
    if c.target == 3 {
        return 1;
    }
    if (c.target == 1) || (c.target == 4) {
        return 2;
    }
    if c.target == 2 {
        return 3;
    }
    return 0;
}
fn ffi_int_regs(abi: u64) -> u64 {
    if abi == 0 {
        return 6;
    }
    if abi == 1 {
        return 4;
    }
    return 8;
}
// Integer argument registers in the compiler's x86 spelling; machine.grl maps %r10/%r11 to the
// seventh and eighth AAPCS64/RV64 argument registers.
fn ffi_int_reg(abi: u64, i: u64) -> string {
    if abi == 1 {
        if i == 0 {
            return "%rcx";
        }
        if i == 1 {
            return "%rdx";
        }
        if i == 2 {
            return "%r8";
        }
        return "%r9";
    }
    if i == 6 {
        return "%r10";
    }
    if i == 7 {
        return "%r11";
    }
    return argreg(i);
}
// The suffix of a narrow integer: "s8".."u32", or "" for a 64-bit or non-integer type.
fn ffi_narrow<a>(c: (&a mut C), ty: u64) -> string {
    if ty_kind(&mut c, ty) != 18 {
        return "";
    }
    bits := ty_arg(&mut c, ty);
    signed := ty_mode(&mut c, ty);
    if bits == 8 {
        if signed != 0 {
            return "s8";
        }
        return "u8";
    }
    if bits == 16 {
        if signed != 0 {
            return "s16";
        }
        return "u16";
    }
    if bits == 32 {
        if signed != 0 {
            return "s32";
        }
        return "u32";
    }
    return "";
}
fn ffi_x86_extend<a, b>(c: (&a mut C), suffix: &b [u8]) -> unit {
    if same(view(suffix), view("s8")) {
        o(&mut c, view("movsbq %al,%rax\n"));
    }
    if same(view(suffix), view("s16")) {
        o(&mut c, view("movswq %ax,%rax\n"));
    }
    if same(view(suffix), view("s32")) {
        o(&mut c, view("movslq %eax,%rax\n"));
    }
    if same(view(suffix), view("u8")) {
        o(&mut c, view("movzbq %al,%rax\n"));
    }
    if same(view(suffix), view("u16")) {
        o(&mut c, view("movzwq %ax,%rax\n"));
    }
    if same(view(suffix), view("u32")) {
        o(&mut c, view("movl %eax,%eax\n"));
    }
    return ();
}
// A parameter of `extern "C" record` type spelled `v: byval R` passes the whole record by value;
// a bare `R` stays the C `R *`. The marker is its own parameter type - kind 28, wrapping the record
// type - so one declaration can use both spellings and every call site is checked against the one
// it names, while the value itself is checked as the record it wraps (see require_type).
fn ffi_byval<a>(c: (&a mut C), ty: u64) -> bool {
    return ty_kind(&mut c, ty) == 28;
}
// 1 when a `byval R` parameter follows: `byval` and then the start of a type, so a type that
// happens to be named `byval` is not mistaken for the marker.
fn ffi_byval_ahead<a>(c: (&a mut C)) -> bool {
    if !is(&mut c, view("byval")) {
        return false;
    }
    return token_starts_type(&mut c, c.pos + 1);
}
// Parses the record type after `byval` and returns the parameter type.
fn ffi_byval_parameter<a>(c: (&a mut C)) -> u64 {
    ty := parse_type(&mut c);
    if is_c_record(&mut c, ty) == 0 {
        fail(&mut c, view("byval must name an extern \"C\" record type; a bare record parameter is a pointer"));
    }
    return intern(&mut c, 28, ty);
}
fn ffi_direct_type<a>(c: (&a mut C), ty: u64) -> bool {
    if is_float(&mut c, ty) {
        return true;
    }
    if (ty_kind(&mut c, ty) == 18) & (ffi_narrow(&mut c, ty).len() != 0) {
        return true;
    }
    return false;
}
fn ffi_direct_param<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    if ffi_byval(&mut c, ty) {
        return ();
    }
    if ffi_direct_type(&mut c, ty) {
        return ();
    }
    ffi_param(&mut c, ty, what);
    return ();
}
fn ffi_direct_result<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    if ty != 1 {
        if ffi_direct_type(&mut c, ty) {
            return ();
        }
        // A C-layout record result is returned by value (registers or a hidden result pointer,
        // per ABI) into a fresh Grail record of the same layout.
        if ty_kind(&mut c, ty) == 8 {
            rd := ty_arg(&mut c, ty);
            if c.decls[rd].c_layout != 0 {
                return ();
            }
        }
    }
    ffi_result(&mut c, ty, what);
    return ();
}
// %rax -> the outgoing stack argument word at `offset` bytes above the stack pointer.
fn ffi_store_stack<a>(c: (&a mut C), x86: u64, offset: u64) -> unit {
    if x86 != 0 {
        o(&mut c, view("movq %rax,"));
        on(&mut c, offset);
        o(&mut c, view("(%rsp)\n"));
    } else {
        o(&mut c, view("cstarg "));
        on(&mut c, offset);
        c.out.push(10);
    }
    return ();
}
// The binary32 bits of the f32 value in %rax, left in %rax.
fn ffi_f32_bits<a>(c: (&a mut C), x86: u64) -> unit {
    if x86 != 0 {
        // xmm5 is volatile on Win64 and free here: a stack-bound f32 on Win64 comes after the four
        // register slots, and on SysV after xmm0-xmm7, where xmm8+ are free and volatile too.
        if c.target == 3 {
            o(&mut c, view("movq %rax,%xmm5\ncvtsd2ss %xmm5,%xmm5\nmovd %xmm5,%eax\n"));
            return ();
        }
        o(&mut c, view("movq %rax,%xmm15\ncvtsd2ss %xmm15,%xmm15\nmovd %xmm15,%eax\n"));
    } else {
        o(&mut c, view("cf32bits\n"));
    }
    return ();
}
// `symbol` names the callee; when it is empty, `target` is the slot holding a `cfn` address and
// the call is indirect (through %rax, which no C convention uses for an argument).
fn ffi_emit_call<a, b, d, e, f>(
    c: (&a mut C),
    args: &b u64[],
    argtypes: &d u64[],
    formals: &f u64[],
    ret: u64,
    symbol: &e [u8],
    target: u64
) -> Val {
    // c.ffi_fixed is the number of named parameters of a variadic callee (set by the caller for
    // that one call), or 0 for an ordinary one.
    mut fixed = args.len();
    if c.ffi_fixed != 0 {
        fixed = c.ffi_fixed;
    }
    exchange(&mut c.ffi_fixed, 0);
    abi := ffi_abi(&mut c);
    x86 := abi < 2;
    nint := ffi_int_regs(abi);
    apple_arm := (abi == 2) & (c.plat == 1);
    // A C record result: 1 = returned in up to two integer registers, 2 = written through a
    // hidden pointer (rdi on SysV, rcx on Win64 and a0 on RV64, shifting the arguments; x8 on
    // AAPCS64, which does not). Records hold integer fields only, so every eightbyte is INTEGER.
    mut rmode = 0;
    mut rsize = 0;
    mut rslot = 0;
    // rmode 3: a record with float fields returned in registers per its classification (fplan
    // 1 SysV eightbytes, 2 AAPCS64 HFA, 3 RV64 flattened fields).
    mut rdecl = 0;
    mut fplan = 0;
    if ret != 1 {
        if ty_kind(&mut c, ret) == 8 {
            rd := ty_arg(&mut c, ret);
            rsize = ffi_record_size(&mut c, rd);
            nwords := ffi_record_words(&mut c, rd);
            words := imm(&mut c, nwords);
            rslot = invoke(&mut c, view("rt_rec"), one(words));
            rmode = 1;
            rdecl = rd;
            if ffi_record_has_float_deep(&mut c, rd) {
                fplan = ffi_float_plan(&mut c, rd, abi);
            }
            if fplan == 2 {
                // An AAPCS64 homogeneous float aggregate comes back in s0-s3/d0-d3 at any size.
                rmode = 3;
            }
            if (fplan == 3) & (rsize < 17) {
                rmode = 3;
            }
            if (fplan == 1) & (rsize < 17) {
                rmode = 3;
            }
            if rmode == 3 {
            } else {
            if abi == 1 {
                if (rsize != 1) & (rsize != 2) & (rsize != 4) & (rsize != 8) {
                    rmode = 2;
                }
            } else {
                if 16 < rsize {
                    rmode = 2;
                }
            }
            }
        }
    }
    mut shift = 0;
    if (rmode == 2) & (abi != 2) {
        shift = 1;
    }
    // First pass: how many argument words go to the stack. Win64 slots are positional: the
    // n-th argument uses the n-th register of its class or the n-th stack slot.
    mut ints = shift;
    mut floats = 0;
    mut stack = 0;
    // A `byval` argument's placement is decided here and replayed when the call is emitted, so the
    // two passes cannot disagree; its counters advance the same integer/float/stack allocation.
    mut copies = 0;
    mut plans = FFIPlan[];
    for i in args.len() {
        ty := argtypes[i];
        // RV64 passes variadic floating-point arguments in integer registers; Apple arm64 passes
        // every variadic argument on the stack in its own 8-byte slot.
        rv_var := (abi == 3) & (fixed < i + 1);
        apple_var := apple_arm & (fixed < i + 1);
        if (formals.len() > i) && ffi_byval(&mut c, formals[i]) {
            inner := ty_arg(&mut c, formals[i]);
            rd := ty_arg(&mut c, inner);
            plan := ffi_byval_plan(&mut c, rd, abi, ints, floats, stack, copies);
            ints = plan.ints;
            floats = plan.floats;
            stack = plan.stack;
            copies = plan.copies;
            plans.push(plan);
            continue;
        }
        plans.push(ffi_empty_plan());
        if apple_var {
            for w in ffi_words(&mut c, ty) {
                stack = stack + 1;
            }
            continue;
        }
        if is_float(&mut c, ty) && !rv_var {
            if abi == 1 {
                if ints < 4 {
                    ints = ints + 1;
                } else {
                    stack = stack + 1;
                }
            } else {
                if floats < 8 {
                    floats = floats + 1;
                } else {
                    if (abi == 3) & (ints < 8) {
                        ints = ints + 1;
                    } else {
                        stack = stack + 1;
                    }
                }
            }
        } else {
            for w in ffi_words(&mut c, ty) {
                if ints < nint {
                    ints = ints + 1;
                } else {
                    stack = stack + 1;
                }
            }
        }
    }
    mut base = 0;
    if abi == 1 {
        base = 32; // the callee's register home area
    }
    copy_base := (base + stack * 8 + 15) / 16 * 16;
    mut area = copy_base + copies;
    area = (area + 15) / 16 * 16;
    if 2048 < area {
        fail(&mut c, view("extern C call needs more than 2 KiB of stack arguments"));
    }
    mut tls = 0;
    if tls_bridge(&mut c) {
        tls = fresh(&mut c);
        tls_enter_foreign(&mut c, tls);
    }
    if area != 0 {
        if x86 {
            o(&mut c, view("subq $"));
            on(&mut c, area);
            o(&mut c, view(",%rsp\n"));
        } else {
            o(&mut c, view("cstack "));
            on(&mut c, area);
            c.out.push(10);
        }
    }
    ints = shift;
    floats = 0;
    mut next = 0;
    if shift != 0 {
        get(&mut c, rslot, view(ffi_int_reg(abi, 0)));
    }
    for i in args.len() {
        ty := argtypes[i];
        variadic_arg := fixed < i + 1;
        rv_var := (abi == 3) & variadic_arg;
        if plans[i].byval != 0 {
            ffi_byval_emit(&mut c, args[i], &plans[i], copy_base, x86, abi);
            ints = plans[i].ints;
            floats = plans[i].floats;
            next = plans[i].stack;
            continue;
        }
        if apple_arm & variadic_arg {
            // Promoted value (int to 64 bits as Grail holds it, float to double) in an 8-byte slot.
            vwords := ffi_words(&mut c, ty);
            get(&mut c, args[i], view("%rax"));
            if vwords == 2 {
                o(&mut c, view("movq %rax,%r10\nmovq (%r10),%rax\n"));
                ffi_store_stack(&mut c, x86, base + next * 8);
                next = next + 1;
                o(&mut c, view("movq 8(%r10),%rax\n"));
            }
            ffi_store_stack(&mut c, x86, base + next * 8);
            next = next + 1;
            continue;
        }
        if is_float(&mut c, ty) & rv_var {
            // Promoted to double and moved as its bits through the integer path.
            get(&mut c, args[i], view("%rax"));
            if ints < 8 {
                o(&mut c, view("movq %rax,"));
                o(&mut c, view(ffi_int_reg(abi, ints)));
                c.out.push(10);
                ints = ints + 1;
            } else {
                ffi_store_stack(&mut c, x86, base + next * 8);
                next = next + 1;
            }
            continue;
        }
        if is_float(&mut c, ty) {
            // A variadic float is promoted to double (Grail already holds the double's value).
            single := is_f32(&mut c, ty) && !variadic_arg;
            mut freg = 99;
            mut ireg = 99;
            if abi == 1 {
                if ints < 4 {
                    freg = ints;
                    ints = ints + 1;
                }
            } else {
                if floats < 8 {
                    freg = floats;
                    floats = floats + 1;
                } else {
                    if (abi == 3) & (ints < 8) {
                        ireg = ints;
                        ints = ints + 1;
                    }
                }
            }
            get(&mut c, args[i], view("%rax"));
            if freg != 99 {
                if (abi == 1) & variadic_arg {
                    // Win64 variadics: the callee reads the integer register, so pass both.
                    o(&mut c, view("movq %rax,"));
                    o(&mut c, view(ffi_int_reg(abi, freg)));
                    c.out.push(10);
                }
                if x86 {
                    if single {
                        // Narrowed in its own register: no scratch, so nothing callee-saved is touched.
                        o(&mut c, view("movq %rax,%xmm"));
                        on(&mut c, freg);
                        o(&mut c, view("\ncvtsd2ss %xmm"));
                        on(&mut c, freg);
                        o(&mut c, view(",%xmm"));
                    } else {
                        o(&mut c, view("movq %rax,%xmm"));
                    }
                    on(&mut c, freg);
                    c.out.push(10);
                } else {
                    if single {
                        o(&mut c, view("cfarg32 "));
                    } else {
                        o(&mut c, view("cfarg64 "));
                    }
                    on(&mut c, freg);
                    c.out.push(10);
                }
            } else {
                if single {
                    if apple_arm {
                        fail(&mut c, view("macOS arm64 packs stack arguments; an f32 stack argument is not supported"));
                    }
                    ffi_f32_bits(&mut c, x86);
                }
                if ireg != 99 {
                    o(&mut c, view("movq %rax,"));
                    o(&mut c, view(ffi_int_reg(abi, ireg)));
                    c.out.push(10);
                } else {
                    ffi_store_stack(&mut c, x86, base + next * 8);
                    next = next + 1;
                }
            }
        } else {
            words := ffi_words(&mut c, ty);
            suffix := ffi_narrow(&mut c, ty);
            for w in words {
                mut ireg = 99;
                if ints < nint {
                    ireg = ints;
                    ints = ints + 1;
                }
                if (ireg == 99) & apple_arm & (suffix.len() != 0) {
                    fail(&mut c, view("macOS arm64 packs stack arguments; a narrow integer stack argument is not supported"));
                }
                // RV64 passes a 32-bit argument sign-extended even when it is unsigned; Grail keeps
                // u32 zero-extended, so it is converted at the boundary.
                rv_u32 := (abi == 3) & same(view(suffix), view("u32"));
                direct := words == 1 && ireg != 99 && !rv_u32;
                if direct {
                    get(&mut c, args[i], view(ffi_int_reg(abi, ireg)));
                } else {
                    get(&mut c, args[i], view("%rax"));
                    if words == 2 {
                        if w == 0 {
                            o(&mut c, view("movq (%rax),%rax\n"));
                        } else {
                            o(&mut c, view("movq 8(%rax),%rax\n"));
                        }
                    }
                    if rv_u32 {
                        o(&mut c, view("cext s32\n"));
                    }
                    if ireg != 99 {
                        o(&mut c, view("movq %rax,"));
                        o(&mut c, view(ffi_int_reg(abi, ireg)));
                        c.out.push(10);
                    } else {
                        ffi_store_stack(&mut c, x86, base + next * 8);
                        next = next + 1;
                    }
                }
            }
        }
    }
    if (rmode == 2) & (abi == 2) {
        get(&mut c, rslot, view("%rax"));
        o(&mut c, view("csret\n"));
    }
    if (abi == 0) & (fixed < args.len()) {
        // SysV variadic callees read the number of vector registers used from %al.
        o(&mut c, view("movl $"));
        on(&mut c, floats);
        o(&mut c, view(",%eax\n"));
    }
    if symbol.len() == 0 {
        get(&mut c, target, view("%rax"));
        call_slot_out(&mut c, view("call *%rax\n"));
    } else {
        call_out(&mut c, view(symbol));
    }
    if (ret != 1) & (rmode == 0) {
        if is_float(&mut c, ret) {
            single := is_f32(&mut c, ret);
            if x86 {
                if single {
                    o(&mut c, view("cvtss2sd %xmm0,%xmm0\n"));
                }
                o(&mut c, view("movq %xmm0,%rax\n"));
            } else {
                if single {
                    o(&mut c, view("cfret32\n"));
                } else {
                    o(&mut c, view("cfret64\n"));
                }
            }
        } else {
            suffix := ffi_narrow(&mut c, ret);
            if suffix.len() != 0 {
                if x86 {
                    ffi_x86_extend(&mut c, view(suffix));
                } else {
                    o(&mut c, view("cext "));
                    o(&mut c, view(suffix));
                    c.out.push(10);
                }
            }
        }
    }
    if area != 0 {
        if x86 {
            o(&mut c, view("addq $"));
            on(&mut c, area);
            o(&mut c, view(",%rsp\n"));
        } else {
            o(&mut c, view("cunstack "));
            on(&mut c, area);
            c.out.push(10);
        }
    }
    if rmode == 3 {
        ffi_float_result(&mut c, rslot, rdecl, fplan);
    }
    if rmode != 0 {
        if rmode == 1 {
            // Word 0 is in %rax on every target; word 1 in %rdx on x86-64 and in x1/a1 (spelled
            // %rsi here) on AArch64 and RV64, which the call lowering leaves in place.
            get(&mut c, rslot, view("%r10"));
            o(&mut c, view("movq %rax,(%r10)\n"));
            if 8 < rsize {
                if x86 {
                    o(&mut c, view("movq %rdx,8(%r10)\n"));
                } else {
                    o(&mut c, view("movq %rsi,8(%r10)\n"));
                }
            }
        }
        if tls != 0 {
            tls_leave(&mut c, tls);
        }
        own(&mut c, rslot, ret);
        return val(rslot, ret);
    }
    slot := save(&mut c);
    if tls != 0 {
        tls_leave(&mut c, tls);
    }
    if ret != 1 {
        own(&mut c, slot, ret);
    }
    return val(slot, ret);
}
// A handle (kind 23) or bare pointer (kind 26) is the one kind of value C cannot produce as a
// result alone: the Vulkan/D3D12/Metal shape `vkCreateInstance(..., VkInstance *pInstance)` writes it
// through an out-parameter. The parameter is `&mut H` and the callee writes the new word into the
// caller's slot; a binding declared without an initializer starts as null, so the slot always has a
// defined value before the call.
fn ffi_out_slot_type<a>(c: (&a mut C), ty: u64) -> bool {
    // A handle or bare pointer is one word the callee writes; an extern "C" record is the C `R *`,
    // the address of the record's own fields, so the callee fills the struct in place and Grail
    // reads the typed fields afterwards.
    if is_c_record(&mut c, ty) != 0 {
        return true;
    }
    return (ty_kind(&mut c, ty) == 23) || (ty_kind(&mut c, ty) == 26);
}
// `p: &mut R` in an extern declaration: the C `R *`, written by the callee.
fn ffi_record_out_param<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) != 7 {
        return 0;
    }
    if ty_mode(&mut c, ty) == 0 {
        return 0;
    }
    inner := ty_arg(&mut c, ty);
    if is_c_record(&mut c, inner) != 0 {
        return inner;
    }
    return 0;
}
// `p: &mut Instance` in an extern declaration: a mutable borrow of a handle or bare pointer binding.
// Only a mutable borrow is a writable slot - `&H` would hand C a `const H *` it cannot store through.
fn ffi_out_param<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 7 {
        return false;
    }
    if ty_mode(&mut c, ty) == 0 {
        return false;
    }
    inner := ty_arg(&mut c, ty);
    return ffi_out_slot_type(&mut c, inner);
}
fn ffi_param<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    // u64 is the portable one-word type at index 0; i64/isize is the 64-bit signed
    // integer. Handles (kind 23) and CStr (kind 24) are one-word C pointers, and a
    // byte view (kind 5) is passed as pointer plus length.
    if ty == 0 {
        return ();
    }
    k := ty_kind(&mut c, ty);
    if (k == 18) & (ty_arg(&mut c, ty) == 64) {
        return ();
    }
    if (k == 23) || (k == 24) || (k == 5) || (k == 25) || (k == 26) {
        return ();
    }
    if k == 8 {
        // A record parameter is the C pointer to the struct's fields; Grail keeps
        // ownership of the allocation, so C must not free it.
        if c.decls[ty_arg(&mut c, ty)].c_layout != 0 {
            return ();
        }
    }
    if k == 7 {
        inner := ty_arg(&mut c, ty);
        if ffi_out_slot_type(&mut c, inner) {
            if ty_mode(&mut c, ty) != 0 {
                return ();
            }
            fail(&mut c, view("an extern C out-parameter needs &mut; a shared &H is the C const pointer"));
        }
        fail(
            &mut c,
            view("an extern C out-parameter must be &mut a handle, CPtr, CMutPtr or extern \"C\" record")
        );
    }
    fail(&mut c, what);
    return ();
}
fn ffi_result<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    // A result is one word: scalars, a C handle or a C string pointer. A byte view
    // result is rejected because C cannot produce a Grail view record.
    if (ty == 0) || (ty == 1) {
        return ();
    }
    k := ty_kind(&mut c, ty);
    if (k == 18) & (ty_arg(&mut c, ty) == 64) {
        return ();
    }
    if (k == 23) || (k == 24) || (k == 25) || (k == 26) {
        // A function-pointer result is how a dynamic loader hands back a resolved
        // symbol; the declaration states the signature the address is called with.
        return ();
    }
    fail(&mut c, what);
    return ();
}
// ---- C-layout records ----
// `extern record R { a: i64, b: i32 }` uses the C rules: natural alignment,
// padding between fields, tail padding to the record alignment, offsets equal to
// C's offsetof. Field access reads and writes exactly the field's width.
fn ffi_align_up(n: u64, a: u64) -> u64 {
    if a < 2 {
        return n;
    }
    r := n % a;
    if r == 0 {
        return n;
    }
    return n + a - r;
}
fn ffi_layout_fail<a>(c: (&a mut C)) -> unit {
    // Ordinary Grail records are heap pointers and cannot be embedded; extern records embed by
    // value (their bytes at the field's C offset).
    fail(&mut c, view("extern record fields must be 8/16/32/64-bit integers, f32, f64, handles, CStr or extern records"));
    return ();
}
fn is_c_record<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) != 8 {
        return 0;
    }
    d := ty_arg(&mut c, ty);
    if c.decls[d].is_enum != 0 {
        return 0;
    }
    return c.decls[d].c_layout;
}
fn ffi_field_align<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    if k == 32 {
        // An inline C array is aligned like its element.
        elem := ty_arg(&mut c, ty);
        return ffi_field_align(&mut c, elem);
    }
    // An embedded extern record: its bytes in place, with its own C alignment and size.
    if is_c_record(&mut c, ty) != 0 {
        inner := ty_arg(&mut c, ty);
        return ffi_record_align(&mut c, inner);
    }
    // f32 is C float (4 bytes), f64 is C double (8 bytes).
    if k == 21 {
        if is_f32(&mut c, ty) {
            return 4;
        }
        return 8;
    }
    if (k == 23) || (k == 24) || (k == 26) {
        return 8;
    }
    if k == 18 {
        bits := ty_arg(&mut c, ty);
        if (bits == 8) || (bits == 16) || (bits == 32) || (bits == 64) {
            return bits / 8;
        }
    }
    ffi_layout_fail(&mut c);
    return 0;
}
fn ffi_field_size<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    if k == 32 {
        // An inline C array: N elements back to back.
        elem := ty_arg(&mut c, ty);
        return ffi_field_size(&mut c, elem) * ty_mode(&mut c, ty);
    }
    // An embedded extern record: its bytes in place, with its own C alignment and size.
    if is_c_record(&mut c, ty) != 0 {
        inner := ty_arg(&mut c, ty);
        return ffi_record_size(&mut c, inner);
    }
    // f32 is C float (4 bytes), f64 is C double (8 bytes).
    if k == 21 {
        if is_f32(&mut c, ty) {
            return 4;
        }
        return 8;
    }
    if (k == 23) || (k == 24) || (k == 26) {
        return 8;
    }
    if k == 18 {
        bits := ty_arg(&mut c, ty);
        if (bits == 8) || (bits == 16) || (bits == 32) || (bits == 64) {
            return bits / 8;
        }
    }
    ffi_layout_fail(&mut c);
    return 0;
}
fn ffi_record_align<a>(c: (&a mut C), d: u64) -> u64 {
    count := c.decls[d].count;
    mut a = 1;
    mut i = 0;
    while i < count {
        ty := field_ty(&mut c, d, i);
        x := ffi_field_align(&mut c, ty);
        if a < x {
            a = x;
        }
        i = i + 1;
    }
    return a;
}
fn ffi_record_size<a>(c: (&a mut C), d: u64) -> u64 {
    count := c.decls[d].count;
    mut off = 0;
    mut i = 0;
    while i < count {
        ty := field_ty(&mut c, d, i);
        al := ffi_field_align(&mut c, ty);
        off = ffi_align_up(off, al) + ffi_field_size(&mut c, ty);
        i = i + 1;
    }
    return ffi_align_up(off, ffi_record_align(&mut c, d));
}
// Allocation granule: the record size rounded up to whole eight-byte words.
fn ffi_record_words<a>(c: (&a mut C), d: u64) -> u64 {
    return ffi_align_up(ffi_record_size(&mut c, d), 8) / 8;
}
fn ffi_offset<a>(c: (&a mut C), d: u64, k: u64) -> u64 {
    mut off = 0;
    mut i = 0;
    while i < k {
        ty := field_ty(&mut c, d, i);
        al := ffi_field_align(&mut c, ty);
        off = ffi_align_up(off, al) + ffi_field_size(&mut c, ty);
        i = i + 1;
    }
    ty := field_ty(&mut c, d, k);
    return ffi_align_up(off, ffi_field_align(&mut c, ty));
}
fn ffi_field<a>(c: (&a mut C), ty: u64) -> unit {
    ffi_field_size(&mut c, ty);
    return ();
}
fn ffi_record<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("record"));
    name := ident(&mut c);
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    if pass != 2 {
        if pass == 1 {
            m := module_copy(&mut c);
            item_public_5 := c.decl_public;
            c
                .decls
                .push(
                    Decl {
                        public: item_public_5,
                        module: m,
                        name: name,
                        is_enum: 0,
                        opaque: 0,
                        transfer: 0,
                        share: 0,
                        c_layout: 1,
                        first: 0,
                        count: 0,
                        drop: 0,
                        regions: 0,
                        types: 0,
                        success: 0,
                        bounds: u64[],
                        constraints: u64[][],
                    }
                );
        }
        while !is(&mut c, view("}")) {
            if kind(&mut c) == 0 {
                fail(&mut c, view("unterminated extern record"));
            }
            advance(&mut c);
        }
        advance(&mut c);
        eat(&mut c, view(";"));
        return ();
    }
    m := module_copy(&mut c);
    d := find_decl(&mut c, view(m), view(name));
    if d == 0 {
        fail(&mut c, view("unknown extern record"));
    }
    mut pending = Field[];
    mut count = 0;
    expect(&mut c, view("{"));
    if !eat(&mut c, view("}")) {
        while true {
            f := ident(&mut c);
            expect(&mut c, view(":"));
            ty := parse_type(&mut c);
            ffi_field(&mut c, ty);
            pending.push(Field { name: f, ty: ty, pred: no_pred() });
            count = count + 1;
            if eat(&mut c, view("}")) {
                break;
            }
            expect(&mut c, view(","));
            if eat(&mut c, view("}")) {
                break;
            }
        }
    }
    eat(&mut c, view(";"));
    mut reverse = Field[];
    while pending.len() != 0 {
        reverse.push(pending.pop());
    }
    first := c.fields.len();
    while reverse.len() != 0 {
        c.fields.push(reverse.pop());
    }
    item_public_6 := c.decl_public;
    exchange(
        &mut c.decls[d - 1],
        Decl {
            public: item_public_6,
            module: m,
            name: name,
            is_enum: 0,
            opaque: 0,
            transfer: 0,
            share: 0,
            c_layout: 1,
            first: first,
            count: count,
            drop: 0,
            regions: 0,
            types: 0,
            success: 0,
            bounds: u64[],
            constraints: u64[][],
        }
    );
    return ();
}
fn export_name<a, b, d, e>(c: (&a mut C), m: &b [u8], n: &d [u8], symbol: &e [u8], export: u64) -> unit {
    if export == 2 {
        // The C symbol may differ from the Grail name (`as "name"`). Mach-O C symbols carry a
        // leading underscore, which references already get (darwin_line) and definitions must too.
        if c.plat == 1 {
            c.out.push(95);
        }
        o(&mut c, symbol);
        return ();
    }
    mangle(&mut c, view(m), view(n));
    return ();
}
// Does the declaration at `start` (the `fn` keyword) have a body? Scans to the first
// `{` or `;` at bracket depth zero, so a body can be handed to the normal function
// parser and a plain declaration stays a declaration.
fn extern_has_body<a>(c: (&a mut C), start: u64) -> u64 {
    mut i = start;
    mut depth = 0;
    while i < c.toks.len() {
        k := kind_at(&mut c, i);
        if (k == 40) || (k == 60) || (k == 91) {
            depth += 1;
        }
        if (k == 41) || (k == 62) || (k == 93) {
            depth -= 1;
        }
        if depth == 0 {
            if k == 123 {
                return 1;
            }
            if (k == 59) || (k == 125) {
                return 0;
            }
        }
        i += 1;
    }
    return 0;
}
fn ffi_string<a, b>(c: (&a mut C), what: &b [u8]) -> u8[] {
    if kind(&mut c) != 3 {
        fail(&mut c, what);
    }
    p := c.pos;
    advance(&mut c);
    return decode_literal(&mut c, p);
}
fn ffi_link<a, b>(c: (&a mut C), input: &b [u8]) -> unit {
    // The link request is program-wide (it is emitted once, at the head of the stream), but an
    // interface has to know which module asked for it so a build that reads the module's
    // declarations instead of its source still asks the linker for the same input.
    c.lib_owner.push(module_copy(&mut c));
    for i in c.libs.len() {
        if same(view(c.libs[i]), view(input)) {
            return ();
        }
    }
    c.libs.push(input.copy());
    return ();
}
fn extern_declaration<a>(c: (&a mut C), pass: u64, public: u64) -> unit {
    position := c.pos;
    expect(&mut c, view("extern"));
    abi := ffi_string(&mut c, view("extern requires a quoted ABI name"));
    if !same(view(abi), view("C")) {
        fail(&mut c, view("only extern \"C\" declarations are supported"));
    }
    mut input = u8[];
    mut symbol = u8[];
    while true {
        if eat(&mut c, view("lib")) {
            input = ffi_string(&mut c, view("lib requires a quoted link input"));
        } else {
            if eat(&mut c, view("as")) {
                symbol = ffi_string(&mut c, view("as requires a quoted C symbol name"));
            } else {
                break;
            }
        }
    }
    if (0 < input.len()) & (symbol.len() == 0) & is(&mut c, view(";")) {
        // `extern "C" lib "c";`: a library this module needs linked although it calls nothing in
        // it directly - the C runtime a C++ shim it binds expects, say. A PE import names a symbol,
        // so on Windows there is nothing to request.
        advance(&mut c);
        if (c.target != 3) & (c.target != 4) {
            ffi_link(&mut c, view(input));
        }
        return ();
    }
    if is(&mut c, view("record")) {
        if 0 < input.len() + symbol.len() {
            fail(&mut c, view("extern record takes no lib or as clause"));
        }
        ffi_record(&mut c, pass);
        return ();
    }
    fn_position := c.pos;
    body := extern_has_body(&mut c, fn_position);
    expect(&mut c, view("fn"));
    name := ident(&mut c);
    if body != 0 {
        // `extern "C" fn name(...) -> R { ... }` defines a Grail function that C can
        // call: it is emitted with the stated (unmangled) symbol and its signature
        // must sit inside the C ABI slice. The normal function parser emits the body.
        mut exported = symbol;
        if exported.len() == 0 {
            exported = name.copy();
        }
        exchange(&mut c.pending_ext, 2);
        exchange(&mut c.pending_symbol, exported);
        exchange(&mut c.pos, fn_position);
        func(&mut c, pass, public);
        exchange(&mut c.pending_ext, 0);
        exchange(&mut c.pending_symbol, u8[]);
        return ();
    }
    if pass != 2 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        expect(&mut c, view(";"));
        return ();
    }
    if symbol.len() == 0 {
        symbol = name.copy();
    }
    // Byte-view parameters need an input lifetime context, exactly like a Grail
    // function signature; the region is irrelevant to the C ABI.
    exchange(&mut c.input_regions, u64[]);
    exchange(&mut c.receiver_region, 0);
    exchange(&mut c.parsing_input, 1);
    first := c.params.len();
    mut count = 0;
    mut words = 0;
    mut variadic = 0;
    expect(&mut c, view("("));
    if !eat(&mut c, view(")")) {
        while true {
            // `...` ends the fixed parameters of a variadic C function (printf-style).
            if eat(&mut c, view(".")) {
                expect(&mut c, view("."));
                expect(&mut c, view("."));
                if count == 0 {
                    fail(&mut c, view("a variadic extern C function needs at least one fixed parameter"));
                }
                variadic = 1;
                expect(&mut c, view(")"));
                break;
            }
            p := ident(&mut c);
            expect(&mut c, view(":"));
            mut ty = 0;
            if ffi_byval_ahead(&mut c) {
                advance(&mut c);
                ty = ffi_byval_parameter(&mut c);
            } else {
                ty = parse_type(&mut c);
            }
            ffi_direct_param(
                &mut c,
                ty,
                view("extern C parameters must be an integer, f32, f64, CStr, handle, byte view, cfn, extern record or byval record")
            );
            words = words + ffi_words(&mut c, ty);
            c.params.push(ty);
            count = count + 1;
            if eat(&mut c, view(")")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    if 64 < words {
        fail(&mut c, view("extern C declaration exceeds 64 argument words"));
    }
    mut ret = 1;
    if eat(&mut c, view("->")) {
        ret = parse_type(&mut c);
        ffi_direct_result(&mut c, ret, view("extern C results must be an integer, f32, f64, unit, CStr, handle or cfn"));
    }
    expect(&mut c, view(";"));
    m := module_copy(&mut c);
    if find_func(&mut c, view(m), view(name)) != 0 {
        fail(&mut c, view("duplicate function"));
    }
    if 0 < input.len() {
        if (c.target == 3) || (c.target == 4) {
            // A PE image binds each symbol to one DLL through the import table, so Windows tooling
            // needs the pair, not just the library: `// grail-link: import kernel32 LoadLibraryA`.
            mut note = u8[];
            push_bytes(&mut note, view("import "));
            push_bytes(&mut note, view(input));
            note.push(32);
            push_bytes(&mut note, view(symbol));
            ffi_link(&mut c, view(note));
        } else {
            ffi_link(&mut c, view(input));
        }
    }
    item_public_7 := c.decl_public;
    item_home_7 := module_copy(&mut c);
    c
        .funcs
        .push(
            Func {
                public: item_public_7,
                home: item_home_7,
                module: m,
                name: name,
                first: first,
                count: count,
                ret: ret,
                types: 0,
                regions: 0,
                file: c.file,
                pos: position,
                raw: c.raw,
                unsafe_fn: 0,
                bounds: u64[],
                constraints: u64[][],
                contract: 0,
                owner: 0,
                ext: 1 + variadic,
                symbol: symbol,
                body: u8[],
                ppreds: Pred[],
                rpred: no_pred(),
                pnames: u8[][],
                strict: 0,
                no_alloc: 0,
                no_panic: 0,
            }
        );
    return ();
}
fn func<a>(c: (&a mut C), pass: u64, public: u64) -> unit {
    // A body's synthesised declarations (closure environments) are not the function's to hide.
    exchange(&mut c.decl_public, 1);
    position := c.pos;
    // The mode this body is compiled in. `@strict` on the declaration reaches it from the source or,
    // when the body is a specialisation or a replay, from the template that carries the flag.
    mut strict_here = c.strict_next;
    if c.current_spec != 0 {
        template := c.specs[c.current_spec - 1].template;
        if template < c.funcs.len() {
            strict_here = c.funcs[template].strict;
        }
    }
    exchange(&mut c.strict_here, strict_here);
    out_mark := c.out.len();
    fact_mark := llvm::facts_len(&c.facts);
    part_mark := c.part.copy();
    part_lpart := c.lpart.copy();
    part_lunit := c.lunit;
    part_label := c.label;
    part_ref := c.ref_next;
    closure_mark := c.closures.len();
    spec_closure_mark := c.spec_closures;
    mut dstart = 0;
    mut dend = 0;
    expect(&mut c, view("fn"));
    // `unsafe fn`: consumed here, whatever pass this is, so the next item does not inherit it.
    unsafe_fn := exchange(&mut c.pending_unsafe, 0);
    // `@no_alloc`/`@no_panic`: the claims this body has to prove (docs/design/effects.md).
    claimed_alloc := exchange(&mut c.fx_pending_alloc, 0);
    claimed_panic := exchange(&mut c.fx_pending_panic, 0);
    mut name = ident(&mut c);
    c.cur_name = name.copy();
    c.cur_file = c.file;
    c.cur_pos = position;
    lifetime_parameters(&mut c);
    exchange(&mut c.input_regions, u64[]);
    exchange(&mut c.receiver_region, 0);
    exchange(&mut c.output_region, 0);
    exchange(&mut c.parsing_input, 1);
    if (c.inherent != 0) || (c.current_impl != 0) {
        prepend_impl_params(&mut c);
    }
    if same(view(name), view("print")) || same(view(name), view("println")) {
        fail(&mut c, view("print and println are reserved prelude names"));
    }
    typecount := c.tnames.len();
    regioncount := c.rnames.len();
    if (pass == 3) & (typecount != 0) {
        while kind(&mut c) != 123 {
            advance(&mut c);
        }
        skip_braces(&mut c);
        return ();
    }
    if pass == 1 {
        while kind(&mut c) != 123 {
            advance(&mut c);
        }
        skip_braces(&mut c);
        return ();
    }
    if (pass == 3) || (pass == 4) {
        // A body an earlier run reported an error in is not checked again: its signature still
        // stands for its callers, so the rest of the program is checked against it. Pass 4 replays
        // a generic template's body - for its validation and for each specialisation - and it is
        // the same source body, so the same record skips it and names it.
        here_file := c.file;
        for i in c.skip_bodies.len() / 2 {
            if (c.skip_bodies[2 * i] == here_file) & (c.skip_bodies[2 * i + 1] == position + 1) {
                while kind(&mut c) != 123 {
                    advance(&mut c);
                }
                skip_braces(&mut c);
                return ();
            }
        }
        exchange(&mut c.body_file, here_file);
        // Position + 1, so 0 still means "not in a body".
        exchange(&mut c.body_pos, position + 1);
    }
    mut m = module_copy(&mut c);
    // A specialisation is requested by the module whose body instantiates the template.
    mut asker = m.copy();
    if c.current_spec != 0 {
        // A specialisation the replayed body instantiates in turn is asked for by the same module
        // that asked for this one, and is emitted into its part (B1 stage 4).
        asker = c.specs[c.current_spec - 1].requester.copy();
    }
    exchange(&mut c.body_module, asker);
    export := c.pending_ext;
    export_symbol := c.pending_symbol.copy();
    if c.current_impl != 0 {
        m = private_module(view(".impl_"), c.current_impl);
    }
    if c.inherent != 0 {
        m = private_module(view(".inherent_"), c.inherent - 1);
    }
    exchange(&mut c.locals, Local[]);
    // The call-flex hint record indexes `locals` and names token positions of the function being
    // compiled, so it cannot outlive that function's token stream.
    exchange(&mut c.cf_start, 0);
    exchange(&mut c.cf_end, 0);
    exchange(&mut c.cf_local, 0);
    exchange(&mut c.none_start, 0);
    exchange(&mut c.none_end, 0);
    exchange(&mut c.debug_vars, DebugVar[]);
    exchange(&mut c.resources, Resource[]);
    exchange(&mut c.next, 0);
    // Facts are keyed by the symbol this body will be lifted under, and the `rt_f64_op` ordinals
    // restart with it. Both are known before the signature is parsed, so parameters get facts too.
    mut label = name.copy();
    if c.current_spec != 0 {
        label = special_name(&mut c, c.current_spec - 1);
    }
    sym_unit := symbol_unit(&mut c, view(m));
    sym := body_label(&c, view(sym_unit), view(label), view(export_symbol), export);
    exchange(&mut c.facts_fn, sym);
    exchange(&mut c.f64_ops, 0);
    exchange(&mut c.call_ord, 0);
    // The F1 call ordinals are per callee *and per function*, exactly as the lifter counts them.
    exchange(&mut c.f1_names, u8[][]);
    exchange(&mut c.f1_counts, u64[]);
    exchange(&mut c.scope_end, 0);
    exchange(&mut c.loop_start, 0);
    exchange(&mut c.loop_end, 0);
    exchange(&mut c.check, ownership::new());
    exchange(&mut c.members, Member[]);
    exchange(&mut c.terminated, 0);
    exchange(&mut c.bonds, Bond[]);
    exchange(&mut c.pointers, Pointer[]);
    exchange(&mut c.origins, Origin[]);
    first := c.params.len();
    mut count = 0;
    mut ppreds = Pred[];
    mut pnames = u8[][];
    expect(&mut c, view("("));
    if !eat(&mut c, view(")")) {
        while true {
            p := ident(&mut c);
            expect(&mut c, view(":"));
            if ffi_byval_ahead(&mut c) {
                fail(
                    &mut c,
                    view("byval is only for an extern \"C\" declaration parameter; a C callback cannot take a record by value yet")
                );
            }
            ty := parse_type(&mut c);
            // `p: T where P`: the parameter's refinement (docs/design/refinements.md).
            mut pp = no_pred();
            if is(&mut c, view("where")) {
                advance(&mut c);
                pp = pred_scan(&mut c, view(","), view(")"));
            }
            ppreds.push(pp);
            pnames.push(p.copy());
            if same(view(p), view("self")) & (ty_kind(&mut c, ty) == 7) {
                rr := outer_region(&mut c, ty);
                exchange(&mut c.receiver_region, rr);
            }
            if pass == 2 {
                c.params.push(ty);
            }
            id := fresh(&mut c);
            bind(&mut c, p, ty, id, 0);
            if c.debug != 0 {
                n := c.debug_vars.len();
                if n != 0 {
                    mut v = &mut c.debug_vars[n - 1];
                    exchange(&mut v.param, 1);
                }
            }
            count = count + 1;
            if eat(&mut c, view(")")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    exchange(&mut c.parsing_input, 0);
    if c.receiver_region != 0 {
        exchange(&mut c.output_region, c.receiver_region);
    } else {
        if c.input_regions.len() == 1 {
            exchange(&mut c.output_region, c.input_regions[0]);
        }
    }
    mut ret = 1;
    mut rpred = no_pred();
    if eat(&mut c, view("->")) {
        ret = parse_type(&mut c);
        // `-> T ensures P`: the result's refinement, with `result` naming the value.
        if is(&mut c, view("ensures")) {
            advance(&mut c);
            rpred = pred_scan(&mut c, view("{"), view(";"));
        }
    }
    c.cur_ppreds = copy_preds(&ppreds);
    c.cur_rpred = Pred { file: rpred.file, lo: rpred.lo, hi: rpred.hi };
    exchange(&mut c.output_region, 0);
    exchange(&mut c.result, ret);
    if pass == 2 {
        if find_func(&mut c, view(m), view(name)) != 0 {
            fail(&mut c, view("duplicate function"));
        }
        if export != 0 {
            // The body is Grail, but C will call it: every parameter and the result
            // must live in the C ABI slice, and the symbol is the stated C name.
            ffi_callback_fits(&mut c, first, count);
            for i in count {
                formal := c.params[first + i];
                if ffi_out_param(&mut c, formal) & (ffi_record_out_param(&mut c, formal) == 0) {
                    // Grail has no deref-assignment, so a callback cannot store a word through the
                    // pointer C hands it; only a declaration Grail calls writes such a slot. A
                    // `&mut R` record parameter is the exception (bound by copy-in/copy-out below).
                    fail(
                        &mut c,
                        view("an out-parameter is only for an extern \"C\" declaration parameter; a C callback cannot take one")
                    );
                }
                if !(is_float(&mut c, formal) || ffi_narrow(&mut c, formal).len() != 0) {
                    ffi_param(
                        &mut c,
                        formal,
                        view("extern C callback parameters must be an integer, f32, f64, CStr, handle, byte view or cfn")
                    );
                }
            }
            if ret != 1 {
                if !(is_float(&mut c, ret) || ffi_narrow(&mut c, ret).len() != 0) {
                    ffi_result(&mut c, ret, view("extern C callback results must be an integer, f32, f64, unit, CStr or handle"));
                }
            }
            if export_symbol.len() == 0 {
                fail(&mut c, view("extern C definition needs a symbol"));
            }
        }
        main := (c.file == 2) & (c.current_impl == 0) & (c.inherent == 0) & same(view(name), view("main"));
        if main {
            if (1 < count) || (typecount != 0) {
                fail(
                    &mut c,
                    view("main needs zero arguments or one readonly byte view and no type parameters")
                );
            }
        }
        entry := main
            || (
                c.current_impl == 0
                    && c.inherent == 0
                    && c.entry == 0
                    && c.file == 2
                    && public != 0
                    && count < 2
                    && typecount == 0
            );
        file := c.file;
        raw := c.raw;
        bounds := copy_numbers(&c.type_bounds);
        constraints := copy_constraints(&c.type_interfaces);
        // A method of an interface implementation is as visible as the interface it implements.
        item_public_8 := public | u64(c.current_impl != 0);
        // Whose parameters a template replay restores: an inherent impl's type, or a generic
        // interface implementation (replay_function).
        mut method_owner = c.inherent;
        if (method_owner == 0) && (c.current_impl != 0) && (typecount != 0) {
            method_owner = generic_impl_key(c.current_impl);
        }
        item_home_8 := module_copy(&mut c);
        c
            .funcs
            .push(
                Func {
                    public: item_public_8,
                    home: item_home_8,
                    module: m,
                    name: name,
                    first: first,
                    count: count,
                    ret: ret,
                    types: typecount,
                    regions: c.rnames.len(),
                    file: file,
                    pos: position,
                    raw: raw,
                    unsafe_fn: unsafe_fn,
                    bounds: bounds,
                    constraints: constraints,
                    contract: 0,
                    owner: method_owner,
                    ext: export,
                    symbol: export_symbol,
                    body: u8[],
                    ppreds: copy_preds(&ppreds),
                    rpred: Pred { file: rpred.file, lo: rpred.lo, hi: rpred.hi },
                    pnames: copy_names(&pnames),
                    strict: c.strict_next,
                    no_alloc: claimed_alloc,
                    no_panic: claimed_panic,
                }
            );
        index := c.funcs.len();
        if entry {
            exchange(&mut c.entry, index);
        }
        eqs := copy_numbers(&c.assoc_eqs);
        for k in eqs.len() / 3 {
            c.func_eqs.push(index - 1);
            c.func_eqs.push(eqs[3 * k]);
            c.func_eqs.push(eqs[3 * k + 1]);
            c.func_eqs.push(eqs[3 * k + 2]);
        }
        // A generic template's body has to travel with its interface, because the module that
        // instantiates it may not have this file (B1 stage 3). Capture the declaration's own text
        // while this file is the loaded one: `position` is the `fn` token and `skip_braces` leaves
        // `c.pos` just past the closing brace.
        if typecount != 0 {
            from := c.toks[position].start;
            skip_braces(&mut c);
            to := c.toks[c.pos - 1].end;
            // `index` is `c.funcs.len()` after the push, so the record is at `index - 1`.
            exchange(&mut c.funcs[index - 1].body, (c.src[from: to]).copy());
        } else {
            skip_braces(&mut c);
        }
        return ();
    }
    if c.current_spec != 0 {
        name = special_name(&mut c, c.current_spec - 1);
    }
    start := c.pos;
    end := block_end(&mut c, start);
    exchange(&mut c.scope_end, end);
    // The facts an obligation may read start at this body's entry (pv_begin).
    exchange(&mut c.body_lo, start);
    exchange(&mut c.body_hi, end);
    for i in c.locals.len() {
        mut l = &c.locals[i];
        name := l.name.copy();
        last := last_name(&mut c, view(name), start, end);
        mut l = &mut c.locals[i];
        exchange(&mut l.last, last);
    }
    // On Win64 a C caller passes rcx/rdx/r8/r9 (then the stack after a 32-byte home area) and
    // expects rdi, rsi and xmm6-xmm15 preserved; the body uses Grail's SysV-shaped convention. A
    // callback is therefore a Win64 thunk under the C symbol that saves those registers, moves
    // the arguments and calls the body, which is emitted under `<symbol>_grail_body`.
    mut unit = unit_module(&mut c, view(m));
    if c.current_spec != 0 {
        // A specialisation is emitted by the module that asked for it, whichever module defines the
        // template, and weak: every object that instantiates the same key emits the same body under
        // the same content-addressed name, and the linker keeps one (B1 stage 4).
        requester := c.specs[c.current_spec - 1].requester.copy();
        unit = unit_module(&mut c, view(requester));
    }
    part(&mut c, view(unit));
    mut body_symbol = u8[];
    push_bytes(&mut body_symbol, view(export_symbol));
    if (c.target == 3) & (export == 2) {
        push_bytes(&mut body_symbol, view("_grail_body"));
        if exported(&mut c, view(name)) != 0 {
            o(&mut c, view(".globl "));
            o(&mut c, view(export_symbol));
            c.out.push(10);
        }
        o(&mut c, view(export_symbol));
        o(&mut c, view(":\npushq %rdi\npushq %rsi\nsubq $168,%rsp\n"));
        for x in 10 {
            o(&mut c, view("movdqu %xmm"));
            on(&mut c, x + 6);
            c.out.push(44);
            on(&mut c, x * 16);
            o(&mut c, view("(%rsp)\n"));
        }
        // Entry rsp + 40 holds argument five; after two pushes and 168 bytes it is rsp + 224.
        o(&mut c, view("movq %rcx,%rdi\nmovq %rdx,%rsi\nmovq %r8,%rdx\nmovq %r9,%rcx\nmovq 224(%rsp),%r8\nmovq 232(%rsp),%r9\ncall "));
        o(&mut c, view(body_symbol));
        c.out.push(10);
        for x in 10 {
            o(&mut c, view("movdqu "));
            on(&mut c, x * 16);
            o(&mut c, view("(%rsp),%xmm"));
            on(&mut c, x + 6);
            c.out.push(10);
        }
        o(&mut c, view("addq $168,%rsp\npopq %rsi\npopq %rdi\nret\n"));
    } else {
        if exported(&mut c, view(name)) != 0 {
            o(&mut c, view(".globl "));
            export_name(&mut c, view(m), view(name), view(export_symbol), export);
            c.out.push(10);
        }
    }
    exchange(&mut c.caddr, u64[]);
    func_directive(&mut c, view(m), view(name), view(body_symbol), export);
    if (c.debug != 0) & (c.validating == 0) {
        dstart = label(&mut c);
        mark(&mut c, dstart);
        if c.target == 3 {
            // CodeView numbers functions densely in record order; this one will be recorded next.
            fid := c.debug_funcs.len();
            o(&mut c, view(".cv_func_id "));
            on(&mut c, fid);
            c.out.push(10);
        }
    }
    label_at := c.out.len();
    export_name(&mut c, view(m), view(name), view(body_symbol), export);
    label_end := c.out.len();
    // The body's own label, exactly as a `call` to it spells it: the effect facts are keyed by it.
    mut fx_label = u8[];
    for i in label_end - label_at {
        fx_label.push(c.out[label_at + i]);
    }
    o(&mut c, view(":\n"));
    fx_begin(&mut c, view(fx_label), view(name), c.file, position, claimed_alloc, claimed_panic);
    // Where the prologue's own bytes begin: the second entry replays them, then jumps to the body.
    pro_start := c.out.len();
    o(&mut c, view("pushq %rbp\nmovq %rsp,%rbp\n"));
    frame := label(&mut c);
    if c.target == 4 {
        o(&mut c, view("framesub "));
        fname(&mut c, frame);
        c.out.push(10);
    } else {
        o(&mut c, view("subq $"));
        fname(&mut c, frame);
        o(&mut c, view(",%rsp\n"));
    }
    if export == 2 {
        callback_params(&mut c, count);
        mut fret = 0;
        if ret != 1 {
            if is_float(&mut c, ret) {
                fret = 1;
                if is_f32(&mut c, ret) {
                    fret = 2;
                }
            }
        }
        exchange(&mut c.export_fret, fret);
    } else {
        exchange(&mut c.export_fret, 0);
        store_params(&mut c, count);
    }
    // The parameter refinements hold here, where the parameters are the arguments they were given.
    // Before the frame zeroing on purpose: the check's own return address must stay inside the
    // prologue's no-position range, so a failure reports the call site rather than this statement.
    o(&mut c, view("leaq -"));
    fname(&mut c, frame);
    o(&mut c, view("(%rbp),%rdi\nmovq $"));
    fname(&mut c, frame);
    o(&mut c, view("/8-"));
    on(&mut c, count);
    o(&mut c, view(",%rcx\nxorl %eax,%eax\nrep stosq\n"));
    for i in count {
        mut l = &c.locals[i];
        slot := l.id;
        ty := l.ty;
        if (export == 0) & (c.backend != 0) & (c.raw == 0) & (c.facts_fn.len() != 0) {
            // A shared-reference parameter: this function cannot write what it points at, so a
            // caller's frame slot passed by address keeps its contents across the call.
            if (ty_kind(&mut c, ty) == 7) && (ty_mode(&mut c, ty) == 0) {
                llvm::fact_shared_param(&mut c.facts, copy_bytes(view(c.facts_fn)), i);
            }
        }
        // A C callback's extern-record parameter is the address of a struct the *caller* owns: it
        // is borrowed, never freed here. Owning it made the epilogue free C's storage, which is the
        // exit-time abort in the runtime's free path after main had already printed everything.
        if (export == 2) & (is_c_record(&mut c, ty) != 0) {
            borrow_parameter(&mut c, slot, ty);
            init_parameter(&mut c, slot, ty);
        } else if (export == 2) & (ffi_record_out_param(&mut c, ty) != 0) {
            // `p: &mut R` in a C callback: C passed the `R *` it owns. The body works on a
            // Grail-owned copy - every Grail operation through `p` is then sound, whole-value
            // replacement included - and each exit copies the bytes back into C's struct before
            // the copy is freed (callback_copy_back). Cost: one record-sized copy each way.
            rty := ty_arg(&mut c, ty);
            d := ty_arg(&mut c, rty);
            copy := c_record_copy(&mut c, slot, rty);
            own(&mut c, copy, rty);
            keep := fresh(&mut c);
            get(&mut c, slot, view("%rax"));
            o(&mut c, view("movq %rax,"));
            stack_slot(&mut c, keep);
            o(&mut c, view("\nleaq "));
            stack_slot(&mut c, copy);
            o(&mut c, view(",%rax\nmovq %rax,"));
            stack_slot(&mut c, slot);
            c.out.push(10);
            size := ffi_record_size(&mut c, d);
            c.export_copyback.push(keep);
            c.export_copyback.push(copy);
            c.export_copyback.push(size);
            own(&mut c, slot, ty);
            init_parameter(&mut c, slot, ty);
        } else {
            own(&mut c, slot, ty);
            init_parameter(&mut c, slot, ty);
        }
    }
    // The parameter refinements hold here: the parameters are the arguments they were given and
    // their bookkeeping is done (a view's target is tracked), and the first statement has not been
    // reached, so a failure inside the check reports the call site rather than a line of this body.
    // The prologue's bytes, for the second entry (ref_entry): everything from the frame setup to
    // here is what a proved call has to run, and the checks are what it may skip.
    mut prologue = u8[];
    for i in pro_start .. c.out.len() {
        prologue.push(c.out[i]);
    }
    ref_params(&mut c);
    // The body begins after the checks: the second entry jumps here.
    body_lbl := label(&mut c);
    mark(&mut c, body_lbl);
    // A refined parameter can state what the body's bounds checks need (pv_bce), for this body only.
    old_bce_index := exchange(&mut c.bce_index, u8[]);
    old_bce_base := exchange(&mut c.bce_base, u8[]);
    pv_bce(&mut c);
    mut tls_slot = 0;
    mut adopt_slot = 0;
    if (export == 2) & tls_bridge(&mut c) {
        tls_slot = fresh(&mut c);
        adopt_slot = fresh(&mut c);
        tls_enter_callback(&mut c, tls_slot, adopt_slot);
        exchange(&mut c.export_tls, tls_slot);
        exchange(&mut c.export_adopt, adopt_slot);
    }
    // An `unsafe fn`'s body sits one level down: raw pointers and foreign calls in it need no inner
    // `unsafe` block, and the caller owes the block instead.
    depth := c.unsafe_depth;
    if unsafe_fn != 0 {
        exchange(&mut c.unsafe_depth, depth + 1);
    }
    // The facts of this body start at its entry, where a refined parameter holds because the entry
    // checked it or the caller proved it (the `.proved` convention), and they are this body's alone.
    pv_begin(&mut c);
    block(&mut c);
    pv_end(&mut c);
    if unsafe_fn != 0 {
        exchange(&mut c.unsafe_depth, depth);
    }
    exchange(&mut c.bce_index, old_bce_index);
    exchange(&mut c.bce_base, old_bce_base);
    exchange(&mut c.export_tls, 0);
    exchange(&mut c.export_adopt, 0);
    if c.terminated == 0 {
        callback_copy_back(&mut c);
    }
    exchange(&mut c.export_copyback, u64[]);
    if c.raw == 0 {
        if (c.terminated == 0) & (ret != 1) {
            fail(&mut c, view("function may fall through without return"));
        }
    }
    cleanup(&mut c, 0);
    if tls_slot != 0 {
        tls_leave_callback(&mut c, tls_slot, adopt_slot);
    }
    o(&mut c, view("xorq %rax,%rax\nleave\nret\n.set "));
    fname(&mut c, frame);
    c.out.push(44);
    on(&mut c, div(c.next + 1, 2) * 16);
    c.out.push(10);
    if (c.debug != 0) & (c.validating == 0) {
        dend = label(&mut c);
        mark(&mut c, dend);
    }
    // A literal binding learned its type from a later use: discard this attempt and recompile.
    if c.retry != 0 {

        exchange(&mut c.part, part_mark);
        exchange(&mut c.lpart, part_lpart);
        exchange(&mut c.label, part_label);
        exchange(&mut c.ref_next, part_ref);
        // The unit's own counters go back with it: a discarded attempt must not spend its numbers.
        c.lunit = part_lunit;
        if (part_lunit != 0) & (part_lunit <= c.lnext.len()) {
            c.lnext[part_lunit - 1] = part_label;
            c.rnext[part_lunit - 1] = part_ref;
        }
        while out_mark < c.out.len() {
            c.out.pop();
        }
        // Facts describe the text just discarded, so they go with it.
        llvm::facts_truncate(&mut c.facts, fact_mark);
        edge_mark := c.fx_edge_mark;
        fx_edges_truncate(&mut c, edge_mark);
        while closure_mark < c.closures.len() {
            c.closures.pop();
        }
        // The retried body creates its closures again, so their ordinals start where they did.
        exchange(&mut c.spec_closures, spec_closure_mark);
        exchange(&mut c.retry, 0);
        exchange(&mut c.tolerant, 0);
        a := c.attempts + 1;
        exchange(&mut c.attempts, a);
        exchange(&mut c.pos, position);
        func(&mut c, pass, public);
        exchange(&mut c.attempts, 0);
        return ();
    }
    if (c.debug != 0) & (c.validating == 0) {
        site := DebugSite {
            file: c.file - 1,
            line: source_line(&c, position),
            start: dstart,
            end: dend,
            params: count
        };
        record_debug_func(&mut c, view(name), view(m), &site);
    }
    // The second entry, out of line: reached only by a call site that proved every predicate. It
    // sits after the function's own range, so a debug line table never attributes it to the body.
    ref_entry(&mut c, view(m), view(name), view(body_symbol), export, body_lbl, view(prologue));
    fx_end(&mut c);
    exchange(&mut c.hints, u64[]);
    return ();
}
fn interface_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    if c.raw != 0 {
        fail(&mut c, view("unsafe runtime cannot publish safe interfaces"));
    }
    expect(&mut c, view("interface"));
    name := ident(&mut c);
    if same(view(name), view("Send")) || same(view(name), view("Share")) {
        fail(&mut c, view("structural capability names are reserved"));
    }
    if same(view(name), view("Drop")) {
        fail(&mut c, view("`Drop` is built in: write `impl Drop for T { fn drop(self: &mut T) { ... } }`"));
    }
    module := module_copy(&mut c);
    id := ensure_interface(&mut c, module, name);
    interface_public := c.decl_public;
    // `interface B: A + C`.
    mut supers = u64[];
    if eat(&mut c, view(":")) {
        while true {
            first := ident(&mut c);
            mut sm = module_copy(&mut c);
            mut sn = first.copy();
            if eat(&mut c, view("::")) {
                sm = first.copy();
                sn = ident(&mut c);
            } else {
                imported := resolve_import(&mut c, view(sn));
                if imported.len() != 0 {
                    sm = imported;
                }
            }
            sup := ensure_interface(&mut c, sm, sn);
            if sup == id {
                fail(&mut c, view("an interface cannot extend itself"));
            }
            supers.push(sup);
            if !eat(&mut c, view("+")) {
                break;
            }
        }
    }
    if pass == 1 {
        item := &mut c.interfaces[id - 1];
        exchange(&mut item.supers, supers.copy());
        item := &c.interfaces[id - 1];
        defined := item.defined;
        if defined != 0 {
            fail(&mut c, view("duplicate interface"));
        }
        item := &mut c.interfaces[id - 1];
        exchange(&mut item.defined, 1);
        exchange(&mut item.public, interface_public);
        if !is(&mut c, view("{")) {
            fail(&mut c, view("expected interface body"));
        }
        // Associated types are known from the first pass on, so a signature anywhere can name
        // `T::Item` whatever order the files come in.
        mut depth = 0;
        mut at = c.pos;
        while kind_at(&mut c, at) != 0 {
            kt := kind_at(&mut c, at);
            if kt == 123 {
                depth += 1;
            } else if kt == 125 {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            } else if depth == 1 {
                word := tok_text(&mut c, at);
                if same(view(word), view("type")) && (kind_at(&mut c, at + 1) == 1) {
                    assoc_name := tok_text(&mut c, at + 1);
                    existing := copy_names(&c.interfaces[id - 1].assoc);
                    for k in existing.len() {
                        if same(view(existing[k]), view(assoc_name)) {
                            fail(&mut c, view("duplicate associated type"));
                        }
                    }
                    item := &mut c.interfaces[id - 1];
                    item.assoc.push(assoc_name);
                }
            }
            at += 1;
        }
        skip_braces(&mut c);
        return ();
    }
    if pass == 3 {
        skip_braces(&mut c);
        return ();
    }
    expect(&mut c, view("{"));
    proof := intern(&mut c, 15, id);
    mut proofs = u64[];
    proofs.push(proof);
    self := intern_args(&mut c, 9, 0, 0, u64[], proofs);
    exchange(&mut c.self_type, self);
    while !eat(&mut c, view("}")) {
        if eat(&mut c, view("type")) {
            assoc_name := ident(&mut c);
            mut bounds = u64[];
            if eat(&mut c, view(":")) {
                while true {
                    first := ident(&mut c);
                    mut bm = module_copy(&mut c);
                    mut bn = first.copy();
                    if eat(&mut c, view("::")) {
                        bm = first.copy();
                        bn = ident(&mut c);
                    } else {
                        imported := resolve_import(&mut c, view(bn));
                        if imported.len() != 0 {
                            bm = imported;
                        }
                    }
                    bound := ensure_interface(&mut c, bm, bn);
                    bounds.push(bound);
                    if !eat(&mut c, view("+")) {
                        break;
                    }
                }
            }
            expect(&mut c, view(";"));
            names := copy_names(&c.interfaces[id - 1].assoc);
            for j in names.len() {
                if same(view(names[j]), view(assoc_name)) {
                    item := &mut c.interfaces[id - 1];
                    while item.assoc_bounds.len() <= j {
                        item.assoc_bounds.push(u64[]);
                    }
                    exchange(&mut item.assoc_bounds[j], bounds.copy());
                }
            }
            continue;
        }
        header := c.pos;
        expect(&mut c, view("fn"));
        name := ident(&mut c);
        lifetime_parameters(&mut c);
        // `fn map<U>(...)`: the method's own type parameters follow Self (parameter 0).
        own_names := exchange(&mut c.tnames, u8[][]);
        own_bounds := exchange(&mut c.type_bounds, u64[]);
        own_sets := exchange(&mut c.type_interfaces, u64[][]);
        if own_names.len() != 0 {
            c.tnames.push(copy_bytes(view("Self")));
            c.type_bounds.push(0);
            c.type_interfaces.push(u64[id]);
            for k in own_names.len() {
                c.tnames.push(own_names[k].copy());
                c.type_bounds.push(own_bounds[k]);
                c.type_interfaces.push(copy_numbers(&own_sets[k]));
            }
        }
        module := private_module(view(".interface_"), id);
        if find_func(&mut c, view(module), view(name)) != 0 {
            fail(&mut c, view("duplicate interface method"));
        }
        first := c.params.len();
        expect(&mut c, view("("));
        // Elided lifetimes follow the function rules (func): each input reference gets its own,
        // and an elided output takes the receiver's, or the only input's.
        exchange(&mut c.input_regions, u64[]);
        exchange(&mut c.receiver_region, 0);
        exchange(&mut c.output_region, 0);
        exchange(&mut c.parsing_input, 1);
        mut count = 0;
        if !eat(&mut c, view(")")) {
            while true {
                p := ident(&mut c);
                expect(&mut c, view(":"));
                ty := parse_type(&mut c);
                if same(view(p), view("self")) & (ty_kind(&mut c, ty) == 7) {
                    rr := outer_region(&mut c, ty);
                    exchange(&mut c.receiver_region, rr);
                }
                c.params.push(ty);
                count += 1;
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        exchange(&mut c.parsing_input, 0);
        if c.receiver_region != 0 {
            exchange(&mut c.output_region, c.receiver_region);
        } else {
            if c.input_regions.len() == 1 {
                exchange(&mut c.output_region, c.input_regions[0]);
            }
        }
        mut ret = 1;
        if eat(&mut c, view("->")) {
            ret = parse_type(&mut c);
        }
        exchange(&mut c.output_region, 0);
        // `fn name(...) -> T { body }` is a default: an implementation may leave it out.
        mut default = 0;
        if is(&mut c, view("{")) {
            default = header + 1;
            skip_braces(&mut c);
        } else {
            expect(&mut c, view(";"));
        }
        mut bounds = u64[0];
        mut requirements = u64[][];
        requirements.push(u64[id]);
        mut method_types = 1;
        if c.tnames.len() != 0 {
            bounds = copy_numbers(&c.type_bounds);
            requirements = copy_constraints(&c.type_interfaces);
            method_types = c.tnames.len();
        }
        exchange(&mut c.tnames, u8[][]);
        exchange(&mut c.type_bounds, u64[]);
        exchange(&mut c.type_interfaces, u64[][]);
        regions := c.rnames.len();
        item_public_9 := c.decl_public;
        item_home_9 := module_copy(&mut c);
        c
            .funcs
            .push(
                Func {
                    public: item_public_9,
                    home: item_home_9,
                    module: module,
                    name: name,
                    first: first,
                    count: count,
                    ret: ret,
                    types: method_types,
                    regions: regions,
                    file: 0,
                    pos: 0,
                    raw: 0,
                    unsafe_fn: 0,
                    bounds: bounds,
                    constraints: requirements,
                    contract: id,
                    owner: 0,
                    ext: 0,
                    symbol: u8[],
                    body: u8[],
                    ppreds: Pred[],
                    rpred: no_pred(),
                    pnames: u8[][],
                    strict: 0,
                    no_alloc: 0,
                    no_panic: 0,
                }
            );
        index := c.funcs.len() - 1;
        here_file := c.file;
        item := &mut c.interfaces[id - 1];
        item.methods.push(index);
        item.defaults.push(default);
        item.default_files.push(here_file);
    }
    exchange(&mut c.self_type, NO_TYPE);
    return ();
}
// ---- default interface methods ---------------------------------------------------------------------
// An implementation that leaves out a method with a default body gets that body as if it had been
// written in the implementation: it is compiled once per implementing type, with `Self` that type,
// names resolving in the interface's module, and diagnostics pointing at the interface (Rust's
// provided methods). `pass` 2 declares them once every implementation's own methods are known;
// pass 3 emits their bodies.
fn default_methods<a>(c: (&a mut C), pass: u64) -> unit {
    saved_file := c.file;
    saved_module := c.module.copy();
    saved_raw := c.raw;
    mut touched = false;
    for k in c.implementations.len() {
        implementation := &c.implementations[k];
        contract := implementation.contract;
        ty := implementation.ty;
        owner := implementation.module.copy();
        own := copy_numbers(&implementation.methods);
        if iface_owned(&mut c, view(owner)) {
            continue;
        }
        interface := &c.interfaces[contract - 1];
        expected := copy_numbers(&interface.methods);
        defaults := copy_numbers(&interface.defaults);
        files := copy_numbers(&interface.default_files);
        home := interface.module.copy();
        for j in expected.len() {
            if (defaults.len() <= j) || (defaults[j] == 0) {
                continue;
            }
            name := c.funcs[expected[j]].name.copy();
            mut written = false;
            for m in own.len() {
                if same(view(c.funcs[own[m]].name), view(name)) && !default_copy(&c, own[m]) {
                    written = true;
                }
            }
            if written {
                continue;
            }
            touched = true;
            load_file(&mut c, files[j]);
            exchange(&mut c.file, files[j]);
            exchange(&mut c.pos, defaults[j] - 1);
            exchange(&mut c.raw, 0);
            exchange(&mut c.module, home.copy());
            opted := u64(host_opted(&c, view(c.module)));
            exchange(&mut c.host_optin, opted);
            exchange(&mut c.rnames, u8[][]);
            exchange(&mut c.tnames, u8[][]);
            exchange(&mut c.type_bounds, u64[]);
            exchange(&mut c.type_interfaces, u64[][]);
            exchange(&mut c.current_impl, k + 1);
            exchange(&mut c.self_type, ty);
            before := c.funcs.len();
            func(&mut c, pass, 0);
            exchange(&mut c.current_impl, 0);
            exchange(&mut c.self_type, NO_TYPE);
            if pass == 2 {
                item := &mut c.implementations[k];
                item.methods.push(before);
                c.default_copies.push(before);
            }
        }
    }
    if touched {
        load_file(&mut c, saved_file);
        exchange(&mut c.file, saved_file);
        exchange(&mut c.module, saved_module);
        exchange(&mut c.raw, saved_raw);
        opted := u64(host_opted(&c, view(c.module)));
        exchange(&mut c.host_optin, opted);
    }
    return ();
}
// Whether method `index` is a copied default rather than written in its implementation.
fn default_copy<a>(c: (&a C), index: u64) -> bool {
    for i in c.default_copies.len() {
        if c.default_copies[i] == index {
            return true;
        }
    }
    return false;
}
fn impl_has_for<a>(c: (&a mut C)) -> bool {
    mut i = c.pos;
    while (kind_at(&mut c, i) != 123) & (kind_at(&mut c, i) != 0) {
        t := tok_text(&mut c, i);
        if same(view(t), view("for")) {
            return true;
        }
        i += 1;
    }
    return false;
}
// The impl_params key of a generic interface implementation (implementation id, 1-based): above
// every declaration index, which is what an inherent impl's key is.
fn generic_impl_key(id: u64) -> u64 {
    return 1000000000 + id;
}
fn impl_record<a>(c: (&a mut C), owner: u64) -> u64 {
    for i in c.impl_params.len() {
        p := &c.impl_params[i];
        if p.decl == owner {
            return i + 1;
        }
    }
    return 0;
}
fn impl_self<a>(c: (&a mut C), owner: u64) -> u64 {
    r := impl_record(&mut c, owner);
    if r != 0 {
        p := &c.impl_params[r - 1];
        return p.self_ty;
    }
    // A non-generic interface implementation whose method has its own type parameters.
    if owner >= generic_impl_key(0) {
        return c.implementations[owner - generic_impl_key(0) - 1].ty;
    }
    return intern_args(&mut c, 8, owner - 1, 0, u64[], u64[]);
}
fn prepend_impl_params<a>(c: (&a mut C)) -> unit {
    mut owner = c.inherent;
    if (owner == 0) && (c.current_impl != 0) {
        owner = generic_impl_key(c.current_impl);
    }
    r := impl_record(&mut c, owner);
    if r == 0 {
        return ();
    }
    p := &c.impl_params[r - 1];
    mut rn = copy_names(&p.rnames);
    mut tn = copy_names(&p.tnames);
    mut bd = copy_numbers(&p.bounds);
    mut it = copy_constraints(&p.interfaces);
    own_r := copy_names(&c.rnames);
    for i in own_r.len() {
        x := &own_r[i];
        rn.push(x.copy());
    }
    own_t := copy_names(&c.tnames);
    for i in own_t.len() {
        x := &own_t[i];
        tn.push(x.copy());
    }
    // The function's own parameters now follow the implementation's.
    shift := tn.len() - own_t.len();
    for k in c.assoc_eqs.len() / 3 {
        old := c.assoc_eqs[3 * k];
        exchange(&mut c.assoc_eqs[3 * k], old + shift);
    }
    own_b := copy_numbers(&c.type_bounds);
    for i in own_b.len() {
        bd.push(own_b[i]);
    }
    own_i := copy_constraints(&c.type_interfaces);
    for i in own_i.len() {
        it.push(copy_numbers(&own_i[i]));
    }
    exchange(&mut c.rnames, rn);
    exchange(&mut c.tnames, tn);
    exchange(&mut c.type_bounds, bd);
    exchange(&mut c.type_interfaces, it);
    return ();
}
fn implementation<a>(c: (&a mut C), pass: u64) -> unit {
    if c.raw != 0 {
        fail(&mut c, view("unsafe runtime cannot implement safe interfaces"));
    }
    impl_file := c.file;
    impl_pos := c.pos;
    expect(&mut c, view("impl"));
    // `impl Type { fn ... }`: methods and associated functions of a nominal type in this module.
    if ((kind(&mut c) == 1) & (next_kind(&mut c) == 123))
        || (is(&mut c, view("<")) & !impl_has_for(&mut c))
        || (
            (kind(&mut c) == 1)
                & (next_kind(&mut c) == 60)
                & !impl_has_for(&mut c)
        ) {
        if pass == 1 {
            while !is(&mut c, view("{")) {
                advance(&mut c);
            }
            skip_braces(&mut c);
            return ();
        }
        // impl<T> Stack<T> { ... }: the impl's parameters are prepended to every method's.
        exchange(&mut c.rnames, u8[][]);
        exchange(&mut c.tnames, u8[][]);
        exchange(&mut c.type_bounds, u64[]);
        exchange(&mut c.type_interfaces, u64[][]);
        if is(&mut c, view("<")) {
            lifetime_parameters(&mut c);
        }
        module := module_copy(&mut c);
        name := tok_text(&mut c, c.pos);
        d := find_decl(&mut c, view(module), view(name));
        if d == 0 {
            fail(&mut c, view("impl needs a struct or enum declared in this module"));
        }
        ty := parse_type(&mut c);
        if (ty_kind(&mut c, ty) != 8) || (ty_arg(&mut c, ty) != d - 1) {
            fail(&mut c, view("impl needs a struct or enum declared in this module"));
        }
        args := type_args(&mut c, ty);
        if args.len() != c.tnames.len() {
            fail(&mut c, view("impl type arguments must be its own parameters, in order"));
        }
        for i in args.len() {
            a := args[i];
            if (ty_kind(&mut c, a) != 9) || (ty_arg(&mut c, a) != i) {
                fail(&mut c, view("impl type arguments must be its own parameters, in order"));
            }
        }
        if pass == 2 {
            c
                .impl_params
                .push(
                    ImplParams {
                        decl: d,
                        rnames: copy_names(&c.rnames),
                        tnames: copy_names(&c.tnames),
                        bounds: copy_numbers(&c.type_bounds),
                        interfaces: copy_constraints(&c.type_interfaces),
                        self_ty: ty,
                    }
                );
        }
        exchange(&mut c.inherent, d);
        exchange(&mut c.self_type, ty);
        expect(&mut c, view("{"));
        while !eat(&mut c, view("}")) {
            public := u64(eat(&mut c, view("pub")));
            func(&mut c, pass, public);
        }
        exchange(&mut c.inherent, 0);
        exchange(&mut c.self_type, NO_TYPE);
        return ();
    }
    if pass == 1 {
        while !is(&mut c, view("{")) {
            if kind(&mut c) == 0 {
                fail(&mut c, view("unclosed implementation"));
            }
            advance(&mut c);
        }
        skip_braces(&mut c);
        return ();
    }
    exchange(&mut c.rnames, u8[][]);
    exchange(&mut c.tnames, u8[][]);
    exchange(&mut c.type_bounds, u64[]);
    exchange(&mut c.type_interfaces, u64[][]);
    // `impl<T: B> I for X<T>`: a generic implementation, its methods templates over T.
    if is(&mut c, view("<")) {
        lifetime_parameters(&mut c);
    }
    impl_rnames := copy_names(&c.rnames);
    impl_tnames := copy_names(&c.tnames);
    impl_bounds := copy_numbers(&c.type_bounds);
    impl_ifaces := copy_constraints(&c.type_interfaces);
    mut module = module_copy(&mut c);
    mut name = ident(&mut c);
    mut qualified = 0;
    if eat(&mut c, view("::")) {
        qualified = 1;
        module = name;
        name = ident(&mut c);
    }
    if qualified == 0 {
        imported := resolve_import(&mut c, view(name));
        if imported.len() != 0 {
            module = imported;
        }
    }
    mut contract = find_interface(&c, view(module), view(name));
    // `Drop` belongs to no module, so a bare `impl Drop for T` names it directly.
    if (contract == 0) & (qualified == 0) & same(view(name), view("Drop")) {
        contract = c.drop_iface;
    }
    interface_visible(&mut c, contract);
    if contract == 0 {
        fail(&mut c, view("unknown implemented interface"));
    }
    expect(&mut c, view("for"));
    ty := parse_type(&mut c);
    mut id = find_implementation(&mut c, contract, ty);
    if pass == 2 {
        if id != 0 {
            fail(&mut c, view("overlapping interface implementation"));
        }
        owner := module_copy(&mut c);
        item := &c.interfaces[contract - 1];
        mut permitted = u64(same(view(item.module), view(owner)));
        if ty_kind(&mut c, ty) == 8 {
            decl := ty_arg(&mut c, ty);
            d := &c.decls[decl];
            if same(view(d.module), view(owner)) {
                permitted = 1;
            }
        }
        if permitted == 0 {
            fail(&mut c, view("implementation must own the interface or nominal type"));
        }
        c
            .implementations
            .push(
                Implementation {
                    contract: contract,
                    ty: ty,
                    module: owner,
                    methods: u64[],
                    file: impl_file,
                    pos: impl_pos + 1,
                    assoc_names: u8[][],
                    assoc_types: u64[],
                }
            );
        id = c.implementations.len();
        if contract == c.drop_iface {
            drop_impl_registered(&mut c, ty);
        }
        if impl_tnames.len() != 0 {
            c
                .impl_params
                .push(
                    ImplParams {
                        decl: generic_impl_key(id),
                        rnames: copy_names(&impl_rnames),
                        tnames: copy_names(&impl_tnames),
                        bounds: copy_numbers(&impl_bounds),
                        interfaces: copy_constraints(&impl_ifaces),
                        self_ty: ty,
                    }
                );
        }
    }
    if id == 0 {
        fail(&mut c, view("implementation header missing"));
    }
    exchange(&mut c.current_impl, id);
    exchange(&mut c.self_type, ty);
    expect(&mut c, view("{"));
    while !eat(&mut c, view("}")) {
        // `type Item = u64;`: an associated type, before the methods that name it.
        if eat(&mut c, view("type")) {
            assoc_name := ident(&mut c);
            expect(&mut c, view("="));
            assoc_ty := parse_type(&mut c);
            expect(&mut c, view(";"));
            if pass == 2 {
                existing := copy_names(&c.implementations[id - 1].assoc_names);
                for k in existing.len() {
                    if same(view(existing[k]), view(assoc_name)) {
                        fail(&mut c, view("duplicate associated type"));
                    }
                }
                item := &mut c.implementations[id - 1];
                item.assoc_names.push(assoc_name);
                item.assoc_types.push(assoc_ty);
            }
            continue;
        }
        before := c.funcs.len();
        // func prepends the implementation's own parameters (prepend_impl_params).
        func(&mut c, pass, 0);
        if pass == 2 {
            item := &mut c.implementations[id - 1];
            item.methods.push(before);
        }
    }
    exchange(&mut c.current_impl, 0);
    exchange(&mut c.self_type, NO_TYPE);
    return ();
}
fn bound_signature<a, b>(c: (&a mut C), index: u64, arguments: (&b u64[])) -> u64 {
    f := &c.funcs[index];
    first := f.first;
    count := f.count;
    ret := f.ret;
    mut params = u64[];
    for i in count {
        bound := bind_types(&mut c, c.params[first + i], &arguments);
        params.push(bound);
    }
    result := bind_types(&mut c, ret, &arguments);
    return intern_args(&mut c, 12, result, 0, u64[], params);
}
fn resolve_interface_method<a, b>(c: (&a mut C), contract: u64, ty: u64, name: &b [u8]) -> u64 {
    implementation := find_implementation(&mut c, contract, ty);
    if implementation == 0 {
        fail(&mut c, view("missing interface implementation"));
    }
    item := &c.implementations[implementation - 1];
    methods := copy_numbers(&item.methods);
    for i in methods.len() {
        index := methods[i];
        f := &c.funcs[index];
        if same(view(f.name), view(name)) {
            return index;
        }
    }
    fail(&mut c, view("missing interface method"));
    return 0;
}
fn check_interfaces<a>(c: (&a mut C)) -> unit {
    for i in c.dyn_ifaces.len() {
        id := c.dyn_ifaces[i];
        if c.interfaces[id - 1].defined != 0 {
            check_object_safety(&mut c, id);
        }
    }
    for i in c.interfaces.len() {
        item := &c.interfaces[i];
        defined := item.defined;
        module := item.module.copy();
        name := item.name.copy();
        if defined == 0 {
            fail(&mut c, view("unknown interface in generic bound"));
        }
        if find_decl(&mut c, view(module), view(name)) != 0 {
            fail(&mut c, view("interface and nominal type names conflict"));
        }
    }
    for i in c.implementations.len() {
        item := &c.implementations[i];
        contract := item.contract;
        ty := item.ty;
        methods := copy_numbers(&item.methods);
        impl_file := item.file;
        impl_pos := item.pos;
        interface := &c.interfaces[contract - 1];
        expected := copy_numbers(&interface.methods);
        // Every associated type the interface declares, and only those.
        assoc := copy_names(&interface.assoc);
        given := copy_names(&item.assoc_names);
        for g in given.len() {
            mut known = false;
            for a in assoc.len() {
                if same(view(assoc[a]), view(given[g])) {
                    known = true;
                }
            }
            if !known {
                mut message = u8[];
                push_bytes(&mut message, view("associated type `"));
                push_bytes(&mut message, view(given[g]));
                push_bytes(&mut message, view("` is not a member of the interface"));
                if impl_pos != 0 {
                    load_file(&mut c, impl_file);
                    exchange(&mut c.file, impl_file);
                    exchange(&mut c.pos, impl_pos - 1);
                }
                fail(&mut c, view(message));
            }
        }
        if impl_pos != 0 {
            for a in assoc.len() {
                mut present = false;
                for g in given.len() {
                    if same(view(assoc[a]), view(given[g])) {
                        present = true;
                    }
                }
                if !present {
                    mut message = u8[];
                    push_bytes(&mut message, view("missing associated type `"));
                    push_bytes(&mut message, view(assoc[a]));
                    push_bytes(&mut message, view("` (write: type "));
                    push_bytes(&mut message, view(assoc[a]));
                    push_bytes(&mut message, view(" = ...;)"));
                    load_file(&mut c, impl_file);
                    exchange(&mut c.file, impl_file);
                    exchange(&mut c.pos, impl_pos - 1);
                    fail(&mut c, view(message));
                }
            }
        }
        // Implementing `B: A` requires an implementation of A for the same type.
        if impl_pos != 0 {
            supers := all_supers(&mut c, contract);
            ity := c.implementations[i].ty;
            for s in supers.len() {
                if !satisfies_interface(&mut c, ity, supers[s]) {
                    mut message = u8[];
                    push_bytes(&mut message, view("implementing `"));
                    push_bytes(&mut message, view(c.interfaces[contract - 1].name));
                    push_bytes(&mut message, view("` requires implementing `"));
                    push_bytes(&mut message, view(c.interfaces[supers[s] - 1].name));
                    push_bytes(&mut message, view("` for the same type"));
                    load_file(&mut c, impl_file);
                    exchange(&mut c.file, impl_file);
                    exchange(&mut c.pos, impl_pos - 1);
                    fail(&mut c, view(message));
                }
            }
        }
        // Each associated type the implementation gives meets the interface's bounds on it.
        if impl_pos != 0 {
            for a in assoc.len() {
                mut bounds = u64[];
                if a < c.interfaces[contract - 1].assoc_bounds.len() {
                    bounds = copy_numbers(&c.interfaces[contract - 1].assoc_bounds[a]);
                }
                for g in given.len() {
                    if same(view(assoc[a]), view(given[g])) {
                        gty := c.implementations[i].assoc_types[g];
                        for b in bounds.len() {
                            if !satisfies_interface(&mut c, gty, bounds[b]) {
                                mut message = u8[];
                                push_bytes(&mut message, view("associated type `"));
                                push_bytes(&mut message, view(assoc[a]));
                                push_bytes(&mut message, view("` does not implement `"));
                                push_bytes(&mut message, view(c.interfaces[bounds[b] - 1].name));
                                push_bytes(&mut message, view("`, which the interface requires"));
                                load_file(&mut c, impl_file);
                                exchange(&mut c.file, impl_file);
                                exchange(&mut c.pos, impl_pos - 1);
                                fail(&mut c, view(message));
                            }
                        }
                    }
                }
            }
        }
        // A method the interface does not declare is reported where it is written; a required one
        // that is missing, at the `impl`.
        for j in methods.len() {
            g := &c.funcs[methods[j]];
            mut known = false;
            for e in expected.len() {
                if same(view(c.funcs[expected[e]].name), view(g.name)) {
                    known = true;
                }
            }
            if !known {
                file := g.file;
                pos := g.pos;
                mut message = u8[];
                push_bytes(&mut message, view("method `"));
                push_bytes(&mut message, view(g.name));
                push_bytes(&mut message, view("` is not a member of the interface"));
                load_file(&mut c, file);
                exchange(&mut c.file, file);
                exchange(&mut c.pos, pos);
                fail(&mut c, view(message));
            }
        }
        for e in expected.len() {
            name := c.funcs[expected[e]].name.copy();
            mut present = false;
            for j in methods.len() {
                if same(view(c.funcs[methods[j]].name), view(name)) {
                    present = true;
                }
            }
            if !present {
                mut message = u8[];
                push_bytes(&mut message, view("missing interface method `"));
                push_bytes(&mut message, view(name));
                push_bytes(&mut message, view("` (it has no default body)"));
                if impl_pos != 0 {
                    load_file(&mut c, impl_file);
                    exchange(&mut c.file, impl_file);
                    exchange(&mut c.pos, impl_pos - 1);
                }
                fail(&mut c, view(message));
            }
        }
        for j in expected.len() {
            abstract := expected[j];
            f := &c.funcs[abstract];
            name := f.name.copy();
            actual := resolve_interface_method(&mut c, contract, ty, view(name));
            mut arguments = u64[ty];
            mut own = impl_param_types(&mut c, i + 1);
            // The method's own type parameters, matched by position on both sides.
            abstract_own := c.funcs[abstract].types - 1;
            actual_own := c.funcs[actual].types - own.len();
            if abstract_own != actual_own {
                g := &c.funcs[actual];
                file := g.file;
                pos := g.pos;
                load_file(&mut c, file);
                exchange(&mut c.file, file);
                exchange(&mut c.pos, pos);
                fail(&mut c, view("method type parameters do not match the interface"));
            }
            for k in abstract_own {
                marker := intern_args(&mut c, 9, 1000 + k, 0, u64[], u64[]);
                arguments.push(marker);
                own.push(marker);
            }
            signature := bound_signature(&mut c, abstract, &arguments);
            concrete := bound_signature(&mut c, actual, &own);
            if same_type(&mut c, concrete, signature) == 0 {
                // Report at the implementing method, not wherever parsing ended.
                g := &c.funcs[actual];
                file := g.file;
                pos := g.pos;
                load_file(&mut c, file);
                exchange(&mut c.file, file);
                exchange(&mut c.pos, pos);
                fail(&mut c, view("method signature does not match the interface"));
            }
        }
    }
    return ();
}
fn interface_call<a, b>(c: (&a mut C), contract: u64, name: &b [u8]) -> Val {
    module := private_module(view(".interface_"), contract);
    return call(&mut c, view(module), view(name));
}
// const NAME: T = literal; (integers, bool, text). Uses inline the value.
// ---- compile-time constant expressions (docs/design/comptime.md, stage C1) ----
// A folded value: an integer (ty 0, unsigned 64-bit arithmetic, overflow is an error), a bool
// (bool_type), or a target tag such as `.windows` (ct_tag_ty). The folder reads tokens and emits no
// code; it is what `@if`, `@assert`, `@expr` and the right-hand side of a constant evaluate.
struct CVal {
    value: u64,
    ty: u64
}
fn ct_tag_ty() -> u64 {
    return CT_TAG;
}
// A tag's type is a sentinel, not an index into the type table, so it is never handed to is_bool.
fn ct_is_bool<a>(c: (&a mut C), ty: u64) -> bool {
    if ty == ct_tag_ty() {
        return false;
    }
    return is_bool(&mut c, ty);
}
fn ct_val(value: u64, ty: u64) -> CVal {
    return CVal { value: value, ty: ty };
}
// A value parameter in scope named `name`: index + 1, or 0.
fn value_param<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    // type_bounds can be shorter than tnames (closures carry their parent's names), and `&` does
    // not short-circuit, so the bound is read only once the index is known to be in range.
    for i in c.tnames.len() {
        if (i < c.type_bounds.len()) && same(view(c.tnames[i]), name) {
            if (c.type_bounds[i] & 4) != 0 {
                return i + 1;
            }
        }
    }
    return 0;
}
// A value parameter's value in the specialisation being compiled, and its declared type. Unbound
// (a template checked before any instantiation) it reads as 0 and sets ct_unbound, which makes an
// @assert that depends on it wait for the instantiation instead of judging a placeholder.
fn value_param_value<a>(c: (&a mut C), i: u64) -> CVal {
    vty := c.type_bounds[i] / 8;
    mut value = 0;
    if i < c.bindings.len() {
        mut b = c.bindings[i];
        // A binding may arrive behind an indirection (kind 10), as canonical_type also unwraps.
        while (b != 0) && (b != NO_TYPE) && (ty_kind(&mut c, b) == 10) {
            b = ty_arg(&mut c, b);
        }
        if (b != 0) && (b != NO_TYPE) && (ty_kind(&mut c, b) == 31) {
            value = ty_arg(&mut c, b);
        } else {
            exchange(&mut c.ct_unbound, 1);
        }
    } else {
        exchange(&mut c.ct_unbound, 1);
    }
    if is_bool(&mut c, vty) {
        return ct_val(value, bool_type(&mut c));
    }
    return ct_val(value, 0);
}
// The tags `target.os` and `target.arch` compare against.
fn ct_tag<a>(c: (&a mut C), name: &a [u8]) -> u64 {
    if same(view(name), view("linux")) { return 1; }
    if same(view(name), view("windows")) { return 2; }
    if same(view(name), view("macos")) { return 3; }
    if same(view(name), view("x86_64")) { return 11; }
    if same(view(name), view("aarch64")) { return 12; }
    if same(view(name), view("riscv64")) { return 13; }
    fail(&mut c, view("unknown target tag: expected .linux, .windows, .macos, .x86_64, .aarch64 or .riscv64"));
    return 0;
}
fn ct_bool<a>(c: (&a mut C), v: CVal, what: &a [u8]) -> u64 {
    if !ct_is_bool(&mut c, v.ty) {
        fail(&mut c, view(what));
    }
    return v.value;
}
fn ct_int<a>(c: (&a mut C), v: CVal) -> u64 {
    if (v.ty == ct_tag_ty()) || ct_is_bool(&mut c, v.ty) {
        fail(&mut c, view("this compile-time operator needs integers"));
    }
    return v.value;
}
// size_of / align_of: defined where the size is a fact of the target - scalars, bool, handles and
// C pointers, and extern "C" records (their C layout). A Grail record or vector is a managed
// object whose layout the language does not promise, so it is refused rather than given a number.
fn ct_layout<a>(c: (&a mut C), align: u64) -> u64 {
    expect(&mut c, view("("));
    ty := parse_type(&mut c);
    expect(&mut c, view(")"));
    if ct_is_bool(&mut c, ty) {
        return 1;
    }
    k := ty_kind(&mut c, ty);
    if (is_c_record(&mut c, ty) != 0) & (c.ct_pass != 0) & (c.ct_pass < 3) & c.ct_in_if {
        // A module-level @if decides which declarations exist, so it is decided in every pass,
        // before record layouts are complete: it can test scalars and target, not a record.
        fail(&mut c, view("a module-level @if cannot depend on the layout of a record; test it with @assert, or inside a function"));
    }
    if (ty == 0) || (k == 18) || (k == 21) || (k == 23) || (k == 24) || (k == 26) || (is_c_record(&mut c, ty) != 0) {
        if align != 0 {
            return ffi_field_align(&mut c, ty);
        }
        return ffi_field_size(&mut c, ty);
    }
    fail(&mut c, view("size_of and align_of take a scalar, a handle or C pointer, or an extern \"C\" record: a Grail record or vector has no layout the language promises"));
    return 0;
}
fn ct_primary<a>(c: (&a mut C)) -> CVal {
    here := c.pos;
    k := kind(&mut c);
    bt := bool_type(&mut c);
    if k == 2 {
        t := tok_text(&mut c, here);
        v := literal_value(&mut c, view(t));
        advance(&mut c);
        return ct_val(v, 0);
    }
    if is(&mut c, view("true")) || is(&mut c, view("false")) {
        v := u64(is(&mut c, view("true")));
        advance(&mut c);
        return ct_val(v, bt);
    }
    if eat(&mut c, view("(")) {
        v := ct_expr(&mut c, 0);
        expect(&mut c, view(")"));
        return v;
    }
    if eat(&mut c, view("!")) {
        v := ct_primary(&mut c);
        b := ct_bool(&mut c, v, view("! needs a bool"));
        return ct_val(1 - b, bt);
    }
    if eat(&mut c, view(".")) {
        name := ident(&mut c);
        return ct_val(ct_tag(&mut c, view(name)), ct_tag_ty());
    }
    if k == 1 {
        if is(&mut c, view("size_of")) || is(&mut c, view("align_of")) {
            align := u64(is(&mut c, view("align_of")));
            advance(&mut c);
            return ct_val(ct_layout(&mut c, align), 0);
        }
        if is(&mut c, view("target")) & (next_kind(&mut c) == 46) {
            advance(&mut c);
            advance(&mut c);
            field := ident(&mut c);
            arch := c.target;
            if same(view(field), view("os")) {
                mut os = 1;
                if (arch == 3) || (arch == 4) {
                    os = 2;
                }
                if c.plat == 1 {
                    os = 3;
                }
                return ct_val(os, ct_tag_ty());
            }
            if same(view(field), view("arch")) {
                mut a = 11;
                if (arch == 1) || (arch == 4) {
                    a = 12;
                }
                if arch == 2 {
                    a = 13;
                }
                return ct_val(a, ct_tag_ty());
            }
            if same(view(field), view("pointer_bits")) {
                return ct_val(64, 0);
            }
            fail(&mut c, view("target has os, arch and pointer_bits"));
        }
        after := c.pos + 1;
        here_tok := c.pos;
        if !is_at(&mut c, after, view("::")) {
            name_text := tok_text(&mut c, here_tok);
            vp := value_param(&mut c, view(name_text));
            if vp != 0 {
                advance(&mut c);
                return value_param_value(&mut c, vp - 1);
            }
        }
        if (c.ct_loop_names.len() != 0) & is_at(&mut c, c.pos + 1, view(".")) {
            loop_name := tok_text(&mut c, c.pos);
            b := ct_loop_binding(&mut c, view(loop_name));
            if b != 0 {
                advance(&mut c);
                advance(&mut c);
                what := ident(&mut c);
                if !same(view(what), view("index")) {
                    fail(&mut c, view("in a compile-time condition a field from @for has .index"));
                }
                return ct_val(c.ct_loop_index[b - 1], 0);
            }
        }
        if ct_call_ahead(&mut c) {
            text := ct_take_call_text(&mut c);
            here_module := module_copy(&mut c);
            r := run_tier(&mut c, view(here_module), view(text), view(""));
            if (r.ty == 3) || ((r.ty != 0) && (ct_seq_elem(&mut c, r.ty) != NO_TYPE)) {
                fail(&mut c, view("a compile-time call in an expression must give an integer or a bool; bind a string or a table with NAME := f();"));
            }
            return ct_val(r.value, r.ty);
        }
        mut module = module_copy(&mut c);
        mut name = ident(&mut c);
        if eat(&mut c, view("::")) {
            module = name;
            name = ident(&mut c);
        }
        resolve_pending_named(&mut c, view(module), view(name));
        for i in c.constants.len() {
            q := &c.constants[i];
            if same(view(q.module), view(module)) & same(view(q.name), view(name)) {
                ty := q.ty;
                value := q.value;
                if (ty == 3) || is_float(&mut c, ty) {
                    exchange(&mut c.pos, here);
                    fail(&mut c, view("only integer and bool constants can be used in a compile-time expression"));
                }
                if ct_is_bool(&mut c, ty) {
                    return ct_val(value, bt);
                }
                return ct_val(value, 0);
            }
        }
        exchange(&mut c.pos, here);
        fail(&mut c, view("not a compile-time constant: a compile-time expression may use literals, constants, size_of, align_of and target"));
    }
    fail(&mut c, view("expected a compile-time constant expression"));
    return ct_val(0, 0);
}
fn ct_expr<a>(c: (&a mut C), min: u64) -> CVal {
    mut left = ct_primary(&mut c);
    bt := bool_type(&mut c);
    while true {
        k := kind(&mut c);
        p := prec(k);
        if (p == 0) || (p <= min) {
            break;
        }
        advance(&mut c);
        right := ct_expr(&mut c, p);
        if (k == 274) || (k == 273) {
            a := ct_bool(&mut c, left, view("|| and && need bools"));
            b := ct_bool(&mut c, right, view("|| and && need bools"));
            if k == 274 {
                left = ct_val(u64((a != 0) || (b != 0)), bt);
            } else {
                left = ct_val(u64((a != 0) && (b != 0)), bt);
            }
            continue;
        }
        if is_comparison(k) {
            if (left.ty == ct_tag_ty()) != (right.ty == ct_tag_ty()) {
                fail(&mut c, view("a target tag compares only with another tag"));
            }
            if ct_is_bool(&mut c, left.ty) != ct_is_bool(&mut c, right.ty) {
                fail(&mut c, view("a compile-time comparison needs two values of the same kind"));
            }
            a := left.value;
            b := right.value;
            mut r = false;
            if k == 258 { r = a == b; }
            if k == 259 { r = a != b; }
            if (left.ty == ct_tag_ty()) & (k != 258) & (k != 259) {
                fail(&mut c, view("target tags support only == and !="));
            }
            if k == 60 { r = a < b; }
            if k == 62 { r = a > b; }
            if k == 269 { r = a <= b; }
            if k == 270 { r = a >= b; }
            left = ct_val(u64(r), bt);
            continue;
        }
        if ((k == 38) || (k == 124)) & ct_is_bool(&mut c, left.ty) {
            a := ct_bool(&mut c, left, view("& and | on a bool need two bools"));
            b := ct_bool(&mut c, right, view("& and | on a bool need two bools"));
            if k == 38 {
                left = ct_val(a & b, bt);
            } else {
                left = ct_val(a | b, bt);
            }
            continue;
        }
        a := ct_int(&mut c, left);
        b := ct_int(&mut c, right);
        mut r: u64 = 0;
        if k == 38 { r = a & b; }
        if k == 124 { r = a | b; }
        if k == 94 { r = a ^ b; }
        if (k == 271) || (k == 272) {
            if 63 < b {
                fail(&mut c, view("compile-time shift amount must be below 64"));
            }
            if k == 271 {
                r = a << b;
                if (r >> b) != a {
                    fail(&mut c, view("compile-time integer overflow"));
                }
            } else {
                r = a >> b;
            }
        }
        if k == 43 {
            r = wrapping_add(a, b);
            if r < a {
                fail(&mut c, view("compile-time integer overflow"));
            }
        }
        if k == 45 {
            if b > a {
                fail(&mut c, view("compile-time integer underflow: constants are unsigned"));
            }
            r = a - b;
        }
        if k == 42 {
            if (a != 0) & (b > 18446744073709551615 / a) {
                fail(&mut c, view("compile-time integer overflow"));
            }
            r = a * b;
        }
        if (k == 47) || (k == 37) {
            if b == 0 {
                fail(&mut c, view("compile-time division by zero"));
            }
            if k == 47 {
                r = a / b;
            } else {
                r = a % b;
            }
        }
        if k == 267 {
            r = 1;
            for i in b {
                if (a != 0) & (r > 18446744073709551615 / a) {
                    fail(&mut c, view("compile-time integer overflow"));
                }
                r = r * a;
            }
        }
        left = ct_val(r, 0);
    }
    return left;
}
// `@if cond { ... } else @if cond { ... } else { ... }`: the branch whose condition holds is
// compiled; the others are skipped token for token - parsed only far enough to find their braces,
// never type-checked or emitted - so they may name declarations that exist only on another target.
// `top` selects declarations (module level) or statements (inside a function).
fn ct_if<a>(c: (&a mut C), pass: u64, top: u64) -> unit {
    expect(&mut c, view("if"));
    mut done = 0;
    while true {
        cond := ct_expr(&mut c, 0);
        take := ct_bool(&mut c, cond, view("@if needs a bool condition"));
        ct_branch(&mut c, pass, top, u64((take != 0) & (done == 0)));
        if take != 0 {
            done = 1;
        }
        if !eat(&mut c, view("else")) {
            return ();
        }
        after := c.pos + 1;
        if (kind(&mut c) == 64) & is_at(&mut c, after, view("if")) {
            advance(&mut c);
            advance(&mut c);
            continue;
        }
        ct_branch(&mut c, pass, top, u64(done == 0));
        return ();
    }
    return ();
}
fn ct_branch<a>(c: (&a mut C), pass: u64, top: u64, take: u64) -> unit {
    open := c.pos;
    if !is(&mut c, view("{")) {
        fail(&mut c, view("expected { after the @if condition"));
    }
    close := block_end(&mut c, open);
    if take == 0 {
        exchange(&mut c.pos, close + 1);
        return ();
    }
    if top == 0 {
        block(&mut c);
        return ();
    }
    advance(&mut c);
    while c.pos < close {
        toplevel_item(&mut c, pass);
    }
    expect(&mut c, view("}"));
    return ();
}
// `@assert(cond, "message")`: a compile error carrying the message when cond is false.
fn ct_assert<a>(c: (&a mut C)) -> unit {
    if c.probe_mode != 0 {
        // The program's own compile checks its assertions; a probe only computes a value.
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        advance(&mut c);
        return ();
    }
    at := c.pos;
    exchange(&mut c.ct_unbound, 0);
    expect(&mut c, view("assert"));
    expect(&mut c, view("("));
    cond := ct_expr(&mut c, 0);
    holds := ct_bool(&mut c, cond, view("@assert needs a bool condition"));
    expect(&mut c, view(","));
    if kind(&mut c) != 3 {
        fail(&mut c, view("@assert needs a message: @assert(condition, \"why it must hold\")"));
    }
    text := decode_literal(&mut c, c.pos);
    advance(&mut c);
    expect(&mut c, view(")"));
    expect(&mut c, view(";"));
    unbound := exchange(&mut c.ct_unbound, 0);
    if (holds == 0) & (unbound == 0) {
        exchange(&mut c.pos, at - 1);
        mut msg = u8[];
        push_bytes(&mut msg, view("@assert failed: "));
        push_bytes(&mut msg, view(text));
        fail(&mut c, view(msg));
    }
    return ();
}
// `@` at the start of a statement or a module item.
fn ct_form<a>(c: (&a mut C), pass: u64, top: u64) -> unit {
    advance(&mut c);
    mut level = 0;
    if top != 0 {
        level = pass;
    }
    old_pass := exchange(&mut c.ct_pass, level);
    if is(&mut c, view("if")) {
        old_in_if := exchange(&mut c.ct_in_if, true);
        ct_if(&mut c, pass, top);
        exchange(&mut c.ct_in_if, old_in_if);
        exchange(&mut c.ct_pass, old_pass);
        return ();
    }
    if is(&mut c, view("assert")) {
        if (top != 0) & (pass != 3) {
            // A module-level assertion is checked once, in the last pass, when every declaration
            // and record layout it can name is complete; earlier passes only step over it.
            while !is(&mut c, view(";")) {
                advance(&mut c);
            }
            advance(&mut c);
            return ();
        }
        ct_assert(&mut c);
        exchange(&mut c.ct_pass, old_pass);
        return ();
    }
    if is(&mut c, view("for")) {
        if top != 0 {
            fail(&mut c, view("@for is a statement: it unrolls a block inside a function"));
        }
        ct_for(&mut c);
        exchange(&mut c.ct_pass, old_pass);
        return ();
    }
    fail(&mut c, view("unknown compile-time form: expected @if, @assert or @for here"));
    return ();
}
// ---- the run tier (docs/design/comptime.md, C3) -------------------------------------------------
// A compile-time form that calls a function is evaluated by running it: the compiler writes a probe
// program whose `main` prints the call's value, compiles it together with this program's own
// files (so the call is this program's code, compiled by this compiler), links and runs it with
// every ambient effect refused, and reads the value back. Results are cached by the digest of the
// probe and every input file, so an unchanged program never runs a probe twice.
struct CTRes {
    ty: u64,
    value: u64,
    text: u8[]
}
// True when the next tokens are a call `name(` or `module::name(`, not one of the constant-tier
// builtins.
fn ct_call_ahead<a>(c: (&a mut C)) -> bool {
    if kind(&mut c) != 1 {
        return false;
    }
    here := c.pos;
    first := tok_text(&mut c, here);
    if same(view(first), view("size_of")) || same(view(first), view("align_of")) || same(view(first), view("target")) {
        return false;
    }
    mut at = here + 1;
    if kind_at(&mut c, at) == 260 {
        at = at + 2;
    }
    return kind_at(&mut c, at) == 40;
}
// The source text of the call starting here, through its closing parenthesis; the tokens are
// consumed.
fn ct_take_call_text<a>(c: (&a mut C)) -> u8[] {
    first := c.pos;
    while kind(&mut c) != 40 {
        advance(&mut c);
    }
    mut depth = 0;
    mut last = c.pos;
    while true {
        k := kind(&mut c);
        if k == 40 {
            depth += 1;
        }
        if k == 41 {
            depth -= 1;
            if depth == 0 {
                last = c.pos;
                advance(&mut c);
                break;
            }
        }
        if k == 0 {
            fail(&mut c, view("unterminated compile-time call"));
        }
        advance(&mut c);
    }
    start := c.toks[first].start;
    end := c.toks[last].end;
    mut out = u8[];
    for i in start..end {
        out.push(c.src[i]);
    }
    return out;
}
// Module constants whose value is a call are evaluated on first use.
fn resolve_pending_named<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> unit {
    for i in c.constants.len() {
        if (c.constants[i].ty == CT_PENDING) && same(view(c.constants[i].module), module) && same(view(c.constants[i].name), name) {
            resolve_pending(&mut c, i);
        }
    }
    return ();
}
fn resolve_pending<a>(c: (&a mut C), i: u64) -> unit {
    m := c.constants[i].module.copy();
    n := c.constants[i].name.copy();
    text := c.constants[i].text.copy();
    mut key = m.copy();
    push_bytes(&mut key, view("::"));
    push_bytes(&mut key, view(n));
    pending := host::env(view("GRAIL_COMPTIME_PENDING"));
    if ct_list_has(view(pending), view(key)) {
        mut msg = copy_bytes(view("constant `"));
        push_bytes(&mut msg, view(n));
        push_bytes(&mut msg, view("` depends on itself through a compile-time call"));
        fail(&mut c, view(msg));
    }
    r := run_tier(&mut c, view(m), view(text), view(key));
    exchange(&mut c.constants[i].ty, r.ty);
    exchange(&mut c.constants[i].value, r.value);
    exchange(&mut c.constants[i].text, r.text);
    return ();
}
// Every constant still pending at the end of a compile is evaluated, so its errors are reported and
// an interface records its value. A probe compile evaluates only what it uses.
fn resolve_all_pending<a>(c: (&a mut C)) -> unit {
    if c.probe_mode != 0 {
        return ();
    }
    for i in c.constants.len() {
        if c.constants[i].ty == CT_PENDING {
            resolve_pending(&mut c, i);
        }
    }
    return ();
}
// The type a pending constant will have: its call's result type.
fn ct_pending_type<a>(c: (&a mut C), i: u64) -> u64 {
    text := c.constants[i].text.copy();
    m := c.constants[i].module.copy();
    toks := lexer::tokenize(view(text));
    if toks.len() == 0 {
        return NO_TYPE;
    }
    mut fmod = m.copy();
    mut fname = slice_bytes(view(text), toks[0].start, toks[0].end);
    if (toks.len() > 2) && (toks[1].kind == 260) {
        fmod = fname.copy();
        fname = slice_bytes(view(text), toks[2].start, toks[2].end);
    }
    f := ct_module_names(&mut c, view(fmod), view(fname));
    if f == 0 {
        // No such function: the constant's type is unknown, not u64 (id 0 is u64, so returning 0
        // here typed an unresolvable constant as an integer).
        return NO_TYPE;
    }
    ret := c.funcs[f - 1].ret;
    if is_bool(&mut c, ret) || (ret == 3) || (ct_seq_elem(&mut c, ret) != NO_TYPE) {
        return ret;
    }
    return 0;
}
// The element type of a vector of integers (bytes count as u8), or the "none" word.
fn ct_seq_elem<a>(c: (&a mut C), ty: u64) -> u64 {
    // A sentinel is not a type to look inside: asking about one is answered "not a sequence", which
    // is what the caller's NO_TYPE test then reads.
    if !is_type_id(ty) {
        return NO_TYPE;
    }
    if ty == 2 {
        return int_type(&mut c, 8, 0);
    }
    if (ty != 0) && (ty != 3) && (ty_kind(&mut c, ty) == 6) {
        elem := ty_arg(&mut c, ty);
        if integer(&mut c, elem) && !is_bool(&mut c, elem) {
            return elem;
        }
    }
    return NO_TYPE;
}
fn ct_list_has<a, b>(list: &a [u8], item: &b [u8]) -> bool {
    mut start = 0;
    mut i = 0;
    while i <= list.len() {
        if (i == list.len()) || (list[i] == 44) {
            if i - start == item.len() {
                mut hit = true;
                for j in item.len() {
                    if list[start + j] != item[j] {
                        hit = false;
                    }
                }
                if hit {
                    return true;
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return false;
}
// A function or constant of `module` named `name` (no visibility check: the probe's own lookup).
fn ct_module_names<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> u64 {
    for i in c.funcs.len() {
        if same(view(c.funcs[i].module), module) && same(view(c.funcs[i].name), name) {
            return i + 1;
        }
    }
    return 0;
}
fn ct_shell_quote<a>(text: &a [u8]) -> u8[] {
    mut out = copy_bytes(view("'"));
    for i in text.len() {
        if text[i] == 39 {
            push_bytes(&mut out, view("'\\''"));
        } else {
            out.push(text[i]);
        }
    }
    out.push(39);
    return out;
}
fn run_tier<a, b, d, e>(c: (&a mut C), module: &b [u8], text: &d [u8], key: &e [u8]) -> CTRes {
    // The call's function, for its result type.
    toks := lexer::tokenize(text);
    if (toks.len() < 3) || (toks[0].kind != 1) {
        fail(&mut c, view("a compile-time call is `f(...)` or `module::f(...)`"));
    }
    mut fmod = module.copy();
    mut fname = slice_bytes(text, toks[0].start, toks[0].end);
    if (toks.len() > 2) && (toks[1].kind == 260) && (toks[2].kind == 1) {
        fmod = fname.copy();
        fname = slice_bytes(text, toks[2].start, toks[2].end);
    }
    f := ct_module_names(&mut c, view(fmod), view(fname));
    if f == 0 {
        mut msg = copy_bytes(view("compile-time call to an unknown function `"));
        push_bytes(&mut msg, view(fname));
        msg.push(96);
        fail(&mut c, view(msg));
    }
    ret := c.funcs[f - 1].ret;
    if c.funcs[f - 1].types != 0 {
        fail(&mut c, view("a compile-time call names a generic function; call a function of concrete types"));
    }
    mut rty = 0;
    if is_bool(&mut c, ret) {
        rty = bool_type(&mut c);
    } else if ret == 3 {
        rty = 3;
    } else if ct_seq_elem(&mut c, ret) != NO_TYPE {
        // A vector of integers, or bytes: a table, which is what running code early is for.
        rty = ret;
    } else if !integer(&mut c, ret) {
        fail(&mut c, view("a compile-time call must give an integer, a bool, a string, bytes or a vector of integers (a value the program can hold as data)"));
    }
    // The probe: this module's names qualified, the value printed.
    mut qualified = u8[];
    mut last_end = 0;
    for i in toks.len() {
        tstart := toks[i].start;
        tend := toks[i].end;
        tkind := toks[i].kind;
        for j in last_end..tstart {
            qualified.push(text[j]);
        }
        word := slice_bytes(text, tstart, tend);
        prev_scope := (i >= 1) && (toks[i - 1].kind == 260);
        prev_dot := (i >= 1) && (toks[i - 1].kind == 46);
        next_scope := (i + 1 < toks.len()) && (toks[i + 1].kind == 260);
        if (tkind == 1) && !prev_scope && !prev_dot && !next_scope && (ct_module_names(&mut c, module, view(word)) != 0) {
            push_bytes(&mut qualified, module);
            push_bytes(&mut qualified, view("::"));
        }
        push_bytes(&mut qualified, view(word));
        last_end = tend;
    }
    for j in last_end..text.len() {
        qualified.push(text[j]);
    }
    mut probe = copy_bytes(view("module grail_probe;\n\nuse "));
    push_bytes(&mut probe, module);
    push_bytes(&mut probe, view(";\n\nfn main() -> u64 {\n    v := "));
    push_bytes(&mut probe, view(qualified));
    if rty == 3 {
        push_bytes(&mut probe, view(";\n    print(v);\n    return 0;\n}\n"));
    } else if (rty != 0) && (ct_seq_elem(&mut c, rty) != NO_TYPE) {
        // One element per line, as an unsigned word.
        push_bytes(&mut probe, view(";\n    for i in v.len() {\n        println(u64(v[i]));\n    }\n    return 0;\n}\n"));
    } else {
        push_bytes(&mut probe, view(";\n    println(v);\n    return 0;\n}\n"));
    }
    // The cache key: the probe and every input file.
    mut keyed = probe.copy();
    offset := c.arg_offset;
    argc := host::argc();
    mut files = u8[][];
    mut fi = offset + 2;
    if c.probe_mode != 0 {
        // A probe compile's own first file is its probe; a nested probe takes the program's files.
        fi = offset + 3;
    }
    while fi < argc {
        path := host::arg(fi);
        files.push(path.copy());
        push_bytes(&mut keyed, view(path));
        push_bytes(&mut keyed, view(host::read_file(view(path))));
        fi += 1;
    }
    digest := iface_digest(&keyed);
    mut dir = copy_bytes(view(".work/comptime/"));
    for i in 24 {
        dir.push(digest[i]);
    }
    out_path := path_cat(view(dir), view("/value"));
    if host::exists(view(out_path)) == 0 {
        mut mk = u8[][copy_bytes(view("mkdir")), copy_bytes(view("-p")), dir.copy()];
        host::command(mk);
        // Compiles that run the same call at once (parallel test shards, a parallel build) share
        // `dir`: each builds under names of its own - keyed by this compile's output path - and
        // only the finished value is published, by rename, so no one reads a half-written file.
        own_key := iface_digest(&host::arg(offset + 1));
        mut tag = copy_bytes(view("/"));
        for i in 12 {
            tag.push(own_key[i]);
        }
        probe_src := path_cat(view(path_cat(view(dir), view(tag))), view(".probe.grl"));
        probe_s := path_cat(view(path_cat(view(dir), view(tag))), view(".probe.s"));
        probe_exe := path_cat(view(path_cat(view(dir), view(tag))), view(".probe"));
        value_tmp := path_cat(view(path_cat(view(dir), view(tag))), view(".value"));
        host::write_file(view(probe_src), view(probe));
        self := host::exe_path();
        mut cmd = ct_shell_quote(view(self));
        mut opt = 1;
        while opt < offset + 1 {
            a := host::arg(opt);
            if starts_with(view(a), view("--overflow=")) {
                cmd.push(32);
                push_bytes(&mut cmd, view(a));
            }
            opt += 1;
        }
        push_bytes(&mut cmd, view(" --target x86_64 --comptime-probe "));
        push_bytes(&mut cmd, view(ct_shell_quote(view(probe_s))));
        cmd.push(32);
        push_bytes(&mut cmd, view(ct_shell_quote(view(probe_src))));
        for i in files.len() {
            cmd.push(32);
            push_bytes(&mut cmd, view(ct_shell_quote(view(files[i]))));
        }
        mut pending = host::env(view("GRAIL_COMPTIME_PENDING"));
        if key.len() != 0 {
            if pending.len() != 0 {
                pending.push(44);
            }
            push_bytes(&mut pending, key);
        }
        depth_text := host::env(view("GRAIL_COMPTIME_DEPTH"));
        mut depth = 0;
        for i in depth_text.len() {
            depth = depth * 10 + u64(depth_text[i] - 48);
        }
        if 8 <= depth {
            fail(&mut c, view("compile-time calls nest more than 8 deep"));
        }
        mut compile = copy_bytes(view("GRAIL_COMPTIME_DEPTH="));
        decimal(&mut compile, depth + 1);
        push_bytes(&mut compile, view(" GRAIL_COMPTIME_PENDING="));
        push_bytes(&mut compile, view(ct_shell_quote(view(pending))));
        compile.push(32);
        push_bytes(&mut compile, view(cmd));
        mut sh = u8[][copy_bytes(view("sh")), copy_bytes(view("-c")), compile];
        if host::command(sh) != 0 {
            mut msg = copy_bytes(view("compile-time call `"));
            push_bytes(&mut msg, text);
            push_bytes(&mut msg, view("` did not compile (the errors above)"));
            fail(&mut c, view(msg));
        }
        asm := host::read_file(view(probe_s));
        if ct_list_has_sub(view(asm), view("// grail-link: ")) {
            fail(&mut c, view("compile-time code cannot call C: the call reaches an extern function"));
        }
        mut cc = host::env(view("GRAIL_CC"));
        if cc.len() == 0 {
            cc = copy_bytes(view("cc"));
        }
        mut link = u8[][cc, copy_bytes(view("-nostdlib")), copy_bytes(view("-static")), copy_bytes(view("-o")), probe_exe.copy(), probe_s.copy()];
        if host::command(link) != 0 {
            fail(&mut c, view("compile-time call: linking the probe failed (needs cc)"));
        }
        mut run = copy_bytes(view("GRAIL_COMPTIME=1 timeout 30 "));
        push_bytes(&mut run, view(ct_shell_quote(view(probe_exe))));
        push_bytes(&mut run, view(" > "));
        push_bytes(&mut run, view(ct_shell_quote(view(value_tmp))));
        mut sh2 = u8[][copy_bytes(view("sh")), copy_bytes(view("-c")), run];
        status := host::command(sh2);
        if status != 0 {
            mut msg = copy_bytes(view("compile-time call `"));
            push_bytes(&mut msg, text);
            if status == 124 {
                push_bytes(&mut msg, view("` ran past the 30 s limit"));
            } else if status == 4 {
                push_bytes(&mut msg, view("` reads a constant that is still being computed: the constants depend on each other in a cycle"));
            } else {
                push_bytes(&mut msg, view("` aborted (exit "));
                decimal(&mut msg, status);
                push_bytes(&mut msg, view(")"));
            }
            fail(&mut c, view(msg));
        }
        mut mv = u8[][copy_bytes(view("mv")), copy_bytes(view("-f")), value_tmp.copy(), out_path.copy()];
        host::command(mv);
        mut tidy = u8[][copy_bytes(view("rm")), copy_bytes(view("-f")), probe_src.copy(), probe_s.copy(), probe_exe.copy()];
        host::command(tidy);
    }
    printed := host::read_file(view(out_path));
    if rty == 3 {
        return CTRes { ty: 3, value: 0, text: printed };
    }
    if (rty != 0) && (ct_seq_elem(&mut c, rty) != NO_TYPE) {
        // The elements, laid out at the element's C width (little-endian), for read-only data.
        elem := ct_seq_elem(&mut c, rty);
        width := ffi_field_size(&mut c, elem);
        mut data = u8[];
        mut count = 0;
        mut v: u64 = 0;
        mut digits = 0;
        for i in printed.len() {
            ch := printed[i];
            if (48 <= ch) & (ch <= 57) {
                v = v * 10 + u64(ch - 48);
                digits += 1;
            } else if digits != 0 {
                for b in width {
                    data.push(u8((v >> (8 * b)) & 255));
                }
                count += 1;
                v = 0;
                digits = 0;
            }
        }
        return CTRes { ty: rty, value: count, text: data };
    }
    mut body = printed.copy();
    while (body.len() > 0) && (body[body.len() - 1] == 10) {
        body.pop();
    }
    if rty != 0 {
        return CTRes { ty: rty, value: u64(same(view(body), view("true"))), text: u8[] };
    }
    mut v = 0;
    for i in body.len() {
        v = v * 10 + u64(body[i] - 48);
    }
    return CTRes { ty: 0, value: v, text: u8[] };
}
fn ct_list_has_sub<a, b>(text: &a [u8], part: &b [u8]) -> bool {
    mut i = 0;
    while i + part.len() <= text.len() {
        mut hit = true;
        for j in part.len() {
            if text[i + j] != part[j] {
                hit = false;
                break;
            }
        }
        if hit {
            return true;
        }
        i += 1;
    }
    return false;
}
fn slice_bytes<a>(text: &a [u8], start: u64, end: u64) -> u8[] {
    mut out = u8[];
    for i in start..end {
        out.push(text[i]);
    }
    return out;
}
fn path_cat<a, b>(x: &a [u8], y: &b [u8]) -> u8[] {
    mut out = copy_bytes(x);
    push_bytes(&mut out, y);
    return out;
}
// `@for f in fields(T) { ... }` / `@for v in variants(E) { ... }`: the block is compiled once per
// field (or variant), in declaration order, with `f` a compile-time value: `f.name` is its name as a
// string, `f.index` its position, and `x.@f` the field itself. Each copy is type-checked with that
// field's type, so the body may do what the field's type allows. In a generic function checked
// before it is instantiated, `T` has no fields yet: the block is checked in each specialisation.
fn ct_for<a>(c: (&a mut C)) -> unit {
    expect(&mut c, view("for"));
    name := ident(&mut c);
    expect(&mut c, view("in"));
    which := ident(&mut c);
    want_enum := same(view(which), view("variants"));
    if !want_enum & !same(view(which), view("fields")) {
        fail(&mut c, view("@for iterates fields(T) or variants(E)"));
    }
    expect(&mut c, view("("));
    ty := parse_type(&mut c);
    expect(&mut c, view(")"));
    open := c.pos;
    if !is(&mut c, view("{")) {
        fail(&mut c, view("expected { after the @for list"));
    }
    close := block_end(&mut c, open);
    mut t = ty;
    while (t != 0) && (t != NO_TYPE) && (ty_kind(&mut c, t) == 10) {
        t = ty_arg(&mut c, t);
    }
    if (t == NO_TYPE) || (ty_kind(&mut c, t) == 9) {
        exchange(&mut c.pos, close + 1);
        return ();
    }
    k := ty_kind(&mut c, t);
    if k != 8 {
        if want_enum {
            fail(&mut c, view("variants takes an enum type"));
        }
        fail(&mut c, view("fields takes a record type"));
    }
    d := ty_arg(&mut c, t);
    is_enum := c.decls[d].is_enum;
    if want_enum & (is_enum == 0) {
        fail(&mut c, view("variants takes an enum type; use fields for a record"));
    }
    if !want_enum & (is_enum != 0) {
        fail(&mut c, view("fields takes a record type; use variants for an enum"));
    }
    count := c.decls[d].count;
    // The block's tokens are compiled once per field, so a binding whose last use is inside it is
    // still used by the next copy: the same window a run-time loop sets keeps it alive to the end.
    mut start = c.loop_start;
    mut end = c.loop_end;
    if end == 0 {
        start = open;
        end = close;
    }
    old_start := exchange(&mut c.loop_start, start);
    old_end := exchange(&mut c.loop_end, end);
    for i in count {
        c.ct_loop_names.push(name.copy());
        c.ct_loop_decls.push(d);
        c.ct_loop_index.push(i);
        exchange(&mut c.pos, open);
        block(&mut c);
        c.ct_loop_names.pop();
        c.ct_loop_decls.pop();
        c.ct_loop_index.pop();
    }
    exchange(&mut c.loop_start, old_start);
    exchange(&mut c.loop_end, old_end);
    exchange(&mut c.pos, close + 1);
    return ();
}
// The `@for` binding named `name`, innermost first: index + 1, or 0.
fn ct_loop_binding<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    mut i = c.ct_loop_names.len();
    while i > 0 {
        if same(view(c.ct_loop_names[i - 1]), name) {
            return i;
        }
        i -= 1;
    }
    return 0;
}
fn ct_loop_field_name<a>(c: (&a mut C), b: u64) -> u8[] {
    d := c.ct_loop_decls[b - 1];
    first := c.decls[d].first;
    return c.fields[first + c.ct_loop_index[b - 1]].name.copy();
}
// `NAME := expr;` at module level: a compile-time constant with its type inferred - u64 for an
// integer, bool for a bool, string for a text literal. The typed spelling is `const NAME: T = expr;`.
fn module_binding<a>(c: (&a mut C), pass: u64) -> unit {
    name := ident(&mut c);
    advance(&mut c);
    if pass != 1 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        advance(&mut c);
        return ();
    }
    module := module_copy(&mut c);
    for i in c.constants.len() {
        k := &c.constants[i];
        if same(view(k.module), view(module)) & same(view(k.name), view(name)) {
            fail(&mut c, view("duplicate constant"));
        }
    }
    mut ty = 0;
    mut value = 0;
    mut text = u8[];
    if ct_call_ahead(&mut c) {
        // `NAME := f(...);`: the run tier (C3). The call is evaluated when the constant is first
        // used - by then every function's signature is known - by compiling and running a probe.
        text = ct_take_call_text(&mut c);
        expect(&mut c, view(";"));
        constant_public := c.decl_public;
        c.constants.push(Constant { module: module, name: name, public: constant_public, ty: CT_PENDING, value: 0, text: text });
        return ();
    }
    if kind(&mut c) == 3 {
        ty = 3;
        text = decode_literal(&mut c, c.pos);
        advance(&mut c);
    } else {
        if kind(&mut c) == 5 {
            fail(&mut c, view("a float constant needs its type: const NAME: f64 = 1.5;"));
        }
        v := ct_expr(&mut c, 0);
        if v.ty == ct_tag_ty() {
            fail(&mut c, view("a target tag is not a value a program can hold; compare it in @if"));
        }
        value = v.value;
        if is_bool(&mut c, v.ty) {
            ty = bool_type(&mut c);
        }
    }
    expect(&mut c, view(";"));
    constant_public := c.decl_public;
    c.constants.push(Constant { module: module, name: name, public: constant_public, ty: ty, value: value, text: text });
    return ();
}
fn constant_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("const"));
    name := ident(&mut c);
    expect(&mut c, view(":"));
    // Registered in the first pass, so a module-level `@if` and every later declaration can fold
    // against it.
    if pass != 1 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        advance(&mut c);
        return ();
    }
    ty := parse_type(&mut c);
    expect(&mut c, view("="));
    module := module_copy(&mut c);
    for i in c.constants.len() {
        k := &c.constants[i];
        if same(view(k.module), view(module)) & same(view(k.name), view(name)) {
            fail(&mut c, view("duplicate constant"));
        }
    }
    negative := u64(eat(&mut c, view("-")));
    here := c.pos;
    k := kind(&mut c);
    mut value = 0;
    mut text = u8[];
    if negative != 0 && k == 5 {
        if !is_float(&mut c, ty) {
            fail(&mut c, view("float constant needs type f64 or f32"));
        }
        t := tok_text(&mut c, here);
        fp := float_precision(&mut c, ty);
        bits := float_bits_p(&mut c, view(t), fp);
        advance(&mut c);
        expect(&mut c, view(";"));
        item_public_10 := c.decl_public;
        c
            .constants
            .push(
                Constant {
                    public: item_public_10,
                    module: module,
                    name: name,
                    ty: ty,
                    value: bits ^ 9223372036854775808,
                    text: text,
                }
            );
        return ();
    }
    if (k == 2) & (negative != 0) {
        t := tok_text(&mut c, here);
        value = literal_value(&mut c, view(t));
        advance(&mut c);
        if (ty != 0) & (ty_kind(&mut c, ty) != 18) {
            fail(&mut c, view("integer constant needs an integer type"));
        }
        if literal_fits(&mut c, ty, value, negative) == 0 {
            fail(&mut c, view("integer literal out of range for its type"));
        }
        value = wrapping_sub(0, value);
    } else if (k != 5) & (k != 3) & (negative == 0) {
        // A compile-time constant expression: literals, other constants, size_of, align_of,
        // target, arithmetic, comparisons.
        v := ct_expr(&mut c, 0);
        value = v.value;
        if is_bool(&mut c, ty) {
            if !is_bool(&mut c, v.ty) {
                exchange(&mut c.pos, here);
                fail(&mut c, view("bool constant needs a bool value"));
            }
        } else {
            if (ty != 0) & (ty_kind(&mut c, ty) != 18) {
                exchange(&mut c.pos, here);
                fail(&mut c, view("constants must be integer, float, bool or text"));
            }
            if (v.ty != 0) {
                exchange(&mut c.pos, here);
                fail(&mut c, view("integer constant needs an integer value"));
            }
            if literal_fits(&mut c, ty, value, 0) == 0 {
                exchange(&mut c.pos, here);
                fail(&mut c, view("constant value out of range for its type"));
            }
        }
    } else {
        if negative != 0 {
            fail(&mut c, view("only integer constants can be negative"));
        }
        if k == 5 {
            if !is_float(&mut c, ty) {
                fail(&mut c, view("float constant needs type f64 or f32"));
            }
            t := tok_text(&mut c, here);
            fp := float_precision(&mut c, ty);
            value = float_bits_p(&mut c, view(t), fp);
            advance(&mut c);
        } else {
            if k == 3 {
                if ty != 3 {
                    fail(&mut c, view("text constant needs type string"));
                }
                text = decode_literal(&mut c, here);
                advance(&mut c);
            } else {
                if is(&mut c, view("true")) || is(&mut c, view("false")) {
                    if !is_bool(&mut c, ty) {
                        fail(&mut c, view("bool constant needs type bool"));
                    }
                    value = u64(is(&mut c, view("true")));
                    advance(&mut c);
                } else {
                    fail(&mut c, view("constants must be integer, float, bool or text literals"));
                }
            }
        }
    }
    expect(&mut c, view(";"));
    constant_public := c.decl_public;
    c.constants.push(Constant { module: module, name: name, public: constant_public, ty: ty, value: value, text: text });
    return ();
}
fn constant_value<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> Val {
    if c.probe_mode != 0 {
        // In a probe, a constant still being evaluated cannot be known; reading it is a cycle only
        // if the probed call gets there, so the read becomes a run-time stop the runner reports.
        mut key = copy_bytes(module);
        push_bytes(&mut key, view("::"));
        push_bytes(&mut key, name);
        pending := host::env(view("GRAIL_COMPTIME_PENDING"));
        if ct_list_has(view(pending), view(key)) {
            for i in c.constants.len() {
                if same(view(c.constants[i].module), module) && same(view(c.constants[i].name), name) {
                    slot := invoke(&mut c, view("rt_comptime_cycle"), u64[]);
                    pty := ct_pending_type(&mut c, i);
                    if pty == 3 {
                        // Never reached at run time (the call above exits); a real string keeps the
                        // ownership checker's view of the program whole.
                        empty := u8[];
                        return string_from_bytes(&mut c, &empty);
                    }
                    if (pty != 0) && (ct_seq_elem(&mut c, pty) != NO_TYPE) {
                        fresh := invoke(&mut c, view("rt_new"), u64[]);
                        return own(&mut c, fresh, pty);
                    }
                    return val(slot, pty);
                }
            }
        }
    }
    resolve_pending_named(&mut c, module, name);
    for i in c.constants.len() {
        k := &c.constants[i];
        if same(view(k.module), view(module)) & same(view(k.name), view(name)) {
            ty := k.ty;
            value := k.value;
            text := k.text.copy();
            kpublic := k.public;
            khome := k.module.copy();
            if kpublic == 0 {
                require_visible(&mut c, view(khome), view(name));
            }
            if (ty != 3) && (ty != 0) && (ct_seq_elem(&mut c, ty) != NO_TYPE) {
                // A compile-time table: its elements in read-only data, copied into a fresh vector
                // at each use (as a string constant is).
                elem := ct_seq_elem(&mut c, ty);
                l := label(&mut c);
                rodata(&mut c);
                o(&mut c, view(".balign 8\n"));
                mark(&mut c, l);
                for j in text.len() {
                    o(&mut c, view(".byte "));
                    on(&mut c, text[j]);
                    c.out.push(10);
                }
                o(&mut c, view(".byte 0\n.popsection\nleaq "));
                lname(&mut c, l);
                o(&mut c, view("(%rip),%rax\n"));
                ptr := save(&mut c);
                e := carray_elem_of(&mut c, elem);
                mut args = u64[ptr];
                args.push(imm(&mut c, value));
                for j in 4 {
                    args.push(imm(&mut c, e[j]));
                }
                t := invoke(&mut c, view("rt_carray_load"), args);
                return own(&mut c, t, ty);
            }
            if ty == 3 {
                l := label(&mut c);
                rodata(&mut c);
                mark(&mut c, l);
                for j in text.len() {
                    o(&mut c, view(".byte "));
                    on(&mut c, text[j]);
                    c.out.push(10);
                }
                o(&mut c, view(".byte 0\n.popsection\nleaq "));
                lname(&mut c, l);
                o(&mut c, view("(%rip),%rax\n"));
                ptr := save(&mut c);
                n := imm(&mut c, text.len());
                t := invoke(&mut c, view("rt_string_lit"), two(ptr, n));
                return own(&mut c, t, 3);
            }
            return val(imm(&mut c, value), ty);
        }
    }
    return val(0, NO_TYPE);
}
// 1 when `path` is in a directory that also holds core.grl: the standard-library directory in
// the repository (lib/) and in every installed layout (std/). Both separators are accepted.
fn in_std_dir<a>(path: &a [u8]) -> u64 {
    mut cut = 0;
    mut found = 0;
    for i in path.len() {
        if (path[i] == 47) || (path[i] == 92) {
            cut = i + 1;
            found = 1;
        }
    }
    mut probe = u8[];
    if found != 0 {
        for i in cut {
            probe.push(path[i]);
        }
    }
    name := "core.grl";
    for i in name.len() {
        probe.push(name[i]);
    }
    return host::exists(view(probe));
}
// Modules that declared `use host;`. Recorded per module so a replayed generic body is checked
// against its defining module, not against whichever file was parsed last.
fn host_opted<a, b>(c: (&a C), m: &b [u8]) -> bool {
    for i in c.host_modules.len() {
        if same(view(c.host_modules[i]), view(m)) {
            return true;
        }
    }
    return false;
}
fn toplevel<a>(c: (&a mut C), pass: u64) -> unit {
    // `unsafe module m;` is the trusted-module hatch. A leading `unsafe` before anything else is an
    // item's own hatch (`unsafe fn`, `unsafe struct ...`), so only `unsafe` + `module` is read here.
    mut raw = 0;
    if is(&mut c, view("unsafe")) {
        if is_at(&mut c, c.pos + 1, view("module")) {
            advance(&mut c);
            raw = 1;
        }
    }
    exchange(&mut c.raw, raw);
    mut m = "main".copy();
    if eat(&mut c, view("module")) {
        m = ident(&mut c);
        expect(&mut c, view(";"));
    } else {
        entry_file := (c.file == 2) || ((c.file == 3) & (c.probe_mode != 0));
        if !entry_file || raw != 0 {
            fail(&mut c, view("dependency files require an explicit module"));
        }
    }
    if same(view(m), view("runtime")) {
        if raw == 0 {
            fail(&mut c, view("runtime module must be explicitly unsafe"));
        }
    }
    if raw != 0 {
        // Two trusted modules: the portable runtime, and darwin for the macOS libSystem boundary,
        // which only exists in Mach-O builds.
        if !(same(view(m), view("runtime")) || same(view(m), view("darwin"))) {
            fail(&mut c, view("unsafe module reserved for runtime and darwin"));
        }
        if same(view(m), view("darwin")) & (c.plat == 0) {
            fail(&mut c, view("the darwin module requires a macos-x86_64 or macos-aarch64 target"));
        }
    }
    exchange(&mut c.module, m);
    exchange(&mut c.imports, Import[]);
    exchange(&mut c.host_optin, 0);
    while eat(&mut c, view("use")) {
        m = ident(&mut c);
        // `use host;` (or `use host::name;`) is this module's explicit opt-in to the ambient
        // `host::` interface; --deny-ambient-host refuses host:: references without it.
        if same(view(m), view("host")) {
            exchange(&mut c.host_optin, 1);
            if !host_opted(&c, view(c.module)) {
                c.host_modules.push(module_copy(&mut c));
            }
        }
        if eat(&mut c, view("::")) {
            n := ident(&mut c);
            c.imports.push(Import { module: m, name: n });
        }
        expect(&mut c, view(";"));
    }
    while kind(&mut c) != 0 {
        toplevel_item(&mut c, pass);
    }
    return ();
}
// One module-level item.
// `@strict;` makes every refinement obligation in this module a compile error, and `@strict` before
// a declaration makes that declaration's (docs/design/refinements.md). Returns 0 when the tokens are
// not this form, 1 when a declaration follows, and 2 when the module form was consumed alone.
fn ref_strict_form<a>(c: (&a mut C)) -> u64 {
    next := c.pos + 1;
    if kind_at(&mut c, next) != 1 {
        return 0;
    }
    word := tok_text(&mut c, next);
    if !same(view(word), view("strict")) {
        return 0;
    }
    advance(&mut c);
    advance(&mut c);
    if eat(&mut c, view(";")) {
        // The mode is kept by module name, so a replayed body is compiled in the mode its module
        // asked for, wherever the replay happens.
        m := module_copy(&mut c);
        if !ref_module_strict(&c, view(m)) {
            c.strict_modules.push(m);
        }
        return 2;
    }
    exchange(&mut c.strict_next, 1);
    return 1;
}
// ---- checked effects (G26, docs/design/effects.md) ------------------------------------------------
//
// `@no_alloc` and `@no_panic` are claims about a function *and everything it calls*, and the compiler
// proves them rather than trusting them: the facts are recorded where the front end emits the call,
// and settle by a fixpoint over the call graph. Allocation is anything that reaches `rt_alloc` - a
// `push`, a string built by `format`, a record or vector literal, an `alloc` block, a boxed closure,
// an `Rc` - because the runtime's `rt_alloc` is the one place the heap is asked for. The runtime's
// failure path (`rt_abort`, `rt_fail`, `rt_trap`, `rt_refine`, `rt_error`) is a root of the second
// graph: reaching one is what `@no_panic` refuses.
//
// The edges come from the statement the emitter is writing, not from the assembly it wrote.
// `call_out`, `call_proved_out`, `call_slot_out`, `call_dispatch_out` and `call_entry_out` are the
// only places a `call` line is emitted, and each records what the front end knows at that point:
//
// - a direct call records the callee's linker symbol, including the runtime's helpers and a drop
//   helper the compiler itself named;
// - `call *%rax` in user code (a closure, a function value, a `dyn` method slot) records an *unknown*
//   edge, which the solver treats as allocating and failing;
// - the compiler's own dispatch inside trusted code (a closure's drop through the slot its body
//   installed) records nothing: every body it can reach is a body of this build already;
// - a refined parameter's check in the checked entry records an entry fact, not a body edge, because
//   it is the caller's obligation (a caller that proved the predicate enters at `.proved`).
//
// What this buys over reading the emitted text back:
//
// - a check the prover removed is not in the IR at all, so it is not an edge; a scan cannot tell a
//   live call from one inside the bytes the optimizer is about to delete;
// - the callee is the symbol the front end chose, so dispatch the compiler built itself - a vtable's
//   drop slot - is resolved from recorded vtables (`fx_vtable_drop`) instead of a register name;
// - two instances of one generic are two records: the template's claim is the obligation, the
//   instance's own body is what proves it, and the refusal names the instance.
//
// `fx_end` counts the `call` lines in the bytes the body emitted and refuses a body whose count
// disagrees with the calls recorded for it: a call site that bypasses the recording helpers is a
// compiler bug, and a bug here is a silently weaker proof, so it is loud.

// `@no_alloc` and `@no_panic` on a declaration. The shape is `@strict`'s: no `;` form, further
// attributes may follow, and the next declaration consumes them. 1 when one was consumed.
fn fx_attr_form<a>(c: (&a mut C)) -> u64 {
    next := c.pos + 1;
    if kind_at(&mut c, next) != 1 {
        return 0;
    }
    word := tok_text(&mut c, next);
    if same(view(word), view("no_alloc")) {
        advance(&mut c);
        advance(&mut c);
        exchange(&mut c.fx_pending_alloc, 1);
        exchange(&mut c.fx_any, 1);
        return 1;
    }
    if same(view(word), view("no_panic")) {
        advance(&mut c);
        advance(&mut c);
        exchange(&mut c.fx_pending_panic, 1);
        exchange(&mut c.fx_any, 1);
        return 1;
    }
    return 0;
}
// The record of one function symbol: index + 1, appending a fresh one when this is its first mention.
fn fx_sym<a, b>(c: (&a mut C), sym: &b [u8]) -> u64 {
    for i in c.fx_syms.len() {
        if same(view(c.fx_syms[i]), view(sym)) {
            return i + 1;
        }
    }
    c.fx_syms.push(copy_bytes(view(sym)));
    c.fx_body.push(0);
    c.fx_attr_alloc.push(0);
    c.fx_attr_panic.push(0);
    c.fx_own_alloc.push(0);
    c.fx_own_panic.push(0);
    c.fx_alloc.push(0);
    c.fx_panic.push(0);
    c.fx_alloc_thru.push(0);
    c.fx_panic_thru.push(0);
    c.fx_fn_name.push(u8[]);
    c.fx_fn_file.push(0);
    c.fx_fn_pos.push(0);
    c.fx_entry_panic.push(0);
    return c.fx_syms.len();
}
// The name a diagnostic shows for a specialisation: the template's name and this instance's type
// arguments, so a refusal names `fill<main::File>` rather than the template it came from.
fn fx_instance_name<a, b>(c: (&a mut C), name: &b [u8], spec: u64) -> u8[] {
    mut out = copy_bytes(view(name));
    out.push(60);
    args := type_args_for_spec(&mut c, spec);
    for i in args.len() {
        if i != 0 {
            push_bytes(&mut out, view(", "));
        }
        spelling := type_name(&mut c, args[i]);
        push_bytes(&mut out, view(spelling));
    }
    out.push(62);
    return out;
}
// A body starts being recorded: one record per *emitted* body, so a generic's instances are judged
// apart. A specialisation inherits the template's claim - that is the obligation - and its own body
// is what proves or refuses it.
fn fx_begin<a, b, d>(c: (&a mut C), sym: &b [u8], name: &d [u8], file: u64, pos: u64, no_alloc: u64, no_panic: u64) -> unit {
    if c.fx_any == 0 {
        return ();
    }
    if c.validating != 0 {
        return ();
    }
    k := fx_sym(&mut c, view(sym)) - 1;
    c.fx_body[k] = 1;
    // A retried body starts over: facts from the discarded attempt are not this body's.
    c.fx_own_alloc[k] = 0;
    c.fx_own_panic[k] = 0;
    mut display = copy_bytes(view(name));
    mut claim_alloc = no_alloc;
    mut claim_panic = no_panic;
    if c.current_spec != 0 {
        spec := c.current_spec - 1;
        template := c.specs[spec].template;
        // The template's source name, not the specialisation's symbol: the diagnostic says
        // `fill<main::File>`, which is the code the author has to change.
        source := c.funcs[template].name.copy();
        display = fx_instance_name(&mut c, view(source), spec);
        if c.funcs[template].no_alloc != 0 {
            claim_alloc = 1;
        }
        if c.funcs[template].no_panic != 0 {
            claim_panic = 1;
        }
    }
    if claim_alloc != 0 {
        c.fx_attr_alloc[k] = 1;
    }
    if claim_panic != 0 {
        c.fx_attr_panic[k] = 1;
    }
    c.fx_fn_name[k] = display;
    c.fx_fn_file[k] = file;
    c.fx_fn_pos[k] = pos;
    c.fx_entry_panic[k] = 0;
    trusted := c.raw;
    exchange(&mut c.fx_trusted, trusted);
    out_len := c.out.len();
    exchange(&mut c.fx_out_start, out_len);
    edges := c.fx_edge_from.len();
    exchange(&mut c.fx_edge_mark, edges);
    exchange(&mut c.fx_calls, 0);
    exchange(&mut c.fx_skip_lo, 0);
    exchange(&mut c.fx_skip_hi, 0);
    if trusted != 0 {
        fx_root(&mut c, k, view(sym));
    }
    exchange(&mut c.fx_cur, k + 1);
    return ();
}
// The runtime's own roots: where allocation and failure actually happen. Every other runtime body is
// followed through its calls like user code, so a helper is an allocation exactly when it reaches one.
fn fx_root<a, b>(c: (&a mut C), k: u64, sym: &b [u8]) -> unit {
    mut at = 0;
    if (sym.len() != 0) && (sym[0] == 95) {
        at = 1;
    }
    mut name = u8[];
    for i in sym.len() - at {
        name.push(sym[at + i]);
    }
    if same(view(name), view("rt_alloc")) || same(view(name), view("rt_alloc_unlocked")) || same(view(name), view("rt_grow")) {
        c.fx_own_alloc[k] = 1;
    }
    if same(view(name), view("rt_abort")) || same(view(name), view("rt_fail")) || same(view(name), view("rt_trap")) || same(view(name), view("rt_refine")) || same(view(name), view("rt_error")) {
        c.fx_own_panic[k] = 1;
    }
    return ();
}
// One edge of the body being emitted. `name` empty is a call nothing names - an indirect one in user
// code - and the solver assumes it allocates and fails. `proved` marks a call that entered the
// callee past its parameter checks.
fn fx_edge<a, b>(c: (&a mut C), name: &b [u8], proved: u64) -> unit {
    cur := c.fx_cur;
    if cur == 0 {
        return ();
    }
    c.fx_edge_from.push(cur - 1);
    c.fx_edge_name.push(copy_bytes(view(name)));
    c.fx_edge_to.push(0);
    mut kind = proved;
    if c.fx_trusted != 0 {
        kind = kind | 4;
    }
    c.fx_edge_kind.push(kind);
    f := c.file;
    p := c.pos;
    c.fx_edge_file.push(f);
    c.fx_edge_pos.push(p);
    return ();
}
// The edge list back to where a body started: an attempt whose bytes were discarded does not get to
// leave its calls behind for the attempt that replaces them.
fn fx_edges_truncate<a>(c: (&a mut C), mark: u64) -> unit {
    while mark < c.fx_edge_from.len() {
        c.fx_edge_from.pop();
        c.fx_edge_name.pop();
        c.fx_edge_to.pop();
        c.fx_edge_kind.pop();
        c.fx_edge_file.pop();
        c.fx_edge_pos.pop();
    }
    return ();
}
// A `call` line the emitter writes that is not an edge, counted so the consistency check in `fx_end`
// still sees it.
fn fx_called<a>(c: (&a mut C)) -> unit {
    n := c.fx_calls;
    c.fx_calls = n + 1;
    return ();
}
// A direct call: recorded as an edge, then emitted. This is the only place a direct `call` line is
// written, so the record cannot disagree with the code.
fn call_out<a, b>(c: (&a mut C), callee: &b [u8]) -> unit {
    fx_edge(&mut c, view(callee), 0);
    fx_called(&mut c);
    o(&mut c, view("call "));
    o(&mut c, callee);
    c.out.push(10);
    return ();
}
// A direct call whose arguments proved every refinement of the callee's parameters: it enters at the
// callee's `.proved` entry, so the callee's entry checks are not this body's to answer for.
fn call_proved_out<a, b>(c: (&a mut C), callee: &b [u8]) -> unit {
    fx_edge(&mut c, view(callee), 8);
    fx_called(&mut c);
    o(&mut c, view("call "));
    o(&mut c, callee);
    o(&mut c, view(".proved\n"));
    return ();
}
// An indirect call in user code: `text` is the instruction (`call *%rax`, an import thunk). Nothing
// names what it reaches, so it is an unknown edge.
fn call_slot_out<a, b>(c: (&a mut C), text: &b [u8]) -> unit {
    fx_edge(&mut c, view(""), 0);
    fx_called(&mut c);
    o(&mut c, text);
    return ();
}
// The compiler's own dispatch inside trusted code (a closure's drop through the slot its own body
// installed): every body it can reach is recorded itself, so it is not an unknown.
fn call_dispatch_out<a, b>(c: (&a mut C), text: &b [u8]) -> unit {
    if c.fx_cur != 0 {
        fx_called(&mut c);
    }
    o(&mut c, text);
    return ();
}
// A refined parameter's check in the checked entry: it is the caller's obligation, so it is an entry
// fact of this body rather than an edge of it.
fn call_entry_out<a, b>(c: (&a mut C), text: &b [u8]) -> unit {
    cur := c.fx_cur;
    if cur != 0 {
        c.fx_entry_panic[cur - 1] = 1;
        fx_called(&mut c);
    }
    o(&mut c, text);
    return ();
}
// A `dyn` value's drop: the vtable's first word. The vtable is the compiler's own, built from the
// entries `register_vtable` recorded, so the slot is resolved to the drop helper of every concrete
// type a vtable of this interface holds - a real edge each, not an unknown. It is deliberately an
// over-approximation: which of them the value is cannot be known, so any of them that allocates or
// fails makes the claim false. A `dyn` value that arrived from another object has no vtable in this
// build, and that single case stays an unknown (docs/design/effects.md, "Limits").
fn fx_vtable_drop<a>(c: (&a mut C), iface: u64) -> unit {
    if c.fx_cur == 0 {
        return ();
    }
    mut found = 0;
    for i in c.vtables.len() / 2 {
        if c.vtables[2 * i] == iface {
            found = 1;
            concrete := c.vtables[2 * i + 1];
            if needs_drop(&mut c, concrete) {
                // Naming the helper is what asks the drop walk for it.
                c.drop_refs.push(concrete);
                name := drop_symbol(&mut c, concrete);
                fx_edge(&mut c, view(name), 0);
            }
        }
    }
    if found == 0 {
        fx_edge(&mut c, view(""), 0);
    }
    // One `call *%rax` line is what the site emits, however many helpers the slot may hold.
    fx_called(&mut c);
    return ();
}
// A drop helper's body starts: trusted code, recorded like a function so a caller's claim is followed
// through it to the user `Drop` it calls.
fn fx_helper<a, b>(c: (&a mut C), sym: &b [u8]) -> unit {
    if c.fx_any == 0 {
        return ();
    }
    k := fx_sym(&mut c, view(sym)) - 1;
    c.fx_body[k] = 1;
    c.fx_own_alloc[k] = 0;
    c.fx_own_panic[k] = 0;
    exchange(&mut c.fx_trusted, 1);
    out_len := c.out.len();
    exchange(&mut c.fx_out_start, out_len);
    exchange(&mut c.fx_calls, 0);
    exchange(&mut c.fx_skip_lo, 0);
    exchange(&mut c.fx_skip_hi, 0);
    exchange(&mut c.fx_cur, k + 1);
    return ();
}
// The body ends, and the one thing that is still read from the bytes is checked: the number of `call`
// lines the body emitted has to be the number of calls it recorded. A disagreement means a call site
// exists that does not go through the recording helpers - a compiler bug that would otherwise be a
// silently weaker proof. The replayed prologue of the `.proved` entry is skipped: those are bytes
// already accounted for, copied to the second entry.
fn fx_end<a>(c: (&a mut C)) -> unit {
    cur := c.fx_cur;
    if cur == 0 {
        return ();
    }
    exchange(&mut c.fx_cur, 0);
    from := cur - 1;
    lo := c.fx_skip_lo;
    hi := c.fx_skip_hi;
    mut seen = 0;
    mut i = c.fx_out_start;
    while i < c.out.len() {
        if (lo != 0) && (i >= lo) && (i < hi) {
            i = hi;
            continue;
        }
        if i < c.out.len() {
            mut line_start = i == 0;
            if i != 0 {
                line_start = c.out[i - 1] == 10;
            }
            if line_start && (c.out[i] == 99) {
                mut ok = i + 4 < c.out.len();
                if ok {
                    if (c.out[i + 1] != 97) || (c.out[i + 2] != 108) || (c.out[i + 3] != 108) || (c.out[i + 4] != 32) {
                        ok = false;
                    }
                }
                if ok {
                    seen = seen + 1;
                    while (i < c.out.len()) && (c.out[i] != 10) {
                        i = i + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    if seen != c.fx_calls {
        mut msg = copy_bytes(view("internal: the body of `"));
        if c.fx_fn_name[from].len() != 0 {
            push_bytes(&mut msg, view(c.fx_fn_name[from]));
        } else {
            push_bytes(&mut msg, view(c.fx_syms[from]));
        }
        push_bytes(&mut msg, view("` emitted "));
        decimal(&mut msg, seen);
        push_bytes(&mut msg, view(" call instructions but the effect checker recorded "));
        decimal(&mut msg, c.fx_calls);
        push_bytes(&mut msg, view(": a call site is not going through call_out, call_slot_out, call_dispatch_out or call_entry_out"));
        fail(&mut c, view(msg));
    }
    return ();
}
// The record a callee symbol names: a body emitted for it, or a declaration read for it.
fn fx_lookup<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    if name.len() == 0 {
        return 0;
    }
    for i in c.fx_syms.len() {
        if same(view(c.fx_syms[i]), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
// The fact of a callee: proved by its own body in this build, or claimed by an attribute that its own
// module verified. Anything else is unknown, and unknown means it has to be assumed to allocate and to
// fail.
fn fx_callee_alloc<a>(c: (&a C), k: u64) -> u64 {
    kk := k - 1;
    if c.fx_body[kk] != 0 {
        return c.fx_alloc[kk];
    }
    if c.fx_attr_alloc[kk] != 0 {
        return 0;
    }
    return 1;
}
fn fx_callee_panic<a>(c: (&a C), k: u64) -> u64 {
    kk := k - 1;
    if c.fx_body[kk] != 0 {
        return c.fx_panic[kk];
    }
    if c.fx_attr_panic[kk] != 0 {
        return 0;
    }
    return 1;
}
// The symbol a declared function is emitted (and called) under.
fn fx_func_symbol<a>(c: (&a mut C), i: u64) -> u8[] {
    mut out = u8[];
    plat := c.plat;
    m := c.funcs[i].module.copy();
    n := c.funcs[i].name.copy();
    ext := c.funcs[i].ext;
    symbol := c.funcs[i].symbol.copy();
    if ext == 2 {
        // A C callback is called through the C name it was given, under the platform prefix.
        if plat == 1 {
            out.push(95);
        }
        push_bytes(&mut out, view(symbol));
        return out;
    }
    mangle_into(&mut out, plat, view(m), view(n));
    return out;
}
// The declarations' attributes, then the edges, then the fixpoint over them. A function's own
// allocation and failure (the runtime's roots) are its starting facts; a call passes its callee's
// facts on, so a chain of plain functions is followed to the `rt_alloc` (or the `rt_abort`) at the end
// of it. A symbol nothing defines or emits is unknown - an extern, a stub - unless the body that calls
// it is trusted code, whose unresolved names are the assembly stubs of the system-call gate.
fn fx_solve<a>(c: (&a mut C)) -> unit {
    if c.fx_any == 0 {
        return ();
    }
    for i in c.funcs.len() {
        na := c.funcs[i].no_alloc;
        np := c.funcs[i].no_panic;
        if (na != 0) || (np != 0) {
            sym := fx_func_symbol(&mut c, i);
            if sym.len() != 0 {
                k := fx_sym(&mut c, view(sym)) - 1;
                if k < c.fx_attr_alloc.len() {
                    if na != 0 {
                        c.fx_attr_alloc[k] = 1;
                    }
                    if np != 0 {
                        c.fx_attr_panic[k] = 1;
                    }
                }
            }
        }
    }
    for i in c.fx_syms.len() {
        c.fx_alloc[i] = c.fx_own_alloc[i];
        c.fx_panic[i] = c.fx_own_panic[i];
    }
    for e in c.fx_edge_name.len() {
        name := c.fx_edge_name[e].copy();
        k := fx_lookup(&mut c, view(name));
        c.fx_edge_to[e] = k;
        if k == 0 {
            mut unknown = 1;
            if name.len() != 0 {
                if (c.fx_edge_kind[e] & 4) != 0 {
                    unknown = 0;
                }
            }
            if unknown != 0 {
                kind := c.fx_edge_kind[e];
                c.fx_edge_kind[e] = kind | 1;
            }
        }
    }
    mut changed = 1;
    mut rounds = 0;
    while (changed != 0) && (rounds <= c.fx_syms.len() + 1) {
        changed = 0;
        rounds = rounds + 1;
        for e in c.fx_edge_from.len() {
            from := c.fx_edge_from[e];
            to := c.fx_edge_to[e];
            kind := c.fx_edge_kind[e];
            mut a = 0;
            mut p = 0;
            if to != 0 {
                a = fx_callee_alloc(&c, to);
                p = fx_callee_panic(&c, to);
                if (c.fx_entry_panic[to - 1] != 0) && ((kind & 8) == 0) {
                    p = 1;
                }
            } else {
                if (kind & 1) != 0 {
                    a = 1;
                    p = 1;
                }
            }
            if (a != 0) && (c.fx_alloc[from] == 0) {
                c.fx_alloc[from] = 1;
                c.fx_alloc_thru[from] = to;
                changed = 1;
            }
            if (p != 0) && (c.fx_panic[from] == 0) {
                c.fx_panic[from] = 1;
                c.fx_panic_thru[from] = to;
                changed = 1;
            }
        }
    }
    return ();
}
// The chain a fact travelled, for a diagnostic: `f -> g -> ...`. At most 8 links, so a cycle in the
// call graph still terminates.
fn fx_chain<a>(c: (&a mut C), first: u64, spending: u64) -> u8[] {
    mut out = u8[];
    mut k = first + 1;
    mut n = 0;
    while (k != 0) && (n < spending) {
        idx := k - 1;
        if n != 0 {
            push_bytes(&mut out, view(" -> "));
        }
        // The source name where a body was recorded, else the symbol (a declaration only).
        if c.fx_fn_name[idx].len() != 0 {
            push_bytes(&mut out, view(c.fx_fn_name[idx]));
        } else {
            push_bytes(&mut out, view(c.fx_syms[idx]));
        }
        n = n + 1;
        k = c.fx_alloc_thru[idx];
    }
    return out;
}
fn fx_chain_panic<a>(c: (&a mut C), first: u64, spending: u64) -> u8[] {
    mut out = u8[];
    mut k = first + 1;
    mut n = 0;
    while (k != 0) && (n < spending) {
        idx := k - 1;
        if n != 0 {
            push_bytes(&mut out, view(" -> "));
        }
        // The source name where a body was recorded, else the symbol (a declaration only).
        if c.fx_fn_name[idx].len() != 0 {
            push_bytes(&mut out, view(c.fx_fn_name[idx]));
        } else {
            push_bytes(&mut out, view(c.fx_syms[idx]));
        }
        n = n + 1;
        k = c.fx_panic_thru[idx];
    }
    return out;
}
// One diagnostic, at the position of the offending site (which may be in another file than the one
// the compile stopped in).
fn fx_fail<a>(c: (&a mut C), file: u64, pos: u64, msg: u8[]) -> unit {
    load_file(&mut c, file);
    exchange(&mut c.file, file);
    exchange(&mut c.pos, pos);
    fail(&mut c, view(msg));
    return ();
}
// The edge of `from` that names `to`: the call site a diagnostic points at.
fn fx_edge_file_of<a>(c: (&a mut C), from: u64, to: u64) -> u64 {
    for e in c.fx_edge_from.len() {
        if c.fx_edge_from[e] == from {
            if c.fx_edge_to[e] == to {
                return c.fx_edge_file[e];
            }
        }
    }
    return c.fx_fn_file[from];
}
fn fx_edge_pos_of<a>(c: (&a mut C), from: u64, to: u64) -> u64 {
    for e in c.fx_edge_from.len() {
        if c.fx_edge_from[e] == from {
            if c.fx_edge_to[e] == to {
                return c.fx_edge_pos[e];
            }
        }
    }
    return c.fx_fn_pos[from];
}
// The site of the indirect call a fact travelled through, when it has no chain to show.
fn fx_unknown_file_of<a>(c: (&a mut C), from: u64) -> u64 {
    for e in c.fx_edge_from.len() {
        if c.fx_edge_from[e] == from {
            if (c.fx_edge_kind[e] & 1) != 0 {
                return c.fx_edge_file[e];
            }
        }
    }
    return c.fx_fn_file[from];
}
fn fx_unknown_pos_of<a>(c: (&a mut C), from: u64) -> u64 {
    for e in c.fx_edge_from.len() {
        if c.fx_edge_from[e] == from {
            if (c.fx_edge_kind[e] & 1) != 0 {
                return c.fx_edge_pos[e];
            }
        }
    }
    return c.fx_fn_pos[from];
}
// Every claim is checked here, after the whole program - the drop helpers, the vtables' drop slots and
// the specialisations - has been emitted and settled. A claim on a generic is checked per emitted
// instance, so the refusal names the instance whose body reaches the root.
fn fx_report<a>(c: (&a mut C)) -> unit {
    if c.fx_any == 0 {
        return ();
    }
    for k in c.fx_syms.len() {
        if k >= c.fx_attr_alloc.len() {
            continue;
        }
        if (c.fx_body[k] == 0) || (c.fx_attr_alloc[k] == 0) {
            continue;
        }
        if c.fx_alloc[k] == 0 {
            continue;
        }
        name := c.fx_fn_name[k].copy();
        mut msg = copy_bytes(view("`@no_alloc` function `"));
        push_bytes(&mut msg, view(name));
        thru := c.fx_alloc_thru[k];
        mut at_file = c.fx_fn_file[k];
        mut at_pos = c.fx_fn_pos[k];
        if thru != 0 {
            push_bytes(&mut msg, view("` performs a heap allocation: it calls "));
            chain := fx_chain(&mut c, k, 8);
            push_bytes(&mut msg, view(chain));
            push_bytes(&mut msg, view("\n = the call chain above reaches something that allocates"));
            at_file = fx_edge_file_of(&mut c, k, thru);
            at_pos = fx_edge_pos_of(&mut c, k, thru);
        } else {
            if c.fx_own_alloc[k] != 0 {
                push_bytes(&mut msg, view("` performs a heap allocation"));
                push_bytes(&mut msg, view("\n = move the allocation out of the function, or keep the attribute off it"));
            } else {
                push_bytes(&mut msg, view("` performs a heap allocation: it makes an indirect call the compiler cannot follow"));
                push_bytes(&mut msg, view("\n = a call through a function value or a vtable may allocate; name the callee, or keep the attribute off"));
                at_file = fx_unknown_file_of(&mut c, k);
                at_pos = fx_unknown_pos_of(&mut c, k);
            }
        }
        fx_fail(&mut c, at_file, at_pos, msg);
    }
    for k in c.fx_syms.len() {
        if k >= c.fx_attr_panic.len() {
            continue;
        }
        if (c.fx_body[k] == 0) || (c.fx_attr_panic[k] == 0) {
            continue;
        }
        if c.fx_panic[k] == 0 {
            continue;
        }
        name := c.fx_fn_name[k].copy();
        mut msg = copy_bytes(view("`@no_panic` function `"));
        push_bytes(&mut msg, view(name));
        thru := c.fx_panic_thru[k];
        mut at_file = c.fx_fn_file[k];
        mut at_pos = c.fx_fn_pos[k];
        if thru != 0 {
            push_bytes(&mut msg, view("` can fail: it calls "));
            chain := fx_chain_panic(&mut c, k, 8);
            push_bytes(&mut msg, view(chain));
            push_bytes(&mut msg, view("\n = a callee leaves a runtime check, so the whole chain has to be check-free"));
            at_file = fx_edge_file_of(&mut c, k, thru);
            at_pos = fx_edge_pos_of(&mut c, k, thru);
        } else {
            if c.fx_own_panic[k] != 0 {
                push_bytes(&mut msg, view("` can fail"));
                push_bytes(&mut msg, view("\n = prove the check away, or keep the attribute off the function"));
            } else {
                push_bytes(&mut msg, view("` can fail: it makes an indirect call the compiler cannot follow"));
                push_bytes(&mut msg, view("\n = a call through a function value or a vtable may fail; name the callee, or keep the attribute off"));
                at_file = fx_unknown_file_of(&mut c, k);
                at_pos = fx_unknown_pos_of(&mut c, k);
            }
        }
        fx_fail(&mut c, at_file, at_pos, msg);
    }
    return ();
}
// `@bounded(N)`: the whole form is consumed, and the count lands in `c.fx_bounded`. 1 when the tokens
// were this attribute, 0 when they are something else.
fn fx_bounded_form<a>(c: (&a mut C)) -> u64 {
    next := c.pos + 1;
    if kind_at(&mut c, next) != 1 {
        return 0;
    }
    word := tok_text(&mut c, next);
    if !same(view(word), view("bounded")) {
        return 0;
    }
    advance(&mut c);
    advance(&mut c);
    if !eat(&mut c, view("(")) {
        fail(&mut c, view("`@bounded` takes an iteration count: `@bounded(16) while ...`"));
    }
    text := tok_text(&mut c, c.pos);
    if !pv_digits(view(text)) {
        fail(&mut c, view("`@bounded` takes a decimal iteration count"));
    }
    n := literal_value(&mut c, view(text));
    advance(&mut c);
    if !eat(&mut c, view(")")) {
        fail(&mut c, view("`@bounded` takes exactly one iteration count: `@bounded(16)`"));
    }
    exchange(&mut c.fx_bounded, n);
    return 1;
}
// The payload of `@bounded(N)`, 0 when no attribute is in force. `fx_pending_bound` says one is.
fn fx_bound<a>(c: (&a mut C)) -> u64 {
    return c.fx_bounded;
}
// The index of the `}` matching the `{` at `open`, or `to` when it never closes.
fn fx_match_brace<a>(c: (&a mut C), open: u64, to: u64) -> u64 {
    mut depth = 0;
    mut q = open;
    while q < to {
        k := kind_at(&mut c, q);
        if k == 0 {
            return to;
        }
        if k == 123 {
            depth = depth + 1;
        }
        if k == 125 {
            depth = depth - 1;
            if depth == 0 {
                return q;
            }
        }
        q = q + 1;
    }
    return to;
}
// The proof of `@bounded(n)` for the loop that starts at `c.pos`: a counter that strictly increases
// toward a constant (or refined) bound and that nothing else in the body assigns, or `for i in a..b`
// with a constant span of at most n. Anything else is refused, naming what is missing.
fn fx_bounded_loop<a>(c: (&a mut C), n: u64) -> unit {
    start := c.pos;
    word := tok_text(&mut c, start);
    if same(view(word), view("loop")) {
        fx_bounded_refuse(
            &mut c,
            n,
            view("this `loop` has no counter: it repeats until a `break` that the compiler cannot count"),
            view("use `while i < K` with an unsigned counter `i` that only the loop increments, or a `for i in 0..K`")
        );
    }
    if same(view(word), view("for")) {
        fx_bounded_for(&mut c, n, start);
        return ();
    }
    if !same(view(word), view("while")) {
        fail(&mut c, view("`@bounded` applies to a `while` or a `for` loop"));
    }
    // The condition's tokens, up to the body's `{`.
    mut q = start + 1;
    mut depth = 0;
    mut cond_hi = 0;
    while q < c.toks.len() {
        k := kind_at(&mut c, q);
        if k == 0 {
            break;
        }
        if k == 40 {
            depth = depth + 1;
        }
        if k == 41 {
            depth = depth - 1;
        }
        if (k == 123) && (depth == 0) {
            cond_hi = q;
            break;
        }
        q = q + 1;
    }
    if cond_hi == 0 {
        fail(&mut c, view("`@bounded` needs a loop with a body"));
    }
    // `while NAME < BOUND` (or `<=`, or the same with the bound on the left).
    mut name = u8[];
    mut rel = 0;
    mut bound = u8[];
    mut bound_at = 0;
    if cond_hi - (start + 1) == 3 {
        left := tok_text(&mut c, start + 1);
        mut op = tok_text(&mut c, start + 2);
        right := tok_text(&mut c, start + 3);
        mut left_is_name = false;
        if kind_at(&mut c, start + 1) == 1 {
            left_is_name = true;
        }
        mut right_is_name = false;
        if kind_at(&mut c, start + 3) == 1 {
            right_is_name = true;
        }
        if same(view(op), view("<")) {
            rel = 0;
        }
        if same(view(op), view("<=")) {
            rel = 1;
        }
        if same(view(op), view(">")) {
            rel = 2;
        }
        if same(view(op), view(">=")) {
            rel = 3;
        }
        if same(view(op), view("!=")) {
            rel = 4;
        }
        if (rel == 0) || (rel == 1) {
            if left_is_name & !right_is_name {
                name = copy_bytes(view(left));
                bound = copy_bytes(view(right));
                bound_at = start + 3;
            }
        }
        if (rel == 2) || (rel == 3) {
            if right_is_name & !left_is_name {
                name = copy_bytes(view(right));
                bound = copy_bytes(view(left));
                bound_at = start + 1;
            }
        }
    }
    if name.len() == 0 {
        fx_bounded_refuse(
            &mut c,
            n,
            view("its condition is not `i < K`, `i <= K` or the same with the bound on the left"),
            view("write the loop as `while i < K` with an unsigned counter `i`")
        );
    }
    // The bound has to be a constant, or a parameter the enclosing function's refinement bounds.
    limit := fx_bound_value(&mut c, view(bound), rel);
    if limit == 0 {
        mut msg = copy_bytes(view("the bound `"));
        push_bytes(&mut msg, view(bound));
        push_bytes(&mut msg, view("` is neither a constant nor bounded by a refinement of this function"));
        mut hint = copy_bytes(view("add `where "));
        push_bytes(&mut hint, view(bound));
        push_bytes(&mut hint, view(" <= "));
        push_bytes(&mut hint, view(decimal_bytes(n)));
        push_bytes(&mut hint, view("` to the parameter, or use a constant bound"));
        exchange(&mut c.pos, bound_at);
        fail(&mut c, view(msg));
        return ();
    }
    if n < limit {
        mut msg = copy_bytes(view("its bound allows "));
        push_bytes(&mut msg, view(decimal_bytes(limit)));
        push_bytes(&mut msg, view(" iterations, more than the "));
        push_bytes(&mut msg, view(decimal_bytes(n)));
        push_bytes(&mut msg, view(" `@bounded` claims"));
        exchange(&mut c.pos, bound_at);
        fail(&mut c, view(msg));
        return ();
    }
    // The body: the counter may only be assigned by its own increment, and that increment has to be a
    // positive constant step.
    body_lo := cond_hi;
    body_hi := fx_match_brace(&mut c, body_lo, c.toks.len());
    mut step = 0;
    mut bad = 0;
    mut q = body_lo + 1;
    while q < body_hi {
        t := tok_text(&mut c, q);
        if same(view(t), view(name)) {
            mut op = u8[];
            if q + 1 < body_hi {
                op = tok_text(&mut c, q + 1);
            }
            if fx_assign_op(view(op)) != 0 {
                mut good = 0;
                if same(view(op), view("+=")) {
                    if q + 2 < body_hi {
                        val := tok_text(&mut c, q + 2);
                        if pv_digits(view(val)) {
                            k := literal_value(&mut c, view(val));
                            if k != 0 {
                                if step == 0 {
                                    step = k;
                                }
                                good = 1;
                            }
                        }
                    }
                }
                if same(view(op), view("=")) {
                    if q + 4 < body_hi {
                        again := tok_text(&mut c, q + 2);
                        plus := tok_text(&mut c, q + 3);
                        val := tok_text(&mut c, q + 4);
                        if same(view(again), view(name)) & same(view(plus), view("+")) {
                            if pv_digits(view(val)) {
                                k := literal_value(&mut c, view(val));
                                if k != 0 {
                                    if step == 0 {
                                        step = k;
                                    }
                                    good = 1;
                                }
                            }
                        }
                    }
                }
                if good == 0 {
                    bad = 1;
                }
            }
        }
        q = q + 1;
    }
    if bad != 0 {
        fx_bounded_refuse(
            &mut c,
            n,
            view("the body assigns the counter somewhere other than its own increment"),
            view("keep the counter's only assignment as `i = i + 1` (or `i += 1`)")
        );
    }
    if step == 0 {
        mut msg = copy_bytes(view("the counter `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view("` is never incremented in the body, so the loop's iteration count is not bounded"));
        exchange(&mut c.pos, start);
        fail(&mut c, view(msg));
    }
    // `i` starts at zero or more and grows by at least `step`, so it reaches a bound of `limit` in at
    // most `limit` iterations (a negative start cannot make that worse for an unsigned counter).
    if !fx_unsigned_counter(&mut c, view(name)) {
        mut msg = copy_bytes(view("the counter `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view("` is signed: a negative start makes the iteration count unbounded"));
        exchange(&mut c.pos, start);
        fail(&mut c, view(msg));
    }
    return ();
}
// `for i in a..b { }` with constants: `b - a <= n` is the whole proof.
fn fx_bounded_for<a>(c: (&a mut C), n: u64, start: u64) -> unit {
    mut q = start + 1;
    if kind_at(&mut c, q) != 1 {
        fx_bounded_refuse(
            &mut c,
            n,
            view("this `for` does not name a counter"),
            view("use `for i in 0..K` with a constant K at most the claimed bound")
        );
    }
    name := tok_text(&mut c, start + 1);
    ink := tok_text(&mut c, start + 2);
    if !same(view(ink), view("in")) {
        fx_bounded_refuse(
            &mut c,
            n,
            view("this `for` does not iterate over a range"),
            view("use `for i in 0..K` with a constant K at most the claimed bound")
        );
    }
    // The range's two ends, up to the body's `{`.
    mut depth = 0;
    mut hi = 0;
    q = start + 3;
    while q < c.toks.len() {
        k := kind_at(&mut c, q);
        if k == 0 {
            break;
        }
        if k == 40 {
            depth = depth + 1;
        }
        if k == 41 {
            depth = depth - 1;
        }
        if (k == 123) && (depth == 0) {
            hi = q;
            break;
        }
        q = q + 1;
    }
    if hi == 0 {
        fail(&mut c, view("`@bounded` needs a loop with a body"));
    }
    if hi - (start + 3) != 3 {
        fx_bounded_refuse(
            &mut c,
            n,
            view("its range is not spelled with two constants"),
            view("use `for i in 0..K` with a constant K at most the claimed bound")
        );
    }
    lo_text := tok_text(&mut c, start + 3);
    dots := tok_text(&mut c, start + 4);
    hi_text := tok_text(&mut c, start + 5);
    if !same(view(dots), view("..")) || !pv_digits(view(lo_text)) || !pv_digits(view(hi_text)) {
        fx_bounded_refuse(
            &mut c,
            n,
            view("its range is not spelled with two constants"),
            view("use `for i in 0..K` with a constant K at most the claimed bound")
        );
    }
    lo := literal_value(&mut c, view(lo_text));
    up := literal_value(&mut c, view(hi_text));
    mut span = 0;
    if lo < up {
        span = up - lo;
    }
    if n < span {
        mut msg = copy_bytes(view("its range spans "));
        push_bytes(&mut msg, view(decimal_bytes(span)));
        push_bytes(&mut msg, view(" iterations, more than the "));
        push_bytes(&mut msg, view(decimal_bytes(n)));
        push_bytes(&mut msg, view(" `@bounded` claims"));
        exchange(&mut c.pos, start + 5);
        fail(&mut c, view(msg));
    }
    if !fx_unsigned_counter(&mut c, view(name)) {
        mut msg = copy_bytes(view("the counter `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view("` is signed: a negative start makes the iteration count unbounded"));
        exchange(&mut c.pos, start);
        fail(&mut c, view(msg));
    }
    return ();
}
// The iterations a `while` condition allows: `i < K` and `i <= K` with a constant `K`, or a parameter
// the enclosing function's `where` bounds (`n: u64 where n <= 16`). 0 when neither holds.
fn fx_bound_value<a, b>(c: (&a mut C), bound: &b [u8], rel: u64) -> u64 {
    if pv_digits(view(bound)) {
        mut k = literal_value(&mut c, view(bound));
        if rel == 1 {
            return k + 1;
        }
        return k;
    }
    mut out = 0;
    for i in c.cur_ppreds.len() {
        mut pf = 0;
        mut plo = 0;
        mut phi = 0;
        if i < c.cur_ppreds.len() {
            p := &c.cur_ppreds[i];
            pf = p.file;
            plo = p.lo;
            phi = p.hi;
        }
        if phi == 0 {
            continue;
        }
        mut atoms = Atom[];
        ok := pv_read_pred(&mut c, Pred { file: pf, lo: plo, hi: phi }, &mut atoms);
        if ok {
            for a in atoms.len() {
                item := &atoms[a];
                if same(view(item.a), view(bound)) {
                    if (item.rel == 0) || (item.rel == 1) {
                        if pv_digits(view(item.b)) {
                            mut k = literal_value(&mut c, view(item.b));
                            if item.k <= 0 {
                                sub := u64(0 - item.k);
                                if sub < k {
                                    k = k - sub;
                                } else {
                                    k = 0;
                                }
                            }
                            if item.rel == 1 {
                                k = k + 1;
                            }
                            if (out == 0) || (k < out) {
                                out = k;
                            }
                        }
                    }
                }
            }
        }
    }
    return out;
}
// Whether the loop's counter is unsigned: a signed counter could start below zero and so run for
// longer than its bound allows.
fn fx_unsigned_counter<a, b>(c: (&a mut C), name: &b [u8]) -> bool {
    l := find_local(&mut c, view(name));
    if l == 0 {
        return false;
    }
    ty := local_ty(&mut c, l - 1);
    if ty == 0 {
        return true;
    }
    if ty_kind(&mut c, ty) != 18 {
        return false;
    }
    if ty_mode(&mut c, ty) != 0 {
        return false;
    }
    return true;
}
fn fx_assign_op<a, b>(c: (&a [u8])) -> u64 {
    if same(view(c), view("=")) || same(view(c), view("+=")) || same(view(c), view("-=")) || same(view(c), view("*=")) || same(view(c), view("/=")) || same(view(c), view("%=")) || same(view(c), view("&=")) || same(view(c), view("|=")) || same(view(c), view("^=")) || same(view(c), view("<<=")) || same(view(c), view(">>=")) {
        return 1;
    }
    return 0;
}
// A refused `@bounded`: the loop, what defeats the proof, and the shape that would prove it.
fn fx_bounded_refuse<a, b, d>(c: (&a mut C), n: u64, why: &b [u8], hint: &d [u8]) -> unit {
    mut msg = copy_bytes(view("cannot prove `@bounded("));
    push_bytes(&mut msg, view(decimal_bytes(n)));
    push_bytes(&mut msg, view(")`: "));
    push_bytes(&mut msg, view(why));
    push_bytes(&mut msg, view("\n = "));
    push_bytes(&mut msg, view(hint));
    fail(&mut c, view(msg));
    return ();
}
fn toplevel_item<a>(c: (&a mut C), pass: u64) -> unit {
    if true {
        if kind(&mut c) == 64 {
            // Attributes a declaration carries: `@strict` (refinements), `@no_alloc` and `@no_panic`
            // (effects). They chain, and `@strict;` alone is the module-wide form.
            mut attrs = 0;
            mut strict_decl = 0;
            while kind(&mut c) == 64 {
                mode := ref_strict_form(&mut c);
                if mode == 2 {
                    // `@strict;`: every refinement obligation in this module is an error.
                    return ();
                }
                if mode == 1 {
                    strict_decl = 1;
                    attrs = 1;
                } else {
                    if fx_attr_form(&mut c) != 0 {
                        attrs = 1;
                    } else {
                        ct_form(&mut c, pass, 1);
                        return ();
                    }
                }
            }
            if attrs == 0 {
                ct_form(&mut c, pass, 1);
                return ();
            }
            if strict_decl != 0 {
                exchange(&mut c.strict_next, 1);
            }
        }
        if (kind(&mut c) == 1) & (next_kind(&mut c) == 261) {
            module_binding(&mut c, pass);
            return ();
        }
        public := u64(eat(&mut c, view("pub")));
        // Every item takes `pub`; without it the item is private to this module.
        exchange(&mut c.decl_public, public);
        // `unsafe fn` and `unsafe struct C<T>: transferable, shareable`: the hatch for one item. The
        // declaration that owns it consumes the flag; anything else that leaves it set is refused.
        item_unsafe := u64(eat(&mut c, view("unsafe")));
        saved_unsafe := exchange(&mut c.pending_unsafe, item_unsafe);
        declaration_item(&mut c, pass, public);
        if c.pending_unsafe != 0 {
            fail(&mut c, view("`unsafe` applies to a function or to a struct's capability classification"));
        }
        exchange(&mut c.pending_unsafe, saved_unsafe);
        exchange(&mut c.decl_public, 1);
        if c.fx_pending_alloc != 0 {
            fail(&mut c, view("`@no_alloc` applies to a function"));
        }
        if c.fx_pending_panic != 0 {
            fail(&mut c, view("`@no_panic` applies to a function"));
        }
        exchange(&mut c.strict_next, 0);
        return ();
    }
    return ();
}
// A declaration after its optional `pub`.
fn declaration_item<a>(c: (&a mut C), pass: u64, public: u64) -> unit {
    if true {
        if is(&mut c, view("extern")) {
            extern_declaration(&mut c, pass, public);
            return ();
        }
        if is(&mut c, view("handle")) {
            handle_declaration(&mut c, pass);
            return ();
        }
        if is(&mut c, view("type")) {
            alias_declaration(&mut c, pass);
        } else {
            if is(&mut c, view("const")) {
                constant_declaration(&mut c, pass);
            } else {
                if is(&mut c, view("interface")) {
                    interface_declaration(&mut c, pass);
                } else {
                    if is(&mut c, view("impl")) {
                        implementation(&mut c, pass);
                    } else {
                        if is(&mut c, view("struct")) || is(&mut c, view("enum")) {
                            decl(&mut c, pass);
                        } else {
                            func(&mut c, pass, public);
                        }
                    }
                }
            }
        }
    }
    return ();
}

// ---- expressions: eight-byte stack slots; left-to-right operands ----
fn deref<a>(c: (&a mut C), v: Val) -> Val {
    mut t = v.t;
    mut ty = v.ty;
    while ty_kind(&mut c, ty) == 7 {
        old := t;
        target := target_of(&mut c, old);
        ty = ty_arg(&mut c, ty);
        if ty_kind(&mut c, ty) == 35 {
            // A `&dyn I` value is the handle to its pair, so dereferencing it is the identity: the
            // same word is the pair dispatch reads.
            get(&mut c, old, view("%rax"));
            t = save(&mut c);
        } else {
            t = ref_load(&mut c, old, ty);
        }
        if c.raw == 0 {
            if target == 0 {
                fail(&mut c, view("reference target is not tracked"));
            }
            c
                .resources
                .push(
                    Resource {
                        slot: t,
                        ty: ty,
                        flag: 0,
                        base: old + 1,
                        field: 0,
                        via: 1,
                        place: target,
                        target: 0,
                        authority: old + 1,
                    }
                );
            owner := place_of(&mut c, old);
            n := c.bonds.len();
            for i in n {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if holder == owner && guard != 0 {
                    bond_kind(&mut c, target, loan, guard);
                }
            }
            stored_source(&mut c, t, ty);
        }
        // A `&dyn I` is where implicit dereferencing stops: the method call dispatches through the
        // pair it names rather than through the reference again.
        if borrowed_object(&mut c, ty) != 0 {
            break;
        }
    }
    return val(t, ty);
}
fn find_local<a, b>(c: (&a mut C), n: &b [u8]) -> u64 {
    mut i = c.locals.len();
    while 0 < i {
        i = i - 1;
        mut l = &c.locals[i];
        if same(view(l.name), view(n)) {
            return i + 1;
        }
    }
    return 0;
}
fn local_id<a>(c: (&a mut C), i: u64) -> u64 {
    mut l = &c.locals[i];
    return l.id;
}
fn local_ty<a>(c: (&a mut C), i: u64) -> u64 {
    mut l = &c.locals[i];
    return l.ty;
}
fn pop_locals<a>(c: (&a mut C), mark: u64) -> unit {
    while mark < c.locals.len() {
        c.locals.pop();
    }
    return ();
}
// Loads, addresses and stores record fields.
fn rec_load<a>(c: (&a mut C), base: u64, k: u64, address: u64) -> u64 {
    get(&mut c, base, view("%rax"));
    if address != 0 {
        o(&mut c, view("leaq "));
    } else {
        o(&mut c, view("movq "));
    }
    on(&mut c, k * 8);
    o(&mut c, view("(%rax),%rax\n"));
    return save(&mut c);
}
fn rec_store<a>(c: (&a mut C), base: u64, k: u64, value: u64) -> unit {
    get(&mut c, base, view("%rcx"));
    get(&mut c, value, view("%rax"));
    o(&mut c, view("movq %rax,"));
    on(&mut c, k * 8);
    o(&mut c, view("(%rcx)\n"));
    return ();
}
// C-layout field access: exact byte offset, exact field width. Fields narrower than
// eight bytes use portable byte-wise helpers so every target stays correct without
// new instruction selection.
// The runtime copy parameters of a C array field's element: (size, signed, kind, record words),
// kind 0 an integer or word, 1 an f32, 2 an extern record.
fn carray_elem<a>(c: (&a mut C), arr: u64) -> u64[] {
    elem := ty_arg(&mut c, arr);
    return carray_elem_of(&mut c, elem);
}
fn carray_elem_of<a>(c: (&a mut C), elem: u64) -> u64[] {
    size := ffi_field_size(&mut c, elem);
    mut signed = 0;
    mut kind = 0;
    mut words = 0;
    if ty_kind(&mut c, elem) == 18 {
        signed = ty_mode(&mut c, elem);
    }
    if is_f32(&mut c, elem) {
        kind = 1;
    }
    if (ty_kind(&mut c, elem) == 18) & (ty_arg(&mut c, elem) == 8) & (signed == 0) {
        kind = 3;
    }
    if narrow_code(&mut c, elem) != 0 {
        // f32/u32/i32 vectors hold 32-bit units laid out as C lays out the array.
        kind = 4;
    }
    if is_c_record(&mut c, elem) != 0 {
        kind = 2;
        rd := ty_arg(&mut c, elem);
        words = ffi_record_words(&mut c, rd);
    }
    return u64[size, signed, kind, words];
}
fn cfield_load<a>(c: (&a mut C), base: u64, d: u64, k: u64, address: u64) -> u64 {
    ty := field_ty(&mut c, d, k);
    off := ffi_offset(&mut c, d, k);
    size := ffi_field_size(&mut c, ty);
    more := exchange(&mut c.cfield_more, 0);
    if ty_kind(&mut c, ty) == 32 {
        // Read whole into a fresh vector, which a chained `.len()`, `[i]` or `.text()` then uses;
        // there is no reference into the inline array (`&r.f`, `&mut r.f`), as that would let code
        // reach past its N elements.
        if address != 0 {
            fail(&mut c, view("a C array field has no reference: read it whole as a vector, or assign it whole"));
        }
        e := carray_elem(&mut c, ty);
        get(&mut c, base, view("%rax"));
        o(&mut c, view("addq $"));
        on(&mut c, off);
        o(&mut c, view(",%rax\n"));
        at := save(&mut c);
        mut args = u64[at];
        count := ty_mode(&mut c, ty);
        args.push(imm(&mut c, count));
        for j in 4 {
            args.push(imm(&mut c, e[j]));
        }
        return invoke(&mut c, view("rt_carray_load"), args);
    }
    if is_c_record(&mut c, ty) != 0 {
        // The embedded record's bytes start at base+off: a further projection (o.inner.x) and an
        // assignment place (o.inner = r) use that interior address; a value read copies them
        // into a fresh record, since C structs are plain data.
        get(&mut c, base, view("%rax"));
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        if address != 0 {
            c.caddr.push(at);
            c.caddr.push(ty);
            return at;
        }
        if more != 0 {
            return at;
        }
        return c_record_copy(&mut c, at, ty);
    }
    get(&mut c, base, view("%rax"));
    if address != 0 {
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        if size != 8 || is_f32(&mut c, ty) {
            c.caddr.push(at);
            c.caddr.push(ty);
        }
        return at;
    }
    if size == 8 {
        o(&mut c, view("movq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        return save(&mut c);
    }
    o(&mut c, view("addq $"));
    on(&mut c, off);
    o(&mut c, view(",%rax\n"));
    addr := save(&mut c);
    mut signed = 0;
    if ty_kind(&mut c, ty) == 18 {
        signed = ty_mode(&mut c, ty);
    }
    w := imm(&mut c, size);
    sign := imm(&mut c, signed);
    loaded := invoke(&mut c, view("rt_load_sized"), three(addr, w, sign));
    if is_f32(&mut c, ty) {
        // binary32 bits in memory; Grail holds f32 values as binary64 words.
        get(&mut c, loaded, view("%rax"));
        ffi_f32_widen(&mut c);
        return save(&mut c);
    }
    return loaded;
}
fn ffi_f32_widen<a>(c: (&a mut C)) -> unit {
    if (c.target == 0) || (c.target == 3) {
        o(&mut c, view("movd %eax,%xmm0\ncvtss2sd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
    } else {
        o(&mut c, view("cf32widen\n"));
    }
    return ();
}
fn cfield_store<a>(c: (&a mut C), base: u64, d: u64, k: u64, value: u64) -> unit {
    ty := field_ty(&mut c, d, k);
    off := ffi_offset(&mut c, d, k);
    size := ffi_field_size(&mut c, ty);
    if ty_kind(&mut c, ty) == 32 {
        // A whole vector into the inline array: its length must be the array's (checked at run time).
        e := carray_elem(&mut c, ty);
        get(&mut c, base, view("%rax"));
        o(&mut c, view("addq $"));
        on(&mut c, off);
        o(&mut c, view(",%rax\n"));
        at := save(&mut c);
        mut args = u64[at, value];
        count := ty_mode(&mut c, ty);
        args.push(imm(&mut c, count));
        args.push(imm(&mut c, e[0]));
        args.push(imm(&mut c, e[2]));
        invoke(&mut c, view("rt_carray_store"), args);
        // The vector was handed over (callers move it in) and its elements are now in the array.
        vty := carray_surface(&mut c, ty);
        get(&mut c, value, view("%rdi"));
        drop_call(&mut c, vty);
        return ();
    }
    if is_c_record(&mut c, ty) != 0 {
        get(&mut c, base, view("%rax"));
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        caddr_store(&mut c, at, ty, value);
        return ();
    }
    if size == 8 {
        get(&mut c, base, view("%rcx"));
        get(&mut c, value, view("%rax"));
        o(&mut c, view("movq %rax,"));
        on(&mut c, off);
        o(&mut c, view("(%rcx)\n"));
        return ();
    }
    mut stored = value;
    if is_f32(&mut c, ty) {
        get(&mut c, value, view("%rax"));
        if (c.target == 0) || (c.target == 3) {
            o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\nmovd %xmm0,%eax\n"));
        } else {
            o(&mut c, view("cf32bits\n"));
        }
        stored = save(&mut c);
    }
    get(&mut c, base, view("%rax"));
    o(&mut c, view("addq $"));
    on(&mut c, off);
    o(&mut c, view(",%rax\n"));
    addr := save(&mut c);
    w := imm(&mut c, size);
    invoke(&mut c, view("rt_store_sized"), three(addr, stored, w));
    return ();
}
// A fresh record holding a copy of the C record bytes at `src`.
fn c_record_copy<a>(c: (&a mut C), src: u64, ty: u64) -> u64 {
    d := ty_arg(&mut c, ty);
    words := ffi_record_words(&mut c, d);
    n := imm(&mut c, words);
    fresh := invoke(&mut c, view("rt_rec"), one(n));
    size := ffi_record_size(&mut c, d);
    bytes := imm(&mut c, size);
    invoke(&mut c, view("rt_copy_bytes"), three(fresh, src, bytes));
    return fresh;
}
// The C field type behind an address slot made by cfield_load, or 0 for an ordinary word.
fn caddr_ty<a>(c: (&a mut C), slot: u64) -> u64 {
    mut i = c.caddr.len();
    while 1 < i {
        i = i - 2;
        if c.caddr[i] == slot {
            return c.caddr[i + 1];
        }
    }
    return 0;
}
// 1 when `slot` is the place of an embedded record: an interior address, not a slot holding a
// pointer to one. Storage written through such a place is bytes, so the old value is overwritten
// rather than dropped, and the write copies bytes instead of storing a pointer.
fn embedded_place<a>(c: (&a mut C), slot: u64) -> bool {
    mut i = c.embedded.len();
    while 1 < i {
        i = i - 2;
        if c.embedded[i] == slot {
            return true;
        }
    }
    return false;
}
// Loads a narrow C field through its address slot as a Grail word (sign- or zero-extended,
// f32 widened to the binary64 word Grail holds).
fn caddr_load<a>(c: (&a mut C), slot: u64, ty: u64) -> u64 {
    mut signed = 0;
    if ty_kind(&mut c, ty) == 18 {
        signed = ty_mode(&mut c, ty);
    }
    size := ffi_field_size(&mut c, ty);
    w := imm(&mut c, size);
    sign := imm(&mut c, signed);
    loaded := invoke(&mut c, view("rt_load_sized"), three(slot, w, sign));
    if is_f32(&mut c, ty) {
        get(&mut c, loaded, view("%rax"));
        ffi_f32_widen(&mut c);
        return save(&mut c);
    }
    return loaded;
}
// Stores a Grail word into a narrow C field through its address slot.
fn caddr_store<a>(c: (&a mut C), slot: u64, ty: u64, value: u64) -> unit {
    if is_c_record(&mut c, ty) != 0 {
        // The moved-in record's bytes replace the embedded ones; its own buffer is released.
        d := ty_arg(&mut c, ty);
        size := ffi_record_size(&mut c, d);
        bytes := imm(&mut c, size);
        invoke(&mut c, view("rt_copy_bytes"), three(slot, value, bytes));
        invoke(&mut c, view("rt_free"), one(value));
        return ();
    }
    mut stored = value;
    if is_f32(&mut c, ty) {
        get(&mut c, value, view("%rax"));
        if (c.target == 0) || (c.target == 3) {
            o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\nmovd %xmm0,%eax\n"));
        } else {
            o(&mut c, view("cf32bits\n"));
        }
        stored = save(&mut c);
    }
    size := ffi_field_size(&mut c, ty);
    w := imm(&mut c, size);
    invoke(&mut c, view("rt_store_sized"), three(slot, stored, w));
    return ();
}
// Narrow vectors (`f32[]`, `u32[]`, `i32[]`) store 4-byte elements: 1 for f32, 2 for u32, 3 for
// i32, 0 for any other element type.
fn narrow_code<a>(c: (&a mut C), alias: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    // A specialization's type parameter is an alias of the concrete type.
    elem := base_type(&mut c, alias);
    if is_f32(&mut c, elem) {
        return 1;
    }
    if (elem != 0) & (ty_kind(&mut c, elem) == 18) {
        if ty_arg(&mut c, elem) == 32 {
            return 2 + (ty_mode(&mut c, elem) & 1);
        }
    }
    return 0;
}
fn narrow_vector<a>(c: (&a mut C), ty: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    vty := base_type(&mut c, ty);
    if ty_kind(&mut c, vty) != 6 {
        return 0;
    }
    elem := ty_arg(&mut c, vty);
    return narrow_code(&mut c, elem);
}
// A value as the 32-bit unit a narrow vector stores: an f32's binary32 bits; an integer as is (the
// store keeps its low 32 bits).
fn narrow_encode<a>(c: (&a mut C), code: u64, value: u64) -> u64 {
    if code != 1 {
        return value;
    }
    get(&mut c, value, view("%rax"));
    if (c.target == 0) || (c.target == 3) {
        o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\nmovd %xmm0,%eax\n"));
    } else {
        o(&mut c, view("cf32bits\n"));
    }
    return save(&mut c);
}
// A loaded 32-bit unit (zero-extended) as the word Grail holds: f32 widened, i32 sign-extended.
fn narrow_decode<a>(c: (&a mut C), code: u64, unit: u64) -> u64 {
    if code == 2 {
        return unit;
    }
    get(&mut c, unit, view("%rax"));
    if code == 1 {
        ffi_f32_widen(&mut c);
    } else {
        o(&mut c, view("shlq $32,%rax\nsarq $32,%rax\n"));
    }
    return save(&mut c);
}
// How many integer argument words this target's callback prologue can read: the Win64 thunk under
// the C symbol moves four registers plus the fifth and sixth stack words into Grail's registers, and
// x86-64 SysV, AArch64 and RISC-V 64 read their own integer argument registers.
fn callback_int_words(abi: u64) -> u64 {
    if abi == 1 {
        return 6;
    }
    return ffi_int_regs(abi);
}
// Every parameter list a C caller can produce is readable by a callback prologue: the words past
// the argument registers are read from the caller's stack (callback_params), so nothing is refused.
fn ffi_callback_fits<a>(c: (&a mut C), first: u64, count: u64) -> unit {
    return ();
}
// An exported callback's prologue: each parameter is read from where a C caller put it (Win64:
// positionally, the thunk having moved rcx/rdx/r8/r9 and stack words five and six into Grail's
// registers; SysV/AAPCS64/RV64: integer-class parameters packed into the integer registers and
// floats into the vector registers), f32 widened, narrow integers extended, then spilled.
fn callback_params<a>(c: (&a mut C), count: u64) -> unit {
    win := c.target == 3;
    x86 := c.target == 0 || win;
    rv := c.target == 2;
    // Win64 arguments arrive in Grail's registers because the thunk under the C symbol has already
    // moved them; everywhere else the C integer argument registers of the target's own ABI are read
    // directly, so the seventh and eighth words come from %r10/%r11 (x6/x7, a6/a7).
    // Past the registers the caller's stack holds the rest, in order, one 8-byte slot each: after
    // the prologue's 16-byte frame record that is 16(%rbp) on SysV, AAPCS64 and RV64 (x29/s0 is
    // the frame pointer there). On Win64 argument i sits 8+8i above the thunk's entry rsp, which
    // is 208+8i above the body's frame once the thunk's two pushes, 168 bytes, its call and the
    // body's push are accounted for; the thunk itself already moved arguments five and six.
    abi := ffi_abi(&mut c);
    regs := callback_int_words(abi);
    mut ints = 0;
    mut floats = 0;
    mut stack = 0;
    for i in count {
        // The parameter locals are the function's first bindings, in declaration order.
        ty := c.locals[i].ty;
        if is_float(&mut c, ty) {
            single := is_f32(&mut c, ty);
            // 0 vector register, 1 an integer register (RV64 only), 2 the caller's stack.
            mut place = 0;
            mut fpos = floats;
            if win {
                fpos = i;
                if 3 < i {
                    place = 2;
                }
            } else {
                if 7 < floats {
                    if rv & (ints < regs) {
                        place = 1;
                    } else {
                        place = 2;
                    }
                }
            }
            if place == 0 {
                if x86 {
                    if single {
                        o(&mut c, view("cvtss2sd %xmm"));
                        on(&mut c, fpos);
                        o(&mut c, view(",%xmm"));
                        on(&mut c, fpos);
                        c.out.push(10);
                    }
                    o(&mut c, view("movq %xmm"));
                    on(&mut c, fpos);
                    o(&mut c, view(",%rax\n"));
                } else {
                    o(&mut c, view("cbfarg "));
                    on(&mut c, fpos);
                    if single {
                        o(&mut c, view(" s"));
                    }
                    c.out.push(10);
                }
                floats = floats + 1;
            } else {
                if place == 1 {
                    // RV64 passes a float that finds no free FP register in the next integer
                    // register, as its bits.
                    o(&mut c, view("movq "));
                    o(&mut c, view(ffi_int_reg(abi, ints)));
                    o(&mut c, view(",%rax\n"));
                    ints = ints + 1;
                } else {
                    if win {
                        if 5 < i {
                            o(&mut c, view("movq "));
                            on(&mut c, 208 + 8 * i);
                            o(&mut c, view("(%rbp),%rax\n"));
                        } else {
                            // Win64 arguments five and six: the thunk moved the raw word.
                            o(&mut c, view("movq "));
                            o(&mut c, view(argreg(i)));
                            o(&mut c, view(",%rax\n"));
                        }
                    } else {
                        o(&mut c, view("movq "));
                        on(&mut c, 16 + 8 * stack);
                        o(&mut c, view("(%rbp),%rax\n"));
                        stack = stack + 1;
                    }
                }
                if single {
                    if x86 {
                        o(&mut c, view("movd %eax,%xmm0\ncvtss2sd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
                    } else {
                        o(&mut c, view("cf32widen\n"));
                    }
                }
            }
        } else {
            if win {
                if 5 < i {
                    o(&mut c, view("movq "));
                    on(&mut c, 208 + 8 * i);
                    o(&mut c, view("(%rbp),%rax\n"));
                } else {
                    o(&mut c, view("movq "));
                    o(&mut c, view(argreg(i)));
                    o(&mut c, view(",%rax\n"));
                }
            } else {
                if ints < regs {
                    o(&mut c, view("movq "));
                    o(&mut c, view(ffi_int_reg(abi, ints)));
                    o(&mut c, view(",%rax\n"));
                    ints = ints + 1;
                } else {
                    o(&mut c, view("movq "));
                    on(&mut c, 16 + 8 * stack);
                    o(&mut c, view("(%rbp),%rax\n"));
                    stack = stack + 1;
                }
            }
            suffix := ffi_narrow(&mut c, ty);
            if suffix.len() != 0 {
                if x86 {
                    ffi_x86_extend(&mut c, view(suffix));
                } else {
                    o(&mut c, view("cext "));
                    o(&mut c, view(suffix));
                    c.out.push(10);
                }
            }
        }
        o(&mut c, view("movq %rax,"));
        stack_slot(&mut c, i);
        c.out.push(10);
    }
    return ();
}
// ---- `byval` record arguments (decision B7, docs/ffi.md) ----
// One scalar leaf of an extern record. An embedded record is flattened, so a leaf's offset is
// measured from the outermost record's start.
struct FFILeaf {
    off: u64,
    size: u64,
    // 0 integer (handles, CStr and cfn words included), 1 f32, 2 f64.
    cls: u64
}
// One destination for a slice of a byval argument: dst 1 an integer argument register, 2 a float
// argument register, 3 an outgoing stack word, 4 the address of the argument's copy in an integer
// register, 5 the address of the copy in an outgoing stack word.
struct FFIMove {
    off: u64,
    size: u64,
    dst: u64,
    index: u64
}
// A whole byval argument: the moves that place its bytes, the call's argument counters after it,
// and the copy a by-reference argument needs.
struct FFIPlan {
    byval: u64,
    moves: FFIMove[],
    ints: u64,
    floats: u64,
    stack: u64,
    copies: u64,
    copy_rel: u64,
    copy_bytes: u64
}
fn ffi_empty_plan() -> FFIPlan {
    mut moves = FFIMove[];
    return FFIPlan {
        byval: 0,
        moves: moves,
        ints: 0,
        floats: 0,
        stack: 0,
        copies: 0,
        copy_rel: 0,
        copy_bytes: 0
    };
}
fn ffi_move(off: u64, size: u64, dst: u64, index: u64) -> FFIMove {
    return FFIMove { off: off, size: size, dst: dst, index: index };
}
// The scalar leaves of an extern record, embedded records flattened, in field order.
fn ffi_leaves<a>(c: (&a mut C), d: u64, base: u64) -> FFILeaf[] {
    mut out = FFILeaf[];
    count := c.decls[d].count;
    for i in count {
        ty := field_ty(&mut c, d, i);
        off := base + ffi_offset(&mut c, d, i);
        if is_c_record(&mut c, ty) != 0 {
            nested := ty_arg(&mut c, ty);
            inner := ffi_leaves(&mut c, nested, off);
            for j in inner.len() {
                leaf := inner[j];
                out.push(FFILeaf { off: leaf.off, size: leaf.size, cls: leaf.cls });
            }
        } else {
            mut cls = 0;
            if is_float(&mut c, ty) {
                cls = 2;
                if is_f32(&mut c, ty) {
                    cls = 1;
                }
            }
            out.push(FFILeaf { off: off, size: ffi_field_size(&mut c, ty), cls: cls });
        }
    }
    return out;
}
// The placement decision for one byval argument on `abi`. Entry 0 is the mode and, for mode 5, the
// entries after it are the eightbytes' classes (1 SSE, 2 INTEGER). Modes: 0 an empty record (nothing
// crosses), 1 one integer register per eightbyte, 2 the record in consecutive outgoing stack words,
// 3 one register per leaf in field order (integer leaves to integer registers, float leaves to float
// registers), 4 by reference to a copy the caller makes, 5 SysV eightbyte classes.
//
// The rules are the ABI's own and are stated again in docs/ffi.md, which is the contract:
//
// - SysV x86-64: an eightbyte is SSE when it holds only floats and INTEGER otherwise (a mixed
//   eightbyte is INTEGER), and each class draws from its own register file. Over 16 bytes, or when
//   a class has no register left, the whole record goes in the outgoing argument area (MEMORY).
// - AAPCS64: a homogeneous float aggregate of 1-4 fields of one float type travels in v0-v7, one
//   register per field. Any other composite of 16 bytes or less travels in consecutive x0-x7, one
//   register per eightbyte; a larger one is passed by reference to a caller copy. With no register
//   left for the aggregate or the address, it is passed on the stack.
// - RV64: over 2*XLEN (16 bytes) a record is passed by reference. At or below it, one or two fields
//   with at least one float take a register each in field order (float fields in fa0-fa7, integer
//   fields in a0-a7); every other shape is packed into one integer register per eightbyte.
fn ffi_byval_mode<a>(
    c: (&a mut C),
    abi: u64,
    size: u64,
    words: u64,
    leaves: (&a FFILeaf[]),
    ints: u64,
    floats: u64
) -> u64[] {
    mut decision = u64[];
    if size == 0 {
        decision.push(0);
        return decision;
    }
    if abi == 0 {
        if 16 < size {
            decision.push(2);
            return decision;
        }
        eights := ffi_align_up(size, 8) / 8;
        mut klass = u64[];
        for e in eights {
            klass.push(0);
        }
        for i in leaves.len() {
            e := leaves[i].off / 8;
            if leaves[i].cls == 0 {
                exchange(&mut klass[e], 2);
            } else {
                if klass[e] == 0 {
                    exchange(&mut klass[e], 1);
                }
            }
        }
        mut need_int = 0;
        mut need_sse = 0;
        for e in eights {
            if klass[e] == 1 {
                need_sse = need_sse + 1;
            } else {
                need_int = need_int + 1;
            }
        }
        if (6 < ints + need_int) | (8 < floats + need_sse) {
            decision.push(2);
            return decision;
        }
        decision.push(5);
        for e in eights {
            decision.push(klass[e]);
        }
        return decision;
    }
    if abi == 2 {
        mut hfa = 0;
        if (0 < leaves.len()) && (leaves.len() <= 4) && (0 < leaves[0].cls) {
            first := leaves[0].cls;
            hfa = 1;
            for i in leaves.len() {
                if leaves[i].cls != first {
                    hfa = 0;
                }
            }
        }
        if hfa != 0 {
            if floats + leaves.len() <= 8 {
                decision.push(3);
            } else {
                decision.push(2);
            }
            return decision;
        }
        if 16 < size {
            decision.push(4);
            return decision;
        }
        if 8 < ints + words {
            decision.push(2);
        } else {
            decision.push(1);
        }
        return decision;
    }
    if abi == 1 {
        // Win64: a record of 1, 2, 4 or 8 bytes travels as one integer word in its positional slot
        // (rcx/rdx/r8/r9, then the stack) - floats included, Win64 never passes a struct in xmm -
        // and any other size by reference to a caller-made copy whose address takes the slot.
        if (size == 1) || (size == 2) || (size == 4) || (size == 8) {
            if ints < 4 {
                decision.push(1);
            } else {
                decision.push(2);
            }
        } else {
            decision.push(4);
        }
        return decision;
    }
    // RV64 (abi 3).
    if 16 < size {
        decision.push(4);
        return decision;
    }
    mut nfloat = 0;
    for i in leaves.len() {
        if leaves[i].cls != 0 {
            nfloat = nfloat + 1;
        }
    }
    if (nfloat != 0) & (leaves.len() <= 2) {
        nint := leaves.len() - nfloat;
        if (8 < ints + nint) | (8 < floats + nfloat) {
            decision.push(2);
        } else {
            decision.push(3);
        }
        return decision;
    }
    if 8 < ints + words {
        decision.push(2);
    } else {
        decision.push(1);
    }
    return decision;
}
// How one byval argument is passed: the moves that place its bytes and the call's argument counters
// after it. `ints`, `floats` and `stack` are the counters the ordinary argument loop keeps, so the
// allocation of the arguments around a byval record stays in step.
fn ffi_byval_plan<a>(c: (&a mut C), d: u64, abi: u64, ints: u64, floats: u64, stack: u64, copies: u64) -> FFIPlan {
    size := ffi_record_size(&mut c, d);
    words := ffi_align_up(size, 8) / 8;
    leaves := ffi_leaves(&mut c, d, 0);
    decision := ffi_byval_mode(&mut c, abi, size, words, &leaves, ints, floats);
    mode := decision[0];
    mut ints2 = ints;
    mut floats2 = floats;
    mut stack2 = stack;
    mut copies2 = copies;
    mut copy_rel = 0;
    mut copy_bytes = 0;
    mut moves = FFIMove[];
    if mode == 1 {
        for w in words {
            moves.push(ffi_move(w * 8, 8, 1, ints2 + w));
        }
        ints2 = ints2 + words;
    }
    if mode == 2 {
        for w in words {
            moves.push(ffi_move(w * 8, 8, 3, stack2 + w));
        }
        stack2 = stack2 + words;
    }
    if mode == 3 {
        for i in leaves.len() {
            if leaves[i].cls == 0 {
                moves.push(ffi_move((leaves[i].off / 8) * 8, 8, 1, ints2));
                ints2 = ints2 + 1;
            } else {
                moves.push(ffi_move(leaves[i].off, leaves[i].size, 2, floats2));
                floats2 = floats2 + 1;
            }
        }
    }
    if mode == 4 {
        // Each copy starts 16-byte aligned (Win64 requires it; harmless elsewhere): the copy area
        // itself starts on a 16-byte boundary above the stack arguments.
        copy_rel = copies2;
        copy_bytes = ffi_align_up(size, 16);
        copies2 = copies2 + copy_bytes;
        mut regs = 8;
        if abi == 1 {
            regs = 4;
        }
        if ints2 < regs {
            moves.push(ffi_move(0, 0, 4, ints2));
            ints2 = ints2 + 1;
        } else {
            moves.push(ffi_move(0, 0, 5, stack2));
            stack2 = stack2 + 1;
        }
    }
    if mode == 5 {
        for e in decision.len() - 1 {
            mut width = size - e * 8;
            if 8 < width {
                width = 8;
            }
            if decision[e + 1] == 1 {
                moves.push(ffi_move(e * 8, width, 2, floats2));
                floats2 = floats2 + 1;
            } else {
                moves.push(ffi_move(e * 8, 8, 1, ints2));
                ints2 = ints2 + 1;
            }
        }
    }
    return FFIPlan {
        byval: 1,
        moves: moves,
        ints: ints2,
        floats: floats2,
        stack: stack2,
        copies: copies2,
        copy_rel: copy_rel,
        copy_bytes: copy_bytes
    };
}
// Places one byval argument's bytes where the plan says, making the copy a by-reference argument
// needs at `copy_base` bytes above the outgoing stack pointer.
fn ffi_byval_emit<a>(c: (&a mut C), slot: u64, plan: (&FFIPlan), copy_base: u64, x86: u64, abi: u64) -> unit {
    // Win64 stack arguments start above the callee's 32-byte register home area.
    mut home = 0;
    if abi == 1 {
        home = 32;
    }
    if 0 < plan.copy_bytes {
        for w in plan.copy_bytes / 8 {
            get(&mut c, slot, view("%rax"));
            o(&mut c, view("movq "));
            on(&mut c, w * 8);
            o(&mut c, view("(%rax),%rax\n"));
            ffi_store_stack(&mut c, x86, copy_base + w * 8);
        }
    }
    for i in plan.moves.len() {
        m := plan.moves[i];
        if (m.dst == 4) || (m.dst == 5) {
            // Passed by reference: the address of the copy, not the record's bytes.
            o(&mut c, view("leaq "));
            on(&mut c, copy_base + plan.copy_rel);
            o(&mut c, view("(%rsp),%rax\n"));
            if m.dst == 4 {
                o(&mut c, view("movq %rax,"));
                o(&mut c, view(ffi_int_reg(abi, m.index)));
                c.out.push(10);
            } else {
                ffi_store_stack(&mut c, x86, home + m.index * 8);
            }
            continue;
        }
        get(&mut c, slot, view("%rax"));
        // A half-filled SSE eightbyte - a 12-byte record of floats, say - is 4 bytes wide: load it
        // with the matching width, because `movl ...,%rax` is not an instruction.
        mut wide = 1;
        if m.size < 8 {
            o(&mut c, view("movl "));
            wide = 0;
        } else {
            o(&mut c, view("movq "));
        }
        on(&mut c, m.off);
        if wide != 0 {
            o(&mut c, view("(%rax),%rax\n"));
        } else {
            o(&mut c, view("(%rax),%eax\n"));
        }
        if m.dst == 1 {
            o(&mut c, view("movq %rax,"));
            o(&mut c, view(ffi_int_reg(abi, m.index)));
            c.out.push(10);
        }
        if m.dst == 2 {
            ffi_float_arg(&mut c, m.index, m.size == 4, x86);
        }
        if m.dst == 3 {
            ffi_store_stack(&mut c, x86, home + m.index * 8);
        }
    }
    return ();
}
// %rax's word as the bits of float argument register `index`, without conversion: a record's bytes
// are already the field's representation.
fn ffi_float_arg<a>(c: (&a mut C), index: u64, single: bool, x86: u64) -> unit {
    if x86 != 0 {
        if single {
            o(&mut c, view("movd %eax,%xmm"));
        } else {
            o(&mut c, view("movq %rax,%xmm"));
        }
        on(&mut c, index);
        c.out.push(10);
    } else {
        if single {
            o(&mut c, view("cfbits32 "));
        } else {
            o(&mut c, view("cfbits64 "));
        }
        on(&mut c, index);
        c.out.push(10);
    }
    return ();
}
// How a record with float fields is returned on this ABI: 1 SysV (per-eightbyte INTEGER/SSE),
// 2 AAPCS64 homogeneous float aggregate (1-4 fields of one float type), 3 RV64 flattened (one
// or two fields, at least one float), 0 the integer-register/memory rules (Win64 by size, AAPCS64
// non-HFA composites, RV64 records the flattening rule does not cover).
fn ffi_float_plan<a>(c: (&a mut C), d: u64, abi: u64) -> u64 {
    // Classified over the flattened scalar leaves, so a float inside an embedded record counts
    // exactly as one at the top level (the C ABIs all classify the flattened field list).
    leaves := ffi_leaves(&mut c, d, 0);
    count := leaves.len();
    if abi == 0 {
        return 1;
    }
    if abi == 2 {
        if (count == 0) || (4 < count) {
            return 0;
        }
        kind := leaves[0].cls;
        if kind == 0 {
            return 0;
        }
        for i in count {
            if leaves[i].cls != kind {
                return 0;
            }
        }
        return 2;
    }
    if abi == 3 {
        if (count == 0) || (2 < count) {
            return 0;
        }
        mut floats = 0;
        for i in count {
            if leaves[i].cls != 0 {
                floats = floats + 1;
            } else {
                // Only scalar integers pair with a float (handles and CStr are pointer words).
                if 8 < leaves[i].size {
                    return 0;
                }
            }
        }
        if floats == 0 {
            return 0;
        }
        return 3;
    }
    return 0;
}
// Stores a float-classified record result from the return registers into its allocation, leaf by
// leaf of the flattened record (embedded records included).
fn ffi_float_result<a>(c: (&a mut C), slot: u64, d: u64, plan: u64) -> unit {
    leaves := ffi_leaves(&mut c, d, 0);
    count := leaves.len();
    size := ffi_record_size(&mut c, d);
    if plan == 1 {
        // SysV: each eightbyte is SSE when all its leaves are floats, else INTEGER; INTEGER
        // eightbytes come from rax then rdx, SSE ones from xmm0 then xmm1.
        mut eights = (size + 7) / 8;
        mut ints = 0;
        mut sses = 0;
        // Save rax/rdx first: the stores below go through r10/r11 only.
        get(&mut c, slot, view("%r10"));
        for e in eights {
            mut sse = 1;
            for i in count {
                if (leaves[i].off / 8 == e) & (leaves[i].cls == 0) {
                    sse = 0;
                }
            }
            if sse != 0 {
                o(&mut c, view("movq %xmm"));
                on(&mut c, sses);
                o(&mut c, view(",%r11\n"));
                sses = sses + 1;
            } else {
                if ints == 0 {
                    o(&mut c, view("movq %rax,%r11\n"));
                } else {
                    o(&mut c, view("movq %rdx,%r11\n"));
                }
                ints = ints + 1;
            }
            o(&mut c, view("movq %r11,"));
            on(&mut c, e * 8);
            o(&mut c, view("(%r10)\n"));
        }
        return ();
    }
    if plan == 2 {
        get(&mut c, slot, view("%r10"));
        for i in count {
            ffi_float_store(&mut c, i, leaves[i].cls == 1, leaves[i].off);
        }
        return ();
    }
    // RV64 flattened: floats in fa0, fa1 in leaf order; the integer leaf (if any) in a0, which
    // the call lowering leaves in %rax.
    held := save(&mut c);
    get(&mut c, slot, view("%r10"));
    mut fk = 0;
    for i in count {
        if leaves[i].cls != 0 {
            ffi_float_store(&mut c, fk, leaves[i].cls == 1, leaves[i].off);
            fk = fk + 1;
        }
    }
    for i in count {
        if leaves[i].cls == 0 {
            get(&mut c, slot, view("%rax"));
            o(&mut c, view("addq $"));
            on(&mut c, leaves[i].off);
            o(&mut c, view(",%rax\n"));
            addr := save(&mut c);
            w := imm(&mut c, leaves[i].size);
            invoke(&mut c, view("rt_store_sized"), three(addr, held, w));
        }
    }
    return ();
}
fn ffi_float_store<a>(c: (&a mut C), k: u64, single: bool, off: u64) -> unit {
    o(&mut c, view("cfrstore "));
    on(&mut c, k);
    if single {
        o(&mut c, view(" s "));
    } else {
        o(&mut c, view(" d "));
    }
    on(&mut c, off);
    c.out.push(10);
    return ();
}
// Floats anywhere in the record, embedded records included.
fn ffi_record_has_float_deep<a>(c: (&a mut C), d: u64) -> bool {
    count := c.decls[d].count;
    for i in count {
        ty := field_ty(&mut c, d, i);
        if is_float(&mut c, ty) {
            return true;
        }
        if is_c_record(&mut c, ty) != 0 {
            inner := ty_arg(&mut c, ty);
            if ffi_record_has_float_deep(&mut c, inner) {
                return true;
            }
        }
    }
    return false;
}
fn field_path<a>(c: (&a mut C), id: u64, lty: u64, address: u64) -> Val {
    mut t = id;
    mut ty = lty;
    mut via = 0;
    while is(&mut c, view(".")) {
        if after_next_kind(&mut c) == 40 {
            break;
        }
        if next_kind(&mut c) == 46 {
            break;
        }
        advance(&mut c);
        f := member_name(&mut c);
        if ty_kind(&mut c, ty) == 7 {
            via = 1;
        }
        mut base = deref(&mut c, val(t, ty));
        mut b = base.t;
        // A record reached through a bound type parameter (`v.@f` in a generic, unrolled per
        // specialisation) arrives behind an indirection.
        while ty_kind(&mut c, base.ty) == 10 {
            inner := ty_arg(&mut c, base.ty);
            base = val(base.t, inner);
        }
        if ty_kind(&mut c, base.ty) != 8 {
            fail(&mut c, view("field projection requires record"));
        }
        d := ty_arg(&mut c, base.ty);
        decl := &c.decls[d];
        if decl.is_enum != 0 {
            fail(&mut c, view("enum payload requires match or unwrap"));
        }
        k := find_field(&mut c, d, view(f));
        fty := field_type(&mut c, base.ty, k);
        last := (kind(&mut c) != 46) & (address != 0);
        mut n = 0;
        if c.decls[d].c_layout != 0 {
            more := kind(&mut c) == 46;
            exchange(&mut c.cfield_more, more);
            n = cfield_load(&mut c, b, d, k, last);
        } else {
            n = rec_load(&mut c, b, k, last);
        }
        if last {
            ty := reference_type(&mut c, fty, address == 2);
            mut ref = n;
            // Only a C-layout container embeds the record's bytes. A plain record's field is a
            // word holding the record's own address, so `n` (that word's address) already is the
            // reference; a proxy over it would add a level and write into the container's words.
            if (is_c_record(&mut c, fty) != 0) & (c.decls[d].c_layout != 0) {
                // An embedded record has no slot of its own: its bytes are interior to the
                // containing struct, and `n` holds their address. A reference is a pointer to a
                // slot that holds the record's address, so the place is a proxy slot holding the
                // interior address, and the reference points at it. That keeps `ref_load`'s one
                // representation ("load the record's address through the reference") valid on
                // both sides of a call - `&mut o.inner` used to read the first field as an address
                // and fault in the callee.
