// True when this specialisation has already been emitted in this object, whatever entry asked
// first: the name is the identity, and two entries can share one.
fn spec_taken<a>(c: (&a mut C), index: u64) -> u64 {
    name := special_name(&mut c, index);
    if names_find(&mut c.spec_em_slots, &mut c.spec_em_keys, &c.spec_emitted, view(name)) != 0 {
        return 1;
    }
    c.spec_emitted.push(name.copy());
    return 0;
}
// True when this helper has already been defined in this object, whatever index asked first.
fn drop_taken<a>(c: (&a mut C), ty: u64) -> u64 {
    name := drop_symbol(&mut c, ty);
    if names_find(&mut c.drop_em_slots, &mut c.drop_em_keys, &c.drop_emitted, view(name)) != 0 {
        return 1;
    }
    c.drop_emitted.push(name.copy());
    return 0;
}

fn drop_name<a>(c: (&a mut C), ty: u64) -> unit {
    // Named as a dropper, a framed record is always a holder's box (a dyn cell, a task result): freed,
    // after its owners are dropped in place (the boxed helper) when it has any.
    if framed(&mut c, ty) && !frame_drops(&mut c, ty) {
        push_bytes(&mut c.out, view("rt_free"));
        return ();
    }
    if array_owned(&mut c, ty) {
        // Its helper drops in place and frees no box, so it cannot be a box's dropper.
        array_stage_fail(&mut c, view("a value a runtime holder drops (a dyn value, a task's result, a vector's truncation), when its elements own data,"));
    }
    name := drop_ref_name(&mut c, ty);
    push_bytes(&mut c.out, view(name));
    return ();
}
// A drop helper's name, and the request for its body: naming one is what makes the drop walk emit it.
// Every naming goes through here, and a unit records each one (fn_reg_drop): a replayed body names
// its helpers again by calling this, so what the drop walk sees is what a fresh emission shows it.
// The name itself can ask for a generic `Drop` implementation's specialisation (drop_hook_symbol);
// that request is part of naming the helper, made again whenever the helper is named again, so it
// is not recorded separately.
fn drop_ref_name<a>(c: (&a mut C), ty: u64) -> u8[] {
    fn_reg_drop(&mut c, ty);
    c.drop_refs.push(ty);
    rec := exchange(&mut c.fn_rec, 0);
    name := drop_symbol(&mut c, ty);
    exchange(&mut c.fn_rec, rec);
    return name;
}
// A call to a type's drop helper: the `Drop` reached through the compiler's glue is a real edge.
fn drop_call_out<a>(c: (&a mut C), ty: u64) -> unit {
    // A framed record's words belong to a frame or to the place that holds them: nothing to free.
    // An array that owns its elements still drops them, in place (its helper frees no storage).
    if framed(&mut c, ty) && !frame_drops(&mut c, ty) {
        return ();
    }
    // A framed value's words are where it is held, so it is dropped in place.
    if framed(&mut c, ty) {
        call_out(&mut c, view(drop_in_place_ref(&mut c, ty)));
        return ();
    }
    name := drop_ref_name(&mut c, ty);
    call_out(&mut c, view(name));
    return ();
