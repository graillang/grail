    }
    return ();
}
fn call_bonds<a>(
    c: (&a mut C),
    result: Val,
    first: u64,
    args: (&a u64[]),
    capture_type: u64
) -> unit {
    if c.raw != 0 {
        return ();
    }
    captures := type_caps(&mut c, capture_type, 0);
    holder := place_of(&mut c, result.t);
    resultkind := ty_kind(&mut c, result.ty);
    aggregate := resultkind != 5;
    for i in args.len() {
        slot := args[i];
        source := place_of(&mut c, slot);
        ty := c.params[first + i];
        kind := ty_kind(&mut c, ty);
        // A closure argument can carry lifetimes its parameter's `Fn(...)` type does not name. The
        // caller keeps the loan by handing it to the result: a callee that returns the callable
        // cannot make it outlive what it borrows.
        if kind == 20 {
            n := resource(&mut c, slot);
            if n != 0 {
                info := &c.resources[n - 1];
                actual := info.ty;
                if (ty_kind(&mut c, actual) == 20) & contains_borrow(&mut c, actual, 0) {
                    return_bonds(&mut c, source, holder, 1);
                }
            }
        }
        mut rs = type_caps(&mut c, ty, 0);
        if kind == 7 {
            rs = type_regions(&mut c, ty);
        }
        if intersects(&rs, &captures) {
            mut role = u64(aggregate);
            if (kind == 7) & (resultkind == 7) {
                role = 3;
            }
            return_bonds(&mut c, source, holder, role);
        }
        if kind == 7 {
            inner := ty_arg(&mut c, ty);
            data := type_caps(&mut c, inner, 0);
            if intersects(&data, &captures) {
                storage := target_of(&mut c, slot);
                return_bonds(&mut c, storage, holder, aggregate);
            }
        }
    }
    if ty_kind(&mut c, result.ty) == 7 {
        stored_source(&mut c, result.t, result.ty);
        if target_of(&mut c, result.t) == 0 {
            fail(&mut c, view("reference result has no declared frame source"));
        }
    }
    k := ty_kind(&mut c, result.ty);
    if (k == 5) || (k == 7) || (k == 27) {
        stored_source(&mut c, result.t, result.ty);
        if !has_bonds(&mut c, holder) {
            fail(&mut c, view("borrowed result has no declared input source"));
        }
    }
    normalize_readonly(&mut c, result.t, result.ty);
    close_loans(&mut c);
    return ();
}
// Weak updates retain historical guards across branch restoration. External storage
// accepts only origins explicitly present in its invariant data-lifetime contract.
fn check_writeback<a>(c: (&a mut C), destination: u64, ty: u64, source: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if !contains_borrow(&mut c, ty, 0) {
        return ();
    }
    region := region_of(&mut c, destination);
    if region == 0 {
        return ();
    }
    if region == 18446744073709551615 {
