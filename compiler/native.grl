 vec_push(c.resources,Resource{slot:snap,ty:ty,flag:0,base:v+1,field:0,via:1,place:place,target:0,authority:authority});}vec_push(args,snap);}
 expect(borrow_mut(c),read(")"));expect(borrow_mut(c),read(";"));let first=load(vec_get(args,0));require_write(borrow_mut(c),first);invoke(borrow_mut(c),f,args);cleanup(borrow_mut(c),temps);return ();
}
fn statement<a>(c:ref_mut<a,C>)->unit{
 if is(borrow_mut(c),read("break"))+is(borrow_mut(c),read("continue")){
