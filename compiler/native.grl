        // written, so it needs no `mut`.
        here := c.pos;
        name := tok_text(&mut c, here);
        l := find_local(&mut c, view(name));
        after := kind_at(&mut c, here + 1);
        if (l != 0) & (after != 91) & (after != 46) & (after != 40) {
            lt := local_ty(&mut c, l - 1);
            if ty_kind(&mut c, lt) == 27 {
                if write != 0 && ty_mode(&mut c, lt) == 0 {
                    fail(&mut c, view("&mut of a readonly slice"));
