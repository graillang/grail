                q += 1;
            }
            if kind_at(borrow_mut(c), q + 1) == 91 {
                advance(borrow_mut(c));
                ty := parse_type(borrow_mut(c));
                expect(borrow_mut(c), &")");
                return finish_type_literal(borrow_mut(c), ty);
            }
        }
        advance(borrow_mut(c));
        if eat(borrow_mut(c), &")") {
            return val(imm(borrow_mut(c), 0), 1);
        }
        mut v = expr(borrow_mut(c), 0);
        expect(borrow_mut(c), &")");
        return v;
    }
    if k == 3 {
        return string_lit(borrow_mut(c));
    }
    if k == 5 {
        // Decimal text is converted to the nearest double (ties to even) with exact arithmetic.
        p := c.pos;
        t := tok_text(borrow_mut(c), p);
        advance(borrow_mut(c));
        l := label(borrow_mut(c));
        // 2.5f32 / 2.5f64: an adjacent suffix fixes the type; a bare literal may adopt f32 later.
        mut precision = 53;
        mut suffixed = 0;
        if kind(borrow_mut(c)) == 1 {
            here := &c.toks[p];
            fend := here.end;
            q := c.pos;
            next := &c.toks[q];
            fstart := next.start;
            if fstart == fend {
                suffix := tok_text(borrow_mut(c), q);
                if same(&suffix, &"f32") {
                    precision = 24;
                    suffixed = 1;
                }
                if same(&suffix, &"f64") {
                    suffixed = 1;
                }
                if suffixed {
                    advance(borrow_mut(c));
                }
            }
        }
        bits := float_bits_p(borrow_mut(c), &t, precision);
        if suffixed == 0 {
            exchange(borrow_mut(c.flit_start), p);
            q := c.pos;
            exchange(borrow_mut(c.flit_end), q);
            exchange(borrow_mut(c.flit_tok), p);
