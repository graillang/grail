                    }
                }
            }
            if first != 0 && is(&mut c, view(";")) {
                // `T[v; n]`: n copies of a plain value, built in one reservation.
                advance(&mut c);
                if (c.raw == 0) & (bytes == 0) {
                    element := ty_arg(&mut c, ty);
                    if needs_drop(&mut c, element) {
                        fail(&mut c, view("a repeated element must be a plain value; build owned elements with push"));
                    }
                }
                nstart := c.pos;
                mut count = expr(&mut c, 0);
                nend := c.pos;
                if c.raw == 0 {
                    count = adopt_value(&mut c, count, nstart, nend, 0);
                    require_type(&mut c, count.ty, 0);
                }
                expect(&mut c, view("]"));
                mut fill = "rt_fill";
                if bytes != 0 {
                    fill = "rt_fillb";
                }
                code := narrow_vector(&mut c, ty);
                if code != 0 {
                    fill = "rt_fill4";
                }
                unit := narrow_encode(&mut c, code, v.t);
                mut args = two(slot, unit);
                args.push(count.t);
                invoke(&mut c, view(fill), args);
                return val(slot, ty);
            }
            value := v.t;
            source := place_of(&mut c, value);
            move_out(&mut c, val(value, v.ty));
            mut f = "rt_push";
            if bytes != 0 {
                // A u8 element always fits; an untyped word is range-checked at run time.
                f = "rt_pushb_checked";
                if v.ty == int_type(&mut c, 8, 0) {
                    f = "rt_pushb";
                }
            }
            code := narrow_vector(&mut c, ty);
            if code != 0 {
                f = "rt_push4";
