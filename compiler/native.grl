    decl := ty_arg(&mut c, ty);
    if (decl >= c.decls.len()) || (c.decls[decl].is_enum != 0) {
        return 0;
    }
    first := c.decls[decl].first;
    count := c.decls[decl].count;
    for i in count {
        if same(view(c.fields[first + i].name), view(name)) {
            return field_type(&mut c, ty, i);
