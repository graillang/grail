            rdecl = rd;
            if ffi_record_has_nested(&mut c, rd) & ffi_record_has_float_deep(&mut c, rd) {
                // Classifying floats inside an embedded record needs the flattened field list;
                // refuse rather than read the wrong registers.
                fail(&mut c, view("extern C record results with floats inside an embedded record are not supported yet"));
            }
            if ffi_record_has_float(&mut c, rd) {
                fplan = ffi_float_plan(&mut c, rd, abi);
            }
            if fplan == 2 {
                // An AAPCS64 homogeneous float aggregate comes back in s0-s3/d0-d3 at any size.
                rmode = 3;
            }
            if (fplan == 3) & (rsize < 17) {
                rmode = 3;
            }
            if (fplan == 1) & (rsize < 17) {
                rmode = 3;
            }
            if rmode == 3 {
            } else {
            if abi == 1 {
                if (rsize != 1) & (rsize != 2) & (rsize != 4) & (rsize != 8) {
                    rmode = 2;
                }
            } else {
                if 16 < rsize {
                    rmode = 2;
                }
            }
            }
