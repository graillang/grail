        capture_authority(borrow_mut(c), root);
        require_write(borrow_mut(c), xt);
        slot := apply(borrow_mut(c), &"rt_pop", one(xt));
        own(borrow_mut(c), slot, ty);
        result := place_of(borrow_mut(c), slot);
