    }
    mut shift = 0;
    if (rmode == 2) & (abi != 2) {
        shift = 1;
    }
    // First pass: how many argument words go to the stack. Win64 slots are positional: the
    // n-th argument uses the n-th register of its class or the n-th stack slot.
    mut ints = shift;
    mut floats = 0;
    mut stack = 0;
    // A `byval` argument's placement is decided here and replayed when the call is emitted, so the
    // two passes cannot disagree; its counters advance the same integer/float/stack allocation.
    mut copies = 0;
    mut plans = FFIPlan[];
    for i in args.len() {
        ty := argtypes[i];
        // RV64 passes variadic floating-point arguments in integer registers; Apple arm64 passes
        // every variadic argument on the stack in its own 8-byte slot.
        rv_var := (abi == 3) & (fixed < i + 1);
        apple_var := apple_arm & (fixed < i + 1);
        if (formals.len() > i) && ffi_byval(&mut c, formals[i]) {
            inner := ty_arg(&mut c, formals[i]);
            rd := ty_arg(&mut c, inner);
            plan := ffi_byval_plan(&mut c, rd, abi, ints, floats, stack, copies);
            ints = plan.ints;
            floats = plan.floats;
            stack = plan.stack;
            copies = plan.copies;
            plans.push(plan);
            continue;
        }
        plans.push(ffi_empty_plan());
        if apple_var {
