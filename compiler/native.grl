        d := &c.decls[i];
        if same(view(d.module), view(".closure")) & same(view(d.name), view("FnValue")) {
            return i;
        }
    }
    first := c.fields.len();
    c.fields.push(Field { name: copy_bytes(view("__code")), ty: 0 });
    c.fields.push(Field { name: copy_bytes(view("__drop")), ty: 0 });
    c.fields.push(Field { name: copy_bytes(view("target")), ty: 0 });
    c
        .decls
        .push(
            Decl {
                module: copy_bytes(view(".closure")),
                name: copy_bytes(view("FnValue")),
                is_enum: 0,
                opaque: 0,
                c_layout: 0,
                first: first,
                count: 3,
                regions: 0,
                types: 0,
                success: 0,
                bounds: u64[],
                constraints: u64[][],
