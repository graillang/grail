    old := place_of(&mut c, v.t);
    move_out(&mut c, val(v.t, v.ty));
    own(&mut c, slot, ty);
    dst := place_of(&mut c, slot);
    if contains_borrow(&mut c, v.ty, 0) {
        return_bonds(&mut c, old, dst, 1);
    }
    return val(slot, ty);
}
fn adopt_literal<a>(c: (&a mut C), start: u64, end: u64, ty: u64) -> bool {
    if (c.lit_start != start) || (c.lit_end != end) {
        return false;
