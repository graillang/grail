// ---- v3 C FFI: foreign declarations ----
// `extern "C" [lib "INPUT"] [as "SYMBOL"] fn NAME(params) -> RESULT;` declares a
// symbol the host linker resolves. The declaration has no body and the call sites
// must sit inside an `unsafe { ... }` block. Only the C ABI is accepted; there is
// no implicit fallback to another convention.
// Number of C argument words a Grail parameter occupies. A byte view is the C
// pair (pointer, length); everything else in the accepted slice is one word.
fn ffi_words<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) == 5 {
        return 2;
    }
    if ty_kind(&mut c, ty) == 28 {
        // A `byval` record is the ABI's business, not a word count: the declaration's 64-word cap
        // counts its eightbytes, which is an upper bound on what any target passes.
        inner := ty_arg(&mut c, ty);
        d := ty_arg(&mut c, inner);
        return ffi_record_words(&mut c, d);
    }
    return 1;
}
// ---- direct extern calls: one lowering per C calling convention ----
// abi 0: SysV x86-64 (Linux and macOS); 1: Win64 (x86-64 PE); 2: AAPCS64 (Linux, macOS and
// Windows ARM64); 3: RV64 LP64D. Callbacks and calls through `cfn` values keep the narrower
// six-integer-word rule in ffi_param until their entry and indirect paths use the same classes.
fn ffi_abi<a>(c: (&a mut C)) -> u64 {
    if c.target == 3 {
        return 1;
    }
    if (c.target == 1) || (c.target == 4) {
        return 2;
    }
    if c.target == 2 {
        return 3;
    }
    return 0;
}
fn ffi_int_regs(abi: u64) -> u64 {
    if abi == 0 {
        return 6;
    }
    if abi == 1 {
        return 4;
    }
    return 8;
}
// Integer argument registers in the compiler's x86 spelling; machine.grl maps %r10/%r11 to the
// seventh and eighth AAPCS64/RV64 argument registers.
fn ffi_int_reg(abi: u64, i: u64) -> string {
    if abi == 1 {
        if i == 0 {
            return "%rcx";
        }
        if i == 1 {
            return "%rdx";
        }
        if i == 2 {
            return "%r8";
        }
        return "%r9";
    }
    if i == 6 {
        return "%r10";
    }
    if i == 7 {
        return "%r11";
    }
    return argreg(i);
}
// The suffix of a narrow integer: "s8".."u32", or "" for a 64-bit or non-integer type.
fn ffi_narrow<a>(c: (&a mut C), ty: u64) -> string {
    if ty_kind(&mut c, ty) != 18 {
        return "";
    }
    bits := ty_arg(&mut c, ty);
    signed := ty_mode(&mut c, ty);
    if bits == 8 {
        if signed != 0 {
            return "s8";
        }
        return "u8";
    }
    if bits == 16 {
        if signed != 0 {
            return "s16";
        }
        return "u16";
    }
    if bits == 32 {
        if signed != 0 {
            return "s32";
        }
        return "u32";
    }
    return "";
}
fn ffi_x86_extend<a, b>(c: (&a mut C), suffix: &b [u8]) -> unit {
    if same(view(suffix), view("s8")) {
        o(&mut c, view("movsbq %al,%rax\n"));
    }
    if same(view(suffix), view("s16")) {
        o(&mut c, view("movswq %ax,%rax\n"));
    }
    if same(view(suffix), view("s32")) {
        o(&mut c, view("movslq %eax,%rax\n"));
    }
    if same(view(suffix), view("u8")) {
        o(&mut c, view("movzbq %al,%rax\n"));
    }
    if same(view(suffix), view("u16")) {
        o(&mut c, view("movzwq %ax,%rax\n"));
    }
    if same(view(suffix), view("u32")) {
        o(&mut c, view("movl %eax,%eax\n"));
    }
    return ();
}
// A parameter of `extern "C" record` type spelled `v: byval R` passes the whole record by value;
// a bare `R` stays the C `R *`. The marker is its own parameter type - kind 28, wrapping the record
// type - so one declaration can use both spellings and every call site is checked against the one
// it names, while the value itself is checked as the record it wraps (see require_type).
fn ffi_byval<a>(c: (&a mut C), ty: u64) -> bool {
    return ty_kind(&mut c, ty) == 28;
}
// 1 when a `byval R` parameter follows: `byval` and then the start of a type, so a type that
// happens to be named `byval` is not mistaken for the marker.
fn ffi_byval_ahead<a>(c: (&a mut C)) -> bool {
    if !is(&mut c, view("byval")) {
        return false;
    }
    p := c.pos + 1;
    return token_starts_type(&mut c, p);
}
// Parses the record type after `byval` and returns the parameter type.
fn ffi_byval_parameter<a>(c: (&a mut C)) -> u64 {
    ty := parse_type(&mut c);
    if ffi_byval_target(&mut c) == 0 {
        fail(
            &mut c,
            view("byval is not implemented for the Windows x86-64 and Windows ARM64 ABIs; pass the record by pointer")
        );
    }
    if is_c_record(&mut c, ty) == 0 {
        fail(&mut c, view("byval must name an extern \"C\" record type; a bare record parameter is a pointer"));
    }
    return intern(&mut c, 28, ty);
}
// 1 when this target's by-value classification is implemented and exercised by the FFI gate.
fn ffi_byval_target<a>(c: (&a mut C)) -> u64 {
    if (c.target == 3) || (c.target == 4) {
        return 0;
    }
    return 1;
}
fn ffi_direct_type<a>(c: (&a mut C), ty: u64) -> bool {
    if is_float(&mut c, ty) {
        return true;
    }
    if (ty_kind(&mut c, ty) == 18) & (ffi_narrow(&mut c, ty).len() != 0) {
        return true;
    }
    return false;
}
fn ffi_direct_param<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    if ffi_byval(&mut c, ty) {
        return ();
    }
    if ffi_direct_type(&mut c, ty) {
        return ();
    }
    ffi_param(&mut c, ty, what);
    return ();
}
fn ffi_direct_result<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    if ty != 1 {
        if ffi_direct_type(&mut c, ty) {
            return ();
        }
        // A C-layout record result is returned by value (registers or a hidden result pointer,
        // per ABI) into a fresh Grail record of the same layout.
        if ty_kind(&mut c, ty) == 8 {
            rd := ty_arg(&mut c, ty);
            if c.decls[rd].c_layout != 0 {
                return ();
            }
        }
    }
    ffi_result(&mut c, ty, what);
    return ();
}
// %rax -> the outgoing stack argument word at `offset` bytes above the stack pointer.
fn ffi_store_stack<a>(c: (&a mut C), x86: u64, offset: u64) -> unit {
    if x86 != 0 {
        o(&mut c, view("movq %rax,"));
        on(&mut c, offset);
        o(&mut c, view("(%rsp)\n"));
    } else {
        o(&mut c, view("cstarg "));
        on(&mut c, offset);
        c.out.push(10);
    }
    return ();
}
// The binary32 bits of the f32 value in %rax, left in %rax.
fn ffi_f32_bits<a>(c: (&a mut C), x86: u64) -> unit {
    if x86 != 0 {
        // xmm5 is volatile on Win64 and free here: a stack-bound f32 on Win64 comes after the four
        // register slots, and on SysV after xmm0-xmm7, where xmm8+ are free and volatile too.
        if c.target == 3 {
            o(&mut c, view("movq %rax,%xmm5\ncvtsd2ss %xmm5,%xmm5\nmovd %xmm5,%eax\n"));
            return ();
        }
        o(&mut c, view("movq %rax,%xmm15\ncvtsd2ss %xmm15,%xmm15\nmovd %xmm15,%eax\n"));
    } else {
        o(&mut c, view("cf32bits\n"));
    }
    return ();
}
// `symbol` names the callee; when it is empty, `target` is the slot holding a `cfn` address and
// the call is indirect (through %rax, which no C convention uses for an argument).
fn ffi_emit_call<a, b, d, e, f>(
    c: (&a mut C),
    args: &b u64[],
    argtypes: &d u64[],
    formals: &f u64[],
    ret: u64,
    symbol: &e [u8],
    target: u64
