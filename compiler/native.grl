fn fold_constant(k: u64, a: u64, b: u64) -> u64[] {
    if k == 43 {
        if a <= 18446744073709551615 - b {
            return u64[1, a + b];
        }
    }
    if (k == 45) & (b <= a) {
        return u64[1, a - b];
    }
    if k == 42 {
        if (a == 0) || (b <= 18446744073709551615 / a) {
            return u64[1, a * b];
        }
    }
    if (k == 47) & (b != 0) {
        return u64[1, a / b];
    }
    if (k == 37) & (b != 0) {
        return u64[1, a % b];
    }
    if (k == 271) & (b < 64) {
        if a <= (18446744073709551615 >> b) {
            return u64[1, a << b];
        }
    }
    if (k == 272) & (b < 64) {
        return u64[1, a >> b];
    }
    if k == 38 {
        return u64[1, a & b];
    }
    if k == 124 {
        return u64[1, a | b];
    }
    if k == 94 {
        return u64[1, a ^ b];
    }
    return u64[0, 0];
}
// A statement builtin (`drop(x)`, `write(...)`, `assert(...)`) only when the name is followed by
// `(` and is not shadowed by a local; consumes the name on success. A binding named `write` or
// `drop` is then an ordinary name (`write += 3`).
fn statement_builtin<a, b>(c: (&a mut C), name: &b [u8]) -> bool {
    if !is(&mut c, &name) {
        return false;
    }
    here := c.pos;
    if kind_at(&mut c, here + 1) != 40 {
        return false;
    }
    if find_local(&mut c, &name) != 0 {
        return false;
    }
    advance(&mut c);
    return true;
}
// Walks the accessors of an assignment target from c.pos up to (not including) `stop`: each
// `[i]` and `.f` run yields a mutable reference to the element or field, so `v[i][j] = x` and
// `v[i].f = x` reach the final store through ordinary borrows.
fn chain_walk<a>(c: (&a mut C), base: Val, stop: u64) -> Val {
    return chain_walk_mode(&mut c, base, stop, 1);
}
// chain_walk with a borrow mode: write = 1 borrows each step mutably, 0 shares it.
fn chain_walk_mode<a>(c: (&a mut C), base: Val, stop: u64, write: u64) -> Val {
    mut v = base;
    while c.pos < stop {
        if kind(&mut c) == 91 {
            v = index_view(&mut c, v, 1 + write);
            continue;
        }
        if kind(&mut c) == 46 {
            mut q = c.pos;
            while (kind_at(&mut c, q) == 46) & (kind_at(&mut c, q + 1) == 1) & (q < stop) {
                q += 2;
            }
            r := field_path(&mut c, v.t, v.ty, 1 + write);
            target := target_of(&mut c, r.t);
            res := resource(&mut c, r.t);
            info := &c.resources[res - 1];
            owner := info.base - 1;
            v = borrow_reference(&mut c, r.t, r.ty, owner, target, write);
            continue;
        }
        fail(&mut c, view("expected [index] or .field in assignment target"));
    }
    return v;
}
// `v[i].f = x` / `v[i][j].f.g += x`: the indexed prefix is borrowed mutably, then the final field
// run is assigned exactly like `binding.f = x`.
fn chained_field_assignment<a>(c: (&a mut C)) -> unit {
    chain := assign_chain(&mut c);
    oppos := chain[0];
    // The final field run starts at the first `.` after the last bracket group.
    mut q = c.pos + 1;
    mut final_run = 0;
    while q < oppos {
        if kind_at(&mut c, q) == 91 {
            mut depth = 0;
            while true {
                kk := kind_at(&mut c, q);
                if kk == 91 {
                    depth = depth + 1;
                }
                if kk == 93 {
                    depth = depth - 1;
                    if depth == 0 {
                        break;
                    }
                }
                q = q + 1;
            }
            q = q + 1;
            final_run = q;
            continue;
        }
        q = q + 2;
    }
    head := place(&mut c, 1, 0);
    base := chain_walk(&mut c, head, final_run);
    a := field_path(&mut c, base.t, base.ty, 2);
    target := a.t;
    fieldty := ty_arg(&mut c, a.ty);
    assignment_tail(&mut c, 0, base.t, base.ty, target, u64[1, fieldty]);
    return ();
}
// Legacy vector/byte assignment evaluates RHS before parsing its mutable target.
fn index_assignment<a>(c: (&a mut C)) -> unit {
    start := c.pos;
    oppos := index_assignment_ahead(&mut c);
    operator := kind_at(&mut c, oppos);
    exchange(&mut c.pos, oppos + 1);
    vstart := c.pos;
    rhs_mark := c.resources.len();
    mut v = expr(&mut c, 0);
    vend := c.pos;
    if c.raw == 0 && !contains_borrow(&mut c, v.ty, 0) {
        // The place lies before the right side in the source, so locals must not expire here (their
        // last use is the place itself); only the right side's own temporaries end.
        release_temporaries(&mut c, rhs_mark, v.t);
        close_loans(&mut c);
    }
    expect(&mut c, view(";"));
    after := c.pos;
    ls := c.lit_start;
    le := c.lit_end;
    lv := c.lit_value;
    ln := c.lit_negative;
    fs := c.flit_start;
    fe := c.flit_end;
    ft := c.flit_tok;
    fneg := c.flit_neg;
    exchange(&mut c.pos, start);
    // A binding holding a mutable view/reference writes through its capability (no `mut` needed).
    mut capability = 0;
    name := tok_text(&mut c, start);
    l := find_local(&mut c, view(name));
    if (l != 0) & (kind_at(&mut c, start + 1) == 91) {
        lt := local_ty(&mut c, l - 1);
        lk := ty_kind(&mut c, lt);
        if ((lk == 5) || (lk == 7) || (lk == 27)) && (ty_mode(&mut c, lt) != 0) {
            capability = 1;
        }
        if (lk == 27) & (ty_mode(&mut c, lt) == 0) {
            fail(&mut c, view("writing an element needs a mutable slice (&mut [T])"));
        }
    }
    mut base = val(0, 0);
    chain := assign_chain(&mut c);
    if (capability != 0) & (chain[2] == 1) {
        base = primary(&mut c);
    } else {
        base = place(&mut c, 1, 0);
        base = chain_walk(&mut c, base, chain[1]);
    }
    x := deref(&mut c, val(base.t, base.ty));
    k := ty_kind(&mut c, x.ty);
    mut op = 0;
    if operator != 61 {
        op = compound_operator(operator);
    }
    if (k == 6) || (k == 27) {
        elem := ty_arg(&mut c, x.ty);
        r := index_view(&mut c, base, 2);
        exchange(&mut c.lit_start, ls);
        exchange(&mut c.lit_end, le);
        exchange(&mut c.lit_value, lv);
        exchange(&mut c.lit_negative, ln);
        exchange(&mut c.flit_start, fs);
        exchange(&mut c.flit_end, fe);
        exchange(&mut c.flit_tok, ft);
        exchange(&mut c.flit_neg, fneg);
        if c.raw == 0 {
            v = adopt_value(&mut c, v, vstart, vend, elem);
        }
        code := narrow_code(&mut c, elem);
        if operator != 61 {
            if c.raw == 0 {
                if !(integer(&mut c, elem) || is_float(&mut c, elem)) {
                    fail(&mut c, view("compound assignment needs numeric elements"));
                }
            }
            get(&mut c, r.t, view("%rax"));
            if code != 0 {
                o(&mut c, view("movl (%rax),%eax\n"));
                unit := save(&mut c);
                old := narrow_decode(&mut c, code, unit);
                v = compound_value(&mut c, op, old, v, elem);
            } else {
                o(&mut c, view("movq (%rax),%rax\n"));
                old := save(&mut c);
                v = compound_value(&mut c, op, old, v, elem);
            }
        }
        if code != 0 {
            if c.raw == 0 {
                require_type(&mut c, v.ty, elem);
            }
            require_write(&mut c, r.t);
            unit := narrow_encode(&mut c, code, v.t);
            get(&mut c, r.t, view("%rcx"));
            get(&mut c, unit, view("%rax"));
            o(&mut c, view("movl %eax,(%rcx)\n"));
        } else {
            exchange_into(&mut c, r, v);
        }
    } else {
        // Bytes: buf[i] = b stores the low byte of a u8/u64 value.
        if c.raw == 0 {
            if (k != 3) && ((k != 5) || (ty_mode(&mut c, x.ty) == 0)) {
                fail(
                    &mut c,
                    view("index assignment needs a vector, bytes or a mutable byte view")
                );
            }
        }
        expect(&mut c, view("["));
        index := expr(&mut c, 0);
        if c.raw == 0 {
            require_type(&mut c, index.ty, 0);
        }
        expect(&mut c, view("]"));
        exchange(&mut c.lit_start, ls);
        exchange(&mut c.lit_end, le);
        exchange(&mut c.lit_value, lv);
        exchange(&mut c.lit_negative, ln);
        u := int_type(&mut c, 8, 0);
        if c.raw == 0 {
            if (c.lit_start == vstart) & (c.lit_end == vend) & (v.ty == 0) {
                if adopt_literal(&mut c, vstart, vend, u) {
                    v = val(v.t, u);
                }
            }
            if v.ty != u {
                require_type(&mut c, v.ty, 0);
            }
        }
        if operator != 61 {
            old := invoke(&mut c, view("rt_atb"), two(x.t, index.t));
            v = compound_value(&mut c, op, old, val(v.t, 0), 0);
        }
        require_write(&mut c, x.t);
        mut args = two(x.t, index.t);
        args.push(v.t);
        // A u64 value must fit in a byte; u8 values always do.
        if v.ty != u {
            lim := imm(&mut c, 256);
            get(&mut c, lim, view("%rcx"));
            get(&mut c, v.t, view("%rax"));
            o(&mut c, view("cmpq %rcx,%rax\n"));
            ok := label(&mut c);
            jump(&mut c, view("jb"), ok);
            o(&mut c, view("call rt_abort\n"));
            mark(&mut c, ok);
        }
        invoke(&mut c, view("rt_write"), args);
    }
    exchange(&mut c.pos, after);
    return ();
}
fn assignment_ahead<a>(c: (&a mut C)) -> bool {
    if kind(&mut c) != 1 {
        return false;
    }
    mut e = c.pos + 1;
    while kind_at(&mut c, e) == 46 {
        e = e + 2;
    }
    k := kind_at(&mut c, e);
    return k == 61 || (261 < k && k < 267) || k == 268;
}
// Evaluates one argument to its dereferenced value.
fn operand<a>(c: (&a mut C)) -> Val {
    mut v = expr(&mut c, 0);
    return deref(&mut c, v);
}
fn write_statement<a>(c: (&a mut C)) -> unit {
    temps := c.resources.len();
    expect(&mut c, view("("));
    mut args = u64[];
    for i in 3 {
        if i != 0 {
            expect(&mut c, view(","));
        }
        value := operand(&mut c);
        v := value.t;
        ty := value.ty;
        if c.raw == 0 {
            if i == 0 {
                k := ty_kind(&mut c, ty);
                if (k != 5) || (ty_mode(&mut c, ty) == 0) {
                    fail(&mut c, view("write requires mutable byte view"));
                }
            } else {
                require_type(&mut c, ty, 0);
            }
        }
        get(&mut c, v, view("%rax"));
        snap := save(&mut c);
        r := resource(&mut c, v);
        if r != 0 {
            old := &c.resources[r - 1];
            ty := old.ty;
            place := old.place;
            authority := old.authority;
            c
                .resources
                .push(
                    Resource {
                        slot: snap,
                        ty: ty,
                        flag: 0,
                        base: v + 1,
                        field: 0,
                        via: 1,
                        place: place,
                        target: 0,
                        authority: authority,
                    }
                );
        }
        args.push(snap);
    }
    expect(&mut c, view(")"));
    expect(&mut c, view(";"));
    first := args[0];
    require_write(&mut c, first);
    invoke(&mut c, view("rt_write"), args);
    cleanup(&mut c, temps);
    return ();
}
// if let Variant(binding) = value { ... } else { ... }: consumes value like match; the else
// branch drops it (so a different variant's payload is cleaned up).
fn if_let<a>(c: (&a mut C)) -> unit {
    name := ident(&mut c);
    mut binding = u8[];
    mut has_binding = 0;
    if eat(&mut c, view("(")) {
        if !eat(&mut c, view("_")) {
            binding = ident(&mut c);
            has_binding = 1;
        }
        expect(&mut c, view(")"));
    }
    expect(&mut c, view("="));
    tests := c.resources.len();
    s := expr(&mut c, 0);
    x := deref(&mut c, s);
    xt := x.t;
    xty := x.ty;
    if ty_kind(&mut c, xty) != 8 {
        fail(&mut c, view("if let requires an enum value"));
    }
    d := ty_arg(&mut c, xty);
    decl := &c.decls[d];
    if decl.is_enum == 0 {
        fail(&mut c, view("if let requires an enum value"));
    }
    k := find_field(&mut c, d, view(name));
    pty := field_type(&mut c, xty, k);
    tag := rec_load(&mut c, xt, 0, 0);
    move_out(&mut c, val(xt, xty));
    before := ownership::snapshot(&c.check);
    no := label(&mut c);
    end := label(&mut c);
    get(&mut c, tag, view("%rax"));
    o(&mut c, view("cmpq $"));
    on(&mut c, k);
    o(&mut c, view(",%rax\n"));
    jump(&mut c, view("jne"), no);
    mark := c.locals.len();
    payloads := c.resources.len();
    payload := rec_load(&mut c, xt, 1, 0);
    own(&mut c, payload, pty);
    source := place_of(&mut c, xt);
    dest := place_of(&mut c, payload);
    if contains_borrow(&mut c, pty, 0) {
        transfer_bonds(&mut c, source, dest);
    }
    stored_source(&mut c, payload, pty);
    invoke(&mut c, view("rt_free"), one(xt));
    if has_binding != 0 {
        bind(&mut c, binding, pty, payload, 0);
    }
    exchange(&mut c.terminated, 0);
    block(&mut c);
    cleanup(&mut c, payloads);
    pop_locals(&mut c, mark);
    yes := ownership::snapshot(&c.check);
    yt := c.terminated;
    jump(&mut c, view("jmp"), end);
    mark(&mut c, no);
    ownership::restore(&mut c.check, &before);
    exchange(&mut c.terminated, 0);
    get(&mut c, xt, view("%rdi"));
    drop_call(&mut c, xty);
    if eat(&mut c, view("else")) {
        if is(&mut c, view("if")) {
            statement(&mut c);
        } else {
            block(&mut c);
        }
    }
    nt := c.terminated;
    if yt == 0 {
        if nt != 0 {
            ownership::restore(&mut c.check, &yes);
        } else {
            ownership::merge(&mut c.check, &yes);
        }
    }
    exchange(&mut c.terminated, yt & nt);
    mark(&mut c, end);
    return ();
}
// match on an integer or bool: `0 => {..}`, `1 | 2 => {..}`, `'a' => {..}`, `_ => {..}`.
fn scalar_match<a>(c: (&a mut C), s: Val) -> unit {
    xt := s.t;
    ty := s.ty;
    observe(&mut c, xt);
    boolean := is_bool(&mut c, ty);
    mut before = ownership::snapshot(&c.check);
    mut exits = ownership::new();
    mut have = 0;
    mut seen = u64[];
    mut default = 0;
    end := label(&mut c);
    expect(&mut c, view("{"));
    while !eat(&mut c, view("}")) {
        ownership::restore(&mut c.check, &before);
        exchange(&mut c.terminated, 0);
        next := label(&mut c);
        body := label(&mut c);
        mut binding = u8[];
        mut wildcard = 0;
        if eat(&mut c, view("_")) {
            wildcard = 1;
        } else {
            if (kind(&mut c) == 1)
                & !is(&mut c, view("true"))
                & !is(&mut c, view("false")) {
                binding = ident(&mut c);
                wildcard = 1;
            }
        }
        // `if` after a pattern adds a guard; a guarded arm never makes the match exhaustive.
        if wildcard != 0 {
            if !is(&mut c, view("if")) {
                if default != 0 {
                    fail(&mut c, view("duplicate catch-all arm"));
                }
                default = 1;
            }
        } else {
            while true {
                negative := u64(eat(&mut c, view("-")));
                here := c.pos;
                k := kind(&mut c);
                mut value = 0;
                if boolean {
                    if negative != 0 {
                        fail(&mut c, view("bool patterns are true or false"));
                    }
                    if is(&mut c, view("true")) {
                        value = 1;
                    } else {
                        if !is(&mut c, view("false")) {
                            fail(&mut c, view("bool patterns are true or false"));
                        }
                    }
                    advance(&mut c);
                } else {
                    if k == 2 {
                        t := tok_text(&mut c, here);
                        value = literal_value(&mut c, view(t));
                        advance(&mut c);
                    } else {
                        if k == 4 {
                            value = char_literal(&mut c, here);
                            advance(&mut c);
                        } else {
                            fail(
                                &mut c,
                                view("match patterns must be integer or character literals (or _)")
                            );
                        }
                    }
                    if literal_fits(&mut c, ty, value, negative) == 0 {
                        fail(&mut c, view("match pattern out of range for the value's type"));
                    }
                    if negative != 0 {
                        value = wrapping_sub(0, value);
                    }
                }
                if !boolean & (kind(&mut c) == 46) & (next_kind(&mut c) == 46) {
                    // lo..hi (hi excluded): (x - lo) < (hi - lo) as unsigned words, correct for signed types too.
                    advance(&mut c);
                    advance(&mut c);
                    hneg := u64(eat(&mut c, view("-")));
                    there := c.pos;
                    hk := kind(&mut c);
                    mut high = 0;
                    if hk == 2 {
                        t := tok_text(&mut c, there);
                        high = literal_value(&mut c, view(t));
                        advance(&mut c);
                    } else {
                        if hk == 4 {
                            high = char_literal(&mut c, there);
                            advance(&mut c);
                        } else {
                            fail(&mut c, view("range pattern needs an integer upper bound"));
                        }
                    }
                    if literal_fits(&mut c, ty, high, hneg) == 0 {
                        fail(&mut c, view("match pattern out of range for the value's type"));
                    }
                    if hneg != 0 {
                        high = wrapping_sub(0, high);
                    }
                    mut empty = false;
                    if ty_kind(&mut c, ty) == 18 {
                        if ty_mode(&mut c, ty) != 0 {
                            empty = ((high ^ 9223372036854775808) < (value ^ 9223372036854775808))
                                || high == value;
                        } else {
                            empty = high < value || high == value;
                        }
                    } else {
                        empty = high < value || high == value;
                    }
                    if empty {
                        fail(&mut c, view("empty range pattern"));
                    }
                    o(&mut c, view("movabsq $"));
                    on(&mut c, value);
                    o(&mut c, view(",%rcx\n"));
                    get(&mut c, xt, view("%rax"));
                    o(&mut c, view("subq %rcx,%rax\n"));
                    width := wrapping_sub(high, value);
                    o(&mut c, view("movabsq $"));
                    on(&mut c, width);
                    o(&mut c, view(",%rcx\ncmpq %rcx,%rax\n"));
                    jump(&mut c, view("jb"), body);
                } else {
                    for i in seen.len() {
                        if seen[i] == value {
                            fail(&mut c, view("duplicate match pattern"));
                        }
                    }
                    seen.push(value);
                    o(&mut c, view("movabsq $"));
                    on(&mut c, value);
                    o(&mut c, view(",%rcx\n"));
                    get(&mut c, xt, view("%rax"));
                    o(&mut c, view("cmpq %rcx,%rax\n"));
                    jump(&mut c, view("je"), body);
                }
                if !eat(&mut c, view("|")) {
                    break;
                }
            }
            jump(&mut c, view("jmp"), next);
        }
        mark(&mut c, body);
        mark := c.locals.len();
        if binding.len() != 0 {
            bind(&mut c, binding, ty, xt, 0);
        }
        if eat(&mut c, view("if")) {
            tests := c.resources.len();
            g := expr(&mut c, 0);
            if !(is_bool(&mut c, g.ty) || g.ty == 0) {
                fail(&mut c, view("match guard must be a bool"));
            }
            cleanup(&mut c, tests);
            get(&mut c, g.t, view("%rax"));
            o(&mut c, view("testq %rax,%rax\n"));
            jump(&mut c, view("jz"), next);
            // The next arm starts from the state before or after the guard, whichever path reached it.
            after := ownership::snapshot(&c.check);
            mut merged = ownership::snapshot(&before);
            ownership::merge(&mut merged, &after);
            before = merged;
        }
        expect(&mut c, view("=>"));
        block(&mut c);
        pop_locals(&mut c, mark);
        if c.terminated == 0 {
            edge := ownership::snapshot(&c.check);
            if have != 0 {
                ownership::merge(&mut exits, &edge);
            } else {
                exits = edge;
                have = 1;
            }
        }
        jump(&mut c, view("jmp"), end);
        mark(&mut c, next);
        if !eat(&mut c, view(",")) {
            expect(&mut c, view("}"));
            break;
        }
    }
    complete := default != 0 || (boolean && seen.len() == 2);
    if !complete {
        fail(&mut c, view("non-exhaustive match (add a _ arm)"));
    }
    o(&mut c, view("call rt_abort\n"));
    mark(&mut c, end);
    if have != 0 {
        ownership::restore(&mut c.check, &exits);
        exchange(&mut c.terminated, 0);
    } else {
        exchange(&mut c.terminated, 1);
    }
    return ();
}
// A record pattern names a field the record does not have, or forgets one: report which.
fn field_index<a, b>(c: (&a mut C), decl: u64, name: &b [u8]) -> u64 {
    d := &c.decls[decl];
    for i in d.count {
        f := &c.fields[d.first + i];
        if same(view(f.name), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
fn fail_unknown_field<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    mut msg = u8[];
    push_bytes(&mut msg, view("unknown field in record pattern: "));
    push_bytes(&mut msg, name);
    fail(&mut c, view(msg));
    return ();
}
fn fail_missing_field<a>(c: (&a mut C), decl: u64, index: u64) -> unit {
    mut msg = u8[];
    push_bytes(&mut msg, view("record pattern is missing field: "));
    d := &c.decls[decl];
    f := &c.fields[d.first + index];
    push_bytes(&mut msg, view(f.name));
    fail(&mut c, view(msg));
    return ();
}
// `match p { Point { x, y: other, .. } => ... }` on a record value. A record pattern matches
// every value, so it is the only pattern arm (an explicit `_` may follow and is never taken).
// Fields bind by copy for plain scalars, by move when the scrutinee is moved, and as references
// through `match &p`/`match &mut p`, exactly as enum payload patterns do.
fn record_match<a>(c: (&a mut C), sslot: u64, sty: u64, x: Val, byref: u64, refmode: u64) -> unit {
    xt := x.t;
    xty := x.ty;
    d := ty_arg(&mut c, xty);
    count := c.decls[d].count;
    expect(&mut c, view("{"));
    if is(&mut c, view("_")) {
        fail(&mut c, view("match on a record takes a record pattern"));
    }
    name := ident(&mut c);
    if !same(view(name), view(c.decls[d].name)) {
        fail(&mut c, view("pattern type is not the scrutinee's record type"));
    }
    if c.decls[d].c_layout != 0 {
        fail(&mut c, view("a record pattern needs a Grail record, not an extern record"));
    }
    if byref == 0 {
