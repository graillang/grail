// Emits the specialisations requested from `from` onward - including any requested while emitting
// them - and returns how many there are. Closures and specialisations can each request the other,
// so the caller alternates this with emit_closures until neither list grows.
fn drain_specs<a>(c: (&a mut C), from: u64) -> u64 {
    mut i = from;
    while i < c.specs.len() {
        spec := &c.specs[i];
        template := spec.template;
        // Every run emits the specialisations its own code asks for, whichever module defines the
        // template - replayed from that module's interface when its source is not part of this run.
        // The body is weak and content-addressed, so every object that asks for one key emits the
        // same body under the same name and the linker keeps one (B1 stage 4).
        // One definition per key, not per entry in `c.specs`: two interned argument lists can
        // describe the same type - a capturing closure whose environment record was synthesised
        // twice has the same captures and a different declaration index - and the key is what
        // decides identity, so the first emission serves both. The call sites already reference the
        // same symbol, so emitting twice would be a duplicate definition.
        if spec_taken(&mut c, i) != 0 {
            i = i + 1;
            continue;
        }
        mut args = type_args_for_spec(&mut c, i);
        mut bindings = u64[];
        for j in args.len() {
            base := args[j];
            identity := c.alias_next;
            exchange(&mut c.alias_next, identity + 1);
            alias := intern_full(&mut c, 10, base, identity, u64[]);
            bindings.push(alias);
        }
        exchange(&mut c.bindings, bindings);
        exchange(&mut c.current_spec, i + 1);
        exchange(&mut c.spec_closures, 0);
        replay_function(&mut c, template);
        exchange(&mut c.bindings, u64[]);
        exchange(&mut c.current_spec, 0);
        i = i + 1;
    }
    return i;
}
// True when this module's surface and bodies came from an interface rather than from a file on the
// command line: its code belongs to its own object.
fn iface_owned<a, b>(c: (&a mut C), m: &b [u8]) -> bool {
    for i in c.iface_used.len() {
        if same(view(c.iface_used[i]), view(m)) {
            return true;
        }
    }
    return false;
}
// True when this run instantiates that template, so its body has to be replayed here even if the
// module that defines it is another object.
fn instantiated<a>(c: (&a mut C), template: u64) -> bool {
    for i in c.specs.len() {
        if c.specs[i].template == template {
            return true;
        }
    }
    return false;
}
fn type_args_for_spec<a>(c: (&a mut C), index: u64) -> u64[] {
    spec := &c.specs[index];
    mut out = u64[];
    for i in spec.args.len() {
        out.push(spec.args[i]);
    }
    return out;
}
// Whether the method call whose `.` is at `dot` has a plain local receiver (`c.m(...)`) that one
// of its arguments names; c.pos is just past the `(`.
fn receiver_read_by_args<a>(c: (&a mut C), dot: u64) -> bool {
    if dot < 2 {
        return false;
    }
    if (kind_at(&mut c, dot - 1) != 1) || (kind_at(&mut c, dot - 2) == 46) || (kind_at(&mut c, dot - 2) == 260) {
        return false;
    }
    root := tok_text(&mut c, dot - 1);
    if find_local(&mut c, view(root)) == 0 {
        return false;
    }
    ranges := argument_ranges(&mut c);
    if ranges.len() < 3 {
        return false;
    }
    close := ranges[ranges.len() - 1];
    for q in c.pos..close {
        if (kind_at(&mut c, q) == 1) && same(view(tok_text(&mut c, q)), view(root)) {
            return true;
        }
    }
    return false;
}
// The token range [start, end) of each argument of the call whose `(` was just read, then the
// position of its `)`, flattened: start0, end0, start1, end1, ..., close. Empty when the list
// holds a closure (`|a, b|` has commas of its own) or cannot be scanned simply.
fn argument_ranges<a>(c: (&a mut C)) -> u64[] {
    mut out = u64[];
    mut depth = 0;
    mut at = c.pos;
    mut begin = at;
    while true {
        k := kind_at(&mut c, at);
        if k == 0 {
            return u64[];
        }
        if (k == 124) || (k == 274) {
            return u64[];
        }
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        } else if (k == 41) || (k == 93) || (k == 125) {
            if depth == 0 {
                out.push(begin);
                out.push(at);
                out.push(at);
                return out;
            }
            depth -= 1;
        } else if (k == 44) && (depth == 0) {
            out.push(begin);
            out.push(at);
            begin = at + 1;
        }
        at += 1;
    }
    return out;
}
// The order to take the arguments in: unchanged (empty) unless an argument is `&mut path` and
// another argument mentions the path's root, in which case such arguments go last.
fn two_phase_order<a, b>(c: (&a mut C), ranges: (&b u64[])) -> u64[] {
    if ranges.len() < 5 {
        return u64[];
    }
    n := (ranges.len() - 1) / 2;
    mut late = u64[];
    mut roots = u8[][];
    for i in n {
        a := ranges[2 * i];
        b := ranges[2 * i + 1];
        mut simple = (b >= a + 3) && (kind_at(&mut c, a) == 38) && is_at(&mut c, a + 1, view("mut")) && (kind_at(&mut c, a + 2) == 1);
        // `&mut x` or `&mut x.f.g`: a path with no call or index, so taking it later changes nothing.
        mut q = a + 3;
        while simple && (q < b) {
            if (kind_at(&mut c, q) == 46) && (q + 1 < b) && (kind_at(&mut c, q + 1) == 1) {
                q += 2;
            } else {
                simple = false;
            }
        }
        if simple {
            late.push(i);
            roots.push(tok_text(&mut c, a + 2));
        }
    }
    if late.len() == 0 {
        return u64[];
    }
    // Only when another argument reads the same root: everywhere else the order stays as written.
    mut needed = false;
    for j in late.len() {
        for i in n {
            if i != late[j] {
                for q in ranges[2 * i]..ranges[2 * i + 1] {
                    if (kind_at(&mut c, q) == 1) && same(view(tok_text(&mut c, q)), view(roots[j])) {
                        needed = true;
                    }
                }
            }
        }
    }
    if !needed {
        return u64[];
    }
    mut order = u64[];
    for i in n {
        mut is_late = false;
        for j in late.len() {
            if late[j] == i {
                is_late = true;
            }
        }
        if !is_late {
            order.push(i);
        }
    }
    for j in late.len() {
        order.push(late[j]);
    }
    return order;
}
fn call<a, b, d>(c: (&a mut C), m: &b [u8], name: &d [u8]) -> Val {
    // The program point the prover reads: everything up to the callee's name holds when the call is
    // made, and the arguments (which follow) are what it proves about.
    call_at := c.pos;
    if c.raw == 0 {
        if same(view(m), view("runtime")) {
            fail(&mut c, view("safe code cannot call unsafe runtime functions"));
        }
    }
    mut f = find_func(&mut c, view(m), view(name));
    if f == 0 {
        here := module_copy(&mut c);
        d := find_decl(&mut c, view(here), view(m));
        if d != 0 {
            owner := private_module(view(".inherent_"), d - 1);
            f = find_func(&mut c, view(owner), view(name));
        }
    }
    if f == 0 {
        mut back = c.pos;
        while (0 < back) & !((kind_at(&mut c, back) == 1) & same(view(tok_text(&mut c, back)), view(name))) {
            back -= 1;
        }
        exchange(&mut c.pos, back);
        guess := suggest_name(&mut c, view(m), view(name));
        if guess.len() != 0 {
            mut help = copy_bytes(view("a name with a similar spelling is in `"));
            push_bytes(&mut help, view(m));
            push_bytes(&mut help, view("`: `"));
            push_bytes(&mut help, view(guess));
            push_bytes(&mut help, view("`"));
            diag_help(&mut c, view(help));
        }
        fail(&mut c, view("unknown function"));
    }
    // An `unsafe fn` is called from inside an `unsafe` block, like the foreign calls it stands for.
