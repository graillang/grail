            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    fail(&mut c, view("unclosed block"));
    return start;
}
fn last_name<a, b>(c: (&a mut C), name: &b [u8], from: u64, to: u64) -> u64 {
    mut last = 0;
    if from != 0 {
        last = from - 1;
    }
    mut i = from;
    mut depth = 0;
    mut base = 0;
    mut pending = 0;
    mut hidden = 0;
    mut skip = 0;
    if from < c.toks.len() {
