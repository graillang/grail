// `for i in a..v.len() { .. v[i] .. }`: the body never names v except as v[..] or v.len(), so the
// length cannot change and v[i] is in bounds. Returns v's name, or empty when not provable.
fn len_bound_ahead<a, b>(c: (&a mut C), name: &b [u8]) -> u8[] {
    p := c.pos;
    if c.toks.len() < p + 7 {
        return u8[];
    }
    if (kind_at(&mut c, p) != 1) || (kind_at(&mut c, p + 1) != 46) || (kind_at(&mut c, p + 3) != 40) || (kind_at(&mut c, p + 4) != 41) || (kind_at(&mut c, p + 5) != 123) {
        return u8[];
    }
    method := tok_text(&mut c, p + 2);
    if !same(view(method), view("len")) {
        return u8[];
    }
    base := tok_text(&mut c, p);
    if find_local(&mut c, view(base)) == 0 {
        return u8[];
    }
    end := block_end(&mut c, p + 5);
    mut j = p + 6;
    while j < end {
        k := kind_at(&mut c, j);
        if (k == 124) || (k == 274) {
            return u8[];
        }
        if k == 1 {
            t := tok_text(&mut c, j);
            if same(view(t), view("for")) || same(view(t), view("mut")) {
                nt := tok_text(&mut c, j + 1);
                if same(view(nt), view(name)) || same(view(nt), view(base)) {
                    return u8[];
                }
            }
            if same(view(t), view(name)) {
                if kind_at(&mut c, j + 1) == 261 {
                    return u8[];
                }
            }
            if same(view(t), view(base)) {
                mut ok = 0;
                nk := kind_at(&mut c, j + 1);
                if nk == 91 {
                    ok = 1;
                }
                if (nk == 46) & (j + 5 < c.toks.len()) {
                    if (kind_at(&mut c, j + 3) == 40)
                        & (kind_at(&mut c, j + 4) == 41) {
                        m := tok_text(&mut c, j + 2);
                        if same(view(m), view("len")) {
                            ok = 1;
                        }
                    }
                }
                if j != 0 && ok != 0 {
                    pk := kind_at(&mut c, j - 1);
                    if (pk == 46) || (pk == 38) {
                        ok = 0;
                    }
                }
                if ok == 0 {
                    return u8[];
                }
            }
        }
        j += 1;
    }
    return base.copy();
}
// Whether `[ i ]` at the cursor indexes the proven base with the proven loop variable.
fn proven_index<a>(c: (&a mut C), value: Val) -> bool {
    if c.bce_index.len() == 0 {
        return false;
    }
    p := c.pos;
    if c.toks.len() < p + 3 {
        return false;
    }
    if (kind_at(&mut c, p + 1) != 1) || (kind_at(&mut c, p + 2) != 93) {
        return false;
    }
    t := tok_text(&mut c, p + 1);
    ix := c.bce_index.copy();
    if !same(view(t), view(ix)) {
        return false;
    }
    base := c.bce_base.copy();
    l := find_local(&mut c, view(base));
