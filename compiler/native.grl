    p := c.pos;
    text := decode_literal(borrow_mut(c), p);
    advance(borrow_mut(c));
    mut piece = u8[];
    mut i = 0;
    while i < text.len() {
        b := text[i];
        mut next = 0;
        if i + 1 < text.len() {
            next = text[i + 1];
        }
        if (b == 123) & (next == 123) {
            piece.push(123);
            i += 2;
            continue;
        }
        if (b == 125) & (next == 125) {
            piece.push(125);
            i += 2;
            continue;
        }
        if (b == 123) & (next == 58) {
            sp := parse_spec(borrow_mut(c), &text, i);
            format_raw(borrow_mut(c), acc, &piece);
            piece = u8[];
            end := sp.end;
            format_spec_arg(borrow_mut(c), acc, sp);
            i = end;
            continue;
        }
        if (b == 123) & (next == 125) {
            format_raw(borrow_mut(c), acc, &piece);
            piece = u8[];
            if eat(borrow_mut(c), &",") == 0 {
                fail(borrow_mut(c), &"missing argument for {} in format string");
            }
            input := expr(borrow_mut(c), 0);
            format_arg(borrow_mut(c), acc, input);
            i += 2;
            continue;
        }
        if (b == 123) + (b == 125) {
            fail(borrow_mut(c), &"unmatched brace in format string (use {{ or }})");
        }
        piece.push(b);
        i += 1;
    }
    format_raw(borrow_mut(c), acc, &piece);
    if is(borrow_mut(c), &",") {
        fail(borrow_mut(c), &"more arguments than {} placeholders in format string");
    }
    expect(borrow_mut(c), &")");
    slot := invoke(borrow_mut(c), &"rt_fmt_finish", one(acc));
    return own(borrow_mut(c), slot, 3);
}
fn format_raw<a, b>(c: (&a mut C), acc: u64, piece: &b [u8]) -> unit {
    if piece.len() == 0 {
        return ();
    }
    l := label(borrow_mut(c));
    o(borrow_mut(c), &".pushsection .rodata\n");
    mark(borrow_mut(c), l);
    for i in piece.len() {
        o(borrow_mut(c), &".byte ");
        on(borrow_mut(c), piece[i]);
        c.out.push(10);
    }
    o(borrow_mut(c), &".popsection\nleaq ");
    lname(borrow_mut(c), l);
    o(borrow_mut(c), &"(%rip),%rax\n");
    ptr := save(borrow_mut(c));
    n := imm(borrow_mut(c), piece.len());
    invoke(borrow_mut(c), &"rt_fmt_raw", three(acc, ptr, n));
    return ();
