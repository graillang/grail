            fail(
                borrow_mut(c),
                &"contains on vectors needs integer or bool elements (use vecs::contains for others)"
            );
        }
        vstart := c.pos;
        mut v = expr(borrow_mut(c), 0);
        vend := c.pos;
        expect(borrow_mut(c), &")");
        v = adopt_value(borrow_mut(c), v, vstart, vend, elem);
        require_type(borrow_mut(c), v.ty, elem);
        r := invoke(borrow_mut(c), &"rt_vec_contains", two(xt, v.t));
        release_temporary(borrow_mut(c), input);
        bt := bool_type(borrow_mut(c));
        return val(r, bt);
    }
    require_mutable_binding(borrow_mut(c), xt, 0);
    if same(&name, &"pop") {
        expect(borrow_mut(c), &")");
        mut ty = 0;
        if k == 6 {
            ty = ty_arg(borrow_mut(c), xty);
        }
        if c.raw == 0 {
            if (k != 3) & (k != 6) {
                fail(borrow_mut(c), &"pop requires bytes/vector");
            }
