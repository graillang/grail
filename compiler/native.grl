        call_out(&mut c, view("rt_abort"));
        mark(&mut c, nz);
        if signed != 0 {
            o(&mut c, view("movq %rax,%r10\nshrq $63,%r10\ntestq %r10,%r10\n"));
            pa := label(&mut c);
            jump(&mut c, view("jz"), pa);
            o(&mut c, view("movq $0,%rdx\nsubq %rax,%rdx\nmovq %rdx,%rax\n"));
            mark(&mut c, pa);
            o(&mut c, view("movq %rcx,%r11\nshrq $63,%r11\ntestq %r11,%r11\n"));
            pb := label(&mut c);
            jump(&mut c, view("jz"), pb);
            o(&mut c, view("movq $0,%rdx\nsubq %rcx,%rdx\nmovq %rdx,%rcx\n"));
            mark(&mut c, pb);
        }
        o(&mut c, view("xorq %rdx,%rdx\ndivq %rcx\n"));
        if k == 37 {
            o(&mut c, view("movq %rdx,%rax\n"));
            if signed != 0 {
                o(&mut c, view("testq %r10,%r10\n"));
                done := label(&mut c);
                jump(&mut c, view("jz"), done);
                o(&mut c, view("movq $0,%rdx\nsubq %rax,%rdx\nmovq %rdx,%rax\n"));
                mark(&mut c, done);
            }
        } else {
            if signed != 0 {
                o(&mut c, view("xorq %r11,%r10\ntestq %r10,%r10\n"));
                pos := label(&mut c);
                done := label(&mut c);
                jump(&mut c, view("jz"), pos);
                o(&mut c, view("movq $0,%rdx\nsubq %rax,%rdx\nmovq %rdx,%rax\n"));
                jump(&mut c, view("jmp"), done);
                mark(&mut c, pos);
