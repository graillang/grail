// Whether the type before the parser is `dyn I`: what `&dyn I` in a body borrows.
fn dyn_type_ahead<a>(c: (&a mut C)) -> bool {
    return is(&mut c, view("dyn")) && ((kind_at(&mut c, c.pos + 1) == 1) || (kind_at(&mut c, c.pos + 1) == 60));
}
// `*T` / `*mut T`: a raw pointer (kind 34, argument T, mode 1 when mutable). It is one word, Copy
// and has no drop; every operation on it needs an `unsafe` block (docs/design/unsafe.md).
// `**T` is the `**` token, a pointer to a pointer.
fn parse_raw_pointer<a>(c: (&a mut C)) -> u64 {
    if kind(&mut c) == 267 {
        advance(&mut c);
        inner := parse_type(&mut c);
        once := intern_full(&mut c, 34, inner, 0, u64[]);
        return intern_full(&mut c, 34, once, 0, u64[]);
    }
    expect(&mut c, view("*"));
    mode := u64(eat(&mut c, view("mut")));
    inner := parse_type(&mut c);
    return intern_full(&mut c, 34, inner, mode, u64[]);
}
fn parse_type_base<a>(c: (&a mut C)) -> u64 {
    if eat(&mut c, view("&")) {
        return parse_reference(&mut c);
