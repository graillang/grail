struct FormatSpec {
    precision: u64,
    width: u64,
    align: u64,
    zero: u64,
    fill: u64,
    end: u64
}
// {:[fill][<^>][0][width][.precision]} ; precision 18446744073709551615 = none.
fn parse_spec<a, b>(c: (&a mut C), text: &b [u8], start: u64) -> FormatSpec {
    mut i = start + 2;
    mut sp = FormatSpec {
        precision: 18446744073709551615,
        width: 0,
        align: 0,
        zero: 0,
        fill: 32,
        end: 0,
    };
    if i + 1 < text.len() {
        x := text[i + 1];
        if (x == 60) + (x == 62) + (x == 94) {
            if text[i] != 125 {
                sp.fill = text[i];
                i += 1;
            }
        }
    }
    if i < text.len() {
        x := text[i];
        if x == 60 {
            sp.align = 1;
            i += 1;
        } else {
            if x == 62 {
                sp.align = 2;
                i += 1;
            } else {
                if x == 94 {
                    sp.align = 3;
                    i += 1;
                }
            }
        }
    }
    if i < text.len() {
        if text[i] == 48 {
            sp.zero = 1;
            i += 1;
        }
    }
    while i < text.len() {
        d := text[i];
        if (d < 48) + (57 < d) {
            break;
        }
        sp.width = sp.width * 10 + d - 48;
        if 1000 < sp.width {
            fail(borrow_mut(c), &"format width too large");
        }
        i += 1;
    }
    if i < text.len() {
        if text[i] == 46 {
            i += 1;
            mut n = 0;
            mut any = 0;
            while i < text.len() {
                d := text[i];
                if (d < 48) + (57 < d) {
                    break;
                }
                n = n * 10 + d - 48;
                any = 1;
                if 300 < n {
                    fail(borrow_mut(c), &"format precision too large");
                }
                i += 1;
            }
            if any == 0 {
                fail(borrow_mut(c), &"bad format spec (expected {:.N})");
            }
            sp.precision = n;
        }
    }
    if (i < text.len()) == 0 {
        fail(borrow_mut(c), &"bad format spec (expected {:[fill][<^>][0][width][.precision]})");
    }
    if text[i] != 125 {
        fail(borrow_mut(c), &"bad format spec (expected {:[fill][<^>][0][width][.precision]})");
    }
    sp.end = i + 1;
    return sp;
}
// Formats the next argument per spec and appends it (padded) to acc.
fn format_spec_arg<a>(c: (&a mut C), acc: u64, sp: FormatSpec) -> unit {
    if eat(borrow_mut(c), &",") == 0 {
        fail(borrow_mut(c), &"missing argument for {} in format string");
