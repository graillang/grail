            mode := ty_mode(&mut c, formal);
            if mode != 0 && ty_mode(&mut c, inty) == 0 {
                fail(&mut c, view("method needs a mutable receiver but got a shared reference"));
            }
            refty := reference_type(&mut c, xty, mode);
            source := target_of(&mut c, input);
            get(&mut c, input, view("%rax"));
            slot := save(&mut c);
            r := borrow_reference(&mut c, slot, refty, input, source, mode);
