    hint := constructor_hint(&mut c, d, explicit);
    mut map = constructor_map(&mut c, d, hint);
    k := find_field(&mut c, d, name);
    mut payload = imm(&mut c, 0);
    mut source = 0;
    mut has = 0;
    if eat(&mut c, view("(")) {
        has = 1;
        start := c.pos;
        mut v = expr(&mut c, 0);
        end := c.pos;
        expected := field_ty(&mut c, d, k);
        infer_union_member(&mut c, expected, v.ty, &mut map);
        mut resolved = 1;
        for i in map.len() {
            if map[i] == NO_TYPE {
                resolved = 0;
            }
        }
        if resolved != 0 {
            target := bind_types(&mut c, expected, &map);
            v = adopt_value(&mut c, v, start, end, target);
        }
        infer_type(&mut c, expected, v.ty, &mut map);
        payload = v.t;
        source = place_of(&mut c, v.t);
        move_out(&mut c, v);
        expect(&mut c, view(")"));
    }
    if has == 0 {
        payloadtype := field_ty(&mut c, d, k);
        if payloadtype != 1 {
            fail(&mut c, view("variant requires payload"));
        }
    }
    tag := imm(&mut c, k);
    n := invoke(&mut c, view("rt_enum"), two(tag, payload));
    ty := constructed_type(&mut c, d, hint, map);
    own(&mut c, n, ty);
    root := place_of(&mut c, n);
    transfer_bonds(&mut c, source, root);
    return val(n, ty);
