// `(|x| x + 1)(41)`: the call written directly after a parenthesised closure fixes the closure's
// parameter types. The callee is parsed before the arguments, so they are typed ahead of time by
// compiling each one in isolation (isolated_body_type) and throwing the code away; the real call
// compiles them again with its own expected types. Nothing is set when the shape is not that, or
// when an argument is itself a closure - that one's type would need the callee's parameter type,
// which is what this is computing.
fn immediate_call_hint<a>(c: (&a mut C)) -> unit {
    open := c.pos;
    if kind_at(&mut c, open) != 40 {
        return ();
    }
    if (kind_at(&mut c, open + 1) != 124) & (kind_at(&mut c, open + 1) != 274) {
        return ();
    }
    close := matching_paren(&mut c, open);
    if close == 0 {
        return ();
    }
    call := close + 1;
    if kind_at(&mut c, call) != 40 {
        return ();
    }
    stop := matching_paren(&mut c, call);
    if stop == 0 {
        return ();
    }
    mut at = call + 1;
    mut types = u64[];
    while at < stop {
        if (kind_at(&mut c, at) == 124) | (kind_at(&mut c, at) == 274) {
            return ();
        }
        mut no_names = u8[][];
        mut no_params = u64[];
        found := isolated_body_type(&mut c, at, &no_names, &no_params);
        // A parameter type that holds a borrow needs the closure's own input lifetime, which the
        // caller's argument type cannot supply: leave the hint unset and let the annotation error
        // name the parameter (`|v: &[u8]|` is written out for exactly this reason).
        if contains_borrow(&mut c, found[0], 0) {
            return ();
        }
        types.push(found[0]);
        at = found[1];
        if at < stop {
            if kind_at(&mut c, at) != 44 {
                return ();
            }
            at += 1;
        }
    }
    exchange(&mut c.hint_params, types);
    exchange(&mut c.hint_ret, 18446744073709551615);
    exchange(&mut c.hint_set, 1);
    return ();
}
// The index of the `)` that closes the `(` at `open`, or 0 when the source never closes it.
fn matching_paren<a>(c: (&a mut C), open: u64) -> u64 {
    mut depth = 0;
    mut j = open;
    while kind_at(&mut c, j) != 0 {
        k := kind_at(&mut c, j);
        if k == 40 {
            depth += 1;
        }
        if k == 41 {
            depth -= 1;
            if depth == 0 {
                return j;
            }
        }
        j += 1;
    }
    return 0;
}
fn closure_literal<a>(c: (&a mut C)) -> Val {
    // Inside a generic function the closure is compiled once per specialization, with its bindings.
    if (c.tnames.len() != 0) & (c.bindings.len() == 0) & (c.validating == 0) {
        fail(&mut c, view("closures inside generic functions are not supported here"));
    }
    hinted := exchange(&mut c.hint_set, 0) != 0;
    hint_params := exchange(&mut c.hint_params, u64[]);
    hint_ret := exchange(&mut c.hint_ret, NO_TYPE);
    mut names = u8[][];
    mut params = u64[];
    mut param_regions = 0;
