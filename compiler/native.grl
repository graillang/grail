    return ();
}
fn frame_storage<a>(c: (&a mut C), slot: u64, destination: u64) -> unit {
    root := place_of(&mut c, slot);
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        guard := b.guard;
        loan := b.loan;
