// A generic function's result may carry the lifetimes of its type arguments (Rust's rule for a
// returned `impl Trait`): `map(refs(&v), f)` returns an `Iter<u64>` whose closure still reads `v`.
// So the result holds the loans of every argument whose actual type carries one of them, and `v`
// stays borrowed while the result lives (validate_return allows the same lifetimes).
fn captured_bonds<a, b, d, e>(c: (&a mut C), result: Val, map: (&b u64[]), sources: (&d u64[]), argtypes: (&e u64[])) -> unit {
    if (c.raw != 0) || (map.len() == 0) {
        return ();
    }
    // Only when a type argument holds a borrow: otherwise the result can carry none.
    mut borrowed = false;
    for i in map.len() {
        if map[i] != NO_TYPE {
            t := map[i];
            if contains_borrow(&mut c, t, 0) {
                borrowed = true;
            }
        }
    }
    if !borrowed {
        return ();
    }
    holder := place_of(&mut c, result.t);
    if holder == 0 {
        return ();
    }
    aggregate := ty_kind(&mut c, result.ty) != 5;
    for i in sources.len() {
        if i < argtypes.len() {
            t := argtypes[i];
            // A reference argument is lent for the call only; what it points at is the caller's.
                    if (ty_kind(&mut c, t) != 7) && contains_borrow(&mut c, t, 0) {
                source := place_of(&mut c, sources[i]);
                if source != 0 {
                    return_bonds(&mut c, source, holder, u64(aggregate));
                }
            }
        }
    }
    return ();
}
fn specialized_function_value<a>(c: (&a mut C), index: u64, map: u64[]) -> Val {
    // A foreign declaration names a C symbol, not a Grail callable: its address
    // type is a C function pointer, which is a separate (later) increment. Refuse
    // rather than manufacture a Grail function value with a mangled name.
    foreign := c.funcs[index].ext;
    if foreign != 0 {
        fail(&mut c, view("extern C declarations are not Grail function values"));
    }
    f := &c.funcs[index];
    types := f.types;
    raw := f.raw;
    first := f.first;
    count := f.count;
    ret := f.ret;
    m := f.module.copy();
    name := f.name.copy();
    contract := f.contract;
    if raw != 0 && c.raw == 0 {
        fail(&mut c, view("unsafe runtime function cannot be a safe callable value"));
    }
    if map.len() != types {
        fail(&mut c, view("function value type argument count"));
    }
    for i in map.len() {
        if map[i] == NO_TYPE {
            fail(&mut c, view("generic function values need explicit type arguments"));
        }
    }
    require_constraints(&mut c, &map, &function_bounds(&c, index));
    require_interfaces(&mut c, &map, &function_constraints(&c, index));
    require_assoc_eqs(&mut c, index, &map);
    mut params = u64[];
    for i in count {
        bound := bind_types(&mut c, c.params[first + i], &map);
        params.push(bound);
    }
    result := bind_types(&mut c, ret, &map);
    ty := intern_args(&mut c, 12, result, 0, u64[], params);
    if c.validating != 0 {
        return val(imm(&mut c, 0), ty);
    }
    if contract != 0 {
        self := map[0];
        actual := resolve_interface_method(&mut c, contract, self, view(name));
        module := c.funcs[actual].module.copy();
        mut own = u64[];
        for k in 1..map.len() {
            own.push(map[k]);
        }
        symbol := interface_symbol(&mut c, contract, self, actual, &own);
        o(&mut c, view("leaq "));
        mangle(&mut c, view(module), view(symbol));
        o(&mut c, view("(%rip),%rax\n"));
        return val(save(&mut c), ty);
    }
    spec := specialize(&mut c, index, &map);
    symbol := special_name(&mut c, spec);
    o(&mut c, view("leaq "));
    mangle(&mut c, view(m), view(symbol));
    o(&mut c, view("(%rip),%rax\n"));
    return val(save(&mut c), ty);
}
fn function_value<a>(c: (&a mut C), index: u64) -> Val {
    // A foreign *declaration* is a C symbol, not a Grail callable, so it cannot
    // become a mangled address. An `extern "C" fn` *definition* is C-callable and
    // yields a `cfn` value: its symbol is already the C name.
    foreign := c.funcs[index].ext;
    if foreign == 1 {
        fail(&mut c, view("extern C declarations are not Grail function values"));
    }
    f := &c.funcs[index];
    types := f.types;
    raw := f.raw;
    first := f.first;
    count := f.count;
    result := f.ret;
    m := f.module.copy();
    name := f.name.copy();
    symbol := f.symbol.copy();
    if types != 0 {
        fail(
            &mut c,
            view("generic function values need explicit type arguments (for example identity<u64>)")
        );
    }
    if raw != 0 && c.raw == 0 {
        fail(&mut c, view("unsafe runtime function cannot be a safe callable value"));
    }
    mut params = u64[];
    for i in count {
        params.push(c.params[first + i]);
    }
    mut value_kind = 12;
    if foreign == 2 {
        value_kind = 25;
    }
    ty := intern_args(&mut c, value_kind, result, 0, u64[], params);
    o(&mut c, view("leaq "));
    if foreign == 2 {
        o(&mut c, view(symbol));
    } else {
        mangle(&mut c, view(m), view(name));
    }
    o(&mut c, view("(%rip),%rax\n"));
    return val(save(&mut c), ty);
}
// A function value used where a closure type `Fn(...)` is expected (Rust/Zig let any function be
// passed as a callable): a capture-free closure object {code, drop, target} whose code is the
// shared adapter `grail_fn_thunk` (emitted once, see emit_fn_thunk). The signatures must match up to
// renaming of lifetimes, so `fn less<a, b>(x: (&a T), y: (&b T))` is an `Fn(&T, &T) -> bool`.
fn function_as_closure<a>(c: (&a mut C), v: Val, expected: u64) -> Val {
    params := type_args(&mut c, v.ty);
    result := ty_arg(&mut c, v.ty);
    mode := ty_mode(&mut c, expected);
    as_closure := intern_args(&mut c, 20, result, mode, u64[], params);
    if same_type(&mut c, as_closure, expected) == 0 {
        return v;
    }
    decl := fn_value_decl(&mut c);
    record := intern_args(&mut c, 8, decl, 0, u64[], u64[]);
    sz := imm(&mut c, 3);
    obj := invoke(&mut c, view("rt_rec"), one(sz));
    o(&mut c, view("leaq grail_fn_thunk(%rip),%rax\n"));
    code := save(&mut c);
    rec_store(&mut c, obj, 0, code);
    o(&mut c, view("leaq "));
    drop_name(&mut c, record);
    o(&mut c, view("(%rip),%rax\n"));
    dropper := save(&mut c);
    rec_store(&mut c, obj, 1, dropper);
    rec_store(&mut c, obj, 2, v.t);
    exchange(&mut c.fn_thunk_used, 1);
    own(&mut c, obj, expected);
    return val(obj, expected);
}
// The record type of a function's closure object: {__code, __drop, target}, created once.
fn fn_value_decl<a>(c: (&a mut C)) -> u64 {
    for i in c.decls.len() {
        d := &c.decls[i];
        if same(view(d.module), view(".closure")) & same(view(d.name), view("FnValue")) {
            return i;
        }
    }
    first := c.fields.len();
    c.fields.push(Field { name: copy_bytes(view("__code")), ty: 0, pred: no_pred() });
    c.fields.push(Field { name: copy_bytes(view("__drop")), ty: 0, pred: no_pred() });
    c.fields.push(Field { name: copy_bytes(view("target")), ty: 0, pred: no_pred() });
    item_public_11 := c.decl_public;
    c
        .decls
        .push(
            Decl {
                public: item_public_11,
                module: copy_bytes(view(".closure")),
                name: copy_bytes(view("FnValue")),
                is_enum: 0,
                opaque: 0,
                transfer: 0,
                share: 0,
                c_layout: 0,
                first: first,
                count: 3,
                drop: 0,
                regions: 0,
                types: 0,
                success: 0,
                bounds: u64[],
                constraints: u64[][],
            }
        );
    return c.decls.len() - 1;
}
// The adapter every function-as-closure calls: %rdi addresses the slot holding the object; the
// function's own arguments follow in %rsi.. (Fn types take at most five), so they shift down one
// register and the target is called; its result returns unchanged.
fn emit_fn_thunk<a>(c: (&a mut C)) -> unit {
    if c.fn_thunk_used == 0 {
        return ();
    }
    part(&mut c, view("runtime"));
    if own_object(&c) {
        o(&mut c, view(".globl grail_fn_thunk\n"));
    }
    o(&mut c, view("grail_fn_thunk:\npushq %rbp\nmovq %rsp,%rbp\nmovq (%rdi),%rax\nmovq 16(%rax),%rax\n"));
    o(&mut c, view("movq %rsi,%rdi\nmovq %rdx,%rsi\nmovq %rcx,%rdx\nmovq %r8,%rcx\nmovq %r9,%r8\ncall *%rax\nleave\nret\n"));
    return ();
}
// Calling an `FnMut` value needs exclusive access to the closure: its environment is reachable
// only through that value, so a second call (or a live shared borrow of the closure) would alias
// what the first one writes. The loan is taken on the closure's own storage and ends when the call
// returns; bonding it to that storage keeps `close_loans` from ending it early while the arguments
// are evaluated.
fn call_access<a>(c: (&a mut C), slot: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    place := place_of(&mut c, slot);
    if place == 0 {
        return 0;
    }
    authority := authority_of(&mut c, slot);
    mut loan = 0;
    if authority != 0 {
        parent := authority_loan(&mut c, authority, place);
        if parent == 0 {
            fail(&mut c, view("closure call has no live reference authority"));
        }
        loan = ownership::reborrow_place(&mut c.check, parent, place, 1);
    } else {
        loan = ownership::borrow_place(&mut c.check, place, 1);
    }
    if loan == 0 {
        fail(
            &mut c,
            view("calling a FnMut closure needs exclusive access to the closure: it is already borrowed or being called")
        );
    }
    bond(&mut c, place, loan);
    return loan;
}
// A shared read succeeds while a shared loan lives, so an exclusive loan on the closure (a live
// `&mut f`, or an enclosing call of the same closure) is what a call has to reject here: say which.
fn call_conflict<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    if authority_of(&mut c, slot) != 0 {
        return ();
    }
    if ownership::read(&c.check, place) == 3 {
        fail(
            &mut c,
            view("calling a FnMut closure needs exclusive access to the closure: it is already borrowed or being called")
        );
    }
    return ();
}
// The binding that holds an `FnMut` closure must itself be exclusive: `mut f = |...|` for a local,
// a `&mut` reference for a value reached through one.
fn require_exclusive_call<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if binding_mode(&c, slot) == 1 {
        fail(
            &mut c,
            view("calling a FnMut closure needs a mutable binding (write: mut f = |...| { ... })")
        );
    }
    require_mutable_binding(&mut c, slot, 0);
    return ();
}
