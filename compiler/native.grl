 for i in n{var b =vec_get(c.bonds,i);old :=b.loan;h :=b.holder;guard :=b.guard;if (h==owner)&(guard!=0){bond_kind(borrow_mut(c),holder,old,1);}
 if (h==owner)&(old!=parent)&(guard==0){if loan_live(borrow_mut(c),old){
 extra :=ownership::reborrow(borrow_mut(c.check),old,mode);if extra==0{fail(borrow_mut(c),read("ambiguous reborrow lacks authority"));}bond(borrow_mut(c),holder,extra);}}}
 }else{loan=ownership::borrow_place(borrow_mut(c.check),target,mode);}
 if loan==0{fail(borrow_mut(c),read("borrow conflicts with active access"));}
