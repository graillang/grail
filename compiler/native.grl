// ---- capturing closures: `|x: T, ...| -> R body`, type Fn(T,...)->R (kind 20) ----
// The value is an owned record {code, dropper, captures...}. Scalars are copied into it and owned
// values moved; a direct reference or view (`&T`, `&[T]`, `&mut T`) moves in as well, pointer and
// loan together, so the closure's type carries the regions it borrows and it cannot outlive them.
// The body is compiled afterwards as a separate function whose hidden first parameter is a shared
// reference to that record, so captures are read-only fields (no mutation, no moving out).
fn closure_free_name<a, b>(c: (&a mut C), name: &b [u8], params: (&a u8[][])) -> bool {
    for i in params.len() {
        p := &params[i];
        if same(view(p), view(name)) {
            return false;
        }
    }
    return true;
}
// A capture that is itself a reference or view: the pointer moves into the environment and the
// loan moves with it. Aggregates that merely contain a borrow keep their own layout and dropper, so
// they are rejected rather than silently copied.
fn capture_borrow<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        return true;
    }
    if contains_borrow(&mut c, ty, 0) {
        fail(
            &mut c,
            view("closures can capture owned values and direct references, not a struct or enum holding a borrow")
        );
    }
    return false;
}
// The lifetime a captured reference actually borrows: the region of the place its live loan reads.
// A local source has region 0, which no closure type may carry out of the function.
fn capture_region<a>(c: (&a mut C), slot: u64) -> u64 {
    place := place_of(&mut c, slot);
    if place == 0 {
        return 0;
    }
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if (holder == place) & (guard == 0) {
            if loan_live(&mut c, loan) != 0 {
                mut l = &c.check.loans[loan - 1];
                source := l.source;
                return region_of(&mut c, source);
            }
        }
    }
    return 0;
