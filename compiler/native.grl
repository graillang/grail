                    index := params.len();
                    if !hinted || (hint_params.len() <= index) || (hint_params[index] == NO_TYPE) {
                        // Name the parameter and show the annotation: nothing at this position fixes
                        // its type, and a later use cannot (a closure's parameters are explicit).
                        mut text = copy_bytes(view("closure parameter `"));
                        push_bytes(&mut text, view(n));
                        push_bytes(&mut text, view("` needs a type here (nothing fixes it): write |"));
                        push_bytes(&mut text, view(n));
