        }
        if tuple_ahead(&mut c) {
            // `(a, b)`: a tuple, built as its record with the elements in field order.
            mut count = 0;
            mut depth = 0;
            mut q = c.pos;
            mut bars = 0;
            while q < c.toks.len() {
                kk := kind_at(&mut c, q);
                if (kk == 40) || (kk == 91) || (kk == 123) {
                    depth += 1;
                } else if (kk == 41) || (kk == 93) || (kk == 125) {
                    depth -= 1;
                    if depth == 0 {
                        if kind_at(&mut c, q - 1) != 44 {
                            count += 1;
                        }
                        break;
                    }
                } else if (kk == 124) && (depth == 1) {
                    bars += 1;
                } else if (kk == 44) && (depth == 1) && (bars % 2 == 0) {
                    count += 1;
                }
                q += 1;
            }
            d := tuple_decl(&mut c, count);
            exchange(&mut c.positional, 1);
            return record(&mut c, d, NO_TYPE);
        }
        advance(&mut c);
        if eat(&mut c, view(")")) {
            return val(imm(&mut c, 0), 1);
        }
        mut v = expr(&mut c, 0);
        expect(&mut c, view(")"));
        return v;
    }
    if k == 3 {
        return string_lit(&mut c);
    }
    if k == 5 {
        // Decimal text is converted to the nearest double (ties to even) with exact arithmetic.
        p := c.pos;
        t := tok_text(&mut c, p);
        advance(&mut c);
        l := label(&mut c);
        // 2.5f32 / 2.5f64: an adjacent suffix fixes the type; a bare literal may adopt f32 later.
        mut precision = 53;
        mut suffixed = 0;
        if kind(&mut c) == 1 {
            here := &c.toks[p];
            fend := here.end;
            q := c.pos;
            next := &c.toks[q];
            fstart := next.start;
            if fstart == fend {
                suffix := tok_text(&mut c, q);
                if same(view(suffix), view("f32")) {
                    precision = 24;
                    suffixed = 1;
                }
                if same(view(suffix), view("f64")) {
                    suffixed = 1;
                }
                if suffixed != 0 {
                    advance(&mut c);
                }
            }
        }
        bits := float_bits_p(&mut c, view(t), precision);
        if suffixed == 0 {
            exchange(&mut c.flit_start, p);
            exchange(&mut c.flit_end, c.pos);
            exchange(&mut c.flit_tok, p);
            exchange(&mut c.flit_neg, 0);
        }
        rodata(&mut c);
        o(&mut c, view(".balign 8\n"));
        mark(&mut c, l);
        o(&mut c, view(".quad "));
        on(&mut c, bits);
        o(&mut c, view("\n.popsection\nleaq "));
        lname(&mut c, l);
        o(&mut c, view("(%rip),%rax\nmovq (%rax),%rax\n"));
        mut ty = float_type(&mut c);
        if precision == 24 {
            ty = f32_type(&mut c);
        }
        return val(save(&mut c), ty);
    }
    if k == 4 {
        // ASCII character literals are untyped byte values (like Rust's b'a') that adopt char
        // contexts; any other character literal is a char.
        p := c.pos;
        value := char_literal(&mut c, p);
        advance(&mut c);
        slot := imm(&mut c, value);
        exchange(&mut c.lit_start, p);
        exchange(&mut c.lit_end, c.pos);
        exchange(&mut c.lit_value, value);
        exchange(&mut c.lit_negative, 0);
        if 127 < value {
            ty := char_type(&mut c);
            return val(slot, ty);
        }
        return val(slot, 0);
    }
    if k == 2 {
        p := c.pos;
        t := tok_text(&mut c, p);
        advance(&mut c);
        value := literal_value(&mut c, view(t));
        o(&mut c, view("movabsq $"));
        on(&mut c, value);
        o(&mut c, view(",%rax\n"));
        slot := save(&mut c);
        // A type suffix written without a space (200u8, 7i32) fixes the literal's type.
        if kind(&mut c) == 1 {
            here := &c.toks[p];
            end := here.end;
            q := c.pos;
            next := &c.toks[q];
            start := next.start;
            if start == end {
                suffix := tok_text(&mut c, q);
                named := int_name(view(suffix));
                if named != 0 {
                    advance(&mut c);
                    ty := int_type_named(&mut c, named);
                    if literal_fits(&mut c, ty, value, 0) == 0 {
                        fail(&mut c, view(literal_range_msg_v(&mut c, ty, value, 0)));
                    }
                    return val(slot, ty);
