            require_mutable_binding(borrow_mut(c), xt, 0);
        }
        mut f = "rt_slot";
        if unchecked {
            f = "rt_slotu";
        }
        ty := reference_type(borrow_mut(c), elem, access == 2);
        slot := apply(borrow_mut(c), &f, two(xt, index));
        root := place_of(borrow_mut(c), xt);
        target := member_place(borrow_mut(c), root, 0, elem);
        own(borrow_mut(c), slot, ty);
        bind_loan(borrow_mut(c), slot, xt, root, access == 2);
        set_target(borrow_mut(c), slot, target, slot + 1);
        if (access == 0) & scalar(borrow_mut(c), elem) {
            get(borrow_mut(c), slot, &"%rax");
            o(borrow_mut(c), &"movq (%rax),%rax\n");
            result := save(borrow_mut(c));
            release_temporary(borrow_mut(c), slot);
            return val(result, elem);
        }
        return val(slot, ty);
    }

    if c.raw == 0 {
        k := ty_kind(borrow_mut(c), x.ty);
        if (k != 3) & (k != 4) & (k != 5) {
            fail(borrow_mut(c), &"index/slice requires byte sequence/view");
