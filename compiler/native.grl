                }
                from := int_code(&mut c, source);
                fv := imm(&mut c, from);
                // At most 32 bits is exact in binary64, so converting and then rounding rounds once.
                // A wider source could round twice that way; the runtime rounds it once.
                if float_inline(&c) && ((from & 255) <= 32) {
