fn collection_literal<a>(c: (&a mut C), ty: u64, bytes: u64) -> Val {
    expect(borrow_mut(c), &"[");
    slot := apply(borrow_mut(c), &"rt_new", u64[]);
    own(borrow_mut(c), slot, ty);
    if eat(borrow_mut(c), &"]") == 0 {
        while 1 {
            estart := c.pos;
            mut v = expr(borrow_mut(c), 0);
            eend := c.pos;
            if c.raw == 0 {
                mut expected = 0;
                if bytes == 0 {
                    expected = ty_arg(borrow_mut(c), ty);
                }
                v = adopt_value(borrow_mut(c), v, estart, eend, expected);
                require_type(borrow_mut(c), v.ty, expected);
                if bytes != 0 {
                    lit := (c.lit_start == estart) & (c.lit_end == eend);
                    if lit & (c.lit_value > 255) {
                        fail(borrow_mut(c), &"integer literal out of range for u8");
                    }
                }
            }
            value := v.t;
            source := place_of(borrow_mut(c), value);
            move_out(borrow_mut(c), val(value, v.ty));
            mut f = "rt_push";
            if bytes {
                f = "rt_pushb";
            }
            invoke(borrow_mut(c), &f, two(slot, value));
            target := place_of(borrow_mut(c), slot);
            transfer_bonds(borrow_mut(c), source, target);
            if eat(borrow_mut(c), &"]") {
                break;
            }
            expect(borrow_mut(c), &",");
            if eat(borrow_mut(c), &"]") {
                break;
            }
        }
    }
    return val(slot, ty);
}
// `&place` and `&mut place` create typed references; indexing still returns element refs.
fn reference_borrow<a>(c: (&a mut C), write: u64) -> Val {
    if borrow_place_ahead(borrow_mut(c)) == 0 {
        return borrow_temporary(borrow_mut(c), write);
    }
    mut v = place(borrow_mut(c), write);
    if is(borrow_mut(c), &"[") {
        v = index_view(borrow_mut(c), v, 1 + write);
    }
    return v;
}
// Prefix byte-view borrowing binds tighter than binary operators.
fn view_borrow<a>(c: (&a mut C)) -> Val {
    advance(borrow_mut(c));
    write := eat(borrow_mut(c), &"mut");
    a := primary(borrow_mut(c));
    if kind(borrow_mut(c)) == 91 {
        return index_view(borrow_mut(c), a, 1 + write);
    }
    input := a.t;
    x := deref(borrow_mut(c), a);
    xt := x.t;
    if c.raw == 0 {
        k := ty_kind(borrow_mut(c), x.ty);
        if (k != 3) & (k != 4) & (k != 5) {
            fail(borrow_mut(c), &"byte borrow requires sequence/view");
        }
        if write {
            require_mutable_binding(borrow_mut(c), xt, 0);
            if k == 4 {
                fail(borrow_mut(c), &"string bytes cannot be mutably borrowed");
            }
        }
    }
    ty := intern_full(borrow_mut(c), 5, 0, write, u64[]);
    slot := apply(borrow_mut(c), &"rt_view", one(xt));
    own(borrow_mut(c), slot, ty);
    view_bonds(borrow_mut(c), slot, xt, write);
    release_temporary(borrow_mut(c), input);
    return val(slot, ty);
}
fn after_next_kind<a>(c: (&a mut C)) -> u64 {
    p := c.pos;
    return kind_at(borrow_mut(c), p + 2);
}
fn simple_type_head<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    n := name.copy();
    if int_name(&n) != 0 {
        return true;
    }
    if same(&n, &"u64") {
        return true;
    }
    if same(&n, &"fn") {
        return true;
    }
    if same(&n, &"Fn") {
        return true;
    }
    if same(&n, &"bool") {
        return true;
    }
    if same(&n, &"f64") {
        return true;
    }
    if same(&n, &"f32") {
        return true;
    }
    if same(&n, &"char") {
        return true;
    }
    if same(&n, &"string") {
        return true;
    }
    if same(&n, &"unit") {
        return true;
    }
    if same(&n, &"Mutex") {
        return true;
    }
    if same(&n, &"Atomic") {
        return true;
    }
    if same(&n, &"Scope") {
        return true;
    }
    if same(&n, &"Task") {
        return true;
    }
    if same(&n, &"CancelToken") {
        return true;
    }
    if same(&n, &"read") {
        return true;
    }
    if same(&n, &"Self") & ((c.self_type != 0)) {
        return true;
    }
    for i in c.tnames.len() {
        t := &c.tnames[i];
        if same(&t, &n) {
            return true;
        }
    }
    return false;
}
// `Name[` or `Name<...>[` in expression position: a type-first collection literal.
fn type_literal_ahead<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    p := c.pos;
    if kind_at(borrow_mut(c), p) == 60 {
        mut depth = 0;
        mut q = p;
        while q < c.toks.len() {
            k := kind_at(borrow_mut(c), q);
            if k == 60 {
                depth += 1;
            }
            if k == 62 {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }
            q += 1;
        }
        if kind_at(borrow_mut(c), q + 1) != 91 {
            return false;
        }
    } else {
        if kind_at(borrow_mut(c), p) != 91 {
            return false;
        }
    }
    n := name.copy();
    if find_local(borrow_mut(c), &n) != 0 {
        return false;
    }
    if simple_type_head(borrow_mut(c), &n) {
        return true;
    }
    m := module_copy(borrow_mut(c));
    return find_decl(borrow_mut(c), &m, &n) != 0;
}
fn finish_type_literal<a>(c: (&a mut C), ty: u64) -> Val {
    mut out = ty;
    while is(borrow_mut(c), &"[") {
        here := c.pos + 1;
        if kind_at(borrow_mut(c), here) != 93 {
            break;
        }
        advance(borrow_mut(c));
        advance(borrow_mut(c));
        out = vec_of(borrow_mut(c), out);
    }
    if is(borrow_mut(c), &"[") {
        mut cty = vec_of(borrow_mut(c), out);
        return collection_literal(borrow_mut(c), cty, (cty == 2));
    }
    slot := apply(borrow_mut(c), &"rt_new", u64[]);
    own(borrow_mut(c), slot, out);
    return val(slot, out);
}
// Maps remain ordinary nominal library values; only their concise surface is compiler-owned.
fn is_map_type<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 18446744073709551615 {
        return 0;
    }
    if ty_kind(borrow_mut(c), ty) != 8 {
        return 0;
    }
    d := ty_arg(borrow_mut(c), ty);
    item := &c.decls[d];
    return same(&item.module, &"hashmap") & same(&item.name, &"Map");
}
fn map_call<a, b>(c: (&a mut C), name: &b [u8], ty: u64, values: Val[]) -> Val {
    f := find_func(borrow_mut(c), &"hashmap", name);
    if f == 0 {
        fail(borrow_mut(c), &"map operation needs its standard library helper");
    }
    mut types = type_args(borrow_mut(c), ty);
    info := &c.funcs[f - 1];
    first := info.first;
    count := info.count;
    if count != values.len() {
        fail(borrow_mut(c), &"map helper argument count");
    }
    mut args = u64[];
    mut actuals = u64[];
    mut sources = u64[];
    for i in values.len() {
        v := val(values[i].t, values[i].ty);
        formal := c.params[first + i];
        expected := bind_types(borrow_mut(c), formal, borrow(types));
        require_type(borrow_mut(c), v.ty, expected);
        if ty_kind(borrow_mut(c), v.ty) == 7 {
            observe(borrow_mut(c), v.t);
        }
        held := move_value(borrow_mut(c), v);
        args.push(held.t);
        actuals.push(held.ty);
        sources.push(held.t);
    }
    return emit_resolved_call(borrow_mut(c), f, types, args, actuals, sources);
}
fn map_new<a>(c: (&a mut C), ty: u64) -> Val {
    first := invoke(borrow_mut(c), &"rt_random_seed", u64[]);
    second := invoke(borrow_mut(c), &"rt_random_seed", u64[]);
    mut args = Val[];
    args.push(val(first, 0));
    args.push(val(second, 0));
    return map_call(borrow_mut(c), &"with_seed", ty, args);
}
fn context_value<a>(c: (&a mut C), expected: u64) -> Val {
    start := c.pos;
    mut v = expr_expected(borrow_mut(c), 0, expected);
    end := c.pos;
    if expected != 18446744073709551615 {
        v = adopt_value(borrow_mut(c), v, start, end, expected);
        require_type(borrow_mut(c), v.ty, expected);
    } else {
        if (c.none_start == start) & (c.none_end == end) {
            fail(borrow_mut(c), &"map literal optional needs an expected type");
        }
        if (c.default_u64 == 0) & (c.lit_start == start) & (c.lit_end == end) & (v.ty == 0) {
            v = val(v.t, int_type(borrow_mut(c), 64, 1));
        }
    }
    return v;
}
fn map_literal_insert<a>(c: (&a mut C), map: Val, key: Val, value: Val) -> unit {
    receiver := place_slot(borrow_mut(c), map.t, map.ty, 1);
    mut args = Val[];
    args.push(receiver);
    args.push(key);
    args.push(value);
    old := map_call(borrow_mut(c), &"map_insert", map.ty, args);
    r := resource(borrow_mut(c), old.t);
    if r != 0 {
        release(borrow_mut(c), r - 1);
    }
    close_loans(borrow_mut(c));
    return ();
}
fn map_expression<a>(c: (&a mut C), expected: u64) -> Val {
    // A type-headed constructor is identified by its following () or ::, not capitalization.
    mut q = c.pos;
    mut depth = 0;
    while q < c.toks.len() {
        k := kind_at(borrow_mut(c), q);
        if k == 91 {
            depth += 1;
        }
        if k == 93 {
            depth -= 1;
            if depth == 0 {
                break;
            }
        }
        if k == 0 {
            fail(borrow_mut(c), &"unclosed map expression");
        }
        q += 1;
    }
    following := kind_at(borrow_mut(c), q + 1);
    if (following == 40) + (following == 260) {
        ty := parse_type(borrow_mut(c));
        if is_map_type(borrow_mut(c), ty) == 0 {
            fail(borrow_mut(c), &"map constructor needs [K: V]");
        }
        if eat(borrow_mut(c), &"::") {
            name := ident(borrow_mut(c));
            if same(&name, &"with_seed") == 0 {
                fail(borrow_mut(c), &"unknown map constructor");
            }
            expect(borrow_mut(c), &"(");
            first := context_value(borrow_mut(c), 0);
            expect(borrow_mut(c), &",");
            second := context_value(borrow_mut(c), 0);
            expect(borrow_mut(c), &")");
            mut args = Val[];
            args.push(first);
            args.push(second);
            return map_call(borrow_mut(c), &"with_seed", ty, args);
        }
        expect(borrow_mut(c), &"(");
        expect(borrow_mut(c), &")");
        return map_new(borrow_mut(c), ty);
    }
    expect(borrow_mut(c), &"[");
    mut ty = expected;
    mut keyty = 18446744073709551615;
    mut valuety = 18446744073709551615;
    if is_map_type(borrow_mut(c), ty) {
        types := type_args(borrow_mut(c), ty);
        keyty = types[0];
        valuety = types[1];
    } else {
        if expected != 18446744073709551615 {
            fail(borrow_mut(c), &"map literal needs a map expected type");
        }
    }
    if eat(borrow_mut(c), &":") {
        expect(borrow_mut(c), &"]");
        if keyty == 18446744073709551615 {
            fail(borrow_mut(c), &"empty map [:] needs a map expected type");
        }
        return map_new(borrow_mut(c), ty);
    }
    key := context_value(borrow_mut(c), keyty);
    expect(borrow_mut(c), &":");
    value := context_value(borrow_mut(c), valuety);
    if keyty == 18446744073709551615 {
        keyty = key.ty;
        valuety = value.ty;
        mut types = u64[];
        types.push(keyty);
        types.push(valuety);
        ty = named_type(borrow_mut(c), copy_bytes(&"hashmap"), copy_bytes(&"Map"), types);
    }
    map := map_new(borrow_mut(c), ty);
    map_literal_insert(borrow_mut(c), val(map.t, map.ty), key, value);
    while eat(borrow_mut(c), &",") {
        if is(borrow_mut(c), &"]") {
            break;
        }
        nextkey := context_value(borrow_mut(c), keyty);
        expect(borrow_mut(c), &":");
        nextvalue := context_value(borrow_mut(c), valuety);
        map_literal_insert(borrow_mut(c), val(map.t, map.ty), nextkey, nextvalue);
    }
    expect(borrow_mut(c), &"]");
