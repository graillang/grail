 result :=c.result;var rs =type_caps(borrow_mut(c),result,0);var found=0;
 for i in len(c.bonds){var b =vec_get(c.bonds,i);holder :=b.holder;loan :=b.loan;
 if ownership::ancestor(borrow(c.check),place,holder){if loan_live(borrow_mut(c),loan){
 var l =vec_get(c.check.loans,loan-1);source :=l.source;region :=region_of(borrow_mut(c),source);var allowed=0;
 for j in len(rs){if load(vec_get(rs,j))==region{allowed=1;}}
