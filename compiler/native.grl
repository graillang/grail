// `p.read()`: the pointee loaded at its natural width, the same instruction raw_load and friends
// emit for the intrinsic of that width. A float pointee is refused rather than reinterpreted.
fn ptr_load<a>(c: (&a mut C), address: u64, pointee: u64) -> u64 {
    width := ptr_width(&mut c, pointee);
    get(&mut c, address, view("%rax"));
    if width == 8 {
        o(&mut c, view("movq (%rax),%rax\n"));
    }
    if width == 4 {
        o(&mut c, view("movl (%rax),%eax\n"));
    }
    if width == 2 {
        o(&mut c, view("movzwl (%rax),%eax\n"));
    }
    if width == 1 {
        o(&mut c, view("movzbq (%rax),%rax\n"));
    }
    return save(&mut c);
}
// `p.write(v)`: the pointee stored at its natural width, with no drop of what was there - the same
// contract as Rust's `ptr::write`.
fn ptr_store<a>(c: (&a mut C), address: u64, v: u64, pointee: u64) -> unit {
    width := ptr_width(&mut c, pointee);
    get(&mut c, address, view("%rcx"));
    get(&mut c, v, view("%rax"));
    if width == 8 {
        o(&mut c, view("movq %rax,(%rcx)\n"));
    }
    if width == 4 {
        o(&mut c, view("movl %eax,(%rcx)\n"));
    }
    if width == 2 {
        o(&mut c, view("movw %ax,(%rcx)\n"));
    }
    if width == 1 {
        o(&mut c, view("movb %al,(%rcx)\n"));
    }
    return ();
}
