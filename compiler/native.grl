        ty := reference_type(&mut c, value.ty, 0);
        o(&mut c, view("leaq "));
        stack_slot(&mut c, cell);
        o(&mut c, view(",%rax\n"));
        keeper = save(&mut c);
        borrow_reference(&mut c, keeper, ty, cell, target, 0);
    }
    context := expr(&mut c, 0);
    expect(&mut c, view(","));
    callee := expr(&mut c, 0);
    expect(&mut c, view(")"));
    input := callee.t;
    function := deref(&mut c, callee);
    fty := function.ty;
    if ty_kind(&mut c, fty) != 12 {
        fail(&mut c, view("lock_with requires a callable"));
    }
    signature := type_args(&mut c, fty);
    result := ty_arg(&mut c, fty);
    if signature.len() != 2 {
        fail(&mut c, view("lock_with callback takes (ref_mut payload, context)"));
    }
    guard := signature[0];
    expected := signature[1];
    if (ty_kind(&mut c, guard) != 7) || (ty_mode(&mut c, guard) == 0) {
        fail(&mut c, view("lock_with callback must take an exclusive payload reference"));
    }
    inner := ty_arg(&mut c, guard);
    require_type(&mut c, inner, payload);
    require_type(&mut c, context.ty, expected);
    if contains_borrow(&mut c, result, 0) {
        fail(&mut c, view("lock_with result cannot contain borrows"));
    }
    loan := type_regions(&mut c, guard);
    carried := type_caps(&mut c, expected, 0);
    if intersects(&loan, &carried) {
        fail(&mut c, view("lock_with context cannot carry the guarded payload lifetime"));
    }
    observe(&mut c, function.t);
    get(&mut c, function.t, view("%rax"));
    target := save(&mut c);
    kind := ty_kind(&mut c, context.ty);
    if (kind == 5) || (kind == 7) || (kind == 27) {
        observe(&mut c, context.t);
    }
    if kind == 7 {
        place := target_of(&mut c, context.t);
        capture_authority(&mut c, place);
    }
    held := move_value(&mut c, context);
    heldslot := held.t;
    move_out(&mut c, held);
    observe(&mut c, cell);
    invoke(&mut c, view("rt_mutex_lock"), one(cell));
    get(&mut c, cell, view("%rax"));
    o(&mut c, view("leaq 8(%rax),%rax\n"));
    pointer := save(&mut c);
    get(&mut c, pointer, view("%rdi"));
    get(&mut c, heldslot, view("%rsi"));
    get(&mut c, target, view("%rax"));
    call_slot_out(&mut c, view("call *%rax\n"));
    slot := save(&mut c);
    invoke(&mut c, view("rt_mutex_unlock"), one(cell));
    own(&mut c, slot, result);
    if keeper != 0 {
        index := resource(&mut c, keeper);
        release(&mut c, index - 1);
    }
    release_temporary(&mut c, input);
    close_loans(&mut c);
    return val(slot, result);
}
fn atomic_method<a, b>(c: (&a mut C), value: Val, name: &b [u8]) -> Val {
    cell := value.t;
    observe(&mut c, cell);
    mut keeper = 0;
    // Interior atomic mutation needs read authority, but its owner must remain
    // alive and at the same place throughout evaluation of every argument.
    if c.raw == 0 {
        target := place_of(&mut c, cell);
        ty := reference_type(&mut c, value.ty, 0);
        o(&mut c, view("leaq "));
        stack_slot(&mut c, cell);
        o(&mut c, view(",%rax\n"));
        keeper = save(&mut c);
        borrow_reference(&mut c, keeper, ty, cell, target, 0);
    }
    mut args = one(cell);
    mut unit = 0;
    mut arity = 0;
    mut f = "";
    if same(view(name), view("load")) {
        f = "rt_atomic_load";
    }
    if same(view(name), view("load_relaxed")) {
        f = "rt_atomic_load_relaxed";
    }
    if same(view(name), view("load_acquire")) {
        f = "rt_atomic_load_acquire";
    }
    if same(view(name), view("store")) {
        f = "rt_atomic_store";
        arity = 1;
        unit = 1;
    }
    if same(view(name), view("store_relaxed")) {
        f = "rt_atomic_store_relaxed";
        arity = 1;
        unit = 1;
    }
    if same(view(name), view("store_release")) {
        f = "rt_atomic_store_release";
        arity = 1;
        unit = 1;
    }
    if same(view(name), view("fetch_add")) {
        f = "rt_atomic_fetch_add";
        arity = 1;
    }
    if same(view(name), view("fetch_sub")) {
        f = "rt_atomic_fetch_sub";
        arity = 1;
    }
    if same(view(name), view("swap")) {
        f = "rt_atomic_swap";
        arity = 1;
    }
    if same(view(name), view("compare_exchange")) {
        f = "rt_atomic_compare_exchange";
        arity = 2;
    }
    if f.len() == 0 {
        fail(&mut c, view("unknown Atomic method or invalid ordering"));
    }
    for i in arity {
        if i != 0 {
            expect(&mut c, view(","));
        }
        argument := expr(&mut c, 0);
        if c.raw == 0 {
            require_type(&mut c, argument.ty, 0);
        }
        get(&mut c, argument.t, view("%rax"));
        snapshot := save(&mut c);
        args.push(snapshot);
    }
    expect(&mut c, view(")"));
    observe(&mut c, cell);
    slot := invoke(&mut c, view(f), args);
    if keeper != 0 {
        index := resource(&mut c, keeper);
        release(&mut c, index - 1);
    }
    return val(slot, unit);
}
fn method_receiver<a>(c: (&a mut C), input: u64, inty: u64, xty: u64, formal: u64) -> Val {
    mut rv = input;
    mut rty = inty;
    if ty_kind(&mut c, formal) == 7 {
        if ty_kind(&mut c, inty) != 7 {
            mode := ty_mode(&mut c, formal);
            refty := reference_type(&mut c, xty, mode);
            mut temporary = 0;
            if !is_local_slot(&mut c, input) {
                index := resource(&mut c, input);
                if index != 0 {
                    info := &c.resources[index - 1];
                    if (info.base == 0) & (info.place != 0) {
                        temporary = 1;
                    }
                }
            }
            if is_local_slot(&mut c, input) || temporary != 0 {
                if mode != 0 && temporary == 0 {
                    require_mutable_binding(&mut c, input, 1);
                }
                target := place_of(&mut c, input);
                o(&mut c, view("leaq "));
                stack_slot(&mut c, input);
                o(&mut c, view(",%rax\n"));
                slot := save(&mut c);
                r := borrow_reference(&mut c, slot, refty, input, target, mode);
                rv = r.t;
                rty = r.ty;
            } else {
                // A field receiver (a.b.method()) is borrowed in place, like &a.b.
                index := resource(&mut c, input);
                if index == 0 {
                    fail(&mut c, view("method receiver must be a variable, field or reference"));
                }
                info := &c.resources[index - 1];
                base := info.base;
                field := info.field;
                via := info.via;
                referent_place := info.place;
                if base == 0 {
                    fail(&mut c, view("method receiver must be a variable, field or reference"));
                }
                b := base - 1;
                // A loaded referent (including map[key]) is already addressed by its
                // base reference. Reborrow that authority, not a fictitious child of
                // the reference holder; ordinary record fields take the path below.
                owner := resource(&mut c, b);
                if owner != 0 {
                    basety := c.resources[owner - 1].ty;
                    if ty_kind(&mut c, basety) == 7 {
                        target := target_of(&mut c, b);
                        inner := ty_arg(&mut c, basety);
                        if target == referent_place && same_type(&mut c, inner, xty) {
                            return place_slot(&mut c, b, basety, mode);
                        }
                    }
                }
                if mode != 0 {
                    require_mutable_binding(&mut c, b, 0);
                }
                n := rec_load(&mut c, b, field, 1);
                root := place_of(&mut c, b);
                target := member_place(&mut c, root, field, xty);
                authority := authority_of(&mut c, b);
                c
                    .resources
                    .push(
                        Resource {
                            slot: n,
                            ty: refty,
                            flag: 0,
                            base: b + 1,
                            field: field,
                            via: via,
                            place: 0,
                            target: target,
                            authority: authority,
                        }
                    );
                r := borrow_reference(&mut c, n, refty, b, target, mode);
                rv = r.t;
                rty = r.ty;
            }
        } else {
            // A reference receiver is reborrowed for the call, so the binding stays usable.
            mode := ty_mode(&mut c, formal);
            if mode != 0 && ty_mode(&mut c, inty) == 0 {
                fail(&mut c, view("method needs a mutable receiver but got a shared reference"));
            }
            refty := reference_type(&mut c, xty, mode);
            source := target_of(&mut c, input);
            get(&mut c, input, view("%rax"));
            slot := save(&mut c);
            r := borrow_reference(&mut c, slot, refty, input, source, mode);
            rv = r.t;
            rty = r.ty;
        }
    } else {
        if ty_kind(&mut c, inty) == 7 {
            fail(&mut c, view("method takes self by value but the receiver is a reference"));
        }
    }
    return val(rv, rty);
}
// Values whose type has an inherent `show(self: &a Self) -> string` print through it.
fn show_value<a>(c: (&a mut C), input: u64, inty: u64, xty: u64) -> Val {
    if ty_kind(&mut c, xty) != 8 {
        return val(0, NO_TYPE);
    }
    d := ty_arg(&mut c, xty);
    owner := private_module(view(".inherent_"), d);
    f := find_func(&mut c, view(owner), view("show"));
    if f == 0 {
        return val(0, NO_TYPE);
    }
    info := &c.funcs[f - 1];
    first := info.first;
    count := info.count;
    if count != 1 {
        fail(&mut c, view("show must take only self"));
    }
    formal := c.params[first];
    if ty_kind(&mut c, formal) != 7 {
        fail(&mut c, view("show must take self by reference"));
    }
    prepared := method_receiver(&mut c, input, inty, xty, formal);
    exchange(&mut c.receiver, prepared.t);
    exchange(&mut c.receiver_ty, prepared.ty);
    exchange(&mut c.has_receiver, 2);
    return call(&mut c, view(owner), view("show"));
}
// The iterator protocol: a record with an inherent `fn next(self: &mut Self) -> T?` is iterable,
// and `for x in it` is `while let Some(x) = it.next() { ... }`. An owned iterator is moved into a
// hidden mutable local that lives for the loop; `for x in &mut it` iterates a borrowed one and leaves
// it usable afterwards. Each `next` call reborrows the iterator, so an iterator that borrows a
// collection keeps that loan for the whole loop (the collection cannot be mutated in the body).
// Returns false, consuming nothing, when `v` is not such an iterator.
fn iterator_loop<a>(c: (&a mut C), name: u8[], vt: u64, vty: u64, loopbase: u64) -> bool {
    mut xty = vty;
    if ty_kind(&mut c, xty) == 7 {
        xty = ty_arg(&mut c, xty);
    }
    if ty_kind(&mut c, xty) != 8 {
        return false;
    }
    d := ty_arg(&mut c, xty);
    if c.decls[d].is_enum != 0 {
        return false;
    }
    owner := private_module(view(".inherent_"), d);
    f := find_func(&mut c, view(owner), view("next"));
    if f == 0 {
        return false;
    }
    info := &c.funcs[f - 1];
    first := info.first;
    count := info.count;
    formal := c.params[first];
    if (count != 1) || (ty_kind(&mut c, formal) != 7) || (ty_mode(&mut c, formal) == 0) {
        fail(&mut c, view("for x in it needs fn next(self: &mut Self) -> T? on the iterator"));
    }
    if (ty_kind(&mut c, vty) == 7) & (ty_mode(&mut c, vty) == 0) {
        fail(&mut c, view("for x in &it needs &mut it: next advances the iterator"));
    }
    mark := c.locals.len();
    mut input = vt;
    inty := vty;
    if ty_kind(&mut c, vty) != 7 {
        owned := move_value(&mut c, val(vt, vty));
        bind(&mut c, copy_bytes(view("__iterator")), owned.ty, owned.t, 1);
        input = owned.t;
        mut open = c.pos;
        while kind_at(&mut c, open) != 123 {
            open = open + 1;
        }
        loopend := block_end(&mut c, open);
        last := c.locals.len() - 1;
        mut l = &mut c.locals[last];
        l.last = loopend;
    }
    pattern_loop(&mut c, false, 1, copy_bytes(view("Some")), name, 1, owner, input, inty, xty, formal);
    // Everything the iterable expression made ends with the loop: the hidden iterator is dropped,
    // and the `&mut it` reborrow of a lent iterator releases its loan.
    cleanup(&mut c, loopbase);
    pop_locals(&mut c, mark);
    return true;
}
// The body of `loop`, `while` and `while let` (and of `for x in it` over an iterator, which is
// `while let Some(x) = it.next()`): the header is already parsed. With `iter_owner` set, the
// pattern's scrutinee is a call of that module's `next` on `iter_input` instead of an expression.
fn pattern_loop<a>(
    c: (&a mut C),
    endless: bool,
    pattern: u64,
    variant: u8[],
    binding: u8[],
    has_binding: u64,
    iter_owner: u8[],
    iter_input: u64,
    iter_inty: u64,
    iter_xty: u64,
    iter_formal: u64
) -> unit {
    head := label(&mut c);
    end := label(&mut c);
    oldb := c.brk;
    oldc := c.cont;
    oldmark := c.loopmark;
    oldstart := c.loop_start;
    oldend := c.loop_end;
    loopstart := c.pos;
    mut open = loopstart;
    while kind_at(&mut c, open) != 123 {
        open = open + 1;
    }
    loopend := block_end(&mut c, open);
    exchange(&mut c.loop_start, loopstart);
    exchange(&mut c.loop_end, loopend);
    loopmark := c.resources.len();
    exchange(&mut c.loopmark, loopmark);
    oldloop := exchange(&mut c.loopcheck, ownership::snapshot(&c.check));
    oldbreak := exchange(&mut c.breaks, ownership::new());
    oldhas := c.hasbreak;
    exchange(&mut c.hasbreak, 0);
    exchange(&mut c.brk, end);
    exchange(&mut c.cont, head);
    mark(&mut c, head);
    mut nomatch = 0;
    mut scrutinee = 0;
    mut scrutty = 0;
    mut payloads = 0;
    mut patmark = 0;
    if pattern != 0 {
        mut s = val(0, 0);
        if iter_owner.len() != 0 {
            // `for x in it`: the scrutinee is `it.next()`, called afresh at every iteration on a
            // reborrow of the iterator (iterator_loop).
            prepared := method_receiver(&mut c, iter_input, iter_inty, iter_xty, iter_formal);
            exchange(&mut c.receiver, prepared.t);
            exchange(&mut c.receiver_ty, prepared.ty);
            exchange(&mut c.has_receiver, 2);
            s = call(&mut c, view(iter_owner), view("next"));
        } else {
            s = expr(&mut c, 0);
        }
        x := deref(&mut c, s);
        xt := x.t;
        xty := x.ty;
        scrutinee = xt;
        scrutty = xty;
        if ty_kind(&mut c, xty) != 8 {
            fail(&mut c, view("while let requires an enum value"));
        }
        d := ty_arg(&mut c, xty);
        decl := &c.decls[d];
        if decl.is_enum == 0 {
            fail(&mut c, view("while let requires an enum value"));
        }
        k := find_field(&mut c, d, view(variant));
        pty := field_type(&mut c, xty, k);
        tag := rec_load(&mut c, xt, 0, 0);
        move_out(&mut c, val(xt, xty));
        nomatch = label(&mut c);
        get(&mut c, tag, view("%rax"));
        o(&mut c, view("cmpq $"));
        on(&mut c, k);
        o(&mut c, view(",%rax\n"));
        jump(&mut c, view("jne"), nomatch);
        patmark = c.locals.len();
        payloads = c.resources.len();
        payload := rec_load(&mut c, xt, 1, 0);
        own(&mut c, payload, pty);
        source := place_of(&mut c, xt);
        dest := place_of(&mut c, payload);
        if contains_borrow(&mut c, pty, 0) {
            transfer_bonds(&mut c, source, dest);
        }
        stored_source(&mut c, payload, pty);
        invoke(&mut c, view("rt_free"), one(xt));
        if has_binding != 0 {
            bind(&mut c, binding.copy(), pty, payload, 0);
        }
    }
    if !endless & (pattern == 0) {
        tests := c.resources.len();
        guard_at := c.pos;
        mut v = expr(&mut c, 0);
        guard_end := c.pos;
        if c.raw == 0 {
            require_type(&mut c, v.ty, 0);
            strict_condition(&mut c, v.ty);
        }
        cleanup(&mut c, tests);
        expire_locals(&mut c);
        // The guard holds on the body's paths, and only there: an iteration that exits did not
        // establish it for what follows the loop.
        mut guards = pv_ir_atoms(&mut c, guard_at, guard_end);
        pv_ir_statement(&mut c, guard_at, guard_end);
        pv_ir_pending(&mut c, &guards);
        get(&mut c, v.t, view("%rax"));
        o(&mut c, view("testq %rax,%rax\n"));
        jump(&mut c, view("jz"), end);
    }
    entry := ownership::snapshot(&c.check);
    exchange(&mut c.terminated, 0);
    block(&mut c);
    // The pattern's binding ends with each iteration, before the jump back: release it first, so
    // neither the backedge check nor the state the loop exits with still holds this iteration's
    // item (an iterator that hands out references left its last item's loan in the exit state,
    // and a second loop after it then saw that stale storage "consumed" on its own backedge).
    terminated := c.terminated;
    if pattern != 0 {
        cleanup(&mut c, payloads);
        pop_locals(&mut c, patmark);
    }
    if terminated == 0 {
        if !backedge_ok(&mut c, &ownership::snapshot(&c.loopcheck)) {
            fail(&mut c, view("loop backedge consumes entry storage"));
        }
    }
    // A body that always returns or continues reaches the exit only through the entry state
    // (and any breaks): its dead end state, where `return` dropped every local, must not be
    // merged in.
    if terminated != 0 {
        ownership::restore(&mut c.check, &entry);
    } else {
        ownership::merge(&mut c.check, &entry);
    }
    if c.hasbreak != 0 {
        ownership::merge(&mut c.check, &ownership::snapshot(&c.breaks));
    }
    exchange(&mut c.terminated, 0);
    jump(&mut c, view("jmp"), head);
    if pattern != 0 {
        mark(&mut c, nomatch);
        get(&mut c, scrutinee, view("%rdi"));
        drop_call(&mut c, scrutty);
    }
    mark(&mut c, end);
    broke := c.hasbreak;
    exchange(&mut c.brk, oldb);
    exchange(&mut c.cont, oldc);
    exchange(&mut c.loopmark, oldmark);
    exchange(&mut c.loopcheck, oldloop);
    exchange(&mut c.breaks, oldbreak);
    exchange(&mut c.hasbreak, oldhas);
    exchange(&mut c.loop_start, oldstart);
    exchange(&mut c.loop_end, oldend);
    if endless & (broke == 0) {
        exchange(&mut c.terminated, 1);
    }
    return ();
}
// Built-in methods on string / bytes / views. Results are new values; `string` input gives `string`.
fn text_arg<a>(c: (&a mut C)) -> Val {
    v := expr(&mut c, 0);
    if !is_text(&mut c, v.ty) {
        fail(&mut c, view("text method argument must be text"));
    }
    return v;
}
fn text_method<a, b>(c: (&a mut C), xt: u64, k: u64, name: &b [u8]) -> Val {
    mut result = 2;
    if k == 4 {
        result = 3;
    }
    bt := bool_type(&mut c);
    if same(view(name), view("contains")) || same(view(name), view("starts_with")) || same(view(name), view("ends_with")) {
        arg := text_arg(&mut c);
        expect(&mut c, view(")"));
        mut f = "rt_seq_contains";
        if same(view(name), view("starts_with")) {
            f = "rt_seq_starts";
        }
        if same(view(name), view("ends_with")) {
            f = "rt_seq_ends";
        }
        r := invoke(&mut c, view(f), two(xt, arg.t));
        release_temporary(&mut c, arg.t);
        return val(r, bt);
    }
    if same(view(name), view("to_upper")) || same(view(name), view("to_lower")) || same(view(name), view("trim")) {
        expect(&mut c, view(")"));
        mut f = "rt_seq_trim";
        if same(view(name), view("to_upper")) {
            f = "rt_seq_upper";
        }
        if same(view(name), view("to_lower")) {
            f = "rt_seq_lower";
        }
        r := invoke(&mut c, view(f), one(xt));
        return own(&mut c, r, result);
    }
    if same(view(name), view("replace")) {
        from := text_arg(&mut c);
        expect(&mut c, view(","));
        to := text_arg(&mut c);
        expect(&mut c, view(")"));
        valid := imm(&mut c, k == 4);
        mut args = u64[];
        args.push(xt);
        args.push(from.t);
        args.push(to.t);
        args.push(valid);
        r := invoke(&mut c, view("rt_seq_replace"), args);
        release_temporary(&mut c, from.t);
        release_temporary(&mut c, to.t);
        return own(&mut c, r, result);
    }
    if same(view(name), view("repeat")) {
        n := expr(&mut c, 0);
        require_type(&mut c, n.ty, 0);
        expect(&mut c, view(")"));
        r := invoke(&mut c, view("rt_seq_repeat"), two(xt, n.t));
        return own(&mut c, r, result);
    }
    if same(view(name), view("chars")) {
        expect(&mut c, view(")"));
        r := invoke(&mut c, view("rt_seq_chars"), one(xt));
        ch := char_type(&mut c);
        vt := intern(&mut c, 6, ch);
        return own(&mut c, r, vt);
    }
    if same(view(name), view("split")) {
        sep := expr(&mut c, 0);
        require_type(&mut c, sep.ty, 0);
        expect(&mut c, view(")"));
        valid := imm(&mut c, k == 4);
        r := invoke(&mut c, view("rt_seq_split"), three(xt, sep.t, valid));
        vt := intern(&mut c, 6, result);
        return own(&mut c, r, vt);
    }
    return val(0, NO_TYPE);
}
fn char_method<a>(n: &a [u8]) -> bool {
    return same(view(n), view("is_alphabetic"))
        || same(view(n), view("is_alphanumeric"))
        || same(view(n), view("is_ascii_digit"))
        || same(view(n), view("is_whitespace"))
        || same(view(n), view("is_uppercase"))
        || same(view(n), view("is_lowercase"))
        || same(view(n), view("is_ascii"))
        || same(view(n), view("to_uppercase"))
        || same(view(n), view("to_lowercase"))
        || same(view(n), view("len_utf8"));
}
// `*T` is one word: the natural width of a sized integer, 4 and 8 for f32 and f64, and one word for
// everything else, because a record, vector or string value is a pointer to its own storage.
fn ptr_stride<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(&mut c, ty);
    if k == 18 {
        return ty_arg(&mut c, ty) / 8;
    }
    if k == 21 {
        if ty_arg(&mut c, ty) == 32 {
            return 4;
        }
        return 8;
    }
    return 8;
}
// Every operation on a raw pointer reads or writes memory the checker has not followed, so each one
// needs an `unsafe` block. The type itself is spellable anywhere.
fn raw_pointer_gate<a, b>(c: (&a mut C), what: &b [u8]) -> unit {
    if (c.raw == 0) & (c.unsafe_depth == 0) {
        mut msg = copy_bytes(view("a raw pointer operation needs an unsafe block: "));
        push_bytes(&mut msg, view(what));
        fail(&mut c, view(msg));
    }
    return ();
}
// The methods of a `*T`. The receiver's word is the address; `name` is the method already read and
// `(` already expected.
fn pointer_method<a, d>(c: (&a mut C), value: Val, pty: u64, name: &d [u8]) -> Val {
    raw_pointer_gate(&mut c, view(name));
    word := value.t;
