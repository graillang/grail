fn close_loans<a>(c: (&a mut C)) -> unit {
    mut changed = 1;
    while changed != 0 {
        changed = 0;
        mut i = c.check.loans.len();
        while i != 0 {
            i = i - 1;
            mut l = &c.check.loans[i];
            live := l.live;
            if live != 0 {
                mut held = 0;
                for j in c.bonds.len() {
                    mut b = &c.bonds[j];
                    loan := b.loan;
                    holder := b.holder;
                    if loan == i + 1 {
                        state := ownership::status(&c.check, holder);
                        if (state == 1) || (state == 3) {
                            held = 1;
                            break;
                        }
                    }
                }
                if held == 0 {
                    if ownership::end_loan(&mut c.check, i + 1) == 0 {
                        changed = 1;
