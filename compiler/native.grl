    advance(&mut c);
    expect(&mut c, view("("));
    if kind(&mut c) != 3 {
        fail(&mut c, view("@embed takes a path string"));
    }
    rel := decode_literal(&mut c, c.pos);
    advance(&mut c);
    expect(&mut c, view(")"));
    mut path = rel.copy();
    if (rel.len() == 0) || (rel[0] != 47) {
        mut base = u8[];
        if c.file < 1000000 {
            offset := c.arg_offset;
            base = host::arg(c.file + offset);
        }
        mut cut = 0;
        for i in base.len() {
            if base[i] == 47 {
                cut = i + 1;
            }
        }
        mut joined = u8[];
        for i in cut {
            joined.push(base[i]);
        }
        push_bytes(&mut joined, view(rel));
        path = joined;
    }
    if host::exists(view(path)) == 0 {
        mut msg = copy_bytes(view("@embed cannot read "));
        push_bytes(&mut msg, view(path));
        fail(&mut c, view(msg));
    }
    exchange(&mut c.embed_used, 1);
    bytes := host::read_file(view(path));
    ptr := rodata_bytes(&mut c, &bytes);
    n := imm(&mut c, bytes.len());
    t := invoke(&mut c, view("rt_bytes_from"), two(ptr, n));
    return own(&mut c, t, 2);
}
fn string_lit<a>(c: (&a mut C)) -> Val {
    bytes := decode_literal(&mut c, c.pos);
    advance(&mut c);
    return string_from_bytes(&mut c, &bytes);
}
// The bytes as read-only data, and the address of the first one.
fn rodata_bytes<a, b>(c: (&a mut C), bytes: (&b u8[])) -> u64 {
    mut l = label(&mut c);
    rodata(&mut c);
    mark(&mut c, l);
    for i in bytes.len() {
        o(&mut c, view(".byte "));
        on(&mut c, bytes[i]);
        c.out.push(10);
    }
    o(&mut c, view(".byte 0\n.popsection\nleaq "));
    lname(&mut c, l);
    o(&mut c, view("(%rip),%rax\n"));
    return save(&mut c);
}
fn string_from_bytes<a, b>(c: (&a mut C), bytes: (&b u8[])) -> Val {
    ptr := rodata_bytes(&mut c, bytes);
    n := imm(&mut c, bytes.len());
    t := invoke(&mut c, view("rt_string_lit"), two(ptr, n));
    return own(&mut c, t, 3);
}
fn infer_type<a, b>(c: (&a mut C), formal: u64, actual: u64, map: (&b mut u64[])) -> unit {
    k := ty_kind(&mut c, formal);
    arg := ty_arg(&mut c, formal);
    // A projection fixes nothing by itself: its parameter is inferred from elsewhere and the
    // argument is checked against the bound signature afterwards.
    if k == 30 {
        return ();
    }
    if k == 9 {
        old := map[arg];
        if old == NO_TYPE {
            exchange(&mut map[arg], actual);
        } else {
            require_type(&mut c, actual, old);
        }
        return ();
    }
    ak := ty_kind(&mut c, actual);
    if k != ak {
        fail(&mut c, view("generic argument shape mismatch"));
    }
    if k == 7 {
        fm := ty_mode(&mut c, formal);
        am := ty_mode(&mut c, actual);
        if fm != am {
            fail(&mut c, view("generic reference mode mismatch"));
        }
    }
    if (k == 6) || (k == 27) || (k == 7) || (k == 13) || (k == 14) || (k == 16) || (k == 29) || (k == 34) {
        aa := ty_arg(&mut c, actual);
        infer_type(&mut c, arg, aa, &mut map);
        return ();
    }
    if (k == 12) || (k == 20) {
        result := ty_arg(&mut c, actual);
        infer_type(&mut c, arg, result, &mut map);
        fs := type_args(&mut c, formal);
        as := type_args(&mut c, actual);
        if fs.len() != as.len() {
            fail(&mut c, view("callable argument arity mismatch"));
        }
        for i in fs.len() {
            f := fs[i];
            a := as[i];
            infer_type(&mut c, f, a, &mut map);
        }
        return ();
    }
    if k == 8 {
        aa := ty_arg(&mut c, actual);
        if arg != aa {
            fail(&mut c, view("generic nominal mismatch"));
        }
        fa := type_args(&mut c, formal);
        ax := type_args(&mut c, actual);
        if fa.len() != ax.len() {
            fail(&mut c, view("generic arity mismatch"));
        }
        for i in fa.len() {
            f := fa[i];
            a := ax[i];
            infer_type(&mut c, f, a, &mut map);
        }
        return ();
    }
    require_type(&mut c, actual, formal);
    return ();
