    }
    if (c.lit_start != start) || (c.lit_end != end) {
        return v;
    }
    if (v.ty != 0) & (c.lit_negative == 0) {
        return v;
    }
    // Literal typing is a safe-mode feature; below here only that adoption remains, and a raw
    // module's literals are untyped words.
    if c.raw != 0 {
        return v;
    }
    if adopt_literal(&mut c, start, end, expected) {
        return val(v.t, expected);
