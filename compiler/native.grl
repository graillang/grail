    }
    return ();
}
fn expire_locals<a>(c: (&a mut C)) -> unit {
    if c.raw {
        return ();
    }
    for i in c.locals.len() {
        mut l = &c.locals[i];
        slot := l.id;
        ty := l.ty;
        last := l.last;
        born := l.born;
        k := ty_kind(borrow_mut(c), ty);
        mut carrier = (k == 5) + (k == 7);
        root := place_of(borrow_mut(c), slot);
        if (k == 6) + (k == 8) {
            for j in c.bonds.len() {
                mut b = &c.bonds[j];
                holder := b.holder;
                if ownership::ancestor(borrow(c.check), root, holder) {
                    carrier = 1;
                    break;
                }
            }
        }
        if carrier {
            if last < c.pos {
                mut defer = 0;
                if c.loop_end {
                    if (born < c.loop_start) & (last < c.loop_end) {
                        defer = 1;
                    }
                }
                if defer == 0 {
                    mut r = resource(borrow_mut(c), slot);
                    if r != 0 {
                        info := &c.resources[r - 1];
                        place := info.place;
                        if place != 0 {
                            if ownership::can_cleanup(borrow(c.check), place) {
                                if (k == 6) + (k == 8) {
                                    ownership::cleanup(borrow_mut(c.check), place);
                                    close_loans(borrow_mut(c));
                                } else {
                                    release(borrow_mut(c), r - 1);
