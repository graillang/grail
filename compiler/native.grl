// Whether `recv.name(...)` mutates its receiver: a builtin that does, a struct method whose receiver
// is `self: &mut ...`, or an inherent method of a written type (`impl<T: order::Ord> T[]`) whose
// receiver is `&mut self`. `recv` is the receiver's type, or 0 when it is not known.
fn mutating_method_name<a>(c: (&a mut C), name: &a [u8], recv: u64) -> u64 {
    builtin := u8[][copy_bytes(view("push")), copy_bytes(view("pop")), copy_bytes(view("insert")), copy_bytes(view("remove")), copy_bytes(view("clear")), copy_bytes(view("truncate")), copy_bytes(view("append")), copy_bytes(view("sort")), copy_bytes(view("reverse")), copy_bytes(view("swap")), copy_bytes(view("extend")), copy_bytes(view("get_mut")), copy_bytes(view("entry")), copy_bytes(view("retain"))];
    for i in builtin.len() {
        if same(view(builtin[i]), view(name)) {
            return 1;
        }
    }
    if recv == 0 {
        return 0;
    }
    // A user method of the receiver's own type whose receiver is `self: &mut ...`.
    for i in c.funcs.len() {
        f := &c.funcs[i];
        if (f.owner != 0) & !inherent_is_type_key(f.owner) & (f.owner < generic_impl_key(0)) & (f.count != 0) & same(view(f.name), view(name)) {
            first := f.first;
            owner := f.owner;
            pty := c.params[first];
