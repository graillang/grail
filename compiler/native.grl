// A reference to a capture's environment field: shared for a read (`&name`), exclusive for a store.
// The field belongs to the environment, so an exclusive reference needs an `FnMut` closure.
fn capture_place<a, b>(c: (&a mut C), name: &b [u8], write: u64) -> Val {
