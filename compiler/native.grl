                if mode != 0 {
                    require_mutable_binding(&mut c, b, 0);
                }
                n := rec_load(&mut c, b, field, 1);
                root := place_of(&mut c, b);
                target := member_place(&mut c, root, field, xty);
                authority := authority_of(&mut c, b);
                c
                    .resources
                    .push(
                        Resource {
                            slot: n,
                            ty: refty,
                            flag: 0,
                            base: b + 1,
                            field: field,
                            via: via,
                            place: 0,
                            target: target,
                            authority: authority,
