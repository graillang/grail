    if (kind(&mut c) == 42) || (kind(&mut c) == 267) {
        return parse_raw_pointer(&mut c);
    }
    // `dyn I` / `dyn module::I`: a value of any type implementing I, chosen at run time.
    if is(&mut c, view("dyn")) && ((kind_at(&mut c, c.pos + 1) == 1) || (kind_at(&mut c, c.pos + 1) == 60)) {
        advance(&mut c);
        // `dyn<Send> I`, `dyn<Send, Share> I`, `dyn<s> I` (docs/design/dyn-and-callable-bounds.md):
        // the bounds an interface object states about the value behind it, read by the same list
        // as a closure type's. `Owned` is never written: a bare `dyn I` already holds no borrow,
        // and `dyn<s> I` is the form that may.
        mut dyn_regions = u64[];
        mut dyn_bits = 0;
        if is(&mut c, view("<")) {
            dyn_bits = closure_bounds_list(&mut c, false, &mut dyn_regions);
            if (dyn_bits & CLOSURE_OWNED) != 0 {
                fail(&mut c, view("`Owned` is not written on `dyn`: a `dyn I` holds no borrow already; `dyn<s> I` is the one that may"));
            }
        }
        first := ident(&mut c);
        mut m = module_copy(&mut c);
        mut n = first.copy();
        if eat(&mut c, view("::")) {
            m = first.copy();
            n = ident(&mut c);
        } else {
            imported := resolve_import(&mut c, view(n));
            if imported.len() != 0 {
                m = imported;
            }
        }
        id := ensure_interface(&mut c, m, n);
        interface_visible(&mut c, id);
        // `dyn Iterator<Item = u64>`: an interface with associated types names each of them.
        assoc := copy_names(&c.interfaces[id - 1].assoc);
        mut fixed = u64[];
        for j in assoc.len() {
            fixed.push(NO_TYPE);
        }
        if eat(&mut c, view("<")) {
            while true {
                assoc_name := ident(&mut c);
                expect(&mut c, view("="));
                ty := parse_type(&mut c);
                mut found = false;
                for j in assoc.len() {
                    if same(view(assoc[j]), view(assoc_name)) {
                        exchange(&mut fixed[j], ty);
                        found = true;
                    }
                }
                if !found && (c.interfaces[id - 1].defined != 0) {
                    fail(&mut c, view("the interface has no associated type of that name"));
                }
                if eat(&mut c, view(">")) {
                    break;
