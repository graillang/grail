// Runtime type code: bits | signed<<8 | wrap<<9.
fn int_code<a>(c: (&a mut C), ty: u64) -> u64 {
    mut bits = 64;
    mut signed = 0;
    if ty != 0 {
        bits = ty_arg(&mut c, ty);
        signed = ty_mode(&mut c, ty);
