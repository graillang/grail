        }
    }
    eat(borrow_mut(c),&";");
    exchange(&mut c.decls[d-1],Decl{module:m,name:name,is_enum:is_enum,first:first,count:count,regions:regions,types:types,bounds:bounds,constraints:constraints});
    return ();
