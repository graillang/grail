// Calls the runtime using the System V ABI.
fn apply<a,b>(c:ref_mut<a,C>,f:read<b>,args:vec<num>)->num{return invoke(borrow_mut(c),f,args);}
fn one(a:num)->vec<num> { let v=vec<num>(); vec_push(v,a); return v; }
