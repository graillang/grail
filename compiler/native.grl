        require_write(borrow_mut(c),xt);let source=place_of(borrow_mut(c),b.t);move_out(borrow_mut(c),val(b.t,b.ty));invoke(borrow_mut(c),read("rt_push"),two(xt,bt));let root=place_of(borrow_mut(c),xt);transfer_bonds(borrow_mut(c),source,root);return val(imm(borrow_mut(c),0),1);
