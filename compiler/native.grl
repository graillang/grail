// ---- SIMD vector types (docs/design/simd.md) ------------------------------------------------------
// Kind 36: `f32x4`, `f32x8`, `f64x2`, `f64x4`, `i32x4`, `i32x8` and the masks `m32x4`, `m32x8`,
// `m64x2`, `m64x4`. The element is the type's argument (f32, f64 or i32; a mask's lanes are i32 or
// i64), the lane count its mode, plus 1024 for a mask. A vector is a plain value in the frame (its
// lanes packed, 16 or 32 bytes), copied as a record of words is, with no drop; every operation is one
// `simd.` stream line (machine.grl "SIMD"), which LLVM lifts to vector IR and the native backend
// expands lane by lane.
fn simd_named<a, b>(c: (&a mut C), n: &b [u8]) -> u64 {
    if (n.len() < 5) || (6 < n.len()) {
        return 0;
    }
    mut x = 0;
    for i in n.len() {
        if n[i] == 120 {
            x = i;
        }
    }
    if x != 3 {
        return 0;
    }
    head := n[0];
    bits := n[1: 3].copy();
    lanes := n[4:].copy();
    mut b = 0;
    if same(view(bits), view("32")) {
        b = 32;
    }
    if same(view(bits), view("64")) {
        b = 64;
    }
    mut l = 0;
    if same(view(lanes), view("2")) {
        l = 2;
    }
    if same(view(lanes), view("4")) {
        l = 4;
    }
    if same(view(lanes), view("8")) {
        l = 8;
    }
    if (b == 0) || (l == 0) || (b * l < 128) || (256 < b * l) {
        return 0;
    }
    if head == 102 {
        if b == 32 {
            return intern_full(&mut c, 36, f32_type(&mut c), l, u64[]);
