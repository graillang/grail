fn find_hint<a>(c: (&a mut C), at: u64) -> u64 {
    mut i = 0;
    while i + 1 < c.hints.len() {
        if c.hints[i] == at {
            return c.hints[i + 1] + 1;
        }
        i += 2;
    }
    return 0;
}
// `show(count)` where count is a committed literal binding and show wants a u8: remember that
// count should have been a u8 and finish this attempt tolerantly; the function is recompiled.
fn hint_use<a>(c: (&a mut C), v: Val, start: u64, end: u64, expected: u64) -> Val {
    if (c.raw != 0) || (c.cf_local == 0) {
        return v;
    }
    if (c.cf_start != start) || (c.cf_end != end) {
        return v;
    }
    if v.ty == expected {
        return v;
    }
    if 3 < c.attempts {
        return v;
    }
    // `cf_local` is an index into the locals of the function that recorded it. The record is
    // cleared wherever those locals or the token positions are replaced, so reaching this point
    // with a dead index would be a compiler bug; say so instead of faulting the process.
    if c.locals.len() < c.cf_local {
        fail(
            &mut c,
            view(
                "internal compiler error: a literal-type hint refers to a local binding that is no longer live"
            )
        );
    }
    l := &c.locals[c.cf_local - 1];
    origin := l.origin;
    at := l.at;
    lit := l.lit;
    neg := l.neg;
    mut ok = 0;
    if (origin == 1) & literal_target(&mut c, expected) {
        ok = literal_fits(&mut c, expected, lit, neg);
    }
    if (origin == 2) & is_f32(&mut c, expected) {
        ok = 1;
    }
    if ok == 0 {
        return v;
    }
    if find_hint(&mut c, at) == 0 {
        c.hints.push(at);
        c.hints.push(expected);
        exchange(&mut c.retry, 1);
        exchange(&mut c.tolerant, 1);
    }
    return val(v.t, expected);
}
fn stmt<a>(c: (&a mut C)) -> unit {
    if c.raw == 0 {
        if c.terminated != 0 {
            fail(&mut c, view("unreachable statement after transfer"));
        }
    }
    mark := c.resources.len();
    statement(&mut c);
    expire_locals(&mut c);
    mut i = c.resources.len();
    while mark < i {
        i = i - 1;
        mut r = &c.resources[i];
        slot := r.slot;
        release_temporary(&mut c, slot);
    }
    close_loans(&mut c);
    return ();
}
fn host_fn<a, b>(c: (&a mut C), name: &b [u8], ret: u64) -> unit {
    first := c.params.len();
    if same(view(name), view("arg")) || same(view(name), view("print_num")) {
        c.params.push(0);
    }
    if same(view(name), view("read_file")) || same(view(name), view("print")) {
        c.params.push(4);
    }
    if same(view(name), view("write_file")) {
        c.params.push(4);
        c.params.push(4);
    }
    if same(view(name), view("command")) {
        ty := intern(&mut c, 6, 2);
        c.params.push(ty);
    }
    if same(view(name), view("sleep_ms")) || same(view(name), view("close")) {
        c.params.push(0);
    }
    if same(view(name), view("read_fd")) {
        c.params.push(0);
        c.params.push(0);
    }
    if same(view(name), view("env"))
        || same(view(name), view("exists"))
        || same(view(name), view("mkdir"))
        || same(view(name), view("list_dir")) {
        c.params.push(4);
    }
    if same(view(name), view("tcp_listen")) || same(view(name), view("tcp_port")) || same(view(name), view("tcp_accept")) {
        c.params.push(0);
    }
    if same(view(name), view("tcp_connect")) || same(view(name), view("open")) {
        c.params.push(4);
        c.params.push(0);
    }
    if same(view(name), view("exit")) {
        c.params.push(0);
    }
    if same(view(name), view("remove")) {
        c.params.push(4);
        c.params.push(0);
    }
    if same(view(name), view("create_dir")) {
        c.params.push(4);
    }
    if same(view(name), view("write_fd")) {
        c.params.push(0);
        c.params.push(4);
    }
    count := c.params.len() - first;
    c
        .funcs
        .push(
            Func {
                module: "host".copy(),
                name: name.copy(),
                first: first,
                count: count,
                ret: ret,
                types: 0,
                regions: 0,
                file: 0,
                pos: 0,
                raw: 0,
                bounds: u64[],
                constraints: u64[][],
                contract: 0,
                owner: 0,
                ext: 0,
                symbol: u8[],
            }
        );
    return ();
}
fn drop_call<a>(c: (&a mut C), ty: u64) -> unit {
    if needs_drop(&mut c, ty) {
        o(&mut c, view("call "));
        drop_name(&mut c, ty);
        c.out.push(10);
    }
    return ();
}
// `// grail-link: INPUT` is the compiler's complete linker request; build tooling
// resolves relative object/archive/shared inputs against the declaring sources and
// passes bare names as -lNAME. Nothing else has to guess link inputs.
fn push_bytes<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    for i in s.len() {
        out.push(s[i]);
    }
    return ();
}
fn with_link_notes<a, b>(libs: (&a u8[][]), body: &b [u8]) -> u8[] {
    mut out = u8[];
    for i in libs.len() {
        push_bytes(&mut out, view("// grail-link: "));
        push_bytes(&mut out, view(libs[i]));
        out.push(10);
    }
    push_bytes(&mut out, view(body));
    return out;
}
fn emit_drops<a>(c: (&a mut C)) -> unit {
