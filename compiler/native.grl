    mut b = expr(borrow_mut(c), 0);
    pend := c.pos;
    expect(borrow_mut(c), &")");
    // push_char(c): append the UTF-8 encoding of a char to bytes or a string.
    if same(&name, &"push_char") {
        ch := char_type(borrow_mut(c));
        b = adopt_value(borrow_mut(c), b, pstart, pend, ch);
        if c.raw == 0 {
            if (k != 3) & (k != 4) {
                fail(borrow_mut(c), &"push_char requires bytes or string");
            }
            require_type(borrow_mut(c), b.ty, ch);
        }
        require_write(borrow_mut(c), xt);
        invoke(borrow_mut(c), &"rt_push_utf8", two(xt, b.t));
