        if write != 0 {
            require_mutable_binding(&mut c, xt, 0);
            if k == 4 {
                fail(&mut c, view("string bytes cannot be mutably borrowed"));
            }
        }
    }
    ty := intern_full(&mut c, 5, 0, write, u64[]);
    slot := apply(&mut c, view("rt_view"), one(xt));
    own(&mut c, slot, ty);
    view_bonds(&mut c, slot, xt, write);
    release_temporary(&mut c, input);
