fn bind<a>(c:ref_mut<a,C>,name:bytes,ty:num,id:num,mutable:num)->unit {
    if c.raw==0{if place_of(borrow_mut(c),id)==0{kind :=ty_kind(borrow_mut(c),ty);if (kind==1)+(kind==2)+(kind==12){place :=ownership::root(borrow_mut(c.check),1,1);c.resources.push(Resource{slot:id,ty:ty,flag:0,base:0,field:0,via:0,place:place,target:0,authority:0});}}}
    from :=c.pos;to :=c.scope_end;last :=last_name(borrow_mut(c),&name,from,to);
    c.locals.push(Local{name:name,ty:ty,id:id,last:last,born:from,mutable:mutable});
    return ();
