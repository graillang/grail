        if c.raw == 0 {
            check_writeback(borrow_mut(c), destination, storage, source);
            if through {
                require_write(borrow_mut(c), target);
            } else {
                place := place_of(borrow_mut(c), target);
                if place != 0 {
                    if ownership::can_cleanup(borrow(c.check), place) == 0 {
                        fail(borrow_mut(c), &"assignment conflicts with live borrow");
                    }
                }
            }
            mut expected = local_ty(borrow_mut(c), l - 1);
            if through {
                expected = fieldty;
            }
            require_type(borrow_mut(c), v.ty, expected);
        }
        if through == 0 {
            if target == v.t {
                return ();
            }
        } else {
            if (destination != 0) & (destination == source) {
                return ();
            }
        }
        if through {
            storage_bonds(borrow_mut(c), source, destination);
            move_out(borrow_mut(c), val(v.t, v.ty));
        }
        if through == 0 {
            old := resource(borrow_mut(c), target);
            if old != 0 {
                release(borrow_mut(c), old - 1);
            }
        }
        if through {
            if needs_drop(borrow_mut(c), fieldty) {
                get(borrow_mut(c), target, &"%rax");
                o(borrow_mut(c), &"movq (%rax),%rdi\n");
                drop_call(borrow_mut(c), fieldty);
            }
        }
        get(borrow_mut(c), v.t, &"%rax");
        if through {
            get(borrow_mut(c), target, &"%rcx");
            o(borrow_mut(c), &"movq %rax,(%rcx)\n");
        } else {
            o(borrow_mut(c), &"movq %rax,");
            stack_slot(borrow_mut(c), target);
            c.out.push(10);
            old := resource(borrow_mut(c), target);
            if old != 0 {
                mut r = &c.resources[old - 1];
                flag := r.flag;
                place := place_of(borrow_mut(c), target);
                if place != 0 {
                    ownership::initialize(borrow_mut(c.check), place);
                }
                if flag != 0 {
                    o(borrow_mut(c), &"movq $1,");
                    stack_slot(borrow_mut(c), flag - 1);
                    c.out.push(10);
                }
            }
        }
        if through == 0 {
            transfer_bonds(borrow_mut(c), source, destination);
            newtarget := target_of(borrow_mut(c), v.t);
            move_out(borrow_mut(c), val(v.t, v.ty));
            if ty_kind(borrow_mut(c), ty) == 7 {
                set_target(borrow_mut(c), target, newtarget, target + 1);
            }
        }
        return ();
    }
    mut v = expr(borrow_mut(c), 0);
    expect(borrow_mut(c), &";");
    mut r = resource(borrow_mut(c), v.t);
    if r != 0 {
        info := &c.resources[r - 1];
        base := info.base;
        kind := ty_kind(borrow_mut(c), v.ty);
        if base != 0 {
            if needs_drop(borrow_mut(c), v.ty) + (kind == 7) {
                moved := move_value(borrow_mut(c), v);
                owner := resource(borrow_mut(c), moved.t);
                release(borrow_mut(c), owner - 1);
            } else {
                release(borrow_mut(c), r - 1);
            }
        } else {
            release(borrow_mut(c), r - 1);
        }
    }
    return ();
}
// A temporary scrutinee reference (`match borrow(s)`) lives in each arm only as long as the
// payload references bound from it: it becomes a hidden local that expires at the first
// statement boundary where nothing borrows from it, so the arm may then modify `s`.
fn arm_scrutinee<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if c.raw {
        return ();
    }
    if is_local_slot(borrow_mut(c), slot) {
        return ();
    }
    if resource(borrow_mut(c), slot) == 0 {
        return ();
    }
    c
        .locals
        .push(
            Local {
                name: copy_bytes(&".scrutinee"),
                ty: ty,
                id: slot,
                last: c.pos,
                born: c.pos,
                mutable: 0,
                flex: 0,
                lit: 0,
                neg: 0,
                origin: 0,
                at: 0,
            }
        );
    return ();
}
// Whether a read of local index i still denotes its literal. A mutable binding qualifies only
// before any assignment can have run: not inside a loop opened after its declaration.
fn flex_read<a>(c: (&a mut C), i: u64) -> u64 {
    l := &c.locals[i];
    if l.flex == 0 {
        return false;
    }
    if l.mutable == 0 {
        return true;
    }
    return c.loop_start < l.born + 1;
}
fn commit_flex<a>(c: (&a mut C), i: u64) -> unit {
    mut l = &mut c.locals[i];
    if l.mutable {
        exchange(borrow_mut(l.flex), 0);
    }
    return ();
}
// First assignment of a flexible mutable local: a sized integer value fixes its type.
fn settle_flex<a>(c: (&a mut C), i: u64, value_ty: u64) -> u64 {
    l := &c.locals[i];
    ty := l.ty;
    flex := l.flex;
    lit := l.lit;
    neg := l.neg;
    id := l.id;
    if flex == 0 {
        return ty;
    }
    mut out = ty;
    if flex == 1 {
        if (value_ty != ty) & literal_target(borrow_mut(c), value_ty) {
            if literal_fits(borrow_mut(c), value_ty, lit, neg) {
                out = value_ty;
            }
        }
    }
    // A float literal binding settling as f32 holds the literal rounded to binary32 from its text.
    // Only while the slot still holds the binary64 literal (no f32 value can equal a literal that
    // binary32 cannot represent), so a first assignment inside a loop converts it once.
    if (flex == 2) & is_f32(borrow_mut(c), value_ty) {
        out = value_ty;
        text := tok_text(borrow_mut(c), lit);
        mut wide = float_bits_p(borrow_mut(c), &text, 53);
        mut narrow = float_bits_p(borrow_mut(c), &text, 24);
        if neg {
            wide = wide ^ 9223372036854775808;
            narrow = narrow ^ 9223372036854775808;
        }
        if wide != narrow {
            done := label(borrow_mut(c));
            o(borrow_mut(c), &"movabsq $");
            on(borrow_mut(c), wide);
            o(borrow_mut(c), &",%rcx\n");
            get(borrow_mut(c), id, &"%rax");
            o(borrow_mut(c), &"cmpq %rcx,%rax\n");
            jump(borrow_mut(c), &"jne", done);
            o(borrow_mut(c), &"movabsq $");
            on(borrow_mut(c), narrow);
            o(borrow_mut(c), &",%rax\nmovq %rax,");
            stack_slot(borrow_mut(c), id);
            c.out.push(10);
            mark(borrow_mut(c), done);
        }
    }
    mut m = &mut c.locals[i];
    exchange(borrow_mut(m.flex), 0);
    exchange(borrow_mut(m.ty), out);
    if out != ty {
        exchange(borrow_mut(m.origin), 0);
    }
    return out;
}
fn find_hint<a>(c: (&a mut C), at: u64) -> u64 {
    mut i = 0;
    while i + 1 < c.hints.len() {
        if c.hints[i] == at {
            return c.hints[i + 1] + 1;
        }
        i += 2;
    }
    return 0;
}
// `show(count)` where count is a committed literal binding and show wants a u8: remember that
// count should have been a u8 and finish this attempt tolerantly; the function is recompiled.
fn hint_use<a>(c: (&a mut C), v: Val, start: u64, end: u64, expected: u64) -> Val {
    if (c.raw != 0) + (c.cf_local == 0) {
        return v;
    }
    if (c.cf_start != start) + (c.cf_end != end) {
        return v;
    }
    if v.ty == expected {
        return v;
    }
    if 3 < c.attempts {
        return v;
    }
    l := &c.locals[c.cf_local - 1];
    origin := l.origin;
    at := l.at;
    lit := l.lit;
    neg := l.neg;
    mut ok = 0;
    if (origin == 1) & literal_target(borrow_mut(c), expected) {
        ok = literal_fits(borrow_mut(c), expected, lit, neg);
    }
    if (origin == 2) & is_f32(borrow_mut(c), expected) {
        ok = 1;
    }
    if ok == 0 {
        return v;
    }
    if find_hint(borrow_mut(c), at) == 0 {
        c.hints.push(at);
        c.hints.push(expected);
        exchange(borrow_mut(c.retry), 1);
        exchange(borrow_mut(c.tolerant), 1);
    }
    return val(v.t, expected);
}
fn stmt<a>(c: (&a mut C)) -> unit {
    if c.raw == 0 {
        if c.terminated {
            fail(borrow_mut(c), &"unreachable statement after transfer");
        }
    }
    mark := c.resources.len();
    statement(borrow_mut(c));
    expire_locals(borrow_mut(c));
    mut i = c.resources.len();
    while mark < i {
        i = i - 1;
        mut r = &c.resources[i];
        slot := r.slot;
        release_temporary(borrow_mut(c), slot);
    }
    close_loans(borrow_mut(c));
    return ();
}
fn host_fn<a, b>(c: (&a mut C), name: &b [u8], ret: u64) -> unit {
    first := c.params.len();
    if same(&name, &"arg") + same(&name, &"print_num") {
        c.params.push(0);
    }
    if same(&name, &"read_file") + same(&name, &"print") {
        c.params.push(4);
    }
    if same(&name, &"write_file") {
        c.params.push(4);
        c.params.push(4);
    }
    if same(&name, &"command") {
        ty := intern(borrow_mut(c), 6, 2);
        c.params.push(ty);
    }
    if same(&name, &"sleep_ms") + same(&name, &"close") {
        c.params.push(0);
    }
    if same(&name, &"read_fd") {
        c.params.push(0);
        c.params.push(0);
    }
    if same(&name, &"env")
        + same(&name, &"exists")
        + same(&name, &"mkdir")
        + same(&name, &"list_dir") {
        c.params.push(4);
    }
    if same(&name, &"tcp_listen") + same(&name, &"tcp_port") + same(&name, &"tcp_accept") {
        c.params.push(0);
    }
    if same(&name, &"tcp_connect") + same(&name, &"open") {
        c.params.push(4);
        c.params.push(0);
    }
    if same(&name, &"exit") {
        c.params.push(0);
    }
    if same(&name, &"remove") {
        c.params.push(4);
        c.params.push(0);
    }
    if same(&name, &"create_dir") {
        c.params.push(4);
    }
    if same(&name, &"write_fd") {
        c.params.push(0);
        c.params.push(4);
    }
    count := c.params.len() - first;
    c
        .funcs
        .push(
            Func {
                module: "host".copy(),
                name: name.copy(),
                first: first,
                count: count,
                ret: ret,
                types: 0,
                regions: 0,
                file: 0,
                pos: 0,
                raw: 0,
                bounds: u64[],
                constraints: u64[][],
                contract: 0,
                owner: 0,
            }
        );
    return ();
}
fn drop_call<a>(c: (&a mut C), ty: u64) -> unit {
    if needs_drop(borrow_mut(c), ty) {
        o(borrow_mut(c), &"call ");
        drop_name(borrow_mut(c), ty);
        c.out.push(10);
    }
    return ();
}
fn emit_drops<a>(c: (&a mut C)) -> unit {
    mut ty = 0;
    while ty < c.types.len() {
        kind := ty_kind(borrow_mut(c), ty);
        arg := ty_arg(borrow_mut(c), ty);
        if concrete_type(borrow_mut(c), ty) {
            if needs_drop(borrow_mut(c), ty) {
                done := label(borrow_mut(c));
                drop_name(borrow_mut(c), ty);
                o(borrow_mut(c), &":\ntestq %rdi,%rdi\n");
                jump(borrow_mut(c), &"jz", done);
                o(
                    borrow_mut(c),
                    &"pushq %rbp\nmovq %rsp,%rbp\npushq %r12\npushq %r13\nmovq %rdi,%r12\n"
                );
                if (kind == 3) + (kind == 4) {
                    o(borrow_mut(c), &"call rt_drop_seq\n");
                }
                if (kind == 5) + (kind == 11) {
                    o(borrow_mut(c), &"call rt_free\n");
                }
                if kind == 16 {
                    o(borrow_mut(c), &"movq %r12,%rdi\ncall rt_task_abandon\n");
                }
                if kind == 20 {
                    o(borrow_mut(c), &"movq %r12,%rdi\nmovq 8(%r12),%rax\ncall *%rax\n");
                }
                if kind == 13 {
                    o(borrow_mut(c), &"movq 8(%r12),%rdi\n");
                    drop_call(borrow_mut(c), arg);
                    o(borrow_mut(c), &"movq %r12,%rdi\ncall rt_free\n");
                }
                if kind == 10 {
                    drop_call(borrow_mut(c), arg);
                }
                if kind == 6 {
                    if needs_drop(borrow_mut(c), arg) {
                        head := label(borrow_mut(c));
                        end := label(borrow_mut(c));
                        o(borrow_mut(c), &"xorq %r13,%r13\n");
                        mark(borrow_mut(c), head);
                        o(borrow_mut(c), &"cmpq 8(%r12),%r13\n");
                        jump(borrow_mut(c), &"jae", end);
                        o(borrow_mut(c), &"movq (%r12),%rax\nmovq (%rax,%r13,8),%rdi\n");
                        drop_call(borrow_mut(c), arg);
                        o(borrow_mut(c), &"incq %r13\n");
                        jump(borrow_mut(c), &"jmp", head);
                        mark(borrow_mut(c), end);
                    }
                    o(borrow_mut(c), &"movq %r12,%rdi\ncall rt_drop_seq\n");
                }
                if kind == 8 {
                    d := &c.decls[arg];
                    count := d.count;
                    is_enum := d.is_enum;
                    for i in count {
                        t := field_type(borrow_mut(c), ty, i);
                        if needs_drop(borrow_mut(c), t) {
                            if is_enum {
                                skip := label(borrow_mut(c));
                                o(borrow_mut(c), &"cmpq $");
                                on(borrow_mut(c), i);
                                o(borrow_mut(c), &",(%r12)\n");
                                jump(borrow_mut(c), &"jne", skip);
                                o(borrow_mut(c), &"movq 8(%r12),%rdi\n");
                                drop_call(borrow_mut(c), t);
                                mark(borrow_mut(c), skip);
                            } else {
                                o(borrow_mut(c), &"movq ");
                                on(borrow_mut(c), i * 8);
                                o(borrow_mut(c), &"(%r12),%rdi\n");
                                drop_call(borrow_mut(c), t);
                            }
                        }
                    }
                    o(borrow_mut(c), &"movq %r12,%rdi\ncall rt_free\n");
                }
                o(borrow_mut(c), &"popq %r13\npopq %r12\nleave\n");
                mark(borrow_mut(c), done);
                o(borrow_mut(c), &"ret\n");
            }
        }
        ty = ty + 1;
    }
    return ();
}
fn emit_exit<a, b>(c: (&a mut C), argument: &b [u8]) -> unit {
    mut number = 231;
    if c.target != 0 {
        number = 94;
    }
    o(borrow_mut(c), &"movl $");
    on(borrow_mut(c), number);
    o(borrow_mut(c), &",%eax\n");
    o(borrow_mut(c), argument);
    o(borrow_mut(c), &"syscall\n");
    return ();
}
pub fn main() -> u64 {
    mut c = C {
        src: u8[],
        toks: Tok[],
        pos: 0,
        out: u8[],
        module: u8[],
        target: 0,
        arg_offset: 0,
        overflow: 1,
        default_u64: 0,
        default_u64_flag: 0,
        specs: Spec[],
        bindings: u64[],
        current_spec: 0,
        validating: 0,
        alias_next: 1,
        types: Ty[],
        decls: Decl[],
        aliases: Alias[],
        imports: Import[],
        fields: Field[],
        funcs: Func[],
        params: u64[],
        locals: Local[],
        next: 0,
        entry: 0,
        file: 0,
        label: 1,
        brk: 0,
        cont: 0,
        raw: 0,
        rnames: u8[][],
        tnames: u8[][],
        closures: Closure[],
        closure_env: 0,
        inherent: 0,
        constants: Constant[],
        impl_params: ImplParams[],
        receiver: 0,
        receiver_ty: 0,
        has_receiver: 0,
        lit_start: 0,
        lit_end: 0,
        lit_value: 0,
        hints: u64[],
        tolerant: 0,
        retry: 0,
        attempts: 0,
        cf_start: 0,
        cf_end: 0,
        cf_local: 0,
        bce_index: u8[],
        bce_base: u8[],
        lit_negative: 0,
        flit_start: 0,
        flit_end: 0,
        flit_tok: 0,
        flit_neg: 0,
        type_bounds: u64[],
        type_interfaces: u64[][],
        interfaces: Interface[],
        implementations: Implementation[],
        self_type: 0,
        current_impl: 0,
        headers_complete: 0,
        resources: Resource[],
        loopmark: 0,
        result: 0,
        check: ownership::new(),
        members: Member[],
        terminated: 0,
        loopcheck: ownership::new(),
        breaks: ownership::new(),
        hasbreak: 0,
        bonds: Bond[],
        origins: Origin[],
        scope_end: 0,
        loop_start: 0,
        loop_end: 0,
        no_union: 0,
        parsing_input: 0,
        output_region: 0,
        receiver_region: 0,
        input_regions: u64[],
        none_start: 0,
        none_end: 0,
    };
    exchange(borrow_mut(c.target), host::target());
    for k in 5 {
        intern(borrow_mut(c), k + 1, 0);
    }
    host_fn(borrow_mut(c), &"target", 0);
    host_fn(borrow_mut(c), &"argc", 0);
    host_fn(borrow_mut(c), &"arg", 2);
    host_fn(borrow_mut(c), &"read_file", 2);
    host_fn(borrow_mut(c), &"write_file", 0);
    host_fn(borrow_mut(c), &"print", 1);
    host_fn(borrow_mut(c), &"print_num", 1);
    host_fn(borrow_mut(c), &"newline", 1);
    host_fn(borrow_mut(c), &"command", 0);
    host_fn(borrow_mut(c), &"sleep_ms", 1);
    host_fn(borrow_mut(c), &"now_ms", 0);
    numbers := intern(borrow_mut(c), 6, 0);
    host_fn(borrow_mut(c), &"pipe", numbers);
    host_fn(borrow_mut(c), &"read_fd", 2);
    host_fn(borrow_mut(c), &"write_fd", 0);
    host_fn(borrow_mut(c), &"close", 0);
    host_fn(borrow_mut(c), &"env", 2);
    host_fn(borrow_mut(c), &"exe_path", 2);
    host_fn(borrow_mut(c), &"exists", 0);
    host_fn(borrow_mut(c), &"mkdir", 0);
    names := intern(borrow_mut(c), 6, 2);
    host_fn(borrow_mut(c), &"list_dir", names);
    host_fn(borrow_mut(c), &"tcp_listen", 0);
    host_fn(borrow_mut(c), &"tcp_port", 0);
    host_fn(borrow_mut(c), &"tcp_accept", 0);
    host_fn(borrow_mut(c), &"tcp_connect", 0);
    host_fn(borrow_mut(c), &"open", 0);
    host_fn(borrow_mut(c), &"exit", 1);
    host_fn(borrow_mut(c), &"remove", 0);
    host_fn(borrow_mut(c), &"create_dir", 0);
    argc := host::argc();
    mut offset = 0;
    if 1 < argc {
        first := host::arg(1);
        if cli::is_command(&first) {
            return cli::run();
        }
    }
    while offset + 1 < argc {
        option := host::arg(offset + 1);
        if same(&option, &"--target") {
            if argc < offset + 3 {
                fail(borrow_mut(c), &"--target needs x86_64, aarch64 or riscv64");
            }
            target := host::arg(offset + 2);
            if same(&target, &"x86_64") {
                exchange(borrow_mut(c.target), 0);
            } else {
                if same(&target, &"aarch64") {
                    exchange(borrow_mut(c.target), 1);
                } else {
                    if same(&target, &"riscv64") {
                        exchange(borrow_mut(c.target), 2);
                    } else {
                        fail(
                            borrow_mut(c),
                            &"unsupported target (expected x86_64, aarch64 or riscv64)"
                        );
                    }
                }
            }
            offset += 2;
        } else {
            if same(&option, &"--overflow=wrap") {
                exchange(borrow_mut(c.overflow), 0);
                offset += 1;
            } else {
                if same(&option, &"--overflow=checked") {
                    exchange(borrow_mut(c.overflow), 1);
                    offset += 1;
                } else {
                    if same(&option, &"--default-u64") {
                        exchange(borrow_mut(c.default_u64), 1);
                        exchange(borrow_mut(c.default_u64_flag), 1);
                        offset += 1;
                    } else {
                        break;
                    }
                }
            }
        }
    }
    exchange(borrow_mut(c.arg_offset), offset);
    n := argc - offset;
    if (2 < n) == 0 {
        fail(
            borrow_mut(c),
            &"usage: grail [--target ARCH] [--overflow=checked|wrap] OUT.s ENTRY.grl MODULE.grl..."
        );
    }
    for pass in 3 {
        if pass == 1 {
            o(borrow_mut(c), &".text\n");
        }
        mut i = 2;
        while i < n {
            load_file(borrow_mut(c), i);
            exchange(borrow_mut(c.file), i);
            toplevel(borrow_mut(c), pass + 1);
            i = i + 1;
        }
        if pass == 1 {
            exchange(borrow_mut(c.headers_complete), 1);
            check_interfaces(borrow_mut(c));
            validate_type_constraints(borrow_mut(c));
        }
    }
    emit_specializations(borrow_mut(c));
    emit_closures(borrow_mut(c));
    emit_drops(borrow_mut(c));
    e := c.entry;
    if e == 0 {
        fail(borrow_mut(c), &"no public entry function with at most one parameter");
    }
    f := &c.funcs[e - 1];
    m := f.module.copy();
    name := f.name.copy();
    count := f.count;
    result := f.ret;
    first := f.first;
    named_main := same(&name, &"main");
    if named_main {
        if (result != 0) & (result != 1) {
            fail(borrow_mut(c), &"main must return unit or u64");
        }
    } else {
        if result != 0 {
            fail(borrow_mut(c), &"executable entry must return u64");
        }
    }
    if count == 1 {
        param := c.params[first];
        mode := ty_mode(borrow_mut(c), param);
        if (ty_kind(borrow_mut(c), param) != 5) + mode {
            fail(borrow_mut(c), &"executable entry requires readonly argv view");
        }
    }
    o(
        borrow_mut(c),
        &".globl _start\n_start:\nmovq (%rsp),%rdi\nleaq 8(%rsp),%rsi\nleaq 16(%rsp,%rdi,8),%rdx\nmovq %rdi,rt_state(%rip)\nmovq %rsi,rt_state+8(%rip)\nmovq %rdx,rt_state+16(%rip)\nandq $-16,%rsp\ncall rt_thread_init\nmovq rt_state(%rip),%rdi\n"
    );
    if count == 1 {
        ok := label(borrow_mut(c));
        o(borrow_mut(c), &"cmpq $2,%rdi\n");
        jump(borrow_mut(c), &"je", ok);
        emit_exit(borrow_mut(c), &"movl $2,%edi\n");
        mark(borrow_mut(c), ok);
        o(
            borrow_mut(c),
            &"movl $1,%edi\ncall f_host_arg\nmovq %rax,%r12\nmovq %rax,%rdi\ncall rt_view\nmovq %rax,%rdi\n"
        );
    }
    o(borrow_mut(c), &"call ");
    mangle(borrow_mut(c), &m, &name);
    if count == 1 {
        o(borrow_mut(c), &"\nmovq %rax,%r13\nmovq %r12,%rdi\ncall rt_drop_seq\nmovq %r13,%rax");
    }
    if named_main {
        if result == 0 {
            o(borrow_mut(c), &"\nmovq %rax,%r14\n");
        } else {
            o(borrow_mut(c), &"\nxorq %r14,%r14\n");
        }
    } else {
        o(borrow_mut(c), &"\nmovq %rax,%rdi\ncall rt_print_num\nxorq %r14,%r14\n");
    }
    o(borrow_mut(c), &"call rt_live\ntestq %rax,%rax\n");
    balanced := label(borrow_mut(c));
    jump(borrow_mut(c), &"jz", balanced);
    o(borrow_mut(c), &"call rt_abort\n");
    mark(borrow_mut(c), balanced);
    o(borrow_mut(c), &"call rt_shutdown\n");
    emit_exit(borrow_mut(c), &"movq %r14,%rdi\n");
    o(
        borrow_mut(c),
        &"ud2\n.bss\n.p2align 3\nrt_state: .zero 4096\n.section .note.GNU-stack,\"\",@progbits\n"
    );
    out := optimize::optimize(&c.out);
    path := host::arg(1 + offset);
    target := c.target;
    if target == 0 {
        return host::write_file(&path, &out);
    }
    native := machine::lower(&out, target);
    return host::write_file(&path, &native);
}
