    }
    if k == 22 {
        expect(borrow_mut(c), &")");
        observe(borrow_mut(c), xt);
        mut f = "";
        mut result = bool_type(borrow_mut(c));
        if same(&name, &"is_alphabetic") {
            f = "rt_char_is_alpha";
        }
        if same(&name, &"is_alphanumeric") {
            f = "rt_char_is_alnum";
        }
        if same(&name, &"is_ascii_digit") {
            f = "rt_char_is_digit";
        }
        if same(&name, &"is_whitespace") {
            f = "rt_char_is_space";
        }
        if same(&name, &"is_uppercase") {
            f = "rt_char_is_upper";
        }
        if same(&name, &"is_lowercase") {
            f = "rt_char_is_lower";
        }
        if same(&name, &"is_ascii") {
            f = "rt_char_is_ascii";
        }
        if same(&name, &"to_uppercase") {
            f = "rt_char_upper";
            result = xty;
        }
        if same(&name, &"to_lowercase") {
            f = "rt_char_lower";
            result = xty;
