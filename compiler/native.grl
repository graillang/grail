    if is_char(&mut c, ty) {
        return negative == 0 && value < 1114112 && !((55295 < value) && (value < 57344));
    }
    bits := ty_arg(&mut c, ty);
    signed := ty_mode(&mut c, ty);
    mut max = 18446744073709551615;
    if bits < 64 {
        max = 1;
        for i in bits {
            max = max * 2;
        }
        max = max - 1;
    }
    if signed != 0 {
        half := max / 2;
        if negative != 0 {
            return (value < half + 2);
        }
        return (value < half + 1);
    }
    if negative != 0 {
        return value == 0;
    }
    return u64(value < max || value == max);
}
// A closure that writes nothing is `Fn`; it can be used where `FnMut` is expected, because a call
// that takes exclusive access is stricter than the shared call an `Fn` promises. The value is the
// same record, so this only widens the call contract - but it still moves, never copies, so the
// environment keeps one owner.
fn fn_as_fnmut<a>(c: (&a mut C), ty: u64, expected: u64) -> u64 {
    if ty_mode(&mut c, ty) != 0 {
        return 0;
    }
    if ty_mode(&mut c, expected) != 1 {
        return 0;
