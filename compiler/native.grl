// A handle (kind 23) or bare pointer (kind 26) is the one kind of value C cannot produce as a
// result alone: the Vulkan/D3D12/Metal shape `vkCreateInstance(..., VkInstance *pInstance)` writes it
// through an out-parameter. The parameter is `&mut H` and the callee writes the new word into the
// caller's slot; a binding declared without an initializer starts as null, so the slot always has a
// defined value before the call.
fn ffi_out_slot_type<a>(c: (&a mut C), ty: u64) -> bool {
    return (ty_kind(&mut c, ty) == 23) || (ty_kind(&mut c, ty) == 26);
}
// `p: &mut Instance` in an extern declaration: a mutable borrow of a handle or bare pointer binding.
// Only a mutable borrow is a writable slot - `&H` would hand C a `const H *` it cannot store through.
fn ffi_out_param<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 7 {
        return false;
    }
    if ty_mode(&mut c, ty) == 0 {
        return false;
    }
    inner := ty_arg(&mut c, ty);
    return ffi_out_slot_type(&mut c, inner);
}
fn ffi_param<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    // u64 is the portable one-word type at index 0; i64/isize is the 64-bit signed
    // integer. Handles (kind 23) and CStr (kind 24) are one-word C pointers, and a
    // byte view (kind 5) is passed as pointer plus length.
    if ty == 0 {
        return ();
    }
    k := ty_kind(&mut c, ty);
    if (k == 18) & (ty_arg(&mut c, ty) == 64) {
        return ();
    }
    if (k == 23) || (k == 24) || (k == 5) || (k == 25) || (k == 26) {
        return ();
    }
    if k == 8 {
        // A record parameter is the C pointer to the struct's fields; Grail keeps
        // ownership of the allocation, so C must not free it.
        if c.decls[ty_arg(&mut c, ty)].c_layout != 0 {
            return ();
        }
    }
    if k == 7 {
        inner := ty_arg(&mut c, ty);
        if ffi_out_slot_type(&mut c, inner) {
            if ty_mode(&mut c, ty) != 0 {
                return ();
            }
            fail(&mut c, view("an extern C out-parameter needs &mut; a shared &H is the C const pointer"));
        }
        fail(&mut c, view("an extern C out-parameter must be &mut a handle, CPtr or CMutPtr"));
    }
    fail(&mut c, what);
    return ();
}
fn ffi_result<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    // A result is one word: scalars, a C handle or a C string pointer. A byte view
    // result is rejected because C cannot produce a Grail view record.
    if (ty == 0) || (ty == 1) {
        return ();
    }
    k := ty_kind(&mut c, ty);
    if (k == 18) & (ty_arg(&mut c, ty) == 64) {
        return ();
    }
    if (k == 23) || (k == 24) || (k == 25) || (k == 26) {
        // A function-pointer result is how a dynamic loader hands back a resolved
        // symbol; the declaration states the signature the address is called with.
        return ();
    }
    fail(&mut c, what);
    return ();
}
// ---- C-layout records ----
// `extern record R { a: i64, b: i32 }` uses the C rules: natural alignment,
// padding between fields, tail padding to the record alignment, offsets equal to
// C's offsetof. Field access reads and writes exactly the field's width.
fn ffi_align_up(n: u64, a: u64) -> u64 {
    if a < 2 {
        return n;
    }
    r := n % a;
    if r == 0 {
        return n;
    }
    return n + a - r;
}
fn ffi_layout_fail<a>(c: (&a mut C)) -> unit {
    // Ordinary Grail records are heap pointers and cannot be embedded; extern records embed by
    // value (their bytes at the field's C offset).
    fail(&mut c, view("extern record fields must be 8/16/32/64-bit integers, f32, f64, handles, CStr or extern records"));
    return ();
}
fn is_c_record<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) != 8 {
        return 0;
    }
    d := ty_arg(&mut c, ty);
    if c.decls[d].is_enum != 0 {
        return 0;
    }
    return c.decls[d].c_layout;
}
fn ffi_field_align<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    // An embedded extern record: its bytes in place, with its own C alignment and size.
    if is_c_record(&mut c, ty) != 0 {
        inner := ty_arg(&mut c, ty);
        return ffi_record_align(&mut c, inner);
    }
    // f32 is C float (4 bytes), f64 is C double (8 bytes).
    if k == 21 {
        if is_f32(&mut c, ty) {
            return 4;
        }
        return 8;
    }
    if (k == 23) || (k == 24) || (k == 26) {
        return 8;
    }
    if k == 18 {
        bits := ty_arg(&mut c, ty);
        if (bits == 8) || (bits == 16) || (bits == 32) || (bits == 64) {
            return bits / 8;
        }
    }
    ffi_layout_fail(&mut c);
    return 0;
}
fn ffi_field_size<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    // An embedded extern record: its bytes in place, with its own C alignment and size.
    if is_c_record(&mut c, ty) != 0 {
        inner := ty_arg(&mut c, ty);
        return ffi_record_size(&mut c, inner);
    }
    // f32 is C float (4 bytes), f64 is C double (8 bytes).
    if k == 21 {
        if is_f32(&mut c, ty) {
            return 4;
        }
        return 8;
    }
    if (k == 23) || (k == 24) || (k == 26) {
        return 8;
    }
    if k == 18 {
        bits := ty_arg(&mut c, ty);
        if (bits == 8) || (bits == 16) || (bits == 32) || (bits == 64) {
            return bits / 8;
        }
    }
    ffi_layout_fail(&mut c);
    return 0;
}
fn ffi_record_align<a>(c: (&a mut C), d: u64) -> u64 {
    count := c.decls[d].count;
    mut a = 1;
    mut i = 0;
    while i < count {
        ty := field_ty(&mut c, d, i);
        x := ffi_field_align(&mut c, ty);
        if a < x {
            a = x;
        }
        i = i + 1;
    }
    return a;
}
fn ffi_record_size<a>(c: (&a mut C), d: u64) -> u64 {
    count := c.decls[d].count;
    mut off = 0;
    mut i = 0;
    while i < count {
        ty := field_ty(&mut c, d, i);
        al := ffi_field_align(&mut c, ty);
        off = ffi_align_up(off, al) + ffi_field_size(&mut c, ty);
        i = i + 1;
    }
    return ffi_align_up(off, ffi_record_align(&mut c, d));
}
// Allocation granule: the record size rounded up to whole eight-byte words.
fn ffi_record_words<a>(c: (&a mut C), d: u64) -> u64 {
    return ffi_align_up(ffi_record_size(&mut c, d), 8) / 8;
}
fn ffi_offset<a>(c: (&a mut C), d: u64, k: u64) -> u64 {
    mut off = 0;
    mut i = 0;
    while i < k {
        ty := field_ty(&mut c, d, i);
        al := ffi_field_align(&mut c, ty);
        off = ffi_align_up(off, al) + ffi_field_size(&mut c, ty);
        i = i + 1;
    }
    ty := field_ty(&mut c, d, k);
    return ffi_align_up(off, ffi_field_align(&mut c, ty));
}
fn ffi_field<a>(c: (&a mut C), ty: u64) -> unit {
    ffi_field_size(&mut c, ty);
    return ();
}
fn ffi_record<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("record"));
    name := ident(&mut c);
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    if pass != 2 {
        if pass == 1 {
            m := module_copy(&mut c);
            c
                .decls
                .push(
                    Decl {
                        module: m,
                        name: name,
                        is_enum: 0,
                        opaque: 0,
                        c_layout: 1,
                        first: 0,
                        count: 0,
                        regions: 0,
                        types: 0,
                        success: 0,
                        bounds: u64[],
                        constraints: u64[][],
                    }
                );
        }
        while !is(&mut c, view("}")) {
            if kind(&mut c) == 0 {
                fail(&mut c, view("unterminated extern record"));
            }
            advance(&mut c);
        }
        advance(&mut c);
        eat(&mut c, view(";"));
        return ();
    }
    m := module_copy(&mut c);
    d := find_decl(&mut c, view(m), view(name));
    if d == 0 {
        fail(&mut c, view("unknown extern record"));
    }
    mut pending = Field[];
    mut count = 0;
    expect(&mut c, view("{"));
    if !eat(&mut c, view("}")) {
        while true {
            f := ident(&mut c);
            expect(&mut c, view(":"));
            ty := parse_type(&mut c);
            ffi_field(&mut c, ty);
            pending.push(Field { name: f, ty: ty });
            count = count + 1;
            if eat(&mut c, view("}")) {
                break;
            }
            expect(&mut c, view(","));
            if eat(&mut c, view("}")) {
                break;
            }
        }
    }
    eat(&mut c, view(";"));
    mut reverse = Field[];
    while pending.len() != 0 {
        reverse.push(pending.pop());
    }
    first := c.fields.len();
    while reverse.len() != 0 {
        c.fields.push(reverse.pop());
    }
    exchange(
        &mut c.decls[d - 1],
        Decl {
            module: m,
            name: name,
            is_enum: 0,
            opaque: 0,
            c_layout: 1,
            first: first,
            count: count,
            regions: 0,
            types: 0,
            success: 0,
            bounds: u64[],
            constraints: u64[][],
        }
    );
    return ();
}
fn export_name<a, b, d, e>(c: (&a mut C), m: &b [u8], n: &d [u8], symbol: &e [u8], export: u64) -> unit {
    if export == 2 {
        // The C symbol may differ from the Grail name (`as "name"`). Mach-O C symbols carry a
        // leading underscore, which references already get (darwin_line) and definitions must too.
        if c.plat == 1 {
            c.out.push(95);
        }
        o(&mut c, symbol);
        return ();
    }
    mangle(&mut c, view(m), view(n));
    return ();
}
// Does the declaration at `start` (the `fn` keyword) have a body? Scans to the first
// `{` or `;` at bracket depth zero, so a body can be handed to the normal function
// parser and a plain declaration stays a declaration.
fn extern_has_body<a>(c: (&a mut C), start: u64) -> u64 {
    mut i = start;
    mut depth = 0;
    while i < c.toks.len() {
        k := kind_at(&mut c, i);
        if (k == 40) || (k == 60) || (k == 91) {
            depth += 1;
        }
        if (k == 41) || (k == 62) || (k == 93) {
            depth -= 1;
        }
        if depth == 0 {
            if k == 123 {
                return 1;
            }
            if (k == 59) || (k == 125) {
                return 0;
            }
        }
        i += 1;
    }
    return 0;
}
fn ffi_string<a, b>(c: (&a mut C), what: &b [u8]) -> u8[] {
    if kind(&mut c) != 3 {
        fail(&mut c, what);
    }
    p := c.pos;
    advance(&mut c);
    return decode_literal(&mut c, p);
}
fn ffi_link<a, b>(c: (&a mut C), input: &b [u8]) -> unit {
    for i in c.libs.len() {
        if same(view(c.libs[i]), view(input)) {
            return ();
        }
    }
    c.libs.push(input.copy());
    return ();
}
fn extern_declaration<a>(c: (&a mut C), pass: u64, public: u64) -> unit {
    position := c.pos;
    expect(&mut c, view("extern"));
    abi := ffi_string(&mut c, view("extern requires a quoted ABI name"));
    if !same(view(abi), view("C")) {
        fail(&mut c, view("only extern \"C\" declarations are supported"));
    }
    mut input = u8[];
    mut symbol = u8[];
    while true {
        if eat(&mut c, view("lib")) {
            input = ffi_string(&mut c, view("lib requires a quoted link input"));
        } else {
            if eat(&mut c, view("as")) {
                symbol = ffi_string(&mut c, view("as requires a quoted C symbol name"));
            } else {
                break;
            }
        }
    }
    if is(&mut c, view("record")) {
        if 0 < input.len() + symbol.len() {
            fail(&mut c, view("extern record takes no lib or as clause"));
        }
        ffi_record(&mut c, pass);
        return ();
    }
    fn_position := c.pos;
    body := extern_has_body(&mut c, fn_position);
    expect(&mut c, view("fn"));
    name := ident(&mut c);
    if body != 0 {
        // `extern "C" fn name(...) -> R { ... }` defines a Grail function that C can
        // call: it is emitted with the stated (unmangled) symbol and its signature
        // must sit inside the C ABI slice. The normal function parser emits the body.
        mut exported = symbol;
        if exported.len() == 0 {
            exported = name.copy();
        }
        exchange(&mut c.pending_ext, 2);
        exchange(&mut c.pending_symbol, exported);
        exchange(&mut c.pos, fn_position);
        func(&mut c, pass, public);
        exchange(&mut c.pending_ext, 0);
        exchange(&mut c.pending_symbol, u8[]);
        return ();
    }
    if pass != 2 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        expect(&mut c, view(";"));
        return ();
    }
    if symbol.len() == 0 {
        symbol = name.copy();
    }
    // Byte-view parameters need an input lifetime context, exactly like a Grail
    // function signature; the region is irrelevant to the C ABI.
    exchange(&mut c.input_regions, u64[]);
    exchange(&mut c.receiver_region, 0);
    exchange(&mut c.parsing_input, 1);
    first := c.params.len();
    mut count = 0;
    mut words = 0;
    mut variadic = 0;
    expect(&mut c, view("("));
    if !eat(&mut c, view(")")) {
        while true {
            // `...` ends the fixed parameters of a variadic C function (printf-style).
            if eat(&mut c, view(".")) {
                expect(&mut c, view("."));
                expect(&mut c, view("."));
                if count == 0 {
                    fail(&mut c, view("a variadic extern C function needs at least one fixed parameter"));
                }
                variadic = 1;
                expect(&mut c, view(")"));
                break;
            }
            p := ident(&mut c);
            expect(&mut c, view(":"));
            mut ty = 0;
            if ffi_byval_ahead(&mut c) {
                advance(&mut c);
                ty = ffi_byval_parameter(&mut c);
            } else {
                ty = parse_type(&mut c);
            }
            ffi_direct_param(
                &mut c,
                ty,
                view("extern C parameters must be an integer, f32, f64, CStr, handle, byte view, cfn, extern record or byval record")
            );
            words = words + ffi_words(&mut c, ty);
            c.params.push(ty);
            count = count + 1;
            if eat(&mut c, view(")")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    if 64 < words {
        fail(&mut c, view("extern C declaration exceeds 64 argument words"));
    }
    mut ret = 1;
    if eat(&mut c, view("->")) {
        ret = parse_type(&mut c);
        ffi_direct_result(&mut c, ret, view("extern C results must be an integer, f32, f64, unit, CStr, handle or cfn"));
    }
    expect(&mut c, view(";"));
    m := module_copy(&mut c);
    if find_func(&mut c, view(m), view(name)) != 0 {
        fail(&mut c, view("duplicate function"));
    }
    if 0 < input.len() {
        if (c.target == 3) || (c.target == 4) {
            // A PE image binds each symbol to one DLL through the import table, so Windows tooling
            // needs the pair, not just the library: `// grail-link: import kernel32 LoadLibraryA`.
            mut note = u8[];
            push_bytes(&mut note, view("import "));
            push_bytes(&mut note, view(input));
            note.push(32);
            push_bytes(&mut note, view(symbol));
            ffi_link(&mut c, view(note));
        } else {
            ffi_link(&mut c, view(input));
        }
    }
    c
        .funcs
        .push(
            Func {
                module: m,
                name: name,
                first: first,
                count: count,
                ret: ret,
                types: 0,
                regions: 0,
                file: c.file,
                pos: position,
                raw: c.raw,
                bounds: u64[],
                constraints: u64[][],
                contract: 0,
                owner: 0,
                ext: 1 + variadic,
                symbol: symbol,
            }
        );
    return ();
}
fn func<a>(c: (&a mut C), pass: u64, public: u64) -> unit {
    position := c.pos;
    out_mark := c.out.len();
    fact_mark := llvm::facts_len(&c.facts);
    part_mark := c.part.copy();
    closure_mark := c.closures.len();
    mut dstart = 0;
    mut dend = 0;
    expect(&mut c, view("fn"));
    mut name = ident(&mut c);
    lifetime_parameters(&mut c);
    exchange(&mut c.input_regions, u64[]);
    exchange(&mut c.receiver_region, 0);
    exchange(&mut c.output_region, 0);
    exchange(&mut c.parsing_input, 1);
    if c.inherent != 0 {
        prepend_impl_params(&mut c);
    }
    if same(view(name), view("print")) || same(view(name), view("println")) {
        fail(&mut c, view("print and println are reserved prelude names"));
    }
    typecount := c.tnames.len();
    regioncount := c.rnames.len();
    if (pass == 3) & (typecount != 0) {
        while kind(&mut c) != 123 {
            advance(&mut c);
        }
        skip_braces(&mut c);
        return ();
    }
    if pass == 1 {
        while kind(&mut c) != 123 {
            advance(&mut c);
        }
        skip_braces(&mut c);
        return ();
    }
    mut m = module_copy(&mut c);
    export := c.pending_ext;
    export_symbol := c.pending_symbol.copy();
    if c.current_impl != 0 {
        m = private_module(view(".impl_"), c.current_impl);
    }
    if c.inherent != 0 {
        m = private_module(view(".inherent_"), c.inherent - 1);
    }
    exchange(&mut c.locals, Local[]);
    // The call-flex hint record indexes `locals` and names token positions of the function being
    // compiled, so it cannot outlive that function's token stream.
    exchange(&mut c.cf_start, 0);
    exchange(&mut c.cf_end, 0);
    exchange(&mut c.cf_local, 0);
    exchange(&mut c.none_start, 0);
    exchange(&mut c.none_end, 0);
    exchange(&mut c.debug_vars, DebugVar[]);
    exchange(&mut c.resources, Resource[]);
    exchange(&mut c.next, 0);
    // Facts are keyed by the symbol this body will be lifted under, and the `rt_f64_op` ordinals
    // restart with it. Both are known before the signature is parsed, so parameters get facts too.
    mut label = name.copy();
    if c.current_spec != 0 {
        spec := c.current_spec;
        label = special_name(&mut c, spec - 1);
    }
    sym := body_label(&c, view(m), view(label), view(export_symbol), export);
    exchange(&mut c.facts_fn, sym);
    exchange(&mut c.f64_ops, 0);
    exchange(&mut c.call_ord, 0);
    // The F1 call ordinals are per callee *and per function*, exactly as the lifter counts them.
    exchange(&mut c.f1_names, u8[][]);
    exchange(&mut c.f1_counts, u64[]);
    exchange(&mut c.scope_end, 0);
    exchange(&mut c.loop_start, 0);
    exchange(&mut c.loop_end, 0);
    exchange(&mut c.check, ownership::new());
    exchange(&mut c.members, Member[]);
    exchange(&mut c.terminated, 0);
    exchange(&mut c.bonds, Bond[]);
    exchange(&mut c.origins, Origin[]);
    first := c.params.len();
    mut count = 0;
    expect(&mut c, view("("));
    if !eat(&mut c, view(")")) {
        while true {
            p := ident(&mut c);
            expect(&mut c, view(":"));
            if ffi_byval_ahead(&mut c) {
                fail(
                    &mut c,
                    view("byval is only for an extern \"C\" declaration parameter; a C callback cannot take a record by value yet")
                );
            }
            ty := parse_type(&mut c);
            if same(view(p), view("self")) & (ty_kind(&mut c, ty) == 7) {
                rr := outer_region(&mut c, ty);
                exchange(&mut c.receiver_region, rr);
            }
            if pass == 2 {
                c.params.push(ty);
            }
            id := fresh(&mut c);
            bind(&mut c, p, ty, id, 0);
            if c.debug != 0 {
                n := c.debug_vars.len();
                if n != 0 {
                    mut v = &mut c.debug_vars[n - 1];
                    exchange(&mut v.param, 1);
                }
            }
            count = count + 1;
            if eat(&mut c, view(")")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    exchange(&mut c.parsing_input, 0);
    if c.receiver_region != 0 {
        exchange(&mut c.output_region, c.receiver_region);
    } else {
        if c.input_regions.len() == 1 {
            exchange(&mut c.output_region, c.input_regions[0]);
        }
    }
    mut ret = 1;
    if eat(&mut c, view("->")) {
        ret = parse_type(&mut c);
    }
    exchange(&mut c.output_region, 0);
    exchange(&mut c.result, ret);
    if pass == 2 {
        if find_func(&mut c, view(m), view(name)) != 0 {
            fail(&mut c, view("duplicate function"));
        }
        if export != 0 {
            // The body is Grail, but C will call it: every parameter and the result
            // must live in the C ABI slice, and the symbol is the stated C name.
            ffi_callback_fits(&mut c, first, count);
            for i in count {
                formal := c.params[first + i];
                if ffi_out_param(&mut c, formal) {
                    // Grail has no deref-assignment, so a callback cannot store through the pointer
                    // C hands it; only a declaration Grail calls writes the slot from Grail's side.
                    fail(
                        &mut c,
                        view("an out-parameter is only for an extern \"C\" declaration parameter; a C callback cannot take one")
                    );
                }
                if !(is_float(&mut c, formal) || ffi_narrow(&mut c, formal).len() != 0) {
                    ffi_param(
                        &mut c,
                        formal,
                        view("extern C callback parameters must be an integer, f32, f64, CStr, handle, byte view or cfn")
                    );
                }
            }
            if ret != 1 {
                if !(is_float(&mut c, ret) || ffi_narrow(&mut c, ret).len() != 0) {
                    ffi_result(&mut c, ret, view("extern C callback results must be an integer, f32, f64, unit, CStr or handle"));
                }
            }
            if export_symbol.len() == 0 {
                fail(&mut c, view("extern C definition needs a symbol"));
            }
        }
        main := (c.file == 2) & (c.current_impl == 0) & (c.inherent == 0) & same(view(name), view("main"));
        if main {
            if (1 < count) || (typecount != 0) {
                fail(
                    &mut c,
                    view("main needs zero arguments or one readonly byte view and no type parameters")
                );
            }
        }
        entry := main
            || (
                c.current_impl == 0
                    && c.inherent == 0
                    && c.entry == 0
                    && c.file == 2
                    && public != 0
                    && count < 2
                    && typecount == 0
            );
        file := c.file;
        raw := c.raw;
        bounds := copy_numbers(&c.type_bounds);
        constraints := copy_constraints(&c.type_interfaces);
        c
            .funcs
            .push(
                Func {
                    module: m,
                    name: name,
                    first: first,
                    count: count,
                    ret: ret,
                    types: typecount,
                    regions: c.rnames.len(),
                    file: file,
                    pos: position,
                    raw: raw,
                    bounds: bounds,
                    constraints: constraints,
                    contract: 0,
                    owner: c.inherent,
                    ext: export,
                    symbol: export_symbol,
                }
            );
        index := c.funcs.len();
        if entry {
            exchange(&mut c.entry, index);
        }
        skip_braces(&mut c);
        return ();
    }
    if c.current_spec != 0 {
        spec := c.current_spec;
        name = special_name(&mut c, spec - 1);
    }
    start := c.pos;
    end := block_end(&mut c, start);
    exchange(&mut c.scope_end, end);
    for i in c.locals.len() {
        mut l = &c.locals[i];
        name := l.name.copy();
        last := last_name(&mut c, view(name), start, end);
        mut l = &mut c.locals[i];
        exchange(&mut l.last, last);
    }
    // On Win64 a C caller passes rcx/rdx/r8/r9 (then the stack after a 32-byte home area) and
    // expects rdi, rsi and xmm6-xmm15 preserved; the body uses Grail's SysV-shaped convention. A
    // callback is therefore a Win64 thunk under the C symbol that saves those registers, moves
    // the arguments and calls the body, which is emitted under `<symbol>_grail_body`.
    unit := unit_module(&mut c, view(m));
    part(&mut c, view(unit));
    mut body_symbol = u8[];
    push_bytes(&mut body_symbol, view(export_symbol));
    if (c.target == 3) & (export == 2) {
        push_bytes(&mut body_symbol, view("_grail_body"));
        if exported(&mut c, view(name)) != 0 {
            o(&mut c, view(".globl "));
            o(&mut c, view(export_symbol));
            c.out.push(10);
        }
        o(&mut c, view(export_symbol));
        o(&mut c, view(":\npushq %rdi\npushq %rsi\nsubq $168,%rsp\n"));
        for x in 10 {
            o(&mut c, view("movdqu %xmm"));
            on(&mut c, x + 6);
            c.out.push(44);
            on(&mut c, x * 16);
            o(&mut c, view("(%rsp)\n"));
        }
        // Entry rsp + 40 holds argument five; after two pushes and 168 bytes it is rsp + 224.
        o(&mut c, view("movq %rcx,%rdi\nmovq %rdx,%rsi\nmovq %r8,%rdx\nmovq %r9,%rcx\nmovq 224(%rsp),%r8\nmovq 232(%rsp),%r9\ncall "));
        o(&mut c, view(body_symbol));
        c.out.push(10);
        for x in 10 {
            o(&mut c, view("movdqu "));
            on(&mut c, x * 16);
            o(&mut c, view("(%rsp),%xmm"));
            on(&mut c, x + 6);
            c.out.push(10);
        }
        o(&mut c, view("addq $168,%rsp\npopq %rsi\npopq %rdi\nret\n"));
    } else {
        if exported(&mut c, view(name)) != 0 {
            o(&mut c, view(".globl "));
            export_name(&mut c, view(m), view(name), view(export_symbol), export);
            c.out.push(10);
        }
    }
    exchange(&mut c.caddr, u64[]);
    func_directive(&mut c, view(m), view(name), view(body_symbol), export);
    if (c.debug != 0) & (c.validating == 0) {
        dstart = label(&mut c);
        mark(&mut c, dstart);
        if c.target == 3 {
            // CodeView numbers functions densely in record order; this one will be recorded next.
            fid := c.debug_funcs.len();
            o(&mut c, view(".cv_func_id "));
            on(&mut c, fid);
            c.out.push(10);
        }
    }
    export_name(&mut c, view(m), view(name), view(body_symbol), export);
    o(&mut c, view(":\npushq %rbp\nmovq %rsp,%rbp\n"));
    frame := label(&mut c);
    if c.target == 4 {
        o(&mut c, view("framesub .F"));
        on(&mut c, frame);
        c.out.push(10);
    } else {
        o(&mut c, view("subq $.F"));
        on(&mut c, frame);
        o(&mut c, view(",%rsp\n"));
    }
    if export == 2 {
        callback_params(&mut c, count);
        mut fret = 0;
        if ret != 1 {
            if is_float(&mut c, ret) {
                fret = 1;
                if is_f32(&mut c, ret) {
                    fret = 2;
                }
            }
        }
        exchange(&mut c.export_fret, fret);
    } else {
        exchange(&mut c.export_fret, 0);
        store_params(&mut c, count);
    }
    o(&mut c, view("leaq -.F"));
    on(&mut c, frame);
    o(&mut c, view("(%rbp),%rdi\nmovq $.F"));
    on(&mut c, frame);
    o(&mut c, view("/8-"));
    on(&mut c, count);
    o(&mut c, view(",%rcx\nxorl %eax,%eax\nrep stosq\n"));
    for i in count {
        mut l = &c.locals[i];
        slot := l.id;
        ty := l.ty;
        own(&mut c, slot, ty);
        init_parameter(&mut c, slot, ty);
    }
    mut tls_slot = 0;
    if (export == 2) & tls_bridge(&mut c) {
        tls_slot = fresh(&mut c);
        tls_get(&mut c, tls_slot);
        tls_set_global(&mut c, view("rt_grail_tls"));
        exchange(&mut c.export_tls, tls_slot);
    }
    block(&mut c);
    exchange(&mut c.export_tls, 0);
    if c.raw == 0 {
        if (c.terminated == 0) & (ret != 1) {
            fail(&mut c, view("function may fall through without return"));
        }
    }
    cleanup(&mut c, 0);
    if tls_slot != 0 {
        tls_set_slot(&mut c, tls_slot);
    }
    o(&mut c, view("xorq %rax,%rax\nleave\nret\n.set .F"));
    on(&mut c, frame);
    c.out.push(44);
    n := c.next;
    on(&mut c, div(n + 1, 2) * 16);
    c.out.push(10);
    if (c.debug != 0) & (c.validating == 0) {
        dend = label(&mut c);
        mark(&mut c, dend);
    }
    // A literal binding learned its type from a later use: discard this attempt and recompile.
    if c.retry != 0 {
        exchange(&mut c.part, part_mark);
        while out_mark < c.out.len() {
            c.out.pop();
        }
        // Facts describe the text just discarded, so they go with it.
        llvm::facts_truncate(&mut c.facts, fact_mark);
        while closure_mark < c.closures.len() {
            c.closures.pop();
        }
        exchange(&mut c.retry, 0);
        exchange(&mut c.tolerant, 0);
        a := c.attempts + 1;
        exchange(&mut c.attempts, a);
        exchange(&mut c.pos, position);
        func(&mut c, pass, public);
        exchange(&mut c.attempts, 0);
        return ();
    }
    if (c.debug != 0) & (c.validating == 0) {
        site := DebugSite {
            file: c.file - 1,
            line: source_line(&c, position),
            start: dstart,
            end: dend,
            params: count
        };
        record_debug_func(&mut c, view(name), view(m), &site);
    }
    exchange(&mut c.hints, u64[]);
    return ();
}
fn interface_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    if c.raw != 0 {
        fail(&mut c, view("unsafe runtime cannot publish safe interfaces"));
    }
    expect(&mut c, view("interface"));
    name := ident(&mut c);
    if same(view(name), view("Send")) || same(view(name), view("Share")) {
        fail(&mut c, view("structural capability names are reserved"));
    }
    module := module_copy(&mut c);
    id := ensure_interface(&mut c, module, name);
    if pass == 1 {
        item := &c.interfaces[id - 1];
        defined := item.defined;
        if defined != 0 {
            fail(&mut c, view("duplicate interface"));
        }
        item := &mut c.interfaces[id - 1];
        exchange(&mut item.defined, 1);
        if !is(&mut c, view("{")) {
            fail(&mut c, view("expected interface body"));
        }
        skip_braces(&mut c);
        return ();
    }
    if pass == 3 {
        skip_braces(&mut c);
        return ();
    }
    expect(&mut c, view("{"));
    proof := intern(&mut c, 15, id);
    mut proofs = u64[];
    proofs.push(proof);
    self := intern_args(&mut c, 9, 0, 0, u64[], proofs);
    exchange(&mut c.self_type, self + 1);
    while !eat(&mut c, view("}")) {
        expect(&mut c, view("fn"));
        name := ident(&mut c);
        lifetime_parameters(&mut c);
        if c.tnames.len() != 0 {
            fail(&mut c, view("interface method type parameters are not implemented yet"));
        }
        module := private_module(view(".interface_"), id);
        if find_func(&mut c, view(module), view(name)) != 0 {
            fail(&mut c, view("duplicate interface method"));
        }
        first := c.params.len();
        expect(&mut c, view("("));
        mut count = 0;
        if !eat(&mut c, view(")")) {
            while true {
                ident(&mut c);
                expect(&mut c, view(":"));
                ty := parse_type(&mut c);
                c.params.push(ty);
                count += 1;
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        mut ret = 1;
        if eat(&mut c, view("->")) {
            ret = parse_type(&mut c);
        }
        expect(&mut c, view(";"));
        mut bounds = u64[0];
        mut requirements = u64[][];
        requirements.push(u64[id]);
        regions := c.rnames.len();
        c
            .funcs
            .push(
                Func {
                    module: module,
                    name: name,
                    first: first,
                    count: count,
                    ret: ret,
                    types: 1,
                    regions: regions,
                    file: 0,
                    pos: 0,
                    raw: 0,
                    bounds: bounds,
                    constraints: requirements,
                    contract: id,
                    owner: 0,
                    ext: 0,
                    symbol: u8[],
                }
            );
        index := c.funcs.len() - 1;
        item := &mut c.interfaces[id - 1];
        item.methods.push(index);
    }
    exchange(&mut c.self_type, 0);
    return ();
}
fn impl_has_for<a>(c: (&a mut C)) -> bool {
    mut i = c.pos;
    while (kind_at(&mut c, i) != 123) & (kind_at(&mut c, i) != 0) {
        t := tok_text(&mut c, i);
        if same(view(t), view("for")) {
            return true;
        }
        i += 1;
    }
    return false;
}
fn impl_record<a>(c: (&a mut C), owner: u64) -> u64 {
    for i in c.impl_params.len() {
        p := &c.impl_params[i];
        if p.decl == owner {
            return i + 1;
        }
    }
    return 0;
}
fn impl_self<a>(c: (&a mut C), owner: u64) -> u64 {
    r := impl_record(&mut c, owner);
    if r != 0 {
        p := &c.impl_params[r - 1];
        return p.self_ty;
    }
    return intern_args(&mut c, 8, owner - 1, 0, u64[], u64[]);
}
fn prepend_impl_params<a>(c: (&a mut C)) -> unit {
    owner := c.inherent;
    r := impl_record(&mut c, owner);
    if r == 0 {
        return ();
    }
    p := &c.impl_params[r - 1];
    mut rn = copy_names(&p.rnames);
    mut tn = copy_names(&p.tnames);
    mut bd = copy_numbers(&p.bounds);
    mut it = copy_constraints(&p.interfaces);
    own_r := copy_names(&c.rnames);
    for i in own_r.len() {
        x := &own_r[i];
        rn.push(x.copy());
    }
    own_t := copy_names(&c.tnames);
    for i in own_t.len() {
        x := &own_t[i];
        tn.push(x.copy());
    }
    own_b := copy_numbers(&c.type_bounds);
    for i in own_b.len() {
        bd.push(own_b[i]);
    }
    own_i := copy_constraints(&c.type_interfaces);
    for i in own_i.len() {
        it.push(copy_numbers(&own_i[i]));
    }
    exchange(&mut c.rnames, rn);
    exchange(&mut c.tnames, tn);
    exchange(&mut c.type_bounds, bd);
    exchange(&mut c.type_interfaces, it);
    return ();
}
fn implementation<a>(c: (&a mut C), pass: u64) -> unit {
    if c.raw != 0 {
        fail(&mut c, view("unsafe runtime cannot implement safe interfaces"));
    }
    expect(&mut c, view("impl"));
    // `impl Type { fn ... }`: methods and associated functions of a nominal type in this module.
    if ((kind(&mut c) == 1) & (next_kind(&mut c) == 123))
        || is(&mut c, view("<"))
        || (
            (kind(&mut c) == 1)
                & (next_kind(&mut c) == 60)
                & !impl_has_for(&mut c)
        ) {
        if pass == 1 {
            while !is(&mut c, view("{")) {
                advance(&mut c);
            }
            skip_braces(&mut c);
            return ();
        }
        // impl<T> Stack<T> { ... }: the impl's parameters are prepended to every method's.
        exchange(&mut c.rnames, u8[][]);
        exchange(&mut c.tnames, u8[][]);
        exchange(&mut c.type_bounds, u64[]);
        exchange(&mut c.type_interfaces, u64[][]);
        if is(&mut c, view("<")) {
            lifetime_parameters(&mut c);
        }
        module := module_copy(&mut c);
        here := c.pos;
        name := tok_text(&mut c, here);
        d := find_decl(&mut c, view(module), view(name));
        if d == 0 {
            fail(&mut c, view("impl needs a struct or enum declared in this module"));
        }
        ty := parse_type(&mut c);
        if (ty_kind(&mut c, ty) != 8) || (ty_arg(&mut c, ty) != d - 1) {
            fail(&mut c, view("impl needs a struct or enum declared in this module"));
        }
        args := type_args(&mut c, ty);
        if args.len() != c.tnames.len() {
            fail(&mut c, view("impl type arguments must be its own parameters, in order"));
        }
        for i in args.len() {
            a := args[i];
            if (ty_kind(&mut c, a) != 9) || (ty_arg(&mut c, a) != i) {
                fail(&mut c, view("impl type arguments must be its own parameters, in order"));
            }
        }
        if pass == 2 {
            c
                .impl_params
                .push(
                    ImplParams {
                        decl: d,
                        rnames: copy_names(&c.rnames),
                        tnames: copy_names(&c.tnames),
                        bounds: copy_numbers(&c.type_bounds),
                        interfaces: copy_constraints(&c.type_interfaces),
                        self_ty: ty,
                    }
                );
        }
        exchange(&mut c.inherent, d);
        exchange(&mut c.self_type, ty + 1);
        expect(&mut c, view("{"));
        while !eat(&mut c, view("}")) {
            public := u64(eat(&mut c, view("pub")));
            func(&mut c, pass, public);
        }
        exchange(&mut c.inherent, 0);
        exchange(&mut c.self_type, 0);
        return ();
    }
    if pass == 1 {
        while !is(&mut c, view("{")) {
            if kind(&mut c) == 0 {
                fail(&mut c, view("unclosed implementation"));
            }
            advance(&mut c);
        }
        skip_braces(&mut c);
        return ();
    }
    exchange(&mut c.rnames, u8[][]);
    exchange(&mut c.tnames, u8[][]);
    exchange(&mut c.type_bounds, u64[]);
    exchange(&mut c.type_interfaces, u64[][]);
    mut module = module_copy(&mut c);
    mut name = ident(&mut c);
    mut qualified = 0;
    if eat(&mut c, view("::")) {
        qualified = 1;
        module = name;
        name = ident(&mut c);
    }
    if qualified == 0 {
        imported := resolve_import(&mut c, view(name));
        if imported.len() != 0 {
            module = imported;
        }
    }
    contract := find_interface(&c, view(module), view(name));
    if contract == 0 {
        fail(&mut c, view("unknown implemented interface"));
    }
    expect(&mut c, view("for"));
    ty := parse_type(&mut c);
    mut id = find_implementation(&mut c, contract, ty);
    if pass == 2 {
        if id != 0 {
            fail(&mut c, view("overlapping interface implementation"));
        }
        owner := module_copy(&mut c);
        item := &c.interfaces[contract - 1];
        mut permitted = u64(same(view(item.module), view(owner)));
        if ty_kind(&mut c, ty) == 8 {
            decl := ty_arg(&mut c, ty);
            d := &c.decls[decl];
            if same(view(d.module), view(owner)) {
                permitted = 1;
            }
        }
        if permitted == 0 {
            fail(&mut c, view("implementation must own the interface or nominal type"));
        }
        c
            .implementations
            .push(Implementation { contract: contract, ty: ty, module: owner, methods: u64[] });
        id = c.implementations.len();
    }
    if id == 0 {
        fail(&mut c, view("implementation header missing"));
    }
    exchange(&mut c.current_impl, id);
    exchange(&mut c.self_type, ty + 1);
    expect(&mut c, view("{"));
    while !eat(&mut c, view("}")) {
        before := c.funcs.len();
        func(&mut c, pass, 0);
        if c.tnames.len() != 0 {
            fail(&mut c, view("generic implementation methods are not implemented yet"));
        }
        if pass == 2 {
            item := &mut c.implementations[id - 1];
            item.methods.push(before);
        }
    }
    exchange(&mut c.current_impl, 0);
    exchange(&mut c.self_type, 0);
    return ();
}
fn bound_signature<a, b>(c: (&a mut C), index: u64, arguments: (&b u64[])) -> u64 {
    f := &c.funcs[index];
    first := f.first;
    count := f.count;
    ret := f.ret;
    mut params = u64[];
    for i in count {
        ty := c.params[first + i];
        bound := bind_types(&mut c, ty, &arguments);
        params.push(bound);
    }
    result := bind_types(&mut c, ret, &arguments);
    return intern_args(&mut c, 12, result, 0, u64[], params);
}
fn resolve_interface_method<a, b>(c: (&a mut C), contract: u64, ty: u64, name: &b [u8]) -> u64 {
    implementation := find_implementation(&mut c, contract, ty);
    if implementation == 0 {
        fail(&mut c, view("missing interface implementation"));
    }
    item := &c.implementations[implementation - 1];
    methods := copy_numbers(&item.methods);
    for i in methods.len() {
        index := methods[i];
        f := &c.funcs[index];
        if same(view(f.name), view(name)) {
            return index;
        }
    }
    fail(&mut c, view("missing interface method"));
    return 0;
}
fn check_interfaces<a>(c: (&a mut C)) -> unit {
    for i in c.interfaces.len() {
        item := &c.interfaces[i];
        defined := item.defined;
        module := item.module.copy();
        name := item.name.copy();
        if defined == 0 {
            fail(&mut c, view("unknown interface in generic bound"));
        }
        if find_decl(&mut c, view(module), view(name)) != 0 {
            fail(&mut c, view("interface and nominal type names conflict"));
        }
    }
    for i in c.implementations.len() {
        item := &c.implementations[i];
        contract := item.contract;
        ty := item.ty;
        methods := copy_numbers(&item.methods);
        interface := &c.interfaces[contract - 1];
        expected := copy_numbers(&interface.methods);
        if methods.len() != expected.len() {
            fail(&mut c, view("interface implementation method count"));
        }
        for j in expected.len() {
            abstract := expected[j];
            f := &c.funcs[abstract];
            name := f.name.copy();
            actual := resolve_interface_method(&mut c, contract, ty, view(name));
            mut arguments = u64[ty];
            signature := bound_signature(&mut c, abstract, &arguments);
            mut empty = u64[];
            concrete := bound_signature(&mut c, actual, &empty);
            if same_type(&mut c, concrete, signature) == 0 {
                // Report at the implementing method, not wherever parsing ended.
                g := &c.funcs[actual];
                file := g.file;
                pos := g.pos;
                load_file(&mut c, file);
                exchange(&mut c.file, file);
                exchange(&mut c.pos, pos);
                fail(&mut c, view("method signature does not match the interface"));
            }
        }
    }
    return ();
}
fn interface_call<a, b>(c: (&a mut C), contract: u64, name: &b [u8]) -> Val {
    module := private_module(view(".interface_"), contract);
    return call(&mut c, view(module), view(name));
}
// const NAME: T = literal; (integers, bool, text). Uses inline the value.
fn constant_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("const"));
    name := ident(&mut c);
    expect(&mut c, view(":"));
    if pass != 2 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        advance(&mut c);
        return ();
    }
    ty := parse_type(&mut c);
    expect(&mut c, view("="));
    module := module_copy(&mut c);
    for i in c.constants.len() {
        k := &c.constants[i];
        if same(view(k.module), view(module)) & same(view(k.name), view(name)) {
            fail(&mut c, view("duplicate constant"));
        }
    }
    negative := u64(eat(&mut c, view("-")));
    here := c.pos;
    k := kind(&mut c);
    mut value = 0;
    mut text = u8[];
    if negative != 0 && k == 5 {
        if !is_float(&mut c, ty) {
            fail(&mut c, view("float constant needs type f64 or f32"));
        }
        t := tok_text(&mut c, here);
        fp := float_precision(&mut c, ty);
        bits := float_bits_p(&mut c, view(t), fp);
        advance(&mut c);
        expect(&mut c, view(";"));
        c
            .constants
            .push(
                Constant {
                    module: module,
                    name: name,
                    ty: ty,
                    value: bits ^ 9223372036854775808,
                    text: text,
                }
            );
        return ();
    }
    if k == 2 {
        t := tok_text(&mut c, here);
        value = literal_value(&mut c, view(t));
        advance(&mut c);
        if (ty != 0) & (ty_kind(&mut c, ty) != 18) {
            fail(&mut c, view("integer constant needs an integer type"));
        }
        if literal_fits(&mut c, ty, value, negative) == 0 {
            fail(&mut c, view("integer literal out of range for its type"));
        }
        if negative != 0 {
            value = wrapping_sub(0, value);
        }
    } else {
        if negative != 0 {
            fail(&mut c, view("only integer constants can be negative"));
        }
        if k == 5 {
            if !is_float(&mut c, ty) {
                fail(&mut c, view("float constant needs type f64 or f32"));
            }
            t := tok_text(&mut c, here);
            fp := float_precision(&mut c, ty);
            value = float_bits_p(&mut c, view(t), fp);
            advance(&mut c);
        } else {
            if k == 3 {
                if ty != 3 {
                    fail(&mut c, view("text constant needs type string"));
                }
                text = decode_literal(&mut c, here);
                advance(&mut c);
            } else {
                if is(&mut c, view("true")) || is(&mut c, view("false")) {
                    if !is_bool(&mut c, ty) {
                        fail(&mut c, view("bool constant needs type bool"));
                    }
                    value = u64(is(&mut c, view("true")));
                    advance(&mut c);
                } else {
                    fail(&mut c, view("constants must be integer, float, bool or text literals"));
                }
            }
        }
    }
    expect(&mut c, view(";"));
    c.constants.push(Constant { module: module, name: name, ty: ty, value: value, text: text });
    return ();
}
fn constant_value<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> Val {
    for i in c.constants.len() {
        k := &c.constants[i];
        if same(view(k.module), view(module)) & same(view(k.name), view(name)) {
            ty := k.ty;
            value := k.value;
            text := k.text.copy();
            if ty == 3 {
                l := label(&mut c);
                rodata(&mut c);
                mark(&mut c, l);
                for j in text.len() {
                    o(&mut c, view(".byte "));
                    on(&mut c, text[j]);
                    c.out.push(10);
                }
                o(&mut c, view(".byte 0\n.popsection\nleaq "));
                lname(&mut c, l);
                o(&mut c, view("(%rip),%rax\n"));
                ptr := save(&mut c);
                n := imm(&mut c, text.len());
                t := invoke(&mut c, view("rt_string_lit"), two(ptr, n));
                return own(&mut c, t, 3);
            }
            return val(imm(&mut c, value), ty);
        }
    }
    return val(0, 18446744073709551615);
}
// 1 when `path` is in a directory that also holds core.grl: the standard-library directory in
// the repository (lib/) and in every installed layout (std/). Both separators are accepted.
fn in_std_dir<a>(path: &a [u8]) -> u64 {
    mut cut = 0;
    mut found = 0;
    for i in path.len() {
        if (path[i] == 47) || (path[i] == 92) {
            cut = i + 1;
            found = 1;
        }
    }
    mut probe = u8[];
    if found != 0 {
        for i in cut {
            probe.push(path[i]);
        }
    }
    name := "core.grl";
    for i in name.len() {
        probe.push(name[i]);
    }
    return host::exists(view(probe));
}
// Modules that declared `use host;`. Recorded per module so a replayed generic body is checked
// against its defining module, not against whichever file was parsed last.
fn host_opted<a, b>(c: (&a C), m: &b [u8]) -> bool {
    for i in c.host_modules.len() {
        if same(view(c.host_modules[i]), view(m)) {
            return true;
        }
    }
    return false;
}
fn stdlib_module<a, b>(mods: (&a u8[][]), m: &b [u8]) -> bool {
    // The runtime lives beside the compiler, not in the stdlib directory.
    if same(view(m), view("runtime")) {
        return true;
    }
    for i in mods.len() {
        if same(view(mods[i]), view(m)) {
            return true;
        }
    }
    return false;
}
// Deferred generic and closure bodies must use their defining module's modes, not
// those of the last file scanned (usually the runtime).
fn module_modes<a>(c: (&a mut C)) -> unit {
    is_std := stdlib_module(&c.std_modules, view(c.module));
    exchange(&mut c.default_u64, c.default_u64_flag);
    exchange(&mut c.typed_refs, u64(c.default_u64_flag == 0 || c.typed_refs_flag != 0));
    if is_std {
        exchange(&mut c.default_u64, 1);
        exchange(&mut c.typed_refs, 1);
    }
    return ();
}
fn toplevel<a>(c: (&a mut C), pass: u64) -> unit {
    raw := u64(eat(&mut c, view("unsafe")));
    exchange(&mut c.raw, raw);
    mut m = "main".copy();
    if eat(&mut c, view("module")) {
        m = ident(&mut c);
        expect(&mut c, view(";"));
    } else {
        if c.file != 2 || raw != 0 {
            fail(&mut c, view("dependency files require an explicit module"));
        }
    }
    if same(view(m), view("runtime")) {
        if raw == 0 {
            fail(&mut c, view("runtime module must be explicitly unsafe"));
        }
    }
    if raw != 0 {
        // Two trusted modules: the portable runtime, and darwin for the macOS libSystem boundary,
        // which only exists in Mach-O builds.
        if !(same(view(m), view("runtime")) || same(view(m), view("darwin"))) {
            fail(&mut c, view("unsafe module reserved for runtime and darwin"));
        }
        if same(view(m), view("darwin")) & (c.plat == 0) {
            fail(&mut c, view("the darwin module requires a macos-x86_64 or macos-aarch64 target"));
        }
    }
    if c.file_std != 0 && !stdlib_module(&c.std_modules, view(m)) {
        c.std_modules.push(m.copy());
    }
    exchange(&mut c.module, m);
    module_modes(&mut c);
    exchange(&mut c.imports, Import[]);
    exchange(&mut c.host_optin, 0);
    while eat(&mut c, view("use")) {
        m = ident(&mut c);
        // `use host;` (or `use host::name;`) is this module's explicit opt-in to the ambient
        // `host::` interface; --deny-ambient-host refuses host:: references without it.
        if same(view(m), view("host")) {
            exchange(&mut c.host_optin, 1);
            if !host_opted(&c, view(c.module)) {
                c.host_modules.push(module_copy(&mut c));
            }
        }
        if eat(&mut c, view("::")) {
            n := ident(&mut c);
            c.imports.push(Import { module: m, name: n });
        }
        expect(&mut c, view(";"));
    }
    while kind(&mut c) != 0 {
        public := u64(eat(&mut c, view("pub")));
        if is(&mut c, view("extern")) {
            extern_declaration(&mut c, pass, public);
            continue;
        }
        if is(&mut c, view("handle")) {
            handle_declaration(&mut c, pass);
            continue;
        }
        if is(&mut c, view("type")) {
            alias_declaration(&mut c, pass);
        } else {
            if is(&mut c, view("const")) {
                constant_declaration(&mut c, pass);
            } else {
                if is(&mut c, view("interface")) {
                    interface_declaration(&mut c, pass);
                } else {
                    if is(&mut c, view("impl")) {
                        implementation(&mut c, pass);
                    } else {
                        if is(&mut c, view("struct")) || is(&mut c, view("enum")) {
                            decl(&mut c, pass);
                        } else {
                            func(&mut c, pass, public);
                        }
                    }
                }
            }
        }
    }
    return ();
}

// ---- expressions: eight-byte stack slots; left-to-right operands ----
fn deref<a>(c: (&a mut C), v: Val) -> Val {
    mut t = v.t;
    mut ty = v.ty;
    while ty_kind(&mut c, ty) == 7 {
        old := t;
        target := target_of(&mut c, old);
        ty = ty_arg(&mut c, ty);
        t = ref_load(&mut c, old, ty);
        if c.raw == 0 {
            if target == 0 {
                fail(&mut c, view("reference target is not tracked"));
            }
            c
                .resources
                .push(
                    Resource {
                        slot: t,
                        ty: ty,
                        flag: 0,
                        base: old + 1,
                        field: 0,
                        via: 1,
                        place: target,
                        target: 0,
                        authority: old + 1,
                    }
                );
            owner := place_of(&mut c, old);
            n := c.bonds.len();
            for i in n {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if holder == owner && guard != 0 {
                    bond_kind(&mut c, target, loan, guard);
                }
            }
            stored_source(&mut c, t, ty);
        }
    }
    return val(t, ty);
}
fn find_local<a, b>(c: (&a mut C), n: &b [u8]) -> u64 {
    mut i = c.locals.len();
    while 0 < i {
        i = i - 1;
        mut l = &c.locals[i];
        if same(view(l.name), view(n)) {
            return i + 1;
        }
    }
    return 0;
}
fn local_id<a>(c: (&a mut C), i: u64) -> u64 {
    mut l = &c.locals[i];
    return l.id;
}
fn local_ty<a>(c: (&a mut C), i: u64) -> u64 {
    mut l = &c.locals[i];
    return l.ty;
}
fn pop_locals<a>(c: (&a mut C), mark: u64) -> unit {
    while mark < c.locals.len() {
        c.locals.pop();
    }
    return ();
}
// Loads, addresses and stores record fields.
fn rec_load<a>(c: (&a mut C), base: u64, k: u64, address: u64) -> u64 {
    get(&mut c, base, view("%rax"));
    if address != 0 {
        o(&mut c, view("leaq "));
    } else {
        o(&mut c, view("movq "));
    }
    on(&mut c, k * 8);
    o(&mut c, view("(%rax),%rax\n"));
    return save(&mut c);
}
fn rec_store<a>(c: (&a mut C), base: u64, k: u64, value: u64) -> unit {
    get(&mut c, base, view("%rcx"));
    get(&mut c, value, view("%rax"));
    o(&mut c, view("movq %rax,"));
    on(&mut c, k * 8);
    o(&mut c, view("(%rcx)\n"));
    return ();
}
// C-layout field access: exact byte offset, exact field width. Fields narrower than
// eight bytes use portable byte-wise helpers so every target stays correct without
// new instruction selection.
fn cfield_load<a>(c: (&a mut C), base: u64, d: u64, k: u64, address: u64) -> u64 {
    ty := field_ty(&mut c, d, k);
    off := ffi_offset(&mut c, d, k);
    size := ffi_field_size(&mut c, ty);
    more := exchange(&mut c.cfield_more, 0);
    if is_c_record(&mut c, ty) != 0 {
        // The embedded record's bytes start at base+off: a further projection (o.inner.x) and an
        // assignment place (o.inner = r) use that interior address; a value read copies them
        // into a fresh record, since C structs are plain data.
        get(&mut c, base, view("%rax"));
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        if address != 0 {
            c.caddr.push(at);
            c.caddr.push(ty);
            return at;
        }
        if more != 0 {
            return at;
        }
        return c_record_copy(&mut c, at, ty);
    }
    get(&mut c, base, view("%rax"));
    if address != 0 {
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        if size != 8 || is_f32(&mut c, ty) {
            c.caddr.push(at);
            c.caddr.push(ty);
        }
        return at;
    }
    if size == 8 {
        o(&mut c, view("movq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        return save(&mut c);
    }
    o(&mut c, view("addq $"));
    on(&mut c, off);
    o(&mut c, view(",%rax\n"));
    addr := save(&mut c);
    mut signed = 0;
    if ty_kind(&mut c, ty) == 18 {
        signed = ty_mode(&mut c, ty);
    }
    w := imm(&mut c, size);
    sign := imm(&mut c, signed);
    loaded := invoke(&mut c, view("rt_load_sized"), three(addr, w, sign));
    if is_f32(&mut c, ty) {
        // binary32 bits in memory; Grail holds f32 values as binary64 words.
        get(&mut c, loaded, view("%rax"));
        ffi_f32_widen(&mut c);
        return save(&mut c);
    }
    return loaded;
}
fn ffi_f32_widen<a>(c: (&a mut C)) -> unit {
    if (c.target == 0) || (c.target == 3) {
        o(&mut c, view("movd %eax,%xmm0\ncvtss2sd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
    } else {
        o(&mut c, view("cf32widen\n"));
    }
    return ();
}
fn cfield_store<a>(c: (&a mut C), base: u64, d: u64, k: u64, value: u64) -> unit {
    ty := field_ty(&mut c, d, k);
    off := ffi_offset(&mut c, d, k);
    size := ffi_field_size(&mut c, ty);
    if is_c_record(&mut c, ty) != 0 {
        get(&mut c, base, view("%rax"));
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        caddr_store(&mut c, at, ty, value);
        return ();
    }
    if size == 8 {
        get(&mut c, base, view("%rcx"));
        get(&mut c, value, view("%rax"));
        o(&mut c, view("movq %rax,"));
        on(&mut c, off);
        o(&mut c, view("(%rcx)\n"));
        return ();
    }
    mut stored = value;
    if is_f32(&mut c, ty) {
        get(&mut c, value, view("%rax"));
        if (c.target == 0) || (c.target == 3) {
            o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\nmovd %xmm0,%eax\n"));
        } else {
            o(&mut c, view("cf32bits\n"));
        }
        stored = save(&mut c);
    }
    get(&mut c, base, view("%rax"));
    o(&mut c, view("addq $"));
    on(&mut c, off);
    o(&mut c, view(",%rax\n"));
    addr := save(&mut c);
    w := imm(&mut c, size);
    invoke(&mut c, view("rt_store_sized"), three(addr, stored, w));
    return ();
}
// A fresh record holding a copy of the C record bytes at `src`.
fn c_record_copy<a>(c: (&a mut C), src: u64, ty: u64) -> u64 {
    d := ty_arg(&mut c, ty);
    words := ffi_record_words(&mut c, d);
    n := imm(&mut c, words);
    fresh := invoke(&mut c, view("rt_rec"), one(n));
    size := ffi_record_size(&mut c, d);
    bytes := imm(&mut c, size);
    invoke(&mut c, view("rt_copy_bytes"), three(fresh, src, bytes));
    return fresh;
}
// The C field type behind an address slot made by cfield_load, or 0 for an ordinary word.
fn caddr_ty<a>(c: (&a mut C), slot: u64) -> u64 {
    mut i = c.caddr.len();
    while 1 < i {
        i = i - 2;
        if c.caddr[i] == slot {
            return c.caddr[i + 1];
        }
    }
    return 0;
}
// Loads a narrow C field through its address slot as a Grail word (sign- or zero-extended,
// f32 widened to the binary64 word Grail holds).
fn caddr_load<a>(c: (&a mut C), slot: u64, ty: u64) -> u64 {
    mut signed = 0;
    if ty_kind(&mut c, ty) == 18 {
        signed = ty_mode(&mut c, ty);
    }
    size := ffi_field_size(&mut c, ty);
    w := imm(&mut c, size);
    sign := imm(&mut c, signed);
    loaded := invoke(&mut c, view("rt_load_sized"), three(slot, w, sign));
    if is_f32(&mut c, ty) {
        get(&mut c, loaded, view("%rax"));
        ffi_f32_widen(&mut c);
        return save(&mut c);
    }
    return loaded;
}
// Stores a Grail word into a narrow C field through its address slot.
fn caddr_store<a>(c: (&a mut C), slot: u64, ty: u64, value: u64) -> unit {
    if is_c_record(&mut c, ty) != 0 {
        // The moved-in record's bytes replace the embedded ones; its own buffer is released.
        d := ty_arg(&mut c, ty);
        size := ffi_record_size(&mut c, d);
        bytes := imm(&mut c, size);
        invoke(&mut c, view("rt_copy_bytes"), three(slot, value, bytes));
        invoke(&mut c, view("rt_free"), one(value));
        return ();
    }
    mut stored = value;
    if is_f32(&mut c, ty) {
        get(&mut c, value, view("%rax"));
        if (c.target == 0) || (c.target == 3) {
            o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\nmovd %xmm0,%eax\n"));
        } else {
            o(&mut c, view("cf32bits\n"));
        }
        stored = save(&mut c);
    }
    size := ffi_field_size(&mut c, ty);
    w := imm(&mut c, size);
    invoke(&mut c, view("rt_store_sized"), three(slot, stored, w));
    return ();
}
// Narrow vectors (`f32[]`, `u32[]`, `i32[]`) store 4-byte elements: 1 for f32, 2 for u32, 3 for
// i32, 0 for any other element type.
fn narrow_code<a>(c: (&a mut C), alias: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    // A specialization's type parameter is an alias of the concrete type.
    elem := base_type(&mut c, alias);
    if is_f32(&mut c, elem) {
        return 1;
    }
    if (elem != 0) & (ty_kind(&mut c, elem) == 18) {
        if ty_arg(&mut c, elem) == 32 {
            return 2 + (ty_mode(&mut c, elem) & 1);
        }
    }
    return 0;
}
fn narrow_vector<a>(c: (&a mut C), ty: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    vty := base_type(&mut c, ty);
    if ty_kind(&mut c, vty) != 6 {
        return 0;
    }
    elem := ty_arg(&mut c, vty);
    return narrow_code(&mut c, elem);
}
// A value as the 32-bit unit a narrow vector stores: an f32's binary32 bits; an integer as is (the
// store keeps its low 32 bits).
fn narrow_encode<a>(c: (&a mut C), code: u64, value: u64) -> u64 {
    if code != 1 {
        return value;
    }
    get(&mut c, value, view("%rax"));
    if (c.target == 0) || (c.target == 3) {
        o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\nmovd %xmm0,%eax\n"));
    } else {
        o(&mut c, view("cf32bits\n"));
    }
    return save(&mut c);
}
// A loaded 32-bit unit (zero-extended) as the word Grail holds: f32 widened, i32 sign-extended.
fn narrow_decode<a>(c: (&a mut C), code: u64, unit: u64) -> u64 {
    if code == 2 {
        return unit;
    }
    get(&mut c, unit, view("%rax"));
    if code == 1 {
        ffi_f32_widen(&mut c);
    } else {
        o(&mut c, view("shlq $32,%rax\nsarq $32,%rax\n"));
    }
    return save(&mut c);
}
// How many integer argument words this target's callback prologue can read: the Win64 thunk under
// the C symbol moves four registers plus the fifth and sixth stack words into Grail's registers, and
// x86-64 SysV, AArch64 and RISC-V 64 read their own integer argument registers.
fn callback_int_words(abi: u64) -> u64 {
    if abi == 1 {
        return 6;
    }
    return ffi_int_regs(abi);
}
// Ceiling for readback of an exported callback's parameter list; see ffi_callback_fits.
fn ffi_callback_fits<a>(c: (&a mut C), first: u64, count: u64) -> unit {
    abi := ffi_abi(&mut c);
    mut ints = 0;
    mut floats = 0;
    for i in count {
        formal := c.params[first + i];
        if is_float(&mut c, formal) {
            floats = floats + 1;
        } else {
            ints = ints + ffi_words(&mut c, formal);
        }
    }
    if callback_int_words(abi) < ints {
        fail(
            &mut c,
            view(
                "a C callback cannot read that many integer argument words: this target passes the rest on the stack and the callback prologue reads registers only; pass a pointer or a record instead"
            )
        );
    }
    if 8 < floats {
        fail(&mut c, view("a C callback cannot read that many floating-point arguments: this target passes the rest on the stack"));
    }
    return ();
}
// An exported callback's prologue: each parameter is read from where a C caller put it (Win64:
// positionally, the thunk having moved rcx/rdx/r8/r9 and stack words five and six into Grail's
// registers; SysV/AAPCS64/RV64: integer-class parameters packed into the integer registers and
// floats into the vector registers), f32 widened, narrow integers extended, then spilled.
fn callback_params<a>(c: (&a mut C), count: u64) -> unit {
    win := c.target == 3;
    x86 := c.target == 0 || win;
    // Win64 arguments arrive in Grail's registers because the thunk under the C symbol has already
    // moved them; everywhere else the C integer argument registers of the target's own ABI are read
    // directly, so the seventh and eighth words come from %r10/%r11 (x6/x7, a6/a7).
    abi := ffi_abi(&mut c);
    mut ints = 0;
    mut floats = 0;
    for i in count {
        // The parameter locals are the function's first bindings, in declaration order.
        ty := c.locals[i].ty;
        if is_float(&mut c, ty) {
            single := is_f32(&mut c, ty);
            mut fpos = floats;
            if win {
                fpos = i;
            }
            if win & (3 < i) {
                // Stack-passed on Win64: the thunk moved the raw word into Grail's register.
                o(&mut c, view("movq "));
                o(&mut c, view(argreg(i)));
                o(&mut c, view(",%rax\n"));
                if single {
                    o(&mut c, view("movd %eax,%xmm0\ncvtss2sd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
                }
            } else {
                if x86 {
                    if single {
                        o(&mut c, view("cvtss2sd %xmm"));
                        on(&mut c, fpos);
                        o(&mut c, view(",%xmm"));
                        on(&mut c, fpos);
                        c.out.push(10);
                    }
                    o(&mut c, view("movq %xmm"));
                    on(&mut c, fpos);
                    o(&mut c, view(",%rax\n"));
                } else {
                    o(&mut c, view("cbfarg "));
                    on(&mut c, fpos);
                    if single {
                        o(&mut c, view(" s"));
                    }
                    c.out.push(10);
                }
            }
            floats = floats + 1;
        } else {
            mut ipos = ints;
            if win {
                ipos = i;
            }
            o(&mut c, view("movq "));
            if win {
                o(&mut c, view(argreg(ipos)));
            } else {
                o(&mut c, view(ffi_int_reg(abi, ipos)));
            }
            o(&mut c, view(",%rax\n"));
            suffix := ffi_narrow(&mut c, ty);
            if suffix.len() != 0 {
                if x86 {
                    ffi_x86_extend(&mut c, view(suffix));
                } else {
                    o(&mut c, view("cext "));
                    o(&mut c, view(suffix));
                    c.out.push(10);
                }
            }
            ints = ints + 1;
        }
        o(&mut c, view("movq %rax,"));
        stack_slot(&mut c, i);
        c.out.push(10);
    }
    return ();
}
// ---- `byval` record arguments (decision B7, docs/ffi.md) ----
// One scalar leaf of an extern record. An embedded record is flattened, so a leaf's offset is
// measured from the outermost record's start.
struct FFILeaf {
    off: u64,
    size: u64,
    // 0 integer (handles, CStr and cfn words included), 1 f32, 2 f64.
    cls: u64
}
// One destination for a slice of a byval argument: dst 1 an integer argument register, 2 a float
// argument register, 3 an outgoing stack word, 4 the address of the argument's copy in an integer
// register, 5 the address of the copy in an outgoing stack word.
struct FFIMove {
    off: u64,
    size: u64,
    dst: u64,
    index: u64
}
// A whole byval argument: the moves that place its bytes, the call's argument counters after it,
// and the copy a by-reference argument needs.
struct FFIPlan {
    byval: u64,
    moves: FFIMove[],
    ints: u64,
    floats: u64,
    stack: u64,
    copies: u64,
    copy_rel: u64,
    copy_bytes: u64
}
fn ffi_empty_plan() -> FFIPlan {
    mut moves = FFIMove[];
    return FFIPlan {
        byval: 0,
        moves: moves,
        ints: 0,
        floats: 0,
        stack: 0,
        copies: 0,
        copy_rel: 0,
        copy_bytes: 0
    };
}
fn ffi_move(off: u64, size: u64, dst: u64, index: u64) -> FFIMove {
    return FFIMove { off: off, size: size, dst: dst, index: index };
}
// The scalar leaves of an extern record, embedded records flattened, in field order.
fn ffi_leaves<a>(c: (&a mut C), d: u64, base: u64) -> FFILeaf[] {
    mut out = FFILeaf[];
    count := c.decls[d].count;
    for i in count {
        ty := field_ty(&mut c, d, i);
        off := base + ffi_offset(&mut c, d, i);
        if is_c_record(&mut c, ty) != 0 {
            nested := ty_arg(&mut c, ty);
            inner := ffi_leaves(&mut c, nested, off);
            for j in inner.len() {
                leaf := inner[j];
                out.push(FFILeaf { off: leaf.off, size: leaf.size, cls: leaf.cls });
            }
        } else {
            mut cls = 0;
            if is_float(&mut c, ty) {
                cls = 2;
                if is_f32(&mut c, ty) {
                    cls = 1;
                }
            }
            out.push(FFILeaf { off: off, size: ffi_field_size(&mut c, ty), cls: cls });
        }
    }
    return out;
}
// The placement decision for one byval argument on `abi`. Entry 0 is the mode and, for mode 5, the
// entries after it are the eightbytes' classes (1 SSE, 2 INTEGER). Modes: 0 an empty record (nothing
// crosses), 1 one integer register per eightbyte, 2 the record in consecutive outgoing stack words,
// 3 one register per leaf in field order (integer leaves to integer registers, float leaves to float
// registers), 4 by reference to a copy the caller makes, 5 SysV eightbyte classes.
//
// The rules are the ABI's own and are stated again in docs/ffi.md, which is the contract:
//
// - SysV x86-64: an eightbyte is SSE when it holds only floats and INTEGER otherwise (a mixed
//   eightbyte is INTEGER), and each class draws from its own register file. Over 16 bytes, or when
//   a class has no register left, the whole record goes in the outgoing argument area (MEMORY).
// - AAPCS64: a homogeneous float aggregate of 1-4 fields of one float type travels in v0-v7, one
//   register per field. Any other composite of 16 bytes or less travels in consecutive x0-x7, one
//   register per eightbyte; a larger one is passed by reference to a caller copy. With no register
//   left for the aggregate or the address, it is passed on the stack.
// - RV64: over 2*XLEN (16 bytes) a record is passed by reference. At or below it, one or two fields
//   with at least one float take a register each in field order (float fields in fa0-fa7, integer
//   fields in a0-a7); every other shape is packed into one integer register per eightbyte.
fn ffi_byval_mode<a>(
    c: (&a mut C),
    abi: u64,
    size: u64,
    words: u64,
    leaves: (&a FFILeaf[]),
    ints: u64,
    floats: u64
) -> u64[] {
    mut decision = u64[];
    if size == 0 {
        decision.push(0);
        return decision;
    }
    if abi == 0 {
        if 16 < size {
            decision.push(2);
            return decision;
        }
        eights := ffi_align_up(size, 8) / 8;
        mut klass = u64[];
        for e in eights {
            klass.push(0);
        }
        for i in leaves.len() {
            e := leaves[i].off / 8;
            if leaves[i].cls == 0 {
                exchange(&mut klass[e], 2);
            } else {
                if klass[e] == 0 {
                    exchange(&mut klass[e], 1);
                }
            }
        }
        mut need_int = 0;
        mut need_sse = 0;
        for e in eights {
            if klass[e] == 1 {
                need_sse = need_sse + 1;
            } else {
                need_int = need_int + 1;
            }
        }
        if (6 < ints + need_int) | (8 < floats + need_sse) {
            decision.push(2);
            return decision;
        }
        decision.push(5);
        for e in eights {
            decision.push(klass[e]);
        }
        return decision;
    }
    if abi == 2 {
        mut hfa = 0;
        if (0 < leaves.len()) && (leaves.len() <= 4) && (0 < leaves[0].cls) {
            first := leaves[0].cls;
            hfa = 1;
            for i in leaves.len() {
                if leaves[i].cls != first {
                    hfa = 0;
                }
            }
        }
        if hfa != 0 {
            if floats + leaves.len() <= 8 {
                decision.push(3);
            } else {
                decision.push(2);
            }
            return decision;
        }
        if 16 < size {
            decision.push(4);
            return decision;
        }
        if 8 < ints + words {
            decision.push(2);
        } else {
            decision.push(1);
        }
        return decision;
    }
    // RV64 (abi 3). Win64 (abi 1) never reaches here: ffi_byval_parameter refuses `byval` on the
    // Windows targets when the declaration is parsed.
    if 16 < size {
        decision.push(4);
        return decision;
    }
    mut nfloat = 0;
    for i in leaves.len() {
        if leaves[i].cls != 0 {
            nfloat = nfloat + 1;
        }
    }
    if (nfloat != 0) & (leaves.len() <= 2) {
        nint := leaves.len() - nfloat;
        if (8 < ints + nint) | (8 < floats + nfloat) {
            decision.push(2);
        } else {
            decision.push(3);
        }
        return decision;
    }
    if 8 < ints + words {
        decision.push(2);
    } else {
        decision.push(1);
    }
    return decision;
}
// How one byval argument is passed: the moves that place its bytes and the call's argument counters
// after it. `ints`, `floats` and `stack` are the counters the ordinary argument loop keeps, so the
// allocation of the arguments around a byval record stays in step.
fn ffi_byval_plan<a>(c: (&a mut C), d: u64, abi: u64, ints: u64, floats: u64, stack: u64, copies: u64) -> FFIPlan {
    size := ffi_record_size(&mut c, d);
    words := ffi_align_up(size, 8) / 8;
    leaves := ffi_leaves(&mut c, d, 0);
    decision := ffi_byval_mode(&mut c, abi, size, words, &leaves, ints, floats);
    mode := decision[0];
    mut ints2 = ints;
    mut floats2 = floats;
    mut stack2 = stack;
    mut copies2 = copies;
    mut copy_rel = 0;
    mut copy_bytes = 0;
    mut moves = FFIMove[];
    if mode == 1 {
        for w in words {
            moves.push(ffi_move(w * 8, 8, 1, ints2 + w));
        }
        ints2 = ints2 + words;
    }
    if mode == 2 {
        for w in words {
            moves.push(ffi_move(w * 8, 8, 3, stack2 + w));
        }
        stack2 = stack2 + words;
    }
    if mode == 3 {
        for i in leaves.len() {
            if leaves[i].cls == 0 {
                moves.push(ffi_move((leaves[i].off / 8) * 8, 8, 1, ints2));
                ints2 = ints2 + 1;
            } else {
                moves.push(ffi_move(leaves[i].off, leaves[i].size, 2, floats2));
                floats2 = floats2 + 1;
            }
        }
    }
    if mode == 4 {
        copy_rel = copies2;
        copy_bytes = ffi_align_up(size, 8);
        copies2 = copies2 + copy_bytes;
        if ints2 < 8 {
            moves.push(ffi_move(0, 0, 4, ints2));
            ints2 = ints2 + 1;
        } else {
            moves.push(ffi_move(0, 0, 5, stack2));
            stack2 = stack2 + 1;
        }
    }
    if mode == 5 {
        for e in decision.len() - 1 {
            mut width = size - e * 8;
            if 8 < width {
                width = 8;
            }
            if decision[e + 1] == 1 {
                moves.push(ffi_move(e * 8, width, 2, floats2));
                floats2 = floats2 + 1;
            } else {
                moves.push(ffi_move(e * 8, 8, 1, ints2));
                ints2 = ints2 + 1;
            }
        }
    }
    return FFIPlan {
        byval: 1,
        moves: moves,
        ints: ints2,
        floats: floats2,
        stack: stack2,
        copies: copies2,
        copy_rel: copy_rel,
        copy_bytes: copy_bytes
    };
}
// Places one byval argument's bytes where the plan says, making the copy a by-reference argument
// needs at `copy_base` bytes above the outgoing stack pointer.
fn ffi_byval_emit<a>(c: (&a mut C), slot: u64, plan: (&FFIPlan), copy_base: u64, x86: u64, abi: u64) -> unit {
    if 0 < plan.copy_bytes {
        for w in plan.copy_bytes / 8 {
            get(&mut c, slot, view("%rax"));
            o(&mut c, view("movq "));
            on(&mut c, w * 8);
            o(&mut c, view("(%rax),%rax\n"));
            ffi_store_stack(&mut c, x86, copy_base + w * 8);
        }
    }
    for i in plan.moves.len() {
        m := plan.moves[i];
        if (m.dst == 4) || (m.dst == 5) {
            // Passed by reference: the address of the copy, not the record's bytes.
            o(&mut c, view("leaq "));
            on(&mut c, copy_base + plan.copy_rel);
            o(&mut c, view("(%rsp),%rax\n"));
            if m.dst == 4 {
                o(&mut c, view("movq %rax,"));
                o(&mut c, view(ffi_int_reg(abi, m.index)));
                c.out.push(10);
            } else {
                ffi_store_stack(&mut c, x86, m.index * 8);
            }
            continue;
        }
        get(&mut c, slot, view("%rax"));
        if (m.dst == 2) & (m.size == 4) {
            o(&mut c, view("movl "));
        } else {
            o(&mut c, view("movq "));
        }
        on(&mut c, m.off);
        o(&mut c, view("(%rax),%rax\n"));
        if m.dst == 1 {
            o(&mut c, view("movq %rax,"));
            o(&mut c, view(ffi_int_reg(abi, m.index)));
            c.out.push(10);
        }
        if m.dst == 2 {
            ffi_float_arg(&mut c, m.index, m.size == 4, x86);
        }
        if m.dst == 3 {
            ffi_store_stack(&mut c, x86, m.index * 8);
        }
    }
    return ();
}
// %rax's word as the bits of float argument register `index`, without conversion: a record's bytes
// are already the field's representation.
fn ffi_float_arg<a>(c: (&a mut C), index: u64, single: bool, x86: u64) -> unit {
    if x86 != 0 {
        if single {
            o(&mut c, view("movd %eax,%xmm"));
        } else {
            o(&mut c, view("movq %rax,%xmm"));
        }
        on(&mut c, index);
        c.out.push(10);
    } else {
        if single {
            o(&mut c, view("cfbits32 "));
        } else {
            o(&mut c, view("cfbits64 "));
        }
        on(&mut c, index);
        c.out.push(10);
    }
    return ();
}
// How a record with float fields is returned on this ABI: 1 SysV (per-eightbyte INTEGER/SSE),
// 2 AAPCS64 homogeneous float aggregate (1-4 fields of one float type), 3 RV64 flattened (one
// or two fields, at least one float), 0 the integer-register/memory rules (Win64 by size, AAPCS64
// non-HFA composites, RV64 records the flattening rule does not cover).
fn ffi_float_plan<a>(c: (&a mut C), d: u64, abi: u64) -> u64 {
    count := c.decls[d].count;
    if abi == 0 {
        return 1;
    }
    if abi == 2 {
        if (count == 0) || (4 < count) {
            return 0;
        }
        first := field_ty(&mut c, d, 0);
        if !is_float(&mut c, first) {
            return 0;
        }
        single := is_f32(&mut c, first);
        for i in count {
            ty := field_ty(&mut c, d, i);
            if !is_float(&mut c, ty) || is_f32(&mut c, ty) != single {
                return 0;
            }
        }
        return 2;
    }
    if abi == 3 {
        if (count == 0) || (2 < count) {
            return 0;
        }
        mut floats = 0;
        for i in count {
            ty := field_ty(&mut c, d, i);
            if is_float(&mut c, ty) {
                floats = floats + 1;
            } else {
                // Only scalar integers pair with a float (handles and CStr are pointer words).
                if 8 < ffi_field_size(&mut c, ty) {
                    return 0;
                }
            }
        }
        if floats == 0 {
            return 0;
        }
        return 3;
    }
    return 0;
}
// Stores a float-classified record result from the return registers into its allocation.
fn ffi_float_result<a>(c: (&a mut C), slot: u64, d: u64, plan: u64) -> unit {
    count := c.decls[d].count;
    size := ffi_record_size(&mut c, d);
    if plan == 1 {
        // SysV: each eightbyte is SSE when all its fields are floats, else INTEGER; INTEGER
        // eightbytes come from rax then rdx, SSE ones from xmm0 then xmm1.
        mut eights = (size + 7) / 8;
        mut ints = 0;
        mut sses = 0;
        // Save rax/rdx first: the stores below go through r10/r11 only.
        get(&mut c, slot, view("%r10"));
        for e in eights {
            mut sse = 1;
            for i in count {
                ty := field_ty(&mut c, d, i);
                off := ffi_offset(&mut c, d, i);
                if (off / 8 == e) & !is_float(&mut c, ty) {
                    sse = 0;
                }
            }
            if sse != 0 {
                o(&mut c, view("movq %xmm"));
                on(&mut c, sses);
                o(&mut c, view(",%r11\n"));
                sses = sses + 1;
            } else {
                if ints == 0 {
                    o(&mut c, view("movq %rax,%r11\n"));
                } else {
                    o(&mut c, view("movq %rdx,%r11\n"));
                }
                ints = ints + 1;
            }
            o(&mut c, view("movq %r11,"));
            on(&mut c, e * 8);
            o(&mut c, view("(%r10)\n"));
        }
        return ();
    }
    if plan == 2 {
        get(&mut c, slot, view("%r10"));
        for i in count {
            ty := field_ty(&mut c, d, i);
            single := is_f32(&mut c, ty);
            off := ffi_offset(&mut c, d, i);
            ffi_float_store(&mut c, i, single, off);
        }
        return ();
    }
    // RV64 flattened: floats in fa0, fa1 in field order; the integer field (if any) in a0, which
    // the call lowering leaves in %rax.
    held := save(&mut c);
    get(&mut c, slot, view("%r10"));
    mut fk = 0;
    for i in count {
        ty := field_ty(&mut c, d, i);
        if is_float(&mut c, ty) {
            single := is_f32(&mut c, ty);
            off := ffi_offset(&mut c, d, i);
            ffi_float_store(&mut c, fk, single, off);
            fk = fk + 1;
        }
    }
    for i in count {
        ty := field_ty(&mut c, d, i);
        if !is_float(&mut c, ty) {
            cfield_store(&mut c, slot, d, i, held);
        }
    }
    return ();
}
fn ffi_float_store<a>(c: (&a mut C), k: u64, single: bool, off: u64) -> unit {
    o(&mut c, view("cfrstore "));
    on(&mut c, k);
    if single {
        o(&mut c, view(" s "));
    } else {
        o(&mut c, view(" d "));
    }
    on(&mut c, off);
    c.out.push(10);
    return ();
}
// 1 when a C-layout record has a floating-point field (its by-value classification differs).
fn ffi_record_has_float<a>(c: (&a mut C), d: u64) -> bool {
    count := c.decls[d].count;
    for i in count {
        ty := field_ty(&mut c, d, i);
        if is_float(&mut c, ty) {
            return true;
        }
    }
    return false;
}
// 1 when a C-layout record embeds another extern record.
fn ffi_record_has_nested<a>(c: (&a mut C), d: u64) -> bool {
    count := c.decls[d].count;
    for i in count {
        ty := field_ty(&mut c, d, i);
        if is_c_record(&mut c, ty) != 0 {
            return true;
        }
    }
    return false;
}
// Floats anywhere in the record, embedded records included.
fn ffi_record_has_float_deep<a>(c: (&a mut C), d: u64) -> bool {
    count := c.decls[d].count;
    for i in count {
        ty := field_ty(&mut c, d, i);
        if is_float(&mut c, ty) {
            return true;
        }
        if is_c_record(&mut c, ty) != 0 {
            inner := ty_arg(&mut c, ty);
            if ffi_record_has_float_deep(&mut c, inner) {
                return true;
            }
        }
    }
    return false;
}
fn field_path<a>(c: (&a mut C), id: u64, lty: u64, address: u64) -> Val {
    mut t = id;
    mut ty = lty;
    mut via = 0;
    while is(&mut c, view(".")) {
        if after_next_kind(&mut c) == 40 {
            break;
        }
        if next_kind(&mut c) == 46 {
            break;
        }
        advance(&mut c);
        f := member_name(&mut c);
        if ty_kind(&mut c, ty) == 7 {
            via = 1;
        }
        base := deref(&mut c, val(t, ty));
        mut b = base.t;
        if ty_kind(&mut c, base.ty) != 8 {
            fail(&mut c, view("field projection requires record"));
        }
        d := ty_arg(&mut c, base.ty);
        decl := &c.decls[d];
        if decl.is_enum != 0 {
            fail(&mut c, view("enum payload requires match or unwrap"));
        }
        k := find_field(&mut c, d, view(f));
        fty := field_type(&mut c, base.ty, k);
        last := (kind(&mut c) != 46) & (address != 0);
        mut n = 0;
        if c.decls[d].c_layout != 0 {
            more := kind(&mut c) == 46;
            exchange(&mut c.cfield_more, more);
            n = cfield_load(&mut c, b, d, k, last);
        } else {
            n = rec_load(&mut c, b, k, last);
        }
        if last {
            ty := reference_type(&mut c, fty, address == 2);
            root := place_of(&mut c, b);
            target := member_place(&mut c, root, k, fty);
            authority := authority_of(&mut c, b);
            if c.raw == 0 {
                c
                    .resources
                    .push(
                        Resource {
                            slot: n,
                            ty: ty,
                            flag: 0,
                            base: b + 1,
                            field: k,
                            via: via,
                            place: 0,
                            target: target,
                            authority: authority,
                        }
                    );
            }
            return val(n, ty);
        }
        outer_c := c.decls[d].c_layout;
        next_dot := kind(&mut c) == 46;
        inner_c := is_c_record(&mut c, fty);
        if outer_c != 0 && address == 0 && !next_dot && inner_c {
            // A copied-out embedded C record is a fresh value, independent of the field's place:
            // reading it is a read of the containing record, and the copy is owned by the reader.
            observe(&mut c, b);
            own(&mut c, n, fty);
            return val(n, fty);
        }
        alias_field(&mut c, n, fty, b, k, via);
        t = n;
        ty = fty;
    }
    observe(&mut c, t);
    return val(t, ty);
}
fn place<a>(c: (&a mut C), write: u64, slot: u64) -> Val {
    name := ident(&mut c);
    mut l = find_local(&mut c, view(name));
    if l == 0 {
        return capture_place(&mut c, view(name), write);
    }
    id := local_id(&mut c, l - 1);
    ty := local_ty(&mut c, l - 1);
    commit_flex(&mut c, l - 1);
    next := kind(&mut c);
    // `&mut r` on a shared reference binds the slot (never the referent): a whole-binding borrow
    // of a reference is its own storage. Field and index borrows still go through the referent.
    if slot != 0
        && write != 0
        && ty_kind(&mut c, ty) == 7
        && ty_mode(&mut c, ty) == 0
        && next != 46
        && next != 91 {
        return reference_slot(&mut c, id, ty);
    }
    if write != 0 {
        require_mutable_binding(&mut c, id, 1);
    }
    if ty_kind(&mut c, ty) == 7 {
        if write != 0 {
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("mutable reborrow of shared reference"));
            }
        }
    }
    if kind(&mut c) == 46 {
        mut v = field_path(&mut c, id, ty, 1 + write);
        target := target_of(&mut c, v.t);
        mut r = resource(&mut c, v.t);
        info := &c.resources[r - 1];
        base := info.base - 1;
        return borrow_reference(&mut c, v.t, v.ty, base, target, write);
    }
    return place_slot(&mut c, id, ty, write);
}
// Borrow of a whole binding: references reborrow their referent, other values borrow the slot.
fn place_slot<a>(c: (&a mut C), id: u64, ty: u64, write: u64) -> Val {
    target := place_of(&mut c, id);
    mut referent = ty;
    mut source = target;
    if ty_kind(&mut c, ty) == 7 {
        source = target_of(&mut c, id);
        referent = ty_arg(&mut c, ty);
        get(&mut c, id, view("%rax"));
    } else {
        o(&mut c, view("leaq "));
        stack_slot(&mut c, id);
        o(&mut c, view(",%rax\n"));
    }
    slot := save(&mut c);
    mut out = reference_type(&mut c, referent, write);
    return borrow_reference(&mut c, slot, out, id, source, write);
}
// `&mut r` where `r` holds a reference borrows the binding's own slot, not its referent: the
// result is `&mut &T`, which lets a callee replace which referent `r` holds without gaining write
// access to the old referent. The old referent stays reachable read-only through the reference
// that `exchange` hands back.
fn reference_slot<a>(c: (&a mut C), id: u64, ty: u64) -> Val {
    if binding_mode(&c, id) != 2 {
        fail(&mut c, view("owned storage mutation requires mut"));
    }
    target := place_of(&mut c, id);
    o(&mut c, view("leaq "));
    stack_slot(&mut c, id);
    o(&mut c, view(",%rax\n"));
    slot := save(&mut c);
    out := reference_type(&mut c, ty, 1);
    own(&mut c, slot, out);
    loan := ownership::borrow_place(&mut c.check, target, 1);
    if loan == 0 {
        fail(&mut c, view("borrow conflicts with active access"));
    }
    holder := place_of(&mut c, slot);
    bond(&mut c, holder, loan);
    set_target(&mut c, slot, target, slot + 1);
    return val(slot, out);
}
// `&x`, `&x.f.g` and `&xs[i]` name places; anything else is a temporary.
fn borrow_place_ahead<a>(c: (&a mut C)) -> bool {
    if kind(&mut c) != 1 {
        return false;
    }
    p := c.pos;
    name := tok_text(&mut c, p);
    mut j = p + 1;
    while (kind_at(&mut c, j) == 46) & (kind_at(&mut c, j + 1) == 1) {
        j = j + 2;
    }
    k := kind_at(&mut c, j);
    if (k == 91) & (j == p + 1) {
        // `u64[1,2]` is a type-first literal, not indexing a local.
        if find_local(&mut c, view(name)) == 0 {
            if simple_type_head(&mut c, view(name)) {
                return false;
            }
            m := module_copy(&mut c);
            if find_decl(&mut c, view(m), view(name)) != 0 {
                return false;
            }
        }
    }
    // A named place remains a place before commas, semicolons and operators too.
    // Only a following call consumes an expression here (e.g. &make_value()).
    if k != 40 {
        if find_local(&mut c, view(name)) != 0 {
            return true;
        }
        if c.closure_env != 0 {
            closure := &c.closures[c.closure_env - 1];
            for i in closure.captures.len() {
                captured := &closure.captures[i];
                if same(view(captured), view(name)) {
                    return true;
                }
            }
        }
    }
    return (k == 41) || (k == 91);
}
// `&f(x)`: the temporary is held by a hidden binding until the end of the enclosing
// block (like `t := f(x); &t`), so the reference may be used after the statement.
fn borrow_temporary<a>(c: (&a mut C), write: u64) -> Val {
    v := expr(&mut c, 0);
    if ty_kind(&mut c, v.ty) == 7 {
        if write != 0 {
            if ty_mode(&mut c, v.ty) == 0 {
                fail(&mut c, view("mutable reborrow of shared reference"));
            }
        }
    }
    held := move_value(&mut c, v);
    bind(&mut c, copy_bytes(view(".borrowed")), held.ty, held.t, write);
    return place_slot(&mut c, held.t, held.ty, write);
}
fn hex(b: u64) -> u64 {
    if b < 58 {
        return b - 48;
    }
    if b < 71 {
        return b - 55;
    }
    return b - 87;
}
// view("literal") without building anything at run time: the literal's bytes, a `u8[]` object
// for them and the view descriptor all live in read-only data, each behind a block header whose
// state 2 marks it static (rt_free leaves those alone). The string object is the view's tracked
// source, exactly as the owned temporary would be, so borrow checking is unchanged. Mach-O keeps
// it in __DATA,__const because the objects hold absolute pointers.
fn static_literal_view<a>(c: (&a mut C)) -> Val {
    p := c.pos;
    bytes := decode_literal(&mut c, p);
    advance(&mut c);
    data := label(&mut c);
    text := label(&mut c);
    desc := label(&mut c);
    if c.plat == 1 {
        o(&mut c, view(".pushsection __DATA,__const\n"));
    } else {
        o(&mut c, view(".pushsection .rodata\n"));
    }
    o(&mut c, view(".p2align 3\n.quad 0\n.quad 2\n"));
    mark(&mut c, data);
    for i in bytes.len() {
        o(&mut c, view(".byte "));
        on(&mut c, bytes[i]);
        c.out.push(10);
    }
    o(&mut c, view(".byte 0\n.p2align 3\n.quad 0\n.quad 2\n"));
    mark(&mut c, text);
    o(&mut c, view(".quad "));
    lname(&mut c, data);
    o(&mut c, view("\n.quad "));
    on(&mut c, bytes.len());
    o(&mut c, view("\n.quad "));
    on(&mut c, bytes.len());
    o(&mut c, view("\n.quad 0\n.quad 2\n"));
    mark(&mut c, desc);
    o(&mut c, view(".quad "));
    lname(&mut c, data);
    o(&mut c, view("\n.quad "));
    on(&mut c, bytes.len());
    o(&mut c, view("\n.popsection\nleaq "));
    lname(&mut c, text);
    o(&mut c, view("(%rip),%rax\n"));
    source := save(&mut c);
    own(&mut c, source, 3);
    o(&mut c, view("leaq "));
    lname(&mut c, desc);
    o(&mut c, view("(%rip),%rax\n"));
    slot := save(&mut c);
    ty := intern_full(&mut c, 5, 0, 0, u64[]);
    own(&mut c, slot, ty);
    view_bonds(&mut c, slot, source, 0);
    release_temporary(&mut c, source);
    return val(slot, ty);
}
fn string_lit<a>(c: (&a mut C)) -> Val {
    p := c.pos;
    bytes := decode_literal(&mut c, p);
    advance(&mut c);
    mut l = label(&mut c);
    rodata(&mut c);
    mark(&mut c, l);
    for i in bytes.len() {
        o(&mut c, view(".byte "));
        on(&mut c, bytes[i]);
        c.out.push(10);
    }
    o(&mut c, view(".byte 0\n.popsection\nleaq "));
    lname(&mut c, l);
    o(&mut c, view("(%rip),%rax\n"));
    ptr := save(&mut c);
    n := imm(&mut c, bytes.len());
    t := invoke(&mut c, view("rt_string_lit"), two(ptr, n));
