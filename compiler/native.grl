fn cleanup<a>(c: (&a mut C), mark: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    mut i = c.resources.len();
    while mark < i {
        i = i - 1;
        release(&mut c, i);
    }
    return ();
}
fn move_out<a>(c: (&a mut C), v: Val) -> unit {
    if c.raw != 0 {
        return ();
    }
    if !needs_drop(&mut c, v.ty) {
        if ty_kind(&mut c, v.ty) != 7 {
            return ();
        }
    }
    index := resource(&mut c, v.t);
    if index == 0 {
        fail(&mut c, view("owned value lacks ownership record"));
    }
    // Moving a field out of an owned record leaves a hole its drop helper would walk. A record with a
    // user `Drop` is opaque to that walk, so the move is refused (`match &p` borrows instead).
    base_slot := c.resources[index - 1].base;
    via_slot := c.resources[index - 1].via;
    if (base_slot != 0) & (via_slot == 0) {
        parent := resource(&mut c, base_slot - 1);
        if parent != 0 {
            // stays: `c.resources[parent - 1]` is a borrowed element (see drop_hook_symbol).
            pty := c.resources[parent - 1].ty;
            if drop_type(&mut c, pty) != 0 {
                fail(&mut c, view("a field cannot be moved out of a value that implements Drop"));
            }
        }
    }
    mut r = &c.resources[index - 1];
    flag := r.flag;
    base := r.base;
    field := r.field;
    via := r.via;
    place := r.place;
    if place != 0 {
        capture_authority(&mut c, place);
        if ownership::take(&mut c.check, place) != 0 {
            pointer_conflict(&mut c, place, view("move"), 0);
            fail(&mut c, view("move of unavailable or borrowed value"));
        }
    }
    if flag != 0 {
        o(&mut c, view("movq $0,"));
        stack_slot(&mut c, flag - 1);
        c.out.push(10);
    } else {
        if base != 0 {
            if via != 0 {
                fail(&mut c, view("cannot move owned field through reference"));
            }
            zero := imm(&mut c, 0);
            rec_store(&mut c, base - 1, field, zero);
        }
    }
    return ();
}
// Whether a value of this type can hold a borrow its type does not show: a function value or an
// interface object (a closure that captured a reference), or something holding one.
fn may_hide_borrow<a>(c: (&a mut C), ty: u64) -> bool {
    mut trail = u64[];
    return hide_walk(&mut c, ty, &mut trail);
}
fn hide_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> bool {
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if (k == 12) || (k == 20) || (k == 25) || (k == 33) {
        return true;
    }
    if (k == 10) || (k == 6) || (k == 13) || (k == 14) || (k == 16) || (k == 29) {
        return hide_walk(&mut c, arg, &mut trail);
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return false;
            }
        }
        trail.push(ty);
        count := c.decls[arg].count;
        for i in count {
            t := field_type(&mut c, ty, i);
            if hide_walk(&mut c, t, &mut trail) {
                trail.pop();
                return true;
            }
        }
        trail.pop();
    }
    return false;
}
// Whether storage at or below `place` holds a live loan.
fn holds_live_loan<a>(c: (&a mut C), place: u64) -> bool {
    if place == 0 {
        return false;
    }
    for i in c.bonds.len() {
        holder := c.bonds[i].holder;
        // stays: `c.bonds[i]` is a borrowed element (see drop_hook_symbol).
        loan := c.bonds[i].loan;
        if ownership::ancestor(&c.check, place, holder) && (loan_live(&mut c, loan) != 0) {
            return true;
        }
    }
    return false;
}
fn move_value<a>(c: (&a mut C), v: Val) -> Val {
    get(&mut c, v.t, view("%rax"));
    slot := save(&mut c);
    old := place_of(&mut c, v.t);
    target := target_of(&mut c, v.t);
    move_out(&mut c, val(v.t, v.ty));
    own(&mut c, slot, v.ty);
    mut dst = place_of(&mut c, slot);
    kind := ty_kind(&mut c, v.ty);
    // A value typed by a generic signature (`Iter<T>`, T still a parameter), or a generic call's result
    // that captured its arguments' loans (captured_bonds: an `Iter<u64>` mapping references), may hold
    // borrows its type does not show; its loans move with it all the same.
    if contains_borrow(&mut c, v.ty, 0) || !concrete_type(&mut c, v.ty) || (may_hide_borrow(&mut c, v.ty) && holds_live_loan(&mut c, old)) {
        return_bonds(&mut c, old, dst, u64(kind == 6 || kind == 8));
    } else {
        if (kind == 26) & (dst == 0) & (old != 0) & (c.raw == 0) {
            dst = pointer_place(&mut c, slot, v.ty);
        }
        pointer_copy(&mut c, old, dst, v.ty);
