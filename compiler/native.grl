                .resources
                .push(
                    Resource {
                        slot: n,
                        ty: ty,
                        flag: 0,
                        base: a.t + 1,
                        field: 0,
                        via: 1,
                        place: target,
                        target: 0,
                        authority: a.t + 1,
                    }
                );
            frame := place_of(&mut c, a.t);
            count := c.bonds.len();
            for i in count {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
