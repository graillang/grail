// From c.pos: the end of a run of `[...]` groups and `.field` accessors (stopping before a
// method call `.m(`).
fn borrow_chain_end<a>(c: (&a mut C)) -> u64 {
    mut e = c.pos;
    while true {
        k := kind_at(&mut c, e);
        if (k == 46) & (kind_at(&mut c, e + 1) == 1) & (kind_at(&mut c, e + 2) != 40) {
            e = e + 2;
            continue;
        }
        if k == 91 {
            mut depth = 0;
            while true {
                kk := kind_at(&mut c, e);
                if (kk == 0) || (kk == 59) {
                    return e;
                }
                if kk == 91 {
                    depth = depth + 1;
                }
                if kk == 93 {
                    depth = depth - 1;
                    if depth == 0 {
                        break;
                    }
                }
                e = e + 1;
            }
            e = e + 1;
            continue;
        }
        break;
    }
    return e;
}
// Prefix byte-view borrowing binds tighter than binary operators.
fn view_borrow<a>(c: (&a mut C)) -> Val {
