    var c=C{
        src:bytes(), toks:vec<Tok>(), pos:0, out:vec<num>(), module:bytes(),
        specs:vec<Spec>(),bindings:vec<num>(),current_spec:0,validating:0,alias_next:1,types:vec<Ty>(), decls:vec<Decl>(), fields:vec<Field>(), funcs:vec<Func>(), params:vec<num>(),
        locals:vec<Local>(), next:0, entry:0, file:0,label:1,brk:0,cont:0,raw:0,rnames:vec<bytes>(),tnames:vec<bytes>(),resources:vec<Resource>(),loopmark:0,result:0,check:ownership::new(),members:vec<Member>(),terminated:0,loopcheck:ownership::new(),breaks:ownership::new(),hasbreak:0,bonds:vec<Bond>(),origins:vec<Origin>(),scope_end:0,loop_start:0,loop_end:0
    };
    for k in 5 { intern(borrow_mut(c),k+1,0); }
    host_fn(borrow_mut(c),read("argc"),0);
    host_fn(borrow_mut(c),read("arg"),2);
    host_fn(borrow_mut(c),read("read_file"),2);
    host_fn(borrow_mut(c),read("write_file"),0);
    host_fn(borrow_mut(c),read("print"),1);
    host_fn(borrow_mut(c),read("print_num"),1);
    host_fn(borrow_mut(c),read("newline"),1);
    host_fn(borrow_mut(c),read("command"),0);
    n :=host::argc();
    assert(2<n);
    for pass in 3 {
        if pass==1 { o(borrow_mut(c),read(".text\n")); }
        var i=2;
        while i<n {
            load_file(borrow_mut(c),i);
            exchange(borrow_mut(c.file),i);
            toplevel(borrow_mut(c),pass+1);
            i=i+1;
        }
    }
    emit_specializations(borrow_mut(c));
    emit_drops(borrow_mut(c));
    e :=c.entry;
    if e==0 { fail(borrow_mut(c),read("no public entry function with at most one parameter")); }
    f :=vec_get(c.funcs,e-1);
    m :=copy_bytes(read(f.module));
    name :=copy_bytes(read(f.name));
    count :=f.count;result :=f.ret;first :=f.first;
    named_main :=same(read(name),read("main"));
    if named_main{if (result!=0)&(result!=1){fail(borrow_mut(c),read("main must return unit or num"));}}else{if result!=0{fail(borrow_mut(c),read("executable entry must return num"));}}
    if count==1{param :=load(vec_get(c.params,first));mode :=ty_mode(borrow_mut(c),param);if (ty_kind(borrow_mut(c),param)!=5)+mode{fail(borrow_mut(c),read("executable entry requires readonly argv view"));}}
    o(borrow_mut(c),read(".globl _start\n_start:\nmovq (%rsp),%rdi\nleaq 8(%rsp),%rsi\nleaq 16(%rsp,%rdi,8),%rdx\nmovq %rdi,rt_state(%rip)\nmovq %rsi,rt_state+8(%rip)\nmovq %rdx,rt_state+16(%rip)\nandq $-16,%rsp\n"));
    if count==1 {
        ok :=label(borrow_mut(c));o(borrow_mut(c),read("cmpq $2,%rdi\n"));jump(borrow_mut(c),read("je"),ok);
        o(borrow_mut(c),read("movl $60,%eax\nmovl $2,%edi\nsyscall\n"));mark(borrow_mut(c),ok);
        o(borrow_mut(c),read("movl $1,%edi\ncall f_host_arg\nmovq %rax,%r12\nmovq %rax,%rdi\ncall rt_view\nmovq %rax,%rdi\n"));
    }
    o(borrow_mut(c),read("call "));mangle(borrow_mut(c),read(m),read(name));
    if count==1{o(borrow_mut(c),read("\nmovq %rax,%r13\nmovq %r12,%rdi\ncall rt_drop_seq\nmovq %r13,%rax"));}
    if named_main{if result==0{o(borrow_mut(c),read("\nmovq %rax,%r14\n"));}else{o(borrow_mut(c),read("\nxorq %r14,%r14\n"));}}
    else{o(borrow_mut(c),read("\nmovq %rax,%rdi\ncall rt_print_num\nxorq %r14,%r14\n"));}
    o(borrow_mut(c),read("call rt_live\ntestq %rax,%rax\n"));
    balanced :=label(borrow_mut(c));jump(borrow_mut(c),read("jz"),balanced);o(borrow_mut(c),read("call rt_abort\n"));mark(borrow_mut(c),balanced);
    o(borrow_mut(c),read("call rt_shutdown\nmovl $60,%eax\nmovq %r14,%rdi\nsyscall\nud2\n.bss\n.p2align 3\nrt_state: .zero 4096\n.section .note.GNU-stack,\"\",@progbits\n"));
    var out =bytes();
    for i in len(c.out) { push(out,load(vec_get(c.out,i))); }
    path :=host::arg(1);
    return host::write_file(read(path),read(out));
}
