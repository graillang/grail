        zero := imm(&mut c, 0);
        get(&mut c, zero, view("%rcx"));
        get(&mut c, operand.t, view("%rax"));
        o(&mut c, view("cmpq %rcx,%rax\nsete %al\nmovzbq %al,%rax\n"));
        ty := bool_type(&mut c);
        return val(save(&mut c), ty);
    }
    if (k == 45) & (c.raw == 0) {
        // Unary minus: negative literals (default i64, adopt a signed context) or signed values.
        start := c.pos;
        // -128i8: a negated suffixed literal is range-checked as the negative value.
        if kind_at(&mut c, start + 1) == 2 {
            num_tok := &c.toks[start + 1];
            nend := num_tok.end;
            suffix_tok := &c.toks[start + 2];
            sstart := suffix_tok.start;
            if (kind_at(&mut c, start + 2) == 1) & (sstart == nend) {
                suffix := tok_text(&mut c, start + 2);
                named := int_name(view(suffix));
                if named != 0 {
                    text := tok_text(&mut c, start + 1);
                    value := literal_value(&mut c, view(text));
                    ty := int_type_named(&mut c, named);
                    if ty_mode(&mut c, ty) == 0 {
                        fail(&mut c, view("unary minus needs a signed integer"));
                    }
                    if literal_fits(&mut c, ty, value, 1) == 0 {
                        fail(&mut c, view(literal_range_msg_v(&mut c, ty, value, 1)));
                    }
                    advance(&mut c);
                    advance(&mut c);
                    advance(&mut c);
                    o(&mut c, view("movabsq $"));
                    on(&mut c, value);
                    o(&mut c, view(",%rcx\nxorq %rax,%rax\nsubq %rcx,%rax\n"));
                    return val(save(&mut c), ty);
                }
            }
        }
        advance(&mut c);
        operand := expr(&mut c, 10);
        if (c.lit_start == start + 1) & (c.lit_end == c.pos) & (operand.ty == 0) {
            value := c.lit_value;
            exchange(&mut c.lit_start, start);
            exchange(&mut c.lit_negative, 1);
            ty := int_type(&mut c, 64, 1);
            if literal_fits(&mut c, ty, value, 1) == 0 {
                fail(&mut c, view(literal_range_msg_v(&mut c, ty, value, 1)));
            }
            zero := imm(&mut c, 0);
            get(&mut c, operand.t, view("%rcx"));
            get(&mut c, zero, view("%rax"));
            o(&mut c, view("subq %rcx,%rax\n"));
            return val(save(&mut c), ty);
        }
        ot := operand.ty;
        if is_float(&mut c, ot) {
            fl := (c.flit_start == start + 1) & (c.flit_end == c.pos);
            mut slot = 0;
            if float_inline(&c) {
                slot = float_sign(&mut c, operand.t, 1);
            } else {
                slot = invoke(&mut c, view("rt_f64_neg"), one(operand.t));
            }
            if fl {
                exchange(&mut c.flit_start, start);
                exchange(&mut c.flit_neg, 1);
            }
            return val(slot, ot);
        }
        if ty_kind(&mut c, ot) != 18 {
            fail(&mut c, view("unary minus needs a signed integer (u64 is unsigned)"));
        }
        if ty_mode(&mut c, ot) == 0 {
            fail(&mut c, view("unary minus needs a signed integer"));
