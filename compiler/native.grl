        mut args = two(x.t, index.t);
        args.push(v.t);
        // A u64 value must fit in a byte; u8 values always do.
        if v.ty != u {
            lim := imm(&mut c, 256);
            get(&mut c, lim, view("%rcx"));
            get(&mut c, v.t, view("%rax"));
            o(&mut c, view("cmpq %rcx,%rax\n"));
            ok := label(&mut c);
            jump(&mut c, view("jb"), ok);
            site_kind(&mut c, 11);
            call_out(&mut c, view("rt_abort"));
            mark(&mut c, ok);
        }
        invoke(&mut c, view("rt_write"), args);
    }
    exchange(&mut c.pos, after);
    return ();
}
fn assignment_ahead<a>(c: (&a mut C)) -> bool {
    if kind(&mut c) != 1 {
        return false;
    }
    mut e = c.pos + 1;
    while kind_at(&mut c, e) == 46 {
        e = e + 2;
    }
    k := kind_at(&mut c, e);
    return k == 61 || (261 < k && k < 267) || k == 268;
}
// Evaluates one argument to its dereferenced value.
fn operand<a>(c: (&a mut C)) -> Val {
    mut v = expr(&mut c, 0);
    return deref(&mut c, v);
}
fn write_statement<a>(c: (&a mut C)) -> unit {
    temps := c.resources.len();
    expect(&mut c, view("("));
    mut args = u64[];
    for i in 3 {
        if i != 0 {
            expect(&mut c, view(","));
        }
        value := operand(&mut c);
        v := value.t;
        ty := value.ty;
        if c.raw == 0 {
            if i == 0 {
                k := ty_kind(&mut c, ty);
                if (k != 5) || (ty_mode(&mut c, ty) == 0) {
                    fail(&mut c, view("write requires mutable byte view"));
                }
            } else {
                require_type(&mut c, ty, 0);
            }
        }
        get(&mut c, v, view("%rax"));
        snap := save(&mut c);
        r := resource(&mut c, v);
        if r != 0 {
            old := &c.resources[r - 1];
            ty := old.ty;
            place := old.place;
            authority := old.authority;
            c
                .resources
                .push(
                    Resource {
                        slot: snap,
                        ty: ty,
                        flag: 0,
                        base: v + 1,
                        field: 0,
                        via: 1,
                        place: place,
                        target: 0,
                        authority: authority,
                    }
                );
        }
        args.push(snap);
    }
    expect(&mut c, view(")"));
    expect(&mut c, view(";"));
    first := args[0];
    require_write(&mut c, first);
    invoke(&mut c, view("rt_write"), args);
    cleanup(&mut c, temps);
    return ();
}
// if let Variant(binding) = value { ... } else { ... }: consumes value like match; the else
// branch drops it (so a different variant's payload is cleaned up).
fn if_let<a>(c: (&a mut C)) -> unit {
    name := ident(&mut c);
    mut binding = u8[];
    mut has_binding = 0;
    if eat(&mut c, view("(")) {
        if !eat(&mut c, view("_")) {
            binding = ident(&mut c);
            has_binding = 1;
        }
        expect(&mut c, view(")"));
    }
    expect(&mut c, view("="));
    tests := c.resources.len();
    s := expr(&mut c, 0);
    x := deref(&mut c, s);
    xt := x.t;
    xty := x.ty;
    if ty_kind(&mut c, xty) != 8 {
        fail(&mut c, view("if let requires an enum value"));
    }
    d := ty_arg(&mut c, xty);
    decl := &c.decls[d];
    if decl.is_enum == 0 {
        fail(&mut c, view("if let requires an enum value"));
    }
    k := find_field(&mut c, d, view(name));
    pty := field_type(&mut c, xty, k);
    tag := rec_load(&mut c, xt, 0, 0);
    move_out(&mut c, val(xt, xty));
    before := ownership::snapshot(&c.check);
    no := label(&mut c);
    end := label(&mut c);
    get(&mut c, tag, view("%rax"));
    o(&mut c, view("cmpq $"));
    on(&mut c, k);
    o(&mut c, view(",%rax\n"));
    jump(&mut c, view("jne"), no);
    mark := c.locals.len();
    payloads := c.resources.len();
    payload := payload_load(&mut c, xt, xty, pty);
    own(&mut c, payload, pty);
    source := place_of(&mut c, xt);
    dest := place_of(&mut c, payload);
    if contains_borrow(&mut c, pty, 0) {
        transfer_bonds(&mut c, source, dest);
    }
    stored_source(&mut c, payload, pty);
    free_enum_shell(&mut c, xt, xty);
    if has_binding != 0 {
        bind(&mut c, binding, pty, payload, 0);
    }
    exchange(&mut c.terminated, 0);
    block(&mut c);
    cleanup(&mut c, payloads);
    pop_locals(&mut c, mark);
    yes := ownership::snapshot(&c.check);
    yt := c.terminated;
    jump(&mut c, view("jmp"), end);
    mark(&mut c, no);
    ownership::restore(&mut c.check, &before);
    exchange(&mut c.terminated, 0);
    get(&mut c, xt, view("%rdi"));
    drop_call(&mut c, xty);
    if eat(&mut c, view("else")) {
        if is(&mut c, view("if")) {
            statement(&mut c);
        } else {
            block(&mut c);
        }
    }
    nt := c.terminated;
    if yt == 0 {
        if nt != 0 {
            ownership::restore(&mut c.check, &yes);
        } else {
            ownership::merge(&mut c.check, &yes);
        }
    }
    exchange(&mut c.terminated, yt & nt);
    mark(&mut c, end);
    return ();
}
// match on an integer or bool: `0 => {..}`, `1 | 2 => {..}`, `'a' => {..}`, `_ => {..}`.
// A keyword that starts a statement, never an expression: an arm body written that way needs the
// braces of the block form. `true`/`false` are values, so they are not here.
fn arm_statement_word<a>(c: (&a mut C)) -> bool {
    if kind(&mut c) != 1 {
        return false;
    }
    // An expression `match` takes a value from each arm, and `if`/`match` are expressions: their own
    // forms refuse the statement shapes (an `if` without `else`, an arm with no value).
    if c.arm_value != 0 {
        if is(&mut c, view("if")) || is(&mut c, view("match")) {
            return false;
        }
    }
    return is(&mut c, view("if"))
        || is(&mut c, view("while"))
        || is(&mut c, view("for"))
        || is(&mut c, view("loop"))
        || is(&mut c, view("match"))
        || is(&mut c, view("let"))
        || is(&mut c, view("return"))
        || is(&mut c, view("break"))
        || is(&mut c, view("continue"))
        || is(&mut c, view("mut"))
        || is(&mut c, view("unsafe"))
        || is(&mut c, view("drop"))
        || is(&mut c, view("write"))
        || is(&mut c, view("assert"));
}
// A match arm's body: a block, or one expression (`Pat => f(x),`), which reaches the same code as
// the block form `Pat => { f(x) }` because the expression's temporaries are released here and the
// arm's cleanup runs afterwards either way. The ambiguous shapes are refused by name: a statement
// body needs braces (`=> if ...` was the case that read as an expression and could not be one),
// and a body that continues as a statement (`=> x = 1;`) is not an expression arm.
fn arm_body<a>(c: (&a mut C)) -> unit {
    at := c.pos;
    if is(&mut c, view("{")) {
        block(&mut c);
        // An expression `match` needs a value from every arm that reaches the join. A block that
        // always leaves the arm (`return`, `break`) produces none and needs none.
        if c.arm_value != 0 {
            if c.terminated == 0 {
                diag_help(
                    &mut c,
                    view("write one expression for the arm's value, or make the arm diverge with `return` or `break`")
                );
                fail_at(
                    &mut c,
                    at,
                    view("this arm of an expression `match` is a block of statements, so it has no value")
                );
            }
        }
        return ();
    }
    if arm_statement_word(&mut c) {
        fail(
            &mut c,
            view("this arm body is a statement, so it needs braces: write `Pat => { if ... }`")
        );
    }
    mut hint = c.arm_hint;
    if c.arm_ty != NO_TYPE {
        hint = c.arm_ty;
    }
    value_at := c.pos;
    mut v = expr_expected(&mut c, 0, hint);
    if kind(&mut c) == 61 {
        fail(
            &mut c,
            view("an arm body is one expression, not a statement: write `Pat => { x = 1; }`")
        );
    }
    if (261 < kind(&mut c)) & (kind(&mut c) < 267) {
        fail(
            &mut c,
            view("an arm body is one expression, not a statement: write `Pat => { x += 1; }`")
        );
    }
    if (c.arm_value != 0) & (hint != NO_TYPE) {
        v = adopt_value(&mut c, v, value_at, c.pos, hint);
    }
    if c.arm_value != 0 {
        match_arm_value(&mut c, v, value_at);
    } else {
        discard_value(&mut c, v);
    }
    if kind(&mut c) == 59 {
        fail(
            &mut c,
            view("an expression arm ends at `,` or `}`: for a statement body write `Pat => { stmt; }`")
        );
    }
    if (kind(&mut c) != 44) & (kind(&mut c) != 125) {
        fail(&mut c, view("expected `,` or `}` after this match arm"));
    }
    return ();
}
// An arm's value in an expression `match`. The first arm that produces one fixes the type; every
// later one is checked against it here, at the arm's own value, naming the arm that fixed it. The
// value goes into the match's frame word and its temporary is moved out, so the arm's own cleanup
// does not drop what the join now owns (`own` in match_value, after every arm has run).
fn match_arm_value<a>(c: (&a mut C), v: Val, at: u64) -> unit {
    if contains_borrow(&mut c, v.ty, 0) {
        diag_help(
            &mut c,
            view("the result is one word, so it cannot name the arms' different loans: use the reference inside each arm")
        );
        fail_at(&mut c, at, view("an expression `match` cannot produce a value that borrows"));
    }
    if c.arm_ty == NO_TYPE {
        exchange(&mut c.arm_ty, v.ty);
        exchange(&mut c.arm_at, at);
    } else {
        if (c.tolerant == 0) & (same_type(&mut c, v.ty, c.arm_ty) == 0) {
            first := source_type_name(&mut c, c.arm_ty);
            this := source_type_name(&mut c, v.ty);
            mut said = copy_bytes(view("the other arm is `"));
            push_bytes(&mut said, view(first));
            push_bytes(&mut said, view("`, this one is `"));
            push_bytes(&mut said, view(this));
            push_bytes(&mut said, view("`"));
            exchange(&mut c.diag_primary, said);
            if c.arm_at != 0 {
                diag_label(&mut c, c.arm_at, view("the other arm's type"));
            }
            fail_at(
                &mut c,
                at,
                view("every arm of an expression `match` must have the same type")
            );
        }
    }
    store_arm_word(&mut c, v, c.arm_slot);
    return ();
}
// An arm's value goes into the frame word the arms share. Ownership is established once, after the
// arms join (`own` in if_value/match_value), so this is the word move plus ending the arm's own
// ownership record - the arm's cleanup must not drop what the join owns.
fn store_arm_word<a>(c: (&a mut C), v: Val, slot: u64) -> unit {
    get(&mut c, v.t, view("%rax"));
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    move_out(&mut c, v);
    return ();
}
// `match n { 0 => 1, _ => 2 }` where a value is required. The match itself is the statement form's
// code (`match_statement`): the arms, their patterns, the ownership snapshots and the exhausted-match
// arm are unchanged, and an arm body writes its value into the word this allocates. That word is
// owned once, here, after the arms have joined.
fn match_value<a>(c: (&a mut C), expected: u64) -> Val {
    at := c.pos;
    advance(&mut c);
    slot := fresh(&mut c);
    old_value := c.arm_value;
    old_slot := c.arm_slot;
    old_ty := c.arm_ty;
    old_hint := c.arm_hint;
    old_at := c.arm_at;
    exchange(&mut c.arm_value, 1);
    exchange(&mut c.arm_slot, slot);
    exchange(&mut c.arm_ty, NO_TYPE);
    exchange(&mut c.arm_hint, expected);
    exchange(&mut c.arm_at, 0);
    match_statement(&mut c);
    ty := c.arm_ty;
    exchange(&mut c.arm_value, old_value);
    exchange(&mut c.arm_slot, old_slot);
    exchange(&mut c.arm_ty, old_ty);
    exchange(&mut c.arm_hint, old_hint);
    exchange(&mut c.arm_at, old_at);
    if ty == NO_TYPE {
        diag_help(&mut c, view("write it as a statement, with each arm's statements ending in `;`"));
        fail_at(
            &mut c,
            at,
            view("no arm of this `match` produces a value, so it is not an expression")
        );
    }
    return own(&mut c, slot, ty);
}
// ---- `if` in expression position ----------------------------------------------------------------
// `x := if c { 1 } else { 2 };`, `f(if c { a } else { b })`, `return if c { a } else { b };`.
//
// The shape is the statement `if`'s: the condition is checked as a condition, each arm is compiled in
// its own branch, and the two arms' ownership states are merged where the branches join. What an
// expression adds is the value. Every arm stores its one expression into the same word of this frame,
// and that word is owned once, after the merge, so exactly one value exists however many arms wrote
// it: each arm's temporaries are released where they are, and the joined word carries the drop.
//
// Refused here, by name: an `if` with no `else` (its value would not exist when the condition is
// false), two arms of different types, an arm that is a block of statements (it has no value - unless
// it diverges, `return`/`break`/an aborting call, which needs none), and an arm whose value borrows
// (one result word cannot name two arms' loans; the reference stays inside its arm). Rationale in
// docs/design/if-expression.md.

// A diagnostic about the construct at token `at` rather than about the token the parser had reached.
fn fail_at<a, b>(c: (&a mut C), at: u64, msg: &b [u8]) -> unit {
    exchange(&mut c.pos, at);
    fail(&mut c, msg);
    return ();
}
// Whether a `;` separates two statements of the braces from `from` to `to`: one at the braces' own
// depth, not one inside a nested block, a call's arguments or an index.
fn semicolon_in_head<a>(c: (&a mut C), from: u64, to: u64) -> bool {
    mut i = from;
    mut depth = 0;
    while i < to {
        k := kind_at(&mut c, i);
        if (k == 123) || (k == 40) || (k == 91) {
            depth += 1;
        }
        if (k == 125) || (k == 41) || (k == 93) {
            depth -= 1;
        }
        if (k == 59) & (depth == 0) {
            return true;
        }
        i += 1;
    }
    return false;
}
// A word that begins a statement and never begins an expression. `if` and `match` are not here: both
// are expressions in this position, and each refuses its own statement-only shapes.
fn statement_head<a, b>(t: &b [u8]) -> bool {
    return same(view(t), view("while"))
        || same(view(t), view("for"))
        || same(view(t), view("loop"))
        || same(view(t), view("let"))
        || same(view(t), view("mut"))
        || same(view(t), view("return"))
        || same(view(t), view("break"))
        || same(view(t), view("continue"))
        || same(view(t), view("unsafe"))
        || same(view(t), view("drop"))
        || same(view(t), view("write"))
        || same(view(t), view("assert"));
}
// Whether an `if` arm's braces hold statements rather than one expression: a `;` at their own depth,
// a statement word where their one item starts, a nested `{`, or nothing at all.
fn arm_holds_statements<a>(c: (&a mut C), open: u64, end: u64) -> bool {
    if open + 1 >= end {
        return true;
    }
    if kind_at(&mut c, open + 1) == 123 {
        return true;
    }
    if kind_at(&mut c, open + 1) == 1 {
        head := tok_text(&mut c, open + 1);
        if statement_head(view(head)) {
            return true;
        }
    }
    return semicolon_in_head(&mut c, open + 1, end);
}
// One arm of an `if` expression: `{ value }`, or a block of statements that diverges, which needs no
// value. Returns the arm's type, or NO_TYPE when the arm produced none.
fn if_arm<a>(c: (&a mut C), hint: u64, hint_at: u64, slot: u64) -> u64 {
    if !is(&mut c, view("{")) {
        fail(&mut c, view("an arm of an `if` expression is written `{ value }`"));
    }
    open := c.pos;
    end := block_end(&mut c, open);
    if arm_holds_statements(&mut c, open, end) {
        // `{ write; value }`: statements and then a value. A block here is a statement block, which
        // hands out no value, so the arm is refused where it starts rather than inside the block.
        last := kind_at(&mut c, end - 1);
        if (last != 59) & (last != 125) & (1 < end - open) {
            diag_help(
                &mut c,
                view("write only the value in the arm and put its statements before the `if`")
            );
            fail_at(
                &mut c,
                open,
                view("this arm of an `if` expression holds statements and then a value")
            );
        }
        block(&mut c);
        if c.terminated == 0 {
            diag_help(
                &mut c,
                view(
                    "write one expression for the arm's value, or make the arm diverge with `return` or `break`"
                )
            );
            fail_at(
                &mut c,
                open,
                view("this arm of an `if` expression is a block of statements, so it has no value")
            );
        }
        return NO_TYPE;
    }
    expect(&mut c, view("{"));
    pv_ir_open(&mut c);
    mark := c.locals.len();
    owners := c.resources.len();
    value_at := c.pos;
    mut v = expr_expected(&mut c, 0, hint);
    if (kind(&mut c) == 61) || ((261 < kind(&mut c)) & (kind(&mut c) < 267)) {
        diag_help(&mut c, view("write `{ value }` for the arm and the write outside the `if`"));
        fail_at(
            &mut c,
            value_at,
            view("an arm of an `if` expression is one value, not an assignment")
        );
    }
    arm_end := c.pos;
    if hint != NO_TYPE {
        v = adopt_value(&mut c, v, value_at, arm_end, hint);
    }
    expect(&mut c, view("}"));
    ty := v.ty;
    if_arm_store(&mut c, v, value_at, hint, hint_at, slot);
    cleanup(&mut c, owners);
    pop_locals(&mut c, mark);
    pv_ir_close(&mut c);
    return ty;
}
// The arm's value goes into the frame word all arms share. Ownership is established once, after the
// arms merge (`own` in if_value), so this is the word move plus ending the arm's own record.
fn if_arm_store<a>(c: (&a mut C), v: Val, at: u64, hint: u64, hint_at: u64, slot: u64) -> unit {
    if contains_borrow(&mut c, v.ty, 0) {
        diag_help(
            &mut c,
            view(
                "the result is one word, so it cannot name both arms' loans: use the reference inside each arm"
            )
        );
        fail_at(&mut c, at, view("an `if` expression cannot produce a value that borrows"));
    }
    if (hint_at != 0) & (hint != NO_TYPE) & (c.tolerant == 0) {
        if same_type(&mut c, v.ty, hint) == 0 {
            first := source_type_name(&mut c, hint);
            this := source_type_name(&mut c, v.ty);
            mut said = copy_bytes(view("the other arm is `"));
            push_bytes(&mut said, view(first));
            push_bytes(&mut said, view("`, this one is `"));
            push_bytes(&mut said, view(this));
            push_bytes(&mut said, view("`"));
            exchange(&mut c.diag_primary, said);
            diag_label(&mut c, hint_at, view("the other arm's type"));
            fail_at(
                &mut c,
                at,
                view("the two arms of an `if` expression must have the same type")
            );
        }
    }
    store_arm_word(&mut c, v, slot);
    return ();
}
// `if c { value } else { value }` where a value is required. `hint` is the type the place this value
// goes into has; `hint_at` the token of the arm that fixed it, or 0 when the type came from the
// context (which the enclosing check reports against by itself). `into` is the frame word an `else
// if` chain writes into - the outer `if`'s - or NO_TYPE for one this call allocates and owns (a slot
// number can be 0, so 0 cannot be that answer).
fn if_value<a>(c: (&a mut C), hint: u64, hint_at: u64, into: u64) -> Val {
    at := c.pos;
    advance(&mut c);
    if is(&mut c, view("let")) {
        fail_at(
            &mut c,
            at,
            view("`if let` binds in its branch, so it has no value: write a plain `if`/`else` whose arms are values")
        );
    }
    tests := c.resources.len();
    cond_at := c.pos;
    mut v = expr(&mut c, 0);
    cond_end := c.pos;
    if c.raw == 0 {
        require_type(&mut c, v.ty, 0);
        strict_condition(&mut c, v.ty);
    }
    cleanup(&mut c, tests);
    expire_locals(&mut c);
    mut conds = pv_ir_atoms(&mut c, cond_at, cond_end);
    mut gains = Atom[];
    pv_negation(&conds, &mut gains);
    pv_ir_statement(&mut c, cond_at, cond_end);
    // An `if` in expression position needs an `else`: without one, nothing names the value when the
    // condition is false. Said before either arm compiles, so it points at the `if`.
    if !is(&mut c, view("{")) {
        fail_at(&mut c, at, view("an arm of an `if` expression is written `{ value }`"));
    }
    after := block_end(&mut c, c.pos);
    if !is_at(&mut c, after + 1, view("else")) {
        diag_help(
            &mut c,
            view("add `else { ... }`, or write the `if` as a statement (its arms end with `;`)")
        );
        fail_at(
            &mut c,
            at,
            view("an `if` in expression position needs an `else`: with the condition false there would be no value")
        );
    }
    // The word every arm writes into. It has no type of its own: the value is owned once, after the
    // merge, at the type the arms agreed on.
    mut slot = fresh(&mut c);
    if into != NO_TYPE {
        exchange(&mut slot, into);
    }
    get(&mut c, v.t, view("%rax"));
    no := label(&mut c);
    end := label(&mut c);
    o(&mut c, view("testq %rax,%rax\n"));
    jump(&mut c, view("jz"), no);
    before := ownership::snapshot(&c.check);
    pv_ir_pending(&mut c, &conds);
    then_at := c.pos;
    mut ty = if_arm(&mut c, hint, hint_at, slot);
    yt := c.terminated;
    yes := ownership::snapshot(&c.check);
    jump(&mut c, view("jmp"), end);
    mark(&mut c, no);
    ownership::restore(&mut c.check, &before);
    exchange(&mut c.terminated, 0);
    // The `else` arm checks itself against the arm that already produced a value, when there is one.
    mut next_hint = 0;
    mut next_at = 0;
    if ty != NO_TYPE {
        next_hint = ty;
        next_at = then_at;
    }
    expect(&mut c, view("else"));
    mut et = 0;
    if is(&mut c, view("if")) {
        // `else if`: what the failed condition stated still holds while the next one is tested.
        pv_ir_open(&mut c);
        pv_ir_add_all(&mut c, &gains);
        inner := if_value(&mut c, next_hint, next_at, slot);
        pv_ir_close(&mut c);
        et = inner.ty;
    } else {
        pv_ir_pending(&mut c, &gains);
        et = if_arm(&mut c, next_hint, next_at, slot);
    }
    nt := c.terminated;
    if yt == 0 {
        if nt != 0 {
            ownership::restore(&mut c.check, &yes);
        } else {
            ownership::merge(&mut c.check, &yes);
        }
    }
    exchange(&mut c.terminated, yt & nt);
    mark(&mut c, end);
    if (yt != 0) & (nt != 0) {
        diag_help(&mut c, view("write it as a statement, with each arm's statements ending in `;`"));
        fail_at(
            &mut c,
            at,
            view("neither arm of this `if` produces a value, so it is not an expression")
        );
    }
    mut out_ty = ty;
    if out_ty == NO_TYPE {
        exchange(&mut out_ty, et);
    }
    if into != NO_TYPE {
        return val(slot, out_ty);
    }
    return own(&mut c, slot, out_ty);
}
fn scalar_match<a>(c: (&a mut C), s: Val, term: u8[]) -> unit {
    xt := s.t;
    ty := s.ty;
    observe(&mut c, xt);
    boolean := is_bool(&mut c, ty);
    // A pattern fact is read as an unsigned comparison, so it is only stated for a value that is
    // one: a signed integer's negative values would make the atom mean the wrong thing. Type id 0 is
    // `u64`, and only a spelled integer with a signed mode is not unsigned.
    mut unsigned_scrut = 1;
    if ty_kind(&mut c, ty) == 18 {
        if ty_mode(&mut c, ty) != 0 {
            unsigned_scrut = 0;
        }
    }
    if is_float(&mut c, ty) {
        unsigned_scrut = 0;
    }
    mut before = ownership::snapshot(&c.check);
    mut exits = ownership::new();
    mut have = 0;
    mut seen = u64[];
    mut default = 0;
    end := label(&mut c);
    expect(&mut c, view("{"));
    while !eat(&mut c, view("}")) {
        ownership::restore(&mut c.check, &before);
        exchange(&mut c.terminated, 0);
        next := label(&mut c);
        body := label(&mut c);
        // What this arm's pattern and guard state, for this arm's block only.
        mut arm_atoms = Atom[];
        mut alternatives = 0;
        mut only_lo = 0;
        mut only_hi = 0;
        mut only_ranged = 0;
        mut binding = u8[];
        mut wildcard = 0;
        if eat(&mut c, view("_")) {
            wildcard = 1;
        } else {
            if (kind(&mut c) == 1)
                & !is(&mut c, view("true"))
                & !is(&mut c, view("false")) {
                binding = ident(&mut c);
                wildcard = 1;
            }
        }
        // `if` after a pattern adds a guard; a guarded arm never makes the match exhaustive.
        if wildcard != 0 {
            if !is(&mut c, view("if")) {
                if default != 0 {
                    fail(&mut c, view("duplicate catch-all arm"));
                }
                default = 1;
            }
        } else {
            while true {
                negative := u64(eat(&mut c, view("-")));
                here := c.pos;
                k := kind(&mut c);
                mut value = 0;
                if boolean {
                    if negative != 0 {
                        fail(&mut c, view("bool patterns are true or false"));
                    }
                    if is(&mut c, view("true")) {
                        value = 1;
                    } else {
                        if !is(&mut c, view("false")) {
                            fail(&mut c, view("bool patterns are true or false"));
                        }
                    }
                    advance(&mut c);
                } else {
                    if k == 2 {
                        t := tok_text(&mut c, here);
                        value = literal_value(&mut c, view(t));
                        advance(&mut c);
                    } else {
                        if k == 4 {
                            value = char_literal(&mut c, here);
                            advance(&mut c);
                        } else {
                            fail(
                                &mut c,
                                view("match patterns must be integer or character literals (or _)")
                            );
                        }
                    }
                    if literal_fits(&mut c, ty, value, negative) == 0 {
                        fail(&mut c, view("match pattern out of range for the value's type"));
                    }
                    if negative != 0 {
                        value = wrapping_sub(0, value);
                    }
                }
                if alternatives == 0 {
                    only_lo = value;
                    only_hi = value;
                    only_ranged = 0;
                }
                if !boolean & (kind(&mut c) == 46) & (next_kind(&mut c) == 46) {
                    // lo..hi (hi excluded): (x - lo) < (hi - lo) as unsigned words, correct for signed types too.
                    advance(&mut c);
                    advance(&mut c);
                    hneg := u64(eat(&mut c, view("-")));
                    there := c.pos;
                    hk := kind(&mut c);
                    mut high = 0;
                    if hk == 2 {
                        t := tok_text(&mut c, there);
                        high = literal_value(&mut c, view(t));
                        advance(&mut c);
                    } else {
                        if hk == 4 {
                            high = char_literal(&mut c, there);
                            advance(&mut c);
                        } else {
                            fail(&mut c, view("range pattern needs an integer upper bound"));
                        }
                    }
                    if literal_fits(&mut c, ty, high, hneg) == 0 {
                        fail(&mut c, view("match pattern out of range for the value's type"));
                    }
                    if hneg != 0 {
                        high = wrapping_sub(0, high);
                    }
                    if alternatives == 0 {
                        only_hi = high;
                        only_ranged = 1;
                    }
                    mut empty = false;
                    if ty_kind(&mut c, ty) == 18 {
                        if ty_mode(&mut c, ty) != 0 {
                            empty = ((high ^ 9223372036854775808) < (value ^ 9223372036854775808))
                                || high == value;
                        } else {
                            empty = high < value || high == value;
                        }
                    } else {
                        empty = high < value || high == value;
                    }
                    if empty {
                        fail(&mut c, view("empty range pattern"));
                    }
                    o(&mut c, view("movabsq $"));
                    on(&mut c, value);
                    o(&mut c, view(",%rcx\n"));
                    get(&mut c, xt, view("%rax"));
                    o(&mut c, view("subq %rcx,%rax\n"));
                    width := wrapping_sub(high, value);
                    o(&mut c, view("movabsq $"));
                    on(&mut c, width);
                    o(&mut c, view(",%rcx\ncmpq %rcx,%rax\n"));
                    jump(&mut c, view("jb"), body);
                } else {
                    for i in seen.len() {
                        if seen[i] == value {
                            fail(&mut c, view("duplicate match pattern"));
                        }
                    }
                    seen.push(value);
                    o(&mut c, view("movabsq $"));
                    on(&mut c, value);
                    o(&mut c, view(",%rcx\n"));
                    get(&mut c, xt, view("%rax"));
                    o(&mut c, view("cmpq %rcx,%rax\n"));
                    jump(&mut c, view("je"), body);
                }
                alternatives += 1;
                if !eat(&mut c, view("|")) {
                    break;
                }
            }
            // One literal states `x == n` in the arm; one range states both of its bounds. An arm
            // with several alternatives states nothing, since the prover has no disjunction.
            if (alternatives == 1) & (unsigned_scrut != 0) {
                if only_ranged != 0 {
                    pv_ir_range(&mut c, &mut arm_atoms, view(term), only_lo, only_hi);
                } else {
                    pv_ir_literal(&mut c, &mut arm_atoms, view(term), only_lo);
                }
            }
            jump(&mut c, view("jmp"), next);
        }
        mark(&mut c, body);
        mark := c.locals.len();
        if binding.len() != 0 {
            bind(&mut c, binding, ty, xt, 0);
        }
        if eat(&mut c, view("if")) {
            tests := c.resources.len();
            guard_at := c.pos;
            g := expr(&mut c, 0);
            guard_end := c.pos;
            if !(is_bool(&mut c, g.ty) || g.ty == 0) {
                fail(&mut c, view("match guard must be a bool"));
            }
            cleanup(&mut c, tests);
            get(&mut c, g.t, view("%rax"));
            o(&mut c, view("testq %rax,%rax\n"));
            jump(&mut c, view("jz"), next);
            // The next arm starts from the state before or after the guard, whichever path reached it.
            after := ownership::snapshot(&c.check);
            mut merged = ownership::snapshot(&before);
            ownership::merge(&mut merged, &after);
            before = merged;
            // A true guard is what reaching this arm's body means, so it states its facts there.
            mut guards = pv_ir_atoms(&mut c, guard_at, guard_end);
            pv_ir_statement(&mut c, guard_at, guard_end);
            for i in guards.len() {
                x := &guards[i];
                pv_add(&mut arm_atoms, x.rel, view(x.a), view(x.b), x.k);
            }
        }
        expect(&mut c, view("=>"));
        pv_ir_pending(&mut c, &arm_atoms);
        arm_body(&mut c);
        pop_locals(&mut c, mark);
        if c.terminated == 0 {
            edge := ownership::snapshot(&c.check);
            if have != 0 {
                ownership::merge(&mut exits, &edge);
            } else {
                exits = edge;
                have = 1;
            }
        }
        jump(&mut c, view("jmp"), end);
        mark(&mut c, next);
        if !eat(&mut c, view(",")) {
            expect(&mut c, view("}"));
            break;
        }
    }
    complete := default != 0 || (boolean && seen.len() == 2);
    if !complete {
        fail(&mut c, view("non-exhaustive match (add a _ arm)"));
    }
    call_out(&mut c, view("rt_abort"));
    mark(&mut c, end);
    if have != 0 {
        ownership::restore(&mut c.check, &exits);
        exchange(&mut c.terminated, 0);
    } else {
        exchange(&mut c.terminated, 1);
    }
    return ();
}
// A record pattern names a field the record does not have, or forgets one: report which.
fn field_index<a, b>(c: (&a mut C), decl: u64, name: &b [u8]) -> u64 {
    d := &c.decls[decl];
    for i in d.count {
        f := &c.fields[d.first + i];
        if same(view(f.name), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
fn fail_unknown_field<a, b>(c: (&a mut C), name: &b [u8]) -> unit {
    mut msg = u8[];
    push_bytes(&mut msg, view("unknown field in record pattern: "));
    push_bytes(&mut msg, name);
    fail(&mut c, view(msg));
    return ();
}
fn fail_missing_field<a>(c: (&a mut C), decl: u64, index: u64) -> unit {
    mut msg = u8[];
    push_bytes(&mut msg, view("record pattern is missing field: "));
    d := &c.decls[decl];
    f := &c.fields[d.first + index];
    push_bytes(&mut msg, view(f.name));
    fail(&mut c, view(msg));
    return ();
}
// `match p { Point { x, y: other, .. } => ... }` on a record value. A record pattern matches
// every value, so it is the only pattern arm (an explicit `_` may follow and is never taken).
// Fields bind by copy for plain scalars, by move when the scrutinee is moved, and as references
// through `match &p`/`match &mut p`, exactly as enum payload patterns do.
fn record_match<a>(c: (&a mut C), sslot: u64, sty: u64, x: Val, byref: u64, refmode: u64) -> unit {
    xt := x.t;
    xty := x.ty;
    d := ty_arg(&mut c, xty);
    count := c.decls[d].count;
    expect(&mut c, view("{"));
    if is(&mut c, view("_")) {
        fail(&mut c, view("match on a record takes a record pattern"));
    }
    name := ident(&mut c);
    if !same(view(name), view(c.decls[d].name)) {
        fail(&mut c, view("pattern type is not the scrutinee's record type"));
    }
    if c.decls[d].c_layout != 0 {
        fail(&mut c, view("a record pattern needs a Grail record, not an extern record"));
    }
    // A moved scrutinee gives each field to its binder; a record with a user `Drop` cannot be taken
    // apart that way, so `match &p` (fields bound as references) is the form that works.
    if (byref == 0) & (drop_type(&mut c, xty) != 0) {
        fail(&mut c, view("a value that implements Drop cannot be destructured; match &p binds its fields as references"));
    }
    if byref == 0 {
        move_out(&mut c, val(xt, xty));
    }
    before := ownership::snapshot(&c.check);
    root := place_of(&mut c, xt);
    mark := c.locals.len();
    payloads := c.resources.len();
    expect(&mut c, view("{"));
    mut seen = u64[];
    mut rest = 0;
    while true {
        if eat(&mut c, view("}")) {
            break;
        }
        if (kind(&mut c) == 46) & (next_kind(&mut c) == 46) {
            advance(&mut c);
            advance(&mut c);
            rest = 1;
            if eat(&mut c, view(",")) {
                fail(&mut c, view(".. must be the last item in a record pattern"));
            }
            expect(&mut c, view("}"));
            break;
        }
        field := ident(&mut c);
        found := field_index(&mut c, d, view(field));
        if found == 0 {
            fail_unknown_field(&mut c, view(field));
        }
        k := found - 1;
        for i in seen.len() {
            if seen[i] == k {
                fail(&mut c, view("duplicate field in a record pattern"));
            }
        }
        seen.push(k);
        mut binder = field;
        if eat(&mut c, view(":")) {
            binder = ident(&mut c);
            if same(view(binder), view("_")) {
                fail(&mut c, view("a record pattern field binds a name; use .. to ignore fields"));
            }
        }
        fty := field_type(&mut c, xty, k);
        if (byref != 0) && (refmode != 0) && !scalar(&mut c, fty) && ref_field_refined(&mut c, d, k) {
            ref_field_loan_fail(&mut c, d, k);
        }
        if byref != 0 {
            if scalar(&mut c, fty) {
                value := field_load(&mut c, xt, xty, k, 0);
                bind(&mut c, binder, fty, value, 0);
            } else {
                n := field_reference(&mut c, xt, xty, k);
                refty := reference_type(&mut c, fty, refmode);
                target := member_place(&mut c, root, k, fty);
                authority := authority_of(&mut c, xt);
                c
                    .resources
                    .push(
                        Resource {
                            slot: n,
                            ty: refty,
                            flag: 0,
                            base: xt + 1,
                            field: k,
                            via: 1,
                            place: 0,
                            target: target,
                            authority: authority
                        }
                    );
                r := borrow_reference(&mut c, n, refty, xt, target, refmode);
                bind(&mut c, binder, r.ty, r.t, 0);
            }
        } else {
            payload := field_load(&mut c, xt, xty, k, 0);
            if scalar(&mut c, fty) {
                bind(&mut c, binder, fty, payload, 0);
            } else {
                own(&mut c, payload, fty);
                if contains_borrow(&mut c, fty, 0) {
                    // The scrutinee's loans follow a moved field: the record storage holds them at
                    // its own place, so they move from there to the extracted value.
                    dest := place_of(&mut c, payload);
                    transfer_bonds(&mut c, root, dest);
                }
                stored_source(&mut c, payload, fty);
                bind(&mut c, binder, fty, payload, 0);
            }
        }
        if !eat(&mut c, view(",")) {
            expect(&mut c, view("}"));
            break;
        }
    }
    if (rest == 0) & (seen.len() != count) {
        for i in count {
            mut used = 0;
            for j in seen.len() {
                if seen[j] == i {
                    used = 1;
                }
            }
            if used == 0 {
                fail_missing_field(&mut c, d, i);
            }
        }
    }
    if byref == 0 {
        // Fields the pattern leaves out (`..`) are dropped with the record's storage.
        for k in count {
            mut used = 0;
            for i in seen.len() {
                if seen[i] == k {
                    used = 1;
                }
            }
            if used == 0 {
                fty := field_type(&mut c, xty, k);
                if needs_drop(&mut c, fty) {
                    value := field_load(&mut c, xt, xty, k, 0);
                    get(&mut c, value, view("%rdi"));
                    drop_call(&mut c, fty);
                }
            }
        }
        if !framed(&mut c, xty) {
            // A plain record's words are its frame's: only a boxed record has a shell to free.
        invoke(&mut c, view("rt_free"), one(xt));
        }
    }
    expect(&mut c, view("=>"));
    if byref != 0 {
        arm_scrutinee(&mut c, sslot, sty);
    }
    arm_body(&mut c);
    cleanup(&mut c, payloads);
    pop_locals(&mut c, mark);
    eaten := eat(&mut c, view(","));
    if eaten & !is(&mut c, view("_")) & !is(&mut c, view("}")) {
        fail(&mut c, view("a record pattern must be the only pattern arm"));
    }
    if is(&mut c, view("_")) {
        // The `_` arm is unreachable, but it is still checked: it starts where the record arm did
        // and drops the scrutinee itself.
        after := ownership::snapshot(&c.check);
        term := c.terminated;
        end := label(&mut c);
        advance(&mut c);
        if term == 0 {
            jump(&mut c, view("jmp"), end);
        }
        expect(&mut c, view("=>"));
        ownership::restore(&mut c.check, &before);
        exchange(&mut c.terminated, 0);
        if byref != 0 {
            arm_scrutinee(&mut c, sslot, sty);
        } else {
            get(&mut c, xt, view("%rdi"));
            drop_call(&mut c, x.ty);
        }
        arm_body(&mut c);
        eat(&mut c, view(","));
        expect(&mut c, view("}"));
        mark(&mut c, end);
        if term == 0 {
            ownership::restore(&mut c.check, &after);
        }
        exchange(&mut c.terminated, term);
        return ();
    }
    expect(&mut c, view("}"));
    return ();
}
// One field of the record value `base`, read by name: the last projection of field_path, without
// tokens. The loop lowering below binds members of a call result this way.
fn record_member<a, b>(c: (&a mut C), base: Val, name: &b [u8]) -> Val {
    if ty_kind(&mut c, base.ty) != 8 {
        fail(&mut c, view("map iteration needs a pair view"));
        return val(0, 0);
    }
    d := ty_arg(&mut c, base.ty);
    k := find_field(&mut c, d, view(name));
    fty := field_type(&mut c, base.ty, k);
    n := field_load(&mut c, base.t, base.ty, k, 0);
    alias_field(&mut c, n, fty, base.t, k, 0);
    observe(&mut c, n);
    return val(n, fty);
}
// `for k, v in &m { .. }` and `for k, v in &mut m { .. }`: a map's layout is private to hashmap, so
// the compiler counts positions and asks the map for the pair at each one, which is what
// `map_len`/`key_at`/`value_at` exist for. The exclusive form asks for one `entry_at` view per
// position instead: its shared key and exclusive value are the two bindings, the same split as
// `Entry`. A single reference is held for the whole loop (in a hidden binding), so the body cannot
// grow the map, and only the exclusive form can write to a value.
fn map_loop<a, b, d>(c: (&a mut C), name: &b [u8], value_name: &d [u8]) -> unit {
    loopbase := c.resources.len();
    locals_base := c.locals.len();
    map := expr(&mut c, 0);
    // `&m`, `&mut m` and an already-borrowed map all iterate; an owned map would be moved, so it
    // is refused with the fix written out.
    mut mapty = 0;
    if (c.raw == 0) & (ty_kind(&mut c, map.ty) == 7) {
        mapty = ty_arg(&mut c, map.ty);
    }
    if !is_map_type(&mut c, mapty) {
        fail(
            &mut c,
            view(
                "for k, v iterates a map by reference: `for k, v in &m` reads the pairs, `for k, v in &mut m` updates the values"
            )
        );
        return ();
    }
    // A fact scope of its own, as the other loops have: the pair bindings end with the loop.
    pv_ir_open(&mut c);
    mode := ty_mode(&mut c, map.ty);
    refty := map.ty;
    refslot := map.t;
    bind(&mut c, copy_bytes(view("__map")), refty, refslot, 0);
    mut open = c.pos;
    while kind_at(&mut c, open) != 123 {
        open = open + 1;
    }
    loopend := block_end(&mut c, open);
    last := c.locals.len() - 1;
    mut hidden = &mut c.locals[last];
    exchange(&mut hidden.last, loopend);
    // The count is read once, before the body may borrow anything: growth inside the loop is a
    // separate, later borrow that the held reference refuses.
    mut count = Val[];
    count.push(place_slot(&mut c, refslot, refty, 0));
    e := map_call(&mut c, view("map_len"), mapty, count).t;
    i := imm(&mut c, 0);
    head := label(&mut c);
    step := label(&mut c);
    end := label(&mut c);
    oldb := c.brk;
    oldc := c.cont;
    oldmark := c.loopmark;
    oldstart := c.loop_start;
    oldend := c.loop_end;
    exchange(&mut c.loop_start, c.pos);
    exchange(&mut c.loop_end, loopend);
    loopmark := c.resources.len();
    exchange(&mut c.loopmark, loopmark);
    oldloop := exchange(&mut c.loopcheck, ownership::snapshot(&c.check));
    oldbreak := exchange(&mut c.breaks, ownership::new());
    oldhas := c.hasbreak;
    exchange(&mut c.hasbreak, 0);
    exchange(&mut c.brk, end);
    exchange(&mut c.cont, step);
    mark(&mut c, head);
    get(&mut c, e, view("%rcx"));
    get(&mut c, i, view("%rax"));
    o(&mut c, view("cmpq %rcx,%rax\n"));
    jump(&mut c, view("jae"), end);
    iteration := c.locals.len();
    entry := ownership::snapshot(&c.check);
    if mode != 0 {
        mut args = Val[];
        args.push(place_slot(&mut c, refslot, refty, 1));
        args.push(val(i, 0));
        pair := map_call(&mut c, view("entry_at"), mapty, args);
        pair_slot := pair.t;
        pair_type := pair.ty;
        key := record_member(&mut c, val(pair_slot, pair_type), view("key"));
        bind(&mut c, name.copy(), key.ty, key.t, 0);
        value := record_member(&mut c, val(pair_slot, pair_type), view("value"));
        bind(&mut c, value_name.copy(), value.ty, value.t, 0);
    } else {
        mut args = Val[];
        args.push(place_slot(&mut c, refslot, refty, 0));
        args.push(val(i, 0));
        key := map_call(&mut c, view("key_at"), mapty, args);
        bind(&mut c, name.copy(), key.ty, key.t, 0);
        mut value_args = Val[];
        value_args.push(place_slot(&mut c, refslot, refty, 0));
        value_args.push(val(i, 0));
        value := map_call(&mut c, view("value_at"), mapty, value_args);
        bind(&mut c, value_name.copy(), value.ty, value.t, 0);
    }
    exchange(&mut c.terminated, 0);
    pv_loop_kill(&mut c, open, loopend);
    block(&mut c);
    if c.terminated == 0 {
        cleanup(&mut c, loopmark);
    }
    if c.terminated == 0 {
        if !backedge_ok(&mut c, &ownership::snapshot(&c.loopcheck)) {
            fail_backedge(&mut c, view("loop backedge consumes entry storage"));
        }
    }
    // A body that always returns or continues reaches the exit only through the entry state.
    if c.terminated != 0 {
        ownership::restore(&mut c.check, &entry);
    } else {
        ownership::merge(&mut c.check, &entry);
    }
    if c.hasbreak != 0 {
        ownership::merge(&mut c.check, &ownership::snapshot(&c.breaks));
    }
    exchange(&mut c.terminated, 0);
    pop_locals(&mut c, iteration);
    mark(&mut c, step);
    o(&mut c, view("incq "));
    stack_slot(&mut c, i);
    c.out.push(10);
    jump(&mut c, view("jmp"), head);
    mark(&mut c, end);
    cleanup(&mut c, loopbase);
    pop_locals(&mut c, locals_base);
    exchange(&mut c.brk, oldb);
    exchange(&mut c.cont, oldc);
    exchange(&mut c.loopmark, oldmark);
    exchange(&mut c.loopcheck, oldloop);
    exchange(&mut c.breaks, oldbreak);
    exchange(&mut c.hasbreak, oldhas);
    exchange(&mut c.loop_start, oldstart);
    exchange(&mut c.loop_end, oldend);
    pv_ir_close(&mut c);
    return ();
}
// `mut r: R;` for an extern "C" record allocates `sizeof(struct)` zeroed bytes, because C's
// out-parameter must be able to read every field it does not overwrite and the address has to exist
// before `&mut r` is taken. The *value* still does not exist: the place starts uninitialised, so
// reading a field before a foreign call (or an assignment) wrote the storage is refused exactly as
// it is for any other uninitialised binding. Zeroed storage is not an initialised handle.
fn zero_record_binding<a>(c: (&a mut C), name: u8[], ty: u64, mutable: u64) -> unit {
    d := ty_arg(&mut c, ty);
    words := ffi_record_words(&mut c, d);
    sz := imm(&mut c, words);
    rec := invoke(&mut c, view("rt_rec"), one(sz));
    zero := imm(&mut c, 0);
    for k in words {
        rec_store(&mut c, rec, k, zero);
    }
    own(&mut c, rec, ty);
