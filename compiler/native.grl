    name := tok_text(&mut c, pos);
    local := find_local(&mut c, view(name));
    if local == 0 {
        return false;
    }
    mut ty = local_ty(&mut c, local - 1);
    mut q = pos + 1;
    while kind_at(&mut c, q) == 46 {
        while ty_kind(&mut c, ty) == 7 {
            ty = ty_arg(&mut c, ty);
