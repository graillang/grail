            if expected_result {
                from_success = result_success_count(&mut c, v.ty);
                to_success = result_success_count(&mut c, expected);
            }
            for i in from.len() {
                mut found = 0;
                mut target = 0;
                for j in args.len() {
                    if same_type(&mut c, from[i], args[j]) != 0 {
                        found += 1;
                        target = j;
                    }
                }
                if found != 1 {
                    valid = 0;
                }
                if expected_result {
                    if (i < from_success) {
                        if to_success <= target {
                            fail(
                                &mut c,
                                view("result union conversion changes success/failure partition")
                            );
                        }
                    } else {
                        if target < to_success {
                            fail(
                                &mut c,
                                view("result union conversion changes success/failure partition")
                            );
                        }
                    }
                }
                mapping.push(target);
            }
            if valid != 0 {
                held := move_value(&mut c, v);
                done := label(&mut c);
                for i in mapping.len() {
                    next := label(&mut c);
                    get(&mut c, held.t, view("%rax"));
                    o(&mut c, view("cmpq $"));
                    on(&mut c, i);
                    o(&mut c, view(",(%rax)\n"));
                    jump(&mut c, view("jne"), next);
                    o(&mut c, view("movq $"));
                    on(&mut c, mapping[i]);
                    o(&mut c, view(",(%rax)\n"));
                    jump(&mut c, view("jmp"), done);
                    mark(&mut c, next);
                }
                o(&mut c, view("call rt_abort\n"));
                mark(&mut c, done);
                slot := held.t;
                source := place_of(&mut c, slot);
                move_out(&mut c, held);
                own(&mut c, slot, expected);
                dest := place_of(&mut c, slot);
                transfer_bonds(&mut c, source, dest);
                return val(slot, expected);
            }
        }
        mut found = 0;
        mut which = 0;
        for i in args.len() {
            if same_type(&mut c, v.ty, args[i]) != 0 {
                found += 1;
                which = i;
            }
        }
        if (found == 0)
            & (c.flit_start == start)
            & (c.flit_end == end)
            & is_float(&mut c, v.ty) {
            for i in args.len() {
                if is_f32(&mut c, args[i]) {
                    found += 1;
                    which = i;
                }
