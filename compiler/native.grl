}
// Documents a typed-IR fact: a binding's frame slot holds an f32 (docs/design/typed-ir.md, F2).
// The table travels beside the word stream and only the LLVM lifter reads it; a slot reused for a
// non-f32 binding, or one the body touches in any way other than one eight-byte word at a time,
// is dropped there and keeps the untyped lowering.
// F1: `what` for a value whose word is a pointer to a sequence header -- 2/3/4 for a vector whose
// elements are 8, 4 or 1 bytes wide (`+16` is `cap`), 5 for a descriptor `{data, len}`, whose
// `+16` is uninitialised and must never be read -- and 0 for anything else.
fn header_what<a>(c: (&a mut C), ty: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    t := base_type(&mut c, ty);
    k := ty_kind(&mut c, t);
    if (k == 3) || (k == 4) {
        return 4;
    }
    if k != 6 {
        return 0;
    }
    e := ty_arg(&mut c, t);
    if narrow_code(&mut c, e) != 0 {
        return 3;
    }
    return 2;
}
// F1: the element width of a sequence header, which is not the header's own stride.
fn header_width<a>(c: (&a mut C), ty: u64) -> u64 {
    t := base_type(&mut c, ty);
    k := ty_kind(&mut c, t);
    if (k == 3) || (k == 4) {
        return 1;
    }
    e := ty_arg(&mut c, t);
    if narrow_code(&mut c, e) != 0 {
        return 4;
    }
    return 8;
}
// F1: argument 0 of the call just emitted is the header of `seq`, whose element type the word
// stream loses. The lifter types the accessor's parameter with it and reads `data`/`len` once.
fn fact_seq_arg<a>(c: (&a mut C), callee: &[u8], seq: u64, seqty: u64) -> unit {
    if (c.backend == 0) || (c.validating != 0) || (c.raw != 0) || (c.facts_fn.len() == 0) {
        return ();
    }
    hw := header_what(&mut c, seqty);
    if hw == 0 {
        return ();
    }
    name := copy_bytes(view(c.facts_fn));
    cn := copy_bytes(callee);
    wd := header_width(&mut c, seqty);
    od := c.f1_ord;
    llvm::fact_header_arg(&mut c.facts, name, od, cn, hw, wd);
    return ();
}
fn emit_slot_fact<a>(c: (&a mut C), ty: u64, slot: u64) -> unit {
    // An `unsafe module` type-checks nothing, so in one a slot's declared type says nothing about
    // what is written to it; the fact is only sound where the front end enforces the type.
    if (c.backend == 0) || (c.validating != 0) || (c.raw != 0) || (c.facts_fn.len() == 0) {
        return ();
    }
    name := copy_bytes(view(c.facts_fn));
    hw := header_what(&mut c, ty);
    if c.f1_what != 0 {
        wd := header_width(&mut c, ty);
        llvm::fact_header_slot(&mut c.facts, name, slot, c.f1_what, wd);
        return ();
    }
    if hw != 0 {
        // The slot holds a sequence header: the pointer type and the element width are the fact.
        wd := header_width(&mut c, ty);
        llvm::fact_header_slot(&mut c.facts, name, slot, hw, wd);
        return ();
    }
    f32 := u64(is_f32(&mut c, ty));
    llvm::fact_slot(&mut c.facts, name, slot, f32);
    return ();
}
// `op(lhs, rhs)` on floats. With `single` (both operands' static type is f32) the call carries the
// fact the LLVM lifter rewrites into real `f* float` arithmetic; an f64 call gets none and keeps
// the word lowering. `invoke` has just recorded which call this is, and the opcode travels with
// the fact so the lifter needs neither the immediate nor a second look at the word.
fn float_op_call<a>(c: (&a mut C), op: u64, lhs: u64, rhs: u64, single: u64) -> u64 {
    opv := imm(&mut c, op);
    t := invoke(&mut c, view("rt_f64_op"), three(opv, lhs, rhs));
    if (single != 0) & (c.backend != 0) & (c.validating == 0) & (c.facts_fn.len() != 0) {
        name := copy_bytes(view(c.facts_fn));
        ordinal := c.call_ord;
        llvm::fact_op(&mut c.facts, name, ordinal, op);
    }
