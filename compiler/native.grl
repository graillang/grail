    bt := b.t;
    if same(&name, &"append") {
        if c.raw == 0 {
            if k != 4 {
                fail(borrow_mut(c), &"append requires string destination");
            }
            bk := ty_kind(borrow_mut(c), b.ty);
            if (bk != 3) & (bk != 4) & (bk != 5) {
                fail(borrow_mut(c), &"append requires byte source");
            }
        }
        require_write(borrow_mut(c), xt);
        invoke(borrow_mut(c), &"rt_append_text", two(xt, bt));
        return val(imm(borrow_mut(c), 0), 1);
    }
    if same(&name, &"push") == 0 {
        fail(borrow_mut(c), &"unknown collection method");
    }
    if c.raw == 0 {
        if (k != 3) & (k != 6) {
            fail(borrow_mut(c), &"push requires bytes/vector");
        }
