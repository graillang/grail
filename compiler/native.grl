            // Parameters are typed in the closure's own lifetime namespace (`env` is region 1): each
            // elided reference is a fresh input lifetime, borrowed anew on every call.
            mut closure_names = u8[][];
            closure_names.push(copy_bytes(view("env")));
            outer_names := exchange(&mut c.rnames, closure_names);
            outer_inputs := exchange(&mut c.input_regions, u64[]);
            outer_parsing := exchange(&mut c.parsing_input, 1);
            while true {
                n := ident(&mut c);
                mut ty = 0;
