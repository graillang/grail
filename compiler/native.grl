                        }
                        found = 1;
                    }
                }
            }
        }
        if found == 0 {
            fail(&mut c, view("opaque captured storage lacks a checked local frame"));
        }
        return ();
    }
    allowed := type_caps(&mut c, ty, 0);
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if ownership::ancestor(&c.check, source, holder) {
            if loan_live(&mut c, loan) != 0 {
                mut l = &c.check.loans[loan - 1];
                origin := l.source;
                mut r = region_of(&mut c, origin);
                if r != 18446744073709551615 {
                    mut found = 0;
                    for j in allowed.len() {
