    return val(slot, ret);
}
fn specialized_function_value<a>(c: (&a mut C), index: u64, map: u64[]) -> Val {
    f := &c.funcs[index];
    types := f.types;
    raw := f.raw;
    first := f.first;
    count := f.count;
    ret := f.ret;
