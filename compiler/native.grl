    }
    if same(view(first), view("Self")) & ((c.self_type != NO_TYPE)) {
        mut st = c.self_type;
        if c.bindings.len() != 0 {
            st = bind_types(&mut c, st, &copy_numbers(&c.bindings));
        }
        if is(&mut c, view("::")) && (next_kind(&mut c) == 1) {
            advance(&mut c);
            assoc_name := ident(&mut c);
            return assoc_type(&mut c, st, view(assoc_name));
        }
        return st;
    }
    if eat(&mut c, view("::")) {
        n := ident(&mut c);
        a := find_alias(&mut c, view(first), view(n));
        if a != 0 {
            aty := c.aliases[a - 1].ty;
            // An alias that names u64 has type id 0, so only NO_TYPE is unresolved here. Reading 0
            // as "no type" refused `module::Word` for `type Word = u64;`; this is the hazard.
            if aty == NO_TYPE {
