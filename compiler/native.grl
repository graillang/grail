        // view, for C parameters and record fields typed `const void *` / `void *`. Unsafe:
        // C may keep or (for cptr_mut) write through the pointer, which Grail cannot track.
        expect(&mut c, view(")"));
        if (c.raw == 0) & (c.unsafe_depth == 0) {
            fail(&mut c, view("cptr and cptr_mut require an unsafe block"));
        }
        writable := id == 41;
        operand := a.t;
        x := deref(&mut c, a);
        k := ty_kind(&mut c, x.ty);
        if k == 8 {
            return cptr_record(&mut c, operand, x, writable);
        }
        if (k != 2) & (k != 3) & (k != 4) & (k != 5) {
            fail(&mut c, view("cptr requires a byte sequence or view"));
        }
        if writable {
            // Only a mutable byte view or a mutable sequence may be written through.
            if (k == 5) & (ty_mode(&mut c, x.ty) == 0) {
                fail(&mut c, view("cptr_mut requires a mutable byte view (&mut [u8])"));
            }
            if k != 5 {
                require_write(&mut c, x.t);
            }
        }
        slot := apply(&mut c, view("rt_view_ptr"), one(x.t));
        ty := intern_full(&mut c, 26, 0, writable, u64[]);
        pointer_borrow(&mut c, slot, ty, operand, x.t, writable);
