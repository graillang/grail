        nv := expr(&mut c, 0);
        nx := deref(&mut c, nv);
        if !integer(&mut c, nx.ty) {
            fail(&mut c, view("cslice takes an element count"));
        }
        expect(&mut c, view(")"));
        e := carray_elem_of(&mut c, elem);
