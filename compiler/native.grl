        if framed(&mut c, expected) {
            slot = enum_frame(&mut c, tag, payload, expected, 1);
        } else {
            slot = invoke(&mut c, view("rt_enum"), two(tag, payload));
        }
        own(&mut c, slot, expected);
        return val(slot, expected);
