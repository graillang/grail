// An expression whose value nobody keeps (`expr;`, or a single-expression match arm): release
// whatever temporary it produced, dropping an owned one it evaluates to.
fn discard_value<a>(c: (&a mut C), v: Val) -> unit {
    mut r = resource(&mut c, v.t);
    if r != 0 {
        info := &c.resources[r - 1];
        base := info.base;
        kind := ty_kind(&mut c, v.ty);
        if base != 0 {
            if affine(&mut c, v.ty) {
                moved := move_value(&mut c, v);
                owner := resource(&mut c, moved.t);
                release(&mut c, owner - 1);
            } else {
                release(&mut c, r - 1);
            }
        } else {
            release(&mut c, r - 1);
        }
    }
    return ();
}
