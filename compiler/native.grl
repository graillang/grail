                    o(&mut c, view("cmpq $"));
                    on(&mut c, i);
                    o(&mut c, view(",(%rax)\n"));
                    jump(&mut c, view("jne"), next);
                    o(&mut c, view("movq $"));
                    on(&mut c, mapping[i]);
                    o(&mut c, view(",(%rax)\n"));
                    jump(&mut c, view("jmp"), done);
                    mark(&mut c, next);
