// tokens. The loop lowering below binds members of a call result this way.
fn record_member<a, b>(c: (&a mut C), base: Val, name: &b [u8]) -> Val {
    if ty_kind(&mut c, base.ty) != 8 {
        fail(&mut c, view("map iteration needs a pair view"));
        return val(0, 0);
    }
    d := ty_arg(&mut c, base.ty);
    k := find_field(&mut c, d, view(name));
    fty := field_type(&mut c, base.ty, k);
    n := rec_load(&mut c, base.t, k, 0);
    alias_field(&mut c, n, fty, base.t, k, 0);
    observe(&mut c, n);
    return val(n, fty);
}
// `for k, v in &m { .. }` and `for k, v in &mut m { .. }`: a map's layout is private to hashmap, so
// the compiler counts positions and asks the map for the pair at each one, which is what
// `map_len`/`key_at`/`value_at` exist for. The exclusive form asks for one `entry_at` view per
// position instead: its shared key and exclusive value are the two bindings, the same split as
// `Entry`. A single reference is held for the whole loop (in a hidden binding), so the body cannot
// grow the map, and only the exclusive form can write to a value.
fn map_loop<a, b, d>(c: (&a mut C), name: &b [u8], value_name: &d [u8]) -> unit {
