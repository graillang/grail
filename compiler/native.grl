module native;
use lexer;
use host;
use ownership;
use machine;

// Direct Linux native compiler: one checked word stream, target instruction selection in machine.grl.
// Usage: native OUT.s ENTRY.grl [MODULE.grl...]. The first public function of the
// first file is the entry; it takes nothing or argv[1] as a byte view. Move/initialization
// checks, loans/lifetimes, captured-storage writeback and deterministic drops are active.
// Generic types/functions use typed specialization. Include runtime.grl as source.
// Type ids: 0 num, 1 unit, 2 bytes, 3 string, 4 view; others are interned below.
// Type kinds: 1 num, 2 unit, 3 bytes, 4 string, 5 view, 6 vec(arg), 7 ref(arg),
// 8 named(decl, args), 9 opaque template parameter, 10 opaque bound parameter (arg, identity),
// 11 atomic<num>, 12 capture-free typed function pointer.

struct Tok { kind:num, start:num, end:num }
struct Ty { kind:num, arg:num, mode:num, regions:vec<num>, args:vec<num> }
struct Decl { module:bytes, name:bytes, is_enum:num, first:num, count:num, regions:num, types:num, bounds:vec<num>, constraints:vec<vec<num>> }
struct Field { name:bytes, ty:num }
struct Func { module:bytes, name:bytes, first:num, count:num, ret:num, types:num, regions:num, file:num, pos:num, raw:num, bounds:vec<num>, constraints:vec<vec<num>>, contract:num }
struct Interface { module:bytes, name:bytes, defined:num, methods:vec<num> }
struct Implementation { contract:num, ty:num, module:bytes, methods:vec<num> }
struct Spec { template:num, args:vec<num>, first:num, ret:num }
struct Local { name:bytes, ty:num, id:num, last:num, born:num, mutable:num }
struct Val { t:num, ty:num }
struct Resource { slot:num, ty:num, flag:num, base:num, field:num, via:num, place:num, target:num, authority:num }
struct Bond { holder:num, loan:num, guard:num }
struct Origin { place:num, region:num }
struct Member { base:num, field:num, place:num }
struct C {
    src:bytes, toks:vec<Tok>, pos:num, out:vec<num>, module:bytes, target:num, arg_offset:num, overflow:num,
    specs:vec<Spec>, bindings:vec<num>, current_spec:num, validating:num, alias_next:num, types:vec<Ty>, decls:vec<Decl>, fields:vec<Field>, funcs:vec<Func>, params:vec<num>,
    locals:vec<Local>, next:num, entry:num, file:num, label:num, brk:num, cont:num, raw:num, rnames:vec<bytes>, tnames:vec<bytes>, type_bounds:vec<num>, type_interfaces:vec<vec<num>>, interfaces:vec<Interface>, implementations:vec<Implementation>, self_type:num, current_impl:num, headers_complete:num, resources:vec<Resource>, loopmark:num, result:num, check:ownership::State, members:vec<Member>, terminated:num, loopcheck:ownership::State, breaks:ownership::State, hasbreak:num, bonds:vec<Bond>, origins:vec<Origin>, scope_end:num, loop_start:num, loop_end:num
}

fn same<a,b>(x:read<a>,y:read<b>)->num {
    if x.len()!=y.len() { return 0; }
    for i in x.len() { if x[i]!=y[i] { return 0; } }
    return 1;
}
fn div(n:num,d:num)->num {
    mut q=0;
    mut r=n;
    while (r<d)==0 {
        mut m=d;
        mut k=1;
        while ((r<m+m)==0)&((m+m<m)==0) { m=m+m; k=k+k; }
        r=r-m;
        q=q+k;
    }
    return q;
}

// ---- output ----
fn o<a,b>(c:ref_mut<a,C>,s:read<b>)->unit {
    for i in s.len() { c.out.push(s[i]); }
    return ();
}
fn on<a>(c:ref_mut<a,C>,n:num)->unit {
    if 9<n { on(borrow_mut(c),div(n,10)); }
    c.out.push(48+n%10);
    return ();
}

fn fresh<a>(c:ref_mut<a,C>)->num {
    id :=c.next;
    exchange(borrow_mut(c.next),id+1);
    return id;
}

fn val(t:num,ty:num)->Val { return Val{t:t,ty:ty}; }

// Every intermediate and binding has an rbp-relative eight-byte stack slot.
fn stack_slot<a>(c:ref_mut<a,C>,id:num)->unit {
    c.out.push(45); on(borrow_mut(c),(id+1)*8); o(borrow_mut(c),&"(%rbp)"); return ();
}
fn save<a>(c:ref_mut<a,C>)->num {
    n :=fresh(borrow_mut(c)); o(borrow_mut(c),&"movq %rax,");
    stack_slot(borrow_mut(c),n); c.out.push(10); return n;
}
fn get<a,b>(c:ref_mut<a,C>,id:num,reg:read<b>)->unit {
    o(borrow_mut(c),&"movq "); stack_slot(borrow_mut(c),id); c.out.push(44);
    o(borrow_mut(c),reg); c.out.push(10); return ();
}
fn label<a>(c:ref_mut<a,C>)->num {
    n :=c.label; exchange(borrow_mut(c.label),n+1); return n;
}
fn lname<a>(c:ref_mut<a,C>,n:num)->unit { o(borrow_mut(c),&".L"); on(borrow_mut(c),n); return (); }
fn mark<a>(c:ref_mut<a,C>,n:num)->unit { lname(borrow_mut(c),n); o(borrow_mut(c),&":\n"); return (); }
fn jump<a,b>(c:ref_mut<a,C>,op:read<b>,n:num)->unit {
    o(borrow_mut(c),op); c.out.push(32); lname(borrow_mut(c),n); c.out.push(10); return ();
}

fn argreg(i:num)->string {
 if i==0{return "%rdi";} if i==1{return "%rsi";} if i==2{return "%rdx";}
 if i==3{return "%rcx";} if i==4{return "%r8";} return "%r9";
}
fn imm<a>(c:ref_mut<a,C>,n:num)->num {
 o(borrow_mut(c),&"movabsq $");on(borrow_mut(c),n);o(borrow_mut(c),&",%rax\n");return save(borrow_mut(c));
}
fn invoke<a,b>(c:ref_mut<a,C>,name:read<b>,args:vec<num>)->num {
 if 6<args.len(){fail(borrow_mut(c),&"native call exceeds six arguments");}
 for i in args.len(){mut r =argreg(i);get(borrow_mut(c),args[i],&r);}
 o(borrow_mut(c),&"call ");o(borrow_mut(c),name);c.out.push(10);return save(borrow_mut(c));
}

// Owned values have independent stack flags. Aliased field loads are not owners until moved.
fn needs_drop<a>(c:ref_mut<a,C>,ty:num)->num {
 k :=ty_kind(borrow_mut(c),ty);return (k==3)+(k==4)+(k==5)+(k==6)+(k==8)+(k==9)+(k==10)+(k==11);
}
fn resource<a>(c:ref_mut<a,C>,slot:num)->num {
 mut i=c.resources.len();while i {i=i-1;mut r =&c.resources[i];if r.slot==slot{return i+1;}}return 0;
}
fn own<a>(c:ref_mut<a,C>,slot:num,ty:num)->Val {
 if c.raw==0 {k :=ty_kind(borrow_mut(c),ty);drops :=needs_drop(borrow_mut(c),ty);if drops+(k==7){
 mut flag=0;if drops{flag=imm(borrow_mut(c),1)+1;}place :=ownership::root(borrow_mut(c.check),0,1);
 c.resources.push(Resource{slot:slot,ty:ty,flag:flag,base:0,field:0,via:0,place:place,target:0,authority:0});}}
 return val(slot,ty);
}
// A bond says that a live value retains a loan. Moves append bonds to the new holder;
// historical bonds remain for flow restoration, but dead holders do not keep loans alive.
fn bond_kind<a>(c:ref_mut<a,C>,holder:num,loan:num,guard:num)->unit {
 if (holder==0)+(loan==0){return ();}
 for i in c.bonds.len(){mut b =&c.bonds[i];if (b.holder==holder)&(b.loan==loan)&(b.guard==guard){return ();}}
 c.bonds.push(Bond{holder:holder,loan:loan,guard:guard});return ();
}
fn bond<a>(c:ref_mut<a,C>,holder:num,loan:num)->unit {bond_kind(borrow_mut(c),holder,loan,0);return ();}
fn loan_live<a>(c:ref_mut<a,C>,loan:num)->num{mut l =&c.check.loans[loan-1];return l.live;}
fn transfer_bonds<a>(c:ref_mut<a,C>,src:num,dst:num)->unit {
 if (src==0)+(dst==0){return ();}n :=c.bonds.len();
 for i in n{mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if loan_live(borrow_mut(c),loan){if ownership::ancestor(borrow(c.check),src,holder){bond_kind(borrow_mut(c),dst,loan,guard);}}}
 return ();
}
fn return_bonds<a>(c:ref_mut<a,C>,src:num,dst:num,aggregate:num)->unit {
 if (src==0)+(dst==0){return ();}n :=c.bonds.len();
 for i in n{mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if loan_live(borrow_mut(c),loan){if ownership::ancestor(borrow(c.check),src,holder){mut role=guard;if aggregate{role=1;}if guard==3{role=3;}if aggregate==3{role=3;}bond_kind(borrow_mut(c),dst,loan,role);}}}
 return ();
}
fn close_loans<a>(c:ref_mut<a,C>)->unit {
 mut changed=1;
 while changed{
 changed=0;mut i=c.check.loans.len();
 while i{
 i=i-1;mut l =&c.check.loans[i];live :=l.live;
 if live{mut held=0;
 for j in c.bonds.len(){mut b =&c.bonds[j];loan :=b.loan;holder :=b.holder;
 if loan==i+1{state :=ownership::status(borrow(c.check),holder);if (state==1)+(state==3){held=1;break;}}}
 if held==0{if ownership::end_loan(borrow_mut(c.check),i+1)==0{changed=1;}}}
 }
 for j in c.origins.len(){o :=&c.origins[j];root :=o.place;region :=o.region;
 if region==18446744073709551615{if ownership::status(borrow(c.check),root)==1{
 mut reached=0;
 for k in c.check.loans.len(){mut l =&c.check.loans[k];live :=l.live;source :=l.source;
 if live{if ownership::ancestor(borrow(c.check),root,source){reached=1;break;}}}
 if reached==0{ownership::cleanup(borrow_mut(c.check),root);changed=1;}
 }}}
 }
 return ();
}
fn member_place<a>(c:ref_mut<a,C>,root:num,field:num,ty:num)->num {
 if root==0{return 0;}
 for i in c.members.len(){m :=&c.members[i];if (m.base==root)&(m.field==field){return m.place;}}
 kind :=ty_kind(borrow_mut(c),ty);copy :=(needs_drop(borrow_mut(c),ty)==0)&(kind!=7);
 place :=ownership::field(borrow_mut(c.check),root,copy);
 c.members.push(Member{base:root,field:field,place:place});return place;
}
fn target_of<a>(c:ref_mut<a,C>,slot:num)->num {
 n :=resource(borrow_mut(c),slot);if n==0{return 0;}mut r =&c.resources[n-1];return r.target;
}
fn authority_of<a>(c:ref_mut<a,C>,slot:num)->num {
 n :=resource(borrow_mut(c),slot);if n==0{return 0;}mut r =&c.resources[n-1];return r.authority;
}
fn authority_loan<a>(c:ref_mut<a,C>,slot:num,target:num)->num {
 holder :=place_of(borrow_mut(c),slot-1);
 for i in c.bonds.len(){mut b =&c.bonds[i];h :=b.holder;loan :=b.loan;
 if (holder==h)&(b.guard==0){mut l =&c.check.loans[loan-1];live :=l.live;source :=l.source;
 if live{if ownership::ancestor(borrow(c.check),source,target){return loan;}}}}
 return 0;
}
fn set_target<a>(c:ref_mut<a,C>,slot:num,target:num,authority:num)->unit {
 n :=resource(borrow_mut(c),slot);if n!=0{
 mut r =&mut c.resources[n-1];exchange(borrow_mut(r.target),target);exchange(borrow_mut(r.authority),authority);}
 return ();
}
fn add_region<a>(rs:ref_mut<a,vec<num>>,r:num)->unit {
 for i in rs.len(){if rs[i]==r{return ();}}rs.push(r);return ();
}
// Lifetime parameters inside the declared type (not concrete borrow targets).
fn type_caps<a>(c:ref_mut<a,C>,ty:num,depth:num)->vec<num> {
 if 64<depth{fail(borrow_mut(c),&"capture type nesting limit");}
 mut rs =type_regions(borrow_mut(c),ty);k :=ty_kind(borrow_mut(c),ty);arg :=ty_arg(borrow_mut(c),ty);
 if (k==6)+(k==7)+(k==10){inner :=type_caps(borrow_mut(c),arg,depth+1);
 for i in inner.len(){mut r =inner[i];add_region(borrow_mut(rs),r);}}
 if k==8{d :=&c.decls[arg];count :=d.count;
 for i in count{f :=field_type(borrow_mut(c),ty,i);inner :=type_caps(borrow_mut(c),f,depth+1);
 for j in inner.len(){mut r =inner[j];add_region(borrow_mut(rs),r);}}}
 return rs;
}
fn intersects<a,b>(a:ref<a,vec<num>>,b:ref<b,vec<num>>)->num {
 for i in a.len(){mut r =a[i];for j in b.len(){if b[j]==r{return 1;}}}return 0;
}
fn normalize_readonly<a>(c:ref_mut<a,C>,slot:num,ty:num)->unit {
 k :=ty_kind(borrow_mut(c),ty);if (k!=5)&(k!=7){return ();}if ty_mode(borrow_mut(c),ty){return ();}
 root :=place_of(borrow_mut(c),slot);n :=c.bonds.len();
 for i in n{mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if (holder==root)&(guard==0){mut l =&c.check.loans[loan-1];mode :=l.mode;live :=l.live;
 if live{
 if mode{child :=ownership::reborrow(borrow_mut(c.check),loan,0);if child==0{fail(borrow_mut(c),&"readonly result cannot borrow suspended authority");}
 mut b =&mut c.bonds[i];exchange(borrow_mut(b.guard),1);bond(borrow_mut(c),root,child);}}}}
 return ();
}
fn call_bonds<a>(c:ref_mut<a,C>,result:Val,first:num,args:ref<a,vec<num>>,capture_type:num)->unit {
 if c.raw{return ();}captures :=type_caps(borrow_mut(c),capture_type,0);holder :=place_of(borrow_mut(c),result.t);resultkind :=ty_kind(borrow_mut(c),result.ty);aggregate :=resultkind!=5;
 for i in args.len(){
 slot :=args[i];source :=place_of(borrow_mut(c),slot);ty :=c.params[first+i];kind :=ty_kind(borrow_mut(c),ty);
 mut rs=type_caps(borrow_mut(c),ty,0);if kind==7{rs=type_regions(borrow_mut(c),ty);}
 if intersects(borrow(rs),borrow(captures)){
 mut role=aggregate;if (kind==7)&(resultkind==7){role=3;}return_bonds(borrow_mut(c),source,holder,role);}
 if kind==7{
 inner :=ty_arg(borrow_mut(c),ty);data :=type_caps(borrow_mut(c),inner,0);
 if intersects(borrow(data),borrow(captures)){storage :=target_of(borrow_mut(c),slot);return_bonds(borrow_mut(c),storage,holder,aggregate);}}
 }
 if ty_kind(borrow_mut(c),result.ty)==7{stored_source(borrow_mut(c),result.t,result.ty);if target_of(borrow_mut(c),result.t)==0{fail(borrow_mut(c),&"reference result has no declared frame source");}}
 k :=ty_kind(borrow_mut(c),result.ty);if (k==5)+(k==7){stored_source(borrow_mut(c),result.t,result.ty);if has_bonds(borrow_mut(c),holder)==0{fail(borrow_mut(c),&"borrowed result has no declared input source");}}
 normalize_readonly(borrow_mut(c),result.t,result.ty);close_loans(borrow_mut(c));return ();
}
// Weak updates retain historical guards across branch restoration. External storage
// accepts only origins explicitly present in its invariant data-lifetime contract.
fn check_writeback<a>(c:ref_mut<a,C>,destination:num,ty:num,source:num)->unit{
 if c.raw{return ();}if contains_borrow(borrow_mut(c),ty,0)==0{return ();}
 region :=region_of(borrow_mut(c),destination);if region==0{return ();}
 if region==18446744073709551615{
 mut found=0;for i in c.bonds.len(){mut b =&c.bonds[i];holder :=b.holder;guard :=b.guard;loan :=b.loan;
 if (guard==3)&ownership::ancestor(borrow(c.check),destination,holder){if loan_live(borrow_mut(c),loan){mut l =&c.check.loans[loan-1];source :=l.source;mut r =region_of(borrow_mut(c),source);
 if r!=18446744073709551615{if r!=0{fail(borrow_mut(c),&"opaque external captured storage has no concrete invariant contract");}found=1;}}}}
 if found==0{fail(borrow_mut(c),&"opaque captured storage lacks a checked local frame");}return ();
 }
 allowed :=type_caps(borrow_mut(c),ty,0);
 for i in c.bonds.len(){mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;
 if ownership::ancestor(borrow(c.check),source,holder){if loan_live(borrow_mut(c),loan){mut l =&c.check.loans[loan-1];origin :=l.source;mut r =region_of(borrow_mut(c),origin);
 if r!=18446744073709551615{mut found=0;for j in allowed.len(){if allowed[j]==r{found=1;}}
 if (r==0)+(found==0){fail(borrow_mut(c),&"captured writeback violates invariant lifetime");}}}}}
 return ();
}
fn seed_storage<a>(c:ref_mut<a,C>,storage:num,ty:num)->unit{
 region :=region_of(borrow_mut(c),storage);if (region==0)+(region==18446744073709551615){return ();}
 for i in c.bonds.len(){mut b =&c.bonds[i];holder :=b.holder;if ownership::ancestor(borrow(c.check),storage,holder){return ();}}
 k :=ty_kind(borrow_mut(c),ty);if (k==5)+(k==7){slot :=imm(borrow_mut(c),0);
 c.resources.push(Resource{slot:slot,ty:ty,flag:0,base:1,field:0,via:1,place:storage,target:0,authority:0});stored_source(borrow_mut(c),slot,ty);return ();}
 caps :=type_caps(borrow_mut(c),ty,0);for i in caps.len(){mut r =caps[i];source :=external_place(borrow_mut(c),r,0);loan :=ownership::borrow_place(borrow_mut(c.check),source,0);bond_kind(borrow_mut(c),storage,loan,1);}return ();
}
fn frame_storage<a>(c:ref_mut<a,C>,slot:num,destination:num)->unit{
 root :=place_of(borrow_mut(c),slot);n :=c.bonds.len();for i in n{mut b =&c.bonds[i];holder :=b.holder;guard :=b.guard;loan :=b.loan;
 if (holder==root)&guard{if loan_live(borrow_mut(c),loan){bond_kind(borrow_mut(c),destination,loan,guard);}}}return ();
}
fn storage_bonds<a>(c:ref_mut<a,C>,source:num,destination:num)->unit{
 mut owners =vec<num>[];n :=c.bonds.len();
 if region_of(borrow_mut(c),destination)==18446744073709551615{
 for i in n{mut b =&c.bonds[i];holder :=b.holder;guard :=b.guard;loan :=b.loan;
 if (guard==3)&ownership::ancestor(borrow(c.check),destination,holder){if loan_live(borrow_mut(c),loan){mut l =&c.check.loans[loan-1];owner :=l.source;if region_of(borrow_mut(c),owner)==0{owners.push(owner);}}}}}
 for i in n{mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if ownership::ancestor(borrow(c.check),source,holder){if ((source==destination)&(guard==3))==0{if loan_live(borrow_mut(c),loan){mut role=guard;if role==3{role=1;}bond_kind(borrow_mut(c),destination,loan,role);
 for j in owners.len(){owner :=owners[j];bond_kind(borrow_mut(c),owner,loan,1);}}}}}
 return ();
}
fn writeback_source<a>(c:ref_mut<a,C>,destination:num,ty:num,source:num)->unit{
 check_writeback(borrow_mut(c),destination,ty,source);storage_bonds(borrow_mut(c),source,destination);return ();
}
fn call_writebacks<a,b,d>(c:ref_mut<a,C>,first:num,args:ref<b,vec<num>>,actuals:ref<d,vec<num>>)->unit{
 if c.raw{return ();}
 for i in args.len(){formal :=c.params[first+i];k :=ty_kind(borrow_mut(c),formal);mode :=ty_mode(borrow_mut(c),formal);
 if (k==7)&mode{inner :=ty_arg(borrow_mut(c),formal);if contains_borrow(borrow_mut(c),inner,0){
 mut rs =type_caps(borrow_mut(c),inner,0);slot :=args[i];destination :=target_of(borrow_mut(c),slot);actual :=actuals[i];storage :=ty_arg(borrow_mut(c),actual);frame_storage(borrow_mut(c),slot,destination);seed_storage(borrow_mut(c),destination,storage);
 for j in args.len(){ty :=c.params[first+j];kind :=ty_kind(borrow_mut(c),ty);argument :=args[j];
 mut caps=type_caps(borrow_mut(c),ty,0);if kind==7{caps=type_regions(borrow_mut(c),ty);}
 if intersects(borrow(rs),borrow(caps)){source :=place_of(borrow_mut(c),argument);writeback_source(borrow_mut(c),destination,storage,source);}
 if kind==7{inner :=ty_arg(borrow_mut(c),ty);data :=type_caps(borrow_mut(c),inner,0);
 if intersects(borrow(rs),borrow(data)){mut source=target_of(borrow_mut(c),argument);actual :=actuals[j];inner :=ty_arg(borrow_mut(c),actual);seed_storage(borrow_mut(c),source,inner);
 if (region_of(borrow_mut(c),source)==18446744073709551615)&(source!=destination){source=place_of(borrow_mut(c),argument);}writeback_source(borrow_mut(c),destination,storage,source);}}
 }
 }}}
 return ();
}
fn block_end<a>(c:ref_mut<a,C>,start:num)->num {
 mut i=start;mut depth=0;
 while i<c.toks.len(){k :=kind_at(borrow_mut(c),i);if k==123{depth=depth+1;}if k==125{depth=depth-1;if depth==0{return i;}}i=i+1;}
 fail(borrow_mut(c),&"unclosed block");return start;
}
fn last_name<a,b>(c:ref_mut<a,C>,name:read<b>,from:num,to:num)->num {
 mut last=0;if from{last=from-1;}mut i=from;mut depth=0;mut base=0;mut pending=0;mut hidden=0;mut skip=0;
 if from<c.toks.len(){if kind_at(borrow_mut(c),from)==123{base=1;}}
 while i<to{
 t :=&c.toks[i];kind :=t.kind;st :=t.start;en :=t.end;
 if kind==123{depth=depth+1;}
 // A scan can start inside an enclosing group; its closing brace ends this scope.
 if kind==125{if depth==0{break;}if hidden==depth+1{hidden=0;}depth=depth-1;}
 if (kind==1)&(hidden==0)&(pending==0){
 token :=tok_text(borrow_mut(c),i);
 if same(&token,&"mut"){
 mut declaration=1;if i!=0{if kind_at(borrow_mut(c),i-1)==38{declaration=0;}}
 if declaration{declared :=tok_text(borrow_mut(c),i+1);if same(&declared,&name){pending=depth+1;skip=i+1;}}}
 if kind_at(borrow_mut(c),i+1)==261{if same(&token,&name){pending=depth+1;skip=i;}}
 }
 mut use=1;if i!=0{prev :=kind_at(borrow_mut(c),i-1);if (prev==46)+(prev==260){use=0;}}
 mut next =kind_at(borrow_mut(c),i+1);if (next==58)+(next==40)+(next==260)+(next==261){use=0;}
 if (kind==1)&(en-st==name.len())&(i!=skip)&(hidden==0)&use{mut matched=1;mut j=0;
 while j<en-st{if c.src[st+j]!=name[j]{matched=0;break;}j=j+1;}
 if matched{last=i;}}
 if (pending!=0)&(kind==59)&(depth+1==pending){if depth==base{break;}hidden=pending;pending=0;}
 i=i+1;
 }
 return last;
}
fn is_local_slot<a>(c:ref_mut<a,C>,slot:num)->num {
 for i in c.locals.len(){mut l =&c.locals[i];if l.id==slot{return 1;}}return 0;
}
fn release_temporary<a>(c:ref_mut<a,C>,slot:num)->unit {
 if c.raw{return ();}if is_local_slot(borrow_mut(c),slot){return ();}
 mut r =resource(borrow_mut(c),slot);if r==0{return ();}info :=&c.resources[r-1];place :=info.place;base :=info.base;
 if (base==0)&(place!=0){if ownership::can_cleanup(borrow(c.check),place){release(borrow_mut(c),r-1);}}return ();
}
fn expire_locals<a>(c:ref_mut<a,C>)->unit {
 if c.raw{return ();}for i in c.locals.len(){
 mut l =&c.locals[i];slot :=l.id;ty :=l.ty;last :=l.last;born :=l.born;
 k :=ty_kind(borrow_mut(c),ty);mut carrier=(k==5)+(k==7);root :=place_of(borrow_mut(c),slot);
 if (k==6)+(k==8){for j in c.bonds.len(){mut b =&c.bonds[j];holder :=b.holder;if ownership::ancestor(borrow(c.check),root,holder){carrier=1;break;}}}
 if carrier{if last<c.pos{
 mut defer=0;if c.loop_end{if (born<c.loop_start)&(last<c.loop_end){defer=1;}}
 if defer==0{mut r =resource(borrow_mut(c),slot);if r!=0{info :=&c.resources[r-1];place :=info.place;
 if place!=0{if ownership::can_cleanup(borrow(c.check),place){if (k==6)+(k==8){ownership::cleanup(borrow_mut(c.check),place);close_loans(borrow_mut(c));}else{release(borrow_mut(c),r-1);}}}}}
 }}
 }return ();
}
// Bindings authorize writes to owned storage; explicit mutable capabilities authorize
// writes through their referents, without making the capability binding reassignable.
fn binding_mode<a>(c:ref<a,C>,slot:num)->num{
 for i in c.locals.len(){entry :=&c.locals[i];id :=entry.id;mutable :=entry.mutable;if id==slot{return mutable+1;}}return 0;
}
fn require_mutable_binding<a>(c:ref_mut<a,C>,slot:num,storage:num)->unit{
 if c.raw{return ();}mut current=slot;mut depth=0;
 while depth<c.resources.len()+1{
 index :=resource(borrow_mut(c),current);
 if index!=0{mut r =&c.resources[index-1];ty :=r.ty;place :=r.place;authority :=r.authority;base :=r.base;
 k :=ty_kind(borrow_mut(c),ty);mode :=ty_mode(borrow_mut(c),ty);
 if (k==7)&(place!=0){if mode{return ();}fail(borrow_mut(c),&"mutation through readonly reference");}
 if (k==5)&(storage==0){if mode{return ();}fail(borrow_mut(c),&"mutation through readonly view");}
 if authority!=0{a :=resource(borrow_mut(c),authority-1);if a!=0{info :=&c.resources[a-1];at :=info.ty;if ty_kind(borrow_mut(c),at)==7{if ty_mode(borrow_mut(c),at){return ();}fail(borrow_mut(c),&"mutation through readonly frame");}}}
 binding :=binding_mode(borrow(c),current);if binding==1{fail(borrow_mut(c),&"owned storage mutation requires mut");}if binding==2{return ();}
 if base==0{return ();}current=base-1;
 }else{binding :=binding_mode(borrow(c),current);if binding==1{fail(borrow_mut(c),&"owned storage mutation requires mut");}return ();}depth=depth+1;
 }
 fail(borrow_mut(c),&"invalid mutation provenance");return ();
}
fn require_write<a>(c:ref_mut<a,C>,slot:num)->unit {
 require_mutable_binding(borrow_mut(c),slot,0);
 if c.raw{return ();}index :=resource(borrow_mut(c),slot);if index==0{fail(borrow_mut(c),&"mutation target is not tracked");}
 mut r =&c.resources[index-1];ty :=r.ty;place :=r.place;authority :=r.authority;target :=r.target;
 k :=ty_kind(borrow_mut(c),ty);
 if (k==7)&(place==0){
 if authority!=0{mut r =resource(borrow_mut(c),authority-1);info :=&c.resources[r-1];ty :=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),&"write through readonly frame");}
 loan :=authority_loan(borrow_mut(c),authority,target);if loan==0{fail(borrow_mut(c),&"field write has no authority");}if ownership::access_loan(borrow(c.check),loan,target,1)!=0{fail(borrow_mut(c),&"field write conflicts with active loan");}}
 else{if ownership::initialize(borrow_mut(c.check),target)!=0{fail(borrow_mut(c),&"field assignment conflicts with live borrow or moved storage");}}return ();}
 if (k==5)+(k==7){if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),&"mutation through readonly reference");}mut allowed=0;
 for i in c.bonds.len(){mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if (guard==0)&ownership::ancestor(borrow(c.check),holder,place){if loan_live(borrow_mut(c),loan){allowed=1;if ownership::use_loan(borrow(c.check),loan,1)!=0{fail(borrow_mut(c),&"write authority is suspended");}}}}if allowed==0{fail(borrow_mut(c),&"write lacks checked source");}
 }else{
 if authority!=0{mut r =resource(borrow_mut(c),authority-1);info :=&c.resources[r-1];ty :=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),&"mutation through readonly frame");}
 loan :=authority_loan(borrow_mut(c),authority,place);if loan==0{fail(borrow_mut(c),&"write has no reference authority");}
 if ownership::access_loan(borrow(c.check),loan,place,1)!=0{fail(borrow_mut(c),&"write conflicts with active loan");}
 }else{loan :=ownership::borrow_place(borrow_mut(c.check),place,1);if loan==0{fail(borrow_mut(c),&"mutation conflicts with live borrow");}ownership::end_loan(borrow_mut(c.check),loan);}}
 return ();
}
fn region_of<a>(c:ref_mut<a,C>,place:num)->num {
 for i in c.origins.len(){o :=&c.origins[i];root :=o.place;region :=o.region;
 if ownership::ancestor(borrow(c.check),root,place){return region;}}
 return 0;
}
fn external_place<a>(c:ref_mut<a,C>,region:num,copy:num)->num {
 p :=ownership::root(borrow_mut(c.check),copy,1);c.origins.push(Origin{place:p,region:region});return p;
}
fn add_external_capture<a>(c:ref_mut<a,C>,holder:num,region:num,mode:num)->num {
 source :=external_place(borrow_mut(c),region,0);loan :=ownership::borrow_place(borrow_mut(c.check),source,mode);
 bond(borrow_mut(c),holder,loan);return source;
}
fn init_parameter<a>(c:ref_mut<a,C>,slot:num,ty:num)->unit {
 if c.raw{return ();}holder :=place_of(borrow_mut(c),slot);k :=ty_kind(borrow_mut(c),ty);
 mut rs =type_regions(borrow_mut(c),ty);mode :=ty_mode(borrow_mut(c),ty);
 if (k==5)+(k==7){
 if rs.len()!=1{fail(borrow_mut(c),&"parameter requires a declared lifetime");}
 mut r =rs[0];source :=add_external_capture(borrow_mut(c),holder,r,mode);
 if k==7{set_target(borrow_mut(c),slot,source,slot+1);}return ();}
 captures :=type_caps(borrow_mut(c),ty,0);
 for i in captures.len(){mut r =captures[i];target :=external_place(borrow_mut(c),r,0);loan :=ownership::borrow_place(borrow_mut(c.check),target,0);bond_kind(borrow_mut(c),holder,loan,1);}return ();
}
fn has_bonds<a>(c:ref_mut<a,C>,holder:num)->num {
 for i in c.bonds.len(){mut b =&c.bonds[i];h :=b.holder;guard :=b.guard;loan :=b.loan;if (h==holder)&(guard==0){if loan_live(borrow_mut(c),loan){return 1;}}}return 0;
}
// Stored captures in an abstract input referent have their declared data lifetime,
// distinct from the lifetime of the outer reference frame.
fn stored_source<a>(c:ref_mut<a,C>,slot:num,ty:num)->unit {
 place :=place_of(borrow_mut(c),slot);if place==0{return ();}
 k :=ty_kind(borrow_mut(c),ty);if (k!=5)&(k!=7){return ();}
 if has_bonds(borrow_mut(c),place){if k==7{
 for i in c.bonds.len(){mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if (holder==place)&(guard==0){if loan_live(borrow_mut(c),loan){mut l =&c.check.loans[loan-1];source :=l.source;authority :=authority_of(borrow_mut(c),slot);set_target(borrow_mut(c),slot,source,authority);break;}}}}return ();}
 mut guarded=0;n :=c.bonds.len();
 for i in n{mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if guard{if loan_live(borrow_mut(c),loan){if ownership::ancestor(borrow(c.check),holder,place){bond_kind(borrow_mut(c),place,loan,guard);guarded=1;}}}}
 if guarded{
 mode :=ty_mode(borrow_mut(c),ty);source :=external_place(borrow_mut(c),18446744073709551615,0);loan :=ownership::borrow_place(borrow_mut(c.check),source,mode);bond(borrow_mut(c),place,loan);
 if k==7{mut authority=authority_of(borrow_mut(c),slot);mut r =resource(borrow_mut(c),slot);info :=&c.resources[r-1];if info.base==0{authority=slot+1;}set_target(borrow_mut(c),slot,source,authority);}return ();}
 if region_of(borrow_mut(c),place)==0{return ();}
 mut rs =type_regions(borrow_mut(c),ty);if rs.len()!=1{fail(borrow_mut(c),&"stored capture lifetime missing");}
 mut r =rs[0];mode :=ty_mode(borrow_mut(c),ty);target :=add_external_capture(borrow_mut(c),place,r,mode);
 if k==7{authority :=authority_of(borrow_mut(c),slot);set_target(borrow_mut(c),slot,target,authority);}return ();
}
fn bind_loan<a>(c:ref_mut<a,C>,value:num,source:num,target:num,mode:num)->unit {
 if c.raw{return ();}if target==0{fail(borrow_mut(c),&"borrow target is not tracked");}
 mut authority=authority_of(borrow_mut(c),source);source_id :=resource(borrow_mut(c),source);if source_id!=0{mut r =&c.resources[source_id-1];ty :=r.ty;if ty_kind(borrow_mut(c),ty)==7{authority=source+1;}}mut loan=0;
 if authority!=0{
 if mode{mut r =resource(borrow_mut(c),authority-1);info :=&c.resources[r-1];ty :=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),&"mutable borrow through readonly frame");}}
 parent :=authority_loan(borrow_mut(c),authority,target);if parent==0{fail(borrow_mut(c),&"reference has no access authority");}
 loan=ownership::reborrow_place(borrow_mut(c.check),parent,target,mode);
 owner :=place_of(borrow_mut(c),authority-1);holder :=place_of(borrow_mut(c),value);n :=c.bonds.len();
 for i in n{mut b =&c.bonds[i];old :=b.loan;h :=b.holder;guard :=b.guard;if (h==owner)&(guard!=0){bond_kind(borrow_mut(c),holder,old,1);}
 if (h==owner)&(old!=parent)&(guard==0){if loan_live(borrow_mut(c),old){
 extra :=ownership::reborrow(borrow_mut(c.check),old,mode);if extra==0{fail(borrow_mut(c),&"ambiguous reborrow lacks authority");}bond(borrow_mut(c),holder,extra);}}}
 }else{loan=ownership::borrow_place(borrow_mut(c.check),target,mode);}
 if loan==0{fail(borrow_mut(c),&"borrow conflicts with active access");}
 holder :=place_of(borrow_mut(c),value);bond(borrow_mut(c),holder,loan);return ();
}
fn borrow_reference<a>(c:ref_mut<a,C>,slot:num,ty:num,source:num,target:num,mode:num)->Val {
 own(borrow_mut(c),slot,ty);bind_loan(borrow_mut(c),slot,source,target,mode);set_target(borrow_mut(c),slot,target,slot+1);return val(slot,ty);
}
fn view_bonds<a>(c:ref_mut<a,C>,slot:num,source:num,mode:num)->unit {
 if c.raw{return ();}root :=place_of(borrow_mut(c),source);holder :=place_of(borrow_mut(c),slot);
 if root==0{fail(borrow_mut(c),&"view source is not tracked");}
 source_index :=resource(borrow_mut(c),source);mut r =&c.resources[source_index-1];ty :=r.ty;
 if ty_kind(borrow_mut(c),ty)==5{
 if mode{index :=resource(borrow_mut(c),source);mut r =&c.resources[index-1];base :=r.base;authority :=r.authority;
 if base!=0{if authority!=0{mut r =resource(borrow_mut(c),authority-1);info :=&c.resources[r-1];ty :=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),&"unique field reborrow through readonly frame");}
 parent :=authority_loan(borrow_mut(c),authority,root);if ownership::access_loan(borrow(c.check),parent,root,1)!=0{fail(borrow_mut(c),&"unique field reborrow requires mutable frame");}}
 else{if ownership::can_cleanup(borrow(c.check),root)==0{fail(borrow_mut(c),&"field frame is shared");}}}}
 mut found=0;n :=c.bonds.len();
 for i in n{mut b =&c.bonds[i];h :=b.holder;parent :=b.loan;guard :=b.guard;
 if loan_live(borrow_mut(c),parent){if ownership::ancestor(borrow(c.check),h,root){if guard{bond_kind(borrow_mut(c),holder,parent,1);}else{loan :=ownership::reborrow(borrow_mut(c.check),parent,mode);if loan==0{fail(borrow_mut(c),&"view reborrow lacks authority");}bond(borrow_mut(c),holder,loan);found=1;}}}}
 if found==0{fail(borrow_mut(c),&"view has no lifetime source");}
 }else{bind_loan(borrow_mut(c),slot,source,root,mode);}return ();
}
fn validate_return<a>(c:ref_mut<a,C>,v:Val)->unit {
 if c.raw{return ();}if contains_borrow(borrow_mut(c),v.ty,0)==0{return ();}place :=place_of(borrow_mut(c),v.t);if place==0{return ();}
 result :=c.result;mut rs =type_caps(borrow_mut(c),result,0);mut found=0;
 for i in c.bonds.len(){mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;
 if ownership::ancestor(borrow(c.check),place,holder){if loan_live(borrow_mut(c),loan){
 mut l =&c.check.loans[loan-1];source :=l.source;region :=region_of(borrow_mut(c),source);mut allowed=0;
 for j in rs.len(){if rs[j]==region{allowed=1;}}
 if region!=18446744073709551615{if (region==0)+(allowed==0){fail(borrow_mut(c),&"returned borrow escapes its declared input lifetime");}}found=1;}}}
 k :=ty_kind(borrow_mut(c),v.ty);if (k==5)+(k==7){if found==0{fail(borrow_mut(c),&"returned reference has no checked source");}}return ();
}
fn place_of<a>(c:ref_mut<a,C>,slot:num)->num {
 mut r =resource(borrow_mut(c),slot);if r==0{return 0;}mut r =&c.resources[r-1];return r.place;
}
fn observe<a>(c:ref_mut<a,C>,slot:num)->unit {
 if c.raw{return ();}place :=place_of(borrow_mut(c),slot);if place==0{return ();}
 authority :=authority_of(borrow_mut(c),slot);index :=resource(borrow_mut(c),slot);info :=&c.resources[index-1];base :=info.base;ty :=info.ty;
 if (authority!=0)&(base!=0){
 loan :=authority_loan(borrow_mut(c),authority,place);
 if loan==0{fail(borrow_mut(c),&"access has no live reference authority");}
 if ownership::access_loan(borrow(c.check),loan,place,0)!=0{fail(borrow_mut(c),&"reference access conflicts with active borrow");}
 }else{if ownership::read(borrow(c.check),place)!=0{fail(borrow_mut(c),&"use of moved, borrowed or partially initialized value");}}
 k :=ty_kind(borrow_mut(c),ty);if (k==5)+(k==7){mut checked=0;
 for i in c.bonds.len(){mut b =&c.bonds[i];h :=b.holder;loan :=b.loan;guard :=b.guard;
 if (guard==0)&ownership::ancestor(borrow(c.check),h,place){if loan_live(borrow_mut(c),loan){checked=1;if ownership::use_loan(borrow(c.check),loan,0)!=0{fail(borrow_mut(c),&"reference is suspended or expired");}}}}if checked==0{fail(borrow_mut(c),&"reference lacks checked source");}}
 return ();
}
fn inherit_guards<a>(c:ref_mut<a,C>,place:num)->unit {
 if place==0{return ();}n :=c.bonds.len();
 for i in n{mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;
 if holder!=place{if ownership::ancestor(borrow(c.check),holder,place){bond_kind(borrow_mut(c),place,loan,1);}}}return ();
}
fn capture_authority<a>(c:ref_mut<a,C>,place:num)->unit {
 if place==0{return ();}
 for i in c.bonds.len(){mut b =&c.bonds[i];holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if guard==0{if loan_live(borrow_mut(c),loan){if ownership::ancestor(borrow(c.check),place,holder){
 if ownership::use_loan(borrow(c.check),loan,0)!=0{fail(borrow_mut(c),&"captured authority is suspended");}}}}}
 return ();
}
fn alias_field<a>(c:ref_mut<a,C>,slot:num,ty:num,base:num,field:num,via:num)->Val {
 if c.raw==0{
 root :=place_of(borrow_mut(c),base);place :=member_place(borrow_mut(c),root,field,ty);authority :=authority_of(borrow_mut(c),base);
 c.resources.push(Resource{slot:slot,ty:ty,flag:0,base:base+1,field:field,via:via,place:place,target:0,authority:authority});if contains_borrow(borrow_mut(c),ty,0){inherit_guards(borrow_mut(c),place);}stored_source(borrow_mut(c),slot,ty);
 }
 return val(slot,ty);
}
fn drop_name<a>(c:ref_mut<a,C>,ty:num)->unit {o(borrow_mut(c),&".D");on(borrow_mut(c),ty);return ();}
fn release<a>(c:ref_mut<a,C>,index:num)->unit {
 mut r =&c.resources[index];flag :=r.flag;slot :=r.slot;ty :=r.ty;place :=r.place;base :=r.base;
 if flag==0{if base==0{if place!=0{if ownership::cleanup(borrow_mut(c.check),place)!=0{fail(borrow_mut(c),&"storage ends while borrowed");}close_loans(borrow_mut(c));}}return ();}
 if place!=0{if ownership::cleanup(borrow_mut(c.check),place)!=0{fail(borrow_mut(c),&"cleanup conflicts with live loan");}}
 done :=label(borrow_mut(c));
 o(borrow_mut(c),&"cmpq $0,");stack_slot(borrow_mut(c),flag-1);c.out.push(10);jump(borrow_mut(c),&"je",done);
 o(borrow_mut(c),&"movq $0,");stack_slot(borrow_mut(c),flag-1);c.out.push(10);
 get(borrow_mut(c),slot,&"%rdi");o(borrow_mut(c),&"call ");drop_name(borrow_mut(c),ty);c.out.push(10);mark(borrow_mut(c),done);close_loans(borrow_mut(c));return ();
}
fn cleanup<a>(c:ref_mut<a,C>,mark:num)->unit {
 if c.raw{return ();}mut i=c.resources.len();while mark<i{i=i-1;release(borrow_mut(c),i);}return ();
}
fn move_out<a>(c:ref_mut<a,C>,v:Val)->unit {
 if c.raw{return ();}if needs_drop(borrow_mut(c),v.ty)==0{if ty_kind(borrow_mut(c),v.ty)!=7{return ();}}
 index :=resource(borrow_mut(c),v.t);if index==0{fail(borrow_mut(c),&"owned value lacks ownership record");}
 mut r =&c.resources[index-1];flag :=r.flag;base :=r.base;field :=r.field;via :=r.via;place :=r.place;
 if place!=0{capture_authority(borrow_mut(c),place);if ownership::take(borrow_mut(c.check),place)!=0{fail(borrow_mut(c),&"move of unavailable or borrowed value");}}
 if flag!=0{o(borrow_mut(c),&"movq $0,");stack_slot(borrow_mut(c),flag-1);c.out.push(10);}else{
 if base!=0{if via{fail(borrow_mut(c),&"cannot move owned field through reference");}
 zero :=imm(borrow_mut(c),0);rec_store(borrow_mut(c),base-1,field,zero);}}
 return ();
}
fn move_value<a>(c:ref_mut<a,C>,v:Val)->Val {
 get(borrow_mut(c),v.t,&"%rax");slot :=save(borrow_mut(c));old :=place_of(borrow_mut(c),v.t);target :=target_of(borrow_mut(c),v.t);move_out(borrow_mut(c),val(v.t,v.ty));
 own(borrow_mut(c),slot,v.ty);dst :=place_of(borrow_mut(c),slot);kind :=ty_kind(borrow_mut(c),v.ty);if contains_borrow(borrow_mut(c),v.ty,0){return_bonds(borrow_mut(c),old,dst,(kind==6)+(kind==8));}if ty_kind(borrow_mut(c),v.ty)==7{set_target(borrow_mut(c),slot,target,slot+1);}return val(slot,v.ty);
}
// ---- tokens ----
fn kind<a>(c:ref_mut<a,C>)->num {
    p :=c.pos;
    t :=&c.toks[p];
    return t.kind;
}
fn next_kind<a>(c:ref_mut<a,C>)->num{p :=c.pos+1;return kind_at(borrow_mut(c),p);}
fn kind_at<a>(c:ref_mut<a,C>,i:num)->num {
    t :=&c.toks[i];
    return t.kind;
}
fn advance<a>(c:ref_mut<a,C>)->unit {
    p :=c.pos+1;
    exchange(borrow_mut(c.pos),p);
    return ();
}
fn tok_text<a>(c:ref_mut<a,C>,i:num)->bytes {
    t :=&c.toks[i];
    st :=t.start;
    en :=t.end;
    return (c.src[st:en]).copy();
}
fn is<a,b>(c:ref_mut<a,C>,s:read<b>)->num {
    p :=c.pos;
    t :=tok_text(borrow_mut(c),p);
    return same(&t,s);
}
fn fail<a,b>(c:ref_mut<a,C>,msg:read<b>)->unit {
    p :=c.pos;
    m :=tok_text(borrow_mut(c),p);
    t :=&c.toks[p];
    st :=t.start;
    exchange(borrow_mut(c.out),vec<num>[]);
    o(borrow_mut(c),&"native: ");
    o(borrow_mut(c),msg);
    o(borrow_mut(c),&" at byte ");
    on(borrow_mut(c),st);
    o(borrow_mut(c),&" near '");
    o(borrow_mut(c),&m);
    o(borrow_mut(c),&"'\n");
    mut line =bytes[];
    for i in c.out.len() { line.push(c.out[i]); }
    host::print(&line);
    assert(0);
    return ();
}
fn eat<a,b>(c:ref_mut<a,C>,s:read<b>)->num {
    if is(borrow_mut(c),s) { advance(borrow_mut(c)); return 1; }
    return 0;
}
fn expect<a,b>(c:ref_mut<a,C>,s:read<b>)->unit {
    want :=s.copy();
    if eat(borrow_mut(c),s)==0 {
        mut msg ="expected ";
        msg.append(&want);
        fail(borrow_mut(c),&msg);
    }
    return ();
}
fn ident<a>(c:ref_mut<a,C>)->bytes {
    if kind(borrow_mut(c))!=1 { fail(borrow_mut(c),&"expected identifier"); }
    p :=c.pos;
    t :=tok_text(borrow_mut(c),p);
    if same(&t,&"true")+same(&t,&"false"){fail(borrow_mut(c),&"truth keyword is not an identifier");}
    advance(borrow_mut(c));
    return t;
}
// Skips a balanced {...} group starting at the current '{'.
fn skip_braces<a>(c:ref_mut<a,C>)->unit {
    mut depth=0;
    while 1 {
        k :=kind(borrow_mut(c));
        if k==123 { depth=depth+1; }
        if k==125 { depth=depth-1; }
        if k==0 { fail(borrow_mut(c),&"unclosed {"); }
        advance(borrow_mut(c));
        if depth==0 { return (); }
    }
    return ();
}
fn load_file<a>(c:ref_mut<a,C>,index:num)->unit {
    offset :=c.arg_offset;path :=host::arg(index+offset);
    src :=host::read_file(&path);
    mut toks =vec<Tok>[];
    lexed :=lexer::tokenize(&src);
    for i in lexed.len() {
        t :=&lexed[i];
        toks.push(Tok{kind:t.kind,start:t.start,end:t.end});
    }
    drop(lexed);
    exchange(borrow_mut(c.toks),toks);
    exchange(borrow_mut(c.src),src);
    exchange(borrow_mut(c.pos),0);
    return ();
}

// ---- types and declarations ----
fn numbers_equal<a,b>(a:ref<a,vec<num>>,b:ref<b,vec<num>>)->num {
 if a.len()!=b.len(){return 0;}for i in a.len(){if a[i]!=b[i]{return 0;}}return 1;
}
fn intern_args<a>(c:ref_mut<a,C>,k:num,arg:num,mode:num,regions:vec<num>,args:vec<num>)->num {
 for i in c.types.len(){t :=&c.types[i];
 if (t.kind==k)&(t.arg==arg)&(t.mode==mode){if numbers_equal(borrow(t.regions),borrow(regions)){if numbers_equal(borrow(t.args),borrow(args)){return i;}}}}
 c.types.push(Ty{kind:k,arg:arg,mode:mode,regions:regions,args:args});return c.types.len()-1;
}
fn intern_full<a>(c:ref_mut<a,C>,k:num,arg:num,mode:num,regions:vec<num>)->num {
 return intern_args(borrow_mut(c),k,arg,mode,regions,vec<num>[]);
}
fn type_args<a>(c:ref_mut<a,C>,ty:num)->vec<num>{
 mut args =vec<num>[];t :=&c.types[ty];for i in t.args.len(){args.push(t.args[i]);}return args;
}
fn intern<a>(c:ref_mut<a,C>,k:num,arg:num)->num {return intern_full(borrow_mut(c),k,arg,0,vec<num>[]);}
fn copy_numbers<a>(input:ref<a,vec<num>>)->vec<num>{mut out=vec<num>[];for i in input.len(){out.push(input[i]);}return out;}
fn transfer_capability<a,b>(c:ref_mut<a,C>,ty:num,shared:num,trail:ref_mut<b,vec<num>>,depth:num)->num {
 if 64<depth{return false;}k :=ty_kind(borrow_mut(c),ty);arg :=ty_arg(borrow_mut(c),ty);
 if (k==1)+(k==2)+(k==3)+(k==4)+(k==11)+(k==12){return true;}
 if k==5{if shared{return ty_mode(borrow_mut(c),ty)==0;}return true;}
 if k==9{proof :=ty_mode(borrow_mut(c),ty);mut bit=1;if shared{bit=2;}return (proof&bit)!=0;}
 if k==10{return transfer_capability(borrow_mut(c),arg,shared,borrow_mut(trail),depth+1);}
 key :=ty*2+shared;for i in trail.len(){if trail[i]==key{return true;}}trail.push(key);
 mut allowed=0;
 if k==6{allowed=transfer_capability(borrow_mut(c),arg,shared,borrow_mut(trail),depth+1);}
 if k==7{mode :=ty_mode(borrow_mut(c),ty);if mode{if shared==0{allowed=transfer_capability(borrow_mut(c),arg,0,borrow_mut(trail),depth+1);}}else{allowed=transfer_capability(borrow_mut(c),arg,1,borrow_mut(trail),depth+1);}}
 if k==8{d :=&c.decls[arg];count :=d.count;allowed=1;
 for i in count{field :=field_type(borrow_mut(c),ty,i);if transfer_capability(borrow_mut(c),field,shared,borrow_mut(trail),depth+1)==0{allowed=0;break;}}}
 trail.pop();return allowed;
}
fn require_constraints<a,b,d>(c:ref_mut<a,C>,arguments:ref<b,vec<num>>,bounds:ref<d,vec<num>>)->unit {
 if arguments.len()!=bounds.len(){fail(borrow_mut(c),&"generic constraint arity");}
 for i in bounds.len(){mask :=bounds[i];ty :=arguments[i];
 if mask&1{mut trail=vec<num>[];if transfer_capability(borrow_mut(c),ty,0,borrow_mut(trail),0)==0{fail(borrow_mut(c),&"type does not satisfy Send");}}
 if mask&2{mut trail=vec<num>[];if transfer_capability(borrow_mut(c),ty,1,borrow_mut(trail),0)==0{fail(borrow_mut(c),&"type does not satisfy Share");}}
 }return ();
}
// Forward declarations are optimistically incomplete while collecting headers. Recheck
// every instantiated nominal type after all layouts are known, before generating bodies.
fn validate_type_constraints<a>(c:ref_mut<a,C>)->unit {
 mut i=0;while i<c.types.len(){
 if ty_kind(borrow_mut(c),i)==8{decl :=ty_arg(borrow_mut(c),i);arguments :=type_args(borrow_mut(c),i);bounds :=declaration_bounds(borrow(c),decl);require_constraints(borrow_mut(c),borrow(arguments),borrow(bounds));requirements :=declaration_constraints(borrow(c),decl);require_interfaces(borrow_mut(c),borrow(arguments),borrow(requirements));}i+=1;
 }return ();
}
fn function_bounds<a>(c:ref<a,C>,index:num)->vec<num>{f :=&c.funcs[index];return copy_numbers(borrow(f.bounds));}
fn declaration_bounds<a>(c:ref<a,C>,index:num)->vec<num>{d :=&c.decls[index];return copy_numbers(borrow(d.bounds));}
fn copy_constraints<a>(input:ref<a,vec<vec<num>>>)->vec<vec<num>>{mut out=vec<vec<num>>[];for i in input.len(){out.push(copy_numbers(&input[i]));}return out;}
fn function_constraints<a>(c:ref<a,C>,index:num)->vec<vec<num>>{f :=&c.funcs[index];return copy_constraints(borrow(f.constraints));}
fn declaration_constraints<a>(c:ref<a,C>,index:num)->vec<vec<num>>{d :=&c.decls[index];return copy_constraints(borrow(d.constraints));}
fn find_interface<a,b,d>(c:ref<a,C>,module:read<b>,name:read<d>)->num{
 for i in c.interfaces.len(){item :=&c.interfaces[i];if same(&item.module,&module)&same(&item.name,&name){return i+1;}}return 0;
}
fn ensure_interface<a>(c:ref_mut<a,C>,module:bytes,name:bytes)->num{
 existing :=find_interface(borrow(c),&module,&name);if existing{return existing;}
 c.interfaces.push(Interface{module:module,name:name,defined:0,methods:vec<num>[]});return c.interfaces.len();
}
fn base_type<a>(c:ref_mut<a,C>,ty:num)->num{mut out=ty;while ty_kind(borrow_mut(c),out)==10{out=ty_arg(borrow_mut(c),out);}return out;}
fn find_implementation<a>(c:ref_mut<a,C>,contract:num,ty:num)->num{
 actual :=base_type(borrow_mut(c),ty);for i in c.implementations.len(){item :=&c.implementations[i];id :=item.contract;other :=item.ty;
 if id==contract{if same_type(borrow_mut(c),actual,other){return i+1;}}}return 0;
}
fn satisfies_interface<a>(c:ref_mut<a,C>,ty:num,contract:num)->num{
 actual :=base_type(borrow_mut(c),ty);if ty_kind(borrow_mut(c),actual)==9{proofs :=type_args(borrow_mut(c),actual);for i in proofs.len(){p :=proofs[i];if ty_kind(borrow_mut(c),p)==15{if ty_arg(borrow_mut(c),p)==contract{return true;}}}return false;}
 if c.headers_complete==0{return true;}return find_implementation(borrow_mut(c),contract,actual)!=0;
}
fn require_interfaces<a,b,d>(c:ref_mut<a,C>,arguments:ref<b,vec<num>>,sets:ref<d,vec<vec<num>>>)->unit{
 if arguments.len()!=sets.len(){fail(borrow_mut(c),&"interface constraint arity");}
 for i in sets.len(){ty :=arguments[i];set :=&sets[i];for j in set.len(){id :=set[j];if satisfies_interface(borrow_mut(c),ty,id)==0{fail(borrow_mut(c),&"type does not satisfy interface bound");}}}return ();
}
fn private_module<a>(prefix:read<a>,id:num)->bytes{mut out=prefix.copy();decimal(borrow_mut(out),id);return out;}
fn region_id<a>(c:ref_mut<a,C>)->num {
 n :=ident(borrow_mut(c));
 for i in c.rnames.len(){mut r =&c.rnames[i];if same(&r,&n){return i+1;}}
 fail(borrow_mut(c),&"undeclared lifetime");return 0;
}
fn lifetime_parameters<a>(c:ref_mut<a,C>)->unit {
 exchange(borrow_mut(c.rnames),vec<bytes>[]);exchange(borrow_mut(c.tnames),vec<bytes>[]);exchange(borrow_mut(c.type_bounds),vec<num>[]);exchange(borrow_mut(c.type_interfaces),vec<vec<num>>[]);
 if eat(borrow_mut(c),&"<"){while 1{
 n :=ident(borrow_mut(c));is_type :=(64<n[0])&(n[0]<91);
 if is_type{
 for i in c.tnames.len(){t :=&c.tnames[i];if same(&t,&n){fail(borrow_mut(c),&"duplicate type parameter");}}
 mut bounds=0;mut requirements=vec<num>[];
 if eat(borrow_mut(c),&":"){while true{constraint :=ident(borrow_mut(c));mut bit=0;
 if same(&constraint,&"Send")&(is(borrow_mut(c),&"::")==0){bit=1;}if same(&constraint,&"Share")&(is(borrow_mut(c),&"::")==0){bit=2;}
 if bit==0{mut m=module_copy(borrow_mut(c));mut n=constraint.copy();if eat(borrow_mut(c),&"::"){m=constraint.copy();n=ident(borrow_mut(c));}id :=ensure_interface(borrow_mut(c),m,n);for i in requirements.len(){if requirements[i]==id{fail(borrow_mut(c),&"duplicate interface constraint");}}requirements.push(id);}
 else{if bounds&bit{fail(borrow_mut(c),&"duplicate structural constraint");}bounds+=bit;}
 if eat(borrow_mut(c),&"+")==0{break;}}}
 c.tnames.push(n);c.type_bounds.push(bounds);c.type_interfaces.push(requirements);
 }else{
 if c.tnames.len()!=0{fail(borrow_mut(c),&"lifetimes must precede type parameters");}
 for i in c.rnames.len(){mut r =&c.rnames[i];if same(&r,&n){fail(borrow_mut(c),&"duplicate lifetime");}}
 c.rnames.push(n);
 }
 if eat(borrow_mut(c),&">"){break;}expect(borrow_mut(c),&",");}}
 return ();
}
fn lifetime_arguments<a>(c:ref_mut<a,C>)->vec<num> {
 mut rs =vec<num>[];if eat(borrow_mut(c),&"<"){while 1{
 mut r =region_id(borrow_mut(c));rs.push(r);
 if eat(borrow_mut(c),&">"){break;}expect(borrow_mut(c),&",");}}
 return rs;
}
fn nominal_type<a>(c:ref_mut<a,C>,d:num)->num {
 decl :=&c.decls[d];count :=decl.regions;types :=decl.types;
 mut rs =vec<num>[];mut args =vec<num>[];
 if count+types{
 expect(borrow_mut(c),&"<");
 for i in count+types{if i!=0{expect(borrow_mut(c),&",");}
 if i<count{mut r =region_id(borrow_mut(c));rs.push(r);}else{t :=parse_type(borrow_mut(c));args.push(t);}}
 expect(borrow_mut(c),&">");
 }
 bounds :=declaration_bounds(borrow(c),d);require_constraints(borrow_mut(c),borrow(args),borrow(bounds));requirements :=declaration_constraints(borrow(c),d);require_interfaces(borrow_mut(c),borrow(args),borrow(requirements));
 return intern_args(borrow_mut(c),8,d,0,rs,args);
}
fn ty_kind<a>(c:ref_mut<a,C>,ty:num)->num {
    t :=&c.types[ty];
    return t.kind;
}
fn ty_arg<a>(c:ref_mut<a,C>,ty:num)->num {
    t :=&c.types[ty];
    return t.arg;
}
fn ty_mode<a>(c:ref_mut<a,C>,ty:num)->num {t :=&c.types[ty];return t.mode;}
fn type_regions<a>(c:ref_mut<a,C>,ty:num)->vec<num>{
 mut rs =vec<num>[];t :=&c.types[ty];
 for i in t.regions.len(){rs.push(t.regions[i]);}return rs;
}
fn substitute<a,b>(c:ref_mut<a,C>,ty:num,map:ref<b,vec<num>>)->num {
 k :=ty_kind(borrow_mut(c),ty);mode :=ty_mode(borrow_mut(c),ty);mut arg=ty_arg(borrow_mut(c),ty);
 mut rs =type_regions(borrow_mut(c),ty);
 if (k==6)+(k==7)+(k==12){arg=substitute(borrow_mut(c),arg,borrow(map));}
 for i in rs.len(){mut r =rs[i];if r!=0{
 if map.len()<r{fail(borrow_mut(c),&"unbound stored lifetime");}
 n :=map[r-1];exchange(&mut rs[i],n);}}
 mut args =type_args(borrow_mut(c),ty);
 for i in args.len(){t :=args[i];mut v =substitute(borrow_mut(c),t,borrow(map));exchange(&mut args[i],v);}
 return intern_args(borrow_mut(c),k,arg,mode,rs,args);
}
fn bind_types<a,b>(c:ref_mut<a,C>,ty:num,map:ref<b,vec<num>>)->num {
 k :=ty_kind(borrow_mut(c),ty);mode :=ty_mode(borrow_mut(c),ty);mut arg=ty_arg(borrow_mut(c),ty);
 if k==9{if map.len()<arg+1{fail(borrow_mut(c),&"unbound type parameter");}return map[arg];}
 if (k==6)+(k==7)+(k==12){arg=bind_types(borrow_mut(c),arg,borrow(map));}
 mut args =type_args(borrow_mut(c),ty);for i in args.len(){t :=args[i];mut v =bind_types(borrow_mut(c),t,borrow(map));exchange(&mut args[i],v);}
 mut rs =type_regions(borrow_mut(c),ty);return intern_args(borrow_mut(c),k,arg,mode,rs,args);
}
fn field_type<a>(c:ref_mut<a,C>,ty:num,index:num)->num {
 d :=ty_arg(borrow_mut(c),ty);t :=field_ty(borrow_mut(c),d,index);mut rs =type_regions(borrow_mut(c),ty);mut args =type_args(borrow_mut(c),ty);
 field :=bind_types(borrow_mut(c),t,borrow(args));if rs.len()==0{return field;}return substitute(borrow_mut(c),field,borrow(rs));
}
fn concrete_type<a>(c:ref_mut<a,C>,ty:num)->num {
 k :=ty_kind(borrow_mut(c),ty);if k==9{return 0;}arg :=ty_arg(borrow_mut(c),ty);
 if (k==6)+(k==7)+(k==10)+(k==12){if concrete_type(borrow_mut(c),arg)==0{return 0;}}
 mut args =type_args(borrow_mut(c),ty);for i in args.len(){a :=args[i];if concrete_type(borrow_mut(c),a)==0{return 0;}}
 return 1;
}
fn reference_type<a>(c:ref_mut<a,C>,ty:num,mode:num)->num{return intern_full(borrow_mut(c),7,ty,mode,vec<num>[]);}
// Shape checking does not discharge lifetime obligations; the loan pass handles those separately.
fn callable_contract<a,b>(c:ref_mut<a,C>,actual:num,expected:num,map:ref_mut<b,vec<num>>,depth:num)->num {
 if 64<depth{return false;}ak :=ty_kind(borrow_mut(c),actual);ek :=ty_kind(borrow_mut(c),expected);if ak!=ek{return false;}
 aa :=ty_arg(borrow_mut(c),actual);ea :=ty_arg(borrow_mut(c),expected);
 if (ak==5)+(ak==7)+(ak==10){am :=ty_mode(borrow_mut(c),actual);em :=ty_mode(borrow_mut(c),expected);if am!=em{return false;}}
 if (ak==8)+(ak==9)+(ak==10){if aa!=ea{return false;}}
 ar :=type_regions(borrow_mut(c),actual);er :=type_regions(borrow_mut(c),expected);if ar.len()!=er.len(){return false;}
 for i in ar.len(){from :=ar[i];to :=er[i];mut seen=0;for j in map.len()/2{if map[j*2]==from{if map[j*2+1]!=to{return false;}seen=1;break;}}if seen==0{map.push(from);map.push(to);}}
 if (ak==6)+(ak==7)+(ak==12){if callable_contract(borrow_mut(c),aa,ea,borrow_mut(map),depth+1)==0{return false;}}
 ax :=type_args(borrow_mut(c),actual);ex :=type_args(borrow_mut(c),expected);if ax.len()!=ex.len(){return false;}
 for i in ax.len(){left :=ax[i];right :=ex[i];if callable_contract(borrow_mut(c),left,right,borrow_mut(map),depth+1)==0{return false;}}
 return true;
}
fn same_type<a>(c:ref_mut<a,C>,x:num,y:num)->num {
 a :=ty_kind(borrow_mut(c),x);mut b =ty_kind(borrow_mut(c),y);if a!=b{return 0;}
 if a==12{mut map=vec<num>[];return callable_contract(borrow_mut(c),x,y,borrow_mut(map),0);}
 aa :=ty_arg(borrow_mut(c),x);bb :=ty_arg(borrow_mut(c),y);
 if (a==5)+(a==7){am :=ty_mode(borrow_mut(c),x);bm :=ty_mode(borrow_mut(c),y);if am!=bm{return 0;}}
 if (a==6)+(a==7){return same_type(borrow_mut(c),aa,bb);}
 if a==8{if aa!=bb{return 0;}ax :=type_args(borrow_mut(c),x);bx :=type_args(borrow_mut(c),y);if ax.len()!=bx.len(){return 0;}
 for i in ax.len(){x :=ax[i];y :=bx[i];if same_type(borrow_mut(c),x,y)==0{return 0;}}}
 if a==9{return aa==bb;}if a==10{am :=ty_mode(borrow_mut(c),x);bm :=ty_mode(borrow_mut(c),y);return (aa==bb)&(am==bm);}return 1;
}
fn contains_borrow<a>(c:ref_mut<a,C>,ty:num,depth:num)->num {
 if 64<depth{fail(borrow_mut(c),&"recursive capture layout unsupported");}
 k :=ty_kind(borrow_mut(c),ty);arg :=ty_arg(borrow_mut(c),ty);
 if (k==5)+(k==7){return 1;}if k==10{return contains_borrow(borrow_mut(c),arg,depth+1);}if k==6{return contains_borrow(borrow_mut(c),arg,depth+1);}
 if k==8{d :=&c.decls[arg];count :=d.count;
 for i in count{t :=field_type(borrow_mut(c),ty,i);if contains_borrow(borrow_mut(c),t,depth+1){return 1;}}}return 0;
}
fn require_type<a>(c:ref_mut<a,C>,actual:num,expected:num)->unit {
 if same_type(borrow_mut(c),actual,expected)==0{fail(borrow_mut(c),&"type mismatch");}return ();
}
// Declaration index + 1, or 0.
fn find_decl<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->num {
    for i in c.decls.len() {
        x :=&c.decls[i];
        if same(&x.module,&m)&same(&x.name,&n) { return i+1; }
    }
    return 0;
}
fn find_func<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->num {
    for i in c.funcs.len() {
        x :=&c.funcs[i];
        if same(&x.module,&m)&same(&x.name,&n) { return i+1; }
    }
    return 0;
}
// Field index within decl, failing when absent.
fn find_field<a,b>(c:ref_mut<a,C>,decl:num,n:read<b>)->num {
    d :=&c.decls[decl];
    first :=d.first;
    count :=d.count;
    for i in count {
        f :=&c.fields[first+i];
        if same(&f.name,&n) { return i; }
    }
    fail(borrow_mut(c),&"unknown field or variant");
    return 0;
}
fn field_ty<a>(c:ref_mut<a,C>,decl:num,index:num)->num {
    d :=&c.decls[decl];
    k :=d.first+index;
    f :=&c.fields[k];
    return f.ty;
}
fn module_copy<a>(c:ref_mut<a,C>)->bytes { return c.module.copy(); }
fn parse_type<a>(c:ref_mut<a,C>)->num {
 first :=ident(borrow_mut(c));
 for i in c.tnames.len(){t :=&c.tnames[i];if same(&t,&first){if c.bindings.len(){return c.bindings[i];}bounds :=c.type_bounds[i];mut proofs=vec<num>[];set :=copy_numbers(&c.type_interfaces[i]);for j in set.len(){id :=set[j];proof :=intern(borrow_mut(c),15,id);proofs.push(proof);}return intern_args(borrow_mut(c),9,i,bounds,vec<num>[],proofs);}}
 if same(&first,&"Self")&((c.self_type!=0)){return c.self_type-1;}
 if eat(borrow_mut(c),&"::"){
 n :=ident(borrow_mut(c));d :=find_decl(borrow_mut(c),&first,&n);
 if d==0{fail(borrow_mut(c),&"unknown type");}return nominal_type(borrow_mut(c),d-1);}
 if same(&first,&"fn"){
 expect(borrow_mut(c),&"(");mut params=vec<num>[];
 if eat(borrow_mut(c),&")")==0{while true{ty :=parse_type(borrow_mut(c));params.push(ty);if eat(borrow_mut(c),&")"){break;}expect(borrow_mut(c),&",");}}
 if 6<params.len(){fail(borrow_mut(c),&"function type exceeds six word arguments");}
 expect(borrow_mut(c),&"->");result :=parse_type(borrow_mut(c));return intern_args(borrow_mut(c),12,result,0,vec<num>[],params);}
 if same(&first,&"num"){return 0;}if same(&first,&"unit"){return 1;}
 if same(&first,&"bytes"){return 2;}if same(&first,&"string"){return 3;}
 if same(&first,&"read")+same(&first,&"mut"){
 mut rs =lifetime_arguments(borrow_mut(c));if rs.len()!=1{fail(borrow_mut(c),&"view lifetime arity");}
 mode :=same(&first,&"mut");return intern_full(borrow_mut(c),5,0,mode,rs);}
 if same(&first,&"atomic"){
 expect(borrow_mut(c),&"<");e :=parse_type(borrow_mut(c));expect(borrow_mut(c),&">");
 if e!=0{fail(borrow_mut(c),&"atomic currently requires num (one aligned 64-bit word)");}return intern(borrow_mut(c),11,0);}
 if same(&first,&"vec"){
 expect(borrow_mut(c),&"<");e :=parse_type(borrow_mut(c));expect(borrow_mut(c),&">");return intern(borrow_mut(c),6,e);}
 if same(&first,&"ref")+same(&first,&"ref_mut"){
 expect(borrow_mut(c),&"<");mut r =region_id(borrow_mut(c));expect(borrow_mut(c),&",");
 e :=parse_type(borrow_mut(c));expect(borrow_mut(c),&">");mut rs =vec<num>[];rs.push(r);
 mode :=same(&first,&"ref_mut");return intern_full(borrow_mut(c),7,e,mode,rs);}
 m :=module_copy(borrow_mut(c));d :=find_decl(borrow_mut(c),&m,&first);
 if d==0{fail(borrow_mut(c),&"unknown type");}return nominal_type(borrow_mut(c),d-1);
}
// ---- top level: pass 1 names, pass 2 fields/signatures/prototypes, pass 3 bodies ----
fn mangle<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->unit {
    if same(&m,&"runtime") { o(borrow_mut(c),n); return (); }
    o(borrow_mut(c),&"f_"); o(borrow_mut(c),m); c.out.push(95); o(borrow_mut(c),n); return ();
}
fn decl<a>(c:ref_mut<a,C>,pass:num)->unit {
    is_enum :=is(borrow_mut(c),&"enum");
    advance(borrow_mut(c));
    name :=ident(borrow_mut(c));
    lifetime_parameters(borrow_mut(c));
    regions :=c.rnames.len();types :=c.tnames.len();bounds :=copy_numbers(borrow(c.type_bounds));constraints :=copy_constraints(borrow(c.type_interfaces));
    if pass!=2 {
        if pass==1 {
            m :=module_copy(borrow_mut(c));
            c.decls.push(Decl{module:m,name:name,is_enum:is_enum,first:0,count:0,regions:regions,types:types,bounds:bounds,constraints:constraints});
        }
        skip_braces(borrow_mut(c));
        eat(borrow_mut(c),&";");
        return ();
    }
    m :=module_copy(borrow_mut(c));
    d :=find_decl(borrow_mut(c),&m,&name);
    first :=c.fields.len();
    mut count=0;
    expect(borrow_mut(c),&"{");
    if eat(borrow_mut(c),&"}")==0 {
        while 1 {
            f :=ident(borrow_mut(c));
            mut ty=1;
            if is_enum {
                if eat(borrow_mut(c),&"(") {
                    ty=parse_type(borrow_mut(c));
