}
fn is_default_i64<a>(c: (&a mut C), ty: u64) -> bool {
    return (ty_kind(&mut c, ty) == 18)
        && (ty_arg(&mut c, ty) == 64)
        && (ty_mode(&mut c, ty) == 1);
}
fn widen_to_u64<a>(c: (&a mut C), v: Val) -> Val {
    if !is_default_i64(&mut c, v.ty) {
        return v;
