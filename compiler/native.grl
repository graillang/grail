        old := map[arg];
        if old == NO_TYPE {
            exchange(&mut map[arg], actual);
        } else {
            require_type(&mut c, actual, old);
        }
        return ();
    }
    ak := ty_kind(&mut c, actual);
    // A vector reference passed for a typed slice is the slice over the whole vector (coerce_view):
    // the element type is inferred from the vector's.
    if (k == 27) && (ak == 7) {
        inner := ty_arg(&mut c, actual);
        if ty_kind(&mut c, inner) == 6 {
            infer_type(&mut c, arg, ty_arg(&mut c, inner), &mut map);
