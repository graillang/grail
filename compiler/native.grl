// `for i in a..v.len() { .. v[i] .. }`: the body never names v except as v[..] or v.len(), so the
// length cannot change and v[i] is in bounds. Returns v's name, or empty when not provable.
fn len_bound_ahead<a, b>(c: (&a mut C), name: &b [u8]) -> u8[] {
    p := c.pos;
    if c.toks.len() < p + 7 {
        return u8[];
    }
    if (kind_at(&mut c, p) != 1) || (kind_at(&mut c, p + 1) != 46) || (kind_at(&mut c, p + 3) != 40) || (kind_at(&mut c, p + 4) != 41) || (kind_at(&mut c, p + 5) != 123) {
        return u8[];
    }
    method := tok_text(&mut c, p + 2);
    if !same(view(method), view("len")) {
        return u8[];
    }
    base := tok_text(&mut c, p);
    if find_local(&mut c, view(base)) == 0 {
        return u8[];
    }
    end := block_end(&mut c, p + 5);
    mut j = p + 6;
    while j < end {
        k := kind_at(&mut c, j);
        if (k == 124) || (k == 274) {
            return u8[];
        }
        if k == 1 {
            t := tok_text(&mut c, j);
            if same(view(t), view("for")) || same(view(t), view("mut")) {
                nt := tok_text(&mut c, j + 1);
                if same(view(nt), view(name)) || same(view(nt), view(base)) {
                    return u8[];
                }
            }
            if same(view(t), view(name)) {
                if kind_at(&mut c, j + 1) == 261 {
                    return u8[];
                }
            }
            if same(view(t), view(base)) {
                mut ok = 0;
                nk := kind_at(&mut c, j + 1);
                if nk == 91 {
                    ok = 1;
                }
                if (nk == 46) & (j + 5 < c.toks.len()) {
                    if (kind_at(&mut c, j + 3) == 40)
                        & (kind_at(&mut c, j + 4) == 41) {
                        m := tok_text(&mut c, j + 2);
                        if same(view(m), view("len")) {
                            ok = 1;
                        }
                    }
                }
                if j != 0 && ok != 0 {
                    pk := kind_at(&mut c, j - 1);
                    if (pk == 46) || (pk == 38) {
                        ok = 0;
                    }
                }
                if ok == 0 {
                    return u8[];
                }
            }
        }
        j += 1;
    }
    return base.copy();
}
// Whether `[ i ]` at the cursor indexes the proven base with the proven loop variable.
fn proven_index<a>(c: (&a mut C), value: Val) -> bool {
    if c.bce_index.len() == 0 {
        return false;
    }
    p := c.pos;
    if c.toks.len() < p + 3 {
        return false;
    }
    if (kind_at(&mut c, p + 1) != 1) || (kind_at(&mut c, p + 2) != 93) {
        return false;
    }
    t := tok_text(&mut c, p + 1);
    ix := c.bce_index.copy();
    if !same(view(t), view(ix)) {
        return false;
    }
    l := find_local(&mut c, view(c.bce_base.copy()));
    if l == 0 {
        return false;
    }
    return local_id(&mut c, l - 1) == value.t;
}
// Exactly one dereference: map indexing exposes a V place, including when V is itself a reference.
fn map_read_place<a>(c: (&a mut C), reference: Val) -> Val {
    old := reference.t;
    ty := ty_arg(&mut c, reference.ty);
    target := target_of(&mut c, old);
    if target == 0 {
        fail(&mut c, view("map index has no tracked reference target"));
    }
    get(&mut c, old, view("%rax"));
    o(&mut c, view("movq (%rax),%rax\n"));
    slot := save(&mut c);
    c
        .resources
        .push(
            Resource {
                slot: slot,
                ty: ty,
                flag: 0,
                base: old + 1,
                field: 0,
                via: 1,
                place: target,
                target: 0,
                authority: old + 1,
            }
        );
    owner := place_of(&mut c, old);
    n := c.bonds.len();
    for i in n {
        b := &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if holder == owner && guard != 0 {
            bond_kind(&mut c, target, loan, guard);
        }
    }
    stored_source(&mut c, slot, ty);
    return val(slot, ty);
}
fn map_key<a>(c: (&a mut C), keyty: u64) -> Val {
    start := c.pos;
    mut key = expr_expected(&mut c, 0, keyty);
    end := c.pos;
    if ty_kind(&mut c, key.ty) == 7 {
        inner := ty_arg(&mut c, key.ty);
        require_type(&mut c, inner, keyty);
    } else {
        key = adopt_value(&mut c, key, start, end, keyty);
        require_type(&mut c, key.ty, keyty);
    }
    // Scalar expression results have no drop resource until bound. Give this
    // borrowed key argument a tracked copyable place without inventing an owner.
    if place_of(&mut c, key.t) == 0 {
        if !scalar(&mut c, key.ty) {
            fail(&mut c, view("map lookup key has no tracked place"));
        }
        place := ownership::root(&mut c.check, 1, 1);
        c
            .resources
            .push(
                Resource {
                    slot: key.t,
                    ty: key.ty,
                    flag: 0,
                    base: 0,
                    field: 0,
                    via: 0,
                    place: place,
                    target: 0,
                    authority: 0,
                }
            );
    }
    return key;
}
// '[' has already been consumed. Borrow keys; never turn required lookup into insertion.
fn map_index<a>(c: (&a mut C), value: Val, mapty: u64, access: u64) -> Val {
    mode := access == 2;
    formal := reference_type(&mut c, mapty, mode);
    receiver := method_receiver(&mut c, value.t, value.ty, mapty, formal);
    types := type_args(&mut c, mapty);
    keyty := types[0];
    key := map_key(&mut c, keyty);
    expect(&mut c, view("]"));
    keyformal := reference_type(&mut c, keyty, 0);
    keyref := method_receiver(&mut c, key.t, key.ty, keyty, keyformal);
    mut args = Val[];
    args.push(receiver);
    args.push(keyref);
    mut name = "map_get";
    if mode {
        name = "map_get_mut";
    }
    optional := map_call(&mut c, name, mapty, args);
    result := propagate(&mut c, optional, 1);
    release_temporary(&mut c, key.t);
    if access != 0 {
        return result;
    }
    return map_read_place(&mut c, result);
}

// From c.pos: whether the tokens up to the closing `]` form a side-effect-free index (names, integer
// literals, arithmetic, comparisons and grouping parentheses), so evaluating it cannot move,
// mutate or drop the sequence being indexed. Calls, field access, indexing, slices and blocks
// are not simple.
fn simple_index_ahead<a>(c: (&a mut C)) -> bool {
    mut i = c.pos;
    mut depth: u64 = 0;
    mut prev: u64 = 0;
    while true {
        k := kind_at(&mut c, i);
        if (k == 93) & (depth == 0) {
            return true;
        }
        if k == 40 {
            if (prev == 1) || (prev == 41) {
                return false;
            }
            depth += 1;
        } else {
            if k == 41 {
                if depth == 0 {
                    return false;
                }
                depth -= 1;
            } else {
                operator := (k == 43) || (k == 45) || (k == 42) || (k == 47) || (k == 37) || (k == 38) || (k == 124) || (k == 94) || (k == 60) || (k == 62) || (k == 126);
                if (k != 1) & (k != 2) & !operator {
                    return false;
                }
            }
        }
        prev = k;
        i += 1;
    }
    return false;
}
// `v[a: b]` (either bound optional) on a vector or slice: a typed slice borrowing those elements,
// exclusive when the access writes (docs/design/typed-slices.md).
fn vector_slice<a>(c: (&a mut C), x: Val, input: u64, access: u64) -> Val {
    xt := x.t;
    xty := x.ty;
    elem := ty_arg(&mut c, xty);
    write := access == 2;
    if write {
        if (ty_kind(&mut c, xty) == 27) & (ty_mode(&mut c, xty) == 0) {
            fail(&mut c, view("a mutable slice needs a mutable vector or slice"));
        }
        require_mutable_binding(&mut c, xt, 0);
    }
    mut start = 0;
    if is(&mut c, view(":")) {
        start = imm(&mut c, 0);
    } else {
        bstart := c.pos;
        mut bound = expr(&mut c, 0);
        bound = adopt_value(&mut c, bound, bstart, c.pos, 0);
        require_type(&mut c, bound.ty, 0);
        start = bound.t;
    }
    expect(&mut c, view(":"));
    mut end = 0;
    if is(&mut c, view("]")) {
        end = apply(&mut c, view("rt_len"), one(xt));
    } else {
        bstart := c.pos;
        mut bound = expr(&mut c, 0);
        bound = adopt_value(&mut c, bound, bstart, c.pos, 0);
        require_type(&mut c, bound.ty, 0);
        end = bound.t;
    }
    expect(&mut c, view("]"));
    mut width = 8;
    if narrow_code(&mut c, elem) != 0 {
        width = 4;
