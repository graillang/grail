        inner := ty_arg(&mut c, r.ty);
        if (ty_kind(&mut c, inner) != 7) || (ty_mode(&mut c, inner) != 0) {
            fail(&mut c, view("** needs a reference to a shared reference"));
        }
        n := ref_load(&mut c, r.t, inner);
        release_temporary(&mut c, r.t);
        target := ty_arg(&mut c, inner);
        if needs_drop(&mut c, target) {
            fail(&mut c, view("cannot copy an owned value out of a reference; use exchange"));
        }
        k2 := ty_kind(&mut c, target);
        if (k2 == 5) || (k2 == 27) || (k2 == 7) {
            fail(&mut c, view("** copies a plain value; borrow views and references through one level"));
