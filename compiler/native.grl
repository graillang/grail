// Calls use the target word ABI (up to six words; machine.grl selects physical registers).
fn apply<a, b>(c: (&a mut C), f: &b [u8], args: u64[]) -> u64 {
    return invoke(borrow_mut(c), f, args);
}
fn one(a: u64) -> u64[] {
    mut v = u64[];
    v.push(a);
    return v;
}
fn two(a: u64, b: u64) -> u64[] {
    mut v = u64[];
    v.push(a);
    v.push(b);
    return v;
}
fn three(a: u64, b: u64, d: u64) -> u64[] {
    mut v = u64[];
    v.push(a);
    v.push(b);
    v.push(d);
    return v;
}
