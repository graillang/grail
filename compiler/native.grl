    // `dyn I` / `dyn module::I`: a value of any type implementing I, chosen at run time.
    here_dyn := c.pos;
    if is(&mut c, view("dyn")) && (kind_at(&mut c, here_dyn + 1) == 1) {
        advance(&mut c);
        first := ident(&mut c);
        mut m = module_copy(&mut c);
        mut n = first.copy();
        if eat(&mut c, view("::")) {
            m = first.copy();
            n = ident(&mut c);
        } else {
            imported := resolve_import(&mut c, view(n));
