// Current cursor is the key expression, after '['. Find the outer closing bracket.
fn index_assignment_operator<a>(c: (&a mut C)) -> u64 {
    mut q = c.pos;
    mut depth = 0;
    while true {
        k := kind_at(&mut c, q);
        if k == 0 {
            fail(&mut c, view("unclosed map index assignment"));
        }
        if k == 91 {
            depth += 1;
        }
        if k == 93 {
            if depth == 0 {
                return q + 1;
            }
            depth -= 1;
        }
        q += 1;
    }
    return 0;
