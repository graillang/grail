fn print_builtin<a>(c: (&a mut C), newline: u64) -> Val {
    expect(borrow_mut(c), &"(");
    if eat(borrow_mut(c), &")") {
        if newline == 0 {
            fail(borrow_mut(c), &"print requires an argument");
        }
        invoke(borrow_mut(c), &"rt_print_newline", u64[]);
        return val(imm(borrow_mut(c), 0), 1);
    }
    // print("x = {}, y = {}", x, y): the literal is split at compile time; {{ and }} are braces.
    if (kind(borrow_mut(c)) == 3) & (next_kind(borrow_mut(c)) == 44) {
        p := c.pos;
        text := decode_literal(borrow_mut(c), p);
        advance(borrow_mut(c));
        mut piece = u8[];
        mut i = 0;
        while i < text.len() {
            b := text[i];
            mut next = 0;
            if i + 1 < text.len() {
                next = text[i + 1];
            }
            if (b == 123) & (next == 123) {
                piece.push(123);
                i += 2;
                continue;
            }
            if (b == 125) & (next == 125) {
                piece.push(125);
                i += 2;
                continue;
            }
            if (b == 123) & (next == 58) {
                // {:[fill][<^>][0][width][.precision]} (precision: f64 decimals, rounded half to even like Rust).
                sp := parse_spec(borrow_mut(c), &text, i);
                print_raw(borrow_mut(c), &piece);
                piece = u8[];
                end := sp.end;
                acc := invoke(borrow_mut(c), &"rt_new", u64[]);
                format_spec_arg(borrow_mut(c), acc, sp);
                zero := imm(borrow_mut(c), 0);
                invoke(borrow_mut(c), &"rt_print_acc", two(acc, zero));
                i = end;
                continue;
            }
            if (b == 123) & (next == 125) {
                print_raw(borrow_mut(c), &piece);
                piece = u8[];
                if eat(borrow_mut(c), &",") == 0 {
                    fail(borrow_mut(c), &"missing argument for {} in format string");
                }
                value := expr(borrow_mut(c), 0);
                print_value(borrow_mut(c), value, 0);
                i += 2;
                continue;
            }
            if (b == 123) + (b == 125) {
                fail(borrow_mut(c), &"unmatched brace in format string (use {{ or }})");
            }
            piece.push(b);
            i += 1;
        }
        print_raw(borrow_mut(c), &piece);
        if is(borrow_mut(c), &",") {
            fail(borrow_mut(c), &"more arguments than {} placeholders in format string");
        }
        expect(borrow_mut(c), &")");
        if newline {
            invoke(borrow_mut(c), &"rt_print_newline", u64[]);
        }
        return val(imm(borrow_mut(c), 0), 1);
    }
    input := expr(borrow_mut(c), 0);
    expect(borrow_mut(c), &")");
    print_value(borrow_mut(c), input, newline);
    return val(imm(borrow_mut(c), 0), 1);
}
// format("x = {}", x) -> string, with the same compile-time placeholder checks as print.
fn format_builtin<a>(c: (&a mut C)) -> Val {
