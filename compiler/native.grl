            }
        }
    }
    return 0;
}
// At `[`: whether the matching `]` is followed by `(.field)*.method(` with a mutating method.
fn mutating_call_after_index<a>(c: (&a mut C), elem: u64) -> u64 {
    mut q = c.pos;
    mut depth = 0;
    while true {
        k := kind_at(&mut c, q);
        if (k == 0) || (k == 59) {
            return 0;
        }
        if k == 91 {
            depth = depth + 1;
        }
        if k == 93 {
            depth = depth - 1;
            if depth == 0 {
                break;
            }
        }
        q = q + 1;
    }
    q = q + 1;
    while (kind_at(&mut c, q) == 46) & (kind_at(&mut c, q + 1) == 1) {
        if kind_at(&mut c, q + 2) == 40 {
            name := tok_text(&mut c, q + 1);
            return mutating_method_name(&mut c, view(name), elem);
