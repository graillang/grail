 p :=ident(borrow_mut(c));expect(borrow_mut(c),&":");ty :=parse_type(borrow_mut(c));
 if pass==2{c.params.push(ty);}id :=fresh(borrow_mut(c));bind(borrow_mut(c),p,ty,id,0);count=count+1;
 if eat(borrow_mut(c),&")"){break;}expect(borrow_mut(c),&",");}}
 if 6<count{fail(borrow_mut(c),&"native function exceeds six parameters");}
 mut ret=1;if eat(borrow_mut(c),&"->"){ret=parse_type(borrow_mut(c));}exchange(borrow_mut(c.result),ret);
