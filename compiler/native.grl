 parent :=authority_loan(borrow_mut(c),authority,root);if ownership::access_loan(borrow(c.check),parent,root,1)!=0{fail(borrow_mut(c),read("unique field reborrow requires mutable frame"));}}
 else{if ownership::can_cleanup(borrow(c.check),root)==0{fail(borrow_mut(c),read("field frame is shared"));}}}}
 var found=0;n :=len(c.bonds);
 for i in n{var b =vec_get(c.bonds,i);h :=b.holder;parent :=b.loan;guard :=b.guard;
 if loan_live(borrow_mut(c),parent){if ownership::ancestor(borrow(c.check),h,root){if guard{bond_kind(borrow_mut(c),holder,parent,1);}else{loan :=ownership::reborrow(borrow_mut(c.check),parent,mode);if loan==0{fail(borrow_mut(c),read("view reborrow lacks authority"));}bond(borrow_mut(c),holder,loan);found=1;}}}}
 if found==0{fail(borrow_mut(c),read("view has no lifetime source"));}
