            }
            v = index_view(&mut c, v, access);
        }
        tag_narrow_borrow(&mut c, v.t);
        expect(&mut c, view(")"));
        return v;
    }
    here := c.pos;
    if (id == 37) & (kind(&mut c) == 3) & (kind_at(&mut c, here + 1) == 41) {
        // view("literal"): a static descriptor beside the bytes, so no string is built,
        // copied or freed (rt_free leaves blocks marked static alone).
        v := static_literal_view(&mut c);
        expect(&mut c, view(")"));
        return v;
    }
    if (id == 39) & (kind(&mut c) == 3) & (kind_at(&mut c, here + 1) == 41) {
        // cstr("literal"): the bytes live in read-only static storage for the whole program, so
        // the pointer carries no borrow and may be kept in a binding or a record field. The NUL
        // is checked here rather than at run time.
        if (c.raw == 0) & (c.unsafe_depth == 0) {
            fail(&mut c, view("cstr requires an unsafe block"));
        }
        return static_literal_cstr(&mut c);
    }
    if (id == 40) || (id == 41) {
        exchange(&mut c.cptr_address, id - 39);
    }
    a := expr(&mut c, 0);
    exchange(&mut c.cptr_address, 0);
    if (id == 40) || (id == 41) {
