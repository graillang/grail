        id := local_id(&mut c, l - 1);
        ty := local_ty(&mut c, l - 1);
        mut target = id;
        mut through = 0;
        mut fieldty = 0;
        if kind(&mut c) == 46 {
            a := field_path(&mut c, id, ty, 2);
            target = a.t;
            through = 1;
            fieldty = ty_arg(&mut c, a.ty);
        }
        assignment_tail(&mut c, l, id, ty, target, u64[through, fieldty]);
