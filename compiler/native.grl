fn compound_operator(k: u64) -> u64 {
    if k == 262 {
        return 43;
    }
    if k == 263 {
        return 45;
    }
    if k == 264 {
        return 42;
    }
    if k == 265 {
        return 47;
    }
    if k == 266 {
        return 37;
    }
    return 267;
