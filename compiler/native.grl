 for i in count{reg :=argreg(i);o(borrow_mut(c),&"movq ");o(borrow_mut(c),&reg);c.out.push(44);stack_slot(borrow_mut(c),i);c.out.push(10);}
 o(borrow_mut(c),&"leaq -.F");on(borrow_mut(c),frame);o(borrow_mut(c),&"(%rbp),%rdi\nmovq $.F");on(borrow_mut(c),frame);
 o(borrow_mut(c),&"/8-");on(borrow_mut(c),count);o(borrow_mut(c),&",%rcx\nxorl %eax,%eax\nrep stosq\n");
