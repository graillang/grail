    if same(&name,&"store_relaxed"){f="rt_atomic_store_relaxed";arity=1;unit=1;}
    if same(&name,&"store_release"){f="rt_atomic_store_release";arity=1;unit=1;}
    if same(&name,&"fetch_add"){f="rt_atomic_fetch_add";arity=1;}
    if same(&name,&"fetch_sub"){f="rt_atomic_fetch_sub";arity=1;}
