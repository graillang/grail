        expect(&mut c, view(":"));
        nextvalue := context_value(&mut c, valuety);
        map_literal_insert(&mut c, val(map.t, map.ty), nextkey, nextvalue);
    }
    expect(&mut c, view("]"));
    return map;
}

fn primary<a>(c: (&a mut C)) -> Val {
    k := kind(&mut c);
