        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            holder := b.holder;
            guard := b.guard;
            loan := b.loan;
            if (guard == 3) & ownership::ancestor(&c.check, destination, holder) {
                if loan_live(&mut c, loan) != 0 {
                    mut l = &c.check.loans[loan - 1];
                    source := l.source;
                    mut r = region_of(&mut c, source);
                    if r != 18446744073709551615 {
                        if r != 0 {
                            fail(
