    host_fn(&mut c, view("tcp_connect"), 0);
    host_fn(&mut c, view("open"), 0);
    host_fn(&mut c, view("exit"), 1);
    host_fn(&mut c, view("remove"), 0);
    host_fn(&mut c, view("create_dir"), 0);
    // The stack where it is called, one `  at NAME (FILE:LINE:COL)` line per frame, or no text when
    // this build carries no tables (runtime.grl rt_backtrace). Empty argument list, owned bytes.
    host_fn(&mut c, view("backtrace"), 2);
    numbers_array := intern(&mut c, 6, 0);
    host_fn(&mut c, view("stat"), numbers_array);
    host_fn(&mut c, view("rename"), 0);
    host_fn(&mut c, view("symlink"), 0);
    host_fn(&mut c, view("spawn"), 0);
    host_fn(&mut c, view("wait"), 0);
    // `host::fork()`: 0 in the child, the child's id in the parent, a wrapped negative errno where
    // the platform has no fork (anything but Linux). The compiler's own use: the optimiser's
    // passes over a program's functions run in forked workers (docs/design/compile-speed.md).
    host_fn(&mut c, view("fork"), 0);
    // How many processors this process may run on, without starting the task scheduler (which
    // `host::workers()` does, and a process with threads cannot fork).
    host_fn(&mut c, view("cpus"), 0);
    host_fn(&mut c, view("ready"), 0);
    host_fn(&mut c, view("cwd"), 2);
    argc := host::argc();
    mut offset = 0;
    if 1 < argc {
        first := host::arg(1);
        if cli::is_command(view(first)) {
            return cli::run();
        }
    }
    while offset + 1 < argc {
        option := host::arg(offset + 1);
        if same(view(option), view("--show-derives")) {
            // `--show-derives`: print the source `@derive` wrote for each declaration, so a program
            // can see what the compiler generated without a debugger (docs/design/derives.md).
            exchange(&mut c.dr_trace, 1);
            offset += 1;
        } else if same(view(option), view("--comptime-probe")) {
            // Internal: this compile builds the probe for a compile-time call. The probe file comes
            // first, so the program's own entry file (which may omit its `module` line) is second.
            exchange(&mut c.probe_mode, 1);
            offset += 1;
        } else if same(view(option), view("--skip-body")) {
            // Internal: a function body an earlier run of this same compile reported an error in
            // (`FILE:POS`). It is skipped, so the run goes on to the next error.
            if argc < offset + 3 {
                fail_option(&mut c, view("--skip-body needs FILE:POS"));
            }
            at := host::arg(offset + 2);
            mut f = 0;
            mut q = 0;
            mut seen_colon = false;
            for i in at.len() {
                ch := at[i];
                if ch == 58 {
                    seen_colon = true;
                } else if seen_colon {
                    q = q * 10 + u64(ch - 48);
                } else {
                    f = f * 10 + u64(ch - 48);
                }
            }
            c.skip_bodies.push(f);
            c.skip_bodies.push(q);
            offset += 2;
        } else if same(view(option), view("--reported")) {
            // Internal: a diagnostic an earlier run of this same compile already printed. A replay
            // that reaches it again is not printed and not counted a second time.
            if argc < offset + 3 {
                fail_option(&mut c, view("--reported needs a key"));
            }
            c.reported.push(copy_bytes(host::arg(offset + 2)));
            offset += 2;
        } else if same(view(option), view("--deny-ambient-host")) || same(view(option), view("--split")) {
            // --split: one assembly file per module. OUT.s is replaced by OUT.NNN.module.s files,
            // and OUT.parts lists them in link order for the driver.
            if same(view(option), view("--split")) {
                exchange(&mut c.split, 1);
            } else {
                exchange(&mut c.deny_ambient, 1);
            }
            offset += 1;
        } else if same(view(option), view("--interface")) || same(view(option), view("--emit-interface")) {
            // B1 stage 2: `--interface DIR` checks every module given as source against
            // `DIR/<module>.iface` (the source is compiled, and its interface must say what the
            // source says); `--emit-interface DIR` writes them. Building a module against other
            // modules' interfaces, without their source, is `--use`.
            if argc < offset + 3 {
                fail_option(&mut c, view("--interface and --emit-interface need a directory"));
            }
            if same(view(option), view("--interface")) {
                exchange(&mut c.iface_dir, host::arg(offset + 2));
                exchange(&mut c.iface_verify, 1);
            } else {
                exchange(&mut c.iface_emit, host::arg(offset + 2));
            }
            offset += 2;
        } else if same(view(option), view("--diagnostics-json")) {
            // A structured diagnostics listener: every diagnostic this compile reports is appended
            // to FILE as one JSON object per line, and nothing is printed. The driver truncates the
            // file before it starts a compile, so the re-runs below append to one cycle's records.
            if argc < offset + 3 {
                fail_option(&mut c, view("--diagnostics-json needs FILE"));
            }
            exchange(&mut c.diag_json, host::arg(offset + 2));
            offset += 2;
        } else if same(view(option), view("--use")) {
            // B1 stage 3: a directory of interfaces to build *against*. A module whose source is not
            // on the command line is taken from its interface - declarations and generic bodies -
            // and its code is expected in its own object. This is what lets a module be compiled
            // without the source of the modules it imports.
            if argc < offset + 3 {
                fail_option(&mut c, view("--use needs a directory"));
            }
            exchange(&mut c.iface_use, host::arg(offset + 2));
            offset += 2;
        } else if same(view(option), view("--use-module")) {
            if argc < offset + 3 {
                fail_option(&mut c, view("--use-module needs a module name"));
            }
            c.iface_only.push(host::arg(offset + 2));
            exchange(&mut c.iface_only_on, 1);
            offset += 2;
        } else if same(view(option), view("--shift-declarations")) {
            // A test switch (`tools/test-native.mjs --unit-identity`): synthesise this many tuple
            // declarations before the first body, so every declaration a body synthesises gets a
            // different index than it would. The assembly must not change: a body's text may not
            // depend on how many declarations exist, which is what lets a unit be compiled apart from
            // the bodies before it (docs/design/incremental-compilation.md).
            if argc < offset + 3 {
                fail_option(&mut c, view("--shift-declarations needs a count"));
            }
            words := host::arg(offset + 2);
            mut n = 0;
            for i in words.len() {
                n = n * 10 + u64(words[i] - 48);
            }
            exchange(&mut c.shift_decls, n);
            offset += 2;
        } else if same(view(option), view("--use-named")) {
            // Only the modules `--use-module` names are read, even when it names none.
            exchange(&mut c.iface_only_on, 1);
            offset += 1;
        } else if same(view(option), view("--module-root")) {
            // A directory a `use NAME;` is resolved in: `DIR/NAME.grl`. Repeatable, and tried in the
            // order given (docs/design/module-resolution.md).
            if argc < offset + 3 {
                fail_option(&mut c, view("--module-root needs a directory"));
            }
            c.mod_roots.push(copy_bytes(view(host::arg(offset + 2))));
            offset += 2;
        } else if same(view(option), view("--print-inputs")) {
            // Internal, for the driver: write the inputs this run would read - the command line's
            // files and the ones the module roots resolve, one `NAME PATH` line each - and build
            // nothing. A multi-module build groups by module, so it asks rather than guesses.
            if argc < offset + 3 {
                fail_option(&mut c, view("--print-inputs needs a file"));
            }
            exchange(&mut c.mod_list, 1);
            exchange(&mut c.mod_list_file, host::arg(offset + 2));
            offset += 2;
        } else if same(view(option), view("--fn-cache")) {
            // The per-function codegen cache: DIR holds one file per emitted function, keyed by
            // everything its bytes are a function of (docs/design/incremental-compilation.md).
            // The driver passes it when `--cache` is asked for; nothing else does.
            if argc < offset + 3 {
                fail_option(&mut c, view("--fn-cache needs a directory"));
            }
            exchange(&mut c.fn_dir, host::arg(offset + 2));
            offset += 2;
        } else if same(view(option), view("--fn-cache-quiet")) {
            // The driver's default build uses the store without being asked to by name, and then
            // says nothing about it: no per-module report line.
            exchange(&mut c.fn_quiet, 1);
            offset += 1;
        } else if same(view(option), view("--fn-cache-id")) {
            // The compiler's own digest, as the driver computed it (`cache_build_id`). A unit is
            // code this compiler emitted, so a new compiler is a new key for every function.
            if argc < offset + 3 {
                fail_option(&mut c, view("--fn-cache-id needs a digest"));
            }
            exchange(&mut c.fn_id, host::arg(offset + 2));
            offset += 2;
        } else if same(view(option), view("--check")) {
            // Check only: every diagnostic a build gives is given by the passes over the source, so
            // the run ends when they do - no optimiser, no location table, nothing written. This is
            // what `grail check` runs (docs/design/compile-speed.md).
            exchange(&mut c.check_only, 1);
            offset += 1;
        } else if same(view(option), view("--no-entry")) {
            // A run that emits one module's code for a link, not a program: no entry stub, so the
            // process state is defined once, by the run that holds the entry.
            exchange(&mut c.no_entry, 1);
            offset += 1;
        } else if same(view(option), view("--object")) {
            if argc < offset + 3 {
                fail_option(&mut c, view("--object needs a file"));
            }
            exchange(&mut c.object, host::arg(offset + 2));
            offset += 2;
        } else if same(view(option), view("--separate")) {
            // One object of a program (B1 stage 4): every definition global, so a part call binds
            // through the linker instead of staying a symbol of this stream.
            exchange(&mut c.separate, 1);
            offset += 1;
        } else if same(view(option), view("--iface-dump")) || same(view(option), view("--iface-roundtrip")) {
            // Inspecting a written interface: `grail iface dump` and `grail iface roundtrip` are the
            // driver's spellings of these. Neither compiles anything.
            if argc < offset + 3 {
                fail_option(&mut c, view("--iface-dump and --iface-roundtrip need a file"));
            }
            if same(view(option), view("--iface-dump")) {
                exchange(&mut c.iface_dump, host::arg(offset + 2));
            } else {
                exchange(&mut c.iface_roundtrip, host::arg(offset + 2));
            }
            offset += 2;
        } else if same(view(option), view("--verify-interface")) {
            // Check the interfaces on disk against the sources just parsed instead of trusting
            // either side: an interface that disagrees is refused, naming the declaration.
            exchange(&mut c.iface_verify, 1);
            offset += 1;
        } else {
        if same(view(option), view("--target")) {
            if argc < offset + 3 {
                fail_option(
                    &mut c,
                    view(
                        "--target needs x86_64, aarch64, riscv64, windows-x86_64, windows-aarch64, macos-x86_64 or macos-aarch64"
                    )
                );
            }
            target := host::arg(offset + 2);
            exchange(&mut c.plat, 0);
            if same(view(target), view("x86_64")) {
                exchange(&mut c.target, 0);
            } else {
                if same(view(target), view("aarch64")) {
                    exchange(&mut c.target, 1);
                } else {
                    if same(view(target), view("riscv64")) {
                        exchange(&mut c.target, 2);
                    } else {
                        if same(view(target), view("windows-x86_64")) {
                            exchange(&mut c.target, 3);
                        } else {
                            if same(view(target), view("windows-aarch64")) {
                                exchange(&mut c.target, 4);
                            } else {
                                if same(view(target), view("macos-x86_64")) {
                                    exchange(&mut c.target, 0);
                                    exchange(&mut c.plat, 1);
                                } else {
                                    if same(view(target), view("macos-aarch64")) {
                                        exchange(&mut c.target, 1);
                                        exchange(&mut c.plat, 1);
                                    } else {
                                        fail_option(
                                            &mut c,
                                            view(
                                                "unsupported target (expected x86_64, aarch64, riscv64, windows-x86_64, windows-aarch64, macos-x86_64 or macos-aarch64)"
                                            )
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
            }
            offset += 2;
        } else {
            if same(view(option), view("--overflow=wrap")) {
                exchange(&mut c.overflow, 0);
                offset += 1;
            } else {
                if same(view(option), view("--overflow=checked")) {
                    exchange(&mut c.overflow, 1);
                    offset += 1;
                } else {
                    if same(view(option), view("--export")) {
                        if argc < offset + 3 {
                            fail_option(&mut c, view("--export needs a function name"));
                        }
                        c.exports.push(host::arg(offset + 2));
                        c.export_hits.push(0);
                        offset += 2;
                    } else {
                    if same(view(option), view("--typed-refs")) || same(view(option), view("--default-u64")) {
                        // No-ops, kept for one release. Typed references and the u64 default are the
                        // language's only modes now, so a build script that still passes the old
                        // flags gets exactly the compiler it used to; the next release can drop them.
                        offset += 1;
                    } else {
                        if same(view(option), view("--strict-bool-report")) {
                            // Survey: report every bool/integer violation and keep compiling.
                            exchange(&mut c.strict_bool_report, 1);
                            offset += 1;
                        } else {
                            if same(view(option), view("--debug")) {
                                exchange(&mut c.debug, 1);
                                offset += 1;
                            } else {
                                if same(view(option), view("--backend=llvm")) {
                                    exchange(&mut c.backend, 1);
                                    offset += 1;
                                } else {
                                    if starts_with(view(option), view("--forge-indirect=")) {
                                        // A test aid: SYMBOL's indirect-call facts say one word
                                        // fewer than the call passes (indirect_fact).
                                        mut sym = u8[];
                                        for d in option.len() - 17 {
                                            sym.push(option[17 + d]);
                                        }
                                        exchange(&mut c.forge_indirect, sym);
                                        offset += 1;
                                    } else if starts_with(view(option), view("--forge-signature=")) {
                                        // A test aid: record SYMBOL's signature fact with WORDS
                                        // argument words instead of its real count, so the lifter's
                                        // checks of a wrong signature can be shown to fire.
                                        // `:1` after WORDS also records a one-word result for a
                                        // body that returns two (no `dyn_result` fact).
                                        mut colon = 0;
                                        mut second = 0;
                                        for d in option.len() - 18 {
                                            if option[18 + d] == 58 {
                                                if colon == 0 {
                                                    colon = 18 + d;
                                                } else {
                                                    second = 18 + d;
                                                }
                                            }
                                        }
                                        mut end = option.len();
                                        if second != 0 {
                                            end = second;
                                            exchange(&mut c.forge_result, 1);
                                        }
                                        mut n = 0;
                                        for d in end - colon - 1 {
                                            n = n * 10 + u64(option[colon + 1 + d]) - 48;
                                        }
                                        mut sym = u8[];
                                        for d in colon - 18 {
                                            sym.push(option[18 + d]);
                                        }
                                        exchange(&mut c.forge_sig, sym);
                                        exchange(&mut c.forge_words, n);
                                        offset += 1;
                                    } else if starts_with(view(option), view("--f1-what=")) {
                                        // A test aid: record a deliberately wrong F1 kind so the
                                        // --verify-facts checks can be shown to fire.
                                        mut n = 0;
                                        for d in option.len() - 10 {
                                            n = n * 10 + u64(option[10 + d]) - 48;
                                        }
                                        exchange(&mut c.f1_what, n);
                                        offset += 1;
                                    } else {
                                        if same(view(option), view("--strict-refinements")) {
                                            exchange(&mut c.strict_refinements, 1);
                                            offset += 1;
                                        } else {
                                        if same(view(option), view("--verify-facts")) {
                                            exchange(&mut c.verify_facts, 1);
                                            offset += 1;
                                        } else if same(view(option), view("--emit-ir")) {
                                            exchange(&mut c.emit_ir, 1);
                                            offset += 1;
                                        } else {
                                            if same(view(option), view("--range-facts")) {
                                                exchange(&mut c.range_facts, 1);
                                                offset += 1;
                                            } else if same(view(option), view("--no-error-sites")) {
                                                // No call-site table: runtime errors print their
                                                // message without a location (tools comparing a
                                                // build with a --split one byte for byte).
                                                exchange(&mut c.no_sites, 1);
                                                offset += 1;
                                            } else {
                                                break;
                                            }
                                        }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
        }
    }
    exchange(&mut c.arg_offset, offset);
    if c.iface_dump.len() != 0 {
        iface_dump(&mut c, view(c.iface_dump.copy()));
        host::exit(0);
    }
    if c.iface_roundtrip.len() != 0 {
        iface_roundtrip(&mut c, view(c.iface_roundtrip.copy()));
        host::exit(0);
    }
    // The program's files: the command line's own, then every module their `use` lines reach through
    // the module roots. This settles the module set before any interface is checked or read, so an
    // interface directory is compared against the sources the build really compiles; `use fs;` is
    // enough to build a program that uses fs (docs/design/module-resolution.md).
    resolve_modules(&mut c, offset);
    // Interfaces are checked against the manifest the emitting run wrote before anything reads one.
    mut iface_dir = c.iface_dir.copy();
    if iface_dir.len() != 0 {
        iface_check_manifest(&mut c, view(iface_dir));
    }
    if c.iface_use.len() != 0 {
        iface_load_used(&mut c, view(c.iface_use.copy()));
    }
    // `n` is the last input index + 1, as it always was, so the passes below read one list: the
    // command line's files and the ones resolution added after them.
    n := c.mod_base + c.mod_files.len();
    if c.mod_list != 0 {
        print_inputs(&mut c, n);
        return 0;
    }
    if !(2 < n) {
        fail_option(
            &mut c,
            view(
                "usage: grail [--target ARCH] [--overflow=checked|wrap] [--debug] [--verify-facts] [--emit-ir] [--strict-refinements] [--deny-ambient-host] [--split] OUT.s ENTRY.grl MODULE.grl..."
            )
        );
    }
    // DWARF on Linux x86-64, AArch64 and RISC-V 64; CodeView line tables (a PDB through lld-link
    // /DEBUG) on Windows x86-64.
    if (c.debug != 0) && (((c.target == 4) || (c.plat != 0))) {
        fail_option(&mut c, view("--debug line info is only implemented for Linux and Windows x86_64"));
    }
    if (c.backend != 0) && (((c.target > 2) || (c.plat != 0) || (c.debug != 0))) {
        fail_option(&mut c, view("--backend=llvm is implemented for Linux x86_64, aarch64 and riscv64 without --debug"));
    }
    if (c.verify_facts != 0) && (c.backend == 0) {
        // On the native backend the flag checks the refinements the prover discharged: every one of
        // them still emits its runtime check, so a wrong proof aborts instead of going unnoticed.
        exchange(&mut c.verify_facts, 2);
    }
    if (c.range_facts != 0) && (c.backend == 0) {
        fail_option(&mut c, view("--range-facts derives range facts in the LLVM lifter; add --backend=llvm"));
    }
    // Splitting is a build-shape change on the native assembly path; the line tables and the LLVM
    // route inspect the whole stream, and the Mach-O/PE writers rewrite it after selection.
    if (c.split != 0) && ((c.target != 0) || (c.plat != 0) || (c.debug != 0) || (c.backend != 0)) {
        fail_option(
            &mut c,
            view("--split is implemented for the Linux x86_64 assembler path, without --debug")
        );
    }
    jobs::phase(view("start"));
    for pass in 3 {
        if pass == 1 {
            if c.plat == 1 {
                o(&mut c, view(".build_version macos, 11, 0\n"));
            }
            if c.debug != 0 {
                mut f = 2;
                while f < n {
                    path := input_path(&c, f);
                    number := f - 1;
                    if c.target == 3 {
                        o(&mut c, view(".cv_file "));
                    } else {
                        o(&mut c, view(".file "));
                    }
                    on(&mut c, number);
                    o(&mut c, view(" \""));
                    emit_path(&mut c, view(path));
                    o(&mut c, view("\"\n"));
                    f += 1;
                }
            }
            // With --split every part file re-states `.text`; the stream carries no preamble.
            if c.split == 0 {
                o(&mut c, view(".text\n"));
            }
        }
        if pass == 1 {
            jobs::phase(view("names"));
        }
        if pass == 2 {
            jobs::phase(view("declarations"));
            par_start(&mut c, n);
            // From the bodies on, a check writes no text (`quiet`): its units are check units, with
            // the registrations and no text (fn_unit_of), as cargo's metadata is to its rlib.
            if c.check_only != 0 {
                exchange(&mut c.quiet, 1);
            }
        }
        mut i = 2;
        while i < n {
            path := input_path(&c, i);
            load_file(&mut c, i);
            exchange(&mut c.file, i);
            toplevel(&mut c, pass + 1);
            if pass == 0 {
                c
                    .iface_list
                    .push(
                        IModule {
                            module: module_copy(&mut c),
                            path: path.copy(),
                            std: in_std_dir(view(path)),
                            unsafe: c.raw,
                            host: 0
                        }
                    );
            }
            i = i + 1;
        }
        if pass == 2 {
            default_methods(&mut c, 3);
            if c.par_me != 0 {
                par_worker_finish(&mut c);
            }
            jobs::phase(view("bodies"));
            par_end(&mut c);
            jobs::phase(view("bodies-workers-collected"));
        }
        // The definition sweep for the interfaces read above, once every module's names exist.
        // `--interface` and `--use` both land here; the path each interface came from was recorded
        // when its names were registered.
        if (pass == 0) & (c.iface_verify == 0) {
            for k in c.iface_loaded.len() {
                iface_load(&mut c, view(c.iface_loaded_path[k].copy()), view(""), 2);
            }
            fx_read_runtime_facts(&mut c);
        }
        if pass == 1 {
            default_methods(&mut c, 2);
            exchange(&mut c.headers_complete, 1);
            check_interfaces(&mut c);
            validate_type_constraints(&mut c);
            if c.iface_verify != 0 {
                for j in c.iface_list.len() {
                    if !same(view(c.iface_list[j].module), view("runtime")) {
                        iface_verify_module(&mut c, j);
                    }
                }
            }
            // Every run-tier value of the build in one probe (comptime-speed R2), before anything
            // asks for one: the interfaces below, the function cache's surface, the bodies.
            ct_batch(&mut c);
            iface_emit_all(&mut c);
        }
        if (pass == 1) & (c.shift_decls != 0) {
            // Largest first, so each is a new declaration.
            for i in c.shift_decls {
                if i < 11 {
                    tuple_decl(&mut c, 12 - i);
                }
            }
        }
        if (pass == 1) & (c.fn_dir.len() != 0) {
            // The declaration surface is final once every declaration is known. Both hashes are
            // computed once, here, before the first body is emitted: a declaration synthesised
            // while a body is emitted must not move the surface under the bodies that follow it.
            exchange(&mut c.fn_flags, fn_flags_now(&mut c));
            exchange(&mut c.fn_surface, fn_surface_now(&mut c));
            fncache::ensure(view(c.fn_dir));
        }
    }
    // Every definition has been emitted by now, so an --export name that never matched is a typo.
    for i in c.exports.len() {
        if c.export_hits[i] == 0 {
            host::print(view("grail: export '"));
            missing := &c.exports[i];
            host::print(view(missing));
            host::print(view("' is not defined by any function\n"));
            host::exit(1);
        }
    }
    // Requests are read once every declaration is known: a request names a template and the types
    // to instantiate it with, which is all `specialize` needs to add the body to this build.
    // Constants a compile-time call gives that nothing used are evaluated now (C3).
    resolve_all_pending(&mut c);
    emit_specializations(&mut c);
    jobs::phase(view("specialisations"));
    // A closure body can instantiate a generic (`Some(x)` inside `|| ...`) and a specialisation can
    // create a closure, so the two are emitted to a fixpoint; request files are written once both
    // lists are complete.
    mut specs_done = c.specs.len();
    mut closures_done = emit_closures(&mut c, 0);
    while (specs_done < c.specs.len()) || (closures_done < c.closures.len()) {
        specs_done = drain_specs(&mut c, specs_done);
        closures_done = emit_closures(&mut c, closures_done);
    }
    jobs::phase(view("closures"));
    emit_fn_thunk(&mut c);
    emit_box_thunks(&mut c);
    emit_drops(&mut c);
    jobs::phase(view("drop-helpers"));
    // A drop helper can be the first thing to ask for a generic `Drop` implementation's
    // specialisation, so anything it requested is emitted before the helpers are written out.
    helpers_specs := c.specs.len();
    while (specs_done < c.specs.len()) || (closures_done < c.closures.len()) {
        specs_done = drain_specs(&mut c, specs_done);
        closures_done = emit_closures(&mut c, closures_done);
    }
    if specs_done != helpers_specs {
        // Those bodies can name more helpers, and a named helper with no body is an undefined symbol.
        emit_drops(&mut c);
    }
    jobs::phase(view("helper-specialisations"));
    emit_vtables(&mut c);
    jobs::phase(view("vtables"));
    // A vtable's drop slot is a helper too, and the bodies emitted above were the first to name
    // some types: one more sweep emits what they named and leaves no symbol undefined.
    emit_drops(&mut c);
    fx_end(&mut c);
    // Every body is emitted: the effect claims are settled over the whole call graph.
    jobs::phase(view("drops-vtables"));
    fx_solve(&mut c);
    // A probe is not the program: its job is to run initialisers, and a body it compiles may read a
    // value through a lazy initialiser the program itself never calls. Claims are the program's.
    if c.probe_mode == 0 {
        fx_report(&mut c);
    }
    ct_write_deps(&mut c);
    iface_emit_facts(&mut c);
    if c.skip_bodies.len() != 0 {
        // Every error this compile has is reported; the program is still rejected, and nothing it
        // would have written is.
        error_summary(c.reported.len(), u64(c.diag_json.len() != 0));
        host::exit(1);
    }
    if c.no_entry != 0 {
        // A run that emits one module's code for a link, not a program (B1 stage 3): the entry stub
        // and the process state belong to the run that holds the entry, so the linker sees one
        // `_start` and one `rt_state` however many objects a build has. The stack note still has to
        // be here, or the linker is entitled to warn about an executable stack.
        o(&mut c, view(".section .note.GNU-stack,\"\",@progbits\n"));
    } else {
    e := c.entry;
    if e == 0 {
        // No function in the entry file can be the program's entry. Say that at the file the caller
        // named: the last pass to run read a standard module, and this refusal used to point into
        // lib/result.grl - a location in a file the user never mentioned.
        at := 2 + c.probe_mode;
        if c.file != at {
            load_file(&mut c, at);
            exchange(&mut c.file, at);
            exchange(&mut c.pos, 0);
        }
        mut said = copy_bytes(view("no `main` in "));
        push_bytes(&mut said, view(input_path(&c, at)));
        push_bytes(&mut said, view(": a program needs `pub fn main()` (or a public function taking nothing or the argument view); a module without one is a library, used from a program"));
        fail(&mut c, view(said));
    }
    f := &c.funcs[e - 1];
    m := f.module.copy();
    name := f.name.copy();
    count := f.count;
    result := f.ret;
    first := f.first;
    entry_file := f.file;
    entry_pos := f.pos;
    named_main := same(view(name), view("main"));
    if named_main {
        if (result != 0) & (result != 1) {
            mut said = copy_bytes(view("`main` must return unit or u64; this one returns `"));
            push_bytes(&mut said, view(source_type_name(&mut c, result)));
            push_bytes(&mut said, view("`"));
            fail_in_file(&mut c, entry_file, entry_pos, view(said));
        }
    } else {
        if result != 0 {
            // The entry was picked, not written: a module with no `main` makes its first public
            // function with at most one parameter the entry. Name it, so the user is not told about
            // a rule they never invoked.
            mut said = copy_bytes(view("the entry `"));
            push_bytes(&mut said, view(m));
            push_bytes(&mut said, view("::"));
            push_bytes(&mut said, view(name));
            push_bytes(&mut said, view("` was picked because this module has no `main`, and an entry must return `u64`; it returns `"));
            push_bytes(&mut said, view(source_type_name(&mut c, result)));
            push_bytes(&mut said, view("`. Give the program a `pub fn main()`"));
            fail_in_file(&mut c, entry_file, entry_pos, view(said));
        }
    }
    if count == 1 {
        param := c.params[first];
        mode := ty_mode(&mut c, param);
        if ty_kind(&mut c, param) != 5 || mode != 0 {
            fail(&mut c, view("executable entry requires readonly argv view"));
        }
    }
    // The entry stub and the process state (rt_state, the TLS bases, .note.GNU-stack) exist once per
    // program and belong to no module, so they get their own synthetic part.
    part(&mut c, view("__start"));
    if (c.target == 3) {
        // A PE image starts without arguments: the loader leaves argv to the runtime, which reads
        // the Win32 command line. The process state words start empty and are filled by
        // rt_thread_init before the entry function runs. The thread bridge address is published
        // for CreateThread.
        o(
            &mut c,
            view(
                ".globl grail_entry\ngrail_entry:\nxorl %eax,%eax\nmovq %rax,rt_state(%rip)\nmovq %rax,rt_state+8(%rip)\nmovq %rax,rt_state+16(%rip)\nleaq rt_win_thread_start(%rip),%rax\nmovq %rax,rt_state+3392(%rip)\nandq $-16,%rsp\ncall rt_thread_init\nmovq rt_state(%rip),%rdi\n"
            )
        );
    } else {
    if c.target == 4 {
        o(
            &mut c,
            view(
                ".globl grail_entry\ngrail_entry:\nxorl %eax,%eax\nmovq %rax,rt_state(%rip)\nmovq %rax,rt_state+8(%rip)\nmovq %rax,rt_state+16(%rip)\nleaq rt_win_thread_start(%rip),%rax\nmovq %rax,rt_state+3392(%rip)\nandq $-16,%rsp\ncall rt_thread_init\nmovq rt_state(%rip),%rdi\n"
            )
        );
    
    } else {
        if c.plat == 1 {
            // libSystem's start calls _main(argc, argv, envp) with a 16-byte-aligned frame and an
            // installed stack guard; envp is the third argument here, not a stack slot.
            o(
                &mut c,
                view(".globl _main\n.p2align 4\n_main:\npushq %rbp\nmovq %rsp,%rbp\nmovq %rdi,_rt_state(%rip)\nmovq %rsi,_rt_state+8(%rip)\nmovq %rdx,_rt_state+16(%rip)\ncall _rt_thread_init\nmovq _rt_state(%rip),%rdi\n")
            );
        } else {
            o(
                &mut c,
                view(".globl _start\n_start:\nmovq (%rsp),%rdi\nleaq 8(%rsp),%rsi\nleaq 16(%rsp,%rdi,8),%rdx\nmovq %rdi,rt_state(%rip)\nmovq %rsi,rt_state+8(%rip)\nmovq %rdx,rt_state+16(%rip)\nandq $-16,%rsp\n")
            );
        }
    }
    }
    if site_table_on(&c) && (c.no_entry == 0) {
        // Where a runtime error can find the call-site table (runtime.grl rt_fail_where).
        o(&mut c, view("leaq rt_sites(%rip),%rax\nmovq %rax,rt_state+3400(%rip)\n"));
    }
    if tls_bridge(&mut c) {
        // Record the loader's TLS base before the runtime installs its own worker record.
        tls_capture(&mut c);
    }
    if (c.target != 3) & (c.target != 4) {
        if c.plat == 0 {
            o(&mut c, view("call rt_thread_init\nmovq rt_state(%rip),%rdi\n"));
        }
    }
    if count == 1 {
        ok := label(&mut c);
        o(&mut c, view("cmpq $2,%rdi\n"));
        jump(&mut c, view("je"), ok);
        emit_exit(&mut c, view("movl $2,%edi\n"));
        mark(&mut c, ok);
        o(
            &mut c,
            view("movl $1,%edi\ncall f_host_arg\nmovq %rax,%r12\nmovq %rax,%rdi\ncall rt_view\nmovq %rax,%rdi\n")
        );
    }
    o(&mut c, view("call "));
    mangle(&mut c, view(m), view(name));
    if count == 1 {
        o(&mut c, view("\nmovq %rax,%r13\nmovq %r12,%rdi\ncall rt_drop_seq\nmovq %r13,%rax"));
    }
    if named_main {
        if result == 0 {
            o(&mut c, view("\nmovq %rax,%r14\n"));
        } else {
            o(&mut c, view("\nxorq %r14,%r14\n"));
        }
    } else {
        o(&mut c, view("\nmovq %rax,%rdi\ncall rt_print_num\nxorq %r14,%r14\n"));
    }
    // The leak check: balanced -> return, a leak -> abort, a leak after a contained task failure ->
    // a note on fd 2 and a normal exit (rt_leak_exit; see task-failure-containment.md).
    if c.probe_mode == 0 {
        // A probe keeps the values it built on purpose (statics initialised lazily inside it).
        o(&mut c, view("call rt_leak_exit\n"));
    }
    o(&mut c, view("call rt_shutdown\n"));
    emit_exit(&mut c, view("movq %r14,%rdi\n"));
    if c.target == 3 {
        o(
            &mut c,
            view(
                "ud2\nrt_win_thread_start:\nsubq $56,%rsp\nmovq %rdi,32(%rsp)\nmovq %rsi,40(%rsp)\nmovq %rcx,%rdi\ncall rt_win_thread_main\nmovq 32(%rsp),%rdi\nmovq 40(%rsp),%rsi\naddq $56,%rsp\nret\n.bss\n.p2align 4\nrt_state: .zero 4096\n"
            )
        );
    } else {
    if c.target == 4 {
        // CreateThread's start routine on ARM64: the thread record arrives in x0, which is the
        // first argument register of Grail's lowered calls too, and x19-x28/d8-d15 are
        // callee-saved in both conventions; a framed call is the whole bridge.
        o(
            &mut c,
            view(
                "ud2\nrt_win_thread_start:\npushq %rbp\nmovq %rsp,%rbp\ncall rt_win_thread_main\npopq %rbp\nret\n.bss\n.p2align 4\nrt_state: .zero 4096\n"
            )
        );
    } else {
    if (c.target == 3) || (c.target == 4) {
        o(&mut c, view("ud2\n.bss\n.p2align 4\nrt_state: .zero 4096\n"));
    } else {
        if c.plat == 1 {
            o(
                &mut c,
                view("ud2\n.section __DATA,__bss\n.p2align 4\n_rt_state:\n.space 4096\n")
            );
        } else {
            tls_bss(&mut c);
        }
    }
    }
    }
    }
    if (c.fn_dir.len() != 0) & (c.fn_quiet == 0) {
        // What this run did with the store, one line per module run: bodies replayed from cache,
        // bodies filed as units, and bodies emitted that are not units (they reached outside their
        // own bytes, or a part was opened or a key could not be spelled).
        mut line = u8[];
        push_bytes(&mut line, view("grail: fn-cache: "));
        // The module this run compiled: the first part it opened, which a driver run (one module per
        // compiler invocation) opens for that module's first body. Not `c.part`, which by the end
        // names a synthetic part - `.helpers` for the drop helpers, `__start` for the entry stub.
        if c.lunits.len() != 0 {
            push_bytes(&mut line, view(c.lunits[0]));
        } else {
            push_bytes(&mut line, view("(none)"));
        }
        push_bytes(&mut line, view(": "));
        push_bytes(&mut line, view(decimal_bytes(c.fn_hits)));
        push_bytes(&mut line, view(" hit, "));
        push_bytes(&mut line, view(decimal_bytes(c.fn_filed)));
        push_bytes(&mut line, view(" filed, "));
        push_bytes(&mut line, view(decimal_bytes(c.fn_kept)));
        push_bytes(&mut line, view(" not units"));
        // Which rules kept them out, and how many bodies each (a body can meet several).
        mut listed = 0;
        for rule in c.fn_why.len() {
            if c.fn_why[rule] != 0 {
                if listed == 0 {
                    push_bytes(&mut line, view(" ("));
                } else {
                    push_bytes(&mut line, view(", "));
                }
                push_bytes(&mut line, view(fn_rule_name(rule)));
                line.push(32);
                push_bytes(&mut line, view(decimal_bytes(c.fn_why[rule])));
                listed += 1;
            }
        }
        if listed != 0 {
            line.push(41);
        }
        line.push(10);
        host::print(view(line));
    }
    jobs::phase(view("front-end-done"));
    if c.check_only != 0 {
        return 0;
    }
    mut out = u8[];
    // The typed IR of each body, as the optimizer parsed it, when --emit-ir asked for it.
    mut ir_text = u8[];
    mut call_syms = u8[][];
    mut call_counts = u64[];
    if (c.debug != 0) || (c.backend != 0) {
        out = copy_bytes(view(c.out));
        // A debug build skips the optimiser but not the lowering of the leaf accessors, which
        // would otherwise stay calls (`rt_slot4` per `f32[]` element). The LLVM lifter models the
        // calls themselves, so its stream keeps them.
        if (c.debug != 0) && (c.backend == 0) && (c.emit_ir == 0) {
            out = optimize::lower_leaf_calls(view(out));
        }
    } else {
        if c.split != 0 {
            out = optimize::optimize_parts(view(c.out), 1, &mut c.marks, &mut c.part_names, &c.facts, c.emit_ir, &mut ir_text, &mut call_syms, &mut call_counts, view(c.fn_dir), view(c.fn_id), &c.plan_at, &c.known, &mut c.xinl);
        } else {
            out = optimize::optimize(view(c.out), &c.facts, c.emit_ir, &mut ir_text, &mut call_syms, &mut call_counts, view(c.fn_dir), view(c.fn_id), &c.plan_at, &c.known, &mut c.xinl);
        }
        // The check the byte scan used to make, now from the IR: a call site that bypasses the
        // recording helpers is a compiler bug, and a bug here is a silently weaker proof.
        fx_check_calls(&mut c, &call_syms, &call_counts);
        // The runtime's summary again, now with the bodies the optimiser exported (only the run
        // that emitted the runtime writes it).
        if c.xinl.names.len() != 0 {
            fx_write_runtime_facts(&mut c);
        }
    }
    if c.emit_ir != 0 {
        mut ir_path = copy_bytes(view(host::arg(1 + offset)));
        push_bytes(&mut ir_path, view(".tir"));
        mut units = copy_bytes(view("ssair 1\n"));
        push_bytes(&mut units, view(ir_text));
        written := host::write_file(view(ir_path), view(units));
        if written != 0 {
            return written;
        }
    }
    if site_table_on(&c) {
        jobs::phase(view("optimised"));
        tabled := site_table(&mut c, view(out));
        jobs::phase(view("location-table"));
        out = tabled;
    }
    if c.plat == 1 {
        prefixed := darwinify(view(out));
        out = prefixed;
    }
    path := host::arg(1 + offset);
    target := c.target;
    // Stack probes for frames over a page. The LLVM backend probes the functions it lifts itself
    // (`probe-stack`); the native remainder it hands back is probed below. Windows probes after the
    // frame line, which its unwind description ends with.
    // With --split the parts are slices of this text at the offsets the optimiser recorded, so the
    // probes go into each part as it is written (write_parts) rather than here, where the lines they
    // add would move every later part's start.
    if (c.probes != 0) & (c.backend == 0) & (c.split == 0) {
        out = optimize::probe_frames(view(out), u64((target == 3) || (target == 4)));
    }
    if (target == 0) || (target == 3) {
        if target == 3 {
            // PE/COFF unwind data must be emitted from the final frame sizes.
            mut image = win_unwind(view(out));
            if c.debug != 0 {
                image = debug_locs(view(image));
                // CodeView: the symbol records (functions with their typed locals), one line table
                // per recorded function, then the file checksums and the string table they index;
                // lld-link /DEBUG builds the PDB from this section.
                mut index = u64[];
                types := codeview_types(&c, &mut index);
                push_bytes(&mut image, view(".section .debug$S,\"dr\"\n.p2align 2\n.long 4\n"));
                symbols := codeview_symbols(&c, &index);
                push_bytes(&mut image, view(symbols));
                for i in c.debug_funcs.len() {
                    push_bytes(&mut image, view(".cv_linetable "));
                    decimal(&mut image, i);
                    push_bytes(&mut image, view(", "));
                    fstart := c.debug_funcs[i].start;
                    fend := c.debug_funcs[i].end;
                    funit := c.debug_funcs[i].unit.copy();
                    dlabel(&mut image, view(funit), fstart);
                    push_bytes(&mut image, view(", "));
                    dlabel(&mut image, view(funit), fend);
                    image.push(10);
                }
                push_bytes(&mut image, view(".cv_filechecksums\n.cv_stringtable\n"));
                push_bytes(&mut image, view(types));
            }
            return write_image(&mut c, view(path), view(image));
        }
        if c.debug != 0 {
            out = debug_locs(view(out));
            sections := debug_sections(&c, view(host::arg(2 + offset)));
            for i in sections.len() {
                out.push(sections[i]);
            }
        }
        if c.backend != 0 {
            // LLVM IR for the lifted functions beside the native remainder: PATH.ll and PATH.
            lowered := llvm::lower(view(out), view("x86_64-unknown-linux-gnu"), &c.facts, c.verify_facts, c.range_facts);
            if lowered.error.len() != 0 {
                host::print(view(lowered.error));
                return 1;
            }
            mut ir_path = copy_bytes(view(path));
            push_bytes(&mut ir_path, view(".ll"));
            written := host::write_file(view(ir_path), view(lowered.ir));
            if written != 0 {
                return written;
            }
            mut native = lowered.native;
            if c.probes != 0 {
                native = optimize::probe_frames(view(native), 0);
            }
            return write_image(&mut c, view(path), view(native));
        }
        return write_image(&mut c, view(path), view(out));
    }
    if c.debug != 0 {
        // The .loc/.file directives pass through instruction selection unchanged; the DWARF
        // sections refer only to labels, so they are appended after lowering.
        out = debug_locs(view(out));
    }
    if c.backend != 0 {
        // LLVM IR (PATH.ll) for the lifted functions; the remainder goes through the usual
        // instruction selection, followed by the calling-convention thunks.
        lowered := llvm::lower_for(view(out), target, &c.facts, c.verify_facts, c.range_facts);
        if lowered.error.len() != 0 {
            host::print(view(lowered.error));
            return 1;
        }
        mut ir_path = copy_bytes(view(path));
        push_bytes(&mut ir_path, view(".ll"));
        written := host::write_file(view(ir_path), view(lowered.ir));
        if written != 0 {
            return written;
        }
        mut rest = lowered.native;
        if c.probes != 0 {
            rest = optimize::probe_frames(view(rest), u64(target == 4));
        }
        mut image = machine::lower(view(rest), target, c.plat);
        push_bytes(&mut image, view(lowered.thunks));
        return write_image(&mut c, view(path), view(image));
    }
    mut native = machine::lower(view(out), target, c.plat);
    if c.debug != 0 {
        sections := debug_sections(&c, view(host::arg(2 + offset)));
        for i in sections.len() {
            native.push(sections[i]);
        }
    }
    if target == 4 {
        image := arm_unwind(view(native));
        return write_image(&mut c, view(path), view(image));
    }
    return write_image(&mut c, view(path), view(native));
}
