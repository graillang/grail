    owner := private_module(view(".inherent_"), d);
    f := find_func(&mut c, view(owner), view("show"));
    if f == 0 {
        return val(0, 18446744073709551615);
    }
    info := &c.funcs[f - 1];
    first := info.first;
    count := info.count;
