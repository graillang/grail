        b = adopt_value(borrow_mut(c), b, vstart, vend, elem);
        bt := b.t;
        require_type(borrow_mut(c), b.ty, elem);
        target := place_of(borrow_mut(c), xt);
        source := place_of(borrow_mut(c), bt);
        check_writeback(borrow_mut(c), target, elem, source);
        require_write(borrow_mut(c), xt);
        move_out(borrow_mut(c), val(bt, b.ty));
