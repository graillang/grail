                        mark(&mut c, head);
                        o(&mut c, view("cmpq 8(%r12),%r13\n"));
                        jump(&mut c, view("jae"), end);
                        o(&mut c, view("movq (%r12),%rax\nmovq (%rax,%r13,8),%rdi\n"));
                        drop_call(&mut c, arg);
                        o(&mut c, view("incq %r13\n"));
                        jump(&mut c, view("jmp"), head);
                        mark(&mut c, end);
                    }
                    o(&mut c, view("movq %r12,%rdi\ncall rt_drop_seq\n"));
