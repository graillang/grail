        if found == 1 {
            source := place_of(&mut c, v.t);
            tag := imm(&mut c, which);
            slot := invoke(&mut c, view("rt_enum"), two(tag, v.t));
            own(&mut c, slot, expected);
            dest := place_of(&mut c, slot);
            transfer_bonds(&mut c, source, dest);
            move_out(&mut c, v);
            return val(slot, expected);
        }
    }
    if is_f32(&mut c, expected) {
        return adopt_float(&mut c, v, start, end, expected);
    }
    if !literal_target(&mut c, expected) {
        return v;
    }
    // A byte read (`bytes[i]`) is an untyped word in 0..255: it adopts any integer type that
    // holds 0..255 without a check, like a literal that fits.
    if (v.ty == 0) & (c.byte_start == start) & (c.byte_end == end) & (c.raw == 0) {
        if literal_fits(&mut c, expected, 255, 0) != 0 {
