fn func<a>(c:ref_mut<a,C>,pass:num,public:num)->unit {
 position :=c.pos;expect(borrow_mut(c),&"fn");mut name=ident(borrow_mut(c));lifetime_parameters(borrow_mut(c));
 if same(&name,&"print")+same(&name,&"println"){fail(borrow_mut(c),&"print and println are reserved prelude names");}
 typecount :=c.tnames.len();regioncount :=c.rnames.len();
 if (pass==3)&(typecount!=0){while kind(borrow_mut(c))!=123{advance(borrow_mut(c));}skip_braces(borrow_mut(c));return ();}
 if pass==1{while kind(borrow_mut(c))!=123{advance(borrow_mut(c));}skip_braces(borrow_mut(c));return ();}
 mut m=module_copy(borrow_mut(c));if c.current_impl{m=private_module(&".impl_",c.current_impl);}exchange(borrow_mut(c.locals),vec<Local>[]);exchange(borrow_mut(c.resources),vec<Resource>[]);exchange(borrow_mut(c.next),0);
 exchange(borrow_mut(c.scope_end),0);exchange(borrow_mut(c.loop_start),0);exchange(borrow_mut(c.loop_end),0);
 exchange(borrow_mut(c.check),ownership::new());exchange(borrow_mut(c.members),vec<Member>[]);exchange(borrow_mut(c.terminated),0);exchange(borrow_mut(c.bonds),vec<Bond>[]);exchange(borrow_mut(c.origins),vec<Origin>[]);
 first :=c.params.len();mut count=0;
 expect(borrow_mut(c),&"(");
