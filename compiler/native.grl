fn call_writebacks<a, b, d>(
    c: (&a mut C),
    first: u64,
    args: (&b u64[]),
    actuals: (&d u64[])
) -> unit {
    if c.raw != 0 {
        return ();
    }
    for i in args.len() {
        formal := c.params[first + i];
        k := ty_kind(&mut c, formal);
        mode := ty_mode(&mut c, formal);
