            fail(&mut c, view("callable argument arity mismatch"));
        }
        for i in fs.len() {
            f := fs[i];
            a := as[i];
            infer_type(&mut c, f, a, &mut map);
        }
        return ();
    }
    if k == 8 {
        aa := ty_arg(&mut c, actual);
        if arg != aa {
            fail(&mut c, view("generic nominal mismatch"));
        }
        fa := type_args(&mut c, formal);
        ax := type_args(&mut c, actual);
        if fa.len() != ax.len() {
            fail(&mut c, view("generic arity mismatch"));
        }
        for i in fa.len() {
            f := fa[i];
            a := ax[i];
            infer_type(&mut c, f, a, &mut map);
        }
        return ();
    }
    require_type(&mut c, actual, formal);
    return ();
}
fn infer_union_member<a, b>(
    c: (&a mut C),
    expected: u64,
    actual: u64,
    map: (&b mut u64[])
) -> unit {
    // Infer a bare value against a unique unbound union member.
    if is_union(&mut c, expected) & !is_union(&mut c, actual) {
        members := type_args(&mut c, expected);
        mut known = 0;
        mut candidates = 0;
        mut parameter = 0;
        for i in members.len() {
            member := members[i];
            kind := ty_kind(&mut c, member);
            if kind == 9 {
                idx := ty_arg(&mut c, member);
                bound := map[idx];
                if bound == NO_TYPE {
                    candidates += 1;
                    parameter = idx;
                } else {
                    if same_type(&mut c, bound, actual) != 0 {
                        known += 1;
                    }
                }
            } else {
                if concrete_type(&mut c, member) {
                    if same_type(&mut c, member, actual) != 0 {
                        known += 1;
                    }
                }
            }
        }
        if (known == 0) & (candidates == 1) {
            exchange(&mut map[parameter], actual);
        }
    }
    return ();
}
fn constructor_hint<a>(c: (&a mut C), decl: u64, explicit: u64) -> u64 {
    if explicit != NO_TYPE {
        return explicit;
    }
    result := c.result;
    // No `-> T` to read the type from: `c.result` is unknown where nothing is being returned
    // (a top-level statement, and every expression compiled in isolation for inference).
    if result != 18446744073709551615 {
        if ty_kind(&mut c, result) == 8 {
            if ty_arg(&mut c, result) == decl {
                return result;
            }
        }
    }
    return NO_TYPE;
}
fn constructor_map<a>(c: (&a mut C), decl: u64, hint: u64) -> u64[] {
    d := &c.decls[decl];
    count := d.types;
    mut map = u64[];
    if hint != NO_TYPE {
        return type_args(&mut c, hint);
    }
    for i in count {
        map.push(NO_TYPE);
    }
    return map;
}
fn constructed_type<a>(c: (&a mut C), decl: u64, hint: u64, map: u64[]) -> u64 {
    for i in map.len() {
        if map[i] == NO_TYPE {
            fail(&mut c, view("cannot infer generic type argument"));
        }
    }
    mut rs = u64[];
    if hint != NO_TYPE {
        regions := type_regions(&mut c, hint);
        for i in regions.len() {
            rs.push(regions[i]);
        }
    }
    require_constraints(&mut c, &map, &declaration_bounds(&c, decl));
    require_interfaces(&mut c, &map, &declaration_constraints(&c, decl));
    return intern_args(&mut c, 8, decl, 0, rs, map);
}
// Record member names.
fn member_name<a>(c: (&a mut C)) -> u8[] {
    if kind(&mut c) == 64 {
        // `x.@f`: the field an `@for` binding names.
        advance(&mut c);
        n := ident(&mut c);
        b := ct_loop_binding(&mut c, view(n));
        if b == 0 {
            fail(&mut c, view("x.@f needs a field from an enclosing @for f in fields(T)"));
        }
        return ct_loop_field_name(&mut c, b);
    }
    if kind(&mut c) == 2 {
        t := tok_text(&mut c, c.pos);
        advance(&mut c);
        return t.copy();
    }
    return ident(&mut c);
}
// name ':' type ('=' | ':=') ... ; scans to the end of the statement for an initializer.
fn typed_binding_ahead<a>(c: (&a mut C)) -> bool {
    return typed_binding_ahead_at(&mut c, c.pos);
}
fn typed_binding_ahead_at<a>(c: (&a mut C), name_pos: u64) -> bool {
    if kind_at(&mut c, name_pos + 1) != 58 {
        return false;
    }
    mut i = name_pos + 2;
    mut depth = 0;
    while true {
        k := kind_at(&mut c, i);
        if k == 0 {
            return false;
        }
        if (k == 60) || (k == 40) || (k == 91) {
            depth += 1;
        }
        if (k == 62) || (k == 41) || (k == 93) {
            if depth == 0 {
                return false;
            }
            depth -= 1;
        }
        if depth == 0 {
            if (k == 61) || (k == 261) {
                return true;
            }
            if (k == 59) || (k == 123) || (k == 125) {
                return false;
            }
        }
        i += 1;
    }
    return false;
}
// Returns a slot holding 1 when the two values of type ty are structurally equal.
fn structural_eq<a>(c: (&a mut C), x: u64, y: u64, ty: u64, depth: u64) -> u64 {
    if 16 < depth {
        fail(&mut c, view("structural equality nests too deeply"));
    }
    k := ty_kind(&mut c, ty);
    // A handle is one opaque word: equality is a word compare, and it is the only operator the
    // type has (no ordering, no arithmetic, no size). A field of handle type compares the same way.
    if (ty == 0) || (k == 18) || (k == 19) || (k == 22) || (k == 23) {
        get(&mut c, y, view("%rcx"));
        get(&mut c, x, view("%rax"));
        o(&mut c, view("cmpq %rcx,%rax\nsete %al\nmovzbq %al,%rax\n"));
        return save(&mut c);
    }
    if k == 32 {
        return array_eq(&mut c, x, y, ty, depth);
    }
    op := imm(&mut c, 258);
    if k == 21 {
        return float_cmp_call(&mut c, 258, op, x, y);
    }
    if (k == 3) || (k == 4) || (k == 5) {
        return invoke(&mut c, view("rt_seq_cmp"), three(op, x, y));
    }
    if (k == 6) || (k == 27) {
        e := ty_arg(&mut c, ty);
        ek := ty_kind(&mut c, e);
        if (e == 0) || (ek == 18) || (ek == 19) || (ek == 22) {
            if narrow_code(&mut c, e) != 0 {
                return invoke(&mut c, view("rt_vec_cmp4"), three(op, x, y));
            }
            return invoke(&mut c, view("rt_vec_cmp"), three(op, x, y));
        }
        if ek == 21 {
            // Floats compare by value (IEEE: -0.0 == 0.0, NaN is unequal to everything).
            code := narrow_code(&mut c, e);
            narrow := imm(&mut c, code != 0);
            return invoke(&mut c, view("rt_vec_feq"), three(x, y, narrow));
        }
    }
    if k == 8 {
        d := ty_arg(&mut c, ty);
        decl := &c.decls[d];
        count := decl.count;
        enum_decl := decl.is_enum;
        if enum_decl == 0 {
            mut acc = imm(&mut c, 1);
            for i in count {
                fty := field_type(&mut c, ty, i);
                mut a = 0;
                mut b = 0;
                if c.decls[d].c_layout != 0 {
                    a = cfield_load(&mut c, x, d, i, 0);
                    alias_field(&mut c, a, fty, x, i, 1);
                    observe(&mut c, a);
                    b = cfield_load(&mut c, y, d, i, 0);
                } else {
                    a = field_load(&mut c, x, ty, i, 0);
                    alias_field(&mut c, a, fty, x, i, 1);
                    observe(&mut c, a);
                    b = field_load(&mut c, y, ty, i, 0);
                }
                alias_field(&mut c, b, fty, y, i, 1);
                observe(&mut c, b);
                sub := structural_eq(&mut c, a, b, fty, depth + 1);
                release_temporary(&mut c, a);
                release_temporary(&mut c, b);
                get(&mut c, sub, view("%rcx"));
                get(&mut c, acc, view("%rax"));
                o(&mut c, view("andq %rcx,%rax\n"));
                acc = save(&mut c);
            }
            return acc;
        }
        // enums: equal tags, then equal payloads of that variant
        result := imm(&mut c, 0);
        done := label(&mut c);
        ta := rec_load(&mut c, x, 0, 0);
        tb := rec_load(&mut c, y, 0, 0);
        get(&mut c, tb, view("%rcx"));
        get(&mut c, ta, view("%rax"));
        o(&mut c, view("cmpq %rcx,%rax\n"));
        jump(&mut c, view("jne"), done);
        for i in count {
            pty := field_type(&mut c, ty, i);
            next := label(&mut c);
            o(&mut c, view("movabsq $"));
            on(&mut c, i);
            o(&mut c, view(",%rcx\n"));
            get(&mut c, ta, view("%rax"));
            o(&mut c, view("cmpq %rcx,%rax\n"));
            jump(&mut c, view("jne"), next);
            mut sub = 0;
            if pty == 1 {
                sub = imm(&mut c, 1);
            } else {
                a := payload_load(&mut c, x, ty, pty);
                alias_field(&mut c, a, pty, x, 1, 1);
                observe(&mut c, a);
                b := payload_load(&mut c, y, ty, pty);
                alias_field(&mut c, b, pty, y, 1, 1);
                observe(&mut c, b);
                sub = structural_eq(&mut c, a, b, pty, depth + 1);
                release_temporary(&mut c, a);
                release_temporary(&mut c, b);
            }
            get(&mut c, sub, view("%rax"));
            o(&mut c, view("movq %rax,"));
            stack_slot(&mut c, result);
            c.out.push(10);
            jump(&mut c, view("jmp"), done);
            mark(&mut c, next);
        }
        mark(&mut c, done);
        return result;
    }
    fail(
        &mut c,
        view("== needs numbers, bool, char, floats, text, records or vectors and slices of scalars")
    );
    return 0;
}
// A reference to bytes/string passed where a view (&a [u8]) is expected becomes a view of the same
// storage (like Rust's &String -> &str); the view keeps the reference's borrow alive.
fn coerce_view<a>(c: (&a mut C), v: Val, formal: u64) -> Val {
    if is_type_id(formal) && (ty_kind(&mut c, v.ty) == 7) && is_array(&mut c, ty_arg(&mut c, v.ty)) {
        return array_to_slice(&mut c, v, formal);
    }
    // `&v` / `&mut v` of a vector passed for a typed slice `&[T]` / `&mut [T]`: the slice over the
    // whole vector, borrowing it as `&v[:]` would (docs/design/typed-slices.md).
    if (ty_kind(&mut c, formal) == 27) && (ty_kind(&mut c, v.ty) == 7) {
        inner := ty_arg(&mut c, v.ty);
        if ty_kind(&mut c, inner) == 6 {
            write := ty_mode(&mut c, formal) != 0;
            if write && (ty_mode(&mut c, v.ty) == 0) {
                fail(&mut c, view("a mutable slice needs a mutable reference: write `&mut v`"));
            }
            x := deref(&mut c, v);
            return whole_slice(&mut c, x, write);
        }
    }
    if ty_kind(&mut c, formal) != 5 {
        return v;
    }
    mode := ty_mode(&mut c, formal);
    if ty_kind(&mut c, v.ty) == 7 {
        if mode != 0 && ty_mode(&mut c, v.ty) == 0 {
            fail(&mut c, view("mutable view requires a mutable reference"));
        }
        inner := ty_arg(&mut c, v.ty);
        ik := ty_kind(&mut c, inner);
        if (ik != 2) & (ik != 3) & (ik != 4) & (ik != 5) {
            return v;
        }
        if mode != 0 && ik == 4 {
            fail(&mut c, view("string bytes cannot be mutably viewed"));
        }
        x := deref(&mut c, v);
        vty := intern_full(&mut c, 5, 0, mode, u64[]);
        slot := apply(&mut c, view("rt_view"), one(x.t));
        own(&mut c, slot, vty);
        view_bonds(&mut c, slot, x.t, mode, false);
        return val(slot, vty);
    }
    // Direct owned byte/text arguments may be viewed for an immutable view parameter.
    if mode == 0 {
        k := ty_kind(&mut c, v.ty);
        if (k == 2) || (k == 3) || (k == 4) {
            vty := intern_full(&mut c, 5, 0, 0, u64[]);
            slot := apply(&mut c, view("rt_view"), one(v.t));
            own(&mut c, slot, vty);
            view_bonds(&mut c, slot, v.t, 0, false);
            return val(slot, vty);
        }
    }
    return v;
}
// Whether a value is byte text: a byte vector, a string, a borrowed byte sequence or a view. These
// are the receivers an `impl [u8]` serves, since a view of them is what such a method reads.
fn byte_sequence_value<a>(c: (&a mut C), ty: u64) -> bool {
    mut k = ty_kind(&mut c, ty);
    if k == 7 {
        k = ty_kind(&mut c, ty_arg(&mut c, ty));
    }
    return (k == 2) || (k == 3) || (k == 4);
}
fn view_type_of<a>(c: (&a mut C)) -> u64 {
    return intern_full(&mut c, 5, 0, 0, u64[]);
}
// A byte view handed to a `&[u8]` method receiver is reborrowed for the call: the same storage and
// length as a fresh value whose loan is the one the receiver already holds, so the binding is still
// usable afterwards. `rt_vslice` over the whole view is that reborrow.
fn reborrow_view<a>(c: (&a mut C), v: Val, formal: u64) -> Val {
    mode := ty_mode(&mut c, formal);
    length := apply(&mut c, view("rt_len"), one(v.t));
    mut args = u64[];
    args.push(v.t);
    args.push(imm(&mut c, 0));
    args.push(length);
    args.push(imm(&mut c, 1));
    slot := invoke(&mut c, view("rt_vslice"), args);
    vty := intern_full(&mut c, 5, 0, mode, u64[]);
    own(&mut c, slot, vty);
    view_bonds(&mut c, slot, v.t, mode, false);
    return val(slot, vty);
}
// ---- Fixed-size arrays (docs/design/fixed-arrays.md) ----
// `[T; N]` is N elements of T back to back, in C layout. An array value is the address of its bytes,
// so `&a` and `&mut a` are that same word (`direct`). Its bytes live in the frame: one aggregate of
// adjacent slots per site that makes an array (a literal, a copy), declared to the optimiser and the
// LLVM lifter by the frame-aggregate fact. Binding, moving and assigning copy the bytes into the
// destination's own storage, so two names never share storage and a later write to one cannot be
// seen through the other.
fn is_array<a>(c: (&a mut C), ty: u64) -> bool {
    if (ty == 0) || !is_type_id(ty) || (c.raw != 0) {
        return false;
    }
    return ty_kind(&mut c, base_type(&mut c, ty)) == 32;
}
// An array whose length is a value parameter not bound yet (a generic template's): its length is
// unknown, so nothing that depends on it is judged until the specialisation.
fn array_parametric<a>(c: (&a mut C), ty: u64) -> bool {
    return is_array(&mut c, ty) && (type_args(&mut c, base_type(&mut c, ty)).len() != 0);
}
fn array_len<a>(c: (&a mut C), ty: u64) -> u64 {
    return ty_mode(&mut c, base_type(&mut c, ty));
}
fn array_elem<a>(c: (&a mut C), ty: u64) -> u64 {
    return ty_arg(&mut c, base_type(&mut c, ty));
}
// The bytes one element of this type takes in an array, or 0 for an element type an array does not
// hold yet (owned values, records and references come with later stages).
fn array_elem_bytes<a>(c: (&a mut C), alias: u64) -> u64 {
    if alias == 0 {
        return 8;
    }
    ty := base_type(&mut c, alias);
    if ty == 0 {
        return 8;
    }
    k := ty_kind(&mut c, ty);
    if k == 32 {
        return array_elem_bytes(&mut c, ty_arg(&mut c, ty)) * ty_mode(&mut c, ty);
    }
    if k == 1 {
        return 8;
    }
    if k == 18 {
        return ty_arg(&mut c, ty) / 8;
    }
    if k == 21 {
        if is_f32(&mut c, ty) {
            return 4;
        }
        return 8;
    }
    // A handle, a CStr or a CPtr: one word.
    if (k == 23) || (k == 24) || (k == 26) {
        return 8;
    }
    if is_c_record(&mut c, ty) != 0 {
        return ffi_record_size(&mut c, ty_arg(&mut c, ty));
    }
    if framable(&mut c, ty) {
        return record_words(&mut c, ty) * 8;
    }
    if (k == 19) || (k == 22) {
        return 8;
    }
    // An owner - bytes, a string, a vector, a record that owns data, an enum or an option - is the
    // one word that owns it.
    if (k == 3) || (k == 4) || (k == 6) || (k == 8) {
        return 8;
    }
    return 0;
}
// Whether the array's elements own something: such an array moves, drops its elements, and holds
// them as one word each.
fn array_owned<a>(c: (&a mut C), ty: u64) -> bool {
    return is_array(&mut c, ty) && needs_drop(&mut c, array_elem(&mut c, ty));
}
// An element `a[i]` reads as a value: a number, a bool, a char or a C word. Anything else -
// an owner, a record, an array - is reached through its place.
fn array_read_elem<a>(c: (&a mut C), elem: u64) -> bool {
    if is_array(&mut c, elem) || array_record_elem(&mut c, elem) || needs_drop(&mut c, elem) {
        return false;
    }
    return true;
}
// A record element (an extern record's C bytes or a plain record's words): stored and read as its
// bytes, reached through its address.
fn array_record_elem<a>(c: (&a mut C), elem: u64) -> bool {
    ty := base_type(&mut c, elem);
    return (ty != 0) && (ty_kind(&mut c, ty) == 8) && ((is_c_record(&mut c, ty) != 0) || framable(&mut c, ty));
}
// An element read as its value by `a[i]`: a number, a bool-free scalar, or a C word.
fn array_scalar_elem<a>(c: (&a mut C), elem: u64) -> bool {
    if is_array(&mut c, elem) || array_record_elem(&mut c, elem) {
        return false;
    }
    return true;
}
fn array_bytes<a>(c: (&a mut C), ty: u64) -> u64 {
    return array_elem_bytes(&mut c, array_elem(&mut c, ty)) * array_len(&mut c, ty);
}
// The owner's copy rule: an array of plain data copies implicitly when it is at most four words;
// a larger one moves, and `.copy()` copies it.
fn array_moves<a>(c: (&a mut C), ty: u64) -> bool {
    if !is_array(&mut c, ty) {
        return false;
    }
    return (32 < array_bytes(&mut c, ty)) || needs_drop(&mut c, array_elem(&mut c, ty));
}
// A value that is moved rather than copied but owns nothing to drop: an exclusive reference, or an
// array larger than the copy rule's four words.
// Whether a value of `ty` moves rather than copies - the checker's question (member_place, own,
// move_out and every place that decides between a move and a copy). `needs_drop` is the emitters'
// question: whether there is anything to drop or free. Today the two agree but for exclusive
// references and arrays over the copy rule's four words, which move and drop nothing; stage 4 of
// unboxed-values.md keeps records with owned fields inline, and there the two part further.
fn affine<a>(c: (&a mut C), ty: u64) -> bool {
    return needs_drop(&mut c, ty) || affine_nodrop(&mut c, ty);
}
fn affine_nodrop<a>(c: (&a mut C), ty: u64) -> bool {
    if c.raw != 0 {
        return false;
    }
    return (ty_kind(&mut c, ty) == 7) || (array_moves(&mut c, ty) && !needs_drop(&mut c, ty));
}
// The frame of the function just compiled: larger than a page, the output gets stack probes, so the
// frame is touched a page at a time from the top and can never step over a stack's guard page; larger
// than the 1 MiB stack a task runs on, it is refused, at the largest array in it.
fn frame_limit<a>(c: (&a mut C)) -> unit {
    bytes := (c.next + 1) / 2 * 16;
    // Within 128 bytes of a page: the saved-register area the frame line adds can carry it over,
    // so the probe pass (and its backstop, optimize::probe_backstop) looks at this output.
    if 4096 < bytes + 128 {
        exchange(&mut c.probes, 1);
    }
    if (1048576 < bytes) & (c.validating == 0) {
        if c.array_big_at != 0 {
            exchange(&mut c.pos, c.array_big_at);
        }
        mut msg = copy_bytes(view("this function's frame is "));
        decimal(&mut msg, bytes);
        push_bytes(&mut msg, view(" bytes, more than the 1 MiB stack a task runs on"));
        diag_help(&mut c, view("keep a large array in a vector (`f64[0.0; n]`) or a static"));
        fail(&mut c, view(msg));
    }
    return ();
}
// What this stage of arrays does not do yet, named for the user (docs/design/fixed-arrays.md, A2/A3).
fn array_stage_fail<a, b>(c: (&a mut C), what: &b [u8]) -> unit {
    mut msg = copy_bytes(view("an array as "));
    push_bytes(&mut msg, what);
    push_bytes(&mut msg, view(" is not supported yet: arrays live in locals and are passed as `&[T; N]` / `&mut [T; N]`"));
    fail(&mut c, view(msg));
    return ();
}
fn array_check<a>(c: (&a mut C), ty: u64) -> unit {
    if array_elem_bytes(&mut c, array_elem(&mut c, ty)) == 0 {
        mut msg = copy_bytes(view("`"));
        push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
        push_bytes(&mut msg, view("`: an array element is a number, a C handle or pointer, a plain or extern record, or another array"));
        fail(&mut c, view(msg));
    }
    return ();
}
// Fresh frame storage for one array of type `ty`, as one aggregate fact: the slot returned holds
// its address. Word 0 is the last slot allocated (the lowest address), word j is `word0 - j`.
fn array_storage<a>(c: (&a mut C), ty: u64) -> u64 {
    array_check(&mut c, ty);
    words := (array_bytes(&mut c, ty) + 7) / 8;
    mut first = 0;
    for i in words {
        first = fresh(&mut c);
    }
    if c.facts_fn.len() != 0 {
        llvm::fact_aggregate(&mut c.facts, copy_bytes(view(c.facts_fn)), first, words);
    }
    if c.array_big < words * 8 {
        exchange(&mut c.array_big, words * 8);
        exchange(&mut c.array_big_at, c.pos);
    }
    o(&mut c, view("leaq "));
    stack_slot(&mut c, first);
    o(&mut c, view(",%rax\n"));
    return save(&mut c);
}
// Copies `bytes` bytes from the address in `src` to the address in `dst`: in line up to 64 bytes
// of whole 4-byte units, otherwise the runtime's loop.
fn array_copy<a>(c: (&a mut C), dst: u64, src: u64, bytes: u64) -> unit {
    if (bytes % 4 != 0) || (64 < bytes) {
        n := imm(&mut c, bytes);
        invoke(&mut c, view("rt_copy_bytes"), three(dst, src, n));
        return ();
    }
    get(&mut c, src, view("%rcx"));
    get(&mut c, dst, view("%rdx"));
    mut k = 0;
    while k + 8 <= bytes {
        o(&mut c, view("movq "));
        on(&mut c, k);
        o(&mut c, view("(%rcx),%rax\nmovq %rax,"));
        on(&mut c, k);
        o(&mut c, view("(%rdx)\n"));
        k += 8;
    }
    if k < bytes {
        o(&mut c, view("movl "));
        on(&mut c, k);
        o(&mut c, view("(%rcx),%eax\nmovl %eax,"));
        on(&mut c, k);
        o(&mut c, view("(%rdx)\n"));
    }
    return ();
}
// A copy of the array at `src` in fresh storage of its own.
fn array_fresh_copy<a>(c: (&a mut C), src: u64, ty: u64) -> u64 {
    dst := array_storage(&mut c, ty);
    array_copy(&mut c, dst, src, array_bytes(&mut c, ty));
    return dst;
}
// A new binding takes the storage of a value nothing else holds - a literal, a `.copy()` - rather
// than copying it: the binding's scope ends before the site that made the storage can run again.
// Anything else (a binding, an element, an assignment's target) gets a copy (move_value).
fn bind_value<a>(c: (&a mut C), v: Val, ty: u64) -> Val {
    // An array that owns its elements is bound as any owner is: the binding gets an owner record of
    // its own (move_value), so its scope's end drops the elements.
    if is_array(&mut c, ty) && !needs_drop(&mut c, ty) {
        for i in c.array_fresh.len() {
            if c.array_fresh[i] == v.t {
                c.array_fresh[i] = 0;
                return val(v.t, ty);
            }
        }
    }
    return move_value(&mut c, val(v.t, ty));
}
// The address `off` bytes past the address in `base`, inside the same array: through
// `rt_aslotu`, so the LLVM lifter keeps it a `getelementptr` on the array's own storage.
fn array_offset<a>(c: (&a mut C), base: u64, off: u64) -> u64 {
    if off == 0 {
        get(&mut c, base, view("%rax"));
        return save(&mut c);
    }
    return invoke(&mut c, view("rt_aslotu"), three(base, imm(&mut c, off), imm(&mut c, 1)));
}
// The address of element `index` (a slot) of the array `ty` whose address is in `base`. A proved
// index is plain arithmetic; any other is checked by one compare against the constant N - nothing
// is loaded to learn the length - in `rt_aslot`, which the optimiser writes in line and the LLVM
// lifter turns into a compare and a `getelementptr`.
fn array_element<a>(c: (&a mut C), base: u64, index: u64, ty: u64, proved: bool) -> u64 {
    n := array_len(&mut c, ty);
    w := array_elem_bytes(&mut c, array_elem(&mut c, ty));
    if !proved {
        mut args = two(base, index);
        args.push(imm(&mut c, n));
        args.push(imm(&mut c, w));
        return invoke(&mut c, view("rt_aslot"), args);
    }
    return invoke(&mut c, view("rt_aslotu"), three(base, index, imm(&mut c, w)));
}
// Marks an element address whose storage is narrower than a word (or an f32), so loads and stores
// through it are sized (caddr_load / caddr_store, as for a C field).
fn array_mark<a>(c: (&a mut C), addr: u64, elem: u64) -> unit {
    if subword(&mut c, elem) {
        c.caddr.push(addr);
        c.caddr.push(base_type(&mut c, elem));
    }
    return ();
}
// Writes `value` (a Grail value of type `elem`) into the element storage at the address in `addr`.
fn array_store_elem<a>(c: (&a mut C), addr: u64, elem: u64, value: Val) -> unit {
    if is_array(&mut c, elem) {
        array_copy(&mut c, addr, value.t, array_bytes(&mut c, elem));
        if array_moves(&mut c, elem) {
            move_out(&mut c, value);
        }
        return ();
    }
    if array_record_elem(&mut c, elem) {
        // The record's bytes are copied in and the record it was is used up (its box freed).
        move_out(&mut c, val(value.t, value.ty));
        if is_c_record(&mut c, elem) != 0 {
            caddr_store(&mut c, addr, base_type(&mut c, elem), value.t);
        } else {
            copy_into(&mut c, addr, value.t, elem);
        }
        return ();
    }
    if subword(&mut c, elem) {
        caddr_store(&mut c, addr, base_type(&mut c, elem), value.t);
        return ();
    }
    if needs_drop(&mut c, elem) {
        // The element's owner moves into the array.
        move_out(&mut c, val(value.t, value.ty));
    }
    get(&mut c, value.t, view("%rax"));
    get(&mut c, addr, view("%rcx"));
    o(&mut c, view("movq %rax,(%rcx)\n"));
    return ();
}
// The value of the element at the address in `addr`, for a scalar element.
fn array_load_elem<a>(c: (&a mut C), addr: u64, elem: u64) -> u64 {
    if subword(&mut c, elem) {
        return caddr_load(&mut c, addr, base_type(&mut c, elem));
    }
    get(&mut c, addr, view("%rax"));
    o(&mut c, view("movq (%rax),%rax\n"));
    return save(&mut c);
}
// `[a, b, c]` or `[x; N]` where an array `ty` is expected: every element is given, so an array is
// full from the moment it exists. The count is checked here, while compiling.
fn array_literal<a>(c: (&a mut C), ty: u64) -> Val {
    expect(&mut c, view("["));
    n := array_len(&mut c, ty);
    elem := array_elem(&mut c, ty);
    store := array_storage(&mut c, ty);
    w := array_elem_bytes(&mut c, elem);
    if is(&mut c, view("]")) {
        fail(&mut c, view("an array starts full: give its elements, or one element repeated (`[0; N]`)"));
    }
    mut count = 0;
    while true {
        estart := c.pos;
        mut v = expr_expected(&mut c, 0, elem);
        v = adopt_value(&mut c, v, estart, c.pos, elem);
        require_type(&mut c, v.ty, elem);
        if (count == 0) & is(&mut c, view(";")) {
            if needs_drop(&mut c, elem) {
                fail(&mut c, view("a repeated element must be a plain value; give each owned element"));
            }
            advance(&mut c);
            r := ct_expr(&mut c, 0);
            if ((r.ty != 0) || (r.value != n)) && !array_parametric(&mut c, ty) && (c.ct_unbound == 0) {
                mut msg = copy_bytes(view("this repeat makes "));
                decimal(&mut msg, r.value);
                push_bytes(&mut msg, view(" elements, and `"));
                push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
                push_bytes(&mut msg, view("` holds "));
                decimal(&mut msg, n);
                fail(&mut c, view(msg));
            }
            expect(&mut c, view("]"));
            array_store_elem(&mut c, store, elem, v);
            if 1 < n {
                mut args = one(store);
                args.push(imm(&mut c, w));
                args.push(imm(&mut c, n));
                invoke(&mut c, view("rt_array_rep"), args);
            }
            c.array_fresh.push(store);
            return own(&mut c, store, ty);
        }
        if count < n {
            at := array_offset(&mut c, store, count * w);
            array_store_elem(&mut c, at, elem, v);
        }
        count += 1;
        if !eat(&mut c, view(",")) {
            break;
        }
        if is(&mut c, view("]")) {
            break;
        }
    }
    expect(&mut c, view("]"));
    if (count != n) && !array_parametric(&mut c, ty) {
        mut msg = copy_bytes(view("this literal has "));
        decimal(&mut msg, count);
        push_bytes(&mut msg, view(" elements, and `"));
        push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
        push_bytes(&mut msg, view("` holds "));
        decimal(&mut msg, n);
        fail(&mut c, view(msg));
    }
    c.array_fresh.push(store);
    return own(&mut c, store, ty);
}
// Whether the facts prove the index spelled by tokens `lo..hi` is below the array's length: the
// constant N, or `a.len` when the array is the local `a` (what `for i in a.len()` states).
fn array_index_proved<a, b>(c: (&a mut C), lo: u64, hi: u64, n: u64, base: &b [u8]) -> bool {
    if !pv_ir_live(&c) || (hi <= lo) {
        return false;
    }
    term := pv_span_term(&mut c, lo, hi);
    if term.len() == 0 {
        return false;
    }
    mut facts = Atom[];
    pv_ir_read(&mut c, &mut facts);
    mut bound = u8[];
    decimal(&mut bound, n);
    if pv_holds(&facts, 0, view(term), view(bound), 0) {
        return true;
    }
    if base.len() != 0 {
        mut len_term = copy_bytes(base);
        push_bytes(&mut len_term, view(".len"));
        return pv_holds(&facts, 0, view(term), view(len_term), 0);
    }
    return false;
}
// `a[i]` on an array (or through `&[T; N]`), after its `[`: the element's place, borrowed from the
// array as an element of a vector is. A scalar read is its value.
fn array_index<a>(c: (&a mut C), value: Val, x: Val, access: u64, base_name: u8[]) -> Val {
    xt := x.t;
    xty := x.ty;
    n := array_len(&mut c, xty);
    elem := array_elem(&mut c, xty);
    w := array_elem_bytes(&mut c, elem);
    bstart := c.pos;
    // A literal index is checked against N here, while compiling, and costs nothing at run time.
    mut literal = 0;
    mut konst = 0;
    if (kind(&mut c) == 2) & (kind_at(&mut c, bstart + 1) == 93) {
        literal = 1;
        konst = literal_value(&mut c, view(tok_text(&mut c, bstart)));
        if (n <= konst) && !array_parametric(&mut c, xty) {
            mut msg = copy_bytes(view("index "));
            decimal(&mut msg, konst);
            push_bytes(&mut msg, view(" is out of bounds for `"));
            push_bytes(&mut msg, view(source_type_name(&mut c, xty)));
            push_bytes(&mut msg, view("`"));
            fail(&mut c, view(msg));
        }
    }
    mut bound = expr(&mut c, 0);
    bend := c.pos;
    bound = adopt_value(&mut c, bound, bstart, bend, 0);
    expect(&mut c, view("]"));
    refuse_span_index(&mut c, bound.ty);
    require_type(&mut c, bound.ty, 0);
    if access == 2 {
        if (ty_kind(&mut c, value.ty) == 7) & (ty_mode(&mut c, value.ty) == 0) {
            fail(&mut c, view("writing an element needs a mutable array reference (&mut [T; N])"));
        }
        require_mutable_binding(&mut c, xt, 0);
    }
    mut slot = 0;
    if literal != 0 {
        slot = array_offset(&mut c, xt, konst * w);
    } else {
        proved := array_index_proved(&mut c, bstart, bend, n, view(base_name));
        slot = array_element(&mut c, xt, bound.t, xty, proved);
    }
    array_mark(&mut c, slot, elem);
    // A boxed record held as an owning word is reached by its own address, as in a vector.
    if !array_record_elem(&mut c, elem) && !is_array(&mut c, elem) {
        slot = word_reference(&mut c, slot, elem);
    }
    ty := reference_type(&mut c, elem, access == 2);
    root := place_of(&mut c, xt);
    target := member_place(&mut c, root, 0, elem);
    own(&mut c, slot, ty);
    bind_loan(&mut c, slot, xt, root, access == 2);
    set_target(&mut c, slot, target, slot + 1);
    if (access == 0) & array_read_elem(&mut c, elem) {
        result := array_load_elem(&mut c, slot, elem);
        release_temporary(&mut c, slot);
        return val(result, elem);
    }
    return val(slot, ty);
}
// `a == b` on two arrays of one type: every element equal by its own `==` (floats as IEEE), a loop
// to the constant N. The bytes are never compared as bytes, so padding and -0.0 mean nothing.
fn array_eq<a>(c: (&a mut C), x: u64, y: u64, ty: u64, depth: u64) -> u64 {
    elem := array_elem(&mut c, ty);
    w := array_elem_bytes(&mut c, elem);
    n := array_len(&mut c, ty);
    acc := imm(&mut c, 1);
    i := imm(&mut c, 0);
    head := label(&mut c);
    end := label(&mut c);
    mark(&mut c, head);
    get(&mut c, i, view("%rax"));
    o(&mut c, view("cmpq $"));
    on(&mut c, n);
    o(&mut c, view(",%rax\n"));
    jump(&mut c, view("jae"), end);
    ax := invoke(&mut c, view("rt_aslotu"), three(x, i, imm(&mut c, w)));
    bx := invoke(&mut c, view("rt_aslotu"), three(y, i, imm(&mut c, w)));
    mut a = ax;
    mut b = bx;
    if !is_array(&mut c, elem) && !array_record_elem(&mut c, elem) {
        a = array_load_elem(&mut c, ax, elem);
        b = array_load_elem(&mut c, bx, elem);
    }
    sub := structural_eq(&mut c, a, b, base_type(&mut c, elem), depth + 1);
    get(&mut c, sub, view("%rcx"));
    get(&mut c, acc, view("%rax"));
    o(&mut c, view("andq %rcx,%rax\nmovq %rax,"));
    stack_slot(&mut c, acc);
    o(&mut c, view("\n"));
    get(&mut c, i, view("%rax"));
    o(&mut c, view("addq $1,%rax\nmovq %rax,"));
    stack_slot(&mut c, i);
    o(&mut c, view("\n"));
    jump(&mut c, view("jmp"), head);
    mark(&mut c, end);
    return acc;
}
// An array's text, `[1, 2, 3]` as a vector's: element 0, then `, ` and each next one, in a loop to
// the constant N.
fn array_text<a>(c: (&a mut C), acc: u64, x: u64, ty: u64, depth: u64) -> unit {
    elem := array_elem(&mut c, ty);
    w := array_elem_bytes(&mut c, elem);
    n := array_len(&mut c, ty);
    code := element_code(&mut c, elem);
    format_raw(&mut c, acc, view("["));
    i := imm(&mut c, 0);
    head := label(&mut c);
    first := label(&mut c);
    end := label(&mut c);
    mark(&mut c, head);
    get(&mut c, i, view("%rax"));
    o(&mut c, view("cmpq $"));
    on(&mut c, n);
    o(&mut c, view(",%rax\n"));
    jump(&mut c, view("jae"), end);
    o(&mut c, view("testq %rax,%rax\n"));
    jump(&mut c, view("jz"), first);
    format_raw(&mut c, acc, view(", "));
    mark(&mut c, first);
    at := invoke(&mut c, view("rt_aslotu"), three(x, i, imm(&mut c, w)));
    if is_array(&mut c, elem) {
        array_text(&mut c, acc, at, base_type(&mut c, elem), depth + 1);
    } else if array_record_elem(&mut c, elem) {
        record_text(&mut c, acc, at, base_type(&mut c, elem), depth + 1);
    } else {
        part := array_load_elem(&mut c, at, elem);
        if code != 0 {
            cv := imm(&mut c, code);
            invoke(&mut c, view("rt_fmt_value"), three(acc, part, cv));
        }
    }
    get(&mut c, i, view("%rax"));
    o(&mut c, view("addq $1,%rax\nmovq %rax,"));
    stack_slot(&mut c, i);
    o(&mut c, view("\n"));
    jump(&mut c, view("jmp"), head);
    mark(&mut c, end);
    format_raw(&mut c, acc, view("]"));
    return ();
}
// An element a vector runtime function handed back boxed, as an array: its bytes go into frame
// storage of their own and the box is freed. Anything else is the box itself.
fn array_unbox<a>(c: (&a mut C), boxed: u64, ty: u64) -> u64 {
    if !is_array(&mut c, ty) {
        return boxed;
    }
    copy := array_fresh_copy(&mut c, boxed, ty);
    invoke(&mut c, view("rt_free"), one(boxed));
    c.array_fresh.push(copy);
    return copy;
}
// The slice of all N elements of the array at `xt`: `&[T]` (`&[u8]` for bytes), exclusive when
// `mode` is 1, borrowing the array for as long as the slice lives. Until views are pairs in the frame
// (unboxed-values.md, stage 2) the slice is a view record on the heap, made here: one allocation, so
// a hot path takes `&[T; N]` instead.
fn array_view<a>(c: (&a mut C), xt: u64, xty: u64, mode: u64) -> Val {
    elem := array_elem(&mut c, xty);
    mut args = two(xt, imm(&mut c, 0));
    args.push(imm(&mut c, array_len(&mut c, xty)));
    args.push(imm(&mut c, array_elem_bytes(&mut c, elem)));
    args.push(imm(&mut c, array_len(&mut c, xty)));
    slot := invoke(&mut c, view("rt_aslice"), args);
    return array_view_value(&mut c, slot, xt, elem, mode);
}
fn array_view_value<a>(c: (&a mut C), slot: u64, xt: u64, elem: u64, mode: u64) -> Val {
    mut vty = 0;
    if elem == int_type(&mut c, 8, 0) {
        vty = intern_full(&mut c, 5, 0, mode, u64[]);
    } else {
        vty = intern_full(&mut c, 27, elem, mode, u64[]);
    }
    own(&mut c, slot, vty);
    view_bonds(&mut c, slot, xt, mode, false);
    return val(slot, vty);
}
// Whether a slice of `elem` - a vector's element stored as the array stores it - has the array's
// element width, so a copy between the two is a copy of bytes.
fn array_same_width<a>(c: (&a mut C), elem: u64) -> bool {
    w := array_elem_bytes(&mut c, elem);
    if is_array(&mut c, elem) {
        return true;
    }
    if elem == int_type(&mut c, 8, 0) {
        return true;
    }
    if narrow_code(&mut c, elem) != 0 {
        return w == 4;
    }
    return w == 8;
}
// `a[lo: hi]`, after the `[`: a slice of elements lo..hi, checked against the constant N.
fn array_subslice<a>(c: (&a mut C), value: Val, x: Val, access: u64) -> Val {
    lo := expr(&mut c, 0);
    require_type(&mut c, lo.ty, 0);
    expect(&mut c, view(":"));
    hi := expr(&mut c, 0);
    require_type(&mut c, hi.ty, 0);
    expect(&mut c, view("]"));
    mut mode = 0;
    if ty_kind(&mut c, value.ty) == 7 {
        mode = ty_mode(&mut c, value.ty);
    }
    if access == 2 {
        mode = 1;
    }
    elem := array_elem(&mut c, x.ty);
    mut args = two(x.t, lo.t);
    args.push(hi.t);
    args.push(imm(&mut c, array_elem_bytes(&mut c, elem)));
    args.push(imm(&mut c, array_len(&mut c, x.ty)));
    slot := invoke(&mut c, view("rt_aslice"), args);
    return array_view_value(&mut c, slot, x.t, elem, mode);
}
// A `&T`/`&mut T` argument or initializer whose referent is an array, where `&[T]`/`&mut [T]` (or a
// byte view) of its element type is expected: the slice of all of it.
fn array_to_slice<a>(c: (&a mut C), v: Val, formal: u64) -> Val {
    if (c.raw != 0) || (formal == 0) || (formal == NO_TYPE) || !is_type_id(formal) || (ty_kind(&mut c, v.ty) != 7) {
        return v;
    }
    fk := ty_kind(&mut c, formal);
    if (fk != 27) & (fk != 5) {
        return v;
    }
    inner := ty_arg(&mut c, v.ty);
    if !is_array(&mut c, inner) {
        return v;
    }
    elem := array_elem(&mut c, inner);
    if fk == 27 {
        if same_type(&mut c, base_type(&mut c, ty_arg(&mut c, formal)), base_type(&mut c, elem)) == 0 {
            return v;
        }
    } else if elem != int_type(&mut c, 8, 0) {
        return v;
    }
    mode := ty_mode(&mut c, formal);
    if (mode != 0) & (ty_mode(&mut c, v.ty) == 0) {
        fail(&mut c, view("a mutable slice of an array needs `&mut`"));
    }
    x := deref(&mut c, v);
    return array_view(&mut c, x.t, x.ty, mode);
}
// `.len()`, `.copy()`, `.copy_from(&s)` on an array.
fn array_method<a, b>(c: (&a mut C), xt: u64, xty: u64, input: u64, inty: u64, name: &b [u8]) -> Val {
    if same(view(name), view("copy_from")) {
        // The elements of a vector or slice of exactly N, copied in; its length is checked here.
        if ty_kind(&mut c, inty) == 7 {
            if ty_mode(&mut c, inty) == 0 {
                fail(&mut c, view("copy_from writes the array: it needs `&mut` or a `mut` binding"));
            }
        } else {
            require_mutable_binding(&mut c, input, 0);
        }
        elem := array_elem(&mut c, xty);
        sstart := c.pos;
        mut s = expr(&mut c, 0);
        expect(&mut c, view(")"));
        sx := deref(&mut c, s);
        sk := ty_kind(&mut c, sx.ty);
        mut selem = 0;
        if (sk == 6) || (sk == 27) {
            selem = ty_arg(&mut c, sx.ty);
        } else if (sk == 3) || (sk == 5) {
            selem = int_type(&mut c, 8, 0);
        } else {
            exchange(&mut c.pos, sstart);
            fail(&mut c, view("copy_from takes a vector or a slice of the array's element type"));
        }
        if same_type(&mut c, base_type(&mut c, selem), base_type(&mut c, elem)) == 0 {
            exchange(&mut c.pos, sstart);
            fail(&mut c, view("copy_from takes a vector or a slice of the array's element type"));
        }
        if !array_same_width(&mut c, elem) {
            exchange(&mut c.pos, sstart);
            fail(&mut c, view("copy_from of this element type is not supported yet: assign the elements"));
        }
        mut args = two(xt, sx.t);
        args.push(imm(&mut c, array_len(&mut c, xty)));
        args.push(imm(&mut c, array_elem_bytes(&mut c, elem)));
        invoke(&mut c, view("rt_array_copy_from"), args);
        release_temporary(&mut c, input);
        return val(imm(&mut c, 0), 1);
    }
    if same(view(name), view("len")) {
        expect(&mut c, view(")"));
        slot := imm(&mut c, array_len(&mut c, xty));
        release_temporary(&mut c, input);
        return val(slot, 0);
    }
    if same(view(name), view("copy")) {
        expect(&mut c, view(")"));
        if needs_drop(&mut c, array_elem(&mut c, xty)) {
            fail(&mut c, view("copy requires an array of plain values; copying owners would duplicate ownership"));
        }
        copy := array_fresh_copy(&mut c, xt, xty);
        release_temporary(&mut c, input);
        c.array_fresh.push(copy);
        return own(&mut c, copy, base_type(&mut c, xty));
    }
    fail(&mut c, view("internal: not an array method"));
    return val(0, 0);
}
// Consumes the current token if it is of kind `k`.
fn eat_kind<a>(c: (&a mut C), k: u64) -> bool {
    if kind(&mut c) == k {
        advance(&mut c);
        return true;
    }
    return false;
}
fn record<a>(c: (&a mut C), d: u64, explicit: u64) -> Val {
    // A tuple literal `(a, b)` is a record built positionally (tuple_decl).
    positional := exchange(&mut c.positional, 0) != 0;
    // The closing bracket's token kind: `)` or `}`.
    mut close = 125;
    if positional {
        expect(&mut c, view("("));
        close = 41;
    } else {
        expect(&mut c, view("{"));
    }
    count := c.decls[d].count;
    if c.decls[d].opaque != 0 {
        fail(&mut c, view("opaque handles cannot be constructed"));
    }
    if c.decls[d].is_enum != 0 {
        fail(&mut c, view("enum requires variant constructor"));
    }
    hint := constructor_hint(&mut c, d, explicit);
    mut map = constructor_map(&mut c, d, hint);
    mut seen = u64[];
    mut sources = u64[];
    // Each field value's term, in the order `sources` holds them: a predicate across fields reads
    // them once the record is complete.
    mut lit_terms = u8[][];
    lit_at := c.pos;
    mut deferred = u64[];
    mut index = 0;
    if !eat_kind(&mut c, close) {
        while true {
            mut f = u8[];
            mut has_colon = true;
            if positional {
                decimal(&mut f, index);
                index += 1;
            } else {
                f = ident(&mut c);
                has_colon = eat(&mut c, view(":"));
            }
            astart := c.pos;
            k := find_field(&mut c, d, view(f));
            field := field_ty(&mut c, d, k);
            mut context = NO_TYPE;
            mut known = 1;
            for i in map.len() {
                if map[i] == NO_TYPE {
                    known = 0;
                }
            }
            if known != 0 {
                context = bind_types(&mut c, field, &map);
            }
            mut v = val(0, 0);
            // Point { x, y } is shorthand for Point { x: x, y: y }.
            if has_colon {
                field_mark := c.resources.len();
                v = expr_expected(&mut c, 0, context);
                if c.raw == 0 && !contains_borrow(&mut c, v.ty, 0) {
                    release_temporaries(&mut c, field_mark, v.t);
                }
            } else {
                local := find_local(&mut c, view(f));
                if local == 0 {
                    fail(&mut c, view("field shorthand needs a variable with the field's name"));
                }
                exchange(&mut c.pos, c.pos - 1);
                // The shorthand's value is the field's type, so a literal adopts it (`P { x }`
                // where `x: u8` gives a u8, not the default integer).
                v = primary(&mut c, context);
            }
            aend := c.pos;
            for i in seen.len() {
                if seen[i] == k {
                    fail(&mut c, view("duplicate record field"));
                }
            }
            seen.push(k);
            ft := field_ty(&mut c, d, k);
            if literal_target(&mut c, ft) & (c.lit_start == astart) & (c.lit_end == aend) {
                if adopt_literal(&mut c, astart, aend, ft) {
                    v = val(v.t, ft);
                }
            }
            infer_union_member(&mut c, ft, v.ty, &mut map);
            mut resolved = 1;
            for i in map.len() {
                if map[i] == NO_TYPE {
                    resolved = 0;
                }
            }
            mut delay = 0;
            if (resolved == 0)
                & is_union(&mut c, ft)
                & !is_union(&mut c, v.ty) {
                delay = 1;
            }
            if delay != 0 {
                deferred.push(sources.len());
                deferred.push(astart);
                deferred.push(aend);
                deferred.push(c.lit_start);
                deferred.push(c.lit_end);
                deferred.push(c.lit_value);
                deferred.push(c.lit_negative);
                deferred.push(c.flit_start);
                deferred.push(c.flit_end);
                deferred.push(c.flit_tok);
                deferred.push(c.flit_neg);
                deferred.push(v.ty);
            } else {
                if resolved != 0 {
                    expected := bind_types(&mut c, ft, &map);
                    v = adopt_value(&mut c, v, astart, aend, expected);
                } else {
                    if is_f32(&mut c, ft) {
                        v = adopt_float(&mut c, v, astart, aend, ft);
                    }
                    v = hint_use(&mut c, v, astart, aend, ft);
                }
                infer_type(&mut c, ft, v.ty, &mut map);
            }
            held := move_value(&mut c, v);
            sources.push(held.t);
            if c.decls[d].c_layout == 0 {
                fterm := pv_span_term(&mut c, astart, aend);
                lit_terms.push(fterm.copy());
                ref_field(&mut c, d, k, held.t, view(fterm), astart);
            } else {
                lit_terms.push(u8[]);
            }
            if eat_kind(&mut c, close) {
                break;
            }
            expect(&mut c, view(","));
            if eat_kind(&mut c, close) {
                break;
            }
        }
    }
    if seen.len() != count {
        fail(&mut c, view("record construction omits fields"));
    }
    ty := constructed_type(&mut c, d, hint, map);
    for j in deferred.len() / 12 {
        base := j * 12;
        index := deferred[base];
        start := deferred[base + 1];
        end := deferred[base + 2];
        exchange(&mut c.lit_start, deferred[base + 3]);
        exchange(&mut c.lit_end, deferred[base + 4]);
        exchange(&mut c.lit_value, deferred[base + 5]);
        exchange(&mut c.lit_negative, deferred[base + 6]);
        exchange(&mut c.flit_start, deferred[base + 7]);
        exchange(&mut c.flit_end, deferred[base + 8]);
        exchange(&mut c.flit_tok, deferred[base + 9]);
        exchange(&mut c.flit_neg, deferred[base + 10]);
        k := seen[index];
        expected := field_type(&mut c, ty, k);
        slot := sources[index];
        actual := deferred[base + 11];
        v := adopt_value(&mut c, val(slot, actual), start, end, expected);
        newslot := v.t;
        require_type(&mut c, v.ty, expected);
        if c.decls[d].c_layout == 0 {
            fterm := pv_span_term(&mut c, start, end);
            exchange(&mut lit_terms[index], fterm.copy());
            ref_field(&mut c, d, k, newslot, view(fterm), start);
        }
        exchange(&mut sources[index], newslot);
    }
    // The record is allocated and filled once every field has its value: where a field lies
    // depends on the record's type arguments, and those are known only now.
    mut n = 0;
    if framed(&mut c, ty) {
        n = frame_alloc(&mut c, record_words(&mut c, ty));
        if plain(&mut c, ty) {
            c.temps.push(n);
        }
    } else {
        sz := imm(&mut c, record_words(&mut c, ty));
        n = invoke(&mut c, view("rt_rec"), one(sz));
    }
    for i in seen.len() {
        if c.decls[d].c_layout != 0 {
            cfield_store(&mut c, n, d, seen[i], sources[i]);
        } else {
            field_store(&mut c, n, ty, seen[i], sources[i]);
        }
    }
    // A predicate across fields is owed once every field it reads has its value.
    if c.decls[d].c_layout == 0 {
        mut by_slot = u64[];
        mut by_term = u8[][];
        for i in c.decls[d].count {
            by_slot.push(0);
            by_term.push(u8[]);
        }
        for i in seen.len() {
            exchange(&mut by_slot[seen[i]], sources[i]);
            if i < lit_terms.len() {
                exchange(&mut by_term[seen[i]], lit_terms[i].copy());
            }
        }
        for j in c.decls[d].count {
            if ref_pred_cross(&mut c, d, j) {
                ref_field_cross(&mut c, d, j, ty, &by_slot, &by_term, lit_at, view("a value is not a name or a constant"));
            }
        }
    }
    if live_word(&mut c, ty) {
        get(&mut c, n, view("%rax"));
        o(&mut c, view("movq $1,"));
        on(&mut c, (record_words(&mut c, ty) - 1) * 8);
        o(&mut c, view("(%rax)\n"));
    }
    own(&mut c, n, ty);
    root := place_of(&mut c, n);
    for i in seen.len() {
        k := seen[i];
        ft := field_type(&mut c, ty, k);
        slot := sources[i];
        source := place_of(&mut c, slot);
        child := member_place(&mut c, root, k, ft);
        transfer_bonds(&mut c, source, child);
        move_out(&mut c, val(slot, ft));
