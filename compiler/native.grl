    push_bytes(&mut msg, view(decimal_bytes(value)));
    name := source_type_name(&mut c, ty);
    push_bytes(&mut msg, view(" is out of range for "));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view(" ("));
    push_bytes(&mut msg, view(int_range_msg(&mut c, ty)));
    push_bytes(&mut msg, view(")"));
    // `u8(x)` does not truncate: it checks the value when the program runs. The truncating spelling
    // is `wrapping_u8(x)`, and naming the wrong one sent readers to a trap.
    mut help = copy_bytes(view("write a value that fits, or truncate on purpose: `wrapping_"));
    push_bytes(&mut help, view(name));
    push_bytes(&mut help, view("(x)` says the narrowing is intended, where `"));
    push_bytes(&mut help, view(name));
    push_bytes(&mut help, view("(x)` checks the value at run time"));
    diag_help(&mut c, view(help));
