// Whether a function with `count` parameters starting at `first` can be the program's entry when it
// was picked rather than written as `main`: no parameter, or the one readonly byte view argv is.
// A library's first public function is usually neither, and picking it made the build fail at the
// entry check - located wherever the compiler had last read, often an imported interface - instead
// of saying the program has no `main`.
fn entry_shaped<a>(c: (&a mut C), count: u64, first: u64) -> bool {
    if count == 0 {
        return true;
    }
    if first >= c.params.len() {
        return false;
    }
    param := c.params[first];
    return (ty_kind(&mut c, param) == 5) && (ty_mode(&mut c, param) == 0);
