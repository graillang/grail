// ---- tokens ----
fn kind<a>(c:ref_mut<a,C>)->num {
    p :=c.pos;
    t :=vec_get(c.toks,p);
    return t.kind;
}
fn next_kind<a>(c:ref_mut<a,C>)->num{p :=c.pos+1;return kind_at(borrow_mut(c),p);}
fn kind_at<a>(c:ref_mut<a,C>,i:num)->num {
    t :=vec_get(c.toks,i);
    return t.kind;
}
fn advance<a>(c:ref_mut<a,C>)->unit {
    p :=c.pos+1;
    exchange(borrow_mut(c.pos),p);
    return ();
}
fn tok_text<a>(c:ref_mut<a,C>,i:num)->bytes {
    t :=vec_get(c.toks,i);
    st :=t.start;
    en :=t.end;
    return copy_bytes(slice(read(c.src),st,en));
}
fn is<a,b>(c:ref_mut<a,C>,s:read<b>)->num {
    p :=c.pos;
    t :=tok_text(borrow_mut(c),p);
    return same(read(t),s);
}
fn fail<a,b>(c:ref_mut<a,C>,msg:read<b>)->unit {
    p :=c.pos;
    m :=tok_text(borrow_mut(c),p);
    t :=vec_get(c.toks,p);
    st :=t.start;
    exchange(borrow_mut(c.out),vec<num>());
    o(borrow_mut(c),read("native: "));
    o(borrow_mut(c),msg);
    o(borrow_mut(c),read(" at byte "));
    on(borrow_mut(c),st);
    o(borrow_mut(c),read(" near '"));
    o(borrow_mut(c),read(m));
    o(borrow_mut(c),read("'\n"));
    var line =bytes();
    for i in len(c.out) { push(line,load(vec_get(c.out,i))); }
    host::print(read(line));
    assert(0);
    return ();
}
fn eat<a,b>(c:ref_mut<a,C>,s:read<b>)->num {
    if is(borrow_mut(c),s) { advance(borrow_mut(c)); return 1; }
    return 0;
}
fn expect<a,b>(c:ref_mut<a,C>,s:read<b>)->unit {
    want :=copy_bytes(read(s));
    if eat(borrow_mut(c),s)==0 {
        var msg ="expected ";
        append_text(msg,read(want));
        fail(borrow_mut(c),read(msg));
    }
    return ();
}
fn ident<a>(c:ref_mut<a,C>)->bytes {
    if kind(borrow_mut(c))!=1 { fail(borrow_mut(c),read("expected identifier")); }
    p :=c.pos;
    t :=tok_text(borrow_mut(c),p);
    advance(borrow_mut(c));
    return t;
}
// Skips a balanced {...} group starting at the current '{'.
fn skip_braces<a>(c:ref_mut<a,C>)->unit {
    var depth=0;
    while 1 {
        k :=kind(borrow_mut(c));
        if k==123 { depth=depth+1; }
        if k==125 { depth=depth-1; }
        if k==0 { fail(borrow_mut(c),read("unclosed {")); }
        advance(borrow_mut(c));
        if depth==0 { return (); }
    }
    return ();
}
fn load_file<a>(c:ref_mut<a,C>,index:num)->unit {
    path :=host::arg(index);
    src :=host::read_file(read(path));
    var toks =vec<Tok>();
    lexed :=lexer::tokenize(read(src));
    for i in len(lexed) {
        t :=vec_get(lexed,i);
        vec_push(toks,Tok{kind:t.kind,start:t.start,end:t.end});
    }
    drop(lexed);
    exchange(borrow_mut(c.toks),toks);
    exchange(borrow_mut(c.src),src);
    exchange(borrow_mut(c.pos),0);
    return ();
}

// ---- types and declarations ----
fn numbers_equal<a,b>(a:ref<a,vec<num>>,b:ref<b,vec<num>>)->num {
 if len(a)!=len(b){return 0;}for i in len(a){if load(vec_get(a,i))!=load(vec_get(b,i)){return 0;}}return 1;
}
fn intern_args<a>(c:ref_mut<a,C>,k:num,arg:num,mode:num,regions:vec<num>,args:vec<num>)->num {
 for i in len(c.types){t :=vec_get(c.types,i);
 if (t.kind==k)&(t.arg==arg)&(t.mode==mode){if numbers_equal(borrow(t.regions),borrow(regions)){if numbers_equal(borrow(t.args),borrow(args)){return i;}}}}
 vec_push(c.types,Ty{kind:k,arg:arg,mode:mode,regions:regions,args:args});return len(c.types)-1;
}
fn intern_full<a>(c:ref_mut<a,C>,k:num,arg:num,mode:num,regions:vec<num>)->num {
 return intern_args(borrow_mut(c),k,arg,mode,regions,vec<num>());
}
fn type_args<a>(c:ref_mut<a,C>,ty:num)->vec<num>{
 var args =vec<num>();t :=vec_get(c.types,ty);for i in len(t.args){vec_push(args,load(vec_get(t.args,i)));}return args;
}
fn intern<a>(c:ref_mut<a,C>,k:num,arg:num)->num {return intern_full(borrow_mut(c),k,arg,0,vec<num>());}
fn region_id<a>(c:ref_mut<a,C>)->num {
 n :=ident(borrow_mut(c));
 for i in len(c.rnames){var r =vec_get(c.rnames,i);if same(read(r),read(n)){return i+1;}}
 fail(borrow_mut(c),read("undeclared lifetime"));return 0;
}
fn lifetime_parameters<a>(c:ref_mut<a,C>)->unit {
 exchange(borrow_mut(c.rnames),vec<bytes>());exchange(borrow_mut(c.tnames),vec<bytes>());
 if eat(borrow_mut(c),read("<")){while 1{
 is_type :=eat(borrow_mut(c),read("type"));n :=ident(borrow_mut(c));
 if is_type{
 for i in len(c.tnames){t :=vec_get(c.tnames,i);if same(read(t),read(n)){fail(borrow_mut(c),read("duplicate type parameter"));}}
 vec_push(c.tnames,n);
 }else{
 if len(c.tnames)!=0{fail(borrow_mut(c),read("lifetimes must precede type parameters"));}
 for i in len(c.rnames){var r =vec_get(c.rnames,i);if same(read(r),read(n)){fail(borrow_mut(c),read("duplicate lifetime"));}}
 vec_push(c.rnames,n);
 }
 if eat(borrow_mut(c),read(">")){break;}expect(borrow_mut(c),read(","));}}
 return ();
}
fn lifetime_arguments<a>(c:ref_mut<a,C>)->vec<num> {
 var rs =vec<num>();if eat(borrow_mut(c),read("<")){while 1{
 var r =region_id(borrow_mut(c));vec_push(rs,r);
 if eat(borrow_mut(c),read(">")){break;}expect(borrow_mut(c),read(","));}}
 return rs;
}
fn nominal_type<a>(c:ref_mut<a,C>,d:num)->num {
 decl :=vec_get(c.decls,d);count :=decl.regions;types :=decl.types;
 var rs =vec<num>();var args =vec<num>();
 if count+types{
 expect(borrow_mut(c),read("<"));
 for i in count+types{if i!=0{expect(borrow_mut(c),read(","));}
 if i<count{var r =region_id(borrow_mut(c));vec_push(rs,r);}else{t :=parse_type(borrow_mut(c));vec_push(args,t);}}
 expect(borrow_mut(c),read(">"));
 }
 return intern_args(borrow_mut(c),8,d,0,rs,args);
}
fn ty_kind<a>(c:ref_mut<a,C>,ty:num)->num {
    t :=vec_get(c.types,ty);
    return t.kind;
}
fn ty_arg<a>(c:ref_mut<a,C>,ty:num)->num {
    t :=vec_get(c.types,ty);
    return t.arg;
}
fn ty_mode<a>(c:ref_mut<a,C>,ty:num)->num {t :=vec_get(c.types,ty);return t.mode;}
fn type_regions<a>(c:ref_mut<a,C>,ty:num)->vec<num>{
 var rs =vec<num>();t :=vec_get(c.types,ty);
 for i in len(t.regions){vec_push(rs,load(vec_get(t.regions,i)));}return rs;
}
fn substitute<a,b>(c:ref_mut<a,C>,ty:num,map:ref<b,vec<num>>)->num {
 k :=ty_kind(borrow_mut(c),ty);mode :=ty_mode(borrow_mut(c),ty);var arg=ty_arg(borrow_mut(c),ty);
 var rs =type_regions(borrow_mut(c),ty);
 if (k==6)+(k==7){arg=substitute(borrow_mut(c),arg,borrow(map));}
 for i in len(rs){var r =load(vec_get(rs,i));if r!=0{
 if len(map)<r{fail(borrow_mut(c),read("unbound stored lifetime"));}
 n :=load(vec_get(map,r-1));exchange(vec_get_mut(rs,i),n);}}
 var args =type_args(borrow_mut(c),ty);
 for i in len(args){t :=load(vec_get(args,i));var v =substitute(borrow_mut(c),t,borrow(map));exchange(vec_get_mut(args,i),v);}
 return intern_args(borrow_mut(c),k,arg,mode,rs,args);
}
fn bind_types<a,b>(c:ref_mut<a,C>,ty:num,map:ref<b,vec<num>>)->num {
 k :=ty_kind(borrow_mut(c),ty);mode :=ty_mode(borrow_mut(c),ty);var arg=ty_arg(borrow_mut(c),ty);
 if k==9{if len(map)<arg+1{fail(borrow_mut(c),read("unbound type parameter"));}return load(vec_get(map,arg));}
 if (k==6)+(k==7){arg=bind_types(borrow_mut(c),arg,borrow(map));}
 var args =type_args(borrow_mut(c),ty);for i in len(args){t :=load(vec_get(args,i));var v =bind_types(borrow_mut(c),t,borrow(map));exchange(vec_get_mut(args,i),v);}
 var rs =type_regions(borrow_mut(c),ty);return intern_args(borrow_mut(c),k,arg,mode,rs,args);
}
fn field_type<a>(c:ref_mut<a,C>,ty:num,index:num)->num {
 d :=ty_arg(borrow_mut(c),ty);t :=field_ty(borrow_mut(c),d,index);var rs =type_regions(borrow_mut(c),ty);var args =type_args(borrow_mut(c),ty);
 field :=bind_types(borrow_mut(c),t,borrow(args));if len(rs)==0{return field;}return substitute(borrow_mut(c),field,borrow(rs));
}
fn concrete_type<a>(c:ref_mut<a,C>,ty:num)->num {
 k :=ty_kind(borrow_mut(c),ty);if k==9{return 0;}arg :=ty_arg(borrow_mut(c),ty);
 if (k==6)+(k==7)+(k==10){if concrete_type(borrow_mut(c),arg)==0{return 0;}}
 var args =type_args(borrow_mut(c),ty);for i in len(args){a :=load(vec_get(args,i));if concrete_type(borrow_mut(c),a)==0{return 0;}}
 return 1;
}
fn reference_type<a>(c:ref_mut<a,C>,ty:num,mode:num)->num{return intern_full(borrow_mut(c),7,ty,mode,vec<num>());}
// Shape checking does not discharge lifetime obligations; the loan pass handles those separately.
fn same_type<a>(c:ref_mut<a,C>,x:num,y:num)->num {
 a :=ty_kind(borrow_mut(c),x);var b =ty_kind(borrow_mut(c),y);if a!=b{return 0;}
 aa :=ty_arg(borrow_mut(c),x);bb :=ty_arg(borrow_mut(c),y);
 if (a==5)+(a==7){am :=ty_mode(borrow_mut(c),x);bm :=ty_mode(borrow_mut(c),y);if am!=bm{return 0;}}
 if (a==6)+(a==7){return same_type(borrow_mut(c),aa,bb);}
 if a==8{if aa!=bb{return 0;}ax :=type_args(borrow_mut(c),x);bx :=type_args(borrow_mut(c),y);if len(ax)!=len(bx){return 0;}
 for i in len(ax){x :=load(vec_get(ax,i));y :=load(vec_get(bx,i));if same_type(borrow_mut(c),x,y)==0{return 0;}}}
 if a==9{return aa==bb;}if a==10{am :=ty_mode(borrow_mut(c),x);bm :=ty_mode(borrow_mut(c),y);return (aa==bb)&(am==bm);}return 1;
}
fn contains_borrow<a>(c:ref_mut<a,C>,ty:num,depth:num)->num {
 if 64<depth{fail(borrow_mut(c),read("recursive capture layout unsupported"));}
 k :=ty_kind(borrow_mut(c),ty);arg :=ty_arg(borrow_mut(c),ty);
 if (k==5)+(k==7){return 1;}if k==10{return contains_borrow(borrow_mut(c),arg,depth+1);}if k==6{return contains_borrow(borrow_mut(c),arg,depth+1);}
 if k==8{d :=vec_get(c.decls,arg);count :=d.count;
 for i in count{t :=field_type(borrow_mut(c),ty,i);if contains_borrow(borrow_mut(c),t,depth+1){return 1;}}}return 0;
}
fn require_type<a>(c:ref_mut<a,C>,actual:num,expected:num)->unit {
 if same_type(borrow_mut(c),actual,expected)==0{fail(borrow_mut(c),read("type mismatch"));}return ();
}
// Declaration index + 1, or 0.
fn find_decl<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->num {
    for i in len(c.decls) {
        x :=vec_get(c.decls,i);
        if same(read(x.module),read(m))&same(read(x.name),read(n)) { return i+1; }
    }
    return 0;
}
fn find_func<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->num {
    for i in len(c.funcs) {
        x :=vec_get(c.funcs,i);
        if same(read(x.module),read(m))&same(read(x.name),read(n)) { return i+1; }
    }
    return 0;
}
// Field index within decl, failing when absent.
fn find_field<a,b>(c:ref_mut<a,C>,decl:num,n:read<b>)->num {
    d :=vec_get(c.decls,decl);
    first :=d.first;
    count :=d.count;
    for i in count {
        f :=vec_get(c.fields,first+i);
        if same(read(f.name),read(n)) { return i; }
    }
    fail(borrow_mut(c),read("unknown field or variant"));
    return 0;
}
fn field_ty<a>(c:ref_mut<a,C>,decl:num,index:num)->num {
    d :=vec_get(c.decls,decl);
    k :=d.first+index;
    f :=vec_get(c.fields,k);
    return f.ty;
}
fn module_copy<a>(c:ref_mut<a,C>)->bytes { return copy_bytes(read(c.module)); }
fn parse_type<a>(c:ref_mut<a,C>)->num {
 first :=ident(borrow_mut(c));
 for i in len(c.tnames){t :=vec_get(c.tnames,i);if same(read(t),read(first)){if len(c.bindings){return load(vec_get(c.bindings,i));}return intern(borrow_mut(c),9,i);}}
 if eat(borrow_mut(c),read("::")){
 n :=ident(borrow_mut(c));d :=find_decl(borrow_mut(c),read(first),read(n));
 if d==0{fail(borrow_mut(c),read("unknown type"));}return nominal_type(borrow_mut(c),d-1);}
 if same(read(first),read("num")){return 0;}if same(read(first),read("unit")){return 1;}
 if same(read(first),read("bytes")){return 2;}if same(read(first),read("string")){return 3;}
 if same(read(first),read("read"))+same(read(first),read("mut")){
 var rs =lifetime_arguments(borrow_mut(c));if len(rs)!=1{fail(borrow_mut(c),read("view lifetime arity"));}
 mode :=same(read(first),read("mut"));return intern_full(borrow_mut(c),5,0,mode,rs);}
 if same(read(first),read("vec")){
 expect(borrow_mut(c),read("<"));e :=parse_type(borrow_mut(c));expect(borrow_mut(c),read(">"));return intern(borrow_mut(c),6,e);}
 if same(read(first),read("ref"))+same(read(first),read("ref_mut")){
 expect(borrow_mut(c),read("<"));var r =region_id(borrow_mut(c));expect(borrow_mut(c),read(","));
 e :=parse_type(borrow_mut(c));expect(borrow_mut(c),read(">"));var rs =vec<num>();vec_push(rs,r);
 mode :=same(read(first),read("ref_mut"));return intern_full(borrow_mut(c),7,e,mode,rs);}
 m :=module_copy(borrow_mut(c));d :=find_decl(borrow_mut(c),read(m),read(first));
 if d==0{fail(borrow_mut(c),read("unknown type"));}return nominal_type(borrow_mut(c),d-1);
}
// ---- top level: pass 1 names, pass 2 fields/signatures/prototypes, pass 3 bodies ----
fn mangle<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->unit {
    if same(read(m),read("runtime")) { o(borrow_mut(c),n); return (); }
    o(borrow_mut(c),read("f_")); o(borrow_mut(c),m); vec_push(c.out,95); o(borrow_mut(c),n); return ();
}
fn decl<a>(c:ref_mut<a,C>,pass:num)->unit {
    is_enum :=is(borrow_mut(c),read("enum"));
    advance(borrow_mut(c));
    name :=ident(borrow_mut(c));
    lifetime_parameters(borrow_mut(c));
    regions :=len(c.rnames);types :=len(c.tnames);
    if pass!=2 {
        if pass==1 {
            m :=module_copy(borrow_mut(c));
            vec_push(c.decls,Decl{module:m,name:name,is_enum:is_enum,first:0,count:0,regions:regions,types:types});
        }
        skip_braces(borrow_mut(c));
        eat(borrow_mut(c),read(";"));
        return ();
    }
    m :=module_copy(borrow_mut(c));
    d :=find_decl(borrow_mut(c),read(m),read(name));
    first :=len(c.fields);
    var count=0;
    expect(borrow_mut(c),read("{"));
    if eat(borrow_mut(c),read("}"))==0 {
        while 1 {
            f :=ident(borrow_mut(c));
            var ty=1;
            if is_enum {
                if eat(borrow_mut(c),read("(")) {
                    ty=parse_type(borrow_mut(c));
                    expect(borrow_mut(c),read(")"));
                }
            } else {
                expect(borrow_mut(c),read(":"));
                ty=parse_type(borrow_mut(c));
            }
            vec_push(c.fields,Field{name:f,ty:ty});
            count=count+1;
            if eat(borrow_mut(c),read("}")) { break; }
            expect(borrow_mut(c),read(","));
            if eat(borrow_mut(c),read("}")) { break; }
        }
    }
    eat(borrow_mut(c),read(";"));
    exchange(vec_get_mut(c.decls,d-1),Decl{module:m,name:name,is_enum:is_enum,first:first,count:count,regions:regions,types:types});
    return ();
}
fn bind<a>(c:ref_mut<a,C>,name:bytes,ty:num,id:num,mutable:num)->unit {
    if c.raw==0{if place_of(borrow_mut(c),id)==0{kind :=ty_kind(borrow_mut(c),ty);if (kind==1)+(kind==2){place :=ownership::root(borrow_mut(c.check),1,1);vec_push(c.resources,Resource{slot:id,ty:ty,flag:0,base:0,field:0,via:0,place:place,target:0,authority:0});}}}
    from :=c.pos;to :=c.scope_end;last :=last_name(borrow_mut(c),read(name),from,to);
    vec_push(c.locals,Local{name:name,ty:ty,id:id,last:last,born:from,mutable:mutable});
    return ();
}
fn func<a>(c:ref_mut<a,C>,pass:num,public:num)->unit {
 position :=c.pos;expect(borrow_mut(c),read("fn"));var name=ident(borrow_mut(c));lifetime_parameters(borrow_mut(c));
 if same(read(name),read("print"))+same(read(name),read("println")){fail(borrow_mut(c),read("print and println are reserved prelude names"));}
 typecount :=len(c.tnames);regioncount :=len(c.rnames);
 if (pass==3)&(typecount!=0){while kind(borrow_mut(c))!=123{advance(borrow_mut(c));}skip_braces(borrow_mut(c));return ();}
 if pass==1{while kind(borrow_mut(c))!=123{advance(borrow_mut(c));}skip_braces(borrow_mut(c));return ();}
 m :=module_copy(borrow_mut(c));exchange(borrow_mut(c.locals),vec<Local>());exchange(borrow_mut(c.resources),vec<Resource>());exchange(borrow_mut(c.next),0);
 exchange(borrow_mut(c.scope_end),0);exchange(borrow_mut(c.loop_start),0);exchange(borrow_mut(c.loop_end),0);
 exchange(borrow_mut(c.check),ownership::new());exchange(borrow_mut(c.members),vec<Member>());exchange(borrow_mut(c.terminated),0);exchange(borrow_mut(c.bonds),vec<Bond>());exchange(borrow_mut(c.origins),vec<Origin>());
 first :=len(c.params);var count=0;
 expect(borrow_mut(c),read("("));
 if eat(borrow_mut(c),read(")"))==0{while 1{
 p :=ident(borrow_mut(c));expect(borrow_mut(c),read(":"));ty :=parse_type(borrow_mut(c));
 if pass==2{vec_push(c.params,ty);}id :=fresh(borrow_mut(c));bind(borrow_mut(c),p,ty,id,0);count=count+1;
 if eat(borrow_mut(c),read(")")){break;}expect(borrow_mut(c),read(","));}}
 if 6<count{fail(borrow_mut(c),read("native function exceeds six parameters"));}
 var ret=1;if eat(borrow_mut(c),read("->")){ret=parse_type(borrow_mut(c));}exchange(borrow_mut(c.result),ret);
 if pass==2{
 if find_func(borrow_mut(c),read(m),read(name))!=0{fail(borrow_mut(c),read("duplicate function"));}
 main :=(c.file==2)&same(read(name),read("main"));
 if main{if (1<count)+(typecount!=0){fail(borrow_mut(c),read("main needs zero arguments or one readonly byte view and no type parameters"));}}
 entry :=main+((c.entry==0)&(c.file==2)&public&(count<2)&(typecount==0));
 file :=c.file;raw :=c.raw;vec_push(c.funcs,Func{module:m,name:name,first:first,count:count,ret:ret,types:typecount,regions:regioncount,file:file,pos:position,raw:raw});
 index :=len(c.funcs);if entry{exchange(borrow_mut(c.entry),index);}skip_braces(borrow_mut(c));return ();}
 if c.current_spec{spec :=c.current_spec;name=special_name(borrow_mut(c),spec-1);}
 start :=c.pos;end :=block_end(borrow_mut(c),start);exchange(borrow_mut(c.scope_end),end);
 for i in len(c.locals){var l =vec_get(c.locals,i);name :=copy_bytes(read(l.name));last :=last_name(borrow_mut(c),read(name),start,end);var l =vec_get_mut(c.locals,i);exchange(borrow_mut(l.last),last);}
 o(borrow_mut(c),read(".type "));mangle(borrow_mut(c),read(m),read(name));o(borrow_mut(c),read(",@function\n"));
 mangle(borrow_mut(c),read(m),read(name));o(borrow_mut(c),read(":\npushq %rbp\nmovq %rsp,%rbp\nsubq $.F"));
 frame :=label(borrow_mut(c));on(borrow_mut(c),frame);o(borrow_mut(c),read(",%rsp\n"));
 for i in count{reg :=argreg(i);o(borrow_mut(c),read("movq "));o(borrow_mut(c),read(reg));vec_push(c.out,44);stack_slot(borrow_mut(c),i);vec_push(c.out,10);}
 o(borrow_mut(c),read("leaq -.F"));on(borrow_mut(c),frame);o(borrow_mut(c),read("(%rbp),%rdi\nmovq $.F"));on(borrow_mut(c),frame);
 o(borrow_mut(c),read("/8-"));on(borrow_mut(c),count);o(borrow_mut(c),read(",%rcx\nxorl %eax,%eax\nrep stosq\n"));
 for i in count{var l =vec_get(c.locals,i);slot :=l.id;ty :=l.ty;own(borrow_mut(c),slot,ty);init_parameter(borrow_mut(c),slot,ty);}
 block(borrow_mut(c));if c.raw==0{if (c.terminated==0)&(ret!=1){fail(borrow_mut(c),read("function may fall through without return"));}}cleanup(borrow_mut(c),0);o(borrow_mut(c),read("xorq %rax,%rax\nleave\nret\n.set .F"));on(borrow_mut(c),frame);vec_push(c.out,44);
 n :=c.next;on(borrow_mut(c),div(n+1,2)*16);vec_push(c.out,10);return ();
}
fn toplevel<a>(c:ref_mut<a,C>,pass:num)->unit {
    raw :=eat(borrow_mut(c),read("unsafe"));
    exchange(borrow_mut(c.raw),raw);
    var m=copy_bytes(read("main"));
    if eat(borrow_mut(c),read("module")){m=ident(borrow_mut(c));expect(borrow_mut(c),read(";"));}
    else{if (c.file!=2)+raw{fail(borrow_mut(c),read("dependency files require an explicit module"));}}
    if same(read(m),read("runtime")){if raw==0{fail(borrow_mut(c),read("runtime module must be explicitly unsafe"));}}
    if raw { if same(read(m),read("runtime"))==0 { fail(borrow_mut(c),read("unsafe module reserved for runtime")); } }
    exchange(borrow_mut(c.module),m);
    while eat(borrow_mut(c),read("use")) {
        ident(borrow_mut(c));
        expect(borrow_mut(c),read(";"));
    }
    while kind(borrow_mut(c))!=0 {
        public :=eat(borrow_mut(c),read("pub"));
        if is(borrow_mut(c),read("struct"))+is(borrow_mut(c),read("enum")) {
            decl(borrow_mut(c),pass);
        } else {
            func(borrow_mut(c),pass,public);
        }
    }
    return ();
}

// ---- expressions: eight-byte stack slots; left-to-right operands ----
fn deref<a>(c:ref_mut<a,C>,v:Val)->Val {
 var t=v.t;var ty=v.ty;
 while ty_kind(borrow_mut(c),ty)==7{
 old :=t;target :=target_of(borrow_mut(c),old);
 get(borrow_mut(c),t,read("%rax"));o(borrow_mut(c),read("movq (%rax),%rax\n"));t=save(borrow_mut(c));ty=ty_arg(borrow_mut(c),ty);
 if c.raw==0{if target==0{fail(borrow_mut(c),read("reference target is not tracked"));}
 vec_push(c.resources,Resource{slot:t,ty:ty,flag:0,base:old+1,field:0,via:1,place:target,target:0,authority:old+1});
 owner :=place_of(borrow_mut(c),old);n :=len(c.bonds);
 for i in n{var b =vec_get(c.bonds,i);holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if (holder==owner)&guard{bond_kind(borrow_mut(c),target,loan,guard);}}
 stored_source(borrow_mut(c),t,ty);}
 }
 return val(t,ty);
}
fn find_local<a,b>(c:ref_mut<a,C>,n:read<b>)->num {
    var i=len(c.locals);
    while 0<i {
        i=i-1;
        var l =vec_get(c.locals,i);
        if same(read(l.name),read(n)) { return i+1; }
    }
    return 0;
