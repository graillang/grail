    mut r = &c.resources[n - 1];
    return r.authority;
}
fn authority_loan<a>(c: (&a mut C), slot: u64, target: u64) -> u64 {
    holder := place_of(&mut c, slot - 1);
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        h := b.holder;
        loan := b.loan;
        if (holder == h) & (b.guard == 0) {
            mut l = &c.check.loans[loan - 1];
            live := l.live;
            source := l.source;
            if live != 0 {
                if ownership::ancestor(&c.check, source, target) {
                    return loan;
                }
            }
        }
    }
    return 0;
}
fn set_target<a>(c: (&a mut C), slot: u64, target: u64, authority: u64) -> unit {
    n := resource(&mut c, slot);
    if n != 0 {
        mut r = &mut c.resources[n - 1];
        exchange(&mut r.target, target);
        exchange(&mut r.authority, authority);
    }
    return ();
}
fn add_region<a>(rs: (&a mut u64[]), r: u64) -> unit {
    for i in rs.len() {
        if rs[i] == r {
            return ();
