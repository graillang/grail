        saved_pos := c.pos;
        saved_cf_start := c.cf_start;
        saved_cf_end := c.cf_end;
        saved_cf_local := c.cf_local;
        saved_none_start := c.none_start;
        saved_none_end := c.none_end;
        if saved_file != dflt.file {
            load_file(&mut c, dflt.file);
            exchange(&mut c.file, dflt.file);
        }
        exchange(&mut c.pos, dflt.lo);
        mut v = expr_expected(&mut c, 0, context);
        if c.pos != dflt.hi {
            fail(&mut c, view("a parameter's default value is not one expression: it ends at `= value`"));
        }
        // The checks a written argument owes its parameter, the same ones in the same order (see the
        // argument loop above): a literal adopts the parameter's type, a value adopts a sized one,
        // and the loan it takes is recorded.
        if c.raw == 0 {
            if ((v.ty == 0) || ((c.lit_negative != 0) & (c.lit_start == dflt.lo) & (c.lit_end == dflt.hi))) & (types == 0) {
                if literal_target(&mut c, formal) {
                    if adopt_literal(&mut c, dflt.lo, dflt.hi, formal) {
                        v = val(v.t, formal);
                    }
                }
            }
        }
        if (c.raw == 0) & (types == 0) {
            if is_f32(&mut c, formal) {
                v = adopt_float(&mut c, v, dflt.lo, dflt.hi, formal);
            }
            v = adopt_value(&mut c, v, dflt.lo, dflt.hi, formal);
        }
        if c.raw == 0 {
            k := ty_kind(&mut c, v.ty);
            if (k == 5) || (k == 7) || (k == 27) {
                observe(&mut c, v.t);
            }
            if k == 7 {
                target := target_of(&mut c, v.t);
                capture_authority(&mut c, target);
            }
            v = coerce_view(&mut c, v, formal);
            if types != 0 {
                if (known == 0) & is_union(&mut c, formal) {
                    // The union's member would have to be chosen from a value the call never wrote,
                    // and the delay that does it re-reads the argument's tokens (they belong to
                    // another file here). One argument fixes the type instead.
                    mut msg = copy_bytes(view("a default value cannot fix the union parameter `"));
                    push_bytes(&mut msg, view(param_name(&c, f, p)));
                    push_bytes(&mut msg, view("` of generic `"));
                    push_bytes(&mut msg, view(name));
                    push_bytes(&mut msg, view("`; pass that argument explicitly"));
                    fail(&mut c, view(msg));
                }
                if known != 0 {
                    v = adopt_value(&mut c, v, dflt.lo, dflt.hi, context);
                }
                infer_type(&mut c, formal, v.ty, &mut map);
            } else {
                require_type(&mut c, v.ty, formal);
            }
        }
        // The value is the callee's, exactly as a written argument is.
        exchange(&mut argtypes[p], v.ty);
        held := move_value(&mut c, v);
        exchange(&mut sources[p], held.t);
        exchange(&mut args[p], held.t);
        exchange(&mut given[p], 1);
        if saved_file != dflt.file {
            load_file(&mut c, saved_file);
            exchange(&mut c.file, saved_file);
        }
        exchange(&mut c.pos, saved_pos);
        exchange(&mut c.cf_start, saved_cf_start);
        exchange(&mut c.cf_end, saved_cf_end);
        exchange(&mut c.cf_local, saved_cf_local);
        exchange(&mut c.none_start, saved_none_start);
        exchange(&mut c.none_end, saved_none_end);
    }
    // A parameter only a callable bound names is fixed by the closure bound to the bound parameter.
    {
        mut sets = u64[][];
        for q in c.funcs[f - 1].constraints.len() {
            sets.push(copy_numbers(&c.funcs[f - 1].constraints[q]));
        }
        infer_from_callables(&mut c, &sets, &mut map);
    }
    for i in map.len() {
        if map[i] == NO_TYPE {
            if deferred.len() != 0 {
                fail(&mut c, view("ambiguous union type inference"));
            }
            if (i < value_slots.len()) && (value_slots[i] != 0) {
                fail(&mut c, view("this function has a value parameter no argument fixes: give it explicitly, as in rotl<13>(x)"));
            }
            fail(&mut c, view("cannot infer function type argument"));
        }
    }
    // `&x` where a parameter is a `&dyn I`: the pair is built here, once every formal type is known
    // (the argument expression on its own cannot know what it will be passed as).
    for i in argtypes.len() {
        if i < count {
            formal := c.params[template_first + i];
            mut expected = formal;
            if types != 0 {
                expected = bind_types(&mut c, formal, &map);
            }
            if (borrowed_object(&mut c, expected) != 0) & (borrowed_object(&mut c, argtypes[i]) == 0) {
                pair := borrow_dyn(&mut c, val(args[i], argtypes[i]), expected);
                exchange(&mut args[i], pair.t);
                exchange(&mut argtypes[i], pair.ty);
                exchange(&mut sources[i], pair.t);
            }
        }
    }
    for j in deferred.len() / 11 {
        base := j * 11;
        index := deferred[base];
        start := deferred[base + 1];
        end := deferred[base + 2];
        exchange(&mut c.lit_start, deferred[base + 3]);
        exchange(&mut c.lit_end, deferred[base + 4]);
        exchange(&mut c.lit_value, deferred[base + 5]);
        exchange(&mut c.lit_negative, deferred[base + 6]);
        exchange(&mut c.flit_start, deferred[base + 7]);
        exchange(&mut c.flit_end, deferred[base + 8]);
        exchange(&mut c.flit_tok, deferred[base + 9]);
        exchange(&mut c.flit_neg, deferred[base + 10]);
        expected := bind_types(&mut c, c.params[template_first + index], &map);
        v := adopt_value(&mut c, val(args[index], argtypes[index]), start, end, expected);
        slot := v.t;
        actual := v.ty;
        require_type(&mut c, actual, expected);
        exchange(&mut args[index], slot);
        exchange(&mut argtypes[index], actual);
        exchange(&mut sources[index], slot);
    }
    // A direct Grail call may enter past the callee's checks when every refined parameter is
    // discharged here. A method call, an interface method solved to an implementation, and a foreign
    // call proved nothing about the code they reach, and keep the checked entry.
    mut proved = 0;
    // Every backend lifts the body and its checking wrapper as two ordinary functions (ref_wrapper),
    // so a proof is used wherever it is found.
    if (c.raw == 0) & (c.validating == 0) & (method == 0) & (c.funcs[f - 1].ext == 0) & (c.funcs[f - 1].contract == 0) {
        strict := u64(ref_strict(&c));
        proved = pv_call_proved(&mut c, f, count, &spans, call_at, strict);
    }
    return emit_resolved_call(&mut c, f, map, args, argtypes, sources, proved);
}
// Checked emission for parsed calls and compiler-prepared collection operations.
fn emit_resolved_call<a>(
    c: (&a mut C),
    index: u64,
    map: u64[],
    args: u64[],
    argtypes: u64[],
    sources: u64[],
    proved: u64
) -> Val {
    mut f = index;
    info := &c.funcs[f - 1];
    template_ret := info.ret;
    count := info.count;
    template_first := info.first;
    types := info.types;
    contract := info.contract;
    m := info.module.copy();
    name := info.name.copy();
    ext := info.ext;
    ffi_symbol := info.symbol.copy();
    require_constraints(&mut c, &map, &function_bounds(&c, f - 1));
    require_interfaces(&mut c, &map, &function_constraints(&c, f - 1));
    require_assoc_eqs(&mut c, f - 1, &map);
    // Inference binds types; it does not authorize erasing callable lifetime contracts.
    if c.raw == 0 {
        for i in count {
            formal := c.params[template_first + i];
            mut expected = formal;
            if types != 0 {
                expected = bind_types(&mut c, formal, &map);
            }
            actual := argtypes[i];
            require_type(&mut c, actual, expected);
        }
    }
    mut ret = template_ret;
    mut first = template_first;
    mut signature_ret = template_ret;
    mut symbol = name.copy();
    mut destination = m.copy();
    if types != 0 {
        ret = bind_types(&mut c, template_ret, &map);
        signature_ret = ret;
        if (c.validating == 0) & (contract == 0) {
            index := specialize(&mut c, f - 1, &map);
            symbol = special_name(&mut c, index);
            spec := &c.specs[index];
            first = spec.first;
            signature_ret = spec.ret;
        } else {
            first = c.params.len();
            for i in count {
                bound := bind_types(&mut c, c.params[template_first + i], &map);
                c.params.push(bound);
            }
        }
    }
    // Through an interface object the method is the vtable's entry: 1 + its index.
    mut dyn_entry = 0;
    mut dyn_pair = 0;
    if contract != 0 {
        if c.validating == 0 {
            self := map[0];
            selfbase := base_type(&mut c, self);
            mut object = 0;
            if ty_kind(&mut c, selfbase) == 33 {
                object = ty_arg(&mut c, selfbase);
            }
            if ty_kind(&mut c, selfbase) == 35 {
                // `&dyn I`: Self is the borrowed-object marker, whose argument is the `dyn` type.
                object = ty_arg(&mut c, ty_arg(&mut c, selfbase));
                dyn_pair = 1;
            }
            if object != 0 {
                methods := dyn_methods(&mut c, object);
                for j in methods.len() {
                    // The method of `contract` (the interface itself or a super) of that name.
                    if (dyn_entry == 0) && same(view(c.funcs[methods[j]].name), view(name)) && same(view(c.funcs[methods[j]].module), view(private_module(view(".interface_"), contract))) {
                        dyn_entry = j + 2;
                    }
                }
            } else {
                actual := resolve_interface_method(&mut c, contract, self, view(name));
                destination = c.funcs[actual].module.copy();
                mut own = u64[];
                for k in 1..map.len() {
                    own.push(map[k]);
                }
                symbol = interface_symbol(&mut c, contract, self, actual, &own);
            }
        }
    }
    // A foreign call is the unsafe boundary: it is rejected outside `unsafe`.
    // Scalars cross by value in the C argument registers, so no Grail storage is
    // moved, bonded or cleaned up by the call itself.
    if ext != 0 {
        if (c.raw == 0) & (c.unsafe_depth == 0) {
            fail(&mut c, view("extern C call requires an unsafe block"));
        }
        if ext == 2 {
            exchange(&mut c.ffi_fixed, count);
        }
        for bi in c.ffi_blocking.len() {
            if same(view(c.ffi_blocking[bi]), view(ffi_symbol)) {
                c.ffi_block_now = 1;
            }
        }
        for bi in c.ffi_nonblocking.len() {
            if same(view(c.ffi_nonblocking[bi]), view(ffi_symbol)) {
                c.ffi_block_now = 2;
            }
        }
        // The declared parameter types decide which arguments cross by value (`byval`); the values
        // were checked against them above.
        mut formals = u64[];
        for i in count {
            formals.push(c.params[template_first + i]);
        }
        return ffi_emit_call(&mut c, &args, &argtypes, &formals, ret, view(ffi_symbol), 0);
    }
    for i in args.len() {
        slot := args[i];
        ty := argtypes[i];
        move_out(&mut c, val(slot, ty));
    }
    // `Some(x)` and `None` of an inline option are written in place, not called: the tag and the
    // payload words into frame words of this site (core::some / core::none, stage 5).
    if (c.raw == 0) & same(view(m), view("core")) & (same(view(name), view("some")) || same(view(name), view("none"))) && framed(&mut c, ret) {
        od := ty_arg(&mut c, base_type(&mut c, ret));
        some := success_variant(&mut c, od);
        mut slot = 0;
        if same(view(name), view("some")) {
            tag := imm(&mut c, some);
            slot = enum_frame(&mut c, tag, args[0], ret, argtypes[0]);
        } else {
            tag := imm(&mut c, 1 - some);
            zero := imm(&mut c, 0);
            slot = enum_frame(&mut c, tag, zero, ret, 1);
        }
        own(&mut c, slot, ret);
        mut none_lent = u64[];
        captured_bonds(&mut c, val(slot, ret), &map, &sources, &argtypes, &none_lent);
        call_bonds(&mut c, val(slot, ret), first, &sources, signature_ret);
        return val(slot, ret);
    }
    mut sent = args.copy();
    dest := call_dest(&mut c, ret);
    if dest != 0 {
        sent.push(dest);
    }
    area := load_call_args(&mut c, &sent, 0);
    if dyn_entry != 0 {
        if dyn_pair != 0 {
            // A borrowed object's receiver is the handle to its pair: word 0 is the value (the
            // `&Self` the implementation expects) and word 1 the vtable.
            o(&mut c, view("movq 8(%rdi),%rax\nmovq "));
            on(&mut c, (dyn_entry - 1) * 8);
            o(&mut c, view("(%rax),%rax\nmovq (%rdi),%rdi\n"));
            call_slot_out(&mut c, view("call *%rax\n"), view(iface_reason(&mut c, contract)));
        } else {
            // The receiver is a reference to the object's slot: the cell it holds starts with the
            // value, so the cell is the `&Self` the implementation expects; word 1 is the vtable.
            o(&mut c, view("movq (%rdi),%rdi\nmovq 8(%rdi),%rax\nmovq "));
            on(&mut c, (dyn_entry - 1) * 8);
            o(&mut c, view("(%rax),%rax\n"));
            call_slot_out(&mut c, view("call *%rax\n"), view(iface_reason(&mut c, contract)));
        }
    } else {
        callee := mangle_name(&mut c, view(destination), view(symbol));
        // A direct call whose refined parameters were all proved enters past the checks. Anything
        // indirect (a vtable's entry, a function value) proved nothing, and a call through an
        // interface may reach an implementation with predicates of its own.
        // `--verify-facts` keeps the check the proof removed, so the call keeps the checked entry.
        if (proved != 0) & (dyn_entry == 0) & (contract == 0) & (c.verify_facts == 0) {
            call_proved_out(&mut c, view(callee));
        } else {
            call_out(&mut c, view(callee));
        }
    }
    release_call_args(&mut c, area);
    slot := save_result(&mut c, ret);
    own(&mut c, slot, ret);
    shape_pair_result(&mut c, slot, ret);
    call_writebacks(&mut c, first, &sources, &argtypes);
    // Before call_bonds, whose close_loans ends the loans of arguments the call consumed.
    // A closure given for a callable-bound parameter that is not `Owned` is lent for the call, as an
    // `Fn(..)` parameter is (stage 3): the result cannot hold it.
    mut lent = u64[];
    for j in map.len() {
        if j < c.funcs[f - 1].constraints.len() {
            set := copy_numbers(&c.funcs[f - 1].constraints[j]);
            bound := callable_in(&set);
            if (bound != NO_TYPE) && ((ty_mode(&mut c, bound) & CLOSURE_OWNED) == 0) {
                lent.push(map[j]);
            }
        }
    }
    captured_bonds(&mut c, val(slot, ret), &map, &sources, &argtypes, &lent);
    call_bonds(&mut c, val(slot, ret), first, &sources, signature_ret);
    return val(slot, ret);
}
// A generic function's result may carry the lifetimes of its type arguments (Rust's rule for a
// returned `impl Trait`): `map(refs(&v), f)` returns an `Iter<u64>` whose closure still reads `v`.
// So the result holds the loans of every argument whose actual type carries one of them, and `v`
// stays borrowed while the result lives (validate_return allows the same lifetimes).
fn captured_bonds<a, b, d, e, g>(c: (&a mut C), result: Val, map: (&b u64[]), sources: (&d u64[]), argtypes: (&e u64[]), lent: (&g u64[])) -> unit {
    if (c.raw != 0) || (map.len() == 0) {
        return ();
    }
    // Only when a type argument holds a borrow: otherwise the result can carry none. A closure lent
    // to a callable-bound parameter does not count.
    mut borrowed = false;
    for i in map.len() {
        if map[i] != NO_TYPE {
            t := map[i];
            mut is_lent = false;
            for q in lent.len() {
                if lent[q] == t {
                    is_lent = true;
                }
            }
            if !is_lent && contains_borrow(&mut c, t, 0) {
                borrowed = true;
            }
        }
    }
    if !borrowed {
        return ();
    }
    holder := place_of(&mut c, result.t);
    if holder == 0 {
        return ();
    }
    aggregate := ty_kind(&mut c, result.ty) != 5;
    for i in sources.len() {
        if i < argtypes.len() {
            t := argtypes[i];
            mut is_lent = false;
            for q in lent.len() {
                if lent[q] == t {
                    is_lent = true;
                }
            }
            if is_lent {
                continue;
            }
            // A reference argument is lent for the call only; what it points at is the caller's.
                    if (ty_kind(&mut c, t) != 7) && contains_borrow(&mut c, t, 0) {
                source := place_of(&mut c, sources[i]);
                if source != 0 {
                    return_bonds(&mut c, source, holder, u64(aggregate));
                }
            }
        }
    }
    return ();
}
fn specialized_function_value<a>(c: (&a mut C), index: u64, map: u64[]) -> Val {
    // A foreign declaration names a C symbol, not a Grail callable: its address
    // type is a C function pointer, which is a separate (later) increment. Refuse
    // rather than manufacture a Grail function value with a mangled name.
    foreign := c.funcs[index].ext;
    if foreign != 0 {
        fail(&mut c, view("extern C declarations are not Grail function values"));
    }
    f := &c.funcs[index];
    types := f.types;
    raw := f.raw;
    first := f.first;
    count := f.count;
    ret := f.ret;
    m := f.module.copy();
    name := f.name.copy();
    contract := f.contract;
    if raw != 0 && c.raw == 0 {
        fail(&mut c, view("unsafe runtime function cannot be a safe callable value"));
    }
    if map.len() != types {
        fail(&mut c, view("function value type argument count"));
    }
    for i in map.len() {
        if map[i] == NO_TYPE {
            fail(&mut c, view("generic function values need explicit type arguments"));
        }
    }
    require_constraints(&mut c, &map, &function_bounds(&c, index));
    require_interfaces(&mut c, &map, &function_constraints(&c, index));
    require_assoc_eqs(&mut c, index, &map);
    mut params = u64[];
    for i in count {
        bound := bind_types(&mut c, c.params[first + i], &map);
        params.push(bound);
    }
    result := bind_types(&mut c, ret, &map);
    ty := intern_args(&mut c, 12, result, 0, u64[], params);
    if c.validating != 0 {
        return val(imm(&mut c, 0), ty);
    }
    if contract != 0 {
        self := map[0];
        actual := resolve_interface_method(&mut c, contract, self, view(name));
        module := c.funcs[actual].module.copy();
        mut own = u64[];
        for k in 1..map.len() {
            own.push(map[k]);
        }
        symbol := interface_symbol(&mut c, contract, self, actual, &own);
        o(&mut c, view("leaq "));
        mangle(&mut c, view(module), view(symbol));
        o(&mut c, view("(%rip),%rax\n"));
        return val(save(&mut c), ty);
    }
    spec := specialize(&mut c, index, &map);
    symbol := special_name(&mut c, spec);
    o(&mut c, view("leaq "));
    mangle(&mut c, view(m), view(symbol));
    o(&mut c, view("(%rip),%rax\n"));
    return val(save(&mut c), ty);
}
fn function_value<a>(c: (&a mut C), index: u64) -> Val {
    // A foreign *declaration* is a C symbol, not a Grail callable, so it cannot
    // become a mangled address. An `extern "C" fn` *definition* is C-callable and
    // yields a `cfn` value: its symbol is already the C name.
    foreign := c.funcs[index].ext;
    if foreign == 1 {
        fail(&mut c, view("extern C declarations are not Grail function values"));
    }
    f := &c.funcs[index];
    types := f.types;
    raw := f.raw;
    first := f.first;
    count := f.count;
    result := f.ret;
    m := f.module.copy();
    name := f.name.copy();
    symbol := f.symbol.copy();
    if types != 0 {
        fail(
            &mut c,
            view("generic function values need explicit type arguments (for example identity<u64>)")
        );
    }
    if raw != 0 && c.raw == 0 {
        fail(&mut c, view("unsafe runtime function cannot be a safe callable value"));
    }
    mut params = u64[];
    for i in count {
        params.push(c.params[first + i]);
    }
    mut value_kind = 12;
    if foreign == 2 {
        value_kind = 25;
    }
    ty := intern_args(&mut c, value_kind, result, 0, u64[], params);
    o(&mut c, view("leaq "));
    if foreign == 2 {
        o(&mut c, view(symbol));
    } else {
        mangle(&mut c, view(m), view(name));
    }
    o(&mut c, view("(%rip),%rax\n"));
    return val(save(&mut c), ty);
}
// A function value used where a closure type `Fn(...)` is expected (Rust/Zig let any function be
// passed as a callable): a capture-free closure object {code, drop, target} whose code is the
// shared adapter `grail_fn_thunk` (emitted once, see emit_fn_thunk). The signatures must match up to
// renaming of lifetimes, so `fn less<a, b>(x: (&a T), y: (&b T))` is an `Fn(&T, &T) -> bool`.
fn function_as_closure<a>(c: (&a mut C), v: Val, expected: u64) -> Val {
    params := type_args(&mut c, v.ty);
    result := ty_arg(&mut c, v.ty);
    mode := ty_mode(&mut c, expected);
    as_closure := intern_args(&mut c, 20, result, mode, u64[], params);
    if same_type(&mut c, as_closure, expected) == 0 {
        return v;
    }
    decl := fn_value_decl(&mut c);
    record := intern_args(&mut c, 8, decl, 0, u64[], u64[]);
    sz := imm(&mut c, 3);
    obj := invoke(&mut c, view("rt_rec"), one(sz));
    o(&mut c, view("leaq grail_fn_thunk(%rip),%rax\n"));
    code := save(&mut c);
    rec_store(&mut c, obj, 0, code);
    o(&mut c, view("leaq "));
    drop_name(&mut c, record);
    o(&mut c, view("(%rip),%rax\n"));
    dropper := save(&mut c);
    rec_store(&mut c, obj, 1, dropper);
    rec_store(&mut c, obj, 2, v.t);
    exchange(&mut c.fn_thunk_used, 1);
    fn_use(&mut c, FN_THUNK);
    own(&mut c, obj, expected);
    return val(obj, expected);
}
// The record type of a function's closure object: {__code, __drop, target}, created once.
fn fn_value_decl<a>(c: (&a mut C)) -> u64 {
    for i in c.decls.len() {
        d := &c.decls[i];
        if same(view(d.module), view(".closure")) & same(view(d.name), view("FnValue")) {
            return i;
        }
    }
    first := c.fields.len();
    c.fields.push(Field { name: copy_bytes(view("__code")), ty: 0, pred: no_pred() });
    c.fields.push(Field { name: copy_bytes(view("__drop")), ty: 0, pred: no_pred() });
    c.fields.push(Field { name: copy_bytes(view("target")), ty: 0, pred: no_pred() });
    item_public_11 := c.decl_public;
    c
        .decls
        .push(
            Decl {
                public: item_public_11,
                module: copy_bytes(view(".closure")),
                name: copy_bytes(view("FnValue")), declared_at: u8[],
                is_enum: 0,
                opaque: 0,
                transfer: 0,
                share: 0,
                c_layout: 0,
                first: first,
                count: 3,
                drop: 0,
                regions: 0,
                types: 0,
                success: 0,
                bounds: u64[],
                constraints: u64[][],
            }
        );
    return c.decls.len() - 1;
}
// The adapter every function-as-closure calls: %rdi addresses the slot holding the object; the
// function's own arguments follow in %rsi.. (Fn types take at most five), so they shift down one
// register and the target is called; its result returns unchanged.
// The adapter the runtime calls in place of a function whose plain result it cannot keep: the
// runtime keeps one word, and the result is one or two words in rax:rdx or written to a destination
// (needs_dest). The adapter calls the function and returns a box holding the result. `kind` 0: the
// first argument addresses a cell holding the function, and the rest shift down one register; 1: a
// closure, whose first argument addresses the slot holding the object (word 0 the code), passed
// unchanged; 2: a task, whose first argument is a cell {function, item} replaced by the item and then
// freed. `args` is how many arguments the function itself receives. One per shape, shared.
fn result_adapter<a>(c: (&a mut C), kind: u64, args: u64, words: u64) -> u8[] {
    mut name = copy_bytes(view("grail_result_adapter_"));
    decimal(&mut name, kind);
    name.push(95);
    decimal(&mut name, args);
    name.push(95);
    decimal(&mut name, words);
    code := (kind * 16 + args) * 65536 + words;
    mut known = false;
    for i in c.box_thunks.len() {
        if c.box_thunks[i] == code {
            known = true;
        }
    }
    if !known {
        c.box_thunks.push(code);
    }
    return name;
}
fn emit_box_thunks<a>(c: (&a mut C)) -> unit {
    if c.box_thunks.len() == 0 {
        return ();
    }
    o(&mut c, view(".text\n"));
    for i in c.box_thunks.len() {
        code := c.box_thunks[i];
        words := code % 65536;
        args := (code / 65536) % 16;
        kind := code / 1048576;
        name := result_adapter(&mut c, kind, args, words);
        weak_def(&mut c);
        push_bytes(&mut c.out, view(name));
        c.out.push(10);
        push_bytes(&mut c.out, view(name));
        // -8..-32 the incoming argument registers, -40 the result box, -48 the task cell.
        o(&mut c, view(":\npushq %rbp\nmovq %rsp,%rbp\nsubq $48,%rsp\nmovq %rdi,-8(%rbp)\nmovq %rsi,-16(%rbp)\nmovq %rdx,-24(%rbp)\nmovq %rcx,-32(%rbp)\n"));
        big := words > 2;
        if big {
            o(&mut c, view("movq $"));
            on(&mut c, words * 8);
            o(&mut c, view(",%rdi\ncall rt_alloc\nmovq %rax,-40(%rbp)\n"));
        }
        o(&mut c, view("movq -8(%rbp),%rdi\nmovq -16(%rbp),%rsi\nmovq -24(%rbp),%rdx\nmovq -32(%rbp),%rcx\n"));
        if kind == 0 {
            o(&mut c, view("movq (%rdi),%rax\nmovq %rsi,%rdi\nmovq %rdx,%rsi\nmovq %rcx,%rdx\n"));
        } else if kind == 1 {
            o(&mut c, view("movq (%rdi),%rax\nmovq (%rax),%rax\n"));
        } else {
            o(&mut c, view("movq %rdi,-48(%rbp)\nmovq (%rdi),%rax\nmovq 8(%rdi),%rdi\n"));
        }
        // A result the runtime can keep as it is (words 0) passes through in rax.
        pass := words == 0;
        if big {
            o(&mut c, view("movq -40(%rbp),"));
            o(&mut c, view(argreg(args)));
            c.out.push(10);
        }
        o(&mut c, view("call *%rax\n"));
        if !big {
            o(&mut c, view("movq %rax,-40(%rbp)\nmovq %rdx,-32(%rbp)\n"));
        }
        if kind == 3 {
            o(&mut c, view("movq -48(%rbp),%rax\nmovq 8(%rax),%rdi\ncall rt_free\n"));
        }
        if kind >= 2 {
            o(&mut c, view("movq -48(%rbp),%rdi\ncall rt_free\n"));
        }
        if big || pass {
            o(&mut c, view("movq -40(%rbp),%rax\n"));
        } else {
            o(&mut c, view("leaq -40(%rbp),%rdi\nmovq $"));
            on(&mut c, words * 8);
            o(&mut c, view(",%rsi\ncall rt_flat_box\n"));
        }
        o(&mut c, view("leave\nret\n"));
    }
    return ();
}
fn emit_fn_thunk<a>(c: (&a mut C)) -> unit {
    if c.fn_thunk_used == 0 {
        return ();
    }
    part(&mut c, view("runtime"));
    if own_object(&c) {
        o(&mut c, view(".globl grail_fn_thunk\n"));
    }
    o(&mut c, view("grail_fn_thunk:\npushq %rbp\nmovq %rsp,%rbp\nmovq (%rdi),%rax\nmovq 16(%rax),%rax\n"));
    o(&mut c, view("movq %rsi,%rdi\nmovq %rdx,%rsi\nmovq %rcx,%rdx\nmovq %r8,%rcx\nmovq %r9,%r8\ncall *%rax\nleave\nret\n"));
    return ();
}
// Calling an `FnMut` value needs exclusive access to the closure: its environment is reachable
// only through that value, so a second call (or a live shared borrow of the closure) would alias
// what the first one writes. The loan is taken on the closure's own storage and ends when the call
// returns; bonding it to that storage keeps `close_loans` from ending it early while the arguments
// are evaluated.
fn call_access<a>(c: (&a mut C), slot: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    place := place_of(&mut c, slot);
    if place == 0 {
        return 0;
    }
    authority := authority_of(&mut c, slot);
    mut loan = 0;
    if authority != 0 {
        parent := authority_loan(&mut c, authority, place);
        if parent == 0 {
            fail(&mut c, view("closure call has no live reference authority"));
        }
        loan = ownership::reborrow_place(&mut c.check, parent, place, 1);
    } else {
        loan = ownership::borrow_place(&mut c.check, place, 1);
    }
    if loan == 0 {
        fail(
            &mut c,
            view("calling a FnMut closure needs exclusive access to the closure: it is already borrowed or being called")
        );
    }
    bond(&mut c, place, loan);
    return loan;
}
// A shared read succeeds while a shared loan lives, so an exclusive loan on the closure (a live
// `&mut f`, or an enclosing call of the same closure) is what a call has to reject here: say which.
fn call_conflict<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    if authority_of(&mut c, slot) != 0 {
        return ();
    }
    if ownership::read(&c.check, place) == 3 {
        fail(
            &mut c,
            view("calling a FnMut closure needs exclusive access to the closure: it is already borrowed or being called")
        );
    }
    return ();
}
// The binding that holds an `FnMut` closure must itself be exclusive: `mut f = |...|` for a local,
// a `&mut` reference for a value reached through one.
fn require_exclusive_call<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if binding_mode(&c, slot) == 1 {
        fail(
            &mut c,
            view("calling a FnMut closure needs a mutable binding (write: mut f = |...| { ... })")
        );
    }
    require_mutable_binding(&mut c, slot, 0);
    return ();
}
// The symbol of the body of the closure expression whose own type `ty` is, or empty: a closure type
// from a signature (no environment) could hold any closure.
fn closure_body_symbol<a>(c: (&a mut C), ty: u64) -> u8[] {
    if ty_kind(&mut c, ty) != 20 {
        return u8[];
    }
    env := ty_env(&mut c, ty);
    if env == 0 {
        return u8[];
    }
    d := ty_arg(&mut c, env);
    for i in c.closures.len() {
        if (c.closures[i].decl == d) && (c.closures[i].symbol.len() != 0) {
            symbol := c.closures[i].symbol.copy();
            return mangle_name(&mut c, view(".closure"), view(symbol));
        }
    }
    return u8[];
}
fn indirect_call<a>(c: (&a mut C), value: Val, opened: u64) -> Val {
    input := value.t;
    inty := value.ty;
    callee := deref(&mut c, value);
    pointer := callee.t;
    ty := callee.ty;
    kind := ty_kind(&mut c, ty);
    if (kind != 12) & (kind != 20) & (kind != 25) {
        fail(&mut c, view("expression is not callable"));
    }
    // An `FnMut` closure writes its environment through this value, so the call borrows it
    // exclusively for the whole call. A closure with no written capture stays `Fn`: reading it
    // through a shared reference and calling it repeatedly is still allowed.
    mut call_loan = 0;
    if (kind == 20) & ((ty_mode(&mut c, ty) & CLOSURE_FNMUT) != 0) {
        require_exclusive_call(&mut c, pointer);
        call_conflict(&mut c, pointer);
        observe(&mut c, pointer);
        call_loan = call_access(&mut c, pointer);
    } else {
        observe(&mut c, pointer);
    }
    get(&mut c, pointer, view("%rax"));
    // Closures: code is word 0 of the object; the hidden first argument points at the slot holding it.
    mut envp = 0;
    mut shift = 0;
    if kind == 20 {
        o(&mut c, view("movq (%rax),%rax\n"));
        shift = 1;
        if ty_kind(&mut c, inty) == 7 {
            get(&mut c, input, view("%rax"));
        } else {
            o(&mut c, view("leaq "));
            stack_slot(&mut c, pointer);
            o(&mut c, view(",%rax\n"));
        }
        envp = save(&mut c);
        get(&mut c, pointer, view("%rax"));
        o(&mut c, view("movq (%rax),%rax\n"));
    }
    target := save(&mut c);
    resulttype := ty_arg(&mut c, ty);
    signature := type_args(&mut c, ty);
    first := c.params.len();
    for i in signature.len() {
        c.params.push(signature[i]);
    }
    mut args = u64[];
    mut sources = u64[];
    mut types = u64[];
    // Arguments a C function pointer only borrows: a C-layout record travels as a pointer to its
    // fields (or as a copy of them, for a `byval` parameter), and Grail keeps ownership - the same
    // rule a direct extern call follows.
    mut shared = u64[];
    cfn_call := kind == 25;
    if opened == 0 {
        expect(&mut c, view("("));
    }
    if !eat(&mut c, view(")")) {
        while true {
            index := args.len();
            if !(index < signature.len()) {
                fail(&mut c, view("callable arity mismatch"));
            }
            // A named argument needs a declaration to read the names from, and a call through a
            // function value has none: the signature is a type, whose parameters are unnamed.
            // Refused here, before `x` would be read as a value and reported as an unknown name.
            mut named_ahead = 0;
            if kind_at(&mut c, c.pos) == 1 {
                if kind_at(&mut c, c.pos + 1) == 58 {
                    named_ahead = 1;
                }
            }
            if named_ahead != 0 {
                fail(
                    &mut c,
                    view("named arguments need a declared parameter list: this call goes through a function value, whose parameters have no names")
                );
            }
            astart := c.pos;
            // A reference or view binding passed by name is reborrowed, not moved, exactly as at a
            // direct call (reborrow_argument): `k(x)` leaves `x` usable afterwards.
            mut value = val(0, 0);
            mut reborrow = reborrow_argument(&mut c);
            if reborrow != 0 {
                // Only references take this path here: a view argument is already a copy the
                // closure's parameter type expects.
                arg_name := tok_text(&mut c, c.pos);
                l := find_local(&mut c, view(arg_name));
                lty := local_ty(&mut c, l - 1);
                if ty_kind(&mut c, lty) != 7 {
                    reborrow = 0;
                }
            }
            if reborrow != 0 {
                value = place(&mut c, reborrow - 1, 0);
            } else {
                value = expr(&mut c, 0);
            }
            aend := c.pos;
            expected := signature[index];
            if c.raw == 0 {
                value = adopt_value(&mut c, value, astart, aend, expected);
            }
            mut slot = value.t;
            mut actual = value.ty;
            if (actual == 0
                    || ((c.lit_negative != 0) && c.lit_start == astart && c.lit_end == aend))
                && literal_target(&mut c, expected) {
                if adopt_literal(&mut c, astart, aend, expected) {
                    actual = expected;
                }
            }
            require_type(&mut c, actual, expected);
            kind := ty_kind(&mut c, actual);
            if (kind == 5) || (kind == 7) || (kind == 27) {
                observe(&mut c, slot);
            }
            if kind == 7 {
                place := target_of(&mut c, slot);
                capture_authority(&mut c, place);
            }
            mut borrowed = 0;
            if kind == 8 {
                d := ty_arg(&mut c, actual);
                if c.decls[d].c_layout != 0 {
                    observe(&mut c, slot);
                    borrowed = 1;
                    shared.push(slot);
                }
            }
            if cfn_call & (c.raw == 0) & (ffi_record_out_param(&mut c, expected) != 0) {
                // `&mut R` through a C function pointer is the C `R *`, exactly as at a direct
                // extern call: the word that crosses is the record's own address, loaded through
                // the borrow, and C's writes land in the record.
                place := target_of(&mut c, slot);
                if borrowed_temporary(&mut c, place) {
                    fail(
                        &mut c,
                        view("an extern C out-parameter needs a binding to write into; a temporary record would be discarded")
                    );
                }
                ownership::filled(&mut c.check, place);
                x := deref(&mut c, val(slot, actual));
                slot = x.t;
                borrowed = 1;
                shared.push(slot);
            }
            sources.push(slot);
            types.push(actual);
            mut held = val(slot, actual);
            if borrowed == 0 {
                held = move_value(&mut c, value);
            }
            args.push(held.t);
            if eat(&mut c, view(")")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    if args.len() != signature.len() {
        fail(&mut c, view("callable arity mismatch"));
    }
    for i in args.len() {
        slot := args[i];
        actual := types[i];
        mut borrowed = 0;
        for j in shared.len() {
            if shared[j] == slot {
                borrowed = 1;
            }
        }
        if borrowed == 0 {
            move_out(&mut c, val(slot, actual));
        }
    }
    if kind == 25 {
        // A C function pointer is called with the platform's C convention, exactly like a direct
        // extern call (floats, narrow integers, stack arguments, Win64, the host-TLS bridge).
        result := ffi_emit_call(&mut c, &args, &signature, &signature, resulttype, view(""), target);
        rslot := result.t;
        call_writebacks(&mut c, first, &sources, &types);
        call_bonds(&mut c, val(rslot, resulttype), first, &sources, resulttype);
        release_temporary(&mut c, input);
        return val(rslot, resulttype);
    }
    dest := call_dest(&mut c, resulttype);
    if dest != 0 {
        args.push(dest);
    }
    area := load_call_args(&mut c, &args, shift);
    if shift != 0 {
        get(&mut c, envp, view("%rdi"));
    }
    // A closure whose type is a closure expression's own (its environment record names it: a local
    // closure, or a generic `F` bound to one) is called directly, so the optimiser can inline it:
    // the code word would only ever hold this body (docs/design/dyn-and-callable-bounds.md, 2b).
    body := closure_body_symbol(&mut c, ty);
    if (kind == 20) && (body.len() != 0) && (c.raw == 0) {
        call_out(&mut c, view(body));
    } else {
        get(&mut c, target, view("%rax"));
        call_slot_out(&mut c, view("call *%rax\n"), view("a function value"));
    }
    release_call_args(&mut c, area);
    slot := save_result(&mut c, resulttype);
    own(&mut c, slot, resulttype);
    shape_pair_result(&mut c, slot, resulttype);
    call_writebacks(&mut c, first, &sources, &types);
    result_caps := type_caps(&mut c, resulttype, 0);
    if (kind == 20) & (result_caps.len() != 0) {
        // A closure that returns a reference returns one into what it captured: the result holds
        // the closure's own loans (an adapter yielding `&a T` out of the vector it borrowed).
        callee_place := place_of(&mut c, pointer);
        result_place := place_of(&mut c, slot);
        // A result that is itself a reference takes the loans as its source (role 0, so
        // stored_source can find what it points into); anything holding one aggregates them.
        mut role = 1;
        if ty_kind(&mut c, resulttype) == 7 {
            role = 0;
        }
        if (callee_place != 0) & (result_place != 0) {
            n := c.bonds.len();
            for i in n {
                holder := c.bonds[i].holder;
                loan := c.bonds[i].loan;
                if (loan_live(&mut c, loan) != 0) && ownership::ancestor(&c.check, callee_place, holder) {
                    bond_kind(&mut c, result_place, loan, role);
                }
            }
        }
    }
    call_bonds(&mut c, val(slot, resulttype), first, &sources, resulttype);
    release_temporary(&mut c, input);
    if call_loan != 0 {
        ownership::end_loan(&mut c.check, call_loan);
    }
    return val(slot, resulttype);
}
fn builtin_id<a>(n: &a [u8]) -> u64 {
    if same(view(n), view("Atomic")) {
        return 30;
