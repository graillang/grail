        // enums: equal tags, then equal payloads of that variant
        result := imm(&mut c, 0);
        done := label(&mut c);
        ta := rec_load(&mut c, x, 0, 0);
        tb := rec_load(&mut c, y, 0, 0);
        get(&mut c, tb, view("%rcx"));
        get(&mut c, ta, view("%rax"));
        o(&mut c, view("cmpq %rcx,%rax\n"));
        jump(&mut c, view("jne"), done);
        for i in count {
            pty := field_type(&mut c, ty, i);
            next := label(&mut c);
            o(&mut c, view("movabsq $"));
            on(&mut c, i);
            o(&mut c, view(",%rcx\n"));
            get(&mut c, ta, view("%rax"));
            o(&mut c, view("cmpq %rcx,%rax\n"));
            jump(&mut c, view("jne"), next);
            mut sub = 0;
            if pty == 1 {
                sub = imm(&mut c, 1);
            } else {
                a := rec_load(&mut c, x, 1, 0);
                alias_field(&mut c, a, pty, x, 1, 1);
                observe(&mut c, a);
                b := rec_load(&mut c, y, 1, 0);
                alias_field(&mut c, b, pty, y, 1, 1);
                observe(&mut c, b);
