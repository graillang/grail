        ck := ty_kind(&mut c, captured.ty);
        if ((ck == 5) || (ck == 7) || (ck == 27)) && (ty_mode(&mut c, captured.ty) == 0) && (c.validating == 0) {
            nk := kind(&mut c);
            if (nk != 91) && (nk != 46) {
                field := capture_field(&mut c, view(first), 1, 0);
                return deref_value(&mut c, field);
            }
        }
        return captured;
    }
    constant := constant_value(&mut c, view(m), view(first));
    if constant.ty != NO_TYPE {
        return constant;
    }
    st := static_value(&mut c, view(m), view(first));
    if st.ty != NO_TYPE {
        return st;
    }
    vp := value_param(&mut c, view(first));
    if vp != 0 {
        v := value_param_value(&mut c, vp - 1);
        exchange(&mut c.ct_unbound, 0);
        mut vty = c.type_bounds[vp - 1] / 8;
        return val(imm(&mut c, v.value), vty);
    }
    function := find_func(&mut c, view(m), view(first));
    if function != 0 {
        return function_value(&mut c, function - 1);
    }
    mut r = find_decl(&mut c, view(m), view(first));
    if r != 0 {
        return record(&mut c, r - 1, NO_TYPE);
    }
    // A statement word here is a statement written where a value is required: say that, rather than
    // reporting a name that no binding has (an `if`/`match` reaches its own expression form above).
    if statement_head(view(first)) || same(view(first), view("else")) {
        mut said = copy_bytes(view("`"));
        push_bytes(&mut said, view(first));
        push_bytes(&mut said, view("` is a statement, not an expression: it has no value"));
        diag_help(&mut c, view("write it as a statement; an expression position needs a value"));
        fail(&mut c, view(said));
        return val(0, 0);
    }
    // Point at the name itself, and offer the closest one in scope.
    mut back = c.pos;
    while (0 < back) & !((kind_at(&mut c, back) == 1) & same(view(tok_text(&mut c, back)), view(first))) {
        back -= 1;
    }
    exchange(&mut c.pos, back);
    guess := suggest_name(&mut c, view(m), view(first));
    if guess.len() != 0 {
        mut help = copy_bytes(view("a name with a similar spelling is in scope: `"));
        push_bytes(&mut help, view(guess));
        push_bytes(&mut help, view("`"));
        diag_help(&mut c, view(help));
    }
    mut msg = copy_bytes(view("undefined name `"));
    push_bytes(&mut msg, view(first));
    push_bytes(&mut msg, view("`"));
    fail(&mut c, view(msg));
    return val(0, 0);
}
fn is_comparison(k: u64) -> bool {
    return (k == 258) || (k == 259) || (k == 60) || (k == 62) || (k == 269) || (k == 270);
}
fn prec(k: u64) -> u64 {
    if k == 274 {
        return 1;
    }
    if k == 273 {
        return 2;
    }
    if (k == 38) || (k == 124) {
        return 3;
    }
    if k == 94 {
        return 4;
    }
    if is_comparison(k) {
        return 5;
    }
    if (k == 271) || (k == 272) {
        return 6;
    }
    if (k == 43) || (k == 45) {
        return 7;
    }
    if (k == 42) || (k == 37) || (k == 47) {
        return 8;
    }
    if k == 267 {
        return 9;
    }
    return 0;
}
// `?` on `S |? F` yields the union of S and remaps each F by identity.
fn success_members<a>(c: (&a mut C), ty: u64) -> u64 {
    args := type_args(&mut c, ty);
    s := result_success_count(&mut c, ty);
    if s == 1 {
        return args[0];
    }
    mut members = u64[];
    for i in s {
        members.push(args[i]);
    }
    return make_union(&mut c, members, 0, copy_bytes(view(".union")), view("Union"));
}
fn propagate_result_union<a>(c: (&a mut C), x: Val, unwrap: u64) -> Val {
    xt := x.t;
    ty := x.ty;
    args := type_args(&mut c, ty);
    s := result_success_count(&mut c, ty);
    result := c.result;
    mut failure_targets = u64[];
    if unwrap == 0 {
        if !is_result_union(&mut c, result) {
            fail(&mut c, view("result propagation requires a result return type"));
        }
        returned := type_args(&mut c, result);
        rs := result_success_count(&mut c, result);
        for i in s..args.len() {
            mut found = 0;
            mut target = 0;
            for j in rs..returned.len() {
                if same_type(&mut c, args[i], returned[j]) != 0 {
                    found += 1;
                    target = j;
                }
            }
            if found != 1 {
                fail(&mut c, view("result failure type is not in the return failure set"));
            }
            failure_targets.push(target);
        }
    }
    success := label(&mut c);
    failure := label(&mut c);
    get(&mut c, xt, view("%rax"));
    o(&mut c, view("cmpq $"));
    on(&mut c, s);
    o(&mut c, view(",(%rax)\n"));
    jump(&mut c, view("jb"), success);
    jump(&mut c, view("jmp"), failure);
    // Failure path.
    before := ownership::snapshot(&c.check);
    mark(&mut c, failure);
    if unwrap != 0 {
        site_kind(&mut c, 6);
        call_out(&mut c, view("rt_abort"));
    } else {
        for i in s..args.len() {
            next := label(&mut c);
            get(&mut c, xt, view("%rax"));
            o(&mut c, view("cmpq $"));
            on(&mut c, i);
            o(&mut c, view(",(%rax)\n"));
            jump(&mut c, view("jne"), next);
            target := imm(&mut c, failure_targets[i - s]);
            move_out(&mut c, val(xt, ty));
            source := place_of(&mut c, xt);
            ns := retag_enum(&mut c, xt, target, result, ty);
            own(&mut c, ns, result);
            dest := place_of(&mut c, ns);
            transfer_bonds(&mut c, source, dest);
            validate_return(&mut c, val(ns, result));
            move_out(&mut c, val(ns, result));
            cleanup(&mut c, 0);
            return_value(&mut c, ns, result);
            o(&mut c, view("leave\nret\n"));
            mark(&mut c, next);
        }
        call_out(&mut c, view("rt_abort"));
    }
    ownership::restore(&mut c.check, &before);
    // Success path.
    mark(&mut c, success);
    sty := success_members(&mut c, ty);
    if s == 1 {
        payload := payload_load(&mut c, xt, ty, sty);
        move_out(&mut c, val(xt, ty));
        free_enum_shell(&mut c, xt, ty);
        source := place_of(&mut c, xt);
        own(&mut c, payload, sty);
        dest := place_of(&mut c, payload);
        transfer_bonds(&mut c, source, dest);
        stored_source(&mut c, payload, sty);
        return val(payload, sty);
    } else {
        tag := rec_load(&mut c, xt, 0, 0);
        move_out(&mut c, val(xt, ty));
        source := place_of(&mut c, xt);
        ns := retag_enum(&mut c, xt, tag, sty, ty);
        own(&mut c, ns, sty);
        dest := place_of(&mut c, ns);
        transfer_bonds(&mut c, source, dest);
        stored_source(&mut c, ns, sty);
        return val(ns, sty);
    }
}
// A union's first member is success; other members propagate by type.
fn propagate_union<a>(c: (&a mut C), x: Val, unwrap: u64) -> Val {
    xt := x.t;
    args := type_args(&mut c, x.ty);
    result := c.result;
    mut targets = u64[];
    if unwrap == 0 {
        if !is_union(&mut c, result) {
            fail(&mut c, view("union propagation requires a union return type"));
        }
        returned := type_args(&mut c, result);
        for i in args.len() {
            mut target = 0;
            mut found = 0;
            if i != 0 {
                for j in returned.len() {
                    if same_type(&mut c, args[i], returned[j]) != 0 {
                        found += 1;
                        target = j;
                    }
                }
            }
            if (i != 0) && ((found != 1) || (target == 0)) {
                fail(&mut c, view("union failure type is not a failure in return type"));
            }
            targets.push(target);
        }
    }
    get(&mut c, xt, view("%rax"));
    o(&mut c, view("cmpq $0,(%rax)\n"));
    ok := label(&mut c);
    jump(&mut c, view("je"), ok);
    before := ownership::snapshot(&c.check);
    if unwrap != 0 {
        site_kind(&mut c, 6);
        call_out(&mut c, view("rt_abort"));
    } else {
        endmap := label(&mut c);
        for i in args.len() {
            if i != 0 {
                next := label(&mut c);
                get(&mut c, xt, view("%rax"));
                o(&mut c, view("cmpq $"));
                on(&mut c, i);
                o(&mut c, view(",(%rax)\n"));
                jump(&mut c, view("jne"), next);
                o(&mut c, view("movq $"));
                on(&mut c, targets[i]);
                o(&mut c, view(",(%rax)\n"));
                jump(&mut c, view("jmp"), endmap);
                mark(&mut c, next);
            }
        }
        call_out(&mut c, view("rt_abort"));
        mark(&mut c, endmap);
        validate_return(&mut c, val(xt, x.ty));
        move_out(&mut c, val(xt, x.ty));
        cleanup(&mut c, 0);
        return_value(&mut c, xt, x.ty);
        o(&mut c, view("leave\nret\n"));
    }
    mark(&mut c, ok);
    ownership::restore(&mut c.check, &before);
    n := payload_load(&mut c, xt, x.ty, args[0]);
    move_out(&mut c, val(xt, x.ty));
    free_enum_shell(&mut c, xt, x.ty);
    ty := args[0];
    own(&mut c, n, ty);
    source := place_of(&mut c, xt);
    dest := place_of(&mut c, n);
    if contains_borrow(&mut c, ty, 0) {
        transfer_bonds(&mut c, source, dest);
    }
    stored_source(&mut c, n, ty);
    return val(n, ty);
}
// The success variant of a two-variant enum: the conventional names decide (`Ok`, `Some`),
// otherwise the first declared variant. So `enum Out<V, F> { Good(V), Bad(F) }` propagates `Good`,
// and `enum E { Err(F), Ok(T) }` still propagates `Ok` - the name-based rule is kept exactly where
// the names carry meaning, and declaration order answers everywhere else.
fn success_variant<a>(c: (&a mut C), d: u64) -> u64 {
    dd := &c.decls[d];
    fi := dd.first;
    f := &c.fields[fi];
    first := f.name.copy();
    s := &c.fields[fi + 1];
    last := s.name.copy();
    if same(view(first), view("Ok")) & same(view(last), view("Err")) {
        return 0;
    }
    if same(view(first), view("Err")) & same(view(last), view("Ok")) {
        return 1;
    }
    if same(view(first), view("Some")) & same(view(last), view("None")) {
        return 0;
    }
    if same(view(first), view("None")) & same(view(last), view("Some")) {
        return 1;
    }
    return 0;
}
// The operator a refusal is about: `?` propagates, `!` aborts. It starts the refusal message, which
// is why it is a value rather than a word inside each string.
fn propagate_operator(unwrap: u64) -> u8[] {
    if unwrap != 0 {
        return copy_bytes(view("`!`"));
    }
    return copy_bytes(view("`?`"));
}
// A shape with more than two members cannot answer which member is the failure, so `?`/`!` refuse
// it - naming the shape and every member, because "needs two members" without saying which shape
// was the unhelpful half of the old refusal.
fn refuse_shape_union<a>(c: (&a mut C), ty: u64, unwrap: u64) -> unit {
    members := type_args(&mut c, ty);
    mut said = propagate_operator(unwrap);
    push_bytes(&mut said, view(" needs a shape with one success member and one failure member; `"));
    for i in members.len() {
        if i != 0 {
            push_bytes(&mut said, view(" | "));
        }
        name := source_type_name(&mut c, members[i]);
        push_bytes(&mut said, view(name));
    }
    push_bytes(&mut said, view("` has "));
    decimal(&mut said, members.len());
    push_bytes(&mut said, view(" members"));
    fail(&mut c, view(said));
    return ();
}
fn refuse_shape_enum<a>(c: (&a mut C), ty: u64, d: u64, unwrap: u64) -> unit {
    count := c.decls[d].count;
    first := c.decls[d].first;
    mut said = propagate_operator(unwrap);
    push_bytes(&mut said, view(" needs a shape with one success member and one failure member; `"));
    name := source_type_name(&mut c, ty);
    push_bytes(&mut said, view(name));
    push_bytes(&mut said, view("` has "));
    decimal(&mut said, count);
    push_bytes(&mut said, view(" variants ("));
    for i in count {
        if i != 0 {
            push_bytes(&mut said, view(", "));
        }
        vname := c.fields[first + i].name.copy();
        push_bytes(&mut said, view(vname));
    }
    push_bytes(&mut said, view(")"));
    fail(&mut c, view(said));
    return ();
}
// `?` returns the failure member unchanged (payload layout is shared); `!` aborts on it. Any shape
// with exactly one success member and one failure member qualifies: a two-member enum, an ordinary
// two-member union, or a result union (`S |? F`). Which member is the success is decided once, by
// `success_variant` for an enum and by position for a union.
fn propagate<a>(c: (&a mut C), v: Val, unwrap: u64) -> Val {
    x := deref(&mut c, v);
    xt := x.t;
    if ty_kind(&mut c, x.ty) != 8 {
        mut said = propagate_operator(unwrap);
        push_bytes(&mut said, view(" needs a shape with one success member and one failure member; this value is not an enum or a union"));
        fail(&mut c, view(said));
    }
    if is_union(&mut c, x.ty) {
        // A result union (`S |? F`) states which members are failures, so `?` reads that partition
        // whatever its arity. An ordinary union does not: its only signal is position, which says
        // one success and one failure and nothing more, so a third member is refused rather than
        // guessed at.
        if is_result_union(&mut c, x.ty) {
            return propagate_result_union(&mut c, x, unwrap);
        }
        if unwrap == 0 {
            members := type_args(&mut c, x.ty);
            if members.len() != 2 {
                refuse_shape_union(&mut c, x.ty, unwrap);
            }
        }
        return propagate_union(&mut c, x, unwrap);
    }
    d := ty_arg(&mut c, x.ty);
    is_enum := c.decls[d].is_enum;
    variant_count := c.decls[d].count;
    if is_enum == 0 {
        mut said = propagate_operator(unwrap);
        push_bytes(&mut said, view(" needs a shape with one success member and one failure member; `"));
        name := source_type_name(&mut c, x.ty);
        push_bytes(&mut said, view(name));
        push_bytes(&mut said, view("` is a record"));
        fail(&mut c, view(said));
    }
    if variant_count != 2 {
        refuse_shape_enum(&mut c, x.ty, d, unwrap);
    }
    k := success_variant(&mut c, d);
    failure := 1 - k;
    get(&mut c, xt, view("%rax"));
    o(&mut c, view("cmpq $"));
    on(&mut c, k);
    o(&mut c, view(",(%rax)\n"));
    ok := label(&mut c);
    jump(&mut c, view("je"), ok);
    before := ownership::snapshot(&c.check);
    if unwrap != 0 {
        site_kind(&mut c, 6);
        call_out(&mut c, view("rt_abort"));
    } else {
        result := c.result;
        if is_option_storage(&mut c, x.ty) & is_option_storage(&mut c, result) {
            // The failure branch is None: it carries no payload and therefore no loan.
            // Rebuild it at the declared optional type rather than returning an
            // Option<&T> object whose conservative source bonds would escape.
            tag := imm(&mut c, failure);
            payload := imm(&mut c, 0);
            mut returned = 0;
            if framed(&mut c, result) {
                returned = enum_frame(&mut c, tag, payload, result, 1);
            } else {
                returned = invoke(&mut c, view("rt_enum"), two(tag, payload));
            }
            own(&mut c, returned, result);
            move_out(&mut c, val(returned, result));
            cleanup(&mut c, 0);
            return_value(&mut c, returned, result);
            o(&mut c, view("leave\nret\n"));
        } else {
            if c.raw == 0 {
                result := c.result;
                // The failure object is returned unchanged: allowed when the function returns the same enum
                // whose failure payload has the same type (the success payload is unused on this path).
                mut compatible = 0;
                if (ty_kind(&mut c, result) == 8) & (ty_arg(&mut c, result) == d) {
                    mine := field_type(&mut c, x.ty, failure);
                    theirs := field_type(&mut c, result, failure);
                    if same_type(&mut c, mine, theirs) != 0 {
                        compatible = 1;
                    }
                }
                if compatible == 0 {
                    require_type(&mut c, x.ty, result);
                }
            }
            validate_return(&mut c, val(xt, x.ty));
            move_out(&mut c, val(xt, x.ty));
            cleanup(&mut c, 0);
            return_value(&mut c, xt, x.ty);
            o(&mut c, view("leave\nret\n"));
        }
    }
    mark(&mut c, ok);
    ownership::restore(&mut c.check, &before);
    n := payload_load(&mut c, xt, x.ty, field_type(&mut c, x.ty, k));
    move_out(&mut c, val(xt, x.ty));
    free_enum_shell(&mut c, xt, x.ty);
    ty := field_type(&mut c, x.ty, k);
    own(&mut c, n, ty);
    source := place_of(&mut c, xt);
    dest := place_of(&mut c, n);
    if contains_borrow(&mut c, ty, 0) {
        transfer_bonds(&mut c, source, dest);
    }
    stored_source(&mut c, n, ty);
    return val(n, ty);
}
fn binary<a>(c: (&a mut C), k: u64, left: u64, right: u64) -> u64 {
    if k == 267 {
        mut f = "rt_pow";
        if c.overflow == 0 {
            f = "rt_wrapping_pow";
            fx_would_trap(&mut c, view("rt_pow"));
        }
        return invoke(&mut c, view(f), two(left, right));
    }
    mut p = 0;
    if is_comparison(k) {
        p = 3;
    }
    get(&mut c, right, view("%rcx"));
    get(&mut c, left, view("%rax"));
    if k == 43 {
        o(&mut c, view("addq %rcx,%rax\n"));
    }
    if k == 45 {
        o(&mut c, view("subq %rcx,%rax\n"));
    }
    if k == 42 {
        o(&mut c, view("mulq %rcx\n"));
    }
    // An overflow is a failure of the function in every build: the check is emitted only where the
    // build traps, and the effect is recorded either way, unless the facts proved that this
    // operation cannot overflow (pv_arith_proof). `--verify-facts` checks that proof at run time,
    // in either mode, without making it a failure the function answers for.
    proved := ((k == 43) || (k == 45)) && (c.pv_arith_ok != 0);
    exchange(&mut c.pv_arith_ok, 0);
    if (k == 43) || (k == 45) || (k == 42) {
        if proved {
            if c.verify_facts != 0 {
                ok := label(&mut c);
                jump(&mut c, view("jnc"), ok);
                site_kind(&mut c, 2);
                fx_called(&mut c);
                o(&mut c, view("call rt_abort\n"));
                mark(&mut c, ok);
            }
        } else {
            if c.overflow != 0 {
                ok := label(&mut c);
                jump(&mut c, view("jnc"), ok);
                site_kind(&mut c, 2);
                call_out(&mut c, view("rt_abort"));
                mark(&mut c, ok);
            } else {
                fx_would_trap(&mut c, view("rt_abort"));
            }
        }
    }
    if k == 38 {
        o(&mut c, view("andq %rcx,%rax\n"));
    }
    if k == 124 {
        o(&mut c, view("orq %rcx,%rax\n"));
    }
    if (k == 271) || (k == 272) {
        if c.overflow != 0 {
            limit := imm(&mut c, 63);
            get(&mut c, right, view("%rcx"));
            get(&mut c, limit, view("%rax"));
            o(&mut c, view("cmpq %rcx,%rax\n"));
            ok := label(&mut c);
            jump(&mut c, view("jnc"), ok);
            site_kind(&mut c, 2);
            call_out(&mut c, view("rt_abort"));
            mark(&mut c, ok);
            get(&mut c, right, view("%rcx"));
            get(&mut c, left, view("%rax"));
        } else {
            fx_would_trap(&mut c, view("rt_abort"));
        }
        mut op = "shlq";
        if k == 272 {
            op = "shrq";
        }
        o(&mut c, view(op));
        if (c.target == 0) || (c.target == 3) {
            o(&mut c, view(" %cl,%rax\n"));
        } else {
            o(&mut c, view(" %rcx,%rax\n"));
        }
    }
    if k == 94 {
        o(&mut c, view("xorq %rcx,%rax\n"));
    }
    if (k == 37) || (k == 47) {
        o(&mut c, view("testq %rcx,%rcx\n"));
        ok := label(&mut c);
        jump(&mut c, view("jnz"), ok);
        site_kind(&mut c, 5);
        call_out(&mut c, view("rt_abort"));
        mark(&mut c, ok);
        o(&mut c, view("xorq %rdx,%rdx\ndivq %rcx\n"));
