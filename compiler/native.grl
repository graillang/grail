    if same(read(n),read("text")) { return 6; }
    if same(read(n),read("at")) { return 7; }
    if same(read(n),read("slice")) { return 8; }
    if same(read(n),read("vec_push")) { return 9; }
    if same(read(n),read("vec_pop")) { return 10; }
    if same(read(n),read("vec_get")) { return 11; }
    if same(read(n),read("vec_get_mut")) { return 12; }
    if same(read(n),read("borrow")) { return 13; }
    if same(read(n),read("borrow_mut")) { return 14; }
    if same(read(n),read("load")) { return 15; }
    if same(read(n),read("exchange")) { return 16; }
    if same(read(n),read("print")) { return 17; }
    if same(read(n),read("println")) { return 18; }
    if same(read(n),read("raw_load")) { return 101; }
    if same(read(n),read("raw_store")) { return 102; }
    if same(read(n),read("raw_byte")) { return 103; }
    if same(read(n),read("raw_putbyte")) { return 104; }
    if same(read(n),read("raw_map")) { return 105; }
    if same(read(n),read("raw_state")) { return 106; }
    if same(read(n),read("raw_syscall")) { return 107; }
    return 0;
