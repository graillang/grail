        o(&mut c, view("cmpq %rcx,%rax\n"));
        if k == 258 {
            o(&mut c, view("sete %al\n"));
        }
        if k == 259 {
            o(&mut c, view("setne %al\n"));
        }
        if (k == 60) || (k == 62) || (k == 269) || (k == 270) {
