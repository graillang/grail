        t := &c.toks[i];
        kind := t.kind;
        st := t.start;
        en := t.end;
        if kind == 123 {
            depth = depth + 1;
        }
        // A scan can start inside an enclosing group; its closing brace ends this scope.
        if kind == 125 {
            if depth == 0 {
                break;
