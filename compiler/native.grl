                if defer == 0 {
                    mut r = resource(&mut c, slot);
                    if r != 0 {
                        info := &c.resources[r - 1];
                        place := info.place;
                        if place != 0 {
                            if ownership::can_cleanup(&c.check, place) {
                                if (k == 6) || (k == 8) {
                                    ownership::cleanup(&mut c.check, place);
                                    close_loans(&mut c);
                                } else {
                                    release(&mut c, r - 1);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return ();
}
// Bindings authorize writes to owned storage; explicit mutable capabilities authorize
// writes through their referents, without making the capability binding reassignable.
fn binding_mode<a>(c: (&a C), slot: u64) -> u64 {
    for i in c.locals.len() {
        entry := &c.locals[i];
        id := entry.id;
        mutable := entry.mutable;
        if id == slot {
            return mutable + 1;
        }
    }
    return 0;
}
fn require_mutable_binding<a>(c: (&a mut C), slot: u64, storage: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    mut current = slot;
    mut depth = 0;
    while depth < c.resources.len() + 1 {
        index := resource(&mut c, current);
        if index != 0 {
            mut r = &c.resources[index - 1];
            ty := r.ty;
            place := r.place;
            authority := r.authority;
            base := r.base;
            k := ty_kind(&mut c, ty);
            mode := ty_mode(&mut c, ty);
            if (k == 7) & (place != 0) {
                if mode != 0 {
                    return ();
                }
                fail(&mut c, view("mutation through readonly reference"));
            }
            if ((k == 5) || (k == 27)) && (storage == 0) {
                if mode != 0 {
                    return ();
                }
                fail(&mut c, view("mutation through readonly view"));
            }
            if authority != 0 {
                a := resource(&mut c, authority - 1);
                if a != 0 {
                    info := &c.resources[a - 1];
                    at := info.ty;
                    if ty_kind(&mut c, at) == 7 {
                        if ty_mode(&mut c, at) != 0 {
                            return ();
                        }
                        fail(&mut c, view("mutation through readonly frame"));
                    }
                }
            }
            binding := binding_mode(&c, current);
            if binding == 1 {
                fail(&mut c, view("owned storage mutation requires mut"));
            }
            if binding == 2 {
                return ();
            }
            if base == 0 {
                return ();
            }
            current = base - 1;
        } else {
            binding := binding_mode(&c, current);
            if binding == 1 {
                fail(&mut c, view("owned storage mutation requires mut"));
            }
            return ();
        }
        depth = depth + 1;
    }
    fail(&mut c, view("invalid mutation provenance"));
    return ();
}
fn require_write<a>(c: (&a mut C), slot: u64) -> unit {
    require_mutable_binding(&mut c, slot, 0);
    if c.raw != 0 {
        return ();
    }
    index := resource(&mut c, slot);
    if index == 0 {
        fail(&mut c, view("mutation target is not tracked"));
    }
    mut r = &c.resources[index - 1];
    ty := r.ty;
    place := r.place;
    authority := r.authority;
    target := r.target;
    k := ty_kind(&mut c, ty);
    if (k == 7) & (place == 0) {
        if authority != 0 {
            mut r = resource(&mut c, authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("write through readonly frame"));
            }
            loan := authority_loan(&mut c, authority, target);
            if loan == 0 {
                fail(&mut c, view("field write has no authority"));
            }
            if ownership::access_loan(&c.check, loan, target, 1) != 0 {
                fail(&mut c, view("field write conflicts with active loan"));
            }
        } else {
            if ownership::initialize(&mut c.check, target) != 0 {
                fail(
                    &mut c,
                    view("field assignment conflicts with live borrow or moved storage")
                );
            }
        }
        return ();
    }
    if (k == 5) || (k == 7) || (k == 27) {
        if ty_mode(&mut c, ty) == 0 {
            fail(&mut c, view("mutation through readonly reference"));
        }
        mut allowed = 0;
        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            holder := b.holder;
            loan := b.loan;
            guard := b.guard;
            if (guard == 0) & ownership::ancestor(&c.check, holder, place) {
                if loan_live(&mut c, loan) != 0 {
                    allowed = 1;
                    if ownership::use_loan(&c.check, loan, 1) != 0 {
                        fail(&mut c, view("write authority is suspended"));
                    }
                }
            }
        }
        if allowed == 0 {
            fail(&mut c, view("write lacks checked source"));
        }
    } else {
        if authority != 0 {
            mut r = resource(&mut c, authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("mutation through readonly frame"));
            }
            loan := authority_loan(&mut c, authority, place);
            if loan == 0 {
                fail(&mut c, view("write has no reference authority"));
            }
            if ownership::access_loan(&c.check, loan, place, 1) != 0 {
                fail(&mut c, view("write conflicts with active loan"));
            }
        } else {
            loan := ownership::borrow_place(&mut c.check, place, 1);
            if loan == 0 {
                fail(&mut c, view("mutation conflicts with live borrow"));
            }
            ownership::end_loan(&mut c.check, loan);
        }
    }
    return ();
}
fn region_of<a>(c: (&a mut C), place: u64) -> u64 {
    for i in c.origins.len() {
        o := &c.origins[i];
        root := o.place;
        region := o.region;
        if ownership::ancestor(&c.check, root, place) {
            return region;
        }
    }
    return 0;
}
fn external_place<a>(c: (&a mut C), region: u64, copy: u64) -> u64 {
    p := ownership::root(&mut c.check, copy, 1);
    c.origins.push(Origin { place: p, region: region });
    return p;
}
fn add_external_capture<a>(c: (&a mut C), holder: u64, region: u64, mode: u64) -> u64 {
    source := external_place(&mut c, region, 0);
    loan := ownership::borrow_place(&mut c.check, source, mode);
    bond(&mut c, holder, loan);
    return source;
}
fn init_parameter<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    holder := place_of(&mut c, slot);
    k := ty_kind(&mut c, ty);
    mut rs = type_regions(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        if rs.len() != 1 {
            fail(&mut c, view("parameter requires a declared lifetime"));
        }
        mut r = rs[0];
        source := add_external_capture(&mut c, holder, r, mode);
        if k == 7 {
            set_target(&mut c, slot, source, slot + 1);
        }
        return ();
    }
    captures := type_caps(&mut c, ty, 0);
    for i in captures.len() {
        mut r = captures[i];
        target := external_place(&mut c, r, 0);
        loan := ownership::borrow_place(&mut c.check, target, 0);
        bond_kind(&mut c, holder, loan, 1);
    }
    return ();
}
fn has_bonds<a>(c: (&a mut C), holder: u64) -> bool {
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        h := b.holder;
        guard := b.guard;
        loan := b.loan;
        if (h == holder) & (guard == 0) {
            if loan_live(&mut c, loan) != 0 {
                return true;
            }
        }
    }
    return false;
}
// Stored captures in an abstract input referent have their declared data lifetime,
// distinct from the lifetime of the outer reference frame.
fn stored_source<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    k := ty_kind(&mut c, ty);
    if (k != 5) & (k != 7) & (k != 27) {
        return ();
    }
    if has_bonds(&mut c, place) {
        if k == 7 {
            for i in c.bonds.len() {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if (holder == place) & (guard == 0) {
                    if loan_live(&mut c, loan) != 0 {
                        mut l = &c.check.loans[loan - 1];
                        source := l.source;
                        authority := authority_of(&mut c, slot);
                        set_target(&mut c, slot, source, authority);
                        break;
                    }
                }
            }
        }
        return ();
    }
    mut guarded = 0;
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if guard != 0 {
            if loan_live(&mut c, loan) != 0 {
                if ownership::ancestor(&c.check, holder, place) {
                    bond_kind(&mut c, place, loan, guard);
                    guarded = 1;
                }
            }
        }
    }
    if guarded != 0 {
        mode := ty_mode(&mut c, ty);
        source := external_place(&mut c, 18446744073709551615, 0);
        loan := ownership::borrow_place(&mut c.check, source, mode);
        bond(&mut c, place, loan);
        if k == 7 {
            mut authority = authority_of(&mut c, slot);
            mut r = resource(&mut c, slot);
            info := &c.resources[r - 1];
            if info.base == 0 {
                authority = slot + 1;
            }
            set_target(&mut c, slot, source, authority);
        }
        return ();
    }
    if region_of(&mut c, place) == 0 {
        return ();
    }
    mut rs = type_regions(&mut c, ty);
    if rs.len() != 1 {
        fail(&mut c, view("stored capture lifetime missing"));
    }
    mut r = rs[0];
    mode := ty_mode(&mut c, ty);
    target := add_external_capture(&mut c, place, r, mode);
    if k == 7 {
        authority := authority_of(&mut c, slot);
        set_target(&mut c, slot, target, authority);
    }
    return ();
}
fn bind_loan<a>(c: (&a mut C), value: u64, source: u64, target: u64, mode: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if target == 0 {
        fail(&mut c, view("borrow target is not tracked"));
    }
    mut authority = authority_of(&mut c, source);
    source_id := resource(&mut c, source);
    if source_id != 0 {
        mut r = &c.resources[source_id - 1];
        ty := r.ty;
        if ty_kind(&mut c, ty) == 7 {
            authority = source + 1;
        }
    }
    mut loan = 0;
    if authority != 0 {
        if mode != 0 {
            mut r = resource(&mut c, authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("mutable borrow through readonly frame"));
            }
        }
        parent := authority_loan(&mut c, authority, target);
        if parent == 0 {
            fail(&mut c, view("reference has no access authority"));
        }
        loan = ownership::reborrow_place(&mut c.check, parent, target, mode);
        owner := place_of(&mut c, authority - 1);
        holder := place_of(&mut c, value);
        n := c.bonds.len();
        for i in n {
            mut b = &c.bonds[i];
            old := b.loan;
            h := b.holder;
            guard := b.guard;
            if (h == owner) & (guard != 0) {
                bond_kind(&mut c, holder, old, 1);
            }
            if (h == owner) & (old != parent) & (guard == 0) {
                if loan_live(&mut c, old) != 0 {
                    extra := ownership::reborrow(&mut c.check, old, mode);
                    if extra == 0 {
                        fail(&mut c, view("ambiguous reborrow lacks authority"));
                    }
                    bond(&mut c, holder, extra);
                }
            }
        }
    } else {
        loan = ownership::borrow_place(&mut c.check, target, mode);
        if loan == 0 {
            // Loans whose holders are all dead (a moved match scrutinee's payload loans) end
            // here, then the borrow is retried; a real conflict still fails.
            close_loans(&mut c);
            loan = ownership::borrow_place(&mut c.check, target, mode);
        }
    }
    if loan == 0 {
        fail(&mut c, view("borrow conflicts with active access"));
    }
    holder := place_of(&mut c, value);
    bond(&mut c, holder, loan);
    return ();
}
fn borrow_reference<a>(
    c: (&a mut C),
    slot: u64,
    ty: u64,
    source: u64,
    target: u64,
    mode: u64
) -> Val {
    own(&mut c, slot, ty);
    bind_loan(&mut c, slot, source, target, mode);
    set_target(&mut c, slot, target, slot + 1);
    return val(slot, ty);
}
fn view_bonds<a>(c: (&a mut C), slot: u64, source: u64, mode: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    root := place_of(&mut c, source);
    holder := place_of(&mut c, slot);
    if root == 0 {
        fail(&mut c, view("view source is not tracked"));
    }
    source_index := resource(&mut c, source);
    mut r = &c.resources[source_index - 1];
    ty := r.ty;
    if (ty_kind(&mut c, ty) == 5) || (ty_kind(&mut c, ty) == 27) {
        if mode != 0 {
            index := resource(&mut c, source);
            mut r = &c.resources[index - 1];
            base := r.base;
            authority := r.authority;
            if base != 0 {
                if authority != 0 {
                    mut r = resource(&mut c, authority - 1);
                    info := &c.resources[r - 1];
                    ty := info.ty;
                    if ty_mode(&mut c, ty) == 0 {
                        fail(&mut c, view("unique field reborrow through readonly frame"));
                    }
                    parent := authority_loan(&mut c, authority, root);
                    if ownership::access_loan(&c.check, parent, root, 1) != 0 {
                        fail(&mut c, view("unique field reborrow requires mutable frame"));
                    }
                } else {
                    if !ownership::can_cleanup(&c.check, root) {
                        fail(&mut c, view("field frame is shared"));
                    }
                }
            }
        }
        mut found = 0;
        n := c.bonds.len();
        for i in n {
            mut b = &c.bonds[i];
            h := b.holder;
            parent := b.loan;
            guard := b.guard;
            if loan_live(&mut c, parent) != 0 {
                if ownership::ancestor(&c.check, h, root) {
                    if guard != 0 {
                        bond_kind(&mut c, holder, parent, 1);
                    } else {
                        loan := ownership::reborrow(&mut c.check, parent, mode);
                        if loan == 0 {
                            fail(&mut c, view("view reborrow lacks authority"));
                        }
                        bond(&mut c, holder, loan);
                        found = 1;
                    }
                }
            }
        }
        if found == 0 {
            fail(&mut c, view("view has no lifetime source"));
        }
    } else {
        bind_loan(&mut c, slot, source, root, mode);
    }
    return ();
}
fn validate_return<a>(c: (&a mut C), v: Val) -> unit {
    if c.raw != 0 {
        return ();
    }
    // Every returned value is checked, not only one whose type names a borrow: a closure that
    // captured a reference keeps its loan in the environment, and a value that merely holds such a
    // closure (`struct Holder { f: Fn(u64) -> u64 }`) still must not carry a loan out of the frame.
    place := place_of(&mut c, v.t);
    if place == 0 {
        return ();
    }
    result := c.result;
    mut rs = type_caps(&mut c, result, 0);
    mut found = 0;
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if ownership::ancestor(&c.check, place, holder) {
            if loan_live(&mut c, loan) != 0 {
                mut l = &c.check.loans[loan - 1];
                source := l.source;
                region := region_of(&mut c, source);
                mut allowed = 0;
                for j in rs.len() {
                    if rs[j] == region {
                        allowed = 1;
                    }
                }
                if region != 18446744073709551615 {
                    if (region == 0) || (allowed == 0) {
                        fail(&mut c, view("returned borrow escapes its declared input lifetime"));
                    }
                }
                found = 1;
            }
        }
    }
    k := ty_kind(&mut c, v.ty);
    if (k == 5) || (k == 7) || (k == 27) {
        if found == 0 {
            fail(&mut c, view("returned reference has no checked source"));
        }
    }
    return ();
}
fn place_of<a>(c: (&a mut C), slot: u64) -> u64 {
    mut r = resource(&mut c, slot);
    if r == 0 {
        return 0;
    }
    mut r = &c.resources[r - 1];
    return r.place;
}
fn observe<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    authority := authority_of(&mut c, slot);
    index := resource(&mut c, slot);
    info := &c.resources[index - 1];
    base := info.base;
    ty := info.ty;
    if (authority != 0) & (base != 0) {
        loan := authority_loan(&mut c, authority, place);
        if loan == 0 {
            fail(&mut c, view("access has no live reference authority"));
        }
        if ownership::access_loan(&c.check, loan, place, 0) != 0 {
            fail(&mut c, view("reference access conflicts with active borrow"));
        }
    } else {
        if ownership::read(&c.check, place) != 0 {
            fail(&mut c, view("use of moved, borrowed or partially initialized value"));
        }
    }
    k := ty_kind(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        mut checked = 0;
        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            h := b.holder;
            loan := b.loan;
            guard := b.guard;
            if (guard == 0) & ownership::ancestor(&c.check, h, place) {
                if loan_live(&mut c, loan) != 0 {
                    checked = 1;
                    if ownership::use_loan(&c.check, loan, 0) != 0 {
                        fail(&mut c, view("reference is suspended or expired"));
                    }
                }
            }
        }
        if checked == 0 {
            fail(&mut c, view("reference lacks checked source"));
        }
    }
    return ();
}
fn inherit_guards<a>(c: (&a mut C), place: u64) -> unit {
    if place == 0 {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if holder != place {
            if ownership::ancestor(&c.check, holder, place) {
                bond_kind(&mut c, place, loan, 1);
            }
        }
    }
    return ();
}
fn capture_authority<a>(c: (&a mut C), place: u64) -> unit {
    if place == 0 {
        return ();
    }
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if guard == 0 {
            if loan_live(&mut c, loan) != 0 {
                if ownership::ancestor(&c.check, place, holder) {
                    if ownership::use_loan(&c.check, loan, 0) != 0 {
                        fail(&mut c, view("captured authority is suspended"));
                    }
                }
            }
        }
    }
    return ();
}
fn alias_field<a>(c: (&a mut C), slot: u64, ty: u64, base: u64, field: u64, via: u64) -> Val {
    if c.raw == 0 {
        root := place_of(&mut c, base);
        place := member_place(&mut c, root, field, ty);
        authority := authority_of(&mut c, base);
        c
            .resources
            .push(
                Resource {
                    slot: slot,
                    ty: ty,
                    flag: 0,
                    base: base + 1,
                    field: field,
                    via: via,
                    place: place,
                    target: 0,
                    authority: authority,
                }
            );
        if contains_borrow(&mut c, ty, 0) {
            inherit_guards(&mut c, place);
        }
        stored_source(&mut c, slot, ty);
    }
    return val(slot, ty);
}
fn drop_name<a>(c: (&a mut C), ty: u64) -> unit {
    o(&mut c, view(".D"));
    on(&mut c, ty);
    return ();
}
fn release<a>(c: (&a mut C), index: u64) -> unit {
    mut r = &c.resources[index];
    flag := r.flag;
    slot := r.slot;
    ty := r.ty;
    place := r.place;
    base := r.base;
    if flag == 0 {
        if base == 0 {
            if place != 0 {
                if ownership::cleanup(&mut c.check, place) != 0 {
                    fail(&mut c, view("storage ends while borrowed"));
                }
                close_loans(&mut c);
            }
        }
        return ();
    }
    if place != 0 {
        if ownership::cleanup(&mut c.check, place) != 0 {
            fail(&mut c, view("cleanup conflicts with live loan"));
        }
    }
    done := label(&mut c);
    o(&mut c, view("cmpq $0,"));
    stack_slot(&mut c, flag - 1);
    c.out.push(10);
    jump(&mut c, view("je"), done);
    o(&mut c, view("movq $0,"));
    stack_slot(&mut c, flag - 1);
    c.out.push(10);
    get(&mut c, slot, view("%rdi"));
    o(&mut c, view("call "));
    drop_name(&mut c, ty);
    c.out.push(10);
    mark(&mut c, done);
    close_loans(&mut c);
    return ();
}
fn cleanup<a>(c: (&a mut C), mark: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    mut i = c.resources.len();
    while mark < i {
        i = i - 1;
        release(&mut c, i);
    }
    return ();
}
fn move_out<a>(c: (&a mut C), v: Val) -> unit {
    if c.raw != 0 {
        return ();
    }
    if !needs_drop(&mut c, v.ty) {
        if ty_kind(&mut c, v.ty) != 7 {
            return ();
        }
    }
    index := resource(&mut c, v.t);
    if index == 0 {
        fail(&mut c, view("owned value lacks ownership record"));
    }
    mut r = &c.resources[index - 1];
    flag := r.flag;
    base := r.base;
    field := r.field;
    via := r.via;
    place := r.place;
    if place != 0 {
        capture_authority(&mut c, place);
        if ownership::take(&mut c.check, place) != 0 {
            fail(&mut c, view("move of unavailable or borrowed value"));
        }
    }
    if flag != 0 {
        o(&mut c, view("movq $0,"));
        stack_slot(&mut c, flag - 1);
        c.out.push(10);
    } else {
        if base != 0 {
            if via != 0 {
                fail(&mut c, view("cannot move owned field through reference"));
            }
            zero := imm(&mut c, 0);
            rec_store(&mut c, base - 1, field, zero);
        }
    }
    return ();
}
fn move_value<a>(c: (&a mut C), v: Val) -> Val {
    get(&mut c, v.t, view("%rax"));
    slot := save(&mut c);
    old := place_of(&mut c, v.t);
    target := target_of(&mut c, v.t);
    move_out(&mut c, val(v.t, v.ty));
    own(&mut c, slot, v.ty);
    dst := place_of(&mut c, slot);
    kind := ty_kind(&mut c, v.ty);
    if contains_borrow(&mut c, v.ty, 0) {
        return_bonds(&mut c, old, dst, u64(kind == 6 || kind == 8));
    }
    if ty_kind(&mut c, v.ty) == 7 {
        set_target(&mut c, slot, target, slot + 1);
    }
    return val(slot, v.ty);
}
// ---- tokens ----
fn kind<a>(c: (&a mut C)) -> u64 {
    p := c.pos;
    t := &c.toks[p];
    return t.kind;
}
fn next_kind<a>(c: (&a mut C)) -> u64 {
    p := c.pos + 1;
    return kind_at(&mut c, p);
}
fn kind_at<a>(c: (&a mut C), i: u64) -> u64 {
    if c.toks.len() < i + 1 {
        return 0;
    }
    t := &c.toks[i];
    return t.kind;
}
fn advance<a>(c: (&a mut C)) -> unit {
    p := c.pos + 1;
    exchange(&mut c.pos, p);
    return ();
}
fn tok_text<a>(c: (&a mut C), i: u64) -> u8[] {
    t := &c.toks[i];
    st := t.start;
    en := t.end;
    return (c.src[st: en]).copy();
}
fn is<a, b>(c: (&a mut C), s: &b [u8]) -> bool {
    p := c.pos;
    t := tok_text(&mut c, p);
    return same(view(t), s);
}
fn fail<a, b>(c: (&a mut C), msg: &b [u8]) -> unit {
    p := c.pos;
    m := tok_text(&mut c, p);
    t := &c.toks[p];
    st := t.start;
    exchange(&mut c.out, u8[]);
    // file:line:column: message (byte offset kept for tools)
    mut line = 1;
    mut column = 1;
    for i in st {
        if c.src[i] == 10 {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    offset := c.arg_offset;
    file := c.file;
    path := host::arg(file + offset);
    o(&mut c, view(path));
    c.out.push(58);
    on(&mut c, line);
    c.out.push(58);
    on(&mut c, column);
    o(&mut c, view(": "));
    o(&mut c, msg);
    o(&mut c, view(" at byte "));
    on(&mut c, st);
    o(&mut c, view(" near '"));
    o(&mut c, view(m));
    o(&mut c, view("'\n"));
    // The source line, with a caret under the error column.
    mut begin = st;
    while 0 < begin {
        if c.src[begin - 1] == 10 {
            break;
        }
        begin -= 1;
    }
    mut finish = st;
    while finish < c.src.len() {
        if c.src[finish] == 10 {
            break;
        }
        finish += 1;
    }
    o(&mut c, view("  | "));
    for i in finish - begin {
        b := c.src[begin + i];
        if b == 9 {
            c.out.push(32);
        } else {
            c.out.push(b);
        }
    }
    c.out.push(10);
    o(&mut c, view("  | "));
    for i in column - 1 {
        c.out.push(32);
    }
    mut width = m.len();
    if width == 0 {
        width = 1;
    }
    if 60 < width {
        width = 60;
    }
    for i in width {
        c.out.push(94);
    }
    c.out.push(10);
    host::print(view(c.out));
    // A rejected program is an ordinary failure (status 1), not a crash of the compiler.
    host::exit(1);
    return ();
}
// Command-line errors happen before any token stream exists, so they bypass the caret diagnostic.
fn fail_option<a, b>(c: (&a mut C), msg: &b [u8]) -> unit {
    o(&mut c, view("grail: "));
    o(&mut c, msg);
    c.out.push(10);
    host::print(view(c.out));
    host::exit(1);
    return ();
}
fn eat<a, b>(c: (&a mut C), s: &b [u8]) -> bool {
    if is(&mut c, s) {
        advance(&mut c);
        return true;
    }
    return false;
}
fn expect<a, b>(c: (&a mut C), s: &b [u8]) -> unit {
    want := s.copy();
    if !eat(&mut c, s) {
        mut msg = "expected ";
        msg.append(view(want));
        fail(&mut c, view(msg));
    }
    return ();
}
fn ident<a>(c: (&a mut C)) -> u8[] {
    if kind(&mut c) != 1 {
        fail(&mut c, view("expected identifier"));
    }
    p := c.pos;
    t := tok_text(&mut c, p);
    if same(view(t), view("true")) || same(view(t), view("false")) {
        fail(&mut c, view("truth keyword is not an identifier"));
    }
    advance(&mut c);
    return t;
}
// Skips a balanced {...} group starting at the current '{'.
fn skip_braces<a>(c: (&a mut C)) -> unit {
    mut depth = 0;
    while true {
        k := kind(&mut c);
        if k == 123 {
            depth = depth + 1;
        }
        if k == 125 {
            depth = depth - 1;
        }
        if k == 0 {
            fail(&mut c, view("unclosed {"));
        }
        advance(&mut c);
        if depth == 0 {
            return ();
        }
    }
    return ();
}
fn load_file<a>(c: (&a mut C), index: u64) -> unit {
    offset := c.arg_offset;
    path := host::arg(index + offset);
    if host::exists(view(path)) == 0 {
        host::print(view("grail: cannot read input file "));
        host::print(view(path));
        host::print(view("\n"));
        host::exit(1);
    }
    src := host::read_file(view(path));
    exchange(&mut c.file_std, in_std_dir(view(path)));
    mut toks = Tok[];
    lexed := lexer::tokenize(view(src));
    for i in lexed.len() {
        t := &lexed[i];
        toks.push(Tok { kind: t.kind, start: t.start, end: t.end });
    }
    drop(lexed);
    exchange(&mut c.toks, toks);
    exchange(&mut c.src, src);
    exchange(&mut c.pos, 0);
    // Token positions are indices into this file: a call-flex hint record or a `None` span from
    // another file is stale.
    exchange(&mut c.cf_start, 0);
    exchange(&mut c.cf_end, 0);
    exchange(&mut c.cf_local, 0);
    exchange(&mut c.none_start, 0);
    exchange(&mut c.none_end, 0);
    return ();
}

// ---- types and declarations ----
fn numbers_equal<a, b>(a: (&a u64[]), b: (&b u64[])) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}
fn intern_args<a>(c: (&a mut C), k: u64, arg: u64, mode: u64, regions: u64[], args: u64[]) -> u64 {
    for i in c.types.len() {
        t := &c.types[i];
        if (t.kind == k) & (t.arg == arg) & (t.mode == mode) {
            if numbers_equal(&t.regions, &regions) {
                if numbers_equal(&t.args, &args) {
                    return i;
                }
            }
        }
    }
    c.types.push(Ty { kind: k, arg: arg, mode: mode, regions: regions, args: args });
    return c.types.len() - 1;
}
fn intern_full<a>(c: (&a mut C), k: u64, arg: u64, mode: u64, regions: u64[]) -> u64 {
    return intern_args(&mut c, k, arg, mode, regions, u64[]);
}
fn type_args<a>(c: (&a mut C), ty: u64) -> u64[] {
    mut args = u64[];
    t := &c.types[ty];
    for i in t.args.len() {
        args.push(t.args[i]);
    }
    return args;
}
fn intern<a>(c: (&a mut C), k: u64, arg: u64) -> u64 {
    return intern_full(&mut c, k, arg, 0, u64[]);
}
fn copy_numbers<a>(input: (&a u64[])) -> u64[] {
    mut out = u64[];
    for i in input.len() {
        out.push(input[i]);
    }
    return out;
}
fn transfer_capability<a, b>(
    c: (&a mut C),
    ty: u64,
    shared: u64,
    trail: (&b mut u64[]),
    depth: u64
) -> u64 {
    if 64 < depth {
        return false;
    }
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if (k == 1) || (k == 2) || (k == 3) || (k == 4) || (k == 11) || (k == 12) || (k == 17) || (k == 18) || (k == 19) || (k == 21) {
        return true;
    }
    if k == 14 {
        return false;
    }
    if (k == 5) || (k == 27) {
        if shared != 0 {
            return ty_mode(&mut c, ty) == 0;
        }
        return true;
    }
    if k == 9 {
        proof := ty_mode(&mut c, ty);
        mut bit = 1;
        if shared != 0 {
            bit = 2;
        }
        return (proof & bit) != 0;
    }
    if k == 10 {
        return transfer_capability(&mut c, arg, shared, &mut trail, depth + 1);
    }
    key := ty * 2 + shared;
    for i in trail.len() {
        if trail[i] == key {
            return true;
        }
    }
    trail.push(key);
    mut allowed = 0;
    if k == 6 {
        allowed = transfer_capability(&mut c, arg, shared, &mut trail, depth + 1);
    }
    // A mutex serializes access: sharing it only requires that its payload may move between threads.
    if k == 13 {
        allowed = transfer_capability(&mut c, arg, 0, &mut trail, depth + 1);
    }
    // A scope stays on the thread running its body; a task handle may move (join is ownership-based).
    if k == 16 {
        if shared == 0 {
            allowed = transfer_capability(&mut c, arg, 0, &mut trail, depth + 1);
        }
    }
    if k == 7 {
        mode := ty_mode(&mut c, ty);
        if mode != 0 {
            if shared == 0 {
                allowed = transfer_capability(&mut c, arg, 0, &mut trail, depth + 1);
            }
        } else {
            allowed = transfer_capability(&mut c, arg, 1, &mut trail, depth + 1);
        }
    }
    if k == 8 {
        d := &c.decls[arg];
        count := d.count;
        allowed = 1;
        for i in count {
            field := field_type(&mut c, ty, i);
            if transfer_capability(&mut c, field, shared, &mut trail, depth + 1)
                == 0 {
                allowed = 0;
                break;
            }
        }
    }
    trail.pop();
    return allowed;
}
fn require_constraints<a, b, d>(c: (&a mut C), arguments: (&b u64[]), bounds: (&d u64[])) -> unit {
    if arguments.len() != bounds.len() {
        fail(&mut c, view("generic constraint arity"));
    }
    for i in bounds.len() {
        mask := bounds[i];
        ty := arguments[i];
        if (mask & 1) != 0 {
            mut trail = u64[];
            if transfer_capability(&mut c, ty, 0, &mut trail, 0) == 0 {
                fail(&mut c, view("type does not satisfy Send"));
            }
        }
        if (mask & 2) != 0 {
            mut trail = u64[];
            if transfer_capability(&mut c, ty, 1, &mut trail, 0) == 0 {
                fail(&mut c, view("type does not satisfy Share"));
            }
        }
    }
    return ();
}
// Forward declarations are optimistically incomplete while collecting headers. Recheck
// every instantiated nominal type after all layouts are known, before generating bodies.
fn validate_type_constraints<a>(c: (&a mut C)) -> unit {
    mut i = 0;
    while i < c.types.len() {
        if ty_kind(&mut c, i) == 8 {
            decl := ty_arg(&mut c, i);
            arguments := type_args(&mut c, i);
            bounds := declaration_bounds(&c, decl);
            require_constraints(&mut c, &arguments, &bounds);
            requirements := declaration_constraints(&c, decl);
            require_interfaces(&mut c, &arguments, &requirements);
        }
        i += 1;
    }
    return ();
}
fn function_bounds<a>(c: (&a C), index: u64) -> u64[] {
    f := &c.funcs[index];
    return copy_numbers(&f.bounds);
}
fn declaration_bounds<a>(c: (&a C), index: u64) -> u64[] {
    d := &c.decls[index];
    return copy_numbers(&d.bounds);
}
fn copy_constraints<a>(input: (&a u64[][])) -> u64[][] {
    mut out = u64[][];
    for i in input.len() {
        out.push(copy_numbers(&input[i]));
    }
    return out;
}
fn function_constraints<a>(c: (&a C), index: u64) -> u64[][] {
    f := &c.funcs[index];
    return copy_constraints(&f.constraints);
}
fn declaration_constraints<a>(c: (&a C), index: u64) -> u64[][] {
    d := &c.decls[index];
    return copy_constraints(&d.constraints);
}
fn find_interface<a, b, d>(c: (&a C), module: &b [u8], name: &d [u8]) -> u64 {
    for i in c.interfaces.len() {
        item := &c.interfaces[i];
        if same(view(item.module), view(module)) & same(view(item.name), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
fn resolve_import<a, b>(c: (&a mut C), n: &b [u8]) -> u8[] {
    mut found = 0;
    mut module = u8[];
    for i in c.imports.len() {
        im_name := c.imports[i].name.copy();
        im_module := c.imports[i].module.copy();
        if same(view(im_name), view(n)) {
            found += 1;
            module = im_module;
        }
    }
    if found > 1 {
        fail(&mut c, view("ambiguous imported name"));
    }
    return module;
}
fn ensure_interface<a>(c: (&a mut C), module: u8[], name: u8[]) -> u64 {
    existing := find_interface(&c, view(module), view(name));
    if existing != 0 {
        return existing;
    }
    c.interfaces.push(Interface { module: module, name: name, defined: 0, methods: u64[] });
    return c.interfaces.len();
}
fn base_type<a>(c: (&a mut C), ty: u64) -> u64 {
    mut out = ty;
    while ty_kind(&mut c, out) == 10 {
        out = ty_arg(&mut c, out);
    }
    return out;
}
fn find_implementation<a>(c: (&a mut C), contract: u64, ty: u64) -> u64 {
    actual := base_type(&mut c, ty);
    for i in c.implementations.len() {
        item := &c.implementations[i];
        id := item.contract;
        other := item.ty;
        if id == contract {
            if same_type(&mut c, actual, other) != 0 {
                return i + 1;
            }
        }
    }
    return 0;
}
fn satisfies_interface<a>(c: (&a mut C), ty: u64, contract: u64) -> bool {
    actual := base_type(&mut c, ty);
    if ty_kind(&mut c, actual) == 9 {
        proofs := type_args(&mut c, actual);
        for i in proofs.len() {
            p := proofs[i];
            if ty_kind(&mut c, p) == 15 {
                if ty_arg(&mut c, p) == contract {
                    return true;
                }
            }
        }
        return false;
    }
    if c.headers_complete == 0 {
        return true;
    }
    return find_implementation(&mut c, contract, actual) != 0;
}
fn require_interfaces<a, b, d>(c: (&a mut C), arguments: (&b u64[]), sets: (&d u64[][])) -> unit {
    if arguments.len() != sets.len() {
        fail(&mut c, view("interface constraint arity"));
    }
    for i in sets.len() {
        ty := arguments[i];
        set := &sets[i];
        for j in set.len() {
            id := set[j];
            if !satisfies_interface(&mut c, ty, id) {
                fail(&mut c, view("type does not satisfy interface bound"));
            }
        }
    }
    return ();
}
fn private_module<a>(prefix: &a [u8], id: u64) -> u8[] {
    mut out = prefix.copy();
    decimal(&mut out, id);
    return out;
}
fn region_id<a>(c: (&a mut C)) -> u64 {
    n := ident(&mut c);
    for i in c.rnames.len() {
        mut r = &c.rnames[i];
        if same(view(r), view(n)) {
            return i + 1;
        }
    }
    fail(&mut c, view("undeclared lifetime"));
    return 0;
}
fn lifetime_parameters<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.rnames, u8[][]);
    exchange(&mut c.tnames, u8[][]);
    exchange(&mut c.type_bounds, u64[]);
    exchange(&mut c.type_interfaces, u64[][]);
    if eat(&mut c, view("<")) {
        while true {
            n := ident(&mut c);
            is_type := (64 < n[0]) & (n[0] < 91);
            if is_type {
                for i in c.tnames.len() {
                    t := &c.tnames[i];
                    if same(view(t), view(n)) {
                        fail(&mut c, view("duplicate type parameter"));
                    }
                }
                mut bounds = 0;
                mut requirements = u64[];
                if eat(&mut c, view(":")) {
                    while true {
                        constraint := ident(&mut c);
                        mut bit = 0;
                        if same(view(constraint), view("Send")) & !is(&mut c, view("::")) {
                            bit = 1;
                        }
                        if same(view(constraint), view("Share")) & !is(&mut c, view("::")) {
                            bit = 2;
                        }
                        if bit == 0 {
                            mut m = module_copy(&mut c);
                            mut n = constraint.copy();
                            mut qualified = 0;
                            if eat(&mut c, view("::")) {
                                qualified = 1;
                                m = constraint.copy();
                                n = ident(&mut c);
                            }
                            if qualified == 0 {
                                imported := resolve_import(&mut c, view(n));
                                if imported.len() != 0 {
                                    m = imported;
                                }
                            }
                            id := ensure_interface(&mut c, m, n);
                            for i in requirements.len() {
                                if requirements[i] == id {
                                    fail(&mut c, view("duplicate interface constraint"));
                                }
                            }
                            requirements.push(id);
                        } else {
                            if (bounds & bit) != 0 {
                                fail(&mut c, view("duplicate structural constraint"));
                            }
                            bounds += bit;
                        }
                        if !eat(&mut c, view("+")) {
                            break;
                        }
                    }
                }
                c.tnames.push(n);
                c.type_bounds.push(bounds);
                c.type_interfaces.push(requirements);
            } else {
                if c.tnames.len() != 0 {
                    fail(&mut c, view("lifetimes must precede type parameters"));
                }
                for i in c.rnames.len() {
                    mut r = &c.rnames[i];
                    if same(view(r), view(n)) {
                        fail(&mut c, view("duplicate lifetime"));
                    }
                }
                c.rnames.push(n);
            }
            if eat(&mut c, view(">")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    return ();
}
fn lifetime_arguments<a>(c: (&a mut C)) -> u64[] {
    mut rs = u64[];
    if eat(&mut c, view("<")) {
        while true {
            mut r = region_id(&mut c);
            rs.push(r);
            if eat(&mut c, view(">")) {
                break;
            }
            expect(&mut c, view(","));
        }
    }
    return rs;
}
fn nominal_type<a>(c: (&a mut C), d: u64) -> u64 {
    // An opaque handle is one word with no layout: it cannot be constructed,
    // inspected or dropped, only produced by C and handed back to C.
    if c.decls[d].opaque != 0 {
        return intern(&mut c, 23, d);
    }
    decl := &c.decls[d];
    count := decl.regions;
    types := decl.types;
    mut rs = u64[];
    mut args = u64[];
    if (count + types) != 0 {
        expect(&mut c, view("<"));
        for i in count + types {
            if i != 0 {
                expect(&mut c, view(","));
            }
            if i < count {
                mut r = region_id(&mut c);
                rs.push(r);
            } else {
                t := parse_type(&mut c);
                args.push(t);
            }
        }
        expect(&mut c, view(">"));
    }
    bounds := declaration_bounds(&c, d);
    require_constraints(&mut c, &args, &bounds);
    requirements := declaration_constraints(&c, d);
    require_interfaces(&mut c, &args, &requirements);
    return intern_args(&mut c, 8, d, 0, rs, args);
}
fn ty_kind<a>(c: (&a mut C), ty: u64) -> u64 {
    t := &c.types[ty];
    return t.kind;
}
fn ty_arg<a>(c: (&a mut C), ty: u64) -> u64 {
    t := &c.types[ty];
    return t.arg;
}
fn ty_mode<a>(c: (&a mut C), ty: u64) -> u64 {
    t := &c.types[ty];
    return t.mode;
}
fn type_regions<a>(c: (&a mut C), ty: u64) -> u64[] {
    mut rs = u64[];
    t := &c.types[ty];
    for i in t.regions.len() {
        rs.push(t.regions[i]);
    }
    return rs;
}
fn substitute<a, b>(c: (&a mut C), ty: u64, map: (&b u64[])) -> u64 {
    k := ty_kind(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    mut arg = ty_arg(&mut c, ty);
    mut rs = type_regions(&mut c, ty);
    if (k == 6) || (k == 27) || (k == 28) || (k == 7) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) {
        arg = substitute(&mut c, arg, &map);
    }
    for i in rs.len() {
        mut r = rs[i];
        if r != 0 {
            if map.len() < r {
                fail(&mut c, view("unbound stored lifetime"));
            }
            n := map[r - 1];
            exchange(&mut rs[i], n);
        }
    }
    mut args = type_args(&mut c, ty);
    for i in args.len() {
        t := args[i];
        mut v = substitute(&mut c, t, &map);
        exchange(&mut args[i], v);
    }
    return intern_args(&mut c, k, arg, mode, rs, args);
}
fn bind_types<a, b>(c: (&a mut C), ty: u64, map: (&b u64[])) -> u64 {
    k := ty_kind(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    mut arg = ty_arg(&mut c, ty);
    if k == 9 {
        if map.len() < arg + 1 {
            fail(&mut c, view("unbound type parameter"));
        }
        return map[arg];
    }
    if (k == 6) || (k == 27) || (k == 28) || (k == 7) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) {
        arg = bind_types(&mut c, arg, &map);
    }
    mut args = type_args(&mut c, ty);
    for i in args.len() {
        t := args[i];
        mut v = bind_types(&mut c, t, &map);
        exchange(&mut args[i], v);
    }
    if is_union(&mut c, ty) {
        for i in args.len() {
            for j in i {
                left := base_type(&mut c, args[i]);
                right := base_type(&mut c, args[j]);
                if same_type(&mut c, left, right) != 0 {
                    fail(&mut c, view("duplicate union member"));
                }
            }
        }
    }
    mut rs = type_regions(&mut c, ty);
    return intern_args(&mut c, k, arg, mode, rs, args);
}
fn field_type<a>(c: (&a mut C), ty: u64, index: u64) -> u64 {
    d := ty_arg(&mut c, ty);
    t := field_ty(&mut c, d, index);
    mut rs = type_regions(&mut c, ty);
    mut args = type_args(&mut c, ty);
    field := bind_types(&mut c, t, &args);
    if rs.len() == 0 {
        return field;
    }
    return substitute(&mut c, field, &rs);
}
fn concrete_type<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if k == 9 {
        return false;
    }
    arg := ty_arg(&mut c, ty);
    if (k == 6) || (k == 27) || (k == 7) || (k == 10) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) {
        if !concrete_type(&mut c, arg) {
            return false;
        }
    }
    mut args = type_args(&mut c, ty);
    for i in args.len() {
        a := args[i];
        if !concrete_type(&mut c, a) {
            return false;
        }
    }
    return true;
}
fn reference_type<a>(c: (&a mut C), ty: u64, mode: u64) -> u64 {
    return intern_full(&mut c, 7, ty, mode, u64[]);
}
// Shape checking does not discharge lifetime obligations; the loan pass handles those separately.
fn callable_contract<a, b>(
    c: (&a mut C),
    actual: u64,
    expected: u64,
    map: (&b mut u64[]),
    depth: u64
) -> bool {
    if 64 < depth {
        return false;
    }
    ak := ty_kind(&mut c, actual);
    ek := ty_kind(&mut c, expected);
    if ak != ek {
        return false;
    }
    aa := ty_arg(&mut c, actual);
    ea := ty_arg(&mut c, expected);
    if (ak == 5) || (ak == 7) || (ak == 27) || (ak == 10) || (ak == 20) {
        am := ty_mode(&mut c, actual);
        em := ty_mode(&mut c, expected);
        if am != em {
            return false;
        }
    }
    if (ak == 8) || (ak == 9) || (ak == 10) || (ak == 18) {
        if aa != ea {
            return false;
        }
    }
    if ak == 18 {
        if ty_mode(&mut c, actual) != ty_mode(&mut c, expected) {
            return false;
        }
    }
    ar := type_regions(&mut c, actual);
    er := type_regions(&mut c, expected);
    // A closure's own regions are the lifetimes it captured, not part of its signature: a closure
    // that borrows is accepted where a plain `Fn(...)` is expected. The loan stays on the value, so
    // letting the value outlive the borrow is still rejected elsewhere.
    if ak != 20 {
        if ar.len() != er.len() {
            return false;
        }
        for i in ar.len() {
            from := ar[i];
            to := er[i];
            mut seen = 0;
            for j in map.len() / 2 {
                if map[j * 2] == from {
                    if map[j * 2 + 1] != to {
                        return false;
                    }
                    seen = 1;
                    break;
                }
            }
            if seen == 0 {
                map.push(from);
                map.push(to);
            }
        }
    }
    if (ak == 6) || (ak == 27) || (ak == 28) || (ak == 7) || (ak == 12) || (ak == 13) || (ak == 14) || (ak == 16) || (ak == 20) {
        if !callable_contract(&mut c, aa, ea, &mut map, depth + 1) {
            return false;
        }
    }
    ax := type_args(&mut c, actual);
    ex := type_args(&mut c, expected);
    if ax.len() != ex.len() {
        return false;
    }
    for i in ax.len() {
        left := ax[i];
        right := ex[i];
        if !callable_contract(&mut c, left, right, &mut map, depth + 1) {
            return false;
        }
    }
    return true;
}
fn same_type<a>(c: (&a mut C), x: u64, y: u64) -> u64 {
    a := ty_kind(&mut c, x);
    mut b = ty_kind(&mut c, y);
    if a != b {
        return 0;
    }
    if (a == 12) || (a == 20) || (a == 25) {
        mut map = u64[];
        return callable_contract(&mut c, x, y, &mut map, 0);
    }
    aa := ty_arg(&mut c, x);
    bb := ty_arg(&mut c, y);
    if (a == 5) || (a == 7) || (a == 27) {
        am := ty_mode(&mut c, x);
        bm := ty_mode(&mut c, y);
        if am != bm {
            return 0;
        }
    }
    if (a == 6) || (a == 7) || (a == 27) || (a == 28) || (a == 13) || (a == 14) || (a == 16) {
        return same_type(&mut c, aa, bb);
    }
    if a == 8 {
        if aa != bb {
            return 0;
        }
        ax := type_args(&mut c, x);
        bx := type_args(&mut c, y);
        if ax.len() != bx.len() {
            return 0;
        }
        for i in ax.len() {
            x := ax[i];
            y := bx[i];
            if same_type(&mut c, x, y) == 0 {
                return 0;
            }
        }
    }
    if a == 18 {
        am := ty_mode(&mut c, x);
        bm := ty_mode(&mut c, y);
        return (aa == bb) & (am == bm);
    }
    if (a == 9) || (a == 21) {
        return aa == bb;
    }
    if a == 10 {
        am := ty_mode(&mut c, x);
        bm := ty_mode(&mut c, y);
        return (aa == bb) & (am == bm);
    }
    return 1;
}
fn contains_borrow<a>(c: (&a mut C), ty: u64, depth: u64) -> bool {
    mut trail = u64[];
    return borrow_walk(&mut c, ty, &mut trail);
}
fn borrow_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> bool {
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if k == 5 || k == 7 || k == 27 {
        return true;
    }
    // A closure that captured a reference or view holds the loan: the regions it carries are the
    // lifetimes it depends on, so every borrow rule applies to the closure value itself.
    if k == 20 {
        rs := type_regions(&mut c, ty);
        if rs.len() != 0 {
            return true;
        }
        return false;
    }
    if k == 10 || k == 6 || k == 13 {
        return borrow_walk(&mut c, arg, &mut trail);
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return false;
            }
        }
        trail.push(ty);
        d := &c.decls[arg];
        count := d.count;
        for i in count {
            t := field_type(&mut c, ty, i);
            if borrow_walk(&mut c, t, &mut trail) {
                trail.pop();
                return true;
            }
        }
        trail.pop();
    }
    return false;
}
fn require_type<a>(c: (&a mut C), actual: u64, expected: u64) -> unit {
    // While a type hint is pending the function is recompiled anyway; mismatches are not final.
    if c.tolerant != 0 {
        return ();
    }
    // A `byval` parameter is checked as the record it wraps: the marker states the ABI, not a
    // second type for the same layout.
    mut want = expected;
    if ffi_byval(&mut c, want) {
        want = ty_arg(&mut c, want);
    }
    if (want == 0) & is_bool(&mut c, actual) {
        return ();
    }
    if (ty_kind(&mut c, want) == 23) || (ty_kind(&mut c, actual) == 23) {
        // A handle carries no value of another type: C produces one and hands it back, and the only
        // things it can be compared with are handles of its own type.
        if same_type(&mut c, actual, want) != 0 {
            return ();
        }
        if (ty_kind(&mut c, want) == 23) & (ty_kind(&mut c, actual) == 23) {
            fail(&mut c, view("handles of different types do not mix"));
        }
        if ty_kind(&mut c, want) == 23 {
            fail(
                &mut c,
                view("a handle cannot be constructed or converted: only a foreign call produces one, and it passes back to C")
            );
        }
        fail(&mut c, view("a handle has no value in this context; pass it back to C or compare it with another handle"));
    }
    if same_type(&mut c, actual, want) == 0 {
        // `Fn` and `FnMut` have the same signature and differ only in whether a call needs
        // exclusive access: say so instead of reporting a shape mismatch.
        if (ty_kind(&mut c, actual) == 20) & (ty_kind(&mut c, want) == 20) {
            am := ty_mode(&mut c, actual);
            em := ty_mode(&mut c, want);
            if (am == 1) & (em == 0) {
                aresult := ty_arg(&mut c, actual);
                aregions := type_regions(&mut c, actual);
                aargs := type_args(&mut c, actual);
                shared := intern_args(&mut c, 20, aresult, 0, aregions, aargs);
                if same_type(&mut c, shared, want) != 0 {
                    fail(
                        &mut c,
                        view("a closure that mutates a captured value is FnMut, not Fn: calling it needs exclusive access to the closure, so it cannot be used where a shared call is required")
                    );
                }
            }
        }
        fail(&mut c, view("type mismatch"));
    }
    return ();
}
// Type alias index + 1, or 0.
fn find_alias<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    for i in c.aliases.len() {
        a := &c.aliases[i];
        if same(view(a.module), view(m)) & same(view(a.name), view(n)) {
            return i + 1;
        }
    }
    return 0;
}
// Declaration index + 1, or 0.
fn find_decl_internal<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    for i in c.decls.len() {
        x := &c.decls[i];
        if same(view(x.module), view(m)) & same(view(x.name), view(n)) {
            return i + 1;
        }
    }
    return 0;
}
// These declarations back concise syntax and are not public nominal types.
fn find_decl<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    here := module_copy(&mut c);
    if same(view(m), view("core")) & same(view(n), view("OptionStorage")) & !same(view(here), view("core")) {
        return 0;
    }
    if same(view(m), view("hashmap")) & same(view(n), view("Map")) & !same(view(here), view("hashmap")) {
        return 0;
    }
    return find_decl_internal(&mut c, m, n);
}
fn find_func<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    for i in c.funcs.len() {
        x := &c.funcs[i];
        if same(view(x.module), view(m)) & same(view(x.name), view(n)) {
            return i + 1;
        }
    }
    return 0;
}
// Field index within decl, failing when absent.
fn find_field<a, b>(c: (&a mut C), decl: u64, n: &b [u8]) -> u64 {
    d := &c.decls[decl];
    first := d.first;
    count := d.count;
    for i in count {
        f := &c.fields[first + i];
        if same(view(f.name), view(n)) {
            return i;
        }
    }
    fail(&mut c, view("unknown field or variant"));
    return 0;
}
fn field_ty<a>(c: (&a mut C), decl: u64, index: u64) -> u64 {
    d := &c.decls[decl];
    k := d.first + index;
    f := &c.fields[k];
    return f.ty;
}
fn module_copy<a>(c: (&a mut C)) -> u8[] {
    return c.module.copy();
}
fn vec_of<a>(c: (&a mut C), e: u64) -> u64 {
    if (ty_kind(&mut c, e) == 18)
        & (ty_arg(&mut c, e) == 8)
        & (ty_mode(&mut c, e) == 0) {
        return 2;
    }
    return intern(&mut c, 6, e);
}
fn named_type<a>(c: (&a mut C), m: u8[], n: u8[], args: u64[]) -> u64 {
    mut d = find_decl_internal(&mut c, view(m), view(n));
    if d == 0 {
        fail(&mut c, view("concise type needs its standard library module"));
    }
    d = d - 1;
    decl := &c.decls[d];
    if (decl.regions != 0) || (decl.types != args.len()) {
        fail(&mut c, view("concise type has incompatible library declaration"));
    }
    bounds := declaration_bounds(&c, d);
    require_constraints(&mut c, &args, &bounds);
    reqs := declaration_constraints(&c, d);
    require_interfaces(&mut c, &args, &reqs);
    return intern_args(&mut c, 8, d, 0, u64[], args);
}
// Union members use an internal tagged layout, independent of library declarations.
fn is_ordinary_union<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    d := ty_arg(&mut c, ty);
    decl := &c.decls[d];
    return same(view(decl.module), view(".union"));
}
fn is_result_union<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    d := ty_arg(&mut c, ty);
    decl := &c.decls[d];
    return same(view(decl.module), view(".result"));
}
fn is_union<a>(c: (&a mut C), ty: u64) -> bool {
    return is_ordinary_union(&mut c, ty) || is_result_union(&mut c, ty);
}
fn result_success_count<a>(c: (&a mut C), ty: u64) -> u64 {
    d := ty_arg(&mut c, ty);
    decl := &c.decls[d];
    return decl.success;
}
fn append_ordinary<a>(c: (&a mut C), ty: u64, args: (&a mut u64[])) -> unit {
    if is_ordinary_union(&mut c, ty) {
        items := type_args(&mut c, ty);
        for i in items.len() {
            args.push(items[i]);
        }
    } else {
        args.push(ty);
    }
    return ();
}
fn check_distinct_members<a>(c: (&a mut C), args: (&a u64[]), success: u64) -> unit {
    for i in args.len() {
        for j in i {
            if same_type(&mut c, args[i], args[j]) != 0 {
                fail(&mut c, view("duplicate union member"));
            }
        }
        if (success != 0) & (i < success) {
            for j in success..args.len() {
                if same_type(&mut c, args[i], args[j]) != 0 {
                    fail(&mut c, view("overlapping result union"));
                }
            }
        }
    }
    return ();
}
fn make_union<a>(c: (&a mut C), args: u64[], success: u64, module: u8[], prefix: &a [u8]) -> u64 {
    check_distinct_members(&mut c, &args, success);
    mut name = prefix.copy();
    decimal(&mut name, args.len());
    if success != 0 {
        name.push(95);
        decimal(&mut name, success);
    }
    mut d = find_decl_internal(&mut c, view(module), view(name));
    if d == 0 {
        first := c.fields.len();
        for i in args.len() {
            mut field = u8[];
            decimal(&mut field, i);
            param := intern_args(&mut c, 9, i, 0, u64[], u64[]);
            c.fields.push(Field { name: field, ty: param });
        }
        mut bounds = u64[];
        mut constraints = u64[][];
        for i in args.len() {
            bounds.push(0);
            constraints.push(u64[]);
        }
        c
            .decls
            .push(
                Decl {
                    module: module,
                    name: name,
                    is_enum: 1,
                    opaque: 0,
                    c_layout: 0,
                    first: first,
                    count: args.len(),
                    regions: 0,
                    types: args.len(),
                    success: success,
                    bounds: bounds,
                    constraints: constraints,
                }
            );
        d = c.decls.len();
    }
    return intern_args(&mut c, 8, d - 1, 0, u64[], args);
}
fn union_type<a>(c: (&a mut C), left: u64, right: u64) -> u64 {
    mut args = u64[];
    append_ordinary(&mut c, left, &mut args);
    append_ordinary(&mut c, right, &mut args);
    return make_union(&mut c, args, 0, copy_bytes(view(".union")), view("Union"));
}
fn result_union_type<a>(c: (&a mut C), successes: u64[], failures: u64[]) -> u64 {
    mut args = u64[];
    for i in successes.len() {
        append_ordinary(&mut c, successes[i], &mut args);
    }
    success := args.len();
    for i in failures.len() {
        append_ordinary(&mut c, failures[i], &mut args);
    }
    return make_union(&mut c, args, success, copy_bytes(view(".result")), view("Result"));
}

fn parse_type<a>(c: (&a mut C)) -> u64 {
    mut t = 0;
    // Maps participate in postfix and union composition like other types.
    if is(&mut c, view("[")) {
        advance(&mut c);
        k := parse_type(&mut c);
        expect(&mut c, view(":"));
        v := parse_type(&mut c);
        expect(&mut c, view("]"));
        mut ma = u64[];
        ma.push(k);
        ma.push(v);
        t = named_type(&mut c, copy_bytes(view("hashmap")), copy_bytes(view("Map")), ma);
    } else {
        t = parse_type_base(&mut c);
    }
    while true {
        t = type_suffixes(&mut c, t);
        if !eat(&mut c, view("?")) {
            break;
        }
        mut oa = u64[];
        oa.push(t);
        t = named_type(&mut c, copy_bytes(view("core")), copy_bytes(view("OptionStorage")), oa);
    }
    if c.no_union == 0 {
        mut members = u64[];
        append_ordinary(&mut c, t, &mut members);
        while is(&mut c, view("|")) {
            mut p = c.pos;
            if is_at(&mut c, p + 1, view("?")) {
                advance(&mut c);
                advance(&mut c);
                mut failures = u64[];
                mut f = parse_union_member(&mut c);
                append_ordinary(&mut c, f, &mut failures);
                while is(&mut c, view("|")) {
                    p = c.pos;
                    if is_at(&mut c, p + 1, view("?")) {
                        fail(&mut c, view("result union |? is non-associative"));
                    }
                    advance(&mut c);
                    f = parse_union_member(&mut c);
                    append_ordinary(&mut c, f, &mut failures);
                }
                return result_union_type(&mut c, members, failures);
            }
            advance(&mut c);
            m := parse_union_member(&mut c);
            append_ordinary(&mut c, m, &mut members);
        }
        if 1 < members.len() {
            return make_union(&mut c, members, 0, copy_bytes(view(".union")), view("Union"));
        }
    }
    return t;
}
fn parse_union_member<a>(c: (&a mut C)) -> u64 {
    old := exchange(&mut c.no_union, 1);
    t := parse_type(&mut c);
    exchange(&mut c.no_union, old);
    return t;
}
fn type_suffixes<a>(c: (&a mut C), base: u64) -> u64 {
    mut out = base;
    while is(&mut c, view("[")) {
        advance(&mut c);
        expect(&mut c, view("]"));
        out = vec_of(&mut c, out);
    }
    return out;
}
fn token_starts_type<a>(c: (&a mut C), p: u64) -> bool {
    k := kind_at(&mut c, p);
    if k == 1 {
        return true;
    }
    return (k == 40) || (k == 91) || (k == 38);
}
fn type_keyword<a>(c: (&a mut C), n: &a [u8]) -> bool {
    if same(view(n), view("bool")) || same(view(n), view("char")) || same(view(n), view("string")) || same(view(n), view("u64")) {
        return true;
    }
    if same(view(n), view("u8")) || same(view(n), view("u16")) || same(view(n), view("u32")) || same(view(n), view("u64")) {
        return true;
    }
    if same(view(n), view("i8"))
        || same(view(n), view("i16"))
        || same(view(n), view("i32"))
        || same(view(n), view("i64"))
        || same(view(n), view("isize")) {
        return true;
    }
    if same(view(n), view("f32")) || same(view(n), view("f64")) || same(view(n), view("unit")) || same(view(n), view("read")) {
        return true;
    }
    if same(view(n), view("mut")) || same(view(n), view("Atomic")) || same(view(n), view("Mutex")) || same(view(n), view("Scope")) {
        return true;
    }
    return same(view(n), view("Task"))
        || same(view(n), view("CancelToken"))
        || same(view(n), view("fn"))
        || same(view(n), view("Fn"))
        || same(view(n), view("FnMut"));
}
fn lifetime_candidate<a>(c: (&a mut C), p: u64) -> bool {
    if kind_at(&mut c, p) != 1 {
        return false;
    }
    n := tok_text(&mut c, p);
    if n.len() == 0 {
        return false;
    }
    if (n[0] < 97) || (122 < n[0]) {
        return false;
    }
    if type_keyword(&mut c, view(n)) {
        return false;
    }
    return token_starts_type(&mut c, p + 1) || is_at(&mut c, p + 1, view("mut"));
}
fn is_at<a, b>(c: (&a mut C), p: u64, text: &b [u8]) -> bool {
    if p < c.toks.len() {
        t := tok_text(&mut c, p);
        return same(view(t), view(text));
    }
    return false;
}
fn lifetime_region<a>(c: (&a mut C), name: &a [u8]) -> u64 {
    for i in c.rnames.len() {
        r := &c.rnames[i];
        if same(view(r), view(name)) {
            return i + 1;
        }
    }
    if (name.len() != 0) & (96 < name[0]) & (name[0] < 123) {
        c.rnames.push(name.copy());
        return c.rnames.len();
    }
    fail(&mut c, view("undeclared lifetime"));
    return 0;
}
fn fresh_lifetime<a>(c: (&a mut C)) -> u64 {
    mut name = u8[];
    name.push(35);
    decimal(&mut name, c.rnames.len());
    c.rnames.push(name);
    return c.rnames.len();
}
fn slice_ahead<a>(c: (&a mut C), p: u64) -> bool {
    mut i = p + 1;
    mut depth = 0;
    while i < c.toks.len() {
        k := kind_at(&mut c, i);
        if k == 0 {
            return false;
        }
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        }
        if (k == 41) || (k == 93) || (k == 125) {
            if depth == 0 {
                return k == 93;
            }
            depth -= 1;
        }
        if (depth == 0) & (k == 58) {
            return false;
        }
        i += 1;
    }
    return false;
}
fn parse_slice_reference<a>(c: (&a mut C), mode: u64, r: u64) -> u64 {
    expect(&mut c, view("["));
    elem := parse_type(&mut c);
    expect(&mut c, view("]"));
    mut rs = u64[];
    rs.push(r);
    if elem != int_type(&mut c, 8, 0) {
        // `&[T]` / `&mut [T]`: a typed slice of any other element type (docs/design/typed-slices.md).
        return intern_full(&mut c, 27, elem, mode, rs);
    }
    return intern_full(&mut c, 5, 0, mode, rs);
}
fn note_input_region<a>(c: (&a mut C), r: u64) -> unit {
    for i in c.input_regions.len() {
        if c.input_regions[i] == r {
            return ();
        }
    }
    c.input_regions.push(r);
    return ();
}
fn outer_region<a>(c: (&a mut C), ty: u64) -> u64 {
    rs := type_regions(&mut c, ty);
    if rs.len() == 0 {
        return 0;
    }
    return rs[0];
}
fn parse_reference<a>(c: (&a mut C)) -> u64 {
    mut mode = 0;
    mut r = 0;
    mut p = c.pos;
    if is(&mut c, view("mut")) {
        advance(&mut c);
        mode = 1;
        p = c.pos;
        if lifetime_candidate(&mut c, p) {
            if c.typed_refs != 0 {
                fail(&mut c, view("write &a mut T, not &mut a T"));
            }
            n := tok_text(&mut c, p);
            r = lifetime_region(&mut c, view(n));
            advance(&mut c);
        }
    } else {
        if lifetime_candidate(&mut c, p) {
            n := tok_text(&mut c, p);
            r = lifetime_region(&mut c, view(n));
            advance(&mut c);
            if eat(&mut c, view("mut")) {
                mode = 1;
            }
        }
    }
    if r == 0 {
        if c.parsing_input != 0 {
            r = fresh_lifetime(&mut c);
        } else {
            if c.output_region == 0 {
                fail(&mut c, view("elided output reference needs one input lifetime"));
            }
            r = c.output_region;
        }
    }
    if c.parsing_input != 0 {
        note_input_region(&mut c, r);
    }
    p = c.pos;
    if is(&mut c, view("[")) & slice_ahead(&mut c, p) {
        return parse_slice_reference(&mut c, mode, r);
    }
    old := exchange(&mut c.no_union, 1);
    e := parse_type(&mut c);
    exchange(&mut c.no_union, old);
    mut rs = u64[];
    rs.push(r);
    return intern_full(&mut c, 7, e, mode, rs);
}
fn parse_type_base<a>(c: (&a mut C)) -> u64 {
    if eat(&mut c, view("&")) {
        return parse_reference(&mut c);
    }
    if eat(&mut c, view("(")) {
        if eat(&mut c, view(")")) {
            return 1;
        }
        old := exchange(&mut c.no_union, 0);
        t := parse_type(&mut c);
        exchange(&mut c.no_union, old);
        expect(&mut c, view(")"));
        return t;
    }
    first := ident(&mut c);
    return base_named(&mut c, first);
}
fn base_named<a>(c: (&a mut C), first: u8[]) -> u64 {
    if same(view(first), view("usize")) {
        fail(&mut c, view("usize was removed; use u64 for sizes and indices"));
    }
    for i in c.tnames.len() {
        t := &c.tnames[i];
        if same(view(t), view(first)) {
            if c.bindings.len() != 0 {
                return c.bindings[i];
            }
            bounds := c.type_bounds[i];
            mut proofs = u64[];
            set := copy_numbers(&c.type_interfaces[i]);
            for j in set.len() {
                id := set[j];
                proof := intern(&mut c, 15, id);
                proofs.push(proof);
            }
            return intern_args(&mut c, 9, i, bounds, u64[], proofs);
        }
    }
    if same(view(first), view("Self")) & ((c.self_type != 0)) {
        st := c.self_type - 1;
        if c.bindings.len() != 0 {
            b := copy_numbers(&c.bindings);
            return bind_types(&mut c, st, &b);
        }
        return st;
    }
    if eat(&mut c, view("::")) {
        n := ident(&mut c);
        a := find_alias(&mut c, view(first), view(n));
        if a != 0 {
            aty := c.aliases[a - 1].ty;
            if aty == 0 {
                fail(&mut c, view("recursive or unresolved type alias"));
            }
            return aty;
        }
        d := find_decl(&mut c, view(first), view(n));
        if d == 0 {
            fail(&mut c, view("unknown type"));
        }
        return nominal_type(&mut c, d - 1);
    }
    if same(view(first), view("Fn")) || same(view(first), view("FnMut")) {
        // `Fn` is callable through a shared reference; `FnMut` needs exclusive access to the value.
        fnmut := u64(same(view(first), view("FnMut")));
        expect(&mut c, view("("));
        mut params = u64[];
        if !eat(&mut c, view(")")) {
            while true {
                ty := parse_type(&mut c);
                params.push(ty);
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        if 5 < params.len() {
            fail(&mut c, view("closure type exceeds five parameters"));
        }
        expect(&mut c, view("->"));
        result := parse_type(&mut c);
        return intern_args(&mut c, 20, result, fnmut, u64[], params);
    }
    if same(view(first), view("cfn")) {
        // C function pointer: one word, no environment, called with the C ABI. Only
        // `extern "C"` definitions have such an address, so a closure cannot sneak in.
        expect(&mut c, view("("));
        mut params = u64[];
        if !eat(&mut c, view(")")) {
            while true {
                mut ty = 0;
                if ffi_byval_ahead(&mut c) {
                    advance(&mut c);
                    ty = ffi_byval_parameter(&mut c);
                } else {
                    ty = parse_type(&mut c);
                }
                params.push(ty);
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        if 64 < params.len() {
            fail(&mut c, view("cfn type exceeds 64 arguments"));
        }
        for i in params.len() {
            if ffi_out_param(&mut c, params[i]) {
                fail(
                    &mut c,
                    view("an out-parameter is only for an extern \"C\" declaration; a cfn type cannot declare one")
                );
            }
            ffi_direct_param(
                &mut c,
                params[i],
                view("cfn parameters must be an integer, f32, f64, CStr, handle, byte view, cfn, extern record or byval record")
            );
        }
        expect(&mut c, view("->"));
        result := parse_type(&mut c);
        return intern_args(&mut c, 25, result, 0, u64[], params);
    }
    if same(view(first), view("fn")) {
        expect(&mut c, view("("));
        mut params = u64[];
        if !eat(&mut c, view(")")) {
            while true {
                ty := parse_type(&mut c);
                params.push(ty);
                if eat(&mut c, view(")")) {
                    break;
                }
                expect(&mut c, view(","));
            }
        }
        expect(&mut c, view("->"));
        result := parse_type(&mut c);
        return intern_args(&mut c, 12, result, 0, u64[], params);
    }
    named := int_name(view(first));
    if named != 0 {
        return int_type_named(&mut c, named);
    }
    if same(view(first), view("bool")) {
        return bool_type(&mut c);
    }
    if same(view(first), view("f64")) {
        return float_type(&mut c);
    }
    if same(view(first), view("f32")) {
        return f32_type(&mut c);
    }
    if same(view(first), view("char")) {
        return char_type(&mut c);
    }
    if same(view(first), view("u64")) {
        return 0;
    }
    if same(view(first), view("unit")) {
        return 1;
    }
    if same(view(first), view("string")) {
        return 3;
    }
    if same(view(first), view("CPtr")) || same(view(first), view("CMutPtr")) {
        // One word: a bare C data pointer (`const void *` / `void *`) into Grail-owned bytes,
        // made by `unsafe cptr(view)` / `unsafe cptr_mut(&mut bytes)`. Mode 1 is writable.
        mode := u64(same(view(first), view("CMutPtr")));
        return intern_full(&mut c, 26, 0, mode, u64[]);
    }
    if same(view(first), view("CStr")) {
        // One word: a NUL-terminated byte pointer owned by the C side. Building one
        // is `unsafe cstr(view)` because it asserts termination and lifetime.
        return intern(&mut c, 24, 0);
    }
    if same(view(first), view("read")) || same(view(first), view("mut")) {
        if c.typed_refs != 0 {
            fail(&mut c, view("legacy byte-view types were removed; write &[u8] or &mut [u8]"));
        }
        mut rs = lifetime_arguments(&mut c);
        if rs.len() != 1 {
            fail(&mut c, view("view lifetime arity"));
        }
        mode := u64(same(view(first), view("mut")));
        return intern_full(&mut c, 5, 0, mode, rs);
    }
    // User declarations shadow the built-in generic types (a program may declare its own `Task`).
    here_module := module_copy(&mut c);
    shadowed := find_decl(&mut c, view(here_module), view(first)) != 0;
    if (shadowed == false) & same(view(first), view("Atomic")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        if e != 0 {
            fail(&mut c, view("Atomic currently requires u64 (one aligned 64-bit word)"));
        }
        return intern(&mut c, 11, 0);
    }
    if (shadowed == false) & same(view(first), view("Scope")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return intern(&mut c, 14, e);
    }
    if (shadowed == false) & same(view(first), view("Task")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return intern(&mut c, 16, e);
    }
    if (shadowed == false) & same(view(first), view("CancelToken")) {
        return intern(&mut c, 17, 0);
    }
    if (shadowed == false) & same(view(first), view("Mutex")) {
        expect(&mut c, view("<"));
        e := parse_type(&mut c);
        expect(&mut c, view(">"));
        return mutex_type(&mut c, e);
    }

    mut m = module_copy(&mut c);
    a := find_alias(&mut c, view(m), view(first));
    if a != 0 {
        aty := c.aliases[a - 1].ty;
        if aty == 18446744073709551615 {
            fail(&mut c, view("recursive or unresolved type alias"));
        }
        return aty;
    }
    imported := resolve_import(&mut c, view(first));
    if imported.len() != 0 {
        m = imported;
    }
    d := find_decl(&mut c, view(m), view(first));
    if d == 0 {
        fail(&mut c, view("unknown type"));
    }
    return nominal_type(&mut c, d - 1);
}
// ---- top level: pass 1 names, pass 2 fields/signatures/prototypes, pass 3 bodies ----
// --export NAME promotes the definition with that declared name to a global symbol. Matching is by
// declared name in any module, so the flag does not depend on mangling or on the object format.
fn exported<a, b>(c: (&a mut C), n: &b [u8]) -> u64 {
    mut hit = 0;
    for i in c.exports.len() {
        e := c.exports[i].copy();
        if same(view(e), view(n)) {
            cur := c.export_hits[i];
            mut h = &mut c.export_hits[i];
            exchange(&mut h, cur + 1);
            hit = 1;
        }
    }
    return hit;
}
fn mangle_into<a, b, d>(out: (&a mut u8[]), plat: u64, m: &b [u8], n: &d [u8]) -> unit {
    if plat == 1 {
        out.push(95);
    }
    if same(view(m), view("runtime")) {
        push_bytes(&mut out, n);
        return ();
    }
    push_bytes(&mut out, view("f_"));
    push_bytes(&mut out, m);
    out.push(95);
    push_bytes(&mut out, n);
    return ();
}
fn mangle<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> unit {
    plat := c.plat;
    mangle_into(&mut c.out, plat, m, n);
    return ();
}
// The symbol a function body is emitted under, as a value: the one thing the fact table is keyed
// by, and the only part of a body that is known before the body is parsed.
fn body_label<a, b, d, e>(c: (&a C), m: &b [u8], n: &d [u8], symbol: &e [u8], export: u64) -> u8[] {
    mut out = u8[];
    if export == 2 {
        if c.plat == 1 {
            out.push(95);
        }
        push_bytes(&mut out, symbol);
        if c.target == 3 {
            push_bytes(&mut out, view("_grail_body"));
        }
        return out;
    }
    mangle_into(&mut out, c.plat, m, n);
    return out;
}
fn alias_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("type"));
    name := ident(&mut c);
    module := module_copy(&mut c);
    expect(&mut c, view("="));
    if pass == 1 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        expect(&mut c, view(";"));
        if find_alias(&mut c, view(module), view(name)) != 0 {
            fail(&mut c, view("duplicate type alias"));
        }
        c.aliases.push(Alias { module: module, name: name, ty: 18446744073709551615 });
        return ();
    }
    if pass == 3 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        expect(&mut c, view(";"));
        return ();
    }
    ty := parse_type(&mut c);
    expect(&mut c, view(";"));
    a := find_alias(&mut c, view(module), view(name));
    if a == 0 {
        fail(&mut c, view("unknown type alias"));
    }
    entry := &mut c.aliases[a - 1];
    exchange(&mut entry.ty, ty);
    return ();
}
// `handle Name;` declares an opaque C handle type. Safe code can bind, compare and
// pass it, but cannot construct, size, inspect or drop one: it is a foreign token.
fn handle_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("handle"));
    name := ident(&mut c);
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    expect(&mut c, view(";"));
    if pass != 1 {
        return ();
    }
    m := module_copy(&mut c);
    if (find_decl(&mut c, view(m), view(name)) != 0) || (find_alias(&mut c, view(m), view(name)) != 0) {
        fail(&mut c, view("duplicate type"));
    }
    c
        .decls
        .push(
            Decl {
                module: m,
                name: name,
                is_enum: 0,
                opaque: 1,
                c_layout: 0,
                first: 0,
                count: 0,
                regions: 0,
                types: 0,
                success: 0,
                bounds: u64[],
                constraints: u64[][],
            }
        );
    return ();
}
fn decl<a>(c: (&a mut C), pass: u64) -> unit {
    is_enum := u64(is(&mut c, view("enum")));
    advance(&mut c);
    name := ident(&mut c);
    lifetime_parameters(&mut c);
    exchange(&mut c.parsing_input, 0);
    exchange(&mut c.output_region, 0);
    regions := c.rnames.len();
    types := c.tnames.len();
    bounds := copy_numbers(&c.type_bounds);
    constraints := copy_constraints(&c.type_interfaces);
    if pass != 2 {
        if pass == 1 {
            m := module_copy(&mut c);
            c
                .decls
                .push(
                    Decl {
                        module: m,
                        name: name,
                        is_enum: is_enum,
                        opaque: 0,
                        c_layout: 0,
                        first: 0,
                        count: 0,
                        regions: regions,
                        types: types,
                        success: 0,
                        bounds: bounds,
                        constraints: constraints,
                    }
                );
        }
        skip_braces(&mut c);
        eat(&mut c, view(";"));
        return ();
    }
    m := module_copy(&mut c);
    d := find_decl(&mut c, view(m), view(name));
    mut pending = Field[];
    mut count = 0;
    expect(&mut c, view("{"));
    if !eat(&mut c, view("}")) {
        while true {
            f := ident(&mut c);
            mut ty = 1;
            if is_enum != 0 {
                if eat(&mut c, view("(")) {
                    ty = parse_type(&mut c);
                    expect(&mut c, view(")"));
                }
            } else {
                expect(&mut c, view(":"));
                ty = parse_type(&mut c);
            }
            pending.push(Field { name: f, ty: ty });
            count = count + 1;
            if eat(&mut c, view("}")) {
                break;
            }
            expect(&mut c, view(","));
            if eat(&mut c, view("}")) {
                break;
            }
        }
    }
    eat(&mut c, view(";"));
    mut reverse = Field[];
    while pending.len() != 0 {
        reverse.push(pending.pop());
    }
    first := c.fields.len();
    while reverse.len() != 0 {
        c.fields.push(reverse.pop());
    }
    exchange(
        &mut c.decls[d - 1],
        Decl {
            module: m,
            name: name,
            is_enum: is_enum,
            opaque: 0,
            c_layout: 0,
            first: first,
            count: count,
            regions: c.rnames.len(),
            types: types,
            success: 0,
            bounds: bounds,
            constraints: constraints,
        }
    );
    return ();
}
// Words that start a statement or expression inside a body; they cannot name a binding or
// parameter. Declaration heads (`fn`, `struct`, `module`, `use`, ...) are recognised only at the
// top level and may name bindings.
fn is_keyword<a>(name: &a [u8]) -> bool {
    words := u8[][copy_bytes(view("mut")), copy_bytes(view("if")), copy_bytes(view("else")), copy_bytes(view("while")), copy_bytes(view("for")), copy_bytes(view("in")), copy_bytes(view("loop")), copy_bytes(view("match")), copy_bytes(view("return")), copy_bytes(view("break")), copy_bytes(view("continue")), copy_bytes(view("unsafe")), copy_bytes(view("true")), copy_bytes(view("false"))];
    for i in words.len() {
        if same(view(words[i]), view(name)) {
            return true;
        }
    }
    return false;
}
fn bind<a>(c: (&a mut C), name: u8[], ty: u64, id: u64, mutable: u64) -> unit {
    if is_keyword(view(name)) {
        fail(&mut c, view("a keyword cannot name a binding"));
    }
    if c.raw == 0 {
        if place_of(&mut c, id) == 0 {
            kind := ty_kind(&mut c, ty);
            if (kind == 1) || (kind == 2) || (kind == 12) || (kind == 17) || (kind == 18) || (kind == 19) || (kind == 21) || (kind == 22) {
                place := ownership::root(&mut c.check, 1, 1);
                c
                    .resources
                    .push(
                        Resource {
                            slot: id,
                            ty: ty,
                            flag: 0,
                            base: 0,
                            field: 0,
                            via: 0,
                            place: place,
                            target: 0,
                            authority: 0,
                        }
                    );
            }
        }
    }
    from := c.pos;
    to := c.scope_end;
    last := last_name(&mut c, view(name), from, to);
    mut debug_name = u8[];
    if c.debug != 0 {
        debug_name = copy_bytes(view(name));
    }
    c
        .locals
        .push(
            Local {
                name: name,
                ty: ty,
                id: id,
                last: last,
                born: from,
                mutable: mutable,
                flex: 0,
                lit: 0,
                neg: 0,
                origin: 0,
                at: 0,
            }
        );
    emit_slot_fact(&mut c, ty, id);
    if c.debug != 0 {
        line := source_line(&c, from);
        c
            .debug_vars
            .push(
                DebugVar {
                    name: debug_name,
                    slot: id,
                    line: line,
                    param: 0,
                    tname: debug_type_name(&mut c, ty),
                    tenc: debug_type_encoding(&mut c, ty),
                    tsize: debug_type_size(&mut c, ty)
