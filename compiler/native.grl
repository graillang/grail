    digest := iface_digest(&key);
    for i in 16 {
        out.push(digest[i]);
    }
    return out;
}
fn specialize<a, b>(c: (&a mut C), template: u64, map: (&b u64[])) -> u64 {
    f := &c.funcs[template];
    mut next = f.regions;
    first := f.first;
    count := f.count;
    ret := f.ret;
    mut args = u64[];
    for i in map.len() {
        t := map[i];
        a := canonical_type(&mut c, t, &mut next);
        args.push(a);
    }
    for i in c.specs.len() {
        old := &c.specs[i];
        if old.template == template {
            if numbers_equal(&old.args, &args) {
                return i;
            }
        }
    }
    if 1024 < c.specs.len() {
        fail(&mut c, view("generic specialization expansion limit"));
    }
    start := c.params.len();
    for i in count {
        bound := bind_types(&mut c, c.params[first + i], &args);
        c.params.push(bound);
    }
    result := bind_types(&mut c, ret, &args);
    index := c.specs.len();
    c.specs.push(Spec { template: template, args: args, first: start, ret: result, requester: c.body_module.copy() });
    return index;
}
fn replay_function<a>(c: (&a mut C), template: u64) -> unit {
    f := &c.funcs[template];
    file := f.file;
    pos := f.pos;
    raw := f.raw;
    mut module = f.module.copy();
    home := f.home.copy();
    owner := f.owner;
    mut generic_impl = 0;
    if owner >= generic_impl_key(0) {
        // A method of a generic interface implementation: its home module, and the implementation
        // it belongs to (so its own parameters are prepended again).
        generic_impl = owner - generic_impl_key(0);
        module = home;
        exchange(&mut c.current_impl, generic_impl);
        st := impl_self(&mut c, owner);
        exchange(&mut c.self_type, st);
    } else if owner != 0 {
        d := &c.decls[owner - 1];
        module = d.module.copy();
        exchange(&mut c.inherent, owner);
        st := impl_self(&mut c, owner);
        exchange(&mut c.self_type, st);
    }
    load_file(&mut c, file);
    exchange(&mut c.file, file);
    exchange(&mut c.pos, pos);
    exchange(&mut c.raw, raw);
    exchange(&mut c.module, module);
    opted := u64(host_opted(&c, view(c.module)));
    exchange(&mut c.host_optin, opted);
    func(&mut c, 4, 0);
    exchange(&mut c.inherent, 0);
    exchange(&mut c.self_type, NO_TYPE);
    if generic_impl != 0 {
        exchange(&mut c.current_impl, 0);
    }
    return ();
}
fn emit_specializations<a>(c: (&a mut C)) -> unit {
    // Validate even unused templates with affine, opaque type variables. Discard only
    // generated code; failed checking still aborts before publishing any output.
    count := c.funcs.len();
    exchange(&mut c.validating, 1);
    for i in count {
        f := &c.funcs[i];
        types := f.types;
        contract := f.contract;
        mut owner = f.module.copy();
        // A template this run instantiates is replayed here even when another module owns it: that
        // replay is the check the caller owes the instantiation, and it is what refuses a generic
        // instantiated on a type the caller may not share. Only the *code* belongs to the owner.
        mut check = !iface_owned(&mut c, view(owner));
        if !check {
            check = instantiated(&mut c, i);
        }
        if (types != 0) & (contract == 0) & check {
            saved := c.out.len();
            part_mark := c.part.copy();
            part_lpart := c.lpart.copy();
            part_lunit := c.lunit;
            part_label := c.label;
            part_ref := c.ref_next;
            replay_function(&mut c, i);
            while saved < c.out.len() {
                c.out.pop();
            }
            exchange(&mut c.part, part_mark);
            exchange(&mut c.lpart, part_lpart);
            exchange(&mut c.label, part_label);
            exchange(&mut c.ref_next, part_ref);
            c.lunit = part_lunit;
            if (part_lunit != 0) & (part_lunit <= c.lnext.len()) {
                c.lnext[part_lunit - 1] = part_label;
                c.rnext[part_lunit - 1] = part_ref;
            }
        }
    }
    exchange(&mut c.validating, 0);
    drain_specs(&mut c, 0);
    return ();
