// ---- capturing closures: `|x: T, ...| -> R body`, type Fn(T,...)->R (kind 20) ----
// The value is an owned record {code, dropper, captures...}. Scalars are copied into it and owned
// values moved; a direct reference or view (`&T`, `&[T]`, `&mut T`) moves in as well, pointer and
// loan together, so the closure's type carries the regions it borrows and it cannot outlive them.
// The body is compiled afterwards as a separate function whose hidden first parameter is a shared
// reference to that record, so captures are read-only fields (no mutation, no moving out).
fn closure_free_name<a, b>(c: (&a mut C), name: &b [u8], params: (&a u8[][])) -> bool {
    for i in params.len() {
        p := &params[i];
        if same(view(p), view(name)) {
            return false;
        }
    }
    return true;
}
// A capture that is itself a reference or view: the pointer moves into the environment and the
// loan moves with it. An aggregate holding a loan - an iterator over a borrowed vector - moves in as
// the owned value it is, with its own layout and dropper; its loans move with it as well, so the
// closure carries their lifetimes: see capture_aggregate_regions.
fn capture_borrow<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        return true;
    }
    return false;
}
// The lifetimes the loans held anywhere inside a captured aggregate borrow.
fn capture_aggregate_regions<a, b>(c: (&a mut C), slot: u64, caps: (&b mut u64[])) -> unit {
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    for i in c.bonds.len() {
        holder := c.bonds[i].holder;
        loan := c.bonds[i].loan;
        if (loan_live(&mut c, loan) != 0) && ownership::ancestor(&c.check, place, holder) {
            // stays: `c.check.loans[loan - 1]` is a borrowed element (see drop_hook_symbol).
            source := c.check.loans[loan - 1].source;
            add_region(&mut caps, region_of(&mut c, source));
        }
    }
    return ();
}
// The lifetime a captured reference actually borrows: the region of the place its live loan reads.
// A local source has region 0, which no closure type may carry out of the function.
fn capture_region<a>(c: (&a mut C), slot: u64) -> u64 {
    place := place_of(&mut c, slot);
    if place == 0 {
        return 0;
    }
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if (holder == place) & (guard == 0) {
            if loan_live(&mut c, loan) != 0 {
                mut l = &c.check.loans[loan - 1];
                source := l.source;
                return region_of(&mut c, source);
            }
        }
    }
    return 0;
}
// The environment field is declared in the environment's own lifetime (`env` is region 1): the body
// re-borrows the captured reference from the environment, never from the enclosing function's
// lifetime names, which do not exist there.
fn capture_field_type<a>(c: (&a mut C), ty: u64) -> u64 {
    mut rs = u64[];
    rs.push(1);
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    return intern_args(&mut c, k, arg, mode, rs, u64[]);
}
// `=`, `+=`, `-=`, `*=`, `/=`, `%=` or `**=`.
fn is_assign_kind(k: u64) -> bool {
    return (k == 61) || ((261 < k) && (k < 267)) || (k == 268);
}
// Whether a place rooted just past `j` (`.field` and `[index]` steps) is assigned to: the body
// stores into the capture itself, a field of it, or an element of it.
fn place_assign_after<a>(c: (&a mut C), j: u64, end: u64) -> bool {
    mut p = j;
    while p < end {
        k := kind_at(&mut c, p);
        if k == 46 {
            if kind_at(&mut c, p + 1) != 1 {
                return false;
            }
            p = p + 2;
        } else if k == 91 {
            mut depth = 0;
            mut closed = 0;
            while p < end {
                kk := kind_at(&mut c, p);
                if (kk == 40) || (kk == 91) || (kk == 123) {
                    depth += 1;
                } else if (kk == 41) || (kk == 93) || (kk == 125) {
                    depth -= 1;
                    if depth == 0 {
                        p = p + 1;
                        closed = 1;
                        break;
                    }
                    if depth < 0 {
                        return false;
                    }
                }
                p = p + 1;
            }
            if closed == 0 {
                return false;
            }
        } else {
            break;
        }
    }
    return is_assign_kind(kind_at(&mut c, p));
}
// Container methods that never mutate their receiver. Anything not named here is treated as a
// write, so a closure calling it needs exclusive access rather than silently aliasing.
fn read_only_method<a>(n: &a [u8]) -> bool {
    return same(view(n), view("len"))
        || same(view(n), view("is_empty"))
        || same(view(n), view("contains"))
        || same(view(n), view("first"))
        || same(view(n), view("last"))
        || same(view(n), view("get"))
        || same(view(n), view("position"))
        || same(view(n), view("index_of"))
        || same(view(n), view("keys"))
        || same(view(n), view("values"))
        || same(view(n), view("entries"))
        || same(view(n), view("upper"))
        || same(view(n), view("lower"))
        || same(view(n), view("to_uppercase"))
        || same(view(n), view("to_lowercase"))
        || same(view(n), view("trim"))
        || same(view(n), view("chars"))
        || same(view(n), view("split"))
        || same(view(n), view("repeat"))
        || same(view(n), view("starts_with"))
        || same(view(n), view("ends_with"))
        || same(view(n), view("size"))
        || same(view(n), view("capacity"));
}
// Whether the use of a capture at token `i` writes it. A write is a store to the capture or to a
// place rooted at it (`n = ...`, `n += ...`, `r.f = ...`, `v[i] = ...`, `*r = ...`, which is the
// same shape), a mutable borrow of it (`&mut n`), or a method call that may mutate its receiver.
// A shared reference or view can only be read through, so its methods stay reads.
fn capture_written_at<a>(c: (&a mut C), i: u64, end: u64, ty: u64) -> bool {
    if place_assign_after(&mut c, i + 1, end) {
        return true;
    }
    if i > 1 {
        // `&mut n`: an exclusive borrow of the capture, so the environment must be exclusive too.
        if (kind_at(&mut c, i - 2) == 38) & same(view(tok_text(&mut c, i - 1)), view("mut")) {
            return true;
        }
    }
    if (kind_at(&mut c, i + 1) == 46) & (kind_at(&mut c, i + 3) == 40) {
        k := ty_kind(&mut c, ty);
        if ((k == 5) || (k == 7) || (k == 27)) & (ty_mode(&mut c, ty) == 0) {
            return false;
        }
        if (ty_kind(&mut c, ty) != 8) & (ty_kind(&mut c, ty) != 20) {
            m := tok_text(&mut c, i + 2);
            if read_only_method(view(m)) {
                return false;
            }
        }
        return true;
    }
    return false;
}
// Index + 1 of `name` in `names`, or 0.
fn capture_index<a, b>(names: (&a u8[][]), name: &b [u8]) -> u64 {
    for j in names.len() {
        x := &names[j];
        if same(view(x), view(name)) {
            return j + 1;
        }
    }
    return 0;
}
// Index + 1 of a capture of the closure being compiled, or 0.
fn capture_of<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    current := c.closure_env;
    if current == 0 {
        return 0;
    }
    cl := &c.closures[current - 1];
    for j in cl.captures.len() {
        x := &cl.captures[j];
        if same(view(x), view(name)) {
            return j + 1;
        }
    }
    return 0;
}
// Whether the closure being compiled writes the named capture: only then may the body take
// exclusive access to the environment field that holds it.
fn capture_writable<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    j := capture_of(&mut c, view(name));
    if j == 0 {
        return 0;
    }
    cl := &c.closures[c.closure_env - 1];
    return cl.written[j - 1];
}
// A reference to a capture's environment field: shared for a read (`&name`), exclusive for a store.
// The field belongs to the environment, so an exclusive reference needs an `FnMut` closure.
fn capture_place<a, b>(c: (&a mut C), name: &b [u8], write: u64) -> Val {
    if write != 0 {
        if capture_writable(&mut c, view(name)) == 0 {
            fail(&mut c, view("captured values are read-only inside a closure"));
        }
    }
    v := capture_field(&mut c, view(name), 1, write);
    if v.ty == NO_TYPE {
        fail(
            &mut c,
            view("reference needs a variable or field (bind the value first: x := ...; &x)")
        );
    }
    target := target_of(&mut c, v.t);
    r := resource(&mut c, v.t);
    info := &c.resources[r - 1];
    base := info.base - 1;
    before := c.check.loans.len();
    mut ref = borrow_reference(&mut c, v.t, v.ty, base, target, write);
    // A reborrow from the environment's own authority records no bond of its own: the reference
    // holds the loan to the field, so the store through it must find that loan here.
    after := c.check.loans.len();
    if after > before {
        holder := place_of(&mut c, ref.t);
        bond(&mut c, holder, after);
    }
    return ref;
}
// ---- closure inference ----------------------------------------------------------------------------
// `iter::of(v).map(|x| x * 2)`: a closure literal's parameter types come from the function type it is
// passed or bound as (Rust's rule), and an omitted result type from that type or from its body.
// `map` is the call's inference so far: a parameter whose type mentions an unfixed type parameter is
// left unknown.
fn closure_hint<a, b>(c: (&a mut C), expected: u64, map: (&b u64[])) -> unit {
    k := ty_kind(&mut c, expected);
    if (k != 20) && (k != 12) {
        return ();
    }
    params := type_args(&mut c, expected);
    mut hp = u64[];
    for i in params.len() {
        hp.push(bound_or_unknown(&mut c, params[i], &map));
    }
    ret := ty_arg(&mut c, expected);
    hr := bound_or_unknown(&mut c, ret, &map);
    exchange(&mut c.hint_params, hp);
    exchange(&mut c.hint_ret, hr);
    exchange(&mut c.hint_set, 1);
    return ();
}
fn bound_or_unknown<a, b>(c: (&a mut C), ty: u64, map: (&b u64[])) -> u64 {
    if map.len() == 0 {
        return ty;
    }
    if mentions_unbound(&mut c, ty, &map) {
        return NO_TYPE;
    }
    return bind_types(&mut c, ty, &map);
}
fn mentions_unbound<a, b>(c: (&a mut C), ty: u64, map: (&b u64[])) -> bool {
    k := ty_kind(&mut c, ty);
    if k == 9 {
        i := ty_arg(&mut c, ty);
        return (map.len() <= i) || (map[i] == NO_TYPE);
    }
    if k == 15 {
        return false;
    }
    if (k == 6) || (k == 7) || (k == 5) || (k == 27) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20) || (k == 29) || (k == 10) || (k == 30) {
        inner := ty_arg(&mut c, ty);
        if mentions_unbound(&mut c, inner, &map) {
            return true;
        }
    }
    args := type_args(&mut c, ty);
    for i in args.len() {
        a := args[i];
        if mentions_unbound(&mut c, a, &map) {
            return true;
        }
    }
    return false;
}
// The type of a closure's expression body (at c.pos), found by compiling it once in isolation and
// throwing the result away: the parameters are bound to their types and the enclosing locals the
// body names to theirs, as emit_closures binds them; nothing it does survives.
fn closure_body_type<a, b, d>(c: (&a mut C), names: (&b u8[][]), params: (&d u64[])) -> u64 {
    start := c.pos;
    found := isolated_body_type(&mut c, start, &names, &params);
    return found[0];
}
// The type of the expression starting at `start` and its end token, found by compiling it once in
// isolation: [type, end]. `names` and `params` are a closure's own parameters (empty for a call
// argument); every other enclosing local the expression names is bound to its type, as a capture
// would be. The expression's end is the first token at depth zero that cannot continue it - a `,`,
// a `;`, or a closing bracket - which is exactly where a call argument ends.
fn isolated_body_type<a, b, d>(c: (&a mut C), start: u64, names: (&b u8[][]), params: (&d u64[])) -> u64[] {
    // The token this call was made at: the parse below starts at `start` and gives the position back,
    // so a caller that only asks for a type (an argument) leaves the real parse where it was.
    enter := c.pos;
    // The body's end, as closure_literal finds it.
    mut end = start;
    mut depth = 0;
    while true {
        k := kind_at(&mut c, end);
        if k == 0 {
            break;
        }
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        }
        if (k == 41) || (k == 93) || (k == 125) {
            if depth == 0 {
                break;
            }
            depth -= 1;
        }
        if ((k == 44) || (k == 59)) && (depth == 0) {
            break;
        }
        end += 1;
    }
    // Enclosing locals the body names (the closure's would-be captures), with their types.
    mut cap_names = u8[][];
    mut cap_types = u64[];
    for i in start..end {
        if kind_at(&mut c, i) == 1 {
            name := tok_text(&mut c, i);
            if closure_free_name(&mut c, view(name), &names) & closure_free_name(&mut c, view(name), &cap_names) {
                local := find_local(&mut c, view(name));
                if local != 0 {
                    t := local_ty(&mut c, local - 1);
                    cap_names.push(name);
                    cap_types.push(t);
                }
            }
        }
    }
    out_mark := c.out.len();
    closures_mark := c.closures.len();
    specs_mark := c.specs.len();
    saved_locals := exchange(&mut c.locals, Local[]);
    saved_resources := exchange(&mut c.resources, Resource[]);
    saved_check := exchange(&mut c.check, ownership::new());
    saved_members := exchange(&mut c.members, Member[]);
    saved_bonds := exchange(&mut c.bonds, Bond[]);
    saved_pointers := exchange(&mut c.pointers, Pointer[]);
    saved_origins := exchange(&mut c.origins, Origin[]);
    saved_next := exchange(&mut c.next, 0);
    saved_scope := exchange(&mut c.scope_end, end);
    saved_loop_start := exchange(&mut c.loop_start, 0);
    saved_loop_end := exchange(&mut c.loop_end, 0);
    saved_terminated := exchange(&mut c.terminated, 0);
    saved_result := exchange(&mut c.result, NO_TYPE);
    saved_validating := exchange(&mut c.validating, 1);
    saved_cf_start := exchange(&mut c.cf_start, 0);
    saved_cf_end := exchange(&mut c.cf_end, 0);
    saved_cf_local := exchange(&mut c.cf_local, 0);
    for j in params.len() {
        id := fresh(&mut c);
        bind(&mut c, names[j].copy(), params[j], id, 0);
    }
    for j in cap_types.len() {
        id := fresh(&mut c);
        bind(&mut c, cap_names[j].copy(), cap_types[j], id, 0);
    }
    for j in c.locals.len() {
        mut l = &mut c.locals[j];
        exchange(&mut l.last, end);
        slot := l.id;
        ty := l.ty;
        own(&mut c, slot, ty);
        init_parameter(&mut c, slot, ty);
    }
    exchange(&mut c.pos, start);
    v := expr(&mut c, 0);
    result := v.ty;
    exchange(&mut c.pos, enter);
    while out_mark < c.out.len() {
        c.out.pop();
    }
    while closures_mark < c.closures.len() {
        c.closures.pop();
    }
    while specs_mark < c.specs.len() {
        c.specs.pop();
    }
    exchange(&mut c.locals, saved_locals);
    exchange(&mut c.resources, saved_resources);
    exchange(&mut c.check, saved_check);
    exchange(&mut c.members, saved_members);
    exchange(&mut c.bonds, saved_bonds);
    exchange(&mut c.pointers, saved_pointers);
    exchange(&mut c.origins, saved_origins);
    exchange(&mut c.next, saved_next);
    exchange(&mut c.scope_end, saved_scope);
    exchange(&mut c.loop_start, saved_loop_start);
    exchange(&mut c.loop_end, saved_loop_end);
    exchange(&mut c.terminated, saved_terminated);
    exchange(&mut c.result, saved_result);
    exchange(&mut c.validating, saved_validating);
    exchange(&mut c.cf_start, saved_cf_start);
    exchange(&mut c.cf_end, saved_cf_end);
