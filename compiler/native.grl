// ---- closure inference ----------------------------------------------------------------------------
// `iter::of(v).map(|x| x * 2)`: a closure literal's parameter types come from the function type it is
// passed or bound as (Rust's rule), and an omitted result type from that type or from its body.
// `map` is the call's inference so far: a parameter whose type mentions an unfixed type parameter is
// left unknown.
fn closure_hint<a, b>(c: (&a mut C), expected: u64, map: (&b u64[])) -> unit {
    k := ty_kind(&mut c, expected);
    if (k != 20) && (k != 12) {
        return ();
