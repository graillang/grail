    if (k == 45) & (b <= a) {
        return u64[1, a - b];
    }
    if k == 42 {
        if (a == 0) || (b <= 18446744073709551615 / a) {
            return u64[1, a * b];
        }
    }
    if (k == 47) & (b != 0) {
        return u64[1, a / b];
    }
    if (k == 37) & (b != 0) {
        return u64[1, a % b];
    }
    if (k == 271) & (b < 64) {
        if a <= (18446744073709551615 >> b) {
            return u64[1, a << b];
        }
    }
    if (k == 272) & (b < 64) {
        return u64[1, a >> b];
    }
    if k == 38 {
        return u64[1, a & b];
    }
    if k == 124 {
        return u64[1, a | b];
    }
    if k == 94 {
        return u64[1, a ^ b];
    }
    return u64[0, 0];
