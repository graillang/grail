                    home: item_home_9,
                    module: module,
                    name: name,
                    first: first,
                    count: count,
                    ret: ret,
                    types: method_types,
                    regions: regions,
                    file: 0,
                    pos: 0,
                    raw: 0,
                    unsafe_fn: 0,
                    bounds: bounds,
                    constraints: requirements,
                    contract: id,
                    owner: 0,
                    ext: 0,
                    symbol: u8[],
                    body: default_text,
                    ppreds: Pred[],
                    rpred: no_pred(),
                    pnames: u8[][],
                    pdefaults: Pred[],
                    strict: 0,
                    no_alloc: 0,
                    no_panic: 0,
                }
            );
        index := c.funcs.len() - 1;
        here_file := c.file;
        item := &mut c.interfaces[id - 1];
        item.methods.push(index);
        item.defaults.push(default);
        item.default_files.push(here_file);
    }
    exchange(&mut c.self_type, NO_TYPE);
    return ();
}
// ---- default interface methods ---------------------------------------------------------------------
// An implementation that leaves out a method with a default body gets that body as if it had been
// written in the implementation: it is compiled once per implementing type, with `Self` that type,
// names resolving in the interface's module, and diagnostics pointing at the interface (Rust's
// provided methods). `pass` 2 declares them once every implementation's own methods are known;
// pass 3 emits their bodies.
fn default_methods<a>(c: (&a mut C), pass: u64) -> unit {
    saved_file := c.file;
    saved_module := c.module.copy();
    saved_raw := c.raw;
    mut touched = false;
    for k in c.implementations.len() {
        implementation := &c.implementations[k];
        contract := implementation.contract;
        ty := implementation.ty;
        owner := implementation.module.copy();
        own := copy_numbers(&implementation.methods);
        if iface_owned(&mut c, view(owner)) {
            continue;
        }
        interface := &c.interfaces[contract - 1];
        expected := copy_numbers(&interface.methods);
        defaults := copy_numbers(&interface.defaults);
        files := copy_numbers(&interface.default_files);
        home := interface.module.copy();
        for j in expected.len() {
            if (defaults.len() <= j) || (defaults[j] == 0) {
                continue;
            }
            name := c.funcs[expected[j]].name.copy();
            mut written = false;
            for m in own.len() {
                if same(view(c.funcs[own[m]].name), view(name)) && !default_copy(&c, own[m]) {
                    written = true;
                }
            }
            if written {
                continue;
            }
            touched = true;
            load_file(&mut c, files[j]);
            exchange(&mut c.file, files[j]);
            exchange(&mut c.pos, defaults[j] - 1);
            exchange(&mut c.raw, 0);
            exchange(&mut c.module, home.copy());
            exchange(&mut c.host_optin, u64(host_opted(&c, view(c.module))));
            exchange(&mut c.rnames, u8[][]);
            exchange(&mut c.tnames, u8[][]);
            exchange(&mut c.type_bounds, u64[]);
            exchange(&mut c.type_interfaces, u64[][]);
            exchange(&mut c.current_impl, k + 1);
            exchange(&mut c.self_type, ty);
            before := c.funcs.len();
            func(&mut c, pass, 0);
            exchange(&mut c.current_impl, 0);
            exchange(&mut c.self_type, NO_TYPE);
            if pass == 2 {
                item := &mut c.implementations[k];
                item.methods.push(before);
                c.default_copies.push(before);
            }
        }
    }
    if touched {
        load_file(&mut c, saved_file);
        exchange(&mut c.file, saved_file);
        exchange(&mut c.module, saved_module);
        exchange(&mut c.raw, saved_raw);
        exchange(&mut c.host_optin, u64(host_opted(&c, view(c.module))));
    }
    return ();
}
// Whether method `index` is a copied default rather than written in its implementation.
fn default_copy<a>(c: (&a C), index: u64) -> bool {
    for i in c.default_copies.len() {
        if c.default_copies[i] == index {
            return true;
        }
    }
    return false;
}
// ---- inherent impls on a written type -------------------------------------------------------------
// `impl<T> T[] { ... }` and `impl [u8] { ... }` give methods to a type no module declares. The owner
// is the type as written, and the impl is keyed by that type: its key is `inherent_type_base` plus
// its 1-based position in `c.inherent_types`, so its methods live in the private module
// `.inherent_<key-1>` exactly as a declared type's do. A declared type keeps using its declaration
// index as the key, so `impl_self` and `prepend_impl_params` need no branch for this: every
// written-type impl registers an ImplParams record under its key, which is where `impl_self` looks.
fn inherent_type_base() -> u64 {
    return 500000000;
}
// Whether the written-type impl at `key` has the header the parser just read: the same owner type
// and the same parameters (names, bounds and required interfaces).
fn inherent_same_header<a>(c: (&a mut C), key: u64, ty: u64) -> bool {
    i := key - inherent_type_base();
    if (i == 0) || (c.inherent_types.len() < i) {
        return false;
    }
    if same_type(&mut c, c.inherent_types[i - 1], ty) == 0 {
        return false;
    }
    record := impl_record(&mut c, key);
    if record == 0 {
        return c.tnames.len() == 0;
    }
    p := &c.impl_params[record - 1];
    if (p.rnames.len() != c.rnames.len()) || (p.tnames.len() != c.tnames.len()) {
        return false;
    }
    if p.bounds.len() != c.type_bounds.len() {
        return false;
    }
    for j in p.bounds.len() {
        if p.bounds[j] != c.type_bounds[j] {
            return false;
        }
    }
    if p.interfaces.len() != c.type_interfaces.len() {
        return false;
    }
    for j in p.interfaces.len() {
        want := copy_numbers(&c.type_interfaces[j]);
        have := copy_numbers(&p.interfaces[j]);
        if want.len() != have.len() {
            return false;
        }
        for k in want.len() {
            if want[k] != have[k] {
                return false;
            }
        }
    }
    return true;
}
fn inherent_is_type_key(owner: u64) -> bool {
    // Below the generic-implementation namespace: a written-type impl's owner is a key of its own,
    // not a position in `c.decls` (that is `owner - 1 < decls.len()`) and not a generic impl.
    return (inherent_type_base() <= owner) & (owner < generic_impl_key(0));
}
// The private module a written-type impl's methods are in.
fn inherent_type_module(key: u64) -> u8[] {
    return private_module(view(".inherent_"), key - 1);
}
// The owner type a written-type impl is for, or NO_TYPE.
fn inherent_owner_type<a>(c: (&a mut C), owner: u64) -> u64 {
    if !inherent_is_type_key(owner) {
        return NO_TYPE;
    }
    i := owner - inherent_type_base();
    if (i == 0) || (c.inherent_types.len() < i) {
        return NO_TYPE;
    }
    return c.inherent_types[i - 1];
}
// Whether `name` is part of a collection's protocol: the methods the compiler itself resolves on a
// vector, a byte sequence, a string, a view or a slice. They are the language's own operations, not
// library surface - `for i in v.len()`, `v[i]`, `v.push(x)`, `v.clear()` are what the bounds checks
// and the vector growth protocol are built on - so an impl may not take one over.
fn protocol_method_name<a, b>(c: (&a mut C), k: u64, name: &b [u8]) -> bool {
    // A vector, a slice, a byte sequence, a string and a view: the kinds that carry the collection
    // protocol (`len`, indexed access, growth).
    if (k == 3) || (k == 4) || (k == 5) || (k == 6) || (k == 27) {
        if same(view(name), view("len"))
            || same(view(name), view("push"))
            || same(view(name), view("pop"))
            || same(view(name), view("insert"))
            || same(view(name), view("remove"))
            || same(view(name), view("swap"))
            || same(view(name), view("contains"))
            || same(view(name), view("reverse"))
            || same(view(name), view("append"))
            || same(view(name), view("truncate"))
            || same(view(name), view("clear")) {
            return true;
        }
    }
    return false;
}
// A method that would set what a protocol name means is refused where it is defined, so no call site
// silently changes meaning: the message says what the name is and asks for another one.
fn inherent_protocol_refused<a, b>(c: (&a mut C), owner: u64, name: &b [u8], at: u64) -> unit {
    ty := inherent_owner_type(&mut c, owner);
    if ty == NO_TYPE {
        return ();
    }
    if !protocol_method_name(&mut c, ty_kind(&mut c, ty), name) {
        return ();
    }
    mut msg = copy_bytes(view("`"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("` is part of the collection protocol of `"));
    push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
    push_bytes(
        &mut msg,
        view(
            "`, so an inherent impl cannot set it: the compiler resolves that name itself, and `for i in v.len()` and every bounds check depend on what it means. Give this method another name."
        )
    );
    exchange(&mut c.pos, at);
    fail(&mut c, view(msg));
    return ();
}
// The owner type of an inherent impl header: a type as written, or `[T]`, the slice spelling the
// type grammar has no other place for (`&[T]` is the reference to it, `T[]` the vector).
fn parse_inherent_owner<a>(c: (&a mut C)) -> u64 {
    if is(&mut c, view("[")) & slice_ahead(&mut c, c.pos) {
        advance(&mut c);
        elem := parse_type(&mut c);
        expect(&mut c, view("]"));
        if elem == int_type(&mut c, 8, 0) {
            return intern_full(&mut c, 5, 0, 0, u64[]);
        }
        return intern_full(&mut c, 27, elem, 0, u64[]);
    }
    return parse_type(&mut c);
}
// `type_matches` with the one relaxation an impl's written owner needs: `impl [T]` names the slice
// of T, and the mode of a slice is a property of the value, not of the impl - the method's own
// `self` type says whether it reads or writes - so the owner matches a slice receiver of either
// mode. Mutability is still checked at the call, against that `self` type.
fn inherent_pattern_fits<a, b>(c: (&a mut C), pattern: u64, actual: u64, map: (&b mut u64[])) -> bool {
    pk := ty_kind(&mut c, pattern);
    ak := ty_kind(&mut c, actual);
    if (pk == ak) & ((pk == 27) || (pk == 5)) {
        return inherent_match(&mut c, ty_arg(&mut c, pattern), ty_arg(&mut c, actual), &mut map);
    }
    return inherent_match(&mut c, pattern, actual, &mut map);
}
// `type_matches` that binds every parameter the pattern names, even where the two types are already
// equal: a generic function forwarding to `impl<T> T[]`'s method has the *same* parameter on both
// sides, which `same_type` answers without binding anything - and the caller still has to know that
// the implementation is `T[]`'s.
fn inherent_match<a, b>(c: (&a mut C), pattern: u64, actual: u64, map: (&b mut u64[])) -> bool {
    pk := ty_kind(&mut c, pattern);
    if pk == 9 {
        i := ty_arg(&mut c, pattern);
        if map.len() <= i {
            return false;
        }
        if map[i] == NO_TYPE {
            exchange(&mut map[i], actual);
        }
        return true;
    }
    mut a = actual;
    mut unwrapped = 0;
    if pk != ty_kind(&mut c, a) {
        // A specialisation binds a parameter to the concrete type it stands for.
        candidate := base_type(&mut c, a);
        if ty_kind(&mut c, candidate) == ty_kind(&mut c, a) {
            return false;
        }
        a = candidate;
        unwrapped = 1;
        if pk != ty_kind(&mut c, a) {
            return false;
        }
    }
    if (pk == 5) || (pk == 6) || (pk == 7) || (pk == 27) {
        if ty_mode(&mut c, pattern) != ty_mode(&mut c, a) {
            return false;
        }
        return inherent_match(&mut c, ty_arg(&mut c, pattern), ty_arg(&mut c, a), &mut map);
    }
    if pk == 8 {
        if ty_arg(&mut c, pattern) != ty_arg(&mut c, a) {
            return false;
        }
        pargs := type_args(&mut c, pattern);
        aargs := type_args(&mut c, a);
        if pargs.len() != aargs.len() {
            return false;
        }
        for k in pargs.len() {
            if !inherent_match(&mut c, pargs[k], aargs[k], &mut map) {
                return false;
            }
        }
        return true;
    }
    if unwrapped != 0 {
        // A replayed generic body's receiver is a specialisation alias. The alias does name a
        // concrete type, but a method call on it is the method its *bound* declares (`P: Probe` ->
        // `Probe::first_byte`), not an inherent method of the type it stands for - which is also what
        // the value's type can carry: the receiver is `&(the alias)`, and only the interface
        // signature is written in those terms.
        return false;
    }
    return same_type(&mut c, pattern, a) != 0;
}
// The type arguments a written-type impl binds for a receiver of type `actual`: (found, map).
fn inherent_bindings<a>(c: (&a mut C), key: u64, actual: u64) -> (u64, u64[]) {
    i := key - inherent_type_base();
    if (i == 0) || (c.inherent_types.len() < i) {
        return (0, u64[]);
    }
    // A key with no parameters need carry no record: the owner pattern then names no parameter, and
    // there is no bound to satisfy. (The interface reader registers a record only for a generic impl.)
    record := impl_record(&mut c, key);
    mut count = 0;
    if record != 0 {
        count = c.impl_params[record - 1].tnames.len();
    }
    pattern := c.inherent_types[i - 1];
    mut map = u64[];
    for k in count {
        map.push(NO_TYPE);
    }
    if !inherent_pattern_fits(&mut c, pattern, actual, &mut map) {
        return (0, u64[]);
    }
    mut sets = u64[][];
    if record != 0 {
        sets = copy_constraints(&c.impl_params[record - 1].interfaces);
    }
    infer_from_callables(&mut c, &sets, &mut map);
    for k in count {
        mut bound = map[k];
        if bound == NO_TYPE {
            return (0, u64[]);
        }
        if k < sets.len() {
            for j in sets[k].len() {
                if !meets_requirement(&mut c, bound, sets[k][j], &map) {
                    return (0, u64[]);
                }
            }
        }
    }
    return (1, map);
}
// The inherent method `name` that a written-type impl gives a receiver of type `ty`, or 0. An impl
// whose owner is written concretely (`impl u64[]`) wins over a generic one (`impl<T> T[]`); two
// impls that both define the name for the receiver are ambiguous, as two interfaces would be.
fn inherent_method_for<a, b>(c: (&a mut C), ty: u64, name: &b [u8]) -> u64 {
    mut exact = 0;
    mut generic = 0;
    for i in c.inherent_types.len() {
        key := inherent_type_base() + i + 1;
        found := inherent_bindings(&mut c, key, ty);
        if found.0 == 0 {
            continue;
        }
        owner := inherent_type_module(key);
        m := find_func(&mut c, view(owner), view(name));
        if m == 0 {
            continue;
        }
        record := impl_record(&mut c, key);
        mut params = 0;
        if record != 0 {
            params = c.impl_params[record - 1].tnames.len();
        }
        if params == 0 {
            if exact != 0 {
                ambiguous_inherent_fail(&mut c, ty, view(name));
            }
            exact = m;
        } else {
            if generic != 0 {
                ambiguous_inherent_fail(&mut c, ty, view(name));
            }
            generic = m;
        }
    }
    if exact != 0 {
        return exact;
    }
    return generic;
}
// Why a written-type impl that defines `name` does not apply to a receiver of type `ty`: the first
// bound its parameters state that the receiver's type does not meet, as (message, help); both empty
// when no impl defines the name for that shape of type. `v.sort()` on a `P[]` is "`sort` needs
// `T: order::Ord`, and `P` does not implement it", not "`P[]` has no method `sort`".
fn inherent_unmet_bound<a, b>(c: (&a mut C), ty: u64, name: &b [u8]) -> (u8[], u8[]) {
    for i in c.inherent_types.len() {
        key := inherent_type_base() + i + 1;
        record := impl_record(&mut c, key);
        if record == 0 {
            continue;
        }
        count := c.impl_params[record - 1].tnames.len();
        mut map = u64[];
        for k in count {
            map.push(NO_TYPE);
        }
        pattern := c.inherent_types[i];
        if !inherent_pattern_fits(&mut c, pattern, ty, &mut map) {
            continue;
        }
        owner := inherent_type_module(key);
        m := find_func(&mut c, view(owner), view(name));
        if m == 0 {
            continue;
        }
        sets := copy_constraints(&c.impl_params[record - 1].interfaces);
        for k in count {
            bound := map[k];
            if (bound == NO_TYPE) || (k >= sets.len()) {
                continue;
            }
            for j in sets[k].len() {
                iface := sets[k][j];
                if meets_requirement(&mut c, bound, iface, &map) {
                    continue;
                }
                if CALLABLE_BOUND <= iface {
                    // A callable bound the receiver's closure does not meet: not this method.
                    continue;
                }
                tname := c.impl_params[record - 1].tnames[k].copy();
                mut iname = c.interfaces[iface - 1].module.copy();
                push_bytes(&mut iname, view("::"));
                push_bytes(&mut iname, view(c.interfaces[iface - 1].name));
                shown := source_type_name(&mut c, bound);
                mut msg = copy_bytes(view("`"));
                push_bytes(&mut msg, view(name));
                push_bytes(&mut msg, view("` needs `"));
                push_bytes(&mut msg, view(tname));
                push_bytes(&mut msg, view(": "));
                push_bytes(&mut msg, view(iname));
                push_bytes(&mut msg, view("`, and `"));
                push_bytes(&mut msg, view(shown));
                push_bytes(&mut msg, view("` does not implement it"));
                home := c.funcs[m - 1].home.copy();
                mut help = copy_bytes(view("`"));
                push_bytes(&mut help, view(name));
                push_bytes(&mut help, view("` is defined in `impl<"));
                for q in count {
                    if q != 0 {
                        push_bytes(&mut help, view(", "));
                    }
                    push_bytes(&mut help, view(c.impl_params[record - 1].tnames[q]));
                    if q < sets.len() {
                        for r in sets[q].len() {
                            if r == 0 {
                                push_bytes(&mut help, view(": "));
                            } else {
                                push_bytes(&mut help, view(" + "));
                            }
                            push_bytes(&mut help, view(c.interfaces[sets[q][r] - 1].module));
                            push_bytes(&mut help, view("::"));
                            push_bytes(&mut help, view(c.interfaces[sets[q][r] - 1].name));
                        }
                    }
                }
                push_bytes(&mut help, view("> "));
                tnames := copy_names(&c.impl_params[record - 1].tnames);
                push_bytes(&mut help, view(impl_pattern_name(&mut c, pattern, &tnames)));
                push_bytes(&mut help, view("` (module `"));
                push_bytes(&mut help, view(home));
                push_bytes(&mut help, view("`); implement `"));
                push_bytes(&mut help, view(iname));
                push_bytes(&mut help, view("` for `"));
                push_bytes(&mut help, view(shown));
                push_bytes(&mut help, view("` to call it"));
                return (msg, help);
            }
        }
    }
    return (u8[], u8[]);
}
// A written-type impl's owner as written: its parameters by name (`T[]`, `[T]`).
fn impl_pattern_name<a, b>(c: (&a mut C), ty: u64, tnames: (&b u8[][])) -> u8[] {
    k := ty_kind(&mut c, ty);
    if (k == 9) && (ty_arg(&mut c, ty) < tnames.len()) {
        return tnames[ty_arg(&mut c, ty)].copy();
    }
    if k == 6 {
        mut out = impl_pattern_name(&mut c, ty_arg(&mut c, ty), &tnames);
        push_bytes(&mut out, view("[]"));
        return out;
    }
    if k == 27 {
        mut out = copy_bytes(view("["));
        push_bytes(&mut out, view(impl_pattern_name(&mut c, ty_arg(&mut c, ty), &tnames)));
        out.push(93);
        return out;
    }
    return source_type_name(&mut c, ty);
}
fn ambiguous_inherent_fail<a, b>(c: (&a mut C), ty: u64, name: &b [u8]) -> unit {
    mut msg = copy_bytes(view("ambiguous method: two inherent impls define `"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("` for `"));
    push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
    push_bytes(&mut msg, view("`; keep one, or rename one of them"));
    fail(&mut c, view(msg));
    return ();
}
// Register (signature pass) or find (later passes) a written-type impl's record. The later passes
// re-parse the same header, so the key is looked up by the type: every pass must name the same
// module `.inherent_<key-1>`, and pick the same type arguments when a method is called.
fn inherent_type_key<a>(c: (&a mut C), ty: u64, pass: u64) -> u64 {
    k := ty_kind(&mut c, ty);
    // A scalar (`u64`, `u32`, `bool`, `char`, `f64`), a string, a byte vector, a vector of any
    // element, the byte view `[u8]`, and the slice `[T]`.
    if !(
        (k == 0)
            || (k == 3)
            || (k == 4)
            || (k == 5)
            || (k == 6)
            || (k == 18)
            || (k == 19)
            || (k == 21)
            || (k == 22)
            || (k == 27)
    ) {
        fail(
            &mut c,
            view(
                "an inherent impl's type must be a scalar, a string, a vector, a slice or a type this module declares; a reference, a `dyn` interface and a bare type parameter have no inherent methods"
            )
        );
    }
    // One key per impl header: two blocks that spell the same owner type and the same parameters
    // are one impl (Rust merges them), so their methods share a module and a duplicate name is the
    // existing conflict. `impl<T> T[]` and `impl<T: Ord> T[]` are two headers - the second only
    // serves receivers whose element satisfies the bound - so they keep two keys.
    for i in c.inherent_types.len() {
        key := inherent_type_base() + i + 1;
        if inherent_same_header(&mut c, key, ty) {
            return key;
        }
    }
    if pass == 2 {
        key := inherent_type_base() + c.inherent_types.len() + 1;
        c.inherent_types.push(ty);
        resolve_callable_bounds(&mut c);
        c
            .impl_params
            .push(
                ImplParams {
                    decl: key,
                    rnames: copy_names(&c.rnames),
                    tnames: copy_names(&c.tnames),
                    bounds: copy_numbers(&c.type_bounds),
                    interfaces: copy_constraints(&c.type_interfaces),
                    self_ty: ty,
                }
            );
        return key;
    }
    fail(&mut c, view("an inherent impl for this type was not registered"));
    return 0;
}
fn impl_has_for<a>(c: (&a mut C)) -> bool {
    mut i = c.pos;
    while (kind_at(&mut c, i) != 123) & (kind_at(&mut c, i) != 0) {
        t := tok_text(&mut c, i);
        if same(view(t), view("for")) {
            return true;
        }
        i += 1;
    }
    return false;
}
// The impl_params key of a generic interface implementation (implementation id, 1-based): above
// every declaration index, which is what an inherent impl's key is.
fn generic_impl_key(id: u64) -> u64 {
    return 1000000000 + id;
}
fn impl_record<a>(c: (&a mut C), owner: u64) -> u64 {
    for i in c.impl_params.len() {
        p := &c.impl_params[i];
        if p.decl == owner {
            return i + 1;
        }
    }
    return 0;
}
fn impl_self<a>(c: (&a mut C), owner: u64) -> u64 {
    r := impl_record(&mut c, owner);
    if r != 0 {
        p := &c.impl_params[r - 1];
        return p.self_ty;
    }
    // A non-generic interface implementation whose method has its own type parameters.
    if owner >= generic_impl_key(0) {
        return c.implementations[owner - generic_impl_key(0) - 1].ty;
    }
    return intern_args(&mut c, 8, owner - 1, 0, u64[], u64[]);
}
fn prepend_impl_params<a>(c: (&a mut C)) -> unit {
    mut owner = c.inherent;
    if (owner == 0) && (c.current_impl != 0) {
        owner = generic_impl_key(c.current_impl);
    }
    r := impl_record(&mut c, owner);
    if r == 0 {
        return ();
    }
    p := &c.impl_params[r - 1];
    mut rn = copy_names(&p.rnames);
    mut tn = copy_names(&p.tnames);
    mut bd = copy_numbers(&p.bounds);
    mut it = copy_constraints(&p.interfaces);
    own_r := copy_names(&c.rnames);
    for i in own_r.len() {
        x := &own_r[i];
        rn.push(x.copy());
    }
    own_t := copy_names(&c.tnames);
    for i in own_t.len() {
        x := &own_t[i];
        tn.push(x.copy());
    }
    // The function's own parameters now follow the implementation's.
    shift := tn.len() - own_t.len();
    for k in c.assoc_eqs.len() / 3 {
        // stays: the written place is indexed (`&mut c.assoc_eqs[3 * k]`), and two-phase defers
        // only a plain `&mut path`, so this read is part of taking the place.
        old := c.assoc_eqs[3 * k];
        exchange(&mut c.assoc_eqs[3 * k], old + shift);
    }
    own_b := copy_numbers(&c.type_bounds);
    for i in own_b.len() {
        bd.push(own_b[i]);
    }
    own_i := copy_constraints(&c.type_interfaces);
    for i in own_i.len() {
        it.push(copy_numbers(&own_i[i]));
    }
    exchange(&mut c.rnames, rn);
    exchange(&mut c.tnames, tn);
    exchange(&mut c.type_bounds, bd);
    exchange(&mut c.type_interfaces, it);
    return ();
}
fn implementation<a>(c: (&a mut C), pass: u64) -> unit {
    if c.raw != 0 {
        fail(&mut c, view("unsafe runtime cannot implement safe interfaces"));
    }
    impl_file := c.file;
    impl_pos := c.pos;
    expect(&mut c, view("impl"));
    // `impl Type { fn ... }`: an inherent impl, whose methods and associated functions are the
    // type's own. `impl Type { ... }` has no `for`, and that is the whole difference from the
    // interface implementation below (impl_has_for). The owner is either a type this module
    // declares - `impl<T> Stack<T>` - or a written type no module declares, `impl<T> T[]` and
    // `impl [u8]`, which is what inherent_type_key records.
    if !impl_has_for(&mut c) {
        if pass == 1 {
            while !is(&mut c, view("{")) {
                advance(&mut c);
            }
            skip_braces(&mut c);
            return ();
        }
        // impl<T> Stack<T> { ... }: the impl's parameters are prepended to every method's.
        exchange(&mut c.rnames, u8[][]);
        exchange(&mut c.tnames, u8[][]);
        exchange(&mut c.type_bounds, u64[]);
        exchange(&mut c.type_interfaces, u64[][]);
        if is(&mut c, view("<")) {
            lifetime_parameters(&mut c);
            // An impl's own bounds name only its own parameters: read them before its type is.
            resolve_callable_bounds(&mut c);
        }
        module := module_copy(&mut c);
        ty := parse_inherent_owner(&mut c);
        mut owner = 0;
        if ty_kind(&mut c, ty) == 8 {
            // A declared type: the owner is the declaration, and its arguments must be this impl's
            // own parameters, in order.
            owner = ty_arg(&mut c, ty) + 1;
            home := c.decls[owner - 1].module.copy();
            if !same(view(home), view(module)) {
                fail(&mut c, view("inherent impl needs a type of the same module"));
            }
            args := type_args(&mut c, ty);
            if args.len() != c.tnames.len() {
                fail(&mut c, view("impl type arguments must be its own parameters, in order"));
            }
            for i in args.len() {
                a := args[i];
                if (ty_kind(&mut c, a) != 9) || (ty_arg(&mut c, a) != i) {
                    fail(&mut c, view("impl type arguments must be its own parameters, in order"));
                }
            }
            if pass == 2 {
                resolve_callable_bounds(&mut c);
                c
                    .impl_params
                    .push(
                        ImplParams {
                            decl: owner,
                            rnames: copy_names(&c.rnames),
                            tnames: copy_names(&c.tnames),
                            bounds: copy_numbers(&c.type_bounds),
                            interfaces: copy_constraints(&c.type_interfaces),
                            self_ty: ty,
                        }
                    );
            }
        } else {
            owner = inherent_type_key(&mut c, ty, pass);
        }
        exchange(&mut c.inherent, owner);
        exchange(&mut c.self_type, ty);
        expect(&mut c, view("{"));
        while !eat(&mut c, view("}")) {
            // A method carries effect claims the way a function does: `@no_alloc pub fn find(..)`.
            while kind(&mut c) == 64 {
                if fx_attr_form(&mut c) == 0 {
                    fail(&mut c, view("a method in an impl block takes `@no_alloc` and `@no_panic` only"));
                }
            }
            public := u64(eat(&mut c, view("pub")));
            func(&mut c, pass, public);
        }
        exchange(&mut c.inherent, 0);
        exchange(&mut c.self_type, NO_TYPE);
        return ();
    }
    if pass == 1 {
        while !is(&mut c, view("{")) {
            if kind(&mut c) == 0 {
                fail(&mut c, view("unclosed implementation"));
            }
            advance(&mut c);
        }
        skip_braces(&mut c);
        return ();
    }
    exchange(&mut c.rnames, u8[][]);
    exchange(&mut c.tnames, u8[][]);
    exchange(&mut c.type_bounds, u64[]);
    exchange(&mut c.type_interfaces, u64[][]);
    // `impl<T: B> I for X<T>`: a generic implementation, its methods templates over T.
    if is(&mut c, view("<")) {
        lifetime_parameters(&mut c);
        resolve_callable_bounds(&mut c);
    }
    impl_rnames := copy_names(&c.rnames);
    impl_tnames := copy_names(&c.tnames);
    impl_bounds := copy_numbers(&c.type_bounds);
    resolve_callable_bounds(&mut c);
    impl_ifaces := copy_constraints(&c.type_interfaces);
    mut module = module_copy(&mut c);
    mut name = ident(&mut c);
    mut qualified = 0;
    if eat(&mut c, view("::")) {
        qualified = 1;
        module = name;
        name = ident(&mut c);
    }
    if qualified == 0 {
        imported := resolve_import(&mut c, view(name));
        if imported.len() != 0 {
            module = imported;
        }
    }
    mut contract = find_interface(&c, view(module), view(name));
    // `Drop` belongs to no module, so a bare `impl Drop for T` names it directly.
    if (contract == 0) & (qualified == 0) & same(view(name), view("Drop")) {
        contract = c.drop_iface;
    }
    interface_visible(&mut c, contract);
    if contract == 0 {
        fail(&mut c, view("unknown implemented interface"));
    }
    expect(&mut c, view("for"));
    ty := parse_type(&mut c);
    mut id = find_implementation(&mut c, contract, ty);
    if pass == 2 {
        if id != 0 {
            fail(&mut c, view("overlapping interface implementation"));
        }
        owner := module_copy(&mut c);
        item := &c.interfaces[contract - 1];
        mut permitted = u64(same(view(item.module), view(owner)));
        if ty_kind(&mut c, ty) == 8 {
            decl := ty_arg(&mut c, ty);
            d := &c.decls[decl];
            if same(view(d.module), view(owner)) {
                permitted = 1;
            }
        }
        if permitted == 0 {
            fail(&mut c, view("implementation must own the interface or nominal type"));
        }
        c
            .implementations
            .push(
                Implementation {
                    contract: contract,
                    ty: ty,
                    module: owner,
                    methods: u64[],
                    file: impl_file,
                    pos: impl_pos + 1,
                    assoc_names: u8[][],
                    assoc_types: u64[],
                }
            );
        id = c.implementations.len();
        if contract == c.drop_iface {
            drop_impl_registered(&mut c, ty);
        }
        if impl_tnames.len() != 0 {
            c
                .impl_params
                .push(
                    ImplParams {
                        decl: generic_impl_key(id),
                        rnames: copy_names(&impl_rnames),
                        tnames: copy_names(&impl_tnames),
                        bounds: copy_numbers(&impl_bounds),
                        interfaces: copy_constraints(&impl_ifaces),
                        self_ty: ty,
                    }
                );
        }
    }
    if id == 0 {
        fail(&mut c, view("implementation header missing"));
    }
    exchange(&mut c.current_impl, id);
    exchange(&mut c.self_type, ty);
    expect(&mut c, view("{"));
    while !eat(&mut c, view("}")) {
        // `type Item = u64;`: an associated type, before the methods that name it.
        if eat(&mut c, view("type")) {
            assoc_name := ident(&mut c);
            expect(&mut c, view("="));
            assoc_ty := parse_type(&mut c);
            expect(&mut c, view(";"));
            if pass == 2 {
                existing := copy_names(&c.implementations[id - 1].assoc_names);
                for k in existing.len() {
                    if same(view(existing[k]), view(assoc_name)) {
                        fail(&mut c, view("duplicate associated type"));
                    }
                }
                item := &mut c.implementations[id - 1];
                item.assoc_names.push(assoc_name);
                item.assoc_types.push(assoc_ty);
            }
            continue;
        }
        before := c.funcs.len();
        // func prepends the implementation's own parameters (prepend_impl_params).
        func(&mut c, pass, 0);
        if pass == 2 {
            item := &mut c.implementations[id - 1];
            item.methods.push(before);
        }
    }
    exchange(&mut c.current_impl, 0);
    exchange(&mut c.self_type, NO_TYPE);
    return ();
}
fn bound_signature<a, b>(c: (&a mut C), index: u64, arguments: (&b u64[])) -> u64 {
    f := &c.funcs[index];
    first := f.first;
    count := f.count;
    ret := f.ret;
    mut params = u64[];
    for i in count {
        bound := bind_types(&mut c, c.params[first + i], &arguments);
        params.push(bound);
    }
    result := bind_types(&mut c, ret, &arguments);
    return intern_args(&mut c, 12, result, 0, u64[], params);
}
fn resolve_interface_method<a, b>(c: (&a mut C), contract: u64, ty: u64, name: &b [u8]) -> u64 {
    implementation := find_implementation(&mut c, contract, ty);
    if implementation == 0 {
        fail(&mut c, view("missing interface implementation"));
    }
    item := &c.implementations[implementation - 1];
    methods := copy_numbers(&item.methods);
    for i in methods.len() {
        index := methods[i];
        f := &c.funcs[index];
        if same(view(f.name), view(name)) {
            return index;
        }
    }
    fail(&mut c, view("missing interface method"));
    return 0;
}
fn check_interfaces<a>(c: (&a mut C)) -> unit {
    for i in c.dyn_ifaces.len() {
        id := c.dyn_ifaces[i];
        if c.interfaces[id - 1].defined != 0 {
            check_object_safety(&mut c, id);
        }
    }
    for i in c.interfaces.len() {
        item := &c.interfaces[i];
        defined := item.defined;
        module := item.module.copy();
        name := item.name.copy();
        if defined == 0 {
            fail(&mut c, view("unknown interface in generic bound"));
        }
        // A census of the module's names, not a reference to one: `find_decl` would report that a
        // private nominal type is not visible from whichever module happened to be parsed last, which
        // is not what this rule is about (`interface Same {} struct Same {}` in one module is the
        // conflict, wherever the file sits in the program).
        if find_decl_internal(&mut c, view(module), view(name)) != 0 {
            fail(&mut c, view("interface and nominal type names conflict"));
        }
    }
    for i in c.implementations.len() {
        item := &c.implementations[i];
        contract := item.contract;
        ty := item.ty;
        methods := copy_numbers(&item.methods);
        impl_file := item.file;
        impl_pos := item.pos;
        interface := &c.interfaces[contract - 1];
        expected := copy_numbers(&interface.methods);
        // Every associated type the interface declares, and only those.
        assoc := copy_names(&interface.assoc);
        given := copy_names(&item.assoc_names);
        for g in given.len() {
            mut known = false;
            for a in assoc.len() {
                if same(view(assoc[a]), view(given[g])) {
                    known = true;
                }
            }
            if !known {
                mut message = u8[];
                push_bytes(&mut message, view("associated type `"));
                push_bytes(&mut message, view(given[g]));
                push_bytes(&mut message, view("` is not a member of the interface"));
                if impl_pos != 0 {
                    load_file(&mut c, impl_file);
                    exchange(&mut c.file, impl_file);
                    exchange(&mut c.pos, impl_pos - 1);
                }
                fail(&mut c, view(message));
            }
        }
        if impl_pos != 0 {
            for a in assoc.len() {
                mut present = false;
                for g in given.len() {
                    if same(view(assoc[a]), view(given[g])) {
                        present = true;
                    }
                }
                if !present {
                    mut message = u8[];
                    push_bytes(&mut message, view("missing associated type `"));
                    push_bytes(&mut message, view(assoc[a]));
                    push_bytes(&mut message, view("` (write: type "));
                    push_bytes(&mut message, view(assoc[a]));
                    push_bytes(&mut message, view(" = ...;)"));
                    load_file(&mut c, impl_file);
                    exchange(&mut c.file, impl_file);
                    exchange(&mut c.pos, impl_pos - 1);
                    fail(&mut c, view(message));
                }
            }
        }
        // Implementing `B: A` requires an implementation of A for the same type.
        if impl_pos != 0 {
            supers := all_supers(&mut c, contract);
            ity := c.implementations[i].ty;
            for s in supers.len() {
                if !satisfies_interface(&mut c, ity, supers[s]) {
                    mut message = u8[];
                    push_bytes(&mut message, view("implementing `"));
                    push_bytes(&mut message, view(c.interfaces[contract - 1].name));
                    push_bytes(&mut message, view("` requires implementing `"));
                    push_bytes(&mut message, view(c.interfaces[supers[s] - 1].name));
                    push_bytes(&mut message, view("` for the same type"));
                    load_file(&mut c, impl_file);
                    exchange(&mut c.file, impl_file);
                    exchange(&mut c.pos, impl_pos - 1);
                    fail(&mut c, view(message));
                }
            }
        }
        // Each associated type the implementation gives meets the interface's bounds on it.
        if impl_pos != 0 {
            for a in assoc.len() {
                mut bounds = u64[];
                if a < c.interfaces[contract - 1].assoc_bounds.len() {
                    bounds = copy_numbers(&c.interfaces[contract - 1].assoc_bounds[a]);
                }
                for g in given.len() {
                    if same(view(assoc[a]), view(given[g])) {
                        gty := c.implementations[i].assoc_types[g];
                        for b in bounds.len() {
                            if !satisfies_interface(&mut c, gty, bounds[b]) {
                                mut message = u8[];
                                push_bytes(&mut message, view("associated type `"));
                                push_bytes(&mut message, view(assoc[a]));
                                push_bytes(&mut message, view("` does not implement `"));
                                push_bytes(&mut message, view(c.interfaces[bounds[b] - 1].name));
                                push_bytes(&mut message, view("`, which the interface requires"));
                                load_file(&mut c, impl_file);
                                exchange(&mut c.file, impl_file);
                                exchange(&mut c.pos, impl_pos - 1);
                                fail(&mut c, view(message));
                            }
                        }
                    }
                }
            }
        }
        // A method the interface does not declare is reported where it is written; a required one
        // that is missing, at the `impl`.
        for j in methods.len() {
            g := &c.funcs[methods[j]];
            mut known = false;
            for e in expected.len() {
                if same(view(c.funcs[expected[e]].name), view(g.name)) {
                    known = true;
                }
            }
            if !known {
                file := g.file;
                pos := g.pos;
                mut message = u8[];
                push_bytes(&mut message, view("method `"));
                push_bytes(&mut message, view(g.name));
                push_bytes(&mut message, view("` is not a member of the interface"));
                load_file(&mut c, file);
                exchange(&mut c.file, file);
                exchange(&mut c.pos, pos);
                fail(&mut c, view(message));
            }
        }
        for e in expected.len() {
            name := c.funcs[expected[e]].name.copy();
            mut present = false;
            for j in methods.len() {
                if same(view(c.funcs[methods[j]].name), view(name)) {
                    present = true;
                }
            }
            if !present {
                mut message = u8[];
                push_bytes(&mut message, view("missing interface method `"));
                push_bytes(&mut message, view(name));
                push_bytes(&mut message, view("` (it has no default body)"));
                if impl_pos != 0 {
                    load_file(&mut c, impl_file);
                    exchange(&mut c.file, impl_file);
                    exchange(&mut c.pos, impl_pos - 1);
                }
                fail(&mut c, view(message));
            }
        }
        for j in expected.len() {
            abstract := expected[j];
            f := &c.funcs[abstract];
            name := f.name.copy();
            actual := resolve_interface_method(&mut c, contract, ty, view(name));
            mut arguments = u64[ty];
            mut own = impl_param_types(&mut c, i + 1);
            // The method's own type parameters, matched by position on both sides.
            abstract_own := c.funcs[abstract].types - 1;
            actual_own := c.funcs[actual].types - own.len();
            if abstract_own != actual_own {
                g := &c.funcs[actual];
                file := g.file;
                pos := g.pos;
                load_file(&mut c, file);
                exchange(&mut c.file, file);
                exchange(&mut c.pos, pos);
                fail(&mut c, view("method type parameters do not match the interface"));
            }
            for k in abstract_own {
                marker := intern_args(&mut c, 9, 1000 + k, 0, u64[], u64[]);
                arguments.push(marker);
                own.push(marker);
            }
            signature := bound_signature(&mut c, abstract, &arguments);
            concrete := bound_signature(&mut c, actual, &own);
            if same_type(&mut c, concrete, signature) == 0 {
                // Report at the implementing method, not wherever parsing ended.
                g := &c.funcs[actual];
                file := g.file;
                pos := g.pos;
                load_file(&mut c, file);
                exchange(&mut c.file, file);
                exchange(&mut c.pos, pos);
                fail(&mut c, view("method signature does not match the interface"));
            }
        }
    }
    return ();
}
fn interface_call<a, b>(c: (&a mut C), contract: u64, name: &b [u8]) -> Val {
    module := private_module(view(".interface_"), contract);
    return call(&mut c, view(module), view(name));
}
// const NAME: T = literal; (integers, bool, text). Uses inline the value.
// ---- compile-time constant expressions (docs/design/comptime.md, stage C1) ----
// A folded value: an integer (ty 0, unsigned 64-bit arithmetic, overflow is an error), a bool
// (bool_type), or a target tag such as `.windows` (ct_tag_ty). The folder reads tokens and emits no
// code; it is what `@if`, `@assert`, `@expr` and the right-hand side of a constant evaluate.
struct CVal {
    value: u64,
    ty: u64
}
fn ct_tag_ty() -> u64 {
    return CT_TAG;
}
// A tag's type is a sentinel, not an index into the type table, so it is never handed to is_bool.
fn ct_is_bool<a>(c: (&a mut C), ty: u64) -> bool {
    if ty == ct_tag_ty() {
        return false;
    }
    return is_bool(&mut c, ty);
}
fn ct_val(value: u64, ty: u64) -> CVal {
    return CVal { value: value, ty: ty };
}
// A value parameter in scope named `name`: index + 1, or 0.
fn value_param<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    // type_bounds can be shorter than tnames (closures carry their parent's names), and `&` does
    // not short-circuit, so the bound is read only once the index is known to be in range.
    for i in c.tnames.len() {
        if (i < c.type_bounds.len()) && same(view(c.tnames[i]), name) {
            if (c.type_bounds[i] & 4) != 0 {
                return i + 1;
            }
        }
    }
    return 0;
}
// A value parameter's value in the specialisation being compiled, and its declared type. Unbound
// (a template checked before any instantiation) it reads as 0 and sets ct_unbound, which makes an
// @assert that depends on it wait for the instantiation instead of judging a placeholder.
fn value_param_value<a>(c: (&a mut C), i: u64) -> CVal {
    vty := c.type_bounds[i] / 8;
    mut value = 0;
    if i < c.bindings.len() {
        mut b = c.bindings[i];
        // A binding may arrive behind an indirection (kind 10), as canonical_type also unwraps.
        while (b != 0) && (b != NO_TYPE) && (ty_kind(&mut c, b) == 10) {
            b = ty_arg(&mut c, b);
        }
        if (b != 0) && (b != NO_TYPE) && (ty_kind(&mut c, b) == 31) {
            value = ty_arg(&mut c, b);
        } else {
            exchange(&mut c.ct_unbound, 1);
        }
    } else {
        exchange(&mut c.ct_unbound, 1);
    }
    if is_bool(&mut c, vty) {
        return ct_val(value, bool_type(&mut c));
    }
    return ct_val(value, 0);
}
// The tags `target.os` and `target.arch` compare against.
fn ct_tag<a>(c: (&a mut C), name: &a [u8]) -> u64 {
    if same(view(name), view("linux")) { return 1; }
    if same(view(name), view("windows")) { return 2; }
    if same(view(name), view("macos")) { return 3; }
    if same(view(name), view("x86_64")) { return 11; }
    if same(view(name), view("aarch64")) { return 12; }
    if same(view(name), view("riscv64")) { return 13; }
    fail(&mut c, view("unknown target tag: expected .linux, .windows, .macos, .x86_64, .aarch64 or .riscv64"));
    return 0;
}
fn ct_bool<a>(c: (&a mut C), v: CVal, what: &a [u8]) -> u64 {
    if !ct_is_bool(&mut c, v.ty) {
        fail(&mut c, view(what));
    }
    return v.value;
}
fn ct_int<a>(c: (&a mut C), v: CVal) -> u64 {
    if (v.ty == ct_tag_ty()) || ct_is_bool(&mut c, v.ty) {
        fail(&mut c, view("this compile-time operator needs integers"));
    }
    return v.value;
}
// size_of / align_of: defined where the size is a fact of the target - scalars, bool, handles and
// C pointers, and extern "C" records (their C layout). A Grail record or vector is a managed
// object whose layout the language does not promise, so it is refused rather than given a number.
fn ct_layout<a>(c: (&a mut C), align: u64) -> u64 {
    expect(&mut c, view("("));
    ty := parse_type(&mut c);
    expect(&mut c, view(")"));
    if ct_is_bool(&mut c, ty) {
        return 1;
    }
    k := ty_kind(&mut c, ty);
    if (is_c_record(&mut c, ty) != 0) & (c.ct_pass != 0) & (c.ct_pass < 3) & c.ct_in_if {
        // A module-level @if decides which declarations exist, so it is decided in every pass,
        // before record layouts are complete: it can test scalars and target, not a record.
        fail(&mut c, view("a module-level @if cannot depend on the layout of a record; test it with @assert, or inside a function"));
    }
    if (ty == 0) || (k == 18) || (k == 21) || (k == 23) || (k == 24) || (k == 26) || (is_c_record(&mut c, ty) != 0) {
        if align != 0 {
            return ffi_field_align(&mut c, ty);
        }
        return ffi_field_size(&mut c, ty);
    }
    fail(&mut c, view("size_of and align_of take a scalar, a handle or C pointer, or an extern \"C\" record: a Grail record or vector has no layout the language promises"));
    return 0;
}
fn ct_primary<a>(c: (&a mut C)) -> CVal {
    here := c.pos;
    k := kind(&mut c);
    bt := bool_type(&mut c);
    if k == 2 {
        t := tok_text(&mut c, here);
        v := literal_value(&mut c, view(t));
        advance(&mut c);
        return ct_val(v, 0);
    }
    if is(&mut c, view("true")) || is(&mut c, view("false")) {
        v := u64(is(&mut c, view("true")));
        advance(&mut c);
        return ct_val(v, bt);
    }
    if eat(&mut c, view("(")) {
        v := ct_expr(&mut c, 0);
        expect(&mut c, view(")"));
        return v;
    }
    if eat(&mut c, view("!")) {
        v := ct_primary(&mut c);
        b := ct_bool(&mut c, v, view("! needs a bool"));
        return ct_val(1 - b, bt);
    }
    if eat(&mut c, view(".")) {
        name := ident(&mut c);
        return ct_val(ct_tag(&mut c, view(name)), ct_tag_ty());
    }
    if k == 1 {
        if is(&mut c, view("size_of")) || is(&mut c, view("align_of")) {
            align := u64(is(&mut c, view("align_of")));
            advance(&mut c);
            return ct_val(ct_layout(&mut c, align), 0);
        }
        if is(&mut c, view("target")) & (next_kind(&mut c) == 46) {
            advance(&mut c);
            advance(&mut c);
            field := ident(&mut c);
            arch := c.target;
            if same(view(field), view("os")) {
                mut os = 1;
                if (arch == 3) || (arch == 4) {
                    os = 2;
                }
                if c.plat == 1 {
                    os = 3;
                }
                return ct_val(os, ct_tag_ty());
            }
            if same(view(field), view("arch")) {
                mut a = 11;
                if (arch == 1) || (arch == 4) {
                    a = 12;
                }
                if arch == 2 {
                    a = 13;
                }
                return ct_val(a, ct_tag_ty());
            }
            if same(view(field), view("pointer_bits")) {
                return ct_val(64, 0);
            }
            fail(&mut c, view("target has os, arch and pointer_bits"));
        }
        after := c.pos + 1;
        here_tok := c.pos;
        if !is_at(&mut c, after, view("::")) {
            name_text := tok_text(&mut c, here_tok);
            vp := value_param(&mut c, view(name_text));
            if vp != 0 {
                advance(&mut c);
                return value_param_value(&mut c, vp - 1);
            }
        }
        if (c.ct_loop_names.len() != 0) & is_at(&mut c, c.pos + 1, view(".")) {
            loop_name := tok_text(&mut c, c.pos);
            b := ct_loop_binding(&mut c, view(loop_name));
            if b != 0 {
                advance(&mut c);
                advance(&mut c);
                what := ident(&mut c);
                if !same(view(what), view("index")) {
                    fail(&mut c, view("in a compile-time condition a field from @for has .index"));
                }
                return ct_val(c.ct_loop_index[b - 1], 0);
            }
        }
        if ct_call_ahead(&mut c) {
            text := ct_take_call_text(&mut c);
            here_module := module_copy(&mut c);
            r := run_tier(&mut c, view(here_module), view(text), view(""));
            if (r.ty == 3) || ((r.ty != 0) && (ct_seq_elem(&mut c, r.ty) != NO_TYPE)) || static_structured(&mut c, r.ty) {
                fail(&mut c, view("a compile-time call in an expression must give an integer or a bool; bind a string or a table with NAME := f();"));
            }
            return ct_val(r.value, r.ty);
        }
        mut module = module_copy(&mut c);
        mut name = ident(&mut c);
        if eat(&mut c, view("::")) {
            module = name;
            name = ident(&mut c);
        }
        resolve_pending_named(&mut c, view(module), view(name));
        for i in c.constants.len() {
            q := &c.constants[i];
            if same(view(q.module), view(module)) & same(view(q.name), view(name)) {
                ty := q.ty;
                value := q.value;
                if (ty == 3) || is_float(&mut c, ty) {
                    exchange(&mut c.pos, here);
                    fail(&mut c, view("only integer and bool constants can be used in a compile-time expression"));
                }
                if ct_is_bool(&mut c, ty) {
                    return ct_val(value, bt);
                }
                return ct_val(value, 0);
            }
        }
        exchange(&mut c.pos, here);
        fail(&mut c, view("not a compile-time constant: a compile-time expression may use literals, constants, size_of, align_of and target"));
    }
    fail(&mut c, view("expected a compile-time constant expression"));
    return ct_val(0, 0);
}
fn ct_expr<a>(c: (&a mut C), min: u64) -> CVal {
    mut left = ct_primary(&mut c);
    bt := bool_type(&mut c);
    while true {
        k := kind(&mut c);
        p := prec(k);
        if (p == 0) || (p <= min) {
            break;
        }
        advance(&mut c);
        right := ct_expr(&mut c, p);
        if (k == 274) || (k == 273) {
            a := ct_bool(&mut c, left, view("|| and && need bools"));
            b := ct_bool(&mut c, right, view("|| and && need bools"));
            if k == 274 {
                left = ct_val(u64((a != 0) || (b != 0)), bt);
            } else {
                left = ct_val(u64((a != 0) && (b != 0)), bt);
            }
            continue;
        }
        if is_comparison(k) {
            if (left.ty == ct_tag_ty()) != (right.ty == ct_tag_ty()) {
                fail(&mut c, view("a target tag compares only with another tag"));
            }
            if ct_is_bool(&mut c, left.ty) != ct_is_bool(&mut c, right.ty) {
                fail(&mut c, view("a compile-time comparison needs two values of the same kind"));
            }
            a := left.value;
            b := right.value;
            mut r = false;
            if k == 258 { r = a == b; }
            if k == 259 { r = a != b; }
            if (left.ty == ct_tag_ty()) & (k != 258) & (k != 259) {
                fail(&mut c, view("target tags support only == and !="));
            }
            if k == 60 { r = a < b; }
            if k == 62 { r = a > b; }
            if k == 269 { r = a <= b; }
            if k == 270 { r = a >= b; }
            left = ct_val(u64(r), bt);
            continue;
        }
        if ((k == 38) || (k == 124)) & ct_is_bool(&mut c, left.ty) {
            a := ct_bool(&mut c, left, view("& and | on a bool need two bools"));
            b := ct_bool(&mut c, right, view("& and | on a bool need two bools"));
            if k == 38 {
                left = ct_val(a & b, bt);
            } else {
                left = ct_val(a | b, bt);
            }
            continue;
        }
        a := ct_int(&mut c, left);
        b := ct_int(&mut c, right);
        mut r: u64 = 0;
        if k == 38 { r = a & b; }
        if k == 124 { r = a | b; }
        if k == 94 { r = a ^ b; }
        if (k == 271) || (k == 272) {
            if 63 < b {
                fail(&mut c, view("compile-time shift amount must be below 64"));
            }
            if k == 271 {
                r = a << b;
                if (r >> b) != a {
                    fail(&mut c, view("compile-time integer overflow"));
                }
            } else {
                r = a >> b;
            }
        }
        if k == 43 {
            r = wrapping_add(a, b);
            if r < a {
                fail(&mut c, view("compile-time integer overflow"));
            }
        }
        if k == 45 {
            if b > a {
                fail(&mut c, view("compile-time integer underflow: constants are unsigned"));
            }
            r = a - b;
        }
        if k == 42 {
            if (a != 0) & (b > 18446744073709551615 / a) {
                fail(&mut c, view("compile-time integer overflow"));
            }
            r = a * b;
        }
        if (k == 47) || (k == 37) {
            if b == 0 {
                fail(&mut c, view("compile-time division by zero"));
            }
            if k == 47 {
                r = a / b;
            } else {
                r = a % b;
            }
        }
        if k == 267 {
            r = 1;
            for i in b {
                if (a != 0) & (r > 18446744073709551615 / a) {
                    fail(&mut c, view("compile-time integer overflow"));
                }
                r = r * a;
            }
        }
        left = ct_val(r, 0);
    }
    return left;
}
// `@if cond { ... } else @if cond { ... } else { ... }`: the branch whose condition holds is
// compiled; the others are skipped token for token - parsed only far enough to find their braces,
// never type-checked or emitted - so they may name declarations that exist only on another target.
// `top` selects declarations (module level) or statements (inside a function).
fn ct_if<a>(c: (&a mut C), pass: u64, top: u64) -> unit {
    expect(&mut c, view("if"));
    mut done = 0;
    while true {
        cond := ct_expr(&mut c, 0);
        take := ct_bool(&mut c, cond, view("@if needs a bool condition"));
        ct_branch(&mut c, pass, top, u64((take != 0) & (done == 0)));
        if take != 0 {
            done = 1;
        }
        if !eat(&mut c, view("else")) {
            return ();
        }
        if (kind(&mut c) == 64) & is_at(&mut c, c.pos + 1, view("if")) {
            advance(&mut c);
            advance(&mut c);
            continue;
        }
        ct_branch(&mut c, pass, top, u64(done == 0));
        return ();
    }
    return ();
}
fn ct_branch<a>(c: (&a mut C), pass: u64, top: u64, take: u64) -> unit {
    open := c.pos;
    if !is(&mut c, view("{")) {
        fail(&mut c, view("expected { after the @if condition"));
    }
    close := block_end(&mut c, open);
    if take == 0 {
        exchange(&mut c.pos, close + 1);
        return ();
    }
    if top == 0 {
        block(&mut c);
        return ();
    }
    advance(&mut c);
    while c.pos < close {
        toplevel_item(&mut c, pass);
    }
    expect(&mut c, view("}"));
    return ();
}
// `@assert(cond, "message")`: a compile error carrying the message when cond is false.
fn ct_assert<a>(c: (&a mut C)) -> unit {
    if c.probe_mode != 0 {
        // The program's own compile checks its assertions; a probe only computes a value.
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        advance(&mut c);
        return ();
    }
    at := c.pos;
    exchange(&mut c.ct_unbound, 0);
    expect(&mut c, view("assert"));
    expect(&mut c, view("("));
    cond := ct_expr(&mut c, 0);
    holds := ct_bool(&mut c, cond, view("@assert needs a bool condition"));
    expect(&mut c, view(","));
    if kind(&mut c) != 3 {
        fail(&mut c, view("@assert needs a message: @assert(condition, \"why it must hold\")"));
    }
    text := decode_literal(&mut c, c.pos);
    advance(&mut c);
    expect(&mut c, view(")"));
    expect(&mut c, view(";"));
    unbound := exchange(&mut c.ct_unbound, 0);
    if (holds == 0) & (unbound == 0) {
        exchange(&mut c.pos, at - 1);
        mut msg = u8[];
        push_bytes(&mut msg, view("@assert failed: "));
        push_bytes(&mut msg, view(text));
        fail(&mut c, view(msg));
    }
    return ();
}
// `@` at the start of a statement or a module item.
fn ct_form<a>(c: (&a mut C), pass: u64, top: u64) -> unit {
    advance(&mut c);
    mut level = 0;
    if top != 0 {
        level = pass;
    }
    old_pass := exchange(&mut c.ct_pass, level);
    if is(&mut c, view("if")) {
        old_in_if := exchange(&mut c.ct_in_if, true);
        ct_if(&mut c, pass, top);
        exchange(&mut c.ct_in_if, old_in_if);
        exchange(&mut c.ct_pass, old_pass);
        return ();
    }
    if is(&mut c, view("assert")) {
        if (top != 0) & (pass != 3) {
            // A module-level assertion is checked once, in the last pass, when every declaration
            // and record layout it can name is complete; earlier passes only step over it.
            while !is(&mut c, view(";")) {
                advance(&mut c);
            }
            advance(&mut c);
            return ();
        }
        ct_assert(&mut c);
        exchange(&mut c.ct_pass, old_pass);
        return ();
    }
    if is(&mut c, view("for")) {
        if top != 0 {
            fail(&mut c, view("@for is a statement: it unrolls a block inside a function"));
        }
        ct_for(&mut c);
        exchange(&mut c.ct_pass, old_pass);
        return ();
    }
    fail(&mut c, view("unknown compile-time form: expected @if, @assert or @for here"));
    return ();
}
// ---- the run tier (docs/design/comptime.md, C3) -------------------------------------------------
// A compile-time form that calls a function is evaluated by running it: the compiler writes a probe
// program whose `main` prints the call's value, compiles it together with this program's own
// files (so the call is this program's code, compiled by this compiler), links and runs it with
// every ambient effect refused, and reads the value back. Results are cached by the digest of the
// probe and every input file, so an unchanged program never runs a probe twice.
struct CTRes {
    ty: u64,
    value: u64,
    text: u8[]
}
// True when the next tokens are a call `name(` or `module::name(`, not one of the constant-tier
// builtins.
fn ct_call_ahead<a>(c: (&a mut C)) -> bool {
    if kind(&mut c) != 1 {
        return false;
    }
    here := c.pos;
    first := tok_text(&mut c, here);
    if same(view(first), view("size_of")) || same(view(first), view("align_of")) || same(view(first), view("target")) {
        return false;
    }
    mut at = here + 1;
    if kind_at(&mut c, at) == 260 {
        at = at + 2;
    }
    return kind_at(&mut c, at) == 40;
}
// The source text of the call starting here, through its closing parenthesis; the tokens are
// consumed.
fn ct_take_call_text<a>(c: (&a mut C)) -> u8[] {
    first := c.pos;
    while kind(&mut c) != 40 {
        advance(&mut c);
    }
    mut depth = 0;
    mut last = c.pos;
    while true {
        k := kind(&mut c);
        if k == 40 {
            depth += 1;
        }
        if k == 41 {
            depth -= 1;
            if depth == 0 {
                last = c.pos;
                advance(&mut c);
                break;
            }
        }
        if k == 0 {
            fail(&mut c, view("unterminated compile-time call"));
        }
        advance(&mut c);
    }
    start := c.toks[first].start;
    end := c.toks[last].end;
    mut out = u8[];
    for i in start..end {
        out.push(c.src[i]);
    }
    return out;
}
// Module constants whose value is a call are evaluated on first use.
fn resolve_pending_named<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> unit {
    for i in c.constants.len() {
        if (c.constants[i].ty == CT_PENDING) && same(view(c.constants[i].module), module) && same(view(c.constants[i].name), name) {
            resolve_pending(&mut c, i);
        }
    }
    return ();
}
fn resolve_pending<a>(c: (&a mut C), i: u64) -> unit {
    m := c.constants[i].module.copy();
    n := c.constants[i].name.copy();
    text := c.constants[i].text.copy();
    mut key = m.copy();
    push_bytes(&mut key, view("::"));
    push_bytes(&mut key, view(n));
    pending := host::env(view("GRAIL_COMPTIME_PENDING"));
    if ct_list_has(view(pending), view(key)) {
        mut msg = copy_bytes(view("constant `"));
        push_bytes(&mut msg, view(n));
        push_bytes(&mut msg, view("` depends on itself through a compile-time call"));
        fail(&mut c, view(msg));
    }
    r := run_tier(&mut c, view(m), view(text), view(key));
    if static_structured(&mut c, r.ty) {
        mut msg = copy_bytes(view("`"));
        push_bytes(&mut msg, view(n));
        push_bytes(&mut msg, view("` would be a record or a table of them, which a constant cannot hold: a constant is pasted into every use, a static is one object - write `static "));
        push_bytes(&mut msg, view(n));
        push_bytes(&mut msg, view(": T = @"));
        push_bytes(&mut msg, view(text));
        push_bytes(&mut msg, view(";`"));
        fail(&mut c, view(msg));
    }
    exchange(&mut c.constants[i].ty, r.ty);
    exchange(&mut c.constants[i].value, r.value);
    exchange(&mut c.constants[i].text, r.text);
    return ();
}
// Every constant still pending at the end of a compile is evaluated, so its errors are reported and
// an interface records its value. A probe compile evaluates only what it uses.
fn resolve_all_pending<a>(c: (&a mut C)) -> unit {
    if c.probe_mode != 0 {
        return ();
    }
    for i in c.constants.len() {
        if c.constants[i].ty == CT_PENDING {
            // Nothing reads this constant, so the parse has moved on to whichever file came last; a
            // refusal of its call belongs at the binding, not there.
            file := c.constants[i].file;
            saved_file := c.file;
            saved_pos := c.pos;
            if (file != 0) & (file != saved_file) {
                load_file(&mut c, file);
                exchange(&mut c.file, file);
            }
            if file != 0 {
                exchange(&mut c.pos, c.constants[i].at);
            }
            resolve_pending(&mut c, i);
            if (file != 0) & (file != saved_file) {
                load_file(&mut c, saved_file);
                exchange(&mut c.file, saved_file);
            }
            exchange(&mut c.pos, saved_pos);
        }
    }
    return ();
}
// The type a pending constant will have: its call's result type.
fn ct_pending_type<a>(c: (&a mut C), i: u64) -> u64 {
    text := c.constants[i].text.copy();
    m := c.constants[i].module.copy();
    toks := lexer::tokenize(view(text));
    if toks.len() == 0 {
        return NO_TYPE;
    }
    mut fmod = m.copy();
    mut fname = slice_bytes(view(text), toks[0].start, toks[0].end);
    if (toks.len() > 2) && (toks[1].kind == 260) {
        fmod = fname.copy();
        fname = slice_bytes(view(text), toks[2].start, toks[2].end);
    }
    f := ct_module_names(&mut c, view(fmod), view(fname));
    if f == 0 {
        // No such function: the constant's type is unknown, not u64 (id 0 is u64, so returning 0
        // here typed an unresolvable constant as an integer).
        return NO_TYPE;
    }
    ret := c.funcs[f - 1].ret;
    if is_bool(&mut c, ret) || (ret == 3) || (ct_seq_elem(&mut c, ret) != NO_TYPE) || integer(&mut c, ret) || static_structured(&mut c, ret) {
        return ret;
    }
    return 0;
}
// The element type of a vector of integers (bytes count as u8), or the "none" word.
fn ct_seq_elem<a>(c: (&a mut C), ty: u64) -> u64 {
    // A sentinel is not a type to look inside: asking about one is answered "not a sequence", which
    // is what the caller's NO_TYPE test then reads.
    if !is_type_id(ty) {
        return NO_TYPE;
    }
    if ty == 2 {
        return int_type(&mut c, 8, 0);
    }
    if (ty != 0) && (ty != 3) && (ty_kind(&mut c, ty) == 6) {
        elem := ty_arg(&mut c, ty);
        if integer(&mut c, elem) && !is_bool(&mut c, elem) {
            return elem;
        }
    }
    return NO_TYPE;
}
fn ct_list_has<a, b>(list: &a [u8], item: &b [u8]) -> bool {
    mut start = 0;
    mut i = 0;
    while i <= list.len() {
        if (i == list.len()) || (list[i] == 44) {
            if i - start == item.len() {
                mut hit = true;
                for j in item.len() {
                    if list[start + j] != item[j] {
                        hit = false;
                    }
                }
                if hit {
                    return true;
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return false;
}
// A function or constant of `module` named `name` (no visibility check: the probe's own lookup).
fn ct_module_names<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> u64 {
    for i in c.funcs.len() {
        if same(view(c.funcs[i].module), module) && same(view(c.funcs[i].name), name) {
            return i + 1;
        }
    }
    return 0;
}
fn ct_shell_quote<a>(text: &a [u8]) -> u8[] {
    mut out = copy_bytes(view("'"));
    for i in text.len() {
        if text[i] == 39 {
            push_bytes(&mut out, view("'\\''"));
        } else {
            out.push(text[i]);
        }
    }
    out.push(39);
    return out;
}
// `text` (a call) with `module`'s own names qualified, so the probe module can say it.
fn ct_qualify<a, b>(c: (&a mut C), module: &b [u8], text: &b [u8]) -> u8[] {
    toks := lexer::tokenize(text);
    mut qualified = u8[];
    mut last_end = 0;
    for i in toks.len() {
        tstart := toks[i].start;
        tend := toks[i].end;
        tkind := toks[i].kind;
        for j in last_end..tstart {
            qualified.push(text[j]);
        }
        word := slice_bytes(text, tstart, tend);
        prev_scope := (i >= 1) && (toks[i - 1].kind == 260);
        prev_dot := (i >= 1) && (toks[i - 1].kind == 46);
        next_scope := (i + 1 < toks.len()) && (toks[i + 1].kind == 260);
        if (tkind == 1) && !prev_scope && !prev_dot && !next_scope && (ct_module_names(&mut c, module, view(word)) != 0) {
            push_bytes(&mut qualified, module);
            push_bytes(&mut qualified, view("::"));
        }
        push_bytes(&mut qualified, view(word));
        last_end = tend;
    }
    for j in last_end..text.len() {
        qualified.push(text[j]);
    }
    return qualified;
}
fn ct_add_use<a>(uses: (&a mut u8[][]), m: &a [u8]) -> unit {
    for i in uses.len() {
        if same(view(uses[i]), m) {
            return ();
        }
    }
    uses.push(copy_bytes(m));
    return ();
}
// A run-tier type spelled so the probe module can write it: records by `module::Name`.
fn ct_type_src<a>(c: (&a mut C), ty: u64, uses: (&a mut u8[][])) -> u8[] {
    if (ty == 3) || (ty == 2) || integer(&mut c, ty) || is_bool(&mut c, ty) {
        return source_type_name(&mut c, ty);
    }
    k := ty_kind(&mut c, ty);
    if k == 6 {
        mut out = ct_type_src(&mut c, ty_arg(&mut c, ty), &mut uses);
        push_bytes(&mut out, view("[]"));
        return out;
    }
    if k == 8 {
        d := ty_arg(&mut c, ty);
        m := c.decls[d].module.copy();
        ct_add_use(&mut uses, view(m));
        mut out = m.copy();
        push_bytes(&mut out, view("::"));
        push_bytes(&mut out, view(c.decls[d].name));
        return out;
    }
    return source_type_name(&mut c, ty);
}
// The type a run-tier value has: a static's declared type, a binding's call's result type.
fn ct_call_type<a>(c: (&a mut C), k: u64) -> u64 {
    m := c.ct_calls[k].module.copy();
    n := c.ct_calls[k].name.copy();
    if c.ct_calls[k].is_static != 0 {
        st := find_static(&mut c, view(m), view(n));
        if st != 0 {
            return c.statics[st - 1].ty;
        }
        return NO_TYPE;
    }
    kc := find_constant(&mut c, view(m), view(n));
    if kc == 0 {
        return NO_TYPE;
    }
    ty := c.constants[kc - 1].ty;
    if ty == CT_PENDING {
        return ct_pending_type(&mut c, kc - 1);
    }
    return ty;
}
// The result type of the function a run-tier call names (`f(...)` or `m::f(...)` read in `module`),
// or NO_TYPE when no such function is known.
fn ct_call_result<a, b>(c: (&a mut C), module: &b [u8], text: &b [u8]) -> u64 {
    toks := lexer::tokenize(text);
    if toks.len() == 0 {
        return NO_TYPE;
    }
    mut fmod = copy_bytes(module);
    mut fname = slice_bytes(text, toks[0].start, toks[0].end);
    if (toks.len() > 2) && (toks[1].kind == 260) {
        fmod = fname.copy();
        fname = slice_bytes(text, toks[2].start, toks[2].end);
    }
    f := ct_module_names(&mut c, view(fmod), view(fname));
    if f == 0 {
        return NO_TYPE;
    }
    return c.funcs[f - 1].ret;
}
// The symbol suffix of a run-tier value's probe functions.
fn ct_value_tag<a>(m: &a [u8], n: &a [u8]) -> u8[] {
    mut out = copy_bytes(m);
    push_bytes(&mut out, view("__"));
    push_bytes(&mut out, n);
    return out;
}
// For every run-tier value of the program, two probe functions: `grail_value__M__N()`, which
// computes it (announcing itself on stderr, so a cycle can be traced back), and
// `grail_cycle__M__N()`, which a read reaching it while it is being computed calls before the
// probe stops. Reads inside a probe call these instead of starting another probe.
fn ct_probe_wrappers<a>(c: (&a mut C), uses: (&a mut u8[][])) -> u8[] {
    mut out = u8[];
    for k in c.ct_calls.len() {
        ty := ct_call_type(&mut c, k);
        if !is_type_id(ty) {
            continue;
        }
        m := c.ct_calls[k].module.copy();
        n := c.ct_calls[k].name.copy();
        ct_add_use(&mut uses, view(m));
        tag := ct_value_tag(view(m), view(n));
        mut key = m.copy();
        push_bytes(&mut key, view("::"));
        push_bytes(&mut key, view(n));
        ctext := c.ct_calls[k].text.copy();
        if c.ct_calls[k].is_static != 0 {
            // The wrapper returns the static's declared type, so the call must give exactly it; a
            // mismatch is the static's own error, reported at it before any probe is written.
            got := ct_call_result(&mut c, view(m), view(ctext));
            if is_type_id(got) && (got != ty) {
                st := find_static(&mut c, view(m), view(n)) - 1;
                mut msg = copy_bytes(view("static `"));
                push_bytes(&mut msg, view(n));
                push_bytes(&mut msg, view("` is declared `"));
                push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
                push_bytes(&mut msg, view("`, and `@"));
                push_bytes(&mut msg, view(ctext));
                push_bytes(&mut msg, view("` gives `"));
                push_bytes(&mut msg, view(source_type_name(&mut c, got)));
                push_bytes(&mut msg, view("`"));
                sfile := c.statics[st].file;
                sat := c.statics[st].init_at;
                fail_in_file(&mut c, sfile, sat, view(msg));
            }
        }
        call := ct_qualify(&mut c, view(m), view(ctext));
        tsrc := ct_type_src(&mut c, ty, &mut uses);
        push_bytes(&mut out, view("pub fn grail_value__"));
        push_bytes(&mut out, view(tag));
        push_bytes(&mut out, view("() -> "));
        push_bytes(&mut out, view(tsrc));
        push_bytes(&mut out, view(" {\n    host::write_fd(2, view(\"@enter "));
        push_bytes(&mut out, view(key));
        push_bytes(&mut out, view("\\n\"));\n    v := "));
        push_bytes(&mut out, view(call));
        push_bytes(&mut out, view(";\n    host::write_fd(2, view(\"@leave "));
        push_bytes(&mut out, view(key));
        push_bytes(&mut out, view("\\n\"));\n    return v;\n}\npub fn grail_cycle__"));
        push_bytes(&mut out, view(tag));
        push_bytes(&mut out, view("() -> u64 {\n    host::write_fd(2, view(\"@cycle "));
        push_bytes(&mut out, view(key));
        push_bytes(&mut out, view("\\n\"));\n    return 0;\n}\n"));
    }
    return out;
}
// The probe's stderr without its trace lines: what the runtime itself reported.
fn ct_trace_report<a>(trace: &a [u8]) -> u8[] {
    mut out = u8[];
    mut start = 0;
    for i in trace.len() + 1 {
        if (i == trace.len()) || (trace[i] == 10) {
            line := slice_bytes(trace, start, i);
            // Not the probe's own frames (its generated source is no one's program) and not the
            // `timeout` wrapper's note about the core the abort left.
            keep := (i > start) && (trace[start] != 64) && !ct_list_has_sub(view(line), view(".probe.grl")) && !ct_list_has_prefix(view(line), view("timeout: "));
            if keep {
                push_bytes(&mut out, view(line));
                out.push(10);
            }
            start = i + 1;
        }
    }
    return out;
}
// "`A` and `B` depend on each other while compiling: A -> B -> A", from the trace: the values
// entered and not yet left, from the one the cycle reached back to.
fn ct_trace_cycle<a>(trace: &a [u8]) -> u8[] {
    mut stack = u8[][];
    mut target = u8[];
    mut start = 0;
    for i in trace.len() + 1 {
        if (i == trace.len()) || (trace[i] == 10) {
            line := slice_bytes(trace, start, i);
            if ct_list_has_prefix(view(line), view("@enter ")) {
                stack.push(slice_bytes(view(line), 7, line.len()));
            } else if ct_list_has_prefix(view(line), view("@leave ")) {
                if stack.len() != 0 {
                    stack.pop()!;
                }
            } else if ct_list_has_prefix(view(line), view("@cycle ")) {
                target = slice_bytes(view(line), 7, line.len());
            }
            start = i + 1;
        }
    }
    if target.len() == 0 {
        return u8[];
    }
    mut from = stack.len();
    for i in stack.len() {
        if same(view(stack[i]), view(target)) {
            from = i;
            break;
        }
    }
    if from == stack.len() {
        return u8[];
    }
    mut path = u8[];
    mut names = u8[][];
    for i in from..stack.len() {
        push_bytes(&mut path, view(stack[i]));
        push_bytes(&mut path, view(" -> "));
        ct_add_use(&mut names, view(stack[i]));
    }
    push_bytes(&mut path, view(target));
    mut msg = u8[];
    if names.len() == 1 {
        push_bytes(&mut msg, view("`"));
        push_bytes(&mut msg, view(names[0]));
        push_bytes(&mut msg, view("` depends on itself while compiling: "));
    } else {
        for i in names.len() {
            if i != 0 {
                if i + 1 == names.len() {
                    push_bytes(&mut msg, view(" and "));
                } else {
                    push_bytes(&mut msg, view(", "));
                }
            }
            push_bytes(&mut msg, view("`"));
            push_bytes(&mut msg, view(names[i]));
            push_bytes(&mut msg, view("`"));
        }
        push_bytes(&mut msg, view(" depend on each other while compiling: "));
    }
    push_bytes(&mut msg, view(path));
    return msg;
}
fn ct_list_has_prefix<a, b>(text: &a [u8], prefix: &b [u8]) -> bool {
    if text.len() < prefix.len() {
        return false;
    }
    for i in prefix.len() {
        if text[i] != prefix[i] {
            return false;
        }
    }
    return true;
}
// Compile, link and run a probe program (cached by its text and every input file) and answer what
// it printed. `text` names the call in messages; `key` is the value it computes, if it is one. With
// `soft` set a failure is not reported: `status` says it (non-zero), the probe compile's errors are
// discarded, and the caller decides (the batch falls back to one probe per value, which reports).
fn ct_probe_exec<a, b, d, e>(c: (&a mut C), probe: &b [u8], text: &d [u8], key: &e [u8], soft: u64, status_out: (&a mut u64)) -> u8[] {
    exchange(status_out, 0);
    // The cache key: the probe and every input file.
    mut keyed = copy_bytes(probe);
    offset := c.arg_offset;
    argc := host::argc();
    mut files = u8[][];
    mut fi = offset + 2;
    if c.probe_mode != 0 {
        // A probe compile's own first file is its probe; a nested probe takes the program's files.
        fi = offset + 3;
    }
    while fi < argc {
        path := host::arg(fi);
        files.push(path.copy());
        push_bytes(&mut keyed, view(path));
        push_bytes(&mut keyed, view(host::read_file(view(path))));
        fi += 1;
    }
    // The files the module roots added are inputs of the value too: the probe is compiled with the
    // same roots, so a change to a resolved module changes what the call computes.
    for i in c.mod_files.len() {
        path := c.mod_files[i];
        files.push(path.copy());
        push_bytes(&mut keyed, view(path));
        push_bytes(&mut keyed, view(host::read_file(view(path))));
    }
    digest := iface_digest(&keyed);
    mut dir = copy_bytes(view(".work/comptime/"));
    for i in 24 {
        dir.push(digest[i]);
    }
    out_path := path_cat(view(dir), view("/value"));
    if host::exists(view(out_path)) == 0 {
        mut mk = u8[][copy_bytes(view("mkdir")), copy_bytes(view("-p")), dir.copy()];
        host::command(mk);
        // Compiles that run the same call at once (parallel test shards, a parallel build) share
        // `dir`: each builds under names of its own - keyed by this compile's output path - and
        // only the finished value is published, by rename, so no one reads a half-written file.
        own_key := iface_digest(&host::arg(offset + 1));
        mut tag = copy_bytes(view("/"));
        for i in 12 {
            tag.push(own_key[i]);
        }
        probe_src := path_cat(view(path_cat(view(dir), view(tag))), view(".probe.grl"));
        probe_s := path_cat(view(path_cat(view(dir), view(tag))), view(".probe.s"));
        probe_exe := path_cat(view(path_cat(view(dir), view(tag))), view(".probe"));
        value_tmp := path_cat(view(path_cat(view(dir), view(tag))), view(".value"));
        host::write_file(view(probe_src), view(probe));
        self := host::exe_path();
        mut cmd = ct_shell_quote(view(self));
        mut opt = 1;
        while opt < offset + 1 {
            a := host::arg(opt);
            // The probe is a compile of the same program, so it resolves `use` in the same roots; the
            // options that change what the code means travel with it.
            if starts_with(view(a), view("--overflow=")) {
                cmd.push(32);
                push_bytes(&mut cmd, view(a));
            } else if same(view(a), view("--module-root")) {
                cmd.push(32);
                push_bytes(&mut cmd, view("--module-root"));
                cmd.push(32);
                push_bytes(&mut cmd, view(ct_shell_quote(view(host::arg(opt + 1)))));
                opt += 1;
            }
            opt += 1;
        }
        // Probes share a function cache of their own: the runtime and the standard library are most
        // of a probe's compile and are the same in every probe (comptime-speed.md); a probe never
        // replays a normal compile's bodies, whose static reads are compiled differently.
        push_bytes(&mut cmd, view(" --fn-cache .work/comptime/fn --fn-cache-quiet"));
        push_bytes(&mut cmd, view(" --target x86_64 --comptime-probe "));
        push_bytes(&mut cmd, view(ct_shell_quote(view(probe_s))));
        cmd.push(32);
        push_bytes(&mut cmd, view(ct_shell_quote(view(probe_src))));
        for i in files.len() {
            cmd.push(32);
            push_bytes(&mut cmd, view(ct_shell_quote(view(files[i]))));
        }
        mut pending = host::env(view("GRAIL_COMPTIME_PENDING"));
        if key.len() != 0 {
            if pending.len() != 0 {
                pending.push(44);
            }
            push_bytes(&mut pending, key);
        }
        depth_text := host::env(view("GRAIL_COMPTIME_DEPTH"));
        mut depth = 0;
        for i in depth_text.len() {
            depth = depth * 10 + u64(depth_text[i] - 48);
        }
        if 8 <= depth {
            if soft != 0 {
                exchange(status_out, 1);
                return u8[];
            }
            fail(&mut c, view("compile-time calls nest more than 8 deep"));
        }
        mut compile = copy_bytes(view("GRAIL_COMPTIME_DEPTH="));
        decimal(&mut compile, depth + 1);
        if c.ct_deps_path.len() != 0 {
            push_bytes(&mut compile, view(" GRAIL_COMPTIME_DEPS="));
            push_bytes(&mut compile, view(ct_shell_quote(view(c.ct_deps_path))));
        }
        push_bytes(&mut compile, view(" GRAIL_COMPTIME_PENDING="));
        push_bytes(&mut compile, view(ct_shell_quote(view(pending))));
        compile.push(32);
        push_bytes(&mut compile, view(cmd));
        if soft != 0 {
            // A diagnostic is printed on stdout; the value's own probe reports it if it matters.
            push_bytes(&mut compile, view(" > /dev/null 2>&1"));
        }
        mut sh = u8[][copy_bytes(view("sh")), copy_bytes(view("-c")), compile];
        if host::command(sh) != 0 {
            if soft != 0 {
                exchange(status_out, 1);
                return u8[];
            }
            mut msg = copy_bytes(view("compile-time call `"));
            push_bytes(&mut msg, text);
            push_bytes(&mut msg, view("` did not compile (the errors above)"));
            fail(&mut c, view(msg));
        }
        asm := host::read_file(view(probe_s));
        if ct_list_has_sub(view(asm), view("// grail-link: ")) {
            if soft != 0 {
                exchange(status_out, 1);
                return u8[];
            }
            fail(&mut c, view("compile-time code cannot call C: the call reaches an extern function"));
        }
        mut cc = host::env(view("GRAIL_CC"));
        if cc.len() == 0 {
            cc = copy_bytes(view("cc"));
        }
        mut link = u8[][cc, copy_bytes(view("-nostdlib")), copy_bytes(view("-static")), copy_bytes(view("-o")), probe_exe.copy(), probe_s.copy()];
        if host::command(link) != 0 {
            if soft != 0 {
                exchange(status_out, 1);
                return u8[];
            }
            fail(&mut c, view("compile-time call: linking the probe failed (needs cc)"));
        }
        mut run = copy_bytes(view("GRAIL_COMPTIME=1 timeout 30 "));
        push_bytes(&mut run, view(ct_shell_quote(view(probe_exe))));
        push_bytes(&mut run, view(" > "));
        push_bytes(&mut run, view(ct_shell_quote(view(value_tmp))));
        // The probe's stderr carries its trace (`@enter`/`@leave`/`@cycle` lines from the value
        // functions) and, on a failure, the runtime's report; both are read back below.
        err_tmp := path_cat(view(path_cat(view(dir), view(tag))), view(".err"));
        push_bytes(&mut run, view(" 2> "));
        push_bytes(&mut run, view(ct_shell_quote(view(err_tmp))));
        mut sh2 = u8[][copy_bytes(view("sh")), copy_bytes(view("-c")), run];
        status := host::command(sh2);
        if (status != 0) && (soft != 0) {
            exchange(status_out, status);
            return u8[];
        }
        if status != 0 {
            trace := host::read_file(view(err_tmp));
            report := ct_trace_report(view(trace));
            if report.len() != 0 {
                host::write_fd(2, view(report));
            }
            mut msg = u8[];
            if key.len() != 0 {
                push_bytes(&mut msg, view("compile-time value `"));
                push_bytes(&mut msg, key);
                push_bytes(&mut msg, view("` = `"));
            } else {
                push_bytes(&mut msg, view("compile-time call `"));
            }
            push_bytes(&mut msg, text);
            if status == 124 {
                push_bytes(&mut msg, view("` ran past the 30 s limit"));
            } else if status == 4 {
                cycle := ct_trace_cycle(view(trace));
                if cycle.len() != 0 {
                    msg = cycle;
                } else {
                    push_bytes(&mut msg, view("` reads a constant that is still being computed: the constants depend on each other in a cycle"));
                }
            } else if status == 134 {
                push_bytes(&mut msg, view("` stopped with a runtime error while compiling (above)"));
            } else if status == 3 {
                push_bytes(&mut msg, view("` was refused an effect compile-time code may not have (above)"));
            } else {
                push_bytes(&mut msg, view("` exited with status "));
                decimal(&mut msg, status);
                push_bytes(&mut msg, view(" while compiling"));
            }
            fail(&mut c, view(msg));
        }
        mut mv = u8[][copy_bytes(view("mv")), copy_bytes(view("-f")), value_tmp.copy(), out_path.copy()];
        host::command(mv);
        mut tidy = u8[][copy_bytes(view("rm")), copy_bytes(view("-f")), probe_src.copy(), probe_s.copy(), probe_exe.copy(), err_tmp.copy()];
        host::command(tidy);
    }
    if host::exists(view(out_path)) == 0 {
        return u8[];
    }
    return host::read_file(view(out_path));
}
// ---- R3: compile-time values cached by what they reach (docs/design/comptime-speed.md) ----------
//
// A value's cache entry is keyed by its identity - the compiler, the options, the target, the value's
// name, its call and its type - and records what its computation depended on: the declaration
// surface that is not functions (types, aliases, constants), the text of every function body the
// probe reached from the value's function (its effect call graph), and the calls of the other values
// it read. A later build uses the entry when all of those are still what they were, so an edit
// anywhere else runs no probe.

// The hash of a function's declaration as written: its tokens from `pos` through the closing brace
// of its body (or the `;` of a body-less one), so spacing and comments do not count.
fn ct_decl_hash<a>(c: (&a mut C), file: u64, pos: u64) -> u8[] {
    saved_file := c.file;
    saved_pos := c.pos;
    if (file != 0) && (file != saved_file) {
        load_file(&mut c, file);
        exchange(&mut c.file, file);
    }
    mut text = u8[];
    mut i = pos;
    mut depth = 0;
    while i < c.toks.len() {
        k := kind_at(&mut c, i);
        if k == 0 {
            break;
        }
        push_bytes(&mut text, view(tok_text(&mut c, i)));
        text.push(32);
        if k == 40 {
            depth += 1;
        }
        if (k == 41) && (depth > 0) {
            depth -= 1;
        }
        if (depth == 0) && (k == 59) {
            break;
        }
        if (depth == 0) && (k == 123) {
            mut braces = 1;
            i += 1;
            while (braces > 0) && (i < c.toks.len()) {
                kb := kind_at(&mut c, i);
                if kb == 0 {
                    break;
                }
                push_bytes(&mut text, view(tok_text(&mut c, i)));
                text.push(32);
                if kb == 123 {
                    braces += 1;
                }
                if kb == 125 {
                    braces -= 1;
                }
                i += 1;
            }
            break;
        }
        i += 1;
    }
    if (file != 0) && (file != saved_file) {
        load_file(&mut c, saved_file);
        exchange(&mut c.file, saved_file);
    }
    exchange(&mut c.pos, saved_pos);
    return fncache::hash(view(text));
}
// Whether a source file is the runtime, a platform module or the standard library: those are covered
// by their files' contents in every value's identity (ct_std_digest), not body by body.
fn ct_std_file<a>(c: (&a mut C), file: u64) -> bool {
    path := file_path(&mut c, file);
    if in_std_dir(view(path)) != 0 {
        return true;
    }
    mut cut = 0;
    for i in path.len() {
        if (path[i] == 47) || (path[i] == 92) {
            cut = i + 1;
        }
    }
    base := slice_bytes(view(path), cut, path.len());
    return same(view(base), view("runtime.grl")) || same(view(base), view("os-linux.grl")) || same(view(base), view("os-windows.grl")) || same(view(base), view("darwin.grl"));
}
// The contents of every runtime, platform and standard-library file this compile read.
fn ct_std_digest<a>(c: (&a mut C)) -> u8[] {
    mut all = u8[];
    mut f = 2;
    while f < c.mod_base + c.mod_files.len() {
        if ct_std_file(&mut c, f) {
            path := file_path(&mut c, f);
            push_bytes(&mut all, view(path));
            push_bytes(&mut all, view(fncache::hash(view(host::read_file(view(path))))));
        }
        f += 1;
    }
    return fncache::hash(view(all));
}
// What a run-tier value's call is, as a dependency of another value that read it.
fn ct_call_hash<a>(c: (&a mut C), k: u64) -> u8[] {
    mut t = copy_bytes(view("value "));
    push_bytes(&mut t, view(c.ct_calls[k].module));
    push_bytes(&mut t, view("::"));
    push_bytes(&mut t, view(c.ct_calls[k].name));
    t.push(32);
    push_bytes(&mut t, view(c.ct_calls[k].text));
    return fncache::hash(view(t));
}
fn ct_call_index<a, b>(c: (&a C), tag: &b [u8]) -> u64 {
    for k in c.ct_calls.len() {
        t := ct_value_tag(view(c.ct_calls[k].module), view(c.ct_calls[k].name));
        if same(view(t), tag) {
            return k + 1;
        }
    }
    return 0;
}
// In a probe compile, after the call graph is solved: for every value function the probe defines,
// the bodies it reaches, written to GRAIL_COMPTIME_DEPS as `TAG H <hash>` (a body's text) and
// `TAG V <tag>` (another value it read).
fn ct_write_deps<a>(c: (&a mut C)) -> unit {
    path := host::env(view("GRAIL_COMPTIME_DEPS"));
    if (c.probe_mode == 0) || (path.len() == 0) {
        return ();
    }
    n := c.fx_syms.len();
    mut adj = u64[][];
    for i in n {
        adj.push(u64[]);
    }
    for e in c.fx_edge_from.len() {
        from := c.fx_edge_from[e];
        // The probe makes no effect claim, so the solver did not resolve the edges: look them up.
        name := c.fx_edge_name[e].copy();
        mut to = 0;
        if name.len() != 0 {
            to = fx_lookup(&mut c, view(name));
        }
        if (to != 0) && (from < n) {
            adj[from].push(to - 1);
        }
    }
    value_prefix := "f_grail_probe_grail_value__";
    mut out = u8[];
    // A body's hash, once: many values reach the same functions.
    mut memo = u8[][];
    mut memo_done = u64[];
    for i in n {
        memo.push(u8[]);
        memo_done.push(0);
    }
    for w in n {
        if !ct_list_has_prefix(view(c.fx_syms[w]), view(value_prefix)) {
            continue;
        }
        tag := slice_bytes(view(c.fx_syms[w]), value_prefix.len(), c.fx_syms[w].len());
        mut seen = u64[];
        for i in n {
            seen.push(0);
        }
        mut work = u64[w];
        seen[w] = 1;
        while work.len() != 0 {
            v := work.pop()!;
            for j in adj[v].len() {
                t := adj[v][j];
                if seen[t] == 0 {
                    seen[t] = 1;
                    sym := c.fx_syms[t].copy();
                    if ct_list_has_prefix(view(sym), view(value_prefix)) {
                        // Another value: its own call is the dependency, not what it reaches.
                        push_bytes(&mut out, view(tag));
                        push_bytes(&mut out, view(" V "));
                        push_bytes(&mut out, view(slice_bytes(view(sym), value_prefix.len(), sym.len())));
                        out.push(10);
                        continue;
                    }
                    work.push(t);
                    if ct_list_has_prefix(view(sym), view("f_grail_probe_")) {
                        continue;
                    }
                    if (t < c.fx_body.len()) && (c.fx_body[t] != 0) && (c.fx_fn_file[t] != 0) {
                        if memo_done[t] == 0 {
                            memo_done[t] = 1;
                            tfile := c.fx_fn_file[t];
                            if !ct_std_file(&mut c, tfile) {
                                tpos := c.fx_fn_pos[t];
                                memo[t] = ct_decl_hash(&mut c, tfile, tpos);
                            }
                        }
                        if memo[t].len() != 0 {
                            push_bytes(&mut out, view(tag));
                            push_bytes(&mut out, view(" H "));
                            push_bytes(&mut out, view(memo[t]));
                            out.push(10);
                        }
                    }
                }
            }
        }
    }
    host::write_file(view(path), view(out));
    return ();
}
// The declaration surface a value can read that is not a function: records and enums with their
// fields, aliases, constants. Adding or editing a function does not change it.
fn ct_types_digest<a>(c: (&a mut C)) -> u8[] {
    mut out = u8[];
    old_lenient := exchange(&mut c.spell_lenient, 1);
    old_failed := exchange(&mut c.spell_failed, 0);
    mut deps = u64[];
    for i in c.decls.len() {
        iface_ws(&mut out, view(c.decls[i].module));
        iface_ws(&mut out, view(c.decls[i].name));
        iface_wv(&mut out, c.decls[i].is_enum);
        iface_wv(&mut out, c.decls[i].c_layout);
        nf := c.decls[i].count;
        first := c.decls[i].first;
        iface_wv(&mut out, nf);
        for j in nf {
            fname := c.fields[first + j].name.copy();
            fty := c.fields[first + j].ty;
            iface_ws(&mut out, view(fname));
            iface_w_type(&mut c, &mut out, &mut deps, fty);
        }
    }
    for i in c.aliases.len() {
        iface_ws(&mut out, view(c.aliases[i].module));
        iface_ws(&mut out, view(c.aliases[i].name));
        ty := c.aliases[i].ty;
        iface_w_type(&mut c, &mut out, &mut deps, ty);
    }
    for i in c.constants.len() {
        iface_ws(&mut out, view(c.constants[i].module));
        iface_ws(&mut out, view(c.constants[i].name));
        iface_ws(&mut out, view(c.constants[i].text));
        iface_wv(&mut out, c.constants[i].value);
    }
    exchange(&mut c.spell_lenient, old_lenient);
    exchange(&mut c.spell_failed, old_failed);
    return fncache::hash(view(out));
}
// A value's identity: the compiler, the options, the target, the value, its call and its type.
fn ct_value_id<a, b>(c: (&a mut C), k: u64, ty: u64, std: &b [u8]) -> u8[] {
    mut t = copy_bytes(view("grail-ctv 1\n"));
    push_bytes(&mut t, std);
    t.push(10);
    push_bytes(&mut t, view(host::exe_path()));
    t.push(10);
    push_bytes(&mut t, view(fn_flags_now(&mut c)));
    t.push(10);
    decimal(&mut t, c.target);
    t.push(10);
    push_bytes(&mut t, view(c.ct_calls[k].module));
    push_bytes(&mut t, view("::"));
    push_bytes(&mut t, view(c.ct_calls[k].name));
    t.push(10);
    push_bytes(&mut t, view(c.ct_calls[k].text));
    t.push(10);
    push_bytes(&mut t, view(type_name(&mut c, ty)));
    return fncache::hash(view(t));
}
fn ct_entry_path<a>(id: &a [u8]) -> u8[] {
    mut p = copy_bytes(view(".work/comptime/v/"));
    push_bytes(&mut p, id);
    return p;
}
// The cached flat value of entry `id`, or empty when there is no entry or one of what it read has
// changed. `known` is every current function declaration's hash, `types` the current digest.
fn ct_entry_valid<a, b>(c: (&a mut C), id: &b [u8], types: &b [u8], known: (&a u8[][])) -> u8[] {
    path := ct_entry_path(id);
    if host::exists(view(path)) == 0 {
        return u8[];
    }
    data := host::read_file(view(path));
    mut at = 0;
    mut start = 0;
    while at < data.len() {
        if data[at] != 10 {
            at += 1;
            continue;
        }
        line := slice_bytes(view(data), start, at);
        at += 1;
        start = at;
        if same(view(line), view("value")) {
            return slice_bytes(view(data), at, data.len());
        }
        if ct_list_has_prefix(view(line), view("types ")) {
            if !same(view(slice_bytes(view(line), 6, line.len())), types) {
                return u8[];
            }
        } else if ct_list_has_prefix(view(line), view("H ")) {
            h := slice_bytes(view(line), 2, line.len());
            mut hit = false;
            for i in known.len() {
                if same(view(known[i]), view(h)) {
                    hit = true;
                    break;
                }
            }
            if !hit {
                return u8[];
            }
        } else if ct_list_has_prefix(view(line), view("V ")) {
            // `V tag hash`: the other value's call is still that call.
            rest := slice_bytes(view(line), 2, line.len());
            mut sp = 0;
            while (sp < rest.len()) && (rest[sp] != 32) {
                sp += 1;
            }
            tag := slice_bytes(view(rest), 0, sp);
            want := slice_bytes(view(rest), sp + 1, rest.len());
            ki := ct_call_index(&c, view(tag));
            if ki == 0 {
                return u8[];
            }
            if !same(view(ct_call_hash(&mut c, ki - 1)), view(want)) {
                return u8[];
            }
        }
    }
    return u8[];
}
// Skip one value of type `ty` in the flat form (static_dump_src): the reader static_bake uses,
// without emitting anything.
fn static_flat_skip<a>(c: (&a mut C), ty: u64, text: &a [u8], at: (&a mut u64)) -> unit {
    if integer(&mut c, ty) || is_bool(&mut c, ty) {
        static_read_num(text, &mut at);
        return ();
    }
    if ty == 3 {
        n := static_read_num(text, &mut at);
        exchange(at, *at + n + 1);
        return ();
    }
    if (ty == 2) || (ty_kind(&mut c, ty) == 6) {
        mut elem = int_type(&mut c, 8, 0);
        if ty != 2 {
            elem = ty_arg(&mut c, ty);
        }
        n := static_read_num(text, &mut at);
        for j in n {
            static_flat_skip(&mut c, elem, text, &mut at);
        }
        return ();
    }
    d := ty_arg(&mut c, ty);
    first := c.decls[d].first;
    for j in c.decls[d].count {
        fty := c.fields[first + j].ty;
        static_flat_skip(&mut c, fty, text, &mut at);
    }
    return ();
}
// One value of the batch's output turned into what run_tier would have answered for it.
fn ct_res_from_flat<a>(c: (&a mut C), ty: u64, text: &a [u8], at: (&a mut u64)) -> CTRes {
    if integer(&mut c, ty) || is_bool(&mut c, ty) {
        v := static_read_num(text, &mut at);
        return CTRes { ty: ty, value: v, text: u8[] };
    }
    if ty == 3 {
        n := static_read_num(text, &mut at);
        mut bytes = u8[];
        for j in n {
            if *at + j < text.len() {
                bytes.push(text[*at + j]);
            }
        }
        exchange(at, *at + n + 1);
        return CTRes { ty: 3, value: 0, text: bytes };
    }
    if ct_seq_elem(&mut c, ty) != NO_TYPE {
        // The elements at the element's C width, as run_tier lays a table out.
        elem := ct_seq_elem(&mut c, ty);
        width := ffi_field_size(&mut c, elem);
        n := static_read_num(text, &mut at);
        mut data = u8[];
        for j in n {
            v := static_read_num(text, &mut at);
            for b in width {
                data.push(u8((v >> (8 * b)) & 255));
            }
        }
        return CTRes { ty: ty, value: n, text: data };
    }
    start := *at;
    static_flat_skip(&mut c, ty, text, &mut at);
    return CTRes { ty: ty, value: 0, text: slice_bytes(text, start, *at) };
}
// R2 (docs/design/comptime-speed.md): every run-tier value of the build not computed yet, in one
// probe that prints each after a `#k` line, in the flat form. The results go to `ct_done`, which
// run_tier answers from. If the batch fails - a value does not compile, panics, is refused an
// effect, exits, or the values form a cycle - nothing is recorded, and each value is computed
// by its own probe where it is needed, which reports the failure at the value.
fn ct_batch<a>(c: (&a mut C)) -> unit {
    if c.probe_mode != 0 {
        return ();
    }
    mut keys = u8[][];
    mut types = u64[];
    mut calls = u64[];
    mut ids = u8[][];
    mut uses = u8[][];
    mut body = u8[];
    // R3: what the cached entries are checked against, worked out once.
    mut known = u8[][];
    mut digest = u8[];
    mut prepared = false;
    mut std = u8[];
    for k in c.ct_calls.len() {
        m := c.ct_calls[k].module.copy();
        n := c.ct_calls[k].name.copy();
        if c.ct_calls[k].is_static != 0 {
            st := find_static(&mut c, view(m), view(n));
            if (st == 0) || (c.statics[st - 1].state != 0) {
                continue;
            }
        } else {
            kc := find_constant(&mut c, view(m), view(n));
            if (kc == 0) || (c.constants[kc - 1].ty != CT_PENDING) {
                continue;
            }
        }
        ty := ct_call_type(&mut c, k);
        if !is_type_id(ty) || !static_baked_type(&mut c, ty) {
            continue;
        }
        mut key = m.copy();
        push_bytes(&mut key, view("::"));
        push_bytes(&mut key, view(n));
        if std.len() == 0 {
            std = ct_std_digest(&mut c);
        }
        id := ct_value_id(&mut c, k, ty, view(std));
        if host::exists(view(ct_entry_path(view(id)))) != 0 {
            if !prepared {
                prepared = true;
                digest = ct_types_digest(&mut c);
                for f in c.funcs.len() {
                    ffile := c.funcs[f].file;
                    fpos := c.funcs[f].pos;
                    if (ffile != 0) && !ct_std_file(&mut c, ffile) {
                        known.push(ct_decl_hash(&mut c, ffile, fpos));
                    }
                }
            }
            flat := ct_entry_valid(&mut c, view(id), view(digest), &known);
            if flat.len() != 0 {
                mut fat = 0;
                res := ct_res_from_flat(&mut c, ty, view(flat), &mut fat);
                c.ct_done.push(CtDone { key: key.copy(), res: res });
                continue;
            }
        }
        ct_add_use(&mut uses, view(m));
        mut var = copy_bytes(view("grail_v"));
        decimal(&mut var, keys.len());
        push_bytes(&mut body, view("    println(\"#"));
        decimal(&mut body, keys.len());
        push_bytes(&mut body, view("\");\n    "));
        push_bytes(&mut body, view(var));
        push_bytes(&mut body, view(" := "));
        push_bytes(&mut body, view(key));
        push_bytes(&mut body, view(";\n"));
        static_dump_src(&mut c, ty, view(var), 0, &mut body);
        keys.push(key);
        types.push(ty);
        calls.push(k);
        ids.push(id);
    }
    if keys.len() == 0 {
        return ();
    }
    wrappers := ct_probe_wrappers(&mut c, &mut uses);
    mut probe = copy_bytes(view("module grail_probe;\n\n"));
    for u in uses.len() {
        push_bytes(&mut probe, view("use "));
        push_bytes(&mut probe, view(uses[u]));
        push_bytes(&mut probe, view(";\n"));
    }
    push_bytes(&mut probe, view("use host;\n\n"));
    push_bytes(&mut probe, view(wrappers));
    push_bytes(&mut probe, view("fn main() -> u64 {\n"));
    push_bytes(&mut probe, view(body));
    push_bytes(&mut probe, view("    return 0;\n}\n"));
    mut status = 0;
    host::command(u8[][copy_bytes(view("mkdir")), copy_bytes(view("-p")), copy_bytes(view(".work/comptime/v"))]);
    deps_path := path_cat(view(".work/comptime/v/deps."), view(iface_digest(&probe)));
    host::command(u8[][copy_bytes(view("rm")), copy_bytes(view("-f")), deps_path.copy()]);
    exchange(&mut c.ct_deps_path, deps_path.copy());
    printed := ct_probe_exec(&mut c, view(probe), view("the build's compile-time values"), view(""), 1, &mut status);
    exchange(&mut c.ct_deps_path, u8[]);
    if (status != 0) || (printed.len() == 0) {
        return ();
    }
    mut at = 0;
    mut results = CtDone[];
    mut flats = u8[][];
    for k in keys.len() {
        // `#k` and its newline.
        if (at >= printed.len()) || (printed[at] != 35) {
            return ();
        }
        exchange(&mut at, at + 1);
        idx := static_read_num(view(printed), &mut at);
        if idx != k {
            return ();
        }
        vstart := at;
        res := ct_res_from_flat(&mut c, types[k], view(printed), &mut at);
        results.push(CtDone { key: keys[k].copy(), res: res });
        flats.push(slice_bytes(view(printed), vstart, at));
    }
    // R3: an entry per value - what it read, then the value - when the probe said what it reached.
    if host::exists(view(deps_path)) != 0 {
        deps := host::read_file(view(deps_path));
        if digest.len() == 0 {
            digest = ct_types_digest(&mut c);
        }
        for k in keys.len() {
            tag := ct_value_tag(view(c.ct_calls[calls[k]].module), view(c.ct_calls[calls[k]].name));
            mut entry = copy_bytes(view("grail-ctv 1\ntypes "));
            push_bytes(&mut entry, view(digest));
            entry.push(10);
            mut start = 0;
            for i in deps.len() + 1 {
                if (i == deps.len()) || (deps[i] == 10) {
                    line := slice_bytes(view(deps), start, i);
                    start = i + 1;
                    if (line.len() > tag.len() + 3) && ct_list_has_prefix(view(line), view(tag)) && (line[tag.len()] == 32) {
                        rest := slice_bytes(view(line), tag.len() + 1, line.len());
                        if ct_list_has_prefix(view(rest), view("H ")) {
                            push_bytes(&mut entry, view(rest));
                            entry.push(10);
                        } else if ct_list_has_prefix(view(rest), view("V ")) {
                            other := slice_bytes(view(rest), 2, rest.len());
                            ki := ct_call_index(&c, view(other));
                            if ki != 0 {
                                push_bytes(&mut entry, view("V "));
                                push_bytes(&mut entry, view(other));
                                entry.push(32);
                                push_bytes(&mut entry, view(ct_call_hash(&mut c, ki - 1)));
                                entry.push(10);
                            }
                        }
                    }
                }
            }
            push_bytes(&mut entry, view("value\n"));
            push_bytes(&mut entry, view(flats[k]));
            host::write_file(view(ct_entry_path(view(ids[k]))), view(entry));
        }
        host::command(u8[][copy_bytes(view("rm")), copy_bytes(view("-f")), deps_path.copy()]);
    }
    for r in results.len() {
        c.ct_done.push(CtDone { key: results[r].key.copy(), res: CTRes { ty: results[r].res.ty, value: results[r].res.value, text: results[r].res.text.copy() } });
    }
    return ();
}
fn run_tier<a, b, d, e>(c: (&a mut C), module: &b [u8], text: &d [u8], key: &e [u8]) -> CTRes {
    if key.len() != 0 {
        for i in c.ct_done.len() {
            if same(view(c.ct_done[i].key), key) {
                r := &c.ct_done[i].res;
                return CTRes { ty: r.ty, value: r.value, text: r.text.copy() };
            }
        }
    }
    // The call's function, for its result type.
    toks := lexer::tokenize(text);
    if (toks.len() < 3) || (toks[0].kind != 1) {
        fail(&mut c, view("a compile-time call is `f(...)` or `module::f(...)`"));
    }
    mut fmod = module.copy();
    mut fname = slice_bytes(text, toks[0].start, toks[0].end);
    if (toks.len() > 2) && (toks[1].kind == 260) && (toks[2].kind == 1) {
        fmod = fname.copy();
        fname = slice_bytes(text, toks[2].start, toks[2].end);
    }
    f := ct_module_names(&mut c, view(fmod), view(fname));
    if f == 0 {
        mut msg = copy_bytes(view("compile-time call to an unknown function `"));
        push_bytes(&mut msg, view(fname));
        msg.push(96);
        fail(&mut c, view(msg));
    }
    ret := c.funcs[f - 1].ret;
    if c.funcs[f - 1].types != 0 {
        fail(&mut c, view("a compile-time call names a generic function; call a function of concrete types"));
    }
    mut rty = 0;
    if is_bool(&mut c, ret) {
        rty = bool_type(&mut c);
    } else if ret == 3 {
        rty = 3;
    } else if ct_seq_elem(&mut c, ret) != NO_TYPE {
        // A vector of integers, or bytes: a table, which is what running code early is for.
        rty = ret;
    } else if static_structured(&mut c, ret) {
        // A record, or a vector of records or strings: printed field by field (static_dump_src).
        rty = ret;
    } else if !integer(&mut c, ret) {
        fail(&mut c, view("a compile-time call must give an integer, a bool, a string, bytes, a vector or a plain record of those (a value the program can hold as data)"));
    } else {
        // The integer's own type, so a signed result keeps its sign and width (it was read back as
        // a u64, and a negative one did not parse).
        rty = ret;
    }
    // A signed element is printed as an i64: `u64(v[i])` is a checked conversion, and stopped the
    // probe on the first negative element.
    mut elem_signed = false;
    if (rty != 0) && (rty != 3) && !is_bool(&mut c, rty) && (ct_seq_elem(&mut c, rty) != NO_TYPE) {
        se := ct_seq_elem(&mut c, rty);
        elem_signed = (ty_kind(&mut c, se) == 18) && (ty_mode(&mut c, se) != 0);
    }
    // The probe: this module's names qualified, the value printed. A named value is read by its
    // name, so the probe reaches it through the same guarded initialisation every other read does
    // and a cycle back to it is seen; an `@f()` in an expression is the call itself.
    mut qualified = ct_qualify(&mut c, module, text);
    if key.len() != 0 {
        qualified = copy_bytes(key);
    }
    mut uses = u8[][];
    uses.push(copy_bytes(module));
    wrappers := ct_probe_wrappers(&mut c, &mut uses);
    mut probe = copy_bytes(view("module grail_probe;\n\n"));
    for u in uses.len() {
        push_bytes(&mut probe, view("use "));
        push_bytes(&mut probe, view(uses[u]));
        push_bytes(&mut probe, view(";\n"));
    }
    push_bytes(&mut probe, view("use host;\n\n"));
    push_bytes(&mut probe, view(wrappers));
    push_bytes(&mut probe, view("fn main() -> u64 {\n    v := "));
    push_bytes(&mut probe, view(qualified));
    if rty == 3 {
        push_bytes(&mut probe, view(";\n    print(v);\n    return 0;\n}\n"));
    } else if static_structured(&mut c, rty) {
        push_bytes(&mut probe, view(";\n"));
        static_dump_src(&mut c, rty, view("v"), 0, &mut probe);
        push_bytes(&mut probe, view("    return 0;\n}\n"));
    } else if elem_signed {
        // One element per line, as a signed word.
        push_bytes(&mut probe, view(";\n    for i in v.len() {\n        println(i64(v[i]));\n    }\n    return 0;\n}\n"));
    } else if (rty != 0) && !is_bool(&mut c, rty) && (ct_seq_elem(&mut c, rty) != NO_TYPE) {
        // One element per line, as an unsigned word.
        push_bytes(&mut probe, view(";\n    for i in v.len() {\n        println(u64(v[i]));\n    }\n    return 0;\n}\n"));
    } else {
        push_bytes(&mut probe, view(";\n    println(v);\n    return 0;\n}\n"));
    }
    mut probe_status = 0;
    printed := ct_probe_exec(&mut c, view(probe), text, key, 0, &mut probe_status);
    if (rty == 3) || static_structured(&mut c, rty) {
        return CTRes { ty: rty, value: 0, text: printed };
    }
    if (rty != 0) && (ct_seq_elem(&mut c, rty) != NO_TYPE) {
        // The elements, laid out at the element's C width (little-endian), for read-only data.
        elem := ct_seq_elem(&mut c, rty);
        width := ffi_field_size(&mut c, elem);
        mut data = u8[];
        mut count = 0;
        mut v: u64 = 0;
        mut digits = 0;
        mut minus = false;
        for i in printed.len() {
            ch := printed[i];
            if (48 <= ch) & (ch <= 57) {
                v = wrapping_add(wrapping_mul(v, 10), u64(ch - 48));
                digits += 1;
            } else if (ch == 45) & (digits == 0) {
                minus = true;
            } else if digits != 0 {
                if minus {
                    // Two's complement, so the low `width` bytes are the element's C bytes.
                    v = wrapping_sub(0, v);
                }
                for b in width {
                    data.push(u8((v >> (8 * b)) & 255));
                }
                count += 1;
                v = 0;
                digits = 0;
                minus = false;
            }
        }
        return CTRes { ty: rty, value: count, text: data };
    }
    mut body = printed.copy();
    while (body.len() > 0) && (body[body.len() - 1] == 10) {
        body.pop()!;
    }
    if (rty != 0) && is_bool(&mut c, rty) {
        return CTRes { ty: rty, value: u64(same(view(body), view("true"))), text: u8[] };
    }
    mut v = 0;
    mut minus = false;
    for i in body.len() {
        if (i == 0) & (body[i] == 45) {
            minus = true;
        } else {
            v = wrapping_add(wrapping_mul(v, 10), u64(body[i] - 48));
        }
    }
    if minus {
        v = wrapping_sub(0, v);
    }
    return CTRes { ty: rty, value: v, text: u8[] };
}
fn ct_list_has_sub<a, b>(text: &a [u8], part: &b [u8]) -> bool {
    mut i = 0;
    while i + part.len() <= text.len() {
        mut hit = true;
        for j in part.len() {
            if text[i + j] != part[j] {
                hit = false;
                break;
            }
        }
        if hit {
            return true;
        }
        i += 1;
    }
    return false;
}
fn slice_bytes<a>(text: &a [u8], start: u64, end: u64) -> u8[] {
    mut out = u8[];
    for i in start..end {
        out.push(text[i]);
    }
    return out;
}
fn path_cat<a, b>(x: &a [u8], y: &b [u8]) -> u8[] {
    mut out = copy_bytes(x);
    push_bytes(&mut out, y);
    return out;
}
// `@for f in fields(T) { ... }` / `@for v in variants(E) { ... }`: the block is compiled once per
// field (or variant), in declaration order, with `f` a compile-time value: `f.name` is its name as a
// string, `f.index` its position, and `x.@f` the field itself. Each copy is type-checked with that
// field's type, so the body may do what the field's type allows. In a generic function checked
// before it is instantiated, `T` has no fields yet: the block is checked in each specialisation.
fn ct_for<a>(c: (&a mut C)) -> unit {
    expect(&mut c, view("for"));
    name := ident(&mut c);
    expect(&mut c, view("in"));
    which := ident(&mut c);
    want_enum := same(view(which), view("variants"));
    if !want_enum & !same(view(which), view("fields")) {
        fail(&mut c, view("@for iterates fields(T) or variants(E)"));
    }
    expect(&mut c, view("("));
    ty := parse_type(&mut c);
    expect(&mut c, view(")"));
    open := c.pos;
    if !is(&mut c, view("{")) {
        fail(&mut c, view("expected { after the @for list"));
    }
    close := block_end(&mut c, open);
    mut t = ty;
    while (t != 0) && (t != NO_TYPE) && (ty_kind(&mut c, t) == 10) {
        t = ty_arg(&mut c, t);
    }
    if (t == NO_TYPE) || (ty_kind(&mut c, t) == 9) {
        exchange(&mut c.pos, close + 1);
        return ();
    }
    k := ty_kind(&mut c, t);
    if k != 8 {
        if want_enum {
            fail(&mut c, view("variants takes an enum type"));
        }
        fail(&mut c, view("fields takes a record type"));
    }
    d := ty_arg(&mut c, t);
    is_enum := c.decls[d].is_enum;
    if want_enum & (is_enum == 0) {
        fail(&mut c, view("variants takes an enum type; use fields for a record"));
    }
    if !want_enum & (is_enum != 0) {
        fail(&mut c, view("fields takes a record type; use variants for an enum"));
    }
    count := c.decls[d].count;
    // The block's tokens are compiled once per field, so a binding whose last use is inside it is
    // still used by the next copy: the same window a run-time loop sets keeps it alive to the end.
    mut start = c.loop_start;
    mut end = c.loop_end;
    if end == 0 {
        start = open;
        end = close;
    }
    old_start := exchange(&mut c.loop_start, start);
    old_end := exchange(&mut c.loop_end, end);
    for i in count {
        c.ct_loop_names.push(name.copy());
        c.ct_loop_decls.push(d);
        c.ct_loop_index.push(i);
        exchange(&mut c.pos, open);
        block(&mut c);
        c.ct_loop_names.pop()!;
        c.ct_loop_decls.pop()!;
        c.ct_loop_index.pop()!;
    }
    exchange(&mut c.loop_start, old_start);
    exchange(&mut c.loop_end, old_end);
    exchange(&mut c.pos, close + 1);
    return ();
}
// The `@for` binding named `name`, innermost first: index + 1, or 0.
fn ct_loop_binding<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    mut i = c.ct_loop_names.len();
    while i > 0 {
        if same(view(c.ct_loop_names[i - 1]), name) {
            return i;
        }
        i -= 1;
    }
    return 0;
}
fn ct_loop_field_name<a>(c: (&a mut C), b: u64) -> u8[] {
    d := c.ct_loop_decls[b - 1];
    first := c.decls[d].first;
    return c.fields[first + c.ct_loop_index[b - 1]].name.copy();
}
// `NAME := expr;` at module level: a compile-time constant with its type inferred - u64 for an
// integer, bool for a bool, string for a text literal. The typed spelling is `const NAME: T = expr;`.
fn module_binding<a>(c: (&a mut C), pass: u64) -> unit {
    mut at_name = c.pos;
    name := ident(&mut c);
    declared := position_text(&mut c, at_name);
    advance(&mut c);
    if pass != 1 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        advance(&mut c);
        return ();
    }
    module := module_copy(&mut c);
    refuse_duplicate_constant(&mut c, view(module), view(name), at_name);
    mut ty = 0;
    mut value = 0;
    mut text = u8[];
    if ct_call_ahead(&mut c) {
        // `NAME := f(...);`: the run tier (C3). The call is evaluated when the constant is first
        // used - by then every function's signature is known - by compiling and running a probe.
        text = ct_take_call_text(&mut c);
        expect(&mut c, view(";"));
        c.ct_calls.push(CtCall { module: module.copy(), name: name.copy(), text: text.copy(), is_static: 0 });
        constant_public := c.decl_public;
        c.constants.push(Constant { module: module, name: name, declared_at: declared, file: c.file, at: at_name,  public: constant_public, ty: CT_PENDING, value: 0, text: text });
        return ();
    }
    if kind(&mut c) == 3 {
        ty = 3;
        text = decode_literal(&mut c, c.pos);
        advance(&mut c);
    } else {
        if kind(&mut c) == 5 {
            fail(&mut c, view("a float constant needs its type: const NAME: f64 = 1.5;"));
        }
        v := ct_expr(&mut c, 0);
        if v.ty == ct_tag_ty() {
            fail(&mut c, view("a target tag is not a value a program can hold; compare it in @if"));
        }
        value = v.value;
        if is_bool(&mut c, v.ty) {
            ty = bool_type(&mut c);
        }
    }
    expect(&mut c, view(";"));
    constant_public := c.decl_public;
    c.constants.push(Constant { module: module, name: name, declared_at: declared, file: c.file, at: at_name,  public: constant_public, ty: ty, value: value, text: text });
    return ();
}
fn constant_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("const"));
    mut at_name = c.pos;
    name := ident(&mut c);
    declared := position_text(&mut c, at_name);
    expect(&mut c, view(":"));
    // Registered in the first pass, so a module-level `@if` and every later declaration can fold
    // against it.
    if pass != 1 {
        while !is(&mut c, view(";")) {
            advance(&mut c);
        }
        advance(&mut c);
        return ();
    }
    ty := parse_type(&mut c);
    expect(&mut c, view("="));
    module := module_copy(&mut c);
    refuse_duplicate_constant(&mut c, view(module), view(name), at_name);
    negative := u64(eat(&mut c, view("-")));
    here := c.pos;
    k := kind(&mut c);
    mut value = 0;
    mut text = u8[];
    if negative != 0 && k == 5 {
        if !is_float(&mut c, ty) {
            fail(&mut c, view("float constant needs type f64 or f32"));
        }
        t := tok_text(&mut c, here);
        fp := float_precision(&mut c, ty);
        bits := float_bits_p(&mut c, view(t), fp);
        advance(&mut c);
        expect(&mut c, view(";"));
        item_public_10 := c.decl_public;
        c
            .constants
            .push(
                Constant {
                    public: item_public_10,
                    module: module,
                    name: name, declared_at: declared, file: c.file, at: at_name, 
                    ty: ty,
                    value: bits ^ 9223372036854775808,
                    text: text,
                }
            );
        return ();
    }
    if (k == 2) & (negative != 0) {
        t := tok_text(&mut c, here);
        value = literal_value(&mut c, view(t));
        advance(&mut c);
        if (ty != 0) & (ty_kind(&mut c, ty) != 18) {
            fail(&mut c, view("integer constant needs an integer type"));
        }
        if literal_fits(&mut c, ty, value, negative) == 0 {
            fail(&mut c, view(literal_range_msg_v(&mut c, ty, value, negative)));
        }
        value = wrapping_sub(0, value);
    } else if (k != 5) & (k != 3) & (negative == 0) {
        // A compile-time constant expression: literals, other constants, size_of, align_of,
        // target, arithmetic, comparisons.
        v := ct_expr(&mut c, 0);
        value = v.value;
        if is_bool(&mut c, ty) {
            if !is_bool(&mut c, v.ty) {
                exchange(&mut c.pos, here);
                fail(&mut c, view("bool constant needs a bool value"));
            }
        } else {
            if (ty != 0) & (ty_kind(&mut c, ty) != 18) {
                exchange(&mut c.pos, here);
                fail(&mut c, view("constants must be integer, float, bool or text"));
            }
            if (v.ty != 0) {
                exchange(&mut c.pos, here);
                fail(&mut c, view("integer constant needs an integer value"));
            }
            if literal_fits(&mut c, ty, value, 0) == 0 {
                exchange(&mut c.pos, here);
                fail(&mut c, view("constant value out of range for its type"));
            }
        }
    } else {
        if negative != 0 {
            fail(&mut c, view("only integer constants can be negative"));
        }
        if k == 5 {
            if !is_float(&mut c, ty) {
                fail(&mut c, view("float constant needs type f64 or f32"));
            }
            t := tok_text(&mut c, here);
            fp := float_precision(&mut c, ty);
            value = float_bits_p(&mut c, view(t), fp);
            advance(&mut c);
        } else {
            if k == 3 {
                if ty != 3 {
                    fail(&mut c, view("text constant needs type string"));
                }
                text = decode_literal(&mut c, here);
                advance(&mut c);
            } else {
                if is(&mut c, view("true")) || is(&mut c, view("false")) {
                    if !is_bool(&mut c, ty) {
                        fail(&mut c, view("bool constant needs type bool"));
                    }
                    value = u64(is(&mut c, view("true")));
                    advance(&mut c);
                } else {
                    fail(&mut c, view("constants must be integer, float, bool or text literals"));
                }
            }
        }
    }
    expect(&mut c, view(";"));
    constant_public := c.decl_public;
    c.constants.push(Constant { module: module, name: name, declared_at: declared, file: c.file, at: at_name,  public: constant_public, ty: ty, value: value, text: text });
    return ();
}
fn constant_value<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> Val {
    if c.probe_mode != 0 {
        // In a probe a module binding the probe has not been told is computed where it is read,
        // by the value function the probe defines - never by another probe.
        for i in c.constants.len() {
            if same(view(c.constants[i].module), module) && same(view(c.constants[i].name), name) && (c.constants[i].ty == CT_PENDING) {
                pty := ct_pending_type(&mut c, i);
                if is_type_id(pty) {
                    if c.constants[i].public == 0 {
                        home := c.constants[i].module.copy();
                        require_visible(&mut c, view(home), name);
                    }
                    t := static_probe_init(&mut c, module, name, view(""), 0, pty);
                    if (pty == 3) || (pty == 2) || ((pty != 0) && (ct_seq_elem(&mut c, pty) != NO_TYPE)) || static_structured(&mut c, pty) {
                        return own(&mut c, t, pty);
                    }
                    return val(t, pty);
                }
            }
        }
    }
    if c.probe_mode == 0 {
        resolve_pending_named(&mut c, module, name);
    }
    for i in c.constants.len() {
        k := &c.constants[i];
        if same(view(k.module), view(module)) & same(view(k.name), view(name)) {
            ty := k.ty;
            value := k.value;
            text := k.text.copy();
            kpublic := k.public;
            khome := k.module.copy();
            if kpublic == 0 {
                require_visible(&mut c, view(khome), view(name));
            }
            if (ty != 3) && (ty != 0) && (ct_seq_elem(&mut c, ty) != NO_TYPE) {
                // A compile-time table: its elements in read-only data, copied into a fresh vector
                // at each use (as a string constant is).
                elem := ct_seq_elem(&mut c, ty);
                l := label(&mut c);
                rodata(&mut c);
                o(&mut c, view(".balign 8\n"));
                mark(&mut c, l);
                for j in text.len() {
                    o(&mut c, view(".byte "));
                    on(&mut c, text[j]);
                    c.out.push(10);
                }
                o(&mut c, view(".byte 0\n.popsection\nleaq "));
                lname(&mut c, l);
                o(&mut c, view("(%rip),%rax\n"));
                ptr := save(&mut c);
                e := carray_elem_of(&mut c, elem);
                mut args = u64[ptr];
                args.push(imm(&mut c, value));
                for j in 4 {
                    args.push(imm(&mut c, e[j]));
                }
                t := invoke(&mut c, view("rt_carray_load"), args);
                return own(&mut c, t, ty);
            }
            if ty == 3 {
                l := label(&mut c);
                rodata(&mut c);
                mark(&mut c, l);
                for j in text.len() {
                    o(&mut c, view(".byte "));
                    on(&mut c, text[j]);
                    c.out.push(10);
                }
                o(&mut c, view(".byte 0\n.popsection\nleaq "));
                lname(&mut c, l);
                o(&mut c, view("(%rip),%rax\n"));
                ptr := save(&mut c);
                n := imm(&mut c, text.len());
                mut f = "rt_string_lit";
                if utf8_well_formed(&text) {
                    f = "rt_lit";
                }
                t := invoke(&mut c, view(f), two(ptr, n));
                return own(&mut c, t, 3);
            }
            return val(imm(&mut c, value), ty);
        }
    }
    return val(0, NO_TYPE);
}
// ---- module statics: the baked tier (docs/design/module-values.md, stage 1) ------------------------
//
// `static NAME: T = init;` is one object at one address. The first pass registers the name, the
// second its declared type (every read needs only that and the symbol), the third checks the type
// rules, computes the value and emits it as read-only data in the declaring module's part, under a
// global symbol. A scalar is a word; a string or a vector of integers is a real object behind
// block headers in state 2, which rt_free leaves alone, so a read borrows it and never copies it.
fn static_symbol<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u8[] {
    mut out = u8[];
    if c.plat == 1 {
        out.push(95);
    }
    push_bytes(&mut out, view("s_"));
    push_bytes(&mut out, m);
    out.push(95);
    push_bytes(&mut out, n);
    return out;
}
// In a compile-time probe, whether `m::n` is the static whose value the probe is computing.
fn static_pending_here<a, b>(m: &a [u8], n: &b [u8]) -> bool {
    mut key = copy_bytes(m);
    push_bytes(&mut key, view("::"));
    push_bytes(&mut key, n);
    pending := host::env(view("GRAIL_COMPTIME_PENDING"));
    return ct_list_has(view(pending), view(key));
}
fn static_guard_symbol<a, b>(m: &a [u8], n: &b [u8]) -> u8[] {
    mut out = copy_bytes(view("g_"));
    push_bytes(&mut out, m);
    out.push(95);
    push_bytes(&mut out, n);
    return out;
}
// Inside a probe, the code a read of run-tier value `m::n` runs first: for a static (`memo` 1) its
// guard says whether it is done; if not, the value function the probe defines computes it into
// the static's word. For a module binding (`memo` 0) the value is computed at every read, as a
// constant is a value at every use, and the guard only marks "being computed". A read that finds
// it being computed is a cycle: the probe says which (grail_cycle__) and stops.
fn static_probe_init<a, b, d, e>(c: (&a mut C), m: &b [u8], n: &d [u8], sym: &e [u8], memo: u64, ty: u64) -> u64 {
    guard := static_guard_symbol(m, n);
    tag := ct_value_tag(m, n);
    mut value_fn = copy_bytes(view("grail_value__"));
    push_bytes(&mut value_fn, view(tag));
    mut cycle_fn = copy_bytes(view("grail_cycle__"));
    push_bytes(&mut cycle_fn, view(tag));
    value_sym := mangle_name(&mut c, view("grail_probe"), view(value_fn));
    cycle_sym := mangle_name(&mut c, view("grail_probe"), view(cycle_fn));
    done := label(&mut c);
    start := label(&mut c);
    if memo == 0 {
        o(&mut c, view(".comm "));
        o(&mut c, view(guard));
        o(&mut c, view(",8,8\n"));
    }
    o(&mut c, view("movq "));
    o(&mut c, view(guard));
    o(&mut c, view("(%rip),%rax\n"));
    if memo != 0 {
        o(&mut c, view("cmpq $2,%rax\n"));
        jump(&mut c, view("je"), done);
    }
    o(&mut c, view("cmpq $1,%rax\n"));
    jump(&mut c, view("jne"), start);
    said := invoke(&mut c, view(cycle_sym), u64[]);
    exchange(&mut c.static_scratch, said);
    stop := invoke(&mut c, view("rt_comptime_cycle"), u64[]);
    exchange(&mut c.static_scratch, stop);
    mark(&mut c, start);
    o(&mut c, view("movq $1,"));
    o(&mut c, view(guard));
    o(&mut c, view("(%rip)\n"));
    mut t = 0;
    if framed(&mut c, ty) {
        // A plain record comes back as a result does (save_result); the static's word holds a box
        // of its own, which word_reference reads as the record.
        dest := call_dest(&mut c, ty);
        if dest != 0 {
            get(&mut c, dest, view("%rdi"));
        }
        call_out(&mut c, view(value_sym));
        t = save_result(&mut c, ty);
        if memo != 0 {
            t = frame_box(&mut c, t, ty);
        }
    } else {
        t = invoke(&mut c, view(value_sym), u64[]);
    }
    if memo != 0 {
        get(&mut c, t, view("%rax"));
        o(&mut c, view("movq %rax,"));
        o(&mut c, view(sym));
        o(&mut c, view("(%rip)\nmovq $2,"));
    } else {
        o(&mut c, view("movq $0,"));
    }
    o(&mut c, view(guard));
    o(&mut c, view("(%rip)\n"));
    mark(&mut c, done);
    return t;
}
// A read of `m::n`, or a value with type NO_TYPE when no static has that name. A scalar is loaded
// (a copy of the word); anything else is a shared borrow of the object, whose target is storage
// outside every frame - the same external place a borrowed parameter's referent is.
fn static_value<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> Val {
    k := find_static(&mut c, module, name);
    if k == 0 {
        return val(0, NO_TYPE);
    }
    ty := c.statics[k - 1].ty;
    if c.statics[k - 1].public == 0 {
        home := c.statics[k - 1].module.copy();
        require_visible(&mut c, view(home), name);
    }
    if !is_type_id(ty) {
        fail(&mut c, view("internal: a static is read before its type is known"));
    }
    sym := static_symbol(&mut c, module, name);
    if c.probe_mode != 0 {
        static_resolve(&mut c, k - 1);
        if (c.statics[k - 1].state == 2) && (c.statics[k - 1].ready == 0) {
            static_probe_init(&mut c, module, name, view(sym), 1, ty);
        }
    }
    o(&mut c, view("leaq "));
    o(&mut c, view(sym));
    o(&mut c, view("(%rip),%rax\n"));
    if integer(&mut c, ty) || is_bool(&mut c, ty) {
        o(&mut c, view("movq (%rax),%rax\n"));
        word := save(&mut c);
        return val(word, ty);
    }
    // The word's address; a record's reference is the record's own address (word_reference).
    mut slot = save(&mut c);
    slot = word_reference(&mut c, slot, ty);
    rty := reference_type(&mut c, ty, 0);
    own(&mut c, slot, rty);
    if c.raw == 0 {
        holder := place_of(&mut c, slot);
        source := add_external_capture(&mut c, holder, 0, 0);
        set_target(&mut c, slot, source, slot + 1);
    }
    return val(slot, rty);
}
// The baked tier's types: integers, bool, string, and vectors of integers or bytes - exactly the
// values the run tier can bring back as data.
fn static_baked_type<a>(c: (&a mut C), ty: u64) -> bool {
    return static_baked_type_at(&mut c, ty, 0);
}
// ---- baked records and tables of them (module-values stage 4) --------------------------------------
//
// A baked type is an integer, a bool, a string, bytes, a vector of baked types, or a plain record
// (not C-laid-out, not an enum, not opaque, not generic) whose fields are baked types. The run tier
// hands a structured value back as a flat stream the probe prints (static_dump_src) and the
// compiler reads in the same order (static_bake): a number per line (integers signed or unsigned
// as their type is, a bool as 0/1), a string as its length then its bytes, a vector as its length
// then its elements, a record as its fields in declaration order.
fn static_baked_type_at<a>(c: (&a mut C), ty: u64, depth: u64) -> bool {
    if (16 < depth) || !is_type_id(ty) {
        return false;
    }
    if is_float(&mut c, ty) {
        return false;
    }
    if integer(&mut c, ty) || is_bool(&mut c, ty) || (ty == 3) || (ty == 2) {
        return true;
    }
    k := ty_kind(&mut c, ty);
    if k == 6 {
        return static_baked_type_at(&mut c, ty_arg(&mut c, ty), depth + 1);
    }
    if k == 8 {
        d := ty_arg(&mut c, ty);
        if (c.decls[d].is_enum != 0) || (c.decls[d].c_layout != 0) || (c.decls[d].opaque != 0) || (c.decls[d].types != 0) {
            return false;
        }
        first := c.decls[d].first;
        for j in c.decls[d].count {
            fty := c.fields[first + j].ty;
            if !static_baked_type_at(&mut c, fty, depth + 1) {
                return false;
            }
        }
        return true;
    }
    return false;
}
// A baked type the run tier's flat number and text forms do not cover: a record, or a vector whose
// elements are not integers.
fn static_structured<a>(c: (&a mut C), ty: u64) -> bool {
    if !is_type_id(ty) || integer(&mut c, ty) || is_bool(&mut c, ty) || (ty == 3) || (ct_seq_elem(&mut c, ty) != NO_TYPE) {
        return false;
    }
    return static_baked_type_at(&mut c, ty, 0);
}
// Probe source that prints the value of `expr` (of type `ty`) in the flat form static_bake reads.
fn static_dump_src<a, b>(c: (&a mut C), ty: u64, expr: &b [u8], depth: u64, out: (&a mut u8[])) -> unit {
    if is_bool(&mut c, ty) {
        push_bytes(&mut out, view("    if "));
        push_bytes(&mut out, expr);
        push_bytes(&mut out, view(" {\n        println(1);\n    } else {\n        println(0);\n    }\n"));
        return ();
    }
    if integer(&mut c, ty) {
        if (ty != 0) && (ty_mode(&mut c, ty) != 0) {
            push_bytes(&mut out, view("    println(i64("));
        } else {
            push_bytes(&mut out, view("    println(u64("));
        }
        push_bytes(&mut out, expr);
        push_bytes(&mut out, view("));\n"));
        return ();
    }
    if ty == 3 {
        push_bytes(&mut out, view("    println("));
        push_bytes(&mut out, expr);
        push_bytes(&mut out, view(".len());\n    println(\"{}\", "));
        push_bytes(&mut out, expr);
        push_bytes(&mut out, view(");\n"));
        return ();
    }
    mut loopvar = copy_bytes(view("grail_probe_i"));
    decimal(&mut loopvar, depth);
    if (ty == 2) || (ty_kind(&mut c, ty) == 6) {
        mut elem = int_type(&mut c, 8, 0);
        if ty != 2 {
            elem = ty_arg(&mut c, ty);
        }
        push_bytes(&mut out, view("    println("));
        push_bytes(&mut out, expr);
        push_bytes(&mut out, view(".len());\n    for "));
        push_bytes(&mut out, view(loopvar));
        push_bytes(&mut out, view(" in "));
        push_bytes(&mut out, expr);
        push_bytes(&mut out, view(".len() {\n"));
        mut item = copy_bytes(expr);
        item.push(91);
        push_bytes(&mut item, view(loopvar));
        item.push(93);
        static_dump_src(&mut c, elem, view(item), depth + 1, &mut out);
        push_bytes(&mut out, view("    }\n"));
        return ();
    }
    d := ty_arg(&mut c, ty);
    first := c.decls[d].first;
    for j in c.decls[d].count {
        mut field = copy_bytes(expr);
        field.push(46);
        push_bytes(&mut field, view(c.fields[first + j].name));
        fty := c.fields[first + j].ty;
        static_dump_src(&mut c, fty, view(field), depth, &mut out);
    }
    return ();
}
// One number of the flat form, signed or not, and the newline after it.
fn static_read_num<a>(text: &a [u8], at: (&a mut u64)) -> u64 {
    mut v = 0;
    mut minus = false;
    if (*at < text.len()) && (text[*at] == 45) {
        minus = true;
        exchange(at, *at + 1);
    }
    while (*at < text.len()) && (48 <= text[*at]) && (text[*at] <= 57) {
        v = wrapping_add(wrapping_mul(v, 10), u64(text[*at] - 48));
        exchange(at, *at + 1);
    }
    if *at < text.len() {
        exchange(at, *at + 1);
    }
    if minus {
        return wrapping_sub(0, v);
    }
    return v;
}
fn static_quad_label<a>(c: (&a mut C), word: u64, is_label: u64) -> unit {
    o(&mut c, view(".quad "));
    if is_label != 0 {
        lname(&mut c, word);
    } else {
        static_quad(&mut c, word);
    }
    c.out.push(10);
    return ();
}
// The data block and the {data, len, cap} object of a vector or a string whose bytes are `bytes`
// and whose length is `n`, behind static block headers; answers the object's label.
fn static_seq_object<a>(c: (&a mut C), bytes: (&a u8[]), n: u64) -> u64 {
    data := label(&mut c);
    obj := label(&mut c);
    o(&mut c, view(".p2align 4\n.quad 0\n.quad 2\n"));
    mark(&mut c, data);
    for j in bytes.len() {
        o(&mut c, view(".byte "));
        on(&mut c, bytes[j]);
        c.out.push(10);
    }
    o(&mut c, view(".byte 0\n.p2align 4\n.quad 0\n.quad 2\n"));
    mark(&mut c, obj);
    o(&mut c, view(".quad "));
    lname(&mut c, data);
    o(&mut c, view("\n.quad "));
    on(&mut c, n);
    o(&mut c, view("\n.quad "));
    on(&mut c, n);
    c.out.push(10);
    return obj;
}
// Emit one baked value of type `ty` read from the flat form at `at`, nested objects first. Answers
// the word the parent stores: the value itself, or (with `is_label` set) the label of its object.
fn static_bake<a>(c: (&a mut C), ty: u64, text: &a [u8], at: (&a mut u64), is_label: (&a mut u64)) -> u64 {
    if integer(&mut c, ty) || is_bool(&mut c, ty) {
        exchange(is_label, 0);
        return static_read_num(text, &mut at);
    }
    exchange(is_label, 1);
    if ty == 3 {
        n := static_read_num(text, &mut at);
        mut bytes = u8[];
        for j in n {
            if *at + j < text.len() {
                bytes.push(text[*at + j]);
            }
        }
        exchange(at, *at + n + 1);
        return static_seq_object(&mut c, &bytes, n);
    }
    if (ty == 2) || (ty_kind(&mut c, ty) == 6) {
        mut elem = int_type(&mut c, 8, 0);
        if ty != 2 {
            elem = ty_arg(&mut c, ty);
        }
        n := static_read_num(text, &mut at);
        mut bytes = u8[];
        if integer(&mut c, elem) || is_bool(&mut c, elem) {
            mut width = 8;
            if integer(&mut c, elem) && !is_bool(&mut c, elem) {
                e := carray_elem_of(&mut c, elem);
                if e[2] == 3 {
                    width = 1;
                }
                if e[2] == 4 {
                    width = 4;
                }
            }
            for j in n {
                w := static_read_num(text, &mut at);
                for b in width {
                    bytes.push((w >> (8 * b)) & 255);
                }
            }
            return static_seq_object(&mut c, &bytes, n);
        }
        // Elements that are objects themselves: each is emitted first, then the word table. A
        // vector of plain records holds its elements' words inline instead (flat_bytes).
        mut words = u64[];
        mut kinds = u64[];
        flat := (ty_kind(&mut c, base_type(&mut c, elem)) == 8) && framable(&mut c, elem);
        for j in n {
            if flat {
                static_bake_fields(&mut c, base_type(&mut c, elem), text, &mut at, &mut words, &mut kinds);
            } else {
                mut flag = 0;
                w := static_bake(&mut c, elem, text, &mut at, &mut flag);
                words.push(w);
                kinds.push(flag);
            }
        }
        data := label(&mut c);
        obj := label(&mut c);
        o(&mut c, view(".p2align 4\n.quad 0\n.quad 2\n"));
        mark(&mut c, data);
        for j in words.len() {
            static_quad_label(&mut c, words[j], kinds[j]);
        }
        o(&mut c, view(".quad 0\n.p2align 4\n.quad 0\n.quad 2\n"));
        mark(&mut c, obj);
        o(&mut c, view(".quad "));
        lname(&mut c, data);
        o(&mut c, view("\n.quad "));
        on(&mut c, n);
        o(&mut c, view("\n.quad "));
        on(&mut c, n);
        c.out.push(10);
        return obj;
    }
    // A record: its words as the record's layout has them (field_layout) - a word per field, and a
    // plain record held in a field laid inline in its parent's words.
    mut words = u64[];
    mut kinds = u64[];
    static_bake_fields(&mut c, ty, text, &mut at, &mut words, &mut kinds);
    rec := label(&mut c);
    o(&mut c, view(".p2align 4\n.quad 0\n.quad 2\n"));
    mark(&mut c, rec);
    for j in words.len() {
        static_quad_label(&mut c, words[j], kinds[j]);
    }
    if words.len() == 0 {
        o(&mut c, view(".quad 0\n"));
    }
    return rec;
}
// The words of record `ty`, read from the flat form, appended to `words` (with `kinds` saying
// which are labels): a plain record held in a field contributes its own words in place.
fn static_bake_fields<a>(c: (&a mut C), ty: u64, text: &a [u8], at: (&a mut u64), words: (&a mut u64[]), kinds: (&a mut u64[])) -> unit {
    d := ty_arg(&mut c, ty);
    first := c.decls[d].first;
    count := c.decls[d].count;
    for j in count {
        fty := c.fields[first + j].ty;
        if inline_field(&mut c, ty, j) {
            static_bake_fields(&mut c, base_type(&mut c, fty), text, &mut at, &mut words, &mut kinds);
        } else {
            mut flag = 0;
            w := static_bake(&mut c, fty, text, &mut at, &mut flag);
            words.push(w);
            kinds.push(flag);
        }
    }
    return ();
}

fn static_refuse<a, b>(c: (&a mut C), at: u64, msg: &b [u8]) -> unit {
    exchange(&mut c.pos, at);
    fail(&mut c, msg);
}
// What a static may hold (S3): no borrow, a shareable type, and - until the lazy tier exists - a
// type the baked tier can compute.
fn static_type_rules<a>(c: (&a mut C), ty: u64, at: u64) -> unit {
    shown := source_type_name(&mut c, ty);
    k := ty_kind(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) || contains_borrow(&mut c, ty, 0) {
        mut msg = copy_bytes(view("a static cannot hold a borrow: `"));
        push_bytes(&mut msg, view(shown));
        push_bytes(&mut msg, view("` refers to storage some frame owns, and a static outlives every frame; store owned data"));
        static_refuse(&mut c, at, view(msg));
    }
    capability_begin(&mut c);
    mut trail = u64[];
    if transfer_capability(&mut c, ty, 1, &mut trail, 0) == 0 {
        mut msg = copy_bytes(view("a static is reachable from every thread at once, so its type must be shareable, and `"));
        push_bytes(&mut msg, view(shown));
        push_bytes(&mut msg, view("` is not: "));
        cap_denial_text(&mut c, &mut msg);
        static_refuse(&mut c, at, view(msg));
    }
    if is_float(&mut c, ty) {
        static_refuse(&mut c, at, view("a float static is not built yet; use `const NAME: f64 = ...;`"));
    }
    if (ty_kind(&mut c, ty) == 8) && !static_baked_type(&mut c, ty) {
        d := ty_arg(&mut c, ty);
        if (c.decls[d].is_enum != 0) || (c.decls[d].types != 0) {
            mut msg = copy_bytes(view("a static of type `"));
            push_bytes(&mut msg, view(shown));
            push_bytes(&mut msg, view("` is not built yet: the baked tier holds integers, bools, strings, and vectors and plain (non-generic) records of those; an enum or a generic record is not one of them yet"));
            static_refuse(&mut c, at, view(msg));
        }
    }
    if !static_baked_type(&mut c, ty) {
        mut msg = copy_bytes(view("a static of type `"));
        push_bytes(&mut msg, view(shown));
        push_bytes(&mut msg, view("` needs code run while the program runs (the lazy tier), which is not built yet: a static is an integer, a bool, a string, or a vector or plain record of those, computed while compiling"));
        static_refuse(&mut c, at, view(msg));
    }
    return ();
}
fn static_quad<a>(c: (&a mut C), value: u64) -> unit {
    if value >= 9223372036854775808 {
        o(&mut c, view("-"));
        on(&mut c, wrapping_sub(0, value));
    } else {
        on(&mut c, value);
    }
    return ();
}
// The storage of static `i`, in its module's part. `ready` is 0 only inside the probe computing
// this static: its storage exists so the probe links, and every read of it stops the probe.
fn static_emit<a, b>(c: (&a mut C), i: u64, ready: u64, value: u64, text: &b [u8]) -> unit {
    module := c.statics[i].module.copy();
    name := c.statics[i].name.copy();
    ty := c.statics[i].ty;
    unit := unit_module(&mut c, view(module));
    part(&mut c, view(unit));
    sym := static_symbol(&mut c, view(module), view(name));
    if ready == 0 {
        // A probe's run-tier static: a writable word the first read fills, and its guard
        // (0 not started, 1 being computed, 2 done).
        o(&mut c, view(".pushsection .data\n.p2align 3\n.globl "));
        o(&mut c, view(sym));
        o(&mut c, view("\n"));
        o(&mut c, view(sym));
        o(&mut c, view(":\n.quad 0\n"));
        guard := static_guard_symbol(view(module), view(name));
        o(&mut c, view(".globl "));
        o(&mut c, view(guard));
        o(&mut c, view("\n"));
        o(&mut c, view(guard));
        o(&mut c, view(":\n.quad 0\n.popsection\n"));
        return ();
    }
    if c.plat == 1 {
        o(&mut c, view(".pushsection __DATA,__const\n"));
    } else {
        o(&mut c, view(".pushsection .rodata\n"));
    }
    if integer(&mut c, ty) || is_bool(&mut c, ty) {
        o(&mut c, view(".p2align 3\n.globl "));
        o(&mut c, view(sym));
        o(&mut c, view("\n"));
        o(&mut c, view(sym));
        o(&mut c, view(":\n.quad "));
        static_quad(&mut c, value * ready);
        o(&mut c, view("\n.popsection\n"));
        return ();
    }
    if static_structured(&mut c, ty) {
        // A record or a table of objects: every nested object first, then the static's word.
        mut word = 0;
        mut flag = 0;
        if ready != 0 {
            mut at = 0;
            word = static_bake(&mut c, ty, text, &mut at, &mut flag);
        }
        o(&mut c, view(".p2align 3\n.globl "));
        o(&mut c, view(sym));
        o(&mut c, view("\n"));
        o(&mut c, view(sym));
        o(&mut c, view(":\n"));
        static_quad_label(&mut c, word, flag);
        o(&mut c, view(".popsection\n"));
        return ();
    }
    // The object's bytes as the runtime lays a vector out: one byte per u8, four per 32-bit
    // element, a word for everything else. The run tier hands a table back in C layout.
    mut bytes = u8[];
    mut n = 0;
    if ready != 0 {
        if ty == 3 {
            n = text.len();
            for j in text.len() {
                bytes.push(text[j]);
            }
        } else {
            elem := ct_seq_elem(&mut c, ty);
            e := carray_elem_of(&mut c, elem);
            size := e[0];
            signed := e[1];
            mut width = 8;
            if e[2] == 3 {
                width = 1;
            }
            if e[2] == 4 {
                width = 4;
            }
            n = value;
            for j in n {
                mut w = 0;
                for b in size {
                    w = w | (u64(text[j * size + b]) << (8 * b));
                }
                if (signed != 0) && (size < 8) && (((w >> (8 * size - 1)) & 1) != 0) {
                    w = w | wrapping_sub(0, 1 << (8 * size));
                }
                for b in width {
                    bytes.push((w >> (8 * b)) & 255);
                }
            }
        }
    }
    data := label(&mut c);
    obj := label(&mut c);
    o(&mut c, view(".p2align 4\n.quad 0\n.quad 2\n"));
    mark(&mut c, data);
    for j in bytes.len() {
        o(&mut c, view(".byte "));
        on(&mut c, bytes[j]);
        c.out.push(10);
    }
    o(&mut c, view(".byte 0\n.p2align 4\n.quad 0\n.quad 2\n"));
    mark(&mut c, obj);
    o(&mut c, view(".quad "));
    lname(&mut c, data);
    o(&mut c, view("\n.quad "));
    on(&mut c, n);
    o(&mut c, view("\n.quad "));
    on(&mut c, n);
    o(&mut c, view("\n.p2align 3\n.globl "));
    o(&mut c, view(sym));
    o(&mut c, view("\n"));
    o(&mut c, view(sym));
    o(&mut c, view(":\n.quad "));
    lname(&mut c, obj);
    o(&mut c, view("\n.popsection\n"));
    return ();
}
fn static_skip_item<a>(c: (&a mut C)) -> unit {
    while !is(&mut c, view(";")) {
        if kind(&mut c) == 0 {
            fail(&mut c, view("expected `;` after a static's initialiser"));
        }
        advance(&mut c);
    }
    advance(&mut c);
    return ();
}
// What the prover may take as known about static `i`: `kind` 1 with an integer static's value (one
// the prover's integer reading holds: not negative, below 2^62), 2 with a string's or vector's
// length, or 0. Evaluates the static's initialiser if nothing has yet.
fn static_fact<a>(c: (&a mut C), i: u64, kind: (&a mut u64), fact: (&a mut u64)) -> unit {
    exchange(kind, 0);
    exchange(fact, 0);
    if c.statics[i].imported != 0 {
        exchange(kind, c.statics[i].fact_kind);
        exchange(fact, c.statics[i].fact);
        return ();
    }
    static_resolve(&mut c, i);
    if (c.statics[i].state != 2) || (c.statics[i].ready == 0) {
        return ();
    }
    ty := c.statics[i].ty;
    value := c.statics[i].value;
    if integer(&mut c, ty) && !is_bool(&mut c, ty) {
        if value < 4611686018427387904 {
            exchange(kind, 1);
            exchange(fact, value);
        }
        return ();
    }
    if ty == 3 {
        exchange(kind, 2);
        exchange(fact, c.statics[i].text.len());
        return ();
    }
    if ct_seq_elem(&mut c, ty) != NO_TYPE {
        exchange(kind, 2);
        exchange(fact, value);
        return ();
    }
    if (ty == 2) || (ty_kind(&mut c, ty) == 6) {
        // A table of objects: its printed form starts with its length.
        text := c.statics[i].text.copy();
        mut at = 0;
        exchange(kind, 2);
        exchange(fact, static_read_num(view(text), &mut at));
    }
    return ();
}
// The prover's literal for a name in this module that is a known number: an integer static's value
// or, with `len`, a string or vector static's length; without `len`, also an integer constant's
// value. Empty when the name is none of those. A static never changes and a constant is its value,
// so the term means one number everywhere in the body.
fn pv_known_literal<a, b>(c: (&a mut C), name: &b [u8], len: bool) -> u8[] {
    if find_local(&mut c, name) != 0 {
        return u8[];
    }
    m := module_copy(&mut c);
    st := find_static(&mut c, view(m), name);
    if st != 0 {
        mut kind = 0;
        mut fact = 0;
        static_fact(&mut c, st - 1, &mut kind, &mut fact);
        if ((kind == 1) && !len) || ((kind == 2) && len) {
            return decimal_bytes(fact);
        }
        return u8[];
    }
    if len {
        return u8[];
    }
    k := find_constant(&mut c, view(m), name);
    if k != 0 {
        ty := c.constants[k - 1].ty;
        value := c.constants[k - 1].value;
        if is_type_id(ty) && integer(&mut c, ty) && !is_bool(&mut c, ty) && (value < 4611686018427387904) {
            return decimal_bytes(value);
        }
    }
    return u8[];
}
fn static_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(&mut c, view("static"));
    at_name := c.pos;
    name := ident(&mut c);
    module := module_copy(&mut c);
    if pass == 1 {
        if same(view(name), view("mut")) {
            static_refuse(&mut c, at_name, view("`static mut` does not exist: a static is immutable, because every thread can read it; put the part that changes in a Mutex or an Atomic"));
        }
        if is(&mut c, view("<")) {
            fail(&mut c, view("a static cannot be generic: it is one object at one address"));
        }
        if !is(&mut c, view(":")) {
            fail(&mut c, view("a static needs its type: `static NAME: T = value;`"));
        }
        refuse_duplicate_constant(&mut c, view(module), view(name), at_name);
        declared := position_text(&mut c, at_name);
        static_public := c.decl_public;
        c.statics.push(
            Static {
                module: module.copy(),
                name: name.copy(),
                declared_at: declared,
                file: c.file,
                at: at_name,
                public: static_public,
                ty: NO_TYPE,
                imported: 0,
                init_at: 0,
                state: 0,
                ready: 0,
                value: 0,
                text: u8[],
                fact_kind: 0,
                fact: 0
            }
        );
        static_skip_item(&mut c);
        return ();
    }
    i := find_static(&mut c, view(module), view(name)) - 1;
    expect(&mut c, view(":"));
    if is(&mut c, view("&")) {
        static_refuse(&mut c, at_name, view("a static cannot hold a borrow: a reference refers to storage some frame owns, and a static outlives every frame; store owned data"));
    }
    ty := parse_type(&mut c);
    if pass == 2 {
        exchange(&mut c.statics[i].ty, ty);
        if !is(&mut c, view("=")) {
            fail(&mut c, view("a static needs an initialiser: `static NAME: T = value;`"));
        }
        exchange(&mut c.statics[i].init_at, c.pos + 1);
        if kind_at(&mut c, c.pos + 1) == 64 {
            advance(&mut c);
            advance(&mut c);
            if ct_call_ahead(&mut c) {
                call := ct_take_call_text(&mut c);
                c.ct_calls.push(CtCall { module: module.copy(), name: name.copy(), text: call, is_static: 1 });
            }
        }
        static_skip_item(&mut c);
        return ();
    }
    static_resolve(&mut c, i);
    value := c.statics[i].value;
    text := c.statics[i].text.copy();
    ready := c.statics[i].ready;
    static_emit(&mut c, i, ready, value, view(text));
    static_skip_item(&mut c);
    return ();
}
// Evaluate static `i`'s initialiser once, where it is written: at its declaration in the third pass,
// or earlier when the prover, an interface or the function cache asks for its value first. The
// type rules run first, so a refusal reads the same whichever asks. The value is kept on the entry.
fn static_resolve<a>(c: (&a mut C), i: u64) -> unit {
    if (c.statics[i].imported != 0) || (c.statics[i].state != 0) || (c.statics[i].init_at == 0) {
        return ();
    }
    exchange(&mut c.statics[i].state, 1);
    file := c.statics[i].file;
    saved_file := c.file;
    saved_pos := c.pos;
    if file != saved_file {
        load_file(&mut c, file);
        exchange(&mut c.file, file);
    }
    module := c.statics[i].module.copy();
    // The initialiser's names are its module's: a constant it reads (`PAGE - 1`) is looked up in
    // the static's module, whoever asks for the value - the interface writer runs after the last
    // module has been read, so the current module is then someone else's.
    saved_module := exchange(&mut c.module, module.copy());
    name := c.statics[i].name.copy();
    ty := c.statics[i].ty;
    at_name := c.statics[i].at;
    static_type_rules(&mut c, ty, at_name);
    exchange(&mut c.pos, c.statics[i].init_at);
    init := c.pos;
    mut value = 0;
    mut text = u8[];
    mut ready = 1;
    k := kind(&mut c);
    if k == 64 {
        advance(&mut c);
        if !ct_call_ahead(&mut c) {
            fail(&mut c, view("`@` on a static's initialiser takes a call: `static TABLE: u64[] = @build();`"));
        }
        call := ct_take_call_text(&mut c);
        after_call := c.pos;
        mut key = module.copy();
        push_bytes(&mut key, view("::"));
        push_bytes(&mut key, view(name));
        if c.probe_mode != 0 {
            // Inside a probe a run-tier static is computed by the probe itself, on first read
            // (static_value): no probe starts another.
            ready = 0;
        } else {
            exchange(&mut c.pos, init);
            r := run_tier(&mut c, view(module), view(call), view(key));
            if r.ty != ty {
                mut msg = copy_bytes(view("static `"));
                push_bytes(&mut msg, view(name));
                push_bytes(&mut msg, view("` is declared `"));
                push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
                push_bytes(&mut msg, view("`, and `@"));
                push_bytes(&mut msg, view(call));
                push_bytes(&mut msg, view("` gives `"));
                push_bytes(&mut msg, view(source_type_name(&mut c, r.ty)));
                push_bytes(&mut msg, view("`"));
                static_refuse(&mut c, init, view(msg));
            }
            value = r.value;
            text = r.text;
            exchange(&mut c.pos, after_call);
        }
    } else if k == 3 {
        if ty != 3 {
            mut msg = copy_bytes(view("a string literal initialises a `string` static; this one is `"));
            push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
            push_bytes(&mut msg, view("`"));
            fail(&mut c, view(msg));
        }
        text = decode_literal(&mut c, c.pos);
        advance(&mut c);
    } else if k == 5 {
        fail(&mut c, view("a float static is not built yet; use `const NAME: f64 = ...;`"));
    } else if ct_call_ahead(&mut c) {
        fail(&mut c, view("this call would run when the program runs: a static with a run-time initialiser is the lazy tier, which is not built yet; write `@f(...)` to compute it while compiling"));
    } else {
        if !(integer(&mut c, ty) || is_bool(&mut c, ty)) {
            mut msg = copy_bytes(view("a `"));
            push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
            push_bytes(&mut msg, view("` static is computed by a call: `static NAME: T = @build();`"));
            fail(&mut c, view(msg));
        }
        if eat(&mut c, view("-")) {
            if (kind(&mut c) != 2) || !integer(&mut c, ty) {
                fail(&mut c, view("only an integer literal can be negated in a static's initialiser"));
            }
            t := tok_text(&mut c, c.pos);
            v := literal_value(&mut c, view(t));
            if literal_fits(&mut c, ty, v, 1) == 0 {
                fail(&mut c, view(literal_range_msg_v(&mut c, ty, v, 1)));
            }
            advance(&mut c);
            value = wrapping_sub(0, v);
        } else {
            v := ct_expr(&mut c, 0);
            if v.ty == ct_tag_ty() {
                static_refuse(&mut c, init, view("a target tag is not a value a program can hold; compare it in @if"));
            }
            if is_bool(&mut c, ty) != is_bool(&mut c, v.ty) {
                mut msg = copy_bytes(view("static `"));
                push_bytes(&mut msg, view(name));
                push_bytes(&mut msg, view("` is declared `"));
                push_bytes(&mut msg, view(source_type_name(&mut c, ty)));
                push_bytes(&mut msg, view("`, and its initialiser is not"));
                static_refuse(&mut c, init, view(msg));
            }
            if integer(&mut c, ty) && (literal_fits(&mut c, ty, v.value, 0) == 0) {
                exchange(&mut c.pos, init);
                fail(&mut c, view(literal_range_msg_v(&mut c, ty, v.value, 0)));
            }
            value = v.value;
        }
    }
    expect(&mut c, view(";"));
    exchange(&mut c.statics[i].value, value);
    exchange(&mut c.statics[i].text, text);
    exchange(&mut c.statics[i].ready, ready);
    exchange(&mut c.statics[i].state, 2);
    exchange(&mut c.module, saved_module);
    if file != saved_file {
        load_file(&mut c, saved_file);
        exchange(&mut c.file, saved_file);
    }
    exchange(&mut c.pos, saved_pos);
    return ();
}
// 1 when `path` is in a directory that also holds core.grl: the standard-library directory in
// the repository (lib/) and in every installed layout (std/). Both separators are accepted.
fn in_std_dir<a>(path: &a [u8]) -> u64 {
    mut cut = 0;
    mut found = 0;
    for i in path.len() {
        if (path[i] == 47) || (path[i] == 92) {
            cut = i + 1;
            found = 1;
        }
    }
    mut probe = u8[];
    if found != 0 {
        for i in cut {
            probe.push(path[i]);
        }
    }
    name := "core.grl";
    for i in name.len() {
        probe.push(name[i]);
    }
    return host::exists(view(probe));
}
// ---- module roots: the compiler resolves `use` (docs/design/module-resolution.md) ---------------
//
// `use NAME;` names a module. Until this existed every module of a program had to be named on the
// command line, so every driver had to guess the set by scanning `use` lines itself - and a guess
// that missed a transitive import surfaced as an unknown type inside somebody else's module. The
// compiler now closes the set: a name the command line does not provide is looked for as
// `ROOT/NAME.grl` in every module root, in order, and the file that answers is compiled after the
// command line's own. The closure is a queue, so a chain of imports resolves transitively, and a
// name enters the set before its own `use` lines are read, so a cycle ends instead of looping.
//
// A source's header - its `module` line and its `use` lines - is scanned before anything is parsed,
// when the module set is computed. `header_of` reads only that region of the text.
struct Header {
    module: u8[],
    uses: u8[][]
}
fn hdr_skip_space<a>(text: &a [u8], from: u64, end: u64) -> u64 {
    mut i = from;
    while i < end {
        if (text[i] == 32) || (text[i] == 9) {
            i += 1;
        } else {
            break;
        }
    }
    return i;
}
fn hdr_word<a>(text: &a [u8], from: u64, end: u64) -> u8[] {
    mut i = from;
    mut out = u8[];
    while i < end {
        ch := text[i];
        ok := ((ch >= 97) & (ch <= 122))
            | ((ch >= 65) & (ch <= 90))
            | ((ch >= 48) & (ch <= 57))
            | (ch == 95);
        if !ok {
            break;
        }
        out.push(ch);
        i += 1;
    }
    return out;
}
// The header of one source: the module it declares (empty when it declares none, which only the
// entry file may do) and the module names its `use` lines name. A `use NAME::item;` line names
// module `NAME`: the scan stops at the first character that is not in an identifier, which is `:`.
fn header_of<a>(text: &a [u8]) -> Header {
    mut h = Header { module: u8[], uses: u8[][] };
    mut pos: u64 = 0;
    mut stop = false;
    while (pos < text.len()) & !stop {
        mut end = pos;
        while end < text.len() {
            if text[end] == 10 {
                break;
            }
            end += 1;
        }
        a := hdr_skip_space(text, pos, end);
        if a < end {
            if text[a] == 47 {
                // `//` comment: not a header item, and nothing else in a header starts with `/`.
            } else {
                w := hdr_word(text, a, end);
                if same(view(w), view("use")) {
                    b := hdr_skip_space(text, a + w.len(), end);
                    name := hdr_word(text, b, end);
                    if name.len() != 0 {
                        h.uses.push(name);
                    }
                } else if same(view(w), view("module")) {
                    b := hdr_skip_space(text, a + w.len(), end);
                    name := hdr_word(text, b, end);
                    if name.len() != 0 {
                        h.module = name;
                    }
                } else if same(view(w), view("unsafe")) {
                    b := hdr_skip_space(text, a + w.len(), end);
                    w2 := hdr_word(text, b, end);
                    if !same(view(w2), view("module")) {
                        stop = true;
                    } else {
                        s := hdr_skip_space(text, b + w2.len(), end);
                        name := hdr_word(text, s, end);
                        if name.len() != 0 {
                            h.module = name;
                        }
                    }
                } else {
                    // The first item: the header is over.
                    stop = true;
                }
            }
        }
        pos = end + 1;
    }
    return h;
}
// The directory *containing* `path`, separator included, or empty for a bare name.
fn mod_dirname<a>(path: &a [u8]) -> u8[] {
    mut cut = 0;
    mut found = 0;
    for i in path.len() {
        if (path[i] == 47) || (path[i] == 92) {
            cut = i + 1;
            found = 1;
        }
    }
    mut out = u8[];
    if found != 0 {
        for i in cut {
            out.push(path[i]);
        }
    }
    return out;
}
// `dir` with a separator on its end, so a name can be appended without checking again.
fn mod_dir<a>(dir: &a [u8]) -> u8[] {
    mut out = copy_bytes(view(dir));
    if out.len() != 0 {
        last := out[out.len() - 1];
        if (last != 47) & (last != 92) {
            out.push(47);
        }
    }
    return out;
}
fn mod_add_root<a>(c: (&a mut C), dir: &a [u8]) -> unit {
    if dir.len() == 0 {
        return ();
    }
    for i in c.mod_roots.len() {
        if same(view(c.mod_roots[i]), view(dir)) {
            return ();
        }
    }
    c.mod_roots.push(copy_bytes(view(dir)));
    return ();
}
// The file a module name resolves to, or empty: `ROOT/NAME.grl` in the first root that holds it.
fn mod_find<a>(c: (&a C), name: &a [u8]) -> u8[] {
    for i in c.mod_roots.len() {
        mut path = mod_dir(view(c.mod_roots[i]));
        push_bytes(&mut path, view(name));
        push_bytes(&mut path, view(".grl"));
        if host::exists(view(path)) != 0 {
            return path;
        }
    }
    return u8[];
}
fn mod_known<a>(c: (&a C), name: &a [u8]) -> bool {
    for i in c.mod_names.len() {
        if same(view(c.mod_names[i]), view(name)) {
            return true;
        }
    }
    return false;
}
// `--use DIR` answers for this module already: its interface is in DIR, so its source is not added.
fn mod_from_iface<a>(c: (&a C), name: &a [u8]) -> bool {
    if c.iface_use.len() == 0 {
        return false;
    }
    if c.iface_only_on != 0 {
        mut named = false;
        for i in c.iface_only.len() {
            if same(view(c.iface_only[i]), view(name)) {
                named = true;
            }
        }
        if !named {
            return false;
        }
    }
    path := iface_join(view(c.iface_use), view(name), view(".iface"));
    return host::exists(view(path)) != 0;
}
// Where `use NAME` is written in `text`: the offset of NAME on a line that starts with `use` (after
// indentation), or the length of `text` when no such line is there.
fn use_offset<a, b>(text: &a [u8], name: &b [u8]) -> u64 {
    mut at = 0;
    while at < text.len() {
        mut i = at;
        while (i < text.len()) && ((text[i] == 32) || (text[i] == 9)) {
            i += 1;
        }
        if (i + 4 + name.len() <= text.len()) && same(view(text[i: i + 4]), view("use ")) {
            mut j = i + 4;
            while (j < text.len()) && (text[j] == 32) {
                j += 1;
            }
            if (j + name.len() <= text.len()) && same(view(text[j: j + name.len()]), view(name)) {
                after := j + name.len();
                if (after == text.len()) || !use_name_byte(text[after]) {
                    return j;
                }
            }
        }
        while (at < text.len()) && (text[at] != 10) {
            at += 1;
        }
        at += 1;
    }
    return text.len();
}
fn use_name_byte(b: u8) -> bool {
    return ((97 <= b) && (b <= 122)) || ((65 <= b) && (b <= 90)) || ((48 <= b) && (b <= 57)) || (b == 95);
}
// A `use` line no root answers for. The message names the module and every root that was searched,
// and points at the `use` line in the file that asked, so it reads as the error it is - a module name
// the program got wrong - rather than as the driver failing. The behaviour it replaces was an unknown
// type inside a module the reader did not write.
fn unresolved_module<a>(c: (&a mut C), name: &a [u8], from: &a [u8], text: &a [u8]) -> unit {
    mut msg = u8[];
    push_bytes(&mut msg, view("cannot resolve module `"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("` used by "));
    push_bytes(&mut msg, view(from));
    if c.mod_roots.len() == 0 {
        push_bytes(&mut msg, view(": no module root was given (--module-root DIR), and "));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view(" is not named on the command line"));
    } else {
        push_bytes(&mut msg, view(": no module root holds `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view(".grl`; searched "));
        for i in c.mod_roots.len() {
            if i != 0 {
                push_bytes(&mut msg, view(", "));
            }
            push_bytes(&mut msg, view(c.mod_roots[i]));
        }
    }
    at := use_offset(view(text), view(name));
    if at == text.len() {
        fail_option(&mut c, view(msg));
        return ();
    }
    source := text.copy();
    here := diag_pos(&source, at);
    width := diag_digits(here.line);
    exchange(&mut c.src, source);
    o(&mut c, view("error: "));
    o(&mut c, view(msg));
    c.out.push(10);
    for i in width {
        c.out.push(32);
    }
    o(&mut c, view("--> "));
    o(&mut c, view(from));
    c.out.push(58);
    on(&mut c, here.line);
    c.out.push(58);
    on(&mut c, here.column);
    c.out.push(10);
    diag_gutter(&mut c, width);
    c.out.push(10);
    diag_excerpt(&mut c, width, &here, name.len(), 94, view("no module root holds this module"));
    host::print(view(c.out));
    host::exit(1);
    return ();
}
// The module set of a program: the command line's own files, then every module their `use` lines
// reach through the roots. `mod_base` is how many arguments the command line gave, which is where
// the added files start, so a file's index stays the argument index it always was.
fn resolve_modules<a>(c: (&a mut C), offset: u64) -> unit {
    base := host::argc() - offset;
    exchange(&mut c.mod_base, base);
    if base < 3 {
        return ();
    }
    if c.separate != 0 {
        // One part of a build whose module set is already settled (the per-module shape): every module
        // the program has is another part, so resolving `use` here would compile a module into this
        // part that the build also compiles into its own. The driver names the whole set (it asks with
        // `--print-inputs`), and a part whose `use` is not in it is a build error, not a new module.
        return ();
    }
    // The roots, in the order `use` lines are tried against them: `--module-root DIR` as given (the
    // option loop added those already), then the stdlib layout the command line itself names - a file
    // beside core.grl is a standard module, so its directory is a std root (`in_std_dir`) - and then
    // the project's own `src/`, when the working directory holds a grail.toml.
    mut i = 2;
    while i < base {
        path := host::arg(i + offset);
        if in_std_dir(view(path)) != 0 {
            dir := mod_dirname(view(path));
            mod_add_root(&mut c, view(dir));
        }
        i += 1;
    }
    if host::exists(view("grail.toml")) != 0 {
        mod_add_root(&mut c, view("src"));
    }
    // The command line's files open the set: their declared names are what a `use` line resolves to,
    // so naming a module explicitly is never wrong - it only stops being necessary.
    mut queue = u8[][];
    i = 2;
    while i < base {
        path := host::arg(i + offset);
        if host::exists(view(path)) == 0 {
            // A missing input is `load_file`'s error to report, with its name.
            i += 1;
            continue;
        }
        text := host::read_file(view(path));
        h := header_of(view(text));
        mut name = h.module.copy();
        // The entry file is the one file that may omit its `module` line: index 2, or index 3 in a
        // compile-time probe, where the probe's own synthesized file comes first (toplevel's rule).
        entry_at := 2 + c.probe_mode;
        if (i == entry_at) & (name.len() == 0) {
            name = "main".copy();
        }
        if name.len() != 0 {
            c.mod_names.push(name);
        }
        queue.push(path.copy());
        i += 1;
    }
    // `core` is part of every program that has it: `Some(x)` and `None` lower to its constructors.
    // It is the one name asked for without a `use` line, and a root with no core.grl has no core.
    if !mod_known(&c, view("core")) {
        found := mod_find(&c, view("core"));
        if found.len() != 0 {
            c.mod_names.push(copy_bytes(view("core")));
            queue.push(found.copy());
            c.mod_files.push(found);
        }
    }
    mut k = 0;
    while k < queue.len() {
        file := queue[k].copy();
        k += 1;
        text := host::read_file(view(file));
        h := header_of(view(text));
        for j in h.uses.len() {
            name := h.uses[j];
            // `use host;` is a module's opt-in to the ambient host:: interface, not a file, and a
            // name that is already in the set is that module: no second file is read for it.
            if same(view(name), view("host")) | mod_known(&c, view(name)) {
                continue;
            }
            if mod_from_iface(&c, view(name)) {
                c.mod_names.push(name.copy());
                continue;
            }
            found := mod_find(&c, view(name));
            if found.len() == 0 {
                unresolved_module(&mut c, view(name), view(file), view(text));
                return ();
            }
            // In the set before its own `use` lines are read: that is what ends a cycle.
            c.mod_names.push(name.copy());
            c.mod_files.push(found.copy());
            queue.push(found);
        }
    }
    return ();
}
// The path of the `index`-th input: the command line's own argument, or one of the files the roots
// added above. A file an interface carried is a virtual input and keeps its own numbering.
fn input_path<a>(c: (&a C), index: u64) -> u8[] {
    if 1000000 <= index {
        return c.virt_path[index - 1000000].copy();
    }
    if index < c.mod_base {
        return host::arg(index + c.arg_offset);
    }
    return c.mod_files[index - c.mod_base].copy();
}
// `--print-inputs FILE`: every file this run reads and the module it declares, one `NAME PATH` line
// each, and nothing built. A driver that has to group a program by module - a per-module build asks
// which modules the program is made of - gets the answer from the compiler that resolves them instead
// of keeping a second copy of the rule.
fn print_inputs<a>(c: (&a mut C), count: u64) -> unit {
    mut out = u8[];
    mut i = 2;
    while i < count {
        path := input_path(&c, i);
        text := host::read_file(view(path));
        h := header_of(view(text));
        mut name = h.module.copy();
        if name.len() == 0 {
            // Only the entry file may omit its `module` line (the parser's rule), and it is `main`.
            name = copy_bytes(view("main"));
        }
        push_bytes(&mut out, view(name));
        out.push(9);
        push_bytes(&mut out, view(path));
        out.push(10);
        i += 1;
    }
    if host::write_file(view(c.mod_list_file), view(out)) != 0 {
        fail_option(&mut c, view("cannot write the input list"));
    }
    return ();
}

// Modules that declared `use host;`. Recorded per module so a replayed generic body is checked
// against its defining module, not against whichever file was parsed last.
fn host_opted<a, b>(c: (&a C), m: &b [u8]) -> bool {
    for i in c.host_modules.len() {
        if same(view(c.host_modules[i]), view(m)) {
            return true;
        }
    }
    return false;
}
fn toplevel<a>(c: (&a mut C), pass: u64) -> unit {
    // `unsafe module m;` is the trusted-module hatch. A leading `unsafe` before anything else is an
    // item's own hatch (`unsafe fn`, `unsafe struct ...`), so only `unsafe` + `module` is read here.
    mut raw = 0;
    if is(&mut c, view("unsafe")) {
        if is_at(&mut c, c.pos + 1, view("module")) {
            advance(&mut c);
            raw = 1;
        }
    }
    exchange(&mut c.raw, raw);
    mut m = "main".copy();
    if eat(&mut c, view("module")) {
        m = ident(&mut c);
        expect(&mut c, view(";"));
    } else {
        entry_file := (c.file == 2) || ((c.file == 3) & (c.probe_mode != 0));
        if !entry_file || raw != 0 {
            fail(&mut c, view("dependency files require an explicit module"));
        }
    }
    if same(view(m), view("runtime")) {
        if raw == 0 {
            fail(&mut c, view("runtime module must be explicitly unsafe"));
        }
    }
    if raw != 0 {
        // Two trusted modules: the portable runtime, and darwin for the macOS libSystem boundary,
        // which only exists in Mach-O builds.
        if !(same(view(m), view("runtime")) || same(view(m), view("darwin"))) {
            fail(&mut c, view("unsafe module reserved for runtime and darwin"));
        }
        if same(view(m), view("darwin")) & (c.plat == 0) {
            fail(&mut c, view("the darwin module requires a macos-x86_64 or macos-aarch64 target"));
        }
    }
    exchange(&mut c.module, m);
    exchange(&mut c.imports, Import[]);
    exchange(&mut c.host_optin, 0);
    while eat(&mut c, view("use")) {
        m = ident(&mut c);
        // `use host;` (or `use host::name;`) is this module's explicit opt-in to the ambient
        // `host::` interface; --deny-ambient-host refuses host:: references without it.
        if same(view(m), view("host")) {
            exchange(&mut c.host_optin, 1);
            if !host_opted(&c, view(c.module)) {
                c.host_modules.push(module_copy(&mut c));
            }
        }
        if eat(&mut c, view("::")) {
            n := ident(&mut c);
            c.imports.push(Import { module: m, name: n });
        }
        expect(&mut c, view(";"));
    }
    while kind(&mut c) != 0 {
        toplevel_item(&mut c, pass);
    }
    if c.dr_tail.len() != 0 {
        dr_parse_tail(&mut c, pass);
    }
    return ();
}
// One module-level item.
// `@strict;` makes every refinement obligation in this module a compile error, and `@strict` before
// a declaration makes that declaration's (docs/design/refinements.md). Returns 0 when the tokens are
// not this form, 1 when a declaration follows, and 2 when the module form was consumed alone.
fn ref_strict_form<a>(c: (&a mut C)) -> u64 {
    next := c.pos + 1;
    if kind_at(&mut c, next) != 1 {
        return 0;
    }
    word := tok_text(&mut c, next);
    if !same(view(word), view("strict")) {
        return 0;
    }
    advance(&mut c);
    advance(&mut c);
    if eat(&mut c, view(";")) {
        // The mode is kept by module name, so a replayed body is compiled in the mode its module
        // asked for, wherever the replay happens.
        m := module_copy(&mut c);
        if !ref_module_strict(&c, view(m)) {
            c.strict_modules.push(m);
        }
        return 2;
    }
    exchange(&mut c.strict_next, 1);
    return 1;
}
// ---- derives (docs/design/derives.md) --------------------------------------------------------------
//
// `@derive(Eq, Ord, Hash, Clone, Debug)` before a `struct` or an `enum` writes the implementations
// the type would otherwise spell by hand. There is no macro system: the compiler renders fixed Grail
// source for the derives that were asked for, appends it to the file's own text and lets the
// ordinary parser read it, so the generated methods are checked, borrowed and dropped exactly like
// hand-written ones. What makes them field-wise is the comptime `@for` over the type's fields, which
// the generated source carries.
//
// The implementations are the standard library's own interfaces - `ops::Eq`, `order::Ord`,
// `hash::Hash` and `clone::Clone` (lib/clone.grl) - and `Debug` is the inherent `show` the formatter
// already calls, so `println("{}", v)` picks it up with no new mechanism.
fn dr_eq() -> u64 {
    return 1;
}
fn dr_ord() -> u64 {
    return 2;
}
fn dr_hash() -> u64 {
    return 4;
}
fn dr_clone() -> u64 {
    return 8;
}
fn dr_debug() -> u64 {
    return 16;
}
// The bit one derive name asks for, 0 when the name is not a derive.
fn dr_bit<a>(name: &a [u8]) -> u64 {
    if same(view(name), view("Eq")) {
        return dr_eq();
    }
    if same(view(name), view("Ord")) {
        return dr_ord();
    }
    if same(view(name), view("Hash")) {
        return dr_hash();
    }
    if same(view(name), view("Clone")) {
        return dr_clone();
    }
    if same(view(name), view("Debug")) {
        return dr_debug();
    }
    return 0;
}
// The name one derive bit is written as, for a diagnostic.
fn dr_name(bit: u64) -> string {
    if bit == dr_eq() {
        return "Eq";
    }
    if bit == dr_ord() {
        return "Ord";
    }
    if bit == dr_hash() {
        return "Hash";
    }
    if bit == dr_clone() {
        return "Clone";
    }
    return "Debug";
}
// `@derive(Eq, Ord, Hash, Clone, Debug)`: the derives the next declaration asks for. The shape is
// `@strict`'s - no `;` form, further attributes may follow, the next declaration consumes them. 1
// when one was consumed.
fn dr_attr_form<a>(c: (&a mut C)) -> u64 {
    next := c.pos + 1;
    if kind_at(&mut c, next) != 1 {
        return 0;
    }
    word := tok_text(&mut c, next);
    if !same(view(word), view("derive")) {
        return 0;
    }
    at := c.pos;
    if c.derive_pending != 0 {
        fail(&mut c, view("`@derive` is written once: list every derive inside it"));
    }
    advance(&mut c);
    advance(&mut c);
    expect(&mut c, view("("));
    mut bits = 0;
    while true {
        here := c.pos;
        if kind(&mut c) != 1 {
            fail(&mut c, view("`@derive` names derives: Eq, Ord, Hash, Clone or Debug"));
        }
        name := tok_text(&mut c, here);
        bit := dr_bit(view(name));
        if bit == 0 {
            mut msg = copy_bytes(view("unknown derive `"));
            push_bytes(&mut msg, view(name));
            push_bytes(&mut msg, view("`: the derives are Eq, Ord, Hash, Clone and Debug"));
            exchange(&mut c.pos, here);
            fail(&mut c, view(msg));
        }
        if (bits & bit) != 0 {
            mut msg = copy_bytes(view("derive `"));
            push_bytes(&mut msg, view(name));
            push_bytes(&mut msg, view("` is listed twice"));
            exchange(&mut c.pos, here);
            fail(&mut c, view(msg));
        }
        bits = bits | bit;
        advance(&mut c);
        if eat(&mut c, view(")")) {
            break;
        }
        expect(&mut c, view(","));
    }
    exchange(&mut c.derive_pending, bits);
    exchange(&mut c.dr_pos, at);
    return 1;
}
// The interface a derive implements, as the module and name the generated header names: 0 when that
// interface is not part of this build.
fn dr_interface<a, b>(c: (&a mut C), module: &b [u8], name: &b [u8]) -> u64 {
    return find_interface(&c, view(module), view(name));
}
// Whether a field type mentions the type parameter `index`, directly or inside a vector, reference
// or nominal type: the derived implementation has to carry the derive's interface as a bound on
// those parameters only, so a type that never compares one is not restricted by it.
fn dr_uses<a>(c: (&a mut C), ty: u64, index: u64, depth: u64) -> bool {
    if depth > 8 {
        return true;
    }
    k := ty_kind(&mut c, ty);
    if k == 9 {
        return ty_arg(&mut c, ty) == index;
    }
    if (k == 10) || (k == 6) || (k == 7) || (k == 27) || (k == 13) || (k == 14) || (k == 16) || (k == 20) || (k == 29) || (k == 30) || (k == 33) || (k == 35) {
        inner := ty_arg(&mut c, ty);
        if dr_uses(&mut c, inner, index, depth + 1) {
            return true;
        }
    }
    args := type_args(&mut c, ty);
    for i in args.len() {
        t := args[i];
        if dr_uses(&mut c, t, index, depth + 1) {
            return true;
        }
    }
    return false;
}
// The generated implementation headers repeat the declaration's own parameters - its `Send`/`Share`
// classifications, its interface bounds and, on the parameters a field mentions, the interface this
// derive implements - so an instantiation of the type has exactly the constraints it was declared
// with. `iface` names that interface (empty for the inherent `show`, which needs no bound).
fn dr_head<a, b, d>(c: (&a mut C), out: (&b mut u8[]), name: &d [u8], iface: &d [u8], iface_id: u64) -> unit {
    types := c.dr_tnames.len();
    lifes := c.dr_rnames.len();
    push_bytes(&mut out, view("impl"));
    if (types + lifes) != 0 {
        push_bytes(&mut out, view("<"));
        for i in lifes {
            rname := c.dr_rnames[i].copy();
            if i != 0 {
                push_bytes(&mut out, view(", "));
            }
            push_bytes(&mut out, view(rname));
        }
        for i in types {
            if (i != 0) || (lifes != 0) {
                push_bytes(&mut out, view(", "));
            }
            tname := c.dr_tnames[i].copy();
            push_bytes(&mut out, view(tname));
            bits := c.dr_bounds[i];
            mut more = 0;
            if (bits & 1) != 0 {
                push_bytes(&mut out, view(": Send"));
                more = 1;
            }
            if (bits & 2) != 0 {
                if more != 0 {
                    push_bytes(&mut out, view(" + Share"));
                } else {
                    push_bytes(&mut out, view(": Share"));
                }
                more = 1;
            }
            reqs := copy_numbers(&c.dr_constraints[i]);
            for k in reqs.len() {
                id := reqs[k];
                if (id != 0) & (id <= c.interfaces.len()) {
                    imod := c.interfaces[id - 1].module.copy();
                    iname := c.interfaces[id - 1].name.copy();
                    if more != 0 {
                        push_bytes(&mut out, view(" + "));
                    } else {
                        push_bytes(&mut out, view(": "));
                    }
                    push_bytes(&mut out, view(imod));
                    push_bytes(&mut out, view("::"));
                    push_bytes(&mut out, view(iname));
                    more = 1;
                }
            }
            used := c.dr_used[i];
            if (iface_id != 0) & (used != 0) {
                if more != 0 {
                    push_bytes(&mut out, view(" + "));
                } else {
                    push_bytes(&mut out, view(": "));
                }
                push_bytes(&mut out, view(iface));
            }
        }
        push_bytes(&mut out, view(">"));
    }
    push_bytes(&mut out, view(" "));
    if iface.len() != 0 {
        push_bytes(&mut out, view(iface));
        push_bytes(&mut out, view(" for "));
    }
    push_bytes(&mut out, view(name));
    if (types + lifes) != 0 {
        push_bytes(&mut out, view("<"));
        for i in lifes {
            rname := c.dr_rnames[i].copy();
            if i != 0 {
                push_bytes(&mut out, view(", "));
            }
            push_bytes(&mut out, view(rname));
        }
        for i in types {
            tname := c.dr_tnames[i].copy();
            if (i != 0) || (lifes != 0) {
                push_bytes(&mut out, view(", "));
            }
            push_bytes(&mut out, view(tname));
        }
        push_bytes(&mut out, view(">"));
    }
    push_bytes(&mut out, view(" {\n"));
    return ();
}
// The `N`th variant (or field) name of a declaration, and its payload type (unit for a variant with
// no payload and for a record field that has one).
fn dr_field_name<a>(c: (&a mut C), d: u64, index: u64) -> u8[] {
    first := c.decls[d].first;
    return c.fields[first + index].name.copy();
}
fn dr_field_type<a>(c: (&a mut C), d: u64, index: u64) -> u64 {
    return field_ty(&mut c, d, index);
}
// `aN`/`bN`: the payload a match arm binds, and the one the other side's arm binds.
fn dr_bind<a, b>(c: (&a mut C), out: (&b mut u8[]), prefix: &b [u8], index: u64) -> unit {
    push_bytes(&mut out, view(prefix));
    decimal(&mut out, index);
    return ();
}
// One payload comparison for an enum arm. A nominal payload (a record, an enum, a type parameter) is
// reached through a reference, so it compares through its own implementation; a scalar, text or
// bytes payload is compared with the operator the language gives it, and a scalar payload binds by
// value, so the interface form takes its address.
fn dr_eq_payload<a, b>(c: (&a mut C), out: (&b mut u8[]), pty: u64, left: &b [u8], right: &b [u8]) -> unit {
    k := ty_kind(&mut c, pty);
    if (k == 8) || (k == 9) || (k == 10) {
        push_bytes(&mut out, view("ops::Eq::eq("));
        push_bytes(&mut out, view(left));
        push_bytes(&mut out, view(", "));
        push_bytes(&mut out, view(right));
        push_bytes(&mut out, view(")"));
    } else {
        push_bytes(&mut out, view(left));
        push_bytes(&mut out, view(" == "));
        push_bytes(&mut out, view(right));
    }
    return ();
}
fn dr_ord_payload<a, b>(c: (&a mut C), out: (&b mut u8[]), pty: u64, left: &b [u8], right: &b [u8]) -> unit {
    k := ty_kind(&mut c, pty);
    if (k == 8) || (k == 9) || (k == 10) {
        push_bytes(&mut out, view("order::Ord::less("));
        push_bytes(&mut out, view(left));
        push_bytes(&mut out, view(", "));
        push_bytes(&mut out, view(right));
        push_bytes(&mut out, view(")"));
    } else {
        push_bytes(&mut out, view(left));
        push_bytes(&mut out, view(" < "));
        push_bytes(&mut out, view(right));
    }
    return ();
}
// The address a payload binding needs: a scalar binds by value, everything else as a reference to
// the payload.
fn dr_bind_ref<a, b>(c: (&a mut C), out: (&b mut u8[]), pty: u64, name: &b [u8]) -> unit {
    if scalar(&mut c, pty) {
        push_bytes(&mut out, view("&"));
    }
    push_bytes(&mut out, view(name));
    return ();
}
// The implementation `@derive(Eq)` writes: field by field in declaration order, or variant by
// variant with the payloads compared per variant.
fn dr_eq_block<a, b, d>(c: (&a mut C), out: (&b mut u8[]), d: u64, name: &d [u8], is_enum: u64, count: u64) -> unit {
    dr_head(&mut c, &mut out, view(name), view("ops::Eq"), dr_eq());
    push_bytes(&mut out, view("    fn eq(self: &Self, other: &Self) -> bool {\n"));
    if is_enum == 0 {
        push_bytes(&mut out, view("        mut equal = true;\n"));
        push_bytes(&mut out, view("        @for f in fields(Self) {\n"));
        push_bytes(&mut out, view("            if !(self.@f == other.@f) { equal = false; }\n"));
        push_bytes(&mut out, view("        }\n"));
        push_bytes(&mut out, view("        return equal;\n"));
    } else {
        push_bytes(&mut out, view("        match self {\n"));
        for i in count {
            vname := dr_field_name(&mut c, d, i);
            pty := dr_field_type(&mut c, d, i);
            has := pty != 1;
            push_bytes(&mut out, view("            "));
            push_bytes(&mut out, view(vname));
            if has {
                mut a = u8[];
                dr_bind(&mut c, &mut a, view("a"), i);
                push_bytes(&mut out, view("("));
                push_bytes(&mut out, view(a));
                push_bytes(&mut out, view(")"));
            }
            push_bytes(&mut out, view(" => { match other { "));
            for j in count {
                wname := dr_field_name(&mut c, d, j);
                push_bytes(&mut out, view(wname));
                if has {
                    mut b = u8[];
                    dr_bind(&mut c, &mut b, view("b"), j);
                    push_bytes(&mut out, view("("));
                    push_bytes(&mut out, view(b));
                    push_bytes(&mut out, view(")"));
                }
                push_bytes(&mut out, view(" => { return "));
                if i != j {
                    push_bytes(&mut out, view("false"));
                } else if !has {
                    push_bytes(&mut out, view("true"));
                } else {
                    mut a = u8[];
                    dr_bind(&mut c, &mut a, view("a"), i);
                    mut b = u8[];
                    dr_bind(&mut c, &mut b, view("b"), j);
                    dr_eq_payload(&mut c, &mut out, pty, view(a), view(b));
                }
                push_bytes(&mut out, view("; }, "));
            }
            push_bytes(&mut out, view("} },\n"));
        }
        push_bytes(&mut out, view("        }\n"));
    }
    push_bytes(&mut out, view("    }\n}\n"));
    return ();
}
// `@derive(Ord)`: lexicographic over the fields, and over the variants by declaration order first.
fn dr_ord_block<a, b, d>(c: (&a mut C), out: (&b mut u8[]), d: u64, name: &d [u8], is_enum: u64, count: u64) -> unit {
    dr_head(&mut c, &mut out, view(name), view("order::Ord"), dr_ord());
    push_bytes(&mut out, view("    fn less<a, b>(left: (&a Self), right: (&b Self)) -> bool {\n"));
    if is_enum == 0 {
        push_bytes(&mut out, view("        @for f in fields(Self) {\n"));
        push_bytes(&mut out, view("            if left.@f < right.@f { return true; }\n"));
        push_bytes(&mut out, view("            if right.@f < left.@f { return false; }\n"));
        push_bytes(&mut out, view("        }\n"));
        push_bytes(&mut out, view("        return false;\n"));
    } else {
        push_bytes(&mut out, view("        match left {\n"));
        for i in count {
            vname := dr_field_name(&mut c, d, i);
            pty := dr_field_type(&mut c, d, i);
            has := pty != 1;
            push_bytes(&mut out, view("            "));
            push_bytes(&mut out, view(vname));
            if has {
                mut a = u8[];
                dr_bind(&mut c, &mut a, view("a"), i);
                push_bytes(&mut out, view("("));
                push_bytes(&mut out, view(a));
                push_bytes(&mut out, view(")"));
            }
            push_bytes(&mut out, view(" => { match right { "));
            for j in count {
                wname := dr_field_name(&mut c, d, j);
                push_bytes(&mut out, view(wname));
                if has {
                    mut b = u8[];
                    dr_bind(&mut c, &mut b, view("b"), j);
                    push_bytes(&mut out, view("("));
                    push_bytes(&mut out, view(b));
                    push_bytes(&mut out, view(")"));
                }
                push_bytes(&mut out, view(" => { return "));
                if i < j {
                    push_bytes(&mut out, view("true"));
                } else if i > j {
                    push_bytes(&mut out, view("false"));
                } else if !has {
                    push_bytes(&mut out, view("false"));
                } else {
                    mut a = u8[];
                    dr_bind(&mut c, &mut a, view("a"), i);
                    mut b = u8[];
                    dr_bind(&mut c, &mut b, view("b"), j);
                    dr_ord_payload(&mut c, &mut out, pty, view(a), view(b));
                }
                push_bytes(&mut out, view("; }, "));
            }
            push_bytes(&mut out, view("} },\n"));
        }
        push_bytes(&mut out, view("        }\n"));
    }
    push_bytes(&mut out, view("    }\n}\n"));
    return ();
}
// `@derive(Hash)`: every field's hash is written into one `hash::Hasher` in declaration order, and an
// enum writes its variant index first. The fold is the hasher's own - the fields' bytes are the
// stream - so two values that `Eq` reports equal always produce the same stream.
fn dr_hash_block<a, b, d>(c: (&a mut C), out: (&b mut u8[]), d: u64, name: &d [u8], is_enum: u64, count: u64) -> unit {
    dr_head(&mut c, &mut out, view(name), view("hash::Hash"), dr_hash());
    push_bytes(&mut out, view("    fn hash<a, b>(self: (&a Self), state: (&b mut hash::Hasher)) {\n"));
    if is_enum == 0 {
        push_bytes(&mut out, view("        @for f in fields(Self) {\n"));
        push_bytes(&mut out, view("            hash::Hash::hash(&self.@f, state);\n"));
        push_bytes(&mut out, view("        }\n"));
    } else {
        push_bytes(&mut out, view("        match self {\n"));
        for i in count {
            vname := dr_field_name(&mut c, d, i);
            pty := dr_field_type(&mut c, d, i);
            has := pty != 1;
            push_bytes(&mut out, view("            "));
            push_bytes(&mut out, view(vname));
            if has {
                mut a = u8[];
                dr_bind(&mut c, &mut a, view("a"), i);
                push_bytes(&mut out, view("("));
                push_bytes(&mut out, view(a));
                push_bytes(&mut out, view(")"));
            }
            push_bytes(&mut out, view(" => { hash::write_num(state, "));
            decimal(&mut out, i);
            push_bytes(&mut out, view("); "));
            if has {
                push_bytes(&mut out, view("hash::Hash::hash("));
                mut a = u8[];
                dr_bind(&mut c, &mut a, view("a"), i);
                dr_bind_ref(&mut c, &mut out, pty, view(a));
                push_bytes(&mut out, view(", state); "));
            }
            push_bytes(&mut out, view("},\n"));
        }
        push_bytes(&mut out, view("        }\n"));
    }
    push_bytes(&mut out, view("    }\n}\n"));
    return ();
}
// `@derive(Clone)`: a field-wise copy through each field type's own `clone`. A borrowed view has
// nothing to copy into, so it is refused rather than shared.
fn dr_clone_block<a, b, d>(c: (&a mut C), out: (&b mut u8[]), d: u64, name: &d [u8], is_enum: u64, count: u64) -> unit {
    dr_head(&mut c, &mut out, view(name), view("clone::Clone"), dr_clone());
    push_bytes(&mut out, view("    fn clone(self: &Self) -> Self {\n"));
    if is_enum == 0 {
        push_bytes(&mut out, view("        return "));
        push_bytes(&mut out, view(name));
        push_bytes(&mut out, view(" { "));
        for i in count {
            fname := dr_field_name(&mut c, d, i);
            if i != 0 {
                push_bytes(&mut out, view(", "));
            }
            push_bytes(&mut out, view(fname));
            push_bytes(&mut out, view(": self."));
            push_bytes(&mut out, view(fname));
            push_bytes(&mut out, view(".clone()"));
        }
        push_bytes(&mut out, view(" };\n"));
    } else {
        push_bytes(&mut out, view("        match self {\n"));
        for i in count {
            vname := dr_field_name(&mut c, d, i);
            pty := dr_field_type(&mut c, d, i);
            has := pty != 1;
            push_bytes(&mut out, view("            "));
            push_bytes(&mut out, view(vname));
            if has {
                mut a = u8[];
                dr_bind(&mut c, &mut a, view("a"), i);
                push_bytes(&mut out, view("("));
                push_bytes(&mut out, view(a));
                push_bytes(&mut out, view(")"));
            }
            push_bytes(&mut out, view(" => { return "));
            push_bytes(&mut out, view(name));
            push_bytes(&mut out, view("::"));
            push_bytes(&mut out, view(vname));
            if has {
                push_bytes(&mut out, view("(clone::Clone::clone("));
                mut a = u8[];
                dr_bind(&mut c, &mut a, view("a"), i);
                dr_bind_ref(&mut c, &mut out, pty, view(a));
                push_bytes(&mut out, view("))"));
            }
            push_bytes(&mut out, view("; },\n"));
        }
        push_bytes(&mut out, view("        }\n"));
    }
    push_bytes(&mut out, view("    }\n}\n"));
    return ();
}
// `@derive(Debug)`: a `debug::Debug` implementation that renders the value as
// `Name { field: value, ... }` (and a variant as `Name(payload)`), plus the inherent `show` the
// formatter already calls - so `println("{}", v)` and `v.debug()` are the same text. The body
// concatenates text instead of using `format`, because a generic field's `.debug()` is only known
// to be text once the type is instantiated.
fn dr_debug_block<a, b, d>(c: (&a mut C), out: (&b mut u8[]), d: u64, name: &d [u8], is_enum: u64, count: u64) -> unit {
    dr_head(&mut c, &mut out, view(name), view("debug::Debug"), dr_debug());
    push_bytes(&mut out, view("    fn debug(self: &Self) -> string {\n"));
    if is_enum == 0 {
        push_bytes(&mut out, view("        return format(\""));
        push_bytes(&mut out, view(name));
        push_bytes(&mut out, view(" {{ "));
        for i in count {
            fname := dr_field_name(&mut c, d, i);
            if i != 0 {
                push_bytes(&mut out, view(", "));
            }
            push_bytes(&mut out, view(fname));
            push_bytes(&mut out, view(": {}"));
        }
        push_bytes(&mut out, view(" }}\", "));
        for i in count {
            fname := dr_field_name(&mut c, d, i);
            if i != 0 {
                push_bytes(&mut out, view(", "));
            }
            push_bytes(&mut out, view("self."));
            push_bytes(&mut out, view(fname));
            push_bytes(&mut out, view(".debug()"));
        }
        push_bytes(&mut out, view(");\n"));
    } else {
        push_bytes(&mut out, view("        match self {\n"));
        for i in count {
            vname := dr_field_name(&mut c, d, i);
            pty := dr_field_type(&mut c, d, i);
            has := pty != 1;
            push_bytes(&mut out, view("            "));
            push_bytes(&mut out, view(vname));
            mut a = u8[];
            if has {
                dr_bind(&mut c, &mut a, view("a"), i);
                push_bytes(&mut out, view("("));
                push_bytes(&mut out, view(a));
                push_bytes(&mut out, view(")"));
            }
            push_bytes(&mut out, view(" => { return "));
            if !has {
                push_bytes(&mut out, view("\""));
                push_bytes(&mut out, view(vname));
                push_bytes(&mut out, view("\".text()"));
            } else {
                push_bytes(&mut out, view("format(\""));
                push_bytes(&mut out, view(vname));
                push_bytes(&mut out, view("({})\", "));
                push_bytes(&mut out, view(a));
                push_bytes(&mut out, view(".debug())"));
            }
            push_bytes(&mut out, view("; },\n"));
        }
        push_bytes(&mut out, view("        }\n"));
    }
    push_bytes(&mut out, view("    }\n}\n"));
    // The formatter's own hook: `{}` meets a value of this type, and `show` is what it calls.
    dr_head(&mut c, &mut out, view(name), view(""), 0);
    push_bytes(&mut out, view("    fn show(self: &Self) -> string {\n"));
    push_bytes(&mut out, view("        return debug::Debug::debug(self);\n"));
    push_bytes(&mut out, view("    }\n}\n"));
    return ();
}
// The derives a declaration asked for, checked against its fields where the impl table is complete.
// A missing implementation names the field (or variant) and its type, because a silent omission
// would make `==` or `hash` quietly wrong.
fn dr_check<a>(c: (&a mut C), d: u64, bits: u64) -> unit {
    name := c.decls[d].name.copy();
    is_enum := c.decls[d].is_enum;
    count := c.decls[d].count;
    mut where_ = u8[];
    if is_enum != 0 {
        push_bytes(&mut where_, view("variant"));
    } else {
        push_bytes(&mut where_, view("field"));
    }
    mut every = 0;
    if (bits & dr_eq()) != 0 {
        every = dr_eq();
    }
    if (bits & dr_ord()) != 0 {
        every = every | dr_ord();
    }
    if (bits & dr_hash()) != 0 {
        every = every | dr_hash();
    }
    if (bits & dr_clone()) != 0 {
        every = every | dr_clone();
    }
    if (bits & dr_debug()) != 0 {
        every = every | dr_debug();
    }
    if count == 0 {
        dr_fail(&mut c, view(name), every, view(""), view(""), view(""), view("the type has no fields or variants to derive from"));
        return ();
    }
    if (bits & dr_eq()) != 0 {
        if dr_interface(&mut c, view("ops"), view("Eq")) == 0 {
            dr_need_module(&mut c, view(name), view("Eq"), view("ops"));
        }
    }
    if (bits & dr_ord()) != 0 {
        if dr_interface(&mut c, view("order"), view("Ord")) == 0 {
            dr_need_module(&mut c, view(name), view("Ord"), view("order"));
        }
    }
    if (bits & dr_hash()) != 0 {
        if dr_interface(&mut c, view("hash"), view("Hash")) == 0 {
            dr_need_module(&mut c, view(name), view("Hash"), view("hash"));
        }
    }
    if (bits & dr_clone()) != 0 {
        if dr_interface(&mut c, view("clone"), view("Clone")) == 0 {
            dr_need_module(&mut c, view(name), view("Clone"), view("clone"));
        }
    }
    if (bits & dr_debug()) != 0 {
        if dr_interface(&mut c, view("debug"), view("Debug")) == 0 {
            dr_need_module(&mut c, view(name), view("Debug"), view("debug"));
        }
    }
    for i in count {
        fname := dr_field_name(&mut c, d, i);
        fty := dr_field_type(&mut c, d, i);
        // A variant with no payload carries nothing to compare, order, hash, clone or print.
        if (is_enum != 0) & (fty == 1) {
            continue;
        }
        ftype := source_type_name(&mut c, fty);
        if (bits & dr_eq()) != 0 {
            if !dr_eq_ok(&mut c, fty, is_enum) {
                if (is_enum != 0) & (ty_kind(&mut c, fty) == 8) {
                    // A payload is reached through a reference, so it compares through its own
                    // implementation rather than the built-in structural comparison.
                    dr_fail(&mut c, view(name), dr_eq(), view(where_), view(fname), view(ftype), view("it has no `ops::Eq` implementation: add `@derive(Eq)` to its type"));
                } else {
                    dr_fail(&mut c, view(name), dr_eq(), view(where_), view(fname), view(ftype), view("it cannot be compared: equality needs a scalar, text, bytes, a record or an enum"));
                }
            }
        }
        if (bits & dr_ord()) != 0 {
            if !dr_ord_ok(&mut c, fty, is_enum) {
                dr_fail(&mut c, view(name), dr_ord(), view(where_), view(fname), view(ftype), view("it has no total order: order a field whose type does, or add `@derive(Ord)` to it"));
            }
        }
        if (bits & dr_hash()) != 0 {
            if !dr_hash_ok(&mut c, fty) {
                dr_fail(&mut c, view(name), dr_hash(), view(where_), view(fname), view(ftype), view("it has no `hash::Hash` implementation: add `@derive(Hash)` to its type"));
            }
        }
        if (bits & dr_clone()) != 0 {
            if !dr_clone_ok(&mut c, fty) {
                if dr_borrowed(&mut c, fty) {
                    dr_fail(&mut c, view(name), dr_clone(), view(where_), view(fname), view(ftype), view("a borrowed view cannot be deep-cloned: `@derive(Clone)` needs owned fields"));
                } else {
                    dr_fail(&mut c, view(name), dr_clone(), view(where_), view(fname), view(ftype), view("it has no `clone::Clone` implementation: add `@derive(Clone)` to its type"));
                }
            }
        }
        if (bits & dr_debug()) != 0 {
            if !dr_debug_ok(&mut c, fty) {
                dr_fail(&mut c, view(name), dr_debug(), view(where_), view(fname), view(ftype), view("it has no `debug::Debug` implementation: add `@derive(Debug)` to its type"));
            }
        }
    }
    return ();
}
fn dr_borrowed<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    return (k == 5) || (k == 7) || (k == 27);
}
// Equality: the operator the language gives the field type. A record or an enum compares
// structurally when it has no implementation, so only a type with no `==` at all is refused here -
// and a variant payload, reached through a reference, needs the implementation.
fn dr_eq_ok<a>(c: (&a mut C), ty: u64, payload: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 9) || (k == 10) {
        return true;
    }
    if (k == 8) {
        if payload == 0 {
            return true;
        }
        id := dr_interface(&mut c, view("ops"), view("Eq"));
        return find_implementation(&mut c, id, ty) != 0;
    }
    if (ty == 0) || (k == 3) || (k == 4) || (k == 18) || (k == 19) || (k == 21) || (k == 22) {
        return true;
    }
    return false;
}
// Order: the built-in orderings, or the field type's own `order::Ord` implementation.
fn dr_ord_ok<a>(c: (&a mut C), ty: u64, payload: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 9) || (k == 10) {
        return true;
    }
    if (k == 8) {
        id := dr_interface(&mut c, view("order"), view("Ord"));
        return find_implementation(&mut c, id, ty) != 0;
    }
    return (ty == 0) || (k == 3) || (k == 4) || (k == 18) || (k == 21);
}
fn dr_hash_ok<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 9) || (k == 10) {
        return true;
    }
    id := dr_interface(&mut c, view("hash"), view("Hash"));
    if id == 0 {
        return true;
    }
    return find_implementation(&mut c, id, ty) != 0;
}
fn dr_clone_ok<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 9) || (k == 10) {
        return true;
    }
    id := dr_interface(&mut c, view("clone"), view("Clone"));
    if id == 0 {
        return true;
    }
    return find_implementation(&mut c, id, ty) != 0;
}
// Formatting: the field type's own `debug::Debug` implementation.
fn dr_debug_ok<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    if (k == 9) || (k == 10) {
        return true;
    }
    id := dr_interface(&mut c, view("debug"), view("Debug"));
    if id == 0 {
        return true;
    }
    return find_implementation(&mut c, id, ty) != 0;
}
// `@derive(NAME)` on `T`: variant `v` has ... . One message shape for every refusal, so the reader
// learns where the derive is, which derive refused and which field it was about.
fn dr_fail<a, b, d, e>(c: (&a mut C), name: &b [u8], bit: u64, where_: &d [u8], field: &e [u8], ty: &e [u8], why: &e [u8]) -> unit {
    mut msg = copy_bytes(view("`@derive("));
    push_bytes(&mut msg, view(dr_name(bit)));
    push_bytes(&mut msg, view(")` on `"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("`"));
    if field.len() != 0 {
        push_bytes(&mut msg, view(": "));
        push_bytes(&mut msg, view(where_));
        push_bytes(&mut msg, view(" `"));
        push_bytes(&mut msg, view(field));
        push_bytes(&mut msg, view("`"));
        if ty.len() != 0 {
            push_bytes(&mut msg, view(" of type `"));
            push_bytes(&mut msg, view(ty));
            push_bytes(&mut msg, view("`"));
        }
        push_bytes(&mut msg, view(": "));
    } else {
        push_bytes(&mut msg, view(": "));
    }
    push_bytes(&mut msg, view(why));
    fail(&mut c, view(msg));
    return ();
}
fn dr_need_module<a, b, d>(c: (&a mut C), name: &b [u8], bit_name: &d [u8], module: &d [u8]) -> unit {
    mut msg = copy_bytes(view("`@derive("));
    push_bytes(&mut msg, view(bit_name));
    push_bytes(&mut msg, view(")` on `"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("` needs the `"));
    push_bytes(&mut msg, view(module));
    push_bytes(&mut msg, view("` module in the build: pass its file (`lib/"));
    push_bytes(&mut msg, view(module));
    push_bytes(&mut msg, view(".grl`)"));
    fail(&mut c, view(msg));
    return ();
}
// The generated source becomes part of the file it was asked for: it is appended to the file's own
// text and parsed, in the same pass and by the same parser, right after the file's own items. Every
// later load of that file returns the same bytes, so a token position recorded in one pass still
// names the same text in the next - which is what a generic body replayed from its file needs.
fn dr_append<a>(c: (&a mut C), text: u8[]) -> unit {
    push_bytes(&mut c.dr_tail, view(text));
    return ();
}
// Parse the expansions this file's declarations asked for. The text goes onto the end of the file's
// own source, the whole file is lexed again (the prefix is unchanged, so every earlier position is
// still valid) and the parser walks the new tail as ordinary top-level items.
fn dr_parse_tail<a>(c: (&a mut C), pass: u64) -> unit {
    text := exchange(&mut c.dr_tail, u8[]);
    mut before = c.toks.len();
    while before != 0 {
        before = before - 1;
        if kind_at(&mut c, before) == 0 {
            break;
        }
    }
    if c.dr_trace != 0 {
        mut mark = u8[];
        push_bytes(&mut mark, view("// tail pass "));
        decimal(&mut mark, pass);
        push_bytes(&mut mark, view(" before "));
        decimal(&mut mark, before);
        push_bytes(&mut mark, view(" src "));
        decimal(&mut mark, c.src.len());
        push_bytes(&mut mark, view("\n"));
        host::print(view(mark));
    }
    push_bytes(&mut c.src, view(text));
    here := c.file;
    mut held = c.file_text.len();
    while held < here {
        c.file_text.push(u8[]);
        held = held + 1;
    }
    if held == here {
        c.file_text.push(c.src.copy());
    } else {
        push_bytes(&mut c.file_text[here], view(text));
    }
    toks := lexer::tokenize(view(c.src));
    exchange(&mut c.toks, toks);
    exchange(&mut c.pos, before);
    while kind(&mut c) != 0 {
        toplevel_item(&mut c, pass);
    }
    return ();
}
// The whole expansion of one declaration: every derive it asked for, in a fixed order, rendered as
// source and spliced after the declaration.
fn dr_expand<a>(c: (&a mut C), d: u64, bits: u64) -> unit {
    if dr_recorded(&mut c, d) != 0 {
        // Already expanded for this declaration: a file can be walked more than once in a pass,
        // and the expansion belongs to the declaration, not to the walk.
        return ();
    }
    name := c.decls[d].name.copy();
    count := c.decls[d].count;
    is_enum := c.decls[d].is_enum;
    for i in c.dr_bounds.len() {
        if (c.dr_bounds[i] & 4) != 0 {
            mut msg = copy_bytes(view("`@derive` on `"));
            push_bytes(&mut msg, view(name));
            push_bytes(&mut msg, view("`: a value parameter (`@"));
            push_bytes(&mut msg, view(c.dr_tnames[i]));
            push_bytes(&mut msg, view("`) cannot be repeated in a generated implementation"));
            fail(&mut c, view(msg));
        }
    }
    // Each derive implements a standard-library interface, and the generated `impl` names it: a
    // build without that module cannot have the derive, and says which file to add.
    if (bits & dr_eq()) != 0 {
        if dr_interface(&mut c, view("ops"), view("Eq")) == 0 {
            dr_need_module(&mut c, view(name), view("Eq"), view("ops"));
        }
    }
    if (bits & dr_ord()) != 0 {
        if dr_interface(&mut c, view("order"), view("Ord")) == 0 {
            dr_need_module(&mut c, view(name), view("Ord"), view("order"));
        }
    }
    if (bits & dr_hash()) != 0 {
        if dr_interface(&mut c, view("hash"), view("Hash")) == 0 {
            dr_need_module(&mut c, view(name), view("Hash"), view("hash"));
        }
    }
    if (bits & dr_clone()) != 0 {
        if dr_interface(&mut c, view("clone"), view("Clone")) == 0 {
            dr_need_module(&mut c, view(name), view("Clone"), view("clone"));
        }
    }
    if (bits & dr_debug()) != 0 {
        if dr_interface(&mut c, view("debug"), view("Debug")) == 0 {
            dr_need_module(&mut c, view(name), view("Debug"), view("debug"));
        }
    }
    mut used = u64[];
    for i in c.dr_tnames.len() {
        mut hit = 0;
        for k in count {
            fty := dr_field_type(&mut c, d, k);
            if dr_uses(&mut c, fty, i, 0) {
                hit = 1;
            }
        }
        used.push(hit);
    }
    exchange(&mut c.dr_used, used);
    c.dr_applied.push(d);
    c.dr_applied.push(bits);
    mut out = u8[];
    push_bytes(&mut out, view("\n"));
    if (bits & dr_eq()) != 0 {
        dr_eq_block(&mut c, &mut out, d, view(name), is_enum, count);
    }
    if (bits & dr_ord()) != 0 {
        dr_ord_block(&mut c, &mut out, d, view(name), is_enum, count);
    }
    if (bits & dr_hash()) != 0 {
        dr_hash_block(&mut c, &mut out, d, view(name), is_enum, count);
    }
    if (bits & dr_clone()) != 0 {
        dr_clone_block(&mut c, &mut out, d, view(name), is_enum, count);
    }
    if (bits & dr_debug()) != 0 {
        dr_debug_block(&mut c, &mut out, d, view(name), is_enum, count);
    }
    if c.dr_trace != 0 {
        // `--show-derives`: the source each `@derive` generated, labelled with the declaration it
        // belongs to and the file it was written in.
        mut mark = u8[];
        push_bytes(&mut mark, view("// @derive on "));
        push_bytes(&mut mark, view(name));
        push_bytes(&mut mark, view(" pass "));
        decimal(&mut mark, c.dr_pass);
        push_bytes(&mut mark, view(" ("));
        paths := file_path(&mut c, c.file);
        push_bytes(&mut mark, view(paths));
        push_bytes(&mut mark, view(")\n"));
        host::print(view(mark));
        host::print(view(out));
    }
    dr_append(&mut c, out);
    return ();
}
// The derives a declaration recorded when it was expanded, and the check they imply. A declaration
// without derives answers 0.
fn dr_recorded<a>(c: (&a mut C), d: u64) -> u64 {
    mut i = 0;
    while i < c.dr_applied.len() {
        if c.dr_applied[i] == d {
            return c.dr_applied[i + 1];
        }
        i = i + 2;
    }
    return 0;
}

// ---- checked effects (G26, docs/design/effects.md) ------------------------------------------------
//
// `@no_alloc` and `@no_panic` are claims about a function *and everything it calls*, and the compiler
// proves them rather than trusting them: the facts are recorded where the front end emits the call,
// and settle by a fixpoint over the call graph. Allocation is anything that reaches `rt_alloc` - a
// `push`, a string built by `format`, a record or vector literal, an `alloc` block, a boxed closure,
// an `Rc` - because the runtime's `rt_alloc` is the one place the heap is asked for. The runtime's
// failure path (`rt_abort`, `rt_fail`, `rt_trap`, `rt_refine`, `rt_error`) is a root of the second
// graph: reaching one is what `@no_panic` refuses.
//
// The edges come from the statement the emitter is writing, not from the assembly it wrote.
// `call_out`, `call_proved_out`, `call_slot_out`, `call_dispatch_out` and `call_entry_out` are the
// only places a `call` line is emitted, and each records what the front end knows at that point:
//
// - a direct call records the callee's linker symbol, including the runtime's helpers and a drop
//   helper the compiler itself named;
// - `call *%rax` in user code (a closure, a function value, a `dyn` method slot) records an *unknown*
//   edge, which the solver treats as allocating and failing;
// - the compiler's own dispatch inside trusted code (a closure's drop through the slot its body
//   installed) records nothing: every body it can reach is a body of this build already;
// - a refined parameter's check in the checked entry records an entry fact, not a body edge, because
//   it is the caller's obligation (a caller that proved the predicate answers for it with the proof).
//
// What this buys over reading the emitted text back:
//
// - a check the prover removed is not in the IR at all, so it is not an edge; a scan cannot tell a
//   live call from one inside the bytes the optimizer is about to delete;
// - the callee is the symbol the front end chose, so dispatch the compiler built itself - a vtable's
//   drop slot - is resolved from recorded vtables (`fx_vtable_drop`) instead of a register name;
// - two instances of one generic are two records: the template's claim is the obligation, the
//   instance's own body is what proves it, and the refusal names the instance.
//
// `fx_end` counts the `call` lines in the bytes the body emitted and refuses a body whose count
// disagrees with the calls recorded for it: a call site that bypasses the recording helpers is a
// compiler bug, and a bug here is a silently weaker proof, so it is loud.

// `@no_alloc` and `@no_panic` on a declaration. The shape is `@strict`'s: no `;` form, further
// attributes may follow, and the next declaration consumes them. 1 when one was consumed.
fn fx_attr_form<a>(c: (&a mut C)) -> u64 {
    next := c.pos + 1;
    if kind_at(&mut c, next) != 1 {
        return 0;
    }
    word := tok_text(&mut c, next);
    if same(view(word), view("no_alloc")) {
        advance(&mut c);
        advance(&mut c);
        exchange(&mut c.fx_pending_alloc, 1);
        exchange(&mut c.fx_any, 1);
        return 1;
    }
    if same(view(word), view("no_panic")) {
        advance(&mut c);
        advance(&mut c);
        exchange(&mut c.fx_pending_panic, 1);
        exchange(&mut c.fx_any, 1);
        return 1;
    }
    return 0;
}
// The record of one function symbol: index + 1, appending a fresh one when this is its first mention.
// The record of a symbol already mentioned: index + 1, or 0.
fn fx_find<a, b>(c: (&a mut C), sym: &b [u8]) -> u64 {
    if c.fx_sym_slots.len() == 0 {
        return 0;
    }
    key := name_key(view(""), view(sym));
    mask := c.fx_sym_slots.len() - 1;
    mut h = key & mask;
    while c.fx_sym_slots[h] != 0 {
        i := c.fx_sym_slots[h] - 1;
        if (c.fx_sym_keys[i] == key) && same(view(c.fx_syms[i]), view(sym)) {
            return i + 1;
        }
        h = (h + 1) & mask;
    }
    return 0;
}
fn fx_sym<a, b>(c: (&a mut C), sym: &b [u8]) -> u64 {
    found := fx_find(&mut c, view(sym));
    if found != 0 {
        return found;
    }
    key := name_key(view(""), view(sym));
    index_add(&mut c.fx_sym_slots, &mut c.fx_sym_keys, key);
    c.fx_syms.push(copy_bytes(view(sym)));
    c.fx_body.push(0);
    c.fx_row.push(0);
    c.fx_attr_alloc.push(0);
    c.fx_attr_panic.push(0);
    c.fx_own_alloc.push(0);
    c.fx_own_panic.push(0);
    c.fx_alloc.push(0);
    c.fx_panic.push(0);
    c.fx_alloc_thru.push(0);
    c.fx_panic_thru.push(0);
    c.fx_fn_name.push(u8[]);
    c.fx_fn_file.push(0);
    c.fx_fn_pos.push(0);
    c.fx_entry_panic.push(0);
    return c.fx_syms.len();
}
// The name a diagnostic shows for a specialisation: the template's name and this instance's type
// arguments, so a refusal names `fill<main::File>` rather than the template it came from.
fn fx_instance_name<a, b>(c: (&a mut C), name: &b [u8], spec: u64) -> u8[] {
    mut out = copy_bytes(view(name));
    out.push(60);
    args := type_args_for_spec(&mut c, spec);
    for i in args.len() {
        if i != 0 {
            push_bytes(&mut out, view(", "));
        }
        spelling := source_type_name(&mut c, args[i]);
        push_bytes(&mut out, view(spelling));
    }
    out.push(62);
    return out;
}
// A body starts being recorded: one record per *emitted* body, so a generic's instances are judged
// apart. A specialisation inherits the template's claim - that is the obligation - and its own body
// is what proves or refuses it.
fn fx_begin<a, b, d>(c: (&a mut C), sym: &b [u8], name: &d [u8], file: u64, pos: u64, no_alloc: u64, no_panic: u64) -> unit {
    // Every run that emits code records every body: its facts are the summary its interface carries.
    // A check-only run carries none, so it records only when it has a claim to check.
    if (c.check_only != 0) && (c.fx_any == 0) {
        return ();
    }
    if c.validating != 0 {
        return ();
    }
    k := fx_sym(&mut c, view(sym)) - 1;
    c.fx_body[k] = 1;
    // A retried body starts over: facts from the discarded attempt are not this body's. A row read
    // for the same symbol is replaced by the body: what this run proves is what it answers with.
    c.fx_row[k] = 0;
    c.fx_alloc_thru[k] = 0;
    c.fx_panic_thru[k] = 0;
    c.fx_own_alloc[k] = 0;
    c.fx_own_panic[k] = 0;
    mut display = copy_bytes(view(name));
    mut claim_alloc = no_alloc;
    mut claim_panic = no_panic;
    if c.current_spec != 0 {
        spec := c.current_spec - 1;
        template := c.specs[spec].template;
        // The template's source name, not the specialisation's symbol: the diagnostic says
        // `fill<main::File>`, which is the code the author has to change.
        source := c.funcs[template].name.copy();
        display = fx_instance_name(&mut c, view(source), spec);
        if c.funcs[template].no_alloc != 0 {
            claim_alloc = 1;
        }
        if c.funcs[template].no_panic != 0 {
            claim_panic = 1;
        }
    }
    if claim_alloc != 0 {
        c.fx_attr_alloc[k] = 1;
    }
    if claim_panic != 0 {
        c.fx_attr_panic[k] = 1;
    }
    c.fx_fn_name[k] = display;
    c.fx_fn_file[k] = file;
    c.fx_fn_pos[k] = pos;
    c.fx_entry_panic[k] = 0;
    trusted := c.raw;
    exchange(&mut c.fx_trusted, trusted);
    edges := c.fx_edge_from.len();
    exchange(&mut c.fx_edge_mark, edges);
    exchange(&mut c.fx_calls, 0);
    if trusted != 0 {
        fx_root(&mut c, k, view(sym));
    }
    exchange(&mut c.fx_cur, k + 1);
    return ();
}
// The runtime's own roots: where allocation and failure actually happen. Every other runtime body is
// followed through its calls like user code, so a helper is an allocation exactly when it reaches one.
fn fx_root<a, b>(c: (&a mut C), k: u64, sym: &b [u8]) -> unit {
    mut at = 0;
    if (sym.len() != 0) && (sym[0] == 95) {
        at = 1;
    }
    mut name = u8[];
    for i in sym.len() - at {
        name.push(sym[at + i]);
    }
    if same(view(name), view("rt_alloc")) || same(view(name), view("rt_alloc_unlocked")) || same(view(name), view("rt_grow")) {
        c.fx_own_alloc[k] = 1;
    }
    if same(view(name), view("rt_abort")) || same(view(name), view("rt_fail")) || same(view(name), view("rt_trap")) || same(view(name), view("rt_refine")) || same(view(name), view("rt_error")) {
        c.fx_own_panic[k] = 1;
    }
    return ();
}
// One edge of the body being emitted. `name` empty is a call nothing names - an indirect one in user
// code - and the solver assumes it allocates and fails. `proved` marks a call that entered the
// callee past its parameter checks.
fn fx_edge<a, b>(c: (&a mut C), name: &b [u8], proved: u64) -> unit {
    cur := c.fx_cur;
    if cur == 0 {
        return ();
    }
    c.fx_edge_from.push(cur - 1);
    c.fx_edge_name.push(copy_bytes(view(name)));
    c.fx_edge_to.push(0);
    mut kind = proved;
    if c.fx_trusted != 0 {
        kind = kind | 4;
    }
    c.fx_edge_kind.push(kind);
    f := c.file;
    p := c.pos;
    c.fx_edge_file.push(f);
    c.fx_edge_pos.push(p);
    c.fx_edge_why.push(u8[]);
    return ();
}
// Say why the edge just recorded names no callee. Called by the indirect call sites, which are the
// ones that know what the target is; the solver turns it into the refusal's reason.
fn fx_why<a, b>(c: (&a mut C), why: &b [u8]) -> unit {
    last := c.fx_edge_why.len();
    if last == 0 {
        return ();
    }
    c.fx_edge_why[last - 1] = copy_bytes(view(why));
    return ();
}
// The edge list back to where a body started: an attempt whose bytes were discarded does not get to
// leave its calls behind for the attempt that replaces them.
fn fx_edges_truncate<a>(c: (&a mut C), mark: u64) -> unit {
    while mark < c.fx_edge_from.len() {
        c.fx_edge_from.pop()!;
        c.fx_edge_name.pop()!;
        c.fx_edge_to.pop()!;
        c.fx_edge_kind.pop()!;
        c.fx_edge_file.pop()!;
        c.fx_edge_pos.pop()!;
        c.fx_edge_why.pop()!;
    }
    return ();
}
// A `call` line the emitter writes that is not an edge, counted so the consistency check in `fx_end`
// still sees it.
fn fx_called<a>(c: (&a mut C)) -> unit {
    n := c.fx_calls;
    c.fx_calls = n + 1;
    return ();
}
// A direct call: recorded as an edge, then emitted. This is the only place a direct `call` line is
// written, so the record cannot disagree with the code.
fn call_out<a, b>(c: (&a mut C), callee: &b [u8]) -> unit {
    fx_edge(&mut c, view(callee), 0);
    fx_called(&mut c);
    o(&mut c, view("call "));
    if (c.trap_next != 0) && same(view(callee), view("rt_abort")) {
        exchange(&mut c.trap_next, 0);
        o(&mut c, view("rt_trap"));
    } else {
        o(&mut c, callee);
    }
    c.out.push(10);
    return ();
}
// A check this build does not emit and a trapping build does (integer overflow under
// `--overflow=wrap`): the edge is recorded without a `call` line, so `@no_panic` is judged as if
// the operation could trap and both builds accept the same functions (docs/design/refinements.md,
// "`@no_panic` and the other effects").
fn fx_would_trap<a, b>(c: (&a mut C), callee: &b [u8]) -> unit {
    fx_edge(&mut c, view(callee), 0);
    return ();
}
// A direct call whose arguments proved every refinement of the callee's parameters: it calls the
// body, `<callee>.proved`, which checks nothing, so it costs what a call to a function with no
// predicate costs. (An earlier second entry was a byte copy of the prologue taken before the
// optimiser rewrote it, and restored callee-saved registers it had never saved; the body is now a
// function of its own and the checks live in the wrapper, ref_wrapper.)
fn call_proved_out<a, b>(c: (&a mut C), callee: &b [u8]) -> unit {
    mut target = copy_bytes(view(callee));
    push_bytes(&mut target, view(".proved"));
    fx_edge(&mut c, view(target), 8);
    fx_called(&mut c);
    o(&mut c, view("call "));
    o(&mut c, view(target));
    c.out.push(10);
    return ();
}
// An indirect call in user code: `text` is the instruction (`call *%rax`, an import thunk). Nothing
// names what it reaches, so it is an unknown edge.
// "interface `Shape`" for a call through a `dyn` receiver: the interface the vtable belongs to, so a
// refusal names the contract instead of saying that something unknown was called.
fn iface_reason<a>(c: (&a mut C), iface: u64) -> u8[] {
    mut out = copy_bytes(view("interface `"));
    if (0 < iface) & (iface <= c.interfaces.len()) {
        push_bytes(&mut out, view(c.interfaces[iface - 1].name));
        if c.interfaces[iface - 1].module.len() != 0 {
            push_bytes(&mut out, view("` of module `"));
            push_bytes(&mut out, view(c.interfaces[iface - 1].module));
        }
    } else {
        push_bytes(&mut out, view("?"));
    }
    push_bytes(&mut out, view("`"));
    return out;
}
fn call_slot_out<a, b, d>(c: (&a mut C), text: &b [u8], why: &d [u8]) -> unit {
    if same(text, view("call *%rax\n")) {
        indirect_fact(&mut c);
    }
    fx_edge(&mut c, view(""), 0);
    fx_why(&mut c, view(why));
    fx_called(&mut c);
    o(&mut c, text);
    return ();
}
// The LLVM backend's fact for the `call *%rax` about to be emitted (call ABI S6, the six-word form):
// how many argument words it really passes, so the lifter passes `poison` for the rest instead of
// whatever the other argument registers hold. Only when load_call_args set this call up and no call
// was emitted since (its words are then exactly these); keyed by the call's ordinal among the
// function's `call *%rax` lines, counted in the text as the lifter counts them.
fn indirect_fact<a>(c: (&a mut C)) -> unit {
    words := exchange(&mut c.pending_words, 0);
    if (c.backend == 0) || (c.validating != 0) || (c.facts_fn.len() == 0) || (words == 0) || (c.target != 0) {
        return ();
    }
    if text_has_call(&c, c.pending_at) {
        return ();
    }
    ord := text_count(&c, c.fn_text_at, view("call *%rax\n"));
    mut n = words - 1;
    if (n != 0) && (c.forge_indirect.len() != 0) && same(view(c.forge_indirect), view(c.facts_fn)) {
        n -= 1;
    }
    llvm::fact_indirect(&mut c.facts, copy_bytes(view(c.facts_fn)), ord, n);
    return ();
}
fn text_has_call<a>(c: (&a C), from: u64) -> bool {
    return text_count(&c, from, view("call")) != 0;
}
// How many times `pat` starts a line of the text from `from` on.
fn text_count<a, b>(c: (&a C), from: u64, pat: &b [u8]) -> u64 {
    mut n = 0;
    mut i = from;
    while i + pat.len() <= c.out.len() {
        if ((i == 0) || (c.out[i - 1] == 10)) && (c.out[i] == pat[0]) {
            mut k = 1;
            while (k < pat.len()) && (c.out[i + k] == pat[k]) {
                k += 1;
            }
            if k == pat.len() {
                n += 1;
            }
        }
        i += 1;
    }
    return n;
}
// Whether the body being emitted is the runtime's rt_sites_fill, whose one raw call reaches the
// compiler-emitted rt_sites helper.
fn raw_call_is_sites_helper<a>(c: (&a mut C)) -> bool {
    if (c.raw == 0) || (c.fx_cur == 0) || (c.fx_cur > c.fx_syms.len()) {
        return false;
    }
    sym := c.fx_syms[c.fx_cur - 1].copy();
    return same(view(sym), view("rt_sites_fill")) || same(view(sym), view("_rt_sites_fill"));
}
// A call through the import table to a named operating-system function. In the runtime (trusted code)
// it is what a `syscall` instruction is on Linux: the OS does the work, so it neither allocates on the
// Grail heap (whose roots are `rt_alloc` and `rt_grow`) nor reaches a Grail failure entry, and it
// records no edge - only the `call` the IR check counts. Anywhere else an imported function is code
// the compiler does not see, and stays an unknown edge (docs/design/effects.md).
fn call_import_out<a, b>(c: (&a mut C), text: &b [u8]) -> unit {
    if c.raw == 0 {
        call_slot_out(&mut c, view(text), view("an imported function"));
        return ();
    }
    if c.fx_cur != 0 {
        fx_called(&mut c);
    }
    o(&mut c, text);
    return ();
}
// The compiler's own dispatch inside trusted code (a closure's drop through the slot its own body
// installed): every body it can reach is recorded itself, so it is not an unknown.
fn call_dispatch_out<a, b>(c: (&a mut C), text: &b [u8]) -> unit {
    if c.fx_cur != 0 {
        fx_called(&mut c);
    }
    o(&mut c, text);
    return ();
}
// A refined parameter's check in the checked entry: it is the caller's obligation, so it is an entry
// fact of this body rather than an edge of it.
fn call_entry_out<a, b>(c: (&a mut C), text: &b [u8]) -> unit {
    cur := c.fx_cur;
    if cur != 0 {
        c.fx_entry_panic[cur - 1] = 1;
        fx_called(&mut c);
    }
    o(&mut c, text);
    return ();
}
// A `dyn` value's drop: the vtable's first word. The vtable is the compiler's own, built from the
// entries `register_vtable` recorded, so the slot is resolved to the drop helper of every concrete
// type a vtable of this interface holds - a real edge each, not an unknown. It is deliberately an
// over-approximation: which of them the value is cannot be known, so any of them that allocates or
// fails makes the claim false. A `dyn` value that arrived from another object has no vtable in this
// build, and that single case stays an unknown (docs/design/effects.md, "Limits").
fn fx_vtable_drop<a>(c: (&a mut C), iface: u64) -> unit {
    if c.fx_cur == 0 {
        return ();
    }
    mut found = 0;
    for i in c.vtables.len() / 2 {
        if c.vtables[2 * i] == iface {
            found = 1;
            concrete := c.vtables[2 * i + 1];
            if needs_drop(&mut c, concrete) {
                // Naming the helper is what asks the drop walk for it.
                name := drop_ref_name(&mut c, concrete);
                fx_edge(&mut c, view(name), 0);
            }
        }
    }
    if found == 0 {
        fx_edge(&mut c, view(""), 0);
        if (0 < iface) && (iface <= c.interfaces.len()) {
            mut why = copy_bytes(view("the drop of a `dyn "));
            push_bytes(&mut why, view(c.interfaces[iface - 1].name));
            push_bytes(&mut why, view("` value, whose implementations this module cannot see"));
            if c.interfaces[iface - 1].public != 0 {
                push_bytes(&mut why, view(": `"));
                push_bytes(&mut why, view(c.interfaces[iface - 1].name));
                push_bytes(&mut why, view("` is public"));
            }
            fx_why(&mut c, view(why));
        }
    }
    // A public interface may be implemented, and its values boxed, in a module this run cannot see:
    // the value dropped here may hold any of those implementations. Only a private one's are all
    // here (its module is the only one that can name it), so the answer is the same in every build
    // shape (docs/design/effects.md, "The `dyn` drop").
    if (found != 0) && (0 < iface) && (iface <= c.interfaces.len()) && (c.interfaces[iface - 1].public != 0) {
        fx_edge(&mut c, view(""), 0);
        mut why = copy_bytes(view("the drop of a `dyn "));
        push_bytes(&mut why, view(c.interfaces[iface - 1].name));
        push_bytes(&mut why, view("` value, whose implementations this module cannot see: `"));
        push_bytes(&mut why, view(c.interfaces[iface - 1].name));
        push_bytes(&mut why, view("` is public"));
        fx_why(&mut c, view(why));
    }
    // One `call *%rax` line is what the site emits, however many helpers the slot may hold.
    fx_called(&mut c);
    return ();
}
// A drop helper's body starts: trusted code, recorded like a function so a caller's claim is followed
// through it to the user `Drop` it calls.
fn fx_helper<a, b>(c: (&a mut C), sym: &b [u8]) -> unit {
    if (c.check_only != 0) && (c.fx_any == 0) {
        return ();
    }
    k := fx_sym(&mut c, view(sym)) - 1;
    c.fx_body[k] = 1;
    c.fx_row[k] = 0;
    c.fx_alloc_thru[k] = 0;
    c.fx_panic_thru[k] = 0;
    c.fx_own_alloc[k] = 0;
    c.fx_own_panic[k] = 0;
    exchange(&mut c.fx_trusted, 1);
    exchange(&mut c.fx_calls, 0);
    exchange(&mut c.fx_cur, k + 1);
    return ();
}
// The body ends, and the one thing that is still read from the bytes is checked: the number of `call`
// lines the body emitted has to be the number of calls it recorded. A disagreement means a call site
// exists that does not go through the recording helpers - a compiler bug that would otherwise be a
// silently weaker proof.
fn fx_end<a>(c: (&a mut C)) -> unit {
    cur := c.fx_cur;
    if cur == 0 {
        return ();
    }
    exchange(&mut c.fx_cur, 0);
    from := cur - 1;
    // The calls this body emitted: the comparison
    // that used to scan these bytes for `call` lines happens once, against the typed IR's call list
    // (`fx_check_calls`, called where the optimizer has parsed every body).
    c.fx_body_sym.push(c.fx_syms[from].copy());
    c.fx_body_calls.push(c.fx_calls);
    exchange(&mut c.fx_calls, 0);
    return ();
}
// The check the byte scan used to make: every body that claimed an effect recorded exactly as many
// calls as the typed IR parsed out of its bytes. A call site that
// bypasses `call_out`, `call_slot_out`, `call_dispatch_out` or `call_entry_out` would leave the IR
// with a call the recorder never saw - a silently weaker proof - so it is refused here.
fn fx_check_calls<a, b, d>(c: (&a mut C), syms: (&b u8[][]), counts: (&d u64[])) {
    // The parsed bodies by name (the last one parsed under a name wins, as the scan did).
    mut slots = u64[];
    mut keys = u64[];
    for i in syms.len() {
        index_add(&mut slots, &mut keys, name_key(view(""), view(syms[i])));
    }
    for b in c.fx_body_sym.len() {
        mut found = 0;
        mut got: u64 = 0;
        if slots.len() != 0 {
            key := name_key(view(""), view(c.fx_body_sym[b]));
            mask := slots.len() - 1;
            mut h = key & mask;
            while slots[h] != 0 {
                i := slots[h] - 1;
                if (keys[i] == key) && same(view(syms[i]), view(c.fx_body_sym[b])) && ((found == 0) || (i > found - 1)) {
                    found = i + 1;
                    got = counts[i];
                }
                h = (h + 1) & mask;
            }
        }
        if found == 0 {
            continue;
        }
        if got != c.fx_body_calls[b] {
            mut msg = copy_bytes(view("internal: the body of `"));
            push_bytes(&mut msg, view(c.fx_body_sym[b]));
            push_bytes(&mut msg, view("` emits "));
            decimal(&mut msg, got);
            push_bytes(&mut msg, view(" call instructions but the effect checker recorded "));
            decimal(&mut msg, c.fx_body_calls[b]);
            push_bytes(&mut msg, view(": a call site is not going through call_out, call_slot_out, call_dispatch_out or call_entry_out"));
            fail(&mut c, view(msg));
        }
    }
    return ();
}
// The record a callee symbol names: a body emitted for it, or a declaration read for it.
fn fx_lookup<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    return fx_find(&mut c, view(name));
}
// The fact of a callee: proved by its own body in this build, or claimed by an attribute that its own
// module verified. Anything else is unknown, and unknown means it has to be assumed to allocate and to
// fail.
fn fx_callee_alloc<a>(c: (&a C), k: u64) -> u64 {
    kk := k - 1;
    if (c.fx_body[kk] != 0) || (c.fx_row[kk] != 0) {
        return c.fx_alloc[kk];
    }
    if c.fx_attr_alloc[kk] != 0 {
        return 0;
    }
    return 1;
}
fn fx_callee_panic<a>(c: (&a C), k: u64) -> u64 {
    kk := k - 1;
    if (c.fx_body[kk] != 0) || (c.fx_row[kk] != 0) {
        return c.fx_panic[kk];
    }
    if c.fx_attr_panic[kk] != 0 {
        return 0;
    }
    return 1;
}
// The symbol a declared function is emitted (and called) under.
fn fx_func_symbol<a>(c: (&a mut C), i: u64) -> u8[] {
    mut out = u8[];
    plat := c.plat;
    m := c.funcs[i].module.copy();
    n := c.funcs[i].name.copy();
    ext := c.funcs[i].ext;
    symbol := c.funcs[i].symbol.copy();
    if ext == 2 {
        // A C callback is called through the C name it was given, under the platform prefix.
        if plat == 1 {
            out.push(95);
        }
        push_bytes(&mut out, view(symbol));
        return out;
    }
    mangle_into(&mut out, plat, view(m), view(n));
    return out;
}
// The declarations' attributes, then the edges, then the fixpoint over them. A function's own
// allocation and failure (the runtime's roots) are its starting facts; a call passes its callee's
// facts on, so a chain of plain functions is followed to the `rt_alloc` (or the `rt_abort`) at the end
// of it. A symbol nothing defines or emits is unknown - an extern, a stub - unless the body that calls
// it is trusted code, whose unresolved names are the assembly stubs of the system-call gate.
fn fx_solve<a>(c: (&a mut C)) -> unit {
    for i in c.funcs.len() {
        na := c.funcs[i].no_alloc;
        np := c.funcs[i].no_panic;
        if (na != 0) || (np != 0) {
            sym := fx_func_symbol(&mut c, i);
            if sym.len() != 0 {
                k := fx_sym(&mut c, view(sym)) - 1;
                if k < c.fx_attr_alloc.len() {
                    if na != 0 {
                        c.fx_attr_alloc[k] = 1;
                    }
                    if np != 0 {
                        c.fx_attr_panic[k] = 1;
                    }
                }
            }
        }
    }
    for i in c.fx_syms.len() {
        c.fx_alloc[i] = c.fx_own_alloc[i];
        c.fx_panic[i] = c.fx_own_panic[i];
    }
    for e in c.fx_edge_name.len() {
        // stays: the name is read twice, by the lookup and by the check below.
        name := c.fx_edge_name[e].copy();
        k := fx_lookup(&mut c, view(name));
        c.fx_edge_to[e] = k;
        if k == 0 {
            mut unknown = 1;
            if name.len() != 0 {
                if (c.fx_edge_kind[e] & 4) != 0 {
                    unknown = 0;
                }
            }
            if unknown != 0 {
                kind := c.fx_edge_kind[e];
                c.fx_edge_kind[e] = kind | 1;
            }
        }
    }
    // A worklist over the reverse edges: every fact is set once, and setting it visits the callers
    // of that body once, so the solve is linear in the edges. First the facts no solved callee
    // decides - an unknown call, a callee known only by its declaration, a callee's entry checks -
    // then each body that has a fact passes it to its callers.
    n := c.fx_syms.len();
    // How far each fact is from where it starts: 0 for a body's own, 1 for one an edge gives without a
    // solved callee, one more than the callee's for one passed on. The witness is chosen from it below.
    mut da = u64[0; n];
    mut dp = u64[0; n];
    mut work = u64[];
    for k in n {
        if (c.fx_alloc[k] != 0) || (c.fx_panic[k] != 0) {
            work.push(k);
        }
    }
    mut callers = u64[0; n + 1];
    for e in c.fx_edge_from.len() {
        from := c.fx_edge_from[e];
        to := c.fx_edge_to[e];
        kind := c.fx_edge_kind[e];
        mut a = 0;
        mut p = 0;
        if to != 0 {
            if c.fx_body[to - 1] == 0 {
                a = fx_callee_alloc(&c, to);
                p = fx_callee_panic(&c, to);
            } else {
                callers[to] = callers[to] + 1;
            }
            if (c.fx_entry_panic[to - 1] != 0) && ((kind & 8) == 0) {
                p = 1;
            }
        } else {
            if (kind & 1) != 0 {
                a = 1;
                p = 1;
            }
        }
        mut set = 0;
        if (a != 0) && (c.fx_alloc[from] == 0) {
            c.fx_alloc[from] = 1;
            da[from] = 1;
            set = 1;
        }
        if (p != 0) && (c.fx_panic[from] == 0) {
            c.fx_panic[from] = 1;
            dp[from] = 1;
            set = 1;
        }
        if set != 0 {
            work.push(from);
        }
    }
    // callers[k + 1] .. callers[k + 2]: the edges into body k, in edge order.
    mut start = u64[0; n + 2];
    for k in n {
        start[k + 1] = start[k] + callers[k + 1];
    }
    start[n + 1] = start[n];
    mut fill = u64[0; n + 1];
    mut into = u64[0; start[n] + 1];
    for e in c.fx_edge_from.len() {
        to := c.fx_edge_to[e];
        if (to != 0) && (c.fx_body[to - 1] != 0) {
            into[start[to - 1] + fill[to - 1]] = e;
            fill[to - 1] = fill[to - 1] + 1;
        }
    }
    mut at = 0;
    while at < work.len() {
        k := work[at];
        at += 1;
        for j in start[k]..start[k + 1] {
            e := into[j];
            from := c.fx_edge_from[e];
            mut set = 0;
            if (c.fx_alloc[k] != 0) && (c.fx_alloc[from] == 0) {
                c.fx_alloc[from] = 1;
                da[from] = da[k] + 1;
                set = 1;
            }
            if (c.fx_panic[k] != 0) && (c.fx_panic[from] == 0) {
                c.fx_panic[from] = 1;
                dp[from] = dp[k] + 1;
                set = 1;
            }
            if set != 0 {
                work.push(from);
            }
        }
    }
    // The witness of each fact: the first edge, in the order the body made its calls, that gives the
    // fact from closer to where it starts - so a chain never loops, and it follows the earliest call
    // that explains the fact, as the diagnostic reads.
    mut have_a = u64[0; n];
    mut have_p = u64[0; n];
    for e in c.fx_edge_from.len() {
        from := c.fx_edge_from[e];
        to := c.fx_edge_to[e];
        kind := c.fx_edge_kind[e];
        mut a = 0;
        mut p = 0;
        if to != 0 {
            if c.fx_body[to - 1] == 0 {
                a = fx_callee_alloc(&c, to);
                p = fx_callee_panic(&c, to);
            } else {
                if (c.fx_alloc[to - 1] != 0) && (da[to - 1] < da[from]) {
                    a = 1;
                }
                if (c.fx_panic[to - 1] != 0) && (dp[to - 1] < dp[from]) {
                    p = 1;
                }
            }
            if (c.fx_entry_panic[to - 1] != 0) && ((kind & 8) == 0) {
                p = 1;
            }
        } else {
            if (kind & 1) != 0 {
                a = 1;
                p = 1;
            }
        }
        if (a != 0) && (c.fx_alloc[from] != 0) && (da[from] != 0) && (have_a[from] == 0) {
            c.fx_alloc_thru[from] = to;
            have_a[from] = 1;
        }
        if (p != 0) && (c.fx_panic[from] != 0) && (dp[from] != 0) && (have_p[from] == 0) {
            c.fx_panic_thru[from] = to;
            have_p[from] = 1;
        }
    }
    return ();
}
// The chain a fact travelled, for a diagnostic: `f -> g -> ...`. At most 8 links, so a cycle in the
// call graph still terminates.
fn fx_chain<a>(c: (&a mut C), first: u64, spending: u64) -> u8[] {
    mut out = u8[];
    mut k = first + 1;
    mut n = 0;
    while (k != 0) && (n < spending) {
        idx := k - 1;
        if n != 0 {
            push_bytes(&mut out, view(" -> "));
        }
        // The source name where a body was recorded, else the symbol (a declaration only).
        if c.fx_fn_name[idx].len() != 0 {
            push_bytes(&mut out, view(c.fx_fn_name[idx]));
        } else {
            push_bytes(&mut out, view(c.fx_syms[idx]));
        }
        n = n + 1;
        k = c.fx_alloc_thru[idx];
    }
    return out;
}
fn fx_chain_panic<a>(c: (&a mut C), first: u64, spending: u64) -> u8[] {
    mut out = u8[];
    mut k = first + 1;
    mut n = 0;
    while (k != 0) && (n < spending) {
        idx := k - 1;
        if n != 0 {
            push_bytes(&mut out, view(" -> "));
        }
        // The source name where a body was recorded, else the symbol (a declaration only).
        if c.fx_fn_name[idx].len() != 0 {
            push_bytes(&mut out, view(c.fx_fn_name[idx]));
        } else {
            push_bytes(&mut out, view(c.fx_syms[idx]));
        }
        n = n + 1;
        k = c.fx_panic_thru[idx];
    }
    return out;
}
// One diagnostic, at the position of the offending site (which may be in another file than the one
// the compile stopped in).
fn fx_fail<a>(c: (&a mut C), file: u64, pos: u64, msg: u8[]) -> unit {
    load_file(&mut c, file);
    exchange(&mut c.file, file);
    exchange(&mut c.pos, pos);
    fail(&mut c, view(msg));
    return ();
}
// The edge of `from` that names `to`: the call site a diagnostic points at.
fn fx_edge_file_of<a>(c: (&a mut C), from: u64, to: u64) -> u64 {
    for e in c.fx_edge_from.len() {
        if c.fx_edge_from[e] == from {
            if c.fx_edge_to[e] == to {
                return c.fx_edge_file[e];
            }
        }
    }
    return c.fx_fn_file[from];
}
fn fx_edge_pos_of<a>(c: (&a mut C), from: u64, to: u64) -> u64 {
    for e in c.fx_edge_from.len() {
        if c.fx_edge_from[e] == from {
            if c.fx_edge_to[e] == to {
                return c.fx_edge_pos[e];
            }
        }
    }
    return c.fx_fn_pos[from];
}
// The site of the indirect call a fact travelled through, when it has no chain to show.
fn fx_unknown_file_of<a>(c: (&a mut C), from: u64) -> u64 {
    for e in c.fx_edge_from.len() {
        if c.fx_edge_from[e] == from {
            if (c.fx_edge_kind[e] & 1) != 0 {
                return c.fx_edge_file[e];
            }
        }
    }
    return c.fx_fn_file[from];
}
fn fx_unknown_pos_of<a>(c: (&a mut C), from: u64) -> u64 {
    for e in c.fx_edge_from.len() {
        if c.fx_edge_from[e] == from {
            if (c.fx_edge_kind[e] & 1) != 0 {
                return c.fx_edge_pos[e];
            }
        }
    }
    return c.fx_fn_pos[from];
}
// Every claim is checked here, after the whole program - the drop helpers, the vtables' drop slots and
// the specialisations - has been emitted and settled. A claim on a generic is checked per emitted
// instance, so the refusal names the instance whose body reaches the root.
// Why the body reaches a call nothing names: the reason recorded where the call was emitted
// (`iface_reason` for a `dyn` receiver), or nothing when the edge predates the reason.
fn fx_unknown_why<a>(c: (&a mut C), k: u64) -> u8[] {
    for e in c.fx_edge_from.len() {
        if (c.fx_edge_from[e] == k) & (c.fx_edge_name[e].len() == 0) & (c.fx_edge_why[e].len() != 0) {
            return c.fx_edge_why[e].copy();
        }
    }
    return u8[];
}
// Where a chain of witnesses ends (at most `spending` links): the record whose fact is its own, or
// came through an edge nothing names. `panic` picks the failure chain.
fn fx_chain_end<a>(c: (&a C), first: u64, spending: u64, panic: u64) -> u64 {
    mut k = first;
    mut n = 1;
    while n < spending {
        mut next = c.fx_alloc_thru[k];
        if panic != 0 {
            next = c.fx_panic_thru[k];
        }
        if next == 0 {
            return k;
        }
        k = next - 1;
        n += 1;
    }
    return k;
}
// The tail a refusal adds when its chain ends in an indirect call: what the call's target is.
fn fx_chain_tail<a>(c: (&a mut C), first: u64, panic: u64) -> u8[] {
    last := fx_chain_end(&c, first, 8, panic);
    mut own = c.fx_own_alloc[last];
    if panic != 0 {
        own = c.fx_own_panic[last];
    }
    if (last == first) || (own != 0) {
        return u8[];
    }
    why := fx_unknown_why(&mut c, last);
    if why.len() == 0 {
        return u8[];
    }
    mut out = copy_bytes(view(", which makes an indirect call the compiler cannot follow (the target is "));
    push_bytes(&mut out, view(why));
    out.push(41);
    return out;
}
fn fx_report<a>(c: (&a mut C)) -> unit {
    if c.fx_any == 0 {
        return ();
    }
    for k in c.fx_syms.len() {
        if k >= c.fx_attr_alloc.len() {
            continue;
        }
        if (c.fx_body[k] == 0) || (c.fx_attr_alloc[k] == 0) {
            continue;
        }
        if c.fx_alloc[k] == 0 {
            continue;
        }
        name := c.fx_fn_name[k].copy();
        mut msg = copy_bytes(view("`@no_alloc` function `"));
        push_bytes(&mut msg, view(name));
        thru := c.fx_alloc_thru[k];
        mut at_file = c.fx_fn_file[k];
        mut at_pos = c.fx_fn_pos[k];
        if thru != 0 {
            push_bytes(&mut msg, view("` performs a heap allocation: it calls "));
            chain := fx_chain(&mut c, k, 8);
            push_bytes(&mut msg, view(chain));
            push_bytes(&mut msg, view(fx_chain_tail(&mut c, k, 0)));
            push_bytes(&mut msg, view("\n = the call chain above reaches something that allocates"));
            at_file = fx_edge_file_of(&mut c, k, thru);
            at_pos = fx_edge_pos_of(&mut c, k, thru);
        } else {
            if c.fx_own_alloc[k] != 0 {
                push_bytes(&mut msg, view("` performs a heap allocation"));
                push_bytes(&mut msg, view("\n = move the allocation out of the function, or keep the attribute off it"));
            } else {
                push_bytes(&mut msg, view("` performs a heap allocation: it makes an indirect call the compiler cannot follow"));
                why := fx_unknown_why(&mut c, k);
                if why.len() != 0 {
                    push_bytes(&mut msg, view(" (the target is "));
                    push_bytes(&mut msg, view(why));
                    push_bytes(&mut msg, view(")"));
                }
                push_bytes(&mut msg, view("\n = a call through a function value or a vtable may allocate; name the callee, or keep the attribute off"));
                at_file = fx_unknown_file_of(&mut c, k);
                at_pos = fx_unknown_pos_of(&mut c, k);
            }
        }
        fx_fail(&mut c, at_file, at_pos, msg);
    }
    for k in c.fx_syms.len() {
        if k >= c.fx_attr_panic.len() {
            continue;
        }
        if (c.fx_body[k] == 0) || (c.fx_attr_panic[k] == 0) {
            continue;
        }
        if c.fx_panic[k] == 0 {
            continue;
        }
        name := c.fx_fn_name[k].copy();
        mut msg = copy_bytes(view("`@no_panic` function `"));
        push_bytes(&mut msg, view(name));
        thru := c.fx_panic_thru[k];
        mut at_file = c.fx_fn_file[k];
        mut at_pos = c.fx_fn_pos[k];
        if thru != 0 {
            push_bytes(&mut msg, view("` can fail: it calls "));
            chain := fx_chain_panic(&mut c, k, 8);
            push_bytes(&mut msg, view(chain));
            push_bytes(&mut msg, view(fx_chain_tail(&mut c, k, 1)));
            push_bytes(&mut msg, view("\n = a callee leaves a runtime check, so the whole chain has to be check-free"));
            at_file = fx_edge_file_of(&mut c, k, thru);
            at_pos = fx_edge_pos_of(&mut c, k, thru);
        } else {
            if c.fx_own_panic[k] != 0 {
                push_bytes(&mut msg, view("` can fail"));
                push_bytes(&mut msg, view("\n = prove the check away, or keep the attribute off the function"));
            } else {
                push_bytes(&mut msg, view("` can fail: it makes an indirect call the compiler cannot follow"));
                why := fx_unknown_why(&mut c, k);
                if why.len() != 0 {
                    push_bytes(&mut msg, view(" (the target is "));
                    push_bytes(&mut msg, view(why));
                    push_bytes(&mut msg, view(")"));
                }
                push_bytes(&mut msg, view("\n = a call through a function value or a vtable may fail; name the callee, or keep the attribute off"));
                at_file = fx_unknown_file_of(&mut c, k);
                at_pos = fx_unknown_pos_of(&mut c, k);
            }
        }
        fx_fail(&mut c, at_file, at_pos, msg);
    }
    return ();
}
// `@bounded(N)`: the whole form is consumed, and the count lands in `c.fx_bounded`. 1 when the tokens
// were this attribute, 0 when they are something else.
fn fx_bounded_form<a>(c: (&a mut C)) -> u64 {
    next := c.pos + 1;
    if kind_at(&mut c, next) != 1 {
        return 0;
    }
    word := tok_text(&mut c, next);
    if !same(view(word), view("bounded")) {
        return 0;
    }
    advance(&mut c);
    advance(&mut c);
    if !eat(&mut c, view("(")) {
        fail(&mut c, view("`@bounded` takes an iteration count: `@bounded(16) while ...`"));
    }
    text := tok_text(&mut c, c.pos);
    if !pv_digits(view(text)) {
        fail(&mut c, view("`@bounded` takes a decimal iteration count"));
    }
    n := literal_value(&mut c, view(text));
    advance(&mut c);
    if !eat(&mut c, view(")")) {
        fail(&mut c, view("`@bounded` takes exactly one iteration count: `@bounded(16)`"));
    }
    exchange(&mut c.fx_bounded, n);
    return 1;
}
// The payload of `@bounded(N)`, 0 when no attribute is in force. `fx_pending_bound` says one is.
fn fx_bound<a>(c: (&a mut C)) -> u64 {
    return c.fx_bounded;
}
// The index of the `}` matching the `{` at `open`, or `to` when it never closes.
fn fx_match_brace<a>(c: (&a mut C), open: u64, to: u64) -> u64 {
    mut depth = 0;
    mut q = open;
    while q < to {
        k := kind_at(&mut c, q);
        if k == 0 {
            return to;
        }
        if k == 123 {
            depth = depth + 1;
        }
        if k == 125 {
            depth = depth - 1;
            if depth == 0 {
                return q;
            }
        }
        q = q + 1;
    }
    return to;
}
// The proof of `@bounded(n)` for the loop that starts at `c.pos`: a counter that strictly increases
// toward a constant (or refined) bound and that nothing else in the body assigns, or `for i in a..b`
// with a constant span of at most n. Anything else is refused, naming what is missing.
fn fx_bounded_loop<a>(c: (&a mut C), n: u64) -> unit {
    start := c.pos;
    word := tok_text(&mut c, start);
    if same(view(word), view("loop")) {
        fx_bounded_refuse(
            &mut c,
            n,
            view("this `loop` has no counter: it repeats until a `break` that the compiler cannot count"),
            view("use `while i < K` with an unsigned counter `i` that only the loop increments, or a `for i in 0..K`")
        );
    }
    if same(view(word), view("for")) {
        fx_bounded_for(&mut c, n, start);
        return ();
    }
    if !same(view(word), view("while")) {
        fail(&mut c, view("`@bounded` applies to a `while` or a `for` loop"));
    }
    // The condition's tokens, up to the body's `{`.
    mut q = start + 1;
    mut depth = 0;
    mut cond_hi = 0;
    while q < c.toks.len() {
        k := kind_at(&mut c, q);
        if k == 0 {
            break;
        }
        if k == 40 {
            depth = depth + 1;
        }
        if k == 41 {
            depth = depth - 1;
        }
        if (k == 123) && (depth == 0) {
            cond_hi = q;
            break;
        }
        q = q + 1;
    }
    if cond_hi == 0 {
        fail(&mut c, view("`@bounded` needs a loop with a body"));
    }
    // `while NAME < BOUND` (or `<=`, or the same with the bound on the left).
    mut name = u8[];
    mut rel = 0;
    mut bound = u8[];
    mut bound_at = 0;
    if cond_hi - (start + 1) == 3 {
        left := tok_text(&mut c, start + 1);
        mut op = tok_text(&mut c, start + 2);
        right := tok_text(&mut c, start + 3);
        mut left_is_name = false;
        if kind_at(&mut c, start + 1) == 1 {
            left_is_name = true;
        }
        mut right_is_name = false;
        if kind_at(&mut c, start + 3) == 1 {
            right_is_name = true;
        }
        if same(view(op), view("<")) {
            rel = 0;
        }
        if same(view(op), view("<=")) {
            rel = 1;
        }
        if same(view(op), view(">")) {
            rel = 2;
        }
        if same(view(op), view(">=")) {
            rel = 3;
        }
        if same(view(op), view("!=")) {
            rel = 4;
        }
        if (rel == 0) || (rel == 1) {
            if left_is_name & !right_is_name {
                name = copy_bytes(view(left));
                bound = copy_bytes(view(right));
                bound_at = start + 3;
            }
        }
        if (rel == 2) || (rel == 3) {
            if right_is_name & !left_is_name {
                name = copy_bytes(view(right));
                bound = copy_bytes(view(left));
                bound_at = start + 1;
            }
        }
    }
    if name.len() == 0 {
        fx_bounded_refuse(
            &mut c,
            n,
            view("its condition is not `i < K`, `i <= K` or the same with the bound on the left"),
            view("write the loop as `while i < K` with an unsigned counter `i`")
        );
    }
    // The bound has to be a constant, or a parameter the enclosing function's refinement bounds.
    limit := fx_bound_value(&mut c, view(bound), rel);
    if limit == 0 {
        mut msg = copy_bytes(view("the bound `"));
        push_bytes(&mut msg, view(bound));
        push_bytes(&mut msg, view("` is neither a constant nor bounded by a refinement of this function"));
        mut hint = copy_bytes(view("add `where "));
        push_bytes(&mut hint, view(bound));
        push_bytes(&mut hint, view(" <= "));
        push_bytes(&mut hint, view(decimal_bytes(n)));
        push_bytes(&mut hint, view("` to the parameter, or use a constant bound"));
        exchange(&mut c.pos, bound_at);
        fail(&mut c, view(msg));
        return ();
    }
    if n < limit {
        mut msg = copy_bytes(view("its bound allows "));
        push_bytes(&mut msg, view(decimal_bytes(limit)));
        push_bytes(&mut msg, view(" iterations, more than the "));
        push_bytes(&mut msg, view(decimal_bytes(n)));
        push_bytes(&mut msg, view(" `@bounded` claims"));
        exchange(&mut c.pos, bound_at);
        fail(&mut c, view(msg));
        return ();
    }
    // The body: the counter may only be assigned by its own increment, and that increment has to be a
    // positive constant step.
    body_lo := cond_hi;
    body_hi := fx_match_brace(&mut c, body_lo, c.toks.len());
    mut step = 0;
    mut bad = 0;
    mut q = body_lo + 1;
    while q < body_hi {
        t := tok_text(&mut c, q);
        if same(view(t), view(name)) {
            mut op = u8[];
            if q + 1 < body_hi {
                op = tok_text(&mut c, q + 1);
            }
            if fx_assign_op(view(op)) != 0 {
                mut good = 0;
                if same(view(op), view("+=")) {
                    if q + 2 < body_hi {
                        val := tok_text(&mut c, q + 2);
                        if pv_digits(view(val)) {
                            k := literal_value(&mut c, view(val));
                            if k != 0 {
                                if step == 0 {
                                    step = k;
                                }
                                good = 1;
                            }
                        }
                    }
                }
                if same(view(op), view("=")) {
                    if q + 4 < body_hi {
                        again := tok_text(&mut c, q + 2);
                        plus := tok_text(&mut c, q + 3);
                        val := tok_text(&mut c, q + 4);
                        if same(view(again), view(name)) & same(view(plus), view("+")) {
                            if pv_digits(view(val)) {
                                k := literal_value(&mut c, view(val));
                                if k != 0 {
                                    if step == 0 {
                                        step = k;
                                    }
                                    good = 1;
                                }
                            }
                        }
                    }
                }
                if good == 0 {
                    bad = 1;
                }
            }
        }
        q = q + 1;
    }
    if bad != 0 {
        fx_bounded_refuse(
            &mut c,
            n,
            view("the body assigns the counter somewhere other than its own increment"),
            view("keep the counter's only assignment as `i = i + 1` (or `i += 1`)")
        );
    }
    if step == 0 {
        mut msg = copy_bytes(view("the counter `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view("` is never incremented in the body, so the loop's iteration count is not bounded"));
        exchange(&mut c.pos, start);
        fail(&mut c, view(msg));
    }
    // `i` starts at zero or more and grows by at least `step`, so it reaches a bound of `limit` in at
    // most `limit` iterations (a negative start cannot make that worse for an unsigned counter).
    if !fx_unsigned_counter(&mut c, view(name)) {
        mut msg = copy_bytes(view("the counter `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view("` is signed: a negative start makes the iteration count unbounded"));
        exchange(&mut c.pos, start);
        fail(&mut c, view(msg));
    }
    return ();
}
// `for i in a..b { }` with constants: `b - a <= n` is the whole proof.
fn fx_bounded_for<a>(c: (&a mut C), n: u64, start: u64) -> unit {
    mut q = start + 1;
    if kind_at(&mut c, q) != 1 {
        fx_bounded_refuse(
            &mut c,
            n,
            view("this `for` does not name a counter"),
            view("use `for i in 0..K` with a constant K at most the claimed bound")
        );
    }
    name := tok_text(&mut c, start + 1);
    ink := tok_text(&mut c, start + 2);
    if !same(view(ink), view("in")) {
        fx_bounded_refuse(
            &mut c,
            n,
            view("this `for` does not iterate over a range"),
            view("use `for i in 0..K` with a constant K at most the claimed bound")
        );
    }
    // The range's two ends, up to the body's `{`.
    mut depth = 0;
    mut hi = 0;
    q = start + 3;
    while q < c.toks.len() {
        k := kind_at(&mut c, q);
        if k == 0 {
            break;
        }
        if k == 40 {
            depth = depth + 1;
        }
        if k == 41 {
            depth = depth - 1;
        }
        if (k == 123) && (depth == 0) {
            hi = q;
            break;
        }
        q = q + 1;
    }
    if hi == 0 {
        fail(&mut c, view("`@bounded` needs a loop with a body"));
    }
    if hi - (start + 3) != 3 {
        fx_bounded_refuse(
            &mut c,
            n,
            view("its range is not spelled with two constants"),
            view("use `for i in 0..K` with a constant K at most the claimed bound")
        );
    }
    lo_text := tok_text(&mut c, start + 3);
    dots := tok_text(&mut c, start + 4);
    hi_text := tok_text(&mut c, start + 5);
    if !same(view(dots), view("..")) || !pv_digits(view(lo_text)) || !pv_digits(view(hi_text)) {
        fx_bounded_refuse(
            &mut c,
            n,
            view("its range is not spelled with two constants"),
            view("use `for i in 0..K` with a constant K at most the claimed bound")
        );
    }
    lo := literal_value(&mut c, view(lo_text));
    up := literal_value(&mut c, view(hi_text));
    mut span = 0;
    if lo < up {
        span = up - lo;
    }
    if n < span {
        mut msg = copy_bytes(view("its range spans "));
        push_bytes(&mut msg, view(decimal_bytes(span)));
        push_bytes(&mut msg, view(" iterations, more than the "));
        push_bytes(&mut msg, view(decimal_bytes(n)));
        push_bytes(&mut msg, view(" `@bounded` claims"));
        exchange(&mut c.pos, start + 5);
        fail(&mut c, view(msg));
    }
    if !fx_unsigned_counter(&mut c, view(name)) {
        mut msg = copy_bytes(view("the counter `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view("` is signed: a negative start makes the iteration count unbounded"));
        exchange(&mut c.pos, start);
        fail(&mut c, view(msg));
    }
    return ();
}
// The iterations a `while` condition allows: `i < K` and `i <= K` with a constant `K`, or a parameter
// the enclosing function's `where` bounds (`n: u64 where n <= 16`). 0 when neither holds.
fn fx_bound_value<a, b>(c: (&a mut C), bound: &b [u8], rel: u64) -> u64 {
    if pv_digits(view(bound)) {
        mut k = literal_value(&mut c, view(bound));
        if rel == 1 {
            return k + 1;
        }
        return k;
    }
    mut out = 0;
    for i in c.cur_ppreds.len() {
        mut pf = 0;
        mut plo = 0;
        mut phi = 0;
        if i < c.cur_ppreds.len() {
            p := &c.cur_ppreds[i];
            pf = p.file;
            plo = p.lo;
            phi = p.hi;
        }
        if phi == 0 {
            continue;
        }
        mut atoms = Atom[];
        ok := pv_read_pred(&mut c, Pred { file: pf, lo: plo, hi: phi }, &mut atoms);
        if ok {
            for a in atoms.len() {
                item := &atoms[a];
                // The bound itself against a literal: `n + 1 < 100` bounds the wrapped sum, not `n`.
                if same(view(item.a), view(bound)) & (item.ao == 0) & (item.bo == 0) {
                    if (item.rel == 0) || (item.rel == 1) {
                        if pv_digits(view(item.b)) {
                            mut k = literal_value(&mut c, view(item.b));
                            if item.rel == 1 {
                                k = k + 1;
                            }
                            if (out == 0) || (k < out) {
                                out = k;
                            }
                        }
                    }
                }
            }
        }
    }
    return out;
}
// Whether the loop's counter is unsigned: a signed counter could start below zero and so run for
// longer than its bound allows.
fn fx_unsigned_counter<a, b>(c: (&a mut C), name: &b [u8]) -> bool {
    l := find_local(&mut c, view(name));
    if l == 0 {
        return false;
    }
    ty := local_ty(&mut c, l - 1);
    if ty == 0 {
        return true;
    }
    if ty_kind(&mut c, ty) != 18 {
        return false;
    }
    if ty_mode(&mut c, ty) != 0 {
        return false;
    }
    return true;
}
fn fx_assign_op<a, b>(c: (&a [u8])) -> u64 {
    if same(view(c), view("=")) || same(view(c), view("+=")) || same(view(c), view("-=")) || same(view(c), view("*=")) || same(view(c), view("/=")) || same(view(c), view("%=")) || same(view(c), view("&=")) || same(view(c), view("|=")) || same(view(c), view("^=")) || same(view(c), view("<<=")) || same(view(c), view(">>=")) {
        return 1;
    }
    return 0;
}
// A refused `@bounded`: the loop, what defeats the proof, and the shape that would prove it.
fn fx_bounded_refuse<a, b, d>(c: (&a mut C), n: u64, why: &b [u8], hint: &d [u8]) -> unit {
    mut msg = copy_bytes(view("cannot prove `@bounded("));
    push_bytes(&mut msg, view(decimal_bytes(n)));
    push_bytes(&mut msg, view(")`: "));
    push_bytes(&mut msg, view(why));
    push_bytes(&mut msg, view("\n = "));
    push_bytes(&mut msg, view(hint));
    fail(&mut c, view(msg));
    return ();
}
fn toplevel_item<a>(c: (&a mut C), pass: u64) -> unit {
    if true {
        if kind(&mut c) == 64 {
            // Attributes a declaration carries: `@strict` (refinements), `@no_alloc` and `@no_panic`
            // (effects). They chain, and `@strict;` alone is the module-wide form.
            mut attrs = 0;
            mut strict_decl = 0;
            while kind(&mut c) == 64 {
                mode := ref_strict_form(&mut c);
                if mode == 2 {
                    // `@strict;`: every refinement obligation in this module is an error.
                    return ();
                }
                if mode == 1 {
                    strict_decl = 1;
                    attrs = 1;
                } else {
                    if fx_attr_form(&mut c) != 0 {
                        attrs = 1;
                    } else {
                        if dr_attr_form(&mut c) != 0 {
                            attrs = 1;
                        } else {
                            ct_form(&mut c, pass, 1);
                            return ();
                        }
                    }
                }
            }
            if attrs == 0 {
                ct_form(&mut c, pass, 1);
                return ();
            }
            if strict_decl != 0 {
                exchange(&mut c.strict_next, 1);
            }
        }
        if (kind(&mut c) == 1) & (next_kind(&mut c) == 261) {
            module_binding(&mut c, pass);
            return ();
        }
        public := u64(eat(&mut c, view("pub")));
        // Every item takes `pub`; without it the item is private to this module.
        exchange(&mut c.decl_public, public);
        // `unsafe fn` and `unsafe struct C<T>: transferable, shareable`: the hatch for one item. The
        // declaration that owns it consumes the flag; anything else that leaves it set is refused.
        item_unsafe := u64(eat(&mut c, view("unsafe")));
        saved_unsafe := exchange(&mut c.pending_unsafe, item_unsafe);
        declaration_item(&mut c, pass, public);
        if c.pending_unsafe != 0 {
            fail(&mut c, view("`unsafe` applies to a function or to a struct's capability classification"));
        }
        exchange(&mut c.pending_unsafe, saved_unsafe);
        exchange(&mut c.decl_public, 1);
        if c.fx_pending_alloc != 0 {
            fail(&mut c, view("`@no_alloc` applies to a function"));
        }
        if c.fx_pending_panic != 0 {
            fail(&mut c, view("`@no_panic` applies to a function"));
        }
        if c.derive_pending != 0 {
            exchange(&mut c.pos, c.dr_pos);
            fail(&mut c, view("`@derive(...)` applies to a struct or an enum"));
        }
        exchange(&mut c.strict_next, 0);
        return ();
    }
    return ();
}
// A declaration after its optional `pub`.
fn declaration_item<a>(c: (&a mut C), pass: u64, public: u64) -> unit {
    if true {
        if is(&mut c, view("extern")) {
            extern_declaration(&mut c, pass, public);
            return ();
        }
        if is(&mut c, view("handle")) {
            handle_declaration(&mut c, pass);
            return ();
        }
        if is(&mut c, view("static")) && ((kind_at(&mut c, c.pos + 1) == 1)) {
            static_declaration(&mut c, pass);
            return ();
        }
        if is(&mut c, view("type")) {
            alias_declaration(&mut c, pass);
        } else {
            if is(&mut c, view("const")) {
                constant_declaration(&mut c, pass);
            } else {
                if is(&mut c, view("interface")) {
                    interface_declaration(&mut c, pass);
                } else {
                    if is(&mut c, view("impl")) {
                        implementation(&mut c, pass);
                    } else {
                        if is(&mut c, view("struct")) || is(&mut c, view("enum")) {
                            decl(&mut c, pass);
                        } else {
                            func(&mut c, pass, public);
                        }
                    }
                }
            }
        }
    }
    return ();
}

// ---- expressions: eight-byte stack slots; left-to-right operands ----
fn deref<a>(c: (&a mut C), v: Val) -> Val {
    mut t = v.t;
    mut ty = v.ty;
    while ty_kind(&mut c, ty) == 7 {
        old := t;
        target := target_of(&mut c, old);
        ty = ty_arg(&mut c, ty);
        if ty_kind(&mut c, ty) == 35 {
            // A `&dyn I` value is the handle to its pair, so dereferencing it is the identity: the
            // same word is the pair dispatch reads.
            get(&mut c, old, view("%rax"));
            t = save(&mut c);
        } else {
            t = ref_load(&mut c, old, ty);
        }
        if c.raw == 0 {
            if target == 0 {
                fail(&mut c, view("reference target is not tracked"));
            }
            c
                .resources
                .push(
                    Resource {
                        slot: t,
                        ty: ty,
                        flag: 0,
                        base: old + 1,
                        field: 0,
                        via: 1,
                        place: target,
                        target: 0,
                        authority: old + 1,
                    }
                );
            owner := place_of(&mut c, old);
            n := c.bonds.len();
            for i in n {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if holder == owner && guard != 0 {
                    bond_kind(&mut c, target, loan, guard);
                }
            }
            stored_source(&mut c, t, ty);
        }
        // A `&dyn I` is where implicit dereferencing stops: the method call dispatches through the
        // pair it names rather than through the reference again.
        if borrowed_object(&mut c, ty) != 0 {
            break;
        }
    }
    return val(t, ty);
}
fn find_local<a, b>(c: (&a mut C), n: &b [u8]) -> u64 {
    mut i = c.locals.len();
    while 0 < i {
        i = i - 1;
        mut l = &c.locals[i];
        if same(view(l.name), view(n)) {
            return i + 1;
        }
    }
    return 0;
}
fn local_id<a>(c: (&a mut C), i: u64) -> u64 {
    mut l = &c.locals[i];
    return l.id;
}
fn local_ty<a>(c: (&a mut C), i: u64) -> u64 {
    mut l = &c.locals[i];
    return l.ty;
}
fn pop_locals<a>(c: (&a mut C), mark: u64) -> unit {
    while mark < c.locals.len() {
        c.locals.pop()!;
    }
    return ();
}
// Loads, addresses and stores record fields.
fn rec_load<a>(c: (&a mut C), base: u64, k: u64, address: u64) -> u64 {
    slot := word_load(&mut c, base, k, address);
    if (k == 1) & (address == 0) {
        // Word 1 read on its own is an enum's payload (record fields go through field_load): a
        // plain record there is the enum's box.
        c.boxed.push(slot);
    }
    return slot;
}
fn word_load<a>(c: (&a mut C), base: u64, k: u64, address: u64) -> u64 {
    get(&mut c, base, view("%rax"));
    if address != 0 {
        o(&mut c, view("leaq "));
    } else {
        o(&mut c, view("movq "));
    }
    on(&mut c, k * 8);
    o(&mut c, view("(%rax),%rax\n"));
    return save(&mut c);
}
fn rec_store<a>(c: (&a mut C), base: u64, k: u64, value: u64) -> unit {
    get(&mut c, base, view("%rcx"));
    get(&mut c, value, view("%rax"));
    o(&mut c, view("movq %rax,"));
    on(&mut c, k * 8);
    o(&mut c, view("(%rcx)\n"));
    return ();
}
// The word of a record a field starts at. Every field is one word today, so it is the field's
// index; it is asked here, by type, so that a record whose fields are not all one word
// (docs/design/unboxed-values.md, stage 1b) changes this answer and not the sites that read, bind,
// compare, print or drop a field. Enum tags and payloads, closure objects and `dyn` cells are words
// by position and keep calling rec_load/rec_store directly.
fn field_word<a>(c: (&a mut C), ty: u64, k: u64) -> u64 {
    if (layout_bits(&mut c, ty) & 2) == 0 {
        return k;
    }
    at := field_layout(&mut c, ty);
    return c.layout_offsets[at][k] / 2;
}
// The offsets table of a record that holds plain records inline, worked out once per type.
fn field_layout<a>(c: (&a mut C), alias: u64) -> u64 {
    ty := base_type(&mut c, alias);
    while c.layout_offsets.len() <= ty {
        c.layout_offsets.push(u64[]);
    }
    if c.layout_offsets[ty].len() != 0 {
        return ty;
    }
    d := ty_arg(&mut c, ty);
    count := c.decls[d].count;
    mut table = u64[];
    mut word = 0;
    for i in count {
        ft := field_type(&mut c, ty, i);
        if framable(&mut c, ft) {
            table.push(word * 2 + 1);
            word = word + record_words(&mut c, base_type(&mut c, ft));
        } else {
            table.push(word * 2);
            word = word + 1;
        }
    }
    table.push(word * 2);
    c.layout_offsets[ty] = table;
    return ty;
}
// A plain record: a struct or tuple with no `Drop`, whose every field is a number, a bool, a char,
// unit, a reference, a function or C pointer, or a plain record. It owns nothing, so it can be
// stored inline in the record or the vector that holds it. This is a layout fact only: the checker
// never asks it, and a plain record moves exactly as every record does (unboxed-values.md, 4).
// Layout is a property of the type alone, never of the module being compiled: the drop helpers are
// emitted after the last (raw) module, and they must lay a vector out as everyone else does.
fn plain<a>(c: (&a mut C), alias: u64) -> bool {
    if is_simd(&mut c, alias) {
        return true;
    }
    return (layout_bits(&mut c, alias) & 1) != 0;
}
// The bytes a vector element of type `elem` takes when the vector stores its elements inline - a
// plain record's words, or an `extern "C"` record's C size - and 0 for a vector of words.
fn flat_bytes<a>(c: (&a mut C), elem: u64) -> u64 {
    ty := base_type(&mut c, elem);
    // `[f32; 3][]` is a C `float[n][3]`: elements of exactly the array's bytes.
    if is_array(&mut c, ty) {
        return array_bytes(&mut c, ty);
    }
    if framable(&mut c, ty) {
        return record_words(&mut c, ty) * 8;
    }
    if is_c_record(&mut c, ty) != 0 {
        return ffi_record_size(&mut c, ty_arg(&mut c, ty));
    }
    return 0;
}
// The address of element `index` of a vector whose elements are `width` bytes inline. Checked
// against the length unless the index is proven in bounds; the address is computed in line.
fn flat_element<a>(c: (&a mut C), seq: u64, index: u64, width: u64, unchecked: bool) -> u64 {
    if !unchecked {
        return invoke(&mut c, view("rt_slotw"), three(seq, index, imm(&mut c, width)));
    }
    get(&mut c, index, view("%rcx"));
    o(&mut c, view("imulq $"));
    on(&mut c, width);
    o(&mut c, view(",%rcx\n"));
    get(&mut c, seq, view("%rax"));
    o(&mut c, view("movq (%rax),%rax\naddq %rcx,%rax\n"));
    return save(&mut c);
}
// Whether field `k` of the record `ty` is a plain record stored inline: only Grail structs and
// tuples hold them so (an enum's payload, a closure's captures and a C record keep their words).
fn inline_field<a>(c: (&a mut C), ty: u64, k: u64) -> bool {
    if (layout_bits(&mut c, ty) & 2) == 0 {
        return false;
    }
    at := field_layout(&mut c, ty);
    return (c.layout_offsets[at][k] & 1) != 0;
}
// A small enum (stage 5a): an enum with no Drop whose every payload is one word that owns nothing - a
// number, a bool, a char, unit, a reference, a function or C pointer. It is two frame words,
// {tag, payload}, the boxed layout without its box, and it is plain.
fn small_enum<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    index := ty_arg(&mut c, ty);
    d := &c.decls[index];
    if (d.is_enum == 0) || (d.drop != 0) {
        return false;
    }
    count := d.count;
    for i in count {
        ft := base_type(&mut c, field_type(&mut c, ty, i));
        k := ty_kind(&mut c, ft);
        if (k == 7) && (ty_kind(&mut c, ty_arg(&mut c, ft)) == 35) {
            // `&dyn I` is a handle to a pair in the frame that built it.
            return false;
        }
        if (k == 1) || (k == 2) || (k == 7) || (k == 12) || (k == 18) || (k == 19) || (k == 21) || (k == 22) || (k == 25) || (k == 26) {
            continue;
        }
        // A payload that is itself plain (a plain record, a small enum) is stored inline (stage 5b).
        if (k == 8) && (ft != ty) && plain(&mut c, ft) {
            continue;
        }
        return false;
    }
    return true;
}
// The words of a small enum: the tag, then the largest payload.
fn enum_words<a>(c: (&a mut C), ty: u64) -> u64 {
    d := ty_arg(&mut c, ty);
    count := c.decls[d].count;
    mut most = 1;
    for i in count {
        ft := base_type(&mut c, field_type(&mut c, ty, i));
        if (ty_kind(&mut c, ft) == 8) && framed(&mut c, ft) {
            n := record_words(&mut c, ft);
            if most < n {
                most = n;
            }
        }
    }
    return 1 + most;
}
// The payload of the enum at `xt` (of type `ety`) whose variant's payload type is `pty`: a plain
// payload of a small enum is its words inline at word 1, so the value is their address (an interior
// value: owning it copies it out); any other payload is the word there.
fn payload_load<a>(c: (&a mut C), xt: u64, ety: u64, pty: u64) -> u64 {
    if inline_payload(&mut c, ety, pty) {
        get(&mut c, xt, view("%rax"));
        o(&mut c, view("leaq 8(%rax),%rax\n"));
        slot := save(&mut c);
        c.interior.push(slot);
        return slot;
    }
    return rec_load(&mut c, xt, 1, 0);
}
// For a reference to a payload: the address of the word (rec_load address form), or for an inline
// plain payload the address of its words, which is already the reference (payload_reference).
fn payload_ref_word<a>(c: (&a mut C), xt: u64, ety: u64, pty: u64) -> u64 {
    return rec_load(&mut c, xt, 1, 1);
}
fn payload_reference<a>(c: (&a mut C), at: u64, ety: u64, pty: u64) -> u64 {
    if inline_payload(&mut c, ety, pty) {
        return at;
    }
    return word_reference(&mut c, at, pty);
}
fn inline_payload<a>(c: (&a mut C), ety: u64, pty: u64) -> bool {
    e := base_type(&mut c, ety);
    if !small_enum(&mut c, e) {
        return false;
    }
    p := base_type(&mut c, pty);
    return (ty_kind(&mut c, p) == 8) && framed(&mut c, p);
}
fn container_record<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    index := ty_arg(&mut c, ty);
    d := &c.decls[index];
    if (d.is_enum != 0) || (d.c_layout != 0) || (d.opaque != 0) {
        return false;
    }
    return !same(view(d.module), view(".closure"));
}
fn layout_bits<a>(c: (&a mut C), alias: u64) -> u64 {
    ty := base_type(&mut c, alias);
    // An array of plain data is plain: its bytes are stored inline wherever it is held. One that
    // owns its elements is not (until records with drops are inline, unboxed-values.md stage 4).
    if is_array(&mut c, ty) {
        if needs_drop(&mut c, ty_arg(&mut c, ty)) {
            return 0;
        }
        return 1;
    }
    while c.layout_memo.len() <= ty {
        c.layout_memo.push(0);
    }
    if c.layout_memo[ty] != 0 {
        return c.layout_memo[ty] - 1;
    }
    // A record being worked out is not plain to itself (a record cannot hold itself by value).
    c.layout_memo[ty] = 1;
    mut bits = 0;
    if small_enum(&mut c, ty) {
        // Plain, and held as its words (5a): a small enum is frame words wherever it is held.
        bits = 5;
    }
    if container_record(&mut c, ty) {
        d := ty_arg(&mut c, ty);
        mut all = c.decls[d].drop == 0;
        mut holds = false;
        for i in c.decls[d].count {
            ft := base_type(&mut c, field_type(&mut c, ty, i));
            k := ty_kind(&mut c, ft);
            if (k == 8) || (k == 32) {
                if (layout_bits(&mut c, ft) & 1) != 0 {
                    holds = true;
                } else {
                    all = false;
                }
            } else if !((k == 1) || (k == 2) || (k == 7) || (k == 12) || (k == 18) || (k == 19) || (k == 21) || (k == 22) || (k == 25) || (k == 26)) {
                all = false;
            }
        }
        if all {
            bits = bits | 1;
        }
        if holds {
            bits = bits | 2;
        }
        // Framable (unboxed-values.md, stage 4): held as its words wherever it is held - in a frame,
        // inline in another record, flat in a vector - whatever it owns. Every struct and tuple is,
        // but one being worked out is not to itself (a by-value field of its own type would be
        // infinite), so such a field stays a boxed word.
        bits = bits | 4;
        for i in c.decls[d].count {
            ft := base_type(&mut c, field_type(&mut c, ty, i));
            if framable(&mut c, ft) {
                bits = bits | 2;
            }
        }
    }
    c.layout_memo[ty] = bits + 1;
    return bits;
}
// Whether `ty` is held as its own words (layout bit 4): a struct, a tuple or an array.
fn framable<a>(c: (&a mut C), alias: u64) -> bool {
    ty := base_type(&mut c, alias);
    // An array, and a SIMD vector (docs/design/simd.md), are always frame values.
    if is_array(&mut c, ty) || is_simd(&mut c, ty) {
        return true;
    }
    return (layout_bits(&mut c, ty) & 4) != 0;
}
// A framed value that owns something, so its words have an in-place drop: a struct or tuple that is
// not plain, or an array of owners.
fn frame_drops<a>(c: (&a mut C), ty: u64) -> bool {
    if is_array(&mut c, ty) {
        return array_owned(&mut c, ty);
    }
    return framed(&mut c, ty) && !plain(&mut c, ty);
}
// A plain record field read as a value: the address of its words inside the container.
fn inline_address<a>(c: (&a mut C), base: u64, ty: u64, k: u64) -> u64 {
    get(&mut c, base, view("%rax"));
    o(&mut c, view("leaq "));
    on(&mut c, field_word(&mut c, ty, k) * 8);
    o(&mut c, view("(%rax),%rax\n"));
    slot := save(&mut c);
    c.interior.push(slot);
    return slot;
}
// The push of an inline element: a plain record's source is frame words and stays; an extern "C"
// record's source is a box, which the push frees.
fn flat_push<a>(c: (&a mut C), elem: u64) -> string {
    if framed(&mut c, elem) {
        return "rt_pushwk";
    }
    return "rt_pushw";
}
// An enum whose payload has been taken: a boxed one's block is freed; a small one (docs/design/
// unboxed-values.md, stage 5a) is frame words and has none.
// The enum `xt` with its tag replaced by `tag`, as type `ty`: a fresh small enum in the frame, or the
// runtime's retag of a boxed one (which frees the old block).
// `from` is the type `xt` has: a small enum is frame words, any other a block this frees.
fn retag_enum<a>(c: (&a mut C), xt: u64, tag: u64, ty: u64, from: u64) -> u64 {
    small := framed(&mut c, from);
    if !framed(&mut c, ty) {
        if small {
            // Into a boxed enum: a plain payload becomes a box of its own, chosen by the source's
            // variant at run time; a word payload is the word.
            payload := word_load(&mut c, xt, 1, 0);
            src := base_type(&mut c, from);
            d := ty_arg(&mut c, src);
            count := c.decls[d].count;
            done := label(&mut c);
            for j in count {
                pj := field_type(&mut c, src, j);
                if inline_payload(&mut c, src, pj) {
                    next := label(&mut c);
                    get(&mut c, xt, view("%rax"));
                    o(&mut c, view("cmpq $"));
                    on(&mut c, j);
                    o(&mut c, view(",(%rax)\n"));
                    jump(&mut c, view("jne"), next);
                    get(&mut c, xt, view("%rax"));
                    o(&mut c, view("leaq 8(%rax),%rax\n"));
                    at := save(&mut c);
                    boxed := frame_box(&mut c, at, pj);
                    get(&mut c, boxed, view("%rax"));
                    o(&mut c, view("movq %rax,"));
                    stack_slot(&mut c, payload);
                    c.out.push(10);
                    jump(&mut c, view("jmp"), done);
                    mark(&mut c, next);
                }
            }
            mark(&mut c, done);
            return invoke(&mut c, view("rt_enum"), two(tag, payload));
        }
        return invoke(&mut c, view("rt_enum_retag"), two(xt, tag));
    }
    if small {
        // Same payload words, new tag: a copy of the whole value.
        words := enum_words(&mut c, base_type(&mut c, from));
        n := frame_alloc(&mut c, enum_words(&mut c, base_type(&mut c, ty)));
        get(&mut c, xt, view("%rdx"));
        get(&mut c, n, view("%rcx"));
        for k in words {
            o(&mut c, view("movq "));
            on(&mut c, k * 8);
            o(&mut c, view("(%rdx),%rax\nmovq %rax,"));
            on(&mut c, k * 8);
            o(&mut c, view("(%rcx)\n"));
        }
        get(&mut c, tag, view("%rax"));
        o(&mut c, view("movq %rax,(%rcx)\n"));
        return n;
    }
    payload := word_load(&mut c, xt, 1, 0);
    n := enum_frame(&mut c, tag, payload, ty, 1);
    invoke(&mut c, view("rt_free"), one(xt));
    return n;
}
fn free_enum_shell<a>(c: (&a mut C), xt: u64, ty: u64) -> unit {
    if !framed(&mut c, ty) {
        invoke(&mut c, view("rt_free"), one(xt));
    }
    return ();
}
// A small enum's value in frame words of this site: word 0 the tag, word 1 the payload word.
// `ety` is the enum's type and `pty` the payload's (1 for none): a plain payload is copied in.
fn enum_frame<a>(c: (&a mut C), tag: u64, payload: u64, ety: u64, pty: u64) -> u64 {
    n := frame_alloc(&mut c, enum_words(&mut c, base_type(&mut c, ety)));
    get(&mut c, n, view("%rcx"));
    get(&mut c, tag, view("%rax"));
    o(&mut c, view("movq %rax,(%rcx)\n"));
    if inline_payload(&mut c, ety, pty) {
        words := record_words(&mut c, base_type(&mut c, pty));
        get(&mut c, payload, view("%rdx"));
        for k in words {
            o(&mut c, view("movq "));
            on(&mut c, k * 8);
            o(&mut c, view("(%rdx),%rax\nmovq %rax,"));
            on(&mut c, 8 + k * 8);
            o(&mut c, view("(%rcx)\n"));
        }
        return n;
    }
    get(&mut c, payload, view("%rax"));
    o(&mut c, view("movq %rax,8(%rcx)\n"));
    return n;
}
// Whether `ty` is a plain record, which lives in the frame (docs/design/unboxed-values.md, stage 3a):
// its value is the address of frame words, its drop frees nothing, and a holder that keeps it past
// the statement boxes it.
fn framed<a>(c: (&a mut C), ty: u64) -> bool {
    // An array is always frame storage (docs/design/fixed-arrays.md), whatever the switch says.
    if is_array(&mut c, ty) {
        return true;
    }
    return framable(&mut c, ty);
}
// N adjacent fresh frame slots holding one value, declared to every pass by an aggregate fact
// (llvm::fact_aggregate), laid out as a DynPair is: word 0 is the slot allocated last, the lowest
// address, and word j is `word0 - j`. Returns a slot holding word 0's address.
fn frame_alloc<a>(c: (&a mut C), words: u64) -> u64 {
    mut first = 0;
    for j in words {
        first = fresh(&mut c);
    }
    if c.facts_fn.len() != 0 {
        llvm::fact_aggregate(&mut c.facts, copy_bytes(view(c.facts_fn)), first, words);
    }
    o(&mut c, view("leaq "));
    stack_slot(&mut c, first);
    o(&mut c, view(",%rax\n"));
    return save(&mut c);
}
fn take_temp<a>(c: (&a mut C), slot: u64) -> bool {
    for i in c.temps.len() {
        if c.temps[i] == slot {
            c.temps[i] = 18446744073709551615;
            return true;
        }
    }
    return false;
}
// The words of a framed result just returned in rax (and rdx), stored into fresh frame words.
fn frame_from_registers<a>(c: (&a mut C), words: u64) -> u64 {
    mut first = 0;
    for j in words {
        first = fresh(&mut c);
    }
    if c.facts_fn.len() != 0 {
        llvm::fact_aggregate(&mut c.facts, copy_bytes(view(c.facts_fn)), first, words);
    }
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, first);
    c.out.push(10);
    if words == 2 {
        o(&mut c, view("movq %rdx,"));
        stack_slot(&mut c, first - 1);
        c.out.push(10);
    }
    o(&mut c, view("leaq "));
    stack_slot(&mut c, first);
    o(&mut c, view(",%rax\n"));
    return save(&mut c);
}
// Loads the value a `ret` returns: a framed value's words in rax:rdx (frame_result), any other's word.
fn return_value<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if framed(&mut c, ty) {
        frame_result(&mut c, slot, ty);
    } else {
        get(&mut c, slot, view("%rax"));
    }
    return ();
}
// Returns the framed record at `slot`: up to two words in rax:rdx (the second live at the `ret`, a
// fact like a returned DynPair's), a larger one as a box until it has a destination pointer.
fn frame_result<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    words := record_words(&mut c, base_type(&mut c, ty));
    if words > 2 {
        if c.result_dest == 0 {
            fail(&mut c, view("internal: a result of more than two words without a destination"));
        }
        // Into the caller's words, whose address is also the returned value.
        get(&mut c, slot, view("%rcx"));
        get(&mut c, c.result_dest - 1, view("%rdx"));
        for k in words {
            o(&mut c, view("movq "));
            on(&mut c, k * 8);
            o(&mut c, view("(%rcx),%rax\nmovq %rax,"));
            on(&mut c, k * 8);
            o(&mut c, view("(%rdx)\n"));
        }
        o(&mut c, view("movq %rdx,%rax\n"));
        return ();
    }
    if (words == 2) && is_simd(&mut c, ty) {
        // A 16-byte vector leaves as the two result words through `simd.topair`, so its storage is
        // only ever accessed as a vector (llvm.grl, `lift_simd`).
        dyn_result(&mut c);
        zero := imm(&mut c, 0);
        get(&mut c, zero, view("%rdi"));
        get(&mut c, slot, view("%rsi"));
        get(&mut c, zero, view("%rcx"));
        mut line = copy_bytes(view("simd.topair "));
        push_bytes(&mut line, view(simd_shape(&mut c, ty)));
        line.push(10);
        o(&mut c, view(line));
        return ();
    }
    if words == 2 {
        dyn_result(&mut c);
        get(&mut c, slot, view("%rcx"));
        o(&mut c, view("movq 8(%rcx),%rdx\nmovq (%rcx),%rax\n"));
        return ();
    }
    get(&mut c, slot, view("%rcx"));
    o(&mut c, view("movq (%rcx),%rax\n"));
    return ();
}
// A copy of the framed record at the address in `src`, in fresh frame slots of this site.
fn frame_copy<a>(c: (&a mut C), src: u64, ty: u64) -> u64 {
    if is_simd(&mut c, ty) {
        return simd_emit(&mut c, view("copy"), base_type(&mut c, ty), base_type(&mut c, ty), src, SIMD_NONE, SIMD_NONE, SIMD_NONE, 0, false);
    }
    words := record_words(&mut c, base_type(&mut c, ty));
    dst := frame_alloc(&mut c, words);
    get(&mut c, src, view("%rcx"));
    get(&mut c, dst, view("%rdx"));
    for k in words {
        o(&mut c, view("movq "));
        on(&mut c, k * 8);
        o(&mut c, view("(%rcx),%rax\nmovq %rax,"));
        on(&mut c, k * 8);
        o(&mut c, view("(%rdx)\n"));
    }
    return dst;
}
// A box holding a copy of the framed record at `src`: what a holder that outlives the statement
// stores (an enum payload, a closure capture, a Mutex payload, a dyn cell, a returned value).
fn frame_box<a>(c: (&a mut C), src: u64, ty: u64) -> u64 {
    bytes := imm(&mut c, record_words(&mut c, base_type(&mut c, ty)) * 8);
    return invoke(&mut c, view("rt_flat_box"), two(src, bytes));
}
// Rewrites `slot`, which holds a framed record's box, to hold a frame copy, and frees the box.
fn unbox_into_frame<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    copy := frame_copy(&mut c, slot, ty);
    invoke(&mut c, view("rt_free"), one(slot));
    get(&mut c, copy, view("%rax"));
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    return ();
}
// The drop of a holder's word that holds `ty`: for a framed record it is the holder's box, freed;
// for anything else the type's drop.
fn holder_drop<a>(c: (&a mut C), ty: u64) -> unit {
    if array_owned(&mut c, ty) {
        // An array has no boxed helper: its elements dropped in place, then the holder's box freed.
        o(&mut c, view("pushq %rdi\npushq %rdi\n"));
        call_out(&mut c, view(drop_in_place_ref(&mut c, ty)));
        o(&mut c, view("popq %rdi\npopq %rdi\n"));
        call_out(&mut c, view("rt_free"));
        return ();
    }
    if framed(&mut c, ty) && !frame_drops(&mut c, ty) {
        call_out(&mut c, view("rt_free"));
        return ();
    }
    if framed(&mut c, ty) {
        // The holder's box: its owners dropped in place, then the box freed (the boxed helper).
        call_out(&mut c, view(drop_ref_name(&mut c, ty)));
        return ();
    }
    drop_call(&mut c, ty);
    return ();
}
// A value that is about to be owned or moved and is still an interior address gets a box of its
// own holding a copy of the words, and the slot holds the box from here on.
fn materialise<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    // An interior array is copied into storage of its own when it is bound or moved (move_value).
    if is_array(&mut c, ty) {
        return ();
    }
    if framed(&mut c, ty) {
        for i in c.boxed.len() {
            if c.boxed[i] == slot {
                c.boxed[i] = 18446744073709551615;
                unbox_into_frame(&mut c, slot, ty);
                return ();
            }
        }
    }
    if c.interior.len() == 0 {
        return ();
    }
    mut found = c.interior.len();
    for i in c.interior.len() {
        if c.interior[i] == slot {
            found = i;
        }
    }
    if found == c.interior.len() {
        return ();
    }
    size := flat_bytes(&mut c, ty);
    if size == 0 {
        return ();
    }
    c.interior[found] = 18446744073709551615;
    if framed(&mut c, ty) {
        copy := frame_copy(&mut c, slot, ty);
        if frame_drops(&mut c, ty) {
            // The words moved: the place they came from (a field held inline, an element) is left
            // all zero, which its holder's in-place drop reads as nothing to drop (a live word of 0).
            words := record_words(&mut c, base_type(&mut c, ty));
            get(&mut c, slot, view("%rcx"));
            for j in words {
                o(&mut c, view("movq $0,"));
                on(&mut c, j * 8);
                o(&mut c, view("(%rcx)\n"));
            }
        }
        get(&mut c, copy, view("%rax"));
        o(&mut c, view("movq %rax,"));
        stack_slot(&mut c, slot);
        c.out.push(10);
        return ();
    }
    bytes := imm(&mut c, size);
    box := invoke(&mut c, view("rt_flat_box"), two(slot, bytes));
    get(&mut c, box, view("%rax"));
    o(&mut c, view("movq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    return ();
}
// Moves the boxed plain record `value` into the words at `dst`, and frees the box.
fn copy_into<a>(c: (&a mut C), dst: u64, value: u64, ty: u64) -> unit {
    if is_array(&mut c, ty) {
        // An array's storage is the frame's, never a box to free.
        array_copy(&mut c, dst, value, array_bytes(&mut c, ty));
        return ();
    }
    words := record_words(&mut c, base_type(&mut c, ty));
    bytes := imm(&mut c, words * 8);
    invoke(&mut c, view("rt_copy_bytes"), three(dst, value, bytes));
    if !framed(&mut c, ty) {
        invoke(&mut c, view("rt_free"), one(value));
    }
    return ();
}
// A reference to field `k`: its interior address when the field is stored inline, else the
// reference made from the field's word.
fn field_reference<a>(c: (&a mut C), base: u64, ty: u64, k: u64) -> u64 {
    if inline_field(&mut c, ty, k) {
        // A reference, not a value: it is never owned, so it is not an interior value.
        slot := inline_address(&mut c, base, ty, k);
        c.interior.pop();
        return slot;
    }
    at := field_load(&mut c, base, ty, k, 1);
    return word_reference(&mut c, at, field_type(&mut c, ty, k));
}
// The words a record's own storage takes: a word per field, or an `extern "C"` record's C size.
fn record_words<a>(c: (&a mut C), ty: u64) -> u64 {
    if is_simd(&mut c, ty) {
        return simd_words(&mut c, ty);
    }
    if is_array(&mut c, ty) {
        return (array_bytes(&mut c, ty) + 7) / 8;
    }
    if small_enum(&mut c, ty) {
        return enum_words(&mut c, ty);
    }
    d := ty_arg(&mut c, ty);
    if c.decls[d].c_layout != 0 {
        return ffi_record_words(&mut c, d);
    }
    live := u64(live_word(&mut c, ty));
    if (layout_bits(&mut c, ty) & 2) == 0 {
        return c.decls[d].count + live;
    }
    at := field_layout(&mut c, ty);
    count := c.layout_offsets[at].len() - 1;
    return c.layout_offsets[at][count] / 2 + live;
}
// Whether the struct `ty` carries a live word after its fields (unboxed-values.md, stage 4): one
// with its own `Drop`. Its constructor sets the word to 1; moving it out of the place that holds it
// leaves every word 0, and its in-place drop does nothing - its `drop` included - when the word is 0.
// A struct without its own `Drop` needs none: its owners' words are 0 when absent.
fn live_word<a>(c: (&a mut C), alias: u64) -> bool {
    ty := base_type(&mut c, alias);
    if (ty == 0) || (ty_kind(&mut c, ty) != 8) || (c.raw != 0) {
        return false;
    }
    index := ty_arg(&mut c, ty);
    d := &c.decls[index];
    return (d.drop != 0) && (d.is_enum == 0) && (d.c_layout == 0);
}
fn field_store<a>(c: (&a mut C), base: u64, ty: u64, k: u64, value: u64) -> unit {
    if inline_field(&mut c, ty, k) {
        get(&mut c, base, view("%rax"));
        o(&mut c, view("leaq "));
        on(&mut c, field_word(&mut c, ty, k) * 8);
        o(&mut c, view("(%rax),%rax\n"));
        dst := save(&mut c);
        copy_into(&mut c, dst, value, field_type(&mut c, ty, k));
        return ();
    }
    word := field_word(&mut c, ty, k);
    rec_store(&mut c, base, word, value);
    return ();
}
// The record type of the value a slot holds, for the two places that reach a field through a slot
// rather than through a typed value: what owns the slot, or what the slot's reference refers to.
fn held_record<a>(c: (&a mut C), slot: u64) -> u64 {
    n := resource(&mut c, slot);
    if n == 0 {
        fail(&mut c, view("internal: a field is reached through a value with no record type"));
    }
    mut ty = c.resources[n - 1].ty;
    if ty_kind(&mut c, ty) == 7 {
        ty = ty_arg(&mut c, ty);
    }
    return base_type(&mut c, ty);
}
fn field_load<a>(c: (&a mut C), base: u64, ty: u64, k: u64, address: u64) -> u64 {
    if inline_field(&mut c, ty, k) {
        return inline_address(&mut c, base, ty, k);
    }
    word := field_word(&mut c, ty, k);
    return word_load(&mut c, base, word, address);
}
// C-layout field access: exact byte offset, exact field width. Fields narrower than
// eight bytes use portable byte-wise helpers so every target stays correct without
// new instruction selection.
// The runtime copy parameters of a C array field's element: (size, signed, kind, record words),
// kind 0 an integer or word, 1 an f32, 2 an extern record.
fn carray_elem_of<a>(c: (&a mut C), elem: u64) -> u64[] {
    size := ffi_field_size(&mut c, elem);
    mut signed = 0;
    mut kind = 0;
    mut words = 0;
    if ty_kind(&mut c, elem) == 18 {
        signed = ty_mode(&mut c, elem);
    }
    if is_f32(&mut c, elem) {
        kind = 1;
    }
    if (ty_kind(&mut c, elem) == 18) & (ty_arg(&mut c, elem) == 8) & (signed == 0) {
        kind = 3;
    }
    if narrow_code(&mut c, elem) != 0 {
        // f32/u32/i32 vectors hold 32-bit units laid out as C lays out the array.
        kind = 4;
    }
    if is_c_record(&mut c, elem) != 0 {
        kind = 2;
        rd := ty_arg(&mut c, elem);
        words = ffi_record_words(&mut c, rd);
    }
    return u64[size, signed, kind, words];
}
fn cfield_load<a>(c: (&a mut C), base: u64, d: u64, k: u64, address: u64) -> u64 {
    ty := field_ty(&mut c, d, k);
    off := ffi_offset(&mut c, d, k);
    size := ffi_field_size(&mut c, ty);
    more := exchange(&mut c.cfield_more, 0);
    if ty_kind(&mut c, ty) == 32 {
        // An array field is its bytes in place, as an embedded record's are: a reference, an index,
        // a method or an assignment uses that interior address; a whole read copies the elements
        // into storage of the reader's own, since a C struct is plain data.
        get(&mut c, base, view("%rax"));
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        if address != 0 {
            c.caddr.push(at);
            c.caddr.push(ty);
            return at;
        }
        if (more != 0) || (kind(&mut c) == 91) || (kind(&mut c) == 46) {
            return at;
        }
        copy := array_fresh_copy(&mut c, at, ty);
        c.array_fresh.push(copy);
        return copy;
    }
    if is_c_record(&mut c, ty) != 0 {
        // The embedded record's bytes start at base+off: a further projection (o.inner.x) and an
        // assignment place (o.inner = r) use that interior address; a value read copies them
        // into a fresh record, since C structs are plain data.
        get(&mut c, base, view("%rax"));
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        if address != 0 {
            c.caddr.push(at);
            c.caddr.push(ty);
            return at;
        }
        if more != 0 {
            return at;
        }
        return c_record_copy(&mut c, at, ty);
    }
    get(&mut c, base, view("%rax"));
    if address != 0 {
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        if size != 8 || is_f32(&mut c, ty) {
            c.caddr.push(at);
            c.caddr.push(ty);
        }
        return at;
    }
    if size == 8 {
        o(&mut c, view("movq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        return save(&mut c);
    }
    o(&mut c, view("addq $"));
    on(&mut c, off);
    o(&mut c, view(",%rax\n"));
    addr := save(&mut c);
    mut signed = 0;
    if ty_kind(&mut c, ty) == 18 {
        signed = ty_mode(&mut c, ty);
    }
    if is_f32(&mut c, ty) {
        // binary32 bits in memory; Grail holds f32 values as binary64 words.
        return sized_load(&mut c, addr, size, 0, 1);
    }
    return sized_load(&mut c, addr, size, signed, 0);
}
// ---- sized memory access ------------------------------------------------------------------------
// The one emitter for a value narrower than a word behind an address: a field of a C-layout record,
// an element of a narrow vector, and whatever else stores its values at their own width.
// `width` is 1, 2, 4 or 8 bytes; `signed` asks for sign extension to the word; `float` (width 4) says
// the bytes are a binary32, which Grail holds as the binary64 word of the same value. Any bounds
// check is the caller's and comes first: these take an address that is already known to be valid.
//
// The native backend emits the access in line, at every width on every target. The LLVM path and
// the unsafe runtime keep the calls (`rt_load_sized`, `rt_store_sized`).
fn sized_inline<a>(c: (&a C), width: u64) -> bool {
    if !float_inline(&c) {
        return false;
    }
    return (width == 1) || (width == 2) || (width == 4) || (width == 8);
}
fn sized_load<a>(c: (&a mut C), addr: u64, width: u64, signed: u64, float: u64) -> u64 {
    if !sized_inline(&c, width) {
        w := imm(&mut c, width);
        sign := imm(&mut c, signed);
        loaded := invoke(&mut c, view("rt_load_sized"), three(addr, w, sign));
        if float != 0 {
            get(&mut c, loaded, view("%rax"));
            ffi_f32_widen(&mut c);
            return save(&mut c);
        }
        return loaded;
    }
    get(&mut c, addr, view("%rax"));
    if width == 8 {
        o(&mut c, view("movq (%rax),%rax\n"));
    }
    if width == 4 {
        o(&mut c, view("movl (%rax),%eax\n"));
        if float != 0 {
            ffi_f32_widen(&mut c);
        } else if signed != 0 {
            o(&mut c, view("shlq $32,%rax\nsarq $32,%rax\n"));
        }
    }
    if width == 2 {
        if signed != 0 {
            o(&mut c, view("movswq (%rax),%rax\n"));
        } else {
            o(&mut c, view("movzwq (%rax),%rax\n"));
        }
    }
    if width == 1 {
        o(&mut c, view("movzbq (%rax),%rax\n"));
        if signed != 0 {
            o(&mut c, view("shlq $56,%rax\nsarq $56,%rax\n"));
        }
    }
    return save(&mut c);
}
// The store: `value` is the word Grail holds, of which the low `width` bytes are written - after
// narrowing to binary32 when `float` says the destination is one.
fn sized_store<a>(c: (&a mut C), addr: u64, value: u64, width: u64, float: u64) -> unit {
    mut stored = value;
    if float != 0 {
        get(&mut c, value, view("%rax"));
        if (c.target == 0) || (c.target == 3) {
            o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\nmovd %xmm0,%eax\n"));
        } else {
            o(&mut c, view("cf32bits\n"));
        }
        if sized_inline(&c, width) {
            get(&mut c, addr, view("%rcx"));
            o(&mut c, view("movl %eax,(%rcx)\n"));
            return ();
        }
        stored = save(&mut c);
    }
    if !sized_inline(&c, width) {
        w := imm(&mut c, width);
        invoke(&mut c, view("rt_store_sized"), three(addr, stored, w));
        return ();
    }
    get(&mut c, stored, view("%rax"));
    get(&mut c, addr, view("%rcx"));
    if width == 8 {
        o(&mut c, view("movq %rax,(%rcx)\n"));
    }
    if width == 4 {
        o(&mut c, view("movl %eax,(%rcx)\n"));
    }
    if width == 2 {
        o(&mut c, view("movw %ax,(%rcx)\n"));
    }
    if width == 1 {
        o(&mut c, view("movb %al,(%rcx)\n"));
    }
    return ();
}
fn ffi_f32_widen<a>(c: (&a mut C)) -> unit {
    if (c.target == 0) || (c.target == 3) {
        o(&mut c, view("movd %eax,%xmm0\ncvtss2sd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
    } else {
        o(&mut c, view("cf32widen\n"));
    }
    return ();
}
fn cfield_store<a>(c: (&a mut C), base: u64, d: u64, k: u64, value: u64) -> unit {
    ty := field_ty(&mut c, d, k);
    off := ffi_offset(&mut c, d, k);
    size := ffi_field_size(&mut c, ty);
    if ty_kind(&mut c, ty) == 32 {
        // A whole array into the field: N elements, the count fixed by the type.
        get(&mut c, base, view("%rax"));
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        array_copy(&mut c, at, value, array_bytes(&mut c, ty));
        return ();
    }
    if is_c_record(&mut c, ty) != 0 {
        get(&mut c, base, view("%rax"));
        o(&mut c, view("leaq "));
        on(&mut c, off);
        o(&mut c, view("(%rax),%rax\n"));
        at := save(&mut c);
        caddr_store(&mut c, at, ty, value);
        return ();
    }
    if size == 8 {
        get(&mut c, base, view("%rcx"));
        get(&mut c, value, view("%rax"));
        o(&mut c, view("movq %rax,"));
        on(&mut c, off);
        o(&mut c, view("(%rcx)\n"));
        return ();
    }
    if sized_inline(&c, size) {
        get(&mut c, base, view("%rax"));
        o(&mut c, view("addq $"));
        on(&mut c, off);
        o(&mut c, view(",%rax\n"));
        at := save(&mut c);
        sized_store(&mut c, at, value, size, u64(is_f32(&mut c, ty)));
        return ();
    }
    mut stored = value;
    if is_f32(&mut c, ty) {
        get(&mut c, value, view("%rax"));
        if (c.target == 0) || (c.target == 3) {
            o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\nmovd %xmm0,%eax\n"));
        } else {
            o(&mut c, view("cf32bits\n"));
        }
        stored = save(&mut c);
    }
    get(&mut c, base, view("%rax"));
    o(&mut c, view("addq $"));
    on(&mut c, off);
    o(&mut c, view(",%rax\n"));
    addr := save(&mut c);
    w := imm(&mut c, size);
    invoke(&mut c, view("rt_store_sized"), three(addr, stored, w));
    return ();
}
// A fresh record holding a copy of the C record bytes at `src`.
fn c_record_copy<a>(c: (&a mut C), src: u64, ty: u64) -> u64 {
    d := ty_arg(&mut c, ty);
    words := ffi_record_words(&mut c, d);
    n := imm(&mut c, words);
    fresh := invoke(&mut c, view("rt_rec"), one(n));
    size := ffi_record_size(&mut c, d);
    bytes := imm(&mut c, size);
    invoke(&mut c, view("rt_copy_bytes"), three(fresh, src, bytes));
    return fresh;
}
// The C field type behind an address slot made by cfield_load, or 0 for an ordinary word.
fn caddr_ty<a>(c: (&a mut C), slot: u64) -> u64 {
    mut i = c.caddr.len();
    while 1 < i {
        i = i - 2;
        if c.caddr[i] == slot {
            return c.caddr[i + 1];
        }
    }
    return 0;
}
// 1 when `slot` is the place of an embedded record: an interior address, not a slot holding a
// pointer to one. Storage written through such a place is bytes, so the old value is overwritten
// rather than dropped, and the write copies bytes instead of storing a pointer.
fn embedded_place<a>(c: (&a mut C), slot: u64) -> bool {
    mut i = c.embedded.len();
    while 1 < i {
        i = i - 2;
        if c.embedded[i] == slot {
            return true;
        }
    }
    return false;
}
// Loads a narrow C field through its address slot as a Grail word (sign- or zero-extended,
// f32 widened to the binary64 word Grail holds).
fn caddr_load<a>(c: (&a mut C), slot: u64, ty: u64) -> u64 {
    if is_array(&mut c, ty) {
        return slot;
    }
    mut signed = 0;
    if ty_kind(&mut c, ty) == 18 {
        signed = ty_mode(&mut c, ty);
    }
    size := ffi_field_size(&mut c, ty);
    return sized_load(&mut c, slot, size, signed, u64(is_f32(&mut c, ty)));
}
// Stores a Grail word into a narrow C field through its address slot.
fn caddr_store<a>(c: (&a mut C), slot: u64, ty: u64, value: u64) -> unit {
    if is_array(&mut c, ty) {
        array_copy(&mut c, slot, value, array_bytes(&mut c, ty));
        return ();
    }
    if is_c_record(&mut c, ty) != 0 {
        // The moved-in record's bytes replace the embedded ones; its own buffer is released.
        d := ty_arg(&mut c, ty);
        size := ffi_record_size(&mut c, d);
        bytes := imm(&mut c, size);
        invoke(&mut c, view("rt_copy_bytes"), three(slot, value, bytes));
        invoke(&mut c, view("rt_free"), one(value));
        return ();
    }
    size := ffi_field_size(&mut c, ty);
    sized_store(&mut c, slot, value, size, u64(is_f32(&mut c, ty)));
    return ();
}
// Narrow vectors (`f32[]`, `u32[]`, `i32[]`) store 4-byte elements: 1 for f32, 2 for u32, 3 for
// i32, 0 for any other element type.
fn narrow_code<a>(c: (&a mut C), alias: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    // A specialization's type parameter is an alias of the concrete type.
    elem := base_type(&mut c, alias);
    if is_f32(&mut c, elem) {
        return 1;
    }
    if (elem != 0) & (ty_kind(&mut c, elem) == 18) {
        if ty_arg(&mut c, elem) == 32 {
            return 2 + (ty_mode(&mut c, elem) & 1);
        }
    }
    return 0;
}
fn narrow_vector<a>(c: (&a mut C), ty: u64) -> u64 {
    if c.raw != 0 {
        return 0;
    }
    vty := base_type(&mut c, ty);
    if ty_kind(&mut c, vty) != 6 {
        return 0;
    }
    elem := ty_arg(&mut c, vty);
    return narrow_code(&mut c, elem);
}
// A value as the 32-bit unit a narrow vector stores: an f32's binary32 bits; an integer as is (the
// store keeps its low 32 bits).
fn narrow_encode<a>(c: (&a mut C), code: u64, value: u64) -> u64 {
    if code != 1 {
        return value;
    }
    get(&mut c, value, view("%rax"));
    if (c.target == 0) || (c.target == 3) {
        o(&mut c, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\nmovd %xmm0,%eax\n"));
    } else {
        o(&mut c, view("cf32bits\n"));
    }
    return save(&mut c);
}
// A loaded 32-bit unit (zero-extended) as the word Grail holds: f32 widened, i32 sign-extended.
fn narrow_decode<a>(c: (&a mut C), code: u64, unit: u64) -> u64 {
    if code == 2 {
        return unit;
    }
    get(&mut c, unit, view("%rax"));
    if code == 1 {
        ffi_f32_widen(&mut c);
    } else {
        o(&mut c, view("shlq $32,%rax\nsarq $32,%rax\n"));
    }
    return save(&mut c);
}
// How many integer argument words this target's callback prologue can read: the Win64 thunk under
// the C symbol moves four registers plus the fifth and sixth stack words into Grail's registers, and
// x86-64 SysV, AArch64 and RISC-V 64 read their own integer argument registers.
fn callback_int_words(abi: u64) -> u64 {
    if abi == 1 {
        return 6;
    }
    return ffi_int_regs(abi);
}
// Every parameter list a C caller can produce is readable by a callback prologue: the words past
// the argument registers are read from the caller's stack (callback_params), so nothing is refused.
fn ffi_callback_fits<a>(c: (&a mut C), first: u64, count: u64) -> unit {
    return ();
}
// An exported callback's prologue: each parameter is read from where a C caller put it (Win64:
// positionally, the thunk having moved rcx/rdx/r8/r9 and stack words five and six into Grail's
// registers; SysV/AAPCS64/RV64: integer-class parameters packed into the integer registers and
// floats into the vector registers), f32 widened, narrow integers extended, then spilled.
fn callback_params<a>(c: (&a mut C), count: u64) -> unit {
    win := c.target == 3;
    x86 := c.target == 0 || win;
    rv := c.target == 2;
    // Win64 arguments arrive in Grail's registers because the thunk under the C symbol has already
    // moved them; everywhere else the C integer argument registers of the target's own ABI are read
    // directly, so the seventh and eighth words come from %r10/%r11 (x6/x7, a6/a7).
    // Past the registers the caller's stack holds the rest, in order, one 8-byte slot each: after
    // the prologue's 16-byte frame record that is 16(%rbp) on SysV, AAPCS64 and RV64 (x29/s0 is
    // the frame pointer there). On Win64 argument i sits 8+8i above the thunk's entry rsp, which
    // is 208+8i above the body's frame once the thunk's two pushes, 168 bytes, its call and the
    // body's push are accounted for; the thunk itself already moved arguments five and six.
    abi := ffi_abi(&mut c);
    regs := callback_int_words(abi);
    mut ints = 0;
    mut floats = 0;
    mut stack = 0;
    for i in count {
        // The parameter locals are the function's first bindings, in declaration order.
        ty := c.locals[i].ty;
        if is_float(&mut c, ty) {
            single := is_f32(&mut c, ty);
            // 0 vector register, 1 an integer register (RV64 only), 2 the caller's stack.
            mut place = 0;
            mut fpos = floats;
            if win {
                fpos = i;
                if 3 < i {
                    place = 2;
                }
            } else {
                if 7 < floats {
                    if rv & (ints < regs) {
                        place = 1;
                    } else {
                        place = 2;
                    }
                }
            }
            if place == 0 {
                if x86 {
                    if single {
                        o(&mut c, view("cvtss2sd %xmm"));
                        on(&mut c, fpos);
                        o(&mut c, view(",%xmm"));
                        on(&mut c, fpos);
                        c.out.push(10);
                    }
                    o(&mut c, view("movq %xmm"));
                    on(&mut c, fpos);
                    o(&mut c, view(",%rax\n"));
                } else {
                    o(&mut c, view("cbfarg "));
                    on(&mut c, fpos);
                    if single {
                        o(&mut c, view(" s"));
                    }
                    c.out.push(10);
                }
                floats = floats + 1;
            } else {
                if place == 1 {
                    // RV64 passes a float that finds no free FP register in the next integer
                    // register, as its bits.
                    o(&mut c, view("movq "));
                    o(&mut c, view(ffi_int_reg(abi, ints)));
                    o(&mut c, view(",%rax\n"));
                    ints = ints + 1;
                } else {
                    if win {
                        if 5 < i {
                            o(&mut c, view("movq "));
                            on(&mut c, 208 + 8 * i);
                            o(&mut c, view("(%rbp),%rax\n"));
                        } else {
                            // Win64 arguments five and six: the thunk moved the raw word.
                            o(&mut c, view("movq "));
                            o(&mut c, view(argreg(i)));
                            o(&mut c, view(",%rax\n"));
                        }
                    } else {
                        o(&mut c, view("movq "));
                        on(&mut c, 16 + 8 * stack);
                        o(&mut c, view("(%rbp),%rax\n"));
                        stack = stack + 1;
                    }
                }
                if single {
                    if x86 {
                        o(&mut c, view("movd %eax,%xmm0\ncvtss2sd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
                    } else {
                        o(&mut c, view("cf32widen\n"));
                    }
                }
            }
        } else {
            if win {
                if 5 < i {
                    o(&mut c, view("movq "));
                    on(&mut c, 208 + 8 * i);
                    o(&mut c, view("(%rbp),%rax\n"));
                } else {
                    o(&mut c, view("movq "));
                    o(&mut c, view(argreg(i)));
                    o(&mut c, view(",%rax\n"));
                }
            } else {
                if ints < regs {
                    o(&mut c, view("movq "));
                    o(&mut c, view(ffi_int_reg(abi, ints)));
                    o(&mut c, view(",%rax\n"));
                    ints = ints + 1;
                } else {
                    o(&mut c, view("movq "));
                    on(&mut c, 16 + 8 * stack);
                    o(&mut c, view("(%rbp),%rax\n"));
                    stack = stack + 1;
                }
            }
            suffix := ffi_narrow(&mut c, ty);
            if suffix.len() != 0 {
                if x86 {
                    ffi_x86_extend(&mut c, view(suffix));
                } else {
                    o(&mut c, view("cext "));
                    o(&mut c, view(suffix));
                    c.out.push(10);
                }
            }
        }
        o(&mut c, view("movq %rax,"));
        stack_slot(&mut c, i);
        c.out.push(10);
    }
    return ();
}
// ---- `byval` record arguments (decision B7, docs/ffi.md) ----
// One scalar leaf of an extern record. An embedded record is flattened, so a leaf's offset is
// measured from the outermost record's start.
struct FFILeaf {
    off: u64,
    size: u64,
    // 0 integer (handles, CStr and cfn words included), 1 f32, 2 f64.
    cls: u64
}
// One destination for a slice of a byval argument: dst 1 an integer argument register, 2 a float
// argument register, 3 an outgoing stack word, 4 the address of the argument's copy in an integer
// register, 5 the address of the copy in an outgoing stack word.
struct FFIMove {
    off: u64,
    size: u64,
    dst: u64,
    index: u64
}
// A whole byval argument: the moves that place its bytes, the call's argument counters after it,
// and the copy a by-reference argument needs.
struct FFIPlan {
    byval: u64,
    moves: FFIMove[],
    ints: u64,
    floats: u64,
    stack: u64,
    copies: u64,
    copy_rel: u64,
    copy_bytes: u64
}
fn ffi_empty_plan() -> FFIPlan {
    mut moves = FFIMove[];
    return FFIPlan {
        byval: 0,
        moves: moves,
        ints: 0,
        floats: 0,
        stack: 0,
        copies: 0,
        copy_rel: 0,
        copy_bytes: 0
    };
}
fn ffi_move(off: u64, size: u64, dst: u64, index: u64) -> FFIMove {
    return FFIMove { off: off, size: size, dst: dst, index: index };
}
// The scalar leaves of an extern record, embedded records flattened, in field order.
fn ffi_leaves<a>(c: (&a mut C), d: u64, base: u64) -> FFILeaf[] {
    mut out = FFILeaf[];
    count := c.decls[d].count;
    for i in count {
        ty := field_ty(&mut c, d, i);
        off := base + ffi_offset(&mut c, d, i);
        if is_c_record(&mut c, ty) != 0 {
            nested := ty_arg(&mut c, ty);
            inner := ffi_leaves(&mut c, nested, off);
            for j in inner.len() {
                leaf := inner[j];
                out.push(FFILeaf { off: leaf.off, size: leaf.size, cls: leaf.cls });
            }
        } else {
            mut cls = 0;
            if is_float(&mut c, ty) {
                cls = 2;
                if is_f32(&mut c, ty) {
                    cls = 1;
                }
            }
            out.push(FFILeaf { off: off, size: ffi_field_size(&mut c, ty), cls: cls });
        }
    }
    return out;
}
// The placement decision for one byval argument on `abi`. Entry 0 is the mode and, for mode 5, the
// entries after it are the eightbytes' classes (1 SSE, 2 INTEGER). Modes: 0 an empty record (nothing
// crosses), 1 one integer register per eightbyte, 2 the record in consecutive outgoing stack words,
// 3 one register per leaf in field order (integer leaves to integer registers, float leaves to float
// registers), 4 by reference to a copy the caller makes, 5 SysV eightbyte classes.
//
// The rules are the ABI's own and are stated again in docs/ffi.md, which is the contract:
//
// - SysV x86-64: an eightbyte is SSE when it holds only floats and INTEGER otherwise (a mixed
//   eightbyte is INTEGER), and each class draws from its own register file. Over 16 bytes, or when
//   a class has no register left, the whole record goes in the outgoing argument area (MEMORY).
// - AAPCS64: a homogeneous float aggregate of 1-4 fields of one float type travels in v0-v7, one
//   register per field. Any other composite of 16 bytes or less travels in consecutive x0-x7, one
//   register per eightbyte; a larger one is passed by reference to a caller copy. With no register
//   left for the aggregate or the address, it is passed on the stack.
// - RV64: over 2*XLEN (16 bytes) a record is passed by reference. At or below it, one or two fields
//   with at least one float take a register each in field order (float fields in fa0-fa7, integer
//   fields in a0-a7); every other shape is packed into one integer register per eightbyte.
fn ffi_byval_mode<a>(
    c: (&a mut C),
    abi: u64,
    size: u64,
    words: u64,
    leaves: (&a FFILeaf[]),
    ints: u64,
    floats: u64
) -> u64[] {
    mut decision = u64[];
    if size == 0 {
        decision.push(0);
        return decision;
    }
    if abi == 0 {
        if 16 < size {
            decision.push(2);
            return decision;
        }
        eights := ffi_align_up(size, 8) / 8;
        mut klass = u64[];
        for e in eights {
            klass.push(0);
        }
        for i in leaves.len() {
            e := leaves[i].off / 8;
            if leaves[i].cls == 0 {
                exchange(&mut klass[e], 2);
            } else {
                if klass[e] == 0 {
                    exchange(&mut klass[e], 1);
                }
            }
        }
        mut need_int = 0;
        mut need_sse = 0;
        for e in eights {
            if klass[e] == 1 {
                need_sse = need_sse + 1;
            } else {
                need_int = need_int + 1;
            }
        }
        if (6 < ints + need_int) | (8 < floats + need_sse) {
            decision.push(2);
            return decision;
        }
        decision.push(5);
        for e in eights {
            decision.push(klass[e]);
        }
        return decision;
    }
    if abi == 2 {
        mut hfa = 0;
        if (0 < leaves.len()) && (leaves.len() <= 4) && (0 < leaves[0].cls) {
            first := leaves[0].cls;
            hfa = 1;
            for i in leaves.len() {
                if leaves[i].cls != first {
                    hfa = 0;
                }
            }
        }
        if hfa != 0 {
            if floats + leaves.len() <= 8 {
                decision.push(3);
            } else {
                decision.push(2);
            }
            return decision;
        }
        if 16 < size {
            decision.push(4);
            return decision;
        }
        if 8 < ints + words {
            decision.push(2);
        } else {
            decision.push(1);
        }
        return decision;
    }
    if abi == 1 {
        // Win64: a record of 1, 2, 4 or 8 bytes travels as one integer word in its positional slot
        // (rcx/rdx/r8/r9, then the stack) - floats included, Win64 never passes a struct in xmm -
        // and any other size by reference to a caller-made copy whose address takes the slot.
        if (size == 1) || (size == 2) || (size == 4) || (size == 8) {
            if ints < 4 {
                decision.push(1);
            } else {
                decision.push(2);
            }
        } else {
            decision.push(4);
        }
        return decision;
    }
    // RV64 (abi 3).
    if 16 < size {
        decision.push(4);
        return decision;
    }
    mut nfloat = 0;
    for i in leaves.len() {
        if leaves[i].cls != 0 {
            nfloat = nfloat + 1;
        }
    }
    if (nfloat != 0) & (leaves.len() <= 2) {
        nint := leaves.len() - nfloat;
        if (8 < ints + nint) | (8 < floats + nfloat) {
            decision.push(2);
        } else {
            decision.push(3);
        }
        return decision;
    }
    if 8 < ints + words {
        decision.push(2);
    } else {
        decision.push(1);
    }
    return decision;
}
// How one byval argument is passed: the moves that place its bytes and the call's argument counters
// after it. `ints`, `floats` and `stack` are the counters the ordinary argument loop keeps, so the
// allocation of the arguments around a byval record stays in step.
fn ffi_byval_plan<a>(c: (&a mut C), d: u64, abi: u64, ints: u64, floats: u64, stack: u64, copies: u64) -> FFIPlan {
    size := ffi_record_size(&mut c, d);
    words := ffi_align_up(size, 8) / 8;
    leaves := ffi_leaves(&mut c, d, 0);
    decision := ffi_byval_mode(&mut c, abi, size, words, &leaves, ints, floats);
    mode := decision[0];
    mut ints2 = ints;
    mut floats2 = floats;
    mut stack2 = stack;
    mut copies2 = copies;
    mut copy_rel = 0;
    mut copy_bytes = 0;
    mut moves = FFIMove[];
    if mode == 1 {
        for w in words {
            moves.push(ffi_move(w * 8, 8, 1, ints2 + w));
        }
        ints2 = ints2 + words;
    }
    if mode == 2 {
        for w in words {
            moves.push(ffi_move(w * 8, 8, 3, stack2 + w));
        }
        stack2 = stack2 + words;
    }
    if mode == 3 {
        for i in leaves.len() {
            if leaves[i].cls == 0 {
                moves.push(ffi_move((leaves[i].off / 8) * 8, 8, 1, ints2));
                ints2 = ints2 + 1;
            } else {
                moves.push(ffi_move(leaves[i].off, leaves[i].size, 2, floats2));
                floats2 = floats2 + 1;
            }
        }
    }
    if mode == 4 {
        // Each copy starts 16-byte aligned (Win64 requires it; harmless elsewhere): the copy area
        // itself starts on a 16-byte boundary above the stack arguments.
        copy_rel = copies2;
        copy_bytes = ffi_align_up(size, 16);
        copies2 = copies2 + copy_bytes;
        mut regs = 8;
        if abi == 1 {
            regs = 4;
        }
        if ints2 < regs {
            moves.push(ffi_move(0, 0, 4, ints2));
            ints2 = ints2 + 1;
        } else {
            moves.push(ffi_move(0, 0, 5, stack2));
            stack2 = stack2 + 1;
        }
    }
    if mode == 5 {
        for e in decision.len() - 1 {
            mut width = size - e * 8;
            if 8 < width {
                width = 8;
            }
            if decision[e + 1] == 1 {
                moves.push(ffi_move(e * 8, width, 2, floats2));
                floats2 = floats2 + 1;
            } else {
                moves.push(ffi_move(e * 8, 8, 1, ints2));
                ints2 = ints2 + 1;
            }
        }
    }
    return FFIPlan {
        byval: 1,
        moves: moves,
        ints: ints2,
        floats: floats2,
        stack: stack2,
        copies: copies2,
        copy_rel: copy_rel,
        copy_bytes: copy_bytes
    };
}
// Places one byval argument's bytes where the plan says, making the copy a by-reference argument
// needs at `copy_base` bytes above the outgoing stack pointer.
fn ffi_byval_emit<a>(c: (&a mut C), slot: u64, plan: (&FFIPlan), copy_base: u64, x86: u64, abi: u64) -> unit {
    // Win64 stack arguments start above the callee's 32-byte register home area.
    mut home = 0;
    if abi == 1 {
        home = 32;
    }
    if 0 < plan.copy_bytes {
        for w in plan.copy_bytes / 8 {
            get(&mut c, slot, view("%rax"));
            o(&mut c, view("movq "));
            on(&mut c, w * 8);
            o(&mut c, view("(%rax),%rax\n"));
            ffi_store_stack(&mut c, x86, copy_base + w * 8);
        }
    }
    for i in plan.moves.len() {
        m := plan.moves[i];
        if (m.dst == 4) || (m.dst == 5) {
            // Passed by reference: the address of the copy, not the record's bytes.
            o(&mut c, view("leaq "));
            on(&mut c, copy_base + plan.copy_rel);
            o(&mut c, view("(%rsp),%rax\n"));
            if m.dst == 4 {
                o(&mut c, view("movq %rax,"));
                o(&mut c, view(ffi_int_reg(abi, m.index)));
                c.out.push(10);
            } else {
                ffi_store_stack(&mut c, x86, home + m.index * 8);
            }
            continue;
        }
        get(&mut c, slot, view("%rax"));
        // A half-filled SSE eightbyte - a 12-byte record of floats, say - is 4 bytes wide: load it
        // with the matching width, because `movl ...,%rax` is not an instruction.
        mut wide = 1;
        if m.size < 8 {
            o(&mut c, view("movl "));
            wide = 0;
        } else {
            o(&mut c, view("movq "));
        }
        on(&mut c, m.off);
        if wide != 0 {
            o(&mut c, view("(%rax),%rax\n"));
        } else {
            o(&mut c, view("(%rax),%eax\n"));
        }
        if m.dst == 1 {
            o(&mut c, view("movq %rax,"));
            o(&mut c, view(ffi_int_reg(abi, m.index)));
            c.out.push(10);
        }
        if m.dst == 2 {
            ffi_float_arg(&mut c, m.index, m.size == 4, x86);
        }
        if m.dst == 3 {
            ffi_store_stack(&mut c, x86, home + m.index * 8);
        }
    }
    return ();
}
// %rax's word as the bits of float argument register `index`, without conversion: a record's bytes
// are already the field's representation.
fn ffi_float_arg<a>(c: (&a mut C), index: u64, single: bool, x86: u64) -> unit {
    if x86 != 0 {
        if single {
            o(&mut c, view("movd %eax,%xmm"));
        } else {
            o(&mut c, view("movq %rax,%xmm"));
        }
        on(&mut c, index);
        c.out.push(10);
    } else {
        if single {
            o(&mut c, view("cfbits32 "));
        } else {
            o(&mut c, view("cfbits64 "));
        }
        on(&mut c, index);
        c.out.push(10);
    }
    return ();
}
// How a record with float fields is returned on this ABI: 1 SysV (per-eightbyte INTEGER/SSE),
// 2 AAPCS64 homogeneous float aggregate (1-4 fields of one float type), 3 RV64 flattened (one
// or two fields, at least one float), 0 the integer-register/memory rules (Win64 by size, AAPCS64
// non-HFA composites, RV64 records the flattening rule does not cover).
fn ffi_float_plan<a>(c: (&a mut C), d: u64, abi: u64) -> u64 {
    // Classified over the flattened scalar leaves, so a float inside an embedded record counts
    // exactly as one at the top level (the C ABIs all classify the flattened field list).
    leaves := ffi_leaves(&mut c, d, 0);
    count := leaves.len();
    if abi == 0 {
        return 1;
    }
    if abi == 2 {
        if (count == 0) || (4 < count) {
            return 0;
        }
        kind := leaves[0].cls;
        if kind == 0 {
            return 0;
        }
        for i in count {
            if leaves[i].cls != kind {
                return 0;
            }
        }
        return 2;
    }
    if abi == 3 {
        if (count == 0) || (2 < count) {
            return 0;
        }
        mut floats = 0;
        for i in count {
            if leaves[i].cls != 0 {
                floats = floats + 1;
            } else {
                // Only scalar integers pair with a float (handles and CStr are pointer words).
                if 8 < leaves[i].size {
                    return 0;
                }
            }
        }
        if floats == 0 {
            return 0;
        }
        return 3;
    }
    return 0;
}
// Stores a float-classified record result from the return registers into its allocation, leaf by
// leaf of the flattened record (embedded records included).
fn ffi_float_result<a>(c: (&a mut C), slot: u64, d: u64, plan: u64) -> unit {
    leaves := ffi_leaves(&mut c, d, 0);
    count := leaves.len();
    size := ffi_record_size(&mut c, d);
    if plan == 1 {
        // SysV: each eightbyte is SSE when all its leaves are floats, else INTEGER; INTEGER
        // eightbytes come from rax then rdx, SSE ones from xmm0 then xmm1.
        mut eights = (size + 7) / 8;
        mut ints = 0;
        mut sses = 0;
        // Save rax/rdx first: the stores below go through r10/r11 only.
        get(&mut c, slot, view("%r10"));
        for e in eights {
            mut sse = 1;
            for i in count {
                if (leaves[i].off / 8 == e) & (leaves[i].cls == 0) {
                    sse = 0;
                }
            }
            if sse != 0 {
                o(&mut c, view("movq %xmm"));
                on(&mut c, sses);
                o(&mut c, view(",%r11\n"));
                sses = sses + 1;
            } else {
                if ints == 0 {
                    o(&mut c, view("movq %rax,%r11\n"));
                } else {
                    o(&mut c, view("movq %rdx,%r11\n"));
                }
                ints = ints + 1;
            }
            o(&mut c, view("movq %r11,"));
            on(&mut c, e * 8);
            o(&mut c, view("(%r10)\n"));
        }
        return ();
    }
    if plan == 2 {
        get(&mut c, slot, view("%r10"));
        for i in count {
            ffi_float_store(&mut c, i, leaves[i].cls == 1, leaves[i].off);
        }
        return ();
    }
    // RV64 flattened: floats in fa0, fa1 in leaf order; the integer leaf (if any) in a0, which
    // the call lowering leaves in %rax.
    held := save(&mut c);
    get(&mut c, slot, view("%r10"));
    mut fk = 0;
    for i in count {
        if leaves[i].cls != 0 {
            ffi_float_store(&mut c, fk, leaves[i].cls == 1, leaves[i].off);
            fk = fk + 1;
        }
    }
    for i in count {
        if leaves[i].cls == 0 {
            get(&mut c, slot, view("%rax"));
            o(&mut c, view("addq $"));
            on(&mut c, leaves[i].off);
            o(&mut c, view(",%rax\n"));
            addr := save(&mut c);
            sized_store(&mut c, addr, held, leaves[i].size, 0);
        }
    }
    return ();
}
fn ffi_float_store<a>(c: (&a mut C), k: u64, single: bool, off: u64) -> unit {
    o(&mut c, view("cfrstore "));
    on(&mut c, k);
    if single {
        o(&mut c, view(" s "));
    } else {
        o(&mut c, view(" d "));
    }
    on(&mut c, off);
    c.out.push(10);
    return ();
}
// Floats anywhere in the record, embedded records included.
fn ffi_record_has_float_deep<a>(c: (&a mut C), d: u64) -> bool {
    count := c.decls[d].count;
    for i in count {
        ty := field_ty(&mut c, d, i);
        if is_float(&mut c, ty) {
            return true;
        }
        if is_c_record(&mut c, ty) != 0 {
            inner := ty_arg(&mut c, ty);
            if ffi_record_has_float_deep(&mut c, inner) {
                return true;
            }
        }
    }
    return false;
}
// An assignment's target path `a.b.f`: `field_path` for a write, with the field it ends at in
// `ref_assign_d`/`ref_assign_k` - the field whose predicate the assignment owes, in the record that
// declares it, whatever the head's type is.
fn assign_field_path<a>(c: (&a mut C), id: u64, lty: u64) -> Val {
    exchange(&mut c.ref_assign_d, 0);
    exchange(&mut c.ref_assign_k, 0);
    exchange(&mut c.ref_assign_target, 1);
    a := field_path(&mut c, id, lty, 3);
    exchange(&mut c.ref_assign_target, 0);
    return a;
}
fn field_path<a>(c: (&a mut C), id: u64, lty: u64, address: u64) -> Val {
    mut t = id;
    mut ty = lty;
    mut via = 0;
    while is(&mut c, view(".")) {
        if after_next_kind(&mut c) == 40 {
            break;
        }
        if next_kind(&mut c) == 46 {
            break;
        }
        advance(&mut c);
        f := member_name(&mut c);
        if ty_kind(&mut c, ty) == 7 {
            via = 1;
        }
        mut base = deref(&mut c, val(t, ty));
        mut b = base.t;
        // A record reached through a bound type parameter (`v.@f` in a generic, unrolled per
        // specialisation) arrives behind an indirection.
        while ty_kind(&mut c, base.ty) == 10 {
            inner := ty_arg(&mut c, base.ty);
            base = val(base.t, inner);
        }
        if ty_kind(&mut c, base.ty) != 8 {
            fail(&mut c, view("field projection requires record"));
