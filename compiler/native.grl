        // storage cannot be modified, moved or dropped while a CStr made from it is kept, and
        // the CStr cannot outlive it. (A literal is handled above and needs no borrow.)
        slot := apply(&mut c, view("rt_cstr_view"), one(x.t));
        ty := intern(&mut c, 24, 0);
        pointer_borrow(&mut c, slot, ty, operand, x.t, 0);
