    if ((k == 124) || (k == 274)) && (c.raw == 0) {
        return closure_literal(&mut c);
    }
    if k == 33 {
        advance(&mut c);
        operand := expr(&mut c, 10);
        ot := operand.ty;
        if c.raw == 0 {
            if !(is_bool(&mut c, ot) || ot == 0) {
