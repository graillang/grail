                    return ();
                }
                fail(&mut c, view("mutation through readonly view"));
            }
            if authority != 0 {
                a := resource(&mut c, authority - 1);
                if a != 0 {
                    info := &c.resources[a - 1];
                    at := info.ty;
                    if ty_kind(&mut c, at) == 7 {
                        if ty_mode(&mut c, at) != 0 {
                            return ();
                        }
                        fail(&mut c, view("mutation through readonly frame"));
                    }
                }
            }
            binding := binding_mode(&c, current);
            if binding == 1 {
                fail(&mut c, view("owned storage mutation requires mut"));
            }
            if binding == 2 {
                return ();
            }
            if base == 0 {
                return ();
            }
            current = base - 1;
        } else {
            binding := binding_mode(&c, current);
            if binding == 1 {
                fail(&mut c, view("owned storage mutation requires mut"));
            }
            return ();
        }
        depth = depth + 1;
    }
    fail(&mut c, view("invalid mutation provenance"));
    return ();
}
fn require_write<a>(c: (&a mut C), slot: u64) -> unit {
    require_mutable_binding(&mut c, slot, 0);
    if c.raw != 0 {
        return ();
    }
    index := resource(&mut c, slot);
    if index == 0 {
        fail(&mut c, view("mutation target is not tracked"));
    }
    mut r = &c.resources[index - 1];
    ty := r.ty;
    place := r.place;
    authority := r.authority;
    target := r.target;
    k := ty_kind(&mut c, ty);
    if (k == 7) & (place == 0) {
        if authority != 0 {
            mut r = resource(&mut c, authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("write through readonly frame"));
            }
            loan := authority_loan(&mut c, authority, target);
            if loan == 0 {
                fail(&mut c, view("field write has no authority"));
            }
            if ownership::access_loan(&c.check, loan, target, 1) != 0 {
                fail(&mut c, view("field write conflicts with active loan"));
            }
        } else {
            if ownership::initialize(&mut c.check, target) != 0 {
                pointer_conflict(&mut c, target, view("modify"), 0);
                borrow_context(&mut c, target, view("modify"));
                fail(
                    &mut c,
                    view("field assignment conflicts with live borrow or moved storage")
                );
            }
        }
        return ();
    }
    if (k == 5) || (k == 7) || (k == 27) {
        if ty_mode(&mut c, ty) == 0 {
            fail(&mut c, view("mutation through readonly reference"));
        }
        mut allowed = 0;
        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            holder := b.holder;
            loan := b.loan;
            guard := b.guard;
            if (guard == 0) & ownership::ancestor(&c.check, holder, place) {
                if loan_live(&mut c, loan) != 0 {
                    allowed = 1;
                    if ownership::use_loan(&c.check, loan, 1) != 0 {
                        fail(&mut c, view("write authority is suspended"));
                    }
                }
            }
        }
        if allowed == 0 {
            fail(&mut c, view("write lacks checked source"));
        }
    } else {
        if authority != 0 {
            mut r = resource(&mut c, authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("mutation through readonly frame"));
            }
            loan := authority_loan(&mut c, authority, place);
            if loan == 0 {
                fail(&mut c, view("write has no reference authority"));
            }
            if ownership::access_loan(&c.check, loan, place, 1) != 0 {
                fail(&mut c, view("write conflicts with active loan"));
            }
        } else {
            loan := ownership::borrow_place(&mut c.check, place, 1);
            if loan == 0 {
                pointer_conflict(&mut c, place, view("modify"), 0);
                borrow_context(&mut c, place, view("modify"));
                fail(&mut c, view("mutation conflicts with live borrow"));
            }
            ownership::end_loan(&mut c.check, loan);
        }
    }
    return ();
}
fn region_of<a>(c: (&a mut C), place: u64) -> u64 {
    for i in c.origins.len() {
        o := &c.origins[i];
        root := o.place;
        region := o.region;
        if ownership::ancestor(&c.check, root, place) {
            return region;
        }
    }
    return 0;
}
fn external_place<a>(c: (&a mut C), region: u64, copy: u64) -> u64 {
    p := ownership::root(&mut c.check, copy, 1);
    c.origins.push(Origin { place: p, region: region });
    return p;
}
fn add_external_capture<a>(c: (&a mut C), holder: u64, region: u64, mode: u64) -> u64 {
    source := external_place(&mut c, region, 0);
    loan := ownership::borrow_place(&mut c.check, source, mode);
    bond(&mut c, holder, loan);
    return source;
}
fn init_parameter<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    holder := place_of(&mut c, slot);
    k := ty_kind(&mut c, ty);
    mut rs = type_regions(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        if rs.len() != 1 {
            fail(&mut c, view("parameter requires a declared lifetime"));
        }
        mut r = rs[0];
        source := add_external_capture(&mut c, holder, r, mode);
        if k == 7 {
            set_target(&mut c, slot, source, slot + 1);
        }
        return ();
    }
    captures := type_caps(&mut c, ty, 0);
    for i in captures.len() {
        mut r = captures[i];
        target := external_place(&mut c, r, 0);
        loan := ownership::borrow_place(&mut c.check, target, 0);
        bond_kind(&mut c, holder, loan, 1);
    }
    return ();
}
fn has_bonds<a>(c: (&a mut C), holder: u64) -> bool {
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        h := b.holder;
        guard := b.guard;
        loan := b.loan;
        if (h == holder) & (guard == 0) {
            if loan_live(&mut c, loan) != 0 {
                return true;
            }
        }
    }
    return false;
}
// Stored captures in an abstract input referent have their declared data lifetime,
// distinct from the lifetime of the outer reference frame.
fn stored_source<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    k := ty_kind(&mut c, ty);
    if (k != 5) & (k != 7) & (k != 27) {
        return ();
    }
    if has_bonds(&mut c, place) {
        if k == 7 {
            for i in c.bonds.len() {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if (holder == place) & (guard == 0) {
                    if loan_live(&mut c, loan) != 0 {
                        mut l = &c.check.loans[loan - 1];
                        source := l.source;
                        authority := authority_of(&mut c, slot);
                        set_target(&mut c, slot, source, authority);
                        break;
                    }
                }
            }
        }
        return ();
    }
    mut guarded = 0;
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if guard != 0 {
            if loan_live(&mut c, loan) != 0 {
                if ownership::ancestor(&c.check, holder, place) {
                    bond_kind(&mut c, place, loan, guard);
                    guarded = 1;
                }
            }
        }
    }
    if guarded != 0 {
        mode := ty_mode(&mut c, ty);
        source := external_place(&mut c, 18446744073709551615, 0);
        loan := ownership::borrow_place(&mut c.check, source, mode);
        bond(&mut c, place, loan);
        if k == 7 {
            mut authority = authority_of(&mut c, slot);
            mut r = resource(&mut c, slot);
            info := &c.resources[r - 1];
            if info.base == 0 {
                authority = slot + 1;
            }
            set_target(&mut c, slot, source, authority);
        }
        return ();
    }
    if region_of(&mut c, place) == 0 {
        return ();
    }
    mut rs = type_regions(&mut c, ty);
    if rs.len() != 1 {
        fail(&mut c, view("stored capture lifetime missing"));
    }
    mut r = rs[0];
    mode := ty_mode(&mut c, ty);
    target := add_external_capture(&mut c, place, r, mode);
    if k == 7 {
        authority := authority_of(&mut c, slot);
        set_target(&mut c, slot, target, authority);
    }
    return ();
}
fn bind_loan<a>(c: (&a mut C), value: u64, source: u64, target: u64, mode: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if target == 0 {
        fail(&mut c, view("borrow target is not tracked"));
    }
    mut authority = authority_of(&mut c, source);
    source_id := resource(&mut c, source);
    if source_id != 0 {
        mut r = &c.resources[source_id - 1];
        ty := r.ty;
        if ty_kind(&mut c, ty) == 7 {
            authority = source + 1;
        }
    }
    mut loan = 0;
    if authority != 0 {
        if mode != 0 {
            mut r = resource(&mut c, authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("mutable borrow through readonly frame"));
            }
        }
        parent := authority_loan(&mut c, authority, target);
        if parent == 0 {
            fail(&mut c, view("reference has no access authority"));
        }
        loan = ownership::reborrow_place(&mut c.check, parent, target, mode);
        owner := place_of(&mut c, authority - 1);
        holder := place_of(&mut c, value);
        n := c.bonds.len();
        for i in n {
            mut b = &c.bonds[i];
            old := b.loan;
            h := b.holder;
            guard := b.guard;
            if (h == owner) & (guard != 0) {
                bond_kind(&mut c, holder, old, 1);
            }
            if (h == owner) & (old != parent) & (guard == 0) {
                if loan_live(&mut c, old) != 0 {
                    extra := ownership::reborrow(&mut c.check, old, mode);
                    if extra == 0 {
                        fail(&mut c, view("ambiguous reborrow lacks authority"));
                    }
                    bond(&mut c, holder, extra);
                }
            }
        }
    } else {
        loan = ownership::borrow_place(&mut c.check, target, mode);
        if loan == 0 {
            // Loans whose holders are all dead (a moved match scrutinee's payload loans) end
            // here, then the borrow is retried; a real conflict still fails.
            close_loans(&mut c);
            loan = ownership::borrow_place(&mut c.check, target, mode);
        }
    }
    if loan == 0 {
        if (c.raw == 0) & (c.cptr_address != 0) {
            if c.cptr_address == 2 {
                fail(
                    &mut c,
                    view("the value handed to C as a writable pointer is already borrowed in this expression")
                );
            }
            fail(
                &mut c,
                view("the value handed to C as a read-only pointer is already mutably borrowed in this expression")
            );
        }
        pointer_conflict(&mut c, target, view("borrow"), u64(mode == 0));
        fail(&mut c, view("borrow conflicts with active access"));
    }
    holder := place_of(&mut c, value);
    bond(&mut c, holder, loan);
    return ();
}
fn borrow_reference<a>(
    c: (&a mut C),
    slot: u64,
    ty: u64,
    source: u64,
    target: u64,
    mode: u64
) -> Val {
    own(&mut c, slot, ty);
    bind_loan(&mut c, slot, source, target, mode);
    set_target(&mut c, slot, target, slot + 1);
    return val(slot, ty);
}
// The loop backedge check (ownership::backedge), with one more loan that cannot consume entry
// storage: a shared borrow of storage outside the function (an origin place, such as what a
// captured iterator over references lends out on each turn). Such storage is never moved or
// rewritten here, and shared loans never conflict, so a fresh one per turn is still a fixpoint.
fn backedge_ok<a, b>(c: (&a mut C), entry: (&b ownership::State)) -> bool {
    code := ownership::backedge(&c.check, &entry);
    if code == 0 {
        return true;
    }
    if code != 3 {
        return false;
    }
    for i in entry.loans.len() {
        if (i < c.check.loans.len()) && (c.check.loans[i].live != entry.loans[i].live) {
            return false;
        }
    }
    mut i = entry.loans.len();
    while i < c.check.loans.len() {
        l := &c.check.loans[i];
        live := l.live;
        mode := l.mode;
        source := l.source;
        parent := l.parent;
        if live != 0 {
            mut stable = false;
            if mode == 0 {
                for j in entry.loans.len() {
                    old := &entry.loans[j];
                    if (old.live != 0) && (old.mode == 0) && (old.source == source) && (old.parent == parent) {
                        stable = true;
                    }
                }
                if (parent == 0) && !stable {
                    for k in c.origins.len() {
                        if c.origins[k].place == source {
                            stable = true;
                        }
                    }
                }
            }
            if !stable {
                return false;
            }
        }
        i += 1;
    }
    return true;
}
fn view_bonds<a>(c: (&a mut C), slot: u64, source: u64, mode: u64, copied_ref: bool) -> unit {
    if c.raw != 0 {
        return ();
    }
    root := place_of(&mut c, source);
    holder := place_of(&mut c, slot);
    if root == 0 {
        fail(&mut c, view("view source is not tracked"));
    }
    source_index := resource(&mut c, source);
    mut r = &c.resources[source_index - 1];
    ty := r.ty;
    // A shared reference copied out through a shared reference (deref_value) reborrows the loans
    // that cover where it was read from, as a shared view does.
    if (ty_kind(&mut c, ty) == 5) || (ty_kind(&mut c, ty) == 27) || copied_ref {
        if mode != 0 {
            index := resource(&mut c, source);
            mut r = &c.resources[index - 1];
            base := r.base;
            authority := r.authority;
            if base != 0 {
                if authority != 0 {
                    mut r = resource(&mut c, authority - 1);
                    info := &c.resources[r - 1];
                    ty := info.ty;
                    if ty_mode(&mut c, ty) == 0 {
                        fail(&mut c, view("unique field reborrow through readonly frame"));
                    }
                    parent := authority_loan(&mut c, authority, root);
                    if ownership::access_loan(&c.check, parent, root, 1) != 0 {
                        fail(&mut c, view("unique field reborrow requires mutable frame"));
                    }
                } else {
                    if !ownership::can_cleanup(&c.check, root) {
                        fail(&mut c, view("field frame is shared"));
                    }
                }
            }
        }
        mut found = 0;
        n := c.bonds.len();
        for i in n {
            mut b = &c.bonds[i];
            h := b.holder;
            parent := b.loan;
            guard := b.guard;
            if loan_live(&mut c, parent) != 0 {
                if ownership::ancestor(&c.check, h, root) {
                    if guard != 0 {
                        bond_kind(&mut c, holder, parent, 1);
                    } else {
                        loan := ownership::reborrow(&mut c.check, parent, mode);
                        if loan == 0 {
                            fail(&mut c, view("view reborrow lacks authority"));
                        }
                        bond(&mut c, holder, loan);
                        found = 1;
                    }
                }
            }
        }
        if found == 0 {
            fail(&mut c, view("view has no lifetime source"));
        }
    } else {
        bind_loan(&mut c, slot, source, root, mode);
    }
    return ();
}
fn validate_return<a>(c: (&a mut C), v: Val) -> unit {
    if c.raw != 0 {
        return ();
    }
    // Every returned value is checked, not only one whose type names a borrow: a closure that
    // captured a reference keeps its loan in the environment, and a value that merely holds such a
    // closure (`struct Holder { f: Fn(u64) -> u64 }`) still must not carry a loan out of the frame.
    place := place_of(&mut c, v.t);
    if place == 0 {
        return ();
    }
    mut rs = type_caps(&mut c, c.result, 0);
    // A specialisation's result may carry its type arguments' lifetimes (captured_bonds).
    bound := copy_numbers(&c.bindings);
    for i in bound.len() {
        if bound[i] != NO_TYPE {
            more := type_caps(&mut c, bound[i], 0);
            for j in more.len() {
                add_region(&mut rs, more[j]);
            }
        }
    }
    mut found = 0;
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if ownership::ancestor(&c.check, place, holder) {
            if loan_live(&mut c, loan) != 0 {
                mut l = &c.check.loans[loan - 1];
                source := l.source;
                region := region_of(&mut c, source);
                mut allowed = 0;
                for j in rs.len() {
                    if rs[j] == region {
                        allowed = 1;
                    }
                }
                if region != 18446744073709551615 {
                    if (region == 0) || (allowed == 0) {
                        pointer_escape(&mut c, loan);
                        fail(&mut c, view("returned borrow escapes its declared input lifetime"));
                    }
                }
                found = 1;
            }
        }
    }
    k := ty_kind(&mut c, v.ty);
    if (k == 5) || (k == 7) || (k == 27) {
        if found == 0 {
            fail(&mut c, view("returned reference has no checked source"));
        }
    }
    return ();
}
fn place_of<a>(c: (&a mut C), slot: u64) -> u64 {
    mut r = resource(&mut c, slot);
    if r == 0 {
        return 0;
    }
    mut r = &c.resources[r - 1];
    return r.place;
}
fn observe<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    authority := authority_of(&mut c, slot);
    index := resource(&mut c, slot);
    info := &c.resources[index - 1];
    base := info.base;
    ty := info.ty;
    if (authority != 0) & (base != 0) {
        loan := authority_loan(&mut c, authority, place);
        if loan == 0 {
            fail(&mut c, view("access has no live reference authority"));
        }
        if ownership::access_loan(&c.check, loan, place, 0) != 0 {
            fail(&mut c, view("reference access conflicts with active borrow"));
        }
    } else {
        if ownership::read(&c.check, place) != 0 {
            pointer_conflict(&mut c, place, view("use"), 1);
            fail(&mut c, view("use of moved, borrowed or partially initialized value"));
        }
    }
    k := ty_kind(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        mut checked = 0;
        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            h := b.holder;
            loan := b.loan;
            guard := b.guard;
            if (guard == 0) & ownership::ancestor(&c.check, h, place) {
                if loan_live(&mut c, loan) != 0 {
                    checked = 1;
                    if ownership::use_loan(&c.check, loan, 0) != 0 {
                        fail(&mut c, view("reference is suspended or expired"));
                    }
                }
            }
        }
        if checked == 0 {
            fail(&mut c, view("reference lacks checked source"));
        }
    }
    return ();
}
fn inherit_guards<a>(c: (&a mut C), place: u64) -> unit {
    if place == 0 {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if holder != place {
            if ownership::ancestor(&c.check, holder, place) {
                bond_kind(&mut c, place, loan, 1);
            }
        }
    }
    return ();
}
fn capture_authority<a>(c: (&a mut C), place: u64) -> unit {
    if place == 0 {
        return ();
    }
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if guard == 0 {
            if loan_live(&mut c, loan) != 0 {
                if ownership::ancestor(&c.check, place, holder) {
                    if ownership::use_loan(&c.check, loan, 0) != 0 {
                        fail(&mut c, view("captured authority is suspended"));
                    }
                }
            }
        }
    }
    return ();
}
fn alias_field<a>(c: (&a mut C), slot: u64, ty: u64, base: u64, field: u64, via: u64) -> Val {
    if c.raw == 0 {
        root := place_of(&mut c, base);
        place := member_place(&mut c, root, field, ty);
        authority := authority_of(&mut c, base);
        c
            .resources
            .push(
                Resource {
                    slot: slot,
                    ty: ty,
                    flag: 0,
                    base: base + 1,
                    field: field,
                    via: via,
                    place: place,
                    target: 0,
                    authority: authority,
                }
            );
        if contains_borrow(&mut c, ty, 0) {
            inherit_guards(&mut c, place);
        }
        stored_source(&mut c, slot, ty);
    }
    return val(slot, ty);
}
// A drop helper's symbol: `.D` and the first 64 bits of the SHA-256 of the type's canonical
// spelling, cached per type. A type index is a position in *this* run's table, and separate
// compilation cannot reproduce another run's table; the spelling is a function of the type alone,
// so two objects that both emit a helper for a type emit the same name for the same body.
// Whether the interface format has a spelling for this type. Asked by the two places that need a
// spelling rather than a name - a request line, which the defining module parses, and a diagnostic -
// so neither has to call the writer unguarded.
fn iface_spellable<a>(c: (&a mut C), ty: u64) -> bool {
    mut scratch = u8[];
    exchange(&mut c.spell_lenient, 1);
    exchange(&mut c.spell_failed, 0);
    iface_type_raw(&mut scratch, &mut c, ty);
    failed := c.spell_failed;
    exchange(&mut c.spell_lenient, 0);
    exchange(&mut c.spell_failed, 0);
    return failed == 0;
}
// A type's identity, spelled structurally and *totally*: every kind is answered, including one this
// compiler does not know, and nothing here can fail. That matters because a name is wanted in the
// middle of an ordinary build - a drop helper is referenced from every scope exit, a specialisation
// from every call - and a build must not fail because an optional serialisation has no spelling for
// a type.
//
// Everything it writes is a function of the type: the kind, its mode, its lifetime slots, the
// nominal name (or, for a synthesised environment record, the captures it holds), its type
// arguments, its payload when the payload is a type, and an interface's *name* for a proof. No
// index this run chose goes in, so two runs - and two modules of one program - compute the same key
// for the same type, whatever order they met it in.
//
// The interface writer keeps its own spelling and its own refusal: this describes a type, it does
// not promise an interface can carry one.
fn type_key<a>(c: (&a mut C), out: (&a mut u8[]), ty: u64, depth: u64) -> unit {
    k := ty_kind(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    out.push(40);
    decimal(&mut out, k);
    out.push(58);
    decimal(&mut out, mode);
    // The region numbers are part of a reference or view type's identity: `(&[1] T)` and `(&[2] T)`
    // are different types, and leaving them out made two helpers collide on one label.
    rs := type_regions(&mut c, ty);
    for i in rs.len() {
        out.push(47);
        decimal(&mut out, rs[i]);
    }
    if 16 < depth {
        // A store this deep is a cycle; the marker is still a function of the type and the cap
        // keeps the walk finite.
        push_bytes(&mut out, view(":~"));
        return ();
    }
    if (k == 8) || (k == 23) || (k == 28) {
        arg := ty_arg(&mut c, ty);
        mut module = c.decls[arg].module.copy();
        mut name = c.decls[arg].name.copy();
        count := c.decls[arg].count;
        first := c.decls[arg].first;
        out.push(32);
        if same(view(module), view(".closure")) {
            // An environment record is synthesised per program and named by registration order, so
            // its name is not a property of the type; its captures are.
            push_bytes(&mut out, view("(env"));
            for i in count {
                field_ty := c.fields[first + i].ty;
                out.push(32);
                type_key(&mut c, &mut out, field_ty, depth + 1);
            }
            push_bytes(&mut out, view(")"));
        } else {
            push_bytes(&mut out, view(module));
            push_bytes(&mut out, view("::"));
            push_bytes(&mut out, view(name));
        }
    }
    args := type_args(&mut c, ty);
    for i in args.len() {
        out.push(32);
        type_key(&mut c, &mut out, args[i], depth + 1);
    }
    arg := ty_arg(&mut c, ty);
    if (k == 6) || (k == 7) || (k == 10) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20)
        || (k == 25) || (k == 26) || (k == 27) {
        // The payload is a type.
        out.push(32);
        type_key(&mut c, &mut out, arg, depth + 1);
    } else if k == 15 {
        // A proof names an interface; the id is a position in this program's interface table, so the
        // interface's own name goes in instead.
        out.push(32);
        mut module = c.interfaces[arg - 1].module.copy();
        mut name = c.interfaces[arg - 1].name.copy();
        push_bytes(&mut out, view(module));
        push_bytes(&mut out, view("::"));
        push_bytes(&mut out, view(name));
    } else if (k == 1) || (k == 2) || (k == 3) || (k == 4) || (k == 5) || (k == 11) || (k == 17) || (k == 19)
        || (k == 22) || (k == 24) {
