fn constructor_hint<a>(c: (&a mut C), decl: u64, explicit: u64) -> u64 {
    if explicit != NO_TYPE {
        return explicit;
    }
    result := c.result;
    // No `-> T` to read the type from: `c.result` is unknown where nothing is being returned
    // (a top-level statement, and every expression compiled in isolation for inference).
    if result != 18446744073709551615 {
        if ty_kind(&mut c, result) == 8 {
            if ty_arg(&mut c, result) == decl {
                return result;
            }
        }
    }
    return NO_TYPE;
}
fn constructor_map<a>(c: (&a mut C), decl: u64, hint: u64) -> u64[] {
    d := &c.decls[decl];
    count := d.types;
    mut map = u64[];
    if hint != NO_TYPE {
        return type_args(&mut c, hint);
    }
    for i in count {
        map.push(NO_TYPE);
    }
    return map;
}
fn constructed_type<a>(c: (&a mut C), decl: u64, hint: u64, map: u64[]) -> u64 {
    for i in map.len() {
        if map[i] == NO_TYPE {
            fail(&mut c, view("cannot infer generic type argument"));
        }
    }
    mut rs = u64[];
    if hint != NO_TYPE {
        regions := type_regions(&mut c, hint);
        for i in regions.len() {
            rs.push(regions[i]);
        }
    }
    require_constraints(&mut c, &map, &declaration_bounds(&c, decl));
    require_interfaces(&mut c, &map, &declaration_constraints(&c, decl));
    return intern_args(&mut c, 8, decl, 0, rs, map);
}
// Record member names.
fn member_name<a>(c: (&a mut C)) -> u8[] {
    if kind(&mut c) == 64 {
        // `x.@f`: the field an `@for` binding names.
        advance(&mut c);
        n := ident(&mut c);
        b := ct_loop_binding(&mut c, view(n));
        if b == 0 {
            fail(&mut c, view("x.@f needs a field from an enclosing @for f in fields(T)"));
        }
        return ct_loop_field_name(&mut c, b);
    }
    if kind(&mut c) == 2 {
        t := tok_text(&mut c, c.pos);
        advance(&mut c);
        return t.copy();
    }
    return ident(&mut c);
}
// name ':' type ('=' | ':=') ... ; scans to the end of the statement for an initializer.
fn typed_binding_ahead<a>(c: (&a mut C)) -> bool {
    return typed_binding_ahead_at(&mut c, c.pos);
}
fn typed_binding_ahead_at<a>(c: (&a mut C), name_pos: u64) -> bool {
    if kind_at(&mut c, name_pos + 1) != 58 {
        return false;
    }
    mut i = name_pos + 2;
    mut depth = 0;
    while true {
        k := kind_at(&mut c, i);
        if k == 0 {
            return false;
        }
        if (k == 60) || (k == 40) || (k == 91) {
            depth += 1;
        }
        if (k == 62) || (k == 41) || (k == 93) {
            if depth == 0 {
                return false;
            }
            depth -= 1;
        }
        if depth == 0 {
            if (k == 61) || (k == 261) {
                return true;
            }
            if (k == 59) || (k == 123) || (k == 125) {
                return false;
            }
        }
        i += 1;
    }
    return false;
}
// Returns a slot holding 1 when the two values of type ty are structurally equal.
fn structural_eq<a>(c: (&a mut C), x: u64, y: u64, ty: u64, depth: u64) -> u64 {
