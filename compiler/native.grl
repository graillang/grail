        slot := invoke(&mut c, view("rt_cancelled"), one(value));
        return val(slot, 0);
    }
    if kind == 14 {
        if same(view(name), view("cancel")) {
            invoke(&mut c, view("rt_cancel"), one(value));
            return val(imm(&mut c, 0), 1);
        }
        if same(view(name), view("token")) {
            slot := invoke(&mut c, view("rt_scope_token"), one(value));
            ty := intern(&mut c, 17, 0);
            return val(slot, ty);
