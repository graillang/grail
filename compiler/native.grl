fn map_call<a, b>(c: (&a mut C), name: &b [u8], ty: u64, values: Val[]) -> Val {
    f := find_func(&mut c, view("hashmap"), name);
    if f == 0 {
        fail(&mut c, view("map operation needs its standard library helper"));
    }
    mut types = type_args(&mut c, ty);
    info := &c.funcs[f - 1];
    first := info.first;
    count := info.count;
    if count != values.len() {
        fail(&mut c, view("map helper argument count"));
    }
    mut args = u64[];
    mut actuals = u64[];
    mut sources = u64[];
    for i in values.len() {
        v := val(values[i].t, values[i].ty);
        formal := c.params[first + i];
        expected := bind_types(&mut c, formal, &types);
        require_type(&mut c, v.ty, expected);
        if ty_kind(&mut c, v.ty) == 7 {
            observe(&mut c, v.t);
        }
        held := move_value(&mut c, v);
        args.push(held.t);
        actuals.push(held.ty);
        sources.push(held.t);
    }
    return emit_resolved_call(&mut c, f, types, args, actuals, sources);
}
fn map_new<a>(c: (&a mut C), ty: u64) -> Val {
    first := invoke(&mut c, view("rt_random_seed"), u64[]);
    second := invoke(&mut c, view("rt_random_seed"), u64[]);
    mut args = Val[];
    args.push(val(first, 0));
    args.push(val(second, 0));
    return map_call(&mut c, view("with_seed"), ty, args);
}
fn context_value<a>(c: (&a mut C), expected: u64) -> Val {
    start := c.pos;
    mut v = expr_expected(&mut c, 0, expected);
    end := c.pos;
    if expected != 18446744073709551615 {
        v = adopt_value(&mut c, v, start, end, expected);
        require_type(&mut c, v.ty, expected);
    } else {
        if (c.none_start == start) & (c.none_end == end) {
            fail(&mut c, view("map literal optional needs an expected type"));
        }
        if (c.default_u64 == 0) & (c.lit_start == start) & (c.lit_end == end) & (v.ty == 0) {
            dty := int_type(&mut c, 64, 1);
            lv := c.lit_value;
            ln := c.lit_negative;
            if literal_fits(&mut c, dty, lv, ln) == 0 {
                fail(&mut c, view("integer literal out of range for i64, the default integer type; annotate it (x: u64 := ...)"));
            }
            v = val(v.t, dty);
        }
    }
    return v;
}
fn map_literal_insert<a>(c: (&a mut C), map: Val, key: Val, value: Val) -> unit {
    receiver := place_slot(&mut c, map.t, map.ty, 1);
    mut args = Val[];
    args.push(receiver);
    args.push(key);
    args.push(value);
    old := map_call(&mut c, view("map_insert"), map.ty, args);
    r := resource(&mut c, old.t);
    if r != 0 {
        release(&mut c, r - 1);
    }
    close_loans(&mut c);
    return ();
}
fn map_expression<a>(c: (&a mut C), expected: u64) -> Val {
    // A type-headed constructor is identified by its following () or ::, not capitalization.
    mut q = c.pos;
    mut depth = 0;
    while q < c.toks.len() {
        k := kind_at(&mut c, q);
        if k == 91 {
            depth += 1;
        }
        if k == 93 {
            depth -= 1;
            if depth == 0 {
                break;
            }
        }
        if k == 0 {
            fail(&mut c, view("unclosed map expression"));
        }
        q += 1;
    }
    following := kind_at(&mut c, q + 1);
    if (following == 40) || (following == 260) {
        ty := parse_type(&mut c);
        if !is_map_type(&mut c, ty) {
            fail(&mut c, view("map constructor needs [K: V]"));
        }
        if eat(&mut c, view("::")) {
            name := ident(&mut c);
            if !same(view(name), view("with_seed")) {
                fail(&mut c, view("unknown map constructor"));
            }
            expect(&mut c, view("("));
            first := context_value(&mut c, 0);
            expect(&mut c, view(","));
            second := context_value(&mut c, 0);
            expect(&mut c, view(")"));
            mut args = Val[];
            args.push(first);
            args.push(second);
            return map_call(&mut c, view("with_seed"), ty, args);
        }
        expect(&mut c, view("("));
        expect(&mut c, view(")"));
        return map_new(&mut c, ty);
    }
    expect(&mut c, view("["));
    mut ty = expected;
    mut keyty = 18446744073709551615;
    mut valuety = 18446744073709551615;
    if is_map_type(&mut c, ty) {
        types := type_args(&mut c, ty);
        keyty = types[0];
        valuety = types[1];
    } else {
        if expected != 18446744073709551615 {
            fail(&mut c, view("map literal needs a map expected type"));
        }
    }
    if eat(&mut c, view(":")) {
        expect(&mut c, view("]"));
        if keyty == 18446744073709551615 {
            fail(&mut c, view("empty map [:] needs a map expected type"));
        }
        return map_new(&mut c, ty);
    }
    key := context_value(&mut c, keyty);
    expect(&mut c, view(":"));
    value := context_value(&mut c, valuety);
    if keyty == 18446744073709551615 {
        keyty = key.ty;
        valuety = value.ty;
