        require_write(borrow_mut(c),a.t);let destination=target_of(borrow_mut(c),a.t);seed_storage(borrow_mut(c),destination,ty);
        let slot=apply(borrow_mut(c),read("rt_xchg"),two(a.t,b.t));own(borrow_mut(c),slot,ty);let result=place_of(borrow_mut(c),slot);return_bonds(borrow_mut(c),destination,result,0);
