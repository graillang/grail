// Borrowing narrow storage (an element of f32[]/u32[]/i32[], a byte, a narrow C-record field):
// the reference is the address with its top bit set, so reads and writes through it use the
// referent's width (see `ref_load`). Word storage is never tagged.
fn tag_narrow_borrow<a>(c: (&a mut C), slot: u64) -> unit {
    narrow := caddr_ty(&mut c, slot);
    if (c.raw != 0) || (narrow == 0) {
        return ();
    }
    if is_c_record(&mut c, narrow) != 0 {
        return ();
    }
    get(&mut c, slot, view("%rax"));
    o(&mut c, view("movq $1,%rcx\nshlq $63,%rcx\norq %rcx,%rax\nmovq %rax,"));
    stack_slot(&mut c, slot);
    c.out.push(10);
    // The slot now holds a tagged reference; it is no longer a bare narrow address.
    mut i = c.caddr.len();
    while 1 < i {
        i = i - 2;
        if c.caddr[i] == slot {
            c.caddr[i] = 18446744073709551615;
        }
    }
    return ();
}
// A type narrow storage can hold: f32 or an 8-, 16- or 32-bit integer.
fn subword<a>(c: (&a mut C), alias: u64) -> bool {
    if (c.raw != 0) || (alias == 0) {
        return false;
    }
    ty := base_type(&mut c, alias);
    if is_f32(&mut c, ty) {
        return true;
    }
    if ty_kind(&mut c, ty) == 18 {
        return ty_arg(&mut c, ty) < 64;
    }
    return false;
