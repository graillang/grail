fn require_capability<a, b>(c: (&a mut C), ty: u64, shared: u64, message: &b [u8]) -> unit {
    mut trail = u64[];
    if transfer_capability(borrow_mut(c), ty, shared, borrow_mut(trail), 0) == 0 {
        fail(borrow_mut(c), message);
    }
    return ();
}
// parallel_map(items, context, f): structured fork-join. Items move to workers, the context is
// shared read-only, and every worker is joined before the call returns, so no task outlives a loan.
fn parallel_map_builtin<a>(c: (&a mut C), items: Val) -> Val {
    expect(borrow_mut(c), &",");
    context := expr(borrow_mut(c), 0);
    expect(borrow_mut(c), &",");
    callee := expr(borrow_mut(c), 0);
    expect(borrow_mut(c), &")");
    vt := items.ty;
    if ty_kind(borrow_mut(c), vt) != 6 {
        fail(borrow_mut(c), &"parallel_map requires a vector of items");
    }
    item := ty_arg(borrow_mut(c), vt);
    input := callee.t;
    inty := callee.ty;
    function := deref(borrow_mut(c), callee);
    fty := function.ty;
    closure := ty_kind(borrow_mut(c), fty) == 20;
    // Closures are shared read-only by every worker (captures are owned and never borrowed), and
    // parallel_map returns only after all workers finish, so the closure outlives them.
    if (ty_kind(borrow_mut(c), fty) != 12) & (closure == 0) {
        fail(borrow_mut(c), &"parallel_map requires a callable");
    }
    signature := type_args(borrow_mut(c), fty);
    result := ty_arg(borrow_mut(c), fty);
    if signature.len() != 2 {
        fail(borrow_mut(c), &"parallel_map callback takes (item, context)");
    }
    first := signature[0];
    second := signature[1];
    require_type(borrow_mut(c), item, first);
    require_type(borrow_mut(c), context.ty, second);
    ck := ty_kind(borrow_mut(c), context.ty);
    if needs_drop(borrow_mut(c), context.ty) & (ck != 5) {
        fail(
            borrow_mut(c),
            &"parallel_map context must be a shared reference, view or plain value"
        );
    }
    require_capability(borrow_mut(c), item, 0, &"parallel_map item does not satisfy Send");
    require_capability(borrow_mut(c), result, 0, &"parallel_map result does not satisfy Send");
    require_capability(
        borrow_mut(c),
        context.ty,
        1,
        &"parallel_map context does not satisfy Share"
    );
    if contains_borrow(borrow_mut(c), result, 0) {
        fail(borrow_mut(c), &"parallel_map result cannot contain borrows");
    }
    if contains_task(borrow_mut(c), result, 0) + contains_task(borrow_mut(c), item, 0) {
        fail(borrow_mut(c), &"parallel_map cannot move Task handles between threads");
    }
    if contains_borrow(borrow_mut(c), item, 0) {
        if ty_kind(borrow_mut(c), item) != 7 {
            fail(borrow_mut(c), &"parallel_map borrowed items must be references");
        }
        inner := ty_arg(borrow_mut(c), item);
        if ty_mode(borrow_mut(c), item) & contains_borrow(borrow_mut(c), inner, 0) {
            fail(borrow_mut(c), &"parallel_map exclusive items cannot hold borrows");
        }
    }
    observe(borrow_mut(c), function.t);
    mut env = imm(borrow_mut(c), 0);
    if closure {
        if ty_kind(borrow_mut(c), inty) == 7 {
            get(borrow_mut(c), input, &"%rax");
        } else {
            o(borrow_mut(c), &"leaq ");
            stack_slot(borrow_mut(c), function.t);
            o(borrow_mut(c), &",%rax\n");
        }
        env = save(borrow_mut(c));
    }
    get(borrow_mut(c), function.t, &"%rax");
    if closure {
        o(borrow_mut(c), &"movq (%rax),%rax\n");
    }
    target := save(borrow_mut(c));
    observe(borrow_mut(c), context.t);
    if ck == 7 {
        place := target_of(borrow_mut(c), context.t);
        capture_authority(borrow_mut(c), place);
    }
    list := items.t;
    if c.raw == 0 {
        move_out(borrow_mut(c), items);
    }
    mut pargs = three(list, context.t, target);
    pargs.push(env);
    slot := invoke(borrow_mut(c), &"rt_parallel_map", pargs);
    ty := intern(borrow_mut(c), 6, result);
    observe(borrow_mut(c), context.t);
    release_temporary(borrow_mut(c), input);
    close_loans(borrow_mut(c));
    return own(borrow_mut(c), slot, ty);
}
fn contains_task<a>(c: (&a mut C), ty: u64, depth: u64) -> u64 {
    mut trail = u64[];
    return task_walk(borrow_mut(c), ty, borrow_mut(trail));
}
fn task_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    arg := ty_arg(borrow_mut(c), ty);
    if k == 16 {
        return true;
    }
    if (k == 6) + (k == 10) + (k == 13) {
        return task_walk(borrow_mut(c), arg, borrow_mut(trail));
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return false;
            }
        }
        trail.push(ty);
        d := &c.decls[arg];
        count := d.count;
        for i in count {
            t := field_type(borrow_mut(c), ty, i);
            if task_walk(borrow_mut(c), t, borrow_mut(trail)) {
                trail.pop();
                return true;
            }
        }
        trail.pop();
    }
    return false;
}
fn callee_signature<a>(c: (&a mut C), callee: Val) -> Val {
    function := deref(borrow_mut(c), callee);
    if ty_kind(borrow_mut(c), function.ty) != 12 {
        fail(borrow_mut(c), &"expected a callable");
    }
    observe(borrow_mut(c), function.t);
    get(borrow_mut(c), function.t, &"%rax");
    target := save(borrow_mut(c));
    return val(target, function.ty);
}
fn require_sendable_owned<a, b>(c: (&a mut C), ty: u64, what: &b [u8]) -> unit {
    mut trail = u64[];
    mut bad = u64(transfer_capability(borrow_mut(c), ty, 0, borrow_mut(trail), 0) == 0);
    if contains_borrow(borrow_mut(c), ty, 0) + contains_task(borrow_mut(c), ty, 0) {
        bad = 1;
    }
    if bad {
        fail(borrow_mut(c), what);
    }
    return ();
}
// task_scope(context, body): body(ref scope, context) may spawn tasks; every task is joined
// before task_scope returns (also unjoined/abandoned ones), so tasks never outlive the scope.
fn task_scope_builtin<a>(c: (&a mut C), context: Val) -> Val {
    expect(borrow_mut(c), &",");
    callee := expr(borrow_mut(c), 0);
    expect(borrow_mut(c), &")");
    input := callee.t;
    ct := context.ty;
    ck := ty_kind(borrow_mut(c), ct);
    if needs_drop(borrow_mut(c), ct) + ((ck == 7) & (ty_mode(borrow_mut(c), ct) != 0)) {
        fail(borrow_mut(c), &"task_scope context must be a plain value or shared reference");
    }
    require_capability(borrow_mut(c), ct, 1, &"task_scope context does not satisfy Share");
    body := callee_signature(borrow_mut(c), callee);
    signature := type_args(borrow_mut(c), body.ty);
    result := ty_arg(borrow_mut(c), body.ty);
    if signature.len() != 2 {
        fail(borrow_mut(c), &"task_scope body takes (ref Scope<C>, C)");
    }
    sref := signature[0];
    if (ty_kind(borrow_mut(c), sref) != 7) + (ty_mode(borrow_mut(c), sref) != 0) {
        fail(borrow_mut(c), &"task_scope body must take a shared Scope reference");
    }
    sty := ty_arg(borrow_mut(c), sref);
    if ty_kind(borrow_mut(c), sty) != 14 {
        fail(borrow_mut(c), &"task_scope body must take &s Scope<C>");
    }
    inner := ty_arg(borrow_mut(c), sty);
    require_type(borrow_mut(c), ct, inner);
    second := signature[1];
    require_type(borrow_mut(c), ct, second);
    if contains_borrow(borrow_mut(c), result, 0) + contains_task(borrow_mut(c), result, 0) {
        fail(borrow_mut(c), &"task_scope result cannot contain borrows or Task handles");
    }
    observe(borrow_mut(c), context.t);
    if ck == 7 {
        place := target_of(borrow_mut(c), context.t);
        capture_authority(borrow_mut(c), place);
    }
    handle := invoke(borrow_mut(c), &"rt_scope_begin", one(context.t));
    get(borrow_mut(c), handle, &"%rdi");
    get(borrow_mut(c), context.t, &"%rsi");
    get(borrow_mut(c), body.t, &"%rax");
    o(borrow_mut(c), &"call *%rax\n");
    slot := save(borrow_mut(c));
    invoke(borrow_mut(c), &"rt_scope_end", one(handle));
    observe(borrow_mut(c), context.t);
    release_temporary(borrow_mut(c), input);
    close_loans(borrow_mut(c));
    return own(borrow_mut(c), slot, result);
}
// spawn(scope, item, f): f(item, context) or f(item, context, CancelToken) on its own thread.
fn spawn_builtin<a>(c: (&a mut C), scope: Val) -> Val {
    expect(borrow_mut(c), &",");
    item := expr(borrow_mut(c), 0);
    expect(borrow_mut(c), &",");
    callee := expr(borrow_mut(c), 0);
    expect(borrow_mut(c), &")");
    input := callee.t;
    if ty_kind(borrow_mut(c), scope.ty) != 7 {
        fail(borrow_mut(c), &"spawn requires a Scope reference");
    }
    sref := scope.t;
    sv := deref(borrow_mut(c), scope);
    if ty_kind(borrow_mut(c), sv.ty) != 14 {
        fail(borrow_mut(c), &"spawn requires a Scope reference");
    }
    observe(borrow_mut(c), sv.t);
    context := ty_arg(borrow_mut(c), sv.ty);
    f := callee_signature(borrow_mut(c), callee);
    signature := type_args(borrow_mut(c), f.ty);
    result := ty_arg(borrow_mut(c), f.ty);
    count := signature.len();
    if (count != 2) & (count != 3) {
        fail(
            borrow_mut(c),
            &"spawned callback takes (item, context) or (item, context, CancelToken)"
        );
    }
    first := signature[0];
    second := signature[1];
    require_type(borrow_mut(c), item.ty, first);
    require_type(borrow_mut(c), context, second);
    if count == 3 {
        third := signature[2];
        if ty_kind(borrow_mut(c), third) != 17 {
            fail(borrow_mut(c), &"third spawned callback parameter must be CancelToken");
        }
    }
    require_sendable_owned(
        borrow_mut(c),
        item.ty,
        &"spawned item must be an owned Send value without borrows or Task handles"
    );
    require_sendable_owned(
        borrow_mut(c),
        result,
        &"spawned result must be an owned Send value without borrows or Task handles"
    );
    value := item.t;
    if c.raw == 0 {
        move_out(borrow_mut(c), item);
    }
    arity := imm(borrow_mut(c), count);
    mut dropper = imm(borrow_mut(c), 0);
    if needs_drop(borrow_mut(c), result) {
        o(borrow_mut(c), &"leaq ");
        drop_name(borrow_mut(c), result);
        o(borrow_mut(c), &"(%rip),%rax\n");
        dropper = save(borrow_mut(c));
    }
    mut args = u64[];
    args.push(sv.t);
    args.push(f.t);
    args.push(value);
    args.push(arity);
    args.push(dropper);
    slot := invoke(borrow_mut(c), &"rt_task_spawn", args);
    ty := intern(borrow_mut(c), 16, result);
    release_temporary(borrow_mut(c), input);
    release_temporary(borrow_mut(c), sref);
    close_loans(borrow_mut(c));
    return own(borrow_mut(c), slot, ty);
}
fn join_builtin<a>(c: (&a mut C), handle: Val) -> Val {
    expect(borrow_mut(c), &")");
    if ty_kind(borrow_mut(c), handle.ty) != 16 {
        fail(borrow_mut(c), &"join requires an owned Task handle");
    }
    result := ty_arg(borrow_mut(c), handle.ty);
    value := handle.t;
    if c.raw == 0 {
        move_out(borrow_mut(c), handle);
    }
    slot := invoke(borrow_mut(c), &"rt_task_join", one(value));
    return own(borrow_mut(c), slot, result);
}
fn scope_method<a, b>(c: (&a mut C), value: u64, kind: u64, name: &b [u8]) -> Val {
    expect(borrow_mut(c), &")");
    observe(borrow_mut(c), value);
    if same(&name, &"cancelled") {
        slot := invoke(borrow_mut(c), &"rt_cancelled", one(value));
        return val(slot, 0);
    }
    if kind == 14 {
        if same(&name, &"cancel") {
            invoke(borrow_mut(c), &"rt_cancel", one(value));
            return val(imm(borrow_mut(c), 0), 1);
        }
        if same(&name, &"token") {
            slot := invoke(borrow_mut(c), &"rt_scope_token", one(value));
            ty := intern(borrow_mut(c), 17, 0);
            return val(slot, ty);
        }
    }
    fail(borrow_mut(c), &"unknown Scope/CancelToken method (expected cancel, cancelled or token)");
    return val(0, 0);
}
// ---- sized integers: kind 18 (arg = bits, mode = signed). ----
fn starts_with<a, b>(x: &a [u8], y: &b [u8]) -> u64 {
    if x.len() < y.len() {
        return false;
    }
    for i in y.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
// ---- exact decimal -> binary64 conversion for float literals (base 2^32 bignums) ----
fn big_mul_add<a>(x: (&a mut u64[]), m: u64, add: u64) -> unit {
    mut carry = add;
    for i in x.len() {
        t := x[i] * m + carry;
        exchange(&mut x[i], t % 4294967296);
        carry = t / 4294967296;
    }
    while carry != 0 {
        x.push(carry % 4294967296);
        carry = carry / 4294967296;
    }
    return ();
}
fn big_shl<a>(x: (&a u64[]), n: u64) -> u64[] {
    words := n / 32;
    bits := n % 32;
    mut out = u64[];
    for i in words {
        out.push(0);
    }
    mut carry = 0;
    mut scale = 1;
    for i in bits {
        scale = scale * 2;
    }
    for i in x.len() {
        t := x[i] * scale + carry;
        out.push(t % 4294967296);
        carry = t / 4294967296;
    }
    if carry != 0 {
        out.push(carry);
    }
    return out;
}
fn big_trim<a>(x: (&a mut u64[])) -> unit {
    while x.len() != 0 {
        if x[x.len() - 1] != 0 {
            break;
        }
        x.pop();
    }
    return ();
}
fn big_bits<a>(x: (&a u64[])) -> u64 {
    if x.len() == 0 {
        return 0;
    }
    mut top = x[x.len() - 1];
    mut b = 0;
    while top != 0 {
        top = top / 2;
        b += 1;
    }
    return (x.len() - 1) * 32 + b;
}
// 0 less, 1 equal, 2 greater (both trimmed)
fn big_cmp<a, b>(x: (&a u64[]), y: (&b u64[])) -> u64 {
    if x.len() < y.len() {
        return 0;
    }
    if y.len() < x.len() {
        return 2;
    }
    mut i = x.len();
    while 0 < i {
        i -= 1;
        if x[i] < y[i] {
            return 0;
        }
        if y[i] < x[i] {
            return 2;
        }
    }
    return 1;
}
fn big_sub<a, b>(x: (&a mut u64[]), y: (&b u64[])) -> unit {
    mut borrow = 0;
    for i in x.len() {
        mut sub = borrow;
        if i < y.len() {
            sub += y[i];
        }
        v := x[i];
        if v < sub {
            exchange(&mut x[i], v + 4294967296 - sub);
            borrow = 1;
        } else {
            exchange(&mut x[i], v - sub);
            borrow = 0;
        }
    }
    big_trim(borrow_mut(x));
    return ();
}
fn big_shr1<a>(x: (&a mut u64[])) -> unit {
    mut carry = 0;
    mut i = x.len();
    while 0 < i {
        i -= 1;
        v := x[i];
        exchange(&mut x[i], v / 2 + carry * 2147483648);
        carry = v % 2;
    }
    big_trim(borrow_mut(x));
    return ();
}
fn float_bits<a, b>(c: (&a mut C), text: &b [u8]) -> u64 {
    return float_bits_p(borrow_mut(c), &text, 53);
}
// Correctly rounded decimal -> binary with p significand bits (53 binary64, 24 binary32); the
// result is always the binary64 word holding that value.
fn float_bits_p<a, b>(c: (&a mut C), text: &b [u8], p: u64) -> u64 {
    mut bias = 1023;
    if p == 24 {
        bias = 127;
    }
    half := 1 << (p - 1);
    full := 1 << p;
    lowest := p + bias - 2;
    mut mantissa = u64[];
    mut exponent = 0;
    mut negative_exponent = 0;
    mut fraction_digits = 0;
    mut seen_dot = 0;
    mut i = 0;
    while i < text.len() {
        d := text[i];
        if (d == 101) + (d == 69) {
            break;
        }
        if d == 46 {
            seen_dot = 1;
        } else {
            big_mul_add(borrow_mut(mantissa), 10, d - 48);
            if seen_dot {
                fraction_digits += 1;
            }
        }
        i += 1;
    }
    if i < text.len() {
        i += 1;
        if text[i] == 45 {
            negative_exponent = 1;
            i += 1;
        } else {
            if text[i] == 43 {
                i += 1;
            }
        }
        while i < text.len() {
            exponent = exponent * 10 + text[i] - 48;
            if 100000 < exponent {
                fail(borrow_mut(c), &"float literal exponent too large");
            }
            i += 1;
        }
    }
    big_trim(borrow_mut(mantissa));
    if mantissa.len() == 0 {
        return 0;
    }
    // value = mantissa * 10^scale
    mut up = 0;
    mut down = fraction_digits;
    if negative_exponent {
        down += exponent;
    } else {
        if exponent < down {
            down = down - exponent;
        } else {
            up = exponent - down;
            down = 0;
        }
    }
    if 400 < up {
        float_range(borrow_mut(c), p);
    }
    mut top = mantissa;
    for j in up {
        big_mul_add(borrow_mut(top), 10, 0);
    }
    mut bottom = u64[1];
    if 800 < down {
        return 0;
    }
    for j in down {
        big_mul_add(borrow_mut(bottom), 10, 0);
    }
    // Choose k with 2^52 <= top*2^k/bottom < 2^53 (k may be negative), clamped for subnormals.
    tb := big_bits(borrow(top));
    bb := big_bits(borrow(bottom));
    mut k = p + bb;
    mut kneg = 0;
    if tb < k {
        k = k - tb;
    } else {
        k = tb - k;
        kneg = 1;
    }
    mut attempts = 0;
    while true {
        attempts += 1;
        if 4 < attempts {
            fail(borrow_mut(c), &"float literal conversion failed");
        }
        // Subnormal range: the leading bit would sit below 2^-1022; fix the scale at 2^-1074.
        if (kneg == 0) & (lowest < k) {
            k = lowest;
        }
        mut a = copy_numbers(borrow(top));
        mut b = copy_numbers(borrow(bottom));
        if kneg {
            b = big_shl(borrow(b), k);
        } else {
            a = big_shl(borrow(a), k);
        }
        big_trim(borrow_mut(a));
        big_trim(borrow_mut(b));
        // quotient (at most 54 bits) by binary long division
        mut shifted = big_shl(borrow(b), p);
        big_trim(borrow_mut(shifted));
        mut q = 0;
        for step in p + 1 {
            q = q * 2;
            if big_cmp(borrow(a), borrow(shifted)) != 0 {
                big_sub(borrow_mut(a), borrow(shifted));
                q += 1;
            }
            big_shr1(borrow_mut(shifted));
        }
        subnormal := (kneg == 0) & (k == lowest);
        if (q < half) & (subnormal == 0) {
            if kneg {
                if k == 0 {
                    kneg = 0;
                    k = 1;
                } else {
                    k -= 1;
                }
            } else {
                k += 1;
            }
            continue;
        }
        if full - 1 < q {
            if kneg {
                k += 1;
            } else {
                if k == 0 {
                    kneg = 1;
                    k = 1;
                } else {
                    k -= 1;
                }
            }
            continue;
        }
        // round half to even using the remainder
        twice := big_shl(borrow(a), 1);
        mut tw = twice;
        big_trim(borrow_mut(tw));
        order := big_cmp(borrow(tw), borrow(b));
        if (order == 2) + ((order == 1) & ((q % 2) == 1)) {
            q += 1;
        }
        if q == full {
            q = half;
            if kneg {
                k += 1;
            } else {
                if k == 0 {
                    kneg = 1;
                    k = 1;
                } else {
                    k -= 1;
                }
            }
        }
        if subnormal & (q < half) {
            if p == 53 {
                return q;
            }
            return small_f32_bits(q);
        }
        // value = q * 2^-k ; biased exponent = 52 - k + 1023
        mut biased = 0;
        if kneg {
            biased = bias + p - 1 + k;
        } else {
            if bias + p - 1 < k {
                return q;
            }
            biased = bias + p - 1 - k;
        }
        if 2 * bias < biased {
            float_range(borrow_mut(c), p);
        }
        if p == 53 {
            return biased * 4503599627370496 + (q - half);
        }
        return (biased + 896) * 4503599627370496 + ((q - half) << 29);
    }
    return 0;
}
fn float_range<a>(c: (&a mut C), p: u64) -> unit {
    if p == 24 {
        fail(borrow_mut(c), &"float literal out of range for f32");
    }
    fail(borrow_mut(c), &"float literal out of range for f64");
    return ();
}
// q * 2^-149 (a binary32 subnormal, q < 2^23) as a binary64 word.
fn small_f32_bits(q: u64) -> u64 {
    if q == 0 {
        return 0;
    }
    mut top = 0;
    while (1 << (top + 1)) < q + 1 {
        top += 1;
    }
    return (top + 874) * 4503599627370496 + ((q << (52 - top)) - 4503599627370496);
}
fn bool_type<a>(c: (&a mut C)) -> u64 {
    return intern(borrow_mut(c), 19, 0);
}
fn float_type<a>(c: (&a mut C)) -> u64 {
    return intern(borrow_mut(c), 21, 0);
}
fn is_text<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    return (k == 3) + (k == 4) + (k == 5);
}
fn ref_to_text<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(borrow_mut(c), ty) != 7 {
        return false;
    }
    inner := ty_arg(borrow_mut(c), ty);
    return is_text(borrow_mut(c), inner) != 0;
}
fn is_float<a>(c: (&a mut C), ty: u64) -> u64 {
    return ty_kind(borrow_mut(c), ty) == 21;
}
// f32 shares the float kind (argument 32); its values are binary64 words holding binary32 values.
fn f32_type<a>(c: (&a mut C)) -> u64 {
    return intern(borrow_mut(c), 21, 32);
}
fn is_f32<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(borrow_mut(c), ty) != 21 {
        return false;
    }
    return ty_arg(borrow_mut(c), ty) == 32;
}
fn float_precision<a>(c: (&a mut C), ty: u64) -> u64 {
    if is_f32(borrow_mut(c), ty) {
        return 24;
    }
    return 53;
}
// char: a Unicode scalar value. Character literals ('a') stay untyped and adopt char contexts.
fn char_type<a>(c: (&a mut C)) -> u64 {
    return intern(borrow_mut(c), 22, 0);
}
fn is_char<a>(c: (&a mut C), ty: u64) -> u64 {
    return ty_kind(borrow_mut(c), ty) == 22;
}
// Integer literals adopt sized integer and char contexts.
fn literal_target<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    return (k == 18) + (k == 22);
}
fn is_bool<a>(c: (&a mut C), ty: u64) -> u64 {
    return ty_kind(borrow_mut(c), ty) == 19;
}
// Copy scalars: u64, sized integers and bool are loaded by value from collections.
fn scalar<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    return (ty == 0) + (k == 18) + (k == 19) + (k == 21) + (k == 22);
}
fn int_type<a>(c: (&a mut C), bits: u64, signed: u64) -> u64 {
    if (bits == 64) & (signed == 0) {
        return 0;
    }
    return intern_full(borrow_mut(c), 18, bits, signed, u64[]);
}
fn int_name<a>(n: &a [u8]) -> u64 {
    if same(&n, &"u8") {
        return 8;
    }
    if same(&n, &"u16") {
        return 16;
    }
    if same(&n, &"u32") {
        return 32;
    }
    if same(&n, &"u64") {
        return 64;
    }
    if same(&n, &"i8") {
        return 264;
    }
    if same(&n, &"i16") {
        return 272;
    }
    if same(&n, &"i32") {
        return 288;
    }
    if same(&n, &"i64") + same(&n, &"isize") {
        return 320;
    }
    return 0;
}
fn int_type_named<a>(c: (&a mut C), code: u64) -> u64 {
    return int_type(borrow_mut(c), code % 256, code / 256);
}
fn integer<a>(c: (&a mut C), ty: u64) -> u64 {
    return (ty == 0) + (ty_kind(borrow_mut(c), ty) == 18);
}
// Runtime type code: bits | signed<<8 | wrap<<9.
fn int_code<a>(c: (&a mut C), ty: u64) -> u64 {
    mut bits = 64;
    mut signed = 0;
    if ty != 0 {
        bits = ty_arg(borrow_mut(c), ty);
        signed = ty_mode(borrow_mut(c), ty);
    }
    mut wrap = 0;
    if c.overflow == 0 {
        wrap = 512;
    }
    return bits + signed * 256 + wrap;
}
fn decimal_value<a>(t: &a [u8]) -> u64 {
    mut v = 0;
    for i in t.len() {
        d := t[i];
        if (47 < d) & (d < 58) {
            v = wrapping_add(wrapping_mul(v, 10), d - 48);
        }
    }
    return v;
}
// Integer literal text (decimal, 0x hex, 0b binary, 0o octal, with _ separators) -> value.
// 'a', '\n', '\u{1F600}', 'é' (UTF-8): the Unicode scalar value of a character literal token.
fn char_literal<a>(c: (&a mut C), tok: u64) -> u64 {
    t := tok_text(borrow_mut(c), tok);
    b := t[1];
    if b == 92 {
        e := t[2];
        if e == 110 {
            return 10;
        }
        if e == 116 {
            return 9;
        }
        if e == 114 {
            return 13;
        }
        if e == 48 {
            return 0;
        }
        if e == 117 {
            mut v = 0;
            mut i = 4;
            while i + 2 < t.len() {
                d := t[i];
                if d != 95 {
                    v = v * 16 + hex(d);
                    if 1114111 < v {
                        fail(borrow_mut(c), &"invalid character literal");
                    }
                }
                i += 1;
            }
            if (55295 < v) & (v < 57344) {
                fail(borrow_mut(c), &"invalid character literal");
            }
            return v;
        }
        return e;
    }
    if b < 128 {
        return b;
    }
    mut need = 1;
    mut v = b & 31;
    if 223 < b {
        need = 2;
        v = b & 15;
    }
    if 239 < b {
        need = 3;
        v = b & 7;
    }
    for i in need {
        v = v * 64 + (t[2 + i] & 63);
    }
    return v;
}
fn literal_value<a, b>(c: (&a mut C), t: &b [u8]) -> u64 {
    mut radix = 10;
    mut i = 0;
    if 2 < t.len() {
        if t[0] == 48 {
            r := t[1];
            if r == 120 {
                radix = 16;
                i = 2;
            }
            if r == 98 {
                radix = 2;
                i = 2;
            }
            if r == 111 {
                radix = 8;
                i = 2;
            }
        }
    }
    mut v = 0;
    mut any = 0;
    while i < t.len() {
        d := t[i];
        i += 1;
        if d == 95 {
            continue;
        }
        mut digit = 99;
        if (47 < d) & (d < 58) {
            digit = d - 48;
        }
        if (96 < d) & (d < 103) {
            digit = d - 87;
        }
        if (64 < d) & (d < 71) {
            digit = d - 55;
        }
        if (digit < radix) == 0 {
            fail(borrow_mut(c), &"invalid digit in integer literal");
        }
        if (18446744073709551615 - digit) / radix < v {
            fail(borrow_mut(c), &"integer literal exceeds 64 bits");
        }
        v = v * radix + digit;
        any = 1;
    }
    if any == 0 {
        fail(borrow_mut(c), &"integer literal has no digits");
    }
    return v;
}
// Literal metadata: the token span of the most recent bare literal and its (possibly negated) value.
fn literal_fits<a>(c: (&a mut C), ty: u64, value: u64, negative: u64) -> u64 {
    if ty == 0 {
        return negative == 0;
    }
    if is_char(borrow_mut(c), ty) {
        return (negative == 0) & (value < 1114112) & (((55295 < value) & (value < 57344)) == 0);
    }
    bits := ty_arg(borrow_mut(c), ty);
    signed := ty_mode(borrow_mut(c), ty);
    mut max = 18446744073709551615;
    if bits < 64 {
        max = 1;
        for i in bits {
            max = max * 2;
        }
        max = max - 1;
    }
    if signed {
        half := max / 2;
        if negative {
            return (value < half + 2);
        }
        return (value < half + 1);
    }
    if negative {
        return value == 0;
    }
    return (value < max) + (value == max);
}
fn adopt_literal<a>(c: (&a mut C), start: u64, end: u64, ty: u64) -> u64 {
    if (c.lit_start != start) + (c.lit_end != end) {
        return false;
    }
    value := c.lit_value;
    negative := c.lit_negative;
    if literal_fits(borrow_mut(c), ty, value, negative) == 0 {
        fail(borrow_mut(c), &"integer literal out of range for its type");
    }
    return true;
}
fn is_option_storage<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(borrow_mut(c), ty) != 8 {
        return false;
    }
    d := ty_arg(borrow_mut(c), ty);
    decl := &c.decls[d];
    return same(&decl.module, &"core") & same(&decl.name, &"OptionStorage");
}
// A bare literal (including a negated one) takes a sized integer type from its context.
fn adopt_value<a>(c: (&a mut C), v: Val, start: u64, end: u64, expected: u64) -> Val {
    mut v = hint_use(borrow_mut(c), v, start, end, expected);
    if (expected == 0) & is_default_i64(borrow_mut(c), v.ty) {
        return widen_to_u64(borrow_mut(c), v);
    }
    if (c.none_start == start) & (c.none_end == end) & is_option_storage(borrow_mut(c), expected) {
        tag := imm(borrow_mut(c), 0);
        payload := imm(borrow_mut(c), 0);
        slot := invoke(borrow_mut(c), &"rt_enum", two(tag, payload));
        own(borrow_mut(c), slot, expected);
        return val(slot, expected);
    }
    if is_union(borrow_mut(c), expected) & (same_type(borrow_mut(c), v.ty, expected) == 0) {
        args := type_args(borrow_mut(c), expected);
        if is_union(borrow_mut(c), v.ty) {
            expected_result := is_result_union(borrow_mut(c), expected);
            actual_result := is_result_union(borrow_mut(c), v.ty);
            if expected_result != actual_result {
                fail(borrow_mut(c), &"result and ordinary unions do not implicitly convert");
            }
            from := type_args(borrow_mut(c), v.ty);
            mut mapping = u64[];
            mut valid = 1;
            mut from_success = 0;
            mut to_success = 0;
            if expected_result {
                from_success = result_success_count(borrow_mut(c), v.ty);
                to_success = result_success_count(borrow_mut(c), expected);
            }
            for i in from.len() {
                mut found = 0;
                mut target = 0;
                for j in args.len() {
                    if same_type(borrow_mut(c), from[i], args[j]) {
                        found += 1;
                        target = j;
                    }
                }
                if found != 1 {
                    valid = 0;
                }
                if expected_result {
                    if (i < from_success) {
                        if to_success <= target {
                            fail(
                                borrow_mut(c),
                                &"result union conversion changes success/failure partition"
                            );
                        }
                    } else {
                        if target < to_success {
                            fail(
                                borrow_mut(c),
                                &"result union conversion changes success/failure partition"
                            );
                        }
                    }
                }
                mapping.push(target);
            }
            if valid {
                held := move_value(borrow_mut(c), v);
                done := label(borrow_mut(c));
                for i in mapping.len() {
                    next := label(borrow_mut(c));
                    get(borrow_mut(c), held.t, &"%rax");
                    o(borrow_mut(c), &"cmpq $");
                    on(borrow_mut(c), i);
                    o(borrow_mut(c), &",(%rax)\n");
                    jump(borrow_mut(c), &"jne", next);
                    o(borrow_mut(c), &"movq $");
                    on(borrow_mut(c), mapping[i]);
                    o(borrow_mut(c), &",(%rax)\n");
                    jump(borrow_mut(c), &"jmp", done);
                    mark(borrow_mut(c), next);
                }
                o(borrow_mut(c), &"call rt_abort\n");
                mark(borrow_mut(c), done);
                slot := held.t;
                source := place_of(borrow_mut(c), slot);
                move_out(borrow_mut(c), held);
                own(borrow_mut(c), slot, expected);
                dest := place_of(borrow_mut(c), slot);
                transfer_bonds(borrow_mut(c), source, dest);
                return val(slot, expected);
            }
        }
        mut found = 0;
        mut which = 0;
        for i in args.len() {
            if same_type(borrow_mut(c), v.ty, args[i]) {
                found += 1;
                which = i;
            }
        }
        if (found == 0)
            & (c.flit_start == start)
            & (c.flit_end == end)
            & is_float(borrow_mut(c), v.ty) {
            for i in args.len() {
                if is_f32(borrow_mut(c), args[i]) {
                    found += 1;
                    which = i;
                }
            }
            if found == 1 {
                v = adopt_float(borrow_mut(c), v, start, end, args[which]);
            }
        }
        if (found == 0)
            & (c.lit_start == start)
            & (c.lit_end == end)
            & ((v.ty == 0) + (c.lit_negative != 0)) {
            value := c.lit_value;
            negative := c.lit_negative;
            for i in args.len() {
                if literal_target(borrow_mut(c), args[i]) {
                    if literal_fits(borrow_mut(c), args[i], value, negative) {
                        found += 1;
                        which = i;
                    }
                }
            }
            if found == 1 {
                v = val(v.t, args[which]);
            }
        }
        if found > 1 {
            fail(borrow_mut(c), &"ambiguous union conversion");
        }
        if found == 1 {
            source := place_of(borrow_mut(c), v.t);
            tag := imm(borrow_mut(c), which);
            slot := invoke(borrow_mut(c), &"rt_enum", two(tag, v.t));
            own(borrow_mut(c), slot, expected);
            dest := place_of(borrow_mut(c), slot);
            transfer_bonds(borrow_mut(c), source, dest);
            move_out(borrow_mut(c), v);
            return val(slot, expected);
        }
    }
    if is_f32(borrow_mut(c), expected) {
        return adopt_float(borrow_mut(c), v, start, end, expected);
    }
    if literal_target(borrow_mut(c), expected) == 0 {
        return v;
    }
    if (c.lit_start != start) + (c.lit_end != end) {
        return v;
    }
    if (v.ty != 0) & (c.lit_negative == 0) {
        return v;
    }
    if adopt_literal(borrow_mut(c), start, end, expected) {
        return val(v.t, expected);
    }
    return v;
}
// A bare float literal (possibly negated) in an f32 context is rounded from its decimal text.
fn adopt_float<a>(c: (&a mut C), v: Val, start: u64, end: u64, expected: u64) -> Val {
    if (c.flit_start != start) + (c.flit_end != end) {
        return v;
    }
    if is_float(borrow_mut(c), v.ty) == 0 {
        return v;
    }
    if is_f32(borrow_mut(c), v.ty) {
        return v;
    }
    ftok := c.flit_tok;
    fneg := c.flit_neg;
    slot := float_literal_slot(borrow_mut(c), ftok, fneg);
    return val(slot, expected);
}
fn float_literal_slot<a>(c: (&a mut C), tok: u64, negative: u64) -> u64 {
    t := tok_text(borrow_mut(c), tok);
    mut bits = float_bits_p(borrow_mut(c), &t, 24);
    if negative {
        bits = bits ^ 9223372036854775808;
    }
    o(borrow_mut(c), &"movabsq $");
    on(borrow_mut(c), bits);
    o(borrow_mut(c), &",%rax\n");
    return save(borrow_mut(c));
}
fn is_default_i64<a>(c: (&a mut C), ty: u64) -> u64 {
    return (ty_kind(borrow_mut(c), ty) == 18)
        & (ty_arg(borrow_mut(c), ty) == 64)
        & (ty_mode(borrow_mut(c), ty) == 1);
}
fn widen_to_u64<a>(c: (&a mut C), v: Val) -> Val {
    if is_default_i64(borrow_mut(c), v.ty) == 0 {
        return v;
    }
    held := move_value(borrow_mut(c), v);
    slot := held.t;
    get(borrow_mut(c), slot, &"%rax");
    o(borrow_mut(c), &"testq %rax,%rax\n");
    ok := label(borrow_mut(c));
    jump(borrow_mut(c), &"jns", ok);
    o(borrow_mut(c), &"call rt_abort\n");
    mark(borrow_mut(c), ok);
    return val(slot, 0);
}
fn int_binary<a>(c: (&a mut C), k: u64, left: u64, right: u64, ty: u64) -> Val {
    // Sized integers are canonical (sign-extended) words, so most operations are emitted inline.
    bits := ty_arg(borrow_mut(c), ty);
    signed := ty_mode(borrow_mut(c), ty);
    checked := (c.overflow != 0) + (c.raw != 0);
    if is_comparison(k) {
        if signed {
            msb := imm(borrow_mut(c), 9223372036854775808);
            get(borrow_mut(c), msb, &"%rcx");
            get(borrow_mut(c), left, &"%rax");
            o(borrow_mut(c), &"xorq %rcx,%rax\n");
            l2 := save(borrow_mut(c));
            get(borrow_mut(c), msb, &"%rcx");
            get(borrow_mut(c), right, &"%rax");
            o(borrow_mut(c), &"xorq %rcx,%rax\n");
            r2 := save(borrow_mut(c));
            slot := binary(borrow_mut(c), k, l2, r2);
            ty2 := bool_type(borrow_mut(c));
            return val(slot, ty2);
        }
        slot := binary(borrow_mut(c), k, left, right);
        ty2 := bool_type(borrow_mut(c));
        return val(slot, ty2);
    }
    if (k == 38) + (k == 94) + (k == 124) {
        get(borrow_mut(c), right, &"%rcx");
        get(borrow_mut(c), left, &"%rax");
        if k == 38 {
            o(borrow_mut(c), &"andq %rcx,%rax\n");
        }
        if k == 94 {
            o(borrow_mut(c), &"xorq %rcx,%rax\n");
        }
        if k == 124 {
            o(borrow_mut(c), &"orq %rcx,%rax\n");
        }
        return val(save(borrow_mut(c)), ty);
    }
    if checked & ((k == 43) + (k == 45) + (k == 42)) & (bits < 64) {
        // Exact in 64 bits for these widths; then the result must fit the type.
        get(borrow_mut(c), right, &"%rcx");
        get(borrow_mut(c), left, &"%rax");
        if k == 43 {
            o(borrow_mut(c), &"addq %rcx,%rax\n");
        }
        if k == 45 {
            o(borrow_mut(c), &"subq %rcx,%rax\n");
        }
        if k == 42 {
            o(borrow_mut(c), &"imulq %rcx,%rax\n");
        }
        mut span = 1;
        for i in bits {
            span = span * 2;
        }
        o(borrow_mut(c), &"movq %rax,%rdx\n");
        if signed {
            o(borrow_mut(c), &"movabsq $");
            on(borrow_mut(c), span / 2);
            o(borrow_mut(c), &",%rcx\naddq %rcx,%rdx\n");
        }
        o(borrow_mut(c), &"movabsq $");
        on(borrow_mut(c), span);
        o(borrow_mut(c), &",%rcx\ncmpq %rcx,%rdx\n");
        ok := label(borrow_mut(c));
        jump(borrow_mut(c), &"jb", ok);
        o(borrow_mut(c), &"call rt_abort\n");
        mark(borrow_mut(c), ok);
        return val(save(borrow_mut(c)), ty);
    }
    if checked & ((k == 43) + (k == 45)) & (bits == 64) & (signed != 0) {
        // i64: overflow when the sign of the result disagrees with both (add) / the minuend (sub).
        get(borrow_mut(c), right, &"%rcx");
        get(borrow_mut(c), left, &"%rax");
        o(borrow_mut(c), &"movq %rax,%rdx\n");
        if k == 43 {
            o(
                borrow_mut(c),
                &"addq %rcx,%rax\nxorq %rax,%rdx\nmovq %rcx,%r11\nxorq %rax,%r11\nandq %r11,%rdx\n"
            );
        } else {
            o(
                borrow_mut(c),
                &"subq %rcx,%rax\nmovq %rdx,%r11\nxorq %rcx,%r11\nxorq %rax,%rdx\nandq %r11,%rdx\n"
            );
        }
        o(borrow_mut(c), &"shrq $63,%rdx\ntestq %rdx,%rdx\n");
        ok := label(borrow_mut(c));
        jump(borrow_mut(c), &"jz", ok);
        o(borrow_mut(c), &"call rt_abort\n");
        mark(borrow_mut(c), ok);
        return val(save(borrow_mut(c)), ty);
    }
    if checked & ((k == 47) + (k == 37)) {
        // Hardware unsigned division; signed operands divide magnitudes and restore the signs.
        get(borrow_mut(c), right, &"%rcx");
        get(borrow_mut(c), left, &"%rax");
        o(borrow_mut(c), &"testq %rcx,%rcx\n");
        nz := label(borrow_mut(c));
        jump(borrow_mut(c), &"jnz", nz);
        o(borrow_mut(c), &"call rt_abort\n");
        mark(borrow_mut(c), nz);
        if signed {
            o(borrow_mut(c), &"movq %rax,%r10\nshrq $63,%r10\ntestq %r10,%r10\n");
            pa := label(borrow_mut(c));
            jump(borrow_mut(c), &"jz", pa);
            o(borrow_mut(c), &"movq $0,%rdx\nsubq %rax,%rdx\nmovq %rdx,%rax\n");
            mark(borrow_mut(c), pa);
            o(borrow_mut(c), &"movq %rcx,%r11\nshrq $63,%r11\ntestq %r11,%r11\n");
            pb := label(borrow_mut(c));
            jump(borrow_mut(c), &"jz", pb);
            o(borrow_mut(c), &"movq $0,%rdx\nsubq %rcx,%rdx\nmovq %rdx,%rcx\n");
            mark(borrow_mut(c), pb);
        }
        o(borrow_mut(c), &"xorq %rdx,%rdx\ndivq %rcx\n");
        if k == 37 {
            o(borrow_mut(c), &"movq %rdx,%rax\n");
            if signed {
                o(borrow_mut(c), &"testq %r10,%r10\n");
                done := label(borrow_mut(c));
                jump(borrow_mut(c), &"jz", done);
                o(borrow_mut(c), &"movq $0,%rdx\nsubq %rax,%rdx\nmovq %rdx,%rax\n");
                mark(borrow_mut(c), done);
            }
        } else {
            if signed {
                o(borrow_mut(c), &"xorq %r11,%r10\ntestq %r10,%r10\n");
                pos := label(borrow_mut(c));
                done := label(borrow_mut(c));
                jump(borrow_mut(c), &"jz", pos);
                o(borrow_mut(c), &"movq $0,%rdx\nsubq %rax,%rdx\nmovq %rdx,%rax\n");
                jump(borrow_mut(c), &"jmp", done);
                mark(borrow_mut(c), pos);
                // MIN / -1 is the only overflow: the positive quotient 2^(bits-1) does not fit.
                mut half = 9223372036854775808;
                if bits < 64 {
                    half = 1;
                    for i in bits - 1 {
                        half = half * 2;
                    }
                }
                o(borrow_mut(c), &"movabsq $");
                on(borrow_mut(c), half);
                o(borrow_mut(c), &",%rcx\ncmpq %rcx,%rax\n");
                jump(borrow_mut(c), &"jb", done);
                o(borrow_mut(c), &"call rt_abort\n");
                mark(borrow_mut(c), done);
            }
        }
        return val(save(borrow_mut(c)), ty);
    }
    code := int_code(borrow_mut(c), ty);
    op := imm(borrow_mut(c), k);
    cv := imm(borrow_mut(c), code);
    mut args = u64[];
    args.push(op);
    args.push(left);
    args.push(right);
    args.push(cv);
    slot := invoke(borrow_mut(c), &"rt_int", args);
    if is_comparison(k) {
        ty2 := bool_type(borrow_mut(c));
        return val(slot, ty2);
    }
    return val(slot, ty);
}
// ---- capturing closures: `|x: T, ...| -> R body`, type Fn(T,...)->R (kind 20) ----
// The value is an owned record {code, dropper, captures...}. Scalars are copied into it and owned
// values moved; borrowed values cannot be captured yet. The body is compiled afterwards as a
// separate function whose hidden first parameter is a shared reference to that record, so
// captures are read-only fields (no mutation, no moving out).
fn closure_free_name<a, b>(c: (&a mut C), name: &b [u8], params: (&a u8[][])) -> u64 {
    for i in params.len() {
        p := &params[i];
        if same(&p, &name) {
            return false;
        }
    }
    return true;
}
fn closure_literal<a>(c: (&a mut C)) -> Val {
    // Inside a generic function the closure is compiled once per specialization, with its bindings.
    if (c.tnames.len() != 0) & (c.bindings.len() == 0) & (c.validating == 0) {
        fail(borrow_mut(c), &"closures inside generic functions are not supported here");
    }
    mut names = u8[][];
    mut params = u64[];
    if eat(borrow_mut(c), &"||") == 0 {
        expect(borrow_mut(c), &"|");
        exchange(borrow_mut(c.no_union), 1);
        if eat(borrow_mut(c), &"|") == 0 {
            while true {
                n := ident(borrow_mut(c));
                expect(borrow_mut(c), &":");
                ty := parse_type(borrow_mut(c));
                if contains_borrow(borrow_mut(c), ty, 0) {
                    fail(borrow_mut(c), &"closure parameters cannot hold borrows yet");
                }
                names.push(n);
                params.push(ty);
                if eat(borrow_mut(c), &"|") {
                    break;
                }
                expect(borrow_mut(c), &",");
            }
        }
    }
    exchange(borrow_mut(c.no_union), 0);
    if 5 < params.len() {
        fail(borrow_mut(c), &"closure exceeds five parameters");
    }
    mut ret = 1;
    if eat(borrow_mut(c), &"->") {
        ret = parse_type(borrow_mut(c));
    }
    start := c.pos;
    if is(borrow_mut(c), &"{") {
        skip_braces(borrow_mut(c));
    } else {
        mut depth = 0;
        while true {
            k := kind(borrow_mut(c));
            if k == 0 {
                break;
            }
            if (k == 40) + (k == 91) + (k == 123) {
                depth += 1;
            }
            if (k == 41) + (k == 93) + (k == 125) {
                if depth == 0 {
                    break;
                }
                depth -= 1;
            }
            if ((k == 44) + (k == 59)) & (depth == 0) {
                break;
            }
            advance(borrow_mut(c));
        }
    }
    end := c.pos;
    // Captures: enclosing locals named in the body (not parameters, fields, paths or inner bindings).
    mut captures = u8[][];
    mut inner = u8[][];
    mut i = start;
    while i < end {
        if kind_at(borrow_mut(c), i) == 1 {
            nk := kind_at(borrow_mut(c), i + 1);
            if nk == 261 {
                t := tok_text(borrow_mut(c), i);
                inner.push(t);
            }
            if i > 0 {
                if (kind_at(borrow_mut(c), i - 1) == 1) {
                    prev := tok_text(borrow_mut(c), i - 1);
                    if same(&prev, &"mut") {
                        t := tok_text(borrow_mut(c), i);
                        inner.push(t);
                    }
                }
            }
        }
        i += 1;
    }
    i = start;
    while i < end {
        if kind_at(borrow_mut(c), i) == 1 {
            mut skip = 0;
            if i > 0 {
                pk := kind_at(borrow_mut(c), i - 1);
                if (pk == 46) + (pk == 260) {
                    skip = 1;
                }
            }
            nk := kind_at(borrow_mut(c), i + 1);
            if (nk == 58) + (nk == 260) {
                skip = 1;
            }
            if skip == 0 {
                name := tok_text(borrow_mut(c), i);
                if closure_free_name(borrow_mut(c), &name, borrow(names))
                    & closure_free_name(borrow_mut(c), &name, borrow(inner))
                    & closure_free_name(borrow_mut(c), &name, borrow(captures)) {
                    if find_local(borrow_mut(c), &name) != 0 {
                        captures.push(name);
                    }
                }
            }
        }
        i += 1;
    }
    // Template validation checks captures and moves only; specializations build the real object.
    if c.validating {
        for j in captures.len() {
            name := &captures[j];
            local := find_local(borrow_mut(c), &name);
            id := local_id(borrow_mut(c), local - 1);
            ty := local_ty(borrow_mut(c), local - 1);
            if contains_borrow(borrow_mut(c), ty, 0) + (ty_kind(borrow_mut(c), ty) == 7) {
                fail(borrow_mut(c), &"closures cannot capture borrowed values yet");
            }
            observe(borrow_mut(c), id);
            if needs_drop(borrow_mut(c), ty) {
                held := move_value(borrow_mut(c), val(id, ty));
                move_out(borrow_mut(c), held);
            }
        }
        vfn := intern_args(borrow_mut(c), 20, ret, 0, u64[], copy_numbers(borrow(params)));
        placeholder := imm(borrow_mut(c), 0);
        return own(borrow_mut(c), placeholder, vfn);
    }
    // Environment record type: {__code, __drop, captures...}.
    index := c.closures.len();
    mut decl_name = copy_bytes(&"Closure");
    decimal(borrow_mut(decl_name), index);
    first := c.fields.len();
    c.fields.push(Field { name: copy_bytes(&"__code"), ty: 0 });
    c.fields.push(Field { name: copy_bytes(&"__drop"), ty: 0 });
    mut slots = u64[];
    mut types = u64[];
    for j in captures.len() {
        name := &captures[j];
        local := find_local(borrow_mut(c), &name);
        id := local_id(borrow_mut(c), local - 1);
        ty := local_ty(borrow_mut(c), local - 1);
        if contains_borrow(borrow_mut(c), ty, 0) + (ty_kind(borrow_mut(c), ty) == 7) {
            fail(borrow_mut(c), &"closures cannot capture borrowed values yet");
        }
        if contains_task(borrow_mut(c), ty, 0) {
            fail(borrow_mut(c), &"closures cannot capture Task handles");
        }
        c.fields.push(Field { name: name.copy(), ty: ty });
        slots.push(id);
        types.push(ty);
    }
    count := 2 + captures.len();
    c
        .decls
        .push(
            Decl {
                module: copy_bytes(&".closure"),
                name: decl_name,
                is_enum: 0,
                first: first,
                count: count,
                regions: 0,
                types: 0,
                success: 0,
                bounds: u64[],
                constraints: u64[][],
            }
        );
    decl := c.decls.len() - 1;
    envty := intern_args(borrow_mut(c), 8, decl, 0, u64[], u64[]);
    fnty := intern_args(borrow_mut(c), 20, ret, 0, u64[], copy_numbers(borrow(params)));
    // Build the object.
    sz := imm(borrow_mut(c), count);
    obj := invoke(borrow_mut(c), &"rt_rec", one(sz));
    mut symbol = copy_bytes(&"c");
    decimal(borrow_mut(symbol), index);
    o(borrow_mut(c), &"leaq ");
    mangle(borrow_mut(c), &".closure", &symbol);
    o(borrow_mut(c), &"(%rip),%rax\n");
    code := save(borrow_mut(c));
    rec_store(borrow_mut(c), obj, 0, code);
    o(borrow_mut(c), &"leaq ");
    drop_name(borrow_mut(c), envty);
    o(borrow_mut(c), &"(%rip),%rax\n");
    dropper := save(borrow_mut(c));
    rec_store(borrow_mut(c), obj, 1, dropper);
    for j in slots.len() {
        slot := slots[j];
        ty := types[j];
        observe(borrow_mut(c), slot);
        if needs_drop(borrow_mut(c), ty) {
            held := move_value(borrow_mut(c), val(slot, ty));
            rec_store(borrow_mut(c), obj, 2 + j, held.t);
            move_out(borrow_mut(c), held);
        } else {
            get(borrow_mut(c), slot, &"%rax");
            copy := save(borrow_mut(c));
            rec_store(borrow_mut(c), obj, 2 + j, copy);
        }
    }
    file := c.file;
    module := module_copy(borrow_mut(c));
    if c.validating == 0 {
        tn := copy_names(borrow(c.tnames));
        bn := copy_numbers(borrow(c.bindings));
        c
            .closures
            .push(
                Closure {
                    decl: decl,
                    start: start,
                    file: file,
                    module: module,
                    captures: captures,
                    names: names,
                    params: params,
                    ret: ret,
                    symbol: symbol,
                    tnames: tn,
                    bindings: bn,
                }
            );
    }
    return own(borrow_mut(c), obj, fnty);
}
fn copy_bytes<a>(x: &a [u8]) -> u8[] {
    mut o = u8[];
    for i in x.len() {
        o.push(x[i]);
    }
    return o;
}
// A captured name inside a closure body reads the environment field (read-only alias).
fn capture_field<a, b>(c: (&a mut C), name: &b [u8], address: u64) -> Val {
    current := c.closure_env;
    if current == 0 {
        return val(0, 18446744073709551615);
    }
    cl := &c.closures[current - 1];
    mut index = 18446744073709551615;
    for j in cl.captures.len() {
        x := &cl.captures[j];
        if same(&x, &name) {
            index = j;
        }
    }
    if index == 18446744073709551615 {
        return val(0, 18446744073709551615);
    }
    env := local_id(borrow_mut(c), 0);
    envref := local_ty(borrow_mut(c), 0);
    base := deref(borrow_mut(c), val(env, envref));
    b := base.t;
    k := index + 2;
    fty := field_type(borrow_mut(c), base.ty, k);
    if address {
        n := rec_load(borrow_mut(c), b, k, 1);
        ty := reference_type(borrow_mut(c), fty, 0);
        root := place_of(borrow_mut(c), b);
        target := member_place(borrow_mut(c), root, k, fty);
        authority := authority_of(borrow_mut(c), b);
        c
            .resources
            .push(
                Resource {
                    slot: n,
                    ty: ty,
                    flag: 0,
                    base: b + 1,
                    field: k,
                    via: 1,
                    place: 0,
                    target: target,
                    authority: authority,
                }
            );
        return val(n, ty);
    }
    n := rec_load(borrow_mut(c), b, k, 0);
    alias_field(borrow_mut(c), n, fty, b, k, 1);
    observe(borrow_mut(c), n);
    return val(n, fty);
}
fn emit_closures<a>(c: (&a mut C)) -> unit {
    mut i = 0;
    while i < c.closures.len() {
        cl := &c.closures[i];
        file := cl.file;
        start := cl.start;
        module := cl.module.copy();
        ret := cl.ret;
        decl := cl.decl;
        symbol := cl.symbol.copy();
        names := copy_names(borrow(cl.names));
        params := copy_numbers(borrow(cl.params));
        load_file(borrow_mut(c), file);
        exchange(borrow_mut(c.file), file);
        exchange(borrow_mut(c.raw), 0);
        exchange(borrow_mut(c.module), module);
        exchange(borrow_mut(c.pos), start);
        exchange(borrow_mut(c.locals), Local[]);
        exchange(borrow_mut(c.resources), Resource[]);
        exchange(borrow_mut(c.next), 0);
        exchange(borrow_mut(c.scope_end), 0);
        exchange(borrow_mut(c.loop_start), 0);
        exchange(borrow_mut(c.loop_end), 0);
        exchange(borrow_mut(c.check), ownership::new());
        exchange(borrow_mut(c.members), Member[]);
        exchange(borrow_mut(c.terminated), 0);
        exchange(borrow_mut(c.bonds), Bond[]);
        exchange(borrow_mut(c.origins), Origin[]);
        mut regions = u8[][];
        regions.push(copy_bytes(&"env"));
        exchange(borrow_mut(c.rnames), regions);
        closure := &c.closures[i];
        tn := copy_names(borrow(closure.tnames));
        bn := copy_numbers(borrow(closure.bindings));
        exchange(borrow_mut(c.tnames), tn);
        exchange(borrow_mut(c.bindings), bn);
        exchange(borrow_mut(c.closure_env), i + 1);
        exchange(borrow_mut(c.result), ret);
        envty := intern_args(borrow_mut(c), 8, decl, 0, u64[], u64[]);
        mut rs = u64[];
        rs.push(1);
        envref := intern_full(borrow_mut(c), 7, envty, 0, rs);
        id := fresh(borrow_mut(c));
        bind(borrow_mut(c), copy_bytes(&".env"), envref, id, 0);
        // The environment is never named in the body; keep it live until the closure returns.
        forever := c.toks.len();
        mut envlocal = &mut c.locals[0];
        exchange(borrow_mut(envlocal.last), forever);
        for j in params.len() {
            pid := fresh(borrow_mut(c));
            pn := &names[j];
            bind(borrow_mut(c), pn.copy(), params[j], pid, 0);
        }
        count := 1 + params.len();
        o(borrow_mut(c), &".type ");
        mangle(borrow_mut(c), &".closure", &symbol);
        o(borrow_mut(c), &",@function\n");
        mangle(borrow_mut(c), &".closure", &symbol);
        o(borrow_mut(c), &":\npushq %rbp\nmovq %rsp,%rbp\nsubq $.F");
        frame := label(borrow_mut(c));
        on(borrow_mut(c), frame);
        o(borrow_mut(c), &",%rsp\n");
        for j in count {
            reg := argreg(j);
            o(borrow_mut(c), &"movq ");
            o(borrow_mut(c), &reg);
            c.out.push(44);
            stack_slot(borrow_mut(c), j);
            c.out.push(10);
        }
        o(borrow_mut(c), &"leaq -.F");
        on(borrow_mut(c), frame);
        o(borrow_mut(c), &"(%rbp),%rdi\nmovq $.F");
        on(borrow_mut(c), frame);
        o(borrow_mut(c), &"/8-");
        on(borrow_mut(c), count);
        o(borrow_mut(c), &",%rcx\nxorl %eax,%eax\nrep stosq\n");
        for j in count {
            mut l = &c.locals[j];
            slot := l.id;
            ty := l.ty;
            own(borrow_mut(c), slot, ty);
            init_parameter(borrow_mut(c), slot, ty);
        }
        if is(borrow_mut(c), &"{") {
            end := block_end(borrow_mut(c), start);
            exchange(borrow_mut(c.scope_end), end);
            block(borrow_mut(c));
            if (c.terminated == 0) & (ret != 1) {
                fail(borrow_mut(c), &"closure may fall through without return");
            }
        } else {
            start := c.pos;
            mut v = expr(borrow_mut(c), 0);
            end := c.pos;
            v = adopt_value(borrow_mut(c), v, start, end, ret);
            require_type(borrow_mut(c), v.ty, ret);
            validate_return(borrow_mut(c), val(v.t, v.ty));
            move_out(borrow_mut(c), val(v.t, v.ty));
            cleanup(borrow_mut(c), 0);
            get(borrow_mut(c), v.t, &"%rax");
            o(borrow_mut(c), &"leave\nret\n");
            exchange(borrow_mut(c.terminated), 1);
        }
        cleanup(borrow_mut(c), 0);
        o(borrow_mut(c), &"xorq %rax,%rax\nleave\nret\n.set .F");
        on(borrow_mut(c), frame);
        c.out.push(44);
        n := c.next;
        on(borrow_mut(c), div(n + 1, 2) * 16);
        c.out.push(10);
        exchange(borrow_mut(c.closure_env), 0);
        i += 1;
    }
    return ();
}
fn copy_names<a>(input: (&a u8[][])) -> u8[][] {
    mut out = u8[][];
    for i in input.len() {
        x := &input[i];
        out.push(x.copy());
    }
    return out;
}
fn mutex_type<a>(c: (&a mut C), payload: u64) -> u64 {
    // Guarded payloads cannot hold borrows yet: a writer could otherwise store a loan that
    // outlives its source after the lock is released. Lifetime-parameterized mutexes are future work.
    if c.raw == 0 {
        if contains_borrow(borrow_mut(c), payload, 0) {
            fail(borrow_mut(c), &"Mutex payload cannot contain borrows yet");
        }
        if contains_task(borrow_mut(c), payload, 0) {
            fail(
                borrow_mut(c),
                &"Mutex payload cannot hold Task handles (they would escape their Scope)"
            );
        }
    }
    return intern(borrow_mut(c), 13, payload);
}
// m.lock_with(context, callback): exclusive payload access exists only for the callback's
// duration. The callback is capture-free; its result and context cannot carry the payload loan.
fn mutex_method<a, b>(c: (&a mut C), value: Val, name: &b [u8]) -> Val {
    if same(&name, &"lock_with") == 0 {
        fail(borrow_mut(c), &"unknown Mutex method (expected lock_with)");
    }
    cell := value.t;
    payload := ty_arg(borrow_mut(c), value.ty);
    observe(borrow_mut(c), cell);
    mut keeper = 0;
    if c.raw == 0 {
        target := place_of(borrow_mut(c), cell);
        ty := reference_type(borrow_mut(c), value.ty, 0);
        o(borrow_mut(c), &"leaq ");
        stack_slot(borrow_mut(c), cell);
        o(borrow_mut(c), &",%rax\n");
        keeper = save(borrow_mut(c));
        borrow_reference(borrow_mut(c), keeper, ty, cell, target, 0);
    }
    context := expr(borrow_mut(c), 0);
    expect(borrow_mut(c), &",");
    callee := expr(borrow_mut(c), 0);
    expect(borrow_mut(c), &")");
    input := callee.t;
    function := deref(borrow_mut(c), callee);
    fty := function.ty;
    if ty_kind(borrow_mut(c), fty) != 12 {
        fail(borrow_mut(c), &"lock_with requires a callable");
    }
    signature := type_args(borrow_mut(c), fty);
    result := ty_arg(borrow_mut(c), fty);
    if signature.len() != 2 {
        fail(borrow_mut(c), &"lock_with callback takes (ref_mut payload, context)");
    }
    guard := signature[0];
    expected := signature[1];
    if (ty_kind(borrow_mut(c), guard) != 7) + (ty_mode(borrow_mut(c), guard) == 0) {
        fail(borrow_mut(c), &"lock_with callback must take an exclusive payload reference");
    }
    inner := ty_arg(borrow_mut(c), guard);
    require_type(borrow_mut(c), inner, payload);
    require_type(borrow_mut(c), context.ty, expected);
    if contains_borrow(borrow_mut(c), result, 0) {
        fail(borrow_mut(c), &"lock_with result cannot contain borrows");
    }
    loan := type_regions(borrow_mut(c), guard);
    carried := type_caps(borrow_mut(c), expected, 0);
    if intersects(borrow(loan), borrow(carried)) {
        fail(borrow_mut(c), &"lock_with context cannot carry the guarded payload lifetime");
    }
    observe(borrow_mut(c), function.t);
    get(borrow_mut(c), function.t, &"%rax");
    target := save(borrow_mut(c));
    kind := ty_kind(borrow_mut(c), context.ty);
    if (kind == 5) + (kind == 7) {
        observe(borrow_mut(c), context.t);
    }
    if kind == 7 {
        place := target_of(borrow_mut(c), context.t);
        capture_authority(borrow_mut(c), place);
    }
    held := move_value(borrow_mut(c), context);
    heldslot := held.t;
    move_out(borrow_mut(c), held);
    observe(borrow_mut(c), cell);
    invoke(borrow_mut(c), &"rt_mutex_lock", one(cell));
    get(borrow_mut(c), cell, &"%rax");
    o(borrow_mut(c), &"leaq 8(%rax),%rax\n");
    pointer := save(borrow_mut(c));
    get(borrow_mut(c), pointer, &"%rdi");
    get(borrow_mut(c), heldslot, &"%rsi");
    get(borrow_mut(c), target, &"%rax");
    o(borrow_mut(c), &"call *%rax\n");
    slot := save(borrow_mut(c));
    invoke(borrow_mut(c), &"rt_mutex_unlock", one(cell));
    own(borrow_mut(c), slot, result);
    if keeper {
        index := resource(borrow_mut(c), keeper);
        release(borrow_mut(c), index - 1);
    }
    release_temporary(borrow_mut(c), input);
    close_loans(borrow_mut(c));
    return val(slot, result);
}
fn atomic_method<a, b>(c: (&a mut C), value: Val, name: &b [u8]) -> Val {
    cell := value.t;
    observe(borrow_mut(c), cell);
    mut keeper = 0;
    // Interior atomic mutation needs read authority, but its owner must remain
    // alive and at the same place throughout evaluation of every argument.
    if c.raw == 0 {
        target := place_of(borrow_mut(c), cell);
        ty := reference_type(borrow_mut(c), value.ty, 0);
        o(borrow_mut(c), &"leaq ");
        stack_slot(borrow_mut(c), cell);
        o(borrow_mut(c), &",%rax\n");
        keeper = save(borrow_mut(c));
        borrow_reference(borrow_mut(c), keeper, ty, cell, target, 0);
    }
    mut args = one(cell);
    mut unit = 0;
    mut arity = 0;
    mut f = "";
    if same(&name, &"load") {
        f = "rt_atomic_load";
    }
    if same(&name, &"load_relaxed") {
        f = "rt_atomic_load_relaxed";
    }
    if same(&name, &"load_acquire") {
        f = "rt_atomic_load_acquire";
    }
    if same(&name, &"store") {
        f = "rt_atomic_store";
        arity = 1;
        unit = 1;
    }
    if same(&name, &"store_relaxed") {
        f = "rt_atomic_store_relaxed";
        arity = 1;
        unit = 1;
    }
    if same(&name, &"store_release") {
        f = "rt_atomic_store_release";
        arity = 1;
        unit = 1;
    }
    if same(&name, &"fetch_add") {
        f = "rt_atomic_fetch_add";
        arity = 1;
    }
    if same(&name, &"fetch_sub") {
        f = "rt_atomic_fetch_sub";
        arity = 1;
    }
    if same(&name, &"swap") {
        f = "rt_atomic_swap";
        arity = 1;
    }
    if same(&name, &"compare_exchange") {
        f = "rt_atomic_compare_exchange";
        arity = 2;
    }
    if f.len() == 0 {
        fail(borrow_mut(c), &"unknown Atomic method or invalid ordering");
    }
    for i in arity {
        if i != 0 {
            expect(borrow_mut(c), &",");
        }
        argument := expr(borrow_mut(c), 0);
        if c.raw == 0 {
            require_type(borrow_mut(c), argument.ty, 0);
        }
        get(borrow_mut(c), argument.t, &"%rax");
        snapshot := save(borrow_mut(c));
        args.push(snapshot);
    }
    expect(borrow_mut(c), &")");
    observe(borrow_mut(c), cell);
    slot := invoke(borrow_mut(c), &f, args);
    if keeper {
        index := resource(borrow_mut(c), keeper);
        release(borrow_mut(c), index - 1);
    }
    return val(slot, unit);
}
fn method_receiver<a>(c: (&a mut C), input: u64, inty: u64, xty: u64, formal: u64) -> Val {
    mut rv = input;
    mut rty = inty;
    if ty_kind(borrow_mut(c), formal) == 7 {
        if ty_kind(borrow_mut(c), inty) != 7 {
            mode := ty_mode(borrow_mut(c), formal);
            refty := reference_type(borrow_mut(c), xty, mode);
            mut temporary = 0;
            if is_local_slot(borrow_mut(c), input) == 0 {
                index := resource(borrow_mut(c), input);
                if index != 0 {
                    info := &c.resources[index - 1];
                    if (info.base == 0) & (info.place != 0) {
                        temporary = 1;
                    }
                }
            }
            if is_local_slot(borrow_mut(c), input) + temporary {
                if mode & (temporary == 0) {
                    require_mutable_binding(borrow_mut(c), input, 1);
                }
                target := place_of(borrow_mut(c), input);
                o(borrow_mut(c), &"leaq ");
                stack_slot(borrow_mut(c), input);
                o(borrow_mut(c), &",%rax\n");
                slot := save(borrow_mut(c));
                r := borrow_reference(borrow_mut(c), slot, refty, input, target, mode);
                rv = r.t;
                rty = r.ty;
            } else {
                // A field receiver (a.b.method()) is borrowed in place, like borrow(a.b).
                index := resource(borrow_mut(c), input);
                if index == 0 {
                    fail(borrow_mut(c), &"method receiver must be a variable, field or reference");
                }
                info := &c.resources[index - 1];
                base := info.base;
                field := info.field;
                via := info.via;
                referent_place := info.place;
                if base == 0 {
                    fail(borrow_mut(c), &"method receiver must be a variable, field or reference");
                }
                b := base - 1;
                // A loaded referent (including map[key]) is already addressed by its
                // base reference. Reborrow that authority, not a fictitious child of
                // the reference holder; ordinary record fields take the path below.
                owner := resource(borrow_mut(c), b);
                if owner != 0 {
                    basety := c.resources[owner - 1].ty;
                    if ty_kind(borrow_mut(c), basety) == 7 {
                        target := target_of(borrow_mut(c), b);
                        inner := ty_arg(borrow_mut(c), basety);
                        if (target == referent_place) & same_type(borrow_mut(c), inner, xty) {
                            return place_slot(borrow_mut(c), b, basety, mode);
                        }
                    }
                }
                if mode {
                    require_mutable_binding(borrow_mut(c), b, 0);
                }
                n := rec_load(borrow_mut(c), b, field, 1);
                root := place_of(borrow_mut(c), b);
                target := member_place(borrow_mut(c), root, field, xty);
                authority := authority_of(borrow_mut(c), b);
                c
                    .resources
                    .push(
                        Resource {
                            slot: n,
                            ty: refty,
                            flag: 0,
                            base: b + 1,
                            field: field,
                            via: via,
                            place: 0,
                            target: target,
                            authority: authority,
                        }
                    );
                r := borrow_reference(borrow_mut(c), n, refty, b, target, mode);
                rv = r.t;
                rty = r.ty;
            }
        } else {
            // A reference receiver is reborrowed for the call, so the binding stays usable.
            mode := ty_mode(borrow_mut(c), formal);
            if mode & (ty_mode(borrow_mut(c), inty) == 0) {
                fail(borrow_mut(c), &"method needs a mutable receiver but got a shared reference");
            }
            refty := reference_type(borrow_mut(c), xty, mode);
            source := target_of(borrow_mut(c), input);
            get(borrow_mut(c), input, &"%rax");
            slot := save(borrow_mut(c));
            r := borrow_reference(borrow_mut(c), slot, refty, input, source, mode);
            rv = r.t;
            rty = r.ty;
        }
    } else {
        if ty_kind(borrow_mut(c), inty) == 7 {
            fail(borrow_mut(c), &"method takes self by value but the receiver is a reference");
        }
    }
    return val(rv, rty);
}
// Values whose type has an inherent `show(self: &a Self) -> string` print through it.
fn show_value<a>(c: (&a mut C), input: u64, inty: u64, xty: u64) -> Val {
    if ty_kind(borrow_mut(c), xty) != 8 {
        return val(0, 18446744073709551615);
    }
    d := ty_arg(borrow_mut(c), xty);
    owner := private_module(&".inherent_", d);
    f := find_func(borrow_mut(c), &owner, &"show");
    if f == 0 {
        return val(0, 18446744073709551615);
    }
    info := &c.funcs[f - 1];
    first := info.first;
    count := info.count;
    if count != 1 {
        fail(borrow_mut(c), &"show must take only self");
    }
    formal := c.params[first];
    if ty_kind(borrow_mut(c), formal) != 7 {
        fail(borrow_mut(c), &"show must take self by reference");
    }
    prepared := method_receiver(borrow_mut(c), input, inty, xty, formal);
    exchange(borrow_mut(c.receiver), prepared.t);
    exchange(borrow_mut(c.receiver_ty), prepared.ty);
    exchange(borrow_mut(c.has_receiver), 2);
    return call(borrow_mut(c), &owner, &"show");
}
// Built-in methods on string / bytes / views. Results are new values; `string` input gives `string`.
fn text_arg<a>(c: (&a mut C)) -> Val {
    v := expr(borrow_mut(c), 0);
    if is_text(borrow_mut(c), v.ty) == 0 {
        fail(borrow_mut(c), &"text method argument must be text");
    }
    return v;
}
fn text_method<a, b>(c: (&a mut C), xt: u64, k: u64, name: &b [u8]) -> Val {
    mut result = 2;
    if k == 4 {
        result = 3;
    }
    bt := bool_type(borrow_mut(c));
    if same(&name, &"contains") + same(&name, &"starts_with") + same(&name, &"ends_with") {
        arg := text_arg(borrow_mut(c));
        expect(borrow_mut(c), &")");
        mut f = "rt_seq_contains";
        if same(&name, &"starts_with") {
            f = "rt_seq_starts";
        }
        if same(&name, &"ends_with") {
            f = "rt_seq_ends";
        }
        r := invoke(borrow_mut(c), &f, two(xt, arg.t));
        release_temporary(borrow_mut(c), arg.t);
        return val(r, bt);
    }
    if same(&name, &"to_upper") + same(&name, &"to_lower") + same(&name, &"trim") {
        expect(borrow_mut(c), &")");
        mut f = "rt_seq_trim";
        if same(&name, &"to_upper") {
            f = "rt_seq_upper";
        }
        if same(&name, &"to_lower") {
            f = "rt_seq_lower";
        }
        r := invoke(borrow_mut(c), &f, one(xt));
        return own(borrow_mut(c), r, result);
    }
    if same(&name, &"replace") {
        from := text_arg(borrow_mut(c));
        expect(borrow_mut(c), &",");
        to := text_arg(borrow_mut(c));
        expect(borrow_mut(c), &")");
        valid := imm(borrow_mut(c), k == 4);
        mut args = u64[];
        args.push(xt);
        args.push(from.t);
        args.push(to.t);
        args.push(valid);
        r := invoke(borrow_mut(c), &"rt_seq_replace", args);
        release_temporary(borrow_mut(c), from.t);
        release_temporary(borrow_mut(c), to.t);
        return own(borrow_mut(c), r, result);
    }
    if same(&name, &"repeat") {
        n := expr(borrow_mut(c), 0);
        require_type(borrow_mut(c), n.ty, 0);
        expect(borrow_mut(c), &")");
        r := invoke(borrow_mut(c), &"rt_seq_repeat", two(xt, n.t));
        return own(borrow_mut(c), r, result);
    }
    if same(&name, &"chars") {
        expect(borrow_mut(c), &")");
        r := invoke(borrow_mut(c), &"rt_seq_chars", one(xt));
        ch := char_type(borrow_mut(c));
        vt := intern(borrow_mut(c), 6, ch);
        return own(borrow_mut(c), r, vt);
    }
    if same(&name, &"split") {
        sep := expr(borrow_mut(c), 0);
        require_type(borrow_mut(c), sep.ty, 0);
        expect(borrow_mut(c), &")");
        valid := imm(borrow_mut(c), k == 4);
        r := invoke(borrow_mut(c), &"rt_seq_split", three(xt, sep.t, valid));
        vt := intern(borrow_mut(c), 6, result);
        return own(borrow_mut(c), r, vt);
    }
    return val(0, 18446744073709551615);
}
fn char_method<a>(n: &a [u8]) -> u64 {
    return same(&n, &"is_alphabetic")
        + same(&n, &"is_alphanumeric")
        + same(&n, &"is_ascii_digit")
        + same(&n, &"is_whitespace")
        + same(&n, &"is_uppercase")
        + same(&n, &"is_lowercase")
        + same(&n, &"is_ascii")
        + same(&n, &"to_uppercase")
        + same(&n, &"to_lowercase")
        + same(&n, &"len_utf8");
}
fn collection_method<a>(c: (&a mut C), value: Val) -> Val {
    // ' '.is_whitespace(): a bare character literal receiver of a char method is a char.
    literal_receiver := (value.ty == 0) & (c.lit_end == c.pos) & (c.lit_value < 128);
    advance(borrow_mut(c));
    name := ident(borrow_mut(c));
    expect(borrow_mut(c), &"(");
    mut value = value;
    if literal_receiver & char_method(&name) {
        ch := char_type(borrow_mut(c));
        value = val(value.t, ch);
    }
    input := value.t;
    inty := value.ty;
    x := deref(borrow_mut(c), value);
    xt := x.t;
    xty := x.ty;
    k := ty_kind(borrow_mut(c), xty);
    if k == 8 {
        d := ty_arg(borrow_mut(c), xty);
        mut owner = private_module(&".inherent_", d);
        mut method = find_func(borrow_mut(c), &owner, &name);
        // Otherwise an interface method implemented for this type: value.less(other).
        if method == 0 {
            mut found = 0;
            for i in c.implementations.len() {
                item := &c.implementations[i];
                ity := item.ty;
                if same_type(borrow_mut(c), ity, xty) {
                    candidate := private_module(&".impl_", i + 1);
                    m2 := find_func(borrow_mut(c), &candidate, &name);
                    if m2 != 0 {
                        if found {
                            fail(
                                borrow_mut(c),
                                &"ambiguous method: several interfaces define it (use Interface::method)"
                            );
                        }
                        found = 1;
                        owner = candidate;
                        method = m2;
                    }
                }
            }
        }
        if method != 0 {
            info := &c.funcs[method - 1];
            first := info.first;
            count := info.count;
            if count == 0 {
                fail(borrow_mut(c), &"associated function called as a method (use Type::name)");
            }
            formal := c.params[first];
            prepared := method_receiver(borrow_mut(c), input, inty, xty, formal);
            rv := prepared.t;
            rty := prepared.ty;
            exchange(borrow_mut(c.receiver), rv);
            exchange(borrow_mut(c.receiver_ty), rty);
            exchange(borrow_mut(c.has_receiver), 1);
            return call(borrow_mut(c), &owner, &name);
        }
        field := find_field(borrow_mut(c), d, &name);
        ft := field_type(borrow_mut(c), xty, field);
