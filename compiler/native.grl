// From just after `[`: whether the brackets hold a single index (no `:` at their own depth).
fn element_index_ahead<a>(c: (&a mut C)) -> bool {
    mut i = c.pos;
    mut depth = 0;
    while true {
        k := kind_at(&mut c, i);
        if k == 0 {
            return false;
        }
        if (k == 40) || (k == 91) || (k == 123) {
            depth += 1;
        }
        if (k == 41) || (k == 93) || (k == 125) {
            if depth == 0 {
                return k == 93;
