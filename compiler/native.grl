    }
    if (id == 37) || (id == 38) {
        expect(&mut c, view(")"));
        input := a.t;
        x := deref(&mut c, a);
        xt := x.t;
        write := id == 38;
        if c.raw == 0 {
            k := ty_kind(&mut c, x.ty);
            if (k != 2) & (k != 3) & (k != 4) & (k != 5) {
                fail(&mut c, view("view requires byte sequence or view"));
            }
            if write {
                require_mutable_binding(&mut c, xt, 0);
                if k == 4 {
                    fail(&mut c, view("string bytes cannot be mutably viewed"));
                }
            }
        }
        ty := intern_full(&mut c, 5, 0, write, u64[]);
        slot := apply(&mut c, view("rt_view"), one(xt));
        own(&mut c, slot, ty);
        view_bonds(&mut c, slot, xt, write, false);
        release_temporary(&mut c, input);
        return val(slot, ty);
    }
    if id == 32 {
        return parallel_map_builtin(&mut c, a);
    }
    if id == 43 {
        return parallel_for_chunks_builtin(&mut c, a);
    }
    if id == 44 {
        return parallel_spawn_builtin(&mut c, a);
    }
    if id == 45 {
        return parallel_join_builtin(&mut c, a);
    }
    if id == 33 {
        return task_scope_builtin(&mut c, a);
    }
    if id == 34 {
        return spawn_builtin(&mut c, a);
    }
    if id == 35 {
        return join_builtin(&mut c, a);
    }
    if id == 55 {
        return try_join_builtin(&mut c, a);
    }
    if id == 56 {
        return task_fail_builtin(&mut c, a);
    }
    if id == 57 {
        return ignore_failure_builtin(&mut c, a);
    }
    if id == 31 {
        expect(&mut c, view(")"));
        ty := mutex_type(&mut c, a.ty);
        value := a.t;
        if c.raw == 0 {
            move_out(&mut c, a);
        }
        slot := invoke(&mut c, view("rt_mutex_new"), one(value));
        return own(&mut c, slot, ty);
    }
    if id == 30 {
        expect(&mut c, view(")"));
        if c.raw == 0 {
            require_type(&mut c, a.ty, 0);
        }
        ty := intern(&mut c, 11, 0);
        slot := invoke(&mut c, view("rt_atomic_new"), one(a.t));
        return own(&mut c, slot, ty);
    }
    if (18 < id) & (id < 23) {
        left := deref(&mut c, a);
        if c.raw == 0 {
            require_type(&mut c, left.ty, 0);
        }
        observe(&mut c, left.t);
        get(&mut c, left.t, view("%rax"));
        snapshot := save(&mut c);
        expect(&mut c, view(","));
        b := expr(&mut c, 0);
        right := deref(&mut c, b);
        expect(&mut c, view(")"));
        if c.raw == 0 {
            require_type(&mut c, right.ty, 0);
        }
        observe(&mut c, right.t);
        mut k = 43;
        if id == 20 {
            k = 45;
        }
        if id == 21 {
            k = 42;
        }
        if id == 22 {
            return val(invoke(&mut c, view("rt_wrapping_pow"), two(snapshot, right.t)), 0);
        }
        get(&mut c, right.t, view("%rcx"));
        get(&mut c, snapshot, view("%rax"));
        if k == 43 {
            o(&mut c, view("addq %rcx,%rax\n"));
        }
        if k == 45 {
            o(&mut c, view("subq %rcx,%rax\n"));
        }
        if k == 42 {
            o(&mut c, view("imulq %rcx,%rax\n"));
        }
        return val(save(&mut c), 0);
    }
    if id == 16 {
        observe(&mut c, a.t);
        if c.raw == 0 {
            if ty_kind(&mut c, a.ty) != 7 {
                fail(&mut c, view("exchange requires typed reference"));
            }
        }
        expect(&mut c, view(","));
        start := c.pos;
        mut b = expr(&mut c, 0);
        end := c.pos;
        expect(&mut c, view(")"));
        if c.raw == 0 {
            expected := ty_arg(&mut c, a.ty);
            b = adopt_value(&mut c, b, start, end, expected);
        }
        return exchange_into(&mut c, a, b);
    }
    if id == 15 {
        expect(&mut c, view(")"));
        return deref_value(&mut c, a);
    }
    fail(&mut c, view("unknown builtin"));
    return val(0, 0);
}
// `*r` (and the `load` builtin): copies the referent of a typed reference. Only values that need no
// drop can be copied; a shared view referent is reborrowed.
fn deref_value<a>(c: (&a mut C), a: Val) -> Val {
    observe(&mut c, a.t);
    if c.raw == 0 {
        if ty_kind(&mut c, a.ty) != 7 {
            fail(&mut c, view("* requires a typed reference"));
        }
    }
    ty := ty_arg(&mut c, a.ty);
    n := ref_load(&mut c, a.t, ty);
    if c.raw == 0 {
        k := ty_kind(&mut c, ty);
        // A shared reference behind a shared reference is copied out like a shared view (Rust's
        // `&T: Copy`): the copy holds a shared reborrow of what the inner reference borrows. An
        // exclusive one would be a second `&mut`.
        if (k == 7) && ((ty_mode(&mut c, ty) != 0) || (ty_mode(&mut c, a.ty) != 0)) {
            fail(&mut c, view("indirect reference copies require explicit reborrow"));
        }
        if (k == 5) || (k == 27) || (k == 7) {
            if ty_mode(&mut c, ty) != 0 {
                fail(&mut c, view("cannot copy an exclusive view out of a reference; reborrow explicitly"));
            }
            mut slot = 0;
            if k == 7 {
                get(&mut c, n, view("%rax"));
                slot = save(&mut c);
                own(&mut c, slot, ty);
            } else {
                slot = invoke(&mut c, view("rt_view"), one(n));
                own(&mut c, slot, ty);
            }
            target := target_of(&mut c, a.t);
            c
                .resources
                .push(
                    Resource {
                        slot: n,
                        ty: ty,
                        flag: 0,
                        base: a.t + 1,
                        field: 0,
                        via: 1,
                        place: target,
                        target: 0,
                        authority: a.t + 1,
                    }
                );
            frame := place_of(&mut c, a.t);
            count := c.bonds.len();
            for i in count {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if holder == frame && guard != 0 {
                    bond_kind(&mut c, target, loan, guard);
                }
            }
            stored_source(&mut c, n, ty);
            view_bonds(&mut c, slot, n, 0, k == 7);
            if k == 7 {
                // The copy points where the inner reference points.
                inner_target := target_of(&mut c, n);
                if inner_target != 0 {
                    set_target(&mut c, slot, inner_target, 0);
                }
            }
            release_temporary(&mut c, a.t);
            return val(slot, ty);
        }
        if needs_drop(&mut c, ty) {
            fail(&mut c, view("cannot copy an owned value out of a reference; use exchange"));
        }
    }
    release_temporary(&mut c, a.t);
    return val(n, ty);
}
// The parallel surface's one capability question (docs/design/parallelism.md). `subject` names what
// is being moved or shared (`parallel_map item`, `job input`), so a rejection names the field that
// failed rather than repeating the whole type.
fn require_capability_named<a, b>(c: (&a mut C), ty: u64, shared: u64, subject: &b [u8]) -> unit {
    capability_begin(&mut c);
    mut trail = u64[];
    if transfer_capability(&mut c, ty, shared, &mut trail, 0) == 0 {
        capability_fail(&mut c, shared, subject, view(""));
    }
    return ();
}
// Classifies a closure's environment, not just its signature: every capture is a value a worker can
// reach, so `shared` is asked of each capture's type - 1 for an environment that concurrent workers
// share, 0 for one that moves to a single worker. This is the check a signature-only test misses:
// `|i: u64| -> u64 touch(&h, i)` has a plain-data signature and a thread-affine capture.
fn require_closure_captures<a, b>(c: (&a mut C), ty: u64, shared: u64, subject: &b [u8]) -> unit {
    env := ty_env(&mut c, ty);
    if env == 0 {
        return ();
    }
    d := ty_arg(&mut c, env);
    count := c.decls[d].count;
    first := c.decls[d].first;
    for i in count {
        name := c.fields[first + i].name.copy();
        field := field_type(&mut c, env, i);
        capability_begin(&mut c);
        mut trail = u64[];
        if transfer_capability(&mut c, field, shared, &mut trail, 0) == 0 {
            capability_fail(&mut c, shared, subject, view(name));
        }
    }
    return ();
}
// The whole check a scoped parallel primitive owes a callback, in one call so a surface cannot do
// half of it: an `FnMut` environment would be raced on by concurrent workers, and every capture is
// classified (`shared` as for `require_closure_captures`). A capture-free function value needs
// nothing. This is the predicate a job pool calls for the closure it accepts.
fn require_parallel_closure<a, b>(c: (&a mut C), ty: u64, shared: u64, subject: &b [u8]) -> unit {
    if ty_kind(&mut c, ty) != 20 {
        return ();
    }
    if (shared != 0) & (ty_mode(&mut c, ty) != 0) {
        fail(
            &mut c,
            view("a callback shared by concurrent workers must not write a captured value: an FnMut closure would race on its own environment; use a Mutex or return an owned result")
        );
    }
    require_closure_captures(&mut c, ty, shared, subject);
    return ();
}
// parallel_map(items, context, f): structured fork-join. Items move to workers, the context is
// shared read-only, and every worker is joined before the call returns, so no task outlives a loan.
fn parallel_map_builtin<a>(c: (&a mut C), items: Val) -> Val {
    expect(&mut c, view(","));
    context := expr(&mut c, 0);
    expect(&mut c, view(","));
    callee := expr(&mut c, 0);
    expect(&mut c, view(")"));
    vt := items.ty;
    if ty_kind(&mut c, vt) != 6 {
        fail(&mut c, view("parallel_map requires a vector of items"));
    }
    item := ty_arg(&mut c, vt);
    input := callee.t;
    inty := callee.ty;
    function := deref(&mut c, callee);
    fty := function.ty;
    closure := ty_kind(&mut c, fty) == 20;
    // Closures are shared read-only by every worker (captures are owned and never borrowed), and
    // parallel_map returns only after all workers finish, so the closure outlives them.
    if ty_kind(&mut c, fty) != 12 && !closure {
        fail(&mut c, view("parallel_map requires a callable"));
    }
    signature := type_args(&mut c, fty);
    result := ty_arg(&mut c, fty);
    if signature.len() != 2 {
        fail(&mut c, view("parallel_map callback takes (item, context)"));
    }
    // The environment, not the signature: a capture is what a worker can actually reach.
    require_parallel_closure(&mut c, fty, 1, view("closure capture"));
    first := signature[0];
    second := signature[1];
    require_type(&mut c, item, first);
    require_type(&mut c, context.ty, second);
    ck := ty_kind(&mut c, context.ty);
    if needs_drop(&mut c, context.ty) & (ck != 5) {
        fail(
            &mut c,
            view("parallel_map context must be a shared reference, view or plain value")
        );
    }
    require_capability_named(&mut c, item, 0, view("parallel_map item"));
    require_capability_named(&mut c, result, 0, view("parallel_map result"));
    require_capability_named(&mut c, context.ty, 1, view("parallel_map context"));
    if contains_borrow(&mut c, result, 0) {
        fail(&mut c, view("parallel_map result cannot contain borrows"));
    }
    if contains_task(&mut c, result, 0) || contains_task(&mut c, item, 0) {
        fail(&mut c, view("parallel_map cannot move Task or job handles between threads"));
    }
    if contains_borrow(&mut c, item, 0) {
        if ty_kind(&mut c, item) != 7 {
            fail(&mut c, view("parallel_map borrowed items must be references"));
        }
        inner := ty_arg(&mut c, item);
        if ty_mode(&mut c, item) != 0 && contains_borrow(&mut c, inner, 0) {
            fail(&mut c, view("parallel_map exclusive items cannot hold borrows"));
        }
    }
    observe(&mut c, function.t);
    mut env = imm(&mut c, 0);
    if closure {
        if ty_kind(&mut c, inty) == 7 {
            get(&mut c, input, view("%rax"));
        } else {
            o(&mut c, view("leaq "));
            stack_slot(&mut c, function.t);
            o(&mut c, view(",%rax\n"));
        }
        env = save(&mut c);
    }
    get(&mut c, function.t, view("%rax"));
    if closure {
        o(&mut c, view("movq (%rax),%rax\n"));
    }
    target := save(&mut c);
    observe(&mut c, context.t);
    if ck == 7 {
        place := target_of(&mut c, context.t);
        capture_authority(&mut c, place);
    }
    list := items.t;
    if c.raw == 0 {
        move_out(&mut c, items);
    }
    mut pargs = three(list, context.t, target);
    pargs.push(env);
    slot := invoke(&mut c, view("rt_parallel_map"), pargs);
    ty := intern(&mut c, 6, result);
    observe(&mut c, context.t);
    release_temporary(&mut c, input);
    close_loans(&mut c);
    return own(&mut c, slot, ty);
}
// parallel_for_chunks(&mut [T], chunks, f): the exclusive-slice shape of the pool, and the one
// Abundance's geometry work wants. The caller's slice is split by the runtime into `chunks`
// contiguous, disjoint regions and each job receives `&mut [T]` over its own; the descriptors address
// the caller's elements, so no element is copied. Distinct from the owned-chunk split in lib/pool.grl,
// which moves every element twice, and that difference is the point of this builtin.
//
// The split is constructed, not checked: with size = ceil(n / chunks), job k covers
// [k * size, min(n, k * size + size)). A function of n alone cannot produce two regions that overlap,
// and the runtime asserts their lengths sum to n, so "each element in exactly one chunk" is an
// arithmetic identity rather than a property a checker has to trust.
//
// Reads are why the element is classified as transferable rather than shareable: a worker owns its
// region exclusively, but it can store through it (which drops the old element on that worker) and
// read methods callable through it, so the element must be a type that may be used, and destroyed,
// on another thread. Default-deny means a `handle` element is refused by name, exactly as `&[File]`
// is refused as a shared parallel_map item.
fn parallel_for_chunks_builtin<a>(c: (&a mut C), data: Val) -> Val {
    expect(&mut c, view(","));
    chunks := expr(&mut c, 0);
    expect(&mut c, view(","));
    callee := expr(&mut c, 0);
    expect(&mut c, view(")"));
    input := callee.t;
    slice := data.ty;
    k := ty_kind(&mut c, slice);
    if c.raw == 0 {
        if (k != 27) & (k != 5) {
            fail(&mut c, view("parallel_for_chunks requires an exclusive slice: write &mut data[a: b]"));
        }
        if ty_mode(&mut c, slice) == 0 {
            fail(
                &mut c,
                view("parallel_for_chunks writes through its chunks, so the slice must be exclusive (&mut [T]); a shared &[T] cannot be handed out as &mut [T]")
            );
        }
    }
    mut width = imm(&mut c, 8);
    if k == 27 {
        elem := ty_arg(&mut c, slice);
        require_capability_named(&mut c, elem, 0, view("parallel_for_chunks element"));
        if contains_task(&mut c, elem, 0) {
            fail(&mut c, view("parallel_for_chunks cannot hand Task or job handles to workers"));
        }
        if narrow_code(&mut c, elem) != 0 {
            width = imm(&mut c, 4);
        }
    } else {
        // A byte view's elements are bytes: plain data, one byte apart.
        width = imm(&mut c, 1);
    }
    require_type(&mut c, chunks.ty, 0);
    function := deref(&mut c, callee);
    fty := function.ty;
    closure := ty_kind(&mut c, fty) == 20;
    if (ty_kind(&mut c, fty) != 12) & !closure {
        fail(&mut c, view("parallel_for_chunks requires a callable"));
    }
    signature := type_args(&mut c, fty);
    if signature.len() != 1 {
        fail(&mut c, view("parallel_for_chunks callback takes (&mut [T])"));
    }
    require_type(&mut c, slice, signature[0]);
    result := ty_arg(&mut c, fty);
    if ty_kind(&mut c, result) != 2 {
        fail(&mut c, view("parallel_for_chunks callback returns unit: write the elements"));
    }
    // Every worker calls the same closure object, so its captures are shared, not moved.
    require_parallel_closure(&mut c, fty, 1, view("closure capture"));
    observe(&mut c, function.t);
    // A closure is called as `code(&slot, args...)`: the environment is the address of the word
    // holding the object, and the code pointer is the object's first word.
    mut env = imm(&mut c, 0);
    if closure {
        o(&mut c, view("leaq "));
        stack_slot(&mut c, function.t);
        o(&mut c, view(",%rax\n"));
        env = save(&mut c);
    }
    get(&mut c, function.t, view("%rax"));
    if closure {
        o(&mut c, view("movq (%rax),%rax\n"));
    }
    target := save(&mut c);
    observe(&mut c, data.t);
    mut pargs = three(data.t, chunks.t, target);
    pargs.push(env);
    pargs.push(width);
    slot := invoke(&mut c, view("rt_parallel_for_chunks"), pargs);
    release_temporary(&mut c, data.t);
    release_temporary(&mut c, input);
    close_loans(&mut c);
    return own(&mut c, slot, 1);
}
// parallel_spawn(f) -> Job<R>: spawn-then-wait as two statements. The runtime already submits and
// waits (`rt_pool_submit`/`rt_pool_wait`); this is the ownership bridge, and it is what makes the
// handle safe to keep:
//
//   - the closure object moves into the job. A closure object is a heap record, so the job takes it
//     by moving the pointer into a one-word box the job owns; nothing points into the caller's frame.
//   - a closure that captured a reference or view is refused. A `Job<R>`'s type says nothing about
//     that lifetime, so if the handle could be returned the borrow would escape the frame it points
//     into. Owned captures move with the object, so they are fine.
//   - R is transferable and owned: no borrows (the result comes back to whoever waits, which may be
//     another thread) and no Task or Job handle (a second wait would free one record twice).
//   - the handle is move-only (needs_drop) and its drop waits, so the job record is freed exactly
//     once, by the thread that takes the result - never by a worker.
//
// That is why it cannot dangle: nothing reachable from a handle is frame memory, and the handle
// owns both the environment and the result until one wait consumes it.
fn parallel_spawn_builtin<a>(c: (&a mut C), callee: Val) -> Val {
    expect(&mut c, view(")"));
    input := callee.t;
    inty := callee.ty;
    function := deref(&mut c, callee);
    fty := function.ty;
    closure := ty_kind(&mut c, fty) == 20;
    if (ty_kind(&mut c, fty) != 12) & !closure {
        fail(&mut c, view("parallel_spawn requires a callable"));
    }
    if closure & (ty_kind(&mut c, inty) == 7) {
        fail(
            &mut c,
            view("a pool job takes its closure by value: a borrowed closure is still dropped by its owner, so the job cannot own it")
        );
    }
    signature := type_args(&mut c, fty);
    if signature.len() != 0 {
        fail(&mut c, view("a pool job callback takes no arguments: move what it needs in as captures"));
    }
    result := ty_arg(&mut c, fty);
    // One worker runs it, so the environment is transferable, not shared.
    require_parallel_closure(&mut c, fty, 0, view("job capture"));
    if contains_borrow(&mut c, fty, 0) {
        fail(
            &mut c,
            view("a job handle may outlive this statement, so its callback cannot capture a borrow: move the value in instead")
        );
    }
    require_capability_named(&mut c, result, 0, view("job result"));
    if contains_borrow(&mut c, result, 0) {
        fail(&mut c, view("a job result cannot contain borrows: the job owns what it returns"));
    }
    if contains_task(&mut c, result, 0) {
        fail(&mut c, view("a pool job cannot return a Task or Job handle"));
    }
    observe(&mut c, function.t);
    mut box = imm(&mut c, 0);
    mut target = function.t;
    if closure {
        // The box is the slot the closure ABI reads: `code(box, ...)` loads the object from it.
        get(&mut c, function.t, view("%rax"));
        o(&mut c, view("movq (%rax),%rax\n"));
        target = save(&mut c);
        get(&mut c, function.t, view("%rax"));
        object := save(&mut c);
        if c.raw == 0 {
            // The job owns the closure object from here: no frame drop for it, and the job's release
            // calls the object's own drop (the environment record's) once.
            move_out(&mut c, function);
        }
        box = apply(&mut c, view("rt_job_box"), one(object));
    }
    mut pargs = two(target, box);
    slot := invoke(&mut c, view("rt_parallel_spawn"), pargs);
    ty := intern(&mut c, 29, result);
    release_temporary(&mut c, input);
    close_loans(&mut c);
    return own(&mut c, slot, ty);
}
// parallel_join(h) -> R: take the result and free the record. The handle moves in, so no wait can
// happen twice and nothing can reach the record afterwards.
fn parallel_join_builtin<a>(c: (&a mut C), handle: Val) -> Val {
    expect(&mut c, view(")"));
    if ty_kind(&mut c, handle.ty) != 29 {
        fail(&mut c, view("parallel_join requires an owned Job handle"));
    }
    result := ty_arg(&mut c, handle.ty);
    value := handle.t;
    if c.raw == 0 {
        move_out(&mut c, handle);
    }
    slot := invoke(&mut c, view("rt_pool_wait"), one(value));
    return own(&mut c, slot, result);
}
fn contains_task<a>(c: (&a mut C), ty: u64, depth: u64) -> bool {
    mut trail = u64[];
    return task_walk(&mut c, ty, &mut trail);
}
fn task_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> bool {
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if (k == 16) || (k == 29) {
        return true;
    }
    if k == 6 || k == 10 || k == 13 {
        return task_walk(&mut c, arg, &mut trail);
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return false;
            }
        }
        trail.push(ty);
        d := &c.decls[arg];
        count := d.count;
        for i in count {
            t := field_type(&mut c, ty, i);
            if task_walk(&mut c, t, &mut trail) {
                trail.pop();
                return true;
            }
        }
        trail.pop();
    }
    return false;
}
fn callee_signature<a>(c: (&a mut C), callee: Val) -> Val {
    function := deref(&mut c, callee);
    if ty_kind(&mut c, function.ty) != 12 {
        fail(&mut c, view("expected a callable"));
    }
    observe(&mut c, function.t);
    get(&mut c, function.t, view("%rax"));
    target := save(&mut c);
    return val(target, function.ty);
}
fn require_sendable_owned<a, b>(c: (&a mut C), ty: u64, subject: &b [u8]) -> unit {
    require_capability_named(&mut c, ty, 0, subject);
    if contains_borrow(&mut c, ty, 0) {
        fail(&mut c, view("a spawned value cannot borrow: the worker may outlive the loan"));
    }
    if contains_task(&mut c, ty, 0) {
        fail(&mut c, view("a Task or job handle cannot cross a spawn boundary"));
    }
    return ();
}
// task_scope(context, body): body(ref scope, context) may spawn tasks; every task is joined
// before task_scope returns (also unjoined/abandoned ones), so tasks never outlive the scope.
fn task_scope_builtin<a>(c: (&a mut C), context: Val) -> Val {
    expect(&mut c, view(","));
    callee := expr(&mut c, 0);
    expect(&mut c, view(")"));
    input := callee.t;
    ct := context.ty;
    ck := ty_kind(&mut c, ct);
    if needs_drop(&mut c, ct) || ((ck == 7) & (ty_mode(&mut c, ct) != 0)) {
        fail(&mut c, view("task_scope context must be a plain value or shared reference"));
    }
    require_capability_named(&mut c, ct, 1, view("task_scope context"));
    body := callee_signature(&mut c, callee);
    signature := type_args(&mut c, body.ty);
    result := ty_arg(&mut c, body.ty);
    if signature.len() != 2 {
        fail(&mut c, view("task_scope body takes (ref Scope<C>, C)"));
    }
    sref := signature[0];
    if (ty_kind(&mut c, sref) != 7) || (ty_mode(&mut c, sref) != 0) {
        fail(&mut c, view("task_scope body must take a shared Scope reference"));
    }
    sty := ty_arg(&mut c, sref);
    if ty_kind(&mut c, sty) != 14 {
        fail(&mut c, view("task_scope body must take &s Scope<C>"));
    }
    inner := ty_arg(&mut c, sty);
    require_type(&mut c, ct, inner);
    second := signature[1];
    require_type(&mut c, ct, second);
    if contains_borrow(&mut c, result, 0) || contains_task(&mut c, result, 0) {
        fail(&mut c, view("task_scope result cannot contain borrows or Task handles"));
    }
    observe(&mut c, context.t);
    if ck == 7 {
        place := target_of(&mut c, context.t);
        capture_authority(&mut c, place);
    }
    handle := invoke(&mut c, view("rt_scope_begin"), one(context.t));
    get(&mut c, handle, view("%rdi"));
    get(&mut c, context.t, view("%rsi"));
    get(&mut c, body.t, view("%rax"));
    call_slot_out(&mut c, view("call *%rax\n"));
    slot := save(&mut c);
    invoke(&mut c, view("rt_scope_end"), one(handle));
    observe(&mut c, context.t);
    release_temporary(&mut c, input);
    close_loans(&mut c);
    return own(&mut c, slot, result);
}
// spawn(scope, item, f): f(item, context) or f(item, context, CancelToken) on its own thread.
fn spawn_builtin<a>(c: (&a mut C), scope: Val) -> Val {
    expect(&mut c, view(","));
    item := expr(&mut c, 0);
    expect(&mut c, view(","));
    callee := expr(&mut c, 0);
    expect(&mut c, view(")"));
    input := callee.t;
    if ty_kind(&mut c, scope.ty) != 7 {
        fail(&mut c, view("spawn requires a Scope reference"));
    }
    sref := scope.t;
    sv := deref(&mut c, scope);
    if ty_kind(&mut c, sv.ty) != 14 {
        fail(&mut c, view("spawn requires a Scope reference"));
    }
    observe(&mut c, sv.t);
    context := ty_arg(&mut c, sv.ty);
    f := callee_signature(&mut c, callee);
    signature := type_args(&mut c, f.ty);
    result := ty_arg(&mut c, f.ty);
    count := signature.len();
    if (count != 2) & (count != 3) {
        fail(
            &mut c,
            view("spawned callback takes (item, context) or (item, context, CancelToken)")
        );
    }
    first := signature[0];
    second := signature[1];
    require_type(&mut c, item.ty, first);
    require_type(&mut c, context, second);
    if count == 3 {
        third := signature[2];
        if ty_kind(&mut c, third) != 17 {
            fail(&mut c, view("third spawned callback parameter must be CancelToken"));
        }
    }
    require_sendable_owned(&mut c, item.ty, view("spawned item"));
    require_sendable_owned(&mut c, result, view("spawned result"));
    value := item.t;
    if c.raw == 0 {
        move_out(&mut c, item);
    }
    arity := imm(&mut c, count);
    mut dropper = imm(&mut c, 0);
    if needs_drop(&mut c, result) {
        o(&mut c, view("leaq "));
        drop_name(&mut c, result);
        o(&mut c, view("(%rip),%rax\n"));
        dropper = save(&mut c);
    }
    mut args = u64[];
    args.push(sv.t);
    args.push(f.t);
    args.push(value);
    args.push(arity);
    args.push(dropper);
    slot := invoke(&mut c, view("rt_task_spawn"), args);
    ty := intern(&mut c, 16, result);
    release_temporary(&mut c, input);
    release_temporary(&mut c, sref);
    close_loans(&mut c);
    return own(&mut c, slot, ty);
}
fn join_builtin<a>(c: (&a mut C), handle: Val) -> Val {
    expect(&mut c, view(")"));
    if ty_kind(&mut c, handle.ty) != 16 {
        fail(&mut c, view("join requires an owned Task handle"));
    }
    result := ty_arg(&mut c, handle.ty);
    value := handle.t;
    if c.raw == 0 {
        move_out(&mut c, handle);
    }
    slot := invoke(&mut c, view("rt_task_join"), one(value));
    return own(&mut c, slot, result);
}
// `try_join(t) -> R |? TaskFailure`: the join that contains. It never aborts for a failed task; the
// failure (or the result) is the value it returns, and the compiler refuses to drop that value
// unless the program writes `ignore_failure(...)`. See docs/design/task-failure-containment.md.
fn try_join_builtin<a>(c: (&a mut C), handle: Val) -> Val {
    expect(&mut c, view(")"));
    if ty_kind(&mut c, handle.ty) != 16 {
        fail(&mut c, view("try_join requires an owned Task handle"));
    }
    result := ty_arg(&mut c, handle.ty);
    value := handle.t;
    if c.raw == 0 {
        move_out(&mut c, handle);
    }
    slot := invoke(&mut c, view("rt_task_outcome"), one(value));
    ty := task_outcome_type(&mut c, result);
    return own(&mut c, slot, ty);
}
// `task_fail(text)`: fail the running task explicitly. Contained like a failed check - a value at
// the join, or the end of the process when there is no containment point.
fn task_fail_builtin<a>(c: (&a mut C), text: Val) -> Val {
    expect(&mut c, view(")"));
    k := ty_kind(&mut c, text.ty);
    if (k != 3) & (k != 4) & (k != 5) & (k != 6) {
        fail(&mut c, view("task_fail takes text (string, view or u8[])"));
    }
    if c.raw == 0 {
        if ty_kind(&mut c, text.ty) == 7 {
            fail(&mut c, view("task_fail takes text by value, not a reference"));
        }
    }
    invoke(&mut c, view("rt_task_fail"), one(text.t));
    release_temporary(&mut c, text.t);
    return val(imm(&mut c, 0), 1);
}
// `ignore_failure(e)`: the explicit opt-out. The value is dropped by the ordinary rules - its
// failure record and text are released, nothing leaks - and the "must handle" diagnostic that
// `release_temporary`/`expire_locals` would otherwise report for a join outcome is suppressed.
fn ignore_failure_builtin<a>(c: (&a mut C), value: Val) -> Val {
    expect(&mut c, view(")"));
    old := exchange(&mut c.ignored_failure, 1);
    release_temporary(&mut c, value.t);
    exchange(&mut c.ignored_failure, old);
    return val(imm(&mut c, 0), 1);
}
// The join outcome of a task whose result is `result`: the structural result union the language
// already has for `T |? E`, with the synthesized `.outcome::Failure` as its failure member.
fn task_outcome_type<a>(c: (&a mut C), result: u64) -> u64 {
    mut args = u64[];
    args.push(result);
    args.push(task_failure_type(&mut c));
    return make_union(&mut c, args, 1, copy_bytes(view(".outcome")), view("Outcome"));
}
// `.outcome::Failure`: what a join produces when the task failed. A plain record - kind, message,
// site - so the value a join sees carries the words a report would have printed.
fn task_failure_type<a>(c: (&a mut C)) -> u64 {
    // The two texts are `string`: the runtime builds them with rt_lit, which is the descriptor shape
    // a text value has, and a program can print, compare and pass one on like any other.
    mut text = intern(&mut c, 3, 0);
    mut args = u64[];
    args.push(0);
    args.push(text);
    args.push(text);
    mut d = find_decl_internal(&mut c, view(".outcome"), view("Failure"));
    if d == 0 {
        first := c.fields.len();
        push_failure_field(&mut c, 0, view("kind"));
        push_failure_field(&mut c, 1, view("message"));
        push_failure_field(&mut c, 2, view("site"));
        mut bounds = u64[];
        mut constraints = u64[][];
        for i in 3 {
            bounds.push(0);
            constraints.push(u64[]);
        }
        item_public_1 := c.decl_public;
        c
            .decls
            .push(
                Decl {
                    public: item_public_1,
                    module: copy_bytes(view(".outcome")),
                    name: copy_bytes(view("Failure")),
                    is_enum: 0,
                    opaque: 0,
                    transfer: 0,
                    share: 0,
                    c_layout: 0,
                    first: first,
                    count: 3,
                    drop: 0,
                    regions: 0,
                    types: 3,
                    success: 0,
                    bounds: bounds,
                    constraints: constraints,
                }
            );
        d = c.decls.len();
    }
    return intern_args(&mut c, 8, d - 1, 0, u64[], args);
}
fn push_failure_field<a, b>(c: (&a mut C), index: u64, name: &b [u8]) -> unit {
    param := intern_args(&mut c, 9, index, 0, u64[], u64[]);
    c.fields.push(Field { name: copy_bytes(view(name)), ty: param, pred: no_pred() });
    return ();
}
// A join outcome may not be dropped where it is still owned: the program must look at it, or say
// `ignore_failure`. Called from the two places that discard a live temporary or local.
fn require_handled<a>(c: (&a mut C), ty: u64, place: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if c.ignored_failure != 0 {
        return ();
    }
    // Only a place that still holds its value is being discarded here: a moved or cleaned value has
    // already been dealt with (`move_out`, `?` and a consumed `match` all mark it).
    if ownership::status(&c.check, place) == 2 {
        return ();
    }
    if ty_kind(&mut c, ty) != 8 {
        return ();
    }
    d := ty_arg(&mut c, ty);
    if same(view(c.decls[d].module), view(".outcome")) == false {
        return ();
    }
    if same(view(c.decls[d].name), view("Failure")) {
        return ();
    }
    fail(
        &mut c,
        view(
            "the outcome of a joined task must be handled: the failure is a value (`?` it, `match` it), or write ignore_failure() to discard it"
        )
    );
    return ();
}
fn scope_method<a, b>(c: (&a mut C), value: u64, kind: u64, name: &b [u8]) -> Val {
    expect(&mut c, view(")"));
    observe(&mut c, value);
    if same(view(name), view("cancelled")) {
        slot := invoke(&mut c, view("rt_cancelled"), one(value));
        return val(slot, 0);
    }
    if kind == 14 {
        if same(view(name), view("cancel")) {
            invoke(&mut c, view("rt_cancel"), one(value));
            return val(imm(&mut c, 0), 1);
        }
        if same(view(name), view("token")) {
            slot := invoke(&mut c, view("rt_scope_token"), one(value));
            ty := intern(&mut c, 17, 0);
            return val(slot, ty);
        }
    }
    fail(&mut c, view("unknown Scope/CancelToken method (expected cancel, cancelled or token)"));
    return val(0, 0);
}
// ---- sized integers: kind 18 (arg = bits, mode = signed). ----
fn starts_with<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() < y.len() {
        return false;
    }
    for i in y.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
// ---- exact decimal -> binary64 conversion for float literals (base 2^32 bignums) ----
fn big_mul_add<a>(x: (&a mut u64[]), m: u64, add: u64) -> unit {
    mut carry = add;
    for i in x.len() {
        t := x[i] * m + carry;
        exchange(&mut x[i], t % 4294967296);
        carry = t / 4294967296;
    }
    while carry != 0 {
        x.push(carry % 4294967296);
        carry = carry / 4294967296;
    }
    return ();
}
fn big_shl<a>(x: (&a u64[]), n: u64) -> u64[] {
    words := n / 32;
    bits := n % 32;
    mut out = u64[];
    for i in words {
        out.push(0);
    }
    mut carry = 0;
    mut scale = 1;
    for i in bits {
        scale = scale * 2;
    }
    for i in x.len() {
        t := x[i] * scale + carry;
        out.push(t % 4294967296);
        carry = t / 4294967296;
    }
    if carry != 0 {
        out.push(carry);
    }
    return out;
}
fn big_trim<a>(x: (&a mut u64[])) -> unit {
    while x.len() != 0 {
        if x[x.len() - 1] != 0 {
            break;
        }
        x.pop();
    }
    return ();
}
fn big_bits<a>(x: (&a u64[])) -> u64 {
    if x.len() == 0 {
        return 0;
    }
    mut top = x[x.len() - 1];
    mut b = 0;
    while top != 0 {
        top = top / 2;
        b += 1;
    }
    return (x.len() - 1) * 32 + b;
}
// 0 less, 1 equal, 2 greater (both trimmed)
fn big_cmp<a, b>(x: (&a u64[]), y: (&b u64[])) -> u64 {
    if x.len() < y.len() {
        return 0;
    }
    if y.len() < x.len() {
        return 2;
    }
    mut i = x.len();
    while 0 < i {
        i -= 1;
        if x[i] < y[i] {
            return 0;
        }
        if y[i] < x[i] {
            return 2;
        }
    }
    return 1;
}
fn big_sub<a, b>(x: (&a mut u64[]), y: (&b u64[])) -> unit {
    mut borrow = 0;
    for i in x.len() {
        mut sub = borrow;
        if i < y.len() {
            sub += y[i];
        }
        v := x[i];
        if v < sub {
            exchange(&mut x[i], v + 4294967296 - sub);
            borrow = 1;
        } else {
            exchange(&mut x[i], v - sub);
            borrow = 0;
        }
    }
    big_trim(&mut x);
    return ();
}
fn big_shr1<a>(x: (&a mut u64[])) -> unit {
    mut carry = 0;
    mut i = x.len();
    while 0 < i {
        i -= 1;
        v := x[i];
        exchange(&mut x[i], v / 2 + carry * 2147483648);
        carry = v % 2;
    }
    big_trim(&mut x);
    return ();
}
// Correctly rounded decimal -> binary with p significand bits (53 binary64, 24 binary32); the
// result is always the binary64 word holding that value.
fn float_bits_p<a, b>(c: (&a mut C), text: &b [u8], p: u64) -> u64 {
    mut bias = 1023;
    if p == 24 {
        bias = 127;
    }
    half := 1 << (p - 1);
    full := 1 << p;
    lowest := p + bias - 2;
    mut mantissa = u64[];
    mut exponent = 0;
    mut negative_exponent = 0;
    mut fraction_digits = 0;
    mut seen_dot = 0;
    mut i = 0;
    while i < text.len() {
        d := text[i];
        if (d == 101) || (d == 69) {
            break;
        }
        if d == 46 {
            seen_dot = 1;
        } else {
            big_mul_add(&mut mantissa, 10, d - 48);
            if seen_dot != 0 {
                fraction_digits += 1;
            }
        }
        i += 1;
    }
    if i < text.len() {
        i += 1;
        if text[i] == 45 {
            negative_exponent = 1;
            i += 1;
        } else {
            if text[i] == 43 {
                i += 1;
            }
        }
        while i < text.len() {
            exponent = exponent * 10 + text[i] - 48;
            if 100000 < exponent {
                fail(&mut c, view("float literal exponent too large"));
            }
            i += 1;
        }
    }
    big_trim(&mut mantissa);
    if mantissa.len() == 0 {
        return 0;
    }
    // value = mantissa * 10^scale
    mut up = 0;
    mut down = fraction_digits;
    if negative_exponent != 0 {
        down += exponent;
    } else {
        if exponent < down {
            down = down - exponent;
        } else {
            up = exponent - down;
            down = 0;
        }
    }
    if 400 < up {
        float_range(&mut c, p);
    }
    mut top = mantissa;
    for j in up {
        big_mul_add(&mut top, 10, 0);
    }
    mut bottom = u64[1];
    if 800 < down {
        return 0;
    }
    for j in down {
        big_mul_add(&mut bottom, 10, 0);
    }
    // Choose k with 2^52 <= top*2^k/bottom < 2^53 (k may be negative), clamped for subnormals.
    tb := big_bits(&top);
    bb := big_bits(&bottom);
    mut k = p + bb;
    mut kneg = 0;
    if tb < k {
        k = k - tb;
    } else {
        k = tb - k;
        kneg = 1;
    }
    mut attempts = 0;
    while true {
        attempts += 1;
        if 4 < attempts {
            fail(&mut c, view("float literal conversion failed"));
        }
        // Subnormal range: the leading bit would sit below 2^-1022; fix the scale at 2^-1074.
        if (kneg == 0) & (lowest < k) {
            k = lowest;
        }
        mut a = copy_numbers(&top);
        mut b = copy_numbers(&bottom);
        if kneg != 0 {
            b = big_shl(&b, k);
        } else {
            a = big_shl(&a, k);
        }
        big_trim(&mut a);
        big_trim(&mut b);
        // quotient (at most 54 bits) by binary long division
        mut shifted = big_shl(&b, p);
        big_trim(&mut shifted);
        mut q = 0;
        for step in p + 1 {
            q = q * 2;
            if big_cmp(&a, &shifted) != 0 {
                big_sub(&mut a, &shifted);
                q += 1;
            }
            big_shr1(&mut shifted);
        }
        subnormal := (kneg == 0) & (k == lowest);
        if q < half && !subnormal {
            if kneg != 0 {
                if k == 0 {
                    kneg = 0;
                    k = 1;
                } else {
                    k -= 1;
                }
            } else {
                k += 1;
            }
            continue;
        }
        if full - 1 < q {
            if kneg != 0 {
                k += 1;
            } else {
                if k == 0 {
                    kneg = 1;
                    k = 1;
                } else {
                    k -= 1;
                }
            }
            continue;
        }
        // round half to even using the remainder
        twice := big_shl(&a, 1);
        mut tw = twice;
        big_trim(&mut tw);
        order := big_cmp(&tw, &b);
        if (order == 2) || ((order == 1) && ((q % 2) == 1)) {
            q += 1;
        }
        if q == full {
            q = half;
            if kneg != 0 {
                k += 1;
            } else {
                if k == 0 {
                    kneg = 1;
                    k = 1;
                } else {
                    k -= 1;
                }
            }
        }
        if subnormal & (q < half) {
            if p == 53 {
                return q;
            }
            return small_f32_bits(q);
        }
        // value = q * 2^-k ; biased exponent = 52 - k + 1023
        mut biased = 0;
        if kneg != 0 {
            biased = bias + p - 1 + k;
        } else {
            if bias + p - 1 < k {
                return q;
            }
            biased = bias + p - 1 - k;
        }
        if 2 * bias < biased {
            float_range(&mut c, p);
        }
        if p == 53 {
            return biased * 4503599627370496 + (q - half);
        }
        return (biased + 896) * 4503599627370496 + ((q - half) << 29);
    }
    return 0;
}
fn float_range<a>(c: (&a mut C), p: u64) -> unit {
    if p == 24 {
        fail(&mut c, view("float literal out of range for f32"));
    }
    fail(&mut c, view("float literal out of range for f64"));
    return ();
}
// q * 2^-149 (a binary32 subnormal, q < 2^23) as a binary64 word.
fn small_f32_bits(q: u64) -> u64 {
    if q == 0 {
        return 0;
    }
    mut top = 0;
    while (1 << (top + 1)) < q + 1 {
        top += 1;
    }
    return (top + 874) * 4503599627370496 + ((q << (52 - top)) - 4503599627370496);
}
fn bool_type<a>(c: (&a mut C)) -> u64 {
    return intern(&mut c, 19, 0);
}
fn float_type<a>(c: (&a mut C)) -> u64 {
    return intern(&mut c, 21, 0);
}
fn is_text<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    return (k == 3) || (k == 4) || (k == 5);
}
fn ref_to_text<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 7 {
