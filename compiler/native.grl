    }

    mut storage = ty;
    if through != 0 {
        storage = fieldty;
    }
    if !contains_borrow(&mut c, storage, 0) {
        expire_locals(&mut c);
    }
    source := place_of(&mut c, v.t);
    mut destination = place_of(&mut c, target);
    if through != 0 {
        destination = target_of(&mut c, target);
    }
    if c.raw == 0 {
        check_writeback(&mut c, destination, storage, source);
