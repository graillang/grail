    mut mapty = base.ty;
    while ty_kind(&mut c, mapty) == 7 {
        mapty = ty_arg(&mut c, mapty);
    }
    require_mutable_binding(&mut c, base.t, 0);
    formal := reference_type(&mut c, mapty, 0);
    reservation := method_receiver(&mut c, base.t, base.ty, mapty, formal);
    expect(&mut c, view("["));
    types := type_args(&mut c, mapty);
    keyty := types[0];
    valuety := types[1];
    oppos := index_assignment_operator(&mut c);
    operator := kind_at(&mut c, oppos);
    mut key = val(0, 0);
    mut keypin = val(0, 0);
    mut oldref = val(0, 0);
    mut oldvalue = 0;
    if operator == 61 {
        value := context_value(&mut c, keyty);
        key = move_value(&mut c, value);
    } else {
        value := map_key(&mut c, keyty);
        key = val(value.t, value.ty);
        keyformal := reference_type(&mut c, keyty, 0);
        keypin = method_receiver(&mut c, value.t, value.ty, keyty, keyformal);
        receiver := place_slot(&mut c, reservation.t, reservation.ty, 0);
        keyref := place_slot(&mut c, keypin.t, keypin.ty, 0);
        oldref = map_lookup(&mut c, mapty, receiver, keyref, 0);
