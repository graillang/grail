fn emit_exit<a, b>(c: (&a mut C), argument: &b [u8]) -> unit {
    if c.target == 4 {
        // The lowering expands `winexit` into an indirect IAT call with ARM64 home space.
        o(&mut c, argument);
        o(&mut c, view("winexit\n"));
        return ();
    }
    if c.target == 3 {
        // Win64 passes the exit code in ECX; the import slot is a real indirect IAT call.
        o(&mut c, argument);
        o(&mut c, view("movl %edi,%ecx\ncall *__imp_ExitProcess(%rip)\nud2\n"));
        return ();
    
    }
    if c.plat == 1 {
        o(&mut c, argument);
        o(&mut c, view("call _exit\n"));
        return ();
    }
    mut number = 231;
    if c.target != 0 {
        number = 94;
    }
    o(&mut c, view("movl $"));
    on(&mut c, number);
    o(&mut c, view(",%eax\n"));
    o(&mut c, argument);
    o(&mut c, view("syscall\n"));
    return ();
}
pub fn main() -> u64 {
    mut c = C {
