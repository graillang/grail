// The address operand of raw_load, raw_store and their narrow forms written as `p + k` or `p - k`
// with a literal k is address formation, not integer arithmetic: it has no overflow check in any
// build (docs/design/decisions, "raw address offsets"; the unsafe author's contract, like Rust's
// `ptr.add`), and the optimiser folds it into `k(%reg)` addressing. Only the whole operand counts:
// the operator's left side starts the argument and its right side, one literal token, ends it.
// Integer arithmetic elsewhere in an unsafe module follows the build's overflow mode.
fn raw_address_offset<a>(c: (&a mut C), lstart: u64, rstart: u64, rend: u64) -> unit {
    if (lstart + 1 != c.addr_arg) || (rend != rstart + 1) {
        return ();
    }
    lit := tok_text(&mut c, rstart);
    if (lit.len() == 0) || (lit[0] < 48) || (lit[0] > 57) {
        return ();
    }
    next := tok_text(&mut c, rend);
    if !(same(view(next), view(",")) || same(view(next), view(")"))) {
        return ();
    }
    exchange(&mut c.pv_arith_ok, 1);
}
fn raw_arguments<a>(c: (&a mut C), address: bool) -> u64[] {
    mut args = u64[];
    if eat(&mut c, view(")")) {
        return args;
    }
    while true {
        // The marker is this argument's own: a nested raw call parses its arguments with its own.
        mut mine = 0;
        if address && (args.len() == 0) {
            mine = c.pos + 1;
        }
        outer := exchange(&mut c.addr_arg, mine);
        mut v = expr(&mut c, 0);
        exchange(&mut c.addr_arg, outer);
        get(&mut c, v.t, view("%rax"));
        n := save(&mut c);
        args.push(n);
        if eat(&mut c, view(")")) {
            break;
        }
        expect(&mut c, view(","));
    }
    return args;
}
// ---- PE/COFF unwind data ------------------------------------------------------------------
// The COFF assembler needs absolute prologue values, but frame sizes are only known after code
// generation. The Windows target bypasses the ELF optimizer, so every emitted function has the
// fixed prologue `pushq %rbp / movq %rsp,%rbp / subq $.F<n>,%rsp`. Frame labels restart per
// function, so sizes are collected in emission order and consumed by the .def functions in the
// same order (one `.set .F<n>, <bytes>` line per function).
// Both PE targets carry that table: windows-aarch64's prologue loads the constant into `x10` and
// subtracts it (`framesub`), and `arm_unwind` writes the same number as `.seh_stackalloc`, so the
// `.set` value is the single source of an unwind record's frame size. The name is not a bare
// `.F<n>` but `.F<unit prefix>_<n>` (a `.set` is one symbol per file, and two units' counters both
// reach n), which is why a reader of the emitted text has to match the whole name.
struct WinUnwind {
    out: u8[],
    symbol: u8[],
    frames: u64[],
    frame_at: u64,
    state: u64
}
fn span_is<a, b>(s: &a [u8], a: u64, e: u64, t: &b [u8]) -> bool {
    if e - a != t.len() {
        return false;
    }
    for i in t.len() {
        if s[a + i] != t[i] {
            return false;
        }
    }
    return true;
}
fn span_has<a, b>(s: &a [u8], a: u64, e: u64, t: &b [u8]) -> bool {
    if e - a < t.len() {
        return false;
    }
    for i in t.len() {
        if s[a + i] != t[i] {
            return false;
        }
    }
    return true;
}
fn span_copy<a>(s: &a [u8], a: u64, e: u64) -> u8[] {
    mut out = u8[];
    for i in e - a {
        out.push(s[a + i]);
    }
    return out;
}
fn put_text(out: (&mut u8[]), t: &[u8]) -> unit {
    for i in t.len() {
        out.push(t[i]);
    }
    return ();
}
fn put_number(out: (&mut u8[]), n: u64) -> unit {
    if 9 < n {
        put_number(&mut out, n / 10);
    }
    out.push(48 + n % 10);
    return ();
}
fn push_line(out: (&mut u8[]), text: &[u8], a: u64, e: u64) -> unit {
    for i in e - a {
        out.push(text[a + i]);
    }
    out.push(10);
    return ();
}
fn win_number<a>(s: &a [u8], a: u64, e: u64) -> u64 {
    mut n = 0;
    mut i = a;
    while i < e {
        n = n * 10 + (s[i] - 48);
        i = i + 1;
    }
    return n;
}
fn win_frames<a>(text: &a [u8]) -> u64[] {
    mut frames = u64[];
    mut start = 0;
    mut i = 0;
    while i < text.len() {
        if text[i] == 10 {
            e := i;
            if span_has(view(text), start, e, view(".set .F")) {
                mut comma = start + 5;
                while (comma < e) & (text[comma] != 44) {
                    comma = comma + 1;
                }
                if comma < e {
                    mut digit = comma + 1;
                    if (digit < e) & (text[digit] == 32) {
                        digit = digit + 1;
                    }
                    frames.push(win_number(view(text), digit, e));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return frames;
}
fn win_unwind_line<a, b>(u: (&a mut WinUnwind), text: &b [u8], a: u64, e: u64) -> unit {
    if span_has(view(text), a, e, view(".def ")) {
        u.symbol = span_copy(view(text), a + 5, e);
        u.state = 1;
        push_line(&mut u.out, view(text), a, e);
        return ();
    }
    // Debug builds put a .L range label before the function label and CodeView directives
    // (.cv_func_id, .cv_loc) inside the prologue; neither changes the unwind description.
    if (u.state == 1) || (u.state == 2) {
        if span_has(view(text), a, e, view(".cv_")) {
            push_line(&mut u.out, view(text), a, e);
            return ();
        }
    }
    if u.state == 1 {
        if 2 < e - a {
            if (text[a] == 46) & (text[a + 1] == 76) & (text[e - 1] == 58) {
                push_line(&mut u.out, view(text), a, e);
                return ();
            }
        }
    }
    if u.state == 1 {
        if 0 < e - a {
            if text[e - 1] == 58 {
                push_line(&mut u.out, view(text), a, e);
                put_text(&mut u.out, view(".seh_proc "));
                for i in u.symbol.len() {
                    u.out.push(u.symbol[i]);
                }
                u.out.push(10);
                u.state = 2;
                return ();
            }
        }
    }
    if u.state == 2 {
        if span_is(view(text), a, e, view("pushq %rbp")) {
            push_line(&mut u.out, view(text), a, e);
            put_text(&mut u.out, view(".seh_pushreg %rbp\n"));
            return ();
        }
        if span_is(view(text), a, e, view("movq %rsp,%rbp")) {
            push_line(&mut u.out, view(text), a, e);
            put_text(&mut u.out, view(".seh_setframe %rbp, 0\n"));
            return ();
        }
        if span_has(view(text), a, e, view("subq $.F")) {
            mut frame = 0;
            if u.frame_at < u.frames.len() {
                frame = u.frames[u.frame_at];
            }
            u.frame_at = u.frame_at + 1;
            // `subq $.Fn+N,%rsp`: the optimiser folded the callee-saved area into the frame
            // adjustment (docs/design/call-abi.md S4), so the allocation is N bytes more.
            mut plus = a;
            while (plus < e) && (text[plus] != 43) {
                plus += 1;
            }
            if plus < e {
                mut extra = 0;
                mut d = plus + 1;
                while (d < e) && (47 < text[d]) && (text[d] < 58) {
                    extra = extra * 10 + u64(text[d]) - 48;
                    d += 1;
                }
                frame = frame + extra;
            }
            push_line(&mut u.out, view(text), a, e);
            put_text(&mut u.out, view(".seh_stackalloc "));
            put_number(&mut u.out, frame);
            put_text(&mut u.out, view("\n.seh_endprologue\n"));
            u.state = 3;
            return ();
        }
        // A non-standard prologue keeps no unwind description rather than an inaccurate one.
        u.state = 0;
    }
    if u.state == 3 {
        if span_has(view(text), a, e, view(".set ")) {
            put_text(&mut u.out, view(".seh_endproc\n"));
            u.state = 0;
        }
    }
    push_line(&mut u.out, view(text), a, e);
    return ();
}
// ---- Windows ARM64 unwind data -------------------------------------------------------------
// The ARM64 assembler encodes .seh_* directives into a packed record or a full .xdata structure,
// and validates that the directives cover exactly the prologue bytes. This pass therefore only
// describes the prologue the lowering produced; a function whose shape does not match is left
// without a record instead of getting a wrong one (leaf functions need no record at all).
fn arm_saved_reg<a>(text: &a [u8], a: u64, e: u64) -> u64 {
    if !span_has(view(text), a, e, view("str x")) {
        return 0;
    }
    if !span_has(view(text), a, e, view(",[sp,#-16]!")) {
        return 0;
    }
    mut i = a + 5;
    mut n = 0;
    mut scanning = 1;
    while scanning != 0 {
        if e <= i {
            scanning = 0;
        } else {
            if text[i] == 44 {
                scanning = 0;
            } else {
                if (48 <= text[i]) & (text[i] <= 57) {
                    n = n * 10 + (text[i] - 48);
                }
                i = i + 1;
            }
        }
    }
    if (18 < n) & (n < 29) {
        return n;
    }
    return 0;
}
fn arm_lines<a>(text: &a [u8]) -> u64[] {
    // Pairs of (start, end) offsets flattened into one array.
    mut lines = u64[];
    mut i = 0;
    mut start = 0;
    while i < text.len() {
        if text[i] == 10 {
            lines.push(start);
            lines.push(i);
            start = i + 1;
        }
        i = i + 1;
    }
    if start < text.len() {
        lines.push(start);
        lines.push(text.len());
    }
    return lines;
}
fn arm_unwind<a>(text: &a [u8]) -> u8[] {
    lines := arm_lines(view(text));
    n := lines.len() / 2;
    frames := win_frames(view(text));
    mut syms = u8[][];
    mut ends = u64[];
    mut frame_of = u64[];
    mut kinds = u64[];
    mut at = 0;
    mut li = 0;
    while li < n {
        a := lines[li * 2];
        e := lines[li * 2 + 1];
        if span_has(view(text), a, e, view(".def ")) {
            sym := span_copy(view(text), a + 5, e);
            mut body = li + 1;
            mut found = 0;
            while (found == 0) & (body < n) {
                ba := lines[body * 2];
                be := lines[body * 2 + 1];
                if 0 < be - ba {
                    if text[be - 1] == 58 {
                        found = 1;
                    }
                }
                if found == 0 {
                    body = body + 1;
                }
            }
            mut stop = li + 1;
            while stop < n {
                a2 := lines[stop * 2];
                e2 := lines[stop * 2 + 1];
                if span_has(view(text), a2, e2, view(".def ")) {
                    break;
                }
                if span_has(view(text), a2, e2, view(".bss")) {
                    break;
                }
                stop = stop + 1;
            }
            mut frame = 0;
            if at < frames.len() {
                frame = frames[at];
            }
            at = at + 1;
            mut stp = 0;
            mut fp = 0;
            mut sub = 0;
            mut j = body + 1;
            while j < stop {
                x := lines[j * 2];
                y := lines[j * 2 + 1];
                if span_is(view(text), x, y, view("stp x29,x30,[sp,#-16]!")) {
                    stp = 1;
                }
                if span_is(view(text), x, y, view("mov x29,x10")) {
                    fp = 1;
                }
                if span_is(view(text), x, y, view("sub sp,sp,x10")) {
                    sub = 1;
                }
                j = j + 1;
            }
            mut kind = 0;
            if (stp & fp & sub) != 0 {
                kind = 1;
            }
            syms.push(sym);
            ends.push(stop);
            frame_of.push(frame);
            kinds.push(kind);
            li = stop;
            continue;
        }
        li = li + 1;
    }
    // Frame values are positional, so a mismatch means the shape is not understood: keep the
    // assembly unchanged rather than describe the wrong function.
    if (syms.len() != frames.len()) || (syms.len() == 0) {
        return text.copy();
    }
    mut out = u8[];
    mut cur = 0;
    mut prologue = 0;
    li = 0;
    while li < n {
        if cur < syms.len() {
            if li == ends[cur] {
                arm_close(&mut out, kinds[cur]);
                cur = cur + 1;
                prologue = 0;
            }
        }
        a := lines[li * 2];
        e := lines[li * 2 + 1];
        if cur < syms.len() {
            mut skip = 0;
            if kinds[cur] != 1 {
                skip = 1;
            }
            if skip != 0 {
                push_line(&mut out, view(text), a, e);
                li = li + 1;
                continue;
            }
            mut done = 0;
            if prologue == 0 {
                mut is_label = 0;
                if 0 < e - a {
                    if text[e - 1] == 58 {
                        is_label = 1;
                    }
                }
                if is_label != 0 {
                    mut sym = syms[cur].copy();
                    if span_is(view(text), a, e - 1, view(sym)) {
                        push_line(&mut out, view(text), a, e);
                        put_text(&mut out, view(".seh_proc "));
                        for k in sym.len() {
                            out.push(sym[k]);
                        }
                        out.push(10);
                        prologue = 1;
                        done = 1;
                    }
                }
            } else {
                if span_is(view(text), a, e, view("stp x29,x30,[sp,#-16]!")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_save_regp x29, 0\n"));
                    done = 1;
                }
                if span_is(view(text), a, e, view("mov x10,sp")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_nop\n"));
                    done = 1;
                }
                if span_is(view(text), a, e, view("mov x29,x10")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_set_fp\n"));
                    done = 1;
                }
                if span_has(view(text), a, e, view("movz x10,#((.F")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_nop\n"));
                    done = 1;
                }
                if span_has(view(text), a, e, view("movk x10,#(((")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_nop\n"));
                    done = 1;
                }
                if span_is(view(text), a, e, view("sub sp,sp,x10")) {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_stackalloc "));
                    put_number(&mut out, frame_of[cur]);
                    put_text(&mut out, view("\n.seh_endprologue\n"));
                    prologue = 0;
                    done = 1;
                }
                saved := arm_saved_reg(view(text), a, e);
                if saved != 0 {
                    push_line(&mut out, view(text), a, e);
                    put_text(&mut out, view(".seh_save_reg x"));
                    put_number(&mut out, saved);
                    put_text(&mut out, view(", 0\n"));
                    done = 1;
                }
            }
            if done != 0 {
                li = li + 1;
                continue;
            }
        }
        push_line(&mut out, view(text), a, e);
        li = li + 1;
    }
    if cur < syms.len() {
        arm_close(&mut out, kinds[cur]);
    }
    return out;
}
// The assembler turns the prologue directives into a full .xdata record.
fn arm_close<a>(out: (&a mut u8[]), kind: u64) -> unit {
    if kind == 1 {
        put_text(&mut out, view(".seh_endproc\n"));
    }
    return ();
}
fn win_unwind<a>(text: &a [u8]) -> u8[] {
    mut u = WinUnwind { out: u8[], symbol: u8[], frames: win_frames(view(text)), frame_at: 0, state: 0 };
    mut start = 0;
    mut i = 0;
    while i < text.len() {
        if text[i] == 10 {
            win_unwind_line(&mut u, view(text), start, i);
            start = i + 1;
        }
        i = i + 1;
    }
    if start < text.len() {
        win_unwind_line(&mut u, view(text), start, text.len());
    }
    return u.out;
}

// PE/COFF objects carry no ELF symbol type; MSVC-style .def records the function class.
fn func_directive<a, b, d>(c: (&a mut C), m: &b [u8], name: &b [u8], symbol: &d [u8], export: u64) -> unit {
    // Mach-O defines a symbol by its label and carries neither .type nor .def records.
    if c.plat == 1 {
        return ();
    }
    // --split assembles one object per module, so a definition another part calls has to be visible
    // to the linker: every function becomes global. The code is unchanged, and the single-file
    // build keeps its local symbols.
    // A specialisation is emitted weak in every build shape (B1 stage 4): its binding is stated once,
    // here, so the assembler never sees a global symbol turn weak.
    if c.current_spec != 0 {
        o(&mut c, view(".weak "));
        export_name(&mut c, view(m), view(name), view(symbol), export);
        o(&mut c, view("\n"));
    } else if own_object(&c) {
        o(&mut c, view(".globl "));
        export_name(&mut c, view(m), view(name), view(symbol), export);
        o(&mut c, view("\n"));
    }
    if (c.target == 3) || (c.target == 4) {
        o(&mut c, view(".def "));
        export_name(&mut c, view(m), view(name), view(symbol), export);
        o(&mut c, view("\n.scl 2\n.type 32\n.endef\n"));
        return ();
    }
    c.plan_at.push(c.out.len());
    o(&mut c, view(".type "));
    export_name(&mut c, view(m), view(name), view(symbol), export);
    o(&mut c, view(",@function\n"));
    return ();
}
fn argreg(i: u64) -> string {
    if i == 0 {
        return "%rdi";
    }
    if i == 1 {
        return "%rsi";
    }
    if i == 2 {
        return "%rdx";
    }
    if i == 3 {
        return "%rcx";
    }
    if i == 4 {
        return "%r8";
    }
    return "%r9";
}
fn imm<a>(c: (&a mut C), n: u64) -> u64 {
    o(&mut c, view("movabsq $"));
    on(&mut c, n);
    o(&mut c, view(",%rax\n"));
    return save(&mut c);
}
// Grail's own calling convention passes six words in registers and the rest on the stack: word
// 6 + k at 8k(%rsp) when the call is made, in an outgoing area of a multiple of 16 bytes that the
// caller reserves here and releases after the call (`release_call_args`). The callee finds word
// 6 + k at 16 + 8k(%rbp) on every target (`stack_params`). The returned size is the area's.
// AArch64 and RV64 spell the area with the pseudo-instructions the C-ABI calls use (`cstack`,
// `cstarg`, `cunstack`), which machine.grl lowers.
fn load_call_args<a, b>(c: (&a mut C), args: (&b u64[]), shift: u64) -> u64 {
    total := args.len() + shift;
    if total <= 6 {
        for i in args.len() {
            r := argreg(i + shift);
            get(&mut c, args[i], view(r));
        }
        exchange(&mut c.pending_words, total + 1);
        exchange(&mut c.pending_at, c.out.len());
        return 0;
    }
    exchange(&mut c.pending_words, 0);
    extra := total - 6;
    area := 16 * ((extra + 1) / 2);
    x86 := (c.target == 0) || (c.target == 3);
    if x86 {
        o(&mut c, view("subq $"));
        on(&mut c, area);
        o(&mut c, view(",%rsp\n"));
    } else {
        o(&mut c, view("cstack "));
        on(&mut c, area);
        c.out.push(10);
    }
    for k in extra {
        get(&mut c, args[6 - shift + k], view("%rax"));
        if x86 {
            ffi_store_stack(&mut c, 1, k * 8);
        } else {
            ffi_store_stack(&mut c, 0, k * 8);
        }
    }
    for i in 6 - shift {
        r := argreg(i + shift);
        get(&mut c, args[i], view(r));
    }
    return area;
}
// After the call: the outgoing area `load_call_args` reserved, if any, is released.
fn release_call_args<a>(c: (&a mut C), area: u64) -> unit {
    if area == 0 {
        return ();
    }
    if (c.target == 0) || (c.target == 3) {
        o(&mut c, view("addq $"));
        on(&mut c, area);
        o(&mut c, view(",%rsp\n"));
    } else {
        o(&mut c, view("cunstack "));
        on(&mut c, area);
        c.out.push(10);
    }
    return ();
}
// The LLVM backend's FFI fact for a C function this body calls (call ABI S8a): its integer argument
// words, its float arguments in order (bit k of the mask set when the k-th is an f32) and its result
// (0 an integer word or none, 1 f64, 2 f32). Only for x86-64 SysV calls whose every argument is in
// a register and whose result is a scalar: the lifter then emits the call with those C types, so
// the floats travel in the vector registers the platform ABI puts them in.
fn ffi_signature_fact<a, b, d>(c: (&a mut C), argtypes: (&b u64[]), ret: u64, symbol: &d [u8], abi: u64) -> unit {
    if (c.backend == 0) || (c.validating != 0) || (c.target != 0) || (abi != 0) {
        return ();
    }
    mut ints = 0;
    mut floats = 0;
    mut mask = 0;
    for i in argtypes.len() {
        ty := argtypes[i];
        if is_float(&mut c, ty) {
            if is_f32(&mut c, ty) {
                mask = mask | (1 << floats);
            }
            floats += 1;
        } else {
            if ffi_words(&mut c, ty) != 1 {
                return ();
            }
            ints += 1;
        }
    }
    if (6 < ints) || (8 < floats) {
        return ();
    }
    mut result = 0;
    if (ret != 1) && is_float(&mut c, ret) {
        result = 1;
        if is_f32(&mut c, ret) {
            result = 2;
        }
    }
    llvm::fact_ffi(&mut c.facts, copy_bytes(view(symbol)), ints, floats, mask, result);
    return ();
}
// The signature fact for the body being emitted: its argument words, six in
// registers and the rest on the stack (with the hidden result address when it has one). The lifter
// defines the body and its calls with exactly these words (llvm.grl `signatures`).
fn signature_fact<a>(c: (&a mut C), declared: u64) -> unit {
    // The native optimiser reads it too: a direct call to this body reads only its argument
    // registers (ir.grl `exact_calls`).
    if !wants_facts(&c) {
        return ();
    }
    mut words = arg_words(&c, declared);
    if (c.forge_sig.len() != 0) && same(view(c.forge_sig), view(c.facts_fn)) {
        words = c.forge_words;
    }
    llvm::fact_signature(&mut c.facts, copy_bytes(view(c.facts_fn)), words);
    return ();
}
// The argument words a function takes: its declared parameters and, for a plain record result of
// more than two words, the address the caller wants it written to (result_dest) after them.
fn arg_words<a>(c: (&a C), declared: u64) -> u64 {
    if c.result_dest != 0 {
        return declared + 1;
    }
    return declared;
}
// Prologue: the register arguments (the first six words) into their frame slots (arg_slot).
fn store_params<a>(c: (&a mut C), declared: u64) -> unit {
    count := arg_words(&c, declared);
    mut regs = count;
    if 6 < count {
        regs = 6;
    }
    for i in regs {
        reg := argreg(i);
        o(&mut c, view("movq "));
        o(&mut c, view(reg));
        c.out.push(44);
        stack_slot(&mut c, arg_slot(&c, declared, i));
        c.out.push(10);
    }
    return ();
}
// After the frame is cleared: parameter 6 + k from the caller's outgoing area, 16 + 8k(%rbp), into
// frame slot 6 + k (see load_call_args). The cleared range excludes the parameter slots, so the
// order is free, and keeping these loads past the clearing leaves the prologue the shape the
// lifter reads.
fn stack_params<a>(c: (&a mut C), declared: u64) -> unit {
    count := arg_words(&c, declared);
    if count <= 6 {
        return ();
    }
    for k in count - 6 {
        o(&mut c, view("movq "));
        on(&mut c, 16 + k * 8);
        o(&mut c, view("(%rbp),%rax\nmovq %rax,"));
        stack_slot(&mut c, arg_slot(&c, declared, 6 + k));
        c.out.push(10);
    }
    return ();
}
// The frame slot argument `i` lands in: declared parameter i is slot i, the hidden result address
// after them is result_dest's slot.
fn arg_slot<a>(c: (&a C), declared: u64, i: u64) -> u64 {
    if i == declared {
        return c.result_dest - 1;
    }
    return i;
}
// The hidden result address of a function whose result is a plain record of more than two words
// (docs/design/unboxed-values.md, 3c): a frame slot of its own, from the prologue on.
// It is the slot right after the parameters, so the frame zeroing that starts after them starts
// after it (kept_slots).
fn begin_result_dest<a>(c: (&a mut C), ret: u64, count: u64) -> unit {
    exchange(&mut c.result_dest, 0);
    if needs_dest(&mut c, ret) {
        d := fresh(&mut c);
        if d != count {
            fail(&mut c, view("internal: the result address is not the slot after the parameters"));
        }
        exchange(&mut c.result_dest, d + 1);
    }
    return ();
}
// The slots the prologue fills and the frame zeroing leaves alone.
fn kept_slots<a>(c: (&a C), count: u64) -> u64 {
    if c.result_dest != 0 {
        return count + 1;
    }
    return count;
}
// The caller's side of needs_dest: frame words of the call site the callee writes its result to,
// passed after the declared arguments; 0 when the result needs none.
fn call_dest<a>(c: (&a mut C), ret: u64) -> u64 {
    // Layout is the type's, never the module's: an unsafe module calling a function that needs a
    // destination passes one like anyone else.
    if !needs_dest(&mut c, ret) {
        return 0;
    }
    return frame_alloc(&mut c, record_words(&mut c, base_type(&mut c, ret)));
}
fn needs_dest<a>(c: (&a mut C), ret: u64) -> bool {
    if !framed(&mut c, ret) {
        return false;
    }
    return 2 < record_words(&mut c, base_type(&mut c, ret));
}
// An integer conversion of the value in slot `v`, from the type `from` codes to the type `to`
// codes (int_code: bits, 256 signed, 512 wrapping). The native backend emits it in line: nothing at
// all when every value of the source fits the target, a truncation when the conversion wraps, and
// otherwise a range test whose failing side calls `rt_int_cast` - which finds the value out of range
// and reports it exactly as it always did. Only the unsafe runtime, which defines it, keeps the call.
fn int_cast<a>(c: (&a mut C), v: u64, from: u64, to: u64) -> u64 {
    fb := from & 255;
    fs := (from / 256) & 1;
    tb := to & 255;
    ts := (to / 256) & 1;
    wrap := (to / 512) & 1;
    // Every source value fits: unsigned into a wider-or-equal unsigned or a strictly wider signed,
    // signed into a wider-or-equal signed. A value is held in 64 bits, zero- or sign-extended, so
    // the bits do not change.
    mut covered = false;
    if ts == 0 {
        covered = (fs == 0) && (fb <= tb);
    } else {
        covered = ((fs == 0) && (fb < tb)) || ((fs == 1) && (fb <= tb));
    }
    // A widening is no code on every target and backend: the word already holds the value, zero- or
    // sign-extended, which is what every later use of it reads.
    if covered || ((tb == 64) && (fb == 64) && (wrap != 0)) {
        return v;
    }
    // The rest is in line on every target and backend - the word stream's compare and branch is what
    // the other targets' selection and the LLVM lifter turn into theirs - and only the unsafe runtime,
    // which defines `rt_int_cast`, keeps the call.
    if c.raw != 0 {
        fv := imm(&mut c, from);
        tv := imm(&mut c, to);
        return invoke(&mut c, view("rt_int_cast"), three(v, fv, tv));
    }
    get(&mut c, v, view("%rax"));
    if wrap != 0 {
        // rt_int_truncate: the low bits, zero- or sign-extended.
        if tb < 64 {
            k := 64 - tb;
            o(&mut c, view("shlq $"));
            on(&mut c, k);
            if ts == 0 {
                o(&mut c, view(",%rax\nshrq $"));
            } else {
                o(&mut c, view(",%rax\nsarq $"));
            }
            on(&mut c, k);
            o(&mut c, view(",%rax\n"));
        }
        return save(&mut c);
    }
    ok := label(&mut c);
    if (fs == 1) && (ts == 1) {
        // Signed into narrower signed: the value fits when its low bits, sign-extended, are it.
        k := 64 - tb;
        o(&mut c, view("movq %rax,%rcx\nshlq $"));
        on(&mut c, k);
        o(&mut c, view(",%rcx\nsarq $"));
        on(&mut c, k);
        o(&mut c, view(",%rcx\ncmpq %rax,%rcx\n"));
        jump(&mut c, view("je"), ok);
    } else {
        // Otherwise an unsigned comparison with the target's largest value plus one: a negative
        // signed source is a huge unsigned number, so it fails it too.
        // (An unsigned 64-bit target reaches here only from a signed source.)
        mut limit = 9223372036854775808;
        if (ts == 0) && (tb < 64) {
            limit = 1 << tb;
        } else if ts == 1 {
            limit = 1 << (tb - 1);
        }
        o(&mut c, view("movabsq $"));
        on(&mut c, limit);
        o(&mut c, view(",%rcx\ncmpq %rcx,%rax\n"));
        jump(&mut c, view("jb"), ok);
    }
    o(&mut c, view("movq %rax,%rdi\nmovq $"));
    on(&mut c, from);
    o(&mut c, view(",%rsi\nmovq $"));
    on(&mut c, to);
    o(&mut c, view(",%rdx\n"));
    call_out(&mut c, view("rt_int_cast"));
    mark(&mut c, ok);
    return save(&mut c);
}
fn invoke<a, b>(c: (&a mut C), name: &b [u8], args: u64[]) -> u64 {
    if 6 < args.len() {
        // Runtime helpers take at most six words; more would need the spill record.
        fail(&mut c, view("runtime call exceeds six arguments"));
    }
    for i in args.len() {
        mut r = argreg(i);
        get(&mut c, args[i], view(r));
    }
    call_out(&mut c, view(name));
    if same(view(name), view("rt_f64_op")) {
        n := c.f64_ops;
        exchange(&mut c.call_ord, n);
        exchange(&mut c.f64_ops, n + 1);
    }
    // The ordinal of this call among the calls to the same callee in this function; the lifter
    // counts the same calls in the same order, so the two agree without either seeing the other.
    mut hit = 0;
    for i in c.f1_names.len() {
        if same(view(c.f1_names[i]), view(name)) {
            n := c.f1_counts[i];
            exchange(&mut c.f1_ord, n);
            exchange(&mut c.f1_counts[i], n + 1);
            hit = 1;
        }
    }
    if hit == 0 {
        exchange(&mut c.f1_ord, 0);
        c.f1_names.push(copy_bytes(view(name)));
        c.f1_counts.push(1);
    }
    return save(&mut c);
}

// Owned values have independent stack flags. Aliased field loads are not owners until moved.
fn needs_drop<a>(c: (&a mut C), ty: u64) -> bool {
    k := ty_kind(&mut c, ty);
    // An array owns what its elements own; its storage is never a box of its own.
    if (k == 32) & (c.raw == 0) {
        // A plain or extern record element is its bytes inline, owning nothing.
        elem := ty_arg(&mut c, ty);
        if array_record_elem(&mut c, elem) {
            return (is_c_record(&mut c, elem) == 0) && frame_drops(&mut c, elem);
        }
        return needs_drop(&mut c, elem);
    }
    // A record or enum always owns its fields' storage, and an `impl Drop` adds its call at the head
    // of that helper. The declaration's bit answers the question in one read: emit_drops asks it for
    // every type, and every drop site asks it for every value.
    // The declaration is indexed only for a record: `&` evaluates both sides, and another kind's
    // argument is not a declaration index.
    if k == 8 {
        if c.decls[ty_arg(&mut c, ty)].drop != 0 {
            return true;
        }
    }
    return (k == 3)
        || (k == 4)
        || (k == 5)
        || (k == 27)
        || (k == 6)
        || (k == 8)
        || (k == 9)
        || (k == 10)
        || (k == 11)
        || (k == 13)
        || (k == 16)
        || (k == 20)
        || (k == 29)
        || (k == 30)
        || (k == 33);
}
// The record of the value in `slot`: the latest one made for it. `res_last[slot]` remembers that
// record (index + 1) and is brought up to date here, so the dozen places that push a record did not
// change; the three that swap the whole list say so (resources_swapped).
fn resource<a>(c: (&a mut C), slot: u64) -> u64 {
    if c.resources.len() < c.res_synced {
        resources_swapped(&mut c);
    }
    while c.res_synced < c.resources.len() {
        at := c.resources[c.res_synced].slot;
        while c.res_last.len() <= at {
            c.res_last.push(0);
        }
        exchange(&mut c.res_synced, c.res_synced + 1);
        c.res_last[at] = c.res_synced;
    }
    // The list only grows between two swaps, so what is remembered is the whole truth: a slot with
    // no entry has no record, and that is the common answer (a plain value has none). The scan
    // below is reached only if an entry does not match, which would mean a record was replaced in
    // place.
    if c.res_last.len() <= slot {
        return 0;
    }
    known := c.res_last[slot];
    if known == 0 {
        return 0;
    }
    if c.resources[known - 1].slot == slot {
        return known;
    }
    mut i = c.resources.len();
    while i != 0 {
        i = i - 1;
        mut r = &c.resources[i];
        if r.slot == slot {
            return i + 1;
        }
    }
    return 0;
}
// A parameter whose storage belongs to the caller rather than to this function: a C callback's
// extern-record parameter is the address of a struct C owns, so the value is readable (and writable,
// with the ordinary borrow rules) but nothing frees it on return. `flag: 0` is what `release` reads
// as "no drop glue"; the place is a fresh external root so loans and reads still have a subject.
fn borrow_parameter<a>(c: (&a mut C), slot: u64, ty: u64) -> Val {
    if c.raw == 0 {
        place := ownership::root(&mut c.check, 0, 1);
        c
            .resources
            .push(
                Resource {
                    slot: slot,
                    ty: ty,
                    flag: 0,
                    base: 0,
                    field: 0,
                    via: 0,
                    place: place,
                    target: 0,
                    authority: 0
                }
            );
    }
    return val(slot, ty);
}
fn own<a>(c: (&a mut C), slot: u64, ty: u64) -> Val {
    materialise(&mut c, slot, ty);
    if c.raw == 0 {
        drops := needs_drop(&mut c, ty);
        if affine(&mut c, ty) {
            mut flag = 0;
            if drops {
                flag = imm(&mut c, 1) + 1;
            }
            place := ownership::root(&mut c.check, 0, 1);
            c
                .resources
                .push(
                    Resource {
                        slot: slot,
                        ty: ty,
                        flag: flag,
                        base: 0,
                        field: 0,
                        via: 0,
                        place: place,
                        target: 0,
                        authority: 0,
                    }
                );
        }
    }
    return val(slot, ty);
}
// A bond says that a live value retains a loan. Moves append bonds to the new holder;
// historical bonds remain for flow restoration, but dead holders do not keep loans alive.
fn bond_kind<a>(c: (&a mut C), holder: u64, loan: u64, guard: u64) -> unit {
    if (holder == 0) || (loan == 0) {
        return ();
    }
    // Only the holder's own bonds can be the same bond (bonds_sync).
    bonds_sync(&mut c);
    mut j = 0;
    if holder < c.bond_hhead.len() {
        j = c.bond_hhead[holder];
    }
    while j != 0 {
        if (c.bonds[j - 1].loan == loan) & (c.bonds[j - 1].guard == guard) {
            return ();
        }
        j = c.bond_hnext[j - 1];
    }
    c.bonds.push(Bond { holder: holder, loan: loan, guard: guard });
    return ();
}
fn bond<a>(c: (&a mut C), holder: u64, loan: u64) -> unit {
    bond_kind(&mut c, holder, loan, 0);
    return ();
}
fn loan_live<a>(c: (&a mut C), loan: u64) -> u64 {
    mut l = &c.check.loans[loan - 1];
    return l.live;
}
fn transfer_bonds<a>(c: (&a mut C), src: u64, dst: u64) -> unit {
    if (src == 0) || (dst == 0) {
        return ();
    }
    // A source no bond is held under has nothing to pass on (bond_under).
    if !bond_under(&mut c, src) {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if loan_live(&mut c, loan) != 0 {
            if ownership::ancestor(&c.check, src, holder) {
                bond_kind(&mut c, dst, loan, guard);
            }
        }
    }
    return ();
}
fn return_bonds<a>(c: (&a mut C), src: u64, dst: u64, aggregate: u64) -> unit {
    if (src == 0) || (dst == 0) {
        return ();
    }
    // A source no bond is held under has nothing to pass on (bond_under).
    if !bond_under(&mut c, src) {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if loan_live(&mut c, loan) != 0 {
            if ownership::ancestor(&c.check, src, holder) {
                mut role = guard;
                if aggregate != 0 {
                    role = 1;
                }
                if guard == 3 {
                    role = 3;
                }
                if aggregate == 3 {
                    role = 3;
                }
                bond_kind(&mut c, dst, loan, role);
            }
        }
    }
    return ();
}
// The bonds of each loan, as a chain: `bond_head[loan]` is the latest bond made on it (index + 1)
// and `bond_next[bond]` the one before. Brought up to date here, like `resource`'s table; the bond
// list only grows between the swaps that reset this (bonds_swapped).
fn bonds_sync<a>(c: (&a mut C)) -> unit {
    if c.bonds.len() < c.bond_next.len() {
        bonds_swapped(&mut c);
    }
    while c.bond_next.len() < c.bonds.len() {
        at := c.bond_next.len();
        loan := c.bonds[at].loan;
        while c.bond_head.len() <= loan {
            c.bond_head.push(0);
        }
        c.bond_next.push(c.bond_head[loan]);
        c.bond_head[loan] = at + 1;
        holder := c.bonds[at].holder;
        while c.bond_hhead.len() <= holder {
            c.bond_hhead.push(0);
        }
        c.bond_hnext.push(c.bond_hhead[holder]);
        c.bond_hhead[holder] = at + 1;
        // A place's parent never changes, so the marks only accumulate; a marked place's parents are
        // marked already.
        if c.check.places.len() < holder {
            exchange(&mut c.bond_unranged, 1);
        }
        mut p = holder;
        while (p != 0) & (p <= c.check.places.len()) {
            while c.bond_under.len() <= p {
                c.bond_under.push(0);
            }
            if c.bond_under[p] != 0 {
                break;
            }
            c.bond_under[p] = 1;
            p = c.check.places[p - 1].parent;
        }
    }
    return ();
}
fn bonds_swapped<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.bond_head, u64[]);
    exchange(&mut c.bond_next, u64[]);
    exchange(&mut c.bond_hhead, u64[]);
    exchange(&mut c.bond_hnext, u64[]);
    exchange(&mut c.bond_under, u64[]);
    exchange(&mut c.bond_unranged, 0);
    return ();
}
// Whether some bond's holder is `place` or lies inside it: `ownership::ancestor(place, holder)` asked
// of every bond, answered from the marks bonds_sync leaves up each holder's parents.
fn bond_under<a>(c: (&a mut C), place: u64) -> bool {
    bonds_sync(&mut c);
    if c.bond_unranged != 0 {
        for i in c.bonds.len() {
            if ownership::ancestor(&c.check, place, c.bonds[i].holder) {
                return true;
            }
        }
        return false;
    }
    if (place == 0) || (c.check.places.len() < place) || (c.bond_under.len() <= place) {
        return false;
    }
    return c.bond_under[place] != 0;
}
// The record list was replaced by another one: what `resource` remembers is about the old list.
fn resources_swapped<a>(c: (&a mut C)) -> unit {
    exchange(&mut c.res_last, u64[]);
    exchange(&mut c.res_synced, 0);
    return ();
}
fn close_loans<a>(c: (&a mut C)) -> unit {
    mut changed = 1;
    while changed != 0 {
        changed = 0;
        // Only the live loans, newest first, and for each only the bonds made on it (bonds_sync):
        // a function has made thousands of loans and bonds by its last statement and nearly all of
        // them are over.
        bonds_sync(&mut c);
        ids := ownership::live_ids(&mut c.check);
        mut n = ids.len();
        while n != 0 {
            n = n - 1;
            id := ids[n];
            mut held = 0;
            mut j = 0;
            if id < c.bond_head.len() {
                j = c.bond_head[id];
            }
            while j != 0 {
                holder := c.bonds[j - 1].holder;
                state := ownership::status(&c.check, holder);
                if (state == 1) || (state == 3) {
                    held = 1;
                    break;
                }
                j = c.bond_next[j - 1];
            }
            if held == 0 {
                if ownership::end_loan(&mut c.check, id) == 0 {
                    changed = 1;
                }
            }
        }
        for j in c.origins.len() {
            o := &c.origins[j];
            root := o.place;
            region := o.region;
            if region == 18446744073709551615 {
                // An anonymous origin (the referent behind a returned reference) ends once no
                // live loan reaches into it. After a branch join it may be "maybe live" (3): it
                // ended on one path only, which is just as dead once nothing reaches it.
                ostate := ownership::status(&c.check, root);
                if (ostate == 1) || (ostate == 3) {
                    mut reached = 0;
                    alive := ownership::live_ids(&mut c.check);
                    for k in alive.len() {
                        source := c.check.loans[alive[k] - 1].source;
                        if ownership::ancestor(&c.check, root, source) {
                            reached = 1;
                            break;
                        }
                    }
                    if reached == 0 {
                        ownership::cleanup(&mut c.check, root);
                        changed = 1;
                    }
                }
            }
        }
    }
    return ();
}
fn member_place<a>(c: (&a mut C), root: u64, field: u64, ty: u64) -> u64 {
    if root == 0 {
        return 0;
    }
    for i in c.members.len() {
        m := &c.members[i];
        if (m.base == root) & (m.field == field) {
            return m.place;
        }
    }
    copy := !affine(&mut c, ty);
    place := ownership::field(&mut c.check, root, copy);
    c.members.push(Member { base: root, field: field, place: place });
    return place;
}
fn target_of<a>(c: (&a mut C), slot: u64) -> u64 {
    n := resource(&mut c, slot);
    if n == 0 {
        return 0;
    }
    mut r = &c.resources[n - 1];
    return r.target;
}
fn authority_of<a>(c: (&a mut C), slot: u64) -> u64 {
    n := resource(&mut c, slot);
    if n == 0 {
        return 0;
    }
    mut r = &c.resources[n - 1];
    return r.authority;
}
// The place a slice's live loan borrows, or 0 (a slice with no tracked loan).
fn slice_source<a>(c: (&a mut C), slot: u64) -> u64 {
    holder := place_of(&mut c, slot);
    if holder == 0 {
        return 0;
    }
    for i in c.bonds.len() {
        h := c.bonds[i].holder;
        loan := c.bonds[i].loan;
        guard := c.bonds[i].guard;
        if (h == holder) & (guard == 0) && (loan_live(&mut c, loan) != 0) {
            return c.check.loans[loan - 1].source;
        }
    }
    return 0;
}
fn authority_loan<a>(c: (&a mut C), slot: u64, target: u64) -> u64 {
    holder := place_of(&mut c, slot - 1);
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        h := b.holder;
        loan := b.loan;
        if (holder == h) & (b.guard == 0) {
            mut l = &c.check.loans[loan - 1];
            live := l.live;
            source := l.source;
            if live != 0 {
                if ownership::ancestor(&c.check, source, target) {
                    return loan;
                }
            }
        }
    }
    return 0;
}
fn set_target<a>(c: (&a mut C), slot: u64, target: u64, authority: u64) -> unit {
    n := resource(&mut c, slot);
    if n != 0 {
        mut r = &mut c.resources[n - 1];
        exchange(&mut r.target, target);
        exchange(&mut r.authority, authority);
    }
    return ();
}
fn add_region<a>(rs: (&a mut u64[]), r: u64) -> unit {
    for i in rs.len() {
        if rs[i] == r {
            return ();
        }
    }
    rs.push(r);
    return ();
}
// Lifetime parameters inside the declared type (not concrete borrow targets).
// Recursive nominal types (enum Tree { Node(Branch) }, struct Branch { left: Tree }) are walked once:
// a type already on the path adds nothing beyond its own region arguments.
fn type_caps<a>(c: (&a mut C), ty: u64, depth: u64) -> u64[] {
    // The answer is a function of the type and of the declarations it is made of, and it is asked
    // at every call the checker binds - for a record with hundreds of fields that was a walk of all
    // of them, every time. It is remembered per type and forgotten when a declaration or a field
    // is added (docs/design/compile-speed.md).
    stamp := type_walk_stamp(&c);
    if is_type_id(ty) {
        if ty < c.caps_stamp.len() {
            if c.caps_stamp[ty] == stamp {
                return copy_numbers(&c.caps_memo[ty]);
            }
        }
    }
    mut trail = u64[];
    found := caps_walk(&mut c, ty, &mut trail);
    if is_type_id(ty) {
        while c.caps_stamp.len() <= ty {
            c.caps_stamp.push(0);
            c.caps_memo.push(u64[]);
        }
        c.caps_stamp[ty] = stamp;
        exchange(&mut c.caps_memo[ty], copy_numbers(&found));
    }
    return found;
}
// What a remembered walk of a type's structure is valid for: the declarations and fields there are.
// Never 0, which is "nothing remembered".
fn type_walk_stamp<a>(c: (&a C)) -> u64 {
    return c.fields.len() * 16777216 + c.decls.len() * 4 + 2;
}
fn caps_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> u64[] {
    mut rs = type_regions(&mut c, ty);
    k := ty_kind(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if (k == 6) || (k == 27) || (k == 7) || (k == 10) || (k == 13) || (k == 14) || (k == 16) || (k == 29) {
        inner := caps_walk(&mut c, arg, &mut trail);
        for i in inner.len() {
            mut r = inner[i];
            add_region(&mut rs, r);
        }
    }
    if (k == 12) || (k == 20) || (k == 25) {
        // A function value's lifetimes are the ones its signature names: a closure whose type says
        // it returns `&a T` (or takes one) may carry borrows of `a`, which is what lets an adapter
        // hand out references into the collection its closure captured.
        inner := caps_walk(&mut c, arg, &mut trail);
        for i in inner.len() {
            mut r = inner[i];
            add_region(&mut rs, r);
        }
        params := type_args(&mut c, ty);
        for p in params.len() {
            pinner := caps_walk(&mut c, params[p], &mut trail);
            for i in pinner.len() {
                mut r = pinner[i];
                add_region(&mut rs, r);
            }
        }
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return rs;
            }
        }
        trail.push(ty);
        d := &c.decls[arg];
        count := d.count;
        for i in count {
            f := field_type(&mut c, ty, i);
            inner := caps_walk(&mut c, f, &mut trail);
            for j in inner.len() {
                mut r = inner[j];
                add_region(&mut rs, r);
            }
        }
        trail.pop()!;
    }
    return rs;
}
fn intersects<a, b>(a: (&a u64[]), b: (&b u64[])) -> bool {
    for i in a.len() {
        mut r = a[i];
        for j in b.len() {
            if b[j] == r {
                return true;
            }
        }
    }
    return false;
}
fn normalize_readonly<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    k := ty_kind(&mut c, ty);
    if (k != 5) & (k != 7) {
        return ();
    }
    if ty_mode(&mut c, ty) != 0 {
        return ();
    }
    root := place_of(&mut c, slot);
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if (holder == root) & (guard == 0) {
            mut l = &c.check.loans[loan - 1];
            mode := l.mode;
            live := l.live;
            if live != 0 {
                if mode != 0 {
                    child := ownership::reborrow(&mut c.check, loan, 0);
                    if child == 0 {
                        fail(&mut c, view("readonly result cannot borrow suspended authority"));
                    }
                    mut b = &mut c.bonds[i];
                    exchange(&mut b.guard, 1);
                    bond(&mut c, root, child);
                }
            }
        }
    }
    return ();
}
fn call_bonds<a>(
    c: (&a mut C),
    result: Val,
    first: u64,
    args: (&a u64[]),
    capture_type: u64
) -> unit {
    if c.raw != 0 {
        return ();
    }
    captures := type_caps(&mut c, capture_type, 0);
    holder := place_of(&mut c, result.t);
    resultkind := ty_kind(&mut c, result.ty);
    aggregate := resultkind != 5;
    for i in args.len() {
        slot := args[i];
        source := place_of(&mut c, slot);
        ty := c.params[first + i];
        kind := ty_kind(&mut c, ty);
        // A closure argument can carry lifetimes its parameter's `Fn(...)` type does not name. The
        // caller keeps the loan by handing it to the result: a callee that returns the callable
        // cannot make it outlive what it borrows.
        // Only a parameter that may keep the closure: one typed without `Owned` borrows it for the
        // call (docs/design/closure-bounds.md, stage 3), so nothing of it reaches the result.
        if (kind == 20) && ((ty_mode(&mut c, ty) & CLOSURE_OWNED) != 0) {
            n := resource(&mut c, slot);
            if n != 0 {
                info := &c.resources[n - 1];
                actual := info.ty;
                // The value may already be typed by a signature (it was converted to `Fn<Send>(..)`
                // on its way here), so its type no longer shows the borrow: its place does.
                if (ty_kind(&mut c, actual) == 20) && (contains_borrow(&mut c, actual, 0) || (closure_stated_borrower(&mut c, actual) && holds_live_loan(&mut c, source))) {
                    return_bonds(&mut c, source, holder, 1);
                }
            }
        }
        mut rs = type_caps(&mut c, ty, 0);
        if kind == 7 {
            rs = type_regions(&mut c, ty);
        }
        if intersects(&rs, &captures) {
            mut role = u64(aggregate);
            if (kind == 7) & (resultkind == 7) {
                role = 3;
            }
            return_bonds(&mut c, source, holder, role);
        }
        if kind == 7 {
            inner := ty_arg(&mut c, ty);
            data := type_caps(&mut c, inner, 0);
            if intersects(&data, &captures) {
                storage := target_of(&mut c, slot);
                return_bonds(&mut c, storage, holder, aggregate);
            }
        }
    }
    if ty_kind(&mut c, result.ty) == 7 {
        stored_source(&mut c, result.t, result.ty);
        if target_of(&mut c, result.t) == 0 {
            fail(&mut c, view("reference result has no declared frame source"));
        }
    }
    k := ty_kind(&mut c, result.ty);
    if (k == 5) || (k == 7) || (k == 27) {
        stored_source(&mut c, result.t, result.ty);
        if !has_bonds(&mut c, holder) {
            fail(&mut c, view("borrowed result has no declared input source"));
        }
    }
    pointer_results(&mut c, result.t, result.ty, first, &args);
    normalize_readonly(&mut c, result.t, result.ty);
    close_loans(&mut c);
    return ();
}
// Weak updates retain historical guards across branch restoration. External storage
// accepts only origins explicitly present in its invariant data-lifetime contract.
fn check_writeback<a>(c: (&a mut C), destination: u64, ty: u64, source: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    // A stored closure (or a record of one) shows no borrow in its type but may still hold one -
    // a call-scoped closure parameter, or a closure that captured a reference: its loans decide.
    if !contains_borrow(&mut c, ty, 0) && !(may_hide_borrow(&mut c, ty) && holds_live_loan(&mut c, source)) {
        return ();
    }
    region := region_of(&mut c, destination);
    if region == 0 {
        return ();
    }
    if region == 18446744073709551615 {
        mut found = 0;
        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            holder := b.holder;
            guard := b.guard;
            loan := b.loan;
            if (guard == 3) & ownership::ancestor(&c.check, destination, holder) {
                if loan_live(&mut c, loan) != 0 {
                    mut l = &c.check.loans[loan - 1];
                    source := l.source;
                    mut r = region_of(&mut c, source);
                    if r != 18446744073709551615 {
                        if r != 0 {
                            fail(
                                &mut c,
                                view("opaque external captured storage has no concrete invariant contract")
                            );
                        }
                        found = 1;
                    }
                }
            }
        }
        if found == 0 {
            fail(&mut c, view("opaque captured storage lacks a checked local frame"));
        }
        return ();
    }
    allowed := type_caps(&mut c, ty, 0);
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if ownership::ancestor(&c.check, source, holder) {
            if loan_live(&mut c, loan) != 0 {
                mut l = &c.check.loans[loan - 1];
                origin := l.source;
                mut r = region_of(&mut c, origin);
                if r != 18446744073709551615 {
                    mut found = 0;
                    for j in allowed.len() {
                        if allowed[j] == r {
                            found = 1;
                        }
                    }
                    if (r == 0) || (found == 0) {
                        if (ty_kind(&mut c, ty) == 20) & !contains_borrow(&mut c, ty, 0) {
                            fail(
                                &mut c,
                                view("this closure may only be used during the call it was passed to (a parameter typed `Fn(..)` borrows for the call), so it cannot be stored here: take `Fn<Owned>(..)` to keep it")
                            );
                        }
                        fail(&mut c, view("captured writeback violates invariant lifetime"));
                    }
                }
            }
        }
    }
    return ();
}
fn seed_storage<a>(c: (&a mut C), storage: u64, ty: u64) -> unit {
    region := region_of(&mut c, storage);
    if (region == 0) || (region == 18446744073709551615) {
        return ();
    }
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        if ownership::ancestor(&c.check, storage, holder) {
            return ();
        }
    }
    k := ty_kind(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        slot := imm(&mut c, 0);
        c
            .resources
            .push(
                Resource {
                    slot: slot,
                    ty: ty,
                    flag: 0,
                    base: 1,
                    field: 0,
                    via: 1,
                    place: storage,
                    target: 0,
                    authority: 0,
                }
            );
        stored_source(&mut c, slot, ty);
        return ();
    }
    caps := type_caps(&mut c, ty, 0);
    for i in caps.len() {
        mut r = caps[i];
        source := external_place(&mut c, r, 0);
        loan := ownership::borrow_place(&mut c.check, source, 0);
        bond_kind(&mut c, storage, loan, 1);
    }
    return ();
}
fn frame_storage<a>(c: (&a mut C), slot: u64, destination: u64) -> unit {
    root := place_of(&mut c, slot);
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        guard := b.guard;
        loan := b.loan;
        if holder == root && guard != 0 {
            if loan_live(&mut c, loan) != 0 {
                bond_kind(&mut c, destination, loan, guard);
            }
        }
    }
    return ();
}
fn storage_bonds<a>(c: (&a mut C), source: u64, destination: u64) -> unit {
    mut owners = u64[];
    n := c.bonds.len();
    if region_of(&mut c, destination) == 18446744073709551615 {
        for i in n {
            mut b = &c.bonds[i];
            holder := b.holder;
            guard := b.guard;
            loan := b.loan;
            if (guard == 3) & ownership::ancestor(&c.check, destination, holder) {
                if loan_live(&mut c, loan) != 0 {
                    mut l = &c.check.loans[loan - 1];
                    owner := l.source;
                    if region_of(&mut c, owner) == 0 {
                        owners.push(owner);
                    }
                }
            }
        }
    }
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if ownership::ancestor(&c.check, source, holder) {
            if !((source == destination) && (guard == 3)) {
                if loan_live(&mut c, loan) != 0 {
                    mut role = guard;
                    if role == 3 {
                        role = 1;
                    }
                    bond_kind(&mut c, destination, loan, role);
                    for j in owners.len() {
                        owner := owners[j];
                        bond_kind(&mut c, owner, loan, 1);
                    }
                }
            }
        }
    }
    return ();
}
fn writeback_source<a>(c: (&a mut C), destination: u64, ty: u64, source: u64) -> unit {
    check_writeback(&mut c, destination, ty, source);
    storage_bonds(&mut c, source, destination);
    return ();
}
fn call_writebacks<a, b, d>(
    c: (&a mut C),
    first: u64,
    args: (&b u64[]),
    actuals: (&d u64[])
) -> unit {
    if c.raw != 0 {
        return ();
    }
    for i in args.len() {
        formal := c.params[first + i];
        k := ty_kind(&mut c, formal);
        mode := ty_mode(&mut c, formal);
        if k == 7 && mode != 0 {
            inner := ty_arg(&mut c, formal);
            if contains_borrow(&mut c, inner, 0) {
                mut rs = type_caps(&mut c, inner, 0);
                slot := args[i];
                destination := target_of(&mut c, slot);
                actual := actuals[i];
                storage := ty_arg(&mut c, actual);
                frame_storage(&mut c, slot, destination);
                seed_storage(&mut c, destination, storage);
                for j in args.len() {
                    ty := c.params[first + j];
                    kind := ty_kind(&mut c, ty);
                    argument := args[j];
                    mut caps = type_caps(&mut c, ty, 0);
                    if kind == 7 {
                        caps = type_regions(&mut c, ty);
                    }
                    if intersects(&rs, &caps) {
                        source := place_of(&mut c, argument);
                        writeback_source(&mut c, destination, storage, source);
                    }
                    if kind == 7 {
                        inner := ty_arg(&mut c, ty);
                        data := type_caps(&mut c, inner, 0);
                        if intersects(&rs, &data) {
                            mut source = target_of(&mut c, argument);
                            actual := actuals[j];
                            inner := ty_arg(&mut c, actual);
                            seed_storage(&mut c, source, inner);
                            if (region_of(&mut c, source) == 18446744073709551615)
                                & (source != destination) {
                                source = place_of(&mut c, argument);
                            }
                            writeback_source(&mut c, destination, storage, source);
                        }
                    }
                }
            }
        }
    }
    return ();
}
fn block_end<a>(c: (&a mut C), start: u64) -> u64 {
    mut i = start;
    mut depth = 0;
    while i < c.toks.len() {
        k := kind_at(&mut c, i);
        if k == 123 {
            depth = depth + 1;
        }
        if k == 125 {
            if depth == 0 {
                // A `}` before any `{`: the block was expected to start with a brace.
                exchange(&mut c.pos, start);
                fail(&mut c, view("expected { to start a block"));
            }
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    fail(&mut c, view("unclosed block"));
    return start;
}
fn last_name<a, b>(c: (&a mut C), name: &b [u8], from: u64, to: u64) -> u64 {
    mut last = 0;
    if from != 0 {
        last = from - 1;
    }
    mut i = from;
    mut depth = 0;
    mut base = 0;
    mut pending = 0;
    mut hidden = 0;
    mut skip = 0;
    if from < c.toks.len() {
        if kind_at(&mut c, from) == 123 {
            base = 1;
        }
    }
    while i < to {
        t := &c.toks[i];
        kind := t.kind;
        st := t.start;
        en := t.end;
        if kind == 123 {
            depth = depth + 1;
        }
        // A scan can start inside an enclosing group; its closing brace ends this scope.
        if kind == 125 {
            if depth == 0 {
                break;
            }
            if hidden == depth + 1 {
                hidden = 0;
            }
            depth = depth - 1;
        }
        // The tokens are read in place: this scan visits every token of the scope for every
        // binding, and copying each one out to compare it was most of a check's allocations.
        if (kind == 1) & (hidden == 0) & (pending == 0) {
            if (en - st == 3) && (c.src[st] == 109) && (c.src[st + 1] == 117) && (c.src[st + 2] == 116) {
                mut declaration = 1;
                if i != 0 {
                    if kind_at(&mut c, i - 1) == 38 {
                        declaration = 0;
                    }
                }
                if declaration != 0 {
                    // Past the last token is the empty text, as `tok_text` has it.
                    mut declared = name.len() == 0;
                    if i + 1 < c.toks.len() {
                        ds := c.toks[i + 1].start;
                        de := c.toks[i + 1].end;
                        declared = de - ds == name.len();
                        mut j = 0;
                        while declared && (j < name.len()) {
                            if c.src[ds + j] != name[j] {
                                declared = false;
                            }
                            j = j + 1;
                        }
                    }
                    if declared {
                        pending = depth + 1;
                        skip = i + 1;
                    }
                }
            }
            if (i + 1 < c.toks.len()) && (c.toks[i + 1].kind == 261) {
                mut named = en - st == name.len();
                mut j = 0;
                while named && (j < name.len()) {
                    if c.src[st + j] != name[j] {
                        named = false;
                    }
                    j = j + 1;
                }
                if named {
                    pending = depth + 1;
                    skip = i;
                }
            }
        }
        // Whether the token is a use is asked only of a name of the right length: the neighbours
        // are read for that one, not for every token of the scope.
        if kind == 1 && en - st == name.len() && i != skip && hidden == 0 {
            mut use = 1;
            if i != 0 {
                prev := c.toks[i - 1].kind;
                if (prev == 46) || (prev == 260) {
                    use = 0;
                }
            }
            // `name(` is a use too: a local holding a closure (or a reference to one) is called by its
            // name, and the call reads it. Counting a same-named function's call as well only keeps the
            // local alive a little longer, which is the conservative side.
            if i + 1 < c.toks.len() {
                next := c.toks[i + 1].kind;
                if (next == 58) || (next == 260) || (next == 261) {
                    use = 0;
                }
            }
            mut matched = use;
            mut j = 0;
            while (matched != 0) && (j < en - st) {
                if c.src[st + j] != name[j] {
                    matched = 0;
                    break;
                }
                j = j + 1;
            }
            if matched != 0 {
                last = i;
            }
        }
        if (pending != 0) & (kind == 59) & (depth + 1 == pending) {
            if depth == base {
                break;
            }
            hidden = pending;
            pending = 0;
        }
        i = i + 1;
    }
    return last;
}
fn is_local_slot<a>(c: (&a mut C), slot: u64) -> bool {
    for i in c.locals.len() {
        mut l = &c.locals[i];
        if l.id == slot {
            return true;
        }
    }
    return false;
}
fn release_temporary<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if is_local_slot(&mut c, slot) {
        return ();
    }
    mut r = resource(&mut c, slot);
    if r == 0 {
        return ();
    }
    info := &c.resources[r - 1];
    place := info.place;
    base := info.base;
    if (base == 0) & (place != 0) {
        if ownership::can_cleanup(&c.check, place) {
            release(&mut c, r - 1);
        }
    }
    return ();
}
fn expire_locals<a>(c: (&a mut C)) -> unit {
    if c.raw != 0 {
        return ();
    }
    for i in c.locals.len() {
        mut l = &c.locals[i];
        slot := l.id;
        ty := l.ty;
        last := l.last;
        born := l.born;
        k := ty_kind(&mut c, ty);
        mut carrier = k == 5 || k == 7 || k == 27;
        root := place_of(&mut c, slot);
        if (k == 6) || (k == 8) || (k == 26) {
            if bond_under(&mut c, root) {
                carrier = true;
            }
        }
        if carrier {
            if last < c.pos {
                mut defer = 0;
                if c.loop_end != 0 {
                    if (born < c.loop_start) & (last < c.loop_end) {
                        defer = 1;
                    }
                }
                if defer == 0 {
                    mut r = resource(&mut c, slot);
                    if r != 0 {
                        info := &c.resources[r - 1];
                        place := info.place;
                        if place != 0 {
                            if ownership::can_cleanup(&c.check, place) {
                                if (k == 6) || (k == 8) || (k == 26) {
                                    ownership::cleanup(&mut c.check, place);
                                    close_loans(&mut c);
                                } else {
                                    release(&mut c, r - 1);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return ();
}
// Bindings authorize writes to owned storage; explicit mutable capabilities authorize
// writes through their referents, without making the capability binding reassignable.
fn binding_mode<a>(c: (&a C), slot: u64) -> u64 {
    for i in c.locals.len() {
        entry := &c.locals[i];
        id := entry.id;
        mutable := entry.mutable;
        if id == slot {
            return mutable + 1;
        }
    }
    return 0;
}
fn require_mutable_binding<a>(c: (&a mut C), slot: u64, storage: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    mut current = slot;
    mut depth = 0;
    while depth < c.resources.len() + 1 {
        index := resource(&mut c, current);
        if index != 0 {
            mut r = &c.resources[index - 1];
            ty := r.ty;
            place := r.place;
            authority := r.authority;
            base := r.base;
            k := ty_kind(&mut c, ty);
            mode := ty_mode(&mut c, ty);
            if (k == 7) & (place != 0) {
                if mode != 0 {
                    return ();
                }
                fail_readonly(&mut c, place, view("reference"));
            }
            if ((k == 5) || (k == 27)) && (storage == 0) {
                if mode != 0 {
                    return ();
                }
                fail_readonly(&mut c, place, view("view"));
            }
            if authority != 0 {
                a := resource(&mut c, authority - 1);
                if a != 0 {
                    info := &c.resources[a - 1];
                    at := info.ty;
                    if ty_kind(&mut c, at) == 7 {
                        if ty_mode(&mut c, at) != 0 {
                            return ();
                        }
                        fail_readonly(&mut c, place, view("frame"));
                    }
                }
            }
            binding := binding_mode(&c, current);
            if binding == 1 {
                fail(&mut c, view("owned storage mutation requires mut"));
            }
            if binding == 2 {
                return ();
            }
            if base == 0 {
                return ();
            }
            current = base - 1;
        } else {
            binding := binding_mode(&c, current);
            if binding == 1 {
                fail(&mut c, view("owned storage mutation requires mut"));
            }
            return ();
        }
        depth = depth + 1;
    }
    fail(&mut c, view("invalid mutation provenance"));
    return ();
}
fn require_write<a>(c: (&a mut C), slot: u64) -> unit {
    require_mutable_binding(&mut c, slot, 0);
    if c.raw != 0 {
        return ();
    }
    index := resource(&mut c, slot);
    if index == 0 {
        fail(&mut c, view("mutation target is not tracked"));
    }
    mut r = &c.resources[index - 1];
    ty := r.ty;
    place := r.place;
    authority := r.authority;
    target := r.target;
    k := ty_kind(&mut c, ty);
    if (k == 7) & (place == 0) {
        if authority != 0 {
            mut r = resource(&mut c, authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("write through readonly frame"));
            }
            loan := authority_loan(&mut c, authority, target);
            if loan == 0 {
                fail(&mut c, view("field write has no authority"));
            }
            if ownership::access_loan(&c.check, loan, target, 1) != 0 {
                fail(&mut c, view("field write conflicts with active loan"));
            }
        } else {
            if ownership::initialize(&mut c.check, target) != 0 {
                pointer_conflict(&mut c, target, view("modify"), 0);
                borrow_context(&mut c, target, view("modify"));
                fail(
                    &mut c,
                    view("field assignment conflicts with live borrow or moved storage")
                );
            }
        }
        return ();
    }
    if (k == 5) || (k == 7) || (k == 27) {
        if ty_mode(&mut c, ty) == 0 {
            fail_readonly(&mut c, place, view("reference"));
        }
        mut allowed = 0;
        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            holder := b.holder;
            loan := b.loan;
            guard := b.guard;
            if (guard == 0) & ownership::ancestor(&c.check, holder, place) {
                if loan_live(&mut c, loan) != 0 {
                    allowed = 1;
                    if ownership::use_loan(&c.check, loan, 1) != 0 {
                        fail(&mut c, view("write authority is suspended"));
                    }
                }
            }
        }
        if allowed == 0 {
            fail(&mut c, view("write lacks checked source"));
        }
    } else {
        if authority != 0 {
            mut r = resource(&mut c, authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(&mut c, ty) == 0 {
                fail_readonly(&mut c, place, view("frame"));
            }
            loan := authority_loan(&mut c, authority, place);
            if loan == 0 {
                fail(&mut c, view("write has no reference authority"));
            }
            if ownership::access_loan(&c.check, loan, place, 1) != 0 {
                fail(&mut c, view("write conflicts with active loan"));
            }
        } else {
            loan := ownership::borrow_place(&mut c.check, place, 1);
            if loan == 0 {
                pointer_conflict(&mut c, place, view("modify"), 0);
                borrow_context(&mut c, place, view("modify"));
                fail(&mut c, view("mutation conflicts with live borrow"));
            }
            ownership::end_loan(&mut c.check, loan);
        }
    }
    return ();
}
fn region_of<a>(c: (&a mut C), place: u64) -> u64 {
    for i in c.origins.len() {
        o := &c.origins[i];
        root := o.place;
        region := o.region;
        if ownership::ancestor(&c.check, root, place) {
            return region;
        }
    }
    return 0;
}
fn external_place<a>(c: (&a mut C), region: u64, copy: u64) -> u64 {
    p := ownership::root(&mut c.check, copy, 1);
    c.origins.push(Origin { place: p, region: region });
    return p;
}
fn add_external_capture<a>(c: (&a mut C), holder: u64, region: u64, mode: u64) -> u64 {
    source := external_place(&mut c, region, 0);
    loan := ownership::borrow_place(&mut c.check, source, mode);
    bond(&mut c, holder, loan);
    return source;
}
fn init_parameter<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    holder := place_of(&mut c, slot);
    k := ty_kind(&mut c, ty);
    mut rs = type_regions(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        if rs.len() != 1 {
            fail(&mut c, view("parameter requires a declared lifetime"));
        }
        mut r = rs[0];
        source := add_external_capture(&mut c, holder, r, mode);
        if k == 7 {
            set_target(&mut c, slot, source, slot + 1);
        }
        return ();
    }
    // A closure parameter that does not say `Owned` borrows for the call only
    // (docs/design/closure-bounds.md, 2.3): it holds a loan of a place no type can name (region 0,
    // like a local's), so the callee may call it and pass it on to another such parameter, but
    // returning it, storing it, or capturing it in a closure that is returned or stored is the
    // ordinary escape error.
    if (k == 20) && (ty_env(&mut c, ty) == 0) && ((mode & (CLOSURE_OWNED + CLOSURE_UNBUILT)) == 0) && (rs.len() == 0) {
        call := external_place(&mut c, 0, 0);
        scoped := ownership::borrow_place(&mut c.check, call, 0);
        bond_kind(&mut c, holder, scoped, 1);
    }
    captures := type_caps(&mut c, ty, 0);
    for i in captures.len() {
        mut r = captures[i];
        target := external_place(&mut c, r, 0);
        loan := ownership::borrow_place(&mut c.check, target, 0);
        bond_kind(&mut c, holder, loan, 1);
    }
    return ();
}
fn has_bonds<a>(c: (&a mut C), holder: u64) -> bool {
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        h := b.holder;
        guard := b.guard;
        loan := b.loan;
        if (h == holder) & (guard == 0) {
            if loan_live(&mut c, loan) != 0 {
                return true;
            }
        }
    }
    return false;
}
// Stored captures in an abstract input referent have their declared data lifetime,
// distinct from the lifetime of the outer reference frame.
fn stored_source<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    k := ty_kind(&mut c, ty);
    if (k != 5) & (k != 7) & (k != 27) {
        return ();
    }
    if has_bonds(&mut c, place) {
        if k == 7 {
            for i in c.bonds.len() {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if (holder == place) & (guard == 0) {
                    if loan_live(&mut c, loan) != 0 {
                        mut l = &c.check.loans[loan - 1];
                        source := l.source;
                        authority := authority_of(&mut c, slot);
                        set_target(&mut c, slot, source, authority);
                        break;
                    }
                }
            }
        }
        return ();
    }
    mut guarded = 0;
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if guard != 0 {
            if loan_live(&mut c, loan) != 0 {
                if ownership::ancestor(&c.check, holder, place) {
                    bond_kind(&mut c, place, loan, guard);
                    guarded = 1;
                }
            }
        }
    }
    if guarded != 0 {
        mode := ty_mode(&mut c, ty);
        source := external_place(&mut c, 18446744073709551615, 0);
        loan := ownership::borrow_place(&mut c.check, source, mode);
        bond(&mut c, place, loan);
        if k == 7 {
            mut authority = authority_of(&mut c, slot);
            mut r = resource(&mut c, slot);
            info := &c.resources[r - 1];
            if info.base == 0 {
                authority = slot + 1;
            }
            set_target(&mut c, slot, source, authority);
        }
        return ();
    }
    if region_of(&mut c, place) == 0 {
        return ();
    }
    mut rs = type_regions(&mut c, ty);
    if rs.len() != 1 {
        fail(&mut c, view("stored capture lifetime missing"));
    }
    mut r = rs[0];
    mode := ty_mode(&mut c, ty);
    target := add_external_capture(&mut c, place, r, mode);
    if k == 7 {
        authority := authority_of(&mut c, slot);
        set_target(&mut c, slot, target, authority);
    }
    return ();
}
fn bind_loan<a>(c: (&a mut C), value: u64, source: u64, target: u64, mode: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if target == 0 {
        fail(&mut c, view("borrow target is not tracked"));
    }
    mut authority = authority_of(&mut c, source);
    source_id := resource(&mut c, source);
    if source_id != 0 {
        mut r = &c.resources[source_id - 1];
        ty := r.ty;
        if ty_kind(&mut c, ty) == 7 {
            authority = source + 1;
        }
        // A slice holds its loan the way a reference does: a borrow inside what it borrows is a
        // re-borrow through it.
        if ty_kind(&mut c, ty) == 27 {
            borrowed := slice_source(&mut c, source);
            if (borrowed != 0) && ownership::ancestor(&c.check, borrowed, target) {
                authority = source + 1;
            }
        }
    }
    mut loan = 0;
    if authority != 0 {
        if mode != 0 {
            mut r = resource(&mut c, authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(&mut c, ty) == 0 {
                fail(&mut c, view("mutable borrow through readonly frame"));
            }
        }
        parent := authority_loan(&mut c, authority, target);
        if parent == 0 {
            fail(&mut c, view("reference has no access authority"));
        }
        loan = ownership::reborrow_place(&mut c.check, parent, target, mode);
        owner := place_of(&mut c, authority - 1);
        holder := place_of(&mut c, value);
        n := c.bonds.len();
        for i in n {
            mut b = &c.bonds[i];
            old := b.loan;
            h := b.holder;
            guard := b.guard;
            if (h == owner) & (guard != 0) {
                bond_kind(&mut c, holder, old, 1);
            }
            if (h == owner) & (old != parent) & (guard == 0) {
                if loan_live(&mut c, old) != 0 {
                    extra := ownership::reborrow(&mut c.check, old, mode);
                    if extra == 0 {
                        fail(&mut c, view("ambiguous reborrow lacks authority"));
                    }
                    bond(&mut c, holder, extra);
                }
            }
        }
    } else {
        loan = ownership::borrow_place(&mut c.check, target, mode);
        if loan == 0 {
            // Loans whose holders are all dead (a moved match scrutinee's payload loans) end
            // here, then the borrow is retried; a real conflict still fails.
            close_loans(&mut c);
            loan = ownership::borrow_place(&mut c.check, target, mode);
        }
    }
    if loan == 0 {
        if (c.raw == 0) & (c.cptr_address != 0) {
            if c.cptr_address == 2 {
                fail(
                    &mut c,
                    view("the value handed to C as a writable pointer is already borrowed in this expression")
                );
            }
            fail(
                &mut c,
                view("the value handed to C as a read-only pointer is already mutably borrowed in this expression")
            );
        }
        pointer_conflict(&mut c, target, view("borrow"), u64(mode == 0));
        fail(&mut c, view("borrow conflicts with active access"));
    }
    holder := place_of(&mut c, value);
    bond(&mut c, holder, loan);
    return ();
}
fn borrow_reference<a>(
    c: (&a mut C),
    slot: u64,
    ty: u64,
    source: u64,
    target: u64,
    mode: u64
) -> Val {
    own(&mut c, slot, ty);
    bind_loan(&mut c, slot, source, target, mode);
    set_target(&mut c, slot, target, slot + 1);
    return val(slot, ty);
}
// The loop backedge check (ownership::backedge), with one more loan that cannot consume entry
// storage: a shared borrow of storage outside the function (an origin place, such as what a
// captured iterator over references lends out on each turn). Such storage is never moved or
// rewritten here, and shared loans never conflict, so a fresh one per turn is still a fixpoint.
fn backedge_ok<a, b>(c: (&a mut C), entry: (&b ownership::State)) -> bool {
    code := ownership::backedge(&c.check, &entry);
    if code == 0 {
        return true;
    }
    if code != 3 {
        return false;
    }
    for i in entry.loans.len() {
        if (i < c.check.loans.len()) && (c.check.loans[i].live != entry.loans[i].live) {
            return false;
        }
    }
    mut i = entry.loans.len();
    while i < c.check.loans.len() {
        l := &c.check.loans[i];
        live := l.live;
        mode := l.mode;
        source := l.source;
        parent := l.parent;
        if live != 0 {
            mut stable = false;
            if mode == 0 {
                for j in entry.loans.len() {
                    old := &entry.loans[j];
                    if (old.live != 0) && (old.mode == 0) && (old.source == source) && (old.parent == parent) {
                        stable = true;
                    }
                }
                if (parent == 0) && !stable {
                    for k in c.origins.len() {
                        if c.origins[k].place == source {
                            stable = true;
                        }
                    }
                }
            }
            if !stable {
                return false;
            }
        }
        i += 1;
    }
    return true;
}
fn view_bonds<a>(c: (&a mut C), slot: u64, source: u64, mode: u64, copied_ref: bool) -> unit {
    if c.raw != 0 {
        return ();
    }
    root := place_of(&mut c, source);
    holder := place_of(&mut c, slot);
    if root == 0 {
        fail(&mut c, view("view source is not tracked"));
    }
    source_index := resource(&mut c, source);
    mut r = &c.resources[source_index - 1];
    ty := r.ty;
    // A shared reference copied out through a shared reference (deref_value) reborrows the loans
    // that cover where it was read from, as a shared view does.
    if (ty_kind(&mut c, ty) == 5) || (ty_kind(&mut c, ty) == 27) || copied_ref {
        if mode != 0 {
            index := resource(&mut c, source);
            mut r = &c.resources[index - 1];
            base := r.base;
            authority := r.authority;
            if base != 0 {
                if authority != 0 {
                    mut r = resource(&mut c, authority - 1);
                    info := &c.resources[r - 1];
                    ty := info.ty;
                    if ty_mode(&mut c, ty) == 0 {
                        fail(&mut c, view("unique field reborrow through readonly frame"));
                    }
                    parent := authority_loan(&mut c, authority, root);
                    if ownership::access_loan(&c.check, parent, root, 1) != 0 {
                        fail(&mut c, view("unique field reborrow requires mutable frame"));
                    }
                } else {
                    if !ownership::can_cleanup(&c.check, root) {
                        fail(&mut c, view("field frame is shared"));
                    }
                }
            }
        }
        mut found = 0;
        n := c.bonds.len();
        for i in n {
            mut b = &c.bonds[i];
            h := b.holder;
            parent := b.loan;
            guard := b.guard;
            if loan_live(&mut c, parent) != 0 {
                if ownership::ancestor(&c.check, h, root) {
                    if guard != 0 {
                        bond_kind(&mut c, holder, parent, 1);
                    } else {
                        loan := ownership::reborrow(&mut c.check, parent, mode);
                        if loan == 0 {
                            fail(&mut c, view("view reborrow lacks authority"));
                        }
                        bond(&mut c, holder, loan);
                        found = 1;
                    }
                }
            }
        }
        if found == 0 {
            fail(&mut c, view("view has no lifetime source"));
        }
    } else {
        bind_loan(&mut c, slot, source, root, mode);
    }
    return ();
}
fn validate_return<a>(c: (&a mut C), v: Val) -> unit {
    if c.raw != 0 {
        return ();
    }
    // Every returned value is checked, not only one whose type names a borrow: a closure that
    // captured a reference keeps its loan in the environment, and a value that merely holds such a
    // closure (`struct Holder { f: Fn(u64) -> u64 }`) still must not carry a loan out of the frame.
    place := place_of(&mut c, v.t);
    if place == 0 {
        return ();
    }
    mut rs = type_caps(&mut c, c.result, 0);
    // A specialisation's result may carry its type arguments' lifetimes (captured_bonds).
    bound := copy_numbers(&c.bindings);
    for i in bound.len() {
        if bound[i] != NO_TYPE {
            more := type_caps(&mut c, bound[i], 0);
            for j in more.len() {
                add_region(&mut rs, more[j]);
            }
        }
    }
    mut found = 0;
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if ownership::ancestor(&c.check, place, holder) {
            if loan_live(&mut c, loan) != 0 {
                mut l = &c.check.loans[loan - 1];
                source := l.source;
                region := region_of(&mut c, source);
                mut allowed = 0;
                for j in rs.len() {
                    if rs[j] == region {
                        allowed = 1;
                    }
                }
                if region != 18446744073709551615 {
                    if (region == 0) || (allowed == 0) {
                        pointer_escape(&mut c, loan);
                        fail(&mut c, view("returned borrow escapes its declared input lifetime"));
                    }
                }
                found = 1;
            }
        }
    }
    k := ty_kind(&mut c, v.ty);
    if (k == 5) || (k == 7) || (k == 27) {
        if found == 0 {
            fail(&mut c, view("returned reference has no checked source"));
        }
    }
    return ();
}
fn place_of<a>(c: (&a mut C), slot: u64) -> u64 {
    mut r = resource(&mut c, slot);
    if r == 0 {
        return 0;
    }
    mut r = &c.resources[r - 1];
    return r.place;
}
// E0006: a read of storage that holds no value. "use of moved, borrowed or partially initialized
// value" named no value and no state; the clause after the colon says which binding and which of the
// three it is, and the help line says what to do about it.
fn fail_unusable<a>(c: (&a mut C), place: u64) -> unit {
    name := place_name(&mut c, place);
    state := ownership::status(&c.check, place);
    mut msg = copy_bytes(view("use of moved, borrowed or partially initialized value"));
    if name.len() != 0 {
        push_bytes(&mut msg, view(": `"));
        push_bytes(&mut msg, view(name));
        if state == 0 {
            push_bytes(&mut msg, view("` is read before it was assigned"));
            mut help = copy_bytes(view("assign it first (`"));
            push_bytes(&mut help, view(name));
            push_bytes(&mut help, view(" = ...`), or give the declaration a value (`mut "));
            push_bytes(&mut help, view(name));
            push_bytes(&mut help, view(" = ...`)"));
            diag_help(&mut c, view(help));
        } else if state == 3 {
            push_bytes(&mut msg, view("` may have been moved on another path"));
            mut help = copy_bytes(view("move it on every path or on none, or copy it (`"));
            push_bytes(&mut help, view(name));
            push_bytes(&mut help, view(".copy()`)"));
            diag_help(&mut c, view(help));
        } else if state == 1 {
            push_bytes(&mut msg, view("` holds no value yet"));
            mut help = copy_bytes(view("write it (`"));
            push_bytes(&mut help, view(name));
            push_bytes(&mut help, view(" = ...`) before reading it"));
            diag_help(&mut c, view(help));
        } else {
            push_bytes(&mut msg, view("` was moved, so it cannot be read here"));
            mut help = copy_bytes(view("copy it (`"));
            push_bytes(&mut help, view(name));
            push_bytes(&mut help, view(".copy()`), borrow it (`view("));
            push_bytes(&mut help, view(name));
            push_bytes(&mut help, view(")`), or keep the value the move produced"));
            diag_help(&mut c, view(help));
        }
    }
    fail(&mut c, view(msg));
}
// E0009: a write through a shared borrow. "mutation through readonly frame" named neither the
// binding nor the way out; this names the binding and says how to get a writable one.
fn fail_readonly<a, b>(c: (&a mut C), place: u64, kind: &b [u8]) -> unit {
    mut name = place_name(&mut c, place);
    // `place_name` answers `*v` for storage reached through a reference; the binding the reader
    // wrote is `v`, and that is the one to change.
    if name.len() != 0 {
        if name[0] == 42 {
            mut bare = u8[];
            for i in name.len() {
                if i != 0 {
                    bare.push(name[i]);
                }
            }
            name = bare;
        }
    }
    mut msg = copy_bytes(view("mutation through readonly "));
    push_bytes(&mut msg, view(kind));
    if name.len() != 0 {
        push_bytes(&mut msg, view(": `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view("` is a shared borrow, so it cannot be written through"));
        mut hint = copy_bytes(view("take an exclusive borrow of it if the change is intended: `"));
        push_bytes(&mut hint, view(name));
        push_bytes(&mut hint, view("` as `&mut T`, passed as `&mut value` at the call"));
        if same(view(kind), view("view")) {
            hint = copy_bytes(view("make the view exclusive: `view_mut("));
            push_bytes(&mut hint, view(name));
            push_bytes(&mut hint, view(")`"));
        }
        diag_help(&mut c, view(hint));
    }
    fail(&mut c, view(msg));
}
// The ", found `X`" tail of a parse error: the token the parser actually stopped on, or the end of
// the file. A parse error used to say only what it wanted ("expected ;"), never what it got.
fn found_msg<a>(c: (&a mut C)) -> u8[] {
    k := c.pos;
    mut out = u8[];
    if kind_at(&mut c, k) != 0 {
        push_bytes(&mut out, view(", found `"));
        push_bytes(&mut out, view(tok_text(&mut c, k)));
        out.push(96);
    } else {
        push_bytes(&mut out, view(", found the end of the file"));
    }
    return out;
}
// "`f` takes 2, this call passes 1": the callee and both counts. "function argument count" left the
// reader to compare the signature with the call by hand.
fn call_arity_msg<a, b>(c: (&a mut C), name: &b [u8], want: u64, got: u64) -> u8[] {
    mut msg = copy_bytes(view("wrong number of arguments: `"));
    push_bytes(&mut msg, view(name));
    push_bytes(&mut msg, view("` takes "));
    push_bytes(&mut msg, view(decimal_bytes(want)));
    push_bytes(&mut msg, view(", this call passes "));
    push_bytes(&mut msg, view(decimal_bytes(got)));
    return msg;
}
fn observe<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    place := place_of(&mut c, slot);
    if place == 0 {
        return ();
    }
    authority := authority_of(&mut c, slot);
    index := resource(&mut c, slot);
    info := &c.resources[index - 1];
    base := info.base;
    ty := info.ty;
    if (authority != 0) & (base != 0) {
        loan := authority_loan(&mut c, authority, place);
        if loan == 0 {
            fail(&mut c, view("access has no live reference authority"));
        }
        if ownership::access_loan(&c.check, loan, place, 0) != 0 {
            fail(&mut c, view("reference access conflicts with active borrow"));
        }
    } else {
        if ownership::read(&c.check, place) != 0 {
            pointer_conflict(&mut c, place, view("use"), 1);
            fail_unusable(&mut c, place);
        }
    }
    k := ty_kind(&mut c, ty);
    if (k == 5) || (k == 7) || (k == 27) {
        mut checked = 0;
        // The bonds held by `place` or by a place it lies inside (bonds_sync): the holders are the
        // place's own chain of parents. The order they are visited in is not the list's, which no
        // answer depends on - each refusal is the same diagnostic at the same token.
        bonds_sync(&mut c);
        if c.bond_unranged != 0 {
            for i in c.bonds.len() {
                mut b = &c.bonds[i];
                h := b.holder;
                loan := b.loan;
                guard := b.guard;
                if (guard == 0) & ownership::ancestor(&c.check, h, place) {
                    if loan_live(&mut c, loan) != 0 {
                        checked = 1;
                        if ownership::use_loan(&c.check, loan, 0) != 0 {
                            fail(&mut c, view("reference is suspended or expired"));
                        }
                    }
                }
            }
        } else {
            mut h = place;
            if c.check.places.len() < place {
                h = 0;
            }
            while h != 0 {
                mut j = 0;
                if h < c.bond_hhead.len() {
                    j = c.bond_hhead[h];
                }
                while j != 0 {
                    loan := c.bonds[j - 1].loan;
                    guard := c.bonds[j - 1].guard;
                    if guard == 0 {
                        if loan_live(&mut c, loan) != 0 {
                            checked = 1;
                            if ownership::use_loan(&c.check, loan, 0) != 0 {
                                fail(&mut c, view("reference is suspended or expired"));
                            }
                        }
                    }
                    j = c.bond_hnext[j - 1];
                }
                h = c.check.places[h - 1].parent;
            }
        }
        if checked == 0 {
            fail(&mut c, view("reference lacks checked source"));
        }
    }
    return ();
}
fn inherit_guards<a>(c: (&a mut C), place: u64) -> unit {
    if place == 0 {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if holder != place {
            if ownership::ancestor(&c.check, holder, place) {
                bond_kind(&mut c, place, loan, 1);
            }
        }
    }
    return ();
}
fn capture_authority<a>(c: (&a mut C), place: u64) -> unit {
    if place == 0 {
        return ();
    }
    // The bonds of the live loans (bonds_sync): the rest cannot matter.
    bonds_sync(&mut c);
    ids := ownership::live_ids(&mut c.check);
    for n in ids.len() {
        loan := ids[n];
        mut j = 0;
        if loan < c.bond_head.len() {
            j = c.bond_head[loan];
        }
        while j != 0 {
            holder := c.bonds[j - 1].holder;
            guard := c.bonds[j - 1].guard;
            if guard == 0 {
                if ownership::ancestor(&c.check, place, holder) {
                    if ownership::use_loan(&c.check, loan, 0) != 0 {
                        fail(&mut c, view("captured authority is suspended"));
                    }
                }
            }
            j = c.bond_next[j - 1];
        }
    }
    return ();
}
fn alias_field<a>(c: (&a mut C), slot: u64, ty: u64, base: u64, field: u64, via: u64) -> Val {
    if c.raw == 0 {
        root := place_of(&mut c, base);
        place := member_place(&mut c, root, field, ty);
        authority := authority_of(&mut c, base);
        c
            .resources
            .push(
                Resource {
                    slot: slot,
                    ty: ty,
                    flag: 0,
                    base: base + 1,
                    field: field,
                    via: via,
                    place: place,
                    target: 0,
                    authority: authority,
                }
            );
        if contains_borrow(&mut c, ty, 0) {
            inherit_guards(&mut c, place);
        }
        stored_source(&mut c, slot, ty);
    }
    return val(slot, ty);
}
// A drop helper's symbol: `.D` and the first 64 bits of the SHA-256 of the type's canonical
// spelling, cached per type. A type index is a position in *this* run's table, and separate
// compilation cannot reproduce another run's table; the spelling is a function of the type alone,
// so two objects that both emit a helper for a type emit the same name for the same body.
// Whether the interface format has a spelling for this type. Asked by the two places that need a
// spelling rather than a name - a request line, which the defining module parses, and a diagnostic -
// so neither has to call the writer unguarded.
fn iface_spellable<a>(c: (&a mut C), ty: u64) -> bool {
    mut scratch = u8[];
    exchange(&mut c.spell_lenient, 1);
    exchange(&mut c.spell_failed, 0);
    iface_type_raw(&mut scratch, &mut c, ty);
    failed := c.spell_failed;
    exchange(&mut c.spell_lenient, 0);
    exchange(&mut c.spell_failed, 0);
    return failed == 0;
}
// A type's identity, spelled structurally and *totally*: every kind is answered, including one this
// compiler does not know, and nothing here can fail. That matters because a name is wanted in the
// middle of an ordinary build - a drop helper is referenced from every scope exit, a specialisation
// from every call - and a build must not fail because an optional serialisation has no spelling for
// a type.
//
// Everything it writes is a function of the type: the kind, its mode, its lifetime slots, the
// nominal name (or, for a synthesised environment record, the captures it holds), its type
// arguments, its payload when the payload is a type, and an interface's *name* for a proof. No
// index this run chose goes in, so two runs - and two modules of one program - compute the same key
// for the same type, whatever order they met it in.
//
// The interface writer keeps its own spelling and its own refusal: this describes a type, it does
// not promise an interface can carry one.
fn type_key<a>(c: (&a mut C), out: (&a mut u8[]), ty: u64, depth: u64) -> unit {
    k := ty_kind(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    out.push(40);
    decimal(&mut out, k);
    out.push(58);
    decimal(&mut out, mode);
    // The region numbers are part of a reference or view type's identity: `(&[1] T)` and `(&[2] T)`
    // are different types, and leaving them out made two helpers collide on one label.
    rs := type_regions(&mut c, ty);
    for i in rs.len() {
        out.push(47);
        decimal(&mut out, rs[i]);
    }
    if 16 < depth {
        // A store this deep is a cycle; the marker is still a function of the type and the cap
        // keeps the walk finite.
        push_bytes(&mut out, view(":~"));
        return ();
    }
    if (k == 8) || (k == 23) || (k == 28) {
        arg := ty_arg(&mut c, ty);
        mut module = c.decls[arg].module.copy();
        mut name = c.decls[arg].name.copy();
        count := c.decls[arg].count;
        first := c.decls[arg].first;
        out.push(32);
        if same(view(module), view(".closure")) {
            // An environment record is synthesised per program and named by registration order, so
            // its name is not a property of the type; its captures are.
            push_bytes(&mut out, view("(env"));
            // ...and the literal it was written as: a specialisation calls a closure's body
            // directly (a callable-bound `F`), so two closures with the same captures and signature
            // are two specialisations. The source position is the same for a literal synthesised
            // twice, so that still keys one.
            for j in c.closures.len() {
                if c.closures[j].decl == arg {
                    out.push(64);
                    decimal(&mut out, c.closures[j].file);
                    out.push(58);
                    decimal(&mut out, c.closures[j].start);
                    break;
                }
            }
            for i in count {
                field_ty := c.fields[first + i].ty;
                out.push(32);
                type_key(&mut c, &mut out, field_ty, depth + 1);
            }
            push_bytes(&mut out, view(")"));
        } else {
            push_bytes(&mut out, view(module));
            push_bytes(&mut out, view("::"));
            push_bytes(&mut out, view(name));
        }
    }
    args := type_args(&mut c, ty);
    for i in args.len() {
        out.push(32);
        type_key(&mut c, &mut out, args[i], depth + 1);
    }
    arg := ty_arg(&mut c, ty);
    if (k == 6) || (k == 7) || (k == 10) || (k == 11) || (k == 12) || (k == 13) || (k == 14) || (k == 16) || (k == 20)
        || (k == 25) || (k == 26) || (k == 27) || (k == 32) || (k == 36) {
        // The payload is a type.
        out.push(32);
        type_key(&mut c, &mut out, arg, depth + 1);
    } else if k == 15 {
        // A proof names an interface; the id is a position in this program's interface table, so the
        // interface's own name goes in instead.
        out.push(32);
        mut module = c.interfaces[arg - 1].module.copy();
        mut name = c.interfaces[arg - 1].name.copy();
        push_bytes(&mut out, view(module));
        push_bytes(&mut out, view("::"));
        push_bytes(&mut out, view(name));
    } else if (k == 1) || (k == 2) || (k == 3) || (k == 4) || (k == 5) || (k == 17) || (k == 19)
        || (k == 22) || (k == 24) {
        // No payload of its own: the kind, the mode and the regions are the whole type. A view is
        // here rather than with the payload kinds because the interface format spells it without an
        // element and its drop does not depend on one either.
    } else if (k == 8) || (k == 23) || (k == 28) {
        // The nominal payload is already in the key.
    } else if (k == 18) || (k == 21) || (k == 31) {
        // An integer or float width is part of the type and is not a run-local choice.
        out.push(32);
        decimal(&mut out, arg);
    } else if k == 9 {
        // A type parameter's slot number is what the declaration counts, not what this run chose.
        out.push(32);
        decimal(&mut out, arg);
    } else if k == 33 {
        // An interface object: the interface by name, not by this run's index.
        out.push(32);
        push_bytes(&mut out, view(c.interfaces[arg - 1].module));
        push_bytes(&mut out, view("::"));
        push_bytes(&mut out, view(c.interfaces[arg - 1].name));
    } else {
        // A store extension this compiler does not know. Its payload is a type if the number points
        // into the type table, so walk it; either way the kind, the mode, the regions and the
        // arguments above are a function of the type, and the emitter's code for an unknown kind
        // depends on nothing else.
        if arg < c.types.len() {
            out.push(32);
            type_key(&mut c, &mut out, arg, depth + 1);
        } else {
            out.push(32);
            decimal(&mut out, arg);
        }
    }
    env := ty_env(&mut c, ty);
    if env != 0 {
        out.push(32);
        type_key(&mut c, &mut out, env, depth + 1);
    }
    out.push(41);
    return ();
}
// Note what an `impl Drop` covers. A self type that is the declaration applied to its own parameters
// in order covers every instantiation of it, so the declaration carries the bit; anything else
// (`impl Drop for Box<u64>`, or a generic implementation on one type argument) is left to the
// implementation table, which is only scanned when such an implementation exists.
fn drop_impl_registered<a>(c: (&a mut C), ty: u64) -> unit {
    mut counted = 0;
    if ty_kind(&mut c, ty) == 8 {
        d := ty_arg(&mut c, ty);
        params := c.decls[d].types;
        args := type_args(&mut c, ty);
        mut every = (args.len() == params) & (args.len() != 0);
        for i in args.len() {
            a := args[i];
            if (ty_kind(&mut c, a) != 9) || (ty_arg(&mut c, a) != i) {
                every = false;
            }
        }
        if every || (params == 0) {
            item := &mut c.decls[d];
            exchange(&mut item.drop, 1);
            return ();
        }
        counted = 1;
    }
    if counted != 0 {
        exchange(&mut c.drop_generic, c.drop_generic + 1);
    }
    return ();
}
// 1 when `ty` is a record whose type has an `impl Drop` in this program - the declaration's bit when
// the implementation covers every instantiation of it, and the implementation table for the rest
// (`impl<T> Drop for Box<T>`, `impl Drop for Box<u64>`). Nothing is scanned in a program without one.
fn drop_type<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(&mut c, ty) != 8 {
        return 0;
    }
    if c.decls[ty_arg(&mut c, ty)].drop != 0 {
        return 1;
    }
    if c.drop_generic == 0 {
        return 0;
    }
    if find_implementation(&mut c, c.drop_iface, ty) == 0 {
        return 0;
    }
    return 1;
}
// The user `drop` a type's characters calls, as a linker symbol, or empty when it has none. A
// generic implementation answers for every instantiation its pattern matches, and the name is the
// specialisation's - the body is emitted by the normal specialisation drain, which runs after this.
fn drop_hook_symbol<a>(c: (&a mut C), ty: u64) -> u8[] {
    if (c.drop_iface == 0) || (drop_type(&mut c, ty) == 0) {
        return u8[];
    }
    actual := resolve_interface_method(&mut c, c.drop_iface, ty, view("drop"));
    mut label = c.funcs[actual].name.copy();
    if c.funcs[actual].types != 0 {
        if !concrete_type(&mut c, ty) {
            return u8[];
        }
        // A generic implementation's parameters are the declaration's own, in order, so the type's
        // arguments are the bindings. (`interface_symbol` would ask the match for them, and a match
        // whose arguments are themselves type parameters - the body of a generic function - binds
        // nothing, because the two parameter slots compare equal.)
        base := base_type(&mut c, ty);
        mut bindings = type_args(&mut c, base);
        if bindings.len() != c.funcs[actual].types {
            fail(&mut c, view("a Drop implementation's parameters must be the type's own"));
        }
        spec := specialize(&mut c, actual, &bindings);
        label = special_name(&mut c, spec);
    }
    // stays: `c.funcs[actual]` is a borrowed element (non-numeric), so this read is a loan that
    // conflicts with `&mut c`; only a plain copy of a field is covered by two-phase.
    module := c.funcs[actual].module.copy();
    unit := symbol_unit(&mut c, view(module));
    return body_label(&c, view(unit), view(label), view(""), 0);
}
// drop_symbol's memo filled for `ty`, without a copy of the name.
fn drop_symbol_known<a>(c: (&a mut C), ty: u64) -> unit {
    if (ty < c.drop_names.len()) && (c.drop_names[ty].len() != 0) {
        return ();
    }
    drop_symbol(&mut c, ty);
    return ();
}
// A struct's or tuple's in-place drop (unboxed-values.md, stage 4): the user's `drop`, then the
// owners its words hold, at their offsets from the address in %rdi; it frees nothing. The boxed
// helper (`drop_symbol`) is this and `rt_free`; a record held inline - in a frame, in another
// record's words, flat in a vector - is dropped by this alone. For an array the helper already is
// in place, so its name is the array's drop symbol.
fn drop_in_place_symbol<a>(c: (&a mut C), ty: u64) -> u8[] {
    if is_array(&mut c, ty) {
        return drop_symbol(&mut c, ty);
    }
    mut name = drop_symbol(&mut c, ty);
    name[1] = 80;
    return name;
}
// Whether `ty` has a separate in-place drop: a Grail struct or tuple (not an enum, whose payload
// is a word, nor a C record, whose bytes own nothing).
fn in_place_record<a>(c: (&a mut C), ty: u64) -> bool {
    if ty_kind(&mut c, ty) != 8 {
        return false;
    }
    index := ty_arg(&mut c, ty);
    d := &c.decls[index];
    return (d.is_enum == 0) && (d.c_layout == 0);
}
fn drop_symbol<a>(c: (&a mut C), ty: u64) -> u8[] {
    while c.drop_names.len() <= ty {
        c.drop_names.push(u8[]);
    }
    if c.drop_names[ty].len() != 0 {
        return c.drop_names[ty].copy();
    }
    mut key = u8[];
    type_key(&mut c, &mut key, ty, 0);
    // The user's `drop` is part of what the helper does, so it is part of the key: two objects that
    // both know the implementation emit one body and the linker merges them, and an object that
    // never saw the implementation cannot be handed a helper that silently skips it.
    hook := drop_hook_symbol(&mut c, ty);
    if hook.len() != 0 {
        push_bytes(&mut key, view(" drop "));
        push_bytes(&mut key, view(hook));
    }
    mut name = u8[];
    push_bytes(&mut name, view(".D"));
    digest := iface_digest(&key);
    for i in 16 {
        name.push(digest[i]);
    }
    exchange(&mut c.drop_names[ty], name.copy());
