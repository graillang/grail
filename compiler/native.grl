 if c.raw{return ();}index :=resource(borrow_mut(c),slot);if index==0{fail(borrow_mut(c),read("mutation target is not tracked"));}
 var r =vec_get(c.resources,index-1);ty :=r.ty;place :=r.place;authority :=r.authority;target :=r.target;
 k :=ty_kind(borrow_mut(c),ty);
 if (k==7)&(place==0){
 if authority!=0{var r =resource(borrow_mut(c),authority-1);info :=vec_get(c.resources,r-1);ty :=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),read("write through readonly frame"));}
 loan :=authority_loan(borrow_mut(c),authority,target);if loan==0{fail(borrow_mut(c),read("field write has no authority"));}if ownership::access_loan(borrow(c.check),loan,target,1)!=0{fail(borrow_mut(c),read("field write conflicts with active loan"));}}
 else{if ownership::initialize(borrow_mut(c.check),target)!=0{fail(borrow_mut(c),read("field assignment conflicts with live borrow or moved storage"));}}return ();}
 if (k==5)+(k==7){if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),read("mutation through readonly reference"));}var allowed=0;
 for i in len(c.bonds){var b =vec_get(c.bonds,i);holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if (guard==0)&ownership::ancestor(borrow(c.check),holder,place){if loan_live(borrow_mut(c),loan){allowed=1;if ownership::use_loan(borrow(c.check),loan,1)!=0{fail(borrow_mut(c),read("write authority is suspended"));}}}}if allowed==0{fail(borrow_mut(c),read("write lacks checked source"));}
 }else{
 if authority!=0{var r =resource(borrow_mut(c),authority-1);info :=vec_get(c.resources,r-1);ty :=info.ty;if ty_mode(borrow_mut(c),ty)==0{fail(borrow_mut(c),read("mutation through readonly frame"));}
 loan :=authority_loan(borrow_mut(c),authority,place);if loan==0{fail(borrow_mut(c),read("write has no reference authority"));}
 if ownership::access_loan(borrow(c.check),loan,place,1)!=0{fail(borrow_mut(c),read("write conflicts with active loan"));}
 }else{loan :=ownership::borrow_place(borrow_mut(c.check),place,1);if loan==0{fail(borrow_mut(c),read("mutation conflicts with live borrow"));}ownership::end_loan(borrow_mut(c.check),loan);}}
 return ();
}
fn region_of<a>(c:ref_mut<a,C>,place:num)->num {
 for i in len(c.origins){o :=vec_get(c.origins,i);root :=o.place;region :=o.region;
 if ownership::ancestor(borrow(c.check),root,place){return region;}}
 return 0;
}
fn external_place<a>(c:ref_mut<a,C>,region:num,copy:num)->num {
 p :=ownership::root(borrow_mut(c.check),copy,1);vec_push(c.origins,Origin{place:p,region:region});return p;
}
fn add_external_capture<a>(c:ref_mut<a,C>,holder:num,region:num,mode:num)->num {
 source :=external_place(borrow_mut(c),region,0);loan :=ownership::borrow_place(borrow_mut(c.check),source,mode);
 bond(borrow_mut(c),holder,loan);return source;
}
fn init_parameter<a>(c:ref_mut<a,C>,slot:num,ty:num)->unit {
 if c.raw{return ();}holder :=place_of(borrow_mut(c),slot);k :=ty_kind(borrow_mut(c),ty);
 var rs =type_regions(borrow_mut(c),ty);mode :=ty_mode(borrow_mut(c),ty);
 if (k==5)+(k==7){
 if len(rs)!=1{fail(borrow_mut(c),read("parameter requires a declared lifetime"));}
 var r =load(vec_get(rs,0));source :=add_external_capture(borrow_mut(c),holder,r,mode);
 if k==7{set_target(borrow_mut(c),slot,source,slot+1);}return ();}
 captures :=type_caps(borrow_mut(c),ty,0);
 for i in len(captures){var r =load(vec_get(captures,i));target :=external_place(borrow_mut(c),r,0);loan :=ownership::borrow_place(borrow_mut(c.check),target,0);bond_kind(borrow_mut(c),holder,loan,1);}return ();
}
fn has_bonds<a>(c:ref_mut<a,C>,holder:num)->num {
 for i in len(c.bonds){var b =vec_get(c.bonds,i);h :=b.holder;guard :=b.guard;loan :=b.loan;if (h==holder)&(guard==0){if loan_live(borrow_mut(c),loan){return 1;}}}return 0;
}
// Stored captures in an abstract input referent have their declared data lifetime,
// distinct from the lifetime of the outer reference frame.
fn stored_source<a>(c:ref_mut<a,C>,slot:num,ty:num)->unit {
 place :=place_of(borrow_mut(c),slot);if place==0{return ();}
 k :=ty_kind(borrow_mut(c),ty);if (k!=5)&(k!=7){return ();}
 if has_bonds(borrow_mut(c),place){if k==7{
 for i in len(c.bonds){var b =vec_get(c.bonds,i);holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if (holder==place)&(guard==0){if loan_live(borrow_mut(c),loan){var l =vec_get(c.check.loans,loan-1);source :=l.source;authority :=authority_of(borrow_mut(c),slot);set_target(borrow_mut(c),slot,source,authority);break;}}}}return ();}
 var guarded=0;n :=len(c.bonds);
 for i in n{var b =vec_get(c.bonds,i);holder :=b.holder;loan :=b.loan;guard :=b.guard;
 if guard{if loan_live(borrow_mut(c),loan){if ownership::ancestor(borrow(c.check),holder,place){bond_kind(borrow_mut(c),place,loan,guard);guarded=1;}}}}
 if guarded{
 mode :=ty_mode(borrow_mut(c),ty);source :=external_place(borrow_mut(c),18446744073709551615,0);loan :=ownership::borrow_place(borrow_mut(c.check),source,mode);bond(borrow_mut(c),place,loan);
 if k==7{var authority=authority_of(borrow_mut(c),slot);var r =resource(borrow_mut(c),slot);info :=vec_get(c.resources,r-1);if info.base==0{authority=slot+1;}set_target(borrow_mut(c),slot,source,authority);}return ();}
 if region_of(borrow_mut(c),place)==0{return ();}
 var rs =type_regions(borrow_mut(c),ty);if len(rs)!=1{fail(borrow_mut(c),read("stored capture lifetime missing"));}
 var r =load(vec_get(rs,0));mode :=ty_mode(borrow_mut(c),ty);target :=add_external_capture(borrow_mut(c),place,r,mode);
 if k==7{authority :=authority_of(borrow_mut(c),slot);set_target(borrow_mut(c),slot,target,authority);}return ();
