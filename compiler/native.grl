                if (ty_kind(&mut c, recv) == 8) & (ty_arg(&mut c, recv) == owner - 1) {
                    return 1;
                }
            }
        }
    }
    // A method of a written-type impl (`impl u64[]`, `impl<T> T[]`) whose receiver is `&mut self`.
    m := inherent_method_for(&mut c, recv, view(name));
    if m != 0 {
        f := &c.funcs[m - 1];
        if f.count != 0 {
            pty := c.params[f.first];
            if (ty_kind(&mut c, pty) == 7) & (ty_mode(&mut c, pty) != 0) {
                return 1;
            }
        }
    }
    return 0;
}
// The type of field `name` of a value of type `ty`, or 0 when `ty` is not a struct with that field.
fn field_type_named<a, b>(c: (&a mut C), ty: u64, name: &b [u8]) -> u64 {
    if (ty == 0) || (ty_kind(&mut c, ty) != 8) {
        return 0;
