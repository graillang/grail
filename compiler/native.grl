    }
    if through != 0 {
        storage_bonds(&mut c, source, destination);
        move_out(&mut c, val(v.t, v.ty));
    }
    if through == 0 {
        old := resource(&mut c, target);
        if old != 0 {
            release(&mut c, old - 1);
        }
    }
    // An embedded C record's old bytes are plain data, overwritten in place (no drop). The place
    // is either the interior address itself (an address slot) or the proxy slot that holds it.
    embedded := ((is_c_record(&mut c, fieldty) != 0)
        & ((caddr_ty(&mut c, target) != 0) | embedded_place(&mut c, target)))
        | (framed(&mut c, fieldty) & embedded_place(&mut c, target));
    // An inline record that owns something is dropped in place before its words are replaced.
    if through != 0 && (!embedded || frame_drops(&mut c, fieldty)) {
        if needs_drop(&mut c, fieldty) {
            get(&mut c, target, view("%rax"));
            o(&mut c, view("movq (%rax),%rdi\n"));
            drop_call(&mut c, fieldty);
        }
    }
    narrow_store := caddr_ty(&mut c, target) * through;
    if narrow_store != 0 {
        caddr_store(&mut c, target, narrow_store, v.t);
        return ();
    }
    if through != 0 {
        ref_store(&mut c, target, fieldty, v.t);
    } else if is_simd(&mut c, ty) & (c.raw == 0) {
        // A vector's lanes go into the storage the variable already has, as an array's bytes do:
        // one vector copy, so the variable's storage is one object every access types alike and
        // LLVM keeps it in a register (a rebinding to fresh words made the variable's address a
        // phi of two allocas, which SROA cannot split).
        simd_copy_to(&mut c, target, v.t, ty);
        place := place_of(&mut c, target);
        if place != 0 {
            ownership::initialize(&mut c.check, place);
        }
    } else if is_array(&mut c, ty) {
        // An array's bytes go into the storage the variable already has: the value's storage (a
        // literal's, say) is made again by its own site, so the variable never shares it. What it
        // owned was dropped by the release above; its drop flag is set again for what it owns now.
        array_copy(&mut c, target, v.t, array_bytes(&mut c, ty));
        old := resource(&mut c, target);
        if old != 0 {
            flag := c.resources[old - 1].flag;
            place := place_of(&mut c, target);
            if place != 0 {
                ownership::initialize(&mut c.check, place);
            }
            if flag != 0 {
                o(&mut c, view("movq $1,"));
                stack_slot(&mut c, flag - 1);
                c.out.push(10);
            }
        }
    } else {
        if framed(&mut c, v.ty) {
            // The binding gets words of its own: the value's may be a temporary of a site that runs
            // again while the binding still holds it (`prev = cur; cur = f(cur)`).
            materialise(&mut c, v.t, v.ty);
            copy := frame_copy(&mut c, v.t, v.ty);
            get(&mut c, copy, view("%rax"));
            o(&mut c, view("movq %rax,"));
            stack_slot(&mut c, v.t);
            c.out.push(10);
        }
        get(&mut c, v.t, view("%rax"));
        o(&mut c, view("movq %rax,"));
        stack_slot(&mut c, target);
        c.out.push(10);
        old := resource(&mut c, target);
        if old != 0 {
            mut r = &c.resources[old - 1];
            flag := r.flag;
            place := place_of(&mut c, target);
            if place != 0 {
                ownership::initialize(&mut c.check, place);
            }
            if flag != 0 {
                o(&mut c, view("movq $1,"));
                stack_slot(&mut c, flag - 1);
                c.out.push(10);
            }
        }
    }
    if through == 0 {
        transfer_bonds(&mut c, source, destination);
        newtarget := target_of(&mut c, v.t);
        move_out(&mut c, val(v.t, v.ty));
        if ty_kind(&mut c, ty) == 7 {
            set_target(&mut c, target, newtarget, target + 1);
        }
    }
    return ();
}
// A temporary scrutinee reference (`match &s`) lives in each arm only as long as the
// payload references bound from it: it becomes a hidden local that expires at the first
// statement boundary where nothing borrows from it, so the arm may then modify `s`.
fn arm_scrutinee<a>(c: (&a mut C), slot: u64, ty: u64) -> unit {
    if c.raw != 0 {
        return ();
    }
    if is_local_slot(&mut c, slot) {
        return ();
    }
    if resource(&mut c, slot) == 0 {
        return ();
    }
    c
        .locals
        .push(
            Local {
                name: copy_bytes(view(".scrutinee")),
                ty: ty,
                id: slot,
                last: c.pos,
                born: c.pos,
                mutable: 0,
                flex: 0,
                lit: 0,
                neg: 0,
                origin: 0,
                at: 0,
            }
        );
    return ();
}
// Whether a read of local index i still denotes its literal. A mutable binding qualifies only
// before any assignment can have run: not inside a loop opened after its declaration.
fn flex_read<a>(c: (&a mut C), i: u64) -> bool {
    l := &c.locals[i];
    if l.flex == 0 {
        return false;
    }
    if l.mutable == 0 {
        return true;
    }
    return c.loop_start < l.born + 1;
}
fn commit_flex<a>(c: (&a mut C), i: u64) -> unit {
    mut l = &mut c.locals[i];
    if l.mutable != 0 {
        exchange(&mut l.flex, 0);
    }
    return ();
}
// First assignment of a flexible mutable local: a sized integer value fixes its type.
fn settle_flex<a>(c: (&a mut C), i: u64, value_ty: u64) -> u64 {
    l := &c.locals[i];
    ty := l.ty;
    flex := l.flex;
    lit := l.lit;
    neg := l.neg;
    id := l.id;
    if flex == 0 {
        return ty;
    }
    mut out = ty;
    if flex == 1 {
        if (value_ty != ty) & literal_target(&mut c, value_ty) {
            if literal_fits(&mut c, value_ty, lit, neg) != 0 {
                out = value_ty;
            }
        }
    }
    // A float literal binding settling as f32 holds the literal rounded to binary32 from its text.
    // Only while the slot still holds the binary64 literal (no f32 value can equal a literal that
    // binary32 cannot represent), so a first assignment inside a loop converts it once.
    if (flex == 2) & is_f32(&mut c, value_ty) {
        out = value_ty;
        text := tok_text(&mut c, lit);
        mut wide = float_bits_p(&mut c, view(text), 53);
        mut narrow = float_bits_p(&mut c, view(text), 24);
        if neg != 0 {
            wide = wide ^ 9223372036854775808;
            narrow = narrow ^ 9223372036854775808;
        }
        if wide != narrow {
            done := label(&mut c);
            o(&mut c, view("movabsq $"));
            on(&mut c, wide);
            o(&mut c, view(",%rcx\n"));
            get(&mut c, id, view("%rax"));
            o(&mut c, view("cmpq %rcx,%rax\n"));
            jump(&mut c, view("jne"), done);
            o(&mut c, view("movabsq $"));
            on(&mut c, narrow);
            o(&mut c, view(",%rax\nmovq %rax,"));
            stack_slot(&mut c, id);
            c.out.push(10);
            mark(&mut c, done);
        }
    }
    mut m = &mut c.locals[i];
    exchange(&mut m.flex, 0);
    exchange(&mut m.ty, out);
    if out != ty {
        exchange(&mut m.origin, 0);
    }
    return out;
}
fn find_hint<a>(c: (&a mut C), at: u64) -> u64 {
    mut i = 0;
    while i + 1 < c.hints.len() {
        if c.hints[i] == at {
            return c.hints[i + 1] + 1;
        }
        i += 2;
    }
    return 0;
}
// `show(count)` where count is a committed literal binding and show wants a u8: remember that
// count should have been a u8 and finish this attempt tolerantly; the function is recompiled.
fn hint_use<a>(c: (&a mut C), v: Val, start: u64, end: u64, expected: u64) -> Val {
    if (c.raw != 0) || (c.cf_local == 0) {
        return v;
    }
    // A `&dyn I` is never taken from a hint: its value is the pair borrow_dyn builds, so retyping a
    // reference here would hand the checker a handle the code never made.
    if borrowed_object(&mut c, expected) != 0 {
        return v;
    }
    if (c.cf_start != start) || (c.cf_end != end) {
        return v;
    }
    if v.ty == expected {
        return v;
    }
    if 3 < c.attempts {
        return v;
    }
    // `cf_local` is an index into the locals of the function that recorded it. The record is
    // cleared wherever those locals or the token positions are replaced, so reaching this point
    // with a dead index would be a compiler bug; say so instead of faulting the process.
    if c.locals.len() < c.cf_local {
        fail(
            &mut c,
            view(
                "internal compiler error: a literal-type hint refers to a local binding that is no longer live"
            )
        );
    }
    l := &c.locals[c.cf_local - 1];
    origin := l.origin;
    at := l.at;
    lit := l.lit;
    neg := l.neg;
    mut ok = 0;
    if (origin == 1) & literal_target(&mut c, expected) {
        ok = literal_fits(&mut c, expected, lit, neg);
    }
    if (origin == 2) & is_f32(&mut c, expected) {
        ok = 1;
    }
    if ok == 0 {
        return v;
    }
    if find_hint(&mut c, at) == 0 {
        c.hints.push(at);
        c.hints.push(expected);
        exchange(&mut c.retry, 1);
        exchange(&mut c.tolerant, 1);
    }
    return val(v.t, expected);
}
// `match` on a scrutinee: integer/bool, enum/optional/union, or a record. The arm list, the
// per-arm ownership snapshots and the join are the same whichever kind of value is matched;
// an expression `match` (docs/design/match-expression-arms.md) only changes what an arm body
// does with its value (c.arm_slot).
fn match_statement<a>(c: (&a mut C)) -> unit {
    // Matching through a reference (`match self`) inspects the value in place: payloads are bound
    // as references of the same mode instead of being moved out.
    scrut_at := c.pos;
    s := expr(&mut c, 0);
    scrut_end := c.pos;
    // The term an arm's pattern is about: the scrutinee's own name or literal, when the source
    // spells one. The scrutinee may also call, which states nothing for the arms.
    mut scrut_term = u8[];
    if c.pv_on != 0 {
        scrut_term = pv_span_term(&mut c, scrut_at, scrut_end);
    }
    pv_ir_statement(&mut c, scrut_at, scrut_end);
    sty := s.ty;
    sslot := s.t;
    mut byref = 0;
    mut refmode = 0;
    if c.raw == 0 {
        if integer(&mut c, sty)
            || is_bool(&mut c, sty)
            || is_char(&mut c, sty) {
            scalar_match(&mut c, s, scrut_term);
            return ();
        }
    }
    if c.raw == 0 {
        if ty_kind(&mut c, sty) == 7 {
            byref = 1;
            refmode = ty_mode(&mut c, sty);
        }
    }
    x := deref(&mut c, s);
    xt := x.t;
    if ty_kind(&mut c, x.ty) != 8 {
        fail(&mut c, view("match requires an enum, integer or bool"));
    }
    d := ty_arg(&mut c, x.ty);
    count := c.decls[d].count;
    if c.decls[d].is_enum == 0 {
        record_match(&mut c, sslot, sty, x, byref, refmode);
        return ();
    }
    tag := rec_load(&mut c, xt, 0, 0);
    if byref == 0 {
        move_out(&mut c, val(xt, x.ty));
    }
    // A by-value scrutinee that holds a loan, such as the optional reference of `match m.get(&k)`, ends
    // its loan in each arm once no payload reference is live, like a `match &s` scrutinee: the
    // `None` arm may then modify `m`.
    borrowed := byref == 0 && c.raw == 0 && contains_borrow(&mut c, x.ty, 0);
    before := ownership::snapshot(&c.check);
    mut exits = ownership::new();
    mut have = 0;
    mut seen = u64[];
    mut default = 0;
    end := label(&mut c);
    expect(&mut c, view("{"));
    while !eat(&mut c, view("}")) {
        ownership::restore(&mut c.check, &before);
        exchange(&mut c.terminated, 0);
        mut name = u8[];
        mut binder = u8[];
        mut pattern = 0;
        mut union_arm = 0;
        if is(&mut c, view("_")) {
            advance(&mut c);
            name = copy_bytes(view("_"));
        } else {
            if is_union(&mut c, x.ty) {
                union_arm = 1;
                p := c.pos;
                if (kind_at(&mut c, p) == 1) & is_at(&mut c, p + 1, view(":")) {
                    binder = ident(&mut c);
                    expect(&mut c, view(":"));
                }
                pattern = parse_type(&mut c);
            } else {
                name = ident(&mut c);
                if is(&mut c, view("{")) {
                    fail(&mut c, view("a record pattern needs a record value"));
                }
            }
        }
        // `_ =>` covers the remaining variants; an owned value is dropped there.
        if same(view(name), view("_")) {
            if default != 0 {
                fail(&mut c, view("duplicate _ arm"));
            }
            default = 1;
            mark := c.locals.len();
            payloads := c.resources.len();
            if byref == 0 {
                get(&mut c, xt, view("%rdi"));
                drop_call(&mut c, x.ty);
            }
            expect(&mut c, view("=>"));
            if byref != 0 || borrowed {
                arm_scrutinee(&mut c, sslot, sty);
            }
            arm_body(&mut c);
            cleanup(&mut c, payloads);
            pop_locals(&mut c, mark);
            if c.terminated == 0 {
                edge := ownership::snapshot(&c.check);
                if have != 0 {
                    ownership::merge(&mut exits, &edge);
                } else {
                    exits = edge;
                    have = 1;
                }
            }
            jump(&mut c, view("jmp"), end);
            if !eat(&mut c, view(",")) {
                expect(&mut c, view("}"));
                break;
            }
            continue;
        }
        if default != 0 {
            fail(&mut c, view("_ arm must be last"));
        }
        mut k = 0;
        if union_arm != 0 {
            args := type_args(&mut c, x.ty);
            mut found = 0;
            for i in args.len() {
                if same_type(&mut c, pattern, args[i]) != 0 {
                    found += 1;
                    k = i;
                }
            }
            if found == 0 {
                fail(&mut c, view("type is not a union member"));
            }
            if found > 1 {
                fail(&mut c, view("ambiguous union match"));
            }
        } else {
            k = find_field(&mut c, d, view(name));
        }
        for i in seen.len() {
            if seen[i] == k {
                fail(&mut c, view("duplicate match arm"));
            }
        }
        seen.push(k);
        pty := field_type(&mut c, x.ty, k);
        mut next = label(&mut c);
        get(&mut c, tag, view("%rax"));
        o(&mut c, view("cmpq $"));
        on(&mut c, k);
        o(&mut c, view(",%rax\n"));
        jump(&mut c, view("jne"), next);
        mark := c.locals.len();
        payloads := c.resources.len();
        if byref != 0 {
            mut b = binder;
            if eat(&mut c, view("(")) {
                if !eat(&mut c, view("_")) {
                    b = ident(&mut c);
                }
                expect(&mut c, view(")"));
            }
            if b.len() != 0 {
                if scalar(&mut c, pty) {
                    value := rec_load(&mut c, xt, 1, 0);
                    bind(&mut c, b, pty, value, 0);
                } else {
                    at := payload_ref_word(&mut c, xt, x.ty, pty);
                    n := payload_reference(&mut c, at, x.ty, pty);
                    refty := reference_type(&mut c, pty, refmode);
                    root := place_of(&mut c, xt);
                    target := member_place(&mut c, root, 1, pty);
                    authority := authority_of(&mut c, xt);
                    c
                        .resources
                        .push(
                            Resource {
                                slot: n,
                                ty: refty,
                                flag: 0,
                                base: xt + 1,
                                field: 1,
                                via: 1,
                                place: 0,
                                target: target,
                                authority: authority,
                            }
                        );
                    r := borrow_reference(&mut c, n, refty, xt, target, refmode);
                    bind(&mut c, b, r.ty, r.t, 0);
                }
            }
        } else {
            payload := payload_load(&mut c, xt, x.ty, pty);
            own(&mut c, payload, pty);
            source := place_of(&mut c, xt);
            dest := place_of(&mut c, payload);
            if contains_borrow(&mut c, pty, 0) {
                transfer_bonds(&mut c, source, dest);
            }
            stored_source(&mut c, payload, pty);
            free_enum_shell(&mut c, xt, x.ty);
            mut b = binder;
            if eat(&mut c, view("(")) {
                if !eat(&mut c, view("_")) {
                    b = ident(&mut c);
                }
                expect(&mut c, view(")"));
            }
            if b.len() != 0 {
                bind(&mut c, b, pty, payload, 0);
            }
        }
        expect(&mut c, view("=>"));
        if byref != 0 || borrowed {
            arm_scrutinee(&mut c, sslot, sty);
        }
        arm_body(&mut c);
        cleanup(&mut c, payloads);
        pop_locals(&mut c, mark);
        if c.terminated == 0 {
            edge := ownership::snapshot(&c.check);
            if have != 0 {
                ownership::merge(&mut exits, &edge);
            } else {
                exits = edge;
                have = 1;
            }
        }
        jump(&mut c, view("jmp"), end);
        mark(&mut c, next);
        if !eat(&mut c, view(",")) {
            expect(&mut c, view("}"));
            break;
        }
    }
    if (seen.len() != count) & (default == 0) {
        fail(&mut c, view("non-exhaustive match"));
    }
    if default != 0 && seen.len() == count {
        fail(&mut c, view("unreachable _ arm (all variants are covered)"));
    }
    call_out(&mut c, view("rt_abort"));
    mark(&mut c, end);
    if have != 0 {
        ownership::restore(&mut c.check, &exits);
        exchange(&mut c.terminated, 0);
    } else {
        exchange(&mut c.terminated, 1);
    }
    return ();
}
fn stmt<a>(c: (&a mut C)) -> unit {
    if c.raw == 0 {
        if c.terminated != 0 {
            fail(&mut c, view("unreachable statement after transfer"));
        }
    }
    mark := c.resources.len();
    statement(&mut c);
    expire_locals(&mut c);
    mut i = c.resources.len();
    while mark < i {
        i = i - 1;
        mut r = &c.resources[i];
        slot := r.slot;
        release_temporary(&mut c, slot);
    }
    close_loans(&mut c);
    return ();
}
fn host_fn_unsafe<a, b>(c: (&a mut C), name: &b [u8], ret: u64) -> unit {
    host_fn(&mut c, name, ret);
    last := c.funcs.len() - 1;
    c.funcs[last].unsafe_fn = 1;
    return ();
}
fn host_fn<a, b>(c: (&a mut C), name: &b [u8], ret: u64) -> unit {
    first := c.params.len();
    if same(view(name), view("arg")) || same(view(name), view("print_num")) {
        c.params.push(0);
    }
    if same(view(name), view("read_file")) || same(view(name), view("print")) {
        c.params.push(4);
    }
    if same(view(name), view("write_file")) {
        c.params.push(4);
        c.params.push(4);
    }
    if same(view(name), view("command")) || same(view(name), view("command_with")) {
        ty := intern(&mut c, 6, 2);
        c.params.push(ty);
        if same(view(name), view("command_with")) {
            c.params.push(ty);
        }
    }
    if same(view(name), view("sleep_ms")) || same(view(name), view("close")) {
        c.params.push(0);
    }
    // lib/sync.grl's waits (runtime.grl, "RwLock", "Semaphore", "Condition", "Once") take an
    // address and up to three more words; the first is pushed with the one-word functions below.
    if same(view(name), view("mutex_lock_until"))
        || same(view(name), view("rw_try"))
        || same(view(name), view("rw_unlock"))
        || same(view(name), view("rw_release"))
        || same(view(name), view("sem_try"))
        || same(view(name), view("cond_notify"))
        || same(view(name), view("latch_wait"))
        || same(view(name), view("barrier_wait"))
        || same(view(name), view("rw_lock"))
        || same(view(name), view("sem_acquire"))
        || same(view(name), view("cond_wait")) {
        c.params.push(0);
    }
    if same(view(name), view("latch_wait"))
        || same(view(name), view("barrier_wait"))
        || same(view(name), view("rw_lock"))
        || same(view(name), view("sem_acquire"))
        || same(view(name), view("cond_wait")) {
        c.params.push(0);
    }
    if same(view(name), view("rw_lock"))
        || same(view(name), view("sem_acquire"))
        || same(view(name), view("cond_wait")) {
        c.params.push(0);
    }
    // The plumbing of lib/thread.grl (runtime.grl, "dedicated threads"): each takes a thread
    // record's address, except thread_local, which takes a key.
    if same(view(name), view("thread_start"))
        || same(view(name), view("thread_keep"))
        || same(view(name), view("thread_detach"))
        || same(view(name), view("thread_wait"))
        || same(view(name), view("thread_release"))
        || same(view(name), view("thread_failure"))
        || same(view(name), view("thread_refail"))
        || same(view(name), view("thread_local"))
        || same(view(name), view("mutex_try_lock"))
        || same(view(name), view("mutex_unlock"))
        || same(view(name), view("mutex_lock_recover"))
        || same(view(name), view("mutex_unlock_recover"))
        || same(view(name), view("mutex_poisoned"))
        || same(view(name), view("once_begin"))
        || same(view(name), view("once_done"))
        || same(view(name), view("sem_give"))
        || same(view(name), view("sem_node"))
        || same(view(name), view("rw_poisoned"))
        || same(view(name), view("try_sleep_ms"))
        || same(view(name), view("latch_down"))
        || same(view(name), view("mutex_lock_until"))
        || same(view(name), view("rw_try"))
        || same(view(name), view("rw_unlock"))
        || same(view(name), view("rw_release"))
        || same(view(name), view("sem_try"))
        || same(view(name), view("cond_notify"))
        || same(view(name), view("latch_wait"))
        || same(view(name), view("barrier_wait"))
        || same(view(name), view("rw_lock"))
        || same(view(name), view("sem_acquire"))
        || same(view(name), view("cond_wait"))
        || same(view(name), view("thread_reraise"))
        || same(view(name), view("thread_forget_failure"))
        || same(view(name), view("sleep_until_ms")) {
        c.params.push(0);
    }
    if same(view(name), view("read_fd")) {
        c.params.push(0);
        c.params.push(0);
    }
    if same(view(name), view("env"))
        || same(view(name), view("exists"))
        || same(view(name), view("mkdir"))
        || same(view(name), view("list_dir")) {
        c.params.push(4);
    }
    if same(view(name), view("tcp_listen")) || same(view(name), view("tcp_port")) || same(view(name), view("tcp_accept")) {
        c.params.push(0);
    }
    if same(view(name), view("tcp_connect")) || same(view(name), view("open")) {
        c.params.push(4);
        c.params.push(0);
    }
    if same(view(name), view("exit")) {
        c.params.push(0);
    }
    if same(view(name), view("remove")) {
        c.params.push(4);
        c.params.push(0);
    }
    if same(view(name), view("create_dir")) {
        c.params.push(4);
    }
    if same(view(name), view("rename")) || same(view(name), view("symlink")) {
        c.params.push(4);
        c.params.push(4);
    }
    if same(view(name), view("stat")) {
        c.params.push(4);
        c.params.push(0);
    }
    if same(view(name), view("spawn")) {
        ty := intern(&mut c, 6, 2);
        c.params.push(ty);
        c.params.push(ty);
        c.params.push(0);
        c.params.push(0);
    }
    if same(view(name), view("wait")) {
        c.params.push(0);
    }
    if same(view(name), view("sched_start")) {
        for i in 6 {
            c.params.push(0);
        }
    }
    if same(view(name), view("ready")) {
        c.params.push(0);
        c.params.push(0);
    }
    if same(view(name), view("write_fd")) {
        c.params.push(0);
        c.params.push(4);
    }
    count := c.params.len() - first;
    item_public_13 := c.decl_public;
    item_home_13 := "host".copy();
    c
        .funcs
        .push(
            Func {
                public: item_public_13,
                home: item_home_13,
                module: "host".copy(),
                name: name.copy(),
                first: first,
                count: count,
                ret: ret,
                types: 0,
                regions: 0,
                file: 0,
                pos: 0,
                raw: 0,
                unsafe_fn: 0,
                bounds: u64[],
                constraints: u64[][],
                contract: 0,
                owner: 0,
                ext: 0,
                symbol: u8[],
                body: u8[],
                ppreds: Pred[],
                rpred: no_pred(),
                pnames: u8[][],
                pdefaults: Pred[],
                strict: 0,
                no_alloc: 0,
                no_panic: 0,
            }
        );
    return ();
}
fn drop_call<a>(c: (&a mut C), ty: u64) -> unit {
    // A framed record's words belong to a frame or to the place that holds them: nothing to free.
    // An array that owns its elements still drops them, in place (its helper frees no storage).
    if framed(&mut c, ty) && !frame_drops(&mut c, ty) {
        return ();
    }
    // A body emitted without its bindings (a template's validation replay) cannot name a helper: the
    // name would be keyed by a type parameter, and no helper is emitted for one. The body that is
    // kept is the replayed one, where the type is the instantiation's.
    if needs_drop(&mut c, ty) {
        if !concrete_type(&mut c, ty) {
            return ();
        }
        drop_call_out(&mut c, ty);
    }
    return ();
}
// `// grail-link: INPUT` is the compiler's complete linker request; build tooling
// resolves relative object/archive/shared inputs against the declaring sources and
// passes bare names as -lNAME. Nothing else has to guess link inputs.
fn push_bytes<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    out.append(s);
    return ();
}
fn with_link_notes<a, b>(libs: (&a u8[][]), body: &b [u8]) -> u8[] {
    mut out = u8[];
    for i in libs.len() {
        push_bytes(&mut out, view("// grail-link: "));
        push_bytes(&mut out, view(libs[i]));
        out.push(10);
    }
    push_bytes(&mut out, view(body));
    return out;
}
fn emit_drops<a>(c: (&a mut C)) -> unit {
    // Drop helpers are not module code: they are this object's own helpers, so they get a part of
    // their own. A build made of several objects takes each module's code from exactly one object
    // and merges the helper parts, which is what the weak binding below allows.
    part(&mut c, view(".helpers"));
    // The helpers emitted are the helpers something named (`drop_refs`: every naming of one goes
    // through `drop_ref_name`), in the order they were first named - not every type the run happened
    // to intern, in the order it interned them. A body replayed from the unit store interns nothing
    // and names exactly what it named when it was emitted, so this set and this order are the same
    // with a cache as without one (docs/design/incremental-compilation.md). The bodies emitted here
    // name further helpers, so the walk keeps absorbing them: a helper that is named but never
    // emitted is an undefined symbol at link time.
    mut at = 0;
    while at < c.drop_refs.len() {
        ty := c.drop_refs[at];
        at = at + 1;
        kind := ty_kind(&mut c, ty);
        arg := ty_arg(&mut c, ty);
        // `drop_refs` has a type once per naming: a type this walk has settled is settled.
        if (ty < c.drop_walked.len()) && (c.drop_walked[ty] != 0) {
            continue;
        }
        if concrete_type(&mut c, ty) {
            if needs_drop(&mut c, ty) {
                while c.drop_walked.len() <= ty {
                    c.drop_walked.push(0);
                }
                c.drop_walked[ty] = 1;
                // One definition per key, not per interned index: two indices can describe the same
                // drop - a view of one element type and a view of another both only release the
                // backing store - and the key is what decides identity. The body is a function of
                // exactly the components the key records, so the first definition serves both.
                if drop_taken(&mut c, ty) != 0 {
                    continue;
                }
                done := label(&mut c);
                hook := drop_hook_symbol(&mut c, ty);
                // Defined here and called from every module, and a pure function of the type it
                // drops - so the name is content-addressed and the binding is weak: two objects
                // that both emit it emit the same body, and the linker merges them. `--split`
                // needs the name visible across parts, and a build made of several objects needs it
                // too (B1 stage 3).
                fx_end(&mut c);
                if in_place_record(&mut c, ty) {
                    emit_drop_in_place(&mut c, ty, view(hook));
                    helper_sym := drop_symbol(&mut c, ty);
                    fx_helper(&mut c, view(helper_sym));
                    weak_def(&mut c);
                    push_bytes(&mut c.out, view(helper_sym));
                    c.out.push(10);
                    push_bytes(&mut c.out, view(helper_sym));
                    o(&mut c, view(":\ntestq %rdi,%rdi\n"));
                    jump(&mut c, view("jz"), done);
                    o(&mut c, view("pushq %rbp\nmovq %rsp,%rbp\npushq %r12\npushq %r13\nmovq %rdi,%r12\n"));
                    call_out(&mut c, view(drop_in_place_symbol(&mut c, ty)));
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_free"));
                    o(&mut c, view("popq %r13\npopq %r12\nleave\n"));
                    mark(&mut c, done);
                    o(&mut c, view("ret\n"));
                    continue;
                }
                helper_sym := drop_symbol(&mut c, ty);
                fx_helper(&mut c, view(helper_sym));
                weak_def(&mut c);
                push_bytes(&mut c.out, view(helper_sym));
                c.out.push(10);
                push_bytes(&mut c.out, view(helper_sym));
                o(&mut c, view(":\ntestq %rdi,%rdi\n"));
                jump(&mut c, view("jz"), done);
                o(
                    &mut c,
                    view("pushq %rbp\nmovq %rsp,%rbp\npushq %r12\npushq %r13\nmovq %rdi,%r12\n")
                );
                // The user's `drop` runs first, with the value as its receiver; the field walk below
                // releases what the fields own, as Rust does after a `Drop` impl has run.
                if hook.len() != 0 {
                    if direct(&mut c, ty) {
                        // A record's `&mut T` is the record's address: the receiver is the value.
                        o(&mut c, view("movq %r12,%rdi\n"));
                        call_out(&mut c, view(hook));
                    } else {
                        // An enum's `&mut T` is the address of a word holding it, so the receiver
                        // is one scratch word (two, to keep the call 16-byte aligned).
                        o(&mut c, view("subq $16,%rsp\nmovq %r12,(%rsp)\nmovq %rsp,%rdi\n"));
                        call_out(&mut c, view(hook));
                        o(&mut c, view("addq $16,%rsp\n"));
                    }
                }
                if (kind == 3) || (kind == 4) {
                    call_out(&mut c, view("rt_drop_seq"));
                }
                if kind == 11 {
                    call_out(&mut c, view("rt_free"));
                }
                if (kind == 5) || (kind == 27) {
                    // A view owns its record when it has one, never the header it may be instead.
                    call_out(&mut c, view("rt_view_free"));
                }
                if kind == 16 {
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_task_abandon"));
                }
                if kind == 29 {
                    // A job handle is never abandoned: the wait is what owns the record, so dropping
                    // it takes the result and drops that. Leaving it to a leak would keep the job's
                    // captures and its result alive for the life of the process.
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_job_wait"));
                    if needs_drop(&mut c, arg) {
                        o(&mut c, view("movq %rax,%rdi\n"));
                        holder_drop(&mut c, arg);
                    }
                }
                if kind == 20 {
                    o(&mut c, view("movq %r12,%rdi\nmovq 8(%r12),%rax\n"));
                    call_dispatch_out(&mut c, view("call *%rax\n"));
                }
                if kind == 13 {
                    o(&mut c, view("movq 8(%r12),%rdi\n"));
                    holder_drop(&mut c, arg);
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_free"));
                }
                if kind == 10 {
                    drop_call(&mut c, arg);
                }
                if kind == 33 {
                    // {value, vtable}: the vtable's first word drops the value (0 when nothing does).
                    skip := label(&mut c);
                    o(&mut c, view("movq 8(%r12),%rax\nmovq (%rax),%rax\ntestq %rax,%rax\n"));
                    jump(&mut c, view("jz"), skip);
                    o(&mut c, view("movq (%r12),%rdi\n"));
                    fx_vtable_drop(&mut c, arg);
                    o(&mut c, view("call *%rax\n"));
                    mark(&mut c, skip);
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_free"));
                }
                if kind == 32 {
                    // An array drops each element in place; its storage is a frame's (or a box its
                    // holder frees), never its own to free.
                    mode := ty_mode(&mut c, ty);
                    w := array_elem_bytes(&mut c, arg);
                    head := label(&mut c);
                    end := label(&mut c);
                    o(&mut c, view("xorq %r13,%r13\n"));
                    mark(&mut c, head);
                    o(&mut c, view("cmpq $"));
                    on(&mut c, mode);
                    o(&mut c, view(",%r13\n"));
                    jump(&mut c, view("jae"), end);
                    o(&mut c, view("movq %r13,%rax\nimulq $"));
                    on(&mut c, w);
                    o(&mut c, view(",%rax\naddq %r12,%rax\n"));
                    if is_array(&mut c, arg) || array_record_elem(&mut c, arg) {
                        // An inline element is dropped in place, at its address.
                        o(&mut c, view("movq %rax,%rdi\n"));
                    } else {
                        o(&mut c, view("movq (%rax),%rdi\n"));
                    }
                    drop_call(&mut c, arg);
                    o(&mut c, view("incq %r13\n"));
                    jump(&mut c, view("jmp"), head);
                    mark(&mut c, end);
                }
                if kind == 6 {
                    // Inline elements that own something are dropped in place, each at its address;
                    // plain or C records own nothing. Then the buffer is freed.
                    fw := flat_bytes(&mut c, arg);
                    if (fw != 0) && frame_drops(&mut c, arg) {
                        head := label(&mut c);
                        end := label(&mut c);
                        o(&mut c, view("xorq %r13,%r13\n"));
                        mark(&mut c, head);
                        o(&mut c, view("cmpq 8(%r12),%r13\n"));
                        jump(&mut c, view("jae"), end);
                        o(&mut c, view("movq %r13,%rdi\nimulq $"));
                        on(&mut c, fw);
                        o(&mut c, view(",%rdi\naddq (%r12),%rdi\n"));
                        drop_call(&mut c, arg);
                        o(&mut c, view("incq %r13\n"));
                        jump(&mut c, view("jmp"), head);
                        mark(&mut c, end);
                    }
                    if needs_drop(&mut c, arg) & (flat_bytes(&mut c, arg) == 0) {
                        head := label(&mut c);
                        end := label(&mut c);
                        o(&mut c, view("xorq %r13,%r13\n"));
                        mark(&mut c, head);
                        o(&mut c, view("cmpq 8(%r12),%r13\n"));
                        jump(&mut c, view("jae"), end);
                        o(&mut c, view("movq (%r12),%rax\nmovq (%rax,%r13,8),%rdi\n"));
                        drop_call(&mut c, arg);
                        o(&mut c, view("incq %r13\n"));
                        jump(&mut c, view("jmp"), head);
                        mark(&mut c, end);
                    }
                    o(&mut c, view("movq %r12,%rdi\n"));
                call_out(&mut c, view("rt_drop_seq"));
                }
                if kind == 8 {
                    d := &c.decls[arg];
                    // A C-layout record's fields are plain bytes (embedded records included):
                    // only its own buffer is freed.
                    mut count = d.count;
                    if d.c_layout != 0 {
                        count = 0;
                    }
                    is_enum := d.is_enum;
                    for i in count {
                        t := field_type(&mut c, ty, i);
                        if needs_drop(&mut c, t) {
                            if is_enum != 0 {
                                skip := label(&mut c);
                                o(&mut c, view("cmpq $"));
                                on(&mut c, i);
                                o(&mut c, view(",(%r12)\n"));
                                jump(&mut c, view("jne"), skip);
                                o(&mut c, view("movq 8(%r12),%rdi\n"));
                                holder_drop(&mut c, t);
                                mark(&mut c, skip);
                            } else if !inline_field(&mut c, ty, i) {
                                o(&mut c, view("movq "));
                                on(&mut c, field_word(&mut c, ty, i) * 8);
                                o(&mut c, view("(%r12),%rdi\n"));
                                holder_drop(&mut c, t);
                            }
                        }
                    }
                    o(&mut c, view("movq %r12,%rdi\n"));
                    call_out(&mut c, view("rt_free"));
                }
                o(&mut c, view("popq %r13\npopq %r12\nleave\n"));
                mark(&mut c, done);
                o(&mut c, view("ret\n"));
            }
        }
    }
    return ();
}
// The in-place drop of the struct or tuple `ty` (drop_in_place_symbol): with its address in %rdi,
// the user's `drop` runs on it as `&mut self`, then each field that owns something is dropped - a
// word that holds an owner by that owner's drop, an inline record or array by its own in-place
// drop at its address. A zero owner word is an owner moved out (a partial move leaves 0 behind), so
// the word's drop - which starts by testing for 0 - skips it. Nothing is freed.
fn emit_drop_in_place<a, b>(c: (&a mut C), ty: u64, hook: &b [u8]) -> unit {
    sym := drop_in_place_symbol(&mut c, ty);
    fx_helper(&mut c, view(sym));
    weak_def(&mut c);
    push_bytes(&mut c.out, view(sym));
    c.out.push(10);
    push_bytes(&mut c.out, view(sym));
    o(&mut c, view(":\npushq %rbp\nmovq %rsp,%rbp\npushq %r12\npushq %r13\nmovq %rdi,%r12\n"));
    done := label(&mut c);
    if live_word(&mut c, ty) {
        // Moved out of the place that held it: nothing is here to drop.
        o(&mut c, view("cmpq $0,"));
        on(&mut c, (record_words(&mut c, ty) - 1) * 8);
        o(&mut c, view("(%r12)\n"));
        jump(&mut c, view("je"), done);
    }
    if hook.len() != 0 {
        o(&mut c, view("movq %r12,%rdi\n"));
        call_out(&mut c, hook);
    }
    index := ty_arg(&mut c, ty);
    count := c.decls[index].count;
    for i in count {
        t := field_type(&mut c, ty, i);
        if needs_drop(&mut c, t) {
            if inline_field(&mut c, ty, i) {
                // A plain record or array held inline owns nothing; one that owns has its own
                // in-place drop.
                if !frame_drops(&mut c, t) {
                    continue;
                }
                o(&mut c, view("leaq "));
                on(&mut c, field_word(&mut c, ty, i) * 8);
                o(&mut c, view("(%r12),%rdi\n"));
                call_out(&mut c, view(drop_in_place_ref(&mut c, t)));
            } else {
                o(&mut c, view("movq "));
                on(&mut c, field_word(&mut c, ty, i) * 8);
                o(&mut c, view("(%r12),%rdi\n"));
                holder_drop(&mut c, t);
            }
        }
    }
    mark(&mut c, done);
    o(&mut c, view("popq %r13\npopq %r12\nleave\nret\n"));
    return ();
}
// Names the in-place drop of `ty` and asks for it to be emitted (its boxed helper is emitted with it).
fn drop_in_place_ref<a>(c: (&a mut C), alias: u64) -> u8[] {
    // An alias (a bound type parameter) names the helper of the type it stands for.
    ty := base_type(&mut c, alias);
    drop_ref_name(&mut c, ty);
    return drop_in_place_symbol(&mut c, ty);
}
fn emit_exit<a, b>(c: (&a mut C), argument: &b [u8]) -> unit {
    if c.target == 4 {
        // The lowering expands `winexit` into an indirect IAT call with ARM64 home space.
        o(&mut c, argument);
        o(&mut c, view("winexit\n"));
        return ();
    }
    if c.target == 3 {
        // Win64 passes the exit code in ECX; the import slot is a real indirect IAT call.
        win32_link(&mut c, view("ExitProcess"));
        o(&mut c, argument);
        o(&mut c, view("movl %edi,%ecx\ncall *__imp_ExitProcess(%rip)\nud2\n"));
        return ();
    
    }
    if c.plat == 1 {
        o(&mut c, argument);
        o(&mut c, view("call _exit\n"));
        return ();
    }
    mut number = 231;
    if c.target != 0 {
        number = 94;
    }
    o(&mut c, view("movl $"));
    on(&mut c, number);
    o(&mut c, view(",%eax\n"));
    o(&mut c, argument);
    o(&mut c, view("syscall\n"));
    return ();
}
// ---- module interfaces (B1 stage 2) ----
//
// An interface is the checked surface of one module: the declarations an importer needs to check a
// call, and nothing a body would carry. It is line-oriented text (docs/design/separate-compilation.md
// records the format, the ordering rule and the named limitations), written by
// `--emit-interface DIR`, read by `--interface DIR`, and compared declaration by declaration with
// the sources by `--verify-interface`.
//
// The one thing that must not be lost on the way through the file is the *audit result*: a handle's
// `Decl.transfer`/`Decl.share` and a closure type's `Ty.env` environment record. An importer that
// re-derived default-deny from the type alone would refuse a move the audited declaration allowed.

// ---- content digests ----
//
// SHA-256 (FIPS 180-4). The interface digests are what make "refuses to proceed when the sources it
// was built from changed" checkable, so they are a real cryptographic hash and not a checksum.
// The compiler is built without the standard library, so it carries its own; `lib/sha256.grl` is the
// user-facing twin with an incremental API. `tools/interface-test.mjs` checks every `source-sha256`
// line against the host's `sha256sum`, which is what keeps this copy honest.
const S256MASK: u64 = 4294967295;
fn s256_k() -> u64[] {
    return u64[
        0x428a2f98,
        0x71374491,
        0xb5c0fbcf,
        0xe9b5dba5,
        0x3956c25b,
        0x59f111f1,
        0x923f82a4,
        0xab1c5ed5,
        0xd807aa98,
        0x12835b01,
        0x243185be,
        0x550c7dc3,
        0x72be5d74,
        0x80deb1fe,
        0x9bdc06a7,
        0xc19bf174,
        0xe49b69c1,
        0xefbe4786,
        0x0fc19dc6,
        0x240ca1cc,
        0x2de92c6f,
        0x4a7484aa,
        0x5cb0a9dc,
        0x76f988da,
        0x983e5152,
        0xa831c66d,
        0xb00327c8,
        0xbf597fc7,
        0xc6e00bf3,
        0xd5a79147,
        0x06ca6351,
        0x14292967,
        0x27b70a85,
        0x2e1b2138,
        0x4d2c6dfc,
        0x53380d13,
        0x650a7354,
        0x766a0abb,
        0x81c2c92e,
        0x92722c85,
        0xa2bfe8a1,
        0xa81a664b,
        0xc24b8b70,
        0xc76c51a3,
        0xd192e819,
        0xd6990624,
        0xf40e3585,
        0x106aa070,
        0x19a4c116,
        0x1e376c08,
        0x2748774c,
        0x34b0bcb5,
        0x391c0cb3,
        0x4ed8aa4a,
        0x5b9cca4f,
        0x682e6ff3,
        0x748f82ee,
        0x78a5636f,
        0x84c87814,
        0x8cc70208,
        0x90befffa,
        0xa4506ceb,
        0xbef9a3f7,
        0xc67178f2
    ];
}
// Compresses the 64-byte block text[at:at+64] into `h`, using `w` as the message schedule.
fn s256_block(h: (&mut u64[]), text: &[u8], at: u64, w: (&mut u64[]), k: (&u64[])) {
    for t in 16 {
        o := at + t * 4;
        exchange(&mut w[t], (text[o] << 24) | (text[o + 1] << 16) | (text[o + 2] << 8) | text[o + 3]);
    }
    for t in 16..64 {
        x := w[t - 15];
        y := w[t - 2];
        // The rotations written out (every word is below 2^32, and the sum is masked below): a call
        // per rotation was most of what a block cost.
        s0 := (((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3)) & S256MASK;
        s1 := (((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10)) & S256MASK;
        // stays: the written place is indexed (`&mut w[t]`), and two-phase defers only a plain
        // `&mut path`, so the value's reads of `w` are part of taking the place.
        packed := w[t - 16] + s0 + w[t - 7] + s1;
        exchange(&mut w[t], packed & S256MASK);
    }
    mut a: u64 = h[0];
    mut b: u64 = h[1];
    mut c: u64 = h[2];
    mut d: u64 = h[3];
    mut e: u64 = h[4];
    mut f: u64 = h[5];
    mut g: u64 = h[6];
    mut i: u64 = h[7];
    for t in 64 {
        s1 := (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & S256MASK;
        ch := (e & f) ^ ((e ^ S256MASK) & g);
        t1 := i + s1 + ch + k[t] + w[t];
        s0 := (((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & S256MASK;
        maj := (a & b) ^ (a & c) ^ (b & c);
        i = g;
        g = f;
        f = e;
        e = (d + t1) & S256MASK;
        d = c;
        c = b;
        b = a;
        a = (t1 + s0 + maj) & S256MASK;
    }
    h0 := (h[0] + a) & S256MASK;
    h1 := (h[1] + b) & S256MASK;
    h2 := (h[2] + c) & S256MASK;
    h3 := (h[3] + d) & S256MASK;
    h4 := (h[4] + e) & S256MASK;
    h5 := (h[5] + f) & S256MASK;
    h6 := (h[6] + g) & S256MASK;
    h7 := (h[7] + i) & S256MASK;
    exchange(&mut h[0], h0);
    exchange(&mut h[1], h1);
    exchange(&mut h[2], h2);
    exchange(&mut h[3], h3);
    exchange(&mut h[4], h4);
    exchange(&mut h[5], h5);
    exchange(&mut h[6], h6);
    exchange(&mut h[7], h7);
    return ();
}
// The 32-byte SHA-256 digest of a byte view.
fn sha256<a>(data: &a [u8]) -> u8[] {
    mut h = u64[0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    k := s256_k();
    mut w = u64[];
    for i in 64 {
        w.push(0);
    }
    mut at: u64 = 0;
    while at + 64 <= data.len() {
        s256_block(&mut h, data, at, &mut w, &k);
        at += 64;
    }
    mut tail = u8[];
    for i in data.len() - at {
        tail.push(data[at + i]);
    }
    tail.push(128);
    while tail.len() % 64 != 56 {
        tail.push(0);
    }
    bits := data.len() * 8;
    for i in 8 {
        tail.push((bits >> (56 - i * 8)) & 255);
    }
    mut block: u64 = 0;
    while block < tail.len() {
        s256_block(&mut h, &tail, block, &mut w, &k);
        block += 64;
    }
    mut out = u8[];
    for i in 8 {
        word := h[i];
        out.push(word >> 24);
        out.push((word >> 16) & 255);
        out.push((word >> 8) & 255);
        out.push(word & 255);
    }
    return out;
}
// Lowercase hexadecimal, two characters per byte.
fn iface_hex<a>(bytes: &a [u8]) -> u8[] {
    digits := "0123456789abcdef";
    mut out = u8[];
    for i in bytes.len() {
        b := bytes[i];
        out.push(digits[b >> 4]);
        out.push(digits[b & 15]);
    }
    return out;
}
// The SHA-256 of a byte view as 64 lowercase hex characters.
pub fn iface_digest<a>(data: &a [u8]) -> u8[] {
    d := sha256(data);
    return iface_hex(&d);
}

// ---- the interface format (format 4) ----
//
// An interface is a byte stream of length-counted typed records with one writer and one reader
// (docs/design/separate-compilation.md, "Format 4 as built"). The shape:
//
//   file  := "GRIF" VERSION:u8 record* trailer
//   record:= tag:u8 len:VAR payload[len]
//   trailer  tag 2, payload = source digest + SHA-256 of every byte before it
//
// `VAR` is LEB128. Every record states its own length, every string its own length and every type
// is a record of its own, so the reader can prove it consumed exactly what the writer emitted:
// `iface_rend` refuses a record with bytes left over instead of skipping them, and a file that ends
// early is refused by `iface_need`. There is no second string builder and no text to re-lex: the
// declarations travel as the numbers and names they are.
//
// A reader that does not know a record refuses it by tag; a record one field longer than this
// compiler reads is refused by length. Neither can be misread as something else, which is what makes
// adding a field a version bump and not a silent reinterpretation. `grail iface dump` renders the
// tree the reader read, so the format stays inspectable without a second parser.
// Format 7 added the effect summary rows of every listed function; format 8 gives an `Atomic<T>`
// its element type; format 9 carries a `dyn` type's bounds; format 10 adds the SIMD vector types
// (kind 36: the element, and the lane count in the mode).
const IFACE_VERSION: u64 = 10;
const IFACE_TAG_MODULE: u64 = 1;
const IFACE_TAG_TRAILER: u64 = 2;
const IFACE_TAG_LINK: u64 = 3;
const IFACE_TAG_TYPE: u64 = 10;
const IFACE_TAG_ALIAS: u64 = 11;
const IFACE_TAG_CONST: u64 = 12;
const IFACE_TAG_FN: u64 = 13;
const IFACE_TAG_INHERENT: u64 = 14;
const IFACE_TAG_IFACE: u64 = 15;
const IFACE_TAG_IMPL: u64 = 16;
const IFACE_TAG_ENV: u64 = 17;
// A written type's inherent methods (`impl<T> T[] { .. }`): the owner is a type, not a declaration.
const IFACE_TAG_INHERENT_TYPE: u64 = 18;
// A module static (docs/design/module-values.md): name, visibility, type and tier; the storage is in
// the declaring module's object, so no value travels.
const IFACE_TAG_STATIC: u64 = 19;
// The effect summary of every function the module emitted (docs/design/effects.md, "Summaries"):
// computed facts, not claims, so a run that calls one without its body knows what it does.
const IFACE_TAG_FACTS: u64 = 20;
// The small runtime bodies another unit may inline (docs/design/separate-compilation.md, "Inlining
// across a module boundary"): the symbol and its crossing form, carried in `runtime.facts` after the
// summary, so the readers' keys (the file's digest) move when a body does.
const IFACE_TAG_INLINE: u64 = 21;

// The ABI this compiler builds objects for, as the one line every interface carries: the `dyn`
// layout (docs/design/fat-dyn.md) - a `&dyn I` is an 8-byte pointer to a 16-byte, 8-aligned
// `{data, vtable}` pair - and what a reference to a record is (`ref record = address`: the record's
// own address, docs/design/unboxed-values.md stage 1a; before it, the address of a word holding
// that), and that a plain record held by a record or a vector is stored inline (`record plain =
// inline`, stage 1b), and that a call passes six words in registers and the rest on the stack
// (`args = 6 registers then stack`, docs/design/call-abi.md S3; before it, the rest in a heap record
// behind the sixth register). A module that was compiled for another layout cannot be linked into the same program by
// accident: the writer writes this line and the reader refuses a file whose line differs.
//
// The string is the whole spelling, `abi ` included. It is carried as one length-counted field of
// the module header record and rendered back verbatim by `grail iface dump`, so the single-source
// rule survives the encoding: nothing else in this compiler knows how the ABI is written.
fn iface_dyn_abi() -> string {
    return "abi dyn pair size = 16 align = 8 word0 = data word1 = vtable drop = 0 ref record = address record plain = inline plain record = frame args = 6 registers then stack";
}

// ---- writing ----
fn iface_w1<a>(out: (&a mut u8[]), b: u64) -> unit {
    out.push(b & 255);
    return ();
}
// LEB128, one byte below 128.
fn iface_wv<a>(out: (&a mut u8[]), n: u64) -> unit {
    mut v = n;
    while 127 < v {
        out.push((v & 127) | 128);
        v = v >> 7;
    }
    out.push(v);
    return ();
}
fn iface_ws<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    iface_wv(&mut out, s.len());
    push_bytes(&mut out, view(s));
    return ();
}
fn iface_wrec<a, b>(out: (&a mut u8[]), tag: u64, body: &b [u8]) -> unit {
    out.push(tag);
    iface_wv(&mut out, body.len());
    push_bytes(&mut out, view(body));
    return ();
}
// A count followed by that many numbers: bounds, lifetime slots, argument counts.
fn iface_w_num_list<a, b>(out: (&a mut u8[]), ns: (&b u64[])) -> unit {
    iface_wv(&mut out, ns.len());
    for i in ns.len() {
        iface_wv(&mut out, ns[i]);
    }
    return ();
}
fn iface_w_str_list<a, b>(out: (&a mut u8[]), ss: (&b u8[][])) -> unit {
    iface_wv(&mut out, ss.len());
    for i in ss.len() {
        iface_ws(&mut out, view(ss[i]));
    }
    return ();
}
// The bounds and interface requirements of a declaration, a function or an implementation's own
// parameters: a sparse list of (parameter index, bits) and a list of (index, requirements). Sparse
// because a declaration of twelve parameters with a bound on the third one should not write twelve
// zeroes.
fn iface_w_bounds<a, b>(out: (&a mut u8[]), bounds: (&b u64[])) -> unit {
    mut n = 0;
    for i in bounds.len() {
        if bounds[i] != 0 {
            n += 1;
        }
    }
    iface_wv(&mut out, n);
    for i in bounds.len() {
        if bounds[i] != 0 {
            iface_wv(&mut out, i);
            iface_wv(&mut out, bounds[i]);
        }
    }
    return ();
}
fn iface_w_reqs<a, b>(c: (&a mut C), out: (&a mut u8[]), reqs: (&b u64[][])) -> unit {
    mut n = 0;
    for i in reqs.len() {
        if reqs[i].len() != 0 {
            n += 1;
        }
    }
    iface_wv(&mut out, n);
    for i in reqs.len() {
        if reqs[i].len() != 0 {
            iface_wv(&mut out, i);
            iface_wv(&mut out, reqs[i].len());
            for j in reqs[i].len() {
                if CALLABLE_BOUND <= reqs[i][j] {
                    // A callable bound: an empty interface name, then the bound's type.
                    iface_ws(&mut out, view(""));
                    iface_ws(&mut out, view(""));
                    mut deps = u64[];
                    iface_type(&mut c, &mut out, &mut deps, reqs[i][j] - CALLABLE_BOUND);
                } else {
                    iface_w_iface_ref(&mut c, &mut out, reqs[i][j]);
                }
            }
        }
    }
    return ();
}
// A nominal reference by name: an importer rebuilds it through its own declaration table, so no
// index this run chose crosses the file. An environment record is named inside the file it is
// carried by (`.closure` + `envN`), exactly as the reader names it back.
fn iface_w_ref<a>(c: (&a mut C), out: (&a mut u8[]), decl: u64) -> unit {
    d := &c.decls[decl];
    m := d.module.copy();
    n := d.name.copy();
    if same(view(m), view(".closure")) {
        local := iface_env_name(&mut c, decl);
        iface_ws(&mut out, view(".closure"));
        iface_ws(&mut out, view(local));
        return ();
    }
    iface_ws(&mut out, view(m));
    iface_ws(&mut out, view(n));
    return ();
}
fn iface_w_iface_ref<a>(c: (&a mut C), out: (&a mut u8[]), id: u64) -> unit {
    // A type whose interface slot does not name an interface of this run (an `extern` record's proof
    // can carry one) has no spelling: a key or surface that asks gets "not spellable", which makes
    // the run file no units, rather than an index out of bounds.
    if (id == 0) || (c.interfaces.len() < id) {
        if c.spell_lenient != 0 {
            exchange(&mut c.spell_failed, 1);
            return ();
        }
        iface_refuse(view("<interface>"), view("a type names an interface this run does not have"));
    }
    item := &c.interfaces[id - 1];
    iface_ws(&mut out, view(item.module));
    iface_ws(&mut out, view(item.name));
    return ();
}

// ---- reading ----
// A cursor over one interface's bytes. `stop` is the end of the record being read; entering a record
// pushes it, leaving one pops it, and every read is bounds-checked against it, so a truncated file or
// an over-long record is a refusal rather than a short read. `phase` 0 means describe: the reader
// spells what it reads into `rtext` and installs nothing, which is `grail iface dump` and the
// `--verify` comparison. Phases 1 and 2 install names and definitions.
struct IR {
    data: u8[],
    at: u64,
    stop: u64,
    path: u8[],
    phase: u64,
    rtext: u8[],
    what: u8[]
}
fn iface_tag_name(tag: u64) -> string {
    if tag == IFACE_TAG_MODULE {
        return "module";
    }
    if tag == IFACE_TAG_TRAILER {
        return "trailer";
    }
    if tag == IFACE_TAG_LINK {
        return "link";
    }
    if tag == IFACE_TAG_TYPE {
        return "type";
    }
    if tag == IFACE_TAG_ALIAS {
        return "alias";
    }
    if tag == IFACE_TAG_CONST {
        return "const";
    }
    if tag == IFACE_TAG_STATIC {
        return "static";
    }
    if tag == IFACE_TAG_FN {
        return "fn";
    }
    if tag == IFACE_TAG_INHERENT {
        return "inherent";
    }
    if tag == IFACE_TAG_INHERENT_TYPE {
        return "inherent_type";
    }
    if tag == IFACE_TAG_IFACE {
        return "interface";
    }
    if tag == IFACE_TAG_IMPL {
        return "impl";
    }
    if tag == IFACE_TAG_ENV {
        return "env";
    }
    if tag == IFACE_TAG_FACTS {
        return "facts";
    }
    if tag == IFACE_TAG_INLINE {
        return "inline";
    }
    return "unknown";
}
fn iface_known_tag(tag: u64) -> bool {
    return (tag == IFACE_TAG_MODULE) || (tag == IFACE_TAG_TRAILER) || (tag == IFACE_TAG_LINK)
        || (tag == IFACE_TAG_TYPE) || (tag == IFACE_TAG_ALIAS) || (tag == IFACE_TAG_CONST)
        || (tag == IFACE_TAG_FN) || (tag == IFACE_TAG_INHERENT) || (tag == IFACE_TAG_IFACE)
        || (tag == IFACE_TAG_IMPL) || (tag == IFACE_TAG_ENV) || (tag == IFACE_TAG_INHERENT_TYPE)
        || (tag == IFACE_TAG_STATIC) || (tag == IFACE_TAG_FACTS) || (tag == IFACE_TAG_INLINE);
}
// Where a refusal happened, so no diagnostic says only "malformed".
fn iface_where<a>(p: (&a IR)) -> u8[] {
    mut out = u8[];
    push_bytes(&mut out, view(p.what));
    push_bytes(&mut out, view(" at byte "));
    decimal(&mut out, p.at);
    return out;
}
fn iface_bad<a, b>(p: (&a mut IR), msg: &b [u8]) -> unit {
    mut out = u8[];
    push_bytes(&mut out, view(msg));
    push_bytes(&mut out, view(" ("));
    push_bytes(&mut out, view(iface_where(&p)));
    push_bytes(&mut out, view(")"));
    iface_refuse(view(p.path), view(out));
    return ();
}
fn iface_need<a>(p: (&a mut IR), n: u64) -> unit {
    if (p.stop < p.at) || ((p.stop - p.at) < n) {
        mut msg = u8[];
        push_bytes(&mut msg, view("is truncated: "));
        push_bytes(&mut msg, view(p.what));
        push_bytes(&mut msg, view(" needs "));
        decimal(&mut msg, n);
        push_bytes(&mut msg, view(" more byte"));
        if n != 1 {
            push_bytes(&mut msg, view("s"));
        }
        push_bytes(&mut msg, view(" and the file ends there"));
        iface_refuse(view(p.path), view(msg));
    }
    return ();
}
fn iface_r1<a>(p: (&a mut IR)) -> u64 {
    iface_need(&mut p, 1);
    b := p.data[p.at];
    p.at = p.at + 1;
    return b;
}
fn iface_rv<a>(p: (&a mut IR)) -> u64 {
    mut n = 0;
    mut scale = 1;
    mut done = 0;
    while done == 0 {
        b := iface_r1(&mut p);
        // Ten bytes carry 64 bits: the tenth, at scale 2^63, holds bit 63 alone and ends the number.
        // (Refusing at 2^56 refused every u64 from 2^63 up, and every negative signed constant.)
        if (scale == 9223372036854775808) && (1 < b) {
            iface_bad(&mut p, view("carries a number wider than 64 bits"));
            return 0;
        }
        n = n + (b & 127) * scale;
        if (b & 128) == 0 {
            done = 1;
        } else {
            scale = scale * 128;
        }
    }
    return n;
}
fn iface_rs<a>(p: (&a mut IR)) -> u8[] {
    n := iface_rv(&mut p);
    iface_need(&mut p, n);
    mut out = u8[];
    start := p.at;
    for i in n {
        out.push(p.data[start + i]);
    }
    p.at = p.at + n;
    return out;
}
fn iface_r_num_list<a>(p: (&a mut IR)) -> u64[] {
    n := iface_rv(&mut p);
    mut out = u64[];
    for i in n {
        out.push(iface_rv(&mut p));
    }
    return out;
}
fn iface_r_str_list<a>(p: (&a mut IR)) -> u8[][] {
    n := iface_rv(&mut p);
    mut out = u8[][];
    for i in n {
        out.push(iface_rs(&mut p));
    }
    return out;
}
// Enter a record: refuses a different tag, and a payload that runs past the record it sits in.
// Returns the enclosing `stop` for the `p.stop = saved` that ends the record.
fn iface_rec<a>(p: (&a mut IR), want: u64) -> u64 {
    tag := iface_r1(&mut p);
    if tag != want {
        if !iface_known_tag(tag) {
            mut msg = u8[];
            push_bytes(&mut msg, view("carries an unknown record (tag "));
            decimal(&mut msg, tag);
            push_bytes(&mut msg, view(") where this compiler reads a `"));
            push_bytes(&mut msg, view(iface_tag_name(want)));
            push_bytes(&mut msg, view("` record: it was written by a newer compiler, and this one reads interface format 4"));
            push_bytes(&mut msg, view(" ("));
            push_bytes(&mut msg, view(iface_where(&p)));
            push_bytes(&mut msg, view(")"));
            iface_refuse(view(p.path), view(msg));
        }
        mut msg = u8[];
        push_bytes(&mut msg, view("has a `"));
        push_bytes(&mut msg, view(iface_tag_name(tag)));
        push_bytes(&mut msg, view("` record where this compiler reads a `"));
        push_bytes(&mut msg, view(iface_tag_name(want)));
        push_bytes(&mut msg, view("` ("));
        push_bytes(&mut msg, view(iface_where(&p)));
        push_bytes(&mut msg, view(")"));
        iface_refuse(view(p.path), view(msg));
    }
    len := iface_rv(&mut p);
    saved := p.stop;
    if (p.stop < p.at) || ((p.stop - p.at) < len) {
        iface_bad(&mut p, view("is truncated: this record says it is longer than the file"));
    }
    p.stop = p.at + len;
    return saved;
}
// Leave a record: everything it declared must have been read. This is the check that makes the
// reader and the writer impossible to disagree silently - a field the writer added and this reader
// does not know is a refusal by name, never a skipped byte.
fn iface_rend<a>(p: (&a mut IR), start: u64) -> unit {
    if p.at != p.stop {
        mut msg = u8[];
        push_bytes(&mut msg, view("carries "));
        decimal(&mut msg, p.stop - p.at);
        push_bytes(&mut msg, view(" byte"));
        if (p.stop - p.at) != 1 {
            push_bytes(&mut msg, view("s"));
        }
        push_bytes(&mut msg, view(" this compiler does not read: the record declares "));
        decimal(&mut msg, p.stop - start);
        push_bytes(&mut msg, view(" and this compiler reads "));
        decimal(&mut msg, p.at - start);
        iface_bad(&mut p, view(msg));
    }
    return ();
}
// The dump: every field the reader consumed, in the order it consumed it. `phase` 0 turns it on.
fn iface_rt<a, b>(p: (&a mut IR), s: &b [u8]) -> unit {
    if p.phase == 0 {
        push_bytes(&mut p.rtext, view(s));
    }
    return ();
}
fn iface_rt_num<a>(p: (&a mut IR), s: &a [u8], n: u64) -> unit {
    if p.phase == 0 {
        push_bytes(&mut p.rtext, view(s));
        decimal(&mut p.rtext, n);
    }
    return ();
}

// ---- one type ----
// The writer's switch and the reader's are the same switch: one tag, one payload. Everything a type
// carries is written on every kind (mode, lifetime slots, then the payload its tag defines), so no
// kind can quietly lose a field the way a spelling that wrote `mode` "only where it is legal" could.
// The two loops also collect what the surface pass needs: `deps` (the declarations and interfaces the
// type names) is gathered here, by the function that writes the bytes, so it cannot disagree with
// what the record says.
fn iface_w_type<a>(c: (&a mut C), out: (&a mut u8[]), deps: (&a mut u64[]), ty: u64) -> unit {
    mut body = u8[];
    k := ty_kind(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    rs := type_regions(&mut c, ty);
    args := type_args(&mut c, ty);
    env := ty_env(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    // An associated type's `mode` is `interface id * 1024 + item index`, and the id is a position in
    // this run's interface table: the record writes the interface by name and the index, so the mode
    // slot carries nothing (a zero) and the reader rebuilds it. Writing the id here would make the
    // same declaration re-encode differently in a run that registered its interfaces in another
    // order - which is what `grail iface roundtrip` caught on an `assoc` type bound.
    mut written_mode = mode;
    if k == 30 {
        written_mode = 0;
    }
    iface_wv(&mut body, written_mode);
    iface_w_num_list(&mut body, &rs);
    if (k == 1) || (k == 2) || (k == 3) || (k == 4) || (k == 17) || (k == 19)
        || (k == 22) || (k == 24) {
        // A plain kind: its mode, its slots and nothing else.
    } else if k == 21 {
        // The width lives in the argument: 32 bits is f32, 0 is f64.
        iface_wv(&mut body, arg);
    } else if k == 31 {
        // A value parameter's binding (comptime C2): the constant itself.
        iface_wv(&mut body, arg);
    } else if k == 18 {
        // A narrow integer: its width, with `mode` carrying signedness.
        iface_wv(&mut body, arg);
    } else if k == 5 {
        // A view: mode and slots are the whole type.
    } else if k == 32 {
        // An array: its element, then its length's type argument when a value parameter gives the
        // length (none when the length is the constant in the mode).
        iface_w_type(&mut c, &mut body, &mut deps, arg);
        iface_wv(&mut body, args.len());
        for i in args.len() {
            iface_w_type(&mut c, &mut body, &mut deps, args[i]);
        }
    } else if (k == 6) || (k == 7) || (k == 10) || (k == 11) || (k == 13) || (k == 14) || (k == 16) || (k == 26)
        || (k == 27) || (k == 29) || (k == 34) || (k == 35) || (k == 36) {
        // One nested type in the payload (an `Atomic<T>` carries its element since format 8, a SIMD
        // vector its element and lane count, in the mode, since format 9).
        iface_w_type(&mut c, &mut body, &mut deps, arg);
    } else if k == 8 {
        owner := c.decls[arg].module.copy();
        name := c.decls[arg].name.copy();
        if same(view(owner), view(".outcome")) & same(view(name), view("Failure")) {
            // The synthesised failure record: rebuilt by the reader from its own rule.
            body.push(0);
        } else if same(view(owner), view(".union")) || same(view(owner), view(".result"))
            || same(view(owner), view(".outcome")) {
            // `T?` / `T | E` are structural: the members are the type, and the reader rebuilds the
            // declaration the compiler synthesises for that member count.
            body.push(1);
            if same(view(owner), view(".union")) {
                body.push(0);
            } else if same(view(owner), view(".result")) {
                body.push(1);
            } else {
                body.push(2);
            }
            iface_wv(&mut body, c.decls[arg].success);
            iface_wv(&mut body, args.len());
            for i in args.len() {
                iface_w_type(&mut c, &mut body, &mut deps, args[i]);
            }
        } else {
            body.push(2);
            iface_w_ref(&mut c, &mut body, arg);
            iface_wv(&mut body, args.len());
            for i in args.len() {
                iface_w_type(&mut c, &mut body, &mut deps, args[i]);
            }
        }
        deps.push(1);
        deps.push(arg);
    } else if (k == 23) || (k == 28) {
        // A handle's argument is its declaration; a `byval R`'s is the record's type
        // (ffi_byval_parameter), whose declaration is what the record names.
        mut decl = arg;
        if k == 28 {
            decl = ty_arg(&mut c, arg);
        }
        iface_w_ref(&mut c, &mut body, decl);
        deps.push(1);
        deps.push(decl);
    } else if k == 9 {
        // An opaque type parameter: its bound bits are its mode and its interface proofs its slots,
        // so both travel; the argument is its index.
        iface_wv(&mut body, arg);
        iface_wv(&mut body, args.len());
        for i in args.len() {
            iface_w_type(&mut c, &mut body, &mut deps, args[i]);
        }
    } else if k == 33 {
        iface_w_iface_ref(&mut c, &mut body, arg);
        deps.push(2);
        deps.push(arg);
        iface_wv(&mut body, args.len());
        for i in args.len() {
            iface_w_type(&mut c, &mut body, &mut deps, args[i]);
        }
    } else if k == 30 {
        // `(assoc PARAM INTERFACE INDEX)`: the parameter type, the interface by name, the index.
        iface_w_type(&mut c, &mut body, &mut deps, arg);
        id := mode / 1024;
        iface_w_iface_ref(&mut c, &mut body, id);
        deps.push(2);
        deps.push(id);
        iface_wv(&mut body, mode % 1024);
    } else if k == 15 {
        iface_w_iface_ref(&mut c, &mut body, arg);
        deps.push(2);
        deps.push(arg);
    } else if (k == 12) || (k == 25) {
        iface_wv(&mut body, args.len());
        for i in args.len() {
            iface_w_type(&mut c, &mut body, &mut deps, args[i]);
        }
        iface_w_type(&mut c, &mut body, &mut deps, arg);
    } else if k == 20 {
        iface_wv(&mut body, args.len());
        for i in args.len() {
            iface_w_type(&mut c, &mut body, &mut deps, args[i]);
        }
        iface_w_type(&mut c, &mut body, &mut deps, arg);
        if env == 0 {
            body.push(0);
        } else {
            body.push(1);
            iface_w_type(&mut c, &mut body, &mut deps, env);
        }
    } else {
        // A store extension with no spelling: refuse rather than write something the reader would
        // rebuild as a different type. A caller that only asked *whether* a type has a spelling
        // (`iface_spellable`) records the gap and gets on with the build.
        if c.spell_lenient != 0 {
            exchange(&mut c.spell_failed, 1);
            return ();
        }
        iface_refuse(view("<interface>"), view("this compiler cannot write a type of that kind to an interface"));
    }
    out.push(k);
    iface_wv(&mut out, body.len());
    push_bytes(&mut out, view(body));
    return ();
}
// The checked entry point: writes the type and, under `--verify-interface`, reads it back and
// requires the same interned type. Recursion goes through `iface_w_type`, so one type is verified
// once and a spelling that loses anything is refused at the writer rather than misread by an importer.
fn iface_type<a, b>(c: (&a mut C), out: (&a mut u8[]), deps: (&a mut u64[]), ty: u64) -> unit {
    start := out.len();
    iface_w_type(&mut c, &mut out, &mut deps, ty);
    if c.iface_verify == 0 {
        return ();
    }
    mut written = u8[];
    for i in out.len() - start {
        written.push(out[start + i]);
    }
    mut p = IR {
        data: written,
        at: 0,
        stop: out.len() - start,
        path: copy_bytes(view("<interface>")),
        phase: 2,
        rtext: u8[],
        what: copy_bytes(view("the type just written"))
    };
    back := iface_r_type(&mut p, &mut c);
    if back != ty {
        // The subject here is the interface format itself, so these two names are its own spelling
        // (`type_name`, not `source_type_name`): they say what the file wrote and read back.
        mut msg = u8[];
        push_bytes(&mut msg, view("this interface format does not round-trip a type: wrote `"));
        push_bytes(&mut msg, view(type_name(&mut c, ty)));
        push_bytes(&mut msg, view("` and read back `"));
        push_bytes(&mut msg, view(type_name(&mut c, back)));
        push_bytes(&mut msg, view("`"));
        iface_refuse(view("<interface>"), view(msg));
    }
    return ();
}
fn iface_spell_flags<a>(p: (&a mut IR), mode: u64, rs: (&a u64[])) -> unit {
    if p.phase != 0 {
        return ();
    }
    if mode != 0 {
        p.rtext.push(32);
        decimal(&mut p.rtext, mode);
    }
    if rs.len() != 0 {
        p.rtext.push(32);
        p.rtext.push(91);
        for i in rs.len() {
            if i != 0 {
                p.rtext.push(44);
            }
            decimal(&mut p.rtext, rs[i]);
        }
        p.rtext.push(93);
    }
    return ();
}
fn iface_r_ref<a>(p: (&a mut IR)) -> u8[] {
    module := iface_rs(&mut p);
    name := iface_rs(&mut p);
    mut out = u8[];
    push_bytes(&mut out, view(module));
    push_bytes(&mut out, view("::"));
    push_bytes(&mut out, view(name));
    return out;
}
// The type reader's interners: phase 2 builds the type, the other phases only consume its bytes.
fn iface_intern_args<a>(p: (&a mut IR), c: (&a mut C), k: u64, arg: u64, mode: u64, rs: u64[], args: u64[]) -> u64 {
    if p.phase != 2 {
        return 0;
    }
    return intern_args(&mut c, k, arg, mode, rs, args);
}
fn iface_intern_full<a>(p: (&a mut IR), c: (&a mut C), k: u64, arg: u64, mode: u64, rs: u64[]) -> u64 {
    if p.phase != 2 {
        return 0;
    }
    return intern_full(&mut c, k, arg, mode, rs);
}
fn iface_intern_env<a>(p: (&a mut IR), c: (&a mut C), k: u64, arg: u64, mode: u64, rs: u64[], args: u64[], env: u64) -> u64 {
    if p.phase != 2 {
        return 0;
    }
    return intern_env(&mut c, k, arg, mode, rs, args, env);
}
fn iface_find_decl<a, b>(c: (&a mut C), p: (&a mut IR), module: &b [u8], name: &b [u8]) -> u64 {
    d := find_decl_internal(&mut c, view(module), view(name));
    if d == 0 {
        mut msg = u8[];
        push_bytes(&mut msg, view("names a type this program does not declare: "));
        push_bytes(&mut msg, view(module));
        push_bytes(&mut msg, view("::"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view(" ("));
        push_bytes(&mut msg, view(iface_where(&p)));
        push_bytes(&mut msg, view(")"));
        iface_refuse(view(p.path), view(msg));
    }
    return d - 1;
}
fn iface_find_iface<a, b>(c: (&a mut C), p: (&a mut IR), module: &b [u8], name: &b [u8]) -> u64 {
    id := find_interface(&c, view(module), view(name));
    if id == 0 {
        mut msg = u8[];
        push_bytes(&mut msg, view("names an interface this program does not declare: "));
        push_bytes(&mut msg, view(module));
        push_bytes(&mut msg, view("::"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view(" ("));
        push_bytes(&mut msg, view(iface_where(&p)));
        push_bytes(&mut msg, view(")"));
        iface_refuse(view(p.path), view(msg));
    }
    return id;
}
// A type, rebuilt exactly: the reader interns through the same constructors the source parser uses,
// so two spellings of one type denote one interned type. In phase 0 it installs nothing and spells
// what it read into the dump instead.
fn iface_r_type<a>(p: (&a mut IR), c: (&a mut C)) -> u64 {
    tag := iface_r1(&mut p);
    if (tag == 0) || (40 < tag) {
        iface_bad(&mut p, view("carries a type of an unknown kind"));
    }
    len := iface_rv(&mut p);
    if (p.stop < p.at) || ((p.stop - p.at) < len) {
        iface_bad(&mut p, view("is truncated: this type says it is longer than the record that holds it"));
    }
    saved := p.stop;
    p.stop = p.at + len;
    start := p.at;
    mode := iface_rv(&mut p);
    rs := iface_r_num_list(&mut p);
    mut id = 0;
    if tag == 1 || tag == 2 || tag == 3 || tag == 4 || tag == 17 || tag == 19
        || tag == 22 || tag == 24 {
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view(iface_plain_word(tag)));
        } else {
            id = iface_intern_args(&mut p, &mut c, tag, 0, mode, rs, u64[]);
        }
    } else if (tag == 21) || (tag == 31) || (tag == 18) {
        arg := iface_rv(&mut p);
        if p.phase == 0 {
            if tag == 21 {
                if arg == 32 {
                    push_bytes(&mut p.rtext, view("f32"));
                } else {
                    push_bytes(&mut p.rtext, view("f64"));
                }
            } else if tag == 31 {
                push_bytes(&mut p.rtext, view("(const "));
                decimal(&mut p.rtext, arg);
                p.rtext.push(41);
            } else {
                push_bytes(&mut p.rtext, view("(int "));
                decimal(&mut p.rtext, arg);
                if mode == 0 {
                    push_bytes(&mut p.rtext, view("u)"));
                } else {
                    push_bytes(&mut p.rtext, view("i)"));
                }
            }
        } else {
            id = iface_intern_args(&mut p, &mut c, tag, arg, mode, rs, u64[]);
        }
    } else if tag == 5 {
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view("(view"));
            iface_spell_flags(&mut p, mode, &rs);
            p.rtext.push(41);
        } else {
            id = iface_intern_args(&mut p, &mut c, tag, 0, mode, rs, u64[]);
        }
    } else if tag == 10 {
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view("(bound "));
        }
        inner := iface_r_type(&mut p, &mut c);
        if p.phase == 0 {
            iface_rt_num(&mut p, view(" "), mode);
            p.rtext.push(41);
        } else {
            id = iface_intern_args(&mut p, &mut c, tag, inner, mode, rs, u64[]);
        }
    } else if tag == 32 {
        if p.phase == 0 {
            p.rtext.push(40);
            push_bytes(&mut p.rtext, view(iface_plain_word(tag)));
            iface_spell_flags(&mut p, mode, &rs);
            p.rtext.push(32);
        }
        inner := iface_r_type(&mut p, &mut c);
        n := iface_rv(&mut p);
        mut largs = u64[];
        for i in n {
            if p.phase == 0 {
                p.rtext.push(32);
            }
            largs.push(iface_r_type(&mut p, &mut c));
        }
        if p.phase == 0 {
            p.rtext.push(41);
        } else {
            id = iface_intern_args(&mut p, &mut c, tag, inner, mode, rs, largs);
        }
    } else if (tag == 6) || (tag == 7) || (tag == 11) || (tag == 13) || (tag == 14) || (tag == 16) || (tag == 36)
        || (tag == 26) || (tag == 27) || (tag == 29) || (tag == 34) || (tag == 35) {
        if (p.phase == 0) & (tag != 35) {
            p.rtext.push(40);
            push_bytes(&mut p.rtext, view(iface_plain_word(tag)));
            iface_spell_flags(&mut p, mode, &rs);
            p.rtext.push(32);
        } else if (p.phase == 0) & (tag == 35) {
            push_bytes(&mut p.rtext, view("(bobj "));
        }
        inner := iface_r_type(&mut p, &mut c);
        if p.phase == 0 {
            p.rtext.push(41);
        } else {
            id = iface_intern_args(&mut p, &mut c, tag, inner, mode, rs, u64[]);
        }
    } else if tag == 8 {
        how := iface_r1(&mut p);
        if how == 0 {
            if p.phase == 0 {
                push_bytes(&mut p.rtext, view("(outcomefail)"));
            } else if p.phase == 2 {
                id = task_failure_type(&mut c);
            }
        } else if how == 1 {
            family := iface_r1(&mut p);
            success := iface_rv(&mut p);
            n := iface_rv(&mut p);
            if p.phase == 0 {
                if family == 0 {
                    push_bytes(&mut p.rtext, view("(union "));
                } else if family == 1 {
                    push_bytes(&mut p.rtext, view("(result "));
                } else {
                    push_bytes(&mut p.rtext, view("(outcome "));
                }
                decimal(&mut p.rtext, success);
                p.rtext.push(32);
                p.rtext.push(40);
            }
            mut members = u64[];
            for i in n {
                if (p.phase == 0) & (i != 0) {
                    p.rtext.push(44);
                }
                members.push(iface_r_type(&mut p, &mut c));
            }
            if p.phase == 0 {
                push_bytes(&mut p.rtext, view("))"));
            } else if p.phase == 2 {
                mut module = copy_bytes(view(".union"));
                mut prefix = copy_bytes(view("Union"));
                if family == 1 {
                    module = copy_bytes(view(".result"));
                    prefix = copy_bytes(view("Result"));
                } else if family == 2 {
                    module = copy_bytes(view(".outcome"));
                    prefix = copy_bytes(view("Outcome"));
                }
                id = make_union(&mut c, members, success, module, view(prefix));
            }
        } else {
            if p.phase == 0 {
                push_bytes(&mut p.rtext, view("(named "));
            }
            module := iface_rs(&mut p);
            name := iface_rs(&mut p);
            if p.phase == 0 {
                push_bytes(&mut p.rtext, view(module));
                push_bytes(&mut p.rtext, view("::"));
                push_bytes(&mut p.rtext, view(name));
                iface_spell_flags(&mut p, mode, &rs);
            }
            n := iface_rv(&mut p);
            mut args = u64[];
            for i in n {
                if p.phase == 0 {
                    p.rtext.push(32);
                }
                args.push(iface_r_type(&mut p, &mut c));
            }
            if p.phase == 0 {
                p.rtext.push(41);
            } else if p.phase == 2 {
                if same(view(module), view(".closure")) {
                    id = iface_env_type(&mut c, &mut p, view(name));
                } else {
                    decl := iface_find_decl(&mut c, &mut p, view(module), view(name));
                    id = iface_intern_args(&mut p, &mut c, tag, decl, mode, rs, args);
                }
            }
        }
    } else if (tag == 23) || (tag == 28) {
        module := iface_rs(&mut p);
        name := iface_rs(&mut p);
        if p.phase == 0 {
            p.rtext.push(40);
            if tag == 23 {
                push_bytes(&mut p.rtext, view("handle "));
            } else {
                push_bytes(&mut p.rtext, view("byval "));
            }
            push_bytes(&mut p.rtext, view(module));
            push_bytes(&mut p.rtext, view("::"));
            push_bytes(&mut p.rtext, view(name));
            iface_spell_flags(&mut p, mode, &rs);
            p.rtext.push(41);
        } else if p.phase == 2 {
            decl := iface_find_decl(&mut c, &mut p, view(module), view(name));
            if tag == 28 {
                // As the parser builds it: the marker over the record's own type.
                record := iface_intern_args(&mut p, &mut c, 8, decl, 0, u64[], u64[]);
                id = iface_intern_args(&mut p, &mut c, tag, record, mode, rs, u64[]);
            } else {
                id = iface_intern_args(&mut p, &mut c, tag, decl, mode, rs, u64[]);
            }
        }
    } else if tag == 9 {
        index := iface_rv(&mut p);
        n := iface_rv(&mut p);
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view("(tparam "));
            decimal(&mut p.rtext, index);
            p.rtext.push(32);
            decimal(&mut p.rtext, mode);
            p.rtext.push(32);
            p.rtext.push(91);
            for i in rs.len() {
                if i != 0 {
                    p.rtext.push(44);
                }
                decimal(&mut p.rtext, rs[i]);
            }
            p.rtext.push(93);
        }
        mut proofs = u64[];
        for i in n {
            if p.phase == 0 {
                p.rtext.push(32);
            }
            proofs.push(iface_r_type(&mut p, &mut c));
        }
        if p.phase == 0 {
            p.rtext.push(41);
        } else {
            id = iface_intern_args(&mut p, &mut c, tag, index, mode, rs, proofs);
        }
    } else if tag == 33 {
        module := iface_rs(&mut p);
        name := iface_rs(&mut p);
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view("(dyn "));
            push_bytes(&mut p.rtext, view(module));
            push_bytes(&mut p.rtext, view("::"));
            push_bytes(&mut p.rtext, view(name));
        }
        n := iface_rv(&mut p);
        mut fixed = u64[];
        for i in n {
            if p.phase == 0 {
                p.rtext.push(32);
            }
            fixed.push(iface_r_type(&mut p, &mut c));
        }
        if p.phase == 0 {
            p.rtext.push(41);
        } else if p.phase == 2 {
            fixed_id := iface_find_iface(&mut c, &mut p, view(module), view(name));
            id = iface_intern_args(&mut p, &mut c, tag, fixed_id, mode, rs, fixed);
        }
    } else if tag == 30 {
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view("(assoc "));
        }
        param := iface_r_type(&mut p, &mut c);
        module := iface_rs(&mut p);
        name := iface_rs(&mut p);
        index := iface_rv(&mut p);
        if p.phase == 0 {
            p.rtext.push(32);
            push_bytes(&mut p.rtext, view(module));
            push_bytes(&mut p.rtext, view("::"));
            push_bytes(&mut p.rtext, view(name));
            p.rtext.push(32);
            decimal(&mut p.rtext, index);
            p.rtext.push(41);
        } else if p.phase == 2 {
            fixed_id := iface_find_iface(&mut c, &mut p, view(module), view(name));
            id = iface_intern_full(&mut p, &mut c, tag, param, fixed_id * 1024 + index, u64[]);
        }
    } else if tag == 15 {
        module := iface_rs(&mut p);
        name := iface_rs(&mut p);
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view("(proof "));
            push_bytes(&mut p.rtext, view(module));
            push_bytes(&mut p.rtext, view("::"));
            push_bytes(&mut p.rtext, view(name));
            p.rtext.push(41);
        } else if p.phase == 2 {
            fixed_id := iface_find_iface(&mut c, &mut p, view(module), view(name));
            id = iface_intern_args(&mut p, &mut c, tag, fixed_id, mode, rs, u64[]);
        }
    } else if (tag == 12) || (tag == 25) {
        n := iface_rv(&mut p);
        if p.phase == 0 {
            p.rtext.push(40);
            push_bytes(&mut p.rtext, view(iface_plain_word(tag)));
            iface_spell_flags(&mut p, mode, &rs);
            p.rtext.push(32);
            p.rtext.push(40);
        }
        mut params = u64[];
        for i in n {
            if (p.phase == 0) & (i != 0) {
                p.rtext.push(44);
            }
            params.push(iface_r_type(&mut p, &mut c));
        }
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view(") "));
        }
        ret := iface_r_type(&mut p, &mut c);
        if p.phase == 0 {
            p.rtext.push(41);
        } else {
            id = iface_intern_args(&mut p, &mut c, tag, ret, mode, rs, params);
        }
    } else if tag == 20 {
        n := iface_rv(&mut p);
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view("(closure"));
            iface_spell_flags(&mut p, mode, &rs);
            p.rtext.push(32);
            p.rtext.push(40);
        }
        mut params = u64[];
        for i in n {
            if (p.phase == 0) & (i != 0) {
                p.rtext.push(44);
            }
            params.push(iface_r_type(&mut p, &mut c));
        }
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view(") "));
        }
        ret := iface_r_type(&mut p, &mut c);
        has_env := iface_r1(&mut p);
        mut env = 0;
        if has_env != 0 {
            if p.phase == 0 {
                p.rtext.push(32);
            }
            env = iface_r_type(&mut p, &mut c);
        }
        if p.phase == 0 {
            if has_env == 0 {
                push_bytes(&mut p.rtext, view(" 0"));
            }
            p.rtext.push(41);
        } else {
            id = iface_intern_env(&mut p, &mut c, tag, ret, mode, rs, params, env);
        }
    } else {
        iface_bad(&mut p, view("carries a type this compiler cannot read"));
    }
    iface_rend(&mut p, start);
    p.stop = saved;
    return id;
}

// ---- the declarations of one module, as records ----
// One item per declaration the module could export. `public` is the item's own visibility; a record
// is written only if the item is public or a public item cites it (the surface rule, unchanged from
// the text format). A method is an item of its own whose `parent` is the section it belongs to, so a
// private method that nothing mentions stays out of the file and the section follows its methods.
struct IItem {
    tag: u64,
    index: u64,
    name: u8[],
    public: u64,
    owner: u64,
    parent: u64,
    payload: u8[],
    deps: u64[],
    text: u8[]
}
// `owner` is the key an implementation's parameter record is filed under: the declaration it is
// attached to for an inherent block, the implementation for a generic one. It is written into the
// record, so the reader does not re-derive it from a type argument - the two used to differ for a
// generic implementation, which is how its parameters went missing.
fn iface_impl_owner<a>(c: (&a mut C), index: u64, ty: u64) -> u64 {
    if ty_kind(&mut c, ty) == 8 {
        d := ty_arg(&mut c, ty) + 1;
        if impl_record(&mut c, d) != 0 {
            return d;
        }
    }
    g := generic_impl_key(index + 1);
    if impl_record(&mut c, g) != 0 {
        return g;
    }
    return 0;
}
// An implementation's own parameters. The record states whether there are any; the *key* it is
// filed under is derived by the reader from the declaration or the implementation it belongs to,
// because the writer's key is an index into the writer's store and would name a different
// declaration in the reader's. (The text format wrote the fields and derived the key too.)
fn iface_enc_impl_params<a>(c: (&a mut C), out: (&a mut u8[]), deps: (&a mut u64[]), owner: u64) -> unit {
    record := impl_record(&mut c, owner);
    if record == 0 {
        iface_w1(&mut out, 0);
        return ();
    }
    iface_w1(&mut out, 1);
    p := &c.impl_params[record - 1];
    types := p.tnames.len();
    lifetimes := p.rnames.len();
    iface_wv(&mut out, types);
    for i in types {
        iface_ws(&mut out, view(p.tnames[i]));
    }
    iface_wv(&mut out, lifetimes);
    for i in lifetimes {
        iface_ws(&mut out, view(p.rnames[i]));
    }
    mut reqs = u64[][];
    for i in p.interfaces.len() {
        reqs.push(copy_numbers(&p.interfaces[i]));
    }
    mut bounds = copy_numbers(&p.bounds);
    iface_w_bounds(&mut out, &bounds);
    iface_w_reqs(&mut c, &mut out, &reqs);
    for i in reqs.len() {
        for j in reqs[i].len() {
            if reqs[i][j] < CALLABLE_BOUND {
                deps.push(2);
                deps.push(reqs[i][j]);
            }
        }
    }
    return ();
}
fn iface_enc_decl<a>(c: (&a mut C), index: u64, module: &a [u8], deps: (&a mut u64[]), text: (&a mut u8[])) -> u8[] {
    name := c.decls[index].name.copy();
    is_enum := c.decls[index].is_enum;
    opaque := c.decls[index].opaque;
    c_layout := c.decls[index].c_layout;
    first := c.decls[index].first;
    count := c.decls[index].count;
    public := c.decls[index].public;
    mut bounds = copy_numbers(&c.decls[index].bounds);
    mut reqs = u64[][];
    for i in c.decls[index].constraints.len() {
        reqs.push(copy_numbers(&c.decls[index].constraints[i]));
    }
    mut body = u8[];
    iface_ws(&mut body, view(module));
    iface_ws(&mut body, view(name));
    iface_w1(&mut body, public);
    if opaque != 0 {
        iface_w1(&mut body, 3);
    } else if is_enum != 0 {
        iface_w1(&mut body, 2);
    } else if c_layout != 0 {
        iface_w1(&mut body, 1);
    } else {
        iface_w1(&mut body, 0);
    }
    iface_wv(&mut body, c.decls[index].types);
    iface_wv(&mut body, c.decls[index].regions);
    iface_wv(&mut body, c.decls[index].transfer);
    iface_wv(&mut body, c.decls[index].share);
    iface_w_bounds(&mut body, &bounds);
    iface_w_reqs(&mut c, &mut body, &reqs);
    iface_wv(&mut body, count);
    for i in count {
        field := c.fields[first + i].name.copy();
        ty := c.fields[first + i].ty;
        p := &c.fields[first + i].pred;
        pf := p.file;
        plo := p.lo;
        phi := p.hi;
        iface_ws(&mut body, view(field));
        iface_type(&mut c, &mut body, &mut deps, ty);
        if phi == 0 {
            iface_ws(&mut body, view(""));
        } else {
            pred := pred_text(&mut c, Pred { file: pf, lo: plo, hi: phi });
            iface_ws(&mut body, view(pred));
            push_bytes(&mut text, view(pred));
            text.push(32);
        }
    }
    return body;
}
// `fn NAME` plus everything a caller needs: the signature, the flags, the bounds and requirements,
// the refinements with the parameter names a proof substitutes, the effects row, and for a template
// its own text. A field is a count, so a new one is a version bump the reader detects rather than a
// byte it skips.
// Whether one parameter has anything to say in the interface: a name a caller can use, or a default
// it can compile when the argument is left out.
fn iface_param_carried<a>(c: (&a mut C), index: u64, at: u64, nnames: u64, ndefaults: u64) -> bool {
    if at < nnames {
        if c.funcs[index].pnames[at].len() != 0 {
            return true;
        }
    }
    if at < ndefaults {
        if has_pred(&c.funcs[index].pdefaults[at]) {
            return true;
        }
    }
    return false;
}
fn iface_enc_fn<a>(c: (&a mut C), index: u64, deps: (&a mut u64[]), text: (&a mut u8[])) -> u8[] {
    name := c.funcs[index].name.copy();
    public := c.funcs[index].public;
    types := c.funcs[index].types;
    regions := c.funcs[index].regions;
    ext := c.funcs[index].ext;
    symbol := c.funcs[index].symbol.copy();
    strict := c.funcs[index].strict;
    owner := c.funcs[index].owner;
    contract := c.funcs[index].contract;
    ret := c.funcs[index].ret;
    no_alloc := c.funcs[index].no_alloc;
    no_panic := c.funcs[index].no_panic;
    body := c.funcs[index].body.copy();
    params := iface_params(&mut c, index);
    mut bounds = copy_numbers(&c.funcs[index].bounds);
    mut reqs = u64[][];
    for i in c.funcs[index].constraints.len() {
        reqs.push(copy_numbers(&c.funcs[index].constraints[i]));
    }
    npreds := c.funcs[index].ppreds.len();
    nnames := c.funcs[index].pnames.len();
    mut body_bytes = u8[];
    iface_ws(&mut body_bytes, view(name));
    iface_w1(&mut body_bytes, public);
    iface_wv(&mut body_bytes, types);
    iface_wv(&mut body_bytes, regions);
    // Bit 8 of the extern word: the function is `extern "C" blocking` (ffi_blocking), so a caller in
    // another module hands its worker off too.
    mut ext_word = ext;
    if ext != 0 {
        for bi in c.ffi_blocking.len() {
            if same(view(c.ffi_blocking[bi]), view(symbol)) {
                ext_word = ext | 256;
            }
        }
        // Bit 9: `nonblocking`.
        for bi in c.ffi_nonblocking.len() {
            if same(view(c.ffi_nonblocking[bi]), view(symbol)) {
                ext_word = ext | 512;
            }
        }
    }
    iface_wv(&mut body_bytes, ext_word);
    iface_ws(&mut body_bytes, view(symbol));
    iface_w1(&mut body_bytes, strict);
    iface_wv(&mut body_bytes, params.len());
    for i in params.len() {
        iface_type(&mut c, &mut body_bytes, &mut deps, params[i]);
    }
    iface_type(&mut c, &mut body_bytes, &mut deps, ret);
    iface_w_bounds(&mut body_bytes, &bounds);
    iface_w_reqs(&mut c, &mut body_bytes, &reqs);
    mut nwhere = 0;
    for i in npreds {
        if c.funcs[index].ppreds[i].hi != 0 {
            nwhere += 1;
        }
    }
    iface_wv(&mut body_bytes, nwhere);
    for i in npreds {
        pf := c.funcs[index].ppreds[i].file;
        plo := c.funcs[index].ppreds[i].lo;
        phi := c.funcs[index].ppreds[i].hi;
        if phi == 0 {
            continue;
        }
        pred := pred_text(&mut c, Pred { file: pf, lo: plo, hi: phi });
        iface_wv(&mut body_bytes, i);
        iface_ws(&mut body_bytes, view(pred));
        push_bytes(&mut text, view(pred));
        text.push(32);
    }
    // Every parameter's name travels, and each default with it: a caller in another module names the
    // slot it fills and, when it leaves one out, compiles the value the declaration wrote
    // (docs/design/named-arguments.md). The default is carried as its *text*, because it is compiled
    // where the call is written; a value frozen here would be evaluated once, in this module's
    // context. Sparse by parameter index, so a function with neither costs one byte.
    ndefaults := c.funcs[index].pdefaults.len();
    mut widest = nnames;
    if ndefaults > widest {
        widest = ndefaults;
    }
    mut nargs = 0;
    for i in widest {
        if iface_param_carried(&mut c, index, i, nnames, ndefaults) {
            nargs += 1;
        }
    }
    iface_wv(&mut body_bytes, nargs);
    for i in widest {
        if !iface_param_carried(&mut c, index, i, nnames, ndefaults) {
            continue;
        }
        mut name = u8[];
        if i < nnames {
            name = c.funcs[index].pnames[i].copy();
        }
        mut dtext = u8[];
        if i < ndefaults {
            df := c.funcs[index].pdefaults[i].file;
            dl := c.funcs[index].pdefaults[i].lo;
            dh := c.funcs[index].pdefaults[i].hi;
            if dh != 0 {
                dtext = pred_text(&mut c, Pred { file: df, lo: dl, hi: dh });
            }
        }
        iface_wv(&mut body_bytes, i);
        iface_ws(&mut body_bytes, view(name));
        iface_ws(&mut body_bytes, view(dtext));
        // A name or a default may cite a private item, so both are scanned like a body line.
        push_bytes(&mut text, view(name));
        text.push(32);
        push_bytes(&mut text, view(dtext));
        text.push(32);
    }
    rpf := c.funcs[index].rpred.file;
    rplo := c.funcs[index].rpred.lo;
    rphi := c.funcs[index].rpred.hi;
    mut rpred = u8[];
    if rphi != 0 {
        rpred = pred_text(&mut c, Pred { file: rpf, lo: rplo, hi: rphi });
        push_bytes(&mut text, view(rpred));
        text.push(32);
    }
    iface_ws(&mut body_bytes, view(rpred));
    iface_w1(&mut body_bytes, no_alloc);
    iface_w1(&mut body_bytes, no_panic);
    iface_ws(&mut body_bytes, view(body));
    push_bytes(&mut text, view(body));
    return body_bytes;
}
fn iface_enc_alias<a>(c: (&a mut C), index: u64, deps: (&a mut u64[])) -> u8[] {
    a := c.aliases[index];
    module := a.module.copy();
    name := a.name.copy();
    ty := a.ty;
    public := a.public;
    if ty == NO_TYPE {
        iface_refuse(view("<interface>"), view("an unresolved type alias cannot be written to an interface"));
    }
    mut body = u8[];
    iface_ws(&mut body, view(module));
    iface_ws(&mut body, view(name));
    iface_w1(&mut body, public);
    iface_type(&mut c, &mut body, &mut deps, ty);
    return body;
}
fn iface_enc_const<a>(c: (&a mut C), index: u64, deps: (&a mut u64[])) -> u8[] {
    module := c.constants[index].module.copy();
    name := c.constants[index].name.copy();
    ty := c.constants[index].ty;
    value := c.constants[index].value;
    text := c.constants[index].text.copy();
    public := c.constants[index].public;
    mut body = u8[];
    iface_ws(&mut body, view(module));
    iface_ws(&mut body, view(name));
    iface_w1(&mut body, public);
    iface_type(&mut c, &mut body, &mut deps, ty);
    if (ty != 3) && (ty != 0) && (ct_seq_elem(&mut c, ty) != NO_TYPE) {
        iface_w1(&mut body, 2);
        iface_wv(&mut body, value);
        iface_ws(&mut body, view(text));
    } else if ty == 3 {
        iface_w1(&mut body, 1);
        iface_wv(&mut body, 0);
        iface_ws(&mut body, view(text));
    } else {
        iface_w1(&mut body, 0);
        iface_wv(&mut body, value);
        iface_ws(&mut body, view(""));
    }
    return body;
}
// A static's record: what a reader needs to name its storage. Tier 1 is the baked tier, the only one
// built; a reader refuses any other.
fn iface_enc_static<a>(c: (&a mut C), index: u64, deps: (&a mut u64[])) -> u8[] {
    module := c.statics[index].module.copy();
    name := c.statics[index].name.copy();
    ty := c.statics[index].ty;
    public := c.statics[index].public;
    mut body = u8[];
    iface_ws(&mut body, view(module));
    iface_ws(&mut body, view(name));
    iface_w1(&mut body, public);
    iface_type(&mut c, &mut body, &mut deps, ty);
    iface_w1(&mut body, 1);
    // What an importer's prover may know: an integer static's value, or a table's length.
    mut kind = 0;
    mut fact = 0;
    static_fact(&mut c, index, &mut kind, &mut fact);
    iface_w1(&mut body, kind);
    iface_wv(&mut body, fact);
    return body;
}
// An environment record: the captures of a closure type, under a name local to this file.
fn iface_enc_env<a>(c: (&a mut C), decl: u64, deps: (&a mut u64[])) -> u8[] {
    first := c.decls[decl].first;
    count := c.decls[decl].count;
    mut body = u8[];
    iface_wv(&mut body, count);
    for i in count {
        field := c.fields[first + i].name.copy();
        ty := c.fields[first + i].ty;
        iface_ws(&mut body, view(field));
        iface_type(&mut c, &mut body, &mut deps, ty);
    }
    return body;
}
// Every item of one module, in name order, with the bytes it will occupy and the names it cites.
fn iface_items<a>(c: (&a mut C), m: &a [u8]) -> IItem[] {
    mut items = IItem[];
    decls := iface_decl_ids(&mut c, view(m));
    names := iface_names_of_decls(&mut c, &decls);
    order := iface_sorted(&names);
    for i in order.len() {
        index := decls[order[i]];
        mut deps = u64[];
        mut text = u8[];
        payload := iface_enc_decl(&mut c, index, view(m), &mut deps, &mut text);
        items.push(
            IItem {
                tag: IFACE_TAG_TYPE,
                index: index,
                name: names[order[i]].copy(),
                public: c.decls[index].public,
                owner: 0,
                parent: 0,
                payload: payload,
                deps: deps,
                text: text
            }
        );
    }
    mut picks = u64[];
    mut pick_names = u8[][];
    for i in c.aliases.len() {
        if same(view(c.aliases[i].module), view(m)) {
            picks.push(i);
            pick_names.push(c.aliases[i].name.copy());
        }
    }
    order2 := iface_sorted(&pick_names);
    for i in order2.len() {
        index := picks[order2[i]];
        mut deps = u64[];
        mut text = u8[];
        payload := iface_enc_alias(&mut c, index, &mut deps);
        items.push(
            IItem {
                tag: IFACE_TAG_ALIAS,
                index: index,
                name: pick_names[order2[i]].copy(),
                public: c.aliases[index].public,
                owner: 0,
                parent: 0,
                payload: payload,
                deps: deps,
                text: text
            }
        );
    }
    mut consts = u64[];
    mut const_names = u8[][];
    for i in c.constants.len() {
        if same(view(c.constants[i].module), view(m)) {
            consts.push(i);
            const_names.push(c.constants[i].name.copy());
        }
    }
    order3 := iface_sorted(&const_names);
    for i in order3.len() {
        index := consts[order3[i]];
        mut deps = u64[];
        mut text = u8[];
        payload := iface_enc_const(&mut c, index, &mut deps);
        items.push(
            IItem {
                tag: IFACE_TAG_CONST,
                index: index,
                name: const_names[order3[i]].copy(),
                public: c.constants[index].public,
                owner: 0,
                parent: 0,
                payload: payload,
                deps: deps,
                text: text
            }
        );
    }
    mut stats = u64[];
    mut stat_names = u8[][];
    for i in c.statics.len() {
        if same(view(c.statics[i].module), view(m)) {
            stats.push(i);
            stat_names.push(c.statics[i].name.copy());
        }
    }
    order5 := iface_sorted(&stat_names);
    for i in order5.len() {
        index := stats[order5[i]];
        mut deps = u64[];
        mut text = u8[];
        payload := iface_enc_static(&mut c, index, &mut deps);
        items.push(
            IItem {
                tag: IFACE_TAG_STATIC,
                index: index,
                name: stat_names[order5[i]].copy(),
                public: c.statics[index].public,
                owner: 0,
                parent: 0,
                payload: payload,
                deps: deps,
                text: text
            }
        );
    }
    funcs := iface_func_ids(&mut c, view(m));
    fnames := iface_names_of_funcs(&mut c, &funcs);
    order4 := iface_sorted(&fnames);
    for i in order4.len() {
        index := funcs[order4[i]];
        mut deps = u64[];
        mut text = u8[];
        payload := iface_enc_fn(&mut c, index, &mut deps, &mut text);
        items.push(
            IItem {
                tag: IFACE_TAG_FN,
                index: index,
                name: fnames[order4[i]].copy(),
                public: c.funcs[index].public,
                owner: 0,
                parent: 0,
                payload: payload,
                deps: deps,
                text: text
            }
        );
    }
    // Inherent methods, attached to the type that owns them.
    for i in order.len() {
        index := decls[order[i]];
        owner_module := private_module(view(".inherent_"), index);
        methods := iface_func_ids(&mut c, view(owner_module));
        if methods.len() == 0 {
            continue;
        }
        mut deps = u64[];
        mut body = u8[];
        iface_ws(&mut body, view(m));
        iface_ws(&mut body, view(c.decls[index].name));
        iface_enc_impl_params(&mut c, &mut body, &mut deps, index + 1);
        n := items.len();
        items.push(
            IItem {
                tag: IFACE_TAG_INHERENT,
                index: index,
                name: c.decls[index].name.copy(),
                public: 0,
                owner: index,
                parent: 0,
                payload: body,
                deps: deps,
                text: u8[]
            }
        );
        mnames := iface_names_of_funcs(&mut c, &methods);
        morder := iface_sorted(&mnames);
        for j in morder.len() {
            method := methods[morder[j]];
            mut mdeps = u64[];
            mut mtext = u8[];
            payload := iface_enc_fn(&mut c, method, &mut mdeps, &mut mtext);
            items.push(
                IItem {
                    tag: IFACE_TAG_FN,
                    index: method,
                    name: mnames[morder[j]].copy(),
                    public: c.funcs[method].public,
                    owner: index,
                    parent: n + 1,
                    payload: payload,
                    deps: mdeps,
                    text: mtext
                }
            );
        }
    }
    // Inherent methods on a *written* type (`impl u8[] { ... }`, `impl<T> T[] { ... }`): the owner
    // has no declaration to name, so the section spells the type structurally and the reader
    // registers it under the type it spells. The module that wrote the impl is the one whose
    // interface carries it.
    mut written = u64[];
    mut spelled = u8[][];
    for i in c.inherent_types.len() {
        key := inherent_type_base() + i + 1;
        methods := iface_func_ids(&mut c, view(inherent_type_module(key)));
        if methods.len() == 0 {
            continue;
        }
        if !same(view(c.funcs[methods[0]].home), view(m)) {
            continue;
        }
        mut spell_deps = u64[];
        mut owner_bytes = u8[];
        iface_w_type(&mut c, &mut owner_bytes, &mut spell_deps, c.inherent_types[i]);
        written.push(key);
        spelled.push(owner_bytes);
    }
    worder := iface_sorted(&spelled);
    for i in worder.len() {
        key := written[worder[i]];
        owner_module := inherent_type_module(key);
        methods := iface_func_ids(&mut c, view(owner_module));
        mut deps = u64[];
        mut body = u8[];
        iface_w_type(&mut c, &mut body, &mut deps, c.inherent_types[key - inherent_type_base() - 1]);
        iface_enc_impl_params(&mut c, &mut body, &mut deps, key);
        n := items.len();
        items.push(
            IItem {
                tag: IFACE_TAG_INHERENT_TYPE,
                index: key,
                name: spelled[worder[i]].copy(),
                public: 0,
                owner: key,
                parent: 0,
                payload: body,
                deps: deps,
                text: u8[]
            }
        );
        mnames := iface_names_of_funcs(&mut c, &methods);
        morder := iface_sorted(&mnames);
        for j in morder.len() {
            method := methods[morder[j]];
            mut mdeps = u64[];
            mut mtext = u8[];
            payload := iface_enc_fn(&mut c, method, &mut mdeps, &mut mtext);
            items.push(
                IItem {
                    tag: IFACE_TAG_FN,
                    index: method,
                    name: mnames[morder[j]].copy(),
                    public: c.funcs[method].public,
                    owner: key,
                    parent: n + 1,
                    payload: payload,
                    deps: mdeps,
                    text: mtext
                }
            );
        }
    }
    // Interface declarations and their methods.
    mut ifaces = u64[];
    mut iface_names = u8[][];
    for i in c.interfaces.len() {
        if same(view(c.interfaces[i].module), view(m)) {
            ifaces.push(i);
            iface_names.push(c.interfaces[i].name.copy());
        }
    }
    iorder := iface_sorted(&iface_names);
    for i in iorder.len() {
        index := ifaces[iorder[i]];
        mut deps = u64[];
        mut body = u8[];
        iface_ws(&mut body, view(m));
        iface_ws(&mut body, view(c.interfaces[index].name));
        iface_w1(&mut body, c.interfaces[index].public);
        supers := copy_numbers(&c.interfaces[index].supers);
        iface_wv(&mut body, supers.len());
        for j in supers.len() {
            iface_w_iface_ref(&mut c, &mut body, supers[j]);
            deps.push(2);
            deps.push(supers[j]);
        }
        assoc := copy_names(&c.interfaces[index].assoc);
        iface_w_str_list(&mut body, &assoc);
        n := items.len();
        items.push(
            IItem {
                tag: IFACE_TAG_IFACE,
                index: index,
                name: iface_names[iorder[i]].copy(),
                public: c.interfaces[index].public,
                owner: 0,
                parent: 0,
                payload: body,
                deps: deps,
                text: u8[]
            }
        );
        owner_module := private_module(view(".interface_"), index + 1);
        methods := iface_func_ids(&mut c, view(owner_module));
        mnames := iface_names_of_funcs(&mut c, &methods);
        morder := iface_sorted(&mnames);
        for j in morder.len() {
            method := methods[morder[j]];
            mut mdeps = u64[];
            mut mtext = u8[];
            payload := iface_enc_fn(&mut c, method, &mut mdeps, &mut mtext);
            items.push(
                IItem {
                    tag: IFACE_TAG_FN,
                    index: method,
                    name: mnames[morder[j]].copy(),
                    public: c.funcs[method].public,
                    owner: 0,
                    parent: n + 1,
                    payload: payload,
                    deps: mdeps,
                    text: mtext
                }
            );
        }
    }
    // Interface implementations owned by this module.
    mut impls = u64[];
    mut impl_names = u8[][];
    for i in c.implementations.len() {
        if same(view(c.implementations[i].module), view(m)) {
            impls.push(i);
            contract := c.implementations[i].contract;
            mut key = c.interfaces[contract - 1].module.copy();
            push_bytes(&mut key, view("::"));
            push_bytes(&mut key, view(c.interfaces[contract - 1].name));
            impl_names.push(key);
        }
    }
    porder := iface_sorted(&impl_names);
    for i in porder.len() {
        index := impls[porder[i]];
        contract := c.implementations[index].contract;
        ty := c.implementations[index].ty;
        mut deps = u64[];
        mut body = u8[];
        iface_w_iface_ref(&mut c, &mut body, contract);
        deps.push(2);
        deps.push(contract);
        iface_type(&mut c, &mut body, &mut deps, ty);
        iface_enc_impl_params(&mut c, &mut body, &mut deps, iface_impl_owner(&mut c, index, ty));
        names := copy_names(&c.implementations[index].assoc_names);
        types := copy_numbers(&c.implementations[index].assoc_types);
        iface_wv(&mut body, names.len());
        for j in names.len() {
            iface_ws(&mut body, view(names[j]));
            iface_type(&mut c, &mut body, &mut deps, types[j]);
        }
        n := items.len();
        items.push(
            IItem {
                tag: IFACE_TAG_IMPL,
                index: index,
                name: impl_names[porder[i]].copy(),
                public: 1,
                owner: 0,
                parent: 0,
                payload: body,
                deps: deps,
                text: u8[]
            }
        );
        owner_module := private_module(view(".impl_"), index + 1);
        methods := iface_func_ids(&mut c, view(owner_module));
        mnames := iface_names_of_funcs(&mut c, &methods);
        morder := iface_sorted(&mnames);
        for j in morder.len() {
            method := methods[morder[j]];
            mut mdeps = u64[];
            mut mtext = u8[];
            payload := iface_enc_fn(&mut c, method, &mut mdeps, &mut mtext);
            items.push(
                IItem {
                    tag: IFACE_TAG_FN,
                    index: method,
                    name: mnames[morder[j]].copy(),
                    public: c.funcs[method].public,
                    owner: 0,
                    parent: n + 1,
                    payload: payload,
                    deps: mdeps,
                    text: mtext
                }
            );
        }
    }
    return items;
}
// Which items the file carries: every public one, every implementation, every environment record,
// and then, to a fixpoint, each private item a carried item names - the private helper a public
// template's body calls, the private type a public signature names. A carried private item keeps its
// own `public` bit of 0, so an importer can compile the template against it but cannot name it.
fn iface_keep<a>(items: (&a IItem[])) -> u64[] {
    n := items.len();
    mut keep = u64[];
    for i in n {
        it := &items[i];
        if it.parent == 0 {
            if (it.public != 0) || (it.tag == IFACE_TAG_ENV) || (it.tag == IFACE_TAG_IMPL) {
                keep.push(1);
            } else {
                keep.push(0);
            }
        } else if it.public != 0 {
            keep.push(1);
        } else {
            keep.push(0);
        }
    }
    mut changed = true;
    while changed {
        changed = false;
        for i in n {
            if keep[i] == 0 {
                continue;
            }
            deps := &items[i].deps;
            mut j = 0;
            while j + 1 < deps.len() {
                marker := deps[j];
                at := deps[j + 1];
                for k in n {
                    if keep[k] == 0 {
                        kt := &items[k];
                        if marker == 1 {
                            if ((kt.tag == IFACE_TAG_TYPE) || (kt.tag == IFACE_TAG_ENV)) & (kt.index == at)
                                & (kt.parent == 0) {
                                exchange(&mut keep[k], 1);
                                changed = true;
                            }
                        } else {
                            if (kt.tag == IFACE_TAG_IFACE) & (kt.index == at - 1) & (kt.parent == 0) {
                                exchange(&mut keep[k], 1);
                                changed = true;
                            }
                        }
                    }
                }
                j += 2;
            }
            text := &items[i].text;
            if text.len() != 0 {
                for k in n {
                    if keep[k] == 0 {
                        kt := &items[k];
                        if (kt.parent == 0) & ((kt.tag == IFACE_TAG_IMPL) || (kt.tag == IFACE_TAG_ENV)) {
                            // Always carried, never named.
                        } else if iface_mentions(view(text), view(kt.name)) {
                            exchange(&mut keep[k], 1);
                            changed = true;
                        }
                    }
                }
            }
        }
    }
    // A kept interface carries its methods (its section is the file's only record of them), and an
    // inherent section is written when a method under it is.
    for k in n {
        if (items[k].parent == 0) & (items[k].tag == IFACE_TAG_IFACE) & (keep[k] != 0) {
            for j in n {
                if (items[j].parent == k + 1) & (keep[j] == 0) {
                    exchange(&mut keep[j], 1);
                }
            }
        }
    }
    for k in n {
        if (items[k].parent == 0) & ((items[k].tag == IFACE_TAG_INHERENT) || (items[k].tag == IFACE_TAG_INHERENT_TYPE)) {
            mut any = 0;
            for j in n {
                if (items[j].parent == k + 1) & (keep[j] != 0) {
                    any = 1;
                }
            }
            exchange(&mut keep[k], any);
        }
    }
    return keep;
}

// ---- one module's interface ----
fn iface_vlen(n: u64) -> u64 {
    mut v = n;
    mut bytes = 1;
    while 127 < v {
        v = v >> 7;
        bytes += 1;
    }
    return bytes;
}
fn iface_is_section(tag: u64) -> bool {
    return (tag == IFACE_TAG_INHERENT) || (tag == IFACE_TAG_IFACE) || (tag == IFACE_TAG_IMPL) || (tag == IFACE_TAG_INHERENT_TYPE);
}
// The bytes of one module's interface. One writer, driven by the declaration store: the header, then
// one length-counted record per declaration of the public surface, then the trailer that carries the
// source digest and the digest of every byte before it. `digest` is the source's SHA-256, or empty to
// read the source this module was built from; the round-trip command passes the digest the file
// already records, so re-encoding a loaded module reproduces its bytes exactly.
fn iface_module_bytes<a, b, d>(c: (&a mut C), m: &b [u8], path: &d [u8], in_std: u64, unsafe_flag: u64, host_opt: u64, digest: &a [u8]) -> u8[] {
    exchange(&mut c.iface_env, u64[]);
    exchange(&mut c.iface_env_names, u8[][]);
    mut items = iface_items(&mut c, view(m));
    // Environment records a closure type in this surface captures. Encoding one can reach another,
    // so this runs to a fixpoint - before the surface is computed, because a capture's type cites
    // declarations exactly as a field does.
    mut at = 0;
    while at < c.iface_env.len() {
        decl := c.iface_env[at];
        local := c.iface_env_names[at].copy();
        mut deps = u64[];
        payload := iface_enc_env(&mut c, decl, &mut deps);
        mut body = u8[];
        iface_ws(&mut body, view(local));
        push_bytes(&mut body, view(payload));
        items.push(
            IItem {
                tag: IFACE_TAG_ENV,
                index: decl,
                name: local,
                public: 1,
                owner: 0,
                parent: 0,
                payload: body,
                deps: deps,
                text: u8[]
            }
        );
        at += 1;
    }
    keep := iface_keep(&items);
    mut out = u8[];
    // The magic and the version: the first thing the reader checks and the first thing a diagnostic
    // can name. A file written by another compiler is refused here, never misread.
    out.push(71);
    out.push(82);
    out.push(73);
    out.push(70);
    out.push(IFACE_VERSION);
    mut head = u8[];
    iface_ws(&mut head, view(m));
    iface_ws(&mut head, view(path));
    iface_w1(&mut head, in_std);
    iface_w1(&mut head, unsafe_flag);
    iface_w1(&mut head, host_opt);
    iface_w1(&mut head, c.overflow);
    iface_w1(&mut head, c.target);
    iface_w1(&mut head, c.plat);
    // Last, so a compiler that predates the field reads its absence as a truncated record rather
    // than misreading the bytes that follow.
    iface_ws(&mut head, view(iface_dyn_abi()));
    iface_wrec(&mut out, IFACE_TAG_MODULE, view(head));
    for i in c.libs.len() {
        if same(view(c.lib_owner[i]), view(m)) {
            mut body = u8[];
            iface_ws(&mut body, view(c.libs[i]));
            iface_wrec(&mut out, IFACE_TAG_LINK, view(body));
        }
    }
    for i in items.len() {
        if items[i].parent != 0 {
            continue;
        }
        if keep[i] == 0 {
            continue;
        }
        tag := items[i].tag;
        if iface_is_section(tag) {
            mut body = items[i].payload.copy();
            mut n = 0;
            for j in items.len() {
                if (items[j].parent == i + 1) & (keep[j] != 0) {
                    n += 1;
                }
            }
            iface_wv(&mut body, n);
            for j in items.len() {
                if (items[j].parent == i + 1) & (keep[j] != 0) {
                    iface_wrec(&mut body, IFACE_TAG_FN, view(items[j].payload));
                }
            }
            iface_wrec(&mut out, tag, view(body));
        } else {
            iface_wrec(&mut out, tag, view(items[i].payload));
        }
    }
    listed := iface_listed_fns(&items, &keep);
    facts := iface_facts_bytes(&mut c, view(m), &listed);
    if facts.len() != 0 {
        iface_wrec(&mut out, IFACE_TAG_FACTS, view(facts));
    }
    mut source_digest = digest.copy();
    if source_digest.len() == 0 {
        if iface_source_len(&mut c, view(path)) == 0 {
            iface_refuse(view(path), view("cannot read the source this interface describes"));
        }
        source_digest = iface_source_digest(&mut c, view(path));
    }
    // The trailer: the source digest, then the digest of every byte above it. The cache keys on the
    // bytes before the trailer (the surface), so a module edit that changes no declaration leaves
    // every other module's key alone.
    iface_seal_out(&mut out, view(source_digest));
    return out;
}
// The trailer: the source digest, then the digest of every byte above it.
fn iface_seal_out<a, b>(out: (&a mut u8[]), source_digest: &b [u8]) -> unit {
    out.push(IFACE_TAG_TRAILER);
    iface_wv(&mut out, iface_vlen(source_digest.len()) + source_digest.len() + 32);
    iface_ws(&mut out, view(source_digest));
    d := sha256(&out);
    for i in d.len() {
        out.push(d[i]);
    }
    return ();
}
// The summary record of module `m`: one entry per function of the module whose facts this run knows -
// a body it emitted and solved, or a row it read (what makes a read file write back identically).
// Empty when it knows none, which is what an interface written before any body was emitted carries:
// a reader then knows nothing about those functions, and nothing is the conservative answer.
// The functions an interface lists: the summary covers exactly these, the symbols another run can
// name, so a file read back has a declaration for every entry.
fn iface_listed_fns<a, b>(items: (&a IItem[]), keep: (&b u64[])) -> u64[] {
    mut out = u64[];
    for i in items.len() {
        if (keep[i] != 0) && (items[i].tag == IFACE_TAG_FN) {
            out.push(items[i].index);
        }
    }
    return out;
}
fn iface_facts_bytes<a, b, d>(c: (&a mut C), m: &b [u8], listed: (&d u64[])) -> u8[] {
    // One entry per symbol, in symbol order: the order a read file's declarations come back in is
    // not the order the source declared them, and the bytes must not depend on either.
    mut parts = u8[][];
    mut n = 0;
    mut seen = u8[][];
    for li in listed.len() {
        i := listed[li];
        if i >= c.funcs.len() {
            continue;
        }
        sym := fx_func_symbol(&mut c, i);
        k := fx_find(&mut c, view(sym));
        if k == 0 {
            continue;
        }
        kk := k - 1;
        mut a = 0;
        mut p = 0;
        if c.fx_body[kk] != 0 {
            a = c.fx_alloc[kk];
            p = c.fx_panic[kk];
        } else {
            if c.fx_row[kk] == 0 {
                continue;
            }
            a = c.fx_own_alloc[kk];
            p = c.fx_own_panic[kk];
        }
        mut dup = 0;
        for j in seen.len() {
            if same(view(seen[j]), view(sym)) {
                dup = 1;
            }
        }
        if dup != 0 {
            continue;
        }
        seen.push(sym.copy());
        mut entries = u8[];
        mut shown = c.fx_fn_name[kk].copy();
        if shown.len() == 0 {
            shown = sym.copy();
        }
        iface_ws(&mut entries, view(sym));
        iface_ws(&mut entries, view(shown));
        iface_w1(&mut entries, a);
        iface_w1(&mut entries, p);
        iface_w1(&mut entries, c.fx_entry_panic[kk]);
        mut at = u8[];
        if (a != 0) && (c.fx_alloc_thru[kk] != 0) {
            at = c.fx_syms[c.fx_alloc_thru[kk] - 1].copy();
        }
        mut pt = u8[];
        if (p != 0) && (c.fx_panic_thru[kk] != 0) {
            pt = c.fx_syms[c.fx_panic_thru[kk] - 1].copy();
        }
        iface_ws(&mut entries, view(at));
        iface_ws(&mut entries, view(pt));
        // Insertion by symbol: `seen` and `parts` stay in step.
        mut j = parts.len();
        parts.push(entries);
        while (j > 0) && bytes_less(view(seen[seen.len() - 1]), view(fx_sym_of_part(&parts[j - 1]))) {
            parts.swap(j, j - 1);
            j -= 1;
        }
        n += 1;
    }
    if n == 0 {
        return u8[];
    }
    mut body = u8[];
    iface_wv(&mut body, n);
    for i in parts.len() {
        push_bytes(&mut body, view(parts[i]));
    }
    return body;
}
// The symbol an encoded summary entry starts with.
fn fx_sym_of_part<a>(part: (&a u8[])) -> u8[] {
    mut at = 0;
    mut len = 0;
    mut scale = 1;
    mut more = 1;
    while (more != 0) & (at < part.len()) {
        b := part[at];
        at += 1;
        len = len + (b & 127) * scale;
        if (b & 128) == 0 {
            more = 0;
        } else {
            scale = scale * 128;
        }
    }
    mut out = u8[];
    for i in len {
        out.push(part[at + i]);
    }
    return out;
}
// Byte-wise order: `a` before `b`.
fn bytes_less<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    mut i = 0;
    while (i < x.len()) && (i < y.len()) {
        if x[i] != y[i] {
            return x[i] < y[i];
        }
        i += 1;
    }
    return x.len() < y.len();
}
// The interface without its summary record, sealed again: the declarations alone.
fn iface_without_facts<a>(bytes: &a [u8]) -> u8[] {
    mut out = u8[];
    if bytes.len() < 5 {
        return copy_bytes(view(bytes));
    }
    for i in 5 {
        out.push(bytes[i]);
    }
    mut at = 5;
    mut found = 0;
    while at < bytes.len() {
        tag_at := at;
        tag := bytes[at];
        at += 1;
        mut len = 0;
        mut scale = 1;
        mut more = 1;
        while (more != 0) & (at < bytes.len()) {
            b := bytes[at];
            at += 1;
            len = len + (b & 127) * scale;
            if (b & 128) == 0 {
                more = 0;
            } else {
                scale = scale * 128;
            }
        }
        if tag == IFACE_TAG_TRAILER {
            break;
        }
        if tag == IFACE_TAG_FACTS {
            found = 1;
        } else {
            for i in tag_at..at + len {
                out.push(bytes[i]);
            }
        }
        at = at + len;
    }
    if found == 0 {
        return copy_bytes(view(bytes));
    }
    head := iface_r_head(view(""), view(bytes));
    iface_seal_out(&mut out, view(head.digest));
    return out;
}
// `text` (an interface this run wrote before its bodies were emitted) with the summary of module `m`
// added in front of the trailer, and sealed again: the bytes are exactly what `iface_module_bytes`
// writes for the same module once its facts are known, so a re-read file round-trips.
fn iface_with_facts<a, b>(c: (&a mut C), text: &a [u8], m: &b [u8]) -> u8[] {
    exchange(&mut c.iface_env, u64[]);
    exchange(&mut c.iface_env_names, u8[][]);
    items := iface_items(&mut c, view(m));
    keep := iface_keep(&items);
    listed := iface_listed_fns(&items, &keep);
    facts := iface_facts_bytes(&mut c, view(m), &listed);
    if facts.len() == 0 {
        return copy_bytes(view(text));
    }
    mut out = iface_surface(view(text));
    iface_wrec(&mut out, IFACE_TAG_FACTS, view(facts));
    head := iface_r_head(view(""), view(text));
    iface_seal_out(&mut out, view(head.digest));
    return out;
}
// The trailer's offset, validated: the magic, the version, every record's framing and the file's own
// digest. Returns the source digest the file records. A bad version, a truncated file, an unknown
// record or an edited byte is refused here, by name, before one declaration is installed.
fn iface_seal<a>(path: &a [u8], data: &a [u8]) -> u8[] {
    if data.len() < 5 {
        iface_refuse(view(path), view("is not an interface file: it is too short to carry a `GRIF` header"));
    }
    if !((data[0] == 71) & (data[1] == 82) & (data[2] == 73) & (data[3] == 70)) {
        if iface_starts(view(data), view("// grail-interface")) {
            mut msg = u8[];
            push_bytes(&mut msg, view("was written in the old text interface format; this compiler reads interface format "));
            decimal(&mut msg, IFACE_VERSION);
            push_bytes(&mut msg, view(". Re-emit it with `grail check --interface DIR`"));
            iface_refuse(view(path), view(msg));
        }
        iface_refuse(view(path), view("is not an interface file: it has no `GRIF` header"));
    }
    version := data[4];
    if version != IFACE_VERSION {
        mut msg = u8[];
        if IFACE_VERSION < version {
            push_bytes(&mut msg, view("was written in interface format "));
            decimal(&mut msg, version);
            push_bytes(&mut msg, view(" by a newer compiler; this one reads format "));
            decimal(&mut msg, IFACE_VERSION);
        } else {
            push_bytes(&mut msg, view("was written in interface format "));
            decimal(&mut msg, version);
            push_bytes(&mut msg, view("; this compiler reads format "));
            decimal(&mut msg, IFACE_VERSION);
            push_bytes(&mut msg, view(": regenerate it with `grail check --interface DIR`"));
        }
        iface_refuse(view(path), view(msg));
    }
    mut p = IR {
        data: data.copy(),
        at: 5,
        stop: data.len(),
        path: path.copy(),
        phase: 1,
        rtext: u8[],
        what: copy_bytes(view("the interface"))
    };
    mut source_digest = u8[];
    mut first = 1;
    mut sealed = 0;
    while p.at < p.stop {
        tag := iface_r1(&mut p);
        if !iface_known_tag(tag) {
            mut msg = u8[];
            push_bytes(&mut msg, view("carries an unknown record (tag "));
            decimal(&mut msg, tag);
            push_bytes(&mut msg, view("): it was written by a newer compiler, and this one reads interface format "));
            decimal(&mut msg, IFACE_VERSION);
            push_bytes(&mut msg, view(" ("));
            push_bytes(&mut msg, view(iface_where(&p)));
            push_bytes(&mut msg, view(")"));
            iface_refuse(view(path), view(msg));
        }
        len := iface_rv(&mut p);
        if (p.stop < p.at) || ((p.stop - p.at) < len) {
            iface_bad(&mut p, view("is truncated: a record says it is longer than the rest of the file"));
        }
        if first == 1 {
            if tag != IFACE_TAG_MODULE {
                iface_bad(&mut p, view("does not start with a `module` record"));
            }
            first = 0;
        }
        saved := p.stop;
        p.stop = p.at + len;
        start := p.at;
        if tag == IFACE_TAG_TRAILER {
            source_digest = iface_rs(&mut p);
            iface_need(&mut p, 32);
            cover := p.at;
            mut prefix = u8[];
            for i in cover {
                prefix.push(data[i]);
            }
            got := sha256(&prefix);
            mut ok = 1;
            for i in 32 {
                if got[i] != data[cover + i] {
                    exchange(&mut ok, 0);
                }
            }
            if ok == 0 {
                iface_refuse(
                    view(path),
                    view("changed after it was written: the digest in its trailer does not match the file (edit or regenerate it with `grail check --interface DIR`)")
                );
            }
            p.at = p.at + 32;
            iface_rend(&mut p, start);
            sealed = 1;
        } else {
            p.at = p.at + len;
        }
        p.stop = saved;
        if sealed != 0 {
            if p.at != p.stop {
                iface_bad(&mut p, view("carries records after its trailer"));
            }
            return source_digest;
        }
    }
    if sealed == 0 {
        iface_refuse(view(path), view("has no trailer: it is not a complete interface (regenerate it with `grail check --interface DIR`)"));
    }
    return source_digest;
}
// What a header record says. Read in every phase, because the checks below apply to all of them.
struct IHead {
    module: u8[],
    source: u8[],
    std: u64,
    unsafe: u64,
    host: u64,
    overflow: u64,
    target: u64,
    plat: u64,
    dyn_abi: u8[],
    digest: u8[],
    next: u64
}
fn iface_r_head<a>(path: &a [u8], data: &a [u8]) -> IHead {
    digest := iface_seal(view(path), view(data));
    mut p = IR {
        data: data.copy(),
        at: 5,
        stop: data.len(),
        path: path.copy(),
        phase: 1,
        rtext: u8[],
        what: copy_bytes(view("the interface"))
    };
    saved := iface_rec(&mut p, IFACE_TAG_MODULE);
    start := p.at;
    module := iface_rs(&mut p);
    source := iface_rs(&mut p);
    std := iface_r1(&mut p);
    unsafe_flag := iface_r1(&mut p);
    host := iface_r1(&mut p);
    overflow := iface_r1(&mut p);
    target := iface_r1(&mut p);
    plat := iface_r1(&mut p);
    // The ABI field is required, so a header that ends before it is not "truncated": it is a file
    // that does not say what a borrowed `dyn` value is, which is the same class of surprise as a
    // file with no module name. Say that, rather than reporting the bytes a record was short by.
    if p.at >= p.stop {
        iface_refuse(view(path), view("carries no `dyn` ABI field: it does not say what a borrowed `dyn` value is"));
    }
    dyn_abi := iface_rs(&mut p);
    iface_rend(&mut p, start);
    p.stop = saved;
    return IHead {
        module: module,
        source: source,
        std: std,
        unsafe: unsafe_flag,
        host: host,
        overflow: overflow,
        target: target,
        plat: plat,
        dyn_abi: dyn_abi,
        digest: digest,
        next: p.at
    };
}

// ---- installing (or describing) the records ----
fn iface_r_bounds<a>(p: (&a mut IR), n: u64) -> u64[] {
    mut out = u64[];
    for i in n {
        out.push(0);
    }
    count := iface_rv(&mut p);
    for i in count {
        at := iface_rv(&mut p);
        bits := iface_rv(&mut p);
        if !(at < n) {
            iface_bad(&mut p, view("carries a bound on a parameter the declaration does not have"));
        }
        if p.phase == 0 {
            push_bytes(&mut p.rtext, view(" bound="));
            decimal(&mut p.rtext, at);
            p.rtext.push(58);
            decimal(&mut p.rtext, bits);
        }
        exchange(&mut out[at], bits);
    }
    return out;
}
fn iface_r_reqs<a>(p: (&a mut IR), c: (&a mut C), n: u64) -> u64[][] {
    mut out = u64[][];
    for i in n {
        out.push(u64[]);
    }
    count := iface_rv(&mut p);
    for i in count {
        at := iface_rv(&mut p);
        if !(at < n) {
            iface_bad(&mut p, view("carries a requirement on a parameter the declaration does not have"));
        }
        m := iface_rv(&mut p);
        for j in m {
            module := iface_rs(&mut p);
            name := iface_rs(&mut p);
            if (module.len() == 0) && (name.len() == 0) {
                if p.phase == 0 {
                    push_bytes(&mut p.rtext, view(" callable="));
                }
                bound := iface_r_type(&mut p, &mut c);
                if p.phase == 2 {
                    out[at].push(CALLABLE_BOUND + bound);
                }
                continue;
            }
            if p.phase == 2 {
                id := iface_find_iface(&mut c, &mut p, view(module), view(name));
                out[at].push(id);
            }
            if p.phase == 0 {
                push_bytes(&mut p.rtext, view(" require="));
                push_bytes(&mut p.rtext, view(module));
                push_bytes(&mut p.rtext, view("::"));
                push_bytes(&mut p.rtext, view(name));
            }
        }
    }
    return out;
}
// A new rendered line begins with a break, so a record that renders nothing nested leaves no blank
// line and a record that renders several never glues them together.
fn iface_rt_indent<a, b>(p: (&a mut IR), indent: &b [u8]) -> unit {
    if p.phase == 0 {
        if p.rtext.len() != 0 {
            if p.rtext[p.rtext.len() - 1] != 10 {
                p.rtext.push(10);
            }
        }
        push_bytes(&mut p.rtext, view(indent));
    }
    return ();
}
fn iface_rec_type<a>(c: (&a mut C), p: (&a mut IR)) -> unit {
    module := iface_rs(&mut p);
    name := iface_rs(&mut p);
    public := iface_r1(&mut p);
    kind := iface_r1(&mut p);
    params := iface_rv(&mut p);
    lifetimes := iface_rv(&mut p);
    transfer := iface_rv(&mut p);
    share := iface_rv(&mut p);
    bounds := iface_r_bounds(&mut p, params);
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("type "));
        push_bytes(&mut p.rtext, view(module));
        push_bytes(&mut p.rtext, view("::"));
        push_bytes(&mut p.rtext, view(name));
        if kind == 3 {
            push_bytes(&mut p.rtext, view(" handle"));
        } else if kind == 2 {
            push_bytes(&mut p.rtext, view(" enum"));
        } else if kind == 1 {
            push_bytes(&mut p.rtext, view(" record"));
        } else {
            push_bytes(&mut p.rtext, view(" struct"));
        }
        iface_rt_num(&mut p, view(" params="), params);
        iface_rt_num(&mut p, view(" lifetimes="), lifetimes);
        if kind == 3 {
            iface_rt_num(&mut p, view(" transfer="), transfer);
            iface_rt_num(&mut p, view(" share="), share);
        }
        iface_rt_num(&mut p, view(" public="), public);
    }
    reqs := iface_r_reqs(&mut p, &mut c, params);
    mut count = 0;
    count = iface_rv(&mut p);
    mut index = 0;
    mut first = 0;
    if p.phase == 1 {
        c.decls.push(Decl {
            public: public,
            module: copy_bytes(view(module)),
            name: copy_bytes(view(name)),
            declared_at: u8[],
            is_enum: u64(kind == 2),
            opaque: u64(kind == 3),
            transfer: transfer,
            share: share,
            c_layout: u64(kind == 1),
            first: 0,
            count: 0,
            drop: 0,
            regions: lifetimes,
            types: params,
            success: 0,
            // A copy: the definition phase installs the resolved ones, because a requirement names
            // an interface and only that phase can look one up.
            bounds: copy_numbers(&bounds),
            constraints: copy_constraints(&reqs)
        });
    }
    if p.phase == 2 {
        index = iface_find_decl(&mut c, &mut p, view(module), view(name));
        first = c.fields.len();
        exchange(&mut c.decls[index].first, first);
        exchange(&mut c.decls[index].count, 0);
        // The bounds and the interface requirements of the declaration itself. They are read in the
        // name phase too, but a requirement names another interface and only the definition phase
        // can resolve one, so they are installed here - `Map<K, V>`'s `Hash`/`Equal` are the case
        // this was written for.
        exchange(&mut c.decls[index].bounds, bounds);
        exchange(&mut c.decls[index].constraints, reqs);
    }
    if p.phase == 0 {
    }
    for i in count {
        field := iface_rs(&mut p);
        if p.phase == 0 {
            iface_rt_indent(&mut p, view("  field "));
            push_bytes(&mut p.rtext, view(field));
            p.rtext.push(32);
        }
        ty := iface_r_type(&mut p, &mut c);
        pred := iface_rs(&mut p);
        if p.phase == 0 {
                if pred.len() != 0 {
                iface_rt_indent(&mut p, view("  fwhere "));
                push_bytes(&mut p.rtext, view(field));
                push_bytes(&mut p.rtext, view(" \""));
                push_bytes(&mut p.rtext, view(pred));
                push_bytes(&mut p.rtext, view("\""));
                    }
        }
        if p.phase == 2 {
            mut pr = no_pred();
            if pred.len() != 0 {
                mut label = u8[];
                push_bytes(&mut label, view(p.path));
                label.push(58);
                push_bytes(&mut label, view(name));
                label.push(46);
                push_bytes(&mut label, view(field));
                pr = pred_of_text(&mut c, view(label), view(pred));
            }
            c.fields.push(Field { name: copy_bytes(view(field)), ty: ty, pred: pr });
            exchange(&mut c.decls[index].count, c.fields.len() - first);
        }
    }
    return ();
}
fn iface_rec_alias<a>(c: (&a mut C), p: (&a mut IR)) -> unit {
    module := iface_rs(&mut p);
    name := iface_rs(&mut p);
    public := iface_r1(&mut p);
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("alias "));
        push_bytes(&mut p.rtext, view(module));
        push_bytes(&mut p.rtext, view("::"));
        push_bytes(&mut p.rtext, view(name));
        iface_rt_num(&mut p, view(" public="), public);
        p.rtext.push(32);
    }
    ty := iface_r_type(&mut p, &mut c);
    if p.phase == 0 {
    }
    if p.phase == 1 {
        if find_alias(&mut c, view(module), view(name)) != 0 {
            iface_bad(&mut p, view("declares a type alias twice"));
        }
        c.aliases.push(Alias { module: copy_bytes(view(module)), name: copy_bytes(view(name)), declared_at: u8[], public: public, ty: NO_TYPE });
    }
    if p.phase == 2 {
        a := find_alias(&mut c, view(module), view(name));
        if a == 0 {
            iface_bad(&mut p, view("carries a type alias this program does not declare"));
        }
        exchange(&mut c.aliases[a - 1].ty, ty);
    }
    return ();
}
fn iface_rec_const<a>(c: (&a mut C), p: (&a mut IR)) -> unit {
    module := iface_rs(&mut p);
    name := iface_rs(&mut p);
    public := iface_r1(&mut p);
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("const "));
        push_bytes(&mut p.rtext, view(module));
        push_bytes(&mut p.rtext, view("::"));
        push_bytes(&mut p.rtext, view(name));
        iface_rt_num(&mut p, view(" public="), public);
        p.rtext.push(32);
    }
    ty := iface_r_type(&mut p, &mut c);
    kind := iface_r1(&mut p);
    value := iface_rv(&mut p);
    text := iface_rs(&mut p);
    if p.phase == 0 {
        if kind == 2 {
            iface_rt_num(&mut p, view(" seq "), value);
            push_bytes(&mut p.rtext, view(" "));
            push_bytes(&mut p.rtext, view(iface_hex(&text)));
        } else if kind == 1 {
            push_bytes(&mut p.rtext, view(" str "));
            push_bytes(&mut p.rtext, view(iface_hex(&text)));
        } else {
            iface_rt_num(&mut p, view(" int "), value);
        }
    }
    if p.phase == 2 {
        if kind == 2 {
            if ct_seq_elem(&mut c, ty) == NO_TYPE {
                iface_bad(&mut p, view("carries a table constant whose type is not a vector of integers or bytes"));
            }
        } else if kind == 1 {
            if ty != 3 {
                iface_bad(&mut p, view("carries a text constant whose type is not string"));
            }
        } else if kind != 0 {
            iface_bad(&mut p, view("carries a constant of an unknown kind"));
        }
        c.constants.push(
            Constant {
                public: public,
                module: copy_bytes(view(module)),
                name: copy_bytes(view(name)),
                declared_at: u8[],
                file: 0,
                at: 0,
                ty: ty,
                value: value,
                text: text
            }
        );
    }
    return ();
}
fn iface_rec_static<a>(c: (&a mut C), p: (&a mut IR)) -> unit {
    module := iface_rs(&mut p);
    name := iface_rs(&mut p);
    public := iface_r1(&mut p);
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("static "));
        push_bytes(&mut p.rtext, view(module));
        push_bytes(&mut p.rtext, view("::"));
        push_bytes(&mut p.rtext, view(name));
        iface_rt_num(&mut p, view(" public="), public);
        p.rtext.push(32);
    }
    ty := iface_r_type(&mut p, &mut c);
    tier := iface_r1(&mut p);
    fact_kind := iface_r1(&mut p);
    fact := iface_rv(&mut p);
    if p.phase == 0 {
        iface_rt_num(&mut p, view(" tier "), tier);
        if fact_kind == 1 {
            iface_rt_num(&mut p, view(" value "), fact);
        }
        if fact_kind == 2 {
            iface_rt_num(&mut p, view(" len "), fact);
        }
    }
    if p.phase == 2 {
        if tier != 1 {
            iface_bad(&mut p, view("carries a static of a tier this compiler does not build"));
        }
        if find_static(&mut c, view(module), view(name)) == 0 {
            c.statics.push(
                Static {
                    module: copy_bytes(view(module)),
                    name: copy_bytes(view(name)),
                    declared_at: u8[],
                    file: 0,
                    at: 0,
                    public: public,
                    ty: ty,
                    imported: 1,
                    init_at: 0,
                    state: 2,
                    ready: 1,
                    value: 0,
                    text: u8[],
                    fact_kind: fact_kind,
                    fact: fact
                }
            );
        }
    }
    return ();
}
// A function record. `module` is where it is filed (the module itself, `.inherent_N`, `.interface_N`
// or `.impl_N`) and `home` is the module whose interface carries it; `owner` and `contract` travel in
// the record, so the reader installs exactly what the writer wrote instead of re-deriving them.
fn iface_rec_fn<a>(c: (&a mut C), p: (&a mut IR), home: &a [u8], module: &a [u8], indent: &a [u8], source_index: u64, raw_flag: u64, section: u64, implementation: u64, owner: u64, contract: u64) -> unit {
    name := iface_rs(&mut p);
    public := iface_r1(&mut p);
    types := iface_rv(&mut p);
    regions := iface_rv(&mut p);
    ext_word := iface_rv(&mut p);
    ext := ext_word & 255;
    symbol := iface_rs(&mut p);
    if (ext_word & 512) != 0 {
        c.ffi_nonblocking.push(symbol.copy());
    }
    // `extern "C" blocking` in the module that declared it (bit 8): calls from here hand off too.
    if (ext_word & 256) != 0 {
        mut known = false;
        for bi in c.ffi_blocking.len() {
            if same(view(c.ffi_blocking[bi]), view(symbol)) {
                known = true;
            }
        }
        if !known {
            c.ffi_blocking.push(symbol.copy());
        }
    }
    strict := iface_r1(&mut p);
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(indent));
        push_bytes(&mut p.rtext, view("fn "));
        if module.len() != 0 {
            push_bytes(&mut p.rtext, view(module));
            push_bytes(&mut p.rtext, view("::"));
        }
        push_bytes(&mut p.rtext, view(name));
        if types != 0 {
            iface_rt_num(&mut p, view(" <"), types);
            push_bytes(&mut p.rtext, view(">"));
        }
        push_bytes(&mut p.rtext, view(" ("));
    }
    n := iface_rv(&mut p);
    mut ptypes = u64[];
    for i in n {
        if (p.phase == 0) & (i != 0) {
            p.rtext.push(44);
        }
        ptypes.push(iface_r_type(&mut p, &mut c));
    }
    if p.phase == 0 {
        push_bytes(&mut p.rtext, view(") -> "));
    }
    ret := iface_r_type(&mut p, &mut c);
    if p.phase == 0 {
        iface_rt_num(&mut p, view(" public="), public);
        iface_rt_num(&mut p, view(" lifetimes="), regions);
        if ext != 0 {
            iface_rt_num(&mut p, view(" extern="), ext);
            if (ext_word & 256) != 0 {
                push_bytes(&mut p.rtext, view(" blocking"));
            }
            if (ext_word & 512) != 0 {
                push_bytes(&mut p.rtext, view(" nonblocking"));
            }
            push_bytes(&mut p.rtext, view(" symbol="));
            push_bytes(&mut p.rtext, view(symbol));
        }
    }
    bounds := iface_r_bounds(&mut p, types);
    reqs := iface_r_reqs(&mut p, &mut c, types);
    nwhere := iface_rv(&mut p);
    mut where_at = u64[];
    mut where_text = u8[][];
    for i in nwhere {
        at := iface_rv(&mut p);
        text := iface_rs(&mut p);
        where_at.push(at);
        where_text.push(text.copy());
        if p.phase == 0 {
            iface_rt_indent(&mut p, view("  where "));
            decimal(&mut p.rtext, at);
            push_bytes(&mut p.rtext, view(" \""));
            push_bytes(&mut p.rtext, view(text));
            push_bytes(&mut p.rtext, view("\""));
        }
    }
    // Parameter names and defaults, sparse by index: a named argument in another module fills the
    // slot a name identifies, and a default is compiled where the call is written.
    nargs := iface_rv(&mut p);
    mut args_at = u64[];
    mut args_name = u8[][];
    mut args_default = u8[][];
    for i in nargs {
        at := iface_rv(&mut p);
        name := iface_rs(&mut p);
        dtext := iface_rs(&mut p);
        args_at.push(at);
        args_name.push(name.copy());
        args_default.push(dtext.copy());
        if p.phase == 0 {
            iface_rt_indent(&mut p, view("  param "));
            decimal(&mut p.rtext, at);
            push_bytes(&mut p.rtext, view(" \""));
            push_bytes(&mut p.rtext, view(name));
            push_bytes(&mut p.rtext, view("\""));
            if dtext.len() != 0 {
                iface_rt_indent(&mut p, view("  default "));
                decimal(&mut p.rtext, at);
                push_bytes(&mut p.rtext, view(" \""));
                push_bytes(&mut p.rtext, view(dtext));
                push_bytes(&mut p.rtext, view("\""));
            }
        }
    }
    rpred := iface_rs(&mut p);
    no_alloc := iface_r1(&mut p);
    no_panic := iface_r1(&mut p);
    body := iface_rs(&mut p);
    if p.phase == 0 {
        if rpred.len() != 0 {
                iface_rt_indent(&mut p, view("  ensures \""));
            push_bytes(&mut p.rtext, view(rpred));
            push_bytes(&mut p.rtext, view("\""));
        }
        // Always rendered, zeros included: the dump shows what the record carries, so a reader of
        // the dump never has to know that an absent row would have meant `0 0 0`.
        iface_rt_indent(&mut p, view("  effects "));
        decimal(&mut p.rtext, no_alloc);
        p.rtext.push(32);
        decimal(&mut p.rtext, no_panic);
        p.rtext.push(32);
        decimal(&mut p.rtext, strict);
        if body.len() != 0 {
            iface_rt_indent(&mut p, view(indent));
            push_bytes(&mut p.rtext, view("body"));
                rows := iface_lines(view(body));
            for i in rows.len() {
                if (i + 1 == rows.len()) & (rows[i].len() == 0) {
                    continue;
                }
                iface_rt_indent(&mut p, view(indent));
                push_bytes(&mut p.rtext, view("|"));
                push_bytes(&mut p.rtext, view(rows[i]));
                    }
        }
        return ();
    }
    // A template has to carry its text: without it nobody reading this interface could instantiate
    // it, and that is a compiler bug in the writer, not a gap to accept.
    if (types != 0) & (contract == 0) & (body.len() == 0) {
        mut msg = u8[];
        push_bytes(&mut msg, view("carries no body for the generic template `"));
        push_bytes(&mut msg, view(name));
        push_bytes(&mut msg, view("`, so no importer can instantiate it"));
        iface_bad(&mut p, view(msg));
    }
    if (types != 0) & (contract == 0) & (body.len() != 0) & (p.phase == 1) {
        return ();
    }
    if p.phase == 1 {
        return ();
    }
    if find_func(&mut c, view(module), view(name)) != 0 {
        iface_bad(&mut p, view("declares a function twice"));
    }
    first := c.params.len();
    mut count = 0;
    for i in ptypes.len() {
        c.params.push(ptypes[i]);
        count += 1;
    }
    mut f = Func {
        public: public,
        home: copy_bytes(view(home)),
        module: copy_bytes(view(module)),
        name: copy_bytes(view(name)),
        first: first,
        count: count,
        ret: ret,
        types: types,
        regions: regions,
        file: source_index,
        pos: 0,
        raw: raw_flag,
        unsafe_fn: 0,
        bounds: bounds,
        constraints: reqs,
        contract: contract,
        owner: owner,
        ext: ext,
        symbol: symbol,
        body: u8[],
        ppreds: Pred[],
        rpred: no_pred(),
        pnames: u8[][],
        pdefaults: Pred[],
        strict: strict,
        no_alloc: no_alloc,
        no_panic: no_panic
    };
    c.funcs.push(f);
    index := c.funcs.len() - 1;
    for i in where_at.len() {
        at := where_at[i];
        text := where_text[i].copy();
        mut label = u8[];
        push_bytes(&mut label, view(p.path));
        label.push(58);
        push_bytes(&mut label, view(module));
        push_bytes(&mut label, view("::"));
        push_bytes(&mut label, view(c.funcs[index].name));
        label.push(35);
        decimal(&mut label, at);
        pred := pred_of_text(&mut c, view(label), view(text));
        f := &mut c.funcs[index];
        while f.ppreds.len() <= at {
            f.ppreds.push(no_pred());
        }
        exchange(&mut f.ppreds[at], pred);
    }
    for i in args_at.len() {
        at := args_at[i];
        pname := args_name[i].copy();
        dtext := args_default[i].copy();
        f := &mut c.funcs[index];
        while f.pnames.len() <= at {
            f.pnames.push(u8[]);
        }
        exchange(&mut f.pnames[at], pname);
        if dtext.len() != 0 {
            mut dlabel = u8[];
            push_bytes(&mut dlabel, view(p.path));
            dlabel.push(58);
            push_bytes(&mut dlabel, view(module));
            push_bytes(&mut dlabel, view("::"));
            push_bytes(&mut dlabel, view(c.funcs[index].name));
            push_bytes(&mut dlabel, view("#default"));
            decimal(&mut dlabel, at);
            d := pred_of_text(&mut c, view(dlabel), view(dtext));
            g := &mut c.funcs[index];
            while g.pdefaults.len() <= at {
                g.pdefaults.push(no_pred());
            }
            exchange(&mut g.pdefaults[at], d);
        }
    }
    if rpred.len() != 0 {
        mut label = u8[];
        push_bytes(&mut label, view(p.path));
        label.push(58);
        push_bytes(&mut label, view(module));
        push_bytes(&mut label, view("::"));
        push_bytes(&mut label, view(name));
        push_bytes(&mut label, view("#result"));
        pred := pred_of_text(&mut c, view(label), view(rpred));
        exchange(&mut c.funcs[index].rpred, pred);
    }
    if (no_alloc != 0) || (no_panic != 0) {
        exchange(&mut c.fx_any, 1);
    }
    if (types != 0) & (contract == 0) & (body.len() != 0) {
        mut label = u8[];
        push_bytes(&mut label, view(p.path));
        label.push(58);
        push_bytes(&mut label, view(module));
        push_bytes(&mut label, view("::"));
        push_bytes(&mut label, view(name));
        file := virtual_source(&mut c, view(label), view(body));
        exchange(&mut c.funcs[index].file, file);
        exchange(&mut c.funcs[index].pos, 0);
        exchange(&mut c.funcs[index].body, body.copy());
    }
    if section == 3 {
        // An implementation's method list is what dispatch walks.
        mut item = &mut c.implementations[implementation - 1];
        item.methods.push(index);
    }
    if section == 2 {
        // The interface's own method list is what `check_interfaces` compares an implementation
        // against, so it has to be as complete as the implementations are.
        // A default body travels as its text: it becomes a source of its own, compiled for every
        // implementation that leaves the method out, as it is in the interface's own module.
        mut dfile = 0;
        if body.len() != 0 {
            mut label = u8[];
            push_bytes(&mut label, view(p.path));
            label.push(58);
            push_bytes(&mut label, view(module));
            push_bytes(&mut label, view("::"));
            push_bytes(&mut label, view(name));
            push_bytes(&mut label, view("#default"));
            dfile = virtual_source(&mut c, view(label), view(body));
        }
        mut item = &mut c.interfaces[contract - 1];
        while item.defaults.len() < item.methods.len() {
            item.defaults.push(0);
            item.default_files.push(0);
        }
        item.methods.push(index);
        if dfile != 0 {
            item.defaults.push(1);
        } else {
            item.defaults.push(0);
        }
        item.default_files.push(dfile);
    }
    return ();
}
fn iface_r_impl_params<a>(c: (&a mut C), p: (&a mut IR), key_params: u64, key_plain: u64) -> u64 {
    present := iface_r1(&mut p);
    if (p.phase == 0) & (present != 0) {
        push_bytes(&mut p.rtext, view(" params"));
    }
    if present == 0 {
        return 0;
    }
    ntypes := iface_rv(&mut p);
    mut tnames = u8[][];
    for i in ntypes {
        tnames.push(iface_rs(&mut p));
    }
    nlifetimes := iface_rv(&mut p);
    mut rnames = u8[][];
    for i in nlifetimes {
        rnames.push(iface_rs(&mut p));
    }
    if p.phase == 0 {
        push_bytes(&mut p.rtext, view("="));
        decimal(&mut p.rtext, ntypes);
        iface_rt_num(&mut p, view(" lifetimes="), nlifetimes);
        for i in tnames.len() {
            iface_rt_indent(&mut p, view("  ptype "));
            push_bytes(&mut p.rtext, view(tnames[i]));
        }
        for i in rnames.len() {
            iface_rt_indent(&mut p, view("  rname "));
            push_bytes(&mut p.rtext, view(rnames[i]));
        }
    }
    bounds := iface_r_bounds(&mut p, ntypes);
    reqs := iface_r_reqs(&mut p, &mut c, ntypes);
    mut key = key_params;
    if ntypes == 0 {
        key = key_plain;
    }
    if (p.phase != 2) || (key == 0) {
        return 0;
    }
    c
        .impl_params
        .push(
            ImplParams {
                decl: key,
                rnames: rnames,
                tnames: tnames,
                bounds: bounds,
                interfaces: reqs,
                self_ty: NO_TYPE
            }
        );
    return c.impl_params.len();
}
fn iface_rec_inherent<a>(c: (&a mut C), p: (&a mut IR), home: &a [u8], source_index: u64, raw_flag: u64) -> unit {
    module := iface_rs(&mut p);
    name := iface_rs(&mut p);
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("inherent "));
        push_bytes(&mut p.rtext, view(module));
        push_bytes(&mut p.rtext, view("::"));
        push_bytes(&mut p.rtext, view(name));
    }
    mut owner = 0;
    mut filed = u8[];
    if p.phase == 2 {
        owner = iface_find_decl(&mut c, &mut p, view(module), view(name));
        filed = private_module(view(".inherent_"), owner);
    }
    iface_r_impl_params(&mut c, &mut p, owner + 1, owner + 1);
    n := iface_rv(&mut p);
    for i in n {
        saved := p.stop;
        iface_rec(&mut p, IFACE_TAG_FN);
        iface_rec_fn(&mut c, &mut p, view(home), view(filed), view("  "), source_index, raw_flag, 1, 0, owner + 1, 0);
        p.stop = saved;
    }
    return ();
}
// A written type's inherent section: the owner type, the impl's own parameters, then its methods.
// The owner is registered under the header the section spells - its type and its parameters
// (iface_same_header) - which is how the source parse keys the same block, so a method read from
// here and one compiled from the source are found by one lookup.
fn iface_rec_inherent_type<a>(c: (&a mut C), p: (&a mut IR), home: &a [u8], source_index: u64, raw_flag: u64) -> unit {
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("inherent_type "));
    }
    owner_ty := iface_r_type(&mut p, &mut c);
    // The section's parameters are read under a key no impl has yet; whether that key is kept is
    // decided once they are known, because the header is the owner type *and* its parameters:
    // `impl<T> T[]` and `impl<T: Ord> T[]` spell one owner type and are two impls.
    mut key = 0;
    if p.phase == 2 {
        key = inherent_type_base() + c.inherent_types.len() + 1;
    }
    mut record = iface_r_impl_params(&mut c, &mut p, key, key);
    mut filed = u8[];
    if p.phase == 2 {
        if record == 0 {
            // A written section always has a record, whatever its parameter count: it is where
            // `impl_self` finds the owner type.
            c
                .impl_params
                .push(
                    ImplParams {
                        decl: key,
                        rnames: u8[][],
                        tnames: u8[][],
                        bounds: u64[],
                        interfaces: u64[][],
                        self_ty: owner_ty
                    }
                );
            record = c.impl_params.len();
        } else {
            exchange(&mut c.impl_params[record - 1].self_ty, owner_ty);
        }
        // The same header read before (another module's interface, or the source itself) is the
        // same impl: its key stands and the record just read is dropped.
        mut known = 0;
        for i in c.inherent_types.len() {
            if (known == 0) && iface_same_header(&mut c, inherent_type_base() + i + 1, owner_ty, record) {
                known = inherent_type_base() + i + 1;
            }
        }
        if known != 0 {
            c.impl_params.pop()!;
            key = known;
        } else {
            c.inherent_types.push(owner_ty);
        }
        filed = inherent_type_module(key);
    }
    n := iface_rv(&mut p);
    for i in n {
        saved := p.stop;
        iface_rec(&mut p, IFACE_TAG_FN);
        iface_rec_fn(&mut c, &mut p, view(home), view(filed), view("  "), source_index, raw_flag, 1, 0, key, 0);
        p.stop = saved;
    }
    return ();
}
fn iface_rec_iface<a>(c: (&a mut C), p: (&a mut IR), home: &a [u8], source_index: u64, raw_flag: u64) -> unit {
    module := iface_rs(&mut p);
    name := iface_rs(&mut p);
    public := iface_r1(&mut p);
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("interface "));
        push_bytes(&mut p.rtext, view(module));
        push_bytes(&mut p.rtext, view("::"));
        push_bytes(&mut p.rtext, view(name));
        iface_rt_num(&mut p, view(" public="), public);
    }
    nsupers := iface_rv(&mut p);
    mut supers = u64[];
    for i in nsupers {
        sup_module := iface_rs(&mut p);
        sup_name := iface_rs(&mut p);
        if p.phase == 0 {
            iface_rt_indent(&mut p, view("  super "));
            push_bytes(&mut p.rtext, view(sup_module));
            push_bytes(&mut p.rtext, view("::"));
            push_bytes(&mut p.rtext, view(sup_name));
        } else {
            supers.push(ensure_interface(&mut c, sup_module, sup_name));
        }
    }
    nassoc := iface_rv(&mut p);
    mut assoc = u8[][];
    for i in nassoc {
        assoc.push(iface_rs(&mut p));
        if p.phase == 0 {
            iface_rt_indent(&mut p, view("  assoc "));
            push_bytes(&mut p.rtext, view(assoc[assoc.len() - 1]));
        }
    }
    mut id = 0;
    if p.phase == 1 {
        id = ensure_interface(&mut c, copy_bytes(view(module)), copy_bytes(view(name)));
        exchange(&mut c.interfaces[id - 1].defined, 1);
        exchange(&mut c.interfaces[id - 1].public, public);
    }
    if p.phase == 2 {
        id = iface_find_iface(&mut c, &mut p, view(module), view(name));
        exchange(&mut c.interfaces[id - 1].defined, 1);
        exchange(&mut c.interfaces[id - 1].public, public);
        for i in supers.len() {
            known := copy_numbers(&c.interfaces[id - 1].supers);
            mut have = false;
            for j in known.len() {
                if known[j] == supers[i] {
                    have = true;
                }
            }
            if !have {
                mut item = &mut c.interfaces[id - 1];
                item.supers.push(supers[i]);
            }
        }
        for i in assoc.len() {
            known := copy_names(&c.interfaces[id - 1].assoc);
            mut have = false;
            for j in known.len() {
                if same(view(known[j]), view(assoc[i])) {
                    have = true;
                }
            }
            if !have {
                mut item = &mut c.interfaces[id - 1];
                item.assoc.push(assoc[i].copy());
            }
        }
    }
    n := iface_rv(&mut p);
    mut filed = u8[];
    if p.phase == 2 {
        filed = private_module(view(".interface_"), id);
    }
    for i in n {
        saved := p.stop;
        iface_rec(&mut p, IFACE_TAG_FN);
        iface_rec_fn(&mut c, &mut p, view(home), view(filed), view("  "), source_index, raw_flag, 2, 0, 0, id);
        p.stop = saved;
    }
    return ();
}
fn iface_rec_impl<a>(c: (&a mut C), p: (&a mut IR), home: &a [u8], source_index: u64, raw_flag: u64) -> unit {
    contract_module := iface_rs(&mut p);
    contract_name := iface_rs(&mut p);
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("impl "));
        push_bytes(&mut p.rtext, view(contract_module));
        push_bytes(&mut p.rtext, view("::"));
        push_bytes(&mut p.rtext, view(contract_name));
        push_bytes(&mut p.rtext, view(" for "));
    }
    ty := iface_r_type(&mut p, &mut c);
    mut implementation = 0;
    mut plain_key = 0;
    if p.phase == 2 {
        plain_key = 0;
        if ty_kind(&mut c, ty) == 8 {
            plain_key = ty_arg(&mut c, ty) + 1;
        }
    }
    mut key_params = 0;
    if p.phase == 2 {
        // The implementation's own parameter record is filed under the implementation, exactly as
        // the source parse files it, so a replayed generic method finds its parameters.
        key_params = generic_impl_key(c.implementations.len() + 1);
    }
    record := iface_r_impl_params(&mut c, &mut p, key_params, plain_key);
    n := iface_rv(&mut p);
    mut names = u8[][];
    mut types = u64[];
    for i in n {
        names.push(iface_rs(&mut p));
        if p.phase == 0 {
            iface_rt_indent(&mut p, view("  assoctype "));
            push_bytes(&mut p.rtext, view(names[names.len() - 1]));
            p.rtext.push(32);
        }
        types.push(iface_r_type(&mut p, &mut c));
    }
    if p.phase == 2 {
        id := iface_find_iface(&mut c, &mut p, view(contract_module), view(contract_name));
        c
            .implementations
            .push(
                Implementation {
                    contract: id,
                    ty: ty,
                    module: copy_bytes(view(home)),
                    methods: u64[],
                    file: source_index,
                    pos: 0,
                    assoc_names: names,
                    assoc_types: types
                }
            );
        implementation = c.implementations.len();
        // An importer that reads the implementation from a file gets the same declaration bit the
        // source parse set, so its drop glue calls the user `drop` too.
        if (c.drop_iface != 0) & (id == c.drop_iface) {
            drop_impl_registered(&mut c, ty);
        }
        if (record != 0) & (c.impl_params.len() >= record) {
            exchange(&mut c.impl_params[record - 1].self_ty, ty);
        }
    }
    nf := iface_rv(&mut p);
    mut filed = u8[];
    if p.phase == 2 {
        filed = private_module(view(".impl_"), implementation);
    }
    for i in nf {
        saved := p.stop;
        iface_rec(&mut p, IFACE_TAG_FN);
        iface_rec_fn(&mut c, &mut p, view(home), view(filed), view("  "), source_index, raw_flag, 3, implementation, key_params, 0);
        p.stop = saved;
    }
    return ();
}
// Whether the written-type impl at `key` has the header a section just gave: the same owner type and
// the same parameters. `record` is the section's own ImplParams record, the last one pushed. The
// source parse asks the same question of its own header (inherent_same_header).
fn iface_same_header<a>(c: (&a mut C), key: u64, ty: u64, record: u64) -> bool {
    i := key - inherent_type_base();
    if same_type(&mut c, c.inherent_types[i - 1], ty) == 0 {
        return false;
    }
    old := impl_record(&mut c, key);
    if (old == 0) || (old == record) {
        return false;
    }
    a := &c.impl_params[old - 1];
    b := &c.impl_params[record - 1];
    if (a.rnames.len() != b.rnames.len()) || (a.tnames.len() != b.tnames.len()) {
        return false;
    }
    if !numbers_equal(&a.bounds, &b.bounds) || (a.interfaces.len() != b.interfaces.len()) {
        return false;
    }
    for j in a.interfaces.len() {
        if !numbers_equal(&a.interfaces[j], &b.interfaces[j]) {
            return false;
        }
    }
    return true;
}
fn iface_rec_env<a>(c: (&a mut C), p: (&a mut IR), home: &a [u8]) -> unit {
    local := iface_rs(&mut p);
    if p.phase == 0 {
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("env "));
        push_bytes(&mut p.rtext, view(local));
    }
    mut decl = 0;
    mut first = 0;
    if p.phase == 1 {
        mut name = u8[];
        push_bytes(&mut name, view(home));
        name.push(95);
        push_bytes(&mut name, view(local));
        c
            .decls
            .push(
                Decl {
                    public: c.decl_public,
                    module: copy_bytes(view(".closure")),
                    name: name,
                    declared_at: u8[],
                    is_enum: 0,
                    opaque: 0,
                    transfer: 0,
                    share: 0,
                    c_layout: 0,
                    first: 0,
                    count: 0,
                    drop: 0,
                    regions: 0,
                    types: 0,
                    success: 0,
                    bounds: u64[],
                    constraints: u64[][]
                }
            );
        c.iface_env.push(c.decls.len() - 1);
        c.iface_env_names.push(local.copy());
    }
    if p.phase == 2 {
        found := iface_env_decl(&mut c, view(local));
        if found == 0 {
            iface_bad(&mut p, view("carries an environment record this program does not declare"));
        }
        decl = found - 1;
        first = c.fields.len();
        exchange(&mut c.decls[decl].first, first);
        exchange(&mut c.decls[decl].count, 0);
    }
    if p.phase == 0 {
    }
    count := iface_rv(&mut p);
    for i in count {
        field := iface_rs(&mut p);
        if p.phase == 0 {
            iface_rt_indent(&mut p, view("  field "));
            push_bytes(&mut p.rtext, view(field));
            p.rtext.push(32);
        }
        ty := iface_r_type(&mut p, &mut c);
        if p.phase == 0 {
            }
        if p.phase == 2 {
            c.fields.push(Field { name: copy_bytes(view(field)), ty: ty, pred: no_pred() });
            exchange(&mut c.decls[decl].count, c.fields.len() - first);
        }
    }
    return ();
}
// One walk over the records: register (phase 1), install (phase 2), or describe (phase 0).
fn iface_walk<a>(c: (&a mut C), p: (&a mut IR), home: &a [u8], source_index: u64, raw_flag: u64) -> unit {
    saved := p.stop;
    while p.at < saved {
        p.stop = saved;
        tag := iface_r1(&mut p);
        if !iface_known_tag(tag) {
            mut msg = u8[];
            push_bytes(&mut msg, view("carries an unknown record (tag "));
            decimal(&mut msg, tag);
            push_bytes(&mut msg, view("): it was written by a newer compiler, and this one reads interface format "));
            decimal(&mut msg, IFACE_VERSION);
            push_bytes(&mut msg, view(" ("));
            push_bytes(&mut msg, view(iface_where(&p)));
            push_bytes(&mut msg, view(")"));
            iface_refuse(view(p.path), view(msg));
        }
        len := iface_rv(&mut p);
        if (saved < p.at) || ((saved - p.at) < len) {
            iface_bad(&mut p, view("is truncated: a record says it is longer than the rest of the file"));
        }
        p.stop = p.at + len;
        start := p.at;
        if tag == IFACE_TAG_TRAILER {
            p.stop = saved;
            return ();
        }
        if tag == IFACE_TAG_MODULE {
            // The header: read once, by `iface_r_head`, before this walk.
            p.at = p.stop;
        } else if tag == IFACE_TAG_LINK {
            input := iface_rs(&mut p);
            if p.phase == 0 {
                iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("link \""));
                push_bytes(&mut p.rtext, view(input));
                push_bytes(&mut p.rtext, view("\""));
                    }
            if (p.phase == 1) || (p.phase == 2) {
                ffi_link(&mut c, view(input));
                last := c.lib_owner.len() - 1;
                exchange(&mut c.lib_owner[last], copy_bytes(view(home)));
            }
        } else if tag == IFACE_TAG_TYPE {
            iface_rec_type(&mut c, &mut p);
        } else if tag == IFACE_TAG_ALIAS {
            iface_rec_alias(&mut c, &mut p);
        } else if tag == IFACE_TAG_CONST {
            iface_rec_const(&mut c, &mut p);
        } else if tag == IFACE_TAG_STATIC {
            iface_rec_static(&mut c, &mut p);
        } else if tag == IFACE_TAG_FN {
            iface_rec_fn(&mut c, &mut p, view(home), view(home), view(""), source_index, raw_flag, 0, 0, 0, 0);
        } else if tag == IFACE_TAG_INHERENT {
            iface_rec_inherent(&mut c, &mut p, view(home), source_index, raw_flag);
        } else if tag == IFACE_TAG_INHERENT_TYPE {
            iface_rec_inherent_type(&mut c, &mut p, view(home), source_index, raw_flag);
        } else if tag == IFACE_TAG_IFACE {
            iface_rec_iface(&mut c, &mut p, view(home), source_index, raw_flag);
        } else if tag == IFACE_TAG_IMPL {
            iface_rec_impl(&mut c, &mut p, view(home), source_index, raw_flag);
        } else if tag == IFACE_TAG_ENV {
            iface_rec_env(&mut c, &mut p, view(home));
        } else if tag == IFACE_TAG_FACTS {
            iface_rec_facts(&mut c, &mut p);
        }
        iface_rend(&mut p, start);
        p.stop = saved;
    }
    return ();
}

// The summary record: rendered in phase 0, installed in phase 2 as the facts of callees whose
// bodies are not in this run. A body this run emits wins over a row for the same symbol.
fn iface_rec_facts<a>(c: (&a mut C), p: (&a mut IR)) -> unit {
    n := iface_rv(&mut p);
    for i in n {
        sym := iface_rs(&mut p);
        shown := iface_rs(&mut p);
        a := iface_r1(&mut p);
        pf := iface_r1(&mut p);
        e := iface_r1(&mut p);
        at := iface_rs(&mut p);
        pt := iface_rs(&mut p);
        if p.phase == 0 {
            iface_rt_indent(&mut p, view(""));
            push_bytes(&mut p.rtext, view("facts "));
            push_bytes(&mut p.rtext, view(shown));
            p.rtext.push(32);
            decimal(&mut p.rtext, a);
            p.rtext.push(32);
            decimal(&mut p.rtext, pf);
            p.rtext.push(32);
            decimal(&mut p.rtext, e);
            if at.len() != 0 {
                push_bytes(&mut p.rtext, view(" alloc-via "));
                push_bytes(&mut p.rtext, view(at));
            }
            if pt.len() != 0 {
                push_bytes(&mut p.rtext, view(" fail-via "));
                push_bytes(&mut p.rtext, view(pt));
            }
        }
        if p.phase == 2 {
            k := fx_sym(&mut c, view(sym)) - 1;
            if c.fx_body[k] == 0 {
                c.fx_row[k] = 1;
                c.fx_own_alloc[k] = a;
                c.fx_own_panic[k] = pf;
                c.fx_entry_panic[k] = e;
                c.fx_fn_name[k] = shown.copy();
                mut ta = 0;
                if at.len() != 0 {
                    ta = fx_sym(&mut c, view(at));
                }
                mut tp = 0;
                if pt.len() != 0 {
                    tp = fx_sym(&mut c, view(pt));
                }
                c.fx_alloc_thru[k] = ta;
                c.fx_panic_thru[k] = tp;
            }
        }
    }
    return ();
}

// ---- the build path: emit, read instead of parsing, describe, round-trip ----
// Reads one interface, checks it, and installs (phase 1 names, phase 2 definitions) or describes
// (phase 0). Returns the module it declares; `rtext` receives the dump in phase 0.
fn iface_decode<a, b>(c: (&a mut C), path: &a [u8], bytes: &a [u8], source_path: &b [u8], phase: u64, rtext: (&a mut u8[])) -> u8[] {
    head := iface_r_head(view(path), view(bytes));
    module := head.module.copy();
    mut p = IR {
        data: bytes.copy(),
        at: head.next,
        stop: bytes.len(),
        path: path.copy(),
        phase: phase,
        rtext: u8[],
        what: copy_bytes(view("the interface"))
    };
    if phase == 0 {
        push_bytes(&mut p.rtext, view("grail-interface "));
        decimal(&mut p.rtext, IFACE_VERSION);
        p.rtext.push(10);
        push_bytes(&mut p.rtext, view("module "));
        push_bytes(&mut p.rtext, view(module));
        p.rtext.push(10);
        push_bytes(&mut p.rtext, view("source \""));
        push_bytes(&mut p.rtext, view(head.source));
        push_bytes(&mut p.rtext, view("\""));
        p.rtext.push(10);
        push_bytes(&mut p.rtext, view("mode overflow="));
        if head.overflow == 0 {
            push_bytes(&mut p.rtext, view("wrap"));
        } else {
            push_bytes(&mut p.rtext, view("checked"));
        }
        push_bytes(&mut p.rtext, view(" target="));
        push_bytes(&mut p.rtext, view(iface_target_word(head.target, head.plat)));
        p.rtext.push(10);
        push_bytes(&mut p.rtext, view(head.dyn_abi));
        p.rtext.push(10);
        push_bytes(&mut p.rtext, view("std "));
        decimal(&mut p.rtext, head.std);
        p.rtext.push(10);
        push_bytes(&mut p.rtext, view("unsafe "));
        decimal(&mut p.rtext, head.unsafe);
        p.rtext.push(10);
        push_bytes(&mut p.rtext, view("host "));
        decimal(&mut p.rtext, head.host);
        p.rtext.push(10);
    }
    if module.len() == 0 {
        iface_refuse(view(path), view("has an empty `module` record"));
    }
    if phase != 0 {
        if same(view(module), view("runtime")) {
            iface_refuse(view(path), view("describes the runtime, which is compiled from source, not from an interface"));
        }
        if head.host != 0 {
            mut known = 0;
            for i in c.host_modules.len() {
                if same(view(c.host_modules[i]), view(module)) {
                    known = 1;
                }
            }
            if known == 0 {
                c.host_modules.push(module.copy());
            }
        }
        // The `dyn` ABI: two modules must build a `&dyn I` the same way, or the pair one writes is
        // the pair the other dereferences wrongly. The field is compared as written; this compiler
        // builds one ABI, and a file that does not say so is refused before a declaration is read.
        if head.dyn_abi.len() == 0 {
            iface_refuse(
                view(path),
                view("carries no `dyn` ABI field: it does not say what a borrowed `dyn` value is")
            );
        }
        if !same(view(head.dyn_abi), view(iface_dyn_abi())) {
            mut msg = u8[];
            push_bytes(&mut msg, view("was written for another `dyn` ABI (`"));
            push_bytes(&mut msg, view(head.dyn_abi));
            push_bytes(&mut msg, view("`); this compiler builds `"));
            push_bytes(&mut msg, view(iface_dyn_abi()));
            push_bytes(&mut msg, view("`, so a `&dyn` value would not mean the same thing"));
            iface_refuse(view(path), view(msg));
        }
        // Modes: an interface is only meaningful for the checker that would have produced it.
        if iface_target_word(c.target, c.plat) != iface_target_word(head.target, head.plat) {
            mut msg = u8[];
            push_bytes(&mut msg, view("was written for target "));
            push_bytes(&mut msg, view(iface_target_word(head.target, head.plat)));
            push_bytes(&mut msg, view(", this build targets "));
            push_bytes(&mut msg, view(iface_target_word(c.target, c.plat)));
            push_bytes(&mut msg, view("; re-emit it with `grail check --interface DIR`"));
            iface_refuse(view(path), view(msg));
        }
        // The header still records the overflow mode it was written under (it is input to a unit's
        // key), but a reader built under the other mode is not refused: the prover and the effect
        // analysis no longer depend on the mode, so an interface describes the same surface in both
        // and the mode only chooses the code a body is emitted with.
        // The sources this interface was built from must be the ones on this command line - when
        // there are any. `--use` reads an interface for a module whose source this build does not
        // have, which is the whole point of stage 3; the file's own digest is what remains. Phase 2
        // (the definition sweep) has no source to check: phase 1 has already done it, once.
        if (phase != 2) & (source_path.len() != 0) {
            source := host::read_file(view(source_path));
            got := iface_digest(&source);
            if !same(view(got), view(head.digest)) {
                mut msg = u8[];
                push_bytes(&mut msg, view("module `"));
                push_bytes(&mut msg, view(module));
                push_bytes(&mut msg, view("` changed since this interface was written: the interface records source-sha256 "));
                push_bytes(&mut msg, view(head.digest));
                push_bytes(&mut msg, view(" for \""));
                push_bytes(&mut msg, view(head.source));
                push_bytes(&mut msg, view("\", but "));
                push_bytes(&mut msg, view(source_path));
                push_bytes(&mut msg, view(" is "));
                push_bytes(&mut msg, view(got));
                iface_refuse(view(path), view(msg));
            }
        }
    }
    mut source_index = 0;
    if phase != 0 {
        source_index = iface_file_index(&mut c, view(source_path));
    }
    if p.phase == 1 {
        iface_walk(&mut c, &mut p, view(module), source_index, head.unsafe);
        push_bytes(&mut rtext, view(p.rtext));
        c.iface_loaded.push(module.copy());
        c.iface_loaded_path.push(path.copy());
        c
            .iface_list
            .push(
                IModule {
                    module: module.copy(),
                    path: source_path.copy(),
                    std: head.std,
                    unsafe: head.unsafe,
                    host: head.host
                }
            );
        return module;
    }
    if p.phase == 2 {
        // The interface names its own module's items, private ones included: reading it is the
        // compiler's lookup, not the importer's.
        vis_was := exchange(&mut c.vis_off, 1);
        iface_walk(&mut c, &mut p, view(module), source_index, head.unsafe);
        exchange(&mut c.vis_off, vis_was);
        // Now that every parameter name, bound and requirement is in place, give each implementation
        // the self type the source parse would have built (with its proofs), exactly once.
        for i in c.impl_params.len() {
            if c.impl_params[i].self_ty == NO_TYPE {
                iface_impl_self(&mut c, i);
            }
        }
    }
    if p.phase == 0 {
        iface_walk(&mut c, &mut p, view(module), 0, head.unsafe);
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("sha256 \""));
        push_bytes(&mut p.rtext, view(head.digest));
        push_bytes(&mut p.rtext, view("\""));
        iface_rt_indent(&mut p, view(""));
        push_bytes(&mut p.rtext, view("digest \""));
        if 32 <= bytes.len() {
            mut tail = u8[];
            for i in 32 {
                tail.push(bytes[bytes.len() - 32 + i]);
            }
            push_bytes(&mut p.rtext, view(iface_hex(&tail)));
        }
        push_bytes(&mut p.rtext, view("\""));
        p.rtext.push(10);
        push_bytes(&mut rtext, view(p.rtext));
    }
    return module;
}
// Reads one interface off the disk and installs it, after every check. Returns the module name.
fn iface_load<a, b>(c: (&a mut C), path: &a [u8], source_path: &b [u8], phase: u64) -> u8[] {
    mut bytes = u8[];
    if host::exists(view(path)) != 0 {
        bytes = host::read_file(view(path));
    }
    if bytes.len() == 0 {
        iface_refuse(view(path), view("cannot read interface file"));
    }
    mut rtext = u8[];
    return iface_decode(&mut c, view(path), view(bytes), view(source_path), phase, &mut rtext);
}
// The bytes before the trailer: the surface, which is what a build cache keys on. An edit that
// changes only the source digest (a body edit that changed no declaration) leaves it alone.
pub fn iface_surface<a>(bytes: &a [u8]) -> u8[] {
    mut at = 5;
    mut cut = bytes.len();
    while at < bytes.len() {
        tag_at := at;
        tag := bytes[at];
        at += 1;
        mut len = 0;
        mut scale = 1;
        mut more = 1;
        while (more != 0) & (at < bytes.len()) {
            b := bytes[at];
            at += 1;
            len = len + (b & 127) * scale;
            if (b & 128) == 0 {
                more = 0;
            } else {
                scale = scale * 128;
            }
        }
        if tag == IFACE_TAG_TRAILER {
            cut = tag_at;
            break;
        }
        at = at + len;
    }
    mut out = u8[];
    for i in cut {
        out.push(bytes[i]);
    }
    return out;
}
// The module a written interface declares, from its header record - the binary replacement for the
// `module NAME;` scan `--use` used to do on the file.
fn iface_module_name<a>(path: &a [u8]) -> u8[] {
    mut bytes = u8[];
    if host::exists(view(path)) != 0 {
        bytes = host::read_file(view(path));
    }
    if bytes.len() == 0 {
        iface_refuse(view(path), view("cannot read interface file"));
    }
    h := iface_r_head(view(path), view(bytes));
    return h.module.copy();
}
// The typed record tree, rendered: what the reader read, in the order it read it. This is the
// inspector - there is no second parser behind it, so it cannot describe a file the compiler would
// read otherwise.
fn iface_dump<a>(c: (&a mut C), path: &a [u8]) -> unit {
    mut bytes = u8[];
    if host::exists(view(path)) != 0 {
        bytes = host::read_file(view(path));
    }
    if bytes.len() == 0 {
        iface_refuse(view(path), view("cannot read interface file"));
    }
    mut rtext = u8[];
    iface_decode(&mut c, view(path), view(bytes), view(""), 0, &mut rtext);
    host::print(view(rtext));
    return ();
}
// Write, read, write again: the bytes have to come back identical. This is the property that makes
// one writer and one reader enough - the reader rebuilds the model the writer started from, so a
// field either travels or the second write differs and says where.
// Write, read, write again: the bytes have to come back identical. This is the property that makes
// one writer and one reader enough - the reader rebuilds the model the writer started from, so a
// field either travels or the second write differs and says where. The file's *dependencies* are the
// interfaces beside it, which are registered (name phase only) first: a declaration it names belongs
// to another module and is spelled by name in the file.
fn iface_roundtrip<a>(c: (&a mut C), path: &a [u8]) -> unit {
    mut bytes = u8[];
    if host::exists(view(path)) != 0 {
        bytes = host::read_file(view(path));
    }
    if bytes.len() == 0 {
        iface_refuse(view(path), view("cannot read interface file"));
    }
    head := iface_r_head(view(path), view(bytes));
    dir := iface_dirname(view(path));
    base := iface_basename(view(path));
    mut rtext = u8[];
    entries := host::list_dir(view(dir));
    for i in entries.len() {
        entry := entries[i].copy();
        if !iface_suffix(view(entry), view(".iface")) | same(view(entry), view(base)) {
            continue;
        }
        mut beside = u8[];
        push_bytes(&mut beside, view(dir));
        beside.push(47);
        push_bytes(&mut beside, view(entry));
        iface_decode(&mut c, view(beside), view(host::read_file(view(beside))), view(""), 1, &mut rtext);
    }
    module := iface_decode(&mut c, view(path), view(bytes), view(""), 1, &mut rtext);
    iface_decode(&mut c, view(path), view(bytes), view(""), 2, &mut rtext);
    again := iface_module_bytes(&mut c, view(module), view(head.source), head.std, head.unsafe, head.host, view(head.digest));
    if same(view(bytes), view(again)) {
        host::print(view("identical "));
        decimal_print(again.len());
        host::print(view(" bytes\n"));
        return ();
    }
    mut at = 0;
    while (at < bytes.len()) & (at < again.len()) {
        if bytes[at] != again[at] {
            break;
        }
        at += 1;
    }
    mut msg = u8[];
    push_bytes(&mut msg, view("does not round-trip: reading it back and writing it again gives a different file at byte "));
    decimal(&mut msg, at);
    push_bytes(&mut msg, view(" (it is "));
    decimal(&mut msg, bytes.len());
    push_bytes(&mut msg, view(" bytes, the rewrite is "));
    decimal(&mut msg, again.len());
    push_bytes(&mut msg, view(" bytes)"));
    iface_refuse(view(path), view(msg));
    return ();
}
// The directory and the file name of a path: what `grail iface roundtrip` reads the dependencies of
// a file from.
fn iface_dirname<a>(path: &a [u8]) -> u8[] {
    mut cut = 0;
    for i in path.len() {
        if path[i] == 47 {
            cut = i;
        }
    }
    if cut == 0 {
        return copy_bytes(view("."));
    }
    mut out = u8[];
    for i in cut {
        out.push(path[i]);
    }
    return out;
}
fn iface_basename<a>(path: &a [u8]) -> u8[] {
    mut cut = 0;
    for i in path.len() {
        if path[i] == 47 {
            cut = i + 1;
        }
    }
    mut out = u8[];
    mut i = cut;
    while i < path.len() {
        out.push(path[i]);
        i += 1;
    }
    return out;
}
fn decimal_print(n: u64) -> unit {
    mut out = u8[];
    decimal(&mut out, n);
    host::print(view(out));
    return ();
}
// Compares the interface on disk with the one this compiler would write from the sources it has
// just parsed: the third refusal of stage 2 - an interface that disagrees with its module.
fn iface_verify_module<a>(c: (&a mut C), index: u64) -> unit {
    m := c.iface_list[index].module.copy();
    path := c.iface_list[index].path.copy();
    in_std := c.iface_list[index].std;
    unsafe_flag := c.iface_list[index].unsafe;
    mut optin = 0;
    if host_opted(&c, view(m)) {
        optin = 1;
    }
    file := iface_join(view(c.iface_dir), view(m), view(".iface"));
    mut want = u8[];
    if host::exists(view(file)) != 0 {
        want = host::read_file(view(file));
    }
    if want.len() == 0 {
        mut msg = u8[];
        push_bytes(&mut msg, view("has no interface for module `"));
        push_bytes(&mut msg, view(m));
        push_bytes(&mut msg, view("` (expected this file); run `grail check --interface DIR` to write it"));
        iface_refuse(view(file), view(msg));
    }
    // A changed source is staleness, said as such, before any declaration of the surface is compared.
    head := iface_r_head(view(file), view(want));
    actual := iface_digest(&host::read_file(view(path)));
    if !same(view(head.digest), view(actual)) {
        mut msg = u8[];
        push_bytes(&mut msg, view("module `"));
        push_bytes(&mut msg, view(m));
        push_bytes(&mut msg, view("` changed since this interface was written: the interface records source-sha256 "));
        push_bytes(&mut msg, view(head.digest));
        push_bytes(&mut msg, view(", but "));
        push_bytes(&mut msg, view(path));
        push_bytes(&mut msg, view(" is "));
        push_bytes(&mut msg, view(actual));
        iface_refuse(view(file), view(msg));
    }
    got := iface_module_bytes(&mut c, view(m), view(path), in_std, unsafe_flag, optin, view(""));
    // The summary is what the module's bodies proved, and this check compares declarations before
    // any body is emitted: it is left out of the comparison. The source digest pins it.
    want = iface_without_facts(view(want));
    if same(view(want), view(got)) {
        return ();
    }
    // Different bytes: compare the two as the declarations they are, so the refusal names the one
    // that differs rather than a byte offset.
    mut left = u8[];
    iface_decode(&mut c, view(file), view(want), view(""), 0, &mut left);
    mut right = u8[];
    iface_decode(&mut c, view(file), view(got), view(""), 0, &mut right);
    lines_a := iface_lines(&left);
    lines_b := iface_lines(&right);
    mut at = 0;
    while (at < lines_a.len()) || (at < lines_b.len()) {
        mut a = u8[];
        mut b = u8[];
        if at < lines_a.len() {
            a = lines_a[at].copy();
        }
        if at < lines_b.len() {
            b = lines_b[at].copy();
        }
        if !same(view(a), view(b)) {
            mut msg = u8[];
            push_bytes(&mut msg, view("module `"));
            push_bytes(&mut msg, view(m));
            push_bytes(&mut msg, view("` does not match this interface: line "));
            decimal(&mut msg, at + 1);
            push_bytes(&mut msg, view(": the interface says `"));
            push_bytes(&mut msg, view(iface_clip(view(a))));
            push_bytes(&mut msg, view("`, the sources give `"));
            push_bytes(&mut msg, view(iface_clip(view(b))));
            push_bytes(&mut msg, view("`"));
            iface_refuse(view(file), view(msg));
        }
        at += 1;
    }
    iface_refuse(view(file), view("does not match the module byte for byte; regenerate it with `grail check --interface DIR`"));
    return ();
}
// A long line is clipped so a diagnostic stays one line.
fn iface_clip<a>(line: &a [u8]) -> u8[] {
    mut out = u8[];
    mut i = 0;
    while (i < line.len()) & (i < 96) {
        out.push(line[i]);
        i += 1;
    }
    if 96 <= line.len() {
        push_bytes(&mut out, view(" …"));
    }
    return out;
}

// ---- the helpers the format shares with the rest of the compiler ----
// The text spelling below is a *diagnostic* renderer (a type as an error message names it), not
// a second reader: nothing parses it back, so it cannot disagree with the file format.
// The ID scans, the path joiners, the manifest and the digest helpers are unchanged.

fn iface_before<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    mut i = 0;
    while (i < x.len()) & (i < y.len()) {
        if x[i] != y[i] {
            return x[i] < y[i];
        }
        i += 1;
    }
    return x.len() < y.len();
}

// Declarations are written in name order, so a review diff shows the declaration that changed
// rather than a reshuffled file.
fn iface_sorted<a>(names: (&a u8[][])) -> u64[] {
    // A stable merge sort, bottom up: of two equal names the earlier comes first, which is the order
    // the selection sort this replaces produced, at n log n comparisons instead of n squared.
    n := names.len();
    mut order = u64[];
    for i in n {
        order.push(i);
    }
    mut merged = u64[0; n];
    mut width = 1;
    while width < n {
        mut lo = 0;
        while lo < n {
            mut mid = lo + width;
            if n < mid {
                mid = n;
            }
            mut hi = mid + width;
            if n < hi {
                hi = n;
            }
            mut i = lo;
            mut j = mid;
            mut k = lo;
            while k < hi {
                mut left = i < mid;
                if left && (j < hi) {
                    // The right one goes first only when it is strictly before the left one.
                    left = !iface_before(view(names[order[j]]), view(names[order[i]]));
                }
                if left {
                    merged[k] = order[i];
                    i += 1;
                } else {
                    merged[k] = order[j];
                    j += 1;
                }
                k += 1;
            }
            lo = hi;
        }
        for k in n {
            order[k] = merged[k];
        }
        width = width * 2;
    }
    return order;
}

fn iface_ref<a, b>(out: (&a mut u8[]), m: &a [u8], n: &b [u8]) -> unit {
    push_bytes(&mut out, view(m));
    push_bytes(&mut out, view("::"));
    push_bytes(&mut out, view(n));
    return ();
}

fn iface_regions<a, b>(out: (&a mut u8[]), rs: (&b u64[])) -> unit {
    out.push(91);
    for i in rs.len() {
        if i != 0 {
            out.push(44);
        }
        decimal(&mut out, rs[i]);
    }
    out.push(93);
    return ();
}

// ` MODE` and ` [REGIONS]`, in the one order the reader expects.
fn iface_extra<a, b>(out: (&a mut u8[]), mode: u64, rs: (&b u64[])) -> unit {
    if mode != 0 {
        out.push(32);
        decimal(&mut out, mode);
    }
    if rs.len() != 0 {
        out.push(32);
        iface_regions(&mut out, &rs);
    }
    return ();
}

fn iface_type_list<a, b>(out: (&a mut u8[]), c: (&b mut C), args: (&b u64[])) -> unit {
    out.push(40);
    for i in args.len() {
        if i != 0 {
            out.push(44);
        }
        iface_type_raw(&mut out, &mut c, args[i]);
    }
    out.push(41);
    return ();
}

fn iface_type_raw<a, b>(out: (&a mut u8[]), c: (&b mut C), ty: u64) -> unit {
    k := ty_kind(&mut c, ty);
    mode := ty_mode(&mut c, ty);
    rs := type_regions(&mut c, ty);
    args := type_args(&mut c, ty);
    env := ty_env(&mut c, ty);
    arg := ty_arg(&mut c, ty);
    if k == 21 {
        // The width lives in the argument: 32 bits is f32, 0 is f64.
        if arg == 32 {
            push_bytes(&mut out, view("f32"));
        } else {
            push_bytes(&mut out, view("f64"));
        }
        return ();
    }
    if k == 31 {
        // A value parameter's binding (comptime C2): the constant itself.
        push_bytes(&mut out, view("(const "));
        decimal(&mut out, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if (k == 1) || (k == 2) || (k == 3) || (k == 4) || (k == 17) || (k == 19) || (k == 22) || (k == 24) {
        push_bytes(&mut out, view(iface_plain_word(k)));
        return ();
    }
    if k == 5 {
        push_bytes(&mut out, view("(view"));
        iface_extra(&mut out, mode, &rs);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 18 {
        push_bytes(&mut out, view("(int "));
        decimal(&mut out, arg);
        if mode == 0 {
            push_bytes(&mut out, view("u)"));
        } else {
            push_bytes(&mut out, view("i)"));
        }
        return ();
    }
    if (k == 6) || (k == 11) || (k == 13) || (k == 14) || (k == 16) || (k == 26) || (k == 27) || (k == 29) || (k == 32) || (k == 34) || (k == 36) {
        push_bytes(&mut out, view("("));
        push_bytes(&mut out, view(iface_plain_word(k)));
        iface_extra(&mut out, mode, &rs);
        out.push(32);
        iface_type_raw(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 7 {
        push_bytes(&mut out, view("(ref"));
        iface_extra(&mut out, mode, &rs);
        out.push(32);
        iface_type_raw(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 8 {
        // `T?` / `T | E` are structural: the compiler synthesises one declaration per member
        // count (`.union::Union2`, `.result::Result2_1`), so an interface states the members and
        // the reader rebuilds the same declaration by the same rule instead of naming an index.
        owner := c.decls[arg].module.copy();
        if same(view(owner), view(".outcome")) & same(view(c.decls[arg].name), view("Failure")) {
            // The synthesized failure record: rebuilt by the reader from its own rule, like the
            // union declarations beside it.
            push_bytes(&mut out, view("(outcomefail)"));
            return ();
        }
        if same(view(owner), view(".union")) || same(view(owner), view(".result"))
            || same(view(owner), view(".outcome")) {
            if same(view(owner), view(".union")) {
                push_bytes(&mut out, view("(union "));
            } else if same(view(owner), view(".outcome")) {
                push_bytes(&mut out, view("(outcome "));
            } else {
                push_bytes(&mut out, view("(result "));
            }
            decimal(&mut out, c.decls[arg].success);
            out.push(32);
            iface_type_list(&mut out, &mut c, &args);
            push_bytes(&mut out, view(")"));
            return ();
        }
        push_bytes(&mut out, view("(named "));
        iface_decl_ref(&mut out, &mut c, arg);
        iface_extra(&mut out, mode, &rs);
        for i in args.len() {
            out.push(32);
            iface_type_raw(&mut out, &mut c, args[i]);
        }
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 23 {
        push_bytes(&mut out, view("(handle "));
        iface_decl_ref(&mut out, &mut c, arg);
        iface_extra(&mut out, mode, &rs);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 28 {
        push_bytes(&mut out, view("(byval "));
        iface_decl_ref(&mut out, &mut c, arg);
        iface_extra(&mut out, mode, &rs);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 9 {
        // An opaque type parameter carries its bound bits in `mode` and the interface proofs it
        // satisfies in `args`, so both are written: a `T: Send + Ord` is not a plain `T`.
        push_bytes(&mut out, view("(tparam "));
        decimal(&mut out, arg);
        out.push(32);
        decimal(&mut out, mode);
        out.push(32);
        iface_regions(&mut out, &rs);
        for i in args.len() {
            out.push(32);
            iface_type_raw(&mut out, &mut c, args[i]);
        }
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 33 {
        push_bytes(&mut out, view("(dyn "));
        iface_interface_ref(&mut out, &mut c, arg);
        for i in args.len() {
            out.push(32);
            iface_type_raw(&mut out, &mut c, args[i]);
        }
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 35 {
        // A borrowed interface object's referent: the `dyn` type it names. The interface format
        // carries it inside the reference it belongs to, so `&dyn I` round-trips as `(ref ...)`.
        push_bytes(&mut out, view("(bobj "));
        iface_type_raw(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 30 {
        // `(assoc PARAM INTERFACE INDEX)`: the interface by name, since ids are this run's.
        push_bytes(&mut out, view("(assoc "));
        iface_type_raw(&mut out, &mut c, arg);
        out.push(32);
        iface_interface_ref(&mut out, &mut c, mode / 1024);
        out.push(32);
        decimal(&mut out, mode % 1024);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 10 {
        push_bytes(&mut out, view("(bound "));
        iface_type_raw(&mut out, &mut c, arg);
        out.push(32);
        decimal(&mut out, mode);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 15 {
        push_bytes(&mut out, view("(proof "));
        iface_interface_ref(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if (k == 12) || (k == 25) {
        push_bytes(&mut out, view("("));
        push_bytes(&mut out, view(iface_plain_word(k)));
        iface_extra(&mut out, mode, &rs);
        out.push(32);
        iface_type_list(&mut out, &mut c, &args);
        out.push(32);
        iface_type_raw(&mut out, &mut c, arg);
        push_bytes(&mut out, view(")"));
        return ();
    }
    if k == 20 {
        push_bytes(&mut out, view("(closure"));
        iface_extra(&mut out, mode, &rs);
        out.push(32);
        iface_type_list(&mut out, &mut c, &args);
        out.push(32);
        iface_type_raw(&mut out, &mut c, arg);
        out.push(32);
        if env == 0 {
            out.push(48);
        } else {
            iface_type_raw(&mut out, &mut c, env);
        }
        push_bytes(&mut out, view(")"));
        return ();
    }
    // A store extension with no spelling: refuse rather than write something that reads back as a
    // different type. A caller that only asked *whether* a type has a spelling (`spell_lenient`)
    // records the gap and gets on with the build: naming a type must never be able to fail one.
    if c.spell_lenient != 0 {
        exchange(&mut c.spell_failed, 1);
        return ();
    }
    iface_refuse(view("<interface>"), view("this interface format cannot express a type of that kind"));
    return ();
}

fn iface_plain_word(k: u64) -> string {
    if k == 1 {
        return "u64";
    }
    if k == 2 {
        return "unit";
    }
    if k == 3 {
        return "bytes";
    }
    if k == 4 {
        return "string";
    }
    if k == 11 {
        return "atomic";
    }
    if k == 17 {
        return "cancel";
    }
    if k == 19 {
        return "bool";
    }
    if k == 21 {
        return "f64";
    }
    if k == 22 {
        return "char";
    }
    if k == 24 {
        return "cstr";
    }
    if k == 7 {
        return "ref";
    }
    if k == 10 {
        return "bound";
    }
    if k == 5 {
        return "view";
    }
    if k == 6 {
        return "vec";
    }
    if k == 32 {
        return "array";
    }
    if k == 36 {
        return "simd";
    }
    if k == 12 {
        return "fn";
    }
    if k == 13 {
        return "mutex";
    }
    if k == 14 {
        return "scope";
    }
    if k == 16 {
        return "task";
    }
    if k == 25 {
        return "cfn";
    }
    if k == 26 {
        return "cptr";
    }
    if k == 34 {
        return "ptr";
    }
    if k == 27 {
        return "slice";
    }
    if k == 29 {
        return "job";
    }
    return "unknown";
}

// A nominal type (or environment record) by name: an importer rebuilds it through its own decl
// table, so the numeric index a store uses never crosses the file.
fn iface_decl_ref<a, b>(out: (&a mut u8[]), c: (&b mut C), decl: u64) -> unit {
    d := &c.decls[decl];
    m := d.module.copy();
    n := d.name.copy();
    if same(view(m), view(".closure")) {
        local := iface_env_name(&mut c, decl);
        iface_ref(&mut out, view(".closure"), view(local));
        return ();
    }
    iface_ref(&mut out, view(m), view(n));
    return ();
}

fn iface_interface_ref<a, b>(out: (&a mut u8[]), c: (&b mut C), id: u64) -> unit {
    item := &c.interfaces[id - 1];
    iface_ref(&mut out, view(item.module), view(item.name));
    return ();
}

// The name an environment record is given inside the file being written (`.closure::env1`), and the
// list of records the file therefore has to carry.
fn iface_env_name<a>(c: (&a mut C), decl: u64) -> u8[] {
    for i in c.iface_env.len() {
        if c.iface_env[i] == decl {
            return c.iface_env_names[i].copy();
        }
    }
    mut name = u8[];
    push_bytes(&mut name, view("env"));
    decimal(&mut name, c.iface_env.len() + 1);
    c.iface_env.push(decl);
    c.iface_env_names.push(name.copy());
    return name;
}

fn iface_target_word(target: u64, plat: u64) -> string {
    if plat != 0 {
        if target == 0 {
            return "macos-x86_64";
        }
        return "macos-aarch64";
    }
    if target == 1 {
        return "aarch64";
    }
    if target == 2 {
        return "riscv64";
    }
    if target == 3 {
        return "windows-x86_64";
    }
    if target == 4 {
        return "windows-aarch64";
    }
    return "x86_64";
}

// Declarations of one module, in name order. Declarations the compiler synthesises for itself
// (`.union`, `.result`, `.closure`, `.impl_N`, `.inherent_N`, `.interface_N`) never reach a file
// under their own module name; the two that an importer can name - environment records and
// inherent/interface methods - travel attached to the declaration they belong to.
fn iface_decl_ids<a, b>(c: (&a mut C), m: &b [u8]) -> u64[] {
    mut ids = u64[];
    for i in c.decls.len() {
        if same(view(c.decls[i].module), view(m)) {
            ids.push(i);
        }
    }
    return ids;
}

fn iface_func_ids<a, b>(c: (&a mut C), m: &b [u8]) -> u64[] {
    // Asked once per declaration (its `.inherent_` module) and per implementation: a scan of every
    // function each time made the interface cost the product of the two (fmod_sync).
    fmod_sync(&mut c);
    g := fmod_group(&c, m);
    if g == 0 {
        return u64[];
    }
    return c.fmod_ids[g - 1].copy();
}
// The group of module `m` in the by-module table, + 1; 0 when no function is in it.
fn fmod_group<a, b>(c: (&a C), m: &b [u8]) -> u64 {
    if c.fmod_slots.len() == 0 {
        return 0;
    }
    key := name_key(view(m), view(""));
    mask := c.fmod_slots.len() - 1;
    mut h = key & mask;
    while c.fmod_slots[h] != 0 {
        g := c.fmod_slots[h];
        if (c.fmod_keys[g - 1] == key) && same(view(c.fmod_names[g - 1]), view(m)) {
            return g;
        }
        h = (h + 1) & mask;
    }
    return 0;
}
// Files the functions added since the last call, each under its module, in table order.
fn fmod_sync<a>(c: (&a mut C)) -> unit {
    while c.fmod_n < c.funcs.len() {
        i := c.fmod_n;
        exchange(&mut c.fmod_n, i + 1);
        m := c.funcs[i].module.copy();
        mut g = fmod_group(&c, view(m));
        if g == 0 {
            // A new group; the table stays at most half full.
            if c.fmod_slots.len() <= 2 * (c.fmod_names.len() + 1) {
                mut size = 64;
                while size <= 4 * (c.fmod_names.len() + 1) {
                    size = size * 2;
                }
                mut slots = u64[0; size];
                for k in c.fmod_names.len() {
                    mut h = c.fmod_keys[k] & (size - 1);
                    while slots[h] != 0 {
                        h = (h + 1) & (size - 1);
                    }
                    slots[h] = k + 1;
                }
                exchange(&mut c.fmod_slots, slots);
            }
            key := name_key(view(m), view(""));
            c.fmod_keys.push(key);
            c.fmod_names.push(m.copy());
            c.fmod_ids.push(u64[]);
            g = c.fmod_names.len();
            mask := c.fmod_slots.len() - 1;
            mut h = key & mask;
            while c.fmod_slots[h] != 0 {
                h = (h + 1) & mask;
            }
            c.fmod_slots[h] = g;
        }
        c.fmod_ids[g - 1].push(i);
    }
    return ();
}


fn iface_names_of_decls<a, b>(c: (&a mut C), ids: (&b u64[])) -> u8[][] {
    mut names = u8[][];
    for i in ids.len() {
        names.push(c.decls[ids[i]].name.copy());
    }
    return names;
}

fn iface_names_of_funcs<a, b>(c: (&a mut C), ids: (&b u64[])) -> u8[][] {
    mut names = u8[][];
    for i in ids.len() {
        names.push(c.funcs[ids[i]].name.copy());
    }
    return names;
}

// The parameter types of a function, in order.
fn iface_params<a>(c: (&a mut C), index: u64) -> u64[] {
    f := &c.funcs[index];
    mut out = u64[];
    for i in f.count {
        out.push(c.params[f.first + i]);
    }
    return out;
}

fn iface_refuse<a, b>(path: &a [u8], msg: &b [u8]) -> unit {
    host::print(view("grail: "));
    host::print(view(path));
    host::print(view(": "));
    host::print(view(msg));
    host::print(view("\n"));
    host::exit(1);
    return ();
}

fn iface_lines<a>(text: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut start = 0;
    mut i = 0;
    while i <= text.len() {
        mut cut = 0;
        if i == text.len() {
            cut = 1;
        } else {
            if text[i] == 10 {
                cut = 1;
            }
        }
        if cut != 0 {
            mut line = u8[];
            for j in i - start {
                line.push(text[start + j]);
            }
            out.push(line);
            start = i + 1;
        }
        i += 1;
    }
    return out;
}

// ---- one module's interface text ----
fn iface_join<a, b, d>(dir: &a [u8], name: &b [u8], ext: &d [u8]) -> u8[] {
    mut out = u8[];
    push_bytes(&mut out, view(dir));
    out.push(47);
    push_bytes(&mut out, view(name));
    push_bytes(&mut out, view(ext));
    return out;
}

fn out_push<a>(out: (&a mut u8[]), b: u64) -> unit {
    out.push(b);
    return ();
}

// Every interface a build reads is checked against the manifest the emitting run wrote, so an
// interface that was edited *and* had its own digest line recomputed is still refused.
fn iface_check_manifest<a, b>(c: (&a mut C), dir: &b [u8]) -> unit {
    manifest := iface_join(view(dir), view("interfaces"), view(".manifest"));
    mut text = u8[];
    if host::exists(view(manifest)) != 0 {
        text = host::read_file(view(manifest));
    }
    if text.len() == 0 {
        iface_refuse(
            view(manifest),
            view("is missing: interfaces are checked against the manifest their emitting run wrote (run `grail check --interface DIR` again)")
        );
    }
    lines := iface_lines(&text);
    mut listed = u8[][];
    for i in lines.len() {
        line := lines[i].copy();
        if line.len() == 0 {
            continue;
        }
        if line[0] == 47 {
            // `// grail-interfaces 1`: a comment, not a module.
            continue;
        }
        mut module = u8[];
        mut want = u8[];
        mut part = 0;
        for k in line.len() {
            b := line[k];
            if b == 32 {
                if part == 2 {
                    break;
                }
                part += 1;
            } else if part == 0 {
                module.push(b);
            } else if part == 1 {
                want.push(b);
            }
        }
        if want.len() == 0 {
            continue;
        }
        file := iface_join(view(dir), view(module), view(".iface"));
        mut bytes = u8[];
        if host::exists(view(file)) != 0 {
            bytes = host::read_file(view(file));
        }
        if bytes.len() == 0 {
            iface_refuse(view(file), view("is missing but the manifest lists it"));
        }
        listed.push(module.copy());
        got := iface_digest(&bytes);
        if !same(view(got), view(want)) {
            mut msg = u8[];
            push_bytes(&mut msg, view("module `"));
            push_bytes(&mut msg, view(module));
            push_bytes(&mut msg, view("`: the interface file does not match the manifest (manifest says "));
            push_bytes(&mut msg, view(want));
            push_bytes(&mut msg, view(", the file is "));
            push_bytes(&mut msg, view(got));
            push_bytes(&mut msg, view("); it was edited or replaced after it was written"));
            iface_refuse(view(file), view(msg));
        }
    }
    // The manifest is the set, not only a list of checksums: `--interface DIR` is a verification
    // build (it checks every module given as source against `DIR/<module>.iface`), so a source
    // module the manifest does not describe is refused here, naming the module and the file it
    // should be in - the same diagnostic a missing file earns, raised at the boundary instead of one
    // module later. An emitting run whose source list and its set disagreed is exactly how a module
    // ended up with no interface file at all. `runtime` is the trusted base and has none.
    for i in c.mod_names.len() {
        m := c.mod_names[i].copy();
        if same(view(m), view("runtime")) {
            continue;
        }
        mut listed_module = 0;
        for k in listed.len() {
            if same(view(listed[k]), view(m)) {
                listed_module = 1;
            }
        }
        if listed_module == 0 {
            file := iface_join(view(dir), view(m), view(".iface"));
            mut msg = u8[];
            push_bytes(&mut msg, view("has no interface for module `"));
            push_bytes(&mut msg, view(m));
            push_bytes(&mut msg, view("` (expected this file); run `grail check --interface DIR` to write it"));
            iface_refuse(view(file), view(msg));
        }
    }
    return ();

}

// Every interface in DIR that no file on the command line declares becomes part of this program:
// its declarations, and the bodies of its generic templates. Its *code* does not - it belongs to the
// object its own module was compiled into - so nothing is emitted for it here; that is what makes a
// generic body emitted once instead of once per importer.
fn iface_load_used<a, b>(c: (&a mut C), dir: &b [u8]) -> unit {
    // Which files, and in what order: the modules the build named, as it named them; or everything
    // in the directory by name, so the order is not the file system's.
    mut entries = u8[][];
    if c.iface_only_on != 0 {
        for i in c.iface_only.len() {
            mut entry = c.iface_only[i].copy();
            push_bytes(&mut entry, view(".iface"));
            entries.push(entry);
        }
    } else {
        listed := host::list_dir(view(dir));
        order := iface_sorted(&listed);
        for i in order.len() {
            entries.push(listed[order[i]].copy());
        }
    }
    mut known = u8[][];
    count := c.mod_base + c.mod_files.len();
    mut i = 2;
    while i < count {
        path := input_path(&c, i);
        mut name = iface_scan(view(path));
        if name.len() == 0 {
            // The entry file is the one file that may omit its `module` line, and it is module
            // `main` when it does - the same rule the parser applies.
            if i == 2 {
                name = "main".copy();
            }
        }
        if name.len() != 0 {
            known.push(name);
        }
        i += 1;
    }
    for k in entries.len() {
        entry := entries[k].copy();
        if !iface_suffix(view(entry), view(".iface")) {
            continue;
        }
        mut file = u8[];
        push_bytes(&mut file, view(dir));
        file.push(47);
        push_bytes(&mut file, view(entry));
        mut name = u8[];
        if c.iface_only_on != 0 {
            // The build named the module: the file is not opened to learn its name, and one that is
            // missing is an error below, not something to skip.
            name = c.iface_only[k].copy();
        } else {
            name = iface_module_name(view(file));
            if name.len() == 0 {
                continue;
            }
        }
        mut have = 0;
        for j in known.len() {
            if same(view(known[j]), view(name)) {
                have = 1;
            }
        }
        for j in c.iface_used.len() {
            if same(view(c.iface_used[j]), view(name)) {
                have = 1;
            }
        }
        if have != 0 {
            continue;
        }
        if (c.iface_only_on != 0) && (host::exists(view(file)) == 0) {
            mut missing = u8[];
            push_bytes(&mut missing, view("has no interface for module `"));
            push_bytes(&mut missing, view(name));
            push_bytes(&mut missing, view("`, which this run was told to read (--use-module)"));
            iface_refuse(view(file), view(missing));
        }
        module := iface_load(&mut c, view(file), view(""), 1);
        if !same(view(module), view(name)) {
            mut msg = u8[];
            push_bytes(&mut msg, view("describes module `"));
            push_bytes(&mut msg, view(module));
            push_bytes(&mut msg, view("`, but its own header names `"));
            push_bytes(&mut msg, view(name));
            push_bytes(&mut msg, view("`"));
            iface_refuse(view(file), view(msg));
        }
        c.iface_used.push(module.copy());
    }
    return ();
}

fn iface_suffix<a, b>(text: &a [u8], suffix: &b [u8]) -> bool {
    if text.len() < suffix.len() {
        return false;
    }
    for i in suffix.len() {
        if text[text.len() - suffix.len() + i] != suffix[i] {
            return false;
        }
    }
    return true;
}

// A source that came from an interface rather than from the command line. The base is far above any
// plausible argument count, so one index still tells the two apart everywhere a file is loaded or
// named in a diagnostic.
fn virtual_source<a, b>(c: (&a mut C), path: &b [u8], text: &b [u8]) -> u64 {
    c.virt_path.push(path.copy());
    c.virt_text.push(text.copy());
    return 1000000 + c.virt_text.len() - 1;
}

// `.closure::envN` names an environment record this file carries: an importer rebuilds it here as
// a fresh `.closure` declaration, so a closure type's captured fields survive the boundary.
fn iface_env_type<a, b>(c: (&a mut C), p: (&a mut IR), local: &b [u8]) -> u64 {
    decl := iface_env_decl(&mut c, view(local));
    if decl == 0 {
        iface_bad(&mut p, view("carries a reference to an environment record this program does not declare"));
    }
    return intern_args(&mut c, 8, decl - 1, 0, u64[], u64[]);
}

// The parameter record of a generic implementation: `impl<T> Foo<T>` is checked against its own
// parameters when an importer replays one of its generic methods.
// The self type of an implementation (`impl<K: Hash + Equal, V> Map<K, V>` is `Map<K, V>`) has to
// carry the same bounds and interface proofs the source parse gives it: `validate_type_constraints`
// walks every nominal type in the store, so a bare `Map<K, V>` is a real type it would reject.
fn iface_impl_self<a>(c: (&a mut C), record: u64) -> unit {
    decl := c.impl_params[record].decl;
    params := c.impl_params[record].tnames.len();
    mut bounds = copy_numbers(&c.impl_params[record].bounds);
    mut reqs = u64[][];
    for i in c.impl_params[record].interfaces.len() {
        reqs.push(copy_numbers(&c.impl_params[record].interfaces[i]));
    }
    mut args = u64[];
    for i in params {
        mut proofs = u64[];
        if i < reqs.len() {
            for j in reqs[i].len() {
                if reqs[i][j] < CALLABLE_BOUND {
                    proofs.push(intern_args(&mut c, 15, reqs[i][j], 0, u64[], u64[]));
                } else if reqs[i][j] < CALLABLE_PENDING {
                    proofs.push(reqs[i][j] - CALLABLE_BOUND);
                }
            }
        }
        mut bits = 0;
        if i < bounds.len() {
            bits = bounds[i];
        }
        args.push(intern_args(&mut c, 9, i, bits, u64[], proofs));
    }
    self := intern_args(&mut c, 8, decl - 1, 0, u64[], args);
    mut item = &mut c.impl_params[record];
    exchange(&mut item.self_ty, self);
    return ();
}

fn iface_env_decl<a, b>(c: (&a mut C), local: &b [u8]) -> u64 {
    for i in c.iface_env_names.len() {
        if same(view(c.iface_env_names[i]), view(local)) {
            return c.iface_env[i] + 1;
        }
    }
    return 0;
}

// ---- the build path: emit, verify, or read instead of parsing ----
// The module a source file declares, found without parsing: `module NAME;` after optional
// whitespace, comments and `unsafe`. An empty name means the file is the entry (which may omit its
// module declaration) and is therefore always compiled from source.
fn iface_scan<a>(path: &a [u8]) -> u8[] {
    text := host::read_file(view(path));
    mut i = 0;
    mut name = u8[];
    while i < text.len() {
        c := text[i];
        if (c == 32) || (c == 9) || (c == 10) || (c == 13) || (c == 12) {
            i += 1;
        } else if (c == 47) && (i + 1 < text.len()) && (text[i + 1] == 47) {
            while (i < text.len()) && (text[i] != 10) {
                i += 1;
            }
        } else {
            mut word = u8[];
            while (i < text.len()) && iface_ident_byte(text[i]) {
                word.push(text[i]);
                i += 1;
            }
            if same(view(word), view("module")) {
                while (i < text.len()) && ((text[i] == 32) || (text[i] == 9)) {
                    i += 1;
                }
                while (i < text.len()) && iface_ident_byte(text[i]) {
                    name.push(text[i]);
                    i += 1;
                }
                return name;
            }
            if same(view(word), view("unsafe")) {
                // `unsafe module NAME;`: keep scanning.
                continue;
            }
            return u8[];
        }
    }
    return name;
}

fn iface_ident_byte(b: u64) -> bool {
    return ((64 < b) & (b < 91)) || ((96 < b) & (b < 123)) || ((47 < b) & (b < 58)) || (b == 95);
}

// True when `name` occurs in `text` as a whole identifier.
fn iface_mentions<a, b>(text: &a [u8], name: &b [u8]) -> bool {
    if name.len() == 0 {
        return false;
    }
    mut i = 0;
    while i + name.len() <= text.len() {
        mut hit = true;
        for j in name.len() {
            if text[i + j] != name[j] {
                hit = false;
                break;
            }
        }
        if hit {
            before_ok := (i == 0) || !ident_byte(text[i - 1]);
            after := i + name.len();
            after_ok := (after == text.len()) || !ident_byte(text[after]);
            if before_ok & after_ok {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

fn ident_byte(b: u8) -> bool {
    return ((97 <= b) & (b <= 122)) || ((65 <= b) & (b <= 90)) || ((48 <= b) & (b <= 57)) || (b == 95);
}

// ---- loading an interface ----
fn iface_starts<a, b>(text: &a [u8], prefix: &b [u8]) -> bool {
    if text.len() < prefix.len() {
        return false;
    }
    for i in prefix.len() {
        if text[i] != prefix[i] {
            return false;
        }
    }
    return true;
}

fn iface_file_index<a, b>(c: (&a mut C), path: &b [u8]) -> u64 {
    count := c.mod_base + c.mod_files.len();
    mut i = 2;
    while i < count {
        if same(view(input_path(&c, i)), view(path)) {
            return i;
        }
        i += 1;
    }
    return 0;
}

// The runtime has no interface: every run knows its declarations already, and it is compiled in a run
// of its own. Its summary is what the other runs still need - whether `rt_push` allocates, whether
// `rt_abort` fails - so the run that emitted its bodies writes `runtime.facts` beside the interfaces:
// the header, one summary record and the seal, read by every run that reads interfaces there.
fn fx_write_runtime_facts<a>(c: (&a mut C)) -> unit {
    if c.iface_emit.len() == 0 {
        return ();
    }
    // Only the run that emitted the runtime's bodies writes it: every other run knows the runtime's
    // declarations and has its rows, and modules compile at the same time.
    mut listed = u64[];
    mut emitted = 0;
    for i in c.funcs.len() {
        if same(view(c.funcs[i].module), view("runtime")) {
            listed.push(i);
            k := fx_find(&mut c, view(fx_func_symbol(&mut c, i)));
            if (k != 0) && (c.fx_body[k - 1] != 0) {
                emitted = 1;
            }
        }
    }
    if emitted == 0 {
        return ();
    }
    facts := iface_facts_bytes(&mut c, view("runtime"), &listed);
    if facts.len() == 0 {
        return ();
    }
    mut out = u8[];
    out.push(71);
    out.push(82);
    out.push(73);
    out.push(70);
    out.push(IFACE_VERSION);
    iface_wrec(&mut out, IFACE_TAG_FACTS, view(facts));
    if c.xinl.names.len() != 0 {
        mut bodies = u8[];
        iface_wv(&mut bodies, c.xinl.names.len());
        for i in c.xinl.names.len() {
            iface_ws(&mut bodies, view(c.xinl.names[i]));
            iface_ws(&mut bodies, view(c.xinl.bodies[i]));
        }
        iface_wrec(&mut out, IFACE_TAG_INLINE, view(bodies));
    }
    iface_seal_out(&mut out, view(""));
    host::mkdir(view(c.iface_emit));
    file := iface_join(view(c.iface_emit), view("runtime"), view(".facts"));
    if host::write_file(view(file), view(out)) != 0 {
        iface_refuse(view(file), view("cannot write the runtime's effect summary"));
    }
    return ();
}
// The runtime's summary, read before any body: its rows answer for the runtime's functions in a run
// that does not emit them. A run that does emit them replaces each row with its own body's facts. A
// file of another format is not half-read: it is ignored, and the runtime's functions stay unknown.
fn fx_read_runtime_facts<a>(c: (&a mut C)) -> unit {
    mut dir = c.iface_use.copy();
    if dir.len() == 0 {
        dir = c.iface_dir.copy();
    }
    if dir.len() == 0 {
        return ();
    }
    file := iface_join(view(dir), view("runtime"), view(".facts"));
    if host::exists(view(file)) == 0 {
        return ();
    }
    data := host::read_file(view(file));
    if (data.len() < 6) || (data[0] != 71) || (data[1] != 82) || (data[2] != 73) || (data[3] != 70) || (data[4] != IFACE_VERSION) {
        return ();
    }
    if data[5] != IFACE_TAG_FACTS {
        return ();
    }
    mut p = IR { data: data.copy(), at: 6, stop: data.len(), path: file.copy(), phase: 2, rtext: u8[], what: u8[] };
    len := iface_rv(&mut p);
    p.stop = p.at + len;
    iface_rec_facts(&mut c, &mut p);
    // The inlinable bodies, when the run that wrote it exported any.
    p.at = p.stop;
    p.stop = data.len();
    if (p.at < p.stop) && (data[p.at] == IFACE_TAG_INLINE) {
        start := iface_rec(&mut p, IFACE_TAG_INLINE);
        n := iface_rv(&mut p);
        for i in n {
            name := iface_rs(&mut p);
            body := iface_rs(&mut p);
            c.xinl.names.push(name);
            c.xinl.bodies.push(body);
        }
        iface_rend(&mut p, start);
    }
    return ();
}
// The interfaces this run wrote, again, now with the summaries its solved bodies give them, and the
// manifest over the new bytes. A run that emitted no body (a check) leaves them as they were.
fn iface_emit_facts<a>(c: (&a mut C)) -> unit {
    fx_write_runtime_facts(&mut c);
    if c.iface_out_file.len() == 0 {
        return ();
    }
    mut manifest = u8[];
    push_bytes(&mut manifest, view("// grail-interfaces 1\n"));
    for i in c.iface_out_file.len() {
        file := c.iface_out_file[i].copy();
        m := c.iface_out_module[i].copy();
        old := c.iface_out_text[i].copy();
        text := iface_with_facts(&mut c, view(old), view(m));
        if !same(view(text), view(old)) {
            written := host::write_file(view(file), view(text));
            if written != 0 {
                iface_refuse(view(file), view("cannot write an interface file"));
            }
        }
        mut row = u8[];
        push_bytes(&mut row, view(m));
        out_push(&mut row, 32);
        push_bytes(&mut row, view(iface_digest(&text)));
        out_push(&mut row, 32);
        push_bytes(&mut row, view(iface_manifest_source_digest(&mut c, view(m))));
        out_push(&mut row, 10);
        push_bytes(&mut manifest, view(row));
    }
    host::write_file(view(iface_join(view(c.iface_emit), view("interfaces"), view(".manifest"))), view(manifest));
    return ();
}
// The source digest the manifest records for module `m`: the digest of the file it was read from.
// The sha256 of the source file at `path`, read and digested once per run: the interface's trailer,
// its manifest row and the facts' manifest all name the same source.
fn iface_source_digest<a, b>(c: (&a mut C), path: &b [u8]) -> u8[] {
    for i in c.srcdig_paths.len() {
        if same(view(c.srcdig_paths[i]), view(path)) {
            return c.srcdig_vals[i].copy();
        }
    }
    source := host::read_file(view(path));
    digest := iface_digest(&source);
    c.srcdig_paths.push(copy_bytes(view(path)));
    c.srcdig_vals.push(digest.copy());
    c.srcdig_lens.push(source.len());
    return digest;
}
// The length of that source file (after iface_source_digest has read it).
fn iface_source_len<a, b>(c: (&a mut C), path: &b [u8]) -> u64 {
    iface_source_digest(&mut c, view(path));
    for i in c.srcdig_paths.len() {
        if same(view(c.srcdig_paths[i]), view(path)) {
            return c.srcdig_lens[i];
        }
    }
    return 0;
}
fn iface_manifest_source_digest<a, b>(c: (&a mut C), m: &b [u8]) -> u8[] {
    for i in c.iface_list.len() {
        if same(view(c.iface_list[i].module), view(m)) {
            path := c.iface_list[i].path.copy();
            return iface_source_digest(&mut c, view(path));
        }
    }
    return u8[];
}
// Writes one interface per module of the program, plus the manifest that pins their bytes.
fn iface_emit_all<a>(c: (&a mut C)) -> unit {
    dir := c.iface_emit.copy();
    if dir.len() == 0 {
        return ();
    }
    host::mkdir(view(dir));
    mut manifest = u8[];
    push_bytes(&mut manifest, view("// grail-interfaces 1\n"));
    mut seen = u8[][];
    for i in c.iface_list.len() {
        m := c.iface_list[i].module.copy();
        path := c.iface_list[i].path.copy();
        in_std := c.iface_list[i].std;
        unsafe_flag := c.iface_list[i].unsafe;
        // Whether the module opted in to the ambient `host::` interface; recorded so a build that
        // reads the interface checks its bodies the same way.
        optin := u64(host_opted(&c, view(m)));
        mut done = 0;
        for j in seen.len() {
            if same(view(seen[j]), view(m)) {
                done = 1;
            }
        }
        // The runtime is the trusted base: it is compiled from source in every build, never read
        // from an interface, and two files declare it (runtime.grl and the platform module), so it
        // has no interface of its own.
        if same(view(m), view("runtime")) {
            continue;
        }
        if done != 0 {
            continue;
        }
        // A module read from an interface is described by the file it came from; this run has no
        // source to write it from and nothing new to say about it.
        if iface_owned(&mut c, view(m)) {
            continue;
        }
        seen.push(m.copy());
        text := iface_module_bytes(&mut c, view(m), view(path), in_std, unsafe_flag, optin, view(""));
        file := iface_join(view(dir), view(m), view(".iface"));
        written := host::write_file(view(file), view(text));
        if written != 0 {
            iface_refuse(view(file), view("cannot write an interface file"));
        }
        c.iface_out_file.push(file.copy());
        c.iface_out_text.push(text.copy());
        c.iface_out_module.push(m.copy());
        mut row = u8[];
        push_bytes(&mut row, view(m));
        out_push(&mut row, 32);
        push_bytes(&mut row, view(iface_digest(&text)));
        out_push(&mut row, 32);
        push_bytes(&mut row, view(iface_source_digest(&mut c, view(path))));
        out_push(&mut row, 10);
        push_bytes(&mut manifest, view(row));
    }
    host::write_file(view(iface_join(view(dir), view("interfaces"), view(".manifest"))), view(manifest));
    return ();
}

