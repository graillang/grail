        }
        return val(save(&mut c), ty);
    }
    code := int_code(&mut c, ty);
    op := imm(&mut c, k);
    cv := imm(&mut c, code);
    mut args = u64[];
    args.push(op);
    args.push(left);
    args.push(right);
    args.push(cv);
    slot := invoke(&mut c, view("rt_int"), args);
