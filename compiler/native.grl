                o(&mut c, view("switchctx\n"));
            }
        }
    }
    if (122 < id) & (id < 132) {
        get(&mut c, args[0], view("%rax"));
        if id < 129 {
            get(&mut c, args[1], view("%rcx"));
        }
        mut name = "add";
        if id == 124 {
            name = "sub";
        }
        if id == 125 {
            name = "mul";
        }
        if id == 126 {
            name = "div";
        }
        if id == 127 {
            name = "lt";
        }
        if id == 128 {
            name = "eq";
        }
        if id == 129 {
            name = "sqrt";
        }
        if id == 130 {
            name = "fromi";
        }
        if id == 131 {
            name = "toi";
