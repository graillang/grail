// Whether the closure being compiled writes the named capture: only then may the body take
// exclusive access to the environment field that holds it.
fn capture_writable<a, b>(c: (&a mut C), name: &b [u8]) -> u64 {
    j := capture_of(&mut c, view(name));
    if j == 0 {
        return 0;
    }
    cl := &c.closures[c.closure_env - 1];
    return cl.written[j - 1];
