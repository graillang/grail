    }
    mut loan = 0;
    if authority != 0 {
        if mode {
            mut r = resource(borrow_mut(c), authority - 1);
            info := &c.resources[r - 1];
            ty := info.ty;
            if ty_mode(borrow_mut(c), ty) == 0 {
                fail(borrow_mut(c), &"mutable borrow through readonly frame");
            }
        }
        parent := authority_loan(borrow_mut(c), authority, target);
        if parent == 0 {
            fail(borrow_mut(c), &"reference has no access authority");
        }
        loan = ownership::reborrow_place(borrow_mut(c.check), parent, target, mode);
        owner := place_of(borrow_mut(c), authority - 1);
        holder := place_of(borrow_mut(c), value);
        n := c.bonds.len();
        for i in n {
            mut b = &c.bonds[i];
            old := b.loan;
            h := b.holder;
            guard := b.guard;
            if (h == owner) & (guard != 0) {
                bond_kind(borrow_mut(c), holder, old, 1);
            }
            if (h == owner) & (old != parent) & (guard == 0) {
                if loan_live(borrow_mut(c), old) {
                    extra := ownership::reborrow(borrow_mut(c.check), old, mode);
                    if extra == 0 {
                        fail(borrow_mut(c), &"ambiguous reborrow lacks authority");
                    }
                    bond(borrow_mut(c), holder, extra);
                }
            }
        }
    } else {
        loan = ownership::borrow_place(borrow_mut(c.check), target, mode);
    }
    if loan == 0 {
        fail(borrow_mut(c), &"borrow conflicts with active access");
    }
    holder := place_of(borrow_mut(c), value);
    bond(borrow_mut(c), holder, loan);
    return ();
}
fn borrow_reference<a>(
    c: (&a mut C),
    slot: u64,
    ty: u64,
    source: u64,
    target: u64,
    mode: u64
) -> Val {
    own(borrow_mut(c), slot, ty);
    bind_loan(borrow_mut(c), slot, source, target, mode);
    set_target(borrow_mut(c), slot, target, slot + 1);
    return val(slot, ty);
}
fn view_bonds<a>(c: (&a mut C), slot: u64, source: u64, mode: u64) -> unit {
    if c.raw {
        return ();
    }
    root := place_of(borrow_mut(c), source);
    holder := place_of(borrow_mut(c), slot);
    if root == 0 {
        fail(borrow_mut(c), &"view source is not tracked");
    }
    source_index := resource(borrow_mut(c), source);
    mut r = &c.resources[source_index - 1];
    ty := r.ty;
    if ty_kind(borrow_mut(c), ty) == 5 {
        if mode {
            index := resource(borrow_mut(c), source);
            mut r = &c.resources[index - 1];
            base := r.base;
            authority := r.authority;
            if base != 0 {
                if authority != 0 {
                    mut r = resource(borrow_mut(c), authority - 1);
                    info := &c.resources[r - 1];
                    ty := info.ty;
                    if ty_mode(borrow_mut(c), ty) == 0 {
                        fail(borrow_mut(c), &"unique field reborrow through readonly frame");
                    }
                    parent := authority_loan(borrow_mut(c), authority, root);
                    if ownership::access_loan(borrow(c.check), parent, root, 1) != 0 {
                        fail(borrow_mut(c), &"unique field reborrow requires mutable frame");
                    }
                } else {
                    if ownership::can_cleanup(borrow(c.check), root) == 0 {
                        fail(borrow_mut(c), &"field frame is shared");
                    }
                }
            }
        }
        mut found = 0;
        n := c.bonds.len();
        for i in n {
            mut b = &c.bonds[i];
            h := b.holder;
            parent := b.loan;
            guard := b.guard;
            if loan_live(borrow_mut(c), parent) {
                if ownership::ancestor(borrow(c.check), h, root) {
                    if guard {
                        bond_kind(borrow_mut(c), holder, parent, 1);
                    } else {
                        loan := ownership::reborrow(borrow_mut(c.check), parent, mode);
                        if loan == 0 {
                            fail(borrow_mut(c), &"view reborrow lacks authority");
                        }
                        bond(borrow_mut(c), holder, loan);
                        found = 1;
                    }
                }
            }
        }
        if found == 0 {
            fail(borrow_mut(c), &"view has no lifetime source");
        }
    } else {
        bind_loan(borrow_mut(c), slot, source, root, mode);
    }
    return ();
}
fn validate_return<a>(c: (&a mut C), v: Val) -> unit {
    if c.raw {
        return ();
    }
    if contains_borrow(borrow_mut(c), v.ty, 0) == 0 {
        return ();
    }
    place := place_of(borrow_mut(c), v.t);
    if place == 0 {
        return ();
    }
    result := c.result;
    mut rs = type_caps(borrow_mut(c), result, 0);
    mut found = 0;
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if ownership::ancestor(borrow(c.check), place, holder) {
            if loan_live(borrow_mut(c), loan) {
                mut l = &c.check.loans[loan - 1];
                source := l.source;
                region := region_of(borrow_mut(c), source);
                mut allowed = 0;
                for j in rs.len() {
                    if rs[j] == region {
                        allowed = 1;
                    }
                }
                if region != 18446744073709551615 {
                    if (region == 0) + (allowed == 0) {
                        fail(borrow_mut(c), &"returned borrow escapes its declared input lifetime");
                    }
                }
                found = 1;
            }
        }
    }
    k := ty_kind(borrow_mut(c), v.ty);
    if (k == 5) + (k == 7) {
        if found == 0 {
            fail(borrow_mut(c), &"returned reference has no checked source");
        }
    }
    return ();
}
fn place_of<a>(c: (&a mut C), slot: u64) -> u64 {
    mut r = resource(borrow_mut(c), slot);
    if r == 0 {
        return 0;
    }
    mut r = &c.resources[r - 1];
    return r.place;
}
fn observe<a>(c: (&a mut C), slot: u64) -> unit {
    if c.raw {
        return ();
    }
    place := place_of(borrow_mut(c), slot);
    if place == 0 {
        return ();
    }
    authority := authority_of(borrow_mut(c), slot);
    index := resource(borrow_mut(c), slot);
    info := &c.resources[index - 1];
    base := info.base;
    ty := info.ty;
    if (authority != 0) & (base != 0) {
        loan := authority_loan(borrow_mut(c), authority, place);
        if loan == 0 {
            fail(borrow_mut(c), &"access has no live reference authority");
        }
        if ownership::access_loan(borrow(c.check), loan, place, 0) != 0 {
            fail(borrow_mut(c), &"reference access conflicts with active borrow");
        }
    } else {
        if ownership::read(borrow(c.check), place) != 0 {
            fail(borrow_mut(c), &"use of moved, borrowed or partially initialized value");
        }
    }
    k := ty_kind(borrow_mut(c), ty);
    if (k == 5) + (k == 7) {
        mut checked = 0;
        for i in c.bonds.len() {
            mut b = &c.bonds[i];
            h := b.holder;
            loan := b.loan;
            guard := b.guard;
            if (guard == 0) & ownership::ancestor(borrow(c.check), h, place) {
                if loan_live(borrow_mut(c), loan) {
                    checked = 1;
                    if ownership::use_loan(borrow(c.check), loan, 0) != 0 {
                        fail(borrow_mut(c), &"reference is suspended or expired");
                    }
                }
            }
        }
        if checked == 0 {
            fail(borrow_mut(c), &"reference lacks checked source");
        }
    }
    return ();
}
fn inherit_guards<a>(c: (&a mut C), place: u64) -> unit {
    if place == 0 {
        return ();
    }
    n := c.bonds.len();
    for i in n {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        if holder != place {
            if ownership::ancestor(borrow(c.check), holder, place) {
                bond_kind(borrow_mut(c), place, loan, 1);
            }
        }
    }
    return ();
}
fn capture_authority<a>(c: (&a mut C), place: u64) -> unit {
    if place == 0 {
        return ();
    }
    for i in c.bonds.len() {
        mut b = &c.bonds[i];
        holder := b.holder;
        loan := b.loan;
        guard := b.guard;
        if guard == 0 {
            if loan_live(borrow_mut(c), loan) {
                if ownership::ancestor(borrow(c.check), place, holder) {
                    if ownership::use_loan(borrow(c.check), loan, 0) != 0 {
                        fail(borrow_mut(c), &"captured authority is suspended");
                    }
                }
            }
        }
    }
    return ();
}
fn alias_field<a>(c: (&a mut C), slot: u64, ty: u64, base: u64, field: u64, via: u64) -> Val {
    if c.raw == 0 {
        root := place_of(borrow_mut(c), base);
        place := member_place(borrow_mut(c), root, field, ty);
        authority := authority_of(borrow_mut(c), base);
        c
            .resources
            .push(
                Resource {
                    slot: slot,
                    ty: ty,
                    flag: 0,
                    base: base + 1,
                    field: field,
                    via: via,
                    place: place,
                    target: 0,
                    authority: authority,
                }
            );
        if contains_borrow(borrow_mut(c), ty, 0) {
            inherit_guards(borrow_mut(c), place);
        }
        stored_source(borrow_mut(c), slot, ty);
    }
    return val(slot, ty);
}
fn drop_name<a>(c: (&a mut C), ty: u64) -> unit {
    o(borrow_mut(c), &".D");
    on(borrow_mut(c), ty);
    return ();
}
fn release<a>(c: (&a mut C), index: u64) -> unit {
    mut r = &c.resources[index];
    flag := r.flag;
    slot := r.slot;
    ty := r.ty;
    place := r.place;
    base := r.base;
    if flag == 0 {
        if base == 0 {
            if place != 0 {
                if ownership::cleanup(borrow_mut(c.check), place) != 0 {
                    fail(borrow_mut(c), &"storage ends while borrowed");
                }
                close_loans(borrow_mut(c));
            }
        }
        return ();
    }
    if place != 0 {
        if ownership::cleanup(borrow_mut(c.check), place) != 0 {
            fail(borrow_mut(c), &"cleanup conflicts with live loan");
        }
    }
    done := label(borrow_mut(c));
    o(borrow_mut(c), &"cmpq $0,");
    stack_slot(borrow_mut(c), flag - 1);
    c.out.push(10);
    jump(borrow_mut(c), &"je", done);
    o(borrow_mut(c), &"movq $0,");
    stack_slot(borrow_mut(c), flag - 1);
    c.out.push(10);
    get(borrow_mut(c), slot, &"%rdi");
    o(borrow_mut(c), &"call ");
    drop_name(borrow_mut(c), ty);
    c.out.push(10);
    mark(borrow_mut(c), done);
    close_loans(borrow_mut(c));
    return ();
}
fn cleanup<a>(c: (&a mut C), mark: u64) -> unit {
    if c.raw {
        return ();
    }
    mut i = c.resources.len();
    while mark < i {
        i = i - 1;
        release(borrow_mut(c), i);
    }
    return ();
}
fn move_out<a>(c: (&a mut C), v: Val) -> unit {
    if c.raw {
        return ();
    }
    if needs_drop(borrow_mut(c), v.ty) == 0 {
        if ty_kind(borrow_mut(c), v.ty) != 7 {
            return ();
        }
    }
    index := resource(borrow_mut(c), v.t);
    if index == 0 {
        fail(borrow_mut(c), &"owned value lacks ownership record");
    }
    mut r = &c.resources[index - 1];
    flag := r.flag;
    base := r.base;
    field := r.field;
    via := r.via;
    place := r.place;
    if place != 0 {
        capture_authority(borrow_mut(c), place);
        if ownership::take(borrow_mut(c.check), place) != 0 {
            fail(borrow_mut(c), &"move of unavailable or borrowed value");
        }
    }
    if flag != 0 {
        o(borrow_mut(c), &"movq $0,");
        stack_slot(borrow_mut(c), flag - 1);
        c.out.push(10);
    } else {
        if base != 0 {
            if via {
                fail(borrow_mut(c), &"cannot move owned field through reference");
            }
            zero := imm(borrow_mut(c), 0);
            rec_store(borrow_mut(c), base - 1, field, zero);
        }
    }
    return ();
}
fn move_value<a>(c: (&a mut C), v: Val) -> Val {
    get(borrow_mut(c), v.t, &"%rax");
    slot := save(borrow_mut(c));
    old := place_of(borrow_mut(c), v.t);
    target := target_of(borrow_mut(c), v.t);
    move_out(borrow_mut(c), val(v.t, v.ty));
    own(borrow_mut(c), slot, v.ty);
    dst := place_of(borrow_mut(c), slot);
    kind := ty_kind(borrow_mut(c), v.ty);
    if contains_borrow(borrow_mut(c), v.ty, 0) {
        return_bonds(borrow_mut(c), old, dst, (kind == 6) + (kind == 8));
    }
    if ty_kind(borrow_mut(c), v.ty) == 7 {
        set_target(borrow_mut(c), slot, target, slot + 1);
    }
    return val(slot, v.ty);
}
// ---- tokens ----
fn kind<a>(c: (&a mut C)) -> u64 {
    p := c.pos;
    t := &c.toks[p];
    return t.kind;
}
fn next_kind<a>(c: (&a mut C)) -> u64 {
    p := c.pos + 1;
    return kind_at(borrow_mut(c), p);
}
fn kind_at<a>(c: (&a mut C), i: u64) -> u64 {
    if c.toks.len() < i + 1 {
        return 0;
    }
    t := &c.toks[i];
    return t.kind;
}
fn advance<a>(c: (&a mut C)) -> unit {
    p := c.pos + 1;
    exchange(borrow_mut(c.pos), p);
    return ();
}
fn tok_text<a>(c: (&a mut C), i: u64) -> u8[] {
    t := &c.toks[i];
    st := t.start;
    en := t.end;
    return (c.src[st: en]).copy();
}
fn is<a, b>(c: (&a mut C), s: &b [u8]) -> u64 {
    p := c.pos;
    t := tok_text(borrow_mut(c), p);
    return same(&t, s);
}
fn fail<a, b>(c: (&a mut C), msg: &b [u8]) -> unit {
    p := c.pos;
    m := tok_text(borrow_mut(c), p);
    t := &c.toks[p];
    st := t.start;
    exchange(borrow_mut(c.out), u8[]);
    // file:line:column: message (byte offset kept for tools)
    mut line = 1;
    mut column = 1;
    for i in st {
        if c.src[i] == 10 {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    offset := c.arg_offset;
    file := c.file;
    path := host::arg(file + offset);
    o(borrow_mut(c), &path);
    c.out.push(58);
    on(borrow_mut(c), line);
    c.out.push(58);
    on(borrow_mut(c), column);
    o(borrow_mut(c), &": ");
    o(borrow_mut(c), msg);
    o(borrow_mut(c), &" at byte ");
    on(borrow_mut(c), st);
    o(borrow_mut(c), &" near '");
    o(borrow_mut(c), &m);
    o(borrow_mut(c), &"'\n");
    // The source line, with a caret under the error column.
    mut begin = st;
    while 0 < begin {
        if c.src[begin - 1] == 10 {
            break;
        }
        begin -= 1;
    }
    mut finish = st;
    while finish < c.src.len() {
        if c.src[finish] == 10 {
            break;
        }
        finish += 1;
    }
    o(borrow_mut(c), &"  | ");
    for i in finish - begin {
        b := c.src[begin + i];
        if b == 9 {
            c.out.push(32);
        } else {
            c.out.push(b);
        }
    }
    c.out.push(10);
    o(borrow_mut(c), &"  | ");
    for i in column - 1 {
        c.out.push(32);
    }
    mut width = m.len();
    if width == 0 {
        width = 1;
    }
    if 60 < width {
        width = 60;
    }
    for i in width {
        c.out.push(94);
    }
    c.out.push(10);
    host::print(&c.out);
    assert(0);
    return ();
}
fn eat<a, b>(c: (&a mut C), s: &b [u8]) -> u64 {
    if is(borrow_mut(c), s) {
        advance(borrow_mut(c));
        return 1;
    }
    return 0;
}
fn expect<a, b>(c: (&a mut C), s: &b [u8]) -> unit {
    want := s.copy();
    if eat(borrow_mut(c), s) == 0 {
        mut msg = "expected ";
        msg.append(&want);
        fail(borrow_mut(c), &msg);
    }
    return ();
}
fn ident<a>(c: (&a mut C)) -> u8[] {
    if kind(borrow_mut(c)) != 1 {
        fail(borrow_mut(c), &"expected identifier");
    }
    p := c.pos;
    t := tok_text(borrow_mut(c), p);
    if same(&t, &"true") + same(&t, &"false") {
        fail(borrow_mut(c), &"truth keyword is not an identifier");
    }
    advance(borrow_mut(c));
    return t;
}
// Skips a balanced {...} group starting at the current '{'.
fn skip_braces<a>(c: (&a mut C)) -> unit {
    mut depth = 0;
    while 1 {
        k := kind(borrow_mut(c));
        if k == 123 {
            depth = depth + 1;
        }
        if k == 125 {
            depth = depth - 1;
        }
        if k == 0 {
            fail(borrow_mut(c), &"unclosed {");
        }
        advance(borrow_mut(c));
        if depth == 0 {
            return ();
        }
    }
    return ();
}
fn load_file<a>(c: (&a mut C), index: u64) -> unit {
    offset := c.arg_offset;
    path := host::arg(index + offset);
    if host::exists(&path) == 0 {
        host::print(&"grail: cannot read input file ");
        host::print(&path);
        host::print(&"\n");
        host::exit(1);
    }
    src := host::read_file(&path);
    mut toks = Tok[];
    lexed := lexer::tokenize(&src);
    for i in lexed.len() {
        t := &lexed[i];
        toks.push(Tok { kind: t.kind, start: t.start, end: t.end });
    }
    drop(lexed);
    exchange(borrow_mut(c.toks), toks);
    exchange(borrow_mut(c.src), src);
    exchange(borrow_mut(c.pos), 0);
    return ();
}

// ---- types and declarations ----
fn numbers_equal<a, b>(a: (&a u64[]), b: (&b u64[])) -> u64 {
    if a.len() != b.len() {
        return 0;
    }
    for i in a.len() {
        if a[i] != b[i] {
            return 0;
        }
    }
    return 1;
}
fn intern_args<a>(c: (&a mut C), k: u64, arg: u64, mode: u64, regions: u64[], args: u64[]) -> u64 {
    for i in c.types.len() {
        t := &c.types[i];
        if (t.kind == k) & (t.arg == arg) & (t.mode == mode) {
            if numbers_equal(borrow(t.regions), borrow(regions)) {
                if numbers_equal(borrow(t.args), borrow(args)) {
                    return i;
                }
            }
        }
    }
    c.types.push(Ty { kind: k, arg: arg, mode: mode, regions: regions, args: args });
    return c.types.len() - 1;
}
fn intern_full<a>(c: (&a mut C), k: u64, arg: u64, mode: u64, regions: u64[]) -> u64 {
    return intern_args(borrow_mut(c), k, arg, mode, regions, u64[]);
}
fn type_args<a>(c: (&a mut C), ty: u64) -> u64[] {
    mut args = u64[];
    t := &c.types[ty];
    for i in t.args.len() {
        args.push(t.args[i]);
    }
    return args;
}
fn intern<a>(c: (&a mut C), k: u64, arg: u64) -> u64 {
    return intern_full(borrow_mut(c), k, arg, 0, u64[]);
}
fn copy_numbers<a>(input: (&a u64[])) -> u64[] {
    mut out = u64[];
    for i in input.len() {
        out.push(input[i]);
    }
    return out;
}
fn transfer_capability<a, b>(
    c: (&a mut C),
    ty: u64,
    shared: u64,
    trail: (&b mut u64[]),
    depth: u64
) -> u64 {
    if 64 < depth {
        return false;
    }
    k := ty_kind(borrow_mut(c), ty);
    arg := ty_arg(borrow_mut(c), ty);
    if (k == 1)
        + (k == 2)
        + (k == 3)
        + (k == 4)
        + (k == 11)
        + (k == 12)
        + (k == 17)
        + (k == 18)
        + (k == 19)
        + (k == 21) {
        return true;
    }
    if k == 14 {
        return false;
    }
    if k == 5 {
        if shared {
            return ty_mode(borrow_mut(c), ty) == 0;
        }
        return true;
    }
    if k == 9 {
        proof := ty_mode(borrow_mut(c), ty);
        mut bit = 1;
        if shared {
            bit = 2;
        }
        return (proof & bit) != 0;
    }
    if k == 10 {
        return transfer_capability(borrow_mut(c), arg, shared, borrow_mut(trail), depth + 1);
    }
    key := ty * 2 + shared;
    for i in trail.len() {
        if trail[i] == key {
            return true;
        }
    }
    trail.push(key);
    mut allowed = 0;
    if k == 6 {
        allowed = transfer_capability(borrow_mut(c), arg, shared, borrow_mut(trail), depth + 1);
    }
    // A mutex serializes access: sharing it only requires that its payload may move between threads.
    if k == 13 {
        allowed = transfer_capability(borrow_mut(c), arg, 0, borrow_mut(trail), depth + 1);
    }
    // A scope stays on the thread running its body; a task handle may move (join is ownership-based).
    if k == 16 {
        if shared == 0 {
            allowed = transfer_capability(borrow_mut(c), arg, 0, borrow_mut(trail), depth + 1);
        }
    }
    if k == 7 {
        mode := ty_mode(borrow_mut(c), ty);
        if mode {
            if shared == 0 {
                allowed = transfer_capability(borrow_mut(c), arg, 0, borrow_mut(trail), depth + 1);
            }
        } else {
            allowed = transfer_capability(borrow_mut(c), arg, 1, borrow_mut(trail), depth + 1);
        }
    }
    if k == 8 {
        d := &c.decls[arg];
        count := d.count;
        allowed = 1;
        for i in count {
            field := field_type(borrow_mut(c), ty, i);
            if transfer_capability(borrow_mut(c), field, shared, borrow_mut(trail), depth + 1)
                == 0 {
                allowed = 0;
                break;
            }
        }
    }
    trail.pop();
    return allowed;
}
fn require_constraints<a, b, d>(c: (&a mut C), arguments: (&b u64[]), bounds: (&d u64[])) -> unit {
    if arguments.len() != bounds.len() {
        fail(borrow_mut(c), &"generic constraint arity");
    }
    for i in bounds.len() {
        mask := bounds[i];
        ty := arguments[i];
        if mask & 1 {
            mut trail = u64[];
            if transfer_capability(borrow_mut(c), ty, 0, borrow_mut(trail), 0) == 0 {
                fail(borrow_mut(c), &"type does not satisfy Send");
            }
        }
        if mask & 2 {
            mut trail = u64[];
            if transfer_capability(borrow_mut(c), ty, 1, borrow_mut(trail), 0) == 0 {
                fail(borrow_mut(c), &"type does not satisfy Share");
            }
        }
    }
    return ();
}
// Forward declarations are optimistically incomplete while collecting headers. Recheck
// every instantiated nominal type after all layouts are known, before generating bodies.
fn validate_type_constraints<a>(c: (&a mut C)) -> unit {
    mut i = 0;
    while i < c.types.len() {
        if ty_kind(borrow_mut(c), i) == 8 {
            decl := ty_arg(borrow_mut(c), i);
            arguments := type_args(borrow_mut(c), i);
            bounds := declaration_bounds(borrow(c), decl);
            require_constraints(borrow_mut(c), borrow(arguments), borrow(bounds));
            requirements := declaration_constraints(borrow(c), decl);
            require_interfaces(borrow_mut(c), borrow(arguments), borrow(requirements));
        }
        i += 1;
    }
    return ();
}
fn function_bounds<a>(c: (&a C), index: u64) -> u64[] {
    f := &c.funcs[index];
    return copy_numbers(borrow(f.bounds));
}
fn declaration_bounds<a>(c: (&a C), index: u64) -> u64[] {
    d := &c.decls[index];
    return copy_numbers(borrow(d.bounds));
}
fn copy_constraints<a>(input: (&a u64[][])) -> u64[][] {
    mut out = u64[][];
    for i in input.len() {
        out.push(copy_numbers(&input[i]));
    }
    return out;
}
fn function_constraints<a>(c: (&a C), index: u64) -> u64[][] {
    f := &c.funcs[index];
    return copy_constraints(borrow(f.constraints));
}
fn declaration_constraints<a>(c: (&a C), index: u64) -> u64[][] {
    d := &c.decls[index];
    return copy_constraints(borrow(d.constraints));
}
fn find_interface<a, b, d>(c: (&a C), module: &b [u8], name: &d [u8]) -> u64 {
    for i in c.interfaces.len() {
        item := &c.interfaces[i];
        if same(&item.module, &module) & same(&item.name, &name) {
            return i + 1;
        }
    }
    return 0;
}
fn resolve_import<a, b>(c: (&a mut C), n: &b [u8]) -> u8[] {
    mut found = 0;
    mut module = u8[];
    for i in c.imports.len() {
        im_name := c.imports[i].name.copy();
        im_module := c.imports[i].module.copy();
        if same(&im_name, &n) {
            found += 1;
            module = im_module;
        }
    }
    if found > 1 {
        fail(borrow_mut(c), &"ambiguous imported name");
    }
    return module;
}
fn ensure_interface<a>(c: (&a mut C), module: u8[], name: u8[]) -> u64 {
    existing := find_interface(borrow(c), &module, &name);
    if existing {
        return existing;
    }
    c.interfaces.push(Interface { module: module, name: name, defined: 0, methods: u64[] });
    return c.interfaces.len();
}
fn base_type<a>(c: (&a mut C), ty: u64) -> u64 {
    mut out = ty;
    while ty_kind(borrow_mut(c), out) == 10 {
        out = ty_arg(borrow_mut(c), out);
    }
    return out;
}
fn find_implementation<a>(c: (&a mut C), contract: u64, ty: u64) -> u64 {
    actual := base_type(borrow_mut(c), ty);
    for i in c.implementations.len() {
        item := &c.implementations[i];
        id := item.contract;
        other := item.ty;
        if id == contract {
            if same_type(borrow_mut(c), actual, other) {
                return i + 1;
            }
        }
    }
    return 0;
}
fn satisfies_interface<a>(c: (&a mut C), ty: u64, contract: u64) -> u64 {
    actual := base_type(borrow_mut(c), ty);
    if ty_kind(borrow_mut(c), actual) == 9 {
        proofs := type_args(borrow_mut(c), actual);
        for i in proofs.len() {
            p := proofs[i];
            if ty_kind(borrow_mut(c), p) == 15 {
                if ty_arg(borrow_mut(c), p) == contract {
                    return true;
                }
            }
        }
        return false;
    }
    if c.headers_complete == 0 {
        return true;
    }
    return find_implementation(borrow_mut(c), contract, actual) != 0;
}
fn require_interfaces<a, b, d>(c: (&a mut C), arguments: (&b u64[]), sets: (&d u64[][])) -> unit {
    if arguments.len() != sets.len() {
        fail(borrow_mut(c), &"interface constraint arity");
    }
    for i in sets.len() {
        ty := arguments[i];
        set := &sets[i];
        for j in set.len() {
            id := set[j];
            if satisfies_interface(borrow_mut(c), ty, id) == 0 {
                fail(borrow_mut(c), &"type does not satisfy interface bound");
            }
        }
    }
    return ();
}
fn private_module<a>(prefix: &a [u8], id: u64) -> u8[] {
    mut out = prefix.copy();
    decimal(borrow_mut(out), id);
    return out;
}
fn region_id<a>(c: (&a mut C)) -> u64 {
    n := ident(borrow_mut(c));
    for i in c.rnames.len() {
        mut r = &c.rnames[i];
        if same(&r, &n) {
            return i + 1;
        }
    }
    fail(borrow_mut(c), &"undeclared lifetime");
    return 0;
}
fn lifetime_parameters<a>(c: (&a mut C)) -> unit {
    exchange(borrow_mut(c.rnames), u8[][]);
    exchange(borrow_mut(c.tnames), u8[][]);
    exchange(borrow_mut(c.type_bounds), u64[]);
    exchange(borrow_mut(c.type_interfaces), u64[][]);
    if eat(borrow_mut(c), &"<") {
        while 1 {
            n := ident(borrow_mut(c));
            is_type := (64 < n[0]) & (n[0] < 91);
            if is_type {
                for i in c.tnames.len() {
                    t := &c.tnames[i];
                    if same(&t, &n) {
                        fail(borrow_mut(c), &"duplicate type parameter");
                    }
                }
                mut bounds = 0;
                mut requirements = u64[];
                if eat(borrow_mut(c), &":") {
                    while true {
                        constraint := ident(borrow_mut(c));
                        mut bit = 0;
                        if same(&constraint, &"Send") & (is(borrow_mut(c), &"::") == 0) {
                            bit = 1;
                        }
                        if same(&constraint, &"Share") & (is(borrow_mut(c), &"::") == 0) {
                            bit = 2;
                        }
                        if bit == 0 {
                            mut m = module_copy(borrow_mut(c));
                            mut n = constraint.copy();
                            mut qualified = 0;
                            if eat(borrow_mut(c), &"::") {
                                qualified = 1;
                                m = constraint.copy();
                                n = ident(borrow_mut(c));
                            }
                            if qualified == 0 {
                                imported := resolve_import(borrow_mut(c), &n);
                                if imported.len() != 0 {
                                    m = imported;
                                }
                            }
                            id := ensure_interface(borrow_mut(c), m, n);
                            for i in requirements.len() {
                                if requirements[i] == id {
                                    fail(borrow_mut(c), &"duplicate interface constraint");
                                }
                            }
                            requirements.push(id);
                        } else {
                            if bounds & bit {
                                fail(borrow_mut(c), &"duplicate structural constraint");
                            }
                            bounds += bit;
                        }
                        if eat(borrow_mut(c), &"+") == 0 {
                            break;
                        }
                    }
                }
                c.tnames.push(n);
                c.type_bounds.push(bounds);
                c.type_interfaces.push(requirements);
            } else {
                if c.tnames.len() != 0 {
                    fail(borrow_mut(c), &"lifetimes must precede type parameters");
                }
                for i in c.rnames.len() {
                    mut r = &c.rnames[i];
                    if same(&r, &n) {
                        fail(borrow_mut(c), &"duplicate lifetime");
                    }
                }
                c.rnames.push(n);
            }
            if eat(borrow_mut(c), &">") {
                break;
            }
            expect(borrow_mut(c), &",");
        }
    }
    return ();
}
fn lifetime_arguments<a>(c: (&a mut C)) -> u64[] {
    mut rs = u64[];
    if eat(borrow_mut(c), &"<") {
        while 1 {
            mut r = region_id(borrow_mut(c));
            rs.push(r);
            if eat(borrow_mut(c), &">") {
                break;
            }
            expect(borrow_mut(c), &",");
        }
    }
    return rs;
}
fn nominal_type<a>(c: (&a mut C), d: u64) -> u64 {
    decl := &c.decls[d];
    count := decl.regions;
    types := decl.types;
    mut rs = u64[];
    mut args = u64[];
    if count + types {
        expect(borrow_mut(c), &"<");
        for i in count + types {
            if i != 0 {
                expect(borrow_mut(c), &",");
            }
            if i < count {
                mut r = region_id(borrow_mut(c));
                rs.push(r);
            } else {
                t := parse_type(borrow_mut(c));
                args.push(t);
            }
        }
        expect(borrow_mut(c), &">");
    }
    bounds := declaration_bounds(borrow(c), d);
    require_constraints(borrow_mut(c), borrow(args), borrow(bounds));
    requirements := declaration_constraints(borrow(c), d);
    require_interfaces(borrow_mut(c), borrow(args), borrow(requirements));
    return intern_args(borrow_mut(c), 8, d, 0, rs, args);
}
fn ty_kind<a>(c: (&a mut C), ty: u64) -> u64 {
    t := &c.types[ty];
    return t.kind;
}
fn ty_arg<a>(c: (&a mut C), ty: u64) -> u64 {
    t := &c.types[ty];
    return t.arg;
}
fn ty_mode<a>(c: (&a mut C), ty: u64) -> u64 {
    t := &c.types[ty];
    return t.mode;
}
fn type_regions<a>(c: (&a mut C), ty: u64) -> u64[] {
    mut rs = u64[];
    t := &c.types[ty];
    for i in t.regions.len() {
        rs.push(t.regions[i]);
    }
    return rs;
}
fn substitute<a, b>(c: (&a mut C), ty: u64, map: (&b u64[])) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    mode := ty_mode(borrow_mut(c), ty);
    mut arg = ty_arg(borrow_mut(c), ty);
    mut rs = type_regions(borrow_mut(c), ty);
    if (k == 6) + (k == 7) + (k == 12) + (k == 13) + (k == 14) + (k == 16) + (k == 20) {
        arg = substitute(borrow_mut(c), arg, borrow(map));
    }
    for i in rs.len() {
        mut r = rs[i];
        if r != 0 {
            if map.len() < r {
                fail(borrow_mut(c), &"unbound stored lifetime");
            }
            n := map[r - 1];
            exchange(&mut rs[i], n);
        }
    }
    mut args = type_args(borrow_mut(c), ty);
    for i in args.len() {
        t := args[i];
        mut v = substitute(borrow_mut(c), t, borrow(map));
        exchange(&mut args[i], v);
    }
    return intern_args(borrow_mut(c), k, arg, mode, rs, args);
}
fn bind_types<a, b>(c: (&a mut C), ty: u64, map: (&b u64[])) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    mode := ty_mode(borrow_mut(c), ty);
    mut arg = ty_arg(borrow_mut(c), ty);
    if k == 9 {
        if map.len() < arg + 1 {
            fail(borrow_mut(c), &"unbound type parameter");
        }
        return map[arg];
    }
    if (k == 6) + (k == 7) + (k == 12) + (k == 13) + (k == 14) + (k == 16) + (k == 20) {
        arg = bind_types(borrow_mut(c), arg, borrow(map));
    }
    mut args = type_args(borrow_mut(c), ty);
    for i in args.len() {
        t := args[i];
        mut v = bind_types(borrow_mut(c), t, borrow(map));
        exchange(&mut args[i], v);
    }
    if is_union(borrow_mut(c), ty) {
        for i in args.len() {
            for j in i {
                left := base_type(borrow_mut(c), args[i]);
                right := base_type(borrow_mut(c), args[j]);
                if same_type(borrow_mut(c), left, right) {
                    fail(borrow_mut(c), &"duplicate union member");
                }
            }
        }
    }
    mut rs = type_regions(borrow_mut(c), ty);
    return intern_args(borrow_mut(c), k, arg, mode, rs, args);
}
fn field_type<a>(c: (&a mut C), ty: u64, index: u64) -> u64 {
    d := ty_arg(borrow_mut(c), ty);
    t := field_ty(borrow_mut(c), d, index);
    mut rs = type_regions(borrow_mut(c), ty);
    mut args = type_args(borrow_mut(c), ty);
    field := bind_types(borrow_mut(c), t, borrow(args));
    if rs.len() == 0 {
        return field;
    }
    return substitute(borrow_mut(c), field, borrow(rs));
}
fn concrete_type<a>(c: (&a mut C), ty: u64) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    if k == 9 {
        return 0;
    }
    arg := ty_arg(borrow_mut(c), ty);
    if (k == 6) + (k == 7) + (k == 10) + (k == 12) + (k == 13) + (k == 14) + (k == 16) + (k == 20) {
        if concrete_type(borrow_mut(c), arg) == 0 {
            return 0;
        }
    }
    mut args = type_args(borrow_mut(c), ty);
    for i in args.len() {
        a := args[i];
        if concrete_type(borrow_mut(c), a) == 0 {
            return 0;
        }
    }
    return 1;
}
fn reference_type<a>(c: (&a mut C), ty: u64, mode: u64) -> u64 {
    return intern_full(borrow_mut(c), 7, ty, mode, u64[]);
}
// Shape checking does not discharge lifetime obligations; the loan pass handles those separately.
fn callable_contract<a, b>(
    c: (&a mut C),
    actual: u64,
    expected: u64,
    map: (&b mut u64[]),
    depth: u64
) -> u64 {
    if 64 < depth {
        return false;
    }
    ak := ty_kind(borrow_mut(c), actual);
    ek := ty_kind(borrow_mut(c), expected);
    if ak != ek {
        return false;
    }
    aa := ty_arg(borrow_mut(c), actual);
    ea := ty_arg(borrow_mut(c), expected);
    if (ak == 5) + (ak == 7) + (ak == 10) {
        am := ty_mode(borrow_mut(c), actual);
        em := ty_mode(borrow_mut(c), expected);
        if am != em {
            return false;
        }
    }
    if (ak == 8) + (ak == 9) + (ak == 10) + (ak == 18) {
        if aa != ea {
            return false;
        }
    }
    if ak == 18 {
        if ty_mode(borrow_mut(c), actual) != ty_mode(borrow_mut(c), expected) {
            return false;
        }
    }
    ar := type_regions(borrow_mut(c), actual);
    er := type_regions(borrow_mut(c), expected);
    if ar.len() != er.len() {
        return false;
    }
    for i in ar.len() {
        from := ar[i];
        to := er[i];
        mut seen = 0;
        for j in map.len() / 2 {
            if map[j * 2] == from {
                if map[j * 2 + 1] != to {
                    return false;
                }
                seen = 1;
                break;
            }
        }
        if seen == 0 {
            map.push(from);
            map.push(to);
        }
    }
    if (ak == 6) + (ak == 7) + (ak == 12) + (ak == 13) + (ak == 14) + (ak == 16) + (ak == 20) {
        if callable_contract(borrow_mut(c), aa, ea, borrow_mut(map), depth + 1) == 0 {
            return false;
        }
    }
    ax := type_args(borrow_mut(c), actual);
    ex := type_args(borrow_mut(c), expected);
    if ax.len() != ex.len() {
        return false;
    }
    for i in ax.len() {
        left := ax[i];
        right := ex[i];
        if callable_contract(borrow_mut(c), left, right, borrow_mut(map), depth + 1) == 0 {
            return false;
        }
    }
    return true;
}
fn same_type<a>(c: (&a mut C), x: u64, y: u64) -> u64 {
    a := ty_kind(borrow_mut(c), x);
    mut b = ty_kind(borrow_mut(c), y);
    if a != b {
        return 0;
    }
    if (a == 12) + (a == 20) {
        mut map = u64[];
        return callable_contract(borrow_mut(c), x, y, borrow_mut(map), 0);
    }
    aa := ty_arg(borrow_mut(c), x);
    bb := ty_arg(borrow_mut(c), y);
    if (a == 5) + (a == 7) {
        am := ty_mode(borrow_mut(c), x);
        bm := ty_mode(borrow_mut(c), y);
        if am != bm {
            return 0;
        }
    }
    if (a == 6) + (a == 7) + (a == 13) + (a == 14) + (a == 16) {
        return same_type(borrow_mut(c), aa, bb);
    }
    if a == 8 {
        if aa != bb {
            return 0;
        }
        ax := type_args(borrow_mut(c), x);
        bx := type_args(borrow_mut(c), y);
        if ax.len() != bx.len() {
            return 0;
        }
        for i in ax.len() {
            x := ax[i];
            y := bx[i];
            if same_type(borrow_mut(c), x, y) == 0 {
                return 0;
            }
        }
    }
    if a == 18 {
        am := ty_mode(borrow_mut(c), x);
        bm := ty_mode(borrow_mut(c), y);
        return (aa == bb) & (am == bm);
    }
    if (a == 9) + (a == 21) {
        return aa == bb;
    }
    if a == 10 {
        am := ty_mode(borrow_mut(c), x);
        bm := ty_mode(borrow_mut(c), y);
        return (aa == bb) & (am == bm);
    }
    return 1;
}
fn contains_borrow<a>(c: (&a mut C), ty: u64, depth: u64) -> u64 {
    mut trail = u64[];
    return borrow_walk(borrow_mut(c), ty, borrow_mut(trail));
}
fn borrow_walk<a, b>(c: (&a mut C), ty: u64, trail: (&b mut u64[])) -> u64 {
    k := ty_kind(borrow_mut(c), ty);
    arg := ty_arg(borrow_mut(c), ty);
    if (k == 5) + (k == 7) {
        return 1;
    }
    if (k == 10) + (k == 6) + (k == 13) {
        return borrow_walk(borrow_mut(c), arg, borrow_mut(trail));
    }
    if k == 8 {
        for i in trail.len() {
            if trail[i] == ty {
                return 0;
            }
        }
        trail.push(ty);
        d := &c.decls[arg];
        count := d.count;
        for i in count {
            t := field_type(borrow_mut(c), ty, i);
            if borrow_walk(borrow_mut(c), t, borrow_mut(trail)) {
                trail.pop();
                return 1;
            }
        }
        trail.pop();
    }
    return 0;
}
fn require_type<a>(c: (&a mut C), actual: u64, expected: u64) -> unit {
    // While a type hint is pending the function is recompiled anyway; mismatches are not final.
    if c.tolerant {
        return ();
    }
    if (expected == 0) & is_bool(borrow_mut(c), actual) {
        return ();
    }
    if same_type(borrow_mut(c), actual, expected) == 0 {
        fail(borrow_mut(c), &"type mismatch");
    }
    return ();
}
// Type alias index + 1, or 0.
fn find_alias<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    for i in c.aliases.len() {
        a := &c.aliases[i];
        if same(&a.module, &m) & same(&a.name, &n) {
            return i + 1;
        }
    }
    return 0;
}
// Declaration index + 1, or 0.
fn find_decl_internal<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    for i in c.decls.len() {
        x := &c.decls[i];
        if same(&x.module, &m) & same(&x.name, &n) {
            return i + 1;
        }
    }
    return 0;
}
// These declarations back concise syntax and are not public nominal types.
fn find_decl<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    here := module_copy(borrow_mut(c));
    if same(&m, &"core") & same(&n, &"OptionStorage") & (same(&here, &"core") == 0) {
        return 0;
    }
    if same(&m, &"hashmap") & same(&n, &"Map") & (same(&here, &"hashmap") == 0) {
        return 0;
    }
    return find_decl_internal(borrow_mut(c), m, n);
}
fn find_func<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> u64 {
    for i in c.funcs.len() {
        x := &c.funcs[i];
        if same(&x.module, &m) & same(&x.name, &n) {
            return i + 1;
        }
    }
    return 0;
}
// Field index within decl, failing when absent.
fn find_field<a, b>(c: (&a mut C), decl: u64, n: &b [u8]) -> u64 {
    d := &c.decls[decl];
    first := d.first;
    count := d.count;
    for i in count {
        f := &c.fields[first + i];
        if same(&f.name, &n) {
            return i;
        }
    }
    fail(borrow_mut(c), &"unknown field or variant");
    return 0;
}
fn field_ty<a>(c: (&a mut C), decl: u64, index: u64) -> u64 {
    d := &c.decls[decl];
    k := d.first + index;
    f := &c.fields[k];
    return f.ty;
}
fn module_copy<a>(c: (&a mut C)) -> u8[] {
    return c.module.copy();
}
fn vec_of<a>(c: (&a mut C), e: u64) -> u64 {
    if (ty_kind(borrow_mut(c), e) == 18)
        & (ty_arg(borrow_mut(c), e) == 8)
        & (ty_mode(borrow_mut(c), e) == 0) {
        return 2;
    }
    return intern(borrow_mut(c), 6, e);
}
fn named_type<a>(c: (&a mut C), m: u8[], n: u8[], args: u64[]) -> u64 {
    mut d = find_decl_internal(borrow_mut(c), &m, &n);
    if d == 0 {
        fail(borrow_mut(c), &"concise type needs its standard library module");
    }
    d = d - 1;
    decl := &c.decls[d];
    if (decl.regions != 0) + (decl.types != args.len()) {
        fail(borrow_mut(c), &"concise type has incompatible library declaration");
    }
    bounds := declaration_bounds(borrow(c), d);
    require_constraints(borrow_mut(c), borrow(args), borrow(bounds));
    reqs := declaration_constraints(borrow(c), d);
    require_interfaces(borrow_mut(c), borrow(args), borrow(reqs));
    return intern_args(borrow_mut(c), 8, d, 0, u64[], args);
}
// Union members use an internal tagged layout, independent of library declarations.
fn is_ordinary_union<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(borrow_mut(c), ty) != 8 {
        return false;
    }
    d := ty_arg(borrow_mut(c), ty);
    decl := &c.decls[d];
    return same(&decl.module, &".union");
}
fn is_result_union<a>(c: (&a mut C), ty: u64) -> u64 {
    if ty_kind(borrow_mut(c), ty) != 8 {
        return false;
    }
    d := ty_arg(borrow_mut(c), ty);
    decl := &c.decls[d];
    return same(&decl.module, &".result");
}
fn is_union<a>(c: (&a mut C), ty: u64) -> u64 {
    return is_ordinary_union(borrow_mut(c), ty) + is_result_union(borrow_mut(c), ty);
}
fn result_success_count<a>(c: (&a mut C), ty: u64) -> u64 {
    d := ty_arg(borrow_mut(c), ty);
    decl := &c.decls[d];
    return decl.success;
}
fn append_ordinary<a>(c: (&a mut C), ty: u64, args: (&a mut u64[])) -> unit {
    if is_ordinary_union(borrow_mut(c), ty) {
        items := type_args(borrow_mut(c), ty);
        for i in items.len() {
            args.push(items[i]);
        }
    } else {
        args.push(ty);
    }
    return ();
}
fn check_distinct_members<a>(c: (&a mut C), args: (&a u64[]), success: u64) -> unit {
    for i in args.len() {
        for j in i {
            if same_type(borrow_mut(c), args[i], args[j]) {
                fail(borrow_mut(c), &"duplicate union member");
            }
        }
        if (success != 0) & (i < success) {
            for j in success..args.len() {
                if same_type(borrow_mut(c), args[i], args[j]) {
                    fail(borrow_mut(c), &"overlapping result union");
                }
            }
        }
    }
    return ();
}
fn make_union<a>(c: (&a mut C), args: u64[], success: u64, module: u8[], prefix: &a [u8]) -> u64 {
    check_distinct_members(borrow_mut(c), borrow(args), success);
    mut name = prefix.copy();
    decimal(borrow_mut(name), args.len());
    if success != 0 {
        name.push(95);
        decimal(borrow_mut(name), success);
    }
    mut d = find_decl_internal(borrow_mut(c), &module, &name);
    if d == 0 {
        first := c.fields.len();
        for i in args.len() {
            mut field = u8[];
            decimal(borrow_mut(field), i);
            param := intern_args(borrow_mut(c), 9, i, 0, u64[], u64[]);
            c.fields.push(Field { name: field, ty: param });
        }
        mut bounds = u64[];
        mut constraints = u64[][];
        for i in args.len() {
            bounds.push(0);
            constraints.push(u64[]);
        }
        c
            .decls
            .push(
                Decl {
                    module: module,
                    name: name,
                    is_enum: 1,
                    first: first,
                    count: args.len(),
                    regions: 0,
                    types: args.len(),
                    success: success,
                    bounds: bounds,
                    constraints: constraints,
                }
            );
        d = c.decls.len();
    }
    return intern_args(borrow_mut(c), 8, d - 1, 0, u64[], args);
}
fn union_type<a>(c: (&a mut C), left: u64, right: u64) -> u64 {
    mut args = u64[];
    append_ordinary(borrow_mut(c), left, borrow_mut(args));
    append_ordinary(borrow_mut(c), right, borrow_mut(args));
    return make_union(borrow_mut(c), args, 0, copy_bytes(&".union"), &"Union");
}
fn result_union_type<a>(c: (&a mut C), successes: u64[], failures: u64[]) -> u64 {
    mut args = u64[];
    for i in successes.len() {
        append_ordinary(borrow_mut(c), successes[i], borrow_mut(args));
    }
    success := args.len();
    for i in failures.len() {
        append_ordinary(borrow_mut(c), failures[i], borrow_mut(args));
    }
    return make_union(borrow_mut(c), args, success, copy_bytes(&".result"), &"Result");
}

fn parse_type<a>(c: (&a mut C)) -> u64 {
    mut t = 0;
    // Maps participate in postfix and union composition like other types.
    if is(borrow_mut(c), &"[") {
        advance(borrow_mut(c));
        k := parse_type(borrow_mut(c));
        expect(borrow_mut(c), &":");
        v := parse_type(borrow_mut(c));
        expect(borrow_mut(c), &"]");
        mut ma = u64[];
        ma.push(k);
        ma.push(v);
        t = named_type(borrow_mut(c), copy_bytes(&"hashmap"), copy_bytes(&"Map"), ma);
    } else {
        t = parse_type_base(borrow_mut(c));
    }
    while true {
        t = type_suffixes(borrow_mut(c), t);
        if eat(borrow_mut(c), &"?") == 0 {
            break;
        }
        mut oa = u64[];
        oa.push(t);
        t = named_type(borrow_mut(c), copy_bytes(&"core"), copy_bytes(&"OptionStorage"), oa);
    }
    if c.no_union == 0 {
        mut members = u64[];
        append_ordinary(borrow_mut(c), t, borrow_mut(members));
        while is(borrow_mut(c), &"|") {
            mut p = c.pos;
            if is_at(borrow_mut(c), p + 1, &"?") {
                advance(borrow_mut(c));
                advance(borrow_mut(c));
                mut failures = u64[];
                mut f = parse_union_member(borrow_mut(c));
                append_ordinary(borrow_mut(c), f, borrow_mut(failures));
                while is(borrow_mut(c), &"|") {
                    p = c.pos;
                    if is_at(borrow_mut(c), p + 1, &"?") {
                        fail(borrow_mut(c), &"result union |? is non-associative");
                    }
                    advance(borrow_mut(c));
                    f = parse_union_member(borrow_mut(c));
                    append_ordinary(borrow_mut(c), f, borrow_mut(failures));
                }
                return result_union_type(borrow_mut(c), members, failures);
            }
            advance(borrow_mut(c));
            m := parse_union_member(borrow_mut(c));
            append_ordinary(borrow_mut(c), m, borrow_mut(members));
        }
        if 1 < members.len() {
            return make_union(borrow_mut(c), members, 0, copy_bytes(&".union"), &"Union");
        }
    }
    return t;
}
fn parse_union_member<a>(c: (&a mut C)) -> u64 {
    old := exchange(borrow_mut(c.no_union), 1);
    t := parse_type(borrow_mut(c));
    exchange(borrow_mut(c.no_union), old);
    return t;
}
fn type_suffixes<a>(c: (&a mut C), base: u64) -> u64 {
    mut out = base;
    while is(borrow_mut(c), &"[") {
        advance(borrow_mut(c));
        expect(borrow_mut(c), &"]");
        out = vec_of(borrow_mut(c), out);
    }
    return out;
}
fn token_starts_type<a>(c: (&a mut C), p: u64) -> u64 {
    k := kind_at(borrow_mut(c), p);
    if k == 1 {
        return true;
    }
    return (k == 40) + (k == 91) + (k == 38);
}
fn type_keyword<a>(c: (&a mut C), n: &a [u8]) -> u64 {
    if same(&n, &"bool") + same(&n, &"char") + same(&n, &"string") + same(&n, &"u64") {
        return true;
    }
    if same(&n, &"u8") + same(&n, &"u16") + same(&n, &"u32") + same(&n, &"u64") {
        return true;
    }
    if same(&n, &"i8")
        + same(&n, &"i16")
        + same(&n, &"i32")
        + same(&n, &"i64")
        + same(&n, &"isize") {
        return true;
    }
    if same(&n, &"f32") + same(&n, &"f64") + same(&n, &"unit") + same(&n, &"read") {
        return true;
    }
    if same(&n, &"mut") + same(&n, &"Atomic") + same(&n, &"Mutex") + same(&n, &"Scope") {
        return true;
    }
    return same(&n, &"Task") + same(&n, &"CancelToken") + same(&n, &"fn") + same(&n, &"Fn");
}
fn lifetime_candidate<a>(c: (&a mut C), p: u64) -> u64 {
    if kind_at(borrow_mut(c), p) != 1 {
        return false;
    }
    n := tok_text(borrow_mut(c), p);
    if n.len() == 0 {
        return false;
    }
    if (n[0] < 97) + (122 < n[0]) {
        return false;
    }
    if type_keyword(borrow_mut(c), &n) {
        return false;
    }
    return token_starts_type(borrow_mut(c), p + 1) + is_at(borrow_mut(c), p + 1, &"mut");
}
fn is_at<a, b>(c: (&a mut C), p: u64, text: &b [u8]) -> u64 {
    if p < c.toks.len() {
        t := tok_text(borrow_mut(c), p);
        return same(&t, &text);
    }
    return false;
}
fn lifetime_region<a>(c: (&a mut C), name: &a [u8]) -> u64 {
    for i in c.rnames.len() {
        r := &c.rnames[i];
        if same(&r, &name) {
            return i + 1;
        }
    }
    if (name.len() != 0) & (96 < name[0]) & (name[0] < 123) {
        c.rnames.push(name.copy());
        return c.rnames.len();
    }
    fail(borrow_mut(c), &"undeclared lifetime");
    return 0;
}
fn fresh_lifetime<a>(c: (&a mut C)) -> u64 {
    mut name = u8[];
    name.push(35);
    decimal(borrow_mut(name), c.rnames.len());
    c.rnames.push(name);
    return c.rnames.len();
}
fn slice_ahead<a>(c: (&a mut C), p: u64) -> u64 {
    mut i = p + 1;
    mut depth = 0;
    while i < c.toks.len() {
        k := kind_at(borrow_mut(c), i);
        if k == 0 {
            return false;
        }
        if (k == 40) + (k == 91) + (k == 123) {
            depth += 1;
        }
        if (k == 41) + (k == 93) + (k == 125) {
            if depth == 0 {
                return k == 93;
            }
            depth -= 1;
        }
        if (depth == 0) & (k == 58) {
            return false;
        }
        i += 1;
    }
    return false;
}
fn parse_slice_reference<a>(c: (&a mut C), mode: u64, r: u64) -> u64 {
    expect(borrow_mut(c), &"[");
    elem := parse_type(borrow_mut(c));
    expect(borrow_mut(c), &"]");
    if elem != int_type(borrow_mut(c), 8, 0) {
        fail(borrow_mut(c), &"only [u8] slices are supported");
    }
    mut rs = u64[];
    rs.push(r);
    return intern_full(borrow_mut(c), 5, 0, mode, rs);
}
fn note_input_region<a>(c: (&a mut C), r: u64) -> unit {
    for i in c.input_regions.len() {
        if c.input_regions[i] == r {
            return ();
        }
    }
    c.input_regions.push(r);
    return ();
}
fn outer_region<a>(c: (&a mut C), ty: u64) -> u64 {
    rs := type_regions(borrow_mut(c), ty);
    if rs.len() == 0 {
        return 0;
    }
    return rs[0];
}
fn parse_reference<a>(c: (&a mut C)) -> u64 {
    mut mode = 0;
    mut r = 0;
    mut p = c.pos;
    if is(borrow_mut(c), &"mut") {
        advance(borrow_mut(c));
        mode = 1;
        p = c.pos;
        if lifetime_candidate(borrow_mut(c), p) {
            if c.default_u64 == 0 {
                fail(borrow_mut(c), &"write &a mut T, not &mut a T");
            }
            n := tok_text(borrow_mut(c), p);
            r = lifetime_region(borrow_mut(c), &n);
            advance(borrow_mut(c));
        }
    } else {
        if lifetime_candidate(borrow_mut(c), p) {
            n := tok_text(borrow_mut(c), p);
            r = lifetime_region(borrow_mut(c), &n);
            advance(borrow_mut(c));
            if eat(borrow_mut(c), &"mut") {
                mode = 1;
            }
        }
    }
    if r == 0 {
        if c.parsing_input {
            r = fresh_lifetime(borrow_mut(c));
        } else {
            if c.output_region == 0 {
                fail(borrow_mut(c), &"elided output reference needs one input lifetime");
            }
            r = c.output_region;
        }
    }
    if c.parsing_input {
        note_input_region(borrow_mut(c), r);
    }
    p = c.pos;
    if is(borrow_mut(c), &"[") & slice_ahead(borrow_mut(c), p) {
        return parse_slice_reference(borrow_mut(c), mode, r);
    }
    old := exchange(borrow_mut(c.no_union), 1);
    e := parse_type(borrow_mut(c));
    exchange(borrow_mut(c.no_union), old);
    mut rs = u64[];
    rs.push(r);
    return intern_full(borrow_mut(c), 7, e, mode, rs);
}
fn parse_type_base<a>(c: (&a mut C)) -> u64 {
    if eat(borrow_mut(c), &"&") {
        return parse_reference(borrow_mut(c));
    }
    if eat(borrow_mut(c), &"(") {
        if eat(borrow_mut(c), &")") {
            return 1;
        }
        old := exchange(borrow_mut(c.no_union), 0);
        t := parse_type(borrow_mut(c));
        exchange(borrow_mut(c.no_union), old);
        expect(borrow_mut(c), &")");
        return t;
    }
    first := ident(borrow_mut(c));
    return base_named(borrow_mut(c), first);
}
fn base_named<a>(c: (&a mut C), first: u8[]) -> u64 {
    if same(&first, &"usize") {
        fail(borrow_mut(c), &"usize was removed; use u64 for sizes and indices");
    }
    for i in c.tnames.len() {
        t := &c.tnames[i];
        if same(&t, &first) {
            if c.bindings.len() {
                return c.bindings[i];
            }
            bounds := c.type_bounds[i];
            mut proofs = u64[];
            set := copy_numbers(&c.type_interfaces[i]);
            for j in set.len() {
                id := set[j];
                proof := intern(borrow_mut(c), 15, id);
                proofs.push(proof);
            }
            return intern_args(borrow_mut(c), 9, i, bounds, u64[], proofs);
        }
    }
    if same(&first, &"Self") & ((c.self_type != 0)) {
        st := c.self_type - 1;
        if c.bindings.len() {
            b := copy_numbers(borrow(c.bindings));
            return bind_types(borrow_mut(c), st, borrow(b));
        }
        return st;
    }
    if eat(borrow_mut(c), &"::") {
        n := ident(borrow_mut(c));
        a := find_alias(borrow_mut(c), &first, &n);
        if a != 0 {
            aty := c.aliases[a - 1].ty;
            if aty == 0 {
                fail(borrow_mut(c), &"recursive or unresolved type alias");
            }
            return aty;
        }
        d := find_decl(borrow_mut(c), &first, &n);
        if d == 0 {
            fail(borrow_mut(c), &"unknown type");
        }
        return nominal_type(borrow_mut(c), d - 1);
    }
    if same(&first, &"Fn") {
        expect(borrow_mut(c), &"(");
        mut params = u64[];
        if eat(borrow_mut(c), &")") == 0 {
            while true {
                ty := parse_type(borrow_mut(c));
                params.push(ty);
                if eat(borrow_mut(c), &")") {
                    break;
                }
                expect(borrow_mut(c), &",");
            }
        }
        if 5 < params.len() {
            fail(borrow_mut(c), &"closure type exceeds five parameters");
        }
        expect(borrow_mut(c), &"->");
        result := parse_type(borrow_mut(c));
        return intern_args(borrow_mut(c), 20, result, 0, u64[], params);
    }
    if same(&first, &"fn") {
        expect(borrow_mut(c), &"(");
        mut params = u64[];
        if eat(borrow_mut(c), &")") == 0 {
            while true {
                ty := parse_type(borrow_mut(c));
                params.push(ty);
                if eat(borrow_mut(c), &")") {
                    break;
                }
                expect(borrow_mut(c), &",");
            }
        }
        if 6 < params.len() {
            fail(borrow_mut(c), &"function type exceeds six word arguments");
        }
        expect(borrow_mut(c), &"->");
        result := parse_type(borrow_mut(c));
        return intern_args(borrow_mut(c), 12, result, 0, u64[], params);
    }
    named := int_name(&first);
    if named != 0 {
        return int_type_named(borrow_mut(c), named);
    }
    if same(&first, &"bool") {
        return bool_type(borrow_mut(c));
    }
    if same(&first, &"f64") {
        return float_type(borrow_mut(c));
    }
    if same(&first, &"f32") {
        return f32_type(borrow_mut(c));
    }
    if same(&first, &"char") {
        return char_type(borrow_mut(c));
    }
    if same(&first, &"u64") {
        return 0;
    }
    if same(&first, &"unit") {
        return 1;
    }
    if same(&first, &"string") {
        return 3;
    }
    if same(&first, &"read") + same(&first, &"mut") {
        if c.default_u64 == 0 {
            fail(borrow_mut(c), &"read<a>/mut<a> were removed; write &[u8] or &mut [u8]");
        }
        mut rs = lifetime_arguments(borrow_mut(c));
        if rs.len() != 1 {
            fail(borrow_mut(c), &"view lifetime arity");
        }
        mode := same(&first, &"mut");
        return intern_full(borrow_mut(c), 5, 0, mode, rs);
    }
    if same(&first, &"Atomic") {
        expect(borrow_mut(c), &"<");
        e := parse_type(borrow_mut(c));
        expect(borrow_mut(c), &">");
        if e != 0 {
            fail(borrow_mut(c), &"Atomic currently requires u64 (one aligned 64-bit word)");
        }
        return intern(borrow_mut(c), 11, 0);
    }
    if same(&first, &"Scope") {
        expect(borrow_mut(c), &"<");
        e := parse_type(borrow_mut(c));
        expect(borrow_mut(c), &">");
        return intern(borrow_mut(c), 14, e);
    }
    if same(&first, &"Task") {
        expect(borrow_mut(c), &"<");
        e := parse_type(borrow_mut(c));
        expect(borrow_mut(c), &">");
        return intern(borrow_mut(c), 16, e);
    }
    if same(&first, &"CancelToken") {
        return intern(borrow_mut(c), 17, 0);
    }
    if same(&first, &"Mutex") {
        expect(borrow_mut(c), &"<");
        e := parse_type(borrow_mut(c));
        expect(borrow_mut(c), &">");
        return mutex_type(borrow_mut(c), e);
    }

    mut m = module_copy(borrow_mut(c));
    a := find_alias(borrow_mut(c), &m, &first);
    if a != 0 {
        aty := c.aliases[a - 1].ty;
        if aty == 18446744073709551615 {
            fail(borrow_mut(c), &"recursive or unresolved type alias");
        }
        return aty;
    }
    imported := resolve_import(borrow_mut(c), &first);
    if imported.len() != 0 {
        m = imported;
    }
    d := find_decl(borrow_mut(c), &m, &first);
    if d == 0 {
        fail(borrow_mut(c), &"unknown type");
    }
    return nominal_type(borrow_mut(c), d - 1);
}
// ---- top level: pass 1 names, pass 2 fields/signatures/prototypes, pass 3 bodies ----
fn mangle<a, b, d>(c: (&a mut C), m: &b [u8], n: &d [u8]) -> unit {
    if same(&m, &"runtime") {
        o(borrow_mut(c), n);
        return ();
    }
    o(borrow_mut(c), &"f_");
    o(borrow_mut(c), m);
    c.out.push(95);
    o(borrow_mut(c), n);
    return ();
}
fn alias_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(borrow_mut(c), &"type");
    name := ident(borrow_mut(c));
    module := module_copy(borrow_mut(c));
    expect(borrow_mut(c), &"=");
    if pass == 1 {
        while is(borrow_mut(c), &";") == 0 {
            advance(borrow_mut(c));
        }
        expect(borrow_mut(c), &";");
        if find_alias(borrow_mut(c), &module, &name) != 0 {
            fail(borrow_mut(c), &"duplicate type alias");
        }
        c.aliases.push(Alias { module: module, name: name, ty: 18446744073709551615 });
        return ();
    }
    if pass == 3 {
        while is(borrow_mut(c), &";") == 0 {
            advance(borrow_mut(c));
        }
        expect(borrow_mut(c), &";");
        return ();
    }
    ty := parse_type(borrow_mut(c));
    expect(borrow_mut(c), &";");
    a := find_alias(borrow_mut(c), &module, &name);
    if a == 0 {
        fail(borrow_mut(c), &"unknown type alias");
    }
    entry := &mut c.aliases[a - 1];
    exchange(borrow_mut(entry.ty), ty);
    return ();
}
fn decl<a>(c: (&a mut C), pass: u64) -> unit {
    is_enum := is(borrow_mut(c), &"enum");
    advance(borrow_mut(c));
    name := ident(borrow_mut(c));
    lifetime_parameters(borrow_mut(c));
    exchange(borrow_mut(c.parsing_input), 0);
    exchange(borrow_mut(c.output_region), 0);
    regions := c.rnames.len();
    types := c.tnames.len();
    bounds := copy_numbers(borrow(c.type_bounds));
    constraints := copy_constraints(borrow(c.type_interfaces));
    if pass != 2 {
        if pass == 1 {
            m := module_copy(borrow_mut(c));
            c
                .decls
                .push(
                    Decl {
                        module: m,
                        name: name,
                        is_enum: is_enum,
                        first: 0,
                        count: 0,
                        regions: regions,
                        types: types,
                        success: 0,
                        bounds: bounds,
                        constraints: constraints,
                    }
                );
        }
        skip_braces(borrow_mut(c));
        eat(borrow_mut(c), &";");
        return ();
    }
    m := module_copy(borrow_mut(c));
    d := find_decl(borrow_mut(c), &m, &name);
    mut pending = Field[];
    mut count = 0;
    expect(borrow_mut(c), &"{");
    if eat(borrow_mut(c), &"}") == 0 {
        while 1 {
            f := ident(borrow_mut(c));
            mut ty = 1;
            if is_enum {
                if eat(borrow_mut(c), &"(") {
                    ty = parse_type(borrow_mut(c));
                    expect(borrow_mut(c), &")");
                }
            } else {
                expect(borrow_mut(c), &":");
                ty = parse_type(borrow_mut(c));
            }
            pending.push(Field { name: f, ty: ty });
            count = count + 1;
            if eat(borrow_mut(c), &"}") {
                break;
            }
            expect(borrow_mut(c), &",");
            if eat(borrow_mut(c), &"}") {
                break;
            }
        }
    }
    eat(borrow_mut(c), &";");
    mut reverse = Field[];
    while pending.len() {
        reverse.push(pending.pop());
    }
    first := c.fields.len();
    while reverse.len() {
        c.fields.push(reverse.pop());
    }
    exchange(
        &mut c.decls[d - 1],
        Decl {
            module: m,
            name: name,
            is_enum: is_enum,
            first: first,
            count: count,
            regions: c.rnames.len(),
            types: types,
            success: 0,
            bounds: bounds,
            constraints: constraints,
        }
    );
    return ();
}
fn bind<a>(c: (&a mut C), name: u8[], ty: u64, id: u64, mutable: u64) -> unit {
    if c.raw == 0 {
        if place_of(borrow_mut(c), id) == 0 {
            kind := ty_kind(borrow_mut(c), ty);
            if (kind == 1)
                + (kind == 2)
                + (kind == 12)
                + (kind == 17)
                + (kind == 18)
                + (kind == 19)
                + (kind == 21)
                + (kind == 22) {
                place := ownership::root(borrow_mut(c.check), 1, 1);
                c
                    .resources
                    .push(
                        Resource {
                            slot: id,
                            ty: ty,
                            flag: 0,
                            base: 0,
                            field: 0,
                            via: 0,
                            place: place,
                            target: 0,
                            authority: 0,
                        }
                    );
            }
        }
    }
    from := c.pos;
    to := c.scope_end;
    last := last_name(borrow_mut(c), &name, from, to);
    c
        .locals
        .push(
            Local {
                name: name,
                ty: ty,
                id: id,
                last: last,
                born: from,
                mutable: mutable,
                flex: 0,
                lit: 0,
                neg: 0,
                origin: 0,
                at: 0,
            }
        );
    return ();
}
fn func<a>(c: (&a mut C), pass: u64, public: u64) -> unit {
    position := c.pos;
    out_mark := c.out.len();
    closure_mark := c.closures.len();
    expect(borrow_mut(c), &"fn");
    mut name = ident(borrow_mut(c));
    lifetime_parameters(borrow_mut(c));
    exchange(borrow_mut(c.input_regions), u64[]);
    exchange(borrow_mut(c.receiver_region), 0);
    exchange(borrow_mut(c.output_region), 0);
    exchange(borrow_mut(c.parsing_input), 1);
    if c.inherent {
        prepend_impl_params(borrow_mut(c));
    }
    if same(&name, &"print") + same(&name, &"println") {
        fail(borrow_mut(c), &"print and println are reserved prelude names");
    }
    typecount := c.tnames.len();
    regioncount := c.rnames.len();
    if (pass == 3) & (typecount != 0) {
        while kind(borrow_mut(c)) != 123 {
            advance(borrow_mut(c));
        }
        skip_braces(borrow_mut(c));
        return ();
    }
    if pass == 1 {
        while kind(borrow_mut(c)) != 123 {
            advance(borrow_mut(c));
        }
        skip_braces(borrow_mut(c));
        return ();
    }
    mut m = module_copy(borrow_mut(c));
    if c.current_impl {
        m = private_module(&".impl_", c.current_impl);
    }
    if c.inherent {
        m = private_module(&".inherent_", c.inherent - 1);
    }
    exchange(borrow_mut(c.locals), Local[]);
    exchange(borrow_mut(c.resources), Resource[]);
    exchange(borrow_mut(c.next), 0);
    exchange(borrow_mut(c.scope_end), 0);
    exchange(borrow_mut(c.loop_start), 0);
    exchange(borrow_mut(c.loop_end), 0);
    exchange(borrow_mut(c.check), ownership::new());
    exchange(borrow_mut(c.members), Member[]);
    exchange(borrow_mut(c.terminated), 0);
    exchange(borrow_mut(c.bonds), Bond[]);
    exchange(borrow_mut(c.origins), Origin[]);
    first := c.params.len();
    mut count = 0;
    expect(borrow_mut(c), &"(");
    if eat(borrow_mut(c), &")") == 0 {
        while 1 {
            p := ident(borrow_mut(c));
            expect(borrow_mut(c), &":");
            ty := parse_type(borrow_mut(c));
            if same(&p, &"self") & (ty_kind(borrow_mut(c), ty) == 7) {
                rr := outer_region(borrow_mut(c), ty);
                exchange(borrow_mut(c.receiver_region), rr);
            }
            if pass == 2 {
                c.params.push(ty);
            }
            id := fresh(borrow_mut(c));
            bind(borrow_mut(c), p, ty, id, 0);
            count = count + 1;
            if eat(borrow_mut(c), &")") {
                break;
            }
            expect(borrow_mut(c), &",");
        }
    }
    if 6 < count {
        fail(borrow_mut(c), &"native function exceeds six parameters");
    }
    exchange(borrow_mut(c.parsing_input), 0);
    if c.receiver_region != 0 {
        exchange(borrow_mut(c.output_region), c.receiver_region);
    } else {
        if c.input_regions.len() == 1 {
            exchange(borrow_mut(c.output_region), c.input_regions[0]);
        }
    }
    mut ret = 1;
    if eat(borrow_mut(c), &"->") {
        ret = parse_type(borrow_mut(c));
    }
    exchange(borrow_mut(c.output_region), 0);
    exchange(borrow_mut(c.result), ret);
    if pass == 2 {
        if find_func(borrow_mut(c), &m, &name) != 0 {
            fail(borrow_mut(c), &"duplicate function");
        }
        main := (c.file == 2) & (c.current_impl == 0) & (c.inherent == 0) & same(&name, &"main");
        if main {
            if (1 < count) + (typecount != 0) {
                fail(
                    borrow_mut(c),
                    &"main needs zero arguments or one readonly byte view and no type parameters"
                );
            }
        }
        entry := main
            + (
                (c.current_impl == 0)
                    & (c.inherent == 0)
                    & (c.entry == 0)
                    & (c.file == 2)
                    & public
                    & (count < 2)
                    & (typecount == 0)
            );
        file := c.file;
        raw := c.raw;
        bounds := copy_numbers(borrow(c.type_bounds));
        constraints := copy_constraints(borrow(c.type_interfaces));
        c
            .funcs
            .push(
                Func {
                    module: m,
                    name: name,
                    first: first,
                    count: count,
                    ret: ret,
                    types: typecount,
                    regions: c.rnames.len(),
                    file: file,
                    pos: position,
                    raw: raw,
                    bounds: bounds,
                    constraints: constraints,
                    contract: 0,
                    owner: c.inherent,
                }
            );
        index := c.funcs.len();
        if entry {
            exchange(borrow_mut(c.entry), index);
        }
        skip_braces(borrow_mut(c));
        return ();
    }
    if c.current_spec {
        spec := c.current_spec;
        name = special_name(borrow_mut(c), spec - 1);
    }
    start := c.pos;
    end := block_end(borrow_mut(c), start);
    exchange(borrow_mut(c.scope_end), end);
    for i in c.locals.len() {
        mut l = &c.locals[i];
        name := l.name.copy();
        last := last_name(borrow_mut(c), &name, start, end);
        mut l = &mut c.locals[i];
        exchange(borrow_mut(l.last), last);
    }
    o(borrow_mut(c), &".type ");
    mangle(borrow_mut(c), &m, &name);
    o(borrow_mut(c), &",@function\n");
    mangle(borrow_mut(c), &m, &name);
    o(borrow_mut(c), &":\npushq %rbp\nmovq %rsp,%rbp\nsubq $.F");
    frame := label(borrow_mut(c));
    on(borrow_mut(c), frame);
    o(borrow_mut(c), &",%rsp\n");
    for i in count {
        reg := argreg(i);
        o(borrow_mut(c), &"movq ");
        o(borrow_mut(c), &reg);
        c.out.push(44);
        stack_slot(borrow_mut(c), i);
        c.out.push(10);
    }
    o(borrow_mut(c), &"leaq -.F");
    on(borrow_mut(c), frame);
    o(borrow_mut(c), &"(%rbp),%rdi\nmovq $.F");
    on(borrow_mut(c), frame);
    o(borrow_mut(c), &"/8-");
    on(borrow_mut(c), count);
    o(borrow_mut(c), &",%rcx\nxorl %eax,%eax\nrep stosq\n");
    for i in count {
        mut l = &c.locals[i];
        slot := l.id;
        ty := l.ty;
        own(borrow_mut(c), slot, ty);
        init_parameter(borrow_mut(c), slot, ty);
    }
    block(borrow_mut(c));
    if c.raw == 0 {
        if (c.terminated == 0) & (ret != 1) {
            fail(borrow_mut(c), &"function may fall through without return");
        }
    }
    cleanup(borrow_mut(c), 0);
    o(borrow_mut(c), &"xorq %rax,%rax\nleave\nret\n.set .F");
    on(borrow_mut(c), frame);
    c.out.push(44);
    n := c.next;
    on(borrow_mut(c), div(n + 1, 2) * 16);
    c.out.push(10);
    // A literal binding learned its type from a later use: discard this attempt and recompile.
    if c.retry {
        while out_mark < c.out.len() {
            c.out.pop();
        }
        while closure_mark < c.closures.len() {
            c.closures.pop();
        }
        exchange(borrow_mut(c.retry), 0);
        exchange(borrow_mut(c.tolerant), 0);
        a := c.attempts + 1;
        exchange(borrow_mut(c.attempts), a);
        exchange(borrow_mut(c.pos), position);
        func(borrow_mut(c), pass, public);
        exchange(borrow_mut(c.attempts), 0);
        return ();
    }
    exchange(borrow_mut(c.hints), u64[]);
    return ();
}
fn interface_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    if c.raw {
        fail(borrow_mut(c), &"unsafe runtime cannot publish safe interfaces");
    }
    expect(borrow_mut(c), &"interface");
    name := ident(borrow_mut(c));
    if same(&name, &"Send") + same(&name, &"Share") {
        fail(borrow_mut(c), &"structural capability names are reserved");
    }
    module := module_copy(borrow_mut(c));
    id := ensure_interface(borrow_mut(c), module, name);
    if pass == 1 {
        item := &c.interfaces[id - 1];
        defined := item.defined;
        if defined {
            fail(borrow_mut(c), &"duplicate interface");
        }
        item := &mut c.interfaces[id - 1];
        exchange(borrow_mut(item.defined), 1);
        if is(borrow_mut(c), &"{") == 0 {
            fail(borrow_mut(c), &"expected interface body");
        }
        skip_braces(borrow_mut(c));
        return ();
    }
    if pass == 3 {
        skip_braces(borrow_mut(c));
        return ();
    }
    expect(borrow_mut(c), &"{");
    proof := intern(borrow_mut(c), 15, id);
    mut proofs = u64[];
    proofs.push(proof);
    self := intern_args(borrow_mut(c), 9, 0, 0, u64[], proofs);
    exchange(borrow_mut(c.self_type), self + 1);
    while eat(borrow_mut(c), &"}") == 0 {
        expect(borrow_mut(c), &"fn");
        name := ident(borrow_mut(c));
        lifetime_parameters(borrow_mut(c));
        if c.tnames.len() {
            fail(borrow_mut(c), &"interface method type parameters are not implemented yet");
        }
        module := private_module(&".interface_", id);
        if find_func(borrow_mut(c), &module, &name) {
            fail(borrow_mut(c), &"duplicate interface method");
        }
        first := c.params.len();
        expect(borrow_mut(c), &"(");
        mut count = 0;
        if eat(borrow_mut(c), &")") == 0 {
            while true {
                ident(borrow_mut(c));
                expect(borrow_mut(c), &":");
                ty := parse_type(borrow_mut(c));
                c.params.push(ty);
                count += 1;
                if eat(borrow_mut(c), &")") {
                    break;
                }
                expect(borrow_mut(c), &",");
            }
        }
        if 6 < count {
            fail(borrow_mut(c), &"interface method exceeds six arguments");
        }
        mut ret = 1;
        if eat(borrow_mut(c), &"->") {
            ret = parse_type(borrow_mut(c));
        }
        expect(borrow_mut(c), &";");
        mut bounds = u64[0];
        mut requirements = u64[][];
        requirements.push(u64[id]);
        regions := c.rnames.len();
        c
            .funcs
            .push(
                Func {
                    module: module,
                    name: name,
                    first: first,
                    count: count,
                    ret: ret,
                    types: 1,
                    regions: regions,
                    file: 0,
                    pos: 0,
                    raw: 0,
                    bounds: bounds,
                    constraints: requirements,
                    contract: id,
                    owner: 0,
                }
            );
        index := c.funcs.len() - 1;
        item := &mut c.interfaces[id - 1];
        item.methods.push(index);
    }
    exchange(borrow_mut(c.self_type), 0);
    return ();
}
fn impl_has_for<a>(c: (&a mut C)) -> u64 {
    mut i = c.pos;
    while (kind_at(borrow_mut(c), i) != 123) & (kind_at(borrow_mut(c), i) != 0) {
        t := tok_text(borrow_mut(c), i);
        if same(&t, &"for") {
            return true;
        }
        i += 1;
    }
    return false;
}
fn impl_record<a>(c: (&a mut C), owner: u64) -> u64 {
    for i in c.impl_params.len() {
        p := &c.impl_params[i];
        if p.decl == owner {
            return i + 1;
        }
    }
    return 0;
}
fn impl_self<a>(c: (&a mut C), owner: u64) -> u64 {
    r := impl_record(borrow_mut(c), owner);
    if r != 0 {
        p := &c.impl_params[r - 1];
        return p.self_ty;
    }
    return intern_args(borrow_mut(c), 8, owner - 1, 0, u64[], u64[]);
}
fn prepend_impl_params<a>(c: (&a mut C)) -> unit {
    owner := c.inherent;
    r := impl_record(borrow_mut(c), owner);
    if r == 0 {
        return ();
    }
    p := &c.impl_params[r - 1];
    mut rn = copy_names(borrow(p.rnames));
    mut tn = copy_names(borrow(p.tnames));
    mut bd = copy_numbers(borrow(p.bounds));
    mut it = copy_constraints(borrow(p.interfaces));
    own_r := copy_names(borrow(c.rnames));
    for i in own_r.len() {
        x := &own_r[i];
        rn.push(x.copy());
    }
    own_t := copy_names(borrow(c.tnames));
    for i in own_t.len() {
        x := &own_t[i];
        tn.push(x.copy());
    }
    own_b := copy_numbers(borrow(c.type_bounds));
    for i in own_b.len() {
        bd.push(own_b[i]);
    }
    own_i := copy_constraints(borrow(c.type_interfaces));
    for i in own_i.len() {
        it.push(copy_numbers(&own_i[i]));
    }
    exchange(borrow_mut(c.rnames), rn);
    exchange(borrow_mut(c.tnames), tn);
    exchange(borrow_mut(c.type_bounds), bd);
    exchange(borrow_mut(c.type_interfaces), it);
    return ();
}
fn implementation<a>(c: (&a mut C), pass: u64) -> unit {
    if c.raw {
        fail(borrow_mut(c), &"unsafe runtime cannot implement safe interfaces");
    }
    expect(borrow_mut(c), &"impl");
    // `impl Type { fn ... }`: methods and associated functions of a nominal type in this module.
    if ((kind(borrow_mut(c)) == 1) & (next_kind(borrow_mut(c)) == 123))
        + is(borrow_mut(c), &"<")
        + (
            (kind(borrow_mut(c)) == 1)
                & (next_kind(borrow_mut(c)) == 60)
                & (impl_has_for(borrow_mut(c)) == 0)
        ) {
        if pass == 1 {
            while is(borrow_mut(c), &"{") == 0 {
                advance(borrow_mut(c));
            }
            skip_braces(borrow_mut(c));
            return ();
        }
        // impl<T> Stack<T> { ... }: the impl's parameters are prepended to every method's.
        exchange(borrow_mut(c.rnames), u8[][]);
        exchange(borrow_mut(c.tnames), u8[][]);
        exchange(borrow_mut(c.type_bounds), u64[]);
        exchange(borrow_mut(c.type_interfaces), u64[][]);
        if is(borrow_mut(c), &"<") {
            lifetime_parameters(borrow_mut(c));
        }
        module := module_copy(borrow_mut(c));
        here := c.pos;
        name := tok_text(borrow_mut(c), here);
        d := find_decl(borrow_mut(c), &module, &name);
        if d == 0 {
            fail(borrow_mut(c), &"impl needs a struct or enum declared in this module");
        }
        ty := parse_type(borrow_mut(c));
        if (ty_kind(borrow_mut(c), ty) != 8) + (ty_arg(borrow_mut(c), ty) != d - 1) {
            fail(borrow_mut(c), &"impl needs a struct or enum declared in this module");
        }
        args := type_args(borrow_mut(c), ty);
        if args.len() != c.tnames.len() {
            fail(borrow_mut(c), &"impl type arguments must be its own parameters, in order");
        }
        for i in args.len() {
            a := args[i];
            if (ty_kind(borrow_mut(c), a) != 9) + (ty_arg(borrow_mut(c), a) != i) {
                fail(borrow_mut(c), &"impl type arguments must be its own parameters, in order");
            }
        }
        if pass == 2 {
            c
                .impl_params
                .push(
                    ImplParams {
                        decl: d,
                        rnames: copy_names(borrow(c.rnames)),
                        tnames: copy_names(borrow(c.tnames)),
                        bounds: copy_numbers(borrow(c.type_bounds)),
                        interfaces: copy_constraints(borrow(c.type_interfaces)),
                        self_ty: ty,
                    }
                );
        }
        exchange(borrow_mut(c.inherent), d);
        exchange(borrow_mut(c.self_type), ty + 1);
        expect(borrow_mut(c), &"{");
        while eat(borrow_mut(c), &"}") == 0 {
            public := eat(borrow_mut(c), &"pub");
            func(borrow_mut(c), pass, public);
        }
        exchange(borrow_mut(c.inherent), 0);
        exchange(borrow_mut(c.self_type), 0);
        return ();
    }
    if pass == 1 {
        while is(borrow_mut(c), &"{") == 0 {
            if kind(borrow_mut(c)) == 0 {
                fail(borrow_mut(c), &"unclosed implementation");
            }
            advance(borrow_mut(c));
        }
        skip_braces(borrow_mut(c));
        return ();
    }
    exchange(borrow_mut(c.rnames), u8[][]);
    exchange(borrow_mut(c.tnames), u8[][]);
    exchange(borrow_mut(c.type_bounds), u64[]);
    exchange(borrow_mut(c.type_interfaces), u64[][]);
    mut module = module_copy(borrow_mut(c));
    mut name = ident(borrow_mut(c));
    mut qualified = 0;
    if eat(borrow_mut(c), &"::") {
        qualified = 1;
        module = name;
        name = ident(borrow_mut(c));
    }
    if qualified == 0 {
        imported := resolve_import(borrow_mut(c), &name);
        if imported.len() != 0 {
            module = imported;
        }
    }
    contract := find_interface(borrow(c), &module, &name);
    if contract == 0 {
        fail(borrow_mut(c), &"unknown implemented interface");
    }
    expect(borrow_mut(c), &"for");
    ty := parse_type(borrow_mut(c));
    mut id = find_implementation(borrow_mut(c), contract, ty);
    if pass == 2 {
        if id {
            fail(borrow_mut(c), &"overlapping interface implementation");
        }
        owner := module_copy(borrow_mut(c));
        item := &c.interfaces[contract - 1];
        mut permitted = same(&item.module, &owner);
        if ty_kind(borrow_mut(c), ty) == 8 {
            decl := ty_arg(borrow_mut(c), ty);
            d := &c.decls[decl];
            if same(&d.module, &owner) {
                permitted = 1;
            }
        }
        if permitted == 0 {
            fail(borrow_mut(c), &"implementation must own the interface or nominal type");
        }
        c
            .implementations
            .push(Implementation { contract: contract, ty: ty, module: owner, methods: u64[] });
        id = c.implementations.len();
    }
    if id == 0 {
        fail(borrow_mut(c), &"implementation header missing");
    }
    exchange(borrow_mut(c.current_impl), id);
    exchange(borrow_mut(c.self_type), ty + 1);
    expect(borrow_mut(c), &"{");
    while eat(borrow_mut(c), &"}") == 0 {
        before := c.funcs.len();
        func(borrow_mut(c), pass, 0);
        if c.tnames.len() {
            fail(borrow_mut(c), &"generic implementation methods are not implemented yet");
        }
        if pass == 2 {
            item := &mut c.implementations[id - 1];
            item.methods.push(before);
        }
    }
    exchange(borrow_mut(c.current_impl), 0);
    exchange(borrow_mut(c.self_type), 0);
    return ();
}
fn bound_signature<a, b>(c: (&a mut C), index: u64, arguments: (&b u64[])) -> u64 {
    f := &c.funcs[index];
    first := f.first;
    count := f.count;
    ret := f.ret;
    mut params = u64[];
    for i in count {
        ty := c.params[first + i];
        bound := bind_types(borrow_mut(c), ty, borrow(arguments));
        params.push(bound);
    }
    result := bind_types(borrow_mut(c), ret, borrow(arguments));
    return intern_args(borrow_mut(c), 12, result, 0, u64[], params);
}
fn resolve_interface_method<a, b>(c: (&a mut C), contract: u64, ty: u64, name: &b [u8]) -> u64 {
    implementation := find_implementation(borrow_mut(c), contract, ty);
    if implementation == 0 {
        fail(borrow_mut(c), &"missing interface implementation");
    }
    item := &c.implementations[implementation - 1];
    methods := copy_numbers(borrow(item.methods));
    for i in methods.len() {
        index := methods[i];
        f := &c.funcs[index];
        if same(&f.name, &name) {
            return index;
        }
    }
    fail(borrow_mut(c), &"missing interface method");
    return 0;
}
fn check_interfaces<a>(c: (&a mut C)) -> unit {
    for i in c.interfaces.len() {
        item := &c.interfaces[i];
        defined := item.defined;
        module := item.module.copy();
        name := item.name.copy();
        if defined == 0 {
            fail(borrow_mut(c), &"unknown interface in generic bound");
        }
        if find_decl(borrow_mut(c), &module, &name) {
            fail(borrow_mut(c), &"interface and nominal type names conflict");
        }
    }
    for i in c.implementations.len() {
        item := &c.implementations[i];
        contract := item.contract;
        ty := item.ty;
        methods := copy_numbers(borrow(item.methods));
        interface := &c.interfaces[contract - 1];
        expected := copy_numbers(borrow(interface.methods));
        if methods.len() != expected.len() {
            fail(borrow_mut(c), &"interface implementation method count");
        }
        for j in expected.len() {
            abstract := expected[j];
            f := &c.funcs[abstract];
            name := f.name.copy();
            actual := resolve_interface_method(borrow_mut(c), contract, ty, &name);
            mut arguments = u64[ty];
            signature := bound_signature(borrow_mut(c), abstract, borrow(arguments));
            mut empty = u64[];
            concrete := bound_signature(borrow_mut(c), actual, borrow(empty));
            require_type(borrow_mut(c), concrete, signature);
        }
    }
    return ();
}
fn interface_call<a, b>(c: (&a mut C), contract: u64, name: &b [u8]) -> Val {
    module := private_module(&".interface_", contract);
    return call(borrow_mut(c), &module, &name);
}
// const NAME: T = literal; (integers, bool, text). Uses inline the value.
fn constant_declaration<a>(c: (&a mut C), pass: u64) -> unit {
    expect(borrow_mut(c), &"const");
    name := ident(borrow_mut(c));
    expect(borrow_mut(c), &":");
    if pass != 2 {
        while is(borrow_mut(c), &";") == 0 {
            advance(borrow_mut(c));
        }
        advance(borrow_mut(c));
        return ();
    }
    ty := parse_type(borrow_mut(c));
    expect(borrow_mut(c), &"=");
    module := module_copy(borrow_mut(c));
    for i in c.constants.len() {
        k := &c.constants[i];
        if same(&k.module, &module) & same(&k.name, &name) {
            fail(borrow_mut(c), &"duplicate constant");
        }
    }
    negative := eat(borrow_mut(c), &"-");
    here := c.pos;
    k := kind(borrow_mut(c));
    mut value = 0;
    mut text = u8[];
    if negative & (k == 5) {
        if is_float(borrow_mut(c), ty) == 0 {
            fail(borrow_mut(c), &"float constant needs type f64 or f32");
        }
        t := tok_text(borrow_mut(c), here);
        fp := float_precision(borrow_mut(c), ty);
        bits := float_bits_p(borrow_mut(c), &t, fp);
        advance(borrow_mut(c));
        expect(borrow_mut(c), &";");
        c
            .constants
            .push(
                Constant {
                    module: module,
                    name: name,
                    ty: ty,
                    value: bits ^ 9223372036854775808,
                    text: text,
                }
            );
        return ();
    }
    if k == 2 {
        t := tok_text(borrow_mut(c), here);
        value = literal_value(borrow_mut(c), &t);
        advance(borrow_mut(c));
        if (ty != 0) & (ty_kind(borrow_mut(c), ty) != 18) {
            fail(borrow_mut(c), &"integer constant needs an integer type");
        }
        if literal_fits(borrow_mut(c), ty, value, negative) == 0 {
            fail(borrow_mut(c), &"integer literal out of range for its type");
        }
        if negative {
            value = wrapping_sub(0, value);
        }
    } else {
        if negative {
            fail(borrow_mut(c), &"only integer constants can be negative");
        }
        if k == 5 {
            if is_float(borrow_mut(c), ty) == 0 {
                fail(borrow_mut(c), &"float constant needs type f64 or f32");
            }
            t := tok_text(borrow_mut(c), here);
            fp := float_precision(borrow_mut(c), ty);
            value = float_bits_p(borrow_mut(c), &t, fp);
            advance(borrow_mut(c));
        } else {
            if k == 3 {
                if ty != 3 {
                    fail(borrow_mut(c), &"text constant needs type string");
                }
                text = decode_literal(borrow_mut(c), here);
                advance(borrow_mut(c));
            } else {
                if is(borrow_mut(c), &"true") + is(borrow_mut(c), &"false") {
                    if is_bool(borrow_mut(c), ty) == 0 {
                        fail(borrow_mut(c), &"bool constant needs type bool");
                    }
                    value = is(borrow_mut(c), &"true");
                    advance(borrow_mut(c));
                } else {
                    fail(borrow_mut(c), &"constants must be integer, float, bool or text literals");
                }
            }
        }
    }
    expect(borrow_mut(c), &";");
    c.constants.push(Constant { module: module, name: name, ty: ty, value: value, text: text });
    return ();
}
fn constant_value<a, b, d>(c: (&a mut C), module: &b [u8], name: &d [u8]) -> Val {
    for i in c.constants.len() {
        k := &c.constants[i];
        if same(&k.module, &module) & same(&k.name, &name) {
            ty := k.ty;
            value := k.value;
            text := k.text.copy();
            if ty == 3 {
                l := label(borrow_mut(c));
                o(borrow_mut(c), &".pushsection .rodata\n");
                mark(borrow_mut(c), l);
                for j in text.len() {
                    o(borrow_mut(c), &".byte ");
                    on(borrow_mut(c), text[j]);
                    c.out.push(10);
                }
                o(borrow_mut(c), &".byte 0\n.popsection\nleaq ");
                lname(borrow_mut(c), l);
                o(borrow_mut(c), &"(%rip),%rax\n");
                ptr := save(borrow_mut(c));
                n := imm(borrow_mut(c), text.len());
                t := invoke(borrow_mut(c), &"rt_string_lit", two(ptr, n));
                return own(borrow_mut(c), t, 3);
            }
            return val(imm(borrow_mut(c), value), ty);
        }
    }
    return val(0, 18446744073709551615);
}
fn stdlib_module<a, b>(m: &b [u8]) -> u64 {
    if same(&m, &"core") + same(&m, &"vecs") + same(&m, &"strings") + same(&m, &"collections") {
        return true;
    }
    if same(&m, &"hash") + same(&m, &"hashmap") + same(&m, &"concurrent_map") {
        return true;
    }
    if same(&m, &"fs") + same(&m, &"io") + same(&m, &"order") + same(&m, &"env") {
        return true;
    }
    if same(&m, &"math") + same(&m, &"process") {
        return true;
    }
    return same(&m, &"runtime");
}
fn toplevel<a>(c: (&a mut C), pass: u64) -> unit {
    raw := eat(borrow_mut(c), &"unsafe");
    exchange(borrow_mut(c.raw), raw);
    mut m = "main".copy();
    if eat(borrow_mut(c), &"module") {
        m = ident(borrow_mut(c));
        expect(borrow_mut(c), &";");
    } else {
        if (c.file != 2) + raw {
            fail(borrow_mut(c), &"dependency files require an explicit module");
        }
    }
    if same(&m, &"runtime") {
        if raw == 0 {
            fail(borrow_mut(c), &"runtime module must be explicitly unsafe");
        }
    }
    if raw {
        if same(&m, &"runtime") == 0 {
            fail(borrow_mut(c), &"unsafe module reserved for runtime");
        }
    }
    is_std := stdlib_module(&m);
    exchange(borrow_mut(c.module), m);
    exchange(borrow_mut(c.default_u64), c.default_u64_flag);
    if is_std {
        exchange(borrow_mut(c.default_u64), 1);
    }
    exchange(borrow_mut(c.imports), Import[]);
    while eat(borrow_mut(c), &"use") {
        m = ident(borrow_mut(c));
        if eat(borrow_mut(c), &"::") {
            n := ident(borrow_mut(c));
            c.imports.push(Import { module: m, name: n });
        }
        expect(borrow_mut(c), &";");
    }
    while kind(borrow_mut(c)) != 0 {
        public := eat(borrow_mut(c), &"pub");
        if is(borrow_mut(c), &"type") {
            alias_declaration(borrow_mut(c), pass);
        } else {
            if is(borrow_mut(c), &"const") {
                constant_declaration(borrow_mut(c), pass);
            } else {
                if is(borrow_mut(c), &"interface") {
                    interface_declaration(borrow_mut(c), pass);
                } else {
                    if is(borrow_mut(c), &"impl") {
                        implementation(borrow_mut(c), pass);
                    } else {
                        if is(borrow_mut(c), &"struct") + is(borrow_mut(c), &"enum") {
                            decl(borrow_mut(c), pass);
                        } else {
                            func(borrow_mut(c), pass, public);
                        }
                    }
                }
            }
        }
    }
    return ();
}

// ---- expressions: eight-byte stack slots; left-to-right operands ----
fn deref<a>(c: (&a mut C), v: Val) -> Val {
    mut t = v.t;
    mut ty = v.ty;
    while ty_kind(borrow_mut(c), ty) == 7 {
        old := t;
        target := target_of(borrow_mut(c), old);
        get(borrow_mut(c), t, &"%rax");
        o(borrow_mut(c), &"movq (%rax),%rax\n");
        t = save(borrow_mut(c));
        ty = ty_arg(borrow_mut(c), ty);
        if c.raw == 0 {
            if target == 0 {
                fail(borrow_mut(c), &"reference target is not tracked");
            }
            c
                .resources
                .push(
                    Resource {
                        slot: t,
                        ty: ty,
                        flag: 0,
                        base: old + 1,
                        field: 0,
                        via: 1,
                        place: target,
                        target: 0,
                        authority: old + 1,
                    }
                );
            owner := place_of(borrow_mut(c), old);
            n := c.bonds.len();
            for i in n {
                mut b = &c.bonds[i];
                holder := b.holder;
                loan := b.loan;
                guard := b.guard;
                if (holder == owner) & guard {
                    bond_kind(borrow_mut(c), target, loan, guard);
                }
            }
            stored_source(borrow_mut(c), t, ty);
        }
    }
    return val(t, ty);
}
fn find_local<a, b>(c: (&a mut C), n: &b [u8]) -> u64 {
    mut i = c.locals.len();
    while 0 < i {
        i = i - 1;
        mut l = &c.locals[i];
        if same(&l.name, &n) {
            return i + 1;
        }
    }
    return 0;
}
fn local_id<a>(c: (&a mut C), i: u64) -> u64 {
    mut l = &c.locals[i];
    return l.id;
}
fn local_ty<a>(c: (&a mut C), i: u64) -> u64 {
    mut l = &c.locals[i];
    return l.ty;
}
fn pop_locals<a>(c: (&a mut C), mark: u64) -> unit {
    while mark < c.locals.len() {
        c.locals.pop();
    }
    return ();
}
// Loads, addresses and stores record fields.
fn rec_load<a>(c: (&a mut C), base: u64, k: u64, address: u64) -> u64 {
    get(borrow_mut(c), base, &"%rax");
    if address {
        o(borrow_mut(c), &"leaq ");
    } else {
        o(borrow_mut(c), &"movq ");
    }
    on(borrow_mut(c), k * 8);
    o(borrow_mut(c), &"(%rax),%rax\n");
    return save(borrow_mut(c));
}
fn rec_store<a>(c: (&a mut C), base: u64, k: u64, value: u64) -> unit {
    get(borrow_mut(c), base, &"%rcx");
    get(borrow_mut(c), value, &"%rax");
    o(borrow_mut(c), &"movq %rax,");
    on(borrow_mut(c), k * 8);
    o(borrow_mut(c), &"(%rcx)\n");
    return ();
}
fn field_path<a>(c: (&a mut C), id: u64, lty: u64, address: u64) -> Val {
    mut t = id;
    mut ty = lty;
    mut via = 0;
    while is(borrow_mut(c), &".") {
        if after_next_kind(borrow_mut(c)) == 40 {
            break;
        }
        if next_kind(borrow_mut(c)) == 46 {
            break;
        }
        advance(borrow_mut(c));
        f := member_name(borrow_mut(c));
        if ty_kind(borrow_mut(c), ty) == 7 {
            via = 1;
        }
        base := deref(borrow_mut(c), val(t, ty));
        mut b = base.t;
        if ty_kind(borrow_mut(c), base.ty) != 8 {
            fail(borrow_mut(c), &"field projection requires record");
        }
        d := ty_arg(borrow_mut(c), base.ty);
        decl := &c.decls[d];
        if decl.is_enum {
            fail(borrow_mut(c), &"enum payload requires match or unwrap");
        }
        k := find_field(borrow_mut(c), d, &f);
        fty := field_type(borrow_mut(c), base.ty, k);
        last := (kind(borrow_mut(c)) != 46) & (address != 0);
        n := rec_load(borrow_mut(c), b, k, last);
        if last {
            ty := reference_type(borrow_mut(c), fty, address == 2);
            root := place_of(borrow_mut(c), b);
            target := member_place(borrow_mut(c), root, k, fty);
            authority := authority_of(borrow_mut(c), b);
            if c.raw == 0 {
                c
                    .resources
                    .push(
                        Resource {
                            slot: n,
                            ty: ty,
                            flag: 0,
                            base: b + 1,
                            field: k,
                            via: via,
                            place: 0,
                            target: target,
                            authority: authority,
                        }
                    );
            }
            return val(n, ty);
        }
        alias_field(borrow_mut(c), n, fty, b, k, via);
        t = n;
        ty = fty;
    }
    observe(borrow_mut(c), t);
    return val(t, ty);
}
fn place<a>(c: (&a mut C), write: u64) -> Val {
    name := ident(borrow_mut(c));
    mut l = find_local(borrow_mut(c), &name);
    if l == 0 {
        if write {
            fail(borrow_mut(c), &"captured values are read-only inside a closure");
        }
        v := capture_field(borrow_mut(c), &name, 1);
        if v.ty == 18446744073709551615 {
            fail(
                borrow_mut(c),
                &"borrow needs a variable or field (bind the value first: x := ...; borrow(x))"
            );
        }
        target := target_of(borrow_mut(c), v.t);
        r := resource(borrow_mut(c), v.t);
        info := &c.resources[r - 1];
        base := info.base - 1;
        return borrow_reference(borrow_mut(c), v.t, v.ty, base, target, 0);
    }
    id := local_id(borrow_mut(c), l - 1);
    ty := local_ty(borrow_mut(c), l - 1);
    commit_flex(borrow_mut(c), l - 1);
    if write {
        require_mutable_binding(borrow_mut(c), id, 1);
    }
    if ty_kind(borrow_mut(c), ty) == 7 {
        if write {
            if ty_mode(borrow_mut(c), ty) == 0 {
                fail(borrow_mut(c), &"mutable reborrow of shared reference");
            }
        }
    }
    if kind(borrow_mut(c)) == 46 {
        mut v = field_path(borrow_mut(c), id, ty, 1 + write);
        target := target_of(borrow_mut(c), v.t);
        mut r = resource(borrow_mut(c), v.t);
        info := &c.resources[r - 1];
        base := info.base - 1;
        return borrow_reference(borrow_mut(c), v.t, v.ty, base, target, write);
    }
    return place_slot(borrow_mut(c), id, ty, write);
}
// Borrow of a whole binding: references reborrow their referent, other values borrow the slot.
fn place_slot<a>(c: (&a mut C), id: u64, ty: u64, write: u64) -> Val {
    target := place_of(borrow_mut(c), id);
    mut referent = ty;
    mut source = target;
    if ty_kind(borrow_mut(c), ty) == 7 {
        source = target_of(borrow_mut(c), id);
        referent = ty_arg(borrow_mut(c), ty);
        get(borrow_mut(c), id, &"%rax");
    } else {
        o(borrow_mut(c), &"leaq ");
        stack_slot(borrow_mut(c), id);
        o(borrow_mut(c), &",%rax\n");
    }
    slot := save(borrow_mut(c));
    mut out = reference_type(borrow_mut(c), referent, write);
    return borrow_reference(borrow_mut(c), slot, out, id, source, write);
}
// `borrow(x)`, `borrow(x.f.g)` and `borrow(xs[i])` name places; anything else is a temporary.
fn borrow_place_ahead<a>(c: (&a mut C)) -> u64 {
    if kind(borrow_mut(c)) != 1 {
        return false;
    }
    p := c.pos;
    name := tok_text(borrow_mut(c), p);
    mut j = p + 1;
    while (kind_at(borrow_mut(c), j) == 46) & (kind_at(borrow_mut(c), j + 1) == 1) {
        j = j + 2;
    }
    k := kind_at(borrow_mut(c), j);
    if (k == 91) & (j == p + 1) {
        // `u64[1,2]` is a type-first literal, not indexing a local.
        if find_local(borrow_mut(c), &name) == 0 {
            if simple_type_head(borrow_mut(c), &name) != 0 {
                return false;
            }
            m := module_copy(borrow_mut(c));
            if find_decl(borrow_mut(c), &m, &name) != 0 {
                return false;
            }
        }
    }
    // A named place remains a place before commas, semicolons and operators too.
    // Only a following call consumes an expression here (e.g. &make_value()).
    if (find_local(borrow_mut(c), &name) != 0) & (k != 40) {
        return true;
    }
    return (k == 41) + (k == 91);
}
// `borrow(f(x))`: the temporary is held by a hidden binding until the end of the enclosing
// block (like `t := f(x); borrow(t)`), so the reference may be used after the statement.
fn borrow_temporary<a>(c: (&a mut C), write: u64) -> Val {
    v := expr(borrow_mut(c), 0);
    if ty_kind(borrow_mut(c), v.ty) == 7 {
        if write {
            if ty_mode(borrow_mut(c), v.ty) == 0 {
                fail(borrow_mut(c), &"mutable reborrow of shared reference");
            }
        }
    }
    held := move_value(borrow_mut(c), v);
    bind(borrow_mut(c), copy_bytes(&".borrowed"), held.ty, held.t, write);
    return place_slot(borrow_mut(c), held.t, held.ty, write);
}
fn hex(b: u64) -> u64 {
    if b < 58 {
        return b - 48;
    }
    if b < 71 {
        return b - 55;
    }
    return b - 87;
}
fn string_lit<a>(c: (&a mut C)) -> Val {
    p := c.pos;
    t := &c.toks[p];
    st := t.start;
    en := t.end;
    advance(borrow_mut(c));
    mut l = label(borrow_mut(c));
    o(borrow_mut(c), &".pushsection .rodata\n");
    mark(borrow_mut(c), l);
    mut i = st + 1;
    mut count = 0;
    while i < en - 1 {
        mut b = c.src[i];
        if b == 92 {
            i = i + 1;
            e := c.src[i];
            b = e;
            if e == 110 {
                b = 10;
            }
            if e == 114 {
                b = 13;
            }
            if e == 116 {
                b = 9;
            }
            if e == 48 {
                b = 0;
            }
            if e == 120 {
                h := hex(c.src[i + 1]);
                lo := hex(c.src[i + 2]);
                b = h * 16 + lo;
                i = i + 2;
            }
        }
        o(borrow_mut(c), &".byte ");
        on(borrow_mut(c), b);
        c.out.push(10);
        count = count + 1;
        i = i + 1;
    }
    o(borrow_mut(c), &".byte 0\n.popsection\nleaq ");
    lname(borrow_mut(c), l);
    o(borrow_mut(c), &"(%rip),%rax\n");
    ptr := save(borrow_mut(c));
    n := imm(borrow_mut(c), count);
    t := invoke(borrow_mut(c), &"rt_string_lit", two(ptr, n));
    return own(borrow_mut(c), t, 3);
}
fn infer_type<a, b>(c: (&a mut C), formal: u64, actual: u64, map: (&b mut u64[])) -> unit {
    k := ty_kind(borrow_mut(c), formal);
    arg := ty_arg(borrow_mut(c), formal);
    if k == 9 {
        old := map[arg];
        if old == 18446744073709551615 {
            exchange(&mut map[arg], actual);
        } else {
            require_type(borrow_mut(c), actual, old);
        }
        return ();
    }
    ak := ty_kind(borrow_mut(c), actual);
    if k != ak {
        fail(borrow_mut(c), &"generic argument shape mismatch");
    }
    if k == 7 {
        fm := ty_mode(borrow_mut(c), formal);
        am := ty_mode(borrow_mut(c), actual);
        if fm != am {
            fail(borrow_mut(c), &"generic reference mode mismatch");
        }
    }
    if (k == 6) + (k == 7) + (k == 13) + (k == 14) + (k == 16) {
        aa := ty_arg(borrow_mut(c), actual);
        infer_type(borrow_mut(c), arg, aa, borrow_mut(map));
        return ();
    }
    if (k == 12) + (k == 20) {
        result := ty_arg(borrow_mut(c), actual);
        infer_type(borrow_mut(c), arg, result, borrow_mut(map));
        fs := type_args(borrow_mut(c), formal);
        as := type_args(borrow_mut(c), actual);
        if fs.len() != as.len() {
            fail(borrow_mut(c), &"callable argument arity mismatch");
        }
        for i in fs.len() {
            f := fs[i];
            a := as[i];
            infer_type(borrow_mut(c), f, a, borrow_mut(map));
        }
        return ();
    }
    if k == 8 {
        aa := ty_arg(borrow_mut(c), actual);
        if arg != aa {
            fail(borrow_mut(c), &"generic nominal mismatch");
        }
        fa := type_args(borrow_mut(c), formal);
        ax := type_args(borrow_mut(c), actual);
        if fa.len() != ax.len() {
            fail(borrow_mut(c), &"generic arity mismatch");
        }
        for i in fa.len() {
            f := fa[i];
            a := ax[i];
            infer_type(borrow_mut(c), f, a, borrow_mut(map));
        }
        return ();
    }
    require_type(borrow_mut(c), actual, formal);
    return ();
}
fn infer_union_member<a, b>(
    c: (&a mut C),
    expected: u64,
    actual: u64,
    map: (&b mut u64[])
) -> unit {
    // Infer a bare value against a unique unbound union member.
    if is_union(borrow_mut(c), expected) & (is_union(borrow_mut(c), actual) == 0) {
        members := type_args(borrow_mut(c), expected);
        mut known = 0;
        mut candidates = 0;
        mut parameter = 0;
        for i in members.len() {
            member := members[i];
            kind := ty_kind(borrow_mut(c), member);
            if kind == 9 {
                idx := ty_arg(borrow_mut(c), member);
                bound := map[idx];
                if bound == 18446744073709551615 {
                    candidates += 1;
                    parameter = idx;
                } else {
                    if same_type(borrow_mut(c), bound, actual) {
                        known += 1;
                    }
                }
            } else {
                if concrete_type(borrow_mut(c), member) {
                    if same_type(borrow_mut(c), member, actual) {
                        known += 1;
                    }
                }
            }
        }
        if (known == 0) & (candidates == 1) {
            exchange(&mut map[parameter], actual);
        }
    }
    return ();
}
fn constructor_hint<a>(c: (&a mut C), decl: u64, explicit: u64) -> u64 {
    if explicit != 18446744073709551615 {
        return explicit;
    }
    result := c.result;
    if ty_kind(borrow_mut(c), result) == 8 {
        if ty_arg(borrow_mut(c), result) == decl {
            return result;
        }
    }
    return 18446744073709551615;
}
