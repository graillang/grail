fn primary<a>(c:ref_mut<a,C>)->Val {
    let k=kind(borrow_mut(c));
    if k==40 {
        advance(borrow_mut(c));
        if eat(borrow_mut(c),read(")")) {
            return val(imm(borrow_mut(c),0),1);
        }
        let v=expr(borrow_mut(c),0);
        expect(borrow_mut(c),read(")"));
        return v;
    }
    if k==3 { return string_lit(borrow_mut(c)); }
    if k==2 {
        let p=c.pos;
        let t=tok_text(borrow_mut(c),p);
        advance(borrow_mut(c));
        o(borrow_mut(c),read("movabsq $"));o(borrow_mut(c),read(t));o(borrow_mut(c),read(",%rax\n"));
        return val(save(borrow_mut(c)),0);
    }
    let first=ident(borrow_mut(c));
    if same(read(first),read("vec"))&is(borrow_mut(c),read("<")) {
        advance(borrow_mut(c));
        let e=parse_type(borrow_mut(c));
        expect(borrow_mut(c),read(">"));
        expect(borrow_mut(c),read("("));
        expect(borrow_mut(c),read(")"));
        let ty=intern(borrow_mut(c),6,e);
        let slot=apply(borrow_mut(c),read("rt_new"),vec<num>());return own(borrow_mut(c),slot,ty);
    }
    let m=module_copy(borrow_mut(c));
    if is(borrow_mut(c),read("<")){
        let local=find_local(borrow_mut(c),read(first));let d=find_decl(borrow_mut(c),read(m),read(first));
        if (local==0)&(d!=0){let ty=nominal_type(borrow_mut(c),d-1);
            if eat(borrow_mut(c),read("::")){let name=ident(borrow_mut(c));return variant(borrow_mut(c),d-1,read(name),ty);}
            return record(borrow_mut(c),d-1,ty);}
    }
    if eat(borrow_mut(c),read("::")) {
        let second=ident(borrow_mut(c));
        if is(borrow_mut(c),read("<")){let d=find_decl(borrow_mut(c),read(first),read(second));
            if d!=0{let ty=nominal_type(borrow_mut(c),d-1);if eat(borrow_mut(c),read("::")){let name=ident(borrow_mut(c));return variant(borrow_mut(c),d-1,read(name),ty);}return record(borrow_mut(c),d-1,ty);}}

        if eat(borrow_mut(c),read("::")) {
            let third=ident(borrow_mut(c));
            let d=find_decl(borrow_mut(c),read(first),read(second));
            if d==0 { fail(borrow_mut(c),read("unknown enum")); }
            return variant(borrow_mut(c),d-1,read(third),18446744073709551615);
        }
        let d=find_decl(borrow_mut(c),read(m),read(first));
        if d!=0 { return variant(borrow_mut(c),d-1,read(second),18446744073709551615); }
        let r=find_decl(borrow_mut(c),read(first),read(second));
        if (r!=0)&is(borrow_mut(c),read("{")) { return record(borrow_mut(c),r-1,18446744073709551615); }
        return call(borrow_mut(c),read(first),read(second));
    }
    if is(borrow_mut(c),read("<")){let local=find_local(borrow_mut(c),read(first));let f=find_func(borrow_mut(c),read(m),read(first));if (local==0)&(f!=0){return call(borrow_mut(c),read(m),read(first));}}
    if is(borrow_mut(c),read("(")) {
        let b=builtin_id(read(first));
        if b!=0 { return builtin(borrow_mut(c),b); }
        return call(borrow_mut(c),read(m),read(first));
    }
    let l=find_local(borrow_mut(c),read(first));
    if l!=0 {
        let id=local_id(borrow_mut(c),l-1);
        let ty=local_ty(borrow_mut(c),l-1);
        if kind(borrow_mut(c))!=46{observe(borrow_mut(c),id);}
        return field_path(borrow_mut(c),id,ty,0);
    }
    let r=find_decl(borrow_mut(c),read(m),read(first));
    if r!=0 { return record(borrow_mut(c),r-1,18446744073709551615); }
    fail(borrow_mut(c),read("undefined name"));
    return val(0,0);
}
fn prec(k:num)->num {
    if k==38 { return 1; }
    if k==94 { return 2; }
    if (k==258)+(k==259)+(k==60) { return 3; }
    if (k==43)+(k==45) { return 4; }
    if (k==42)+(k==37) { return 5; }
    return 0;
}
// `?` returns a failure unchanged (payload layout is shared); `!` aborts on it.
fn propagate<a>(c:ref_mut<a,C>,v:Val,unwrap:num)->Val{
 let x=deref(borrow_mut(c),v);let xt=x.t;if ty_kind(borrow_mut(c),x.ty)!=8{fail(borrow_mut(c),read("unwrap/propagate requires enum"));}let d=ty_arg(borrow_mut(c),x.ty);var k=0;
 let shape=vec_get(c.decls,d);if (shape.is_enum==0)+(shape.count!=2){fail(borrow_mut(c),read("unwrap requires two-variant Option/Result"));}
 let dd=vec_get(c.decls,d);let fi=dd.first;let f=vec_get(c.fields,fi);
 let first=copy_bytes(read(f.name));let second=vec_get(c.fields,fi+1);let last=copy_bytes(read(second.name));
 var valid=0;
 if same(read(first),read("Ok"))&same(read(last),read("Err")){valid=1;}
 if same(read(first),read("Some"))&same(read(last),read("None")){valid=1;}
 if same(read(last),read("Ok"))&same(read(first),read("Err")){valid=1;k=1;}
 if same(read(last),read("Some"))&same(read(first),read("None")){valid=1;k=1;}
 if valid==0{fail(borrow_mut(c),read("unwrap requires Ok/Err or Some/None variants"));}
 get(borrow_mut(c),xt,read("%rax"));o(borrow_mut(c),read("cmpq $"));on(borrow_mut(c),k);o(borrow_mut(c),read(",(%rax)\n"));
 let ok=label(borrow_mut(c));jump(borrow_mut(c),read("je"),ok);
 let before=ownership::snapshot(borrow(c.check));
 if unwrap{o(borrow_mut(c),read("call rt_abort\n"));}else{
 if c.raw==0{let result=c.result;require_type(borrow_mut(c),x.ty,result);}
 validate_return(borrow_mut(c),val(xt,x.ty));move_out(borrow_mut(c),val(xt,x.ty));cleanup(borrow_mut(c),0);get(borrow_mut(c),xt,read("%rax"));o(borrow_mut(c),read("leave\nret\n"));}
 mark(borrow_mut(c),ok);ownership::restore(borrow_mut(c.check),borrow(before));let n=rec_load(borrow_mut(c),xt,1,0);move_out(borrow_mut(c),val(xt,x.ty));invoke(borrow_mut(c),read("rt_free"),one(xt));let ty=field_type(borrow_mut(c),x.ty,k);own(borrow_mut(c),n,ty);let source=place_of(borrow_mut(c),xt);let dest=place_of(borrow_mut(c),n);if contains_borrow(borrow_mut(c),ty,0){transfer_bonds(borrow_mut(c),source,dest);}stored_source(borrow_mut(c),n,ty);return val(n,ty);
}
fn binary<a>(c:ref_mut<a,C>,k:num,left:num,right:num)->num{
 let p=prec(k);
        get(borrow_mut(c),right,read("%rcx")); get(borrow_mut(c),left,read("%rax"));
        if k==43 { o(borrow_mut(c),read("addq %rcx,%rax\n")); }
        if k==45 { o(borrow_mut(c),read("subq %rcx,%rax\n")); }
        if k==42 { o(borrow_mut(c),read("imulq %rcx,%rax\n")); }
        if k==38 { o(borrow_mut(c),read("andq %rcx,%rax\n")); }
        if k==94 { o(borrow_mut(c),read("xorq %rcx,%rax\n")); }
        if k==37 {
            o(borrow_mut(c),read("testq %rcx,%rcx\n")); let ok=label(borrow_mut(c));
            jump(borrow_mut(c),read("jnz"),ok); o(borrow_mut(c),read("call rt_abort\n")); mark(borrow_mut(c),ok);
            o(borrow_mut(c),read("xorq %rdx,%rdx\ndivq %rcx\nmovq %rdx,%rax\n"));
        }
        if p==3 {
            o(borrow_mut(c),read("cmpq %rcx,%rax\n"));
            if k==258 { o(borrow_mut(c),read("sete %al\n")); }
            if k==259 { o(borrow_mut(c),read("setne %al\n")); }
            if k==60 { o(borrow_mut(c),read("setb %al\n")); }
            o(borrow_mut(c),read("movzbq %al,%rax\n"));
        }
 return save(borrow_mut(c));
}
fn expr<a>(c:ref_mut<a,C>,min:num)->Val {
    let first=primary(borrow_mut(c));
    var t=first.t;
    var ty=first.ty;
    while 1 {
        let k=kind(borrow_mut(c));
        let p=prec(k);
        if (k==63)+(k==33) {
            advance(borrow_mut(c));
            let r=propagate(borrow_mut(c),val(t,ty),k==33);
            t=r.t;
            ty=r.ty;
        } else {
            if p==0 { break; }
            if p<min { break; }
            advance(borrow_mut(c));
            get(borrow_mut(c),t,read("%rax"));let snap=save(borrow_mut(c));
            let right=expr(borrow_mut(c),p+1);
            if c.raw==0{require_type(borrow_mut(c),ty,0);require_type(borrow_mut(c),right.ty,0);}
            t=binary(borrow_mut(c),k,snap,right.t);
            ty=0;
        }
    }
    return val(t,ty);
}

// ---- statements ----
fn block<a>(c:ref_mut<a,C>)->unit{
 let start=c.pos;let end=block_end(borrow_mut(c),start);let oldend=c.scope_end;exchange(borrow_mut(c.scope_end),end);
 expect(borrow_mut(c),read("{"));let mark=len(c.locals);let owners=len(c.resources);
 while is(borrow_mut(c),read("}"))==0{stmt(borrow_mut(c));}advance(borrow_mut(c));cleanup(borrow_mut(c),owners);pop_locals(borrow_mut(c),mark);exchange(borrow_mut(c.scope_end),oldend);return ();
}
fn assignment_ahead<a>(c:ref_mut<a,C>)->num {
    if kind(borrow_mut(c))!=1 { return 0; }
    var e=c.pos+1;
    while kind_at(borrow_mut(c),e)==46 { e=e+2; }
    return kind_at(borrow_mut(c),e)==61;
}
// Evaluates one argument to its dereferenced value.
fn operand<a>(c:ref_mut<a,C>)->Val {let v=expr(borrow_mut(c),0);return deref(borrow_mut(c),v);}
fn statement_call<a,b>(c:ref_mut<a,C>,f:read<b>,count:num)->unit{
