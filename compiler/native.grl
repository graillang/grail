}
// Correctly rounded decimal -> binary with p significand bits (53 binary64, 24 binary32); the
// result is always the binary64 word holding that value.
fn float_bits_p<a, b>(c: (&a mut C), text: &b [u8], p: u64) -> u64 {
    mut bias = 1023;
    if p == 24 {
        bias = 127;
    }
    half := 1 << (p - 1);
    full := 1 << p;
    lowest := p + bias - 2;
    mut mantissa = u64[];
    mut exponent = 0;
    mut negative_exponent = 0;
    mut fraction_digits = 0;
    mut seen_dot = 0;
    mut i = 0;
    while i < text.len() {
        d := text[i];
        if (d == 101) || (d == 69) {
            break;
        }
        if d == 46 {
            seen_dot = 1;
        } else {
            big_mul_add(&mut mantissa, 10, d - 48);
            if seen_dot != 0 {
                fraction_digits += 1;
            }
        }
        i += 1;
    }
    if i < text.len() {
        i += 1;
        if text[i] == 45 {
            negative_exponent = 1;
            i += 1;
        } else {
            if text[i] == 43 {
                i += 1;
            }
        }
        while i < text.len() {
            exponent = exponent * 10 + text[i] - 48;
            if 100000 < exponent {
                fail(&mut c, view("float literal exponent too large"));
            }
            i += 1;
        }
    }
    big_trim(&mut mantissa);
    if mantissa.len() == 0 {
        return 0;
    }
    // value = mantissa * 10^scale
    mut up = 0;
    mut down = fraction_digits;
    if negative_exponent != 0 {
        down += exponent;
    } else {
        if exponent < down {
            down = down - exponent;
        } else {
            up = exponent - down;
            down = 0;
        }
    }
    if 400 < up {
        float_range(&mut c, p);
    }
    mut top = mantissa;
    for j in up {
        big_mul_add(&mut top, 10, 0);
    }
    mut bottom = u64[1];
    if 800 < down {
        return 0;
    }
    for j in down {
        big_mul_add(&mut bottom, 10, 0);
    }
    // Choose k with 2^52 <= top*2^k/bottom < 2^53 (k may be negative), clamped for subnormals.
    tb := big_bits(&top);
    bb := big_bits(&bottom);
    mut k = p + bb;
    mut kneg = 0;
    if tb < k {
        k = k - tb;
    } else {
        k = tb - k;
        kneg = 1;
    }
    mut attempts = 0;
    while true {
        attempts += 1;
        if 4 < attempts {
            fail(&mut c, view("float literal conversion failed"));
        }
        // Subnormal range: the leading bit would sit below 2^-1022; fix the scale at 2^-1074.
        if (kneg == 0) & (lowest < k) {
            k = lowest;
        }
        mut a = copy_numbers(&top);
        mut b = copy_numbers(&bottom);
        if kneg != 0 {
            b = big_shl(&b, k);
        } else {
            a = big_shl(&a, k);
        }
        big_trim(&mut a);
        big_trim(&mut b);
        // quotient (at most 54 bits) by binary long division
        mut shifted = big_shl(&b, p);
        big_trim(&mut shifted);
        mut q = 0;
        for step in p + 1 {
            q = q * 2;
            if big_cmp(&a, &shifted) != 0 {
                big_sub(&mut a, &shifted);
                q += 1;
            }
            big_shr1(&mut shifted);
        }
        subnormal := (kneg == 0) & (k == lowest);
        if q < half && !subnormal {
            if kneg != 0 {
                if k == 0 {
                    kneg = 0;
                    k = 1;
                } else {
                    k -= 1;
                }
            } else {
                k += 1;
            }
            continue;
        }
        if full - 1 < q {
            if kneg != 0 {
                k += 1;
            } else {
                if k == 0 {
                    kneg = 1;
                    k = 1;
                } else {
                    k -= 1;
                }
            }
            continue;
        }
        // round half to even using the remainder
        twice := big_shl(&a, 1);
        mut tw = twice;
        big_trim(&mut tw);
        order := big_cmp(&tw, &b);
        if (order == 2) || ((order == 1) && ((q % 2) == 1)) {
            q += 1;
        }
        if q == full {
            q = half;
            if kneg != 0 {
                k += 1;
            } else {
                if k == 0 {
                    kneg = 1;
                    k = 1;
                } else {
                    k -= 1;
                }
            }
        }
        if subnormal & (q < half) {
            if p == 53 {
                return q;
            }
            return small_f32_bits(q);
        }
        // value = q * 2^-k ; biased exponent = 52 - k + 1023
        mut biased = 0;
        if kneg != 0 {
            biased = bias + p - 1 + k;
        } else {
            if bias + p - 1 < k {
                return q;
            }
            biased = bias + p - 1 - k;
        }
        if 2 * bias < biased {
            float_range(&mut c, p);
        }
        if p == 53 {
            return biased * 4503599627370496 + (q - half);
        }
        return (biased + 896) * 4503599627370496 + ((q - half) << 29);
    }
    return 0;
}
fn float_range<a>(c: (&a mut C), p: u64) -> unit {
    if p == 24 {
        fail(&mut c, view("float literal out of range for f32"));
    }
    fail(&mut c, view("float literal out of range for f64"));
    return ();
}
// q * 2^-149 (a binary32 subnormal, q < 2^23) as a binary64 word.
fn small_f32_bits(q: u64) -> u64 {
    if q == 0 {
        return 0;
    }
    mut top = 0;
    while (1 << (top + 1)) < q + 1 {
        top += 1;
    }
    return (top + 874) * 4503599627370496 + ((q << (52 - top)) - 4503599627370496);
}
fn bool_type<a>(c: (&a mut C)) -> u64 {
    return intern(&mut c, 19, 0);
