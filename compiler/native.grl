                    fv := imm(&mut c, code);
                    tv := imm(&mut c, to);
                    widened := invoke(&mut c, view("rt_int_cast"), three(value.t, fv, tv));
                    slot := invoke(&mut c, view("rt_char_from"), one(widened));
