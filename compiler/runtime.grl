    n := rt_cwd(buf, size - 1);
    out := rt_new();
    if rt_error(n) == 0 {
        mut i = 0;
        while i < n {
            rt_pushb(out, raw_byte(buf + i));
            i = i + 1;
        }
    }
    rt_free(buf);
    return out;
}

// Appends tmp to acc padded to `width` characters (UTF-8 aware); align 1 left, 2 right, 3 center.
// Zero padding goes after a leading minus sign, as in Rust.
fn rt_fmt_pad(acc: u64, tmp: u64, width: u64, align: u64, zero: u64, fill: u64) -> u64 {
    n := rt_len(tmp);
    mut chars = 0;
    mut i = 0;
    while i < n {
        if (rt_atb(tmp, i) & 192) != 128 {
            chars += 1;
        }
        i += 1;
    }
    mut pad = 0;
    if chars < width {
        pad = width - chars;
    }
    if zero {
        i = 0;
        if n != 0 {
            if rt_atb(tmp, 0) == 45 {
                rt_pushb(acc, 45);
                i = 1;
            }
        }
        mut k = 0;
        while k < pad {
            rt_pushb(acc, 48);
            k += 1;
        }
        while i < n {
            rt_pushb(acc, rt_atb(tmp, i));
            i += 1;
        }
        rt_drop_seq(tmp);
        return 0;
    }
    mut before = 0;
    if align == 2 {
        before = pad;
    }
    if align == 3 {
        before = rt_div(pad, 2);
    }
    after := pad - before;
    mut k = 0;
    while k < before {
        rt_push_char(acc, fill);
        k += 1;
    }
    i = 0;
    while i < n {
        rt_pushb(acc, rt_atb(tmp, i));
        i += 1;
    }
    k = 0;
    while k < after {
        rt_push_char(acc, fill);
        k += 1;
    }
    rt_drop_seq(tmp);
    return 0;
}
fn rt_push_char(acc: u64, b: u64) -> u64 {
    rt_pushb(acc, b);
    return 0;
}

// Byte-lexicographic comparison of two byte sequences / strings / views (op as in rt_int).
fn rt_seq_cmp(op: u64, a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    mut i = 0;
    mut order = 1; // 0 less, 1 equal, 2 greater
    while (i < n) & (i < m) {
        x := rt_atb(a, i);
        y := rt_atb(b, i);
        if x != y {
            if x < y {
                order = 0;
            } else {
                order = 2;
            }
            break;
        }
        i += 1;
    }
    if order == 1 {
        if n < m {
            order = 0;
        }
        if m < n {
            order = 2;
        }
    }
    if op == 258 {
        return order == 1;
    }
    if op == 259 {
        return order != 1;
    }
    if op == 60 {
        return order == 0;
    }
    if op == 62 {
        return order == 2;
    }
    if op == 269 {
        return order != 2;
    }
    if op == 270 {
        return order != 0;
    }
    rt_abort();
    return 0;
}
// Element-wise comparison of word vectors (u64[], sized integers, bool).
fn rt_vec_cmp(op: u64, a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    mut i = 0;
    mut order = 1; // 0 less, 1 equal, 2 greater
    while (i < n) & (i < m) {
        x := rt_at(a, i);
        y := rt_at(b, i);
        if x != y {
            if x < y {
                order = 0;
            } else {
                order = 2;
            }
            break;
        }
        i += 1;
    }
    if order == 1 {
        if n < m {
            order = 0;
        }
        if m < n {
            order = 2;
        }
    }
    return rt_order_result(op, order);
}
// The comparison `op` (== != < > <= >=) given an ordering 0 less, 1 equal, 2 greater.
fn rt_order_result(op: u64, order: u64) -> u64 {
    if op == 258 {
        return order == 1;
    }
    if op == 259 {
        return order != 1;
    }
    if op == 60 {
        return order == 0;
    }
    if op == 62 {
        return order == 2;
    }
    if op == 269 {
        return order != 2;
    }
    if op == 270 {
        return order != 0;
    }
    rt_abort();
    return 0;
}
fn rt_concat(a: u64, b: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    mut i = 0;
    while i < n {
        rt_pushb(out, rt_atb(a, i));
        i += 1;
    }
    m := rt_len(b);
    i = 0;
    while i < m {
        rt_pushb(out, rt_atb(b, i));
        i += 1;
    }
    return out;
}
fn rt_concat_text(a: u64, b: u64) -> u64 {
    out := rt_concat(a, b);
    rt_utf8(out);
    return out;
}

// ---- built-in text methods ----
fn rt_seq_match(a: u64, at: u64, b: u64) -> u64 {
    m := rt_len(b);
    if rt_len(a) < at + m {
        return 0;
    }
    mut j = 0;
    while j < m {
        if rt_atb(a, at + j) != rt_atb(b, j) {
            return 0;
        }
        j += 1;
    }
    return 1;
}
fn rt_seq_contains(a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    if n < m {
        return 0;
    }
    mut i = 0;
    while i < n - m + 1 {
        if rt_seq_match(a, i, b) {
            return 1;
        }
        i += 1;
    }
    return 0;
}
fn rt_seq_starts(a: u64, b: u64) -> u64 {
    return rt_seq_match(a, 0, b);
}
fn rt_seq_ends(a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    if n < m {
        return 0;
    }
    return rt_seq_match(a, n - m, b);
}
// Case mapping for ASCII, Latin-1, Latin Extended-A, Greek and Cyrillic (simple 1:1 mappings;
// other scripts and special cases like German sharp s are left unchanged).
fn rt_case_map(cp: u64, upper: u64) -> u64 {
    if upper {
        if cp == 940 {
            return 902;
        }
        if cp == 941 {
            return 904;
        }
        if cp == 942 {
            return 905;
        }
        if cp == 943 {
            return 906;
        }
        if cp == 972 {
            return 908;
        }
        if cp == 973 {
            return 910;
        }
        if cp == 974 {
            return 911;
        }
        if (96 < cp) & (cp < 123) {
            return cp - 32;
        }
        if ((223 < cp) & (cp < 255) & (cp != 247)) {
            return cp - 32;
        }
        if cp == 255 {
            return 376;
        }
        if (255 < cp) & (cp < 384) {
            if (cp < 311) + ((312 < cp) & (cp < 329)) + (329 < cp) {
                if ((cp < 311) + (329 < cp)) & ((cp & 1) == 1) & (cp != 305) & (cp != 383) {
                    return cp - 1;
                }
                if (312 < cp) & (cp < 329) & ((cp & 1) == 0) {
                    return cp - 1;
                }
            }
        }
        if (944 < cp) & (cp < 970) & (cp != 962) {
            return cp - 32;
        }
        if cp == 962 {
            return 931;
        }
        if (1071 < cp) & (cp < 1104) {
            return cp - 32;
        }
        if (1103 < cp) & (cp < 1120) {
            return cp - 80;
        }
        return cp;
    }
    if cp == 902 {
        return 940;
    }
    if cp == 904 {
        return 941;
    }
    if cp == 905 {
        return 942;
    }
    if cp == 906 {
        return 943;
    }
    if cp == 908 {
        return 972;
    }
    if cp == 910 {
        return 973;
    }
    if cp == 911 {
        return 974;
    }
    if (64 < cp) & (cp < 91) {
        return cp + 32;
    }
    if ((191 < cp) & (cp < 223) & (cp != 215)) {
        return cp + 32;
    }
    if cp == 376 {
        return 255;
    }
    if (255 < cp) & (cp < 384) {
        if ((cp < 311) + (329 < cp)) & ((cp & 1) == 0) & (cp != 304) & (cp != 382) {
            return cp + 1;
        }
        if (312 < cp) & (cp < 329) & ((cp & 1) == 1) {
            return cp + 1;
        }
    }
    if (912 < cp) & (cp < 940) & (cp != 930) {
        return cp + 32;
    }
    if (1039 < cp) & (cp < 1072) {
        return cp + 32;
    }
    if (1023 < cp) & (cp < 1040) {
        return cp + 80;
    }
    return cp;
}
fn rt_push_utf8(out: u64, v: u64) -> u64 {
    if v < 128 {
        rt_pushb(out, v);
        return 0;
    }
    if v < 2048 {
        rt_pushb(out, 192 + rt_div(v, 64));
        rt_pushb(out, 128 + v % 64);
        return 0;
    }
    if v < 65536 {
        rt_pushb(out, 224 + rt_div(v, 4096));
        rt_pushb(out, 128 + rt_div(v, 64) % 64);
        rt_pushb(out, 128 + v % 64);
        return 0;
    }
    rt_pushb(out, 240 + rt_div(v, 262144));
    rt_pushb(out, 128 + rt_div(v, 4096) % 64);
    rt_pushb(out, 128 + rt_div(v, 64) % 64);
    rt_pushb(out, 128 + v % 64);
    return 0;
}
fn rt_seq_case(a: u64, upper: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    mut i = 0;
    while i < n {
        b := rt_atb(a, i);
        if b < 128 {
            rt_pushb(out, rt_case_map(b, upper));
            i += 1;
        } else {
            if ((b & 224) == 192) & (i + 1 < n) {
                c1 := rt_atb(a, i + 1);
                if (c1 & 192) == 128 {
                    rt_push_utf8(out, rt_case_map((b & 31) * 64 + (c1 & 63), upper));
                    i += 2;
                } else {
                    rt_pushb(out, b);
                    i += 1;
                }
            } else {
                rt_pushb(out, b);
                i += 1;
            }
        }
    }
    return out;
}
fn rt_seq_upper(a: u64) -> u64 {
    return rt_seq_case(a, 1);
}
fn rt_seq_lower(a: u64) -> u64 {
    return rt_seq_case(a, 0);
}
fn rt_space(b: u64) -> u64 {
    return (b == 32) + (b == 9) + (b == 10) + (b == 13);
}
fn rt_seq_replace(a: u64, from: u64, to: u64, valid: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    m := rt_len(from);
    t := rt_len(to);
    mut i = 0;
    while i < n {
        if (m != 0) & rt_seq_match(a, i, from) {
            mut j = 0;
            while j < t {
                rt_pushb(out, rt_atb(to, j));
                j += 1;
