// A thread-per-task task owns an OS thread: the joiner reaps it once the finished word is set, so
// the thread has exited before its stack is unmapped and the handle is released. Green tasks have
// already released their own stack, so this is a no-op there.
fn rt_task_reap(t: u64) -> u64 {
    if rt_task_threads() {
        h := raw_atomic_swap(t + 152, 0);
        if h != 0 {
            rt_thread_join(h);
        }
    }
    return 0;
}
// Dropping an unjoined handle never blocks: the scope exit joins and destroys the result.
fn rt_task_abandon(t: u64) -> u64 {
    if raw_load(t + 104) == 0 {
        raw_store(t + 104, 2);
    }
    return 0;
}
// After this returns, no readiness batch read before the call is still being delivered, so a
// task woken by cancellation (whose event may already have been read) can be freed safely.
fn rt_reactor_fence() -> u64 {
    if (rt_task_threads()) | (rt_os_reactor() == 0) {
        return 0; // no reactor batch to fence
    }
    s := raw_atomic_load(raw_state() + 72);
    if s == 0 {
        return 0;
    }
    if raw_load(s + 40) == 0 {
        return 0; // the platform had no reactor to start
    }
    epoch := raw_atomic_load(s + 56);
    rt_os_reactor_fence(s);
    while raw_atomic_load(s + 56) == epoch {
        rt_yield();
    }
    return 0;
}
fn rt_scope_end(s: u64) -> u64 {
    mut t = raw_load(s + 24);
    mut first = t;
    while first != 0 {
        rt_task_wait(first);
        first = raw_load(first + 120);
    }
    if raw_load(s + 24) != 0 {
        rt_reactor_fence();
    }
    while t != 0 {
        rt_task_wait(t);
        state := raw_load(t + 104);
        if state == 0 {
            rt_abort();
        }
        kind := raw_load(t + 160);
        if (state == 2) & (kind == 16) & (raw_atomic_load(s + 8) != 0) {
            // A child that ended Cancelled because this scope was cancelled did what was asked:
            // not re-raised. Its texts go with it.
            rt_drop_seq(rt_task_message(t));
            rt_drop_seq(rt_task_site(t));
        } else if (state == 2) & (kind != 0) {
            // An abandoned handle whose task failed: the scope's result type has no arm for it, so
            // the failure is reported here - contained by the enclosing task, fatal at the top.
            rt_fail_text(kind, rt_task_message(t), rt_task_site(t));
        }
        dropper := raw_load(t + 112);
        if (state == 2) & (dropper != 0) & (kind == 0) {
            raw_call2(dropper, raw_load(t + 80), 0);
        }
        rt_task_reap(t);
        next := raw_load(t + 120);
        rt_free(t);
        t = next;
    }
    rt_free(s);
    return 0;
}

// ---- readiness reactor and suspending I/O ----
// The readiness source itself is the platform's (epoll, kqueue, an I/O completion port): the
// portable scheduler only starts this thread and wakes the tasks the platform reports.
fn rt_reactor(s: u64) -> u64 {
    return rt_os_reactor_loop(s);
}
// Wait until fd is ready (events: 1 readable, 4 writable). A green task suspends on the reactor
// registration; a plain OS thread blocks in ppoll. Returns -125 (ECANCELED) if its scope is
// cancelled.
fn rt_wait_fd(fd: u64, events: u64) -> u64 {
    if rt_task_threads() {
        // Thread-per-task: the task's own thread does the blocking call that follows, so there is
        // nothing to wait for here. This is the documented thread-per-blocking-call policy.
        return 0;
    }
    if rt_os_ready() == 0 {
        // No readiness source (Windows: the reactor is a completion port, and every host
        // operation that can block is offloaded instead, so the task parks inside that operation
        // and not here). Report ready so a caller retries the operation rather than waiting on
        // nothing.
        return 0;
    }
    t := rt_current();
    if t == 0 {
        // A plain OS thread has no task to park: block it in poll.
        p := rt_alloc(8);
        raw_store(p, (fd & 4294967295) + events * 4294967296);
        rt_syscall(271, p, 1, 0);
        rt_free(p);
        return 0;
    }
    token := raw_load(t + 72);
    raw_atomic_store(t + 128, 1);
    if raw_atomic_load(token) {
        raw_atomic_store(t + 128, 0);
        return wrapping_sub(0, 125);
    }
    s := rt_sched();
    if rt_os_wait_fd(s, fd, events, t) != 0 {
        raw_atomic_store(t + 128, 0);
        return 0; // could not arm: the caller retries the operation
    }
    rt_suspend(t);
    raw_atomic_store(t + 128, 0);
    rt_os_wait_done(s, fd);
    if raw_atomic_load(token) {
        return wrapping_sub(0, 125);
    }
    return 0;
}
// Sleep body that owns no task: the portable sleep call, used when the sleep has to happen off the
// scheduler thread.
fn rt_sleep_now(spec: u64, unused: u64) -> u64 {
    return rt_syscall_low(35, spec, 0, 0);
}
fn f_host_sleep_ms(ms: u64) -> u64 {
    return rt_sleep_for(ms, 3);
}
fn rt_sleep_job(t: u64, ms: u64) -> u64 {
    s := rt_sched();
    until := f_host_now_ms() + ms;
    mut left = ms;
    while left != 0 {
        if rt_os_timer(s, t, left) != 0 {
            rt_sleep_plain(left);
            return 0;
        }
        rt_suspend(t);
        rt_os_timer_done(s, t);
        now := f_host_now_ms();
        if now < until {
            left = until - now;
        } else {
            left = 0;
        }
    }
    raw_atomic_cas(t + 24, 3, 0);
    return 0;
}
// The sleep with no task to park: this thread sleeps, or a helper does while the task parks.
fn rt_sleep_plain(ms: u64) -> u64 {
    spec := rt_alloc(32);
    raw_store(spec + 16, rt_div(ms, 1000));
    raw_store(spec + 24, (ms % 1000) * 1000000);
    if (rt_current() == 0) | rt_task_threads() {
        rt_syscall_low(35, spec + 16, 0, 0);
    } else {
        rt_blocking_call(rt_sleep_now, spec + 16, 0);
    }
    rt_free(spec);
    return 0;
}
// Which scheduler worker is running this call, numbered from 1, or 0 when the caller is not on one
// (the main thread, a thread-per-task task, an offload helper). A fork-join test records the
// distinct values it sees; it is also the cheapest way to confirm that work actually spreads.
fn f_host_worker_id() -> u64 {
    w := rt_worker_self();
    if w == 0 {
        return 0;
    }
    return raw_load(w + 40) + 1;
}
// How many scheduler workers the process created (0 in thread-per-task mode, which has none). A
// program uses it to tell "this host is sequential" from "work did not spread".
fn f_host_workers() -> u64 {
    if rt_task_threads() {
        return 0;
    }
    s := rt_sched();
    return raw_load(s + 32);
}
fn f_host_now_ms() -> u64 {
    spec := rt_alloc(16);
    rt_syscall_low(228, 1, spec, 0);
    ms := raw_load(spec) * 1000 + rt_div(raw_load(spec + 8), 1000000);
    rt_free(spec);
    return ms;
}
// The same monotonic clock in microseconds: a frame time or a join cost is not measurable in
// whole milliseconds.
fn f_host_now_us() -> u64 {
    spec := rt_alloc(16);
    rt_syscall_low(228, 1, spec, 0);
    us := raw_load(spec) * 1000000 + rt_div(raw_load(spec + 8), 1000);
    rt_free(spec);
    return us;
}
// CLOCK_REALTIME (clockid 0) in milliseconds since the Unix epoch; the wall clock a program
// reports rather than the monotonic one it measures with. Both fit u64 milliseconds.
fn f_host_wall_ms() -> u64 {
    spec := rt_alloc(16);
    rt_syscall_low(228, 0, spec, 0);
    ms := raw_load(spec) * 1000 + rt_div(raw_load(spec + 8), 1000000);
    rt_free(spec);
    return ms;
}
fn f_host_pipe() -> u64 {
    // Two descriptors: eight bytes on POSIX, two handles on Windows, so the platform layer is what
    // reads them back (rt_pipe_push).
    buf := rt_alloc(16);
    if rt_error(rt_syscall(293, buf, 526336, 0)) {
        rt_free(buf);
        rt_abort();
    }
    out := rt_new();
    rt_pipe_push(buf, out);
    rt_free(buf);
    return out;
}
// Reads up to max bytes; suspends (green) while no data is available. Empty on end/cancel.
// `max` with bit 62 set (2^62 + n) reads at most n bytes and does not wait: nothing to read yet is an
// empty vector (the jobserver's token take, compiler/jobs.grl).
fn f_host_read_fd(fd: u64, asked: u64) -> u64 {
    out := rt_new();
    now_only := (asked / 4611686018427387904) & 1;
    max := asked % 4611686018427387904;
    if max == 0 {
        return out;
    }
    // A large read lands in the result's own buffer; a small one in a scratch buffer, so a vector
    // holding a few bytes does not keep a megabyte of capacity.
    direct := 65535 < max;
    mut buf = 0;
    if direct {
        rt_reserveb(out, max);
        buf = raw_load(out);
    } else {
        buf = rt_alloc(max);
    }
    while true {
        n := rt_io(rt_read_now, fd, buf, max);
        if n == wrapping_sub(0, 11) {
            if now_only {
                break;
            }
            if rt_wait_fd(fd, 1) != 0 {
                break;
            }
        } else {
            if (rt_error(n) == 0) & (n != 0) {
                // One copy of what arrived at most, not a push per byte: the compiler reads its
                // workers' output through here, a hundred megabytes of it.
                if direct {
                    raw_store(out + 8, n);
                } else {
                    rt_reserveb(out, n);
                    rt_copy_bytes(raw_load(out), buf, n);
                    raw_store(out + 8, n);
                }
            }
            break;
        }
    }
    if !direct {
        rt_free(buf);
    }
    return out;
}
// Writes everything (suspending while the pipe is full); returns bytes written.
fn f_host_write_fd(fd: u64, data: u64) -> u64 {
    packed := rt_pack(data);
    length := rt_len(data);
    mut done = 0;
    while done < length {
        n := rt_io(rt_write_now, fd, packed + done, length - done);
        if n == wrapping_sub(0, 11) {
            if rt_wait_fd(fd, 4) != 0 {
                break;
            }
        } else {
            if rt_error(n) {
                break;
            }
            done += n;
        }
    }
    rt_free(packed);
    rt_view_free(data);
    return done;
}
fn f_host_close(fd: u64) -> u64 {
    r := rt_syscall(3, fd, 0, 0);
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
}

// ---- blocking foreign calls: a worker is given to a spare thread for the call ------------------
// A worker block (deques, runner, free lists) and the OS thread running it are separate (Go's P and
// M): `extern "C" blocking fn` calls rt_blocking_enter before the call and rt_blocking_leave after.
// On a worker that is running a green task, enter gives the block to a spare thread - woken, or
// made if fewer than twice the worker count exist - and this thread becomes block-less: it makes
// the C call, and afterwards keeps running its task (forks and spawns go to the injection rings,
// as from any thread that is not a worker) until the task parks or ends. Threads are reused, so a
// program that makes a blocking call at a time pays for a thread once, not per call. Then its scheduler loop
// sees it holds no block and it becomes a spare itself (rt_worker_thread). Nothing moves the task:
// C's frames and C's thread-locals stay on this thread. A blocking call off a worker - main, a
// plain thread, a callback (pinned, word 120) - is a plain call.
//
// Jobs block words: 432 lock of the list of blocks waiting for a thread (linked through block word
// 296), 440 its head, 448 idle spares, 456 threads made beyond the workers, 464 the spares' futex
// sequence, 472..480 a timespec of one second (how long an idle spare waits), 488..496 the
// monitor's 5 ms tick, 504 free list of retired foreign-call counters (rt_job_carve), 512 "the
// monitor's warning was printed".
fn rt_blocking_enter() -> u64 {
    tp := raw_tp_get();
    if tp == 0 {
        return 0;
    }
    if (raw_load(tp + 24) != 2) || (raw_load(tp + 120) != 0) {
        return 0;
    }
    t := raw_load(tp + 16);
    if t == 0 {
        return 0;
    }
    w := raw_load(tp + 32);
    if raw_load(w + 224) == t {
        // The block's runner is this task: from now on it is an ordinary task, and the block's next
        // owner makes a fresh runner.
        raw_store(w + 224, 0);
    }
    raw_store(tp + 24, 0);
    raw_store(tp + 32, 0);
    rt_marker_cache(tp, 0);
    rt_block_give(w);
    return 0;
}
// Nothing to do at the end of the call: the thread stays block-less until its task stops running
// (rt_worker_run, rt_worker_loop), and then looks for a block like any spare.
fn rt_blocking_leave() -> u64 {
    return 0;
}
// Hand block `w` to a thread: queue it, then wake an idle spare or make one.
fn rt_block_give(w: u64) -> u64 {
    j := raw_load(rt_state_jobs());
    rt_spin_lock(j + 432);
    raw_store(w + 296, raw_load(j + 440));
    raw_store(j + 440, w);
    rt_spin_unlock(j + 432);
    raw_atomic_fetch_add(j + 464, 1);
    if raw_atomic_load(j + 448) != 0 {
        rt_syscall_low(202, j + 464, 129, 1);
        return 0;
    }
    // No idle spare: make one. There is no hard cap on how many - every blocked call holds a
    // thread, and a block left waiting for a thread while every thread is blocked would deadlock a
    // program whose blocked calls wait for a task that cannot run (100 FIFO readers and their
    // writer: colourless-io-suspension-cancel-blocking). Idle spares are what is bounded: one idle
    // for a second exits when more than the worker count of them are waiting (rt_worker_thread).
    // One safety limit, as Go has: a program with this many threads blocked in foreign calls is
    // stuck, and making more would only exhaust the machine. It fails loudly instead.
    if 10000 <= raw_atomic_fetch_add(j + 456, 1) {
        text := view("error: 10000 threads are blocked in foreign calls; making more would exhaust the machine (does a blocking call wait for something that cannot run?)\n");
        packed := rt_pack(text);
        rt_write_all(2, packed, rt_len(text));
        rt_abort();
    }
    rt_thread_spawn_detached(rt_worker_thread, 0);
    return 0;
}
fn rt_block_take() -> u64 {
    j := raw_load(rt_state_jobs());
    if raw_atomic_load(j + 440) == 0 {
        return 0;
    }
    rt_spin_lock(j + 432);
    w := raw_load(j + 440);
    if w != 0 {
        raw_store(j + 440, raw_load(w + 296));
    }
    rt_spin_unlock(j + 432);
    return w;
}
// A scheduler thread: run block `w` (0: start as a spare) until this thread loses it to a blocking
// call, then wait for another block. A spare idle for a second exits when more than the worker
// count of spares exist.
fn rt_worker_thread(first: u64) -> u64 {
    j := raw_load(rt_state_jobs());
    s := raw_atomic_load(raw_state() + 72);

    mut w = first;
    while true {
        if w != 0 {
            rt_worker_loop(w);
        }
        w = rt_block_take();
        while w == 0 {
            seq := raw_atomic_load(j + 464);
            w = rt_block_take();
            if w != 0 {
                break;
            }
            raw_atomic_fetch_add(j + 448, 1);
            // Jobs words 472/480: a timespec of one second, written once (rt_jobs_create).
            mut r = rt_syscall4(202, j + 464, 128, seq, j + 472);
            if r == wrapping_sub(0, 38) {
                // No timed wait on this platform (Windows): wait without one; spares do not retire.
                r = rt_syscall(202, j + 464, 128, seq);
            }
            raw_atomic_fetch_sub(j + 448, 1);
            w = rt_block_take();
            if (w == 0) & (r == wrapping_sub(0, 110)) {
                // Idle for a second: keep at most the worker count of spares waiting.
                if raw_load(s + 32) < raw_atomic_load(j + 448) + 1 {
                    raw_atomic_fetch_sub(j + 456, 1);
                    return 0;
                }
            }
        }
    }
    return 0;
}
// A green task runs a blocking operation on its own thread, having given its worker to a spare for
// the call (rt_offload). A plain OS thread runs it directly.
fn rt_blocking_call(f: u64, a: u64, b: u64) -> u64 {
    if rt_current() == 0 {
        return raw_call2(f, a, b);
    }
    return rt_offload(f, a, b, 0);
}

// A read or write that may block. With a readiness reactor the descriptor is non-blocking and the
// task parks in rt_wait_fd; on a platform with no readiness source (Windows) the call itself runs
// on the task's own thread with its worker given to a spare (rt_offload), so a task inside
// host::read_fd or host::write_fd does not stall the scheduler. The observable behaviour is the same on both; only the mechanism differs.
fn rt_read_now(fd: u64, buf: u64, max: u64) -> u64 {
    return rt_syscall(0, fd, buf, max);
}
fn rt_write_now(fd: u64, buf: u64, len: u64) -> u64 {
    return rt_syscall(1, fd, buf, len);
}
fn rt_io(f: u64, a: u64, b: u64, c: u64) -> u64 {
    if (rt_current() == 0) | rt_task_threads() | (rt_os_ready() != 0) {
        return raw_call3(f, a, b, c);
    }
    return rt_offload(f, a, b, c);
}

// Blocking-call boundary: a blocking host operation on a green task gives the task's worker to a
// spare thread for the call (rt_blocking_enter), exactly as an `extern "C" blocking` call does, and
// runs it right here on this thread - no thread per call, no switch, no completion to deliver.
fn rt_offload(f: u64, a: u64, b: u64, c: u64) -> u64 {
    rt_blocking_enter();
    r := raw_call3(f, a, b, c);
    rt_blocking_leave();
    return r;
}

// ---- host services for the grail command-line tool ----
fn rt_bytes_from(p: u64, n: u64) -> u64 {
    out := rt_new();
    mut i = 0;
    while i < n {
        rt_pushb(out, raw_byte(p + i));
        i += 1;
    }
    return out;
}
fn f_host_env(name: u64) -> u64 {
    n := rt_len(name);
    mut ep = raw_load(raw_state() + 16);
    while raw_load(ep) != 0 {
        p := raw_load(ep);
        mut i = 0;
        mut same = 1;
        while i < n {
            if raw_byte(p + i) != rt_atb(name, i) {
                same = 0;
                break;
            }
            i += 1;
        }
        if same {
            if raw_byte(p + n) == 61 {
                mut m = 0;
                while raw_byte(p + n + 1 + m) != 0 {
                    m += 1;
                }
                rt_view_free(name);
                return rt_bytes_from(p + n + 1, m);
            }
        }
        ep = ep + 8;
    }
    rt_view_free(name);
    return rt_new();
}
// The running image's own path. This is what lets the driver re-invoke itself, so it is the
// platform module's answer: /proc/self/exe on Linux, _NSGetExecutablePath on macOS,
// GetModuleFileNameA on Windows.
fn f_host_exe_path() -> u64 {
    buf := rt_alloc(4096);
    n := rt_exe_path(buf, 4096);
    mut out = rt_new();
    if rt_error(n) == 0 {
        rt_free(out);
        out = rt_bytes_from(buf, n);
    }
    rt_free(buf);
    return out;
}
fn f_host_exists(path: u64) -> u64 {
    name := rt_cstr(path);
    rt_view_free(path);
    if name == 0 {
        return 0;
    }
    r := rt_faccessat(name);
    rt_free(name);
    return rt_error(r) == 0;
}
fn f_host_mkdir(path: u64) -> u64 {
    name := rt_cstr(path);
    rt_view_free(path);
    if name == 0 {
        return 22;
    }
    r := rt_syscall(258, wrapping_sub(0, 100), name, 493);
    rt_free(name);
    if r == wrapping_sub(0, 17) {
        return 0;
    }
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
}
// Directory entries without "." and ".."; directories get a trailing "/". Empty if unreadable.
fn f_host_list_dir(path: u64) -> u64 {
    out := rt_new();
    name := rt_cstr(path);
    rt_view_free(path);
    if name == 0 {
        return out;
    }
    // O_RDONLY|O_CLOEXEC only: O_DIRECTORY has different values per architecture (AArch64: 0x4000).
    fd := rt_syscall(2, name, 524288, 0);
    rt_free(name);
    if rt_error(fd) {
        return out;
    }
    buf := rt_alloc(8192);
    while true {
        n := rt_syscall(217, fd, buf, 8192);
        if (n == 0) + rt_error(n) {
            break;
        }
        mut at = 0;
        while at < n {
            record := buf + at;
            length := raw_byte(record + 16) + raw_byte(record + 17) * 256;
            kind := raw_byte(record + 18);
            mut m = 0;
            while raw_byte(record + 19 + m) != 0 {
                m += 1;
            }
            dot := (raw_byte(record + 19) == 46)
                & ((m == 1) + ((m == 2) & (raw_byte(record + 20) == 46)));
            if dot == 0 {
                entry := rt_bytes_from(record + 19, m);
                if kind == 4 {
                    rt_pushb(entry, 47);
                }
                rt_push(out, entry);
            }
            at += length;
        }
    }
    rt_syscall(3, fd, 0, 0);
    rt_free(buf);
    return out;
}

// ---- sized integers: canonical words (unsigned zero-extended, signed sign-extended) ----
// code = bits | signed<<8 | wrap<<9. Checked mode aborts on overflow; wrap mode truncates.
fn rt_int_mask(bits: u64) -> u64 {
    if bits == 64 {
        return 18446744073709551615;
    }
    mut m = 1;
    mut i = 0;
    while i < bits {
        m = wrapping_add(m, m);
        i += 1;
    }
    return m - 1;
}
fn rt_int_neg(v: u64) -> u64 {
    return 9223372036854775807 < v;
}
fn rt_int_fit(r: u64, bits: u64, signed: u64) -> u64 {
    if bits == 64 {
        return 1;
    }
    mask := rt_int_mask(bits);
    if signed {
        half := (mask / 2) + 1;
        return (wrapping_add(r, half) < mask) + (wrapping_add(r, half) == mask);
    }
    return (r < mask) + (r == mask);
}
fn rt_int_truncate(r: u64, bits: u64, signed: u64) -> u64 {
    if bits == 64 {
        return r;
    }
    mask := rt_int_mask(bits);
    t := r & mask;
    if signed {
        half := (mask / 2) + 1;
        if (t < half) == 0 {
            return t + (18446744073709551615 ^ mask);
        }
    }
    return t;
}
fn rt_int_abs(v: u64) -> u64 {
    if rt_int_neg(v) {
        return wrapping_sub(0, v);
    }
    return v;
}
fn rt_int(op: u64, a: u64, b: u64, code: u64) -> u64 {
