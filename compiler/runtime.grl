        return raw_flt(a, b);
    }
    if op == 62 {
        return raw_flt(b, a);
    }
    if op == 269 {
        return raw_flt(a, b) + raw_feq(a, b);
    }
    if op == 270 {
        return raw_flt(b, a) + raw_feq(a, b);
    }
    if op == 258 {
        return raw_feq(a, b);
    }
    if op == 259 {
        return raw_feq(a, b) == 0;
    }
    rt_abort();
    return 0;
}
