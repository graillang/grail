                }
            }
        }
        if need == 99 {
            rt_push(out, 65533);
            i += 1;
            continue;
        }
        mut ok = 1;
        mut j = 1;
        while j < need + 1 {
            if n < i + j + 1 {
                ok = 0;
                break;
