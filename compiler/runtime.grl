    rt_pushwk(s, src, w);
    rt_free(src);
    return 0;
}
// rt_pushw without freeing the source: a plain record's source is frame words.
fn rt_pushwk(s: u64, src: u64, w: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    cap := raw_load(wrapping_add(s, 16));
    if n == cap {
        mut capacity = cap * 2;
        if capacity == 0 {
            capacity = 8;
        }
        // No product here can overflow: 2^40 elements of at most 2^20 bytes.
        if (1099511627776 < capacity) + (1048576 < w) {
            rt_abort();
        }
        ptr := rt_grow(raw_load(s), wrapping_mul(n, w), wrapping_mul(capacity, w));
        raw_store(s, ptr);
        raw_store(wrapping_add(s, 16), capacity);
    }
    dst := wrapping_add(raw_load(s), wrapping_mul(n, w));
    // Records are whole words: copy them as such, without the byte copier's call and tail loop.
    if (w & 7) == 0 {
        mut i = 0;
        while i < w {
            raw_store(wrapping_add(dst, i), raw_load(wrapping_add(src, i)));
            i = i + 8;
        }
    } else {
        rt_copy_bytes(dst, src, w);
    }
    raw_store(wrapping_add(s, 8), n + 1);
    return 0;
}
fn rt_vec_insertwk(s: u64, index: u64, src: u64, w: u64) -> u64 {
    n := rt_len(s);
    if n < index {
        rt_abort();
    }
    rt_pushwk(s, src, w);
    mut i = n;
    while index < i {
        rt_copy_bytes(rt_slotw(s, i, w), rt_slotw(s, i - 1, w), w);
        i -= 1;
    }
    rt_copy_bytes(rt_slotw(s, index, w), src, w);
    return 0;
}
fn rt_popw(s: u64, w: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    if n == 0 {
        rt_fail(8, 0, 0);
    }
    raw_store(wrapping_add(s, 8), n - 1);
    return rt_flat_box(wrapping_add(raw_load(s), wrapping_mul(n - 1, w)), w);
}
// rt_popw into `dst` (the caller's frame words) instead of a fresh box.
fn rt_popw_into(s: u64, w: u64, dst: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    if n == 0 {
        rt_fail(8, 0, 0);
    }
    raw_store(wrapping_add(s, 8), n - 1);
    rt_copy_bytes(dst, wrapping_add(raw_load(s), wrapping_mul(n - 1, w)), w);
    return dst;
}
// The quiet form: 1 and the element copied to `dst` when there was one, 0 when the vector was empty.
fn rt_popw_quiet_into(s: u64, w: u64, dst: u64) -> u64 {
    if raw_load(wrapping_add(s, 8)) == 0 {
        return 0;
    }
    rt_popw_into(s, w, dst);
    return 1;
}
fn rt_vec_removew_into(s: u64, index: u64, w: u64, dst: u64) -> u64 {
    n := rt_len(s);
    if (index < n) == 0 {
        rt_abort();
    }
    rt_copy_bytes(dst, rt_slotw(s, index, w), w);
    mut i = index;
    while i + 1 < n {
        rt_copy_bytes(rt_slotw(s, i, w), rt_slotw(s, i + 1, w), w);
        i += 1;
    }
    raw_store(wrapping_add(s, 8), n - 1);
    return dst;
}
fn rt_popw_quiet(s: u64, w: u64) -> u64 {
    if raw_load(wrapping_add(s, 8)) == 0 {
        return 0;
    }
    return rt_popw(s, w);
}
fn rt_vec_insertw(s: u64, index: u64, src: u64, w: u64) -> u64 {
    rt_vec_insertwk(s, index, src, w);
    rt_free(src);
    return 0;
}
fn rt_vec_removew(s: u64, index: u64, w: u64) -> u64 {
    n := rt_len(s);
    if (index < n) == 0 {
        rt_abort();
    }
    v := rt_flat_box(rt_slotw(s, index, w), w);
    mut i = index;
    while i + 1 < n {
        rt_copy_bytes(rt_slotw(s, i, w), rt_slotw(s, i + 1, w), w);
        i += 1;
    }
    raw_store(wrapping_add(s, 8), n - 1);
    return v;
}
fn rt_vec_swapw(s: u64, i: u64, j: u64, w: u64) -> u64 {
    a := rt_slotw(s, i, w);
    b := rt_slotw(s, j, w);
    if i != j {
        rt_swap(a, b, w);
    }
    return 0;
}
fn rt_vec_reversew(s: u64, w: u64) -> u64 {
    n := rt_len(s);
    mut i = 0;
    while i < (n >> 1) {
        rt_vec_swapw(s, i, n - 1 - i, w);
        i += 1;
    }
    return 0;
}
fn rt_vec_truncate4(s: u64, keep: u64) -> u64 {
    if keep < rt_len(s) {
        raw_store(wrapping_add(s, 8), keep);
    }
    return 0;
}
fn rt_vec_contains4(s: u64, v: u64) -> u64 {
    n := rt_len(s);
    want := v & 4294967295;
    mut i = 0;
    while i < n {
        if rt_at4(s, i) == want {
            return 1;
        }
        i += 1;
    }
    return 0;
}
// A 4-byte element as the word Grail holds, given its element code: f32 (7) widened, a signed
// integer (int code bit 8) sign-extended, an unsigned one as is.
fn rt_narrow_decode(unit: u64, code: u64) -> u64 {
    if code == 7 {
        return rt_f32_from_bits(unit);
    }
    if (1023 < code) & (((code - 1024) & 256) != 0) {
        if (unit & 2147483648) != 0 {
            return unit | 18446744069414584320;
        }
    }
    return unit;
}
// Element-wise float equality of two vectors or slices (narrow: 4-byte f32 units).
fn rt_vec_feq(a: u64, b: u64, narrow: u64) -> u64 {
    n := rt_len(a);
    if n != rt_len(b) {
        return 0;
    }
    mut i = 0;
    while i < n {
        mut x = 0;
        mut y = 0;
        if narrow {
            x = rt_f32_from_bits(rt_at4(a, i));
            y = rt_f32_from_bits(rt_at4(b, i));
        } else {
            x = rt_at(a, i);
            y = rt_at(b, i);
        }
        if raw_feq(x, y) == 0 {
            return 0;
        }
        i += 1;
    }
    return 1;
}
fn rt_vec_cmp4(op: u64, a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    mut i = 0;
    mut order = 1; // 0 less, 1 equal, 2 greater
    while (i < n) & (i < m) {
        x := rt_at4(a, i);
        y := rt_at4(b, i);
        if x != y {
            if x < y {
                order = 0;
            } else {
                order = 2;
            }
            break;
        }
        i += 1;
    }
    if order == 1 {
        if n < m {
            order = 0;
        }
        if m < n {
            order = 2;
        }
    }
    return rt_order_result(op, order);
}
// ---- vector methods (elements are words: values or owning pointers; nothing is copied) ----
fn rt_vec_set(s: u64, i: u64, v: u64) -> u64 {
    raw_store(wrapping_add(raw_load(s), wrapping_mul(i, 8)), v);
    return 0;
}
fn rt_vec_insert(s: u64, index: u64, v: u64) -> u64 {
    n := rt_len(s);
    if n < index {
        rt_abort();
    }
    rt_push(s, 0);
    mut i = n;
    while index < i {
        rt_vec_set(s, i, rt_at(s, i - 1));
        i -= 1;
    }
    rt_vec_set(s, index, v);
    return 0;
}
fn rt_vec_remove(s: u64, index: u64) -> u64 {
    n := rt_len(s);
    if (index < n) == 0 {
        rt_abort();
    }
    v := rt_at(s, index);
    mut i = index;
    while i + 1 < n {
        rt_vec_set(s, i, rt_at(s, i + 1));
        i += 1;
    }
    rt_pop(s);
    return v;
}
fn rt_vec_swap(s: u64, i: u64, j: u64) -> u64 {
    n := rt_len(s);
    if ((i < n) == 0) + ((j < n) == 0) {
        rt_abort();
    }
    a := rt_at(s, i);
    rt_vec_set(s, i, rt_at(s, j));
    rt_vec_set(s, j, a);
    return 0;
}
fn rt_vec_reverse(s: u64) -> u64 {
    // Two pointers meeting in the middle: one load and one store per word, no per-element call or
    // bounds check (both ends are inside the vector by construction).
    n := raw_load(wrapping_add(s, 8));
    if n < 2 {
        return 0;
    }
    mut lo = raw_load(s);
    mut hi = wrapping_add(lo, wrapping_mul(n - 1, 8));
    while lo < hi {
        w := raw_load(lo);
        raw_store(lo, raw_load(hi));
        raw_store(hi, w);
        lo = wrapping_add(lo, 8);
        hi = wrapping_sub(hi, 8);
    }
    return 0;
}
// `truncate`/`clear` of a vector of inline elements `w` bytes wide that own something
// (unboxed-values.md, stage 4): each removed element is dropped in place, at its address, by
// `dropper` (its in-place drop), from the last one back, and the length is set.
fn rt_vec_truncatew(s: u64, keep: u64, w: u64, dropper: u64) -> u64 {
    mut n = raw_load(s + 8);
    while keep < n {
        n -= 1;
        raw_store(s + 8, n);
        raw_call2(dropper, wrapping_add(raw_load(s), wrapping_mul(n, w)), 0);
    }
    return 0;
}
fn rt_vec_truncate(s: u64, keep: u64, dropper: u64) -> u64 {
    if dropper == 0 {
        // Plain words: clear the tail and set the length, instead of a pop per element.
        n := raw_load(s + 8);
        if keep < n {
            base := raw_load(s);
            mut i = keep;
            while i < n {
                raw_store(base + i * 8, 0);
                i += 1;
            }
            raw_store(s + 8, keep);
        }
        return 0;
    }
    while keep < rt_len(s) {
        v := rt_pop(s);
        if dropper != 0 {
            raw_call2(dropper, v, 0);
        }
    }
    return 0;
}
fn rt_vec_contains(s: u64, v: u64) -> u64 {
    n := rt_len(s);
    mut i = 0;
    while i < n {
        if rt_at(s, i) == v {
            return 1;
        }
        i += 1;
    }
    return 0;
}

// ---- sampling profiler (Linux x86-64) -------------------------------------------------------
// `grail profile` puts the arming request in the target's environment as GRAIL_PROFILE and runs it.
// The runtime reads that variable during startup (rt_thread_init), samples the interrupted
// instruction pointer from an ITIMER_PROF/SIGPROF timer and writes the raw addresses to the path
// named in the request when the process ends. The environment is the only channel: nothing is
// written to the working directory, so a killed run leaves no stale request and the target needs no
// writable directory. The handler never allocates, never takes the allocator lock and
// never calls the kernel: it claims a slot with a CAS loop and stores one word, so a signal that
// interrupts the allocator cannot deadlock against it.
//
// Process-state words (rt_state is 4096 bytes; these sit between the allocator's last bin word and
// the Windows-only thread-bridge word at 3392):
//   2048 control page pointer  (0 = not profiled; the only word the handler reads)
//   2176 sample path           (NUL terminated, 96 bytes, copied from the request)
//   2272 itimerval             (32 bytes: interval then value, seconds then microseconds)
//   2304 sigaction             (32 bytes: handler, flags, restorer, mask)
//   2336 sigaltstack           (24 bytes: stack pointer, flags, size)
//   2400 request text scratch  (256 bytes, startup only)
//   2656 timespec             (16 bytes: CLOCK_PROCESS_CPUTIME_ID at arm and at exit)
//
// The control page is the first 4096 bytes of the sample mapping:
//   0 magic  8 sample base  16 capacity  24 claimed  32 dropped  40 rate  48 cpu start (ns)
//   56 words per sample: 1, or 8 for a request of version 2 (`grail profile --callers`), whose
//      samples are the instruction pointer and then up to seven return addresses, read up the
//      frame-pointer chain and ended by a zero. A version-1 request takes exactly the old path.
fn rt_prof_words() -> u64 {
    return raw_state() + 2048;
}
fn rt_prof_page() -> u64 {
    return raw_load(raw_state() + 2048);
}
// One slot per sample: index = CAS-claimed counter, payload = interrupted instruction pointer.
fn rt_prof_handler(sig: u64, info: u64, ctx: u64) -> u64 {
    page := rt_prof_page();
    if page == 0 {
        return 0;
    }
    i := raw_atomic_fetch_add(page + 24, 1);
    if i < raw_load(page + 16) {
        // The kernel's rt_sigframe keeps the ucontext at a fixed offset from the third handler
        // argument; RIP is gregs[16] inside its sigcontext, 40 + 16 * 8.
        depth := raw_load(page + 56);
        if depth < 2 {
            raw_store(raw_load(page + 8) + i * 8, raw_load(ctx + 168));
        } else {
            // The callers: every Grail frame keeps rbp, so the chain gives the return addresses.
            // A frame pointer is followed only while it lies above the interrupted stack pointer,
            // within 64 MiB of it, aligned and climbing - a leaf caught in its prologue or a frame
            // without one ends the chain rather than sending the handler to read anywhere.
            slot := raw_load(page + 8) + i * depth * 8;
            raw_store(slot, raw_load(ctx + 168));
            sp := raw_load(ctx + 160);
            mut bp = raw_load(ctx + 120);
            mut j = 1;
            while j < depth {
                if (bp < sp) | (sp + 67108864 < bp) | ((bp & 7) != 0) {
                    break;
                }
                raw_store(slot + j * 8, raw_load(bp + 8));
                next := raw_load(bp);
                j += 1;
                if next <= bp {
                    break;
                }
                bp = next;
            }
            while j < depth {
                raw_store(slot + j * 8, 0);
                j += 1;
            }
        }
    } else {
        raw_atomic_fetch_add(page + 32, 1);
    }
    return 0;
}
// True when the NUL-terminated string at `p` starts with "GRAIL_PROFILE=": "GRAIL_PR" and "OFILE="
// as two little-endian words, so nothing is allocated on a program that is not being profiled.
fn rt_prof_name(p: u64) -> u64 {
    if raw_load(p) != 5931345490498114119 {
        return 0;
    }
    if (raw_load(p + 8) & 4294967295) != 1279870543 {
        return 0;
    }
    if (raw_load(p + 12) & 65535) != 15685 {
        return 0;
    }
    return 1;
}
// Copies the value of GRAIL_PROFILE into `dst` and returns its length, or 0 when this process's
// environment carries no request. Nothing is consumed: a child inherits the request only when it
// inherits this environment, and an explicit `host::command_with` environment can drop it.
fn rt_prof_request(dst: u64, capacity: u64) -> u64 {
    mut ep = rt_environ();
    while raw_load(ep) != 0 {
        p := raw_load(ep);
        if rt_prof_name(p) != 0 {
            mut i = 0;
            while raw_byte(p + 14 + i) != 0 {
                if capacity <= i {
                    return 0;
                }
                raw_putbyte(dst + i, raw_byte(p + 14 + i));
                i += 1;
            }
            return i;
        }
        ep = ep + 8;
    }
    return 0;
}
// First byte of the next space-separated token at or after `at`; `n` at end of line.
fn rt_prof_token(buf: u64, n: u64, at: u64) -> u64 {
    mut i = at;
    while i < n {
        c := raw_byte(buf + i);
        if c == 10 {
            return n;
        }
        if (c == 32) || (c == 9) || (c == 13) {
            i = i + 1;
        } else {
            return i;
        }
    }
    return n;
}
fn rt_prof_end(buf: u64, n: u64, at: u64) -> u64 {
    mut i = at;
    while i < n {
        c := raw_byte(buf + i);
        if (c < 48) || (57 < c) {
            return i;
        }
        i = i + 1;
    }
    return i;
}
fn rt_prof_num(buf: u64, n: u64, at: u64) -> u64 {
    mut i = at;
    mut value = 0;
    while i < n {
        c := raw_byte(buf + i);
        if (c < 48) || (57 < c) {
            break;
        }
        value = value * 10 + (c - 48);
        i = i + 1;
    }
    return value;
}
// Arms sampling from GRAIL_PROFILE when this process's environment carries it and this is Linux
// x86-64.
fn rt_prof_start() -> u64 {
    if raw_target() != 0 {
        return 0;
    }
    words := rt_prof_words();
    if raw_load(words) != 0 {
        return 0;
    }
    text := words + 352;
    n := rt_prof_request(text, 256);
    if n == 0 {
        return 0;
    }
    // "1 RATE CAPACITY PATH": the format version, the sampling rate in Hz, the sample capacity and
    // the file the raw addresses go to. The CLI writes it; a hand-written file is accepted too.
    v := rt_prof_token(text, n, 0);
    version := rt_prof_num(text, n, v);
    if (version != 1) & (version != 2) {
        return 0;
    }
    mut depth = 1;
    if version == 2 {
        depth = 8;
    }
    mut r = rt_prof_end(text, n, v);
    mut rate = rt_prof_num(text, n, rt_prof_token(text, n, r));
    r = rt_prof_end(text, n, rt_prof_token(text, n, r));
    mut cap = rt_prof_num(text, n, rt_prof_token(text, n, r));
    r = rt_prof_end(text, n, rt_prof_token(text, n, r));
    path := rt_prof_token(text, n, r);
    if (rate == 0) || (cap == 0) || (path == n) {
        return 0;
    }
    if 1000000 < rate {
        rate = 1000000;
    }
    if 1048576 < cap {
        cap = 1048576;
    }
    mut used = 0;
    while path + used < n {
        c := raw_byte(text + path + used);
        if c == 10 {
            break;
        }
        if 95 < used {
            return 0;
        }
        raw_putbyte(words + 128 + used, c);
        used = used + 1;
    }
    raw_putbyte(words + 128 + used, 0);
    page := raw_map(4096 + cap * 8 * depth);
    if rt_error(page) {
        return 0;
    }
    stack := raw_map(65536);
    if rt_error(stack) {
        return 0;
    }
    code := raw_map(4096);
    if rt_error(code) {
        return 0;
    }
    // The restorer the kernel returns through: movl $__NR_rt_sigreturn,%eax; syscall; ud2.
    raw_store(code, 1082287778126892984);
    raw_putbyte(code + 8, 11);
    if rt_error(raw_syscall4(10, code, 4096, 5, 0)) {
        return 0;
    }
    raw_store(words + 288, stack);
    raw_store(words + 296, 0);
    raw_store(words + 304, 65536);
    if rt_error(raw_syscall4(131, words + 288, 0, 0, 0)) {
        return 0;
    }
    sa := words + 256;
    raw_store(sa, rt_prof_handler);
    // SA_ONSTACK | SA_RESTORER | SA_RESTART | SA_SIGINFO
    raw_store(sa + 8, 469762052);
    raw_store(sa + 16, code);
    raw_store(sa + 24, 0);
    if rt_error(raw_syscall4(13, 27, sa, 0, 8)) {
        return 0;
    }
    raw_store(page, 1347569201);
    raw_store(page + 8, page + 4096);
    raw_store(page + 16, cap);
    raw_store(page + 24, 0);
    raw_store(page + 32, 0);
    raw_store(page + 40, rate);
    raw_store(page + 56, depth);
    ts := words + 608;
    if rt_error(rt_syscall_low(228, 2, ts, 0)) {
        raw_store(page + 48, 0);
    } else {
        raw_store(page + 48, raw_load(ts) * 1000000000 + raw_load(ts + 8));
    }
    raw_store(words, page);
    // ITIMER_PROF counts CPU time, so blocked programs do not accumulate samples. One tick interval
    // and one first tick: seconds stay zero because the rate is clamped to at most one per
    // microsecond.
    mut usec = rt_div(1000000, rate);
    if usec == 0 {
        usec = 1;
    }
    raw_store(words + 224, 0);
    raw_store(words + 232, usec);
    raw_store(words + 240, 0);
    raw_store(words + 248, usec);
    raw_syscall(38, 2, words + 224, 0);
    return 0;
}
// Stops the timer and writes the header plus the sampled addresses. Safe to call twice.
fn rt_prof_dump() -> u64 {
    if raw_target() != 0 {
        return 0;
    }
    words := rt_prof_words();
    page := raw_load(words);
    if page == 0 {
        return 0;
    }
    raw_store(words, 0);
    raw_store(words + 224, 0);
    raw_store(words + 232, 0);
    raw_store(words + 240, 0);
    raw_store(words + 248, 0);
    raw_syscall(38, 2, words + 224, 0);
    cap := raw_load(page + 16);
    mut count = raw_atomic_load(page + 24);
    if cap < count {
        count = cap;
    }
    fd := rt_create_file(words + 128, 524865, 438);
    if rt_error(fd) {
        return 0;
    }
    // "GRPROF2\n" then rate, capacity, count, dropped and the CPU nanoseconds the samples cover:
    // the rate a caller asks for is capped by the kernel's timer granularity, so the report derives
    // the effective rate from this measurement instead of assuming the request was honoured.
    // "GRPROF3\n" for samples with their callers, `page + 56` words each.
    h := words + 352;
    depth := raw_load(page + 56);
    if depth < 2 {
        raw_store(h, 734726995712168519);
    } else {
        raw_store(h, 735008470688879175);
    }
    raw_store(h + 8, raw_load(page + 40));
    raw_store(h + 16, cap);
    raw_store(h + 24, count);
    raw_store(h + 32, raw_atomic_load(page + 32));
    mut cpu = 0;
    ts := words + 608;
    if rt_error(rt_syscall_low(228, 2, ts, 0)) == 0 {
        cpu = raw_load(ts) * 1000000000 + raw_load(ts + 8) - raw_load(page + 48);
    }
    raw_store(h + 40, cpu);
    if rt_write_all_low(fd, h, 48) == 0 {
        mut words_each = depth;
        if words_each < 2 {
            words_each = 1;
        }
        rt_write_all_low(fd, raw_load(page + 8), count * 8 * words_each);
    }
    rt_close_file(fd);
    return 0;
}

// ---- fused multiply-add in software (docs/design/simd.md, S4: `mul_add`) ------------------------
// a * b + c with one rounding, on the bit patterns of IEEE binary64 (rt_fma64) or binary32 (rt_fma32)
// values, for the targets with no fused instruction at the build's CPU level (baseline x86-64; C's
// fma() does the same in software there). Integer arithmetic only: the exact product of the two
// significands is 128 bits wide, `c` is aligned to it with a sticky bit, the sum is rounded once to
// nearest-even, with subnormals and overflow. Exponents are kept offset by RT_FMA_OFF so that they
// stay non-negative. A NaN result is the default quiet NaN (NaN payloads are not promised).
const RT_FMA_OFF: u64 = 8192;

// The position of the highest set bit of the 128-bit value hi:lo (not zero).
fn rt_u128_top(hi: u64, lo: u64) -> u64 {
    mut w = lo;
    mut base = 0;
    if hi != 0 {
        w = hi;
        base = 64;
    }
    mut p: u64 = 63;
    while ((w >> p) & 1) == 0 {
        p = p - 1;
    }
    return base + p;
}
fn rt_shl_hi(hi: u64, lo: u64, n: u64) -> u64 {
    if n == 0 {
        return hi;
    }
    if n >= 64 {
        return lo << (n - 64);
    }
    return (hi << n) | (lo >> (64 - n));
}
fn rt_shl_lo(lo: u64, n: u64) -> u64 {
    if n >= 64 {
        return 0;
    }
    return lo << n;
}
// hi:lo shifted right by n; the low word ORs in a 1 if any set bit was shifted out (the sticky bit).
fn rt_shr_hi(hi: u64, n: u64) -> u64 {
    if n >= 64 {
        return 0;
    }
    return hi >> n;
}
fn rt_shr_lo(hi: u64, lo: u64, n: u64) -> u64 {
    if n == 0 {
        return lo;
    }
    if n >= 128 {
        return u64((hi | lo) != 0);
    }
    mut kept = 0;
    mut lost = 0;
    if n >= 64 {
        kept = hi >> (n - 64);
        lost = lo;
        if n > 64 {
            lost = lost | (hi << (128 - n));
        }
    } else {
        kept = (lo >> n) | (hi << (64 - n));
        lost = lo << (64 - n);
    }
    return kept | u64(lost != 0);
}
// The bits of sign * M * 2^(E - RT_FMA_OFF), M = hi:lo != 0, rounded to nearest-even in a format of
// `prec` significand bits, the subnormal exponent `emin` (offset), the exponent field's all-ones
// value `fmax`, and the sign at bit `sbit`.
fn rt_fma_round(sign: u64, hi: u64, lo: u64, e: u64, prec: u64, emin: u64, fmax: u64, sbit: u64) -> u64 {
    t := rt_u128_top(hi, lo);
    mut l = e + t;
    if l < emin + prec - 1 {
        l = emin;
    } else {
        l = l - (prec - 1);
    }
    mut q = 0;
    if l < e {
        // Exact: the value has fewer bits than the format below its lowest one.
        q = rt_shl_lo(lo, e - l);
    } else {
        sh := l - e;
        mut round = 0;
        mut sticky = 0;
        q = lo;
        if sh > 0 {
            below := rt_fma_below(hi, lo, sh - 1);
            exact := rt_fma_exact_shr(hi, lo, sh);
            q = exact;
            round = rt_fma_bit(hi, lo, sh - 1);
            sticky = below;
        }
        if (round == 1) && ((sticky == 1) || ((q & 1) == 1)) {
            q = q + 1;
        }
    }
    if q == (1 << prec) {
        q = q >> 1;
        l = l + 1;
    }
    mut out = sign << sbit;
    if q >= (1 << (prec - 1)) {
        field := l - emin + 1;
        if field >= fmax {
            return out | (fmax << (prec - 1));
        }
        return out | (field << (prec - 1)) | (q - (1 << (prec - 1)));
    }
    return out | q;
}
// Bit n of hi:lo.
fn rt_fma_bit(hi: u64, lo: u64, n: u64) -> u64 {
    if n >= 128 {
        return 0;
    }
    if n >= 64 {
        return (hi >> (n - 64)) & 1;
    }
    return (lo >> n) & 1;
}
// 1 if any bit of hi:lo below bit n is set.
fn rt_fma_below(hi: u64, lo: u64, n: u64) -> u64 {
    if n == 0 {
        return 0;
    }
    if n >= 128 {
        return u64((hi | lo) != 0);
    }
    if n >= 64 {
        if lo != 0 {
            return 1;
        }
        if n == 64 {
            return 0;
        }
        return u64((hi << (128 - n)) != 0);
    }
    return u64((lo << (64 - n)) != 0);
}
// hi:lo >> n, n >= 1, as one word (the caller knows it fits).
fn rt_fma_exact_shr(hi: u64, lo: u64, n: u64) -> u64 {
    if n >= 128 {
        return 0;
    }
    if n >= 64 {
        return hi >> (n - 64);
    }
    return (lo >> n) | (hi << (64 - n));
}
// The fused multiply-add on bit patterns of a format with `prec` significand bits, an exponent field
// of all-ones value `fmax`, the subnormal lsb exponent `emin` (offset) and the sign at bit `sbit`.
fn rt_fma_bits(a: u64, b: u64, c: u64, prec: u64, fmax: u64, emin: u64, sbit: u64) -> u64 {
    fmask := (1 << (prec - 1)) - 1;
    nan := (fmax << (prec - 1)) | (1 << (prec - 2));
    inf := fmax << (prec - 1);
    sa := (a >> sbit) & 1;
    sb := (b >> sbit) & 1;
    sc := (c >> sbit) & 1;
    fa := (a >> (prec - 1)) & fmax;
    fb := (b >> (prec - 1)) & fmax;
    fc := (c >> (prec - 1)) & fmax;
    ma0 := a & fmask;
    mb0 := b & fmask;
    mc0 := c & fmask;
    sp := sa ^ sb;
    // NaNs and infinities.
    if ((fa == fmax) && (ma0 != 0)) || ((fb == fmax) && (mb0 != 0)) || ((fc == fmax) && (mc0 != 0)) {
        return nan;
    }
    azero := (fa == 0) && (ma0 == 0);
    bzero := (fb == 0) && (mb0 == 0);
    czero := (fc == 0) && (mc0 == 0);
    pinf := (fa == fmax) || (fb == fmax);
    if pinf {
        if azero || bzero {
            return nan;
        }
        if (fc == fmax) && (sc != sp) {
            return nan;
        }
        return (sp << sbit) | inf;
    }
    if fc == fmax {
        return c;
    }
    if azero || bzero {
        // An exact zero product: c, except that two zeros sum to -0 only when both are negative.
        if czero {
            return (sp & sc) << sbit;
        }
        return c;
    }
    // Significands with the implicit bit, and the exponent of their lowest bit (offset).
    mut ma = ma0;
    mut la = emin;
    if fa != 0 {
        ma = ma0 | (1 << (prec - 1));
        la = emin + fa - 1;
    }
    mut mb = mb0;
    mut lb = emin;
    if fb != 0 {
        mb = mb0 | (1 << (prec - 1));
        lb = emin + fb - 1;
    }
    // The exact product ma * mb, 128 bits, from 32-bit halves.
    a1 := ma >> 32;
    a0 := ma & 4294967295;
    b1 := mb >> 32;
    b0 := mb & 4294967295;
    p00 := a0 * b0;
    mid := a0 * b1 + a1 * b0;
    p11 := a1 * b1;
    plo := wrapping_add(p00, mid << 32);
    mut carry = 0;
    if plo < p00 {
        carry = 1;
    }
    phi := p11 + (mid >> 32) + carry;
    lp := la + lb - RT_FMA_OFF;
    if czero {
        return rt_fma_round(sp, phi, plo, lp, prec, emin, fmax, sbit);
    }
    mut mc = mc0;
    mut lc = emin;
    if fc != 0 {
        mc = mc0 | (1 << (prec - 1));
        lc = emin + fc - 1;
    }
    // Both to the top bit at 125 (two bits of headroom for the carry).
    tp := rt_u128_top(phi, plo);
    tc := rt_u128_top(0, mc);
    xh := rt_shl_hi(phi, plo, 125 - tp);
    xl := rt_shl_lo(plo, 125 - tp);
    xe := lp + tp - 125;
    yh := rt_shl_hi(0, mc, 125 - tc);
    yl := rt_shl_lo(mc, 125 - tc);
    ye := lc + tc - 125;
    // The one with the larger exponent is the larger in magnitude; on a tie, compare.
    mut bigx = true;
    if (ye > xe) || ((ye == xe) && ((yh > xh) || ((yh == xh) && (yl > xl)))) {
        bigx = false;
    }
    mut gh = xh;
    mut gl = xl;
    mut ge = xe;
    mut gs = sp;
    mut sh_ = yh;
    mut sl = yl;
    mut se = ye;
    if !bigx {
        gh = yh;
        gl = yl;
        ge = ye;
        gs = sc;
        sh_ = xh;
        sl = xl;
        se = xe;
    }
    d := ge - se;
    th := rt_shr_hi(sh_, d);
    tl := rt_shr_lo(sh_, sl, d);
    mut rh = 0;
    mut rl = 0;
    if sp == sc {
        rl = wrapping_add(gl, tl);
        mut cy = 0;
        if rl < gl {
            cy = 1;
        }
        rh = gh + th + cy;
    } else {
        rl = wrapping_sub(gl, tl);
        mut bw = 0;
        if gl < tl {
            bw = 1;
        }
        rh = gh - th - bw;
    }
    if (rh == 0) && (rl == 0) {
        // Exact cancellation: +0 when rounding to nearest.
        return 0;
    }
    return rt_fma_round(gs, rh, rl, ge, prec, emin, fmax, sbit);
}
fn rt_fma64(a: u64, b: u64, c: u64) -> u64 {
    return rt_fma_bits(a, b, c, 53, 2047, RT_FMA_OFF - 1074, 63);
}
fn rt_fma32(a: u64, b: u64, c: u64) -> u64 {
    return rt_fma_bits(a & 4294967295, b & 4294967295, c & 4294967295, 24, 255, RT_FMA_OFF - 149, 31);
}
