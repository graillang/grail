// ---- narrow vectors: f32[], u32[], i32[] store 4-byte elements ----
// Each element is one 32-bit little-endian unit, reached with a single raw_load32/raw_store32 (a
// zero-extending load and a 32-bit store on every target).
// The compiler encodes each value before it reaches these routines (an f32 as its binary32 bits;
// an integer's low 32 bits are stored) and decodes what they return, so they only move 32-bit units.
// len and cap count elements. Ordering and equality compare the 32-bit units unsigned, which orders
// exactly as the words the same values occupy in a word vector.
// A push of a 4-byte element, as rt_push for words: the common case - room in the buffer - is a
// store and a length bump, small enough for the LLVM backend to inline at every push (a `_slow`
// function is never inlined, so growing stays out of it).
fn rt_push4(s: u64, v: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    if n == raw_load(wrapping_add(s, 16)) {
        return rt_push4_slow(s, v);
    }
    raw_store32(wrapping_add(raw_load(s), wrapping_mul(n, 4)), v);
    raw_store(wrapping_add(s, 8), wrapping_add(n, 1));
    return 0;
}
// Doubling, from 8 elements, then the push.
fn rt_push4_slow(s: u64, v: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    cap := raw_load(wrapping_add(s, 16));
    mut capacity = cap * 2;
    if capacity == 0 {
        capacity = 8;
    }
    if 288230376151711744 < capacity {
        rt_abort();
    }
    ptr := rt_grow(raw_load(s), n * 4, capacity * 4);
    raw_store(s, ptr);
    raw_store(wrapping_add(s, 16), capacity);
    raw_store32(wrapping_add(ptr, wrapping_mul(n, 4)), v);
    raw_store(wrapping_add(s, 8), n + 1);
    return 0;
}
fn rt_fill4(s: u64, v: u64, n: u64) -> u64 {
    if 288230376151711744 < n {
        rt_abort();
    }
    if n != 0 {
        ptr := rt_grow(raw_load(s), 0, n * 4);
        raw_store(s, ptr);
        raw_store(wrapping_add(s, 16), n);
    }
    mut i: u64 = 0;
    while i < n {
        raw_store32(wrapping_add(raw_load(s), wrapping_mul(i, 4)), v);
        i = i + 1;
    }
    raw_store(wrapping_add(s, 8), n);
    return 0;
}
fn rt_slot4u(s: u64, i: u64) -> u64 {
    return wrapping_add(raw_load(s), wrapping_mul(i, 4));
}
fn rt_slot4(s: u64, i: u64) -> u64 {
