// The address of element `i` of an array of `n` elements `w` bytes wide at `base`
// (docs/design/fixed-arrays.md). `n` is the array's constant length: nothing is loaded to check it.
fn rt_aslot(base: u64, i: u64, n: u64, w: u64) -> u64 {
    if (i < n) == 0 {
        rt_fail(1, i, n);
    }
    return wrapping_add(base, wrapping_mul(i, w));
}
// The same address for an index already known to be below the length.
fn rt_aslotu(base: u64, i: u64, w: u64) -> u64 {
    return wrapping_add(base, wrapping_mul(i, w));
}
// A slice {base + a*w, b - a} of an array of `n` elements (docs/design/fixed-arrays.md): a view
// record, as a vector's sub-slice is; a <= b <= n.
fn rt_aslice(base: u64, a: u64, b: u64, w: u64, n: u64) -> u64 {
    if (b < a) + (n < b) {
        rt_fail(7, a, b);
