    mut negative = 0;
    if ((code / 256) & 1) & rt_int_neg(v) {
        negative = 1;
        x = wrapping_sub(0, v);
    }
    // Halve below 2^53 with a sticky low bit, convert exactly, rescale, then round once.
    mut s = 0;
    while 9007199254740991 < x {
        lost := x & 1;
        x = rt_div(x, 2);
        if lost {
            x = x | 1;
        }
        s += 1;
    }
    mut f = raw_f64_from_i64(x);
    if (s != 0) & (x != 0) {
        f = f + s * 4503599627370496;
    }
    out := rt_f32_round(f);
    if negative {
        return rt_f64_neg(out);
    }
    return out;
}
// Shortest decimal digits that read back to the same binary32 (like Rust's Display for f32).
fn rt_fmt_f32(acc: u64, v: u64) -> u64 {
    if raw_feq(v, v) == 0 {
        return rt_push_text(acc, 78, 97, 78);
    }
    if 9223372036854775807 < v {
        rt_pushb(acc, 45);
    }
    e64 := rt_div(v, 4503599627370496) & 2047;
    frac := v & 4503599627370495;
    if e64 == 2047 {
        return rt_push_text(acc, 105, 110, 102);
    }
    if (e64 == 0) & (frac == 0) {
        rt_pushb(acc, 48);
        return 0;
    }
    if 896 < e64 {
        e32 := e64 - 896;
        fraction := rt_div(frac, 536870912);
        f := fraction + 8388608; // value = f * 2^(e32-150)
        if e32 < 150 {
            return rt_fmt_shortest(acc, f, 150 - e32, 1, (fraction == 0) & (1 < e32));
        }
        return rt_fmt_shortest(acc, f, e32 - 150, 0, fraction == 0);
    }
    f := (frac + 4503599627370496) >> (926 - e64); // binary32 subnormal: value = f * 2^-149
    return rt_fmt_shortest(acc, f, 149, 1, 0);
