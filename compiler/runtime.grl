// UTF-8 text to scalar values; malformed sequences become U+FFFD.
fn rt_seq_chars(a: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    mut i = 0;
    while i < n {
        b := rt_atb(a, i);
        mut need = 0;
        mut cp = b;
        mut min = 0;
        if b < 128 {
            need = 0;
        } else {
            if (b & 224) == 192 {
                need = 1;
                cp = b & 31;
                min = 128;
            } else {
                if (b & 240) == 224 {
                    need = 2;
                    cp = b & 15;
                    min = 2048;
                } else {
                    if (b & 248) == 240 {
                        need = 3;
                        cp = b & 7;
                        min = 65536;
                    } else {
                        need = 99;
