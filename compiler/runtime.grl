unsafe module runtime;

// Abort: the process dies here and control never returns to the caller, not even when a foreign
// frame called in (a C callback that aborts). The rule is "abort never unwinds, and nothing may
// unwind across the C boundary": no atexit handler, C++ destructor, DLL detach, stack unwind or
// foreign cleanup of any kind runs. rt_hard_exit is the platform's cleanup-free exit (exit_group,
// TerminateProcess, _exit), because exit(2) would run foreign cleanup. This is the only abort entry
// point in the runtime.
//
// Exactly one thread reports and exits. Several tasks can fail at the same time (eight parallel
// chunks all writing one past their own slice is the regression fixture), and a racing second
// reporter used to print its own message and then raise its own SIGABRT. A signal sent to the
// process is delivered to whichever thread the kernel picks - often a parked worker returning to
// user space - so the process died by SIGABRT instead of the 134 exit the contract promises. Now a
// single atomic claim word decides the reporter; every other failing thread parks on that word
// forever, and the reporter's exit ends the process.
//
// SIGABRT is raised only from the main thread, where it is the documented, deterministic outcome
// (a parent sees the signal). A runtime thread does not raise it: it would race the hard exit for
// the same reason, and the abort status 134 is what a task or pool failure promises.
fn rt_abort_claim() -> u64 {
    return raw_state() + 3456;
}
fn rt_abort_begin() -> u64 {
    return raw_atomic_cas(rt_abort_claim(), 0, 1) == 0;
}
// Never returns: nothing wakes this word, and the reporter's exit_group/TerminateProcess ends the
// process. Parking instead of spinning keeps the other workers of a failing program off the CPU.
fn rt_abort_park() -> u64 {
    while true {
        rt_syscall(202, rt_abort_claim(), 128, 1);
    }
    return 0;
}
fn rt_abort_final() -> u64 {
    rt_prof_dump();
    if rt_abort_signals() != 0 {
        rt_syscall(62, rt_syscall(39, 0, 0, 0), 6, 0);
    }
    rt_hard_exit(134);
    return 0;
}
// Whether this failure is reported as SIGABRT. A thread the runtime created to run tasks and
// jobs opens the possibility of two such threads failing at once, and a process-wide signal from
// one of them may be delivered to a parked sibling before the hard exit runs, turning the promised
// status 134 into death by SIGABRT. Those threads therefore exit directly; the main thread, an
// offload thread and a thread foreign code created keep the signal (record word 24 is non-zero only
// on a runtime worker, see rt_thread_start, and on any other thread while it is inside a parallel
// region, where it runs leaves beside the workers: rt_region_step).
fn rt_abort_signals() -> u64 {
    w := raw_tp_get();
    if w == 0 {
        return 1;
    }
    return raw_load(w + 24) == 0;
}
fn rt_abort() -> u64 {
    if rt_abort_begin() == 0 {
        rt_abort_park();
    }
    return rt_abort_final();
}
// A task ran past the bottom of its stack into the guard page. The platform calls this from its
// fault handler (a POSIX signal handler on the alternate stack, a Windows vectored exception
// handler), so it may neither allocate nor take the allocator lock: the message goes into
// process-state scratch and straight to fd 2, and the exit goes through the same one-reporter claim
// as a failed runtime check. The stack pointer is already at the guard, so a normal report that
// walks frames could not run.
fn rt_stack_overflow() -> u64 {
    return rt_stack_overflow_at(0);
}
// The report both fault paths share: one claim, `error: stack overflow`, and the cleanup-free exit
// at 134. `site` is the statement-table entry of the interrupted instruction, or 0 when the path
// cannot name one - the message is printed either way, because the message is the point, and the
// location follows it as a second line (` --> file:line:col`) in the shape every other report uses.
// A task's stack reports its message alone, exactly as it always has; the main thread's, whose
// frames are still intact but unreachable, names the statement it faulted in.
//
// Nothing is allocated here: the message goes into process-state scratch a byte at a time (a
// literal passed as a `string` in this module would be a heap value), the location line into the
// report block beside it, and both leave through the raw write and hard exit the one-reporter claim
// already promises.
fn rt_stack_overflow_at(site: u64) -> u64 {
    if rt_abort_begin() == 0 {
        rt_abort_park();
    }
    words := rt_state_stack_guard();
    text := view("error: stack overflow\n");
    mut n = 0;
    for i in text.len() {
        raw_putbyte(words + 16 + n, u64(text[i]));
        n = n + 1;
    }
    rt_write_all(2, words + 16, n);
    if site != 0 {
        n = rt_stack_report_line(site);
        if n != 0 {
            rt_write_all(2, rt_stack_report_words() + 48, n);
        }
    }
    rt_hard_exit(134);
    return 0;
}
// ---- runtime errors ----------------------------------------------------------------------------
// A check that fails stops the program the way it always has (SIGABRT, exit status 134), but first
// says what failed and where, then names its callers, as a Rust panic does:
//     error: index 7 out of bounds for length 3
//      --> src/main.grl:2:12
//      = called from src/main.grl:9:5
// The locations come from the table of statement positions the compiler emits (section
// `grail_sites`, see native.grl site_table; on Windows it lives in grouped PE sections): the
// frame-pointer chain is walked outwards, and every frame whose return address falls in a statement
// outside the runtime adds a line. Without a table (debug builds, the LLVM backend, macOS) the
// message is printed alone.
// A check failed. Two outcomes, decided before the abort claim is touched:
//
//  * inside a green task, the failure is *contained*: it becomes a value at the task's join (see
//    docs/design/task-failure-containment.md) and the process keeps running. The task's stack is
//    discarded whole by the scheduler - no frame is unwound and no destructor runs, which is the
//    B5 rule applied to one task instead of the process. **Nothing is allocated here**: the failure
//    is recorded as numbers in the task record and left for the join to format, so a trap is safe
//    even where the allocator lock is held;
//  * anywhere else (the main thread, an offload thread, a C callback, thread-per-task mode) the
//    process ends exactly as it always has: one reporter, SIGABRT from the main thread, status 134.
//    The claim is taken before any text is built, so a second failing thread cannot garble the
//    report.
fn rt_fail(kind: u64, a: u64, b: u64) -> u64 {
    j := rt_job_failing();
    if j != 0 {
        return rt_job_fail(j, kind, a, b, rt_site_here(j + 200) & 18446744073709551614, 0, 0);
    }
    t := rt_containable();
    if t != 0 {
        return rt_contain_site(t, kind, a, b, rt_site_here(t + 200), 0);
    }
    if rt_abort_begin() == 0 {
        rt_abort_park();
    }
    return rt_report_die(rt_fail_body_text(kind, a, b), rt_fail_site_full());
}
// An inline check in compiled code failed (the compiler rewrote its `call rt_abort`): for an index
// check the vector is in `a` and the index in `b`.
fn rt_trap(a: u64, b: u64, kind: u64) -> u64 {
    if kind == 1 {
        return rt_fail(1, b, raw_load(wrapping_add(a, 8)));
    }
    return rt_fail(kind, a, b);
}
// The task whose failure this call may contain, or 0. Only the green scheduler has a containment
// point: a thread-per-task task owns its OS thread, so there is no scheduler frame to return to and
// that mode keeps the process abort.
fn rt_containable() -> u64 {
    t := rt_current();
    if t == 0 {
        return 0;
    }
    if rt_task_threads() != 0 {
        return 0;
    }
    // Inside a parallel region (word 152, the stack list, is not empty) a failure is not contained
    // here: it goes through rt_job_fail first, which drains the stack's forks - a stolen child may be
    // borrowing its frames - and empties the list before it contains the task.
    if raw_load(t + 152) != 0 {
        return 0;
    }
    return t;
}
// The message body of a check failure, as an owned text: the same words the report prints, without
// the `error: ` prefix and without the location lines.
fn rt_fail_body_text(kind: u64, a: u64, b: u64) -> u64 {
    s := rt_new();
    rt_reserveb(s, rt_fail_limit() + 196);
    buf := raw_load(s);
    n := rt_fail_body(kind, a, b, buf, 0);
    raw_store(s + 8, n);
    return s;
}
// The location line ` --> file:line:col` of a captured site entry, as an owned text; empty when the
// program carries no statement table or the entry names no place.
fn rt_site_text(entry: u64) -> u64 {
    s := rt_new();
    rt_reserveb(s, 400);
    mut n = 0;
    if entry != 0 {
        n = rt_fail_line(raw_load(s), 0, entry, " --> ");
    }
    raw_store(s + 8, n);
    return s;
}
// Every location line the report prints: ` --> ` for the failing statement, then one
// ` = called from ` line per further frame that lies in a statement. The dying report uses this,
// because the frames are still there; a value a join carries gets the innermost line only, since
// the frames it would need are gone by the time a program reads it.
fn rt_fail_site_full() -> u64 {
    s := rt_new();
    rt_reserveb(s, rt_fail_limit() + 196);
    n := rt_fail_where(raw_load(s), 0);
    raw_store(s + 8, n);
    return s;
}
// ---- the call-site descriptor: the compiler's helper, and the room it is given ----------------
// The program's entry publishes, in state word 3400, the address of a helper the compiler emits
// beside the two tables it builds (native.grl site_table). It is the one handshake in this runtime
// where generated code fills a buffer the runtime owns, and it carries its length:
//
//     words_written = rt_sites(out, capacity_words)
//
// The descriptor is append-only, so any prefix of it is meaningful:
//
//     0 __start_grail_sites   8 __stop_grail_sites   16 the caller's frame pointer
//    24 __start_grail_funcs  32 __stop_grail_funcs
//
// The helper writes the first three words - the statement table and the frame, all rt_site_here
// needs - and the last two as well when it is offered room for five, and it answers how many words
// it wrote. It never writes more than it was offered, with one deliberate exception: an offer of
// **zero** means "this caller predates the capacity argument", and is answered with the three words
// that every runtime since the statement table existed has room for. That exception is the whole
// compatibility direction: a checked-in seed's runtime calls `helper(scratch, 0)` on a 24-byte
// scratch, so a helper emitted by newer code must answer three words and not five, or it writes
// past that scratch into whatever follows it - which is exactly the 16-byte overrun that corrupted
// an allocator header (docs/design/task-failure-containment.md).
//
// The other direction - a runtime newer than the helper that compiled it - is answered by the
// count: a helper emitted before this argument existed writes its words and answers nothing (rax 0
// from the `xorq %rax,%rax` every emitted helper ends with on that path), so 0 is read as "the five
// words this runtime offered", which is what such a helper writes. rt_sites_fill clears the two
// function-table words first, so a helper that writes only three leaves them zero rather than the
// block's previous contents, and "this build has no function table" stays a fact instead of a guess.
//
// Nothing is read past the count: `have` is what the caller may read, and 0 means the descriptor was
// refused - no helper, fewer words than a statement entry needs, or a count larger than the offer
// (a helper that ignored its capacity). Refusing loses the location line; reading on would walk a
// table that is not there.
fn rt_sites_words() -> u64 {
    return 5;
}
// The capacity this runtime offers the helper. Five words, so the descriptor is one shape for every
// caller and rt_backtrace gets the function table. A test injects a smaller offer through
// GRAIL_RT_SITES_OFFER (read once, kept in state word 3408) to prove the refusal is taken rather
// than assumed; the values are 0 "not asked", 1 "no override", n+1 "an offer of n words".
fn rt_sites_offer() -> u64 {
    mut mode = raw_load(rt_state_sites_offer());
    if mode == 0 {
        mode = 1;
        want := rt_sites_offer_env();
        if (0 < want) & (want < 4096) {
            mode = want + 1;
        }
        raw_store(rt_state_sites_offer(), mode);
    }
    if mode == 1 {
        return rt_sites_words();
    }
    return mode - 1;
}
// The decimal value of GRAIL_RT_SITES_OFFER, or 0. It reads envp directly, as rt_comptime_on does,
// because the offer is asked on a failure path, where the runtime is not allowed to allocate.
fn rt_sites_offer_env() -> u64 {
    envp := raw_load(raw_state() + 16);
    if envp == 0 {
        return 0;
    }
    name := view("GRAIL_RT_SITES_OFFER=");
    ptr := raw_load(name);
    len := raw_load(wrapping_add(name, 8));
    mut i = 0;
    while raw_load(envp + i * 8) != 0 {
        e := raw_load(envp + i * 8);
        mut k = 0;
        while k < len {
            if raw_byte(e + k) != raw_byte(ptr + k) {
                break;
            }
            k = k + 1;
        }
        if k == len {
            return rt_sites_offer_digits(e + len);
        }
        i = i + 1;
    }
    return 0;
}
fn rt_sites_offer_digits(p: u64) -> u64 {
    mut v = 0;
    mut i = 0;
    while i < 8 {
        d := raw_byte(p + i);
        if (d < 48) || (57 < d) {
            break;
        }
        v = v * 10 + d - 48;
        i = i + 1;
    }
    return v;
}
// Fill the descriptor at `out` - rt_sites_words() words of the caller's own buffer - from the
// program's helper, and answer how many of those words may be read. 0 means the descriptor was
// refused: no helper, fewer words than a statement entry needs, or a count larger than the offer.
// The two function-table words are cleared first, so a helper that writes only the first three
// leaves zeros there instead of the memory's previous contents.
fn rt_sites_fill(out: u64) -> u64 {
    helper := raw_load(raw_state() + 3400);
    if helper == 0 {
        return 0;
    }
    raw_store(out + 24, 0);
    raw_store(out + 32, 0);
    cap := rt_sites_offer();
    written := raw_call2(helper, out, cap);
    mut have = written;
    if have == 0 {
        // A helper emitted before this handshake carried a count answers nothing and writes the
        // words it always wrote. The offer says how many those are: this runtime asked for the
        // whole five-word descriptor, so five is what it wrote.
        have = cap;
    }
    if cap < have {
        return 0;
    }
    if have < 3 {
        return 0;
    }
    return have;
}
// The innermost statement entry of the frame that failed, found through the same rbp walk the
// report uses, and written through `scratch` so the walk allocates nothing. `scratch` is the
// descriptor buffer of rt_sites_words() words that rt_sites_fill fills - both tables' bounds and the
// caller's frame, then the function table's - and the walk reads only the first three, bounded by
// the count the helper answered. A captured entry is static data: it stays valid long after the
// task's stack is gone, which is what lets the join format the site later.
fn rt_site_here(scratch: u64) -> u64 {
    have := rt_sites_fill(scratch);
    if have < 3 {
        return 0;
    }
    begin := raw_load(scratch);
    end := raw_load(scratch + 8);
    if (begin == 0) + (end <= begin) {
        return 0;
    }
    mut frame = raw_load(scratch + 16);
    mut depth = 0;
    while (frame != 0) & (depth < 64) {
        ret := raw_load(frame + 8);
        mut hit = 0;
        mut hit_at = 0;
        mut e = begin;
        while e < end {
            a := raw_load(e);
            // Strictly before: a return address is the instruction *after* the call, so when the
            // call is its statement's last instruction that address is the next statement's label.
            mut take = a < ret;
            if take && (hit != 0) {
                take = hit_at < a;
            }
            if take {
                hit = e;
                hit_at = a;
            }
            e = e + 24;
        }
        if hit != 0 {
            name := raw_load(hit + 8);
            flags := raw_load(hit + 16);
            // A place is named only when the entry has a file; the runtime's own statements carry a
            // zero, so the walk always answers with a program location.
            if (name != 0) & ((flags >> 63) == 0) {
                return hit;
            }
        }
        frame = raw_load(frame);
        depth = depth + 1;
    }
    return 0;
}
// The retained check kinds' text, written at `buf` (+n) without the `error: ` prefix.
fn rt_fail_body(kind: u64, a: u64, b: u64, buf: u64, n: u64) -> u64 {
    mut at = n;
    if kind == 1 {
        at = rt_fail_put(buf, at, "index ");
        at = rt_fail_num(buf, at, a);
        at = rt_fail_put(buf, at, " out of bounds for length ");
        at = rt_fail_num(buf, at, b);
    } else if kind == 2 {
        at = rt_fail_put(buf, at, "arithmetic overflow");
    } else if kind == 3 {
        at = rt_fail_put(buf, at, "negative value converted to an unsigned type");
    } else if kind == 4 {
        at = rt_fail_put(buf, at, "value has no matching variant");
    } else if kind == 5 {
        at = rt_fail_put(buf, at, "division by zero");
    } else if kind == 6 {
        at = rt_fail_put(buf, at, "unwrap of None or Err");
    } else if kind == 7 {
        at = rt_fail_put(buf, at, "range ");
        at = rt_fail_num(buf, at, a);
        at = rt_fail_put(buf, at, "..");
        at = rt_fail_num(buf, at, b);
        at = rt_fail_put(buf, at, " out of bounds");
    } else if kind == 8 {
        at = rt_fail_put(buf, at, "pop from an empty vector");
    } else if kind == 9 {
        at = rt_fail_put(buf, at, "byte value ");
        at = rt_fail_num(buf, at, a);
        at = rt_fail_put(buf, at, " does not fit in u8");
    } else if kind == 10 {
        at = rt_fail_put(buf, at, "C array length mismatch: got ");
        at = rt_fail_num(buf, at, a);
        at = rt_fail_put(buf, at, " elements for an array of ");
        at = rt_fail_num(buf, at, b);
    } else if kind == 11 {
        at = rt_fail_put(buf, at, "index out of bounds");
    } else if kind == 12 {
        at = rt_fail_put(buf, at, "assertion failed");
    } else if kind == 13 {
        at = rt_fail_put(buf, at, "the task failed");
    } else if kind == 14 {
        // A conversion whose value the target type cannot hold: `u8(300)`. The type is the code
        // `rt_int_cast` was given, so the report names it the way the source did.
        at = rt_fail_put(buf, at, "value ");
        at = rt_fail_num(buf, at, a);
        at = rt_fail_put(buf, at, " does not fit in ");
        at = rt_fail_type(buf, at, b);
    } else if kind == 15 {
        // The same, for a negative value and a signed target, where the word in the register is the
        // two's-complement of the number the program wrote.
        at = rt_fail_put(buf, at, "value -");
        at = rt_fail_num(buf, at, a);
        at = rt_fail_put(buf, at, " does not fit in ");
        at = rt_fail_type(buf, at, b);
    } else if kind == 16 {
        at = rt_fail_put(buf, at, "a parallel split needs a grain of at least one element");
    } else {
        at = rt_fail_put(buf, at, "the program aborted");
    }
    return at;
}
// An integer type's source name from its runtime code: the size is the low byte, the signedness is
// bit 8 (`rt_int_cast`), so 8 is `u8` and 264 is `i8`.
fn rt_fail_type(buf: u64, at: u64, code: u64) -> u64 {
    mut out = at;
    if ((code / 256) & 1) != 0 {
        out = rt_fail_put(buf, out, view("i"));
    } else {
        out = rt_fail_put(buf, out, view("u"));
    }
    return rt_fail_num(buf, out, code & 255);
}
// The dying report: `error: ` message, a newline, then the location line, and the cleanup-free
// exit. Reached with the abort claim already taken.
fn rt_report_die(msg: u64, site: u64) -> u64 {
    rt_write_text(2, view("error: "));
    rt_write_text(2, msg);
    rt_write_text(2, view("\n"));
    rt_write_text(2, site);
    return rt_abort_final();
}
// Containment: the failure is written into the task record and control returns to the scheduler on
// the worker's stack. The frames of this stack are dead from here on; the scheduler takes its
// ordinary "this task is done" path, so the mapping is recycled and the task is published to its
// joiner. Nothing in between is resumed or cleaned up.
fn rt_contain_site(t: u64, kind: u64, a: u64, b: u64, site: u64, msg: u64) -> u64 {
    raw_store(t + 160, kind);
    raw_store(t + 168, a);
    raw_store(t + 176, b);
    // Bit 0 of the site word stays clear: what is stored is a statement-table entry, not a text.
    raw_store(t + 184, site & 18446744073709551614);
    raw_store(t + 192, msg);
    return rt_contain_tail(t);
}
// The same, for a failure that already has its texts (a `join` inside a task re-raising a task's
// recorded failure): the words are handed over, not rebuilt.
fn rt_contain_text(t: u64, kind: u64, msg: u64, site: u64) -> u64 {
    raw_store(t + 160, kind);
    raw_store(t + 168, 0);
    raw_store(t + 176, 0);
    // Bit 0 marks the site word as an owned text, which is what the words are in this case.
    raw_store(t + 184, site | 1);
    raw_store(t + 192, msg);
    return rt_contain_tail(t);
}
fn rt_contain_tail(t: u64) -> u64 {
    rt_contained_note();
    raw_store(t + 144, 1);
    rt_os_ctx_leave(t);
    return 0;
}
// One word in process state: how many task failures were contained. The end-of-main leak check
// reads it (rt_leak_exit), because a discarded stack's owners are exactly the allocations nothing
// can free and no exact count of them exists.
fn rt_contained_word() -> u64 {
    return raw_state() + 3584;
}
fn rt_contained_note() -> u64 {
    raw_store(rt_contained_word(), raw_load(rt_contained_word()) + 1);
    return 0;
}
// How many stacks a contained failure discarded beyond the one it happened on (it was raised again
// at a join), for the same note: process-state word 3448.
fn rt_discarded_word() -> u64 {
    return raw_state() + 3448;
}
fn rt_contained() -> u64 {
    return raw_load(rt_contained_word());
}
fn rt_write_text(fd: u64, s: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    if n == 0 {
        return 0;
    }
    return rt_write_all(fd, raw_load(s), n);
}
// The point every failure-message writer stops at, so the buffer's own length is never a concern.
fn rt_fail_limit() -> u64 {
    return 3900;
}
// A literal at the call site is a heap value in this module and no dropper releases it; that is
// invisible to rt_fail, which ends the process, and rt_backtrace therefore writes its punctuation
// byte by byte instead of calling this.
fn rt_fail_put(buf: u64, n: u64, text: string) -> u64 {
    mut at = n;
    for i in text.len() {
        if at < rt_fail_limit() {
            raw_putbyte(buf + at, u64(text[i]));
            at = at + 1;
        }
    }
    return at;
}
fn rt_fail_num(buf: u64, n: u64, v: u64) -> u64 {
    mut digits = 0;
    mut x = v;
    while true {
        digits = digits + 1;
        x = x / 10;
        if x == 0 {
            break;
        }
    }
    if rt_fail_limit() < n + digits {
        return n;
    }
    mut y = v;
    mut k = digits;
    while 0 < k {
        k = k - 1;
        raw_putbyte(buf + n + k, 48 + y % 10);
        y = y / 10;
    }
    return n + digits;
}
// A refinement obligation failed (docs/design/refinements.md). The compiler emits both strings as
// data beside the check: the predicate's own text and ` = required by <fn> at <where>`. The location
// line is the call site - the frame above this function - exactly as a failed check reports it.
fn rt_refine(msg: u64, req: u64) -> u64 {
    if rt_abort_begin() == 0 {
        rt_abort_park();
    }
    buf := rt_alloc(1024);
    mut n = rt_fail_put(buf, 0, "error: refinement violated: ");
    mut i = 0;
    while (raw_byte(msg + i) != 0) & (n < rt_fail_limit() - 400) {
        raw_putbyte(buf + n, raw_byte(msg + i));
        n = n + 1;
        i = i + 1;
    }
    raw_putbyte(buf + n, 10);
    n = n + 1;
    n = rt_fail_where(buf, n);
    mut j = 0;
    while (raw_byte(req + j) != 0) & (n < rt_fail_limit()) {
        raw_putbyte(buf + n, raw_byte(req + j));
        n = n + 1;
        j = j + 1;
    }
    rt_write_all(2, buf, n);
    return rt_abort_final();
}
// ` --> file:line:col` for the frame that failed, then one ` = called from` line per further frame
// that lies in a statement - at most 32 of them.
fn rt_fail_where(buf: u64, n: u64) -> u64 {
    return rt_fail_where_mode(buf, n, 0);
}
// The innermost statement of the program's own code - not the runtime's, and not the standard
// library's (site flag bit 62) - as one line with `mark` in front, or nothing when no frame has one.
fn rt_fail_where_user(buf: u64, n: u64, mark: string) -> u64 {
    return rt_fail_where_mode(buf, n, 1);
}
fn rt_fail_where_mode(buf: u64, n: u64, user: u64) -> u64 {
    // The program's entry stores the compiler-emitted rt_sites in state word 3400; asked for the
    // descriptor (rt_sites_fill), it fills in the tables' bounds and the caller's frame pointer. No
    // table, a refused descriptor or zeros: no location lines.
    info := rt_alloc(rt_sites_words() * 8);
    have := rt_sites_fill(info);
    if have < 3 {
        rt_free(info);
        return n;
    }
    begin := raw_load(info);
    end := raw_load(info + 8);
    if (begin == 0) + (end <= begin) {
        rt_free(info);
        return n;
    }
    mut frame = raw_load(info + 16);
    mut depth = 0;
    mut lines = 0;
    mut at = n;
    while (frame != 0) & (depth < 64) & (lines < 32) {
        ret := raw_load(frame + 8);
        // The statement the return address is in: the entry with the greatest address not past it.
        // Its file is zero for code that names no place (a prologue, the runtime's own statements).
        mut hit = 0;
        mut hit_at = 0;
        mut e = begin;
        while e < end {
            a := raw_load(e);
            // Strictly before: a return address is the instruction *after* the call, so when the
            // call is its statement's last instruction that address is the next statement's label.
            mut take = a < ret;
            if take && (hit != 0) {
                take = hit_at < a;
            }
            if take {
                hit = e;
                hit_at = a;
            }
            e = e + 24;
        }
        if hit != 0 {
            name := raw_load(hit + 8);
            flags := raw_load(hit + 16);
            // A place is named only when the entry has a file. The writer marks the runtime's own
            // statements by leaving the file zero; a table written before that rule (the checked-in
            // seed is one) keeps the name and sets bit 63 instead, so both shapes skip the runtime -
            // a failure report names the program, never the runtime's frames.
            if (name != 0) & ((flags >> 63) == 0) & ((user == 0) | (((flags >> 62) & 1) == 0)) {
                if user != 0 {
                    at = rt_fail_line(buf, at, hit, " = in a job joined at ");
                    rt_free(info);
                    return at;
                }
                if lines == 0 {
                    at = rt_fail_line(buf, at, hit, " --> ");
                } else {
                    at = rt_fail_line(buf, at, hit, " = called from ");
                }
                lines = lines + 1;
            }
        }
        frame = raw_load(frame);
        depth = depth + 1;
    }
    return at;
}
// A NUL-terminated string at `p`, written up to the failure buffer's limit.
fn rt_fail_cstr(buf: u64, n: u64, p: u64) -> u64 {
    mut at = n;
    mut i = 0;
    while (raw_byte(p + i) != 0) & (at < rt_fail_limit()) {
        raw_putbyte(buf + at, raw_byte(p + i));
        at = at + 1;
        i = i + 1;
    }
    return at;
}
// One backtrace line: `mark`, then the entry's file, line and column.
fn rt_fail_line(buf: u64, n: u64, e: u64, mark: string) -> u64 {
    mut at = rt_fail_put(buf, n, mark);
    name := raw_load(e + 8);
    at = rt_fail_cstr(buf, at, name);
    flags := raw_load(e + 16);
    raw_putbyte(buf + at, 58);
    at = rt_fail_num(buf, at + 1, flags & 4294967295);
    raw_putbyte(buf + at, 58);
    // Bits 32..61 are the column; 62 marks a standard-library statement, 63 the runtime's.
    at = rt_fail_num(buf, at + 1, (flags >> 32) & 1073741823);
    raw_putbyte(buf + at, 10);
    return at + 1;
}
// The table entry with the greatest address not past `addr`, or 0 when the table names none.
// `stride` is 24 for a statement entry (address, file, line | column << 32) and 16 for a function
// entry (address, name).
fn rt_site_find(begin: u64, end: u64, addr: u64, stride: u64) -> u64 {
    mut hit = 0;
    mut hit_at = 0;
    mut e = begin;
    while e < end {
        a := raw_load(e);
        mut take = a <= addr;
        if take && (hit != 0) {
            take = hit_at < a;
        }
        if take {
            hit = e;
            hit_at = a;
        }
        e = e + stride;
    }
    return hit;
}
// The statement that was executing when a signal was raised, named by address instead of by
// walking frames: the caller is a fault handler, and the stack it would walk is the one that has
// just run out. The descriptor goes into the report block's first five words and the entry it
// answers with is static data, so nothing is allocated and nothing on the dead stack is touched.
// 0 when the build carries no table, the address falls outside it, or the entry names no place
// (the runtime's own statements leave the file zero; a table written before that rule sets bit 63).
fn rt_stack_site_for_pc(pc: u64) -> u64 {
    if pc == 0 {
        return 0;
    }
    info := rt_stack_report_words();
    have := rt_sites_fill(info);
    if have < 3 {
        return 0;
    }
    begin := raw_load(info);
    end := raw_load(info + 8);
    if (begin == 0) + (end <= begin) {
        return 0;
    }
    e := rt_site_find(begin, end, pc, 24);
    if have < 5 {
        // No function table to check against (a helper from before it existed): an entry that names
        // a place is all there is to go on.
        if rt_stack_site_names(e) == 0 {
            return 0;
        }
        return e;
    }
    fbegin := raw_load(info + 24);
    fend := raw_load(info + 32);
    if (fbegin == 0) + (fend <= fbegin) {
        return 0;
    }
    here := rt_site_find(fbegin, fend, pc, 16);
    if here == 0 {
        return 0;
    }
    if rt_stack_site_names(e) != 0 {
        if rt_site_find(fbegin, fend, raw_load(e), 16) == here {
            return e;
        }
    }
    // The entry the fault belongs to names no place, which is how the table spells a function's
    // entry: the prologue spills the parameters and sets up the frame, and a deep recursion usually
    // runs its stack out right there. So the report falls forward to the first statement of the
    // same function - the same function, because a function whose body has no statement must not
    // borrow its neighbour's place, and the runtime's own functions have no place to borrow.
    next := rt_site_find_next(begin, end, pc, 24);
    if rt_stack_site_names(next) == 0 {
        return 0;
    }
    if rt_site_find(fbegin, fend, raw_load(next), 16) != here {
        return 0;
    }
    return next;
}
// Whether a statement-table entry names a place: it carries a file and is not one of the runtime's
// own statements (written with no file; a table from before that rule sets bit 63 instead).
fn rt_stack_site_names(e: u64) -> u64 {
    if e == 0 {
        return 0;
    }
    if raw_load(e + 8) == 0 {
        return 0;
    }
    if (raw_load(e + 16) >> 63) != 0 {
        return 0;
    }
    return 1;
}
// ` --> file:line:col` and a newline for `site`, at offset 48 of the report block, answered with
// its length. rt_fail_line's shape, but bounded by that block instead of the failure buffer, and
// written byte at a time for the same reason rt_bt_line is: a literal passed as a `string` here
// would be a heap value, and this runs in a signal handler. A path that does not fit prints no line
// at all rather than a truncated one that names a file which does not exist.
fn rt_stack_report_line(site: u64) -> u64 {
    buf := rt_stack_report_words() + 48;
    cap := 192;
    name := raw_load(site + 8);
    mut len = 0;
    while (raw_byte(name + len) != 0) & (len < cap) {
        len = len + 1;
    }
    // " --> " (5), the path, ":line:col" (at most 22) and the newline.
    if (cap < len) | (cap < len + 28) {
        return 0;
    }
    raw_putbyte(buf, 32);
    raw_putbyte(buf + 1, 45);
    raw_putbyte(buf + 2, 45);
    raw_putbyte(buf + 3, 62);
    raw_putbyte(buf + 4, 32);
    mut at = 5;
    mut i = 0;
    while i < len {
        raw_putbyte(buf + at, raw_byte(name + i));
        at = at + 1;
        i = i + 1;
    }
    flags := raw_load(site + 16);
    raw_putbyte(buf + at, 58);
    at = rt_stack_report_num(buf, at + 1, cap, flags & 4294967295);
    raw_putbyte(buf + at, 58);
    at = rt_stack_report_num(buf, at + 1, cap, (flags >> 32) & 1073741823);
    raw_putbyte(buf + at, 10);
    return at + 1;
}
// rt_fail_num bounded by `cap` instead of the failure buffer's limit: the report block is 240
// bytes, and a number that would not fit is left out rather than written past it.
fn rt_stack_report_num(buf: u64, n: u64, cap: u64, v: u64) -> u64 {
    mut digits = 0;
    mut x = v;
    while true {
        digits = digits + 1;
        x = x / 10;
        if x == 0 {
            break;
        }
    }
    if cap < n + digits {
        return n;
    }
    mut y = v;
    mut k = digits;
    while 0 < k {
        k = k - 1;
        raw_putbyte(buf + n + k, 48 + y % 10);
        y = y / 10;
    }
    return n + digits;
}
// The table entry with the smallest address after `addr`, or 0 when none is: the statement that
// follows a positionless entry (a function's entry, the runtime's own code), which is how a fault in
// a prologue still finds the function it belongs to. rt_site_find's other half, with the same stride
// convention - 24 for a statement entry, 16 for a function entry - and strict on `addr`, so an entry
// at the fault address itself is not offered as the one after it.
fn rt_site_find_next(begin: u64, end: u64, addr: u64, stride: u64) -> u64 {
    mut hit = 0;
    mut hit_at = 0;
    mut e = begin;
    while e < end {
        a := raw_load(e);
        if addr < a {
            if (hit == 0) | (a < hit_at) {
                hit = e;
                hit_at = a;
            }
        }
        e = e + stride;
    }
    return hit;
}
// One stack line: `  at NAME (FILE:LINE:COL)`. The position is left off when the frame's return
// address is in a prologue, which the statement table enters with no file. The fixed text is written
// a byte at a time: a literal in this module becomes a heap value no dropper releases, which a
// capture that returns cannot afford (rt_fail_put's callers all end the process).
fn rt_bt_line(buf: u64, n: u64, name: u64, site: u64) -> u64 {
    raw_putbyte(buf + n, 32);
    raw_putbyte(buf + n + 1, 32);
    raw_putbyte(buf + n + 2, 97);
    raw_putbyte(buf + n + 3, 116);
    raw_putbyte(buf + n + 4, 32);
    mut at = rt_fail_cstr(buf, n + 5, name);
    if site == 0 {
        raw_putbyte(buf + at, 10);
        return at + 1;
    }
    file := raw_load(site + 8);
    if file == 0 {
        raw_putbyte(buf + at, 10);
        return at + 1;
    }
    raw_putbyte(buf + at, 32);
    raw_putbyte(buf + at + 1, 40);
    at = rt_fail_cstr(buf, at + 2, file);
    flags := raw_load(site + 16);
    raw_putbyte(buf + at, 58);
    at = rt_fail_num(buf, at + 1, flags & 4294967295);
    raw_putbyte(buf + at, 58);
    // Bits 32..61 are the column; 62 marks a standard-library statement, 63 the runtime's.
    at = rt_fail_num(buf, at + 1, (flags >> 32) & 1073741823);
    raw_putbyte(buf + at, 41);
    raw_putbyte(buf + at + 1, 10);
    return at + 2;
}
// An empty owned text: what a capture returns when this build carries no tables, so a caller prints
// its message alone instead of a stack it had to guess.
fn rt_no_backtrace() -> u64 {
    return rt_lit(0, 0);
}
// The call stack now, one `  at NAME (FILE:LINE:COL)` line per program frame, innermost first
// (host::backtrace). It walks the frame-pointer chain exactly as rt_fail_where does and names each
// frame from the compiler's two tables: the function whose range holds the return address, and the
// statement it is in. A frame in the runtime's own functions, in libc or in a function prologue the
// statement table cannot name is left out, so what is printed is the program's own stack.
//
// It refuses rather than guesses: no helper in process state (a seed-built compiler, macOS, the LLVM
// backend, --debug, --split), or a zero-length or absent function table, returns no text at all.
fn rt_backtrace() -> u64 {
    info := rt_alloc(rt_sites_words() * 8);
    have := rt_sites_fill(info);
    begin := raw_load(info);
    end := raw_load(info + 8);
    fbegin := raw_load(info + 24);
    fend := raw_load(info + 32);
    mut frame = raw_load(info + 16);
    rt_free(info);
    // Five words are needed: a helper offered three, one emitted before the function table existed
    // (rt_sites_fill cleared those two words, so they read as absent), or a descriptor refused
    // outright all answer the same - no text, rather than a stack named from a table that is not
    // there.
    if have < 5 {
        return rt_no_backtrace();
    }
    if ((begin == 0) + (end <= begin) + (fbegin == 0) + (fend <= fbegin)) != 0 {
        return rt_no_backtrace();
    }
    buf := rt_alloc(rt_fail_limit());
    mut n = 0;
    mut depth = 0;
    mut lines = 0;
    while (frame != 0) & (depth < 64) & (lines < 32) & (n + 256 < rt_fail_limit()) {
        ret := raw_load(frame + 8);
        // `ret - 1` is inside the call instruction: the return address itself can be the next
        // statement's (or, after a call that never returns, the next function's) first byte.
        f := rt_site_find(fbegin, fend, ret - 1, 16);
        if f != 0 {
            name := raw_load(f + 8);
            if name != 0 {
                n = rt_bt_line(buf, n, name, rt_site_find(begin, end, ret - 1, 24));
                lines = lines + 1;
            }
        }
        frame = raw_load(frame);
        depth = depth + 1;
    }
    text := rt_lit(buf, n);
    rt_free(buf);
    return text;
}
fn f_host_backtrace() -> u64 {
    return rt_backtrace();
}
fn rt_error(n: u64) -> u64 {
    return 18446744073709547520 < n;
}
fn rt_div(n: u64, d: u64) -> u64 {
    if d == 0 {
        rt_fail(5, 0, 0);
    }
    mut q = 0;
    mut r = n;
    while (r < d) == 0 {
        mut m = d;
        mut k = 1;
        while ((r < wrapping_add(m, m)) == 0) & ((wrapping_add(m, m) < m) == 0) {
            m = m + m;
            k = k + k;
        }
        r = r - m;
        q = q + k;
    }
    return q;
}
// The allocator's shared state - the class lists, the arenas, the cache registry - is changed only
// under this lock. A thread's own cache (rt_alloc_shared, docs/design/allocator.md) is not shared
// and needs none, so the lock is taken to move a batch of blocks, not for each one.
// This lock uses reserved process-state storage, never allocates or suspends while held.
// Until the process starts its second thread (rt_thread_start sets word 3416 first) nothing can
// contend for the lock, so it is not taken: an uncontended atomic exchange and release around every
// allocation and free were a tenth of the compiler's own run time (docs/design/compile-speed.md).
// The word is only ever set, and only by a thread that holds no lock, so a lock/unlock pair always
// sees one value of it.
fn rt_allocator_lock() -> u64 {
    if raw_load(raw_state() + 3416) == 0 {
        return 0;
    }
    lock := raw_state() + 64;
    while raw_atomic_cas(lock, 0, 1) != 0 {}
    return 0;
}
fn rt_allocator_unlock() -> u64 {
    if raw_load(raw_state() + 3416) == 0 {
        return 0;
    }
    raw_atomic_store_release(raw_state() + 64, 0);
    return 0;
}
fn rt_alloc(n: u64) -> u64 {
    if raw_load(raw_state() + 3416) == 0 {
        return rt_alloc_unlocked(n);
    }
    return rt_alloc_shared(n);
}
// rt_alloc in a process with more than one thread. It is a function of its own so that the
// one-thread path above stays as small as it was: the compiler measures it.
fn rt_alloc_shared(n: u64) -> u64 {
    if n < 262129 {
        tp := raw_tp_get();
        if tp != 0 {
            // The thread's own cache (docs/design/allocator.md): no lock and no atomic from here
            // to the return unless the bin is empty.
            mut c = raw_load(tp + 64);
            if c == 0 {
                c = rt_cache_make(tp);
            }
            mut size = 32;
            mut bin = 0;
            while size < n + 16 {
                size = size * 2;
                bin = bin + 1;
            }
            slot := c + 64 + bin * 48;
            while true {
                block := raw_load(slot);
                if block != 0 {
                    // A freed block: its state word is the list link. Clear what was asked for.
                    raw_store(slot, raw_load(block + 8));
                    raw_store(slot + 8, raw_load(slot + 8) - 1);
                    raw_store(block + 8, 1);
                    mut i = 0;
                    while i < n {
                        raw_store(block + 16 + i, 0);
                        i = i + 8;
                    }
                    raw_store(c + 8, wrapping_add(raw_load(c + 8), 1));
                    return block + 16;
                }
                left := raw_load(slot + 24);
                if left != 0 {
                    // A block of the thread's reserved run: never used, so already zero.
                    fresh := raw_load(slot + 16);
                    raw_store(slot + 16, fresh + size);
                    raw_store(slot + 24, left - 1);
                    raw_store(fresh, size);
                    raw_store(fresh + 8, 1);
                    raw_store(c + 8, wrapping_add(raw_load(c + 8), 1));
                    return fresh + 16;
                }
                rt_cache_refill(slot, bin, size);
            }
        }
    }
    rt_allocator_lock();
    p := rt_alloc_unlocked(n);
    rt_allocator_unlock();
    return p;
}
// Zero `n` bytes at `p`: what `alloc` promises, since the allocator hands back reused storage.
fn rt_zero(p: u64, n: u64) -> u64 {
    mut i = 0;
    while i < n {
        raw_putbyte(p + i, 0);
        i = i + 1;
    }
    return 0;
}
fn rt_free(at: u64) -> u64 {
    mut p = at;
    if (p & 8) != 0 {
        // A view record (rt_view_record): its block starts one word earlier. The one other thing at
        // such an address is a static object from a compiler that aligned those to 8 - the seed a
        // bootstrap starts from - and a static object is never freed.
        if raw_load(p - 8) == 2 {
            return 0;
        }
        p = p - 8;
    }
    if raw_load(raw_state() + 3416) == 0 {
        rt_free_unlocked(p);
        return 0;
    }
    return rt_free_shared(p);
}
// rt_free in a process with more than one thread; `p` is the payload address of a block.
fn rt_free_shared(p: u64) -> u64 {
    if p == 0 {
        return 0;
    }
    block := p - 16;
    if raw_load(block + 8) == 2 {
        return 0;
    }
    // A block on any free list carries a link here (0 or an aligned address), so a second free of
    // it stops the program exactly as it does on the shared path.
    if raw_load(block + 8) != 1 {
        rt_abort();
    }
    size := raw_load(block);
    if size < 262145 {
        tp := raw_tp_get();
        if tp != 0 {
            mut c = raw_load(tp + 64);
            if c == 0 {
                c = rt_cache_for_free(tp);
            }
            if c != 0 {
                // Whichever thread allocated the block, it joins the cache of the thread freeing it.
                mut k = 32;
                mut bin = 0;
                while k < size {
                    k = k * 2;
                    bin = bin + 1;
                }
                slot := c + 64 + bin * 48;
                raw_store(block + 8, raw_load(slot));
                raw_store(slot, block);
                count := raw_load(slot + 8) + 1;
                raw_store(slot + 8, count);
                raw_store(c + 8, wrapping_sub(raw_load(c + 8), 1));
                if raw_load(slot + 40) < count {
                    rt_cache_spill(slot, bin);
                }
                return 0;
            }
        }
    }
    rt_allocator_lock();
    rt_free_unlocked(p);
    rt_allocator_unlock();
    return 0;
}
// ---- per-thread block caches (docs/design/allocator.md) ---------------------------------------
// Once the process has a second thread, every OS thread allocates from and frees into a cache of
// its own for the classes up to 256 KiB, and takes the allocator lock only to move a batch of blocks
// between the cache and the shared lists. The cache belongs to the OS thread - it hangs off the
// thread record, which the thread pointer names - and never to a green task, which may resume on
// another worker; a task leaves its worker only at a park point and the allocator is not one, so
// nothing else runs on the thread while a cache is being changed. No signal handler allocates.
//
// Cache page (raw_map, one per thread, made by the thread's first allocation):
//   0 next cache in the registry (state word 40)   8 live blocks: allocations minus frees made by
//   this thread, a wrapping count that is negative on a thread that frees what others allocated
//   64 + bin * 48, for the bins 0..13:
//     0 free list head   8 blocks on it   16 next block of the reserved run   24 blocks left in it
//     32 how many blocks the next refill asks for   40 the most the list may hold
// The list holds at most 256 blocks and at most 128 KiB, and never less than one block (the 128 KiB
// and 256 KiB classes); one block over, half of it leaves as a chain. A refill asks for 4 blocks the first time and twice as many each time after, up to
// half the bound, so a thread that lives for one call does not reserve what it will hand back.
fn rt_cache_make(tp: u64) -> u64 {
    c := raw_map(4096);
    if rt_error(c) {
        rt_abort();
    }
    mut size = 32;
    mut bin = 0;
    while bin < 14 {
        mut bound = 256;
        while 131072 < bound * size {
            bound = bound / 2;
        }
        // The two largest cached classes are over the byte bound alone: one block of each is kept.
        if bound == 0 {
            bound = 1;
        }
        mut batch = 4;
        if bound < 8 {
            batch = bound / 2;
        }
        if batch == 0 {
            batch = 1;
        }
        raw_store(c + 64 + bin * 48 + 32, batch);
        raw_store(c + 64 + bin * 48 + 40, bound);
        size = size * 2;
        bin = bin + 1;
    }
    state := raw_state();
    rt_allocator_lock();
    raw_store(c, raw_load(state + 40));
    raw_store(state + 40, c);
    rt_allocator_unlock();
    raw_store(tp + 64, c);
    return c;
}
// A thread that has allocated nothing has no cache, and one stray free does not make it one: the
// block goes to the shared list under the lock. The eighth such free does, because a thread that
// only ever frees (the consuming end of a queue) would otherwise take the lock every time. The
// count is thread-record word 72.
fn rt_cache_for_free(tp: u64) -> u64 {
    seen := raw_load(tp + 72) + 1;
    raw_store(tp + 72, seen);
    if seen < 8 {
        return 0;
    }
    return rt_cache_make(tp);
}
// An empty bin: take a chain another cache gave up, or blocks from the shared list (freed before
// the process had threads, or by a thread with no cache), or failing both reserve a run of unused
// ones.
fn rt_cache_refill(slot: u64, bin: u64, size: u64) -> u64 {
    state := raw_state();
    want := raw_load(slot + 32);
    if want * 2 < raw_load(slot + 40) + 1 {
        raw_store(slot + 32, want * 2);
    }
    head := state + 256 + bin * 8;
    chains := state + 1792 + bin * 8;
    rt_allocator_lock();
    chain := raw_load(chains);
    if chain != 0 {
        // What another cache spilled or left behind, taken whole: nothing is walked under the lock.
        raw_store(chains, raw_load(chain + 16));
        rt_allocator_unlock();
        raw_store(slot, chain);
        raw_store(slot + 8, raw_load(chain + 24));
