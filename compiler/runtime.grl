        return 22;
    }
    mut flags = 0;
    if directory {
        flags = 512;
    }
    r := rt_syscall(263, wrapping_sub(0, 100), name, flags);
    rt_free(name);
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
}
// Creates a directory; 0 or a positive errno (17 when it already exists).
fn f_host_create_dir(path: u64) -> u64 {
    name := rt_cstr(path);
    rt_view_free(path);
    if name == 0 {
        return 22;
    }
    r := rt_syscall(258, wrapping_sub(0, 100), name, 493);
    rt_free(name);
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
