// ---- blocking foreign calls (B3 contract) ----
// The contract: a foreign call blocks the executing task. A task is green on every platform, so the
// call occupies the scheduler thread that was running it - one of the scheduler's workers - for the
// whole call. The runtime's own blocking operations
// never do that: they hand off through rt_blocking_call (or park on the reactor where there is one).
// A call the user makes through `extern "C"` or a `cfn` runs on that thread itself, so a wrapper
// that knows it blocks declares it with rt_blocking_enter, and the runtime says so once per process
// on stderr instead of a program quietly losing a worker. Scheduler word 64 is the "already warned"
// flag.
fn rt_blocking_enter() -> u64 {
    if (rt_current() == 0) | rt_task_threads() {
        return 0;
    }
    s := rt_sched();
    if raw_atomic_cas(s + 64, 0, 1) == 0 {
        rt_blocking_warn();
    }
    return 0;
}
// The one line a user gets. It names the contract, the documentation and the way out; it is emitted
// once per process because the same program will make the same call many times.
fn rt_blocking_warn() -> u64 {
    text := view(
        "grail: a blocking foreign call is running on a green task's scheduler thread; that thread is unavailable until the call returns, so other runnable tasks wait for a free scheduler thread. host::read_file, host::write_file, host::command, host::read_fd, host::write_fd and host::sleep_ms hand off to an offload thread; an extern \"C\" or cfn call does not. See docs/ffi.md, \"Blocking foreign calls\".\n"
    );
    packed := rt_pack(text);
    rt_write_all(2, packed, rt_len(text));
    rt_free(packed);
    return 0;
}
// The only way a green task runs a blocking operation: hand it to a dedicated OS thread and suspend.
// A plain OS thread already has its own thread, so it runs the call directly.
fn rt_blocking_call(f: u64, a: u64, b: u64) -> u64 {
    if rt_current() == 0 {
        return raw_call2(f, a, b);
    }
    return rt_offload(f, a, b, 0);
}

// A read or write that may block. With a readiness reactor the descriptor is non-blocking and the
// task parks in rt_wait_fd; on a platform with no readiness source (Windows) the call itself runs
// on a helper thread and the task parks, so a task inside host::read_fd or host::write_fd does not
// stall the scheduler. The observable behaviour is the same on both; only the mechanism differs.
fn rt_read_now(fd: u64, buf: u64, max: u64) -> u64 {
    return rt_syscall(0, fd, buf, max);
}
fn rt_write_now(fd: u64, buf: u64, len: u64) -> u64 {
    return rt_syscall(1, fd, buf, len);
}
fn rt_io(f: u64, a: u64, b: u64, c: u64) -> u64 {
    if (rt_current() == 0) | rt_task_threads() | (rt_os_ready() != 0) {
        return raw_call3(f, a, b, c);
    }
    return rt_offload(f, a, b, c);
}

// Blocking-call boundary: a green task hands a blocking operation to a dedicated OS thread and
// suspends; its worker keeps running other tasks. Job words: 0 function, 8/16/24 arguments,
// 32 result, 40 done, 48 suspended task.
fn rt_offload_main(job: u64) -> u64 {
