}
// The thread whose record this is has finished (rt_thread_main, rt_release_record): everything its
// cache holds goes back to the shared lists, its live count joins the process's, and the page is
// unmapped. The record is an argument because an adopted record is released on C's thread pointer.
fn rt_cache_retire(record: u64) -> u64 {
