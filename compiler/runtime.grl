fn rt_array_copy_from(dst: u64, s: u64, n: u64, w: u64) -> u64 {
    if raw_load(wrapping_add(s, 8)) != n {
        rt_fail(10, raw_load(wrapping_add(s, 8)), n);
    }
    rt_copy_bytes(dst, raw_load(s), wrapping_mul(n, w));
