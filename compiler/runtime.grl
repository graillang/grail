fn rt_print_f32(v: u64, newline: u64) -> u64 {
    acc := rt_new();
    rt_fmt_f32(acc, v);
    if newline {
        rt_pushb(acc, 10);
    }
    n := rt_len(acc);
    packed := rt_pack(acc);
    if rt_write_all(1, packed, n) != 0 {
        rt_abort();
    }
    rt_free(packed);
    rt_drop_seq(acc);
    return 0;
}

// ---- char: a Unicode scalar value (0..0x10FFFF without surrogates) in one word ----
fn rt_char_from(v: u64) -> u64 {
    if (1114111 < v) + ((55295 < v) & (v < 57344)) {
        rt_abort();
    }
    return v;
}
fn rt_print_char(v: u64, newline: u64) -> u64 {
    acc := rt_new();
    rt_push_utf8(acc, v);
    if newline {
        rt_pushb(acc, 10);
    }
    n := rt_len(acc);
    packed := rt_pack(acc);
    if rt_write_all(1, packed, n) != 0 {
        rt_abort();
    }
    rt_free(packed);
    rt_drop_seq(acc);
    return 0;
}
fn rt_char_upper(v: u64) -> u64 {
    return rt_case_map(v, 1);
}
fn rt_char_lower(v: u64) -> u64 {
    return rt_case_map(v, 0);
}
fn rt_char_is_upper(v: u64) -> u64 {
    return rt_case_map(v, 0) != v;
}
fn rt_char_is_lower(v: u64) -> u64 {
    return (rt_case_map(v, 1) != v) + (v == 223) + (v == 312) + (v == 329);
}
// Letters of the scripts with case mapping (Latin-1, Latin Extended-A, Greek, Cyrillic), plus
// the caseless ª º, ß and CJK ideographs.
fn rt_char_is_alpha(v: u64) -> u64 {
    return rt_char_is_upper(v)
        + rt_char_is_lower(v)
        + (v == 170)
        + (v == 186)
        + ((19967 < v) & (v < 40960));
}
fn rt_char_is_digit(v: u64) -> u64 {
    return (47 < v) & (v < 58);
}
fn rt_char_is_alnum(v: u64) -> u64 {
    return rt_char_is_alpha(v) + rt_char_is_digit(v);
}
fn rt_char_is_space(v: u64) -> u64 {
    return ((8 < v) & (v < 14))
        + (v == 32)
        + (v == 133)
        + (v == 160)
        + (v == 5760)
        + ((8191 < v) & (v < 8203))
        + (v == 8232)
        + (v == 8233)
        + (v == 8239)
        + (v == 8287)
        + (v == 12288);
}
fn rt_char_is_ascii(v: u64) -> u64 {
    return v < 128;
}
fn rt_char_len_utf8(v: u64) -> u64 {
    if v < 128 {
        return 1;
    }
    if v < 2048 {
        return 2;
    }
    if v < 65536 {
        return 3;
    }
    return 4;
}
// UTF-8 text to scalar values; malformed sequences become U+FFFD.
fn rt_seq_chars(a: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    mut i = 0;
    while i < n {
        b := rt_atb(a, i);
        mut need = 0;
        mut cp = b;
        mut min = 0;
        if b < 128 {
            need = 0;
        } else {
            if (b & 224) == 192 {
                need = 1;
                cp = b & 31;
                min = 128;
            } else {
                if (b & 240) == 224 {
                    need = 2;
                    cp = b & 15;
                    min = 2048;
                } else {
                    if (b & 248) == 240 {
                        need = 3;
                        cp = b & 7;
                        min = 65536;
                    } else {
                        need = 99;
                    }
                }
            }
        }
        if need == 99 {
            rt_push(out, 65533);
            i += 1;
            continue;
        }
        mut ok = 1;
        mut j = 1;
        while j < need + 1 {
            if n < i + j + 1 {
                ok = 0;
                break;
            }
            d := rt_atb(a, i + j);
            if (d & 192) != 128 {
                ok = 0;
                break;
            }
            cp = cp * 64 + (d & 63);
            j += 1;
        }
        if ok {
            if (cp < min) + (1114111 < cp) + ((55295 < cp) & (cp < 57344)) {
                ok = 0;
            }
        }
        if ok {
            rt_push(out, cp);
            i += need + 1;
        } else {
            rt_push(out, 65533);
            i += 1;
        }
    }
    return out;
}

// Exactly `digits` decimals: round(value * 10^digits) computed exactly, ties to even (like Rust).
fn rt_big_half(p: u64) -> u64 {
    mut carry = 0;
    mut i = 48;
    while 0 < i {
        i -= 1;
        v := raw_load(p + i * 8) + carry * 1000000000;
        raw_store(p + i * 8, rt_div(v, 2));
        carry = v % 2;
    }
    return carry;
}
fn rt_big_is_zero(p: u64) -> u64 {
    mut i = 0;
    while i < 48 {
        if raw_load(p + i * 8) != 0 {
            return 0;
        }
        i += 1;
    }
    return 1;
}
fn rt_fmt_f64_fixed(acc: u64, v: u64, digits: u64) -> u64 {
    if raw_feq(v, v) == 0 {
        return rt_push_text(acc, 78, 97, 78);
    }
    if 9223372036854775807 < v {
        rt_pushb(acc, 45);
    }
    exponent := rt_div(v, 4503599627370496) & 2047;
    fraction := v & 4503599627370495;
    if exponent == 2047 {
        return rt_push_text(acc, 105, 110, 102);
    }
    mut f = fraction;
    mut e = 0;
    mut eneg = 0;
    if exponent == 0 {
        e = 1074;
        eneg = 1;
    } else {
        f = fraction + 4503599627370496;
        if exponent < 1075 {
            e = 1075 - exponent;
            eneg = 1;
        } else {
            e = exponent - 1075;
        }
    }
    q := rt_big(f);
    mut i = 0;
    while i < digits {
        rt_big_mul(q, 10);
        i += 1;
    }
    if eneg == 0 {
        rt_big_shift(q, e);
    } else {
        mut last = 0;
        mut sticky = 0;
        i = 0;
        while i < e {
            if last {
                sticky = 1;
            }
            last = rt_big_half(q);
            i += 1;
        }
        if last & (((sticky != 0) + (raw_load(q) & 1)) != 0) {
            one := rt_big(1);
            rt_big_add(q, q, one);
            rt_free(one);
        }
