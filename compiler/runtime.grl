    mut over = 0;
    if op == 43 {
        r = wrapping_add(a, b);
        if bits == 64 {
            if signed {
                over = rt_int_neg((a ^ r) & (b ^ r));
            } else {
                over = r < a;
            }
        }
    }
    if op == 45 {
        r = wrapping_sub(a, b);
        if bits == 64 {
            if signed {
                over = rt_int_neg((a ^ b) & (a ^ r));
            } else {
                over = a < b;
            }
        }
    }
    if op == 42 {
        r = wrapping_mul(a, b);
        if bits == 64 {
            ma := rt_int_abs(a);
            mb := rt_int_abs(b);
            mr := wrapping_mul(ma, mb);
            if ma != 0 {
                if rt_div(mr, ma) != mb {
                    over = 1;
                }
            }
            if signed & (over == 0) {
                negative := rt_int_neg(a) ^ rt_int_neg(b);
                if negative {
                    over = 9223372036854775808 < mr;
                } else {
                    over = 9223372036854775807 < mr;
                }
            }
        }
    }
    if (op == 47) + (op == 37) {
        if b == 0 {
            rt_abort();
        }
        if signed {
            q := rt_div(rt_int_abs(a), rt_int_abs(b));
            m := rt_int_abs(a) - q * rt_int_abs(b);
            if op == 47 {
                if rt_int_neg(a) ^ rt_int_neg(b) {
                    r = wrapping_sub(0, q);
                } else {
                    r = q;
                }
                if (bits == 64)
                    & (r == 9223372036854775808)
                    & (rt_int_neg(a) ^ rt_int_neg(b) == 0) {
                    over = 1;
                }
            } else {
                if rt_int_neg(a) {
                    r = wrapping_sub(0, m);
                } else {
                    r = m;
                }
            }
        } else {
            q := rt_div(a, b);
            if op == 47 {
                r = q;
            } else {
                r = a - q * b;
            }
        }
    }
    if op == 38 {
        return a & b;
    }
    if op == 94 {
        return a ^ b;
    }
    if op == 124 {
        return wrapping_add(a & (18446744073709551615 ^ b), b);
    } // a|b for canonical words
    if (op == 271) + (op == 272) {
        if (b < bits) == 0 {
            if wrap == 0 {
                rt_abort();
            }
            return 0;
        }
        mut p = 1;
        mut i = 0;
        while i < b {
            p = wrapping_add(p, p);
            i += 1;
        }
        if op == 271 {
            return rt_int_truncate(wrapping_mul(a, p), bits, signed);
        }
        if signed & rt_int_neg(a) {
            return wrapping_sub(wrapping_sub(0, rt_div(wrapping_sub(wrapping_sub(0, a), 1), p)), 1);
        }
        return rt_div(a, p);
    }
    if op == 258 {
        return a == b;
    }
    if op == 259 {
        return a != b;
    }
    if (op == 60) + (op == 62) + (op == 269) + (op == 270) {
        mut x = a;
        mut y = b;
        if signed {
            x = a ^ 9223372036854775808;
            y = b ^ 9223372036854775808;
        }
        if op == 60 {
            return x < y;
        }
        if op == 62 {
            return y < x;
        }
        if op == 269 {
            return (y < x) == 0;
        }
        return (x < y) == 0;
    }
    if op == 267 {
        if rt_int_neg(b) {
            rt_abort();
        }
        mut result = 1;
        mut i = 0;
        while i < b {
            result = rt_int(42, result, a, code);
            i += 1;
        }
        return result;
    }
    if (over == 0) & (bits < 64) {
        over = rt_int_fit(r, bits, signed) == 0;
    }
    if over {
        if wrap == 0 {
            rt_abort();
        }
        return rt_int_truncate(r, bits, signed);
    }
    return r;
}
fn rt_int_cast(v: u64, from: u64, to: u64) -> u64 {
    fs := (from / 256) & 1;
    tb := to & 255;
    ts := (to / 256) & 1;
    negative := fs & rt_int_neg(v);
    mut ok = 1;
    if ts == 0 {
        if negative {
            ok = 0;
        } else {
            if tb < 64 {
                ok = (v < rt_int_mask(tb)) + (v == rt_int_mask(tb));
            }
        }
    } else {
        if negative {
            if tb < 64 {
                ok = rt_int_fit(v, tb, 1);
            }
        } else {
            half := rt_int_mask(tb) / 2;
            ok = (v < half) + (v == half);
        }
    }
    if ok == 0 {
        if (to / 512) & 1 {
            return rt_int_truncate(v, tb, ts);
        }
        // A conversion the target cannot hold is a failed check like any other: it reports what
        // failed and where. It used to call rt_abort, so `u8(300)` died with an empty stderr and a
        // status of 134 - the one runtime check with nothing to say (docs/diagnostics.md).
        if (ts == 0) & (negative != 0) {
            return rt_fail(3, 0, 0);
        }
        if negative != 0 {
            return rt_fail(15, wrapping_sub(0, v), to);
        }
        return rt_fail(14, v, to);
    }
    return v;
}
fn rt_print_int(v: u64, newline: u64, code: u64) -> u64 {
    signed := (code / 256) & 1;
    if signed & rt_int_neg(v) {
        buf := rt_alloc(1);
        raw_putbyte(buf, 45);
        err := rt_write_all(1, buf, 1);
        rt_free(buf);
        if err != 0 {
            rt_abort();
        }
        return rt_print_number(wrapping_sub(0, v), newline);
    }
    return rt_print_number(v, newline);
}

fn rt_print_bool(v: u64, newline: u64) -> u64 {
    n := 4 + (v == 0);
    buf := rt_alloc(8);
    if v {
        raw_putbyte(buf, 116);
        raw_putbyte(buf + 1, 114);
        raw_putbyte(buf + 2, 117);
        raw_putbyte(buf + 3, 101);
    } else {
        raw_putbyte(buf, 102);
        raw_putbyte(buf + 1, 97);
        raw_putbyte(buf + 2, 108);
        raw_putbyte(buf + 3, 115);
        raw_putbyte(buf + 4, 101);
    }
    mut m = n;
    if newline {
        raw_putbyte(buf + n, 10);
        m = n + 1;
    }
    err := rt_write_all(1, buf, m);
    rt_free(buf);
    if err != 0 {
        rt_abort();
    }
    return 0;
}

// ---- TCP (IPv4) on the readiness reactor: accept/connect/read/write suspend only the task ----
fn rt_sockaddr(addr: u64, port: u64) -> u64 {
    buf := rt_alloc(16);
    network := (port % 256) * 256 + rt_div(port, 256);
    raw_store(buf, 2 + network * 65536 + addr * 4294967296);
    raw_store(buf + 8, 0);
    return buf;
}
fn rt_tcp_socket() -> u64 {
    fd := rt_syscall(41, 2, 526337, 0);
    if rt_error(fd) {
        rt_abort();
    }
    return fd;
}
fn f_host_tcp_listen(port: u64) -> u64 {
    fd := rt_tcp_socket();
    addr := rt_sockaddr(0, port);
    r := rt_syscall(49, fd, addr, 16);
    rt_free(addr);
    if rt_error(r) {
        rt_abort();
    }
    if rt_error(rt_syscall(50, fd, 128, 0)) {
        rt_abort();
    }
    return fd;
}
fn f_host_tcp_port(fd: u64) -> u64 {
    buf := rt_alloc(24);
    raw_store(buf + 16, 16);
    if rt_error(rt_syscall(51, fd, buf, buf + 16)) {
        rt_abort();
    }
    word := raw_load(buf);
    network := rt_div(word, 65536) % 65536;
    rt_free(buf);
    return (network % 256) * 256 + rt_div(network, 256);
}
fn f_host_tcp_accept(fd: u64) -> u64 {
    while true {
        c := rt_accept4(fd);
        if c == wrapping_sub(0, 11) {
            if rt_wait_fd(fd, 1) != 0 {
                return wrapping_sub(0, 125);
            }
        } else {
            if rt_error(c) {
                rt_abort();
            }
            return c;
        }
    }
    return 0;
}
// "a.b.c.d" -> IPv4 in network byte order (as a little-endian word).
fn rt_ipv4(text: u64) -> u64 {
    n := rt_len(text);
    mut part = 0;
    mut shift = 1;
    mut addr = 0;
    mut i = 0;
    while i < n {
        d := rt_atb(text, i);
        if d == 46 {
            addr = addr + part * shift;
            shift = shift * 256;
            part = 0;
        } else {
            part = part * 10 + d - 48;
        }
        i += 1;
    }
    addr = addr + part * shift;
    rt_view_free(text);
    return addr;
}
fn f_host_tcp_connect(host: u64, port: u64) -> u64 {
    fd := rt_tcp_socket();
    addr := rt_sockaddr(rt_ipv4(host), port);
    while true {
        r := rt_syscall(42, fd, addr, 16);
        if (r == 0) + (r == wrapping_sub(0, 106)) {
            rt_free(addr);
            return fd;
        } // connected / EISCONN
        if (r == wrapping_sub(0, 115)) + (r == wrapping_sub(0, 114)) {
            if rt_wait_fd(fd, 4) != 0 {
                rt_free(addr);
                rt_syscall(3, fd, 0, 0);
                return wrapping_sub(0, 125);
            }
        } // EINPROGRESS / EALREADY
        else {
            if r == wrapping_sub(0, 11) {
                rt_yield();
            } // loopback queue full: retry
            else {
                rt_free(addr);
                rt_syscall(3, fd, 0, 0);
                return r;
            }
        } // other errors: negative errno
    }
    return 0;
}

// Opens a file for reading (write==0) or writing (create/truncate). Returns the descriptor or a
// negative errno (as a wrapped word) instead of aborting. `write == 2` is the jobserver's fifo
// (compiler/jobs.grl): made first if the path does not exist, then opened for reading and writing
// and non-blocking, so a process that holds it open never sees its end.
fn f_host_open(path: u64, write: u64) -> u64 {
    name := rt_cstr(path);
    rt_view_free(path);
    if name == 0 {
        return wrapping_sub(0, 22);
    }
    mut flags = 524288;
    if write == 2 {
        // mknodat(AT_FDCWD, name, S_IFIFO | 0600, 0); an existing one is the one to open.
        rt_syscall(259, wrapping_sub(0, 100), name, 4480);
        flags = 526338;
    } else if write {
        flags = 524865;
    }
    fd := rt_syscall(2, name, flags, 438);
    rt_free(name);
    return fd;
}

fn rt_print_raw(p: u64, n: u64) -> u64 {
    if rt_write_all(1, p, n) != 0 {
        rt_abort();
    }
    return 0;
}

// ---- format(...) helpers: append to a byte accumulator, then validate it as text ----
fn rt_fmt_raw(acc: u64, p: u64, n: u64) -> u64 {
    have := raw_load(acc + 8);
    rt_reserveb(acc, have + n);
    rt_copy_bytes(raw_load(acc) + have, p, n);
    raw_store(acc + 8, have + n);
    return 0;
}
// The decimal digits of v, written straight onto the end of acc: one reservation, no buffer, the
// length found by comparison and two digits per division.
fn rt_fmt_num(acc: u64, v: u64) -> u64 {
    mut n = 1;
    mut p = 10;
    while (n < 20) & (p - 1 < v) {
        n += 1;
        if n < 20 {
            p = p * 10;
        }
    }
    have := raw_load(acc + 8);
    rt_reserveb(acc, have + n);
    base := raw_load(acc) + have;
    mut r = v;
    mut k = n;
    while 1 < k {
        q := r / 100;
        d := r - q * 100;
        t := d / 10;
        raw_putbyte(base + k - 1, 48 + d - t * 10);
        raw_putbyte(base + k - 2, 48 + t);
        r = q;
        k -= 2;
    }
    if k == 1 {
        raw_putbyte(base, 48 + r);
    }
    raw_store(acc + 8, have + n);
    return 0;
}
fn rt_fmt_int(acc: u64, v: u64, code: u64) -> u64 {
    if ((code / 256) & 1) & rt_int_neg(v) {
        rt_pushb(acc, 45);
        return rt_fmt_num(acc, wrapping_sub(0, v));
    }
    return rt_fmt_num(acc, v);
}
fn rt_fmt_bool(acc: u64, v: u64) -> u64 {
    if v {
        rt_pushb(acc, 116);
        rt_pushb(acc, 114);
        rt_pushb(acc, 117);
        rt_pushb(acc, 101);
    } else {
        rt_pushb(acc, 102);
        rt_pushb(acc, 97);
        rt_pushb(acc, 108);
        rt_pushb(acc, 115);
        rt_pushb(acc, 101);
    }
    return 0;
}
fn rt_fmt_seq(acc: u64, s: u64) -> u64 {
    n := rt_len(s);
    mut i = 0;
    while i < n {
        rt_pushb(acc, rt_atb(s, i));
        i += 1;
    }
    return 0;
}

// ---- f64: IEEE binary64 values carried as their bit pattern in one word ----
fn rt_f64_pow2(k: u64) -> u64 {
    return wrapping_mul(1023 + k, 4503599627370496);
} // 2^k for 0<=k<=1023
fn rt_f64_neg(v: u64) -> u64 {
    return v ^ 9223372036854775808;
}
fn rt_f64_abs(v: u64) -> u64 {
    return v & 9223372036854775807;
}
fn rt_f64_is_nan(v: u64) -> u64 {
    return raw_feq(v, v) == 0;
}
fn rt_f64_sqrt(v: u64) -> u64 {
    return raw_fsqrt(v);
}
fn rt_f64_op(op: u64, a: u64, b: u64) -> u64 {
    if op == 43 {
        return raw_fadd(a, b);
    }
    if op == 45 {
        return raw_fsub(a, b);
    }
    if op == 42 {
        return raw_fmul(a, b);
    }
    if op == 47 {
        return raw_fdiv(a, b);
    }
    rt_abort();
    return 0;
}
// NaN compares unequal to everything (and != is true), as in IEEE 754.
fn rt_f64_cmp(op: u64, a: u64, b: u64) -> u64 {
    if op == 60 {
        return raw_flt(a, b);
    }
    if op == 62 {
        return raw_flt(b, a);
    }
    if op == 269 {
        return raw_flt(a, b) + raw_feq(a, b);
    }
    if op == 270 {
        return raw_flt(b, a) + raw_feq(a, b);
    }
    if op == 258 {
        return raw_feq(a, b);
    }
    if op == 259 {
        return raw_feq(a, b) == 0;
    }
    rt_abort();
    return 0;
}
fn rt_f64_from_int(v: u64, code: u64) -> u64 {
    if (code / 256) & 1 {
        return raw_f64_from_i64(v);
    }
    if v < 9223372036854775808 {
        return raw_f64_from_i64(v);
    }
    mut q = rt_div(v, 2);
    if (v & 1) & ((q & 1) == 0) {
        q += 1;
    } // halve with a sticky low bit so rounding stays exact
    half := raw_f64_from_i64(q);
    return raw_fadd(half, half);
}
// `bits(x)` of a float: its pattern, with every NaN made the one quiet NaN 0x7FF8000000000000.
// Hardware differs in the NaN an operation produces (x86 sets the sign bit, ARM and RISC-V do
// not), so without this a program would see different bits on different targets. A float is held
// as its f64 pattern (an f32 widened), so one test covers both.
fn rt_float_bits(v: u64) -> u64 {
    if (v & 9223372036854775807) > 9218868437227405312 {
        return 9221120237041090560;
    }
    return v;
}
// Truncating, checked: NaN or a value outside the target range stops the program.
fn rt_int_from_f64(v: u64, code: u64) -> u64 {
    bits := code & 255;
    signed := (code / 256) & 1;
    if raw_feq(v, v) == 0 {
        rt_abort();
    }
    one := rt_f64_pow2(0);
    if signed {
        top := rt_f64_pow2(bits - 1);
        mut low = rt_f64_neg(top);
        if bits < 64 {
            low = raw_fsub(low, one);
        }
        if raw_flt(v, top) == 0 {
            rt_abort();
        }
        if bits < 64 {
            if raw_flt(low, v) == 0 {
                rt_abort();
            }
        } else {
            if raw_flt(v, low) {
                rt_abort();
            }
        }
        return raw_i64_from_f64(v);
    }
    if raw_flt(rt_f64_neg(one), v) == 0 {
        rt_abort();
    }
    top := rt_f64_pow2(bits);
    if raw_flt(v, top) == 0 {
        rt_abort();
    }
    big := rt_f64_pow2(63);
    if raw_flt(v, big) {
        return raw_i64_from_f64(v);
    }
    return wrapping_add(raw_i64_from_f64(raw_fsub(v, big)), 9223372036854775808);
}
// Rounding on the binary64 word, exact by construction (bits are cleared, never computed).
// trunc: toward zero, keeping the sign (-0.5 -> -0.0); NaN, infinities and integral values return.
fn rt_f64_trunc(v: u64) -> u64 {
    e := (v >> 52) & 2047;
    if 1074 < e {
        return v;
    }
    if e < 1023 {
        return v & 9223372036854775808;
    }
    fraction := (1 << (1075 - e)) - 1;
    return v & (18446744073709551615 - fraction);
}
fn rt_f64_floor(v: u64) -> u64 {
    t := rt_f64_trunc(v);
    if raw_flt(v, t) {
        return raw_fsub(t, rt_f64_pow2(0));
    }
    return t;
}
fn rt_f64_ceil(v: u64) -> u64 {
    t := rt_f64_trunc(v);
    if raw_flt(t, v) {
        return raw_fadd(t, rt_f64_pow2(0));
    }
    return t;
}
// round: to nearest, halves away from zero (C round, Rust f64::round). x - trunc(x) is exact.
fn rt_f64_round(v: u64) -> u64 {
    t := rt_f64_trunc(v);
    d := rt_f64_abs(raw_fsub(v, t));
    if raw_flt(d, rt_f64_pow2(0) - 4503599627370496) {
        return t;
    }
    if (v >> 63) != 0 {
        return raw_fsub(t, rt_f64_pow2(0));
    }
    return raw_fadd(t, rt_f64_pow2(0));
}
// min/max: a NaN operand yields the other (IEEE minNum/maxNum, Rust f64::min/max).
fn rt_f64_min(a: u64, b: u64) -> u64 {
    if raw_feq(a, a) == 0 {
        return b;
    }
    if raw_feq(b, b) == 0 {
        return a;
    }
    if raw_flt(b, a) {
        return b;
    }
    return a;
}
fn rt_f64_max(a: u64, b: u64) -> u64 {
    if raw_feq(a, a) == 0 {
        return b;
    }
    if raw_feq(b, b) == 0 {
        return a;
    }
    if raw_flt(a, b) {
        return b;
    }
    return a;
}
fn rt_f64_is_finite(v: u64) -> u64 {
    return ((v >> 52) & 2047) != 2047;
}
fn rt_f64_is_infinite(v: u64) -> u64 {
    return (v & 9223372036854775807) == 9218868437227405312;
}
// next_up/next_down: the adjacent representable value (NaN returns itself; +-0 step to the smallest
// subnormal). `bits` is 64 for f64; for f32 the step is taken on the binary32 bits.
fn rt_float_step(v: u64, up: u64, single: u64) -> u64 {
    if raw_feq(v, v) == 0 {
        return v;
    }
    mut b = v;
    mut sign: u64 = 9223372036854775808;
    mut inf: u64 = 9218868437227405312;
    if single {
        b = rt_f32_bits(v);
        sign = 2147483648;
        inf = 2139095040;
    }
    magnitude := b & (sign - 1);
    negative := (b & sign) != 0;
    mut r = b;
    if magnitude == 0 {
        r = 1;
        if up == 0 {
            r = sign | 1;
        }
    } else {
        if up != negative {
            if magnitude != inf {
                r = b + 1;
            }
        } else {
            r = b - 1;
        }
    }
    if single {
        return rt_f32_from_bits(r);
    }
    return r;
}
// Fixed-width decimal bignums: 48 little-endian limbs of base 10^9 (up to ~10^432).
fn rt_big(v: u64) -> u64 {
    p := rt_alloc(384);
    mut i = 0;
    while i < 48 {
        raw_store(p + i * 8, 0);
        i += 1;
    }
    mut x = v;
    i = 0;
    while x != 0 {
        raw_store(p + i * 8, x % 1000000000);
        x = rt_div(x, 1000000000);
        i += 1;
    }
    return p;
}
fn rt_big_mul(p: u64, m: u64) -> u64 {
    mut carry = 0;
    mut i = 0;
    while i < 48 {
        t := raw_load(p + i * 8) * m + carry;
        raw_store(p + i * 8, t % 1000000000);
        carry = rt_div(t, 1000000000);
        i += 1;
    }
    if carry != 0 {
        rt_abort();
    }
    return 0;
}
fn rt_big_add(dst: u64, a: u64, b: u64) -> u64 {
    mut carry = 0;
    mut i = 0;
    while i < 48 {
        t := raw_load(a + i * 8) + raw_load(b + i * 8) + carry;
        raw_store(dst + i * 8, t % 1000000000);
        carry = rt_div(t, 1000000000);
        i += 1;
    }
    if carry != 0 {
        rt_abort();
    }
    return 0;
}
fn rt_big_sub(a: u64, b: u64) -> u64 {
    mut borrow = 0;
    mut i = 0;
    while i < 48 {
        x := raw_load(a + i * 8);
        y := raw_load(b + i * 8) + borrow;
        if x < y {
            raw_store(a + i * 8, x + 1000000000 - y);
            borrow = 1;
        } else {
            raw_store(a + i * 8, x - y);
            borrow = 0;
        }
        i += 1;
    }
    return 0;
}
// 0 less, 1 equal, 2 greater
fn rt_big_cmp(a: u64, b: u64) -> u64 {
    mut i = 48;
    while 0 < i {
        i -= 1;
        x := raw_load(a + i * 8);
        y := raw_load(b + i * 8);
        if x < y {
            return 0;
        }
        if y < x {
            return 2;
        }
    }
    return 1;
}
fn rt_big_shift(p: u64, n: u64) -> u64 {
    mut i = 0;
    while i < n {
        rt_big_mul(p, 2);
        i += 1;
    }
    return 0;
}
fn rt_push_text(acc: u64, a: u64, b: u64, c: u64) -> u64 {
    rt_pushb(acc, a);
    if b != 0 {
        rt_pushb(acc, b);
    }
    if c != 0 {
        rt_pushb(acc, c);
    }
    return 0;
}
// Shortest decimal digits that read back to the same double (Burger & Dybvig free-format),
// laid out like Rust's Display for f64: no exponent, "-0", "inf", "NaN".
fn rt_fmt_f64(acc: u64, v: u64) -> u64 {
    if raw_feq(v, v) == 0 {
        return rt_push_text(acc, 78, 97, 78);
    }
    negative := 9223372036854775807 < v;
    if negative {
        rt_pushb(acc, 45);
    }
    exponent := rt_div(v, 4503599627370496) & 2047;
    fraction := v & 4503599627370495;
    if exponent == 2047 {
        return rt_push_text(acc, 105, 110, 102);
    }
    if (exponent == 0) & (fraction == 0) {
        rt_pushb(acc, 48);
        return 0;
    }
    mut f = fraction;
    mut e = 0;
    mut eneg = 0; // value = f * 2^(+/-e)
    if exponent == 0 {
        e = 1074;
        eneg = 1;
    } else {
        f = fraction + 4503599627370496;
        if exponent < 1075 {
            e = 1075 - exponent;
            eneg = 1;
        } else {
            e = exponent - 1075;
        }
    }
    if rt_fmt_short_fast(acc, v & 9223372036854775807) {
        return 0;
    }
    return rt_fmt_shortest(acc, f, e, eneg, (fraction == 0) & (1 < exponent));
}
// Burger & Dybvig digit generation for value = f * 2^(+/-e); `boundary` marks a power of two
// whose lower neighbour is closer (the gap below is half the gap above).
// Digits d1..dn of the value 0.d1..dn * 10^(+/-k), written positionally (kneg: the exponent is -k).
fn rt_fmt_place(acc: u64, digits: u64, k: u64, kneg: u64) -> u64 {
    n := rt_len(digits);
    if kneg + (k == 0) {
        rt_pushb(acc, 48);
        rt_pushb(acc, 46);
        mut z = 0;
        if kneg {
            z = k;
        }
        mut i = 0;
        while i < z {
            rt_pushb(acc, 48);
            i += 1;
        }
        i = 0;
        while i < n {
            rt_pushb(acc, 48 + rt_at(digits, i));
            i += 1;
        }
    } else {
        mut i = 0;
        while i < n {
            if i == k {
                rt_pushb(acc, 46);
            }
            rt_pushb(acc, 48 + rt_at(digits, i));
            i += 1;
        }
        while i < k {
            rt_pushb(acc, 48);
            i += 1;
        }
    }
    return 0;
}
// The shortest digits of a positive finite double without big integers, when there are at most 15
// of them and the value lies in [1e-7, 1e22): a candidate D * 10^q with D < 2^53 and |q| <= 22 is
// converted back in one correctly rounded operation (Clinger), so it is checked exactly; it is used
// only when neither D - 1 nor D + 1 also reads back as the value, so it is the one Burger & Dybvig
// would produce. Returns 0 when it did not decide (the caller runs the exact algorithm).
fn rt_fmt_short_fast(acc: u64, a: u64) -> u64 {
    one := rt_f64_pow2(0);
    ten := raw_f64_from_i64(10);
    if raw_flt(a, raw_fdiv(one, raw_f64_from_i64(10000000))) {
        return 0;
    }
    // e = floor(log10(a)), never below the truth (it may be one above for a < 1).
    mut e = 0;
    mut eneg = 0;
    if raw_flt(a, one) {
        eneg = 1;
        e = 1;
        mut p = ten;
        while raw_flt(raw_fmul(a, p), one) {
            e += 1;
            p = raw_fmul(p, ten);
        }
    } else {
        mut t = one;
        while (e < 22) & (raw_flt(raw_fmul(t, ten), a) + raw_feq(raw_fmul(t, ten), a)) {
            t = raw_fmul(t, ten);
            e += 1;
        }
        if e >= 22 {
            return 0;
        }
    }
    mut digits = 1;
    while digits < 16 {
        // q = e - digits + 1, the power of ten of the last digit.
        mut q = 0;
        mut qneg = 0;
        if eneg {
            q = e + digits - 1;
            qneg = 1;
        } else {
            if e + 1 < digits {
                q = digits - 1 - e;
                qneg = 1;
            } else {
                q = e + 1 - digits;
            }
        }
        if 22 < q {
            if qneg {
                return 0;
            }
            digits += 1;
            continue;
        }
        mut pq = one;
        mut j = 0;
        while j < q {
            pq = raw_fmul(pq, ten);
            j += 1;
        }
        mut scaled = 0;
        if qneg {
            scaled = raw_fmul(a, pq);
        } else {
            scaled = raw_fdiv(a, pq);
        }
        d := raw_i64_from_f64(raw_fadd(scaled, rt_f64_pow2_neg1()));
        if (d != 0) & (d < 9007199254740992) {
            if rt_fmt_back(d, pq, qneg) == a {
                if (rt_fmt_back(d - 1, pq, qneg) != a) & (rt_fmt_back(d + 1, pq, qneg) != a) {
                    // The digits of d, most significant first, and the place of the point.
                    list := rt_new();
                    mut n = 0;
                    mut r = d;
                    while r != 0 {
                        n += 1;
                        r = r / 10;
                    }
                    mut i = 0;
                    while i < n {
                        rt_push(list, 0);
                        i += 1;
                    }
                    r = d;
                    i = n;
                    while 0 < i {
                        i -= 1;
                        raw_store(raw_load(list) + i * 8, r % 10);
                        r = r / 10;
                    }
                    // value = 0.digits * 10^(n + q) with q signed by qneg.
                    mut k = 0;
                    mut kneg = 0;
                    if qneg {
                        if q < n {
                            k = n - q;
                        } else {
                            k = q - n;
                            kneg = k != 0;
                        }
                    } else {
                        k = n + q;
                    }
                    rt_fmt_place(acc, list, k, kneg);
                    rt_drop_seq(list);
                    return 1;
                }
                return 0;
            }
        }
        digits += 1;
    }
    return 0;
}
// d * 10^q (qneg: d / 10^q), one correctly rounded operation, as bits.
fn rt_fmt_back(d: u64, pq: u64, qneg: u64) -> u64 {
    x := raw_f64_from_i64(d);
    if qneg {
        return raw_fdiv(x, pq);
    }
    return raw_fmul(x, pq);
}
fn rt_f64_pow2_neg1() -> u64 {
    return 4602678819172646912;
}
fn rt_fmt_shortest(acc: u64, f: u64, e: u64, eneg: u64, boundary: u64) -> u64 {
