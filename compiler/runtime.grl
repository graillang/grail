// ---- blocking foreign calls (B3 contract) ----
// The contract: a foreign call blocks the executing task thread. On Linux that thread is a green
// worker, so the pool is one worker short for the whole call. The runtime's own blocking operations
// never do that: they hand off through rt_blocking_call. A call the user makes through `extern "C"`
// or a `cfn` runs on the worker itself, so a wrapper that knows it blocks declares it with
// rt_blocking_enter, and the runtime says so once per process on stderr instead of a program
// quietly losing a worker. Scheduler word 64 is the "already warned" flag.
fn rt_blocking_enter() -> u64 {
    if (rt_current() == 0) | rt_threaded() {
        return 0;
    }
    s := rt_sched();
    if raw_atomic_cas(s + 64, 0, 1) == 0 {
        rt_blocking_warn();
    }
    return 0;
}
// The one line a user gets. It names the contract, the documentation and the way out; it is emitted
// once per process because the same program will make the same call many times.
fn rt_blocking_warn() -> u64 {
    text := view(
        "grail: a blocking foreign call is running on a green task's worker thread; that worker is unavailable until the call returns, so other runnable tasks wait for a free worker. host::read_file, host::write_file and host::command hand off to an offload thread; an extern \"C\" or cfn call does not. See docs/ffi.md, \"Blocking foreign calls\".\n"
    );
    packed := rt_pack(text);
    rt_write_all(2, packed, rt_len(text));
    rt_free(packed);
    return 0;
}
// The only way a green task runs a blocking operation: hand it to a dedicated OS thread and suspend.
// A plain OS thread already has its own thread, so it runs the call directly.
fn rt_blocking_call(f: u64, a: u64, b: u64) -> u64 {
    if rt_current() == 0 {
        return raw_call2(f, a, b);
    }
    return rt_offload(f, a, b);
}

// Blocking-call boundary: a green task hands a blocking operation to a dedicated OS thread
// and suspends; its worker keeps running other tasks.
fn rt_offload_main(job: u64) -> u64 {
    r := raw_call2(raw_load(job), raw_load(job + 8), raw_load(job + 16));
    raw_store(job + 24, r);
    raw_atomic_store(job + 32, 1);
    rt_wake(raw_load(job + 40));
    return 0;
}
fn rt_offload(f: u64, a: u64, b: u64) -> u64 {
    t := rt_current();
    job := rt_alloc(48);
    raw_store(job, f);
    raw_store(job + 8, a);
    raw_store(job + 16, b);
    raw_store(job + 40, t);
    thread := rt_thread_spawn(rt_offload_main, job);
    while raw_atomic_load(job + 32) == 0 {
        rt_suspend(t);
    }
    rt_thread_join(thread);
    r := raw_load(job + 24);
    rt_free(job);
    return r;
}

// ---- host services for the grail command-line tool ----
fn rt_bytes_from(p: u64, n: u64) -> u64 {
    out := rt_new();
    mut i = 0;
    while i < n {
        rt_pushb(out, raw_byte(p + i));
        i += 1;
    }
    return out;
}
fn f_host_env(name: u64) -> u64 {
    n := rt_len(name);
