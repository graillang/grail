}
// The same monotonic clock in microseconds: a frame time or a join cost is not measurable in
// whole milliseconds.
fn f_host_now_us() -> u64 {
    spec := rt_alloc(16);
    rt_syscall(228, 1, spec, 0);
    us := raw_load(spec) * 1000000 + rt_div(raw_load(spec + 8), 1000);
    rt_free(spec);
    return us;
}
// CLOCK_REALTIME (clockid 0) in milliseconds since the Unix epoch; the wall clock a program
// reports rather than the monotonic one it measures with. Both fit u64 milliseconds.
fn f_host_wall_ms() -> u64 {
    spec := rt_alloc(16);
    rt_syscall(228, 0, spec, 0);
    ms := raw_load(spec) * 1000 + rt_div(raw_load(spec + 8), 1000000);
    rt_free(spec);
    return ms;
}
