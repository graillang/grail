    n := rt_len(s);
    if (index < n) == 0 {
        rt_abort();
    }
    v := rt_at4(s, index);
    mut i = index;
    while i + 1 < n {
        rt_set4(s, i, rt_at4(s, i + 1));
        i += 1;
    }
    rt_pop4(s);
    return v;
}
fn rt_vec_swap4(s: u64, i: u64, j: u64) -> u64 {
    n := rt_len(s);
    if ((i < n) == 0) + ((j < n) == 0) {
        rt_abort();
    }
    a := rt_at4(s, i);
    rt_set4(s, i, rt_at4(s, j));
    rt_set4(s, j, a);
    return 0;
}
fn rt_vec_reverse4(s: u64) -> u64 {
    n := rt_len(s);
    mut i = 0;
    while i < rt_div(n, 2) {
        rt_vec_swap4(s, i, n - 1 - i);
        i += 1;
    }
    return 0;
