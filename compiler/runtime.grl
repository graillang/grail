    return rt_pushb(s, v);
}
// Grows a byte sequence's capacity to at least `need` bytes (doubling, minimum 16).
fn rt_reserveb(s: u64, need: u64) -> u64 {
    cap := raw_load(wrapping_add(s, 16));
    if need < cap + 1 {
        return 0;
    }
    mut capacity = cap * 2;
    if capacity < 16 {
        capacity = 16;
    }
    while capacity < need {
        capacity = capacity * 2;
    }
    if 1152921504606846976 < capacity {
        rt_abort();
