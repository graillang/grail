// `raw_atomic_fetch_sub`, `raw_atomic_swap` and `raw_atomic_fence` intrinsics: built by it, these
// are the calls; built by a compiler that has the intrinsics, the name is the intrinsic (a raw
// intrinsic is never shadowed, native.grl) and these bodies are never called. Delete them at the
// next reseed.
fn raw_atomic_fetch_add(p: u64, value: u64) -> u64 {
    mut old = raw_atomic_load(p);
    while true {
        observed := raw_atomic_cas(p, old, wrapping_add(old, value));
        if observed == old {
            return old;
        }
        old = observed;
    }
    return 0;
}
fn raw_atomic_fetch_sub(p: u64, value: u64) -> u64 {
    mut old = raw_atomic_load(p);
    while true {
        observed := raw_atomic_cas(p, old, wrapping_sub(old, value));
        if observed == old {
            return old;
        }
        old = observed;
    }
    return 0;
}
// The seed lowers its compare-and-swap with full barriers on both sides on every target, so a CAS
// on a word of this frame is its full fence.
fn raw_atomic_fence() -> u64 {
    mut word = 0;
    at := &mut word;
    raw_atomic_cas(at, 0, 0);
    return 0;
}
fn raw_atomic_swap(p: u64, value: u64) -> u64 {
    mut old = raw_atomic_load(p);
    while true {
        observed := raw_atomic_cas(p, old, value);
        if observed == old {
            return old;
        }
        old = observed;
    }
    return 0;
}

// ---- parking: one way to wait (docs/design/parking.md) ------------------------------------------
// Everything that waits - a task, a job in its runner task, a thread - waits the same way: its
// WAITER BLOCK is linked on the queue of the thing it waits for, and it sleeps until a waker sets the
// block's state. One execution waits for one thing at a time, so the block is part of the waiter's
// own record and nothing is allocated to wait: a task's is the tail of its record (rt_task_record_
// size), a thread's hangs off thread-record word 96 (the main thread's is in process state, rt_main_waiter).
//
// Waiter block, 7 words and held slots:
//   0 next in the queue   8 state (0 waiting, 1 woken, 2 granted what it waited for)
//   16 what it asked for (a primitive's own use)   24 the queue's last block (kept in the head)
//   32 HELD LIST: the locks this execution holds, newest first (rt_held_settle)
//   40 the task record this block belongs to, 0 for a thread   48 how many held slots follow
//   56.. held slots of 48 bytes (rt_held_node): a read lock, permits or a Once costs no allocation
//   until an execution holds more of them than it has slots.
//
// A queue is one word in the primitive: the low four bits are the primitive's flags - bit 1 is the
// queue's own lock - and the rest is the first waiter block (blocks are 16-byte aligned).
//
// The protocol, and why each step is there:
//   wait:  take the queue lock; LOOK AGAIN at the condition (the release may have happened while
//          this execution was deciding to wait); link the block; drop the lock; sleep until the
//          state is not 0. A task sleeps in rt_suspend, which does not lose a wake that came first;
//          a thread sleeps on the state word with the kernel checking that it is still 0.
//   wake:  under the queue lock: unlink the block, set its state, wake its owner (rt_wake for a
//          task, a futex wake for a thread).
//   after: the waiter takes and drops the queue lock once more before it returns. The waker did
//          its wake under that lock, so from here on no waker can still be touching this block or
//          this task's record - a task that returned could finish and be freed, and an idle runner
//          must never be woken. Then the waiter clears a wake that is still pending on its task,
//          so its next sleep does not return early.
// A task that waits may resume on another worker: the block names the task record, never a thread.
// The main thread's waiter block. Process state is only 8-byte aligned and a queue word keeps
// flags in the low four bits of a block's address, so the block is rounded up to 16 inside the
// words reserved for it (1920..1984).
fn rt_main_waiter() -> u64 {
    return (raw_state() + 1935) & 18446744073709551600;
}
// The main thread's block has room for one held slot (1920..2048).
fn rt_main_waiter_ready() -> u64 {
    b := rt_main_waiter();
    raw_store(b + 48, 1);
    return b;
}
fn rt_task_record_size() -> u64 {
    // 240 bytes of task record and the waiter block (56 bytes and four held slots of 48): 488,
    // rounded to 16, because a runner record is carved right after the last and a waiter block's
    // address shares its queue word with four flag bits.
    return 496;
}
// The current execution's waiter block, or 0 for a thread that has none yet. Never allocates.
fn rt_waiter_peek() -> u64 {
    t := rt_current();
    if t != 0 {
        return t + 240;
    }
    tp := raw_tp_get();
    if tp == 0 {
        return rt_main_waiter();
    }
    return raw_load(tp + 96);
}
fn rt_waiter() -> u64 {
    t := rt_current();
    if t != 0 {
        raw_store(t + 280, t);
        raw_store(t + 288, 4);
        return t + 240;
    }
    tp := raw_tp_get();
    if tp == 0 {
        return rt_main_waiter_ready();
    }
    mut b = raw_load(tp + 96);
    if b == 0 {
        if tp == raw_state() + 128 {
            b = rt_main_waiter_ready();
        } else {
            b = rt_alloc(248);
            raw_store(b + 48, 4);
        }
        raw_store(tp + 96, b);
    }
    return b;
}
// A thread that ends gives its block back (rt_thread_main); the main thread's is static.
fn rt_waiter_free(record: u64) -> u64 {
    b := raw_load(record + 96);
    if (b != 0) & (b != rt_main_waiter()) {
        raw_store(record + 96, 0);
        rt_free(b);
    }
    return 0;
}
// The queue lock is a spin lock, and the thread that holds it can be preempted by the OS: nobody
// may spin on it without bound. A short spin, then the OS thread is yielded each time round.
fn rt_q_lock(q: u64) -> u64 {
    mut spins = 0;
    while true {
        s := raw_atomic_load(q);
        if (s & 2) == 0 {
            if raw_atomic_cas(q, s, s | 2) == s {
                return 0;
            }
        }
        spins = spins + 1;
        if 64 < spins {
            rt_syscall_low(24, 0, 0, 0);
        }
    }
    return 0;
}
// Change the flag bits of a queue word: clear `off`, then set `on`. The flags move under compare-
// and-swap because a primitive's fast path changes its own bits without the queue lock.
fn rt_q_flags(q: u64, off: u64, on: u64) -> u64 {
    while true {
        s := raw_atomic_load(q);
        if raw_atomic_cas(q, s, (s & (18446744073709551615 - off)) | on) == s {
            return s;
        }
    }
    return 0;
}
fn rt_q_unlock(q: u64) -> u64 {
    return rt_q_flags(q, 2, 0);
}
fn rt_q_head(q: u64) -> u64 {
    return raw_atomic_load(q) & 18446744073709551600;
}
fn rt_q_set_head(q: u64, b: u64) -> u64 {
    while true {
        s := raw_atomic_load(q);
        if raw_atomic_cas(q, s, (s & 15) | b) == s {
            return 0;
        }
    }
    return 0;
}
// Queue lock held for the four below.
fn rt_q_push(q: u64, b: u64) -> u64 {
    raw_store(b, 0);
    h := rt_q_head(q);
    if h == 0 {
        raw_store(b + 24, b);
        return rt_q_set_head(q, b);
    }
    raw_store(raw_load(h + 24), b);
    raw_store(h + 24, b);
    return 0;
}
fn rt_q_push_front(q: u64, b: u64) -> u64 {
    h := rt_q_head(q);
    raw_store(b, h);
    if h == 0 {
        raw_store(b + 24, b);
    } else {
        raw_store(b + 24, raw_load(h + 24));
    }
    return rt_q_set_head(q, b);
}
fn rt_q_pop(q: u64) -> u64 {
    h := rt_q_head(q);
    if h == 0 {
        return 0;
    }
    next := raw_load(h);
    if next != 0 {
        raw_store(next + 24, raw_load(h + 24));
    }
    rt_q_set_head(q, next);
    return h;
}
// Take `b` out of the queue wherever it is; 1 when it was there. A waiter that gives up (a
// deadline, a cancellation) withdraws itself with this - and if a waker got to it first, it is not
// there and the wake stands.
fn rt_q_remove(q: u64, b: u64) -> u64 {
    h := rt_q_head(q);
    if h == 0 {
        return 0;
    }
    if h == b {
        rt_q_pop(q);
        return 1;
    }
    mut prev = h;
    while raw_load(prev) != 0 {
        at := raw_load(prev);
        if at == b {
            raw_store(prev, raw_load(b));
            if raw_load(h + 24) == b {
                raw_store(h + 24, prev);
            }
            return 1;
        }
        prev = at;
    }
    return 0;
}
// Sleep until a waker sets this block's state; the answer is that state (1 woken, 2 granted), or
// 3 when the deadline passed and 4 when the task's scope was cancelled - in those two cases the
// block has been taken off the queue again, under the queue lock, so no waker can still grant it;
// a waker that got there first wins and its answer stands. The block was linked, with state 0,
// under the queue lock.
//   until  the monotonic clock (host::now_ms) at which to give up; 0 waits for good
//   flags  1: a task's wait ends when its scope is cancelled (lock waits do not ask for this - a
//          lock wait is bounded by its holder's progress, and cancelling a task that holds lock A
//          while it waits for B would poison A; lock_until is the cancellable form)
// A task's deadline is the scheduler's own timer (the one host::sleep_ms parks on); a thread's is
// the kernel wait's timeout. Where no timer can be armed (Windows) a task with a deadline yields
// and looks at the clock instead of sleeping.
fn rt_park(b: u64, q: u64) -> u64 {
    return rt_park_until(b, q, 0, 0);
}
fn rt_park_until(b: u64, q: u64, until: u64, flags: u64) -> u64 {
    owner := raw_load(b + 40);
    // Inside a parallel region (task word 152) a wait is a job's, and a job does not observe its
    // scope's cancellation by waking: it asks (pool::cancelled). A job runs inline on its forker's
    // stack or stolen on a runner whose token never fires, and the two must behave alike; and a
    // failing stack's drain must not be cut short.
    mut cancellable = 0;
    if ((flags & 1) != 0) & (owner != 0) {
        cancellable = raw_load(owner + 152) == 0;
    }
    mut token = 0;
    if cancellable {
        token = raw_load(owner + 72);
        // Set before the token is read: rt_cancel stores the token first and then wakes every task
        // that has this word set, so one of the two sees the other.
        raw_atomic_store(owner + 128, 1);
    }
    mut poll = 0;
    if (until != 0) & (owner != 0) & ((rt_task_threads() != 0) | (rt_os_reactor() == 0)) {
        poll = 1;
    }
    mut code = 0;
    while raw_atomic_load(b + 8) == 0 {
        mut give_up = 0;
        if cancellable {
            if raw_atomic_load(token) != 0 {
                give_up = 4;
            }
        }
        if (give_up == 0) & (until != 0) {
            if until <= f_host_now_ms() {
                give_up = 3;
            }
        }
        if give_up != 0 {
            rt_q_lock(q);
            if rt_q_remove(q, b) {
                rt_q_unlock(q);
                code = give_up;
                break;
            }
            // Already granted: the waker is setting the state now.
            rt_q_unlock(q);
            continue;
        }
        if owner != 0 {
            if poll {
                rt_yield();
            } else {
                if until != 0 {
                    // A timer for what is left of the deadline, armed per pass (see rt_sleep_for).
                    now := f_host_now_ms();
                    mut armed = 0;
                    if now < until {
                        armed = rt_os_timer(rt_sched(), owner, until - now) == 0;
                    }
                    if armed {
                        rt_suspend(owner);
                        rt_os_timer_done(rt_sched(), owner);
                    } else {
                        rt_yield();
                    }
                } else {
                    rt_suspend(owner);
                }
            }
        } else {
            if until != 0 {
                rt_os_wait_ms(b + 8, 0, until - f_host_now_ms());
            } else {
                rt_syscall_low(202, b + 8, 128, 0);
            }
        }
    }
    if cancellable {
        raw_atomic_store(owner + 128, 0);
    }
    // The waker finished under this lock: nothing of this wait is in flight after it.
    rt_q_lock(q);
    rt_q_unlock(q);
    if owner != 0 {
        raw_atomic_cas(owner + 24, 3, 0);
    }
    if code != 0 {
        return code;
    }
    return raw_load(b + 8);
}
// A plain wait that was cancelled ends its task: a failure of kind 16, contained like any other,
// which try_join reports as a TaskFailure and join re-raises (docs/design/parking.md).
fn rt_wait_cancelled() -> u64 {
    return rt_fail_message(16, rt_lit_text("the wait was cancelled"));
}
fn rt_lit_text(text: string) -> u64 {
    v := view(text);
    s := rt_new();
    rt_reserveb(s, v.len());
    mut i = 0;
    while i < v.len() {
        raw_putbyte(raw_load(s) + i, u64(v[i]));
        i = i + 1;
    }
    raw_store(s + 8, v.len());
    return s;
}
// Wake an unlinked waiter with `state` (1 woken, 2 granted). Queue lock held, and held until this
// returns: see rt_park.
fn rt_unpark(b: u64, state: u64) -> u64 {
    owner := raw_load(b + 40);
    raw_atomic_store(b + 8, state);
    if owner != 0 {
        return rt_wake(owner);
    }
    rt_syscall_low(202, b + 8, 129, 1);
    return 0;
}

// ---- Mutex<T> ------------------------------------------------------------------------------------
// Block: 0 the word (bit 0 locked, bit 1 queue lock, bit 2 poisoned, bit 3 a waiter is owed the
// lock, the rest the queue), 8 the payload, 16 the next lock its holder holds (held list), 24 the
// statement that failed while holding it (a site-table entry; 0 when not poisoned or not known),
// 32 the held-list kind (1).
//
// An uncontended lock or unlock is one compare-and-swap. A lock that is held is tried a few dozen
// times more - most holds are shorter than a sleep - and then the caller parks: no yield loop, so
// waiters cost nothing while they wait.
//
// Unlock is BARGING WITH A BOUND. It clears the lock and wakes the first waiter, which then
// competes with whoever arrives; handing the lock straight to the waiter would leave it idle from
// the unlock until that waiter is actually running, on every contended acquisition. A waiter that
// is woken and loses asks for the lock by name (bit 3, and it queues at the front): the next unlock
// passes ownership to it directly and new arrivals queue behind. So a waiter loses at most once.
fn rt_mutex_new(value: u64) -> u64 {
    p := rt_alloc(48);
    raw_store(p + 8, value);
    raw_store(p + 32, 1); // a held-list entry of kind 1 (rt_held_settle)
    return p;
}
fn rt_mutex_try(p: u64) -> u64 {
    s := raw_atomic_load(p);
    if (s & 9) != 0 {
        return 0;
    }
    return raw_atomic_cas(p, s, s | 1) == s;
}
fn rt_mutex_acquire(p: u64) -> u64 {
    return rt_mutex_acquire_until(p, 0, 0);
}
// 0 with the lock held, or rt_park_until's 3 (deadline) or 4 (cancelled).
fn rt_mutex_acquire_until(p: u64, until: u64, flags: u64) -> u64 {
    if rt_mutex_try(p) {
        return 0;
    }
    mut i = 0;
    while i < 40 {
        if rt_mutex_try(p) {
            return 0;
        }
        i = i + 1;
    }
    b := rt_waiter();
    mut lost = 0;
    while true {
        rt_q_lock(p);
        // Look again, under the queue lock: an unlock that found no waiter has already gone.
        mut got = 0;
        while true {
            s := raw_atomic_load(p);
            if (s & 9) != 0 {
                break;
            }
            if raw_atomic_cas(p, s, s | 1) == s {
                got = 1;
                break;
            }
        }
        if got {
            rt_q_unlock(p);
            return 0;
        }
        raw_atomic_store(b + 8, 0);
        if lost {
            rt_q_flags(p, 0, 8);
            rt_q_push_front(p, b);
        } else {
            rt_q_push(p, b);
        }
        rt_q_unlock(p);
        r := rt_park_until(b, p, until, flags);
        if r == 2 {
            return 0;
        }
        if 2 < r {
            return r;
        }
        if rt_mutex_try(p) {
            return 0;
        }
        lost = 1;
    }
    return 0;
}
fn rt_mutex_release(p: u64) -> u64 {
    while true {
        s := raw_atomic_load(p);
        if (s & 18446744073709551610) != 0 {
            break;
        }
        // No waiter, no queue lock held, nobody owed the lock.
        if raw_atomic_cas(p, s, s & 4) == s {
            return 0;
        }
    }
    rt_q_lock(p);
    b := rt_q_pop(p);
    if b == 0 {
        rt_q_flags(p, 9, 0);
    } else {
        if (raw_atomic_load(p) & 8) != 0 {
            // Owed: the lock stays locked and changes hands.
            rt_q_flags(p, 8, 0);
            rt_unpark(b, 2);
        } else {
            rt_q_flags(p, 1, 0);
            rt_unpark(b, 1);
        }
    }
    rt_q_unlock(p);
    return 0;
}
// ---- what an execution holds, and what happens to it when the execution fails ------------------
// A failed check discards its stack whole: no frame runs its unlock. So every execution keeps a
// list of the locks it holds (waiter block word 32; a mutex's link is word 16 of its own block,
// since it has one holder), and the one place a failing stack is left - rt_contain_tail - settles
// the list before it switches away: each mutex is POISONED with the failing statement's site and
// released. A later lock_with fails its caller with a message that names that statement
// (rt_mutex_lock); sync::recover_with gives access anyway and clears the poison. The walk is a
// function of its own so that a failure contained somewhere else (a job's, when that is contained)
// can call it.
// Held-list entries are linked through word 16 and say what they are in word 32: a mutex block is
// its own entry (kind 1); everything else is a 48-byte node {0 the object, 8 a count, 16 next,
// 32 kind}: 2 semaphore permits, 3 a read lock, 4 a write lock, 5 a Once being initialised.
// The current execution's waiter block, from the thread pointer, when it is ready (a task's slot
// count is set, a thread has one); otherwise rt_waiter makes it ready.
fn rt_block_fast() -> u64 {
    tp := raw_tp_get();
    if tp != 0 {
        t := raw_load(wrapping_add(tp, 16));
        if t != 0 {
            b := wrapping_add(t, 240);
            if raw_load(wrapping_add(b, 48)) != 0 {
                return b;
            }
            return rt_waiter();
        }
        b := raw_load(wrapping_add(tp, 96));
        if b != 0 {
            return b;
        }
    }
    return rt_waiter();
}
fn rt_held_push(p: u64) -> u64 {
    b := rt_block_fast();
    raw_store(p + 16, raw_load(b + 32));
    raw_store(b + 32, p);
    return 0;
}
fn rt_held_node(object: u64, count: u64, kind: u64) -> u64 {
    b := rt_block_fast();
    // The first slot is the one a callback-scoped hold almost always finds free.
    first := wrapping_add(b, 56);
    if (raw_load(wrapping_add(b, 48)) != 0) & (raw_load(wrapping_add(first, 32)) == 0) {
        raw_store(first, object);
        raw_store(wrapping_add(first, 8), count);
        raw_store(wrapping_add(first, 32), kind);
        raw_store(wrapping_add(first, 16), raw_load(wrapping_add(b, 32)));
        raw_store(wrapping_add(b, 32), first);
        return first;
    }
    slots := raw_load(wrapping_add(b, 48));
    mut n = 0;
    mut i = 0;
    while i < slots {
        at := wrapping_add(wrapping_add(b, 56), wrapping_mul(i, 48));
        if raw_load(wrapping_add(at, 32)) == 0 {
            n = at;
            break;
        }
        i = wrapping_add(i, 1);
    }
    if n == 0 {
        n = rt_alloc(48);
    }
    raw_store(n, object);
    raw_store(wrapping_add(n, 8), count);
    raw_store(wrapping_add(n, 32), kind);
    raw_store(wrapping_add(n, 16), raw_load(wrapping_add(b, 32)));
    raw_store(wrapping_add(b, 32), n);
    return n;
}
// A held node goes back: a slot is marked free, an allocated node freed.
fn rt_held_free(b: u64, e: u64) -> u64 {
    first := wrapping_add(b, 56);
    if (e < first) | (wrapping_add(first, wrapping_mul(raw_load(wrapping_add(b, 48)), 48)) < wrapping_add(e, 1)) {
        return rt_free(e);
    }
    raw_store(wrapping_add(e, 32), 0);
    return 0;
}
// Take entry `e` off the current execution's list.
fn rt_held_pop(e: u64) -> u64 {
    return rt_held_unlink(rt_block_fast(), e);
}
// Take `e` off block `b`'s list; callback-scoped holds make it the head almost always.
fn rt_held_unlink(b: u64, e: u64) -> u64 {
    if raw_load(wrapping_add(b, 32)) == e {
        raw_store(wrapping_add(b, 32), raw_load(wrapping_add(e, 16)));
        return 0;
    }
    mut at = raw_load(b + 32);
    while at != 0 {
        if raw_load(at + 16) == e {
            raw_store(at + 16, raw_load(e + 16));
            return 0;
        }
        at = raw_load(at + 16);
    }
    rt_abort();
    return 0;
}
// The newest node of `kind` on `object`, taken off the list and freed; its count is the answer.
fn rt_held_drop(object: u64, kind: u64) -> u64 {
    b := rt_block_fast();
    head := raw_load(wrapping_add(b, 32));
    if (head == wrapping_add(b, 56)) & (raw_load(head) == object) & (raw_load(wrapping_add(head, 32)) == kind) {
        // The newest hold, in the first slot: unlinked and freed in place.
        raw_store(wrapping_add(b, 32), raw_load(wrapping_add(head, 16)));
        raw_store(wrapping_add(head, 32), 0);
        return raw_load(wrapping_add(head, 8));
    }
    mut at = raw_load(wrapping_add(b, 32));
    while at != 0 {
        if (raw_load(wrapping_add(at, 32)) == kind) & (raw_load(at) == object) {
            n := raw_load(wrapping_add(at, 8));
            rt_held_unlink(b, at);
            rt_held_free(b, at);
            return n;
        }
        at = raw_load(at + 16);
    }
    rt_abort();
    return 0;
}
// Whether the current execution holds any lock. The scheduler asks before it lets a waiting
// execution help with other jobs: one that holds a lock parks instead, because a job it helped
// with might want that lock. Never allocates.
fn rt_holds_any() -> u64 {
    b := rt_waiter_peek();
    if b == 0 {
        return 0;
    }
    return raw_load(b + 32) != 0;
}
// `site` is the failing statement's site-table entry, or 0. It never allocates and never parks; it
// frees the nodes it settles, and each release takes a queue lock (a bounded spin) and wakes.
fn rt_held_settle(b: u64, site: u64) -> u64 {
    while raw_load(b + 32) != 0 {
        e := raw_load(b + 32);
        raw_store(b + 32, raw_load(e + 16));
        kind := raw_load(e + 32);
        if kind == 1 {
            if (raw_atomic_load(e) & 4) == 0 {
                raw_store(e + 24, site);
            }
            rt_q_flags(e, 0, 4);
            rt_mutex_release(e);
        } else {
            object := raw_load(e);
            if kind == 2 {
                rt_sem_release(object, raw_load(e + 8));
            }
            if kind == 3 {
                rt_rw_unlock_read(object);
            }
            if kind == 4 {
                if (raw_atomic_load(object) & 4) == 0 {
                    raw_store(object + 24, site);
                }
                rt_q_flags(object, 0, 4);
                rt_rw_unlock_write(object);
            }
            if kind == 5 {
                rt_once_reset(object);
            }
            rt_held_free(b, e);
        }
    }
    return 0;
}
// A failure with a message the runtime wrote: contained by a task or a dedicated thread, fatal
// anywhere else - the rules of rt_task_fail, which is this with the program's own text.
fn rt_fail_message(kind: u64, msg: u64) -> u64 {
    j := rt_job_failing();
    if j != 0 {
        return rt_job_fail_here(j, kind, 0, 0, msg);
    }
    t := rt_containable();
    if t != 0 {
        return rt_contain_site(t, kind, 0, 0, rt_site_here(t + 200), msg);
    }
    if rt_abort_begin() == 0 {
        rt_abort_park();
    }
    return rt_report_die(msg, rt_fail_site_full());
}
fn rt_mutex_poisoned(p: u64) -> u64 {
    s := rt_new();
    rt_reserveb(s, 600);
    buf := raw_load(s);
    mut n = rt_fail_put(buf, 0, view("mutex poisoned: its holder failed"));
    site := raw_load(p + 24);
    if site != 0 {
        n = rt_fail_line(buf, n, site, " at ");
        // The location line ends in a newline; the message is one line.
        if (n != 0) & (raw_byte(buf + n - 1) == 10) {
            n = n - 1;
        }
    }
    raw_store(s + 8, n);
    return rt_fail_message(17, s);
}
fn rt_mutex_lock(p: u64) -> u64 {
    // The uncontended path, inline: one compare-and-swap from 0 (free, not poisoned, nobody queued)
    // and the held-list push on the waiter block the thread pointer leads to. Everything else -
    // a held lock, a poisoned one, a thread with no block yet - takes the general path.
    tp := raw_tp_get();
    if tp != 0 {
        t := raw_load(wrapping_add(tp, 16));
        mut b = 0;
        if t != 0 {
            b = wrapping_add(t, 240);
        } else {
            b = raw_load(wrapping_add(tp, 96));
        }
        if b != 0 {
            if raw_atomic_cas(p, 0, 1) == 0 {
                raw_store(wrapping_add(p, 16), raw_load(wrapping_add(b, 32)));
                raw_store(wrapping_add(b, 32), p);
                return 0;
            }
        }
    }
    return rt_mutex_lock_slow(p);
}
fn rt_mutex_lock_slow(p: u64) -> u64 {
    rt_mutex_acquire(p);
    if (raw_atomic_load(p) & 4) != 0 {
        rt_mutex_release(p);
        return rt_mutex_poisoned(p);
    }
    return rt_held_push(p);
}
fn rt_mutex_unlock(p: u64) -> u64 {
    // Inline: a callback-scoped lock is the newest entry of its holder's list, and with nobody
    // queued and nothing flagged the word goes from 1 back to 0 in one compare-and-swap.
    tp := raw_tp_get();
    if tp != 0 {
        t := raw_load(wrapping_add(tp, 16));
        mut b = 0;
        if t != 0 {
            b = wrapping_add(t, 240);
        } else {
            b = raw_load(wrapping_add(tp, 96));
        }
        if b != 0 {
            if raw_load(wrapping_add(b, 32)) == p {
                raw_store(wrapping_add(b, 32), raw_load(wrapping_add(p, 16)));
                if raw_atomic_cas(p, 1, 0) != 1 {
                    rt_mutex_release(p);
                }
                return 0;
            }
        }
    }
    rt_held_pop(p);
    return rt_mutex_release(p);
}
// sync::try_lock_with: 1 with the lock held, 0 when it is held by someone else. A poisoned mutex
// fails the caller here too - "not available" would hide it.
fn f_host_mutex_try_lock(p: u64) -> u64 {
    if rt_mutex_try(p) == 0 {
        return 0;
    }
    if (raw_atomic_load(p) & 4) != 0 {
        rt_mutex_release(p);
        return rt_mutex_poisoned(p);
    }
    rt_held_push(p);
    return 1;
}
fn f_host_mutex_unlock(p: u64) -> u64 {
    return rt_mutex_unlock(p);
}
// sync::recover_with: the lock, poisoned or not; its unlock clears the poison.
fn f_host_mutex_lock_recover(p: u64) -> u64 {
    rt_mutex_acquire(p);
    return rt_held_push(p);
}
fn f_host_mutex_unlock_recover(p: u64) -> u64 {
    rt_q_flags(p, 4, 0);
    raw_store(p + 24, 0);
    return rt_mutex_unlock(p);
}
fn f_host_mutex_poisoned(p: u64) -> u64 {
    return (raw_atomic_load(p) & 4) != 0;
}

// sync::lock_until: 0 with the lock held, 3 when the deadline passed, 4 when cancelled.
fn f_host_mutex_lock_until(p: u64, until: u64) -> u64 {
    r := rt_mutex_acquire_until(p, until, 1);
    if r != 0 {
        return r;
    }
    if (raw_atomic_load(p) & 4) != 0 {
        rt_mutex_release(p);
        return rt_mutex_poisoned(p);
    }
    rt_held_push(p);
    return 0;
}
// The answer of a wait that has a deadline or a cancellable form: 0 done, 3 timed out, 4 cancelled.
// `plain` (flags bit 2) turns a cancellation into the task's failure instead.
fn rt_wait_answer(r: u64, flags: u64) -> u64 {
    if (r == 4) & ((flags & 2) != 0) {
        return rt_wait_cancelled();
    }
    if 2 < r {
        return r;
    }
    return 0;
}

// ---- RwLock<T> (lib/sync.grl) -----------------------------------------------------------------
// Block: 0 queue word (bit 2 poisoned), 8 STATE: bit 0 a writer holds it, bit 1 someone is queued
// or a writer waits (the fast paths step aside), the rest four times the readers holding it;
// 16 writers waiting (queue lock held), 24 the poisoning statement, 32 the payload.
// Uncontended read and write locks and unlocks are one atomic operation on the state word; the
// queue lock is taken only when bit 1 is or must be set. Writer-preferring: a reader that arrives
// while a writer waits queues behind it, so a frame's writer is not starved by a stream of
// readers. A queued block's request word is 1 for a reader, 2 for a writer.
fn rt_rw_try_read(l: u64) -> u64 {
    st := wrapping_add(l, 8);
    mut s = raw_atomic_load(st);
    while (s & 3) == 0 {
        seen := raw_atomic_cas(st, s, wrapping_add(s, 4));
        if seen == s {
            return 1;
        }
        s = seen;
    }
    return 0;
}
fn rt_rw_try_write(l: u64) -> u64 {
    return raw_atomic_cas(wrapping_add(l, 8), 0, 1) == 0;
}
// Atomically clear or set bits of a word; the answer is the word before.
fn rt_word_and(p: u64, mask: u64) -> u64 {
    mut old = raw_atomic_load(p);
    while true {
        seen := raw_atomic_cas(p, old, old & mask);
        if seen == old {
            return old;
        }
        old = seen;
    }
    return old;
}
fn rt_word_or(p: u64, bits: u64) -> u64 {
    mut old = raw_atomic_load(p);
    while true {
        seen := raw_atomic_cas(p, old, old | bits);
        if seen == old {
            return old;
        }
        old = seen;
    }
    return old;
}
// Queue lock held: grant what the head of the queue can have, and clear bit 1 when nobody is left.
fn rt_rw_dispatch(l: u64) -> u64 {
    st := l + 8;
    while true {
        h := rt_q_head(l);
        if h == 0 {
            break;
        }
        s := raw_atomic_load(st);
        if (s & 1) != 0 {
            return 0;
        }
        if raw_load(h + 16) == 2 {
            if 3 < s {
                return 0;
            }
            rt_q_pop(l);
            raw_store(l + 16, raw_load(l + 16) - 1);
            raw_atomic_fetch_add(st, 1);
            rt_unpark(h, 2);
            break;
        }
        rt_q_pop(l);
        raw_atomic_fetch_add(st, 4);
        rt_unpark(h, 2);
    }
    if (rt_q_head(l) == 0) & (raw_load(l + 16) == 0) {
        rt_word_and(st, 18446744073709551613);
    }
    return 0;
}
fn rt_rw_poisoned(l: u64) -> u64 {
    s := rt_new();
    rt_reserveb(s, 600);
    buf := raw_load(s);
    mut n = rt_fail_put(buf, 0, view("rwlock poisoned: a writer failed"));
    site := raw_load(l + 24);
    if site != 0 {
        n = rt_fail_line(buf, n, site, " at ");
        if (n != 0) & (raw_byte(buf + n - 1) == 10) {
            n = n - 1;
        }
    }
    raw_store(s + 8, n);
    return rt_fail_message(17, s);
}
// mode 1 read, 2 write; flags as rt_park_until's, plus 4: ignore poison (recover_write).
fn f_host_rw_lock(l: u64, mode: u64, until: u64, flags: u64) -> u64 {
    mut got = 0;
    // Most holds are shorter than a park and a wake: try the fast path for a while first, the
    // way the mutex does (rt_mutex_acquire).
    mut spin = 0;
    while (got == 0) & (spin < 100) {
        if mode == 1 {
            got = rt_rw_try_read(l);
        } else {
            got = rt_rw_try_write(l);
        }
        spin = spin + 1;
    }
    if got == 0 {
        st := l + 8;
        rt_q_lock(l);
        // Step the fast paths aside first, then look: an unlock that came before this sees bit 1
        // and dispatches, one that came after left a state this sees.
        rt_word_or(st, 2);
        s := raw_atomic_load(st);
        if mode == 1 {
            if ((s & 1) == 0) & (raw_load(l + 16) == 0) & (rt_q_head(l) == 0) {
                raw_atomic_fetch_add(st, 4);
                got = 1;
            }
        } else {
            if (s < 4) & ((s & 1) == 0) & (rt_q_head(l) == 0) {
                raw_atomic_fetch_add(st, 1);
                got = 1;
            }
        }
        if got {
            rt_rw_dispatch(l);
            rt_q_unlock(l);
        } else {
            b := rt_waiter();
            raw_atomic_store(b + 8, 0);
            raw_store(b + 16, mode);
            if mode == 2 {
                raw_store(l + 16, raw_load(l + 16) + 1);
            }
            rt_q_push(l, b);
            rt_q_unlock(l);
            r := rt_park_until(b, l, until, flags & 1);
            if r != 2 {
                rt_q_lock(l);
                if mode == 2 {
                    raw_store(l + 16, raw_load(l + 16) - 1);
                }
                // Readers queued behind this writer may go now; bit 1 clears if nobody is left.
                rt_rw_dispatch(l);
                rt_q_unlock(l);
                return rt_wait_answer(r, flags);
            }
        }
    }
    if ((raw_atomic_load(l) & 4) != 0) & ((flags & 4) == 0) & (mode == 2) {
        rt_rw_unlock_write(l);
        return rt_rw_poisoned(l);
    }
    if ((raw_atomic_load(l) & 4) != 0) & (mode == 1) {
        rt_rw_unlock_read(l);
        return rt_rw_poisoned(l);
    }
    // The hold's node is the answer (an address, never 3 or 4): the release takes it back without
    // looking for it (f_host_rw_release).
    return rt_held_node(l, 1, mode + 2);
}
fn f_host_rw_try(l: u64, mode: u64) -> u64 {
    mut got = 0;
    if mode == 1 {
        got = rt_rw_try_read(l);
    } else {
        got = rt_rw_try_write(l);
    }
    if got == 0 {
        return 0;
    }
    if (raw_atomic_load(l) & 4) != 0 {
        if mode == 1 {
            rt_rw_unlock_read(l);
        } else {
            rt_rw_unlock_write(l);
        }
        return rt_rw_poisoned(l);
    }
    return rt_held_node(l, 1, mode + 2);
}
fn rt_rw_unlock_read(l: u64) -> u64 {
    old := raw_atomic_fetch_sub(wrapping_add(l, 8), 4);
    // The last reader out, with someone queued: a writer may go.
    if ((old & 2) != 0) & (old < 8) {
        rt_q_lock(l);
        rt_rw_dispatch(l);
        rt_q_unlock(l);
    }
    return 0;
}
fn rt_rw_unlock_write(l: u64) -> u64 {
    if raw_atomic_cas(wrapping_add(l, 8), 1, 0) == 1 {
        return 0;
    }
    rt_q_lock(l);
    rt_word_and(l + 8, 18446744073709551614);
    rt_rw_dispatch(l);
    rt_q_unlock(l);
    return 0;
}
// Release the hold whose node f_host_rw_lock answered: mode 1 read, 2 write, 3 write that recovers.
fn f_host_rw_release(e: u64, mode: u64) -> u64 {
    l := raw_load(e);
    b := rt_block_fast();
    rt_held_unlink(b, e);
    rt_held_free(b, e);
    if mode == 1 {
        return rt_rw_unlock_read(l);
    }
    if mode == 3 {
        rt_q_flags(l, 4, 0);
        raw_store(l + 24, 0);
    }
    return rt_rw_unlock_write(l);
}
// mode 1 read, 2 write, 3 write that recovers (clears the poison).
fn f_host_rw_unlock(l: u64, mode: u64) -> u64 {
    if mode == 1 {
        rt_held_drop(l, 3);
        return rt_rw_unlock_read(l);
    }
    rt_held_drop(l, 4);
    if mode == 3 {
        rt_q_flags(l, 4, 0);
        raw_store(l + 24, 0);
    }
    return rt_rw_unlock_write(l);
}
fn f_host_rw_poisoned(l: u64) -> u64 {
    return (raw_atomic_load(l) & 4) != 0;
}

// ---- Semaphore (lib/sync.grl) -------------------------------------------------------------------
// Block: 0 queue word, 8 permits available (changed only atomically). With nobody queued, acquire
// and release are one compare-and-swap or add on the permit word. Otherwise FIFO: a request that
// fits is still refused while others queue, so a large request is not starved. Permits are
// returned when their holder fails.
// Queue lock held: grant the head while its request fits.
fn rt_sem_dispatch(m: u64) -> u64 {
    while true {
        h := rt_q_head(m);
        if h == 0 {
            return 0;
        }
        want := raw_load(h + 16);
        have := raw_atomic_load(m + 8);
        if have < want {
            return 0;
        }
        if raw_atomic_cas(m + 8, have, have - want) == have {
            rt_q_pop(m);
            rt_unpark(h, 2);
        }
    }
    return 0;
}
fn rt_sem_release(m: u64, n: u64) -> u64 {
    raw_atomic_fetch_add(wrapping_add(m, 8), n);
    // A waiter links itself and then looks at the permits, both under the queue lock; this adds
    // and then looks for waiters - one of the two sees the other.
    if rt_q_head(m) != 0 {
        rt_q_lock(m);
        rt_sem_dispatch(m);
        rt_q_unlock(m);
    }
    return 0;
}
fn rt_sem_take(m: u64, n: u64) -> u64 {
    if rt_q_head(m) != 0 {
        return 0;
    }
    st := wrapping_add(m, 8);
    mut have = raw_atomic_load(st);
    while (have < n) == 0 {
        seen := raw_atomic_cas(st, have, have - n);
        if seen == have {
            return 1;
        }
        have = seen;
    }
    return 0;
}
// 0 with `n` permits held (the answer's node is on the held list: rt_sem_node), 3, 4.
fn f_host_sem_acquire(m: u64, n: u64, until: u64, flags: u64) -> u64 {
    mut got = 0;
    mut spin = 0;
    while (got == 0) & (spin < 100) {
        got = rt_sem_take(m, n);
        spin = spin + 1;
    }
    if got == 0 {
        b := rt_waiter();
        rt_q_lock(m);
        raw_atomic_store(b + 8, 0);
        raw_store(b + 16, n);
        rt_q_push(m, b);
        // Linked first, then a look at the permits (rt_sem_release); if this block is at the head
        // and fits, it is granted here and does not sleep.
        rt_sem_dispatch(m);
        rt_q_unlock(m);
        r := rt_park_until(b, m, until, flags & 1);
        if r != 2 {
            // A withdrawn head may have been what held the others back.
            rt_q_lock(m);
            rt_sem_dispatch(m);
            rt_q_unlock(m);
            return rt_wait_answer(r, flags);
        }
    }
    // The permits' node is the answer (an address, never 3 or 4).
    return rt_held_node(m, n, 2);
}
// The node of the permits the last acquire on this execution took (a Permit keeps it).
fn f_host_sem_node(m: u64) -> u64 {
    b := rt_block_fast();
    mut at = raw_load(wrapping_add(b, 32));
    while at != 0 {
        if (raw_load(wrapping_add(at, 32)) == 2) & (raw_load(at) == m) {
            return at;
        }
        at = raw_load(wrapping_add(at, 16));
    }
    return 0;
}
fn f_host_sem_try(m: u64, n: u64) -> u64 {
    if rt_sem_take(m, n) {
        return rt_held_node(m, n, 2);
    }
    return 0;
}
// Give back the permits of node `e` (a Permit's drop, or the end of acquire_with).
fn f_host_sem_give(e: u64) -> u64 {
    m := raw_load(e);
    n := raw_load(wrapping_add(e, 8));
    b := rt_block_fast();
    rt_held_unlink(b, e);
    rt_held_free(b, e);
    return rt_sem_release(m, n);
}

// ---- Condition, Latch, Barrier (lib/sync.grl) ----------------------------------------------------
// Each is a queue word and counters. A Condition wait links its block before it releases the
// mutex, and a notify takes the same queue lock, so a notify made under the mutex after the
// predicate changed always finds the waiter.
fn f_host_cond_wait(c: u64, p: u64, until: u64, flags: u64) -> u64 {
    b := rt_waiter();
    rt_q_lock(c);
    raw_atomic_store(b + 8, 0);
    rt_q_push(c, b);
    rt_q_unlock(c);
    rt_mutex_unlock(p);
    r := rt_park_until(b, c, until, flags & 1);
    // The mutex comes back whatever happened, so the caller's unlock is always right.
    rt_mutex_lock(p);
    return rt_wait_answer(r, flags);
}
fn f_host_cond_notify(c: u64, all: u64) -> u64 {
    // Nobody waiting: nothing to do, and no queue lock. Sound because a waiter links itself under
    // the queue lock BEFORE it releases the mutex (f_host_cond_wait), and the notifier changed the
    // state under that mutex after taking it: the link is visible here, or the waiter will still see
    // the new state when it looks again.
    if rt_q_head(c) == 0 {
        return 0;
    }
    rt_q_lock(c);
    while true {
        h := rt_q_pop(c);
        if h == 0 {
            break;
        }
        rt_unpark(h, 1);
        if all == 0 {
            break;
        }
    }
    rt_q_unlock(c);
    return 0;
}
// Latch block: 0 queue word, 8 count.
fn f_host_latch_down(l: u64) -> u64 {
    rt_q_lock(l);
    n := raw_load(l + 8);
    if n != 0 {
        raw_store(l + 8, n - 1);
        if n == 1 {
            while true {
                h := rt_q_pop(l);
                if h == 0 {
                    break;
                }
                rt_unpark(h, 1);
            }
        }
    }
    rt_q_unlock(l);
    return 0;
}
fn f_host_latch_wait(l: u64, until: u64, flags: u64) -> u64 {
    rt_q_lock(l);
    if raw_load(l + 8) == 0 {
        rt_q_unlock(l);
        return 0;
    }
    b := rt_waiter();
    raw_atomic_store(b + 8, 0);
    rt_q_push(l, b);
    rt_q_unlock(l);
    return rt_wait_answer(rt_park_until(b, l, until, flags & 1), flags);
}
// Barrier block: 0 queue word, 8 still to arrive in this round, 16 parties, 24 round.
// The answer is 1 for the one arrival that completes a round (the leader), 0 for the others.
fn f_host_barrier_wait(br: u64, until: u64, flags: u64) -> u64 {
    rt_q_lock(br);
    left := raw_load(br + 8) - 1;
    if left == 0 {
        raw_store(br + 8, raw_load(br + 16));
        raw_store(br + 24, raw_load(br + 24) + 1);
        while true {
            h := rt_q_pop(br);
            if h == 0 {
                break;
            }
            rt_unpark(h, 1);
        }
        rt_q_unlock(br);
        return 1;
    }
    raw_store(br + 8, left);
    round := raw_load(br + 24);
    b := rt_waiter();
    raw_atomic_store(b + 8, 0);
    rt_q_push(br, b);
    rt_q_unlock(br);
    r := rt_park_until(b, br, until, flags & 1);
    if 2 < r {
        // Withdrawn before the round completed: this arrival does not count.
        rt_q_lock(br);
        if raw_load(br + 24) == round {
            raw_store(br + 8, raw_load(br + 8) + 1);
        }
        rt_q_unlock(br);
    }
    return rt_wait_answer(r, flags);
}

// ---- Once<T> (lib/sync.grl) ---------------------------------------------------------------------
// Block: 0 queue word, 8 state (0 empty, 1 being initialised, 2 done), 16 the value. The caller that
// finds it empty initialises it and holds it (held-list kind 5) while it does: if it fails, the Once
// goes back to empty and the callers waiting for it are woken - the next of them runs its own
// initialiser. A Once has no half-built state to protect, so it is not poisoned.
// The answer: 1 run your initialiser, 2 the value is there.
fn f_host_once_begin(o: u64) -> u64 {
    while true {
        rt_q_lock(o);
        st := raw_load(o + 8);
        if st == 2 {
            rt_q_unlock(o);
            return 2;
        }
        if st == 0 {
            raw_store(o + 8, 1);
            rt_q_unlock(o);
            rt_held_node(o, 0, 5);
            return 1;
        }
        b := rt_waiter();
        raw_atomic_store(b + 8, 0);
        rt_q_push(o, b);
        rt_q_unlock(o);
        r := rt_park_until(b, o, 0, 1);
        if r == 4 {
            return rt_wait_cancelled();
        }
    }
    return 0;
}
fn rt_once_finish(o: u64, state: u64) -> u64 {
    rt_q_lock(o);
    raw_store(o + 8, state);
    while true {
        h := rt_q_pop(o);
        if h == 0 {
            break;
        }
        rt_unpark(h, 1);
    }
    rt_q_unlock(o);
    return 0;
}
fn rt_once_reset(o: u64) -> u64 {
    return rt_once_finish(o, 0);
}
fn f_host_once_done(o: u64) -> u64 {
    rt_held_drop(o, 5);
    return rt_once_finish(o, 2);
}

// ---- cancellable sleep ---------------------------------------------------------------------------
// time::sleep_ms in a task whose scope is cancelled while it sleeps fails the task with Cancelled;
// time::try_sleep_ms answers 4 instead. A thread is not cancellable and simply sleeps.
fn f_host_try_sleep_ms(ms: u64) -> u64 {
    return rt_sleep_for(ms, 1);
}
fn rt_sleep_for(ms: u64, flags: u64) -> u64 {
    t := rt_current();
    if (t == 0) | rt_task_threads() | (rt_os_reactor() == 0) {
        rt_sleep_plain(ms);
        return 0;
    }
    if raw_load(t + 152) != 0 {
        // A job's sleep: not cancellable (rt_park_until), but still parked on the timer.
        return rt_sleep_job(t, ms);
    }
    token := raw_load(t + 72);
    raw_atomic_store(t + 128, 1);
    if raw_atomic_load(token) != 0 {
        raw_atomic_store(t + 128, 0);
        return rt_wait_answer(4, flags);
    }
    s := rt_sched();
    until := f_host_now_ms() + ms;
    mut left = ms;
    while left != 0 {
        // A timer per pass, for what is left: a wake that came early (another wake, or a clock
        // that reads a millisecond short when the timer fires) re-arms instead of sleeping for
        // good on a timer that has already fired.
        if rt_os_timer(s, t, left) != 0 {
            raw_atomic_store(t + 128, 0);
            rt_sleep_plain(left);
            return 0;
        }
        rt_suspend(t);
        rt_os_timer_done(s, t);
        if raw_atomic_load(token) != 0 {
            break;
        }
        now := f_host_now_ms();
        if now < until {
            left = until - now;
        } else {
            left = 0;
        }
    }
    raw_atomic_store(t + 128, 0);
    raw_atomic_cas(t + 24, 3, 0);
    if raw_atomic_load(token) != 0 {
        return rt_wait_answer(4, flags);
    }
    return 0;
}

// ---- worker threads (structured fork-join only; see docs/design/structured-parallelism.md) ----
fn rt_cpus() -> u64 {
    buf := rt_alloc(128);
    r := rt_syscall(204, 0, 128, buf);
    mut n = 0;
    if rt_error(r) == 0 {
        mut i = 0;
        while i < 128 {
            mut b = raw_byte(buf + i);
            while b != 0 {
                n += b & 1;
                b = b / 2;
            }
            i += 1;
        }
    }
    rt_free(buf);
    if n == 0 {
        n = 1;
    }
    return n;
}
// Thread handle words: 0 kernel TID (cleared + futex-woken on exit), 1 region base, 2 region size.
fn rt_thread_spawn(entry: u64, arg: u64) -> u64 {
    handle := rt_alloc(24);
    rt_thread_start(entry, arg, handle);
    return handle;
}
// Persistent runtime threads (workers, reactor): no counted handle; the kernel TID word lives in
// the thread's own record and is never joined.
fn rt_thread_spawn_detached(entry: u64, arg: u64) -> u64 {
    rt_thread_start(entry, arg, 0);
    return 0;
}
// One OS thread running entry(arg) on its own worker record. The record is the top 128 bytes of a
// mapped region: {0 self, 8 scheduler sp, 16 current task, 24 entry then the runtime-worker marker,
// 32 arg, 40 TID word of a persistent thread, 48 Windows: the wait value; Linux: the running block's
// foreign-call pair (rt_marker_cache), 56 host TLS base, 64 the
// thread's allocator cache (rt_cache_make; 0 until it allocates), 72 frees made with no cache
// (rt_cache_for_free), 80 the record of the dedicated thread whose closure this thread is running
// (rt_uthread_main; 0 on every other thread), 88 the thread's locals (rt_locals), 96 the thread's
// waiter block (rt_waiter; 0 until it waits or holds a lock), 104 the external scheduler slot's
// block while this thread, not a worker, holds it (rt_external_take), 112 its pool::with_class
// setting plus one (0 none), 120 how many callbacks from C this thread is inside (callback_pin in
// native.grl; rt_suspend pins the task to the thread while it is non-zero)}. Word 24 is
// the entry only until rt_thread_main has read it; a scheduler worker then stores a non-zero
// marker there so rt_abort_signals can tell a runtime worker from any other thread. Word 56 is this thread's libc TCB,
// which every foreign call made on the thread switches to (0: there is none, the call runs on the
// record). The two words under the record are the start block {rt_thread_main, record}.
//
// In a process that loaded libc (process-state word 3216 is set) glibc creates the thread, so it
// has a real TCB of its own: the region is one page holding only the record, glibc owns the stack,
// and rt_host_thread (native.grl) clears the TID word when the thread's Grail work is done. Without
// libc the runtime clones the thread itself on a 1 MiB region with a guard page, and the kernel
// clears the TID word.
fn rt_thread_start(entry: u64, arg: u64, handle: u64) -> u64 {
    // From here on the allocator is shared: see rt_allocator_lock.
    raw_atomic_store_release(raw_state() + 3416, 1);
    bridge := raw_load(rt_state_host_thread());
    if (bridge == 0) & (raw_load(raw_state() + 184) != 0) & (raw_target() != 3) & (raw_target() != 4) {
        // libc is loaded but pthread_create was not linked: a thread cloned here would have no TCB,
        // and its first foreign call would run libc on another thread's.
        rt_thread_no_libc_threads();
    }
    mut size = 1048576;
    if bridge != 0 {
        size = 4096;
    }
    region := raw_map(size);
    if rt_error(region) {
        rt_abort();
    }
    if bridge == 0 {
        if rt_error(rt_syscall(10, region, 4096, 0)) {
            rt_abort();
        } // guard page below the stack
    }
    top := region + size;
    record := top - 128;
    raw_store(record + 24, entry);
    raw_store(record + 32, arg);
    raw_store(record - 16, rt_thread_main);
    raw_store(record - 8, record);
    mut tid_word = record + 40;
    if handle != 0 {
        raw_store(handle + 8, region);
        raw_store(handle + 16, size);
        tid_word = handle;
    }
    if bridge != 0 {
        if rt_error(raw_call2(bridge, record - 16, tid_word)) {
            rt_abort();
        }
        return 0;
    }
    // VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|PARENT_SETTID|CHILD_CLEARTID
    tid := raw_thread_clone(3477248, record - 16, tid_word);
    if rt_error(tid) {
        rt_abort();
    }
    return 0;
}
fn rt_thread_no_libc_threads() -> u64 {
    text := view(
        "grail: this program loaded libc but does not link pthread_create, so the runtime cannot give a new thread a libc TCB; link libc (extern \"C\" lib \"c\"). See docs/ffi.md, \"Dynamic loading and the host TLS bridge\".\n"
    );
    packed := rt_pack(text);
    rt_write_all(2, packed, rt_len(text));
    rt_free(packed);
    rt_abort();
    return 0;
}
// Callback adoption (native.grl tls_enter_callback): a callback entered on a thread C created finds
// no Grail record in `rt_tls_record`. The entry calls rt_adopt_record while still on C's TCB: it maps
// a zeroed record for this thread, word 0 pointing to itself (the thread-pointer ABI) and word 56 the
// thread's own TCB, so foreign calls made inside the callback run on it. The record has no task
// or scheduler state, like the main thread's before it spawns anything. tls_leave_callback
// clears `rt_tls_record` and calls rt_release_record once the outermost callback returns.
// Cost: one mmap and one munmap per outermost callback on such a thread.
fn rt_adopt_record() -> u64 {
    record := raw_map(4096);
    if rt_error(record) {
        rt_abort();
    }
    raw_store(record, record);
    raw_store(record + 56, raw_tp_get());
    return record;
}
fn rt_release_record(record: u64) -> u64 {
    rt_cache_retire(record);
    rt_syscall_low(11, record, 4096, 0);
    return 0;
}
fn rt_thread_main(record: u64) -> u64 {
    raw_store(record, record);
    raw_tp_set(record);
    raw_call2(raw_load(record + 24), raw_load(record + 32), 0);
    rt_waiter_free(record);
    rt_cache_retire(record);
    return 0;
}
// ---- dedicated threads (lib/thread.grl; docs/design/threads.md) --------------------------------
// A dedicated thread is an OS thread that runs one closure and is nothing else: not a scheduler
// worker, not a task (rt_current() is 0 on it, so a wait blocks it in the kernel and nothing is
// stolen onto it). The closure does not run on the OS stack. rt_uthread_main maps a guard-paged
// stack of the size the program asked for and switches onto it, exactly as a worker enters a task,
// which gives three things at once: the stack size is honoured whether or not glibc made the
// thread; running off its end is the task-stack overflow report; and a failed check is contained
// the way a task's is - the failure is written into the record, the stack is left by a switch and
// discarded whole, and the thread then ends normally on its own stack (its allocator cache is
// retired, glibc tears its TCB down, the joiner is woken).
//
// Thread record (rt_alloc, 408 bytes; the words containment touches are where a task record has
// them, so rt_contain_site, rt_task_message and rt_task_site serve both):
//   0 saved stack pointer / fiber   8 stack base   16 stack bytes (in: the request, 0 = 1 MiB)
//   24 OS thread handle (rt_thread_spawn)   40 closure code   48 closure box
//   80 result word (written by the library's wrapper, which knows its type)
//   96 finished (futex word)
//   104 ownership: 0 running and joinable, 1 detached, 2 finished, 3 result kept for a joiner
//   112 start latch (futex word: 0 starting, 1 running, 2 refused)   120 why it was refused
//   128 affinity words in use (0: unpinned)   136 the joiners' queue (rt_q_*)   144 completed   152 priority (0 normal, 1 background,
//   2 high, 3 + p realtime p)   160..192 failure   200..239 site scratch
//   256..383 affinity mask, 16 words   384..399 name, NUL-terminated (15 bytes shown by Linux)
// A refusal is attribute * 65536 + errno: attribute 1 stack, 2 affinity, 3 priority, 4 no threads
// on this platform.
fn rt_uthread_new(f: u64, box: u64) -> u64 {
    rec := rt_alloc(408);
    raw_store(rec + 40, f);
    raw_store(rec + 48, box);
    return rec;
}
// The closure goes with a thread that never ran it.
fn rt_uthread_drop_closure(rec: u64) -> u64 {
    box := raw_load(rec + 48);
    if box != 0 {
        obj := raw_load(box);
        raw_call2(raw_load(obj + 8), obj, 0);
        rt_free(box);
        raw_store(rec + 48, 0);
    }
    return 0;
}
fn f_host_thread_start(rec: u64) -> u64 {
    if rt_os_threads() == 0 {
        rt_uthread_drop_closure(rec);
        rt_free(rec);
        return 4 * 65536 + 38;
    }
    raw_store(rec + 24, rt_thread_spawn(rt_uthread_main, rec));
    while raw_atomic_load(rec + 112) == 0 {
        rt_syscall_low(202, rec + 112, 128, 0);
    }
    if raw_atomic_load(rec + 112) == 2 {
        why := raw_load(rec + 120);
        rt_thread_join(raw_load(rec + 24));
        rt_uthread_drop_closure(rec);
        rt_free(rec);
        return why;
    }
    return 0;
}
fn rt_uthread_refuse(rec: u64, why: u64) -> u64 {
    raw_store(rec + 120, why);
    raw_atomic_store(rec + 112, 2);
    rt_syscall_low(202, rec + 112, 129, 2147483647);
    return 0;
}
// The thread itself, on its OS stack. Everything the program asked of the OS is applied here, by
// the thread, before the closure runs; a refusal is reported to the spawner and the closure does
// not run.
fn rt_uthread_main(rec: u64) -> u64 {
    tp := raw_tp_get();
    // Not a runtime worker (rt_abort_signals, f_host_thread_plain): the entry word is spent.
    raw_store(tp + 24, 0);
    why := rt_os_thread_attr(rec);
    if why != 0 {
        return rt_uthread_refuse(rec, why);
    }
    mut size = raw_load(rec + 16);
    if size == 0 {
        size = 1048576;
    }
    if size < 16384 {
        size = 16384;
    }
    if 1099511627776 < size {
        return rt_uthread_refuse(rec, 65536 + 12);
    }
    // Whole pages, and one more below them for the guard.
    size = (rt_div(size + 4095, 4096) + 1) * 4096;
    if rt_os_body_new(rec, size) != 0 {
        return rt_uthread_refuse(rec, 65536 + 12);
    }
    alt := rt_os_thread_guard();
    raw_store(tp + 80, rec);
    raw_atomic_store(rec + 112, 1);
    rt_syscall_low(202, rec + 112, 129, 2147483647);
    rt_os_ctx_enter(rec);
    // Back on the OS stack: the closure returned, or a failure left its stack where it stood.
    raw_store(tp + 80, 0);
    rt_os_body_free(rec);
    rt_os_thread_unguard(alt);
    rt_locals_drop(tp);
    if raw_atomic_cas(rec + 104, 0, 2) == 1 {
        // Detached: nobody will ask. A failure's text goes with the record.
        msg := raw_load(rec + 192);
        if msg != 0 {
            rt_drop_seq(msg);
        }
        if (raw_load(rec + 184) & 1) == 1 {
            rt_drop_seq(raw_load(rec + 184) & 18446744073709551614);
        }
        rt_free(rec);
        // Its cache is retired by rt_thread_main after this returns, so the count the leak check
        // reads is whole whether or not this thread has gone.
        rt_cache_retire(tp);
        raw_atomic_fetch_sub(rt_detached_word(), 1);
        return 0;
    }
    // Finished is published under the joiners' queue lock, and each joiner is woken under it: a
    // joiner frees this record only after its own pass through that lock (rt_park).
    rt_q_lock(rec + 136);
    raw_atomic_store(rec + 96, 1);
    while true {
        joiner := rt_q_pop(rec + 136);
        if joiner == 0 {
            break;
        }
        rt_unpark(joiner, 1);
    }
    rt_q_unlock(rec + 136);
    return 0;
}
// The closure, on the thread's mapped stack. The library's wrapper stores the result itself
// (f_host_thread_keep), so what comes back here is nothing.
fn rt_uthread_run(rec: u64) -> u64 {
    box := raw_load(rec + 48);
    raw_call2(raw_load(rec + 40), box, 0);
    if box != 0 {
        obj := raw_load(box);
        raw_call2(raw_load(obj + 8), obj, 0);
        rt_free(box);
        raw_store(rec + 48, 0);
    }
    raw_store(rec + 144, 1);
    return 0;
}
fn rt_uthread_enter() -> u64 {
    rec := raw_load(raw_tp_get() + 80);
    rt_uthread_run(rec);
    rt_os_ctx_leave(rec);
    rt_abort();
    return 0;
}
// host::yield_now: give up the processor for a moment (lib/chan.grl's backoff).
fn f_host_yield_now() -> u64 {
    return rt_yield();
}
// The record of the dedicated thread that is running, for the wrapper; 0 anywhere else.
fn f_host_thread_self() -> u64 {
    tp := raw_tp_get();
    if tp == 0 {
        return 0;
    }
    return raw_load(tp + 80);
}
// The wrapper has a result: 1 says a joiner may still come for it, so the wrapper writes it into
// word 80; 0 says the thread was detached, and the wrapper drops it where it stands. The claim and
// a detach are one compare-and-swap each, so exactly one of them wins.
fn f_host_thread_keep(rec: u64) -> u64 {
    return raw_atomic_cas(rec + 104, 0, 3) == 0;
}
// 1: detached, the thread frees its own record when it ends. 0: it had already finished (or kept a
// result), so the caller still owns the handle and joins it.
fn f_host_thread_detach(rec: u64) -> u64 {
    // Counted before the claim, so the thread's own decrement can never come first.
    raw_atomic_fetch_add(rt_detached_word(), 1);
    if raw_atomic_cas(rec + 104, 0, 1) == 0 {
        return 1;
    }
    raw_atomic_fetch_sub(rt_detached_word(), 1);
    return 0;
}
// How many detached threads are still running (process-state word 56). While there is one, the end
// of main neither checks for leaks nor unmaps the arenas: that thread's allocations are its own,
// and it is still using them when the process exits without waiting for it.
fn rt_detached_word() -> u64 {
    return raw_state() + 56;
}
// Wait for the thread's closure to end; the answer is the failure kind, 0 when it returned. The
// caller parks on the thread record's queue (word 136): a task's worker keeps running other tasks,
// a thread sleeps in the kernel, and no helper thread is involved.
fn f_host_thread_wait(rec: u64) -> u64 {
    b := rt_waiter();
    while raw_atomic_load(rec + 96) == 0 {
        rt_q_lock(rec + 136);
        if raw_atomic_load(rec + 96) != 0 {
            rt_q_unlock(rec + 136);
            break;
        }
        raw_atomic_store(b + 8, 0);
        rt_q_push(rec + 136, b);
        rt_q_unlock(rec + 136);
        rt_park(b, rec + 136);
    }
    return raw_load(rec + 160);
}
// After the wait: reap the OS thread and free the record. Whatever the record held - a result, a
// failure's texts - has been taken by the caller.
fn f_host_thread_release(rec: u64) -> u64 {
    rt_thread_join(raw_load(rec + 24));
    rt_free(rec);
    return 0;
}
// A failed thread's `{kind, message, site}`, the record a failed task's try_join carries.
fn f_host_thread_failure(rec: u64) -> u64 {
    kind := raw_load(rec + 160);
    msg := rt_task_message(rec);
    site := rt_task_site(rec);
    out := rt_alloc(24);
    raw_store(out, kind);
    raw_store(out + 8, msg);
    raw_store(out + 16, site);
    return out;
}
// A failed scoped thread's failure, raised here; the record stays for its scope to release.
fn f_host_thread_reraise(rec: u64) -> u64 {
    kind := raw_load(rec + 160);
    msg := rt_task_message(rec);
    site := rt_task_site(rec);
    return rt_fail_text(kind, msg, site);
}
// A failed thread's two failure texts, dropped (a sibling of the failure a scope re-raises).
fn f_host_thread_forget_failure(rec: u64) -> u64 {
    rt_drop_seq(rt_task_message(rec));
    rt_drop_seq(rt_task_site(rec));
    return 0;
}
// `join` of a failed thread: release it and report its failure here, by the rules of any failure
// that already has its texts - contained by an enclosing task or thread, fatal on the main thread.
fn f_host_thread_refail(rec: u64) -> u64 {
    kind := raw_load(rec + 160);
    msg := rt_task_message(rec);
    site := rt_task_site(rec);
    f_host_thread_release(rec);
    return rt_fail_text(kind, msg, site);
}
// Whether the caller is a thread in the sense of lib/thread.grl - the main thread or a dedicated
// one - and not a task or a runtime worker, which may not hold a thread::Ctx.
fn f_host_thread_plain() -> u64 {
    tp := raw_tp_get();
    if tp == 0 {
        return 1;
    }
    return (raw_load(tp + 16) == 0) & (raw_load(tp + 24) == 0);
}
// Sleep until the monotonic clock (host::now_ms) reads `deadline_ms`. A task parks on the ordinary
// sleep path for what is left; a thread sleeps to the absolute time in the kernel, so a frame loop
// does not drift by the time it spent working.
fn f_host_sleep_until_ms(deadline_ms: u64) -> u64 {
    if (rt_current() != 0) & (rt_task_threads() == 0) {
        now := f_host_now_ms();
        if now < deadline_ms {
            f_host_sleep_ms(deadline_ms - now);
        }
        return 0;
    }
    return rt_os_sleep_until(deadline_ms);
}
// thread::Local: a key is a small number handed out once per Local, and a thread's table holds one
// {value, dropper} pair per key it has touched. The answer is the address of the pair for `key` on
// this thread, zeroed the first time: lib/thread.grl stores the boxed value and the function that
// drops it there. The main thread's table hangs off its own record like any other.
fn f_host_thread_local_key() -> u64 {
    return raw_atomic_fetch_add(raw_state() + 48, 1);
}
fn f_host_thread_local(key: u64) -> u64 {
    tp := raw_tp_get();
    if tp == 0 {
        rt_abort();
    }
    mut table = raw_load(tp + 88);
    mut have = 0;
    if table != 0 {
        have = raw_load(table);
    }
    if (key < have) == 0 {
        mut want = have * 2;
        if want < key + 1 {
            want = key + 1;
        }
        if want < 8 {
            want = 8;
        }
        fresh := rt_alloc(8 + want * 16);
        if table != 0 {
            rt_copy_bytes(fresh + 8, table + 8, have * 16);
            rt_free(table);
        }
        raw_store(fresh, want);
        raw_store(tp + 88, fresh);
        table = fresh;
    }
    return table + 8 + key * 16;
}
// A thread's locals: thread-record word 88 holds a block of {count, then per key: value word,
// dropper} that lib/thread.grl fills in (f_host_thread_local). Dropped on the thread, before its
// cache is retired; the main thread's at the end of main, before the leak check.
fn rt_locals_drop(tp: u64) -> u64 {
    table := raw_load(tp + 88);
    if table == 0 {
        return 0;
    }
    raw_store(tp + 88, 0);
    n := raw_load(table);
    mut i = 0;
    while i < n {
        value := raw_load(table + 8 + i * 16);
        drop := raw_load(table + 16 + i * 16);
        if drop != 0 {
            raw_call2(drop, value, 0);
        }
        i = i + 1;
    }
    rt_free(table);
    return 0;
}
fn rt_thread_join(handle: u64) -> u64 {
    while true {
        tid := raw_atomic_load(handle);
        if tid == 0 {
            break;
        }
        rt_syscall_low(202, handle, 0, tid);
    }
    if rt_error(rt_syscall_low(11, raw_load(handle + 8), raw_load(handle + 16), 0)) {
        rt_abort();
    }
    rt_free(handle);
    return 0;
}
// ---- jobs: run-to-completion work on the scheduler's own workers -----------------------------
// There is one set of worker threads (rt_sched). A job is a record, not a thread and not a stack:
// `parallel_map`, `parallel_split`, `parallel_with` (pool::join) and a `Job<R>` handle all
// fork records that any worker may run, and the code is with the scheduler below ("jobs on the
// scheduler"). docs/design/concurrency-model.md, stage 1.
//
// ---- process-state word map: one table, one owner per word -------------------------------
// rt_state is 4096 bytes shared by every long-lived subsystem. A claim on a word means adding a row
// to this table and taking the address from the accessor named in that row; no subsystem writes a
// bare `raw_state() + N` for a word it owns. The offsets live here, once, so a collision is a
// two-line diff rather than a merge-day surprise. The pool's first claim was `raw_state() + 88` for
// its pointer; the Windows green scheduler later cached the task mode in 88, and the merged program
// read the mode (1) as the pool pointer and faulted at address 0x9. That is the incident this table
// exists to prevent.
//
//   word(s)      owner                        accessor                  claimed by
//   0, 8, 16     argc / argv / envp           platform startup           --
//   24           allocator live count         rt_live                    --
//   32           allocator arena list         rt_shutdown                --
//   40           thread-cache registry        rt_cache_make              thread-alloc
//   48           next thread::Local key       f_host_thread_local_key    threads
//   56           detached threads running     rt_detached_word           threads
//   64           allocator lock word          rt_allocator_lock          --
//   72           green scheduler block        rt_sched                   --
//   80           green scheduler create CAS   rt_sched                   --
//   88           task-mode cache              rt_task_mode               win-green-tasks
//   96..120      CreatePipe SECURITY_ATTRIBUTES os-windows: rt_win_pipe_attributes  effects-windows
//   128..256     main thread's own record     rt_thread_init             thread-alloc (192: its cache)
//   184          main thread's host TLS base  _start (tls_capture)       ffi-threads
//   256..320     allocator bin heads          rt_alloc_unlocked          --
//   768..832     allocator bin bump           rt_grow                    --
//   1280..1344   allocator bin remaining      rt_grow                    --
//   1792..1896   thread-cache chains, per bin rt_chain_give              thread-alloc
//   1920..1984   main thread's waiter block   rt_main_waiter             parking
//   2048..2672   sampling profiler block      rt_prof_words              --
//   3200         jobs block (ring, records)   rt_state_jobs              one-scheduler
//   3216         glibc thread bridge          rt_state_host_thread       ffi-threads
//   3224         compile-time probe mode      os-linux: rt_comptime_on   comptime-c3
//   3232..3384   compile-time refusal text    os-linux: rt_comptime_check comptime-c3
//   3392         Windows thread bridge        os-windows: rt_win_bridge  --
//   3400         call-site table helper       _start; rt_sites_fill      runtime-errors
//   3408         site descriptor capacity     rt_state_sites_offer       rth-sites
//   3416         a second thread was started  rt_allocator_lock          compile-speed
//   3424         scheduler config block       rt_sched_config            sched-start
//   3432         failure report block address rt_report_block            statics-no-alloc
//   3440         release failure site record  rt_fail_site_word          release-sites
//   3448         stacks discarded by re-raise rt_discarded_word          job-failure
//   3456         abort report claim           rt_abort                   abort-once
//   3464..3576   task-stack fault handler     rt_state_stack_guard       stack-guard
//   3584         contained task failures      rt_contained              task-fail-containment
//   3592         main thread altstack base   os-linux: rt_os_stack_guard_install_main  main-stack-overflow
//   3600..3840   stack-fault report scratch  rt_stack_report_words      main-stack-overflow
//   3840         Windows fiber state          os-windows                 --
//   3856..       Windows fiber table          os-windows                 --
//
// Not a claim: thread-record word 48 (raw_state() + 176 for the main thread). os-windows keeps the
// per-thread WaitOnAddress expected value there; on Linux it is the running block's foreign-call pair
// (rt_marker_cache, read by every foreign call's marker). Nothing else may use it. The job pool once did, which
// was the same disease as the 88 collision: an unowned word in a shared structure.
// The task-stack fault handler's state: 0 restorer code page (x86-64), 8 install state
// (0 none, 1 installing, 2 ready), 16 a 32-byte message scratch, 48 the sigaction the handler is
// installed with, 80 the zeroed SIG_DFL action the handler swaps in for a fault that is not a task
// overflow. Nothing here is allocated at fault time.
fn rt_state_stack_guard() -> u64 {
    return raw_state() + 3464;
}
// The stack-fault report's own scratch, written only by the fault handler and only for it: 0..40
// the five-word site descriptor rt_sites_fill fills, 48.. the location line it builds. It sits below
// the Windows fiber state word at 3840, so every platform sharing this block can read it, and it
// exists because the handler may not allocate either half.
fn rt_stack_report_words() -> u64 {
    return raw_state() + 3600;
}
// The main thread's alternate signal-stack base, mapped and installed once at startup by the
// platform module; 0 until then. It has a word of its own because the main thread has no worker
// block to keep it in, unlike the workers rt_os_stack_guard_install installs for.
fn rt_state_stack_alt_main() -> u64 {
    return raw_state() + 3592;
}
fn rt_state_jobs() -> u64 {
    return raw_state() + 3200;
}
// The capacity the site descriptor is asked for, once decided (rt_sites_offer): 0 not asked, 1 the
// five-word descriptor, n+1 an injected offer of n words.
fn rt_state_sites_offer() -> u64 {
    return raw_state() + 3408;
}
// rt_host_thread's address, written by _start when the process loaded libc and links
// pthread_create; 0 everywhere else, and then the runtime clones its own threads.
fn rt_state_host_thread() -> u64 {
    return raw_state() + 3216;
}
// ---- structured parallel calls ----------------------------------------------------------------
// Map descriptor (a job record used as storage, state word 32 left DONE so a stale queue entry can
// never claim it): 0 callback, 8 environment, 16 context, 24 items base, 40 result base, 48 count,
// 56 items per leaf. Leaf k covers one contiguous range: contiguous writes, no per-item atomic.
fn rt_job_map_leaf(d: u64, k: u64) -> u64 {
    f := raw_load(d);
    env := raw_load(d + 8);
    context := raw_load(d + 16);
    items := raw_load(d + 24);
    out := raw_load(d + 40);
    // Words 48 and 56 carry the inline item and result widths in their top 24 bits (word 64 and
    // up belong to the job record's list links, which the scheduler writes).
    n := raw_load(d + 48) & 1099511627775;
    per := raw_load(d + 56) & 1099511627775;
    iw := raw_load(d + 56) >> 40;
    rw := raw_load(d + 48) >> 40;
    start := k * per;
    if n <= start {
        return 0;
    }
    mut stop = start + per;
    if n < stop {
        stop = n;
    }
    mut i = start;
    while i < stop {
        mut item = 0;
        if iw == 0 {
            item = raw_load(items + i * 8);
        } else {
            item = items + i * iw;
        }
        mut r = 0;
        if env == 0 {
            r = raw_call2(f, item, context);
        } else {
            r = raw_call3(f, env, item, context);
        }
        if rw == 0 {
            raw_store(out + i * 8, r);
        } else {
            rt_copy_bytes(out + i * rw, r, rw);
            rt_free(r);
        }
        i += 1;
    }
    return stop - start;
}
// Leaves [lo, hi) of a descriptor, by halving: the upper half is forked as one job any worker may
// take, the lower half runs here, and the fork is joined before this returns - by running it here
// if nobody took it. The split depends on the leaf count alone, never on who runs what, and the
// value is the number of elements the leaves covered.
fn rt_job_split(d: u64, lo: u64, hi: u64, kind: u64) -> u64 {
    if hi - lo < 2 {
        if kind == 0 {
            return rt_job_map_leaf(d, lo);
        }
        if kind == 2 {
            return rt_job_zip_leaf(d, lo);
        }
        return rt_job_chunk_leaf(d, lo);
    }
    mid := lo + (hi - lo) / 2;
    mut r = 0;
    if kind == 0 {
        r = rt_job_fork(rt_job_split_map, d, mid, hi);
    } else if kind == 2 {
        r = rt_job_fork(rt_job_split_zip, d, mid, hi);
    } else {
        r = rt_job_fork(rt_job_split_chunks, d, mid, hi);
    }
    left := rt_job_split(d, lo, mid, kind);
    return left + rt_job_join(r);
}
fn rt_job_split_map(d: u64, lo: u64, hi: u64) -> u64 {
    return rt_job_split(d, lo, hi, 0);
}
fn rt_job_split_chunks(d: u64, lo: u64, hi: u64) -> u64 {
    return rt_job_split(d, lo, hi, 1);
}
fn rt_job_split_zip(d: u64, lo: u64, hi: u64) -> u64 {
    return rt_job_split(d, lo, hi, 2);
}
// Zip descriptor (a job record used as storage, docs/design/simd-layout-parallel-loops.md 4.2):
//   0 adapter   8 callback   16 environment   24 slices {view, width} pairs   40 count   48 grain
//   56 number of slices
// Leaf (d, k) covers [k * grain, min(count, k * grain + grain)) of every slice: one fresh view per
// slice over the same index range, handed to the callback through the compiler's adapter
// (zip_adapter), which takes one block {callback, environment, view 1 .. view n} and calls the
// callback with the views as its arguments. The callback owns and frees each view, as a slice
// parameter always is; the block is freed here.
fn rt_job_zip_leaf(d: u64, k: u64) -> u64 {
    n := raw_load(d + 40);
    grain := raw_load(d + 48);
    start := k * grain;
    if n <= start {
        return 0;
    }
    mut stop = start + grain;
    if n < stop {
        stop = n;
    }
    count := raw_load(d + 56);
    pairs := raw_load(d + 24);
    block := rt_alloc((2 + count) * 8);
    raw_store(block, raw_load(d + 8));
    raw_store(block + 8, raw_load(d + 16));
    mut i = 0;
    while i < count {
        src := raw_load(pairs + i * 16);
        width := raw_load(pairs + i * 16 + 8);
        slot := rt_view_record();
        raw_store(slot, raw_load(src) + start * width);
        raw_store(slot + 8, stop - start);
        raw_store(block + 16 + i * 8, slot);
        i += 1;
    }
    raw_call2(raw_load(d), block, 0);
    // The views are the callback's to read, not to keep (a view is copied where it is kept).
    i = 0;
    while i < count {
        rt_free(raw_load(block + 16 + i * 8));
        i += 1;
    }
    rt_free(block);
    return stop - start;
}
// parallel_for_zip: `count` slices (an array of {view, width} pairs at `pairs`), all the same length
// - checked here, once - cut into pieces of `grain` elements; piece k is the same index range of
// every slice. As for rt_parallel_split the split is constructed from (n, grain) alone and the
// pieces must cover n exactly. The caller holds every slice's loan until this returns.
fn rt_parallel_zip(pairs: u64, count: u64, grain: u64, adapter: u64, f: u64, env: u64) -> u64 {
    n := rt_len(raw_load(pairs));
    mut i = 1;
    while i < count {
        m := rt_len(raw_load(pairs + i * 16));
        if m != n {
            rt_fail(19, i + 1, m);
        }
        i += 1;
    }
    if n == 0 {
        return 0;
    }
    if grain == 0 {
        rt_fail(18, 0, 0);
    }
    leaves := (n + grain - 1) / grain;
    rt_jobs_sched();
    d := rt_job_new();
    raw_atomic_store(d + 32, 3);
    raw_store(d, adapter);
    raw_store(d + 8, f);
    raw_store(d + 16, env);
    raw_store(d + 24, pairs);
    raw_store(d + 40, n);
    raw_store(d + 48, grain);
    raw_store(d + 56, count);
    rt_region_enter();
    covered := rt_job_split(d, 0, leaves, 2);
    rt_region_leave();
    if covered != n {
        rt_abort();
    }
    rt_job_release(d);
    return 0;
}
// Results land in their input slots, so the order of `out` is the input order whatever order the
// leaves finish in. Every fork is joined before this returns, so no worker can still write into
// `out` (or read `items`) afterwards; that is the whole structured-join contract.
fn rt_parallel_map(items: u64, context: u64, f: u64, env: u64) -> u64 {
    return rt_parallel_mapw(items, context, f, env, 0, 0);
}
// parallel_map over inline elements or into inline results (docs/design/unboxed-values.md): `iw` is
// the width in bytes of an inline item (each call is handed the item's address, which is the
// record), `rw` of an inline result (each call returns a box, copied into place and freed); 0 is a
// word either way.
fn rt_parallel_mapw(items: u64, context: u64, f: u64, env: u64, iw: u64, rw: u64) -> u64 {
    n := rt_len(items);
    out := rt_new();
    if rw == 0 {
        mut i = 0;
        while i < n {
            rt_push(out, 0);
            i += 1;
        }
    } else if n != 0 {
        raw_store(out, rt_grow(0, 0, wrapping_mul(n, rw)));
        raw_store(wrapping_add(out, 8), n);
        raw_store(wrapping_add(out, 16), n);
    }
    if n == 0 {
        rt_drop_seq(items);
        return out;
    }
    // At most 256 leaves, a function of n alone: the same items land in the same leaves on any
    // machine, so a reduction over the results is the same on 4 cores and on 64.
    rt_jobs_sched();
    mut leaves = 256;
    if n < leaves {
        leaves = n;
    }
    chunk := (n + leaves - 1) / leaves;
    d := rt_job_new();
    raw_atomic_store(d + 32, 3);
    raw_store(d, f);
    raw_store(d + 8, env);
    raw_store(d + 16, context);
    raw_store(d + 24, raw_load(items));
    raw_store(d + 40, raw_load(out));
    raw_store(d + 48, n | (rw << 40));
    raw_store(d + 56, chunk | (iw << 40));
    rt_region_enter();
    written := rt_job_split(d, 0, leaves, 0);
    rt_region_leave();
    // Every item is written exactly once: a leaf that wrote none, or wrote one twice, is a bug.
    if written != n {
        rt_abort();
    }
    rt_job_release(d);
    rt_drop_seq(items);
    return out;
}
// Chunk split descriptor (a job record used as storage, like the map's):
//   0 callback   8 environment   16 data base   24 element width   40 element count
//   48 chunk length
// Leaf (d, k) covers elements [k * chunk, min(count, k * chunk + chunk)) of the caller's data. The
// slice it hands the callback addresses the caller's memory directly, so no element is copied: this
// is what the owned-chunk split cannot do, because it moves every element twice.
//
// The slice descriptor itself is a fresh 24-byte block per job, exactly what `v[a: b]` allocates,
// because a slice parameter is owned by the callee: the callback's own cleanup frees the descriptor
// when its statement ends. Handing out slots of one array instead would have the first callback free
// the whole array under its siblings (and corrupt the allocator, which checks its block marks).
fn rt_job_chunk_leaf(d: u64, k: u64) -> u64 {
    n := raw_load(d + 40);
    chunk := raw_load(d + 48);
    start := k * chunk;
    if n <= start {
        return 0;
    }
    mut stop = start + chunk;
    if n < stop {
        stop = n;
    }
    // A slice for the callback to read; it is freed when the callback returns (a view is copied
    // where it is kept).
    slot := rt_view_record();
    raw_store(slot, raw_load(d + 16) + start * raw_load(d + 24));
    raw_store(slot + 8, stop - start);
    // The callback takes one argument, so the second word is unused: it holds 0 for a plain
    // function and the environment pointer for a closure (the environment comes first).
    f := raw_load(d);
    env := raw_load(d + 8);
    if raw_load(d + 56) != 0 {
        // chunks_mut_at: the piece's first index comes before the piece.
        if env == 0 {
            raw_call2(f, start, slot);
        } else {
            raw_call3(f, env, start, slot);
        }
    } else if env == 0 {
        raw_call2(f, slot, 0);
    } else {
        raw_call2(f, env, slot);
    }
    rt_free(slot);
    return stop - start;
}
// Split an exclusive slice into pieces of `grain` elements (the last may be shorter) and run one leaf
// per piece. The split is constructed, never checked: piece k is [k*grain, min(n, (k+1)*grain)), a
// function of n and grain alone - never of how many workers there are - so the regions cannot overlap
// and their lengths sum to n, the invariant asserted below. A zero grain is a caller's error (the
// library states `grain > 0`; the builtin checks it).
// The caller holds the loan on the data until this returns, so no job can outlive the slice and no
// other code in the frame can address it while the jobs run.
fn rt_parallel_split(s: u64, grain: u64, f: u64, env: u64, width: u64) -> u64 {
    return rt_parallel_split_at(s, grain, f, env, width, 0);
}
// The same split; with `at` set the callback also gets each piece's first index (pool::chunks_mut_at).
fn rt_parallel_split_at(s: u64, grain: u64, f: u64, env: u64, width: u64, at: u64) -> u64 {
    n := rt_len(s);
    if n == 0 {
        return 0;
    }
    if grain == 0 {
        rt_fail(18, 0, 0);
    }
    size := grain;
    leaves := (n + size - 1) / size;
    rt_jobs_sched();
    d := rt_job_new();
    raw_atomic_store(d + 32, 3);
    raw_store(d, f);
    raw_store(d + 8, env);
    raw_store(d + 16, raw_load(s));
    raw_store(d + 24, width);
    raw_store(d + 40, n);
    raw_store(d + 48, size);
    raw_store(d + 56, at);
    rt_region_enter();
    covered := rt_job_split(d, 0, leaves, 1);
    rt_region_leave();
    if covered != n {
        rt_abort();
    }
    rt_job_release(d);
    return 0;
}
// A job handle (type kind 29) is one job record. The handle's owner is the record's forker: the
// thread that waits takes the result word and releases the record, and if no worker has claimed the
// job by then the waiter runs it itself.
//
// The closure object cannot stay in the caller's frame, because the handle may outlive a statement
// and the calling thread keeps running while the job does: the job record keeps the object pointer
// (argument word 24), and the job's own frame holds the one word the closure ABI reads while it
// calls (the callee's first argument is the address of a word holding the object). No box is
// allocated. The job owns the object and drops it - calling the environment record's own drop, the
// same call the frame would have made - before it publishes the result.
fn rt_parallel_spawn(f: u64, object: u64) -> u64 {
    rt_jobs_sched();
    return rt_job_make(rt_job_boxed, 0, f, object, 0);
}
// The one-word heap slot the closure ABI reads, for a closure handed to a thread
// (thread_spawn_raw): the thread's entry passes its address as the callee's first argument.
fn rt_job_box(object: u64) -> u64 {
    box := rt_alloc(8);
    raw_store(box, object);
    return box;
}
fn rt_job_boxed(unused: u64, f: u64, object: u64) -> u64 {
    if object == 0 {
        return raw_call2(f, 0, 0);
    }
    mut slot = object;
    at := &mut slot;
    r := raw_call2(f, at, 0);
    raw_call2(raw_load(object + 8), object, 0);
    return r;
}
// `parallel_join(handle)` and a handle's drop: the result word, and the record goes back.
fn rt_job_wait(j: u64) -> u64 {
    rt_region_enter();
    rt_job_await(j);
    rt_region_leave();
    r := raw_load(j + 40);
    f := raw_load(j + 80);
    rt_job_release(j);
    if f != 0 {
        rt_job_reraise(f);
    }
    return r;
}
// `parallel_with(first, second, combine)`, which is pool::join: `first` is forked as a job and
// `second` runs here, now, on the caller's stack; then the fork is joined - run here if no worker
// took it - and the value is combine(first's word, second's word), `combine` being a plain function.
// Both callbacks take no argument; `env` is 0 for a plain function and the closure ABI's slot
// address otherwise.
fn rt_parallel_with(f1: u64, env1: u64, f2: u64, env2: u64, combine: u64) -> u64 {
    rt_jobs_sched();
    // A green stack counts its region through the stack list (the fork is on it); only a thread
    // that is not running a task keeps a count of its own (rt_region_step), and takes the external
    // slot as it enters - before the fork, so the fork goes on the slot's deque.
    plain := rt_current() == 0;
    if plain {
        rt_region_enter();
    }
    r := rt_job_fork(rt_job_call0, f1, env1, 0);
    mut second = 0;
    if env2 == 0 {
        second = raw_call2(f2, 0, 0);
    } else {
        second = raw_call2(f2, env2, 0);
    }
    first := rt_job_join(r);
    if plain {
        rt_region_leave();
    }
    return raw_call2(combine, first, second);
}
fn rt_job_call0(f: u64, env: u64, unused: u64) -> u64 {
    if env == 0 {
        return raw_call2(f, 0, 0);
    }
    return raw_call2(f, env, 0);
}

// ---- colourless tasks: stackful green threads on the scheduler's workers, with a reactor ----
// Every OS thread has a worker record reachable through the thread pointer:
// 0 self, 8 scheduler stack pointer, 16 current green task (0 = plain OS thread).
fn rt_thread_init() -> u64 {
    w := raw_state() + 128;
    raw_store(w, w);
    raw_tp_set(w);
    // The PE entry has no stack arguments; the OS layer recovers argv/envp from Win32. Linux keeps
    // the entry stub's words and this is a no-op.
    rt_os_init();
    // Armed only when `grail profile` left its rendezvous file in the working directory.
    rt_prof_start();
    return 0;
}
fn rt_current() -> u64 {
    w := raw_tp_get();
    if w == 0 {
        return 0;
    }
    return raw_load(w + 16);
}
fn rt_spin_lock(p: u64) -> u64 {
    while raw_atomic_cas(p, 0, 1) != 0 {
        rt_syscall_low(24, 0, 0, 0);
    }
    return 0;
}
fn rt_spin_unlock(p: u64) -> u64 {
    raw_atomic_store_release(p, 0);
    return 0;
}

// ---- scheduling mode ----
// A task is green by default on every target: a scheduler thread runs tasks cooperatively, a task
// runs until it yields or blocks, and suspension parks the task instead of its thread. Only the
// mechanism differs per platform (the stack switch and the readiness source live in the platform
// module: os-linux.grl, os-windows.grl, darwin.grl); the observable scheduling does not
// (docs/design/concurrency-v1.md and docs/ffi.md state what is identical).
//
// `GRAIL_TASKS=thread` in the environment selects the opt-in thread-per-task scheduler: every task
// is its own OS thread, suspension is an address wait on the task's own park word, host::read_fd
// and host::sleep_ms block that thread, rt_wait_fd returns immediately (the ready task performs the
// blocking call on its own thread), rt_reactor_fence is a no-op and a blocking foreign call blocks
// only the task that made it. It trades the single-threaded tick for real parallelism, which is
// faster for CPU-bound fan-out and is *not* the same semantics: there is no Send/Sync check yet, so
// two tasks really can mutate the same memory at once. See docs/design/concurrency-v1.md.
// State word 88 caches the resolved mode: 0 unresolved, 1 green, 2 thread-per-task.
fn rt_task_threads() -> u64 {
    return rt_task_mode() == 2;
}
fn rt_task_mode() -> u64 {
    state := raw_state();
    m := raw_atomic_load(state + 88);
    if m != 0 {
        return m;
    }
    mut chosen = 1;
    if rt_env_is(view("GRAIL_TASKS"), view("thread")) {
        chosen = 2;
    }
    raw_atomic_cas(state + 88, 0, chosen);
    return raw_atomic_load(state + 88);
}
// 1 when the environment holds exactly NAME=VALUE. Allocation-free: the mode is resolved before the
// scheduler exists, and a mode lookup must never depend on the allocator.
fn rt_env_is(name: u64, value: u64) -> u64 {
    n := rt_len(name);
    v := rt_len(value);
    mut ep = raw_load(raw_state() + 16);
    while raw_load(ep) != 0 {
        p := raw_load(ep);
        mut i = 0;
        mut same = 1;
        while i < n {
            if raw_byte(p + i) != rt_atb(name, i) {
                same = 0;
                break;
            }
            i += 1;
        }
        if same != 0 {
            if raw_byte(p + n) == 61 {
                mut j = 0;
                while j < v {
                    if raw_byte(p + n + 1 + j) != rt_atb(value, j) {
                        return 0;
                    }
                    j += 1;
                }
                if raw_byte(p + n + 1 + v) == 0 {
                    return 1;
                }
                return 0;
            }
        }
        ep = ep + 8;
    }
    return 0;
}

// Scheduler block (raw_state()+72, raw_map: infrastructure, not counted as user allocation):
//   0 injection lock  8 injection head  16 injection tail  24 park/wake sequence (futex word)
//  32 worker count  40 reactor handle  48 fence descriptor  56 reactor batch epoch
//  64 blocking-call warning flag  72 worker array  80 injection ring  88 injection capacity
//  96 parked workers (atomic)  104 timer lock  112 timer count  120 timer capacity
// 128 timer heap (Windows: one entry per pending sleep)  136 holder of the external slot (0 none);
// the worker array has one block more than the worker count, the external slot's
// Worker block (raw_map, one page per worker):
//   0 deque buffer  8 deque head (atomic)  16 deque tail (atomic)  24 deque mask
//  32 scheduler  40 index  48 thread record  56 free-stack list head  64 free-stack count
//  72 steal random state  80 deque capacity
//  88 fault-handler alternate stack  96..112 its sigaltstack record (sp, flags, size)
// 128..208 the job deque, laid out as the task deque is from word 0 (buffer, head, tail, mask, and
//     the capacity at +80), so the same three deque functions serve both
// 224 this worker's runner (0 none)  232 the job handed to the runner  240 free job records
// 248 their count  264 help-depth high-water mark  272 steps taken (the fairness tick)
// 280 1 while this worker is counted as searching (rt_worker_loop, rt_worker_run)
// 296 link in the jobs block's list of blocks waiting for a thread (rt_block_give)
// 304..312 the first foreign-call pair {seq, retaken}, 320 the pair the owner uses now (`seq` odd:
// inside a foreign call; rt_sysmon), 328 the `seq` the monitor saw last, 336 how many ticks it stayed
// 512..592 the Frame job deque, 640..720 the Background job deque (the Normal one is at 128)
// 896..1024 the CPU mask a pinned worker hands the kernel
//
// The deque is a Chase-Lev deque with a fixed capacity (rt_deque_capacity, 131072 entries): the
// owner pushes and pops at the bottom, a thief steals at the top with a CAS on the head. A fixed
// buffer is what makes it sound without memory reclamation - no thread ever frees a slot a thief may
// be reading - and 131072 entries cover a burst of 100k spawns; a push that does not fit spills to
// the shared injection ring, which is also where a spawn from a thread that is not a worker (the
// main thread, the reactor, an offload helper) and a wake from one of those goes.
//
// Green mode creates the scheduler threads and, only on a platform that has one, a reactor beside
// them. Thread-per-task mode starts neither here: each task brings its own thread, and the workers
// are started by the first job (rt_jobs_sched), because jobs are all they run in that mode.
// `GRAIL_WORKERS=n` (1..64) is the worker count, honoured as given; otherwise it is the platform's
// (one per CPU).
fn rt_sched() -> u64 {
    state := raw_state();
    s := raw_atomic_load(state + 72);
    if s != 0 {
        return s;
    }
    if raw_atomic_cas(state + 80, 0, 1) == 0 {
        made := raw_map(4096);
        if rt_error(made) {
            rt_abort();
        }
        threads := rt_task_threads();
        if (threads == 0) & (rt_os_reactor() != 0) {
            // A platform whose reactor cannot be created is not fatal: tasks still run, and the
            // operations that wanted it fall back to the offload path (rt_os_timer/rt_os_ready).
            raw_store(made + 40, rt_os_reactor_open(made));
        }
        mut workers = rt_env_number(view("GRAIL_WORKERS="));
        if workers == 0 {
            workers = rt_sched_setting(8);
        }
        if workers == 0 {
            workers = rt_os_workers();
        }
        if 64 < workers {
            workers = 64;
        }
        raw_store(made + 32, workers);
        raw_store(made + 80, raw_map(65536));
        raw_store(made + 88, 8192);
        // One block more than there are workers: the external slot (rt_external_take), which a
        // thread that is not a worker - main, a render thread - holds while it is inside a
        // parallel call, so its forks go on a deque of their own instead of the locked ring.
        array := raw_map((workers + 1) * 8);
        if rt_error(array) {
            rt_abort();
        }
        raw_store(made + 72, array);
        mut i = 0;
        while i <= workers {
            raw_store(array + i * 8, rt_sched_worker_new(made, i));
            i += 1;
        }
        rt_jobs_create(workers);
        // Workers start only once the array and the rings they are reachable through are complete,
        // and the block is published first: rt_sched's other callers spin on word 72.
        raw_atomic_store(state + 72, made);
        if threads == 0 {
            rt_sched_start(made);
        }
        return made;
    }
    while raw_atomic_load(state + 72) == 0 {
        rt_syscall_low(24, 0, 0, 0);
    }
    return raw_atomic_load(state + 72);
}
fn rt_sched_start(s: u64) -> u64 {
    array := raw_load(s + 72);
    workers := raw_load(s + 32);
    mut i = 0;
    while i < workers {
        rt_thread_spawn_detached(rt_worker_thread, raw_load(array + i * 8));
        i += 1;
    }
    if raw_load(s + 40) != 0 {
        rt_thread_spawn_detached(rt_reactor, s);
    }
    if rt_task_threads() == 0 {
        rt_thread_spawn_detached(rt_sysmon, s);
    }
    return 0;
}
// The monitor: every 5 ms it looks at each worker's foreign-call pair (block word 320: `seq`, then
// `retaken`). A worker whose `seq` has stayed at the same odd value - inside one foreign call - for
// two looks (more than 10 ms) while work is queued is asked back: `retaken` := 1, a full barrier in
// every thread of the process (rt_os_retake_barrier: membarrier on x86-64 Linux), then `seq` again.
// Unchanged, the call is still running: a compare-and-swap of `retaken` 1 -> 2 takes the block - the
// block gets a fresh pair and goes to rt_block_give - unless the thread cancelled first. Changed, the
// call ended: `retaken` goes back to 0. The thread settles its side in rt_foreign_return. Why this is
// race-free: docs/design/concurrency-model.md, 2.4.1. Declared `blocking` calls never get here; they
// hand off at once.
fn rt_sysmon(s: u64) -> u64 {
    j := raw_load(rt_state_jobs());
    raw_store(j + 488, 0);
    raw_store(j + 496, 5000000);
    workers := raw_load(s + 32);
    array := raw_load(s + 72);
    // Without a process-wide barrier (a kernel before membarrier) an undeclared call is never taken
    // back: the thread's plain marker cannot be read safely.
    ready := rt_os_retake_barrier(1);
    while true {
        rt_syscall(35, j + 488, 0, 0);
        mut i = 0;
        while (i < workers) & (ready != 0) {
            w := raw_load(array + i * 8);
            pair := raw_load(w + 320);
            v := raw_atomic_load(pair);
            if ((v & 1) == 1) & (v == raw_load(w + 328)) {
                raw_store(w + 336, raw_load(w + 336) + 1);
            } else {
                raw_store(w + 336, 0);
            }
            raw_store(w + 328, v);
            if (2 <= raw_load(w + 336)) && (rt_work_queued(s) != 0) {
                raw_atomic_store(pair + 8, 1);
                rt_full_fence();
                rt_os_retake_barrier(0);
                if raw_atomic_load(pair) != v {
                    raw_atomic_cas(pair + 8, 1, 0);
                } else if raw_atomic_cas(pair + 8, 1, 2) == 1 {
                    owner := raw_load(w + 48);
                    if (owner != 0) && (raw_load(w + 224) == raw_load(owner + 16)) {
                        raw_store(w + 224, 0);
                    }
                    rt_spin_lock(j + 24);
                    fresh := rt_job_carve(j, 504, 64);
                    rt_spin_unlock(j + 24);
                    raw_store(fresh, 0);
                    raw_store(fresh + 8, 0);
                    raw_store(w + 320, fresh);
                    raw_store(w + 328, 0);
                    raw_store(w + 336, 0);
                    rt_block_give(w);
                }
            }
            i += 1;
        }
    }
    return 0;
}
// Thread-record word 48 on Linux: the foreign-call pair of the block this thread runs, or 0 when it
// runs none, so a foreign call's marker reaches it in one load (ffi_marker_enter). (On Windows the
// word is WaitOnAddress's compare value, and the marker takes the long way.) Every place a thread
// gains or loses a block sets it: rt_worker_loop, rt_blocking_enter, rt_foreign_lost. A retake
// gives the block a fresh pair while its old owner is still in its call; the old owner then counts
// out on the old pair, and loses the block (rt_foreign_lost) before it uses the word again.
fn rt_marker_cache(tp: u64, w: u64) -> u64 {
    if rt_os_marker_cached() == 0 {
        return 0;
    }
    if w == 0 {
        raw_store(tp + 48, 0);
    } else {
        raw_store(tp + 48, raw_load(w + 320));
    }
    return 0;
}
// A foreign call came back and found `retaken` set (ffi_hooks_leave in native.grl): settle it.
// 1 -> 0 cancels the monitor's retake and this thread keeps its block; 2 means the block was taken
// during the call; 0 means the monitor cancelled first.
fn rt_foreign_return(symbol: u64, pair: u64) -> u64 {
    if raw_atomic_cas(pair + 8, 1, 0) == 2 {
        rt_foreign_lost(symbol);
    }
    return 0;
}
fn rt_work_queued(s: u64) -> u64 {
    workers := raw_load(s + 32);
    array := raw_load(s + 72);
    mut i = 0;
    while i <= workers {
        w := raw_load(array + i * 8);
        if (raw_atomic_load(w + 8) < raw_atomic_load(w + 16)) | (raw_atomic_load(w + 136) < raw_atomic_load(w + 144)) | (raw_atomic_load(w + 520) < raw_atomic_load(w + 528)) {
            return 1;
        }
        i += 1;
    }
    if raw_atomic_load(s + 8) != raw_atomic_load(s + 16) {
        return 1;
    }
    jb := raw_load(rt_state_jobs());
    mut c = 0;
    while c < 3 {
        ring := rt_job_ring_at(jb, c);
        if raw_atomic_load(ring + 8) != raw_atomic_load(ring + 16) {
            return 1;
        }
        c += 1;
    }
    return 0;
}
// A foreign call came back and found its worker given away (ffi_marker_leave): this thread holds no
// block now, keeps running its task, and becomes a spare when the task stops. Said once per process,
// naming the function, because declaring it `blocking` hands off at once instead of after 10 ms.
fn rt_foreign_lost(symbol: u64) -> u64 {
    tp := raw_tp_get();
    raw_store(tp + 24, 0);
    raw_store(tp + 32, 0);
    rt_marker_cache(tp, 0);
    j := raw_load(rt_state_jobs());
    if raw_atomic_cas(j + 512, 0, 1) == 0 {
        mut n = 0;
        while raw_byte(symbol + n) != 0 {
            n += 1;
        }
        head := view("grail: the foreign call `");
        p := rt_pack(head);
        rt_write_all(2, p, rt_len(head));
        rt_free(p);
        rt_write_all(2, symbol, n);
        tail := view("` held a worker for more than 10 ms, so the worker was given to another thread; declare it `extern \"C\" blocking` to hand off at once\n");
        q := rt_pack(tail);
        rt_write_all(2, q, rt_len(tail));
        rt_free(q);
    }
    return 0;
}
// The decimal value of the environment entry that starts with `name` (which ends in `=`), or 0.
// Allocation-free, like rt_env_is: it is read while the scheduler is being made.
fn rt_env_number(name: u64) -> u64 {
    width := rt_len(name);
    mut ep = raw_load(raw_state() + 16);
    while raw_load(ep) != 0 {
        entry := raw_load(ep);
        mut same = 1;
        mut i = 0;
        while i < width {
            if raw_byte(entry + i) != rt_atb(name, i) {
                same = 0;
                break;
            }
            i += 1;
        }
        if same != 0 {
            mut value = 0;
            mut at = width;
            while true {
                b := raw_byte(entry + at);
                if (b < 48) | (57 < b) {
                    break;
                }
                value = value * 10 + (b - 48);
                at += 1;
            }
            return value;
        }
        ep = ep + 8;
    }
    return 0;
}
fn rt_deque_capacity() -> u64 {
    return 131072;
}
fn rt_sched_worker_new(s: u64, index: u64) -> u64 {
    w := raw_map(4096);
    if rt_error(w) {
        rt_abort();
    }
    cap := rt_deque_capacity();
    buf := raw_map(cap * 8);
    if rt_error(buf) {
        rt_abort();
    }
    raw_store(w, buf);
    raw_store(w + 24, cap - 1);
    raw_store(w + 32, s);
    raw_store(w + 40, index);
    raw_store(w + 80, cap);
    seed := rt_sched_setting(40);
    if seed != 0 {
        // A fixed seed fixes every worker's victim order (sched::Config.seed).
        raw_store(w + 72, wrapping_add(wrapping_mul(seed, index + 1), 2654435761) | 1);
    }
    // The foreign-call counter this block's owner counts in and out (word 320 names it; ffi_marker_*
    // in native.grl, rt_sysmon). It starts as word 304.
    raw_store(w + 320, w + 304);
    jobs := raw_map(rt_job_deque_capacity() * 8);
    if rt_error(jobs) {
        rt_abort();
    }
    raw_store(w + 128, jobs);
    raw_store(w + 152, rt_job_deque_capacity() - 1);
    raw_store(w + 208, rt_job_deque_capacity());
    // The Frame and Background deques, laid out like the Normal one.
    mut c = 0;
    while c < 3 {
        if c != 1 {
            d := rt_job_deque(w, c);
            buf := raw_map(rt_job_deque_capacity() * 8);
            if rt_error(buf) {
                rt_abort();
            }
            raw_store(d, buf);
            raw_store(d + 24, rt_job_deque_capacity() - 1);
            raw_store(d + 80, rt_job_deque_capacity());
        }
        c += 1;
    }
    return w;
}
// The worker block of the calling thread, or 0 for every other thread (the main thread, the
// reactor, an offload helper). Words 24 and 32 of the thread record are the
// scheduler worker's to claim - rt_thread_main has already consumed the entry/argument words - and
// the marker in word 24 is 2 on a scheduler worker. Any other thread counts its parallel regions
// there in steps of 16 (rt_region_step), which never reads as 2.
fn rt_worker_self() -> u64 {
    tp := raw_tp_get();
    if tp == 0 {
        return 0;
    }
    if raw_load(tp + 24) != 2 {
        return 0;
    }
    return raw_load(tp + 32);
}
// Bump the sequence unconditionally and wake a parked worker when there may be one: a worker that
// read the sequence before looking for work either finds the new work or its wait fails with the
// changed value, so no wake can be lost even when the parked count read is stale.
// New work is queued. Wake a parked worker only when there is one and no worker is searching: a
// searching worker will find the work, and in a join the forker usually takes its own fork back
// before anyone could. The fence orders the push before the reads, as the parking worker orders its
// count before its last look (rt_worker_loop), so one of the two always sees the other.
fn rt_notify(s: u64) -> u64 {
    rt_full_fence();
    if raw_atomic_load(s + 96) == 0 {
        return 0;
    }
    if raw_atomic_load(raw_load(rt_state_jobs()) + 416) != 0 {
        return 0;
    }
    raw_atomic_fetch_add(s + 24, 1);
    raw_atomic_fetch_add(raw_load(rt_state_jobs()) + 424, 1);
    rt_syscall_low(202, s + 24, 129, 1);
    return 0;
}
// ---- Chase-Lev deques ---------------------------------------------------------------------
// Owner push and pop at the bottom (the tail), thieves steal at the top (the head) with a CAS. The
// owner's tail store is the release that publishes the slot; a thief's CAS on the head is what
// claims it, and a lost CAS means somebody else has the task.
fn rt_deque_push(w: u64, t: u64) -> u64 {
    tail := raw_atomic_load(w + 16);
    head := raw_atomic_load(w + 8);
    // Full when the tail has advanced a capacity past the head. Addition, not subtraction: an
    // emptied deque is left with head == tail, but a thief may advance the head between the two
    // loads, and tail - head must not wrap (checked arithmetic would abort).
    if head + raw_load(w + 80) <= tail {
        return 0;
    }
    raw_store(raw_load(w) + (tail & raw_load(w + 24)) * 8, t);
    raw_atomic_store_release(w + 16, tail + 1);
    return 1;
}
fn rt_deque_pop(w: u64) -> u64 {
    mut tail = raw_atomic_load(w + 16);
    if tail == 0 {
        return 0;
    }
    tail = tail - 1;
    raw_atomic_store(w + 16, tail);
    head := raw_atomic_load(w + 8);
    if head <= tail {
        task := raw_load(raw_load(w) + (tail & raw_load(w + 24)) * 8);
        if head == tail {
            // The last entry: the owner and a thief may race for it, and only the CAS decides.
            // Tail is restored whether or not the CAS wins, so an emptied deque is left with
            // head == tail; leaving tail one below head would make the next push's size
            // computation go negative.
            if raw_atomic_cas(w + 8, head, head + 1) != head {
                raw_atomic_store(w + 16, tail + 1);
                return 0;
            }
            raw_atomic_store(w + 16, tail + 1);
        }
        return task;
    }
    raw_atomic_store(w + 16, tail + 1);
    return 0;
}
fn rt_deque_steal(v: u64) -> u64 {
    head := raw_atomic_load(v + 8);
    tail := raw_atomic_load(v + 16);
    if head < tail {
        task := raw_load(raw_load(v) + (head & raw_load(v + 24)) * 8);
        if raw_atomic_cas(v + 8, head, head + 1) == head {
            return task;
        }
    }
    return 0;
}
// A ring for every push that is not the owner's: spawns and wakeups from a thread without a deque,
// and a deque that is full. The lock is the only shared state, and it is held for one slot.
fn rt_inject_push(s: u64, t: u64) -> u64 {
    while true {
        rt_spin_lock(s);
        head := raw_load(s + 8);
        tail := raw_load(s + 16);
        if tail - head < raw_load(s + 88) {
            raw_store(raw_load(s + 80) + (tail % raw_load(s + 88)) * 8, t);
            raw_atomic_store_release(s + 16, tail + 1);
            rt_spin_unlock(s);
            return 0;
        }
        rt_spin_unlock(s);
        // Full: the other workers are draining it, so let them run and try again.
        rt_notify(s);
        rt_syscall_low(24, 0, 0, 0);
    }
    return 0;
}
fn rt_inject_pop(s: u64) -> u64 {
    // An unlocked look first: idle and helping workers ask often and the ring is usually empty. A
    // push that this look misses bumps the park sequence afterwards, so no worker sleeps on it.
    if raw_atomic_load(s + 8) == raw_atomic_load(s + 16) {
        return 0;
    }
    rt_spin_lock(s);
    head := raw_load(s + 8);
    tail := raw_load(s + 16);
    if head == tail {
        rt_spin_unlock(s);
        return 0;
    }
    task := raw_load(raw_load(s + 80) + (head % raw_load(s + 88)) * 8);
    raw_store(s + 8, head + 1);
    rt_spin_unlock(s);
    return task;
}
// xorshift64 with per-worker state: the victim order is spread without a shared cursor, and the
// generator costs three shifts.
fn rt_worker_random(w: u64) -> u64 {
    mut x = raw_load(w + 72);
    if x == 0 {
        x = wrapping_add(wrapping_mul(raw_load(w + 40) + 1, 2654435761), 2463534242);
    }
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    raw_store(w + 72, x);
    return x;
}
fn rt_worker_steal(s: u64, w: u64) -> u64 {
    workers := raw_load(s + 32);
    if 1 < workers {
        array := raw_load(s + 72);
        start := rt_worker_random(w) % workers;
        mut i = 0;
        while i < workers {
            victim := (start + i) % workers;
            if victim != raw_load(w + 40) {
                t := rt_deque_steal(raw_load(array + victim * 8));
                if t != 0 {
                    return t;
                }
            }
            i += 1;
        }
    }
    return 0;
}
fn rt_enqueue(t: u64) -> u64 {
    return rt_enqueue_in(rt_sched(), t);
}
// A wake: the task was parked, so the scheduler exists, and this neither makes it nor reaches
// anything that could (a wake is on the failure path, which allocates nothing).
fn rt_enqueue_in(s: u64, t: u64) -> u64 {
    w := rt_worker_self();
    mut placed = 0;
    if w != 0 {
        placed = rt_deque_push(w, t);
    }
    if placed == 0 {
        rt_inject_push(s, t);
    }
    rt_notify(s);
    return 0;
}
// Task words: 0 saved sp (Windows: the fiber handle), 8 stack base, 16 stack size,
// 24 park state (0 running, 1 parking,
// 2 parked, 3 wake pending), 32 the platform's wait key (Linux: the timerfd of a sleep; 0 when
// none), 40 callback, 48 item, 56 context, 64 arity,
// 72 cancel flag address, 80 result, 88 joiner (0 none, 1 finished, else waiting task),
// 96 finished (futex word for OS-thread joiners), 104 handle (0 live, 1 joined, 2 abandoned),
// 112 result drop function, 120 scope link, 128 in cancellable wait, 136 yield request,
// 144 completed (set by the task itself before its last switch).
fn rt_worker_loop(worker: u64) -> u64 {
    s := raw_load(worker + 32);
    tp := raw_tp_get();
    raw_store(tp + 24, 2); // runtime worker with a deque: rt_abort_signals, rt_worker_self
    raw_store(tp + 32, worker);
    rt_marker_cache(tp, worker);
    raw_store(worker + 48, tp);
    // What this thread needs to switch onto a task's stack with this block: the fault handler's
    // alternate stack is the block's (Linux, macOS), the fiber conversion is the thread's and done
    // once (Windows) - so a thread that adopts another block calls this again.
    rt_os_sched_prepare();
    if rt_sched_setting(24) != 0 {
        // Worker i on CPU i; more workers than CPUs get EINVAL and stay unpinned.
        rt_os_pin(raw_load(worker + 40), worker + 896);
    }
    rt_os_stack_warm(rt_sched_setting(32));
    spin := rt_sched_setting(48);
    searching := raw_load(rt_state_jobs()) + 416;
    while true {
        if raw_load(tp + 32) != worker {
            // The block went to a spare while this thread was in a blocking foreign call.
            return 0;
        }
        if rt_worker_step(s, worker) != 0 {
            continue;
        }
        // Out of work. SEARCH before sleeping: a worker that is still looking is one a fork does
        // not have to wake (rt_notify), which is what spares a join its system calls - in a join
        // the forker nearly always takes its own fork back, and a woken worker would find nothing.
        // Counted as searching until it runs something (rt_worker_run clears it, before the work
        // runs: work that forks must not see its own worker as the one that will find the fork).
        raw_store(worker + 280, 1);
        raw_atomic_fetch_add(searching, 1);
        mut found = 0;
        mut round = 0;
        while (found == 0) & (round < rt_worker_search_rounds()) {
            found = rt_worker_step(s, worker);
            round += 1;
            if (found == 0) & (round % 16 == 0) {
                rt_syscall_low(24, 0, 0, 0);
            }
        }
        if raw_load(tp + 32) != worker {
            // What this thread found and ran made a blocking call, and the block went to another
            // thread meanwhile: its searching flag (word 280) is that thread's now - this thread's
            // own count was cleared by rt_worker_run before the work ran - so it is not touched.
            // Clearing it here took the other thread's count away too, the counter went below
            // zero, and with "someone is searching" for ever no fork woke a parked worker again
            // (bench/frame.grl's I/O task sat in the injection ring with every worker asleep).
            return 0;
        }
        if (found == 0) & (spin != 0) {
            // sched::Config.idle_spin_us: keep looking for that long before sleeping.
            until := rt_now_us() + spin;
            while (found == 0) & (rt_now_us() < until) {
                found = rt_worker_step(s, worker);
            }
            if raw_load(tp + 32) != worker {
                return 0;
            }
        }
        if raw_load(worker + 280) != 0 {
            raw_store(worker + 280, 0);
            raw_atomic_fetch_sub(searching, 1);
        }
        if found != 0 {
            continue;
        }
        // PARK, without losing a wake: count this worker parked BEFORE the last look (a pusher
        // reads the count after its push, both with full barriers - rt_notify), and read the
        // sequence before it, so a wake that lands between the look and the wait changes the word
        // the wait compares.
        seq := raw_atomic_load(s + 24);
        raw_atomic_fetch_add(s + 96, 1);
        // A full barrier between the count and the last look: a sequentially consistent RMW is not
        // one on AArch64 or RV64 (LL/SC with acquire/release lets a later plain load pass the store),
        // and on those targets the Dekker pair needs it on both sides (rt_notify has the other).
        rt_full_fence();
        if rt_worker_step(s, worker) == 0 {
            rt_syscall_low(202, s + 24, 128, seq);
        }
        raw_atomic_fetch_sub(s + 96, 1);
    }
    return 0;
}
// A full barrier with no shared write: the sequentially consistent fence (`mfence`, `dmb ish`,
// `fence rw,rw`). A compare-and-swap is no stand-in: on AArch64 and RV64 it orders its own access,
// not the loads and stores around it.
fn rt_full_fence() -> u64 {
    raw_atomic_fence();
    return 0;
}
// How many empty looks a worker takes, yielding the CPU every sixteenth, before it parks.
fn rt_worker_search_rounds() -> u64 {
    return 64;
}
// One unit of work, or 0 when there is none. The order: this worker's jobs (LIFO - they are what a
// join on some stack is waiting for), its tasks, injected jobs, injected tasks, then a steal pass
// for jobs and one for tasks, each starting at a random victim. A job is not run on the scheduler
// stack: it is handed to the worker's runner (rt_runner_main).
fn rt_worker_step(s: u64, w: u64) -> u64 {
    // Every 61st step looks at the task ring first, so a worker that keeps finding its own work
    // cannot leave injected tasks (wakes from the reactor, spawns from other threads) waiting.
    tick := raw_load(w + 272) + 1;
    raw_store(w + 272, tick);
    if tick % 61 == 0 {
        t := rt_inject_pop(s);
        if t != 0 {
            rt_worker_run(s, w, t);
            return 1;
        }
    }
    mut j = rt_job_take(s, w, 0);
    if j == 0 {
        j = rt_job_take(s, w, 1);
    }
    if j == 0 {
        mut t = rt_deque_pop(w);
        if t == 0 {
            t = rt_inject_pop(s);
        }
        if t == 0 {
            t = rt_worker_steal(s, w);
        }
        if t != 0 {
            rt_worker_run(s, w, t);
            return 1;
        }
        j = rt_job_take_background(s, w);
    }
    if j == 0 {
        return 0;
    }
    mut r = raw_load(w + 224);
    if r == 0 {
        r = rt_runner_new();
        raw_store(w + 224, r);
    }
    raw_store(w + 232, j);
    rt_worker_run(s, w, r);
    return 1;
}
fn rt_worker_run(s: u64, w: u64, t: u64) -> u64 {
    if raw_load(w + 280) != 0 {
        raw_store(w + 280, 0);
        raw_atomic_fetch_sub(raw_load(rt_state_jobs()) + 416, 1);
    }
    tp := raw_tp_get();
    raw_store(tp + 16, t);
    if raw_load(t) == 0 {
        rt_os_ctx_new(t);
    }
    rt_os_ctx_enter(t);
    raw_store(tp + 16, 0);
    if raw_load(tp + 32) != w {
        // The task made a blocking foreign call and this thread gave the block away
        // (rt_blocking_enter): finish with the task without touching the block.
        return rt_worker_run_detached(t);
    }
    if raw_load(t + 144) {
        runner := raw_load(t + 104) == 3;
        // Now off the task's stack: release it, then publish completion (the joiner may free t).
        rt_os_ctx_release(t);
        raw_atomic_store(t + 96, 1);
        rt_syscall_low(202, t + 96, 129, 2147483647);
        joiner := raw_atomic_swap(t + 88, 1);
        if 1 < joiner {
            rt_wake(joiner);
        }
        if runner {
            if raw_load(w + 224) == t {
                raw_store(w + 224, 0); // this worker's own runner, ended by a contained failure
            }
            // A runner that had parked inside a job, was resumed as a task and has now finished
            // that job: nothing joins it, so its record goes back here.
            rt_runner_free(t);
        }
    } else if raw_atomic_load(t + 24) == 4 {
        // This worker's runner, idle: it keeps its stack and waits in word 224 for the next job.
    } else {
        if raw_load(w + 224) == t {
            // The runner left because the job it is running waits (or yielded): from here on it is
            // an ordinary parked task that any worker may resume, and this worker takes a fresh
            // runner for its next job. Forgotten before the park is published, because after that
            // another worker may already be running it.
            raw_store(w + 224, 0);
        }
        if raw_load(t + 136) {
            raw_store(t + 136, 0);
            rt_enqueue(t);
        } else {
            if raw_atomic_cas(t + 24, 1, 2) != 1 {
                raw_atomic_store(t + 24, 0);
                rt_enqueue(t);
            }
        }
    }
    // Work still queued here means a stopped sibling can help: this is what spreads a spawn burst
    // across every worker instead of one push, one wake.
    if (raw_load(w + 16) != raw_load(w + 8)) | (raw_load(w + 144) != raw_load(w + 136)) {
        rt_notify(s);
    }
    return 0;
}

// The end of rt_worker_run on a thread that no longer holds a block: the task finished, or parked,
// or yielded; everything it needs goes through the injection rings.
fn rt_worker_run_detached(t: u64) -> u64 {
    if raw_load(t + 144) {
        runner := raw_load(t + 104) == 3;
        rt_os_ctx_release(t);
        raw_atomic_store(t + 96, 1);
        rt_syscall_low(202, t + 96, 129, 2147483647);
        joiner := raw_atomic_swap(t + 88, 1);
        if 1 < joiner {
            rt_wake(joiner);
        }
        if runner {
            rt_runner_free(t);
        }
        return 0;
    }
    if raw_load(t + 136) {
        raw_store(t + 136, 0);
        rt_enqueue(t);
    } else if raw_atomic_cas(t + 24, 1, 2) != 1 {
        raw_atomic_store(t + 24, 0);
        rt_enqueue(t);
    }
    return 0;
}

// ---- jobs on the scheduler ------------------------------------------------------------------
// Job record, 128 bytes: 0 function, 8/16/24 its three arguments, 32 state, 40 result,
// 48 free-list link, 56 acknowledgement of a task waiter's wake, 64 link in its forker's stack list,
// 72 link in its runner's stack list, 80 its failure (0: none; else a five-word record, below),
// 88 1 while it holds one of the Background cap's slots, 104 when it was queued (Background only,
// microseconds), 112 its class (0 Frame, 1 Normal, 2 Background), 120 parent (the job that was running when this one was
// forked, 0 at a root).
// State: 0 free, 1 pending, 3 done, 4 claimed with an OS thread asleep on this word, 2 claimed by a
// thread that is not a worker, 8 * (i + 1) claimed by worker i (so a waiter knows whose deque the
// job's own forks land on), any value from 4096 up claimed with that task waiting.
//
// THE STACK LIST. Every green task (a runner is one) keeps in word 152 the head of a list of what
// its stack is in the middle of, newest first: the jobs it forked and has not joined (linked
// through record word 64) and the jobs it is running (linked through word 72, the head pointer
// tagged with bit 0). Forks and joins nest, so it is a stack. It gives a fork its parent in one
// load - the job at the head, or the parent of the fork at the head - and it is non-empty exactly
// while the stack is inside a parallel region. The top 16 bits of the word count nested helps.
// A thread that is not a green task keeps no list; its forks are roots.
//
// WHERE A RECORD LIVES. Records are carved from mapped pages that are never unmapped and are
// recycled through free lists, so a record's address always holds *a* job record. That is what
// makes a queue entry a hint rather than an obligation:
//
//   - The only way to run a job is to win `CAS(state, pending -> claimed)` on its record. A deque
//     entry, a ring entry and the forker's own pointer are three ways to find the record; whoever
//     wins the CAS runs it, exactly once, and everyone else moves on.
//   - So the forker can always take its own job back by pointer (rt_job_await), wherever the entry
//     went: still in its deque, in another worker's deque because the forker's task migrated, or in
//     the injection ring because the forker is not a worker. That claim by pointer is also the
//     whole of "a thread that is not a worker helps with its own scope only": it never takes an
//     entry from a queue, so it can never pick up a job it did not fork.
//   - An entry that outlives its job - the forker claimed by pointer and the entry stayed queued -
//     is stale. Whoever finds it later reads a record that is free (the CAS fails), a descriptor
//     (state held at done: the CAS fails), running or done (fails), or pending again as a *later*
//     job. In the last case the CAS succeeds and the finder runs that later job: its fields were
//     complete before its state became pending, its forker is waiting for exactly this, and its
//     own entry will fail the CAS in turn. A job still runs exactly once; only which queue led to
//     it changed. (Stage 5: a stale entry in one class's deque can then name a job of another
//     class; that is the case to revisit there.)
//   - The runner of a job touches the record for the last time in the swap that publishes `done`,
//     except to acknowledge a task waiter that had registered in the state word - and that waiter
//     does not release the record until it has seen the acknowledgement.
//
// WHO FREES. A record is released only by its forker, after it has seen `done` (rt_job_release
// checks). It goes on the free list of the worker the forker is running on at that moment, so each
// list is touched by one thread at a time and needs no lock; a forker that is not on a worker uses
// the locked list in the jobs block.
//
// Jobs block (raw_state()+3200, raw_map): 0 ring lock, 8 ring head, 16 ring tail, 80 ring, 88 ring
// capacity (the layout rt_inject_pop reads); 24 lock of the lists below, 32 free job records,
// 40 carve pointer, 48 carve bytes left, 56 free runner records, 64 a word that stays zero (a
// runner's cancel token), 72 free failure records (rt_job_failure_release), 104 workers started (thread-per-task mode); the Frame ring at 128 and the
// Background ring at 256, laid out like the Normal one at 0; 400 Background jobs running, 408 the
// cap on them (background_cap), 416 workers searching for work (rt_worker_loop, rt_notify), 424
// wakes issued (a futex wake each; GRAIL_SCHED_STATS prints it).
//
// CLASSES. A job is Frame (0), Normal (1) or Background (2), in record word 112. Each worker has a
// deque per class and there is a ring per class. A worker takes Frame work, then Normal work, then
// tasks, then Background work - strictly - and starts a Background job only while fewer than the cap
// are running. A job takes its parent's class (the job running on the stack that forked it); a root
// fork takes the class the stack was given by pool::with_class (parallel_class), else Normal. A
// queue entry is a hint (above), so an entry found in class X's queue whose record now says another
// class is a stale entry naming a later job: it is skipped, never claimed, which keeps every job at
// its own priority - its live entry is in its own class's queue, or its forker takes it back.
fn rt_job_deque_capacity() -> u64 {
    return 8192;
}
fn rt_jobs_create(workers: u64) -> u64 {
    j := raw_map(4096);
    if rt_error(j) {
        rt_abort();
    }
    mut c = 0;
    while c < 3 {
        ring := rt_job_ring_at(j, c);
        raw_store(ring + 80, raw_map(65536));
        raw_store(ring + 88, 8192);
        c += 1;
    }
    mut cap = rt_sched_setting(16);
    if cap == 0 {
        cap = workers / 4;
    }
    if cap == 0 {
        cap = 1;
    }
    raw_store(j + 408, cap);
    raw_store(j + 472, 1);
    raw_store(j + 480, 0);
    raw_atomic_store(rt_state_jobs(), j);
    return j;
}
// The scheduler, with its workers running: what every parallel call asks for first. In
// thread-per-task mode this is where the workers start, the first time a job is forked.
fn rt_jobs_sched() -> u64 {
    // The common case, once everything is running: one load (green mode never needs the second).
    made := raw_atomic_load(raw_state() + 72);
    if (made != 0) && (raw_load(raw_state() + 88) == 1) {
        return made;
    }
    s := rt_sched();
    if rt_task_threads() {
        j := raw_load(rt_state_jobs());
        if raw_atomic_cas(j + 104, 0, 1) == 0 {
            rt_sched_start(s);
        }
    }
    return s;
}
// `size` bytes of record storage, zeroed, from a free list or the carve block. The caller holds
// the lists' lock.
fn rt_job_carve(j: u64, list: u64, size: u64) -> u64 {
    r := raw_load(j + list);
    if r != 0 {
        raw_store(j + list, raw_load(r + 48));
        return r;
    }
    if raw_load(j + 48) < size {
        block := raw_map(65536);
        if rt_error(block) {
            rt_abort();
        }
        raw_store(j + 40, block);
        raw_store(j + 48, 65536);
    }
    made := raw_load(j + 40);
    raw_store(j + 40, made + size);
    raw_store(j + 48, raw_load(j + 48) - size);
    return made;
}
// The block whose job deques and free records this code uses: its worker's, or the external slot
// when a thread that is not a worker holds it (thread-record word 104).
fn rt_job_block() -> u64 {
    tp := raw_tp_get();
    if tp == 0 {
        return 0;
    }
    if raw_load(tp + 24) == 2 {
        return raw_load(tp + 32);
    }
    return raw_load(tp + 104);
}
// A thread that is not a worker, entering its outermost parallel region: take the external slot if
// it is free. The slot's deques may hold stale entries from its last holder; they are hints, and
// the acquire here orders this thread after that holder's release.
fn rt_external_take(tp: u64) -> u64 {
    s := raw_atomic_load(raw_state() + 72);
    if s == 0 {
        return 0;
    }
    if raw_atomic_cas(s + 136, 0, tp) == 0 {
        raw_store(tp + 104, raw_load(raw_load(s + 72) + raw_load(s + 32) * 8));
    }
    return 0;
}
fn rt_external_give(tp: u64) -> u64 {
    if raw_load(tp + 104) == 0 {
        return 0;
    }
    raw_store(tp + 104, 0);
    raw_atomic_store_release(raw_atomic_load(raw_state() + 72) + 136, 0);
    return 0;
}
fn rt_job_new() -> u64 {
    return rt_job_new_on(rt_worker_self());
}
fn rt_job_new_on(w: u64) -> u64 {
    mut r = 0;
    if w != 0 {
        r = raw_load(w + 240);
        if r != 0 {
            raw_store(w + 240, raw_load(r + 48));
            raw_store(w + 248, raw_load(w + 248) - 1);
        }
    }
    if r == 0 {
        j := raw_load(rt_state_jobs());
        rt_spin_lock(j + 24);
        r = rt_job_carve(j, 32, 128);
        rt_spin_unlock(j + 24);
    }
    raw_store(r + 56, 0);
    raw_store(r + 80, 0);
    raw_store(r + 88, 0);
    return r;
}
// Only the forker releases, and only a finished job (or a descriptor, whose state is held at done).
fn rt_job_release(r: u64) -> u64 {
    if raw_atomic_load(r + 32) != 3 {
        rt_abort();
    }
    raw_atomic_store(r + 32, 0);
    w := rt_job_block();
    if (w != 0) && (raw_load(w + 248) < 1024) {
        raw_store(r + 48, raw_load(w + 240));
        raw_store(w + 240, r);
        raw_store(w + 248, raw_load(w + 248) + 1);
        return 0;
    }
    j := raw_load(rt_state_jobs());
    rt_spin_lock(j + 24);
    raw_store(r + 48, raw_load(j + 32));
    raw_store(j + 32, r);
    rt_spin_unlock(j + 24);
    return 0;
}
// The task whose stack list this code is on, or 0: a green task or a runner. A thread-per-task
// task keeps its thread handle in word 152 and is not containable anyway.
fn rt_job_stack() -> u64 {
    t := rt_current();
    if t == 0 {
        return 0;
    }
    // The task mode is chosen before the first task exists (rt_sched), so a plain load is enough.
    if (raw_load(raw_state() + 88) == 2) && (raw_load(t + 104) != 3) {
        return 0;
    }
    return t;
}
fn rt_list_head(t: u64) -> u64 {
    return raw_load(t + 152) & 281474976710655;
}
fn rt_list_set(t: u64, head: u64) -> u64 {
    raw_store(t + 152, (raw_load(t + 152) & 18446462598732840960) | head);
    return 0;
}
// The claim word a caller writes: which worker's deque the job's own forks will land on.
fn rt_job_claim_word() -> u64 {
    w := rt_job_block();
    if w == 0 {
        return 2;
    }
    return (raw_load(w + 40) + 1) * 8;
}
// A new pending job fn(a, b, c), queued where a worker can find it: on this worker's job deque, or
// in the injection ring from any other thread. When neither has room the job is simply not queued;
// it stays pending and its forker runs it at the join. `listed` forks are the structured ones - the
// forker joins them before its frame returns - and go on the forker's stack list; a job handle is
// not listed, because it owns its captures and may be joined by anyone.
fn rt_job_fork(f: u64, a: u64, b: u64, c: u64) -> u64 {
    return rt_job_make(f, a, b, c, 1);
}
fn rt_job_make(f: u64, a: u64, b: u64, c: u64, listed: u64) -> u64 {
    return rt_job_make_class(f, a, b, c, listed, 3);
}
// `class` 3: inherit (the parent's class, else the stack's, else Normal).
fn rt_job_make_class(f: u64, a: u64, b: u64, c: u64, listed: u64, class: u64) -> u64 {
    w := rt_job_block();
    r := rt_job_new_on(w);
    raw_store(r, f);
    raw_store(r + 8, a);
    raw_store(r + 16, b);
    raw_store(r + 24, c);
    mut parent = 0;
    t := rt_job_stack();
    if t != 0 {
        head := rt_list_head(t);
        if (head & 1) != 0 {
            parent = head - 1;
        } else if head != 0 {
            parent = raw_load(head + 120);
        }
        if listed != 0 {
            raw_store(r + 64, head);
            rt_list_set(t, r);
        }
    }
    raw_store(r + 120, parent);
    mut k = class;
    if k == 3 {
        if parent != 0 {
            k = raw_load(parent + 112);
        } else if t == 0 {
            // A thread that keeps no stack list: its with_class setting is in its thread record,
            // word 112, as the class plus one (0: none).
            tp := raw_tp_get();
            k = 1;
            if (tp != 0) && (raw_load(tp + 112) != 0) {
                k = raw_load(tp + 112) - 1;
            }
        } else {
            k = 1;
        }
    }
    raw_store(r + 112, k);
    if k == 2 {
        raw_store(r + 104, rt_now_us());
    }
    raw_atomic_store(r + 32, 1);
    mut placed = 0;
    if w != 0 {
        placed = rt_deque_push(rt_job_deque(w, k), r);
    }
    if placed == 0 {
        placed = rt_job_inject_push(r);
    }
    if placed != 0 {
        rt_notify(raw_atomic_load(raw_state() + 72));
    }
    return r;
}
fn rt_job_deque(w: u64, class: u64) -> u64 {
    if class == 0 {
        return w + 512;
    }
    if class == 2 {
        return w + 640;
    }
    return w + 128;
}
fn rt_job_ring_at(j: u64, class: u64) -> u64 {
    if class == 0 {
        return j + 128;
    }
    if class == 2 {
        return j + 256;
    }
    return j;
}
fn rt_job_inject_push(r: u64) -> u64 {
    ring := rt_job_ring_at(raw_load(rt_state_jobs()), raw_load(r + 112));
    rt_spin_lock(ring);
    head := raw_load(ring + 8);
    tail := raw_load(ring + 16);
    if tail - head == raw_load(ring + 88) {
        rt_spin_unlock(ring);
        return 0;
    }
    raw_store(raw_load(ring + 80) + (tail % raw_load(ring + 88)) * 8, r);
    raw_atomic_store_release(ring + 16, tail + 1);
    rt_spin_unlock(ring);
    return 1;
}
// The next entry of class `class` from this worker's own deque, the class's ring, or a steal - in
// that order - skipping stale entries whose record is now another class.
fn rt_job_take(s: u64, w: u64, class: u64) -> u64 {
    while true {
        r := rt_deque_pop(rt_job_deque(w, class));
        if r == 0 {
            break;
        }
        if raw_load(r + 112) == class {
            return r;
        }
    }
    ring := rt_job_ring_at(raw_load(rt_state_jobs()), class);
    while true {
        r := rt_inject_pop(ring);
        if r == 0 {
            break;
        }
        if raw_load(r + 112) == class {
            return r;
        }
    }
    return rt_job_steal(s, w, class);
}
// Background work, if fewer than the cap are running.
// A worker reserves one of the cap's slots before it takes a Background job (a CAS, so two workers
// cannot both take the last one) and the job gives the slot back when it finishes: record word 88
// says it holds one. Work a Background job's own stack runs while it waits - its forks, run inline
// or helped - is not counted again: the stack already holds the slot.
fn rt_job_take_background(s: u64, w: u64) -> u64 {
    if rt_job_reserve_background() == 0 {
        return 0;
    }
    r := rt_job_take(s, w, 2);
    return rt_job_hold_background(r);
}
// The slot reserved for a Background job goes with the job only once the job is this worker's: it
// is claimed here, at once. An entry is a hint, so its job may already be another stack's - claimed
// by its forker - and a slot marked on a job that someone else runs would never come back (which
// is how the cap once leaked away until Background work stopped). The claimed job is handed on
// tagged with bit 0, so the runner does not claim it again.
fn rt_job_hold_background(r: u64) -> u64 {
    if (r != 0) && (raw_atomic_cas(r + 32, 1, rt_job_claim_word()) == 1) {
        raw_store(r + 88, 1);
        return r + 1;
    }
    raw_atomic_fetch_sub(raw_load(rt_state_jobs()) + 400, 1);
    // A slot came back: queued Background work may be waiting for it.
    rt_notify(raw_atomic_load(raw_state() + 72));
    return 0;
}
fn rt_job_reserve_background() -> u64 {
    j := raw_load(rt_state_jobs());
    while true {
        running := raw_atomic_load(j + 400);
        if raw_load(j + 408) <= running {
            return 0;
        }
        if raw_atomic_cas(j + 400, running, running + 1) == running {
            return 1;
        }
    }
    return 0;
}
fn rt_now_us() -> u64 {
    return f_host_now_us();
}
// The victims are every worker and the external slot. An empty deque is passed over with two
// loads and no call (an idle worker asks often, and most deques are empty).
fn rt_job_steal(s: u64, w: u64, class: u64) -> u64 {
    blocks := raw_load(s + 32) + 1;
    array := raw_load(s + 72);
    mut off = 128;
    if class == 0 {
        off = 512;
    } else if class == 2 {
        off = 640;
    }
    start := rt_worker_random(w) % blocks;
    mine := raw_load(w + 40);
    mut i = 0;
    while i < blocks {
        victim := (start + i) % blocks;
        if victim != mine {
            v := raw_load(array + victim * 8) + off;
            if raw_atomic_load(v + 8) < raw_atomic_load(v + 16) {
                r := rt_deque_steal(v);
                if (r != 0) && (raw_load(r + 112) == class) {
                    return r;
                }
            }
        }
        i += 1;
    }
    return 0;
}
// Run a job this caller has claimed, and publish it. While it runs it is at the head of this
// stack's list, so its forks know their parent. The swap is the last touch of the record unless a
// task had registered as the waiter: that task is woken and then told so, because it must not carry
// a wake that arrives after it has moved on.
fn rt_job_exec(r: u64) -> u64 {
    return rt_job_exec_by(r, 0);
}
// `own` is 1 when the forker runs its own job (claimed by pointer at its join): then nobody else
// can be waiting on the record - the only waiter a job has is its forker - so publishing is a
// release store, not a swap that would look for a waiter to wake.
fn rt_job_exec_by(r: u64, own: u64) -> u64 {
    // An address in this frame (word 96): frames above it are the job's forker's, when the forker
    // ran the job itself; a failure's join site is looked for there (rt_job_fail).
    mut mark = 0;
    here := &mut mark;
    raw_store(r + 96, here);
    background := raw_load(r + 88) == 1;
    t := rt_job_stack();
    if t != 0 {
        raw_store(r + 72, rt_list_head(t));
        rt_list_set(t, r + 1);
    }
    res := raw_call3(raw_load(r), raw_load(r + 8), raw_load(r + 16), raw_load(r + 24));
    raw_store(r + 40, res);
    if t != 0 {
        rt_list_set(t, raw_load(r + 72));
    }
    if background {
        raw_store(r + 88, 0);
        raw_atomic_fetch_sub(raw_load(rt_state_jobs()) + 400, 1);
        // A slot of the cap came free: Background work that waited for one may be queued with every
        // worker parked (a worker that could not take it parked), so it needs a wake now.
        rt_notify(raw_atomic_load(raw_state() + 72));
    }
    if own != 0 {
        raw_atomic_store_release(r + 32, 3);
        return 0;
    }
    return rt_job_publish(r);
}
fn rt_job_publish(r: u64) -> u64 {
    old := raw_atomic_swap(r + 32, 3);
    if old == 4 {
        rt_syscall_low(202, r + 32, 129, 2147483647);
    } else if 4095 < old {
        rt_wake(old);
        raw_atomic_store(r + 56, 1);
    }
    return 0;
}
// A job run on top of a waiter's frames. The depth of that nesting is counted in the top 16 bits
// of the running task's word 152 and its high-water mark kept per worker (word 264);
// GRAIL_SCHED_STATS=1 prints it at exit.
fn rt_job_help(w: u64, r: u64) -> u64 {
    t := rt_current();
    raw_store(t + 152, raw_load(t + 152) + 281474976710656);
    depth := raw_load(t + 152) / 281474976710656;
    if raw_load(w + 264) < depth {
        raw_store(w + 264, depth);
    }
    rt_job_exec(r);
    raw_store(t + 152, raw_load(t + 152) - 281474976710656);
    return 0;
}
// May this waiter run another job on top of its own frames? This is the one place that decides.
//   - Only on a worker: a thread that is not one takes back its own forks and nothing else.
//   - Only with room: at least an eighth of the stack left above the guard page. The job that would
//     be run is one this stack would have run anyway (rt_job_leap), so the room is a safety net
//     for the runtime's own frames, not the bound. Where the stack's bounds are not known (a
//     Windows fiber) the bound below is all there is.
//   - Not while this stack holds a lock (rt_holds_any).
fn rt_job_may_help(w: u64) -> u64 {
    if w == 0 {
        return 0;
    }
    t := rt_current();
    if t == 0 {
        return 0;
    }
    base := raw_load(t + 8);
    if base != 0 {
        // Where the stack is now: the address of a word of this frame, compared while the word is
        // live. (A helper returning the address of its own local hands back a dead pointer, which
        // the LLVM build may fold to anything - and did, so the guard never refused.)
        mut probe = base;
        at := &mut probe;
        if at < raw_load(at) + 4096 + raw_load(t + 16) / 8 {
            return 0;
        }
    }
    // A waiter that holds a lock does not help: a job it ran might want that lock. It parks, and
    // is promoted like any waiting job.
    if rt_holds_any() != 0 {
        return 0;
    }
    return 1;
}
// Is job `k` a descendant of job `r`? Parents are followed a bounded number of steps; the walk
// reads records that may be recycled under it, which is safe (records are never unmapped) and is
// checked again after the claim, when `k`'s ancestors can no longer change: each of them is inside
// a join waiting for the next.
fn rt_job_descends(k: u64, r: u64) -> u64 {
    mut at = k;
    mut steps = 0;
    while (at != 0) & (steps < 64) {
        if at == r {
            return 1;
        }
        at = raw_load(at + 120);
        steps += 1;
    }
    return 0;
}
// Leapfrogging: the only work a waiter takes while its job `r` runs elsewhere is a job forked by
// `r` or by one of `r`'s descendants - work this stack would have run inside `r` had `r` not been
// stolen. So nothing is ever stacked on a waiter that a sequential run would not have stacked
// there: a program whose joins fit its stack one after another fits it in parallel, however many
// workers steal. (Taking any job - the first version - let unrelated work pile up on one stack: a
// help depth of 29 on a recursion 21 deep, and no bound but the guard page.)
// `claimed` is the state word seen: it names the worker that took `r`, whose deque is where
// `r`'s forks are. Only the oldest entry there is looked at; anything else is left for its owner.
fn rt_job_leap(s: u64, r: u64, claimed: u64) -> u64 {
    if (claimed < 8) | (4095 < claimed) {
        return 0;
    }
    index := claimed / 8 - 1;
    if raw_load(s + 32) < index {
        return 0;
    }
    // r's descendants are r's class, so they are in that class's deque.
    v := rt_job_deque(raw_load(raw_load(s + 72) + index * 8), raw_load(r + 112));
    head := raw_atomic_load(v + 8);
    tail := raw_atomic_load(v + 16);
    if tail <= head {
        return 0;
    }
    k := raw_load(raw_load(v) + (head & raw_load(v + 24)) * 8);
    if (k == 0) | (k == r) {
        return 0;
    }
    if rt_job_descends(k, r) == 0 {
        return 0;
    }
    if raw_atomic_cas(v + 8, head, head + 1) != head {
        return 0;
    }
    return k;
}
// Return when job `r`, forked by the caller, is done.
//
// Still pending: claim it by pointer and run it here; its queue entry, usually the newest in this
// worker's deque, is taken out (an entry that is not it goes back). Claimed by someone else: on a
// worker with room, leapfrog; otherwise, and when there is nothing to leapfrog, wait.
fn rt_job_await(r: u64) -> u64 {
    s := raw_atomic_load(raw_state() + 72);
    mut idle = 0;
    while true {
        st := raw_atomic_load(r + 32);
        if st == 3 {
            return 0;
        }
        w := rt_job_block();
        if st == 1 {
            if raw_atomic_cas(r + 32, 1, rt_job_claim_word()) == 1 {
                if w != 0 {
                    k := rt_deque_pop(rt_job_deque(w, raw_load(r + 112)));
                    if (k != 0) & (k != r) {
                        rt_deque_push(rt_job_deque(w, raw_load(r + 112)), k);
                    }
                }
                rt_job_exec_by(r, 1);
                return 0;
            }
        } else {
            mut k = 0;
            if rt_job_may_help(w) != 0 {
                k = rt_job_leap(s, r, st);
            }
            if k != 0 {
                idle = 0;
                claim := rt_job_claim_word();
                if raw_atomic_cas(k + 32, 1, claim) == 1 {
                    if rt_job_descends(k, r) != 0 {
                        rt_job_help(w, k);
                    } else if raw_atomic_cas(k + 32, claim, 1) == claim {
                        // The record was recycled between the look and the claim: this is some
                        // other job. Give it back, where a worker will find it - with a CAS: its
                        // forker may have seen the claim and registered as its waiter meanwhile,
                        // and a plain store of `pending` would erase that registration, so the job
                        // would later be published to nobody and the forker would sleep for ever
                        // (sched-wake-not-lost-under-constant-parking hung this way on aarch64).
                        if rt_deque_push(rt_job_deque(w, raw_load(k + 112)), k) == 0 {
                            rt_job_inject_push(k);
                        }
                        rt_notify(s);
                    } else {
                        // Its forker is waiting on it now: run it here, and the publish wakes it.
                        rt_job_help(w, k);
                    }
                }
            } else {
                // A stolen join usually finishes within microseconds: look a few more times before
                // paying for a park and a wake.
                idle += 1;
                if 64 < idle {
                    rt_job_park(r);
                    idle = 0;
                }
            }
        }
    }
    return 0;
}
// Wait for a job somebody else is running. A task registers itself in the state word and parks;
// the finisher wakes it and acknowledges, and the task leaves only after the acknowledgement, with
// no wake left pending. A plain OS thread sleeps on the state word itself.
fn rt_job_park(r: u64) -> u64 {
    st := raw_atomic_load(r + 32);
    if (st == 1) | (st == 3) {
        return 0;
    }
    me := rt_current();
    if me != 0 {
        if 4095 < st {
            return 0;
        }
        if raw_atomic_cas(r + 32, st, me) == st {
            while raw_atomic_load(r + 32) != 3 {
                rt_suspend(me);
            }
            while raw_atomic_load(r + 56) == 0 {
                rt_syscall_low(24, 0, 0, 0);
            }
            raw_atomic_cas(me + 24, 3, 0);
        }
        return 0;
    }
    if st != 4 {
        if raw_atomic_cas(r + 32, st, 4) != st {
            return 0;
        }
    }
    rt_syscall_low(202, r + 32, 128, 4);
    return 0;
}
// Join a listed fork: it is the newest entry of this stack's list, and leaves it here.
fn rt_job_join(r: u64) -> u64 {
    rt_job_await(r);
    t := rt_job_stack();
    if t != 0 {
        rt_list_set(t, raw_load(r + 64));
    }
    res := raw_load(r + 40);
    f := raw_load(r + 80);
    rt_job_release(r);
    if f != 0 {
        rt_job_reraise(f);
    }
    return res;
}

// ---- a failure inside a parallel region (F1) -----------------------------------------------------
// The stack whose failure is handled here, or 0: a green task or runner that is inside a parallel
// region (its stack list is not empty). Anything else fails as it always has.
fn rt_job_failing() -> u64 {
    t := rt_job_stack();
    if t == 0 {
        return 0;
    }
    if rt_list_head(t) == 0 {
        return 0;
    }
    return t;
}
// The stack `t` failed (kind, a, b; `site` a statement-table entry, or an owned text with bit 0
// set; `msg` an owned text or 0). Nothing unwinds. In order, on this same stack:
//   0. Locks: release and poison every lock this stack holds, before it waits for anything - a
//      stolen child may be waiting for one of them (rt_held_settle; docs/design/parking.md).
//   1. Drain: every fork this stack has not joined is either taken back unrun (still pending) or
//      waited for (running elsewhere: it may be borrowing these frames). Nothing else is run - no
//      help, no claim of anything else - and the wait is not cancellable (rt_job_settle).
//   2. Every job this stack was running gets the failure and is published as done; their forkers
//      re-raise it at their joins (rt_job_reraise), and their own stacks then do the same.
//   3. The stack is discarded: a runner ends; a task is contained as any failed task is.
// A stack overflow does not come here: the drain needs stack, so it stays fatal.
// A failure raised on this stack by the statement that is running: its site is found here (the walk
// uses the record's scratch words, the last of which then says "no join site known yet").
fn rt_job_fail_here(t: u64, kind: u64, a: u64, b: u64, msg: u64) -> u64 {
    site := rt_site_here(t + 200) & 18446744073709551614;
    raw_store(t + 232, 0);
    return rt_job_fail(t, kind, a, b, site, msg);
}
// The statement where the failed job was joined, when the caller knows it (a joiner re-raising), is
// in the stack's word 232 (rt_job_fail_joined); 0 there means "find it here".
fn rt_job_fail(t: u64, kind: u64, a: u64, b: u64, site: u64, msg: u64) -> u64 {
    joined := raw_load(t + 232);
    raw_store(t + 232, 0);
    // 0. Locks first (rt_held_settle takes the record's waiter block; a site that is an owned text
    // names no statement, so the poison records none).
    mut poison_site = site;
    if (poison_site & 1) == 1 {
        poison_site = 0;
    }
    rt_held_settle(t + 240, poison_site);
    // The failure record is not a heap allocation: a failure may be raised where the allocator lock
    // is held, and inside `@no_alloc` code, so nothing on this path touches the allocator. It comes
    // from the jobs block's free list (rt_job_failure_record), and word 40 counts the jobs it is
    // published to: each joiner gives one back after it has built the texts (rt_job_reraise), and
    // the last returns the record to the list, so a program that contains a failure every frame
    // runs in bounded memory.
    f := rt_job_failure_record();
    // Where the failed job was joined, as a statement entry: given by a joiner that re-raises it, or
    // - for a job this stack's own forker ran here - the first program statement above the job's
    // frame. A job a worker stole has no forker frames here; its joiner fills it in.
    mut join_at = joined;
    if join_at == 0 {
        newest := rt_list_head(t);
        mut walk0 = newest;
        while walk0 != 0 {
            if (walk0 & 1) != 0 {
                break;
            }
            walk0 = raw_load(walk0 + 64);
        }
        if walk0 != 0 {
            join_at = rt_site_above(t + 200, raw_load(walk0 - 1 + 96), 0);
        }
    }
    raw_store(f + 56, join_at);
    mut users = 0;
    mut walk = rt_list_head(t);
    while walk != 0 {
        if (walk & 1) != 0 {
            users += 1;
            walk = raw_load(walk - 1 + 72);
        } else {
            walk = raw_load(walk + 64);
        }
    }
    raw_store(f + 40, users);
    raw_store(f, kind);
    raw_store(f + 8, a);
    raw_store(f + 16, b);
    raw_store(f + 24, site);
    raw_store(f + 32, msg);
    // 1 and 2 in one walk of the stack list, newest entry first. A fork is settled before any job
    // older than it is published: the forks a job made (newer than it) may be borrowing that job's
    // frames and, through its captures, its forker's - which publishing lets the forker free. A
    // fork older than a job is settled after that job is published, because it may be waiting for
    // it: a job this stack helped with is a descendant of the fork it was waiting for. A fork this
    // stack took back and ran itself is published as the job (its newer, tagged entry) before its
    // fork entry is reached.
    mut e = rt_list_head(t);
    while e != 0 {
        if (e & 1) != 0 {
            r := e - 1;
            e = raw_load(r + 72);
            raw_store(r + 80, f);
            if raw_load(r + 88) == 1 {
                raw_store(r + 88, 0);
                raw_atomic_fetch_sub(raw_load(rt_state_jobs()) + 400, 1);
            }
            rt_job_publish(r);
        } else {
            r := e;
            e = raw_load(r + 64);
            // A published job's record is its forker's from then on, so links are read before.
            // A fork this stack took back and ran is already published (its job entry is newer), so
            // this finds it done and does not wait for itself.
            rt_job_settle(r);
            // This stack forked it, so this stack releases it - unless it ran it itself, in which
            // case the record carries the failure and stays (a leak, like the stack's own frames).
            if raw_load(r + 80) != f {
                rt_job_release(r);
            }
        }
    }
    raw_store(t + 152, 0);
    if users == 0 {
        rt_job_failure_release(f);
    }
    // 3. Discard the stack. A task keeps the failure as numbers (or as the texts a joiner already
    // built, when it was raised again at a join), and its own joiner formats it: this path builds
    // no text.
    if raw_load(t + 104) == 3 {
        return rt_contain_tail(t);
    }
    if (site & 1) != 0 {
        return rt_contain_text(t, kind, msg, site & 18446744073709551614);
    }
    raw_store(t + 232, join_at);
    return rt_contain_joined(t, kind, a, b, site, msg);
}
// A failure record - kind, two operands, site, message, users, join site (words 0..40, 56) - from the jobs block's
// free list or its pages (rt_job_carve), never the heap.
fn rt_job_failure_record() -> u64 {
    j := raw_load(rt_state_jobs());
    rt_spin_lock(j + 24);
    f := rt_job_carve(j, 72, 64);
    rt_spin_unlock(j + 24);
    return f;
}
// The free-list link is word 48, as for every record rt_job_carve hands out.
fn rt_job_failure_release(f: u64) -> u64 {
    j := raw_load(rt_state_jobs());
    rt_spin_lock(j + 24);
    raw_store(f + 48, raw_load(j + 72));
    raw_store(j + 72, f);
    rt_spin_unlock(j + 24);
    return 0;
}
// Bring a fork this failing stack has not joined to done without running anything: take it back
// if nobody has it, else wait - parked, not cancellable, re-testing after every wake.
fn rt_job_settle(r: u64) -> u64 {
    while true {
        st := raw_atomic_load(r + 32);
        if st == 3 {
            return 0;
        }
        if st == 1 {
            if raw_atomic_cas(r + 32, 1, 2) == 1 {
                raw_atomic_store(r + 32, 3);
                return 0;
            }
        } else {
            rt_job_park(r);
        }
    }
    return 0;
}
// A failure's message text, copied for the joiner (the record is shared by every job it was
// published to), or 0 when the message is dictated by the kind.
fn rt_job_message(f: u64) -> u64 {
    msg := raw_load(f + 32);
    if msg == 0 {
        return 0;
    }
    out := rt_new();
    rt_append(out, msg);
    return out;
}
// The forker's side: the joined job failed, so this stack fails with the same failure. Inside a
// parallel region it is handed on as it is (the statement entry, not yet a text); where it leaves
// the parallel region - contained by a task, or ending the process - its site is the original
// statement plus one line naming where the job was joined, which is the caller's statement.
fn rt_job_reraise(f: u64) -> u64 {
    // The failure was counted where it happened; the stack it is raised on now is one more stack
    // discarded, not one more failure (rt_contained_note counts it again when it is contained).
    // Atomic and wrapping: the failing stack may not have counted its failure yet (it publishes the
    // job before it is contained), so the count can pass through -1 here. A checked subtraction
    // trapped on exactly that - silently, inside the failure path - when the joiner ran first
    // (sched-job-failure-forms-from-a-task, exit 134 about 1 run in 10 under qemu).
    raw_atomic_fetch_add(rt_contained_word(), wrapping_sub(0, 1));
    raw_atomic_fetch_add(rt_discarded_word(), 1);
    // Numbers, as at the failure: the kind, the operands, the failing statement and - the first
    // time the failure crosses a join - this joiner's own statement. Whoever reports it renders
    // both lines from them; only a message text is copied (the record is shared).
    kind := raw_load(f);
    a := raw_load(f + 8);
    b := raw_load(f + 16);
    site := raw_load(f + 24);
    msg := rt_job_message(f);
    mut joined = raw_load(f + 56);
    if raw_atomic_fetch_sub(f + 40, 1) == 1 {
        rt_job_failure_release(f);
    }
    me := rt_current();
    if (joined == 0) & ((site & 1) == 0) {
        if me != 0 {
            joined = rt_site_above(me + 200, 0, 0);
        }
    }
    j := rt_job_failing();
    if j != 0 {
        raw_store(j + 232, joined);
        return rt_job_fail(j, kind, a, b, site, msg);
    }
    t := rt_containable();
    if t != 0 {
        if (site & 1) != 0 {
            return rt_contain_text(t, kind, msg, site & 18446744073709551614);
        }
        raw_store(t + 232, joined);
        return rt_contain_joined(t, kind, a, b, site, msg);
    }
    // Ends the process: one report, the failing statement first, then the join.
    if rt_abort_begin() == 0 {
        rt_abort_park();
    }
    buf := rt_report_buf();
    if (joined == 0) & ((site & 1) == 0) {
        joined = rt_site_above(rt_report_sites(), 0, 0);
    }
    mut n = rt_fail_put(buf, 0, view("error: "));
    if msg != 0 {
        rt_copy_bytes(buf + n, raw_load(msg), raw_load(msg + 8));
        n += raw_load(msg + 8);
    } else {
        n = rt_fail_body(kind, a, b, buf, n);
    }
    raw_putbyte(buf + n, 10);
    n += 1;
    if (site & 1) != 0 {
        text := site & 18446744073709551614;
        rt_copy_bytes(buf + n, raw_load(text), raw_load(text + 8));
        n += raw_load(text + 8);
    } else if site != 0 {
        n = rt_fail_line(buf, n, site, view(" --> "));
    }
    if joined != 0 {
        n = rt_fail_line(buf, n, joined, view(" = in a job joined at "));
    }
    rt_write_all(2, buf, n);
    return rt_abort_final();
}
// A thread that is not running a task counts its parallel regions in thread-record word 24, in
// steps of 16 so the word never reads as a worker marker: inside a region it may fail at the same
// moment as a worker running a sibling leaf, so it reports as a runtime thread does
// (rt_abort_signals) - status 134, not a signal that can race the exit. A task needs no count: its
// stack list is non-empty exactly while it is inside one.
fn rt_region_enter() -> u64 {
    return rt_region_step(16);
}
fn rt_region_leave() -> u64 {
    return rt_region_step(wrapping_sub(0, 16));
}
fn rt_region_step(by: u64) -> u64 {
    if rt_current() != 0 {
        return 0;
    }
    tp := raw_tp_get();
    if tp != 0 {
        before := raw_load(tp + 24);
        raw_store(tp + 24, wrapping_add(before, by));
        if before == 0 {
            rt_external_take(tp);
        } else if wrapping_add(before, by) == 0 {
            rt_external_give(tp);
        }
    }
    return 0;
}
// ---- runners --------------------------------------------------------------------------------
// A worker does not run a job on its scheduler stack: it enters its runner, a green task whose
// body is the loop below. Inside a job rt_current() is therefore always a task, so a job that
// waits - a sleep, a descriptor, a join, an offloaded call - parks the runner exactly as any task
// parks, with no code of its own: rt_worker_run sees the runner leave without being idle, forgets
// it, and the worker makes a fresh runner for its next job. The parked runner is resumed by
// whichever worker takes it from a task deque, finishes its job, finds it is nobody's runner and
// ends. A job that never waits costs no switch of its own: the runner drains the worker's job
// deque before it goes idle. The runner's stack is a task stack, so a job that overflows it gets
// the task's report.
//
// A runner is a task record (256 bytes from the jobs block, not the allocator: it is
// infrastructure and must not count as a live allocation at exit): callback rt_runner_main, handle
// word 104 = 3 marks it, word 152 is its stack list like any task's, and its
// cancel token is a word that stays zero.
fn rt_runner_new() -> u64 {
    j := raw_load(rt_state_jobs());
    rt_spin_lock(j + 24);
    t := rt_job_carve(j, 56, rt_task_record_size());
    rt_spin_unlock(j + 24);
    mut i = 0;
    while i < rt_task_record_size() {
        raw_store(t + i, 0);
        i += 8;
    }
    raw_store(t + 40, rt_runner_main);
    raw_store(t + 48, t);
    raw_store(t + 64, 2);
    raw_store(t + 72, j + 64);
    raw_store(t + 104, 3);
    return t;
}
fn rt_runner_free(t: u64) -> u64 {
    j := raw_load(rt_state_jobs());
    rt_spin_lock(j + 24);
    raw_store(t + 48, raw_load(j + 56));
    raw_store(j + 56, t);
    rt_spin_unlock(j + 24);
    return 0;
}
fn rt_runner_main(t: u64, unused: u64) -> u64 {
    while true {
        w := rt_worker_self();
        if w == 0 {
            break;
        }
        if raw_load(w + 224) != t {
            break; // resumed as a task after a wait: the job is finished and so is this runner
        }
        mut j = raw_load(w + 232);
        raw_store(w + 232, 0);
        if j == 0 {
            j = rt_job_take_own(w);
        }
        if j == 0 {
            raw_atomic_store(t + 24, 4);
            rt_os_ctx_leave(t);
            raw_atomic_store(t + 24, 0);
        } else if (j & 1) != 0 {
            rt_job_exec(j - 1); // a Background job, claimed when its slot was taken
        } else {
            if raw_atomic_cas(j + 32, 1, rt_job_claim_word()) == 1 {
                rt_job_exec(j);
            }
        }
    }
    return 0;
}
// The next job from this worker's own deques, by class (the runner's drain): Frame, Normal, then
// Background under the cap. Stale entries are skipped as in rt_job_take.
fn rt_job_take_own(w: u64) -> u64 {
    mut c = 0;
    while c < 2 {
        while true {
            r := rt_deque_pop(rt_job_deque(w, c));
            if r == 0 {
                break;
            }
            if raw_load(r + 112) == c {
                return r;
            }
        }
        c += 1;
    }
    if rt_job_reserve_background() == 0 {
        return 0;
    }
    while true {
        r := rt_deque_pop(rt_job_deque(w, 2));
        if r == 0 {
            break;
        }
        if raw_load(r + 112) == 2 {
            return rt_job_hold_background(r);
        }
    }
    raw_atomic_fetch_sub(raw_load(rt_state_jobs()) + 400, 1);
    return 0;
}
// How long the oldest queued Background job has waited, in microseconds (0: none queued). Entries
// are read without locks: records never go away, a stale entry is filtered by state and class, and
// the answer is a statistic, not a decision.
fn rt_background_wait_us() -> u64 {
    s := raw_atomic_load(raw_state() + 72);
    if s == 0 {
        return 0;
    }
    j := raw_load(rt_state_jobs());
    now := rt_now_us();
    mut oldest = 0;
    workers := raw_load(s + 32);
    mut i = 0;
    while i <= workers {
        mut d = 0;
        if i < workers {
            d = rt_job_deque(raw_load(raw_load(s + 72) + i * 8), 2);
        } else {
            d = rt_job_ring_at(j, 2);
        }
        head := raw_atomic_load(d + 8);
        tail := raw_atomic_load(d + 16);
        mut at = head;
        while (at < tail) & (at < head + 4096) {
            mut slot = 0;
            if i < workers {
                slot = raw_load(d) + (at & raw_load(d + 24)) * 8;
            } else {
                slot = raw_load(d + 80) + (at % raw_load(d + 88)) * 8;
            }
            r := raw_load(slot);
            if (r != 0) && (raw_atomic_load(r + 32) == 1) && (raw_load(r + 112) == 2) {
                stamp := raw_load(r + 104);
                if (stamp < now) && (oldest < now - stamp) {
                    oldest = now - stamp;
                }
            }
            at += 1;
        }
        i += 1;
    }
    return oldest;
}
// host::stack_left(): how many bytes of the current green task's stack are left below the caller
// (above the guard page), or 0 off a task. For code that recurses deeply and wants to stop, or to
// fork instead, before it runs into the guard page.
fn f_host_stack_left() -> u64 {
    t := rt_current();
    if t == 0 {
        return 0;
    }
    base := raw_load(t + 8);
    if base == 0 {
        return 0;
    }
    mut probe = base + 4096;
    at := &mut probe;
    if at < raw_load(at) {
        return 0;
    }
    return at - raw_load(at);
}
fn f_host_background_wait_us() -> u64 {
    return rt_background_wait_us();
}
// `parallel_class(class, f)`, which is pool::with_class: run f with forks of class `class`. On a
// green stack f is forked as a job of that class and joined at once, which the forker does by
// running it here (claim by pointer) unless a worker took it first; everything it forks inherits
// the class from it. A plain thread keeps the class in its thread record for the duration.
fn rt_parallel_class(class: u64, f: u64, env: u64) -> u64 {
    rt_jobs_sched();
    if rt_job_stack() != 0 {
        r := rt_job_make_class(rt_job_call0, f, env, 0, 1, class);
        return rt_job_join(r);
    }
    tp := raw_tp_get();
    old := raw_load(tp + 112);
    raw_store(tp + 112, class + 1);
    res := rt_job_call0(f, env, 0);
    raw_store(tp + 112, old);
    return res;
}
// sched::start(Config): the settings the scheduler is made with, applied only before it exists.
// Block (raw_map, process-state word 3424): 8 workers, 16 background cap, 24 pin workers,
// 32 stacks warmed per worker, 40 steal seed, 48 idle spin in microseconds; 0 everywhere means the
// default. 0 when it was applied, 1 when the scheduler already existed or a config was already set:
// the caller gets an answer, never an abort.
fn f_host_sched_start(workers: u64, cap: u64, pin: u64, warm: u64, seed: u64, spin: u64) -> u64 {
    if raw_atomic_load(raw_state() + 80) != 0 {
        return 1;
    }
    block := raw_map(4096);
    if rt_error(block) {
        rt_abort();
    }
    mut w = workers;
    if 64 < w {
        w = 64;
    }
    raw_store(block + 8, w);
    raw_store(block + 16, cap);
    raw_store(block + 24, pin);
    raw_store(block + 32, warm);
    raw_store(block + 40, seed);
    raw_store(block + 48, spin);
    if raw_atomic_cas(rt_sched_config(), 0, block) != 0 {
        rt_syscall_low(11, block, 4096, 0);
        return 1;
    }
    // The scheduler may have been made between the first test and the publication: then the
    // settings came too late, and saying so is the honest answer.
    if raw_atomic_load(raw_state() + 80) != 0 {
        return 1;
    }
    return 0;
}
fn rt_sched_config() -> u64 {
    return raw_state() + 3424;
}
fn rt_sched_setting(offset: u64) -> u64 {
    block := raw_atomic_load(rt_sched_config());
    if block == 0 {
        return 0;
    }
    return raw_load(block + offset);
}
// GRAIL_SCHED_STATS=1: one line on stderr at exit.
fn rt_sched_stats() -> u64 {
    s := raw_atomic_load(raw_state() + 72);
    if s == 0 {
        return 0;
    }
    if rt_env_is(view("GRAIL_SCHED_STATS"), view("1")) == 0 {
        return 0;
    }
    array := raw_load(s + 72);
    workers := raw_load(s + 32);
    mut high = 0;
    mut i = 0;
    while i < workers {
        seen := raw_load(raw_load(array + i * 8) + 264);
        if high < seen {
            high = seen;
        }
        i += 1;
    }
    text := rt_new();
    rt_reserveb(text, 160);
    buf := raw_load(text);
    mut n = rt_fail_put(buf, 0, view("grail: sched: workers "));
    n = rt_fail_num(buf, n, workers);
    n = rt_fail_put(buf, n, view(", help depth high-water "));
    n = rt_fail_num(buf, n, high);
    n = rt_fail_put(buf, n, view(", wakes "));
    n = rt_fail_num(buf, n, raw_load(raw_load(rt_state_jobs()) + 424));
    n = rt_fail_put(buf, n, view(", oldest background wait "));
    n = rt_fail_num(buf, n, rt_background_wait_us());
    n = rt_fail_put(buf, n, view(" us"));
    n = rt_fail_put(buf, n, view("\n"));
    raw_store(text + 8, n);
    rt_write_text(2, text);
    return 0;
}
// The task's own call: arity 3 carries the scope's cancel token.
fn rt_task_body(t: u64) -> u64 {
    f := raw_load(t + 40);
    item := raw_load(t + 48);
    context := raw_load(t + 56);
    mut r = 0;
    if raw_load(t + 64) == 3 {
        r = raw_call3(f, item, context, raw_load(t + 72));
    } else {
        r = raw_call2(f, item, context);
    }
    return r;
}
fn rt_task_finish(t: u64) -> u64 {
    raw_store(t + 80, rt_task_body(t));
    raw_store(t + 144, 1);
    return 0;
}
fn rt_green_main() -> u64 {
    t := rt_current();
    rt_task_finish(t);
    rt_os_ctx_leave(t);
    rt_abort();
    return 0;
}
// Thread-per-task entry (Windows): the task runs to completion on its own OS thread, then publishes
// its result and wakes whoever waits on its finished word. No stack switch is involved, so a task
// that blocks in a foreign call blocks only itself.
fn rt_task_thread_main(t: u64) -> u64 {
    w := raw_tp_get();
    raw_store(w + 16, t);
    raw_store(t + 80, rt_task_body(t));
    raw_store(t + 144, 1);
    raw_atomic_store(t + 96, 1);
    rt_syscall_low(202, t + 96, 129, 2147483647);
    raw_store(w + 16, 0);
    return 0;
}
// Suspend the current task until rt_wake. A wake that arrives first is not lost.
fn rt_suspend(t: u64) -> u64 {
    tp := raw_tp_get();
    if (tp != 0) && (raw_load(tp + 120) != 0) {
        // Inside a callback C made on this thread (thread-record word 120): C's frames are on this
        // stack, so the task stays on this thread - it blocks the thread on its park word (state 5)
        // instead of switching away, and rt_wake wakes the thread.
        if raw_atomic_cas(t + 24, 0, 5) != 0 {
            raw_atomic_store(t + 24, 0);
            return 0;
        }
        while raw_atomic_load(t + 24) == 5 {
            rt_syscall_low(202, t + 24, 128, 5);
        }
        raw_atomic_store(t + 24, 0);
        return 0;
    }
    if raw_atomic_cas(t + 24, 0, 1) != 0 {
        raw_atomic_store(t + 24, 0);
        return 0;
    }
    if rt_task_threads() {
        // No stack switch: block this task's own thread on its park word until a wake marks it.
        while true {
            if raw_atomic_load(t + 24) == 3 {
                raw_atomic_store(t + 24, 0);
                return 0;
            }
            rt_syscall_low(202, t + 24, 128, 1);
        }
    }
    rt_os_ctx_leave(t);
    return 0;
}
fn rt_wake(t: u64) -> u64 {
    while true {
        s := raw_atomic_load(t + 24);
        if rt_task_threads() {
            if s == 3 {
                return 0;
            }
            if raw_atomic_cas(t + 24, s, 3) == s {
                rt_syscall_low(202, t + 24, 129, 1);
                return 0;
            }
        } else if s == 5 {
            // Parked pinned on its own thread (rt_suspend, inside a callback).
            if raw_atomic_cas(t + 24, 5, 3) == 5 {
                rt_syscall_low(202, t + 24, 129, 1);
                return 0;
            }
        } else if s == 2 {
            if raw_atomic_cas(t + 24, 2, 0) == 2 {
                rt_enqueue_in(raw_atomic_load(raw_state() + 72), t);
                return 0;
            }
        } else {
            if s == 3 {
                return 0;
            }
            if raw_atomic_cas(t + 24, s, 3) == s {
                return 0;
            }
        }
    }
    return 0;
}
fn rt_yield() -> u64 {
    t := rt_current();
    if (t == 0) | rt_task_threads() {
        // A thread-per-task task owns its thread, so yielding is giving up the CPU, not a switch.
        rt_syscall_low(24, 0, 0, 0);
        return 0;
    }
    raw_store(t + 136, 1);
    rt_os_ctx_leave(t);
    return 0;
}
// ---- structured task scopes ----
// Scope words: 0 self (a scope reference points here), 8 cancel flag, 16 context, 24 tasks.
fn rt_scope_begin(context: u64) -> u64 {
    s := rt_alloc(32);
    raw_store(s, s);
    raw_store(s + 16, context);
    return s;
}
fn rt_scope_token(s: u64) -> u64 {
    return s + 8;
}
fn rt_cancelled(p: u64) -> u64 {
    if raw_load(p) == p {
        return raw_atomic_load(p + 8);
    }
    return raw_atomic_load(p);
}
// Cancellation is cooperative and observable; it also wakes tasks in cancellable waits.
fn rt_cancel(s: u64) -> u64 {
    raw_atomic_store(s + 8, 1);
    mut t = raw_load(s + 24);
    while t != 0 {
        if raw_atomic_load(t + 128) {
            rt_wake(t);
        }
        t = raw_load(t + 120);
    }
    return 0;
}
// The task record. Words 40-152 are listed at the scope functions below; the containment area is:
//   160 failure kind (0 = the task did not fail)   168 a   176 b
//   184 the failing statement's site-table entry (a static address in 24-byte stride) or, for a
//       re-raised failure, its owned site text - bit 0 says which, and costs no word, because a
//       table entry is 8-byte aligned and an allocation is more so
//   192 message text (0 when the message is dictated by the kind)
//   200..240 the site walk's descriptor buffer, rt_sites_words() words (statement table start and
//       end, caller frame, function table start and end). It is handed to the compiler's helper with
//       its capacity (rt_sites_fill), so the helper writes a prefix of it and the walk reads three;
//       neither side sizes the area from what it reads. 240 bytes of payload and a 16-byte block
//       header are exactly one 256-byte size class, so an area one word short would write into the
//       block that follows - which is the overrun that once landed on the next block's header.
// A failed task has no result: word 80 is never written and its dropper is never called.
fn rt_task_spawn(s: u64, f: u64, item: u64, arity: u64, dropper: u64) -> u64 {
    // Word 152 holds the task's OS thread handle in thread-per-task mode (0 in green mode).
    t := rt_alloc(rt_task_record_size());
    raw_store(t + 40, f);
    raw_store(t + 48, item);
    raw_store(t + 56, raw_load(s + 16));
    raw_store(t + 64, arity);
    raw_store(t + 72, s + 8);
    raw_store(t + 112, dropper);
    raw_store(t + 120, raw_load(s + 24));
    raw_store(t + 152, 0);
    raw_store(s + 24, t);
    if rt_task_threads() {
        raw_store(t + 152, rt_thread_spawn(rt_task_thread_main, t));
        return t;
    }
    // Green: the task's execution context (a stack whose initial frame enters rt_green_main on Linux
    // and macOS, a fiber started in rt_win_fiber_start on Windows) is built the first time a worker
    // runs it (rt_worker_run), not here. A burst of 100k spawns therefore costs records and queue
    // slots, not 100k stack mappings, and only the tasks that actually run hold a stack.
    rt_enqueue(t);
    return t;
}
fn rt_task_wait(t: u64) -> u64 {
    if raw_atomic_load(t + 96) {
        return 0;
    }
    if rt_task_threads() {
        // The task's own thread publishes word 96 and wakes this address, so the waiter blocks here.
        while raw_atomic_load(t + 96) == 0 {
            rt_syscall_low(202, t + 96, 128, 0);
        }
        return 0;
    }
    me := rt_current();
    if me != 0 {
        if raw_atomic_cas(t + 88, 0, me) == 0 {
            while raw_atomic_load(t + 96) == 0 {
                rt_suspend(me);
            }
        }
        while raw_atomic_load(t + 96) == 0 {
            rt_yield();
        }
        return 0;
    }
    while raw_atomic_load(t + 96) == 0 {
        rt_syscall_low(202, t + 96, 128, 0);
    }
    return 0;
}
// `join` asserts success: a task that failed reports its recorded failure *here*, at the join, and
// ends the process by the ordinary rules of rt_fail_text - contained by an enclosing task, fatal
// at the top level. Nothing of the failed task's stack is involved; the report is its record.
fn rt_task_join(t: u64) -> u64 {
    if raw_load(t + 104) != 0 {
        rt_abort();
    }
    rt_task_wait(t);
    raw_store(t + 104, 1);
    rt_task_reap(t);
    kind := raw_load(t + 160);
    if kind != 0 {
        msg := rt_task_message(t);
        site := rt_task_site(t);
        return rt_fail_text(kind, msg, site);
    }
    return raw_load(t + 80);
}
// Report a failure that already has its texts: contained by an enclosing task if there is one
// (task-record words 184/192 then carry the two texts), fatal from the top of the program.
fn rt_fail_text(kind: u64, msg: u64, site: u64) -> u64 {
    j := rt_job_failing();
    if j != 0 {
        raw_store(j + 232, 0);
        return rt_job_fail(j, kind, 0, 0, site | 1, msg);
    }
    t := rt_containable();
    if t != 0 {
        return rt_contain_text(t, kind, msg, site);
    }
    if rt_abort_begin() == 0 {
        rt_abort_park();
    }
    return rt_report_die(msg, site);
}
// `try_join`: the same join, but the outcome is a value. Result: the task's result word on success,
// and a two-word union record `{tag, payload}` on both arms - tag 0 carries the result, tag 1 a
// three-word failure record `{kind, message, site}`. The failure's two texts move into that record;
// the task record itself is released at scope exit like any other.
fn rt_task_outcome(t: u64) -> u64 {
    if raw_load(t + 104) != 0 {
        rt_abort();
    }
    rt_task_wait(t);
    raw_store(t + 104, 1);
    rt_task_reap(t);
    kind := raw_load(t + 160);
    if kind == 0 {
        return rt_enum(0, raw_load(t + 80));
    }
    msg := rt_task_message(t);
    site := rt_task_site(t);
    rec := rt_alloc(24);
    raw_store(rec, kind);
    raw_store(rec + 8, msg);
    raw_store(rec + 16, site);
    return rt_enum(1, rec);
}
// The recorded failure's message as an owned text. A failure that stored its own text (an explicit
// `task_fail`, or a re-raised failure) hands it over; a check failure is formatted here, once, by
// the caller that asked for it.
fn rt_task_message(t: u64) -> u64 {
