        raw_store(wrapping_add(dst, i), raw_load(wrapping_add(src, i)));
        i = wrapping_add(i, 8);
    }
    while i < n {
        raw_putbyte(wrapping_add(dst, i), raw_byte(wrapping_add(src, i)));
        i = wrapping_add(i, 1);
    }
    return 0;
}
// Shortens a byte vector to `keep` bytes; a no-op when it is already that short (as for T[]).
fn rt_bytes_truncate(s: u64, keep: u64) -> u64 {
    if keep < raw_load(wrapping_add(s, 8)) {
        raw_store(wrapping_add(s, 8), keep);
    }
    return 0;
}
fn rt_popb(s: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    if n == 0 {
        rt_abort();
    }
    v := raw_byte(wrapping_add(raw_load(s), n - 1));
    raw_store(wrapping_add(s, 8), n - 1);
    return v;
}
// Compiler-owned map construction requests fresh Linux entropy, never clock-derived seeds.
fn rt_random_seed() -> u64 {
    ptr := rt_alloc(8);
    mut used = 0;
    while used < 8 {
        mut number = 318;
        if raw_target() != 0 { number = 278; }
        n := raw_syscall(number, ptr + used, 8 - used, 0);
        if n == 18446744073709551612 {
            // EINTR: retry without weakening the entropy source.
        } else {
            if (n == 0) + (8 - used < n) { rt_abort(); }
            used += n;
        }
    }
    seed := raw_load(ptr);
    rt_free(ptr);
    return seed;
}

// Unchecked accessors, used only where the compiler proved the index is in bounds.
fn rt_slotu(s: u64, i: u64) -> u64 {
    return wrapping_add(raw_load(s), wrapping_mul(i, 8));
}
// The address of byte i of a sequence or view (both start {ptr, len}), bounds-checked.
fn rt_slotb(s: u64, i: u64) -> u64 {
    if (i < raw_load(wrapping_add(s, 8))) == 0 {
        rt_fail(1, i, raw_load(wrapping_add(s, 8)));
