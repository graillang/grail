// are {next arena, mapped bytes}, and every block after the first is a multiple of the class size
// further on, so this one offset decides the alignment of every payload of the class, for good:
// no list, run or chain computes an address. A class of 1024 bytes or more - where a request of
// 512 bytes or more lands - starts at 48, which puts each payload (16 past its block) on a 64-byte
// boundary; that is a promise (docs/design/allocator.md). A smaller class starts right after the
// arena's words and its payloads are 16-byte aligned.
fn rt_arena_first(size: u64) -> u64 {
    if size < 1024 {
        return 16;
    }
    return 48;
}
// The arena of a block that has a mapping to itself (a class of 512 KiB or more), from its payload.
fn rt_own_arena(ptr: u64) -> u64 {
    return ptr - 16 - rt_arena_first(raw_load(ptr - 16));
}
// A fresh arena for one class: `bump` and `left` are the class's two shared words. Lock held.
fn rt_arena_new(bump: u64, left: u64, size: u64) -> u64 {
    state := raw_state();
    first := rt_arena_first(size);
    mut mapsize = 1048576;
    if mapsize < size + first {
        mapsize = size + first;
    }
    arena := raw_map(mapsize);
    if rt_error(arena) {
        rt_abort();
    }
    raw_store(arena, raw_load(state + 32));
    raw_store(arena + 8, mapsize);
    raw_store(state + 32, arena);
    raw_store(bump, arena + first);
    raw_store(left, rt_div(mapsize - first, size));
    return 0;
}
