        rt_pushb(acc, 117);
        rt_pushb(acc, 101);
    } else {
        rt_pushb(acc, 102);
        rt_pushb(acc, 97);
        rt_pushb(acc, 108);
        rt_pushb(acc, 115);
        rt_pushb(acc, 101);
    }
