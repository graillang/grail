// `stat(path, follow)` answers twelve numbers: the errno (0 on success, positive otherwise and the
// remaining eleven entries zero), then kind (0 other, 1 regular file, 2 directory, 3 symbolic link),
// size, mode (type and permission bits), modified seconds, modified nanoseconds, accessed seconds,
// accessed nanoseconds, owner uid, group gid, inode and device. Times are seconds since the Unix
// epoch as a word: a date before 1970 reads back through i64(). A platform without a field reports
// 0 for it (Windows has no POSIX mode, owner or inode).
fn f_host_stat(path: u64, follow: u64) -> u64 {
    out := rt_new();
    name := rt_cstr(path);
    rt_view_free(path); // a byte-view argument belongs to the host function, as in f_host_open
    mut code = 22;
    if name != 0 {
        code = rt_stat(name, follow, out);
        rt_free(name);
    }
    if code != 0 {
        // The platform pushed nothing: answer the errno and eleven zeroes.
        rt_push(out, code);
        mut i = 0;
        while i < 11 {
            rt_push(out, 0);
            i = i + 1;
        }
    }
    return out;
}
// rename(2) from one path to another; 0 or a positive errno. A destination file is replaced
// atomically and a destination directory must be empty, which is the kernel's rule, not a policy
// this layer adds.
fn f_host_rename(from: u64, to: u64) -> u64 {
    a := rt_cstr(from);
    b := rt_cstr(to);
