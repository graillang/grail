            }
            rt_pushb(acc, rt_atb(text, i));
            i += 1;
        }
    }
    rt_drop_seq(text);
    rt_free(q);
    return 0;
}
fn rt_print_acc(acc: u64, newline: u64) -> u64 {
    if newline {
        rt_pushb(acc, 10);
    }
    n := rt_len(acc);
    packed := rt_pack(acc);
    if rt_write_all(1, packed, n) != 0 {
        rt_abort();
    }
    rt_free(packed);
    rt_drop_seq(acc);
    return 0;
}

// Ends the whole process immediately with the given status (no cleanup runs).
fn f_host_exit(code: u64) -> u64 {
    rt_prof_dump();
    rt_syscall(231, code & 255, 0, 0);
    return 0;
}

// Formats a value word according to an element code (see element_code in the compiler).
fn rt_fmt_value(acc: u64, v: u64, code: u64) -> u64 {
    if code == 1 {
        return rt_fmt_num(acc, v);
    }
    if code == 2 {
        return rt_fmt_bool(acc, v);
    }
    if code == 3 {
        start := rt_len(acc);
        rt_fmt_f64(acc, v);
        mut plain = 1;
        mut i = start;
        n := rt_len(acc);
        while i < n {
            b := rt_atb(acc, i);
            if (b == 46) + (b == 101) + (b == 110) + (b == 78) {
                plain = 0;
            }
            i += 1;
        }
        if plain {
            rt_pushb(acc, 46);
            rt_pushb(acc, 48);
        }
        return 0;
    } // like Rust's {:?}: 2.0, not 2
    if code == 4 {
        rt_pushb(acc, 34);
        rt_fmt_seq(acc, v);
        rt_pushb(acc, 34);
        return 0;
    }
    if code == 6 {
        rt_pushb(acc, 39);
        rt_push_utf8(acc, v);
        rt_pushb(acc, 39);
        return 0;
    } // char, like {:?}
    if code == 7 {
        start := rt_len(acc);
        rt_fmt_f32(acc, v);
        mut plain = 1;
        mut i = start;
        n := rt_len(acc);
        while i < n {
            b := rt_atb(acc, i);
            if (b == 46) + (b == 101) + (b == 110) + (b == 78) {
                plain = 0;
            }
            i += 1;
        }
        if plain {
            rt_pushb(acc, 46);
            rt_pushb(acc, 48);
        }
        return 0;
    }
    if (code & 4095) == 5 {
        inner := rt_div(code, 4096);
        n := rt_len(v);
        rt_pushb(acc, 91);
        mut i = 0;
        while i < n {
            if i != 0 {
                rt_pushb(acc, 44);
                rt_pushb(acc, 32);
            }
            rt_fmt_value(acc, rt_at(v, i), inner);
            i += 1;
        }
        rt_pushb(acc, 93);
        return 0;
    }
    if (code & 4095) == 8 {
        inner := rt_div(code, 4096);
        n := rt_len(v);
        rt_pushb(acc, 91);
        mut i = 0;
        while i < n {
            if i != 0 {
                rt_pushb(acc, 44);
                rt_pushb(acc, 32);
            }
            rt_fmt_value(acc, rt_narrow_decode(rt_at4(v, i), inner), inner);
            i += 1;
        }
        rt_pushb(acc, 93);
        return 0;
    }
    if 1023 < code {
        return rt_fmt_int(acc, v, code - 1024);
    }
    rt_abort();
    return 0;
}

// Removes a file (directory==0) or an empty directory; 0 or a positive errno.
fn f_host_remove(path: u64, directory: u64) -> u64 {
    name := rt_cstr(path);
    rt_view_free(path);
