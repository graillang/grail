// Resizes an allocation to hold at least `need` bytes, keeping the first `used`. A block in its own
// arena (>= 512 KiB) grows in place with mremap, without copying or touching its pages.
fn rt_grow(ptr: u64, used: u64, need: u64) -> u64 {
