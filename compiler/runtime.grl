// How many allocations are live: the shared count plus every thread cache's own. The walk holds the
// lock, so no cache joins or leaves the registry under it and the total is never torn; the counts
// of threads that are allocating at this moment are read as they pass, so the answer is exact when
// the other threads are idle or gone (the end of main, after every join) and approximate otherwise.
fn rt_live() -> u64 {
    state := raw_state();
    rt_allocator_lock();
    mut n = raw_load(state + 24);
    mut c = raw_load(state + 40);
    while c != 0 {
        n = wrapping_add(n, raw_load(c + 8));
        c = raw_load(c);
    }
    rt_allocator_unlock();
    return n;
}
// The end-of-main leak check (`compiler/native.grl`, the epilogue). A balanced program has nothing
// live and returns; a leak aborts the process with status 134, as it always has. The one exception
// is a contained task failure: the owners of a discarded stack cannot be counted (there is no
// per-frame slot map, and building one is the unwind data B5 refuses to emit), so the check reports
// the number it sees on fd 2 and lets the program exit normally. It never reports nothing: an
// unexplained balance is either aborted on or printed.
fn rt_leak_exit() -> u64 {
    live := rt_live();
    if live == 0 {
        return 0;
    }
    failures := rt_contained();
    if failures == 0 {
        rt_abort();
    }
    s := rt_new();
    rt_reserveb(s, 220);
    buf := raw_load(s);
    mut n = rt_fail_put(buf, 0, "note: ");
    n = rt_fail_num(buf, n, live);
    n = rt_fail_put(buf, n, " allocation(s) still live after ");
    n = rt_fail_num(buf, n, failures);
    n = rt_fail_put(buf, n, " contained task failure(s)");
    extra := raw_load(rt_discarded_word());
    if extra != 0 {
        n = rt_fail_put(buf, n, " (");
        n = rt_fail_num(buf, n, failures + extra);
        n = rt_fail_put(buf, n, " stacks discarded)");
    }
    n = rt_fail_put(buf, n, "; the owners of a discarded stack are not released\n");
    raw_store(s + 8, n);
    rt_write_text(2, s);
    return 0;
}
fn rt_shutdown() -> u64 {
    rt_sched_stats();
    rt_prof_dump();
    state := raw_state();
    mut arena = raw_load(state + 32);
    while arena != 0 {
        next := raw_load(arena);
        size := raw_load(arena + 8);
        rt_syscall(11, arena, size, 0);
        arena = next;
    }
    raw_store(state + 32, 0);
    return 0;
}
fn rt_new() -> u64 {
    return rt_alloc(24);
}
fn rt_push(s: u64, v: u64) -> u64 {
