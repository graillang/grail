    r := rt_big(f);
    s := rt_big(1);
    mp := rt_big(1);
    mm := rt_big(1);
    if eneg == 0 {
        rt_big_shift(r, e);
        rt_big_shift(mp, e);
        rt_big_shift(mm, e);
    } else {
        rt_big_shift(s, e);
    }
    rt_big_mul(r, 2);
    rt_big_mul(s, 2);
    if boundary {
        rt_big_mul(r, 2);
        rt_big_mul(s, 2);
        rt_big_mul(mp, 2);
    }
    t := rt_big(0);
    mut k = 0;
    mut kneg = 0;
    // Scale so that the first digit is generated right after the decimal point.
    while true {
        rt_big_add(t, r, mp);
        c := rt_big_cmp(t, s);
        if (c == 2) + ((c == 1) & even) {
            rt_big_mul(s, 10);
            if kneg {
                if k == 1 {
                    kneg = 0;
                }
                k -= 1;
            } else {
                k += 1;
            }
        } else {
            break;
        }
    }
    while true {
        rt_big_add(t, r, mp);
        rt_big_mul(t, 10);
        c := rt_big_cmp(t, s);
        if (c == 0) + ((c == 1) & (even == 0)) {
            rt_big_mul(r, 10);
            rt_big_mul(mp, 10);
            rt_big_mul(mm, 10);
            if kneg {
                k += 1;
            } else {
                if k == 0 {
                    kneg = 1;
                    k = 1;
                } else {
                    k -= 1;
                }
            }
        } else {
            break;
        }
    }
    digits := rt_new();
    while true {
        rt_big_mul(r, 10);
        rt_big_mul(mp, 10);
        rt_big_mul(mm, 10);
        mut d = 0;
        while rt_big_cmp(r, s) != 0 {
            rt_big_sub(r, s);
            d += 1;
        }
        lc := rt_big_cmp(r, mm);
        low := (lc == 0) + ((lc == 1) & even);
        rt_big_add(t, r, mp);
        hc := rt_big_cmp(t, s);
