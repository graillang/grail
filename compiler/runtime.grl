    if 9223372036854775807 < v {
        rt_pushb(acc, 45);
    }
    exponent := rt_div(v, 4503599627370496) & 2047;
    fraction := v & 4503599627370495;
    if exponent == 2047 {
        return rt_push_text(acc, 105, 110, 102);
    }
    mut f = fraction;
    mut e = 0;
    mut eneg = 0;
    if exponent == 0 {
        e = 1074;
        eneg = 1;
    } else {
        f = fraction + 4503599627370496;
        if exponent < 1075 {
            e = 1075 - exponent;
            eneg = 1;
        } else {
            e = exponent - 1075;
        }
    }
    q := rt_big(f);
    mut i = 0;
    while i < digits {
        rt_big_mul(q, 10);
        i += 1;
    }
    if eneg == 0 {
        rt_big_shift(q, e);
    } else {
        mut last = 0;
        mut sticky = 0;
        i = 0;
        while i < e {
            if last {
                sticky = 1;
            }
            last = rt_big_half(q);
            i += 1;
        }
