    mut size = 32;
    mut bin = 0;
    while bin < 14 {
        slot := c + 64 + bin * 48;
        if raw_load(slot) != 0 {
            rt_chain_give(raw_load(slot), raw_load(slot + 8), bin);
        }
        size = size * 2;
        bin = bin + 1;
    }
    rt_allocator_lock();
    size = 32;
    bin = 0;
    while bin < 14 {
        slot := c + 64 + bin * 48;
        head := state + 256 + bin * 8;
