        ptr = rt_grow(old, n, capacity);
    }
    raw_store(s, ptr);
    raw_store(wrapping_add(s, 16), capacity);
    return 0;
}
// Copies n bytes, a word at a time while possible.
fn rt_copy_bytes(dst: u64, src: u64, n: u64) -> u64 {
