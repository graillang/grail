            rt_arena_new(bump, left, size);
        }
        block = raw_load(bump);
        raw_store(bump, block + size);
        raw_store(left, raw_load(left) - 1);
        raw_store(block, size);
    }
    raw_store(block + 8, 1);
    ptr := block + 16;
