    return 0;
}
fn rt_print_acc(acc: u64, newline: u64) -> u64 {
    if newline {
        rt_pushb(acc, 10);
    }
    n := rt_len(acc);
    packed := rt_pack(acc);
    if rt_write_all(1, packed, n) != 0 {
        rt_abort();
    }
    rt_free(packed);
    rt_drop_seq(acc);
    return 0;
}

// Ends the whole process immediately with the given status (no cleanup runs).
fn f_host_exit(code: u64) -> u64 {
    rt_prof_dump();
    rt_syscall_low(231, code & 255, 0, 0);
    return 0;
}

// Formats a value word according to an element code (see element_code in the compiler).
fn rt_fmt_value(acc: u64, v: u64, code: u64) -> u64 {
    if code == 1 {
        return rt_fmt_num(acc, v);
    }
    if code == 2 {
        return rt_fmt_bool(acc, v);
    }
    if code == 3 {
        start := rt_len(acc);
        rt_fmt_f64(acc, v);
        mut plain = 1;
        mut i = start;
        n := rt_len(acc);
        while i < n {
            b := rt_atb(acc, i);
            if (b == 46) + (b == 101) + (b == 110) + (b == 78) {
                plain = 0;
            }
            i += 1;
        }
        if plain {
            rt_pushb(acc, 46);
            rt_pushb(acc, 48);
        }
        return 0;
    } // like Rust's {:?}: 2.0, not 2
    if code == 4 {
        rt_pushb(acc, 34);
        rt_fmt_seq(acc, v);
        rt_pushb(acc, 34);
        return 0;
    }
    if code == 6 {
        rt_pushb(acc, 39);
        rt_push_utf8(acc, v);
        rt_pushb(acc, 39);
        return 0;
    } // char, like {:?}
    if code == 7 {
        start := rt_len(acc);
        rt_fmt_f32(acc, v);
        mut plain = 1;
        mut i = start;
        n := rt_len(acc);
        while i < n {
            b := rt_atb(acc, i);
            if (b == 46) + (b == 101) + (b == 110) + (b == 78) {
                plain = 0;
            }
            i += 1;
        }
        if plain {
            rt_pushb(acc, 46);
            rt_pushb(acc, 48);
        }
        return 0;
    }
    if (code & 4095) == 5 {
        inner := rt_div(code, 4096);
        n := rt_len(v);
        rt_pushb(acc, 91);
        mut i = 0;
        while i < n {
            if i != 0 {
                rt_pushb(acc, 44);
                rt_pushb(acc, 32);
            }
            rt_fmt_value(acc, rt_at(v, i), inner);
            i += 1;
        }
        rt_pushb(acc, 93);
        return 0;
    }
    if (code & 4095) == 9 {
        // A vector of views: element i is the {pointer, length} pair at data + 16 * i.
        inner := rt_div(code, 4096);
        n := rt_len(v);
        rt_pushb(acc, 91);
        mut i = 0;
        while i < n {
            if i != 0 {
                rt_pushb(acc, 44);
                rt_pushb(acc, 32);
            }
            rt_fmt_value(acc, wrapping_add(raw_load(v), wrapping_mul(i, 16)), inner);
            i += 1;
        }
        rt_pushb(acc, 93);
        return 0;
    }
    if (code & 4095) == 8 {
        inner := rt_div(code, 4096);
        n := rt_len(v);
        rt_pushb(acc, 91);
        mut i = 0;
        while i < n {
            if i != 0 {
                rt_pushb(acc, 44);
                rt_pushb(acc, 32);
            }
            rt_fmt_value(acc, rt_narrow_decode(rt_at4(v, i), inner), inner);
            i += 1;
        }
        rt_pushb(acc, 93);
        return 0;
    }
    if 1023 < code {
        return rt_fmt_int(acc, v, code - 1024);
    }
    rt_abort();
    return 0;
}

// Removes a file (directory==0) or an empty directory; 0 or a positive errno.
fn f_host_remove(path: u64, directory: u64) -> u64 {
    name := rt_cstr(path);
    rt_view_free(path);
    if name == 0 {
        return 22;
    }
    mut flags = 0;
    if directory {
        flags = 512;
    }
    r := rt_syscall(263, wrapping_sub(0, 100), name, flags);
    rt_free(name);
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
}
// Creates a directory; 0 or a positive errno (17 when it already exists).
fn f_host_create_dir(path: u64) -> u64 {
    name := rt_cstr(path);
    rt_view_free(path);
    if name == 0 {
        return 22;
    }
    r := rt_syscall(258, wrapping_sub(0, 100), name, 493);
    rt_free(name);
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
}

// `stat(path, follow)` answers twelve numbers: the errno (0 on success, positive otherwise and the
// remaining eleven entries zero), then kind (0 other, 1 regular file, 2 directory, 3 symbolic link),
// size, mode (type and permission bits), modified seconds, modified nanoseconds, accessed seconds,
// accessed nanoseconds, owner uid, group gid, inode and device. Times are seconds since the Unix
// epoch as a word: a date before 1970 reads back through i64(). A platform without a field reports
// 0 for it (Windows has no POSIX mode, owner or inode).
fn f_host_stat(path: u64, follow: u64) -> u64 {
    out := rt_new();
    name := rt_cstr(path);
    rt_view_free(path); // a byte-view argument belongs to the host function, as in f_host_open
    mut code = 22;
    if name != 0 {
        code = rt_stat(name, follow, out);
        rt_free(name);
    }
    if code != 0 {
        // The platform pushed nothing: answer the errno and eleven zeroes.
        rt_push(out, code);
        mut i = 0;
        while i < 11 {
            rt_push(out, 0);
            i = i + 1;
        }
    }
    return out;
}
// rename(2) from one path to another; 0 or a positive errno. A destination file is replaced
// atomically and a destination directory must be empty, which is the kernel's rule, not a policy
// this layer adds.
fn f_host_rename(from: u64, to: u64) -> u64 {
    a := rt_cstr(from);
    b := rt_cstr(to);
    rt_view_free(from);
    rt_view_free(to);
    mut code = 22;
    if (a != 0) & (b != 0) {
        code = rt_rename(a, b);
    }
    if a != 0 {
        rt_free(a);
    }
    if b != 0 {
        rt_free(b);
    }
    return code;
}
