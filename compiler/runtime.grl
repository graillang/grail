    v := raw_load(wrapping_add(raw_load(s), wrapping_mul(n - 1, 8)));
    raw_store(wrapping_add(raw_load(s), wrapping_mul(n - 1, 8)), 0);
    raw_store(wrapping_add(s, 8), n - 1);
