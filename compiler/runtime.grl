    rt_reserveb(s, n);
    mut i: u64 = 0;
    while i < n {
        raw_putbyte(wrapping_add(raw_load(s), i), v);
        i = i + 1;
    }
    raw_store(wrapping_add(s, 8), n);
    return 0;
}
fn rt_pushb(s: u64, v: u64) -> u64 {
