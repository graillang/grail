// ---- views -------------------------------------------------------------------------------------
// A view is two words, {pointer, length}: the first two words of a vector's header, which is why a
// view of a whole vector needs no record of its own - it is the header (rt_view). A view of part of
// one does need a record, and the two must be told apart when a view is dropped, because a record is
// freed and a header is its owner's. The address says which: every block the allocator hands out,
// and every static object the compiler emits, starts at a multiple of 16, and a view record is the
// second word onward of a 32-byte block, so its address is 8 more than a multiple of 16. Nothing is
// read to decide, so a view may be dropped after the vector it was taken from.
// The `_into` forms write the view's {pointer, length} pair into `dst`, two words the caller holds
// (a frame pair: docs/design/unboxed-values.md, views as two words), and answer `dst`.
fn rt_slice_into(s: u64, a: u64, b: u64, dst: u64) -> u64 {
    if (b < a) + (raw_load(wrapping_add(s, 8)) < b) {
        rt_fail(7, a, b);
    }
    raw_store(dst, wrapping_add(raw_load(s), a));
    raw_store(dst + 8, b - a);
    return dst;
}
fn rt_vslice_into(s: u64, a: u64, b: u64, width: u64, dst: u64) -> u64 {
    if (b < a) + (raw_load(wrapping_add(s, 8)) < b) {
        rt_fail(7, a, b);
    }
    raw_store(dst, wrapping_add(raw_load(s), wrapping_mul(a, width)));
    raw_store(dst + 8, b - a);
    return dst;
}
fn rt_aslice_into(base: u64, a: u64, b: u64, w: u64, n: u64, dst: u64) -> u64 {
    if (b < a) + (n < b) {
        rt_fail(7, a, b);
    }
    raw_store(dst, wrapping_add(base, wrapping_mul(a, w)));
    raw_store(dst + 8, b - a);
    return dst;
