// negative errno. A capture uses it to read two pipes without waiting on one while the child fills
// the other, which is the one blocking order that can deadlock.
fn f_host_ready(fd: u64, timeout_ms: u64) -> u64 {
    return rt_ready(fd, timeout_ms);
}
