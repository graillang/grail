            break;
        }
    }
    digits := rt_new();
    while true {
        rt_big_mul(r, 10);
        rt_big_mul(mp, 10);
        rt_big_mul(mm, 10);
        mut d = 0;
        while rt_big_cmp(r, s) != 0 {
            rt_big_sub(r, s);
            d += 1;
