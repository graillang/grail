    mut i = 0;
    while i < made {
        rt_free(raw_load(argv + i * 8));
        i = i + 1;
    }
    rt_free(argv);
    i = 0;
    while i < n {
        rt_drop_seq(rt_at(args, i));
        i = i + 1;
    }
    rt_drop_seq(args);
    i = 0;
    while i < envc {
        rt_drop_seq(rt_at(env, i));
        i = i + 1;
    }
    if env != 0 {
        rt_drop_seq(env);
    }
