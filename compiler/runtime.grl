    if j != 0 {
        return rt_job_fail(j, 13, 0, 0, rt_site_here(j + 200) & 18446744073709551614, msg, 0);
    }
    t := rt_containable();
    if t != 0 {
        return rt_contain_site(t, 13, 0, 0, rt_site_here(t + 200), msg);
    }
    if rt_abort_begin() == 0 {
        rt_abort_park();
    }
    return rt_report_die(msg, rt_fail_site_full());
