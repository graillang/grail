    raw_store(t + 192, 0);
    if msg != 0 {
        return msg;
    }
    return rt_fail_body_text(raw_load(t + 160), raw_load(t + 168), raw_load(t + 176));
}
fn rt_task_site(t: u64) -> u64 {
