        if (ts == 0) & (negative != 0) {
            return rt_fail(3, 0, 0);
        }
        if negative != 0 {
            return rt_fail(15, wrapping_sub(0, v), to);
        }
        return rt_fail(14, v, to);
    }
    return v;
}
fn rt_print_int(v: u64, newline: u64, code: u64) -> u64 {
    signed := (code / 256) & 1;
