            continue;
        }
        if low & (high == 0) {
            rt_push(digits, d);
            break;
        }
        if high & (low == 0) {
            rt_push(digits, d + 1);
            break;
        }
        rt_big_add(t, r, r);
        if rt_big_cmp(t, s) == 0 {
            rt_push(digits, d);
