    // proved of a drop. (The attribute is not spelled here: the build driver takes its text
    // anywhere in a source file, this one included, as a claim and compiles the program in one run.)
    mut moved = raw_load(slot + 8) / 2;
    if moved == 0 {
        moved = 1;
    }
    first := raw_load(slot);
    mut last = first;
    mut i = 1;
    while i < moved {
        last = raw_load(last + 8);
        i = i + 1;
    }
    raw_store(slot, raw_load(last + 8));
    raw_store(slot + 8, raw_load(slot + 8) - moved);
    raw_store(last + 8, 0);
    rt_chain_give(first, moved, bin);
    return 0;
}
// Blocks leave a cache as a chain: a list linked through the state words and ending in 0, whose
// first block also carries, in its two payload words, the next chain of the class (state words
// 1792 + bin * 8) and the chain's length. A refill takes one whole, so the lock is held for a few
// stores however many blocks move. The smallest class has exactly those two payload words.
fn rt_chain_give(first: u64, count: u64, bin: u64) -> u64 {
    chains := raw_state() + 1792 + bin * 8;
    raw_store(first + 24, count);
    rt_allocator_lock();
    raw_store(first + 16, raw_load(chains));
    raw_store(chains, first);
    rt_allocator_unlock();
