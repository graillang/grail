// which the caller tells apart by the length it read first (rt_pop_option).
fn rt_pop_quiet(s: u64) -> u64 {
    if raw_load(wrapping_add(s, 8)) == 0 {
        return 0;
    }
    return rt_pop(s);
}
fn rt_popb_quiet(s: u64) -> u64 {
    if raw_load(wrapping_add(s, 8)) == 0 {
        return 0;
    }
    return rt_popb(s);
}
fn rt_pop4_quiet(s: u64) -> u64 {
    if raw_load(wrapping_add(s, 8)) == 0 {
        return 0;
    }
    return rt_pop4(s);
}
// `Some(element)` when the collection had an element before the pop, `None` otherwise.
fn rt_pop_option(had: u64, element: u64, some: u64, none: u64) -> u64 {
    if had == 0 {
        return rt_enum(none, 0);
    }
    return rt_enum(some, element);
}
fn rt_len(s: u64) -> u64 {
    return raw_load(wrapping_add(s, 8));
}
fn rt_slot(s: u64, i: u64) -> u64 {
    if (i < raw_load(wrapping_add(s, 8))) == 0 {
        rt_fail(1, i, raw_load(wrapping_add(s, 8)));
