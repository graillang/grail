    }
    rt_fmt_place(acc, digits, k, kneg);
    rt_drop_seq(digits);
    rt_free(r);
    rt_free(s);
    rt_free(mp);
    rt_free(mm);
    rt_free(t);
    return 0;
}
fn rt_print_f64(v: u64, newline: u64) -> u64 {
    acc := rt_new();
    rt_fmt_f64(acc, v);
    if newline {
        rt_pushb(acc, 10);
    }
    n := rt_len(acc);
    packed := rt_pack(acc);
    if rt_write_all(1, packed, n) != 0 {
        rt_abort();
    }
    rt_free(packed);
    rt_drop_seq(acc);
    return 0;
}

// ---- f32: binary32 values carried as the binary64 with the same value ----
// Round to the nearest binary32 (ties to even; overflow gives infinity). Arithmetic computes in
// binary64 and rounds once: for + - * / and sqrt that equals the correctly rounded binary32.
fn rt_f32_round(v: u64) -> u64 {
    sign := v & 9223372036854775808;
    e := rt_div(v, 4503599627370496) & 2047;
    if e == 2047 {
        return v;
    }
    if e == 0 {
        return sign;
    }
    m := (v & 4503599627370495) + 4503599627370496; // value = m * 2^(e-1075)
    mut shift = 29;
    if e < 897 {
        shift = 926 - e;
    } // keep 24 bits, fewer below 2^-126
    if 53 < shift {
        return sign;
    }
    q0 := m >> shift;
    rem := m - (q0 << shift);
    half := 1 << (shift - 1);
    mut q = q0;
    if (half < rem) + ((rem == half) & ((q0 & 1) == 1)) {
        q += 1;
    }
    if q == 0 {
        return sign;
    }
    mut top = 0;
    while (1 << (top + 1)) < q + 1 {
        top += 1;
    }
    biased := e - 52 + shift + top; // value = q * 2^(e-1075+shift)
    if 1150 < biased {
        return sign + 9218868437227405312;
    }
    return sign + biased * 4503599627370496 + ((q << (52 - top)) - 4503599627370496);
}
fn rt_f32_from_int(v: u64, code: u64) -> u64 {
