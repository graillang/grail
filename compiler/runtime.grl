fn f_host_print(data: u64) -> u64 {
    packed := rt_pack(data);
    err := rt_write_all(1, packed, rt_len(data));
    rt_free(packed);
    rt_free(data);
    if err != 0 {
        rt_abort();
    }
    return 0;
}
// Print the numeric entry result without libc, allocation escape or unchecked formatting.
fn rt_pow(base: u64, exponent: u64) -> u64 {
    mut factor = base;
    mut power = exponent;
    mut result = 1;
    while power != 0 {
        if power % 2 {
            result = result * factor;
        }
        power = rt_div(power, 2);
        if power != 0 {
            factor = factor * factor;
        }
    }
    return result;
}
fn rt_wrapping_pow(base: u64, exponent: u64) -> u64 {
    mut factor = base;
    mut power = exponent;
    mut result = 1;
    while power != 0 {
        if power % 2 {
            result = wrapping_mul(result, factor);
        }
        power = rt_div(power, 2);
        if power != 0 {
            factor = wrapping_mul(factor, factor);
        }
    }
    return result;
}
fn rt_print_number(n: u64, newline: u64) -> u64 {
    buf := rt_alloc(32);
    mut pos = 31;
    mut remaining = n;
    if newline {
        pos = 30;
        raw_putbyte(buf + 31, 10);
    }
    while 1 {
        raw_putbyte(buf + pos, 48 + remaining % 10);
        remaining = rt_div(remaining, 10);
        if remaining == 0 {
            break;
        }
        pos = pos - 1;
    }
    err := rt_write_all(1, buf + pos, 32 - pos);
    rt_free(buf);
    if err != 0 {
        rt_abort();
    }
    return 0;
}
fn rt_print_num(n: u64) -> u64 {
    return rt_print_number(n, 1);
}
fn rt_print_newline() -> u64 {
    buf := rt_alloc(1);
    raw_putbyte(buf, 10);
    err := rt_write_all(1, buf, 1);
    rt_free(buf);
    if err != 0 {
        rt_abort();
    }
    return 0;
}
fn f_host_print_num(n: u64) -> u64 {
    return rt_print_number(n, 0);
}
fn f_host_newline() -> u64 {
    return rt_print_newline();
}
// Build all executable names in the parent. A fork child must never acquire an
// allocator lock inherited while another worker owned it.
fn rt_exec_paths(file: u64) -> u64 {
    paths := rt_new();
    rt_push(paths, file);
    env := raw_load(raw_state() + 16);
    mut i = 0;
    mut slash = 0;
    while raw_byte(file + i) != 0 {
        if raw_byte(file + i) == 47 {
            slash = 1;
        }
        i = i + 1;
    }
    if slash {
        return paths;
    }
    // Search PATH (including empty entries as the current directory).
    mut ep = env;
    mut path = 0;
    while raw_load(ep) != 0 {
        p := raw_load(ep);
        if raw_byte(p) == 80 {
            if raw_byte(p + 1) == 65 {
                if raw_byte(p + 2) == 84 {
                    if raw_byte(p + 3) == 72 {
                        if raw_byte(p + 4) == 61 {
                            path = p + 5;
                            break;
                        }
                    }
                }
            }
        }
        ep = ep + 8;
    }
    mut fallback = 0;
    if path == 0 {
        fallback = rt_alloc(14);
        // /bin:/usr/bin
        raw_putbyte(fallback, 47);
        raw_putbyte(fallback + 1, 98);
        raw_putbyte(fallback + 2, 105);
        raw_putbyte(fallback + 3, 110);
        raw_putbyte(fallback + 4, 58);
        raw_putbyte(fallback + 5, 47);
        raw_putbyte(fallback + 6, 117);
        raw_putbyte(fallback + 7, 115);
        raw_putbyte(fallback + 8, 114);
        raw_putbyte(fallback + 9, 47);
        raw_putbyte(fallback + 10, 98);
        raw_putbyte(fallback + 11, 105);
        raw_putbyte(fallback + 12, 110);
        path = fallback;
    }
    mut start = 0;
    while 1 {
        mut end = start;
        while raw_byte(path + end) != 0 {
            if raw_byte(path + end) == 58 {
                break;
            }
            end = end + 1;
        }
        len := end - start;
        candidate := rt_alloc(len + i + 2);
        mut j = 0;
        while j < len {
            raw_putbyte(candidate + j, raw_byte(path + start + j));
            j = j + 1;
        }
        if len != 0 {
            raw_putbyte(candidate + j, 47);
            j = j + 1;
        }
        mut k = 0;
        while k < i {
            raw_putbyte(candidate + j + k, raw_byte(file + k));
            k = k + 1;
        }
        rt_push(paths, candidate);
        if raw_byte(path + end) == 0 {
            break;
        }
        start = end + 1;
    }
    rt_free(fallback);
    return paths;
}
// No allocations, frees, runtime locks or cleanup in the post-fork child.
fn rt_exec(paths: u64, argv: u64) -> u64 {
    env := raw_load(raw_state() + 16);
    n := rt_len(paths);
    mut i = 0;
    while i < n {
        rt_syscall(59, rt_at(paths, i), argv, env);
        i += 1;
    }
    return 0;
}
fn rt_drop_exec_paths(paths: u64) -> u64 {
    n := rt_len(paths);
    mut i = 1;
    while i < n {
        rt_free(rt_at(paths, i));
        i += 1;
    }
    rt_drop_seq(paths);
    return 0;
}
fn f_host_command(args: u64) -> u64 {
    return rt_blocking_call(rt_command_blocking, args, 0);
}
fn rt_command_blocking(args: u64) -> u64 {
    n := rt_len(args);
    mut result = 278;
    mut made = 0;
    argv := rt_alloc((n + 1) * 8);
    if n != 0 {
        while made < n {
            p := rt_cstr(rt_at(args, made));
            if p == 0 {
                break;
            }
            raw_store(argv + made * 8, p);
            made = made + 1;
        }
        if made == n {
            paths := rt_exec_paths(raw_load(argv));
            child := rt_syscall(57, 0, 0, 0);
            if child == 0 {
                rt_exec(paths, argv);
                rt_syscall(60, 127, 0, 0);
            }
            if rt_error(child) {
                result = 256 + wrapping_sub(0, child);
            } else {
                status := rt_alloc(8);
                mut waited = 0;
                while 1 {
                    waited = rt_syscall(61, child, status, 0);
                    if waited != wrapping_sub(0, 4) {
                        break;
                    }
                }
                if rt_error(waited) {
                    result = 256 + wrapping_sub(0, waited);
                } else {
                    code := raw_load(status);
                    sig := code & 127;
                    if sig != 0 {
                        result = 128 + sig;
                    } else {
                        result = rt_div(code, 256) & 255;
                    }
                }
                rt_free(status);
            }
            rt_drop_exec_paths(paths);
        }
    }
    mut i = 0;
    while i < made {
        rt_free(raw_load(argv + i * 8));
        i = i + 1;
    }
    rt_free(argv);
    i = 0;
    while i < n {
        rt_drop_seq(rt_at(args, i));
        i = i + 1;
    }
    rt_drop_seq(args);
    return result;
}
// Text is UTF-8 even when its source is binary I/O or a byte view.
fn rt_utf8(s: u64) -> u64 {
    n := rt_len(s);
    mut i = 0;
    while i < n {
        b := rt_atb(s, i);
        mut count = 0;
        if b < 128 {
            i = i + 1;
            continue;
        }
        if (193 < b) & (b < 224) {
            count = 2;
        }
        if (223 < b) & (b < 240) {
            count = 3;
        }
        if (239 < b) & (b < 245) {
            count = 4;
        }
        if (count == 0) + (n < i + count) {
            rt_abort();
        }
        second := rt_atb(s, i + 1);
        if (second < 128) + (191 < second) {
            rt_abort();
        }
        if (b == 224) & (second < 160) {
            rt_abort();
        }
        if (b == 237) & (159 < second) {
            rt_abort();
        }
        if (b == 240) & (second < 144) {
            rt_abort();
        }
        if (b == 244) & (143 < second) {
            rt_abort();
        }
        mut j = 2;
        while j < count {
            next := rt_atb(s, i + j);
            if (next < 128) + (191 < next) {
                rt_abort();
            }
            j = j + 1;
        }
        i = i + count;
    }
    return 0;
}
fn rt_text(s: u64) -> u64 {
    rt_utf8(s);
    return rt_copy(s);
}
fn rt_string_lit(ptr: u64, n: u64) -> u64 {
    s := rt_lit(ptr, n);
    rt_utf8(s);
    return s;
}
fn rt_append_text(dst: u64, src: u64) -> u64 {
    rt_utf8(src);
    return rt_append(dst, src);
}

// Opaque atomic words. Public safe types never expose these numeric addresses.
fn rt_atomic_new(value: u64) -> u64 {
    p := rt_alloc(8);
    raw_atomic_store(p, value);
    return p;
}
fn rt_atomic_load(p: u64) -> u64 {
    return raw_atomic_load(p);
}
fn rt_atomic_load_relaxed(p: u64) -> u64 {
    return raw_atomic_load_relaxed(p);
}
fn rt_atomic_load_acquire(p: u64) -> u64 {
    return raw_atomic_load_acquire(p);
}
fn rt_atomic_store(p: u64, value: u64) -> u64 {
    raw_atomic_store(p, value);
    return 0;
}
fn rt_atomic_store_relaxed(p: u64, value: u64) -> u64 {
    raw_atomic_store_relaxed(p, value);
    return 0;
}
fn rt_atomic_store_release(p: u64, value: u64) -> u64 {
    raw_atomic_store_release(p, value);
    return 0;
}
fn rt_atomic_compare_exchange(p: u64, expected: u64, value: u64) -> u64 {
    return raw_atomic_cas(p, expected, value);
}
fn rt_atomic_fetch_add(p: u64, value: u64) -> u64 {
    mut old = raw_atomic_load(p);
    while true {
        next := wrapping_add(old, value);
        observed := raw_atomic_cas(p, old, next);
        if observed == old {
            return old;
        }
        old = observed;
    }
    return 0;
}
fn rt_atomic_fetch_sub(p: u64, value: u64) -> u64 {
    mut old = raw_atomic_load(p);
    while true {
        next := wrapping_sub(old, value);
        observed := raw_atomic_cas(p, old, next);
        if observed == old {
            return old;
        }
        old = observed;
    }
    return 0;
}
fn rt_atomic_swap(p: u64, value: u64) -> u64 {
    mut old = raw_atomic_load(p);
    while true {
        observed := raw_atomic_cas(p, old, value);
        if observed == old {
            return old;
        }
        old = observed;
    }
    return 0;
}

// Mutex word: 0 unlocked, 1 locked, 2 locked with possible waiters (Drepper's futex mutex).
// Waiting sleeps in the kernel; no busy spinning. Payload word follows at offset 8.
fn rt_mutex_new(value: u64) -> u64 {
    p := rt_alloc(16);
    raw_atomic_store(p, 0);
    raw_store(p + 8, value);
    return p;
}
fn rt_mutex_unlock(p: u64) -> u64 {
    if rt_atomic_fetch_sub(p, 1) != 1 {
        raw_atomic_store(p, 0);
        rt_syscall(202, p, 129, 1);
    }
    return 0;
}

// ---- worker threads (structured fork-join only; see docs/design/structured-parallelism.md) ----
fn rt_cpus() -> u64 {
    buf := rt_alloc(128);
    r := rt_syscall(204, 0, 128, buf);
    mut n = 0;
    if rt_error(r) == 0 {
        mut i = 0;
        while i < 128 {
            mut b = raw_byte(buf + i);
            while b != 0 {
                n += b & 1;
                b = b / 2;
            }
            i += 1;
        }
    }
    rt_free(buf);
    if n == 0 {
        n = 1;
    }
    return n;
}
// Thread handle words: 0 kernel TID (cleared + futex-woken on exit), 1 stack base, 2 stack size.
fn rt_thread_spawn(entry: u64, arg: u64) -> u64 {
    size := 1048576;
    stack := raw_map(size);
    if rt_error(stack) {
        rt_abort();
    }
    if rt_error(rt_syscall(10, stack, 4096, 0)) {
        rt_abort();
    } // guard page below the stack
    handle := rt_alloc(24);
    raw_store(handle + 8, stack);
    raw_store(handle + 16, size);
    // Top 64 bytes: this thread's worker record {self, scheduler sp, current task, entry, arg}.
    top := stack + size;
    record := top - 64;
    raw_store(record + 24, entry);
    raw_store(record + 32, arg);
    raw_store(top - 80, rt_thread_main);
    raw_store(top - 72, record);
    // VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|PARENT_SETTID|CHILD_CLEARTID
    tid := raw_thread_clone(3477248, top - 80, handle);
    if rt_error(tid) {
        rt_abort();
    }
    return handle;
}
// Persistent runtime threads (workers, reactor): no counted handle; the kernel TID word lives in
// the thread's own stack-top record and is never joined.
fn rt_thread_spawn_detached(entry: u64, arg: u64) -> u64 {
    size := 1048576;
    stack := raw_map(size);
    if rt_error(stack) {
        rt_abort();
    }
    if rt_error(rt_syscall(10, stack, 4096, 0)) {
        rt_abort();
    }
    top := stack + size;
    record := top - 64;
    raw_store(record + 24, entry);
    raw_store(record + 32, arg);
    raw_store(top - 80, rt_thread_main);
    raw_store(top - 72, record);
    tid := raw_thread_clone(3477248, top - 80, record + 40);
    if rt_error(tid) {
        rt_abort();
    }
    return 0;
}
fn rt_thread_main(record: u64) -> u64 {
    raw_store(record, record);
    raw_tp_set(record);
    raw_call2(raw_load(record + 24), raw_load(record + 32), 0);
    return 0;
}
fn rt_thread_join(handle: u64) -> u64 {
    while true {
        tid := raw_atomic_load(handle);
        if tid == 0 {
            break;
        }
        rt_syscall(202, handle, 0, tid);
    }
    if rt_error(rt_syscall(11, raw_load(handle + 8), raw_load(handle + 16), 0)) {
        rt_abort();
    }
    rt_free(handle);
    return 0;
}
// ---- job pool: bounded, work-stealing, one owned result per job -------------------------------
// The process has one pool, created by the first parallel call and never destroyed: its workers are
// the runtime's own persistent OS threads (rt_thread_spawn_detached, the same primitive the green
// scheduler and the blocking offload path use), so later jobs pay no thread-creation cost. A job
// owns everything it touches - its callback, one environment word, one argument word and the single
// word it returns - so no reference is reachable from two workers, and every allocation is released
// by exactly one thread: the job's own worker builds the result, the thread that waits for the job
// releases it. That ownership rule is what makes stage 1 (docs/design/parallelism.md) sound with no
// new type property; the closure environment is the part the type checker does not classify yet.
//
// Pool block (raw_map: infrastructure, not counted as user allocation, like the scheduler block):
//   0 futex mutex   8 worker count   16 wake sequence (futex word)   24 idle workers
//   32 worker array  40 injection ring  48 injection head  56 injection tail
//   64 injection capacity  72 steal cursor  80 jobs submitted  128 injection ring storage
// Worker block (raw_map, one page per worker):
//   0 ring  8 head  16 tail  24 deque lock  32 pool  40 index  48 capacity  128 ring storage
// Job block (rt_alloc, freed by the thread that waits for the job):
//   0 callback  8 environment word  16 argument word  24 result word  32 state (futex word)
//
// The owner pushes and pops at the tail of its own ring (LIFO: a nested submit runs its children
// before the parent resumes) while thieves take from the head (FIFO: a stolen job is the oldest, so
// long jobs are spread out by stealing rather than by priority). Rings are bounded; a full ring runs
// the job on the submitting thread instead of blocking, so submission is total and no submitter can
// deadlock waiting for a free slot.
fn rt_pool() -> u64 {
    p := raw_atomic_load(raw_state() + 88);
    if p != 0 {
        return p;
    }
    if raw_atomic_cas(raw_state() + 96, 0, 1) != 0 {
        while raw_atomic_load(raw_state() + 88) == 0 {
            rt_syscall(24, 0, 0, 0);
        }
        return raw_atomic_load(raw_state() + 88);
    }
    made := rt_pool_create();
    raw_atomic_store_release(raw_state() + 88, made);
    return made;
}
// Word 48 of every thread record is unused (0 self, 8 scheduler stack, 16 green task, 24 entry,
// 32 argument, 40 clear-TID word), and a mapped stack is zeroed, so a pool worker can keep its
// worker block there and a nested submit from a job finds the right deque.
fn rt_pool_self() -> u64 {
    tp := raw_tp_get();
    if tp == 0 {
        return 0;
    }
    return raw_load(tp + 48);
}
fn rt_pool_create() -> u64 {
    p := raw_map(4096);
    if rt_error(p) {
        rt_abort();
    }
    raw_store(p + 40, p + 128);
    raw_store(p + 64, 496);
    workers := rt_pool_count();
    raw_store(p + 8, workers);
    array := raw_map(workers * 8);
    if rt_error(array) {
        rt_abort();
    }
    raw_store(p + 32, array);
    mut i = 0;
    while i < workers {
        raw_store(array + i * 8, rt_pool_worker_new(p, i));
        i += 1;
    }
    // Workers start only once the array they are reachable through is complete.
    i = 0;
    while i < workers {
        rt_thread_spawn_detached(rt_pool_worker_main, raw_load(array + i * 8));
        i += 1;
    }
    return p;
}
// Default: at least four workers, so the runtime's own four-way barrier fixture stays satisfiable
// as it was with the previous threaded map, and at most 64. An explicit override is honoured as
// given (1..64), which is how a nested-parallel test proves the helping scheduler cannot deadlock.
fn rt_pool_count() -> u64 {
    override := rt_pool_env_count();
    if override != 0 {
        if 64 < override {
            return 64;
        }
        return override;
    }
    mut n = rt_cpus();
    if n < 4 {
        n = 4;
    }
    if 64 < n {
        n = 64;
    }
    return n;
}
fn rt_pool_env_count() -> u64 {
    name := view("GRAIL_POOL_WORKERS=");
    width := rt_len(name);
    mut ep = raw_load(raw_state() + 16);
    mut value = 0;
    while raw_load(ep) != 0 {
        entry := raw_load(ep);
        if rt_pool_prefix(entry, raw_load(name), width) != 0 {
            mut i = 0;
            mut more = 1;
            while more != 0 {
                b := raw_byte(entry + width + i);
                if (48 <= b) & (b <= 57) {
                    value = value * 10 + (b - 48);
                    i += 1;
                } else {
                    more = 0;
                }
            }
            return value;
        }
        ep = ep + 8;
    }
    return 0;
}
fn rt_pool_prefix(at: u64, base: u64, width: u64) -> u64 {
    mut i = 0;
    while i < width {
        if raw_byte(at + i) != raw_byte(base + i) {
            return 0;
        }
        i += 1;
    }
    return 1;
}
fn rt_pool_worker_new(p: u64, index: u64) -> u64 {
    w := raw_map(8192);
    if rt_error(w) {
        rt_abort();
    }
    raw_store(w, w + 128);
    raw_store(w + 32, p);
    raw_store(w + 40, index);
    raw_store(w + 48, 1008);
    return w;
}
// Idle workers sleep in the kernel on the pool's wake sequence. The loop reads the sequence before
// it looks for work, so a submit that lands after that read bumps the sequence and either the scan
// or the failed futex wait sees it: no wakeup can be lost, and no worker spins for work.
fn rt_pool_worker_main(w: u64) -> u64 {
    tp := raw_tp_get();
    if tp != 0 {
        raw_store(tp + 48, w);
    }
    p := raw_load(w + 32);
    while true {
        mut j = rt_pool_take(w);
        if j != 0 {
            rt_pool_run(j);
        } else {
            seq := raw_atomic_load(p + 16);
            j = rt_pool_take(w);
            if j != 0 {
                rt_pool_run(j);
            } else {
                rt_atomic_fetch_add(p + 24, 1);
                rt_syscall(202, p + 16, 128, seq);
                rt_atomic_fetch_sub(p + 24, 1);
            }
        }
    }
    return 0;
}
// Own deque first (locality), then the injection ring (other threads), then one steal pass whose
// start rotates so idle workers do not all pounce on the same victim.
fn rt_pool_take(w: u64) -> u64 {
    mut j = rt_pool_pop(w);
    if j != 0 {
        return j;
    }
    p := raw_load(w + 32);
    j = rt_pool_inject_pop(p);
    if j != 0 {
        return j;
    }
    workers := raw_load(p + 8);
    first := rt_atomic_fetch_add(p + 72, 1);
    mut k = 0;
    while k < workers {
        victim := (first + k) % workers;
        if victim != raw_load(w + 40) {
            j = rt_pool_steal(raw_load(raw_load(p + 32) + victim * 8));
            if j != 0 {
                return j;
            }
        }
        k += 1;
    }
    return 0;
}
fn rt_pool_push(w: u64, j: u64) -> u64 {
    rt_spin_lock(w + 24);
    head := raw_load(w + 8);
    tail := raw_load(w + 16);
    cap := raw_load(w + 48);
    if tail - head == cap {
        rt_spin_unlock(w + 24);
        return 0;
    }
    raw_store(raw_load(w) + (tail % cap) * 8, j);
    raw_store(w + 16, tail + 1);
    rt_spin_unlock(w + 24);
    return 1;
}
fn rt_pool_pop(w: u64) -> u64 {
    rt_spin_lock(w + 24);
    head := raw_load(w + 8);
    tail := raw_load(w + 16);
    if head == tail {
        rt_spin_unlock(w + 24);
        return 0;
    }
    cap := raw_load(w + 48);
    last := tail - 1;
    j := raw_load(raw_load(w) + (last % cap) * 8);
    raw_store(w + 16, last);
    rt_spin_unlock(w + 24);
    return j;
}
fn rt_pool_steal(v: u64) -> u64 {
    rt_spin_lock(v + 24);
    head := raw_load(v + 8);
    tail := raw_load(v + 16);
    if head == tail {
        rt_spin_unlock(v + 24);
        return 0;
    }
    cap := raw_load(v + 48);
    j := raw_load(raw_load(v) + (head % cap) * 8);
    raw_store(v + 8, head + 1);
    rt_spin_unlock(v + 24);
    return j;
}
fn rt_pool_inject_push(p: u64, j: u64) -> u64 {
    rt_mutex_lock(p);
    head := raw_load(p + 48);
    tail := raw_load(p + 56);
    cap := raw_load(p + 64);
    if tail - head == cap {
        rt_mutex_unlock(p);
        return 0;
    }
    raw_store(raw_load(p + 40) + (tail % cap) * 8, j);
    raw_store(p + 56, tail + 1);
    rt_mutex_unlock(p);
    return 1;
}
fn rt_pool_inject_pop(p: u64) -> u64 {
    rt_mutex_lock(p);
    head := raw_load(p + 48);
    tail := raw_load(p + 56);
    if head == tail {
        rt_mutex_unlock(p);
        return 0;
    }
    cap := raw_load(p + 64);
    j := raw_load(raw_load(p + 40) + (head % cap) * 8);
    raw_store(p + 48, head + 1);
    rt_mutex_unlock(p);
    return j;
}
// The worker builds the job's result and publishes it with a release store before waking waiters;
// nothing touches the job afterwards except this wake, which is why the waiter can free it.
fn rt_pool_run(j: u64) -> u64 {
    r := raw_call2(raw_load(j), raw_load(j + 8), raw_load(j + 16));
    raw_store(j + 24, r);
    raw_atomic_store_release(j + 32, 1);
    rt_syscall(202, j + 32, 129, 2147483647);
    return 0;
}
// Submission is legal from any thread. From a pool worker (a nested submit) the job goes on that
// worker's own deque, so the parent helps run its children instead of sleeping; from anywhere else
// it goes on the injection ring. A full queue runs the job here rather than growing the queue.
fn rt_pool_submit(f: u64, env: u64, arg: u64) -> u64 {
    p := rt_pool();
    j := rt_alloc(48);
    raw_store(j, f);
    raw_store(j + 8, env);
    raw_store(j + 16, arg);
    raw_store(j + 24, 0);
    raw_store(j + 32, 0);
    w := rt_pool_self();
    mut placed = 0;
    if w != 0 {
        placed = rt_pool_push(w, j);
    }
    if placed == 0 {
        placed = rt_pool_inject_push(p, j);
    }
    if placed == 0 {
        rt_pool_run(j);
    } else {
        rt_atomic_fetch_add(p + 80, 1);
        rt_atomic_fetch_add(p + 16, 1);
        rt_syscall(202, p + 16, 129, 2147483647);
    }
    return j;
}
// Waiting is where the pool cannot deadlock: a worker waiting on a job it queued runs queued jobs
// itself, so a pool whose every worker is waiting still makes progress. A thread that is not a
// worker only sleeps, because helping from a non-worker could run an unrelated long job in front of
// the one it is waiting for. The record is freed here: the waiter owns it, the worker never touches
// it after publishing the result.
fn rt_pool_wait(j: u64) -> u64 {
    w := rt_pool_self();
    // A sequentially consistent read (a CAS loop, like the map counter this replaces), not a plain
    // load: the runner's release store publishes the result word, and a plain load would only order
    // that pair on x86. `raw_atomic_load_acquire` is not lowered on AArch64/RV64, so the CAS form is
    // what keeps this correct on every target.
    while rt_atomic_fetch_add(j + 32, 0) == 0 {
        mut helped = 0;
        if w != 0 {
            k := rt_pool_take(w);
            if k != 0 {
                rt_pool_run(k);
                helped = 1;
            }
        }
        if helped == 0 {
            rt_syscall(202, j + 32, 128, 0);
        }
    }
    r := raw_load(j + 24);
    rt_free(j);
    return r;
}
// Map descriptor: 0 callback, 8 environment, 16 context, 24 items base, 32 result base, 40 count,
// 48 items per job. One job per contiguous range: contiguous writes, no per-item atomic.
fn rt_pool_map_chunk(d: u64, start: u64) -> u64 {
    f := raw_load(d);
    env := raw_load(d + 8);
    context := raw_load(d + 16);
    items := raw_load(d + 24);
    out := raw_load(d + 32);
    n := raw_load(d + 40);
    if n <= start {
        return 0;
    }
    mut stop = start + raw_load(d + 48);
    if n < stop {
        stop = n;
    }
    mut i = start;
    while i < stop {
        mut r = 0;
        if env == 0 {
            r = raw_call2(f, raw_load(items + i * 8), context);
        } else {
            r = raw_call3(f, env, raw_load(items + i * 8), context);
        }
        raw_store(out + i * 8, r);
        i += 1;
    }
    return stop - start;
}
// Results land in their input slots, so the order of `out` is the input order whatever order the
// jobs finish in. The caller waits for every job it submitted, so no worker can still write into
// `out` (or read `items`) when this returns; that is the whole structured-join contract.
fn rt_parallel_map(items: u64, context: u64, f: u64, env: u64) -> u64 {
    n := rt_len(items);
    out := rt_new();
    mut i = 0;
    while i < n {
        rt_push(out, 0);
        i += 1;
    }
    if n == 0 {
        rt_drop_seq(items);
        return out;
    }
    // A few jobs per worker keeps every worker busy and lets stealing even out uneven items.
    p := rt_pool();
    mut tasks = raw_load(p + 8) * 4;
    if n < tasks {
        tasks = n;
    }
    chunk := (n + tasks - 1) / tasks;
    d := rt_alloc(56);
    raw_store(d, f);
    raw_store(d + 8, env);
    raw_store(d + 16, context);
    raw_store(d + 24, raw_load(items));
    raw_store(d + 32, raw_load(out));
    raw_store(d + 40, n);
    raw_store(d + 48, chunk);
    jobs := rt_alloc(tasks * 8);
    mut k = 0;
    mut start = 0;
    while k < tasks {
        raw_store(jobs + k * 8, rt_pool_submit(rt_pool_map_chunk, d, start));
        start += chunk;
        k += 1;
    }
    mut written = 0;
    k = 0;
    while k < tasks {
        written += rt_pool_wait(raw_load(jobs + k * 8));
        k += 1;
    }
    // Every item is written exactly once: a chunk that wrote none, or wrote one twice, is a bug.
    if written != n {
        rt_abort();
    }
    rt_free(jobs);
    rt_free(d);
    rt_drop_seq(items);
    return out;
}

// ---- colourless tasks: stackful green threads on a worker pool with an epoll reactor ----
// Every OS thread has a worker record reachable through the thread pointer:
// 0 self, 8 scheduler stack pointer, 16 current green task (0 = plain OS thread).
fn rt_thread_init() -> u64 {
    w := raw_state() + 128;
    raw_store(w, w);
    raw_tp_set(w);
    // The PE entry has no stack arguments; the OS layer recovers argv/envp from Win32. Linux keeps
    // the entry stub's words and this is a no-op.
    rt_os_init();
    // Armed only when `grail profile` left its rendezvous file in the working directory.
    rt_prof_start();
    return 0;
}
fn rt_current() -> u64 {
    w := raw_tp_get();
    if w == 0 {
        return 0;
    }
    return raw_load(w + 16);
}
fn rt_spin_lock(p: u64) -> u64 {
    while raw_atomic_cas(p, 0, 1) != 0 {
        rt_syscall(24, 0, 0, 0);
    }
    return 0;
}
fn rt_spin_unlock(p: u64) -> u64 {
    raw_atomic_store_release(p, 0);
    return 0;
}

// ---- scheduling mode ----
// Linux multiplexes stackful green tasks over a worker pool with an epoll reactor. Windows has no
// epoll, eventfd or timerfd and no stack switching, so a task there is an OS thread of its own:
// suspension is an address wait on the task's own park word, host::read_fd and host::sleep_ms block
// that thread, rt_reactor_fence is a no-op, and a blocking foreign call blocks only the task that
// made it. The task API above this point is identical on both, but the observable scheduling is not
// (docs/design/concurrency-v1.md states the divergence). No reactor is created on Windows.
fn rt_threaded() -> u64 {
    t := raw_target();
    return (t == 3) + (t == 4);
}

// Scheduler (raw_state()+72): 0 queue lock, 8 head, 16 tail, 24 idle sequence (futex),
// 32 worker count, 40 epoll fd, 48 fence eventfd, 56 reactor batch epoch, 64 blocking-call warning
// flag. Infrastructure is mapped, not counted as user allocation.
fn rt_sched() -> u64 {
    state := raw_state();
    s := raw_atomic_load(state + 72);
    if s != 0 {
        return s;
    }
    if raw_atomic_cas(state + 80, 0, 1) == 0 {
        made := raw_map(4096);
        if rt_error(made) {
            rt_abort();
        }
        if rt_threaded() {
            // No reactor and no worker pool: this block only carries the blocking-call warning flag.
            raw_atomic_store(state + 72, made);
            return made;
        }
        epoll := rt_syscall(291, 524288, 0, 0);
        if rt_error(epoll) {
            rt_abort();
        }
        raw_store(made + 40, epoll);
        fence := rt_syscall(290, 0, 526336, 0);
        if rt_error(fence) {
            rt_abort();
        }
        raw_store(made + 48, fence);
        ev := raw_map(4096);
        raw_store(ev, 1); // EPOLLIN, data 0 marks the fence descriptor
        if rt_error(rt_syscall4(233, epoll, 1, fence, ev)) {
            rt_abort();
        }
        rt_syscall(11, ev, 4096, 0);
        mut workers = rt_cpus();
        if workers < 4 {
            workers = 4;
        }
        if 64 < workers {
            workers = 64;
        }
        raw_store(made + 32, workers);
        raw_atomic_store(state + 72, made);
        mut i = 0;
        while i < workers {
            rt_thread_spawn_detached(rt_worker_loop, made);
            i += 1;
        }
        rt_thread_spawn_detached(rt_reactor, made);
        return made;
    }
    while raw_atomic_load(state + 72) == 0 {
        rt_syscall(24, 0, 0, 0);
    }
    return raw_atomic_load(state + 72);
}
fn rt_enqueue(t: u64) -> u64 {
    s := rt_sched();
    rt_spin_lock(s);
    raw_store(t + 32, 0);
    tail := raw_load(wrapping_add(s, 16));
    if tail == 0 {
        raw_store(wrapping_add(s, 8), t);
    } else {
        raw_store(tail + 32, t);
    }
    raw_store(wrapping_add(s, 16), t);
    rt_spin_unlock(s);
    rt_atomic_fetch_add(s + 24, 1);
    rt_syscall(202, s + 24, 129, 1);
    return 0;
}
fn rt_dequeue(s: u64) -> u64 {
    while true {
        seq := raw_atomic_load(s + 24);
        rt_spin_lock(s);
        t := raw_load(wrapping_add(s, 8));
        if t != 0 {
            next := raw_load(t + 32);
            raw_store(wrapping_add(s, 8), next);
            if next == 0 {
                raw_store(wrapping_add(s, 16), 0);
            }
            rt_spin_unlock(s);
            return t;
        }
        rt_spin_unlock(s);
        rt_syscall(202, s + 24, 128, seq);
    }
    return 0;
}
// Task words: 0 saved sp, 8 stack base, 16 stack size, 24 park state (0 running, 1 parking,
// 2 parked, 3 wake pending), 32 queue link, 40 callback, 48 item, 56 context, 64 arity,
// 72 cancel flag address, 80 result, 88 joiner (0 none, 1 finished, else waiting task),
// 96 finished (futex word for OS-thread joiners), 104 handle (0 live, 1 joined, 2 abandoned),
// 112 result drop function, 120 scope link, 128 in cancellable wait, 136 yield request,
// 144 completed (set by the task itself before its last switch).
fn rt_worker_loop(s: u64) -> u64 {
    w := raw_tp_get();
    while true {
        t := rt_dequeue(s);
        raw_store(w + 16, t);
        raw_switch(w + 8, raw_load(t));
        raw_store(w + 16, 0);
        if raw_load(t + 144) {
            // Now off the task's stack: release it, then publish completion (the joiner may free t).
            if rt_error(rt_syscall(11, raw_load(t + 8), raw_load(t + 16), 0)) {
                rt_abort();
            }
            raw_atomic_store(t + 96, 1);
            rt_syscall(202, t + 96, 129, 2147483647);
            joiner := rt_atomic_swap(t + 88, 1);
            if 1 < joiner {
                rt_wake(joiner);
            }
        } else {
            if raw_load(t + 136) {
                raw_store(t + 136, 0);
                rt_enqueue(t);
            } else {
                if raw_atomic_cas(t + 24, 1, 2) != 1 {
                    raw_atomic_store(t + 24, 0);
                    rt_enqueue(t);
                }
            }
        }
    }
    return 0;
}
// The task's own call: arity 3 carries the scope's cancel token.
fn rt_task_body(t: u64) -> u64 {
    f := raw_load(t + 40);
    item := raw_load(t + 48);
    context := raw_load(t + 56);
    mut r = 0;
    if raw_load(t + 64) == 3 {
        r = raw_call3(f, item, context, raw_load(t + 72));
    } else {
        r = raw_call2(f, item, context);
    }
    return r;
}
fn rt_green_main() -> u64 {
    t := rt_current();
    raw_store(t + 80, rt_task_body(t));
    raw_store(t + 144, 1);
    w := raw_tp_get();
    raw_switch(t, raw_load(w + 8));
    rt_abort();
    return 0;
}
// Thread-per-task entry (Windows): the task runs to completion on its own OS thread, then publishes
// its result and wakes whoever waits on its finished word. No stack switch is involved, so a task
// that blocks in a foreign call blocks only itself.
fn rt_task_thread_main(t: u64) -> u64 {
    w := raw_tp_get();
    raw_store(w + 16, t);
    raw_store(t + 80, rt_task_body(t));
    raw_store(t + 144, 1);
    raw_atomic_store(t + 96, 1);
    rt_syscall(202, t + 96, 129, 2147483647);
    raw_store(w + 16, 0);
    return 0;
}
// Suspend the current task until rt_wake. A wake that arrives first is not lost.
fn rt_suspend(t: u64) -> u64 {
    if raw_atomic_cas(t + 24, 0, 1) != 0 {
        raw_atomic_store(t + 24, 0);
        return 0;
    }
    if rt_threaded() {
        // No stack switch: block this task's own thread on its park word until a wake marks it.
        while true {
            if raw_atomic_load(t + 24) == 3 {
                raw_atomic_store(t + 24, 0);
                return 0;
            }
            rt_syscall(202, t + 24, 128, 1);
        }
    }
    w := raw_tp_get();
    raw_switch(t, raw_load(w + 8));
    return 0;
}
fn rt_wake(t: u64) -> u64 {
    while true {
        s := raw_atomic_load(t + 24);
        if rt_threaded() {
            if s == 3 {
                return 0;
            }
            if raw_atomic_cas(t + 24, s, 3) == s {
                rt_syscall(202, t + 24, 129, 1);
                return 0;
            }
        } else if s == 2 {
            if raw_atomic_cas(t + 24, 2, 0) == 2 {
                rt_enqueue(t);
                return 0;
            }
        } else {
            if s == 3 {
                return 0;
            }
            if raw_atomic_cas(t + 24, s, 3) == s {
                return 0;
            }
        }
    }
    return 0;
}
fn rt_yield() -> u64 {
    t := rt_current();
    if (t == 0) | rt_threaded() {
        // A thread-per-task task owns its thread, so yielding is giving up the CPU, not a switch.
        rt_syscall(24, 0, 0, 0);
        return 0;
    }
    raw_store(t + 136, 1);
    w := raw_tp_get();
    raw_switch(t, raw_load(w + 8));
    return 0;
}
// Mutex acquisition from a green task yields instead of blocking its worker, so a holder that
// suspended (for I/O) can always resume on some worker.
fn rt_mutex_lock(p: u64) -> u64 {
    if (rt_current() != 0) & (rt_threaded() == 0) {
        while raw_atomic_cas(p, 0, 1) != 0 {
            rt_yield();
        }
        return 0;
    }
    mut state = raw_atomic_cas(p, 0, 1);
    if state == 0 {
        return 0;
    }
    if state != 2 {
        state = rt_atomic_swap(p, 2);
    }
    while state != 0 {
        rt_syscall(202, p, 128, 2);
        state = rt_atomic_swap(p, 2);
    }
    return 0;
}

// ---- structured task scopes ----
// Scope words: 0 self (a scope reference points here), 8 cancel flag, 16 context, 24 tasks.
fn rt_scope_begin(context: u64) -> u64 {
    s := rt_alloc(32);
    raw_store(s, s);
    raw_store(s + 16, context);
    return s;
}
fn rt_scope_token(s: u64) -> u64 {
    return s + 8;
}
fn rt_cancelled(p: u64) -> u64 {
    if raw_load(p) == p {
        return raw_atomic_load(p + 8);
    }
    return raw_atomic_load(p);
}
// Cancellation is cooperative and observable; it also wakes tasks in cancellable waits.
fn rt_cancel(s: u64) -> u64 {
    raw_atomic_store(s + 8, 1);
    mut t = raw_load(s + 24);
    while t != 0 {
        if raw_atomic_load(t + 128) {
            rt_wake(t);
        }
        t = raw_load(t + 120);
    }
    return 0;
}
fn rt_task_spawn(s: u64, f: u64, item: u64, arity: u64, dropper: u64) -> u64 {
    // Word 152 holds the task's OS thread handle in thread-per-task mode (0 in green mode).
    t := rt_alloc(160);
    raw_store(t + 40, f);
    raw_store(t + 48, item);
    raw_store(t + 56, raw_load(s + 16));
    raw_store(t + 64, arity);
    raw_store(t + 72, s + 8);
    raw_store(t + 112, dropper);
    raw_store(t + 120, raw_load(s + 24));
    raw_store(t + 152, 0);
    raw_store(s + 24, t);
    if rt_threaded() {
        raw_store(t + 152, rt_thread_spawn(rt_task_thread_main, t));
        return t;
    }
    size := 262144;
    stack := raw_map(size);
    if rt_error(stack) {
        rt_abort();
    }
    if rt_error(rt_syscall(10, stack, 4096, 0)) {
        rt_abort();
    }
    raw_store(t + 8, stack);
    raw_store(t + 16, size);
    // Initial switch frame, as the target's switch saves it, whose restored resume address enters
    // rt_green_main: x86-64 8 words (resume first); AArch64 22 words (resume first); RISC-V 26
    // words (resume last).
    target := raw_target();
    mut words = 8;
    mut slot = 0;
    if target == 1 {
        words = 22;
    }
    if target == 2 {
        words = 26;
        slot = 25;
    }
    frame := stack + size - words * 8;
    raw_store(frame + slot * 8, rt_green_main);
    raw_store(t, frame);
    rt_enqueue(t);
    return t;
}
fn rt_task_wait(t: u64) -> u64 {
    if raw_atomic_load(t + 96) {
        return 0;
    }
    if rt_threaded() {
        // The task's own thread publishes word 96 and wakes this address, so the waiter blocks here.
        while raw_atomic_load(t + 96) == 0 {
            rt_syscall(202, t + 96, 128, 0);
        }
        return 0;
    }
    me := rt_current();
    if me != 0 {
        if raw_atomic_cas(t + 88, 0, me) == 0 {
            while raw_atomic_load(t + 96) == 0 {
                rt_suspend(me);
            }
        }
        while raw_atomic_load(t + 96) == 0 {
            rt_yield();
        }
        return 0;
    }
    while raw_atomic_load(t + 96) == 0 {
        rt_syscall(202, t + 96, 128, 0);
    }
    return 0;
}
fn rt_task_join(t: u64) -> u64 {
    if raw_load(t + 104) != 0 {
        rt_abort();
    }
    rt_task_wait(t);
    raw_store(t + 104, 1);
    rt_task_reap(t);
    return raw_load(t + 80);
}
// A thread-per-task task owns an OS thread: the joiner reaps it once the finished word is set, so
// the thread has exited before its stack is unmapped and the handle is released. Green tasks have
// already released their own stack, so this is a no-op there.
fn rt_task_reap(t: u64) -> u64 {
    if rt_threaded() {
        h := rt_atomic_swap(t + 152, 0);
        if h != 0 {
            rt_thread_join(h);
        }
    }
    return 0;
}
// Dropping an unjoined handle never blocks: the scope exit joins and destroys the result.
fn rt_task_abandon(t: u64) -> u64 {
    if raw_load(t + 104) == 0 {
        raw_store(t + 104, 2);
    }
    return 0;
}
// After this returns, no readiness batch read before the call is still being delivered, so a
// task woken by cancellation (whose event may already have been read) can be freed safely.
fn rt_reactor_fence() -> u64 {
    if rt_threaded() {
        return 0; // no reactor batch to fence
    }
    s := raw_atomic_load(raw_state() + 72);
    if s == 0 {
        return 0;
    }
    epoch := raw_atomic_load(s + 56);
    one := rt_alloc(8);
    raw_store(one, 1);
    rt_syscall(1, raw_load(s + 48), one, 8);
    rt_free(one);
    while raw_atomic_load(s + 56) == epoch {
        rt_yield();
    }
    return 0;
}
fn rt_scope_end(s: u64) -> u64 {
    mut t = raw_load(s + 24);
    mut first = t;
    while first != 0 {
        rt_task_wait(first);
        first = raw_load(first + 120);
    }
    if raw_load(s + 24) != 0 {
        rt_reactor_fence();
    }
    while t != 0 {
        rt_task_wait(t);
        state := raw_load(t + 104);
        if state == 0 {
            rt_abort();
        }
        dropper := raw_load(t + 112);
        if (state == 2) & (dropper != 0) {
            raw_call2(dropper, raw_load(t + 80), 0);
        }
        rt_task_reap(t);
        next := raw_load(t + 120);
        rt_free(t);
        t = next;
    }
    rt_free(s);
    return 0;
}

// ---- readiness reactor and suspending I/O ----
fn rt_reactor(s: u64) -> u64 {
    events := raw_map(4096);
    scratch := events + 2048;
    epoll := raw_load(s + 40);
    mut width = 16;
    if raw_target() == 0 {
        width = 12;
    }
    while true {
        n := rt_syscall4(281, epoll, events, 64, wrapping_sub(0, 1));
        if rt_error(n) == 0 {
            mut i = 0;
            while i < n {
                mut at = events + i * width + 8;
                if width == 12 {
                    at = events + i * 12 + 4;
                }
                task := raw_load(at);
                if task == 0 {
                    rt_syscall(0, raw_load(s + 48), scratch, 8);
                } else {
                    rt_wake(task);
                }
                i += 1;
            }
        }
        rt_atomic_fetch_add(s + 56, 1);
    }
    return 0;
}
// Wait until fd is ready (events: 1 readable, 4 writable). A green task suspends; a plain OS
// thread blocks in ppoll. Returns -125 (ECANCELED) if its scope is cancelled.
fn rt_wait_fd(fd: u64, events: u64) -> u64 {
    if rt_threaded() {
        // No readiness reactor: the task's own thread does the blocking call that follows, so there
        // is nothing to wait for here. This is the documented thread-per-blocking-call policy.
        return 0;
    }
    t := rt_current();
    if t == 0 {
        p := rt_alloc(8);
        raw_store(p, (fd & 4294967295) + events * 4294967296);
        rt_syscall(271, p, 1, 0);
        rt_free(p);
        return 0;
    }
    token := raw_load(t + 72);
    raw_atomic_store(t + 128, 1);
    if raw_atomic_load(token) {
        raw_atomic_store(t + 128, 0);
        return wrapping_sub(0, 125);
    }
    s := rt_sched();
    epoll := raw_load(s + 40);
    ev := rt_alloc(16);
    raw_store(ev, events + 1073741824); // EPOLLONESHOT
    if raw_target() == 0 {
        raw_store(ev + 4, t);
    } else {
        raw_store(ev + 8, t);
    }
    mut r = rt_syscall4(233, epoll, 1, fd, ev);
    if r == wrapping_sub(0, 17) {
        r = rt_syscall4(233, epoll, 3, fd, ev);
    }
    rt_free(ev);
    if rt_error(r) {
        rt_abort();
    }
    rt_suspend(t);
    raw_atomic_store(t + 128, 0);
    rt_syscall4(233, epoll, 2, fd, 0);
    if raw_atomic_load(token) {
        return wrapping_sub(0, 125);
    }
