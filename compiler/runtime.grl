    out := rt_site_text(site);
    joined := raw_load(t + 232);
    if joined != 0 {
        line := rt_new();
        rt_reserveb(line, 400);
        raw_store(line + 8, rt_fail_line(raw_load(line), 0, joined, view(" = in a job joined at ")));
        rt_append(out, line);
        rt_drop_seq(line);
    }
    return out;
}
// An explicit task failure (`task_fail(msg)`): the caller's own text, with the location of the call.
// Contained exactly like a failed check, so it is a value at the join or the end of the process.
fn rt_task_fail(text: u64) -> u64 {
