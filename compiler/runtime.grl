        lc := rt_big_cmp(r, mm);
        low := (lc == 0) + ((lc == 1) & even);
        rt_big_add(t, r, mp);
        hc := rt_big_cmp(t, s);
        high := (hc == 2) + ((hc == 1) & even);
        if (low == 0) & (high == 0) {
            rt_push(digits, d);
            continue;
