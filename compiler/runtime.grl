        p := rt_alloc(8);
        raw_store(p, (fd & 4294967295) + events * 4294967296);
        rt_syscall(271, p, 1, 0);
        rt_free(p);
        return 0;
    }
    token := raw_load(t + 72);
    raw_atomic_store(t + 128, 1);
    if raw_atomic_load(token) {
        raw_atomic_store(t + 128, 0);
        return wrapping_sub(0, 125);
    }
    s := rt_sched();
    if rt_os_wait_fd(s, fd, events, t) != 0 {
        raw_atomic_store(t + 128, 0);
        return 0; // could not arm: the caller retries the operation
    }
    rt_suspend(t);
    raw_atomic_store(t + 128, 0);
    rt_os_wait_done(s, fd);
    if raw_atomic_load(token) {
        return wrapping_sub(0, 125);
    }
    return 0;
}
