        // contain it. The native backend writes this check in line; this body is what the LLVM
        // backend calls.
        rt_fail(1, i, raw_load(wrapping_add(s, 8)));
    }
    return wrapping_add(raw_load(s), wrapping_mul(i, 4));
}
