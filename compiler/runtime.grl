        if kind == 4 {
            rt_push4(out, rt_load_sized(a, 4, 0));
        } else if kind == 3 {
            rt_pushb(out, raw_byte(a));
        } else if kind == 2 {
            // A vector of extern records stores them inline, as the C array does.
            rt_pushw(out, rt_flat_box(a, size), size);
        } else {
            if kind == 1 {
                rt_push(out, rt_f32_from_bits(rt_load_sized(a, 4, 0)));
            } else if size == 8 {
                // A whole word (i64, u64, CStr, CPtr): rt_load_sized's scale would overflow.
                rt_push(out, raw_load(a));
