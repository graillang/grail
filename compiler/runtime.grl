// Waits for `pid` and reaps it: the status word wait4(2) reports (`code << 8` for an exit, the
// signal number in the low bits when one ended the child) or a wrapped negative errno.
fn f_host_wait(pid: u64) -> u64 {
    return rt_wait_pid(pid);
}
