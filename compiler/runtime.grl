unsafe module runtime;

// Trusted native runtime, entirely Grail. Raw intrinsics below are the compiler/OS boundary.
// All runtime values are words. Sequence = {data,length,capacity}; allocation header = {class,link}.
// Process state: argc,argv,envp,live allocation count,arena chain; allocator bins start at byte 256.
// Freed blocks return to segregated free lists; mapped arenas are unmapped by rt_shutdown.

fn rt_abort()->num {
    let pid=raw_syscall(39,0,0,0);
    raw_syscall(62,pid,6,0);
    raw_syscall(60,134,0,0);
    return 0;
}
fn rt_error(n:num)->num { return 18446744073709547520<n; }
fn rt_div(n:num,d:num)->num {
    if d==0 { rt_abort(); }
    var q=0; var r=n;
    while (r<d)==0 {
        var m=d; var k=1;
        while ((r<m+m)==0)&((m+m<m)==0) { m=m+m; k=k+k; }
        r=r-m; q=q+k;
    }
    return q;
}
fn rt_alloc(n:num)->num {
    let state=raw_state();
    if 1152921504606846976<n { rt_abort(); }
    var size=32; var bin=0;
    while size<n+16 { size=size*2; bin=bin+1; }
    let head=state+256+bin*8;
    var block=raw_load(head);
    if block!=0 {
        raw_store(head,raw_load(block+8));
    } else {
        let bump=state+768+bin*8;
        let left=state+1280+bin*8;
        if raw_load(left)==0 {
            var mapsize=1048576;
            if mapsize<size+16 { mapsize=size+16; }
            let arena=raw_map(mapsize);
            if rt_error(arena) { rt_abort(); }
            raw_store(arena,raw_load(state+32));
            raw_store(arena+8,mapsize);
            raw_store(state+32,arena);
            raw_store(bump,arena+16);
            raw_store(left,rt_div(mapsize-16,size));
        }
        block=raw_load(bump);
        raw_store(bump,block+size);
        raw_store(left,raw_load(left)-1);
        raw_store(block,size);
    }
    raw_store(block+8,1);
    let ptr=block+16;
    var i=0;
    while i<size-16 { raw_store(ptr+i,0); i=i+8; }
    raw_store(state+24,raw_load(state+24)+1);
    return ptr;
}
fn rt_free(ptr:num)->num {
    if ptr==0 { return 0; }
    let state=raw_state(); let block=ptr-16;
    if raw_load(block+8)!=1 { rt_abort(); }
    let size=raw_load(block); var n=32; var bin=0;
    while n<size { n=n*2; bin=bin+1; }
    let head=state+256+bin*8;
    raw_store(block+8,raw_load(head)); raw_store(head,block);
    raw_store(state+24,raw_load(state+24)-1);
    return 0;
}
fn rt_live()->num { return raw_load(raw_state()+24); }
fn rt_shutdown()->num {
    let state=raw_state(); var arena=raw_load(state+32);
    while arena!=0 {
        let next=raw_load(arena); let size=raw_load(arena+8);
        raw_syscall(11,arena,size,0); arena=next;
    }
    raw_store(state+32,0);
    return 0;
}
fn rt_new()->num { return rt_alloc(24); }
fn rt_push(s:num,v:num)->num {
    let n=raw_load(s+8); let cap=raw_load(s+16);
    if n==cap {
        var capacity=cap*2; if capacity==0 { capacity=8; }
        if 144115188075855872<capacity { rt_abort(); }
        let old=raw_load(s); let ptr=rt_alloc(capacity*8);
        var i=0; while i<n { raw_store(ptr+i*8,raw_load(old+i*8)); i=i+1; }
        rt_free(old); raw_store(s,ptr); raw_store(s+16,capacity);
    }
    raw_store(raw_load(s)+n*8,v); raw_store(s+8,n+1); return 0;
}
fn rt_pushb(s:num,v:num)->num { return rt_push(s,v&255); }
fn rt_pop(s:num)->num {
    let n=raw_load(s+8); if n==0 { rt_abort(); }
    let v=raw_load(raw_load(s)+(n-1)*8);
    raw_store(raw_load(s)+(n-1)*8,0); raw_store(s+8,n-1); return v;
}
fn rt_len(s:num)->num { return raw_load(s+8); }
fn rt_slot(s:num,i:num)->num {
    if (i<raw_load(s+8))==0 { rt_abort(); }
    return raw_load(s)+i*8;
}
fn rt_at(s:num,i:num)->num { return raw_load(rt_slot(s,i)); }
fn rt_write(s:num,i:num,v:num)->num { return raw_store(rt_slot(s,i),v&255); }
fn rt_slice(s:num,a:num,b:num)->num {
    if (b<a)+(raw_load(s+8)<b) { rt_abort(); }
    let v=rt_alloc(24); raw_store(v,raw_load(s)+a*8); raw_store(v+8,b-a); return v;
}
fn rt_view(s:num)->num { return rt_slice(s,0,raw_load(s+8)); }
fn rt_append(dst:num,src:num)->num {
    let n=raw_load(src+8); var i=0;
    while i<n { rt_push(dst,raw_load(raw_load(src)+i*8)); i=i+1; } return 0;
}
fn rt_copy(src:num)->num { let dst=rt_new(); rt_append(dst,src); return dst; }
fn rt_lit(ptr:num,n:num)->num {
    let s=rt_new(); var i=0;
    while i<n { rt_push(s,raw_byte(ptr+i)); i=i+1; } return s;
}
fn rt_rec(n:num)->num {
    if 144115188075855872<n { rt_abort(); } return rt_alloc(n*8);
}
fn rt_enum(tag:num,payload:num)->num {
    let p=rt_alloc(16); raw_store(p,tag); raw_store(p+8,payload); return p;
}
fn rt_xchg(p:num,v:num)->num { let old=raw_load(p); raw_store(p,v); return old; }
fn rt_drop_seq(s:num)->num {
    if s!=0 { rt_free(raw_load(s)); rt_free(s); } return 0;
}
fn rt_pack(s:num)->num {
    let n=raw_load(s+8); let buf=rt_alloc(n+1); var i=0;
    while i<n { raw_putbyte(buf+i,raw_load(raw_load(s)+i*8)); i=i+1; } return buf;
}
fn rt_cstr(s:num)->num {
    let buf=rt_pack(s); let n=raw_load(s+8); var i=0;
    while i<n { if raw_byte(buf+i)==0 { rt_free(buf); return 0; } i=i+1; }
    return buf;
}
fn f_host_argc()->num { return raw_load(raw_state()); }
fn f_host_arg(i:num)->num {
    if (i<f_host_argc())==0 { rt_abort(); }
    let p=raw_load(raw_load(raw_state()+8)+i*8); var n=0;
    while raw_byte(p+n)!=0 { n=n+1; } return rt_lit(p,n);
}
fn f_host_read_file(path:num)->num {
    let name=rt_cstr(path); if name==0 { rt_abort(); }
    let fd=raw_syscall(2,name,0,0); rt_free(name); if rt_error(fd) { rt_abort(); }
    let buf=rt_alloc(4096); let out=rt_new();
    while 1 {
        let n=raw_syscall(0,fd,buf,4096);
        if n==0 { break; }
        if n==0-4 { continue; }
        if rt_error(n) { rt_abort(); }
        var i=0; while i<n { rt_push(out,raw_byte(buf+i)); i=i+1; }
    }
    raw_syscall(3,fd,0,0); rt_free(buf); return out;
}
fn rt_write_all(fd:num,ptr:num,n:num)->num {
    var i=0;
    while i<n {
        let r=raw_syscall(1,fd,ptr+i,n-i);
        if r==0-4 { continue; }
        if rt_error(r) { return 0-r; }
        if r==0 { return 5; }
        i=i+r;
    }
    return 0;
}
fn f_host_write_file(path:num,data:num)->num {
    let name=rt_cstr(path); if name==0 { return 22; }
    let fd=raw_syscall(2,name,577,438); rt_free(name);
    if rt_error(fd) { return 0-fd; }
    let packed=rt_pack(data); let result=rt_write_all(fd,packed,rt_len(data));
    let closed=raw_syscall(3,fd,0,0); rt_free(packed);
    if result!=0 { return result; }
    if rt_error(closed) { return 0-closed; } return 0;
}
fn f_host_print(data:num)->num {
    let packed=rt_pack(data); let err=rt_write_all(1,packed,rt_len(data)); rt_free(packed);
    if err!=0 { rt_abort(); } return 0;
}
// Print the numeric entry result without libc, allocation escape or unchecked formatting.
fn rt_print_num(n:num)->num {
    let buf=rt_alloc(32); var pos=30; var remaining=n;
    raw_putbyte(buf+31,10);
    while 1 {
        raw_putbyte(buf+pos,48+remaining%10); remaining=rt_div(remaining,10);
        if remaining==0 { break; } pos=pos-1;
    }
    let err=rt_write_all(1,buf+pos,32-pos); rt_free(buf);
    if err!=0 { rt_abort(); } return 0;
}
fn rt_exec(file:num,argv:num)->num {
    let env=raw_load(raw_state()+16);
    var i=0; var slash=0;
    while raw_byte(file+i)!=0 { if raw_byte(file+i)==47 { slash=1; } i=i+1; }
    let direct=raw_syscall(59,file,argv,env);
    if slash { return direct; }
    // Search PATH (including empty entries as the current directory).
    var ep=env; var path=0;
    while raw_load(ep)!=0 {
        let p=raw_load(ep);
        if raw_byte(p)==80 { if raw_byte(p+1)==65 { if raw_byte(p+2)==84 {
            if raw_byte(p+3)==72 { if raw_byte(p+4)==61 { path=p+5; break; } }
        } } }
        ep=ep+8;
    }
    var fallback=0;
    if path==0 {
        fallback=rt_alloc(14);
        // /bin:/usr/bin
        raw_putbyte(fallback,47); raw_putbyte(fallback+1,98); raw_putbyte(fallback+2,105); raw_putbyte(fallback+3,110);
        raw_putbyte(fallback+4,58); raw_putbyte(fallback+5,47); raw_putbyte(fallback+6,117); raw_putbyte(fallback+7,115);
        raw_putbyte(fallback+8,114); raw_putbyte(fallback+9,47); raw_putbyte(fallback+10,98); raw_putbyte(fallback+11,105);
        raw_putbyte(fallback+12,110); path=fallback;
    }
    var start=0;
    while 1 {
        var end=start;
        while raw_byte(path+end)!=0 { if raw_byte(path+end)==58 { break; } end=end+1; }
        let len=end-start; let candidate=rt_alloc(len+i+2); var j=0;
        while j<len { raw_putbyte(candidate+j,raw_byte(path+start+j)); j=j+1; }
        if len!=0 { raw_putbyte(candidate+j,47); j=j+1; }
        var k=0; while k<i { raw_putbyte(candidate+j+k,raw_byte(file+k)); k=k+1; }
        raw_syscall(59,candidate,argv,env); rt_free(candidate);
        if raw_byte(path+end)==0 { break; } start=end+1;
    }
    rt_free(fallback); return direct;
}
fn f_host_command(args:num)->num {
    let n=rt_len(args); var result=278; var made=0;
    let argv=rt_alloc((n+1)*8);
    if n!=0 {
        while made<n {
            let p=rt_cstr(rt_at(args,made)); if p==0 { break; }
            raw_store(argv+made*8,p); made=made+1;
        }
        if made==n {
            let child=raw_syscall(57,0,0,0);
            if child==0 {
                rt_exec(raw_load(argv),argv); raw_syscall(60,127,0,0);
            }
            if rt_error(child) { result=256-child; } else {
                let status=rt_alloc(8); var waited=0;
                while 1 {
                    waited=raw_syscall(61,child,status,0);
                    if waited!=0-4 { break; }
                }
                if rt_error(waited) { result=256-waited; } else {
                    let code=raw_load(status); let sig=code&127;
                    if sig!=0 { result=128+sig; } else { result=rt_div(code,256)&255; }
                }
                rt_free(status);
            }
        }
    }
    var i=0; while i<made { rt_free(raw_load(argv+i*8)); i=i+1; } rt_free(argv);
    i=0; while i<n { rt_drop_seq(rt_at(args,i)); i=i+1; } rt_drop_seq(args);
    return result;
}
