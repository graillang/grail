    if n == cap {
        mut capacity = cap * 2;
        if capacity == 0 {
            capacity = 8;
        }
        if 144115188075855872 < capacity {
            rt_abort();
        }
        ptr := rt_grow(raw_load(s), n * 8, capacity * 8);
        raw_store(s, ptr);
        raw_store(wrapping_add(s, 16), capacity);
    }
    raw_store(wrapping_add(raw_load(s), wrapping_mul(n, 8)), v);
    raw_store(wrapping_add(s, 8), n + 1);
    return 0;
}
// Byte sequences (bytes, string, views) store one byte per element; vectors store words.
// `T[v; n]`: n copies of a plain word value, reserved once.
fn rt_fill(s: u64, v: u64, n: u64) -> u64 {
    if 144115188075855872 < n {
        rt_abort();
    }
    if n != 0 {
        ptr := rt_grow(raw_load(s), 0, n * 8);
        raw_store(s, ptr);
        raw_store(wrapping_add(s, 16), n);
    }
    mut i: u64 = 0;
    while i < n {
        raw_store(wrapping_add(raw_load(s), wrapping_mul(i, 8)), v);
        i = i + 1;
    }
    raw_store(wrapping_add(s, 8), n);
    return 0;
}
// `u8[v; n]`: n copies of a byte; stops the program when v does not fit a byte.
fn rt_fillb(s: u64, v: u64, n: u64) -> u64 {
