    return rt_pop(s);
}
fn rt_popb_quiet(s: u64) -> u64 {
    if raw_load(wrapping_add(s, 8)) == 0 {
        return 0;
    }
    return rt_popb(s);
}
fn rt_pop4_quiet(s: u64) -> u64 {
    if raw_load(wrapping_add(s, 8)) == 0 {
        return 0;
    }
    return rt_pop4(s);
}
// `Some(element)` when the collection had an element before the pop, `None` otherwise.
fn rt_pop_option(had: u64, element: u64, some: u64, none: u64) -> u64 {
    if had == 0 {
        return rt_enum(none, 0);
