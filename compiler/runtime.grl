    v := raw_byte(wrapping_add(raw_load(s), n - 1));
    raw_store(wrapping_add(s, 8), n - 1);
    return v;
}
// Compiler-owned map construction requests fresh Linux entropy, never clock-derived seeds.
fn rt_random_seed() -> u64 {
    ptr := rt_alloc(8);
    mut used = 0;
    while used < 8 {
        mut number = 318;
        if raw_target() != 0 { number = 278; }
        n := raw_syscall(number, ptr + used, 8 - used, 0);
        if n == 18446744073709551612 {
            // EINTR: retry without weakening the entropy source.
        } else {
            if (n == 0) + (8 - used < n) { rt_abort(); }
            used += n;
        }
