// `env` is the child's whole environment or 0 to inherit this process's. The child's stdout is
// connected to `out_fd` and its stderr to `err_fd` when they are descriptors; 1 and 2 leave them
// inherited, which is the cheap path. The answer is the child's id, or a wrapped negative errno when
// the child could not be started - unlike `command`, which waits and reports a status.
fn f_host_spawn(args: u64, env: u64, out_fd: u64, err_fd: u64) -> u64 {
    n := rt_len(args);
    mut envc = 0;
    if env != 0 {
        envc = rt_len(env);
    }
    mut result = wrapping_sub(0, 22);
    mut made = 0;
