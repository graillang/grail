    mut i = 48;
    while 0 < i {
        i -= 1;
        v := raw_load(p + i * 8) + carry * 1000000000;
        raw_store(p + i * 8, rt_div(v, 2));
        carry = v % 2;
    }
    return carry;
}
fn rt_big_is_zero(p: u64) -> u64 {
    mut i = 0;
    while i < 48 {
        if raw_load(p + i * 8) != 0 {
            return 0;
        }
        i += 1;
    }
    return 1;
}
fn rt_fmt_f64_fixed(acc: u64, v: u64, digits: u64) -> u64 {
    if raw_feq(v, v) == 0 {
        return rt_push_text(acc, 78, 97, 78);
    }
    if 9223372036854775807 < v {
        rt_pushb(acc, 45);
    }
    exponent := rt_div(v, 4503599627370496) & 2047;
    fraction := v & 4503599627370495;
    if exponent == 2047 {
        return rt_push_text(acc, 105, 110, 102);
    }
    mut f = fraction;
    mut e = 0;
    mut eneg = 0;
    if exponent == 0 {
        e = 1074;
        eneg = 1;
    } else {
        f = fraction + 4503599627370496;
        if exponent < 1075 {
            e = 1075 - exponent;
            eneg = 1;
        } else {
            e = exponent - 1075;
        }
    }
    q := rt_big(f);
    mut i = 0;
    while i < digits {
        rt_big_mul(q, 10);
        i += 1;
    }
    if eneg == 0 {
        rt_big_shift(q, e);
    } else {
        mut last = 0;
        mut sticky = 0;
        i = 0;
        while i < e {
            if last {
                sticky = 1;
            }
            last = rt_big_half(q);
            i += 1;
        }
        if last & (((sticky != 0) + (raw_load(q) & 1)) != 0) {
            one := rt_big(1);
            rt_big_add(q, q, one);
            rt_free(one);
        }
    }
    // decimal digits of q, most significant first
    text := rt_new();
    mut top = 47;
    while (0 < top) & (raw_load(q + top * 8) == 0) {
        top -= 1;
    }
    mut first = raw_load(q + top * 8);
    rt_fmt_num(text, first);
    i = top;
    while 0 < i {
        i -= 1;
        limb := raw_load(q + i * 8);
        mut scale = 100000000;
        while 0 < scale {
            rt_pushb(text, 48 + rt_div(limb, scale) % 10);
            scale = rt_div(scale, 10);
        }
    }
    n := rt_len(text);
    if n < digits + 1 {
        mut z = digits + 1 - n;
        rt_pushb(acc, 48);
        if digits {
            rt_pushb(acc, 46);
        }
        z -= 1;
        while 0 < z {
            rt_pushb(acc, 48);
            z -= 1;
        }
        i = 0;
        while i < n {
            rt_pushb(acc, rt_atb(text, i));
            i += 1;
        }
    } else {
        i = 0;
        while i < n {
            if (i == n - digits) & (digits != 0) {
                rt_pushb(acc, 46);
            }
            rt_pushb(acc, rt_atb(text, i));
            i += 1;
        }
    }
    rt_drop_seq(text);
    rt_free(q);
    return 0;
}
fn rt_print_acc(acc: u64, newline: u64) -> u64 {
    if newline {
        rt_pushb(acc, 10);
    }
    n := rt_len(acc);
    packed := rt_pack(acc);
    if rt_write_all(1, packed, n) != 0 {
        rt_abort();
    }
    rt_free(packed);
    rt_drop_seq(acc);
    return 0;
}

// Ends the whole process immediately with the given status (no cleanup runs).
fn f_host_exit(code: u64) -> u64 {
    rt_prof_dump();
    rt_syscall(231, code & 255, 0, 0);
    return 0;
}

// Formats a value word according to an element code (see element_code in the compiler).
fn rt_fmt_value(acc: u64, v: u64, code: u64) -> u64 {
    if code == 1 {
        return rt_fmt_num(acc, v);
    }
    if code == 2 {
        return rt_fmt_bool(acc, v);
    }
    if code == 3 {
        start := rt_len(acc);
        rt_fmt_f64(acc, v);
        mut plain = 1;
        mut i = start;
        n := rt_len(acc);
        while i < n {
            b := rt_atb(acc, i);
            if (b == 46) + (b == 101) + (b == 110) + (b == 78) {
                plain = 0;
            }
            i += 1;
        }
        if plain {
            rt_pushb(acc, 46);
            rt_pushb(acc, 48);
        }
        return 0;
    } // like Rust's {:?}: 2.0, not 2
    if code == 4 {
        rt_pushb(acc, 34);
        rt_fmt_seq(acc, v);
        rt_pushb(acc, 34);
        return 0;
    }
    if code == 6 {
        rt_pushb(acc, 39);
        rt_push_utf8(acc, v);
        rt_pushb(acc, 39);
        return 0;
    } // char, like {:?}
    if code == 7 {
        start := rt_len(acc);
        rt_fmt_f32(acc, v);
        mut plain = 1;
        mut i = start;
        n := rt_len(acc);
        while i < n {
            b := rt_atb(acc, i);
            if (b == 46) + (b == 101) + (b == 110) + (b == 78) {
                plain = 0;
            }
            i += 1;
        }
        if plain {
            rt_pushb(acc, 46);
            rt_pushb(acc, 48);
        }
        return 0;
    }
    if (code & 4095) == 5 {
        inner := rt_div(code, 4096);
        n := rt_len(v);
        rt_pushb(acc, 91);
        mut i = 0;
        while i < n {
            if i != 0 {
                rt_pushb(acc, 44);
                rt_pushb(acc, 32);
            }
            rt_fmt_value(acc, rt_at(v, i), inner);
            i += 1;
        }
        rt_pushb(acc, 93);
        return 0;
    }
    if (code & 4095) == 8 {
        inner := rt_div(code, 4096);
        n := rt_len(v);
        rt_pushb(acc, 91);
        mut i = 0;
        while i < n {
            if i != 0 {
                rt_pushb(acc, 44);
                rt_pushb(acc, 32);
            }
            rt_fmt_value(acc, rt_narrow_decode(rt_at4(v, i), inner), inner);
            i += 1;
        }
        rt_pushb(acc, 93);
        return 0;
    }
    if 1023 < code {
        return rt_fmt_int(acc, v, code - 1024);
    }
    rt_abort();
    return 0;
}

// Removes a file (directory==0) or an empty directory; 0 or a positive errno.
fn f_host_remove(path: u64, directory: u64) -> u64 {
    name := rt_cstr(path);
    rt_free(path);
    if name == 0 {
        return 22;
    }
    mut flags = 0;
    if directory {
        flags = 512;
    }
    r := rt_syscall(263, wrapping_sub(0, 100), name, flags);
    rt_free(name);
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
}
// Creates a directory; 0 or a positive errno (17 when it already exists).
fn f_host_create_dir(path: u64) -> u64 {
    name := rt_cstr(path);
    rt_free(path);
    if name == 0 {
        return 22;
    }
    r := rt_syscall(258, wrapping_sub(0, 100), name, 493);
    rt_free(name);
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
}

// Appends tmp to acc padded to `width` characters (UTF-8 aware); align 1 left, 2 right, 3 center.
// Zero padding goes after a leading minus sign, as in Rust.
fn rt_fmt_pad(acc: u64, tmp: u64, width: u64, align: u64, zero: u64, fill: u64) -> u64 {
    n := rt_len(tmp);
    mut chars = 0;
    mut i = 0;
    while i < n {
        if (rt_atb(tmp, i) & 192) != 128 {
            chars += 1;
        }
        i += 1;
    }
    mut pad = 0;
    if chars < width {
        pad = width - chars;
    }
    if zero {
        i = 0;
        if n != 0 {
            if rt_atb(tmp, 0) == 45 {
                rt_pushb(acc, 45);
                i = 1;
            }
        }
        mut k = 0;
        while k < pad {
            rt_pushb(acc, 48);
            k += 1;
        }
        while i < n {
            rt_pushb(acc, rt_atb(tmp, i));
            i += 1;
        }
        rt_drop_seq(tmp);
        return 0;
    }
    mut before = 0;
    if align == 2 {
        before = pad;
    }
    if align == 3 {
        before = rt_div(pad, 2);
    }
    after := pad - before;
    mut k = 0;
    while k < before {
        rt_push_char(acc, fill);
        k += 1;
    }
    i = 0;
    while i < n {
        rt_pushb(acc, rt_atb(tmp, i));
        i += 1;
    }
    k = 0;
    while k < after {
        rt_push_char(acc, fill);
        k += 1;
    }
    rt_drop_seq(tmp);
    return 0;
}
fn rt_push_char(acc: u64, b: u64) -> u64 {
    rt_pushb(acc, b);
    return 0;
}

// Byte-lexicographic comparison of two byte sequences / strings / views (op as in rt_int).
fn rt_seq_cmp(op: u64, a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    mut i = 0;
    mut order = 1; // 0 less, 1 equal, 2 greater
    while (i < n) & (i < m) {
        x := rt_atb(a, i);
        y := rt_atb(b, i);
        if x != y {
            if x < y {
                order = 0;
            } else {
                order = 2;
            }
            break;
        }
        i += 1;
    }
    if order == 1 {
        if n < m {
            order = 0;
        }
        if m < n {
            order = 2;
        }
    }
    if op == 258 {
        return order == 1;
    }
    if op == 259 {
        return order != 1;
    }
    if op == 60 {
        return order == 0;
    }
    if op == 62 {
        return order == 2;
    }
    if op == 269 {
        return order != 2;
    }
    if op == 270 {
        return order != 0;
    }
    rt_abort();
    return 0;
}
// Element-wise comparison of word vectors (u64[], sized integers, bool).
fn rt_vec_cmp(op: u64, a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    mut i = 0;
    mut order = 1; // 0 less, 1 equal, 2 greater
    while (i < n) & (i < m) {
        x := rt_at(a, i);
        y := rt_at(b, i);
        if x != y {
            if x < y {
                order = 0;
            } else {
                order = 2;
            }
            break;
        }
        i += 1;
    }
    if order == 1 {
        if n < m {
            order = 0;
        }
        if m < n {
            order = 2;
        }
    }
    return rt_order_result(op, order);
}
// The comparison `op` (== != < > <= >=) given an ordering 0 less, 1 equal, 2 greater.
fn rt_order_result(op: u64, order: u64) -> u64 {
    if op == 258 {
        return order == 1;
    }
    if op == 259 {
        return order != 1;
    }
    if op == 60 {
        return order == 0;
    }
    if op == 62 {
        return order == 2;
    }
    if op == 269 {
        return order != 2;
    }
    if op == 270 {
        return order != 0;
    }
    rt_abort();
    return 0;
}
fn rt_concat(a: u64, b: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    mut i = 0;
    while i < n {
        rt_pushb(out, rt_atb(a, i));
        i += 1;
    }
    m := rt_len(b);
    i = 0;
    while i < m {
        rt_pushb(out, rt_atb(b, i));
        i += 1;
    }
    return out;
}
fn rt_concat_text(a: u64, b: u64) -> u64 {
    out := rt_concat(a, b);
    rt_utf8(out);
    return out;
}

// ---- built-in text methods ----
fn rt_seq_match(a: u64, at: u64, b: u64) -> u64 {
    m := rt_len(b);
    if rt_len(a) < at + m {
        return 0;
    }
    mut j = 0;
    while j < m {
        if rt_atb(a, at + j) != rt_atb(b, j) {
            return 0;
        }
        j += 1;
    }
    return 1;
}
fn rt_seq_contains(a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    if n < m {
        return 0;
    }
    mut i = 0;
    while i < n - m + 1 {
        if rt_seq_match(a, i, b) {
            return 1;
        }
        i += 1;
    }
    return 0;
}
fn rt_seq_starts(a: u64, b: u64) -> u64 {
    return rt_seq_match(a, 0, b);
}
fn rt_seq_ends(a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    if n < m {
        return 0;
    }
    return rt_seq_match(a, n - m, b);
}
// Case mapping for ASCII, Latin-1, Latin Extended-A, Greek and Cyrillic (simple 1:1 mappings;
// other scripts and special cases like German sharp s are left unchanged).
fn rt_case_map(cp: u64, upper: u64) -> u64 {
    if upper {
        if cp == 940 {
            return 902;
        }
        if cp == 941 {
            return 904;
        }
        if cp == 942 {
            return 905;
        }
        if cp == 943 {
            return 906;
        }
        if cp == 972 {
            return 908;
        }
        if cp == 973 {
            return 910;
        }
        if cp == 974 {
            return 911;
        }
        if (96 < cp) & (cp < 123) {
            return cp - 32;
        }
        if ((223 < cp) & (cp < 255) & (cp != 247)) {
            return cp - 32;
        }
        if cp == 255 {
            return 376;
        }
        if (255 < cp) & (cp < 384) {
            if (cp < 311) + ((312 < cp) & (cp < 329)) + (329 < cp) {
                if ((cp < 311) + (329 < cp)) & ((cp & 1) == 1) & (cp != 305) & (cp != 383) {
                    return cp - 1;
                }
                if (312 < cp) & (cp < 329) & ((cp & 1) == 0) {
                    return cp - 1;
                }
            }
        }
        if (944 < cp) & (cp < 970) & (cp != 962) {
            return cp - 32;
        }
        if cp == 962 {
            return 931;
        }
        if (1071 < cp) & (cp < 1104) {
            return cp - 32;
        }
        if (1103 < cp) & (cp < 1120) {
            return cp - 80;
        }
        return cp;
    }
    if cp == 902 {
        return 940;
    }
    if cp == 904 {
        return 941;
    }
    if cp == 905 {
        return 942;
    }
    if cp == 906 {
        return 943;
    }
    if cp == 908 {
        return 972;
    }
    if cp == 910 {
        return 973;
    }
    if cp == 911 {
        return 974;
    }
    if (64 < cp) & (cp < 91) {
        return cp + 32;
    }
    if ((191 < cp) & (cp < 223) & (cp != 215)) {
        return cp + 32;
    }
    if cp == 376 {
        return 255;
    }
    if (255 < cp) & (cp < 384) {
        if ((cp < 311) + (329 < cp)) & ((cp & 1) == 0) & (cp != 304) & (cp != 382) {
            return cp + 1;
        }
        if (312 < cp) & (cp < 329) & ((cp & 1) == 1) {
            return cp + 1;
        }
    }
    if (912 < cp) & (cp < 940) & (cp != 930) {
        return cp + 32;
    }
    if (1039 < cp) & (cp < 1072) {
        return cp + 32;
    }
    if (1023 < cp) & (cp < 1040) {
        return cp + 80;
    }
    return cp;
}
fn rt_push_utf8(out: u64, v: u64) -> u64 {
    if v < 128 {
        rt_pushb(out, v);
        return 0;
    }
    if v < 2048 {
        rt_pushb(out, 192 + rt_div(v, 64));
        rt_pushb(out, 128 + v % 64);
        return 0;
    }
    if v < 65536 {
        rt_pushb(out, 224 + rt_div(v, 4096));
        rt_pushb(out, 128 + rt_div(v, 64) % 64);
        rt_pushb(out, 128 + v % 64);
        return 0;
    }
    rt_pushb(out, 240 + rt_div(v, 262144));
    rt_pushb(out, 128 + rt_div(v, 4096) % 64);
    rt_pushb(out, 128 + rt_div(v, 64) % 64);
    rt_pushb(out, 128 + v % 64);
    return 0;
}
fn rt_seq_case(a: u64, upper: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    mut i = 0;
    while i < n {
        b := rt_atb(a, i);
        if b < 128 {
            rt_pushb(out, rt_case_map(b, upper));
            i += 1;
        } else {
            if ((b & 224) == 192) & (i + 1 < n) {
                c1 := rt_atb(a, i + 1);
                if (c1 & 192) == 128 {
                    rt_push_utf8(out, rt_case_map((b & 31) * 64 + (c1 & 63), upper));
                    i += 2;
                } else {
                    rt_pushb(out, b);
                    i += 1;
                }
            } else {
                rt_pushb(out, b);
                i += 1;
            }
        }
    }
    return out;
}
fn rt_seq_upper(a: u64) -> u64 {
    return rt_seq_case(a, 1);
}
fn rt_seq_lower(a: u64) -> u64 {
    return rt_seq_case(a, 0);
}
fn rt_space(b: u64) -> u64 {
    return (b == 32) + (b == 9) + (b == 10) + (b == 13);
}
fn rt_seq_trim(a: u64) -> u64 {
    mut start = 0;
    mut end = rt_len(a);
    while start < end {
        if rt_space(rt_atb(a, start)) == 0 {
            break;
        }
        start += 1;
    }
    while start < end {
        if rt_space(rt_atb(a, end - 1)) == 0 {
            break;
        }
        end -= 1;
    }
    out := rt_new();
    mut i = start;
    while i < end {
        rt_pushb(out, rt_atb(a, i));
        i += 1;
    }
    return out;
}
fn rt_seq_replace(a: u64, from: u64, to: u64, valid: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    m := rt_len(from);
    t := rt_len(to);
    mut i = 0;
    while i < n {
        if (m != 0) & rt_seq_match(a, i, from) {
            mut j = 0;
            while j < t {
                rt_pushb(out, rt_atb(to, j));
                j += 1;
            }
            i += m;
        } else {
            rt_pushb(out, rt_atb(a, i));
            i += 1;
        }
    }
    if valid {
        rt_utf8(out);
    }
    return out;
}
fn rt_seq_repeat(a: u64, count: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    mut k = 0;
    while k < count {
        mut i = 0;
        while i < n {
            rt_pushb(out, rt_atb(a, i));
            i += 1;
        }
        k += 1;
    }
    return out;
}
// Splits on one byte; every field is kept (empty ones too), like Rust's split(char).
fn rt_seq_split(a: u64, sep: u64, valid: u64) -> u64 {
    parts := rt_new();
    mut cur = rt_new();
    n := rt_len(a);
    mut i = 0;
    while i < n {
        b := rt_atb(a, i);
        if b == sep {
            if valid {
                rt_utf8(cur);
            }
            rt_push(parts, cur);
            cur = rt_new();
        } else {
            rt_pushb(cur, b);
        }
        i += 1;
    }
    if valid {
        rt_utf8(cur);
    }
    rt_push(parts, cur);
    return parts;
}

// ---- narrow vectors: f32[], u32[], i32[] store 4-byte elements ----
// Each element is one 32-bit little-endian unit, reached with a single raw_load32/raw_store32 (a
// zero-extending load and a 32-bit store on every target).
// The compiler encodes each value before it reaches these routines (an f32 as its binary32 bits;
// an integer's low 32 bits are stored) and decodes what they return, so they only move 32-bit units.
// len and cap count elements. Ordering and equality compare the 32-bit units unsigned, which orders
// exactly as the words the same values occupy in a word vector.
fn rt_push4(s: u64, v: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    cap := raw_load(wrapping_add(s, 16));
    if n == cap {
        mut capacity = cap * 2;
        if capacity == 0 {
            capacity = 8;
        }
        if 288230376151711744 < capacity {
            rt_abort();
        }
        ptr := rt_grow(raw_load(s), n * 4, capacity * 4);
        raw_store(s, ptr);
        raw_store(wrapping_add(s, 16), capacity);
    }
    raw_store32(wrapping_add(raw_load(s), wrapping_mul(n, 4)), v);
    raw_store(wrapping_add(s, 8), n + 1);
    return 0;
}
fn rt_fill4(s: u64, v: u64, n: u64) -> u64 {
    if 288230376151711744 < n {
        rt_abort();
    }
    if n != 0 {
        ptr := rt_grow(raw_load(s), 0, n * 4);
        raw_store(s, ptr);
        raw_store(wrapping_add(s, 16), n);
    }
    mut i: u64 = 0;
    while i < n {
        raw_store32(wrapping_add(raw_load(s), wrapping_mul(i, 4)), v);
        i = i + 1;
    }
    raw_store(wrapping_add(s, 8), n);
    return 0;
}
fn rt_slot4u(s: u64, i: u64) -> u64 {
    return wrapping_add(raw_load(s), wrapping_mul(i, 4));
}
fn rt_slot4(s: u64, i: u64) -> u64 {
    if (i < raw_load(wrapping_add(s, 8))) == 0 {
        rt_abort();
    }
    return wrapping_add(raw_load(s), wrapping_mul(i, 4));
}
fn rt_at4u(s: u64, i: u64) -> u64 {
    return raw_load32(wrapping_add(raw_load(s), wrapping_mul(i, 4)));
}
fn rt_at4(s: u64, i: u64) -> u64 {
    return raw_load32(rt_slot4(s, i));
}
fn rt_set4(s: u64, i: u64, v: u64) -> u64 {
    raw_store32(wrapping_add(raw_load(s), wrapping_mul(i, 4)), v);
    return 0;
}
fn rt_pop4(s: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    if n == 0 {
        rt_abort();
    }
    v := raw_load32(wrapping_add(raw_load(s), wrapping_mul(n - 1, 4)));
    raw_store(wrapping_add(s, 8), n - 1);
    return v;
}
fn rt_vec_copy4(src: u64) -> u64 {
    dst := rt_new();
    n := raw_load(src + 8);
    mut i = 0;
    while i < n {
        rt_push4(dst, raw_load32(raw_load(src) + i * 4));
        i = i + 1;
    }
    return dst;
}
fn rt_vec_insert4(s: u64, index: u64, v: u64) -> u64 {
    n := rt_len(s);
    if n < index {
        rt_abort();
    }
    rt_push4(s, 0);
    mut i = n;
    while index < i {
        rt_set4(s, i, rt_at4(s, i - 1));
        i -= 1;
    }
    rt_set4(s, index, v);
    return 0;
}
fn rt_vec_remove4(s: u64, index: u64) -> u64 {
    n := rt_len(s);
    if (index < n) == 0 {
        rt_abort();
    }
    v := rt_at4(s, index);
    mut i = index;
    while i + 1 < n {
        rt_set4(s, i, rt_at4(s, i + 1));
        i += 1;
    }
    rt_pop4(s);
    return v;
}
fn rt_vec_swap4(s: u64, i: u64, j: u64) -> u64 {
    n := rt_len(s);
    if ((i < n) == 0) + ((j < n) == 0) {
        rt_abort();
    }
    a := rt_at4(s, i);
    rt_set4(s, i, rt_at4(s, j));
    rt_set4(s, j, a);
    return 0;
}
fn rt_vec_reverse4(s: u64) -> u64 {
    n := rt_len(s);
    mut i = 0;
    while i < rt_div(n, 2) {
        rt_vec_swap4(s, i, n - 1 - i);
        i += 1;
    }
    return 0;
}
fn rt_vec_truncate4(s: u64, keep: u64) -> u64 {
    if keep < rt_len(s) {
        raw_store(wrapping_add(s, 8), keep);
    }
    return 0;
}
fn rt_vec_contains4(s: u64, v: u64) -> u64 {
    n := rt_len(s);
    want := v & 4294967295;
    mut i = 0;
    while i < n {
        if rt_at4(s, i) == want {
            return 1;
        }
        i += 1;
    }
    return 0;
}
// A 4-byte element as the word Grail holds, given its element code: f32 (7) widened, a signed
// integer (int code bit 8) sign-extended, an unsigned one as is.
fn rt_narrow_decode(unit: u64, code: u64) -> u64 {
    if code == 7 {
        return rt_f32_from_bits(unit);
    }
    if (1023 < code) & (((code - 1024) & 256) != 0) {
        if (unit & 2147483648) != 0 {
            return unit | 18446744069414584320;
        }
    }
    return unit;
}
// Element-wise float equality of two vectors or slices (narrow: 4-byte f32 units).
fn rt_vec_feq(a: u64, b: u64, narrow: u64) -> u64 {
    n := rt_len(a);
    if n != rt_len(b) {
        return 0;
    }
    mut i = 0;
    while i < n {
        mut x = 0;
        mut y = 0;
        if narrow {
            x = rt_f32_from_bits(rt_at4(a, i));
            y = rt_f32_from_bits(rt_at4(b, i));
        } else {
            x = rt_at(a, i);
            y = rt_at(b, i);
        }
        if raw_feq(x, y) == 0 {
            return 0;
        }
        i += 1;
    }
    return 1;
}
fn rt_vec_cmp4(op: u64, a: u64, b: u64) -> u64 {
    n := rt_len(a);
    m := rt_len(b);
    mut i = 0;
    mut order = 1; // 0 less, 1 equal, 2 greater
    while (i < n) & (i < m) {
        x := rt_at4(a, i);
        y := rt_at4(b, i);
        if x != y {
            if x < y {
                order = 0;
            } else {
                order = 2;
            }
            break;
        }
        i += 1;
    }
    if order == 1 {
        if n < m {
            order = 0;
        }
        if m < n {
            order = 2;
        }
    }
    return rt_order_result(op, order);
}
// ---- vector methods (elements are words: values or owning pointers; nothing is copied) ----
fn rt_vec_set(s: u64, i: u64, v: u64) -> u64 {
    raw_store(wrapping_add(raw_load(s), wrapping_mul(i, 8)), v);
    return 0;
}
fn rt_vec_insert(s: u64, index: u64, v: u64) -> u64 {
    n := rt_len(s);
    if n < index {
        rt_abort();
    }
    rt_push(s, 0);
    mut i = n;
    while index < i {
        rt_vec_set(s, i, rt_at(s, i - 1));
        i -= 1;
    }
    rt_vec_set(s, index, v);
    return 0;
}
fn rt_vec_remove(s: u64, index: u64) -> u64 {
    n := rt_len(s);
    if (index < n) == 0 {
        rt_abort();
    }
    v := rt_at(s, index);
    mut i = index;
    while i + 1 < n {
        rt_vec_set(s, i, rt_at(s, i + 1));
        i += 1;
    }
    rt_pop(s);
    return v;
}
fn rt_vec_swap(s: u64, i: u64, j: u64) -> u64 {
    n := rt_len(s);
    if ((i < n) == 0) + ((j < n) == 0) {
        rt_abort();
    }
    a := rt_at(s, i);
    rt_vec_set(s, i, rt_at(s, j));
    rt_vec_set(s, j, a);
    return 0;
}
fn rt_vec_reverse(s: u64) -> u64 {
    n := rt_len(s);
    mut i = 0;
    while i < rt_div(n, 2) {
        rt_vec_swap(s, i, n - 1 - i);
        i += 1;
    }
    return 0;
}
fn rt_vec_truncate(s: u64, keep: u64, dropper: u64) -> u64 {
    while keep < rt_len(s) {
        v := rt_pop(s);
        if dropper != 0 {
            raw_call2(dropper, v, 0);
        }
    }
    return 0;
}
fn rt_vec_contains(s: u64, v: u64) -> u64 {
    n := rt_len(s);
    mut i = 0;
    while i < n {
        if rt_at(s, i) == v {
            return 1;
        }
        i += 1;
    }
    return 0;
}

// ---- sampling profiler (Linux x86-64) -------------------------------------------------------
// `grail profile` writes .grail-profile/config in the working directory and runs the target there.
// The runtime reads that file during startup (rt_thread_init), samples the interrupted instruction
// pointer from an ITIMER_PROF/SIGPROF timer and writes the raw addresses to the path named in the
// config when the process ends. The handler never allocates, never takes the allocator lock and
// never calls the kernel: it claims a slot with a CAS loop and stores one word, so a signal that
// interrupts the allocator cannot deadlock against it.
//
// Process-state words (rt_state is 4096 bytes; these sit between the allocator's last bin word and
// the Windows-only thread-bridge word at 3392):
//   2048 control page pointer  (0 = not profiled; the only word the handler reads)
//   2080 ".grail-profile/config" (NUL terminated, 64 bytes)
//   2176 sample path           (NUL terminated, 96 bytes, copied from the config)
//   2272 itimerval             (32 bytes: interval then value, seconds then microseconds)
//   2304 sigaction             (32 bytes: handler, flags, restorer, mask)
//   2336 sigaltstack           (24 bytes: stack pointer, flags, size)
//   2400 config text scratch   (256 bytes, startup only)
//   2656 timespec             (16 bytes: CLOCK_PROCESS_CPUTIME_ID at arm and at exit)
//
// The control page is the first 4096 bytes of the sample mapping:
//   0 magic  8 sample base  16 capacity  24 claimed  32 dropped  40 rate  48 cpu start (ns)
fn rt_prof_words() -> u64 {
    return raw_state() + 2048;
}
fn rt_prof_page() -> u64 {
    return raw_load(raw_state() + 2048);
}
// One slot per sample: index = CAS-claimed counter, payload = interrupted instruction pointer.
fn rt_prof_handler(sig: u64, info: u64, ctx: u64) -> u64 {
    page := rt_prof_page();
    if page == 0 {
        return 0;
    }
    i := rt_atomic_fetch_add(page + 24, 1);
    if i < raw_load(page + 16) {
        // The kernel's rt_sigframe keeps the ucontext at a fixed offset from the third handler
        // argument; RIP is gregs[16] inside its sigcontext, 40 + 16 * 8.
        raw_store(raw_load(page + 8) + i * 8, raw_load(ctx + 168));
    } else {
        rt_atomic_fetch_add(page + 32, 1);
    }
    return 0;
}
fn rt_prof_config_path(dst: u64) -> u64 {
    // ".grail-profile/config", NUL terminated, as three little-endian words.
    raw_store(dst, 8083236106062161710);
    raw_store(dst + 8, 7147042649959460722);
    raw_store(dst + 16, 444149952111);
    return dst + 22;
}
// First byte of the next space-separated token at or after `at`; `n` at end of line.
fn rt_prof_token(buf: u64, n: u64, at: u64) -> u64 {
    mut i = at;
    while i < n {
        c := raw_byte(buf + i);
        if c == 10 {
            return n;
        }
        if (c == 32) || (c == 9) || (c == 13) {
            i = i + 1;
        } else {
            return i;
        }
    }
    return n;
}
fn rt_prof_end(buf: u64, n: u64, at: u64) -> u64 {
    mut i = at;
    while i < n {
        c := raw_byte(buf + i);
        if (c < 48) || (57 < c) {
            return i;
        }
        i = i + 1;
    }
    return i;
}
fn rt_prof_num(buf: u64, n: u64, at: u64) -> u64 {
    mut i = at;
    mut value = 0;
    while i < n {
        c := raw_byte(buf + i);
        if (c < 48) || (57 < c) {
            break;
        }
        value = value * 10 + (c - 48);
        i = i + 1;
    }
    return value;
}
// Arms sampling from .grail-profile/config when that file exists and this is Linux x86-64.
fn rt_prof_start() -> u64 {
    if raw_target() != 0 {
        return 0;
    }
    words := rt_prof_words();
    if raw_load(words) != 0 {
        return 0;
    }
    rt_prof_config_path(words + 32);
    fd := rt_syscall(2, words + 32, 524288, 0);
    if rt_error(fd) {
        return 0;
    }
    text := words + 352;
    n := rt_syscall(0, fd, text, 256);
    rt_syscall(3, fd, 0, 0);
    // One shot: the first Grail process that starts here consumes the arming request, so a stale
    // file from a killed run cannot make later unrelated runs sample themselves.
    rt_syscall(263, wrapping_sub(0, 100), words + 32, 0);
    if rt_error(n) {
        return 0;
    }
    // "1 RATE CAPACITY PATH": the format version, the sampling rate in Hz, the sample capacity and
    // the file the raw addresses go to. The CLI writes it; a hand-written file is accepted too.
    v := rt_prof_token(text, n, 0);
    if rt_prof_num(text, n, v) != 1 {
        return 0;
    }
    mut r = rt_prof_end(text, n, v);
    mut rate = rt_prof_num(text, n, rt_prof_token(text, n, r));
    r = rt_prof_end(text, n, rt_prof_token(text, n, r));
    mut cap = rt_prof_num(text, n, rt_prof_token(text, n, r));
    r = rt_prof_end(text, n, rt_prof_token(text, n, r));
    path := rt_prof_token(text, n, r);
    if (rate == 0) || (cap == 0) || (path == n) {
        return 0;
    }
    if 1000000 < rate {
        rate = 1000000;
    }
    if 1048576 < cap {
        cap = 1048576;
    }
    mut used = 0;
    while path + used < n {
        c := raw_byte(text + path + used);
        if c == 10 {
            break;
        }
        if 95 < used {
            return 0;
        }
        raw_putbyte(words + 128 + used, c);
        used = used + 1;
    }
    raw_putbyte(words + 128 + used, 0);
    page := raw_map(4096 + cap * 8);
    if rt_error(page) {
        return 0;
    }
    stack := raw_map(65536);
    if rt_error(stack) {
        return 0;
    }
    code := raw_map(4096);
    if rt_error(code) {
        return 0;
    }
    // The restorer the kernel returns through: movl $__NR_rt_sigreturn,%eax; syscall; ud2.
    raw_store(code, 1082287778126892984);
    raw_putbyte(code + 8, 11);
    if rt_error(raw_syscall4(10, code, 4096, 5, 0)) {
        return 0;
    }
    raw_store(words + 288, stack);
    raw_store(words + 296, 0);
    raw_store(words + 304, 65536);
    if rt_error(raw_syscall4(131, words + 288, 0, 0, 0)) {
        return 0;
    }
    sa := words + 256;
    raw_store(sa, rt_prof_handler);
    // SA_ONSTACK | SA_RESTORER | SA_RESTART | SA_SIGINFO
    raw_store(sa + 8, 469762052);
    raw_store(sa + 16, code);
    raw_store(sa + 24, 0);
    if rt_error(raw_syscall4(13, 27, sa, 0, 8)) {
        return 0;
    }
    raw_store(page, 1347569201);
    raw_store(page + 8, page + 4096);
    raw_store(page + 16, cap);
    raw_store(page + 24, 0);
    raw_store(page + 32, 0);
    raw_store(page + 40, rate);
    ts := words + 608;
    if rt_error(rt_syscall(228, 2, ts, 0)) {
        raw_store(page + 48, 0);
    } else {
        raw_store(page + 48, raw_load(ts) * 1000000000 + raw_load(ts + 8));
    }
    raw_store(words, page);
    // ITIMER_PROF counts CPU time, so blocked programs do not accumulate samples. One tick interval
    // and one first tick: seconds stay zero because the rate is clamped to at most one per
    // microsecond.
    mut usec = rt_div(1000000, rate);
    if usec == 0 {
        usec = 1;
    }
    raw_store(words + 224, 0);
    raw_store(words + 232, usec);
    raw_store(words + 240, 0);
    raw_store(words + 248, usec);
    raw_syscall(38, 2, words + 224, 0);
    return 0;
}
// Stops the timer and writes the header plus the sampled addresses. Safe to call twice.
fn rt_prof_dump() -> u64 {
    if raw_target() != 0 {
        return 0;
    }
    words := rt_prof_words();
    page := raw_load(words);
    if page == 0 {
        return 0;
    }
    raw_store(words, 0);
    raw_store(words + 224, 0);
    raw_store(words + 232, 0);
    raw_store(words + 240, 0);
    raw_store(words + 248, 0);
    raw_syscall(38, 2, words + 224, 0);
    cap := raw_load(page + 16);
    mut count = raw_atomic_load(page + 24);
    if cap < count {
        count = cap;
    }
    fd := rt_syscall(2, words + 128, 524865, 438);
    if rt_error(fd) {
        return 0;
    }
    // "GRPROF2\n" then rate, capacity, count, dropped and the CPU nanoseconds the samples cover:
    // the rate a caller asks for is capped by the kernel's timer granularity, so the report derives
    // the effective rate from this measurement instead of assuming the request was honoured.
    h := words + 352;
    raw_store(h, 734726995712168519);
    raw_store(h + 8, raw_load(page + 40));
    raw_store(h + 16, cap);
    raw_store(h + 24, count);
    raw_store(h + 32, raw_atomic_load(page + 32));
    mut cpu = 0;
    ts := words + 608;
    if rt_error(rt_syscall(228, 2, ts, 0)) == 0 {
        cpu = raw_load(ts) * 1000000000 + raw_load(ts + 8) - raw_load(page + 48);
    }
    raw_store(h + 40, cpu);
    if rt_write_all(fd, h, 48) == 0 {
        rt_write_all(fd, raw_load(page + 8), count * 8);
    }
    rt_syscall(3, fd, 0, 0);
    return 0;
}
