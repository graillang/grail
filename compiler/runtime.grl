    return wrapping_add(raw_load(s), i);
}
fn rt_atbu(s: u64, i: u64) -> u64 {
    return raw_byte(wrapping_add(raw_load(s), i));
}
fn rt_atb(s: u64, i: u64) -> u64 {
    if (i < raw_load(wrapping_add(s, 8))) == 0 {
        rt_fail(1, i, raw_load(wrapping_add(s, 8)));
    }
    return raw_byte(wrapping_add(raw_load(s), i));
}
fn rt_pop(s: u64) -> u64 {
