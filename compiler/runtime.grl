            i += m;
        } else {
            rt_pushb(out, rt_atb(a, i));
            i += 1;
        }
    }
    if valid {
        rt_utf8(out);
    }
    return out;
}
fn rt_seq_repeat(a: u64, count: u64) -> u64 {
    out := rt_new();
    n := rt_len(a);
    mut k = 0;
    while k < count {
        mut i = 0;
        while i < n {
            rt_pushb(out, rt_atb(a, i));
            i += 1;
        }
        k += 1;
    }
    return out;
}
