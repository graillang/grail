    raw_putbyte(wrapping_add(raw_load(s), n), v & 255);
    raw_store(wrapping_add(s, 8), wrapping_add(n, 1));
    return 0;
}
fn rt_pushb_slow(s: u64, v: u64) -> u64 {
    n := raw_load(wrapping_add(s, 8));
    cap := raw_load(wrapping_add(s, 16));
    if n == cap {
        rt_reserveb(s, n + 1);
    }
    raw_putbyte(wrapping_add(raw_load(s), n), v & 255);
    raw_store(wrapping_add(s, 8), n + 1);
    return 0;
}
// `bytes.push(v)` from user code: stops the program when v does not fit a byte.
fn rt_pushb_checked(s: u64, v: u64) -> u64 {
    if 255 < v {
        rt_abort();
