    if (a != 0) & (b != 0) {
        code = rt_symlink(a, b);
    }
    if a != 0 {
        rt_free(a);
    }
    if b != 0 {
        rt_free(b);
    }
    return code;
}
// Sets the permission bits of `path` to `mode`; 0 or a positive errno. The view belongs to this
// function, as with every other host operation.
fn f_host_chmod(path: u64, mode: u64) -> u64 {
    a := rt_cstr(path);
    rt_view_free(path);
    if a == 0 {
        return 22;
    }
    code := rt_chmod(a, mode);
    rt_free(a);
    return code;
}
