        if low & (high == 0) {
            rt_push(digits, d);
            break;
        }
        if high & (low == 0) {
            rt_push(digits, d + 1);
            break;
        }
        rt_big_add(t, r, r);
        if rt_big_cmp(t, s) == 0 {
            rt_push(digits, d);
        } else {
            rt_push(digits, d + 1);
        }
        break;
    }
    n := rt_len(digits);
    if kneg + (k == 0) {
        rt_pushb(acc, 48);
        rt_pushb(acc, 46);
        mut z = 0;
        if kneg {
            z = k;
        }
        mut i = 0;
        while i < z {
            rt_pushb(acc, 48);
            i += 1;
        }
        i = 0;
        while i < n {
            rt_pushb(acc, 48 + rt_at(digits, i));
            i += 1;
        }
    } else {
        mut i = 0;
        while i < n {
            if i == k {
                rt_pushb(acc, 46);
            }
            rt_pushb(acc, 48 + rt_at(digits, i));
            i += 1;
        }
        while i < k {
            rt_pushb(acc, 48);
            i += 1;
        }
    }
    rt_drop_seq(digits);
    rt_free(r);
    rt_free(s);
    rt_free(mp);
    rt_free(mm);
    rt_free(t);
    return 0;
}
fn rt_print_f64(v: u64, newline: u64) -> u64 {
    acc := rt_new();
    rt_fmt_f64(acc, v);
    if newline {
        rt_pushb(acc, 10);
    }
    n := rt_len(acc);
    packed := rt_pack(acc);
    if rt_write_all(1, packed, n) != 0 {
        rt_abort();
    }
    rt_free(packed);
    rt_drop_seq(acc);
    return 0;
}

// ---- f32: binary32 values carried as the binary64 with the same value ----
// Round to the nearest binary32 (ties to even; overflow gives infinity). Arithmetic computes in
// binary64 and rounds once: for + - * / and sqrt that equals the correctly rounded binary32.
fn rt_f32_round(v: u64) -> u64 {
    sign := v & 9223372036854775808;
    e := rt_div(v, 4503599627370496) & 2047;
    if e == 2047 {
        return v;
