        negative = 1;
        x = wrapping_sub(0, v);
    }
    // Halve below 2^53 with a sticky low bit, convert exactly, rescale, then round once.
    mut s = 0;
    while 9007199254740991 < x {
        lost := x & 1;
        x = rt_div(x, 2);
        if lost {
            x = x | 1;
        }
        s += 1;
    }
    mut f = raw_f64_from_i64(x);
    if (s != 0) & (x != 0) {
        f = f + s * 4503599627370496;
    }
    out := rt_f32_round(f);
    if negative {
        return rt_f64_neg(out);
    }
    return out;
}
// Shortest decimal digits that read back to the same binary32 (like Rust's Display for f32).
fn rt_fmt_f32(acc: u64, v: u64) -> u64 {
