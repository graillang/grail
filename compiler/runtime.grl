// Directory entries without "." and ".."; directories get a trailing "/". Empty if unreadable.
fn f_host_list_dir(path: u64) -> u64 {
    out := rt_new();
    name := rt_cstr(path);
    rt_free(path);
    if name == 0 {
        return out;
    }
    // O_RDONLY|O_CLOEXEC only: O_DIRECTORY has different values per architecture (AArch64: 0x4000).
    fd := rt_syscall(2, name, 524288, 0);
    rt_free(name);
    if rt_error(fd) {
        return out;
    }
    buf := rt_alloc(8192);
    while true {
        n := rt_syscall(217, fd, buf, 8192);
        if (n == 0) + rt_error(n) {
            break;
        }
        mut at = 0;
