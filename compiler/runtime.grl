    n := rt_len(text);
    if n < digits + 1 {
        mut z = digits + 1 - n;
        rt_pushb(acc, 48);
        if digits {
            rt_pushb(acc, 46);
        }
        z -= 1;
        while 0 < z {
            rt_pushb(acc, 48);
            z -= 1;
        }
        i = 0;
        while i < n {
            rt_pushb(acc, rt_atb(text, i));
            i += 1;
        }
