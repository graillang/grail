module ir;
use llvm;

// The typed IR of the word stream: instructions that define and use values, one unit per emitted
// function (docs/design/typed-ir.md, "A typed IR with SSA values, and its serializer").
//
// The word stream is where this module starts, and its spellings do not change here. `parse` turns
// one emitted line into an instruction -- an opcode from `opcode_key`, two operands from `classify`,
// the label it defines -- and `build` gives every instruction its values: the value id it defines,
// the ids it reads, the type the front end's fact table records for a slot, and a call entry for
// every call in emission order. The optimizer's passes run on this record and the native backend
// emits from it; `write_body` serialises a unit as versioned text.
//
// Values relate to frame slots rather than replacing them: a value id names one *definition* of one
// location (a register, an `xmm` register or a frame slot), the location is what the emitter prints,
// and a read whose definition is not in the same block keeps its slot (value 0). Nothing here
// changes a byte of output; `tools/ssair-bytes.mjs` compares every emitted function against the
// pre-change compiler.

// One emitted function body, as the optimizer sees it: the instructions of the word stream with
// their byte spans, the two classified operands of each (kind and value), the per-instruction flags
// the passes keep, the frame shape, the label table and the unit the body belongs to.
//
// Kinds: 0 none, 1 register, 2 frame slot -N(%rbp), 3 immediate/other text, 4 other operand,
// 5 generated text (range in `gen`). Ops: see opcode_key(); 100 label, 101 directive, 0 unknown.
//
// A slot is one word unless the body's typed-IR facts name it the first word of a `DynPair` - the
// 16-byte `{data, vtable}` value a borrowed interface object is (docs/design/fat-dyn.md) - and the
// two-word result of a body that returns one is a fact too (`facts_dyn_result`). Both are read from
// `llvm::facts_dyn_pairs`/`facts_dyn_result` in `build`, keyed by the body symbol; nothing is
// declared in the instruction stream.
// The two words are one value with one identity: allocated together, written directly, addressed
// from the first word, kept adjacent when the frame is compacted, and never promoted, forwarded or
// dropped - the second word's only reader is the pair's address, which no pass reasons about. Every
// pass that looks at a slot obeys `pair[n]`, so width 1 and width 2 are handled uniformly and a
// pass that cannot reason about the second word is conservative for both.
pub struct Body {
    ls: u64[],
    le: u64[],
    op: u64[],
    chg: u64[],
    del: u64[],
    lab: u64[],
    tr: u64[],
    k0: u64[],
    v0: u64[],
    s0: u64[],
    e0: u64[],
    m0: u64[],
    k1: u64[],
    v1: u64[],
    s1: u64[],
    e1: u64[],
    m1: u64[],
    gen: u8[],
    out: u8[],
    weird: u64,
    // The line the `.gpos` markers of the body being read count from: the last `.gbase` before it
    // (gbase_line). And the inlinable copy the body just optimised made, as it was written - with
    // its markers still counting from that line - which is the form a remembered body keeps.
    gbase: u64,
    inl_rel: u8[],
    // The numbering this body's labels are in (label_number), 0 before its first numbered label.
    lscope: u64,
    maxslot: u64,
    table: u64[],
    base: u64,
    data: u64,
    uniq: u64,
    zline: u64,
    zfrom: u64,
    zto: u64,
    // The `DynPair`s this body builds, as the address-indexed slots the passes use, read from
    // `llvm::facts_dyn_pairs` in `build` (docs/design/fat-dyn.md).
    dyn_pairs: u64[],
    // The word count of each entry of `dyn_pairs` (2 for a `DynPair`, more for a frame record).
    pair_widths: u64[],
    pair: u64[],
    ret2: u64,
    inl_names: u8[][],
    inl_bodies: u8[][],
    inl_units: u8[][],
    inl_head: u64[],
    inl_next: u64[],
    // The emission unit the stream is inside: its name and its label prefix, both from the
    // `.grail_part` marker `native.grl` writes. A label is numbered only when it is this unit's.
    unit: u8[],
    uprefix: u8[],
    // 1 when the stream carried any marker, so a single-file build knows to strip them.
    marked: u64,
    // How many functions each unit has had so far (`uniq_index` is the 1-based index into
    // `uniq_units` of the unit being emitted, 0 before the first; `uniq_plain` counts for a stream
    // without units). Kept across a re-entry of the unit. See function_begin.
    uniq_index: u64,
    uniq_units: u8[][],
    uniq_next: u64[],
    uniq_plain: u64,
    // ---------------------------------------------------------------------------------------
    // The IR's own layer (docs/design/typed-ir.md, "A typed IR with SSA values"). One entry per
    // instruction: `dval` is the value id it defines (0 none), `use0`/`use1` the values it reads
    // (0 = the location's content on entry to the block), `ity`/`iw` the type and width of `def`.
    dval: u64[],
    use0: u64[],
    use1: u64[],
    ity: u64[],
    iw: u64[],
    // The mnemonic's byte range in the stream (for `op >= 100`, where there is no mnemonic, the
    // range is the whole line), kept so the serializer can print the line as it was written.
    ms: u64[],
    me: u64[],
    // The value table: entry i is value id i + 1 (`0` is the "unknown on entry" value). `vwidth` is
    // the number of words the value occupies, so a two-word pair is one value of width 2.
    vspace: u64[],
    vidx: u64[],
    vty: u64[],
    vwidth: u64[],
    vdef: u64[],
    // Calls in emission order, with the symbol the front end named or the reason it named none.
    calls: Call[],
    // The body's symbol, from its `.type NAME,@function` line (`type_symbol`), used to look the
    // front end's type facts up by `(body, slot)`.
    name: u8[],
    // Where optimised bodies are remembered between builds, and the compiler they were made by
    // (optimize.grl, the body memo). Empty: nothing is remembered.
    memo_dir: u8[],
    memo_id: u8[],
    // Bodies the front end applied from its unit store (Known), so the optimiser neither looks for
    // them line by line nor hashes their text for the memo.
    known: Known
}

// The bodies of a stream that are units the front end applied, in stream order: where each one's
// opening `.type` line starts, where its closing `.set` line ends, and the hash of its unit's key.
// A unit's text is a function of its key (docs/design/incremental-compilation.md), so the key
// stands for the text in the body memo's key.
pub struct Known {
    open: u64[],
    end: u64[],
    key: u8[][]
}
pub fn no_known() -> Known {
    return Known { open: u64[], end: u64[], key: u8[][] };
}

pub fn put<a>(v: (&a mut u64[]), i: u64, x: u64) {
    exchange(&mut v[i], x);
}

// `s` at `a` opens with `w`: the extent comes from the needle, so the window cannot be wider than
// the thing it is compared with, and a window that runs past the end of `s` is unequal.
pub fn at<b, d>(s: &b [u8], a: u64, w: &d [u8]) -> bool {
    return same_range(s, a, a + w.len(), w);
}

// `s[a..e]` is `w`, compared in place. It answers what `span::span_of(s, a, e).same_as(w)` answers
// (docs/design/range-values.md) - a range `s` does not have is unequal to everything - without
// making the span: the optimiser asks this of every line it reads, and a record per question was a
// tenth of a build (docs/design/compile-speed.md).
pub fn same_range<b, d>(s: &b [u8], a: u64, e: u64, w: &d [u8]) -> bool {
    if (e < a) || (s.len() < e) || (e - a != w.len()) {
        return false;
    }
    for i in w.len() {
        if s[a + i] != w[i] {
            return false;
        }
    }
    return true;
}

pub fn bit(r: u64) -> u64 {
    return 1 << r;
}

// 0xFFCF: every general register except rsp/rbp; caller-saved; argument registers.
pub fn all_regs() -> u64 {
    return 65487;
}

pub fn caller_saved() -> u64 {
    return 4039;
}

// A call reads every register an argument can arrive in: rdi, rsi, rdx, rcx, r8, r9 and - because
// machine.grl maps the seventh and eighth AAPCS64/RV64 argument registers to their x86-64 spelling -
// r10 and r11 too. Without them a store to %r10 before a call looks dead and is deleted.
pub fn arg_regs() -> u64 {
    return 4038;
}

// The SSE instructions the front end writes, numbered 60..71, and the single-precision arithmetic
// the optimiser narrows f32 operations to, 72..76: the optimiser knows they touch no
// general register except the ones named (the integer side of `movd`, `cvttsd2si`, `cvtsi2sdq`)
// and no memory. Before they had numbers they were unknown instructions, after which every
// register was live and nothing could be removed across them.
// The argument registers a call reads, when the callee is one whose arguments are known: the runtime
// exits (llvm.grl `never_returns`, and `rt_abort`; rdi, rsi, rdx by arity, runtime.grl and
// os-linux.grl) and the compiler's drop helpers (`.D` and 16 hex digits, native.grl `drop_symbol`),
// which take the value in rdi alone. A register mask with bit 63 set; 0 for any other call, which
// reads every argument register.
pub fn call_args<b>(s: &b [u8], a: u64, e: u64) -> u64 {
    if (e - a == 18) && at(view(s), a, view(".D")) {
        return 9223372036854775808 + 128;
    }
    if same_range(view(s), a, e, view("rt_abort")) {
        return 9223372036854775808 + 0;
    }
    if same_range(view(s), a, e, view("rt_fail")) {
        return 9223372036854775808 + 196;
    }
    if same_range(view(s), a, e, view("rt_trap")) {
        return 9223372036854775808 + 196;
    }
    if same_range(view(s), a, e, view("rt_refine")) {
        return 9223372036854775808 + 192;
    }
    if same_range(view(s), a, e, view("rt_task_fail")) {
        return 9223372036854775808 + 128;
    }
    if same_range(view(s), a, e, view("rt_fail_text")) {
        return 9223372036854775808 + 196;
    }
    if same_range(view(s), a, e, view("rt_report_die")) {
        return 9223372036854775808 + 192;
    }
    if same_range(view(s), a, e, view("rt_abort_final")) {
        return 9223372036854775808 + 0;
    }
    if same_range(view(s), a, e, view("rt_abort_park")) {
        return 9223372036854775808 + 0;
    }
    if same_range(view(s), a, e, view("rt_hard_exit")) {
        return 9223372036854775808 + 128;
    }
    if same_range(view(s), a, e, view("rt_stack_overflow")) {
        return 9223372036854775808 + 0;
    }
    if same_range(view(s), a, e, view("rt_stack_overflow_at")) {
        return 9223372036854775808 + 128;
    }
    return 0;
}
pub fn float_opcode<b>(s: &b [u8], a: u64, space: u64) -> u64 {
    if same_range(view(s), a, space, view("addsd")) {
        return 60;
    }
    if same_range(view(s), a, space, view("subsd")) {
        return 61;
    }
    if same_range(view(s), a, space, view("mulsd")) {
        return 62;
    }
    if same_range(view(s), a, space, view("divsd")) {
        return 63;
    }
    if same_range(view(s), a, space, view("sqrtsd")) {
        return 64;
    }
    if same_range(view(s), a, space, view("cvtss2sd")) {
        return 65;
    }
    if same_range(view(s), a, space, view("cvtsd2ss")) {
        return 66;
    }
    if same_range(view(s), a, space, view("ucomisd")) {
        return 67;
    }
    if same_range(view(s), a, space, view("movaps")) {
        return 68;
    }
    if same_range(view(s), a, space, view("cvttsd2si")) {
        return 69;
    }
    if same_range(view(s), a, space, view("movd")) {
        return 70;
    }
    if same_range(view(s), a, space, view("cvtsi2sdq")) {
        return 71;
    }
    if same_range(view(s), a, space, view("addss")) {
        return 72;
    }
    if same_range(view(s), a, space, view("subss")) {
        return 73;
    }
    if same_range(view(s), a, space, view("mulss")) {
        return 74;
    }
    if same_range(view(s), a, space, view("divss")) {
        return 75;
    }
    if same_range(view(s), a, space, view("sqrtss")) {
        return 76;
    }
    return 0;
}
pub fn is_float_op(op: u64) -> bool {
    return (59 < op) && (op < 77);
}

