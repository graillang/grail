module fmt;

// Canonical Grail layout (rustfmt-style): 4-space indentation, one statement per line,
// block braces on the header line, spaces around binary operators, single-line struct
// literals when they fit, and at most one blank line. Comments are preserved. A line over
// 100 columns is broken at a match arm, a postfix chain, a bracket list or a binary
// operator, in that order, using tokens only so the program is never reparsed or changed.
// Token kinds: 1 word, 2 number, 3 string, 4 punctuation (byte or lexer multi-byte code), 5 comment
// to the end of the line, 6 block comment (`/* ... */`, nesting; kept as written, inline or not).
struct F {
    kind: u64[],
    start: u64[],
    end: u64[],
    nl: u64[],
    code: u64[],
    generic: u64[],
    ltoken: u64[],
    lspace: u64[],
    lfirst: u64[],
    lindent: u64[],
    out: u8[]
}
fn letter(c: u64) -> bool {
    return ((64 < c) && (c < 91)) || ((96 < c) && (c < 123)) || (c == 95);
}
fn digit(c: u64) -> bool {
    return (47 < c) && (c < 58);
}
fn pair(c: u64, d: u64) -> u64 {
    if (c == 45) & (d == 62) {
        return 256;
    }
    if (c == 61) & (d == 62) {
        return 257;
    }
    if (c == 61) & (d == 61) {
        return 258;
    }
    if (c == 33) & (d == 61) {
        return 259;
    }
    if (c == 58) & (d == 58) {
        return 260;
    }
    if (c == 58) & (d == 61) {
        return 261;
    }
    if (c == 43) & (d == 61) {
        return 262;
    }
    if (c == 45) & (d == 61) {
        return 263;
    }
    if (c == 42) & (d == 61) {
        return 264;
    }
    if (c == 47) & (d == 61) {
        return 265;
    }
    if (c == 37) & (d == 61) {
        return 266;
    }
    if (c == 42) & (d == 42) {
        return 267;
    }
    if (c == 60) & (d == 61) {
        return 269;
    }
    if (c == 62) & (d == 61) {
        return 270;
    }
    if (c == 38) & (d == 38) {
        return 273;
    }
    if (c == 124) & (d == 124) {
        return 274;
    }
    return 0;
}
fn token<a>(f: (&a mut F), kind: u64, start: u64, end: u64, nl: u64, code: u64) {
    f.kind.push(kind);
    f.start.push(start);
    f.end.push(end);
    f.nl.push(nl);
    f.code.push(code);
    f.generic.push(0);
}
fn scan<a, b>(f: (&a mut F), s: &b [u8]) {
    n := s.len();
    mut i = 0;
    mut nl = 0;
    while i < n {
        c := s[i];
        if c == 10 {
            nl += 1;
            i += 1;
            continue;
        }
        if c == 32 || c == 9 || c == 13 || c == 12 {
            i += 1;
            continue;
        }
        start := i;
        if (c == 47) & (i + 1 < n) {
            if s[i + 1] == 47 {
                while i < n {
                    if s[i] == 10 {
                        break;
                    }
                    i += 1;
                }
                mut end = i;
                while start < end {
                    last := s[end - 1];
                    if (last != 32) & (last != 9) & (last != 13) {
                        break;
                    }
                    end -= 1;
                }
                token(&mut f, 5, start, end, nl, 0);
                nl = 0;
                continue;
            }
            if s[i + 1] == 42 {
                mut depth = 0;
                while i < n {
                    if (s[i] == 47) & (i + 1 < n) && (s[i + 1] == 42) {
                        depth += 1;
                        i += 2;
                    } else if (s[i] == 42) & (i + 1 < n) && (s[i + 1] == 47) {
                        depth -= 1;
                        i += 2;
                        if depth == 0 {
                            break;
                        }
                    } else {
                        i += 1;
                    }
                }
                token(&mut f, 6, start, i, nl, 0);
                nl = 0;
                continue;
            }
        }
        if c == 39 {
            i += 1;
            while i < n {
                d := s[i];
                if d == 92 {
                    i += 2;
                    continue;
                }
                i += 1;
                if d == 39 {
                    break;
                }
            }
            if n < i {
                i = n;
            }
            token(&mut f, 3, start, i, nl, 0);
            nl = 0;
            continue;
        }
        if c == 34 {
            i += 1;
            while i < n {
                d := s[i];
                if d == 92 {
                    i += 2;
                    continue;
                }
                i += 1;
                if d == 34 {
                    break;
                }
            }
            token(&mut f, 3, start, i, nl, 0);
            nl = 0;
            continue;
        }
        if letter(c) {
            while i < n {
                d := s[i];
                if !letter(d) && !digit(d) {
                    break;
                }
                i += 1;
            }
            token(&mut f, 1, start, i, nl, 0);
            nl = 0;
            continue;
        }
        if digit(c) {
            while i < n {
                d := s[i];
                if !letter(d) && !digit(d) {
                    mut keep = 0;
                    if (d == 46) & (i + 1 < n) {
                        if digit(s[i + 1]) {
                            if s[i - 1] != 46 {
                                keep = 1;
                            }
                        }
                    }
                    if (d == 43 || d == 45) && i + 1 < n {
                        p := s[i - 1];
                        if (p == 101 || p == 69) && digit(s[i + 1]) {
                            keep = 1;
                        }
                    }
                    if keep == 0 {
                        break;
                    }
                }
                i += 1;
            }
            token(&mut f, 2, start, i, nl, 0);
            nl = 0;
            continue;
        }
        mut code = c;
        mut width = 1;
        if i + 1 < n {
            mut p = pair(c, s[i + 1]);
            if (p == 259) & (i + 2 < n) {
                if s[i + 2] == 61 {
                    p = 0;
                }
            }
            if p != 0 {
                code = p;
                width = 2;
                if (p == 267) & (i + 2 < n) {
                    if s[i + 2] == 61 {
                        code = 268;
                        width = 3;
                    }
                }
            }
        }
        i += width;
        token(&mut f, 4, start, i, nl, code);
        nl = 0;
    }
}
fn is<a, b, d>(f: (&a F), s: &b [u8], i: u64, word: &d [u8]) -> bool {
    if f.kind[i] != 1 {
        return false;
    }
    start := f.start[i];
    if f.end[i] - start != word.len() {
        return false;
    }
    for j in word.len() {
        if s[start + j] != word[j] {
            return false;
        }
    }
    return true;
}
fn punct<a>(f: (&a F), i: u64, code: u64) -> bool {
    return (f.kind[i] == 4) && (f.code[i] == code);
}
fn keyword<a, b>(f: (&a F), s: &b [u8], i: u64) -> bool {
    return is(&f, view(s), i, view("return"))
        || is(&f, view(s), i, view("in"))
        || is(&f, view(s), i, view("if"))
        || is(&f, view(s), i, view("while"))
        || is(&f, view(s), i, view("match"))
        || is(&f, view(s), i, view("else"))
        || is(&f, view(s), i, view("for"));
}
// Binary operators (spaced). '<' / '>' count only when not generic brackets.
fn binary<a>(f: (&a F), i: u64) -> bool {
    if f.kind[i] != 4 {
        return false;
    }
    c := f.code[i];
    if 255 < c {
        return (c != 260);
    }
    if f.generic[i] != 0 {
        return false;
    }
    return (c == 61)
        || (c == 60)
        || (c == 62)
        || (c == 43)
        || (c == 45)
        || (c == 42)
        || (c == 47)
        || (c == 37)
        || (c == 38)
        || (c == 94)
        || (c == 124);
}
// A '<' after a word opens generic arguments if a matching '>' follows with only type tokens.
fn mark_generics<a, b>(f: (&a mut F), s: &b [u8]) {
    n := f.kind.len();
    for i in n {
        if punct(&f, i, 60) && 0 < i {
            if f.kind[i - 1] == 1 {
                mut depth = 0;
                // Parentheses and brackets inside type arguments are balanced (`Fn<(u64, u64)>`), so a
                // '>' met while one is open is a comparison or a shift: `i < (n >> 1)` is not generic.
                mut nest = 0;
                mut j = i;
                mut found = 0;
                while j < n {
                    k := f.kind[j];
                    c := f.code[j];
                    if k == 4 {
                        if c == 40 || c == 91 {
                            nest += 1;
                        }
                        if c == 41 || c == 93 {
                            if nest == 0 {
                                break;
                            }
                            nest -= 1;
                        }
                        if (c == 62) && (nest != 0) {
                            break;
                        }
                    }
                    mut ok = k == 1 || k == 2;
                    if k == 4 {
                        ok = c == 60
                            || c == 62
                            || c == 44
                            || c == 260
                            || c == 40
                            || c == 41
                            || c == 256
                            || c == 43
                            || c == 58
                            || c == 91
                            || c == 93;
                    }
                    if !ok {
                        break;
                    }
                    if (k == 4) & (c == 60) {
                        depth += 1;
                    }
                    if (k == 4) & (c == 62) {
                        if depth != 0 {
                            depth -= 1;
                        }
                        if depth == 0 {
                            found = j;
                            break;
                        }
                    }
                    j += 1;
                }
                if found != 0 {
                    mut d = 0;
                    for m in found - i + 1 {
                        at := i + m;
                        if punct(&f, at, 60) {
                            d += 1;
                            mut g = &mut f.generic[at];
                            exchange(g, 1);
                        }
                        if punct(&f, at, 62) {
                            if d != 0 {
                                d -= 1;
                            }
                            mut g = &mut f.generic[at];
                            exchange(g, 1);
                        }
                    }
                }
            }
        }
    }
}
fn mark_pipes<a, b>(f: (&a mut F), s: &b [u8]) {
    n := f.kind.len();
    mut i = 0;
    while i < n {
        if punct(&f, i, 124) && prefix_position(&f, view(s), i) {
            mut j = i + 1;
            mut depth = 0;
            while j < n {
                k := f.kind[j];
                c := f.code[j];
                if k == 4 {
                    if c == 40 || c == 91 || c == 123 {
                        depth += 1;
                    }
                    if c == 41 || c == 93 || c == 125 {
                        if depth == 0 {
                            break;
                        }
                        if depth != 0 {
                            depth -= 1;
                        }
                    }
                    if (c == 124) & (depth == 0) {
                        break;
                    }
                }
                j += 1;
            }
            if j < n {
                if punct(&f, j, 124) {
                    mut g = &mut f.generic[i];
                    exchange(g, 2);
                    mut h = &mut f.generic[j];
                    exchange(h, 3);
                    i = j;
                }
            }
        }
        i += 1;
    }
}
fn prefix_position<a, b>(f: (&a F), s: &b [u8], i: u64) -> bool {
    if i == 0 {
        return true;
    }
    p := i - 1;
    k := f.kind[p];
    if k == 2 || k == 3 {
        return false;
    }
    if k == 1 {
        // `mut` is followed by a type or a place, never an operator: `*mut *mut T`, `&mut *r`.
        return keyword(&f, view(s), p) || is(&f, view(s), p, view("mut"));
    }
    if k == 4 {
        c := f.code[p];
        if c == 41 || c == 93 || c == 125 || c == 33 || c == 63 {
            return false;
        }
        if f.generic[p] != 0 && c == 62 {
            return false;
        }
    }
    return true;
}
fn unary<a, b>(f: (&a F), s: &b [u8], i: u64) -> bool {
    if f.kind[i] != 4 {
        return false;
    }
    c := f.code[i];
    // `**` and `&&` are one token each, and a pair of prefix operators where an operand starts
    // (`**pp`, `&&u64`); after an operand they are the binary operators.
    if (c != 38) & (c != 45) & (c != 42) & (c != 267) & (c != 273) {
        return false;
    }
    return prefix_position(&f, view(s), i);
}
// Space between two tokens on the same line (0/1). inline: the brace context is a literal.
fn space<a, b>(f: (&a F), s: &b [u8], p: u64, i: u64, inline: u64) -> bool {
    pk := f.kind[p];
    k := f.kind[i];
    pc := f.code[p];
    c := f.code[i];
    if k == 5 || k == 6 || pk == 6 {
        return true;
    }
    if (k == 4) & (c == 91) & (pk == 1) & (f.end[p] < f.start[i]) {
        return true;
    }
    if k == 4 {
        if c == 41
            || c == 93
            || c == 44
            || c == 59
            || c == 46
            || c == 260
            || c == 63
            || c == 58 {
            return false;
        }
        if c == 33 {
            if pk == 4 && (pc == 40 || pc == 91 || pc == 123) {
                return false;
            }
            return prefix_position(&f, view(s), i);
        }
    }
    if (pk == 4) & (pc == 33) {
        if prefix_position(&f, view(s), p) {
            return false;
        }
    }
    if pk == 4 {
        if pc == 46 || pc == 260 || pc == 40 || pc == 91 {
            return false;
        }
    }
    if (pk == 4) & (pc == 125) {
        return true;
    }
    if (k == 4) & (c == 125) {
        return !punct(&f, p, 123);
    }
    if (pk == 4) & (pc == 123) {
        return true;
    }
    if (pk == 4) & (pc == 58) {
        return true;
    }
    // Adjacent << / >> (two tokens, never generic) stay together as a shift operator.
    if pk == 4
        && k == 4
        && f.generic[i] == 0
        && f.generic[p] == 0
        && ((pc == 60 && c == 60) || (pc == 62 && c == 62)) {
        if f.start[i] == f.end[p] {
            return false;
        }
    }
    if f.generic[p] == 2 {
        return false;
    }
    if f.generic[i] == 2 {
        return true;
    }
    if f.generic[i] == 3 {
        return false;
    }
    if f.generic[i] == 1 {
        return false;
    }
    if f.generic[p] == 1 {
        if pc == 60 {
            return false;
        }
        if k == 4 {
            if !(c == 40 || c == 91 || c == 260 || c == 46 || c == 123) {
                return true;
            }
            if c == 123 {
                return true;
            }
            return false;
        }
        return true;
    }
    if (pk == 4) & (unary(&f, view(s), p)) {
        return false;
    }
    if (k == 4) & (c == 40) {
        if pk == 1 {
            if keyword(&f, view(s), p) {
                return true;
            }
            return false;
        }
        if pk == 4 {
            if pc == 41 || pc == 93 || pc == 33 || pc == 63 {
                return false;
            }
        }
        return true;
    }
    if (k == 4) & (c == 91) {
        if pk == 1 {
            return keyword(&f, view(s), p);
        }
        if pk == 4 {
            if pc == 41 || pc == 93 {
                return false;
            }
        }
        return true;
    }
    if (k == 4) & (c == 123) {
        return true;
    }
    if binary(&f, i) {
        return true;
    }
    if binary(&f, p) {
        return true;
    }
    // A space after `,` and after the `;` of a repeat literal (`u8[0; n]`).
    if pk == 4 && (pc == 44 || pc == 59) {
        return true;
    }
    if (pk != 4) & (k != 4) {
        return true;
    }
    if pk == 4 && (pc == 41 || pc == 93 || pc == 33 || pc == 63) {
        return k != 4;
    }
    if (k == 4) & (c == 38) {
        return pk != 4;
    }
    return false;
}
fn new_line<a>(f: (&a mut F), indent: u64) {
    f.lfirst.push(f.ltoken.len());
    f.lindent.push(indent);
}
fn emit<a>(f: (&a mut F), i: u64, sp: u64) {
    f.ltoken.push(i);
    f.lspace.push(sp);
}
// Context kinds: 1 block, 2 declaration (one item per line), 3 match, 4 inline literal, 5 paren, 6 bracket.
// Whether the braces opening at `open` hold a `;` of their own (not one in a nested bracket).
fn holds_statements<a>(f: (&a F), open: u64) -> bool {
    n := f.kind.len();
    mut depth = 0;
    mut j = open + 1;
    while j < n {
        if f.kind[j] == 4 {
            c := f.code[j];
            if c == 40 || c == 91 || c == 123 {
                depth += 1;
            }
            if c == 41 || c == 93 || c == 125 {
                if depth == 0 {
                    return false;
                }
                depth -= 1;
            }
            if (c == 59) && (depth == 0) {
                return true;
            }
        }
        j += 1;
    }
    return false;
}
// The `{` of a body whose head starts at `from` (a signature's parameters and result, a closure's
// result type): the first `{` outside brackets, or the token count when a `;` or `}` comes first.
fn body_open<a>(f: (&a F), from: u64) -> u64 {
    n := f.kind.len();
    mut depth = 0;
    mut j = from;
    while j < n {
        if f.kind[j] == 4 {
            c := f.code[j];
            if c == 40 || c == 91 {
                depth += 1;
            }
            if (c == 41 || c == 93) && (depth != 0) {
                depth -= 1;
            }
            if depth == 0 {
                if c == 123 {
                    return j;
                }
                if c == 59 || c == 125 {
                    return n;
                }
            }
        }
        j += 1;
    }
    return n;
}
// The token before `i` that is not a comment, or `i` when there is none.
fn before_comments<a>(f: (&a F), i: u64) -> u64 {
    mut j = i;
    while j > 0 {
        j -= 1;
        if f.kind[j] != 5 {
            return j;
        }
    }
    return i;
}
// A body opening at `open` whose last statement is `return x;`: marks the `return` and the `;` in
// `gone`, so the statement becomes the tail `x`. Left alone: a bare `return;` and `return ();` (a
// unit body simply ends), and a value that is itself an `if`, `match`, `unsafe { }` or `{ }`, whose
// tail form would return from each of its arms instead - the same result, compiled differently.
fn final_return<a, b, d>(f: (&a F), s: &b [u8], open: u64, gone: (&d mut u64[])) {
    n := f.kind.len();
    mut depth = 0;
    mut close = n;
    mut j = open + 1;
    mut ret = n;
    mut semi = n;
    while j < n {
        k := f.kind[j];
        c := f.code[j];
        if k == 4 {
            if c == 40 || c == 91 || c == 123 {
                depth += 1;
            }
            if c == 41 || c == 93 || c == 125 {
                if depth == 0 {
                    close = j;
                    break;
                }
                depth -= 1;
            }
            if (c == 59) && (depth == 0) {
                if ret != n {
                    semi = j;
                }
            }
        }
        if (depth == 0) && is(&f, view(s), j, view("return")) {
            ret = j;
            semi = n;
        }
        if (depth == 0) && (k == 4) && (c == 59) && (semi == n) {
            ret = n;
        }
        j += 1;
    }
    if (close == n) || (ret == n) || (semi == n) {
        return;
    }
    if before_comments(&f, close) != semi {
        return;
    }
    first := ret + 1;
    if first == semi {
        return;
    }
    if punct(&f, first, 40) && (first + 2 == semi) && punct(&f, first + 1, 41) {
        return;
    }
    if punct(&f, first, 123)
        || is(&f, view(s), first, view("if"))
        || is(&f, view(s), first, view("match"))
        || is(&f, view(s), first, view("unsafe")) {
        return;
    }
    mut g = &mut gone[ret];
    exchange(g, 1);
    mut h = &mut gone[semi];
    exchange(h, 1);
}
// A function's or closure's final `return x;` is written as its tail expression `x` (a block's last
// expression without `;` is its value). Only the body's own last statement: an early `return` stays.
fn tail_returns<a, b>(f: (&a mut F), s: &b [u8]) {
    n := f.kind.len();
    mut gone = u64[];
    for i in n {
        gone.push(0);
    }
    for i in n {
        mut open = n;
        if is(&f, view(s), i, view("fn")) && (i + 1 < n) && (f.kind[i + 1] == 1) {
            open = body_open(&f, i + 2);
        } else if (punct(&f, i, 124) && (f.generic[i] == 3)) || (punct(&f, i, 274) && prefix_position(&f, view(s), i)) {
            if (i + 1 < n) && punct(&f, i + 1, 123) {
                open = i + 1;
            } else if (i + 1 < n) && punct(&f, i + 1, 256) {
                open = body_open(&f, i + 2);
            }
        }
        if open < n {
            final_return(&f, view(s), open, &mut gone);
        }
    }
    mut kind = u64[];
    mut start = u64[];
    mut end = u64[];
    mut nl = u64[];
    mut code = u64[];
    mut generic = u64[];
    mut carry = 0;
    for i in n {
        if gone[i] != 0 {
            // The line break before a removed `return` belongs to the value that now starts the line.
            if is(&f, view(s), i, view("return")) {
                carry = f.nl[i];
            }
            continue;
        }
        kind.push(f.kind[i]);
        start.push(f.start[i]);
        end.push(f.end[i]);
        if carry != 0 {
            nl.push(carry);
            carry = 0;
        } else {
            nl.push(f.nl[i]);
        }
        code.push(f.code[i]);
        generic.push(f.generic[i]);
    }
    exchange(&mut f.kind, kind);
    exchange(&mut f.start, start);
    exchange(&mut f.end, end);
    exchange(&mut f.nl, nl);
    exchange(&mut f.code, code);
    exchange(&mut f.generic, generic);
}
fn layout<a, b>(f: (&a mut F), s: &b [u8]) {
    n := f.kind.len();
    mut stack = u64[];
    mut indent = 0;
    mut pending = 1;
    mut header = 0;
    mut start = 1;
    mut lines = 0;
    // Open generic brackets: a comma inside `Pair<u64, u64>` or `Fn<Send, Owned>()` separates type
    // arguments, not the fields of the declaration it is written in.
    mut angle = 0;
    for i in n {
        k := f.kind[i];
        c := f.code[i];
        if (k == 4) && (f.generic[i] != 0) {
            if c == 60 {
                angle += 1;
            }
            if (c == 62) && (angle != 0) {
                angle -= 1;
            }
        }
        mut top = 0;
        if stack.len() != 0 {
            top = stack[stack.len() - 1];
        }
        closes := k == 4 && c == 125 && (top == 1 || top == 2 || top == 3);
        if closes {
            stack.pop()!;
            indent -= 1;
            empty := punct(&f, i - 1, 123);
            if empty && pending != 0 {
                pending = 0;
                emit(&mut f, i, 0);
                start = 1;
                header = 0;
                if i + 1 < n {
                    if !(punct(&f, i + 1, 44)
                        || punct(&f, i + 1, 41)
                        || punct(&f, i + 1, 59)
                        || punct(&f, i + 1, 93)
                        || is(&f, view(s), i + 1, view("else"))) {
                        pending = 1;
                    }
                } else {
                    pending = 1;
                }
                continue;
            }
            pending = 1;
        }
        if (k == 5) & (f.nl[i] == 0) & (pending != 0) & (0 < i) {
            pending = 0;
            emit(&mut f, i, 1);
            pending = 1;
            continue;
        }
        // A block comment on the line of the token before it stays there; the line breaks after it
        // only where the source broke it.
        if (k == 6) & (f.nl[i] == 0) & (pending != 0) & (0 < i) {
            emit(&mut f, i, 1);
            pending = 0;
            if (i + 1 < f.kind.len()) && (f.nl[i + 1] != 0) {
                pending = 1;
            }
            continue;
        }
        if pending != 0 {
            if 1 < f.nl[i] && lines != 0 && !closes {
                if !punct(&f, i - 1, 123) {
                    new_line(&mut f, 0);
                }
            }
            new_line(&mut f, indent);
            lines += 1;
            emit(&mut f, i, 0);
            pending = 0;
        } else {
            mut inline = 0;
            if top == 4 {
                inline = 1;
            }
            emit(&mut f, i, u64(space(&f, view(s), i - 1, i, inline)));
        }
        if start != 0 && k == 1 {
            mut word = i;
            if is(&f, view(s), i, view("pub")) || is(&f, view(s), i, view("unsafe")) {
                word = i;
            }
            if is(&f, view(s), word, view("struct")) || is(&f, view(s), word, view("enum")) {
                header = 1;
            } else {
                if is(&f, view(s), word, view("match")) {
                    header = 3;
                } else {
                    if is(&f, view(s), word, view("fn"))
                        || is(&f, view(s), word, view("unsafe"))
                        || is(&f, view(s), word, view("if"))
                        || is(&f, view(s), word, view("while"))
                        || is(&f, view(s), word, view("for"))
                        || is(&f, view(s), word, view("else"))
                        || is(&f, view(s), word, view("loop"))
                        || is(&f, view(s), word, view("impl"))
                        || is(&f, view(s), word, view("interface")) {
                        header = 2;
                    }
                }
            }
            if !(is(&f, view(s), i, view("pub")) || is(&f, view(s), i, view("unsafe"))) {
                start = 0;
            }
        }
        if start != 0 && k != 1 && k != 5 && k != 6 {
            start = 0;
        }
        if k == 5 {
            pending = 1;
            continue;
        }
        if k == 6 {
            if (i + 1 < f.kind.len()) && (f.nl[i + 1] != 0) {
                pending = 1;
            }
            continue;
        }
        if k != 4 {
            continue;
        }
        if c == 123 {
            mut kind = 4;
            nested := top == 4 || top == 5 || top == 6;
            if punct(&f, i - 1, 257) {
                kind = 1;
            } else {
                if header == 1 && !nested {
                    kind = 2;
                } else {
                    if header == 3 && !nested {
                        kind = 3;
                    } else {
                        if header == 2 && !nested {
                            kind = 1;
                        }
                    }
                }
            }
            // A brace that holds statements is a block wherever it is written - a closure's body in an
            // argument, an arm of an `if` expression, a block expression - so it gets a line each.
            if (kind == 4) && holds_statements(&f, i) {
                kind = 1;
            }
            stack.push(kind);
            if kind != 4 {
                indent += 1;
                pending = 1;
                header = 0;
                start = 1;
            }
            continue;
        }
        if c == 125 && !closes {
            if top == 4 {
                stack.pop()!;
            }
            continue;
        }
        if closes {
            start = 1;
            header = 0;
            pending = 1;
            if i + 1 < n {
                if punct(&f, i + 1, 44)
                    || punct(&f, i + 1, 41)
                    || punct(&f, i + 1, 59)
                    || punct(&f, i + 1, 93)
                    || is(&f, view(s), i + 1, view("else")) {
                    pending = 0;
                }
            }
            continue;
        }
        if c == 40 {
            stack.push(5);
            continue;
        }
        if c == 91 {
            stack.push(6);
            continue;
        }
        if c == 41 || c == 93 {
            if top == 5 || top == 6 {
                stack.pop()!;
            }
            continue;
        }
        if c == 59 {
            if top == 1 || top == 0 {
                pending = 1;
                start = 1;
                header = 0;
            }
            continue;
        }
        if c == 44 {
            if (top == 2 || top == 3) && (angle == 0) {
                pending = 1;
                start = 1;
            }
            continue;
        }
    }
}
fn put<a, b>(out: (&a mut u8[]), s: &b [u8]) {
    for i in s.len() {
        out.push(s[i]);
    }
}
fn token_width<a>(f: (&a F), i: u64) -> u64 {
    return f.end[i] - f.start[i];
}
fn range_width<a>(f: (&a F), lo: u64, hi: u64) -> u64 {
    mut w = 0;
    mut j = lo;
    while j < hi {
        if (j != lo) & (f.lspace[j] != 0) {
            w += 1;
        }
        w += token_width(&f, f.ltoken[j]);
        j += 1;
    }
    return w;
}
fn write_range<a, b>(f: (&a mut F), s: &b [u8], lo: u64, hi: u64, indent: u64) {
    for i in indent * 4 {
        f.out.push(32);
    }
    mut j = lo;
    while j < hi {
        if (j != lo) & (f.lspace[j] != 0) {
            f.out.push(32);
        }
        t := f.ltoken[j];
        for m in f.end[t] - f.start[t] {
            f.out.push(s[f.start[t] + m]);
        }
        j += 1;
    }
    f.out.push(10);
}
fn opener<a>(f: (&a F), j: u64) -> bool {
    t := f.ltoken[j];
    if f.kind[t] != 4 {
        return false;
    }
    c := f.code[t];
    return (c == 40) || (c == 91) || (c == 123);
}
fn closer<a>(f: (&a F), j: u64) -> bool {
    t := f.ltoken[j];
    if f.kind[t] != 4 {
        return false;
    }
    c := f.code[t];
    return (c == 41) || (c == 93) || (c == 125);
}
// A line over 100 columns is broken in rustfmt order: a match arm after `=>`, then a binary
// operator chain before each operator, then a postfix chain before each `.`, then a bracket
// list one item per line. Every rule reads tokens only, so formatting never changes the program.
fn code_at<a>(f: (&a F), j: u64) -> u64 {
    t := f.ltoken[j];
    if f.kind[t] != 4 {
        return 0;
    }
    return f.code[t];
}
fn opens(c: u64) -> bool {
    return (c == 40) || (c == 91) || (c == 123);
}
fn shuts(c: u64) -> bool {
    return (c == 41) || (c == 93) || (c == 125);
}
// Index of the token closing the opener at j, or hi when it is not closed on this line.
fn close_of<a>(f: (&a F), j: u64, hi: u64) -> u64 {
    mut d = 0;
    mut m = j;
    while m < hi {
        if opener(&f, m) {
            d += 1;
        }
        if closer(&f, m) {
            if d != 0 {
                d -= 1;
            }
            if d == 0 {
                return m;
            }
        }
        m += 1;
    }
    return hi;
}
// A binary operator that may start a continuation line: not assignment, not a unary sign.
fn breakable<a, b>(f: (&a F), s: &b [u8], j: u64) -> bool {
    t := f.ltoken[j];
    if f.kind[t] != 4 {
        return false;
    }
    if !binary(&f, t) {
        return false;
    }
    c := f.code[t];
    // `<` and `>` never start a line: after a name, a line opening with `<` reads as a generic
    // argument list, and the output would not parse.
    if (c == 60) || (c == 62) {
        return false;
    }
    if c == 61
        || c == 256
        || c == 257
        || c == 261
        || c == 262
        || c == 263
        || c == 264
        || c == 265
        || c == 266 {
        return false;
    }
    if unary(&f, view(s), t) {
        return false;
    }
    return true;
}
// A `{ ... }` body that accepts a trailing comma: comma-separated items, no statements or arms.
fn trailing_ok<a>(f: (&a F), lo: u64, hi: u64) -> bool {
    mut d = 0;
    mut j = lo;
    mut commas = 0;
    while j < hi {
        c := code_at(&f, j);
        if opens(c) {
            d += 1;
        }
        if shuts(c) {
            if d != 0 {
                d -= 1;
            }
        }
        if d == 0 {
            if c == 59 || c == 261 || c == 257 {
                return false;
            }
            if c == 44 {
                commas += 1;
            }
        }
        j += 1;
    }
    return 0 < commas;
}
fn write_range_comma<a, b>(f: (&a mut F), s: &b [u8], lo: u64, hi: u64, indent: u64) {
    for i in indent * 4 {
        f.out.push(32);
    }
    mut j = lo;
    while j < hi {
        if (j != lo) & (f.lspace[j] != 0) {
            f.out.push(32);
        }
        t := f.ltoken[j];
        for m in f.end[t] - f.start[t] {
            f.out.push(s[f.start[t] + m]);
        }
        j += 1;
    }
    f.out.push(44);
    f.out.push(10);
}
// Long match arm: the pattern and `=>` stay, the body moves to the next line.
fn arm_break<a, b>(f: (&a mut F), s: &b [u8], lo: u64, hi: u64, indent: u64) -> bool {
    mut d = 0;
    mut j = lo;
    while j < hi {
        c := code_at(&f, j);
        if opens(c) {
            d += 1;
        }
        if shuts(c) {
            if d == 0 {
                // The range closes a bracket it never opened: it is not one arm, so it is not
                // broken here (this underflowed, and checked arithmetic aborted the formatter).
                return false;
            }
            d -= 1;
        }
        if (d == 0) & (c == 257) & (j + 2 < hi) {
            write_range(&mut f, view(s), lo, j + 1, indent);
            render(&mut f, view(s), j + 1, hi, indent + 1);
            return true;
        }
        j += 1;
    }
    return false;
}
// A single `.` used as a postfix separator, never one half of a `..` range.
fn chain_dot<a>(f: (&a F), j: u64, lo: u64, hi: u64) -> bool {
    if code_at(&f, j) != 46 {
        return false;
    }
    if lo < j {
        if code_at(&f, j - 1) == 46 {
            return false;
        }
    }
    if j + 1 < hi {
        if code_at(&f, j + 1) == 46 {
            return false;
        }
    }
    return true;
}
// Long postfix chain: the head stays on the line, then one `.segment` per line.
fn chain_break<a, b>(f: (&a mut F), s: &b [u8], lo: u64, hi: u64, indent: u64) -> bool {
    if chain_dot(&f, lo, lo, hi) {
        return false;
    }
    mut d = 0;
    mut j = lo;
    mut dots = 0;
    while j < hi {
        c := code_at(&f, j);
        if opens(c) {
            d += 1;
        }
        if shuts(c) {
            if d != 0 {
                d -= 1;
            }
        }
        if (d == 0) & chain_dot(&f, j, lo, hi) {
            dots += 1;
        }
        j += 1;
    }
    if dots < 2 {
        return false;
    }
    mut seg = lo;
    d = 0;
    j = lo;
    while j < hi {
        c := code_at(&f, j);
        if opens(c) {
            d += 1;
        }
        if shuts(c) {
            if d != 0 {
                d -= 1;
            }
        }
        if (d == 0) & chain_dot(&f, j, lo, hi) {
            mut ind = indent;
            if seg != lo {
                ind = indent + 1;
            }
            render(&mut f, view(s), seg, j, ind);
            seg = j;
        }
        j += 1;
    }
    render(&mut f, view(s), seg, hi, indent + 1);
    return true;
}
// Bracket list that does not fit: head, one item per line, tail. A `{` record body also takes a
// trailing comma, which the language accepts there.
fn list_break<a, b>(f: (&a mut F), s: &b [u8], lo: u64, hi: u64, indent: u64) -> bool {
    mut open = hi;
    mut close = hi;
    mut j = lo;
    while j < hi {
        if opener(&f, j) {
            m := close_of(&f, j, hi);
            if (m < hi) & (j + 1 < m) {
                open = j;
                close = m;
                break;
            }
        }
        j += 1;
    }
    if open == hi {
        return false;
    }
    write_range(&mut f, view(s), lo, open + 1, indent);
    mut comma = false;
    if code_at(&f, open) == 123 {
        comma = trailing_ok(&f, open + 1, close);
    }
    mut item = open + 1;
    mut d = 0;
    mut m = open + 1;
    while m < close {
        c := code_at(&f, m);
        if opens(c) {
            d += 1;
        }
        if shuts(c) {
            if d != 0 {
                d -= 1;
            }
        }
        if (d == 0) & (c == 44) {
            render(&mut f, view(s), item, m + 1, indent + 1);
            item = m + 1;
        }
        m += 1;
    }
    if item < close {
        w := (indent + 1) * 4 + range_width(&f, item, close);
        if comma & (w < 101) & (code_at(&f, close - 1) != 44) {
            write_range_comma(&mut f, view(s), item, close, indent + 1);
        } else {
            render(&mut f, view(s), item, close, indent + 1);
        }
    }
    render(&mut f, view(s), close, hi, indent);
    return true;
}
// Binary operator chain: each operator starts its continuation line.
fn op_break<a, b>(f: (&a mut F), s: &b [u8], lo: u64, hi: u64, indent: u64) -> bool {
    mut d = 0;
    mut j = lo;
    mut count = 0;
    while j < hi {
        c := code_at(&f, j);
        if opens(c) {
            d += 1;
        }
        if shuts(c) {
            if d != 0 {
                d -= 1;
            }
        }
        if (d == 0) & (lo < j) & breakable(&f, view(s), j) {
            count += 1;
        }
        j += 1;
    }
    if count == 0 {
        return false;
    }
    mut seg = lo;
    d = 0;
    j = lo;
    mut rest = 0;
    while j < hi {
        c := code_at(&f, j);
        if opens(c) {
            d += 1;
        }
        if shuts(c) {
            if d != 0 {
                d -= 1;
            }
        }
        if (d == 0) & (lo < j) & breakable(&f, view(s), j) {
            mut ind = indent;
            if rest != 0 {
                ind = indent + 1;
            }
            render(&mut f, view(s), seg, j, ind);
            rest = 1;
            seg = j;
        }
        j += 1;
    }
    render(&mut f, view(s), seg, hi, indent + 1);
    return true;
}
fn render<a, b>(f: (&a mut F), s: &b [u8], lo: u64, hi: u64, indent: u64) {
    if indent * 4 + range_width(&f, lo, hi) < 101 || hi - lo < 3 {
        write_range(&mut f, view(s), lo, hi, indent);
        return ();
    }
    if arm_break(&mut f, view(s), lo, hi, indent) {
        return ();
    }
    if op_break(&mut f, view(s), lo, hi, indent) {
        return ();
    }
    if chain_break(&mut f, view(s), lo, hi, indent) {
        return ();
    }
    if list_break(&mut f, view(s), lo, hi, indent) {
        return ();
    }
    write_range(&mut f, view(s), lo, hi, indent);
}

pub fn format<a>(source: &a [u8]) -> u8[] {
    mut f = F {
        kind: u64[],
        start: u64[],
        end: u64[],
        nl: u64[],
        code: u64[],
        generic: u64[],
        ltoken: u64[],
        lspace: u64[],
        lfirst: u64[],
        lindent: u64[],
        out: u8[],
    };
    scan(&mut f, view(source));
    mark_generics(&mut f, view(source));
    mark_pipes(&mut f, view(source));
    tail_returns(&mut f, view(source));
    layout(&mut f, view(source));
    count := f.lfirst.len();
    for i in count {
        lo := f.lfirst[i];
        mut hi = f.ltoken.len();
        if i + 1 < count {
            hi = f.lfirst[i + 1];
        }
        indent := f.lindent[i];
        if lo == hi {
            f.out.push(10);
        } else {
            render(&mut f, view(source), lo, hi, indent);
        }
    }
    return exchange(&mut f.out, u8[]);
}
