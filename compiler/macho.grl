module macho;

// A Mach-O relocatable object for macOS, as the internal assembler writes it (docs/design/
// compile-speed.md, stage 4, macOS) and laid out as LLVM's MachObjectWriter lays it out: the header,
// one unnamed LC_SEGMENT_64 with every section, LC_BUILD_VERSION, LC_SYMTAB, LC_DYSYMTAB, then the
// section contents at their addresses, the relocations section by section, the symbol table (locals,
// external definitions, undefined) and the string table.

pub struct Obj {
    cputype: u64,
    minos: u64,
    // Sections in header order: segment and section names, Mach-O flags, alignment (log2), address,
    // contents (zerofill sections have none but a size).
    seg: u8[][],
    sect: u8[][],
    flags: u64[],
    align: u64[],
    addr: u64[],
    data: u8[][],
    size: u64[],
    zerofill: u64[],
    // Relocations, in file order within their section: the section (header index), offset, type,
    // pcrel, length (log2), the symbol's table index, and an addend for an ARM64_RELOC_ADDEND entry
    // written just before it (0: none).
    r_sec: u64[],
    r_off: u64[],
    r_type: u64[],
    r_pcrel: u64[],
    r_len: u64[],
    r_sym: u64[],
    r_addend: u64[],
    // Symbols in table order.
    sym_name: u8[][],
    sym_type: u64[],
    sym_sect: u64[],
    sym_desc: u64[],
    sym_value: u64[],
    nlocal: u64,
    nextdef: u64,
    nundef: u64
}

pub fn new(cputype: u64) -> Obj {
    return Obj {
        cputype: cputype,
        minos: 0,
        seg: u8[][],
        sect: u8[][],
        flags: u64[],
        align: u64[],
        addr: u64[],
        data: u8[][],
        size: u64[],
        zerofill: u64[],
        r_sec: u64[],
        r_off: u64[],
        r_type: u64[],
        r_pcrel: u64[],
        r_len: u64[],
        r_sym: u64[],
        r_addend: u64[],
        sym_name: u8[][],
        sym_type: u64[],
        sym_sect: u64[],
        sym_desc: u64[],
        sym_value: u64[],
        nlocal: 0,
        nextdef: 0,
        nundef: 0
    };
}

fn w8<a>(out: (&a mut u8[]), v: u64) {
    out.push(v & 255);
}
fn w16<a>(out: (&a mut u8[]), v: u64) {
    out.push(v & 255);
    out.push((v >> 8) & 255);
}
fn w32<a>(out: (&a mut u8[]), v: u64) {
    out.push(v & 255);
    out.push((v >> 8) & 255);
    out.push((v >> 16) & 255);
    out.push((v >> 24) & 255);
}
fn w64<a>(out: (&a mut u8[]), v: u64) {
    w32(&mut out, v & 0xffffffff);
    w32(&mut out, v >> 32);
}
fn name16<a, b>(out: (&a mut u8[]), name: &b [u8]) {
    for i in 16 {
        if i < name.len() {
            out.push(name[i]);
        } else {
            out.push(0);
        }
    }
}
fn up(v: u64, a: u64) -> u64 {
    return (v + a - 1) / a * a;
}

pub fn write<a>(o: (&a Obj)) -> u8[] {
    n := o.seg.len();
    sizeofcmds := (72 + 80 * n) + 24 + 24 + 80;
    fileoff := 32 + sizeofcmds;
    mut filesize = 0;
    mut vmsize = 0;
    for k in n {
        end := o.addr[k] + o.size[k];
        if end > vmsize {
            vmsize = end;
        }
        if (o.zerofill[k] == 0) && (end > filesize) {
            filesize = end;
        }
    }
    // Relocation counts (an addend entry counts too) and offsets.
    mut nrel = u64[];
    for k in n {
        nrel.push(0);
    }
    for i in o.r_sec.len() {
        mut c = 1;
        if o.r_addend[i] != 0 {
            c = 2;
        }
        nrel[o.r_sec[i]] = nrel[o.r_sec[i]] + c;
    }
    mut at = up(fileoff + filesize, 8);
    mut reloff = u64[];
    for k in n {
        if nrel[k] != 0 {
            reloff.push(at);
            at += 8 * nrel[k];
        } else {
            reloff.push(0);
        }
    }
    symoff := at;
    nsyms := o.sym_name.len();
    stroff := symoff + 16 * nsyms;
    mut strtab = u8[];
    strtab.push(0);
    mut strx = u64[];
    for i in nsyms {
        strx.push(strtab.len());
        strtab.append(view(o.sym_name[i]));
        strtab.push(0);
    }
    while strtab.len() % 8 != 0 {
        strtab.push(0);
    }
    mut out = u8[];
    w32(&mut out, 0xfeedfacf);
    w32(&mut out, o.cputype);
    w32(&mut out, 0);
    w32(&mut out, 1);
    w32(&mut out, 4);
    w32(&mut out, sizeofcmds);
    w32(&mut out, 0);
    w32(&mut out, 0);
    // LC_SEGMENT_64
    w32(&mut out, 0x19);
    w32(&mut out, 72 + 80 * n);
    name16(&mut out, view(""));
    w64(&mut out, 0);
    w64(&mut out, vmsize);
    w64(&mut out, fileoff);
    w64(&mut out, filesize);
    w32(&mut out, 7);
    w32(&mut out, 7);
    w32(&mut out, n);
    w32(&mut out, 0);
    for k in n {
        name16(&mut out, view(o.sect[k]));
        name16(&mut out, view(o.seg[k]));
        w64(&mut out, o.addr[k]);
        w64(&mut out, o.size[k]);
        if o.zerofill[k] != 0 {
            w32(&mut out, 0);
        } else {
            w32(&mut out, fileoff + o.addr[k]);
        }
        w32(&mut out, o.align[k]);
        w32(&mut out, reloff[k]);
        w32(&mut out, nrel[k]);
        w32(&mut out, o.flags[k]);
        w32(&mut out, 0);
        w32(&mut out, 0);
        w32(&mut out, 0);
    }
    // LC_BUILD_VERSION: macOS, the minimum version, no SDK, no tools.
    w32(&mut out, 0x32);
    w32(&mut out, 24);
    w32(&mut out, 1);
    w32(&mut out, o.minos);
    w32(&mut out, 0);
    w32(&mut out, 0);
    // LC_SYMTAB
    w32(&mut out, 0x2);
    w32(&mut out, 24);
    w32(&mut out, symoff);
    w32(&mut out, nsyms);
    w32(&mut out, stroff);
    w32(&mut out, strtab.len());
    // LC_DYSYMTAB
    w32(&mut out, 0xb);
    w32(&mut out, 80);
    w32(&mut out, 0);
    w32(&mut out, o.nlocal);
    w32(&mut out, o.nlocal);
    w32(&mut out, o.nextdef);
    w32(&mut out, o.nlocal + o.nextdef);
    w32(&mut out, o.nundef);
    for i in 12 {
        w32(&mut out, 0);
    }
    // Section contents at their addresses.
    for k in n {
        if o.zerofill[k] == 0 {
            while out.len() < fileoff + o.addr[k] {
                out.push(0);
            }
            out.append(view(o.data[k]));
        }
    }
    while out.len() < up(fileoff + filesize, 8) {
        out.push(0);
    }
    for k in n {
        for i in o.r_sec.len() {
            if o.r_sec[i] == k {
                if o.r_addend[i] != 0 {
                    w32(&mut out, o.r_off[i]);
                    w32(&mut out, (o.r_addend[i] & 0xffffff) | (2 << 25) | (10 << 28));
                }
                w32(&mut out, o.r_off[i]);
                w32(&mut out, (o.r_sym[i] & 0xffffff) | (o.r_pcrel[i] << 24) | (o.r_len[i] << 25) | (1 << 27) | (o.r_type[i] << 28));
            }
        }
    }
    for i in nsyms {
        w32(&mut out, strx[i]);
        w8(&mut out, o.sym_type[i]);
        w8(&mut out, o.sym_sect[i]);
        w16(&mut out, o.sym_desc[i]);
        w64(&mut out, o.sym_value[i]);
    }
    out.append(view(strtab));
    return out;
}
