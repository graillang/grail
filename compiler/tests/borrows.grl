module borrows;
struct Numbers {
    first: u64,
    second: u64
}
struct Inner {
    n: u64
}
struct Outer {
    left: Inner,
    right: Inner
}
struct Borrowed<a> {
    views: (&a [u8])[]
}
fn relay<a>(r: (&a mut u64)) -> (&a mut u64) {
    return r;
}
fn right<a>(r: (&a Outer)) -> (&a Inner) {
    return &r.right;
}
fn keep_views<a>(r: &a [u8]) -> Borrowed<a> {
    mut v = (&a [u8])[];
    v.push(r);
    return Borrowed { views: v };
}
fn count<a>(v: (&a [u8])[]) -> u64 {
    r := &v[0];
    return (view((load(r)))).len();
}
pub fn run() -> u64 {
    mut b = u8[];
    b.push(7);
    parent := view(b);
    child := view(parent);
    drop(parent);
    assert(child[0] == 7);
    // A unique carrier resumes after its readonly derivation's last use.
    m := view_mut(b);
    r := view(m);
    assert(r[0] == 7);
    write(m, 0, 9);
    assert(b[0] == 9);
    // Numeric storage and references do not need heap allocations.
    mut n = 1;
    r := relay(&mut n);
    exchange(r, 8);
    assert(n == 8);
    mut pair = Numbers { first: 1, second: 2 };
    a := &mut pair.first;
    b := &mut pair.second;
    exchange(a, 7);
    exchange(b, 8);
    assert(pair.first + pair.second == 15);
    // A copied scalar ends an element loan before vector reallocation.
    mut values = u64[];
    values.push(1);
    slot := &values[0];
    copied := load(slot);
    values.push(2);
    assert(copied + values.len() == 3);
    // Hidden return targets keep the whole compatible frame, not a guessed projection.
    mut outer = Outer { left: Inner { n: 1 }, right: Inner { n: 2 } };
    p := right(&outer);
    q := &p.n;
    saved := load(q);
    outer.right = Inner { n: 8 };
    assert(saved == 2);
    // Moving a reference-containing field retains its data-source guards.
    mut bytes = u8[];
    bytes.push(42);
    box := keep_views(view(bytes));
    views := box.views;
    drop(box);
    assert(count(views) == 1);
    return 4242;
}
