// A method that only reads takes `&self`; a `&mut [u64]` receiver does not satisfy it, because the (fuzz: refused)
// two slice types differ in mode and nothing here converts one to the other.
impl [u64] {
    fn read_only(&self) -> u64 {
        return self.len();
    }
}
fn main() {
    mut values = u64[1, 2];
    mut head = &mut values[0: 2];
    println(head.read_only());
}
