fn touch<a>(log: (&a mut u64)) -> bool {
    exchange(log, load(log) + 1);
    return true;
}
fn is_even(n: u64) -> bool {
    return n % 2 == 0;
}
fn count(v: bool[]) -> u64 {
    mut n = 0;
    for i in v.len() {
        if v[i] {
            n += 1;
        }
    }
    return n;
}
struct Flags {
    ready: bool,
    done: bool
}
fn main() {
    t := true;
    f := false;
    assert(t && !f);
    assert(f || t);
    assert(!(f || f));
    assert((t & t) == true);
    assert((t | f) == true);
    assert((t ^ t) == false);
    mut calls = 0;
    if f && touch(&mut calls) {
        assert(false);
    }
    if t || touch(&mut calls) {}
    assert(calls == 0);
    if t && touch(&mut calls) {}
    assert(calls == 1);
    assert(is_even(4) && !is_even(3));
    flags := Flags { ready: true, done: false };
    assert(flags.ready && !flags.done);
    assert(count(bool[true, false, true]) == 2);
    n := u64(t) + u64(t);
    assert(n == 2);
    old := (1 == 1) + (2 == 2);
    assert(old == 2);
    assert(3 > 2 && 2 >= 2 && 1 <= 1 && !(1 > 2));
    println(t);
    println(!t);
    println(3 < 2);
}
