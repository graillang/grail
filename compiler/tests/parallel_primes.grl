use concurrent_map;

fn is_prime(n: u64) -> bool {
    if n < 2 {
        return false;
    }
    mut d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d += 1;
    }
    return true;
}
fn count_range<r>(chunk: u64, results: (&r concurrent_map::Map<u64, u64>)) -> u64 {
    mut found = 0;
    for n in chunk * 10000..(chunk + 1) * 10000 {
        if is_prime(n) {
            found += 1;
        }
    }
    concurrent_map::insert(results, chunk, found);
    return found;
}
fn body<s, r>(
    sc: (&s Scope< (&r concurrent_map::Map<u64, u64>) >),
    results: (&r concurrent_map::Map<u64, u64>)
) -> u64 {
    mut handles = Task<u64>[];
    for chunk in 8 {
        handles.push(spawn(sc, chunk, count_range));
    }
    mut total = 0;
    while handles.len() != 0 {
        total += join(handles.pop());
    }
    return total;
}
fn main() {
    results := concurrent_map::with_seed<u64, u64>(1, 2);
    total := task_scope(borrow(results), body);
    println("primes below 80000: {}", total);
    println("chunks recorded: {}", concurrent_map::len(borrow(results)));
    counts := parallel_map(u64[0, 1, 2, 3], 0, |c: u64, unused: u64| -> u64 c);
}
