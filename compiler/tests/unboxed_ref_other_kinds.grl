// Stage 1a changes what a reference to a record is and nothing else: a reference to an enum, a
// vector, a string or a number is still the address of the word that holds it, so assigning and
// exchanging through one replaces that word.
enum Light {
    Off,
    On(u64)
}
struct Lamp {
    light: Light,
    log: u64[],
    name: string,
    watts: u64
}
fn level(l: (&Light)) -> u64 {
    match l {
        Off => { return 0; },
        On(n) => { return n; },
    }
}
fn set_light<a>(l: (&a mut Light), n: u64) {
    *l = Light::On(n);
}
fn swap_light<a>(l: (&a mut Light)) -> Light {
    return exchange(l, Light::Off);
}
fn set_log<a>(v: (&a mut u64[])) {
    *v = u64[7, 8, 9];
}
fn swap_log<a>(v: (&a mut u64[])) -> u64[] {
    return exchange(v, u64[1]);
}
fn set_name<a>(s: (&a mut string)) {
    *s = "renamed";
}
fn swap_name<a>(s: (&a mut string)) -> string {
    return exchange(s, "again");
}
fn set_watts<a>(n: (&a mut u64)) {
    *n = *n + 40;
}
fn swap_watts<a>(n: (&a mut u64)) -> u64 {
    return exchange(n, 5);
}
fn main() -> u64 {
    mut light = Light::Off;
    set_light(&mut light, 3);
    was := swap_light(&mut light);
    println("{} {}", level(&was), level(&light));
    mut log = u64[1, 2];
    set_log(&mut log);
    old := swap_log(&mut log);
    println("{} {} {}", old.len(), old[2], log.len());
    mut name = "first";
    set_name(&mut name);
    prior := swap_name(&mut name);
    println("{} {}", prior, name);
    mut watts = 60;
    set_watts(&mut watts);
    println("{} {}", swap_watts(&mut watts), watts);

    mut lamp = Lamp { light: Light::On(1), log: u64[], name: "lamp", watts: 10 };
    set_light(&mut lamp.light, 9);
    set_log(&mut lamp.log);
    set_name(&mut lamp.name);
    set_watts(&mut lamp.watts);
    a := swap_light(&mut lamp.light);
    b := swap_log(&mut lamp.log);
    d := swap_name(&mut lamp.name);
    e := swap_watts(&mut lamp.watts);
    println("{} {} {} {}", level(&a), b.len(), d, e);
    println("{} {} {} {}", level(&lamp.light), lamp.log.len(), lamp.name, lamp.watts);

    mut lights = Light[Light::On(4), Light::Off];
    set_light(&mut lights[1], 6);
    f := swap_light(&mut lights[0]);
    println("{} {} {}", level(&f), level(&lights[0]), level(&lights[1]));
    return 0;
}
