// Verifies LLVM `noalias` on exclusive `&mut` parameters (and absence on shared `&`),
// lifted `rt_push` / `rt_push4` / `rt_pushb` fast paths with TBAA tags, and `!DILocation` metadata.
fn update_pair(dst: &mut u64, src: &u64, out: &mut u64) {
    *dst = *dst + *src;
    *out = *dst * 2;
}

fn fill_all(n: u64) -> u64 {
    mut v64 = u64[];
    mut v32 = u32[];
    mut v8 = u8[];
    for i in n {
        v64.push(i * 3);
        v32.push(u32(i * 5));
        v8.push(u8(i & 255));
    }
    return v64[n - 1] + u64(v32[n - 1]) + u64(v8[n - 1]);
}

fn main() {
    mut a: u64 = 10;
    b: u64 := 7;
    mut c: u64 = 0;
    update_pair(&mut a, &b, &mut c);
    println("{} {}", a, c);
    println(fill_all(64));
}
