fn total(v:vec<u32>)->u32{mut sum=0u32;for x in v{sum=sum+x;}return sum;}
fn main(){
    mut sum=0;for x in vec<num>[1,2,3,4]{sum+=x;}assert(sum==10);
    assert(total(vec<u32>[5u32,6u32])==11);
    word:="héllo".text();mut n=0;for b in word{if b>127{n+=1;}}assert(n==2);
    data:=bytes[1,2,3];mut t=0;for b in &data{t+=b;}assert(t==6);
    flags:=vec<bool>[true,false,true];mut on=0;for f in flags{if f{on+=1;}}assert(on==2);
    v:=vec<num>[10,20];mut seen=0;for x in v{if x==20{break;}seen+=x;}assert(seen==10);
    println(42);
}
