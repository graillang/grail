module const_float_fold;
use const_float_values;

// Float constants declared in another module fold their expressions at compile time
// (`1.0 / 3.0` used to stop the parse at the `/`: "expected `;`, found `/`").
fn main() -> u64 {
    println("{} {} {} {} {}", const_float_values::THIRD, const_float_values::EIGHT, const_float_values::NEG, const_float_values::NEG_THIRD, const_float_values::CHAIN);
    println("{} {} {} {} {}", const_float_values::F32_THIRD, const_float_values::PLAIN, const_float_values::PLAIN_NEG, const_float_values::HALF_N, const_float_values::SMALL);
    println("{}", f32_bits(const_float_values::F32_THIRD));
    return 0;
}
