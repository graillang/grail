module generic_constructors;
struct Holder<T> {
    item: T | string
}
enum Box<T> {
    Item(T | string)
}
fn main() {
    a := Holder<num> { item: 42 };
    b := Box<num>::Item(7);
    match a.item {
        num(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
    match b {
        Item(v) => {
            match v {
                num(n) => {
                    println(n);
                },
                string(s) => {
                    println(s);
                }
            }
        }
    }
}
