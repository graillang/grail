module errs_chain;
use errs;
use io;

// The Error interface answers for every shape it has an implementation for, so a reporter that takes
// any error needs to know nothing about the concrete type it was handed.
fn reported<T: errs::Error>(error: &T) -> u8[] {
    return errs::Error::message(error);
}

// A message error and a three-frame chain, printed: the whole of what an error reports is its text,
// so the message alone is one line and the chain is one line with the cause last.
fn main() {
    message := errs::report(view("cannot open /etc/app.conf"));
    assert(message.show() == view("cannot open /etc/app.conf"));
    message.to_stderr();
    mut chain = errs::report(view("not found"));
    chain = chain.context(view("while opening /x"));
    chain = chain.context(view("while parsing config"));
    chain = chain.context(view("while loading app"));
    assert(chain.depth() == 3);
    assert(chain.cause() == view("not found"));
    assert(chain.frame(0) == view("while opening /x"));
    assert(chain.frame(2) == view("while loading app"));
    assert(chain.show() == view("while loading app: while parsing config: while opening /x: not found"));
    chain.to_stderr();
    // A program's own message record becomes a chain, and one interface answers for all three shapes.
    record := errs::of(errs::Message::new(view("bad input")));
    assert(record.show() == view("bad input"));
    assert(reported(&record) == view("bad input"));
    os_error := io::Error::PermissionDenied;
    assert(reported(&os_error) == view("permission denied"));
    println("ok");
}
