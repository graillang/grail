module borrowed_match;
fn show<a>(value: &a(num | string)) {
    match value {
        num(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
}
fn main() {
    x: num | string := 42;
    show(borrow(x));
    y: num | string := "hello".text();
    show(borrow(y));
}
