module borrowed_match;
fn show<a>(value: &a(u64 | string)) {
    match value {
        u64(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
}
fn main() {
    x: u64 | string := 42;
    show(borrow(x));
    y: u64 | string := "hello".text();
    show(borrow(y));
}
