enum Light {
    Off,
    On(u64)
}
fn find(v: &u64[], x: u64) -> u64? {
    for i in v.len() {
        if v[i] == x {
            return Some(i);
        }
    }
    return None;
}
fn level(l: Light) -> u64 {
    match l {
        Off => { return 0; },
        On(n) => { return n; },
    }
}
fn main() {
    mut v = u64[];
    for i in 100 {
        v.push(i * 3);
    }
    println(find(&v, 30)!);
    println(find(&v, 31).is_none());
    mut total = 0;
    while let Some(x) = v.pop() {
        total = total + x;
    }
    println(total);
    lights := Light[Light::On(4), Light::Off, Light::On(9)];
    mut s = 0;
    for l in lights {
        s = s + level(l);
    }
    println(s);
    o: u64? := None;
    println(o.is_some());
}
