use hashmap;
use vecs;
use order;

struct Count {
    word: string,
    n: u64,
}
impl order::Ord for Count {
    fn less<a, b>(left: (&a Self), right: (&b Self)) -> bool {
        if left.n != right.n {
            return left.n > right.n;
        }
        return left.word < right.word;
    }
}
fn words_of(text: string) -> string[] {
    mut out = string[];
    mut current = u8[];
    for b in text.to_lower() {
        letter := (b >= 'a' && b <= 'z') || b >= 128 || b == '\'';
        if letter {
            current.push(b);
        } else {
            if !current.is_empty() {
                out.push(current.text());
                current = u8[];
            }
        }
    }
    if !current.is_empty() {
        out.push(current.text());
    }
    return out;
}
fn main() {
    text := "The quick brown fox jumps over the lazy dog. The dog sleeps; the fox runs! Ünïcode wörds count too, ünïcode.".text();
    mut counts = hashmap::with_seed<string, u64>(3, 5);
    mut words = words_of(text);
    total := words.len();
    while !words.is_empty() {
        w := words.pop()!;
        if counts.contains(&w) {
            slot := counts.get_mut(&w)!;
            exchange(slot, load(slot) + 1);
        } else {
            counts.insert(w, 1);
        }
    }
    mut ranked = Count[];
    for i in counts.len() {
        ranked.push(
            Count {
                word: counts.key_at(i).copy().text(),
                n: load(counts.value_at(i)),
            }
        );
    }
    ranked.sort();
    println("{} words, {} distinct", total, ranked.len());
    for i in 5 {
        c := &ranked[i];
        println("{:>2}. {:<8} {}", i + 1, c.word, c.n);
    }
}
