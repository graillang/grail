module generic_types;
struct Pair<type T,type U> { first:T, second:U }
enum Option<type T> { Some(T), None }
struct Nested<type T> { items:vec<T> }
struct Captured<a,type T> { item:T, view:read<a> }
fn make()->Pair<bytes,string> {var b =bytes();push(b,9);return Pair{first:b,second:"generic"};}
fn none()->Option<bytes> {return Option::None;}
fn captured<a>(v:read<a>)->Captured<a,num> {return Captured{item:12,view:v};}
pub fn run()->num {
 p :=make();assert(len(p.first)==1);assert(len(p.second)==7);
 q :=Pair<num,bytes>{first:11,second:bytes()};assert(q.first==11);
 inferred :=Pair<bytes,num>{first:bytes(),second:17};assert(inferred.second==17);
 nested :=Nested<bytes>{items:vec<bytes>()};assert(len(nested.items)==0);
 some :=Option<bytes>::Some(bytes());match some{Some(b)=>{assert(len(b)==0);},None=>{assert(0);}}
 match none(){Some(b)=>{assert(0);},None=>{assert(1);}}
 empty :=Option<string>::None;drop(empty);
 var b =bytes();push(b,3);c :=captured(read(b));assert(c.item==12);assert(at(c.view,0)==3);
 return 818;
}
