module generic_types;
struct Pair<T,U> { first:T, second:U }
enum Option<T> { Some(T), None }
struct Nested<T> { items:vec<T> }
struct Captured<a,T> { item:T, view:read<a> }
fn make()->Pair<bytes,string> {mut b =bytes[];b.push(9);return Pair{first:b,second:"generic"};}
fn none()->Option<bytes> {return Option::None;}
fn captured<a>(v:read<a>)->Captured<a,num> {return Captured{item:12,view:v};}
pub fn run()->num {
 p :=make();assert(p.first.len()==1);assert(p.second.len()==7);
 q :=Pair<num,bytes>{first:11,second:bytes[]};assert(q.first==11);
 inferred :=Pair<bytes,num>{first:bytes[],second:17};assert(inferred.second==17);
 nested :=Nested<bytes>{items:vec<bytes>[]};assert(nested.items.len()==0);
 some :=Option<bytes>::Some(bytes[]);match some{Some(b)=>{assert(b.len()==0);},None=>{assert(0);}}
 match none(){Some(b)=>{assert(0);},None=>{assert(1);}}
 empty :=Option<string>::None;drop(empty);
 mut b =bytes[];b.push(3);c :=captured(&b);assert(c.item==12);assert(c.view[0]==3);
 return 818;
}
