module generic_types;
struct Pair<T, U> {
    first: T,
    second: U
}
enum Option<T> {
    Some(T),
    None
}
struct Nested<T> {
    items: T[]
}
struct Captured<a, T> {
    item: T,
    view: read<a>
}
fn make() -> Pair<u8[], string> {
    mut b = u8[];
    b.push(9);
    return Pair { first: b, second: "generic" };
}
fn none() -> Option<u8[]> {
    return Option::None;
}
fn captured<a>(v: read<a>) -> Captured<a, u64> {
    return Captured { item: 12, view: v };
}
pub fn run() -> u64 {
    p := make();
    assert(p.first.len() == 1);
    assert(p.second.len() == 7);
    q := Pair<u64, u8[]> { first: 11, second: u8[] };
    assert(q.first == 11);
    inferred := Pair<u8[], u64> { first: u8[], second: 17 };
    assert(inferred.second == 17);
    nested := Nested<u8[]> { items: u8[][] };
    assert(nested.items.len() == 0);
    some := Option<u8[]>::Some(u8[]);
    match some {
        Some(b) => {
            assert(b.len() == 0);
        },
        None => {
            assert(0);
        }
    }
    match none() {
        Some(b) => {
            assert(0);
        },
        None => {
            assert(1);
        }
    }
    empty := Option<string>::None;
    drop(empty);
    mut b = u8[];
    b.push(3);
    c := captured(&b);
    assert(c.item == 12);
    assert(c.view[0] == 3);
    return 818;
}
