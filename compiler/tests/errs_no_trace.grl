module errs_no_trace;
use errs;

// A build that carries no site tables captures no stack at all: the report prints its message alone
// instead of a stack it would have had to guess. Run with --debug, which emits none.
fn main() {
    r := errs::traced(view("missing"));
    assert(r.trace().len() == 0);
    r.to_stderr();
    println("ok");
}
