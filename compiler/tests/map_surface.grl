use hashmap;
type Counts = [string: i64];
struct Holder {
    values: [string: i64]
}
fn empty() -> Counts {
    return [:];
}
fn count(values: Counts) -> u64 {
    return values.len();
}
fn fill(values: &mut Counts) {
    values["filled"] = 4;
    values["filled"] += 3;
}
fn key() -> string {
    println(10);
    return "ordered";
}
fn value() -> i64 {
    println(20);
    return 9;
}
fn maybe(values: &Counts, key: &string) -> i64? {
    result := values.get(key)?;
    return Some(load(result));
}
fn main() {
    mut values: Counts = ["a": 1, "b": 2, "a": 3];
    assert(values.len() == 2);
    assert(values["a"] == 3);
    lookup := "b";
    assert(values[lookup] == 2);
    assert(lookup == "b");
    values[key()] = value();
    assert(values["ordered"] == 9);
    values["a"] += values["b"];
    values["b"] = values["a"];
    assert(values["a"] == 5);
    assert(values["b"] == 5);
    values[lookup] -= 1;
    assert(lookup == "b");
    assert(values[lookup] == 4);
    fill(&mut values);
    assert(values["filled"] == 7);
    reference := &values["a"];
    assert(load(reference) == 5);
    assert(maybe(&values, &"a")! == 5);
    assert(maybe(&values, &"absent").is_none());
    assert(count(["context": 1]) == 1);
    assert(empty().len() == 0);
    inferred := ["inferred": 6];
    assert(inferred["inferred"] == 6);
    random := [string: i64]();
    seeded := [string: i64]::with_seed(1, 2);
    assert(random.len() == 0);
    assert(seeded.len() == 0);
    mut owned: [string: u8[]] = ["a": u8[1, 2]];
    owned["a"] = u8[3];
    owned["b"] = u8[4, 5, 6];
    assert(owned["a"].len() == 1);
    assert(owned["b"].len() == 3);
    removed := owned.remove(&"b")!;
    assert(removed.len() == 3);
    mut holder = Holder { values: [:] };
    holder.values["a"] = 1;
    holder.values["a"] += 2;
    assert(holder.values["a"] == 3);
    holder.values = [:];
    assert(holder.values.len() == 0);
    values = [:];
    assert(values.len() == 0);
    nested: [string: [string: i64]] := ["a": ["b": 8]];
    assert(nested["a"]["b"] == 8);
    mut grown: [u64: u8[]] = [:];
    for i in 40 { grown[i] = u8[1, 2]; }
    for i in 40 { grown[i] = u8[3]; }
    assert(grown.len() == 40);
    assert(grown[39].len() == 1);
    println(42);
}
