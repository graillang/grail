use vecs;
use order;
struct Person {
    name: string,
    age: u32
}
impl order::Ord for Person {
    fn less<a, b>(left: (&a Self), right: (&b Self)) -> bool {
        return left.age < right.age;
    }
}
fn main() {
    mut nums = u64[5, 3, 9, 1, 3, 7];
    vecs::sort(&mut nums);
    for x in nums {
        print("{} ", x);
    }
    println();
    mut words = string["pear".text(), "apple".text(), "fig".text(), "äpfel".text()];
    vecs::sort(&mut words);
    for i in words.len() {
        print("{} ", &words[i]);
    }
    println();
    mut people = Person[
        Person { name: "Ann".text(), age: 40 },
        Person { name: "Bob".text(), age: 25 },
        Person { name: "Cy".text(), age: 40 },
        Person { name: "Di".text(), age: 25 }
    ];
    vecs::sort(&mut people);
    for i in people.len() {
        p := &people[i];
        print("{}:{} ", p.name, p.age);
    }
    println();
    mut floats = f64[2.5, -1.0, 0.0 / 0.0, 0.5];
    vecs::sort(&mut floats);
    for x in floats {
        print("{} ", x);
    }
    println();
    assert(vecs::is_sorted(&people));
    println(vecs::max_index(&nums));
    mut big = u64[];
    mut s = 7;
    for i in 2000 {
        s = (s * 1103515245 + 12345) % 2147483648;
        big.push(s % 1000);
    }
    vecs::sort(&mut big);
    assert(vecs::is_sorted(&big));
    assert(big.len() == 2000);
    println("sorted");
}
