module union_propagate;
fn inner(n: u64) -> u64 | string {
    if n == 0 {
        return "oops".text();
    }
    return n;
}
fn outer(n: u64) -> u64 | bool | string {
    value := inner(n)?;
    return value + 1;
}
fn main() {
    match outer(3) {
        u64(v) => {
            println(v);
        },
        bool(v) => {
            println(v);
        },
        string(v) => {
            println(v);
        }
    }
    match outer(0) {
        u64(v) => {
            println(v);
        },
        bool(v) => {
            println(v);
        },
        string(v) => {
            println(v);
        }
    }
}
