// An f32 local whose address is taken must lose its fact: the slot can then be written through an
// untyped pointer, so the lifter keeps it an untyped word (an absent fact is always correct).
fn bump(p: &mut f32) {
    *p = *p + f32(1.25);
}
fn main() {
    mut t: f32 = f32(2.5);
    bump(&mut t);
    println(f64(t));
}
