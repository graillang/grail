// SEQ-STABLE fixture (docs/design/release-builds-and-parity.md): slices read and written in loops,
// whose descriptors the LLVM lifter loads once per function, and a vector that grows inside the
// loop that reads it - the case a slice fact must never be claimed for (`--f1-what=5` forges it).
fn scale(x: (&mut [f64]), y: (&[f64]), a: f64) {
    mut i = 0;
    while i < x.len() {
        x[i] = x[i] * a + y[i];
        i += 1;
    }
}
fn sum(x: (&[u32])) -> u64 {
    mut s: u64 = 0;
    for i in x.len() {
        s = s + u64(x[i]);
    }
    return s;
}
fn main() {
    mut x = f64[];
    mut y = f64[];
    mut z = u32[];
    for i in 100 {
        x.push(f64(i));
        y.push(0.5);
        z.push(u32(i * 3));
    }
    scale(&mut x[0: 100], &y[0: 100], 2.0);
    println(x[99]);
    println(sum(&z[10: 60]));
    mut grow = u64[];
    grow.push(1);
    for i in 40 {
        grow.push(grow[i] + i);
    }
    println(grow[40]);
}
