module concise_refs;
fn read_value<a>(x: &a num) -> num {
    return load(x);
}
fn increment<a>(x: &mut a num) {
    exchange(x, load(x) + 1);
}
fn hold<a>(x: &a num[]) -> num {
    return x.len();
}
fn pick<a>(x: &a num) -> num | &a num {
    return x;
}
fn inspect<a>(x: &a num) {
    match pick(x) {
        num(v) => {
            println(v);
        },
        &a num(v) => {
            println(load(v));
        }
    }
}
fn main() {
    mut n = 41;
    increment(borrow_mut(n));
    println(read_value(borrow(n)));
    values := num[1, 2];
    println(hold(borrow(values)));
    inspect(borrow(n));
}
