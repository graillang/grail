module concise_refs;
fn read_value<a>(x: &a u64) -> u64 {
    return load(x);
}
fn increment<a>(x: &a mut u64) {
    exchange(x, load(x) + 1);
}
fn hold<a>(x: &a u64[]) -> u64 {
    return x.len();
}
fn pick<a>(x: &a u64) -> u64 | &a u64 {
    return x;
}
fn inspect<a>(x: &a u64) {
    match pick(x) {
        u64(v) => {
            println(v);
        },
        &a u64(v) => {
            println(load(v));
        }
    }
}
fn main() {
    mut n = 41;
    increment(&mut n);
    println(read_value(&n));
    values := u64[1, 2];
    println(hold(&values));
    inspect(&n);
}
