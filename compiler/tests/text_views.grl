// The text-cutting methods hand out views: empty fields, Unicode pieces, the trims, CRLF lines,
// words; `split_owned` pieces that outlive their text; `append_format` onto a string and onto bytes.
use strings;
fn keep() -> u8[][] {
    text := "a,,b".copy();
    return text.split_owned(44);
}
fn main() {
    fields := "x,,y,".split(44);
    println("{} [{}] [{}] [{}] [{}]", fields.len(), fields[0], fields[1], fields[2], fields[3]);
    println("{}", "".split(44).len());
    for piece in "größe·straße".split(194) {
        print("<{}>", piece.len());
    }
    println("");
    println("[{}] [{}] [{}]", "  hi \t".trim(), "  hi ".trim_start(), "  hi ".trim_end());
    lines := "one\r\ntwo\n\nthree".lines();
    println("{} [{}] [{}] [{}] [{}]", lines.len(), lines[0], lines[1], lines[2], lines[3]);
    words := " a  bc\td\n".split_whitespace();
    println("{} {}", words.len(), words.join_with(view("+")).text());
    kept := keep();
    println("{} [{}] [{}]", kept.len(), kept[0].text(), kept[2].text());
    mut out = "s:";
    out.append_format("{}+{}={};", 2, 3, 2 + 3);
    out.append_format("{}{}", "é", true);
    println("{}", out);
    mut bytes = u8[];
    bytes.append_format("[{}]", 42);
    println("{} {}", bytes.len(), bytes.text());
}
