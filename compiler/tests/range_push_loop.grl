// A loop that pushes moves the vector's length generation on every iteration, so without widening
// the fixpoint never converged and nothing was decided. Widened at the loop head, the generation
// settles; the length's lower bound stays 10 (a push only grows it) and the guard holds `i` in
// [0, 4], so `v[i]` is proved. Every index is in range (len 10 + i > i), so all builds print 0.
fn main() {
    mut v = u8[0; 10];
    mut i: u64 = 0;
    mut s: u64 = 0;
    while i < 5 {
        s += u64(v[i]);
        v.push(0);
        i += 1;
    }
    println(s);
}
