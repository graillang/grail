// A loop that pushes moves the vector's length generation on every iteration, so the fixpoint
// does not converge within its round cap; with no converged state there is no verdict, and `v[i]`
// keeps its check. Every index is in range (len 10 + i > i), so all builds print 0.
fn main() {
    mut v = u8[0; 10];
    mut i: u64 = 0;
    mut s: u64 = 0;
    while i < 5 {
        s += u64(v[i]);
        v.push(0);
        i += 1;
    }
    println(s);
}
