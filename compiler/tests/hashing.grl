use hash;
// All 64 official SipHash-2-4 vectors: https://github.com/veorq/SipHash/blob/master/vectors.h
struct Key{number:num}
impl hash::Hash for Key{fn hash<a,b>(key:ref<a,Self>,state:ref_mut<b,hash::Hasher>){hash::write_num(state,key.number);}}
impl hash::Equal for Key{fn equal<a,b>(left:ref<a,Self>,right:ref<b,Self>)->num{return left.number==right.number;}}
fn main(){
 expected:=num[8246050544436514353,8428550223375919101,967288799772626778,9612764727700323885,14927063180398135223,1762690195596617357,14684345499771659214,12322412585038238007,10661697595502699618,11385243752477615280,8817410102741809651,17632488944357322151,8439340791604635131,1507111754042457488,17808300073767596782,11613035633349379557,4551675220716592091,7609651759622801300,5458842069249151900,13505671986754970045,13751280707121114776,15056320461803317191,10615942640109305480,12109057401368137416,13307381289415454612,13610321033394764010,1718182323771086323,3399761846665465773,16018647108141566373,12007247957814764913,12504142468843433768,3663839902933566274,8153574914611379406,12102055411412728035,1360280716319199800,1576317954979633070,3552776872709694388,178333021418699137,14617792573217180749,11150869205492134748,1026444043506460624,12469414959406143890,1761759337908409769,15322946588829625237,17957335083907161586,12201253063246567303,15824186602498598160,15018546865153603051,16578493273242052945,14368424742064336790,17177928935062830706,11642602692479882842,758724319039419570,9346067901451639663,9198639672290634986,2618616414355072153,13226438439979549629,16869029984879647243,6982299211676602387,7351800817158466451,7828642298779898337,11484862539558692339,16508850846422949719,10775480364379293042];
 for length in expected.len(){mut state=hash::hasher(506097522914230528,1084818905618843912);for i in length{hash::write_byte(borrow_mut(state),i);}assert(hash::finish(state)==expected[length]);}
 a:=Key{number:42};b:=Key{number:42};c:=Key{number:43};assert(hash::equal(borrow(a),borrow(b)));assert(hash::equal(borrow(a),borrow(c))==false);
 assert(hash::hash(borrow(a),1,2)==hash::hash(borrow(b),1,2));assert(hash::hash(borrow(a),1,2)!=hash::hash(borrow(a),3,4));
 x:=u8[1,2,3];y:=u8[1,2,3];z:=u8[1,2];assert(hash::equal(borrow(x),borrow(y)));assert(hash::equal(borrow(x),borrow(z))==false);
 assert(hash::hash(borrow(x),1,2)==hash::hash(borrow(y),1,2));
 first:="café".text();second:="café".text();assert(hash::equal(borrow(first),borrow(second)));assert(hash::hash(borrow(first),1,2)==hash::hash(borrow(second),1,2));
 println(42);
}
