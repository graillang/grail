use hashmap;

// Iterating a map: keys and values as references into it, and both at once. Storage order is
// insertion order (like Python's dict); `btree` is the ordered map.
fn main() -> u64 {
    m: [string: u64] = ["a": 1, "b": 2, "c": 3];
    for k in m.keys() {
        println(k);
    }
    mut total = 0;
    for v in m.values() {
        total += *v;
    }
    println(total);
    for pair in m.iter() {
        key := pair.0;
        println("{} {}", key, *pair.1);
    }
    // An emptied map iterates zero times rather than yielding a stale slot.
    mut drained: [string: u64] = ["x": 9];
    _ := drained.remove(&"x");
    mut n = 0;
    for k in drained.keys() {
        n += 1;
    }
    println(n == 0);
    return 0;
}
