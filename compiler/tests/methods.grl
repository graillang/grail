struct Point {
    x: i32,
    y: i32
}
impl Point {
    fn new(x: i32, y: i32) -> Point {
        return Point { x: x, y: y };
    }
    fn sum<a>(self: (&a Point)) -> i32 {
        return self.x + self.y;
    }
    fn shift<a>(self: (&mut a Point), dx: i32) {
        self.x = self.x + dx;
    }
    fn into_pair(self: Point) -> i32 {
        return self.x * self.y;
    }
}
struct Stack {
    items: u64[]
}
impl Stack {
    pub fn empty() -> Stack {
        return Stack { items: u64[] };
    }
    pub fn push<a>(self: (&mut a Stack), v: u64) {
        self.items.push(v);
    }
    pub fn size<a>(self: (&a Stack)) -> u64 {
        return self.items.len();
    }
}
fn total<a>(p: (&a Point)) -> i32 {
    return p.sum();
}
fn main() {
    mut p = Point::new(3, 4);
    assert(p.sum() == 7);
    p.shift(10);
    assert(p.sum() == 17);
    assert(total(borrow(p)) == 17);
    assert(p.into_pair() == 52);
    mut s = Stack::empty();
    s.push(1);
    s.push(2);
    assert(s.size() == 2);
    println(42);
}
