module shapes;
pub interface Shape {
    fn area<a>(self: (&a Self)) -> u64;
    fn name<a>(self: (&a Self)) -> string {
        return "shape";
    }
    // A default can call the interface's other methods and this module's private helpers.
    fn report<a>(self: (&a Self)) -> u64 {
        return scaled(self.area());
    }
}
fn scaled(n: u64) -> u64 {
    return n * 10;
}
