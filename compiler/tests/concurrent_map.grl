use concurrent_map;
use core;
fn some<T>(value: T?) -> u64 {
    match value {
        Some(inner) => {
            return true;
        },
        None => {
            return false;
        }
    }
}
fn fill<a>(map: (&a concurrent_map::Map<u64, u8[]>), count: u64) {
    for i in count {
        concurrent_map::insert(&map, i, u8[i % 256]);
    }
}
fn share<T: Share>(value: T) -> T {
    return value;
}
fn main() {
    map := share(concurrent_map::with_seed<u64, u8[]>(1, 2));
    fill(&map, 500);
    assert(concurrent_map::len(&map) == 500);
    old := concurrent_map::insert(&map, 7, u8[42])!;
    assert(old[0] == 7);
    key := 7;
    assert(concurrent_map::contains(&map, &key));
    removed := concurrent_map::remove(&map, &key)!;
    assert(removed[0] == 42);
    assert(concurrent_map::contains(&map, &key) == false);
    assert(some(concurrent_map::remove(&map, &key)) == false);
    for i in 500 {
        k := i;
        concurrent_map::remove(&map, &k);
    }
    assert(concurrent_map::len(&map) == 0);
    println(42);
}
