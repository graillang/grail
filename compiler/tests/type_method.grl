module type_method;
pub struct Counter {
    value: u64,
    kind: Kind
}
pub enum Kind {
    None,
    One
}
impl Counter {
    pub fn start(value: u64) -> Counter {
        return Counter { value: value, kind: Kind::One };
    }
}
// `module::Type::method(...)` names the type's own function, exactly as the unqualified
// `Type::method(...)` does, and not the variant constructor of the same name.
fn main() {
    c := type_method::Counter::start(7);
    assert(c.value == 7);
    println("qualified ok");
}
