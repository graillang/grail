use env;
use process;
use core;
fn main() {
    a := env::args();
    println(a.len());
    println(&a[1]);
    h := env::var(view("GRAIL_SURELY_UNSET_VAR_1"));
    println(h.unwrap_or("unset".text()));
    m := env::var(view("GRAIL_MISSING_VAR_X"));
    println(m.is_none());
    process::exit(7);
    println("not reached");
}
