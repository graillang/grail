use concurrent_map;
struct Shared {
    arrived: atomic<num>,
    counter: atomic<num>,
    total: mutex<num>,
    log: mutex<num[]>
}
// Real overlap: every task waits until four tasks are running at the same time.
// A sequential implementation would never return from the first task.
fn barrier<a>(id: num, shared: (&a Shared)) -> num {
    shared.arrived.fetch_add(1);
    while shared.arrived.load() < 4 {}
    return id * 10;
}
fn add<a>(total: (&mut a num), amount: num) -> num {
    exchange(total, load(total) + amount);
    return 0;
}
fn record<a>(log: (&mut a num[]), value: num) -> num {
    log.push(value);
    return 0;
}
fn contend<a>(id: num, shared: (&a Shared)) -> num {
    for i in 1000 {
        shared.counter.fetch_add(1);
        shared.total.lock_with(1, add);
    }
    shared.log.lock_with(id, record);
    return id;
}
fn insert_many<a>(base: num, map: (&a concurrent_map::Map<num, u8[]>)) -> num {
    for i in 250 {
        concurrent_map::insert(borrow(map), base * 250 + i, u8[i % 256]);
    }
    return 250;
}
fn length(data: u8[], unused: num) -> num {
    return data.len();
}
fn get<a>(total: (&mut a num), unused: num) -> num {
    return load(total);
}
fn borrowed_lengths<a>(x: (&a u8[]), y: (&a u8[])) -> num[] {
    mut v = (&a u8[])[];
    v.push(x);
    v.push(y);
    return parallel_map(v, 0, count);
}
fn count<a>(item: (&a u8[]), unused: num) -> num {
    return item.len();
}
fn main() {
    shared := Shared { arrived: atomic(0), counter: atomic(0), total: mutex(0), log: mutex(num[]) };
    ids := parallel_map(num[0, 1, 2, 3], borrow(shared), barrier);
    assert(ids.len() == 4);
    for i in 4 {
        assert(ids[i] == i * 10);
    }
    mut work = num[];
    for i in 16 {
        work.push(i);
    }
    done := parallel_map(work, borrow(shared), contend);
    for i in 16 {
        assert(done[i] == i);
    }
    assert(shared.counter.load() == 16000);
    assert(shared.total.lock_with(0, get) == 16000);
    map := concurrent_map::with_seed<num, u8[]>(5, 6);
    mut bases = num[];
    for i in 8 {
        bases.push(i);
    }
    inserted := parallel_map(bases, borrow(map), insert_many);
    for i in 8 {
        assert(inserted[i] == 250);
    }
    assert(concurrent_map::len(borrow(map)) == 2000);
    owned := parallel_map(u8[][u8[1], u8[1, 2], u8[1, 2, 3]], 0, length);
    assert(owned[2] == 3);
    a := u8[1, 2];
    b := u8[1, 2, 3, 4];
    lengths := borrowed_lengths(borrow(a), borrow(b));
    assert(lengths[0] + lengths[1] == 6);
    mut extended = a;
    extended.push(3);
    empty := parallel_map(u8[][], 0, length);
    assert(empty.len() == 0);
    println(42);
}
