fn head(value: &num) -> &num { return value; }
fn first(left: &a num, right: &num) -> &a num { return left; }
fn choose(left: &a num, right: &a num) -> &a num { if true { return left; } return right; }
fn main() {
    n := 7;
    println(load(head(borrow(n))));
    println(load(first(borrow(n), borrow(n))));
}
