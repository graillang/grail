fn head(value: &u64) -> &u64 {
    return value;
}
fn first(left: &a u64, right: &u64) -> &a u64 {
    return left;
}
fn choose(left: &a u64, right: &a u64) -> &a u64 {
    if true {
        return left;
    }
    return right;
}
fn main() {
    n := 7;
    println(load(head(&n)));
    println(load(first(&n, &n)));
}
