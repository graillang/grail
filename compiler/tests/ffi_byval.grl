// A C call with a record passed `byval` from a body that is lifted (call ABI S8a): the record
// crosses as its two fields, so the call must stay native-placed - an FFI fact counting it as one
// word passed only %rdi (tools/test-facts.mjs).
extern "C" record Pair16 { a: i64, b: i64 }
extern "C" lib "ffi_byval.o" fn c_pair_sum(p: byval Pair16) -> i64;
extern "C" lib "ffi_byval.o" fn c_bump(v: i64) -> i64;
fn main() -> u64 {
    n := i64(host::argc());
    p := Pair16 { a: n + 6, b: n + 41 };
    mut r: i64 = 0;
    unsafe {
        r = c_pair_sum(p);
        r = c_bump(r);
    }
    println(r);
    return 0;
}
