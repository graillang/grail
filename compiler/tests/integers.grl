use hashmap;
fn half(x: i32) -> i32 {
    return x / 2;
}
fn total(v: u8[]) -> u32 {
    mut sum = 0u32;
    for i in v.len() {
        sum = sum + u32(v[i]);
    }
    return sum;
}
struct Pixel {
    r: u8,
    g: u8,
    b: u8
}
fn main() {
    a := 200u8;
    b := 55u8;
    assert(a + b == 255);
    x := -7i32;
    y := 2i32;
    assert(x / y == -3);
    assert(x % y == -1);
    assert(half(x) == -3);
    assert(x < y);
    assert((-1i64) < 0);
    big := 2147483647i32;
    assert(big - 1 == 2147483646);
    neg := -128i8;
    assert(i64(neg) == -128);
    m := i64(-9223372036854775807) - 1;
    assert(m < 0);
    assert(u8(250) == 250u8);
    assert(u32(4000000000) == 4000000000u32);
    assert(u64(7u8) == 7);
    p := Pixel { r: 255u8, g: 128u8, b: 0u8 };
    assert(p.r == 255);
    assert(u16(p.g) * 2 == 256);
    assert(total(u8[1, 2, 3]) == 6);
    assert(3i16 ** 3 == 27);
    assert(-x == 7);
    assert((5u8 & 3u8) == 1);
    assert((5i32 ^ 3i32) == 6);
    extras();
    println(x);
    println(-9223372036854775807i64);
    println(a);
}
fn extras() {
    assert(wrapping_u8(300) == 44u8);
    assert(wrapping_i8(200u8) == -56i8);
    assert(bits(-1i32) == 18446744073709551615);
    mut m = hashmap::with_seed<i32, u64>(1, 2);
    hashmap::map_insert(borrow_mut(m), -5i32, 7);
    key := -5i32;
    v := hashmap::map_get(borrow(m), borrow(key))!;
    assert(load(v) == 7);
    assert(3 > 2);
    assert(2 <= 2);
    assert(-3i16 >= -3);
}
