use math;
fn main() {
    println(1.2.ceil());
    println((-1.2).ceil());
    println(2.5.round());
    println((-2.5).round());
    println(0.49999999999999994.round());
    println(8.0.log2());
    println(1000.0.log10());
    println(1.5.powi(-2));
    println("{:.6}", math::PI);
    println(math::E);
    println(0.0.sin());
    println(0.0.exp());
    println(1.0.ln());
    println(0.0.atan2(-1.0));
    println(2.0.pow(10.0));
}
