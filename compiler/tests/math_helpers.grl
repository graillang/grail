use math;
fn main(){
    println(math::ceil(1.2));println(math::ceil(-1.2));println(math::round(2.5));println(math::round(-2.5));println(math::round(0.49999999999999994));
    println(math::log2(8.0));println(math::log10(1000.0));println(math::powi(1.5,-2));println("{:.6}", math::PI);println(math::E);
    println(math::sin(0.0));println(math::exp(0.0));println(math::ln(1.0));println(math::atan2(0.0,-1.0));println(math::pow(2.0,10.0));
}
