use io;
use fs;
use hashmap;
use vecs;
use order;
use strings;
use core;

struct Sale {
    region: string,
    product: string,
    units: u64,
    price: f64,
}
struct Total {
    region: string,
    revenue: f64,
}
impl order::Ord for Total {
    fn less<a, b>(left: (&a Self), right: (&b Self)) -> bool {
        return left.revenue > right.revenue;
    }
}
fn parse_price<a>(text: &a [u8]) -> f64 {
    parts := text.split('.');
    whole := strings::parse_num(&parts[0]).unwrap_or(0);
    mut cents = 0;
    if parts.len() > 1 {
        cents = strings::parse_num(&parts[1]).unwrap_or(0);
    }
    return f64(whole) + f64(cents) / 100.0;
}
fn parse(text: string) -> Sale[] {
    mut sales = Sale[];
    lines := text.split('\n');
    for i in 1..lines.len() {
        line := &lines[i];
        if line.is_empty() {
            continue;
        }
        f := line.split(',');
        if f.len() != 4 {
            continue;
        }
        sales.push(
            Sale {
                region: f[0].copy().text(),
                product: f[1].copy().text(),
                units: strings::parse_num(&f[2]).unwrap_or(0),
                price: parse_price(&f[3]),
            }
        );
    }
    return sales;
}
fn main() -> u64 {
    fs::write(
        view("sales.csv"),
        view("region,product,units,price\nnorth,widget,12,2.50\nsouth,gadget,3,10.00\nnorth,gadget,7,10.00\neast,widget,20,2.50\nsouth,widget,5,2.50\neast,gizmo,1,99.99\n")
    )!;
    match fs::read_text(view("sales.csv")) {
        io::Error(e) => {
            println("cannot read sales: {}", e);
            return 1;
        },
        string(text) => {
            sales := parse(text);
            mut by_region = hashmap::with_seed<string, f64>(7, 11);
            mut units = 0;
            for s in &sales {
                units += s.units;
                revenue := f64(s.units) * s.price;
                if hashmap::map_contains(&by_region, &s.region) {
                    slot := hashmap::map_get_mut(&mut by_region, &s.region)!;
                    exchange(slot, load(slot) + revenue);
                } else {
                    hashmap::map_insert(&mut by_region, s.region.copy().text(), revenue);
                }
            }
            mut totals = Total[];
            for i in hashmap::map_len(&by_region) {
                totals.push(
                    Total {
                        region: hashmap::key_at(&by_region, i).copy().text(),
                        revenue: load(hashmap::value_at(&by_region, i)),
                    }
                );
            }
            vecs::sort(&mut totals);
            println("{:<8}{:>10}", "region", "revenue");
            for t in &totals {
                println("{:<8}{:>10.2}", t.region, t.revenue);
            }
            best := totals[0].region.copy().text();
            count := sales.len();
            println("{} sales, {} units, best region: {}", count, units, best);
            return 0;
        },
    }
}
