// F1 fixture (docs/design/typed-ir.md): two vectors read by index and by length, every index past
// 0 so a wrong element width or a wrong header moves a value rather than just an address, plus a
// borrowed &[u64] read through the same accessors.
fn total(a: (&a u64[])) -> u64 {
    mut s: u64 = 0;
    for i in a.len() {
        s = s + a[i];
    }
    return s;
}
fn main() {
    mut v = u64[];
    mut w = u64[];
    for i in 9 {
        v.push(u64(i) * 7);
        w.push(u64(i) + 1);
    }
    println(total(&v));
    println(v[3] + v[8]);
    v[5] = 41;
    println(v[5] + w[6] + total(&v));
}
