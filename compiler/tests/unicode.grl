use strings;
fn main() {
    word := "héllo wörld 👋".text();
    assert(word.len() == 18);
    assert(view(word).char_count() == 13);
    cps := word.chars().collect();
    assert(cps[1] == 'é');
    assert(cps[12] == '👋');
    mut back = u8[];
    for cp in cps {
        back.push_char(cp);
    }
    assert(back.len() == 18);
    for i in 18 {
        assert(back[i] == word[i]);
    }
    bad := u8[104, 255, 105];
    b := bad.chars().collect();
    assert(b[1] == '\u{FFFD}');
    assert(b.len() == 3);
    r := view("a-b-c").replace(view("-"), view(" + "));
    println(r);
    println(view("ab").repeat(3));
    mut e = u8[];
    e.push_char('€');
    println(e);
}
