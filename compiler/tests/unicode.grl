use strings;
fn main() {
    word := "héllo wörld 👋".text();
    assert(word.len() == 18);
    assert(strings::char_count(view(word)) == 13);
    cps := strings::chars(view(word));
    assert(cps[1] == 233u32);
    assert(cps[12] == 128075u32);
    mut back = u8[];
    for cp in cps {
        strings::push_char(&mut back, cp);
    }
    assert(back.len() == 18);
    for i in 18 {
        assert(back[i] == word[i]);
    }
    bad := u8[104, 255, 105];
    b := strings::chars(view(bad));
    assert(b[1] == 65533u32);
    assert(b.len() == 3);
    r := strings::replace(view("a-b-c"), view("-"), view(" + "));
    println(r);
    println(strings::repeat(view("ab"), 3));
    mut e = u8[];
    strings::push_char(&mut e, 8364u32);
    println(e);
}
