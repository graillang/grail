use strings;
fn main() {
    word := "héllo wörld 👋".text();
    assert(word.len() == 18);
    assert(strings::char_count(&word) == 13);
    cps := strings::chars(&word);
    assert(cps[1] == 233u32);
    assert(cps[12] == 128075u32);
    mut back = u8[];
    for cp in cps {
        strings::push_char(borrow_mut(back), cp);
    }
    assert(back.len() == 18);
    for i in 18 {
        assert(back[i] == word[i]);
    }
    bad := u8[104, 255, 105];
    b := strings::chars(&bad);
    assert(b[1] == 65533u32);
    assert(b.len() == 3);
    r := strings::replace(&"a-b-c", &"-", &" + ");
    println(r);
    println(strings::repeat(&"ab", 3));
    mut e = u8[];
    strings::push_char(borrow_mut(e), 8364u32);
    println(e);
}
