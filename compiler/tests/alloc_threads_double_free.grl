unsafe module runtime;
// A second free of a block is still caught when the first one put it in a thread's cache.
fn at_twice(b: u64) -> u64 {
    rt_free(b);
    rt_free(b);
    return 0;
}
pub fn audit() -> u64 {
    keep := rt_alloc(24);
    rt_thread_join(rt_thread_spawn(at_once_alloc, 0));
    b := rt_alloc(24);
    rt_free(keep);
    at_twice(b);
    return 0;
}
fn at_once_alloc(unused: u64) -> u64 {
    rt_free(rt_alloc(24));
    return 0;
}
