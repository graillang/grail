struct ParseError {
    message: string
}

enum Json {
    Null,
    Bool(bool),
    Number(f64),
    Text(string),
    List(Json[]),
    Object(Field[]),
}
struct Field {
    key: string,
    value: Json,
}
struct Reader {
    text: u8[],
    pos: u64,
}
impl Reader {
    fn skip<a>(self: (&mut a Reader)) {
        while self.pos
            < self.text.len()
            && (self.text[self.pos] == ' ' || self.text[self.pos] == '\n') {
            self.pos += 1;
        }
    }
    fn peek<a>(self: (&mut a Reader)) -> u8 {
        self.skip();
        if self.pos < self.text.len() {
            return u8(self.text[self.pos]);
        }
        return 0;
    }
    fn expect<a>(self: (&mut a Reader), b: u8) -> unit | ParseError {
        if self.peek() != b {
            return ParseError { message: format("expected '{}' at {}", u8[u64(b)], self.pos) };
        }
        self.pos += 1;
        return ();
    }
    fn string<a>(self: (&mut a Reader)) -> string | ParseError {
        self.expect('"')?;
        mut out = u8[];
        while self.pos < self.text.len() && self.text[self.pos] != '"' {
            out.push(self.text[self.pos]);
            self.pos += 1;
        }
        self.pos += 1;
        return out.text();
    }
    fn value<a>(self: (&mut a Reader)) -> Json | ParseError {
        c := self.peek();
        if c == '"' {
            s := self.string()?;
            return Json::Text(s);
        }
        if c == '[' {
            self.pos += 1;
            mut items = Json[];
            if self.peek() == ']' {
                self.pos += 1;
                return Json::List(items);
            }
            loop {
                v := self.value()?;
                items.push(v);
                if self.peek() == ',' {
                    self.pos += 1;
                } else {
                    break;
                }
            }
            self.expect(']')?;
            return Json::List(items);
        }
        if c == '{' {
            self.pos += 1;
            mut fields = Field[];
            loop {
                key := self.string()?;
                self.expect(':')?;
                value := self.value()?;
                fields.push(Field { key, value });
                if self.peek() == ',' {
                    self.pos += 1;
                } else {
                    break;
                }
            }
            self.expect('}')?;
            return Json::Object(fields);
        }
        if c >= '0' && c <= '9' || c == '-' {
            negative := c == '-';
            if negative {
                self.pos += 1;
            }
            mut n = 0.0;
            while self.pos
                < self.text.len()
                && self.text[self.pos]
                >= '0'
                && self.text[self.pos]
                <= '9' {
                n = n * 10.0 + f64(self.text[self.pos] - '0');
                self.pos += 1;
            }
            if negative {
                n = -n;
            }
            return Json::Number(n);
        }
        rest := self.text[self.pos:];
        if rest.starts_with("true") {
            self.pos += 4;
            return Json::Bool(true);
        }
        if rest.starts_with("false") {
            self.pos += 5;
            return Json::Bool(false);
        }
        if rest.starts_with("null") {
            self.pos += 4;
            return Json::Null;
        }
        return ParseError { message: format("unexpected input at {}", self.pos) };
    }
}
impl Json {
    fn show<a>(self: (&a Json)) -> string {
        match self {
            Null => {
                return "null".text();
            },
            Bool(b) => {
                return format("{}", b);
            },
            Number(n) => {
                return format("{}", n);
            },
            Text(s) => {
                return "\"".text() + s + "\"";
            },
            List(items) => {
                mut out = "[".text();
                for i in items.len() {
                    if i > 0 {
                        out = out + ",";
                    }
                    item := &items[i];
                    out = out + item.show();
                }
                return out + "]";
            },
            Object(fields) => {
                mut out = "{".text();
                for i in fields.len() {
                    if i > 0 {
                        out = out + ",";
                    }
                    f := &fields[i];
                    out = out + format("\"{}\":", f.key) + f.value.show();
                }
                return out + "}";
            },
        }
    }
}
fn parse<a>(text: read<a>) -> Json | ParseError {
    mut reader = Reader { text: text.copy(), pos: 0 };
    return reader.value();
}
fn main() {
    inputs := string[
        "{\"name\": \"grail\", \"version\": 1, \"tags\": [\"fast\", \"safe\"], \"stable\": false, \"extra\": null}".text(),
        "[1, -2, [3, []]]".text(),
        "{\"a\": tru}".text()
    ];
    for s in borrow(inputs) {
        match parse(s) {
            Json(j) => {
                println(j);
            },
            ParseError(e) => {
                println("error: {}", e.message);
            },
        }
    }
}
