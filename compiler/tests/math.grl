use math;
// Expected bit patterns come from Rust std (system libm); allowed error in ulps per function.
fn ulps(a: u64, b: u64) -> u64 {
    mut x = a;
    mut y = b;
    if x >= 9223372036854775808 {
        x = 9223372036854775808 - (x - 9223372036854775808);
    }
    if y >= 9223372036854775808 {
        y = 9223372036854775808 - (y - 9223372036854775808);
    }
    if x > y {
        return x - y;
    }
    return y - x;
}
fn check(got: f64, want: u64, limit: u64) -> u64 {
    d := ulps(bits(got), want);
    assert(d <= limit);
    return d;
}
