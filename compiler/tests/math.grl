use math;
// Expected bit patterns come from Rust std (system libm); allowed error in ulps per function.
fn ulps(a:num,b:num)->num{mut x=a;mut y=b;if x>=9223372036854775808{x=9223372036854775808-(x-9223372036854775808);}if y>=9223372036854775808{y=9223372036854775808-(y-9223372036854775808);}if x>y{return x-y;}return y-x;}
