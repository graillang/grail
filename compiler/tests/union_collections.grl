module union_collections;
fn main() {
    mut values = (num | string)[42, "hello".text()];
    values.push(7);
    match values.pop() {
        num(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
    match values.pop() {
        num(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
}
