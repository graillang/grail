module union_collections;
fn main() {
    mut values = (u64 | string)[42, "hello".text()];
    values.push(7);
    match values.pop()! {
        u64(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
    match values.pop()! {
        u64(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
}
