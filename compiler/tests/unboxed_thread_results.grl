use thread;
struct P {
    a: u64,
    b: u64,
    c: u64
}
struct Q {
    a: u64,
    b: u64
}
fn main() {
    t := thread::spawn<P>(thread::config(), |ctx: (&thread::Ctx)| -> P { return P { a: 1, b: 2, c: 3 }; })!;
    p := thread::join(t);
    println("{} {} {}", p.a, p.b, p.c);
    u := thread::spawn<Q>(thread::config(), |ctx: (&thread::Ctx)| -> Q { return Q { a: 5, b: 6 }; })!;
    q := thread::join(u);
    println("{} {}", q.a, q.b);
}
