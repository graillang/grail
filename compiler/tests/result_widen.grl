fn inner(flag: u64) -> u64 |? string {
    if flag == 0 {
        return "bad".text();
    }
    return 42;
}
fn outer(flag: u64) -> u64 |? bool | string {
    return inner(flag);
}
fn main() {
    match outer(1) {
        u64(n) => {
            println(n);
        },
        bool(b) => {
            println(b);
        },
        string(e) => {
            println(e);
        }
    }
    match outer(0) {
        u64(n) => {
            println(n);
        },
        bool(b) => {
            println(b);
        },
        string(e) => {
            println(e);
        }
    }
}
