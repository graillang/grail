fn inner(flag: num) -> num |? string {
    if flag == 0 { return "bad".text(); }
    return 42;
}
fn outer(flag: num) -> num |? bool | string { return inner(flag); }
fn main() {
    match outer(1) { num(n)=>{println(n);}, bool(b)=>{println(b);}, string(e)=>{println(e);} }
    match outer(0) { num(n)=>{println(n);}, bool(b)=>{println(b);}, string(e)=>{println(e);} }
}
