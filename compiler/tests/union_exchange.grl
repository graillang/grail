module union_exchange;
fn main() {
    mut x: num | string = "old".text();
    previous := exchange(borrow_mut(x), 42);
    match previous {
        num(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
    match x {
        num(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
}
