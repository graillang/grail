unsafe module runtime;
// A block allocated by a thread that has ended is still live: its count moved to the process when
// the thread retired its cache, and the end-of-main check stops the program on it.
fn at_leak(unused: u64) -> u64 {
    rt_alloc(24);
    return 0;
}
pub fn audit() -> u64 {
    rt_thread_join(rt_thread_spawn(at_leak, 0));
    return rt_live();
}
