// Plain records stored inside plain records: build, read, write a field of a field, replace a
// whole inline field, borrow one, exchange through it, move one out, refill it, and compare.
struct P {
    x: u64,
    y: u64
}
struct Seg {
    a: P,
    b: P,
    id: u64
}
struct Box2 {
    s: Seg,
    name: string,
    t: P
}
fn bump<a>(p: (&a mut P), k: u64) {
    p.x = p.x + k;
}
fn sum(p: P) -> u64 {
    return p.x + p.y;
}
fn peek<a>(s: (&a Seg)) -> u64 {
    return s.a.x * 1000 + s.b.y;
}
fn main() -> u64 {
    mut s = Seg { a: P { x: 1, y: 2 }, b: P { x: 3, y: 4 }, id: 9 };
    println("{} {} {} {} {}", s.a.x, s.a.y, s.b.x, s.b.y, s.id);
    s.a.y = 20;
    s.b = P { x: 30, y: 40 };
    bump(&mut s.a, 5);
    println("{} {}", peek(&s), s.a == P { x: 6, y: 20 });
    old := exchange(&mut s.b, P { x: 7, y: 8 });
    println("{} {} {}", sum(old), s.b.x, s.b.y);
    taken := s.a;
    println(sum(taken));
    s.a = P { x: 100, y: 200 };
    println(peek(&s));
    mut bx = Box2 { s: Seg { a: P { x: 1, y: 1 }, b: P { x: 2, y: 2 }, id: 3 }, name: "box", t: P { x: 4, y: 5 } };
    bx.s.b.x = 50;
    bump(&mut bx.t, 1);
    inner := &bx.s;
    println("{} {} {} {}", peek(inner), bx.name, bx.t.x, bx.s.id);
    moved := bx.s;
    println("{} {}", peek(&moved), bx.name);
    return 0;
}
