use env;
use core;
use vecs;
use order;
use strings;

enum Command {
    Add(string),
    Remove(u64),
    List,
    Unknown(string),
}
struct Item {
    id: u64,
    name: string,
    qty: u32,
}
impl order::Ord for Item {
    fn less<a, b>(left: (&a Self), right: (&b Self)) -> bool {
        return left.name < right.name;
    }
}
fn parse(arg: string) -> Command {
    if arg == "list" {
        return Command::List;
    }
    if arg.starts_with("add:") {
        return Command::Add(arg.replace("add:", ""));
    }
    if arg.starts_with("rm:") {
        rest := arg.replace("rm:", "");
        if let Some(n) = strings::parse_num(view(rest)) {
            return Command::Remove(n);
        }
    }
    return Command::Unknown(arg);
}
fn find<x>(items: (&x Item[]), id: u64) -> u64? {
    for i in items.len() {
        if items[i].id == id {
            return Some(i);
        }
    }
    return None;
}
fn main() -> u64 {
    mut items = Item[
        Item { id: 1, name: "bolt".text(), qty: 40 },
        Item { id: 2, name: "anchor".text(), qty: 2 }
    ];
    mut next = 3;
    args := env::args();
    for i in 1..args.len() {
        cmd := parse(args[i].copy().text());
        match cmd {
            Add(name) => {
                items.push(Item { id: next, name, qty: 1 });
                next += 1;
            },
            Remove(id) => {
                match find(&items, id) {
                    Some(at) => {
                        gone := items.remove(at);
                        println("removed {}", gone.name);
                    },
                    None => {
                        println("no item {}", id);
                    },
                }
            },
            List => {
                vecs::sort(&mut items);
                for it in &items {
                    println("{:>3} {:<8} x{}", it.id, it.name, it.qty);
                }
            },
            Unknown(text) => {
                println("unknown command: {}", text);
                return 2;
            },
        }
    }
    total := vecs::map(u64[1, 2], |x: u64| -> u64 x);
    return 0;
}
