module structural_union;

fn choose(flag: u64) -> u64 | string {
    if flag != 0 {
        return 42;
    }
    return "error".text();
}

fn main() {
    match choose(1) {
        u64(value) => {
            println(value);
        },
        string(error) => {
            println(error);
        },
    }
    match choose(0) {
        u64(value) => {
            println(value);
        },
        string(error) => {
            println(error);
        },
    }
}
