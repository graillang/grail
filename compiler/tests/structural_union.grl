module structural_union;

fn choose(flag: num) -> num | string {
    if flag {
        return 42;
    }
    return "error".text();
}

fn main() {
    match choose(1) {
        num(value) => {
            println(value);
        },
        string(error) => {
            println(error);
        },
    }
    match choose(0) {
        num(value) => {
            println(value);
        },
        string(error) => {
            println(error);
        },
    }
}
