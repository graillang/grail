// A range fact, end to end (docs/design/typed-ir.md, "the range fact"). The length is a literal the
// analysis can hold (`u8[0; 10]`) and the guard bounds the index (`while i < 5`), so the read below
// is provably in range: `--range-facts` removes the accessor's bounds check, and
// `--range-facts --verify-facts` puts it back as a runtime check that must not fire.
fn main() {
    // The length is computed, which the front end's prover does not fold, so the access reaches
    // the LLVM range pass checked: what this fixture tests is that pass, not the prover.
    n: u64 := 3 * 3 + 1;
    mut v = u8[0; n];
    mut i: u64 = 2;
    while i < 5 {
        if v[i] == 0 {
            println(i);
        }
        i += 1;
    }
}
