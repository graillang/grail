module union_variant;
enum Wrap {
    Value(num | string)
}
fn main() {
    x := Wrap::Value(42);
    match x {
        Value(v) => {
            match v {
                num(n) => {
                    println(n);
                },
                string(s) => {
                    println(s);
                }
            }
        }
    }
}
