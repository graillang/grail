// The range fact's fixpoint must converge before it decides anything. `while i < 100` steps the
// counter by one per round, so a fixpoint stopped early holds `i` in about [0, 23], below the
// literal length 30, and would remove the check. The guard does not prove `v[i]`: the program
// must abort at i = 30 under every build, never read past the end.
fn main() {
    v := u8[0; 30];
    mut i: u64 = 0;
    mut s: u64 = 0;
    while i < 100 {
        s += u64(v[i]);
        i += 1;
    }
    println(s);
}
