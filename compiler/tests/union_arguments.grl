module union_arguments;
fn show(value: u64 | string) {
    match value {
        u64(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
}
fn main() {
    show(42);
    show("error".text());
    generic<u64>(7);
    generic<u64>("generic error".text());
}
fn generic<T>(value: T | string) {
    match value {
        T(v) => {
            println("value");
        },
        string(s) => {
            println(s);
        }
    }
}
