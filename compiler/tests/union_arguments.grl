module union_arguments;
fn show(value: num | string) {
    match value {
        num(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        }
    }
}
fn main() {
    show(42);
    show("error".text());
    generic<num>(7);
    generic<num>("generic error".text());
}
fn generic<T>(value: T | string) {
    match value {
        T(v) => {
            println("value");
        },
        string(s) => {
            println(s);
        }
    }
}
