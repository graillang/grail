use shapes;
struct Square {
    side: u64,
}
struct Circle {
    r: u64,
}
impl shapes::Shape for Square {
    fn area<a>(self: (&a Self)) -> u64 {
        return self.side * self.side;
    }
    fn name<a>(self: (&a Self)) -> string {
        return "square";
    }
}
impl shapes::Shape for Circle {
    fn area<a>(self: (&a Self)) -> u64 {
        return 3 * self.r * self.r;
    }
}
fn show<a, T: shapes::Shape>(s: (&a T)) -> unit {
    println("{} {} {}", s.name(), s.area(), shapes::Shape::report(s));
    return ();
}
fn main() -> u64 {
    sq := Square { side: 2 };
    ci := Circle { r: 1 };
    show(&sq);
    show(&ci);
    println(ci.report());
    return 0;
}
