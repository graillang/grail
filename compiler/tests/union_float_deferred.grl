module float_deferred;
fn choose<T, E>(value: T | E, first: T, second: E) {
    match value {
        T(v) => {
            println("first");
        },
        E(e) => {
            println("second");
        }
    }
    drop(first);
    drop(second);
}
fn main() {
    choose(1.5, f32(2.0), "text".text());
}
