fn choose(flag: bool) -> num | string {
    if flag { return 42; }
    return "bad".text();
}
fn main() {
    match choose(true) {
        data: num => { println(data); },
        message: string => { println(message); },
    }
    match choose(false) {
        num => { println(1); },
        string => { println(2); },
    }
}
