fn choose(flag: bool) -> u64 | string {
    if flag {
        return 42;
    }
    return "bad".text();
}
fn main() {
    match choose(true) {
        data: u64 => {
            println(data);
        },
        message: string => {
            println(message);
        },
    }
    match choose(false) {
        u64 => {
            println(1);
        },
        string => {
            println(2);
        },
    }
}
