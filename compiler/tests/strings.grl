use strings;
use core;
fn main() {
    line := "  name=Grail,lang=v1  ".text();
    t := strings::trim(view(line));
    assert(t.len() == 18);
    assert(strings::starts_with(view(t), view("name")));
    assert(strings::ends_with(view(t), view("v1")));
    assert(strings::contains(view(t), view("lang")));
    assert(strings::find(view(t), view("="))! == 4);
    parts := strings::split(view(t), 44);
    assert(parts.len() == 2);
    again := strings::join_with(&parts, view(";"));
    assert(again[10] == 59);
    up := strings::to_upper(view("abc"));
    assert(up[0] == 65);
    low := strings::to_lower(view(up));
    assert(low[2] == 99);
    assert(strings::parse_num(view("12345"))! == 12345);
    if let None = strings::parse_num(view("12a")) {} else {
        assert(false);
    }
    if let None = strings::parse_num(view("99999999999999999999")) {} else {
        assert(false);
    }
    println(42);
}
