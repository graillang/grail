use strings;
use core;
fn main() {
    line := "  name=Grail,lang=v1  ".text();
    t := strings::trim(&line);
    assert(t.len() == 18);
    assert(strings::starts_with(&t, &"name"));
    assert(strings::ends_with(&t, &"v1"));
    assert(strings::contains(&t, &"lang"));
    assert(strings::find(&t, &"=")! == 4);
    parts := strings::split(&t, 44);
    assert(parts.len() == 2);
    again := strings::join_with(borrow(parts), &";");
    assert(again[10] == 59);
    up := strings::to_upper(&"abc");
    assert(up[0] == 65);
    low := strings::to_lower(&up);
    assert(low[2] == 99);
    assert(strings::parse_num(&"12345")! == 12345);
    if let None = strings::parse_num(&"12a") {} else {
        assert(false);
    }
    if let None = strings::parse_num(&"99999999999999999999") {} else {
        assert(false);
    }
    println(42);
}
