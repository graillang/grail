use strings;
use core;
fn main() {
    line := "  name=Grail,lang=v1  ".text();
    t := view(line).trim();
    assert(t.len() == 18);
    assert(view(t).starts_with(view("name")));
    assert(view(t).ends_with(view("v1")));
    assert(view(t).contains(view("lang")));
    assert(view(t).find(view("="))! == 4);
    parts := view(t).split(44);
    assert(parts.len() == 2);
    again := parts.join_with(view(";"));
    assert(again[10] == 59);
    up := view("abc").to_upper();
    assert(up[0] == 65);
    low := view(up).to_lower();
    assert(low[2] == 99);
    assert(view("12345").parse_u64()! == 12345);
    if let None = view("12a").parse_u64() {} else {
        assert(false);
    }
    if let None = view("99999999999999999999").parse_u64() {} else {
        assert(false);
    }
    println(42);
}
