module union_ownership;
fn choose(flag: bool) -> string | u64 {
    if flag {
        return "owned".text();
    }
    return 7;
}
fn main() {
    match choose(true) {
        string(text) => {
            println(text);
        },
        _ => {
            println("unexpected");
        }
    }
    match choose(false) {
        string(text) => {
            println(text);
        },
        _ => {
            println("fallback");
        }
    }
}
