module sources;
pub interface Source {
    type Item;
    fn pull(self: &mut Self) -> Self::Item?;
    // A default may name the associated type too.
    fn skip(self: &mut Self) -> bool {
        return self.pull().is_some();
    }
}
// Generic over any source: the result's element type is the implementation's.
pub fn drain<T: Source>(src: &mut T) -> T::Item[] {
    mut out = T::Item[];
    while let Some(x) = src.pull() {
        out.push(x);
    }
    return out;
}
