module generic_functions;
struct Pair<T, U> {
    first: T,
    second: U
}
enum Option<T> {
    Some(T),
    None
}
pub fn identity<T>(x: T) -> T {
    return x;
}
fn forward<T>(x: T) -> T {
    return identity(x);
}
fn pair<T, U>(x: T, y: U) -> Pair<T, U> {
    return Pair { first: x, second: y };
}
fn some<T>(x: T) -> Option<T> {
    return Option::Some(x);
}
fn none<T>() -> Option<T> {
    return Option::None;
}
fn first<T>(p: Pair<T, u8[]>) -> T {
    return p.first;
}
fn recur<T>(x: T, n: u64) -> T {
    if n != 0 {
        return recur(x, n - 1);
    }
    return x;
}
pub fn run() -> u64 {
    assert(identity(17) == 17);
    assert(identity<u64>(18) == 18);
    b := forward(u8[]);
    assert(b.len() == 0);
    p := pair("abc", u8[]);
    s := first(p);
    assert(s.len() == 3);
    r := recur("repeat", 4);
    assert(r.len() == 6);
    match some(u8[]) {
        Some(b) => {
            assert(b.len() == 0);
        },
        None => {
            assert(0);
        }
    }
    match none<u8[]>() {
        Some(b) => {
            assert(0);
        },
        None => {
            assert(1);
        }
    }
    mut data = u8[];
    data.push(9);
    v := forward(view(data));
    assert(v[0] == 9);
    n := 7;
    rr := identity(&n);
    assert(load(rr) == 7);
    return 919;
}
