module generic_functions;
struct Pair<T,U>{first:T,second:U}
enum Option<T>{Some(T),None}
pub fn identity<T>(x:T)->T{return x;}
fn forward<T>(x:T)->T{return identity(x);}
fn pair<T,U>(x:T,y:U)->Pair<T,U>{return Pair{first:x,second:y};}
fn some<T>(x:T)->Option<T>{return Option::Some(x);}
fn none<T>()->Option<T>{return Option::None;}
fn first<T>(p:Pair<T,bytes>)->T{return p.first;}
fn recur<T>(x:T,n:num)->T{if n{return recur(x,n-1);}return x;}
pub fn run()->num{
 assert(identity(17)==17);assert(identity<num>(18)==18);
 b :=forward(bytes[]);assert(b.len()==0);
 p :=pair("abc",bytes[]);s :=first(p);assert(s.len()==3);
 r :=recur("repeat",4);assert(r.len()==6);
 match some(bytes[]){Some(b)=>{assert(b.len()==0);},None=>{assert(0);}}
 match none<bytes>(){Some(b)=>{assert(0);},None=>{assert(1);}}
 mut data =bytes[];data.push(9);v :=forward(&data);assert(v[0]==9);
 n :=7;rr :=identity(borrow(n));assert(load(rr)==7);
 return 919;
}
