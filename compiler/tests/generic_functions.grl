module generic_functions;
struct Pair<type T,type U>{first:T,second:U}
enum Option<type T>{Some(T),None}
pub fn identity<type T>(x:T)->T{return x;}
fn forward<type T>(x:T)->T{return identity(x);}
fn pair<type T,type U>(x:T,y:U)->Pair<T,U>{return Pair{first:x,second:y};}
fn some<type T>(x:T)->Option<T>{return Option::Some(x);}
fn none<type T>()->Option<T>{return Option::None;}
fn first<type T>(p:Pair<T,bytes>)->T{return p.first;}
fn recur<type T>(x:T,n:num)->T{if n{return recur(x,n-1);}return x;}
pub fn run()->num{
 assert(identity(17)==17);assert(identity<num>(18)==18);
 let b=forward(bytes());assert(len(b)==0);
 let p=pair("abc",bytes());let s=first(p);assert(len(s)==3);
 let r=recur("repeat",4);assert(len(r)==6);
 match some(bytes()){Some(b)=>{assert(len(b)==0);},None=>{assert(0);}}
 match none<bytes>(){Some(b)=>{assert(0);},None=>{assert(1);}}
 let data=bytes();push(data,9);let v=forward(read(data));assert(at(v,0)==9);
 let n=7;let rr=identity(borrow(n));assert(load(rr)==7);
 return 919;
}
