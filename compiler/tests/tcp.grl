use host;
// Every client is a task; with more clients than the worker pool can ever have threads, the
// server task can only keep accepting if waiting tasks do not occupy workers.
fn serve(listener: u64, count: u64) -> u64 {
    mut served = 0;
    for i in count {
        client := host::tcp_accept(listener);
        data := host::read_fd(client, 64);
        host::write_fd(client, &data);
        host::close(client);
        served += 1;
    }
    return served;
}
fn client(port: u64, count: u64) -> u64 {
    fd := host::tcp_connect(&"127.0.0.1", port);
    host::write_fd(fd, &"ping");
    reply := host::read_fd(fd, 64);
    host::close(fd);
    return reply.len();
}
fn body<s>(sc: (&s scope<u64>), count: u64) -> u64 {
    listener := host::tcp_listen(0);
    port := host::tcp_port(listener);
    assert(port > 0);
    server := spawn(sc, listener, serve_all);
    mut clients = task<u64>[];
    for i in count {
        clients.push(spawn(sc, port, client));
    }
    mut total = 0;
    while clients.len() != 0 {
        total += join(clients.pop());
    }
    assert(join(server) == count);
    host::close(listener);
    return total;
}
fn serve_all(listener: u64, count: u64) -> u64 {
    return serve(listener, 100);
}
fn main() {
    assert(task_scope(100, body) == 400);
    println(42);
}
