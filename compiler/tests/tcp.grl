use host;
// Every client is a task; with more clients than the worker pool can ever have threads, the
// server task can only keep accepting if waiting tasks do not occupy workers.
fn serve(listener:num,count:num)->num{
    mut served=0;
    for i in count{client:=host::tcp_accept(listener);data:=host::read_fd(client,64);host::write_fd(client,&data);host::close(client);served+=1;}
    return served;
}
fn client(port:num,count:num)->num{
    fd:=host::tcp_connect(&"127.0.0.1",port);host::write_fd(fd,&"ping");reply:=host::read_fd(fd,64);host::close(fd);return reply.len();
}
fn body<s>(sc:ref<s,scope<num>>,count:num)->num{
    listener:=host::tcp_listen(0);port:=host::tcp_port(listener);assert(port>0);
    server:=spawn(sc,listener,serve_all);
    mut clients=task<num>[];for i in count{clients.push(spawn(sc,port,client));}
    mut total=0;while clients.len()!=0{total+=join(clients.pop());}
    assert(join(server)==count);host::close(listener);return total;
}
fn serve_all(listener:num,count:num)->num{return serve(listener,100);}
fn main(){assert(task_scope(100,body)==400);println(42);}
