// Views as two words {pointer, length} held in frame words: slices, views of a whole vector and of a
// static string passed per call, views returned from a function (two registers), stored in a record
// and in a vector, split, and passed to C-like helpers - with no heap allocation per view.
static GREETING: string = "hello, views";
struct Span<a> {
    head: (&a [u8]),
    tail: (&a [u8])
}
fn count_byte(text: &[u8], b: u64) -> u64 {
    mut n = 0;
    for i in text.len() {
        if u64(text[i]) == b {
            n += 1;
        }
    }
    return n;
}
fn middle<a>(v: (&a [u64])) -> (&a [u64]) {
    return &v[1..v.len() - 1];
}
fn split<a>(text: (&a [u8]), at: u64) -> Span<a> {
    return Span { head: &text[0..at], tail: &text[at..text.len()] };
}
fn sum(v: &[u64]) -> u64 {
    mut t = 0;
    for i in v.len() {
        t += v[i];
    }
    return t;
}
fn windows<a>(v: (&a [u64])) -> u64 {
    mut parts = Span2<a>[];
    for i in 3 {
        parts.push(Span2 { w: &v[i..i + 3] });
    }
    mut s = 0;
    for p in &parts {
        s += p.w[0] + p.w[2];
    }
    return s;
}
struct Span2<a> {
    w: (&a [u64])
}
fn main() {
    mut total = 0;
    for k in 1000 {
        total += count_byte(&GREETING, 108);
    }
    println(total);
    v := u64[1, 2, 3, 4, 5, 6];
    m := middle(&v);
    println("{} {}", m.len(), sum(m));
    println(sum(&v[2..5]));
    bytes := u8[104, 105, 33, 63];
    sp := split(&bytes, 2);
    println("{} {} {}", sp.head.len(), sp.tail[0], sp.tail[1]);
    println(windows(&v));
}
