module three;
fn choose(n: u64) -> u64 | string | bool {
    if n == 0 {
        return 42;
    }
    if n == 1 {
        return "hello".text();
    }
    return true;
}
fn main() {
    for n in u64[0, 1, 2] {
        match choose(n) {
            u64(value) => {
                println(value);
            },
            string(value) => {
                println(value);
            },
            bool(value) => {
                println(value);
            },
        }
    }
}
