module cleanup;
struct Pair {
    first: u8[],
    second: string
}
enum Result {
    Ok(u8[]),
    Err(string)
}
fn make(flag: u64) -> Result {
    mut work = u8[];
    work.push(8);
    name := "local";
    if flag {
        return Result::Err("bad");
    }
    return Result::Ok(work);
}
fn forward(flag: u64) -> Result {
    held := "outer";
    value := make(flag)?;
    return Result::Ok(value);
}
fn early(flag: u64) -> u64 {
    pair := Pair { first: u8[], second: "kept" };
    first := pair.first;
    shadow := "old";
    {
        shadow := "new";assert(shadow.len() == 3);
    } if flag { return pair.second.len() + first.len(); } return pair
        .second
        .len();
}
pub fn run() -> u64 {
    assert(early(1) == 4);
    mut i = 0;
    while i < 20 {
        mut local = u8[];
        local.push(i);
        i = i + 1;
        if i % 2 == 0 {
            continue;
        }
        if i == 15 {
            break;
        }
    }
    mut sum = 0;
    for j in 5 {
        mut local = "loop";
        if j == 1 {
            continue;
        }
        if j == 4 {
            break;
        }
        sum = sum + local.len();
    }
    assert(sum == 12);
    mut replacement = u8[];
    replacement.push(1);
    replacement = u8[];
    assert(replacement.len() == 0);
    match forward(0) {
        Ok(b) => {
            assert(b.len() == 1);
        },
        Err(e) => {
            assert(0);
        }
    }
    match forward(1) {
        Ok(b) => {
            assert(0);
        },
        Err(e) => {
            assert(e.len() == 3);
        }
    }
    return 777;
}
