module cleanup;
struct Pair { first:bytes, second:string }
enum Result { Ok(bytes), Err(string) }
fn make(flag:num)->Result {
    var work =bytes(); push(work,8);
    name :="local";
    if flag { return Result::Err("bad"); }
    return Result::Ok(work);
}
fn forward(flag:num)->Result {
    held :="outer";
    value :=make(flag)?;
    return Result::Ok(value);
}
fn early(flag:num)->num {
    pair :=Pair{first:bytes(),second:"kept"};
    first :=pair.first;
    shadow :="old";
    { shadow :="new"; assert(len(shadow)==3); }
    if flag { return len(pair.second)+len(first); }
    return len(pair.second);
}
pub fn run()->num {
    assert(early(1)==4);
    var i=0;
    while i<20 {
        var local =bytes(); push(local,i);
        i=i+1;
        if i%2==0 { continue; }
        if i==15 { break; }
    }
    var sum=0;
    for j in 5 {
        var local ="loop";
        if j==1 { continue; }
        if j==4 { break; }
        sum=sum+len(local);
    }
    assert(sum==12);
    var replacement=bytes(); push(replacement,1);
    replacement=bytes(); assert(len(replacement)==0);
    match forward(0) { Ok(b)=>{assert(len(b)==1);},Err(e)=>{assert(0);} }
    match forward(1) { Ok(b)=>{assert(0);},Err(e)=>{assert(len(e)==3);} }
    return 777;
}
