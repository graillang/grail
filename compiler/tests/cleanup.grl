module cleanup;
struct Pair { first:bytes, second:string }
enum Result { Ok(bytes), Err(string) }
fn make(flag:num)->Result {
    mut work =bytes[]; work.push(8);
    name :="local";
    if flag { return Result::Err("bad"); }
    return Result::Ok(work);
}
fn forward(flag:num)->Result {
    held :="outer";
    value :=make(flag)?;
    return Result::Ok(value);
}
fn early(flag:num)->num {
    pair :=Pair{first:bytes[],second:"kept"};
    first :=pair.first;
    shadow :="old";
    { shadow :="new"; assert(shadow.len()==3); }
    if flag { return pair.second.len()+first.len(); }
    return pair.second.len();
}
pub fn run()->num {
    assert(early(1)==4);
    mut i=0;
    while i<20 {
        mut local =bytes[]; local.push(i);
        i=i+1;
        if i%2==0 { continue; }
        if i==15 { break; }
    }
    mut sum=0;
    for j in 5 {
        mut local ="loop";
        if j==1 { continue; }
        if j==4 { break; }
        sum=sum+local.len();
    }
    assert(sum==12);
    mut replacement=bytes[]; replacement.push(1);
    replacement=bytes[]; assert(replacement.len()==0);
    match forward(0) { Ok(b)=>{assert(b.len()==1);},Err(e)=>{assert(0);} }
    match forward(1) { Ok(b)=>{assert(0);},Err(e)=>{assert(e.len()==3);} }
    return 777;
}
