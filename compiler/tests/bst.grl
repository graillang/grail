enum Tree {
    Leaf,
    Node(Branch),
}
struct Branch {
    key: i32,
    left: Tree,
    right: Tree,
}
fn insert(tree: Tree, key: i32) -> Tree {
    match tree {
        Leaf => {
            return Tree::Node(Branch { key, left: Tree::Leaf, right: Tree::Leaf });
        },
        Node(b) => {
            if key < b.key {
                return Tree::Node(Branch { key: b.key, left: insert(b.left, key), right: b.right });
            }
            if key > b.key {
                return Tree::Node(Branch { key: b.key, left: b.left, right: insert(b.right, key) });
            }
            return Tree::Node(b);
        },
    }
}
fn contains<a>(tree: (&a Tree), key: i32) -> bool {
    match tree {
        Leaf => {
            return false;
        },
        Node(b) => {
            if key == b.key {
                return true;
            }
            if key < b.key {
                return contains(&b.left, key);
            }
            return contains(&b.right, key);
        },
    }
}
fn walk<a, b>(tree: (&a Tree), out: (&b mut i32[])) {
    match tree {
        Leaf => {},
        Node(n) => {
            walk(&n.left, &mut out);
            out.push(n.key);
            walk(&n.right, &mut out);
        },
    }
}
fn depth<a>(tree: (&a Tree)) -> u64 {
    match tree {
        Leaf => {
            return 0;
        },
        Node(b) => {
            l := depth(&b.left);
            r := depth(&b.right);
            if l > r {
                return l + 1;
            }
            return r + 1;
        },
    }
}
fn main() {
    mut tree = Tree::Leaf;
    for k in i32[50, 30, 70, 20, 40, 60, 80, 30, -5] {
        tree = insert(tree, k);
    }
    mut keys = i32[];
    walk(&tree, &mut keys);
    println(keys);
    println(
        "{} {} depth {}",
        contains(&tree, 60),
        contains(&tree, 65),
        depth(&tree)
    );
}
