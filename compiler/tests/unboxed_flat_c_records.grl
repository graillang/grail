// A vector of `extern "C"` records: narrow fields, an embedded record, element writes and removals.
extern "C" record Rgb {
    r: u8,
    g: u8,
    b: u8
}
extern "C" record Vertex {
    x: f32,
    y: f32,
    z: f32,
    color: Rgb,
    index: u16,
    weight: i32
}
fn vertex(i: u32) -> Vertex {
    f: f32 := f32(i);
    return Vertex { x: f, y: f * 0.5, z: f + 0.25, color: Rgb { r: u8(i), g: u8(i * 2), b: 255 }, index: u16(i * 3), weight: 0 - i32(i) };
}
fn total<a>(v: (&a Vertex[])) -> f64 {
    mut t: f64 = 0.0;
    for i in v.len() {
        e := &v[i];
        t = t + f64(e.x) + f64(e.y) + f64(e.z) + f64(u64(e.color.r) + u64(e.color.g) + u64(e.color.b)) + f64(u64(e.index));
        t = t + f64(e.weight);
    }
    return t;
}
fn main() -> u64 {
    mut v = Vertex[];
    for i in 50 {
        v.push(vertex(u32(i)));
    }
    println(total(&v));
    v[7].y = 100.5;
    v[8].color.g = 9;
    v[9].color = Rgb { r: 1, g: 2, b: 3 };
    v[10] = vertex(40);
    m := &mut v[11];
    m.weight = -1000;
    m.index = 65535;
    println("{} {} {} {} {} {}", v[7].y, v[8].color.g, v[9].color.b, v[10].x, v[11].weight, v[11].index);
    out := v.remove(3);
    last := v.pop()!;
    v.swap(0, 1);
    println("{} {} {} {} {}", out.index, last.weight, v[0].x, v[1].z, v.len());
    println(total(&v));
    return 0;
}
