module borrow_widen;
fn narrow<a>(text: &a [u8]) -> &a [u8] | u64 {
    return text;
}
fn widen<a>(text: &a [u8]) -> bool | &a [u8] | u64 {
    return narrow(text);
}
fn display<a>(text: &a [u8]) {
    match widen(text) {
        bool(b) => {
            println(b);
        },
        &a [u8](value) => {
            println(value);
        },
        u64(n) => {
            println(n);
        }
    }
}
fn main() {
    text := "hello".text();
    display(view(text));
}
