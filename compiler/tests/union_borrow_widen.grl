module borrow_widen;
fn narrow<a>(text: read<a>) -> read<a> | num {
    return text;
}
fn widen<a>(text: read<a>) -> bool | read<a> | num {
    return narrow(text);
}
fn display<a>(text: read<a>) {
    match widen(text) {
        bool(b) => {
            println(b);
        },
        read<a>(value) => {
            println(value);
        },
        num(n) => {
            println(n);
        }
    }
}
fn main() {
    text := "hello".text();
    display(&text);
}
