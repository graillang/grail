fn inner(flag: u64) -> u64 | bool |? string {
    if flag == 0 {
        return true;
    }
    if flag == 1 {
        return "bad".text();
    }
    return 42;
}
fn outer(flag: u64) -> u64 | bool |? string {
    value := inner(flag)?;
    match value {
        u64(n) => {
            return n;
        },
        bool(b) => {
            return b;
        },
    }
}
fn main() {
    match outer(2) {
        u64(n) => {
            println(n);
        },
        bool(b) => {
            println(b);
        },
        string(e) => {
            println(e);
        }
    }
    match outer(0) {
        bool(b) => {
            println(b);
        },
        _ => {
            println(0);
        }
    }
    match outer(1) {
        string(e) => {
            println(e);
        },
        _ => {
            println(0);
        }
    }
}
