use fs;
use io;

// The file-system layer's fallible operations answer a value or an `fs::Error` naming the path and
// the failure, and `?` propagates it. Every path here is relative to the case's own directory.
fn size(path: (&[u8])) -> u64 | fs::Error {
    data := fs::read(path)?;
    return data.len();
}

fn main() {
    match fs::read(view("definitely-missing.txt")) {
        u8[](data) => {
            assert(false);
        },
        fs::Error(e) => {
            assert(e.is_not_found());
            println(e.show());
        }
    }
    match fs::write(view("no/such/dir/x.txt"), view("x")) {
        unit(done) => {
            assert(false);
        },
        fs::Error(e) => {
            println(e.show());
        }
    }
    fs::write(view("out.txt"), view("hello"))!;
    data := fs::read(view("out.txt"))!;
    assert(data.len() == 5);
    assert(fs::exists(view("out.txt")));
    n := size(view("out.txt"))!;
    assert(n == 5);
    t := fs::read_text(view("out.txt"))!;
    println(t);
    match size(view("missing")) {
        u64(n) => {
            assert(false);
        },
        fs::Error(e) => {
            println(e.show());
        }
    }
    if fs::exists(view("tmpdir")) {
        fs::remove_file(view("tmpdir/a.txt"));
        fs::remove_dir(view("tmpdir"));
    }
    fs::create_dir(view("tmpdir"))!;
    match fs::create_dir(view("tmpdir")) {
        unit(x) => {
            assert(false);
        },
        fs::Error(e) => {
            println(e.show());
        }
    }
    fs::write(view("tmpdir/a.txt"), view("1"))!;
    entries := fs::list_dir(view("tmpdir"))!;
    println(entries.len());
    match fs::remove_dir(view("tmpdir")) {
        unit(x) => {
            assert(false);
        },
        fs::Error(e) => {
            println(e.show());
        }
    }
    fs::remove_file(view("tmpdir/a.txt"))!;
    fs::remove_dir(view("tmpdir"))!;
    assert(!fs::exists(view("tmpdir")));
    fs::remove_file(view("out.txt"))!;
    println("fs ok");
}
