use fs;
use io;
fn size<a>(path: read<a>) -> u64 | io::Error {
    data := fs::read(path)?;
    return data.len();
}
fn main() {
    match fs::read(&"definitely-missing.txt") {
        u8[](data) => {
            assert(false);
        },
        io::Error(e) => {
            assert(e.is_not_found());
            println(e);
        }
    }
    match fs::write(&"no/such/dir/x.txt", &"x") {
        unit(done) => {
            assert(false);
        },
        io::Error(e) => {
            println(e);
        }
    }
    fs::write(&"out.txt", &"hello")!;
    data := fs::read(&"out.txt")!;
    assert(data.len() == 5);
    assert(fs::exists(&"out.txt"));
    n := size(&"out.txt")!;
    assert(n == 5);
    t := fs::read_text(&"out.txt")!;
    println(t);
    match size(&"missing") {
        u64(n) => {
            assert(false);
        },
        io::Error(e) => {
            println(e);
        }
    }
    if fs::exists(&"tmpdir") {
        fs::remove_file(&"tmpdir/a.txt");
        fs::remove_dir(&"tmpdir");
    }
    fs::create_dir(&"tmpdir")!;
    match fs::create_dir(&"tmpdir") {
        unit(x) => {
            assert(false);
        },
        io::Error(e) => {
            println(e);
        }
    }
    fs::write(&"tmpdir/a.txt", &"1")!;
    entries := fs::list_dir(&"tmpdir");
    println(entries.len());
    match fs::remove_dir(&"tmpdir") {
        unit(x) => {
            assert(false);
        },
        io::Error(e) => {
            println(e);
        }
    }
    fs::remove_file(&"tmpdir/a.txt")!;
    fs::remove_dir(&"tmpdir")!;
    assert(!fs::exists(&"tmpdir"));
    fs::remove_file(&"out.txt")!;
    println("fs ok");
}
