use fs;
use io;
use core;
fn size<a>(path:read<a>)->core::Result<num,io::Error>{data:=fs::read(path)?;return core::ok<num,io::Error>(data.len());}
fn main(){
    match fs::read(&"definitely-missing.txt"){Ok(data)=>{assert(false);},Err(e)=>{assert(e.is_not_found());println(e);}}
    match fs::write(&"no/such/dir/x.txt",&"x"){Ok(done)=>{assert(false);},Err(e)=>{println(e);}}
    fs::write(&"out.txt",&"hello")!;
    data:=fs::read(&"out.txt")!;assert(data.len()==5);assert(fs::exists(&"out.txt"));
    n:=size(&"out.txt")!;assert(n==5);t:=fs::read_text(&"out.txt")!;println(t);
    match size(&"missing"){Ok(n)=>{assert(false);},Err(e)=>{println(e);}}
    if fs::exists(&"tmpdir"){fs::remove_file(&"tmpdir/a.txt");fs::remove_dir(&"tmpdir");}
    fs::create_dir(&"tmpdir")!;match fs::create_dir(&"tmpdir"){Ok(x)=>{assert(false);},Err(e)=>{println(e);}}
    fs::write(&"tmpdir/a.txt",&"1")!;entries:=fs::list_dir(&"tmpdir");println(entries.len());
    match fs::remove_dir(&"tmpdir"){Ok(x)=>{assert(false);},Err(e)=>{println(e);}}
    fs::remove_file(&"tmpdir/a.txt")!;fs::remove_dir(&"tmpdir")!;assert(!fs::exists(&"tmpdir"));fs::remove_file(&"out.txt")!;
    println("fs ok");
}
