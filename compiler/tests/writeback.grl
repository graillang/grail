module writeback;
struct Cell<a>{value:read<a>}
fn access<a,b>(r:ref_mut<a,Cell<b>>)->ref_mut<a,read<b>>{return borrow_mut(r.value);}
fn replace<a,type T>(r:ref_mut<a,T>,value:T)->T{return exchange(r,value);}
fn set<a,b>(r:ref_mut<a,read<b>>,value:read<b>)->num{let old=exchange(r,value);return 0;}
fn add<a,b>(r:ref_mut<a,vec<read<b>>>,v:read<b>)->num{vec_push(r,v);return 0;}
fn pop<a,b>(r:ref_mut<a,vec<read<b>>>)->read<b>{return vec_pop(r);}
fn field<a,b>(r:ref_mut<a,Cell<b>>,v:read<b>)->num{let old=exchange(borrow_mut(r.value),v);return 0;}
fn vector_test<x>(v:read<x>)->num{let views=vec<read<x>>();add(borrow_mut(views),v);let out=pop(borrow_mut(views));return at(out,0);}
pub fn run()->num{
 let a=bytes();push(a,1);let b=bytes();push(b,2);
 var view=read(a);let old=replace(borrow_mut(view),read(b));assert(at(old,0)==1);assert(at(view,0)==2);
 drop(old);drop(view);push(a,3);push(b,4);
 var next=read(a);set(borrow_mut(next),read(b));assert(at(next,0)==2);drop(next);
 var left=read(a);let right=read(b);left=right;assert(at(left,0)==2);drop(left);
 var cell=Cell{value:read(a)};cell.value=read(b);assert(at(cell.value,0)==2);field(borrow_mut(cell),read(a));assert(at(cell.value,0)==1);drop(cell);
 var opaque=Cell{value:read(a)};let r=access(borrow_mut(opaque));let old=exchange(r,read(b));drop(old);assert(at(opaque.value,0)==2);drop(opaque);
 var through=Cell{value:read(a)};set(access(borrow_mut(through)),read(b));assert(at(through.value,0)==2);drop(through);
 assert(vector_test(read(a))==1);
 return 626;
}
