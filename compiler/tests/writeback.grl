module writeback;
struct Cell<a> {
    value: &a [u8]
}
fn access<a, b>(r: (&a mut Cell<b>)) -> (&a mut &b [u8]) {
    return &mut r.value;
}
fn replace<a, T>(r: (&a mut T), value: T) -> T {
    return exchange(r, value);
}
fn set<a, b>(r: (&a mut &b [u8]), value: &b [u8]) -> u64 {
    old := exchange(r, value);
    return 0;
}
fn add<a, b>(r: (&a mut (&b [u8])[]), v: &b [u8]) -> u64 {
    r.push(v);
    return 0;
}
fn pop<a, b>(r: (&a mut (&b [u8])[])) -> &b [u8] {
    return r.pop()!;
}
fn field<a, b>(r: (&a mut Cell<b>), v: &b [u8]) -> u64 {
    old := exchange(&mut r.value, v);
    return 0;
}
fn vector_test<x>(v: &x [u8]) -> u64 {
    mut views = (&x [u8])[];
    add(&mut views, v);
    out := pop(&mut views);
    return out[0];
}
pub fn run() -> u64 {
    mut a = u8[];
    a.push(1);
    mut b = u8[];
    b.push(2);
    mut view = view(a);
    old := replace(&mut view, view(b));
    assert(old[0] == 1);
    assert(view[0] == 2);
    drop(old);
    drop(view);
    a.push(3);
    b.push(4);
    mut next = view(a);
    set(&mut next, view(b));
    assert(next[0] == 2);
    drop(next);
    mut left = view(a);
    right := view(b);
    left = right;
    assert(left[0] == 2);
    drop(left);
    mut cell = Cell { value: view(a) };
    cell.value = view(b);
    assert(cell.value[0] == 2);
    field(&mut cell, view(a));
    assert(cell.value[0] == 1);
    drop(cell);
    mut opaque = Cell { value: view(a) };
    mut r = access(&mut opaque);
    old := exchange(r, view(b));
    drop(old);
    assert(opaque.value[0] == 2);
    drop(opaque);
    mut through = Cell { value: view(a) };
    set(access(&mut through), view(b));
    assert(through.value[0] == 2);
    drop(through);
    assert(vector_test(view(a)) == 1);
    return 626;
}
