use strings;
fn initials(name: string) -> string {
    mut out = "";
    for part in name.split(' ') {
        if !part.is_empty() { out.append(part[:1]); }
    }
    return out;
}
fn sum_borrowed(values: u64[]) -> u64 {
    mut total: u64 = 0;
    for x in &values { total += load(x); }
    return total + values.len();
}
fn bump(values: &mut u64[]) {
    for x in &mut values { exchange(x, load(x) + 1); }
}
fn early(values: u64[]) -> u64 {
    for x in values { if x == 2 { return x; } }
    return 0;
}
fn main() {
    println(initials("ada lovelace"));
    values := u64[1, 2];
    println(sum_borrowed(values));
    mut more = u64[1, 2];
    bump(&mut more);
    println(more[0]);
    println(more[1]);
    println(early(u64[1, 2, 3]));
}
