// The indirect-call fact (call ABI S6, the six-word form): the closure call in `apply` passes two
// words (the environment and `x`), and the lifter passes `poison` for the other four argument
// registers. tools/test-facts.mjs forges the fact one word short and checks that it is refused.
fn apply(f: &Fn(u64) -> u64, x: u64) -> u64 {
    return f(x);
}
fn main() {
    k := host::argc() + 4;
    g := |x: u64| -> u64 x * k;
    println("{}", apply(&g, 6));
}
