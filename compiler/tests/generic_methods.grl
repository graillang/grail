struct Stack<T>{items:vec<T>}
impl<T> Stack<T>{
    fn new()->Stack<T>{return Stack{items:vec<T>[]};}
    fn push<a>(self:ref_mut<a,Stack<T>>,v:T){self.items.push(v);}
    fn pop<a>(self:ref_mut<a,Stack<T>>)->T{return self.items.pop();}
    fn size<a>(self:ref<a,Self>)->num{return self.items.len();}
}
struct Pair<A,B>{left:A,right:B}
impl<A,B> Pair<A,B>{fn swap(self:Pair<A,B>)->Pair<B,A>{return Pair{left:self.right,right:self.left};}}
fn main(){
    mut s=Stack::new<num>();s.push(1);s.push(2);assert(s.size()==2);assert(s.pop()==2);
    mut t=Stack::new<bytes>();t.push(bytes[1,2]);t.push(bytes[3]);last:=t.pop();assert(last.len()==1);assert(t.size()==1);
    p:=Pair{left:1,right:bytes[9]};q:=p.swap();assert(q.right==1);assert(q.left[0]==9);
    println(42);
}
