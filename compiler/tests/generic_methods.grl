struct Stack<T> {
    items: T[]
}
impl<T> Stack<T> {
    fn new() -> Stack<T> {
        return Stack { items: T[] };
    }
    fn push<a>(self: (&mut a Stack<T>), v: T) {
        self.items.push(v);
    }
    fn pop<a>(self: (&mut a Stack<T>)) -> T {
        return self.items.pop();
    }
    fn size<a>(self: (&a Self)) -> u64 {
        return self.items.len();
    }
}
struct Pair<A, B> {
    left: A,
    right: B
}
impl<A, B> Pair<A, B> {
    fn swap(self: Pair<A, B>) -> Pair<B, A> {
        return Pair { left: self.right, right: self.left };
    }
}
fn main() {
    mut s = Stack::new<u64>();
    s.push(1);
    s.push(2);
    assert(s.size() == 2);
    assert(s.pop() == 2);
    mut t = Stack::new<u8[]>();
    t.push(u8[1, 2]);
    t.push(u8[3]);
    last := t.pop();
    assert(last.len() == 1);
    assert(t.size() == 1);
    p := Pair { left: 1, right: u8[9] };
    q := p.swap();
    assert(q.right == 1);
    assert(q.left[0] == 9);
    println(42);
}
