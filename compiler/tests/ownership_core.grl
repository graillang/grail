module ownership_core;
use ownership;

pub fn run() -> u64 {
    mut s = ownership::new();
    owner := ownership::root(&mut s, 0, 1);
    left := ownership::field(&mut s, owner, 0);
    right := ownership::field(&mut s, owner, 0);
    // Disjoint mutable field loans are allowed; borrowing the enclosing owner is not.
    a := ownership::borrow_place(&mut s, left, 1);
    b := ownership::borrow_place(&mut s, right, 1);
    assert(a != 0);
    assert(b != 0);
    assert(ownership::borrow_place(&mut s, owner, 0) == 0);
    assert(ownership::take(&mut s, left) == 3);
    assert(ownership::end_loan(&mut s, a) == 0);
    assert(ownership::end_loan(&mut s, b) == 0);
    // Partial moves preserve siblings but disallow moving/reading the whole aggregate.
    assert(ownership::take(&mut s, left) == 0);
    assert(ownership::take(&mut s, left) == 2);
    assert(ownership::read(&s, right) == 0);
    assert(ownership::read(&s, owner) == 5);
    assert(ownership::take(&mut s, owner) == 5);
    assert(ownership::initialize(&mut s, left) == 0);
    // A unique parent is suspended until every readonly descendant ends.
    u := ownership::borrow_place(&mut s, owner, 1);
    v := ownership::reborrow(&mut s, u, 0);
    assert(v != 0);
    assert(ownership::use_loan(&s, u, 1) == 6);
    w := ownership::reborrow(&mut s, v, 0);
    assert(w != 0);
    assert(ownership::reborrow(&mut s, v, 1) == 0);
    assert(ownership::end_loan(&mut s, u) == 6);
    assert(ownership::end_loan(&mut s, v) == 0);
    assert(ownership::use_loan(&s, w, 0) == 0);
    assert(ownership::use_loan(&s, u, 1) == 6);
    assert(ownership::end_loan(&mut s, w) == 0);
    assert(ownership::use_loan(&s, u, 1) == 0);
    assert(ownership::end_loan(&mut s, u) == 0);
    // Shared access permits owner reads but not owner movement or mutation.
    r := ownership::borrow_place(&mut s, owner, 0);
    assert(ownership::read(&s, owner) == 0);
    assert(ownership::take(&mut s, owner) == 3);
    assert(ownership::initialize(&mut s, left) == 3);
    assert(ownership::end_loan(&mut s, r) == 0);
    mut yes = ownership::snapshot(&s);
    no := ownership::snapshot(&s);
    assert(ownership::take(&mut yes, left) == 0);
    assert(ownership::join(&mut yes, &no) == 0);
    assert(ownership::status(&yes, left) == 3);
    assert(ownership::read(&yes, left) == 2);
    assert(ownership::read(&yes, right) == 0);
    assert(ownership::cleanup(&mut yes, owner) == 0);
    assert(ownership::status(&yes, owner) == 2);
    // Possible active loans at a join must still block conflicting operations.
    q := ownership::borrow_place(&mut s, right, 0);
    mut branch = ownership::snapshot(&s);
    assert(ownership::end_loan(&mut branch, q) == 0);
    assert(ownership::join(&mut branch, &s) == 0);
    assert(ownership::take(&mut branch, right) == 3);
    assert(ownership::end_loan(&mut s, q) == 0);
    assert(ownership::cleanup(&mut s, owner) == 0);
    assert(ownership::read(&s, right) == 2);
    pair := ownership::root(&mut s, 0, 1);
    x := ownership::field(&mut s, pair, 0);
    y := ownership::field(&mut s, pair, 0);
    parent := ownership::borrow_place(&mut s, pair, 1);
    child := ownership::reborrow_place(&mut s, parent, x, 1);
    assert(child != 0);
    assert(ownership::access_loan(&s, parent, y, 1) == 0);
    assert(ownership::access_loan(&s, parent, x, 1) == 3);
    other := ownership::reborrow_place(&mut s, parent, y, 1);
    assert(other != 0);
    assert(ownership::end_loan(&mut s, child) == 0);
    assert(ownership::end_loan(&mut s, other) == 0);
    assert(ownership::end_loan(&mut s, parent) == 0);
    // Numeric copies do not consume storage.
    n := ownership::root(&mut s, 1, 1);
    assert(ownership::take(&mut s, n) == 0);
    assert(ownership::take(&mut s, n) == 0);
    return 1;
}
