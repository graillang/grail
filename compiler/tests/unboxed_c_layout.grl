// Stage 7: records laid out as C lays out structs.
struct V3 {
    x: f32,
    y: f32,
    z: f32
}
struct Mixed {
    a: u8,
    b: u64,
    c: u16,
    d: i32
}
struct Pair<A, B> {
    first: A,
    second: B
}
struct Tagged {
    p: V3,
    tag: u8
}
fn bump<a>(m: (&a mut Mixed)) {
    m.a = m.a + 1;
    m.c = m.c + 2;
    m.d = m.d - 3;
}
fn main() {
    mut v = V3[];
    for i in 5 {
        f: f32 := f32(i);
        v.push(V3 { x: f, y: f * 2.0, z: f * 3.0 });
    }
    p := &mut v[2];
    p.y = 7.5;
    println("{} {} {} {}", v[2].x, v[2].y, v[2].z, v[4].z);
    mut m = Mixed { a: 250, b: 1 << 40, c: 65000, d: -5 };
    bump(&mut m);
    println("{} {} {} {}", m.a, m.b, m.c, m.d);
    q := Pair<u8, u64> { first: 9, second: 99 };
    r := Pair<u64, u8> { first: 7, second: 8 };
    println("{} {} {} {}", q.first, q.second, r.first, r.second);
    mut t = Tagged[];
    for i in 3 {
        t.push(Tagged { p: V3 { x: f32(i), y: 0.5, z: 0.25 }, tag: u8(i + 65) });
    }
    t[1].tag = 90;
    t[1].p.z = 9.0;
    println("{} {} {} {}", t[0].tag, t[1].tag, t[1].p.z, t[2].p.x);
    println(m == Mixed { a: 251, b: 1 << 40, c: 65002, d: -8 });
}
