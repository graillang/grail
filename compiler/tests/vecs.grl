use vecs;
fn main() {
    doubled := vecs::map(u64[1, 2, 3], |x: u64| -> u64 x * 2);
    assert(vecs::sum(doubled) == 12);
    offset := 100;
    labels := vecs::map(u64[1, 2], |x: u64| -> string format("#{}", x + offset));
    assert(labels[1].len() == 4);
    evens := vecs::filter_nums(u64[1, 2, 3, 4, 5, 6], |x: u64| -> bool x % 2 == 0);
    assert(evens.len() == 3);
    assert(vecs::max_num(u64[3, 9, 2]) == 9);
    mut v = u64[5, 1, 4, 2, 3];
    vecs::sort_nums(&mut v);
    for i in 5 {
        assert(v[i] == i + 1);
    }
    vecs::reverse(&mut v);
    assert(v[0] == 5);
    words := u8[][u8[1], u8[2, 3]];
    key := u8[2, 3];
    assert(vecs::contains(&words, &key));
    println(42);
}
