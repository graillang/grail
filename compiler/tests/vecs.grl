use vecs;
fn main(){
    doubled:=vecs::map(vec<num>[1,2,3],|x: num| -> num x*2);assert(vecs::sum(doubled)==12);
    offset:=100;labels:=vecs::map(vec<num>[1,2],|x: num| -> string format("#{}", x+offset));assert(labels[1].len()==4);
    evens:=vecs::filter_nums(vec<num>[1,2,3,4,5,6],|x: num| -> bool x%2==0);assert(evens.len()==3);
    assert(vecs::max_num(vec<num>[3,9,2])==9);
    mut v=vec<num>[5,1,4,2,3];vecs::sort_nums(borrow_mut(v));for i in 5{assert(v[i]==i+1);}
    vecs::reverse(borrow_mut(v));assert(v[0]==5);
    words:=vec<bytes>[bytes[1],bytes[2,3]];key:=bytes[2,3];assert(vecs::contains(borrow(words),borrow(key)));
    println(42);
}
