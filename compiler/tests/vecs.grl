// The vector methods: the adapters read left to right, and the free forwarders still agree.
use vecs;
fn main() {
    doubled := u64[1, 2, 3].map(|x: u64| -> u64 x * 2);
    assert(doubled.sum() == 12);
    offset := 100;
    labels := u64[1, 2].map(|x: u64| -> string format("#{}", x + offset));
    assert(labels[1].len() == 4);
    evens := u64[1, 2, 3, 4, 5, 6].filter(|x: &u64| -> bool *x % 2 == 0);
    assert(evens.len() == 3);
    three := u64[3, 9, 2];
    if let Some(best) = three.max() {
        assert(*best == 9);
    }
    if let Some(least) = three.min() {
        assert(*least == 2);
    }
    // Empty is None, never an abort.
    assert(u64[].max().is_none());
    assert(u64[].max_index().is_none());
    mut v = u64[5, 1, 4, 2, 3];
    v.sort();
    for i in 5 {
        assert(v[i] == i + 1);
    }
    assert(v.is_sorted());
    v.reverse();
    assert(v[0] == 5);
    words := u8[][u8[1], u8[2, 3]];
    key := u8[2, 3];
    assert(words.contains(&key));
    // The free names are forwarders onto the same methods.
    assert(u64[1, 2, 3].sum() == 6);
    println(42);
}
