module union_widening;
fn small(flag: bool) -> num | string {
    if flag {
        return 42;
    }
    return "error".text();
}
fn widen(flag: bool) -> bool | string | num {
    return small(flag);
}
fn main() {
    match widen(true) {
        bool(x) => {
            println(x);
        },
        string(x) => {
            println(x);
        },
        num(x) => {
            println(x);
        }
    }
    match widen(false) {
        bool(x) => {
            println(x);
        },
        string(x) => {
            println(x);
        },
        num(x) => {
            println(x);
        }
    }
}
