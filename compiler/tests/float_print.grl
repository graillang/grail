// Shortest round-trip printing: the decimal-shaped values the table-free fast path decides (up to
// 15 digits in [1e-7, 1e22)), its edges, and values only the exact algorithm decides (17 digits,
// subnormals, the extremes). The expected text is what Burger & Dybvig alone printed.
fn main() {
    for i in 40 {
        println(f64(i * 37) / 1000.0);
        println(f64(i) * 0.25);
        println(f64(i * 1009) / 7.0);
    }
    println(0.1 + 0.2);
    println(1e-7);
    println(9.999999e-8);
    println(1e21);
    println(1e22);
    println(123456789012345.0);
    println(1234567890123456.0);
    println(5e-324);
    println(2.2250738585072014e-308);
    println(1.7976931348623157e308);
    println(-2.5);
    println(0.5);
    println(100.0);
    println(0.000123);
}
