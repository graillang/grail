fn read<a>(cell: (&a atomic<u64>)) -> u64 {
    return cell.load_acquire();
}
fn main() {
    cell := atomic(7);
    assert(cell.load() == 7);
    cell.store(9);
    assert(cell.swap(10) == 9);
    assert(cell.compare_exchange(10, 11) == 10);
    assert(cell.compare_exchange(10, 12) == 11);
    assert(cell.load_relaxed() == 11);
    cell.store_release(13);
    assert(read(borrow(cell)) == 13);
    assert(cell.fetch_add(2) == 13);
    assert(cell.load() == 15);
    assert(cell.fetch_sub(3) == 15);
    cell.store_relaxed(18446744073709551615);
    assert(cell.fetch_add(1) == 18446744073709551615);
    assert(cell.load() == 0);
    println(42);
}
