// The signature fact (llvm.grl `fact_signature`): the LLVM backend defines `two` with exactly two
// argument words and a one-word result, and `as_shape` with one argument word and the two-word
// `&dyn` result. tools/test-facts.mjs forges each fact and checks that the lifter refuses it.
interface Shape {
    fn area(self: &Self) -> u64;
}
impl Shape for u64 {
    fn area(self: &Self) -> u64 {
        return *self;
    }
}
fn as_shape(v: &u64) -> &dyn Shape {
    return v;
}
fn two(a: u64, b: u64) -> u64 {
    return a * 10 + b;
}
fn main() {
    n := host::argc();
    x := n + 6;
    s := as_shape(&x);
    println("{} {}", two(n + 3, 4), s.area());
}
