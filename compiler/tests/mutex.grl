struct Counter {
    hits: u64,
    log: u8[]
}
fn bump<a>(counter: (&a mut Counter), amount: u64) -> u64 {
    counter.hits += amount;
    counter.log.push(amount);
    return counter.hits;
}
fn take<a>(data: (&a mut u8[]), replacement: u8[]) -> u8[] {
    return exchange(data, replacement);
}
fn read_len<a, b>(data: (&a mut u8[]), extra: &b [u8]) -> u64 {
    return data.len() + extra.len();
}
fn shared_bump<a, b>(m: (&a Mutex<Counter>), amount: u64) -> u64 {
    return m.lock_with(amount, bump);
}
fn share<T: Share>(value: T) -> T {
    return value;
}
fn send<T: Send>(value: T) -> T {
    return value;
}
fn main() {
    m := Mutex::new(Counter { hits: 0, log: u8[] });
    assert(m.lock_with(40, bump) == 40);
    assert(shared_bump(&m, 2) == 42);
    r := share(&m);
    assert(r.lock_with(0, bump) == 42);
    bytes_lock := send(Mutex::new(u8[1, 2, 3]));
    old := bytes_lock.lock_with(u8[9], take);
    assert(old.len() == 3);
    extra := u8[1, 1];
    assert(bytes_lock.lock_with(view(extra), read_len) == 3);
    vecs := Mutex<u8[]>[Mutex::new(u8[1]), Mutex::new(u8[2])];
    first := &vecs[0];
    assert(first.lock_with(view(extra), read_len) == 3);
    println(42);
}
