// strings::parse_f64 against Python's correctly rounded float(): exact decimals, 2^53 + 1 and its
// neighbours, halfway points (ties to even), overflow to infinity ("1e400"), underflow to zero, the
// subnormal boundary, the largest double and the first value that rounds past it, inputs longer
// than 19 digits (the Eisel-Lemire w / w + 1 check and the big-integer fallback), random doubles'
// shortest forms and random digit strings across the exponent range; then the grammar's rejects.
use strings;
fn check<a, b>(bad: (&a mut u64), text: &b [u8], want: u64) {
    got := bits(text.parse_f64()!);
    if got != want {
        println("{} -> {} want {}", text, got, want);
        exchange(bad, load(bad) + 1);
    }
}
fn reject<a, b>(bad: (&a mut u64), text: &b [u8]) {
    if text.parse_f64().is_some() {
        println("accepted {}", text);
        exchange(bad, load(bad) + 1);
    }
}
