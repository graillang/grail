    check(&mut bad, "5.006476975419759552271025006620786233537133522337046314960292900014374345853706011500858561059580610262773239743447985888616837512353523776626219319764601351758444167992656632060162605056e+186", 7400092555656553570);
    check(&mut bad, "9.-183", 1883938757646398644);
    check(&mut bad, "9.64171466106277552654546525445766746997833251953125", 4621617420874105270);
    check(&mut bad, "6.-296", 190803265570640520);
    check(&mut bad, "2.-205", 1545212380047516260);
    check(&mut bad, "1.-203", 1571689603370677998);
    check(&mut bad, "0.0000000000000017633200241100697631115439158216650414004821978246340119511614830116741359233856201171875", 4386439932551952456);
    check(&mut bad, "1.84531519783770502824280204270259680697042166100695604844150685444718589577646708411957258798186104293434968539917326273652061449997701822225393630861726588230978842066960458577249556867807374130953875943887048922568960761746680032668876947354874573647975921630859375e-92", 3234498184475597596);
    check(&mut bad, "1.-228", 1196433667948402644);
    check(&mut bad, "1.-247", 914966779952976142);
    check(&mut bad, "1.-176", 1973912121759713316);
    check(&mut bad, "1.45983299296701107955933424519738777236638323005220248774926986861603297301621630928601220374156060802476990242907156308308231200944728475520907345920e+149", 6838387735288670610);
    check(&mut bad, "6.8487626543167053863699105242419130973582339929953042518898127896707239803646031492177793165480236243623461832034019048908240303110743925213711747296358280876647980788232385374021025267712e+187", 7417282424876376202);
    reject(&mut bad, "");
    reject(&mut bad, "+");
    reject(&mut bad, "-");
    reject(&mut bad, ".");
    reject(&mut bad, "e5");
    reject(&mut bad, "1e");
    reject(&mut bad, "1e+");
    reject(&mut bad, "1.5e-");
    reject(&mut bad, "--1");
    reject(&mut bad, "1..2");
    reject(&mut bad, "1.2.3");
    reject(&mut bad, " 1");
    reject(&mut bad, "1 ");
    reject(&mut bad, "0x10");
    reject(&mut bad, "1_000");
    reject(&mut bad, "inf ");
    reject(&mut bad, "infx");
    reject(&mut bad, "nan1");
    reject(&mut bad, "1e5.5");
    reject(&mut bad, "+-1");
    assert(bits("inf".parse_f64()!) == 9218868437227405312);
    assert(bits("-Infinity".parse_f64()!) == 18442240474082181120);
    assert("NaN".parse_f64()!.is_nan());
    assert(bits("-0".parse_f64()!) == 9223372036854775808);
    println("parse_f64: {} cases, {} wrong", 2068, bad);
}
