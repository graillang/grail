// UTF-8 validation's eight-byte ASCII scan: valid text with every ASCII prefix length 0..39 (so
// each multi-byte sequence starts at every alignment), every sequence width, and ASCII after it;
// each must convert to a string unchanged. The rejections at word boundaries are separate cases.
fn main() {
    seqs := u8[][u8[195, 169], u8[226, 130, 172], u8[240, 159, 152, 128], u8[237, 159, 191], u8[244, 143, 191, 191]];
    mut ok: u64 = 0;
    for p in 40 {
        for s in seqs.len() {
            mut b = u8[];
            for i in p {
                b.push(97 + i % 26);
            }
            seq := view(seqs[s]);
            for k in seq.len() {
                b.push(seq[k]);
            }
            for i in 17 {
                b.push(65 + i);
            }
            t := b.text();
            if t.len() == b.len() {
                ok += 1;
            }
        }
    }
    println("utf8 scan: {} ok", ok);
}
