fn send<T:Send>(value:T)->T{return value;}
fn share<T:Share>(value:T)->T{return value;}
fn both<T:Send+Share>(value:T)->T{return value;}
fn relay<T:Send>(value:T)->T{return send(value);}
fn require<T:Send+Share>()->num{return 42;}
fn increment(value:num)->num{return value+1;}
struct Packet<T:Send+Share>{value:T}
struct Tree{children:Tree[],value:num}
fn main(){
    mut n=41;
    unique:=send(borrow_mut(n));exchange(unique,42);assert(n==42);
    shared:=share(borrow(n));assert(load(shared)==42);
    packet:=Packet{value:both(atomic(42))};assert(packet.value.load()==42);
    assert(require<Tree>()==42);
    callback:=both(increment);assert(callback(41)==42);
    data:=relay(u8[42]);assert(data[0]==42);
    println(42);
}
