fn increment(n:num)->num{return n+1;}
fn decrement(n:num)->num{return n-1;}
fn choose(flag:num)->fn(num)->num{if flag{return increment;}return decrement;}
fn apply<T,U>(function:fn(T)->U,value:T)->U{return function(value);}
fn twice(function:fn(num)->num,value:num)->num{return function(function(value));}
struct Dispatch{run:fn(num)->num}
fn bytes_len(b:u8[])->num{return b.len();}
fn left<a,b>(x:read<a>,y:read<b>)->read<a>{return x;}
fn relay<a,b>(function:fn(read<a>,read<b>)->read<a>,x:read<a>,y:read<b>)->read<a>{return function(x,y);}
fn identity<T>(value:T)->T{return value;}
fn factory<T>()->fn(T)->T{return identity<T>;}
fn main(){
    f:=increment;assert(f(41)==42);assert(apply(f,41)==42);assert(f(1)==2);
    assert(twice(f,40)==42);assert(choose(false)(43)==42);
    dispatch:=Dispatch{run:increment};assert(dispatch.run(41)==42);
    table:=(fn(num)->num)[increment,decrement];
    assert(table[0](41)==42);assert(table[1](43)==42);
    assert(apply(bytes_len,u8[1,2,3])==3);
    mut current=increment;n:=current(exchange(borrow_mut(current),decrement)(7));assert(n==9);assert(current(43)==42);
    a:=u8[42];mut b=u8[1];view:=relay(left,&a,&b);b.push(2);assert(view[0]==42);
    specific:=identity<num>;assert(specific(42)==42);assert(factory<num>()(42)==42);
    println(42);
}
