fn increment(n: u64) -> u64 {
    return n + 1;
}
fn decrement(n: u64) -> u64 {
    return n - 1;
}
fn choose(flag: u64) -> fn(u64) -> u64 {
    if flag {
        return increment;
    }
    return decrement;
}
fn apply<T, U>(function: fn(T) -> U, value: T) -> U {
    return function(value);
}
fn twice(function: fn(u64) -> u64, value: u64) -> u64 {
    return function(function(value));
}
struct Dispatch {
    run: fn(u64) -> u64
}
fn bytes_len(b: u8[]) -> u64 {
    return b.len();
}
fn left<a, b>(x: &a [u8], y: &b [u8]) -> &a [u8] {
    return x;
}
fn relay<a, b>(function: fn(&a [u8], &b [u8]) -> &a [u8], x: &a [u8], y: &b [u8]) -> &a [u8] {
    return function(x, y);
}
fn identity<T>(value: T) -> T {
    return value;
}
fn factory<T>() -> fn(T) -> T {
    return identity<T>;
}
fn main() {
    f := increment;
    assert(f(41) == 42);
    assert(apply(f, 41) == 42);
    assert(f(1) == 2);
    assert(twice(f, 40) == 42);
    assert(choose(false)(43) == 42);
    dispatch := Dispatch { run: increment };
    assert(dispatch.run(41) == 42);
    table := (fn(u64) -> u64)[increment, decrement];
    assert(table[0](41) == 42);
    assert(table[1](43) == 42);
    assert(apply(bytes_len, u8[1, 2, 3]) == 3);
    mut current = increment;
    n := current(exchange(&mut current, decrement)(7));
    assert(n == 9);
    assert(current(43) == 42);
    a := u8[42];
    mut b = u8[1];
    view := relay(left, view(a), view(b));
    b.push(2);
    assert(view[0] == 42);
    specific := identity<u64>;
    assert(specific(42) == 42);
    assert(factory<u64>()(42) == 42);
    println(42);
}
