use limits;
const OFFSET: i32 = -5;
const DEBUG: bool = false;
const SIZE: num = 64;
fn main(){mut v=num[];for i in SIZE{v.push(i);}assert(v.len()==64);assert(OFFSET+10==5);assert(!DEBUG);
 assert(limits::MAX_USERS==1000);g:=limits::GREETING;assert(g.len()==5);println("{} {}", limits::GREETING, OFFSET);}
