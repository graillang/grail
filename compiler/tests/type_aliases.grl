type Number = u64;
type LoadError = u64 | string;
struct Box {
    value: Number
}
fn show(value: LoadError) {
    match value {
        u64(n) => {
            println(n);
        },
        string(s) => {
            println(s);
        },
    }
}
fn main() {
    box := Box { value: 42 };
    println(box.value);
    show(7);
    show("x".text());
}
