// Every vector operation over records of plain data: a 2-word record, a 5-word record that nests
// two others, and records that are compared, copied and searched as values.
struct P {
    x: u64,
    y: u64
}
struct Seg {
    a: P,
    b: P,
    id: u64
}
fn p(x: u64, y: u64) -> P {
    return P { x: x, y: y };
}
fn seg(i: u64) -> Seg {
    return Seg { a: p(i, i + 1), b: p(i * 10, i * 10 + 1), id: i };
}
fn show<a>(v: (&a P[])) {
    mut line = "";
    for i in v.len() {
        line.append(format("{}:{} ", v[i].x, v[i].y));
    }
    println(line);
}
fn sum<a>(v: (&a Seg[])) -> u64 {
    mut t = 0;
    for s in v {
        t = t + s.a.x + s.a.y + s.b.x + s.b.y + s.id;
    }
    return t;
}
fn main() -> u64 {
    mut v = P[];
    for i in 20 {
        v.push(p(i, i * i));
    }
    println("{} {} {}", v.len(), v[0].y, v[19].y);
    v[3] = p(100, 200);
    v[4].x = 7;
    r := &mut v[5];
    r.y = r.y + 1;
    last := v.pop()!;
    println("{} {} {} {} {}", last.x, last.y, v[3].y, v[4].x, v[5].y);
    v.truncate(6);
    v.insert(1, p(50, 51));
    gone := v.remove(0);
    v.swap(0, 5);
    show(&v);
    v.reverse();
    show(&v);
    println("{} {}", gone.x, gone.y);
    mut w = P[];
    for i in v.len() {
        w.push(p(v[i].x, v[i].y));
    }
    println("{} {}", w.len(), w[2].x == v[2].x);
    part := &v[1..4];
    println("{} {} {}", part.len(), part[0].x, part[2].y);
    mut all = P[p(1, 2), p(3, 4)];
    while let Some(e) = w.pop() {
        all.push(e);
    }
    println("{} {} {}", all.len(), all[0].y, all[all.len() - 1].x);
    mut taken = 0;
    for q in all {
        taken = taken + q.x;
    }
    println(taken);

    mut segs = Seg[];
    for i in 9 {
        segs.push(seg(i));
    }
    println(sum(&segs));
    segs[2].b = p(1000, 2000);
    segs[3].b.y = 5;
    inner := &mut segs[4].a;
    inner.x = 77;
    moved := segs.remove(7);
    println("{} {} {} {} {}", sum(&segs), moved.b.x, segs[2].b.y, segs[3].b.y, segs[4].a.x);
    while let Some(s) = segs.pop() {
        if s.id == 5 {
            println("{} {}", s.a.y, s.b.x);
        }
    }
    println(segs.len());
    return 0;
}
