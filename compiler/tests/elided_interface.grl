use shown;
struct P {
    v: u64,
    name: u8[],
}
impl shown::Shown for P {
    fn value(self: &Self) -> u64 {
        return self.v;
    }
    fn label(self: &Self) -> &[u8] {
        return view(self.name);
    }
}
fn main() -> u64 {
    p := P { v: 7, name: u8[] };
    println(shown::Shown::value(&p));
    return 0;
}
