fn apply(f: Fn(u64) -> u64, x: u64) -> u64 {
    return f(x) + f(0);
}
fn adder(n: u64) -> Fn(u64) -> u64 {
    return |x: u64| -> u64 x + n;
}
fn twice(f: Fn(u64) -> u64, x: u64) -> u64 {
    return f(f(x));
}
fn main() {
    offset := 10;
    add := |x: u64| -> u64 x + offset;
    assert(add(5) == 15);
    assert(add(1) == 11);
    assert(apply(|x: u64| -> u64 x * 2, 21) == 42);
    plus3 := adder(3);
    assert(plus3(4) == 7);
    assert(twice(adder(5), 1) == 11);
    data := u8[1, 2, 3];
    size := || -> u64 data.len();
    assert(size() == 3);
    assert(size() == 3);
    label := "hi".text();
    greet := |times: u64| -> u64 {
        mut total = 0;for i in times { total += label.len(); } return total;
    };
    assert(greet(3) == 6);
    k := -4i32;
    neg := |y: i32| -> i32 y * k;
    assert(neg(2) == -8);
    flag := true;
    check := |b: bool| -> bool b && flag;
    assert(check(true));
    println(42);
}
