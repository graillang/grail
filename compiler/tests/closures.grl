fn apply(f:Fn(num)->num,x:num)->num{return f(x)+f(0);}
fn adder(n:num)->Fn(num)->num{return |x: num| -> num x + n;}
fn twice(f:Fn(num)->num,x:num)->num{return f(f(x));}
fn main(){
    offset:=10;
    add:=|x: num| -> num x + offset;
    assert(add(5)==15);assert(add(1)==11);
    assert(apply(|x: num| -> num x * 2, 21)==42);
    plus3:=adder(3);assert(plus3(4)==7);assert(twice(adder(5),1)==11);
    data:=u8[1,2,3];
    size:=|| -> num data.len();
    assert(size()==3);assert(size()==3);
    label:="hi".text();
    greet:=|times: num| -> num {
        mut total=0;
        for i in times { total += label.len(); }
        return total;
    };
    assert(greet(3)==6);
    k:=-4i32;neg:=|y: i32| -> i32 y * k;assert(neg(2)==-8);
    flag:=true;check:=|b: bool| -> bool b && flag;assert(check(true));
    println(42);
}
