use interface_contracts;
struct Number{value:num}
impl interface_contracts::Value for Number{
    fn value<a>(self:ref<a,Self>)->num{return self.value;}
}
interface Echo{fn echo(self:Self)->Self;}
impl Echo for bytes{fn echo(self:Self)->Self{return self;}}
interface Select{fn select<a,b,c>(first:read<a>,second:read<b>,self:ref<c,Self>)->read<a>;}
impl Select for num{
    fn select<c,b,a>(first:read<a>,second:read<b>,self:ref<c,Self>)->read<a>{return first;}
}
fn read<a,T:Send+interface_contracts::Value>(value:ref<a,T>)->num{return interface_contracts::Value::value(value);}
fn echo<T:Echo>(value:T)->T{return Echo::echo(value);}
struct Packet<T:interface_contracts::Value>{value:T}
fn main(){
    n:=42;assert(read(borrow(n))==42);
    r:=Number{value:42};assert(read(borrow(r))==42);
    f:=interface_contracts::Value::value<num>;assert(f(borrow(n))==42);
    data:=echo(bytes[42]);assert(data[0]==42);
    p:=Packet{value:42};assert(read(borrow(p.value))==42);
    a:=bytes[42];mut b=bytes[1];view:=Select::select(&a,&b,borrow(n));b.push(2);assert(view[0]==42);
    println(42);
}
