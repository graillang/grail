use interface_contracts;
struct Number {
    value: u64
}
impl interface_contracts::Value for Number {
    fn value<a>(self: (&a Self)) -> u64 {
        return self.value;
    }
}
interface Echo {
    fn echo(self: Self) -> Self;
}
impl Echo for u8[] {
    fn echo(self: Self) -> Self {
        return self;
    }
}
interface Select {
    fn select<a, b, c>(first: &a [u8], second: &b [u8], self: (&c Self)) -> &a [u8];
}
impl Select for u64 {
    fn select<c, b, a>(first: &a [u8], second: &b [u8], self: (&c Self)) -> &a [u8] {
        return first;
    }
}
fn read_value<a, T: Send + interface_contracts::Value>(value: (&a T)) -> u64 {
    return interface_contracts::Value::value(value);
}
fn echo<T: Echo>(value: T) -> T {
    return Echo::echo(value);
}
struct Packet<T: interface_contracts::Value> {
    value: T
}
fn main() {
    n := 42;
    assert(read_value(&n) == 42);
    r := Number { value: 42 };
    assert(read_value(&r) == 42);
    f := interface_contracts::Value::value<u64>;
    assert(f(&n) == 42);
    data := echo(u8[42]);
    assert(data[0] == 42);
    p := Packet { value: 42 };
    assert(read_value(&p.value) == 42);
    a := u8[42];
    mut b = u8[1];
    view := Select::select(view(a), view(b), &n);
    b.push(2);
    assert(view[0] == 42);
    println(42);
}
