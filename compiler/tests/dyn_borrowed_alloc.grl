// Building and calling a `&dyn` allocates nothing: the pair is written into the borrowing frame and
// the vtable is a static symbol, so the assembly has no heap object for it (`call rt_rec`) and
// `@no_alloc` proves the functions that build and dispatch one never allocate.
interface Shape {
    fn area(self: &Self) -> u64;
}
impl Shape for u64 {
    fn area(self: &Self) -> u64 {
        return *self;
    }
}
@no_alloc
fn as_shape(v: &u64) -> &dyn Shape {
    return v;
}
@no_alloc
fn doubled(v: &u64) -> u64 {
    s: &dyn Shape = v;
    return s.area() * 2;
}
fn main() {
    x := 7u64;
    s := as_shape(&x);
    println("{} {}", s.area(), doubled(&x));
}
