// Building a `&dyn` allocates nothing: the pair is written into the borrowing frame and the vtable
// is a static symbol, so a program with no owned `dyn` object has no heap object for one at all
// (no `call rt_rec`) and the function that builds and returns a `&dyn` satisfies `@no_alloc`.
interface Shape {
    fn area(self: &Self) -> u64;
}
impl Shape for u64 {
    fn area(self: &Self) -> u64 {
        return *self;
    }
}
@no_alloc
fn as_shape(v: &u64) -> &dyn Shape {
    return v;
}
fn main() {
    x := 7u64;
    s := as_shape(&x);
    bound: &dyn Shape = &x;
    mut shapes = (&dyn Shape)[];
    shapes.push(&x);
    println("{} {} {}", s.area(), bound.area(), shapes[0].area());
}
