module const_float_values;

pub const THIRD: f64 = 1.0 / 3.0;
pub const EIGHT: f64 = 2.0 * 4.0;
pub const NEG: f64 = -1.5 + 0.25;
pub const NEG_THIRD: f64 = -THIRD;
pub const CHAIN: f64 = (THIRD + 1.0) * 3.0 - 0.5;
// An f32 constant folds at f32 precision: the literals and the quotient round to binary32.
pub const F32_THIRD: f32 = 1.0 / 3.0;
pub const PLAIN: f64 = 1.5;
pub const PLAIN_NEG: f64 = -2.5;
pub const HALF_N: u64 = 8 / 2;
pub const SMALL: bool = THIRD < 0.5;
