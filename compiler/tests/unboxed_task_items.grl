// A plain record as a task item, spawned in a loop: each task must see its own record, not the
// words of a frame site the loop overwrote (the item travels boxed; the task adapter frees it).
struct P {
    a: u64,
    b: u64,
    c: u64
}
fn slow(p: P, k: u64) -> u64 {
    mut t = 0;
    for i in 200000 {
        t = wrapping_add(t, i % 7);
    }
    return p.a * 100 + p.b * 10 + p.c + k * 0 + t * 0;
}
fn run<s>(scope: (&s Scope<u64>), unused: u64) -> u64 {
    mut tasks = Task<u64>[];
    for i in 4 {
        tasks.push(spawn(scope, P { a: i, b: i + 1, c: i + 2 }, slow));
    }
    mut total = 0;
    while let Some(t) = tasks.pop() {
        total = total + join(t);
    }
    return total;
}
fn main() {
    println(task_scope(0, run));
}
