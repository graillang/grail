// Sized and signed division, remainder and multiplication at the edges of every width: truncating
// division with negative operands, values next to each type's limits, products that just fit.
fn show_i64(a: i64, b: i64) {
    println("{} {}", a / b, a % b);
}
fn mul_i64(a: i64, b: i64) {
    println(a * b);
}
fn show_i32(a: i32, b: i32) {
    println("{} {}", a / b, a % b);
}
fn mul_i32(a: i32, b: i32) {
    println(a * b);
}
fn show_i16(a: i16, b: i16) {
    println("{} {}", a / b, a % b);
}
fn mul_i16(a: i16, b: i16) {
    println(a * b);
}
fn show_i8(a: i8, b: i8) {
    println("{} {}", a / b, a % b);
}
fn mul_i8(a: i8, b: i8) {
    println(a * b);
}
fn show_u32(a: u32, b: u32) {
    println("{} {}", a / b, a % b);
}
fn mul_u32(a: u32, b: u32) {
    println(a * b);
}
fn show_u16(a: u16, b: u16) {
    println("{} {}", a / b, a % b);
}
fn mul_u16(a: u16, b: u16) {
    println(a * b);
}
fn show_u8(a: u8, b: u8) {
    println("{} {}", a / b, a % b);
}
fn mul_u8(a: u8, b: u8) {
    println(a * b);
