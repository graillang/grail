use sources;
struct Counter {
    n: u64,
    limit: u64,
}
impl sources::Source for Counter {
    type Item = u64;
    fn pull(self: &mut Self) -> Self::Item? {
        if self.n < self.limit {
            self.n = self.n + 1;
            return Some(self.n);
        }
        return None;
    }
}
struct Words {
    left: u64,
}
impl sources::Source for Words {
    type Item = string;
    fn pull(self: &mut Self) -> string? {
        if self.left == 0 {
            return None;
        }
        self.left = self.left - 1;
        return Some("w");
    }
}
fn first<T: sources::Source>(src: &mut T) -> T::Item? {
    return src.pull();
}
fn main() -> u64 {
    mut c = Counter { n: 0, limit: 4 };
    c.skip();
    got := sources::drain(&mut c);
    mut t = 0;
    for x in &got {
        t = t + *x;
    }
    println("{} {}", got.len(), t);
    mut w = Words { left: 3 };
    one := first(&mut w);
    ws := sources::drain(&mut w);
    println("{} {}", one.is_some(), ws.len());
    return 0;
}
