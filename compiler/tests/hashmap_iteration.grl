use hashmap;
use core;
fn model_find<a>(keys: (&a u64[]), key: u64) -> u64 {
    for i in keys.len() {
        if keys[i] == key {
            return i;
        }
    }
    return keys.len();
}
fn main() {
    mut m = hashmap::with_seed<u8[], u64>(3, 4);
    m.insert("pear".copy(), 3);
    m.insert("apple".copy(), 1);
    m.insert("fig".copy(), 2);
    for i in m.len() {
        k := m.key_at(i);
        v := m.value_at(i);
        println("{} = {}", k, load(v));
    }
    for i in m.len() {
        v := m.value_at_mut(i);
        exchange(v, load(v) * 10);
    }
    key := "fig".copy();
    assert(load(m.get(&key)!) == 20);
    // randomized operations checked against a vector model
    mut map = hashmap::with_seed<u64, u64>(9, 9);
    mut keys = u64[];
    mut values = u64[];
    mut state = 12345;
    for step in 3000 {
        state = (state * 1103515245 + 12345) % 2147483648;
        k := state % 200;
        op := (state / 256) % 3;
        if op < 2 {
            old := map.insert(k, step);
            pos := model_find(&keys, k);
            if pos < keys.len() {
                assert(old! == values[pos]);
                exchange(&mut values[pos], step);
            } else {
                assert(old.is_none());
                keys.push(k);
                values.push(step);
            }
        } else {
            got := map.remove(&k);
            pos := model_find(&keys, k);
            if pos < keys.len() {
                assert(got! == values[pos]);
                lk := keys.pop()!;
                lv := values.pop()!;
                if pos < keys.len() {
                    exchange(&mut keys[pos], lk);
                    exchange(&mut values[pos], lv);
                }
            } else {
                assert(got.is_none());
            }
        }
        assert(map.len() == keys.len());
    }
    for i in keys.len() {
        k := keys[i];
        assert(load(map.get(&k)!) == values[i]);
        assert(load(map.key_at(i)) == k);
    }
    println("model ok {}", keys.len());
}
