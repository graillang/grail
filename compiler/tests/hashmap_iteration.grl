use hashmap;
use core;
fn model_find<a>(keys: (&a u64[]), key: u64) -> u64 {
    for i in keys.len() {
        if keys[i] == key {
            return i;
        }
    }
    return keys.len();
}
fn main() {
    mut m = hashmap::with_seed<u8[], u64>(3, 4);
    hashmap::map_insert(&mut m, "pear".copy(), 3);
    hashmap::map_insert(&mut m, "apple".copy(), 1);
    hashmap::map_insert(&mut m, "fig".copy(), 2);
    for i in hashmap::map_len(&m) {
        k := hashmap::key_at(&m, i);
        v := hashmap::value_at(&m, i);
        println("{} = {}", k, load(v));
    }
    for i in hashmap::map_len(&m) {
        v := hashmap::value_at_mut(&mut m, i);
        exchange(v, load(v) * 10);
    }
    key := "fig".copy();
    assert(load(hashmap::map_get(&m, &key)!) == 20);
    // randomized operations checked against a vector model
    mut map = hashmap::with_seed<u64, u64>(9, 9);
    mut keys = u64[];
    mut values = u64[];
    mut state = 12345;
    for step in 3000 {
        state = (state * 1103515245 + 12345) % 2147483648;
        k := state % 200;
        op := (state / 256) % 3;
        if op < 2 {
            old := hashmap::map_insert(&mut map, k, step);
            pos := model_find(&keys, k);
            if pos < keys.len() {
                assert(old! == values[pos]);
                exchange(&mut values[pos], step);
            } else {
                assert(old.is_none());
                keys.push(k);
                values.push(step);
            }
        } else {
            got := hashmap::map_remove(&mut map, &k);
            pos := model_find(&keys, k);
            if pos < keys.len() {
                assert(got! == values[pos]);
                lk := keys.pop();
                lv := values.pop();
                if pos < keys.len() {
                    exchange(&mut keys[pos], lk);
                    exchange(&mut values[pos], lv);
                }
            } else {
                assert(got.is_none());
            }
        }
        assert(hashmap::map_len(&map) == keys.len());
    }
    for i in keys.len() {
        k := keys[i];
        assert(load(hashmap::map_get(&map, &k)!) == values[i]);
        assert(load(hashmap::key_at(&map, i)) == k);
    }
    println("model ok {}", keys.len());
}
