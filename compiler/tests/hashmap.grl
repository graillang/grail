use hashmap;
use hash;
use core;
struct Collision {
    number: u64
}
impl hash::Hash for Collision {
    fn hash<a, b>(key: (&a Self), state: (&mut b hash::Hasher)) {
        hash::write_num(state, 0);
    }
}
impl hash::Equal for Collision {
    fn equal<a, b>(left: (&a Self), right: (&b Self)) -> u64 {
        return left.number == right.number;
    }
}
fn is_none<T>(value: T?) -> u64 {
    match value {
        Some(inner) => {
            return false;
        },
        None => {
            return true;
        }
    }
}
fn main() {
    mut map = hashmap::with_seed<u64, u8[]>(1, 2);
    for i in 100 {
        hashmap::insert(borrow_mut(map), i, u8[i]);
    }
    assert(hashmap::len(borrow(map)) == 100);
    for i in 100 {
        value := hashmap::get(borrow(map), borrow(i))!;
        assert(value[0] == i);
    }
    old := hashmap::insert(borrow_mut(map), 42, u8[7])!;
    assert(old[0] == 42);
    replacement_key := 42;
    slot := hashmap::get_mut(borrow_mut(map), borrow(replacement_key))!;
    previous := exchange(slot, u8[42]);
    assert(previous[0] == 7);
    for i in 100 {
        removed := hashmap::remove(borrow_mut(map), borrow(i))!;
        assert(removed[0] == i);
    }
    assert(hashmap::len(borrow(map)) == 0);
    missing := 101;
    assert(hashmap::contains(borrow(map), borrow(missing)) == false);
    assert(is_none(hashmap::get(borrow(map), borrow(missing))));
    assert(is_none(hashmap::get_mut(borrow_mut(map), borrow(missing))));
    assert(is_none(hashmap::remove(borrow_mut(map), borrow(missing))));
    mut text = hashmap::with_seed<u8[], string>(1, 2);
    hashmap::insert(borrow_mut(text), u8[1, 2], "café".text());
    key := u8[1, 2];
    value := hashmap::get(borrow(text), borrow(key))!;
    assert(value.len() == 5);
    mut collisions = hashmap::with_seed<Collision, u8[]>(1, 2);
    for i in 40 {
        hashmap::insert(borrow_mut(collisions), Collision { number: i }, u8[i]);
    }
    for i in 40 {
        key := Collision { number: i };
        value := hashmap::remove(borrow_mut(collisions), borrow(key))!;
        assert(value[0] == i);
    }
    assert(hashmap::len(borrow(collisions)) == 0);
    println(42);
}
