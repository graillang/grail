use hashmap;
use hash;
use core;
struct Collision {
    number: u64
}
impl hash::Hash for Collision {
    fn hash<a, b>(key: (&a Self), state: (&b mut hash::Hasher)) {
        state.write_num(0);
    }
}
impl hash::Equal for Collision {
    fn equal<a, b>(left: (&a Self), right: (&b Self)) -> bool {
        return left.number == right.number;
    }
}
fn is_none<T>(value: T?) -> bool {
    match value {
        Some(inner) => {
            return false;
        },
        None => {
            return true;
        }
    }
}
fn main() {
    mut map = hashmap::with_seed<u64, u8[]>(1, 2);
    for i in 100 {
        map.insert(i, u8[i]);
    }
    assert(map.len() == 100);
    for i in 100 {
        value := map.get(&i)!;
        assert(value[0] == i);
    }
    old := map.insert(42, u8[7])!;
    assert(old[0] == 42);
    replacement_key := 42;
    slot := map.get_mut(&replacement_key)!;
    previous := exchange(slot, u8[42]);
    assert(previous[0] == 7);
    for i in 100 {
        removed := map.remove(&i)!;
        assert(removed[0] == i);
    }
    assert(map.len() == 0);
    missing := 101;
    assert(map.contains(&missing) == false);
    assert(is_none(map.get(&missing)));
    assert(is_none(map.get_mut(&missing)));
    assert(is_none(map.remove(&missing)));
    mut text = hashmap::with_seed<u8[], string>(1, 2);
    text.insert(u8[1, 2], "café".text());
    key := u8[1, 2];
    value := text.get(&key)!;
    assert(value.len() == 5);
    mut collisions = hashmap::with_seed<Collision, u8[]>(1, 2);
    for i in 40 {
        collisions.insert(Collision { number: i }, u8[i]);
    }
    for i in 40 {
        key := Collision { number: i };
        value := collisions.remove(&key)!;
        assert(value[0] == i);
    }
    assert(collisions.len() == 0);
    println(42);
}
