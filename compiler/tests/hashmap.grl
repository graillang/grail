use hashmap;
use hash;
use core;
struct Collision {
    number: u64
}
impl hash::Hash for Collision {
    fn hash<a, b>(key: (&a Self), state: (&b mut hash::Hasher)) {
        hash::write_num(state, 0);
    }
}
impl hash::Equal for Collision {
    fn equal<a, b>(left: (&a Self), right: (&b Self)) -> u64 {
        return left.number == right.number;
    }
}
fn is_none<T>(value: T?) -> u64 {
    match value {
        Some(inner) => {
            return false;
        },
        None => {
            return true;
        }
    }
}
fn main() {
    mut map = hashmap::with_seed<u64, u8[]>(1, 2);
    for i in 100 {
        hashmap::map_insert(&mut map, i, u8[i]);
    }
    assert(hashmap::map_len(&map) == 100);
    for i in 100 {
        value := hashmap::map_get(&map, &i)!;
        assert(value[0] == i);
    }
    old := hashmap::map_insert(&mut map, 42, u8[7])!;
    assert(old[0] == 42);
    replacement_key := 42;
    slot := hashmap::map_get_mut(&mut map, &replacement_key)!;
    previous := exchange(slot, u8[42]);
    assert(previous[0] == 7);
    for i in 100 {
        removed := hashmap::map_remove(&mut map, &i)!;
        assert(removed[0] == i);
    }
    assert(hashmap::map_len(&map) == 0);
    missing := 101;
    assert(hashmap::map_contains(&map, &missing) == false);
    assert(is_none(hashmap::map_get(&map, &missing)));
    assert(is_none(hashmap::map_get_mut(&mut map, &missing)));
    assert(is_none(hashmap::map_remove(&mut map, &missing)));
    mut text = hashmap::with_seed<u8[], string>(1, 2);
    hashmap::map_insert(&mut text, u8[1, 2], "café".text());
    key := u8[1, 2];
    value := hashmap::map_get(&text, &key)!;
    assert(value.len() == 5);
    mut collisions = hashmap::with_seed<Collision, u8[]>(1, 2);
    for i in 40 {
        hashmap::map_insert(&mut collisions, Collision { number: i }, u8[i]);
    }
    for i in 40 {
        key := Collision { number: i };
        value := hashmap::map_remove(&mut collisions, &key)!;
        assert(value[0] == i);
    }
    assert(hashmap::map_len(&collisions) == 0);
    println(42);
}
