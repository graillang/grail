use core;
use strings;
fn main(){
    a:=core::some(5);assert(a.is_some());assert(!a.is_none());assert(a.unwrap_or(0)==5);
    b:=core::none<num>();assert(b.is_none());assert(b.unwrap_or(9)==9);
    doubled:=core::some(21).map(|x: num| -> num x*2);assert(doubled!==42);
    text:=core::some(bytes[1,2,3]).map(|b: bytes| -> num b.len());assert(text!==3);
    r:=strings::parse_num(&"12").ok_or(bytes[7]);assert(r.is_ok());assert(r.unwrap_or(0)==12);
    bad:=strings::parse_num(&"x").ok_or(bytes[7]);assert(bad.is_err());assert(bad.ok().is_none());
    println(42);
}
