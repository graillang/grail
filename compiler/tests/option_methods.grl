use core;
use strings;
fn main() {
    a := Some(5);
    assert(a.is_some());
    assert(!a.is_none());
    assert(a.unwrap_or(0) == 5);
    b: u64? := None;
    assert(b.is_none());
    assert(b.unwrap_or(9) == 9);
    doubled := Some(21).map(|x: u64| -> u64 x * 2);
    assert(doubled! == 42);
    text := Some(u8[1, 2, 3]).map(|b: u8[]| -> u64 b.len());
    assert(text! == 3);
    r := view("12").parse_u64().ok_or(u8[7]);
    match r {
        u64(n) => {
            assert(n == 12);
        },
        u8[](e) => {
            assert(false);
        }
    }
    bad := view("x").parse_u64().ok_or(u8[7]);
    match bad {
        u64(n) => {
            assert(false);
        },
        u8[](e) => {
            assert(e.len() == 1);
        }
    }
    println(42);
}
