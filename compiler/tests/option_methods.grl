use core;
use strings;
fn main() {
    a := core::some(5);
    assert(a.is_some());
    assert(!a.is_none());
    assert(a.unwrap_or(0) == 5);
    b := core::none<u64>();
    assert(b.is_none());
    assert(b.unwrap_or(9) == 9);
    doubled := core::some(21).map(|x: u64| -> u64 x * 2);
    assert(doubled! == 42);
    text := core::some(u8[1, 2, 3]).map(|b: u8[]| -> u64 b.len());
    assert(text! == 3);
    r := strings::parse_num(view("12")).ok_or(u8[7]);
    match r {
        u64(n) => {
            assert(n == 12);
        },
        u8[](e) => {
            assert(false);
        }
    }
    bad := strings::parse_num(view("x")).ok_or(u8[7]);
    match bad {
        u64(n) => {
            assert(false);
        },
        u8[](e) => {
            assert(e.len() == 1);
        }
    }
    println(42);
}
