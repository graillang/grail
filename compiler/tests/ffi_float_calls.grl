// The FFI fact (call ABI S8a): a lifted call to a C function with float arguments and results is
// typed as C types it, so the floats travel in vector registers (tools/test-facts.mjs).
extern "C" fn scale(x: f64, k: i64, y: f32) -> f64 {
    return x * f64(k) + f64(y);
}
extern "C" fn half(x: f32) -> f32 {
    return x / f32(2.0);
}
fn main() -> u64 {
    n := host::argc();
    mut v: f64 = 0.0;
    mut w: f32 = f32(3.0);
    unsafe {
        for i in 1000 { v = scale(v, i64(n), f32(0.5)); }
        w = half(w);
    }
    println(v);
    println(f64(w));
    return 0;
}
