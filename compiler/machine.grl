module machine;
use host;

// Final lowering of the compiler's closed word-machine instruction stream.
// Target 0 retains x86-64 spelling; 1 is AArch64, 2 is RV64IMAFD (Linux ELF).
// This is static instruction selection in Grail, not execution or an external translator.
struct Out {
    text: u8[],
    target: u64,
    win: u64,
    plat: u64,
    next: u64
}
fn eq<a, b>(a: &a [u8], b: &b [u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}
fn starts<a, b>(a: &a [u8], b: &b [u8]) -> bool {
    if a.len() < b.len() {
        return false;
    }
    return eq(view((a[: b.len()])), view((b)));
}
fn trim<a>(s: &a [u8]) -> &a [u8] {
    mut a = 0;
    mut b = s.len();
    while a < b {
        if (s[a] != 32) & (s[a] != 9) & (s[a] != 13) {
            break;
        }
        a += 1;
    }
    while a < b {
        if (s[b - 1] != 32) & (s[b - 1] != 9) & (s[b - 1] != 13) {
            break;
        }
        b -= 1;
    }
    return s[a: b];
}
fn bad<a>(s: &a [u8]) -> unit {
    host::print(view("machine lowering: unsupported instruction/operand: "));
    host::print(s);
    host::print(view("\n"));
    assert(false);
    return ();
}
fn put<a, b>(o: (&a mut Out), s: &b [u8]) -> unit {
    for i in s.len() {
        o.text.push(s[i]);
    }
    return ();
}
fn u64<a>(o: (&a mut Out), n: u64) -> unit {
    if 9 < n {
        u64(&mut o, n / 10);
    }
    o.text.push(48 + n % 10);
    return ();
}
fn fresh<a>(o: (&a mut Out)) -> u64 {
    n := o.next;
    exchange(&mut o.next, n + 1);
    return n;
}
fn label<a>(o: (&a mut Out), n: u64) -> unit {
    put(&mut o, view(".Lmachine"));
    u64(&mut o, n);
    return ();
}
fn mark<a>(o: (&a mut Out), n: u64) -> unit {
    label(&mut o, n);
    put(&mut o, view(":\n"));
    return ();
}
fn split<a>(s: &a [u8], delimiter: u64) -> u8[][] {
    mut out = u8[][];
    mut start = 0;
    mut depth = 0;
    for i in s.len() {
        b := s[i];
        if b == 40 {
            depth += 1;
        }
        if b == 41 {
            assert(depth != 0);
            depth -= 1;
        }
        if (b == delimiter) & (depth == 0) {
            out.push((trim(view((s[start: i])))).copy());
            start = i + 1;
        }
    }
    out.push((trim(view((s[start:])))).copy());
    return out;
}
fn reg<a>(target: u64, s: &a [u8]) -> string {
    if eq(view((s)), view("%rax")) || eq(view((s)), view("%eax")) || eq(view((s)), view("%ax")) || eq(view((s)), view("%al")) {
        if target == 1 {
            return "x9";
        }
        return "t0";
    }
    if eq(view((s)), view("%rdi")) || eq(view((s)), view("%edi")) {
        if target == 1 {
            return "x0";
        }
        return "a0";
    }
    if eq(view((s)), view("%rsi")) || eq(view((s)), view("%esi")) {
        if target == 1 {
            return "x1";
        }
        return "a1";
    }
    // %dl: the byte store of a u8[] element (optimize.grl `leaf_expansion` 55) reads its value
    // from rdx; the store's width comes from `movb`.
    if eq(view((s)), view("%rdx")) || eq(view((s)), view("%edx")) || eq(view((s)), view("%dl")) {
        if target == 1 {
            return "x2";
        }
        return "a2";
    }
    if eq(view((s)), view("%rcx")) || eq(view((s)), view("%ecx")) {
        if target == 1 {
            return "x3";
        }
        return "a3";
    }
    if eq(view((s)), view("%r8")) || eq(view((s)), view("%r8d")) {
        if target == 1 {
            return "x4";
        }
        return "a4";
    }
    if eq(view((s)), view("%r9")) || eq(view((s)), view("%r9d")) {
        if target == 1 {
            return "x5";
        }
        return "a5";
    }
    if eq(view((s)), view("%r10")) || eq(view((s)), view("%r10d")) {
        if target == 1 {
            return "x6";
        }
        return "a6";
    }
    if eq(view((s)), view("%r11")) || eq(view((s)), view("%r11d")) {
        if target == 1 {
            return "x7";
        }
        return "a7";
    }
    if eq(view((s)), view("%r12")) {
        if target == 1 {
            return "x19";
        }
        return "s1";
    }
    if eq(view((s)), view("%r13")) {
        if target == 1 {
            return "x20";
        }
        return "s2";
    }
    if eq(view((s)), view("%r14")) {
        if target == 1 {
            return "x21";
        }
        return "s3";
    }
    if eq(view((s)), view("%r15")) {
        if target == 1 {
            return "x22";
        }
        return "s4";
    }
    if eq(view((s)), view("%rbx")) {
        if target == 1 {
            return "x23";
        }
        return "s5";
    }
    if eq(view((s)), view("%rbp")) {
        if target == 1 {
            return "x29";
        }
        return "s0";
    }
    if eq(view((s)), view("%rsp")) {
        return "sp";
    }
    bad(view((s)));
    return "";
}
fn small_reg<a>(s: &a [u8]) -> bool {
    return eq(view((s)), view("%eax"))
        || eq(view((s)), view("%edi"))
        || eq(view((s)), view("%esi"))
        || eq(view((s)), view("%edx"))
        || eq(view((s)), view("%ecx"))
        || eq(view((s)), view("%r8d"))
        || eq(view((s)), view("%r9d"))
        || eq(view((s)), view("%r10d"))
        || eq(view((s)), view("%r11d"));
}
fn armword<a>(s: &a [u8]) -> string {
    if eq(view((s)), view("sp")) {
        return "wsp";
    }
    mut out = "w";
    out.append(s[1:]);
    return out;
}
// Recognize only small decimal literals; expressions stay assembler constants.
fn small_literal<a>(value: &a [u8]) -> u64 {
    if value.len() == 0 {
        return 0;
    }
    mut n = 0;
    for i in value.len() {
        b := value[i];
        if b < 48 || 57 < b {
            return 0;
        }
        if 6553 < n {
            return 0;
        }
        n = n * 10 + b - 48;
        if 65536 < n {
            return 0;
        }
    }
    return n + 1;
}
fn constant<a, b, c>(o: (&a mut Out), dst: &b [u8], value: &c [u8]) -> unit {
    if o.target == 2 {
        put(&mut o, view("li "));
        put(&mut o, view((dst)));
        put(&mut o, view(","));
        put(&mut o, view((value)));
        put(&mut o, view("\n"));
        return ();
    }
    short := small_literal(view(value));
    if (short != 0) & (short < 65537) {
        put(&mut o, view("movz "));
        put(&mut o, view(dst));
        put(&mut o, view(",#"));
        u64(&mut o, short - 1);
        put(&mut o, view("\n"));
        return ();
    }
    if value.len() != 0 {
        if value[0] == 45 {
            negative := small_literal(value[1:]);
            if 1 < negative {
                put(&mut o, view("movn "));
                put(&mut o, view(dst));
                put(&mut o, view(",#"));
                u64(&mut o, negative - 2);
                put(&mut o, view("\n"));
                return ();
            }
        }
    }
    put(&mut o, view("movz "));
    put(&mut o, view((dst)));
    put(&mut o, view(",#(("));
    put(&mut o, view((value)));
    put(&mut o, view(")&65535)\n"));
    for i in 3 {
        put(&mut o, view("movk "));
        put(&mut o, view((dst)));
        put(&mut o, view(",#((("));
        put(&mut o, view((value)));
        put(&mut o, view(")>>"));
        u64(&mut o, (i + 1) * 16);
        put(&mut o, view(")&65535),lsl #"));
        u64(&mut o, (i + 1) * 16);
        put(&mut o, view("\n"));
    }
    return ();
}
fn move<a, b, c>(o: (&a mut Out), dst: &b [u8], src: &c [u8]) -> unit {
    if o.target == 1 {
        put(&mut o, view("mov "));
    } else {
        put(&mut o, view("mv "));
    }
    put(&mut o, view((dst)));
    put(&mut o, view(","));
    put(&mut o, view((src)));
    put(&mut o, view("\n"));
    return ();
}
// Address scratch is x13/t3; x12/t2 is used only while forming an address.
fn address<a, b>(o: (&a mut Out), operand: &b [u8]) -> unit {
    target := o.target;
    mut open = operand.len();
    for i in operand.len() {
        if operand[i] == 40 {
            open = i;
            break;
        }
    }
    if open == operand.len() {
        bad(view((operand)));
    }
    parts := split(view((operand[open + 1: operand.len() - 1])), 44);
    base := parts[0].copy();
    disp := operand[: open];
    if eq(view(base), view("%rip")) {
        if target == 1 {
            put(&mut o, view("adrp x13,"));
            put(&mut o, view((disp)));
            if o.plat == 1 {
                // Mach-O names page relocations instead of ELF's :lo12: modifier.
                put(&mut o, view("@PAGE\nadd x13,x13,"));
                put(&mut o, view((disp)));
                put(&mut o, view("@PAGEOFF\n"));
            } else {
                put(&mut o, view("\nadd x13,x13,:lo12:"));
                put(&mut o, view((disp)));
                put(&mut o, view("\n"));
            }
        } else {
            put(&mut o, view("lla t3,"));
            put(&mut o, view((disp)));
            put(&mut o, view("\n"));
        }
        return ();
    }
    r := reg(target, view(base));
    if target == 1 {
        move(&mut o, view("x13"), view(r));
    } else {
        move(&mut o, view("t3"), view(r));
    }
    if 1 < parts.len() {
        index := parts[1].copy();
        ir := reg(target, view(index));
        scale := parts[2].copy();
        mut shift = 0;
        if eq(view(scale), view("2")) {
            shift = 1;
        } else {
            if eq(view(scale), view("4")) {
                shift = 2;
            } else {
                if eq(view(scale), view("8")) {
                    shift = 3;
                } else {
                    if !eq(view(scale), view("1")) {
                        bad(view(scale));
                    }
                }
            }
        }
        if target == 1 {
            put(&mut o, view("add x13,x13,"));
            put(&mut o, view(ir));
            put(&mut o, view(",lsl #"));
            u64(&mut o, shift);
            put(&mut o, view("\n"));
        } else {
            put(&mut o, view("slli t2,"));
            put(&mut o, view(ir));
            put(&mut o, view(","));
            u64(&mut o, shift);
            put(&mut o, view("\nadd t3,t3,t2\n"));
        }
    }
    if (disp.len() != 0) & !eq(view((disp)), view("0")) {
        if target == 1 {
            constant(&mut o, view("x12"), view((disp)));
            put(&mut o, view("add x13,x13,x12\n"));
        } else {
            constant(&mut o, view("t2"), view((disp)));
            put(&mut o, view("add t3,t3,t2\n"));
        }
    }
    return ();
}
fn read_operand<a, b, c>(o: (&a mut Out), operand: &b [u8], dst: &c [u8], byte: u64) -> unit {
    assert(operand.len() != 0);
    target := o.target;
    if operand[0] == 36 {
        constant(&mut o, view((dst)), view((operand[1:])));
        return ();
    }
    if operand[0] == 37 {
        r := reg(target, view((operand)));
        move(&mut o, view((dst)), view(r));
        if byte != 0 {
            if target == 1 {
                put(&mut o, view("and "));
                put(&mut o, view((dst)));
                put(&mut o, view(","));
                put(&mut o, view((dst)));
                put(&mut o, view(",#255\n"));
            } else {
                put(&mut o, view("andi "));
                put(&mut o, view((dst)));
                put(&mut o, view(","));
                put(&mut o, view((dst)));
                put(&mut o, view(",255\n"));
            }
        }
        return ();
    }
    // `byte` is the access width: 0 a word, 1 a byte, 2 a zero-extended 32-bit word (movl), 3 a
    // zero-extended and 4 a sign-extended 16-bit halfword.
    address(&mut o, view((operand)));
    if byte > 2 {
        if target == 1 {
            if byte == 3 {
                put(&mut o, view("ldrh "));
                w := armword(view((dst)));
                put(&mut o, view(w));
            } else {
                put(&mut o, view("ldrsh "));
                put(&mut o, view((dst)));
            }
            put(&mut o, view(",[x13]\n"));
        } else {
            if byte == 3 {
                put(&mut o, view("lhu "));
            } else {
                put(&mut o, view("lh "));
            }
            put(&mut o, view((dst)));
            put(&mut o, view(",0(t3)\n"));
        }
        return ();
    }
    if target == 1 {
        if byte == 1 {
            put(&mut o, view("ldrb "));
            w := armword(view((dst)));
            put(&mut o, view(w));
        } else {
            if byte == 2 {
                put(&mut o, view("ldr "));
                w := armword(view((dst)));
                put(&mut o, view(w));
            } else {
                put(&mut o, view("ldr "));
                put(&mut o, view((dst)));
            }
        }
        put(&mut o, view(",[x13]\n"));
    } else {
        if byte == 1 {
            put(&mut o, view("lbu "));
        } else {
            if byte == 2 {
                put(&mut o, view("lwu "));
            } else {
                put(&mut o, view("ld "));
            }
        }
        put(&mut o, view((dst)));
        put(&mut o, view(",0(t3)\n"));
    }
    return ();
}
fn store<a, b>(o: (&a mut Out), operand: &b [u8], byte: u64) -> unit {
    target := o.target;
    assert(operand.len() != 0);
    if operand[0] == 37 {
        r := reg(target, view((operand)));
        if eq(view((operand)), view("%al")) {
            if target == 1 {
                put(&mut o, view("bfi x9,x10,#0,#8\n"));
            } else {
                put(&mut o, view("andi t2,t1,255\nli t3,-256\nand t0,t0,t3\nor t0,t0,t2\n"));
            }
            return ();
        }
        if small_reg(view((operand))) {
            if target == 1 {
                w := armword(view(r));
                put(&mut o, view("mov "));
                put(&mut o, view(w));
                put(&mut o, view(",w10\n"));
            } else {
                put(&mut o, view("slli "));
                put(&mut o, view(r));
                put(&mut o, view(",t1,32\nsrli "));
                put(&mut o, view(r));
                put(&mut o, view(","));
                put(&mut o, view(r));
                put(&mut o, view(",32\n"));
            }
            return ();
        }
        if target == 1 {
            move(&mut o, view(r), view("x10"));
        } else {
            move(&mut o, view(r), view("t1"));
        }
        return ();
    }
    address(&mut o, view((operand)));
    if byte == 3 {
        if target == 1 {
            put(&mut o, view("strh w10,[x13]\n"));
        } else {
            put(&mut o, view("sh t1,0(t3)\n"));
        }
        return ();
    }
    if target == 1 {
        if byte == 1 {
            put(&mut o, view("strb w10,[x13]\n"));
        } else {
            if byte == 2 {
                put(&mut o, view("str w10,[x13]\n"));
            } else {
                put(&mut o, view("str x10,[x13]\n"));
            }
        }
    } else {
        if byte == 1 {
            put(&mut o, view("sb t1,0(t3)\n"));
        } else {
            if byte == 2 {
                put(&mut o, view("sw t1,0(t3)\n"));
            } else {
                put(&mut o, view("sd t1,0(t3)\n"));
            }
        }
    }
    return ();
}
fn branch<a, b, c>(o: (&a mut Out), op: &b [u8], dest: &c [u8]) -> unit {
    if eq(view((op)), view("jmp")) {
        if o.target == 1 {
            put(&mut o, view("b "));
            put(&mut o, view((dest)));
            put(&mut o, view("\n"));
        } else {
            put(&mut o, view("lla t1,"));
            put(&mut o, view((dest)));
            put(&mut o, view("\njr t1\n"));
        }
        return ();
    }
    n := fresh(&mut o);
    if o.target == 1 {
        if eq(view((op)), view("je")) || eq(view((op)), view("jz")) {
            put(&mut o, view("b.ne "));
        } else {
            if eq(view((op)), view("jne")) || eq(view((op)), view("jnz")) {
                put(&mut o, view("b.eq "));
            } else {
                if eq(view((op)), view("jnc")) || eq(view((op)), view("jae")) {
                    put(&mut o, view("cbnz x15,"));
                } else {
                    if eq(view((op)), view("jb")) || eq(view((op)), view("jc")) {
                        put(&mut o, view("cbz x15,"));
                    } else {
                        bad(view((op)));
                    }
                }
            }
        }
        label(&mut o, n);
        put(&mut o, view("\nb "));
        put(&mut o, view((dest)));
        put(&mut o, view("\n"));
    } else {
        if eq(view((op)), view("je")) || eq(view((op)), view("jz")) {
            put(&mut o, view("beqz t4,"));
        } else {
            if eq(view((op)), view("jne")) || eq(view((op)), view("jnz")) {
                put(&mut o, view("bnez t4,"));
            } else {
                if eq(view((op)), view("jnc")) || eq(view((op)), view("jae")) {
                    put(&mut o, view("bnez t6,"));
                } else {
                    if eq(view((op)), view("jb")) || eq(view((op)), view("jc")) {
                        put(&mut o, view("beqz t6,"));
                    } else {
                        bad(view((op)));
                    }
                }
            }
        }
        label(&mut o, n);
        put(&mut o, view("\nlla t1,"));
        put(&mut o, view((dest)));
        put(&mut o, view("\njr t1\n"));
    }
    mark(&mut o, n);
    return ();
}
fn arithmetic<a, b, c, d>(o: (&a mut Out), op: &b [u8], src: &c [u8], dst: &d [u8]) -> unit {
    target := o.target;
    if target == 1 {
        read_operand(&mut o, view((src)), view("x10"), 0);
        read_operand(&mut o, view((dst)), view("x11"), 0);
    } else {
        read_operand(&mut o, view((src)), view("t1"), 0);
        read_operand(&mut o, view((dst)), view("t2"), 0);
    }
    if eq(view((op)), view("cmpq")) {
        if target == 1 {
            put(&mut o, view("cmp x11,x10\ncset x15,cc\n"));
        } else {
            put(&mut o, view("xor t4,t2,t1\nseqz t4,t4\nsltu t5,t2,t1\nmv t6,t5\n"));
        }
        return ();
    }
    if eq(view((op)), view("testq")) {
        if target == 1 {
            put(&mut o, view("tst x11,x10\nmov x15,#0\n"));
        } else {
            put(&mut o, view("and t4,t2,t1\nseqz t4,t4\nli t5,0\nli t6,0\n"));
        }
        return ();
    }
    if eq(view((op)), view("addq")) {
        if target == 1 {
            put(&mut o, view("adds x10,x11,x10\ncset x15,cs\n"));
        } else {
            put(&mut o, view("add t1,t2,t1\nsltu t6,t1,t2\nseqz t4,t1\n"));
        }
    } else {
        if eq(view((op)), view("subq")) {
            if target == 1 {
                put(&mut o, view("subs x10,x11,x10\ncset x15,cc\n"));
            } else {
                put(&mut o, view("sltu t6,t2,t1\nsub t1,t2,t1\nseqz t4,t1\n"));
            }
        } else {
            if eq(view((op)), view("imulq")) {
                if target == 1 {
                    put(
                        &mut o,
                        view("smulh x12,x11,x10\nmul x10,x11,x10\nasr x14,x10,#63\ncmp x12,x14\ncset x15,ne\n")
                    );
                } else {
                    put(
                        &mut o,
                        view("mulh t3,t2,t1\nmul t1,t2,t1\nsrai t2,t1,63\nxor t6,t3,t2\nsnez t6,t6\n")
                    );
                }
            } else {
                if eq(view((op)), view("xorq")) || eq(view((op)), view("xorl")) {
                    if target == 1 {
                        put(&mut o, view("eor x10,x11,x10\ncmp x10,#0\nmov x15,#0\n"));
                    } else {
                        put(&mut o, view("xor t1,t2,t1\nseqz t4,t1\nli t6,0\n"));
                    }
                } else {
                    if eq(view((op)), view("andq")) {
                        if target == 1 {
                            put(&mut o, view("ands x10,x11,x10\nmov x15,#0\n"));
                        } else {
                            put(&mut o, view("and t1,t2,t1\nseqz t4,t1\nli t6,0\n"));
                        }
                    } else {
                        if eq(view((op)), view("orq")) {
                            if target == 1 {
                                put(&mut o, view("orr x10,x11,x10\ncmp x10,#0\nmov x15,#0\n"));
                            } else {
                                put(&mut o, view("or t1,t2,t1\nseqz t4,t1\nli t6,0\n"));
                            }
                        } else {
                            if eq(view((op)), view("shlq")) {
                                if target == 1 {
                                    put(&mut o, view("lsl x10,x11,x10\n"));
                                } else {
                                    put(&mut o, view("sll t1,t2,t1\n"));
                                }
                            } else {
                                if eq(view((op)), view("shrq")) {
                                    if target == 1 {
                                        put(&mut o, view("lsr x10,x11,x10\n"));
                                    } else {
                                        put(&mut o, view("srl t1,t2,t1\n"));
                                    }
                                } else {
                                    if eq(view((op)), view("sarq")) {
                                        if target == 1 {
                                            put(&mut o, view("asr x10,x11,x10\n"));
                                        } else {
                                            put(&mut o, view("sra t1,t2,t1\n"));
                                        }
                                    } else {
                                        bad(view((op)));
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    store(&mut o, view((dst)), 0);
    return ();
}
// ---- atomics: the `atom.*` stream ops (docs/design/concurrency-stages-5-7.md, "Stage 7") ----------
// native.grl writes one line per atomic operation, with fixed registers: the cell's address in %rdi,
// the operand (or the expected value) in %rax, the new value of a compare-exchange in %rcx, and the
// result in %rax. Every other register the expansion needs is scratch the front end never keeps a
// value in across the line (x10-x12, t1/t2/t5; %rcx/%rsi on x86-64).
//   atom.load ORDER WIDTH        atom.store ORDER WIDTH        atom.rmw OP ORDER WIDTH
//   atom.cas ORDER WIDTH         atom.casw ORDER WIDTH         atom.fence ORDER        atom.spin
// ORDER is relaxed, acquire, release, acqrel or seqcst; WIDTH is u8..u64, i8..i64 or bool; OP is
// xchg, add, sub, and, or, xor, min or max. An `Atomic<T>` is an 8-byte cell holding its value
// zero- or sign-extended (as a register holds a `T`), so every access is 64 bits wide and only a
// narrow add/sub has to cut its result back to the width before storing it. `atom.casw` is the weak
// form: it may fail spuriously and answers 1 (stored) or 0, because a value seen equal to the
// expected one cannot tell a spurious failure from success.
pub struct Atom {
    // 1 load, 2 store, 3 rmw, 4 cas, 5 weak cas, 6 fence, 7 spin hint.
    kind: u64,
    // 1 xchg, 2 add, 3 sub, 4 and, 5 or, 6 xor, 7 min, 8 max.
    op: u64,
    // 0 relaxed, 1 acquire, 2 release, 3 acqrel, 4 seqcst.
    order: u64,
    // 8, 16, 32 or 64; a bool is 8 bits wide.
    bits: u64,
    signed: u64
}
// The parsed line, or kind 0 when `line` is not an atomic op. A malformed one is a compiler bug.
pub fn atom_parse<a>(line: &a [u8]) -> Atom {
    mut a = Atom { kind: 0, op: 0, order: 4, bits: 64, signed: 0 };
    if !starts(view(line), view("atom.")) {
        return a;
    }
    words := split(view(line), 32);
    mut at = 1;
    name := words[0].copy();
    mut kind = 0;
    if eq(view(name), view("atom.load")) {
        kind = 1;
    }
    if eq(view(name), view("atom.store")) {
        kind = 2;
    }
    if eq(view(name), view("atom.rmw")) {
        kind = 3;
    }
    if eq(view(name), view("atom.cas")) {
        kind = 4;
    }
    if eq(view(name), view("atom.casw")) {
        kind = 5;
    }
    if eq(view(name), view("atom.fence")) {
        kind = 6;
    }
    if eq(view(name), view("atom.spin")) {
        kind = 7;
    }
    if kind == 0 {
        bad(view(line));
    }
    a.kind = kind;
    if kind == 7 {
        return a;
    }
    if kind == 3 {
        if words.len() <= at {
            bad(view(line));
        }
        w := words[at].copy();
        at += 1;
        ops := u8[][copy_bytes(view("xchg")), copy_bytes(view("add")), copy_bytes(view("sub")), copy_bytes(view("and")), copy_bytes(view("or")), copy_bytes(view("xor")), copy_bytes(view("min")), copy_bytes(view("max"))];
        for i in ops.len() {
            if eq(view(w), view(ops[i])) {
                a.op = i + 1;
            }
        }
        if a.op == 0 {
            bad(view(line));
        }
    }
    if words.len() <= at {
        bad(view(line));
    }
    ow := words[at].copy();
    at += 1;
    orders := u8[][copy_bytes(view("relaxed")), copy_bytes(view("acquire")), copy_bytes(view("release")), copy_bytes(view("acqrel")), copy_bytes(view("seqcst"))];
    mut found = 0;
    for i in orders.len() {
        if eq(view(ow), view(orders[i])) {
            a.order = i;
            found = 1;
        }
    }
    if found == 0 {
        bad(view(line));
    }
    if kind == 6 {
        return a;
    }
    if words.len() != at + 1 {
        bad(view(line));
    }
    ww := words[at].copy();
    if eq(view(ww), view("bool")) {
        a.bits = 8;
    } else {
        if ww.len() < 2 || ((ww[0] != 117) & (ww[0] != 105)) {
            bad(view(line));
        }
        mut n = 0;
        for i in ww.len() - 1 {
            n = n * 10 + ww[i + 1] - 48;
        }
        if (n != 8) & (n != 16) & (n != 32) & (n != 64) {
            bad(view(line));
        }
        a.bits = n;
        if ww[0] == 105 {
            a.signed = 1;
        }
    }
    return a;
}
fn copy_bytes<a>(s: &a [u8]) -> u8[] {
    return s.copy();
}
// Whether `o.order` makes the load half of a read-modify-write an acquire / the store half a release.
fn atom_acquires(order: u64) -> bool {
    return (order == 1) || (order == 3) || (order == 4);
}
fn atom_releases(order: u64) -> bool {
    return (order == 2) || (order == 3) || (order == 4);
}
// Cut the 64-bit result in `r` back to the atomic's width, extended as the type is.
fn atom_normalize<a, b>(o: (&a mut Out), a: (&Atom), r: &b [u8]) -> unit {
    if a.bits == 64 {
        return ();
    }
    if o.target == 1 {
        w := armword(view(r));
        if a.signed != 0 {
            if a.bits == 8 {
                put(&mut o, view("sxtb "));
            }
            if a.bits == 16 {
                put(&mut o, view("sxth "));
            }
            if a.bits == 32 {
                put(&mut o, view("sxtw "));
            }
            put(&mut o, view(r));
            put(&mut o, view(","));
            put(&mut o, view(w));
            put(&mut o, view("\n"));
        } else {
            if a.bits == 32 {
                put(&mut o, view("mov "));
                put(&mut o, view(w));
                put(&mut o, view(","));
                put(&mut o, view(w));
                put(&mut o, view("\n"));
            } else {
                put(&mut o, view("and "));
                put(&mut o, view(r));
                put(&mut o, view(","));
                put(&mut o, view(r));
                if a.bits == 8 {
                    put(&mut o, view(",#255\n"));
                } else {
                    put(&mut o, view(",#65535\n"));
                }
            }
        }
        return ();
    }
    if (a.signed != 0) & (a.bits == 32) {
        put(&mut o, view("sext.w "));
        put(&mut o, view(r));
        put(&mut o, view(","));
        put(&mut o, view(r));
        put(&mut o, view("\n"));
        return ();
    }
    if (a.signed == 0) & (a.bits == 8) {
        put(&mut o, view("andi "));
        put(&mut o, view(r));
        put(&mut o, view(","));
        put(&mut o, view(r));
        put(&mut o, view(",255\n"));
        return ();
    }
    shift := 64 - a.bits;
    put(&mut o, view("slli "));
    put(&mut o, view(r));
    put(&mut o, view(","));
    put(&mut o, view(r));
    put(&mut o, view(","));
    u64(&mut o, shift);
    if a.signed != 0 {
        put(&mut o, view("\nsrai "));
    } else {
        put(&mut o, view("\nsrli "));
    }
    put(&mut o, view(r));
    put(&mut o, view(","));
    put(&mut o, view(r));
    put(&mut o, view(","));
    u64(&mut o, shift);
    put(&mut o, view("\n"));
    return ();
}
// AArch64 (v8.0: ldar/stlr and exclusive-pair loops; LSE is a later option) and RV64 (AMOs, LR/SC),
// following the C/C++11 mappings: ARMv8 with ldar/stlr for sequential consistency, and RISC-V's
// table A.6. x86-64 is `atomics_x86` below.
fn atomic_instruction<a, b>(o: (&a mut Out), line: &b [u8]) -> bool {
    a := atom_parse(view(line));
    if a.kind == 0 {
        return false;
    }
    arm := o.target == 1;
    if a.kind == 7 {
        if arm {
            put(&mut o, view("yield\n"));
        } else {
            // `pause` (Zihintpause) is a FENCE encoding with no successor set: a no-op hint on a core
            // without the extension.
            put(&mut o, view(".4byte 0x0100000f\n"));
        }
        return true;
    }
    if a.kind == 6 {
        if arm {
            if a.order == 1 {
                put(&mut o, view("dmb ishld\n"));
            } else {
                put(&mut o, view("dmb ish\n"));
            }
        } else {
            if a.order == 1 {
                put(&mut o, view("fence r,rw\n"));
            } else {
                if a.order == 2 {
                    put(&mut o, view("fence rw,w\n"));
                } else {
                    put(&mut o, view("fence rw,rw\n"));
                }
            }
        }
        return true;
    }
    if a.kind == 1 {
        if arm {
            if a.order == 0 {
                put(&mut o, view("ldr x9,[x0]\n"));
            } else {
                put(&mut o, view("ldar x9,[x0]\n"));
            }
        } else {
            if a.order == 4 {
                put(&mut o, view("fence rw,rw\n"));
            }
            put(&mut o, view("ld t0,0(a0)\n"));
            if a.order != 0 {
                put(&mut o, view("fence r,rw\n"));
            }
        }
        return true;
    }
    if a.kind == 2 {
        if arm {
            if a.order == 0 {
                put(&mut o, view("str x9,[x0]\n"));
            } else {
                put(&mut o, view("stlr x9,[x0]\n"));
            }
        } else {
            if a.order != 0 {
                put(&mut o, view("fence rw,w\n"));
            }
            put(&mut o, view("sd t0,0(a0)\n"));
        }
        return true;
    }
    acq := atom_acquires(a.order);
    rel := atom_releases(a.order);
    if arm {
        mut ld = "ldxr";
        if acq {
            ld = "ldaxr";
        }
        mut st = "stxr";
        if rel {
            st = "stlxr";
        }
        again := fresh(&mut o);
        done := fresh(&mut o);
        if a.kind == 3 {
            mark(&mut o, again);
            put(&mut o, view(ld));
            put(&mut o, view(" x10,[x0]\n"));
            mut value = "x11";
            if a.op == 1 {
                value = "x9";
            }
            if a.op == 2 {
                put(&mut o, view("add x11,x10,x9\n"));
            }
            if a.op == 3 {
                put(&mut o, view("sub x11,x10,x9\n"));
            }
            if a.op == 4 {
                put(&mut o, view("and x11,x10,x9\n"));
            }
            if a.op == 5 {
                put(&mut o, view("orr x11,x10,x9\n"));
            }
            if a.op == 6 {
                put(&mut o, view("eor x11,x10,x9\n"));
            }
            if (a.op == 7) || (a.op == 8) {
                put(&mut o, view("cmp x10,x9\ncsel x11,x10,x9,"));
                if a.signed != 0 {
                    if a.op == 7 {
                        put(&mut o, view("lt\n"));
                    } else {
                        put(&mut o, view("gt\n"));
                    }
                } else {
                    if a.op == 7 {
                        put(&mut o, view("lo\n"));
                    } else {
                        put(&mut o, view("hi\n"));
                    }
                }
            }
            if (a.op == 2) || (a.op == 3) {
                atom_normalize(&mut o, &a, view("x11"));
            }
            put(&mut o, view(st));
            put(&mut o, view(" w12,"));
            put(&mut o, view(value));
            put(&mut o, view(",[x0]\ncbnz w12,"));
            label(&mut o, again);
            put(&mut o, view("\nmov x9,x10\n"));
            return true;
        }
        if a.kind == 4 {
            mark(&mut o, again);
            put(&mut o, view(ld));
            put(&mut o, view(" x10,[x0]\ncmp x10,x9\nb.ne "));
            label(&mut o, done);
            put(&mut o, view("\n"));
            put(&mut o, view(st));
            put(&mut o, view(" w12,x3,[x0]\ncbnz w12,"));
            label(&mut o, again);
            put(&mut o, view("\n"));
            mark(&mut o, done);
            put(&mut o, view("clrex\nmov x9,x10\n"));
            return true;
        }
        put(&mut o, view("mov x11,#0\n"));
        put(&mut o, view(ld));
        put(&mut o, view(" x10,[x0]\ncmp x10,x9\nb.ne "));
        label(&mut o, done);
        put(&mut o, view("\n"));
        put(&mut o, view(st));
        put(&mut o, view(" w12,x3,[x0]\ncmp w12,#0\ncset x11,eq\n"));
        mark(&mut o, done);
        put(&mut o, view("clrex\nmov x9,x11\n"));
        return true;
    }
    // RV64. AMO suffix and the LR/SC pair: table A.6 puts .aqrl on the load-reserved of a
    // sequentially consistent loop.
    mut amo = "";
    if acq & rel {
        amo = ".aqrl";
    } else {
        if acq {
            amo = ".aq";
        }
        if rel {
            amo = ".rl";
        }
    }
    mut lr = "lr.d";
    if a.order == 4 {
        lr = "lr.d.aqrl";
    } else {
        if acq {
            lr = "lr.d.aq";
        }
    }
    mut sc = "sc.d";
    if rel {
        sc = "sc.d.rl";
    }
    if a.kind == 3 {
        narrow := (a.bits != 64) & ((a.op == 2) || (a.op == 3));
        if !narrow {
            mut name = "amoswap.d";
            if a.op == 2 {
                name = "amoadd.d";
            }
            if a.op == 3 {
                put(&mut o, view("neg t0,t0\n"));
                name = "amoadd.d";
            }
            if a.op == 4 {
                name = "amoand.d";
            }
            if a.op == 5 {
                name = "amoor.d";
            }
            if a.op == 6 {
                name = "amoxor.d";
            }
            if a.op == 7 {
                if a.signed != 0 {
                    name = "amomin.d";
                } else {
                    name = "amominu.d";
                }
            }
            if a.op == 8 {
                if a.signed != 0 {
                    name = "amomax.d";
                } else {
                    name = "amomaxu.d";
                }
            }
            put(&mut o, view(name));
            put(&mut o, view(amo));
            put(&mut o, view(" t0,t0,(a0)\n"));
            return true;
        }
        again := fresh(&mut o);
        mark(&mut o, again);
        put(&mut o, view(lr));
        put(&mut o, view(" t1,(a0)\n"));
        if a.op == 2 {
            put(&mut o, view("add t2,t1,t0\n"));
        } else {
            put(&mut o, view("sub t2,t1,t0\n"));
        }
        atom_normalize(&mut o, &a, view("t2"));
        put(&mut o, view(sc));
        put(&mut o, view(" t5,t2,(a0)\nbnez t5,"));
        label(&mut o, again);
        put(&mut o, view("\nmv t0,t1\n"));
        return true;
    }
    again := fresh(&mut o);
    done := fresh(&mut o);
    if a.kind == 4 {
        mark(&mut o, again);
        put(&mut o, view(lr));
        put(&mut o, view(" t1,(a0)\nbne t1,t0,"));
        label(&mut o, done);
        put(&mut o, view("\n"));
        put(&mut o, view(sc));
        put(&mut o, view(" t5,a3,(a0)\nbnez t5,"));
        label(&mut o, again);
        put(&mut o, view("\n"));
        mark(&mut o, done);
        put(&mut o, view("mv t0,t1\n"));
        return true;
    }
    put(&mut o, view("li t2,0\n"));
    put(&mut o, view(lr));
    put(&mut o, view(" t1,(a0)\nbne t1,t0,"));
    label(&mut o, done);
    put(&mut o, view("\n"));
    put(&mut o, view(sc));
    put(&mut o, view(" t5,a3,(a0)\nseqz t2,t5\n"));
    mark(&mut o, done);
    put(&mut o, view("mv t0,t2\n"));
    return true;
}
// x86-64 (ELF and PE): TSO gives acquire loads and release stores for free, so only a sequentially
// consistent store (`xchg`) and a sequentially consistent fence (`mfence`) cost anything beyond the
// access. A 64-bit add/sub is one `lock xadd`; everything that has to compute the new value from the
// old one (and/or/xor with their result, min/max, a narrow add/sub that wraps at its width) is a
// `lock cmpxchg` loop. Each expansion is preceded by its op as a comment, so the assembly says
// which instructions are the atomic and with what order.
pub fn has_atomics<a>(input: &a [u8]) -> bool {
    for i in input.len() {
        if (input[i] == 97) && ((i == 0) || (input[i - 1] == 10)) {
            if starts(view(input[i:]), view("atom.")) {
                return true;
            }
        }
        if (input[i] == 115) && ((i == 0) || (input[i - 1] == 10)) {
            if starts(view(input[i:]), view("simd.")) {
                return true;
            }
        }
    }
    return false;
}
pub fn atomics_x86<a>(input: &a [u8]) -> u8[] {
    mut o = Out { text: u8[], target: 0, win: 0, plat: 0, next: 1 };
    mut start = 0;
    for i in input.len() {
        if input[i] == 10 {
            line := input[start: i];
            start = i + 1;
            a := atom_parse(view(line));
            sv := simd_parse(view(line));
            if sv.op != 0 {
                put(&mut o, view("# "));
                put(&mut o, view(line));
                put(&mut o, view("\n"));
                simd_expand(&mut o, &sv);
            } else if a.kind == 0 {
                put(&mut o, view(line));
                put(&mut o, view("\n"));
            } else {
                put(&mut o, view("# "));
                put(&mut o, view(line));
                put(&mut o, view("\n"));
                atom_x86(&mut o, &a);
            }
        }
    }
    put(&mut o, view(input[start:]));
    return o.text;
}
fn atom_x86_label<a>(o: (&a mut Out), n: u64) -> unit {
    put(&mut o, view(".Latom"));
    u64(&mut o, n);
    return ();
}
fn atom_x86<a>(o: (&a mut Out), a: (&Atom)) -> unit {
    if a.kind == 7 {
        put(&mut o, view("pause\n"));
        return ();
    }
    if a.kind == 6 {
        if a.order == 4 {
            put(&mut o, view("mfence\n"));
        }
        return ();
    }
    if a.kind == 1 {
        put(&mut o, view("movq (%rdi),%rax\n"));
        return ();
    }
    if a.kind == 2 {
        if a.order == 4 {
            put(&mut o, view("xchgq %rax,(%rdi)\n"));
        } else {
            put(&mut o, view("movq %rax,(%rdi)\n"));
        }
        return ();
    }
    if a.kind == 4 {
        put(&mut o, view("lock cmpxchgq %rcx,(%rdi)\n"));
        return ();
    }
    if a.kind == 5 {
        put(&mut o, view("lock cmpxchgq %rcx,(%rdi)\nsete %al\nmovzbl %al,%eax\n"));
        return ();
    }
    if a.op == 1 {
        put(&mut o, view("xchgq %rax,(%rdi)\n"));
        return ();
    }
    if (a.bits == 64) & ((a.op == 2) || (a.op == 3)) {
        if a.op == 3 {
            put(&mut o, view("negq %rax\n"));
        }
        put(&mut o, view("lock xaddq %rax,(%rdi)\n"));
        return ();
    }
    n := fresh(&mut o);
    put(&mut o, view("movq %rax,%rsi\nmovq (%rdi),%rax\n"));
    atom_x86_label(&mut o, n);
    put(&mut o, view(":\nmovq %rax,%rcx\n"));
    if a.op == 2 {
        put(&mut o, view("addq %rsi,%rcx\n"));
    }
    if a.op == 3 {
        put(&mut o, view("subq %rsi,%rcx\n"));
    }
    if a.op == 4 {
        put(&mut o, view("andq %rsi,%rcx\n"));
    }
    if a.op == 5 {
        put(&mut o, view("orq %rsi,%rcx\n"));
    }
    if a.op == 6 {
        put(&mut o, view("xorq %rsi,%rcx\n"));
    }
    if (a.op == 7) || (a.op == 8) {
        // Keep the old value unless the operand wins.
        put(&mut o, view("cmpq %rsi,%rcx\n"));
        if a.signed != 0 {
            if a.op == 7 {
                put(&mut o, view("cmovgq %rsi,%rcx\n"));
            } else {
                put(&mut o, view("cmovlq %rsi,%rcx\n"));
            }
        } else {
            if a.op == 7 {
                put(&mut o, view("cmovaq %rsi,%rcx\n"));
            } else {
                put(&mut o, view("cmovbq %rsi,%rcx\n"));
            }
        }
    }
    if ((a.op == 2) || (a.op == 3)) & (a.bits != 64) {
        if a.signed != 0 {
            if a.bits == 8 {
                put(&mut o, view("movsbq %cl,%rcx\n"));
            }
            if a.bits == 16 {
                put(&mut o, view("movswq %cx,%rcx\n"));
            }
            if a.bits == 32 {
                put(&mut o, view("movslq %ecx,%rcx\n"));
            }
        } else {
            if a.bits == 8 {
                put(&mut o, view("movzbl %cl,%ecx\n"));
            }
            if a.bits == 16 {
                put(&mut o, view("movzwl %cx,%ecx\n"));
            }
            if a.bits == 32 {
                put(&mut o, view("movl %ecx,%ecx\n"));
            }
        }
    }
    put(&mut o, view("lock cmpxchgq %rcx,(%rdi)\njne "));
    atom_x86_label(&mut o, n);
    put(&mut o, view("\n"));
    return ();
}
// ---- SIMD: the `simd.*` stream ops (docs/design/simd.md) ----------------------------------------
// native.grl writes one line per operation on a SIMD value, with fixed registers: the address of
// the destination vector in %rdi, of the first operand in %rsi, of the second in %rdx, of a
// select's false operand in %rcx; a scalar going in or coming out is in %rax. native.grl loads all
// four address registers before every line (a zero for an unused one), so the expansion may use
// %rax, %rcx (once its operand is read) and %xmm0/%xmm1 as scratch, as atom.* lines do.
//   simd.OP SHAPE [K]
// SHAPE is the operands' shape: f32x4 f32x8 f64x2 f64x4 i32x4 i32x8 m32x4 m32x8 m64x2 m64x4. A
// compare writes the mask of the same lane width. OP is add sub mul div and or xor min max eq ne lt
// le gt ge select not splat lane sum copy any all insert topair frompair; K is a lane index (lane,
// insert: the scalar in %rax becomes lane K of the vector at %rdi, the other lanes kept). topair and
// frompair move a 16-byte vector between memory and the %rax:%rdx pair a two-word result travels in
// (topair reads %rsi, frompair writes %rdi from %rax and %rdx).
// The lowering here is the S1 one on every native target: one scalar lane at a time with the
// instructions scalar code already uses - the x86-64 subset the internal assembler encodes, and
// the AArch64 and RV64 forms machine.grl writes for scalars - so a lane computes exactly what the
// scalar operation computes. LLVM lifts the line to vector IR (llvm.grl `lift_simd`).
pub struct Simd {
    // The op's index in simd_ops() plus 1; 0 when the line is not a SIMD op.
    op: u64,
    // 1 float, 2 signed integer, 3 mask, 4 unsigned integer.
    elem: u64,
    bits: u64,
    lanes: u64,
    k: u64,
    // A shuffle's lane indices into the concatenation of its two operands.
    idx: u64[]
}
fn simd_ops() -> u8[][] {
    return u8[][
        copy_text(view("add")), copy_text(view("sub")), copy_text(view("mul")), copy_text(view("div")),
        copy_text(view("and")), copy_text(view("or")), copy_text(view("xor")), copy_text(view("min")),
        copy_text(view("max")), copy_text(view("eq")), copy_text(view("ne")), copy_text(view("lt")),
        copy_text(view("le")), copy_text(view("gt")), copy_text(view("ge")), copy_text(view("select")),
        copy_text(view("not")), copy_text(view("splat")), copy_text(view("lane")), copy_text(view("sum")),
        copy_text(view("copy")), copy_text(view("any")), copy_text(view("all")), copy_text(view("insert")),
        copy_text(view("topair")), copy_text(view("frompair")), copy_text(view("shuffle")),
        copy_text(view("tof32")), copy_text(view("toi32")), copy_text(view("copya")), copy_text(view("copyd"))
    ];
}
fn simd_number<a>(s: &a [u8]) -> u64 {
    mut n = 0;
    for i in s.len() {
        if (s[i] < 48) || (57 < s[i]) {
            return 0;
        }
        n = n * 10 + s[i] - 48;
    }
    return n;
}
pub fn simd_parse<a>(line: &a [u8]) -> Simd {
    mut s = Simd { op: 0, elem: 0, bits: 0, lanes: 0, k: 0, idx: u64[] };
    if !starts(view(line), view("simd.")) {
        return s;
    }
    words := split(view(line), 32);
    if (words.len() < 2) || (3 < words.len()) {
        bad(view(line));
    }
    name := words[0][5:].copy();
    ops := simd_ops();
    for i in ops.len() {
        if eq(view(name), view(ops[i])) {
            s.op = i + 1;
        }
    }
    shape := words[1].copy();
    mut x = 0;
    for i in shape.len() {
        if shape[i] == 120 {
            x = i;
        }
    }
    if (s.op == 0) || (x < 2) {
        bad(view(line));
    }
    if shape[0] == 102 {
        s.elem = 1;
    }
    if shape[0] == 105 {
        s.elem = 2;
    }
    if shape[0] == 109 {
        s.elem = 3;
    }
    if shape[0] == 117 {
        s.elem = 4;
    }
    s.bits = simd_number(view(shape[1: x]));
    s.lanes = simd_number(view(shape[x + 1:]));
    if (s.elem == 0) || ((s.bits != 8) & (s.bits != 32) & (s.bits != 64)) || ((s.bits * s.lanes != 128) & (s.bits * s.lanes != 256)) {
        bad(view(line));
    }
    if words.len() == 3 {
        s.k = simd_number(view(words[2]));
        if s.op == 27 {
            parts := split(view(words[2]), 44);
            for i in parts.len() {
                s.idx.push(simd_number(view(parts[i])));
            }
            if s.idx.len() != s.lanes {
                bad(view(line));
            }
        }
    }
    return s;
}
fn simd_x86<a>(o: (&a Out)) -> bool {
    return (o.target != 1) & (o.target != 2);
}
// General scratch register `g` (0 or 1), 64-bit name.
fn simd_g<a>(o: (&a Out), g: u64) -> string {
    if o.target == 1 {
        if g == 0 {
            return "x9";
        }
        return "x10";
    }
    if o.target == 2 {
        if g == 0 {
            return "t0";
        }
        return "t1";
    }
    if g == 0 {
        return "%rax";
    }
    return "%rcx";
}
fn simd_g32<a>(o: (&a Out), g: u64) -> string {
    if o.target == 1 {
        if g == 0 {
            return "w9";
        }
        return "w10";
    }
    if o.target == 2 {
        return simd_g(&o, g);
    }
    if g == 0 {
        return "%eax";
    }
    return "%ecx";
}
// Address register `b`: 0 the destination, 1 the first operand, 2 the second, 3 the third.
fn simd_b<a>(o: (&a Out), b: u64) -> string {
    if o.target == 1 {
        if b == 0 {
            return "x0";
        }
        if b == 1 {
            return "x1";
        }
        if b == 2 {
            return "x2";
        }
        return "x3";
    }
    if o.target == 2 {
        if b == 0 {
            return "a0";
        }
        if b == 1 {
            return "a1";
        }
        if b == 2 {
            return "a2";
        }
        return "a3";
    }
    if b == 0 {
        return "%rdi";
    }
    if b == 1 {
        return "%rsi";
    }
    if b == 2 {
        return "%rdx";
    }
    return "%rcx";
}
// Float scratch register `f` (0 or 1) at `bits`.
fn simd_f<a>(o: (&a Out), f: u64, bits: u64) -> string {
    if o.target == 1 {
        if bits == 32 {
            if f == 0 {
                return "s0";
            }
            return "s1";
        }
        if f == 0 {
            return "d0";
        }
        return "d1";
    }
    if o.target == 2 {
        if f == 0 {
            return "ft0";
        }
        return "ft1";
    }
    if f == 0 {
        return "%xmm0";
    }
    return "%xmm1";
}
// `OFF(BASE)` / `[BASE,#OFF]`.
fn simd_mem<a>(o: (&a mut Out), b: u64, off: u64) -> unit {
    if o.target == 1 {
        put(&mut o, view("[")); 
        put(&mut o, view(simd_b(&o, b)));
        put(&mut o, view(",#"));
        u64(&mut o, off);
        put(&mut o, view("]"));
        return ();
    }
    u64(&mut o, off);
    put(&mut o, view("("));
    put(&mut o, view(simd_b(&o, b)));
    put(&mut o, view(")"));
    return ();
}
fn simd_line<a, b, d>(o: (&a mut Out), op: &b [u8], first: &d [u8]) -> unit {
    put(&mut o, op);
    put(&mut o, view(" "));
    put(&mut o, first);
    return ();
}
// G[g] = the `bits`-bit integer at OFF(B[b]), sign-extended.
fn simd_ldi<a>(o: (&a mut Out), g: u64, b: u64, off: u64, bits: u64) -> unit {
    simd_ldx(&mut o, g, b, off, bits, false);
    return ();
}
// G[g] = the `bits`-bit integer at OFF(B[b]), zero-extended when `uns`, sign-extended otherwise.
fn simd_ldx<a>(o: (&a mut Out), g: u64, b: u64, off: u64, bits: u64, uns: bool) -> unit {
    if (bits == 8) || ((bits == 32) & uns) {
        if o.target == 1 {
            if bits == 8 {
                simd_line(&mut o, view("ldrb"), view(simd_g32(&o, g)));
            } else {
                simd_line(&mut o, view("ldr"), view(simd_g32(&o, g)));
            }
            put(&mut o, view(","));
            simd_mem(&mut o, b, off);
            put(&mut o, view("\n"));
            if !uns {
                r := simd_g(&o, g);
                put(&mut o, view("lsl "));
                put(&mut o, view(r));
                put(&mut o, view(","));
                put(&mut o, view(r));
                put(&mut o, view(",#56\nasr "));
                put(&mut o, view(r));
                put(&mut o, view(","));
                put(&mut o, view(r));
                put(&mut o, view(",#56\n"));
            }
            return ();
        }
        if o.target == 2 {
            if bits == 8 {
                if uns {
                    simd_line(&mut o, view("lbu"), view(simd_g(&o, g)));
                } else {
                    simd_line(&mut o, view("lb"), view(simd_g(&o, g)));
                }
            } else {
                simd_line(&mut o, view("lwu"), view(simd_g(&o, g)));
            }
            put(&mut o, view(","));
            simd_mem(&mut o, b, off);
            put(&mut o, view("\n"));
            return ();
        }
        if bits == 8 {
            if uns {
                put(&mut o, view("movzbq "));
            } else {
                put(&mut o, view("movsbq "));
            }
            simd_mem(&mut o, b, off);
            put(&mut o, view(","));
            put(&mut o, view(simd_g(&o, g)));
        } else {
            put(&mut o, view("movl "));
            simd_mem(&mut o, b, off);
            put(&mut o, view(","));
            put(&mut o, view(simd_g32(&o, g)));
        }
        put(&mut o, view("\n"));
        return ();
    }
    if o.target == 1 {
        if bits == 32 {
            simd_line(&mut o, view("ldr"), view(simd_g32(&o, g)));
            put(&mut o, view(","));
            simd_mem(&mut o, b, off);
            r := simd_g(&o, g);
            put(&mut o, view("\nlsl "));
            put(&mut o, view(r));
            put(&mut o, view(","));
            put(&mut o, view(r));
            put(&mut o, view(",#32\nasr "));
            put(&mut o, view(r));
            put(&mut o, view(","));
            put(&mut o, view(r));
            put(&mut o, view(",#32\n"));
            return ();
        }
        simd_line(&mut o, view("ldr"), view(simd_g(&o, g)));
        put(&mut o, view(","));
        simd_mem(&mut o, b, off);
        put(&mut o, view("\n"));
        return ();
    }
    if o.target == 2 {
        if bits == 32 {
            simd_line(&mut o, view("lw"), view(simd_g(&o, g)));
        } else {
            simd_line(&mut o, view("ld"), view(simd_g(&o, g)));
        }
        put(&mut o, view(","));
        simd_mem(&mut o, b, off);
        put(&mut o, view("\n"));
        return ();
    }
    if bits == 32 {
        put(&mut o, view("movslq "));
    } else {
        put(&mut o, view("movq "));
    }
    simd_mem(&mut o, b, off);
    put(&mut o, view(","));
    put(&mut o, view(simd_g(&o, g)));
    put(&mut o, view("\n"));
    return ();
}
// The low `bits` of G[g] stored at OFF(destination).
fn simd_sti<a>(o: (&a mut Out), g: u64, off: u64, bits: u64) -> unit {
    if bits == 8 {
        if o.target == 1 {
            simd_line(&mut o, view("strb"), view(simd_g32(&o, g)));
            put(&mut o, view(","));
        } else if o.target == 2 {
            simd_line(&mut o, view("sb"), view(simd_g(&o, g)));
            put(&mut o, view(","));
        } else {
            if g == 0 {
                put(&mut o, view("movb %al,"));
            } else {
                put(&mut o, view("movb %cl,"));
            }
        }
        simd_mem(&mut o, 0, off);
        put(&mut o, view("\n"));
        return ();
    }
    if o.target == 1 {
        if bits == 32 {
            simd_line(&mut o, view("str"), view(simd_g32(&o, g)));
        } else {
            simd_line(&mut o, view("str"), view(simd_g(&o, g)));
        }
        put(&mut o, view(","));
        simd_mem(&mut o, 0, off);
        put(&mut o, view("\n"));
        return ();
    }
    if o.target == 2 {
        if bits == 32 {
            simd_line(&mut o, view("sw"), view(simd_g(&o, g)));
        } else {
            simd_line(&mut o, view("sd"), view(simd_g(&o, g)));
        }
        put(&mut o, view(","));
        simd_mem(&mut o, 0, off);
        put(&mut o, view("\n"));
        return ();
    }
    if bits == 32 {
        simd_line(&mut o, view("movl"), view(simd_g32(&o, g)));
    } else {
        simd_line(&mut o, view("movq"), view(simd_g(&o, g)));
    }
    put(&mut o, view(","));
    simd_mem(&mut o, 0, off);
    put(&mut o, view("\n"));
    return ();
}
// F[f] = the float at OFF(B[b]). On x86-64 through %rax (the internal assembler has no SSE load).
fn simd_ldf<a>(o: (&a mut Out), f: u64, b: u64, off: u64, bits: u64) -> unit {
    if o.target == 1 {
        simd_line(&mut o, view("ldr"), view(simd_f(&o, f, bits)));
        put(&mut o, view(","));
        simd_mem(&mut o, b, off);
        put(&mut o, view("\n"));
        return ();
    }
    if o.target == 2 {
        if bits == 32 {
            simd_line(&mut o, view("flw"), view(simd_f(&o, f, bits)));
        } else {
            simd_line(&mut o, view("fld"), view(simd_f(&o, f, bits)));
        }
        put(&mut o, view(","));
        simd_mem(&mut o, b, off);
        put(&mut o, view("\n"));
        return ();
    }
    if bits == 32 {
        put(&mut o, view("movl "));
        simd_mem(&mut o, b, off);
        put(&mut o, view(",%eax\nmovd %eax,"));
    } else {
        put(&mut o, view("movq "));
        simd_mem(&mut o, b, off);
        put(&mut o, view(",%rax\nmovq %rax,"));
    }
    put(&mut o, view(simd_f(&o, f, bits)));
    put(&mut o, view("\n"));
    return ();
}
fn simd_stf<a>(o: (&a mut Out), f: u64, off: u64, bits: u64) -> unit {
    if o.target == 1 {
        simd_line(&mut o, view("str"), view(simd_f(&o, f, bits)));
        put(&mut o, view(","));
        simd_mem(&mut o, 0, off);
        put(&mut o, view("\n"));
        return ();
    }
    if o.target == 2 {
        if bits == 32 {
            simd_line(&mut o, view("fsw"), view(simd_f(&o, f, bits)));
        } else {
            simd_line(&mut o, view("fsd"), view(simd_f(&o, f, bits)));
        }
        put(&mut o, view(","));
        simd_mem(&mut o, 0, off);
        put(&mut o, view("\n"));
        return ();
    }
    if bits == 32 {
        simd_line(&mut o, view("movd"), view(simd_f(&o, f, bits)));
        put(&mut o, view(",%eax\nmovl %eax,"));
    } else {
        simd_line(&mut o, view("movq"), view(simd_f(&o, f, bits)));
        put(&mut o, view(",%rax\nmovq %rax,"));
    }
    simd_mem(&mut o, 0, off);
    put(&mut o, view("\n"));
    return ();
}
// F0 = F0 op F1 for op 1..4 (add sub mul div).
fn simd_fbin<a>(o: (&a mut Out), op: u64, bits: u64) -> unit {
    mut name = "add";
    if op == 2 {
        name = "sub";
    }
    if op == 3 {
        name = "mul";
    }
    if op == 4 {
        name = "div";
    }
    if o.target == 1 {
        put(&mut o, view("f"));
        put(&mut o, view(name));
        put(&mut o, view(" "));
        put(&mut o, view(simd_f(&o, 0, bits)));
        put(&mut o, view(","));
        put(&mut o, view(simd_f(&o, 0, bits)));
        put(&mut o, view(","));
        put(&mut o, view(simd_f(&o, 1, bits)));
        put(&mut o, view("\n"));
        return ();
    }
    if o.target == 2 {
        put(&mut o, view("f"));
        put(&mut o, view(name));
        if bits == 32 {
            put(&mut o, view(".s ft0,ft0,ft1\n"));
        } else {
            put(&mut o, view(".d ft0,ft0,ft1\n"));
        }
        return ();
    }
    put(&mut o, view(name));
    if bits == 32 {
        put(&mut o, view("ss %xmm1,%xmm0\n"));
    } else {
        put(&mut o, view("sd %xmm1,%xmm0\n"));
    }
    return ();
}
// G0 = G0 op G1 for op 1 add, 2 sub, 3 mul, 5 and, 6 or, 7 xor (64-bit; a 32-bit lane keeps the low half).
fn simd_ibin<a>(o: (&a mut Out), op: u64) -> unit {
    if o.target == 1 {
        mut name = "add";
        if op == 2 {
            name = "sub";
        }
        if op == 3 {
            name = "mul";
        }
        if op == 5 {
            name = "and";
        }
        if op == 6 {
            name = "orr";
        }
        if op == 7 {
            name = "eor";
        }
        put(&mut o, view(name));
        put(&mut o, view(" x9,x9,x10\n"));
        return ();
    }
    if o.target == 2 {
        mut name = "add";
        if op == 2 {
            name = "sub";
        }
        if op == 3 {
            name = "mul";
        }
        if op == 5 {
            name = "and";
        }
        if op == 6 {
            name = "or";
        }
        if op == 7 {
            name = "xor";
        }
        put(&mut o, view(name));
        put(&mut o, view(" t0,t0,t1\n"));
        return ();
    }
    mut name = "addq";
    if op == 2 {
        name = "subq";
    }
    if op == 3 {
        name = "imulq";
    }
    if op == 5 {
        name = "andq";
    }
    if op == 6 {
        name = "orq";
    }
    if op == 7 {
        name = "xorq";
    }
    put(&mut o, view(name));
    put(&mut o, view(" %rcx,%rax\n"));
    return ();
}
// G0 = 1 when F0 cc F1 holds, else 0; cc 10 eq, 11 ne, 12 lt, 13 le, 14 gt, 15 ge. Ordered except ne,
// as the scalar comparisons are: a NaN lane is unequal and neither less nor greater.
fn simd_fcmp<a>(o: (&a mut Out), cc: u64, bits: u64) -> unit {
    if o.target == 1 {
        put(&mut o, view("fcmp "));
        put(&mut o, view(simd_f(&o, 0, bits)));
        put(&mut o, view(","));
        put(&mut o, view(simd_f(&o, 1, bits)));
        put(&mut o, view("\ncset x9,"));
        if cc == 10 {
            put(&mut o, view("eq\n"));
        }
        if cc == 11 {
            put(&mut o, view("ne\n"));
        }
        if cc == 12 {
            put(&mut o, view("mi\n"));
        }
        if cc == 13 {
            put(&mut o, view("ls\n"));
        }
        if cc == 14 {
            put(&mut o, view("gt\n"));
        }
        if cc == 15 {
            put(&mut o, view("ge\n"));
        }
        return ();
    }
    if o.target == 2 {
        mut sfx = ".d";
        if bits == 32 {
            sfx = ".s";
        }
        if (cc == 10) || (cc == 11) {
            put(&mut o, view("feq"));
        }
        if (cc == 12) || (cc == 14) {
            put(&mut o, view("flt"));
        }
        if (cc == 13) || (cc == 15) {
            put(&mut o, view("fle"));
        }
        put(&mut o, view(sfx));
        if cc < 14 {
            put(&mut o, view(" t0,ft0,ft1\n"));
        } else {
            put(&mut o, view(" t0,ft1,ft0\n"));
        }
        if cc == 11 {
            put(&mut o, view("xori t0,t0,1\n"));
        }
        return ();
    }
    mut u = "ucomisd ";
    if bits == 32 {
        u = "ucomiss ";
    }
    put(&mut o, view(u));
    if (cc == 12) || (cc == 13) {
        put(&mut o, view("%xmm0,%xmm1\n"));
    } else {
        put(&mut o, view("%xmm1,%xmm0\n"));
    }
    if (cc == 10) || (cc == 11) {
        put(&mut o, view("sete %al\nsetnp %cl\nandb %cl,%al\nmovzbq %al,%rax\n"));
        if cc == 11 {
            put(&mut o, view("xorq $1,%rax\n"));
        }
        return ();
    }
    if (cc == 12) || (cc == 14) {
        put(&mut o, view("seta %al\nmovzbq %al,%rax\n"));
    } else {
        put(&mut o, view("setae %al\nmovzbq %al,%rax\n"));
    }
    return ();
}
// G0 = 1 when G0 cc G1 holds (signed), else 0.
fn simd_icmp<a>(o: (&a mut Out), cc: u64, uns: bool) -> unit {
    if uns & (12 <= cc) {
        // Unsigned order: below / below-or-same / above / above-or-same.
        if o.target == 1 {
            put(&mut o, view("cmp x9,x10\ncset x9,"));
            if cc == 12 {
                put(&mut o, view("lo\n"));
            }
            if cc == 13 {
                put(&mut o, view("ls\n"));
            }
            if cc == 14 {
                put(&mut o, view("hi\n"));
            }
            if cc == 15 {
                put(&mut o, view("hs\n"));
            }
            return ();
        }
        if o.target == 2 {
            if cc == 12 {
                put(&mut o, view("sltu t0,t0,t1\n"));
            }
            if cc == 13 {
                put(&mut o, view("sltu t0,t1,t0\nxori t0,t0,1\n"));
            }
            if cc == 14 {
                put(&mut o, view("sltu t0,t1,t0\n"));
            }
            if cc == 15 {
                put(&mut o, view("sltu t0,t0,t1\nxori t0,t0,1\n"));
            }
            return ();
        }
        put(&mut o, view("cmpq %rcx,%rax\nset"));
        if cc == 12 {
            put(&mut o, view("b"));
        }
        if cc == 13 {
            put(&mut o, view("be"));
        }
        if cc == 14 {
            put(&mut o, view("a"));
        }
        if cc == 15 {
            put(&mut o, view("ae"));
        }
        put(&mut o, view(" %al\nmovzbq %al,%rax\n"));
        return ();
    }
    if o.target == 1 {
        put(&mut o, view("cmp x9,x10\ncset x9,"));
        if cc == 10 {
            put(&mut o, view("eq\n"));
        }
        if cc == 11 {
            put(&mut o, view("ne\n"));
        }
        if cc == 12 {
            put(&mut o, view("lt\n"));
        }
        if cc == 13 {
            put(&mut o, view("le\n"));
        }
        if cc == 14 {
            put(&mut o, view("gt\n"));
        }
        if cc == 15 {
            put(&mut o, view("ge\n"));
        }
        return ();
    }
    if o.target == 2 {
        if cc == 10 {
            put(&mut o, view("sub t0,t0,t1\nseqz t0,t0\n"));
        }
        if cc == 11 {
            put(&mut o, view("sub t0,t0,t1\nsnez t0,t0\n"));
        }
        if cc == 12 {
            put(&mut o, view("slt t0,t0,t1\n"));
        }
        if cc == 13 {
            put(&mut o, view("slt t0,t1,t0\nxori t0,t0,1\n"));
        }
        if cc == 14 {
            put(&mut o, view("slt t0,t1,t0\n"));
        }
        if cc == 15 {
            put(&mut o, view("slt t0,t0,t1\nxori t0,t0,1\n"));
        }
        return ();
    }
    put(&mut o, view("cmpq %rcx,%rax\nset"));
    if cc == 10 {
        put(&mut o, view("e"));
    }
    if cc == 11 {
        put(&mut o, view("ne"));
    }
    if cc == 12 {
        put(&mut o, view("l"));
    }
    if cc == 13 {
        put(&mut o, view("le"));
    }
    if cc == 14 {
        put(&mut o, view("g"));
    }
    if cc == 15 {
        put(&mut o, view("ge"));
    }
    put(&mut o, view(" %al\nmovzbq %al,%rax\n"));
    return ();
}
// G0 = -G0 (a 0/1 truth to a 0/-1 lane) and G0 = ~G0.
fn simd_neg<a>(o: (&a mut Out)) -> unit {
    if o.target == 1 {
        put(&mut o, view("sub x9,xzr,x9\n"));
    } else if o.target == 2 {
        put(&mut o, view("neg t0,t0\n"));
    } else {
        put(&mut o, view("negq %rax\n"));
    }
    return ();
}
fn simd_not<a>(o: (&a mut Out)) -> unit {
    if o.target == 1 {
        put(&mut o, view("sub x9,xzr,x9\nsub x9,x9,#1\n"));
    } else if o.target == 2 {
        put(&mut o, view("not t0,t0\n"));
    } else {
        put(&mut o, view("notq %rax\n"));
    }
    return ();
}
// Labels: `.Latom` on x86-64, where the internal assembler gives each line's labels a prefix of
// their own (asm_x86 `atom_line`), the target's label otherwise.
fn simd_label<a>(o: (&a mut Out), n: u64) -> unit {
    if simd_x86(&o) {
        put(&mut o, view(".Latom"));
        u64(&mut o, n);
        return ();
    }
    label(&mut o, n);
    return ();
}
fn simd_mark<a>(o: (&a mut Out), n: u64) -> unit {
    simd_label(&mut o, n);
    put(&mut o, view(":\n"));
    return ();
}
fn simd_jmp<a>(o: (&a mut Out), n: u64) -> unit {
    if o.target == 1 {
        put(&mut o, view("b "));
    } else if o.target == 2 {
        put(&mut o, view("j "));
    } else {
        put(&mut o, view("jmp "));
    }
    simd_label(&mut o, n);
    put(&mut o, view("\n"));
    return ();
}
// To `n` when G0 is zero.
fn simd_jz<a>(o: (&a mut Out), n: u64) -> unit {
    if o.target == 1 {
        put(&mut o, view("cbz x9,"));
    } else if o.target == 2 {
        put(&mut o, view("beqz t0,"));
    } else {
        put(&mut o, view("testq %rax,%rax\nje "));
    }
    simd_label(&mut o, n);
    put(&mut o, view("\n"));
    return ();
}
// To `n` when F[f] is a NaN.
fn simd_jnan<a>(o: (&a mut Out), f: u64, bits: u64, n: u64) -> unit {
    r := simd_f(&o, f, bits);
    if o.target == 1 {
        put(&mut o, view("fcmp "));
        put(&mut o, view(r));
        put(&mut o, view(","));
        put(&mut o, view(r));
        put(&mut o, view("\nb.vs "));
    } else if o.target == 2 {
        if bits == 32 {
            put(&mut o, view("feq.s t0,"));
        } else {
            put(&mut o, view("feq.d t0,"));
        }
        put(&mut o, view(r));
        put(&mut o, view(","));
        put(&mut o, view(r));
        put(&mut o, view("\nbeqz t0,"));
    } else {
        if bits == 32 {
            put(&mut o, view("ucomiss "));
        } else {
            put(&mut o, view("ucomisd "));
        }
        put(&mut o, view(r));
        put(&mut o, view(","));
        put(&mut o, view(r));
        put(&mut o, view("\njp "));
    }
    simd_label(&mut o, n);
    put(&mut o, view("\n"));
    return ();
}
// To `n` when F[x] < F[y] (neither is a NaN here).
fn simd_jflt<a>(o: (&a mut Out), x: u64, y: u64, bits: u64, n: u64) -> unit {
    rx := simd_f(&o, x, bits);
    ry := simd_f(&o, y, bits);
    if o.target == 1 {
        put(&mut o, view("fcmp "));
        put(&mut o, view(rx));
        put(&mut o, view(","));
        put(&mut o, view(ry));
        put(&mut o, view("\nb.mi "));
    } else if o.target == 2 {
        if bits == 32 {
            put(&mut o, view("flt.s t0,"));
        } else {
            put(&mut o, view("flt.d t0,"));
        }
        put(&mut o, view(rx));
        put(&mut o, view(","));
        put(&mut o, view(ry));
        put(&mut o, view("\nbnez t0,"));
    } else {
        if bits == 32 {
            put(&mut o, view("ucomiss "));
        } else {
            put(&mut o, view("ucomisd "));
        }
        put(&mut o, view(ry));
        put(&mut o, view(","));
        put(&mut o, view(rx));
        put(&mut o, view("\njb "));
    }
    simd_label(&mut o, n);
    put(&mut o, view("\n"));
    return ();
}
// To `n` when G[x] < G[y], signed.
fn simd_jilt<a>(o: (&a mut Out), x: u64, y: u64, n: u64, uns: bool) -> unit {
    gx := simd_g(&o, x);
    gy := simd_g(&o, y);
    if o.target == 1 {
        put(&mut o, view("cmp "));
        put(&mut o, view(gx));
        put(&mut o, view(","));
        put(&mut o, view(gy));
        if uns {
            put(&mut o, view("\nb.lo "));
        } else {
            put(&mut o, view("\nb.lt "));
        }
    } else if o.target == 2 {
        if uns {
            put(&mut o, view("bltu "));
        } else {
            put(&mut o, view("blt "));
        }
        put(&mut o, view(gx));
        put(&mut o, view(","));
        put(&mut o, view(gy));
        put(&mut o, view(","));
    } else {
        put(&mut o, view("cmpq "));
        put(&mut o, view(gy));
        put(&mut o, view(","));
        put(&mut o, view(gx));
        if uns {
            put(&mut o, view("\njb "));
        } else {
            put(&mut o, view("\njl "));
        }
    }
    simd_label(&mut o, n);
    put(&mut o, view("\n"));
    return ();
}
// F0 (an f32) widened to binary64 and its bits in G0, as every f32 word holds it.
fn simd_widen<a>(o: (&a mut Out)) -> unit {
    if o.target == 1 {
        put(&mut o, view("fcvt d0,s0\nfmov x9,d0\n"));
    } else if o.target == 2 {
        put(&mut o, view("fcvt.d.s ft0,ft0\nfmv.x.d t0,ft0\n"));
    } else {
        put(&mut o, view("cvtss2sd %xmm0,%xmm0\nmovq %xmm0,%rax\n"));
    }
    return ();
}
// F[f] = the binary64 whose top 16 bits are `top` and the rest zero (the bounds toi32 compares with).
fn simd_fconst<a, b>(o: (&a mut Out), f: u64, top: &b [u8]) -> unit {
    if o.target == 1 {
        put(&mut o, view("movz x9,#"));
        put(&mut o, top);
        put(&mut o, view(",lsl #48\nfmov "));
        put(&mut o, view(simd_f(&o, f, 64)));
        put(&mut o, view(",x9\n"));
    } else if o.target == 2 {
        put(&mut o, view("li t0,"));
        put(&mut o, top);
        put(&mut o, view("000000000000\nfmv.d.x "));
        put(&mut o, view(simd_f(&o, f, 64)));
        put(&mut o, view(",t0\n"));
    } else {
        put(&mut o, view("movabsq $"));
        put(&mut o, top);
        put(&mut o, view("000000000000,%rax\nmovq %rax,"));
        put(&mut o, view(simd_f(&o, f, 64)));
        put(&mut o, view("\n"));
    }
    return ();
}
// G0 = `v`, a 32-bit lane value (only the low 32 bits are stored).
fn simd_iconst<a>(o: (&a mut Out), v: u64) -> unit {
    if o.target == 1 {
        put(&mut o, view("movz x9,#"));
        u64(&mut o, v / 65536);
        put(&mut o, view(",lsl #16\nmovk x9,#"));
        u64(&mut o, v % 65536);
        put(&mut o, view("\n"));
    } else if o.target == 2 {
        put(&mut o, view("li t0,"));
        u64(&mut o, v);
        put(&mut o, view("\n"));
    } else {
        put(&mut o, view("movl $"));
        u64(&mut o, v);
        put(&mut o, view(",%eax\n"));
    }
    return ();
}
pub fn simd_expand<a>(o: (&a mut Out), s: (&Simd)) -> unit {
    eb := s.bits / 8;
    n := s.lanes;
    op := s.op;
    float := s.elem == 1;
    bits := s.bits;
    uns := s.elem == 4;
    if (op <= 7) && !((op == 4) & !float) {
        for i in n {
            off := i * eb;
            if float & (op <= 4) {
                simd_ldf(&mut o, 0, 1, off, bits);
                simd_ldf(&mut o, 1, 2, off, bits);
                simd_fbin(&mut o, op, bits);
                simd_stf(&mut o, 0, off, bits);
            } else {
                simd_ldx(&mut o, 0, 1, off, bits, uns);
                simd_ldx(&mut o, 1, 2, off, bits, uns);
                simd_ibin(&mut o, op);
                simd_sti(&mut o, 0, off, bits);
            }
        }
        return ();
    }
    if (op == 8) || (op == 9) {
        // min/max as the scalar rule has it: a NaN operand gives the other one, and the first
        // operand wins a tie (so min(+0.0, -0.0) is +0.0).
        for i in n {
            off := i * eb;
            take_a := fresh(&mut o);
            take_b := fresh(&mut o);
            done := fresh(&mut o);
            if float {
                simd_ldf(&mut o, 0, 1, off, bits);
                simd_ldf(&mut o, 1, 2, off, bits);
                simd_jnan(&mut o, 0, bits, take_b);
                simd_jnan(&mut o, 1, bits, take_a);
                if op == 8 {
                    simd_jflt(&mut o, 1, 0, bits, take_b);
                } else {
                    simd_jflt(&mut o, 0, 1, bits, take_b);
                }
                simd_mark(&mut o, take_a);
                simd_stf(&mut o, 0, off, bits);
                simd_jmp(&mut o, done);
                simd_mark(&mut o, take_b);
                simd_stf(&mut o, 1, off, bits);
            } else {
                simd_ldx(&mut o, 0, 1, off, bits, uns);
                simd_ldx(&mut o, 1, 2, off, bits, uns);
                if op == 8 {
                    simd_jilt(&mut o, 1, 0, take_b, uns);
                } else {
                    simd_jilt(&mut o, 0, 1, take_b, uns);
                }
                simd_mark(&mut o, take_a);
                simd_sti(&mut o, 0, off, bits);
                simd_jmp(&mut o, done);
                simd_mark(&mut o, take_b);
                simd_sti(&mut o, 1, off, bits);
            }
            simd_mark(&mut o, done);
        }
        return ();
    }
    if (10 <= op) && (op <= 15) {
        for i in n {
            off := i * eb;
            if float {
                simd_ldf(&mut o, 0, 1, off, bits);
                simd_ldf(&mut o, 1, 2, off, bits);
                simd_fcmp(&mut o, op, bits);
            } else {
                simd_ldx(&mut o, 0, 1, off, bits, uns);
                simd_ldx(&mut o, 1, 2, off, bits, uns);
                simd_icmp(&mut o, op, uns);
            }
            simd_neg(&mut o);
            simd_sti(&mut o, 0, off, bits);
        }
        return ();
    }
    if op == 16 {
        // select: the mask's lane is all ones or all zeros; the chosen lane's bits are copied.
        for i in n {
            off := i * eb;
            other := fresh(&mut o);
            done := fresh(&mut o);
            simd_ldx(&mut o, 0, 1, off, bits, uns);
            simd_jz(&mut o, other);
            simd_ldx(&mut o, 0, 2, off, bits, uns);
            simd_jmp(&mut o, done);
            simd_mark(&mut o, other);
            simd_ldx(&mut o, 0, 3, off, bits, uns);
            simd_mark(&mut o, done);
            simd_sti(&mut o, 0, off, bits);
        }
        return ();
    }
    if op == 17 {
        for i in n {
            simd_ldx(&mut o, 0, 1, i * eb, bits, uns);
            simd_not(&mut o);
            simd_sti(&mut o, 0, i * eb, bits);
        }
        return ();
    }
    if (op == 18) || (op == 24) {
        mut first = 0;
        mut count = n;
        if op == 24 {
            first = s.k;
            count = 1;
        }
        if float & (bits == 32) {
            // The scalar is an f32 word (binary64 holding an f32 value): narrowed exactly.
            if o.target == 1 {
                put(&mut o, view("fmov d0,x9\nfcvt s0,d0\n"));
            } else if o.target == 2 {
                put(&mut o, view("fmv.d.x ft0,t0\nfcvt.s.d ft0,ft0\n"));
            } else {
                put(&mut o, view("movq %rax,%xmm0\ncvtsd2ss %xmm0,%xmm0\n"));
            }
            if simd_x86(&o) {
                put(&mut o, view("movd %xmm0,%eax\n"));
                for i in count {
                    simd_sti(&mut o, 0, (first + i) * eb, bits);
                }
            } else {
                for i in count {
                    simd_stf(&mut o, 0, (first + i) * eb, bits);
                }
            }
            return ();
        }
        if s.elem == 3 {
            // A mask's lane from a bool: false 0, true all ones.
            simd_neg(&mut o);
        }
        for i in count {
            simd_sti(&mut o, 0, (first + i) * eb, bits);
        }
        return ();
    }
    if op == 19 {
        if float & (bits == 32) {
            simd_ldf(&mut o, 0, 1, s.k * eb, bits);
            simd_widen(&mut o);
        } else {
            simd_ldx(&mut o, 0, 1, s.k * eb, bits, uns);
        }
        return ();
    }
    if op == 20 {
        // sum: the halving tree, fixed so every target and backend adds in one order: lane i of
        // the first level is l[i] + l[i + n/2], and so on down to one lane. The levels are kept in
        // the destination, a scratch vector of the same shape.
        mut half = n / 2;
        mut from = 1;
        while 0 < half {
            for i in half {
                if float {
                    simd_ldf(&mut o, 0, from, i * eb, bits);
                    simd_ldf(&mut o, 1, from, (i + half) * eb, bits);
                    simd_fbin(&mut o, 1, bits);
                    simd_stf(&mut o, 0, i * eb, bits);
                } else {
                    simd_ldx(&mut o, 0, from, i * eb, bits, uns);
                    simd_ldx(&mut o, 1, from, (i + half) * eb, bits, uns);
                    simd_ibin(&mut o, 1);
                    simd_sti(&mut o, 0, i * eb, bits);
                }
            }
            from = 0;
            half = half / 2;
        }
        if float & (bits == 32) {
            simd_ldf(&mut o, 0, 0, 0, bits);
            simd_widen(&mut o);
        } else {
            simd_ldx(&mut o, 0, 0, 0, bits, uns);
        }
        return ();
    }
    if op == 21 {
        for i in n * eb / 8 {
            simd_ldx(&mut o, 0, 1, i * 8, 64, uns);
            simd_sti(&mut o, 0, i * 8, 64);
        }
        return ();
    }
    if (op == 22) || (op == 23) {
        simd_ldx(&mut o, 0, 1, 0, bits, uns);
        for i in n - 1 {
            simd_ldx(&mut o, 1, 1, (i + 1) * eb, bits, uns);
            if op == 22 {
                simd_ibin(&mut o, 6);
            } else {
                simd_ibin(&mut o, 5);
            }
        }
        if op == 22 {
            if o.target == 1 {
                put(&mut o, view("cmp x9,#0\ncset x9,ne\n"));
            } else if o.target == 2 {
                put(&mut o, view("snez t0,t0\n"));
            } else {
                put(&mut o, view("testq %rax,%rax\nsetne %al\nmovzbq %al,%rax\n"));
            }
        } else {
            if o.target == 1 {
                put(&mut o, view("cmn x9,#1\ncset x9,eq\n"));
            } else if o.target == 2 {
                put(&mut o, view("addi t0,t0,1\nseqz t0,t0\n"));
            } else {
                put(&mut o, view("cmpq $-1,%rax\nsete %al\nmovzbq %al,%rax\n"));
            }
        }
        return ();
    }
    if op == 25 {
        if o.target == 1 {
            put(&mut o, view("ldr x2,[x1,#8]\nldr x9,[x1,#0]\n"));
        } else if o.target == 2 {
            put(&mut o, view("ld a2,8(a1)\nld t0,0(a1)\n"));
        } else {
            put(&mut o, view("movq 8(%rsi),%rdx\nmovq 0(%rsi),%rax\n"));
        }
        return ();
    }
    if op == 26 {
        if o.target == 1 {
            put(&mut o, view("str x9,[x0,#0]\nstr x2,[x0,#8]\n"));
        } else if o.target == 2 {
            put(&mut o, view("sd t0,0(a0)\nsd a2,8(a0)\n"));
        } else {
            put(&mut o, view("movq %rax,0(%rdi)\nmovq %rdx,8(%rdi)\n"));
        }
        return ();
    }
    if op == 27 {
        // shuffle: output lane j is lane idx[j] of the concatenation of the two operands.
        for j in n {
            at := s.idx[j];
            mut from = 1;
            if n <= at {
                from = 2;
            }
            simd_ldx(&mut o, 0, from, (at % n) * eb, bits, true);
            simd_sti(&mut o, 0, j * eb, bits);
        }
        return ();
    }
    if op == 28 {
        // tof32: each i32 lane to the nearest f32.
        for i in n {
            simd_ldx(&mut o, 0, 1, i * 4, 32, false);
            if o.target == 1 {
                put(&mut o, view("scvtf s0,x9\n"));
                simd_stf(&mut o, 0, i * 4, 32);
            } else if o.target == 2 {
                put(&mut o, view("fcvt.s.l ft0,t0\n"));
                simd_stf(&mut o, 0, i * 4, 32);
            } else {
                put(&mut o, view("cvtsi2ssq %rax,%xmm0\n"));
                simd_stf(&mut o, 0, i * 4, 32);
            }
        }
        return ();
    }
    if op == 29 {
        // toi32: each f32 lane truncated toward zero, saturated to the i32 range; a NaN is 0.
        for i in n {
            off := i * 4;
            below := fresh(&mut o);
            low := fresh(&mut o);
            zero := fresh(&mut o);
            done := fresh(&mut o);
            simd_ldf(&mut o, 0, 1, off, 32);
            if o.target == 1 {
                put(&mut o, view("fcvt d0,s0\n"));
            } else if o.target == 2 {
                put(&mut o, view("fcvt.d.s ft0,ft0\n"));
            } else {
                put(&mut o, view("cvtss2sd %xmm0,%xmm0\n"));
            }
            simd_jnan(&mut o, 0, 64, zero);
            simd_fconst(&mut o, 1, view("0x41e0"));
            simd_jflt(&mut o, 0, 1, 64, below);
            simd_iconst(&mut o, 2147483647);
            simd_jmp(&mut o, done);
            simd_mark(&mut o, below);
            simd_fconst(&mut o, 1, view("0xc1e0"));
            simd_jflt(&mut o, 0, 1, 64, low);
            if o.target == 1 {
                put(&mut o, view("fcvtzs x9,d0\n"));
            } else if o.target == 2 {
                put(&mut o, view("fcvt.l.d t0,ft0,rtz\n"));
            } else {
                put(&mut o, view("cvttsd2si %xmm0,%rax\n"));
            }
            simd_jmp(&mut o, done);
            simd_mark(&mut o, low);
            simd_iconst(&mut o, 2147483648);
            simd_jmp(&mut o, done);
            simd_mark(&mut o, zero);
            simd_iconst(&mut o, 0);
            simd_mark(&mut o, done);
            simd_sti(&mut o, 0, off, 32);
        }
        return ();
    }
    if (op == 30) || (op == 31) {
        // copya / copyd: a copy whose source / destination address was checked to be aligned to
        // the vector's size; the alignment matters only to LLVM.
        for i in n * eb / 8 {
            simd_ldi(&mut o, 0, 1, i * 8, 64);
            simd_sti(&mut o, 0, i * 8, 64);
        }
        return ();
    }
    bad(view("simd op"));
    return ();
}
// AArch64 and RV64: a `simd.` line lowered in place (`instruction`).
fn simd_instruction<a, b>(o: (&a mut Out), line: &b [u8]) -> bool {
    s := simd_parse(view(line));
    if s.op == 0 {
        return false;
    }
    simd_expand(&mut o, &s);
    return true;
}

// ---- Windows ARM64 imports ----------------------------------------------------------------
// The internal argument registers map to x0..x7, which is exactly the Win64 ARM64 order, so an
// import only needs the IAT indirection, 64 bytes of home space and the result move into x9.
fn win_import<a, b>(o: (&a mut Out), name: &b [u8]) -> unit {
    put(&mut o, view("sub sp,sp,#64\nadrp x16,__imp_"));
    put(&mut o, view(name));
    put(&mut o, view("\nldr x16,[x16,:lo12:__imp_"));
    put(&mut o, view(name));
    put(&mut o, view("]\nblr x16\nadd sp,sp,#64\nmov x9,x0\n"));
    return ();
}
// Frame allocation for Windows ARM64: a plain subtraction of the `.set` frame value. Larger
// frames still fit because the value is materialized into x10 first.
fn budget<a, b>(o: (&a mut Out), symbol: &b [u8]) -> unit {
    put(&mut o, view("movz x10,#(("));
    put(&mut o, view(symbol));
    put(&mut o, view(")&65535)\nmovk x10,#((("));
    put(&mut o, view(symbol));
    put(&mut o, view(")>>16)&65535),lsl #16\nsub sp,sp,x10\n"));
    return ();
}
fn win_exit<a>(o: (&a mut Out)) -> unit {
    put(
        &mut o,
        view("sub sp,sp,#64\nadrp x16,__imp_ExitProcess\nldr x16,[x16,:lo12:__imp_ExitProcess]\nblr x16\nbrk #0\n")
    );
    return ();
}
// ---- C-ABI moves for direct extern calls (emitted by native.grl, AArch64 and RV64 only) ----
// Grail keeps every value in an integer word: an f64 as its bits, an f32 as the binary64 with the
// same value, a sized integer sign- or zero-extended. These pseudo-instructions move %rax (x9/t0)
// across that boundary: into the N-th float argument register, out of the float result register,
// re-extended after a narrow integer result, and into the outgoing stack argument area.
fn c_abi<a, b, c>(o: (&a mut Out), op: &b [u8], rest: &c [u8]) -> bool {
    arm := o.target == 1;
    if eq(view((op)), view("cfarg64")) {
        if arm {
            put(&mut o, view("fmov d"));
            put(&mut o, view(rest));
            put(&mut o, view(",x9\n"));
        } else {
            put(&mut o, view("fmv.d.x fa"));
            put(&mut o, view(rest));
            put(&mut o, view(",t0\n"));
        }
        return true;
    }
    // The raw word in x9/t0 as the bits of a float argument register, with no conversion: a
    // `byval` record's field or eightbyte is already in its C representation.
    if eq(view((op)), view("cfbits64")) {
        if arm {
            put(&mut o, view("fmov d"));
            put(&mut o, view(rest));
            put(&mut o, view(",x9\n"));
        } else {
            put(&mut o, view("fmv.d.x fa"));
            put(&mut o, view(rest));
            put(&mut o, view(",t0\n"));
        }
        return true;
    }
    if eq(view((op)), view("cfbits32")) {
        if arm {
            put(&mut o, view("fmov s"));
            put(&mut o, view(rest));
            put(&mut o, view(",w9\n"));
        } else {
            put(&mut o, view("fmv.w.x fa"));
            put(&mut o, view(rest));
            put(&mut o, view(",t0\n"));
        }
