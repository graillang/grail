module machine;
use host;

// Final lowering of the compiler's closed word-machine instruction stream.
// Target 0 retains x86-64 spelling; 1 is AArch64, 2 is RV64IMAFD (Linux ELF).
// This is static instruction selection in Grail, not execution or an external translator.
struct Out {
    text: u8[],
    target: u64,
    win: u64,
    next: u64
}
fn eq<a, b>(a: &a [u8], b: &b [u8]) -> u64 {
    if a.len() != b.len() {
        return false;
    }
    for i in a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}
fn starts<a, b>(a: &a [u8], b: &b [u8]) -> u64 {
    if a.len() < b.len() {
        return false;
    }
    return eq(view((a[: b.len()])), view((b)));
}
fn trim<a>(s: &a [u8]) -> &a [u8] {
    mut a = 0;
    mut b = s.len();
    while a < b {
        if (s[a] != 32) & (s[a] != 9) & (s[a] != 13) {
            break;
        }
        a += 1;
    }
    while a < b {
        if (s[b - 1] != 32) & (s[b - 1] != 9) & (s[b - 1] != 13) {
            break;
        }
        b -= 1;
    }
    return s[a: b];
}
fn bad<a>(s: &a [u8]) -> unit {
    host::print(view("machine lowering: unsupported instruction/operand: "));
    host::print(s);
    host::print(view("\n"));
    assert(false);
    return ();
}
fn put<a, b>(o: (&a mut Out), s: &b [u8]) -> unit {
    for i in s.len() {
        o.text.push(s[i]);
    }
    return ();
}
fn u64<a>(o: (&a mut Out), n: u64) -> unit {
    if 9 < n {
        u64(&mut o, n / 10);
    }
    o.text.push(48 + n % 10);
    return ();
}
fn fresh<a>(o: (&a mut Out)) -> u64 {
    n := o.next;
    exchange(&mut o.next, n + 1);
    return n;
}
fn label<a>(o: (&a mut Out), n: u64) -> unit {
    put(&mut o, view(".Lmachine"));
    u64(&mut o, n);
    return ();
}
fn mark<a>(o: (&a mut Out), n: u64) -> unit {
    label(&mut o, n);
    put(&mut o, view(":\n"));
    return ();
}
fn split<a>(s: &a [u8], delimiter: u64) -> u8[][] {
    mut out = u8[][];
    mut start = 0;
    mut depth = 0;
    for i in s.len() {
        b := s[i];
        if b == 40 {
            depth += 1;
        }
        if b == 41 {
            assert(depth != 0);
            depth -= 1;
        }
        if (b == delimiter) & (depth == 0) {
            out.push((trim(view((s[start: i])))).copy());
            start = i + 1;
        }
    }
    out.push((trim(view((s[start:])))).copy());
    return out;
}
fn reg<a>(target: u64, s: &a [u8]) -> string {
    if eq(view((s)), view("%rax")) + eq(view((s)), view("%eax")) + eq(view((s)), view("%al")) {
        if target == 1 {
            return "x9";
        }
        return "t0";
    }
    if eq(view((s)), view("%rdi")) + eq(view((s)), view("%edi")) {
        if target == 1 {
            return "x0";
        }
        return "a0";
    }
    if eq(view((s)), view("%rsi")) + eq(view((s)), view("%esi")) {
        if target == 1 {
            return "x1";
        }
        return "a1";
    }
    if eq(view((s)), view("%rdx")) + eq(view((s)), view("%edx")) {
        if target == 1 {
            return "x2";
        }
        return "a2";
    }
    if eq(view((s)), view("%rcx")) + eq(view((s)), view("%ecx")) {
        if target == 1 {
            return "x3";
        }
        return "a3";
    }
    if eq(view((s)), view("%r8")) + eq(view((s)), view("%r8d")) {
        if target == 1 {
            return "x4";
        }
        return "a4";
    }
    if eq(view((s)), view("%r9")) + eq(view((s)), view("%r9d")) {
        if target == 1 {
            return "x5";
        }
        return "a5";
    }
    if eq(view((s)), view("%r10")) + eq(view((s)), view("%r10d")) {
        if target == 1 {
            return "x6";
        }
        return "a6";
    }
    if eq(view((s)), view("%r11")) + eq(view((s)), view("%r11d")) {
        if target == 1 {
            return "x7";
        }
        return "a7";
    }
    if eq(view((s)), view("%r12")) {
        if target == 1 {
            return "x19";
        }
        return "s1";
    }
    if eq(view((s)), view("%r13")) {
        if target == 1 {
            return "x20";
        }
        return "s2";
    }
    if eq(view((s)), view("%r14")) {
        if target == 1 {
            return "x21";
        }
        return "s3";
    }
    if eq(view((s)), view("%r15")) {
        if target == 1 {
            return "x22";
        }
        return "s4";
    }
    if eq(view((s)), view("%rbx")) {
        if target == 1 {
            return "x23";
        }
        return "s5";
    }
    if eq(view((s)), view("%rbp")) {
        if target == 1 {
            return "x29";
        }
        return "s0";
    }
    if eq(view((s)), view("%rsp")) {
        return "sp";
    }
    bad(view((s)));
    return "";
}
fn small_reg<a>(s: &a [u8]) -> u64 {
    return eq(view((s)), view("%eax"))
        + eq(view((s)), view("%edi"))
        + eq(view((s)), view("%esi"))
        + eq(view((s)), view("%edx"))
        + eq(view((s)), view("%ecx"))
        + eq(view((s)), view("%r8d"))
        + eq(view((s)), view("%r9d"))
        + eq(view((s)), view("%r10d"))
        + eq(view((s)), view("%r11d"));
}
fn armword<a>(s: &a [u8]) -> string {
    if eq(view((s)), view("sp")) {
        return "wsp";
    }
    mut out = "w";
    out.append(s[1:]);
    return out;
}
// Recognize only small decimal literals; expressions stay assembler constants.
fn small_literal<a>(value: &a [u8]) -> u64 {
    if value.len() == 0 {
        return 0;
    }
    mut n = 0;
    for i in value.len() {
        b := value[i];
        if (b < 48) + (57 < b) {
            return 0;
        }
        if 6553 < n {
            return 0;
        }
        n = n * 10 + b - 48;
        if 65536 < n {
            return 0;
        }
    }
    return n + 1;
}
fn constant<a, b, c>(o: (&a mut Out), dst: &b [u8], value: &c [u8]) -> unit {
    if o.target == 2 {
        put(&mut o, view("li "));
        put(&mut o, view((dst)));
        put(&mut o, view(","));
        put(&mut o, view((value)));
        put(&mut o, view("\n"));
        return ();
    }
    short := small_literal(view(value));
    if (short != 0) & (short < 65537) {
        put(&mut o, view("movz "));
        put(&mut o, view(dst));
        put(&mut o, view(",#"));
        u64(&mut o, short - 1);
        put(&mut o, view("\n"));
        return ();
    }
    if value.len() != 0 {
        if value[0] == 45 {
            negative := small_literal(value[1:]);
            if 1 < negative {
                put(&mut o, view("movn "));
                put(&mut o, view(dst));
                put(&mut o, view(",#"));
                u64(&mut o, negative - 2);
                put(&mut o, view("\n"));
                return ();
            }
        }
    }
    put(&mut o, view("movz "));
    put(&mut o, view((dst)));
    put(&mut o, view(",#(("));
    put(&mut o, view((value)));
    put(&mut o, view(")&65535)\n"));
    for i in 3 {
        put(&mut o, view("movk "));
        put(&mut o, view((dst)));
        put(&mut o, view(",#((("));
        put(&mut o, view((value)));
        put(&mut o, view(")>>"));
        u64(&mut o, (i + 1) * 16);
        put(&mut o, view(")&65535),lsl #"));
        u64(&mut o, (i + 1) * 16);
        put(&mut o, view("\n"));
    }
    return ();
}
fn move<a, b, c>(o: (&a mut Out), dst: &b [u8], src: &c [u8]) -> unit {
    if o.target == 1 {
        put(&mut o, view("mov "));
    } else {
        put(&mut o, view("mv "));
    }
    put(&mut o, view((dst)));
    put(&mut o, view(","));
    put(&mut o, view((src)));
    put(&mut o, view("\n"));
    return ();
}
// Address scratch is x13/t3; x12/t2 is used only while forming an address.
fn address<a, b>(o: (&a mut Out), operand: &b [u8]) -> unit {
    target := o.target;
    mut open = operand.len();
    for i in operand.len() {
        if operand[i] == 40 {
            open = i;
            break;
        }
    }
    if open == operand.len() {
        bad(view((operand)));
    }
    parts := split(view((operand[open + 1: operand.len() - 1])), 44);
    base := parts[0].copy();
    disp := operand[: open];
    if eq(view(base), view("%rip")) {
        if target == 1 {
            put(&mut o, view("adrp x13,"));
            put(&mut o, view((disp)));
            put(&mut o, view("\nadd x13,x13,:lo12:"));
            put(&mut o, view((disp)));
            put(&mut o, view("\n"));
        } else {
            put(&mut o, view("lla t3,"));
            put(&mut o, view((disp)));
            put(&mut o, view("\n"));
        }
        return ();
    }
    r := reg(target, view(base));
    if target == 1 {
        move(&mut o, view("x13"), view(r));
    } else {
        move(&mut o, view("t3"), view(r));
    }
    if 1 < parts.len() {
        index := parts[1].copy();
        ir := reg(target, view(index));
        scale := parts[2].copy();
        mut shift = 0;
        if eq(view(scale), view("2")) {
            shift = 1;
        } else {
            if eq(view(scale), view("4")) {
                shift = 2;
            } else {
                if eq(view(scale), view("8")) {
                    shift = 3;
                } else {
                    if eq(view(scale), view("1")) == 0 {
                        bad(view(scale));
                    }
                }
            }
        }
        if target == 1 {
            put(&mut o, view("add x13,x13,"));
            put(&mut o, view(ir));
            put(&mut o, view(",lsl #"));
            u64(&mut o, shift);
            put(&mut o, view("\n"));
        } else {
            put(&mut o, view("slli t2,"));
            put(&mut o, view(ir));
            put(&mut o, view(","));
            u64(&mut o, shift);
            put(&mut o, view("\nadd t3,t3,t2\n"));
        }
    }
    if (disp.len() != 0) & (eq(view((disp)), view("0")) == 0) {
        if target == 1 {
            constant(&mut o, view("x12"), view((disp)));
            put(&mut o, view("add x13,x13,x12\n"));
        } else {
            constant(&mut o, view("t2"), view((disp)));
            put(&mut o, view("add t3,t3,t2\n"));
        }
    }
    return ();
}
fn read_operand<a, b, c>(o: (&a mut Out), operand: &b [u8], dst: &c [u8], byte: u64) -> unit {
    assert(operand.len() != 0);
    target := o.target;
    if operand[0] == 36 {
        constant(&mut o, view((dst)), view((operand[1:])));
        return ();
    }
    if operand[0] == 37 {
        r := reg(target, view((operand)));
        move(&mut o, view((dst)), view(r));
        if byte {
            if target == 1 {
                put(&mut o, view("and "));
                put(&mut o, view((dst)));
                put(&mut o, view(","));
                put(&mut o, view((dst)));
                put(&mut o, view(",#255\n"));
            } else {
                put(&mut o, view("andi "));
                put(&mut o, view((dst)));
                put(&mut o, view(","));
                put(&mut o, view((dst)));
                put(&mut o, view(",255\n"));
            }
        }
        return ();
    }
    address(&mut o, view((operand)));
    if target == 1 {
        if byte {
            put(&mut o, view("ldrb "));
            w := armword(view((dst)));
            put(&mut o, view(w));
        } else {
            put(&mut o, view("ldr "));
            put(&mut o, view((dst)));
        }
        put(&mut o, view(",[x13]\n"));
    } else {
        if byte {
            put(&mut o, view("lbu "));
        } else {
            put(&mut o, view("ld "));
        }
        put(&mut o, view((dst)));
        put(&mut o, view(",0(t3)\n"));
    }
    return ();
}
fn store<a, b>(o: (&a mut Out), operand: &b [u8], byte: u64) -> unit {
    target := o.target;
    assert(operand.len() != 0);
    if operand[0] == 37 {
        r := reg(target, view((operand)));
        if eq(view((operand)), view("%al")) {
            if target == 1 {
                put(&mut o, view("bfi x9,x10,#0,#8\n"));
            } else {
                put(&mut o, view("andi t2,t1,255\nli t3,-256\nand t0,t0,t3\nor t0,t0,t2\n"));
            }
            return ();
        }
        if small_reg(view((operand))) {
            if target == 1 {
                w := armword(view(r));
                put(&mut o, view("mov "));
                put(&mut o, view(w));
                put(&mut o, view(",w10\n"));
            } else {
                put(&mut o, view("slli "));
                put(&mut o, view(r));
                put(&mut o, view(",t1,32\nsrli "));
                put(&mut o, view(r));
                put(&mut o, view(","));
                put(&mut o, view(r));
                put(&mut o, view(",32\n"));
            }
            return ();
        }
        if target == 1 {
            move(&mut o, view(r), view("x10"));
        } else {
            move(&mut o, view(r), view("t1"));
        }
        return ();
    }
    address(&mut o, view((operand)));
    if target == 1 {
        if byte {
            put(&mut o, view("strb w10,[x13]\n"));
        } else {
            put(&mut o, view("str x10,[x13]\n"));
        }
    } else {
        if byte {
            put(&mut o, view("sb t1,0(t3)\n"));
        } else {
            put(&mut o, view("sd t1,0(t3)\n"));
        }
    }
    return ();
}
fn branch<a, b, c>(o: (&a mut Out), op: &b [u8], dest: &c [u8]) -> unit {
    if eq(view((op)), view("jmp")) {
        if o.target == 1 {
            put(&mut o, view("b "));
            put(&mut o, view((dest)));
            put(&mut o, view("\n"));
        } else {
            put(&mut o, view("lla t1,"));
            put(&mut o, view((dest)));
            put(&mut o, view("\njr t1\n"));
        }
        return ();
    }
    n := fresh(&mut o);
    if o.target == 1 {
        if eq(view((op)), view("je")) + eq(view((op)), view("jz")) {
            put(&mut o, view("b.ne "));
        } else {
            if eq(view((op)), view("jne")) + eq(view((op)), view("jnz")) {
                put(&mut o, view("b.eq "));
            } else {
                if eq(view((op)), view("jnc")) + eq(view((op)), view("jae")) {
                    put(&mut o, view("cbnz x15,"));
                } else {
                    if eq(view((op)), view("jb")) + eq(view((op)), view("jc")) {
                        put(&mut o, view("cbz x15,"));
                    } else {
                        bad(view((op)));
                    }
                }
            }
        }
        label(&mut o, n);
        put(&mut o, view("\nb "));
        put(&mut o, view((dest)));
        put(&mut o, view("\n"));
    } else {
        if eq(view((op)), view("je")) + eq(view((op)), view("jz")) {
            put(&mut o, view("beqz t4,"));
        } else {
            if eq(view((op)), view("jne")) + eq(view((op)), view("jnz")) {
                put(&mut o, view("bnez t4,"));
            } else {
                if eq(view((op)), view("jnc")) + eq(view((op)), view("jae")) {
                    put(&mut o, view("bnez t6,"));
                } else {
                    if eq(view((op)), view("jb")) + eq(view((op)), view("jc")) {
                        put(&mut o, view("beqz t6,"));
                    } else {
                        bad(view((op)));
                    }
                }
            }
        }
        label(&mut o, n);
        put(&mut o, view("\nlla t1,"));
        put(&mut o, view((dest)));
        put(&mut o, view("\njr t1\n"));
    }
    mark(&mut o, n);
    return ();
}
fn arithmetic<a, b, c, d>(o: (&a mut Out), op: &b [u8], src: &c [u8], dst: &d [u8]) -> unit {
    target := o.target;
    if target == 1 {
        read_operand(&mut o, view((src)), view("x10"), 0);
        read_operand(&mut o, view((dst)), view("x11"), 0);
    } else {
        read_operand(&mut o, view((src)), view("t1"), 0);
        read_operand(&mut o, view((dst)), view("t2"), 0);
    }
    if eq(view((op)), view("cmpq")) {
        if target == 1 {
            put(&mut o, view("cmp x11,x10\ncset x15,cc\n"));
        } else {
            put(&mut o, view("xor t4,t2,t1\nseqz t4,t4\nsltu t5,t2,t1\nmv t6,t5\n"));
        }
        return ();
    }
    if eq(view((op)), view("testq")) {
        if target == 1 {
            put(&mut o, view("tst x11,x10\nmov x15,#0\n"));
        } else {
            put(&mut o, view("and t4,t2,t1\nseqz t4,t4\nli t5,0\nli t6,0\n"));
        }
        return ();
    }
    if eq(view((op)), view("addq")) {
        if target == 1 {
            put(&mut o, view("adds x10,x11,x10\ncset x15,cs\n"));
        } else {
            put(&mut o, view("add t1,t2,t1\nsltu t6,t1,t2\nseqz t4,t1\n"));
        }
    } else {
        if eq(view((op)), view("subq")) {
            if target == 1 {
                put(&mut o, view("subs x10,x11,x10\ncset x15,cc\n"));
            } else {
                put(&mut o, view("sltu t6,t2,t1\nsub t1,t2,t1\nseqz t4,t1\n"));
            }
        } else {
            if eq(view((op)), view("imulq")) {
                if target == 1 {
                    put(
                        &mut o,
                        view("smulh x12,x11,x10\nmul x10,x11,x10\nasr x14,x10,#63\ncmp x12,x14\ncset x15,ne\n")
                    );
                } else {
                    put(
                        &mut o,
                        view("mulh t3,t2,t1\nmul t1,t2,t1\nsrai t2,t1,63\nxor t6,t3,t2\nsnez t6,t6\n")
                    );
                }
            } else {
                if eq(view((op)), view("xorq")) + eq(view((op)), view("xorl")) {
                    if target == 1 {
                        put(&mut o, view("eor x10,x11,x10\ncmp x10,#0\nmov x15,#0\n"));
                    } else {
                        put(&mut o, view("xor t1,t2,t1\nseqz t4,t1\nli t6,0\n"));
                    }
                } else {
                    if eq(view((op)), view("andq")) {
                        if target == 1 {
                            put(&mut o, view("ands x10,x11,x10\nmov x15,#0\n"));
                        } else {
                            put(&mut o, view("and t1,t2,t1\nseqz t4,t1\nli t6,0\n"));
                        }
                    } else {
                        if eq(view((op)), view("orq")) {
                            if target == 1 {
                                put(&mut o, view("orr x10,x11,x10\ncmp x10,#0\nmov x15,#0\n"));
                            } else {
                                put(&mut o, view("or t1,t2,t1\nseqz t4,t1\nli t6,0\n"));
                            }
                        } else {
                            if eq(view((op)), view("shlq")) {
                                if target == 1 {
                                    put(&mut o, view("lsl x10,x11,x10\n"));
                                } else {
                                    put(&mut o, view("sll t1,t2,t1\n"));
                                }
                            } else {
                                if eq(view((op)), view("shrq")) {
                                    if target == 1 {
                                        put(&mut o, view("lsr x10,x11,x10\n"));
                                    } else {
                                        put(&mut o, view("srl t1,t2,t1\n"));
                                    }
                                } else {
                                    bad(view((op)));
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    store(&mut o, view((dst)), 0);
    return ();
}
fn atomic_instruction<a, b, c>(o: (&a mut Out), op: &b [u8], rest: &c [u8]) -> u64 {
    target := o.target;
    if eq(view(op), view("mfence")) + eq(view(op), view("lfence")) + eq(view(op), view("sfence")) {
        if target == 1 {
            if eq(view(op), view("lfence")) {
                put(&mut o, view("dmb ishld\n"));
            } else {
                put(&mut o, view("dmb ish\n"));
            }
        } else {
            if eq(view(op), view("lfence")) {
                put(&mut o, view("fence r,rw\n"));
            } else {
                if eq(view(op), view("sfence")) {
                    put(&mut o, view("fence rw,w\n"));
                } else {
                    put(&mut o, view("fence rw,rw\n"));
                }
            }
        }
        return true;
    }
    if eq(view(op), view("xchgq")) {
        args := split(view(rest), 44);
        if args.len() != 2 {
            bad(view(rest));
        }
        source := args[0].copy();
        destination := args[1].copy();
        if eq(view(source), view("%rax")) == 0 {
            bad(view(rest));
        }
        address(&mut o, view(destination));
        if target == 1 {
            n := fresh(&mut o);
            put(&mut o, view("dmb ish\nmov x11,x9\n"));
            mark(&mut o, n);
            put(&mut o, view("ldaxr x10,[x13]\nstlxr w12,x11,[x13]\ncbnz w12,"));
            label(&mut o, n);
            put(&mut o, view("\nmov x9,x10\ndmb ish\n"));
        } else {
            put(&mut o, view("fence rw,rw\namoswap.d.aqrl t0,t0,(t3)\nfence rw,rw\n"));
        }
        return true;
    }
    if eq(view(op), view("lock")) {
        if starts(view(rest), view("cmpxchgq ")) == 0 {
            bad(view(rest));
        }
        args := split(rest[9:], 44);
        if args.len() != 2 {
            bad(view(rest));
        }
        source := args[0].copy();
        destination := args[1].copy();
        if eq(view(source), view("%rcx")) == 0 {
            bad(view(rest));
        }
        address(&mut o, view(destination));
        again := fresh(&mut o);
        done := fresh(&mut o);
        if target == 1 {
            put(&mut o, view("dmb ish\nmov x14,x9\nmov x11,x3\n"));
            mark(&mut o, again);
            put(&mut o, view("ldaxr x10,[x13]\ncmp x10,x14\nb.ne "));
            label(&mut o, done);
            put(&mut o, view("\nstlxr w12,x11,[x13]\ncbnz w12,"));
            label(&mut o, again);
            put(&mut o, view("\n"));
            mark(&mut o, done);
            put(&mut o, view("clrex\nmov x9,x10\ncmp x14,x10\ncset x15,cc\ndmb ish\n"));
        } else {
            put(&mut o, view("fence rw,rw\nmv t2,t0\n"));
            mark(&mut o, again);
            put(&mut o, view("lr.d.aq t0,(t3)\nbne t0,t2,"));
            label(&mut o, done);
            put(&mut o, view("\nsc.d.rl t5,a3,(t3)\nbnez t5,"));
            label(&mut o, again);
            put(&mut o, view("\n"));
            mark(&mut o, done);
            put(&mut o, view("xor t4,t2,t0\nseqz t4,t4\nsltu t6,t2,t0\nfence rw,rw\n"));
        }
        return true;
    }
    return false;
}
// ---- Windows ARM64 imports ----------------------------------------------------------------
// The internal argument registers map to x0..x7, which is exactly the Win64 ARM64 order, so an
// import only needs the IAT indirection, 64 bytes of home space and the result move into x9.
fn win_import<a, b>(o: (&a mut Out), name: &b [u8]) -> unit {
    put(&mut o, view("sub sp,sp,#64\nadrp x16,__imp_"));
    put(&mut o, view(name));
    put(&mut o, view("\nldr x16,[x16,:lo12:__imp_"));
    put(&mut o, view(name));
    put(&mut o, view("]\nblr x16\nadd sp,sp,#64\nmov x9,x0\n"));
    return ();
}
// Frame allocation for Windows ARM64: a plain subtraction of the `.set` frame value. Larger
// frames still fit because the value is materialized into x10 first.
fn budget<a, b>(o: (&a mut Out), symbol: &b [u8]) -> unit {
    put(&mut o, view("movz x10,#(("));
    put(&mut o, view(symbol));
    put(&mut o, view(")&65535)\nmovk x10,#((("));
    put(&mut o, view(symbol));
    put(&mut o, view(")>>16)&65535),lsl #16\nsub sp,sp,x10\n"));
    return ();
}
fn win_exit<a>(o: (&a mut Out)) -> unit {
    put(
        &mut o,
        view("sub sp,sp,#64\nadrp x16,__imp_ExitProcess\nldr x16,[x16,:lo12:__imp_ExitProcess]\nblr x16\nbrk #0\n")
    );
    return ();
}
fn instruction<a, b>(o: (&a mut Out), line: &b [u8]) -> unit {
    target := o.target;
    mut space = line.len();
    for i in line.len() {
        if line[i] == 32 {
            space = i;
            break;
        }
    }
    op := line[: space];
    mut rest = u8[];
    if space < line.len() {
        rest = (trim(view((line[space + 1:])))).copy();
    }
    if o.win != 0 {
        if eq(view((op)), view("winimport")) {
            win_import(&mut o, view(rest));
            return ();
        }
        if eq(view((op)), view("winexit")) {
            win_exit(&mut o);
            return ();
        }
        if eq(view((op)), view("wintp")) {
            put(&mut o, view("ldr x9,[x18,#40]\n"));
            return ();
        }
        if eq(view((op)), view("wintpset")) {
            put(&mut o, view("str x1,[x18,#40]\nmov x9,#0\n"));
            return ();
        }
        if eq(view((op)), view("winunsupported")) {
            put(&mut o, view("brk #0\n"));
            return ();
        }
        if eq(view((op)), view("wininvoke")) {
            // x9 holds the function pointer stored in a vtable slot.
            put(&mut o, view("ldr x16,[x9]\nblr x16\nmov x9,x0\n"));
            return ();
        }
        if eq(view((op)), view("framesub")) {
            budget(&mut o, view(rest));
            return ();
        }
    }
    if atomic_instruction(&mut o, view(op), view(rest)) {
        return ();
    }
    if starts(view((op)), view("j")) {
        branch(&mut o, view((op)), view(rest));
        return ();
    }
    if eq(view(op), view("call")) {
        if rest.len() != 0 {
            if rest[0] == 42 {
                r := reg(target, rest[1:]);
                if target == 1 {
                    put(&mut o, view("blr "));
                    put(&mut o, view(r));
                    put(&mut o, view("\nmov x9,x0\n"));
                } else {
                    put(&mut o, view("jalr ra,"));
                    put(&mut o, view(r));
                    put(&mut o, view(",0\nmv t0,a0\n"));
                }
                return ();
            }
        }
    }
    if eq(view((op)), view("call")) {
        if target == 1 {
            put(&mut o, view("bl "));
            put(&mut o, view(rest));
            put(&mut o, view("\nmov x9,x0\n"));
        } else {
            put(&mut o, view("call "));
            put(&mut o, view(rest));
            put(&mut o, view("\nmv t0,a0\n"));
        }
        return ();
    }
    if eq(view((op)), view("ret")) {
        if target == 1 {
            put(&mut o, view("mov x0,x9\nret\n"));
        } else {
            put(&mut o, view("mv a0,t0\nret\n"));
        }
        return ();
    }
    if eq(view((op)), view("leave")) {
        if target == 1 {
            put(&mut o, view("mov sp,x29\nldp x29,x30,[sp],#16\n"));
        } else {
            put(&mut o, view("mv sp,s0\nld s0,0(sp)\nld ra,8(sp)\naddi sp,sp,16\n"));
        }
        return ();
    }
    if eq(view((op)), view("pushq")) + eq(view((op)), view("popq")) {
        push := eq(view((op)), view("pushq"));
        r := reg(target, view(rest));
        if eq(view(rest), view("%rbp")) {
            if target == 1 {
                if push {
                    put(&mut o, view("stp x29,x30,[sp,#-16]!\n"));
                } else {
                    put(&mut o, view("ldp x29,x30,[sp],#16\n"));
                }
            } else {
                if push {
                    put(&mut o, view("addi sp,sp,-16\nsd s0,0(sp)\nsd ra,8(sp)\n"));
                } else {
                    put(&mut o, view("ld s0,0(sp)\nld ra,8(sp)\naddi sp,sp,16\n"));
                }
            }
            return ();
        }
        if target == 1 {
            if push {
                put(&mut o, view("str "));
                put(&mut o, view(r));
                put(&mut o, view(",[sp,#-16]!\n"));
            } else {
                put(&mut o, view("ldr "));
                put(&mut o, view(r));
                put(&mut o, view(",[sp],#16\n"));
            }
        } else {
            if push {
                put(&mut o, view("addi sp,sp,-16\nsd "));
                put(&mut o, view(r));
                put(&mut o, view(",0(sp)\n"));
            } else {
                put(&mut o, view("ld "));
                put(&mut o, view(r));
                put(&mut o, view(",0(sp)\naddi sp,sp,16\n"));
            }
        }
        return ();
    }
    if eq(view((op)), view("syscall")) {
        if target == 1 {
            put(&mut o, view("mov x8,x9\nmov x3,x6\nsvc #0\nmov x9,x0\n"));
        } else {
            put(&mut o, view("mv a7,t0\nmv a3,a6\necall\nmv t0,a0\n"));
        }
        return ();
    }
    // Thread clone: x0/a0 flags, x1/a1 child stack holding {entry,arg}, x2/a2 parent/child TID word.
    if eq(view((op)), view("clonethread")) {
        if target == 1 {
            put(
                &mut o,
                view("mov x4,x2\nmov x3,xzr\nmov x8,#220\nsvc #0\ncbnz x0,1f\nldp x9,x0,[sp],#16\nmov x29,xzr\nblr x9\nmov x0,xzr\nmov x8,#93\nsvc #0\nbrk #0\n1:\nmov x9,x0\n")
            );
        } else {
            put(
                &mut o,
                view("mv a4,a2\nli a3,0\nli a7,220\necall\nbnez a0,1f\nld t0,0(sp)\nld a0,8(sp)\naddi sp,sp,16\nli s0,0\njalr ra,t0,0\nli a0,0\nli a7,93\necall\nebreak\n1:\nmv t0,a0\n")
            );
        }
        return ();
    }
    // IEEE double operations on the bit patterns in rax (left) and rcx (right); result in rax.
    if eq(view((op)), view("fop")) {
        if target == 1 {
            if eq(view(rest), view("fromi")) {
                put(&mut o, view("scvtf d0,x9\nfmov x9,d0\n"));
                return ();
            }
            if eq(view(rest), view("toi")) {
                put(&mut o, view("fmov d0,x9\nfcvtzs x9,d0\n"));
                return ();
            }
            if eq(view(rest), view("sqrt")) {
                put(&mut o, view("fmov d0,x9\nfsqrt d0,d0\nfmov x9,d0\n"));
                return ();
            }
            put(&mut o, view("fmov d0,x9\nfmov d1,x3\n"));
            if eq(view(rest), view("add")) {
                put(&mut o, view("fadd d0,d0,d1\nfmov x9,d0\n"));
                return ();
            }
            if eq(view(rest), view("sub")) {
                put(&mut o, view("fsub d0,d0,d1\nfmov x9,d0\n"));
                return ();
            }
            if eq(view(rest), view("mul")) {
                put(&mut o, view("fmul d0,d0,d1\nfmov x9,d0\n"));
                return ();
            }
            if eq(view(rest), view("div")) {
                put(&mut o, view("fdiv d0,d0,d1\nfmov x9,d0\n"));
                return ();
            }
            if eq(view(rest), view("lt")) {
                put(&mut o, view("fcmp d0,d1\ncset x9,mi\n"));
                return ();
            }
            if eq(view(rest), view("eq")) {
                put(&mut o, view("fcmp d0,d1\ncset x9,eq\n"));
                return ();
            }
        } else {
            if eq(view(rest), view("fromi")) {
                put(&mut o, view("fcvt.d.l ft0,t0\nfmv.x.d t0,ft0\n"));
                return ();
            }
            if eq(view(rest), view("toi")) {
                put(&mut o, view("fmv.d.x ft0,t0\nfcvt.l.d t0,ft0,rtz\n"));
                return ();
            }
            if eq(view(rest), view("sqrt")) {
                put(&mut o, view("fmv.d.x ft0,t0\nfsqrt.d ft0,ft0\nfmv.x.d t0,ft0\n"));
                return ();
            }
            put(&mut o, view("fmv.d.x ft0,t0\nfmv.d.x ft1,a3\n"));
            if eq(view(rest), view("add")) {
                put(&mut o, view("fadd.d ft0,ft0,ft1\nfmv.x.d t0,ft0\n"));
                return ();
            }
            if eq(view(rest), view("sub")) {
                put(&mut o, view("fsub.d ft0,ft0,ft1\nfmv.x.d t0,ft0\n"));
                return ();
            }
            if eq(view(rest), view("mul")) {
                put(&mut o, view("fmul.d ft0,ft0,ft1\nfmv.x.d t0,ft0\n"));
                return ();
            }
            if eq(view(rest), view("div")) {
                put(&mut o, view("fdiv.d ft0,ft0,ft1\nfmv.x.d t0,ft0\n"));
                return ();
            }
            if eq(view(rest), view("lt")) {
                put(&mut o, view("flt.d t0,ft0,ft1\n"));
                return ();
            }
            if eq(view(rest), view("eq")) {
                put(&mut o, view("feq.d t0,ft0,ft1\n"));
                return ();
            }
        }
        bad(view(rest));
        return ();
    }
    if eq(view((op)), view("tpget")) {
        if target == 1 {
            put(&mut o, view("mrs x9,tpidr_el0\n"));
        } else {
            put(&mut o, view("mv t0,tp\n"));
        }
        return ();
    }
    if eq(view((op)), view("tpset")) {
        if target == 1 {
            put(&mut o, view("msr tpidr_el0,x0\n"));
        } else {
            put(&mut o, view("mv tp,a0\n"));
        }
        return ();
    }
    // Stack switch: x0/a0 receives the saved stack pointer, x1/a1 is the stack to resume.
    if eq(view((op)), view("switchctx")) {
        if target == 1 {
            put(
                &mut o,
                view("adr x9,1f\nstp x29,x30,[sp,#-16]!\nstp x19,x20,[sp,#-16]!\nstp x21,x22,[sp,#-16]!\nstp x23,x9,[sp,#-16]!\nmov x10,sp\nstr x10,[x0]\nmov sp,x1\nldp x23,x9,[sp],#16\nldp x21,x22,[sp],#16\nldp x19,x20,[sp],#16\nldp x29,x30,[sp],#16\nbr x9\n1:\n")
            );
        } else {
            put(
                &mut o,
                view("lla t0,1f\naddi sp,sp,-64\nsd s0,0(sp)\nsd s1,8(sp)\nsd s2,16(sp)\nsd s3,24(sp)\nsd s4,32(sp)\nsd s5,40(sp)\nsd ra,48(sp)\nsd t0,56(sp)\nsd sp,0(a0)\nmv sp,a1\nld s0,0(sp)\nld s1,8(sp)\nld s2,16(sp)\nld s3,24(sp)\nld s4,32(sp)\nld s5,40(sp)\nld ra,48(sp)\nld t0,56(sp)\naddi sp,sp,64\njr t0\n1:\n")
            );
        }
        return ();
    }
    if eq(view((op)), view("ud2")) {
        if target == 1 {
            put(&mut o, view("brk #0\n"));
        } else {
            put(&mut o, view("ebreak\n"));
        }
        return ();
    }
    if eq(view((op)), view("rep")) {
        if eq(view(rest), view("stosq")) == 0 {
            bad(view((line)));
        }
        n := fresh(&mut o);
        end := fresh(&mut o);
        mark(&mut o, n);
        if target == 1 {
            put(&mut o, view("cbz x3,"));
            label(&mut o, end);
            put(&mut o, view("\nstr x9,[x0],#8\nsub x3,x3,#1\nb "));
            label(&mut o, n);
            put(&mut o, view("\n"));
        } else {
            put(&mut o, view("beqz a3,"));
            label(&mut o, end);
            put(&mut o, view("\nsd t0,0(a0)\naddi a0,a0,8\naddi a3,a3,-1\nj "));
            label(&mut o, n);
            put(&mut o, view("\n"));
        }
        mark(&mut o, end);
        return ();
    }
    if eq(view((op)), view("sete")) + eq(view((op)), view("setne")) + eq(view((op)), view("setb")) {
        if target == 1 {
            if eq(view((op)), view("setb")) {
                put(&mut o, view("mov x10,x15\n"));
            } else {
                put(&mut o, view("cset x10,"));
                if eq(view((op)), view("sete")) {
                    put(&mut o, view("eq\n"));
                } else {
                    put(&mut o, view("ne\n"));
                }
            }
        } else {
            if eq(view((op)), view("sete")) {
                put(&mut o, view("mv t1,t4\n"));
            } else {
                if eq(view((op)), view("setne")) {
                    put(&mut o, view("xori t1,t4,1\n"));
                } else {
                    put(&mut o, view("mv t1,t6\n"));
                }
            }
        }
        store(&mut o, view(rest), 0);
        return ();
    }
    if eq(view((op)), view("incq")) {
        if target == 1 {
            read_operand(&mut o, view(rest), view("x10"), 0);
            put(&mut o, view("adds x10,x10,#1\n"));
        } else {
            read_operand(&mut o, view(rest), view("t1"), 0);
            put(&mut o, view("addi t1,t1,1\nseqz t4,t1\n"));
        }
        store(&mut o, view(rest), 0);
        return ();
    }
    if eq(view((op)), view("mulq")) + eq(view((op)), view("divq")) {
        if target == 1 {
            read_operand(&mut o, view(rest), view("x10"), 0);
            if eq(view((op)), view("mulq")) {
                put(
                    &mut o,
                    view("umulh x11,x9,x10\nmul x10,x9,x10\nmov x2,x11\ncmp x11,#0\ncset x15,ne\nmov x9,x10\n")
                );
            } else {
                put(&mut o, view("udiv x11,x9,x10\nmsub x2,x11,x10,x9\nmov x9,x11\n"));
            }
        } else {
            read_operand(&mut o, view(rest), view("t1"), 0);
            if eq(view((op)), view("mulq")) {
                put(
                    &mut o,
                    view("mulhu t2,t0,t1\nmul t1,t0,t1\nmv a2,t2\nsltu t6,zero,t2\nmv t0,t1\n")
                );
            } else {
                put(&mut o, view("divu t2,t0,t1\nremu a2,t0,t1\nmv t0,t2\n"));
            }
        }
        return ();
    }
    args := split(view(rest), 44);
    if args.len() != 2 {
        bad(view((line)));
    }
    src := args[0].copy();
    dst := args[1].copy();
    if eq(view((op)), view("movq"))
        + eq(view((op)), view("movl"))
        + eq(view((op)), view("movabsq"))
        + eq(view((op)), view("movb"))
        + eq(view((op)), view("movzbq")) {
        if target == 1 {
            read_operand(&mut o, view(src), view("x10"), eq(view(op), view("movzbq")));
        } else {
            read_operand(&mut o, view(src), view("t1"), eq(view(op), view("movzbq")));
        }
        store(&mut o, view(dst), eq(view(op), view("movb")));
        return ();
    }
    if eq(view((op)), view("leaq")) {
        address(&mut o, view(src));
        if target == 1 {
            move(&mut o, view("x10"), view("x13"));
        } else {
            move(&mut o, view("t1"), view("t3"));
        }
        store(&mut o, view(dst), 0);
        return ();
    }
    arithmetic(&mut o, view((op)), view(src), view(dst));
    return ();
}
pub fn lower<a>(input: &a [u8], target: u64) -> u8[] {
    assert((target == 1) + (target == 2) + (target == 4));
    mut isa = target;
    mut win = 0;
    if target == 4 {
        isa = 1;
        win = 1;
    }
    mut out = Out { text: u8[], target: isa, win: win, next: 1 };
    // Frame constants are known before instruction selection (no unresolved immediate expressions).
    mut start = 0;
    for i in input.len() {
        if input[i] == 10 {
            line := trim(view((input[start: i])));
            if starts(view((line)), view(".set ")) {
                put(&mut out, view((line)));
                put(&mut out, view("\n"));
            }
            start = i + 1;
        }
    }
    if target == 2 {
        put(&mut out, view(".option norelax\n.option norvc\n"));
    }
    start = 0;
    for i in input.len() {
        if input[i] == 10 {
            line := trim(view((input[start: i])));
            start = i + 1;
            if line.len() != 0 {
                if starts(view((line)), view(".set ")) == 0 {
                    if (line[0] == 46)
                        + (line[line.len() - 1] == 58)
                        + starts(view(line), view("rt_state:")) {
                        put(&mut out, view((line)));
                        put(&mut out, view("\n"));
                    } else {
                        instruction(&mut out, view((line)));
                    }
                }
            }
        }
    }
    assert(start == input.len());
    return out.text;
}
