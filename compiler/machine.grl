    }
    // The address of this thread's `rt_tls_record` (an initial-exec TLS word of the executable),
    // computed from the thread pointer, which must be a libc TCB at this point.
    if eq(view((op)), view("tlsaddr")) {
        if target == 1 {
            put(&mut o, view("mrs x9,tpidr_el0\nadd x9,x9,#:tprel_hi12:rt_tls_record\nadd x9,x9,#:tprel_lo12_nc:rt_tls_record\n"));
        } else {
            put(&mut o, view("lui t0,%tprel_hi(rt_tls_record)\nadd t0,t0,tp,%tprel_add(rt_tls_record)\naddi t0,t0,%tprel_lo(rt_tls_record)\n"));
        }
        return ();
    }
    if eq(view((op)), view("tpset")) {
        if target == 1 {
            put(&mut o, view("msr tpidr_el0,x0\n"));
        } else {
            put(&mut o, view("mv tp,a0\n"));
        }
        return ();
    }
    // Stack switch: x0/a0 receives the saved stack pointer, x1/a1 is the stack to resume. Every
    // register the C ABI preserves is saved (x19-x28, d8-d15; s0-s11, fs0-fs11), since LLVM-compiled
    // functions keep values in all of them across the switch.
    if eq(view((op)), view("switchctx")) {
        if target == 1 {
            put(
                &mut o,
                view("adr x9,1f\nstp x29,x30,[sp,#-16]!\nstp x19,x20,[sp,#-16]!\nstp x21,x22,[sp,#-16]!\nstp x23,x24,[sp,#-16]!\nstp x25,x26,[sp,#-16]!\nstp x27,x28,[sp,#-16]!\nstp d8,d9,[sp,#-16]!\nstp d10,d11,[sp,#-16]!\nstp d12,d13,[sp,#-16]!\nstp d14,d15,[sp,#-16]!\nstp x9,xzr,[sp,#-16]!\nmov x10,sp\nstr x10,[x0]\nmov sp,x1\nldp x9,x10,[sp],#16\nldp d14,d15,[sp],#16\nldp d12,d13,[sp],#16\nldp d10,d11,[sp],#16\nldp d8,d9,[sp],#16\nldp x27,x28,[sp],#16\nldp x25,x26,[sp],#16\nldp x23,x24,[sp],#16\nldp x21,x22,[sp],#16\nldp x19,x20,[sp],#16\nldp x29,x30,[sp],#16\nbr x9\n1:\n")
            );
        } else {
            put(
                &mut o,
                view("lla t0,1f\naddi sp,sp,-208\nsd s0,0(sp)\nsd s1,8(sp)\nsd s2,16(sp)\nsd s3,24(sp)\nsd s4,32(sp)\nsd s5,40(sp)\nsd s6,48(sp)\nsd s7,56(sp)\nsd s8,64(sp)\nsd s9,72(sp)\nsd s10,80(sp)\nsd s11,88(sp)\nsd ra,96(sp)\nfsd fs0,104(sp)\nfsd fs1,112(sp)\nfsd fs2,120(sp)\nfsd fs3,128(sp)\nfsd fs4,136(sp)\nfsd fs5,144(sp)\nfsd fs6,152(sp)\nfsd fs7,160(sp)\nfsd fs8,168(sp)\nfsd fs9,176(sp)\nfsd fs10,184(sp)\nfsd fs11,192(sp)\nsd t0,200(sp)\nsd sp,0(a0)\nmv sp,a1\nld s0,0(sp)\nld s1,8(sp)\nld s2,16(sp)\nld s3,24(sp)\nld s4,32(sp)\nld s5,40(sp)\nld s6,48(sp)\nld s7,56(sp)\nld s8,64(sp)\nld s9,72(sp)\nld s10,80(sp)\nld s11,88(sp)\nld ra,96(sp)\nfld fs0,104(sp)\nfld fs1,112(sp)\nfld fs2,120(sp)\nfld fs3,128(sp)\nfld fs4,136(sp)\nfld fs5,144(sp)\nfld fs6,152(sp)\nfld fs7,160(sp)\nfld fs8,168(sp)\nfld fs9,176(sp)\nfld fs10,184(sp)\nfld fs11,192(sp)\nld t0,200(sp)\naddi sp,sp,208\njr t0\n1:\n")
            );
        }
        return ();
    }
    if eq(view((op)), view("ud2")) {
        if target == 1 {
            put(&mut o, view("brk #0\n"));
        } else {
            put(&mut o, view("ebreak\n"));
        }
        return ();
    }
    if eq(view((op)), view("rep")) {
        if !eq(view(rest), view("stosq")) {
            bad(view((line)));
        }
        n := fresh(&mut o);
        end := fresh(&mut o);
        mark(&mut o, n);
        if target == 1 {
            put(&mut o, view("cbz x3,"));
            label(&mut o, end);
            put(&mut o, view("\nstr x9,[x0],#8\nsub x3,x3,#1\nb "));
            label(&mut o, n);
            put(&mut o, view("\n"));
        } else {
            put(&mut o, view("beqz a3,"));
            label(&mut o, end);
            put(&mut o, view("\nsd t0,0(a0)\naddi a0,a0,8\naddi a3,a3,-1\nj "));
            label(&mut o, n);
            put(&mut o, view("\n"));
        }
        mark(&mut o, end);
        return ();
    }
    if eq(view((op)), view("sete")) || eq(view((op)), view("setne")) || eq(view((op)), view("setb")) {
        if target == 1 {
            if eq(view((op)), view("setb")) {
                put(&mut o, view("mov x10,x15\n"));
            } else {
                put(&mut o, view("cset x10,"));
                if eq(view((op)), view("sete")) {
                    put(&mut o, view("eq\n"));
                } else {
                    put(&mut o, view("ne\n"));
                }
            }
        } else {
            if eq(view((op)), view("sete")) {
                put(&mut o, view("mv t1,t4\n"));
            } else {
                if eq(view((op)), view("setne")) {
                    put(&mut o, view("xori t1,t4,1\n"));
                } else {
                    put(&mut o, view("mv t1,t6\n"));
                }
            }
        }
        store(&mut o, view(rest), 0);
        return ();
    }
    if eq(view((op)), view("incq")) {
        if target == 1 {
            read_operand(&mut o, view(rest), view("x10"), 0);
            put(&mut o, view("adds x10,x10,#1\n"));
        } else {
            read_operand(&mut o, view(rest), view("t1"), 0);
            put(&mut o, view("addi t1,t1,1\nseqz t4,t1\n"));
        }
        store(&mut o, view(rest), 0);
        return ();
    }
    if eq(view((op)), view("mulq")) || eq(view((op)), view("divq")) {
        if target == 1 {
            read_operand(&mut o, view(rest), view("x10"), 0);
            if eq(view((op)), view("mulq")) {
                put(
                    &mut o,
                    view("umulh x11,x9,x10\nmul x10,x9,x10\nmov x2,x11\ncmp x11,#0\ncset x15,ne\nmov x9,x10\n")
                );
            } else {
                put(&mut o, view("udiv x11,x9,x10\nmsub x2,x11,x10,x9\nmov x9,x11\n"));
            }
        } else {
            read_operand(&mut o, view(rest), view("t1"), 0);
            if eq(view((op)), view("mulq")) {
                put(
                    &mut o,
                    view("mulhu t2,t0,t1\nmul t1,t0,t1\nmv a2,t2\nsltu t6,zero,t2\nmv t0,t1\n")
                );
            } else {
                put(&mut o, view("divu t2,t0,t1\nremu a2,t0,t1\nmv t0,t2\n"));
            }
        }
        return ();
    }
    args := split(view(rest), 44);
    if args.len() != 2 {
        bad(view((line)));
    }
    src := args[0].copy();
    dst := args[1].copy();
    if float_sse(&mut o, view(op), view(src), view(dst)) {
        return ();
    }
    if eq(view((op)), view("movq"))
        || eq(view((op)), view("movl"))
        || eq(view((op)), view("movabsq"))
        || eq(view((op)), view("movb"))
        || eq(view((op)), view("movzbq"))
        || eq(view((op)), view("movzwq"))
        || eq(view((op)), view("movswq"))
        || eq(view((op)), view("movw")) {
        mut rw = 0;
        mut sw = 0;
        if eq(view(op), view("movzbq")) {
            rw = 1;
        }
        // 16-bit: a zero- or sign-extending halfword load, a halfword store (sized_load/sized_store).
        if eq(view(op), view("movzwq")) {
            rw = 3;
        }
        if eq(view(op), view("movswq")) {
            rw = 4;
        }
        if eq(view(op), view("movw")) {
            sw = 3;
        }
        if eq(view(op), view("movb")) {
            sw = 1;
        }
        if eq(view(op), view("movl")) {
            // A 32-bit move: a memory source is a zero-extending 32-bit load, a memory destination a
            // 32-bit store; register to register zero-extends through the small-register store.
            if (src[0] != 36) & (src[0] != 37) {
                rw = 2;
            }
            if dst[0] != 37 {
                sw = 2;
            }
        }
        if target == 1 {
            read_operand(&mut o, view(src), view("x10"), rw);
        } else {
            read_operand(&mut o, view(src), view("t1"), rw);
        }
        store(&mut o, view(dst), sw);
        return ();
    }
    if eq(view((op)), view("leaq")) {
        address(&mut o, view(src));
        if target == 1 {
            move(&mut o, view("x10"), view("x13"));
        } else {
            move(&mut o, view("t1"), view("t3"));
        }
        store(&mut o, view(dst), 0);
        return ();
    }
    arithmetic(&mut o, view((op)), view(src), view(dst));
    return ();
}
pub fn lower<a>(input: &a [u8], target: u64, plat: u64) -> u8[] {
    assert(target == 1 || target == 2 || target == 4);
    mut isa = target;
    mut win = 0;
    if target == 4 {
        isa = 1;
        win = 1;
    }
    mut out = Out { text: u8[], target: isa, win: win, plat: plat, next: 1 };
    // Frame constants are known before instruction selection (no unresolved immediate expressions).
    mut start = 0;
    for i in input.len() {
        if input[i] == 10 {
            line := trim(view((input[start: i])));
            if starts(view((line)), view(".set ")) {
                put(&mut out, view((line)));
                put(&mut out, view("\n"));
            }
            start = i + 1;
        }
    }
    if target == 2 {
        put(&mut out, view(".option norelax\n.option norvc\n"));
    }
    start = 0;
    for i in input.len() {
        if input[i] == 10 {
            line := trim(view((input[start: i])));
            start = i + 1;
            if line.len() != 0 {
                if !starts(view((line)), view(".set ")) {
                    if (line[0] == 46)
                        || (line[line.len() - 1] == 58)
                        || starts(view(line), view("rt_state:"))
                        || starts(view(line), view("rt_tls_record:")) {
                        put(&mut out, view((line)));
                        put(&mut out, view("\n"));
                    } else {
                        instruction(&mut out, view((line)));
                    }
                }
            }
        }
    }
    assert(start == input.len());
    return same_moves(view(out.text), isa);
}
// ---- moves that move nothing (call ABI S7) ----
// The word machine's %rax is x9 (t0) and %rdi is x0 (a0), and a move goes through the scratch x10
// (t1): every call ends in `mov x9,x0`, and a result that becomes an argument or is returned goes
// back with `mov x10,x9; mov x0,x10`-like pairs. A value number per integer register follows the
// moves: `mov D,S` gives D the number of S, and is dropped when D already has it. Any other line
// gives every register it names a fresh number (stores and compares only read, but the pass does
// not need to know that to be right); a label, branch, call, return or system call forgets all.
// So it only drops a move between two registers no line in between could have touched.
fn same_moves<a>(text: &a [u8], isa: u64) -> u8[] {
    mut mv = "mov ";
    if isa == 2 {
        mv = "mv ";
    }
    mut val = u64[];
    for i in 64 {
        val.push(i + 1);
    }
    mut next = 1000;
    mut out = u8[];
    mut start = 0;
    for i in text.len() {
        if text[i] != 10 {
            continue;
        }
        line := text[start: i];
        start = i + 1;
        if starts(view(line), view(mv)) {
            ops := line[mv.len():];
            mut comma = 0;
            while (comma < ops.len()) && (ops[comma] != 44) {
                comma += 1;
            }
            if comma < ops.len() {
                d := reg_number(view(ops[: comma]), isa);
                src := reg_number(view(ops[comma + 1:]), isa);
                // A 32-bit `mov w9,w10` zero-extends: it is not a copy of the 64-bit value.
                wide := (isa != 1) || ((ops[0] == 120) && (comma + 1 < ops.len()) && (ops[comma + 1] == 120));
                if (d < 64) && (src < 64) && wide {
                    if val[d] == val[src] {
                        continue;
                    }
                    val[d] = val[src];
                    out.append(line);
                    out.push(10);
                    continue;
                }
            }
        }
        if !keeps_values(view(line)) {
            for r in 64 {
                val[r] = next;
                next += 1;
            }
        } else {
            forget_named(view(line), isa, &mut val, &mut next);
        }
        out.append(line);
        out.push(10);
    }
    out.append(text[start:]);
    return out;
}
// False for a line after which no register may be assumed: a label, or control that leaves or comes
// back (branches, calls, returns, system calls).
fn keeps_values<a>(line: &a [u8]) -> bool {
    if line.len() == 0 {
        return true;
    }
    if line[line.len() - 1] == 58 {
        return false;
    }
    if line[0] == 46 {
        // A directive emits no code, unless it is an encoded instruction or data in the text.
        return !(starts(view(line), view(".inst")) || starts(view(line), view(".word")) || starts(view(line), view(".long")) || starts(view(line), view(".4byte")) || starts(view(line), view(".byte")) || starts(view(line), view(".quad")));
    }
    mut sp = 0;
    while (sp < line.len()) && (line[sp] != 32) {
        sp += 1;
    }
    op := line[: sp];
    return !((op[0] == 98) || (op[0] == 106) || starts(view(op), view("cb")) || starts(view(op), view("tb")) || eq(view(op), view("ret")) || eq(view(op), view("call")) || eq(view(op), view("tail")) || eq(view(op), view("svc")) || eq(view(op), view("ecall")));
}
// Every integer register `line` names gets a fresh value number.
fn forget_named<a>(line: &a [u8], isa: u64, val: (&mut u64[]), next: (&mut u64)) -> unit {
    mut i = 0;
    while i < line.len() {
        if (i == 0) || !reg_char(line[i - 1]) {
            mut j = i;
            while (j < line.len()) && reg_char(line[j]) {
                j += 1;
            }
            if j > i {
                r := reg_number(view(line[i: j]), isa);
                if r < 64 {
                    val[r] = *next;
                    *next = *next + 1;
                }
                i = j;
                continue;
            }
        }
        i += 1;
    }
    return ();
}
// The number of an integer register (x0-x30 or w0-w30 on AArch64; x0-x31's ABI names on RV64),
// 64 for anything else (sp, zero registers, vector registers, symbols).
fn reg_number<a>(w: &a [u8], isa: u64) -> u64 {
    if w.len() < 2 {
        return 64;
    }
    if isa == 1 {
        if (w[0] != 120) && (w[0] != 119) {
            return 64;
        }
        mut n = 0;
        for k in w.len() - 1 {
            c := w[1 + k];
            if (c < 48) || (c > 57) {
                return 64;
            }
            n = n * 10 + c - 48;
        }
        if (w.len() > 3) || (n > 30) {
            return 64;
        }
        return n;
    }
    names := ["ra", "sp", "gp", "tp", "t0", "t1", "t2", "s0", "s1", "a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11", "t3", "t4", "t5", "t6"];
    for k in names.len() {
        if eq(view(w), view(names[k])) {
            if (k == 1) || (k == 2) || (k == 3) {
                return 64;
            }
            return k + 1;
        }
    }
    return 64;
}
fn reg_char(c: u64) -> bool {
    return ((c >= 97) && (c <= 122)) || ((c >= 48) && (c <= 57)) || ((c >= 65) && (c <= 90)) || (c == 95);
}
