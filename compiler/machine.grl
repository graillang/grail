// An SSE register of the x86 text in this target's floating-point file: the scratch pair xmm0/xmm1
// is d0/d1 (ft0/ft1), and the registers the optimiser keeps floats in, xmm8..xmm14, are v17..v23
// (ft2..ft8) - caller-saved in AAPCS64 and the RISC-V psABI, as every SSE register is in SysV, and
// clear of d16/ft0, the scratch of the f32 conversions above. `single` names the 32-bit view. ""
// when `s` is not one of them.
fn freg<a>(target: u64, s: &a [u8], single: bool) -> u8[] {
    mut n = 99;
    if eq(view(s), view("%xmm0")) {
        n = 0;
    }
    if eq(view(s), view("%xmm1")) {
        n = 1;
    }
    if (s.len() == 5) && starts(view(s), view("%xmm")) && (s[4] > 55) && (s[4] < 58) {
        n = s[4] - 48;
    }
    if (s.len() == 6) && starts(view(s), view("%xmm1")) && (s[5] > 47) && (s[5] < 53) {
        n = 10 + s[5] - 48;
    }
    mut out = u8[];
    if n == 99 {
        return out;
    }
    mut k = n;
    if target == 1 {
        if n > 7 {
            k = n + 9;
        }
        if single {
            out.push(115);
        } else {
            out.push(100);
        }
    } else {
        if n > 7 {
            k = n - 6;
        }
        out.push(102);
        out.push(116);
    }
    if k > 9 {
        out.push(48 + k / 10);
    }
    out.push(48 + k % 10);
    return out;
}
