fn rg_width_of(op: (&[u8])) -> u64 {
    if eq(op, view("movl")) {
        return 32;
    }
    if eq(op, view("movb")) {
        return 8;
    }
    if eq(op, view("movzbq")) {
        return 8;
    }
    if eq(op, view("movzwq")) {
        return 16;
    }
    if eq(op, view("movslq")) {
        return 32;
    }
    return 64;
}
// 1 when a call is one of the read-only accessors: it reads the sequence it is given and writes
// neither the sequence's header nor any storage the caller owns.
fn rg_readonly(name: (&[u8])) -> bool {
    if starts(name, view("rt_slot")) || starts(name, view("rt_at")) {
        return true;
    }
    if eq(name, view("rt_len")) || eq(name, view("rt_view")) || eq(name, view("rt_write")) {
        return true;
    }
    if eq(name, view("rt_slice")) || eq(name, view("rt_vslice")) {
        return true;
    }
    if eq(name, view("rt_f64_op")) || eq(name, view("rt_f32_round")) || eq(name, view("rt_f64_sqrt")) {
        return true;
    }
    return false;
}
// The caller-saved registers a call clobbers. The callee-saved ones keep their facts: the stream
// spills them at entry and reloads them at exit, which is where the loop counters live.
fn rg_clobber(rc: (&RC), st: (&mut u64[])) -> unit {
    rg_clear(&mut st, 0);
    rg_clear(&mut st, 2);
    rg_clear(&mut st, 3);
    rg_clear(&mut st, 4);
    rg_clear(&mut st, 5);
    rg_clear(&mut st, 6);
    rg_clear(&mut st, 7);
    rg_clear(&mut st, 8);
    rg_clear(&mut st, 9);
    return ();
}
