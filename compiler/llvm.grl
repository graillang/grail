// The identity a location holds a header of, plus one, looking one dereference through an address
// of a frame slot (`&v`, which is how a borrow reaches an accessor). 0 when it holds no header.
fn rg_hdr_of(rc: (&RC), st: (&u64[]), loc: u64) -> u64 {
    if loc == rg_none() {
        return 0;
    }
    if rg_k(&st, loc) == 2 {
        return rg_lo(&st, loc) + 1;
    }
    if rg_k(&st, loc) == 3 {
        sk := rg_lo(&st, loc);
        return rg_hdr_of(&rc, &st, 14 + sk);
    }
    return 0;
}
// The fact an operand carries. `ok` 1 is the interval [lo, hi], 2 a sequence header of identity
// `lo`, 3 the address of frame slot `lo`, 4 the length word of identity `lo`; 0 no fact.
fn rg_read(rc: (&RC), st: (&u64[]), op: (&[u8])) -> Span {
    if (op.len() != 0) && (op[0] == 36) {
        return rg_imm(op);
    }
    loc := rg_loc(&rc, op);
    if loc != rg_none() {
        k := rg_k(&st, loc);
        if k == 0 {
            return no_span();
        }
        return Span { ok: k, lo: rg_lo(&st, loc), hi: rg_hi(&st, loc), sym: rg_sym(&st, loc), sgen: rg_sgen(&st, loc) };
    }
    m := rg_mem(op);
    if m.ok == 0 {
        return no_span();
    }
    // A load through the address of a frame slot reads that slot's word - checked first, because
    // rg_hdr_of sees through such an address to the header the slot holds (right for an accessor's
    // `&v` argument), which would make `(%rax)` here look like the header's first field instead of
    // the header word itself, and lose the vector's identity on `p[i] = ...`.
    if (rg_k(&st, m.base) == 3) & (m.off == 0) {
        sk := rg_lo(&st, m.base);
