}
// One instruction's effect on the state.
fn rg_step(rc: (&RC), st: (&mut u64[]), line: (&[u8]), seed: u64, trip: u64, at: u64, pcmp: (&mut u64[]), prov: (&mut u64[]), snap: (&mut u64[]), out: (&mut u64[])) -> unit {
    mut space = line.len();
    for i in line.len() {
        if (line[i] == 32) & (space == line.len()) {
            space = i;
        }
    }
    mut op = sub(line, 0, space);
    rest := trim(view(sub(line, space + 1, line.len())));
    o := operands(view(rest));
    n := o.len();
    // A word a register was copied from, so a bound on the register bounds the slot as well: the
    // front end materialises every comparison into a 0/1 word and reloads its operands by the time
    // the branch runs, so this is the only place a loop guard survives.
    w := rg_written(&rc, line);
    if w != rg_none() {
        if 2 * w + 2 <= prov.len() {
            prov[2 * w] = 0;
            prov[2 * w + 1] = 0;
        }
    }

    if (eq(view(op), view("movq")) || eq(view(op), view("movabsq"))) && (n == 2) {
        rg_move(&rc, &mut st, view(o[0]), view(o[1]), 64);
        // `movq A,B` makes B the value of A: a bound on either is a bound on both until one of
        // them is written, which is how a loop counter reaches the guard through the temporaries
        // the front end copies it into.
        dloc := rg_loc(&rc, view(o[1]));
