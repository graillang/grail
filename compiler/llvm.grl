// The interval of an operand that has one.
struct Span {
    ok: u64,
    lo: u64,
    hi: u64,
    sym: u64,
    sgen: u64
}
fn no_span() -> Span {
    return Span { ok: 0, lo: 0, hi: 0, sym: 0, sgen: 0 };
}
// A decimal immediates's value as a word: a negative one keeps its bit pattern.
fn rg_imm(op: (&[u8])) -> Span {
    if (op.len() < 2) || (op[0] != 36) {
        return no_span();
    }
    mut i: u64 = 1;
    mut neg = 0;
    if op[i] == 45 {
        neg = 1;
        i += 1;
    }
    mut v: u64 = 0;
    mut any = 0;
    while i < op.len() {
        ch := op[i];
        if (ch < 48) || (ch > 57) {
            return no_span();
        }
        v = wrapping_add(wrapping_mul(v, 10), ch - 48);
        any = 1;
        i += 1;
    }
    if any == 0 {
        return no_span();
    }
    if neg != 0 {
        v = wrapping_mul(v, 18446744073709551615);
    }
    return Span { ok: 1, lo: v, hi: v, sym: 0, sgen: 0 };
