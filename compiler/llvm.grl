            mut set = copy(view(".set "));
            put(&mut set, view(sym));
            set.push(44);
            num(&mut set, f.frame);
            p.native.push(set);
        }
    }
    while l.lifted.len() > base_lifted {
        p.lifted.push(l.lifted.pop()!);
    }
    while l.calls.len() > base_calls {
        p.calls.push(l.calls.pop()!);
    }
    while l.refs.len() > base_refs {
        p.refs.push(l.refs.pop()!);
    }
    while l.addrs.len() > base_addrs {
        p.addrs.push(l.addrs.pop()!);
    }
    while l.wrong.len() > base_wrong {
        p.wrong.push(l.wrong.pop()!);
    }
    // Popped newest first: put each list back in the order it was made.
    reverse_texts(&mut p.lifted);
    reverse_texts(&mut p.calls);
    reverse_texts(&mut p.refs);
    reverse_texts(&mut p.addrs);
    return p;
}
fn reverse_texts<a>(v: (&a mut u8[][])) -> unit {
    mut i = 0;
    mut j = v.len();
    while i + 1 < j {
        j -= 1;
        a := exchange(&mut v[i], u8[]);
        b := exchange(&mut v[j], u8[]);
        v[i] = b;
        v[j] = a;
        i += 1;
    }
    return ();
}
fn lp_word<a>(out: (&a mut u8[]), n: u64) -> unit {
    mut v = n;
    for i in 8 {
        out.push(u8(v & 255));
        v = v >> 8;
    }
    return ();
}
fn lp_text<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    lp_word(&mut out, text.len());
    out.append(text);
    return ();
}
fn lp_texts<a>(out: (&a mut u8[]), list: (&a u8[][])) -> unit {
    lp_word(&mut out, list.len());
    for i in list.len() {
        lp_text(&mut out, view(list[i]));
    }
    return ();
}
fn lp_take<a, b>(from: &a [u8], at: (&b mut u64)) -> u64 {
    mut v: u64 = 0;
    mut shift: u64 = 0;
    for i in 8 {
        v = v | (u64(from[*at + i]) << shift);
        shift += 8;
    }
    exchange(at, *at + 8);
    return v;
}
fn lp_take_text<a, b>(from: &a [u8], at: (&b mut u64)) -> u8[] {
    n := lp_take(from, at);
    mut out = u8[];
    if n != 0 {
        out.append(from[*at..*at + n]);
    }
    exchange(at, *at + n);
    return out;
}
fn lp_take_texts<a, b>(from: &a [u8], at: (&b mut u64)) -> u8[][] {
    n := lp_take(from, at);
    mut out = u8[][];
    for i in n {
        out.push(lp_take_text(from, at));
    }
