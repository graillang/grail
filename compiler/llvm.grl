// register -- the frame slots whose address escaped, which are the only ones such a store reaches.
fn rg_wrote(rc: (&RC), st: (&mut u64[]), op: (&[u8])) -> unit {
    loc := rg_loc(&rc, op);
    if loc != rg_none() {
        rg_clear(&mut st, loc);
        return ();
    }
    m := rg_mem(op);
    if m.ok == 0 {
        return ();
    }
    if rg_k(&st, m.base) == 6 {
        // A store into a sequence element (`p[i] = ...`) reaches heap element storage only.
        return ();
    }
    if rg_k(&st, m.base) == 3 {
        rg_clear(&mut st, 14 + rg_lo(&st, m.base));
