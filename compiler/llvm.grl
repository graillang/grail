module llvm;
use machine;
use jobs;
use host;

// LLVM lowering of the compiler's closed word-machine stream (docs/design/llvm-backend.md).
// The raw x86-64-spelled stream (before optimize.grl) becomes LLVM IR for every function whose
// instructions are all understood here; the rest of the stream (data, the entry, functions that
// switch stacks or use %rsp, C calls through a pointer, functions whose labels data refers to) stays native
// assembly. Machine registers, flags and the frame become allocas that mem2reg/SROA promote.
// A Grail-internal call passes exactly the callee's argument words and returns one word or the
// rax:rdx pair, as its signature fact says (six words and the pair without one); check failures
// call a noreturn cold stub so LLVM keeps them off the hot path.

// `native` is still the word-machine spelling (machine.grl lowers it for AArch64 and RISC-V);
// `thunks` is target assembly joining the two calling conventions on those targets.
pub struct Lowered {
    ir: u8[],
    native: u8[],
    thunks: u8[],
    // --verify-facts: what was found wrong with the facts (the compile fails); empty otherwise.
    error: u8[],
    // The bodies whose signature fact this lowering proved wrong (see lower_target).
    wrong: u8[][]
}

// One typed-IR fact (docs/design/typed-ir.md), carried beside the word stream by the front end.
// The stream itself is unchanged: an absent fact means today's word lowering. F2 is `what` 1 (a
// slot) and 7 (a call); F1 is `what` 2/3/4 (a vector header of element width 8/4/1) and 5 (a
// descriptor `{data, len}`, whose `+16` is uninitialised and whose `cap` must never be read).
pub struct Fact {
    // 0 frame slot, 1 call argument, 3 `DynPair` slot, 4 two-word dyn result.
    kind: u64,
    // Body symbol of the function the fact is about, as emitted in the stream.
    fn: u8[],
    // kind 0: the frame slot index (slot k covers [-8(k+1), -8k) below rbp).
    // kind 1: the ordinal of the call to `callee` inside `fn` (0-based, in emission order).
    a: u64,
    // kind 1: the argument index. Unused for kind 0.
    b: u64,
    // kind 1: the callee symbol.
    callee: u8[],
    // 0 not a typed value, 1 f32, 2 vector header of element width 8, 3 of width 4, 4 of width 1,
    // 5 descriptor {data, len} (a view or slice), 7 float arithmetic on two f32 operands (kind 1).
    what: u64,
    // kind 0: the slot's declared width in bytes (4 for an f32 slot).
    // kind 1: the opcode the call performs (42 `*`, 43 `+`, 45 `-`, 47 `/`).
    width: u64
}
// The table itself. The front end owns one for the whole compile and fills it where it knows a
// type; the lifter reads it per function beside the word stream.
pub struct Facts {
    items: Fact[]
}
pub fn facts_new() -> Facts {
    return Facts { items: Fact[] };
}
// `slot` is the first word of a `DynPair` in `name`: 16 bytes, 8-aligned, word 0 the data pointer
// of a borrowed interface object and word 1 its vtable (docs/design/fat-dyn.md). The front end
// produces one where a `&dyn I` is built, and both backends read it here: a two-word frame value is
// a fact about a declared type, not a directive in the instruction stream.
pub fn fact_dyn_pair<a>(facts: (&a mut Facts), name: u8[], slot: u64) -> unit {
    facts.items.push(Fact { kind: 3, fn: name, a: slot, b: 0, callee: u8[], what: 0, width: 0 });
    return ();
}
// `name` returns a borrowed interface object: the pair travels back as the two words of a 16-byte
// {ptr, ptr} aggregate, so the second result word is live at the `ret`.
pub fn fact_dyn_result<a>(facts: (&a mut Facts), name: u8[]) -> unit {
    facts.items.push(Fact { kind: 4, fn: name, a: 0, b: 0, callee: u8[], what: 0, width: 0 });
    return ();
}
// `slot` is word 0 of an aggregate of `words` words in `name`: a plain record kept in the frame
// (docs/design/unboxed-values.md, stage 3a). Word i is slot `slot - i`, at `8*i` above word 0, the
// same shape as a `DynPair`, which is the two-word case; both are one object to every pass.
pub fn fact_aggregate<a>(facts: (&a mut Facts), name: u8[], slot: u64, words: u64) -> unit {
    facts.items.push(Fact { kind: 3, fn: name, a: slot, b: 0, callee: u8[], what: 0, width: words });
    return ();
}
// The words of each multi-word frame value of `name`, in the order facts_dyn_pairs gives their slots:
// 2 for a `DynPair` (its fact leaves the width 0), the declared count for an aggregate.
pub fn facts_pair_widths<a, b, d>(facts: (&a Facts), name: &b [u8], out: (&d mut u64[])) -> unit {
    for i in facts.items.len() {
        f := &facts.items[i];
        if (f.kind == 3) & eq(view(f.fn), name) {
            if f.width == 0 {
                out.push(2);
            } else {
                out.push(f.width);
            }
        }
    }
    return ();
}
// The `DynPair` slots of `name` (each the first word's slot), appended to `out`.
pub fn facts_dyn_pairs<a, b, d>(facts: (&a Facts), name: &b [u8], out: (&d mut u64[])) -> unit {
    for i in facts.items.len() {
        f := &facts.items[i];
        if (f.kind == 3) & eq(view(f.fn), name) {
            out.push(f.a);
        }
    }
    return ();
}
// The signature of the body `name`: it takes `words` argument words (the six argument registers'
// worth at most; a call with more passes its tail in a record behind the sixth). The lifter gives
// the body exactly that many parameters and every call to it exactly that many arguments, and the
// result is one word unless a `dyn_result` fact makes it two. A fact that is too small is caught
// where the body reads an argument register past it before writing it (`sig_prologue`), and a
// result that is wider than the fact where a caller reads `%rdx` after the call (`rdx_dead`).
pub fn fact_signature<a>(facts: (&a mut Facts), name: u8[], words: u64) -> unit {
    facts.items.push(Fact { kind: 5, fn: name, a: words, b: 0, callee: u8[], what: 0, width: 0 });
    return ();
}
// The `ord`-th `call *%rax` of the body `name` passes `words` argument words (native.grl
// indirect_fact); the lifter passes `poison` for the other argument registers of the six-word form.
pub fn fact_indirect<a>(facts: (&a mut Facts), name: u8[], ord: u64, words: u64) -> unit {
    facts.items.push(Fact { kind: 7, fn: name, a: ord, b: words, callee: u8[], what: 0, width: 0 });
    return ();
}
// The C function `name` takes `ints` integer words and `floats` float arguments (bit k of `mask`
// set when the k-th is an f32) and returns `result` (0 a word or nothing, 1 f64, 2 f32): native.grl
// `ffi_signature_fact`. A lifted call to it is typed accordingly (lower_call, call ABI S8a).
pub fn fact_ffi<a>(facts: (&a mut Facts), name: u8[], ints: u64, floats: u64, mask: u64, result: u64) -> unit {
    facts.items.push(Fact { kind: 6, fn: name, a: ints, b: floats, callee: u8[], what: mask, width: result });
    return ();
}
// `slot` holds an f32 when `f32` is 1, and an untyped word otherwise.
pub fn fact_slot<a>(facts: (&a mut Facts), name: u8[], slot: u64, f32: u64) -> unit {
    mut width: u64 = 8;
    if f32 != 0 {
        width = 4;
    }
    facts.items.push(Fact { kind: 0, fn: name, a: slot, b: 0, callee: u8[], what: f32, width: width });
    return ();
}
// The call to `rt_f64_op` `ordinal` in `name` computes `op` on two f32 operands.
pub fn fact_op<a>(facts: (&a mut Facts), name: u8[], ordinal: u64, op: u64) -> unit {
    facts.items.push(Fact { kind: 1, fn: name, a: ordinal, b: 0, callee: copy(view("rt_f64_op")), what: 7, width: op });
    return ();
}
// F1: slot `slot` of `name` holds a pointer to a sequence header (`what` 2/3/4 for a vector of
// element width 8/4/1, 5 for a descriptor) whose elements are `width` bytes wide.
pub fn fact_header_slot<a>(facts: (&a mut Facts), name: u8[], slot: u64, what: u64, width: u64) -> unit {
    facts.items.push(Fact { kind: 0, fn: name, a: slot, b: 0, callee: u8[], what: what, width: width });
    return ();
}
// F1: argument 0 of the `ordinal`-th call to `callee` in `name` is a sequence header, same `what`
// and `width` encoding as `fact_header_slot`.
pub fn fact_header_arg<a>(facts: (&a mut Facts), name: u8[], ordinal: u64, callee: u8[], what: u64, width: u64) -> unit {
    facts.items.push(Fact { kind: 1, fn: name, a: ordinal, b: 0, callee: callee, what: what, width: width });
    return ();
}
// Parameter `index` of the function whose body symbol is `name` is a shared reference (`&T`): the
// function cannot write the referent, so a caller's frame slot whose address it is given keeps
// its contents across the call (range facts, rg_mut_escape).
pub fn fact_shared_param<a>(facts: (&a mut Facts), name: u8[], index: u64) -> unit {
    facts.items.push(Fact { kind: 2, fn: name, a: index, b: 0, callee: u8[], what: 8, width: 0 });
    return ();
}
pub fn facts_len<a>(facts: (&a Facts)) -> u64 {
    return facts.items.len();
}

// Field readers for a consumer that needs the whole table (the typed IR indexes it by body symbol
// once per compile, so a slot lookup is a bucket scan instead of a scan of every fact). The
// lifter itself reads the fields directly; these exist so the table can be walked without
// exposing `items`.
// Everything fact `i` says except which body it is about, as one number: what a cache of a body's
// optimised text is keyed by, with the body's own text (optimize.grl, the body memo).
pub fn fact_digest<a>(facts: (&a Facts), i: u64) -> u64 {
    f := &facts.items[i];
    mut h: u64 = wrapping_mul(14695981039346656037 ^ f.kind, 1099511628211);
    h = wrapping_mul(h ^ f.a, 1099511628211);
    h = wrapping_mul(h ^ f.b, 1099511628211);
    h = wrapping_mul(h ^ f.what, 1099511628211);
    h = wrapping_mul(h ^ f.width, 1099511628211);
    for j in f.callee.len() {
        h = wrapping_mul(h ^ u64(f.callee[j]), 1099511628211);
    }
    return h;
}
pub fn fact_kind<a>(facts: (&a Facts), i: u64) -> u64 {
    f := &facts.items[i];
    return f.kind;
}
pub fn fact_slot_at<a>(facts: (&a Facts), i: u64) -> u64 {
    f := &facts.items[i];
    return f.a;
}
pub fn fact_what<a>(facts: (&a Facts), i: u64) -> u64 {
    f := &facts.items[i];
    return f.what;
}
pub fn fact_width<a>(facts: (&a Facts), i: u64) -> u64 {
    f := &facts.items[i];
    return f.width;
}
pub fn fact_name_len<a>(facts: (&a Facts), i: u64) -> u64 {
    f := &facts.items[i];
    return f.fn.len();
}
pub fn fact_name_byte<a>(facts: (&a Facts), i: u64, j: u64) -> u64 {
    f := &facts.items[i];
    return f.fn[j];
}
pub fn fact_arg_b<a>(facts: (&a Facts), i: u64) -> u64 {
    f := &facts.items[i];
    return f.b;
}
pub fn fact_callee_len<a>(facts: (&a Facts), i: u64) -> u64 {
    f := &facts.items[i];
    return f.callee.len();
}
pub fn fact_callee_byte<a>(facts: (&a Facts), i: u64, j: u64) -> u64 {
    f := &facts.items[i];
    return f.callee[j];
}
// A fact put back exactly as it was recorded: the per-function codegen cache stores the facts a
// body's emission produced and appends them again when the body is replayed, so the table a
// replayed module hands the optimizer and the lifter is the table a fresh emission would have
// built (docs/design/incremental-compilation.md, "Per-function units"). The other pushers derive
// a fact from what the front end knows at one site; this one is the record itself.
pub fn fact_restore<a>(facts: (&a mut Facts), kind: u64, name: u8[], a: u64, b: u64, callee: u8[], what: u64, width: u64) -> unit {
    facts.items.push(Fact { kind: kind, fn: name, a: a, b: b, callee: callee, what: what, width: width });
    return ();
}

// --verify-facts writes the table into the module as comments, so a test can see exactly which
// slots and which calls the lowering typed without reading the compiler's memory.
fn dump_facts<a>(out: (&a mut u8[]), facts: (&a Facts)) -> unit {
    for i in facts.items.len() {
        f := &facts.items[i];
        put(&mut out, view("; fact "));
        put(&mut out, view(f.fn));
        if f.kind == 2 {
            // A shared-reference parameter (fact_shared_param): not a type fact.
            put(&mut out, view(" param "));
            num(&mut out, f.a);
            put(&mut out, view(" shared\n"));
            continue;
        }
        if f.kind == 3 {
            put(&mut out, view(" dyn_pair "));
            num(&mut out, f.a);
            out.push(10);
            continue;
        }
        if f.kind == 4 {
            put(&mut out, view(" dyn_result\n"));
            continue;
        }
        if f.kind == 5 {
            put(&mut out, view(" signature "));
            num(&mut out, f.a);
            out.push(10);
            continue;
        }
        if f.kind == 7 {
            put(&mut out, view(" indirect "));
            num(&mut out, f.a);
            put(&mut out, view(" words "));
            num(&mut out, f.b);
            out.push(10);
            continue;
        }
        if f.kind == 6 {
            put(&mut out, view(" ffi ints "));
            num(&mut out, f.a);
            put(&mut out, view(" floats "));
            num(&mut out, f.b);
            out.push(10);
            continue;
        }
        if f.kind == 0 {
            put(&mut out, view(" slot "));
        } else {
            put(&mut out, view(" call "));
            put(&mut out, view(f.callee));
            out.push(44);
            num(&mut out, f.b);
            put(&mut out, view(" ordinal "));
        }
        num(&mut out, f.a);
        put(&mut out, view(" what "));
        num(&mut out, f.what);
        put(&mut out, view(" width "));
        num(&mut out, f.width);
        out.push(10);
    }
    return ();
}
// Drops the facts of a function attempt the front end threw away.
pub fn facts_truncate<a>(facts: (&a mut Facts), n: u64) -> unit {
    while n < facts.items.len() {
        facts.items.pop()!;
    }
    return ();
}

struct Func {
    name: u8[],
    first: u64,
    end: u64,
    frame: u64,
    framed: u64
}

struct L {
    // 0 x86-64, 1 AArch64, 2 RISC-V 64 (the native backend's numbering).
    target: u64,
    ir: u8[],
    body: u8[],
    fail: u64,
    t: u64,
    dead: u64,
    term: u64,
    labels: Set,
    calls: u8[][],
    // Symbols whose address is taken (`sym(%rip)` operands).
    addrs: u8[][],
    refs: u8[][],
    lifted: u8[][],
    flags: u64,
    frame: u64,
    // 1 when every frame access is a constant negative offset from rbp: each 8-byte slot is then
    // its own alloca, so borrowing one local does not make the whole frame escape.
    split: u64,
    // The `DynPair`s of the function being lowered, as their first word's slot: word 1 is the slot
    // above it (`8(%base)`), and the two are one `[2 x i64]` alloca. They come from the typed-IR
    // facts (docs/design/fat-dyn.md), so what the front end built a pair for is not re-derived from
    // the shape of the stream.
    pairs: u64[],
    // The word count of each entry of `pairs`.
    pair_widths: u64[],
    // Accepted f32 slot facts of the function being lowered: every slot in here is emitted as
    // `alloca float` and read and written with `load float`/`store float` (docs/design/typed-ir.md).
    fslots: u64[],
    // Per `rt_f64_op` call in the function being lowered, indexed by its ordinal: 0 when the call
    // has no fact, else the opcode (42, 43, 45, 47) the call performs on two f32 operands.
    fops: u64[],
    // F1, accepted header facts of the function being lowered: `hslots[i]` is a frame slot whose
    // word points at a sequence header, `hwhat[i]` is 2/3/4 (a vector of element width 8/4/1, so
    // `cap` at +16 is valid) or 5 (a descriptor {data, len}, whose +16 is uninitialised and must
    // never be read), and `hwidth[i]` is the element width in bytes.
    hslots: u64[],
    hwhat: u64[],
    hwidth: u64[],
    // The established `data`/`len` of each accepted header slot: `eon[k]` is 0 when the header has
    // been rewritten since it was read (any call that receives it and is not a read-only accessor),
    // else the two SSA words loaded where the fact was established -- the hoist
    // docs/design/typed-ir.md asks for, executed once on the path that establishes it.
    eon: u64[],
    edata: u8[][],
    elen: u8[][],
    // The same `data` as a `ptr` (loaded as one), so an element address can be a `getelementptr`
    // with the allocation's provenance rather than an integer sum the optimiser cannot see through.
    edptr: u8[][],
    // The block a set of fields was established in, and 1 when that block dominates every later
    // one (the entry block and its fall-through continuations, which have a single predecessor
    // each). The hoisted words are reused only where they are known to dominate the use.
    eblk: u64[],
    blk: u64,
    // The id of the `body` block: the first block of the function's own code, which dominates
    // every block of it.
    body_blk: u64,
    // Block names in the order `begin_block` first saw them. A hoisted `data`/`len` is reused only
    // in the block that established it: that is the one placement the lifter can prove, and the
    // cross-block hoist needs the region fact docs/design/typed-ir.md describes.
    dnames: u8[][],
    // dnames by name, so finding a block's id is one probe rather than a walk of every block so far.
    dmap: Map,
    // The F1 call facts of the function being lowered, by `callee#ordinal`: the fact index plus one.
    hmap: Map,
    // cnames by name (callee_ordinal).
    cmap: Map,
    // The lines of the function being lowered that name each frame slot `-N(%rbp)`: those of slot k
    // are `sl_lines[sl_start[k] .. sl_start[k + 1]]`, in order, each line once. The per-slot
    // questions read these instead of searching every line for every slot.
    sl_start: u64[],
    sl_lines: u64[],
    // Per storage location (0-13 a register, 14+k frame slot k): `vk` is 0 for an untracked word,
    // 1 for the header pointer of slot `vo` at byte offset `vo2`, 2 for the constant `vo`.
    vk: u64[],
    vo: u64[],
    vo2: i64[],
    // F1 facts on calls, indexed by the ordinal of the call to that callee: the element width when
    // argument 0 is a header (0 otherwise) and its `what`.
    hcall: u64[],
    hcallwhat: u64[],
    // The accepted header slots (parallel to hslots) that are stable for the whole function: a
    // slice descriptor (`what` 5) written exactly once and never addressed, so the fields read where
    // that one write happens in the first block are current everywhere after it.
    hstable: u64[],
    // The accepted header slots (parallel to hslots) whose address the body takes (`leaq` of the
    // slot: `&v`, `&mut v`). Any call may then reach the header through that address, so every
    // call that is not known to leave headers alone makes their fields stale.
    hesc: u64[],
    // Sibling mode: 0 normally, else the element width of the typed header parameter this body is
    // being re-emitted with, the `what` of that fact, and the two incoming words for the header
    // fields at `+0` and `+8` in place of the loads.
    sibwhat: u64,
    sibwidth: u64,
    sd: u8[],
    sl: u8[],
    // Body symbol of the function being lowered, which keys the fact table.
    fname: u8[],
    // Siblings built for this function's fact-carrying calls (`sibnames`), and their bodies, in
    // the same order. A fact is only used when its sibling exists.
    sibnames: u8[][],
    sibbodies: u8[][],
    // Per-callee call counters, the ordinal a call fact is keyed by.
    cnames: u8[][],
    ccount: u64[],
    // Ordinal of the next `call rt_f64_op` in the function being lowered.
    fordinal: u64,
    // One range-fact verdict per instruction line of the function being lowered (see range_proofs),
    // and the line the instruction being lowered came from.
    proof: u64[],
    rline: u64,
    // 1 with --range-facts: derive range facts from the stream and remove the bounds check a fact
    // proves redundant. Off by default: the pass does not pay for itself on the corpus yet
    // (docs/design/typed-ir.md), and it costs compile time.
    ranges: u64,
    // 1 with --verify-facts: check `fpext(fptrunc(d)) == d` at every word that a fact treats as
    // an f32, so a mis-typed fact aborts instead of silently changing a value.
    verify: u64,
    // Every body's signature fact, name -> `sig_code(words, result words)` (see fact_signature).
    sigs: Set,
    // The function being lowered: its argument words and result words (6 and 2 with no fact).
    nargs: u64,
    retw: u64,
    // 1 after a call whose result is one word, until `%rdx` is written or a block begins: a read
    // of it then means the fact understated the result.
    rdxdead: u64,
    rdxcallee: u8[],
    // --verify-facts: the instruction being lowered, for the message of a wrong fact.
    curline: u8[],
    // Why a signature fact was found wrong in this function (empty when none was).
    sigerr: u8[],
    // Every body whose signature fact was found wrong in this lowering.
    wrong: u8[][],
    // The outgoing argument area of the call being set up (area_instruction).
    area: u8[][],
    areaopen: u64,
    // The argument registers written since the last call (lower_indirect_call's check).
    argwritten: u64,
    // The FFI facts (ffi_signatures).
    ffis: Set,
    // Vector registers written and not read since (a pending float argument), and ones not written
    // since the entry or the last call (xmm_read).
    xpend: u64,
    xstale: u64
}

fn eq<a, b>(a: &a [u8], b: &b [u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}
fn starts<a, b>(a: &a [u8], b: &b [u8]) -> bool {
    if a.len() < b.len() {
        return false;
    }
    for i in b.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}
fn ends<a, b>(a: &a [u8], b: &b [u8]) -> bool {
    if a.len() < b.len() {
        return false;
    }
    off := a.len() - b.len();
    for i in b.len() {
        if a[off + i] != b[i] {
            return false;
        }
    }
    return true;
}
// Whether `b` occurs in `a` at offset `at`.
fn occurs_at<a, b>(a: &a [u8], at: u64, b: &b [u8]) -> bool {
    for k in b.len() {
        if a[at + k] != b[k] {
            return false;
        }
    }
    return true;
}
fn has<a, b>(a: &a [u8], b: &b [u8]) -> bool {
    if a.len() < b.len() {
        return false;
    }
    if b.len() == 0 {
        return true;
    }
    first := b[0];
    for i in a.len() - b.len() + 1 {
        if (a[i] == first) && occurs_at(a, i, b) {
            return true;
        }
    }
    return false;
}
// The lifter builds its whole output with these, so they copy in bulk rather than a byte at a time.
fn put<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    out.append(s);
    return ();
}
fn num<a>(out: (&a mut u8[]), n: u64) -> unit {
    if n >= 10 {
        num(&mut out, n / 10);
    }
    out.push(48 + n % 10);
    return ();
}
fn inum<a>(out: (&a mut u8[]), n: i64) -> unit {
    if n < 0 {
        out.push(45);
        // |n| without overflowing at the most negative value.
        num(&mut out, u64(0 - (n + 1)) + 1);
        return ();
    }
    num(&mut out, u64(n));
    return ();
}
fn copy<a>(s: &a [u8]) -> u8[] {
    mut out = u8[];
    out.append(s);
    return out;
}
fn member<a, b>(list: (&a u8[][]), s: &b [u8]) -> bool {
    for i in list.len() {
        if eq(view(list[i]), s) {
            return true;
        }
    }
    return false;
}
fn add_once<a, b>(list: (&a mut u8[][]), s: &b [u8]) -> unit {
    if !member(&list, s) {
        list.push(copy(s));
    }
    return ();
}
fn trim<a>(s: &a [u8]) -> u8[] {
    mut a: u64 = 0;
    mut b = s.len();
    while a < b && (s[a] == 32 || s[a] == 9) {
        a += 1;
    }
    while b > a && (s[b - 1] == 32 || s[b - 1] == 9 || s[b - 1] == 13) {
        b -= 1;
    }
    mut out = u8[];
    if a < b {
        out.append(s[a: b]);
    }
    return out;
}
fn sub<a>(s: &a [u8], from: u64, to: u64) -> u8[] {
    mut out = u8[];
    mut e = to;
    if s.len() < e {
        e = s.len();
    }
    if from < e {
        out.append(s[from: e]);
    }
    return out;
}
// The lines of `s`, each trimmed as `trim` does, copied once.
fn split_lines<a>(s: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut start: u64 = 0;
    for i in s.len() + 1 {
        if (i == s.len()) || (s[i] == 10) {
            if (i == s.len()) && (start >= s.len()) {
                break;
            }
            mut a = start;
            mut b = i;
            while a < b && (s[a] == 32 || s[a] == 9) {
                a += 1;
            }
            while b > a && (s[b - 1] == 32 || s[b - 1] == 9 || s[b - 1] == 13) {
                b -= 1;
            }
            mut line = u8[];
            if a < b {
                line.append(s[a: b]);
            }
            out.push(line);
            start = i + 1;
        }
    }
    return out;
}
// A decimal (optionally negative) integer; ok is 0 when `s` is not one.
struct Int {
    ok: u64,
    v: i64
}
fn parse_int<a>(s: &a [u8]) -> Int {
    if s.len() == 0 {
        return Int { ok: 0, v: 0 };
    }
    mut i: u64 = 0;
    mut neg = 0;
    if s[0] == 45 {
        neg = 1;
        i = 1;
    }
    if i == s.len() {
        return Int { ok: 0, v: 0 };
    }
    mut v: u64 = 0;
    mut ok: u64 = 1;
    while i < s.len() {
        ch := s[i];
        if ch < 48 || ch > 57 {
            ok = 0;
        } else {
            v = wrapping_add(wrapping_mul(v, 10), ch - 48);
        }
        i += 1;
    }
    // Words at or above 2^63 keep their bit pattern: LLVM spells them as negative i64 constants.
    mut signed: i64 = 0;
    if v >= 9223372036854775808 {
        signed = 0 - i64(18446744073709551615 - v) - 1;
    } else {
        signed = i64(v);
    }
    if neg != 0 {
        return Int { ok: ok, v: 0 - signed };
    }
    return Int { ok: ok, v: signed };
}
// `name:` (or `name: directive`) -> name, else empty.
fn label_of<a>(line: &a [u8]) -> u8[] {
    // Found first, copied once: this is asked of every line of every function.
    mut out = u8[];
    for i in line.len() {
        ch := line[i];
        if ch == 58 {
            if i != 0 {
                out.append(line[0: i]);
            }
            return out;
        }
        if !ident_char(ch) {
            return out;
        }
    }
    return out;
}
fn is_local_label<a>(name: &a [u8]) -> bool {
    return starts(name, view(".L"));
}

// ---- function splitting ----

// The stream's text functions: a non-.L label in .text up to its `.set .Fn,SIZE` (or the next
// label or section change for frameless functions). Pushed sections (`.pushsection` ...
// `.popsection`: constant pools, statics) are moved to the data lines.
fn split<a>(lines: (&a u8[][]), funcs: (&a mut Func[]), data: (&a mut u8[][])) -> unit {
    mut text = 1;
    mut open = 0;
    mut pool = false;
    for i in lines.len() {
        line := view(lines[i]);
        if eq(line, view(".text")) {
            text = 1;
        }
        if starts(line, view(".section")) || eq(line, view(".data")) || eq(line, view(".bss")) {
            text = 0;
            if open != 0 {
                last := funcs.len() - 1;
                funcs[last].end = i;
                open = 0;
            }
        }
        // A pushed section is data wherever it appears: inside a function (a constant pool) or
        // between two (a static's storage, whose label must not open a function).
        if pool || starts(line, view(".pushsection")) {
            if starts(line, view(".pushsection")) {
                pool = true;
                mut d = u8[];
                put(&mut d, view(".section"));
                put(&mut d, view(sub(line, 12, line.len())));
                data.push(d);
                continue;
            }
            if starts(line, view(".popsection")) {
                pool = false;
                continue;
            }
            data.push(copy(line));
            continue;
        }
        name := label_of(line);
        if text != 0 && name.len() != 0 && name.len() + 1 == line.len() && !is_local_label(view(name)) {
            if open != 0 {
                last := funcs.len() - 1;
                funcs[last].end = i;
            }
            funcs.push(Func { name: name, first: i + 1, end: i + 1, frame: 0, framed: 0 });
            open = 1;
            continue;
        }
        if open != 0 {
            if starts(line, view(".set .F")) {
                // `.set .Fn,SIZE`
                mut comma = 0;
                for k in line.len() {
                    if line[k] == 44 {
                        comma = k;
                    }
                }
                size := parse_int(view(sub(line, comma + 1, line.len())));
                last := funcs.len() - 1;
                funcs[last].frame = u64(size.v);
                funcs[last].framed = 1;
                funcs[last].end = i;
                open = 0;
            }
            continue;
        }
        data.push(copy(line));
    }
    if open != 0 {
        last := funcs.len() - 1;
        funcs[last].end = lines.len();
    }
    return ();
}

// ---- IR emission helpers ----

// One body line from a template: each `{}` takes the next argument.
fn emit<a, b, c>(l: (&a mut L), tmpl: &b [u8], args: (&c u8[][])) -> unit {
    l.body.push(32);
    l.body.push(32);
    expand_into(&mut l.body, tmpl, &args);
    l.body.push(10);
    return ();
}
fn raw_line<a, b>(l: (&a mut L), s: &b [u8]) -> unit {
    put(&mut l.body, s);
    l.body.push(10);
    return ();
}
fn tmp<a>(l: (&a mut L)) -> u8[] {
    l.t += 1;
    mut out = u8[];
    put(&mut out, view("%t"));
    num(&mut out, l.t);
    return out;
}
// %v = <tmpl with args>; returns %v.
fn def<a, b, c>(l: (&a mut L), tmpl: &b [u8], args: (&c u8[][])) -> u8[] {
    v := tmp(&mut l);
    // `  %tN = <tmpl with args>`, written straight into the body: what `emit` of the joined template
    // would write, without building the joined template first.
    l.body.push(32);
    l.body.push(32);
    l.body.append(view(v));
    l.body.append(view(" = "));
    expand_into(&mut l.body, tmpl, &args);
    l.body.push(10);
    return v;
}
// `tmpl` with each `{}` replaced by the next of `args`, appended to `out`.
fn expand_into<a, b, c>(out: (&a mut u8[]), tmpl: &b [u8], args: (&c u8[][])) -> unit {
    mut k: u64 = 0;
    mut i: u64 = 0;
    mut run: u64 = 0;
    while i < tmpl.len() {
        if (tmpl[i] == 123) & (i + 1 < tmpl.len()) {
            if tmpl[i + 1] == 125 {
                if run < i {
                    out.append(tmpl[run: i]);
                }
                out.append(view(args[k]));
                k += 1;
                i += 2;
                run = i;
                continue;
            }
        }
        i += 1;
    }
    if run < tmpl.len() {
        out.append(tmpl[run: tmpl.len()]);
    }
    return ();
}
fn bad<a>(l: (&a mut L)) -> unit {
    l.fail = 1;
    return ();
}

// Registers: the fourteen integer registers by canonical name, with 32- and 8-bit aliases
// (eax/al, sil/dil, r8d/r8b, ...). Compared byte by byte: this runs for every register operand.
fn legacy_base(c: u64) -> bool {
    // a, b, c, d -> rax, rbx, rcx, rdx
    return (c == 97) || (c == 98) || (c == 99) || (c == 100);
}
fn reg_name<a>(name: &a [u8]) -> u8[] {
    n := name.len();
    if (n == 3) && (name[0] == 114) && (name[2] == 120) && legacy_base(name[1]) {
        return copy(name);
    }
    if n == 3 && name[0] == 114 && (name[1] == 115 || name[1] == 100) && name[2] == 105 {
        return copy(name);
    }
    if (n == 2) && (name[0] == 114) && (name[1] >= 56) && (name[1] <= 57) {
        return copy(name);
    }
    if (n == 3) && (name[0] == 114) && (name[1] == 49) && (name[2] >= 48) && (name[2] <= 53) {
        return copy(name);
    }
    if (n == 3) && (name[0] == 101) && (name[2] == 120) && legacy_base(name[1]) {
        mut out = copy(view("r"));
        out.push(name[1]);
        out.push(120);
        return out;
    }
    if n == 3 && name[0] == 101 && (name[1] == 115 || name[1] == 100) && name[2] == 105 {
        mut out = copy(view("r"));
        out.push(name[1]);
        out.push(105);
        return out;
    }
    if (n == 2) && (name[1] == 108) && legacy_base(name[0]) {
        mut out = copy(view("r"));
        out.push(name[0]);
        out.push(120);
        return out;
    }
    if n == 3 && (name[0] == 115 || name[0] == 100) && name[1] == 105 && name[2] == 108 {
        mut out = copy(view("r"));
        out.push(name[0]);
        out.push(105);
        return out;
    }
    if n >= 3 && name[0] == 114 && (name[n - 1] == 100 || name[n - 1] == 98) {
        base := sub(name, 0, n - 1);
        if reg_width(view(base)) == 64 {
            if reg_name(view(base)).len() != 0 {
                return base;
            }
        }
    }
    return u8[];
}
fn reg_width<a>(name: &a [u8]) -> u64 {
    n := name.len();
    if (n == 3) && (name[0] == 101) {
        return 32;
    }
    if (n == 2) && (name[1] == 108) {
        return 8;
    }
    if (n == 3) && (name[2] == 108) && (name[1] == 105) {
        return 8;
    }
    if (n >= 3) && (name[0] == 114) && (name[1] >= 48) && (name[1] <= 57) {
        if name[n - 1] == 100 {
            return 32;
        }
        if name[n - 1] == 98 {
            return 8;
        }
    }
    return 64;
}
// Lifted calls carry integer words only, so a C call that passes or returns a float in a vector
// register cannot be lifted (cbstk-callback-stack-arguments: `caller`'s f64 result in %xmm0 was
// read from a register no call had written). Grail's own float code moves every vector value back
// to an integer register before a call. So: a vector register written and not read again before a
// call is a float argument, and one read before it is written - after a call, or at the entry - is a
// float result or parameter; either keeps the body native.
fn xmm_bit<a>(name: &a [u8]) -> u64 {
    mut n = 0;
    for i in name.len() - 3 {
        n = n * 10 + u64(name[3 + i]) - 48;
    }
    return 1 << (n & 31);
}
fn xmm_read<a, b>(l: (&a mut L), name: &b [u8]) -> unit {
    b := xmm_bit(name);
    if (l.xstale & b) != 0 {
        bad(&mut l);
    }
    l.xpend = l.xpend & (18446744073709551615 - b);
    return ();
}
fn xmm_written<a, b>(l: (&a mut L), name: &b [u8]) -> unit {
    b := xmm_bit(name);
    l.xstale = l.xstale & (18446744073709551615 - b);
    l.xpend = l.xpend | b;
    return ();
}
// At a call: no float argument may be pending, and after it every vector register is stale.
fn xmm_call<a>(l: (&a mut L)) -> unit {
    if l.xpend != 0 {
        bad(&mut l);
    }
    l.xpend = 0;
    l.xstale = 18446744073709551615;
    return ();
}
fn is_xmm<a>(name: &a [u8]) -> bool {
    return starts(name, view("xmm"));
}
fn slot_of<a>(kind: &a [u8], name: &a [u8]) -> u8[] {
    mut out = u8[];
    put(&mut out, kind);
    put(&mut out, name);
    return out;
}
fn get_reg<a, b>(l: (&a mut L), name: &b [u8]) -> u8[] {
    r := reg_name(name);
    if r.len() == 0 {
        bad(&mut l);
        return copy(view("0"));
    }
    if (l.rdxdead != 0) && eq(view(r), view("rdx")) {
        mut why = copy(view("it gives a one-word result and "));
        put(&mut why, view(l.fname));
        put(&mut why, view(" reads %rdx after calling it"));
        callee := copy(view(l.rdxcallee));
        sig_wrong(&mut l, view(callee), view(why));
    }
    v := def(&mut l, view("load i64, ptr {}"), &u8[][slot_of(view("%r."), view(r))]);
    w := reg_width(name);
    if w == 32 {
        return def(&mut l, view("and i64 {}, 4294967295"), &u8[][v]);
    }
    if w == 8 {
        return def(&mut l, view("and i64 {}, 255"), &u8[][v]);
    }
    return v;
}
fn set_reg<a, b, c>(l: (&a mut L), name: &b [u8], value: &c [u8]) -> unit {
    r := reg_name(name);
    if r.len() == 0 {
        bad(&mut l);
        return ();
    }
    if eq(view(r), view("rdx")) {
        l.rdxdead = 0;
    }
    w := reg_width(name);
    mut v = copy(value);
    if w == 32 {
        v = def(&mut l, view("and i64 {}, 4294967295"), &u8[][v]);
    }
    if w == 8 {
        old := def(&mut l, view("load i64, ptr {}"), &u8[][slot_of(view("%r."), view(r))]);
        hi := def(&mut l, view("and i64 {}, -256"), &u8[][old]);
        lo := def(&mut l, view("and i64 {}, 255"), &u8[][v]);
        v = def(&mut l, view("or i64 {}, {}"), &u8[][hi, lo]);
    }
    emit(&mut l, view("store i64 {}, ptr {}"), &u8[][v, slot_of(view("%r."), view(r))]);
    return ();
}
fn set_flag<a, b>(l: (&a mut L), flag: &b [u8], value: &b [u8]) -> unit {
    emit(&mut l, view("store i1 {}, ptr {}"), &u8[][copy(value), slot_of(view("%f."), flag)]);
    return ();
}
fn get_flag<a, b>(l: (&a mut L), flag: &b [u8]) -> u8[] {
    return def(&mut l, view("load i1, ptr {}"), &u8[][slot_of(view("%f."), flag)]);
}
fn zero_sign<a, b>(l: (&a mut L), r: &b [u8]) -> unit {
    z := def(&mut l, view("icmp eq i64 {}, 0"), &u8[][copy(r)]);
    set_flag(&mut l, view("Z"), view(z));
    s := def(&mut l, view("icmp slt i64 {}, 0"), &u8[][copy(r)]);
    set_flag(&mut l, view("S"), view(s));
    return ();
}

// ---- operands ----

// Operands of an instruction, split at top-level commas.
fn operands<a>(rest: &a [u8]) -> u8[][] {
    // The top-level comma-separated operands, each trimmed: found by position and copied once.
    mut out = u8[][];
    mut depth: u64 = 0;
    mut from: u64 = 0;
    for i in rest.len() + 1 {
        if i < rest.len() {
            ch := rest[i];
            if ch == 40 {
                depth += 1;
            }
            if ch == 41 {
                depth -= 1;
            }
            if (ch != 44) || (depth != 0) {
                continue;
            }
        }
        mut a = from;
        mut b = i;
        while a < b && (rest[a] == 32 || rest[a] == 9) {
            a += 1;
        }
        while b > a && (rest[b - 1] == 32 || rest[b - 1] == 9 || rest[b - 1] == 13) {
            b -= 1;
        }
        // The last operand is kept only when it is not empty, as before; an inner one always is.
        if (i < rest.len()) || (a < b) {
            mut t = u8[];
            if a < b {
                t.append(rest[a: b]);
            }
            out.push(t);
        }
        from = i + 1;
    }
    return out;
}
// The address of a memory operand `disp(base,index,scale)` or `sym(%rip)` as a ptr value.
fn address<a, b>(l: (&a mut L), op: &b [u8]) -> u8[] {
    mut open = op.len();
    for i in op.len() {
        if (op[i] == 40) & (open == op.len()) {
            open = i;
        }
    }
    if (op.len() == 0) || (open == op.len()) || (op[op.len() - 1] != 41) {
        bad(&mut l);
        return copy(view("null"));
    }
    disp := sub(op, 0, open);
    inner := operands(view(sub(op, open + 1, op.len() - 1)));
    if inner.len() == 0 || inner.len() > 3 {
        bad(&mut l);
        return copy(view("null"));
    }
    base := sub(view(inner[0]), 1, inner[0].len());
    if eq(view(base), view("rip")) {
        if inner.len() != 1 {
            bad(&mut l);
            return copy(view("null"));
        }
        // `SYM+N(%rip)`: a word inside a data symbol (rt_state+184, the host TLS base, is the one the
        // thread-pointer read tests).
        mut plus = disp.len();
        for i in disp.len() {
            if (disp[i] == 43) & (plus == disp.len()) {
                plus = i;
            }
        }
        name := sub(view(disp), 0, plus);
        l.refs.push(copy(view(name)));
        l.addrs.push(copy(view(name)));
        mut sym = u8[];
        put(&mut sym, view("@\""));
        put(&mut sym, view(name));
        sym.push(34);
        if plus == disp.len() {
            return sym;
        }
        off := sub(view(disp), plus + 1, disp.len());
        return def(&mut l, view("getelementptr i8, ptr {}, i64 {}"), &u8[][sym, copy(view(off))]);
    }
    mut d: i64 = 0;
    if disp.len() != 0 {
        parsed := parse_int(view(disp));
        d = parsed.v;
        if parsed.ok == 0 {
            bad(&mut l);
            return copy(view("null"));
        }
    }
    mut dt = u8[];
    inum(&mut dt, d);
    if eq(view(base), view("rbp")) & (inner.len() == 1) {
        if l.split != 0 {
            // Slot k covers [-8(k+1), -8k) below rbp.
            k := u64(0 - (d + 1)) / 8;
            within := d + i64(8 * (k + 1));
            // A two-word value is one alloca of two slots: the second word is the first word's
            // alloca at +8, so the address of either word names one object.
            mut at = k;
            mut off = within;
            if pair_second(&l, k) != 0 {
                at = u64(pair_base(&l, k)) - 1;
                off = within + i64(8 * (at - k));
            }
            mut slot = copy(view("%s."));
            num(&mut slot, at);
            mut wt = u8[];
            inum(&mut wt, off);
            return def(&mut l, view("getelementptr i8, ptr {}, i64 {}"), &u8[][slot, wt]);
        }
        return def(&mut l, view("getelementptr i8, ptr %fbase, i64 {}"), &u8[][dt]);
    }
    mut acc = u8[];
    if eq(view(base), view("rbp")) {
        acc = copy(view("%rbpv"));
    } else {
        acc = get_reg(&mut l, view(base));
    }
    if inner.len() >= 2 {
        index := get_reg(&mut l, view(sub(view(inner[1]), 1, inner[1].len())));
        mut scale = copy(view("1"));
        if inner.len() == 3 {
            scale = copy(view(inner[2]));
        }
        scaled := def(&mut l, view("mul i64 {}, {}"), &u8[][index, scale]);
        acc = def(&mut l, view("add i64 {}, {}"), &u8[][acc, scaled]);
    }
    if d != 0 {
        acc = def(&mut l, view("add i64 {}, {}"), &u8[][acc, dt]);
    }
    return def(&mut l, view("inttoptr i64 {} to ptr"), &u8[][acc]);
}
fn width_type(width: u64) -> u8[] {
    if width == 32 {
        return copy(view("i32"));
    }
    if width == 16 {
        return copy(view("i16"));
    }
    if width == 8 {
        return copy(view("i8"));
    }
    return copy(view("i64"));
}
// The value of an operand, zero-extended to i64 (memory loads read `width` bits).
fn value<a, b>(l: (&a mut L), op: &b [u8], width: u64) -> u8[] {
    if op.len() == 0 {
        bad(&mut l);
        return copy(view("0"));
    }
    if op[0] == 36 {
        n := parse_int(view(sub(op, 1, op.len())));
        if n.ok == 0 {
            bad(&mut l);
            return copy(view("0"));
        }
        mut out = u8[];
        inum(&mut out, n.v);
        return out;
    }
    if op[0] == 37 {
        name := sub(op, 1, op.len());
        if is_xmm(view(name)) {
            xmm_read(&mut l, view(name));
            return def(&mut l, view("load i64, ptr {}"), &u8[][slot_of(view("%x."), view(name))]);
        }
        return get_reg(&mut l, view(name));
    }
    if has(op, view("(")) {
        sp := stack_param(&mut l, op);
        if sp.len() != 0 {
            if width != 64 {
                bad(&mut l);
                return copy(view("0"));
            }
            return sp;
        }
        k := slot_operand(&l, op);
        if k != 0 {
            if width != 64 {
                bad(&mut l);
                return copy(view("0"));
            }
            sn := slot_name(k - 1);
            f := def(&mut l, view("load float, ptr {}, align 4"), &u8[][sn]);
            return word_of_float(&mut l, view(f));
        }
        h := sibling_load(&mut l, op);
        if h.len() != 0 {
            return h;
        }
        p := address(&mut l, op);
        if width == 64 {
            return def(&mut l, view("load i64, ptr {}, align 1"), &u8[][p]);
        }
        ty := width_type(width);
        v := def(&mut l, view("load {}, ptr {}, align 1"), &u8[][copy(view(ty)), p]);
        return def(&mut l, view("zext {} {} to i64"), &u8[][ty, v]);
    }
    bad(&mut l);
    return copy(view("0"));
}
// Writes a value: registers take the whole word (with the alias's width rules), memory `width` bits.
fn store<a, b, c>(l: (&a mut L), op: &b [u8], v: &c [u8], width: u64) -> unit {
    if op.len() == 0 {
        bad(&mut l);
        return ();
    }
    if op[0] == 37 {
        name := sub(op, 1, op.len());
        if is_xmm(view(name)) {
            xmm_written(&mut l, view(name));
            emit(&mut l, view("store i64 {}, ptr {}"), &u8[][copy(v), slot_of(view("%x."), view(name))]);
            return ();
        }
        set_reg(&mut l, view(name), v);
        return ();
    }
    if !has(op, view("(")) {
        bad(&mut l);
        return ();
    }
    k := slot_operand(&l, op);
    if k != 0 {
        if width != 64 {
            bad(&mut l);
            return ();
        }
        sn := slot_name(k - 1);
        d := as_double(&mut l, view(v));
        f := def(&mut l, view("fptrunc double {} to float"), &u8[][copy(view(d))]);
        verify_fact(&mut l, view(v), view(f));
        emit(&mut l, view("store float {}, ptr {}, align 4"), &u8[][f, sn]);
        return ();
    }
    p := address(&mut l, op);
    if width == 64 {
        emit(&mut l, view("store i64 {}, ptr {}, align 1"), &u8[][copy(v), p]);
        return ();
    }
    ty := width_type(width);
    tv := def(&mut l, view("trunc i64 {} to {}"), &u8[][copy(v), copy(view(ty))]);
    emit(&mut l, view("store {} {}, ptr {}, align 1"), &u8[][ty, tv, p]);
    return ();
}
fn as_double<a, b>(l: (&a mut L), v: &b [u8]) -> u8[] {
    return def(&mut l, view("bitcast i64 {} to double"), &u8[][copy(v)]);
}
fn as_word<a, b>(l: (&a mut L), d: &b [u8]) -> u8[] {
    return def(&mut l, view("bitcast double {} to i64"), &u8[][copy(d)]);
}

// ---- F2: "this word holds an f32" (docs/design/typed-ir.md) ----

// The word form of an f32: its binary64 widening, which is what the untyped rest of the program
// already holds for an f32 value today.
fn word_of_float<a, b>(l: (&a mut L), f: &b [u8]) -> u8[] {
    d := def(&mut l, view("fpext float {} to double"), &u8[][copy(f)]);
    return as_word(&mut l, view(d));
}
// The f32 an f32-valued word holds. Lossless only because the fact says the word is exactly the
// widening of an f32; that is the one boundary a wrong fact would corrupt, so --verify-facts
// checks it there.
fn float_of_word<a, b>(l: (&a mut L), w: &b [u8]) -> u8[] {
    d := as_double(&mut l, view(w));
    return def(&mut l, view("fptrunc double {} to float"), &u8[][d]);
}
// --verify-facts: assert `fpext(fptrunc(d)) == d` for the word a fact is about, compared on the
// bit pattern so a NaN passes. One compare and a cold branch per fact use; off by default.
fn verify_fact<a, b, c>(l: (&a mut L), w: &b [u8], f: &c [u8]) -> unit {
    if l.verify == 0 {
        return ();
    }
    d := def(&mut l, view("fpext float {} to double"), &u8[][copy(f)]);
    back := as_word(&mut l, view(d));
    same := def(&mut l, view("icmp eq i64 {}, {}"), &u8[][copy(w), back]);
    good := fresh_block(&mut l);
    wrong := fresh_block(&mut l);
    emit(&mut l, view("br i1 {}, label %{}, label %{}"), &u8[][same, copy(view(good)), copy(view(wrong))]);
    begin_block(&mut l, view(wrong));
    emit(&mut l, view("call void @\"rt_abort.cold\"() #0"), &u8[][]);
    emit(&mut l, view("unreachable"), &u8[][]);
    begin_block(&mut l, view(good));
    return ();
}
fn slot_name(k: u64) -> u8[] {
    mut out = copy(view("%s."));
    num(&mut out, k);
    return out;
}
// The stack operand of slot k: `-8(k+1)(%rbp)`.
fn slot_needle(k: u64) -> u8[] {
    mut out = u8[];
    out.push(45);
    num(&mut out, 8 * (k + 1));
    put(&mut out, view("(%rbp)"));
    return out;
}
// Whether slot k is one of the function's accepted f32 slots.
fn slot_typed<a>(l: (&a L), k: u64) -> bool {
    for i in l.fslots.len() {
        if l.fslots[i] == k {
            return true;
        }
    }
    return false;
}
// The slot an eight-byte frame operand addresses, plus one, when that slot carries an accepted
// f32 fact; 0 otherwise (including every mode that does not split the frame into slots).
fn slot_operand<a, b>(l: (&a L), op: &b [u8]) -> u64 {
    if (l.split == 0) || (l.fslots.len() == 0) || !ends(op, view("(%rbp)")) {
        return 0;
    }
    n := op.len() - 6;
    // `-N(%rbp)` only: a bare `(%rbp)` has no slot, and an indexed operand does not end in
    // `(%rbp)` at all.
    if n < 2 {
        return 0;
    }
    d := parse_int(view(sub(op, 0, n)));
    if (d.ok == 0) || (d.v >= 0) {
        return 0;
    }
    k := u64(0 - (d.v + 1)) / 8;
    // Exactly the whole slot: a partial or unaligned access is not an f32 in a float slot.
    if d.v + i64(8 * (k + 1)) != 0 {
        return 0;
    }
    if !slot_typed(&l, k) {
        return 0;
    }
    return k + 1;
}
// Whether every access to slot k in the body is one the float typing can carry: an eight-byte
// `movq` read, write or compare, with an immediate write only of zero (a float zero is all-zero
// bytes). Anything else -- an address taken, a four-byte alias, an integer operation -- makes the
// slot stay an untyped word, which is always correct.
// Builds l.sl_start/l.sl_lines for `instrs` and `slots` frame slots. A line names slot k when it
// contains `-8(k+1)(%rbp)` with the `-` right before the digits, which is exactly when the
// `has(line, slot_needle(k))` test the per-slot checks used to make is true.
fn index_slot_lines(l: (&mut L), instrs: (&u8[][]), slots: u64) -> unit {
    mut count = u64[];
    for k in slots + 1 {
        count.push(0);
    }
    mut pk = u64[];
    mut pm = u64[];
    for m in instrs.len() {
        line := view(instrs[m]);
        mut last = slots;
        mut i = 0;
        while i + 1 < line.len() {
            if (line[i] == 45) && (line[i + 1] >= 48) && (line[i + 1] <= 57) {
                mut j = i + 1;
                mut n: u64 = 0;
                while (j < line.len()) && (line[j] >= 48) && (line[j] <= 57) && (n < 1099511627776) {
                    n = n * 10 + u64(line[j] - 48);
                    j += 1;
                }
                if occurs_at_safe(line, j, view("(%rbp)")) && (n >= 8) && (n % 8 == 0) {
                    k := n / 8 - 1;
                    if (k < slots) && (k != last) {
                        pk.push(k);
                        pm.push(m);
                        count[k] = count[k] + 1;
                        last = k;
                    }
                }
                i = j;
                continue;
            }
            i += 1;
        }
    }
    mut start = u64[];
    mut at: u64 = 0;
    for k in slots + 1 {
        start.push(at);
        at += count[k];
    }
    mut fill = start.copy();
    mut lines = u64[];
    for q in at {
        lines.push(0);
    }
    // A line naming one slot twice must count once: pairs are in line order, so a repeat of the
    // same (k, m) is adjacent only within one line's scan, which `last` covers for consecutive
    // occurrences; an interleaved repeat (k, other, k) is caught here.
    for q in pk.len() {
        k := pk[q];
        if (fill[k] > start[k]) && (lines[fill[k] - 1] == pm[q]) {
            continue;
        }
        lines[fill[k]] = pm[q];
        fill[k] = fill[k] + 1;
    }
    // Close the gaps the skipped repeats left: each slot's range ends where its fill stopped.
    mut packed = u64[];
    mut pstart = u64[];
    for k in slots {
        pstart.push(packed.len());
        mut q = start[k];
        while q < fill[k] {
            packed.push(lines[q]);
            q += 1;
        }
    }
    pstart.push(packed.len());
    exchange(&mut l.sl_start, pstart);
    exchange(&mut l.sl_lines, packed);
    return ();
}
fn occurs_at_safe<a, b>(a: &a [u8], at: u64, b: &b [u8]) -> bool {
    if at + b.len() > a.len() {
        return false;
    }
    return occurs_at(a, at, b);
}
fn slot_body_ok<a, b>(l: (&a L), instrs: (&b u8[][]), k: u64) -> bool {
    needle := slot_needle(k);
    if k + 1 >= l.sl_start.len() {
        return true;
    }
    for q in l.sl_start[k + 1] - l.sl_start[k] {
        line := view(instrs[l.sl_lines[l.sl_start[k] + q]]);
        if !starts(line, view("movq ")) && !starts(line, view("cmpq ")) {
            return false;
        }
        // `movq $imm,slot` writes an f32 only when the word is zero: a float zero is all zero
        // bytes. The immediate is everything between `movq $` and the comma before the operand.
        if starts(line, view("movq $")) && !eq(view(sub(line, 6, line.len() - needle.len() - 1)), view("0")) {
            return false;
        }
    }
    return true;
}
// Fills l.fslots with the function's f32 slots that the lowering may type. A slot is dropped when
// any fact for it says something else (a slot reused for a non-f32 binding) or when the body
// touches it in a way the word ABI does not spell as one eight-byte word.
fn accept_slots<a, b, c, d>(l: (&a mut L), instrs: (&b u8[][]), facts: (&c Facts), fname: (&d [u8]), slots: u64) -> unit {
    exchange(&mut l.fslots, u64[]);
    mut cand = u64[];
    mut bad = u64[];
    for i in facts.items.len() {
        f := &facts.items[i];
        if (f.kind != 0) || !eq(view(f.fn), view(fname)) {
            continue;
        }
        mut seen = 0;
        for j in cand.len() {
            if cand[j] == f.a {
                seen = 1;
            }
        }
        if seen == 0 {
            cand.push(f.a);
        }
        // The declared width is part of the fact: an f32 slot is four bytes, and a slot fact that
        // says anything else is not the value this lowering can carry.
        if (f.what != 1) || (f.width != 4) {
            bad.push(f.a);
        }
    }
    for i in cand.len() {
        k := cand[i];
        mut rejected = 0;
        for j in bad.len() {
            if bad[j] == k {
                rejected = 1;
            }
        }
        if (rejected == 0) & (k < slots) & slot_body_ok(&l, &instrs, k) {
            l.fslots.push(k);
        }
    }
    return ();
}
// ---- F1: "this word points at a 24-byte sequence header" (docs/design/typed-ir.md) ----

// A header fact on a call: `what` 0 when the call has none.
struct HFact {
    what: u64,
    width: u64
}
fn no_hfact() -> HFact {
    return HFact { what: 0, width: 0 };
}
// The registers the word machine passes arguments in, in parameter order.
fn arg_reg(i: u64) -> u8[] {
    if i == 1 {
        return copy(view("rsi"));
    }
    if i == 2 {
        return copy(view("rdx"));
    }
    if i == 3 {
        return copy(view("rcx"));
    }
    if i == 4 {
        return copy(view("r8"));
    }
    if i == 5 {
        return copy(view("r9"));
    }
    return copy(view("rdi"));
}
// 0..13 for a machine register, 14 for anything else.
// The index of a 64-bit register name in rax, rbx, rcx, rdx, rsi, rdi, r8..r15 order, or 14. Read
// from the bytes: this is asked for nearly every operand the lifter sees.
fn reg_index(name: &[u8]) -> u64 {
    n := name.len();
    if (n < 2) || (n > 3) || (name[0] != 114) {
        return 14;
    }
    if n == 2 {
        if name[1] == 56 {
            return 6;
        }
        if name[1] == 57 {
            return 7;
        }
        return 14;
    }
    a := name[1];
    b := name[2];
    if (a == 49) && (b >= 48) && (b <= 53) {
        return 8 + u64(b - 48);
    }
    if b == 120 {
        if a == 97 {
            return 0;
        }
        if a == 98 {
            return 1;
        }
        if a == 99 {
            return 2;
        }
        if a == 100 {
            return 3;
        }
        return 14;
    }
    if b == 105 {
        if a == 115 {
            return 4;
        }
        if a == 100 {
            return 5;
        }
    }
    return 14;
}
// The storage id of an operand that names storage this analysis tracks (0-13 a register, 14+k a
// frame slot), plus one; 0 when the operand is not one.
fn storage_of(l: (&L), op: &[u8]) -> u64 {
    if (op.len() != 0) && (op[0] == 37) {
        r := reg_index(view(sub(op, 1, op.len())));
        if r < 14 {
            return r + 1;
        }
        return 0;
    }
    if !ends(op, view("(%rbp)")) || (op.len() < 6) {
        return 0;
    }
    n := op.len() - 6;
    if n < 2 {
        return 0;
    }
    d := parse_int(view(sub(op, 0, n)));
    // A frame displacement, and only that: the exact-slot arithmetic below must not see a 64-bit
    // immediate, which a `movabsq` operand can spell.
    if (d.ok == 0) || (d.v >= 0) || (d.v < -1073741824) {
        return 0;
    }
    k := u64(0 - (d.v + 1)) / 8;
    if 0 - i64(8 * (k + 1)) != d.v {
        return 0;
    }
    return 15 + k;
}
// The chain a storage location carries: 0 nothing, 1 the header pointer of slot `vo` plus `vo2`
// bytes, 2 the constant `vo2`. A frame slot with an accepted F1 fact is a header pointer by
// definition, which is the one thing the fact says about it.
fn chain_kind(l: (&L), id: u64) -> u64 {
    if id >= 15 && header_slot_kind(&l, id - 15) != 0 {
        return 1;
    }
    if (id == 0) || (id > l.vk.len()) {
        return 0;
    }
    return l.vk[id - 1];
}
fn chain_slot(l: (&L), id: u64) -> u64 {
    if id >= 15 && header_slot_kind(&l, id - 15) != 0 {
        return id - 15;
    }
    if (id == 0) || (id > l.vo.len()) {
        return 0;
    }
    return l.vo[id - 1];
}
fn chain_off(l: (&L), id: u64) -> i64 {
    if id >= 15 && header_slot_kind(&l, id - 15) != 0 {
        return 0;
    }
    if (id == 0) || (id > l.vo2.len()) {
        return 0;
    }
    return l.vo2[id - 1];
}
// In a sibling body, the load a fact makes unnecessary: the header field at `+0` (`data`) or `+8`
// (`len`) is one of the two words the caller hoisted, so it is that SSA value, not a load. Any
// other offset falls through to the ordinary untyped load, which reads the same bytes.
fn sibling_load(l: (&mut L), op: (&[u8])) -> u8[] {
    if (l.sibwidth == 0) || !has(op, view("(")) || !ends(op, view(")")) {
        return u8[];
    }
    mut open = op.len();
    for i in op.len() {
        if (op[i] == 40) & (open == op.len()) {
            open = i;
        }
    }
    if open == op.len() {
        return u8[];
    }
    inner := operands(view(sub(op, open + 1, op.len() - 1)));
    if inner.len() != 1 {
        return u8[];
    }
    base := sub(view(inner[0]), 1, inner[0].len());
    r := reg_index(view(base));
    if r >= 14 || (r >= l.vk.len()) || (l.vk[r] != 1) {
        return u8[];
    }
    mut d: i64 = 0;
    if open != 0 {
        parsed := parse_int(view(sub(op, 0, open)));
        if parsed.ok == 0 {
            return u8[];
        }
        d = parsed.v;
    }
    off := l.vo2[r] + d;
    if off == 0 {
        return copy(view(l.sd));
    }
    if off == 8 {
        return copy(view(l.sl));
    }
    return u8[];
}
// The chain `addq`/`subq` gives its destination: a header pointer moves by a constant offset, and
// a constant arithmetic result stays a constant.
fn chain_arith(l: (&mut L), dst: (&[u8]), src: (&[u8]), minus: u64) -> unit {
    did := storage_of(&l, dst);
    if did == 0 {
        return ();
    }
    dk := op_chain_kind(&l, dst);
    sk := op_chain_kind(&l, src);
    mut so = op_chain_off(&l, src);
    // Only a small displacement keeps a header pointer a header pointer; anything else (a 64-bit
    // immediate, an address) ends the chain, and negating one could overflow.
    if (so > 1073741824) || (so < -1073741824) {
        set_chain(&mut l, did, 0, 0, 0);
        return ();
    }
    if minus != 0 {
        so = 0 - so;
    }
    dso := op_chain_slot(&l, dst);
    dof := op_chain_off(&l, dst);
    sso := op_chain_slot(&l, src);
    if (dof > 1073741824) || (dof < -1073741824) {
        set_chain(&mut l, did, 0, 0, 0);
        return ();
    }
    if (dk == 1) & (sk == 2) {
        set_chain(&mut l, did, 1, dso, dof + so);
        return ();
    }
    if (dk == 2) & (sk == 1) {
        set_chain(&mut l, did, 1, sso, dof + so);
        return ();
    }
    if (dk == 2) & (sk == 2) {
        set_chain(&mut l, did, 2, 0, dof + so);
        return ();
    }
    set_chain(&mut l, did, 0, 0, 0);
    return ();
}
fn set_chain(l: (&mut L), id: u64, kind: u64, slot: u64, off: i64) -> unit {
    // The chain arrays cover the registers and frame slots of a *split* frame only; a function whose
    // frame is one blob has nothing for a chain to be attached to.
    if (id == 0) || (id > l.vk.len()) {
        return ();
    }
    l.vk[id - 1] = kind;
    l.vo[id - 1] = slot;
    l.vo2[id - 1] = off;
    return ();
}
// The chain of an operand that is storage or an immediate. A memory operand is a load, so the word
// it yields is never a header pointer or a constant by provenance.
fn op_storage<a>(l: (&a L), op: &[u8]) -> u64 {
    if (op.len() != 0) && (op[0] == 36) {
        return 0;
    }
    return storage_of(&l, op);
}
fn op_chain_kind<a>(l: (&a L), op: &[u8]) -> u64 {
    mut id = op_storage(&l, op);
    if id != 0 {
        return chain_kind(&l, id);
    }
    if (op.len() != 0) && (op[0] == 36) {
        n := parse_int(view(sub(op, 1, op.len())));
        if n.ok != 0 {
            return 2;
        }
    }
    return 0;
}
fn op_chain_slot<a>(l: (&a L), op: &[u8]) -> u64 {
    return chain_slot(&l, op_storage(&l, op));
}
fn op_chain_off<a>(l: (&a L), op: &[u8]) -> i64 {
    if (op.len() != 0) && (op[0] == 36) {
        n := parse_int(view(sub(op, 1, op.len())));
        return n.v;
    }
    return chain_off(&l, op_storage(&l, op));
}
// Whether slot k carries an accepted F1 header fact.
fn header_slot_kind(l: (&L), k: u64) -> u64 {
    for i in l.hslots.len() {
        if l.hslots[i] == k {
            return l.hwhat[i];
        }
    }
    return 0;
}
fn header_slot_width(l: (&L), k: u64) -> u64 {
    for i in l.hslots.len() {
        if l.hslots[i] == k {
            return l.hwidth[i];
        }
    }
    return 0;
}
// The slot an eight-byte frame operand addresses exactly, plus one, when that slot carries an
// accepted F1 header fact; 0 otherwise.
fn header_operand(l: (&L), op: &[u8]) -> u64 {
    if (l.split == 0) || (l.hslots.len() == 0) || !ends(op, view("(%rbp)")) {
        return 0;
    }
    n := op.len() - 6;
    if n < 2 {
        return 0;
    }
    d := parse_int(view(sub(op, 0, n)));
    if (d.ok == 0) || (d.v >= 0) || (d.v < -1073741824) {
        return 0;
    }
    k := u64(0 - (d.v + 1)) / 8;
    if 0 - i64(8 * (k + 1)) != d.v {
        return 0;
    }
    if header_slot_kind(&l, k) == 0 {
        return 0;
    }
    return k + 1;
}
// Whether every access to slot k in the body can carry a header fact: a whole-eight-byte `movq`
// read or write, a `cmpq`, or a `leaq` of the slot (`&v`, a borrow). A constant written into the
// slot, a four-byte alias or any integer operation makes the slot stay an untyped word, which is
// always correct.
fn header_body_ok(l: (&L), instrs: (&u8[][]), k: u64) -> bool {
    if k + 1 >= l.sl_start.len() {
        return true;
    }
    for q in l.sl_start[k + 1] - l.sl_start[k] {
        line := view(instrs[l.sl_lines[l.sl_start[k] + q]]);
        if starts(line, view("leaq ")) || starts(line, view("cmpq ")) {
            continue;
        }
        if starts(line, view("movq %")) || starts(line, view("movq -")) || starts(line, view("movq r")) {
            continue;
        }
        return false;
    }
    return true;
}
// Fills l.hslots/l.hwhat/l.hwidth with the function's F1 header slots the lowering may type. A
// slot is dropped when any fact for it says something else (a slot reused for another binding) or
// when the body touches it in a way that is not one eight-byte word at a time.
fn accept_headers(l: (&mut L), instrs: (&u8[][]), facts: (&Facts), fname: (&[u8]), slots: u64) -> unit {
    exchange(&mut l.hslots, u64[]);
    exchange(&mut l.hwhat, u64[]);
    exchange(&mut l.hwidth, u64[]);
    exchange(&mut l.hstable, u64[]);
    exchange(&mut l.hesc, u64[]);
    mut cand = u64[];
    mut cwhat = u64[];
    mut cwidth = u64[];
    mut bad = u64[];
    for i in facts.items.len() {
        f := &facts.items[i];
        if (f.kind != 0) || !eq(view(f.fn), view(fname)) {
            continue;
        }
        mut seen = 0;
        for j in cand.len() {
            if cand[j] == f.a {
                seen = 1;
            }
        }
        if seen == 0 {
            cand.push(f.a);
            cwhat.push(f.what);
            cwidth.push(f.width);
        }
        // Every fact naming the slot has to agree, and a header is `what` 2/3/4 (a vector) or 5 (a
        // slice's descriptor).
        if (f.what < 2) || (f.what > 5) {
            bad.push(f.a);
        } else {
            for j in cand.len() {
                if (cand[j] == f.a) && (cwhat[j] != f.what) {
                    bad.push(f.a);
                }
            }
        }
    }
    for i in cand.len() {
        k := cand[i];
        mut rejected = 0;
        for j in bad.len() {
            if bad[j] == k {
                rejected = 1;
            }
        }
        if (rejected == 0) & (k < slots) & (cwhat[i] >= 2) & (cwhat[i] <= 5) & header_body_ok(&l, &instrs, k) {
            l.hslots.push(k);
            l.hwhat.push(cwhat[i]);
            l.hwidth.push(cwidth[i]);
            l.hstable.push(u64((cwhat[i] == 5) && written_once(&instrs, k)));
            l.hesc.push(u64(slot_addressed(&l, &instrs, k)));
        }
    }
    return ();
}
// The key of the F1 fact on the `ordinal`-th call to `callee`: its argument 0 is a header.
fn call_key(callee: (&[u8]), ordinal: u64) -> u8[] {
    mut key = copy(callee);
    key.push(35);
    num(&mut key, ordinal);
    return key;
}
// Indexes the function's F1 call facts once (lower_function), so a call site finds its fact in one
// probe; the first fact recorded for a key wins, as the scan in `call_header` would find it.
fn index_call_headers(l: (&mut L), facts: (&Facts), fname: (&[u8])) -> unit {
    mut n = 0;
    for i in facts.items.len() {
        if facts.items[i].kind == 1 {
            n += 1;
        }
    }
    exchange(&mut l.hmap, map_new(n + 1));
    for i in facts.items.len() {
        f := &facts.items[i];
        if (f.kind != 1) || (f.what < 2) || (f.what > 5) || !eq(view(f.fn), view(fname)) {
            continue;
        }
        key := call_key(view(f.callee), f.a);
        if map_get(&l.hmap, view(key)) == 0 {
            map_put(&mut l.hmap, view(key), i);
        }
    }
    return ();
}
fn call_header_at(l: (&L), facts: (&Facts), callee: (&[u8]), ordinal: u64) -> HFact {
    hit := map_get(&l.hmap, view(call_key(callee, ordinal)));
    if hit == 0 {
        return no_hfact();
    }
    f := &facts.items[hit - 1];
    return HFact { what: f.what, width: f.width };
}
// The `ordinal`-th call to `callee` in the function being lowered, counting the calls this lifter
// has already seen in emission order (the key an F1 call fact carries).
fn callee_ordinal(l: (&mut L), callee: (&[u8])) -> u64 {
    hit := map_get(&l.cmap, callee);
    if hit != 0 {
        n := l.ccount[hit - 1];
        l.ccount[hit - 1] = n + 1;
        return n;
    }
    l.cnames.push(copy(callee));
    l.ccount.push(1);
    id := l.cnames.len() - 1;
    if (id + 1) * 2 >= l.cmap.used.len() {
        mut bigger = map_new(l.cmap.used.len());
        for i in l.cnames.len() {
            map_put(&mut bigger, view(l.cnames[i]), i);
        }
        exchange(&mut l.cmap, bigger);
    } else {
        map_put(&mut l.cmap, callee, id);
    }
    return 0;
}
// Absolute, machine-aligned loads of the two header fields a fact makes readable this way: `+0` is
// `data` and `+8` is `len`. `+16` is `cap`, which only a vector header defines (`what` 2/3/4); a
// descriptor leaves it uninitialised, so it is never loaded from here. `inv` adds `!invariant.load`
// and `!alias.scope`, which hold for a descriptor and not for a vector that may still grow.
fn header_load(l: (&mut L), base: (&[u8]), off: i64) -> u8[] {
    mut p = copy(base);
    if off != 0 {
        mut o = u8[];
        inum(&mut o, off);
        p = def(&mut l, view("getelementptr i8, ptr {}, i64 {}"), &u8[][p, o]);
    }
    return def(&mut l, view("load i64, ptr {}, align 8"), &u8[][p]);
}
// --verify-facts, F1: the pointer a fact calls a header is non-null and eight-byte aligned, and a
// header a fact calls a vector has `cap >= len` at `+16`. That last load is the tripwire: it reads
// the word a descriptor leaves uninitialised, so a `what` that says vector where the word is a
// descriptor aborts here instead of corrupting a length later.
fn verify_header(l: (&mut L), w: (&[u8]), h: (&[u8]), what: u64, ln: (&[u8])) -> unit {
    nz := def(&mut l, view("icmp ne i64 {}, 0"), &u8[][copy(w)]);
    m := def(&mut l, view("and i64 {}, 7"), &u8[][copy(w)]);
    al := def(&mut l, view("icmp eq i64 {}, 0"), &u8[][m]);
    mut ok = def(&mut l, view("and i1 {}, {}"), &u8[][nz, al]);
    if what != 5 {
        cp := header_load(&mut l, h, 16);
        ge := def(&mut l, view("icmp uge i64 {}, {}"), &u8[][cp, copy(ln)]);
        ok = def(&mut l, view("and i1 {}, {}"), &u8[][ok, ge]);
    }
    good := fresh_block(&mut l);
    wrong := fresh_block(&mut l);
    emit(&mut l, view("br i1 {}, label %{}, label %{}"), &u8[][ok, copy(view(good)), copy(view(wrong))]);
    begin_block(&mut l, view(wrong));
    emit(&mut l, view("call void @\"rt_abort.cold\"() #0"), &u8[][]);
    emit(&mut l, view("unreachable"), &u8[][]);
    begin_block(&mut l, view(good));
    return ();
}
// Whether a callee returns an element pointer (`rt_slot*`, `rt_at*`) rather than a value, which is
// what the element-range check can be said about.
fn element_callee(name: (&[u8])) -> bool {
    // The wide accessors only: `rt_slot4`/`rt_slotb` hand back addresses whose narrow/tagged forms
    // the front end rewrites after the call, so the value this check sees is not the final one.
    if eq(name, view("rt_slot")) || eq(name, view("rt_slotu")) {
        return true;
    }
    return eq(name, view("rt_at")) || eq(name, view("rt_atbu"));
}
// --verify-facts, F1: the element pointer a typed accessor returns lies inside `data .. data + len
// * width`. A fact whose width is wrong puts it past the end for every index but the first, so the
// width half of the fact is checked on the value it produces rather than on the header.
fn verify_element(l: (&mut L), res: (&[u8]), d: (&[u8]), ln: (&[u8]), width: u64) -> unit {
    w := def(&mut l, view("add i64 0, {}"), &u8[][copy_width(width)]);
    top := def(&mut l, view("mul i64 {}, {}"), &u8[][copy(ln), w]);
    hi := def(&mut l, view("add i64 {}, {}"), &u8[][copy(d), top]);
    lo_ok := def(&mut l, view("icmp uge i64 {}, {}"), &u8[][copy(res), copy(d)]);
    hi_ok := def(&mut l, view("icmp ult i64 {}, {}"), &u8[][copy(res), hi]);
    ok := def(&mut l, view("and i1 {}, {}"), &u8[][lo_ok, hi_ok]);
    good := fresh_block(&mut l);
    wrong := fresh_block(&mut l);
    emit(&mut l, view("br i1 {}, label %{}, label %{}"), &u8[][ok, copy(view(good)), copy(view(wrong))]);
    begin_block(&mut l, view(wrong));
    emit(&mut l, view("call void @\"rt_abort.cold\"() #0"), &u8[][]);
    emit(&mut l, view("unreachable"), &u8[][]);
    begin_block(&mut l, view(good));
    return ();
}
fn copy_width(width: u64) -> u8[] {
    mut w = u8[];
    num(&mut w, width);
    return w;
}
// Hoists `data` and `len` at the point a fact is established: the word `w` is the header pointer,
// so the two fields are read once, here, and every access in the region that follows reads the SSA
// values instead of re-loading (docs/design/typed-ir.md, F1b).
fn establish(l: (&mut L), k: u64, w: (&[u8])) -> unit {
    while l.eon.len() <= k {
        l.eon.push(0);
        l.edata.push(u8[]);
        l.elen.push(u8[]);
        l.edptr.push(u8[]);
    }
    // `stale` and `unestablish` grow the other arrays without this one.
    while l.eblk.len() <= k {
        l.eblk.push(0);
    }
    what := header_slot_kind(&l, k);
    h := def(&mut l, view("inttoptr i64 {} to ptr"), &u8[][copy(w)]);
    dp := def(&mut l, view("load ptr, ptr {}, align 8"), &u8[][copy(view(h))]);
    d := def(&mut l, view("ptrtoint ptr {} to i64"), &u8[][copy(view(dp))]);
    ln := header_load(&mut l, view(h), 8);
    exchange(&mut l.edptr[k], dp);
    if l.verify != 0 {
        verify_header(&mut l, w, view(h), what, view(ln));
    }
    exchange(&mut l.edata[k], d);
    exchange(&mut l.elen[k], ln);
    l.eon[k] = 1;
    l.eblk[k] = l.blk;
    return ();
}
// The header of slot k may have been rewritten: `data` dies on any growth and on any untyped
// write to the slot, `len` on every push/pop/remove/insert/truncate/fill/clear. The slot still
// holds a live header, so its fields are re-read where the next site needs them; the values
// already emitted stay correct for every use before this point.
fn stale(l: (&mut L), k: u64) -> unit {
    while l.eon.len() <= k {
        l.eon.push(0);
        l.edata.push(u8[]);
        l.elen.push(u8[]);
        l.edptr.push(u8[]);
    }
    // A slice's descriptor (`what` 5) is never written while the slice lives (SEQ-STABLE): no call
    // can grow, move or truncate what it describes, so its fields stay current - unless the slot's
    // address was taken, through which a call could bind the slot to another slice.
    if (header_slot_kind(&l, k) == 5) && header_stable(&l, k) {
        return ();
    }
    if l.eon[k] == 1 {
        l.eon[k] = 2;
    }
    return ();
}
// The slot no longer holds a header it was known to hold (a constant or untyped word was written
// to it), so there is nothing to re-read.
fn unestablish(l: (&mut L), k: u64) -> unit {
    while l.eon.len() <= k {
        l.eon.push(0);
        l.edata.push(u8[]);
        l.elen.push(u8[]);
        l.edptr.push(u8[]);
    }
    l.eon[k] = 0;
    return ();
}
// Re-reads `data`/`len` of a slot whose header may have moved (a growth, or an address that
// escaped), so the next region reads the two fields once instead of on every access.
fn reestablish(l: (&mut L), k: u64) -> unit {
    if !established(&l, k) {
        return ();
    }
    w := def(&mut l, view("load i64, ptr {}, align 8"), &u8[][slot_name(k)]);
    establish(&mut l, k, view(w));
    return ();
}
// 1 when slot k's `data`/`len` are established and current, 2 when it holds a live header whose
// fields have to be re-read, 0 when it does not hold a header at all.
fn established(l: (&L), k: u64) -> u64 {
    if k >= l.eon.len() {
        return 0;
    }
    return l.eon[k];
}
// Whether the words established for slot k can be used here: the establishing block dominates this
// one, which is the case in the same block, or when it was established in the entry region (a
// block whose every successor has a single predecessor, so it dominates everything after it).
fn reachable(l: (&L), k: u64) -> bool {
    if established(&l, k) != 1 {
        return false;
    }
    if k >= l.eblk.len() {
        return false;
    }
    if l.eblk[k] == l.blk {
        return true;
    }
    // SEQ-STABLE: a slice descriptor whose one write is in the function's first block. That block
    // dominates every other, and nothing writes the descriptor while the slice lives, so the fields
    // read there are the fields everywhere (docs/design/release-builds-and-parity.md).
    return (l.eblk[k] == l.body_blk) && header_stable(&l, k);
}
fn header_stable(l: (&L), k: u64) -> bool {
    for i in l.hslots.len() {
        if (l.hslots[i] == k) && (i < l.hstable.len()) {
            return l.hstable[i] != 0;
        }
    }
    return false;
}
// Whether slot k is written by exactly one instruction of the body and never has its address taken:
// the destination operand is the slot itself, matched whole (`-8(%rbp)` is not `-48(%rbp)`).
fn written_once(instrs: (&u8[][]), k: u64) -> bool {
    needle := slot_needle(k);
    mut writes = 0;
    for m in instrs.len() {
        line := view(instrs[m]);
        if !has(line, view(needle)) {
            continue;
        }
        mut comma = line.len();
        for j in line.len() {
            if line[j] == 44 {
                comma = j;
            }
        }
        if comma == line.len() {
            continue;
        }
        dst := sub(line, comma + 1, line.len());
        if starts(line, view("leaq ")) {
            src := sub(line, 5, comma);
            if eq(view(src), view(needle)) {
                return false;
            }
            continue;
        }
        if eq(view(dst), view(needle)) {
            writes += 1;
        }
    }
    return writes == 1;
}
// Whether a call writes the header it is given. Everything outside this set that receives a header
// word may grow, fill, truncate, pop, insert or clear it, and invalidates the established fields.
fn header_readonly(name: (&[u8])) -> bool {
    if eq(name, view("rt_slot")) || eq(name, view("rt_slotu")) || eq(name, view("rt_slot4")) || eq(name, view("rt_slot4u")) {
        return true;
    }
    if eq(name, view("rt_slotb")) || eq(name, view("rt_len")) || eq(name, view("rt_view")) {
        return true;
    }
    if eq(name, view("rt_slice")) || eq(name, view("rt_vslice")) || eq(name, view("rt_write")) {
        return true;
    }
    if eq(name, view("rt_at")) || eq(name, view("rt_at4")) || eq(name, view("rt_atb")) || eq(name, view("rt_atbu")) {
        return true;
    }
    return false;
}
// The header slots a call reaches through its argument words. A call that is not one of the
// read-only accessors may grow, fill, truncate, pop, insert or clear the sequence it is given, so
// the fields hoisted for that slot are stale from here; they are re-read once the call returns.
// The runtime calls that cannot change any vector header: the read-only accessors, the float and
// integer helpers (pure functions of their words), and the failures that never return.
fn header_neutral(name: (&[u8])) -> bool {
    if never_returns(name) || eq(name, view("rt_abort")) {
        return true;
    }
    return starts(name, view("rt_f64_")) || starts(name, view("rt_f32_")) || eq(name, view("rt_int_from_f64"))
        || eq(name, view("rt_div")) || eq(name, view("rt_int_cast"));
}
// Whether the body takes the address of slot k: a `leaq` whose source is the slot.
fn slot_addressed(l: (&L), instrs: (&u8[][]), k: u64) -> bool {
    needle := slot_needle(k);
    if k + 1 >= l.sl_start.len() {
        return false;
    }
    for q in l.sl_start[k + 1] - l.sl_start[k] {
        line := view(instrs[l.sl_lines[l.sl_start[k] + q]]);
        if !starts(line, view("leaq ")) {
            continue;
        }
        mut comma = line.len();
        for j in line.len() {
            if line[j] == 44 {
                comma = j;
            }
        }
        if (comma < line.len()) && eq(view(trim(view(sub(line, 5, comma)))), view(needle)) {
            return true;
        }
    }
    return false;
}
fn invalidate_args(l: (&mut L), target: (&[u8])) -> unit {
    if header_readonly(target) || header_neutral(target) {
        return ();
    }
    // A header whose slot's address was taken can be reached by this call whatever it was handed:
    // `pad(&mut out)` passes the slot's address, not the header word, and a callee that pushes
    // through it moves `len` and `data` (the stale-length miscompile).
    for i in l.hslots.len() {
        if (i < l.hesc.len()) && (l.hesc[i] != 0) {
            stale(&mut l, l.hslots[i]);
        }
    }
    for i in 6 {
        id := reg_index(view(arg_reg(i))) + 1;
        if (id >= 15) || (chain_kind(&l, id) != 1) {
            continue;
        }
        k := chain_slot(&l, id);
        if k < l.hslots.len() + 64 {
            stale(&mut l, k);
        }
    }
    return ();
}
// The argument registers hold whatever the call was given, which a later call that does not set
// them must not read as a live header. They are set again by the `movq` that passes an argument.
fn clear_args(l: (&mut L)) -> unit {
    for i in 6 {
        r := reg_index(view(arg_reg(i)));
        set_chain(&mut l, r + 1, 0, 0, 0);
    }
    return ();
}
// Re-reads every field set a call made stale, so the region after it keeps the hoist.
fn refresh(l: (&mut L)) -> unit {
    for k in l.eon.len() {
        if l.eon[k] == 2 {
            reestablish(&mut l, k);
        }
    }
    return ();
}
// The id of a block name, assigned on first appearance so the two lowering passes agree.
fn block_id<a, b>(l: (&a mut L), name: &b [u8]) -> u64 {
    hit := map_get(&l.dmap, name);
    if hit != 0 {
        return hit - 1;
    }
    l.dnames.push(copy(view(name)));
    id := l.dnames.len() - 1;
    // A full table probes forever: grow it before it is half used.
    if (id + 1) * 2 >= l.dmap.used.len() {
        mut bigger = map_new(l.dmap.used.len());
        for i in l.dnames.len() {
            map_put(&mut bigger, view(l.dnames[i]), i);
        }
        exchange(&mut l.dmap, bigger);
    } else {
        map_put(&mut l.dmap, name, id);
    }
    return id;
}
// The sibling a fact-carrying call targets: the same word-machine body emitted with argument 0 as
// a `ptr` carrying `dereferenceable(24) align 8`, and with `data`/`len` passed in instead of read.
fn sibling_name(callee: (&[u8]), what: u64, width: u64) -> u8[] {
    mut out = copy(callee);
    mut w = u8[];
    num(&mut w, what);
    mut n = u8[];
    num(&mut n, width);
    put(&mut out, view(".h"));
    put(&mut out, view(w));
    put(&mut out, view("w"));
    put(&mut out, view(n));
    return out;
}

// The opcode of the f32-arithmetic fact for the `rt_f64_op` call at `ordinal`, or 0 when the call
// has no fact and must keep the word lowering.
fn call_op<a>(l: (&a L), ordinal: u64) -> u64 {
    if ordinal < l.fops.len() {
        return l.fops[ordinal];
    }
    return 0;
}

// ---- conditions ----

fn not1<a, b>(l: (&a mut L), v: &b [u8]) -> u8[] {
    return def(&mut l, view("xor i1 {}, true"), &u8[][copy(v)]);
}
fn op1<a, b, c>(l: (&a mut L), op: &b [u8], x: &c [u8], y: &c [u8]) -> u8[] {
    mut t = u8[];
    put(&mut t, op);
    put(&mut t, view(" i1 {}, {}"));
    return def(&mut l, view(t), &u8[][copy(x), copy(y)]);
}
// The i1 for a jcc/setcc condition code, from the flags the last flag-setting instruction stored.
fn condition<a, b>(l: (&a mut L), cc: &b [u8]) -> u8[] {
    if eq(cc, view("e")) || eq(cc, view("z")) {
        return get_flag(&mut l, view("Z"));
    }
    if eq(cc, view("ne")) || eq(cc, view("nz")) {
        z := get_flag(&mut l, view("Z"));
        return not1(&mut l, view(z));
    }
    if eq(cc, view("b")) || eq(cc, view("c")) || eq(cc, view("nae")) {
        return get_flag(&mut l, view("C"));
    }
    if eq(cc, view("ae")) || eq(cc, view("nc")) || eq(cc, view("nb")) {
        c := get_flag(&mut l, view("C"));
        return not1(&mut l, view(c));
    }
    if eq(cc, view("a")) || eq(cc, view("be")) {
        c := get_flag(&mut l, view("C"));
        z := get_flag(&mut l, view("Z"));
        either := op1(&mut l, view("or"), view(c), view(z));
        if eq(cc, view("be")) {
            return either;
        }
        return not1(&mut l, view(either));
    }
    if eq(cc, view("l")) || eq(cc, view("ge")) || eq(cc, view("g")) || eq(cc, view("le")) {
        s := get_flag(&mut l, view("S"));
        o := get_flag(&mut l, view("O"));
        less := op1(&mut l, view("xor"), view(s), view(o));
        if eq(cc, view("l")) {
            return less;
        }
        if eq(cc, view("ge")) {
            return not1(&mut l, view(less));
        }
        z := get_flag(&mut l, view("Z"));
        lesseq := op1(&mut l, view("or"), view(z), view(less));
        if eq(cc, view("le")) {
            return lesseq;
        }
        return not1(&mut l, view(lesseq));
    }
    if eq(cc, view("s")) {
        return get_flag(&mut l, view("S"));
    }
    if eq(cc, view("ns")) {
        s := get_flag(&mut l, view("S"));
        return not1(&mut l, view(s));
    }
    if eq(cc, view("p")) {
        return get_flag(&mut l, view("P"));
    }
    if eq(cc, view("np")) {
        p := get_flag(&mut l, view("P"));
        return not1(&mut l, view(p));
    }
    bad(&mut l);
    return copy(view("false"));
}
fn block_name<a>(label: &a [u8]) -> u8[] {
    mut out = u8[];
    put(&mut out, view("b"));
    for i in label.len() {
        if label[i] == 46 {
            out.push(95);
        } else {
            out.push(label[i]);
        }
    }
    return out;
}
fn fresh_block<a>(l: (&a mut L)) -> u8[] {
    l.dead += 1;
    mut out = u8[];
    put(&mut out, view("n"));
    num(&mut out, l.dead);
    return out;
}
fn begin_block<a, b>(l: (&a mut L), name: &b [u8]) -> unit {
    l.blk = block_id(&mut l, name);
    l.rdxdead = 0;
    put(&mut l.body, name);
    put(&mut l.body, view(":\n"));
    l.term = 0;
    return ();
}
// add/sub/cmp: result and the four arithmetic flags.
fn arith<a, b, c>(l: (&a mut L), kind: &b [u8], x: &c [u8], y: &c [u8]) -> u8[] {
    mut call = u8[];
    put(&mut call, view("call {i64, i1} @llvm."));
    put(&mut call, kind);
    put(&mut call, view(".with.overflow.i64(i64 {}, i64 {})"));
    pair := def(&mut l, view(call), &u8[][copy(x), copy(y)]);
    r := def(&mut l, view("extractvalue {i64, i1} {}, 0"), &u8[][copy(view(pair))]);
    o := def(&mut l, view("extractvalue {i64, i1} {}, 1"), &u8[][pair]);
    set_flag(&mut l, view("O"), view(o));
    zero_sign(&mut l, view(r));
    return r;
}
fn logic_flags<a, b>(l: (&a mut L), r: &b [u8]) -> unit {
    set_flag(&mut l, view("C"), view("false"));
    set_flag(&mut l, view("O"), view("false"));
    zero_sign(&mut l, r);
    return ();
}
fn binop_name<a>(op: &a [u8]) -> u8[] {
    if eq(op, view("andq")) || eq(op, view("testq")) || eq(op, view("andb")) {
        return copy(view("and"));
    }
    if eq(op, view("orq")) {
        return copy(view("or"));
    }
    return copy(view("xor"));
}
fn float_op<a>(op: &a [u8]) -> u8[] {
    if eq(op, view("addsd")) {
        return copy(view("fadd"));
    }
    if eq(op, view("subsd")) {
        return copy(view("fsub"));
    }
    if eq(op, view("mulsd")) {
        return copy(view("fmul"));
    }
    return copy(view("fdiv"));
}

// ---- instructions ----

fn ends_terminator<a>(l: (&a mut L)) -> unit {
    l.term = 1;
    return ();
}
fn call_args<a>(l: (&a mut L)) -> u8[] {
    return call_args_n(&mut l, 6);
}
// The first `n` argument registers as a call's argument list.
fn call_args_n<a>(l: (&a mut L), n: u64) -> u8[] {
    names := u8[][copy(view("rdi")), copy(view("rsi")), copy(view("rdx")), copy(view("rcx")), copy(view("r8")), copy(view("r9"))];
    mut out = u8[];
    for i in n {
        if i != 0 {
            put(&mut out, view(", "));
        }
        put(&mut out, view("i64 "));
        if i < 6 {
            v := get_reg(&mut l, view(names[i]));
            put(&mut out, view(v));
        } else {
            // Past the registers: the outgoing area's words (lower_call checked it is open and
            // large enough).
            put(&mut out, view(l.area[i - 6]));
        }
    }
    return out;
}
// The runtime entries that end the process or abandon the calling stack, so nothing after a call to
// one is reached: the check failures compiled code calls (`rt_fail`, `rt_trap`, `rt_refine`,
// `rt_task_fail`), the reporters behind them, and the exits those end in. `rt_abort` is the same
// kind and has its own cold stub in `lower_call`.
fn never_returns<a>(target: &a [u8]) -> bool {
    return eq(target, view("rt_fail")) || eq(target, view("rt_trap")) || eq(target, view("rt_refine"))
        || eq(target, view("rt_task_fail")) || eq(target, view("rt_fail_text")) || eq(target, view("rt_report_die"))
        || eq(target, view("rt_abort_final")) || eq(target, view("rt_abort_park")) || eq(target, view("rt_hard_exit"))
        || eq(target, view("rt_stack_overflow")) || eq(target, view("rt_stack_overflow_at"));
}
// The accessors that return an element's address: `rt_slot` and `rt_slot4` check the index against
// `len` first, the `u` forms were handed a proven index.
fn address_accessor(name: (&[u8])) -> bool {
    return eq(name, view("rt_slot")) || eq(name, view("rt_slotu")) || eq(name, view("rt_slot4")) || eq(name, view("rt_slot4u"));
}
// An element address from the fields an F1 fact hoisted: the bounds check against the hoisted `len`
// (failing exactly as the accessor would - `rt_slot` reports the index, `rt_slot4` aborts), then a
// `getelementptr` on the hoisted `data` pointer. The address keeps the allocation's provenance, so
// LLVM can reason about it: the loop that does no more than this is one it can vectorise.
fn element_address(l: (&mut L), target: (&[u8]), k: u64, width: u64) -> unit {
    i := get_reg(&mut l, view("rsi"));
    if l.verify != 0 {
        // --verify-facts: the header this call was handed still holds the `data` and `len` the
        // fact hoisted. A SEQ-STABLE claim about a descriptor that did change - or a vector fact
        // whose staleness was missed - aborts here, on the first access after the change.
        h := def(&mut l, view("inttoptr i64 {} to ptr"), &u8[][copy(view(get_reg(&mut l, view("rdi"))))]);
        d := header_load(&mut l, view(h), 0);
        ln := header_load(&mut l, view(h), 8);
        sd := def(&mut l, view("icmp eq i64 {}, {}"), &u8[][d, copy(view(l.edata[k]))]);
        sl := def(&mut l, view("icmp eq i64 {}, {}"), &u8[][ln, copy(view(l.elen[k]))]);
        same := def(&mut l, view("and i1 {}, {}"), &u8[][sd, sl]);
        good := fresh_block(&mut l);
        wrong := fresh_block(&mut l);
        emit(&mut l, view("br i1 {}, label %{}, label %{}"), &u8[][same, copy(view(good)), copy(view(wrong))]);
        begin_block(&mut l, view(wrong));
        emit(&mut l, view("call void @\"rt_abort.cold\"() #0"), &u8[][]);
        emit(&mut l, view("unreachable"), &u8[][]);
        begin_block(&mut l, view(good));
    }
    if eq(target, view("rt_slot")) || eq(target, view("rt_slot4")) {
        ok := def(&mut l, view("icmp ult i64 {}, {}"), &u8[][copy(view(i)), copy(view(l.elen[k]))]);
        good := fresh_block(&mut l);
        wrong := fresh_block(&mut l);
        emit(&mut l, view("br i1 {}, label %{}, label %{}"), &u8[][ok, copy(view(good)), copy(view(wrong))]);
        begin_block(&mut l, view(wrong));
        // Both widths report the index and the length, as the native backend's inline check does.
        if eq(target, view("rt_slot")) || eq(target, view("rt_slot4")) {
            l.calls.push(copy(view("rt_fail")));
            emit(
                &mut l,
                view("call {i64, i64} @\"rt_fail\"(i64 1, i64 {}, i64 {}, i64 0, i64 0, i64 0)"),
                &u8[][copy(view(i)), copy(view(l.elen[k]))]
            );
        } else {
            emit(&mut l, view("call void @\"rt_abort.cold\"() #0"), &u8[][]);
        }
        emit(&mut l, view("unreachable"), &u8[][]);
        begin_block(&mut l, view(good));
    }
    off := def(&mut l, view("mul i64 {}, {}"), &u8[][copy(view(i)), copy_width(width)]);
    p := def(&mut l, view("getelementptr i8, ptr {}, i64 {}"), &u8[][copy(view(l.edptr[k])), off]);
    r := def(&mut l, view("ptrtoint ptr {} to i64"), &u8[][p]);
    set_reg(&mut l, view("rax"), view(r));
    set_chain(&mut l, reg_index(view("rax")) + 1, 0, 0, 0);
    set_chain(&mut l, reg_index(view("rdx")) + 1, 0, 0, 0);
    clear_args(&mut l);
    return ();
}
// The address of element `rsi` of a fixed-size array at `rdi` (docs/design/fixed-arrays.md):
// `rt_aslot` first compares the index with the constant length in `rdx` and fails as the accessor
// would; the address is a `getelementptr` on the array's own pointer, so it keeps the provenance
// of the frame aggregate or record the array lives in and LLVM can keep elements in registers.
fn array_element<a, b>(l: (&a mut L), target: &b [u8]) -> unit {
    base := get_reg(&mut l, view("rdi"));
    i := get_reg(&mut l, view("rsi"));
    mut w = get_reg(&mut l, view("rdx"));
    if eq(target, view("rt_aslot")) {
        n := get_reg(&mut l, view("rdx"));
        w = get_reg(&mut l, view("rcx"));
        ok := def(&mut l, view("icmp ult i64 {}, {}"), &u8[][copy(view(i)), copy(view(n))]);
        good := fresh_block(&mut l);
        wrong := fresh_block(&mut l);
        emit(&mut l, view("br i1 {}, label %{}, label %{}"), &u8[][ok, copy(view(good)), copy(view(wrong))]);
        begin_block(&mut l, view(wrong));
        l.calls.push(copy(view("rt_fail")));
        emit(&mut l, view("call {i64, i64} @\"rt_fail\"(i64 1, i64 {}, i64 {}, i64 0, i64 0, i64 0)"), &u8[][copy(view(i)), copy(view(n))]);
        emit(&mut l, view("unreachable"), &u8[][]);
        begin_block(&mut l, view(good));
    }
    p := def(&mut l, view("inttoptr i64 {} to ptr"), &u8[][base]);
    off := def(&mut l, view("mul i64 {}, {}"), &u8[][i, w]);
    e := def(&mut l, view("getelementptr inbounds i8, ptr {}, i64 {}"), &u8[][p, off]);
    r := def(&mut l, view("ptrtoint ptr {} to i64"), &u8[][e]);
    set_reg(&mut l, view("rax"), view(r));
    set_chain(&mut l, reg_index(view("rax")) + 1, 0, 0, 0);
    set_chain(&mut l, reg_index(view("rdx")) + 1, 0, 0, 0);
    clear_args(&mut l);
    return ();
}
fn lower_call<a, b, c>(l: (&a mut L), target: &b [u8], facts: (&c Facts)) -> unit {
    // A call hands the argument registers on; passing a stale %rdx is not reading a result.
    l.rdxdead = 0;
    // The argument loads this call was set up with; the next call's start afresh, whichever path
    // lowers this one.
    loaded := exchange(&mut l.argwritten, 0);
    fcode := set_get(&l.ffis, target);
    typed_ffi := (fcode > 1) && (set_get(&l.sigs, target) == 0) && (l.target == 0) && (l.areaopen == 0);
    if !typed_ffi {
        xmm_call(&mut l);
    }
    if l.areaopen != 0 {
        // Words on the stack: only a callee whose signature fact says it takes them.
        code := set_get(&l.sigs, target);
        if (code == 0) || (code / 4 <= 6) || (code / 4 - 6 > l.area.len()) {
            bad(&mut l);
            return ();
        }
    }
    // `call *%rax` is a Grail-convention call through a code pointer; a C call through a `cfn`
    // value is spelled `call *%r11` (native.grl) and, like an import thunk's, stays native.
    if eq(target, view("*%rax")) && (l.target == 0) {
        lower_indirect_call(&mut l, view(sub(target, 2, target.len())), &facts, loaded);
        return ();
    }
    if (target.len() == 0) || (target[0] == 42) {
        bad(&mut l);
        return ();
    }
    if eq(target, view("rt_abort")) {
        // Check failures never return and are never the hot path.
        emit(&mut l, view("call void @\"rt_abort.cold\"() #0"), &u8[][]);
        emit(&mut l, view("unreachable"), &u8[][]);
        ends_terminator(&mut l);
        return ();
    }
    if eq(target, view("rt_aslot")) || eq(target, view("rt_aslotu")) {
        array_element(&mut l, target);
        return ();
    }
    if eq(target, view("rt_f32_from_int")) {
        // An integer to the nearest f32, rounded once (ties to even), held widened: `sitofp` for a
        // signed source and `uitofp` for an unsigned one, chosen by the type code's signed bit as
        // the runtime's body chooses. The body halves the value in a loop and calls rt_f32_round;
        // this is the one instruction it computes.
        x := get_reg(&mut l, view("rdi"));
        code := get_reg(&mut l, view("rsi"));
        bit := def(&mut l, view("and i64 {}, 256"), &u8[][copy(view(code))]);
        signed := def(&mut l, view("icmp ne i64 {}, 0"), &u8[][bit]);
        sf := def(&mut l, view("sitofp i64 {} to float"), &u8[][copy(view(x))]);
        uf := def(&mut l, view("uitofp i64 {} to float"), &u8[][copy(view(x))]);
        n := def(&mut l, view("select i1 {}, float {}, float {}"), &u8[][signed, sf, uf]);
        w := def(&mut l, view("fpext float {} to double"), &u8[][n]);
        word := as_word(&mut l, view(w));
        set_reg(&mut l, view("rax"), view(word));
        return ();
    }
    if eq(target, view("rt_f32_round")) {
        // Rounding a binary64 word to the nearest f32 (ties to even) is fptrunc + fpext.
        x := get_reg(&mut l, view("rdi"));
        d := as_double(&mut l, view(x));
        n := def(&mut l, view("fptrunc double {} to float"), &u8[][d]);
        w := def(&mut l, view("fpext float {} to double"), &u8[][n]);
        word := as_word(&mut l, view(w));
        set_reg(&mut l, view("rax"), view(word));
        return ();
    }
    if eq(target, view("rt_f64_op")) {
        // F2: with a fact for this call, both operands are f32-valued words, so the operation is
        // a correctly rounded binary32 operation on the widened floats and the result is widened
        // back once. Bit-identical by p2 >= 2*p1 + 2 (53 >= 2*24 + 2), the same argument the
        // narrowing of `fptrunc (fmul (fpext a), (fpext b))` in stage 2a uses.
        ordinal := l.fordinal;
        l.fordinal += 1;
        op := call_op(&l, ordinal);
        if op != 0 {
            lhs := get_reg(&mut l, view("rsi"));
            rhs := get_reg(&mut l, view("rdx"));
            mut kind = copy(view("fadd"));
            if op == 42 {
                kind = copy(view("fmul"));
            }
            if op == 45 {
                kind = copy(view("fsub"));
            }
            if op == 47 {
                kind = copy(view("fdiv"));
            }
            put(&mut kind, view(" float {}, {}"));
            fa := float_of_word(&mut l, view(lhs));
            verify_fact(&mut l, view(lhs), view(fa));
            fb := float_of_word(&mut l, view(rhs));
            verify_fact(&mut l, view(rhs), view(fb));
            r := def(&mut l, view(kind), &u8[][fa, fb]);
            w := word_of_float(&mut l, view(r));
            set_reg(&mut l, view("rax"), view(w));
            return ();
        }
    }
    // The ordinal this call has among the calls to the same callee in this function: the key an
    // F1 call fact carries, counted in emission order on both sides of the table.
    ord := callee_ordinal(&mut l, view(target));
    // A call that may grow, fill or truncate the sequence it is given makes the `data`/`len`
    // hoisted for that slot stale; the fields are re-read once it returns.
    invalidate_args(&mut l, view(target));
    l.calls.push(copy(target));
    // A range fact proves the index this accessor is handed is below the sequence's length, so the
    // compare and its cold exit cannot fire: the accessor's body is emitted here with the check
    // removed (docs/design/typed-ir.md).
    if l.proof.len() > l.rline {
        if l.proof[l.rline] == 3 {
            which := rg_accessor(target);
            if which != 0 {
                unchecked_access(&mut l, which);
                return ();
            }
        }
    }
    hf := call_header_at(&l, &facts, view(target), ord);
    // A sibling takes six words: a call with words on the stack keeps the plain form.
    if (hf.width != 0) & (l.areaopen == 0) {
        kid := reg_index(view("rdi")) + 1;
        k := chain_slot(&l, kid);
        sn := sibling_name(view(target), hf.what, hf.width);
        mut have = 0;
        for i in l.sibnames.len() {
            if eq(view(l.sibnames[i]), view(sn)) {
                have = 1;
            }
        }
        // The fact is used only where the two words it hoists are already current *and* dominate
        // this call. Otherwise the call keeps the word lowering: an absent fact is always correct,
        // and a sibling call whose `data`/`len` had to be re-read here would be a longer instruction
        // sequence doing the same loads as the body it replaced.
        if (have != 0) & (chain_kind(&l, kid) == 1) & (k < l.hslots.len() + 4096) & reachable(&l, k) {
            if address_accessor(target) {
                element_address(&mut l, view(target), k, hf.width);
                return ();
            }
            a0 := get_reg(&mut l, view("rdi"));
            p := def(&mut l, view("inttoptr i64 {} to ptr"), &u8[][a0]);
            mut c = u8[];
            put(&mut c, view("call {i64, i64} @\""));
            put(&mut c, view(sn));
            put(&mut c, view("\"(ptr nocapture nofree dereferenceable(24) align 8 "));
            put(&mut c, view(p));
            for i in 5 {
                put(&mut c, view(", i64 "));
                put(&mut c, view(get_reg(&mut l, view(arg_reg(i + 1)))));
            }
            put(&mut c, view(", i64 "));
            put(&mut c, view(l.edata[k]));
            put(&mut c, view(", i64 "));
            put(&mut c, view(l.elen[k]));
            put(&mut c, view(")"));
            pair := def(&mut l, view(c), &u8[][]);
            r0 := def(&mut l, view("extractvalue {i64, i64} {}, 0"), &u8[][copy(view(pair))]);
            r1 := def(&mut l, view("extractvalue {i64, i64} {}, 1"), &u8[][pair]);
            if (l.verify != 0) & element_callee(target) {
                verify_element(&mut l, view(r0), view(copy(view(l.edata[k]))), view(copy(view(l.elen[k]))), hf.width);
            }
            set_reg(&mut l, view("rax"), view(r0));
            set_reg(&mut l, view("rdx"), view(r1));
            set_chain(&mut l, reg_index(view("rax")) + 1, 0, 0, 0);
            set_chain(&mut l, reg_index(view("rdx")) + 1, 0, 0, 0);
            clear_args(&mut l);
            refresh(&mut l);
            return ();
        }
    }
    // A callee with a signature fact gets exactly its argument words and gives back its result
    // words; any other gets the six argument registers and gives back rax:rdx.
    callee_sig := set_get(&l.sigs, target);
    mut nwords = 6;
    mut rwords = 2;
    if callee_sig != 0 {
        nwords = callee_sig / 4;
        rwords = callee_sig % 4;
    }
    if typed_ffi {
        lower_ffi_call(&mut l, target, fcode - 2);
        return ();
    }
    args := call_args_n(&mut l, nwords);
    mut c = u8[];
    put(&mut c, view("call "));
    put(&mut c, view(result_type(rwords)));
    put(&mut c, view(" @\""));
    put(&mut c, target);
    put(&mut c, view("\"({})"));
    pair := def(&mut l, view(c), &u8[][args]);
    if never_returns(target) {
        // A failed check reports and never comes back: it ends the process, or abandons this
        // stack for the scheduler's (rt_contain_tail). Saying so keeps the failure arm out of the
        // loop it guards - a returning call there clobbers every register the loop holds, which
        // is what kept spills and a merge in the body of every checked 8-byte element access.
        emit(&mut l, view("unreachable"), &u8[][]);
        ends_terminator(&mut l);
        return ();
    }
    if rwords == 1 {
        set_reg(&mut l, view("rax"), view(pair));
        set_chain(&mut l, reg_index(view("rax")) + 1, 0, 0, 0);
        set_chain(&mut l, reg_index(view("rdx")) + 1, 0, 0, 0);
        clear_args(&mut l);
        refresh(&mut l);
        l.rdxdead = 1;
        exchange(&mut l.rdxcallee, copy(target));
        return ();
    }
    r0 := def(&mut l, view("extractvalue {i64, i64} {}, 0"), &u8[][copy(view(pair))]);
    r1 := def(&mut l, view("extractvalue {i64, i64} {}, 1"), &u8[][pair]);
    set_reg(&mut l, view("rax"), view(r0));
    set_reg(&mut l, view("rdx"), view(r1));
    set_chain(&mut l, reg_index(view("rax")) + 1, 0, 0, 0);
    set_chain(&mut l, reg_index(view("rdx")) + 1, 0, 0, 0);
    clear_args(&mut l);
    refresh(&mut l);
    return ();
}

// `call *%reg`: a call through a code pointer (a closure's code word, a vtable slot, a function
// value). The target is not known here, so it gets the six argument words and gives back rax:rdx,
// which is the form every function whose address is taken keeps (`signatures`). x86-64 only: on
// AArch64 and RV64 a code pointer names the native-convention entry, which an IR call cannot reach
// without a thunk, so those bodies stay native.
fn lower_indirect_call<a, b, d>(l: (&a mut L), reg: &b [u8], facts: (&d Facts), loaded: u64) -> unit {
    // How many argument words this call passes (an indirect fact), 6 when nothing says. A fact is
    // checked against the argument registers written since the last call: one past its count was
    // set up for this call, so the fact is wrong (sig_wrong) and all six are passed.
    ord := callee_ordinal(&mut l, view("*%rax"));
    mut words = 6;
    for i in facts.items.len() {
        f := &facts.items[i];
        if (f.kind == 7) && (f.a == ord) && eq(view(f.fn), view(l.fname)) && (f.b <= 6) {
            words = f.b;
        }
    }
    if (words < 6) && ((loaded >> words) != 0) {
        mut why = copy(view("an indirect call passes "));
        num(&mut why, words);
        put(&mut why, view(" words but %"));
        mut hi = words;
        while ((loaded >> hi) & 1) == 0 {
            hi += 1;
        }
        put(&mut why, view(arg_reg(hi)));
        put(&mut why, view(" was loaded for it"));
        fname := copy(view(l.fname));
        sig_wrong(&mut l, view(fname), view(why));
        return ();
    }
    if l.areaopen != 0 {
        bad(&mut l);
        return ();
    }
    invalidate_args(&mut l, view("*"));
    fp := get_reg(&mut l, reg);
    p := def(&mut l, view("inttoptr i64 {} to ptr"), &u8[][fp]);
    mut args = call_args_n(&mut l, words);
    for i in 6 - words {
        if (words + i) != 0 {
            put(&mut args, view(", "));
        }
        put(&mut args, view("i64 poison"));
    }
    pair := def(&mut l, view("call {i64, i64} {}({})"), &u8[][p, args]);
    r0 := def(&mut l, view("extractvalue {i64, i64} {}, 0"), &u8[][copy(view(pair))]);
    r1 := def(&mut l, view("extractvalue {i64, i64} {}, 1"), &u8[][pair]);
    set_reg(&mut l, view("rax"), view(r0));
    set_reg(&mut l, view("rdx"), view(r1));
    set_chain(&mut l, reg_index(view("rax")) + 1, 0, 0, 0);
    set_chain(&mut l, reg_index(view("rdx")) + 1, 0, 0, 0);
    clear_args(&mut l);
    refresh(&mut l);
    return ();
}
// The body of a bounds-checked accessor with the check removed. A range fact proves the index the
// call is handed is below the sequence's length, so `if (i < len) == 0 { rt_abort(); }` -- the
// compare and the cold exit at the top of `rt_slot`/`rt_slot4`/`rt_slotb` and of the load wrappers
// above them -- cannot fire, and the address is `data + i*width` exactly as the accessor computes
// it. `--verify-facts` re-emits the check, so a fact that is wrong aborts on the spot instead of
// reading whatever is at the address.
fn unchecked_access(l: (&mut L), which: u64) -> unit {
    w := rg_width(which);
    h := get_reg(&mut l, view("rdi"));
    i := get_reg(&mut l, view("rsi"));
    hp := def(&mut l, view("inttoptr i64 {} to ptr"), &u8[][copy(view(h))]);
    d := def(&mut l, view("load i64, ptr {}, align 8"), &u8[][copy(view(hp))]);
    if l.verify != 0 {
        lp := def(&mut l, view("getelementptr i8, ptr {}, i64 8"), &u8[][copy(view(hp))]);
        ln := def(&mut l, view("load i64, ptr {}, align 8"), &u8[][lp]);
        ok := def(&mut l, view("icmp ult i64 {}, {}"), &u8[][copy(view(i)), ln]);
        good := fresh_block(&mut l);
        wrong := fresh_block(&mut l);
        emit(&mut l, view("br i1 {}, label %{}, label %{}"), &u8[][ok, copy(view(good)), copy(view(wrong))]);
        begin_block(&mut l, view(wrong));
        emit(&mut l, view("call void @\"rt_abort.cold\"() #0"), &u8[][]);
        emit(&mut l, view("unreachable"), &u8[][]);
        begin_block(&mut l, view(good));
    }
    off := def(&mut l, view("mul i64 {}, {}"), &u8[][copy(view(i)), copy_width(w)]);
    a := def(&mut l, view("add i64 {}, {}"), &u8[][d, off]);
    mut res = copy(view(a));
    if which >= 4 {
        ap := def(&mut l, view("inttoptr i64 {} to ptr"), &u8[][copy(view(a))]);
        ty := width_type(8 * w);
        al := copy_width(w);
        v := def(&mut l, view("load {}, ptr {}, align {}"), &u8[][copy(view(ty)), ap, al]);
        if w != 8 {
            res = def(&mut l, view("zext {} {} to i64"), &u8[][ty, v]);
        } else {
            res = copy(view(v));
        }
    }
    set_reg(&mut l, view("rax"), view(res));
    set_reg(&mut l, view("rdx"), view("0"));
    set_chain(&mut l, reg_index(view("rax")) + 1, 0, 0, 0);
    set_chain(&mut l, reg_index(view("rdx")) + 1, 0, 0, 0);
    clear_args(&mut l);
    refresh(&mut l);
    return ();
}
fn wide<a, b>(l: (&a mut L), v: &b [u8]) -> u8[] {
    return def(&mut l, view("zext i64 {} to i128"), &u8[][copy(v)]);
}
fn narrow<a, b>(l: (&a mut L), v: &b [u8]) -> u8[] {
    return def(&mut l, view("trunc i128 {} to i64"), &u8[][copy(v)]);
}
// ---- atomics -----------------------------------------------------------------------------------
// The stream's `atom.*` ops (machine.grl, "atomics") with their real orderings: an acquire load is
// `load atomic ... acquire`, not a plain load and a `fence seq_cst`. The cell is one i64 holding the
// value extended to 64 bits, so every access is an i64; a narrow add/sub wraps at its width through
// a `cmpxchg weak` loop that truncates and re-extends the sum.
fn atom_order_name(order: u64) -> u8[] {
    if order == 0 {
        return copy(view("monotonic"));
    }
    if order == 1 {
        return copy(view("acquire"));
    }
    if order == 2 {
        return copy(view("release"));
    }
    if order == 3 {
        return copy(view("acq_rel"));
    }
    return copy(view("seq_cst"));
}
// The C++ rule for a derived failure order: acquire for acquire/acqrel, relaxed for relaxed/release.
fn atom_failure_name(order: u64) -> u8[] {
    if order == 4 {
        return copy(view("seq_cst"));
    }
    if (order == 1) || (order == 3) {
        return copy(view("acquire"));
    }
    return copy(view("monotonic"));
}
fn atom_cas<a, b, c, d>(l: (&a mut L), weak: u64, p: &b [u8], expected: &c [u8], new: &d [u8], order: u64) -> u8[] {
    mut t = u8[];
    put(&mut t, view("cmpxchg "));
    if weak != 0 {
        put(&mut t, view("weak "));
    }
    put(&mut t, view("ptr {}, i64 {}, i64 {} "));
    put(&mut t, view(atom_order_name(order)));
    put(&mut t, view(" "));
    put(&mut t, view(atom_failure_name(order)));
    put(&mut t, view(", align 8"));
    return def(&mut l, view(t), &u8[][copy(p), copy(expected), copy(new)]);
}
// ---- SIMD -------------------------------------------------------------------------------------
// A `simd.` line (machine.grl, "SIMD") as vector IR: each operand a load of `<N x T>` from its frame
// aggregate or element address, the result one store, so SROA keeps a vector the function does not
// let escape in a register and the target's lowering picks the instructions. The semantics are the
// ones the native lowering computes lane by lane: ordered compares (une for ne), min/max with the
// NaN and tie rule of the scalar min/max, and `sum` as the fixed halving tree.
fn simd_elem<a>(s: (&a machine::Simd)) -> u8[] {
    if s.elem == 1 {
        if s.bits == 32 {
            return copy(view("float"));
        }
        return copy(view("double"));
    }
    if s.bits == 8 {
        return copy(view("i8"));
    }
    if s.bits == 32 {
        return copy(view("i32"));
    }
    return copy(view("i64"));
}
fn simd_int_elem<a>(s: (&a machine::Simd)) -> u8[] {
    if s.bits == 8 {
        return copy(view("i8"));
    }
    if s.bits == 32 {
        return copy(view("i32"));
    }
    return copy(view("i64"));
}
fn simd_vec<a>(lanes: u64, e: &a [u8]) -> u8[] {
    mut t = copy(view("<"));
    num(&mut t, lanes);
    put(&mut t, view(" x "));
    put(&mut t, e);
    put(&mut t, view(">"));
    return t;
}
fn simd_align<a>(s: (&a machine::Simd)) -> u8[] {
    mut t = copy(view(", align "));
    num(&mut t, s.bits / 8);
    return t;
}
fn simd_load<a, b, d>(l: (&a mut L), vt: &b [u8], p: &d [u8], s: (&machine::Simd)) -> u8[] {
    mut t = copy(view("load "));
    put(&mut t, vt);
    put(&mut t, view(", ptr {}"));
    put(&mut t, view(simd_align(&s)));
    return def(&mut l, view(t), &u8[][copy(p)]);
}
fn simd_store<a, b, d, e>(l: (&a mut L), vt: &b [u8], v: &d [u8], p: &e [u8], s: (&machine::Simd)) -> unit {
    mut t = copy(view("store "));
    put(&mut t, vt);
    put(&mut t, view(" {}, ptr {}"));
    put(&mut t, view(simd_align(&s)));
    emit(&mut l, view(t), &u8[][copy(v), copy(p)]);
    return ();
}
fn simd_op2<a, b, d, e, f>(l: (&a mut L), instr: &b [u8], vt: &d [u8], x: &e [u8], y: &f [u8]) -> u8[] {
    mut t = copy(instr);
    put(&mut t, view(" "));
    put(&mut t, vt);
    put(&mut t, view(" {}, {}"));
    return def(&mut l, view(t), &u8[][copy(x), copy(y)]);
}
fn simd_select<a, b, d, e, f, g>(l: (&a mut L), lanes: u64, cond: &b [u8], vt: &d [u8], x: &e [u8], y: &f [u8], unused: &g [u8]) -> u8[] {
    mut t = copy(view("select "));
    put(&mut t, view(simd_vec(lanes, view("i1"))));
    put(&mut t, view(" {}, "));
    put(&mut t, vt);
    put(&mut t, view(" {}, "));
    put(&mut t, vt);
    put(&mut t, view(" {}"));
    return def(&mut l, view(t), &u8[][copy(cond), copy(x), copy(y)]);
}
// A vector constant of `lanes` copies of `value` of element type `e`.
fn simd_splat_const<a, b>(lanes: u64, e: &a [u8], value: &b [u8]) -> u8[] {
    mut t = copy(view("<"));
    for i in lanes {
        if i != 0 {
            put(&mut t, view(", "));
        }
        put(&mut t, e);
        put(&mut t, view(" "));
        put(&mut t, value);
    }
    put(&mut t, view(">"));
    return t;
}
fn simd_indices(from: u64, count: u64) -> u8[] {
    mut t = copy(view("<"));
    for i in count {
        if i != 0 {
            put(&mut t, view(", "));
        }
        put(&mut t, view("i32 "));
        num(&mut t, from + i);
    }
    put(&mut t, view(">"));
    return t;
}
// A lane value (an element of type `e`) as the word %rax holds: an f32 widened to binary64, an f64's
// bits, an i32 sign-extended.
fn simd_word<a, b, d>(l: (&a mut L), s: (&b machine::Simd), e: &d [u8]) -> unit {
    mut v = copy(e);
    if (s.elem == 1) & (s.bits == 32) {
        d := def(&mut l, view("fpext float {} to double"), &u8[][v]);
        v = def(&mut l, view("bitcast double {} to i64"), &u8[][d]);
    } else if s.elem == 1 {
        v = def(&mut l, view("bitcast double {} to i64"), &u8[][v]);
    } else if s.bits != 64 {
        mut t = copy(view("sext i"));
        if s.elem == 4 {
            t = copy(view("zext i"));
        }
        num(&mut t, s.bits);
        put(&mut t, view(" {} to i64"));
        v = def(&mut l, view(t), &u8[][v]);
    }
    set_reg(&mut l, view("rax"), view(v));
    return ();
}
fn lift_simd<a, b>(l: (&a mut L), line: &b [u8]) -> unit {
    s := machine::simd_parse(line);
    n := s.lanes;
    e := simd_elem(&s);
    ie := simd_int_elem(&s);
    vt := simd_vec(n, view(e));
    vi := simd_vec(n, view(ie));
    float := s.elem == 1;
    op := s.op;
    pd := address(&mut l, view("(%rdi)"));
    if op <= 9 {
        pa := address(&mut l, view("(%rsi)"));
        pb := address(&mut l, view("(%rdx)"));
        mut ty = copy(view(vt));
        if (5 <= op) && (op <= 7) {
            ty = copy(view(vi));
        }
        a := simd_load(&mut l, view(ty), view(pa), &s);
        b := simd_load(&mut l, view(ty), view(pb), &s);
        mut r = u8[];
        if op <= 4 {
            mut name = "add";
            if op == 2 {
                name = "sub";
            }
            if op == 3 {
                name = "mul";
            }
            if op == 4 {
                name = "div";
            }
            mut instr = u8[];
            if float {
                instr.push(102);
            }
            put(&mut instr, view(name));
            r = simd_op2(&mut l, view(instr), view(ty), view(a), view(b));
        } else if op <= 7 {
            mut name = "and";
            if op == 6 {
                name = "or";
            }
            if op == 7 {
                name = "xor";
            }
            r = simd_op2(&mut l, view(name), view(ty), view(a), view(b));
        } else if float {
            mut lt = u8[];
            if op == 8 {
                lt = simd_op2(&mut l, view("fcmp olt"), view(vt), view(b), view(a));
            } else {
                lt = simd_op2(&mut l, view("fcmp olt"), view(vt), view(a), view(b));
            }
            r1 := simd_select(&mut l, n, view(lt), view(vt), view(b), view(a), view(""));
            nb := simd_op2(&mut l, view("fcmp uno"), view(vt), view(b), view(b));
            r2 := simd_select(&mut l, n, view(nb), view(vt), view(a), view(r1), view(""));
            na := simd_op2(&mut l, view("fcmp uno"), view(vt), view(a), view(a));
            r = simd_select(&mut l, n, view(na), view(vt), view(b), view(r2), view(""));
        } else {
            mut lt = u8[];
            mut pred = "icmp slt";
            if s.elem == 4 {
                pred = "icmp ult";
            }
            if op == 8 {
                lt = simd_op2(&mut l, view(pred), view(vt), view(b), view(a));
            } else {
                lt = simd_op2(&mut l, view(pred), view(vt), view(a), view(b));
            }
            r = simd_select(&mut l, n, view(lt), view(vt), view(b), view(a), view(""));
        }
        simd_store(&mut l, view(ty), view(r), view(pd), &s);
        return ();
    }
    if op <= 15 {
        pa := address(&mut l, view("(%rsi)"));
        pb := address(&mut l, view("(%rdx)"));
        a := simd_load(&mut l, view(vt), view(pa), &s);
        b := simd_load(&mut l, view(vt), view(pb), &s);
        mut pred = u8[];
        if float {
            fp := u8[][copy(view("fcmp oeq")), copy(view("fcmp une")), copy(view("fcmp olt")), copy(view("fcmp ole")), copy(view("fcmp ogt")), copy(view("fcmp oge"))];
            pred = fp[op - 10].copy();
        } else {
            mut ip = u8[][copy(view("icmp eq")), copy(view("icmp ne")), copy(view("icmp slt")), copy(view("icmp sle")), copy(view("icmp sgt")), copy(view("icmp sge"))];
            if s.elem == 4 {
                ip = u8[][copy(view("icmp eq")), copy(view("icmp ne")), copy(view("icmp ult")), copy(view("icmp ule")), copy(view("icmp ugt")), copy(view("icmp uge"))];
            }
            pred = ip[op - 10].copy();
        }
        c := simd_op2(&mut l, view(pred), view(vt), view(a), view(b));
        mut t = copy(view("sext "));
        put(&mut t, view(simd_vec(n, view("i1"))));
        put(&mut t, view(" {} to "));
        put(&mut t, view(vi));
        m := def(&mut l, view(t), &u8[][c]);
        simd_store(&mut l, view(vi), view(m), view(pd), &s);
        return ();
    }
    if op == 16 {
        pm := address(&mut l, view("(%rsi)"));
        pa := address(&mut l, view("(%rdx)"));
        pb := address(&mut l, view("(%rcx)"));
        m := simd_load(&mut l, view(vi), view(pm), &s);
        c := simd_op2(&mut l, view("icmp ne"), view(vi), view(m), view("zeroinitializer"));
        a := simd_load(&mut l, view(vt), view(pa), &s);
        b := simd_load(&mut l, view(vt), view(pb), &s);
        r := simd_select(&mut l, n, view(c), view(vt), view(a), view(b), view(""));
        simd_store(&mut l, view(vt), view(r), view(pd), &s);
        return ();
    }
    if op == 17 {
        pa := address(&mut l, view("(%rsi)"));
        a := simd_load(&mut l, view(vi), view(pa), &s);
        r := simd_op2(&mut l, view("xor"), view(vi), view(a), view(simd_splat_const(n, view(ie), view("-1"))));
        simd_store(&mut l, view(vi), view(r), view(pd), &s);
        return ();
    }
    if (op == 18) || (op == 24) {
        w := get_reg(&mut l, view("rax"));
        mut x = copy(view(w));
        if s.elem == 3 {
            x = def(&mut l, view("sub i64 0, {}"), &u8[][x]);
        }
        if float & (s.bits == 32) {
            d := def(&mut l, view("bitcast i64 {} to double"), &u8[][x]);
            x = def(&mut l, view("fptrunc double {} to float"), &u8[][d]);
        } else if float {
            x = def(&mut l, view("bitcast i64 {} to double"), &u8[][x]);
        } else if s.bits != 64 {
            mut t = copy(view("trunc i64 {} to i"));
            num(&mut t, s.bits);
            x = def(&mut l, view(t), &u8[][x]);
        }
        if op == 24 {
            old := simd_load(&mut l, view(vt), view(pd), &s);
            mut t = copy(view("insertelement "));
            put(&mut t, view(vt));
            put(&mut t, view(" {}, "));
            put(&mut t, view(e));
            put(&mut t, view(" {}, i32 "));
            num(&mut t, s.k);
            v := def(&mut l, view(t), &u8[][old, x]);
            simd_store(&mut l, view(vt), view(v), view(pd), &s);
            return ();
        }
        mut t = copy(view("insertelement "));
        put(&mut t, view(vt));
        put(&mut t, view(" poison, "));
        put(&mut t, view(e));
        put(&mut t, view(" {}, i32 0"));
        v0 := def(&mut l, view(t), &u8[][x]);
        mut u = copy(view("shufflevector "));
        put(&mut u, view(vt));
        put(&mut u, view(" {}, "));
        put(&mut u, view(vt));
        put(&mut u, view(" poison, "));
        put(&mut u, view(simd_vec(n, view("i32"))));
        put(&mut u, view(" zeroinitializer"));
        v := def(&mut l, view(u), &u8[][v0]);
        simd_store(&mut l, view(vt), view(v), view(pd), &s);
        return ();
    }
    if op == 19 {
        pa := address(&mut l, view("(%rsi)"));
        v := simd_load(&mut l, view(vt), view(pa), &s);
        mut t = copy(view("extractelement "));
        put(&mut t, view(vt));
        put(&mut t, view(" {}, i32 "));
        num(&mut t, s.k);
        x := def(&mut l, view(t), &u8[][v]);
        simd_word(&mut l, &s, view(x));
        return ();
    }
    if op == 20 {
        pa := address(&mut l, view("(%rsi)"));
        mut v = simd_load(&mut l, view(vt), view(pa), &s);
        mut m = n;
        while 1 < m {
            h := m / 2;
            mvt := simd_vec(m, view(e));
            hvt := simd_vec(h, view(e));
            mut t = copy(view("shufflevector "));
            put(&mut t, view(mvt));
            put(&mut t, view(" {}, "));
            put(&mut t, view(mvt));
            put(&mut t, view(" poison, "));
            put(&mut t, view(simd_vec(h, view("i32"))));
            put(&mut t, view(" "));
            mut lo_t = copy(view(t));
            put(&mut lo_t, view(simd_indices(0, h)));
            mut hi_t = copy(view(t));
            put(&mut hi_t, view(simd_indices(h, h)));
            lo := def(&mut l, view(lo_t), &u8[][copy(view(v))]);
            hi := def(&mut l, view(hi_t), &u8[][copy(view(v))]);
            if float {
                v = simd_op2(&mut l, view("fadd"), view(hvt), view(lo), view(hi));
            } else {
                v = simd_op2(&mut l, view("add"), view(hvt), view(lo), view(hi));
            }
            m = h;
        }
        mut t = copy(view("extractelement "));
        put(&mut t, view(simd_vec(1, view(e))));
        put(&mut t, view(" {}, i32 0"));
        x := def(&mut l, view(t), &u8[][v]);
        simd_word(&mut l, &s, view(x));
        return ();
    }
    if op == 21 {
        pa := address(&mut l, view("(%rsi)"));
        v := simd_load(&mut l, view(vt), view(pa), &s);
        simd_store(&mut l, view(vt), view(v), view(pd), &s);
        return ();
    }
    if op == 27 {
        pa := address(&mut l, view("(%rsi)"));
        pb := address(&mut l, view("(%rdx)"));
        a := simd_load(&mut l, view(vt), view(pa), &s);
        b := simd_load(&mut l, view(vt), view(pb), &s);
        mut t = copy(view("shufflevector "));
        put(&mut t, view(vt));
        put(&mut t, view(" {}, "));
        put(&mut t, view(vt));
        put(&mut t, view(" {}, <"));
        num(&mut t, n);
        put(&mut t, view(" x i32> <"));
        for i in n {
            if i != 0 {
                put(&mut t, view(", "));
            }
            put(&mut t, view("i32 "));
            num(&mut t, s.idx[i]);
        }
        put(&mut t, view(">"));
        r := def(&mut l, view(t), &u8[][a, b]);
        simd_store(&mut l, view(vt), view(r), view(pd), &s);
        return ();
    }
    if (op == 28) || (op == 29) {
        pa := address(&mut l, view("(%rsi)"));
        ft := simd_vec(n, view("float"));
        it := simd_vec(n, view("i32"));
        if op == 28 {
            a := simd_load(&mut l, view(it), view(pa), &s);
            mut t = copy(view("sitofp "));
            put(&mut t, view(it));
            put(&mut t, view(" {} to "));
            put(&mut t, view(ft));
            r := def(&mut l, view(t), &u8[][a]);
            simd_store(&mut l, view(ft), view(r), view(pd), &s);
            return ();
        }
        // Truncation toward zero, saturated, a NaN lane 0: a select over the lanes fptosi would make
        // poison for (selecting another operand there is defined).
        a := simd_load(&mut l, view(ft), view(pa), &s);
        mut t = copy(view("fptosi "));
        put(&mut t, view(ft));
        put(&mut t, view(" {} to "));
        put(&mut t, view(it));
        r0 := def(&mut l, view(t), &u8[][copy(view(a))]);
        hi := simd_op2(&mut l, view("fcmp oge"), view(ft), view(a), view(simd_splat_const(n, view("float"), view("0x41E0000000000000"))));
        lo := simd_op2(&mut l, view("fcmp olt"), view(ft), view(a), view(simd_splat_const(n, view("float"), view("0xC1E0000000000000"))));
        nan := simd_op2(&mut l, view("fcmp uno"), view(ft), view(a), view(a));
        r1 := simd_select(&mut l, n, view(hi), view(it), view(simd_splat_const(n, view("i32"), view("2147483647"))), view(r0), view(""));
        r2 := simd_select(&mut l, n, view(lo), view(it), view(simd_splat_const(n, view("i32"), view("-2147483648"))), view(r1), view(""));
        r := simd_select(&mut l, n, view(nan), view(it), view("zeroinitializer"), view(r2), view(""));
        simd_store(&mut l, view(it), view(r), view(pd), &s);
        return ();
    }
    if (op == 30) || (op == 31) {
        // The aligned copies: copya's source (load_aligned) and copyd's destination
        // (store_aligned) were checked to be aligned to the vector's size first.
        pa := address(&mut l, view("(%rsi)"));
        mut load_align = s.bits / 8;
        mut store_align = s.bits / 8;
        if op == 30 {
            load_align = n * s.bits / 8;
        } else {
            store_align = n * s.bits / 8;
        }
        mut t = copy(view("load "));
        put(&mut t, view(vt));
        put(&mut t, view(", ptr {}, align "));
        num(&mut t, load_align);
        v := def(&mut l, view(t), &u8[][pa]);
        mut u = copy(view("store "));
        put(&mut u, view(vt));
        put(&mut u, view(" {}, ptr {}, align "));
        num(&mut u, store_align);
        emit(&mut l, view(u), &u8[][v, pd]);
        return ();
    }
    if op == 25 {
        // The vector as the two words of a result, by a bitcast: every access to the vector's
        // storage stays `<N x T>`, which is what lets SROA keep it in a register across an inlined
        // call.
        pa := address(&mut l, view("(%rsi)"));
        v := simd_load(&mut l, view(vt), view(pa), &s);
        mut t = copy(view("bitcast "));
        put(&mut t, view(vt));
        put(&mut t, view(" {} to <2 x i64>"));
        w := def(&mut l, view(t), &u8[][v]);
        lo := def(&mut l, view("extractelement <2 x i64> {}, i32 0"), &u8[][copy(view(w))]);
        hi := def(&mut l, view("extractelement <2 x i64> {}, i32 1"), &u8[][w]);
        set_reg(&mut l, view("rax"), view(lo));
        set_reg(&mut l, view("rdx"), view(hi));
        return ();
    }
    if op == 26 {
        lo := get_reg(&mut l, view("rax"));
        hi := get_reg(&mut l, view("rdx"));
        w0 := def(&mut l, view("insertelement <2 x i64> poison, i64 {}, i32 0"), &u8[][lo]);
        w := def(&mut l, view("insertelement <2 x i64> {}, i64 {}, i32 1"), &u8[][w0, hi]);
        mut t = copy(view("bitcast <2 x i64> {} to "));
        put(&mut t, view(vt));
        v := def(&mut l, view(t), &u8[][w]);
        simd_store(&mut l, view(vt), view(v), view(pd), &s);
        return ();
    }
    pa := address(&mut l, view("(%rsi)"));
    m := simd_load(&mut l, view(vi), view(pa), &s);
    c := simd_op2(&mut l, view("icmp ne"), view(vi), view(m), view("zeroinitializer"));
    mut t = copy(view("bitcast "));
    put(&mut t, view(simd_vec(n, view("i1"))));
    put(&mut t, view(" {} to i"));
    num(&mut t, n);
    bitsv := def(&mut l, view(t), &u8[][c]);
    mut u = copy(view("icmp "));
    if op == 22 {
        put(&mut u, view("ne i"));
        num(&mut u, n);
        put(&mut u, view(" {}, 0"));
    } else {
        put(&mut u, view("eq i"));
        num(&mut u, n);
        put(&mut u, view(" {}, -1"));
    }
    r := def(&mut l, view(u), &u8[][bitsv]);
    z := def(&mut l, view("zext i1 {} to i64"), &u8[][r]);
    set_reg(&mut l, view("rax"), view(z));
    return ();
}
fn lift_atom<a, b>(l: (&a mut L), line: &b [u8]) -> unit {
    a := machine::atom_parse(line);
    ord := atom_order_name(a.order);
    if a.kind == 7 {
        if l.target == 0 {
            emit(&mut l, view("call void asm sideeffect \"pause\", \"\"()"), &u8[][]);
        }
        if l.target == 1 {
            emit(&mut l, view("call void asm sideeffect \"yield\", \"\"()"), &u8[][]);
        }
        if l.target == 2 {
            emit(&mut l, view("call void asm sideeffect \".4byte 0x0100000f\", \"\"()"), &u8[][]);
        }
        return ();
    }
    if a.kind == 6 {
        mut t = u8[];
        put(&mut t, view("fence "));
        put(&mut t, view(ord));
        emit(&mut l, view(t), &u8[][]);
        return ();
    }
    p := address(&mut l, view("(%rdi)"));
    if a.kind == 1 {
        mut t = u8[];
        put(&mut t, view("load atomic i64, ptr {} "));
        put(&mut t, view(ord));
        put(&mut t, view(", align 8"));
        v := def(&mut l, view(t), &u8[][p]);
        set_reg(&mut l, view("rax"), view(v));
        return ();
    }
    if a.kind == 2 {
        v := get_reg(&mut l, view("rax"));
        mut t = u8[];
        put(&mut t, view("store atomic i64 {}, ptr {} "));
        put(&mut t, view(ord));
        put(&mut t, view(", align 8"));
        emit(&mut l, view(t), &u8[][v, p]);
        return ();
    }
    if (a.kind == 4) || (a.kind == 5) {
        expected := get_reg(&mut l, view("rax"));
        new := get_reg(&mut l, view("rcx"));
        mut weak = 0;
        if a.kind == 5 {
            weak = 1;
        }
        r := atom_cas(&mut l, weak, view(p), view(expected), view(new), a.order);
        if a.kind == 4 {
            old := def(&mut l, view("extractvalue {i64, i1} {}, 0"), &u8[][r]);
            set_reg(&mut l, view("rax"), view(old));
        } else {
            ok := def(&mut l, view("extractvalue {i64, i1} {}, 1"), &u8[][r]);
            z := def(&mut l, view("zext i1 {} to i64"), &u8[][ok]);
            set_reg(&mut l, view("rax"), view(z));
        }
        return ();
    }
    v := get_reg(&mut l, view("rax"));
    if (a.bits != 64) & ((a.op == 2) || (a.op == 3)) {
        again := fresh_block(&mut l);
        done := fresh_block(&mut l);
        emit(&mut l, view("br label %{}"), &u8[][copy(view(again))]);
        begin_block(&mut l, view(again));
        old := def(&mut l, view("load atomic i64, ptr {} monotonic, align 8"), &u8[][copy(view(p))]);
        mut sum = u8[];
        if a.op == 2 {
            sum = def(&mut l, view("add i64 {}, {}"), &u8[][copy(view(old)), copy(view(v))]);
        } else {
            sum = def(&mut l, view("sub i64 {}, {}"), &u8[][copy(view(old)), copy(view(v))]);
        }
        mut t = u8[];
        put(&mut t, view("trunc i64 {} to i"));
        num(&mut t, a.bits);
        cut := def(&mut l, view(t), &u8[][sum]);
        mut e = u8[];
        if a.signed != 0 {
            put(&mut e, view("sext i"));
        } else {
            put(&mut e, view("zext i"));
        }
        num(&mut e, a.bits);
        put(&mut e, view(" {} to i64"));
        new := def(&mut l, view(e), &u8[][cut]);
        r := atom_cas(&mut l, 1, view(p), view(old), view(new), a.order);
        ok := def(&mut l, view("extractvalue {i64, i1} {}, 1"), &u8[][r]);
        emit(&mut l, view("br i1 {}, label %{}, label %{}"), &u8[][ok, copy(view(done)), copy(view(again))]);
        begin_block(&mut l, view(done));
        set_reg(&mut l, view("rax"), view(old));
        return ();
    }
    mut name = "xchg";
    if a.op == 2 {
        name = "add";
    }
    if a.op == 3 {
        name = "sub";
    }
    if a.op == 4 {
        name = "and";
    }
    if a.op == 5 {
        name = "or";
    }
    if a.op == 6 {
        name = "xor";
    }
    if a.op == 7 {
        if a.signed != 0 {
            name = "min";
        } else {
            name = "umin";
        }
    }
    if a.op == 8 {
        if a.signed != 0 {
            name = "max";
        } else {
            name = "umax";
        }
    }
    mut t = u8[];
    put(&mut t, view("atomicrmw "));
    put(&mut t, view(name));
    put(&mut t, view(" ptr {}, i64 {} "));
    put(&mut t, view(ord));
    put(&mut t, view(", align 8"));
    old := def(&mut l, view(t), &u8[][p, v]);
    set_reg(&mut l, view("rax"), view(old));
    return ();
}
fn instruction<a, b, c>(l: (&a mut L), line: &b [u8], facts: (&c Facts)) -> unit {
    mut space = line.len();
    for i in line.len() {
        if (line[i] == 32) & (space == line.len()) {
            space = i;
        }
    }
    mut op = sub(line, 0, space);
    mut rest = u8[];
    if space + 1 < line.len() {
        rest = trim(line[space + 1: line.len()]);
    }
    if starts(view(op), view("atom.")) {
        lift_atom(&mut l, view(line));
        return ();
    }
    if starts(view(op), view("simd.")) {
        lift_simd(&mut l, view(line));
        // The line consumes its address registers (the native expansion uses them as scratch, and
        // native.grl loads all four again before the next line). Leaving the vectors' addresses in
        // them would hand them to every later call the lifter writes - a check's cold `rt_trap` gets
        // the registers as arguments - and an alloca whose address escapes is never promoted.
        s := machine::simd_parse(view(line));
        set_reg(&mut l, view("rdi"), view("0"));
        set_reg(&mut l, view("rsi"), view("0"));
        if s.op != 25 {
            set_reg(&mut l, view("rdx"), view("0"));
        }
        set_reg(&mut l, view("rcx"), view("0"));
        if (s.op != 19) & (s.op != 20) & (s.op != 22) & (s.op != 23) & (s.op != 25) {
            set_reg(&mut l, view("rax"), view("0"));
        }
        return ();
    }
    if area_instruction(&mut l, view(op), view(rest)) {
        return ();
    }
    // An argument load as load_call_args emits it - a frame slot into an argument register - for
    // lower_indirect_call's check of its word count. The arguments are loaded in one run of moves
    // right before the call, so any other instruction (a division's operand load is followed by its
    // `idivq`, a compare by its jump) starts the count again.
    if !starts(view(op), view("mov")) && !starts(view(op), view("lea")) && !eq(view(op), view("call")) {
        l.argwritten = 0;
    }
    if eq(view(op), view("movq")) && has(view(rest), view("(%rbp),%")) {
        mut pc = rest.len();
        while (pc > 0) && (rest[pc - 1] != 37) {
            pc -= 1;
        }
        ai := arg_index(view(sub(view(rest), pc, rest.len())));
        if (ai < 6) && (pc >= 8) && (rest[pc - 2] == 44) {
            l.argwritten = l.argwritten | (1 << ai);
        }
    }
    o := operands(view(rest));
    n := o.len();
    if eq(view(op), view("movq")) && (n == 2) && (l.target == 0) && starts(view(o[0]), view("%fs:")) {
        // The thread pointer (raw_tp_get): `%fs:0` is the Grail record, `%fs:SYM@tpoff` a TLS word.
        // It is inline assembly with a side effect so LLVM never merges two reads: a green task
        // can resume on another OS thread between them. Without this the whole function stayed in
        // the unoptimised native stream - rt_current, the mutex fast path, the allocator's threaded
        // path among them. The memory clobber keeps loads and stores of the thread's record on the
        // right side of the read, too. (The pool::split crash once blamed on this lift was an
        // escaped two-word slot lowered as one word: escaped_overreach.)
        mut asm = copy(view("call i64 asm sideeffect \"movq "));
        put(&mut asm, view(o[0]));
        put(&mut asm, view(", $0\", \"=r,~{memory}\"()"));
        v := def(&mut l, view(asm), &u8[][]);
        store(&mut l, view(o[1]), view(v), 64);
        return ();
    }
    if eq(view(op), view("movq")) && (n == 2) && (l.target == 0) && starts(view(o[1]), view("%fs:")) {
        // Publishing this thread's record (raw_tp_set with libc loaded): a TLS word written by
        // inline assembly, ordered like the reads above.
        v := value(&mut l, view(o[0]), 64);
        mut asm = copy(view("call void asm sideeffect \"movq $0, "));
        put(&mut asm, view(o[1]));
        put(&mut asm, view("\", \"r,~{memory}\"(i64 {})"));
        emit(&mut l, view(asm), &u8[][v]);
        return ();
    }
    if eq(view(op), view("movq")) || eq(view(op), view("movabsq")) {
        if n != 2 {
            bad(&mut l);
            return ();
        }
        sk := op_chain_kind(&l, view(o[0]));
        ss := op_chain_slot(&l, view(o[0]));
        so := op_chain_off(&l, view(o[0]));
        v := value(&mut l, view(o[0]), 64);
        hk := header_operand(&l, view(o[1]));
        store(&mut l, view(o[1]), view(v), 64);
        set_chain(&mut l, storage_of(&l, view(o[1])), sk, ss, so);
        if hk != 0 {
            // The fact is established here: this word is the header, so `data` and `len` are read
            // once on this path and the region that follows uses those two words.
            establish(&mut l, hk - 1, view(v));
        }
        return ();
    }
    if eq(view(op), view("movl")) || eq(view(op), view("movb")) {
        if n != 2 {
            bad(&mut l);
            return ();
        }
        mut w: u64 = 32;
        if eq(view(op), view("movb")) {
            w = 8;
        }
        v := value(&mut l, view(o[0]), w);
        store(&mut l, view(o[1]), view(v), w);
        return ();
    }
    if eq(view(op), view("movzbq")) {
        v := value(&mut l, view(o[0]), 8);
        m := def(&mut l, view("and i64 {}, 255"), &u8[][v]);
        store(&mut l, view(o[1]), view(m), 64);
        return ();
    }
    if eq(view(op), view("leaq")) {
        hk := header_operand(&l, view(o[0]));
        p := address(&mut l, view(o[0]));
        v := def(&mut l, view("ptrtoint ptr {} to i64"), &u8[][p]);
        store(&mut l, view(o[1]), view(v), 64);
        set_chain(&mut l, storage_of(&l, view(o[1])), 0, 0, 0);
        if hk != 0 {
            // The slot's address escapes: the callee may rebind it and it may grow the header.
            stale(&mut l, hk - 1);
        }
        return ();
    }
    if eq(view(op), view("addq")) || eq(view(op), view("subq")) || eq(view(op), view("cmpq")) {
        if n != 2 {
            bad(&mut l);
            return ();
        }
        x := value(&mut l, view(o[1]), 64);
        y := value(&mut l, view(o[0]), 64);
        if eq(view(op), view("addq")) {
            r := arith(&mut l, view("sadd"), view(x), view(y));
            c := def(&mut l, view("icmp ult i64 {}, {}"), &u8[][copy(view(r)), copy(view(x))]);
            set_flag(&mut l, view("C"), view(c));
            store(&mut l, view(o[1]), view(r), 64);
            chain_arith(&mut l, view(o[1]), view(o[0]), 0);
            return ();
        }
        r := arith(&mut l, view("ssub"), view(x), view(y));
        c := def(&mut l, view("icmp ult i64 {}, {}"), &u8[][copy(view(x)), copy(view(y))]);
        set_flag(&mut l, view("C"), view(c));
        if eq(view(op), view("subq")) {
            store(&mut l, view(o[1]), view(r), 64);
            chain_arith(&mut l, view(o[1]), view(o[0]), 1);
        }
        return ();
    }
    if eq(view(op), view("incq")) {
        x := value(&mut l, view(o[0]), 64);
        r := arith(&mut l, view("sadd"), view(x), view("1"));
        store(&mut l, view(o[0]), view(r), 64);
        return ();
    }
    if eq(view(op), view("andq")) || eq(view(op), view("orq")) || eq(view(op), view("xorq")) || eq(view(op), view("xorl")) || eq(view(op), view("testq")) || eq(view(op), view("andb")) {
        if n != 2 {
            bad(&mut l);
            return ();
        }
        mut w: u64 = 64;
        if eq(view(op), view("xorl")) {
            w = 32;
        }
        if eq(view(op), view("andb")) {
            w = 8;
        }
        x := value(&mut l, view(o[1]), w);
        y := value(&mut l, view(o[0]), w);
        mut t = binop_name(view(op));
        put(&mut t, view(" i64 {}, {}"));
        r := def(&mut l, view(t), &u8[][x, y]);
        logic_flags(&mut l, view(r));
        if !eq(view(op), view("testq")) {
            store(&mut l, view(o[1]), view(r), w);
        }
        return ();
    }
    if eq(view(op), view("shlq")) || eq(view(op), view("shrq")) || eq(view(op), view("sarq")) {
        x := value(&mut l, view(o[1]), 64);
        mut s = u8[];
        if eq(view(o[0]), view("%cl")) {
            s = get_reg(&mut l, view("cl"));
        } else {
            s = value(&mut l, view(o[0]), 64);
        }
        m := def(&mut l, view("and i64 {}, 63"), &u8[][s]);
        mut k = copy(view("shl"));
        if eq(view(op), view("shrq")) {
            k = copy(view("lshr"));
        }
        if eq(view(op), view("sarq")) {
            k = copy(view("ashr"));
        }
        put(&mut k, view(" i64 {}, {}"));
        r := def(&mut l, view(k), &u8[][x, m]);
        zero_sign(&mut l, view(r));
        store(&mut l, view(o[1]), view(r), 64);
        return ();
    }
    if eq(view(op), view("imulq")) {
        if n != 2 {
            bad(&mut l);
            return ();
        }
        x := value(&mut l, view(o[1]), 64);
        y := value(&mut l, view(o[0]), 64);
        r := arith(&mut l, view("smul"), view(x), view(y));
        overflow := get_flag(&mut l, view("O"));
        set_flag(&mut l, view("C"), view(overflow));
        store(&mut l, view(o[1]), view(r), 64);
        return ();
    }
    if eq(view(op), view("mulq")) {
        x := get_reg(&mut l, view("rax"));
        y := value(&mut l, view(o[0]), 64);
        xw := wide(&mut l, view(x));
        yw := wide(&mut l, view(y));
        p := def(&mut l, view("mul i128 {}, {}"), &u8[][xw, yw]);
        lo := narrow(&mut l, view(p));
        hs := def(&mut l, view("lshr i128 {}, 64"), &u8[][p]);
        hi := narrow(&mut l, view(hs));
        c := def(&mut l, view("icmp ne i64 {}, 0"), &u8[][copy(view(hi))]);
        set_flag(&mut l, view("C"), view(c));
        set_flag(&mut l, view("O"), view(c));
        set_reg(&mut l, view("rax"), view(lo));
        set_reg(&mut l, view("rdx"), view(hi));
        return ();
    }
    if eq(view(op), view("divq")) {
        lo := get_reg(&mut l, view("rax"));
        hi := get_reg(&mut l, view("rdx"));
        y := value(&mut l, view(o[0]), 64);
        lw := wide(&mut l, view(lo));
        hw := wide(&mut l, view(hi));
        hs := def(&mut l, view("shl i128 {}, 64"), &u8[][hw]);
        nw := def(&mut l, view("or i128 {}, {}"), &u8[][hs, lw]);
        yw := wide(&mut l, view(y));
        q := def(&mut l, view("udiv i128 {}, {}"), &u8[][copy(view(nw)), copy(view(yw))]);
        r := def(&mut l, view("urem i128 {}, {}"), &u8[][nw, yw]);
        qt := narrow(&mut l, view(q));
        rt := narrow(&mut l, view(r));
        set_reg(&mut l, view("rax"), view(qt));
        set_reg(&mut l, view("rdx"), view(rt));
        return ();
    }
    if starts(view(op), view("set")) {
        if (n != 1) || (o[0].len() == 0) {
            bad(&mut l);
            return ();
        }
        c := condition(&mut l, view(sub(view(op), 3, op.len())));
        z := def(&mut l, view("zext i1 {} to i64"), &u8[][c]);
        if o[0][0] == 37 {
            store(&mut l, view(o[0]), view(z), 64);
        } else {
            store(&mut l, view(o[0]), view(z), 8);
        }
        return ();
    }
    if starts(view(op), view("j")) && (n != 1) {
        bad(&mut l);
        return ();
    }
    if eq(view(op), view("jmp")) {
        if !set_has(&l.labels, view(o[0])) {
            bad(&mut l);
            return ();
        }
        emit(&mut l, view("br label %{}"), &u8[][block_name(view(o[0]))]);
        ends_terminator(&mut l);
        return ();
    }
    if starts(view(op), view("j")) {
        if !set_has(&l.labels, view(o[0])) {
            bad(&mut l);
            return ();
        }
        c := condition(&mut l, view(sub(view(op), 1, op.len())));
        next := fresh_block(&mut l);
        emit(&mut l, view("br i1 {}, label %{}, label %{}"), &u8[][c, block_name(view(o[0])), copy(view(next))]);
        begin_block(&mut l, view(next));
        return ();
    }
    if eq(view(op), view("call")) {
        lower_call(&mut l, view(rest), &facts);
        return ();
    }
    if eq(view(op), view("leave")) {
        return ();
    }
    if eq(view(op), view("ret")) {
        a := get_reg(&mut l, view("rax"));
        if l.retw == 1 {
            emit(&mut l, view("ret i64 {}"), &u8[][a]);
            ends_terminator(&mut l);
            return ();
        }
        // A body with no signature fact returns rax:rdx whatever it holds; only a fact that says
        // two words makes a stale %rdx here a wrong one.
        if (l.sibwidth != 0) || (set_get(&l.sigs, view(l.fname)) == 0) {
            l.rdxdead = 0;
        }
        d := get_reg(&mut l, view("rdx"));
        s1 := def(&mut l, view("insertvalue {i64, i64} undef, i64 {}, 0"), &u8[][a]);
        s2 := def(&mut l, view("insertvalue {i64, i64} {}, i64 {}, 1"), &u8[][s1, d]);
        emit(&mut l, view("ret {i64, i64} {}"), &u8[][s2]);
        ends_terminator(&mut l);
        return ();
    }
    if eq(view(op), view("syscall")) {
        names := u8[][copy(view("rax")), copy(view("rdi")), copy(view("rsi")), copy(view("rdx")), copy(view("r10")), copy(view("r8")), copy(view("r9"))];
        mut args = u8[];
        for i in 7 {
            if i != 0 {
                put(&mut args, view(", "));
            }
            put(&mut args, view("i64 "));
            put(&mut args, view(get_reg(&mut l, view(names[i]))));
        }
        // The stream's number/argument registers become each target's Linux syscall registers
        // (os-linux.grl already chose the target's syscall number).
        mut asm = copy(view("call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}\"({})"));
        if l.target == 1 {
            asm = copy(view("call i64 asm sideeffect \"svc #0\", \"={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5},~{memory}\"({})"));
        }
        if l.target == 2 {
            asm = copy(view("call i64 asm sideeffect \"ecall\", \"={x10},{x17},{x10},{x11},{x12},{x13},{x14},{x15},~{memory}\"({})"));
        }
        v := def(&mut l, view(asm), &u8[][args]);
        set_reg(&mut l, view("rax"), view(v));
        return ();
    }
    if eq(view(op), view("addsd")) || eq(view(op), view("subsd")) || eq(view(op), view("mulsd")) || eq(view(op), view("divsd")) {
        xv := value(&mut l, view(o[1]), 64);
        yv := value(&mut l, view(o[0]), 64);
        x := as_double(&mut l, view(xv));
        y := as_double(&mut l, view(yv));
        mut t = float_op(view(op));
        put(&mut t, view(" double {}, {}"));
        r := def(&mut l, view(t), &u8[][x, y]);
        w := as_word(&mut l, view(r));
        store(&mut l, view(o[1]), view(w), 64);
        return ();
    }
    // binary32 conversions (narrow f32 storage and C f32 fields): only the low 32 bits of the
    // source are meaningful, and the destination is written zero-extended.
    if eq(view(op), view("movd")) {
        xv := value(&mut l, view(o[0]), 64);
        t := def(&mut l, view("trunc i64 {} to i32"), &u8[][xv]);
        z := def(&mut l, view("zext i32 {} to i64"), &u8[][t]);
        store(&mut l, view(o[1]), view(z), 64);
        return ();
    }
    if eq(view(op), view("cvtss2sd")) {
        xv := value(&mut l, view(o[0]), 64);
        t := def(&mut l, view("trunc i64 {} to i32"), &u8[][xv]);
        f := def(&mut l, view("bitcast i32 {} to float"), &u8[][t]);
        d := def(&mut l, view("fpext float {} to double"), &u8[][f]);
        w := as_word(&mut l, view(d));
        store(&mut l, view(o[1]), view(w), 64);
        return ();
    }
    if eq(view(op), view("cvtsd2ss")) {
        xv := value(&mut l, view(o[0]), 64);
        x := as_double(&mut l, view(xv));
        f := def(&mut l, view("fptrunc double {} to float"), &u8[][x]);
        t := def(&mut l, view("bitcast float {} to i32"), &u8[][f]);
        z := def(&mut l, view("zext i32 {} to i64"), &u8[][t]);
        store(&mut l, view(o[1]), view(z), 64);
        return ();
    }
    if eq(view(op), view("sqrtsd")) {
        xv := value(&mut l, view(o[0]), 64);
        x := as_double(&mut l, view(xv));
        r := def(&mut l, view("call double @llvm.sqrt.f64(double {})"), &u8[][x]);
        w := as_word(&mut l, view(r));
        store(&mut l, view(o[1]), view(w), 64);
        return ();
    }
    if eq(view(op), view("cvtsi2sdq")) {
        x := value(&mut l, view(o[0]), 64);
        r := def(&mut l, view("sitofp i64 {} to double"), &u8[][x]);
        w := as_word(&mut l, view(r));
        store(&mut l, view(o[1]), view(w), 64);
        return ();
    }
    if eq(view(op), view("cvttsd2si")) {
        xv := value(&mut l, view(o[0]), 64);
        x := as_double(&mut l, view(xv));
        r := def(&mut l, view("fptosi double {} to i64"), &u8[][x]);
        store(&mut l, view(o[1]), view(r), 64);
        return ();
    }
    if eq(view(op), view("ucomisd")) {
        xv := value(&mut l, view(o[1]), 64);
        yv := value(&mut l, view(o[0]), 64);
        x := as_double(&mut l, view(xv));
        y := as_double(&mut l, view(yv));
        unordered := def(&mut l, view("fcmp uno double {}, {}"), &u8[][copy(view(x)), copy(view(y))]);
        same := def(&mut l, view("fcmp ueq double {}, {}"), &u8[][copy(view(x)), copy(view(y))]);
        below := def(&mut l, view("fcmp ult double {}, {}"), &u8[][x, y]);
        set_flag(&mut l, view("Z"), view(same));
        set_flag(&mut l, view("P"), view(unordered));
        set_flag(&mut l, view("C"), view(below));
        set_flag(&mut l, view("O"), view("false"));
        set_flag(&mut l, view("S"), view("false"));
        return ();
    }
    bad(&mut l);
    return ();
}

// ---- a small string set (open addressing over FNV-1a), for symbol lookups on large streams ----

struct Set {
    keys: u8[][],
    used: u64[],
    count: u64
}
fn set_new(capacity: u64) -> Set {
    mut size: u64 = 64;
    while size < capacity * 2 {
        size = size * 2;
    }
    mut keys = u8[][];
    mut used = u64[];
    for i in size {
        keys.push(u8[]);
        used.push(0);
    }
    return Set { keys: keys, used: used, count: 0 };
}
fn fnv<a>(s: &a [u8]) -> u64 {
    mut h: u64 = 14695981039346656037;
    for i in s.len() {
        h = wrapping_mul(h ^ u64(s[i]), 1099511628211);
    }
    return h;
}
fn set_has<a, b>(s: (&a Set), key: &b [u8]) -> bool {
    mask := s.used.len() - 1;
    mut i = fnv(key) & mask;
    while s.used[i] != 0 {
        if eq(view(s.keys[i]), key) {
            return true;
        }
        i = (i + 1) & mask;
    }
    return false;
}
// The table as a map: `value` (non-zero) under `key`, replacing what was there.
fn set_put<a, b>(s: (&a mut Set), key: &b [u8], value: u64) -> unit {
    mask := s.used.len() - 1;
    mut i = fnv(key) & mask;
    while s.used[i] != 0 {
        if eq(view(s.keys[i]), key) {
            s.used[i] = value;
            return ();
        }
        i = (i + 1) & mask;
    }
    s.keys[i] = copy(key);
    s.used[i] = value;
    s.count += 1;
    return ();
}
// What `set_put` stored under `key`, 0 when nothing (1 for a key `set_add` put in).
fn set_get<a, b>(s: (&a Set), key: &b [u8]) -> u64 {
    mask := s.used.len() - 1;
    mut i = fnv(key) & mask;
    while s.used[i] != 0 {
        if eq(view(s.keys[i]), key) {
            return s.used[i];
        }
        i = (i + 1) & mask;
    }
    return 0;
}
fn set_add<a, b>(s: (&a mut Set), key: &b [u8]) -> unit {
    if set_has(&s, key) {
        return ();
    }
    mask := s.used.len() - 1;
    mut i = fnv(key) & mask;
    while s.used[i] != 0 {
        i = (i + 1) & mask;
    }
    s.keys[i] = copy(key);
    s.used[i] = 1;
    s.count += 1;
    return ();
}
// A string-keyed table of numbers, open addressing like Set: what turns the lifter's "find the
// entry named X" scans into one probe.
struct Map {
    keys: u8[][],
    vals: u64[],
    used: u64[]
}
fn map_new(capacity: u64) -> Map {
    mut size: u64 = 64;
    while size < capacity * 2 {
        size = size * 2;
    }
    mut keys = u8[][];
    mut vals = u64[];
    mut used = u64[];
    for i in size {
        keys.push(u8[]);
        vals.push(0);
        used.push(0);
    }
    return Map { keys: keys, vals: vals, used: used };
}
// The value stored under `key` plus one, or 0 when there is none.
fn map_get<a, b>(m: (&a Map), key: &b [u8]) -> u64 {
    mask := m.used.len() - 1;
    mut i = fnv(key) & mask;
    while m.used[i] != 0 {
        if eq(view(m.keys[i]), key) {
            return m.vals[i] + 1;
        }
        i = (i + 1) & mask;
    }
    return 0;
}
fn map_put<a, b>(m: (&a mut Map), key: &b [u8], value: u64) -> unit {
    mask := m.used.len() - 1;
    mut i = fnv(key) & mask;
    while m.used[i] != 0 {
        if eq(view(m.keys[i]), key) {
            m.vals[i] = value;
            return ();
        }
        i = (i + 1) & mask;
    }
    m.keys[i] = copy(key);
    m.vals[i] = value;
    m.used[i] = 1;
    return ();
}
// The facts about one function, as a table of their own. Every per-function question the lowering
// asks walks its facts; asked of the whole module's table it costs the size of the module per
// function, which is what made a large unit's lift quadratic. `heads`/`next` chain each function's
// facts (built once per module), and with `--range-facts` the shared-parameter facts of every
// function come too, because that pass reads its callees'.
fn facts_of<a, b, d>(facts: (&a Facts), heads: (&b Map), next: (&d u64[]), name: &a [u8], ranges: u64) -> Facts {
    mut out = Facts { items: Fact[] };
    mut chain = u64[];
    mut at = map_get(&heads, name);
    while at != 0 {
        chain.push(at - 1);
        at = next[at - 1];
    }
    // The chain runs newest first; the lowering counts ordinals in emission order.
    mut q = chain.len();
    while q > 0 {
        q -= 1;
        f := &facts.items[chain[q]];
        out.items.push(Fact { kind: f.kind, fn: copy(view(f.fn)), a: f.a, b: f.b, callee: copy(view(f.callee)), what: f.what, width: f.width });
    }
    if ranges != 0 {
        for i in facts.items.len() {
            f := &facts.items[i];
            if (f.kind == 2) && !eq(view(f.fn), name) {
                out.items.push(Fact { kind: f.kind, fn: copy(view(f.fn)), a: f.a, b: f.b, callee: copy(view(f.callee)), what: f.what, width: f.width });
            }
        }
    }
    return out;
}
fn ident_char(ch: u64) -> bool {
    return ((ch >= 97) && (ch <= 122))
        || ((ch >= 65) && (ch <= 90))
        || ((ch >= 48) && (ch <= 57))
        || (ch == 95) || (ch == 46) || (ch == 36);
}
// Every identifier-like token of a line into `out`.
fn add_tokens<a, b>(out: (&a mut Set), line: &b [u8]) -> unit {
    mut i: u64 = 0;
    while i < line.len() {
        if ident_char(line[i]) {
            mut j = i;
            while j < line.len() && ident_char(line[j]) {
                j += 1;
            }
            set_add(&mut out, view(sub(line, i, j)));
            i = j;
            continue;
        }
        i += 1;
    }
    return ();
}
// `line` with every `.L` token in `renamed` replaced by its pool name.
fn rename_line<a, b>(line: &a [u8], renamed: (&b Set)) -> u8[] {
    if renamed.count == 0 || !has(line, view(".L")) {
        return copy(line);
    }
    mut out = u8[];
    mut i: u64 = 0;
    while i < line.len() {
        if ident_char(line[i]) {
            mut j = i;
            while j < line.len() && ident_char(line[j]) {
                j += 1;
            }
            token := sub(line, i, j);
            if is_local_label(view(token)) & set_has(&renamed, view(token)) {
                put(&mut out, view(pool_name(view(token))));
            } else {
                put(&mut out, view(token));
            }
            i = j;
            continue;
        }
        out.push(line[i]);
        i += 1;
    }
    return out;
}

// ---- functions ----

fn callee_saved<a>(line: &a [u8]) -> bool {
    mut r = u8[];
    if starts(line, view("pushq %")) {
        r = sub(line, 7, line.len());
    } else {
        if starts(line, view("popq %")) {
            r = sub(line, 6, line.len());
        } else {
            return false;
        }
    }
    return eq(view(r), view("rbx")) || eq(view(r), view("r12")) || eq(view(r), view("r13")) || eq(view(r), view("r14")) || eq(view(r), view("r15"));
}
// The signature facts as a map from body symbol to `words * 4 + result words`. `rt_abort` keeps
// the six-word form: the module header calls it with six zero words.
fn signatures<a, b>(facts: (&a Facts), taken: (&b Set)) -> Set {
    mut n = 0;
    for i in facts.items.len() {
        if facts.items[i].kind == 5 {
            n += 1;
        }
    }
    mut out = set_new(n + 1);
    for i in facts.items.len() {
        f := &facts.items[i];
        if (f.kind == 5) && !eq(view(f.fn), view("rt_abort")) && !set_has(&taken, view(f.fn)) {
            set_put(&mut out, view(f.fn), f.a * 4 + 1);
        }
    }
    for i in facts.items.len() {
        f := &facts.items[i];
        if f.kind == 4 {
            code := set_get(&out, view(f.fn));
            if code != 0 {
                set_put(&mut out, view(f.fn), (code / 4) * 4 + 2);
            }
        }
    }
    return out;
}
fn data_directive<a>(line: &a [u8]) -> bool {
    return starts(line, view(".quad")) || starts(line, view(".long")) || starts(line, view(".word")) || starts(line, view(".8byte"));
}
// At most how many names `rip_symbols` adds for `line`.
fn rip_bound<a>(line: &a [u8]) -> u64 {
    if data_directive(line) {
        return line.len() / 2 + 1;
    }
    mut n = 0;
    mut i: u64 = 0;
    while i + 6 <= line.len() {
        if (line[i] == 40) && (line[i + 1] == 37) && (line[i + 2] == 114) && (line[i + 3] == 105) && (line[i + 4] == 112) && (line[i + 5] == 41) {
            n += 1;
        }
        i += 1;
    }
    return n;
}
// Every NAME of a `NAME(%rip)` operand of `line`, and every identifier of a data directive
// (`.quad NAME`, `.long NAME-.`), into `out`: the symbols whose address the program takes.
fn rip_symbols<a, b>(out: (&a mut Set), line: &b [u8]) -> unit {
    if data_directive(line) {
        add_tokens(&mut out, line);
        return ();
    }
    if rip_bound(line) == 0 {
        return ();
    }
    mut i: u64 = 0;
    while i + 6 <= line.len() {
        if (line[i] == 40) && (line[i + 1] == 37) && (line[i + 2] == 114) && (line[i + 3] == 105) && (line[i + 4] == 112) && (line[i + 5] == 41) {
            mut b = i;
            while (b > 0) && ident_char(line[b - 1]) {
                b -= 1;
            }
            if b < i {
                set_add(&mut out, view(sub(line, b, i)));
            }
        }
        i += 1;
    }
    return ();
}
// The FFI facts as a map from C symbol to `ffi_code + 1`; two call sites that disagree (a variadic
// function seen with different argument lists) leave the symbol untyped (value 1).
fn ffi_signatures<a>(facts: (&a Facts)) -> Set {
    mut n = 0;
    for i in facts.items.len() {
        if facts.items[i].kind == 6 {
            n += 1;
        }
    }
    mut out = set_new(n + 1);
    for i in facts.items.len() {
        f := &facts.items[i];
        if f.kind == 6 {
            code := f.a + (f.b << 3) + (f.what << 7) + (f.width << 15) + 2;
            was := set_get(&out, view(f.fn));
            if (was != 0) && (was != code) {
                set_put(&mut out, view(f.fn), 1);
            } else {
                set_put(&mut out, view(f.fn), code);
            }
        }
    }
    return out;
}
// The LLVM type of float argument `k` of an FFI code, or of its result.
fn ffi_arg_type(code: u64, k: u64) -> u8[] {
    if (((code >> 7) >> k) & 1) != 0 {
        return copy(view("float"));
    }
    return copy(view("double"));
}
fn ffi_ret_type(code: u64) -> u8[] {
    r := (code >> 15) & 3;
    if r == 1 {
        return copy(view("double"));
    }
    if r == 2 {
        return copy(view("float"));
    }
    return copy(view("i64"));
}
// `(i64, i64, double)`: an FFI code's parameter list, typed or (`names` set) with the values.
fn ffi_params(code: u64) -> u8[] {
    ints := code & 7;
    floats := (code >> 3) & 15;
    mut out = u8[];
    for i in ints {
        if i != 0 {
            put(&mut out, view(", "));
        }
        put(&mut out, view("i64"));
    }
    for k in floats {
        if (ints != 0) || (k != 0) {
            put(&mut out, view(", "));
        }
        put(&mut out, view(ffi_arg_type(code, k)));
    }
    return out;
}
// A call to a C function with an FFI fact (call ABI S8a): integer words from the argument
// registers, float arguments from the vector registers the ABI puts them in, the result back in
// %rax or %xmm0 as the word machine expects to read it.
fn lower_ffi_call<a, b>(l: (&a mut L), target: &b [u8], code: u64) -> unit {
    ints := code & 7;
    floats := (code >> 3) & 15;
    names := u8[][copy(view("rdi")), copy(view("rsi")), copy(view("rdx")), copy(view("rcx")), copy(view("r8")), copy(view("r9"))];
    mut args = u8[];
    for i in ints {
        if i != 0 {
            put(&mut args, view(", "));
        }
        put(&mut args, view("i64 "));
        put(&mut args, view(get_reg(&mut l, view(names[i]))));
    }
    for k in floats {
        mut xn = copy(view("xmm"));
        num(&mut xn, k);
        w := def(&mut l, view("load i64, ptr {}"), &u8[][slot_of(view("%x."), view(xn))]);
        l.xpend = l.xpend & (18446744073709551615 - (1 << k));
        if (ints != 0) || (k != 0) {
            put(&mut args, view(", "));
        }
        t := ffi_arg_type(code, k);
        put(&mut args, view(t));
        args.push(32);
        if eq(view(t), view("float")) {
            n := def(&mut l, view("trunc i64 {} to i32"), &u8[][w]);
            put(&mut args, view(def(&mut l, view("bitcast i32 {} to float"), &u8[][n])));
        } else {
            put(&mut args, view(def(&mut l, view("bitcast i64 {} to double"), &u8[][w])));
        }
    }
    xmm_call(&mut l);
    rt := ffi_ret_type(code);
    mut c = copy(view("call "));
    put(&mut c, view(rt));
    put(&mut c, view(" @\""));
    put(&mut c, target);
    put(&mut c, view("\"({})"));
    r := def(&mut l, view(c), &u8[][args]);
    if eq(view(rt), view("i64")) {
        set_reg(&mut l, view("rax"), view(r));
    } else {
        mut word = copy(view(""));
        if eq(view(rt), view("double")) {
            word = def(&mut l, view("bitcast double {} to i64"), &u8[][r]);
        } else {
            b := def(&mut l, view("bitcast float {} to i32"), &u8[][r]);
            word = def(&mut l, view("zext i32 {} to i64"), &u8[][b]);
        }
        emit(&mut l, view("store i64 {}, ptr {}"), &u8[][word, slot_of(view("%x."), view("xmm0"))]);
        l.xstale = l.xstale & (18446744073709551615 - 1);
    }
    set_chain(&mut l, reg_index(view("rax")) + 1, 0, 0, 0);
    clear_args(&mut l);
    refresh(&mut l);
    return ();
}
// `{i64, i64}` for a two-word result, `i64` for one.
fn result_type(words: u64) -> u8[] {
    if words == 1 {
        return copy(view("i64"));
    }
    return copy(view("{i64, i64}"));
}
// The parameter list of a body taking `n` words: `i64 %a0, i64 %a1, ...`.
fn param_list(n: u64) -> u8[] {
    mut out = u8[];
    for i in n {
        if i != 0 {
            put(&mut out, view(", "));
        }
        put(&mut out, view("i64 %a"));
        num(&mut out, i);
    }
    return out;
}
// The index just past `@"` in a `define` line that is not already internal, 0 for any other line.
fn define_name_at<a>(line: &a [u8]) -> u64 {
    if !starts(line, view("define ")) || starts(line, view("define internal ")) {
        return 0;
    }
    for i in line.len() {
        if (line[i] == 64) && (i + 1 < line.len()) && (line[i + 1] == 34) {
            return i + 2;
        }
    }
    return 0;
}
// The argument register a word-machine register name is (0 rdi .. 5 r9, any width), 6 for none.
fn arg_index<a>(name: &a [u8]) -> u64 {
    r := reg_name(name);
    for i in 6 {
        if eq(view(r), view(arg_reg(i))) {
            return i;
        }
    }
    return 6;
}
// Every `%reg` operand of `ops` (the text after the mnemonic), as argument indices with bit 7
// set when the operand is the instruction's last one and a bare register (its destination).
fn reg_operands<a>(ops: &a [u8]) -> u64[] {
    mut out = u64[];
    mut i: u64 = 0;
    mut depth = 0;
    mut last_start = 0;
    while i < ops.len() {
        if ops[i] == 40 {
            depth += 1;
        }
        if ops[i] == 41 {
            depth -= 1;
        }
        if (ops[i] == 44) && (depth == 0) {
            last_start = i + 1;
        }
        i += 1;
    }
    i = 0;
    while i < ops.len() {
        if ops[i] == 37 {
            mut j = i + 1;
            while (j < ops.len()) && ident_char(ops[j]) {
                j += 1;
            }
            k := arg_index(view(sub(ops, i + 1, j)));
            if k < 6 {
                bare := (i == last_start) && (j == ops.len());
                if bare {
                    out.push(k | 128);
                } else {
                    out.push(k);
                }
            }
            i = j;
            continue;
        }
        i += 1;
    }
    return out;
}
// The first argument register the straight-line entry of `body` (from `first` to the first label,
// jump, call or return) reads before writing it although it is not one of the `nargs` the
// signature fact gives the body, plus one; 0 when there is none. A move, `lea`, `pop` or a
// register zeroed by `xor` with itself writes its destination without reading it.
fn sig_prologue<a>(body: (&a u8[][]), first: u64, nargs: u64) -> u64 {
    mut written: u64 = 0;
    for i in nargs {
        written = written | (1 << i);
    }
    mut k = first;
    while k < body.len() {
        line := view(body[k]);
        if (line.len() == 0) || (line[line.len() - 1] == 58) || starts(line, view("j")) || starts(line, view("call")) || starts(line, view("ret")) {
            return 0;
        }
        mut sp = 0;
        while (sp < line.len()) && (line[sp] != 32) {
            sp += 1;
        }
        op := sub(line, 0, sp);
        mut ops = u8[];
        if sp < line.len() {
            ops = sub(line, sp + 1, line.len());
        }
        regs := reg_operands(view(ops));
        pure := starts(view(op), view("mov")) || starts(view(op), view("lea")) || starts(view(op), view("pop")) || starts(view(op), view("set"));
        mut zeroing = false;
        if starts(view(op), view("xor")) && (regs.len() == 2) {
            zeroing = (regs[0] & 127) == (regs[1] & 127);
        }
        for r in regs.len() {
            reg := regs[r] & 127;
            dest := (regs[r] & 128) != 0;
            if (dest && (pure || zeroing)) || zeroing {
                continue;
            }
            if (written & (1 << reg)) == 0 {
                return reg + 1;
            }
        }
        for r in regs.len() {
            if (regs[r] & 128) != 0 {
                written = written | (1 << (regs[r] & 127));
            }
        }
        k += 1;
    }
    return 0;
}
// A signature fact proved wrong: refuse the body (native code is always correct) and say why.
fn sig_wrong<a, b, d>(l: (&a mut L), subject: &b [u8], why: &d [u8]) -> unit {
    l.wrong.push(copy(subject));
    if l.sigerr.len() == 0 {
        put(&mut l.sigerr, view("llvm: the signature fact of "));
        put(&mut l.sigerr, subject);
        put(&mut l.sigerr, view(" is wrong: "));
        put(&mut l.sigerr, why);
        if l.curline.len() != 0 {
            put(&mut l.sigerr, view(" (at `"));
            put(&mut l.sigerr, view(l.curline));
            put(&mut l.sigerr, view("`)"));
        }
        l.sigerr.push(10);
    }
    bad(&mut l);
    return ();
}
// A line of the outgoing argument area of a call with more than six words (native.grl
// `load_call_args`): `subq $N,%rsp` / `addq $N,%rsp` around the call and `movq %reg,K(%rsp)` for
// each stack word. Any other use of %rsp keeps the body native.
fn area_line<a>(line: &a [u8]) -> bool {
    if (starts(line, view("subq $")) || starts(line, view("addq $"))) && ends(line, view(",%rsp")) {
        return parse_int(view(sub(line, 6, line.len() - 5))).ok != 0;
    }
    if starts(line, view("movq %")) && ends(line, view("(%rsp)")) {
        mut comma = 0;
        for i in line.len() {
            if line[i] == 44 {
                comma = i;
            }
        }
        return (comma != 0) && (parse_int(view(sub(line, comma + 1, line.len() - 6))).ok != 0);
    }
    return false;
}
// The outgoing area: `subq $N,%rsp` (or `cstack N`) opens N/8 words, `movq %reg,K(%rsp)` (or
// `cstarg K`, which stores %rax) fills word K/8, and `addq $N,%rsp` (`cunstack N`) closes it. The
// words become the call's arguments past the sixth (`call_args_n`). True when `line` was one.
fn area_instruction<a, b, c>(l: (&a mut L), op: &b [u8], rest: &c [u8]) -> bool {
    open := eq(op, view("cstack")) || (eq(op, view("subq")) && ends(rest, view(",%rsp")));
    close := eq(op, view("cunstack")) || (eq(op, view("addq")) && ends(rest, view(",%rsp")));
    if open || close {
        mut text = copy(rest);
        if starts(rest, view("$")) {
            text = sub(rest, 1, rest.len() - 5);
        }
        n := parse_int(view(text));
        if (n.ok == 0) || (n.v <= 0) || (n.v % 8 != 0) {
            bad(&mut l);
            return true;
        }
        if open {
            if l.areaopen != 0 {
                bad(&mut l);
                return true;
            }
            mut words = u8[][];
            for i in u64(n.v) / 8 {
                words.push(copy(view("undef")));
            }
            exchange(&mut l.area, words);
            l.areaopen = 1;
        } else {
            if (l.areaopen == 0) || (l.area.len() * 8 != u64(n.v)) {
                bad(&mut l);
                return true;
            }
            exchange(&mut l.area, u8[][]);
            l.areaopen = 0;
        }
        return true;
    }
    store := eq(op, view("cstarg")) || (eq(op, view("movq")) && ends(rest, view("(%rsp)")));
    if !store {
        return false;
    }
    mut src = copy(view("rax"));
    mut at = copy(rest);
    if eq(op, view("movq")) {
        o := operands(rest);
        if (o.len() != 2) || (o[0][0] != 37) {
            bad(&mut l);
            return true;
        }
        src = sub(view(o[0]), 1, o[0].len());
        at = sub(view(o[1]), 0, o[1].len() - 6);
    }
    k := parse_int(view(at));
    if (l.areaopen == 0) || (k.ok == 0) || (k.v < 0) || (k.v % 8 != 0) || (u64(k.v) / 8 >= l.area.len()) {
        bad(&mut l);
        return true;
    }
    v := get_reg(&mut l, view(src));
    l.area[u64(k.v) / 8] = v;
    return true;
}
// A load of `16 + 8k(%rbp)`, word 6 + k of the arguments (native.grl `stack_params`): the body's
// parameter %a(6 + k), which the signature fact must cover. Empty for any other operand.
fn stack_param<a, b>(l: (&a mut L), op: &b [u8]) -> u8[] {
    if !ends(op, view("(%rbp)")) || (op.len() < 7) || (op[0] == 45) {
        return u8[];
    }
    d := parse_int(view(sub(op, 0, op.len() - 6)));
    if (d.ok == 0) || (d.v < 16) || (d.v % 8 != 0) {
        return u8[];
    }
    index := 6 + (u64(d.v) - 16) / 8;
    if (l.sibwidth != 0) || (set_get(&l.sigs, view(l.fname)) == 0) {
        bad(&mut l);
        return copy(view("0"));
    }
    if index >= l.nargs {
        mut why = copy(view("it gives "));
        num(&mut why, l.nargs);
        put(&mut why, view(" argument words and the body reads word "));
        num(&mut why, index);
        put(&mut why, view(" from the caller's stack"));
        fname := copy(view(l.fname));
        sig_wrong(&mut l, view(fname), view(why));
        return copy(view("0"));
    }
    mut a = copy(view("%a"));
    num(&mut a, index);
    return a;
}
// NAME in `.type NAME,@function`.
fn type_name<a>(line: &a [u8]) -> u8[] {
    mut e = 6;
    while (e < line.len()) && (line[e] != 44) {
        e += 1;
    }
    return sub(line, 6, e);
}
// The function's instruction lines, with pool lines dropped.
fn body_lines<a, b>(lines: (&a u8[][]), f: (&b Func)) -> u8[][] {
    mut out = u8[][];
    mut pool = 0;
    mut i = f.first;
    while i < f.end {
        line := view(lines[i]);
        if starts(line, view(".pushsection")) {
            pool = 1;
        }
        if pool == 0 {
            out.push(copy(line));
        }
        if starts(line, view(".popsection")) {
            pool = 0;
        }
        i += 1;
    }
    return out;
}
// Whether the body reads or writes through the address of a frame slot past the extent the facts
// give that slot: one word for a plain slot, the whole object for a multi-word value (kind-3 fact).
// The address is followed from its `leaq -N(%rbp)` through register copies and frame-slot spills
// until something else writes the holder; a label or a call forgets what it is not sure of, so this
// reports no false overreach, only real ones. The lifter gives each slot its own alloca unless a
// fact joins them, so an access past the fact's width would land in an unrelated object.
fn escaped_overreach<a, b>(l: (&a L), instrs: (&b u8[][])) -> bool {
    mut regs = u64[];
    for i in 14 {
        regs.push(0);
    }
    mut spill_at = u8[][];
    mut spill_k = u64[];
    for m in instrs.len() {
        line := view(instrs[m]);
        if (line.len() == 0) || (line[line.len() - 1] == 58) {
            for i in 14 {
                regs[i] = 0;
            }
            spill_at.clear();
            spill_k.clear();
            continue;
        }
        mut sp = line.len();
        for i in line.len() {
            if (line[i] == 32) & (sp == line.len()) {
                sp = i;
            }
        }
        op := sub(line, 0, sp);
        mut rest = u8[];
        if sp < line.len() {
            rest = sub(line, sp + 1, line.len());
        }
        o := operands(view(rest));
        if !eq(view(op), view("leaq")) {
            for q in o.len() {
                if overreach_operand(&l, &regs, view(o[q])) {
                    return true;
                }
            }
        }
        n := o.len();
        if eq(view(op), view("call")) {
            // The caller-saved registers do not survive; rbx and r12..r15 do.
            for i in 14 {
                if (i != 1) & (i < 10) {
                    regs[i] = 0;
                }
            }
            spill_at.clear();
            spill_k.clear();
            continue;
        }
        if n == 0 {
            continue;
        }
        dst := view(o[n - 1]);
        mut held: u64 = 0;
        if eq(view(op), view("leaq")) && (n == 2) {
            held = rbp_slot_plus_one(view(o[0]));
        } else if eq(view(op), view("movq")) && (n == 2) {
            src := view(o[0]);
            if (src.len() > 1) && (src[0] == 37) {
                sr := reg_index(view(sub(src, 1, src.len())));
                if sr < 14 {
                    held = regs[sr];
                }
            } else {
                for i in spill_at.len() {
                    if eq(view(spill_at[i]), src) {
                        held = spill_k[i];
                    }
                }
            }
        }
        if (dst.len() > 1) && (dst[0] == 37) {
            dr := reg_index(view(sub(dst, 1, dst.len())));
            if dr < 14 {
                regs[dr] = held;
            }
        } else if ends(dst, view("(%rbp)")) {
            mut found = spill_at.len();
            for i in spill_at.len() {
                if eq(view(spill_at[i]), dst) {
                    found = i;
                }
            }
            if found == spill_at.len() {
                spill_at.push(copy(dst));
                spill_k.push(held);
            } else {
                spill_k[found] = held;
            }
        }
    }
    return false;
}
// `-N(%rbp)` as slot N/8 - 1, plus one; 0 for any other operand.
fn rbp_slot_plus_one<a>(t: &a [u8]) -> u64 {
    if !starts(t, view("-")) || !ends(t, view("(%rbp)")) {
        return 0;
    }
    mut v: u64 = 0;
    mut i = 1;
    while (i < t.len()) && (t[i] != 40) {
        if (t[i] < 48) || (57 < t[i]) {
            return 0;
        }
        v = v * 10 + u64(t[i] - 48);
        i += 1;
    }
    if (v < 8) || (v % 8 != 0) {
        return 0;
    }
    return v / 8;
}
// A memory operand `D(%r)` whose base register holds the address of slot k, and whose constant
// displacement reaches outside k's object.
fn overreach_operand<a, b>(l: (&a L), regs: (&b u64[]), t: &[u8]) -> bool {
    mut lp = t.len();
    for i in t.len() {
        if (t[i] == 40) & (lp == t.len()) {
            lp = i;
        }
    }
    if lp == t.len() {
        return false;
    }
    mut rp = lp + 1;
    while (rp < t.len()) && (t[rp] != 41) && (t[rp] != 44) {
        rp += 1;
    }
    if (rp >= t.len()) || (t[rp] != 41) || (lp + 2 > rp) || (t[lp + 1] != 37) {
        // Not `D(%r)`: an indexed access's extent is not a constant, so it is not judged here.
        return false;
    }
    r := reg_index(view(sub(t, lp + 2, rp)));
    if (r >= 14) || (regs[r] == 0) {
        return false;
    }
    k := regs[r] - 1;
    mut d: i64 = 0;
    mut neg = false;
    mut i = 0;
    if (lp != 0) && (t[0] == 45) {
        neg = true;
        i = 1;
    }
    while i < lp {
        ch := t[i];
        if (ch < 48) || (57 < ch) {
            return false;
        }
        d = d * 10 + i64(ch - 48);
        i += 1;
    }
    if neg {
        d = 0 - d;
    }
    // Slot k's object: its first word's slot b (the lowest address) and `w` words; k is word b - k.
    b := pair_base(&l, k);
    mut lo: i64 = 0;
    mut hi: i64 = 0;
    if b != 0 {
        at := i64(b - 1 - k);
        lo = 0 - 8 * at;
        hi = 8 * (i64(pair_words(&l, b)) - 1 - at);
    }
    return (d < lo) || (hi < d);
}
// The `DynPair` slots of the function being lowered, from the typed-IR facts (docs/design/fat-dyn.md):
// each is the first word of a 16-byte, 8-aligned `{data, vtable}` value whose second word is the slot
// above it, lowered as one `[2 x i64]` alloca so the two words stay one addressable value.
fn function_pairs<a, b, d>(l: (&a mut L), facts: (&b Facts), name: &d [u8]) -> unit {
    exchange(&mut l.pairs, u64[]);
    exchange(&mut l.pair_widths, u64[]);
    facts_dyn_pairs(facts, name, &mut l.pairs);
    facts_pair_widths(facts, name, &mut l.pair_widths);
    return ();
}
// The two-word value slot k belongs to, +1: its first word's slot, or 0 when k is a plain slot.
// Slot k is the first word when it is the base, and the second word when the base is k+1.
fn pair_base<a>(l: (&a L), k: u64) -> u64 {
    for i in l.pairs.len() {
        b := l.pairs[i];
        if (k <= b) & (b < k + l.pair_widths[i]) {
            return b + 1;
        }
    }
    return 0;
}
// The word count of the multi-word value whose base (counted from one) is `base`.
fn pair_words<a>(l: (&a L), base: u64) -> u64 {
    for i in l.pairs.len() {
        if l.pairs[i] + 1 == base {
            return l.pair_widths[i];
        }
    }
    return 1;
}
// Whether slot k is the second word of a two-word value (the slot above its base).
fn pair_second<a>(l: (&a L), k: u64) -> u64 {
    b := pair_base(&l, k);
    if b == 0 {
        return 0;
    }
    // `pair_base` counts the base slot from one: any word below the base is a later word.
    if b != k + 1 {
        return 1;
    }
    return 0;
}
// Whether every `%rbp` in the instructions is a constant negative offset `-N(%rbp)`; the deepest
// slot index is written to `deepest`.
fn frame_split<a>(instrs: (&a u8[][]), deepest: (&a mut u64)) -> u64 {
    exchange(deepest, 0);
    mut most: u64 = 0;
    for m in instrs.len() {
        line := view(instrs[m]);
        if !has(line, view("%rbp")) {
            continue;
        }
        mut i: u64 = 0;
        while i + 4 <= line.len() {
            if occurs_at(line, i, view("%rbp")) {
                if (i == 0) || (line[i - 1] != 40) || (i + 4 >= line.len()) || (line[i + 4] != 41) {
                    return 0;
                }
                // The displacement runs back from `(` to a space or comma.
                mut b = i - 1;
                while (b > 0) && (line[b - 1] != 32) && (line[b - 1] != 44) {
                    b -= 1;
                }
                d := parse_int(view(sub(line, b, i - 1)));
                if (d.ok == 0) || (d.v >= 0) {
                    return 0;
                }
                k := u64(0 - (d.v + 1)) / 8;
                if k > most {
                    most = k;
                }
                i += 4;
                continue;
            }
            i += 1;
        }
    }
    exchange(deepest, most);
    return 1;
}
// Lowers one function into l.body; l.fail is set when any line is not understood.
fn lower_function<a, b, c>(l: (&a mut L), lines: (&b u8[][]), f: (&b Func), facts: (&c Facts)) -> unit {
    l.body = u8[];
    // A function's temporaries and fresh blocks are named within it, so a function lowers to the
    // same text whatever was lowered before it (in this process or a forked one).
    l.t = 0;
    l.dead = 0;
    l.fail = 0;
    l.term = 0;
    l.fordinal = 0;
    exchange(&mut l.fops, u64[]);
    exchange(&mut l.fslots, u64[]);
    exchange(&mut l.hslots, u64[]);
    exchange(&mut l.hwhat, u64[]);
    exchange(&mut l.hwidth, u64[]);
    exchange(&mut l.eon, u64[]);
    exchange(&mut l.edata, u8[][]);
    exchange(&mut l.elen, u8[][]);
    exchange(&mut l.edptr, u8[][]);
    exchange(&mut l.eblk, u64[]);
    l.blk = 0;
    exchange(&mut l.dnames, u8[][]);
    exchange(&mut l.dmap, map_new(16));
    index_call_headers(&mut l, &facts, view(f.name));
    exchange(&mut l.vk, u64[]);
    exchange(&mut l.vo, u64[]);
    exchange(&mut l.vo2, i64[]);
    exchange(&mut l.cnames, u8[][]);
    exchange(&mut l.ccount, u64[]);
    exchange(&mut l.cmap, map_new(16));
