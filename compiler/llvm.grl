                        found = k;
                    }
                }
                if found == shared_names.len() {
                    shared_names.push(copy(view(q.fn)));
                    shared_masks.push(0);
                }
                shared_masks[found] = shared_masks[found] | (1 << q.a);
            }
        }
        l.proof = range_proofs(&instrs, nslots, l.split, &shared_names, &shared_masks);
    }
    if l.split != 0 {
        // One alloca per slot; the prologue's zeroing covers the slots below the parameters.
        slots := size / 8;
        index_slot_lines(&mut l, &instrs, slots);
        accept_slots(&mut l, &instrs, &facts, view(f.name), slots);
        accept_headers(&mut l, &instrs, &facts, view(f.name), slots);
        if escaped_overreach(&l, &instrs) {
            // An address-taken slot is used past the width the facts give it: lowered as separate
            // allocas, the access would land in another object. The body stays native, where the
            // frame is one block (and --verify-facts says so).
            if l.verify != 0 {
                mut msg = copy(view("verify-facts: "));
                put(&mut msg, view(f.name));
                put(&mut msg, view(" accesses an address-taken frame slot past its declared width (a multi-word value without its kind-3 fact)\n"));
                host::print(view(msg));
                host::exit(1);
            }
            bad(&mut l);
        }
        mut count = slots;
        if deepest + 1 > count {
            count = deepest + 1;
        }
        for z in 14 + count {
            l.vk.push(0);
            l.vo.push(0);
            l.vo2.push(0);
        }
        if l.sibwidth != 0 {
