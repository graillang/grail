            i = 2;
        }
    }
    if i < body.len() {
        if starts(view(body[i]), view("subq $.F")) & ends(view(body[i]), view(",%rsp")) {
            i += 1;
        }
    }
    if sigcode != 0 {
        read := sig_prologue(&body, i, l.nargs);
        if read != 0 {
            mut why = copy(view("it gives "));
            num(&mut why, l.nargs);
            put(&mut why, view(" argument words and the body reads %"));
            put(&mut why, view(arg_reg(read - 1)));
