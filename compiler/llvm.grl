    lp_word(&mut out, 6072411188134084935);
    return out;
}
fn unpack_piece<a>(b: &a [u8]) -> Piece {
    mut at: u64 = 0;
    functions := lp_take_text(b, &mut at);
    native := lp_take_texts(b, &mut at);
    nk := lp_take(b, &mut at);
    mut kept = u64[];
    for i in nk {
        kept.push(lp_take(b, &mut at));
    }
    lifted := lp_take_texts(b, &mut at);
    calls := lp_take_texts(b, &mut at);
    refs := lp_take_texts(b, &mut at);
    addrs := lp_take_texts(b, &mut at);
    errors := lp_take_text(b, &mut at);
    wrong := lp_take_texts(b, &mut at);
    return Piece { functions: functions, native: native, kept: kept, lifted: lifted, calls: calls, refs: refs, addrs: addrs, errors: errors, wrong: wrong };
