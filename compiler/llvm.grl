        wl := view(lines[i]);
        if starts(wl, view(".weak ")) {
            set_add(&mut weak, view(sub(wl, 6, wl.len())));
        }
    }
    mut l = L { target: target, ir: u8[], body: u8[], fail: 0, t: 0, dead: 0, term: 0, labels: set_new(16), calls: u8[][], addrs: u8[][], split: 0, refs: u8[][], lifted: u8[][], flags: 0, frame: 0, pairs: u64[], pair_widths: u64[], fslots: u64[], fops: u64[], fordinal: 0, verify: verify, hslots: u64[], hwhat: u64[], hwidth: u64[], eon: u64[], edata: u8[][], elen: u8[][], edptr: u8[][], vk: u64[], vo: u64[], vo2: i64[], hcall: u64[], hcallwhat: u64[], hstable: u64[], hesc: u64[], cnames: u8[][], ccount: u64[], sibwhat: 0, sibwidth: 0, sd: u8[], sl: u8[], fname: u8[], sibnames: u8[][], sibbodies: u8[][], eblk: u64[], blk: 0, body_blk: 0, dnames: u8[][], dmap: map_new(16), hmap: map_new(16), cmap: map_new(16), sl_start: u64[], sl_lines: u64[], proof: u64[], rline: 0, ranges: ranges, sigs: set_new(16), nargs: 6, retw: 2, rdxdead: 0, rdxcallee: u8[], curline: u8[], sigerr: u8[], wrong: u8[][], area: u8[][], areaopen: 0, argwritten: 0, ffis: set_new(16), xpend: 0, xstale: 18446744073709551615 };
    // A function whose address is taken (`NAME(%rip)`, or named by data such as a vtable) is
    // called through a pointer by code that does not know its signature, so it keeps the six-word
    // form: an indirect call passes six words and reads rax:rdx, and LLVM must never see a call
    // through a function type other than the callee's own. `Set` does not grow: an upper bound on
    // the names first (one per `(%rip)`, and for a data directive one per two bytes).
    mut ntaken = 0;
    for i in lines.len() {
        ntaken += rip_bound(view(lines[i]));
    }
    mut taken = set_new(ntaken + excluded.len() + 1);
    for i in lines.len() {
        rip_symbols(&mut taken, view(lines[i]));
    }
    for i in excluded.len() {
        set_add(&mut taken, view(excluded[i]));
    }
    l.sigs = signatures(facts, &taken);
    l.ffis = ffi_signatures(facts);
    // A wrong signature fact under --verify-facts: the compile fails with these lines.
    mut sigerrors = u8[];
    mut funcs = Func[];
    mut data = u8[][];
    split(&lines, &mut funcs, &mut data);
    // Each function's facts, chained by name, and each function by name.
    mut fheads = map_new(funcs.len() + 64);
    mut fnext = u64[];
    for i in facts.items.len() {
        f := &facts.items[i];
        fnext.push(map_get(&fheads, view(f.fn)));
        map_put(&mut fheads, view(f.fn), i);
    }
    mut fnames = map_new(funcs.len() + 64);
    for fi in funcs.len() {
        map_put(&mut fnames, view(funcs[fi].name), fi);
    }
    mut sibseen = set_new(64);
    // Labels named from data (jump tables) keep the functions that define them native.
    mut data_tokens = set_new(data.len() * 4 + 64);
    for i in data.len() {
        add_tokens(&mut data_tokens, view(data[i]));
    }
    // F1: build the typed siblings the fact-carrying call sites target. A sibling is the callee's
    // own word-machine body emitted with argument 0 as a `ptr` carrying `dereferenceable(24)
    // align 8` and with `data`/`len` passed in, so the two header loads are not in the body at all
    // and a call site reads them once, where the fact is established (docs/design/typed-ir.md).
    // A fact whose sibling cannot be built is simply not used, which is always correct.
    mut sibwidths = u64[];
    for i in facts.items.len() {
        f := &facts.items[i];
        if (f.kind != 1) || (f.what < 2) || (f.what > 5) {
            continue;
        }
        sn := sibling_name(view(f.callee), f.what, f.width);
        if set_has(&sibseen, view(sn)) {
            continue;
        }
        // Tried once per sibling, built or not: a sibling whose lowering failed fails again.
        set_add(&mut sibseen, view(sn));
        hit := map_get(&fnames, view(f.callee));
        if hit == 0 {
            continue;
        }
        at := hit - 1;
        l.sibwidth = f.width;
        l.sibwhat = f.what;
        exchange(&mut l.sd, copy(view("%d")));
        exchange(&mut l.sl, copy(view("%l")));
        cf := &funcs[at];
        cfacts := facts_of(&facts, &fheads, &fnext, view(cf.name), ranges);
        lower_function(&mut l, &lines, &cf, &cfacts);
        if l.fail == 0 {
            l.sibnames.push(copy(view(sn)));
            l.sibbodies.push(copy(view(l.body)));
            sibwidths.push(f.width);
        }
        l.sibwidth = 0;
        l.sibwhat = 0;
    }
    mut functions = u8[];
    mut native_lines = u8[][];
    native_lines.push(copy(view(".text")));
    mut native_tokens = set_new(funcs.len() * 64 + 64);
    // The functions are lowered in pieces, one forked copy each when the build's jobserver has
    // tokens free (compiler/jobs.grl), and the pieces are put back in order: the module text is the
    // same whatever the count, because every name a function's lowering makes is its own.
    mut pieces = lift_pieces(&mut l, &lines, &funcs, &facts, &fheads, &fnext, ranges, &data_tokens, &weak);
    for q in pieces.len() {
        pc := &pieces[q];
        if verify != 0 {
            sigerrors.append(view(pc.errors));
        }
        for i in pc.wrong.len() {
            l.wrong.push(copy(view(pc.wrong[i])));
        }
        functions.append(view(pc.functions));
        mut kq = 0;
        for i in pc.native.len() {
            native_lines.push(copy(view(pc.native[i])));
            if (kq < pc.kept.len()) && (pc.kept[kq] == i) {
                // A `.type NAME,@function` line only states what NAME is: it is not a use.
                if !starts(view(pc.native[i]), view(".type ")) {
                    add_tokens(&mut native_tokens, view(pc.native[i]));
                }
                kq += 1;
            }
        }
        for i in pc.lifted.len() {
            l.lifted.push(copy(view(pc.lifted[i])));
        }
        for i in pc.calls.len() {
            l.calls.push(copy(view(pc.calls[i])));
        }
        for i in pc.refs.len() {
            l.refs.push(copy(view(pc.refs[i])));
        }
        for i in pc.addrs.len() {
            l.addrs.push(copy(view(pc.addrs[i])));
        }
    }
    for i in data.len() {
        // `.type` is a statement about a symbol, not a use of it (see the bodies above).
        if !starts(view(data[i]), view(".type ")) {
            add_tokens(&mut native_tokens, view(data[i]));
        }
    }
    // The typed siblings, emitted as internal functions: the word-machine body with the header
    // fields passed in, under a pointer the fact says is 24 bytes at eight-byte alignment.
    for i in l.sibnames.len() {
        mut guard = u8[];
        num(&mut guard, i);
        put(&mut functions, view("define internal {i64, i64} @\""));
        put(&mut functions, view(l.sibnames[i]));
        put(&mut functions, view("\"(ptr nocapture nofree dereferenceable(24) align 8 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %d, i64 %l)"));
        atomics_inline(&mut functions, l.target);
        put(&mut functions, view(" {\n"));
        put(&mut functions, view(l.sibbodies[i]));
        put(&mut functions, view("}\n"));
        l.lifted.push(copy(view(l.sibnames[i])));
    }
    mut lifted = set_new(l.lifted.len() + 16);
    for i in l.lifted.len() {
        set_add(&mut lifted, view(l.lifted[i]));
    }
    // Calls and references were appended as found; the sets below deduplicate them.
    l.calls.push(copy(view("rt_abort")));
    for i in l.calls.len() {
        l.refs.push(copy(view(l.calls[i])));
    }
    // The module text.
    mut ir = u8[];
    put(&mut ir, view("target triple = \""));
    put(&mut ir, triple);
    put(&mut ir, view("\"\n"));
    mut head = u8[];
    header(&mut head);
    if target != 0 {
        // The cold abort stub calls rt_abort through the same NAME.ll / NAME.c naming.
        hl := split_lines(view(head));
        head = u8[];
        for i in hl.len() {
            put(&mut head, view(rename_calls(view(hl[i]), &lifted)));
            head.push(10);
        }
    }
    put(&mut ir, view(head));
    if verify != 0 {
        dump_facts(&mut ir, facts);
    }
    mut callset = set_new(l.calls.len() + 16);
    for i in l.calls.len() {
        set_add(&mut callset, view(l.calls[i]));
    }
    mut exported = set_new(l.refs.len() + 16);
    if target != 0 {
        mut declared = set_new(l.addrs.len() + 16);
        for i in l.addrs.len() {
            a := view(l.addrs[i]);
            // Lifted functions and called native functions are declared under NAME.ll / NAME.c,
            // so their plain names (the native-convention entry) need their own declaration.
            renamed := set_has(&lifted, a) || set_has(&callset, a);
            if renamed && !set_has(&declared, a) {
                set_add(&mut declared, a);
                set_add(&mut native_tokens, a);
                put(&mut ir, view("@\""));
                put(&mut ir, a);
                put(&mut ir, view("\" = external hidden global i8\n"));
            }
        }
    }
    for i in l.refs.len() {
        r := view(l.refs[i]);
        if set_has(&lifted, r) || set_has(&exported, r) {
            continue;
        }
        mut name = copy(r);
        if is_local_label(r) {
            name = pool_name(r);
        }
        set_add(&mut exported, r);
        // The module defines these itself (weak, beside the intrinsics it lowers to them), so a
        // C declaration of the same name - an `extern "C"` memcpy a program calls - must not
        // declare them again: with opaque pointers the call needs no matching declaration.
        if (target == 0) && (eq(r, view("memcpy")) || eq(r, view("memset")) || eq(r, view("memmove"))) {
            continue;
        }
        if set_has(&callset, r) {
            // A native body with a signature fact is called with exactly its words (lower_call).
            mut dn = 6;
            mut dw = 2;
            dcode := set_get(&l.sigs, r);
            if dcode != 0 {
                dn = dcode / 4;
                dw = dcode % 4;
            }
            fdecl := set_get(&l.ffis, r);
            if (dcode == 0) && (fdecl > 1) && (target == 0) {
                put(&mut ir, view("declare "));
                put(&mut ir, view(ffi_ret_type(fdecl - 2)));
                put(&mut ir, view(" @\""));
                put(&mut ir, view(name));
                put(&mut ir, view("\"("));
                put(&mut ir, view(ffi_params(fdecl - 2)));
                put(&mut ir, view(")\n"));
                continue;
            }
            put(&mut ir, view("declare "));
            put(&mut ir, view(result_type(dw)));
            put(&mut ir, view(" @\""));
            put(&mut ir, view(name));
            if target != 0 {
                put(&mut ir, view(".c"));
            }
            put(&mut ir, view("\"("));
            for q in dn {
                if q != 0 {
                    put(&mut ir, view(", "));
                }
                put(&mut ir, view("i64"));
            }
            put(&mut ir, view(")\n"));
        } else {
            put(&mut ir, view("@\""));
            put(&mut ir, view(name));
            put(&mut ir, view("\" = external hidden global i8\n"));
        }
    }
    // Lifted functions native code does not name are internal (inlinable and removable).
    mut thunks = u8[];
    // rename_line renames only exported local labels: when there are none, no line can change.
    mut exported_local = false;
    for i in exported.keys.len() {
        if (exported.used[i] != 0) && is_local_label(view(exported.keys[i])) {
            exported_local = true;
        }
    }
    // The function text line by line, trimmed as split_lines trims, without copying a line unless
    // it has to change: almost every line goes straight to the module.
    mut at: u64 = 0;
    while at < functions.len() {
        mut e0 = at;
        while (e0 < functions.len()) && (functions[e0] != 10) {
            e0 += 1;
        }
        mut a0 = at;
        mut b0 = e0;
        at = e0 + 1;
        while a0 < b0 && (functions[a0] == 32 || functions[a0] == 9) {
            a0 += 1;
        }
        while b0 > a0 && (functions[b0 - 1] == 32 || functions[b0 - 1] == 9 || functions[b0 - 1] == 13) {
            b0 -= 1;
        }
        raw := functions[a0: b0];
        if (target == 0) && !starts(raw, view("define ")) && (!exported_local || !has(raw, view(".L"))) {
            put(&mut ir, raw);
            ir.push(10);
            continue;
        }
        mut renamed = copy(raw);
        if target != 0 {
            renamed = rename_calls(raw, &lifted);
        }
        line := view(renamed);
        at := define_name_at(line);
        if at != 0 {
            mut e = at;
            while (e < line.len()) && (line[e] != 34) {
                e += 1;
            }
            mut fname = sub(line, at, e);
            if (target != 0) && ends(view(fname), view(".ll")) {
                fname = sub(view(fname), 0, fname.len() - 3);
            }
            if !set_has(&native_tokens, view(fname)) & !eq(view(fname), view("_start")) {
                put(&mut ir, view("define internal "));
                put(&mut ir, view(sub(line, 7, line.len())));
                ir.push(10);
                continue;
            }
        }
        if (target != 0) && (at != 0) {
            mut e = at;
            while (e < line.len()) && (line[e] != 34) {
                e += 1;
            }
            fname := sub(line, at, e - 3);
            thunk_into_ir(&mut thunks, view(fname), target, set_has(&weak, view(fname)));
        }
        if at != 0 {
            // A body the stream declared `.weak` (a generic specialisation, a content-addressed
            // drop helper) may be defined by every module that instantiates it, so its lifted body
            // is weak too, or a release build of two such modules fails to link. `weak_odr`, not
            // `weak`: every definition is the same code, so LLVM may inline it (a plain weak body is
            // interposable and never inlined, which kept every generic call a call).
            mut e = at;
            while (e < line.len()) && (line[e] != 34) {
                e += 1;
            }
            mut base = sub(line, at, e);
            if ends(view(base), view(".ll")) {
                base = sub(view(base), 0, base.len() - 3);
            }
            if set_has(&weak, view(base)) {
                put(&mut ir, view("define weak_odr "));
                put(&mut ir, view(rename_line(view(sub(line, 7, line.len())), &exported)));
                ir.push(10);
                continue;
            }
        }
        put(&mut ir, view(rename_line(line, &exported)));
        ir.push(10);
    }
    // Native functions, then data: labels the IR references become hidden globals, and the
    // assembler-temporary .L ones are renamed everywhere they appear.
    mut native = u8[];
    for i in native_lines.len() {
        line := view(native_lines[i]);
        // A lifted function's `.type` line would name, in the native object, a symbol that is
        // defined (and usually internal) in the IR one.
        if starts(line, view(".type ")) && set_has(&lifted, view(type_name(line))) {
            continue;
        }
        put(&mut native, view(rename_line(line, &exported)));
        native.push(10);
    }
    for i in data.len() {
        line := view(data[i]);
        if starts(line, view(".type ")) && set_has(&lifted, view(type_name(line))) {
            continue;
        }
        name := label_of(line);
        if (name.len() != 0) & set_has(&exported, view(name)) {
            mut gname = copy(view(name));
            if is_local_label(view(name)) {
                gname = pool_name(view(name));
            }
            // A weak datum (a content-addressed vtable) already says `.weak`; `.globl` would
            // change its binding, so it only gains `.hidden`.
            if !set_has(&weak, view(name)) {
                put(&mut native, view(".globl "));
                put(&mut native, view(gname));
                native.push(10);
            }
            put(&mut native, view(".hidden "));
            put(&mut native, view(gname));
            native.push(10);
        }
        put(&mut native, view(rename_line(line, &exported)));
        native.push(10);
    }
    if target != 0 {
        for i in l.calls.len() {
            name := view(l.calls[i]);
            if !set_has(&lifted, name) {
                mut marker = copy(name);
                marker.push(1);
                if !set_has(&lifted, view(marker)) {
                    set_add(&mut lifted, view(marker));
                    thunk_from_ir(&mut thunks, name, target);
                }
            }
        }
    }
    return Lowered { ir: ir, native: native, thunks: thunks, error: sigerrors, wrong: l.wrong };
}
