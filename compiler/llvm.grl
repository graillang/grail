    }
    return ();
}
// The effect of a call: the two accessors that grow a sequence, the two that give one a known
// length, and everything else -- which may take any argument by reference and is therefore a drop.
fn rg_call(rc: (&RC), st: (&mut u64[]), target: (&[u8]), seed: u64, trip: u64) -> unit {
    if eq(target, view("rt_new")) {
        if seed != 0 {
            rg_clobber(&rc, &mut st);
            g := rg_lgen(&rc, &st, seed - 1);
            rg_header(&mut st, 0, seed - 1);
            rg_lset(&rc, &mut st, seed - 1, 1, 0, g);
        }
        return ();
    }
    if starts(target, view("rt_push")) {
        arg := rg_loc(&rc, view("%rdi"));
        h := rg_hdr_of(&rc, &st, arg);
        if h != 0 {
            rg_grow_len(&rc, &mut st, h - 1, trip);
        }
        rg_clobber(&rc, &mut st);
        return ();
    }
    if starts(target, view("rt_fill")) {
        arg := rg_loc(&rc, view("%rdi"));
        h := rg_hdr_of(&rc, &st, arg);
        if h != 0 {
            n := rg_span_of(&rc, &st, view("%rdx"));
            if n.ok != 0 {
                rg_set_len(&rc, &mut st, h - 1, n.lo);
            } else {
                rg_kill_len(&rc, &mut st, h - 1);
            }
        }
        rg_clobber(&rc, &mut st);
        return ();
    }
    if eq(target, view("rt_vec_copy")) {
        if seed != 0 {
            src := rg_loc(&rc, view("%rdi"));
            h := rg_hdr_of(&rc, &st, src);
            rg_clobber(&rc, &mut st);
            rg_header(&mut st, 0, seed - 1);
            if h != 0 {
                rg_lset(&rc, &mut st, seed - 1, rg_have(&rc, &st, h - 1), rg_lb(&rc, &st, h - 1), rg_lgen(&rc, &st, seed - 1));
            }
        }
        return ();
    }
    if eq(target, view("rt_len")) {
        arg := rg_loc(&rc, view("%rdi"));
        h := rg_hdr_of(&rc, &st, arg);
        rg_clobber(&rc, &mut st);
        if h != 0 {
            rg_lenw(&mut st, 0, h - 1);
        }
        return ();
    }
    if starts(target, view(".D")) {
        // Drop glue (`.D<hash>`, emitted per type) is given the value being dropped and frees what
        // that value owns. It never receives a frame slot's address and cannot write one, and the
        // value it frees is dead by the ownership rules, so no other identity's facts change.
        rg_clobber(&rc, &mut st);
        return ();
    }
    if rg_readonly(target) {
        rg_clobber(&rc, &mut st);
        if eq(target, view("rt_slot")) || eq(target, view("rt_slotu")) {
            // The address of one element in the sequence's heap buffer: a store through it changes
            // that element and nothing else - never a frame slot, a header or a length word.
            rax := rg_loc(&rc, view("%rax"));
            if rax != rg_none() {
                rg_put(&mut st, rax, 6, 0, 0, 0, 0);
            }
        }
        return ();
    }
    // Anything else may take a sequence by reference and rewrite its header: every identity whose
    // header word the call is given loses its length, and every slot a store through a register
    // could reach loses its fact.
    for i in 6 {
        arg := rg_loc(&rc, view(arg_reg(i)));
