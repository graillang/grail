        rg_clear(&mut st, i);
        return ();
    }
    if (sym == 0) & (sgen == 0) {
        rg_put(&mut st, i, 1, lo, hi, 0, 0);
        return ();
    }
    rg_put(&mut st, i, 1, lo, hi, sym, sgen);
    return ();
}
fn rg_header(st: (&mut u64[]), i: u64, id: u64) -> unit {
    rg_put(&mut st, i, 2, id, 0, 0, 0);
    return ();
}
fn rg_addr(st: (&mut u64[]), i: u64, k: u64) -> unit {
    rg_put(&mut st, i, 3, k, 0, 0, 0);
    return ();
}
fn rg_lenw(st: (&mut u64[]), i: u64, id: u64) -> unit {
    rg_put(&mut st, i, 4, id, 0, 0, 0);
    return ();
}
fn rg_have(rc: (&RC), st: (&u64[]), k: u64) -> u64 {
    b := 5 * rc.nloc + 3 * k;
    if b + 3 > st.len() {
        return 0;
    }
    return st[b];
}
fn rg_lb(rc: (&RC), st: (&u64[]), k: u64) -> u64 {
    b := 5 * rc.nloc + 3 * k;
    if b + 3 > st.len() {
        return 0;
    }
    return st[b + 1];
}
fn rg_lgen(rc: (&RC), st: (&u64[]), k: u64) -> u64 {
    b := 5 * rc.nloc + 3 * k;
    if b + 3 > st.len() {
        return 0;
    }
    return st[b + 2];
}
fn rg_lset(rc: (&RC), st: (&mut u64[]), k: u64, have: u64, lb: u64, gen: u64) -> unit {
    b := 5 * rc.nloc + 3 * k;
    if b + 3 > st.len() {
        return ();
