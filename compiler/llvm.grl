// The pieces the module's functions are lowered in: as many as the jobserver grants (at most one per
// half-megabyte of stream, `GRAIL_JOBS=1` for one process), cut at function boundaries so each holds
// about the same number of lines, each lowered in a forked copy of this process that shares its
// memory until it writes. One piece is lowered here.
fn lift_pieces<a, b, c, d, e, g, h>(l: (&a mut L), lines: (&b u8[][]), funcs: (&c Func[]), facts: (&d Facts), fheads: (&e Map), fnext: (&e u64[]), ranges: u64, data_tokens: (&g Set), weak: (&h Set)) -> Piece[] {
    mut size: u64 = 0;
    for i in lines.len() {
        size += lines[i].len() + 1;
    }
    mut wanted = host::cpus();
    asked := host::env(view("GRAIL_JOBS"));
    if asked.len() != 0 {
        wanted = 0;
        for i in asked.len() {
            if (47 < asked[i]) && (asked[i] < 58) {
