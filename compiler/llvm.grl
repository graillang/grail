                // above the parameters, so all its words share the zeroing decision).
                for j in 1..words {
                    if (zero >= 0) && (k >= j) {
                        if (k - j >= u64(zero)) && (k - j < slots) {
                            mut at = u8[];
                            num(&mut at, 8 * j);
                            wt := def(&mut l, view("getelementptr i8, ptr {}, i64 {}"), &u8[][copy(view(sn)), at]);
