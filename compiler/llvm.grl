}
fn rg_span_of(rc: (&RC), st: (&u64[]), op: (&[u8])) -> Span {
    s := rg_read(&rc, &st, op);
    if s.ok != 1 {
        return no_span();
    }
    return s;
}
// A write to `op` ends whatever fact it held: a register or a frame slot directly, or -- through a
// register -- the frame slots whose address escaped, which are the only ones such a store reaches.
fn rg_wrote(rc: (&RC), st: (&mut u64[]), op: (&[u8])) -> unit {
    loc := rg_loc(&rc, op);
    if loc != rg_none() {
        rg_clear(&mut st, loc);
        return ();
    }
    m := rg_mem(op);
    if m.ok == 0 {
        return ();
    }
    if rg_k(&st, m.base) == 6 {
        // A store into a sequence element (`p[i] = ...`) reaches heap element storage only.
        return ();
    }
    if rg_k(&st, m.base) == 3 {
        rg_clear(&mut st, 14 + rg_lo(&st, m.base));
    }
    for k in rc.esc.len() {
        if rc.esc[k] != 0 {
            rg_clear(&mut st, 14 + k);
        }
    }
    return ();
}
// 1 when the value the operand names lies below `len(identity)`: either below a known lower bound
// on that length, or below a length word the same generation of the length still bounds.
fn rg_below(rc: (&RC), st: (&u64[]), s: (&Span), id: u64) -> bool {
    if s.ok != 1 {
        return false;
    }
    if rg_have(&rc, &st, id) != 0 {
        if s.hi < rg_lb(&rc, &st, id) {
            return true;
        }
    }
    if s.sym == id + 1 {
        if s.sgen == rg_lgen(&rc, &st, id) {
            return true;
        }
    }
    return false;
}
fn rg_span_clamp(st: (&mut u64[]), loc: u64, top: u64) -> unit {
    if rg_k(&st, loc) != 1 {
        rg_clear(&mut st, loc);
        return ();
    }
    mut hi = rg_hi(&st, loc);
    if hi > top {
        hi = top;
    }
    mut lo = rg_lo(&st, loc);
    if lo > top {
        lo = 0;
    }
    rg_word(&mut st, loc, lo, hi, 0, 0);
    return ();
}
// `movq`/`movl`-family: the destination takes the source's fact when it has one, narrowed to the
// width the move keeps.
fn rg_move(rc: (&RC), st: (&mut u64[]), src: (&[u8]), dst: (&[u8]), width: u64) -> unit {
    dloc := rg_loc(&rc, dst);
    if dloc == rg_none() {
        rg_wrote(&rc, &mut st, dst);
        return ();
    }
    s0 := rg_read(&rc, &st, src);
    if s0.ok == 0 {
        rg_clear(&mut st, dloc);
        return ();
    }
    if s0.ok >= 2 {
        if (s0.ok == 3) & (width != 64) {
            rg_clear(&mut st, dloc);
            return ();
        }
        rg_put(&mut st, dloc, s0.ok, s0.lo, s0.hi, s0.sym, s0.sgen);
        return ();
    }
    // Narrowing is a fact only when the value is provably in range; otherwise the truncation ends
    // the fact, which is why a `movl` of a wide word is [0, 2^32) and nothing more.
    mut top = rg_max();
    if width == 32 {
        top = 4294967295;
    }
    if width == 8 {
        top = 255;
    }
    if width == 16 {
        top = 65535;
    }
    mut lo = s0.lo;
    mut hi = s0.hi;
    mut sym = s0.sym;
    mut sgen = s0.sgen;
    if hi > top {
        if (sym == 0) & (width != 64) {
            lo = 0;
            hi = top;
        } else {
            rg_clear(&mut st, dloc);
            return ();
        }
    }
    if width != 64 {
