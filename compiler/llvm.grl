// `movq`/`movl`-family: the destination takes the source's fact when it has one, narrowed to the
// width the move keeps.
fn rg_move(rc: (&RC), st: (&mut u64[]), src: (&[u8]), dst: (&[u8]), width: u64) -> unit {
    dloc := rg_loc(&rc, dst);
    if dloc == rg_none() {
        rg_wrote(&rc, &mut st, dst);
        return ();
    }
    s0 := rg_read(&rc, &st, src);
    if s0.ok == 0 {
        rg_clear(&mut st, dloc);
        return ();
    }
    if s0.ok >= 2 {
        if (s0.ok == 3) & (width != 64) {
            rg_clear(&mut st, dloc);
            return ();
        }
        rg_put(&mut st, dloc, s0.ok, s0.lo, s0.hi, s0.sym, s0.sgen);
        return ();
    }
    // Narrowing is a fact only when the value is provably in range; otherwise the truncation ends
    // the fact, which is why a `movl` of a wide word is [0, 2^32) and nothing more.
    mut top = rg_max();
    if width == 32 {
        top = 4294967295;
    }
    if width == 8 {
        top = 255;
    }
    if width == 16 {
        top = 65535;
    }
    mut lo = s0.lo;
    mut hi = s0.hi;
    mut sym = s0.sym;
    mut sgen = s0.sgen;
