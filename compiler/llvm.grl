// On AArch64 and RISC-V the word machine returns rax:rdx in x9:x2 (t0:a2), while LLVM's C
// convention returns in x0:x1 (a0:a1); arguments already agree (x0..x5 / a0..a5). IR functions
// are therefore defined as NAME.ll, native code reaches them through a thunk named NAME, and IR
// reaches native functions through NAME.c.
fn thunk_into_ir<a>(out: (&a mut u8[]), name: &a [u8], target: u64, weak: bool) -> unit {
    // A name the stream declared `.weak` keeps that binding: a second `.globl` is an assembler
    // error (`changed binding to STB_GLOBAL`).
    if weak {
        put(&mut out, view(".text\n.weak "));
    } else {
        put(&mut out, view(".text\n.globl "));
    }
    put(&mut out, name);
    put(&mut out, view("\n.hidden "));
    put(&mut out, name);
    out.push(10);
    put(&mut out, name);
    put(&mut out, view(":\n"));
    if target == 1 {
        put(&mut out, view("stp x29,x30,[sp,#-16]!\nmov x29,sp\nbl "));
        put(&mut out, name);
        put(&mut out, view(".ll\nmov x9,x0\nmov x2,x1\nldp x29,x30,[sp],#16\nret\n"));
    } else {
        put(&mut out, view("addi sp,sp,-16\nsd ra,8(sp)\nsd s0,0(sp)\naddi s0,sp,16\ncall "));
        put(&mut out, name);
        put(&mut out, view(".ll\nmv t0,a0\nmv a2,a1\nld ra,8(sp)\nld s0,0(sp)\naddi sp,sp,16\nret\n"));
    }
    return ();
}
fn thunk_from_ir<a>(out: (&a mut u8[]), name: &a [u8], target: u64) -> unit {
    put(&mut out, view(".text\n.globl "));
    put(&mut out, name);
    put(&mut out, view(".c\n.hidden "));
    put(&mut out, name);
    put(&mut out, view(".c\n"));
    put(&mut out, name);
    put(&mut out, view(".c:\n"));
    if target == 1 {
        put(&mut out, view("stp x29,x30,[sp,#-16]!\nmov x29,sp\nbl "));
        put(&mut out, name);
        put(&mut out, view("\nmov x0,x9\nmov x1,x2\nldp x29,x30,[sp],#16\nret\n"));
    } else {
        put(&mut out, view("addi sp,sp,-16\nsd ra,8(sp)\nsd s0,0(sp)\naddi s0,sp,16\ncall "));
        put(&mut out, name);
        put(&mut out, view("\nmv a0,t0\nmv a1,a2\nld ra,8(sp)\nld s0,0(sp)\naddi sp,sp,16\nret\n"));
    }
    return ();
}
// `line` with each `@"NAME"(` call or definition renamed to NAME.ll (lifted) or NAME.c (native).
fn rename_calls<a, b>(line: &a [u8], lifted: (&b Set)) -> u8[] {
    if !has(line, view("@\"")) {
        return copy(line);
    }
    mut out = u8[];
    mut i: u64 = 0;
    while i < line.len() {
        if (line[i] == 64) && (i + 1 < line.len()) && (line[i + 1] == 34) {
            mut e = i + 2;
            while (e < line.len()) && (line[e] != 34) {
                e += 1;
            }
            if (e + 1 < line.len()) && (line[e + 1] == 40) {
                name := sub(line, i + 2, e);
                put(&mut out, view("@\""));
                put(&mut out, view(name));
                if !eq(view(name), view("rt_abort.cold")) && !starts(view(name), view("llvm.")) {
                    if set_has(&lifted, view(name)) {
                        put(&mut out, view(".ll"));
                    } else {
                        put(&mut out, view(".c"));
                    }
                }
                out.push(34);
                i = e + 1;
                continue;
            }
        }
        out.push(line[i]);
        i += 1;
    }
    return out;
}
pub fn lower_for<a, b>(stream: &a [u8], target: u64, facts: (&b Facts), verify: u64, ranges: u64) -> Lowered {
    triple := target_triple(target);
    return lower_target(stream, view(triple), target, facts, verify, ranges);
}
pub fn lower<a, b, c>(stream: &a [u8], triple: &b [u8], facts: (&c Facts), verify: u64, ranges: u64) -> Lowered {
    return lower_target(stream, triple, 0, facts, verify, ranges);
}
// What lowering the functions [lo, hi) adds to the module: the lifted bodies, the native lines (and
