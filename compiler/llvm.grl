    st[b] = have;
    st[b + 1] = lb;
    st[b + 2] = gen;
    return ();
}
// The length of identity k may have changed: the lower bound is gone and every bound stated
// against the old length is invalid.
fn rg_kill_len(rc: (&RC), st: (&mut u64[]), k: u64) -> unit {
    rg_lset(&rc, &mut st, k, 0, 0, wrapping_add(rg_lgen(&rc, &st, k), 1));
    return ();
}
// The length of identity k grows by `n`: a bound that was known stays known, and the generation
// moves so a bound stated against the old length cannot be used.
fn rg_grow_len(rc: (&RC), st: (&mut u64[]), k: u64, n: u64) -> unit {
    mut have: u64 = 0;
    mut lb: u64 = 0;
    if rg_have(&rc, &st, k) != 0 {
        have = 1;
        lb = wrapping_add(rg_lb(&rc, &st, k), n);
    }
    rg_lset(&rc, &mut st, k, have, lb, wrapping_add(rg_lgen(&rc, &st, k), 1));
    return ();
}
// The length of identity k is exactly `n`, which is what a fill of a constant count says.
fn rg_set_len(rc: (&RC), st: (&mut u64[]), k: u64, n: u64) -> unit {
    rg_lset(&rc, &mut st, k, 1, n, wrapping_add(rg_lgen(&rc, &st, k), 1));
    return ();
}
// dst |= src over both halves of the state; 1 when dst changed. With `widen` set - from the fourth
// round of the fixpoint on, and only on a back edge (a join into a block at or before the one the
// edge leaves, i.e. a loop head; widening a forward join such as a guard's edge into the body would
// throw away exactly the bound the guard just proved) - a join that would move a bound jumps
// instead (widening with thresholds): an upper bound that grew goes to the smallest immediate in
// the function that still covers it - the loop guard's own bound, typically, so `while i < 300`
// holds the counter at [0, 300] at the head and the guard narrows it to [0, 299] in the body - or
// to rg_max when none does; a lower bound that fell goes to 0; and a length generation the two
// paths disagree on becomes a fixed value for this block and identity, which no bound was ever
// stated against. All of these only lose facts, so they stay sound, and none moves twice, so a
// loop of any trip count converges in a few rounds.
fn rg_widen_gen(block: u64, id: u64) -> u64 {
    return 9223372036854775808 + block * 1099511627776 + id * 1048576;
}
fn rg_join(rc: (&RC), dst: (&mut u64[]), src: (&u64[]), widen: u64, block: u64, thr: (&u64[])) -> u64 {
    mut changed = 0;
    if dst.len() != src.len() {
        return 0;
    }
    for i in rc.nloc {
        b := 5 * i;
        dk := dst[b];
        sk := src[b];
        if dk != sk {
            // A location the two paths type differently holds a word this analysis cannot type.
            if (dk != 0) || (dst[b + 2] != rg_max()) {
                changed = 1;
            }
            rg_clear(&mut dst, i);
            continue;
        }
        if dk == 1 {
            mut lo = dst[b + 1];
            if src[b + 1] < lo {
                lo = src[b + 1];
                if widen != 0 {
                    lo = 0;
                }
                changed = 1;
            }
            mut hi = dst[b + 2];
            if src[b + 2] > hi {
                hi = src[b + 2];
                if widen != 0 {
                    mut top = rg_max();
                    for t in thr.len() {
                        if (thr[t] >= hi) & (thr[t] < top) {
                            top = thr[t];
                        }
                    }
                    hi = top;
                }
                changed = 1;
            }
            mut sym = dst[b + 3];
            mut sgen = dst[b + 4];
            if (src[b + 3] != sym) || (src[b + 4] != sgen) {
                sym = 0;
                sgen = 0;
            }
            dst[b + 1] = lo;
            dst[b + 2] = hi;
            dst[b + 3] = sym;
            dst[b + 4] = sgen;
            continue;
        }
        // A kind that is not an interval survives only while both paths agree on the identity.
        if (dk != 0) & (dst[b + 1] != src[b + 1]) {
            rg_clear(&mut dst, i);
            changed = 1;
        }
    }
    for i in rc.nid {
        b := 5 * rc.nloc + 3 * i;
        mut gen = dst[b + 2];
        if src[b + 2] > gen {
            gen = src[b + 2];
        }
        if (widen != 0) & (src[b + 2] != dst[b + 2]) {
            gen = rg_widen_gen(block, i);
        }
        mut have = dst[b];
        mut lb = dst[b + 1];
        if (have != 0) & (src[b] != 0) {
            if src[b + 1] < lb {
                lb = src[b + 1];
            }
        } else {
            have = 0;
            lb = 0;
        }
