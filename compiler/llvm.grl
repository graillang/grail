                num(&mut c, l.proof[i]);
                c.push(10);
                emit(&mut l, view(c), &u8[][]);
            }
        }
    }
    for m in instrs.len() {
        if l.fail != 0 {
            return ();
        }
        line := view(instrs[m]);
        name := label_of(line);
        if (name.len() != 0) & (name.len() + 1 == line.len()) {
            b := block_name(view(name));
            if l.term == 0 {
                emit(&mut l, view("br label %{}"), &u8[][copy(view(b))]);
            }
            begin_block(&mut l, view(b));
            continue;
        }
        if (line.len() == 0) || (line[0] == 46) {
            bad(&mut l);
            return ();
        }
        if l.term != 0 {
            next := fresh_block(&mut l);
            begin_block(&mut l, view(next));
        }
        l.rline = m;
        if l.verify != 0 {
            exchange(&mut l.curline, copy(line));
        }
        instruction(&mut l, line, &facts);
    }
    if l.term == 0 {
        emit(&mut l, view("unreachable"), &u8[][]);
    }
    return ();
}

// ---- the range fact: "this slot holds an integer in [lo, hi]" ----
//
// The bounds check costs a compare and a branch per element and LLVM cannot remove it, because the
// loop guard proves nothing about the index it is handed. A range fact is the missing proof, and it
// is a proof, not an assumption: every fact below is established from a literal, from a masking or a
// truncation to a narrow type, from an arithmetic chain over facts already established, or from a
// comparison that was already checked on the same path; and every fact is dropped by a write to the
// slot, by a call that may take it by reference, by an escaping address, and by a narrowing that is
// not provably in range. `--verify-facts` re-emits the check a fact removes, so a wrong fact aborts
// on the spot instead of reading whatever happens to be at the address.
//
// A state is a flat `u64[]` of `5 * nloc + 3 * nid` words.
// Per location i (0-13 a register in `reg_index` order, 14+k frame slot k):
//   kind 0 no fact (and dead for good: a location two paths disagree about stays untyped),
//   1 the interval [lo, hi], 2 a sequence header of identity `lo`, 3 the address of frame slot
//   `lo`, 4 the length word of identity `lo`, 5 a comparison result, 6 the address of an element in
//   a sequence's heap buffer (what `rt_slot` returns); `sym` is identity+1 while the word is proven to be
//   `< len(identity)`, and `sgen` is the length generation that bound was stated in.
// Per identity k: `have` (1 when `lb` is meaningful), `lb` a lower bound on the length, and `gen`,
// bumped by every event that may change the length -- the generation an `sym` bound is checked
// against, because a bound stated against a length that has since moved proves nothing.
struct RC {
    nloc: u64,
    nid: u64,
    // 1 when the frame is split, so each slot is a storage location of its own.
    split: u64,
    // The frame slots whose address the function takes (`leaq -N(%rbp)`): a store through a
    // register may write those, and no other frame slot.
    esc: u64[],
    // The escaped slots whose address may reach code that can write the slot: every escaped slot
    // except those whose every address goes only to shared-reference parameters (rg_mut_escape).
    // A call this analysis does not know clears these.
    mesc: u64[],
    // The identity a `rt_new`/`rt_vec_copy` call creates, plus one, by line; 0 for other lines.
    seed: u64[],
    // Counted fill loops (rg_fill_loops): at the exit label's line, `fill_at` is the first entry
    // plus one; each entry is a vector slot, the pushes into it per iteration, the loop bound's
    // operand and the counter's start, and `fill_next` chains the entries of one exit.
    fill_at: u64[],
    fill_slot: u8[][],
    fill_pushes: u64[],
    fill_bound: u8[][],
    fill_start: u64[],
    fill_next: u64[]
}
fn rg_none() -> u64 {
    return 18446744073709551615;
}
fn rg_max() -> u64 {
    return 18446744073709551615;
}
fn rc_new(nslots: u64, split: u64) -> RC {
    mut esc = u64[];
    for i in nslots {
        esc.push(0);
    }
    mesc := esc.copy();
    return RC { nloc: 14 + nslots, nid: 0, split: split, esc: esc, mesc: mesc, seed: u64[], fill_at: u64[], fill_slot: u8[][], fill_pushes: u64[], fill_bound: u8[][], fill_start: u64[], fill_next: u64[] };
}
fn rc_state(rc: (&RC)) -> u64[] {
    mut st = u64[];
    for i in 5 * rc.nloc + 3 * rc.nid {
        st.push(0);
    }
    for i in rc.nloc {
        st[5 * i + 2] = rg_max();
    }
    return st;
}
// The location a storage operand names, plus one (0-13 a register, 14+k frame slot k); 0 when the
// operand names no storage this analysis tracks.
fn rg_storage(op: (&[u8])) -> u64 {
    if (op.len() != 0) && (op[0] == 37) {
        r := reg_index(view(sub(op, 1, op.len())));
        if r < 14 {
            return r + 1;
        }
        return 0;
    }
    if !ends(op, view("(%rbp)")) || (op.len() < 6) {
        return 0;
    }
    n := op.len() - 6;
    if n < 2 {
        return 0;
    }
    d := parse_int(view(sub(op, 0, n)));
    if (d.ok == 0) || (d.v >= 0) || (d.v < -1073741824) {
        return 0;
    }
    k := u64(0 - (d.v + 1)) / 8;
    if 0 - i64(8 * (k + 1)) != d.v {
        return 0;
    }
    return 15 + k;
}
// The 8- and 16-bit aliases of a register this analysis tracks: `setb %al` and `movzbq %al,%rax`
// are how the front end materialises a comparison, and both halves have to land on `rax`.
fn rg_alias(rc: (&RC), op: (&[u8])) -> u64 {
    if (op.len() < 2) || (op[0] != 37) {
        return rg_none();
    }
    n := view(sub(op, 1, op.len()));
    if eq(n, view("al")) || eq(n, view("ax")) || eq(n, view("eax")) {
        return 0;
    }
    if eq(n, view("cl")) || eq(n, view("cx")) || eq(n, view("ecx")) {
        return 2;
    }
    if eq(n, view("dl")) || eq(n, view("dx")) || eq(n, view("edx")) {
        return 3;
    }
    return rg_none();
}
fn rg_loc(rc: (&RC), op: (&[u8])) -> u64 {
    al := rg_alias(&rc, &op);
    if al != rg_none() {
        return al;
    }
    id := rg_storage(view(op));
    if id == 0 {
        return rg_none();
    }
    if id >= 15 && rc.split == 0 {
        return rg_none();
    }
    return id - 1;
}
// A memory operand `off(%reg)`: `ok` 1 when it is exactly that, else through a register this
// analysis does not name.
struct Mem {
    ok: u64,
    off: i64,
    base: u64
}
fn no_mem() -> Mem {
    return Mem { ok: 0, off: 0, base: rg_none() };
}
fn rg_mem(op: (&[u8])) -> Mem {
    if (op.len() == 0) || (op[0] == 36) || !has(op, view("(")) || !ends(op, view(")")) {
        return no_mem();
    }
    mut open = op.len();
    for i in op.len() {
        if (op[i] == 40) & (open == op.len()) {
            open = i;
        }
    }
    if open == op.len() {
        return no_mem();
    }
    inner := operands(view(sub(op, open + 1, op.len() - 1)));
    if inner.len() != 1 {
        return no_mem();
    }
    reg := view(inner[0]);
    if (reg.len() < 2) || (reg[0] != 37) {
        return no_mem();
    }
    r := reg_index(view(sub(reg, 1, reg.len())));
    if r >= 14 {
        return no_mem();
    }
    mut off: i64 = 0;
    if open > 0 {
        p := parse_int(view(sub(op, 0, open)));
        if p.ok == 0 {
            return no_mem();
        }
        off = p.v;
    }
    return Mem { ok: 1, off: off, base: r };
}
fn rg_k(st: (&u64[]), i: u64) -> u64 {
    if 5 * i + 5 > st.len() {
        return 0;
    }
    return st[5 * i];
}
fn rg_lo(st: (&u64[]), i: u64) -> u64 {
    if 5 * i + 5 > st.len() {
        return 0;
    }
    return st[5 * i + 1];
}
fn rg_hi(st: (&u64[]), i: u64) -> u64 {
    if 5 * i + 5 > st.len() {
        return rg_max();
    }
    return st[5 * i + 2];
}
fn rg_sym(st: (&u64[]), i: u64) -> u64 {
    if 5 * i + 5 > st.len() {
        return 0;
    }
    return st[5 * i + 3];
}
fn rg_sgen(st: (&u64[]), i: u64) -> u64 {
    if 5 * i + 5 > st.len() {
        return 0;
    }
    return st[5 * i + 4];
}
fn rg_put(st: (&mut u64[]), i: u64, kind: u64, lo: u64, hi: u64, sym: u64, sgen: u64) -> unit {
    if 5 * i + 5 > st.len() {
        return ();
    }
    st[5 * i] = kind;
    st[5 * i + 1] = lo;
    st[5 * i + 2] = hi;
    st[5 * i + 3] = sym;
    st[5 * i + 4] = sgen;
    return ();
}
fn rg_clear(st: (&mut u64[]), i: u64) -> unit {
    rg_put(&mut st, i, 0, 0, rg_max(), 0, 0);
    return ();
}
fn rg_span(st: (&mut u64[]), i: u64, lo: u64, hi: u64) -> unit {
    if lo > hi {
        rg_clear(&mut st, i);
        return ();
    }
    rg_put(&mut st, i, 1, lo, hi, 0, 0);
    return ();
}
fn rg_word(st: (&mut u64[]), i: u64, lo: u64, hi: u64, sym: u64, sgen: u64) -> unit {
    if lo > hi {
