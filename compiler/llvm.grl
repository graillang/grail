}
fn pack_piece<a>(p: (&a Piece)) -> u8[] {
    mut out = u8[];
    lp_text(&mut out, view(p.functions));
    lp_texts(&mut out, &p.native);
    lp_word(&mut out, p.kept.len());
    for i in p.kept.len() {
        lp_word(&mut out, p.kept[i]);
    }
    lp_texts(&mut out, &p.lifted);
    lp_texts(&mut out, &p.calls);
    lp_texts(&mut out, &p.refs);
    lp_texts(&mut out, &p.addrs);
    lp_text(&mut out, view(p.errors));
    lp_texts(&mut out, &p.wrong);
