        return 4;
    }
    if rel == 2 {
        return 3;
    }
    if rel == 3 {
        return 2;
    }
    if rel == 4 {
        return 1;
    }
    return rel;
}
// The relation that holds when `rel` does not: the edge of a branch that is not taken.
fn rg_inverse(rel: u64) -> u64 {
    if rel == 1 {
        return 3;
    }
    if rel == 2 {
        return 4;
    }
    if rel == 3 {
        return 1;
    }
    if rel == 4 {
        return 2;
    }
    if rel == 5 {
        return 6;
    }
    return 5;
}
// The verdict of a call line: 3 when the accessor's bounds check cannot fire here.
fn rg_call_verdict(rc: (&RC), st: (&u64[]), line: (&[u8])) -> u64 {
    o := operands(view(sub(line, 5, line.len())));
    if o.len() != 1 {
        return 0;
    }
    if rg_accessor(view(o[0])) == 0 {
        return 0;
    }
    id := rg_hdr_of(&rc, &st, 5);
    if id == 0 {
        return 0;
    }
    s := rg_span_of(&rc, &st, view("%rsi"));
    if !rg_below(&rc, &st, &s, id - 1) {
        return 0;
    }
    return 3;
}
// dst |= src, taking src wholesale when dst has nothing on it yet.
fn rg_into(rc: (&RC), st: (&mut u64[][]), nblk: u64, b: u64, src: (&u64[]), widen: u64, thr: (&u64[])) -> u64 {
    if b >= nblk {
        return 0;
    }
    if st[b].len() == 0 {
        st[b] = src.copy();
        return 1;
    }
    return rg_join(&rc, &mut st[b], &src, widen, b, &thr);
}
// Walks a block from `cur`, applying each instruction and recording the two verdicts a fact proves.
fn rg_run(rc: (&RC), cur: (&mut u64[]), instrs: (&u8[][]), start: u64, stop: u64, trip: (&u64[]), out: (&mut u64[]), proofs: u64, prov: (&mut u64[]), pcmp: (&mut u64[]), snap: (&mut u64[])) -> unit {
    for i in stop - start {
        n := start + i;
        line := view(instrs[n]);
        if proofs != 0 {
            if starts(line, view("call ")) {
                out[n] = rg_call_verdict(&rc, &cur, line);
            }
        }
        if (n < rc.fill_at.len()) && (rc.fill_at[n] != 0) {
            rg_fill_exit(&rc, &mut cur, rc.fill_at[n] - 1);
        }
        rg_step(&rc, &mut cur, line, rc.seed[n], trip[n], n, &mut pcmp, &mut prov, &mut snap, &mut out);
    }
    return ();
}
// The exit of a counted fill loop (rg_fill_loops): the loop ran at least `bound - start` times, each
// iteration pushed `pushes` elements onto the vector in `slot`, and nothing in the body can shrink
// it, so its length is at least `(bound - start) * pushes` - whatever it was before. Only lower
// bounds are used: the bound's lower bound, the counter's exact start.
fn rg_fill_exit(rc: (&RC), st: (&mut u64[]), first: u64) -> unit {
    mut e = first;
    while true {
        bound := rg_span_of(&rc, &st, view(rc.fill_bound[e]));
        h := rg_hdr_of(&rc, &st, rg_loc(&rc, view(rc.fill_slot[e])));
        if (bound.ok != 0) && (h != 0) && (bound.lo > rc.fill_start[e]) {
            iters := bound.lo - rc.fill_start[e];
            p := rc.fill_pushes[e];
            if (p != 0) && (iters <= 4294967295) && (p <= 4294967295) {
                mut lb = iters * p;
                k := h - 1;
                if (rg_have(&rc, &st, k) != 0) && (rg_lb(&rc, &st, k) > lb) {
                    lb = rg_lb(&rc, &st, k);
                }
                rg_lset(&rc, &mut st, k, 1, lb, wrapping_add(rg_lgen(&rc, &st, k), 1));
            }
        }
        if rc.fill_next[e] == 0 {
            return ();
        }
        e = rc.fill_next[e] - 1;
    }
    return ();
}
// `jcc NAME` names exactly the label NAME (not one whose name merely ends the same way).
fn rg_names_label(line: (&[u8]), name: (&[u8])) -> bool {
    return ends(line, name) && (line.len() > name.len()) && (line[line.len() - name.len() - 1] == 32);
}
fn rg_ends_colon(line: (&[u8])) -> bool {
    return (line.len() > 0) && (line[line.len() - 1] == 58);
}
fn rg_frame_op(op: (&[u8])) -> bool {
    return (op.len() > 6) && (op[0] == 45) && ends(op, view("(%rbp)"));
}
// The only calls a fill loop's body may make: ones that cannot shrink or rebind a vector.
fn rg_fill_call_ok(target: (&[u8])) -> bool {
    return eq(target, view("rt_abort")) || eq(target, view("rt_int_cast")) || eq(target, view("rt_f32_from_int"))
        || eq(target, view("rt_f64_op")) || eq(target, view("rt_f32_round")) || eq(target, view("rt_len"))
        || starts(target, view("rt_at")) || starts(target, view("rt_slot")) || starts(target, view("rt_push"));
}
// Counted fill loops, recognised in the shape the front end emits for `for i in N { ... }`:
//     movq $K,I            (the counter's start)
//   .LH:
//     movq E,%rcx ; movq I,%rax ; cmpq %rcx,%rax ; jae .LX
//     body
//   .LS:
//     incq I ; jmp .LH
//   .LX:
// The body must be straight-line: its only branches skip a single `call rt_abort`, it makes only
// the calls rg_fill_call_ok allows, it never writes I, E or a pushed vector's slot, and .LX is
// reached from nowhere but the guard. Then every iteration that reaches the latch executed each
// `call rt_push*` exactly once, on the vector its `movq S,%rdi` named.
fn rg_fill_loops(rc: (&mut RC), instrs: (&u8[][])) -> unit {
    n := instrs.len();
    for i in n {
        rc.fill_at.push(0);
    }
    mut j = 0;
    while j + 2 < n {
        latch := view(instrs[j]);
        if !(starts(latch, view("incq ")) && starts(view(instrs[j + 1]), view("jmp .L")) && rg_ends_colon(view(instrs[j + 2]))) {
            j += 1;
            continue;
        }
        counter := view(sub(latch, 5, latch.len()));
        head_name := view(sub(view(instrs[j + 1]), 4, instrs[j + 1].len()));
        exit_line := view(instrs[j + 2]);
        exit_name := view(sub(exit_line, 0, exit_line.len() - 1));
        // The head label, the guard, and the counter's start right before it.
        mut h = n;
        for q in j {
            if (instrs[q].len() == head_name.len() + 1) && starts(view(instrs[q]), head_name) && rg_ends_colon(view(instrs[q])) {
                h = q;
            }
        }
        mut ok = rg_frame_op(counter) && (h != n) && (h >= 1) && (h + 4 < j);
        mut bound = u8[];
        mut start: u64 = 0;
        if ok {
            g1 := view(instrs[h + 1]);
            ok = starts(g1, view("movq ")) && ends(g1, view(",%rcx"));
            if ok {
                bound = copy(view(sub(g1, 5, g1.len() - 5)));
                ok = rg_frame_op(view(bound));
            }
            mut want = copy(view("movq "));
            for q in counter.len() {
                want.push(counter[q]);
            }
            for q in 5 {
                want.push(view(",%rax")[q]);
            }
            ok = ok && eq(view(instrs[h + 2]), view(want)) && eq(view(instrs[h + 3]), view("cmpq %rcx,%rax"));
            mut jae = copy(view("jae "));
            for q in exit_name.len() {
                jae.push(exit_name[q]);
            }
            ok = ok && eq(view(instrs[h + 4]), view(jae));
            // The counter's start: `movq $K,I`, or `K` into %rax and then `movq %rax,I`.
            pre := view(instrs[h - 1]);
            mut want_store = copy(view("movq %rax,"));
            for q in counter.len() {
                want_store.push(counter[q]);
            }
            if ok && starts(pre, view("movq $")) && ends(pre, view(counter)) {
                k := parse_int(view(sub(pre, 6, pre.len() - counter.len() - 1)));
                ok = (k.ok != 0) && (k.v >= 0);
                if ok {
                    start = u64(k.v);
                }
            } else if ok && eq(pre, view(want_store)) && (h >= 2) {
                pre2 := view(instrs[h - 2]);
                if eq(pre2, view("xorq %rax,%rax")) || eq(pre2, view("xorl %eax,%eax")) {
                    start = 0;
                } else if (starts(pre2, view("movq $")) || starts(pre2, view("movabsq $"))) && ends(pre2, view(",%rax")) {
                    mut d = 6;
                    if starts(pre2, view("movabsq $")) {
                        d = 9;
                    }
                    k := parse_int(view(sub(pre2, d, pre2.len() - 5)));
                    ok = (k.ok != 0) && (k.v >= 0);
                    if ok {
                        start = u64(k.v);
                    }
                } else {
                    ok = false;
                }
            } else {
                ok = false;
            }
        }
        // The exit is reached only from the guard.
        if ok {
            mut spaced = copy(view(" "));
            for q in exit_name.len() {
                spaced.push(exit_name[q]);
            }
            mut uses = 0;
            for q in n {
                line := view(instrs[q]);
                if ends(line, view(spaced)) {
                    uses += 1;
                }
            }
            ok = uses == 1;
        }
        // The body.
        mut slots = u8[][];
        mut counts = u64[];
        mut q = h + 5;
        mut rdi = u8[];
        while ok && (q < j) {
            line := view(instrs[q]);
            if starts(line, view(".pushsection")) {
                while (q < j) && !starts(view(instrs[q]), view(".popsection")) {
                    q += 1;
                }
                q += 1;
                continue;
            }
            if rg_ends_colon(line) {
                // A label: the target of the abort skip just before it, or the `continue` label.
                mut fine = q == j - 1;
                if (q >= 2) && eq(view(instrs[q - 1]), view("call rt_abort")) {
                    prev := view(instrs[q - 2]);
                    name := view(sub(line, 0, line.len() - 1));
                    fine = fine || (starts(prev, view("j")) && rg_names_label(prev, name));
                }
                ok = fine;
                q += 1;
                continue;
            }
            if starts(line, view("jmp")) {
                ok = false;
                continue;
            }
            if starts(line, view("j")) {
                // Must skip exactly one `call rt_abort` to the label right after it.
                ok = (q + 2 < j) && eq(view(instrs[q + 1]), view("call rt_abort")) && rg_ends_colon(view(instrs[q + 2]))
                    && rg_names_label(line, view(sub(view(instrs[q + 2]), 0, instrs[q + 2].len() - 1)));
                q += 1;
                continue;
            }
            mut space = line.len();
            for t in line.len() {
                if (line[t] == 32) & (space == line.len()) {
                    space = t;
                }
            }
            op := view(sub(line, 0, space));
            o := operands(view(trim(view(sub(line, space + 1, line.len())))));
            if eq(op, view("call")) {
                target := view(o[0]);
                ok = (o.len() == 1) && rg_fill_call_ok(target);
                if ok && starts(target, view("rt_push")) {
                    // A push onto a vector held anywhere else than a frame slot whose address never
                    // escapes is not summarised (it is still only a push: nothing else changes).
                    sid := rg_storage(view(rdi));
                    summarise := rg_frame_op(view(rdi)) && (sid >= 15) && (sid - 15 < rc.esc.len()) && (rc.esc[sid - 15] == 0);
                    if summarise {
                        mut found = slots.len();
                        for t in slots.len() {
                            if eq(view(slots[t]), view(rdi)) {
                                found = t;
                            }
                        }
                        if found == slots.len() {
                            slots.push(rdi.copy());
                            counts.push(0);
                        }
                        counts[found] = counts[found] + 1;
                    }
                }
                rdi = u8[];
                q += 1;
                continue;
            }
            if eq(op, view("leaq")) && (o.len() >= 1) && (rg_frame_op(view(o[0])) && (eq(view(o[0]), counter) || eq(view(o[0]), view(bound)))) {
                ok = false;
            }
            if o.len() >= 1 {
                last := view(o[o.len() - 1]);
                if eq(last, counter) || eq(last, view(bound)) {
                    ok = false;
                }
                if eq(op, view("movq")) && (o.len() == 2) && eq(last, view("%rdi")) {
                    rdi = copy(view(o[0]));
                } else if eq(last, view("%rdi")) || eq(last, view("%edi")) {
                    rdi = u8[];
                }
            }
            q += 1;
        }
        // No pushed vector's slot is written in the body.
        if ok {
            for t in slots.len() {
                for r in h + 5..j {
                    line := view(instrs[r]);
                    o := operands(view(trim(view(sub(line, 5, line.len())))));
                    if starts(line, view("movq ")) && (o.len() == 2) && eq(view(o[1]), view(slots[t])) {
                        ok = false;
                    }
                }
            }
        }
        if ok && (slots.len() != 0) {
            for t in slots.len() {
                next := rc.fill_at[j + 2];
                rc.fill_slot.push(slots[t].copy());
                rc.fill_pushes.push(counts[t]);
                rc.fill_bound.push(bound.copy());
                rc.fill_start.push(start);
                rc.fill_next.push(next);
                rc.fill_at[j + 2] = rc.fill_slot.len();
            }
        }
        j += 1;
    }
    return ();
}
// The two states a conditional jump hands its successors: each edge is refined with the relation
// the branch tests, on both operands. A branch is never *decided*: the state a block is entered with
// is the join over every path that reaches it, so a comparison that holds there holds on every
// arrival -- including a loop's last, which is why deciding a guard from it would be wrong.
// The outcome of a conditional jump decided inside its own block: `cmpq $C, X` where X was last
// written in this block by `movq $K, X`, with nothing in between that could write X (no call, no
// other write to X, no store through a register). Returns 1 when the jump is taken, 2 when it is
// not, 0 when undecided. Only the block's own straight-line code is used - never the state the block
// is entered with, which joins a loop's iterations and would decide a guard from one of them.
fn rg_local_branch(instrs: (&u8[][]), start: u64, stop: u64, rel: u64) -> u64 {
    if (rel == 0) || (stop - start < 3) {
        return 0;
    }
    cmp := view(instrs[stop - 2]);
    if !starts(cmp, view("cmpq $")) {
        return 0;
    }
    o := operands(view(sub(cmp, 5, cmp.len())));
    if o.len() != 2 {
        return 0;
    }
    c := rg_imm(view(o[0]));
    if c.ok != 1 {
        return 0;
    }
    x := view(o[1]);
    mut i = stop - 2;
    while i > start {
        i -= 1;
        line := view(instrs[i]);
        if starts(line, view("call")) || starts(line, view("rep ")) {
            return 0;
        }
        lo := operands(view(sub(line, 5, line.len())));
        if lo.len() == 0 {
            continue;
        }
        dst := view(lo[lo.len() - 1]);
        if eq(dst, x) {
            if starts(line, view("movq $")) & (lo.len() == 2) {
                k := rg_imm(view(lo[0]));
                if k.ok != 1 {
                    return 0;
                }
                a := k.lo;
                b := c.lo;
                mut holds = false;
                if rel == 1 { holds = a < b; }
                if rel == 2 { holds = a <= b; }
                if rel == 3 { holds = a >= b; }
                if rel == 4 { holds = a > b; }
                if rel == 5 { holds = a == b; }
                if rel == 6 { holds = a != b; }
                if holds {
                    return 1;
                }
                return 2;
            }
            return 0;
        }
        // A store through a register may reach X if its address escaped.
        if (dst.len() != 0) && (dst[dst.len() - 1] == 41) && !ends(dst, view("(%rbp)")) && !starts(line, view("cmp")) && !starts(line, view("test")) {
            return 0;
        }
    }
    return 0;
}
fn rg_edges(rc: (&RC), st: (&mut u64[][]), nblk: u64, s1: u64, s2: u64, instrs: (&u8[][]), start: u64, stop: u64, cur: (&u64[]), out: (&mut u64[]), pcmp: (&u64[]), snap: (&u64[]), widen: u64, thr: (&u64[]), from: u64) -> u64 {
    if s2 == rg_none() {
        if s1 != rg_none() {
            if rg_into(&rc, &mut st, nblk, s1, &cur, widen & u64(s1 <= from), &thr) != 0 {
                return 1;
            }
        }
        return 0;
    }
    last := view(instrs[stop - 1]);
    rel := rg_jump_rel(view(rg_op(last)));
    // A branch on a value this block itself just set (a drop flag cleared before a guarded drop)
    // goes one way only: the other edge carries no state, so its block stays unreachable.
    decided := rg_local_branch(&instrs, start, stop, rel);
    if decided == 1 {
        if rg_into(&rc, &mut st, nblk, s1, &cur, widen & u64(s1 <= from), &thr) != 0 {
            return 1;
        }
        return 0;
    }
    if decided == 2 {
        if rg_into(&rc, &mut st, nblk, s2, &cur, widen & u64(s2 <= from), &thr) != 0 {
            return 2;
        }
        return 0;
    }
    mut taken = cur.copy();
    mut fall = cur.copy();
    if (rel != 0) & (stop - start >= 2) {
        cmp := view(instrs[stop - 2]);
        if starts(cmp, view("cmpq ")) {
            o := operands(view(sub(cmp, 5, cmp.len())));
            if o.len() == 2 {
                rg_relate(&rc, &mut taken, view(o[0]), view(o[1]), rel, &pcmp, &instrs, stop, &snap);
                rg_relate(&rc, &mut fall, view(o[0]), view(o[1]), rg_inverse(rel), &pcmp, &instrs, stop, &snap);
            }
        }
        if starts(cmp, view("testq ")) {
            // `testq %rax,%rax` on a comparison the front end materialised as a 0/1 word: the jump
            // is the comparison itself, so its two edges bound the comparison's own operands.
            o := operands(view(sub(cmp, 6, cmp.len())));
            if o.len() == 2 {
                loc := rg_loc(&rc, view(o[0]));
                if (loc != rg_none()) & (rg_k(&cur, loc) == 5) {
                    t := rg_lo(&cur, loc);
                    prel := rg_hi(&cur, loc);
                    neg := rg_sym(&cur, loc);
                    if t < instrs.len() {
                        co := operands(view(sub(view(instrs[t]), 5, instrs[t].len())));
                        if co.len() == 2 {
                            // `holds` 1 when the taken edge means `a prel b` is true.
                            mut holds: u64 = 0;
                            if rel == 5 {
                                if neg != 0 {
                                    holds = 1;
                                }
                            } else {
                                if neg == 0 {
                                    holds = 1;
                                }
                            }
                            if holds != 0 {
                                rg_relate(&rc, &mut taken, view(co[0]), view(co[1]), prel, &pcmp, &instrs, stop, &snap);
                                rg_relate(&rc, &mut fall, view(co[0]), view(co[1]), rg_inverse(prel), &pcmp, &instrs, stop, &snap);
                            } else {
                                rg_relate(&rc, &mut fall, view(co[0]), view(co[1]), prel, &pcmp, &instrs, stop, &snap);
                                rg_relate(&rc, &mut taken, view(co[0]), view(co[1]), rg_inverse(prel), &pcmp, &instrs, stop, &snap);
                            }
                        }
                    }
                }
            }
        }
    }
    // 1 when the target changed, 2 when the fall-through did, 3 for both.
    mut changed = 0;
    if rg_into(&rc, &mut st, nblk, s2, &fall, widen & u64(s2 <= from), &thr) != 0 {
        changed = 2;
    }
    if rg_into(&rc, &mut st, nblk, s1, &taken, widen & u64(s1 <= from), &thr) != 0 {
        changed = changed | 1;
    }
    return changed;
}
// True unless the address `leaq` on line `at` puts in `dest` provably reaches only
// shared-reference parameters: it is followed through register and frame-temporary copies to the
// next call, where every argument register still holding it must be a parameter the callee
// declares `&T`, no callee-saved register may hold it, and no temporary holding it is read
// anywhere else in the function. A label, a jump, a store through it, or any other use is an
// escape (the conservative answer).
fn rg_mut_escape(instrs: (&u8[][]), at: u64, dest: (&[u8]), names: (&u8[][]), masks: (&u64[])) -> bool {
    mut holders = u8[][];
    holders.push(copy(dest));
    mut j = at + 1;
    while j < instrs.len() {
        line := view(instrs[j]);
        if (line.len() == 0) || (line[line.len() - 1] == 58) || starts(line, view("j")) || starts(line, view("ret")) {
            return true;
        }
        mut space = line.len();
        for q in line.len() {
            if (line[q] == 32) & (space == line.len()) {
                space = q;
            }
        }
        op := view(sub(line, 0, space));
        o := operands(view(trim(view(sub(line, space + 1, line.len())))));
        if eq(op, view("call")) {
            mut mask: u64 = 0;
            if o.len() == 1 {
                for q in names.len() {
                    if eq(view(names[q]), view(o[0])) {
                        mask = masks[q];
                    }
                }
            }
            for h in holders.len() {
                hv := view(holders[h]);
                r := rg_arg_index(hv);
                if r != 99 {
                    if ((mask >> r) & 1) == 0 {
                        return true;
                    }
                } else if starts(hv, view("%")) {
                    if eq(hv, view("%rbx")) || eq(hv, view("%r12")) || eq(hv, view("%r13")) || eq(hv, view("%r14")) || eq(hv, view("%r15")) {
                        return true;
                    }
                } else {
                    // A frame temporary: dead once nothing else in the function reads it.
                    for q in instrs.len() {
                        if ((q < at) || (q > j)) && rg_mentions(view(instrs[q]), hv) {
                            return true;
                        }
                    }
                }
            }
            return false;
        }
        mut touches = false;
        for q in o.len() {
            for h in holders.len() {
                if rg_mentions(view(o[q]), view(holders[h])) {
                    touches = true;
                }
            }
        }
        if eq(op, view("movq")) && (o.len() == 2) {
            mut from_holder = false;
            for h in holders.len() {
                if eq(view(o[0]), view(holders[h])) {
                    from_holder = true;
                }
            }
            if from_holder {
                dst := view(o[1]);
                if starts(dst, view("%")) || (starts(dst, view("-")) && rg_mentions(dst, view("(%rbp)"))) {
                    holders.push(copy(dst));
                    j += 1;
                    continue;
                }
                return true;
            }
            // A load through a holder (`movq (%rax),%rdi`, `movq 8(%rax),%rdi`) reads the slot: it
            // cannot change it, and the value loaded is the slot's contents, not its address.
            src := view(o[0]);
            mut through = false;
            for h in holders.len() {
                hv := view(holders[h]);
                if starts(hv, view("%")) && rg_mentions(src, hv) && rg_mentions(src, view("(")) && !rg_mentions(view(o[1]), hv) {
                    through = true;
                }
                if starts(hv, view("%")) && eq(view(o[1]), hv) && rg_mentions(src, view("(")) && rg_mentions(src, hv) {
                    through = true;
                }
            }
            if through && !rg_mentions(src, view("(%rbp)")) {
                mut kept2 = u8[][];
                for h in holders.len() {
                    if !eq(view(o[1]), view(holders[h])) {
                        kept2.push(holders[h].copy());
                    }
                }
                holders = kept2;
                j += 1;
                continue;
            }
            // Overwriting a holder ends it; reading through one is a use.
            mut kept = u8[][];
            for h in holders.len() {
                if !eq(view(o[1]), view(holders[h])) {
                    kept.push(holders[h].copy());
                }
            }
            if rg_mentions_any(view(o[0]), &holders) {
                return true;
            }
            holders = kept;
            j += 1;
            continue;
        }
        if touches && (o.len() >= 1) {
            // An instruction that only writes a holder (a new address, a constant, a load into it)
            // retires it; any other mention of a holder is a use.
            last := view(o[o.len() - 1]);
            pure_write := eq(op, view("leaq")) || eq(op, view("movabsq")) || eq(op, view("movl")) || eq(op, view("movzbq"))
                || eq(op, view("movzwq")) || eq(op, view("popq")) || starts(op, view("set"));
            mut reads_holder = false;
            for q in o.len() - 1 {
                if rg_mentions_any(view(o[q]), &holders) {
                    reads_holder = true;
                }
            }
            mut writes_holder = false;
            for h in holders.len() {
                if eq(last, view(holders[h])) {
                    writes_holder = true;
                }
            }
            if pure_write & writes_holder & !reads_holder {
                mut kept = u8[][];
                for h in holders.len() {
                    if !eq(last, view(holders[h])) {
                        kept.push(holders[h].copy());
                    }
                }
                holders = kept;
                j += 1;
                continue;
            }
            return true;
        }
        j += 1;
    }
    return true;
}
fn rg_arg_index(r: (&[u8])) -> u64 {
    if eq(r, view("%rdi")) {
        return 0;
    }
    if eq(r, view("%rsi")) {
        return 1;
    }
    if eq(r, view("%rdx")) {
        return 2;
    }
    if eq(r, view("%rcx")) {
        return 3;
    }
    if eq(r, view("%r8")) {
        return 4;
    }
    if eq(r, view("%r9")) {
        return 5;
    }
    return 99;
}
// True when `text` contains `part`.
fn rg_mentions(text: (&[u8]), part: (&[u8])) -> bool {
    if part.len() == 0 {
        return false;
    }
    mut i = 0;
    while i + part.len() <= text.len() {
        mut hit = true;
        for q in part.len() {
            if text[i + q] != part[q] {
                hit = false;
                break;
            }
        }
        if hit {
            return true;
        }
        i += 1;
    }
    return false;
}
fn rg_mentions_any(text: (&[u8]), parts: (&u8[][])) -> bool {
    for q in parts.len() {
        if rg_mentions(text, view(parts[q])) {
            return true;
        }
    }
    return false;
}
// One verdict per instruction line: 0 nothing, 1 the conditional jump on this line always takes its
// target, 2 it never does, 3 the bounds-checked accessor call on this line cannot fail.
fn range_proofs(instrs: (&u8[][]), nslots: u64, split: u64, shared_names: (&u8[][]), shared_masks: (&u64[])) -> u64[] {
    n := instrs.len();
    mut out = u64[];
    for i in n {
        out.push(0);
    }
    if n == 0 {
        return out;
    }
    // Nothing to prove in a function that reads no sequence, and nothing to prove in one that only
    // borrows one: a range fact needs a header identity, and every location is untyped at entry, so
    // the identity has to be created here (`rt_new`, `rt_vec_copy`, a constant fill).
    mut reads = 0;
    mut creates = 0;
    for i in n {
        line := view(instrs[i]);
        if starts(line, view("cmpq 8(%")) {
            reads = 1;
        }
        if starts(line, view("call rt_slot")) || starts(line, view("call rt_at")) {
            reads = 1;
        }
        if eq(line, view("call rt_new")) || eq(line, view("call rt_vec_copy")) || starts(line, view("call rt_fill")) {
            creates = 1;
        }
    }
    if (reads == 0) || (creates == 0) {
        return out;
    }
    mut rc = rc_new(nslots, split);
    // One identity per `rt_new`/`rt_vec_copy` call, in stream order, so a fact established by one
    // walk of the stream is the same identity in every later walk.
    mut nid: u64 = 0;
    for i in n {
        line := view(instrs[i]);
        mut s: u64 = 0;
        if eq(line, view("call rt_new")) || eq(line, view("call rt_vec_copy")) {
            nid += 1;
            s = nid;
        }
        rc.seed.push(s);
    }
    rc.nid = nid + 2;
    for i in n {
        line := view(instrs[i]);
        if starts(line, view("leaq ")) {
            o := operands(view(sub(line, 5, line.len())));
            if o.len() == 2 {
                id := rg_storage(view(o[0]));
                if id >= 15 {
                    if id - 15 < nslots {
                        rc.esc[id - 15] = 1;
                        if rg_mut_escape(&instrs, i, view(o[1]), &shared_names, &shared_masks) {
                            rc.mesc[id - 15] = 1;
                        }
                    }
                }
            }
        }
    }
    // Blocks: a label line starts one, and the block before it ends there.
    mut bstart = u64[];
    mut bstop = u64[];
    mut bname = u8[][];
    mut bof = u64[];
    mut cur: u64 = 0;
    bstart.push(0);
    bname.push(u8[]);
    for i in n {
        line := view(instrs[i]);
        name := label_of(line);
        if (name.len() != 0) & (name.len() + 1 == line.len()) {
            if i != bstart[cur] {
                bstop.push(i);
                bstart.push(i);
                bname.push(name);
                cur += 1;
            } else {
                bname[cur] = name;
            }
        }
        // A block also ends after a jump or a return: the lines that follow are reached only along
        // the other edge, which is where the front end's `jb` past a cold `rt_abort` puts them.
        if rg_ends_block(line) != 0 {
            if i + 1 < n {
                bstop.push(i + 1);
                bstart.push(i + 1);
                bname.push(u8[]);
                cur += 1;
            }
        }
        bof.push(cur);
    }
    bstop.push(n);
    nblk := bstart.len();
    // Successors from the last line of the block: `jmp` names one, a conditional jump names the
    // target and falls through, `retq` and the non-returning `rt_abort` name none.
    mut s1 = u64[];
    mut s2 = u64[];
    for b in nblk {
        st := bstart[b];
        en := bstop[b];
        mut t1 = rg_none();
        mut t2 = rg_none();
        if en == st {
            if b + 1 < nblk {
                t1 = b + 1;
            }
        } else {
            last := view(instrs[en - 1]);
            mut done = 0;
            if eq(last, view("retq")) || eq(last, view("call rt_abort")) || eq(last, view("leave")) {
                done = 1;
            }
            if done == 0 {
                if starts(last, view("jmp")) {
                    t1 = rg_target(&bname, last);
                } else {
                    if (last.len() > 1) & (last[0] == 106) & (last[1] != 109) {
                        t1 = rg_target(&bname, last);
                        if b + 1 < nblk {
                            t2 = b + 1;
                        }
                    } else {
                        if b + 1 < nblk {
                            t1 = b + 1;
                        }
                    }
                }
            }
        }
        s1.push(t1);
        s2.push(t2);
    }
    // Counted fill loops, now that the escaped slots are known.
    rg_fill_loops(&mut rc, &instrs);
    // Per line: how many times one execution of the enclosing counted fill loop grows a length.
    mut trip = u64[];
    for i in n {
        trip.push(1);
    }
    // The states, block by block: the first path that reaches a block types it, every later one
    // joins into it. Blocks are in stream order, so a forward pass reaches every forward edge once.
    mut stx = u64[][];
    mut dirty = u64[];
    for b in nblk {
        stx.push(u64[]);
        dirty.push(1);
    }
    stx[0] = rc_state(&rc);
    // The scratch a block walk reuses: the copy provenance of each location, that map as the last
    // comparison saw it, and the comparison's record.
    mut prov = u64[];
    mut snap = u64[];
    for q in 2 * rc.nloc {
        prov.push(0);
        snap.push(0);
    }
    mut pcmp2 = u64[];
    for q in 5 {
        pcmp2.push(0);
    }
    mut rounds: u64 = 0;
    mut changed: u64 = 1;
    mut widen: u64 = 0;
    // Widening thresholds: every non-negative immediate in the function (`movabsq $c` / `movq $c`
    // load a guard's bound into the register it is compared through; `cmpq $c` compares directly).
    mut thr = u64[];
    for q in n {
        line := view(instrs[q]);
        mut k: u64 = 0;
        while (k < line.len()) && (line[k] != 36) {
            k += 1;
        }
        if (k < line.len()) && (starts(line, view("mov")) || starts(line, view("cmpq"))) {
            k += 1;
            mut v: u64 = 0;
            mut digits: u64 = 0;
            while (k < line.len()) && (line[k] >= 48) && (line[k] <= 57) && (digits < 18) {
                v = v * 10 + u64(line[k] - 48);
                digits += 1;
                k += 1;
            }
            if (digits != 0) && (k < line.len()) && (line[k] == 44) {
                thr.push(v);
            }
        }
    }
    // A worklist: only the blocks a join changed are walked again, so the cost is one pass over
    // the function plus the blocks a loop actually re-enters.
    while (changed != 0) & (rounds < 24) {
        changed = 0;
        rounds += 1;
        if rounds > 3 {
            widen = 1;
        }
        for b in nblk {
            if (dirty[b] == 0) || (stx[b].len() == 0) {
                continue;
            }
            dirty[b] = 0;
            for q in prov.len() {
                prov[q] = 0;
                snap[q] = 0;
            }
            for q in 5 {
                pcmp2[q] = 0;
            }
            mut cur2 = stx[b].copy();
            rg_run(&rc, &mut cur2, &instrs, bstart[b], bstop[b], &trip, &mut out, 1, &mut prov, &mut pcmp2, &mut snap);
            mask := rg_edges(&rc, &mut stx, nblk, s1[b], s2[b], &instrs, bstart[b], bstop[b], &cur2, &mut out, &pcmp2, &snap, widen, &thr, b);
            if (mask & 1) != 0 {
                if s1[b] != rg_none() {
                    dirty[s1[b]] = 1;
                }
                changed = 1;
            }
            if (mask & 2) != 0 {
                if (s2[b] != rg_none()) & (s2[b] < nblk) {
                    dirty[s2[b]] = 1;
                }
                changed = 1;
            }
        }
    }
    // A fixpoint stopped by the round cap is not a fixpoint. Widening makes every loop converge
    // well inside the cap, so this is a backstop: without it a counter's interval grew one step
    // per round, and a state taken after 24 rounds of a 100-trip loop held the counter in about
    // [0, 23] -- below a length the loop does exceed. Nothing is decided then: every access keeps
    // the check it was emitted with.
    if changed != 0 {
        for q in n {
            out[q] = 0;
        }
        return out;
    }
    // The verdicts are read off the fixpoint and nowhere else. A branch decided from a state that
    // still had a backedge left to join could decide a loop's exit the wrong way round -- the
    // counter is in range on every iteration but the last -- so the walk that records them runs
    // once more, over every reachable block, when nothing is left to change. At the fixpoint the
    // joins it performs again change nothing.
    for b in nblk {
        if stx[b].len() == 0 {
            continue;
        }
        for q in prov.len() {
            prov[q] = 0;
            snap[q] = 0;
        }
        for q in 5 {
            pcmp2[q] = 0;
        }
        mut cur3 = stx[b].copy();
        rg_run(&rc, &mut cur3, &instrs, bstart[b], bstop[b], &trip, &mut out, 1, &mut prov, &mut pcmp2, &mut snap);
        rg_edges(&rc, &mut stx, nblk, s1[b], s2[b], &instrs, bstart[b], bstop[b], &cur3, &mut out, &pcmp2, &snap, widen, &thr, b);
    }
    return out;
}

// ---- the module ----

fn header<a>(out: (&a mut u8[])) -> unit {
    put(&mut out, view("attributes #0 = { noreturn cold nounwind }\n"));
    put(&mut out, view("attributes #1 = { nounwind \"no-builtins\" }\n"));
    put(&mut out, view("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n"));
    put(&mut out, view("declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)\n"));
    put(&mut out, view("declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)\n"));
    put(&mut out, view("declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)\n"));
    put(&mut out, view("declare double @llvm.sqrt.f64(double)\n"));
    put(&mut out, view("define internal void @\"rt_abort.cold\"() noreturn cold noinline nounwind {\n  call {i64, i64} @\"rt_abort\"(i64 0, i64 0, i64 0, i64 0, i64 0, i64 0)\n  unreachable\n}\n"));
    // LLVM may turn copy and fill loops into these calls; Grail programs have no libc.
    put(&mut out, view("define ptr @memset(ptr %d, i32 %c, i64 %n) #1 {\nentry:\n  %b = trunc i32 %c to i8\n  br label %loop\nloop:\n  %i = phi i64 [0, %entry], [%i1, %body]\n  %done = icmp eq i64 %i, %n\n  br i1 %done, label %exit, label %body\nbody:\n  %p = getelementptr i8, ptr %d, i64 %i\n  store i8 %b, ptr %p\n  %i1 = add i64 %i, 1\n  br label %loop\nexit:\n  ret ptr %d\n}\n"));
    put(&mut out, view("define ptr @memcpy(ptr %d, ptr %s, i64 %n) #1 {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [0, %entry], [%i1, %body]\n  %done = icmp eq i64 %i, %n\n  br i1 %done, label %exit, label %body\nbody:\n  %q = getelementptr i8, ptr %s, i64 %i\n  %v = load i8, ptr %q\n  %p = getelementptr i8, ptr %d, i64 %i\n  store i8 %v, ptr %p\n  %i1 = add i64 %i, 1\n  br label %loop\nexit:\n  ret ptr %d\n}\n"));
    put(&mut out, view("define ptr @memmove(ptr %d, ptr %s, i64 %n) #1 {\nentry:\n  %fwd = icmp ult ptr %d, %s\n  br i1 %fwd, label %f, label %b\nf:\n  %i = phi i64 [0, %entry], [%i1, %fb]\n  %fdone = icmp eq i64 %i, %n\n  br i1 %fdone, label %exit, label %fb\nfb:\n  %fq = getelementptr i8, ptr %s, i64 %i\n  %fv = load i8, ptr %fq\n  %fp = getelementptr i8, ptr %d, i64 %i\n  store i8 %fv, ptr %fp\n  %i1 = add i64 %i, 1\n  br label %f\nb:\n  %j = phi i64 [%n, %entry], [%j1, %bb]\n  %bdone = icmp eq i64 %j, 0\n  br i1 %bdone, label %exit, label %bb\nbb:\n  %j1 = sub i64 %j, 1\n  %bq = getelementptr i8, ptr %s, i64 %j1\n  %bv = load i8, ptr %bq\n  %bp = getelementptr i8, ptr %d, i64 %j1\n  store i8 %bv, ptr %bp\n  br label %b\nexit:\n  ret ptr %d\n}\n"));
    return ();
}
fn pool_name<a>(label: &a [u8]) -> u8[] {
    mut out = copy(view("grail.pool."));
    put(&mut out, view(sub(label, 2, label.len())));
    return out;
}
// Lowers a raw x86-64-spelled stream (target triple `triple`).
fn target_triple(target: u64) -> u8[] {
    if target == 1 {
        return copy(view("aarch64-unknown-linux-gnu"));
    }
    if target == 2 {
        return copy(view("riscv64-unknown-linux-gnu"));
    }
    return copy(view("x86_64-unknown-linux-gnu"));
}
// On AArch64 and RISC-V the word machine returns rax:rdx in x9:x2 (t0:a2), while LLVM's C
// convention returns in x0:x1 (a0:a1); arguments already agree (x0..x5 / a0..a5). IR functions
// are therefore defined as NAME.ll, native code reaches them through a thunk named NAME, and IR
// reaches native functions through NAME.c.
fn thunk_into_ir<a>(out: (&a mut u8[]), name: &a [u8], target: u64) -> unit {
    put(&mut out, view(".text\n.globl "));
    put(&mut out, name);
    put(&mut out, view("\n.hidden "));
    put(&mut out, name);
    out.push(10);
    put(&mut out, name);
    put(&mut out, view(":\n"));
    if target == 1 {
        put(&mut out, view("stp x29,x30,[sp,#-16]!\nmov x29,sp\nbl "));
        put(&mut out, name);
        put(&mut out, view(".ll\nmov x9,x0\nmov x2,x1\nldp x29,x30,[sp],#16\nret\n"));
    } else {
        put(&mut out, view("addi sp,sp,-16\nsd ra,8(sp)\nsd s0,0(sp)\naddi s0,sp,16\ncall "));
        put(&mut out, name);
        put(&mut out, view(".ll\nmv t0,a0\nmv a2,a1\nld ra,8(sp)\nld s0,0(sp)\naddi sp,sp,16\nret\n"));
    }
    return ();
}
fn thunk_from_ir<a>(out: (&a mut u8[]), name: &a [u8], target: u64) -> unit {
    put(&mut out, view(".text\n.globl "));
    put(&mut out, name);
    put(&mut out, view(".c\n.hidden "));
    put(&mut out, name);
    put(&mut out, view(".c\n"));
    put(&mut out, name);
    put(&mut out, view(".c:\n"));
    if target == 1 {
        put(&mut out, view("stp x29,x30,[sp,#-16]!\nmov x29,sp\nbl "));
        put(&mut out, name);
        put(&mut out, view("\nmov x0,x9\nmov x1,x2\nldp x29,x30,[sp],#16\nret\n"));
    } else {
        put(&mut out, view("addi sp,sp,-16\nsd ra,8(sp)\nsd s0,0(sp)\naddi s0,sp,16\ncall "));
        put(&mut out, name);
        put(&mut out, view("\nmv a0,t0\nmv a1,a2\nld ra,8(sp)\nld s0,0(sp)\naddi sp,sp,16\nret\n"));
    }
    return ();
}
// `line` with each `@"NAME"(` call or definition renamed to NAME.ll (lifted) or NAME.c (native).
fn rename_calls<a, b>(line: &a [u8], lifted: (&b Set)) -> u8[] {
    if !has(line, view("@\"")) {
        return copy(line);
    }
    mut out = u8[];
    mut i: u64 = 0;
    while i < line.len() {
        if (line[i] == 64) && (i + 1 < line.len()) && (line[i + 1] == 34) {
            mut e = i + 2;
            while (e < line.len()) && (line[e] != 34) {
                e += 1;
            }
            if (e + 1 < line.len()) && (line[e + 1] == 40) {
                name := sub(line, i + 2, e);
                put(&mut out, view("@\""));
                put(&mut out, view(name));
                if !eq(view(name), view("rt_abort.cold")) && !starts(view(name), view("llvm.")) {
                    if set_has(&lifted, view(name)) {
                        put(&mut out, view(".ll"));
                    } else {
                        put(&mut out, view(".c"));
                    }
                }
                out.push(34);
                i = e + 1;
                continue;
            }
        }
        out.push(line[i]);
        i += 1;
    }
    return out;
}
pub fn lower_for<a, b>(stream: &a [u8], target: u64, facts: (&b Facts), verify: u64, ranges: u64) -> Lowered {
    triple := target_triple(target);
    return lower_target(stream, view(triple), target, facts, verify, ranges);
}
pub fn lower<a, b, c>(stream: &a [u8], triple: &b [u8], facts: (&c Facts), verify: u64, ranges: u64) -> Lowered {
    return lower_target(stream, triple, 0, facts, verify, ranges);
}
fn lower_target<a, b, c>(stream: &a [u8], triple: &b [u8], target: u64, facts: (&c Facts), verify: u64, ranges: u64) -> Lowered {
    lines := split_lines(stream);
    // Names the stream declared `.weak` (content-addressed drop helpers, which two objects may
    // both define). A function kept native is re-declared below; it must keep weak binding, not
    // gain `.globl`, or the assembler rejects the module (`changed binding to STB_GLOBAL`).
    // `Set` is a fixed-size open-addressed table with no growth, so it must be sized for every
    // name it will hold: count the `.weak` lines first (a full table probes forever).
    mut nweak = 0;
    for i in lines.len() {
        if starts(view(lines[i]), view(".weak ")) {
            nweak += 1;
        }
    }
    mut weak = set_new(nweak + 1);
    for i in lines.len() {
        wl := view(lines[i]);
        if starts(wl, view(".weak ")) {
            set_add(&mut weak, view(sub(wl, 6, wl.len())));
        }
    }
    mut l = L { target: target, ir: u8[], body: u8[], fail: 0, t: 0, dead: 0, term: 0, labels: set_new(16), calls: u8[][], addrs: u8[][], split: 0, refs: u8[][], lifted: u8[][], flags: 0, frame: 0, fslots: u64[], fops: u64[], fordinal: 0, verify: verify, hslots: u64[], hwhat: u64[], hwidth: u64[], eon: u64[], edata: u8[][], elen: u8[][], vk: u64[], vo: u64[], vo2: i64[], hcall: u64[], hcallwhat: u64[], cnames: u8[][], ccount: u64[], sibwhat: 0, sibwidth: 0, sd: u8[], sl: u8[], fname: u8[], sibnames: u8[][], sibbodies: u8[][], eblk: u64[], blk: 0, dnames: u8[][], proof: u64[], rline: 0, ranges: ranges };
    mut funcs = Func[];
    mut data = u8[][];
    split(&lines, &mut funcs, &mut data);
    // Labels named from data (jump tables) keep the functions that define them native.
    mut data_tokens = set_new(data.len() * 4 + 64);
    for i in data.len() {
        add_tokens(&mut data_tokens, view(data[i]));
    }
    // F1: build the typed siblings the fact-carrying call sites target. A sibling is the callee's
    // own word-machine body emitted with argument 0 as a `ptr` carrying `dereferenceable(24)
    // align 8` and with `data`/`len` passed in, so the two header loads are not in the body at all
    // and a call site reads them once, where the fact is established (docs/design/typed-ir.md).
    // A fact whose sibling cannot be built is simply not used, which is always correct.
    mut sibwidths = u64[];
    for i in facts.items.len() {
        f := &facts.items[i];
        if (f.kind != 1) || (f.what < 2) || (f.what > 5) {
            continue;
        }
        sn := sibling_name(view(f.callee), f.what, f.width);
        mut seen = 0;
        for j in l.sibnames.len() {
            if eq(view(l.sibnames[j]), view(sn)) {
                seen = 1;
            }
        }
        if seen != 0 {
            continue;
        }
        mut found = 0;
        mut at: u64 = 0;
        for fi in funcs.len() {
            if eq(view(funcs[fi].name), view(f.callee)) {
                found = 1;
                at = fi;
            }
        }
        if found == 0 {
            continue;
        }
        l.sibwidth = f.width;
        l.sibwhat = f.what;
        exchange(&mut l.sd, copy(view("%d")));
        exchange(&mut l.sl, copy(view("%l")));
        cf := &funcs[at];
        lower_function(&mut l, &lines, &cf, &facts);
        if l.fail == 0 {
            l.sibnames.push(copy(view(sn)));
            l.sibbodies.push(copy(view(l.body)));
            sibwidths.push(f.width);
        }
        l.sibwidth = 0;
        l.sibwhat = 0;
    }
    mut functions = u8[];
    mut native_lines = u8[][];
    native_lines.push(copy(view(".text")));
    mut native_tokens = set_new(funcs.len() * 64 + 64);
    for fi in funcs.len() {
        f := &funcs[fi];
        mut pinned = 0;
        own := body_lines(&lines, &f);
        for q in own.len() {
            name := label_of(view(own[q]));
            if (name.len() != 0) & (name.len() + 1 == own[q].len()) & set_has(&data_tokens, view(name)) {
                pinned = 1;
            }
        }
        saved_calls := l.calls.len();
        saved_refs := l.refs.len();
        saved_addrs := l.addrs.len();
        if pinned == 0 {
            lower_function(&mut l, &lines, &f, facts);
        }
        if (pinned == 0) & (l.fail == 0) {
            put(&mut functions, view("define {i64, i64} @\""));
            put(&mut functions, view(f.name));
            put(&mut functions, view("\"(i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5) {\n"));
            put(&mut functions, view(l.body));
            put(&mut functions, view("}\n"));
            l.lifted.push(copy(view(f.name)));
            continue;
        }
        // Native: drop what this function added to the call and reference lists.
        while l.calls.len() > saved_calls {
            l.calls.pop();
        }
        while l.refs.len() > saved_refs {
            l.refs.pop();
        }
        while l.addrs.len() > saved_addrs {
            l.addrs.pop();
        }
        mut g = copy(view(".globl "));
        if set_has(&weak, view(f.name)) {
            g = copy(view(".weak "));
        }
        put(&mut g, view(f.name));
        native_lines.push(g);
        mut h = copy(view(".hidden "));
        put(&mut h, view(f.name));
        native_lines.push(h);
        mut lab = copy(view(f.name));
        lab.push(58);
        native_lines.push(lab);
        kept := body_lines(&lines, &f);
        for k in kept.len() {
            native_lines.push(copy(view(kept[k])));
            add_tokens(&mut native_tokens, view(kept[k]));
        }
        if f.framed != 0 {
            // The frame symbol is the one the prologue's `subq $.Fn,%rsp` names.
            mut sym = u8[];
            for k in kept.len() {
                line := view(kept[k]);
                if starts(line, view("subq $.F")) & (sym.len() == 0) {
                    sym = sub(line, 6, line.len() - 5);
                }
            }
            mut set = copy(view(".set "));
            put(&mut set, view(sym));
            set.push(44);
            num(&mut set, f.frame);
            native_lines.push(set);
        }
    }
    for i in data.len() {
        add_tokens(&mut native_tokens, view(data[i]));
    }
    // The typed siblings, emitted as internal functions: the word-machine body with the header
    // fields passed in, under a pointer the fact says is 24 bytes at eight-byte alignment.
    for i in l.sibnames.len() {
        mut guard = u8[];
        num(&mut guard, i);
        put(&mut functions, view("define internal {i64, i64} @\""));
        put(&mut functions, view(l.sibnames[i]));
        put(&mut functions, view("\"(ptr nocapture nofree dereferenceable(24) align 8 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %d, i64 %l) {\n"));
        put(&mut functions, view(l.sibbodies[i]));
        put(&mut functions, view("}\n"));
        l.lifted.push(copy(view(l.sibnames[i])));
    }
    mut lifted = set_new(l.lifted.len() + 16);
    for i in l.lifted.len() {
        set_add(&mut lifted, view(l.lifted[i]));
    }
    // Calls and references were appended as found; the sets below deduplicate them.
    l.calls.push(copy(view("rt_abort")));
    for i in l.calls.len() {
        l.refs.push(copy(view(l.calls[i])));
    }
    // The module text.
    mut ir = u8[];
    put(&mut ir, view("target triple = \""));
    put(&mut ir, triple);
    put(&mut ir, view("\"\n"));
    mut head = u8[];
    header(&mut head);
    if target != 0 {
        // The cold abort stub calls rt_abort through the same NAME.ll / NAME.c naming.
        hl := split_lines(view(head));
        head = u8[];
        for i in hl.len() {
            put(&mut head, view(rename_calls(view(hl[i]), &lifted)));
            head.push(10);
        }
    }
    put(&mut ir, view(head));
    if verify != 0 {
        dump_facts(&mut ir, facts);
    }
    mut callset = set_new(l.calls.len() + 16);
    for i in l.calls.len() {
        set_add(&mut callset, view(l.calls[i]));
    }
    mut exported = set_new(l.refs.len() + 16);
    if target != 0 {
        mut declared = set_new(l.addrs.len() + 16);
        for i in l.addrs.len() {
            a := view(l.addrs[i]);
            // Lifted functions and called native functions are declared under NAME.ll / NAME.c,
            // so their plain names (the native-convention entry) need their own declaration.
            renamed := set_has(&lifted, a) || set_has(&callset, a);
            if renamed && !set_has(&declared, a) {
                set_add(&mut declared, a);
                set_add(&mut native_tokens, a);
                put(&mut ir, view("@\""));
                put(&mut ir, a);
                put(&mut ir, view("\" = external hidden global i8\n"));
            }
        }
    }
    for i in l.refs.len() {
        r := view(l.refs[i]);
        if set_has(&lifted, r) || set_has(&exported, r) {
            continue;
        }
        mut name = copy(r);
        if is_local_label(r) {
            name = pool_name(r);
        }
        set_add(&mut exported, r);
        if set_has(&callset, r) {
            put(&mut ir, view("declare {i64, i64} @\""));
            put(&mut ir, view(name));
            if target != 0 {
                put(&mut ir, view(".c"));
            }
            put(&mut ir, view("\"(i64, i64, i64, i64, i64, i64)\n"));
        } else {
            put(&mut ir, view("@\""));
            put(&mut ir, view(name));
            put(&mut ir, view("\" = external hidden global i8\n"));
        }
    }
    // Lifted functions native code does not name are internal (inlinable and removable).
    fl := split_lines(view(functions));
    mut thunks = u8[];
    for i in fl.len() {
        mut renamed = copy(view(fl[i]));
        if target != 0 {
            renamed = rename_calls(view(fl[i]), &lifted);
        }
        line := view(renamed);
        if starts(line, view("define {i64, i64} @\"")) {
            mut e = 20;
            while (e < line.len()) && (line[e] != 34) {
                e += 1;
            }
            mut fname = sub(line, 20, e);
            if (target != 0) && ends(view(fname), view(".ll")) {
                fname = sub(view(fname), 0, fname.len() - 3);
            }
            if !set_has(&native_tokens, view(fname)) & !eq(view(fname), view("_start")) {
                put(&mut ir, view("define internal {i64, i64} @\""));
                put(&mut ir, view(sub(line, 20, line.len())));
                ir.push(10);
                continue;
            }
        }
        if (target != 0) && starts(line, view("define {i64, i64} @\"")) {
            mut e = 20;
            while (e < line.len()) && (line[e] != 34) {
                e += 1;
            }
            fname := sub(line, 20, e - 3);
            thunk_into_ir(&mut thunks, view(fname), target);
        }
        put(&mut ir, view(rename_line(line, &exported)));
        ir.push(10);
    }
    // Native functions, then data: labels the IR references become hidden globals, and the
    // assembler-temporary .L ones are renamed everywhere they appear.
    mut native = u8[];
    for i in native_lines.len() {
        put(&mut native, view(rename_line(view(native_lines[i]), &exported)));
        native.push(10);
    }
    for i in data.len() {
        line := view(data[i]);
        name := label_of(line);
        if (name.len() != 0) & set_has(&exported, view(name)) {
            mut gname = copy(view(name));
            if is_local_label(view(name)) {
                gname = pool_name(view(name));
            }
            // A weak datum (a content-addressed vtable) already says `.weak`; `.globl` would
            // change its binding, so it only gains `.hidden`.
            if !set_has(&weak, view(name)) {
                put(&mut native, view(".globl "));
                put(&mut native, view(gname));
                native.push(10);
            }
            put(&mut native, view(".hidden "));
            put(&mut native, view(gname));
            native.push(10);
        }
        put(&mut native, view(rename_line(line, &exported)));
        native.push(10);
    }
    if target != 0 {
        for i in l.calls.len() {
            name := view(l.calls[i]);
            if !set_has(&lifted, name) {
                mut marker = copy(name);
                marker.push(1);
                if !set_has(&lifted, view(marker)) {
                    set_add(&mut lifted, view(marker));
                    thunk_from_ir(&mut thunks, name, target);
                }
            }
        }
    }
    return Lowered { ir: ir, native: native, thunks: thunks };
}
