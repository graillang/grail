        if (q.kind != 1) || (q.what != 7) || !eq(view(q.callee), view("rt_f64_op")) || !eq(view(q.fn), view(f.name)) {
            continue;
        }
        while l.fops.len() <= q.a {
            l.fops.push(0);
        }
        l.fops[q.a] = q.width;
    }
    exchange(&mut l.fname, copy(view(f.name)));
    exchange(&mut l.sigerr, u8[]);
    exchange(&mut l.curline, u8[]);
    exchange(&mut l.area, u8[][]);
    l.areaopen = 0;
    l.argwritten = 0;
    l.xpend = 0;
    l.xstale = 18446744073709551615;
    l.rdxdead = 0;
    l.nargs = 6;
    l.retw = 2;
    mut sigcode = 0;
    if l.sibwidth == 0 {
        sigcode = set_get(&l.sigs, view(f.name));
    }
    if sigcode != 0 {
        l.nargs = sigcode / 4;
        l.retw = sigcode % 4;
    }
