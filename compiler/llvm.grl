fn rg_join(rc: (&RC), dst: (&mut u64[]), src: (&u64[]), widen: u64, block: u64, thr: (&u64[])) -> u64 {
    mut changed = 0;
    if dst.len() != src.len() {
        return 0;
    }
    for i in rc.nloc {
        b := 5 * i;
        dk := dst[b];
        sk := src[b];
        if dk != sk {
            // A location the two paths type differently holds a word this analysis cannot type.
            if (dk != 0) || (dst[b + 2] != rg_max()) {
                changed = 1;
            }
            rg_clear(&mut dst, i);
            continue;
        }
        if dk == 1 {
            mut lo = dst[b + 1];
            if src[b + 1] < lo {
                lo = src[b + 1];
                if widen != 0 {
                    lo = 0;
                }
                changed = 1;
            }
            mut hi = dst[b + 2];
            if src[b + 2] > hi {
                hi = src[b + 2];
                if widen != 0 {
                    mut top = rg_max();
                    for t in thr.len() {
                        if (thr[t] >= hi) & (thr[t] < top) {
                            top = thr[t];
                        }
                    }
                    hi = top;
                }
                changed = 1;
            }
            mut sym = dst[b + 3];
            mut sgen = dst[b + 4];
            if (src[b + 3] != sym) || (src[b + 4] != sgen) {
                sym = 0;
                sgen = 0;
            }
            dst[b + 1] = lo;
            dst[b + 2] = hi;
            dst[b + 3] = sym;
            dst[b + 4] = sgen;
            continue;
        }
