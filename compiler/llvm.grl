            }
        }
    }
    if 32 < wanted {
        wanted = 32;
    }
    while (1 < wanted) && (size / wanted < 524288) {
        wanted -= 1;
    }
    if funcs.len() < wanted {
        wanted = funcs.len();
    }
    if wanted < 2 {
        return Piece[lower_range(&mut l, &lines, &funcs, 0, funcs.len(), &facts, &fheads, &fnext, ranges, &data_tokens, &weak)];
    }
    mut js = jobs::open();
    count := jobs::workers(&mut js, wanted);
    if count < 2 {
        jobs::give_all(&mut js);
        return Piece[lower_range(&mut l, &lines, &funcs, 0, funcs.len(), &facts, &fheads, &fnext, ranges, &data_tokens, &weak)];
    }
    // Cuts at function boundaries, by lines.
    mut total: u64 = 0;
    for i in funcs.len() {
        total += funcs[i].end - funcs[i].first;
    }
    mut cuts = u64[0];
    mut acc: u64 = 0;
    for i in funcs.len() {
        acc += funcs[i].end - funcs[i].first;
        if (cuts.len() < count) && (acc * count >= total * cuts.len()) && (i + 1 < funcs.len()) {
            cuts.push(i + 1);
        }
    }
    cuts.push(funcs.len());
    mut readers = u64[];
    mut children = u64[];
    for k in cuts.len() - 1 {
        pair := host::pipe();
        child := host::fork();
        if child == 0 {
            host::close(pair[0]);
            for r in readers.len() {
                host::close(readers[r]);
            }
