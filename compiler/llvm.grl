fn lower_target<a, b, c>(stream: &a [u8], triple: &b [u8], target: u64, facts: (&c Facts), verify: u64, ranges: u64) -> Lowered {
    mut excluded = u8[][];
    while true {
        lowered := lower_attempt(stream, triple, target, facts, verify, ranges, &excluded);
        if (lowered.wrong.len() == 0) || (verify != 0) {
            return lowered;
        }
        for i in lowered.wrong.len() {
            excluded.push(copy(view(lowered.wrong[i])));
        }
    }
    return lower_attempt(stream, triple, target, facts, verify, ranges, &excluded);
}
fn lower_attempt<a, b, c, d>(stream: &a [u8], triple: &b [u8], target: u64, facts: (&c Facts), verify: u64, ranges: u64, excluded: (&d u8[][])) -> Lowered {
