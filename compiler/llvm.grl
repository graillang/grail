    errors: u8[],
    wrong: u8[][]
}
fn lower_range<a, b, c, d, e, g, h>(l: (&a mut L), lines: (&b u8[][]), funcs: (&c Func[]), lo: u64, hi: u64, facts: (&d Facts), fheads: (&e Map), fnext: (&e u64[]), ranges: u64, data_tokens: (&g Set), weak: (&h Set)) -> Piece {
    mut p = Piece { functions: u8[], native: u8[][], kept: u64[], lifted: u8[][], calls: u8[][], refs: u8[][], addrs: u8[][], errors: u8[], wrong: u8[][] };
    base_wrong := l.wrong.len();
    base_lifted := l.lifted.len();
    base_calls := l.calls.len();
    base_refs := l.refs.len();
    base_addrs := l.addrs.len();
    mut fi = lo;
    while fi < hi {
        at_fi := fi;
        fi += 1;
        f := &funcs[at_fi];
        mut pinned = 0;
        own := body_lines(&lines, &f);
        for q in own.len() {
            name := label_of(view(own[q]));
            if (name.len() != 0) & (name.len() + 1 == own[q].len()) & set_has(&data_tokens, view(name)) {
                pinned = 1;
            }
        }
        saved_calls := l.calls.len();
        saved_refs := l.refs.len();
        saved_addrs := l.addrs.len();
        if pinned == 0 {
            ffacts := facts_of(&facts, &fheads, &fnext, view(f.name), ranges);
            lower_function(&mut l, &lines, &f, &ffacts);
            if l.sigerr.len() != 0 {
                p.errors.append(view(l.sigerr));
            }
        }
        if (pinned == 0) & (l.fail == 0) {
            put(&mut p.functions, view("define "));
            put(&mut p.functions, view(result_type(l.retw)));
            put(&mut p.functions, view(" @\""));
            put(&mut p.functions, view(f.name));
            // A frame over a page is probed as the native backend's is (optimize::probe_frames).
            put(&mut p.functions, view("\"("));
            put(&mut p.functions, view(param_list(l.nargs)));
            put(&mut p.functions, view(") \"probe-stack\"=\"inline-asm\""));
            // A runtime fast path stays small only if what it falls back to stays out of it: a
            // `rt_..._slow` function is cold and never inlined, and the threaded allocator paths are
            // never inlined into the one-thread wrappers (rt_alloc, rt_free), whose frame would
            // otherwise save every callee-saved register on every allocation.
            if starts(view(f.name), view("rt_")) && ends(view(f.name), view("_slow")) {
                put(&mut p.functions, view(" noinline cold"));
            } else if eq(view(f.name), view("rt_alloc_shared")) || eq(view(f.name), view("rt_free_shared")) {
                put(&mut p.functions, view(" noinline"));
            }
            atomics_inline(&mut p.functions, l.target);
            put(&mut p.functions, view(" {\n"));
            put(&mut p.functions, view(l.body));
            put(&mut p.functions, view("}\n"));
            l.lifted.push(copy(view(f.name)));
            continue;
        }
        // Native: drop what this function added to the call and reference lists.
        while l.calls.len() > saved_calls {
            l.calls.pop()!;
        }
        while l.refs.len() > saved_refs {
            l.refs.pop()!;
        }
        while l.addrs.len() > saved_addrs {
            l.addrs.pop()!;
        }
        mut g = copy(view(".globl "));
        if set_has(&weak, view(f.name)) {
            g = copy(view(".weak "));
        }
        put(&mut g, view(f.name));
        p.native.push(g);
        mut h = copy(view(".hidden "));
        put(&mut h, view(f.name));
        p.native.push(h);
        mut lab = copy(view(f.name));
        lab.push(58);
        p.native.push(lab);
        kept := body_lines(&lines, &f);
        for k in kept.len() {
            p.native.push(copy(view(kept[k])));
            p.kept.push(p.native.len() - 1);
        }
        if f.framed != 0 {
            // The frame symbol is the one the prologue's `subq $.Fn,%rsp` names.
            mut sym = u8[];
            for k in kept.len() {
                line := view(kept[k]);
                if starts(line, view("subq $.F")) & (sym.len() == 0) {
                    sym = sub(line, 6, line.len() - 5);
                }
