        return 0;
    }
    return st[5 * i];
}
fn rg_lo(st: (&u64[]), i: u64) -> u64 {
    if 5 * i + 5 > st.len() {
        return 0;
    }
    return st[5 * i + 1];
}
fn rg_hi(st: (&u64[]), i: u64) -> u64 {
    if 5 * i + 5 > st.len() {
        return rg_max();
    }
    return st[5 * i + 2];
}
fn rg_sym(st: (&u64[]), i: u64) -> u64 {
    if 5 * i + 5 > st.len() {
        return 0;
    }
    return st[5 * i + 3];
}
fn rg_sgen(st: (&u64[]), i: u64) -> u64 {
    if 5 * i + 5 > st.len() {
        return 0;
    }
    return st[5 * i + 4];
}
fn rg_put(st: (&mut u64[]), i: u64, kind: u64, lo: u64, hi: u64, sym: u64, sgen: u64) -> unit {
