fn rg_refine_op(rc: (&RC), st: (&mut u64[]), pcmp: (&u64[]), side: u64, op: (&[u8]), other: (&[u8]), rel: u64, instrs: (&u8[][]), stop: u64, snap: (&u64[])) -> unit {
