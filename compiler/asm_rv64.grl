module asm_rv64;
use asm_x86;
use asm_a64;

// The RISC-V (RV64IMAFD) half of the internal assembler (docs/design/compile-speed.md, stage 4):
// the instructions machine.grl's RISC-V lowering writes, with `.option norelax` and `.option
// norvc` (no linker relaxation, no compressed forms), encoded as LLVM's MC layer encodes them -
// `li` by LLVM's materialisation (RISCVMatInt), `lla` as auipc+addi through a `.Lpcrel_hiN` label,
// `call` as auipc+jalr. The reader, sections, symbols and the ELF writer are asm_x86's.

pub fn fx_branch() -> u64 {
    return 30;
}
pub fn fx_jal() -> u64 {
    return 31;
}
pub fn fx_call() -> u64 {
    return 32;
}
pub fn fx_pcrel_hi() -> u64 {
    return 33;
}
pub fn fx_pcrel_lo() -> u64 {
    return 34;
}
pub fn fx_tprel_hi() -> u64 {
    return 35;
}
pub fn fx_tprel_lo() -> u64 {
    return 36;
}
pub fn fx_tprel_add() -> u64 {
    return 37;
}

// The ISA string LLVM writes for -march=rv64imafd, in the code mapping symbol and the attributes.
pub fn isa() -> u8[] {
    return view("rv64i2p1_m2p0_a2p1_f2p2_d2p2_zicsr2p0_zmmul1p0_zaamo1p0_zalrsc1p0").copy();
}

// A register name at the cursor: its number plus 32 for a float register; 64 + 0 when none.
fn reg<a>(o: (&a mut asm_x86::A)) -> u64 {
    asm_x86::skip(&mut o);
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    n := e - a0;
    if n < 2 {
        return 99;
    }
    names := u8[][
        view("zero").copy(),
        view("ra").copy(),
        view("sp").copy(),
        view("gp").copy(),
        view("tp").copy(),
        view("t0").copy(),
        view("t1").copy(),
        view("t2").copy(),
        view("s0").copy(),
        view("s1").copy(),
        view("a0").copy(),
        view("a1").copy(),
        view("a2").copy(),
        view("a3").copy(),
        view("a4").copy(),
        view("a5").copy(),
        view("a6").copy(),
        view("a7").copy(),
        view("s2").copy(),
        view("s3").copy(),
        view("s4").copy(),
        view("s5").copy(),
        view("s6").copy(),
        view("s7").copy(),
        view("s8").copy(),
        view("s9").copy(),
        view("s10").copy(),
        view("s11").copy(),
        view("t3").copy(),
        view("t4").copy(),
        view("t5").copy(),
        view("t6").copy()
    ];
    for i in names.len() {
        if asm_x86::at_src(&o, a0, e, view(names[i])) {
            o.at = e;
            return i;
        }
    }
    if asm_x86::at_src(&o, a0, e, view("fp")) {
        o.at = e;
        return 8;
    }
    fnames := u8[][
        view("ft0").copy(),
        view("ft1").copy(),
        view("ft2").copy(),
        view("ft3").copy(),
        view("ft4").copy(),
        view("ft5").copy(),
        view("ft6").copy(),
        view("ft7").copy(),
        view("fs0").copy(),
        view("fs1").copy(),
        view("fa0").copy(),
        view("fa1").copy(),
        view("fa2").copy(),
        view("fa3").copy(),
        view("fa4").copy(),
        view("fa5").copy(),
        view("fa6").copy(),
        view("fa7").copy(),
        view("fs2").copy(),
        view("fs3").copy(),
        view("fs4").copy(),
        view("fs5").copy(),
        view("fs6").copy(),
        view("fs7").copy(),
        view("fs8").copy(),
        view("fs9").copy(),
        view("fs10").copy(),
        view("fs11").copy(),
        view("ft8").copy(),
        view("ft9").copy(),
        view("ft10").copy(),
        view("ft11").copy()
    ];
    for i in fnames.len() {
        if asm_x86::at_src(&o, a0, e, view(fnames[i])) {
            o.at = e;
            return 32 + i;
        }
    }
    // x0..x31, f0..f31
    c := o.src[a0];
    if (c == 'x') || (c == 'f') {
        mut v = 0;
        for i in n - 1 {
            d := o.src[a0 + 1 + i];
            if (d < '0') || (d > '9') {
                return 99;
            }
            v = v * 10 + d - '0';
        }
        if v < 32 {
            o.at = e;
            if c == 'f' {
                return 32 + v;
            }
            return v;
        }
    }
    return 99;
}

fn need<a>(o: (&a mut asm_x86::A)) -> u64 {
    r := reg(&mut o);
    if r == 99 {
        asm_x86::fail(&mut o, view("expected a register"));
        return 0;
    }
    return r;
}

fn comma<a>(o: (&a mut asm_x86::A)) {
    asm_x86::expect(&mut o, ',');
}

fn r5(r: u64) -> u64 {
    return r & 31;
}

fn word<a>(o: (&a mut asm_x86::A), w: u64) {
    asm_x86::emit_le(&mut o, w & 0xffffffff, 4);
}

fn rtype(f7: u64, rs2: u64, rs1: u64, f3: u64, rd: u64, op: u64) -> u64 {
    return (f7 << 25) | (r5(rs2) << 20) | (r5(rs1) << 15) | (f3 << 12) | (r5(rd) << 7) | op;
}

fn itype(imm: u64, rs1: u64, f3: u64, rd: u64, op: u64) -> u64 {
    return ((imm & 0xfff) << 20) | (r5(rs1) << 15) | (f3 << 12) | (r5(rd) << 7) | op;
}

fn stype(imm: u64, rs2: u64, rs1: u64, f3: u64, op: u64) -> u64 {
    return (((imm >> 5) & 0x7f) << 25)
        | (r5(rs2) << 20)
        | (r5(rs1) << 15)
        | (f3 << 12)
        | ((imm & 31) << 7)
        | op;
}

fn sext12(v: u64) -> u64 {
    lo := v & 0xfff;
    if (lo & 0x800) != 0 {
        return lo | 0xfffffffffffff000;
    }
    return lo;
}

fn is_int32(v: u64) -> bool {
    return wrapping_add(v, 0x80000000) < 0x100000000;
}

fn is_int12(v: u64) -> bool {
    return wrapping_add(v, 0x800) < 0x1000;
}

fn ctz(v: u64) -> u64 {
    if v == 0 {
        return 64;
    }
    mut n = 0;
    while ((v >> n) & 1) == 0 {
        n += 1;
    }
    return n;
}

fn clz(v: u64) -> u64 {
    if v == 0 {
        return 64;
    }
    mut n = 0;
    while ((v >> (63 - n)) & 1) == 0 {
        n += 1;
    }
    return n;
}

// Arithmetic shift right.
fn sra(v: u64, s: u64) -> u64 {
    if s == 0 {
        return v;
    }
    r := v >> s;
    if (v >> 63) != 0 {
        return r | (0xffffffffffffffff << (64 - s));
    }
    return r;
}

// LLVM's RISCVMatInt::generateInstSeqImpl for RV64 without Zba/Zbs: kinds 1 lui, 2 addi, 3 addiw,
// 4 slli, 5 srli, each with its immediate.
fn mat_impl(val: u64, kinds: (&mut u64[]), imms: (&mut u64[])) {
    if is_int32(val) {
        hi20 := (wrapping_add(val, 0x800) >> 12) & 0xfffff;
        lo12 := sext12(val);
        if hi20 != 0 {
            kinds.push(1);
            imms.push(hi20);
        }
        if (lo12 != 0) || (hi20 == 0) {
            mut opc = 2;
            if hi20 != 0 {
                // ADDIW only where ADDI would leave the 32-bit range.
                mut lui = hi20 << 12;
                if (lui & 0x80000000) != 0 {
                    lui = lui | 0xffffffff00000000;
                }
                if !is_int32(wrapping_add(lui, lo12)) {
                    opc = 3;
                }
            }
            kinds.push(opc);
            imms.push(lo12);
        }
        return ();
    }
    lo12 := sext12(val);
    mut v = wrapping_sub(val, lo12);
    mut shift = 0;
    if !is_int32(v) {
        shift = ctz(v);
        v = sra(v, shift);
        if (shift > 12) && !is_int12(v) && is_int32(v << 12) {
            shift -= 12;
            v = v << 12;
        }
    }
    mat_impl(v, &mut kinds, &mut imms);
    if shift != 0 {
        kinds.push(4);
        imms.push(shift);
    }
    if lo12 != 0 {
        kinds.push(2);
        imms.push(lo12);
    }
}

// LLVM's RISCVMatInt::generateInstSeq (the parts that apply without Zba, Zbs or fusion).
fn materialise(val: u64, kinds: (&mut u64[]), imms: (&mut u64[])) {
    mat_impl(val, &mut kinds, &mut imms);
    if ((val & 0xfff) != 0) && ((val & 1) == 0) && (kinds.len() >= 2) {
        tz := ctz(val);
        shifted := sra(val, tz);
        compressible := wrapping_add(shifted, 32) < 64;
        mut k2 = u64[];
        mut i2 = u64[];
        mat_impl(shifted, &mut k2, &mut i2);
        if (k2.len() + 1 < kinds.len()) || compressible {
            k2.push(4);
            i2.push(tz);
            *kinds = k2;
            *imms = i2;
        }
    }
    if kinds.len() <= 2 {
        return ();
    }
    if ((val >> 63) == 0) && (val != 0) {
        lz := clz(val);
        mut shifted = val << lz;
        shifted = shifted | ((1 << lz) - 1);
        mut k2 = u64[];
        mut i2 = u64[];
        mat_impl(shifted, &mut k2, &mut i2);
        if k2.len() + 1 < kinds.len() {
            k2.push(5);
            i2.push(lz);
            *kinds = k2;
            *imms = i2;
        }
        shifted = shifted & (0xffffffffffffffff << lz);
        mut k3 = u64[];
        mut i3 = u64[];
        mat_impl(shifted, &mut k3, &mut i3);
        if k3.len() + 1 < kinds.len() {
            k3.push(5);
            i3.push(lz);
            *kinds = k3;
            *imms = i3;
        }
    }
}

fn li<a>(o: (&a mut asm_x86::A), rd: u64, val: u64) {
    mut kinds = u64[];
    mut imms = u64[];
    materialise(val, &mut kinds, &mut imms);
    mut src = 0;
    for i in kinds.len() {
        k := kinds[i];
        v := imms[i];
        if k == 1 {
            word(&mut o, (v << 12) | (r5(rd) << 7) | 0x37);
        } else if k == 2 {
            word(&mut o, itype(v, src, 0, rd, 0x13));
        } else if k == 3 {
            word(&mut o, itype(v, src, 0, rd, 0x1b));
        } else if k == 4 {
            word(&mut o, itype(v, src, 1, rd, 0x13));
        } else {
            word(&mut o, itype(v, src, 5, rd, 0x13));
        }
        src = rd;
    }
}

// `imm(reg)` (the immediate optional), or `%modifier(sym)(reg)`.
fn mem<a>(o: (&a mut asm_x86::A), base: (&mut u64)) -> u64 {
    asm_x86::skip(&mut o);
    mut off = 0;
    if asm_x86::peek(&o) != '(' {
        off = asm_a64::expr_or(&mut o);
    }
    asm_x86::expect(&mut o, '(');
    *base = need(&mut o);
    asm_x86::expect(&mut o, ')');
    return off;
}

// A label operand: a fixup of `kind` at the instruction about to be emitted.
fn label_ref<a>(o: (&a mut asm_x86::A), kind: u64) {
    asm_x86::skip(&mut o);
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    if e == a0 {
        asm_x86::fail(&mut o, view("expected a label"));
        return ();
    }
    mut sym = 0;
    last := o.src[e - 1];
    if (e - a0 >= 2) && asm_x86::all_digits(&o, a0, e - 1) && ((last == 'f') || (last == 'b')) {
        sym = asm_x86::numeric_ref(&mut o, a0, e - 1, last == 'f');
    } else {
        sym = asm_x86::symbol(&mut o, a0, e);
    }
    o.at = e;
    mut add = 0;
    asm_x86::skip(&mut o);
    if (asm_x86::peek(&o) == '+') || (asm_x86::peek(&o) == '-') {
        neg := asm_x86::peek(&o) == '-';
        o.at += 1;
        n := asm_x86::number(&mut o);
        if neg {
            add = wrapping_sub(0, n);
        } else {
            add = n;
        }
    }
    asm_x86::fixup(&mut o, sym, kind, add);
}

// `%name(sym)`: the modifier's fixup kind (the symbol's fixup is recorded).
fn modifier<a>(o: (&a mut asm_x86::A)) {
    asm_x86::expect(&mut o, '%');
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    o.at = e;
    mut kind = 0;
    if asm_x86::at_src(&o, a0, e, view("tprel_hi")) {
        kind = fx_tprel_hi();
    } else if asm_x86::at_src(&o, a0, e, view("tprel_lo")) {
        kind = fx_tprel_lo();
    } else if asm_x86::at_src(&o, a0, e, view("tprel_add")) {
        kind = fx_tprel_add();
    } else {
        asm_x86::fail(&mut o, view("unsupported relocation modifier"));
        return ();
    }
    asm_x86::expect(&mut o, '(');
    label_ref(&mut o, kind);
    asm_x86::expect(&mut o, ')');
}

fn simple<a, b>(o: (&a asm_x86::A), a0: u64, e: u64, w: &b [u8]) -> bool {
    return asm_x86::at_src(&o, a0, e, w);
}

fn r3<a>(o: (&a mut asm_x86::A), f7: u64, f3: u64, op: u64) {
    d := need(&mut o);
    comma(&mut o);
    n := need(&mut o);
    comma(&mut o);
    m := need(&mut o);
    word(&mut o, rtype(f7, m, n, f3, d, op));
}

fn i3<a>(o: (&a mut asm_x86::A), f3: u64, op: u64, hi: u64) {
    d := need(&mut o);
    comma(&mut o);
    n := need(&mut o);
    comma(&mut o);
    asm_x86::skip(&mut o);
    if asm_x86::peek(&o) == '%' {
        modifier(&mut o);
        word(&mut o, itype(0, n, f3, d, op));
        return ();
    }
    v := asm_a64::expr_or(&mut o);
    word(&mut o, itype(v | hi, n, f3, d, op));
}

fn load<a>(o: (&a mut asm_x86::A), f3: u64, op: u64) {
    d := need(&mut o);
    comma(&mut o);
    mut base = 0;
    off := mem(&mut o, &mut base);
    word(&mut o, itype(off, base, f3, d, op));
}

fn store<a>(o: (&a mut asm_x86::A), f3: u64, op: u64) {
    s := need(&mut o);
    comma(&mut o);
    mut base = 0;
    off := mem(&mut o, &mut base);
    word(&mut o, stype(off, s, base, f3, op));
}

// AMOs and LR/SC: `funct5`, the .w/.d width (f3), and the aq/rl suffix bits in the mnemonic.
fn amo<a>(o: (&a mut asm_x86::A), a0: u64, e: u64, funct5: u64, lr: bool) {
    mut f3 = 3;
    mut aq = 0;
    mut rl = 0;
    mut i = a0;
    while i < e {
        if o.src[i] == '.' {
            j := i + 1;
            mut k = j;
            while (k < e) && (o.src[k] != '.') {
                k += 1;
            }
            if asm_x86::at_src(&o, j, k, view("w")) {
                f3 = 2;
            } else if asm_x86::at_src(&o, j, k, view("aq")) {
                aq = 1;
            } else if asm_x86::at_src(&o, j, k, view("rl")) {
                rl = 1;
            } else if asm_x86::at_src(&o, j, k, view("aqrl")) {
                aq = 1;
                rl = 1;
            }
            i = k;
        } else {
            i += 1;
        }
    }
    d := need(&mut o);
    comma(&mut o);
    mut src = 0;
    if !lr {
        src = need(&mut o);
        comma(&mut o);
    }
    asm_x86::expect(&mut o, '(');
    base := need(&mut o);
    asm_x86::expect(&mut o, ')');
    word(&mut o, (funct5 << 27) | (aq << 26) | (rl << 25) | rtype(0, src, base, f3, d, 0x2f));
}

fn fence_set<a>(o: (&a mut asm_x86::A)) -> u64 {
    asm_x86::skip(&mut o);
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    o.at = e;
    mut v = 0;
    mut i = a0;
    while i < e {
        c := o.src[i];
        if c == 'i' {
            v = v | 8;
        } else if c == 'o' {
            v = v | 4;
        } else if c == 'r' {
            v = v | 2;
        } else if c == 'w' {
            v = v | 1;
        }
        i += 1;
    }
    return v;
}

// The float format bits of a mnemonic suffix: `.d` 1, `.s` 0.
fn fmt<a>(o: (&a asm_x86::A), e: u64) -> u64 {
    if o.src[e - 1] == 's' {
        return 0;
    }
    return 1;
}

// An optional rounding mode operand (`,rtz`); 7 (dynamic) when absent.
fn rm<a>(o: (&a mut asm_x86::A), dflt: u64) -> u64 {
    asm_x86::skip(&mut o);
    if asm_x86::peek(&o) != ',' {
        return dflt;
    }
    o.at += 1;
    asm_x86::skip(&mut o);
    a0 := o.at;
    e := asm_x86::name_end(&mut o);
    o.at = e;
    names := u8[][
        view("rne").copy(),
        view("rtz").copy(),
        view("rdn").copy(),
        view("rup").copy(),
        view("rmm").copy()
    ];
    for i in names.len() {
        if asm_x86::at_src(&o, a0, e, view(names[i])) {
            return i;
        }
    }
    if asm_x86::at_src(&o, a0, e, view("dyn")) {
        return 7;
    }
    asm_x86::fail(&mut o, view("unknown rounding mode"));
    return 7;
}

pub fn instruction<a>(o: (&a mut asm_x86::A), a0: u64, e: u64) {
    o.at = e;
    if simple(&o, a0, e, view("mv")) {
        d := need(&mut o);
        comma(&mut o);
        n := need(&mut o);
        word(&mut o, itype(0, n, 0, d, 0x13));
    } else if simple(&o, a0, e, view("li")) {
        d := need(&mut o);
        comma(&mut o);
        v := asm_a64::expr_or(&mut o);
        li(&mut o, d, v);
    } else if simple(&o, a0, e, view("add")) {
        d := need(&mut o);
        comma(&mut o);
        n := need(&mut o);
        comma(&mut o);
        m := need(&mut o);
        asm_x86::skip(&mut o);
        if asm_x86::peek(&o) == ',' {
            o.at += 1;
            asm_x86::skip(&mut o);
            modifier(&mut o);
        }
        word(&mut o, rtype(0, m, n, 0, d, 0x33));
    } else if simple(&o, a0, e, view("sub")) {
        r3(&mut o, 0x20, 0, 0x33);
    } else if simple(&o, a0, e, view("sll")) {
        r3(&mut o, 0, 1, 0x33);
    } else if simple(&o, a0, e, view("slt")) {
        r3(&mut o, 0, 2, 0x33);
    } else if simple(&o, a0, e, view("sltu")) {
        r3(&mut o, 0, 3, 0x33);
    } else if simple(&o, a0, e, view("xor")) {
        r3(&mut o, 0, 4, 0x33);
    } else if simple(&o, a0, e, view("srl")) {
        r3(&mut o, 0, 5, 0x33);
    } else if simple(&o, a0, e, view("sra")) {
        r3(&mut o, 0x20, 5, 0x33);
    } else if simple(&o, a0, e, view("or")) {
        r3(&mut o, 0, 6, 0x33);
    } else if simple(&o, a0, e, view("and")) {
        r3(&mut o, 0, 7, 0x33);
    } else if simple(&o, a0, e, view("mul")) {
        r3(&mut o, 1, 0, 0x33);
    } else if simple(&o, a0, e, view("mulh")) {
        r3(&mut o, 1, 1, 0x33);
    } else if simple(&o, a0, e, view("mulhsu")) {
        r3(&mut o, 1, 2, 0x33);
    } else if simple(&o, a0, e, view("mulhu")) {
        r3(&mut o, 1, 3, 0x33);
    } else if simple(&o, a0, e, view("div")) {
        r3(&mut o, 1, 4, 0x33);
    } else if simple(&o, a0, e, view("divu")) {
        r3(&mut o, 1, 5, 0x33);
    } else if simple(&o, a0, e, view("rem")) {
        r3(&mut o, 1, 6, 0x33);
    } else if simple(&o, a0, e, view("remu")) {
        r3(&mut o, 1, 7, 0x33);
    } else if simple(&o, a0, e, view("addi")) {
        i3(&mut o, 0, 0x13, 0);
    } else if simple(&o, a0, e, view("addiw")) {
        i3(&mut o, 0, 0x1b, 0);
    } else if simple(&o, a0, e, view("slti")) {
        i3(&mut o, 2, 0x13, 0);
    } else if simple(&o, a0, e, view("sltiu")) {
        i3(&mut o, 3, 0x13, 0);
    } else if simple(&o, a0, e, view("xori")) {
        i3(&mut o, 4, 0x13, 0);
    } else if simple(&o, a0, e, view("ori")) {
        i3(&mut o, 6, 0x13, 0);
    } else if simple(&o, a0, e, view("andi")) {
        i3(&mut o, 7, 0x13, 0);
    } else if simple(&o, a0, e, view("slli")) {
        i3(&mut o, 1, 0x13, 0);
    } else if simple(&o, a0, e, view("srli")) {
        i3(&mut o, 5, 0x13, 0);
    } else if simple(&o, a0, e, view("srai")) {
        i3(&mut o, 5, 0x13, 0x400);
    } else if simple(&o, a0, e, view("sext.w")) {
        d := need(&mut o);
        comma(&mut o);
        n := need(&mut o);
        word(&mut o, itype(0, n, 0, d, 0x1b));
    } else if simple(&o, a0, e, view("seqz")) {
        d := need(&mut o);
        comma(&mut o);
        n := need(&mut o);
        word(&mut o, itype(1, n, 3, d, 0x13));
    } else if simple(&o, a0, e, view("snez")) {
        d := need(&mut o);
        comma(&mut o);
        n := need(&mut o);
        word(&mut o, rtype(0, n, 0, 3, d, 0x33));
