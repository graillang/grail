module fncache;
use host;
use xxhash;

// The per-function codegen cache: one file per emitted function, under the build cache's `fn/`
// directory (docs/design/incremental-compilation.md, "Per-function units").
//
// A *unit* is everything one function's compilation hands the run, as a value: its emitted assembly
// (which spells its own label numbers - `.L<unit prefix>_<function>_<n>` - and counts its `.gpos`
// lines from the function's first line, so it is the same text wherever the function stands), the
// typed-IR facts its emission recorded, and its *registrations* - every drop helper it names and
// every specialisation it asks for, which a later step of the run emits. Producing a unit and
// applying one to a run are separate steps (`native::fn_unit_of`, `native::fn_apply`), and a cache
// hit is a load and an apply. Everything about *which* functions are units, and what a unit's key
// names, lives in `compiler/native.grl` where the emitter is; this module is only the store and its
// framing.
//
// The store is a directory of files whose names are content hashes. A file is
//
//     "GFN2" key:VAR text:VAR facts:VAR regs:VAR sum:VAR
//
// where `S:VAR` is a LEB128 length followed by that many bytes; `facts` and `regs` are opaque here
// (the emitter writes one framed record per fact and per registration), and `sum` is the hash of
// key, facts and regs, so a damaged entry is never handed to the decoders of those records. The
// *key record itself* is inside the file: a reader compares it with the key it computed, so two
// keys that hash to the same file name make a miss and never a wrong hit. A truncated or unreadable
// file decodes to no unit at all, which is a miss.
//
// Writes go to `stage/` and are renamed into place, so a reader never sees half an entry; and a
// reader that finds one anyway rejects it rather than handing the emitter a partial body, because a
// wrong splice is a silent miscompile.

// One cached unit. `key` is empty when there is no unit (a miss, or an entry that did not decode).
pub struct Unit {
    key: u8[],
    text: u8[],
    facts: u8[],
    regs: u8[]
}

pub fn none() -> Unit {
    return Unit { key: u8[], text: u8[], facts: u8[], regs: u8[] };
}

// The hash of what the emitter's decoders will read.
fn sum<a>(u: (&a Unit)) -> u8[] {
    mut all = u.key.copy();
    all.append(view(u.facts));
    all.append(view(u.regs));
    return hash(view(all));
}

fn wv<a>(out: (&a mut u8[]), n: u64) -> unit {
    mut v = n;
    while 127 < v {
        out.push((v & 127) | 128);
        v = v >> 7;
    }
    out.push(v);
    return ();
}

fn ws<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    wv(&mut out, s.len());
    out.append(s);
    return ();
}

// A decoder over the bytes of one entry: `at` moves forward and `ok` goes to 0 the first time a
// field would read past the end, so a truncated file is a miss rather than a read past the end.
pub struct Read {
    data: u8[],
    at: u64,
    ok: u64
}

pub fn rv<a>(r: (&a mut Read)) -> u64 {
    mut n = 0;
    mut scale = 1;
    mut done = 0;
    while done == 0 {
        if (r.ok == 0) | (r.data.len() <= r.at) {
            exchange(&mut r.ok, 0);
            return 0;
        }
        b := r.data[r.at];
        r.at = r.at + 1;
        // Ten bytes carry 64 bits: the tenth, at scale 2^63, holds bit 63 alone and ends the number.
        // Anything wider cannot have been written by us.
        if (scale == 9223372036854775808) && (1 < b) {
            exchange(&mut r.ok, 0);
            return 0;
        }
        n = n + (b & 127) * scale;
        if (b & 128) == 0 {
            done = 1;
        } else {
            scale = scale * 128;
        }
    }
    return n;
}

pub fn rs<a>(r: (&a mut Read)) -> u8[] {
    n := rv(&mut r);
    if (r.ok == 0) | (r.data.len() < r.at) | ((r.data.len() - r.at) < n) {
        exchange(&mut r.ok, 0);
        return u8[];
    }
    mut out = u8[];
    out.append(r.data[r.at..r.at + n]);
    r.at = r.at + n;
    return out;
}

// Two XXH64 digests of the bytes under different seeds, printed as 32 hex characters. The value
// only ever names a file or stands for a text inside a key: the key record inside the file is what
// decides a hit, so a collision of file names costs a cache entry, never correctness.
pub fn hash<a>(data: &a [u8]) -> u8[] {
    // One pass over the bytes; the second half is the first mixed again with the length (the
    // finaliser of XXH64), which is enough for a name: the key inside the file decides a hit.
    h := xxhash::hash64(view(data), 1);
    mut g = h ^ data.len() ^ 11400714785074694791;
    g = wrapping_mul(g ^ (g >> 33), 14029467366897019727);
    g = wrapping_mul(g ^ (g >> 29), 1609587929392839161);
    g = g ^ (g >> 32);
    mut out = u8[];
    hex64(&mut out, h);
    hex64(&mut out, g);
    return out;
}

fn hex64<a>(out: (&a mut u8[]), n: u64) -> unit {
    mut at: u64 = 60;
    loop {
        d := (n >> at) & 15;
        if d < 10 {
            out.push(48 + d);
        } else {
            out.push(87 + d);
        }
        if at == 0 {
            break;
        }
        at -= 4;
    }
    return ();
}

pub fn encode<a>(u: (&a Unit)) -> u8[] {
    mut out = u8[];
    mut scratch = u8[];
    encode_into(&mut out, &mut scratch, u);
    return out;
}

// `encode`, appended to `out`: a run filing thousands of units writes them all into its pack buffer,
// and `scratch` (the bytes the checksum covers) is reused from one unit to the next.
pub fn encode_into<a, b, d>(out: (&a mut u8[]), scratch: (&b mut u8[]), u: (&d Unit)) -> unit {
    out.push(71);
    out.push(70);
    out.push(78);
    out.push(50);
    ws(&mut out, view(u.key));
    ws(&mut out, view(u.text));
    ws(&mut out, view(u.facts));
    ws(&mut out, view(u.regs));
    scratch.truncate(0);
    scratch.append(view(u.key));
    scratch.append(view(u.facts));
    scratch.append(view(u.regs));
    ws(&mut out, view(hash(view(scratch))));
    return ();
}

// A unit as a body worker sends it through its pipe: the same framing, and in a check run (whose
// text nobody reads) the text may be empty. Never a store entry: `decode` keeps refusing those.
pub fn decode_piped(bytes: u8[]) -> Unit {
    return decode_text(bytes, 1);
}

pub fn decode(bytes: u8[]) -> Unit {
    return decode_text(bytes, 0);
}

fn decode_text(bytes: u8[], empty_text: u64) -> Unit {
    if bytes.len() < 5 {
        return none();
    }
    if (bytes[0] != 71) || (bytes[1] != 70) || (bytes[2] != 78) || (bytes[3] != 50) {
        return none();
    }
    mut r = Read { data: bytes, at: 4, ok: 1 };
    key := rs(&mut r);
    text := rs(&mut r);
    facts := rs(&mut r);
    regs := rs(&mut r);
    check := rs(&mut r);
    // The bytes after the last field would be a record this compiler did not write.
    if (r.ok == 0) | (r.at != r.data.len()) | (key.len() == 0) | ((text.len() == 0) & (empty_text == 0)) {
        return none();
    }
    u := Unit { key: key, text: text, facts: facts, regs: regs };
    want := sum(&u);
    if want.len() != check.len() {
        return none();
    }
    for i in want.len() {
        if want[i] != check[i] {
            return none();
        }
    }
    return u;
}

fn path<a, b>(dir: &a [u8], name: &b [u8]) -> u8[] {
    mut out = dir.copy();
    out.push(47);
    for i in name.len() {
        out.push(name[i]);
    }
    return out;
}

// ---- last use ----------------------------------------------------------------------------------
//
// Which entries a run used is written once per run, not once per entry: `used/` holds files of
// `GENERATION NAME` lines, one file per compiler run (or optimiser piece), named by the hash of what
// it holds. The generation is the store's build counter (the `generation` file one level above this
// directory, which every build that opens the store raises). `grail cache gc` reads them to find
// each entry's last use and evicts the least recently used first (compiler/cli.grl, cache_gc).
pub fn note_used<a, b>(dir: &a [u8], names: (&b u8[][])) -> unit {
    if (dir.len() == 0) || (names.len() == 0) {
        return ();
    }
    // `dir` is `<store root>/fn`: the generation lives in the root.
    mut root_end = dir.len();
    while (0 < root_end) && (dir[root_end - 1] != 47) {
        root_end -= 1;
    }
    mut gen_text = u8[];
    if 0 < root_end {
        gen_file := path(dir[0..root_end - 1], view("generation"));
        if host::exists(view(gen_file)) != 0 {
            gen_text = host::read_file(view(gen_file));
        }
    }
    mut gen = u8[];
    for i in gen_text.len() {
        if (47 < gen_text[i]) && (gen_text[i] < 58) {
            gen.push(gen_text[i]);
        }
    }
    if gen.len() == 0 {
        gen.push(48);
    }
    mut text = u8[];
    for i in names.len() {
        text.append(view(gen));
        text.push(32);
        text.append(view(names[i]));
        text.push(10);
    }
    ensure(view(dir));
    used := path(view(dir), view("used"));
    if host::exists(view(used)) == 0 {
        host::mkdir(view(used));
    }
    name := hash(view(text));
    staged := path(path(view(dir), view("stage")), view(cat_used(view(name))));
    if host::write_file(view(staged), view(text)) != 0 {
        host::remove(view(staged), 0);
        return ();
    }
    if host::rename(view(staged), view(path(view(used), view(name)))) != 0 {
        host::remove(view(staged), 0);
    }
    return ();
}

fn cat_used<a>(name: &a [u8]) -> u8[] {
    mut out = u8[];
    out.append(view("used."));
    out.append(name);
    return out;
}

pub fn ensure<a>(dir: &a [u8]) -> unit {
    if host::exists(view(dir)) == 0 {
        host::mkdir(view(dir));
    }
    stage := path(view(dir), view("stage"));
    if host::exists(view(stage)) == 0 {
        host::mkdir(view(stage));
    }
    return ();
}

// The entry filed under `name`, or no unit when there is none, when it does not decode, or when it
// was filed under a different key record.
pub fn load<a, b>(dir: &a [u8], name: &b [u8]) -> Unit {
    file := path(view(dir), view(name));
    if host::exists(view(file)) == 0 {
        return none();
    }
    text := host::read_file(view(file));
    return decode(text);
}

// A check's load: a full unit or a check unit - one with no text, which a check files (a check
// writes no assembly) and a build's `load` refuses, so a build after a check compiles that body.
pub fn load_checked<a, b>(dir: &a [u8], name: &b [u8]) -> Unit {
    file := path(view(dir), view(name));
    if host::exists(view(file)) == 0 {
        return none();
    }
    return decode_piped(host::read_file(view(file)));
}

// File a unit under `name`: written into `stage/`, then renamed into place, so no reader can see a
// half entry.
// The directory and its `stage/` are made once per run (`ensure`, from the run's set-up), not here:
// a cold compile saves a unit per function, and two existence checks each were a third of the
// store's system calls.
pub fn save<a, b, d>(dir: &a [u8], name: &b [u8], u: (&d Unit)) -> unit {
    bytes := encode(u);
    stage := path(path(view(dir), view("stage")), view(name));
    if host::write_file(view(stage), view(bytes)) != 0 {
        host::remove(view(stage), 0);
        return ();
    }
    if host::rename(view(stage), view(path(view(dir), view(name)))) != 0 {
        host::remove(view(stage), 0);
    }
    return ();
}

// ---- Packs (docs/design/incremental-compilation.md, "Per-function units") ----------------------
// One file per module run instead of one per function: a cold compile of a 4000-function module
// filed 16k entries, and their creates and renames were more than half of a cold check. A pack is
//
//     "GPK1" count:VAR { name:VAR offset:VAR length:VAR }* entries...
//
// where each entry is one unit's bytes exactly as a one-file entry holds them (so `decode` checks it
// the same way) and the offsets count from the start of the file. It is written once, at the end
// of the run, to `stage/` and renamed over the module's previous pack: a reader sees the old pack
// or the new one, never part of either. The run reads its module's pack once, before any body.
pub struct Pack {
    names: u8[][],
    offs: u64[],
    lens: u64[],
    data: u8[],
    slots: u64[]
}

pub fn pack_none() -> Pack {
    return Pack { names: u8[][], offs: u64[], lens: u64[], data: u8[], slots: u64[] };
}

fn same_bytes<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}

// A unit's name is a hash printed in hex: its first sixteen digits are already well mixed.
fn name_bits<a>(name: &a [u8]) -> u64 {
    mut v = 0;
    mut n = name.len();
    if 16 < n {
        n = 16;
    }
    for i in n {
        d := name[i];
        mut x = 0;
        if (47 < d) & (d < 58) {
            x = d - 48;
        } else if (96 < d) & (d < 103) {
            x = d - 87;
        }
        v = (v << 4) | x;
    }
    return v;
}

// An open-addressed table over `names`: slot holds index + 1, 0 is empty.
pub fn index_find<a, b, d>(slots: (&a u64[]), names: (&b u8[][]), name: &d [u8]) -> u64 {
    if slots.len() == 0 {
        return 0;
    }
    mask := slots.len() - 1;
    mut at = name_bits(name) & mask;
    loop {
        s := slots[at];
        if s == 0 {
            return 0;
        }
        if same_bytes(view(names[s - 1]), name) {
            return s;
        }
        at = (at + 1) & mask;
    }
}

pub fn index_put<a, b>(slots: (&a mut u64[]), names: (&b u8[][]), i: u64) -> unit {
    // Grown to keep the table at most half full.
    if slots.len() < (names.len() + 1) * 2 {
        mut size = 1024;
        while size < (names.len() + 1) * 2 {
            size = size * 2;
        }
        exchange(&mut slots, u64[]);
        for k in size {
            slots.push(0);
        }
        for j in names.len() {
            if j != i {
                put_slot(&mut slots, view(names[j]), j);
            }
        }
    }
    put_slot(&mut slots, view(names[i]), i);
    return ();
}

fn put_slot<a, b>(slots: (&a mut u64[]), name: &b [u8], i: u64) -> unit {
    mask := slots.len() - 1;
    mut at = name_bits(name) & mask;
    while slots[at] != 0 {
        at = (at + 1) & mask;
    }
    slots[at] = i + 1;
    return ();
}

// The pack filed under `name`, or an empty one when there is none or it does not parse.
pub fn pack_read<a, b>(dir: &a [u8], name: &b [u8]) -> Pack {
    file := path(view(dir), view(name));
    if host::exists(view(file)) == 0 {
        return pack_none();
    }
    mut r = Read { data: host::read_file(view(file)), at: 0, ok: 1 };
    if (r.data.len() < 4) || (r.data[0] != 71) || (r.data[1] != 80) || (r.data[2] != 75) || (r.data[3] != 49) {
        return pack_none();
    }
    r.at = 4;
    count := rv(&mut r);
    mut p = pack_none();
    for i in count {
        n := rs(&mut r);
        off := rv(&mut r);
        len := rv(&mut r);
        if (r.ok == 0) || (r.data.len() < off) || ((r.data.len() - off) < len) {
            return pack_none();
        }
        p.names.push(n);
        p.offs.push(off);
        p.lens.push(len);
    }
    exchange(&mut p.data, exchange(&mut r.data, u8[]));
    for i in p.names.len() {
        index_put(&mut p.slots, &p.names, i);
    }
    return p;
}

// The bytes of the unit filed in `p` under `name`, or empty.
pub fn pack_get<a, b>(p: (&a Pack), name: &b [u8]) -> u8[] {
    s := index_find(&p.slots, &p.names, name);
    if s == 0 {
        return u8[];
    }
    off := p.offs[s - 1];
    mut out = u8[];
    out.append(p.data[off..off + p.lens[s - 1]]);
    return out;
}

// Files a pack of `names`, whose bytes are `data[offs[i]..offs[i] + lens[i]]`, under `name`.
pub fn pack_write<a, b, d, e, f, g>(dir: &a [u8], name: &b [u8], names: (&d u8[][]), offs: (&e u64[]), lens: (&f u64[]), data: &g [u8]) -> unit {
    // The header first, to know where the entries start.
    mut head = u8[];
    head.push(71);
    head.push(80);
    head.push(75);
    head.push(49);
    wv(&mut head, names.len());
    // Offsets depend on the header's own length; widths are fixed at ten bytes (LEB128 can carry
    // padding as 0x80 continuation bytes) so the header can be laid out in one pass.
    mut sizes = 0;
    for i in names.len() {
        sizes = sizes + 1 + names[i].len() + 20;
        if 127 < names[i].len() {
            sizes = sizes + 1;
        }
    }
    base := head.len() + sizes;
    for i in names.len() {
        ws(&mut head, view(names[i]));
        wv10(&mut head, base + offs[i]);
        wv10(&mut head, lens[i]);
    }
    head.append(data);
    file := path(view(dir), view(name));
    stage := path(path(view(dir), view("stage")), view(name));
    if host::write_file(view(stage), view(head)) != 0 {
        host::remove(view(stage), 0);
        return ();
    }
    if host::rename(view(stage), view(file)) != 0 {
        host::remove(view(stage), 0);
    }
    return ();
}

// A number in exactly ten LEB128 bytes (continuation bits set on the first nine).
fn wv10<a>(out: (&a mut u8[]), n: u64) -> unit {
    mut v = n;
    for i in 9 {
        out.push((v & 127) | 128);
        v = v >> 7;
    }
    out.push(v & 1);
    return ();
}
