unsafe module runtime;

// Win32 OS boundary for `--target windows-x86_64`. Same operation IDs as `os-linux.grl`, so the
// portable runtime above it is unchanged. Calls into kernel32 use the Win64 ABI through raw_win32,
// which the compiler emits with caller shadow space and stack arguments.

// Process state scratch below the allocator's 4 KiB state block: bytes transferred, GetLastError
// and other small results. Never allocated, so consultations cost no user allocation.
fn rt_win_scratch() -> u64 {
    return raw_state() + 3840;
}
fn rt_win_std_handle(which: u64) -> u64 {
    return raw_win32(GetStdHandle, which);
}
// File descriptors 0..2 are the console; any other value is already a Win32 HANDLE.
fn rt_win_handle(fd: u64) -> u64 {
    if fd == 0 {
        return rt_win_std_handle(wrapping_sub(0, 10));
    }
    if fd == 1 {
        return rt_win_std_handle(wrapping_sub(0, 11));
    }
    if fd == 2 {
        return rt_win_std_handle(wrapping_sub(0, 12));
    }
    return fd;
}
fn rt_win_read(handle: u64, buf: u64, len: u64) -> u64 {
    if handle == 0 {
        return wrapping_sub(0, 9);
    }
    scratch := rt_win_scratch();
    raw_store(scratch, 0);
    if raw_win32(ReadFile, handle, buf, len, scratch, 0) == 0 {
        return wrapping_sub(0, 5);
    }
    return raw_load(scratch);
}
fn rt_win_write(handle: u64, buf: u64, len: u64) -> u64 {
    if handle == 0 {
        return wrapping_sub(0, 9);
    }
    scratch := rt_win_scratch();
    raw_store(scratch, 0);
    if raw_win32(WriteFile, handle, buf, len, scratch, 0) == 0 {
        return wrapping_sub(0, 5);
    }
    return raw_load(scratch);
}
// Linux open(2) flags map onto CreateFileA access and disposition bits.
fn rt_win_open(path: u64, flags: u64, mode: u64) -> u64 {
    mut access = 2147483648; // GENERIC_READ
    if (flags & 3) == 1 {
        access = 1073741824; // GENERIC_WRITE
    }
    if (flags & 3) == 2 {
        access = 3221225472; // GENERIC_READ|GENERIC_WRITE
    }
    mut disposition = 3; // OPEN_EXISTING
    if (flags & 64) + (flags & 512) != 0 {
        disposition = 2; // CREATE_ALWAYS
    }
    handle := raw_win32(CreateFileA, path, access, 3, 0, disposition, 128, 0);
    if handle == wrapping_sub(0, 1) {
        return wrapping_sub(0, 2);
    }
    return handle;
}
fn rt_win_close(handle: u64) -> u64 {
    if raw_win32(CloseHandle, handle) == 0 {
        return wrapping_sub(0, 9);
    }
    return 0;
}
fn rt_win_unmap(address: u64) -> u64 {
    if raw_win32(VirtualFree, address, 0, 32768) == 0 {
        return wrapping_sub(0, 22);
    }
    return 0;
}
fn rt_win_mkdir(name: u64, mode: u64) -> u64 {
    if raw_win32(CreateDirectoryA, name, 0) != 0 {
        return 0;
    }
    if raw_win32(GetLastError) == 183 {
        return wrapping_sub(0, 17); // EEXXIST: the portable caller treats it as success
    }
    return wrapping_sub(0, 1);
}
fn rt_win_remove(name: u64, flags: u64) -> u64 {
    if (flags & 512) != 0 {
        if raw_win32(RemoveDirectoryA, name) != 0 {
            return 0;
        }
        return wrapping_sub(0, 21);
    }
    if raw_win32(DeleteFileA, name) != 0 {
        return 0;
    }
    return wrapping_sub(0, 2);
}
// Sleep takes milliseconds; the portable caller passes a Linux timespec {sec, nsec}.
fn rt_win_sleep(spec: u64) -> u64 {
    ms := raw_load(spec) * 1000 + rt_div(raw_load(spec + 8), 1000000);
    raw_win32(Sleep, ms);
    return 0;
}
// Monotonic milliseconds from GetTickCount64, reported as a timespec. Only CLOCK_MONOTONIC is
// requested by the portable runtime today, so the clock id is not consulted.
fn rt_win_clock(spec: u64) -> u64 {
    ms := raw_win32(GetTickCount64);
    raw_store(spec, rt_div(ms, 1000));
    raw_store(spec + 8, (ms % 1000) * 1000000);
    return 0;
}
fn rt_syscall(n: u64, a: u64, b: u64, c: u64) -> u64 {
    if n == 0 {
        return rt_win_read(rt_win_handle(a), b, c);
    }
    if n == 1 {
        return rt_win_write(rt_win_handle(a), b, c);
    }
    if n == 2 {
        return rt_win_open(a, b, c);
    }
    if n == 3 {
        return rt_win_close(a);
    }
    if n == 10 {
        return 0;
    }
    if n == 11 {
        return rt_win_unmap(a);
    }
    if n == 24 {
        raw_win32(SwitchToThread);
        return 0;
    }
    if n == 35 {
        return rt_win_sleep(a);
    }
    if n == 39 {
        return raw_win32(GetCurrentProcessId);
    }
    if n == 60 {
        return raw_win32(ExitProcess, a);
    }
    if n == 231 {
        return raw_win32(ExitProcess, a & 255);
    }
    if n == 62 {
        return 0;
    }
    if n == 202 {
        return 0;
    }
    if n == 228 {
        return rt_win_clock(b);
    }
    if n == 258 {
        return rt_win_mkdir(b, c);
    }
    if n == 263 {
        return rt_win_remove(b, c);
    }
    // Threads, sockets, epoll, futex and directory streams are not implemented for PE yet.
    return wrapping_sub(0, 38);
}
fn rt_syscall4(n: u64, a: u64, b: u64, c: u64, d: u64) -> u64 {
    if n == 25 {
        return wrapping_sub(0, 38); // mremap
    }
    return wrapping_sub(0, 38);
}
fn rt_readlinkat(path: u64, buf: u64, size: u64) -> u64 {
    return wrapping_sub(0, 38);
}
fn rt_faccessat(path: u64) -> u64 {
    if raw_win32(GetFileAttributesA, path) == 4294967295 {
        return wrapping_sub(0, 2);
    }
    return 0;
}
fn rt_accept4(fd: u64) -> u64 {
    return wrapping_sub(0, 38);
}
// Splits a copy of the Win32 command line into a NUL-terminated argv array. Backslash and quote
// handling follows the CommandLineToArgv rules the C runtime uses.
fn rt_win_split(buf: u64, table: u64) -> u64 {
    mut count = 0;
    mut i = 0;
    while raw_byte(buf + i) != 0 {
        while (raw_byte(buf + i) == 32) + (raw_byte(buf + i) == 9) {
            i = i + 1;
        }
        if raw_byte(buf + i) == 0 {
            break;
        }
        raw_store(table + count * 8, buf + i);
        count = count + 1;
        mut w = i;
        mut quoted = 0;
        while 1 {
            b := raw_byte(buf + i);
            if b == 0 {
                break;
            }
            if b == 92 {
                mut slashes = 0;
                while raw_byte(buf + i) == 92 {
                    slashes = slashes + 1;
                    i = i + 1;
                }
                if raw_byte(buf + i) == 34 {
                    mut k = 0;
                    while k < slashes / 2 {
                        raw_putbyte(buf + w, 92);
                        w = w + 1;
                        k = k + 1;
                    }
                    if (slashes % 2) == 1 {
                        raw_putbyte(buf + w, 34);
                        w = w + 1;
                        i = i + 1;
                    }
                } else {
                    mut k = 0;
                    while k < slashes {
                        raw_putbyte(buf + w, 92);
                        w = w + 1;
                        k = k + 1;
                    }
                }
            } else {
                if b == 34 {
                    quoted = 1 - quoted;
                    i = i + 1;
                } else {
                    if ((b == 32) + (b == 9)) & (quoted == 0) {
                        break;
                    }
                    raw_putbyte(buf + w, b);
                    w = w + 1;
                    i = i + 1;
                }
            }
        }
        // The delimiter is overwritten by the terminator, so read it before writing.
        delimiter := raw_byte(buf + i);
        raw_putbyte(buf + w, 0);
        if delimiter != 0 {
            i = i + 1;
        }
    }
    raw_store(table + count * 8, 0);
    return count;
}
// Process setup for the PE entry: argv from GetCommandLineA, envp from GetEnvironmentStringsA.
// Both live in untracked mappings so they do not count as user allocations at shutdown.
fn rt_os_init() -> u64 {
    line := raw_win32(GetCommandLineA);
    mut length = 0;
    while raw_byte(line + length) != 0 {
        length = length + 1;
    }
    buf := raw_map(65536);
    if rt_error(buf) {
        return 1;
    }
    mut i = 0;
    while i < length {
        raw_putbyte(buf + i, raw_byte(line + i));
        i = i + 1;
    }
    raw_putbyte(buf + length, 0);
    table := raw_map(4096);
    if rt_error(table) {
        return 1;
    }
    raw_store(raw_state(), rt_win_split(buf, table));
    raw_store(raw_state() + 8, table);
    env := raw_win32(GetEnvironmentStringsA);
    envtable := raw_map(8192);
    if rt_error(envtable) {
        return 1;
    }
    mut count = 0;
    mut p = env;
    while (p != 0) & (raw_byte(p) != 0) {
        raw_store(envtable + count * 8, p);
        count = count + 1;
        while raw_byte(p) != 0 {
            p = p + 1;
        }
        p = p + 1;
    }
    raw_store(envtable + count * 8, 0);
    raw_store(raw_state() + 16, envtable);
    return 0;
}
