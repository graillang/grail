unsafe module runtime;

// Win32 OS boundary for `--target windows-x86_64`. Same operation IDs as `os-linux.grl`, so the
// portable runtime above it is unchanged. Calls into kernel32 use the Win64 ABI through raw_win32,
// which the compiler emits with caller shadow space and stack arguments.

// Process state scratch below the allocator's 4 KiB state block: bytes transferred, GetLastError
// and other small results. Never allocated, so consultations cost no user allocation.
fn rt_win_scratch() -> u64 {
    return raw_state() + 3840;
}
fn rt_win_std_handle(which: u64) -> u64 {
    return raw_win32(GetStdHandle, which);
}
// File descriptors 0..2 are the console; any other value is already a Win32 HANDLE.
fn rt_win_handle(fd: u64) -> u64 {
    if fd == 0 {
        return rt_win_std_handle(wrapping_sub(0, 10));
    }
    if fd == 1 {
        return rt_win_std_handle(wrapping_sub(0, 11));
    }
    if fd == 2 {
        return rt_win_std_handle(wrapping_sub(0, 12));
    }
    return fd;
}
fn rt_win_read(handle: u64, buf: u64, len: u64) -> u64 {
    if handle == 0 {
        return wrapping_sub(0, 9);
    }
    scratch := rt_win_scratch();
    raw_store(scratch, 0);
    if raw_win32(ReadFile, handle, buf, len, scratch, 0) == 0 {
        return wrapping_sub(0, 5);
    }
    return raw_load(scratch);
}
fn rt_win_write(handle: u64, buf: u64, len: u64) -> u64 {
    if handle == 0 {
        return wrapping_sub(0, 9);
    }
    scratch := rt_win_scratch();
    raw_store(scratch, 0);
    if raw_win32(WriteFile, handle, buf, len, scratch, 0) == 0 {
        return wrapping_sub(0, 5);
    }
    return raw_load(scratch);
}
// Linux open(2) flags map onto CreateFileA access and disposition bits.
// The last Win32 error as the negated Linux errno the portable layers (lib/io.grl) understand.
// Unmapped codes keep their Win32 value above 0x10000, so io::Error::Other never confuses a
// Win32 code with an errno.
fn rt_win_errno() -> u64 {
    code := raw_win32(GetLastError);
    mut errno = 65536 + code;
    if (code == 2) + (code == 3) + (code == 15) + (code == 161) {
        errno = 2; // FILE/PATH_NOT_FOUND, INVALID_DRIVE, BAD_PATHNAME -> ENOENT
    }
    if (code == 5) + (code == 19) + (code == 32) + (code == 33) {
        errno = 13; // ACCESS_DENIED, WRITE_PROTECT, SHARING/LOCK_VIOLATION -> EACCES
    }
    if (code == 80) + (code == 183) {
        errno = 17; // FILE_EXISTS, ALREADY_EXISTS -> EEXIST
    }
    if code == 267 {
        errno = 20; // DIRECTORY (not a directory) -> ENOTDIR
    }
    if code == 145 {
        errno = 39; // DIR_NOT_EMPTY -> ENOTEMPTY
    }
    if (code == 87) + (code == 123) {
        errno = 22; // INVALID_PARAMETER, INVALID_NAME -> EINVAL
    }
    if code == 8 {
        errno = 12; // NOT_ENOUGH_MEMORY -> ENOMEM
    }
    return wrapping_sub(0, errno);
}
fn rt_win_open(path: u64, flags: u64, mode: u64) -> u64 {
    mut access = 2147483648; // GENERIC_READ
    if (flags & 3) == 1 {
        access = 1073741824; // GENERIC_WRITE
    }
    if (flags & 3) == 2 {
        access = 3221225472; // GENERIC_READ|GENERIC_WRITE
    }
    mut disposition = 3; // OPEN_EXISTING
    if (flags & 64) + (flags & 512) != 0 {
        disposition = 2; // CREATE_ALWAYS
    }
    handle := raw_win32(CreateFileA, path, access, 3, 0, disposition, 128, 0);
    if handle == wrapping_sub(0, 1) {
        return rt_win_errno();
    }
    return handle;
}
fn rt_win_close(handle: u64) -> u64 {
    if raw_win32(CloseHandle, handle) == 0 {
        return wrapping_sub(0, 9);
    }
    return 0;
}
fn rt_win_unmap(address: u64) -> u64 {
    if raw_win32(VirtualFree, address, 0, 32768) == 0 {
        return wrapping_sub(0, 22);
    }
    return 0;
}
fn rt_win_mkdir(name: u64, mode: u64) -> u64 {
    if raw_win32(CreateDirectoryA, name, 0) != 0 {
        return 0;
    }
    return rt_win_errno(); // EEXIST for an existing directory, which the portable caller accepts
}
fn rt_win_remove(name: u64, flags: u64) -> u64 {
    if (flags & 512) != 0 {
        if raw_win32(RemoveDirectoryA, name) != 0 {
            return 0;
        }
        return rt_win_errno();
    }
    if raw_win32(DeleteFileA, name) != 0 {
        return 0;
    }
    return rt_win_errno();
}
// Sleep takes milliseconds; the portable caller passes a Linux timespec {sec, nsec}.
fn rt_win_sleep(spec: u64) -> u64 {
    ms := raw_load(spec) * 1000 + rt_div(raw_load(spec + 8), 1000000);
    raw_win32(Sleep, ms);
    return 0;
}
// Monotonic milliseconds from GetTickCount64, reported as a timespec. Only CLOCK_MONOTONIC is
// requested by the portable runtime today, so the clock id is not consulted.
fn rt_win_clock(spec: u64) -> u64 {
    ms := raw_win32(GetTickCount64);
    raw_store(spec, rt_div(ms, 1000));
    raw_store(spec + 8, (ms % 1000) * 1000000);
    return 0;
}
// Abort's last step. TerminateProcess runs no DLL detach handlers, no atexit handlers and no C++
// static destructors; ExitProcess (the normal exit path, operation 60) does run them, so abort never
// uses it. (HANDLE)-1 is the current process pseudo-handle.
fn rt_hard_exit(code: u64) -> u64 {
    raw_win32(TerminateProcess, wrapping_sub(0, 1), code);
    return 0;
}
fn rt_syscall(n: u64, a: u64, b: u64, c: u64) -> u64 {
    if n == 0 {
        return rt_win_read(rt_win_handle(a), b, c);
    }
    if n == 1 {
        return rt_win_write(rt_win_handle(a), b, c);
    }
    if n == 2 {
        return rt_win_open(a, b, c);
    }
    if n == 3 {
        return rt_win_close(a);
    }
    if n == 10 {
        return 0;
    }
    if n == 11 {
        rt_win_reap(a);
        return rt_win_unmap(a);
    }
    if n == 24 {
        raw_win32(SwitchToThread);
        return 0;
    }
    if n == 35 {
        return rt_win_sleep(a);
    }
    if n == 39 {
        return raw_win32(GetCurrentProcessId);
    }
    if n == 60 {
        return raw_win32(ExitProcess, a);
    }
    if n == 231 {
        return raw_win32(ExitProcess, a & 255);
    }
    if n == 62 {
        return 0;
    }
    if n == 202 {
        // Linux futex encoding: FUTEX_WAKE is op bit 0, FUTEX_PRIVATE_FLAG is bit 7.
        if (b & 128) == 0 {
            return rt_win_join_wait(a);
        }
        if (b & 1) != 0 {
            return rt_win_wake(a, c);
        }
        return rt_win_wait(a, c);
    }
    if n == 228 {
        return rt_win_clock(b);
    }
    if n == 258 {
        return rt_win_mkdir(b, c);
    }
    if n == 293 {
        // `a` is the caller's two-word pair: CreatePipe writes the read and the write handle.
        return rt_win_pipe(a);
    }
    if n == 263 {
        return rt_win_remove(b, c);
    }
    // Threads, sockets, epoll, futex and directory streams are not implemented for PE yet.
    return wrapping_sub(0, 38);
}
// Windows has no mremap(2): a grow moves the payload to a fresh mapping and releases the old one,
// the way the Darwin module does it. rt_grow keeps every block of 512 KiB or more in a mapping of
// its own and grows it in place, so without this a vector or string cannot pass that size at all -
// the compiler's own token tables do, which is what made a PE host unable to compile anything larger
// than a toy program.
fn rt_win_remap(old: u64, oldsize: u64, newsize: u64) -> u64 {
    fresh := raw_map(newsize);
    if (fresh == 0) || rt_error(fresh) {
        return wrapping_sub(0, 12); // ENOMEM, as mremap reports it
    }
    mut n = oldsize;
    if newsize < n {
        n = newsize;
    }
    rt_copy_bytes(fresh, old, n);
    rt_win_unmap(old);
    return fresh;
}
fn rt_syscall4(n: u64, a: u64, b: u64, c: u64, d: u64) -> u64 {
    if n == 25 {
        return rt_win_remap(a, b, c);
    }
    return wrapping_sub(0, 38);
}
// The current directory: GetCurrentDirectoryA writes it and returns its length in characters.
fn rt_cwd(buf: u64, size: u64) -> u64 {
    n := raw_win32(GetCurrentDirectoryA, size - 1, buf);
    if n == 0 {
        return wrapping_sub(0, rt_win_errno());
    }
    raw_putbyte(buf + n, 0);
    return n;
}
// The running image: GetModuleFileNameA writes its full path, and the return value is its length.
fn rt_exe_path(buf: u64, size: u64) -> u64 {
    n := raw_win32(GetModuleFileNameA, 0, buf, size - 1);
    if n == 0 {
        return rt_win_errno();
    }
    raw_putbyte(buf + n, 0);
    return n;
}
fn rt_readlinkat(path: u64, buf: u64, size: u64) -> u64 {
    return wrapping_sub(0, 38);
}
fn rt_faccessat(path: u64) -> u64 {
    if raw_win32(GetFileAttributesA, path) == 4294967295 {
        return wrapping_sub(0, 2);
    }
    return 0;
}
fn rt_accept4(fd: u64) -> u64 {
    return wrapping_sub(0, 38);
}

// ---- file metadata, rename, and a spawn that redirects stdio -----------------------------------
// The Win32 half of the operations os-linux.grl implements with newfstatat, renameat and a
// fork/exec with dup3. A descriptor above 2 is already a HANDLE here (rt_win_handle), which is what
// the redirected spawn hands to CreateProcess.

// FILETIMEs count 100-nanosecond ticks from 1601-01-01 UTC; Unix time starts 11644473600 seconds
// later. A time before 1970 wraps, which is exactly how the runtime spells a negative second count.
fn rt_win_ticks(at: u64) -> u64 {
    high := raw_load(at + 4) & 4294967295;
    low := raw_load(at) & 4294967295;
    return high * 4294967296 + low;
}
fn rt_win_unix_seconds(at: u64) -> u64 {
    return wrapping_sub(rt_div(rt_win_ticks(at), 10000000), 11644473600);
}
fn rt_win_unix_nanos(at: u64) -> u64 {
    return (rt_win_ticks(at) & 9999999) * 100;
}
// The kind of an entry from its attributes: FILE_ATTRIBUTE_DIRECTORY and FILE_ATTRIBUTE_REPARSE_POINT
// (a symbolic link or a junction) are the two the standard library distinguishes.
fn rt_win_kind(attributes: u64) -> u64 {
    if (attributes & 16) != 0 {
        return 2;
    }
    if (attributes & 1024) != 0 {
        return 3;
    }
    return 1;
}
// GetFileAttributesExA, whose WIN32_FILE_ATTRIBUTE_DATA is 36 bytes: attributes at 0, last access at
// 12, last write at 20, size high at 28 and size low at 32. Windows has no POSIX permission bits, no
// owner and no inode, so those fields are 0; both `follow` values report the entry itself, which is
// what a reparse point's attributes describe.
fn rt_stat(path: u64, follow: u64, fields: u64) -> u64 {
    data := rt_alloc(64);
    if raw_win32(GetFileAttributesExA, path, 0, data) == 0 {
        errno := rt_win_errno();
        rt_free(data);
        return errno;
    }
    rt_push(fields, 0); // the errno slot: this call succeeded
    attributes := raw_load(data) & 4294967295;
    size_high := raw_load(data + 28) & 4294967295;
    size_low := raw_load(data + 32) & 4294967295;
    rt_push(fields, rt_win_kind(attributes));
    rt_push(fields, size_high * 4294967296 + size_low);
    rt_push(fields, 0);
    rt_push(fields, rt_win_unix_seconds(data + 20));
    rt_push(fields, rt_win_unix_nanos(data + 20));
    rt_push(fields, rt_win_unix_seconds(data + 12));
    rt_push(fields, rt_win_unix_nanos(data + 12));
    rt_push(fields, 0);
    rt_push(fields, 0);
    rt_push(fields, 0);
    rt_push(fields, 0);
    rt_free(data);
    return 0;
}
// CreateSymbolicLinkA: a symbolic link to a file (flag 0) - Windows decides junctions for
// directories itself, so a link to a directory needs the privilege the platform asks for.
fn rt_symlink(target: u64, link: u64) -> u64 {
    if raw_win32(CreateSymbolicLinkA, link, target, 0) == 0 {
        return rt_win_errno();
    }
    return 0;
}
// MoveFileExA with MOVEFILE_REPLACE_EXISTING: the destination file is replaced, a directory is only
// renamed when it is absent, and 0 or a positive errno comes back.
fn rt_rename(from: u64, to: u64) -> u64 {
    if raw_win32(MoveFileExA, from, to, 1) == 0 {
        return rt_win_errno();
    }
    return 0;
}
// Waits for the process handle `pid` (what rt_spawn_redirect answers) and closes it. Windows has no
// signals, so the status is always an exit code in the wait4 position - `code << 8` - which keeps one
// decoder for every platform.
// Windows has no fork: a caller that can do its work in one process does.
fn rt_fork() -> u64 {
    return wrapping_sub(0, 38);
}
fn rt_wait_pid(pid: u64) -> u64 {
    scratch := rt_win_scratch();
    raw_store(scratch, 0);
    raw_win32(WaitForSingleObject, pid, 4294967295);
    if raw_win32(GetExitCodeProcess, pid, scratch) == 0 {
        errno := rt_win_errno();
        raw_win32(CloseHandle, pid);
        return wrapping_sub(0, errno);
    }
    code := raw_load(scratch) & 255;
    raw_win32(CloseHandle, pid);
    return code * 256;
}
// CreateProcessA with STARTF_USESTDHANDLES: the STARTUPINFOA's hStdInput/hStdOutput/hStdError (at 80,
// 88 and 96) name the child's standard handles and bInheritHandles is set, so a descriptor the caller
// opened is the child's stdout or stderr. The answer is the process handle, or a wrapped negative
// errno; rt_wait_pid closes it.
fn rt_spawn_redirect(paths: u64, argv: u64, envp: u64, out_fd: u64, err_fd: u64) -> u64 {
    if raw_target() == 4 {
        // windows-aarch64: the ARM64 Win32 call path passes seven register arguments and
        // CreateProcessA needs ten, so it is reported as unimplemented instead of mis-called.
        return wrapping_sub(0, 38);
    }
    mut size = 1;
    mut count = 0;
    while raw_load(argv + count * 8) != 0 {
        p := raw_load(argv + count * 8);
        mut n = 0;
        while raw_byte(p + n) != 0 {
            n += 1;
        }
        size += n * 2 + 4;
        count += 1;
    }
    line := rt_alloc(size);
    mut at = 0;
    mut i = 0;
    while i < count {
        if i != 0 {
            raw_putbyte(line + at, 32);
            at += 1;
        }
        at = rt_win_quote(line, at, raw_load(argv + i * 8));
        i += 1;
    }
    raw_putbyte(line + at, 0);
    mut block = 0;
    if envp != 0 {
        block = rt_win_env_block(envp);
    }
    startup := rt_alloc(128);
    info := rt_alloc(32);
    i = 0;
    while i < 128 {
        raw_store(startup + i, 0);
        i += 8;
    }
    i = 0;
    while i < 32 {
        raw_store(info + i, 0);
        i += 8;
    }
    raw_store(startup, 104);
    raw_store(startup + 60, 256); // STARTF_USESTDHANDLES
    raw_store(startup + 80, rt_win_handle(0));
    raw_store(startup + 88, rt_win_handle(out_fd));
    raw_store(startup + 96, rt_win_handle(err_fd));
    started := raw_win32(CreateProcessA, 0, line, 0, 0, 1, 0, block, 0, startup, info);
    mut result = wrapping_sub(0, 22);
    if started == 0 {
        result = wrapping_sub(0, rt_win_errno());
    } else {
        raw_win32(CloseHandle, raw_load(info + 8)); // the thread handle is not needed
        result = raw_load(info); // the process handle: the child's id
    }
    rt_free(line);
    rt_free(startup);
    rt_free(info);
    if block != 0 {
        rt_free(block);
    }
    return result;
}
// CreatePipe: two inheritable handles, because a child only inherits what its STARTUPINFO names when
// the handle itself allows it. Fills the caller's two-word pair with the read and the write end.
// Whether a pipe handle has data or has been closed by its writer, within `timeout_ms`.
fn rt_ready(fd: u64, timeout_ms: u64) -> u64 {
    r := raw_win32(WaitForSingleObject, rt_win_handle(fd), timeout_ms);
    if r == 0 {
        return 1;
    }
    if r == 258 {
        return 0; // WAIT_TIMEOUT
    }
    if r == 4294967295 {
        return wrapping_sub(0, rt_win_errno()); // WAIT_FAILED
    }
    return 1; // WAIT_ABANDONED: treat it as readable and let the read report what happened
}
// The two handles CreatePipe wrote into `pair`.
fn rt_pipe_push(pair: u64, out: u64) -> u64 {
    rt_push(out, raw_load(pair));
    rt_push(out, raw_load(pair + 8));
    return 0;
}
fn rt_win_pipe(pair: u64) -> u64 {
    attributes := rt_alloc(32);
    raw_store(attributes, 24); // nLength
    raw_store(attributes + 8, 1); // bInheritHandle
    if raw_win32(CreatePipe, pair, pair + 8, attributes, 0) == 0 {
        errno := rt_win_errno();
        rt_free(attributes);
        return wrapping_sub(0, errno);
    }
    rt_free(attributes);
    return 0;
}
// Splits a copy of the Win32 command line into a NUL-terminated argv array. Backslash and quote
// handling follows the CommandLineToArgv rules the C runtime uses.
fn rt_win_split(buf: u64, table: u64) -> u64 {
    mut count = 0;
    mut i = 0;
    while raw_byte(buf + i) != 0 {
        while (raw_byte(buf + i) == 32) + (raw_byte(buf + i) == 9) {
            i = i + 1;
        }
        if raw_byte(buf + i) == 0 {
            break;
        }
        raw_store(table + count * 8, buf + i);
        count = count + 1;
        mut w = i;
        mut quoted = 0;
        while 1 {
            b := raw_byte(buf + i);
            if b == 0 {
                break;
            }
            if b == 92 {
                mut slashes = 0;
                while raw_byte(buf + i) == 92 {
                    slashes = slashes + 1;
                    i = i + 1;
                }
                if raw_byte(buf + i) == 34 {
                    mut k = 0;
                    while k < slashes / 2 {
                        raw_putbyte(buf + w, 92);
                        w = w + 1;
                        k = k + 1;
                    }
                    if (slashes % 2) == 1 {
                        raw_putbyte(buf + w, 34);
                        w = w + 1;
                        i = i + 1;
                    }
                } else {
                    mut k = 0;
                    while k < slashes {
                        raw_putbyte(buf + w, 92);
                        w = w + 1;
                        k = k + 1;
                    }
                }
            } else {
                if b == 34 {
                    quoted = 1 - quoted;
                    i = i + 1;
                } else {
                    if ((b == 32) + (b == 9)) & (quoted == 0) {
                        break;
                    }
                    raw_putbyte(buf + w, b);
                    w = w + 1;
                    i = i + 1;
                }
            }
        }
        // The delimiter is overwritten by the terminator, so read it before writing.
        delimiter := raw_byte(buf + i);
        raw_putbyte(buf + w, 0);
        if delimiter != 0 {
            i = i + 1;
        }
    }
    raw_store(table + count * 8, 0);
    return count;
}
// ---- threads and address waits --------------------------------------------------------------
// Joinable threads are tracked so a join can wait for real thread termination (not just the
// portable "running" word) before its stack is released. Slots live above the process scratch
// word: 15 entries of {tid word pointer, thread handle}.
fn rt_win_slot(i: u64) -> u64 {
    return raw_state() + 3856 + i * 16;
}
fn rt_win_register(tid_word: u64, handle: u64) -> u64 {
    rt_allocator_lock();
    mut i = 0;
    mut done = 0;
    while i < 15 {
        slot := rt_win_slot(i);
        if raw_load(slot) == 0 {
            raw_store(slot, tid_word);
            raw_store(slot + 8, handle);
            done = 1;
            i = 15;
        } else {
            i = i + 1;
        }
    }
    rt_allocator_unlock();
    return done;
}
// Removes and returns the thread handle registered for this tid word, or 0.
fn rt_win_take(addr: u64) -> u64 {
    rt_allocator_lock();
    mut i = 0;
    mut handle = 0;
    while i < 15 {
        slot := rt_win_slot(i);
        if raw_load(slot) == addr {
            handle = raw_load(slot + 8);
            raw_store(slot, 0);
            raw_store(slot + 8, 0);
            i = 15;
        } else {
            i = i + 1;
        }
    }
    rt_allocator_unlock();
    return handle;
}
// Waits for a joined thread that is still registered for this stack, then its stack is safe to
// release. Detached threads are never registered, so this is a no-op for them.
fn rt_win_reap(stack: u64) -> u64 {
    // This runs on the unmap path, which two callers reach: a thread's own teardown, with no
    // allocator lock held, and the allocator releasing a block of 512 KiB or more, with the lock
    // held. Taking the lock before knowing there is a stack to reap deadlocked the second caller,
    // so the scan below decides first and only a registered stack claims its handle under the lock.
    mut i = 0;
    mut found = 0;
    while i < 15 {
        slot := rt_win_slot(i);
        tid := raw_load(slot);
        if tid != 0 {
            if raw_load(tid + 8) == stack {
                found = 1;
                i = 15;
            }
        }
        i = i + 1;
    }
    if found == 0 {
        return 0;
    }
    rt_allocator_lock();
    mut handle = 0;
    i = 0;
    while i < 15 {
        slot := rt_win_slot(i);
        tid := raw_load(slot);
        if tid != 0 {
            if raw_load(tid + 8) == stack {
                handle = raw_load(slot + 8);
                raw_store(slot, 0);
                raw_store(slot + 8, 0);
            }
        }
        i = i + 1;
    }
    rt_allocator_unlock();
    if handle != 0 {
        raw_win32(WaitForSingleObject, handle, 4294967295);
        raw_win32(CloseHandle, handle);
    }
    return 0;
}
// CreateThread start routine, reached through the compiler's Win64 bridge. The bridge passes the
// thread record and keeps %rdi/%rsi for the caller; this clears the portable "running" word so a
// join's loop finishes, then wakes any waiter.
fn rt_win_thread_main(record: u64) -> u64 {
    rt_thread_main(record);
    tid := raw_load(record - 32);
    if tid != 0 {
        raw_store(tid, 0);
        raw_win32(WakeByAddressAll, tid);
    }
    return 0;
}
// start_slot is the portable record at the top of the thread stack: [entry][record]. The joinable
// handle array is stored out of band in the stack slack, so portable code stays unchanged.
fn rt_win_thread_clone(start_slot: u64, tid_word: u64) -> u64 {
    record := raw_load(start_slot + 8);
    // Two words under the start block (record - 16, record - 8), in the stack's slack.
    raw_store(record - 32, tid_word);
    raw_store(tid_word, 1);
    scratch := rt_win_scratch();
    raw_store(scratch + 8, 0);
    bridge := raw_load(raw_state() + 3392);
    handle := raw_win32(CreateThread, 0, 0, bridge, record, 0, scratch + 8);
    if handle == 0 {
        return wrapping_sub(0, 11);
    }
    raw_store(record - 24, handle);
    // Detached spawns pass a word inside the thread's own stack; joinable ones pass the handle
    // array from rt_alloc. Only the latter needs tracking for a join.
    if (tid_word < record) + (record + 128 < tid_word) {
        rt_win_register(tid_word, handle);
    }
    return handle;
}
fn rt_win_wake(addr: u64, count: u64) -> u64 {
    if count == 1 {
        raw_win32(WakeByAddressSingle, addr);
    } else {
        raw_win32(WakeByAddressAll, addr);
    }
    return 0;
}
// FUTEX_WAIT: block while the word still holds `expected`. A registered thread's word waits for
// thread termination; everything else uses WaitOnAddress on the 8-byte word.
fn rt_win_wait(addr: u64, expected: u64) -> u64 {
    handle := rt_win_take(addr);
    if handle != 0 {
        raw_win32(WaitForSingleObject, handle, 4294967295);
        raw_win32(CloseHandle, handle);
        return 0;
    }
    // WaitOnAddress compares against a word the caller supplies. Two threads waiting on different
    // expected values must not share one word, so the expected value lives in the calling thread's
    // own record (word 6 of the 64-byte record, unused by the scheduler).
    mine := raw_tp_get() + 48;
    raw_store(mine, expected);
    if raw_win32(WaitOnAddress, addr, mine, 8, 4294967295) == 0 {
        return wrapping_sub(0, 110);
    }
    return 0;
}
// Join waits only ever target registered threads; if one was already reaped, yield instead of
// blocking on a word nobody will wake.
fn rt_win_join_wait(addr: u64) -> u64 {
    handle := rt_win_take(addr);
    if handle != 0 {
        raw_win32(WaitForSingleObject, handle, 4294967295);
        raw_win32(CloseHandle, handle);
        return 0;
    }
    raw_win32(Sleep, 0);
    return 0;
}

// ---- process creation ------------------------------------------------------------------------
// CreateProcessA takes one command line, not an argument vector, so every argument is quoted back
// into a line that rt_win_split (and CommandLineToArgvW) reads as the same vector: a backslash only
// escapes a quote when it precedes one, and a quote is escaped by doubling the backslashes in front
// of it.
fn rt_win_quote(dst: u64, at: u64, src: u64) -> u64 {
    mut len = 0;
    mut need = 0;
    while raw_byte(src + len) != 0 {
        b := raw_byte(src + len);
        if (b == 32) + (b == 9) + (b == 34) {
            need = 1;
        }
        len += 1;
    }
    // An empty argument must still be quoted, or it disappears from the child's vector.
    if len == 0 {
        need = 1;
    }
    if need == 0 {
        mut i = 0;
        while i < len {
            raw_putbyte(dst + at + i, raw_byte(src + i));
            i += 1;
        }
        return at + len;
    }
    mut out = at;
    raw_putbyte(dst + out, 34);
    out += 1;
    mut i = 0;
    while i < len {
        mut slashes = 0;
        while raw_byte(src + i) == 92 {
            slashes += 1;
            i += 1;
        }
        b := raw_byte(src + i);
        if b == 0 {
            // Trailing backslashes: doubled, so they cannot escape the closing quote.
            slashes = slashes * 2;
        } else {
            if b == 34 {
                // A literal quote: 2N+1 backslashes, then the quote.
                slashes = slashes * 2 + 1;
            }
        }
        mut k = 0;
        while k < slashes {
            raw_putbyte(dst + out, 92);
            out += 1;
            k += 1;
        }
        if b == 0 {
            break;
        }
        raw_putbyte(dst + out, b);
        out += 1;
        i += 1;
    }
    raw_putbyte(dst + out, 34);
    return out + 1;
}
fn rt_win_upper(b: u64) -> u64 {
    if (96 < b) & (b < 123) {
        return b - 32;
    }
    return b;
}
// Name order, case-insensitively: CreateProcess requires the block sorted that way.
fn rt_win_env_less(a: u64, b: u64) -> u64 {
    mut i = 0;
    while 1 {
        x := rt_win_upper(raw_byte(a + i));
        y := rt_win_upper(raw_byte(b + i));
        if x != y {
            return x < y;
        }
        if x == 0 {
            return 0;
        }
        i += 1;
    }
}
// A Win32 environment block: the entries in name order, each NUL-terminated, the list closed by one
// more NUL. Unlike an inherited environment (CreateProcess with a NULL block), this block is the
// child's whole environment: nothing is added from this process unless it is in the table.
fn rt_win_env_block(envp: u64) -> u64 {
    mut count = 0;
    while raw_load(envp + count * 8) != 0 {
        count += 1;
    }
    order := rt_alloc((count + 1) * 8);
    mut i = 0;
    while i < count {
        raw_store(order + i * 8, raw_load(envp + i * 8));
        i += 1;
    }
    i = 1;
    while i < count {
        mut j = i;
        while 0 < j {
            if rt_win_env_less(raw_load(order + j * 8), raw_load(order + (j - 1) * 8)) == 0 {
                break;
            }
            moved := raw_load(order + j * 8);
            raw_store(order + j * 8, raw_load(order + (j - 1) * 8));
            raw_store(order + (j - 1) * 8, moved);
            j -= 1;
        }
        i += 1;
    }
    mut total = 1;
    i = 0;
    while i < count {
        p := raw_load(order + i * 8);
        mut n = 0;
        while raw_byte(p + n) != 0 {
            n += 1;
        }
        total += n + 1;
        i += 1;
    }
    block := rt_alloc(total);
    mut at = 0;
    i = 0;
    while i < count {
        p := raw_load(order + i * 8);
        mut n = 0;
        while raw_byte(p + n) != 0 {
            raw_putbyte(block + at, raw_byte(p + n));
            at += 1;
            n += 1;
        }
        raw_putbyte(block + at, 0);
        at += 1;
        i += 1;
    }
    raw_putbyte(block + at, 0);
    rt_free(order);
    return block;
}
// Runs `argv` and waits for it. `envp` is a NUL-terminated "NAME=VALUE" table that becomes the
// child's whole environment, or 0 for the inherited one (CreateProcess with a NULL block). The child
// gets this console's standard handles because dwFlags is 0, and CreateProcess searches PATH itself
// when the first argument has no directory, so `paths` (built for the POSIX exec loop) is unused.
// Same status convention as os-linux.grl: 0..255 exit code, 256+errno on failure.
fn rt_spawn_wait(paths: u64, argv: u64, envp: u64) -> u64 {
    if raw_target() == 4 {
        // windows-aarch64: the ARM64 Win32 call path passes seven register arguments and
        // CreateProcessA needs ten, so it is reported as unimplemented instead of mis-called.
        return wrapping_sub(0, 38);
    }
    mut size = 1;
    mut count = 0;
    while raw_load(argv + count * 8) != 0 {
        p := raw_load(argv + count * 8);
        mut n = 0;
        while raw_byte(p + n) != 0 {
            n += 1;
        }
        size += n * 2 + 4;
        count += 1;
    }
    line := rt_alloc(size);
    mut at = 0;
    mut i = 0;
    while i < count {
        if i != 0 {
            raw_putbyte(line + at, 32);
            at += 1;
        }
        at = rt_win_quote(line, at, raw_load(argv + i * 8));
        i += 1;
    }
    raw_putbyte(line + at, 0);
    mut block = 0;
    if envp != 0 {
        block = rt_win_env_block(envp);
    }
    // STARTUPINFOA is 104 bytes on Win64 and PROCESS_INFORMATION 24; both zeroed, so no standard
    // handle is overridden and no console is forced.
    startup := rt_alloc(128);
    info := rt_alloc(32);
    i = 0;
    while i < 128 {
        raw_store(startup + i, 0);
        i += 8;
    }
    i = 0;
    while i < 32 {
        raw_store(info + i, 0);
        i += 8;
    }
    raw_store(startup, 104);
    mut result = 0;
    started := raw_win32(CreateProcessA, 0, line, 0, 0, 0, 0, block, 0, startup, info);
    if started == 0 {
        result = 256 + wrapping_sub(0, rt_win_errno());
    } else {
        process := raw_load(info);
        thread := raw_load(info + 8);
        code := rt_win_scratch();
        raw_store(code, 0);
        raw_win32(WaitForSingleObject, process, 4294967295);
        if raw_win32(GetExitCodeProcess, process, code) == 0 {
            result = 256 + wrapping_sub(0, rt_win_errno());
        } else {
            result = raw_load(code) & 255;
        }
        raw_win32(CloseHandle, thread);
        raw_win32(CloseHandle, process);
    }
    rt_free(line);
    rt_free(startup);
    rt_free(info);
    if block != 0 {
        rt_free(block);
    }
    return result;
}

// Process setup for the PE entry: argv from GetCommandLineA, envp from GetEnvironmentStringsA.
// Both live in untracked mappings so they do not count as user allocations at shutdown.
fn rt_os_init() -> u64 {
    // Grail strings are UTF-8, so the console is told to read and write UTF-8 rather than the
    // ANSI code page: without this every non-ASCII character printed through WriteFile arrives
    // as mojibake (cp1252 has no mapping for most of it).
    raw_win32(SetConsoleOutputCP, 65001);
    raw_win32(SetConsoleCP, 65001);
    line := raw_win32(GetCommandLineA);
    mut length = 0;
    while raw_byte(line + length) != 0 {
        length = length + 1;
    }
    buf := raw_map(65536);
    if rt_error(buf) {
        return 1;
    }
    mut i = 0;
    while i < length {
        raw_putbyte(buf + i, raw_byte(line + i));
        i = i + 1;
    }
    raw_putbyte(buf + length, 0);
    table := raw_map(4096);
    if rt_error(table) {
        return 1;
    }
    raw_store(raw_state(), rt_win_split(buf, table));
    raw_store(raw_state() + 8, table);
    env := raw_win32(GetEnvironmentStringsA);
    envtable := raw_map(8192);
    if rt_error(envtable) {
        return 1;
    }
    mut count = 0;
    mut p = env;
    while (p != 0) & (raw_byte(p) != 0) {
        raw_store(envtable + count * 8, p);
        count = count + 1;
        while raw_byte(p) != 0 {
            p = p + 1;
        }
        p = p + 1;
    }
    // `host::env("PWD")` is how the compiler reads the working directory - the site table trims
    // source paths with it, so a diagnostic names `compiler/native.grl` rather than an absolute
    // path. Windows has no PWD (a POSIX shell exports one), so the process publishes its own, and
    // everything that reads the environment sees it exactly as on Linux.
    if count < 1022 {
        pwd := raw_map(8192);
        if rt_error(pwd) == 0 {
            raw_putbyte(pwd, 80); // 'P'
            raw_putbyte(pwd + 1, 87); // 'W'
            raw_putbyte(pwd + 2, 68); // 'D'
            raw_putbyte(pwd + 3, 61); // '='
            n := rt_cwd(pwd + 4, 8188);
            if rt_error(n) == 0 {
                raw_store(envtable + count * 8, pwd);
                count = count + 1;
            }
        }
    }
    raw_store(envtable + count * 8, 0);
    raw_store(raw_state() + 16, envtable);
    return 0;
}

// ---- green-task execution contexts (Win32 fibers) -------------------------------------------
// A task is a fiber, not an OS thread: a worker switches onto it with SwitchToFiber and a
// suspension switches back, so the task keeps its own stack across a park. Several workers switch
// fibers concurrently (M:N): a fiber is not owned by the thread that created it - Win32 lets any
// thread switch to any fiber - so a stolen task runs on whichever worker took it. The one thing a
// migrated task must not rely on is OS thread local storage; the runtime's own per-thread state
// (the thread record) is read through raw_tp_get, which follows the OS thread, so the portable
// code always sees the worker that is actually running it.
//
// Readiness is a completion port: CreateIoCompletionPort where the Linux build creates epoll. A
// blocking host operation is still handed to a helper thread (rt_offload), but its completion is
// posted to the port and the reactor wakes the parked task, instead of the helper waking it
// directly; sleeps live on a timer heap the reactor waits on through GetQueuedCompletionStatus's
// timeout. So a task program does not need an epoll, an eventfd, a timerfd or a WaitForMultipleObjects
// set, and a reactor that cannot be created is not fatal: rt_sleep_ms falls back to offloading.
//
// The fiber stack is lazily committed by the OS: CreateFiberEx commits `commit` bytes inside a
// `reserve`-byte range and grows it through guard pages, exactly as a thread stack grows, which is
// what lets a 1 MiB reservation cost 64 KiB until a task needs more. Exhausting it raises
// STATUS_STACK_OVERFLOW, caught by the vectored exception handler installed below.
//
// These entry points are declared here rather than in the compiler's Win32 table
// (compiler/native.grl), because they are runtime-only: the import library records them as
// `// grail-link: import kernel32 ...` from this declaration.
extern "C" lib "kernel32" fn ConvertThreadToFiber(parameter: u64) -> u64;
// The start routine is a `cfn` value, so it has to be an `extern "C"` definition below: the fiber
// proc is entered with its parameter in %rcx, while a Grail function takes it in %rdi.
extern "C" lib "kernel32" fn CreateFiberEx(commit: u64, reserve: u64, flags: u64, start: cfn(u64) -> u64, parameter: u64) -> u64;
extern "C" lib "kernel32" fn DeleteFiber(fiber: u64) -> unit;
extern "C" lib "kernel32" fn SwitchToFiber(fiber: u64) -> unit;
extern "C" lib "kernel32" fn CreateIoCompletionPort(handle: u64, existing: u64, key: u64, threads: u64) -> u64;
extern "C" lib "kernel32" fn GetQueuedCompletionStatus(port: u64, bytes: u64, key: u64, overlapped: u64, ms: u64) -> u64;
extern "C" lib "kernel32" fn PostQueuedCompletionStatus(port: u64, bytes: u64, key: u64, overlapped: u64) -> u64;
extern "C" lib "kernel32" fn AddVectoredExceptionHandler(first: u64, handler: cfn(u64) -> u64) -> u64;
extern "C" lib "kernel32" fn GetActiveProcessorCount(group: u64) -> u64;
extern "C" lib "kernel32" fn GetCurrentThread() -> u64;
extern "C" lib "kernel32" fn SetThreadAffinityMask(thread: u64, mask: u64) -> u64;
extern "C" lib "kernel32" fn SetThreadPriority(thread: u64, priority: u64) -> u64;
extern "C" lib "kernel32" fn SetThreadDescription(thread: u64, name: u64) -> u64;

fn rt_os_reactor() -> u64 {
    return 1;
}
// One scheduler worker per core, with the same floor of two the ELF targets use.
// Not yet on Windows (SetThreadAffinityMask is the call): pinning reports it is unsupported.
fn rt_os_pin(cpu: u64) -> u64 {
    return wrapping_sub(0, 38);
}
// A fiber's stack is the OS's (CreateFiberEx) and is not recycled, so there is nothing to warm.
fn rt_os_stack_warm(count: u64) -> u64 {
    return 0;
}
fn rt_os_workers() -> u64 {
    mut workers = GetActiveProcessorCount(65535); // ALL_PROCESSOR_GROUPS
    if workers < 2 {
        workers = 2;
    }
    if 64 < workers {
        workers = 64;
    }
    return workers;
}
// Turn the calling scheduler thread into a fiber, so a task can be switched onto and off it. The
// first worker also installs the vectored exception handler that turns a stack overflow into the
// runtime's report.
fn rt_os_sched_prepare() -> u64 {
    words := rt_state_stack_guard();
    if raw_atomic_cas(words + 8, 0, 2) == 0 {
        AddVectoredExceptionHandler(1, rt_win_vectored);
    }
    w := raw_tp_get();
    if raw_load(w + 8) == 0 {
        fiber := ConvertThreadToFiber(0);
        if fiber == 0 {
            rt_abort();
        }
        raw_store(w + 8, fiber);
    }
    return 0;
}
// EXCEPTION_POINTERS is {ExceptionRecord, ContextRecord}; the record's first member is the DWORD
// code. 0xC00000FD is STATUS_STACK_OVERFLOW, the fault a fiber raises once its reserve is gone.
// Everything else keeps searching (0 = EXCEPTION_CONTINUE_SEARCH), so an ordinary fault still ends
// the process the way it always did.
extern "C" fn rt_win_vectored(pointers: u64) -> u64 {
    if pointers != 0 {
        record := raw_load(pointers);
        if record != 0 {
            if (raw_load(record) & 4294967295) == 3221225725 {
                rt_stack_overflow();
            }
        }
    }
    return 0;
}
// 64 KiB committed inside 1 MiB reserved, grown by the OS through guard pages. A fiber cannot be
// reinitialised, so its stack is released by DeleteFiber rather than recycled; the Linux/macOS
// builds recycle their raw mappings through the per-worker free list.
fn rt_os_ctx_new(t: u64) -> u64 {
    fiber := CreateFiberEx(65536, 1048576, 0, rt_win_fiber_start, t);
    if fiber == 0 {
        rt_abort();
    }
    raw_store(t, fiber);
    raw_store(t + 8, 0);
    raw_store(t + 16, 1048576);
    return fiber;
}
fn rt_os_ctx_enter(t: u64) -> u64 {
    SwitchToFiber(raw_load(t));
    return 0;
}
fn rt_os_ctx_leave(t: u64) -> u64 {
    SwitchToFiber(raw_load(raw_tp_get() + 8));
    return 0;
}
// The scheduler calls this after the task switched away for the last time, so the fiber is not
// running and its stack can be released.
fn rt_os_ctx_release(t: u64) -> u64 {
    DeleteFiber(raw_load(t));
    return 0;
}
// ---- dedicated threads (runtime.grl rt_uthread_main) -------------------------------------------
fn rt_os_threads() -> u64 {
    return 1;
}
// The closure's stack is a fiber of `size` reserved bytes; the thread becomes a fiber itself so it
// can be switched back to. The vectored handler that reports a stack overflow is installed by
// whichever thread needs it first.
fn rt_os_body_new(rec: u64, size: u64) -> u64 {
    words := rt_state_stack_guard();
    if raw_atomic_cas(words + 8, 0, 2) == 0 {
        AddVectoredExceptionHandler(1, rt_win_vectored);
    }
    w := raw_tp_get();
    if raw_load(w + 8) == 0 {
        own := ConvertThreadToFiber(0);
        if own == 0 {
            return 1;
        }
        raw_store(w + 8, own);
    }
    mut commit = 65536;
    if size < commit {
        commit = size;
    }
    fiber := CreateFiberEx(commit, size, 0, rt_win_body_start, rec);
    if fiber == 0 {
        return 1;
    }
    raw_store(rec, fiber);
    raw_store(rec + 8, 0);
    raw_store(rec + 16, size);
    return 0;
}
fn rt_os_body_free(rec: u64) -> u64 {
    DeleteFiber(raw_load(rec));
    return 0;
}
extern "C" fn rt_win_body_start(rec: u64) -> u64 {
    rt_uthread_run(rec);
    while true {
        rt_os_ctx_leave(rec);
    }
    return 0;
}
// The overflow report needs no alternate stack here: the vectored handler runs on the faulting
// fiber's last committed pages.
fn rt_os_thread_guard() -> u64 {
    return 0;
}
fn rt_os_thread_unguard(base: u64) -> u64 {
    return 0;
}
// The name is a label (SetThreadDescription, each byte widened: a name outside ASCII shows as its
// bytes). Affinity is the first 64 processors of the thread's group; a set that names only others,
// or that the system refuses, is a refusal, as is a priority it will not grant. Background is
// THREAD_PRIORITY_IDLE, high THREAD_PRIORITY_HIGHEST, realtime THREAD_PRIORITY_TIME_CRITICAL.
fn rt_os_thread_attr(rec: u64) -> u64 {
    me := GetCurrentThread();
    if raw_byte(rec + 384) != 0 {
        wide := rt_alloc(34);
        mut i = 0;
        while raw_byte(rec + 384 + i) != 0 {
            raw_putbyte(wide + i * 2, raw_byte(rec + 384 + i));
            i = i + 1;
        }
        SetThreadDescription(me, wide);
        rt_free(wide);
    }
    if raw_load(rec + 128) != 0 {
        mask := raw_load(rec + 256);
        if mask == 0 {
            return 2 * 65536 + 22;
        }
        if SetThreadAffinityMask(me, mask) == 0 {
            return 2 * 65536 + 22;
        }
    }
    priority := raw_load(rec + 152);
    if priority != 0 {
        mut level = 15;
        if priority == 1 {
            level = 4294967281; // -15 as the int the call takes
        }
        if priority == 2 {
            level = 2;
        }
        if (SetThreadPriority(me, level) & 4294967295) == 0 {
            return 3 * 65536 + 1;
        }
    }
    return 0;
}
// WaitOnAddress with a timeout, the expected value kept in this thread's record as rt_win_wait does.
fn rt_os_wait_ms(addr: u64, expected: u64, ms: u64) -> u64 {
    if ms == 0 {
        return 0;
    }
    mine := raw_tp_get() + 48;
    raw_store(mine, expected);
    raw_win32(WaitOnAddress, addr, mine, 8, ms);
    return 0;
}
// No absolute sleep here: the remaining time, asked of Sleep.
fn rt_os_sleep_until(deadline_ms: u64) -> u64 {
    now := f_host_now_ms();
    if now < deadline_ms {
        f_host_sleep_ms(deadline_ms - now);
    }
    return 0;
}
// Fiber entry: the task body, then back to the scheduler. A fiber that returns exits its thread, so
// the last thing this can do is hand control back; it is never resumed after the scheduler sees
// word 144 set. It is an `extern "C"` definition because Win32 starts a fiber through a `cfn`.
extern "C" fn rt_win_fiber_start(t: u64) -> u64 {
    rt_task_finish(t);
    while true {
        rt_os_ctx_leave(t);
    }
    return 0;
}

// ---- reactor: an I/O completion port plus a timer heap -----------------------------------------
// Timers are entries in a small heap in the scheduler block; the reactor waits in
// GetQueuedCompletionStatus for at most the time until the earliest one. A completion key is the
// task to wake (0 is the fence, 1 says the heap changed and the timeout must be recomputed).
fn rt_os_ready() -> u64 {
    return 0; // no descriptor readiness: blocking operations are completed, not waited on
}
fn rt_os_reactor_open(s: u64) -> u64 {
    port := CreateIoCompletionPort(wrapping_sub(0, 1), 0, 0, raw_load(s + 32));
    if port == 0 {
        return 0;
    }
    heap := raw_map(65536);
    if rt_error(heap) {
        raw_win32(CloseHandle, port);
        return 0;
    }
    raw_store(s + 128, heap);
    raw_store(s + 120, 4096);
    return port;
}
fn rt_os_reactor_fence(s: u64) -> u64 {
    if raw_load(s + 40) != 0 {
        PostQueuedCompletionStatus(raw_load(s + 40), 0, 0, 0);
    }
    return 0;
}
fn rt_win_millis() -> u64 {
    return raw_win32(GetTickCount64);
}
fn rt_os_timer(s: u64, task: u64, ms: u64) -> u64 {
    port := raw_load(s + 40);
    if port == 0 {
        return 1;
    }
    deadline := rt_win_millis() + ms;
    rt_spin_lock(s + 104);
    count := raw_load(s + 112);
    if raw_load(s + 120) <= count {
        rt_spin_unlock(s + 104);
        return 1;
    }
    heap := raw_load(s + 128);
    raw_store(heap + count * 16, deadline);
    raw_store(heap + count * 16 + 8, task);
    raw_store(s + 112, count + 1);
    rt_spin_unlock(s + 104);
    // Recompute the wait timeout: wake the reactor out of GetQueuedCompletionStatus.
    PostQueuedCompletionStatus(port, 0, 1, 0);
    return 0;
}
fn rt_os_timer_done(s: u64, task: u64) -> u64 {
    return 0; // the entry was removed when it fired
}
fn rt_win_timer_next(s: u64) -> u64 {
    rt_spin_lock(s + 104);
    count := raw_load(s + 112);
    heap := raw_load(s + 128);
    mut i = 0;
    mut best = 0;
    while i < count {
        d := raw_load(heap + i * 16);
        if (best == 0) || (d < best) {
            best = d;
        }
        i += 1;
    }
    rt_spin_unlock(s + 104);
    return best;
}
fn rt_win_timers_fire(s: u64) -> u64 {
    now := rt_win_millis();
    rt_spin_lock(s + 104);
    mut count = raw_load(s + 112);
    heap := raw_load(s + 128);
    mut i = 0;
    while i < count {
        if raw_load(heap + i * 16) <= now {
            task := raw_load(heap + i * 16 + 8);
            count = count - 1;
            raw_store(heap + i * 16, raw_load(heap + count * 16));
            raw_store(heap + i * 16 + 8, raw_load(heap + count * 16 + 8));
            raw_store(s + 112, count);
            rt_wake(task);
        } else {
            i += 1;
        }
    }
    rt_spin_unlock(s + 104);
    return 0;
}
fn rt_os_reactor_loop(s: u64) -> u64 {
    port := raw_load(s + 40);
    scratch := rt_win_scratch() + 16;
    while true {
        rt_win_timers_fire(s);
        mut timeout = 4294967295; // INFINITE
        earliest := rt_win_timer_next(s);
        if earliest != 0 {
            now := rt_win_millis();
            if earliest <= now {
                timeout = 0;
            } else {
                timeout = earliest - now;
            }
        }
        // A timeout leaves the key word untouched, so it is cleared before every wait.
        raw_store(scratch + 8, 0);
        GetQueuedCompletionStatus(port, scratch, scratch + 8, scratch + 16, timeout);
        key := raw_load(scratch + 8);
        if (key != 0) && (key != 1) {
            rt_wake(key);
        }
        if key == 1 {
            rt_win_timers_fire(s); // an earlier deadline may already be due
        }
        rt_atomic_fetch_add(s + 56, 1);
    }
    return 0;
}
fn rt_os_wait_fd(s: u64, fd: u64, events: u64, task: u64) -> u64 {
    return 1; // readiness is not offered; rt_wait_fd reports ready and the caller retries
}
fn rt_os_wait_done(s: u64, fd: u64) -> u64 {
    return 0;
}
// A blocking operation completed on its helper thread: hand the task to the reactor through the
// completion port, exactly as an overlapped operation's completion would arrive.
fn rt_os_complete(task: u64) -> u64 {
    mut port = raw_load(raw_state() + 72);
    if port != 0 {
        port = raw_load(port + 40); // the scheduler block's reactor handle
    }
    if port != 0 {
        PostQueuedCompletionStatus(port, 0, task, 0);
        return 0;
    }
    return rt_wake(task);
}
