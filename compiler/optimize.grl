// The liveness of general-register candidates (bit c for slot cands[c]) over the label graph, as
// xmm_live does for SSE ones, but a call is no barrier - the registers are callee-saved - and a slot
// that is the destination of an operation other than a move (`addq %rax,-8(%rbp)`, `cmpq $0,...`)
// is read there. `interf[c]` collects the candidates live at the same time as candidate c.
fn gpr_live<a>(o: (&a ir::Body), cands: (&u64[]), lin: (&mut u64[]), interf: (&mut u64[])) -> u64 {
    last := o.op.len();
    all := (1 << cands.len()) - 1;
    mut live = 0;
    mut changed = 0;
    mut i = last;
    while 0 < i {
        i -= 1;
        if (o.del[i] != 0) || (o.tr[i] != 0) {
            continue;
        }
        op := o.op[i];
        if op == 101 {
            continue;
        }
        if op == 100 {
            if lin[i] != live {
                ir::put(&mut lin, i, live);
                changed = 1;
            }
            continue;
        }
        if ir::is_jump(op) && (op != 15) {
            t := jump_target(&o, i);
            mut there = all;
            if t < last {
                there = lin[t];
            }
            if op == 16 {
                live = there;
            } else {
                live = live | there;
            }
            continue;
        }
        if (op == 29) || (op == 30) {
            live = 0;
            continue;
        }
        if interf.len() != 0 {
            for c in cands.len() {
                at := cands[c] * 8;
                written := (o.k1[i] == 2) && (o.v1[i] == at);
                if written || (((live >> c) & 1) != 0) {
                    was := interf[c];
                    ir::put(&mut interf, c, was | live);
                }
            }
        }
        for c in cands.len() {
            at := cands[c] * 8;
            if (o.k1[i] == 2) && (o.v1[i] == at) {
                if ir::movelike(op) {
                    live = live & (all - (1 << c));
                } else {
                    live = live | (1 << c);
