                }
            }
        }
    }
    forward(&mut o, &mut f, view(s), first, last);
    dead_stores(&mut o, &mut f, first, last);
    dead_defs(&mut o, view(s), first, last);
    // Promotion: weights grow 4x per loop nesting level (backward jumps).
    mut chosen = u64[];
    mut slots = u64[];
    if prologue != 0 {
        mut opens = u64[];
        mut closes = u64[];
        for i in last + 1 {
            opens.push(0);
            closes.push(0);
        }
        for i in last {
            op := o.op[i];
            if is_jump(op) && op != 15 && o.del[i] == 0 {
