module optimize;
use ir;
use jobs;
use xxhash;
use llvm;
use llvm;

// Word-stream optimizer: runs on the x86-64-spelled stream before target lowering, so every CPU
// benefits. Per function it (1) forwards frame-slot values already held in a register or known
// constant within a basic block, (2) deletes stores to slots that are never read and register
// definitions that are never used, (3) promotes the hottest non-escaping slots into callee-saved
// registers (weighted by loop depth), and (4) fuses set/test/branch sequences and turns division
// by a power-of-two constant into shift/mask. Unrecognized functions are copied unchanged.
//
// What a body *is* lives in `compiler/ir.grl`: the instruction record, the parser, the operand
// algebra and the typed-IR layer. This module is the passes and the printer that run over it.
//
// A slot is one word unless the typed-IR facts say it is the first word of a `DynPair`
// (docs/design/fat-dyn.md), the 16-byte `{data, vtable}` value a `&dyn I` points at: the body's
// pair list and its two-word-result flag are read once, in `ir::build`, from the body's facts (kinds
// 3 and 4), keyed by the body symbol. The two words are
// then one value with one identity - never promoted, never forwarded, their stores never dead, kept
// adjacent and in order - and a function that builds a pair is not inlined. This is the language's
// `DynPair`, not a directive the emitter wrote.

fn app<a, b>(out: (&a mut u8[]), s: &b [u8]) {
    out.append(s);
}
fn opname<a>(o: (&a mut ir::Body), op: u64) {
    if op == 1 {
        app(&mut o.out, view("movq"));
        return ();
    }
    if op == 2 {
        app(&mut o.out, view("movabsq"));
        return ();
    }
    if op == 3 {
        app(&mut o.out, view("leaq"));
        return ();
    }
    if op == 4 {
        app(&mut o.out, view("addq"));
        return ();
    }
    if op == 5 {
        app(&mut o.out, view("subq"));
        return ();
    }
    if op == 6 {
        app(&mut o.out, view("cmpq"));
        return ();
    }
    if op == 7 {
        app(&mut o.out, view("testq"));
        return ();
    }
    if op == 8 {
        app(&mut o.out, view("andq"));
        return ();
    }
    if op == 9 {
        app(&mut o.out, view("orq"));
        return ();
    }
    if op == 10 {
        app(&mut o.out, view("xorq"));
        return ();
    }
    if op == 11 {
        app(&mut o.out, view("incq"));
        return ();
    }
    if op == 12 {
        app(&mut o.out, view("mulq"));
        return ();
    }
    if op == 13 {
        app(&mut o.out, view("divq"));
        return ();
    }
    if op == 14 {
        app(&mut o.out, view("imulq"));
        return ();
    }
    if op == 15 {
        app(&mut o.out, view("call"));
        return ();
    }
    if op == 16 {
        app(&mut o.out, view("jmp"));
        return ();
    }
    if op == 17 {
        app(&mut o.out, view("je"));
        return ();
    }
    if op == 18 {
        app(&mut o.out, view("jz"));
        return ();
    }
    if op == 19 {
        app(&mut o.out, view("jne"));
        return ();
    }
    if op == 20 {
        app(&mut o.out, view("jnz"));
        return ();
    }
    if op == 21 {
        app(&mut o.out, view("jnc"));
        return ();
    }
    if op == 22 {
        app(&mut o.out, view("jae"));
        return ();
    }
    if op == 23 {
        app(&mut o.out, view("jb"));
        return ();
    }
    if op == 24 {
        app(&mut o.out, view("jc"));
        return ();
    }
    if op == 25 {
        app(&mut o.out, view("sete"));
        return ();
    }
    if op == 26 {
        app(&mut o.out, view("setne"));
        return ();
    }
    if op == 27 {
        app(&mut o.out, view("setb"));
        return ();
    }
    if op == 28 {
        app(&mut o.out, view("movzbq"));
        return ();
    }
    if op == 29 {
        app(&mut o.out, view("leave"));
        return ();
    }
    if op == 30 {
        app(&mut o.out, view("ret"));
        return ();
    }
    if op == 31 {
        app(&mut o.out, view("pushq"));
        return ();
    }
    if op == 32 {
        app(&mut o.out, view("popq"));
        return ();
    }
    if op == 33 {
        app(&mut o.out, view("shlq"));
        return ();
    }
    if op == 34 {
        app(&mut o.out, view("shrq"));
        return ();
    }
    if op == 60 {
        app(&mut o.out, view("addsd"));
        return ();
    }
    if op == 61 {
        app(&mut o.out, view("subsd"));
        return ();
    }
    if op == 62 {
        app(&mut o.out, view("mulsd"));
        return ();
    }
    if op == 63 {
        app(&mut o.out, view("divsd"));
        return ();
    }
    if op == 64 {
        app(&mut o.out, view("sqrtsd"));
        return ();
    }
    if op == 65 {
        app(&mut o.out, view("cvtss2sd"));
        return ();
    }
    if op == 66 {
        app(&mut o.out, view("cvtsd2ss"));
        return ();
    }
    if op == 67 {
        app(&mut o.out, view("ucomisd"));
        return ();
    }
    if op == 68 {
        app(&mut o.out, view("movaps"));
        return ();
    }
    if op == 69 {
        app(&mut o.out, view("cvttsd2si"));
        return ();
    }
    if op == 70 {
        app(&mut o.out, view("movd"));
        return ();
    }
    if op == 71 {
        app(&mut o.out, view("cvtsi2sdq"));
        return ();
    }
    if op == 77 {
        app(&mut o.out, view("movsd"));
        return ();
    }
    if op == 98 {
        app(&mut o.out, view("movl"));
        return ();
    }
    if op == 99 {
        app(&mut o.out, view("movb"));
        return ();
    }
    if op == 72 {
        app(&mut o.out, view("addss"));
        return ();
    }
    if op == 73 {
        app(&mut o.out, view("subss"));
        return ();
    }
    if op == 74 {
        app(&mut o.out, view("mulss"));
        return ();
    }
    if op == 75 {
        app(&mut o.out, view("divss"));
        return ();
    }
    if op == 76 {
        app(&mut o.out, view("sqrtss"));
        return ();
    }
    // An operation this table does not know is a bug in the caller.
    assert(false);
}
fn set_operand<a>(o: (&a mut ir::Body), i: u64, j: u64, k: u64, v: u64) {
    if j == 0 {
        ir::put(&mut o.k0, i, k);
        ir::put(&mut o.v0, i, v);
        ir::put(&mut o.m0, i, 0);
    } else {
        ir::put(&mut o.k1, i, k);
        ir::put(&mut o.v1, i, v);
        ir::put(&mut o.m1, i, 0);
    }
    ir::put(&mut o.chg, i, 1);
}
fn set_range<a>(o: (&a mut ir::Body), i: u64, j: u64, a: u64, e: u64) {
    if j == 0 {
        ir::put(&mut o.s0, i, a);
        ir::put(&mut o.e0, i, e);
    } else {
        ir::put(&mut o.s1, i, a);
        ir::put(&mut o.e1, i, e);
    }
}
fn kill<a>(o: (&a mut ir::Body), i: u64) {
    ir::put(&mut o.del, i, 1);
}
struct F {
    // Slot facts (index N/8): register holding the value (+1) and its version, known
    // immediate line (+1), copy-of slot (+1) and its version; valid while ver/epoch match.
    sver: u64[],
    sep: u64[],
    sfv: u64[],
    sreg: u64[],
    sregv: u64[],
    simm: u64[],
    scopy: u64[],
    scopyv: u64[],
    bad: u64[],
    reads: u64[],
    weight: u64[],
    rver: u64[],
    rep: u64[],
    rimm: u64[],
    rslot: u64[],
    rslotv: u64[],
    rcopy: u64[],
    rcopyv: u64[],
    epoch: u64
}
fn facts_valid<a>(f: (&a F), n: u64) -> bool {
    return (f.sep[n] == f.epoch) && (f.sfv[n] == f.sver[n]);
}
fn fresh_facts<a>(f: (&a mut F), n: u64) {
    ir::put(&mut f.sep, n, f.epoch);
    ir::put(&mut f.sfv, n, f.sver[n]);
    ir::put(&mut f.sreg, n, 0);
    ir::put(&mut f.simm, n, 0);
    ir::put(&mut f.scopy, n, 0);
}
fn reg_written<a>(f: (&a mut F), r: u64) {
    ir::put(&mut f.rver, r, f.rver[r] + 1);
    ir::put(&mut f.rimm, r, 0);
    ir::put(&mut f.rslot, r, 0);
    ir::put(&mut f.rcopy, r, 0);
}
fn reg_fact_valid<a>(f: (&a F), r: u64) -> bool {
    return f.rep[r] == f.epoch;
}
fn copy_source<a>(f: (&a F), q: u64) -> u64 {
    if !reg_fact_valid(&f, q) {
        return q;
    }
    c := f.rcopy[q];
    if c == 0 {
        return q;
    }
    r := c - 1;
    if f.rcopyv[q] != f.rver[r] {
        return q;
    }
    return r;
}
// Replace a read of slot n (operand j of i) by a register or constant already holding it.
fn forward_read<a, c>(o: (&a mut ir::Body), f: (&c mut F), i: u64, j: u64, n: u64) {
    if !facts_valid(&f, n) {
        return ();
    }
    op := o.op[i];
    if (op == 1) & (j == 0) & (o.k1[i] == 1) & (f.simm[n] != 0) {
        l := f.simm[n] - 1;
        lk := o.k0[l];
        lv := o.v0[l];
        la := o.s0[l];
        le := o.e0[l];
        set_operand(&mut o, i, 0, lk, lv);
        set_range(&mut o, i, 0, la, le);
        ir::put(&mut o.op, i, 2);
        return ();
    }
    if f.sreg[n] != 0 {
        r := f.sreg[n] - 1;
        if f.sregv[n] == f.rver[r] {
            set_operand(&mut o, i, j, 1, r);
            return ();
        }
    }
    if f.scopy[n] != 0 {
        m := f.scopy[n] - 1;
        if f.scopyv[n] == f.sver[m] {
            set_operand(&mut o, i, j, 2, m * 8);
            if facts_valid(&f, m) {
                if f.sreg[m] != 0 {
                    r := f.sreg[m] - 1;
                    if f.sregv[m] == f.rver[r] {
                        set_operand(&mut o, i, j, 1, r);
                    }
                }
            }
        }
    }
}
fn new_facts(ns: u64) -> F {
    mut f = F {
        sver: u64[],
        sep: u64[],
        sfv: u64[],
        sreg: u64[],
        sregv: u64[],
        simm: u64[],
        scopy: u64[],
        scopyv: u64[],
        bad: u64[],
        reads: u64[],
        weight: u64[],
        rver: u64[],
        rep: u64[],
        rimm: u64[],
        rslot: u64[],
        rslotv: u64[],
        rcopy: u64[],
        rcopyv: u64[],
        epoch: 1,
    };
    for i in ns {
        f.sver.push(0);
        f.sep.push(0);
        f.sfv.push(0);
        f.sreg.push(0);
        f.sregv.push(0);
        f.simm.push(0);
        f.scopy.push(0);
        f.scopyv.push(0);
        f.bad.push(0);
        f.reads.push(0);
        f.weight.push(0);
    }
    for i in 16 {
        f.rver.push(0);
        f.rep.push(0);
        f.rimm.push(0);
        f.rslot.push(0);
        f.rslotv.push(0);
        f.rcopy.push(0);
        f.rcopyv.push(0);
    }
    return f;
}
fn forward<a, b, c>(o: (&a mut ir::Body), f: (&c mut F), s: &b [u8], first: u64, last: u64) {
    mut i = first;
    while i < last {
        op := o.op[i];
        if o.del[i] != 0 || op == 101 || o.tr[i] != 0 {
            i += 1;
            continue;
        }
        if op == 100 || op == 0 {
            exchange(&mut f.epoch, f.epoch + 1);
            if op == 0 {
                for r in 16 {
                    reg_written(&mut f, r);
                }
            }
            i += 1;
            continue;
        }
        mut loaded = 0;
        if (o.k0[i] == 2) & promotable_use(&o, i) {
            n := o.v0[i] / 8;
            if f.bad[n] == 0 {
                if ir::movelike(op) & (o.k1[i] == 1) {
                    loaded = n + 1;
                }
                forward_read(&mut o, &mut f, i, 0, n);
            }
        }
        if ir::slot_read(&o, i, 1) & promotable_use(&o, i) {
            n := o.v1[i] / 8;
            if f.bad[n] == 0 {
                forward_read(&mut o, &mut f, i, 1, n);
            }
        }
        // Copy propagation: read-only register operands use the original of a register copy.
        if o.k0[i] == 1
            && (op == 1
                    || op == 4
                    || op == 5
                    || op == 6
                    || op == 7
                    || op == 8
                    || op == 9
                    || op == 10) {
            r := copy_source(&f, o.v0[i]);
            if r != o.v0[i] {
                set_operand(&mut o, i, 0, 1, r);
            }
        }
        if o.k1[i] == 1 && (op == 6 || op == 7) {
            r := copy_source(&f, o.v1[i]);
            if r != o.v1[i] {
                set_operand(&mut o, i, 1, 1, r);
            }
        }
        // A register operand known to hold a small constant becomes an immediate - never into an
        // SSE destination (kind 6): `movq $imm,%xmm0` does not exist.
        if o.k0[i] == 1
            && o.k1[i] != 6
            && o.k1[i] != 7
            && (op == 1 || op == 4 || op == 5 || op == 6 || op == 8 || op == 9 || op == 10) {
            r := o.v0[i];
            if reg_fact_valid(&f, r) & (f.rimm[r] != 0) {
                l := f.rimm[r] - 1;
                value := imm_value(&o, view(s), l);
                wide := (op == 1) & (o.k1[i] == 1);
                if value != 0 && (wide || value < 2147483649) {
                    la := o.s0[l];
                    le := o.e0[l];
                    set_operand(&mut o, i, 0, 3, 0);
                    set_range(&mut o, i, 0, la, le);
                    if wide {
                        ir::put(&mut o.op, i, 2);
                    }
                }
            }
        }
        op2 := o.op[i];
        if (op2 == 1) & (o.k0[i] == 1) & (o.k1[i] == 1) & (o.v0[i] == o.v1[i]) {
            kill(&mut o, i);
            i += 1;
            continue;
        }
        w := ir::writes(&o, i);
        // Facts of the source register, captured before the destination is invalidated.
        mut src_imm = 0;
        mut src_slot = 0;
        mut src_slotv = 0;
        if (o.k0[i] == 1) & (op2 == 1) {
            r := o.v0[i];
            if reg_fact_valid(&f, r) {
                src_imm = f.rimm[r];
                src_slot = f.rslot[r];
                src_slotv = f.rslotv[r];
            }
        }
        for r in 16 {
            if ((w >> r) & 1) != 0 {
                reg_written(&mut f, r);
            }
        }
        if ir::slot_written(&o, i) {
            n := o.v1[i] / 8;
            ir::put(&mut f.sver, n, f.sver[n] + 1);
            if (op2 == 1) & (f.bad[n] == 0) {
                fresh_facts(&mut f, n);
                if o.k0[i] == 1 {
                    r := o.v0[i];
                    ir::put(&mut f.sreg, n, r + 1);
                    ir::put(&mut f.sregv, n, f.rver[r]);
                    if src_imm != 0 {
                        ir::put(&mut f.simm, n, src_imm);
                    }
                    if src_slot != 0 {
                        m := src_slot - 1;
                        if (m != n) & (src_slotv == f.sver[m]) {
                            ir::put(&mut f.scopy, n, m + 1);
                            ir::put(&mut f.scopyv, n, f.sver[m]);
                        }
                    }
                }
                if o.k0[i] == 3 {
                    ir::put(&mut f.simm, n, i + 1);
                }
            }
        }
        if (op2 == 1 || op2 == 2) && o.k1[i] == 1 {
            q := o.v1[i];
            ir::put(&mut f.rep, q, f.epoch);
            if o.k0[i] == 3 {
                ir::put(&mut f.rimm, q, i + 1);
            }
            if o.k0[i] == 1 {
                ir::put(&mut f.rimm, q, src_imm);
                ir::put(&mut f.rslot, q, src_slot);
                ir::put(&mut f.rslotv, q, src_slotv);
                r := o.v0[i];
                if r != q {
                    ir::put(&mut f.rcopy, q, r + 1);
                    ir::put(&mut f.rcopyv, q, f.rver[r]);
                }
            }
            if o.k0[i] == 2 {
                n := o.v0[i] / 8;
                if f.bad[n] == 0 {
                    ir::put(&mut f.rslot, q, n + 1);
                    ir::put(&mut f.rslotv, q, f.sver[n]);
                    if !facts_valid(&f, n) {
                        fresh_facts(&mut f, n);
                    }
                    ir::put(&mut f.sreg, n, q + 1);
                    ir::put(&mut f.sregv, n, f.rver[q]);
                }
            }
            if loaded != 0 {
                n := loaded - 1;
                if o.k0[i] != 2 {
                    ir::put(&mut f.rslot, q, n + 1);
                    ir::put(&mut f.rslotv, q, f.sver[n]);
                }
            }
        }
        if ir::is_jump(op2) && op2 != 15 {
            exchange(&mut f.epoch, f.epoch + 1);
        }
        if op2 == 29 || op2 == 30 {
            exchange(&mut f.epoch, f.epoch + 1);
        }
        i += 1;
    }
}
fn count_reads<a, c>(o: (&a ir::Body), f: (&c mut F), first: u64, last: u64) {
    for n in f.reads.len() {
        ir::put(&mut f.reads, n, 0);
    }
    for i in last - first {
        j := first + i;
        if o.del[j] == 0 {
            if ir::slot_read(&o, j, 0) {
                n := o.v0[j] / 8;
                ir::put(&mut f.reads, n, f.reads[n] + 1);
            }
            if ir::slot_read(&o, j, 1) {
                n := o.v1[j] / 8;
                ir::put(&mut f.reads, n, f.reads[n] + 1);
            }
        }
    }
}
fn dead_stores<a, c>(o: (&a mut ir::Body), f: (&c mut F), first: u64, last: u64) {
    count_reads(&o, &mut f, first, last);
    for i in last - first {
        j := first + i;
        if (o.del[j] == 0) & (o.op[j] == 1) & (o.k1[j] == 2) {
            n := o.v1[j] / 8;
            if (f.bad[n] == 0) & (f.reads[n] == 0) {
                kill(&mut o, j);
            }
        }
    }
}
// Function-wide backward liveness over the label graph (iterated to a fixed point); unknown
// jump targets and unrecognized instructions make every register live.
fn live_pass<a, c>(o: (&a mut ir::Body), lin: (&c mut u64[]), remove: u64) -> u64 {
    last := o.op.len();
    mut live = 0;
    mut i = last;
    mut changed = 0;
    while 0 < i {
        i -= 1;
        if (o.del[i] == 0) & (o.tr[i] == 0) {
            op := o.op[i];
            if op == 100 {
                if lin[i] != live {
                    ir::put(&mut lin, i, live);
                    changed = 1;
                }
            } else {
                if op != 101 {
                    if op == 16 || (16 < op && op < 25) {
                        t := jump_target(&o, i);
                        mut there = ir::all_regs();
                        if t < last {
                            there = lin[t];
                        }
                        if op == 16 {
                            live = there;
                        } else {
                            live = live | there;
                        }
                    } else {
                        if op == 29 || op == 30 {
                            live = ir::result_live(&o);
                        } else {
                            if op == 0 {
                                live = ir::all_regs();
                            } else {
                                mut removable = 0;
                                if remove != 0 && ir::movelike(op) && o.k1[i] == 1 {
                                    q := o.v1[i];
                                    if ((live >> q) & 1) == 0 && q != 4 && q != 5 {
                                        removable = 1;
                                    }
                                    if (op == 1) & (o.k0[i] == 1) & (o.v0[i] == q) {
                                        removable = 1;
                                    }
                                }
                                if removable != 0 {
                                    kill(&mut o, i);
                                } else {
                                    live = (live & (ir::all_regs() - ir::writes(&o, i)))
                                        | ir::reads(&o, i);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return changed;
}
fn dead_defs<a, b>(o: (&a mut ir::Body), s: &b [u8], first: u64, last: u64) {
    mut lin = u64[];
    for i in last {
        lin.push(0);
    }
    mut rounds = 0;
    while rounds < 50 {
        rounds += 1;
        if live_pass(&mut o, &mut lin, 0) == 0 {
            break;
        }
    }
    if rounds < 50 {
        live_pass(&mut o, &mut lin, 1);
    }
}
fn next_live<a>(o: (&a ir::Body), i: u64, last: u64) -> u64 {
    mut j = i + 1;
    while j < last {
        if (o.del[j] == 0) & (o.op[j] != 101) {
            return j;
        }
        j += 1;
    }
    return last;
}
fn next_insn<a>(o: (&a ir::Body), i: u64, last: u64) -> u64 {
    mut j = next_live(&o, i, last);
    while j < last {
        if o.op[j] != 100 {
            return j;
        }
        j = next_live(&o, j, last);
    }
    return last;
}
// Whether register r is dead after instruction i: followed forward through jumps (bounded).
fn dead_after<a>(o: (&a ir::Body), i: u64, r: u64, budget: u64) -> bool {
    last := o.op.len();
    if budget == 0 {
        return false;
    }
    mut j = i;
    mut steps = 0;
    while steps < 40 {
        steps += 1;
        j = next_insn(&o, j, last);
        if j >= last {
            return false;
        }
        op := o.op[j];
        rd := ir::reads(&o, j);
        if ((rd >> r) & 1) != 0 {
            return false;
        }
        if op == 0 {
            return false;
        }
        wr := ir::writes(&o, j);
        if ((wr >> r) & 1) != 0 {
            return true;
        }
        if ir::is_jump(op) && op != 15 {
            t := jump_target(&o, j);
            if t >= last {
                return false;
            }
            if op == 16 {
                j = t;
            } else {
                if !dead_after(&o, t, r, budget - 1) {
                    return false;
                }
            }
        }
        if op == 29 || op == 30 {
            return false;
        }
    }
    return false;
}
fn jump_target<a>(o: (&a ir::Body), j: u64) -> u64 {
    last := o.op.len();
    if o.k0[j] != 4 || o.v0[j] == 0 {
        return last;
    }
    n := o.v0[j] - 1;
    base := o.base;
    if o.m0[j] != 0 {
        return last;
    }
    if n < base {
        return last;
    }
    if n - base >= o.table.len() {
        return last;
    }
    t := o.table[n - base];
    if t == 0 {
        return last;
    }
    return t - 1;
}
// The self-check behind GRAIL_OPT_STATS=1: one comment line per body, `# grail-jumps <known>
// <unknown>`, counting the direct jumps the passes will see a target line for and the ones they
// will not (a label this body does not define, a spelling label_number does not read, or every jump
// of a body left as written). The passes fall back silently on an unknown target, so a parser that
// stops recognising the labels the backend mints costs speed and nothing fails; a test sums these
// over the compiler's own sources (tools/test-optimiser-jumps.mjs).
fn jump_stats<a>(o: (&a mut ir::Body), last: u64) {
    if host::env(view("GRAIL_OPT_STATS")).len() == 0 {
        return ();
    }
    mut known = 0;
    mut unknown = 0;
    for i in last {
        if (15 < o.op[i]) & (o.op[i] < 25) & (o.k0[i] == 4) {
            if (o.weird == 0) && (jump_target(&o, i) < last) {
                known += 1;
            } else {
                unknown += 1;
            }
        }
    }
    app(&mut o.out, view("# grail-jumps "));
    ir::append_num(&mut o.out, known);
    app(&mut o.out, view(" "));
    ir::append_num(&mut o.out, unknown);
    app(&mut o.out, view("\n"));
}
fn gen_number<a>(o: (&a mut ir::Body), n: u64) -> u64 {
    start := o.gen.len();
    if 9 < n {
        gen_number(&mut o, n / 10);
    }
    o.gen.push(48 + n % 10);
    return start;
}
fn gen_imm<a>(o: (&a mut ir::Body), n: u64, i: u64, j: u64) {
    start := o.gen.len();
    o.gen.push(36);
    gen_number(&mut o, n);
    end := o.gen.len();
    set_operand(&mut o, i, j, 5, 0);
    set_range(&mut o, i, j, start, end);
}
fn imm_value<a, b>(o: (&a ir::Body), s: &b [u8], i: u64) -> u64 {
    // Decimal immediate of operand 0, PLUS ONE; 0 when operand 0 is not an immediate this can read
    // (not decimal, or wider than 18 digits - an f64 constant's bits often are). So a zero immediate
    // is 1, and 0 means "unknown", never "zero": comparing with 0 for a zero value is the mistake
    // that read `two: f32 := 2.0` ($4611686018427387904) as 0.0 in f32 narrowing.
    if o.k0[i] != 3 {
        return 0;
    }
    a := o.s0[i] + 1;
    e := o.e0[i];
    if e <= a || e - a > 18 {
        return 0;
    }
    mut n = 0;
    for k in e - a {
        d := s[a + k];
        if d < 48 || 57 < d {
            return 0;
        }
        n = n * 10 + d - 48;
    }
    return n + 1;
}
fn peephole<a, b>(o: (&a mut ir::Body), s: &b [u8], first: u64, last: u64) {
    mut i = first;
    while i < last {
        if o.del[i] != 0 {
            i += 1;
            continue;
        }
        op := o.op[i];
        // setCC %al; movzbq %al,%rax; [xorq $1,%rax]; testq %rax,%rax; jz/jnz L  ->  jCC L
        if op == 25 || op == 26 || op == 27 {
            a := next_live(&o, i, last);
            if a < last {
                if (o.op[a] == 28) & (o.k1[a] == 1) & (o.v1[a] == 0) {
                    mut b = next_live(&o, a, last);
                    mut invert = 0;
                    if b < last {
                        if (o.op[b] == 10)
                            & (o.k1[b] == 1)
                            & (o.v1[b] == 0)
                            & (imm_value(&o, view(s), b) == 2) {
                            invert = 1;
                            b = next_live(&o, b, last);
                        }
                    }
                    if b < last {
                        if (o.op[b] == 7)
                            & (o.k0[b] == 1)
                            & (o.v0[b] == 0)
                            & (o.k1[b] == 1)
                            & (o.v1[b] == 0) {
                            c := next_live(&o, b, last);
                            if c < last {
                                jop := o.op[c];
                                if jop == 17 || jop == 18 || jop == 19 || jop == 20 {
                                    t := jump_target(&o, c);
                                    if t < last {
                                        // Six levels: a loop's exit often runs through a chain
                                        // of drop-flag tests before anything writes %rax.
                                        if dead_after(&o, c, 0, 6)
                                            & dead_after(&o, t, 0, 6) {
                                            // jump when the value is non-zero (jnz/jne) or zero (jz/je)
                                            mut when = jop == 19 || jop == 20;
                                            if invert != 0 {
                                                when = !when;
                                            }
                                            mut nj = 0;
                                            if op == 25 {
                                                if when {
                                                    nj = 17;
                                                } else {
                                                    nj = 19;
                                                }
                                            }
                                            if op == 26 {
                                                if when {
                                                    nj = 19;
                                                } else {
                                                    nj = 17;
                                                }
                                            }
                                            if op == 27 {
                                                if when {
                                                    nj = 23;
                                                } else {
                                                    nj = 22;
                                                }
                                            }
                                            ir::put(&mut o.op, c, nj);
                                            ir::put(&mut o.chg, c, 1);
                                            kill(&mut o, i);
                                            kill(&mut o, a);
                                            kill(&mut o, b);
                                            if invert != 0 {
                                                mut x = next_live(&o, a, last);
                                                if x < c {
                                                    if o.op[x] == 10 {
                                                        kill(&mut o, x);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // testq %rcx,%rcx; jnz L; call rt_abort; L: xorq %rdx,%rdx; divq %rcx with rcx = 2^k
        if (op == 7) & (o.k0[i] == 1) & (o.v0[i] == 1) & (o.k1[i] == 1) & (o.v1[i] == 1) {
            j := next_live(&o, i, last);
            if j < last {
                if o.op[j] == 20 {
                    c := next_live(&o, j, last);
                    if c < last {
                        if (o.op[c] == 15)
                            & (o.k0[c] == 4)
                            & ir::same_range(view(s), o.s0[c], o.e0[c], view("rt_abort")) {
                            x := next_insn(&o, c, last);
                            if x < last {
                                if (o.op[x] == 10)
                                    & (o.k0[x] == 1)
                                    & (o.v0[x] == 2)
                                    & (o.k1[x] == 1)
                                    & (o.v1[x] == 2) {
                                    d := next_live(&o, x, last);
                                    if d < last {
                                        if (o.op[d] == 13) & (o.k0[d] == 1) & (o.v0[d] == 1) {
                                            // Find the constant in rcx: last definition before the test.
                                            mut k = i;
                                            mut value = 0;
                                            mut steps = 0;
                                            while (first < k) & (steps < 8) {
                                                k -= 1;
                                                steps += 1;
                                                if o.del[k] == 0 {
                                                    kop := o.op[k];
                                                    if kop == 100 || kop == 0 || ir::is_jump(kop) {
                                                        break;
                                                    }
                                                    if ((ir::writes(&o, k) >> 1) & 1) != 0 {
                                                        if (kop == 1 || kop == 2)
                                                            && o.k1[k] == 1 {
                                                            value = imm_value(&o, view(s), k);
                                                        }
                                                        break;
                                                    }
                                                }
                                            }
                                            if (value > 1) & (value < 2147483650) {
                                                v := value - 1;
                                                if (v & (v - 1)) == 0 {
                                                    mut shift = 0;
                                                    while (1 << shift) < v {
                                                        shift += 1;
                                                    }
                                                    ir::put(&mut o.op, i, 1);
                                                    set_operand(&mut o, i, 0, 1, 0);
                                                    set_operand(&mut o, i, 1, 1, 2);
                                                    ir::put(&mut o.op, j, 8);
                                                    gen_imm(&mut o, v - 1, j, 0);
                                                    set_operand(&mut o, j, 1, 1, 2);
                                                    ir::put(&mut o.op, c, 34);
                                                    gen_imm(&mut o, shift, c, 0);
                                                    set_operand(&mut o, c, 1, 1, 0);
                                                    kill(&mut o, x);
                                                    kill(&mut o, d);
                                                    ir::put(&mut o.tr, i, 0);
                                                    ir::put(&mut o.tr, j, 0);
                                                    ir::put(&mut o.tr, c, 0);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1;
    }
}
// Which of the frame slots `cands` (slot numbers, `-8n(%rbp)`) may be read before they are written
// on some path from the prologue: 1 for those, per candidate. A slot whose address is taken, or
// that an instruction this pass does not read uses, counts as read (`slot_plain`). The prologue's
// zeroing (the cleared frame's 0, or `movq $0` into a promoted register) is only needed for these:
// for any other slot every read sees a value the body wrote first.
fn slots_live_in<a, b>(o: (&a ir::Body), s: &b [u8], cands: (&u64[]), prologue: u64) -> u64[] {
    mut out = u64[];
    for c in cands.len() {
        out.push(0);
    }
    mut at = 0;
    while at < cands.len() {
        mut n = cands.len() - at;
        if 60 < n {
            n = 60;
        }
        mut chunk = u64[];
        for c in n {
            chunk.push(cands[at + c]);
        }
        mask := chunk_live_in(&o, view(s), &chunk, prologue);
        for c in n {
            if ((mask >> c) & 1) != 0 {
                ir::put(&mut out, at + c, 1);
            } else if !slot_plain(&o, chunk[c]) {
                ir::put(&mut out, at + c, 1);
            }
        }
        at += n;
    }
    return out;
}
// Every use of slot `n` is an operand of an instruction the liveness below reads (not an address
// taken by `leaq`, not an instruction the parser left opaque).
fn slot_plain<a>(o: (&a ir::Body), n: u64) -> bool {
    at := n * 8;
    for i in o.op.len() {
        if o.del[i] != 0 {
            continue;
        }
        uses := ((o.k0[i] == 2) && (o.v0[i] == at)) || ((o.k1[i] == 2) && (o.v1[i] == at));
        if uses && ((o.op[i] == 3) || (o.op[i] == 0)) {
            return false;
        }
    }
    return true;
}
// Backward liveness of up to 60 slots (bit c for `cands[c]`) over the label graph, to a fixpoint;
// the bits live just after the prologue. A read is a slot first operand, or a slot destination of
// an instruction that is not a plain move (`addq $1,-8(%rbp)` reads it too); a plain move into the
// slot writes it.
fn chunk_live_in<a, b>(o: (&a ir::Body), s: &b [u8], cands: (&u64[]), prologue: u64) -> u64 {
    last := o.op.len();
    all := (1 << cands.len()) - 1;
    mut lin = u64[];
    for i in last {
        lin.push(0);
    }
    mut result = 0;
    mut changed = 1;
    mut rounds = 0;
    while (changed != 0) && (rounds < 64) {
        changed = 0;
        rounds += 1;
        mut live = 0;
        mut i = last;
        while 0 < i {
            i -= 1;
            if i == prologue {
                result = live;
            }
            // Fused lines (`tr`) are read like any other: a missed read would clear too little.
            if o.del[i] != 0 {
                continue;
            }
            op := o.op[i];
            if op == 101 {
                continue;
            }
            if op == 100 {
                if lin[i] != live {
                    ir::put(&mut lin, i, live);
                    changed = 1;
                }
                continue;
            }
            if ir::is_jump(op) && (op != 15) {
                t := jump_target(&o, i);
                mut there = all;
                if t < last {
                    there = lin[t];
                }
                if op == 16 {
                    live = there;
                } else {
                    live = live | there;
                }
                continue;
            }
            if (op == 29) || (op == 30) {
                live = 0;
                continue;
            }
            if (op == 15) && never_returns(&o, view(s), i) {
                live = 0;
                continue;
            }
            for c in cands.len() {
                at := cands[c] * 8;
                if (o.k1[i] == 2) && (o.v1[i] == at) {
                    if ir::movelike(op) {
                        live = live & (all - (1 << c));
                    } else {
                        live = live | (1 << c);
                    }
                }
                if (o.k0[i] == 2) && (o.v0[i] == at) {
                    live = live | (1 << c);
                }
            }
        }
    }
    if changed != 0 {
        // No fixpoint in the bound: every candidate is taken as read.
        return all;
    }
    return result;
}
// Slot use permitted after promotion: the instruction stays valid with a register operand.
fn promotable_use<a>(o: (&a ir::Body), i: u64) -> bool {
    op := o.op[i];
    if op == 1
        || op == 4
        || op == 5
        || op == 6
        || op == 7
        || op == 8
        || op == 9
        || op == 10
        || op == 14 {
        mut other = o.k1[i];
        if o.k1[i] == 2 {
            other = o.k0[i];
        }
        return (other == 0) || (other == 1) || (other == 3) || (other == 5);
    }
    return (op == 11) || (op == 12) || (op == 13);
}
fn emit_operand<a, b>(o: (&a mut ir::Body), s: &b [u8], i: u64, j: u64) {
    mut k = o.k0[i];
    mut v = o.v0[i];
    mut a = o.s0[i];
    mut e = o.e0[i];
    if j != 0 {
        k = o.k1[i];
        v = o.v1[i];
        a = o.s1[i];
        e = o.e1[i];
    }
    if k == 1 {
        o.out.push(37);
        reg_name(&mut o, v);
        return ();
    }
    if k == 2 {
        o.out.push(45);
        out_number(&mut o, v);
        app(&mut o.out, view("(%rbp)"));
        return ();
    }
    // A frame slot promoted to an SSE register (`v` is its number).
    if k == 7 {
        app(&mut o.out, view("%xmm"));
        out_number(&mut o, v);
        return ();
    }
    if k == 5 {
        for x in e - a {
            c := o.gen[a + x];
            o.out.push(c);
        }
        return ();
    }
    for x in e - a {
        o.out.push(s[a + x]);
    }
}
fn reg_name<a>(o: (&a mut ir::Body), r: u64) {
    if r == 0 {
        app(&mut o.out, view("rax"));
        return ();
    }
    if r == 1 {
        app(&mut o.out, view("rcx"));
        return ();
    }
    if r == 2 {
        app(&mut o.out, view("rdx"));
        return ();
    }
    if r == 3 {
        app(&mut o.out, view("rbx"));
        return ();
    }
    if r == 4 {
        app(&mut o.out, view("rsp"));
        return ();
    }
    if r == 5 {
        app(&mut o.out, view("rbp"));
        return ();
    }
    if r == 6 {
        app(&mut o.out, view("rsi"));
        return ();
    }
    if r == 7 {
        app(&mut o.out, view("rdi"));
        return ();
    }
    if r == 8 {
        app(&mut o.out, view("r8"));
        return ();
    }
    if r == 9 {
        app(&mut o.out, view("r9"));
        return ();
    }
    if r == 10 {
        app(&mut o.out, view("r10"));
        return ();
    }
    if r == 11 {
        app(&mut o.out, view("r11"));
        return ();
    }
    if r == 12 {
        app(&mut o.out, view("r12"));
        return ();
    }
    if r == 13 {
        app(&mut o.out, view("r13"));
        return ();
    }
    if r == 14 {
        app(&mut o.out, view("r14"));
        return ();
    }
    if r == 15 {
        app(&mut o.out, view("r15"));
        return ();
    }
}
fn out_number<a>(o: (&a mut ir::Body), n: u64) {
    if 9 < n {
        out_number(&mut o, n / 10);
    }
    o.out.push(48 + n % 10);
}
// The leaf runtime accessors written in line: 40 rt_slot, 41 rt_at, 42 rt_len, 43 rt_xchg, 44 rt_atb,
// 45 rt_push, 46 rt_pushb, 47 rt_slotu, 48 rt_atbu, 49 rt_slot4, 50 rt_slot4u, 51 rt_at4,
// 52 the sized element address (index * element size in %rdx, unboxed-values stage 1b) (ir.grl
// parse). The arguments are where the call put them (%rdi, %rsi) and the result is in %rax, so the
// text replaces the `call` exactly. `label` with `n` (and `more` for the push forms) names the local
// labels; a bounds check that fails calls `rt_abort`, as the accessor would have.
// This is lowering, not optimisation: `lower_leaf_calls` runs it on a build the optimiser skips.
pub fn leaf_expansion<a, b>(out: (&a mut u8[]), op: u64, label: &b [u8], n: u64, more: u64, trap: u64) {
    if op == 55 {
        // rt_write: a byte store into a u8[]. The front end has already checked that the value is a
        // byte (a u8, or the `< 256` check it emits before the call), so only the index is checked,
        // and it fails as rt_atb's does.
        out.append(view("cmpq 8(%rdi),%rsi\njb .L"));
        out.append(label);
        put_num(&mut out, n);
        if trap != 0 {
            out.append(view("\nmovq $1,%rdx\ncall rt_trap\n.L"));
        } else {
            out.append(view("\ncall rt_abort\n.L"));
        }
        out.append(label);
        put_num(&mut out, n);
        out.append(view(":\nmovq (%rdi),%rax\nmovb %dl,(%rax,%rsi,1)\n"));
        return ();
    }
    if op == 54 {
        out.append(view("movq %rsi,%rax\nimulq %rdx,%rax\naddq %rdi,%rax\n"));
        return ();
    }
    if op == 53 {
        // A fixed-size array's element: the length is the constant in %rdx, so the check reads no
        // memory. A failure reports `rt_fail(1, index, length)` from this frame, as rt_aslot would.
        out.append(view("cmpq %rdx,%rsi\njb .L"));
        out.append(label);
        put_num(&mut out, n);
        out.append(view("\nmovq $1,%rdi\ncall rt_fail\n.L"));
        out.append(label);
        put_num(&mut out, n);
        out.append(view(":\nmovq %rsi,%rax\nimulq %rcx,%rax\naddq %rdi,%rax\n"));
        return ();
    }
    if op == 40 || op == 41 || op == 44 || op == 49 || op == 51 || op == 52 {
        out.append(view("cmpq 8(%rdi),%rsi\njb .L"));
        out.append(label);
        put_num(&mut out, n);
        // With no site table to turn `call rt_abort` into a located `rt_trap` later (`trap`), the
        // failure is reported here as the accessor would: an index check on the vector in %rdi,
        // which a task can contain.
        if trap != 0 {
            out.append(view("\nmovq $1,%rdx\ncall rt_trap\n.L"));
        } else {
            out.append(view("\ncall rt_abort\n.L"));
        }
        out.append(label);
        put_num(&mut out, n);
        if op == 52 {
            out.append(view(":\nmovq %rsi,%rax\nimulq %rdx,%rax\naddq (%rdi),%rax\n"));
        } else if op == 49 {
            out.append(view(":\nmovq (%rdi),%rax\nleaq (%rax,%rsi,4),%rax\n"));
        } else if op == 51 {
            out.append(view(":\nmovq (%rdi),%rax\nmovl (%rax,%rsi,4),%eax\n"));
        } else if op == 40 {
            out.append(view(":\nmovq (%rdi),%rax\nleaq (%rax,%rsi,8),%rax\n"));
        } else if op == 41 {
            out.append(view(":\nmovq (%rdi),%rax\nmovq (%rax,%rsi,8),%rax\n"));
        } else {
            out.append(view(":\nmovq (%rdi),%rax\nmovzbq (%rax,%rsi,1),%rax\n"));
        }
        return ();
    }
    if op == 42 {
        out.append(view("movq 8(%rdi),%rax\n"));
        return ();
    }
    if op == 43 {
        out.append(view("movq (%rdi),%rax\nmovq %rsi,(%rdi)\n"));
        return ();
    }
    if op == 47 {
        out.append(view("movq (%rdi),%rax\nleaq (%rax,%rsi,8),%rax\n"));
        return ();
    }
    if op == 48 {
        out.append(view("movq (%rdi),%rax\nmovzbq (%rax,%rsi,1),%rax\n"));
        return ();
    }
    if op == 50 {
        out.append(view("movq (%rdi),%rax\nleaq (%rax,%rsi,4),%rax\n"));
        return ();
    }
    if op == 45 || op == 46 {
        fast := n;
        done := more;
        app(&mut out, view("movq 8(%rdi),%rcx\ncmpq 16(%rdi),%rcx\njb .L"));
        out.append(label);
        put_num(&mut out, fast);
        if op == 45 {
            app(&mut out, view("\ncall rt_push\njmp .L"));
        } else {
            app(&mut out, view("\ncall rt_pushb\njmp .L"));
        }
        out.append(label);
        put_num(&mut out, done);
        app(&mut out, view("\n.L"));
        out.append(label);
        put_num(&mut out, fast);
        if op == 45 {
            app(
                &mut out,
                view(":\nmovq (%rdi),%rdx\nmovq %rsi,(%rdx,%rcx,8)\nincq %rcx\nmovq %rcx,8(%rdi)\n")
            );
        } else {
            app(
                &mut out,
                view(":\nleaq 1(%rcx),%rdx\nmovq %rdx,8(%rdi)\naddq (%rdi),%rcx\nmovq %rsi,%rax\nmovb %al,(%rcx)\n")
            );
        }
        app(&mut out, view("movq $0,%rax\n.L"));
        out.append(label);
        put_num(&mut out, done);
        app(&mut out, view(":\n"));
        return ();
    }
}
fn put_num<a>(out: (&a mut u8[]), n: u64) {
    if 9 < n {
        put_num(&mut out, n / 10);
    }
    out.push(48 + n % 10);
}
// A build the optimiser does not run on (`--debug`) still gets the leaf accessors in line: every
// line that is exactly `call NAME` for one of them becomes its expansion, with labels of its own.
// Stack probes (docs/design/fixed-arrays.md): before a frame larger than a page is allocated, the
// stack pointer walks down to it one page at a time and touches each page, so the first page past
// the stack's end that is touched is its guard page, within a page of the stack pointer - where the
// overflow handler reports `stack overflow` - and never a mapping beyond it. The frame sizes are the
// final ones, the `.set .F<n>,SIZE` lines; the probe goes before the `subq $.F<n>,%rsp` that uses one.
// Its loop label is named after the frame constant (`.Lgrail_probe_F<n>`), so a part probed on its own
// (--split) spells it as the whole stream does.
// Windows (`after` = 1) describes its prologue to the unwinder as exactly `pushq %rbp`, `movq
// %rsp,%rbp` and the frame line, so there the probe follows the frame line: the frame is already
// allocated and its pages are touched from the top down, which is what Windows' guard-page growth
// needs (it is `__chkstk`'s job), with only %rax, %r10 and %r11, which carry no argument.
pub fn probe_frames<a>(s: &a [u8], after: u64) -> u8[] {
    // The scan the backstop reads is the one that finds the frames: a stream with no frame over a
    // page - nearly every one - is read once, checked, and returned as it is.
    scan := frame_scan(view(s));
    if scan.names.len() == 0 {
        frame_check(view(s), &scan);
        return s.copy();
    }
    names := &scan.names;
    sizes := &scan.sizes;
    mut out = u8[];
    mut a = 0;
    while a < s.len() {
        mut e = a;
        while (e < s.len()) && (s[e] != 10) {
            e += 1;
        }
        mut name = u8[];
        // The frame line is `subq $.F<n>,%rsp`, or `subq $.F<n>+K,%rsp` when the frame also saves
        // callee-saved registers below the slots: the probe then covers the K bytes too.
        mut extra: u64 = 0;
        if (e - a > 12) && ir::at(view(s), a, view("subq $.F")) && ir::at(view(s), e - 5, view(",%rsp")) {
            mut stop = a + 6;
            while (stop < e - 5) && (s[stop] != 43) {
                stop += 1;
            }
            name = s[a + 6: stop].copy();
            if stop < e - 5 {
                for x in stop + 1..e - 5 {
                    if (48 <= s[x]) & (s[x] <= 57) {
                        extra = extra * 10 + u64(s[x] - 48);
                    }
                }
            }
        }
        if (after != 0) && (e - a > 11) && ir::at(view(s), a, view("framesub .F")) {
            mut stop = a + 9;
            while (stop < e) && (s[stop] != 43) {
                stop += 1;
            }
            name = s[a + 9: stop].copy();
            if stop < e {
                for x in stop + 1..e {
                    if (48 <= s[x]) & (s[x] <= 57) {
                        extra = extra * 10 + u64(s[x] - 48);
                    }
                }
            }
        }
        if after != 0 {
            for x in e - a {
                out.push(s[a + x]);
            }
            out.push(10);
        }
        if name.len() != 0 {
            for i in names.len() {
                if names[i].len() == name.len() {
                    mut same = true;
                    for j in name.len() {
                        if names[i][j] != name[j] {
                            same = false;
                        }
                    }
                    if same && (4096 < sizes[i] + extra) {
                        pages := (sizes[i] + extra + 4095) / 4096;
                        if after != 0 {
                            out.append(view("movq %rbp,%rax\nmovq $"));
                            put_num(&mut out, pages);
                            out.append(view(",%r11\n.Lgrail_probe_"));
                            out.append(name[1..name.len()]);
                            out.append(view(":\nsubq $4096,%rax\nmovq (%rax),%r10\nsubq $1,%r11\njnz .Lgrail_probe_"));
                            out.append(name[1..name.len()]);
                            out.append(view("\n"));
                        } else {
                            out.append(view("movq $"));
                            put_num(&mut out, pages);
                            out.append(view(",%rax\n.Lgrail_probe_"));
                            out.append(name[1..name.len()]);
                            out.append(view(":\nsubq $4096,%rsp\nmovq $0,(%rsp)\nsubq $1,%rax\njnz .Lgrail_probe_"));
                            out.append(name[1..name.len()]);
                            out.append(view("\nmovq %rbp,%rsp\n"));
                        }
                    }
                }
            }
        }
        if after == 0 {
            for x in e - a {
                out.push(s[a + x]);
            }
            if e < s.len() {
                out.push(10);
            }
        }
        a = e + 1;
    }
    probe_backstop(view(out));
    return out;
}
// What one pass over a stream finds for the probes: the frame constants that can reach a page
// (`.set .F<n>,SIZE`, with SIZE + 128 over 4096), the probe loops present (`.Lgrail_probe_<n>:`, as
// `.F<n>`), and every line that moves %rsp down - its range in `down`, and the range of the label
// line of the function it is in (for the error) in `func`, both as start/end pairs.
struct FrameScan {
    names: u8[][],
    sizes: u64[],
    probed: u8[][],
    down: u64[],
    func: u64[]
}
fn frame_scan<a>(s: &a [u8]) -> FrameScan {
    mut f = FrameScan { names: u8[][], sizes: u64[], probed: u8[][], down: u64[], func: u64[] };
    mut fa = 0;
    mut fe = 0;
    n := s.len();
    mut a = 0;
    while a < n {
        mut e = a;
        while (e < n) && (s[e] != 10) {
            e += 1;
        }
        if e > a {
            first := s[a];
            if first == 46 {
                if (e - a > 8) && ir::at(view(s), a, view(".set .F")) {
                    mut comma = a;
                    while (comma < e) && (s[comma] != 44) {
                        comma += 1;
                    }
                    mut v: u64 = 0;
                    for x in comma + 1..e {
                        if (48 <= s[x]) & (s[x] <= 57) {
                            v = v * 10 + u64(s[x] - 48);
                        }
                    }
                    // Every frame: the saved-register area a frame line adds (`+K`, well under 128
                    // bytes) can carry one just under a page over it.
                    if 4096 < v + 128 {
                        f.names.push(s[a + 5: comma].copy());
                        f.sizes.push(v);
                    }
                } else if (e - a > 15) && (s[e - 1] == 58) && ir::at(view(s), a, view(".Lgrail_probe_")) {
                    mut p = u8[];
                    p.push(46);
                    p.append(s[a + 14: e - 1]);
                    f.probed.push(p);
                }
            } else if s[e - 1] == 58 {
                fa = a;
                fe = e - 1;
            } else if ((first == 102) && ir::at(view(s), a, view("framesub "))) || ((first == 115) && (6 < e - a) && ir::at(view(s), a, view("subq $")) && ir::at(view(s), e - 5, view(",%rsp"))) {
                f.down.push(a);
                f.down.push(e);
                f.func.push(fa);
                f.func.push(fe);
            }
        }
        a = e + 1;
    }
    return f;
}
// The backstop for the probes (the stack's guard page is a safety property, so it must not rest on
// one spelling of the frame line): every frame line - a line that moves %rsp down by a `.F`
// constant (`subq $.F<n>...,%rsp`, `framesub .F<n>...`) or by a literal - whose frame, with what the
// line adds (`+K`), is larger than a page must be followed by its probe (`.Lgrail_probe_<n>`), or
// the compiler stops with an internal error naming the function. One pass over the text.
pub fn probe_backstop<a>(s: &a [u8]) {
    scan := frame_scan(view(s));
    frame_check(view(s), &scan);
}
fn frame_check<a, b>(s: &a [u8], f: (&b FrameScan)) {
    for d in f.down.len() / 2 {
        a := f.down[2 * d];
        e := f.down[2 * d + 1];
        // The constant the line names, and the bytes it adds.
        mut at = a;
        while (at + 1 < e) && !((s[at] == 46) && (s[at + 1] == 70)) {
            at += 1;
        }
        mut bytes: u64 = 0;
        mut ns = 0;
        mut ne = 0;
        if at + 1 < e {
            mut stop = at;
            while (stop < e) && (s[stop] != 43) && (s[stop] != 44) && (s[stop] != 32) {
                stop += 1;
            }
            ns = at;
            ne = stop;
            for i in f.names.len() {
                if ir::same_range(view(s), ns, ne, view(f.names[i])) {
                    bytes = f.sizes[i];
                }
            }
            if (stop < e) && (s[stop] == 43) {
                mut k: u64 = 0;
                mut x = stop + 1;
                while (x < e) && (48 <= s[x]) & (s[x] <= 57) {
                    k = k * 10 + u64(s[x] - 48);
                    x += 1;
                }
                bytes = bytes + k;
            }
        } else {
            // A literal frame: the immediate itself.
            mut x = a + 6;
            while (x < e) && (48 <= s[x]) & (s[x] <= 57) {
                bytes = bytes * 10 + u64(s[x] - 48);
                x += 1;
            }
        }
        if 4096 < bytes {
            mut ok = false;
            if ne != ns {
                for i in f.probed.len() {
                    if ir::same_range(view(s), ns, ne, view(f.probed[i])) {
                        ok = true;
                    }
                }
            }
            if !ok {
                host::print(view("grail: internal compiler error: "));
                host::print(s[f.func[2 * d]..f.func[2 * d + 1]]);
                host::print(view("'s frame is larger than a page and has no stack probe ("));
                host::print(s[a..e]);
                host::print(view(")\n"));
                host::exit(70);
            }
        }
    }
}
pub fn lower_leaf_calls<a>(s: &a [u8]) -> u8[] {
    mut out = u8[];
    mut n: u64 = 0;
    mut a = 0;
    while a < s.len() {
        mut e = a;
        while (e < s.len()) && (s[e] != 10) {
            e += 1;
        }
        mut op = 0;
        if (e - a > 7) && ir::at(view(s), a, view("call rt_")) {
            name := s[a + 5: e].copy();
            op = leaf_op(view(name));
        }
        if op != 0 {
            n += 1;
            first := n;
            mut more = 0;
            if op == 45 || op == 46 {
                n += 1;
                more = n;
            }
            leaf_expansion(&mut out, op, view("grail_leaf_"), first, more, 1);
        } else {
            for x in e - a {
                out.push(s[a + x]);
            }
            if e < s.len() {
                out.push(10);
            }
        }
        a = e + 1;
    }
    return out;
}
fn leaf_op<a>(name: &a [u8]) -> u64 {
    names := u8[][copy_text(view("rt_slot")), copy_text(view("rt_at")), copy_text(view("rt_len")), copy_text(view("rt_xchg")),
        copy_text(view("rt_atb")), copy_text(view("rt_push")), copy_text(view("rt_pushb")), copy_text(view("rt_slotu")),
        copy_text(view("rt_atbu")), copy_text(view("rt_slot4")), copy_text(view("rt_slot4u")), copy_text(view("rt_at4")),
        copy_text(view("rt_slotw")), copy_text(view("rt_aslot")), copy_text(view("rt_aslotu")), copy_text(view("rt_write"))];
    for i in names.len() {
        if names[i].len() == name.len() {
            mut same = true;
            for j in name.len() {
                if names[i][j] != name[j] {
                    same = false;
                }
            }
            if same {
                return 40 + i;
            }
        }
    }
    return 0;
}
fn emit_line<a, b>(o: (&a mut ir::Body), s: &b [u8], i: u64) {
    op := o.op[i];
    if ir::is_desc_op(op) {
        desc_expansion(&mut o, i);
        return ();
    }
    if (op == 86) || (op == 87) {
        array_imm_expansion(&mut o, view(s), i);
        return ();
    }
    if (39 < op) & (op < 56) {
        mut label = u8[];
        label.append(view("opt"));
        prefix := o.uprefix.copy();
        label.append(view(prefix));
        label.push(95);
        // Only the forms with labels number them, as they always have.
        mut n = 0;
        mut more = 0;
        if op == 40 || op == 41 || op == 44 || op == 49 || op == 51 || op == 52 || op == 53 || op == 55 || op == 45 || op == 46 {
            n = ir::uniq_take(&mut o);
        }
        if op == 45 || op == 46 {
            more = ir::uniq_take(&mut o);
        }
        leaf_expansion(&mut o.out, op, view(label), n, more, 0);
        return ();
    }
    if o.chg[i] == 0 {
        for x in o.le[i] - o.ls[i] {
            o.out.push(s[o.ls[i] + x]);
        }
        o.out.push(10);
        return ();
    }
    opname(&mut o, o.op[i]);
    if o.k0[i] != 0 {
        o.out.push(32);
        emit_operand(&mut o, view(s), i, 0);
        if o.k1[i] != 0 {
            o.out.push(44);
            emit_operand(&mut o, view(s), i, 1);
        }
    }
    o.out.push(10);
}
// `opt<unit prefix>_`: the namespace of the optimizer's own expansion labels, so a unit's `.Lopt`
// numbers do not depend on the expansions the units before it emitted.
fn opt_label<a>(o: (&a mut ir::Body)) {
    app(&mut o.out, view("opt"));
    prefix := o.uprefix.copy();
    app(&mut o.out, view(prefix));
    o.out.push(95);
}
fn emit_frame_slot<a, b>(o: (&a mut ir::Body), s: &b [u8], p: u64, k: u64) {
    // -.FN-8(k+1)(%rbp), where .FN is the frame constant named by the prologue subq.
    app(&mut o.out, view("-"));
    for x in o.e0[p] - o.s0[p] - 1 {
        o.out.push(s[o.s0[p] + 1 + x]);
    }
    app(&mut o.out, view("-"));
    out_number(&mut o, 8 * (k + 1));
    app(&mut o.out, view("(%rbp)"));
}
// Turn the declared pairs into slot widths: 0 scalar, 1 first word, 2 second word. A pair whose
// second word would not be a frame slot cannot be modelled, so the function is copied unchanged
// rather than mis-lowered.
fn build_pairs<a>(o: (&a mut ir::Body), ns: u64) {
    exchange(&mut o.pair, u64[]);
    if o.dyn_pairs.len() == 0 {
        return ();
    }
    for i in ns {
        o.pair.push(0);
    }
    for i in o.dyn_pairs.len() {
        n := o.dyn_pairs[i];
        words := o.pair_widths[i];
        // Word j of the value is slot n - j: all of them must be frame slots of this body.
        if (0 < n) & (words - 1 <= n) & (n < ns) {
            ir::put(&mut o.pair, n, 1);
            for j in 1..words {
                ir::put(&mut o.pair, n - j, 2);
            }
        } else {
            exchange(&mut o.weird, 1);
        }
    }
}
// One parsed body: the typed IR layer first, then the serialisation if the caller asked for it,
// then the passes. The layer is built before the passes because the front end's type facts are
// keyed by the frame slot numbers the passes go on to compact
// (docs/design/typed-ir.md, "The serializer").
fn body<a, b, c, d, e>(o: (&a mut ir::Body), s: &b [u8], facts: (&c llvm::Facts), ix: (&d ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), call_syms: (&mut u8[][]), call_counts: (&mut u64[])) {
    ir::build(&mut o, view(s), facts, ix);
    if want_ir != 0 {
        ir::write_body(&o, view(s), &mut ir_text);
    }
    // What the effect recorder's count is held against: the calls this body parses to.
    call_syms.push(o.name.copy());
    call_counts.push(ir::count_calls(&o));
    // The slots the fact table says hold a slice's descriptor (F1 `what` 5: SEQ-STABLE, so its
    // `data` and `len` cannot change while the slice lives).
    mut desc = u64[];
    for n in o.sfact.len() {
        if (o.sfact[n] >> 8) == 5 {
            desc.push(n);
        }
    }
    function(&mut o, view(s), &desc);
}
fn function<a, b>(o: (&a mut ir::Body), s: &b [u8], desc: (&u64[])) {
    first := 0;
    last := o.op.len();
    ns := o.maxslot / 8 + 1;
    mut f = new_facts(ns);
    // Both words of a two-word value are opaque to the value passes: not promoted (bad), not
    // forwarded, and their stores are not dead - the handle names them, not the frame.
    build_pairs(&mut o, ns);
    if o.dyn_pairs.len() != 0 {
        for n in ns {
            if o.pair[n] != 0 {
                ir::put(&mut f.bad, n, 1);
            }
        }
    }
    slot_loads(&mut o, view(s), last);
    // Frame shape: escaping slots, prologue position, label table and loop depth.
    mut prologue = 0;
    mut regs_used = 0;
    mut minlab = 0;
    mut maxlab = 0;
    for i in last {
        op := o.op[i];
        regs_used = regs_used
            | ir::mask_of(o.k0[i], o.v0[i], o.m0[i])
            | ir::mask_of(o.k1[i], o.v1[i], o.m1[i]);
        if op == 0 || op == 3 {
            if o.k0[i] == 2 {
                n := o.v0[i];
                ir::put(&mut f.bad, n / 8, 1);
            }
            if o.k1[i] == 2 {
                ir::put(&mut f.bad, o.v1[i] / 8, 1);
            }
        }
        if ((o.m0[i] >> 5) & 1) != 0 {
            // A load of an argument from the caller's stack (`movq 16(%rbp),%rax`) reads a word
            // no slot aliases and nothing in the body writes. It keeps its rbp mention, so a body
            // with one is never inlined into another frame (inline_candidate).
            if (op == 3) & (o.k0[i] == 4) & ir::at(view(s), o.s0[i], view("-.F")) {} else if (op == 1) & (o.k0[i] == 4) & (o.k1[i] == 1) & ir::incoming_arg(view(s), o.s0[i], o.e0[i]) {} else {
                exchange(&mut o.weird, 1);
            }
        }
        if ((o.m1[i] >> 5) & 1) != 0 {
            exchange(&mut o.weird, 1);
        }
        if (op == 5) & (prologue == 0) & (o.k1[i] == 1) & (o.v1[i] == 4) & (i == 4) {
            if ir::at(view(s), o.s0[i], view("$.F")) {
                prologue = i;
            }
        }
        if o.lab[i] != 0 {
            n := o.lab[i] - 1;
            if minlab == 0 {
                minlab = n + 1;
            } else {
                if n + 1 < minlab {
                    minlab = n + 1;
                }
            }
            if maxlab < n {
                maxlab = n;
            }
        }
        if op == 30 {
            mut p = i;
            mut prev = 0;
            while 0 < p {
                p -= 1;
                if (o.op[p] != 101) & (o.op[p] != 100) {
                    prev = o.op[p];
                    break;
                }
            }
            if prev != 29 {
                exchange(&mut o.weird, 1);
            }
        }
    }
    if o.weird != 0 {
        jump_stats(&mut o, last);
        for i in last {
            emit_line(&mut o, view(s), i);
        }
        return ();
    }
    o.table.clear();
    mut base = 0;
    if minlab != 0 {
        base = minlab - 1;
    }
    exchange(&mut o.base, base);
    mut refs = u64[];
    if minlab != 0 {
        for x in maxlab - base + 1 {
            o.table.push(0);
            refs.push(0);
        }
        for i in last {
            if o.lab[i] != 0 {
                ir::put(&mut o.table, o.lab[i] - 1 - base, i + 1);
            }
        }
        for i in last {
            for j in 2 {
                mut v = o.v0[i];
                if j != 0 {
                    v = o.v1[i];
                }
                mut k = o.k0[i];
                if j != 0 {
                    k = o.k1[i];
                }
                if (k == 4) & (v != 0) {
                    n := v - 1;
                    if n >= base {
                        if n - base < refs.len() {
                            ir::put(&mut refs, n - base, refs[n - base] + 1);
                        }
                    }
                }
            }
        }
    }
    jump_stats(&mut o, last);
    // Slices whose `data` and `len` can live in registers, and the accessors that read them.
    mut dslot = u64[];
    mut dwline = u64[];
    mut dacc = u64[];
    for i in last {
        dacc.push(0);
    }
    if prologue != 0 {
        desc_scan(&o, desc, &f, prologue, &mut dslot, &mut dwline, &mut dacc);
    }
    // `jcc L; call rt_abort; L:` is transparent: rt_abort never returns, so L is reached only
    // by the jump with the state that preceded it.
    for i in last {
        op := o.op[i];
        if (16 < op) & (op < 25) {
            t := jump_target(&o, i);
            if t < last {
                j := next_live(&o, i, last);
                if j < last {
                    if (o.op[j] == 15) & (o.k0[j] == 4) {
                        if ir::same_range(view(s), o.s0[j], o.e0[j], view("rt_abort")) {
                            if (o.lab[t] != 0)
                                & (next_live(&o, j, last) == t)
                                & (refs[o.lab[t] - 1 - base] == 1) {
                                ir::put(&mut o.tr, i, 1);
                                ir::put(&mut o.tr, j, 1);
                                ir::put(&mut o.tr, t, 1);
                            }
                        }
                    }
                }
            }
        }
    }
    forward(&mut o, &mut f, view(s), first, last);
    dead_stores(&mut o, &mut f, first, last);
    dead_defs(&mut o, view(s), first, last);
    array_imms(&mut o, view(s), last);
    const_branches(&mut o, view(s), last);
    dead_defs(&mut o, view(s), first, last);
    // Promotion: weights grow 16x per loop nesting level (backward jumps), so a slot touched once
    // an iteration outweighs any handful of straight-line accesses - at 4x, a function's drop flags
    // (set, tested and cleared outside the loop) took the registers and the loop bound stayed in the
    // frame.
    mut chosen = u64[];
    mut slots = u64[];
    // Which register each promoted single slot lives in (several slots may share one).
    mut mslot = u64[];
    mut mreg = u64[];
    // Per chosen register, 1 when it must be cleared after the saves (slots_live_in).
    mut zchosen = u64[];
    mut xchosen = u64[];
    mut xslots = u64[];
    mut xinit = u64[];
    // At a slice's store, which of them (+1) to load `data` and `len` from into their registers.
    mut dinit = u64[];
    for i in last {
        dinit.push(0);
    }
    mut dregs = u64[];
    // At a drop helper call, the SSE registers (bit per register number) to save around it.
    mut xsave = u64[];
    for i in last {
        xsave.push(0);
    }
    if prologue != 0 {
        mut opens = u64[];
        mut closes = u64[];
        for i in last + 1 {
            opens.push(0);
            closes.push(0);
        }
        for i in last {
            op := o.op[i];
            if ir::is_jump(op) && op != 15 && o.del[i] == 0 {
                t := jump_target(&o, i);
                if t < i {
                    ir::put(&mut opens, t, opens[t] + 1);
                    ir::put(&mut closes, i + 1, closes[i + 1] + 1);
                }
            }
        }
        mut dwt = u64[];
        for k in dslot.len() {
            dwt.push(0);
        }
        mut d = 0;
        for i in last {
            d += opens[i];
            d -= closes[i];
            if o.del[i] == 0 {
                mut w = 1;
                mut lv = d;
                if 4 < lv {
                    lv = 4;
                }
                while 0 < lv {
                    w = w * 16;
                    lv -= 1;
                }
                if dacc[i] != 0 {
                    was := dwt[dacc[i] - 1];
                    ir::put(&mut dwt, dacc[i] - 1, was + w);
                }
                for j in 2 {
                    mut k = o.k0[i];
                    mut v = o.v0[i];
                    if j != 0 {
                        k = o.k1[i];
                        v = o.v1[i];
                    }
                    if k == 2 {
                        n := v / 8;
                        if f.bad[n] == 0 {
                            if promotable_use(&o, i) {
                                ir::put(&mut f.weight, n, f.weight[n] + w);
                            } else {
                                ir::put(&mut f.bad, n, 1);
                            }
                        }
                    }
                }
            }
        }
        xmm_choose(&o, view(s), &mut f, ns, prologue, &mut xchosen, &mut xslots, &mut xinit, &mut xsave);
        free := u64[3, 12, 13, 14, 15];
        mut avail = u64[];
        for r in free.len() {
            if ((regs_used >> free[r]) & 1) == 0 {
                avail.push(free[r]);
            }
        }
        // The slot a slice's length is copied into, when the copy is the only write and it dominates
        // every read (`n := x.len()`): with the length in a register it is read from there, so the
        // slot needs no register of its own and its weight counts for the slice.
        mut dalias = u64[];
        for k in dslot.len() {
            dalias.push(desc_alias(&o, &dacc, k, prologue));
        }
        // Greedy by the weight a register saves: a slot takes one, a slice's `data` and `len` two,
        // each worth the accessors' weight.
        mut ddata = u64[];
        mut dlen = u64[];
        for k in dslot.len() {
            ddata.push(99);
            dlen.push(99);
        }
        // A slice's slot competes with what it is used for besides its accessors, which the pair
        // would serve.
        mut own = u64[];
        for n in ns {
            own.push(f.weight[n]);
        }
        for k in dslot.len() {
            if own[dslot[k]] > dwt[k] {
                ir::put(&mut own, dslot[k], own[dslot[k]] - dwt[k]);
            } else {
                ir::put(&mut own, dslot[k], 0);
            }
        }
        mut next = 0;
        while next < avail.len() {
            mut best = 0;
            mut bw = 3;
            for n in ns {
                if (f.bad[n] == 0) & (own[n] > bw) {
                    best = n;
                    bw = own[n];
                }
            }
            mut bd = dslot.len();
            mut dw = 15;
            if next + 1 < avail.len() {
                for k in dslot.len() {
                    // Not once its slot has a register of its own: the accessors already read that.
                    if (ddata[k] == 99) && (f.bad[dslot[k]] == 0) {
                        mut v = dwt[k];
                        if (dalias[k] != 0) && (f.bad[dalias[k]] == 0) {
                            v += f.weight[dalias[k]];
                        }
                        if v > dw {
                            bd = k;
                            dw = v;
                        }
                    }
                }
            }
            if (bd < dslot.len()) && (dw > bw) {
                // Its store must stay (the fields are loaded there) and the slot is no longer read
                // in the loop: not a candidate itself. Nor is the length's copy.
                ir::put(&mut f.bad, dslot[bd], 1);
                if (dalias[bd] != 0) && (f.bad[dalias[bd]] == 0) {
                    ir::put(&mut f.weight, dalias[bd], 0);
                    ir::put(&mut own, dalias[bd], 0);
                } else {
                    ir::put(&mut dalias, bd, 0);
                }
                ir::put(&mut ddata, bd, avail[next]);
                ir::put(&mut dlen, bd, avail[next + 1]);
                chosen.push(avail[next]);
                slots.push(0);
                chosen.push(avail[next + 1]);
                slots.push(0);
                next += 2;
            } else if best != 0 {
                chosen.push(avail[next]);
                slots.push(best);
                ir::put(&mut f.bad, best, 1);
                next += 1;
            } else {
                break;
            }
        }
        // The registers the greedy gave single slots are reassigned by live range.
        mut pal = u64[];
        for c in chosen.len() {
            if slots[c] != 0 {
                pal.push(chosen[c]);
                ir::put(&mut f.bad, slots[c], 0);
            }
        }
        if pal.len() != 0 {
            gpr_colour(&o, &mut f, &own, ns, &pal, &mut mslot, &mut mreg);
        }
        // The accessors of a slice with registers read them: `x.len()` is a move of the length, the
        // others become their 90..97 forms.
        for i in last {
            if (dacc[i] != 0) && (o.del[i] == 0) && (ddata[dacc[i] - 1] != 99) {
                k := dacc[i] - 1;
                op := o.op[i];
                if op == 42 {
                    ir::put(&mut o.op, i, 1);
                    set_operand(&mut o, i, 0, 1, dlen[k]);
                    set_operand(&mut o, i, 1, 1, 0);
                } else {
                    ir::put(&mut o.op, i, desc_form(op));
                    set_operand(&mut o, i, 0, 1, ddata[k]);
                    set_operand(&mut o, i, 1, 1, dlen[k]);
                }
            }
        }
        // An element address that is only loaded through (`leaq (D,i,8),%rax; movq (%rax),%rax`, the
        // 4-byte `movl (%rax),%eax`) is the indexed load.
        for i in last {
            if (o.del[i] != 0) || ((o.op[i] != 90) && (o.op[i] != 93)) {
                continue;
            }
            j := next_live(&o, i, last);
            if (j < last) && (o.k0[j] == 4) && ir::same_range(view(s), o.s0[j], o.e0[j], view("(%rax)")) {
                if (o.op[i] == 90) && (o.op[j] == 1) && (o.k1[j] == 1) && (o.v1[j] == 0) {
                    ir::put(&mut o.op, i, 91);
                    kill(&mut o, j);
                }
                if (o.op[i] == 93) && (o.op[j] == 98) && (o.k1[j] == 6) && ir::same_range(view(s), o.s1[j], o.e1[j], view("%eax")) {
                    ir::put(&mut o.op, i, 94);
                    kill(&mut o, j);
                }
            }
        }
        // Reads of a length's copy read the length's register.
        for k in dslot.len() {
            if (ddata[k] != 99) && (dalias[k] != 0) {
                at := dalias[k] * 8;
                for i in last {
                    if (o.del[i] == 0) && (o.op[i] == 1) && (o.k0[i] == 2) && (o.v0[i] == at) {
                        set_operand(&mut o, i, 0, 1, dlen[k]);
                    }
                }
            }
        }
        for k in dslot.len() {
            dregs.push(ddata[k]);
            dregs.push(dlen[k]);
            if ddata[k] != 99 {
                ir::put(&mut dinit, dwline[k], k + 1);
            }
        }
        // Rule 2 (call ABI S4): a promoted register is cleared after the saves only when its slot
        // may be read before it is written; a slice's registers are loaded where they are stored.
        // A register several slots share (live-range allocation) is cleared when any of them may be.
        rlive := slots_live_in(&o, view(s), &mslot, prologue);
        for c in slots.len() {
            mut z = 0;
            if slots[c] != 0 {
                for x in mslot.len() {
                    if (mreg[x] == chosen[c]) && (rlive[x] != 0) {
                        z = 1;
                    }
                }
            }
            zchosen.push(z);
        }
        // Which promoted slot each rewritten line reads (lsrc) and writes (ldst), +1: the f32
        // narrowing needs the slot behind a register that several slots share.
        mut lsrc = u64[];
        mut ldst = u64[];
        for i in last {
            lsrc.push(0);
            ldst.push(0);
        }
        if (chosen.len() != 0) || (xchosen.len() != 0) {
            for i in last {
                if o.del[i] == 0 {
                    for j in 2 {
                        mut k = o.k0[i];
                        mut v = o.v0[i];
                        if j != 0 {
                            k = o.k1[i];
                            v = o.v1[i];
                        }
                        if k == 2 {
                            for c in mslot.len() {
                                if mslot[c] * 8 == v {
                                    set_operand(&mut o, i, j, 1, mreg[c]);
                                }
                            }
                            for c in xslots.len() {
                                if xslots[c] * 8 == v {
                                    set_operand(&mut o, i, j, 7, xchosen[c]);
                                    if j == 0 {
                                        ir::put(&mut lsrc, i, xslots[c] + 1);
                                    } else {
                                        ir::put(&mut ldst, i, xslots[c] + 1);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            mut g = new_facts(ns);
            for n in ns {
                b := f.bad[n];
                ir::put(&mut g.bad, n, b);
            }
            forward(&mut o, &mut g, view(s), first, last);
            dead_defs(&mut o, view(s), first, last);
            if xchosen.len() != 0 {
                xmm_moves(&mut o, view(s), last, &mut lsrc);
                dead_defs(&mut o, view(s), first, last);
                xmm_narrow(&mut o, view(s), &lsrc, &ldst, &xslots, last);
                xmm_fold(&mut o, view(s), last);
            }
        }
    }
    peephole(&mut o, view(s), first, last);
    dead_defs(&mut o, view(s), first, last);
    retarget(&mut o, view(s), last);
    offset_loads(&mut o, view(s), last);
    array_regs(&mut o, view(s), last);
    dead_defs(&mut o, view(s), first, last);
    xmm_loads(&mut o, view(s), last);
    xmm_stores(&mut o, view(s), last);
    xmm_fold(&mut o, view(s), last);
    xmm_memops(&mut o, view(s), last);
    newframe := compact(&mut o, view(s), prologue, ns);
    // Rule 3 (call ABI S4): of the cleared range, only the slots that may be read before written.
    mut zkeep = u64[];
    if o.zline != 0 {
        mut zc = u64[];
        mut k = o.zfrom;
        while k < o.zto + 1 {
            zc.push(k);
            k += 1;
        }
        zkeep = slots_live_in(&o, view(s), &zc, prologue);
    }
    fstart := o.out.len();
    for i in last {
        if (newframe != 0) & (i + 1 == last) {
            app(&mut o.out, view(".set "));
            pa := o.s0[prologue] + 1;
            pe := o.e0[prologue];
            for x in pe - pa {
                o.out.push(s[pa + x]);
            }
            o.out.push(44);
            out_number(&mut o, newframe);
            o.out.push(10);
            continue;
        }
        if (chosen.len() != 0) & (o.op[i] == 29) & (o.del[i] == 0) {
            for c in chosen.len() {
                app(&mut o.out, view("movq "));
                emit_frame_slot(&mut o, view(s), prologue, c);
                app(&mut o.out, view(",%"));
                reg_name(&mut o, chosen[c]);
                o.out.push(10);
            }
        }
        mut saved = 0;
        if (xsave[i] != 0) && (o.del[i] == 0) {
            // Kept 16-byte aligned for the call; through %rax, which no call takes as an argument.
            for r in 16 {
                if ((xsave[i] >> r) & 1) != 0 {
                    saved += 1;
                }
            }
            app(&mut o.out, view("subq $"));
            out_number(&mut o, 16 * ((saved + 1) / 2));
            app(&mut o.out, view(",%rsp\n"));
            mut at = 0;
            for r in 16 {
                if ((xsave[i] >> r) & 1) != 0 {
                    app(&mut o.out, view("movq %xmm"));
                    out_number(&mut o, r);
                    app(&mut o.out, view(",%rax\nmovq %rax,"));
                    out_number(&mut o, 8 * at);
                    app(&mut o.out, view("(%rsp)\n"));
                    at += 1;
                }
            }
        }
        if (chosen.len() != 0) & (i == prologue) & (o.del[i] == 0) {
            // Rule 1 (call ABI S4): the saves' area is part of the one frame adjustment.
            app(&mut o.out, view("subq "));
            for x in o.e0[i] - o.s0[i] {
                o.out.push(s[o.s0[i] + x]);
            }
            app(&mut o.out, view("+"));
            out_number(&mut o, 16 * ((chosen.len() + 1) / 2));
            app(&mut o.out, view(",%rsp\n"));
        } else if o.del[i] == 0 {
            emit_line(&mut o, view(s), i);
        }
        if saved != 0 {
            // Back through %rcx, which holds nothing after a call.
            mut at = 0;
            for r in 16 {
                if ((xsave[i] >> r) & 1) != 0 {
                    app(&mut o.out, view("movq "));
                    out_number(&mut o, 8 * at);
                    app(&mut o.out, view("(%rsp),%rcx\nmovq %rcx,%xmm"));
                    out_number(&mut o, r);
                    o.out.push(10);
                    at += 1;
                }
            }
            app(&mut o.out, view("addq $"));
            out_number(&mut o, 16 * ((saved + 1) / 2));
            app(&mut o.out, view(",%rsp\n"));
        }
        if dinit[i] != 0 {
            // The slice's one store: its descriptor is in the stored register.
            k := dinit[i] - 1;
            for half in 2 {
                app(&mut o.out, view("movq "));
                if half != 0 {
                    app(&mut o.out, view("8"));
                }
                app(&mut o.out, view("(%"));
                reg_name(&mut o, o.v0[i]);
                app(&mut o.out, view("),%"));
                reg_name(&mut o, dregs[2 * k + half]);
                o.out.push(10);
            }
        }
        if (o.zline != 0) & (i + 1 == o.zline) {
            mut k = o.zfrom;
            while k < o.zto + 1 {
                if zkeep[k - o.zfrom] != 0 {
                    app(&mut o.out, view("movq $0,-"));
                    out_number(&mut o, k * 8);
                    app(&mut o.out, view("(%rbp)\n"));
                }
                k += 1;
            }
        }
        if (xinit.len() != 0) & (i == prologue) {
            for c in xinit.len() {
                app(&mut o.out, view("xorps %xmm"));
                out_number(&mut o, xinit[c]);
                app(&mut o.out, view(",%xmm"));
                out_number(&mut o, xinit[c]);
                o.out.push(10);
            }
        }
        if (chosen.len() != 0) & (i == prologue) {
            for c in chosen.len() {
                app(&mut o.out, view("movq %"));
                reg_name(&mut o, chosen[c]);
                o.out.push(44);
                emit_frame_slot(&mut o, view(s), prologue, c);
                o.out.push(10);
            }
            for c in chosen.len() {
                if zchosen[c] != 0 {
                    app(&mut o.out, view("movq $0,%"));
                    reg_name(&mut o, chosen[c]);
                    o.out.push(10);
                }
            }
        }
    }
    if prologue != 0 {
        shrink_wrap(&mut o, fstart);
    }
    if (prologue != 0) & (chosen.len() == 0) & (xchosen.len() == 0) & (o.zline != 0) {
        inline_candidate(&mut o, view(s), prologue);
    }
}
// ---- shrink-wrapping (call ABI S5) ----
// A body whose first statement is a guard that returns without a call - fib's
// `if n < 2 { return n; }` - pays its whole prologue and epilogue on the path that needs neither.
// When the emitted text is exactly
//     pushq %rbp; movq %rsp,%rbp; subq $F,%rsp
//     (saves of callee-saved registers, copies and stores of argument registers, zero stores)*
//     cmpq A,B; jCC L
//     (moves into %rax, restores of callee-saved registers)* leave; ret
// the compare and the return are emitted first, on the argument registers the copies came from,
// and the prologue and its setup move behind them, ending in `jmp L`:
//     cmpq A',B'; jCC .Lsw_NAME; (moves into %rax)'; ret
//     .Lsw_NAME: pushq %rbp; movq %rsp,%rbp; subq $F,%rsp; setup; jmp L
// The original guard is no longer reached. Site labels (`.Lgs`) move with what they mark. Anything
// else in that region - a call, a store, a write of another register, a read of a register the
// setup did not copy from an argument - leaves the text as it was.
fn shrink_wrap<a>(o: (&a mut ir::Body), start: u64) {
    mut lines = u8[][];
    mut cur = u8[];
    mut k = start;
    while k < o.out.len() {
        b := o.out[k];
        if b == 10 {
            lines.push(cur);
            cur = u8[];
        } else {
            cur.push(b);
        }
        k += 1;
    }
    if cur.len() != 0 {
        return ();
    }
    mut p = 0;
    while (p < lines.len()) && !ir::same_range(view(lines[p]), 0, lines[p].len(), view("pushq %rbp")) {
        p += 1;
    }
    if (p + 3 >= lines.len()) || (o.name.len() == 0) {
        return ();
    }
    // Only the function's own entry: nothing but its label may come before the prologue.
    for i in p {
        l := view(lines[i]);
        label := (l.len() != 0) && (l[l.len() - 1] == 58);
        directive := (l.len() != 0) && (l[0] == 46) && !label;
        if !(directive || (label && !ir::at(view(l), 0, view(".L")))) {
            return ();
        }
    }
    if !sw_is(view(lines[p + 1]), view("movq %rsp,%rbp")) || !sw_starts(view(lines[p + 2]), view("subq $")) || !sw_ends(view(lines[p + 2]), view(",%rsp")) {
        return ();
    }
    // Setup: what each callee-saved register and parameter slot holds, as the argument register it
    // was copied from.
    mut from = u8[][];
    mut to = u8[][];
    mut early = u8[][];
    mut q = p + 3;
    while q < lines.len() {
        l := view(lines[q]);
        if sw_site(l) {
            early.push(copy_line(l));
            q += 1;
            continue;
        }
        if !sw_starts(l, view("movq ")) {
            break;
        }
        ops := sw_ops(l, 5);
        if ops.len() != 2 {
            return ();
        }
        src := view(ops[0]);
        dst := view(ops[1]);
        if sw_callee_saved(src) && sw_rbp_mem(dst) {
            q += 1;
            continue;
        }
        if sw_arg(src) && (sw_callee_saved(dst) || sw_rbp_mem(dst)) {
            from.push(copy_line(src));
            to.push(copy_line(dst));
            q += 1;
            continue;
        }
        if sw_is(src, view("$0")) && (sw_callee_saved(dst) || sw_rbp_mem(dst)) {
            q += 1;
            continue;
        }
        break;
    }
    if q + 2 >= lines.len() {
        return ();
    }
    cmp := view(lines[q]);
    jcc := view(lines[q + 1]);
    if !sw_starts(cmp, view("cmpq ")) || (jcc.len() < 4) || (jcc[0] != 106) || sw_starts(jcc, view("jmp")) {
        return ();
    }
    mut sp = 0;
    while (sp < jcc.len()) && (jcc[sp] != 32) {
        sp += 1;
    }
    if sp >= jcc.len() {
        return ();
    }
    cc := sub_line(jcc, 0, sp);
    target := sub_line(jcc, sp + 1, jcc.len());
    cops := sw_ops(cmp, 5);
    if cops.len() != 2 {
        return ();
    }
    a0 := sw_subst(view(cops[0]), &from, &to);
    a1 := sw_subst(view(cops[1]), &from, &to);
    if (a0.len() == 0) || (a1.len() == 0) {
        return ();
    }
    // The guard: moves into %rax, restores, `leave`, `ret`.
    mut guard = u8[][];
    mut r = q + 2;
    mut done = 0;
    while (r < lines.len()) & (done == 0) {
        l := view(lines[r]);
        r += 1;
        if sw_site(l) {
            guard.push(copy_line(l));
            continue;
        }
        if sw_is(l, view("leave")) {
            continue;
        }
        if sw_is(l, view("ret")) {
            done = 1;
            continue;
        }
        if sw_is(l, view("xorl %eax,%eax")) {
            guard.push(copy_line(l));
            continue;
        }
        if sw_starts(l, view("movq ")) || sw_starts(l, view("movabsq ")) {
            mut skip = 5;
            if sw_starts(l, view("movabsq ")) {
                skip = 8;
            }
            ops := sw_ops(l, skip);
            if ops.len() != 2 {
                return ();
            }
            if sw_callee_saved(view(ops[1])) && sw_rbp_mem(view(ops[0])) {
                continue;
            }
            if !sw_is(view(ops[1]), view("%rax")) {
                return ();
            }
            v := sw_subst(view(ops[0]), &from, &to);
            if v.len() == 0 {
                return ();
            }
            mut m = sub_line(l, 0, skip);
            put_line(&mut m, view(v));
            put_line(&mut m, view(",%rax"));
            guard.push(m);
            continue;
        }
        return ();
    }
    if done == 0 {
        return ();
    }
    // Rebuild the text from `start`.
    mut label = copy_line(view(".Lsw_"));
    put_line(&mut label, view(o.name));
    mut out = u8[];
    for i in p {
        put_line(&mut out, view(lines[i]));
        out.push(10);
    }
    for i in early.len() {
        put_line(&mut out, view(early[i]));
        out.push(10);
    }
    put_line(&mut out, view("cmpq "));
    put_line(&mut out, view(a0));
    out.push(44);
    put_line(&mut out, view(a1));
    out.push(10);
    put_line(&mut out, view(cc));
    out.push(32);
    put_line(&mut out, view(label));
    out.push(10);
    for i in guard.len() {
        put_line(&mut out, view(guard[i]));
        out.push(10);
    }
    put_line(&mut out, view("ret\n"));
    put_line(&mut out, view(label));
    put_line(&mut out, view(":\n"));
    for i in q - p {
        l := view(lines[p + i]);
        if !sw_site(l) {
            put_line(&mut out, l);
            out.push(10);
        }
    }
    // The remainder usually opens with the original guard's own dead `jmp L` (or with `L:`):
    // falling into it is the jump.
    mut jl = copy_line(view("jmp "));
    put_line(&mut jl, view(target));
    mut ll = copy_line(view(target));
    ll.push(58);
    mut first = r;
    while (first < lines.len()) && sw_site(view(lines[first])) {
        first += 1;
    }
    falls := (first < lines.len()) && (sw_is(view(lines[first]), view(jl)) || sw_is(view(lines[first]), view(ll)));
    if !falls {
        put_line(&mut out, view(jl));
        out.push(10);
    }
    while r < lines.len() {
        put_line(&mut out, view(lines[r]));
        out.push(10);
        r += 1;
    }
    while o.out.len() > start {
        o.out.pop()!;
    }
    o.out.append(view(out));
}
fn copy_line<a>(l: &a [u8]) -> u8[] {
    mut out = u8[];
    out.append(l);
    return out;
}
fn sub_line<a>(l: &a [u8], a0: u64, e: u64) -> u8[] {
    mut out = u8[];
    for i in e - a0 {
        out.push(l[a0 + i]);
    }
    return out;
}
fn put_line<a, b>(out: (&a mut u8[]), l: &b [u8]) {
    out.append(l);
}
fn sw_is<a, b>(l: &a [u8], t: &b [u8]) -> bool {
    return ir::same_range(view(l), 0, l.len(), t);
}
fn sw_starts<a, b>(l: &a [u8], t: &b [u8]) -> bool {
    return (t.len() <= l.len()) && ir::at(view(l), 0, t);
}
fn sw_ends<a, b>(l: &a [u8], t: &b [u8]) -> bool {
    return (t.len() <= l.len()) && ir::at(view(l), l.len() - t.len(), t);
}
// A statement marker the site table reads (`.gpos`, `.gposa`, `.gbase`, `.gkind`; or the
// `.Lgs<n>:` label it makes of one): no jump targets it, and it moves with what it marks.
fn sw_site<a>(l: &a [u8]) -> bool {
    return sw_starts(l, view(".gpos")) || sw_starts(l, view(".gbase ")) || sw_starts(l, view(".gkind "))
        || (sw_starts(l, view(".Lgs")) && sw_ends(l, view(":")));
}
// The two operands after a mnemonic of `skip` bytes (with its space), split at the top-level comma.
fn sw_ops<a>(l: &a [u8], skip: u64) -> u8[][] {
    mut out = u8[][];
    mut depth = 0;
    mut cur = u8[];
    mut i = skip;
    while i < l.len() {
        c := l[i];
        if c == 40 {
            depth += 1;
        }
        if c == 41 {
            depth -= 1;
        }
        if (c == 44) && (depth == 0) {
            out.push(cur);
            cur = u8[];
        } else {
            cur.push(c);
        }
        i += 1;
    }
    out.push(cur);
    return out;
}
fn sw_callee_saved<a>(r: &a [u8]) -> bool {
    return sw_is(r, view("%rbx")) || sw_is(r, view("%r12")) || sw_is(r, view("%r13")) || sw_is(r, view("%r14")) || sw_is(r, view("%r15"));
}
fn sw_arg<a>(r: &a [u8]) -> bool {
    return sw_is(r, view("%rdi")) || sw_is(r, view("%rsi")) || sw_is(r, view("%rdx")) || sw_is(r, view("%rcx")) || sw_is(r, view("%r8")) || sw_is(r, view("%r9"));
}
// A frame word `...(%rbp)`: a parameter slot or a callee-saved save.
fn sw_rbp_mem<a>(op: &a [u8]) -> bool {
    return sw_ends(op, view("(%rbp)")) && !sw_starts(op, view("("));
}
// The guard's operand with the setup undone: an immediate stays, an argument register stays, a
// callee-saved register or parameter slot becomes the argument register it was copied from. Empty
// when the operand is anything else (it would read what the prologue has not built).
fn sw_subst<a>(op: &a [u8], from: (&u8[][]), to: (&u8[][])) -> u8[] {
    if sw_starts(op, view("$")) || sw_arg(op) {
        return copy_line(op);
    }
    mut found = u8[];
    for i in to.len() {
        if sw_is(op, view(to[i])) {
            found = copy_line(view(from[i]));
        }
    }
    return found;
}
// Whether an operand's text is an SSE register: `%xmm<n>`.
fn is_xmm_text<b>(s: &b [u8], a: u64, e: u64) -> bool {
    return (e - a > 4) && ir::at(view(s), a, view("%xmm"));
}
// A runtime entry a call does not come back from: nothing after the call is reached, so nothing is
// live across it (llvm.grl `never_returns`, plus `rt_abort`).
fn never_returns<a, b>(o: (&a ir::Body), s: &b [u8], i: u64) -> bool {
    if o.k0[i] != 4 {
        return false;
    }
    a := o.s0[i];
    e := o.e0[i];
    return ir::same_range(view(s), a, e, view("rt_abort")) || ir::same_range(view(s), a, e, view("rt_fail"))
        || ir::same_range(view(s), a, e, view("rt_trap")) || ir::same_range(view(s), a, e, view("rt_refine"))
        || ir::same_range(view(s), a, e, view("rt_task_fail")) || ir::same_range(view(s), a, e, view("rt_fail_text"))
        || ir::same_range(view(s), a, e, view("rt_report_die")) || ir::same_range(view(s), a, e, view("rt_abort_final"))
        || ir::same_range(view(s), a, e, view("rt_abort_park")) || ir::same_range(view(s), a, e, view("rt_hard_exit"))
        || ir::same_range(view(s), a, e, view("rt_stack_overflow"))
        || ir::same_range(view(s), a, e, view("rt_stack_overflow_at"));
}
// One backward pass of the candidates' liveness (bit c for candidate slot cands[c]) over the label
// graph, as live_pass does for registers. `out[0]` collects the candidates live across a call that
// returns - the SSE registers are all caller-saved, so those cannot be held in one - and `out[1]`
// the ones live just after the prologue, which start as the cleared frame's 0. A non-empty
// `interf` collects, per candidate, the candidates live at the same time as it, and a non-empty
// `callive` the candidates live across each drop helper call, which are saved around it instead.
fn xmm_live<a, b>(o: (&a ir::Body), s: &b [u8], cands: (&u64[]), lin: (&mut u64[]), prologue: u64, out: (&mut u64[]), interf: (&mut u64[]), callive: (&mut u64[])) -> u64 {
    last := o.op.len();
    all := (1 << cands.len()) - 1;
    mut live = 0;
    mut changed = 0;
    mut i = last;
    while 0 < i {
        i -= 1;
        if i == prologue {
            ir::put(&mut out, 1, live);
        }
        if (o.del[i] != 0) || (o.tr[i] != 0) {
            continue;
        }
        op := o.op[i];
        if op == 101 {
            continue;
        }
        if op == 100 {
            if lin[i] != live {
                ir::put(&mut lin, i, live);
                changed = 1;
            }
            continue;
        }
        if ir::is_jump(op) && (op != 15) {
            t := jump_target(&o, i);
            mut there = all;
            if t < last {
                there = lin[t];
            }
            if op == 16 {
                live = there;
            } else {
                live = live | there;
            }
            continue;
        }
        if (op == 29) || (op == 30) {
            live = 0;
            continue;
        }
        if op == 15 {
            if never_returns(&o, view(s), i) {
                live = 0;
            } else if (callive.len() != 0) && drop_call(&o, view(s), i) {
                // A drop helper: what is live across it is saved and restored around it.
                was := callive[i];
                ir::put(&mut callive, i, was | live);
            } else {
                was := out[0];
                ir::put(&mut out, 0, was | live);
            }
            continue;
        }
        if (op == 45) || (op == 46) {
            was := out[0];
            ir::put(&mut out, 0, was | live);
            continue;
        }
        // `live` is what is live after this line. Every candidate in it, and one written here, cannot
        // share a register with the others in it.
        if interf.len() != 0 {
            for c in cands.len() {
                at := cands[c] * 8;
                written := (o.k1[i] == 2) && (o.v1[i] == at) && ir::movelike(op);
                if written || (((live >> c) & 1) != 0) {
                    was := interf[c];
                    ir::put(&mut interf, c, was | live);
                }
            }
        }
        for c in cands.len() {
            at := cands[c] * 8;
            if (o.k1[i] == 2) && (o.v1[i] == at) && ir::movelike(op) {
                live = live & (all - (1 << c));
            }
            if (o.k0[i] == 2) && (o.v0[i] == at) {
                live = live | (1 << c);
            }
        }
    }
    return changed;
}
// Frame slots that hold floats, kept in SSE registers instead (xmm8..xmm14; xmm5 and xmm15 are the
// foreign-call sequences' scratch). A slot qualifies when every access is a plain `movq` between it
// and a general register - so the same `movq` with %xmmK in its place is the same 64 bits - when it
// carries float traffic (stored from `movq %xmmN,%R`, or loaded into a register that goes on to
// `movq %R,%xmmN`), and when it is not live across a call that returns. `regs`/`slots` receive the
// choice; `init` the registers to clear after the prologue (a slot read before any write reads the
// cleared frame's 0).
fn xmm_choose<a, b, c>(o: (&a ir::Body), s: &b [u8], f: (&c mut F), ns: u64, prologue: u64, regs: (&mut u64[]), slots: (&mut u64[]), init: (&mut u64[]), xsave: (&mut u64[])) {
    last := o.op.len();
    mut ok = u64[];
    mut fl = u64[];
    for n in ns {
        ok.push(1);
        fl.push(0);
    }
    for i in last {
        if (o.del[i] != 0) || (o.op[i] == 101) || (o.op[i] == 100) {
            continue;
        }
        op := o.op[i];
        for j in 2 {
            mut k = o.k0[i];
            mut a = o.s0[i];
            mut e = o.e0[i];
            mut v = o.v0[i];
            mut other = o.k1[i];
            if j != 0 {
                k = o.k1[i];
                a = o.s1[i];
                e = o.e1[i];
                v = o.v1[i];
                other = o.k0[i];
            }
            // A body that names the registers this would use is left as it is.
            if (k == 6) && is_xmm_text(view(s), a, e) {
                if (e - a == 6) || (s[a + 4] > 55) {
                    return ();
                }
            }
            if (k == 2) && (v / 8 < ns) {
                if (op != 1) || (other != 1) {
                    ir::put(&mut ok, v / 8, 0);
                }
            }
        }
        // Float traffic.
        if (op == 1) && (o.k1[i] == 2) && (o.k0[i] == 1) {
            mut p = i;
            while 0 < p {
                p -= 1;
                if (o.del[p] == 0) && (o.op[p] != 101) {
                    break;
                }
            }
            if (p < i) && (o.op[p] == 1) && (o.k1[p] == 1) && (o.v1[p] == o.v0[i]) && (o.k0[p] == 6)
                && is_xmm_text(view(s), o.s0[p], o.e0[p]) {
                ir::put(&mut fl, o.v1[i] / 8, 1);
            }
        }
        if (op == 1) && (o.k0[i] == 2) && (o.k1[i] == 1) {
            r := o.v1[i];
            mut j = i;
            for step in 4 {
                j = next_insn(&o, j, last);
                if j >= last {
                    break;
                }
                if (o.op[j] == 1) && (o.k0[j] == 1) && (o.v0[j] == r) && (o.k1[j] == 6)
                    && is_xmm_text(view(s), o.s1[j], o.e1[j]) {
                    ir::put(&mut fl, o.v0[i] / 8, 1);
                    break;
                }
                if (ir::is_jump(o.op[j])) || ((((ir::reads(&o, j) | ir::writes(&o, j)) >> r) & 1) != 0) {
                    break;
                }
            }
        }
    }
    // Float traffic moves through copies too: a float result is saved to a temporary slot and then
    // copied into the variable (`s = s + x[i] * y[i]`). A slot stored from a register just loaded
    // from a float slot, or loaded into a register that goes on to a float slot, carries floats.
    for round in 4 {
        mut grew = false;
        for i in last {
            if (o.del[i] != 0) || (o.op[i] != 1) {
                continue;
            }
            if (o.k0[i] == 1) && (o.k1[i] == 2) && (o.v1[i] / 8 < ns) && (fl[o.v1[i] / 8] == 0) {
                // The last write of the stored register, close before.
                r := o.v0[i];
                mut p = i;
                mut steps = 0;
                while (0 < p) && (steps < 4) {
                    p -= 1;
                    if (o.del[p] != 0) || (o.op[p] == 101) {
                        continue;
                    }
                    steps += 1;
                    if (o.op[p] == 100) || ir::is_jump(o.op[p]) {
                        break;
                    }
                    if ((ir::writes(&o, p) >> r) & 1) != 0 {
                        if (o.op[p] == 1) && (o.k0[p] == 2) && (o.k1[p] == 1) && (o.v0[p] / 8 < ns) && (fl[o.v0[p] / 8] != 0) {
                            ir::put(&mut fl, o.v1[i] / 8, 1);
                            grew = true;
                        }
                        break;
                    }
                }
            }
            if (o.k0[i] == 2) && (o.k1[i] == 1) && (o.v0[i] / 8 < ns) && (fl[o.v0[i] / 8] == 0) {
                r := o.v1[i];
                mut j = i;
                for step in 4 {
                    j = next_insn(&o, j, last);
                    if (j >= last) || ir::is_jump(o.op[j]) {
                        break;
                    }
                    if (o.op[j] == 1) && (o.k0[j] == 1) && (o.v0[j] == r) && (o.k1[j] == 2) && (o.v1[j] / 8 < ns) && (fl[o.v1[j] / 8] != 0) {
                        ir::put(&mut fl, o.v0[i] / 8, 1);
                        grew = true;
                        break;
                    }
                    if (((ir::reads(&o, j) | ir::writes(&o, j)) >> r) & 1) != 0 {
                        break;
                    }
                }
            }
        }
        if !grew {
            break;
        }
    }
    // The heaviest candidates, at most 16 (one bit each in the liveness pass).
    mut cands = u64[];
    mut taken = u64[];
    for n in ns {
        taken.push(0);
    }
    while cands.len() < 63 {
        mut best = 0;
        mut bw = 3;
        for n in ns {
            if (taken[n] == 0) && (f.bad[n] == 0) && (ok[n] != 0) && (fl[n] != 0) && (f.weight[n] > bw) {
                best = n;
                bw = f.weight[n];
            }
        }
        if best == 0 {
            break;
        }
        ir::put(&mut taken, best, 1);
        cands.push(best);
    }
    if cands.len() == 0 {
        return ();
    }
    mut lin = u64[];
    for i in last {
        lin.push(0);
    }
    mut out = u64[0, 0];
    mut none = u64[];
    mut none2 = u64[];
    mut rounds = 0;
    while rounds < 50 {
        rounds += 1;
        if xmm_live(&o, view(s), &cands, &mut lin, prologue, &mut out, &mut none, &mut none2) == 0 {
            break;
        }
    }
    if rounds == 50 {
        return ();
    }
    ir::put(&mut out, 0, 0);
    mut interf = u64[];
    for c in cands.len() {
        interf.push(0);
    }
    mut callive = u64[];
    for i in last {
        callive.push(0);
    }
    xmm_live(&o, view(s), &cands, &mut lin, prologue, &mut out, &mut interf, &mut callive);
    // Interference is mutual: a slot written but never read records the ones live across its
    // write, and they must record it, or the later-coloured one could share its register.
    for c in cands.len() {
        for d in cands.len() {
            if ((interf[c] >> d) & 1) != 0 {
                was := interf[d];
                ir::put(&mut interf, d, was | (1 << c));
            }
        }
    }
    // Heaviest first, each into the lowest of the seven registers no interfering candidate holds:
    // slots whose lives do not overlap share one.
    mut color = u64[];
    for c in cands.len() {
        color.push(0);
    }
    mut inited = 0;
    for c in cands.len() {
        if ((out[0] >> c) & 1) != 0 {
            continue;
        }
        mut used = 0;
        for d in c {
            if (color[d] != 0) && (((interf[c] >> d) & 1) != 0) {
                used = used | (1 << (color[d] - 1));
            }
        }
        mut k = 0;
        while (k < 7) && (((used >> k) & 1) != 0) {
            k += 1;
        }
        if k < 7 {
            ir::put(&mut color, c, k + 1);
            reg := 8 + k;
            regs.push(reg);
            slots.push(cands[c]);
            ir::put(&mut f.bad, cands[c], 1);
            if (((out[1] >> c) & 1) != 0) && (((inited >> k) & 1) == 0) {
                inited = inited | (1 << k);
                init.push(reg);
            }
        }
    }
    // At each drop helper call, the registers of the chosen candidates live across it.
    for i in last {
        if callive[i] != 0 {
            mut m = 0;
            for c in cands.len() {
                if (((callive[i] >> c) & 1) != 0) && (color[c] != 0) {
                    m = m | (1 << (7 + color[c]));
                }
            }
            ir::put(&mut xsave, i, m);
        }
    }
}
// `movq %X,%R ... movq %R,%xmmN` with X an SSE register is `movaps %X,%xmmN`: the general register was
// only a way between two SSE ones. The first move stays for dead_defs to remove when R is dead.
// X promoted (kind 7) may be some lines back, provided nothing between writes R or X; a parsed SSE
// register (kind 6) is tracked by nobody, so its move must be the line just before.
fn xmm_moves<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64, lsrc: (&mut u64[])) {
    for j in last {
        if (o.del[j] != 0) || (o.op[j] != 1) || (o.k0[j] != 1) {
            continue;
        }
        if !((o.k1[j] == 7) || ((o.k1[j] == 6) && is_xmm_text(view(s), o.s1[j], o.e1[j]))) {
            continue;
        }
        r := o.v0[j];
        mut p = j;
        mut steps = 0;
        mut found = last;
        while (0 < p) && (steps < 6) {
            p -= 1;
            if (o.del[p] != 0) || (o.op[p] == 101) {
                continue;
            }
            steps += 1;
            op := o.op[p];
            if (op == 100) || (op == 0) || (op == 15) || ir::is_jump(op) {
                break;
            }
            if (((ir::writes(&o, p) >> r) & 1) != 0) {
                if (op == 1) && (o.k1[p] == 1) && (o.v1[p] == r) {
                    if (o.k0[p] == 7) || ((o.k0[p] == 6) && (steps == 1) && is_xmm_text(view(s), o.s0[p], o.e0[p])) {
                        found = p;
                    }
                }
                break;
            }
        }
        if found < last {
            // Nothing between writes the promoted source.
            mut clean = true;
            if o.k0[found] == 7 {
                mut x = found + 1;
                while x < j {
                    if (o.del[x] == 0) && (o.k1[x] == 7) && (o.v1[x] == o.v0[found]) {
                        clean = false;
                    }
                    x += 1;
                }
            }
            if clean {
                // j now reads what `found` read.
                was := lsrc[found];
                ir::put(&mut lsrc, j, was);
                ir::put(&mut o.op, j, 68);
                set_operand(&mut o, j, 0, o.k0[found], o.v0[found]);
                set_range(&mut o, j, 0, o.s0[found], o.e0[found]);
            }
        }
    }
}
// Operand j of line i is the parsed SSE register written s[a..e].
fn xmm_is<a, b>(o: (&a ir::Body), s: &b [u8], i: u64, j: u64, a: u64, e: u64) -> bool {
    if j == 0 {
        return (o.k0[i] == 6) && ir::same_range(view(s), o.s0[i], o.e0[i], view(s[a: e]));
    }
    return (o.k1[i] == 6) && ir::same_range(view(s), o.s1[i], o.e1[i], view(s[a: e]));
}
// The SSE register operand j of line i names, by number (a parsed `%xmmN` or a promoted one), or 99.
fn xmm_no<a, b>(o: (&a ir::Body), s: &b [u8], i: u64, j: u64) -> u64 {
    mut k = o.k0[i];
    mut v = o.v0[i];
    mut a = o.s0[i];
    mut e = o.e0[i];
    if j != 0 {
        k = o.k1[i];
        v = o.v1[i];
        a = o.s1[i];
        e = o.e1[i];
    }
    if k == 7 {
        return v;
    }
    if (k == 6) && is_xmm_text(view(s), a, e) {
        if e - a == 5 {
            return s[a + 4] - 48;
        }
        if e - a == 6 {
            return 10 + s[a + 5] - 48;
        }
    }
    return 99;
}
// Whether SSE register r is dead after line i: on every path the next mention writes it whole,
// followed through at most `depth` jumps (a label is no use: deadness depends on what follows). A
// call that returns, an unknown instruction or an unfollowed jump first counts as a use.
fn xmm_dead_after<a, b>(o: (&a ir::Body), s: &b [u8], i: u64, r: u64, depth: u64) -> bool {
    last := o.op.len();
    if (depth == 0) || (r == 99) {
        return false;
    }
    mut j = i;
    for step in 40 {
        j = next_live(&o, j, last);
        if j >= last {
            return false;
        }
        op := o.op[j];
        if (op == 15) && never_returns(&o, view(s), j) {
            return true;
        }
        if (op == 16 || ((16 < op) && (op < 25))) && (o.k0[j] == 4) {
            t := jump_target(&o, j);
            if (t >= last) || !xmm_dead_after(&o, view(s), t, r, depth - 1) {
                return false;
            }
            if op == 16 {
                return true;
            }
            continue;
        }
        if op == 100 {
            continue;
        }
        if (op == 0) || (op == 15) || (op == 29) || (op == 30) || ir::is_jump(op) {
            return false;
        }
        if xmm_no(&o, view(s), j, 0) == r {
            return false;
        }
        if xmm_no(&o, view(s), j, 1) == r {
            // Whole-register writes; the arithmetic and the compare read their destination too.
            return (op == 1) || (op == 68) || (op == 70) || (op == 71) || (op == 65) || (op == 66) || (op == 77);
        }
    }
    return false;
}
// f32 values in binary32 (P2). A promoted slot is narrow when every store into it is a value just
// made by `cvtss2sd` (so binary32-exact) or zero, and every load is a `movaps` into a scratch
// register. It then holds the binary32 value: a store copies it before the widening, and a load
// feeds either an operation narrowed with it - `OPsd; cvtsd2ss; cvtss2sd` over two narrow loads is
// `OPss; cvtss2sd`, exact for + - * / and sqrt since 53 >= 2*24 + 2 (the argument llvm.grl's lifter
// makes) - or is widened by a `cvtss2sd` in the `movaps`'s place.
// The position in `xslots` of the slot recorded as n + 1 (xslots.len() when absent).
fn slot_index(xslots: (&u64[]), tag: u64) -> u64 {
    mut c = 0;
    while (c < xslots.len()) && (xslots[c] + 1 != tag) {
        c += 1;
