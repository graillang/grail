        reg_name(&mut o, len);
        app(&mut o.out, view(",%rsi\njb .L"));
        opt_label(&mut o);
        out_number(&mut o, n);
        app(&mut o.out, view("\nmovq %"));
        reg_name(&mut o, len);
        app(&mut o.out, view(",%rdi\nmovq $64,%rdx\ncall rt_trap\n.L"));
        opt_label(&mut o);
        out_number(&mut o, n);
        app(&mut o.out, view(":\n"));
