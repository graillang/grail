}
// Live-range allocation of the general registers promotion gives to single slots (dev-gap item 5):
// the heaviest 63 candidates are coloured by interference into `pal`, so slots whose lives do not
// overlap - the variables of one loop and those of the next - share a callee-saved register. Fills
// the slot-to-register map and marks the slots taken.
fn gpr_colour<a, c>(o: (&a ir::Body), f: (&c mut F), own: (&u64[]), ns: u64, pal: (&u64[]), mslot: (&mut u64[]), mreg: (&mut u64[])) {
    last := o.op.len();
    mut cands = u64[];
    mut taken = u64[];
    for n in ns {
        taken.push(0);
    }
    while cands.len() < 63 {
        mut best = 0;
        mut bw = 3;
        for n in ns {
            if (taken[n] == 0) && (f.bad[n] == 0) && (own[n] > bw) {
                best = n;
                bw = own[n];
            }
        }
        if best == 0 {
            break;
        }
        ir::put(&mut taken, best, 1);
        cands.push(best);
    }
    if cands.len() == 0 {
        return ();
    }
    mut lin = u64[];
    for i in last {
        lin.push(0);
    }
    mut none = u64[];
    mut rounds = 0;
    while rounds < 50 {
        rounds += 1;
        if gpr_live(&o, &cands, &mut lin, &mut none) == 0 {
            break;
        }
    }
    mut interf = u64[];
    for c in cands.len() {
        interf.push(0);
    }
    if rounds == 50 {
        // No fixed point: every candidate interferes with every other, one register each.
        for c in cands.len() {
            ir::put(&mut interf, c, (1 << cands.len()) - 1);
        }
    } else {
        gpr_live(&o, &cands, &mut lin, &mut interf);
    }
    // Interference is mutual: a slot written but never read records the ones live across its
    // write, and they must record it, or the later-coloured one could share its register.
    for c in cands.len() {
        for d in cands.len() {
            if ((interf[c] >> d) & 1) != 0 {
                was := interf[d];
                ir::put(&mut interf, d, was | (1 << c));
            }
        }
    }
    mut color = u64[];
    for c in cands.len() {
        color.push(0);
    }
    for c in cands.len() {
        mut used = 0;
        for d in c {
            if (color[d] != 0) && (((interf[c] >> d) & 1) != 0) {
                used = used | (1 << (color[d] - 1));
            }
        }
        mut k = 0;
        while (k < pal.len()) && (((used >> k) & 1) != 0) {
            k += 1;
        }
        if k < pal.len() {
            ir::put(&mut color, c, k + 1);
