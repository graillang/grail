fn prev_live<a>(o: (&a ir::Body), i: u64) -> u64 {
    mut p = i;
    while 0 < p {
        p -= 1;
        if (o.del[p] == 0) && (o.op[p] != 101) {
            if o.op[p] == 100 {
                return i;
            }
            return p;
        }
    }
    return i;
}
// `leaq -N(%rbp),%R; movq (%R),%R` is `movq -N(%rbp),%R` (dev-gap item 7): the address is used once,
// by a load that overwrites it. Without the leaq the slot is no longer address-taken, so it can be
// promoted when nothing else takes its address; a word of a two-word value or an aggregate
// (`o.pair`) stays as it is, since the other words are reached through the same address.
fn slot_loads<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64) {
    names := u8[][
        copy_text(view("(%rax)")), copy_text(view("(%rcx)")), copy_text(view("(%rdx)")),
        copy_text(view("(%rbx)")), copy_text(view("(%rsp)")), copy_text(view("(%rbp)")),
        copy_text(view("(%rsi)")), copy_text(view("(%rdi)"))
    ];
    // How often each frame word is named, to know a temporary written and read once.
    mut uses = u64[];
    for n in o.maxslot / 8 + 1 {
        uses.push(0);
    }
    for i in last {
        if o.del[i] == 0 {
            if (o.k0[i] == 2) && (o.v0[i] / 8 < uses.len()) {
                was := uses[o.v0[i] / 8];
                ir::put(&mut uses, o.v0[i] / 8, was + 1);
            }
            if (o.k1[i] == 2) && (o.v1[i] / 8 < uses.len()) {
                was := uses[o.v1[i] / 8];
                ir::put(&mut uses, o.v1[i] / 8, was + 1);
            }
        }
    }
    for i in last {
        if (o.del[i] != 0) || (o.op[i] != 3) || (o.k0[i] != 2) || (o.k1[i] != 1) {
            continue;
        }
        n := o.v0[i] / 8;
        if (n < o.pair.len()) && (o.pair[n] != 0) {
            continue;
        }
        mut r = o.v1[i];
        mut j = next_live(&o, i, last);
        // Through a temporary the stream parks the address in: `movq %R,T; movq T,%R2`, T named
        // nowhere else.
        mut t1 = last;
        mut t2 = last;
        if (j < last) && (o.op[j] == 1) && (o.k0[j] == 1) && (o.v0[j] == r) && (o.k1[j] == 2) {
            k := next_live(&o, j, last);
            tn := o.v1[j] / 8;
            if (k < last) && (o.op[k] == 1) && (o.k0[k] == 2) && (o.v0[k] == o.v1[j]) && (o.k1[k] == 1)
                && (tn < uses.len()) && (uses[tn] == 2) && ((tn >= o.pair.len()) || (o.pair[tn] == 0)) {
                t1 = j;
                t2 = k;
                r = o.v1[k];
                j = next_live(&o, k, last);
            } else {
                continue;
            }
        }
        if (r >= names.len()) || (j >= last) || (o.op[j] != 1) || (o.k0[j] != 4) || (o.k1[j] != 1) || (o.v1[j] != r) {
            continue;
        }
        if !ir::same_range(view(s), o.s0[j], o.e0[j], view(names[r])) {
            continue;
        }
        set_operand(&mut o, j, 0, 2, o.v0[i]);
        kill(&mut o, i);
