    return 99;
}
fn regcode<b>(s: read<b>, a: u64, e: u64) -> u64 {
    if (e <= a) + (e - a > 4) {
        return 99;
    }
    mut k = 0;
    for i in e - a {
        k = k | (s[a + i] << (8 * i));
    }
    return reg_key(k);
}
fn alnum(c: u64) -> u64 {
    return ((47 < c) & (c < 58)) + ((96 < c) & (c < 123)) + ((64 < c) & (c < 91));
}
// Registers mentioned anywhere in s[a:e] (bit 5 marks an rbp use).
fn mentions<b>(s: read<b>, a: u64, e: u64) -> u64 {
    mut m = 0;
    mut i = a;
    while i < e {
        if s[i] == 37 {
            mut j = i + 1;
            while j < e {
                if alnum(s[j]) == 0 {
                    break;
                }
                j += 1;
            }
            r := regcode(&s, i + 1, j);
            if r < 32 {
                m = m | bit(r % 16);
            }
            i = j;
        } else {
            i += 1;
        }
    }
    return m;
}
// Classifies one operand: returns kind and fills value/mask through the pair encoding.
fn classify<a, b>(o: (&mut a O), s: read<b>, a: u64, e: u64, second: u64) {
    mut k = 4;
    mut v = 0;
    mut m = 0;
    if a < e {
        c := s[a];
        if c == 37 {
            r := regcode(&s, a + 1, e);
            if r < 16 {
                k = 1;
                v = r;
            } else {
                k = 6;
                if r < 32 {
                    m = bit(r - 16);
                }
            }
        } else {
            if c == 36 {
                k = 3;
            } else {
                m = mentions(&s, a, e);
                if (c == 46) & (e - a > 2) {
                    if s[a + 1] == 76 {
                        mut n = 0;
                        mut digits = 0;
                        mut i = a + 2;
                        while i < e {
                            d := s[i];
                            if (d < 48) + (57 < d) {
                                break;
                            }
                            n = n * 10 + d - 48;
                            digits += 1;
                            i += 1;
                        }
                        if digits != 0 {
                            v = n + 1;
                        }
                    }
                }
                // -N(%rbp) with decimal N is a frame slot.
                if (c == 45) & (e - a > 7) {
                    if same(&s, e - 6, e, &"(%rbp)") {
                        mut n = 0;
                        mut ok = 1;
                        for i in e - 7 - a {
                            d := s[a + 1 + i];
                            if (d < 48) + (57 < d) {
                                ok = 0;
                            } else {
                                n = n * 10 + d - 48;
                            }
                        }
                        if ok & (n != 0) {
                            k = 2;
                            v = n;
                            m = 0;
                            if n % 8 != 0 {
                                exchange(borrow_mut(o.weird), 1);
                            }
                            if o.maxslot < n {
                                exchange(borrow_mut(o.maxslot), n);
                            }
                        }
                    }
                }
            }
        }
    } else {
        k = 0;
    }
    if second {
        o.k1.push(k);
        o.v1.push(v);
        o.s1.push(a);
        o.e1.push(e);
        o.m1.push(m);
    } else {
        o.k0.push(k);
        o.v0.push(v);
        o.s0.push(a);
        o.e0.push(e);
        o.m0.push(m);
    }
}
fn parse<a, b>(o: (&mut a O), s: read<b>, a: u64, e: u64) {
    o.ls.push(a);
    o.le.push(e);
    o.chg.push(0);
    o.del.push(0);
    o.tr.push(0);
    mut op = 0;
    mut lab = 0;
    mut space = e;
    // String data between .pushsection/.popsection is inert, including its labels.
    if (e - a > 10) & (s[a] == 46) {
        if s[a + 1] == 112 {
            if s[a + 2] == 117 {
                exchange(borrow_mut(o.data), 1);
            }
            if s[a + 2] == 111 {
                exchange(borrow_mut(o.data), 0);
                op = 101;
            }
        }
    }
    if o.data {
        op = 101;
    }
    if op == 101 {} else {
        if a < e {
            if s[e - 1] == 58 {
                op = 100;
                if same(&s, a, a + 2, &".L") & (e - a > 3) {
                    mut n = 0;
                    mut ok = 1;
                    for i in e - a - 3 {
                        d := s[a + 2 + i];
                        if (d < 48) + (57 < d) {
                            ok = 0;
                        } else {
                            n = n * 10 + d - 48;
                        }
                    }
                    if ok {
                        lab = n + 1;
                    }
                }
            } else {
                if s[a] == 46 {
                    op = 101;
                } else {
                    for i in e - a {
                        if s[a + i] == 32 {
                            space = a + i;
                            break;
                        }
                    }
                    mut k = 0;
                    if space - a < 8 {
                        for x in space - a {
                            k = k | (s[a + x] << (8 * x));
                        }
                    }
                    op = opcode_key(k);
                }
            }
        } else {
            op = 101;
        }
    }
    o.op.push(op);
    o.lab.push(lab);
    if (op == 100) + (op == 101) {
        classify(borrow_mut(o), &s, e, e, 0);
        classify(borrow_mut(o), &s, e, e, 1);
        return ();
    }
    // Split operands at the top-level comma.
    mut first = e;
    mut comma = e;
    mut depth = 0;
    if space < e {
        first = space + 1;
    }
    mut i = first;
    while i < e {
        c := s[i];
        if c == 40 {
            depth += 1;
        }
        if c == 41 {
            depth -= 1;
        }
        if (c == 44) & (depth == 0) {
            comma = i;
            break;
        }
        i += 1;
    }
    mut extra = 0;
    if comma < e {
        i = comma + 1;
        while i < e {
            c := s[i];
            if c == 40 {
                depth += 1;
            }
            if c == 41 {
                depth -= 1;
            }
            if (c == 44) & (depth == 0) {
                extra = 1;
            }
            i += 1;
        }
    }
    if extra {
        exchange(&mut o.op[o.op.len() - 1], 0);
    }
    classify(borrow_mut(o), &s, first, comma, 0);
    if comma < e {
        classify(borrow_mut(o), &s, comma + 1, e, 1);
    } else {
        classify(borrow_mut(o), &s, e, e, 1);
    }
    // Calls to the leaf runtime accessors become pseudo-instructions expanded inline at emission:
    // 40 rt_slot, 41 rt_at (bounds-checked element address / load), 42 rt_len, 43 rt_xchg, 44 rt_atb (byte load),
    // 45 rt_push / 46 rt_pushb (inline store when capacity remains, runtime call to grow),
    // 47 rt_slotu / 48 rt_atbu (proven in-bounds element address / byte load).
    if (op == 15) & (comma == e) & (e - first > 5) & (e - first < 9) {
        if (s[first] == 114) & (s[first + 1] == 116) & (s[first + 2] == 95) {
            mut fast = 0;
            if same(&s, first, e, &"rt_slot") {
                fast = 40;
            }
            if same(&s, first, e, &"rt_at") {
                fast = 41;
            }
            if same(&s, first, e, &"rt_len") {
                fast = 42;
            }
            if same(&s, first, e, &"rt_xchg") {
                fast = 43;
            }
            if same(&s, first, e, &"rt_atb") {
                fast = 44;
            }
            if same(&s, first, e, &"rt_push") {
                fast = 45;
            }
            if same(&s, first, e, &"rt_pushb") {
                fast = 46;
            }
            if same(&s, first, e, &"rt_slotu") {
                fast = 47;
            }
            if same(&s, first, e, &"rt_atbu") {
                fast = 48;
            }
            if fast != 0 {
                exchange(&mut o.op[o.op.len() - 1], fast);
            }
        }
    }
}
fn movelike(op: u64) -> u64 {
    return (op == 1) + (op == 2) + (op == 3) + (op == 28);
}
fn arith(op: u64) -> u64 {
    return (op == 4)
        + (op == 5)
        + (op == 8)
        + (op == 9)
        + (op == 10)
        + (op == 14)
        + (op == 33)
        + (op == 34);
}
fn is_jump(op: u64) -> u64 {
    return (15 < op) & (op < 25);
}
fn mask_of(k: u64, v: u64, m: u64) -> u64 {
    if k == 1 {
        return bit(v);
    }
    return m;
}
// Registers written by a destination operand (narrow register spellings count as written).
fn dst_writes<a>(o: (&a O), i: u64) -> u64 {
    k := o.k1[i];
    if k == 1 {
        return bit(o.v1[i]);
    }
    if k == 6 {
        return o.m1[i];
    }
    return 0;
}
fn dst_address<a>(o: (&a O), i: u64) -> u64 {
    if o.k1[i] == 1 {
        return 0;
    }
    return o.m1[i];
}
fn reads<a>(o: (&a O), i: u64) -> u64 {
    op := o.op[i];
    src := mask_of(o.k0[i], o.v0[i], o.m0[i]);
    dst := mask_of(o.k1[i], o.v1[i], o.m1[i]);
    if op == 15 {
        return arg_regs() | src;
    }
    if (op == 100) + (op == 101) + (op == 29) + (op == 32) + is_jump(op) {
        return 0;
    }
    if movelike(op) {
        return src | dst_address(borrow(o), i);
    }
    if op == 10 {
        if (o.k0[i] == 1) & (o.k1[i] == 1) & (o.v0[i] == o.v1[i]) {
            return 0;
        }
    }
    if arith(op) + (op == 6) + (op == 7) {
        return src | dst;
    }
    if op == 11 {
        return dst;
    }
    if op == 12 {
        return src | 1;
    }
    if op == 13 {
        return src | 5;
    }
    if (op == 25) + (op == 26) + (op == 27) + (op == 30) {
        return 1;
    }
    if op == 31 {
        return src;
    }
    if (op == 40)
        + (op == 41)
        + (op == 43)
        + (op == 44)
        + (op == 45)
        + (op == 46)
        + (op == 47)
        + (op == 48) {
        return 192;
    }
    if op == 42 {
        return 128;
    }
    return all_regs();
}
fn writes<a>(o: (&a O), i: u64) -> u64 {
    op := o.op[i];
    if (op == 100) + (op == 101) + (op == 29) + (op == 30) + (op == 31) + (op == 6) + (op == 7) {
        return 0;
    }
    if op == 15 {
        return caller_saved();
    }
    if is_jump(op) {
        return 0;
    }
    if movelike(op) + arith(op) + (op == 11) + (op == 32) {
        return dst_writes(borrow(o), i);
    }
    if (op == 12) + (op == 13) {
        return 5;
    }
    if (op == 25) + (op == 26) + (op == 27) {
        return 1;
    }
    if (39 < op) & (op < 45) {
        return 1;
    }
    if (op == 45) + (op == 46) {
        return caller_saved();
    }
    if (op == 47) + (op == 48) {
        return 1;
    }
    return all_regs();
}
// Whether operand j of instruction i reads / writes a frame slot.
fn slot_read<a>(o: (&a O), i: u64, j: u64) -> u64 {
    op := o.op[i];
    if j == 0 {
        return o.k0[i] == 2;
    }
    if o.k1[i] != 2 {
        return false;
    }
    if movelike(op) {
        return false;
    }
    return 1;
}
fn slot_written<a>(o: (&a O), i: u64) -> u64 {
    op := o.op[i];
    if o.k1[i] != 2 {
        return false;
    }
    return movelike(op) + arith(op) + (op == 11) + (op == 0);
}
fn set_operand<a>(o: (&mut a O), i: u64, j: u64, k: u64, v: u64) {
    if j == 0 {
        put(borrow_mut(o.k0), i, k);
        put(borrow_mut(o.v0), i, v);
        put(borrow_mut(o.m0), i, 0);
    } else {
        put(borrow_mut(o.k1), i, k);
        put(borrow_mut(o.v1), i, v);
        put(borrow_mut(o.m1), i, 0);
    }
    put(borrow_mut(o.chg), i, 1);
}
fn set_range<a>(o: (&mut a O), i: u64, j: u64, a: u64, e: u64) {
    if j == 0 {
        put(borrow_mut(o.s0), i, a);
        put(borrow_mut(o.e0), i, e);
    } else {
        put(borrow_mut(o.s1), i, a);
        put(borrow_mut(o.e1), i, e);
    }
}
fn kill<a>(o: (&mut a O), i: u64) {
    put(borrow_mut(o.del), i, 1);
}
struct F {
    // Slot facts (index N/8): register holding the value (+1) and its version, known
    // immediate line (+1), copy-of slot (+1) and its version; valid while ver/epoch match.
    sver: u64[],
    sep: u64[],
    sfv: u64[],
    sreg: u64[],
    sregv: u64[],
    simm: u64[],
    scopy: u64[],
    scopyv: u64[],
    bad: u64[],
    reads: u64[],
    weight: u64[],
    rver: u64[],
    rep: u64[],
    rimm: u64[],
    rslot: u64[],
    rslotv: u64[],
    rcopy: u64[],
    rcopyv: u64[],
    epoch: u64
}
fn facts_valid<a>(f: (&a F), n: u64) -> u64 {
    return (f.sep[n] == f.epoch) & (f.sfv[n] == f.sver[n]);
}
fn fresh_facts<a>(f: (&mut a F), n: u64) {
    put(borrow_mut(f.sep), n, f.epoch);
    t1 := f.sver[n];
    put(borrow_mut(f.sfv), n, t1);
    put(borrow_mut(f.sreg), n, 0);
    put(borrow_mut(f.simm), n, 0);
    put(borrow_mut(f.scopy), n, 0);
}
fn reg_written<a>(f: (&mut a F), r: u64) {
    t2 := f.rver[r] + 1;
    put(borrow_mut(f.rver), r, t2);
    put(borrow_mut(f.rimm), r, 0);
    put(borrow_mut(f.rslot), r, 0);
    put(borrow_mut(f.rcopy), r, 0);
}
fn reg_fact_valid<a>(f: (&a F), r: u64) -> u64 {
    return f.rep[r] == f.epoch;
}
fn copy_source<a>(f: (&a F), q: u64) -> u64 {
    if reg_fact_valid(borrow(f), q) == 0 {
        return q;
    }
    c := f.rcopy[q];
    if c == 0 {
        return q;
    }
    r := c - 1;
    if f.rcopyv[q] != f.rver[r] {
        return q;
    }
    return r;
}
// Replace a read of slot n (operand j of i) by a register or constant already holding it.
fn forward_read<a, c>(o: (&mut a O), f: (&mut c F), i: u64, j: u64, n: u64) {
    if facts_valid(borrow(f), n) == 0 {
        return ();
    }
    op := o.op[i];
    if (op == 1) & (j == 0) & (o.k1[i] == 1) & (f.simm[n] != 0) {
        l := f.simm[n] - 1;
        lk := o.k0[l];
        lv := o.v0[l];
        la := o.s0[l];
        le := o.e0[l];
        set_operand(borrow_mut(o), i, 0, lk, lv);
        set_range(borrow_mut(o), i, 0, la, le);
        put(borrow_mut(o.op), i, 2);
        return ();
    }
    if f.sreg[n] != 0 {
        r := f.sreg[n] - 1;
        if f.sregv[n] == f.rver[r] {
            set_operand(borrow_mut(o), i, j, 1, r);
            return ();
        }
    }
    if f.scopy[n] != 0 {
        m := f.scopy[n] - 1;
        if f.scopyv[n] == f.sver[m] {
            set_operand(borrow_mut(o), i, j, 2, m * 8);
            if facts_valid(borrow(f), m) {
                if f.sreg[m] != 0 {
                    r := f.sreg[m] - 1;
                    if f.sregv[m] == f.rver[r] {
                        set_operand(borrow_mut(o), i, j, 1, r);
                    }
                }
            }
        }
    }
}
fn new_facts(ns: u64) -> F {
    mut f = F {
        sver: u64[],
        sep: u64[],
        sfv: u64[],
        sreg: u64[],
        sregv: u64[],
        simm: u64[],
        scopy: u64[],
        scopyv: u64[],
        bad: u64[],
        reads: u64[],
        weight: u64[],
        rver: u64[],
        rep: u64[],
        rimm: u64[],
        rslot: u64[],
        rslotv: u64[],
        rcopy: u64[],
        rcopyv: u64[],
        epoch: 1,
    };
    for i in ns {
        f.sver.push(0);
        f.sep.push(0);
        f.sfv.push(0);
        f.sreg.push(0);
        f.sregv.push(0);
        f.simm.push(0);
        f.scopy.push(0);
        f.scopyv.push(0);
        f.bad.push(0);
        f.reads.push(0);
        f.weight.push(0);
    }
    for i in 16 {
        f.rver.push(0);
        f.rep.push(0);
        f.rimm.push(0);
        f.rslot.push(0);
        f.rslotv.push(0);
        f.rcopy.push(0);
        f.rcopyv.push(0);
    }
    return f;
}
fn forward<a, b, c>(o: (&mut a O), f: (&mut c F), s: read<b>, first: u64, last: u64) {
    mut i = first;
    while i < last {
        op := o.op[i];
        if o.del[i] + (op == 101) + o.tr[i] {
            i += 1;
            continue;
        }
        if (op == 100) + (op == 0) {
            ep := f.epoch + 1;
            exchange(borrow_mut(f.epoch), ep);
            if op == 0 {
                for r in 16 {
                    reg_written(borrow_mut(f), r);
                }
            }
            i += 1;
            continue;
        }
        mut loaded = 0;
        if (o.k0[i] == 2) & promotable_use(borrow(o), i) {
            n := o.v0[i] / 8;
            if f.bad[n] == 0 {
                if movelike(op) & (o.k1[i] == 1) {
                    loaded = n + 1;
                }
                forward_read(borrow_mut(o), borrow_mut(f), i, 0, n);
            }
        }
        if slot_read(borrow(o), i, 1) & promotable_use(borrow(o), i) {
            n := o.v1[i] / 8;
            if f.bad[n] == 0 {
                forward_read(borrow_mut(o), borrow_mut(f), i, 1, n);
            }
        }
        // Copy propagation: read-only register operands use the original of a register copy.
        if (o.k0[i] == 1)
            & (
                (op == 1)
                    + (op == 4)
                    + (op == 5)
                    + (op == 6)
                    + (op == 7)
                    + (op == 8)
                    + (op == 9)
                    + (op == 10)
            ) {
            r := copy_source(borrow(f), o.v0[i]);
            if r != o.v0[i] {
                set_operand(borrow_mut(o), i, 0, 1, r);
            }
        }
        if (o.k1[i] == 1) & ((op == 6) + (op == 7)) {
            r := copy_source(borrow(f), o.v1[i]);
            if r != o.v1[i] {
                set_operand(borrow_mut(o), i, 1, 1, r);
            }
        }
        // A register operand known to hold a small constant becomes an immediate.
        if (o.k0[i] == 1)
            & ((op == 1) + (op == 4) + (op == 5) + (op == 6) + (op == 8) + (op == 9) + (op == 10)) {
            r := o.v0[i];
            if reg_fact_valid(borrow(f), r) & (f.rimm[r] != 0) {
                l := f.rimm[r] - 1;
                value := imm_value(borrow(o), &s, l);
                wide := (op == 1) & (o.k1[i] == 1);
                if (value != 0) & (wide + (value < 2147483649)) {
                    la := o.s0[l];
                    le := o.e0[l];
                    set_operand(borrow_mut(o), i, 0, 3, 0);
                    set_range(borrow_mut(o), i, 0, la, le);
                    if wide {
                        put(borrow_mut(o.op), i, 2);
                    }
                }
            }
        }
        op2 := o.op[i];
        if (op2 == 1) & (o.k0[i] == 1) & (o.k1[i] == 1) & (o.v0[i] == o.v1[i]) {
            kill(borrow_mut(o), i);
            i += 1;
            continue;
        }
        w := writes(borrow(o), i);
        // Facts of the source register, captured before the destination is invalidated.
        mut src_imm = 0;
        mut src_slot = 0;
        mut src_slotv = 0;
        if (o.k0[i] == 1) & (op2 == 1) {
            r := o.v0[i];
            if reg_fact_valid(borrow(f), r) {
                src_imm = f.rimm[r];
                src_slot = f.rslot[r];
                src_slotv = f.rslotv[r];
            }
        }
        for r in 16 {
            if (w >> r) & 1 {
                reg_written(borrow_mut(f), r);
            }
        }
        if slot_written(borrow(o), i) {
            n := o.v1[i] / 8;
            t3 := f.sver[n] + 1;
            put(borrow_mut(f.sver), n, t3);
            if (op2 == 1) & (f.bad[n] == 0) {
                fresh_facts(borrow_mut(f), n);
                if o.k0[i] == 1 {
                    r := o.v0[i];
                    put(borrow_mut(f.sreg), n, r + 1);
                    t4 := f.rver[r];
                    put(borrow_mut(f.sregv), n, t4);
                    if src_imm != 0 {
                        put(borrow_mut(f.simm), n, src_imm);
                    }
                    if src_slot != 0 {
                        m := src_slot - 1;
                        if (m != n) & (src_slotv == f.sver[m]) {
                            put(borrow_mut(f.scopy), n, m + 1);
                            t5 := f.sver[m];
                            put(borrow_mut(f.scopyv), n, t5);
                        }
                    }
                }
                if o.k0[i] == 3 {
                    put(borrow_mut(f.simm), n, i + 1);
                }
            }
        }
        if ((op2 == 1) + (op2 == 2)) & (o.k1[i] == 1) {
            q := o.v1[i];
            put(borrow_mut(f.rep), q, f.epoch);
            if o.k0[i] == 3 {
                put(borrow_mut(f.rimm), q, i + 1);
            }
            if o.k0[i] == 1 {
                put(borrow_mut(f.rimm), q, src_imm);
                put(borrow_mut(f.rslot), q, src_slot);
                put(borrow_mut(f.rslotv), q, src_slotv);
                r := o.v0[i];
                if r != q {
                    put(borrow_mut(f.rcopy), q, r + 1);
                    cv := f.rver[r];
                    put(borrow_mut(f.rcopyv), q, cv);
                }
            }
            if o.k0[i] == 2 {
                n := o.v0[i] / 8;
                if f.bad[n] == 0 {
                    put(borrow_mut(f.rslot), q, n + 1);
                    t6 := f.sver[n];
                    put(borrow_mut(f.rslotv), q, t6);
                    if facts_valid(borrow(f), n) == 0 {
                        fresh_facts(borrow_mut(f), n);
                    }
                    put(borrow_mut(f.sreg), n, q + 1);
                    t7 := f.rver[q];
                    put(borrow_mut(f.sregv), n, t7);
                }
            }
            if loaded != 0 {
                n := loaded - 1;
                if o.k0[i] != 2 {
                    put(borrow_mut(f.rslot), q, n + 1);
                    t8 := f.sver[n];
                    put(borrow_mut(f.rslotv), q, t8);
                }
            }
        }
        if is_jump(op2) & (op2 != 15) {
            ep := f.epoch + 1;
            exchange(borrow_mut(f.epoch), ep);
        }
        if (op2 == 29) + (op2 == 30) {
            ep := f.epoch + 1;
            exchange(borrow_mut(f.epoch), ep);
        }
        i += 1;
    }
}
fn count_reads<a, c>(o: (&a O), f: (&mut c F), first: u64, last: u64) {
    for n in f.reads.len() {
        put(borrow_mut(f.reads), n, 0);
    }
    for i in last - first {
        j := first + i;
        if o.del[j] == 0 {
            if slot_read(borrow(o), j, 0) {
                n := o.v0[j] / 8;
                t9 := f.reads[n] + 1;
                put(borrow_mut(f.reads), n, t9);
            }
            if slot_read(borrow(o), j, 1) {
                n := o.v1[j] / 8;
                t10 := f.reads[n] + 1;
                put(borrow_mut(f.reads), n, t10);
            }
        }
    }
}
fn dead_stores<a, c>(o: (&mut a O), f: (&mut c F), first: u64, last: u64) {
    count_reads(borrow(o), borrow_mut(f), first, last);
    for i in last - first {
        j := first + i;
        if (o.del[j] == 0) & (o.op[j] == 1) & (o.k1[j] == 2) {
            n := o.v1[j] / 8;
            if (f.bad[n] == 0) & (f.reads[n] == 0) {
                kill(borrow_mut(o), j);
            }
        }
    }
}
// Function-wide backward liveness over the label graph (iterated to a fixed point); unknown
// jump targets and unrecognized instructions make every register live.
fn live_pass<a, c>(o: (&mut a O), lin: (&mut c u64[]), remove: u64) -> u64 {
    last := o.op.len();
    mut live = 0;
    mut i = last;
    mut changed = 0;
    while 0 < i {
        i -= 1;
        if (o.del[i] == 0) & (o.tr[i] == 0) {
            op := o.op[i];
            if op == 100 {
                if lin[i] != live {
                    put(borrow_mut(lin), i, live);
                    changed = 1;
                }
            } else {
                if op != 101 {
                    if (op == 16) + ((16 < op) & (op < 25)) {
                        t := jump_target(borrow(o), i);
                        mut there = all_regs();
                        if t < last {
                            there = lin[t];
                        }
                        if op == 16 {
                            live = there;
                        } else {
                            live = live | there;
                        }
                    } else {
                        if (op == 29) + (op == 30) {
                            live = 1;
                        } else {
                            if op == 0 {
                                live = all_regs();
                            } else {
                                mut removable = 0;
                                if remove & movelike(op) & (o.k1[i] == 1) {
                                    q := o.v1[i];
                                    if (((live >> q) & 1) == 0) & (q != 4) & (q != 5) {
                                        removable = 1;
                                    }
                                    if (op == 1) & (o.k0[i] == 1) & (o.v0[i] == q) {
                                        removable = 1;
                                    }
                                }
                                if removable {
                                    kill(borrow_mut(o), i);
                                } else {
                                    live = (live & (all_regs() - writes(borrow(o), i)))
                                        | reads(borrow(o), i);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return changed;
}
fn dead_defs<a, b>(o: (&mut a O), s: read<b>, first: u64, last: u64) {
    mut lin = u64[];
    for i in last {
        lin.push(0);
    }
    mut rounds = 0;
    while rounds < 50 {
        rounds += 1;
        if live_pass(borrow_mut(o), borrow_mut(lin), 0) == 0 {
            break;
        }
    }
    if rounds < 50 {
        live_pass(borrow_mut(o), borrow_mut(lin), 1);
    }
}
fn next_live<a>(o: (&a O), i: u64, last: u64) -> u64 {
    mut j = i + 1;
    while j < last {
        if (o.del[j] == 0) & (o.op[j] != 101) {
            return j;
        }
        j += 1;
    }
    return last;
}
fn next_insn<a>(o: (&a O), i: u64, last: u64) -> u64 {
    mut j = next_live(borrow(o), i, last);
    while j < last {
        if o.op[j] != 100 {
            return j;
        }
        j = next_live(borrow(o), j, last);
    }
    return last;
}
// Whether register r is dead after instruction i: followed forward through jumps (bounded).
fn dead_after<a>(o: (&a O), i: u64, r: u64, budget: u64) -> u64 {
    last := o.op.len();
    if budget == 0 {
        return false;
    }
    mut j = i;
    mut steps = 0;
    while steps < 40 {
        steps += 1;
        j = next_insn(borrow(o), j, last);
        if j >= last {
            return false;
        }
        op := o.op[j];
        rd := reads(borrow(o), j);
        if (rd >> r) & 1 {
            return false;
        }
        if op == 0 {
            return false;
        }
        wr := writes(borrow(o), j);
        if (wr >> r) & 1 {
            return true;
        }
        if is_jump(op) & (op != 15) {
            t := jump_target(borrow(o), j);
            if t >= last {
                return false;
            }
            if op == 16 {
                j = t;
            } else {
                if dead_after(borrow(o), t, r, budget - 1) == 0 {
                    return false;
                }
            }
        }
        if (op == 29) + (op == 30) {
            return false;
        }
    }
    return false;
}
fn jump_target<a>(o: (&a O), j: u64) -> u64 {
    last := o.op.len();
    if (o.k0[j] != 4) + (o.v0[j] == 0) {
        return last;
    }
    n := o.v0[j] - 1;
    base := o.base;
    if o.m0[j] != 0 {
        return last;
    }
    if n < base {
        return last;
    }
    if n - base >= o.table.len() {
        return last;
    }
    t := o.table[n - base];
    if t == 0 {
        return last;
    }
    return t - 1;
}
fn gen_number<a>(o: (&mut a O), n: u64) -> u64 {
    start := o.gen.len();
    if 9 < n {
        gen_number(borrow_mut(o), n / 10);
    }
    o.gen.push(48 + n % 10);
    return start;
}
fn gen_imm<a>(o: (&mut a O), n: u64, i: u64, j: u64) {
    start := o.gen.len();
    o.gen.push(36);
    gen_number(borrow_mut(o), n);
    end := o.gen.len();
    set_operand(borrow_mut(o), i, j, 5, 0);
    set_range(borrow_mut(o), i, j, start, end);
}
fn imm_value<a, b>(o: (&a O), s: read<b>, i: u64) -> u64 {
    // Decimal immediate of operand 0 (+1), or 0.
    if o.k0[i] != 3 {
        return 0;
    }
    a := o.s0[i] + 1;
    e := o.e0[i];
    if (e <= a) + (e - a > 18) {
        return 0;
    }
    mut n = 0;
    for k in e - a {
        d := s[a + k];
        if (d < 48) + (57 < d) {
            return 0;
        }
        n = n * 10 + d - 48;
    }
    return n + 1;
}
fn peephole<a, b>(o: (&mut a O), s: read<b>, first: u64, last: u64) {
    mut i = first;
    while i < last {
        if o.del[i] {
            i += 1;
            continue;
        }
        op := o.op[i];
        // setCC %al; movzbq %al,%rax; [xorq $1,%rax]; testq %rax,%rax; jz/jnz L  ->  jCC L
        if (op == 25) + (op == 26) + (op == 27) {
            a := next_live(borrow(o), i, last);
            if a < last {
                if (o.op[a] == 28) & (o.k1[a] == 1) & (o.v1[a] == 0) {
                    mut b = next_live(borrow(o), a, last);
                    mut invert = 0;
                    if b < last {
                        if (o.op[b] == 10)
                            & (o.k1[b] == 1)
                            & (o.v1[b] == 0)
                            & (imm_value(borrow(o), &s, b) == 2) {
                            invert = 1;
                            b = next_live(borrow(o), b, last);
                        }
                    }
                    if b < last {
                        if (o.op[b] == 7)
                            & (o.k0[b] == 1)
                            & (o.v0[b] == 0)
                            & (o.k1[b] == 1)
                            & (o.v1[b] == 0) {
                            c := next_live(borrow(o), b, last);
                            if c < last {
                                jop := o.op[c];
                                if (jop == 17) + (jop == 18) + (jop == 19) + (jop == 20) {
                                    t := jump_target(borrow(o), c);
                                    if t < last {
                                        if dead_after(borrow(o), c, 0, 3)
                                            & dead_after(borrow(o), t, 0, 3) {
                                            // jump when the value is non-zero (jnz/jne) or zero (jz/je)
                                            mut when = (jop == 19) + (jop == 20);
                                            if invert {
                                                when = 1 - when;
                                            }
                                            mut nj = 0;
                                            if op == 25 {
                                                if when {
                                                    nj = 17;
                                                } else {
                                                    nj = 19;
                                                }
                                            }
                                            if op == 26 {
                                                if when {
                                                    nj = 19;
                                                } else {
                                                    nj = 17;
                                                }
                                            }
                                            if op == 27 {
                                                if when {
                                                    nj = 23;
                                                } else {
                                                    nj = 22;
                                                }
                                            }
                                            put(borrow_mut(o.op), c, nj);
                                            put(borrow_mut(o.chg), c, 1);
                                            kill(borrow_mut(o), i);
                                            kill(borrow_mut(o), a);
                                            kill(borrow_mut(o), b);
                                            if invert {
                                                mut x = next_live(borrow(o), a, last);
                                                if x < c {
                                                    if o.op[x] == 10 {
                                                        kill(borrow_mut(o), x);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // testq %rcx,%rcx; jnz L; call rt_abort; L: xorq %rdx,%rdx; divq %rcx with rcx = 2^k
        if (op == 7) & (o.k0[i] == 1) & (o.v0[i] == 1) & (o.k1[i] == 1) & (o.v1[i] == 1) {
            j := next_live(borrow(o), i, last);
            if j < last {
                if o.op[j] == 20 {
                    c := next_live(borrow(o), j, last);
                    if c < last {
                        if (o.op[c] == 15)
                            & (o.k0[c] == 4)
                            & same(&s, o.s0[c], o.e0[c], &"rt_abort") {
                            x := next_insn(borrow(o), c, last);
                            if x < last {
                                if (o.op[x] == 10)
                                    & (o.k0[x] == 1)
                                    & (o.v0[x] == 2)
                                    & (o.k1[x] == 1)
                                    & (o.v1[x] == 2) {
                                    d := next_live(borrow(o), x, last);
                                    if d < last {
                                        if (o.op[d] == 13) & (o.k0[d] == 1) & (o.v0[d] == 1) {
                                            // Find the constant in rcx: last definition before the test.
                                            mut k = i;
                                            mut value = 0;
                                            mut steps = 0;
                                            while (first < k) & (steps < 8) {
                                                k -= 1;
                                                steps += 1;
                                                if o.del[k] == 0 {
                                                    kop := o.op[k];
                                                    if (kop == 100) + (kop == 0) + is_jump(kop) {
                                                        break;
                                                    }
                                                    if (writes(borrow(o), k) >> 1) & 1 {
                                                        if ((kop == 1) + (kop == 2))
                                                            & (o.k1[k] == 1) {
                                                            value = imm_value(borrow(o), &s, k);
                                                        }
                                                        break;
                                                    }
                                                }
                                            }
                                            if (value > 1) & (value < 2147483650) {
                                                v := value - 1;
                                                if (v & (v - 1)) == 0 {
                                                    mut shift = 0;
                                                    while (1 << shift) < v {
                                                        shift += 1;
                                                    }
                                                    put(borrow_mut(o.op), i, 1);
                                                    set_operand(borrow_mut(o), i, 0, 1, 0);
                                                    set_operand(borrow_mut(o), i, 1, 1, 2);
                                                    put(borrow_mut(o.op), j, 8);
                                                    gen_imm(borrow_mut(o), v - 1, j, 0);
                                                    set_operand(borrow_mut(o), j, 1, 1, 2);
                                                    put(borrow_mut(o.op), c, 34);
                                                    gen_imm(borrow_mut(o), shift, c, 0);
                                                    set_operand(borrow_mut(o), c, 1, 1, 0);
                                                    kill(borrow_mut(o), x);
                                                    kill(borrow_mut(o), d);
                                                    put(borrow_mut(o.tr), i, 0);
                                                    put(borrow_mut(o.tr), j, 0);
                                                    put(borrow_mut(o.tr), c, 0);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1;
    }
}
// Slot use permitted after promotion: the instruction stays valid with a register operand.
fn promotable_use<a>(o: (&a O), i: u64) -> u64 {
    op := o.op[i];
    if (op == 1)
        + (op == 4)
        + (op == 5)
        + (op == 6)
        + (op == 7)
        + (op == 8)
        + (op == 9)
        + (op == 10)
        + (op == 14) {
        mut other = o.k1[i];
        if o.k1[i] == 2 {
            other = o.k0[i];
        }
        return (other == 0) + (other == 1) + (other == 3) + (other == 5);
    }
    return (op == 11) + (op == 12) + (op == 13);
}
fn emit_operand<a, b>(o: (&mut a O), s: read<b>, i: u64, j: u64) {
    mut k = o.k0[i];
    mut v = o.v0[i];
    mut a = o.s0[i];
    mut e = o.e0[i];
    if j {
        k = o.k1[i];
        v = o.v1[i];
        a = o.s1[i];
        e = o.e1[i];
    }
    if k == 1 {
        o.out.push(37);
        reg_name(borrow_mut(o), v);
        return ();
    }
    if k == 2 {
        o.out.push(45);
        out_number(borrow_mut(o), v);
        app(borrow_mut(o.out), &"(%rbp)");
        return ();
    }
    if k == 5 {
        for x in e - a {
            c := o.gen[a + x];
            o.out.push(c);
        }
        return ();
    }
    for x in e - a {
        o.out.push(s[a + x]);
    }
}
fn reg_name<a>(o: (&mut a O), r: u64) {
    mut t = "";
    if r == 0 {
        t = "rax";
    }
    if r == 1 {
        t = "rcx";
    }
    if r == 2 {
        t = "rdx";
    }
    if r == 3 {
        t = "rbx";
    }
    if r == 4 {
        t = "rsp";
    }
    if r == 5 {
        t = "rbp";
    }
    if r == 6 {
        t = "rsi";
    }
    if r == 7 {
        t = "rdi";
    }
    if r == 8 {
        t = "r8";
    }
    if r == 9 {
        t = "r9";
    }
    if r == 10 {
        t = "r10";
    }
    if r == 11 {
        t = "r11";
    }
    if r == 12 {
        t = "r12";
    }
    if r == 13 {
        t = "r13";
    }
    if r == 14 {
        t = "r14";
    }
    if r == 15 {
        t = "r15";
    }
    app(borrow_mut(o.out), &t);
}
fn out_number<a>(o: (&mut a O), n: u64) {
    if 9 < n {
        out_number(borrow_mut(o), n / 10);
    }
    o.out.push(48 + n % 10);
}
fn emit_line<a, b>(o: (&mut a O), s: read<b>, i: u64) {
    op := o.op[i];
    if (op == 40) + (op == 41) + (op == 44) {
        n := o.uniq + 1;
        exchange(borrow_mut(o.uniq), n);
        app(borrow_mut(o.out), &"cmpq 8(%rdi),%rsi\njb .Lopt");
        out_number(borrow_mut(o), n);
        app(borrow_mut(o.out), &"\ncall rt_abort\n.Lopt");
        out_number(borrow_mut(o), n);
        if op == 40 {
            app(borrow_mut(o.out), &":\nmovq (%rdi),%rax\nleaq (%rax,%rsi,8),%rax\n");
        } else {
            if op == 41 {
                app(borrow_mut(o.out), &":\nmovq (%rdi),%rax\nmovq (%rax,%rsi,8),%rax\n");
            } else {
                app(borrow_mut(o.out), &":\nmovq (%rdi),%rax\nmovzbq (%rax,%rsi,1),%rax\n");
            }
        }
        return ();
    }
    if op == 42 {
        app(borrow_mut(o.out), &"movq 8(%rdi),%rax\n");
        return ();
    }
    if op == 47 {
        app(borrow_mut(o.out), &"movq (%rdi),%rax\nleaq (%rax,%rsi,8),%rax\n");
        return ();
    }
    if op == 48 {
        app(borrow_mut(o.out), &"movq (%rdi),%rax\nmovzbq (%rax,%rsi,1),%rax\n");
        return ();
    }
    if (op == 45) + (op == 46) {
        fast := o.uniq + 1;
        done := o.uniq + 2;
        exchange(borrow_mut(o.uniq), done);
        app(borrow_mut(o.out), &"movq 8(%rdi),%rcx\ncmpq 16(%rdi),%rcx\njb .Lopt");
        out_number(borrow_mut(o), fast);
        if op == 45 {
            app(borrow_mut(o.out), &"\ncall rt_push\njmp .Lopt");
        } else {
            app(borrow_mut(o.out), &"\ncall rt_pushb\njmp .Lopt");
        }
        out_number(borrow_mut(o), done);
        app(borrow_mut(o.out), &"\n.Lopt");
        out_number(borrow_mut(o), fast);
        if op == 45 {
            app(
                borrow_mut(o.out),
                &":\nmovq (%rdi),%rdx\nmovq %rsi,(%rdx,%rcx,8)\nincq %rcx\nmovq %rcx,8(%rdi)\n"
            );
        } else {
            app(
                borrow_mut(o.out),
                &":\nleaq 1(%rcx),%rdx\nmovq %rdx,8(%rdi)\naddq (%rdi),%rcx\nmovq %rsi,%rax\nmovb %al,(%rcx)\n"
            );
        }
        app(borrow_mut(o.out), &"movq $0,%rax\n.Lopt");
        out_number(borrow_mut(o), done);
        app(borrow_mut(o.out), &":\n");
        return ();
    }
    if op == 43 {
        app(borrow_mut(o.out), &"movq (%rdi),%rax\nmovq %rsi,(%rdi)\n");
        return ();
    }
    if o.chg[i] == 0 {
        for x in o.le[i] - o.ls[i] {
            o.out.push(s[o.ls[i] + x]);
        }
        o.out.push(10);
        return ();
    }
    code := o.op[i];
    opname(borrow_mut(o), code);
    if o.k0[i] != 0 {
        o.out.push(32);
        emit_operand(borrow_mut(o), &s, i, 0);
        if o.k1[i] != 0 {
            o.out.push(44);
            emit_operand(borrow_mut(o), &s, i, 1);
        }
    }
    o.out.push(10);
}
fn emit_frame_slot<a, b>(o: (&mut a O), s: read<b>, p: u64, k: u64) {
    // -.FN-8(k+1)(%rbp), where .FN is the frame constant named by the prologue subq.
    app(borrow_mut(o.out), &"-");
    for x in o.e0[p] - o.s0[p] - 1 {
        o.out.push(s[o.s0[p] + 1 + x]);
    }
    app(borrow_mut(o.out), &"-");
    out_number(borrow_mut(o), 8 * (k + 1));
    app(borrow_mut(o.out), &"(%rbp)");
}
fn function<a, b>(o: (&mut a O), s: read<b>) {
    first := 0;
    last := o.op.len();
    ns := o.maxslot / 8 + 1;
    mut f = new_facts(ns);
    // Frame shape: escaping slots, prologue position, label table and loop depth.
    mut prologue = 0;
    mut regs_used = 0;
    mut minlab = 0;
    mut maxlab = 0;
    for i in last {
        op := o.op[i];
        regs_used = regs_used
            | mask_of(o.k0[i], o.v0[i], o.m0[i])
            | mask_of(o.k1[i], o.v1[i], o.m1[i]);
        if (op == 0) + (op == 3) {
            if o.k0[i] == 2 {
                n := o.v0[i];
                put(borrow_mut(f.bad), n / 8, 1);
            }
            if o.k1[i] == 2 {
                put(borrow_mut(f.bad), o.v1[i] / 8, 1);
            }
        }
        if (o.m0[i] >> 5) & 1 {
            if (op == 3) & (o.k0[i] == 4) & same(&s, o.s0[i], o.s0[i] + 3, &"-.F") {} else {
                exchange(borrow_mut(o.weird), 1);
            }
        }
        if (o.m1[i] >> 5) & 1 {
            exchange(borrow_mut(o.weird), 1);
        }
        if (op == 5) & (prologue == 0) & (o.k1[i] == 1) & (o.v1[i] == 4) & (i == 4) {
            if same(&s, o.s0[i], o.s0[i] + 3, &"$.F") {
                prologue = i;
            }
        }
        if o.lab[i] != 0 {
            n := o.lab[i] - 1;
            if minlab == 0 {
                minlab = n + 1;
            } else {
                if n + 1 < minlab {
                    minlab = n + 1;
                }
            }
            if maxlab < n {
                maxlab = n;
            }
        }
        if op == 30 {
            mut p = i;
            mut prev = 0;
            while 0 < p {
                p -= 1;
                if (o.op[p] != 101) & (o.op[p] != 100) {
                    prev = o.op[p];
                    break;
                }
            }
            if prev != 29 {
                exchange(borrow_mut(o.weird), 1);
            }
        }
    }
    if o.weird {
        for i in last {
            emit_line(borrow_mut(o), &s, i);
        }
        return ();
    }
    o.table.clear();
    mut base = 0;
    if minlab != 0 {
        base = minlab - 1;
    }
    exchange(borrow_mut(o.base), base);
    mut refs = u64[];
    if minlab != 0 {
        for x in maxlab - base + 1 {
            o.table.push(0);
            refs.push(0);
        }
        for i in last {
            if o.lab[i] != 0 {
                li := o.lab[i] - 1 - base;
                put(borrow_mut(o.table), li, i + 1);
            }
        }
        for i in last {
            for j in 2 {
                mut v = o.v0[i];
                if j {
                    v = o.v1[i];
                }
                mut k = o.k0[i];
                if j {
                    k = o.k1[i];
                }
                if (k == 4) & (v != 0) {
                    n := v - 1;
                    if n >= base {
                        if n - base < refs.len() {
                            x := refs[n - base] + 1;
                            put(borrow_mut(refs), n - base, x);
                        }
                    }
                }
            }
        }
    }
    // `jcc L; call rt_abort; L:` is transparent: rt_abort never returns, so L is reached only
    // by the jump with the state that preceded it.
    for i in last {
        op := o.op[i];
        if (16 < op) & (op < 25) {
            t := jump_target(borrow(o), i);
            if t < last {
                j := next_live(borrow(o), i, last);
                if j < last {
                    if (o.op[j] == 15) & (o.k0[j] == 4) {
                        if same(&s, o.s0[j], o.e0[j], &"rt_abort") {
                            if (next_live(borrow(o), j, last) == t)
                                & (refs[o.lab[t] - 1 - base] == 1) {
                                put(borrow_mut(o.tr), i, 1);
                                put(borrow_mut(o.tr), j, 1);
                                put(borrow_mut(o.tr), t, 1);
                            }
                        }
                    }
                }
            }
        }
    }
    forward(borrow_mut(o), borrow_mut(f), &s, first, last);
    dead_stores(borrow_mut(o), borrow_mut(f), first, last);
    dead_defs(borrow_mut(o), &s, first, last);
    // Promotion: weights grow 4x per loop nesting level (backward jumps).
    mut chosen = u64[];
    mut slots = u64[];
    if prologue != 0 {
        mut opens = u64[];
        mut closes = u64[];
        for i in last + 1 {
            opens.push(0);
            closes.push(0);
        }
        for i in last {
            op := o.op[i];
            if is_jump(op) & (op != 15) & (o.del[i] == 0) {
                t := jump_target(borrow(o), i);
                if t < i {
                    x := opens[t] + 1;
                    put(borrow_mut(opens), t, x);
                    y := closes[i + 1] + 1;
                    put(borrow_mut(closes), i + 1, y);
                }
            }
        }
        mut d = 0;
        for i in last {
            d += opens[i];
            d -= closes[i];
            if o.del[i] == 0 {
                mut w = 1;
                mut lv = d;
                if 4 < lv {
                    lv = 4;
                }
                while 0 < lv {
                    w = w * 4;
                    lv -= 1;
                }
                for j in 2 {
                    mut k = o.k0[i];
                    mut v = o.v0[i];
                    if j {
                        k = o.k1[i];
                        v = o.v1[i];
                    }
                    if k == 2 {
                        n := v / 8;
                        if f.bad[n] == 0 {
                            if promotable_use(borrow(o), i) {
                                t11 := f.weight[n] + w;
                                put(borrow_mut(f.weight), n, t11);
                            } else {
                                put(borrow_mut(f.bad), n, 1);
                            }
                        }
                    }
                }
            }
        }
        free := u64[3, 12, 13, 14, 15];
        for r in free.len() {
            reg := free[r];
            if ((regs_used >> reg) & 1) == 0 {
                mut best = 0;
                mut bw = 3;
                for n in ns {
                    if (f.bad[n] == 0) & (f.weight[n] > bw) {
                        best = n;
                        bw = f.weight[n];
                    }
                }
                if best != 0 {
                    chosen.push(reg);
                    slots.push(best);
                    put(borrow_mut(f.bad), best, 1);
                }
            }
        }
        if chosen.len() != 0 {
            for i in last {
                if o.del[i] == 0 {
                    for j in 2 {
                        mut k = o.k0[i];
                        mut v = o.v0[i];
                        if j {
                            k = o.k1[i];
                            v = o.v1[i];
                        }
                        if k == 2 {
                            for c in slots.len() {
                                if slots[c] * 8 == v {
                                    set_operand(borrow_mut(o), i, j, 1, chosen[c]);
                                }
                            }
                        }
                    }
                }
            }
            mut g = new_facts(ns);
            for n in ns {
                b := f.bad[n];
                put(borrow_mut(g.bad), n, b);
            }
            forward(borrow_mut(o), borrow_mut(g), &s, first, last);
            dead_defs(borrow_mut(o), &s, first, last);
        }
    }
    peephole(borrow_mut(o), &s, first, last);
    dead_defs(borrow_mut(o), &s, first, last);
    newframe := compact(borrow_mut(o), &s, prologue, ns);
    for i in last {
        if (newframe != 0) & (i + 1 == last) {
            app(borrow_mut(o.out), &".set ");
            pa := o.s0[prologue] + 1;
            pe := o.e0[prologue];
            for x in pe - pa {
                o.out.push(s[pa + x]);
            }
            o.out.push(44);
            out_number(borrow_mut(o), newframe);
            o.out.push(10);
            continue;
        }
        if (chosen.len() != 0) & (o.op[i] == 29) & (o.del[i] == 0) {
            for c in chosen.len() {
                app(borrow_mut(o.out), &"movq ");
                emit_frame_slot(borrow_mut(o), &s, prologue, c);
                app(borrow_mut(o.out), &",%");
                reg_name(borrow_mut(o), chosen[c]);
                o.out.push(10);
            }
        }
        if o.del[i] == 0 {
            emit_line(borrow_mut(o), &s, i);
        }
        if (o.zline != 0) & (i + 1 == o.zline) {
            mut k = o.zfrom;
            while k < o.zto + 1 {
                app(borrow_mut(o.out), &"movq $0,-");
                out_number(borrow_mut(o), k * 8);
                app(borrow_mut(o.out), &"(%rbp)\n");
                k += 1;
            }
        }
        if (chosen.len() != 0) & (i == prologue) {
            app(borrow_mut(o.out), &"subq $");
            out_number(borrow_mut(o), 16 * ((chosen.len() + 1) / 2));
            app(borrow_mut(o.out), &",%rsp\n");
            for c in chosen.len() {
                app(borrow_mut(o.out), &"movq %");
                reg_name(borrow_mut(o), chosen[c]);
                o.out.push(44);
                emit_frame_slot(borrow_mut(o), &s, prologue, c);
                o.out.push(10);
            }
            for c in chosen.len() {
                app(borrow_mut(o.out), &"movq $0,%");
                reg_name(borrow_mut(o), chosen[c]);
                o.out.push(10);
            }
        }
    }
    if (prologue != 0) & (chosen.len() == 0) & (o.zline != 0) {
        inline_candidate(borrow_mut(o), &s, prologue);
    }
}
fn name_hash<b>(s: read<b>, a: u64, e: u64) -> u64 {
    mut h = 0;
    for i in e - a {
        h = (h * 31 + s[a + i]) % 4093;
    }
    return h;
}
// A small leaf (no calls but rt_abort, no callee-saved registers, small cleared frame) gets a
// frameless copy of its body: slots move to free scratch registers, returns jump to the end.
// Calls to it are replaced by that body after all functions are optimized.
fn inline_candidate<a, b>(o: (&mut a O), s: read<b>, prologue: u64) {
    last := o.op.len();
    mut count = 0;
    mut used = 0;
    // rbx, rsp, rbp (outside slots) and r12..r15 must not appear.
    forbidden := 8 + 16 + 32 + 4096 + 8192 + 16384 + 32768;
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            op := o.op[i];
            if op == 101 {
                if i + 1 != last {
                    return ();
                }
            } else {
                if op != 100 {
                    count += 1;
                    if 24 < count {
                        return ();
                    }
                    if (op == 0) + (op == 31) + (op == 32) + (op == 45) + (op == 46) {
                        return ();
                    }
                    if op == 15 {
                        if o.k0[i] != 4 {
                            return ();
                        }
                        if same(&s, o.s0[i], o.e0[i], &"rt_abort") == 0 {
                            return ();
                        }
                    }
                    m := mask_of(o.k0[i], o.v0[i], o.m0[i]) | mask_of(o.k1[i], o.v1[i], o.m1[i]);
                    if (m & forbidden) != 0 {
                        return ();
                    }
                    used = used | m;
                }
            }
        }
    }
    // Map every slot in the body to a free caller-saved register.
    free := u64[8, 9, 10, 11, 2, 1, 6, 7];
    mut slots = u64[];
    mut regs = u64[];
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            for j in 2 {
                mut k = o.k0[i];
                mut v = o.v0[i];
                if j {
                    k = o.k1[i];
                    v = o.v1[i];
                }
                if k == 2 {
                    mut known = 0;
                    for x in slots.len() {
                        if slots[x] == v {
                            known = 1;
                        }
                    }
                    if known == 0 {
                        mut pick = 99;
                        for f in free.len() {
                            r := free[f];
                            mut taken = (used >> r) & 1;
                            for y in regs.len() {
                                if regs[y] == r {
                                    taken = 1;
                                }
                            }
                            if (taken == 0) & (pick == 99) {
                                pick = r;
                            }
                        }
                        if pick == 99 {
                            return ();
                        }
                        slots.push(v);
                        regs.push(pick);
                    }
                }
            }
        }
    }
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            for j in 2 {
                mut k = o.k0[i];
                mut v = o.v0[i];
                if j {
                    k = o.k1[i];
                    v = o.v1[i];
                }
                if k == 2 {
                    for x in slots.len() {
                        if slots[x] == v {
                            r := regs[x];
                            set_operand(borrow_mut(o), i, j, 1, r);
                        }
                    }
                }
            }
        }
    }
    mark := o.out.len();
    // Cleared (non-parameter) slots start at zero, as the frame zeroing guaranteed.
    for x in slots.len() {
        if o.zfrom * 8 < slots[x] + 1 {
            app(borrow_mut(o.out), &"movq $0,%");
            reg_name(borrow_mut(o), regs[x]);
            o.out.push(10);
        }
    }
    for i in last {
        if (prologue < i) & (o.del[i] == 0) & (i + 1 != last) {
            op := o.op[i];
            if op == 30 {
                app(borrow_mut(o.out), &"jmp .Lret\n");
            } else {
                if op != 29 {
                    emit_line(borrow_mut(o), &s, i);
                }
            }
        }
    }
    app(borrow_mut(o.out), &".Lret:\n");
    mut body = u8[];
    for x in o.out.len() - mark {
        c := o.out[mark + x];
        body.push(c);
    }
    while mark < o.out.len() {
        o.out.pop();
    }
    na := o.ls[1];
    ne := o.le[1] - 1;
    mut name = u8[];
    for x in ne - na {
        name.push(s[na + x]);
    }
    h := name_hash(&s, na, ne);
    index := o.inl_names.len();
    o.inl_names.push(name);
    o.inl_bodies.push(body);
    old := o.inl_head[h];
    o.inl_next.push(old);
    put(borrow_mut(o.inl_head), h, index + 1);
}
// Replaces `call NAME` lines for inlinable functions by their bodies with per-site labels.
fn inline_calls<a>(o: (&mut a O)) {
    text := exchange(borrow_mut(o.out), u8[]);
    mut start = 0;
    mut site = 0;
    for i in text.len() {
        if text[i] == 10 {
            a := start;
            e := i;
            start = i + 1;
            mut done = 0;
            if (e - a > 5) & (text[a] == 99) {
                if same(&text, a, a + 5, &"call ") {
                    h := name_hash(&text, a + 5, e);
                    mut k = o.inl_head[h];
                    while k != 0 {
                        n := &o.inl_names[k - 1];
                        if same(&text, a + 5, e, &n) {
                            site += 1;
                            emit_body(borrow_mut(o), k - 1, site);
                            done = 1;
                            break;
                        }
                        k = o.inl_next[k - 1];
                    }
                }
            }
            if done == 0 {
                for x in e - a {
                    o.out.push(text[a + x]);
                }
                o.out.push(10);
            }
        }
    }
    for x in text.len() - start {
        o.out.push(text[start + x]);
    }
}
fn emit_body<a>(o: (&mut a O), k: u64, site: u64) {
    body := o.inl_bodies[k].copy();
    mut i = 0;
    n := body.len();
    while i < n {
        c := body[i];
        mut label = 0;
        if (c == 46) & (i + 1 < n) {
            if body[i + 1] == 76 {
                if i == 0 {
                    label = 1;
                } else {
                    p := body[i - 1];
                    if alnum(p) + (p == 95) == 0 {
                        label = 1;
                    }
                }
            }
        }
        if label {
            while i < n {
                d := body[i];
                if (alnum(d) + (d == 95) + (d == 46)) == 0 {
                    break;
                }
                o.out.push(d);
                i += 1;
            }
            app(borrow_mut(o.out), &"_i");
            out_number(borrow_mut(o), site);
        } else {
            o.out.push(c);
            i += 1;
        }
    }
}
// Renumber the slots still referenced into a dense frame (parameters keep the top slots), so
// the entry zeroing only clears live storage. Returns the new frame size, or 0 if unchanged.
fn compact<a, b>(o: (&mut a O), s: read<b>, prologue: u64, ns: u64) -> u64 {
    if prologue == 0 {
        return 0;
    }
    last := o.op.len();
    // Parameter count from the zeroing count `movq $.FN/8-P,%rcx`.
    mut params = ns;
    for i in last {
        if (o.op[i] == 1) & (o.k0[i] == 3) & (o.k1[i] == 1) & (o.v1[i] == 1) & (params == ns) {
            a := o.s0[i];
            e := o.e0[i];
            if (e - a > 4) & (s[a + 1] == 46) {
                mut j = e;
                while a < j {
                    if s[j - 1] == 45 {
                        break;
                    }
                    j -= 1;
                }
                if a < j {
                    mut n = 0;
                    mut ok = 1;
                    for x in e - j {
                        d := s[j + x];
                        if (d < 48) + (57 < d) {
                            ok = 0;
                        } else {
                            n = n * 10 + d - 48;
                        }
                    }
                    if ok {
                        params = n;
                    }
                }
            }
        }
    }
    if params >= ns {
        return 0;
    }
    mut map = u64[];
    for n in ns {
        map.push(0);
    }
    for n in params + 1 {
        put(borrow_mut(map), n, 1);
    }
    for i in last {
        if o.del[i] == 0 {
            if o.k0[i] == 2 {
                put(borrow_mut(map), o.v0[i] / 8, 1);
            }
            if o.k1[i] == 2 {
                put(borrow_mut(map), o.v1[i] / 8, 1);
            }
        }
    }
    mut used = 0;
    for n in ns {
        if n != 0 {
            if map[n] != 0 {
                used += 1;
                put(borrow_mut(map), n, used);
            }
        }
    }
    // A small frame is cleared with direct stores instead of `rep stosq` (leaq/movq/xorl/rep).
    words := (used * 8 + 15) / 16 * 16 / 8;
    exchange(borrow_mut(o.zline), 0);
    if words < params + 17 {
        for i in last {
            if (o.op[i] == 3) & (o.k1[i] == 1) & (o.v1[i] == 7) & (o.k0[i] == 4) {
                if same(&s, o.s0[i], o.s0[i] + 3, &"-.F") {
                    a := next_live(borrow(o), i, last);
                    if a < last {
                        b := next_live(borrow(o), a, last);
                        if b < last {
                            d := next_live(borrow(o), b, last);
                            if d < last {
                                if (o.op[a] == 1)
                                    & (o.k1[a] == 1)
                                    & (o.v1[a] == 1)
                                    & (o.op[b] == 0)
                                    & (o.op[d] == 0)
                                    & same(&s, o.ls[d], o.le[d], &"rep stosq")
                                    & same(&s, o.ls[b], o.le[b], &"xorl %eax,%eax") {
                                    kill(borrow_mut(o), i);
                                    kill(borrow_mut(o), a);
                                    kill(borrow_mut(o), b);
                                    kill(borrow_mut(o), d);
                                    exchange(borrow_mut(o.zline), d + 1);
                                    exchange(borrow_mut(o.zfrom), params + 1);
                                    exchange(borrow_mut(o.zto), words);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    for i in last {
        if o.del[i] == 0 {
            if o.k0[i] == 2 {
                v := map[o.v0[i] / 8] * 8;
                set_operand(borrow_mut(o), i, 0, 2, v);
            }
            if o.k1[i] == 2 {
                v := map[o.v1[i] / 8] * 8;
                set_operand(borrow_mut(o), i, 1, 2, v);
            }
        }
    }
    return (used * 8 + 15) / 16 * 16;
}
fn reset<a>(o: (&mut a O)) {
    o.ls.clear();
    o.le.clear();
    o.op.clear();
    o.chg.clear();
    o.del.clear();
    o.lab.clear();
    o.tr.clear();
    o.k0.clear();
    o.v0.clear();
    o.s0.clear();
    o.e0.clear();
    o.m0.clear();
    o.k1.clear();
    o.v1.clear();
    o.s1.clear();
    o.e1.clear();
    o.m1.clear();
    exchange(borrow_mut(o.gen), u8[]);
    exchange(borrow_mut(o.weird), 0);
    exchange(borrow_mut(o.zline), 0);
    exchange(borrow_mut(o.maxslot), 0);
}
pub fn optimize<b>(s: read<b>) -> u8[] {
    mut o = O {
        ls: u64[],
        le: u64[],
        op: u64[],
        chg: u64[],
        del: u64[],
        lab: u64[],
        tr: u64[],
        k0: u64[],
        v0: u64[],
        s0: u64[],
        e0: u64[],
        m0: u64[],
        k1: u64[],
        v1: u64[],
        s1: u64[],
        e1: u64[],
        m1: u64[],
        gen: u8[],
        out: u8[],
        weird: 0,
        maxslot: 0,
        table: u64[],
        base: 0,
        data: 0,
        uniq: 0,
        zline: 0,
        zfrom: 0,
        zto: 0,
        inl_names: u8[][],
        inl_bodies: u8[][],
        inl_head: u64[],
        inl_next: u64[],
    };
    for i in 4096 {
        o.inl_head.push(0);
    }
    mut start = 0;
    mut inside = 0;
    for i in s.len() {
        if s[i] == 10 {
            a := start;
            e := i;
            start = i + 1;
            if inside == 0 {
                if (e - a > 15) & (s[a] == 46) & (s[a + 1] == 116) {
                    if same(&s, a, a + 6, &".type ") == 0 {} else {
                        if same(&s, e - 9, e, &"@function") {
                            inside = 1;
                        }
                    }
                }
                if inside == 0 {
                    for x in e - a {
                        o.out.push(s[a + x]);
                    }
                    o.out.push(10);
                    continue;
                }
            }
            parse(borrow_mut(o), &s, a, e);
            if (e - a > 6) & (inside != 0) {
                if (s[a] == 46) & (s[a + 1] == 115) & (s[a + 5] == 46) {
                    function(borrow_mut(o), &s);
                    reset(borrow_mut(o));
                    inside = 0;
                }
            }
        }
    }
    if inside {
        function(borrow_mut(o), &s);
    }
    for x in s.len() - start {
        o.out.push(s[start + x]);
    }
    if o.inl_names.len() != 0 {
        inline_calls(borrow_mut(o));
    }
    return exchange(borrow_mut(o.out), u8[]);
}
