        inline_candidate(&mut o, view(s), prologue);
    }
}
fn name_hash<b>(s: &b [u8], a: u64, e: u64) -> u64 {
    mut h = 0;
    for i in e - a {
        h = (h * 31 + s[a + i]) % 4093;
    }
    return h;
}
// A small leaf (no calls but rt_abort, no callee-saved registers, small cleared frame) gets a
// frameless copy of its body: slots move to free scratch registers, returns jump to the end.
// Calls to it are replaced by that body after all functions are optimized.
fn inline_candidate<a, b>(o: (&a mut O), s: &b [u8], prologue: u64) {
    if o.pairs.len() != 0 {
        return ();
    }
    last := o.op.len();
    mut count = 0;
    mut used = 0;
    // rbx, rsp, rbp (outside slots) and r12..r15 must not appear.
    forbidden := 8 + 16 + 32 + 4096 + 8192 + 16384 + 32768;
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            op := o.op[i];
            if op == 101 {
                if i + 1 != last {
                    return ();
                }
            } else {
                if op != 100 {
                    count += 1;
                    if 24 < count {
                        return ();
                    }
                    if op == 0 || op == 31 || op == 32 || op == 45 || op == 46 {
                        return ();
                    }
                    if op == 15 {
                        if o.k0[i] != 4 {
                            return ();
                        }
                        if !same(view(s), o.s0[i], o.e0[i], view("rt_abort")) {
                            return ();
                        }
                    }
                    m := mask_of(o.k0[i], o.v0[i], o.m0[i]) | mask_of(o.k1[i], o.v1[i], o.m1[i]);
                    if (m & forbidden) != 0 {
                        return ();
                    }
                    used = used | m;
                }
            }
        }
    }
    // Map every slot in the body to a free caller-saved register.
    free := u64[8, 9, 10, 11, 2, 1, 6, 7];
    mut slots = u64[];
    mut regs = u64[];
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            for j in 2 {
                mut k = o.k0[i];
                mut v = o.v0[i];
                if j != 0 {
                    k = o.k1[i];
                    v = o.v1[i];
                }
                if k == 2 {
                    mut known = 0;
                    for x in slots.len() {
                        if slots[x] == v {
                            known = 1;
                        }
                    }
                    if known == 0 {
                        mut pick = 99;
                        for f in free.len() {
                            r := free[f];
                            mut taken = (used >> r) & 1;
                            for y in regs.len() {
                                if regs[y] == r {
                                    taken = 1;
                                }
                            }
                            if (taken == 0) & (pick == 99) {
                                pick = r;
                            }
                        }
                        if pick == 99 {
                            return ();
                        }
                        slots.push(v);
                        regs.push(pick);
                    }
                }
            }
        }
    }
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            for j in 2 {
                mut k = o.k0[i];
                mut v = o.v0[i];
                if j != 0 {
                    k = o.k1[i];
                    v = o.v1[i];
                }
                if k == 2 {
                    for x in slots.len() {
                        if slots[x] == v {
                            r := regs[x];
                            set_operand(&mut o, i, j, 1, r);
                        }
                    }
                }
            }
        }
    }
    mark := o.out.len();
    // Cleared (non-parameter) slots start at zero, as the frame zeroing guaranteed.
    for x in slots.len() {
        if o.zfrom * 8 < slots[x] + 1 {
            app(&mut o.out, view("movq $0,%"));
            reg_name(&mut o, regs[x]);
            o.out.push(10);
        }
    }
    for i in last {
        if (prologue < i) & (o.del[i] == 0) & (i + 1 != last) {
            op := o.op[i];
            if op == 30 {
                app(&mut o.out, view("jmp .Lret\n"));
            } else {
                if op != 29 {
                    emit_line(&mut o, view(s), i);
                }
            }
        }
    }
    app(&mut o.out, view(".Lret:\n"));
    mut body = u8[];
    for x in o.out.len() - mark {
        c := o.out[mark + x];
        body.push(c);
    }
    while mark < o.out.len() {
        o.out.pop();
    }
    na := o.ls[1];
    ne := o.le[1] - 1;
    mut name = u8[];
    for x in ne - na {
        name.push(s[na + x]);
    }
    h := name_hash(view(s), na, ne);
    index := o.inl_names.len();
    o.inl_names.push(name);
    o.inl_bodies.push(body);
    o.inl_units.push(o.unit.copy());
    old := o.inl_head[h];
    o.inl_next.push(old);
    put(&mut o.inl_head, h, index + 1);
}
// Replaces `call NAME` lines for inlinable functions by their bodies with per-site labels.
// Inlining rewrites the output, so the `--split` marker offsets recorded on the way through are
// rewritten with it: markers are copied in stream order, and each one takes its new offset here.
fn inline_calls<a>(o: (&a mut O), split: u64, marks: (&a mut u64[])) {
    text := exchange(&mut o.out, u8[]);
    mut start = 0;
    mut site = 0;
    mut next = 0;
    mut unit = u8[];
    mut uprefix = u8[];
    for i in text.len() {
        if text[i] == 10 {
            a := start;
            e := i;
            start = i + 1;
            mut done = 0;
            if (e - a > 5) & (text[a] == 99) {
                if same(view(text), a, a + 5, view("call ")) {
                    h := name_hash(view(text), a + 5, e);
                    mut k = o.inl_head[h];
                    while k != 0 {
                        n := &o.inl_names[k - 1];
                        // Only a body this unit emits: inlining across a module boundary would make
                        // the caller's text a function of a body its own module never declares, and
                        // a module compiled alone has no other module's bodies anyway.
                        mut here = 1;
                        u := &unit;
                        ul := u.len();
                        if ul != 0 {
                            // `same` is this module's slice-vs-token comparison: whole, so 0..len.
                            if !same(view(o.inl_units[k - 1]), 0, ul, view(u)) {
                                here = 0;
                            }
                        }
                        if (here != 0) & same(view(text), a + 5, e, view(n)) {
                            site += 1;
                            emit_body(&mut o, k - 1, site, view(uprefix));
                            done = 1;
                            break;
                        }
                        k = o.inl_next[k - 1];
                    }
                }
            }
            if done == 0 {
                if (e - a > 12) & (text[a] == 46) & same(view(text), a, a + 12, view(".grail_part ")) {
                    mut fresh = u8[];
                    mut at = a + 12;
                    while (at < e) & (text[at] != 32) {
                        fresh.push(text[at]);
                        at += 1;
                    }
                    exchange(&mut unit, fresh);
                    mut fresh_prefix = u8[];
                    at += 1;
                    while at < e {
                        fresh_prefix.push(text[at]);
                        at += 1;
                    }
                    exchange(&mut uprefix, fresh_prefix);
                    // A unit starts its own inline-site numbers, so one unit's text does not depend
                    // on how many sites the units before it expanded.
                    site = 0;
                    if split != 0 {
                        if next < marks.len() {
                            exchange(&mut marks[next], o.out.len());
                            next += 1;
                        }
                    } else {
                        // A single-file build keeps no markers: they are the splitter's, and the
                        // units they name exist only for the optimizer's own decisions.
                        done = 1;
                    }
                }
                if done == 0 {
                    for x in e - a {
                        o.out.push(text[a + x]);
                    }
                    o.out.push(10);
                }
            }
        }
    }
    for x in text.len() - start {
        o.out.push(text[start + x]);
    }
}
// `_i<unit prefix>_<site>` on every `.L` in the body: the site number disambiguates two copies of
// one body, and the unit prefix keeps a body label without a prefix of its own (`.Lret`) apart from
// the same label minted by another unit of the same file.
fn emit_body<a, b>(o: (&a mut O), k: u64, site: u64, prefix: &b [u8]) {
    body := o.inl_bodies[k].copy();
    mut i = 0;
    n := body.len();
    while i < n {
        c := body[i];
        mut label = 0;
        if (c == 46) & (i + 1 < n) {
            if body[i + 1] == 76 {
                if i == 0 {
                    label = 1;
                } else {
                    p := body[i - 1];
                    if !alnum(p) && p != 95 {
                        label = 1;
                    }
                }
            }
        }
        if label != 0 {
            while i < n {
                d := body[i];
                if !(alnum(d) || d == 95 || d == 46) {
                    break;
                }
                o.out.push(d);
                i += 1;
            }
            app(&mut o.out, view("_i"));
            app(&mut o.out, view(prefix));
            o.out.push(95);
            out_number(&mut o, site);
        } else {
            o.out.push(c);
            i += 1;
        }
    }
}
// Renumber the slots still referenced into a dense frame (parameters keep the top slots), so
// the entry zeroing only clears live storage. Returns the new frame size, or 0 if unchanged.
fn compact<a, b>(o: (&a mut O), s: &b [u8], prologue: u64, ns: u64) -> u64 {
    if prologue == 0 {
        return 0;
    }
    last := o.op.len();
    // Parameter count from the zeroing count `movq $.FN/8-P,%rcx`.
    mut params = ns;
    for i in last {
        if (o.op[i] == 1) & (o.k0[i] == 3) & (o.k1[i] == 1) & (o.v1[i] == 1) & (params == ns) {
            a := o.s0[i];
            e := o.e0[i];
            if (e - a > 4) & (s[a + 1] == 46) {
                mut j = e;
                while a < j {
                    if s[j - 1] == 45 {
                        break;
                    }
                    j -= 1;
                }
                if a < j {
                    mut n = 0;
                    mut ok = 1;
                    for x in e - j {
                        d := s[j + x];
                        if d < 48 || 57 < d {
                            ok = 0;
                        } else {
                            n = n * 10 + d - 48;
                        }
                    }
                    if ok != 0 {
                        params = n;
                    }
                }
            }
        }
    }
    if params >= ns {
        return 0;
    }
    mut map = u64[];
    for n in ns {
        map.push(0);
    }
    for n in params + 1 {
        put(&mut map, n, 1);
    }
    for i in last {
        if o.del[i] == 0 {
            if o.k0[i] == 2 {
                put(&mut map, o.v0[i] / 8, 1);
            }
            if o.k1[i] == 2 {
                put(&mut map, o.v1[i] / 8, 1);
            }
        }
    }
    // A two-word value keeps both slots whether or not each has a direct reader, and slots are
    // renumbered in ascending order, so its words stay adjacent and in order: word 1 keeps the slot
    // above word 0, where `8(%handle)` finds it.
    if o.pair.len() != 0 {
        for n in ns {
            if o.pair[n] != 0 {
                put(&mut map, n, 1);
            }
        }
    }
    mut used = 0;
    for n in ns {
        if n != 0 {
            if map[n] != 0 {
                used += 1;
                put(&mut map, n, used);
            }
        }
    }
    // A small frame is cleared with direct stores instead of `rep stosq` (leaq/movq/xorl/rep).
    words := (used * 8 + 15) / 16 * 16 / 8;
    exchange(&mut o.zline, 0);
    if words < params + 17 {
        for i in last {
            if (o.op[i] == 3) & (o.k1[i] == 1) & (o.v1[i] == 7) & (o.k0[i] == 4) {
                if same(view(s), o.s0[i], o.s0[i] + 3, view("-.F")) {
                    a := next_live(&o, i, last);
                    if a < last {
                        b := next_live(&o, a, last);
                        if b < last {
                            d := next_live(&o, b, last);
                            if d < last {
                                if (o.op[a] == 1)
                                    & (o.k1[a] == 1)
                                    & (o.v1[a] == 1)
                                    & (o.op[b] == 0)
                                    & (o.op[d] == 0)
                                    & same(view(s), o.ls[d], o.le[d], view("rep stosq"))
                                    & same(view(s), o.ls[b], o.le[b], view("xorl %eax,%eax")) {
                                    kill(&mut o, i);
                                    kill(&mut o, a);
                                    kill(&mut o, b);
                                    kill(&mut o, d);
                                    exchange(&mut o.zline, d + 1);
                                    exchange(&mut o.zfrom, params + 1);
                                    exchange(&mut o.zto, words);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    for i in last {
        if o.del[i] == 0 {
            if o.k0[i] == 2 {
                set_operand(&mut o, i, 0, 2, map[o.v0[i] / 8] * 8);
            }
            if o.k1[i] == 2 {
                set_operand(&mut o, i, 1, 2, map[o.v1[i] / 8] * 8);
            }
        }
    }
    return (used * 8 + 15) / 16 * 16;
}
fn reset<a>(o: (&a mut O)) {
    o.ls.clear();
    o.le.clear();
    o.op.clear();
    o.chg.clear();
    o.del.clear();
    o.lab.clear();
    o.tr.clear();
    o.k0.clear();
    o.v0.clear();
    o.s0.clear();
    o.e0.clear();
    o.m0.clear();
    o.k1.clear();
    o.v1.clear();
    o.s1.clear();
    o.e1.clear();
    o.m1.clear();
    exchange(&mut o.gen, u8[]);
    exchange(&mut o.pairs, u64[]);
    exchange(&mut o.pair, u64[]);
    exchange(&mut o.ret2, 0);
    exchange(&mut o.weird, 0);
    exchange(&mut o.zline, 0);
    exchange(&mut o.maxslot, 0);
}
pub fn optimize<b>(s: &b [u8]) -> u8[] {
    mut marks = u64[];
    mut names = u8[][];
    return optimize_parts(view(s), 0, &mut marks, &mut names);
}
// `optimize` plus the positions of the `--split` module markers it kept: for each marker line, the
// output offset of the line and the module name it carries. A single-file build passes `split` 0 and
// pays nothing. `native.grl` splits at these offsets, so the stream never has to be scanned again.
pub fn optimize_parts<b>(s: &b [u8], split: u64, marks: (&mut u64[]), names: (&mut u8[][])) -> u8[] {
    mut o = O {
        ls: u64[],
        le: u64[],
        op: u64[],
        chg: u64[],
        del: u64[],
        lab: u64[],
        tr: u64[],
        k0: u64[],
        v0: u64[],
        s0: u64[],
        e0: u64[],
        m0: u64[],
        k1: u64[],
        v1: u64[],
        s1: u64[],
        e1: u64[],
        m1: u64[],
        gen: u8[],
        out: u8[],
        weird: 0,
        maxslot: 0,
        table: u64[],
        base: 0,
        data: 0,
        uniq: 0,
        zline: 0,
        zfrom: 0,
        zto: 0,
        pairs: u64[],
        pair: u64[],
        ret2: 0,
        inl_names: u8[][],
        inl_bodies: u8[][],
        inl_units: u8[][],
        inl_head: u64[],
        inl_next: u64[],
        unit: u8[],
        uprefix: u8[],
        marked: 0,
        uniq_index: 0,
        uniq_units: u8[][],
        uniq_next: u64[],
    };
    for i in 4096 {
        o.inl_head.push(0);
    }
    mut start = 0;
    mut inside = 0;
    for i in s.len() {
        if s[i] == 10 {
            a := start;
            e := i;
            start = i + 1;
            if inside == 0 {
                if (e - a > 15) & (s[a] == 46) & (s[a + 1] == 116) {
                    if !same(view(s), a, a + 6, view(".type ")) {} else {
                        if same(view(s), e - 9, e, view("@function")) {
                            inside = 1;
                        }
                    }
                }
                if inside == 0 {
                    if marker(&mut o, view(s), a, e) != 0 {
                        if split != 0 {
                            marks.push(o.out.len());
                            names.push(o.unit.copy());
                        }
                    }
                    for x in e - a {
                        o.out.push(s[a + x]);
                    }
                    o.out.push(10);
                    continue;
                }
            }
            parse(&mut o, view(s), a, e);
            if (e - a > 6) & (inside != 0) {
                if (s[a] == 46) & (s[a + 1] == 115) & (s[a + 5] == 46) {
                    function(&mut o, view(s));
                    reset(&mut o);
                    inside = 0;
                }
            }
        }
    }
    if inside != 0 {
        function(&mut o, view(s));
    }
    for x in s.len() - start {
        o.out.push(s[start + x]);
    }
    // Either something inlines, or the markers have to be taken out of a single-file build.
    if (o.inl_names.len() != 0) || (o.marked != 0) {
        inline_calls(&mut o, split, marks);
    }
    return exchange(&mut o.out, u8[]);
}
