        // does not come back).
        app(&mut o.out, view("movb %dl,(%"));
        reg_name(&mut o, data);
        app(&mut o.out, view(",%rsi,1)\n"));
        return ();
    }
    if (op == 90) || (op == 95) {
        app(&mut o.out, view("leaq (%"));
    } else if (op == 93) || (op == 97) {
        app(&mut o.out, view("leaq (%"));
    } else if op == 91 {
        app(&mut o.out, view("movq (%"));
    } else if op == 94 {
        app(&mut o.out, view("movl (%"));
