fn regcode<b>(s: &b [u8], a: u64, e: u64) -> u64 {
    if e <= a || e - a > 4 {
        return 99;
    }
    mut k = 0;
    for i in e - a {
        k = k | (s[a + i] << (8 * i));
    }
    return reg_key(k);
}
fn alnum(c: u64) -> bool {
    return ((47 < c) && (c < 58)) || ((96 < c) && (c < 123)) || ((64 < c) && (c < 91));
}
// Registers mentioned anywhere in s[a:e] (bit 5 marks an rbp use).
fn mentions<b>(s: &b [u8], a: u64, e: u64) -> u64 {
    mut m = 0;
    mut i = a;
    while i < e {
        if s[i] == 37 {
            mut j = i + 1;
            while j < e {
                if !alnum(s[j]) {
                    break;
                }
                j += 1;
            }
            r := regcode(view(s), i + 1, j);
            if r < 32 {
                m = m | bit(r % 16);
            }
            i = j;
        } else {
            i += 1;
        }
    }
    return m;
}
// Classifies one operand: returns kind and fills value/mask through the pair encoding.
fn classify<a, b>(o: (&a mut O), s: &b [u8], a: u64, e: u64, second: u64) {
    mut k = 4;
    mut v = 0;
    mut m = 0;
    if a < e {
        c := s[a];
        if c == 37 {
            r := regcode(view(s), a + 1, e);
            if r < 16 {
                k = 1;
                v = r;
            } else {
                k = 6;
                if r < 32 {
                    m = bit(r - 16);
                }
            }
        } else {
            if c == 36 {
                k = 3;
            } else {
                m = mentions(view(s), a, e);
                if (c == 46) & (e - a > 2) {
                    if s[a + 1] == 76 {
                        mut n = 0;
                        mut digits = 0;
                        mut i = a + 2;
                        while i < e {
                            d := s[i];
                            if d < 48 || 57 < d {
                                break;
                            }
                            n = n * 10 + d - 48;
                            digits += 1;
                            i += 1;
                        }
                        if digits != 0 {
                            v = n + 1;
                        }
                    }
                }
                // -N(%rbp) with decimal N is a frame slot.
                if (c == 45) & (e - a > 7) {
                    if same(view(s), e - 6, e, view("(%rbp)")) {
                        mut n = 0;
                        mut ok = 1;
                        for i in e - 7 - a {
                            d := s[a + 1 + i];
                            if d < 48 || 57 < d {
                                ok = 0;
                            } else {
                                n = n * 10 + d - 48;
                            }
                        }
                        if ok != 0 && n != 0 {
                            k = 2;
                            v = n;
                            m = 0;
                            if n % 8 != 0 {
                                exchange(&mut o.weird, 1);
                            }
                            if o.maxslot < n {
                                exchange(&mut o.maxslot, n);
                            }
                        }
                    }
                }
            }
        }
    } else {
        k = 0;
    }
    if second != 0 {
        o.k1.push(k);
        o.v1.push(v);
        o.s1.push(a);
        o.e1.push(e);
        o.m1.push(m);
    } else {
        o.k0.push(k);
        o.v0.push(v);
        o.s0.push(a);
        o.e0.push(e);
        o.m0.push(m);
    }
}
// The counter a label carries: `.L<unit prefix>_<n>` is numbered, everything else is opaque text
// (`.Lopt` expansions, refinement strings, `.Lret` in an inlined body). A stream with no marker -
// a caller that hands the optimizer text it produced itself - keeps the old `.L<n>` numbering.
fn label_number<a, b, d>(s: &a [u8], a: u64, e: u64, uprefix: &d [u8]) -> u64 {
    if (e <= a + 2) || !same(view(s), a, a + 2, view(".L")) {
        return 0;
    }
    mut at = a + 2;
    if uprefix.len() == 0 {
        mut n = 0;
        mut ok = 1;
        while at < e {
            d := s[at];
            if (d < 48) || (57 < d) {
                ok = 0;
                break;
            }
            n = n * 10 + (d - 48);
            at += 1;
        }
        if (ok == 0) || (at == a + 2) {
            return 0;
        }
        return n + 1;
    }
    if !same(view(s), at, e, view(uprefix)) | (e <= at + uprefix.len() + 1) {
        return 0;
    }
    mut i = 0;
    while i < uprefix.len() {
        if s[at + i] != uprefix[i] {
            return 0;
        }
        i += 1;
    }
    at += uprefix.len();
    if s[at] != 95 {
        return 0;
    }
    at += 1;
    mut n = 0;
    while at < e {
        d := s[at];
        if (d < 48) || (57 < d) {
            return 0;
        }
        n = n * 10 + (d - 48);
        at += 1;
    }
    return n + 1;
}
// The marker line: `.grail_part <unit> <label prefix>`, and the unit fields it sets. 1 when the
// line was one.
fn marker<a, b>(o: (&a mut O), s: &b [u8], a: u64, e: u64) -> u64 {
    if (e - a < 14) || (s[a] != 46) || !same(view(s), a, a + 12, view(".grail_part ")) {
        return 0;
    }
    mut unit = u8[];
    mut at = a + 12;
    while (at < e) & (s[at] != 32) {
        unit.push(s[at]);
        at += 1;
    }
    mut prefix = u8[];
    at += 1;
    while at < e {
        prefix.push(s[at]);
        at += 1;
    }
    // Labels and the optimizer's own expansion labels are per unit: this unit's counters resume
    // where it left them, or start at zero the first time.
    mut k = 0;
    while k < o.uniq_units.len() {
        if same(view(o.uniq_units[k]), 0, unit.len(), view(unit)) {
            break;
        }
        k += 1;
    }
    if k == o.uniq_units.len() {
        o.uniq_units.push(unit.copy());
        o.uniq_next.push(0);
    }
    o.uniq_index = k + 1;
    exchange(&mut o.uniq, o.uniq_next[k]);
    exchange(&mut o.unit, unit);
    exchange(&mut o.uprefix, prefix);
    exchange(&mut o.marked, 1);
    return 1;
}
// The next expansion label number of the unit being emitted, kept with that unit.
fn uniq_take<a>(o: (&a mut O)) -> u64 {
    n := o.uniq + 1;
    exchange(&mut o.uniq, n);
    k := o.uniq_index;
    if (k != 0) & (k <= o.uniq_next.len()) {
        o.uniq_next[k - 1] = n;
    }
    return n;
}
fn parse<a, b>(o: (&a mut O), s: &b [u8], a: u64, e: u64) {
    o.ls.push(a);
    o.le.push(e);
    o.chg.push(0);
    o.del.push(0);
    o.tr.push(0);
    mut op = 0;
    mut lab = 0;
    mut space = e;
    // String data between .pushsection/.popsection is inert, including its labels.
    if (e - a > 10) & (s[a] == 46) {
        if s[a + 1] == 112 {
            if s[a + 2] == 117 {
                exchange(&mut o.data, 1);
            }
            if s[a + 2] == 111 {
                exchange(&mut o.data, 0);
                op = 101;
            }
        }
    }
    if o.data != 0 {
        op = 101;
    }
    if op == 101 {} else {
        if a < e {
            if s[e - 1] == 58 {
                op = 100;
                lab = label_number(view(s), a, e - 1, view(o.uprefix));
            } else {
                if s[a] == 46 {
                    op = 101;
                } else {
                    for i in e - a {
                        if s[a + i] == 32 {
                            space = a + i;
                            break;
                        }
                    }
                    mut k = 0;
                    if space - a < 8 {
                        for x in space - a {
                            k = k | (s[a + x] << (8 * x));
                        }
                    }
                    op = opcode_key(k);
                }
            }
        } else {
            op = 101;
        }
    }
    o.op.push(op);
    o.lab.push(lab);
    if op == 101 {
        // `.gpair -N(%rbp)`: the two-word value whose first word lives at that frame address.
        if (e - a > 7) & same(view(s), a, a + 7, view(".gpair ")) {
            last := o.op.len() - 1;
            if same(view(s), a + 7, e, view("ret")) {
                exchange(&mut o.op[last], 102);
                exchange(&mut o.ret2, 1);
                classify(&mut o, view(s), e, e, 0);
                classify(&mut o, view(s), e, e, 1);
                return ();
            }
            exchange(&mut o.op[last], 102);
            classify(&mut o, view(s), a + 7, e, 0);
            classify(&mut o, view(s), e, e, 1);
            n := o.v0[o.v0.len() - 1];
            o.pairs.push(n / 8);
            return ();
        }
    }
    if op == 100 || op == 101 {
        classify(&mut o, view(s), e, e, 0);
        classify(&mut o, view(s), e, e, 1);
        return ();
    }
    // Split operands at the top-level comma.
    mut first = e;
    mut comma = e;
    mut depth = 0;
    if space < e {
        first = space + 1;
    }
    mut i = first;
    while i < e {
        c := s[i];
        if c == 40 {
            depth += 1;
        }
        if c == 41 {
            depth -= 1;
        }
        if (c == 44) & (depth == 0) {
            comma = i;
            break;
        }
        i += 1;
    }
    mut extra = 0;
    if comma < e {
        i = comma + 1;
        while i < e {
            c := s[i];
            if c == 40 {
                depth += 1;
            }
            if c == 41 {
                depth -= 1;
            }
            if (c == 44) & (depth == 0) {
                extra = 1;
            }
            i += 1;
        }
    }
    if extra != 0 {
        // stays: the written place is indexed (`&mut o.op[last]`), and two-phase defers only a
        // plain `&mut path`, so the length read is part of taking the place.
        last := o.op.len() - 1;
        exchange(&mut o.op[last], 0);
    }
    classify(&mut o, view(s), first, comma, 0);
    if comma < e {
        classify(&mut o, view(s), comma + 1, e, 1);
    } else {
        classify(&mut o, view(s), e, e, 1);
    }
    // Calls to the leaf runtime accessors become pseudo-instructions expanded inline at emission:
    // 40 rt_slot, 41 rt_at (bounds-checked element address / load), 42 rt_len, 43 rt_xchg, 44 rt_atb (byte load),
    // 45 rt_push / 46 rt_pushb (inline store when capacity remains, runtime call to grow),
    // 47 rt_slotu / 48 rt_atbu (proven in-bounds element address / byte load).
    if (op == 15) & (comma == e) & (e - first > 5) & (e - first < 9) {
        if (s[first] == 114) & (s[first + 1] == 116) & (s[first + 2] == 95) {
            mut fast = 0;
            if same(view(s), first, e, view("rt_slot")) {
                fast = 40;
            }
            if same(view(s), first, e, view("rt_at")) {
                fast = 41;
            }
            if same(view(s), first, e, view("rt_len")) {
                fast = 42;
            }
            if same(view(s), first, e, view("rt_xchg")) {
                fast = 43;
            }
            if same(view(s), first, e, view("rt_atb")) {
                fast = 44;
            }
            if same(view(s), first, e, view("rt_push")) {
                fast = 45;
            }
            if same(view(s), first, e, view("rt_pushb")) {
                fast = 46;
            }
            if same(view(s), first, e, view("rt_slotu")) {
                fast = 47;
            }
            if same(view(s), first, e, view("rt_atbu")) {
                fast = 48;
            }
            if fast != 0 {
                // stays: the written place is indexed (`&mut o.op[last]`), and two-phase defers
                // only a plain `&mut path`, so the length read is part of taking the place.
                last := o.op.len() - 1;
                exchange(&mut o.op[last], fast);
            }
        }
    }
}
fn movelike(op: u64) -> bool {
    return (op == 1) || (op == 2) || (op == 3) || (op == 28);
}
fn arith(op: u64) -> bool {
    return (op == 4)
        || (op == 5)
        || (op == 8)
        || (op == 9)
        || (op == 10)
        || (op == 14)
        || (op == 33)
        || (op == 34);
}
fn is_jump(op: u64) -> bool {
    return (15 < op) && (op < 25);
}
fn mask_of(k: u64, v: u64, m: u64) -> u64 {
    if k == 1 {
        return bit(v);
    }
    return m;
}
// Registers written by a destination operand (narrow register spellings count as written).
fn dst_writes<a>(o: (&a O), i: u64) -> u64 {
    k := o.k1[i];
    if k == 1 {
        return bit(o.v1[i]);
    }
    if k == 6 {
        return o.m1[i];
    }
    return 0;
}
fn dst_address<a>(o: (&a O), i: u64) -> u64 {
    if o.k1[i] == 1 {
        return 0;
    }
    return o.m1[i];
}
fn reads<a>(o: (&a O), i: u64) -> u64 {
    op := o.op[i];
    src := mask_of(o.k0[i], o.v0[i], o.m0[i]);
    dst := mask_of(o.k1[i], o.v1[i], o.m1[i]);
    if op == 15 {
        return arg_regs() | src;
    }
    if op == 100 || op == 101 || op == 102 || op == 29 || op == 32 || is_jump(op) {
        return 0;
    }
    if movelike(op) {
        return src | dst_address(&o, i);
    }
    if op == 10 {
        if (o.k0[i] == 1) & (o.k1[i] == 1) & (o.v0[i] == o.v1[i]) {
            return 0;
        }
    }
    if arith(op) || (op == 6) || (op == 7) {
        return src | dst;
    }
    if op == 11 {
        return dst;
    }
    if op == 12 {
        return src | 1;
    }
    if op == 13 {
        return src | 5;
    }
    if op == 25 || op == 26 || op == 27 {
        return 1;
    }
    if op == 30 {
        return result_live(&o);
    }
    if op == 31 {
        return src;
    }
    if op == 40
        || op == 41
        || op == 43
        || op == 44
        || op == 45
        || op == 46
        || op == 47
        || op == 48 {
        return 192;
    }
    if op == 42 {
        return 128;
    }
    return all_regs();
}
fn writes<a>(o: (&a O), i: u64) -> u64 {
    op := o.op[i];
    if op == 100 || op == 101 || op == 102 || op == 29 || op == 30 || op == 31 || op == 6 || op == 7 {
        return 0;
    }
    if op == 15 {
        return caller_saved();
    }
    if is_jump(op) {
        return 0;
    }
    if movelike(op) || arith(op) || (op == 11) || (op == 32) {
        return dst_writes(&o, i);
    }
    if op == 12 || op == 13 {
        return 5;
    }
    if op == 25 || op == 26 || op == 27 {
        return 1;
    }
    if (39 < op) & (op < 45) {
        return 1;
    }
    if op == 45 || op == 46 {
        return caller_saved();
    }
    if op == 47 || op == 48 {
        return 1;
    }
    return all_regs();
}
// Whether operand j of instruction i reads / writes a frame slot.
fn slot_read<a>(o: (&a O), i: u64, j: u64) -> bool {
    op := o.op[i];
    if op == 101 || op == 102 {
        return false;
    }
    if j == 0 {
        return o.k0[i] == 2;
    }
    if o.k1[i] != 2 {
        return false;
    }
    if movelike(op) {
        return false;
    }
    return true;
}
fn slot_written<a>(o: (&a O), i: u64) -> bool {
    op := o.op[i];
    if o.k1[i] != 2 {
        return false;
    }
    return movelike(op) || arith(op) || (op == 11) || (op == 0);
}
fn set_operand<a>(o: (&a mut O), i: u64, j: u64, k: u64, v: u64) {
    if j == 0 {
        put(&mut o.k0, i, k);
        put(&mut o.v0, i, v);
        put(&mut o.m0, i, 0);
    } else {
        put(&mut o.k1, i, k);
        put(&mut o.v1, i, v);
        put(&mut o.m1, i, 0);
    }
    put(&mut o.chg, i, 1);
}
fn set_range<a>(o: (&a mut O), i: u64, j: u64, a: u64, e: u64) {
    if j == 0 {
        put(&mut o.s0, i, a);
        put(&mut o.e0, i, e);
    } else {
        put(&mut o.s1, i, a);
        put(&mut o.e1, i, e);
    }
}
fn kill<a>(o: (&a mut O), i: u64) {
    put(&mut o.del, i, 1);
}
struct F {
    // Slot facts (index N/8): register holding the value (+1) and its version, known
    // immediate line (+1), copy-of slot (+1) and its version; valid while ver/epoch match.
    sver: u64[],
    sep: u64[],
    sfv: u64[],
    sreg: u64[],
    sregv: u64[],
    simm: u64[],
    scopy: u64[],
    scopyv: u64[],
    bad: u64[],
    reads: u64[],
    weight: u64[],
    rver: u64[],
    rep: u64[],
    rimm: u64[],
    rslot: u64[],
    rslotv: u64[],
    rcopy: u64[],
    rcopyv: u64[],
    epoch: u64
}
fn facts_valid<a>(f: (&a F), n: u64) -> bool {
    return (f.sep[n] == f.epoch) && (f.sfv[n] == f.sver[n]);
}
fn fresh_facts<a>(f: (&a mut F), n: u64) {
    put(&mut f.sep, n, f.epoch);
    put(&mut f.sfv, n, f.sver[n]);
    put(&mut f.sreg, n, 0);
    put(&mut f.simm, n, 0);
    put(&mut f.scopy, n, 0);
}
fn reg_written<a>(f: (&a mut F), r: u64) {
    put(&mut f.rver, r, f.rver[r] + 1);
    put(&mut f.rimm, r, 0);
    put(&mut f.rslot, r, 0);
    put(&mut f.rcopy, r, 0);
}
fn reg_fact_valid<a>(f: (&a F), r: u64) -> bool {
    return f.rep[r] == f.epoch;
}
fn copy_source<a>(f: (&a F), q: u64) -> u64 {
    if !reg_fact_valid(&f, q) {
        return q;
    }
    c := f.rcopy[q];
    if c == 0 {
        return q;
    }
    r := c - 1;
    if f.rcopyv[q] != f.rver[r] {
        return q;
    }
    return r;
}
// Replace a read of slot n (operand j of i) by a register or constant already holding it.
fn forward_read<a, c>(o: (&a mut O), f: (&c mut F), i: u64, j: u64, n: u64) {
    if !facts_valid(&f, n) {
        return ();
    }
    op := o.op[i];
    if (op == 1) & (j == 0) & (o.k1[i] == 1) & (f.simm[n] != 0) {
        l := f.simm[n] - 1;
        lk := o.k0[l];
        lv := o.v0[l];
        la := o.s0[l];
        le := o.e0[l];
        set_operand(&mut o, i, 0, lk, lv);
        set_range(&mut o, i, 0, la, le);
        put(&mut o.op, i, 2);
        return ();
    }
    if f.sreg[n] != 0 {
        r := f.sreg[n] - 1;
        if f.sregv[n] == f.rver[r] {
            set_operand(&mut o, i, j, 1, r);
            return ();
        }
    }
    if f.scopy[n] != 0 {
        m := f.scopy[n] - 1;
        if f.scopyv[n] == f.sver[m] {
            set_operand(&mut o, i, j, 2, m * 8);
            if facts_valid(&f, m) {
                if f.sreg[m] != 0 {
                    r := f.sreg[m] - 1;
                    if f.sregv[m] == f.rver[r] {
                        set_operand(&mut o, i, j, 1, r);
                    }
                }
            }
        }
    }
}
fn new_facts(ns: u64) -> F {
    mut f = F {
        sver: u64[],
        sep: u64[],
        sfv: u64[],
        sreg: u64[],
        sregv: u64[],
        simm: u64[],
        scopy: u64[],
        scopyv: u64[],
        bad: u64[],
        reads: u64[],
        weight: u64[],
        rver: u64[],
        rep: u64[],
        rimm: u64[],
        rslot: u64[],
        rslotv: u64[],
        rcopy: u64[],
        rcopyv: u64[],
        epoch: 1,
    };
    for i in ns {
        f.sver.push(0);
        f.sep.push(0);
        f.sfv.push(0);
        f.sreg.push(0);
        f.sregv.push(0);
        f.simm.push(0);
        f.scopy.push(0);
        f.scopyv.push(0);
        f.bad.push(0);
        f.reads.push(0);
        f.weight.push(0);
    }
    for i in 16 {
        f.rver.push(0);
        f.rep.push(0);
        f.rimm.push(0);
        f.rslot.push(0);
        f.rslotv.push(0);
        f.rcopy.push(0);
        f.rcopyv.push(0);
    }
    return f;
}
fn forward<a, b, c>(o: (&a mut O), f: (&c mut F), s: &b [u8], first: u64, last: u64) {
    mut i = first;
    while i < last {
        op := o.op[i];
        if o.del[i] != 0 || op == 101 || op == 102 || o.tr[i] != 0 {
            i += 1;
            continue;
        }
        if op == 100 || op == 0 {
            exchange(&mut f.epoch, f.epoch + 1);
            if op == 0 {
                for r in 16 {
                    reg_written(&mut f, r);
                }
            }
            i += 1;
            continue;
        }
        mut loaded = 0;
        if (o.k0[i] == 2) & promotable_use(&o, i) {
            n := o.v0[i] / 8;
            if f.bad[n] == 0 {
                if movelike(op) & (o.k1[i] == 1) {
                    loaded = n + 1;
                }
                forward_read(&mut o, &mut f, i, 0, n);
            }
        }
        if slot_read(&o, i, 1) & promotable_use(&o, i) {
            n := o.v1[i] / 8;
            if f.bad[n] == 0 {
                forward_read(&mut o, &mut f, i, 1, n);
            }
        }
        // Copy propagation: read-only register operands use the original of a register copy.
        if o.k0[i] == 1
            && (op == 1
                    || op == 4
                    || op == 5
                    || op == 6
                    || op == 7
                    || op == 8
                    || op == 9
                    || op == 10) {
            r := copy_source(&f, o.v0[i]);
            if r != o.v0[i] {
                set_operand(&mut o, i, 0, 1, r);
            }
        }
        if o.k1[i] == 1 && (op == 6 || op == 7) {
            r := copy_source(&f, o.v1[i]);
            if r != o.v1[i] {
                set_operand(&mut o, i, 1, 1, r);
            }
        }
        // A register operand known to hold a small constant becomes an immediate - never into an
        // SSE destination (kind 6): `movq $imm,%xmm0` does not exist.
        if o.k0[i] == 1
            && o.k1[i] != 6
            && (op == 1 || op == 4 || op == 5 || op == 6 || op == 8 || op == 9 || op == 10) {
            r := o.v0[i];
            if reg_fact_valid(&f, r) & (f.rimm[r] != 0) {
                l := f.rimm[r] - 1;
                value := imm_value(&o, view(s), l);
                wide := (op == 1) & (o.k1[i] == 1);
                if value != 0 && (wide || value < 2147483649) {
                    la := o.s0[l];
                    le := o.e0[l];
                    set_operand(&mut o, i, 0, 3, 0);
                    set_range(&mut o, i, 0, la, le);
                    if wide {
                        put(&mut o.op, i, 2);
                    }
                }
            }
        }
        op2 := o.op[i];
        if (op2 == 1) & (o.k0[i] == 1) & (o.k1[i] == 1) & (o.v0[i] == o.v1[i]) {
            kill(&mut o, i);
            i += 1;
            continue;
        }
        w := writes(&o, i);
        // Facts of the source register, captured before the destination is invalidated.
        mut src_imm = 0;
        mut src_slot = 0;
        mut src_slotv = 0;
        if (o.k0[i] == 1) & (op2 == 1) {
            r := o.v0[i];
            if reg_fact_valid(&f, r) {
                src_imm = f.rimm[r];
                src_slot = f.rslot[r];
                src_slotv = f.rslotv[r];
            }
        }
        for r in 16 {
            if ((w >> r) & 1) != 0 {
                reg_written(&mut f, r);
            }
        }
        if slot_written(&o, i) {
            n := o.v1[i] / 8;
            put(&mut f.sver, n, f.sver[n] + 1);
            if (op2 == 1) & (f.bad[n] == 0) {
                fresh_facts(&mut f, n);
                if o.k0[i] == 1 {
                    r := o.v0[i];
                    put(&mut f.sreg, n, r + 1);
                    put(&mut f.sregv, n, f.rver[r]);
                    if src_imm != 0 {
                        put(&mut f.simm, n, src_imm);
                    }
                    if src_slot != 0 {
                        m := src_slot - 1;
                        if (m != n) & (src_slotv == f.sver[m]) {
                            put(&mut f.scopy, n, m + 1);
                            put(&mut f.scopyv, n, f.sver[m]);
                        }
                    }
                }
                if o.k0[i] == 3 {
                    put(&mut f.simm, n, i + 1);
                }
            }
        }
        if (op2 == 1 || op2 == 2) && o.k1[i] == 1 {
            q := o.v1[i];
            put(&mut f.rep, q, f.epoch);
            if o.k0[i] == 3 {
                put(&mut f.rimm, q, i + 1);
            }
            if o.k0[i] == 1 {
                put(&mut f.rimm, q, src_imm);
                put(&mut f.rslot, q, src_slot);
                put(&mut f.rslotv, q, src_slotv);
                r := o.v0[i];
                if r != q {
                    put(&mut f.rcopy, q, r + 1);
                    put(&mut f.rcopyv, q, f.rver[r]);
                }
            }
            if o.k0[i] == 2 {
                n := o.v0[i] / 8;
                if f.bad[n] == 0 {
                    put(&mut f.rslot, q, n + 1);
                    put(&mut f.rslotv, q, f.sver[n]);
                    if !facts_valid(&f, n) {
                        fresh_facts(&mut f, n);
                    }
                    put(&mut f.sreg, n, q + 1);
                    put(&mut f.sregv, n, f.rver[q]);
                }
            }
            if loaded != 0 {
                n := loaded - 1;
                if o.k0[i] != 2 {
                    put(&mut f.rslot, q, n + 1);
                    put(&mut f.rslotv, q, f.sver[n]);
                }
            }
        }
        if is_jump(op2) && op2 != 15 {
            exchange(&mut f.epoch, f.epoch + 1);
        }
        if op2 == 29 || op2 == 30 {
            exchange(&mut f.epoch, f.epoch + 1);
        }
        i += 1;
    }
}
// Registers a result is read from: %rax, plus %rdx when the function returns a two-word value.
fn result_live<a>(o: (&a O)) -> u64 {
    if o.ret2 != 0 {
        return 5;
    }
    return 1;
}
fn count_reads<a, c>(o: (&a O), f: (&c mut F), first: u64, last: u64) {
    for n in f.reads.len() {
        put(&mut f.reads, n, 0);
    }
    for i in last - first {
        j := first + i;
        if o.del[j] == 0 {
            if slot_read(&o, j, 0) {
                n := o.v0[j] / 8;
                put(&mut f.reads, n, f.reads[n] + 1);
            }
            if slot_read(&o, j, 1) {
                n := o.v1[j] / 8;
                put(&mut f.reads, n, f.reads[n] + 1);
            }
        }
    }
}
fn dead_stores<a, c>(o: (&a mut O), f: (&c mut F), first: u64, last: u64) {
    count_reads(&o, &mut f, first, last);
    for i in last - first {
        j := first + i;
        if (o.del[j] == 0) & (o.op[j] == 1) & (o.k1[j] == 2) {
            n := o.v1[j] / 8;
            if (f.bad[n] == 0) & (f.reads[n] == 0) {
                kill(&mut o, j);
            }
        }
    }
}
// Function-wide backward liveness over the label graph (iterated to a fixed point); unknown
// jump targets and unrecognized instructions make every register live.
fn live_pass<a, c>(o: (&a mut O), lin: (&c mut u64[]), remove: u64) -> u64 {
    last := o.op.len();
    mut live = 0;
    mut i = last;
    mut changed = 0;
    while 0 < i {
        i -= 1;
        if (o.del[i] == 0) & (o.tr[i] == 0) {
            op := o.op[i];
            if op == 100 {
                if lin[i] != live {
                    put(&mut lin, i, live);
                    changed = 1;
                }
            } else {
                if (op != 101) & (op != 102) {
                    if op == 16 || (16 < op && op < 25) {
                        t := jump_target(&o, i);
                        mut there = all_regs();
                        if t < last {
                            there = lin[t];
                        }
                        if op == 16 {
                            live = there;
                        } else {
                            live = live | there;
                        }
                    } else {
                        if op == 29 || op == 30 {
                            live = result_live(&o);
                        } else {
                            if op == 0 {
                                live = all_regs();
                            } else {
                                mut removable = 0;
                                if remove != 0 && movelike(op) && o.k1[i] == 1 {
                                    q := o.v1[i];
                                    if ((live >> q) & 1) == 0 && q != 4 && q != 5 {
                                        removable = 1;
                                    }
                                    if (op == 1) & (o.k0[i] == 1) & (o.v0[i] == q) {
                                        removable = 1;
                                    }
                                }
                                if removable != 0 {
                                    kill(&mut o, i);
                                } else {
                                    live = (live & (all_regs() - writes(&o, i)))
                                        | reads(&o, i);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return changed;
}
fn dead_defs<a, b>(o: (&a mut O), s: &b [u8], first: u64, last: u64) {
    mut lin = u64[];
    for i in last {
        lin.push(0);
    }
    mut rounds = 0;
    while rounds < 50 {
        rounds += 1;
        if live_pass(&mut o, &mut lin, 0) == 0 {
            break;
        }
    }
    if rounds < 50 {
        live_pass(&mut o, &mut lin, 1);
    }
}
fn next_live<a>(o: (&a O), i: u64, last: u64) -> u64 {
    mut j = i + 1;
    while j < last {
        if (o.del[j] == 0) & (o.op[j] != 101) & (o.op[j] != 102) {
            return j;
        }
        j += 1;
    }
    return last;
}
fn next_insn<a>(o: (&a O), i: u64, last: u64) -> u64 {
    mut j = next_live(&o, i, last);
    while j < last {
        if o.op[j] != 100 {
            return j;
        }
        j = next_live(&o, j, last);
    }
    return last;
}
// Whether register r is dead after instruction i: followed forward through jumps (bounded).
fn dead_after<a>(o: (&a O), i: u64, r: u64, budget: u64) -> bool {
    last := o.op.len();
    if budget == 0 {
        return false;
    }
    mut j = i;
    mut steps = 0;
    while steps < 40 {
        steps += 1;
        j = next_insn(&o, j, last);
        if j >= last {
            return false;
        }
        op := o.op[j];
        rd := reads(&o, j);
        if ((rd >> r) & 1) != 0 {
            return false;
        }
        if op == 0 {
            return false;
        }
        wr := writes(&o, j);
        if ((wr >> r) & 1) != 0 {
            return true;
        }
        if is_jump(op) && op != 15 {
            t := jump_target(&o, j);
            if t >= last {
                return false;
            }
            if op == 16 {
                j = t;
            } else {
                if !dead_after(&o, t, r, budget - 1) {
                    return false;
                }
            }
        }
        if op == 29 || op == 30 {
            return false;
        }
    }
    return false;
}
fn jump_target<a>(o: (&a O), j: u64) -> u64 {
    last := o.op.len();
    if o.k0[j] != 4 || o.v0[j] == 0 {
        return last;
    }
    n := o.v0[j] - 1;
    base := o.base;
    if o.m0[j] != 0 {
        return last;
    }
    if n < base {
        return last;
    }
    if n - base >= o.table.len() {
        return last;
    }
    t := o.table[n - base];
    if t == 0 {
        return last;
    }
    return t - 1;
}
fn gen_number<a>(o: (&a mut O), n: u64) -> u64 {
    start := o.gen.len();
    if 9 < n {
        gen_number(&mut o, n / 10);
    }
    o.gen.push(48 + n % 10);
    return start;
}
fn gen_imm<a>(o: (&a mut O), n: u64, i: u64, j: u64) {
    start := o.gen.len();
    o.gen.push(36);
    gen_number(&mut o, n);
    end := o.gen.len();
    set_operand(&mut o, i, j, 5, 0);
    set_range(&mut o, i, j, start, end);
}
fn imm_value<a, b>(o: (&a O), s: &b [u8], i: u64) -> u64 {
    // Decimal immediate of operand 0 (+1), or 0.
    if o.k0[i] != 3 {
        return 0;
    }
    a := o.s0[i] + 1;
    e := o.e0[i];
    if e <= a || e - a > 18 {
        return 0;
    }
    mut n = 0;
    for k in e - a {
        d := s[a + k];
        if d < 48 || 57 < d {
            return 0;
        }
        n = n * 10 + d - 48;
    }
    return n + 1;
}
fn peephole<a, b>(o: (&a mut O), s: &b [u8], first: u64, last: u64) {
    mut i = first;
    while i < last {
        if o.del[i] != 0 {
            i += 1;
            continue;
        }
        op := o.op[i];
        // setCC %al; movzbq %al,%rax; [xorq $1,%rax]; testq %rax,%rax; jz/jnz L  ->  jCC L
        if op == 25 || op == 26 || op == 27 {
            a := next_live(&o, i, last);
            if a < last {
                if (o.op[a] == 28) & (o.k1[a] == 1) & (o.v1[a] == 0) {
                    mut b = next_live(&o, a, last);
                    mut invert = 0;
                    if b < last {
                        if (o.op[b] == 10)
                            & (o.k1[b] == 1)
                            & (o.v1[b] == 0)
                            & (imm_value(&o, view(s), b) == 2) {
                            invert = 1;
                            b = next_live(&o, b, last);
                        }
                    }
                    if b < last {
                        if (o.op[b] == 7)
                            & (o.k0[b] == 1)
                            & (o.v0[b] == 0)
                            & (o.k1[b] == 1)
                            & (o.v1[b] == 0) {
                            c := next_live(&o, b, last);
                            if c < last {
                                jop := o.op[c];
                                if jop == 17 || jop == 18 || jop == 19 || jop == 20 {
                                    t := jump_target(&o, c);
                                    if t < last {
                                        if dead_after(&o, c, 0, 3)
                                            & dead_after(&o, t, 0, 3) {
                                            // jump when the value is non-zero (jnz/jne) or zero (jz/je)
                                            mut when = jop == 19 || jop == 20;
                                            if invert != 0 {
                                                when = !when;
                                            }
                                            mut nj = 0;
                                            if op == 25 {
                                                if when {
                                                    nj = 17;
                                                } else {
                                                    nj = 19;
                                                }
                                            }
                                            if op == 26 {
                                                if when {
                                                    nj = 19;
                                                } else {
                                                    nj = 17;
                                                }
                                            }
                                            if op == 27 {
                                                if when {
                                                    nj = 23;
                                                } else {
                                                    nj = 22;
                                                }
                                            }
                                            put(&mut o.op, c, nj);
                                            put(&mut o.chg, c, 1);
                                            kill(&mut o, i);
                                            kill(&mut o, a);
                                            kill(&mut o, b);
                                            if invert != 0 {
                                                mut x = next_live(&o, a, last);
                                                if x < c {
                                                    if o.op[x] == 10 {
                                                        kill(&mut o, x);
