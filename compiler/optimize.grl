            w := imm_writer(&o, view(s), i, 1);
            if w != 0 {
                v := imm_value(&o, view(s), w - 1);
                if (v != 0) && (v - 1 < 64) {
                    set_operand(&mut o, i, 0, 3, v - 1);
                    set_range(&mut o, i, 0, o.s0[w - 1], o.e0[w - 1]);
                }
            }
            continue;
        }
        if (op != 6) || (o.k0[i] != 3) || (o.k1[i] != 1) {
            continue;
        }
        j := next_live(&o, i, last);
        if (j >= last) || !((16 < o.op[j]) && (o.op[j] < 25)) || (o.k0[j] != 4) {
            continue;
        }
        w := imm_writer(&o, view(s), i, o.v1[i]);
        b := imm_value(&o, view(s), i);
        if (w == 0) || (b == 0) {
            continue;
        }
        av := imm_value(&o, view(s), w - 1) - 1;
        bv := b - 1;
        t := jump_target(&o, j);
        f := next_live(&o, j, last);
        if (t >= last) || (f >= last) || reads_flags(&o, t, last) || reads_flags(&o, f, last) {
            continue;
        }
        jop := o.op[j];
        mut taken = false;
        if (jop == 17) || (jop == 18) {
            taken = av == bv;
        } else if (jop == 19) || (jop == 20) {
            taken = av != bv;
        } else if (jop == 21) || (jop == 22) {
            taken = av >= bv;
        } else {
            taken = av < bv;
        }
        kill(&mut o, i);
