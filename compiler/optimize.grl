// The 90..97 form of an element accessor: 40 rt_slot, 41 rt_at, 44 rt_atb, 49 rt_slot4, 51 rt_at4,
// 47 rt_slotu, 48 rt_atbu, 50 rt_slot4u; 55 rt_write is 89.
fn desc_form(op: u64) -> u64 {
    if op == 55 {
        return 89;
    }
    if op == 40 {
        return 90;
    }
    if op == 41 {
        return 91;
    }
    if op == 44 {
        return 92;
    }
    if op == 49 {
        return 93;
    }
    if op == 51 {
        return 94;
    }
    if op == 47 {
        return 95;
    }
    if op == 48 {
        return 96;
    }
    return 97;
}
