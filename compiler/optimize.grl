        }
        mut d = 0;
        for i in last {
            d += opens[i];
            d -= closes[i];
            if o.del[i] == 0 {
                mut w = 1;
                mut lv = d;
                if 4 < lv {
                    lv = 4;
                }
                while 0 < lv {
                    w = w * 4;
                    lv -= 1;
                }
                for j in 2 {
                    mut k = o.k0[i];
                    mut v = o.v0[i];
                    if j != 0 {
                        k = o.k1[i];
                        v = o.v1[i];
                    }
                    if k == 2 {
