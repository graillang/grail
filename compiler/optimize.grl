fn app_gen<a, b>(o: (&a mut ir::Body), t: &b [u8]) {
    for x in t.len() {
        o.gen.push(t[x]);
    }
}
// A general register's name (without %) into the generated text.
fn gen_reg<a>(o: (&a mut ir::Body), r: u64) {
