    if k == 1903193968 {
        return 32;
    }
    if k == 1902930035 {
        return 33;
    }
    if k == 1903323251 {
        return 34;
    }
    return 0;
}
fn opname<a>(o: (&mut a O), op: u64) {
    mut t = "";
    if op == 1 {
        t = "movq";
    }
    if op == 2 {
        t = "movabsq";
    }
    if op == 3 {
        t = "leaq";
    }
    if op == 4 {
        t = "addq";
    }
    if op == 5 {
        t = "subq";
    }
    if op == 6 {
        t = "cmpq";
    }
    if op == 7 {
        t = "testq";
    }
    if op == 8 {
        t = "andq";
    }
    if op == 9 {
        t = "orq";
    }
    if op == 10 {
        t = "xorq";
    }
    if op == 11 {
        t = "incq";
    }
    if op == 12 {
        t = "mulq";
    }
    if op == 13 {
        t = "divq";
    }
    if op == 14 {
        t = "imulq";
    }
    if op == 15 {
        t = "call";
    }
    if op == 16 {
        t = "jmp";
    }
    if op == 17 {
        t = "je";
    }
    if op == 18 {
        t = "jz";
    }
    if op == 19 {
        t = "jne";
    }
    if op == 20 {
        t = "jnz";
    }
    if op == 21 {
        t = "jnc";
    }
    if op == 22 {
        t = "jae";
    }
    if op == 23 {
        t = "jb";
    }
    if op == 24 {
        t = "jc";
    }
    if op == 25 {
        t = "sete";
    }
    if op == 26 {
        t = "setne";
    }
    if op == 27 {
        t = "setb";
    }
    if op == 28 {
        t = "movzbq";
    }
    if op == 29 {
        t = "leave";
    }
    if op == 30 {
        t = "ret";
    }
    if op == 31 {
        t = "pushq";
    }
    if op == 32 {
        t = "popq";
    }
    if op == 33 {
        t = "shlq";
    }
    if op == 34 {
        t = "shrq";
    }
    assert(t.len() != 0);
    app(borrow_mut(o.out), &t);
}
// 0..15 for 64-bit names, 16+n for a narrower spelling of register n, 99 otherwise.
fn reg_key(k: u64) -> u64 {
    if k == 7889266 {
        return 0;
    }
    if k == 7889778 {
        return 1;
    }
    if k == 7890034 {
        return 2;
    }
    if k == 7889522 {
        return 3;
    }
    if k == 7369586 {
        return 4;
    }
    if k == 7365234 {
        return 5;
    }
    if k == 6910834 {
        return 6;
    }
    if k == 6906994 {
        return 7;
    }
    if k == 14450 {
        return 8;
    }
    if k == 14706 {
        return 9;
    }
    if k == 3158386 {
        return 10;
    }
    if k == 3223922 {
        return 11;
    }
    if k == 3289458 {
        return 12;
    }
    if k == 3354994 {
        return 13;
    }
    if k == 3420530 {
        return 14;
    }
    if k == 3486066 {
        return 15;
    }
    if k == 7889253 {
        return 16;
    }
    if k == 27745 {
        return 16;
    }
    if k == 7889765 {
        return 17;
    }
    if k == 27747 {
        return 17;
    }
    if k == 7890021 {
        return 18;
    }
    if k == 27748 {
        return 18;
    }
    if k == 7889509 {
        return 19;
    }
    if k == 27746 {
        return 19;
    }
    if k == 7369573 {
        return 20;
    }
    if k == 7365221 {
        return 21;
    }
    if k == 6910821 {
