}
// Slot use permitted after promotion: the instruction stays valid with a register operand.
fn promotable_use<a>(o: (&a O), i: u64) -> bool {
    op := o.op[i];
    if op == 1
        || op == 4
        || op == 5
        || op == 6
        || op == 7
        || op == 8
        || op == 9
        || op == 10
        || op == 14 {
        mut other = o.k1[i];
        if o.k1[i] == 2 {
            other = o.k0[i];
        }
        return (other == 0) || (other == 1) || (other == 3) || (other == 5);
    }
    return (op == 11) || (op == 12) || (op == 13);
}
fn emit_operand<a, b>(o: (&a mut O), s: &b [u8], i: u64, j: u64) {
    mut k = o.k0[i];
    mut v = o.v0[i];
    mut a = o.s0[i];
    mut e = o.e0[i];
    if j != 0 {
        k = o.k1[i];
        v = o.v1[i];
        a = o.s1[i];
        e = o.e1[i];
    }
    if k == 1 {
        o.out.push(37);
        reg_name(&mut o, v);
        return ();
    }
    if k == 2 {
        o.out.push(45);
        out_number(&mut o, v);
        app(&mut o.out, view("(%rbp)"));
        return ();
    }
    if k == 5 {
        for x in e - a {
            c := o.gen[a + x];
            o.out.push(c);
        }
        return ();
    }
    for x in e - a {
        o.out.push(s[a + x]);
    }
}
fn reg_name<a>(o: (&a mut O), r: u64) {
    mut t = "";
    if r == 0 {
        t = "rax";
    }
    if r == 1 {
        t = "rcx";
    }
    if r == 2 {
        t = "rdx";
    }
    if r == 3 {
        t = "rbx";
    }
    if r == 4 {
        t = "rsp";
    }
    if r == 5 {
        t = "rbp";
    }
    if r == 6 {
        t = "rsi";
    }
    if r == 7 {
        t = "rdi";
    }
    if r == 8 {
        t = "r8";
    }
    if r == 9 {
        t = "r9";
    }
    if r == 10 {
        t = "r10";
    }
    if r == 11 {
        t = "r11";
    }
    if r == 12 {
        t = "r12";
    }
    if r == 13 {
        t = "r13";
    }
    if r == 14 {
        t = "r14";
    }
    if r == 15 {
        t = "r15";
    }
    app(&mut o.out, view(t));
}
fn out_number<a>(o: (&a mut O), n: u64) {
    if 9 < n {
        out_number(&mut o, n / 10);
    }
    o.out.push(48 + n % 10);
}
fn emit_line<a, b>(o: (&a mut O), s: &b [u8], i: u64) {
    op := o.op[i];
    if op == 102 {
        return ();
    }
    if op == 40 || op == 41 || op == 44 {
        n := uniq_take(&mut o);
        app(&mut o.out, view("cmpq 8(%rdi),%rsi\njb .L"));
        opt_label(&mut o);
        out_number(&mut o, n);
        app(&mut o.out, view("\ncall rt_abort\n.L"));
        opt_label(&mut o);
        out_number(&mut o, n);
        if op == 40 {
            app(&mut o.out, view(":\nmovq (%rdi),%rax\nleaq (%rax,%rsi,8),%rax\n"));
        } else {
            if op == 41 {
                app(&mut o.out, view(":\nmovq (%rdi),%rax\nmovq (%rax,%rsi,8),%rax\n"));
            } else {
                app(&mut o.out, view(":\nmovq (%rdi),%rax\nmovzbq (%rax,%rsi,1),%rax\n"));
            }
        }
        return ();
    }
    if op == 42 {
        app(&mut o.out, view("movq 8(%rdi),%rax\n"));
        return ();
    }
    if op == 47 {
        app(&mut o.out, view("movq (%rdi),%rax\nleaq (%rax,%rsi,8),%rax\n"));
        return ();
    }
    if op == 48 {
        app(&mut o.out, view("movq (%rdi),%rax\nmovzbq (%rax,%rsi,1),%rax\n"));
        return ();
    }
    if op == 45 || op == 46 {
        fast := uniq_take(&mut o);
        done := uniq_take(&mut o);
        app(&mut o.out, view("movq 8(%rdi),%rcx\ncmpq 16(%rdi),%rcx\njb .L"));
        opt_label(&mut o);
        out_number(&mut o, fast);
        if op == 45 {
            app(&mut o.out, view("\ncall rt_push\njmp .L"));
        } else {
            app(&mut o.out, view("\ncall rt_pushb\njmp .L"));
        }
        opt_label(&mut o);
        out_number(&mut o, done);
        app(&mut o.out, view("\n.L"));
        opt_label(&mut o);
        out_number(&mut o, fast);
        if op == 45 {
            app(
                &mut o.out,
                view(":\nmovq (%rdi),%rdx\nmovq %rsi,(%rdx,%rcx,8)\nincq %rcx\nmovq %rcx,8(%rdi)\n")
            );
        } else {
            app(
                &mut o.out,
                view(":\nleaq 1(%rcx),%rdx\nmovq %rdx,8(%rdi)\naddq (%rdi),%rcx\nmovq %rsi,%rax\nmovb %al,(%rcx)\n")
            );
        }
        app(&mut o.out, view("movq $0,%rax\n.L"));
        opt_label(&mut o);
        out_number(&mut o, done);
        app(&mut o.out, view(":\n"));
        return ();
    }
    if op == 43 {
        app(&mut o.out, view("movq (%rdi),%rax\nmovq %rsi,(%rdi)\n"));
        return ();
    }
    if o.chg[i] == 0 {
        for x in o.le[i] - o.ls[i] {
            o.out.push(s[o.ls[i] + x]);
        }
        o.out.push(10);
        return ();
    }
    opname(&mut o, o.op[i]);
    if o.k0[i] != 0 {
        o.out.push(32);
        emit_operand(&mut o, view(s), i, 0);
        if o.k1[i] != 0 {
            o.out.push(44);
            emit_operand(&mut o, view(s), i, 1);
        }
    }
    o.out.push(10);
}
// `opt<unit prefix>_`: the namespace of the optimizer's own expansion labels, so a unit's `.Lopt`
// numbers do not depend on the expansions the units before it emitted.
fn opt_label<a>(o: (&a mut O)) {
    app(&mut o.out, view("opt"));
    prefix := o.uprefix.copy();
    app(&mut o.out, view(prefix));
    o.out.push(95);
}
fn emit_frame_slot<a, b>(o: (&a mut O), s: &b [u8], p: u64, k: u64) {
    // -.FN-8(k+1)(%rbp), where .FN is the frame constant named by the prologue subq.
    app(&mut o.out, view("-"));
    for x in o.e0[p] - o.s0[p] - 1 {
        o.out.push(s[o.s0[p] + 1 + x]);
    }
    app(&mut o.out, view("-"));
    out_number(&mut o, 8 * (k + 1));
    app(&mut o.out, view("(%rbp)"));
}
// Turn the declared pairs into slot widths: 0 scalar, 1 first word, 2 second word. A pair whose
// second word would not be a frame slot cannot be modelled, so the function is copied unchanged
// rather than mis-lowered.
fn build_pairs<a>(o: (&a mut O), ns: u64) {
    exchange(&mut o.pair, u64[]);
    if o.pairs.len() == 0 {
        return ();
    }
    for i in ns {
        o.pair.push(0);
    }
    for i in o.pairs.len() {
        n := o.pairs[i];
        if (0 < n) & (n < ns) {
            put(&mut o.pair, n, 1);
            put(&mut o.pair, n - 1, 2);
        } else {
            exchange(&mut o.weird, 1);
        }
    }
}
fn function<a, b>(o: (&a mut O), s: &b [u8]) {
