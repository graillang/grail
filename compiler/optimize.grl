                // A line touching neither %rax nor %A (a constant loaded for the next operation).
                j = next_live(&o, j, last);
                continue;
            }
            if !ir::arith(op) || (o.k1[j] != 1) || (o.v1[j] != 0) {
                ok = false;
                break;
            }
            if (o.k0[j] == 1) && (o.v0[j] == a) {
                ok = false;
                break;
            }
            if ((o.k0[j] == 4) || (o.k0[j] == 6)) && ((((ir::reads(&o, j) >> a) & 1) != 0) || ((ir::reads(&o, j) & 1) != 0 && (o.k0[j] != 1))) {
                // A memory or unparsed source naming %rax or %A: not this shape.
                ok = false;
                break;
            }
            n += 1;
            j = next_live(&o, j, last);
        }
        if !ok || (n == 0) || (j >= last) || (o.op[j] != 1) || (o.v1[j] != a) {
            continue;
        }
        if !dead_after(&o, j, 0, 6) {
            continue;
        }
        mut x = next_live(&o, i, last);
