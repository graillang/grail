// Two-address SSE arithmetic (dev-gap item 2). The front end computes every float operation in the
// scratch pair - `movaps %xmmA,%xmm0; movaps %xmmB,%xmm1; OPsd %xmm1,%xmm0; movaps %xmm0,%xmmD` -
// and once A, B and D are promoted registers the scratch is only a way between them. With the four
// lines consecutive and the scratch dead after them it is `OPsd %xmmB,%xmmD` when D is A, the
// operands swapped when D is B and the operation commutes, else `movaps %xmmA,%xmmD; OPsd
// %xmmB,%xmmD`. sqrt (one operand) is `sqrtsd %xmmA,%xmmD`.
fn xmm_fold<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64) {
    for i in last {
        if o.del[i] != 0 {
            continue;
        }
        op := o.op[i];
        binary := ((59 < op) && (op < 64)) || ((71 < op) && (op < 76));
        sqrt := (op == 64) || (op == 76);
        if !(binary || sqrt) || (o.k1[i] != 6) {
            continue;
        }
        // Binary: the source scratch is copied from a promoted register on the line before, and the
        // destination scratch on the line before that. sqrt: the destination copy just before.
        mut l1 = i;
        mut l2 = last;
        mut y = 99;
        if binary {
            if (o.k0[i] != 6) || xmm_is(&o, view(s), i, 0, o.s1[i], o.e1[i]) {
                continue;
            }
            p := prev_live(&o, i);
            if (p >= i) || (o.op[p] != 68) || (o.k0[p] != 7) || !xmm_is(&o, view(s), p, 1, o.s0[i], o.e0[i]) {
                continue;
            }
            l2 = p;
            y = o.v0[p];
            l1 = prev_live(&o, p);
            if l1 >= p {
                continue;
            }
        } else {
            if !xmm_is(&o, view(s), i, 0, o.s1[i], o.e1[i]) {
                continue;
            }
            l1 = prev_live(&o, i);
            if l1 >= i {
                continue;
            }
        }
        if (o.op[l1] != 68) || (o.k0[l1] != 7) || !xmm_is(&o, view(s), l1, 1, o.s1[i], o.e1[i]) {
            continue;
        }
        x := o.v0[l1];
        // The line after copies the result into a promoted register, and the scratch is dead.
        l4 := next_live(&o, i, last);
        if (l4 >= last) || (o.op[l4] != 68) || (o.k1[l4] != 7) || !xmm_is(&o, view(s), l4, 0, o.s1[i], o.e1[i]) {
            continue;
        }
        d := o.v1[l4];
        if !xmm_dead_after(&o, view(s), l4, xmm_no(&o, view(s), i, 1), 3) {
            continue;
        }
        if binary && !xmm_dead_after(&o, view(s), l4, xmm_no(&o, view(s), i, 0), 3) {
            continue;
        }
        commutes := (op == 60) || (op == 62) || (op == 72) || (op == 74);
        if sqrt {
            set_operand(&mut o, i, 0, 7, x);
            set_operand(&mut o, i, 1, 7, d);
            kill(&mut o, l1);
            kill(&mut o, l4);
            continue;
        }
        if d == x {
            set_operand(&mut o, i, 0, 7, y);
            set_operand(&mut o, i, 1, 7, d);
            kill(&mut o, l1);
            kill(&mut o, l2);
            kill(&mut o, l4);
        } else if (d == y) && commutes {
            set_operand(&mut o, i, 0, 7, x);
            set_operand(&mut o, i, 1, 7, d);
            kill(&mut o, l1);
            kill(&mut o, l2);
            kill(&mut o, l4);
        } else if d != y {
            // movaps %xmmX,%xmmD in place of the first scratch copy.
            set_operand(&mut o, l1, 1, 7, d);
            set_operand(&mut o, i, 0, 7, y);
            set_operand(&mut o, i, 1, 7, d);
            kill(&mut o, l2);
            kill(&mut o, l4);
