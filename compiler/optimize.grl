        app_gen(&mut o, view("rax"));
    }
    if r == 1 {
        app_gen(&mut o, view("rcx"));
    }
    if r == 2 {
        app_gen(&mut o, view("rdx"));
    }
    if r == 3 {
        app_gen(&mut o, view("rbx"));
    }
    if r == 4 {
        app_gen(&mut o, view("rsp"));
    }
    if r == 5 {
        app_gen(&mut o, view("rbp"));
    }
    if r == 6 {
        app_gen(&mut o, view("rsi"));
    }
    if r == 7 {
        app_gen(&mut o, view("rdi"));
    }
    if r == 8 {
        app_gen(&mut o, view("r8"));
    }
    if r == 9 {
        app_gen(&mut o, view("r9"));
    }
    if r == 10 {
        app_gen(&mut o, view("r10"));
    }
    if r == 11 {
        app_gen(&mut o, view("r11"));
    }
    if r == 12 {
        app_gen(&mut o, view("r12"));
    }
    if r == 13 {
        app_gen(&mut o, view("r13"));
    }
    if r == 14 {
        app_gen(&mut o, view("r14"));
    }
    if r == 15 {
        app_gen(&mut o, view("r15"));
