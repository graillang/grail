module optimize;

// Word-stream optimizer: runs on the x86-64-spelled stream before target lowering, so every CPU
// benefits. Per function it (1) forwards frame-slot values already held in a register or known
// constant within a basic block, (2) deletes stores to slots that are never read and register
// definitions that are never used, (3) promotes the hottest non-escaping slots into callee-saved
// registers (weighted by loop depth), and (4) fuses set/test/branch sequences and turns division
// by a power-of-two constant into shift/mask. Unrecognized functions are copied unchanged.
// Kinds: 0 none, 1 register, 2 frame slot -N(%rbp), 3 immediate/other text, 4 other operand,
// 5 generated text (range in O.gen). Ops: see opcode(); 100 label, 101 directive, 102 two-word
// slot declaration, 0 unknown.
//
// A slot is one word unless a `.gpair -N(%rbp)` line declares it the first word of a two-word
// value (native.grl emits one where a borrowed interface object's {data, vtable} pair is built), and
// a result is one word unless `.gpair ret` declares it the two-word %rax:%rdx form.
// The two words are one value with one identity: allocated together, written directly, addressed
// from the first word, kept adjacent when the frame is compacted, and never promoted, forwarded or
// dropped - the second word's only reader is the pair's address, which no pass reasons about. Every
// pass that looks at a slot obeys `pair[n]`, so width 1 and width 2 are handled uniformly and a
// pass that cannot reason about the second word is conservative for both.
struct O {
    ls: u64[],
    le: u64[],
    op: u64[],
    chg: u64[],
    del: u64[],
    lab: u64[],
    tr: u64[],
    k0: u64[],
    v0: u64[],
    s0: u64[],
    e0: u64[],
    m0: u64[],
    k1: u64[],
    v1: u64[],
    s1: u64[],
    e1: u64[],
    m1: u64[],
    gen: u8[],
    out: u8[],
    weird: u64,
    maxslot: u64,
    table: u64[],
    base: u64,
    data: u64,
    uniq: u64,
    zline: u64,
    zfrom: u64,
    zto: u64,
    pairs: u64[],
    pair: u64[],
    ret2: u64,
    inl_names: u8[][],
    inl_bodies: u8[][],
    inl_units: u8[][],
    inl_head: u64[],
    inl_next: u64[],
    // The emission unit the stream is inside: its name and its label prefix, both from the
    // `.grail_part` marker `native.grl` writes. A label is numbered only when it is this unit's.
    unit: u8[],
    uprefix: u8[],
    // 1 when the stream carried any marker, so a single-file build knows to strip them.
    marked: u64,
    // The expansion-label counter of each unit (1-based index into `uniq_units` of the one being
    // emitted, 0 before the first). Per unit and kept across a re-entry, like the emitter's own.
    uniq_index: u64,
    uniq_units: u8[][],
    uniq_next: u64[]
}
fn put<a>(v: (&a mut u64[]), i: u64, x: u64) {
    exchange(&mut v[i], x);
}
fn same<b, d>(s: &b [u8], a: u64, e: u64, w: &d [u8]) -> bool {
    // The range must lie inside `s` as well as be as long as `w`: the callers compare a name
    // against a longer stored name (`same(view(stored), 0, name.len(), name)`), and a longer range
    // than the slice it indexes is a read past the end, not an unequal answer.
    if (a > e) || (e > s.len()) {
        return false;
    }
    if e - a != w.len() {
        return false;
    }
    for i in w.len() {
        if s[a + i] != w[i] {
            return false;
        }
    }
    return true;
}
fn app<a, b>(out: (&a mut u8[]), s: &b [u8]) {
    for i in s.len() {
        out.push(s[i]);
    }
}
fn bit(r: u64) -> u64 {
    return 1 << r;
}
// 0xFFCF: every general register except rsp/rbp; caller-saved; argument registers.
fn all_regs() -> u64 {
    return 65487;
}
fn caller_saved() -> u64 {
    return 4039;
}
// A call reads every register an argument can arrive in: rdi, rsi, rdx, rcx, r8, r9 and - because
// machine.grl maps the seventh and eighth AAPCS64/RV64 argument registers to their x86-64 spelling -
// r10 and r11 too. Without them a store to %r10 before a call looks dead and is deleted.
fn arg_regs() -> u64 {
    return 4038;
}
