    last := o.op.len();
    ns := o.maxslot / 8 + 1;
    mut f = new_facts(ns);
    // Both words of a two-word value are opaque to the value passes: not promoted (bad), not
    // forwarded, and their stores are not dead - the handle names them, not the frame.
    build_pairs(&mut o, ns);
    if o.pairs.len() != 0 {
        for n in ns {
            if o.pair[n] != 0 {
                put(&mut f.bad, n, 1);
            }
        }
    }
    // Frame shape: escaping slots, prologue position, label table and loop depth.
    mut prologue = 0;
    mut regs_used = 0;
    mut minlab = 0;
    mut maxlab = 0;
    for i in last {
        op := o.op[i];
        regs_used = regs_used
            | mask_of(o.k0[i], o.v0[i], o.m0[i])
            | mask_of(o.k1[i], o.v1[i], o.m1[i]);
        if op == 0 || op == 3 {
            if o.k0[i] == 2 {
                n := o.v0[i];
                put(&mut f.bad, n / 8, 1);
            }
            if o.k1[i] == 2 {
                put(&mut f.bad, o.v1[i] / 8, 1);
            }
        }
        if ((o.m0[i] >> 5) & 1) != 0 {
            if (op == 3) & (o.k0[i] == 4) & same(view(s), o.s0[i], o.s0[i] + 3, view("-.F")) {} else {
                exchange(&mut o.weird, 1);
            }
        }
        if ((o.m1[i] >> 5) & 1) != 0 {
            exchange(&mut o.weird, 1);
        }
        if (op == 5) & (prologue == 0) & (o.k1[i] == 1) & (o.v1[i] == 4) & (i == 4) {
            if same(view(s), o.s0[i], o.s0[i] + 3, view("$.F")) {
                prologue = i;
            }
        }
        if o.lab[i] != 0 {
            n := o.lab[i] - 1;
            if minlab == 0 {
                minlab = n + 1;
            } else {
                if n + 1 < minlab {
                    minlab = n + 1;
                }
            }
            if maxlab < n {
                maxlab = n;
            }
        }
        if op == 30 {
            mut p = i;
            mut prev = 0;
            while 0 < p {
                p -= 1;
                if (o.op[p] != 101) & (o.op[p] != 100) {
                    prev = o.op[p];
                    break;
                }
            }
            if prev != 29 {
                exchange(&mut o.weird, 1);
            }
        }
    }
    if o.weird != 0 {
        for i in last {
            emit_line(&mut o, view(s), i);
        }
        return ();
    }
    o.table.clear();
    mut base = 0;
    if minlab != 0 {
        base = minlab - 1;
    }
    exchange(&mut o.base, base);
    mut refs = u64[];
    if minlab != 0 {
        for x in maxlab - base + 1 {
            o.table.push(0);
            refs.push(0);
        }
        for i in last {
            if o.lab[i] != 0 {
                put(&mut o.table, o.lab[i] - 1 - base, i + 1);
            }
        }
        for i in last {
            for j in 2 {
                mut v = o.v0[i];
                if j != 0 {
                    v = o.v1[i];
                }
                mut k = o.k0[i];
                if j != 0 {
                    k = o.k1[i];
                }
                if (k == 4) & (v != 0) {
                    n := v - 1;
                    if n >= base {
                        if n - base < refs.len() {
