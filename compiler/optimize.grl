            mreg.push(pal[k]);
            ir::put(&mut f.bad, cands[c], 1);
        }
    }
}
// `addq $k,%R; movq (%R),%X` is `movq k(%R),%X` when %R is the destination or dead after: a raw
// field load (`raw_load(p + 16)`, docs/design/decisions "raw address offsets") without the add.
// Loads only - movq, movzbq, movl - whose memory operand is the source.
fn offset_loads<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64) {
    names := u8[][
        copy_text(view("(%rax)")), copy_text(view("(%rcx)")), copy_text(view("(%rdx)")),
        copy_text(view("(%rbx)")), copy_text(view("(%rsp)")), copy_text(view("(%rbp)")),
        copy_text(view("(%rsi)")), copy_text(view("(%rdi)"))
    ];
    for i in last {
        if (o.del[i] != 0) || (o.op[i] != 4) || (o.k0[i] != 3) || (o.k1[i] != 1) || (o.v1[i] > 7) {
            continue;
        }
        r := o.v1[i];
        if (r == 4) || (r == 5) {
            continue;
        }
        k := imm_value(&o, view(s), i);
        if (k == 0) || (k - 1 > 2147483647) {
            continue;
        }
        j := next_live(&o, i, last);
        if j >= last {
            continue;
        }
        op := o.op[j];
        if !((op == 1) || (op == 28) || (op == 98)) || (o.k0[j] != 4) {
            continue;
        }
        if !ir::same_range(view(s), o.s0[j], o.e0[j], view(names[r])) {
            continue;
        }
        overwrites := (o.k1[j] == 1) && (o.v1[j] == r);
        if !overwrites && !dead_after(&o, j, r, 6) {
            continue;
        }
        // The flags of the add are not read: the next line is a load.
        start := o.gen.len();
        gen_number(&mut o, k - 1);
        for x in names[r].len() {
            o.gen.push(names[r][x]);
        }
        end := o.gen.len();
        set_operand(&mut o, j, 0, 5, 0);
        ir::put(&mut o.m0, j, 1 << r);
        set_range(&mut o, j, 0, start, end);
        kill(&mut o, i);
    }
}
// A float loaded through a general register - `movq MEM,%rax; movq %rax,%xmmN` with %rax dead after -
// is `movsd MEM,%xmmN` (dev-gap nbody item 4): an element of an f64 array or vector, or a float
// field, without the round trip.
fn xmm_loads<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64) {
    for j in last {
        if (o.del[j] != 0) || (o.op[j] != 1) || (o.k0[j] != 1) || (o.v0[j] != 0) {
            continue;
        }
        if !((o.k1[j] == 7) || ((o.k1[j] == 6) && is_xmm_text(view(s), o.s1[j], o.e1[j]))) {
            continue;
        }
        p := prev_live(&o, j);
        if (p >= j) || (o.op[p] != 1) || !((o.k0[p] == 4) || (o.k0[p] == 5)) || (o.k1[p] != 1) || (o.v1[p] != 0) {
            continue;
        }
        if ((o.m0[p] & 1) == 0) && (o.k0[p] == 5) {
            // A generated operand is an address only when it names a register.
            if o.m0[p] == 0 {
                continue;
            }
        }
        if !dead_after(&o, j, 0, 6) {
            continue;
        }
        ir::put(&mut o.op, p, 77);
        set_operand(&mut o, p, 1, o.k1[j], o.v1[j]);
        set_range(&mut o, p, 1, o.s1[j], o.e1[j]);
        kill(&mut o, j);
    }
}
// The store side: `movq %xmmN,%rax; movq %rax,MEM` with %rax dead after is `movsd %xmmN,MEM`. It runs
// last, after every pass that reads a memory destination's kind.
fn xmm_stores<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64) {
    for p in last {
        if (o.del[p] != 0) || (o.op[p] != 1) || (o.k1[p] != 1) || (o.v1[p] != 0) {
            continue;
        }
        if !((o.k0[p] == 7) || ((o.k0[p] == 6) && is_xmm_text(view(s), o.s0[p], o.e0[p]))) {
            continue;
        }
        // Up to three plain moves that leave %rax alone may come first (the address loaded into
        // %rcx): `movq %xmm8,%rax; movq -984(%rbp),%rcx; movq %rax,(%rcx)`.
        mut j = next_live(&o, p, last);
        mut steps = 0;
        while (j < last) && (steps < 3) && (o.op[j] == 1) && (o.k1[j] == 1)
            && ((((ir::reads(&o, j) | ir::writes(&o, j)) & 1) == 0)) {
            j = next_live(&o, j, last);
            steps += 1;
        }
        if (j >= last) || (o.op[j] != 1) || (o.k0[j] != 1) || (o.v0[j] != 0) || (o.k1[j] != 4) {
            continue;
        }
        if (o.m1[j] & 1) != 0 {
            // The address uses %rax itself.
            continue;
        }
        if !dead_after(&o, j, 0, 6) {
            continue;
        }
        ir::put(&mut o.op, j, 77);
        set_operand(&mut o, j, 0, o.k0[p], o.v0[p]);
        set_range(&mut o, j, 0, o.s0[p], o.e0[p]);
        kill(&mut o, p);
    }
}
// A float loaded only to be an operand - `movsd MEM,%xmmT; OPsd %xmmT,%xmmD` with %xmmT dead after -
// is `OPsd MEM,%xmmD`: the arithmetic reads memory itself (+ - * /, double precision). T may be a
// scratch or a promoted register (an element loaded into one, then used once).
fn xmm_memops<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64) {
    for p in last {
        if (o.del[p] != 0) || (o.op[p] != 77) || !((o.k0[p] == 4) || (o.k0[p] == 5)) {
            continue;
        }
        t := xmm_no(&o, view(s), p, 1);
        if t == 99 {
            continue;
        }
        j := next_live(&o, p, last);
        if (j >= last) || !((59 < o.op[j]) && (o.op[j] < 64)) {
            continue;
        }
        if (xmm_no(&o, view(s), j, 0) != t) || (xmm_no(&o, view(s), j, 1) == t) {
            continue;
        }
        if !xmm_dead_after(&o, view(s), j, t, 3) {
            continue;
        }
        m0 := o.m0[p];
        set_operand(&mut o, j, 0, o.k0[p], o.v0[p]);
        ir::put(&mut o.m0, j, m0);
        set_range(&mut o, j, 0, o.s0[p], o.e0[p]);
        kill(&mut o, p);
    }
}
fn name_hash<b>(s: &b [u8], a: u64, e: u64) -> u64 {
    mut h = 0;
    for i in e - a {
        h = (h * 31 + s[a + i]) % 4093;
    }
    return h;
}
// A small leaf (no calls but rt_abort, no callee-saved registers, small cleared frame) gets a
// frameless copy of its body: slots move to free scratch registers, returns jump to the end.
// Calls to it are replaced by that body after all functions are optimized.
fn inline_candidate<a, b>(o: (&a mut ir::Body), s: &b [u8], prologue: u64) {
    if o.dyn_pairs.len() != 0 {
        return ();
    }
    last := o.op.len();
    mut count = 0;
    mut used = 0;
    // rbx, rsp, rbp (outside slots) and r12..r15 must not appear.
    forbidden := 8 + 16 + 32 + 4096 + 8192 + 16384 + 32768;
    dead := unreachable_lines(&o, prologue);
    for i in last {
        if (prologue < i) & (o.del[i] == 0) & (dead[i] == 0) {
            op := o.op[i];
            if op == 101 {
                if (i + 1 != last) && !site_directive(&o, view(s), i) {
                    return ();
                }
            } else {
                if op != 100 {
                    // A `leave` is not in the copy (the copy has no frame), so it is not counted.
                    if op != 29 {
                        count += 1;
                    }
                    if 24 < count {
                        return ();
                    }
                    if op == 0 || op == 31 || op == 32 || op == 45 || op == 46 {
                        return ();
                    }
                    // A slot used where a register cannot stand - its address taken (`leaq -8(%rbp)`,
                    // rt_frame) - stays a slot, so the body is not a copy with slots in registers.
                    if ((o.k0[i] == 2) || (o.k1[i] == 2)) && !promotable_use(&o, i) {
                        return ();
                    }
                    if op == 15 {
                        if o.k0[i] != 4 {
                            return ();
                        }
                        if !never_returns(&o, view(s), i) && !tail_call(&o, i, last, &dead) {
                            return ();
                        }
                    }
                    m := ir::mask_of(o.k0[i], o.v0[i], o.m0[i]) | ir::mask_of(o.k1[i], o.v1[i], o.m1[i]);
                    if (m & forbidden) != 0 {
                        return ();
                    }
                    used = used | m;
                }
            }
        }
    }
    // Map every slot in the body to a free caller-saved register.
    free := u64[8, 9, 10, 11, 2, 1, 6, 7];
    mut slots = u64[];
    mut regs = u64[];
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            for j in 2 {
                mut k = o.k0[i];
                mut v = o.v0[i];
                if j != 0 {
                    k = o.k1[i];
                    v = o.v1[i];
                }
                if k == 2 {
                    mut known = 0;
                    for x in slots.len() {
                        if slots[x] == v {
                            known = 1;
                        }
                    }
                    if known == 0 {
                        mut pick = 99;
                        for f in free.len() {
                            r := free[f];
                            mut taken = (used >> r) & 1;
                            for y in regs.len() {
                                if regs[y] == r {
                                    taken = 1;
                                }
                            }
                            if (taken == 0) & (pick == 99) {
                                pick = r;
                            }
                        }
                        if pick == 99 {
                            return ();
                        }
                        slots.push(v);
                        regs.push(pick);
                    }
                }
            }
        }
    }
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            for j in 2 {
                mut k = o.k0[i];
                mut v = o.v0[i];
                if j != 0 {
                    k = o.k1[i];
                    v = o.v1[i];
                }
                if k == 2 {
                    for x in slots.len() {
                        if slots[x] == v {
                            r := regs[x];
                            set_operand(&mut o, i, j, 1, r);
                        }
                    }
                }
            }
        }
    }
    mark := o.out.len();
    // Cleared (non-parameter) slots start at zero, as the frame zeroing guaranteed.
    for x in slots.len() {
        if o.zfrom * 8 < slots[x] + 1 {
            app(&mut o.out, view("movq $0,%"));
            reg_name(&mut o, regs[x]);
            o.out.push(10);
        }
    }
    for i in last {
        if (prologue < i) & (o.del[i] == 0) & (dead[i] == 0) & (i + 1 != last) {
            op := o.op[i];
            if op == 30 {
                app(&mut o.out, view("jmp .Lret\n"));
            } else {
                if op != 29 {
                    emit_line(&mut o, view(s), i);
                }
            }
        }
    }
    app(&mut o.out, view(".Lret:\n"));
    mut body = u8[];
    for x in o.out.len() - mark {
        c := o.out[mark + x];
        body.push(c);
    }
    while mark < o.out.len() {
        o.out.pop()!;
    }
    // Filed under the body's symbol, from its `.type` line: the line after it is a statement's site
    // label (`.Lgs<n>:`) in a build with error locations, not the symbol's own label.
    mut name = o.name.copy();
    if name.len() == 0 {
        na := o.ls[1];
        ne := o.le[1] - 1;
        for x in ne - na {
            name.push(s[na + x]);
        }
    }
    unit := o.unit.copy();
    // Filed with its positions made absolute (the copy will stand in other functions); the copy as
    // written is what one_body remembers, since that one does not depend on where the function is.
    absolute := ir::absolute_positions(view(body), o.gbase);
    exchange(&mut o.inl_rel, body);
    inl_file(&mut o, name, absolute, unit);
}
// A direct call the body returns straight after (`call X`, then `leave; ret`): nothing of the body
// is live across it, so its copy may keep the call - a dispatcher like rt_alloc, which picks one of
// two routines, is inlined as its test and the call it picks. The call is made at the caller's stack
// pointer, which is aligned at a call site, and it clobbers only what the call it replaces did.
fn tail_call<a, b>(o: (&a ir::Body), i: u64, last: u64, dead: (&b u64[])) -> bool {
    mut j = i + 1;
    mut seen = 0;
    while j < last {
        if (o.del[j] == 0) && (dead[j] == 0) {
            op := o.op[j];
            if (op != 100) && (op != 101) {
                if (seen == 0) && (op == 29) {
                    seen = 1;
                } else if (seen == 1) && (op == 30) {
                    return true;
                } else {
                    return false;
                }
            }
        }
        j += 1;
    }
    return false;
}
// The instructions after the prologue no path reaches: those after a `ret`, a `jmp` or a call that
// does not return, up to the next label. A body's fall-off return (`xorq %rax,%rax; leave; ret` after
// its last `return`) is the usual one. They are not part of an inlined copy, so they do not count
// against its size either. 1 marks an unreachable instruction; directives are never marked.
fn unreachable_lines<a>(o: (&a ir::Body), prologue: u64) -> u64[] {
    last := o.op.len();
    mut dead = u64[];
    mut off = false;
    for i in last {
        op := o.op[i];
        if op == 100 {
            off = false;
        }
        if off && (op != 100) && (op != 101) && (o.del[i] == 0) {
            dead.push(1);
        } else {
            dead.push(0);
        }
        if (prologue < i) && (o.del[i] == 0) && ((op == 30) || (op == 16)) {
            off = true;
        }
    }
    return dead;
}
// A statement's position or a failure's kind (`.gpos`, `.gposa`, `.gkind`): the site markers every
// statement carries in a build with error locations. They do not keep a body from being inlined; any
// other directive does. The copy keeps them - its positions made absolute when it is filed - so a
// failure inside it reports the line it was written on, and inline_calls states the caller's
// position again after the copy.
fn site_directive<a, b>(o: (&a ir::Body), s: &b [u8], i: u64) -> bool {
    a := o.ls[i];
    return ir::at(view(s), a, view(".gpos ")) || ir::at(view(s), a, view(".gposa ")) || ir::at(view(s), a, view(".gkind "));
}
// Where the lines the inlining pass reads start, in `text[from..]`: a `call` and a unit marker.
// Offsets are from the start of `text`.
fn lines_of_interest<a, b>(text: &a [u8], from: u64, out: (&b mut u64[])) {
    mut start = from;
    mut i = from;
    n := text.len();
    while i < n {
        if text[i] == 10 {
            a := start;
            start = i + 1;
            if i - a > 5 {
                first := text[a];
                if (first == 99) && ir::at(view(text), a, view("call ")) {
                    out.push(a);
                } else if (first == 46) && (i - a > 12) && ir::at(view(text), a, view(".grail_part ")) {
                    out.push(a);
                }
            }
        }
        i += 1;
    }
}
// The lines of interest in what was written to `o.out` from `from` on, noted in `o.interest`.
fn note_interest<a>(o: (&a mut ir::Body), from: u64) {
    mut noted = exchange(&mut o.interest, u64[]);
    lines_of_interest(view(o.out), from, &mut noted);
    exchange(&mut o.interest, noted);
}
// Replaces `call NAME` lines for inlinable functions by their bodies with per-site labels.
// Inlining rewrites the output, so the `--split` marker offsets recorded on the way through are
// rewritten with it: markers are copied in stream order, and each one takes its new offset here.
fn inline_calls<a, b>(o: (&a mut ir::Body), split: u64, marks: (&a mut u64[]), lines: (&b u64[])) {
    text := exchange(&mut o.out, u8[]);
    mut start = 0;
    // Text is copied in runs: `pend` is where the lines not yet written begin, and they are written
    // in one piece when a line is replaced or dropped, when a marker needs the output's length,
    // and at the end.
    mut pend = 0;
    mut site = 0;
    mut next = 0;
    mut unit = u8[];
    mut uprefix = u8[];
    // The inline-site counter of each unit prefix met so far, and which one is current.
    mut seen = u8[][];
    mut counts = u64[];
    mut cur = 0;
    // The form each body crosses a unit in (crossing), worked out when a call first asks for it.
    mut cross = u8[][];
    mut cross_known = u64[];
    for i in o.inl_names.len() {
        cross.push(u8[]);
        cross_known.push(0);
    }
    // Only the lines that can matter are visited: the calls and the unit markers, whose offsets
    // were noted when the text was made (lines_of_interest). Everything between is copied.
    for at in lines.len() {
        {
            a := lines[at];
            mut e = a;
            while (e < text.len()) && (text[e] != 10) {
                e += 1;
            }
            start = e + 1;
            mut done = 0;
            if (e - a > 5) & (text[a] == 99) {
                if ir::at(view(text), a, view("call ")) {
                    h := name_hash(view(text), a + 5, e);
                    mut k = o.inl_head[h];
                    while k != 0 {
                        n := &o.inl_names[k - 1];
                        // Only a body this unit emits: inlining across a module boundary would make
                        // the caller's text a function of a body its own module never declares, and
                        // a module compiled alone has no other module's bodies anyway.
                        mut here = 1;
                        u := &unit;
                        ul := u.len();
                        if ul != 0 {
                            // `same` is this module's slice-vs-token comparison: whole, so 0..len.
                            if !ir::same_range(view(o.inl_units[k - 1]), 0, ul, view(u)) {
                                here = 0;
                            }
                        }
                        mut copy = here != 0;
                        if !copy && ir::same_range(view(text), a + 5, e, view(n)) {
                            copy = crossing(&o, k - 1, &mut cross, &mut cross_known);
                        }
                        if copy & ir::same_range(view(text), a + 5, e, view(n)) {
                            site += 1;
                            o.out.append(text[pend..a]);
                            pend = start;
                            if here != 0 {
                                emit_body(&mut o, k - 1, site, view(uprefix));
                            } else {
                                emit_text(&mut o, view(cross[k - 1]), site, view(uprefix));
                            }
                            // The caller's code after the copy is the caller's statement again.
                            p := caller_position(view(text), a);
                            if p < a {
                                mut pe = p;
                                while text[pe] != 10 {
                                    pe += 1;
                                }
                                o.out.append(text[p..pe + 1]);
                            }
                            done = 1;
                            break;
                        }
                        k = o.inl_next[k - 1];
                    }
                }
            }
            if done == 0 {
                if (e - a > 12) & (text[a] == 46) & ir::at(view(text), a, view(".grail_part ")) {
                    mut fresh = u8[];
                    mut at = a + 12;
                    while (at < e) & (text[at] != 32) {
                        fresh.push(text[at]);
                        at += 1;
                    }
                    exchange(&mut unit, fresh);
                    mut fresh_prefix = u8[];
                    at += 1;
                    while at < e {
                        fresh_prefix.push(text[at]);
                        at += 1;
                    }
                    // Each unit numbers its own inline sites, so its text does not depend on how
                    // many sites other units expanded; a unit whose text comes in more than one
                    // part (a single-run build emits a module's specialisations in a later part)
                    // goes on from where its last part stopped, or two copies would share a label.
                    mut slot = seen.len();
                    for x in seen.len() {
                        if ir::same_range(view(seen[x]), 0, seen[x].len(), view(fresh_prefix)) {
                            slot = x;
                        }
                    }
                    if cur < seen.len() {
                        ir::put(&mut counts, cur, site);
                    }
                    if slot == seen.len() {
                        seen.push(fresh_prefix.copy());
                        counts.push(0);
                    }
                    cur = slot;
                    site = counts[slot];
                    exchange(&mut uprefix, fresh_prefix);
                    o.out.append(text[pend..a]);
                    pend = a;
                    if split != 0 {
                        if next < marks.len() {
                            exchange(&mut marks[next], o.out.len());
                            next += 1;
                        }
                    } else {
                        // A single-file build keeps no markers: they are the splitter's, and the
                        // units they name exist only for the optimizer's own decisions.
                        pend = start;
                        done = 1;
                    }
                }
            }
        }
    }
    o.out.append(text[pend..text.len()]);
}
// Where the caller's statement marker for the call at `call` starts (the last `.gpos` line of the
// function before it), or `call` when the function has none before it: the lines are read back from
// the call to the function's `.type` line, which a statement is never far from.
fn caller_position<a>(text: &a [u8], call: u64) -> u64 {
    mut e = call;
    while 0 < e {
        // `e` is the start of a line; the line before it ends at e - 1.
        mut b = e - 1;
        while (0 < b) && (text[b - 1] != 10) {
            b -= 1;
        }
        if (text[b] == 46) && (b + 6 < e) && (text[b + 1] == 103) && (text[b + 2] == 112) && (text[b + 3] == 111) && (text[b + 4] == 115) && (text[b + 5] == 32) {
            return b;
        }
        if (text[b] == 46) && (b + 6 < e) && (text[b + 1] == 116) && ir::at(view(text), b, view(".type ")) {
            return call;
        }
        e = b;
    }
    return call;
}
// Cross-module inlining (docs/design/separate-compilation.md, "Inlining across a module boundary").
// The runtime is in every program and every run, so a small runtime body may stand in a call from
// any unit: in a run that emits the runtime the body is in the stream, in a run of another module it
// comes from the runtime's summary file (`runtime.facts`, an INLINE record), and both give the same
// bytes because both are its exported form. Other modules' bodies do not cross yet.
pub struct Shared {
    // In: the bodies a run of another module reads. Out: the runtime bodies a run that emitted them
    // exports.
    names: u8[][],
    bodies: u8[][]
}
pub fn new_shared() -> Shared {
    return Shared { names: u8[][], bodies: u8[][] };
}
fn crossing_unit<a>(unit: &a [u8]) -> bool {
    return ir::same_range(unit, 0, unit.len(), view("runtime")) && (unit.len() == 7);
}
// Whether the body filed at `k` may stand in a call from another unit, and its crossing form in
// `cross[k]` if so.
fn crossing<a>(o: (&a ir::Body), k: u64, cross: (&mut u8[][]), known: (&mut u64[])) -> bool {
    if known[k] == 0 {
        exchange(&mut known[k], 1);
        if crossing_unit(view(o.inl_units[k])) {
            exchange(&mut cross[k], export_form(view(o.inl_bodies[k])));
        }
    }
    return cross[k].len() != 0;
}
// A filed body as it crosses a unit, or nothing when it cannot: its positions (`.gposa`) name a file
// of the run that wrote it, so they go, and a failure inside the copy reports the caller's
// statement; a body that names a local label it does not define (a constant, a string) cannot be
// copied out of its own object. Applying it twice changes nothing.
fn export_form<a>(body: &a [u8]) -> u8[] {
    mut out = u8[];
    mut defined = u8[][];
    mut start = 0;
    n := body.len();
    for i in n {
        if body[i] == 10 {
            a := start;
            start = i + 1;
            if ir::at(view(body), a, view(".gposa ")) || ir::at(view(body), a, view(".gpos ")) {
                continue;
            }
            if (i - a > 3) && (body[a] == 46) && (body[a + 1] == 76) && (body[i - 1] == 58) {
                defined.push(body[a..i - 1].copy());
            }
            out.append(body[a..i + 1]);
        }
    }
    // Every `.L` the body names must be one it defines.
    mut i = 0;
    m := out.len();
    while i + 1 < m {
        if (out[i] == 46) && (out[i + 1] == 76) && ((i == 0) || (!ir::alnum(out[i - 1]) && (out[i - 1] != 95))) {
            mut e = i;
            while (e < m) && (ir::alnum(out[e]) || (out[e] == 95) || (out[e] == 46)) {
                e += 1;
            }
            mut found = false;
            for d in defined.len() {
                dl := defined[d].len();
                if (dl == e - i) && ir::same_range(view(out), i, e, view(defined[d])) {
                    found = true;
                    break;
                }
            }
            if !found {
                return u8[];
            }
            i = e;
        } else {
            i += 1;
        }
    }
    return out;
}
// The bodies this run reads from the runtime's summary, filed as the runtime's. A name this run
// files itself (it emits the runtime) keeps its own.
fn import_bodies<a, b>(o: (&a mut ir::Body), shared: (&b Shared)) {
    own := o.inl_names.len();
    for i in shared.names.len() {
        mut mine = false;
        for k in own {
            if (o.inl_names[k].len() == shared.names[i].len()) && ir::same_range(view(o.inl_names[k]), 0, shared.names[i].len(), view(shared.names[i])) {
                mine = true;
                break;
            }
        }
        if !mine {
            inl_file(&mut o, shared.names[i].copy(), shared.bodies[i].copy(), copy_text(view("runtime")));
        }
    }
}
// The runtime bodies this run filed itself that can cross a unit, in the order it filed them.
fn export_bodies<a, b>(o: (&a ir::Body), own: u64, shared: (&b mut Shared)) {
    shared.names.clear();
    shared.bodies.clear();
    for k in own {
        if crossing_unit(view(o.inl_units[k])) {
            form := export_form(view(o.inl_bodies[k]));
            if form.len() != 0 {
                shared.names.push(o.inl_names[k].copy());
                shared.bodies.push(form);
            }
        }
    }
}
// `_i<unit prefix>_<site>` on every `.L` in the body: the site number disambiguates two copies of
// one body, and the unit prefix keeps a body label without a prefix of its own (`.Lret`) apart from
// the same label minted by another unit of the same file.
fn emit_body<a, b>(o: (&a mut ir::Body), k: u64, site: u64, prefix: &b [u8]) {
    body := o.inl_bodies[k].copy();
    emit_text(&mut o, view(body), site, prefix);
}
fn emit_text<a, b, d>(o: (&a mut ir::Body), body: &d [u8], site: u64, prefix: &b [u8]) {
    mut i = 0;
    n := body.len();
    while i < n {
        c := body[i];
        mut label = 0;
        if (c == 46) & (i + 1 < n) {
            if body[i + 1] == 76 {
                if i == 0 {
                    label = 1;
                } else {
                    p := body[i - 1];
                    if !ir::alnum(p) && p != 95 {
                        label = 1;
                    }
                }
            }
        }
        if label != 0 {
            while i < n {
                d := body[i];
                if !(ir::alnum(d) || d == 95 || d == 46) {
                    break;
                }
                o.out.push(d);
                i += 1;
            }
            app(&mut o.out, view("_i"));
            app(&mut o.out, view(prefix));
            o.out.push(95);
            out_number(&mut o, site);
        } else {
            o.out.push(c);
            i += 1;
        }
    }
}
// Renumber the slots still referenced into a dense frame (parameters keep the top slots), so
// the entry zeroing only clears live storage. Returns the new frame size, or 0 if unchanged.
fn compact<a, b>(o: (&a mut ir::Body), s: &b [u8], prologue: u64, ns: u64) -> u64 {
    if prologue == 0 {
        return 0;
    }
    last := o.op.len();
    // Parameter count from the zeroing count `movq $.FN/8-P,%rcx`.
    mut params = ns;
    for i in last {
        if (o.op[i] == 1) & (o.k0[i] == 3) & (o.k1[i] == 1) & (o.v1[i] == 1) & (params == ns) {
            a := o.s0[i];
            e := o.e0[i];
            if (e - a > 4) & (s[a + 1] == 46) {
                mut j = e;
                while a < j {
                    if s[j - 1] == 45 {
                        break;
                    }
                    j -= 1;
                }
                if a < j {
                    mut n = 0;
                    mut ok = 1;
                    for x in e - j {
                        d := s[j + x];
                        if d < 48 || 57 < d {
                            ok = 0;
                        } else {
                            n = n * 10 + d - 48;
                        }
                    }
                    if ok != 0 {
                        params = n;
                    }
                }
            }
        }
    }
    if params >= ns {
        return 0;
    }
    mut map = u64[];
    for n in ns {
        map.push(0);
    }
    for n in params + 1 {
        ir::put(&mut map, n, 1);
    }
    for i in last {
        if o.del[i] == 0 {
            if o.k0[i] == 2 {
                ir::put(&mut map, o.v0[i] / 8, 1);
            }
            if o.k1[i] == 2 {
                ir::put(&mut map, o.v1[i] / 8, 1);
            }
        }
    }
    // A two-word value keeps both slots whether or not each has a direct reader, and slots are
    // renumbered in ascending order, so its words stay adjacent and in order: word 1 keeps the slot
    // above word 0, where `8(%handle)` finds it.
    if o.pair.len() != 0 {
        for n in ns {
            if o.pair[n] != 0 {
                ir::put(&mut map, n, 1);
            }
        }
    }
    mut used = 0;
    for n in ns {
        if n != 0 {
            if map[n] != 0 {
                used += 1;
                ir::put(&mut map, n, used);
            }
        }
    }
    // A small frame is cleared with direct stores instead of `rep stosq` (leaq/movq/xorl/rep).
    words := (used * 8 + 15) / 16 * 16 / 8;
    exchange(&mut o.zline, 0);
    if words < params + 17 {
        for i in last {
            if (o.op[i] == 3) & (o.k1[i] == 1) & (o.v1[i] == 7) & (o.k0[i] == 4) {
                if ir::at(view(s), o.s0[i], view("-.F")) {
                    a := next_live(&o, i, last);
                    if a < last {
                        b := next_live(&o, a, last);
                        if b < last {
                            d := next_live(&o, b, last);
                            if d < last {
                                if (o.op[a] == 1)
                                    & (o.k1[a] == 1)
                                    & (o.v1[a] == 1)
                                    & (o.op[b] == 0)
                                    & (o.op[d] == 0)
                                    & ir::same_range(view(s), o.ls[d], o.le[d], view("rep stosq"))
                                    & ir::same_range(view(s), o.ls[b], o.le[b], view("xorl %eax,%eax")) {
                                    kill(&mut o, i);
                                    kill(&mut o, a);
                                    kill(&mut o, b);
                                    kill(&mut o, d);
                                    exchange(&mut o.zline, d + 1);
                                    exchange(&mut o.zfrom, params + 1);
                                    exchange(&mut o.zto, words);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    for i in last {
        if o.del[i] == 0 {
            if o.k0[i] == 2 {
                set_operand(&mut o, i, 0, 2, map[o.v0[i] / 8] * 8);
            }
            if o.k1[i] == 2 {
                set_operand(&mut o, i, 1, 2, map[o.v1[i] / 8] * 8);
            }
        }
    }
    return (used * 8 + 15) / 16 * 16;
}
pub fn optimize<b, c, d, m, q, r, t>(s: &b [u8], facts: (&c llvm::Facts), want_ir: u64, ir_text: (&mut u8[]), call_syms: (&mut u8[][]), call_counts: (&mut u64[]), memo_dir: &m [u8], memo_id: &m [u8], starts: (&q u64[]), known: (&r ir::Known), shared: (&t mut Shared)) -> u8[] {
    mut marks = u64[];
    mut names = u8[][];
    return optimize_parts(view(s), 0, &mut marks, &mut names, facts, want_ir, ir_text, call_syms, call_counts, memo_dir, memo_id, starts, known, shared);
}
// `optimize` plus the positions of the `--split` module markers it kept: for each marker line, the
// output offset of the line and the module name it carries. A single-file build passes `split` 0 and
// pays nothing. `native.grl` splits at these offsets, so the stream never has to be scanned again.
// `starts`: where the emitter wrote the lines the cut planning reads (plan_from) - a body's `.type`
// line, a part's marker, a function's `.gbase` - so it does not scan the stream for them. Possibly
// stale (the emitter takes text back on a retry) and in no particular order; empty means scan.
pub fn optimize_parts<b, c, d, e, m, q, r, t>(s: &b [u8], split: u64, marks: (&mut u64[]), names: (&mut u8[][]), facts: (&c llvm::Facts), want_ir: u64, ir_text: (&mut u8[]), call_syms: (&mut u8[][]), call_counts: (&mut u64[]), memo_dir: &m [u8], memo_id: &m [u8], starts: (&q u64[]), known: (&r ir::Known), shared: (&t mut Shared)) -> u8[] {
    // The type facts, indexed by body symbol once: the table is complete before any body is walked.
    ix := ir::index_facts(facts);
    mut o = ir::new_body();
    for i in 4096 {
        o.inl_head.push(0);
    }
    o.memo_dir = memo_dir.copy();
    o.known = known_checked(view(s), known);
    o.memo_id = memo_id.copy();
    // A stream of any size is cut where one function ends and the next begins, and the pieces are
    // optimised by forked copies of this process: every body's work depends only on its own lines
    // and on where it stands in its unit (ir::function_begin), so the pieces put back in order are
    // the text one process would have written. The copies share this process's memory until they
    // write, so nothing is passed to them; what they made comes back through a pipe each.
    // Inside a build's jobserver (compiler/jobs.grl) the pieces are as many as there are tokens
    // free now, plus this process's own; the text is the same whatever the count.
    mut js = jobs::open();
    jobs::phase(view("optimiser-start"));
    pieces := jobs::workers(&mut js, jobs_for(s.len()));
    mut cuts = Cut[];
    if starts.len() != 0 {
        cuts = plan_from(view(s), starts, pieces);
    } else {
        cuts = plan(view(s), pieces);
    }
    jobs::phase(view("optimiser-plan"));
    mut rest = 0;
    mut parallel = false;
    if cuts.len() > 2 {
        parallel = run_forked(&mut o, view(s), &cuts, split, marks, names, facts, &ix, want_ir, ir_text, call_syms, call_counts, &mut js);
    }
    jobs::give_all(&mut js);
    // The lines the inlining pass will read. The workers noted theirs as they went; a single
    // process notes them here.
    mut lines = u64[];
    if parallel {
        rest = cuts[cuts.len() - 1].at;
        lines = exchange(&mut o.table, u64[]);
    } else {
        rest = run_range(&mut o, view(s), 0, s.len(), split, marks, names, facts, &ix, want_ir, ir_text, call_syms, call_counts);
        lines = exchange(&mut o.interest, u64[]);
    }
    tail := o.out.len();
    o.out.append(s[rest..s.len()]);
    lines_of_interest(view(o.out), tail, &mut lines);
    // Either something inlines, or the markers have to be taken out of a single-file build.
    jobs::phase(view("optimiser-workers"));
    own := o.inl_names.len();
    import_bodies(&mut o, &shared);
    if (o.inl_names.len() != 0) || (o.marked != 0) {
        inline_calls(&mut o, split, marks, &lines);
    }
    export_bodies(&o, own, &mut shared);
    jobs::phase(view("optimiser-inline"));
    return exchange(&mut o.out, u8[]);
}
// Where a piece of the stream starts, and what the optimiser knows on arriving there: the unit it is
// in and how many functions each unit has had.
struct Cut {
    at: u64,
    unit: u8[],
    uprefix: u8[],
    marked: u64,
    index: u64,
    units: u8[][],
    counts: u64[],
    plain: u64,
    gbase: u64
}
fn cut_here<a>(p: (&a ir::Body), at: u64) -> Cut {
    mut units = u8[][];
    for i in p.uniq_units.len() {
        units.push(p.uniq_units[i].copy());
    }
    return Cut {
        at: at,
        unit: p.unit.copy(),
        uprefix: p.uprefix.copy(),
        marked: p.marked,
        index: p.uniq_index,
        units: units,
        counts: p.uniq_next.copy(),
        plain: p.uniq_plain,
        gbase: p.gbase
    };
}
// How many pieces: one per worker the machine has, none smaller than a megabyte of assembly (below
// that a copy of the process costs more than it saves). GRAIL_JOBS=1 keeps it to one process.
fn jobs_for(size: u64) -> u64 {
    mut jobs = host::cpus();
    asked := host::env(view("GRAIL_JOBS"));
    if asked.len() != 0 {
        jobs = 0;
        for i in asked.len() {
            if (47 < asked[i]) && (asked[i] < 58) {
                jobs = jobs * 10 + u64(asked[i] - 48);
            }
        }
    }
    if 32 < jobs {
        jobs = 32;
    }
    while (1 < jobs) && (size / jobs < 1048576) {
        jobs -= 1;
    }
    if jobs == 0 {
        jobs = 1;
    }
    return jobs;
}
// Is this line the `.type NAME,@function` that opens a body?
fn opens_body<b>(s: &b [u8], a: u64, e: u64) -> bool {
    if (e - a > 15) & (s[a] == 46) & (s[a + 1] == 116) {
        if ir::at(view(s), a, view(".type ")) {
            return ir::same_range(view(s), e - 9, e, view("@function"));
        }
    }
    return false;
}
// Is this line the one that closes a body?
fn closes_body<b>(s: &b [u8], a: u64, e: u64) -> bool {
    if e - a > 6 {
        return (s[a] == 46) & (s[a + 1] == 115) & (s[a + 5] == 46);
    }
    return false;
}
// The cuts for `jobs` pieces: the start of the stream, then the first line outside any body at or
// past each even share of it, then the end of the last whole line. One pass over the lines, doing
// only what tells a body's first and last line and a unit marker apart.
fn plan<b>(s: &b [u8], jobs: u64) -> Cut[] {
    mut p = ir::new_body();
    mut cuts = Cut[];
    cuts.push(cut_here(&p, 0));
    if jobs < 2 {
        return cuts;
    }
    share := s.len() / jobs;
    mut want = share;
    mut start = 0;
    mut inside = false;
    for i in s.len() {
        if s[i] == 10 {
            a := start;
            e := i;
            if !inside {
                if (want <= a) && (cuts.len() < jobs) {
                    cuts.push(cut_here(&p, a));
                    want = a + share;
                }
                if opens_body(view(s), a, e) {
                    ir::function_begin(&mut p);
                    inside = true;
                } else if ir::marker(&mut p, view(s), a, e) == 0 {
                    ir::gbase_line(&mut p, view(s), a, e);
                }
            } else if closes_body(view(s), a, e) {
                inside = false;
            }
            start = i + 1;
        }
    }
    cuts.push(cut_here(&p, start));
    return cuts;
}
// The cuts `plan` makes, from the offsets the emitter noted instead of a scan of the stream: the
// lines that change what a cut carries are a body's opening line (its function ordinal), a part's
// marker and a function's `.gbase`, and every one of them was noted where it was written. Each noted
// offset is checked to be the start of such a line now - a retry takes text back and writes again,
// so a note can be stale or repeated - and they are read in stream order. Cuts are made only at a
// body's opening line, which is outside every body; the output does not depend on where the cuts
// fall (ir::function_begin), only on the state they carry.
fn plan_from<b, q>(s: &b [u8], starts: (&q u64[]), jobs: u64) -> Cut[] {
    mut p = ir::new_body();
    mut cuts = Cut[];
    cuts.push(cut_here(&p, 0));
    if jobs < 2 {
        return cuts;
    }
    // In order, once each: the notes are written in order except where text was taken back.
    mut at = starts.copy();
    mut i = 1;
    while i < at.len() {
        v := at[i];
        mut j = i;
        while (0 < j) && (v < at[j - 1]) {
            at[j] = at[j - 1];
            j -= 1;
        }
        at[j] = v;
        i += 1;
    }
    n := s.len();
    share := n / jobs;
    mut want = share;
    mut last = n + 1;
    for k in at.len() {
        a := at[k];
        if (a == last) || (n <= a) {
            continue;
        }
        last = a;
        if (a != 0) && (s[a - 1] != 10) {
            continue;
        }
        mut e = a;
        while (e < n) && (s[e] != 10) {
            e += 1;
        }
        if e == n {
            continue;
        }
        if opens_body(view(s), a, e) {
            if (want <= a) && (cuts.len() < jobs) {
                cuts.push(cut_here(&p, a));
                want = a + share;
            }
            ir::function_begin(&mut p);
        } else if ir::marker(&mut p, view(s), a, e) == 0 {
            ir::gbase_line(&mut p, view(s), a, e);
        }
    }
    // The end of the last whole line.
    mut end = n;
    while (0 < end) && (s[end - 1] != 10) {
        end -= 1;
    }
    cuts.push(cut_here(&p, end));
    return cuts;
}
// Optimise the whole lines of `s[lo..hi]` into `o.out`. Returns where the last whole line ended.
// The noted bodies (ir::Known) of the stream, each checked to be a whole body where it says: its
// opening line, its closing line, in order and not overlapping. A note that does not check out is
// dropped, and that body is found by the scan like any other.
fn known_checked<b, r>(s: &b [u8], known: (&r ir::Known)) -> ir::Known {
    mut out = ir::no_known();
    mut last = 0;
    for k in known.open.len() {
        a := known.open[k];
        e := known.end[k];
        if (a < last) || (s.len() < e) || (e <= a + 1) || ((a != 0) && (s[a - 1] != 10)) || (s[e - 1] != 10) {
            continue;
        }
        mut ae = a;
        while (ae < e) && (s[ae] != 10) {
            ae += 1;
        }
        // The closing line is the last line before `e`.
        mut ca = e - 1;
        while (a < ca) && (s[ca - 1] != 10) {
            ca -= 1;
        }
        if !opens_body(view(s), a, ae) || !closes_body(view(s), ca, e - 1) {
            continue;
        }
        out.open.push(a);
        out.end.push(e);
        out.key.push(known.key[k].copy());
        last = e;
    }
    return out;
}
fn copy_texts<a>(v: (&a u8[][])) -> u8[][] {
    mut out = u8[][];
    for i in v.len() {
        out.push(v[i].copy());
    }
    return out;
}
// Optimise the whole lines of `s[lo..hi]` into `o.out`. Returns where the last whole line ended.
// The bodies the front end noted (o.known) are taken as they are noted; the text between them -
// part markers, `.gbase` lines, bodies that are not units, data - is scanned line by line.
fn run_range<a, b, c, e, x>(o: (&a mut ir::Body), s: &b [u8], lo: u64, hi: u64, split: u64, marks: (&mut u64[]), names: (&mut u8[][]), facts: (&c llvm::Facts), ix: (&x ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), call_syms: (&mut u8[][]), call_counts: (&mut u64[])) -> u64 {
    mut cursor = lo;
    // The first noted body at or after `lo`.
    mut k = 0;
    mut top = o.known.open.len();
    while k < top {
        mid := (k + top) / 2;
        if o.known.open[mid] < lo {
            k = mid + 1;
        } else {
            top = mid;
        }
    }
    while (k < o.known.open.len()) && (o.known.open[k] < hi) {
        a := o.known.open[k];
        e := o.known.end[k];
        if hi < e {
            break;
        }
        cursor = scan_range(&mut o, view(s), cursor, a, split, marks, names, facts, ix, want_ir, ir_text, call_syms, call_counts);
        mut ae = a;
        while s[ae] != 10 {
            ae += 1;
        }
        o.name = ir::type_symbol(view(s), a, ae);
        ir::function_begin(&mut o);
        key := o.known.key[k].copy();
        one_body(&mut o, view(s), a, e, true, view(key), facts, ix, want_ir, ir_text, call_syms, call_counts);
        cursor = e;
        k += 1;
    }
    return scan_range(&mut o, view(s), cursor, hi, split, marks, names, facts, ix, want_ir, ir_text, call_syms, call_counts);
}
fn scan_range<a, b, c, e, x>(o: (&a mut ir::Body), s: &b [u8], lo: u64, hi: u64, split: u64, marks: (&mut u64[]), names: (&mut u8[][]), facts: (&c llvm::Facts), ix: (&x ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), call_syms: (&mut u8[][]), call_counts: (&mut u64[])) -> u64 {
    mut start = lo;
    mut inside = 0;
    mut opened = lo;
    mut i = lo;
    while i < hi {
        if s[i] == 10 {
            a := start;
            e := i;
            start = i + 1;
            if inside == 0 {
                if opens_body(view(s), a, e) {
                    // The body's symbol, which is the key its type facts are filed under.
                    o.name = ir::type_symbol(view(s), a, e);
                    ir::function_begin(&mut o);
                    inside = 1;
                    opened = a;
                } else {
                    if ir::marker(&mut o, view(s), a, e) != 0 {
                        if split != 0 {
                            marks.push(o.out.len());
                            names.push(o.unit.copy());
                        }
                    } else {
                        ir::gbase_line(&mut o, view(s), a, e);
                    }
                    at := o.out.len();
                    o.out.append(s[a..e + 1]);
                    note_interest(&mut o, at);
                }
            } else if closes_body(view(s), a, e) {
                one_body(&mut o, view(s), opened, start, true, view(""), facts, ix, want_ir, ir_text, call_syms, call_counts);
                inside = 0;
            }
        }
        i += 1;
    }
    if inside != 0 {
        one_body(&mut o, view(s), opened, start, false, view(""), facts, ix, want_ir, ir_text, call_syms, call_counts);
    }
    return start;
}
// One body: the lines of `s[from..to]`, from its `.type` line through the line that closes it.
//
// What the optimiser makes of a body is a function of those lines, of the facts the front end
// recorded about it, and of where it stands in its unit - nothing else. So when the build keeps a
// store (`--fn-cache`), the answer is remembered under a hash of exactly those, and a body whose
// lines have not changed since some earlier build is not parsed or optimised again: its text, its
// inlinable copy, its typed IR and its call count are read back. This is what an edit to one
// function of a large module costs the back end - that function.
fn one_body<a, b, c, e, x, y>(o: (&a mut ir::Body), s: &b [u8], from: u64, to: u64, whole: bool, unit_key: &y [u8], facts: (&c llvm::Facts), ix: (&x ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), call_syms: (&mut u8[][]), call_counts: (&mut u64[])) {
    mut file = u8[];
    // GRAIL_MEMO_VERIFY=1: a memo entry found under a unit's key is not used but kept here, and the
    // body is optimised again and must come out as those bytes.
    mut verified = u8[];
    verify := verify_memo(unit_key);
    if whole && (o.memo_dir.len() != 0) {
        // The key: the compiler, the unit and its label prefix, the body's ordinal in the unit
        // (its labels are numbered from it), its facts, and
        // whether the typed IR is wanted - and then the lines themselves, hashed twice.
        mut meta = copy_text(view("grail-opt 3 "));
        meta.append(view(o.memo_id));
        meta.push(10);
        meta.append(view(o.unit));
        meta.push(10);
        meta.append(view(o.uprefix));
        meta.push(10);
        put_word(&mut meta, o.uniq);
        put_word(&mut meta, ir::facts_digest(ix, facts, view(o.name)));
        put_word(&mut meta, want_ir);
        // A body the front end applied from its unit store is keyed by that unit's key instead of its
        // lines: its text is a function of the key, and hashing 100 MB of text that did not change
        // was most of what a rebuild after an edit spent here. The compiler's own identity is in
        // the unit key and in `memo_id`, so a rebuilt optimiser never reads an older one's entry.
        mut keyed = s[from..to];
        if unit_key.len() != 0 {
            meta.append(view(" unit "));
            keyed = unit_key;
        }
        h1 := xxhash::hash64(keyed, 1) ^ xxhash::hash64(view(meta), 3);
        h2 := xxhash::hash64(keyed, 2) ^ xxhash::hash64(view(meta), 4);
        file = o.memo_dir.copy();
        file.append(view("/opt-"));
        hex_word(&mut file, h1);
        hex_word(&mut file, h2);
        if verify && (host::exists(view(file)) != 0) {
            verified = host::read_file(view(file));
        } else if host::exists(view(file)) != 0 {
            kept := host::read_file(view(file));
            // Whole entries only: the last word is written last.
            if 24 <= kept.len() {
                mut tail = kept.len() - 8;
                if take_word(view(kept), &mut tail) == 6072411188134084935 {
                    mut at = 0;
                    n := take_word(view(kept), &mut at);
                    base := o.out.len();
                    o.out.append(kept[at..at + n]);
                    at += n;
                    if take_word(view(kept), &mut at) != 0 {
                        name := take_text(view(kept), &mut at);
                        body_text := take_text(view(kept), &mut at);
                        unit := take_text(view(kept), &mut at);
                        inl_file(&mut o, name, ir::absolute_positions(view(body_text), o.gbase), unit);
                    }
                    count := take_word(view(kept), &mut at);
                    ir_piece := take_text(view(kept), &mut at);
                    ir_text.append(view(ir_piece));
                    lines := take_word(view(kept), &mut at);
                    for l in lines {
                        o.interest.push(base + take_word(view(kept), &mut at));
                    }
                    call_syms.push(o.name.copy());
                    call_counts.push(count);
                    return ();
                }
            }
        }
    }
    mut start = from;
    mut i = from;
    while i < to {
        if s[i] == 10 {
            ir::parse(&mut o, view(s), start, i);
            start = i + 1;
        }
        i += 1;
    }
    out_mark := o.out.len();
    ir_mark := ir_text.len();
    inl_mark := o.inl_names.len();
    body(&mut o, view(s), facts, ix, want_ir, ir_text, call_syms, call_counts);
    interest_mark := o.interest.len();
    note_interest(&mut o, out_mark);
    if file.len() != 0 {
        mut kept = u8[];
        out_end := o.out.len();
        put_text(&mut kept, o.out[out_mark..out_end]);
        if inl_mark < o.inl_names.len() {
            put_word(&mut kept, 1);
            put_text(&mut kept, view(o.inl_names[inl_mark]));
            put_text(&mut kept, view(o.inl_rel));
            put_text(&mut kept, view(o.inl_units[inl_mark]));
        } else {
            put_word(&mut kept, 0);
        }
        put_word(&mut kept, call_counts[call_counts.len() - 1]);
        ir_end := ir_text.len();
        put_text(&mut kept, ir_text[ir_mark..ir_end]);
        put_word(&mut kept, o.interest.len() - interest_mark);
        for l in interest_mark..o.interest.len() {
            put_word(&mut kept, o.interest[l] - out_mark);
        }
        put_word(&mut kept, 6072411188134084935);
        if (verified.len() != 0) && !ir::same_range(view(verified), 0, verified.len(), view(kept)) {
            host::print(view("grail: GRAIL_MEMO_VERIFY: the remembered optimisation of "));
            host::print(view(o.name));
            host::print(view(" under its unit's key is not what optimising it gives\n"));
            host::exit(1);
        }
        host::write_file(view(file), view(kept));
    }
    ir::reset(&mut o);
}
fn verify_memo<a>(unit_key: &a [u8]) -> bool {
    return (unit_key.len() != 0) && (host::env(view("GRAIL_MEMO_VERIFY")).len() != 0);
}
fn copy_text<a>(text: &a [u8]) -> u8[] {
    mut out = u8[];
    out.append(text);
    return out;
}
fn hex_word<a>(out: (&a mut u8[]), n: u64) {
    mut shift = 64;
    while shift != 0 {
        shift -= 4;
        d := (n >> shift) & 15;
        if d < 10 {
            out.push(u8(48 + d));
        } else {
            out.push(u8(87 + d));
        }
    }
}
fn put_word<a>(out: (&a mut u8[]), n: u64) {
    mut v = n;
    for i in 8 {
        out.push(u8(v & 255));
        v = v >> 8;
    }
}
fn put_text<a, b>(out: (&a mut u8[]), text: &b [u8]) {
    put_word(&mut out, text.len());
    out.append(text);
}
fn take_word<a, b>(from: &a [u8], at: (&b mut u64)) -> u64 {
    mut v = 0;
    mut shift = 0;
    for i in 8 {
        v = v | (u64(from[*at + i]) << shift);
        shift += 8;
    }
    exchange(at, *at + 8);
    return v;
}
fn take_text<a, b>(from: &a [u8], at: (&b mut u64)) -> u8[] {
    n := take_word(from, at);
    mut out = u8[];
    out.append(from[*at..*at + n]);
    exchange(at, *at + n);
    return out;
}
// File an inlinable body, as inline_candidate does.
fn inl_file<a>(o: (&a mut ir::Body), name: u8[], body: u8[], unit: u8[]) {
    h := name_hash(view(name), 0, name.len());
    index := o.inl_names.len();
    o.inl_names.push(name);
    o.inl_bodies.push(body);
    o.inl_units.push(unit);
    old := o.inl_head[h];
    o.inl_next.push(old);
    ir::put(&mut o.inl_head, h, index + 1);
}
// One forked copy per piece. Each optimises its piece and writes what it made to its pipe: the
// text, the unit markers it kept, the inlinable bodies it found, the typed IR and the call counts.
// This process reads the pipes in order, which is the order one process would have produced.
// False when the platform cannot fork: the caller then does the work itself.
fn run_forked<a, b, c, e, x, g, h>(o: (&a mut ir::Body), s: &b [u8], cuts: (&g Cut[]), split: u64, marks: (&mut u64[]), names: (&mut u8[][]), facts: (&c llvm::Facts), ix: (&x ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), call_syms: (&mut u8[][]), call_counts: (&mut u64[]), js: (&h mut jobs::Jobs)) -> bool {
    pieces := cuts.len() - 1;
    mut readers = u64[];
    mut children = u64[];
    for k in pieces {
        pair := host::pipe();
        child := host::fork();
        if child == 0 {
            host::close(pair[0]);
            for r in readers.len() {
                host::close(readers[r]);
            }
            mut w = ir::new_body();
            for i in 4096 {
                w.inl_head.push(0);
            }
            cut := &cuts[k];
            w.unit = cut.unit.copy();
            w.uprefix = cut.uprefix.copy();
            w.marked = cut.marked;
            w.uniq_index = cut.index;
            for i in cut.units.len() {
                w.uniq_units.push(cut.units[i].copy());
            }
            w.uniq_next = cut.counts.copy();
            w.uniq_plain = cut.plain;
            w.gbase = cut.gbase;
            w.memo_dir = o.memo_dir.copy();
            w.known = ir::Known { open: o.known.open.copy(), end: o.known.end.copy(), key: copy_texts(&o.known.key) };
            w.memo_id = o.memo_id.copy();
            mut wmarks = u64[];
            mut wnames = u8[][];
            mut wir = u8[];
            mut wsyms = u8[][];
            mut wcounts = u64[];
            run_range(&mut w, view(s), cut.at, cuts[k + 1].at, split, &mut wmarks, &mut wnames, facts, ix, want_ir, &mut wir, &mut wsyms, &mut wcounts);
            mut packed = u8[];
            wlines := exchange(&mut w.interest, u64[]);
            put_word(&mut packed, w.marked);
            put_text(&mut packed, view(w.out));
            put_word(&mut packed, wlines.len());
            for i in wlines.len() {
                put_word(&mut packed, wlines[i]);
            }
            put_word(&mut packed, wmarks.len());
            for i in wmarks.len() {
                put_word(&mut packed, wmarks[i]);
                put_text(&mut packed, view(wnames[i]));
            }
            put_word(&mut packed, w.inl_names.len());
            for i in w.inl_names.len() {
                put_text(&mut packed, view(w.inl_names[i]));
                put_text(&mut packed, view(w.inl_bodies[i]));
                put_text(&mut packed, view(w.inl_units[i]));
            }
            put_text(&mut packed, view(wir));
            put_word(&mut packed, wsyms.len());
            for i in wsyms.len() {
                put_text(&mut packed, view(wsyms[i]));
                put_word(&mut packed, wcounts[i]);
            }
            // The last word says the piece is whole: a copy that died leaves a short stream.
            put_word(&mut packed, 6072411188134084935);
            host::write_fd(pair[1], view(packed));
            host::close(pair[1]);
            host::exit(0);
        }
        host::close(pair[1]);
        if 9223372036854775807 < child {
            // No fork here. Nothing has been started yet when the first one fails, which is the
            // only one that can for that reason.
            host::close(pair[0]);
            assert(k == 0);
            return false;
        }
        readers.push(pair[0]);
        children.push(child);
    }
    mut all_lines = u64[];
    for k in pieces {
        mut packed = u8[];
        while true {
            chunk := host::read_fd(readers[k], 1048576);
            if chunk.len() == 0 {
                break;
            }
            packed.append(view(chunk));
        }
        host::close(readers[k]);
        status := host::wait(children[k]);
        mut whole = (status == 0) && (16 <= packed.len());
        if whole {
            mut tail = packed.len() - 8;
            whole = take_word(view(packed), &mut tail) == 6072411188134084935;
        }
        if !whole {
            // The tokens this process took for its workers go back before it stops.
            jobs::give_all(&mut js);
            host::print(view("grail: an optimiser worker did not finish (GRAIL_JOBS=1 runs the optimiser in one process)\n"));
            host::exit(1);
        }
        mut at = 0;
        if take_word(view(packed), &mut at) != 0 {
            o.marked = 1;
        }
        base := o.out.len();
        n := take_word(view(packed), &mut at);
        o.out.append(packed[at..at + n]);
        at += n;
        noted := take_word(view(packed), &mut at);
        for i in noted {
            all_lines.push(base + take_word(view(packed), &mut at));
        }
        kept := take_word(view(packed), &mut at);
        for i in kept {
            mark := take_word(view(packed), &mut at);
            name := take_text(view(packed), &mut at);
            if split != 0 {
                marks.push(base + mark);
                names.push(name);
            }
        }
        found := take_word(view(packed), &mut at);
        for i in found {
            name := take_text(view(packed), &mut at);
            body_text := take_text(view(packed), &mut at);
            unit := take_text(view(packed), &mut at);
            inl_file(&mut o, name, body_text, unit);
        }
        ir_piece := take_text(view(packed), &mut at);
        ir_text.append(view(ir_piece));
        counted := take_word(view(packed), &mut at);
        for i in counted {
            call_syms.push(take_text(view(packed), &mut at));
            call_counts.push(take_word(view(packed), &mut at));
        }
    }
    // Handed back in the body's label table, which nothing uses between bodies.
    exchange(&mut o.table, all_lines);
    return true;
}
