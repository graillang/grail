    if ((v >> 8) & 255) != 0 {
        index = ((v >> 8) & 255) - 1;
    }
    if o.op[i] == 86 {
        n := ir::uniq_take(&mut o);
        app(&mut o.out, view("cmpq "));
        emit_operand(&mut o, view(s), i, 0);
        app(&mut o.out, view(",%"));
        reg_name(&mut o, index);
        app(&mut o.out, view("\njb .L"));
        opt_label(&mut o);
        out_number(&mut o, n);
        // rt_fail(1, index, length) as rt_aslot reports it: the length the check no longer loaded.
        app(&mut o.out, view("\n"));
