// A call to one of the compiler's drop helpers (`.D` and 16 hex digits): it takes its value in rdi
// and nothing on the stack, so registers can be saved around it on the stack.
fn drop_call<a, b>(o: (&a ir::Body), s: &b [u8], i: u64) -> bool {
    return (o.k0[i] == 4) && (o.e0[i] - o.s0[i] == 18) && ir::at(view(s), o.s0[i], view(".D"));
