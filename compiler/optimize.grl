module optimize;

// Word-stream optimizer: runs on the x86-64-spelled stream before target lowering, so every CPU
// benefits. Per function it (1) forwards frame-slot values already held in a register or known
// constant within a basic block, (2) deletes stores to slots that are never read and register
// definitions that are never used, (3) promotes the hottest non-escaping slots into callee-saved
// registers (weighted by loop depth), and (4) fuses set/test/branch sequences and turns division
// by a power-of-two constant into shift/mask. Unrecognized functions are copied unchanged.
// Kinds: 0 none, 1 register, 2 frame slot -N(%rbp), 3 immediate/other text, 4 other operand,
// 5 generated text (range in O.gen). Ops: see opcode(); 100 label, 101 directive, 0 unknown.
struct O {
    ls: u64[],
    le: u64[],
    op: u64[],
    chg: u64[],
    del: u64[],
    lab: u64[],
    tr: u64[],
    k0: u64[],
    v0: u64[],
    s0: u64[],
    e0: u64[],
    m0: u64[],
    k1: u64[],
    v1: u64[],
    s1: u64[],
    e1: u64[],
    m1: u64[],
    gen: u8[],
    out: u8[],
    weird: u64,
    maxslot: u64,
    table: u64[],
    base: u64,
    data: u64,
    uniq: u64,
    zline: u64,
    zfrom: u64,
    zto: u64,
    inl_names: u8[][],
    inl_bodies: u8[][],
    inl_head: u64[],
    inl_next: u64[]
}
fn put<a>(v: (&mut a u64[]), i: u64, x: u64) {
    exchange(&mut v[i], x);
}
fn same<b, d>(s: read<b>, a: u64, e: u64, w: read<d>) -> u64 {
    if e - a != w.len() {
        return false;
    }
    for i in w.len() {
        if s[a + i] != w[i] {
            return false;
        }
    }
    return true;
}
fn app<a, b>(out: (&mut a u8[]), s: read<b>) {
    for i in s.len() {
        out.push(s[i]);
    }
}
fn bit(r: u64) -> u64 {
    return 1 << r;
}
// 0xFFCF: every general register except rsp/rbp; caller-saved; argument registers.
fn all_regs() -> u64 {
    return 65487;
}
fn caller_saved() -> u64 {
    return 4039;
}
fn arg_regs() -> u64 {
    return 966;
}
fn opcode_key(k: u64) -> u64 {
    if k == 1903587181 {
        return 1;
    }
    if k == 31933538747445101 {
        return 2;
    }
    if k == 1902208364 {
