            t := jump_target(&o, i);
            if t < last {
                j := next_live(&o, i, last);
                if j < last {
                    if (o.op[j] == 15) & (o.k0[j] == 4) {
                        if same(view(s), o.s0[j], o.e0[j], view("rt_abort")) {
                            if (o.lab[t] != 0)
                                & (next_live(&o, j, last) == t)
