    }
    peephole(&mut o, view(s), first, last);
    dead_defs(&mut o, view(s), first, last);
    newframe := compact(&mut o, view(s), prologue, ns);
    for i in last {
        if (newframe != 0) & (i + 1 == last) {
            app(&mut o.out, view(".set "));
            pa := o.s0[prologue] + 1;
            pe := o.e0[prologue];
            for x in pe - pa {
                o.out.push(s[pa + x]);
            }
            o.out.push(44);
            out_number(&mut o, newframe);
            o.out.push(10);
            continue;
        }
        if (chosen.len() != 0) & (o.op[i] == 29) & (o.del[i] == 0) {
            for c in chosen.len() {
                app(&mut o.out, view("movq "));
                emit_frame_slot(&mut o, view(s), prologue, c);
                app(&mut o.out, view(",%"));
                reg_name(&mut o, chosen[c]);
                o.out.push(10);
            }
        }
        if o.del[i] == 0 {
            emit_line(&mut o, view(s), i);
        }
        if (o.zline != 0) & (i + 1 == o.zline) {
            mut k = o.zfrom;
            while k < o.zto + 1 {
                app(&mut o.out, view("movq $0,-"));
                out_number(&mut o, k * 8);
                app(&mut o.out, view("(%rbp)\n"));
                k += 1;
            }
        }
        if (chosen.len() != 0) & (i == prologue) {
            app(&mut o.out, view("subq $"));
            out_number(&mut o, 16 * ((chosen.len() + 1) / 2));
            app(&mut o.out, view(",%rsp\n"));
            for c in chosen.len() {
                app(&mut o.out, view("movq %"));
                reg_name(&mut o, chosen[c]);
                o.out.push(44);
                emit_frame_slot(&mut o, view(s), prologue, c);
                o.out.push(10);
            }
            for c in chosen.len() {
                app(&mut o.out, view("movq $0,%"));
                reg_name(&mut o, chosen[c]);
                o.out.push(10);
            }
        }
    }
