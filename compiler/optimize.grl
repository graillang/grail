                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // testq %rcx,%rcx; jnz L; call rt_abort; L: xorq %rdx,%rdx; divq %rcx with rcx = 2^k
        if (op == 7) & (o.k0[i] == 1) & (o.v0[i] == 1) & (o.k1[i] == 1) & (o.v1[i] == 1) {
            j := next_live(&o, i, last);
            if j < last {
                if o.op[j] == 20 {
                    c := next_live(&o, j, last);
                    if c < last {
                        if (o.op[c] == 15)
                            & (o.k0[c] == 4)
                            & same(view(s), o.s0[c], o.e0[c], view("rt_abort")) {
                            x := next_insn(&o, c, last);
                            if x < last {
                                if (o.op[x] == 10)
                                    & (o.k0[x] == 1)
                                    & (o.v0[x] == 2)
                                    & (o.k1[x] == 1)
                                    & (o.v1[x] == 2) {
                                    d := next_live(&o, x, last);
                                    if d < last {
                                        if (o.op[d] == 13) & (o.k0[d] == 1) & (o.v0[d] == 1) {
                                            // Find the constant in rcx: last definition before the test.
                                            mut k = i;
                                            mut value = 0;
                                            mut steps = 0;
                                            while (first < k) & (steps < 8) {
                                                k -= 1;
                                                steps += 1;
                                                if o.del[k] == 0 {
                                                    kop := o.op[k];
                                                    if kop == 100 || kop == 0 || is_jump(kop) {
                                                        break;
                                                    }
