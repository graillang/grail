                    slots.push(best);
                    put(&mut f.bad, best, 1);
                }
            }
        }
        if chosen.len() != 0 {
            for i in last {
                if o.del[i] == 0 {
                    for j in 2 {
                        mut k = o.k0[i];
                        mut v = o.v0[i];
                        if j != 0 {
                            k = o.k1[i];
                            v = o.v1[i];
                        }
                        if k == 2 {
                            for c in slots.len() {
