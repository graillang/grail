fn opname<a>(o: (&a mut O), op: u64) {
    mut t = "";
    if op == 1 {
        t = "movq";
    }
    if op == 2 {
        t = "movabsq";
    }
    if op == 3 {
        t = "leaq";
    }
    if op == 4 {
        t = "addq";
    }
    if op == 5 {
        t = "subq";
    }
    if op == 6 {
        t = "cmpq";
    }
    if op == 7 {
        t = "testq";
    }
    if op == 8 {
        t = "andq";
    }
    if op == 9 {
        t = "orq";
    }
    if op == 10 {
        t = "xorq";
    }
    if op == 11 {
        t = "incq";
    }
    if op == 12 {
        t = "mulq";
    }
    if op == 13 {
        t = "divq";
    }
    if op == 14 {
        t = "imulq";
    }
    if op == 15 {
        t = "call";
    }
    if op == 16 {
        t = "jmp";
    }
    if op == 17 {
        t = "je";
    }
    if op == 18 {
        t = "jz";
    }
    if op == 19 {
        t = "jne";
    }
    if op == 20 {
        t = "jnz";
    }
    if op == 21 {
        t = "jnc";
    }
    if op == 22 {
        t = "jae";
    }
    if op == 23 {
        t = "jb";
    }
    if op == 24 {
        t = "jc";
    }
    if op == 25 {
        t = "sete";
    }
    if op == 26 {
        t = "setne";
    }
    if op == 27 {
        t = "setb";
    }
    if op == 28 {
        t = "movzbq";
    }
    if op == 29 {
        t = "leave";
    }
    if op == 30 {
        t = "ret";
    }
    if op == 31 {
        t = "pushq";
    }
    if op == 32 {
        t = "popq";
    }
    if op == 33 {
        t = "shlq";
    }
    if op == 34 {
        t = "shrq";
    }
    assert(t.len() != 0);
    app(&mut o.out, view(t));
}
// 0..15 for 64-bit names, 16+n for a narrower spelling of register n, 99 otherwise.
