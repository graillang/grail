module optimize;
use ir;
use jobs;
use xxhash;
use llvm;
use llvm;

// Word-stream optimizer: runs on the x86-64-spelled stream before target lowering, so every CPU
// benefits. Per function it (1) forwards frame-slot values already held in a register or known
// constant within a basic block, (2) deletes stores to slots that are never read and register
// definitions that are never used, (3) promotes the hottest non-escaping slots into callee-saved
// registers (weighted by loop depth), and (4) fuses set/test/branch sequences and turns division
// by a power-of-two constant into shift/mask. Unrecognized functions are copied unchanged.
//
// What a body *is* lives in `compiler/ir.grl`: the instruction record, the parser, the operand
// algebra and the typed-IR layer. This module is the passes and the printer that run over it.
//
// A slot is one word unless the typed-IR facts say it is the first word of a `DynPair`
// (docs/design/fat-dyn.md), the 16-byte `{data, vtable}` value a `&dyn I` points at: the body's
// pair list and its two-word-result flag are read once, in `ir::build`, through
// `llvm::facts_dyn_pairs` and `llvm::facts_dyn_result`, keyed by the body symbol. The two words are
// then one value with one identity - never promoted, never forwarded, their stores never dead, kept
// adjacent and in order - and a function that builds a pair is not inlined. This is the language's
// `DynPair`, not a directive the emitter wrote.

fn app<a, b>(out: (&a mut u8[]), s: &b [u8]) {
    out.append(s);
}
fn opname<a>(o: (&a mut ir::Body), op: u64) {
    if op == 1 {
        app(&mut o.out, view("movq"));
        return ();
    }
    if op == 2 {
        app(&mut o.out, view("movabsq"));
        return ();
    }
    if op == 3 {
        app(&mut o.out, view("leaq"));
        return ();
    }
    if op == 4 {
        app(&mut o.out, view("addq"));
        return ();
    }
    if op == 5 {
        app(&mut o.out, view("subq"));
        return ();
    }
    if op == 6 {
        app(&mut o.out, view("cmpq"));
        return ();
    }
    if op == 7 {
        app(&mut o.out, view("testq"));
        return ();
    }
    if op == 8 {
        app(&mut o.out, view("andq"));
        return ();
    }
    if op == 9 {
        app(&mut o.out, view("orq"));
        return ();
    }
    if op == 10 {
        app(&mut o.out, view("xorq"));
        return ();
    }
    if op == 11 {
        app(&mut o.out, view("incq"));
        return ();
    }
    if op == 12 {
        app(&mut o.out, view("mulq"));
        return ();
    }
    if op == 13 {
        app(&mut o.out, view("divq"));
        return ();
    }
    if op == 14 {
        app(&mut o.out, view("imulq"));
        return ();
    }
    if op == 15 {
        app(&mut o.out, view("call"));
        return ();
    }
    if op == 16 {
        app(&mut o.out, view("jmp"));
        return ();
    }
    if op == 17 {
        app(&mut o.out, view("je"));
        return ();
    }
    if op == 18 {
        app(&mut o.out, view("jz"));
        return ();
    }
    if op == 19 {
        app(&mut o.out, view("jne"));
        return ();
    }
    if op == 20 {
        app(&mut o.out, view("jnz"));
        return ();
    }
    if op == 21 {
        app(&mut o.out, view("jnc"));
        return ();
    }
    if op == 22 {
        app(&mut o.out, view("jae"));
        return ();
    }
    if op == 23 {
        app(&mut o.out, view("jb"));
        return ();
    }
    if op == 24 {
        app(&mut o.out, view("jc"));
        return ();
    }
    if op == 25 {
        app(&mut o.out, view("sete"));
        return ();
    }
    if op == 26 {
        app(&mut o.out, view("setne"));
        return ();
    }
    if op == 27 {
        app(&mut o.out, view("setb"));
        return ();
    }
    if op == 28 {
        app(&mut o.out, view("movzbq"));
        return ();
    }
    if op == 29 {
        app(&mut o.out, view("leave"));
        return ();
    }
    if op == 30 {
        app(&mut o.out, view("ret"));
        return ();
    }
    if op == 31 {
        app(&mut o.out, view("pushq"));
        return ();
    }
    if op == 32 {
        app(&mut o.out, view("popq"));
        return ();
    }
    if op == 33 {
        app(&mut o.out, view("shlq"));
        return ();
    }
    if op == 34 {
        app(&mut o.out, view("shrq"));
        return ();
    }
    if op == 60 {
        app(&mut o.out, view("addsd"));
        return ();
    }
    if op == 61 {
        app(&mut o.out, view("subsd"));
        return ();
    }
    if op == 62 {
        app(&mut o.out, view("mulsd"));
        return ();
    }
    if op == 63 {
        app(&mut o.out, view("divsd"));
        return ();
    }
    if op == 64 {
        app(&mut o.out, view("sqrtsd"));
        return ();
    }
    if op == 65 {
        app(&mut o.out, view("cvtss2sd"));
        return ();
    }
    if op == 66 {
        app(&mut o.out, view("cvtsd2ss"));
        return ();
    }
    if op == 67 {
        app(&mut o.out, view("ucomisd"));
        return ();
    }
    if op == 68 {
        app(&mut o.out, view("movaps"));
        return ();
    }
    if op == 69 {
        app(&mut o.out, view("cvttsd2si"));
        return ();
    }
    if op == 70 {
        app(&mut o.out, view("movd"));
        return ();
    }
    if op == 71 {
        app(&mut o.out, view("cvtsi2sdq"));
        return ();
    }
    if op == 72 {
        app(&mut o.out, view("addss"));
        return ();
    }
    if op == 73 {
        app(&mut o.out, view("subss"));
        return ();
    }
    if op == 74 {
        app(&mut o.out, view("mulss"));
        return ();
    }
    if op == 75 {
        app(&mut o.out, view("divss"));
        return ();
    }
    if op == 76 {
        app(&mut o.out, view("sqrtss"));
        return ();
    }
    // An operation this table does not know is a bug in the caller.
    assert(false);
}
fn set_operand<a>(o: (&a mut ir::Body), i: u64, j: u64, k: u64, v: u64) {
    if j == 0 {
        ir::put(&mut o.k0, i, k);
        ir::put(&mut o.v0, i, v);
        ir::put(&mut o.m0, i, 0);
    } else {
        ir::put(&mut o.k1, i, k);
        ir::put(&mut o.v1, i, v);
        ir::put(&mut o.m1, i, 0);
    }
    ir::put(&mut o.chg, i, 1);
}
fn set_range<a>(o: (&a mut ir::Body), i: u64, j: u64, a: u64, e: u64) {
    if j == 0 {
        ir::put(&mut o.s0, i, a);
        ir::put(&mut o.e0, i, e);
    } else {
        ir::put(&mut o.s1, i, a);
        ir::put(&mut o.e1, i, e);
    }
}
fn kill<a>(o: (&a mut ir::Body), i: u64) {
    ir::put(&mut o.del, i, 1);
}
struct F {
    // Slot facts (index N/8): register holding the value (+1) and its version, known
    // immediate line (+1), copy-of slot (+1) and its version; valid while ver/epoch match.
    sver: u64[],
    sep: u64[],
    sfv: u64[],
    sreg: u64[],
    sregv: u64[],
    simm: u64[],
    scopy: u64[],
    scopyv: u64[],
    bad: u64[],
    reads: u64[],
    weight: u64[],
    rver: u64[],
    rep: u64[],
    rimm: u64[],
    rslot: u64[],
    rslotv: u64[],
    rcopy: u64[],
    rcopyv: u64[],
    epoch: u64
}
fn facts_valid<a>(f: (&a F), n: u64) -> bool {
    return (f.sep[n] == f.epoch) && (f.sfv[n] == f.sver[n]);
}
fn fresh_facts<a>(f: (&a mut F), n: u64) {
    ir::put(&mut f.sep, n, f.epoch);
    ir::put(&mut f.sfv, n, f.sver[n]);
    ir::put(&mut f.sreg, n, 0);
    ir::put(&mut f.simm, n, 0);
    ir::put(&mut f.scopy, n, 0);
}
fn reg_written<a>(f: (&a mut F), r: u64) {
    ir::put(&mut f.rver, r, f.rver[r] + 1);
    ir::put(&mut f.rimm, r, 0);
    ir::put(&mut f.rslot, r, 0);
    ir::put(&mut f.rcopy, r, 0);
}
fn reg_fact_valid<a>(f: (&a F), r: u64) -> bool {
    return f.rep[r] == f.epoch;
}
fn copy_source<a>(f: (&a F), q: u64) -> u64 {
    if !reg_fact_valid(&f, q) {
        return q;
    }
    c := f.rcopy[q];
    if c == 0 {
        return q;
    }
    r := c - 1;
    if f.rcopyv[q] != f.rver[r] {
        return q;
    }
    return r;
}
// Replace a read of slot n (operand j of i) by a register or constant already holding it.
fn forward_read<a, c>(o: (&a mut ir::Body), f: (&c mut F), i: u64, j: u64, n: u64) {
    if !facts_valid(&f, n) {
        return ();
    }
    op := o.op[i];
    if (op == 1) & (j == 0) & (o.k1[i] == 1) & (f.simm[n] != 0) {
        l := f.simm[n] - 1;
        lk := o.k0[l];
        lv := o.v0[l];
        la := o.s0[l];
        le := o.e0[l];
        set_operand(&mut o, i, 0, lk, lv);
        set_range(&mut o, i, 0, la, le);
        ir::put(&mut o.op, i, 2);
        return ();
    }
    if f.sreg[n] != 0 {
        r := f.sreg[n] - 1;
        if f.sregv[n] == f.rver[r] {
            set_operand(&mut o, i, j, 1, r);
            return ();
        }
    }
    if f.scopy[n] != 0 {
        m := f.scopy[n] - 1;
        if f.scopyv[n] == f.sver[m] {
            set_operand(&mut o, i, j, 2, m * 8);
            if facts_valid(&f, m) {
                if f.sreg[m] != 0 {
                    r := f.sreg[m] - 1;
                    if f.sregv[m] == f.rver[r] {
                        set_operand(&mut o, i, j, 1, r);
                    }
                }
            }
        }
    }
}
fn new_facts(ns: u64) -> F {
    mut f = F {
        sver: u64[],
        sep: u64[],
        sfv: u64[],
        sreg: u64[],
        sregv: u64[],
        simm: u64[],
        scopy: u64[],
        scopyv: u64[],
        bad: u64[],
        reads: u64[],
        weight: u64[],
        rver: u64[],
        rep: u64[],
        rimm: u64[],
        rslot: u64[],
        rslotv: u64[],
        rcopy: u64[],
        rcopyv: u64[],
        epoch: 1,
    };
    for i in ns {
        f.sver.push(0);
        f.sep.push(0);
        f.sfv.push(0);
        f.sreg.push(0);
        f.sregv.push(0);
        f.simm.push(0);
        f.scopy.push(0);
        f.scopyv.push(0);
        f.bad.push(0);
        f.reads.push(0);
        f.weight.push(0);
    }
    for i in 16 {
        f.rver.push(0);
        f.rep.push(0);
        f.rimm.push(0);
        f.rslot.push(0);
        f.rslotv.push(0);
        f.rcopy.push(0);
        f.rcopyv.push(0);
    }
    return f;
}
fn forward<a, b, c>(o: (&a mut ir::Body), f: (&c mut F), s: &b [u8], first: u64, last: u64) {
    mut i = first;
    while i < last {
        op := o.op[i];
        if o.del[i] != 0 || op == 101 || o.tr[i] != 0 {
            i += 1;
            continue;
        }
        if op == 100 || op == 0 {
            exchange(&mut f.epoch, f.epoch + 1);
            if op == 0 {
                for r in 16 {
                    reg_written(&mut f, r);
                }
            }
            i += 1;
            continue;
        }
        mut loaded = 0;
        if (o.k0[i] == 2) & promotable_use(&o, i) {
            n := o.v0[i] / 8;
            if f.bad[n] == 0 {
                if ir::movelike(op) & (o.k1[i] == 1) {
                    loaded = n + 1;
                }
                forward_read(&mut o, &mut f, i, 0, n);
            }
        }
        if ir::slot_read(&o, i, 1) & promotable_use(&o, i) {
            n := o.v1[i] / 8;
            if f.bad[n] == 0 {
                forward_read(&mut o, &mut f, i, 1, n);
            }
        }
        // Copy propagation: read-only register operands use the original of a register copy.
        if o.k0[i] == 1
            && (op == 1
                    || op == 4
                    || op == 5
                    || op == 6
                    || op == 7
                    || op == 8
                    || op == 9
                    || op == 10) {
            r := copy_source(&f, o.v0[i]);
            if r != o.v0[i] {
                set_operand(&mut o, i, 0, 1, r);
            }
        }
        if o.k1[i] == 1 && (op == 6 || op == 7) {
            r := copy_source(&f, o.v1[i]);
            if r != o.v1[i] {
                set_operand(&mut o, i, 1, 1, r);
            }
        }
        // A register operand known to hold a small constant becomes an immediate - never into an
        // SSE destination (kind 6): `movq $imm,%xmm0` does not exist.
        if o.k0[i] == 1
            && o.k1[i] != 6
            && o.k1[i] != 7
            && (op == 1 || op == 4 || op == 5 || op == 6 || op == 8 || op == 9 || op == 10) {
            r := o.v0[i];
            if reg_fact_valid(&f, r) & (f.rimm[r] != 0) {
                l := f.rimm[r] - 1;
                value := imm_value(&o, view(s), l);
                wide := (op == 1) & (o.k1[i] == 1);
                if value != 0 && (wide || value < 2147483649) {
                    la := o.s0[l];
                    le := o.e0[l];
                    set_operand(&mut o, i, 0, 3, 0);
                    set_range(&mut o, i, 0, la, le);
                    if wide {
                        ir::put(&mut o.op, i, 2);
                    }
                }
            }
        }
        op2 := o.op[i];
        if (op2 == 1) & (o.k0[i] == 1) & (o.k1[i] == 1) & (o.v0[i] == o.v1[i]) {
            kill(&mut o, i);
            i += 1;
            continue;
        }
        w := ir::writes(&o, i);
        // Facts of the source register, captured before the destination is invalidated.
        mut src_imm = 0;
        mut src_slot = 0;
        mut src_slotv = 0;
        if (o.k0[i] == 1) & (op2 == 1) {
            r := o.v0[i];
            if reg_fact_valid(&f, r) {
                src_imm = f.rimm[r];
                src_slot = f.rslot[r];
                src_slotv = f.rslotv[r];
            }
        }
        for r in 16 {
            if ((w >> r) & 1) != 0 {
                reg_written(&mut f, r);
            }
        }
        if ir::slot_written(&o, i) {
            n := o.v1[i] / 8;
            ir::put(&mut f.sver, n, f.sver[n] + 1);
            if (op2 == 1) & (f.bad[n] == 0) {
                fresh_facts(&mut f, n);
                if o.k0[i] == 1 {
                    r := o.v0[i];
                    ir::put(&mut f.sreg, n, r + 1);
                    ir::put(&mut f.sregv, n, f.rver[r]);
                    if src_imm != 0 {
                        ir::put(&mut f.simm, n, src_imm);
                    }
                    if src_slot != 0 {
                        m := src_slot - 1;
                        if (m != n) & (src_slotv == f.sver[m]) {
                            ir::put(&mut f.scopy, n, m + 1);
                            ir::put(&mut f.scopyv, n, f.sver[m]);
                        }
                    }
                }
                if o.k0[i] == 3 {
                    ir::put(&mut f.simm, n, i + 1);
                }
            }
        }
        if (op2 == 1 || op2 == 2) && o.k1[i] == 1 {
            q := o.v1[i];
            ir::put(&mut f.rep, q, f.epoch);
            if o.k0[i] == 3 {
                ir::put(&mut f.rimm, q, i + 1);
            }
            if o.k0[i] == 1 {
                ir::put(&mut f.rimm, q, src_imm);
                ir::put(&mut f.rslot, q, src_slot);
                ir::put(&mut f.rslotv, q, src_slotv);
                r := o.v0[i];
                if r != q {
                    ir::put(&mut f.rcopy, q, r + 1);
                    ir::put(&mut f.rcopyv, q, f.rver[r]);
                }
            }
            if o.k0[i] == 2 {
                n := o.v0[i] / 8;
                if f.bad[n] == 0 {
                    ir::put(&mut f.rslot, q, n + 1);
                    ir::put(&mut f.rslotv, q, f.sver[n]);
                    if !facts_valid(&f, n) {
                        fresh_facts(&mut f, n);
                    }
                    ir::put(&mut f.sreg, n, q + 1);
                    ir::put(&mut f.sregv, n, f.rver[q]);
                }
            }
            if loaded != 0 {
                n := loaded - 1;
                if o.k0[i] != 2 {
                    ir::put(&mut f.rslot, q, n + 1);
                    ir::put(&mut f.rslotv, q, f.sver[n]);
                }
            }
        }
        if ir::is_jump(op2) && op2 != 15 {
            exchange(&mut f.epoch, f.epoch + 1);
        }
        if op2 == 29 || op2 == 30 {
            exchange(&mut f.epoch, f.epoch + 1);
        }
        i += 1;
    }
}
fn count_reads<a, c>(o: (&a ir::Body), f: (&c mut F), first: u64, last: u64) {
    for n in f.reads.len() {
        ir::put(&mut f.reads, n, 0);
    }
    for i in last - first {
        j := first + i;
        if o.del[j] == 0 {
            if ir::slot_read(&o, j, 0) {
                n := o.v0[j] / 8;
                ir::put(&mut f.reads, n, f.reads[n] + 1);
            }
            if ir::slot_read(&o, j, 1) {
                n := o.v1[j] / 8;
                ir::put(&mut f.reads, n, f.reads[n] + 1);
            }
        }
    }
}
fn dead_stores<a, c>(o: (&a mut ir::Body), f: (&c mut F), first: u64, last: u64) {
    count_reads(&o, &mut f, first, last);
    for i in last - first {
        j := first + i;
        if (o.del[j] == 0) & (o.op[j] == 1) & (o.k1[j] == 2) {
            n := o.v1[j] / 8;
            if (f.bad[n] == 0) & (f.reads[n] == 0) {
                kill(&mut o, j);
            }
        }
    }
}
// Function-wide backward liveness over the label graph (iterated to a fixed point); unknown
// jump targets and unrecognized instructions make every register live.
fn live_pass<a, c>(o: (&a mut ir::Body), lin: (&c mut u64[]), remove: u64) -> u64 {
    last := o.op.len();
    mut live = 0;
    mut i = last;
    mut changed = 0;
    while 0 < i {
        i -= 1;
        if (o.del[i] == 0) & (o.tr[i] == 0) {
            op := o.op[i];
            if op == 100 {
                if lin[i] != live {
                    ir::put(&mut lin, i, live);
                    changed = 1;
                }
            } else {
                if op != 101 {
                    if op == 16 || (16 < op && op < 25) {
                        t := jump_target(&o, i);
                        mut there = ir::all_regs();
                        if t < last {
                            there = lin[t];
                        }
                        if op == 16 {
                            live = there;
                        } else {
                            live = live | there;
                        }
                    } else {
                        if op == 29 || op == 30 {
                            live = ir::result_live(&o);
                        } else {
                            if op == 0 {
                                live = ir::all_regs();
                            } else {
                                mut removable = 0;
                                if remove != 0 && ir::movelike(op) && o.k1[i] == 1 {
                                    q := o.v1[i];
                                    if ((live >> q) & 1) == 0 && q != 4 && q != 5 {
                                        removable = 1;
                                    }
                                    if (op == 1) & (o.k0[i] == 1) & (o.v0[i] == q) {
                                        removable = 1;
                                    }
                                }
                                if removable != 0 {
                                    kill(&mut o, i);
                                } else {
                                    live = (live & (ir::all_regs() - ir::writes(&o, i)))
                                        | ir::reads(&o, i);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return changed;
}
fn dead_defs<a, b>(o: (&a mut ir::Body), s: &b [u8], first: u64, last: u64) {
    mut lin = u64[];
    for i in last {
        lin.push(0);
    }
    mut rounds = 0;
    while rounds < 50 {
        rounds += 1;
        if live_pass(&mut o, &mut lin, 0) == 0 {
            break;
        }
    }
    if rounds < 50 {
        live_pass(&mut o, &mut lin, 1);
    }
}
fn next_live<a>(o: (&a ir::Body), i: u64, last: u64) -> u64 {
    mut j = i + 1;
    while j < last {
        if (o.del[j] == 0) & (o.op[j] != 101) {
            return j;
        }
        j += 1;
    }
    return last;
}
fn next_insn<a>(o: (&a ir::Body), i: u64, last: u64) -> u64 {
    mut j = next_live(&o, i, last);
    while j < last {
        if o.op[j] != 100 {
            return j;
        }
        j = next_live(&o, j, last);
    }
    return last;
}
// Whether register r is dead after instruction i: followed forward through jumps (bounded).
fn dead_after<a>(o: (&a ir::Body), i: u64, r: u64, budget: u64) -> bool {
    last := o.op.len();
    if budget == 0 {
        return false;
    }
    mut j = i;
    mut steps = 0;
    while steps < 40 {
        steps += 1;
        j = next_insn(&o, j, last);
        if j >= last {
            return false;
        }
        op := o.op[j];
        rd := ir::reads(&o, j);
        if ((rd >> r) & 1) != 0 {
            return false;
        }
        if op == 0 {
            return false;
        }
        wr := ir::writes(&o, j);
        if ((wr >> r) & 1) != 0 {
            return true;
        }
        if ir::is_jump(op) && op != 15 {
            t := jump_target(&o, j);
            if t >= last {
                return false;
            }
            if op == 16 {
                j = t;
            } else {
                if !dead_after(&o, t, r, budget - 1) {
                    return false;
                }
            }
        }
        if op == 29 || op == 30 {
            return false;
        }
    }
    return false;
}
fn jump_target<a>(o: (&a ir::Body), j: u64) -> u64 {
    last := o.op.len();
    if o.k0[j] != 4 || o.v0[j] == 0 {
        return last;
    }
    n := o.v0[j] - 1;
    base := o.base;
    if o.m0[j] != 0 {
        return last;
    }
    if n < base {
        return last;
    }
    if n - base >= o.table.len() {
        return last;
    }
    t := o.table[n - base];
    if t == 0 {
        return last;
    }
    return t - 1;
}
// The self-check behind GRAIL_OPT_STATS=1: one comment line per body, `# grail-jumps <known>
// <unknown>`, counting the direct jumps the passes will see a target line for and the ones they
// will not (a label this body does not define, a spelling label_number does not read, or every jump
// of a body left as written). The passes fall back silently on an unknown target, so a parser that
// stops recognising the labels the backend mints costs speed and nothing fails; a test sums these
// over the compiler's own sources (tools/test-optimiser-jumps.mjs).
fn jump_stats<a>(o: (&a mut ir::Body), last: u64) {
    if host::env(view("GRAIL_OPT_STATS")).len() == 0 {
        return ();
    }
    mut known = 0;
    mut unknown = 0;
    for i in last {
        if (15 < o.op[i]) & (o.op[i] < 25) & (o.k0[i] == 4) {
            if (o.weird == 0) && (jump_target(&o, i) < last) {
                known += 1;
            } else {
                unknown += 1;
            }
        }
    }
    app(&mut o.out, view("# grail-jumps "));
    ir::append_num(&mut o.out, known);
    app(&mut o.out, view(" "));
    ir::append_num(&mut o.out, unknown);
    app(&mut o.out, view("\n"));
}
fn gen_number<a>(o: (&a mut ir::Body), n: u64) -> u64 {
    start := o.gen.len();
    if 9 < n {
        gen_number(&mut o, n / 10);
    }
    o.gen.push(48 + n % 10);
    return start;
}
fn gen_imm<a>(o: (&a mut ir::Body), n: u64, i: u64, j: u64) {
    start := o.gen.len();
    o.gen.push(36);
    gen_number(&mut o, n);
    end := o.gen.len();
    set_operand(&mut o, i, j, 5, 0);
    set_range(&mut o, i, j, start, end);
}
fn imm_value<a, b>(o: (&a ir::Body), s: &b [u8], i: u64) -> u64 {
    // Decimal immediate of operand 0 (+1), or 0.
    if o.k0[i] != 3 {
        return 0;
    }
    a := o.s0[i] + 1;
    e := o.e0[i];
    if e <= a || e - a > 18 {
        return 0;
    }
    mut n = 0;
    for k in e - a {
        d := s[a + k];
        if d < 48 || 57 < d {
            return 0;
        }
        n = n * 10 + d - 48;
    }
    return n + 1;
}
fn peephole<a, b>(o: (&a mut ir::Body), s: &b [u8], first: u64, last: u64) {
    mut i = first;
    while i < last {
        if o.del[i] != 0 {
            i += 1;
            continue;
        }
        op := o.op[i];
        // setCC %al; movzbq %al,%rax; [xorq $1,%rax]; testq %rax,%rax; jz/jnz L  ->  jCC L
        if op == 25 || op == 26 || op == 27 {
            a := next_live(&o, i, last);
            if a < last {
                if (o.op[a] == 28) & (o.k1[a] == 1) & (o.v1[a] == 0) {
                    mut b = next_live(&o, a, last);
                    mut invert = 0;
                    if b < last {
                        if (o.op[b] == 10)
                            & (o.k1[b] == 1)
                            & (o.v1[b] == 0)
                            & (imm_value(&o, view(s), b) == 2) {
                            invert = 1;
                            b = next_live(&o, b, last);
                        }
                    }
                    if b < last {
                        if (o.op[b] == 7)
                            & (o.k0[b] == 1)
                            & (o.v0[b] == 0)
                            & (o.k1[b] == 1)
                            & (o.v1[b] == 0) {
                            c := next_live(&o, b, last);
                            if c < last {
                                jop := o.op[c];
                                if jop == 17 || jop == 18 || jop == 19 || jop == 20 {
                                    t := jump_target(&o, c);
                                    if t < last {
                                        // Six levels: a loop's exit often runs through a chain
                                        // of drop-flag tests before anything writes %rax.
                                        if dead_after(&o, c, 0, 6)
                                            & dead_after(&o, t, 0, 6) {
                                            // jump when the value is non-zero (jnz/jne) or zero (jz/je)
                                            mut when = jop == 19 || jop == 20;
                                            if invert != 0 {
                                                when = !when;
                                            }
                                            mut nj = 0;
                                            if op == 25 {
                                                if when {
                                                    nj = 17;
                                                } else {
                                                    nj = 19;
                                                }
                                            }
                                            if op == 26 {
                                                if when {
                                                    nj = 19;
                                                } else {
                                                    nj = 17;
                                                }
                                            }
                                            if op == 27 {
                                                if when {
                                                    nj = 23;
                                                } else {
                                                    nj = 22;
                                                }
                                            }
                                            ir::put(&mut o.op, c, nj);
                                            ir::put(&mut o.chg, c, 1);
                                            kill(&mut o, i);
                                            kill(&mut o, a);
                                            kill(&mut o, b);
                                            if invert != 0 {
                                                mut x = next_live(&o, a, last);
                                                if x < c {
                                                    if o.op[x] == 10 {
                                                        kill(&mut o, x);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // testq %rcx,%rcx; jnz L; call rt_abort; L: xorq %rdx,%rdx; divq %rcx with rcx = 2^k
        if (op == 7) & (o.k0[i] == 1) & (o.v0[i] == 1) & (o.k1[i] == 1) & (o.v1[i] == 1) {
            j := next_live(&o, i, last);
            if j < last {
                if o.op[j] == 20 {
                    c := next_live(&o, j, last);
                    if c < last {
                        if (o.op[c] == 15)
                            & (o.k0[c] == 4)
                            & ir::same_range(view(s), o.s0[c], o.e0[c], view("rt_abort")) {
                            x := next_insn(&o, c, last);
                            if x < last {
                                if (o.op[x] == 10)
                                    & (o.k0[x] == 1)
                                    & (o.v0[x] == 2)
                                    & (o.k1[x] == 1)
                                    & (o.v1[x] == 2) {
                                    d := next_live(&o, x, last);
                                    if d < last {
                                        if (o.op[d] == 13) & (o.k0[d] == 1) & (o.v0[d] == 1) {
                                            // Find the constant in rcx: last definition before the test.
                                            mut k = i;
                                            mut value = 0;
                                            mut steps = 0;
                                            while (first < k) & (steps < 8) {
                                                k -= 1;
                                                steps += 1;
                                                if o.del[k] == 0 {
                                                    kop := o.op[k];
                                                    if kop == 100 || kop == 0 || ir::is_jump(kop) {
                                                        break;
                                                    }
                                                    if ((ir::writes(&o, k) >> 1) & 1) != 0 {
                                                        if (kop == 1 || kop == 2)
                                                            && o.k1[k] == 1 {
                                                            value = imm_value(&o, view(s), k);
                                                        }
                                                        break;
                                                    }
                                                }
                                            }
                                            if (value > 1) & (value < 2147483650) {
                                                v := value - 1;
                                                if (v & (v - 1)) == 0 {
                                                    mut shift = 0;
                                                    while (1 << shift) < v {
                                                        shift += 1;
                                                    }
                                                    ir::put(&mut o.op, i, 1);
                                                    set_operand(&mut o, i, 0, 1, 0);
                                                    set_operand(&mut o, i, 1, 1, 2);
                                                    ir::put(&mut o.op, j, 8);
                                                    gen_imm(&mut o, v - 1, j, 0);
                                                    set_operand(&mut o, j, 1, 1, 2);
                                                    ir::put(&mut o.op, c, 34);
                                                    gen_imm(&mut o, shift, c, 0);
                                                    set_operand(&mut o, c, 1, 1, 0);
                                                    kill(&mut o, x);
                                                    kill(&mut o, d);
                                                    ir::put(&mut o.tr, i, 0);
                                                    ir::put(&mut o.tr, j, 0);
                                                    ir::put(&mut o.tr, c, 0);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1;
    }
}
// Slot use permitted after promotion: the instruction stays valid with a register operand.
fn promotable_use<a>(o: (&a ir::Body), i: u64) -> bool {
    op := o.op[i];
    if op == 1
        || op == 4
        || op == 5
        || op == 6
        || op == 7
        || op == 8
        || op == 9
        || op == 10
        || op == 14 {
        mut other = o.k1[i];
        if o.k1[i] == 2 {
            other = o.k0[i];
        }
        return (other == 0) || (other == 1) || (other == 3) || (other == 5);
    }
    return (op == 11) || (op == 12) || (op == 13);
}
fn emit_operand<a, b>(o: (&a mut ir::Body), s: &b [u8], i: u64, j: u64) {
    mut k = o.k0[i];
    mut v = o.v0[i];
    mut a = o.s0[i];
    mut e = o.e0[i];
    if j != 0 {
        k = o.k1[i];
        v = o.v1[i];
        a = o.s1[i];
        e = o.e1[i];
    }
    if k == 1 {
        o.out.push(37);
        reg_name(&mut o, v);
        return ();
    }
    if k == 2 {
        o.out.push(45);
        out_number(&mut o, v);
        app(&mut o.out, view("(%rbp)"));
        return ();
    }
    // A frame slot promoted to an SSE register (`v` is its number).
    if k == 7 {
        app(&mut o.out, view("%xmm"));
        out_number(&mut o, v);
        return ();
    }
    if k == 5 {
        for x in e - a {
            c := o.gen[a + x];
            o.out.push(c);
        }
        return ();
    }
    for x in e - a {
        o.out.push(s[a + x]);
    }
}
fn reg_name<a>(o: (&a mut ir::Body), r: u64) {
    if r == 0 {
        app(&mut o.out, view("rax"));
        return ();
    }
    if r == 1 {
        app(&mut o.out, view("rcx"));
        return ();
    }
    if r == 2 {
        app(&mut o.out, view("rdx"));
        return ();
    }
    if r == 3 {
        app(&mut o.out, view("rbx"));
        return ();
    }
    if r == 4 {
        app(&mut o.out, view("rsp"));
        return ();
    }
    if r == 5 {
        app(&mut o.out, view("rbp"));
        return ();
    }
    if r == 6 {
        app(&mut o.out, view("rsi"));
        return ();
    }
    if r == 7 {
        app(&mut o.out, view("rdi"));
        return ();
    }
    if r == 8 {
        app(&mut o.out, view("r8"));
        return ();
    }
    if r == 9 {
        app(&mut o.out, view("r9"));
        return ();
    }
    if r == 10 {
        app(&mut o.out, view("r10"));
        return ();
    }
    if r == 11 {
        app(&mut o.out, view("r11"));
        return ();
    }
    if r == 12 {
        app(&mut o.out, view("r12"));
        return ();
    }
    if r == 13 {
        app(&mut o.out, view("r13"));
        return ();
    }
    if r == 14 {
        app(&mut o.out, view("r14"));
        return ();
    }
    if r == 15 {
        app(&mut o.out, view("r15"));
        return ();
    }
}
fn out_number<a>(o: (&a mut ir::Body), n: u64) {
    if 9 < n {
        out_number(&mut o, n / 10);
    }
    o.out.push(48 + n % 10);
}
// The leaf runtime accessors written in line: 40 rt_slot, 41 rt_at, 42 rt_len, 43 rt_xchg, 44 rt_atb,
// 45 rt_push, 46 rt_pushb, 47 rt_slotu, 48 rt_atbu, 49 rt_slot4, 50 rt_slot4u, 51 rt_at4,
// 52 the sized element address (index * element size in %rdx, unboxed-values stage 1b) (ir.grl
// parse). The arguments are where the call put them (%rdi, %rsi) and the result is in %rax, so the
// text replaces the `call` exactly. `label` with `n` (and `more` for the push forms) names the local
// labels; a bounds check that fails calls `rt_abort`, as the accessor would have.
// This is lowering, not optimisation: `lower_leaf_calls` runs it on a build the optimiser skips.
pub fn leaf_expansion<a, b>(out: (&a mut u8[]), op: u64, label: &b [u8], n: u64, more: u64, trap: u64) {
    if op == 40 || op == 41 || op == 44 || op == 49 || op == 51 || op == 52 {
        out.append(view("cmpq 8(%rdi),%rsi\njb .L"));
        out.append(label);
        put_num(&mut out, n);
        // With no site table to turn `call rt_abort` into a located `rt_trap` later (`trap`), the
        // failure is reported here as the accessor would: an index check on the vector in %rdi,
        // which a task can contain.
        if trap != 0 {
            out.append(view("\nmovq $1,%rdx\ncall rt_trap\n.L"));
        } else {
            out.append(view("\ncall rt_abort\n.L"));
        }
        out.append(label);
        put_num(&mut out, n);
        if op == 52 {
            out.append(view(":\nmovq %rsi,%rax\nimulq %rdx,%rax\naddq (%rdi),%rax\n"));
        } else if op == 49 {
            out.append(view(":\nmovq (%rdi),%rax\nleaq (%rax,%rsi,4),%rax\n"));
        } else if op == 51 {
            out.append(view(":\nmovq (%rdi),%rax\nmovl (%rax,%rsi,4),%eax\n"));
        } else if op == 40 {
            out.append(view(":\nmovq (%rdi),%rax\nleaq (%rax,%rsi,8),%rax\n"));
        } else if op == 41 {
            out.append(view(":\nmovq (%rdi),%rax\nmovq (%rax,%rsi,8),%rax\n"));
        } else {
            out.append(view(":\nmovq (%rdi),%rax\nmovzbq (%rax,%rsi,1),%rax\n"));
        }
        return ();
    }
    if op == 42 {
        out.append(view("movq 8(%rdi),%rax\n"));
        return ();
    }
    if op == 43 {
        out.append(view("movq (%rdi),%rax\nmovq %rsi,(%rdi)\n"));
        return ();
    }
    if op == 47 {
        out.append(view("movq (%rdi),%rax\nleaq (%rax,%rsi,8),%rax\n"));
        return ();
    }
    if op == 48 {
        out.append(view("movq (%rdi),%rax\nmovzbq (%rax,%rsi,1),%rax\n"));
        return ();
    }
    if op == 50 {
        out.append(view("movq (%rdi),%rax\nleaq (%rax,%rsi,4),%rax\n"));
        return ();
    }
    if op == 45 || op == 46 {
        fast := n;
        done := more;
        app(&mut out, view("movq 8(%rdi),%rcx\ncmpq 16(%rdi),%rcx\njb .L"));
        out.append(label);
        put_num(&mut out, fast);
        if op == 45 {
            app(&mut out, view("\ncall rt_push\njmp .L"));
        } else {
            app(&mut out, view("\ncall rt_pushb\njmp .L"));
        }
        out.append(label);
        put_num(&mut out, done);
        app(&mut out, view("\n.L"));
        out.append(label);
        put_num(&mut out, fast);
        if op == 45 {
            app(
                &mut out,
                view(":\nmovq (%rdi),%rdx\nmovq %rsi,(%rdx,%rcx,8)\nincq %rcx\nmovq %rcx,8(%rdi)\n")
            );
        } else {
            app(
                &mut out,
                view(":\nleaq 1(%rcx),%rdx\nmovq %rdx,8(%rdi)\naddq (%rdi),%rcx\nmovq %rsi,%rax\nmovb %al,(%rcx)\n")
            );
        }
        app(&mut out, view("movq $0,%rax\n.L"));
        out.append(label);
        put_num(&mut out, done);
        app(&mut out, view(":\n"));
        return ();
    }
}
fn put_num<a>(out: (&a mut u8[]), n: u64) {
    if 9 < n {
        put_num(&mut out, n / 10);
    }
    out.push(48 + n % 10);
}
// A build the optimiser does not run on (`--debug`) still gets the leaf accessors in line: every
// line that is exactly `call NAME` for one of them becomes its expansion, with labels of its own.
pub fn lower_leaf_calls<a>(s: &a [u8]) -> u8[] {
    mut out = u8[];
    mut n: u64 = 0;
    mut a = 0;
    while a < s.len() {
        mut e = a;
        while (e < s.len()) && (s[e] != 10) {
            e += 1;
        }
        mut op = 0;
        if (e - a > 7) && ir::at(view(s), a, view("call rt_")) {
            name := s[a + 5: e].copy();
            op = leaf_op(view(name));
        }
        if op != 0 {
            n += 1;
            first := n;
            mut more = 0;
            if op == 45 || op == 46 {
                n += 1;
                more = n;
            }
            leaf_expansion(&mut out, op, view("grail_leaf_"), first, more, 1);
        } else {
            for x in e - a {
                out.push(s[a + x]);
            }
            if e < s.len() {
                out.push(10);
            }
        }
        a = e + 1;
    }
    return out;
}
fn leaf_op<a>(name: &a [u8]) -> u64 {
    names := u8[][copy_text(view("rt_slot")), copy_text(view("rt_at")), copy_text(view("rt_len")), copy_text(view("rt_xchg")),
        copy_text(view("rt_atb")), copy_text(view("rt_push")), copy_text(view("rt_pushb")), copy_text(view("rt_slotu")),
        copy_text(view("rt_atbu")), copy_text(view("rt_slot4")), copy_text(view("rt_slot4u")), copy_text(view("rt_at4")),
        copy_text(view("rt_slotw"))];
    for i in names.len() {
        if names[i].len() == name.len() {
            mut same = true;
            for j in name.len() {
                if names[i][j] != name[j] {
                    same = false;
                }
            }
            if same {
                return 40 + i;
            }
        }
    }
    return 0;
}
fn emit_line<a, b>(o: (&a mut ir::Body), s: &b [u8], i: u64) {
    op := o.op[i];
    if (39 < op) & (op < 53) {
        mut label = u8[];
        label.append(view("opt"));
        prefix := o.uprefix.copy();
        label.append(view(prefix));
        label.push(95);
        // Only the forms with labels number them, as they always have.
        mut n = 0;
        mut more = 0;
        if op == 40 || op == 41 || op == 44 || op == 49 || op == 51 || op == 52 || op == 45 || op == 46 {
            n = ir::uniq_take(&mut o);
        }
        if op == 45 || op == 46 {
            more = ir::uniq_take(&mut o);
        }
        leaf_expansion(&mut o.out, op, view(label), n, more, 0);
        return ();
    }
    if o.chg[i] == 0 {
        for x in o.le[i] - o.ls[i] {
            o.out.push(s[o.ls[i] + x]);
        }
        o.out.push(10);
        return ();
    }
    opname(&mut o, o.op[i]);
    if o.k0[i] != 0 {
        o.out.push(32);
        emit_operand(&mut o, view(s), i, 0);
        if o.k1[i] != 0 {
            o.out.push(44);
            emit_operand(&mut o, view(s), i, 1);
        }
    }
    o.out.push(10);
}
// `opt<unit prefix>_`: the namespace of the optimizer's own expansion labels, so a unit's `.Lopt`
// numbers do not depend on the expansions the units before it emitted.
fn opt_label<a>(o: (&a mut ir::Body)) {
    app(&mut o.out, view("opt"));
    prefix := o.uprefix.copy();
    app(&mut o.out, view(prefix));
    o.out.push(95);
}
fn emit_frame_slot<a, b>(o: (&a mut ir::Body), s: &b [u8], p: u64, k: u64) {
    // -.FN-8(k+1)(%rbp), where .FN is the frame constant named by the prologue subq.
    app(&mut o.out, view("-"));
    for x in o.e0[p] - o.s0[p] - 1 {
        o.out.push(s[o.s0[p] + 1 + x]);
    }
    app(&mut o.out, view("-"));
    out_number(&mut o, 8 * (k + 1));
    app(&mut o.out, view("(%rbp)"));
}
// Turn the declared pairs into slot widths: 0 scalar, 1 first word, 2 second word. A pair whose
// second word would not be a frame slot cannot be modelled, so the function is copied unchanged
// rather than mis-lowered.
fn build_pairs<a>(o: (&a mut ir::Body), ns: u64) {
    exchange(&mut o.pair, u64[]);
    if o.dyn_pairs.len() == 0 {
        return ();
    }
    for i in ns {
        o.pair.push(0);
    }
    for i in o.dyn_pairs.len() {
        n := o.dyn_pairs[i];
        words := o.pair_widths[i];
        // Word j of the value is slot n - j: all of them must be frame slots of this body.
        if (0 < n) & (words - 1 <= n) & (n < ns) {
            ir::put(&mut o.pair, n, 1);
            for j in 1..words {
                ir::put(&mut o.pair, n - j, 2);
            }
        } else {
            exchange(&mut o.weird, 1);
        }
    }
}
// One parsed body: the typed IR layer first, then the serialisation if the caller asked for it,
// then the passes. The layer is built before the passes because the front end's type facts are
// keyed by the frame slot numbers the passes go on to compact
// (docs/design/typed-ir.md, "The serializer").
fn body<a, b, c, d, e>(o: (&a mut ir::Body), s: &b [u8], facts: (&c llvm::Facts), ix: (&d ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), replay: (&e ir::Replay), call_syms: (&mut u8[][]), call_counts: (&mut u64[])) {
    ir::build(&mut o, view(s), facts, ix);
    if want_ir != 0 {
        ir::write_body(&o, view(s), &mut ir_text);
    }
    // What the effect recorder's count is held against: the calls this body parses to, minus the
    // ones in a replayed `.proved` prologue, which the recorder counted where they were emitted.
    range := ir::replay_of(replay, view(o.name));
    call_syms.push(o.name.copy());
    call_counts.push(ir::count_calls(&o, range[0], range[1]));
    function(&mut o, view(s));
}
fn function<a, b>(o: (&a mut ir::Body), s: &b [u8]) {
    first := 0;
    last := o.op.len();
    ns := o.maxslot / 8 + 1;
    mut f = new_facts(ns);
    // Both words of a two-word value are opaque to the value passes: not promoted (bad), not
    // forwarded, and their stores are not dead - the handle names them, not the frame.
    build_pairs(&mut o, ns);
    if o.dyn_pairs.len() != 0 {
        for n in ns {
            if o.pair[n] != 0 {
                ir::put(&mut f.bad, n, 1);
            }
        }
    }
    // Frame shape: escaping slots, prologue position, label table and loop depth.
    mut prologue = 0;
    mut regs_used = 0;
    mut minlab = 0;
    mut maxlab = 0;
    for i in last {
        op := o.op[i];
        regs_used = regs_used
            | ir::mask_of(o.k0[i], o.v0[i], o.m0[i])
            | ir::mask_of(o.k1[i], o.v1[i], o.m1[i]);
        if op == 0 || op == 3 {
            if o.k0[i] == 2 {
                n := o.v0[i];
                ir::put(&mut f.bad, n / 8, 1);
            }
            if o.k1[i] == 2 {
                ir::put(&mut f.bad, o.v1[i] / 8, 1);
            }
        }
        if ((o.m0[i] >> 5) & 1) != 0 {
            if (op == 3) & (o.k0[i] == 4) & ir::at(view(s), o.s0[i], view("-.F")) {} else {
                exchange(&mut o.weird, 1);
            }
        }
        if ((o.m1[i] >> 5) & 1) != 0 {
            exchange(&mut o.weird, 1);
        }
        if (op == 5) & (prologue == 0) & (o.k1[i] == 1) & (o.v1[i] == 4) & (i == 4) {
            if ir::at(view(s), o.s0[i], view("$.F")) {
                prologue = i;
            }
        }
        if o.lab[i] != 0 {
            n := o.lab[i] - 1;
            if minlab == 0 {
                minlab = n + 1;
            } else {
                if n + 1 < minlab {
                    minlab = n + 1;
                }
            }
            if maxlab < n {
                maxlab = n;
            }
        }
        if op == 30 {
            mut p = i;
            mut prev = 0;
            while 0 < p {
                p -= 1;
                if (o.op[p] != 101) & (o.op[p] != 100) {
                    prev = o.op[p];
                    break;
                }
            }
            if prev != 29 {
                exchange(&mut o.weird, 1);
            }
        }
    }
    if o.weird != 0 {
        jump_stats(&mut o, last);
        for i in last {
            emit_line(&mut o, view(s), i);
        }
        return ();
    }
    o.table.clear();
    mut base = 0;
    if minlab != 0 {
        base = minlab - 1;
    }
    exchange(&mut o.base, base);
    mut refs = u64[];
    if minlab != 0 {
        for x in maxlab - base + 1 {
            o.table.push(0);
            refs.push(0);
        }
        for i in last {
            if o.lab[i] != 0 {
                ir::put(&mut o.table, o.lab[i] - 1 - base, i + 1);
            }
        }
        for i in last {
            for j in 2 {
                mut v = o.v0[i];
                if j != 0 {
                    v = o.v1[i];
                }
                mut k = o.k0[i];
                if j != 0 {
                    k = o.k1[i];
                }
                if (k == 4) & (v != 0) {
                    n := v - 1;
                    if n >= base {
                        if n - base < refs.len() {
                            ir::put(&mut refs, n - base, refs[n - base] + 1);
                        }
                    }
                }
            }
        }
    }
    jump_stats(&mut o, last);
    // `jcc L; call rt_abort; L:` is transparent: rt_abort never returns, so L is reached only
    // by the jump with the state that preceded it.
    for i in last {
        op := o.op[i];
        if (16 < op) & (op < 25) {
            t := jump_target(&o, i);
            if t < last {
                j := next_live(&o, i, last);
                if j < last {
                    if (o.op[j] == 15) & (o.k0[j] == 4) {
                        if ir::same_range(view(s), o.s0[j], o.e0[j], view("rt_abort")) {
                            if (o.lab[t] != 0)
                                & (next_live(&o, j, last) == t)
                                & (refs[o.lab[t] - 1 - base] == 1) {
                                ir::put(&mut o.tr, i, 1);
                                ir::put(&mut o.tr, j, 1);
                                ir::put(&mut o.tr, t, 1);
                            }
                        }
                    }
                }
            }
        }
    }
    forward(&mut o, &mut f, view(s), first, last);
    dead_stores(&mut o, &mut f, first, last);
    dead_defs(&mut o, view(s), first, last);
    // Promotion: weights grow 16x per loop nesting level (backward jumps), so a slot touched once
    // an iteration outweighs any handful of straight-line accesses - at 4x, a function's drop flags
    // (set, tested and cleared outside the loop) took the registers and the loop bound stayed in the
    // frame.
    mut chosen = u64[];
    mut slots = u64[];
    mut xchosen = u64[];
    mut xslots = u64[];
    mut xinit = u64[];
    if prologue != 0 {
        mut opens = u64[];
        mut closes = u64[];
        for i in last + 1 {
            opens.push(0);
            closes.push(0);
        }
        for i in last {
            op := o.op[i];
            if ir::is_jump(op) && op != 15 && o.del[i] == 0 {
                t := jump_target(&o, i);
                if t < i {
                    ir::put(&mut opens, t, opens[t] + 1);
                    ir::put(&mut closes, i + 1, closes[i + 1] + 1);
                }
            }
        }
        mut d = 0;
        for i in last {
            d += opens[i];
            d -= closes[i];
            if o.del[i] == 0 {
                mut w = 1;
                mut lv = d;
                if 4 < lv {
                    lv = 4;
                }
                while 0 < lv {
                    w = w * 16;
                    lv -= 1;
                }
                for j in 2 {
                    mut k = o.k0[i];
                    mut v = o.v0[i];
                    if j != 0 {
                        k = o.k1[i];
                        v = o.v1[i];
                    }
                    if k == 2 {
                        n := v / 8;
                        if f.bad[n] == 0 {
                            if promotable_use(&o, i) {
                                ir::put(&mut f.weight, n, f.weight[n] + w);
                            } else {
                                ir::put(&mut f.bad, n, 1);
                            }
                        }
                    }
                }
            }
        }
        xmm_choose(&o, view(s), &mut f, ns, prologue, &mut xchosen, &mut xslots, &mut xinit);
        free := u64[3, 12, 13, 14, 15];
        for r in free.len() {
            reg := free[r];
            if ((regs_used >> reg) & 1) == 0 {
                mut best = 0;
                mut bw = 3;
                for n in ns {
                    if (f.bad[n] == 0) & (f.weight[n] > bw) {
                        best = n;
                        bw = f.weight[n];
                    }
                }
                if best != 0 {
                    chosen.push(reg);
                    slots.push(best);
                    ir::put(&mut f.bad, best, 1);
                }
            }
        }
        // Which promoted slot each rewritten line reads (lsrc) and writes (ldst), +1: the f32
        // narrowing needs the slot behind a register that several slots share.
        mut lsrc = u64[];
        mut ldst = u64[];
        for i in last {
            lsrc.push(0);
            ldst.push(0);
        }
        if (chosen.len() != 0) || (xchosen.len() != 0) {
            for i in last {
                if o.del[i] == 0 {
                    for j in 2 {
                        mut k = o.k0[i];
                        mut v = o.v0[i];
                        if j != 0 {
                            k = o.k1[i];
                            v = o.v1[i];
                        }
                        if k == 2 {
                            for c in slots.len() {
                                if slots[c] * 8 == v {
                                    set_operand(&mut o, i, j, 1, chosen[c]);
                                }
                            }
                            for c in xslots.len() {
                                if xslots[c] * 8 == v {
                                    set_operand(&mut o, i, j, 7, xchosen[c]);
                                    if j == 0 {
                                        ir::put(&mut lsrc, i, xslots[c] + 1);
                                    } else {
                                        ir::put(&mut ldst, i, xslots[c] + 1);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            mut g = new_facts(ns);
            for n in ns {
                b := f.bad[n];
                ir::put(&mut g.bad, n, b);
            }
            forward(&mut o, &mut g, view(s), first, last);
            dead_defs(&mut o, view(s), first, last);
            if xchosen.len() != 0 {
                xmm_moves(&mut o, view(s), last, &mut lsrc);
                dead_defs(&mut o, view(s), first, last);
                xmm_narrow(&mut o, view(s), &lsrc, &ldst, &xslots, last);
            }
        }
    }
    peephole(&mut o, view(s), first, last);
    dead_defs(&mut o, view(s), first, last);
    newframe := compact(&mut o, view(s), prologue, ns);
    for i in last {
        if (newframe != 0) & (i + 1 == last) {
            app(&mut o.out, view(".set "));
            pa := o.s0[prologue] + 1;
            pe := o.e0[prologue];
            for x in pe - pa {
                o.out.push(s[pa + x]);
            }
            o.out.push(44);
            out_number(&mut o, newframe);
            o.out.push(10);
            continue;
        }
        if (chosen.len() != 0) & (o.op[i] == 29) & (o.del[i] == 0) {
            for c in chosen.len() {
                app(&mut o.out, view("movq "));
                emit_frame_slot(&mut o, view(s), prologue, c);
                app(&mut o.out, view(",%"));
                reg_name(&mut o, chosen[c]);
                o.out.push(10);
            }
        }
        if o.del[i] == 0 {
            emit_line(&mut o, view(s), i);
        }
        if (o.zline != 0) & (i + 1 == o.zline) {
            mut k = o.zfrom;
            while k < o.zto + 1 {
                app(&mut o.out, view("movq $0,-"));
                out_number(&mut o, k * 8);
                app(&mut o.out, view("(%rbp)\n"));
                k += 1;
            }
        }
        if (xinit.len() != 0) & (i == prologue) {
            for c in xinit.len() {
                app(&mut o.out, view("xorps %xmm"));
                out_number(&mut o, xinit[c]);
                app(&mut o.out, view(",%xmm"));
                out_number(&mut o, xinit[c]);
                o.out.push(10);
            }
        }
        if (chosen.len() != 0) & (i == prologue) {
            app(&mut o.out, view("subq $"));
            out_number(&mut o, 16 * ((chosen.len() + 1) / 2));
            app(&mut o.out, view(",%rsp\n"));
            for c in chosen.len() {
                app(&mut o.out, view("movq %"));
                reg_name(&mut o, chosen[c]);
                o.out.push(44);
                emit_frame_slot(&mut o, view(s), prologue, c);
                o.out.push(10);
            }
            for c in chosen.len() {
                app(&mut o.out, view("movq $0,%"));
                reg_name(&mut o, chosen[c]);
                o.out.push(10);
            }
        }
    }
    if (prologue != 0) & (chosen.len() == 0) & (xchosen.len() == 0) & (o.zline != 0) {
        inline_candidate(&mut o, view(s), prologue);
    }
}
// Whether an operand's text is an SSE register: `%xmm<n>`.
fn is_xmm_text<b>(s: &b [u8], a: u64, e: u64) -> bool {
    return (e - a > 4) && ir::at(view(s), a, view("%xmm"));
}
// A runtime entry a call does not come back from: nothing after the call is reached, so nothing is
// live across it (llvm.grl `never_returns`, plus `rt_abort`).
fn never_returns<a, b>(o: (&a ir::Body), s: &b [u8], i: u64) -> bool {
    if o.k0[i] != 4 {
        return false;
    }
    a := o.s0[i];
    e := o.e0[i];
    return ir::same_range(view(s), a, e, view("rt_abort")) || ir::same_range(view(s), a, e, view("rt_fail"))
        || ir::same_range(view(s), a, e, view("rt_trap")) || ir::same_range(view(s), a, e, view("rt_refine"))
        || ir::same_range(view(s), a, e, view("rt_task_fail")) || ir::same_range(view(s), a, e, view("rt_fail_text"))
        || ir::same_range(view(s), a, e, view("rt_report_die")) || ir::same_range(view(s), a, e, view("rt_abort_final"))
        || ir::same_range(view(s), a, e, view("rt_abort_park")) || ir::same_range(view(s), a, e, view("rt_hard_exit"))
        || ir::same_range(view(s), a, e, view("rt_stack_overflow"))
        || ir::same_range(view(s), a, e, view("rt_stack_overflow_at"));
}
// One backward pass of the candidates' liveness (bit c for candidate slot cands[c]) over the label
// graph, as live_pass does for registers. `out[0]` collects the candidates live across a call that
// returns - the SSE registers are all caller-saved, so those cannot be held in one - and `out[1]`
// the ones live just after the prologue, which start as the cleared frame's 0. A non-empty
// `interf` collects, per candidate, the candidates live at the same time as it.
fn xmm_live<a, b>(o: (&a ir::Body), s: &b [u8], cands: (&u64[]), lin: (&mut u64[]), prologue: u64, out: (&mut u64[]), interf: (&mut u64[])) -> u64 {
    last := o.op.len();
    all := (1 << cands.len()) - 1;
    mut live = 0;
    mut changed = 0;
    mut i = last;
    while 0 < i {
        i -= 1;
        if i == prologue {
            ir::put(&mut out, 1, live);
        }
        if (o.del[i] != 0) || (o.tr[i] != 0) {
            continue;
        }
        op := o.op[i];
        if op == 101 {
            continue;
        }
        if op == 100 {
            if lin[i] != live {
                ir::put(&mut lin, i, live);
                changed = 1;
            }
            continue;
        }
        if ir::is_jump(op) && (op != 15) {
            t := jump_target(&o, i);
            mut there = all;
            if t < last {
                there = lin[t];
            }
            if op == 16 {
                live = there;
            } else {
                live = live | there;
            }
            continue;
        }
        if (op == 29) || (op == 30) {
            live = 0;
            continue;
        }
        if op == 15 {
            if never_returns(&o, view(s), i) {
                live = 0;
            } else {
                was := out[0];
                ir::put(&mut out, 0, was | live);
            }
            continue;
        }
        if (op == 45) || (op == 46) {
            was := out[0];
            ir::put(&mut out, 0, was | live);
            continue;
        }
        // `live` is what is live after this line. Every candidate in it, and one written here, cannot
        // share a register with the others in it.
        if interf.len() != 0 {
            for c in cands.len() {
                at := cands[c] * 8;
                written := (o.k1[i] == 2) && (o.v1[i] == at) && ir::movelike(op);
                if written || (((live >> c) & 1) != 0) {
                    was := interf[c];
                    ir::put(&mut interf, c, was | live);
                }
            }
        }
        for c in cands.len() {
            at := cands[c] * 8;
            if (o.k1[i] == 2) && (o.v1[i] == at) && ir::movelike(op) {
                live = live & (all - (1 << c));
            }
            if (o.k0[i] == 2) && (o.v0[i] == at) {
                live = live | (1 << c);
            }
        }
    }
    return changed;
}
// Frame slots that hold floats, kept in SSE registers instead (xmm8..xmm14; xmm5 and xmm15 are the
// foreign-call sequences' scratch). A slot qualifies when every access is a plain `movq` between it
// and a general register - so the same `movq` with %xmmK in its place is the same 64 bits - when it
// carries float traffic (stored from `movq %xmmN,%R`, or loaded into a register that goes on to
// `movq %R,%xmmN`), and when it is not live across a call that returns. `regs`/`slots` receive the
// choice; `init` the registers to clear after the prologue (a slot read before any write reads the
// cleared frame's 0).
fn xmm_choose<a, b, c>(o: (&a ir::Body), s: &b [u8], f: (&c mut F), ns: u64, prologue: u64, regs: (&mut u64[]), slots: (&mut u64[]), init: (&mut u64[])) {
    last := o.op.len();
    mut ok = u64[];
    mut fl = u64[];
    for n in ns {
        ok.push(1);
        fl.push(0);
    }
    for i in last {
        if (o.del[i] != 0) || (o.op[i] == 101) || (o.op[i] == 100) {
            continue;
        }
        op := o.op[i];
        for j in 2 {
            mut k = o.k0[i];
            mut a = o.s0[i];
            mut e = o.e0[i];
            mut v = o.v0[i];
            mut other = o.k1[i];
            if j != 0 {
                k = o.k1[i];
                a = o.s1[i];
                e = o.e1[i];
                v = o.v1[i];
                other = o.k0[i];
            }
            // A body that names the registers this would use is left as it is.
            if (k == 6) && is_xmm_text(view(s), a, e) {
                if (e - a == 6) || (s[a + 4] > 55) {
                    return ();
                }
            }
            if (k == 2) && (v / 8 < ns) {
                if (op != 1) || (other != 1) {
                    ir::put(&mut ok, v / 8, 0);
                }
            }
        }
        // Float traffic.
        if (op == 1) && (o.k1[i] == 2) && (o.k0[i] == 1) {
            mut p = i;
            while 0 < p {
                p -= 1;
                if (o.del[p] == 0) && (o.op[p] != 101) {
                    break;
                }
            }
            if (p < i) && (o.op[p] == 1) && (o.k1[p] == 1) && (o.v1[p] == o.v0[i]) && (o.k0[p] == 6)
                && is_xmm_text(view(s), o.s0[p], o.e0[p]) {
                ir::put(&mut fl, o.v1[i] / 8, 1);
            }
        }
        if (op == 1) && (o.k0[i] == 2) && (o.k1[i] == 1) {
            r := o.v1[i];
            mut j = i;
            for step in 4 {
                j = next_insn(&o, j, last);
                if j >= last {
                    break;
                }
                if (o.op[j] == 1) && (o.k0[j] == 1) && (o.v0[j] == r) && (o.k1[j] == 6)
                    && is_xmm_text(view(s), o.s1[j], o.e1[j]) {
                    ir::put(&mut fl, o.v0[i] / 8, 1);
                    break;
                }
                if (ir::is_jump(o.op[j])) || ((((ir::reads(&o, j) | ir::writes(&o, j)) >> r) & 1) != 0) {
                    break;
                }
            }
        }
    }
    // The heaviest candidates, at most 16 (one bit each in the liveness pass).
    mut cands = u64[];
    mut taken = u64[];
    for n in ns {
        taken.push(0);
    }
    while cands.len() < 63 {
        mut best = 0;
        mut bw = 3;
        for n in ns {
            if (taken[n] == 0) && (f.bad[n] == 0) && (ok[n] != 0) && (fl[n] != 0) && (f.weight[n] > bw) {
                best = n;
                bw = f.weight[n];
            }
        }
        if best == 0 {
            break;
        }
        ir::put(&mut taken, best, 1);
        cands.push(best);
    }
    if cands.len() == 0 {
        return ();
    }
    mut lin = u64[];
    for i in last {
        lin.push(0);
    }
    mut out = u64[0, 0];
    mut none = u64[];
    mut rounds = 0;
    while rounds < 50 {
        rounds += 1;
        if xmm_live(&o, view(s), &cands, &mut lin, prologue, &mut out, &mut none) == 0 {
            break;
        }
    }
    if rounds == 50 {
        return ();
    }
    ir::put(&mut out, 0, 0);
    mut interf = u64[];
    for c in cands.len() {
        interf.push(0);
    }
    xmm_live(&o, view(s), &cands, &mut lin, prologue, &mut out, &mut interf);
    // Heaviest first, each into the lowest of the seven registers no interfering candidate holds:
    // slots whose lives do not overlap share one.
    mut color = u64[];
    for c in cands.len() {
        color.push(0);
    }
    mut inited = 0;
    for c in cands.len() {
        if ((out[0] >> c) & 1) != 0 {
            continue;
        }
        mut used = 0;
        for d in c {
            if (color[d] != 0) && (((interf[c] >> d) & 1) != 0) {
                used = used | (1 << (color[d] - 1));
            }
        }
        mut k = 0;
        while (k < 7) && (((used >> k) & 1) != 0) {
            k += 1;
        }
        if k < 7 {
            ir::put(&mut color, c, k + 1);
            reg := 8 + k;
            regs.push(reg);
            slots.push(cands[c]);
            ir::put(&mut f.bad, cands[c], 1);
            if (((out[1] >> c) & 1) != 0) && (((inited >> k) & 1) == 0) {
                inited = inited | (1 << k);
                init.push(reg);
            }
        }
    }
}
// `movq %X,%R ... movq %R,%xmmN` with X an SSE register is `movaps %X,%xmmN`: the general register was
// only a way between two SSE ones. The first move stays for dead_defs to remove when R is dead.
// X promoted (kind 7) may be some lines back, provided nothing between writes R or X; a parsed SSE
// register (kind 6) is tracked by nobody, so its move must be the line just before.
fn xmm_moves<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64, lsrc: (&mut u64[])) {
    for j in last {
        if (o.del[j] != 0) || (o.op[j] != 1) || (o.k0[j] != 1) {
            continue;
        }
        if !((o.k1[j] == 7) || ((o.k1[j] == 6) && is_xmm_text(view(s), o.s1[j], o.e1[j]))) {
            continue;
        }
        r := o.v0[j];
        mut p = j;
        mut steps = 0;
        mut found = last;
        while (0 < p) && (steps < 6) {
            p -= 1;
            if (o.del[p] != 0) || (o.op[p] == 101) {
                continue;
            }
            steps += 1;
            op := o.op[p];
            if (op == 100) || (op == 0) || (op == 15) || ir::is_jump(op) {
                break;
            }
            if (((ir::writes(&o, p) >> r) & 1) != 0) {
                if (op == 1) && (o.k1[p] == 1) && (o.v1[p] == r) {
                    if (o.k0[p] == 7) || ((o.k0[p] == 6) && (steps == 1) && is_xmm_text(view(s), o.s0[p], o.e0[p])) {
                        found = p;
                    }
                }
                break;
            }
        }
        if found < last {
            // Nothing between writes the promoted source.
            mut clean = true;
            if o.k0[found] == 7 {
                mut x = found + 1;
                while x < j {
                    if (o.del[x] == 0) && (o.k1[x] == 7) && (o.v1[x] == o.v0[found]) {
                        clean = false;
                    }
                    x += 1;
                }
            }
            if clean {
                // j now reads what `found` read.
                was := lsrc[found];
                ir::put(&mut lsrc, j, was);
                ir::put(&mut o.op, j, 68);
                set_operand(&mut o, j, 0, o.k0[found], o.v0[found]);
                set_range(&mut o, j, 0, o.s0[found], o.e0[found]);
            }
        }
    }
}
// Operand j of line i is the parsed SSE register written s[a..e].
fn xmm_is<a, b>(o: (&a ir::Body), s: &b [u8], i: u64, j: u64, a: u64, e: u64) -> bool {
    if j == 0 {
        return (o.k0[i] == 6) && ir::same_range(view(s), o.s0[i], o.e0[i], view(s[a: e]));
    }
    return (o.k1[i] == 6) && ir::same_range(view(s), o.s1[i], o.e1[i], view(s[a: e]));
}
// Whether the scratch SSE register written s[a..e] is dead after line i: the next mention in the
// block overwrites it whole, followed through at most `depth` jumps. A label, an unfollowed jump, a
// call that returns or an unknown instruction first counts as a use.
fn xmm_dead_after<a, b>(o: (&a ir::Body), s: &b [u8], i: u64, a: u64, e: u64, depth: u64) -> bool {
    last := o.op.len();
    if depth == 0 {
        return false;
    }
    mut j = i;
    for step in 12 {
        j = next_live(&o, j, last);
        if j >= last {
            return false;
        }
        op := o.op[j];
        // Past a runtime exit nothing is read; a bounds check's failure arm is one.
        if (op == 15) && never_returns(&o, view(s), j) {
            return true;
        }
        if (op == 16 || ((16 < op) && (op < 25))) && (o.k0[j] == 4) {
            // A check's conditional jump around its exit: the register must be dead at the target too.
            t := jump_target(&o, j);
            if (t >= last) || !xmm_dead_after(&o, view(s), t, a, e, depth - 1) {
                return false;
            }
            if op == 16 {
                return true;
            }
            continue;
        }
        if (op == 100) || (op == 0) || (op == 15) || (op == 29) || (op == 30) || ir::is_jump(op) {
            return false;
        }
        if xmm_is(&o, view(s), j, 0, a, e) {
            return false;
        }
        if xmm_is(&o, view(s), j, 1, a, e) {
            // Whole-register writes; the arithmetic and the compare read their destination too.
            return (op == 1) || (op == 68) || (op == 70) || (op == 71) || (op == 65) || (op == 66);
        }
    }
    return false;
}
// f32 values in binary32 (P2). A promoted slot is narrow when every store into it is a value just
// made by `cvtss2sd` (so binary32-exact) or zero, and every load is a `movaps` into a scratch
// register. It then holds the binary32 value: a store copies it before the widening, and a load
// feeds either an operation narrowed with it - `OPsd; cvtsd2ss; cvtss2sd` over two narrow loads is
// `OPss; cvtss2sd`, exact for + - * / and sqrt since 53 >= 2*24 + 2 (the argument llvm.grl's lifter
// makes) - or is widened by a `cvtss2sd` in the `movaps`'s place.
// The position in `xslots` of the slot recorded as n + 1 (xslots.len() when absent).
fn slot_index(xslots: (&u64[]), tag: u64) -> u64 {
    mut c = 0;
    while (c < xslots.len()) && (xslots[c] + 1 != tag) {
        c += 1;
    }
    return c;
}
fn xmm_narrow<a, b>(o: (&a mut ir::Body), s: &b [u8], lsrc: (&u64[]), ldst: (&u64[]), xslots: (&u64[]), last: u64) {
    mut ok = u64[];
    for c in xslots.len() {
        ok.push(1);
    }
    for i in last {
        if o.del[i] != 0 {
            continue;
        }
        op := o.op[i];
        if ldst[i] != 0 {
            c := slot_index(xslots, ldst[i]);
            mut p = i;
            while 0 < p {
                p -= 1;
                if (o.del[p] == 0) && (o.op[p] != 101) {
                    break;
                }
            }
            mut good = false;
            if (op == 68) && (o.k0[i] == 6) && (p < i) && (o.op[p] == 65) && (o.k0[p] == 6)
                && xmm_is(&o, view(s), p, 1, o.s0[i], o.e0[i]) && xmm_is(&o, view(s), p, 0, o.s0[i], o.e0[i]) {
                good = true;
            }
            if (op == 1) && (o.k0[i] == 1) && (p < i) && (o.k1[p] == 1) && (o.v1[p] == o.v0[i]) {
                if ((o.op[p] == 1) || (o.op[p] == 2)) && (o.k0[p] == 3) && (imm_value(&o, view(s), p) == 0) {
                    good = true;
                }
                if (o.op[p] == 10) && (o.k0[p] == 1) && (o.v0[p] == o.v0[i]) {
                    good = true;
                }
            }
            if !good && (c < ok.len()) {
                ir::put(&mut ok, c, 0);
            }
        }
        if lsrc[i] != 0 {
            c := slot_index(xslots, lsrc[i]);
            if !((op == 68) && (o.k0[i] == 7) && (o.k1[i] == 6)) && (c < ok.len()) {
                ir::put(&mut ok, c, 0);
            }
        }
    }
    mut any = false;
    for c in xslots.len() {
        if ok[c] != 0 {
            any = true;
        }
    }
    if !any {
        return ();
    }
    // Narrow loads, each with the line that consumes its scratch register (last: none usable).
    mut loads = u64[];
    mut uses = u64[];
    for i in last {
        if (o.del[i] != 0) || (lsrc[i] == 0) || (o.op[i] != 68) || (o.k0[i] != 7) {
            continue;
        }
        c := slot_index(xslots, lsrc[i]);
        if (c == xslots.len()) || (ok[c] == 0) {
            continue;
        }
        a := o.s1[i];
        e := o.e1[i];
        mut user = last;
        mut j = i;
        for step in 8 {
            j = next_live(&o, j, last);
            if j >= last {
                break;
            }
            op := o.op[j];
            if (op == 100) || (op == 0) || (op == 15) || ir::is_jump(op) {
                break;
            }
            if xmm_is(&o, view(s), j, 0, a, e) || xmm_is(&o, view(s), j, 1, a, e) {
                user = j;
                break;
            }
        }
        loads.push(i);
        uses.push(user);
    }
    // Each consumer: an f32 rounding of the loaded value is already done; an operation is narrowed
    // when every operand it reads comes from a narrow load and its result is rounded to f32 at once.
    mut narrowed = u64[];
    for x in loads.len() {
        narrowed.push(0);
    }
    for x in loads.len() {
        u := uses[x];
        if (u == last) || (narrowed[x] != 0) {
            continue;
        }
        op := o.op[u];
        if (op == 66) && xmm_is(&o, view(s), u, 0, o.s1[loads[x]], o.e1[loads[x]])
            && xmm_is(&o, view(s), u, 1, o.s1[loads[x]], o.e1[loads[x]]) {
            kill(&mut o, u);
            ir::put(&mut narrowed, x, 1);
            continue;
        }
        if (59 < op) && (op < 65) && (o.k0[u] == 6) && (o.k1[u] == 6) {
            // The operands: both from narrow loads consumed here.
            mut both = true;
            mut mine = u64[];
            for j in 2 {
                mut a = o.s0[u];
                mut e = o.e0[u];
                if j != 0 {
                    a = o.s1[u];
                    e = o.e1[u];
                }
                mut found = loads.len();
                for y in loads.len() {
                    if (uses[y] == u) && ir::same_range(view(s), o.s1[loads[y]], o.e1[loads[y]], view(s[a: e])) {
                        found = y;
                    }
                }
                if found == loads.len() {
                    both = false;
                } else {
                    mine.push(found);
                }
            }
            r1 := next_live(&o, u, last);
            mut r2 = last;
            if r1 < last {
                r2 = next_live(&o, r1, last);
            }
            if both && (r2 < last) && (o.op[r1] == 66) && (o.op[r2] == 65)
                && xmm_is(&o, view(s), r1, 0, o.s1[u], o.e1[u]) && xmm_is(&o, view(s), r1, 1, o.s1[u], o.e1[u])
                && xmm_is(&o, view(s), r2, 0, o.s1[u], o.e1[u]) && xmm_is(&o, view(s), r2, 1, o.s1[u], o.e1[u]) {
                ir::put(&mut o.op, u, op + 12);
                ir::put(&mut o.chg, u, 1);
                kill(&mut o, r1);
                for m in mine.len() {
                    ir::put(&mut narrowed, mine[m], 1);
                }
            }
        }
    }
    // Every other narrow load widens.
    for x in loads.len() {
        if narrowed[x] == 0 {
            ir::put(&mut o.op, loads[x], 65);
            ir::put(&mut o.chg, loads[x], 1);
        }
    }
    // Narrow stores copy the binary32 value: `cvtss2sd %xmmN,%xmmN; movaps %xmmN,%xmmK` becomes
    // `movaps %xmmN,%xmmK; cvtss2sd %xmmN,%xmmN`, and the widening goes when nothing reads it.
    for i in last {
        if (o.del[i] != 0) || (ldst[i] == 0) || (o.op[i] != 68) || (o.k1[i] != 7) || (o.k0[i] != 6) {
            continue;
        }
        c := slot_index(xslots, ldst[i]);
        if (c == xslots.len()) || (ok[c] == 0) {
            continue;
        }
        mut p = i;
        while 0 < p {
            p -= 1;
            if (o.del[p] == 0) && (o.op[p] != 101) {
                break;
            }
        }
        k := o.v1[i];
        a := o.s0[i];
        e := o.e0[i];
        ir::put(&mut o.op, p, 68);
        set_operand(&mut o, p, 1, 7, k);
        ir::put(&mut o.op, i, 65);
        set_operand(&mut o, i, 0, 6, 0);
        set_range(&mut o, i, 0, a, e);
        set_operand(&mut o, i, 1, 6, 0);
        set_range(&mut o, i, 1, a, e);
        if xmm_dead_after(&o, view(s), i, a, e, 3) {
            kill(&mut o, i);
        }
    }
}
fn name_hash<b>(s: &b [u8], a: u64, e: u64) -> u64 {
    mut h = 0;
    for i in e - a {
        h = (h * 31 + s[a + i]) % 4093;
    }
    return h;
}
// A small leaf (no calls but rt_abort, no callee-saved registers, small cleared frame) gets a
// frameless copy of its body: slots move to free scratch registers, returns jump to the end.
// Calls to it are replaced by that body after all functions are optimized.
fn inline_candidate<a, b>(o: (&a mut ir::Body), s: &b [u8], prologue: u64) {
    if o.dyn_pairs.len() != 0 {
        return ();
    }
    last := o.op.len();
    mut count = 0;
    mut used = 0;
    // rbx, rsp, rbp (outside slots) and r12..r15 must not appear.
    forbidden := 8 + 16 + 32 + 4096 + 8192 + 16384 + 32768;
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            op := o.op[i];
            if op == 101 {
                if i + 1 != last {
                    return ();
                }
            } else {
                if op != 100 {
                    count += 1;
                    if 24 < count {
                        return ();
                    }
                    if op == 0 || op == 31 || op == 32 || op == 45 || op == 46 {
                        return ();
                    }
                    // A slot used where a register cannot stand - its address taken (`leaq -8(%rbp)`,
                    // rt_frame) - stays a slot, so the body is not a copy with slots in registers.
                    if ((o.k0[i] == 2) || (o.k1[i] == 2)) && !promotable_use(&o, i) {
                        return ();
                    }
                    if op == 15 {
                        if o.k0[i] != 4 {
                            return ();
                        }
                        if !ir::same_range(view(s), o.s0[i], o.e0[i], view("rt_abort")) {
                            return ();
                        }
                    }
                    m := ir::mask_of(o.k0[i], o.v0[i], o.m0[i]) | ir::mask_of(o.k1[i], o.v1[i], o.m1[i]);
                    if (m & forbidden) != 0 {
                        return ();
                    }
                    used = used | m;
                }
            }
        }
    }
    // Map every slot in the body to a free caller-saved register.
    free := u64[8, 9, 10, 11, 2, 1, 6, 7];
    mut slots = u64[];
    mut regs = u64[];
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            for j in 2 {
                mut k = o.k0[i];
                mut v = o.v0[i];
                if j != 0 {
                    k = o.k1[i];
                    v = o.v1[i];
                }
                if k == 2 {
                    mut known = 0;
                    for x in slots.len() {
                        if slots[x] == v {
                            known = 1;
                        }
                    }
                    if known == 0 {
                        mut pick = 99;
                        for f in free.len() {
                            r := free[f];
                            mut taken = (used >> r) & 1;
                            for y in regs.len() {
                                if regs[y] == r {
                                    taken = 1;
                                }
                            }
                            if (taken == 0) & (pick == 99) {
                                pick = r;
                            }
                        }
                        if pick == 99 {
                            return ();
                        }
                        slots.push(v);
                        regs.push(pick);
                    }
                }
            }
        }
    }
    for i in last {
        if (prologue < i) & (o.del[i] == 0) {
            for j in 2 {
                mut k = o.k0[i];
                mut v = o.v0[i];
                if j != 0 {
                    k = o.k1[i];
                    v = o.v1[i];
                }
                if k == 2 {
                    for x in slots.len() {
                        if slots[x] == v {
                            r := regs[x];
                            set_operand(&mut o, i, j, 1, r);
                        }
                    }
                }
            }
        }
    }
    mark := o.out.len();
    // Cleared (non-parameter) slots start at zero, as the frame zeroing guaranteed.
    for x in slots.len() {
        if o.zfrom * 8 < slots[x] + 1 {
            app(&mut o.out, view("movq $0,%"));
            reg_name(&mut o, regs[x]);
            o.out.push(10);
        }
    }
    for i in last {
        if (prologue < i) & (o.del[i] == 0) & (i + 1 != last) {
            op := o.op[i];
            if op == 30 {
                app(&mut o.out, view("jmp .Lret\n"));
            } else {
                if op != 29 {
                    emit_line(&mut o, view(s), i);
                }
            }
        }
    }
    app(&mut o.out, view(".Lret:\n"));
    mut body = u8[];
    for x in o.out.len() - mark {
        c := o.out[mark + x];
        body.push(c);
    }
    while mark < o.out.len() {
        o.out.pop()!;
    }
    na := o.ls[1];
    ne := o.le[1] - 1;
    mut name = u8[];
    for x in ne - na {
        name.push(s[na + x]);
    }
    unit := o.unit.copy();
    // Filed with its positions made absolute (the copy will stand in other functions); the copy as
    // written is what one_body remembers, since that one does not depend on where the function is.
    absolute := ir::absolute_positions(view(body), o.gbase);
    exchange(&mut o.inl_rel, body);
    inl_file(&mut o, name, absolute, unit);
}
// Where the lines the inlining pass reads start, in `text[from..]`: a `call` and a unit marker.
// Offsets are from the start of `text`.
fn lines_of_interest<a, b>(text: &a [u8], from: u64, out: (&b mut u64[])) {
    mut start = from;
    mut i = from;
    n := text.len();
    while i < n {
        if text[i] == 10 {
            a := start;
            start = i + 1;
            if i - a > 5 {
                first := text[a];
                if (first == 99) && ir::at(view(text), a, view("call ")) {
                    out.push(a);
                } else if (first == 46) && (i - a > 12) && ir::at(view(text), a, view(".grail_part ")) {
                    out.push(a);
                }
            }
        }
        i += 1;
    }
}
// Replaces `call NAME` lines for inlinable functions by their bodies with per-site labels.
// Inlining rewrites the output, so the `--split` marker offsets recorded on the way through are
// rewritten with it: markers are copied in stream order, and each one takes its new offset here.
fn inline_calls<a, b>(o: (&a mut ir::Body), split: u64, marks: (&a mut u64[]), lines: (&b u64[])) {
    text := exchange(&mut o.out, u8[]);
    mut start = 0;
    // Text is copied in runs: `pend` is where the lines not yet written begin, and they are written
    // in one piece when a line is replaced or dropped, when a marker needs the output's length,
    // and at the end.
    mut pend = 0;
    mut site = 0;
    mut next = 0;
    mut unit = u8[];
    mut uprefix = u8[];
    // Only the lines that can matter are visited: the calls and the unit markers, whose offsets
    // were noted when the text was made (lines_of_interest). Everything between is copied.
    for at in lines.len() {
        {
            a := lines[at];
            mut e = a;
            while (e < text.len()) && (text[e] != 10) {
                e += 1;
            }
            start = e + 1;
            mut done = 0;
            if (e - a > 5) & (text[a] == 99) {
                if ir::at(view(text), a, view("call ")) {
                    h := name_hash(view(text), a + 5, e);
                    mut k = o.inl_head[h];
                    while k != 0 {
                        n := &o.inl_names[k - 1];
                        // Only a body this unit emits: inlining across a module boundary would make
                        // the caller's text a function of a body its own module never declares, and
                        // a module compiled alone has no other module's bodies anyway.
                        mut here = 1;
                        u := &unit;
                        ul := u.len();
                        if ul != 0 {
                            // `same` is this module's slice-vs-token comparison: whole, so 0..len.
                            if !ir::same_range(view(o.inl_units[k - 1]), 0, ul, view(u)) {
                                here = 0;
                            }
                        }
                        if (here != 0) & ir::same_range(view(text), a + 5, e, view(n)) {
                            site += 1;
                            o.out.append(text[pend..a]);
                            pend = start;
                            emit_body(&mut o, k - 1, site, view(uprefix));
                            done = 1;
                            break;
                        }
                        k = o.inl_next[k - 1];
                    }
                }
            }
            if done == 0 {
                if (e - a > 12) & (text[a] == 46) & ir::at(view(text), a, view(".grail_part ")) {
                    mut fresh = u8[];
                    mut at = a + 12;
                    while (at < e) & (text[at] != 32) {
                        fresh.push(text[at]);
                        at += 1;
                    }
                    exchange(&mut unit, fresh);
                    mut fresh_prefix = u8[];
                    at += 1;
                    while at < e {
                        fresh_prefix.push(text[at]);
                        at += 1;
                    }
                    exchange(&mut uprefix, fresh_prefix);
                    // A unit starts its own inline-site numbers, so one unit's text does not depend
                    // on how many sites the units before it expanded.
                    site = 0;
                    o.out.append(text[pend..a]);
                    pend = a;
                    if split != 0 {
                        if next < marks.len() {
                            exchange(&mut marks[next], o.out.len());
                            next += 1;
                        }
                    } else {
                        // A single-file build keeps no markers: they are the splitter's, and the
                        // units they name exist only for the optimizer's own decisions.
                        pend = start;
                        done = 1;
                    }
                }
            }
        }
    }
    o.out.append(text[pend..text.len()]);
}
// `_i<unit prefix>_<site>` on every `.L` in the body: the site number disambiguates two copies of
// one body, and the unit prefix keeps a body label without a prefix of its own (`.Lret`) apart from
// the same label minted by another unit of the same file.
fn emit_body<a, b>(o: (&a mut ir::Body), k: u64, site: u64, prefix: &b [u8]) {
    body := o.inl_bodies[k].copy();
    mut i = 0;
    n := body.len();
    while i < n {
        c := body[i];
        mut label = 0;
        if (c == 46) & (i + 1 < n) {
            if body[i + 1] == 76 {
                if i == 0 {
                    label = 1;
                } else {
                    p := body[i - 1];
                    if !ir::alnum(p) && p != 95 {
                        label = 1;
                    }
                }
            }
        }
        if label != 0 {
            while i < n {
                d := body[i];
                if !(ir::alnum(d) || d == 95 || d == 46) {
                    break;
                }
                o.out.push(d);
                i += 1;
            }
            app(&mut o.out, view("_i"));
            app(&mut o.out, view(prefix));
            o.out.push(95);
            out_number(&mut o, site);
        } else {
            o.out.push(c);
            i += 1;
        }
    }
}
// Renumber the slots still referenced into a dense frame (parameters keep the top slots), so
// the entry zeroing only clears live storage. Returns the new frame size, or 0 if unchanged.
fn compact<a, b>(o: (&a mut ir::Body), s: &b [u8], prologue: u64, ns: u64) -> u64 {
    if prologue == 0 {
        return 0;
    }
    last := o.op.len();
    // Parameter count from the zeroing count `movq $.FN/8-P,%rcx`.
    mut params = ns;
    for i in last {
        if (o.op[i] == 1) & (o.k0[i] == 3) & (o.k1[i] == 1) & (o.v1[i] == 1) & (params == ns) {
            a := o.s0[i];
            e := o.e0[i];
            if (e - a > 4) & (s[a + 1] == 46) {
                mut j = e;
                while a < j {
                    if s[j - 1] == 45 {
                        break;
                    }
                    j -= 1;
                }
                if a < j {
                    mut n = 0;
                    mut ok = 1;
                    for x in e - j {
                        d := s[j + x];
                        if d < 48 || 57 < d {
                            ok = 0;
                        } else {
                            n = n * 10 + d - 48;
                        }
                    }
                    if ok != 0 {
                        params = n;
                    }
                }
            }
        }
    }
    if params >= ns {
        return 0;
    }
    mut map = u64[];
    for n in ns {
        map.push(0);
    }
    for n in params + 1 {
        ir::put(&mut map, n, 1);
    }
    for i in last {
        if o.del[i] == 0 {
            if o.k0[i] == 2 {
                ir::put(&mut map, o.v0[i] / 8, 1);
            }
            if o.k1[i] == 2 {
                ir::put(&mut map, o.v1[i] / 8, 1);
            }
        }
    }
    // A two-word value keeps both slots whether or not each has a direct reader, and slots are
    // renumbered in ascending order, so its words stay adjacent and in order: word 1 keeps the slot
    // above word 0, where `8(%handle)` finds it.
    if o.pair.len() != 0 {
        for n in ns {
            if o.pair[n] != 0 {
                ir::put(&mut map, n, 1);
            }
        }
    }
    mut used = 0;
    for n in ns {
        if n != 0 {
            if map[n] != 0 {
                used += 1;
                ir::put(&mut map, n, used);
            }
        }
    }
    // A small frame is cleared with direct stores instead of `rep stosq` (leaq/movq/xorl/rep).
    words := (used * 8 + 15) / 16 * 16 / 8;
    exchange(&mut o.zline, 0);
    if words < params + 17 {
        for i in last {
            if (o.op[i] == 3) & (o.k1[i] == 1) & (o.v1[i] == 7) & (o.k0[i] == 4) {
                if ir::at(view(s), o.s0[i], view("-.F")) {
                    a := next_live(&o, i, last);
                    if a < last {
                        b := next_live(&o, a, last);
                        if b < last {
                            d := next_live(&o, b, last);
                            if d < last {
                                if (o.op[a] == 1)
                                    & (o.k1[a] == 1)
                                    & (o.v1[a] == 1)
                                    & (o.op[b] == 0)
                                    & (o.op[d] == 0)
                                    & ir::same_range(view(s), o.ls[d], o.le[d], view("rep stosq"))
                                    & ir::same_range(view(s), o.ls[b], o.le[b], view("xorl %eax,%eax")) {
                                    kill(&mut o, i);
                                    kill(&mut o, a);
                                    kill(&mut o, b);
                                    kill(&mut o, d);
                                    exchange(&mut o.zline, d + 1);
                                    exchange(&mut o.zfrom, params + 1);
                                    exchange(&mut o.zto, words);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    for i in last {
        if o.del[i] == 0 {
            if o.k0[i] == 2 {
                set_operand(&mut o, i, 0, 2, map[o.v0[i] / 8] * 8);
            }
            if o.k1[i] == 2 {
                set_operand(&mut o, i, 1, 2, map[o.v1[i] / 8] * 8);
            }
        }
    }
    return (used * 8 + 15) / 16 * 16;
}
pub fn optimize<b, c, d, m, q, r>(s: &b [u8], facts: (&c llvm::Facts), want_ir: u64, ir_text: (&mut u8[]), replay: (&d ir::Replay), call_syms: (&mut u8[][]), call_counts: (&mut u64[]), memo_dir: &m [u8], memo_id: &m [u8], starts: (&q u64[]), known: (&r ir::Known)) -> u8[] {
    mut marks = u64[];
    mut names = u8[][];
    return optimize_parts(view(s), 0, &mut marks, &mut names, facts, want_ir, ir_text, replay, call_syms, call_counts, memo_dir, memo_id, starts, known);
}
// `optimize` plus the positions of the `--split` module markers it kept: for each marker line, the
// output offset of the line and the module name it carries. A single-file build passes `split` 0 and
// pays nothing. `native.grl` splits at these offsets, so the stream never has to be scanned again.
// `starts`: where the emitter wrote the lines the cut planning reads (plan_from) - a body's `.type`
// line, a part's marker, a function's `.gbase` - so it does not scan the stream for them. Possibly
// stale (the emitter takes text back on a retry) and in no particular order; empty means scan.
pub fn optimize_parts<b, c, d, e, m, q, r>(s: &b [u8], split: u64, marks: (&mut u64[]), names: (&mut u8[][]), facts: (&c llvm::Facts), want_ir: u64, ir_text: (&mut u8[]), replay: (&e ir::Replay), call_syms: (&mut u8[][]), call_counts: (&mut u64[]), memo_dir: &m [u8], memo_id: &m [u8], starts: (&q u64[]), known: (&r ir::Known)) -> u8[] {
    // The type facts, indexed by body symbol once: the table is complete before any body is walked.
    ix := ir::index_facts(facts);
    mut o = ir::new_body();
    for i in 4096 {
        o.inl_head.push(0);
    }
    o.memo_dir = memo_dir.copy();
    o.known = known_checked(view(s), known);
    o.memo_id = memo_id.copy();
    // A stream of any size is cut where one function ends and the next begins, and the pieces are
    // optimised by forked copies of this process: every body's work depends only on its own lines
    // and on where it stands in its unit (ir::function_begin), so the pieces put back in order are
    // the text one process would have written. The copies share this process's memory until they
    // write, so nothing is passed to them; what they made comes back through a pipe each.
    // Inside a build's jobserver (compiler/jobs.grl) the pieces are as many as there are tokens
    // free now, plus this process's own; the text is the same whatever the count.
    mut js = jobs::open();
    jobs::phase(view("optimiser-start"));
    pieces := jobs::workers(&mut js, jobs_for(s.len()));
    mut cuts = Cut[];
    if starts.len() != 0 {
        cuts = plan_from(view(s), starts, pieces);
    } else {
        cuts = plan(view(s), pieces);
    }
    jobs::phase(view("optimiser-plan"));
    mut rest = 0;
    mut parallel = false;
    if cuts.len() > 2 {
        parallel = run_forked(&mut o, view(s), &cuts, split, marks, names, facts, &ix, want_ir, ir_text, replay, call_syms, call_counts, &mut js);
    }
    jobs::give_all(&mut js);
    // The lines the inlining pass will read. The workers noted theirs as they went; a single
    // process notes them here.
    mut lines = u64[];
    if parallel {
        rest = cuts[cuts.len() - 1].at;
        lines = exchange(&mut o.table, u64[]);
    } else {
        rest = run_range(&mut o, view(s), 0, s.len(), split, marks, names, facts, &ix, want_ir, ir_text, replay, call_syms, call_counts);
        lines_of_interest(view(o.out), 0, &mut lines);
    }
    tail := o.out.len();
    o.out.append(s[rest..s.len()]);
    lines_of_interest(view(o.out), tail, &mut lines);
    // Either something inlines, or the markers have to be taken out of a single-file build.
    jobs::phase(view("optimiser-workers"));
    if (o.inl_names.len() != 0) || (o.marked != 0) {
        inline_calls(&mut o, split, marks, &lines);
    }
    jobs::phase(view("optimiser-inline"));
    return exchange(&mut o.out, u8[]);
}
// Where a piece of the stream starts, and what the optimiser knows on arriving there: the unit it is
// in and how many functions each unit has had.
struct Cut {
    at: u64,
    unit: u8[],
    uprefix: u8[],
    marked: u64,
    index: u64,
    units: u8[][],
    counts: u64[],
    plain: u64,
    gbase: u64
}
fn cut_here<a>(p: (&a ir::Body), at: u64) -> Cut {
    mut units = u8[][];
    for i in p.uniq_units.len() {
        units.push(p.uniq_units[i].copy());
    }
    return Cut {
        at: at,
        unit: p.unit.copy(),
        uprefix: p.uprefix.copy(),
        marked: p.marked,
        index: p.uniq_index,
        units: units,
        counts: p.uniq_next.copy(),
        plain: p.uniq_plain,
        gbase: p.gbase
    };
}
// How many pieces: one per worker the machine has, none smaller than a megabyte of assembly (below
// that a copy of the process costs more than it saves). GRAIL_JOBS=1 keeps it to one process.
fn jobs_for(size: u64) -> u64 {
    mut jobs = host::cpus();
    asked := host::env(view("GRAIL_JOBS"));
    if asked.len() != 0 {
        jobs = 0;
        for i in asked.len() {
            if (47 < asked[i]) && (asked[i] < 58) {
                jobs = jobs * 10 + u64(asked[i] - 48);
            }
        }
    }
    if 32 < jobs {
        jobs = 32;
    }
    while (1 < jobs) && (size / jobs < 1048576) {
        jobs -= 1;
    }
    if jobs == 0 {
        jobs = 1;
    }
    return jobs;
}
// Is this line the `.type NAME,@function` that opens a body?
fn opens_body<b>(s: &b [u8], a: u64, e: u64) -> bool {
    if (e - a > 15) & (s[a] == 46) & (s[a + 1] == 116) {
        if ir::at(view(s), a, view(".type ")) {
            return ir::same_range(view(s), e - 9, e, view("@function"));
        }
    }
    return false;
}
// Is this line the one that closes a body?
fn closes_body<b>(s: &b [u8], a: u64, e: u64) -> bool {
    if e - a > 6 {
        return (s[a] == 46) & (s[a + 1] == 115) & (s[a + 5] == 46);
    }
    return false;
}
// The cuts for `jobs` pieces: the start of the stream, then the first line outside any body at or
// past each even share of it, then the end of the last whole line. One pass over the lines, doing
// only what tells a body's first and last line and a unit marker apart.
fn plan<b>(s: &b [u8], jobs: u64) -> Cut[] {
    mut p = ir::new_body();
    mut cuts = Cut[];
    cuts.push(cut_here(&p, 0));
    if jobs < 2 {
        return cuts;
    }
    share := s.len() / jobs;
    mut want = share;
    mut start = 0;
    mut inside = false;
    for i in s.len() {
        if s[i] == 10 {
            a := start;
            e := i;
            if !inside {
                if (want <= a) && (cuts.len() < jobs) {
                    cuts.push(cut_here(&p, a));
                    want = a + share;
                }
                if opens_body(view(s), a, e) {
                    ir::function_begin(&mut p);
                    inside = true;
                } else if ir::marker(&mut p, view(s), a, e) == 0 {
                    ir::gbase_line(&mut p, view(s), a, e);
                }
            } else if closes_body(view(s), a, e) {
                inside = false;
            }
            start = i + 1;
        }
    }
    cuts.push(cut_here(&p, start));
    return cuts;
}
// The cuts `plan` makes, from the offsets the emitter noted instead of a scan of the stream: the
// lines that change what a cut carries are a body's opening line (its function ordinal), a part's
// marker and a function's `.gbase`, and every one of them was noted where it was written. Each noted
// offset is checked to be the start of such a line now - a retry takes text back and writes again,
// so a note can be stale or repeated - and they are read in stream order. Cuts are made only at a
// body's opening line, which is outside every body; the output does not depend on where the cuts
// fall (ir::function_begin), only on the state they carry.
fn plan_from<b, q>(s: &b [u8], starts: (&q u64[]), jobs: u64) -> Cut[] {
    mut p = ir::new_body();
    mut cuts = Cut[];
    cuts.push(cut_here(&p, 0));
    if jobs < 2 {
        return cuts;
    }
    // In order, once each: the notes are written in order except where text was taken back.
    mut at = starts.copy();
    mut i = 1;
    while i < at.len() {
        v := at[i];
        mut j = i;
        while (0 < j) && (v < at[j - 1]) {
            at[j] = at[j - 1];
            j -= 1;
        }
        at[j] = v;
        i += 1;
    }
    n := s.len();
    share := n / jobs;
    mut want = share;
    mut last = n + 1;
    for k in at.len() {
        a := at[k];
        if (a == last) || (n <= a) {
            continue;
        }
        last = a;
        if (a != 0) && (s[a - 1] != 10) {
            continue;
        }
        mut e = a;
        while (e < n) && (s[e] != 10) {
            e += 1;
        }
        if e == n {
            continue;
        }
        if opens_body(view(s), a, e) {
            if (want <= a) && (cuts.len() < jobs) {
                cuts.push(cut_here(&p, a));
                want = a + share;
            }
            ir::function_begin(&mut p);
        } else if ir::marker(&mut p, view(s), a, e) == 0 {
            ir::gbase_line(&mut p, view(s), a, e);
        }
    }
    // The end of the last whole line.
    mut end = n;
    while (0 < end) && (s[end - 1] != 10) {
        end -= 1;
    }
    cuts.push(cut_here(&p, end));
    return cuts;
}
// Optimise the whole lines of `s[lo..hi]` into `o.out`. Returns where the last whole line ended.
// The noted bodies (ir::Known) of the stream, each checked to be a whole body where it says: its
// opening line, its closing line, in order and not overlapping. A note that does not check out is
// dropped, and that body is found by the scan like any other.
fn known_checked<b, r>(s: &b [u8], known: (&r ir::Known)) -> ir::Known {
    mut out = ir::no_known();
    mut last = 0;
    for k in known.open.len() {
        a := known.open[k];
        e := known.end[k];
        if (a < last) || (s.len() < e) || (e <= a + 1) || ((a != 0) && (s[a - 1] != 10)) || (s[e - 1] != 10) {
            continue;
        }
        mut ae = a;
        while (ae < e) && (s[ae] != 10) {
            ae += 1;
        }
        // The closing line is the last line before `e`.
        mut ca = e - 1;
        while (a < ca) && (s[ca - 1] != 10) {
            ca -= 1;
        }
        if !opens_body(view(s), a, ae) || !closes_body(view(s), ca, e - 1) {
            continue;
        }
        out.open.push(a);
        out.end.push(e);
        out.key.push(known.key[k].copy());
        last = e;
    }
    return out;
}
fn copy_texts<a>(v: (&a u8[][])) -> u8[][] {
    mut out = u8[][];
    for i in v.len() {
        out.push(v[i].copy());
    }
    return out;
}
// Optimise the whole lines of `s[lo..hi]` into `o.out`. Returns where the last whole line ended.
// The bodies the front end noted (o.known) are taken as they are noted; the text between them -
// part markers, `.gbase` lines, bodies that are not units, data - is scanned line by line.
fn run_range<a, b, c, e, x>(o: (&a mut ir::Body), s: &b [u8], lo: u64, hi: u64, split: u64, marks: (&mut u64[]), names: (&mut u8[][]), facts: (&c llvm::Facts), ix: (&x ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), replay: (&e ir::Replay), call_syms: (&mut u8[][]), call_counts: (&mut u64[])) -> u64 {
    mut cursor = lo;
    // The first noted body at or after `lo`.
    mut k = 0;
    mut top = o.known.open.len();
    while k < top {
        mid := (k + top) / 2;
        if o.known.open[mid] < lo {
            k = mid + 1;
        } else {
            top = mid;
        }
    }
    while (k < o.known.open.len()) && (o.known.open[k] < hi) {
        a := o.known.open[k];
        e := o.known.end[k];
        if hi < e {
            break;
        }
        cursor = scan_range(&mut o, view(s), cursor, a, split, marks, names, facts, ix, want_ir, ir_text, replay, call_syms, call_counts);
        mut ae = a;
        while s[ae] != 10 {
            ae += 1;
        }
        o.name = ir::type_symbol(view(s), a, ae);
        ir::function_begin(&mut o);
        key := o.known.key[k].copy();
        one_body(&mut o, view(s), a, e, true, view(key), facts, ix, want_ir, ir_text, replay, call_syms, call_counts);
        cursor = e;
        k += 1;
    }
    return scan_range(&mut o, view(s), cursor, hi, split, marks, names, facts, ix, want_ir, ir_text, replay, call_syms, call_counts);
}
fn scan_range<a, b, c, e, x>(o: (&a mut ir::Body), s: &b [u8], lo: u64, hi: u64, split: u64, marks: (&mut u64[]), names: (&mut u8[][]), facts: (&c llvm::Facts), ix: (&x ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), replay: (&e ir::Replay), call_syms: (&mut u8[][]), call_counts: (&mut u64[])) -> u64 {
    mut start = lo;
    mut inside = 0;
    mut opened = lo;
    mut i = lo;
    while i < hi {
        if s[i] == 10 {
            a := start;
            e := i;
            start = i + 1;
            if inside == 0 {
                if opens_body(view(s), a, e) {
                    // The body's symbol, which is the key its type facts are filed under.
                    o.name = ir::type_symbol(view(s), a, e);
                    ir::function_begin(&mut o);
                    inside = 1;
                    opened = a;
                } else {
                    if ir::marker(&mut o, view(s), a, e) != 0 {
                        if split != 0 {
                            marks.push(o.out.len());
                            names.push(o.unit.copy());
                        }
                    } else {
                        ir::gbase_line(&mut o, view(s), a, e);
                    }
                    o.out.append(s[a..e + 1]);
                }
            } else if closes_body(view(s), a, e) {
                one_body(&mut o, view(s), opened, start, true, view(""), facts, ix, want_ir, ir_text, replay, call_syms, call_counts);
                inside = 0;
            }
        }
        i += 1;
    }
    if inside != 0 {
        one_body(&mut o, view(s), opened, start, false, view(""), facts, ix, want_ir, ir_text, replay, call_syms, call_counts);
    }
    return start;
}
// One body: the lines of `s[from..to]`, from its `.type` line through the line that closes it.
//
// What the optimiser makes of a body is a function of those lines, of the facts the front end
// recorded about it, and of where it stands in its unit - nothing else. So when the build keeps a
// store (`--fn-cache`), the answer is remembered under a hash of exactly those, and a body whose
// lines have not changed since some earlier build is not parsed or optimised again: its text, its
// inlinable copy, its typed IR and its call count are read back. This is what an edit to one
// function of a large module costs the back end - that function.
fn one_body<a, b, c, e, x, y>(o: (&a mut ir::Body), s: &b [u8], from: u64, to: u64, whole: bool, unit_key: &y [u8], facts: (&c llvm::Facts), ix: (&x ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), replay: (&e ir::Replay), call_syms: (&mut u8[][]), call_counts: (&mut u64[])) {
    range := ir::replay_of(replay, view(o.name));
    mut file = u8[];
    // GRAIL_MEMO_VERIFY=1: a memo entry found under a unit's key is not used but kept here, and the
    // body is optimised again and must come out as those bytes.
    mut verified = u8[];
    verify := verify_memo(unit_key);
    if whole && (o.memo_dir.len() != 0) {
        // The key: the compiler, the unit and its label prefix, the body's ordinal in the unit
        // (its labels are numbered from it), its facts, the replayed prologue's place in it, and
        // whether the typed IR is wanted - and then the lines themselves, hashed twice.
        mut meta = copy_text(view("grail-opt 2 "));
        meta.append(view(o.memo_id));
        meta.push(10);
        meta.append(view(o.unit));
        meta.push(10);
        meta.append(view(o.uprefix));
        meta.push(10);
        put_word(&mut meta, o.uniq);
        put_word(&mut meta, ir::facts_digest(ix, facts, view(o.name)));
        if range[1] != 0 {
            put_word(&mut meta, range[0] - from);
            put_word(&mut meta, range[1] - from);
        }
        put_word(&mut meta, want_ir);
        // A body the front end applied from its unit store is keyed by that unit's key instead of its
        // lines: its text is a function of the key, and hashing 100 MB of text that did not change
        // was most of what a rebuild after an edit spent here. The compiler's own identity is in
        // the unit key and in `memo_id`, so a rebuilt optimiser never reads an older one's entry.
        mut keyed = s[from..to];
        if unit_key.len() != 0 {
            meta.append(view(" unit "));
            keyed = unit_key;
        }
        h1 := xxhash::hash64(keyed, 1) ^ xxhash::hash64(view(meta), 3);
        h2 := xxhash::hash64(keyed, 2) ^ xxhash::hash64(view(meta), 4);
        file = o.memo_dir.copy();
        file.append(view("/opt-"));
        hex_word(&mut file, h1);
        hex_word(&mut file, h2);
        if verify && (host::exists(view(file)) != 0) {
            verified = host::read_file(view(file));
        } else if host::exists(view(file)) != 0 {
            kept := host::read_file(view(file));
            // Whole entries only: the last word is written last.
            if 24 <= kept.len() {
                mut tail = kept.len() - 8;
                if take_word(view(kept), &mut tail) == 6072411188134084935 {
                    mut at = 0;
                    n := take_word(view(kept), &mut at);
                    o.out.append(kept[at..at + n]);
                    at += n;
                    if take_word(view(kept), &mut at) != 0 {
                        name := take_text(view(kept), &mut at);
                        body_text := take_text(view(kept), &mut at);
                        unit := take_text(view(kept), &mut at);
                        inl_file(&mut o, name, ir::absolute_positions(view(body_text), o.gbase), unit);
                    }
                    count := take_word(view(kept), &mut at);
                    ir_piece := take_text(view(kept), &mut at);
                    ir_text.append(view(ir_piece));
                    call_syms.push(o.name.copy());
                    call_counts.push(count);
                    return ();
                }
            }
        }
    }
    mut start = from;
    mut i = from;
    while i < to {
        if s[i] == 10 {
            ir::parse(&mut o, view(s), start, i);
            start = i + 1;
        }
        i += 1;
    }
    out_mark := o.out.len();
    ir_mark := ir_text.len();
    inl_mark := o.inl_names.len();
    body(&mut o, view(s), facts, ix, want_ir, ir_text, replay, call_syms, call_counts);
    if file.len() != 0 {
        mut kept = u8[];
        out_end := o.out.len();
        put_text(&mut kept, o.out[out_mark..out_end]);
        if inl_mark < o.inl_names.len() {
            put_word(&mut kept, 1);
            put_text(&mut kept, view(o.inl_names[inl_mark]));
            put_text(&mut kept, view(o.inl_rel));
            put_text(&mut kept, view(o.inl_units[inl_mark]));
        } else {
            put_word(&mut kept, 0);
        }
        put_word(&mut kept, call_counts[call_counts.len() - 1]);
        ir_end := ir_text.len();
        put_text(&mut kept, ir_text[ir_mark..ir_end]);
        put_word(&mut kept, 6072411188134084935);
        if (verified.len() != 0) && !ir::same_range(view(verified), 0, verified.len(), view(kept)) {
            host::print(view("grail: GRAIL_MEMO_VERIFY: the remembered optimisation of "));
            host::print(view(o.name));
            host::print(view(" under its unit's key is not what optimising it gives\n"));
            host::exit(1);
        }
        host::write_file(view(file), view(kept));
    }
    ir::reset(&mut o);
}
fn verify_memo<a>(unit_key: &a [u8]) -> bool {
    return (unit_key.len() != 0) && (host::env(view("GRAIL_MEMO_VERIFY")).len() != 0);
}
fn copy_text<a>(text: &a [u8]) -> u8[] {
    mut out = u8[];
    out.append(text);
    return out;
}
fn hex_word<a>(out: (&a mut u8[]), n: u64) {
    mut shift = 64;
    while shift != 0 {
        shift -= 4;
        d := (n >> shift) & 15;
        if d < 10 {
            out.push(u8(48 + d));
        } else {
            out.push(u8(87 + d));
        }
    }
}
fn put_word<a>(out: (&a mut u8[]), n: u64) {
    mut v = n;
    for i in 8 {
        out.push(u8(v & 255));
        v = v >> 8;
    }
}
fn put_text<a, b>(out: (&a mut u8[]), text: &b [u8]) {
    put_word(&mut out, text.len());
    out.append(text);
}
fn take_word<a, b>(from: &a [u8], at: (&b mut u64)) -> u64 {
    mut v = 0;
    mut shift = 0;
    for i in 8 {
        v = v | (u64(from[*at + i]) << shift);
        shift += 8;
    }
    exchange(at, *at + 8);
    return v;
}
fn take_text<a, b>(from: &a [u8], at: (&b mut u64)) -> u8[] {
    n := take_word(from, at);
    mut out = u8[];
    out.append(from[*at..*at + n]);
    exchange(at, *at + n);
    return out;
}
// File an inlinable body, as inline_candidate does.
fn inl_file<a>(o: (&a mut ir::Body), name: u8[], body: u8[], unit: u8[]) {
    h := name_hash(view(name), 0, name.len());
    index := o.inl_names.len();
    o.inl_names.push(name);
    o.inl_bodies.push(body);
    o.inl_units.push(unit);
    old := o.inl_head[h];
    o.inl_next.push(old);
    ir::put(&mut o.inl_head, h, index + 1);
}
// One forked copy per piece. Each optimises its piece and writes what it made to its pipe: the
// text, the unit markers it kept, the inlinable bodies it found, the typed IR and the call counts.
// This process reads the pipes in order, which is the order one process would have produced.
// False when the platform cannot fork: the caller then does the work itself.
fn run_forked<a, b, c, e, x, g, h>(o: (&a mut ir::Body), s: &b [u8], cuts: (&g Cut[]), split: u64, marks: (&mut u64[]), names: (&mut u8[][]), facts: (&c llvm::Facts), ix: (&x ir::FactIndex), want_ir: u64, ir_text: (&mut u8[]), replay: (&e ir::Replay), call_syms: (&mut u8[][]), call_counts: (&mut u64[]), js: (&h mut jobs::Jobs)) -> bool {
    pieces := cuts.len() - 1;
    mut readers = u64[];
    mut children = u64[];
    for k in pieces {
        pair := host::pipe();
        child := host::fork();
        if child == 0 {
            host::close(pair[0]);
            for r in readers.len() {
                host::close(readers[r]);
            }
            mut w = ir::new_body();
            for i in 4096 {
                w.inl_head.push(0);
            }
            cut := &cuts[k];
            w.unit = cut.unit.copy();
            w.uprefix = cut.uprefix.copy();
            w.marked = cut.marked;
            w.uniq_index = cut.index;
            for i in cut.units.len() {
                w.uniq_units.push(cut.units[i].copy());
            }
            w.uniq_next = cut.counts.copy();
            w.uniq_plain = cut.plain;
            w.gbase = cut.gbase;
            w.memo_dir = o.memo_dir.copy();
            w.known = ir::Known { open: o.known.open.copy(), end: o.known.end.copy(), key: copy_texts(&o.known.key) };
            w.memo_id = o.memo_id.copy();
            mut wmarks = u64[];
            mut wnames = u8[][];
            mut wir = u8[];
            mut wsyms = u8[][];
            mut wcounts = u64[];
            run_range(&mut w, view(s), cut.at, cuts[k + 1].at, split, &mut wmarks, &mut wnames, facts, ix, want_ir, &mut wir, replay, &mut wsyms, &mut wcounts);
            mut packed = u8[];
            mut wlines = u64[];
            lines_of_interest(view(w.out), 0, &mut wlines);
            put_word(&mut packed, w.marked);
            put_text(&mut packed, view(w.out));
            put_word(&mut packed, wlines.len());
            for i in wlines.len() {
                put_word(&mut packed, wlines[i]);
            }
            put_word(&mut packed, wmarks.len());
            for i in wmarks.len() {
                put_word(&mut packed, wmarks[i]);
                put_text(&mut packed, view(wnames[i]));
            }
            put_word(&mut packed, w.inl_names.len());
            for i in w.inl_names.len() {
                put_text(&mut packed, view(w.inl_names[i]));
                put_text(&mut packed, view(w.inl_bodies[i]));
                put_text(&mut packed, view(w.inl_units[i]));
            }
            put_text(&mut packed, view(wir));
            put_word(&mut packed, wsyms.len());
            for i in wsyms.len() {
                put_text(&mut packed, view(wsyms[i]));
                put_word(&mut packed, wcounts[i]);
            }
            // The last word says the piece is whole: a copy that died leaves a short stream.
            put_word(&mut packed, 6072411188134084935);
            host::write_fd(pair[1], view(packed));
            host::close(pair[1]);
            host::exit(0);
        }
        host::close(pair[1]);
        if 9223372036854775807 < child {
            // No fork here. Nothing has been started yet when the first one fails, which is the
            // only one that can for that reason.
            host::close(pair[0]);
            assert(k == 0);
            return false;
        }
        readers.push(pair[0]);
        children.push(child);
    }
    mut all_lines = u64[];
    for k in pieces {
        mut packed = u8[];
        while true {
            chunk := host::read_fd(readers[k], 1048576);
            if chunk.len() == 0 {
                break;
            }
            packed.append(view(chunk));
        }
        host::close(readers[k]);
        status := host::wait(children[k]);
        mut whole = (status == 0) && (16 <= packed.len());
        if whole {
            mut tail = packed.len() - 8;
            whole = take_word(view(packed), &mut tail) == 6072411188134084935;
        }
        if !whole {
            // The tokens this process took for its workers go back before it stops.
            jobs::give_all(&mut js);
            host::print(view("grail: an optimiser worker did not finish (GRAIL_JOBS=1 runs the optimiser in one process)\n"));
            host::exit(1);
        }
        mut at = 0;
        if take_word(view(packed), &mut at) != 0 {
            o.marked = 1;
        }
        base := o.out.len();
        n := take_word(view(packed), &mut at);
        o.out.append(packed[at..at + n]);
        at += n;
        noted := take_word(view(packed), &mut at);
        for i in noted {
            all_lines.push(base + take_word(view(packed), &mut at));
        }
        kept := take_word(view(packed), &mut at);
        for i in kept {
            mark := take_word(view(packed), &mut at);
            name := take_text(view(packed), &mut at);
            if split != 0 {
                marks.push(base + mark);
                names.push(name);
            }
        }
        found := take_word(view(packed), &mut at);
        for i in found {
            name := take_text(view(packed), &mut at);
            body_text := take_text(view(packed), &mut at);
            unit := take_text(view(packed), &mut at);
            inl_file(&mut o, name, body_text, unit);
        }
        ir_piece := take_text(view(packed), &mut at);
        ir_text.append(view(ir_piece));
        counted := take_word(view(packed), &mut at);
        for i in counted {
            call_syms.push(take_text(view(packed), &mut at));
            call_counts.push(take_word(view(packed), &mut at));
        }
    }
    // Handed back in the body's label table, which nothing uses between bodies.
    exchange(&mut o.table, all_lines);
    return true;
}
