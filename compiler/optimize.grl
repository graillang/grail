            kill(&mut o, t2);
        }
    }
}
// Constants where the front end loads them into registers (dev-gap item 8). A shift whose count is a
// constant below 64 in %rcx shifts by the immediate (`shlq $13,%rax`); and a comparison of a
// constant register with an immediate whose only reader is the conditional jump after it decides
// that jump - it is `jmp` or nothing - which is how the checks of constant shift counts and other
// constant conditions disappear. A jump's other successor reads no flags, or it is not folded.
fn const_branches<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64) {
    for i in last {
        if o.del[i] != 0 {
            continue;
        }
        op := o.op[i];
