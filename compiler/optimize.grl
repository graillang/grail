// Whether the code reached at line i (after labels and directives) may read the flags: a
// conditional jump, a set, an add or subtract with carry, or anything the optimiser does not know.
fn reads_flags<a>(o: (&a ir::Body), i: u64, last: u64) -> bool {
    mut j = i;
    while (j < last) && ((o.del[j] != 0) || (o.op[j] == 101) || (o.op[j] == 100)) {
        j += 1;
    }
    if j >= last {
        return true;
    }
    op := o.op[j];
    return (op == 0) || ((16 < op) && (op < 25)) || (op == 25) || (op == 26) || (op == 27);
}
// An accumulator worked on in %rax (dev-gap item 10): `movq %A,%rax; OP x,%rax; ... movq %rax,%A`
// with %rax dead afterwards is the same operations on %A. The lines are consecutive, each OP is an
// arithmetic operation writing %rax whose source is not memory addressed through %rax, and %A is a
// register none of them names as its source unless it is %rax's own value.
fn retarget<a, b>(o: (&a mut ir::Body), s: &b [u8], last: u64) {
    for i in last {
        if (o.del[i] != 0) || (o.op[i] != 1) || (o.k0[i] != 1) || (o.k1[i] != 1) || (o.v1[i] != 0) {
            continue;
        }
        a := o.v0[i];
        if (a == 0) || (a == 4) || (a == 5) {
            continue;
        }
        mut j = next_live(&o, i, last);
        mut n = 0;
        mut ok = true;
        while (j < last) && (n < 6) {
            op := o.op[j];
            if (op == 1) && (o.k0[j] == 1) && (o.v0[j] == 0) && (o.k1[j] == 1) && (o.v1[j] == a) {
                break;
