                                                        if (kop == 1 || kop == 2)
                                                            && o.k1[k] == 1 {
                                                            value = imm_value(&o, view(s), k);
                                                        }
                                                        break;
                                                    }
                                                }
                                            }
                                            if (value > 1) & (value < 2147483650) {
                                                v := value - 1;
                                                if (v & (v - 1)) == 0 {
                                                    mut shift = 0;
                                                    while (1 << shift) < v {
                                                        shift += 1;
                                                    }
                                                    put(&mut o.op, i, 1);
                                                    set_operand(&mut o, i, 0, 1, 0);
                                                    set_operand(&mut o, i, 1, 1, 2);
                                                    put(&mut o.op, j, 8);
                                                    gen_imm(&mut o, v - 1, j, 0);
                                                    set_operand(&mut o, j, 1, 1, 2);
                                                    put(&mut o.op, c, 34);
                                                    gen_imm(&mut o, shift, c, 0);
                                                    set_operand(&mut o, c, 1, 1, 0);
                                                    kill(&mut o, x);
                                                    kill(&mut o, d);
                                                    put(&mut o.tr, i, 0);
                                                    put(&mut o.tr, j, 0);
                                                    put(&mut o.tr, c, 0);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
