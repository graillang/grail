module native_numbers;
fn fib(n:u64)->u64 {
    if n<2 { return n; }
    return fib(n-1)+fib(n-2);
}
fn six(a:u64,b:u64,c:u64,d:u64,e:u64,f:u64)->u64 {
    return a+2*b+3*c+4*d+5*e+6*f;
}
pub fn run()->u64 {
    mut i=0; mut sum=0;
    while i<10 {
        i=i+1;
        if i==3 { continue; }
        if i==8 { break; }
        sum=sum+i;
    }
    assert(sum==25);
    assert(wrapping_sub(0,1)<1==0);
    assert(wrapping_sub(0,1)%10==5);
    assert(wrapping_add(wrapping_sub(0,1),1)==0);
    assert(((7^3)&6)==4);
    return fib(10)+six(1,2,3,4,5,6)+sum;
}
