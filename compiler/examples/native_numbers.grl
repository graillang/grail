module native_numbers;
fn fib(n:num)->num {
    if n<2 { return n; }
    return fib(n-1)+fib(n-2);
}
fn six(a:num,b:num,c:num,d:num,e:num,f:num)->num {
    return a+2*b+3*c+4*d+5*e+6*f;
}
pub fn run()->num {
    var i=0; var sum=0;
    while i<10 {
        i=i+1;
        if i==3 { continue; }
        if i==8 { break; }
        sum=sum+i;
    }
    assert(sum==25);
    assert((0-1)<1==0);
    assert((0-1)%10==5);
    assert((0-1)+1==0);
    assert(((7^3)&6)==4);
    return fib(10)+six(1,2,3,4,5,6)+sum;
}
