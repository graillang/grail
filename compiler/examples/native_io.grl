module probe;use host;
        pub fn run()->num {
            assert(host::argc()==4);
            path :=host::arg(1);destination :=host::arg(2);extra :=host::arg(3);
            assert(extra.len()==0);
            input :=host::read_file(&path);
            assert(input.len()==5);assert(input[0]==0);assert(input[4]==255);
            assert(host::write_file(&destination,&input)==0);
            assert(host::write_file(&path,&input)==0);
            absent :="/no/such/grail-host-test-dir/file";
            assert(host::write_file(&absent,&input)!=0);
            mut bad =bytes[];bad.push(0);
            assert(host::write_file(&bad,&input)!=0);
            full :="/dev/full";
            assert(host::write_file(&full,&input)!=0);
            mut args =vec<bytes>[];yes :="/bin/true";args.push(yes.copy());
            assert(host::command(args)==0);
            mut args =vec<bytes>[];no :="/bin/false";args.push(no.copy());
            assert(host::command(args)==1);
            mut args =vec<bytes>[];missing :="/no/such/grail-executable";args.push(missing.copy());
            assert(host::command(args)==127);
            mut args =vec<bytes>[];assert(host::command(args)!=0);
            mut args =vec<bytes>[];args.push(bad);assert(host::command(args)!=0);
            mut args =vec<bytes>[];cmp :="/usr/bin/cmp";args.push(cmp.copy());
            args.push(path.copy());args.push(destination.copy());
            assert(host::command(args)==0);
            host::print(&input);return 19;
        }
