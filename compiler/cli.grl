module cli;
use host;
use lexer;
use docgen;
use fmt;
use explain;
use bindgen;
use pkg;
use jobs;
use llvm;
use xxhash;
use asm_x86;

// The `grail` command-line tool. The same binary is the compiler: subcommands drive it by
// re-invoking itself (`grail [--target T] OUT.s ENTRY.grl MODULE.grl...`), then assemble and link.
struct Home {
    runtime: u8[],
    std: u8[],
    // The directories `--module-root DIR` named, in the order given: a root is where `use` looks for
    // `NAME.grl`, and the first root that holds a module wins. They travel in `Home` so that the
    // resolution probe and the compile are built from one command and cannot disagree about the
    // list - that disagreement is what made the flag look ignored.
    roots: u8[][]
}

fn eq<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn starts<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() < y.len() {
        return false;
    }
    for i in y.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn ends<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() < y.len() {
        return false;
    }
    d := x.len() - y.len();
    for i in y.len() {
        if x[d + i] != y[i] {
            return false;
        }
    }
    return true;
}
fn cat<a, b>(x: &a [u8], y: &b [u8]) -> u8[] {
    mut o = u8[];
    for i in x.len() {
        o.push(x[i]);
    }
    for i in y.len() {
        o.push(y[i]);
    }
    return o;
}
// `text` as the inside of a JSON string: quotes, backslashes and control characters escaped, so a
// record stays on one line whatever the source or the message holds. Both structured-diagnostic
// writers use it - the compiler's per-diagnostic record and the driver's per-cycle object.
pub fn json_text<a>(out: (&mut u8[]), text: &a [u8]) -> unit {
    mut i = 0;
    while i < text.len() {
        ch := text[i];
        if (ch == 34) || (ch == 92) {
            out.push(92);
            out.push(ch);
        } else {
            if ch == 10 {
                out.push(92);
                out.push(110);
            } else {
                if ch == 9 {
                    out.push(92);
                    out.push(116);
                } else {
                    if ch == 13 {
                        out.push(92);
                        out.push(114);
                    } else {
                        if ch < 32 {
                            out.push(92);
                            out.push(117);
                            out.push(48);
                            out.push(48);
                            out.push(hex_digit(ch / 16));
                            out.push(hex_digit(ch % 16));
                        } else {
                            out.push(ch);
                        }
                    }
                }
            }
        }
        i += 1;
    }
    return ();
}
fn hex_digit(n: u64) -> u8 {
    if n < 10 {
        return 48 + u8(n);
    }
    return 87 + u8(n);
}
fn copy<a>(x: &a [u8]) -> u8[] {
    mut o = u8[];
    for i in x.len() {
        o.push(x[i]);
    }
    return o;
}
fn push_bytes<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    for i in s.len() {
        out.push(s[i]);
    }
    return ();
}
fn path_join<a, b>(dir: &a [u8], name: &b [u8]) -> u8[] {
    if (dir.len() == 0) || eq(view(dir), view(".")) {
        return copy(view(name));
    }
    // A Windows path ends in either separator, and both are accepted by every Win32 call.
    if is_sep(dir[dir.len() - 1]) {
        return cat(view(dir), view(name));
    }
    mut o = copy(view(dir));
    o.push(47);
    for i in name.len() {
        o.push(name[i]);
    }
    return o;
}
// `/` on Linux and macOS, `/` or `\\` on Windows: one predicate for every path split below.
// `C:` / `c:`: a Win32 path is absolute without a leading separator.
fn drive_letter<a>(path: &a [u8]) -> bool {
    if path.len() < 2 {
        return false;
    }
    if path[1] != 58 {
        return false;
    }
    return (65 <= path[0]) && (path[0] <= 90) || (97 <= path[0]) && (path[0] <= 122);
}
fn is_sep(ch: u64) -> bool {
    return (ch == 47) || (ch == 92);
}
fn dirname<a>(p: &a [u8]) -> u8[] {
    mut i = p.len();
    while 0 < i {
        i -= 1;
        if is_sep(p[i]) {
            mut o = u8[];
            for j in i {
                o.push(p[j]);
            }
            if i == 0 {
                o.push(47);
            }
            return o;
        }
    }
    return copy(view("."));
}
fn basename<a>(p: &a [u8]) -> u8[] {
    mut start = 0;
    for i in p.len() {
        if is_sep(p[i]) {
            start = i + 1;
        }
    }
    mut o = u8[];
    mut end = p.len();
    if ends(view(p), view(".grl")) {
        end -= 4;
    }
    mut i = start;
    while i < end {
        o.push(p[i]);
        i += 1;
    }
    return o;
}
fn say<a>(s: &a [u8]) {
    host::print(s);
    host::print(view("\n"));
}
fn say2<a, b>(s: &a [u8], t: &b [u8]) {
    host::print(s);
    host::print(t);
    host::print(view("\n"));
}
fn item<a>(v: (&a u8[][]), i: u64) -> u8[] {
    x := &v[i];
    return x.copy();
}
fn words<a>(line: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut cur = u8[];
    for i in line.len() {
        c := line[i];
        if c == 32 || c == 9 || c == 13 {
            if cur.len() != 0 {
                out.push(exchange(&mut cur, u8[]));
            }
        } else {
            cur.push(c);
        }
    }
    if cur.len() != 0 {
        out.push(cur);
    }
    return out;
}
fn lines<a>(text: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut cur = u8[];
    for i in text.len() {
        c := text[i];
        if c == 10 {
            out.push(exchange(&mut cur, u8[]));
        } else {
            cur.push(c);
        }
    }
    if cur.len() != 0 {
        out.push(cur);
    }
    return out;
}

fn home() -> Home {
    env := host::env(view("GRAIL_HOME"));
    if env.len() != 0 {
        installed := path_join(view(env), view("runtime.grl"));
        if host::exists(view(installed)) != 0 {
            return Home { runtime: installed, std: path_join(view(env), view("std")) , roots: u8[][] };
        }
        repo := path_join(view(env), view("compiler/runtime.grl"));
        if host::exists(view(repo)) != 0 {
            return Home { runtime: repo, std: path_join(view(env), view("lib")) , roots: u8[][] };
        }
    }
    exe := host::exe_path();
    mut dir = dirname(view(exe));
    for level in 6 {
        installed := path_join(view(dir), view("lib/grail/runtime.grl"));
        if host::exists(view(installed)) != 0 {
            prefix := path_join(view(dir), view("lib/grail"));
            return Home { runtime: installed, std: path_join(view(prefix), view("std")) , roots: u8[][] };
        }
        repo := path_join(view(dir), view("compiler/runtime.grl"));
        if host::exists(view(repo)) != 0 {
            return Home { runtime: repo, std: path_join(view(dir), view("lib")) , roots: u8[][] };
        }
        dir = path_join(view(dir), view(".."));
    }
    say(view("grail: cannot find the Grail runtime; set GRAIL_HOME"));
    return Home { runtime: u8[], std: u8[] , roots: u8[][] };
}
// The runtime and the x86-64 Linux platform module, as home() finds them: what a compile-time probe
// is compiled with when the compile that asks for it reads them as interfaces (a module of a separate
// build), so the probe still links on its own. Empty when there is no runtime to find.
pub fn probe_runtime_sources() -> u8[][] {
    h := home();
    if h.runtime.len() == 0 {
        return u8[][];
    }
    mut out = u8[][h.runtime.copy()];
    out.push(path_join(view(dirname(view(h.runtime))), view("os-linux.grl")));
    return out;
}
fn collect<a, b>(dir: &a [u8], out: (&b mut u8[][])) {
    entries := host::list_dir(view(dir));
    for i in entries.len() {
        name := item(&entries, i);
        if ends(view(name), view("/")) {
            if !(starts(view(name), view(".")) || eq(view(name), view("target/"))) {
                sub := path_join(view(dir), view(name));
                collect(view(sub), &mut out);
            }
        } else {
            if ends(view(name), view(".grl")) {
                out.push(path_join(view(dir), view(name)));
            }
        }
    }
}
fn effect_word<a, b>(text: &a [u8], at: u64, word: &b [u8]) -> bool {
    if text.len() < at + word.len() {
        return false;
    }
    for k in word.len() {
        if text[at + k] != word[k] {
            return false;
        }
    }
    end := at + word.len();
    if end == text.len() {
        return true;
    }
    b := text[end];
    letter := ((64 < b) && (b < 91)) || ((96 < b) && (b < 123)) || (b == 95) || ((47 < b) && (b < 58));
    return !letter;
}
fn ends_with_grl<a>(s: &a [u8]) -> bool {
    n := s.len();
    if n < 4 {
        return false;
    }
    return (s[n - 4] == 46) && (s[n - 3] == 103) && (s[n - 2] == 114) && (s[n - 1] == 108);
}
// The compiler's link requests: each `// grail-link: INPUT` line of the assembly. Absolute paths
// and flags pass through, relative object/archive/shared inputs resolve against `base` (the entry
// file's directory) and bare names become -lNAME. Duplicates are dropped.
fn link_inputs<a, b>(asm: &a [u8], base: &b [u8]) -> u8[][] {
    text := host::read_file(view(asm));
    prefix := "// grail-link: ";
    mut out = u8[][];
    mut start: u64 = 0;
    mut i: u64 = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut line = u8[];
            for j in i - start {
                line.push(text[start + j]);
            }
            // A PE import note names a symbol in a DLL, not a linker input: windows_link turns it
            // into a short-import object. Every other note is an input.
            if starts(view(line), view(prefix))
                & !starts(view(line), view("// grail-link: import ")) {
                mut input = u8[];
                mut k = prefix.len();
                while k < line.len() {
                    input.push(line[k]);
                    k += 1;
                }
                while (input.len() > 0)
                    && ((input[input.len() - 1] == 32) || (input[input.len() - 1] == 13)) {
                    input.pop()!;
                }
                mut arg = u8[];
                if (input.len() > 0)
                    && (
                        (input[0] == 47)
                            || (input[0] == 45)
                            || ((input[0] == 92) || drive_letter(input))
                    ) {
                    arg = input.copy();
                } else {
                    mut has_slash = false;
                    for j in input.len() {
                        if is_sep(input[j]) {
                            has_slash = true;
                        }
                    }
                    if has_slash
                        || ends(view(input), view(".o"))
                        || ends(view(input), view(".a"))
                        || ends(view(input), view(".so"))
                        || ends(view(input), view(".dylib")) {
                        arg = path_join(view(base), view(input));
                    } else {
                        arg = cat(view("-l"), view(input));
                    }
                }
                mut seen = 0;
                for j in out.len() {
                    if eq(view(item(&out, j)), view(arg)) {
                        seen = 1;
                    }
                }
                if (seen == 0) && (arg.len() > 0) {
                    out.push(arg);
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return out;
}
// A shared-library input (-lNAME) makes the ELF executable dynamically linked: ld.lld then needs
// the platform loader, the system library directories, which it has no defaults for, and libc.
fn dynamic_link_flags<a, b>(target: &a [u8], inputs: (&b u8[][])) -> u8[][] {
    mut out = u8[][];
    mut shared = 0;
    for i in inputs.len() {
        input := item(&inputs, i);
        if starts(view(input), view("-l")) || ends(view(input), view(".so")) {
            shared = 1;
        }
    }
    if shared == 0 {
        return out;
    }
    mut loaders = u8[][
        copy(view("/lib64/ld-linux-x86-64.so.2")),
        copy(view("/lib/ld-linux-x86-64.so.2"))
    ];
    if eq(view(target), view("aarch64")) {
        loaders = u8[][copy(view("/lib/ld-linux-aarch64.so.1"))];
    }
    if eq(view(target), view("riscv64")) {
        loaders = u8[][
            copy(view("/lib/ld-linux-riscv64-lp64d.so.1")),
            copy(view("/lib/ld-linux-riscv64-lp64.so.1"))
        ];
    }
    for i in loaders.len() {
        candidate := item(&loaders, i);
        if host::exists(view(candidate)) != 0 {
            out.push(copy(view("--dynamic-linker")));
            out.push(candidate);
            break;
        }
    }
    out.push(copy(view("-L/usr/lib")));
    out.push(copy(view("-L/usr/lib64")));
    // Debian/Ubuntu keep libc and the ELF loader in target-prefixed multiarch
    // directories. ld.lld has no default search path, so name those directories
    // explicitly; a host without them simply ignores the nonexistent -L paths.
    out.push(cat(cat(view("-L/usr/lib/"), view(target)), view("-linux-gnu")));
    out.push(cat(cat(view("-L/lib/"), view(target)), view("-linux-gnu")));
    // A dynamic process has loaded libc whatever it named, and the runtime creates its threads
    // through pthread_create so each has a libc TCB (docs/ffi.md); a weak reference only binds
    // when libc is on the link line.
    out.push(copy(view("-lc")));
    return out;
}
// ---- split assembly (B1 stage 1) ----
// With `--split` the compiler writes one assembly file per module plus OUT.parts, which lists them
// in link order and carries the `// grail-link:` request a single-file build puts at the head of
// its assembly. The parts are assembled concurrently and linked once.
struct Split {
    asm: u8[][],
    objects: u8[][],
    link: u8[][]
}
fn with_object_ext<a>(path: &a [u8]) -> u8[] {
    mut n = path.len();
    if (n > 1) & (path[n - 1] == 115) & (path[n - 2] == 46) {
        n = n - 2;
    }
    mut out = u8[];
    for i in n {
        out.push(path[i]);
    }
    push_bytes(&mut out, view(".o"));
    return out;
}
fn read_split<a, b>(manifest: &a [u8], base: &b [u8]) -> Split {
    text := host::read_file(view(manifest));
    mut parts = u8[][];
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        if (row.len() != 0) & !starts(view(row), view("//")) {
            parts.push(copy(view(row)));
        }
    }
    mut objects = u8[][];
    for i in parts.len() {
        part := item(&parts, i);
        objects.push(with_object_ext(view(part)));
    }
    return Split { asm: parts, objects: objects, link: link_inputs(view(manifest), view(base)) };
}
// Quote one argument for `sh -c`: single quotes keep every byte except a quote itself, which the
// usual close-escape-reopen sequence carries.
fn sh_word<a, b>(out: (&a mut u8[]), word: &b [u8]) -> unit {
    out.push(39);
    for i in word.len() {
        b := word[i];
        if b == 39 {
            out.push(39);
            out.push(92);
            out.push(39);
            out.push(39);
        } else {
            out.push(b);
        }
    }
    out.push(39);
    return ();
}
// Assemble every part at once: one assembler process per part, waited on together, so a build with
// many modules pays for the slowest one instead of their sum. The driver has no process API of its
// own, so the parallelism comes from the shell; a failure in any part fails the build.
fn assemble_parts<a, b, d>(prefix: (&a u8[][]), parts: (&b u8[][]), objects: (&d u8[][])) -> u64 {
    mut script = u8[];
    push_bytes(&mut script, view("set -e\npids=''\n"));
    for i in parts.len() {
        for j in prefix.len() {
            word := item(&prefix, j);
            sh_word(&mut script, view(word));
            script.push(32);
        }
        source := item(&parts, i);
        object := item(&objects, i);
        sh_word(&mut script, view(source));
        push_bytes(&mut script, view(" -o "));
        sh_word(&mut script, view(object));
        push_bytes(&mut script, view(" &\npids=\"$pids $!\"\n"));
    }
    push_bytes(&mut script, view("for p in $pids; do wait \"$p\" || exit 1; done\n"));
    mut command = u8[][copy(view("sh")), copy(view("-c")), script];
    return host::command(command);
}
// A --check build removes what the compiler wrote instead of publishing it.
fn remove_split<a>(output: &a [u8]) -> unit {
    manifest := cat(view(output), view(".parts"));
    text := host::read_file(view(manifest));
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        if (row.len() != 0) & !starts(view(row), view("//")) {
            host::remove(view(row), 0);
        }
    }
    host::remove(view(manifest), 0);
    return ();
}
fn target_name(t: u64) -> u8[] {
    if t == 1 {
        return copy(view("aarch64"));
    }
    if t == 2 {
        return copy(view("riscv64"));
    }
    return copy(view("x86_64"));
}
// The platform module a target is built with, as a file name next to runtime.grl.
fn platform_module<a>(target: &a [u8]) -> u8[] {
    if is_macho(view(target)) {
        return copy(view("darwin.grl"));
    }
    if starts(view(target), view("windows")) {
        return copy(view("os-windows.grl"));
    }
    return copy(view("os-linux.grl"));
}
// Mach-O targets compile the darwin module, which owns every libSystem call.
fn is_macho<a>(target: &a [u8]) -> bool {
    return eq(view(target), view("macos-x86_64")) || eq(view(target), view("macos-aarch64"));
}

// ---- Windows (PE/COFF) linking ----------------------------------------------------------------
// The image needs one import descriptor per Win32 entry point it calls, and lld-link builds those
// from COFF short-import objects - what an import library (.lib) is a collection of. The compiler
// already names every pair: `// grail-link: import DLL SYMBOL`, so the driver writes the objects
// itself and no Visual Studio, Windows SDK or checked-in .lib is needed. LLVM alone is enough:
// clang assembles, lld-link links.
fn push_le16<a>(out: (&a mut u8[]), v: u64) -> unit {
    out.push(v % 256);
    out.push((v / 256) % 256);
    return ();
}
fn push_le32<a>(out: (&a mut u8[]), v: u64) -> unit {
    out.push(v % 256);
    out.push((v / 256) % 256);
    out.push((v / 65536) % 256);
    out.push((v / 16777216) % 256);
    return ();
}
// One 20-byte COFF short import: the header lld reads, then "SYMBOL\0DLL.DLL\0".
fn pe_short_import<a, b>(dll: &a [u8], symbol: &b [u8]) -> u8[] {
    mut out = u8[];
    push_le16(&mut out, 0); // Sig1
    push_le16(&mut out, 65535); // Sig2: 0xFFFF marks a short import
    push_le16(&mut out, 0); // Version
    push_le16(&mut out, 34404); // Machine: IMAGE_FILE_MACHINE_AMD64
    push_le32(&mut out, 0); // TimeDateStamp
    push_le32(&mut out, symbol.len() + dll.len() + 6); // SizeOfData
    push_le16(&mut out, 0); // Ordinal/hint
    push_le16(&mut out, 4); // IMPORT_NAME_NOPREFIX
    for i in symbol.len() {
        out.push(symbol[i]);
    }
    out.push(0);
    for i in dll.len() {
        out.push(dll[i]);
    }
    // The import descriptor names a file: the DLL's own name, with the extension Win32 loads.
    out.push(46); // '.'
    out.push(100); // 'd'
    out.push(108); // 'l'
    out.push(108); // 'l'
    out.push(0);
    return out;
}
// Every `// grail-link: import DLL SYMBOL` note of one assembly file as a short-import object, in
// the order the notes appear. The compiler emits one note per entry point, so there is nothing to
// deduplicate here.
fn windows_imports<a, b>(asm: &a [u8], dir: &b [u8]) -> u8[][] {
    text := host::read_file(view(asm));
    prefix := "// grail-link: import ";
    mut out = u8[][];
    mut start: u64 = 0;
    mut i: u64 = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut line = u8[];
            for j in i - start {
                line.push(text[start + j]);
            }
            if starts(view(line), view(prefix)) {
                mut cut = line.len();
                for k in line.len() {
                    if (line[k] == 32) && (prefix.len() <= k) {
                        cut = k;
                        break;
                    }
                }
                dll := (line[prefix.len()..cut]).copy();
                mut symbol = u8[];
                for k in line.len() - (cut + 1) {
                    ch := line[cut + 1 + k];
                    if (ch != 32) && (ch != 13) {
                        symbol.push(ch);
                    }
                }
                image := pe_short_import(view(dll), view(symbol));
                path := path_join(view(dir), cat(cat(view("imp-"), view(symbol)), view(".obj")));
                host::write_file(view(path), view(image));
                out.push(path);
            }
            start = i + 1;
        }
        i += 1;
    }
    return out;
}
// The short-import objects as the archive lld-link takes them in: a standalone import object is
// refused ("not a COFF file"), while a member of an archive is read as an import. That archive is
// what an import library is, and llvm-ar writes it, so the toolchain stays LLVM-only.
fn import_library<a, b>(dir: &a [u8], objects: (&b u8[][])) -> u8[] {
    lib := path_join(view(dir), view("imports.lib"));
    host::remove(view(lib), 0);
    mut argv = u8[][tool(view("GRAIL_AR"), view("llvm-ar")), copy(view("rcs")), copy(view(lib))];
    for i in objects.len() {
        argv.push(item(objects, i));
    }
    if host::command(argv) != 0 {
        say(view("grail: cannot write the import library (needs llvm-ar, which ships with LLVM)"));
        return u8[];
    }
    return lib;
}
// The PE link: lld-link with the entry the compiler defines, no CRT, and the stack reserve a
// recursively written program needs (Windows gives a thread 1 MiB by default, Linux 8).
fn windows_link<a, b, d, e>(
    asm: &a [u8],
    output: &b [u8],
    object: &d [u8],
    entry: &e [u8],
    debug: u64
) -> u64 {
    dir := path_join(view(dirname(view(object))), view(".grail-win"));
    host::mkdir(view(dir));
    imports := windows_imports(view(asm), view(dir));
    mut link = u8[][
        tool(view("GRAIL_WIN_LINKER"), view("lld-link")),
        copy(view("/nologo")),
        copy(view("/machine:x64")),
        copy(view("/entry:grail_entry")),
        copy(view("/subsystem:console")),
        copy(view("/nodefaultlib")),
        copy(view("/dynamicbase")),
        copy(view("/nxcompat")),
        copy(view("/stack:8388608"))
    ];
    if debug != 0 {
        link.push(copy(view("/debug")));
        link.push(cat(view("/pdb:"), view(output)));
    }
    link.push(cat(view("/out:"), view(output)));
    link.push(copy(view(object)));
    if imports.len() != 0 {
        link.push(import_library(view(dir), &imports));
    }
    inputs := link_inputs(view(asm), view(dirname(view(entry))));
    for i in inputs.len() {
        link.push(item(&inputs, i));
    }
    if host::command(link) != 0 {
        say(view("grail: linking failed (needs lld-link, which ships with LLVM)"));
        return 1;
    }
    return 0;
}
fn put<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
    return ();
}
// The undefined C symbols of one object, exactly as the linker sees them: `nm -u` prints one per
// line. The shell passes the two paths as positional parameters, so a directory with a space in it
// is just a path here, and GRAIL_NM names the nm to use, as tools/native.mjs does. Returns 0 when
// the list was written.
fn macho_undefined<a, b>(object: &a [u8], out: &b [u8]) -> u64 {
    script := "nm=${GRAIL_NM:-llvm-nm}; \"$nm\" -u \"$1\" > \"$2\"";
    mut argv = u8[][
        copy(view("sh")),
        copy(view("-c")),
        copy(view(script)),
        copy(view("sh")),
        copy(view(object)),
        copy(view(out))
    ];
    return host::command(argv);
}
// A macOS link without an SDK: ld64.lld needs a libSystem, and a text-based stub that exports the C
// symbols the object leaves undefined is the whole of what a cross-link needs - the same linkage
// scaffolding tools/macos.mjs builds. The image still records the real /usr/lib/libSystem.B.dylib
// dependency, so a program linked here is inspected (and released) like a native one. Writes
// <object dir>/.grail-macos/libSystem.tbd and returns that directory, or nothing when the object
// has no imports to export or no nm could be run.
fn macho_libsystem<a, b, d>(object: &a [u8], arch: &b [u8], asm: &d [u8]) -> u8[] {
    dir := path_join(view(dirname(view(object))), view(".grail-macos"));
    host::mkdir(view(dir));
    names := path_join(view(dir), view("undefined"));
    if macho_undefined(view(object), view(names)) != 0 {
        return u8[];
    }
    text := host::read_file(view(names));
    host::remove(view(names), 0);
    mut symbols = u8[];
    mut count = 0;
    mut start: u64 = 0;
    mut i: u64 = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut name = u8[];
            for j in i - start {
                ch := text[start + j];
                if ch != 13 {
                    name.push(ch);
                }
            }
            if name.len() != 0 {
                if count != 0 {
                    symbols.push(44);
                    symbols.push(32);
                }
                put(&mut symbols, view(name));
                count += 1;
            }
            start = i + 1;
        }
        i += 1;
    }
    if count == 0 {
        return u8[];
    }
    // The binder is the one symbol every Mach-O image needs and no object names.
    put(&mut symbols, view(", dyld_stub_binder"));
    platform := cat(view(arch), view("-macos"));
    mut body = u8[];
    put(&mut body, view("--- !tapi-tbd\ntbd-version: 4\ntargets: [ "));
    put(&mut body, view(platform));
    put(
        &mut body,
        view(
            " ]\ninstall-name: '/usr/lib/libSystem.B.dylib'\ncurrent-version: 1311\nexports:\n  - targets: [ "
        )
    );
    put(&mut body, view(platform));
    put(&mut body, view(" ]\n    symbols: [ "));
    put(&mut body, view(symbols));
    put(&mut body, view(" ]\n...\n"));
    stub := path_join(view(dir), view("libSystem.tbd"));
    host::write_file(view(stub), view(body));
    return dir;
}
fn tool<a, b>(variable: &a [u8], fallback: &b [u8]) -> u8[] {
    v := host::env(variable);
    if v.len() != 0 {
        return v;
    }
    return copy(fallback);
}
fn compile<a, b, d, e, g, k>(
    h: (&a Home),
    entry: &b [u8],
    modules: (&d u8[][]),
    output: &e [u8],
    target: &g [u8],
    flags: u64,
    iface: &d [u8] = view(""),
    verify: u64 = 0,
    diag: &k [u8] = view(""),
    force_emit: bool = false,
    no_entry: bool = false,
    inputs: &e [u8] = view("")
) -> u64 {
    return compile_mode(
        h: h,
        entry: entry,
        modules: modules,
        output: output,
        target: target,
        flags: flags,
        iface: iface,
        verify: verify,
        diag: diag,
        force_emit: force_emit,
        no_entry: no_entry,
        inputs: inputs
    );
}
// The compiler invocation, spelled out in one place: the build cache keys on this vector, so a flag
// or an input that the driver passes is in the key by construction and cannot be forgotten there.
//   grail [--target T] [--debug] [--no-debug-info] [--deny-ambient-host] [--split] [--overflow=...]
//         [--interface DIR [--verify-interface]] OUT.s ENTRY.grl MODULE.grl... RUNTIME PLATFORM
fn build_argv<a, b, d, e, g, k>(
    h: (&a Home),
    entry: &b [u8],
    modules: (&d u8[][]),
    asm: &e [u8],
    target: &g [u8],
    flags: u64,
    iface: &d [u8] = view(""),
    verify: u64 = 0,
    diag: &k [u8] = view(""),
    force_emit: bool = false,
    no_entry: bool = false,
    inputs: &d [u8] = view("")
) -> u8[][] {
    check_only := flags % 2;
    debug := (flags / 2) % 2;
    deny := (flags / 4) % 2;
    split := (flags / 8) % 2;
    wrap := (flags / 16) % 2;
    checked := (flags / 32) % 2;
    no_sites := (flags / 256) % 2;
    verify_facts := (flags / 512) % 2;
    strict := (flags / 1024) % 2;
    emit_ir := (flags / 2048) % 2;
    release := (flags / 8192) % 2;
    report_checks := (flags / 16384) % 2;
    mut command = u8[][host::exe_path(), copy(view("--target")), copy(view(target))];
    if release != 0 {
        command.push(copy(view("--backend=llvm")));
        command.push(copy(view("--range-facts")));
    }
    cpu := (flags / 32768) % 4;
    if cpu != 0 {
        command.push(cat(view("--cpu=x86-64-v"), view(decimal(cpu + 1))));
    }
    if strict != 0 {
        command.push(copy(view("--strict-refinements")));
    }
    if emit_ir != 0 {
        command.push(copy(view("--emit-ir")));
    }
    if no_sites != 0 {
        command.push(copy(view("--no-error-sites")));
    }
    if verify_facts != 0 {
        command.push(copy(view("--verify-facts")));
    }
    if report_checks != 0 {
        command.push(copy(view("--report-checks")));
    }
    if debug != 0 {
        command.push(copy(view("--debug")));
    }
    if (flags / 131072) % 2 != 0 {
        command.push(copy(view("--no-debug-info")));
    }
    if deny != 0 {
        command.push(copy(view("--deny-ambient-host")));
    }
    if split != 0 {
        command.push(copy(view("--split")));
    }
    if wrap != 0 {
        command.push(copy(view("--overflow=wrap")));
    }
    if checked != 0 {
        command.push(copy(view("--overflow=checked")));
    }
    // B1 stage 2: `grail check --interface DIR` writes the interfaces, `grail build --interface DIR`
    // reads them instead of the modules' sources, and `--verify` compares the two.
    if no_entry {
        command.push(copy(view("--no-entry")));
    }
    if (check_only != 0) & (split == 0) & (emit_ir == 0) {
        // The compiler stops when its last diagnostic can have been given: no optimiser runs and
        // no assembly is written for a check.
        command.push(copy(view("--check")));
    }

    if iface.len() != 0 {
        mut emit = u64(check_only != 0) * u64(verify == 0);
        if force_emit {
            emit = 1;
        }
        if emit != 0 {
            command.push(copy(view("--emit-interface")));
        } else {
            command.push(copy(view("--interface")));
        }
        command.push(copy(view(iface)));
        if (emit == 0) & (verify != 0) {
            command.push(copy(view("--verify-interface")));
        }
    }
    // A driver that asked for records gets them as well as a human-readable rendering:
    // `--diagnostics-json FILE` appends one JSON object per diagnostic there and prints nothing.
    if diag.len() != 0 {
        command.push(copy(view("--diagnostics-json")));
        command.push(copy(view(diag)));
    }
    // The modules the program reaches through `use` are the compiler's to resolve: a module root is
    // the directory it looks for `ROOT/NAME.grl` in (docs/design/module-resolution.md). The stdlib is
    // a root here, so `use fs;` is enough to build against it; a project's own `src/` is a root the
    // compiler takes from the grail.toml it finds in the working directory.
    // A root named on the command line comes before the stdlib's, so a project can shadow a std
    // module by name; among themselves they keep the order given and the first root that holds a
    // module wins. The probe and the compile are both built here, so they cannot disagree.
    for i in h.roots.len() {
        command.push(copy(view("--module-root")));
        command.push(item(&h.roots, i));
    }
    if h.std.len() != 0 {
        command.push(copy(view("--module-root")));
        command.push(copy(view(h.std)));
    }
    command.push(copy(view(asm)));
    command.push(copy(view(entry)));
    for i in modules.len() {
        command.push(item(&modules, i));
    }
    command.push(copy(view(h.runtime)));
    // One platform module per target, and the target decides which: darwin.grl owns the libSystem
    // boundary, os-windows.grl the Win32 one, os-linux.grl the Linux syscalls. They define the same
    // rt_syscall* set, so only one may be compiled. Choosing by target is what lets a Linux host
    // build a Windows or macOS program, and a Windows host native ones.
    command.push(path_join(view(dirname(view(h.runtime))), view(platform_module(view(target)))));
    return command;
}
// True when the entry or any module source mentions `@embed(`.
fn sources_embed<a, b, d>(store: (&d mut Cache), entry: &a [u8], modules: (&b u8[][])) -> bool {
    if cache_file_info(&mut store, view(entry), true).embed {
        return true;
    }
    for i in modules.len() {
        if cache_file_info(&mut store, view(item(&modules, i)), true).embed {
            return true;
        }
    }
    return false;
}
// check_only: type-check and generate code, but do not assemble or link.
// The two commands that finish a release unit after its stream is assembled into `object`: `clang
// -O2` on the LLVM module the compiler wrote beside the assembly (`ASM.ll`), and a relocatable link
// that folds that object into `object`, so a release unit is still one object to the store and the
// link. `assemble` is the assembler command without its input and output; in a release build the
// stream is assembled into `release_part(object)` and the merge writes `object`.
fn release_part<a>(object: &a [u8]) -> u8[] {
    return cat(view(object), view(".s.o"));
}
fn release_optimise<a, b>(assemble: (&a u8[][]), asm: &b [u8], object: &b [u8], emulation: &b [u8]) -> u8[][][] {
    lifted := cat(view(asm), view(".ll"));
    optimised := cat(view(object), view(".ll.o"));
    native_part := release_part(view(object));
    // `grail llvm-compile` runs `clang -O2` over the module cut in parts, in parallel.
    mut clang = u8[][host::exe_path(), copy(view("llvm-compile")), copy(view("--native")), native_part.copy(), lifted.copy(), copy(view(object)), copy(view(emulation))];
    // Clang for the LLVM module, whatever assembled the native part (`grail asm` on Linux).
    clang.push(tool(view("GRAIL_ASSEMBLER"), view("clang")));
    if eq(view(emulation), view("aarch64elf")) {
        clang.push(copy(view("--target=aarch64-linux-gnu")));
    } else if eq(view(emulation), view("elf64lriscv")) {
        clang.push(copy(view("--target=riscv64-linux-gnu")));
        clang.push(copy(view("-march=rv64imafd")));
        clang.push(copy(view("-mabi=lp64d")));
    } else {
        clang.push(copy(view("--target=x86_64-linux-gnu")));
    }
    clang.push(copy(view("-c")));
    // ThinLTO across units (docs/design/separate-compilation.md, "Release builds: ThinLTO across
    // modules"): the parts are bitcode, and the unit object is one flat archive of the native part
    // and every part (`L` takes the members of the parts' archive; lld reads no nested archives).
    clang.push(copy(view("-flto=thin")));
    return u8[][][clang];
}
fn compile_mode<a, b, d, e, g, k>(
    h: (&a Home),
    entry: &b [u8],
    modules: (&d u8[][]),
    output: &e [u8],
    target: &g [u8],
    flags: u64,
    iface: &d [u8] = view(""),
    verify: u64 = 0,
    diag: &k [u8] = view(""),
    force_emit: bool = false,
    no_entry: bool = false,
    inputs: &e [u8] = view("")
) -> u64 {
    check_only := flags % 2;
    debug := (flags / 2) % 2;
    deny := (flags / 4) % 2;
    split := (flags / 8) % 2;
    wrap := (flags / 16) % 2;
    checked := (flags / 32) % 2;
    mut cache = (flags / 64) % 2;
    whole := (flags / 128) % 2;
    release := (flags / 8192) % 2;
    report_checks := (flags / 16384) % 2;
    if release != 0 {
        // The LLVM backend lifts the Linux streams; a release build of another platform, or one
        // that asks for what the lifter cannot carry, is refused rather than built native.
        linux := eq(view(target), view("x86_64")) || eq(view(target), view("aarch64")) || eq(view(target), view("riscv64"));
        if !linux {
            say(view("grail: --release builds with the LLVM backend, which is implemented for Linux x86_64, aarch64 and riscv64"));
            return 1;
        }
        if debug != 0 {
            say(view("grail: --release and --debug cannot be combined yet: the LLVM backend writes no line tables"));
            return 1;
        }
        if split != 0 {
            say(view("grail: --release and --split cannot be combined"));
            return 1;
        }
    }
    // The store, which also answers what the driver asks of the sources (`fp/`, cache_file_info).
    // A build with no store reads each source for its answers.
    mut store = Cache {
        root: u8[],
        cwd: host::cwd(),
        hits: 0,
        misses: 0,
        names: u8[][],
        quiet: (flags / 4096) % 2,
        seen_paths: u8[][],
        seen_stamps: u8[][],
        seen: FileInfo[],
        seen_filed: u64[],
        pend_notes: u8[][],
        pend_bodies: u8[][],
        pend_waits: u8[][][],
    };
    if cache != 0 {
        store.root = cache_root(view(target));
        cache_ensure(&mut store);
    }
    if (cache != 0) && sources_embed(&mut store, view(entry), &modules) {
        // `@embed` reads a file the cache does not key on, so its result cannot be reused safely.
        say(
            view(
                "grail: --cache is skipped: a source uses @embed, whose file the cache does not track"
            )
        );
        cache = 0;
        store.root = u8[];
    }
    asm := cat(view(output), view(".s"));
    object := cat(view(output), view(".o"));
    // The toolchain is decided by the target alone, so it is known before the compiler runs - which
    // is what lets a build cache key on the assembler and the linker as well as on the sources.
    mut triple = copy(view("--target=x86_64-linux-gnu"));
    mut emulation = copy(view("elf_x86_64"));
    // Mach-O targets reuse the CPU backends but have their own object format and linker.
    mut macho = 0;
    mut arch = copy(view("x86_64"));
    if eq(view(target), view("macos-x86_64")) {
        triple = copy(view("--target=x86_64-apple-macos11"));
        macho = 1;
    }
    if eq(view(target), view("macos-aarch64")) {
        triple = copy(view("--target=arm64-apple-macos11"));
        arch = copy(view("arm64"));
        macho = 1;
    }
    if eq(view(target), view("aarch64")) {
        triple = copy(view("--target=aarch64-linux-gnu"));
        emulation = copy(view("aarch64elf"));
    }
    // A PE/COFF object is not an ELF one: the assembler has to be told which object format to
    // write, and the link below is lld-link's, not ld.lld's.
    mut pe = 0;
    if eq(view(target), view("windows-x86_64")) {
        triple = copy(view("--target=x86_64-pc-windows-msvc"));
        pe = 1;
    }
    // The assembler: the compiler's own (`grail asm`, compiler/asm_x86.grl) for a Linux x86-64
    // build it covers (Linux x86-64, AArch64, RISC-V - a release build's native part included, which
    // it assembles to the same symbols as clang in a third of the time - and Windows x86-64), clang
    // otherwise (macOS, Windows on Arm). A release build's LLVM module is clang's either way (`grail
    // llvm-compile`).
    linux := eq(view(target), view("x86_64")) || eq(view(target), view("aarch64")) || eq(view(target), view("riscv64"));
    internal := (linux || eq(view(target), view("windows-x86_64")) || eq(view(target), view("macos-aarch64"))) && ((release == 0) || linux);
    mut assemble = u8[][tool(view("GRAIL_ASSEMBLER"), view("clang"))];
    if internal {
        assemble = u8[][host::exe_path(), copy(view("asm"))];
        if !eq(view(target), view("x86_64")) {
            assemble.push(copy(view("--target")));
            assemble.push(copy(view(target)));
        }
    }
    if eq(view(target), view("riscv64")) {
        triple = copy(view("--target=riscv64-linux-gnu"));
        emulation = copy(view("elf64lriscv"));
        if !internal {
            assemble.push(copy(view("-march=rv64imafd")));
            assemble.push(copy(view("-mabi=lp64d")));
        }
    }
    if !internal {
        assemble.push(triple);
        assemble.push(copy(view("-c")));
    }
    // `--cpu=LEVEL` (docs/design/simd.md, S4b): x86-64 only for now; a release build's clang
    // optimises for the level too (the native backend reads it from the compiler argument).
    cpu := (flags / 32768) % 4;
    if cpu != 0 {
        if !eq(view(target), view("x86_64")) && !eq(view(target), view("windows-x86_64")) && !eq(view(target), view("macos-x86_64")) {
            say(view("grail: `--cpu` levels are x86-64's; this target builds for its baseline"));
            return 2;
        }
        if release != 0 {
            assemble.push(cat(view("-march=x86-64-v"), view(decimal(cpu + 1))));
        }
    }
    command := build_argv(
        h: &h,
        entry: view(entry),
        modules: &modules,
        asm: view(asm),
        target: view(target),
        flags: flags,
        iface: iface,
        verify: verify,
        diag: diag,
        force_emit: force_emit,
        no_entry: no_entry,
        inputs: inputs
    );
    if inputs.len() != 0 {
        // `--print-inputs FILE` is the resolution oracle: the same command runs once more with the
        // flag, writes the module set it settled, and stops before assembling. The build below is
        // the ordinary command, so a caller can ask what a build resolved and still get the build.
        probe := build_argv(
            h: &h,
            entry: view(entry),
            modules: &modules,
            asm: view(asm),
            target: view(target),
            flags: flags,
            iface: iface,
            verify: verify,
            diag: diag,
            force_emit: force_emit,
            no_entry: no_entry,
            inputs: inputs
        );
        host::command(probe);
    }
    // The shape of the build. A program of more than one module of its own is built one compiler run
    // per module, each reading the interfaces the runs before it wrote (B1 stage 4). `--whole-program`
    // and `--split` ask for the one-run shapes, an `--interface` build checks every module against its
    // interface in one run, a check-only run needs no code, and the modules are what the cache reuses,
    // so `--cache` asks for them too. Beyond the Linux targets there is no per-module object path, so
    // those targets build the whole program.
    mut per_module = 0;
    mut groups = ModuleGroup[];
    at := source_start(&command, view(asm));
    if (whole == 0)
        & (split == 0)
        & ((check_only == 0) || (cache != 0))
        & (iface.len() == 0)
        & (at < command.len())
        & linux_target(view(target)) {
        groups = source_groups(&mut store, &command, at);
        if (cache != 0) || (program_modules(&groups) > 1) {
            per_module = 1;
        }
        if per_module != 0 {
            // One run per module, so every module the program has needs a group, and the module set is
            // the compiler's: it resolves `use` through the roots and names what it will compile.
            groups = resolved_groups(&mut store, &command, at, view(cat(view(asm), view(".inputs"))));
            if groups.len() == 0 {
                return 1;
            }
            if (cache == 0) & (program_modules(&groups) < 2) {
                // Resolution settled a program of one module (a lone entry that uses std modules):
                // that is one compiler run, not a per-module build, so nothing is split into parts.
                per_module = 0;
            }
        }
    }
    // B1 stage 4: an unchanged program is not rebuilt at all, and what is rebuilt assembles and links
    // through the content-addressed store. Without --cache nothing below changes a thing.
    mut id = BuildId {
        flags: u8[],
        compiler: u8[],
        assembler: u8[],
        linker: u8[],
        ifaces: u8[],
        iface_dir: u8[],
        sources: u8[][],
        digests: u8[][],
    };
    mut program = u8[];
    if cache != 0 {
        id = cache_build_id(&mut store, &command, view(asm), view(emulation), &assemble);
        program = cache_program_key(&mut store, &id, view(target), view(asm));
        // `--verify` asks for the interfaces to be checked against the sources, and `--check` asks for
        // the program to be checked at all: a build that skips the compiler run has to skip the
        // shortcut instead.
        if (verify == 0) & (check_only == 0) {
            if cache_up_to_date(&mut store, view(program), view(output)) == 1 {
                return 0;
            }
        }
    }
    if per_module != 0 {
        // One jobserver for every process of this build (compiler/jobs.grl): the module runs, their
        // optimiser workers and their body workers all take their tokens from it. A build started
        // inside one (`make -j`, or another `grail`) uses that one; otherwise this process makes
        // it, beside the output, and the processes it starts find it in their environment.
        mut js = jobs::open();
        mut env = host::environment();
        mut made = u8[];
        if js.rfd == 0 {
            path := cat(view(output), view(".jobs"));
            js = jobs::create(view(path), jobs::count());
            if js.rfd != 0 {
                env.push(cat(view("GRAIL_JOBSERVER="), view(path)));
                made = path;
            }
        }
        built := per_module_build(
            &command,
            at,
            &mut groups,
            view(output),
            view(target),
            view(emulation),
            &assemble,
            &mut store,
            &id,
            view(program),
            cache,
            &mut js,
            &env
        );
        jobs::give_all(&mut js);
        if made.len() != 0 {
            host::close(js.rfd);
            host::remove(view(made), 0);
        }
        cache_seen_flush(&mut store);
        return built;
    }
    // The internal assembler runs inside the compiler run when the build is one object: the run
    // writes the object itself (`--object`), and the assembly file keeps only the link notes.
    inproc := internal && (split == 0) && (check_only == 0);
    mut run = u8[][];
    for k in command.len() {
        run.push(item(&command, k));
        if inproc && (k == 0) {
            run.push(copy(view("--object")));
            // A release build's run writes the native part; llvm-compile archives it with the
            // optimised LLVM module as `object`.
            if release != 0 {
                run.push(release_part(view(object)));
            } else {
                run.push(object.copy());
            }
        }
    }
    if host::command(run) != 0 {
        return 1;
    }
    if check_only != 0 {
        if split != 0 {
            remove_split(view(output));
        } else {
            host::remove(view(asm), 0);
        }
        return 0;
    }
    if split != 0 {
        if cache != 0 {
            return cache_split(
                &mut store,
                &id,
                view(dirname(view(entry))),
                view(output),
                view(target),
                view(emulation),
                &assemble,
                view(program)
            );
        }
        return build_split(
            view(dirname(view(entry))),
            view(output),
            view(target),
            view(emulation),
            &assemble
        );
    }
    optimise := release_optimise(&assemble, view(asm), view(object), view(emulation));
    assemble.push(copy(view(asm)));
    assemble.push(copy(view("-o")));
    if release != 0 {
        assemble.push(release_part(view(object)));
    } else {
        assemble.push(copy(view(object)));
    }
    if !inproc && (host::command(assemble) != 0) {
        say(view("grail: assembling failed (needs clang)"));
        return 1;
    }
    if release != 0 {
        for k in optimise.len() {
            mut step = u8[][];
            for w in optimise[k].len() {
                step.push(item(&optimise[k], w));
            }
            if host::command(step) != 0 {
                say(view("grail: optimising the LLVM module failed (needs clang and ld.lld)"));
                return 1;
            }
        }
    }
    if pe != 0 {
        // A Windows x86-64 development build carries CodeView line tables unless told not to
        // (`--no-debug-info`), and /debug is what turns them into the PDB beside the image.
        lines := (release == 0) & ((flags / 131072) % 2 == 0) & eq(view(target), view("windows-x86_64"));
        return windows_link(view(asm), view(output), view(object), view(entry), debug | u64(lines));
    }
    if macho != 0 {
        mut link = u8[][
            tool(view("GRAIL_LINKER"), view("ld64.lld")),
            copy(view("-arch")),
            copy(view(arch)),
            copy(view("-platform_version")),
            copy(view("macos")),
            copy(view("11.0")),
            copy(view("11.0"))
        ];
        sdk := host::env(view("GRAIL_SDK"));
        if sdk.len() != 0 {
            libs := path_join(view(sdk), view("usr/lib"));
            link.push(copy(view("-syslibroot")));
            link.push(copy(view(sdk)));
            link.push(cat(view("-L"), view(libs)));
            link.push(copy(view("-lSystem")));
        } else {
            // No SDK on this host: the stub stands in for libSystem (see macho_libsystem).
            stub := macho_libsystem(view(object), view(arch), view(asm));
            if stub.len() == 0 {
                say(
                    view(
                        "grail: the Mach-O object is assembled, but no libSystem to link it against"
                    )
                );
                say(view("grail: set GRAIL_SDK to a macOS SDK, or put llvm-nm on PATH"));
                return 1;
            }
            link.push(cat(view("-L"), view(stub)));
            link.push(copy(view("-lSystem")));
        }
        link.push(copy(view("-e")));
        link.push(copy(view("_main")));
        link.push(copy(view(object)));
        link.push(copy(view("-o")));
        link.push(copy(view(output)));
        inputs := link_inputs(view(asm), view(dirname(view(entry))));
        for i in inputs.len() {
            link.push(item(&inputs, i));
        }
        if host::command(link) != 0 {
            say(view("grail: linking failed (needs ld64.lld, and an SDK or llvm-nm)"));
            return 1;
        }
        return 0;
    }
    mut link = u8[][
        tool(view("GRAIL_LINKER"), view("ld.lld")),
        copy(view("-m")),
        emulation,
        copy(view(object))
    ];
    inputs := link_inputs(view(asm), view(dirname(view(entry))));
    for i in inputs.len() {
        link.push(item(&inputs, i));
    }
    dynamic := dynamic_link_flags(view(target), &inputs);
    for i in dynamic.len() {
        link.push(item(&dynamic, i));
    }
    link.push(copy(view("-o")));
    link.push(copy(view(output)));
    if host::command(link) != 0 {
        say(view("grail: linking failed (needs ld.lld)"));
        return 1;
    }
    return 0;
}
// A --split build: the compiler already wrote one assembly file per module and the manifest that
// lists them; assemble them concurrently and link them once, in manifest order.
fn build_split<a, b, d, e, g>(
    base: &a [u8],
    output: &b [u8],
    target: &d [u8],
    emulation: &e [u8],
    prefix: (&g u8[][])
) -> u64 {
    if is_macho(view(target)) {
        say(view("grail: --split is implemented for the Linux x86_64 assembler path"));
        return 1;
    }
    manifest := cat(view(output), view(".parts"));
    text := host::read_file(view(manifest));
    if !starts(view(text), view("// grail-parts 1")) {
        say(view("grail: missing or unreadable parts manifest "));
        say(view(manifest));
        return 1;
    }
    parts := read_split(view(manifest), view(base));
    if parts.asm.len() == 0 {
        say(view("grail: the parts manifest lists no modules"));
        return 1;
    }
    if assemble_parts(&prefix, &parts.asm, &parts.objects) != 0 {
        say(view("grail: assembling failed (needs clang)"));
        return 1;
    }
    return link_objects(view(output), view(target), view(emulation), &parts.objects, &parts.link);
}
// ---- B1 stage 4: one compiler invocation per module (`grail build --per-module`) ----
// The program's sources are grouped by the module each declares; the groups are compiled in
// dependency order, each by its own compiler run that reads only the interfaces of modules built
// before it and writes its own interface beside them, then every run's parts are assembled and the
// program is linked once. A module's run parses that module's source and no other.
struct ModuleGroup {
    name: u8[],
    files: u8[][],
    uses: u8[][],
    done: u64
}
fn ident_byte(c: u8) -> bool {
    return ((c >= 97) & (c <= 122))
        || ((c >= 65) & (c <= 90))
        || ((c >= 48) & (c <= 57))
        || (c == 95);
}
fn group_of<a, b>(groups: (&a ModuleGroup[]), name: &b [u8]) -> u64 {
    for i in groups.len() {
        if eq(view(groups[i].name), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
// Where a build command's sources start: the output assembly file comes before them.
fn source_start<a, b>(command: (&a u8[][]), asm: &b [u8]) -> u64 {
    mut at = 0;
    while (at < command.len()) && !eq(view(item(&command, at)), view(asm)) {
        at += 1;
    }
    return at;
}
// The command's sources grouped by the module each declares. The runtime and platform files come
// last in every build command and declare no module: the compiler treats them as module `runtime`,
// the base every module's code calls into, so that group is built first. Any other file without a
// `module` line is the entry's, module `main`.
fn source_groups<a, d>(store: (&d mut Cache), command: (&a u8[][]), at: u64) -> ModuleGroup[] {
    mut groups = ModuleGroup[];
    count := command.len() - at - 1;
    for j in count {
        file := item(&command, at + 1 + j);
        mut info = cache_file_info(&mut store, view(file), true);
        mut name = copy(view("main"));
        if count - 2 <= j {
            name = copy(view("runtime"));
        }
        if info.module.len() != 0 {
            name = info.module.copy();
        }
        uses := exchange(&mut info.uses, u8[][]);
        g := group_of(&groups, view(name));
        if g == 0 {
            groups.push(ModuleGroup { name: name, files: u8[][file], uses: uses, done: 0 });
        } else {
            groups[g - 1].files.push(file);
            for u in uses.len() {
                groups[g - 1].uses.push(item(&uses, u));
            }
        }
    }
    return groups;
}
// The module set a command resolves to, remembered: `inputs/<key>` holds the compiler's answer to
// `--print-inputs` with the stamp of every file it named and of every directory resolution looked
// in (each module root, each named file's directory, the working directory and its `src/`). A
// directory's time moves when an entry is added or removed, a file's when it is written, so while
// every stamp holds the compiler would answer the same, and no compiler is started to ask it.
fn resolved_key<a, b, d>(store: (&a mut Cache), probe: (&b u8[][]), command: (&d u8[][])) -> u8[] {
    if store.root.len() == 0 {
        return u8[];
    }
    mut text = copy(view("grail-inputs 1\n"));
    push_bytes(&mut text, view(store.cwd));
    text.push(10);
    // The compiler that answers: its path and stamp.
    exe := item(command, 0);
    push_bytes(&mut text, view(file_stamp(view(exe))));
    text.push(10);
    for i in probe.len() {
        push_bytes(&mut text, view(item(probe, i)));
        text.push(10);
    }
    return path_join(view(path_join(view(store.root), view("inputs"))), view(store_hash(view(text))[0..32]));
}
// The directories a resolution of `command` reads, beside the files it settled on.
fn resolved_dirs<a, b>(store: (&a mut Cache), command: (&b u8[][]), settled: (&b u8[][])) -> u8[][] {
    mut dirs = u8[][copy(view(".")), copy(view("src"))];
    for i in command.len() {
        word := item(command, i);
        if eq(view(word), view("--module-root")) && (i + 1 < command.len()) {
            dirs.push(item(command, i + 1));
        } else if ends_with_grl(view(word)) {
            dirs.push(dirname(view(word)));
        }
    }
    for i in settled.len() {
        dirs.push(dirname(view(item(settled, i))));
    }
    mut unique = u8[][];
    for i in dirs.len() {
        mut seen = false;
        for k in unique.len() {
            if eq(view(unique[k]), view(dirs[i])) {
                seen = true;
            }
        }
        if !seen {
            unique.push(dirs[i].copy());
        }
    }
    return unique;
}
fn resolved_paths<a>(text: &a [u8]) -> u8[][] {
    mut paths = u8[][];
    rows := lines(view(text));
    for r in rows.len() {
        row := item(&rows, r);
        for k in row.len() {
            if row[k] == 9 {
                paths.push(row[k + 1..row.len()].copy());
                break;
            }
        }
    }
    return paths;
}
fn resolved_inputs<a>(note: &a [u8]) -> u8[] {
    if (note.len() == 0) || (host::exists(view(note)) == 0) {
        return u8[];
    }
    // `F <stamp>\t<path>` and `D <stamp>\t<dir>` lines, a `--` line, then the answer.
    body := host::read_file(view(note));
    mut i = 0;
    while i < body.len() {
        mut end = i;
        while (end < body.len()) && (body[end] != 10) {
            end += 1;
        }
        row := body[i..end].copy();
        if eq(view(row), view("--")) {
            return body[end + 1..body.len()].copy();
        }
        mut tab = 0;
        while (tab < row.len()) && (row[tab] != 9) {
            tab += 1;
        }
        if (row.len() < 3) || (tab == row.len()) {
            return u8[];
        }
        path := row[tab + 1..row.len()].copy();
        mut now = u8[];
        if row[0] == 70 {
            now = file_stamp(view(path));
        } else {
            now = dir_stamp(view(path));
        }
        if !eq(view(row[2..tab]), view(now)) {
            return u8[];
        }
        i = end + 1;
    }
    return u8[];
}
fn resolved_note<a, b, d, e>(store: (&a mut Cache), note: &b [u8], command: (&d u8[][]), text: &e [u8], probe_ms: u64) -> unit {
    if note.len() == 0 {
        return ();
    }
    settled := resolved_paths(view(text));
    mut body = u8[];
    // A file the probe read within a tick of its write may change again under the same stamp: the
    // record waits for the end of the build, when that file is read again (cache_seen_flush).
    mut waits = u8[][];
    for i in settled.len() {
        path := item(&settled, i);
        stamp := file_stamp(view(path));
        if stamp.len() == 0 {
            return ();
        }
        if !read_settled(view(path), probe_ms) {
            waits.push(path.copy());
        }
        push_bytes(&mut body, view("F "));
        push_bytes(&mut body, view(stamp));
        body.push(9);
        push_bytes(&mut body, view(path));
        body.push(10);
    }
    dirs := resolved_dirs(&mut store, command, &settled);
    for i in dirs.len() {
        push_bytes(&mut body, view("D "));
        push_bytes(&mut body, view(dir_stamp(view(dirs[i]))));
        body.push(9);
        push_bytes(&mut body, view(dirs[i]));
        body.push(10);
    }
    push_bytes(&mut body, view("--\n"));
    push_bytes(&mut body, view(text));
    if waits.len() != 0 {
        store.pend_notes.push(copy(view(note)));
        store.pend_bodies.push(body);
        store.pend_waits.push(waits);
        return ();
    }
    cache_put_file(&mut store, view(note), view(body));
    return ();
}
// The modules the build will really compile, as the compiler settles them: the entry, the modules named
// on the command line, the runtime and platform files, and everything the `use` lines reached through a
// module root (docs/design/module-resolution.md). The driver asks (`--print-inputs FILE`) rather than
// scanning for a module set of its own, so a per-module build has a group for every module the program
// has - including the standard ones - and no unit is compiled twice.
fn resolved_groups<a, d>(store: (&d mut Cache), command: (&a u8[][]), at: u64, list: &a [u8]) -> ModuleGroup[] {
    mut probe = u8[][];
    for i in at {
        probe.push(item(&command, i));
    }
    probe.push(copy(view("--print-inputs")));
    probe.push(copy(view(list)));
    for i in command.len() - at {
        probe.push(item(&command, at + i));
    }
    mut groups = ModuleGroup[];
    note := resolved_key(&mut store, &probe, command);
    mut text = resolved_inputs(view(note));
    if text.len() == 0 {
        probe_ms := host::wall_ms();
        if host::command(probe) != 0 {
            // The compiler printed why (an unresolvable `use` names the module and the roots it
            // searched).
            return groups;
        }
        text = host::read_file(view(list));
        host::remove(view(list), 0);
        resolved_note(&mut store, view(note), command, view(text), probe_ms);
    }
    mut start = 0;
    mut i = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut cut = start;
            while cut < i {
                if text[cut] == 9 {
                    break;
                }
                cut += 1;
            }
            if (cut < i) & (cut > start) {
                mut name = u8[];
                for j in start..cut {
                    name.push(text[j]);
                }
                mut path = u8[];
                for j in cut + 1..i {
                    path.push(text[j]);
                }
                uses := cache_file_info(&mut store, view(path), true).uses;
                g := group_of(&groups, view(name));
                if g == 0 {
                    groups.push(ModuleGroup { name: name, files: u8[][path], uses: uses, done: 0 });
                } else {
                    groups[g - 1].files.push(path);
                    for u in uses.len() {
                        groups[g - 1].uses.push(item(&uses, u));
                    }
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    // `core` is a dependency of every module, with no `use` line to say so: `Some(value)` and `None`
    // lower to its constructors, so a unit compiled before it looks up `some` in a module nothing
    // has declared yet ("unknown function `some` in `core`", in whichever module first writes one).
    // `core` has dependencies of its own - it `use`s `result`, whose `Option` is the type `T?` names
    // - and those are the bottom of the order rather than a cycle, so they are the prelude: built
    // before `core`, and the only modules that do not get the implicit dependency.
    if group_of(&groups, view("core")) != 0 {
        mut prelude = u8[][copy(view("core"))];
        mut k = 0;
        while k < prelude.len() {
            here := prelude[k].copy();
            k += 1;
            at := group_of(&groups, view(here));
            if at == 0 {
                continue;
            }
            for u in groups[at - 1].uses.len() {
                used := groups[at - 1].uses[u].copy();
                mut have = 0;
                for i in prelude.len() {
                    if eq(view(prelude[i]), view(used)) {
                        have = 1;
                    }
                }
                if have == 0 {
                    prelude.push(used);
                }
            }
        }
        // `vecs` (a vector's sort, search and sum) and `strings` (text's split, trim, lines and join)
        // are every program module's dependencies as well, except for the modules each is built from:
        // everything its own `use` lines reach, and `scalar`, which every module depends on.
        mut below = u8[][][];
        mut implicit_names = u8[][];
        for which in 4 {
            mut name = "vecs";
            if which == 1 {
                name = "strings";
            } else if which == 2 {
                name = "clone";
            } else if which == 3 {
                name = "math";
            }
            if group_of(&groups, view(name)) != 0 {
                implicit_names.push(copy(view(name)));
                below.push(module_closure(&groups, view(name)));
            }
        }
        for g in groups.len() {
            name := groups[g].name.copy();
            mut in_prelude = 0;
            for i in prelude.len() {
                if eq(view(prelude[i]), view(name)) {
                    in_prelude = 1;
                }
            }
            if (in_prelude == 0) & !eq(view(name), view("runtime")) {
                groups[g].uses.push(copy(view("core")));
                // `scalar` (the integers', `char`'s and the floats' methods) is every module's
                // dependency in the same way, except its own and the prelude's.
                if (group_of(&groups, view("scalar")) != 0) & !eq(view(name), view("scalar")) {
                    groups[g].uses.push(copy(view("scalar")));
                }
                // A module an implicit one is built from - or an implicit module itself - gets none of
                // them: the standard library below them orders by its own `use` lines.
                mut under = 0;
                for m in implicit_names.len() {
                    for i in below[m].len() {
                        if eq(view(below[m][i]), view(name)) {
                            under = 1;
                        }
                    }
                }
                if under == 0 {
                    for m in implicit_names.len() {
                        groups[g].uses.push(implicit_names[m].copy());
                    }
                }
            }
        }
    }
    return groups;
}
// `name` and every module its `use` lines reach, with `scalar` (every module's implicit dependency).
fn module_closure<a, b>(groups: (&a ModuleGroup[]), name: &b [u8]) -> u8[][] {
    mut out = u8[][copy(name), copy(view("scalar"))];
    mut q = 0;
    while q < out.len() {
        here := out[q].copy();
        q += 1;
        g := group_of(groups, view(here));
        if g == 0 {
            continue;
        }
        for u in groups[g - 1].uses.len() {
            used := item(&groups[g - 1].uses, u);
            mut seen = 0;
            for i in out.len() {
                if eq(view(out[i]), view(used)) {
                    seen = 1;
                }
            }
            if seen == 0 {
                out.push(used);
            }
        }
    }
    return out;
}
// The program's own modules. The runtime and platform files are the base group every program has,
// and the standard library's core prelude (with `scalar`) is compiled whether a module names it or not, so neither
// makes a program multi-module: what is left is what the program is made of.
fn program_modules<a>(groups: (&a ModuleGroup[])) -> u64 {
    mut n = groups.len();
    if group_of(&groups, view("runtime")) != 0 {
        n -= 1;
    }
    if group_of(&groups, view("core")) != 0 {
        n -= 1;
    }
    if group_of(&groups, view("scalar")) != 0 {
        n -= 1;
    }
    if group_of(&groups, view("vecs")) != 0 {
        n -= 1;
    }
    if group_of(&groups, view("strings")) != 0 {
        n -= 1;
    }
    return n;
}
// The Linux ELF targets: the ones a program build makes separate objects for and links with ld.lld.
fn linux_target<a>(target: &a [u8]) -> bool {
    return !is_macho(view(target)) && !starts(view(target), view("windows"));
}
fn bytes_less<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    mut i = 0;
    while (i < x.len()) & (i < y.len()) {
        if x[i] != y[i] {
            return x[i] < y[i];
        }
        i += 1;
    }
    return x.len() < y.len();
}
// The cache key of one module's compiler run (B1 stage 4): the build's flags, compiler and assembler,
// the target, the module's name and its own source files, and every interface the run can read - the
// modules it uses and the ones those use, by name and content. An edit that leaves a module's
// interface unchanged therefore reruns that module alone; one that changes it reruns the modules
// that read it.
fn unit_key<a, b, d, e, g, k, r>(
    store: (&a mut Cache),
    id: (&b BuildId),
    target: &d [u8],
    name: &e [u8],
    files: (&g u8[][]),
    ifaces: &k [u8],
    reads: (&r u8[][])
) -> u8[] {
    mut buf = u8[];
    push_bytes(&mut buf, view("grail-cache-unit 1\ntarget "));
    push_bytes(&mut buf, view(target));
    push_bytes(&mut buf, view("\nflags "));
    push_bytes(&mut buf, view(id.flags));
    push_bytes(&mut buf, view("\ncompiler "));
    push_bytes(&mut buf, view(id.compiler));
    push_bytes(&mut buf, view("\nassembler "));
    push_bytes(&mut buf, view(id.assembler));
    push_bytes(&mut buf, view("\nmodule "));
    push_bytes(&mut buf, view(name));
    buf.push(10);
    for i in files.len() {
        f := item(&files, i);
        push_bytes(&mut buf, view("source "));
        push_bytes(&mut buf, view(cache_digest_file(&mut store, view(f))));
        buf.push(32);
        push_bytes(&mut buf, view(f));
        buf.push(10);
    }
    // The interfaces this run can read: the modules it uses and theirs, not whatever else happens
    // to have been built already - modules are built several at a time, and a key that named its
    // neighbours would be a different key from one build to the next.
    mut names = u8[][];
    for i in reads.len() {
        // A module with no interface file has no surface to read (the runtime's is the compiler's
        // own knowledge of it, which the compiler digest above already names).
        file := cat(view(reads[i]), view(".iface"));
        if host::exists(view(path_join(view(ifaces), view(file)))) != 0 {
            names.push(file);
        }
    }
    // The effect summary of a module with no interface (the runtime's `runtime.facts`): what this
    // run's own summaries are computed from, so a change in it is a change in this run's input.
    for i in reads.len() {
        facts := cat(view(reads[i]), view(".facts"));
        fpath := path_join(view(ifaces), view(facts));
        if host::exists(view(fpath)) != 0 {
            push_bytes(&mut buf, view("facts "));
            push_bytes(&mut buf, view(cache_digest_file(&mut store, view(fpath))));
            buf.push(32);
            push_bytes(&mut buf, view(facts));
            buf.push(10);
        }
    }
    for i in names.len() {
        n := item(&names, i);
        // An interface's surface: every byte before the trailer, which carries only the source
        // digest and the file's own digest. An edit that keeps the surface keeps every other
        // module's key.
        text := host::read_file(view(path_join(view(ifaces), view(n))));
        surface := native::iface_surface(view(text));
        push_bytes(&mut buf, view("interface "));
        push_bytes(&mut buf, view(store_hash(view(surface))));
        buf.push(32);
        push_bytes(&mut buf, view(n));
        buf.push(10);
    }
    return store_hash(view(buf));
}
// Put a module run's outputs back from the store: its object, the link inputs its own sources ask
// for, and its interface. Any missing or damaged blob makes it a miss (nothing is half-restored that
// a later step would trust: the run that follows rewrites all of it).
fn unit_restore<a, b, d, e, g>(
    store: (&a mut Cache),
    key: &b [u8],
    stem: &d [u8],
    ifaces: &e [u8],
    name: &g [u8]
) -> bool {
    path := cache_record_path(view(store.root), view("unit"), view(key));
    if host::exists(view(path)) == 0 {
        return false;
    }
    cache_touch(view(store.root), view("unit"), view(key));
    text := host::read_file(view(path));
    rows := lines(view(text));
    mut links_blob = u8[];
    mut obj_blob = u8[];
    mut iface_blob = u8[];
    mut facts_blob = u8[];
    for i in rows.len() {
        w := words(view(item(&rows, i)));
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("links")) {
            links_blob = item(&w, 1);
        }
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("obj")) {
            obj_blob = item(&w, 1);
        }
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("iface")) {
            iface_blob = item(&w, 1);
        }
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("facts")) {
            facts_blob = item(&w, 1);
        }
    }
    if (links_blob.len() == 0) || (obj_blob.len() == 0) {
        return false;
    }
    if !cache_blob_ok(&mut store, view(links_blob)) || !cache_blob_ok(&mut store, view(obj_blob)) {
        return false;
    }
    if (iface_blob.len() != 0) && !cache_blob_ok(&mut store, view(iface_blob)) {
        return false;
    }
    if (facts_blob.len() != 0) && !cache_blob_ok(&mut store, view(facts_blob)) {
        return false;
    }
    if cache_blob_restore(&mut store, view(links_blob), view(unit_links_path(view(stem))), 0) != 0 {
        return false;
    }
    if cache_blob_restore(&mut store, view(obj_blob), view(cat(view(stem), view(".o"))), 0) != 0 {
        return false;
    }
    if iface_blob.len() != 0 {
        dest := path_join(view(ifaces), view(cat(view(name), view(".iface"))));
        if cache_blob_restore(&mut store, view(iface_blob), view(dest), 0) != 0 {
            return false;
        }
    }
    if facts_blob.len() != 0 {
        dest := path_join(view(ifaces), view(cat(view(name), view(".facts"))));
        if cache_blob_restore(&mut store, view(facts_blob), view(dest), 0) != 0 {
            return false;
        }
    }
    return true;
}
// Where a unit's link inputs are written: beside its object, so a cached unit and a compiled one
// hand the link the same list.
fn unit_links_path<a>(stem: &a [u8]) -> u8[] {
    return cat(view(stem), view(".links"));
}
// The `// grail-link:` requests of one unit, one per line, resolved against its own sources.
fn write_unit_links<a>(stem: &a [u8], asm: &a [u8], files: (&a u8[][])) -> u64 {
    mut base = copy(view("."));
    if files.len() != 0 {
        base = dirname(view(item(&files, 0)));
    }
    if host::exists(view(asm)) == 0 {
        return 1;
    }
    inputs := link_inputs(view(asm), view(base));
    mut text = u8[];
    for i in inputs.len() {
        push_bytes(&mut text, view(item(&inputs, i)));
        text.push(10);
    }
    return host::write_file(view(unit_links_path(view(stem))), view(text));
}
// File a module run's outputs under its key, after they assembled: the object, the link inputs and
// the interface.
fn unit_file<a, b, d, e, g>(
    store: (&a mut Cache),
    key: &b [u8],
    stem: &d [u8],
    ifaces: &e [u8],
    name: &g [u8]
) -> unit {
    links_blob := cache_blob_put(&mut store, view(unit_links_path(view(stem))));
    if links_blob.len() != 64 {
        return ();
    }
    obj_blob := cache_blob_put(&mut store, view(cat(view(stem), view(".o"))));
    if obj_blob.len() != 64 {
        return ();
    }
    mut record = u8[];
    push_bytes(&mut record, view("// grail-cache-unit 2\nmodule "));
    push_bytes(&mut record, view(name));
    push_bytes(&mut record, view("\nlinks "));
    push_bytes(&mut record, view(links_blob));
    push_bytes(&mut record, view("\nobj "));
    push_bytes(&mut record, view(obj_blob));
    record.push(10);
    iface := path_join(view(ifaces), view(cat(view(name), view(".iface"))));
    if host::exists(view(iface)) != 0 {
        b := cache_blob_put(&mut store, view(iface));
        if b.len() != 64 {
            return ();
        }
        push_bytes(&mut record, view("iface "));
        push_bytes(&mut record, view(b));
        record.push(10);
    }
    // The runtime's effect summary: the one output a run writes beside the interfaces that is not an
    // interface (docs/design/effects.md).
    facts := path_join(view(ifaces), view(cat(view(name), view(".facts"))));
    if host::exists(view(facts)) != 0 {
        b := cache_blob_put(&mut store, view(facts));
        if b.len() != 64 {
            return ();
        }
        push_bytes(&mut record, view("facts "));
        push_bytes(&mut record, view(b));
        record.push(10);
    }
    cache_record_put(&mut store, view("unit"), view(key), view(record));
    return ();
}
// Whether every module `g` reads is finished: the base (the runtime) for all of them, then the
// modules it uses.
// A check's record of one module: what a run that reads it needs - its interface and its facts - and
// no object, so a build never takes it for its own (unit_restore asks for the object). Filed under
// the same key as a build's record, in a kind of its own.
fn unit_file_check<a, b, e, g>(store: (&a mut Cache), key: &b [u8], ifaces: &e [u8], name: &g [u8]) -> unit {
    mut record = u8[];
    push_bytes(&mut record, view("// grail-cache-check 1\nmodule "));
    push_bytes(&mut record, view(name));
    record.push(10);
    for ext in 2 {
        mut suffix = copy(view(".iface"));
        mut word = copy(view("iface "));
        if ext == 1 {
            suffix = copy(view(".facts"));
            word = copy(view("facts "));
        }
        file := path_join(view(ifaces), view(cat(view(name), view(suffix))));
        if host::exists(view(file)) != 0 {
            b := cache_blob_put(&mut store, view(file));
            if b.len() != 64 {
                return ();
            }
            push_bytes(&mut record, view(word));
            push_bytes(&mut record, view(b));
            record.push(10);
        }
    }
    cache_record_put(&mut store, view("check"), view(key), view(record));
    return ();
}
// A check's restore: a build's record of the module (the same key) or a check's, of which only the
// interface and the facts are put back.
//
// `needed`: another run of this program reads what this one writes (its interface, or the runtime's
// effect summary), so a record with neither - a check of a module nothing read, which writes none -
// is a miss.
fn unit_restore_check<a, b, e, g>(store: (&a mut Cache), key: &b [u8], ifaces: &e [u8], name: &g [u8], needed: bool) -> bool {
    for kind in 2 {
        mut what = copy(view("unit"));
        if kind == 1 {
            what = copy(view("check"));
        }
        path := cache_record_path(view(store.root), view(what), view(key));
        if host::exists(view(path)) == 0 {
            continue;
        }
        cache_touch(view(store.root), view(what), view(key));
        rows := lines(view(host::read_file(view(path))));
        mut ok = true;
        mut blobs = u8[][];
        mut dests = u8[][];
        for i in rows.len() {
            w := words(view(item(&rows, i)));
            if (2 <= w.len()) & (eq(view(item(&w, 0)), view("iface")) || eq(view(item(&w, 0)), view("facts"))) {
                b := item(&w, 1);
                if !cache_blob_ok(&mut store, view(b)) {
                    ok = false;
                }
                mut suffix = copy(view(".iface"));
                if eq(view(item(&w, 0)), view("facts")) {
                    suffix = copy(view(".facts"));
                }
                blobs.push(b);
                dests.push(path_join(view(ifaces), view(cat(view(name), view(suffix)))));
            }
        }
        if !ok || (needed && (blobs.len() == 0)) {
            continue;
        }
        mut restored = true;
        for i in blobs.len() {
            if cache_blob_restore(&mut store, view(blobs[i]), view(dests[i]), 0) != 0 {
                restored = false;
            }
        }
        if restored {
            return true;
        }
    }
    return false;
}
// The first module of `reads` that has errors, or was not checked because of them (done == 2).
fn failed_read<a, b>(groups: (&a ModuleGroup[]), reads: (&b u8[][])) -> u8[] {
    for r in reads.len() {
        g := group_of(groups, view(reads[r]));
        if (g != 0) && (groups[g - 1].done == 2) {
            return groups[g - 1].name.copy();
        }
    }
    return u8[];
}
fn reads_failed<a, b>(groups: (&a ModuleGroup[]), reads: (&b u8[][])) -> bool {
    return failed_read(groups, reads).len() != 0;
}
fn unit_ready<a, b>(groups: (&a ModuleGroup[]), base: (&b u8[][]), g: u64) -> bool {
    for b in base.len() {
        if eq(view(base[b]), view(groups[g].name)) {
            return true;
        }
    }
    for b in base.len() {
        bg := group_of(groups, view(base[b]));
        if (bg != 0) && (groups[bg - 1].done == 0) {
            return false;
        }
    }
    for u in groups[g].uses.len() {
        ug := group_of(groups, view(groups[g].uses[u]));
        if (ug != 0) && (ug - 1 != g) && (groups[ug - 1].done == 0) {
            return false;
        }
    }
    return true;
}
// The modules whose interfaces a run of `g` can read: the base, what it uses, and what those use.
// Sorted, so the list is a function of the program and not of the order modules finished in.
fn unit_reads<a, b>(groups: (&a ModuleGroup[]), base: (&b u8[][]), g: u64) -> u8[][] {
    mut seen = u64[];
    for i in groups.len() {
        seen.push(0);
    }
    mut work = u64[g];
    seen[g] = 1;
    mut names = u8[][];
    for b in base.len() {
        bg := group_of(groups, view(base[b]));
        if (bg != 0) && (seen[bg - 1] == 0) {
            seen[bg - 1] = 1;
            work.push(bg - 1);
        }
    }
    mut at = 0;
    while at < work.len() {
        here := work[at];
        at += 1;
        if here != g {
            n := groups[here].name.copy();
            mut slot = names.len();
            while (0 < slot) && bytes_less(view(n), view(names[slot - 1])) {
                slot -= 1;
            }
            names.insert(slot, n);
        }
        for u in groups[here].uses.len() {
            ug := group_of(groups, view(groups[here].uses[u]));
            if (ug != 0) && (seen[ug - 1] == 0) {
                seen[ug - 1] = 1;
                work.push(ug - 1);
            }
        }
    }
    return names;
}
// `grail unit-build N <N compiler words> <assembler words>`: one module's compiler run and then its
// assembly, as one process, so a build can start several modules at once and wait for each as a
// whole. Not a command a person runs.
// `grail llvm-compile IN.ll OUT.o EMULATION CLANG...`: `CLANG -O2 -c` over the lifted module IN.ll,
// cut into parts (llvm::split_module) compiled at once - as many as the build's jobserver grants,
// about one per 4 MB of IR - and linked into one relocatable OUT.o. A release unit's optimisation is
// then bounded by its largest part rather than by the whole module.
fn llvm_compile_command<a>(args: (&a u8[][])) -> u64 {
    // `--native PATH`: a release unit's native part, put into OUT's archive beside the parts (ThinLTO
    // only), so the unit object is written in one step.
    mut first = 0;
    mut native = u8[];
    if (args.len() > 1) && eq(view(item(&args, 0)), view("--native")) {
        native = item(&args, 1);
        first = 2;
    }
    if args.len() < first + 4 {
        say(view("usage: grail llvm-compile [--native PART.o] IN.ll OUT.o EMULATION CLANG [ARGS...]"));
        return 1;
    }
    input := item(&args, first);
    output := item(&args, first + 1);
    emulation := item(&args, first + 2);
    mut clang = u8[][];
    mut i = first + 3;
    while i < args.len() {
        clang.push(item(&args, i));
        i += 1;
    }
    // With `-flto=thin` the parts are ThinLTO bitcode and OUT is an archive of them: a relocatable
    // link of bitcode would run full LTO over this unit alone and close it to the other units.
    mut thin = false;
    for c in clang.len() {
        if eq(view(item(&clang, c)), view("-flto=thin")) {
            thin = true;
        }
    }
    text := host::read_file(view(input));
    mut wanted = text.len() / 4194304 + 1;
    if thin {
        // Smaller parts, so an edit to one function re-parses and re-optimises a small part (each
        // part is stored by its text) and the link's backend re-runs only on that part. The count
        // depends on the text alone, so the parts of an unchanged module are the same every build.
        wanted = text.len() / 131072 + 1;
        if 16 < wanted {
            wanted = 16;
        }
    }
    mut cap = host::cpus();
    asked := host::env(view("GRAIL_JOBS"));
    if asked.len() != 0 {
        cap = number_of(view(asked));
    }
    if 32 < cap {
        cap = 32;
    }
    if (cap < wanted) && !thin {
        wanted = cap;
    }
    mut js = jobs::open();
    mut running = wanted;
    if cap < running {
        running = cap;
    }
    if 1 < running {
        granted := jobs::workers(&mut js, running);
        running = granted;
        if !thin {
            wanted = granted;
        }
    }
    if running == 0 {
        running = 1;
    }
    if (wanted < 2) && !thin {
        jobs::give_all(&mut js);
        mut run = u8[][];
        for c in clang.len() {
            run.push(item(&clang, c));
        }
        run.push(copy(view("-O2")));
        run.push(copy(view(input)));
        run.push(copy(view("-o")));
        if !thin {
            run.push(copy(view(output)));
            return host::command(run);
        }
        bitcode := cat(view(input), view(".bc"));
        run.push(bitcode.copy());
        if host::command(run) != 0 {
            return 1;
        }
        return thin_archive(view(output), &u8[][bitcode]);
    }
    plan := llvm::split_plan(view(text), wanted);
    // Unique to this unit's module: internal functions keep their own names in every part of it.
    suffix := cat(view("u"), view(decimal(xxhash::hash64(view(input), 0))));
    mut pids = u64[];
    mut needs = u64[];
    mut held: u64 = 0;
    budget := memory_budget();
    mut waited = 0;
    mut bad = 0;
    mut objects = u8[][];
    if native.len() != 0 {
        objects.push(native.copy());
    }
    mut compiled = u8[][];
    mut destinations = u8[][];
    parts_store := path_join(view(cache_base()), view("llvm-parts"));
    cache_mkdirs(view(parts_store));
    for k in plan.count {
        mut name = copy(view(input));
        push_bytes(&mut name, view("."));
        push_bytes(&mut name, view(decimal(k)));
        part := cat(view(name), view(".ll"));
        object := cat(view(name), view(".o"));
        part_text := llvm::split_part(view(text), &plan, k, view(suffix));
        // A part's object is stored under the digest of its text and the compile command, so a
        // rebuild after an edit compiles only the parts whose functions changed.
        mut keyed = u8[];
        for c in clang.len() {
            push_bytes(&mut keyed, view(item(&clang, c)));
            keyed.push(0);
        }
        push_bytes(&mut keyed, view(part_text));
        stored := path_join(view(parts_store), view(cat(view(decimal(xxhash::hash64(view(keyed), 0))), view(".o"))));
        if host::exists(view(stored)) != 0 {
            objects.push(stored);
            continue;
        }
        host::write_file(view(part), view(part_text));
        compiled.push(object.copy());
        destinations.push(stored);
        mut run = u8[][];
        for c in clang.len() {
            run.push(item(&clang, c));
        }
        run.push(copy(view("-O2")));
        run.push(part.copy());
        run.push(copy(view("-o")));
        run.push(object.copy());
        // At most `running` at once (the jobserver granted that many), and only as many as the
        // memory available holds: a part's clang peaks at about PART_MEMORY times its text
        // (measured on the compiler's own module: up to 2.5 GB for a 134 MB part).
        need := part_text.len() * PART_MEMORY;
        while (pids.len() - waited >= running) || ((waited < pids.len()) && (held + need > budget)) {
            if (9223372036854775807 < pids[waited]) || (host::wait(pids[waited]) != 0) {
                bad = 1;
            }
            held -= needs[waited];
            waited += 1;
        }
        held += need;
        needs.push(need);
        pids.push(host::spawn(run, host::environment(), 2, 2));
        objects.push(object);
    }
    while waited < pids.len() {
        if (9223372036854775807 < pids[waited]) || (host::wait(pids[waited]) != 0) {
            bad = 1;
        }
        waited += 1;
    }
    jobs::give_all(&mut js);
    if bad != 0 {
        say(view("grail: clang -O2 failed on a part of the LLVM module"));
        return 1;
    }
    // Into the store: copied under a name of this process's, then renamed, so a reader never sees a
    // half-written object.
    for q in compiled.len() {
        bytes := host::read_file(view(item(&compiled, q)));
        pending := cat(view(item(&destinations, q)), view(cat(view(".tmp"), view(decimal(host::now_ms())))));
        host::write_file(view(pending), view(bytes));
        host::rename(view(pending), view(item(&destinations, q)));
    }
    if thin {
        return thin_archive(view(output), &objects);
    }
    mut link = u8[][tool(view("GRAIL_LINKER"), view("ld.lld")), copy(view("-m")), copy(view(emulation)), copy(view("-r"))];
    for k in objects.len() {
        link.push(item(&objects, k));
    }
    link.push(copy(view("-o")));
    link.push(copy(view(output)));
    return host::command(link);
}
// Bytes of peak memory a clang -O2 run takes per byte of LLVM text it is given (measured: 18.6x on
// the compiler's largest part, rounded up).
const PART_MEMORY: u64 = 20;
// Three quarters of the memory the kernel says is available now (`MemAvailable`), so parallel part
// compiles fit a developer machine; unbounded when it cannot be read.
fn memory_budget() -> u64 {
    info := host::read_file(view("/proc/meminfo"));
    mut i = 0;
    while i + 13 < info.len() {
        if ((i == 0) || (info[i - 1] == 10)) && eq(view(info[i..i + 13]), view("MemAvailable:")) {
            mut j = i + 13;
            mut kb: u64 = 0;
            while (j < info.len()) && (info[j] != 10) {
                if (48 <= info[j]) && (info[j] <= 57) {
                    kb = kb * 10 + u64(info[j] - 48);
                }
                j += 1;
            }
            if kb != 0 {
                return kb * 1024 / 4 * 3;
            }
        }
        i += 1;
    }
    return 18446744073709551615;
}
// `output` as a fresh archive of `members` (ThinLTO bitcode parts): `r` would update an archive left
// by an earlier build in place, so it is removed first.
// No symbol table (`S`): the link takes every member (--whole-archive), and building one would
// make llvm-ar read every bitcode member.
fn thin_archive<a, b>(output: &a [u8], members: (&b u8[][])) -> u64 {
    host::remove(output, 0);
    mut ar = u8[][tool(view("GRAIL_AR"), view("llvm-ar")), copy(view("rcSD")), copy(output)];
    for k in members.len() {
        ar.push(item(&members, k));
    }
    return host::command(ar);
}
fn unit_build_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() == 0 {
        return 1;
    }
    count := number_of(view(item(&args, 0)));
    if args.len() < 1 + count {
        return 1;
    }
    mut compile = u8[][];
    for i in count {
        compile.push(item(&args, 1 + i));
    }
    if host::command(compile) != 0 {
        return 1;
    }
    // Then the steps that turn the stream into the unit's object, each a count and its words: the
    // assembler, and for a release unit `clang -O2` on the LLVM module and the merge of the two.
    mut i = 1 + count;
    mut step = 0;
    while i < args.len() {
        n := number_of(view(item(&args, i)));
        if args.len() < i + 1 + n {
            return 1;
        }
        mut command = u8[][];
        for k in n {
            command.push(item(&args, i + 1 + k));
        }
        lowering := (command.len() > 1) && eq(view(item(&command, 1)), view("llvm-compile"));
        if host::command(command) != 0 {
            if (step == 0) && !lowering {
                say(view("grail: assembling failed (needs clang)"));
            } else {
                say(view("grail: optimising the LLVM module failed (needs clang and ld.lld)"));
            }
            return 1;
        }
        i += 1 + n;
        step += 1;
    }
    return 0;
}
// This process's id, from /proc/self/stat (Linux); empty where there is no such file.
fn own_pid() -> u8[] {
    if host::exists(view("/proc/self/stat")) == 0 {
        return u8[];
    }
    text := host::read_file(view("/proc/self/stat"));
    mut out = u8[];
    for i in text.len() {
        if (text[i] < 48) || (57 < text[i]) {
            break;
        }
        out.push(text[i]);
    }
    return out;
}
fn per_module_build<a, d, e, g, k, m, n, x, y, jb, ev>(
    command: (&a u8[][]),
    at: u64,
    groups: (&x mut ModuleGroup[]),
    output: &d [u8],
    target: &e [u8],
    emulation: &g [u8],
    prefix: (&k u8[][]),
    store: (&m mut Cache),
    id: (&n BuildId),
    program: &y [u8],
    cache: u64,
    js: (&jb mut jobs::Jobs),
    env: (&ev u8[][])
) -> u64 {
    compiler := item(&command, 0);
    mut flags = u8[][];
    mut i = 1;
    while i < at {
        a := item(&command, i);
        if eq(view(a), view("--interface")) {
            i += 2;
            continue;
        }
        // A unit is one module of a settled set: every module the program has is a group, so the unit
        // does not resolve `use` through the roots again - that is what would compile a module twice.
        if eq(view(a), view("--module-root")) {
            i += 2;
            continue;
        }
        // The whole program's shape is not a unit's: a unit is one module's code, compiled for a
        // separate object (`--separate`), and it reads the interfaces the runs before it wrote.
        if !eq(view(a), view("--split")) {
            flags.push(a);
        }
        i += 1;
    }
    entry_name := groups[0].name.copy();
    base := u8[][copy(view("runtime"))];
    self_pid := own_pid();
    // A check: each module's run stops when its diagnostics are given (`--check`), nothing is
    // assembled or linked, and a module with errors does not stop the others - the modules that
    // read it are not checked, and the ones that do not still are.
    mut checking = false;
    for f in flags.len() {
        if eq(view(item(&flags, f)), view("--check")) {
            checking = true;
        }
    }
    mut failed = 0;
    // A release unit is compiled by the LLVM backend: the compile command carries the word.
    mut release = 0;
    for f in flags.len() {
        if eq(view(item(&flags, f)), view("--backend=llvm")) {
            release = 1;
        }
    }
    dir := cat(view(output), view(".modules"));
    host::mkdir(view(dir));
    ifaces := path_join(view(dir), view("interfaces"));
    host::mkdir(view(ifaces));
    // Every build writes the interface directory afresh, so a module removed from the program leaves
    // no interface behind for another to read.
    old := host::list_dir(view(ifaces));
    for j in old.len() {
        host::remove(view(path_join(view(ifaces), view(old[j]))), 0);
    }
    mut objects = u8[][];
    mut link = u8[][];
    mut built = 0;
    // What each module's run is doing. A module is started as soon as the modules it reads are
    // finished, so independent modules compile at the same time, one process each; what the build
    // *records* - objects, link inputs, the cache's report - is still taken in the order a build of
    // one module at a time takes it, so the image and the report do not depend on the scheduling.
    //   0 not started, 1 running (pid, the pipe its output arrives on), 2 restored from the store,
    //   3 ended (its output and status kept until its turn).
    mut state = u64[];
    mut pids = u64[];
    mut pipes = u64[];
    mut keys = u8[][];
    mut outputs = u8[][];
    mut statuses = u64[];
    for g in groups.len() {
        state.push(0);
        pids.push(0);
        pipes.push(0);
        keys.push(u8[]);
        outputs.push(u8[]);
        statuses.push(0);
    }
    mut running = 0;
    // A module run is started on this process's own token when nothing is running, and on a token
    // from the jobserver otherwise; each is given back when a run is waited for (`running -= 1`
    // below gives one back whenever this process holds one).
    while built < groups.len() {
        // Start every module whose dependencies are finished.
        for g in groups.len() {
            if (groups[g].done != 0) || (state[g] != 0) {
                continue;
            }
            if !unit_ready(&groups, &base, g) {
                continue;
            }
            name := groups[g].name.copy();
            stem := path_join(view(dir), view(name));
            // The modules this run reads: what it uses, and theirs. They are finished (that is what
            // made this one ready), so their interfaces are whole; the run is told to read those
            // and no others, whatever else is in the directory by now.
            reads := unit_reads(&groups, &base, g);
            // A module that reads one with errors is not checked: its turn records that.
            if checking && reads_failed(&groups, &reads) {
                state[g] = 4;
                continue;
            }
            // Whether another module of the program reads this one. A check of a module nothing reads -
            // the program's root - writes no interface: no run of this build reads it, the interface
            // directory is cleared by the next build, and the user's `grail check --interface DIR`
            // takes its own path. Its run then records effects only for claims it checks (fx_begin).
            mut read_by = false;
            for o in groups.len() {
                if (o != g) && !read_by {
                    other := unit_reads(&groups, &base, o);
                    for r in other.len() {
                        if eq(view(other[r]), view(name)) {
                            read_by = true;
                        }
                    }
                }
            }
            // The runtime is read by no group but writes `runtime.facts`, which every other run's
            // effect summaries and cache key are computed from.
            if eq(view(name), view("runtime")) {
                read_by = true;
            }
            emits := !checking || read_by;
            if cache != 0 {
                keys[g] = unit_key(&mut store, id, view(target), view(name), &groups[g].files, view(ifaces), &reads);
                if checking {
                    if unit_restore_check(&mut store, view(keys[g]), view(ifaces), view(name), read_by) {
                        state[g] = 2;
                        continue;
                    }
                } else if unit_restore(&mut store, view(keys[g]), view(stem), view(ifaces), view(name)) {
                    state[g] = 2;
                    continue;
                }
            }
            if (running != 0) && !jobs::take(&mut js) {
                continue;
            }
            // One process, two steps: this module's code alone, global so the link can bind it,
            // read against the interfaces of the modules it uses; then the assembler.
            mut run = u8[][compiler.copy(), copy(view("unit-build"))];
            mut compile = u8[][compiler.copy()];
            for f in flags.len() {
                compile.push(item(&flags, f));
            }
            if !eq(view(name), view(base[0])) {
                compile.push(copy(view("--use")));
                compile.push(ifaces.copy());
                // Every interface in that directory was written by a run of this build or restored
                // from a store blob whose bytes hashed to its name: the run need not hash each one
                // again to check its trailer.
                compile.push(copy(view("--use-vouched")));
                // A module with no interface file has no surface to read (the runtime's is the
                // compiler's own knowledge of it).
                compile.push(copy(view("--use-named")));
                for r in reads.len() {
                    if host::exists(view(path_join(view(ifaces), view(cat(view(reads[r]), view(".iface")))))) != 0 {
                        compile.push(copy(view("--use-module")));
                        compile.push(reads[r].copy());
                    }
                }
            }
            if emits {
                compile.push(copy(view("--emit-interface")));
                compile.push(ifaces.copy());
            }
            compile.push(copy(view("--separate")));
            // `GRAIL_FN_CACHE=0` turns the per-function layer off and leaves the module store on: every
            // body of a module run that misses is compiled, as a build with no unit store compiles
            // it. It is the reference `tools/cache-test.mjs` compares a replayed module against.
            if (cache != 0) && (release == 0) && !eq(view(host::env(view("GRAIL_FN_CACHE"))), view("0")) {
                // The per-function codegen cache: a module run that misses can still replay the
                // functions whose inputs did not move (docs/design/incremental-compilation.md).
                // It is one directory inside this build's store, so a prune drops it with the rest.
                compile.push(copy(view("--fn-cache")));
                compile.push(fn_store(view(store.root)));
                // The compiler's own digest: a unit is code this binary emitted, so a rebuilt
                // compiler must not replay the previous one's.
                compile.push(copy(view("--fn-cache-id")));
                compile.push(id.compiler.copy());
                // The module's unit pack: one file for all its units, named by what the module is
                // (target and name, and the files it is built from), not by its contents, so an
                // edit refiles the module's own pack and no other (fncache "Packs").
                mut pack_id = copy(view(target));
                pack_id.push(10);
                push_bytes(&mut pack_id, view(name));
                for f in groups[g].files.len() {
                    pack_id.push(10);
                    push_bytes(&mut pack_id, view(groups[g].files[f]));
                }
                compile.push(copy(view("--fn-pack")));
                compile.push(cat(view("pk-"), view(store_hash(view(pack_id))[0..32])));
                if store.quiet != 0 {
                    compile.push(copy(view("--fn-cache-quiet")));
                }
            }
            if !eq(view(name), view(entry_name)) {
                compile.push(copy(view("--no-entry")));
            }
            // The internal assembler (`grail asm`) runs inside the module's compiler run.
            inproc := !checking && (prefix.len() >= 2) && eq(view(item(&prefix, 1)), view("asm"));
            if inproc {
                compile.push(copy(view("--object")));
                if release != 0 {
                    // The native part; llvm-compile puts it in the unit's archive.
                    compile.push(release_part(view(cat(view(stem), view(".o")))));
                } else {
                    compile.push(cat(view(stem), view(".o")));
                }
            }
            compile.push(cat(view(stem), view(".s")));
            for f in groups[g].files.len() {
                compile.push(groups[g].files[f].copy());
            }
            if checking || (inproc && (release == 0)) {
                // Only the compiler: a check has no assembly to turn into an object, and an
                // in-process assembly has its object when the run ends.
                run = u8[][];
                for k in compile.len() {
                    run.push(compile[k].copy());
                }
            } else {
                run.push(decimal(compile.len()));
                for k in compile.len() {
                    run.push(compile[k].copy());
                }
                // In-process assembly needs no assembler step: the compiler run wrote the object
                // (`--object`); a release unit still has its LLVM module to compile and archive.
                unit_object := cat(view(stem), view(".o"));
                if inproc && (release != 0) {
                    steps := release_optimise(&prefix, view(cat(view(stem), view(".s"))), view(unit_object), view(emulation));
                    for q in steps.len() {
                        run.push(decimal(steps[q].len()));
                        for w in steps[q].len() {
                            run.push(item(&steps[q], w));
                        }
                    }
                }
                if !inproc {
                    run.push(decimal(prefix.len() + 3));
                    for k in prefix.len() {
                        run.push(item(&prefix, k));
                    }
                    run.push(cat(view(stem), view(".s")));
                    run.push(copy(view("-o")));
                    if release != 0 {
                        run.push(release_part(view(unit_object)));
                        steps := release_optimise(&prefix, view(cat(view(stem), view(".s"))), view(unit_object), view(emulation));
                        for q in steps.len() {
                            run.push(decimal(steps[q].len()));
                            for w in steps[q].len() {
                                run.push(item(&steps[q], w));
                            }
                        }
                    } else {
                        run.push(unit_object.copy());
                    }
                }
            }
            pair := host::pipe();
            mut child_env = u8[][];
            for k in env.len() {
                child_env.push(item(&env, k));
            }
            // The run dies with this driver (os-linux.grl, rt_parent_watch): a driver killed by a
            // timeout, an editor or the OOM killer leaves no compiler running on behind it.
            if self_pid.len() != 0 {
                child_env.push(cat(view("GRAIL_PARENT="), view(self_pid)));
            }
            pid := host::spawn(run, child_env, pair[1], pair[1]);
            host::close(pair[1]);
            if 9223372036854775807 < pid {
                host::close(pair[0]);
                say(view("grail: could not start a compiler run for a module"));
                return 1;
            }
            state[g] = 1;
            pids[g] = pid;
            pipes[g] = pair[0];
            running += 1;
        }
        // The next module to record: the first unfinished one whose dependencies are finished,
        // which is the one a build of one module at a time would be on.
        mut pick = groups.len();
        for g in groups.len() {
            if (pick == groups.len()) && (groups[g].done == 0) && unit_ready(&groups, &base, g) {
                pick = g;
            }
        }
        if pick == groups.len() {
            say(
                view(
                    "grail: --per-module found a cycle of `use` between modules; build without --per-module"
                )
            );
            return 1;
        }
        if state[pick] == 4 {
            // Not checked: it reads a module with errors, whose interface it would be checked
            // against. One line, in the order the modules are recorded, and its readers in turn.
            pick_reads := unit_reads(&groups, &base, pick);
            mut line = cat(view("grail: not checked: `"), view(groups[pick].name));
            line = cat(view(line), view("` depends on `"));
            line = cat(view(line), view(failed_read(&groups, &pick_reads)));
            line = cat(view(line), view("`, which has errors"));
            say(view(line));
            groups[pick].done = 2;
            failed += 1;
            built += 1;
            continue;
        }
        if state[pick] == 0 {
            // Ready, and not started only because every processor is busy. One running module is
            // waited for - its output and status kept for its own turn - and the loop starts this
            // one in the place that frees.
            mut oldest = groups.len();
            for g in groups.len() {
                if (oldest == groups.len()) && (state[g] == 1) {
                    oldest = g;
                }
            }
            if oldest == groups.len() {
                say(view("grail: a module is ready and nothing is running to wait for"));
                return 1;
            }
            mut early = u8[];
            while true {
                chunk := host::read_fd(pipes[oldest], 65536);
                if chunk.len() == 0 {
                    break;
                }
                push_bytes(&mut early, view(chunk));
            }
            host::close(pipes[oldest]);
            statuses[oldest] = host::wait(pids[oldest]);
            exchange(&mut outputs[oldest], early);
            state[oldest] = 3;
            running -= 1;
            jobs::give(&mut js);
            continue;
        }
        name := groups[pick].name.copy();
        stem := path_join(view(dir), view(name));
        unit_asm := cat(view(stem), view(".s"));
        unit_obj := cat(view(stem), view(".o"));
        if (state[pick] == 2) && checking {
            store.hits += 1;
            groups[pick].done = 1;
            built += 1;
            continue;
        }
        if state[pick] == 2 {
            store.hits += 1;
        } else {
            // Whatever the run printed, then how it ended.
            mut said = u8[];
            mut status = 0;
            if state[pick] == 3 {
                said = exchange(&mut outputs[pick], u8[]);
                status = statuses[pick];
            } else {
                while true {
                    chunk := host::read_fd(pipes[pick], 65536);
                    if chunk.len() == 0 {
                        break;
                    }
                    push_bytes(&mut said, view(chunk));
                }
                host::close(pipes[pick]);
                status = host::wait(pids[pick]);
                running -= 1;
                jobs::give(&mut js);
                state[pick] = 3;
            }
            if said.len() != 0 {
                host::print(view(said));
            }
            if checking && (status != 0) {
                // A check goes on: this module's errors are given, the modules that read it are not
                // checked, and the others still are.
                groups[pick].done = 2;
                failed += 1;
                built += 1;
                continue;
            }
            if checking {
                if cache != 0 {
                    store.misses += 1;
                    store.names.push(name.copy());
                    unit_file_check(&mut store, view(keys[pick]), view(ifaces), view(name));
                }
                groups[pick].done = 1;
                built += 1;
                continue;
            }
            if status != 0 {
                // The modules still running are left to finish; nothing of theirs is recorded.
                for g in groups.len() {
                    if state[g] == 1 {
                        host::close(pipes[g]);
                        host::wait(pids[g]);
                    }
                }
                return 1;
            }
            if cache != 0 {
                store.misses += 1;
                store.names.push(name.copy());
            }
            if write_unit_links(view(stem), view(unit_asm), &groups[pick].files) != 0 {
                say(view("grail: could not write a module's link inputs"));
                return 1;
            }
            if cache != 0 {
                unit_file(&mut store, view(keys[pick]), view(stem), view(ifaces), view(name));
            }
        }
        objects.push(unit_obj);
        for l in unit_links(view(stem)) {
            add_link(&mut link, view(l));
        }
        groups[pick].done = 1;
        built += 1;
    }
    if checking {
        if cache != 0 {
            cache_report(&mut store, 2);
            cache_auto_gc(&mut store);
        }
        return u64(failed != 0);
    }
    mut thin_cache = u8[];
    if cache != 0 {
        thin_cache = path_join(view(cache_base()), view("thinlto"));
    }
    if link_objects(view(output), view(target), view(emulation), &objects, &link, view(thin_cache)) != 0 {
        return 1;
    }
    if cache != 0 {
        cache_report(&mut store, 1);
        // The image is this build's answer for as long as every input and every file the link named
        // is the one it was linked from, so a rebuild of unchanged sources runs nothing at all.
        image := cache_blob_put(&mut store, view(output));
        if image.len() == 64 {
            mut record = u8[];
            push_bytes(&mut record, view("// grail-cache-program 1\nblob "));
            push_bytes(&mut record, view(image));
            push_bytes(&mut record, view("\nparts "));
            cache_decimal(&mut record, groups.len());
            push_bytes(&mut record, view("\noutput "));
            push_bytes(&mut record, view(output));
            record.push(10);
            for i in link.len() {
                input := item(&link, i);
                if host::exists(view(input)) != 0 {
                    push_bytes(&mut record, view("link "));
                    push_bytes(&mut record, view(cache_digest_file(&mut store, view(input))));
                    record.push(32);
                    push_bytes(&mut record, view(input));
                    record.push(10);
                }
            }
            // Every module source this build compiles, not only the ones the command line named: `use`
            // resolution adds the standard closure, and the image shortcut has to see an edit there
            // (docs/design/separate-compilation.md, "What a run compiles, and what it writes").
            for g in groups.len() {
                for f in groups[g].files.len() {
                    source := groups[g].files[f].copy();
                    if host::exists(view(source)) != 0 {
                        push_bytes(&mut record, view("source "));
                        push_bytes(&mut record, view(cache_digest_file(&mut store, view(source))));
                        record.push(32);
                        push_bytes(&mut record, view(source));
                        record.push(10);
                    }
                }
            }
            cache_record_put(&mut store, view("prog"), view(program), view(record));
        }
    }
    // Last, after everything this build files: the store is measured with it in.
    if cache != 0 {
        cache_auto_gc(&mut store);
    }
    return 0;
}
// A unit's link inputs, as `write_unit_links` left them.
fn unit_links<a>(stem: &a [u8]) -> u8[][] {
    path := unit_links_path(view(stem));
    text := host::read_file(view(path));
    rows := lines(view(text));
    mut out = u8[][];
    for i in rows.len() {
        row := item(&rows, i);
        if row.len() != 0 {
            out.push(row);
        }
    }
    return out;
}
// Whether `path` is an archive (`!<arch>`), which is what a release unit is.
fn is_archive<a>(path: &a [u8]) -> bool {
    head := host::read_file(path);
    return (head.len() >= 8) && eq(view(head[0..8]), view("!<arch>\n"));
}
// How many ThinLTO backends the link runs: GRAIL_JOBS when it is set, else the processors, at most 8.
fn thin_jobs() -> u64 {
    asked := host::env(view("GRAIL_JOBS"));
    mut n: u64 = 0;
    for i in asked.len() {
        if (48 <= asked[i]) && (asked[i] <= 57) {
            n = n * 10 + u64(asked[i] - 48);
        }
    }
    if n == 0 {
        n = host::cpus();
        if 8 < n {
            n = 8;
        }
    }
    if n == 0 {
        n = 1;
    }
    return n;
}
// Add a link input once: two modules may ask for the same library, and the link needs it once.
fn add_link<a, b>(link: (&a mut u8[][]), input: &b [u8]) -> unit {
    for i in link.len() {
        if eq(view(link[i]), view(input)) {
            return ();
        }
    }
    mut copy_of = u8[];
    push_bytes(&mut copy_of, view(input));
    link.push(copy_of);
    return ();
}
// One link, from objects already on disk: the cache reuses exactly this, so a cached image and an
// uncached one are the same link of the same objects.
fn link_objects<a, b, d, e, g, k>(
    output: &a [u8],
    target: &b [u8],
    emulation: &d [u8],
    objects: (&e u8[][]),
    inputs: (&g u8[][]),
    thin_cache: &k [u8] = view("")
) -> u64 {
    mut link = u8[][
        tool(view("GRAIL_LINKER"), view("ld.lld")),
        copy(view("-m")),
        copy(view(emulation))
    ];
    // Release units are archives of a native part and ThinLTO bitcode (release_optimise): every
    // member is part of the program, and the bitcode is optimised across units here.
    mut thin = false;
    for i in objects.len() {
        if is_archive(view(item(&objects, i))) {
            thin = true;
        }
    }
    if thin {
        link.push(copy(view("--whole-archive")));
    }
    for i in objects.len() {
        link.push(item(&objects, i));
    }
    if thin {
        link.push(copy(view("--no-whole-archive")));
        link.push(cat(view("--thinlto-jobs="), view(decimal(thin_jobs()))));
        if thin_cache.len() != 0 {
            link.push(cat(view("--thinlto-cache-dir="), thin_cache));
        }
    }
    for i in inputs.len() {
        link.push(item(&inputs, i));
    }
    dynamic := dynamic_link_flags(view(target), inputs);
    for i in dynamic.len() {
        link.push(item(&dynamic, i));
    }
    link.push(copy(view("-o")));
    link.push(copy(view(output)));
    if host::command(link) != 0 {
        say(view("grail: linking failed (needs ld.lld)"));
        return 1;
    }
    return 0;
}
// ---- build cache (B1 stage 4) ----
//
// An unchanged module is not reassembled and an unchanged program is not relinked. Three keys, each
// over exactly what determines the artifact it names (docs/design/separate-compilation.md, "Stage 4
// as built: a build cache"):
//
//   map/prog/<key>   every input the build reads, the compiler and the toolchain  -> the image
//   map/lnk/<key>    the object set, the link inputs and the linker               -> the image
//   map/mod/<key>    one module's inputs and the assembler                        -> its object
//   map/check/<key>  one module's inputs, checked (a unit key)                    -> its interface
//
// The store is content addressed under .work/cache/<target>:
//
//   blob/<digest>    artifact bytes; the file name is the digest of the bytes inside it (store_hash)
//   map/KIND/<key>   a record: `field value` lines naming the blob the key produced
//   fp/<id>          what is known of one file at one stamp (size, time, inode, device): its digest,
//                    and for a source its module, its `use`s and whether it embeds (cache_file_info)
//   inputs/<key>     a command's resolved module set, with the stamps it holds under
//   tool-id/<id>     an external tool's identity, per binary stamp
//   stage/           every write lands in a directory of its own here and is renamed into place, so
//                    a crash leaves no half-written entry
//
// A blob is only reused when its bytes hash to the name it is filed under. Its `fp/` record answers
// that without a read while the blob keeps the stamp it was filed with; a blob written since (a bad
// disk, a killed build, an edit) has another stamp and is hashed again, so a corrupted, truncated or
// unreadable entry is a miss - never a wrong build.
//
// The module key is the one the design note asks for: the module's source digest, the digests of the
// interfaces it reads, the compiler's digest, the target, every flag that changes code generation and
// the assembler's identity. It does not cover one thing that today's whole-program front end decides:
// the module's emitted assembly depends on *other* modules' bodies, because the optimizer inlines
// across module boundaries. So a module record also carries the digest of the assembly the object was
// built from, and an entry is only reused when that digest still matches the assembly just emitted.
// When stage 4 proper (one compiler invocation per module) lands, the guard becomes redundant.
struct Cache {
    root: u8[],
    // The working directory, which the `fp/` records of relative paths are keyed under.
    cwd: u8[],
    hits: u64,
    misses: u64,
    // The modules that missed, in emission order, for the one-line report.
    names: u8[][],
    // 1 when the store was not asked for by name: a build uses it by default, and says nothing about
    // it unless `--cache` was written.
    quiet: u64,
    // What this process already learned of a source by scanning it (cache_file_info), by path and
    // stamp: a source written just before the build is scanned and not recorded (it may still change
    // within its time's granularity), and a later question about it in the same build - a digest
    // only, once the file is old enough to record - writes the whole record from here instead of a
    // record without the scan, which the next build would have to read and scan the file again for.
    seen_paths: u8[][],
    seen_stamps: u8[][],
    seen: FileInfo[],
    // 1 once the record of seen[k] is written.
    seen_filed: u64[],
    // Module sets resolved from a file the probe read too soon after its write (resolved_note): the
    // record, and the files it waits on, written by cache_seen_flush once they are verified.
    pend_notes: u8[][],
    pend_bodies: u8[][],
    pend_waits: u8[][][]
}
struct BuildId {
    flags: u8[],
    compiler: u8[],
    assembler: u8[],
    linker: u8[],
    ifaces: u8[],
    iface_dir: u8[],
    sources: u8[][],
    digests: u8[][]
}
// Where one target's per-function units live: a directory of the build store, so `cache clear`
// takes it with everything else.
fn fn_store<a>(root: &a [u8]) -> u8[] {
    return path_join(view(root), view("fn"));
}
// Where the build store lives: GRAIL_CACHE_DIR, else $GRAIL_HOME/cache/build, else
// $XDG_CACHE_HOME/grail/build, else $HOME/.cache/grail/build, else ./.work/cache. One store per
// user rather than per project: every key names the compiler, the target, the flags and the digest
// of each input, so two projects share exactly the entries that are the same work - the runtime,
// the platform module and the standard library first of all, which is what lets a new project's
// first build skip them (docs/design/compile-speed.md, stage 2).
fn cache_base() -> u8[] {
    env := host::env(view("GRAIL_CACHE_DIR"));
    if env.len() != 0 {
        return env;
    }
    home := host::env(view("GRAIL_HOME"));
    if home.len() != 0 {
        return path_join(view(home), view("cache/build"));
    }
    xdg := host::env(view("XDG_CACHE_HOME"));
    if xdg.len() != 0 {
        return path_join(view(xdg), view("grail/build"));
    }
    user := host::env(view("HOME"));
    if user.len() != 0 {
        return path_join(view(user), view(".cache/grail/build"));
    }
    return copy(view(".work/cache"));
}
// Where compile-time probes keep their base objects (the runtime and the standard library compiled
// once, docs/design/comptime-speed.md): inside the build store, so `grail cache clear` and `prune`
// cover them.
pub fn probe_base_root() -> u8[] {
    return path_join(view(cache_base()), view("probe-base"));
}
fn cache_root<a>(target: &a [u8]) -> u8[] {
    return path_join(view(cache_base()), view(target));
}
// `mkdir -p`: every directory on the way to `path`, outermost first.
fn cache_mkdirs<a>(path: &a [u8]) -> unit {
    mut prefix = u8[];
    for i in path.len() {
        if (path[i] == 47) & (i != 0) {
            host::mkdir(view(prefix));
        }
        prefix.push(path[i]);
    }
    host::mkdir(view(prefix));
    return ();
}
// A directory of the store's stage that only this call writes in: builds that share a store run at
// once, so no two writers may share a staging path (one shared file once handed a run another run's
// digest - "core.iface describes module `io`"). Creating a directory is what claims it: only one
// process can.
fn cache_claim_tmp<a>(c: (&a mut Cache)) -> u8[] {
    stage := cache_stage(&mut c);
    base := host::now_ms();
    for attempt in 1000 {
        dir := path_join(view(stage), view(cat(view("tmp."), view(decimal(base + attempt)))));
        if host::mkdir(view(dir)) == 0 {
            return dir;
        }
    }
    return u8[];
}
fn cache_release_tmp<a>(dir: &a [u8]) -> unit {
    if dir.len() != 0 {
        host::remove(view(path_join(view(dir), view("out"))), 0);
        host::remove(view(dir), 1);
    }
    return ();
}
fn cache_stage<a>(c: (&a mut Cache)) -> u8[] {
    return path_join(view(c.root), view("stage"));
}
fn cache_ensure<a>(c: (&a mut Cache)) -> unit {
    cache_mkdirs(view(c.root));
    host::mkdir(view(path_join(view(c.root), view("blob"))));
    host::mkdir(view(path_join(view(c.root), view("map"))));
    host::mkdir(view(path_join(view(c.root), view("map/prog"))));
    host::mkdir(view(path_join(view(c.root), view("map/lnk"))));
    host::mkdir(view(path_join(view(c.root), view("map/mod"))));
    host::mkdir(view(path_join(view(c.root), view("map/unit"))));
    host::mkdir(view(path_join(view(c.root), view("map/check"))));
    host::mkdir(view(path_join(view(c.root), view("stage"))));
    host::mkdir(view(path_join(view(c.root), view("fp"))));
    host::mkdir(view(path_join(view(c.root), view("tool-id"))));
    host::mkdir(view(path_join(view(c.root), view("inputs"))));
    // One generation per build that opens the store: what `grail cache prune` measures age in.
    generation := cache_generation(view(c.root)) + 1;
    host::write_file(view(path_join(view(c.root), view("generation"))), view(decimal(generation)));
    return ();
}
// The store's build counter (0 for a store no build has opened yet).
fn cache_generation<a>(root: &a [u8]) -> u64 {
    path := path_join(view(root), view("generation"));
    if host::exists(view(path)) == 0 {
        return 0;
    }
    return number_of(view(host::read_file(view(path))));
}
// Record that the current build used a record: `map/<kind>/<key>.used` holds its generation.
fn cache_touch<a, b, d>(root: &a [u8], kind: &b [u8], key: &d [u8]) -> unit {
    used := cat(view(cache_record_path(view(root), view(kind), view(key))), view(".used"));
    host::write_file(view(used), view(decimal(cache_generation(view(root)))));
    return ();
}
// ---- the store's own I/O: hashing, file facts and writes, all in this process ----
//
// A build or check starts no helper process to hash or file anything: every digest below is
// `store_hash`, every write is a staging file renamed into place, every copy is a read and a write.
//
// The content digest of the store (blob names, source digests, record keys): native::fast_hash as
// 64 hex digits.
pub fn store_hash<a>(data: &a [u8]) -> u8[] {
    raw := native::fast_hash(data);
    mut out = u8[];
    for i in raw.len() {
        out.push(hex_digit(u64(raw[i]) >> 4));
        out.push(hex_digit(u64(raw[i]) & 15));
    }
    return out;
}
// What the store knows about one file without reading it again: its digest, and for a source the
// three things the driver reads sources for - the module it declares, the modules it `use`s and
// whether it embeds a file. Filed under `fp/` by the file's identity (cache_file_info).
struct FileInfo {
    digest: u8[],
    module: u8[],
    uses: u8[][],
    embed: bool
}
// A file's identity as the kernel reports it: size, modification time to the nanosecond, inode and
// device - what cargo and go compare before they hash. Empty when it is not a regular file. A
// directory has a stamp too (dir_stamp): its time moves when an entry is added or removed.
fn file_stamp<a>(path: &a [u8]) -> u8[] {
    st := host::stat(view(path), 1);
    if (st.len() < 12) || (st[0] != 0) || (st[1] != 1) {
        return u8[];
    }
    return stamp_text(&st);
}
fn stamp_text<a>(st: (&a u64[])) -> u8[] {
    mut out = decimal(st[2]);
    out.push(32);
    push_bytes(&mut out, view(decimal(st[4])));
    out.push(32);
    push_bytes(&mut out, view(decimal(st[5])));
    out.push(32);
    push_bytes(&mut out, view(decimal(st[10])));
    out.push(32);
    push_bytes(&mut out, view(decimal(st[11])));
    return out;
}
fn dir_stamp<a>(path: &a [u8]) -> u8[] {
    st := host::stat(view(path), 1);
    if (st.len() < 12) || (st[0] != 0) {
        return copy(view("-"));
    }
    mut out = decimal(st[1]);
    out.push(32);
    push_bytes(&mut out, view(stamp_text(&st)));
    return out;
}
// Whether bytes read from `path` at `read_ms` can be recorded under its stamp: the file's time was at
// least 10ms before the read. The kernel's file times tick at a few milliseconds, so a write after such
// a read moves the time; a file read within a tick of its last write could be written again with the
// same size and time, and is not recorded by its stamp until it is read again later (cache_seen_file).
fn read_settled<a>(path: &a [u8], read_ms: u64) -> bool {
    st := host::stat(view(path), 1);
    if (st.len() < 12) || (st[0] != 0) {
        return false;
    }
    written := st[4] * 1000 + st[5] / 1000000;
    return written + 10 <= read_ms;
}
fn fp_path<a, b>(c: (&a mut Cache), path: &b [u8]) -> u8[] {
    // A relative path names a file only together with the working directory.
    mut name = u8[];
    if (path.len() == 0) || (path[0] != 47) {
        name = copy(view(c.cwd));
        name.push(0);
    }
    push_bytes(&mut name, view(path));
    h := store_hash(view(name));
    return path_join(view(path_join(view(c.root), view("fp"))), view(h[0..32]));
}
// The word after each line-leading `keyword` (`module NAME;`, `use NAME;`).
fn source_words<a, b>(text: &a [u8], keyword: &b [u8]) -> u8[][] {
    mut out = u8[][];
    mut i = 0;
    while i < text.len() {
        while (i < text.len()) && ((text[i] == 32) || (text[i] == 9) || (text[i] == 13)) {
            i += 1;
        }
        mut start = i;
        while (i < text.len()) && ident_byte(text[i]) {
            i += 1;
        }
        if eq(view(text[start..i]), view(keyword)) {
            while (i < text.len()) && ((text[i] == 32) || (text[i] == 9)) {
                i += 1;
            }
            start = i;
            while (i < text.len()) && ident_byte(text[i]) {
                i += 1;
            }
            if i != start {
                out.push(text[start..i].copy());
            }
        }
        while (i < text.len()) && (text[i] != 10) {
            i += 1;
        }
        i += 1;
    }
    return out;
}
fn mentions_embed<a>(text: &a [u8]) -> bool {
    needle := "@embed(";
    mut i = 0;
    while i + needle.len() <= text.len() {
        if text[i] == 64 {
            mut hit = true;
            for j in needle.len() {
                if text[i + j] != needle[j] {
                    hit = false;
                    break;
                }
            }
            if hit {
                return true;
            }
        }
        i += 1;
    }
    return false;
}
fn info_of<a>(text: &a [u8], scan: bool) -> FileInfo {
    mut info = FileInfo { digest: store_hash(text), module: u8[], uses: u8[][], embed: false };
    if scan {
        names := source_words(text, view("module"));
        if names.len() != 0 {
            info.module = item(&names, 0);
        }
        info.uses = source_words(text, view("use"));
        // `iter()` on a vector needs no `use` line, but the unit that calls it is built after `iter`.
        if lexer::calls_iter(text) && !eq(view(info.module), view("iter")) {
            info.uses.push(copy(view("iter")));
        }
        // A script (no `module` line) gets the built-in types' other modules the same way: a map
        // literal or type brings `hashmap`, a vector's or text's method brings `vecs` or `strings`
        // (native.grl's discovery applies the same rule).
        if info.module.len() == 0 {
            if lexer::writes_map(text) {
                info.uses.push(copy(view("hashmap")));
            }
            if lexer::calls_any(text, lexer::vecs_methods()[..]) {
                info.uses.push(copy(view("vecs")));
            }
            if lexer::calls_any(text, lexer::strings_methods()[..]) {
                info.uses.push(copy(view("strings")));
            }
            if lexer::calls_any(text, lexer::math_methods()[..]) {
                info.uses.push(copy(view("math")));
            }
        }
        // A qualified path's module (`hash::fnv1a64`, `other_mod::f`) when it names another module
        // in the build (readers filter through `group_of`, so enum qualifiers like `Shape::Circle`
        // are ignored).
        qualified := lexer::qualified_names(text);
        for q in qualified.len() {
            if !eq(view(info.module), view(qualified[q])) {
                info.uses.push(copy(view(qualified[q])));
            }
        }
        derived := lexer::derive_modules(text);
        for d in derived.len() {
            if !eq(view(info.module), view(derived[d])) {
                info.uses.push(copy(view(derived[d])));
            }
        }
        info.embed = mentions_embed(text);
    }
    return info;
}
// The record: the path, the stamp, the digest, then `-` for a file read only for its digest, or the
// module (`-` for none), the embed flag and the `use`d names, and the scan's format (fp_scan).
fn fp_scan() -> string {
    return "scan6";
}
fn fp_write<a, b, d, e>(c: (&a mut Cache), path: &b [u8], stamp: &d [u8], info: (&e FileInfo), scan: bool) -> unit {
    if (c.root.len() == 0) || (stamp.len() == 0) {
        return ();
    }
    mut body = copy(view(path));
    body.push(10);
    push_bytes(&mut body, view(stamp));
    body.push(10);
    push_bytes(&mut body, view(info.digest));
    body.push(10);
    if scan {
        if info.module.len() == 0 {
            body.push(45);
        } else {
            push_bytes(&mut body, view(info.module));
        }
        body.push(10);
        if info.embed {
            body.push(49);
        } else {
            body.push(48);
        }
        for u in info.uses.len() {
            body.push(32);
            push_bytes(&mut body, view(info.uses[u]));
        }
        // The scan's format: a record from a scan that did not add the implicit `iter` dependency
        // (info_of) lacks this line, and is scanned again rather than trusted.
        body.push(10);
        push_bytes(&mut body, view(fp_scan()));
    } else {
        body.push(45);
    }
    body.push(10);
    cache_put_file(&mut c, view(fp_path(&mut c, path)), view(body));
    return ();
}
// Note a digest the driver already knows - a file it has just read whole, or written - so the next
// question about that file is answered from its stamp.
fn fp_note<a, b, d>(c: (&a mut Cache), path: &b [u8], digest: &d [u8]) -> unit {
    info := FileInfo { digest: copy(view(digest)), module: u8[], uses: u8[][], embed: false };
    fp_write(&mut c, path, view(file_stamp(path)), &info, false);
    return ();
}
// What the store knows about a file: answered from `fp/` when the file's stamp is the one recorded
// (no byte of it is read), else from one read that is then recorded. `scan` asks for the source
// facts as well as the digest. The digest is empty when the file is not there.
fn cache_file_info<a, b>(c: (&a mut Cache), path: &b [u8], scan: bool) -> FileInfo {
    stamp := file_stamp(path);
    if stamp.len() == 0 {
        return FileInfo { digest: u8[], module: u8[], uses: u8[][], embed: false };
    }
    mut note = u8[];
    if c.root.len() != 0 {
        note = fp_path(&mut c, path);
    }
    if (note.len() != 0) && (host::exists(view(note)) != 0) {
        rows := lines(view(host::read_file(view(note))));
        if (rows.len() >= 4) && eq(view(rows[0]), view(path)) && eq(view(rows[1]), view(stamp)) && (rows[2].len() == 64) {
            if !scan {
                return FileInfo { digest: rows[2].copy(), module: u8[], uses: u8[][], embed: false };
            }
            if (rows.len() >= 6) && eq(view(rows[5]), view(fp_scan())) {
                // The fifth line is the embed flag, then the `use`d names; the sixth the scan's format.
                w := words(view(rows[4]));
                mut info = FileInfo { digest: rows[2].copy(), module: rows[3].copy(), uses: u8[][], embed: false };
                if eq(view(info.module), view("-")) {
                    info.module = u8[];
                }
                for k in w.len() {
                    if k == 0 {
                        info.embed = eq(view(w[0]), view("1"));
                    } else {
                        info.uses.push(w[k].copy());
                    }
                }
                return info;
            }
        }
    }
    // Scanned already in this process at this stamp: answered from memory (cache_seen_file records it).
    for k in c.seen_paths.len() {
        if eq(view(c.seen_paths[k]), view(path)) && eq(view(c.seen_stamps[k]), view(stamp)) {
            mut uses = u8[][];
            for u in c.seen[k].uses.len() {
                uses.push(c.seen[k].uses[u].copy());
            }
            return FileInfo { digest: c.seen[k].digest.copy(), module: c.seen[k].module.copy(), uses: uses, embed: c.seen[k].embed };
        }
    }
    read_ms := host::wall_ms();
    text := host::read_file(view(path));
    info := info_of(view(text), scan);
    settled := read_settled(path, read_ms);
    if settled {
        fp_write(&mut c, path, view(stamp), &info, scan);
    }
    if scan {
        c.seen_paths.push(copy(view(path)));
        c.seen_stamps.push(stamp.copy());
        mut uses = u8[][];
        for u in info.uses.len() {
            uses.push(info.uses[u].copy());
        }
        c.seen.push(FileInfo { digest: info.digest.copy(), module: info.module.copy(), uses: uses, embed: info.embed });
        c.seen_filed.push(u64(settled));
    }
    return info;
}
// The end of a build: a source scanned too soon after it was written to be recorded (read_settled) is
// read once more, now, and recorded with what the scan found when its stamp and its bytes are still
// the ones it was scanned at - so the next build does not read and scan it again.
fn cache_seen_flush<a>(c: (&a mut Cache)) -> unit {
    if c.root.len() == 0 {
        return ();
    }
    for k in c.seen_paths.len() {
        if c.seen_filed[k] != 0 {
            continue;
        }
        path := c.seen_paths[k].copy();
        if !eq(view(file_stamp(view(path))), view(c.seen_stamps[k])) {
            continue;
        }
        read_ms := host::wall_ms();
        text := host::read_file(view(path));
        if !read_settled(view(path), read_ms) || !eq(view(store_hash(view(text))), view(c.seen[k].digest)) {
            continue;
        }
        mut uses = u8[][];
        for u in c.seen[k].uses.len() {
            uses.push(c.seen[k].uses[u].copy());
        }
        info := FileInfo { digest: c.seen[k].digest.copy(), module: c.seen[k].module.copy(), uses: uses, embed: c.seen[k].embed };
        stamp := c.seen_stamps[k].copy();
        fp_write(&mut c, view(path), view(stamp), &info, true);
        c.seen_filed[k] = 1;
    }
    // A module set waits on files: each must now have a verified record at its stamp.
    for n in c.pend_notes.len() {
        mut ready = true;
        for w in c.pend_waits[n].len() {
            path := c.pend_waits[n][w].copy();
            mut found = false;
            for k in c.seen_paths.len() {
                if eq(view(c.seen_paths[k]), view(path)) && (c.seen_filed[k] != 0) && eq(view(file_stamp(view(path))), view(c.seen_stamps[k])) {
                    found = true;
                }
            }
            if !found {
                ready = false;
            }
        }
        if ready {
            note := c.pend_notes[n].copy();
            body := c.pend_bodies[n].copy();
            cache_put_file(&mut c, view(note), view(body));
        }
    }
    return ();
}
// The digest of a file's bytes (store_hash), empty when it cannot be read.
fn cache_digest_file<a, b>(c: (&a mut Cache), path: &b [u8]) -> u8[] {
    return cache_file_info(&mut c, path, false).digest;
}
// Write `bytes` to `dest` whole or not at all: into a staging directory this call claimed, then
// rename(2) over the destination.
fn cache_put_file<a, b, d>(c: (&a mut Cache), dest: &b [u8], bytes: &d [u8]) -> bool {
    tmp := cache_claim_tmp(&mut c);
    if tmp.len() == 0 {
        return false;
    }
    pending := path_join(view(tmp), view("out"));
    mut ok = host::write_file(view(pending), view(bytes)) == 0;
    if ok {
        ok = host::rename(view(pending), view(dest)) == 0;
    }
    cache_release_tmp(view(tmp));
    return ok;
}
// A toolchain's identity: the words it is invoked with plus the version it reports. The internal
// assembler is the compiler's own binary, so its identity is the compiler's digest; any other tool
// is asked for its version once per binary - the answer is filed under `tool-id/` by the words and
// the stamp of the file PATH resolves the first one to, so a reinstalled tool is asked again.
fn cache_tool_id<a, b>(c: (&a mut Cache), words_in: (&b u8[][])) -> u8[] {
    mut text = u8[];
    for i in words_in.len() {
        push_bytes(&mut text, view(item(&words_in, i)));
        text.push(10);
    }
    exe := host::exe_path();
    if (words_in.len() >= 2) && eq(view(words_in[0]), view(exe)) && eq(view(words_in[1]), view("asm")) {
        push_bytes(&mut text, view("compiler "));
        push_bytes(&mut text, view(cache_digest_file(&mut c, view(exe))));
        return store_hash(view(text));
    }
    mut note = u8[];
    if words_in.len() != 0 {
        resolved := tool_path(view(words_in[0]));
        stamp := file_stamp(view(resolved));
        if (stamp.len() != 0) && (c.root.len() != 0) {
            mut key = copy(view(text));
            push_bytes(&mut key, view(resolved));
            key.push(10);
            push_bytes(&mut key, view(stamp));
            note = path_join(view(path_join(view(c.root), view("tool-id"))), view(store_hash(view(key))[0..32]));
            if host::exists(view(note)) != 0 {
                known := host::read_file(view(note));
                if known.len() == 64 {
                    return known;
                }
            }
        }
    }
    mut script = u8[];
    for i in words_in.len() {
        sh_word(&mut script, view(item(&words_in, i)));
        script.push(32);
    }
    tmp := cache_claim_tmp(&mut c);
    out := path_join(view(tmp), view("out"));
    push_bytes(&mut script, view("--version > "));
    sh_word(&mut script, view(out));
    push_bytes(&mut script, view(" 2>&1"));
    mut run = u8[][copy(view("sh")), copy(view("-c")), script];
    if (tmp.len() != 0) && (host::command(run) == 0) {
        if host::exists(view(out)) != 0 {
            push_bytes(&mut text, view(host::read_file(view(out))));
        }
    }
    cache_release_tmp(view(tmp));
    digest := store_hash(view(text));
    if note.len() != 0 {
        cache_put_file(&mut c, view(note), view(digest));
    }
    return digest;
}
// Where a command word runs from: itself when it names a path, else the first PATH entry holding a
// regular file of that name (empty when none does).
fn tool_path<a>(word: &a [u8]) -> u8[] {
    for i in word.len() {
        if word[i] == 47 {
            return copy(view(word));
        }
    }
    dirs := host::env(view("PATH"));
    mut start = 0;
    mut i = 0;
    while i <= dirs.len() {
        if (i == dirs.len()) || (dirs[i] == 58) {
            if i > start {
                candidate := path_join(view(dirs[start..i]), view(word));
                if file_stamp(view(candidate)).len() != 0 {
                    return candidate;
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return u8[];
}
fn cache_record_path<a, b, d>(root: &a [u8], kind: &b [u8], key: &d [u8]) -> u8[] {
    map := path_join(view(root), view("map"));
    dir := path_join(view(map), view(kind));
    return path_join(view(dir), view(key));
}
// One `field value` line of a record; empty when the record is absent or does not have that field.
fn cache_field<a, b, d, e>(root: &a [u8], kind: &b [u8], key: &d [u8], field: &e [u8]) -> u8[] {
    path := cache_record_path(view(root), view(kind), view(key));
    if host::exists(view(path)) == 0 {
        return u8[];
    }
    cache_touch(view(root), view(kind), view(key));
    text := host::read_file(view(path));
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        w := words(view(row));
        if (2 <= w.len()) & eq(view(item(&w, 0)), view(field)) {
            return item(&w, 1);
        }
    }
    return u8[];
}
// The rest of a line after a fixed-length field: paths may contain spaces, so a record names a file
// by writing its digest first and the path after it.
fn cache_rest<a>(row: &a [u8], start: u64) -> u8[] {
    mut i = start;
    while (i < row.len()) & (row[i] == 32) {
        i += 1;
    }
    mut out = u8[];
    while i < row.len() {
        out.push(row[i]);
        i += 1;
    }
    return out;
}
// Publish a record: write it in a staging directory, then rename it into place.
fn cache_record_put<a, b, d, e>(
    c: (&a mut Cache),
    kind: &b [u8],
    key: &d [u8],
    body: &e [u8]
) -> unit {
    dest := cache_record_path(view(c.root), view(kind), view(key));
    if !cache_put_file(&mut c, view(dest), view(body)) {
        return ();
    }
    cache_touch(view(c.root), view(kind), view(key));
    return ();
}
fn hex_byte(b: u8) -> bool {
    return ((48 <= b) & (b <= 57)) || ((97 <= b) & (b <= 102));
}
// `grail cache prune [--keep N]`: drop every record no build used in the last N (default 10), then
// every blob no remaining record names, and whatever a killed build left in `stage/`.
// `grail cache clear` empties the store. Both cover every target under the store (cache_base).
// ---- the store's GC ------------------------------------------------------------------------
//
// Every entry of the store has a last use, in builds (the store's generation counter): a `map/`
// record has its `.used` stamp (cache_touch), and a per-function entry - a unit, a body record
// (`dr-`), an optimiser memo entry (`opt-`) - the newest generation any run's use list in
// `fn/used/` names it under (fncache::note_used). `cache_gc` measures the store and, when it is over
// `cap` bytes, evicts entries oldest-use first, a whole generation at a time and never the newest
// one, until it is under three quarters of the cap; then the blobs no remaining record names. An
// evicted entry is only ever a miss for the build that would have used it. The use lists are folded
// into one file. Returns [bytes before, bytes after, entries evicted].
struct GcEntry {
    path: u8[],
    used: u8[],
    size: u64,
    generation: u64
}
fn gc_size<a>(path: &a [u8]) -> u64 {
    st := host::stat(view(path), 0);
    if (3 <= st.len()) && (st[0] == 0) && (st[1] == 1) {
        return st[2];
    }
    return 0;
}
// A small table from an entry's name to its newest generation.
fn gc_slot<a, b>(slots: (&a u64[]), names: (&b u8[][]), name: &b [u8]) -> u64 {
    mut h: u64 = 14695981039346656037;
    for i in name.len() {
        h = wrapping_mul(h ^ u64(name[i]), 1099511628211);
    }
    mask := slots.len() - 1;
    mut at = h & mask;
    while slots[at] != 0 {
        if eq(view(names[slots[at] - 1]), view(name)) {
            return at;
        }
        at = (at + 1) & mask;
    }
    return at;
}
// A file's bytes, or nothing when it has gone. Every build on the machine shares the store, and
// another build's collection folds the use lists - removing each list it read - and evicts records
// between this one's listing of a directory and its read of what it listed: `host::read_file` aborts
// on a missing file, which killed that build (the front-end fuzzer's SIGABRTs, four jobs at a time).
// A list or a mark that has gone says less about recency, which only orders eviction.
fn read_if_present<a>(path: &a [u8]) -> u8[] {
    fd := host::open(view(path), 0);
    if 9223372036854775807 < fd {
        return u8[];
    }
    mut out = u8[];
    while true {
        chunk := host::read_fd(fd, 65536);
        if chunk.len() == 0 {
            break;
        }
        push_bytes(&mut out, view(chunk));
    }
    host::close(fd);
    return out;
}
fn cache_gc<a>(root: &a [u8], cap: u64) -> u64[] {
    now := cache_generation(view(root));
    fn_dir := fn_store(view(root));
    used_dir := path_join(view(fn_dir), view("used"));
    // The newest use of every per-function entry.
    mut slots = u64[];
    for i in 65536 {
        slots.push(0);
    }
    mut names = u8[][];
    mut gens = u64[];
    if host::exists(view(used_dir)) != 0 {
        lists := host::list_dir(view(used_dir));
        for l in lists.len() {
            text := read_if_present(view(path_join(view(used_dir), view(item(&lists, l)))));
            rows := lines(view(text));
            for r in rows.len() {
                w := words(view(item(&rows, r)));
                if w.len() != 2 {
                    continue;
                }
                g := number_of(view(item(&w, 0)));
                name := item(&w, 1);
                if slots.len() < names.len() * 2 {
                    break;
                }
                at := gc_slot(&slots, &names, view(name));
                if slots[at] == 0 {
                    names.push(name);
                    gens.push(g);
                    slots[at] = names.len();
                } else if gens[slots[at] - 1] < g {
                    gens[slots[at] - 1] = g;
                }
            }
        }
    }
    mut entries = GcEntry[];
    mut total = 0;
    if host::exists(view(fn_dir)) != 0 {
        files := host::list_dir(view(fn_dir));
        for f in files.len() {
            name := item(&files, f);
            path := path_join(view(fn_dir), view(name));
            size := gc_size(view(path));
            if size == 0 {
                continue;
            }
            mut g = 0;
            at := gc_slot(&slots, &names, view(name));
            if slots[at] != 0 {
                g = gens[slots[at] - 1];
            }
            entries.push(GcEntry { path: path, used: u8[], size: size, generation: g });
            total += size;
        }
    }
    kinds := u8[][copy(view("prog")), copy(view("lnk")), copy(view("mod")), copy(view("unit")), copy(view("check"))];
    for k in kinds.len() {
        dir := path_join(view(path_join(view(root), view("map"))), view(item(&kinds, k)));
        if host::exists(view(dir)) == 0 {
            continue;
        }
        records := host::list_dir(view(dir));
        for e in records.len() {
            name := item(&records, e);
            if ends(view(name), view(".used")) {
                continue;
            }
            path := path_join(view(dir), view(name));
            used := cat(view(path), view(".used"));
            mut g = 0;
            if host::exists(view(used)) != 0 {
                g = number_of(view(read_if_present(view(used))));
            }
            size := gc_size(view(path));
            entries.push(GcEntry { path: path, used: used, size: size, generation: g });
            total += size;
        }
    }
    blobs := path_join(view(root), view("blob"));
    mut blob_names = u8[][];
    mut blob_sizes = u64[];
    if host::exists(view(blobs)) != 0 {
        list := host::list_dir(view(blobs));
        for b in list.len() {
            size := gc_size(view(path_join(view(blobs), view(item(&list, b)))));
            blob_names.push(item(&list, b));
            blob_sizes.push(size);
            total += size;
        }
    }
    before := total;
    mut evicted = 0;
    if cap < total {
        target := cap / 4 * 3;
        // The generations in use, oldest first; the newest is the build that just ran.
        mut order = u64[];
        for i in entries.len() {
            g := entries[i].generation;
            mut seen = false;
            for j in order.len() {
                if order[j] == g {
                    seen = true;
                }
            }
            if !seen {
                order.insert(gc_place(&order, g), g);
            }
        }
        mut live = entries.len();
        mut gone = u64[];
        for i in entries.len() {
            gone.push(0);
        }
        for o in order.len() {
            if (total <= target) || (now <= order[o]) {
                break;
            }
            for i in entries.len() {
                if (gone[i] == 0) && (entries[i].generation == order[o]) {
                    host::remove(view(entries[i].path), 0);
                    if entries[i].used.len() != 0 {
                        host::remove(view(entries[i].used), 0);
                    }
                    gone[i] = 1;
                    total -= entries[i].size;
                    evicted += 1;
                    live -= 1;
                }
            }
            // The blobs no remaining record names go too.
            mut referenced = u8[];
            for i in entries.len() {
                if (gone[i] == 0) && (entries[i].used.len() != 0) {
                    text := read_if_present(view(entries[i].path));
                    mut run = 0;
                    for x in text.len() {
                        if hex_byte(text[x]) {
                            run += 1;
                        } else {
                            run = 0;
                        }
                        if run == 64 {
                            for y in 64 {
                                referenced.push(text[x + 1 - 64 + y]);
                            }
                            referenced.push(10);
                        }
                    }
                }
            }
            for b in blob_names.len() {
                if (blob_sizes[b] != 0) && !cache_contains(view(referenced), view(blob_names[b])) {
                    host::remove(view(path_join(view(blobs), view(blob_names[b]))), 0);
                    total -= blob_sizes[b];
                    blob_sizes[b] = 0;
                    evicted += 1;
                }
            }
        }
    }
    // One use list in place of many: the newest generation of every entry still in the store.
    if host::exists(view(used_dir)) != 0 {
        mut folded = u8[];
        for i in names.len() {
            if host::exists(view(path_join(view(fn_dir), view(names[i])))) != 0 {
                folded = cat(view(folded), view(decimal(gens[i])));
                folded.push(32);
                folded = cat(view(folded), view(names[i]));
                folded.push(10);
            }
        }
        old := host::list_dir(view(used_dir));
        if 1 < old.len() {
            dest := path_join(view(used_dir), view("folded"));
            staged := path_join(view(cache_stage_dir(view(root))), view("used.folded"));
            if host::write_file(view(staged), view(folded)) == 0 {
                for l in old.len() {
                    if !eq(view(item(&old, l)), view("folded")) {
                        host::remove(view(path_join(view(used_dir), view(item(&old, l)))), 0);
                    }
                }
                host::rename(view(staged), view(dest));
            }
        }
    }
    return u64[before, total, evicted];
}
fn cache_stage_dir<a>(root: &a [u8]) -> u8[] {
    dir := path_join(view(root), view("stage"));
    host::mkdir(view(dir));
    return dir;
}
// Where `g` goes in the ascending list `order`.
fn gc_place<a>(order: (&a u64[]), g: u64) -> u64 {
    mut at = 0;
    while (at < order.len()) && (order[at] < g) {
        at += 1;
    }
    return at;
}
// The cap a build keeps the store under: GRAIL_CACHE_MAX bytes, 2 GiB by default.
fn cache_cap() -> u64 {
    asked := host::env(view("GRAIL_CACHE_MAX"));
    if asked.len() != 0 {
        return number_of(view(asked));
    }
    return 2147483648;
}
// After a build: every GRAIL_CACHE_GC_EVERY-th generation (8 by default) the store is measured and,
// over the cap, collected - measuring is a walk of the store, so not every build pays it.
fn cache_auto_gc<a>(c: (&a mut Cache)) -> unit {
    mut every = 8;
    asked := host::env(view("GRAIL_CACHE_GC_EVERY"));
    if asked.len() != 0 {
        every = number_of(view(asked));
    }
    if every == 0 {
        return ();
    }
    if cache_generation(view(c.root)) % every != 0 {
        return ();
    }
    r := cache_gc(view(c.root), cache_cap());
    if (r[2] != 0) & (c.quiet == 0) {
        mut line = copy(view("grail: cache: over its cap, "));
        push_bytes(&mut line, view(decimal(r[2])));
        push_bytes(&mut line, view(" least recently used entries evicted ("));
        push_bytes(&mut line, view(decimal(r[0] / 1048576)));
        push_bytes(&mut line, view(" MiB -> "));
        push_bytes(&mut line, view(decimal(r[1] / 1048576)));
        push_bytes(&mut line, view(" MiB)"));
        say(view(line));
    }
    return ();
}
fn cache_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() == 0 {
        say(view("usage: grail cache gc [--max BYTES] | grail cache prune [--keep N] | grail cache clear | grail cache warm [--target T]"));
        return 1;
    }
    sub := item(&args, 0);
    if eq(view(sub), view("warm")) {
        return cache_warm(&args);
    }
    if eq(view(sub), view("gc")) {
        // `grail cache gc [--max BYTES]`: every target's store down to the cap, least recently
        // used first (cache_gc).
        mut cap = cache_cap();
        if (args.len() == 3) && eq(view(item(&args, 1)), view("--max")) {
            cap = number_of(view(item(&args, 2)));
        }
        base := cache_base();
        if host::exists(view(base)) == 0 {
            host::print(view("cache: empty\n"));
            return 0;
        }
        targets := host::list_dir(view(base));
        mut before = 0;
        mut after = 0;
        mut evicted = 0;
        for t in targets.len() {
            root := path_join(view(base), view(item(&targets, t)));
            if host::exists(view(path_join(view(root), view("generation")))) == 0 {
                continue;
            }
            r := cache_gc(view(root), cap);
            before += r[0];
            after += r[1];
            evicted += r[2];
        }
        mut line = copy(view("cache: gc evicted "));
        push_bytes(&mut line, view(decimal(evicted)));
        push_bytes(&mut line, view(" entries; "));
        push_bytes(&mut line, view(decimal(before)));
        push_bytes(&mut line, view(" bytes -> "));
        push_bytes(&mut line, view(decimal(after)));
        push_bytes(&mut line, view(" bytes (cap "));
        push_bytes(&mut line, view(decimal(cap)));
        push_bytes(&mut line, view(")\n"));
        host::print(view(line));
        return 0;
    }
    if eq(view(sub), view("clear")) {
        mut run = u8[][copy(view("rm")), copy(view("-rf")), cache_base()];
        host::command(run);
        host::print(view("cache: cleared\n"));
        return 0;
    }
    if !eq(view(sub), view("prune")) {
        say(view("usage: grail cache gc [--max BYTES] | grail cache prune [--keep N] | grail cache clear | grail cache warm [--target T]"));
        return 1;
    }
    mut keep = 10;
    if (args.len() == 3) && eq(view(item(&args, 1)), view("--keep")) {
        keep = number_of(view(item(&args, 2)));
    }
    mut records_dropped = 0;
    mut records_kept = 0;
    mut blobs_dropped = 0;
    mut blobs_kept = 0;
    base := cache_base();
    if host::exists(view(base)) == 0 {
        host::print(view("cache: empty\n"));
        return 0;
    }
    // Probe bases are rebuilt on demand (one compile of the runtime and the standard library), so
    // a prune drops them all rather than tracking their use.
    probes := probe_base_root();
    if host::exists(view(probes)) != 0 {
        mut drop_probes = u8[][copy(view("rm")), copy(view("-rf")), probes.copy()];
        host::command(drop_probes);
    }
    targets := host::list_dir(view(base));
    for t in targets.len() {
        root := path_join(view(base), view(item(&targets, t)));
        now := cache_generation(view(root));
        mut live = u8[];
        kinds := u8[][copy(view("prog")), copy(view("lnk")), copy(view("mod")), copy(view("unit")), copy(view("check"))];
        for k in kinds.len() {
            dir := path_join(view(path_join(view(root), view("map"))), view(item(&kinds, k)));
            if host::exists(view(dir)) == 0 {
                continue;
            }
            entries := host::list_dir(view(dir));
            for e in entries.len() {
                name := item(&entries, e);
                if ends(view(name), view(".used")) {
                    continue;
                }
                record := path_join(view(dir), view(name));
                used_path := cat(view(record), view(".used"));
                mut used = 0;
                if host::exists(view(used_path)) != 0 {
                    used = number_of(view(host::read_file(view(used_path))));
                }
                if (used + keep) < now {
                    host::remove(view(record), 0);
                    host::remove(view(used_path), 0);
                    records_dropped += 1;
                    continue;
                }
                records_kept += 1;
                // Every 64-hex-digit run a record holds is a blob it names.
                text := host::read_file(view(record));
                mut run = 0;
                for i in text.len() {
                    if hex_byte(text[i]) {
                        run += 1;
                    } else {
                        run = 0;
                    }
                    if run == 64 {
                        for j in 64 {
                            live.push(text[i + 1 - 64 + j]);
                        }
                        live.push(10);
                    }
                }
            }
        }
        blobs := path_join(view(root), view("blob"));
        if host::exists(view(blobs)) != 0 {
            names := host::list_dir(view(blobs));
            for b in names.len() {
                name := item(&names, b);
                if cache_contains(view(live), view(name)) {
                    blobs_kept += 1;
                } else {
                    host::remove(view(path_join(view(blobs), view(name))), 0);
                    blobs_dropped += 1;
                }
            }
        }
        stage := path_join(view(root), view("stage"));
        if host::exists(view(stage)) != 0 {
            leftovers := host::list_dir(view(stage));
            for l in leftovers.len() {
                host::remove(view(path_join(view(stage), view(item(&leftovers, l)))), 0);
            }
        }
        // The per-function store is dropped whole: its entries carry no generation stamp, and one
        // is only reached by a module run that already missed, so dropping it costs the first such
        // run a re-emission and never a rebuild of anything the module cache holds. `rm -rf` rather
        // than a listing, so a killed build's `fn/stage/` goes with it.
        fn_dir := fn_store(view(root));
        if host::exists(view(fn_dir)) != 0 {
            removal := u8[][copy(view("rm")), copy(view("-rf")), fn_dir];
            host::command(removal);
        }
        // What the store remembers about files, tools and module sets is rebuilt by the next build
        // that asks: dropped whole, like the per-function store.
        notes := u8[][copy(view("fp")), copy(view("tool-id")), copy(view("inputs"))];
        for n in notes.len() {
            dir := path_join(view(root), view(item(&notes, n)));
            if host::exists(view(dir)) != 0 {
                entries := host::list_dir(view(dir));
                for e in entries.len() {
                    host::remove(view(path_join(view(dir), view(item(&entries, e)))), 0);
                }
            }
        }
    }
    mut line = copy(view("cache: pruned "));
    push_bytes(&mut line, view(decimal(records_dropped)));
    push_bytes(&mut line, view(" records and "));
    push_bytes(&mut line, view(decimal(blobs_dropped)));
    push_bytes(&mut line, view(" blobs; kept "));
    push_bytes(&mut line, view(decimal(records_kept)));
    push_bytes(&mut line, view(" records and "));
    push_bytes(&mut line, view(decimal(blobs_kept)));
    push_bytes(&mut line, view(" blobs\n"));
    host::print(view(line));
    return 0;
}
// `grail cache warm [--target T]`: check and build every standard module into the store, as a
// toolchain ships its standard library ready (rustup's libstd, Go's std in GOCACHE): a project's
// first check then compiles only its own modules. One program that `use`s every module of the
// standard directory is checked and built in the store's stage, through the ordinary commands, so
// the records it files are exactly the ones a project's build would look up. The install step runs
// it; running it again is a no-op.
fn cache_warm<a>(args: (&a u8[][])) -> u64 {
    h := home();
    if h.std.len() == 0 {
        return 1;
    }
    mut target = u8[];
    if (args.len() == 3) && eq(view(item(args, 1)), view("--target")) {
        target = item(args, 2);
    }
    mut store = Cache { root: u8[], cwd: host::cwd(), hits: 0, misses: 0, names: u8[][], quiet: 1, seen_paths: u8[][], seen_stamps: u8[][], seen: FileInfo[], seen_filed: u64[], pend_notes: u8[][], pend_bodies: u8[][], pend_waits: u8[][][] };
    mut program = u8[];
    entries := host::list_dir(view(h.std));
    mut count = 0;
    for e in entries.len() {
        name := item(&entries, e);
        if !ends_with_grl(view(name)) {
            continue;
        }
        info := cache_file_info(&mut store, view(path_join(view(h.std), view(name))), true);
        if info.module.len() != 0 {
            push_bytes(&mut program, view("use "));
            push_bytes(&mut program, view(info.module));
            push_bytes(&mut program, view(";\n"));
            count += 1;
        }
    }
    push_bytes(&mut program, view("fn main() {}\n"));
    // The program lives in the target's stage, which `grail cache prune` empties.
    mut named = target.copy();
    if named.len() == 0 {
        named = target_name(host::target());
    }
    stage := path_join(view(cache_root(view(named))), view("stage"));
    cache_mkdirs(view(stage));
    dir := path_join(view(stage), view(cat(view("warm."), view(decimal(host::now_us())))));
    host::mkdir(view(dir));
    entry := path_join(view(dir), view("main.grl"));
    host::write_file(view(entry), view(program));
    exe := host::exe_path();
    mut failed = 0;
    for step in 2 {
        mut run = u8[][exe.copy()];
        if step == 0 {
            run.push(copy(view("check")));
        } else {
            run.push(copy(view("build")));
        }
        run.push(entry.copy());
        run.push(copy(view("-o")));
        run.push(path_join(view(dir), view("warm")));
        if target.len() != 0 {
            run.push(copy(view("--target")));
            run.push(target.copy());
        }
        if host::command(run) != 0 {
            failed = 1;
        }
    }
    removal := u8[][copy(view("rm")), copy(view("-rf")), dir];
    host::command(removal);
    mut line = copy(view("cache: warm: "));
    push_bytes(&mut line, view(decimal(count)));
    push_bytes(&mut line, view(" standard modules checked and built"));
    if failed != 0 {
        push_bytes(&mut line, view(" (a step failed; what it filed stays)"));
    }
    say(view(line));
    return failed;
}
// File an artifact under the digest of its bytes: one read, then a staging copy renamed into place.
fn cache_blob_put<a, b>(c: (&a mut Cache), path: &b [u8]) -> u8[] {
    if host::exists(view(path)) == 0 {
        return u8[];
    }
    bytes := host::read_file(view(path));
    digest := store_hash(view(bytes));
    fp_note(&mut c, view(path), view(digest));
    // A blob that is already filed under this name is only reused if its bytes still hash to it: a
    // corrupted entry is replaced, so corruption costs one rebuild and not every build after it.
    if cache_blob_ok(&mut c, view(digest)) {
        return digest;
    }
    blob := path_join(view(path_join(view(c.root), view("blob"))), view(digest));
    if !cache_put_file(&mut c, view(blob), view(bytes)) {
        return u8[];
    }
    fp_note(&mut c, view(blob), view(digest));
    return digest;
}
// A blob is usable only when its bytes still hash to the name it is filed under - which its `fp/`
// record answers without a read while the blob's stamp is the one it was filed with.
fn cache_blob_ok<a, b>(c: (&a mut Cache), digest: &b [u8]) -> bool {
    if digest.len() != 64 {
        return false;
    }
    blob := path_join(view(path_join(view(c.root), view("blob"))), view(digest));
    if host::exists(view(blob)) == 0 {
        return false;
    }
    actual := cache_digest_file(&mut c, view(blob));
    return eq(view(actual), view(digest));
}
// Put a filed artifact back at `dest`, through a staging name so `dest` is only ever the whole file.
// An executable image needs its mode bits, which only `chmod` gives a new file here: that one case
// is a shell step.
fn cache_blob_restore<a, b, d>(
    c: (&a mut Cache),
    digest: &b [u8],
    dest: &d [u8],
    executable: u64
) -> u64 {
    blob := path_join(view(path_join(view(c.root), view("blob"))), view(digest));
    if host::exists(view(blob)) == 0 {
        return 1;
    }
    pending := cat(view(dest), view(".cache-pending"));
    if executable == 0 {
        if host::write_file(view(pending), view(host::read_file(view(blob)))) != 0 {
            return 1;
        }
        if host::rename(view(pending), view(dest)) != 0 {
            return 1;
        }
        fp_note(&mut c, view(dest), view(digest));
        return 0;
    }
    mut script = u8[];
    push_bytes(&mut script, view("set -e\ncp "));
    sh_word(&mut script, view(blob));
    script.push(32);
    sh_word(&mut script, view(pending));
    push_bytes(&mut script, view("\nchmod 755 "));
    sh_word(&mut script, view(pending));
    push_bytes(&mut script, view("\nmv -f "));
    sh_word(&mut script, view(pending));
    script.push(32);
    sh_word(&mut script, view(dest));
    mut run = u8[][copy(view("sh")), copy(view("-c")), script];
    if host::command(run) != 0 {
        return 1;
    }
    fp_note(&mut c, view(dest), view(digest));
    return 0;
}
fn cache_contains<a, b>(text: &a [u8], needle: &b [u8]) -> bool {
    if needle.len() > text.len() {
        return false;
    }
    mut i: u64 = 0;
    while i + needle.len() <= text.len() {
        mut j: u64 = 0;
        mut ok = 1;
        while j < needle.len() {
            if text[i + j] != needle[j] {
                ok = 0;
                break;
            }
            j += 1;
        }
        if ok != 0 {
            return true;
        }
        i += 1;
    }
    return false;
}
fn cache_decimal<a>(out: (&a mut u8[]), n: u64) -> unit {
    if 9 < n {
        cache_decimal(&mut out, n / 10);
    }
    out.push(48 + n % 10);
    return ();
}
// The part a files holds: `STEM.NNN.module.s` -> `NNN.module`, unique within one build.
fn part_id<a>(path: &a [u8]) -> u8[] {
    mut end = path.len();
    if (end > 1) & (path[end - 1] == 115) & (path[end - 2] == 46) {
        end -= 2;
    }
    mut i = end;
    mut stop = end;
    mut count: u64 = 0;
    while i > 0 {
        i -= 1;
        if path[i] == 46 {
            count += 1;
            if count == 2 {
                stop = i + 1;
                break;
            }
        }
    }
    mut out = u8[];
    mut k = stop;
    while k < end {
        out.push(path[k]);
        k += 1;
    }
    return out;
}
// The module a part file holds: the last dot-separated segment of the stem.
fn part_module<a>(path: &a [u8]) -> u8[] {
    mut end = path.len();
    if (end > 1) & (path[end - 1] == 115) & (path[end - 2] == 46) {
        end -= 2;
    }
    mut i = end;
    mut at = end;
    while i > 0 {
        i -= 1;
        if path[i] == 46 {
            at = i + 1;
            break;
        }
    }
    mut out = u8[];
    mut k = at;
    while k < end {
        out.push(path[k]);
        k += 1;
    }
    return out;
}
// The index of the input a module was emitted from, plus one; 0 when no input declares it.
fn cache_source_of<s, d, n>(sources: (&s u8[][]), digests: (&d u8[][]), name: &n [u8]) -> u64 {
    for i in sources.len() {
        if eq(view(basename(view(item(&sources, i)))), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
// What an importer reads of a dependency: its interface when the build reads interfaces, and the
// dependency's source digest otherwise - a stand-in that costs extra misses instead of being wrong.
fn cache_dep_digest<a, b, n>(c: (&a mut Cache), id: (&b BuildId), name: &n [u8]) -> u8[] {
    if id.iface_dir.len() != 0 {
        name_file := cat(view(name), view(".iface"));
        path := path_join(view(id.iface_dir), view(name_file));
        if host::exists(view(path)) != 0 {
            return cache_digest_file(&mut c, view(path));
        }
    }
    i := cache_source_of(&id.sources, &id.digests, view(name));
    if i == 0 {
        return u8[];
    }
    return item(&id.digests, i - 1);
}
// Whether a module's source names another module: `use NAME` or a `NAME::` reference.
fn cache_mentions<a, b>(text: &a [u8], name: &b [u8]) -> bool {
    qualified := cat(view(name), view("::"));
    if cache_contains(view(text), view(qualified)) {
        return true;
    }
    used := cat(view("use "), view(name));
    return cache_contains(view(text), view(used));
}
// The key material of one build: the flag vector as the compiler will see it, the compiler's own
// digest, the inputs in command-line order with their digests, the interfaces read, and the tools.
fn cache_build_id<a, b, d, e, g>(
    c: (&a mut Cache),
    argv: (&b u8[][]),
    asm: &d [u8],
    emulation: &e [u8],
    assemble: (&g u8[][])
) -> BuildId {
    mut id = BuildId {
        flags: u8[],
        compiler: u8[],
        assembler: u8[],
        linker: u8[],
        ifaces: u8[],
        iface_dir: u8[],
        sources: u8[][],
        digests: u8[][],
    };
    mut flagbuf = u8[];
    push_bytes(&mut flagbuf, view("grail-cache-flags 1\n"));
    mut i: u64 = 1;
    while i < argv.len() {
        a := item(&argv, i);
        if eq(view(a), view("--target")) & (i + 1 < argv.len()) {
            push_bytes(&mut flagbuf, view("target "));
            push_bytes(&mut flagbuf, view(item(&argv, i + 1)));
            flagbuf.push(10);
            i += 2;
        } else if eq(view(a), view("--module-root")) & (i + 1 < argv.len()) {
            // `--module-root DIR` names the directory `use` resolves modules in, and DIR is a
            // *directory*, not a source to hash. The flag is in the key; the modules it makes
            // reachable are hashed one by one as the sources they are.
            push_bytes(&mut flagbuf, view("module-root "));
            push_bytes(&mut flagbuf, view(item(&argv, i + 1)));
            flagbuf.push(10);
            i += 2;
        } else if eq(view(a), view("--diagnostics-json")) & (i + 1 < argv.len()) {
            i += 2;
        } else if eq(view(a), view("--check")) {
            // A check and a build of one module read the same inputs and agree on its interface:
            // the key is the same, and a check reuses a build's record (unit_restore_check).
            i += 1;
        } else {
            if (eq(view(a), view("--interface")) || eq(view(a), view("--emit-interface")))
                & (i + 1 < argv.len()) {
                id.iface_dir = item(&argv, i + 1);
                // The interfaces a module reads are named one by one in its own key, so the set as a
                // whole belongs to the program key and not to the flag vector every module shares.
                manifest := path_join(view(id.iface_dir), view("interfaces.manifest"));
                id.ifaces = cache_digest_file(&mut c, view(manifest));
                i += 2;
            } else {
                if eq(view(a), view("--module-root")) & (i + 1 < argv.len()) {
                    // A module root is a directory, not an input: the modules it resolves are modules
                    // of the program, and the record written here lists each one's source.
                    i += 2;
                } else {
                    if (a.len() != 0) & (a[0] == 45) {
                        push_bytes(&mut flagbuf, view(a));
                        flagbuf.push(10);
                        i += 1;
                    } else {
                        if !eq(view(a), view(asm)) {
                            digest := cache_digest_file(&mut c, view(a));
                            id.sources.push(copy(view(a)));
                            id.digests.push(digest);
                        }
                        i += 1;
                    }
                }
            }
        }
    }
    id.flags = store_hash(view(flagbuf));
    exe := host::exe_path();
    id.compiler = cache_digest_file(&mut c, view(exe));
    // The assembler's identity: clang's `--version`, or for the internal assembler (`grail asm`) the
    // compiler's own digest above, which is the same binary.
    id.assembler = cache_tool_id(&mut c, assemble);
    mut linker = u8[][
        tool(view("GRAIL_LINKER"), view("ld.lld")),
        copy(view("-m")),
        copy(view(emulation))
    ];
    id.linker = cache_tool_id(&mut c, &linker);
    return id;
}
fn cache_program_key<a, b, d, e>(
    c: (&a mut Cache),
    id: (&b BuildId),
    target: &d [u8],
    asm: &e [u8]
) -> u8[] {
    mut buf = u8[];
    push_bytes(&mut buf, view("grail-cache-program 1\ntarget "));
    push_bytes(&mut buf, view(target));
    push_bytes(&mut buf, view("\nflags "));
    push_bytes(&mut buf, view(id.flags));
    push_bytes(&mut buf, view("\ncompiler "));
    push_bytes(&mut buf, view(id.compiler));
    push_bytes(&mut buf, view("\nassembler "));
    push_bytes(&mut buf, view(id.assembler));
    push_bytes(&mut buf, view("\nlinker "));
    push_bytes(&mut buf, view(id.linker));
    push_bytes(&mut buf, view("\nifaces "));
    push_bytes(&mut buf, view(id.ifaces));
    push_bytes(&mut buf, view("\noutput "));
    push_bytes(&mut buf, view(asm));
    buf.push(10);
    for i in id.sources.len() {
        push_bytes(&mut buf, view(item(&id.sources, i)));
        buf.push(32);
        push_bytes(&mut buf, view(item(&id.digests, i)));
        buf.push(10);
    }
    return store_hash(view(buf));
}
fn cache_module_key<a, b, d, e, g>(
    c: (&a mut Cache),
    id: (&b BuildId),
    target: &d [u8],
    part: &e [u8],
    parts: (&g u8[][])
) -> u8[] {
    name := part_module(view(part));
    mut buf = u8[];
    push_bytes(&mut buf, view("grail-cache-module 1\npart "));
    push_bytes(&mut buf, view(part_id(view(part))));
    push_bytes(&mut buf, view("\ntarget "));
    push_bytes(&mut buf, view(target));
    push_bytes(&mut buf, view("\nflags "));
    push_bytes(&mut buf, view(id.flags));
    push_bytes(&mut buf, view("\ncompiler "));
    push_bytes(&mut buf, view(id.compiler));
    push_bytes(&mut buf, view("\nassembler "));
    push_bytes(&mut buf, view(id.assembler));
    // Only the interfaces *this* module reads, which the dependency lines below carry: the digest of
    // the whole interface set is an input of the program, not of any one module.
    at := cache_source_of(&id.sources, &id.digests, view(name));
    push_bytes(&mut buf, view("\nsource "));
    if at != 0 {
        push_bytes(&mut buf, view(item(&id.digests, at - 1)));
        // And where it is: the object carries its source's path (runtime-error locations), and the
        // store is shared between projects, so the same text at another path is another object.
        buf.push(32);
        push_bytes(&mut buf, view(item(&id.sources, at - 1)));
    }
    buf.push(10);
    // The trusted base: every module is emitted against the runtime and the platform module.
    for k in id.sources.len() {
        base_name := basename(view(item(&id.sources, k)));
        if eq(view(base_name), view("runtime"))
            || eq(view(base_name), view("os-linux"))
            || eq(view(base_name), view("darwin")) {
            push_bytes(&mut buf, view("base "));
            push_bytes(&mut buf, view(base_name));
            buf.push(32);
            push_bytes(&mut buf, view(item(&id.digests, k)));
            buf.push(10);
        }
    }
    // What this module reads of its dependencies, in emission order.
    if at != 0 {
        text := host::read_file(view(item(&id.sources, at - 1)));
        for k in parts.len() {
            other := part_module(view(item(&parts, k)));
            if !eq(view(other), view(name)) & cache_mentions(view(text), view(other)) {
                push_bytes(&mut buf, view("dep "));
                push_bytes(&mut buf, view(other));
                buf.push(32);
                push_bytes(&mut buf, view(cache_dep_digest(&mut c, id, view(other))));
                buf.push(10);
            }
        }
    }
    return store_hash(view(buf));
}
// The one line a cached build prints: what was reused, what was not, and what ran.
fn cache_report<a>(c: (&a mut Cache), relinked: u64) -> unit {
    if c.quiet != 0 {
        return ();
    }
    host::print(view("grail: cache: "));
    host::print_num(c.hits);
    host::print(view(" hit, "));
    host::print_num(c.misses);
    host::print(view(" miss"));
    if c.misses != 0 {
        host::print(view(" ("));
        for i in c.names.len() {
            if i != 0 {
                host::print(view(", "));
            }
            host::print(view(item(&c.names, i)));
        }
        host::print(view(")"));
    }
    host::print(view("; "));
    if relinked == 2 {
        host::print(view("checked"));
    } else if relinked == 0 {
        host::print(view("image reused"));
    } else {
        host::print(view("image linked"));
    }
    say(view(""));
    return ();
}
// The whole-program key is over every input the build reads, so a hit means nothing has to run: the
// image in the store is the image this build would produce.
fn cache_up_to_date<a, b, d>(c: (&a mut Cache), key: &b [u8], output: &d [u8]) -> u64 {
    blob := cache_field(view(c.root), view("prog"), view(key), view("blob"));
    if !cache_blob_ok(&mut c, view(blob)) {
        return 0;
    }
    count := cache_field(view(c.root), view("prog"), view(key), view("parts"));
    // The image a whole-program hit hands back is only this program's image if the files the link
    // named are still the files it was linked with.
    record := cache_record_path(view(c.root), view("prog"), view(key));
    if host::exists(view(record)) == 0 {
        return 0;
    }
    body := host::read_file(view(record));
    rows := lines(view(body));
    for i in rows.len() {
        row := item(&rows, i);
        // `link <digest> <path>` and `source <digest> <path>`: the digest is 64 hex, so the path
        // starts 65 bytes after the field name.
        mut skip = 0;
        if starts(view(row), view("link ")) {
            skip = 5;
        } else {
            if starts(view(row), view("source ")) {
                skip = 7;
            }
        }
        if (skip != 0) & (skip + 65 <= row.len()) {
            mut wanted = u8[];
            for k in 64 {
                wanted.push(row[skip + k]);
            }
            path := cache_rest(view(row), skip + 65);
            actual := cache_digest_file(&mut c, view(path));
            if !eq(view(actual), view(wanted)) {
                return 0;
            }
        }
    }
    mut here = u8[];
    if host::exists(view(output)) != 0 {
        here = cache_digest_file(&mut c, view(output));
    }
    if !eq(view(here), view(blob)) {
        if cache_blob_restore(&mut c, view(blob), view(output), 1) != 0 {
            return 0;
        }
    }
    // The same shape as a rebuild reports, so one line always says what hit, what missed and what ran.
    if c.quiet == 0 {
        host::print(view("grail: cache: "));
        host::print(view(count));
        host::print(view(" hit, 0 miss; program up to date\n"));
    }
    return 1;
}
// Assemble and link through the store, then file what was produced. The compiler has already written
// the parts manifest; everything after it is reused or recomputed per module.
fn cache_split<a, b, d, e, g, k, m>(
    c: (&a mut Cache),
    id: (&b BuildId),
    base: &d [u8],
    output: &e [u8],
    target: &g [u8],
    emulation: &k [u8],
    assemble: (&m u8[][]),
    program: &d [u8]
) -> u64 {
    manifest := cat(view(output), view(".parts"));
    mut text = u8[];
    if host::exists(view(manifest)) != 0 {
        text = host::read_file(view(manifest));
    }
    if !starts(view(text), view("// grail-parts 1")) {
        say(view("grail: missing or unreadable parts manifest "));
        say(view(manifest));
        return 1;
    }
    parts := read_split(view(manifest), view(base));
    if parts.asm.len() == 0 {
        say(view("grail: the parts manifest lists no modules"));
        return 1;
    }
    mut miss_sources = u8[][];
    mut miss_objects = u8[][];
    mut miss_at = u64[];
    mut digests = u8[][];
    for i in parts.asm.len() {
        part := item(&parts.asm, i);
        object := item(&parts.objects, i);
        key := cache_module_key(&mut c, id, view(target), view(part), &parts.asm);
        asm_digest := cache_digest_file(&mut c, view(part));
        recorded := cache_field(view(c.root), view("mod"), view(key), view("asm"));
        blob := cache_field(view(c.root), view("mod"), view(key), view("blob"));
        mut reused = 0;
        if (recorded.len() == 64)
            & eq(view(recorded), view(asm_digest))
            & cache_blob_ok(&mut c, view(blob)) {
            if cache_blob_restore(&mut c, view(blob), view(object), 0) == 0 {
                reused = 1;
            }
        }
        if reused != 0 {
            c.hits += 1;
            digests.push(blob);
        } else {
            c.misses += 1;
            c.names.push(part_module(view(part)));
            miss_sources.push(part);
            miss_objects.push(object);
            miss_at.push(i);
            digests.push(copy(view("")));
        }
    }
    if miss_sources.len() != 0 {
        if assemble_parts(assemble, &miss_sources, &miss_objects) != 0 {
            say(view("grail: assembling failed (needs clang)"));
            return 1;
        }
        // File the new objects only after they assembled, so a failed assembly leaves no entry.
        for i in miss_sources.len() {
            part := item(&miss_sources, i);
            object := item(&miss_objects, i);
            key := cache_module_key(&mut c, id, view(target), view(part), &parts.asm);
            asm_digest := cache_digest_file(&mut c, view(part));
            blob := cache_blob_put(&mut c, view(object));
            mut filed = copy(view(blob));
            if filed.len() != 64 {
                filed = cache_digest_file(&mut c, view(object));
            }
            // The object's position in link order is the position of its part.
            slot := miss_at[i];
            digests[slot] = filed;
            if blob.len() == 64 {
                mut record = u8[];
                push_bytes(&mut record, view("// grail-cache-module 1\nmodule "));
                push_bytes(&mut record, view(part_module(view(part))));
                push_bytes(&mut record, view("\nasm "));
                push_bytes(&mut record, view(asm_digest));
                push_bytes(&mut record, view("\nblob "));
                push_bytes(&mut record, view(blob));
                record.push(10);
                cache_record_put(&mut c, view("mod"), view(key), view(record));
            }
        }
    }
    // The image is determined by the object set, the link inputs and the linker.
    mut linkbuf = u8[];
    push_bytes(&mut linkbuf, view("grail-cache-link 1\ntarget "));
    push_bytes(&mut linkbuf, view(target));
    push_bytes(&mut linkbuf, view("\nlinker "));
    push_bytes(&mut linkbuf, view(id.linker));
    push_bytes(&mut linkbuf, view("\noutput "));
    push_bytes(&mut linkbuf, view(output));
    linkbuf.push(10);
    for i in digests.len() {
        push_bytes(&mut linkbuf, view(item(&digests, i)));
        linkbuf.push(10);
    }
    // A `// grail-link:` input that is a file on disk is part of what the image is: an archive or an
    // object that changed has to relink even though no source did.
    for i in parts.link.len() {
        input := item(&parts.link, i);
        push_bytes(&mut linkbuf, view(input));
        linkbuf.push(32);
        push_bytes(&mut linkbuf, view(cache_digest_file(&mut c, view(input))));
        linkbuf.push(10);
    }
    link_key := store_hash(view(linkbuf));
    image := cache_field(view(c.root), view("lnk"), view(link_key), view("blob"));
    mut linked: u64 = 0;
    mut final = copy(view(image));
    if cache_blob_ok(&mut c, view(image)) {
        if cache_blob_restore(&mut c, view(image), view(output), 1) != 0 {
            linked = 1;
        }
    } else {
        linked = 1;
    }
    if linked != 0 {
        if link_objects(view(output), view(target), view(emulation), &parts.objects, &parts.link)
            != 0 {
            return 1;
        }
        final = cache_blob_put(&mut c, view(output));
        if final.len() == 64 {
            mut record = u8[];
            push_bytes(&mut record, view("// grail-cache-link 1\nblob "));
            push_bytes(&mut record, view(final));
            record.push(10);
            cache_record_put(&mut c, view("lnk"), view(link_key), view(record));
        }
    }
    if final.len() == 64 {
        mut record = u8[];
        push_bytes(&mut record, view("// grail-cache-program 1\nblob "));
        push_bytes(&mut record, view(final));
        push_bytes(&mut record, view("\nparts "));
        cache_decimal(&mut record, parts.asm.len());
        push_bytes(&mut record, view("\noutput "));
        push_bytes(&mut record, view(output));
        record.push(10);
        for i in parts.link.len() {
            input := item(&parts.link, i);
            if host::exists(view(input)) != 0 {
                push_bytes(&mut record, view("link "));
                push_bytes(&mut record, view(cache_digest_file(&mut c, view(input))));
                record.push(32);
                push_bytes(&mut record, view(input));
                record.push(10);
            }
        }
        cache_record_put(&mut c, view("prog"), view(program), view(record));
    }
    cache_report(&mut c, linked);
    return 0;
}

struct Options {
    file: u8[],
    output: u8[],
    target: u8[],
    rest: u8[][],
    check: u64,
    debug: u64,
    // `--no-debug-info`: no line tables in a development build (they are on by default where the
    // target has them; `--debug` adds variables and turns the optimiser off).
    no_debug: u64,
    deny: u64,
    split: u64,
    // 0 when the flag is absent, 1 for `--overflow=wrap`, 2 for `--overflow=checked`.
    overflow: u64,
    // The build cache (B1 stage 4): reuse per-module objects and an unchanged program.
    cache: u64,
    // `--whole-program`: one compiler run for the whole program, instead of the default one per
    // module (B1 stage 4).
    whole: u64,
    // `--no-error-sites`: no runtime-error location table (byte-for-byte comparisons with --split).
    no_sites: u64,
    // `--verify-facts`: every refinement the prover discharged still emits its runtime check, so a
    // proof that is wrong aborts at the call instead of passing unnoticed. Without it the flag
    // never reached the compiler, and the check it exists to keep was the check nobody saw.
    verify_facts: u64,
    // `--report checks`: the build prints every check left in the program's own functions, with its
    // location and kind. One uncached run, so a cached module cannot hide its checks.
    report_checks: u64,
    // `--strict-refinements`: an obligation the prover cannot settle is refused, program-wide.
    strict: u64,
    // `--no-cache`: one compiler run over the whole program, nothing read from or filed in the
    // build store. `cache_quiet` is set when the store is used because it is the default rather
    // than because `--cache` asked: the build then prints no cache line.
    no_cache: u64,
    cache_quiet: u64,
    // `--emit-ir`: the compiler writes the typed IR of the optimized stream beside the assembly.
    emit_ir: u64,
    // `--release`: the LLVM backend and `clang -O2` for every unit, and overflow wraps unless
    // `--overflow=` says otherwise (docs/design/release-builds-and-parity.md).
    release: u64,
    // `--cpu=LEVEL` (docs/design/simd.md, S4b): 0 the baseline, 1 x86-64-v2, 2 v3, 3 v4.
    cpu: u64,
    // Module interfaces (B1 stage 2): `--interface DIR` reads them, `grail check` writes them, and
    // `--verify` compares the two instead of trusting either.
    iface: u8[],
    verify: u64,
    // Watch mode (`grail check --watch`, `grail build --watch`): re-run the cycle on change, with
    // the poll period (`--interval MS`) and the quiet period that collapses a burst of writes
    // (`--debounce MS`), and the cycle stream as one JSON object per line (`--json`).
    watch: u64,
    interval: u64,
    debounce: u64,
    json: u64,
    // `--diagnostics-json FILE`: the compiler appends one JSON object per diagnostic to FILE and
    // prints nothing, and the driver prints no summary, so a driver (an editor, the language
    // server) reads fields instead of text. Watch mode settles on its own file when this is empty.
    diag: u8[],
    paths: u8[][],
    // `--module-root DIR` (repeatable), and the two switches that were reachable only in the raw
    // compiler form: `grail build --emit-interface DIR` writes interfaces, and `grail build
    // --no-entry` suppresses entry selection for a library module.
    roots: u8[][],
    iface_emit: u64,
    no_entry: u64,
    // `--print-inputs FILE`: the compiler writes the module set it settled (`NAME<TAB>PATH`), which
    // is what a driver or a test uses as the oracle for "the roots the compile actually saw".
    inputs: u8[]
}
// The code-generation flag vector, in one place: it is what the compiler is told, and what the build
// cache keys on. Bit 0 check only, 1 debug, 2 deny ambient host, 3 split, 4/5 overflow, 6 cache,
// 7 whole program, 8 no runtime-error location table, 9 verify the facts a proof leaned on,
// 10 strict refinements, 11 write the typed IR beside the assembly, 12 the store is used by default
// (no cache line is printed), 13 release.
// The compiler's flag word. `check_only` is the `--check` bit, which is about the caller rather than
// the options, so it is an argument instead of an option field.
fn flag_bits<a>(o: (&a Options), check_only: bool = false) -> u64 {
    return u64(check_only) + o.debug
        * 2
        + o.deny
        * 4
        + o.split
        * 8
        + o.overflow
        * 16
        + o.cache
        * 64
        + o.whole
        * 128
        + o.no_sites
        * 256
        + o.verify_facts
        * 512
        + o.strict
        * 1024
        + o.emit_ir
        * 2048
        + o.cache_quiet
        * 4096
        + o.release
        * 8192
        + o.report_checks
        * u64(o.release == 0)
        * 16384
        + o.cpu
        * 32768
        + o.no_debug
        * 131072
        // A release build wraps by default; `--overflow=` on the command line still decides.
        + u64((o.release != 0) && (o.overflow == 0))
        * 16;
}
// The first `flags` line of /proc/cpuinfo with a space at each end, or empty.
fn cpu_flags_line() -> u8[] {
    info := host::read_file(view("/proc/cpuinfo"));
    mut at = 0;
    while at < info.len() {
        mut end = at;
        while (end < info.len()) && (info[end] != 10) {
            end += 1;
        }
        if starts(view(info[at..end]), view("flags")) {
            mut line = copy(view(" "));
            push_bytes(&mut line, view(info[at..end]));
            line.push(32);
            return line;
        }
        at = end + 1;
    }
    return u8[];
}
fn cpu_has<a, b>(line: &a [u8], name: &b [u8]) -> bool {
    mut word = copy(view(" "));
    push_bytes(&mut word, name);
    word.push(32);
    return contains(line, view(word));
}
// `--cpu=LEVEL`: the x86-64 psABI levels, or `native` for the levels the machine running the build
// has (from /proc/cpuinfo's flags; the baseline where it cannot tell). docs/design/simd.md, S4b.
fn cpu_level<a>(word: &a [u8]) -> u64 {
    if eq(word, view("x86-64")) {
        return 0;
    }
    if eq(word, view("x86-64-v2")) {
        return 1;
    }
    if eq(word, view("x86-64-v3")) {
        return 2;
    }
    if eq(word, view("x86-64-v4")) {
        return 3;
    }
    if eq(word, view("native")) {
        line := cpu_flags_line();
        if !(cpu_has(view(line), view("sse4_2")) && cpu_has(view(line), view("popcnt")) && cpu_has(view(line), view("ssse3")) && cpu_has(view(line), view("cx16"))) {
            return 0;
        }
        if !(cpu_has(view(line), view("avx2")) && cpu_has(view(line), view("fma")) && cpu_has(view(line), view("bmi1")) && cpu_has(view(line), view("bmi2")) && cpu_has(view(line), view("f16c")) && cpu_has(view(line), view("abm")) && cpu_has(view(line), view("movbe"))) {
            return 1;
        }
        if !(cpu_has(view(line), view("avx512f")) && cpu_has(view(line), view("avx512bw")) && cpu_has(view(line), view("avx512cd")) && cpu_has(view(line), view("avx512dq")) && cpu_has(view(line), view("avx512vl"))) {
            return 2;
        }
        return 3;
    }
    say(view("grail: `--cpu` takes x86-64, x86-64-v2, x86-64-v3, x86-64-v4 or native"));
    host::exit(2);
    return 0;
}
// ---- The driver's own flags, as a table ----------------------------------------------------------
// One row per word the driver reads: `word` is what the command line says, `kind` says what follows
// it and what the driver does with it, and `field` names the `Options` slot the value lands in. A new
// flag is a new row plus one arm of the setter its kind picks, never another level of
// `else { if .. } else { .. }` - that nesting is what made a half-applied flag edit leave the
// compiler unable to parse its own source (docs/design/language-gaps-audit.md, 4.1).
struct Flag {
    word: u8[],
    kind: u64,
    field: u64
}
// No argument: the word's presence is the value.
const FLAG_SWITCH: u64 = 0;
// One argument, stored: `o.field = the word that follows`.
const FLAG_TEXT: u64 = 1;
// One argument, appended: `o.field.push(the word that follows)` (`--module-root` repeats).
const FLAG_LIST: u64 = 2;
// One argument, a decimal count: `o.field = number_of(the word that follows)`.
const FLAG_NUMBER: u64 = 3;
// The word is accepted and stores nothing: `--per-module` names the shape a build already has.
const FLAG_IGNORED: u64 = 4;
// The slots `field` names. The numbers are a private index into the setters below; a table row never
// says what a number means, and two words that store different numbers in one field are two slots.
const F_CHECK: u64 = 1;
const F_DEBUG: u64 = 2;
const F_DENY: u64 = 3;
const F_SPLIT: u64 = 4;
const F_OVERFLOW_WRAP: u64 = 5;
const F_OVERFLOW_CHECKED: u64 = 6;
const F_CACHE: u64 = 7;
const F_WHOLE: u64 = 8;
const F_NO_SITES: u64 = 9;
const F_VERIFY: u64 = 10;
const F_WATCH: u64 = 11;
const F_JSON: u64 = 12;
const F_NO_ENTRY: u64 = 13;
const F_VERIFY_FACTS: u64 = 14;
const F_REPORT: u64 = 42;
const F_STRICT: u64 = 15;
const F_NO_CACHE: u64 = 17;
const F_EMIT_IR: u64 = 16;
const F_OUTPUT: u64 = 20;
const F_TARGET: u64 = 21;
const F_IFACE: u64 = 22;
const F_IFACE_EMIT: u64 = 23;
const F_DIAG: u64 = 24;
const F_INPUTS: u64 = 25;
const F_ROOTS: u64 = 30;
const F_INTERVAL: u64 = 40;
const F_DEBOUNCE: u64 = 41;
const F_RELEASE: u64 = 18;
const F_CPU: u64 = 43;
const F_NO_DEBUG: u64 = 44;
// The flag table: every word the driver reads. `--` and a positional path are not rows - the first
// ends the driver's words and the second is an input - so `options` handles both around the lookup.
fn flag_table() -> Flag[] {
    return Flag[
        Flag { word: copy(view("-o")), kind: FLAG_TEXT, field: F_OUTPUT },
        Flag { word: copy(view("--target")), kind: FLAG_TEXT, field: F_TARGET },
        Flag { word: copy(view("--module-root")), kind: FLAG_LIST, field: F_ROOTS },
        Flag { word: copy(view("--emit-interface")), kind: FLAG_TEXT, field: F_IFACE_EMIT },
        Flag { word: copy(view("--no-entry")), kind: FLAG_SWITCH, field: F_NO_ENTRY },
        Flag { word: copy(view("--print-inputs")), kind: FLAG_TEXT, field: F_INPUTS },
        Flag { word: copy(view("--check")), kind: FLAG_SWITCH, field: F_CHECK },
        Flag { word: copy(view("--debug")), kind: FLAG_SWITCH, field: F_DEBUG },
        Flag { word: copy(view("--no-debug-info")), kind: FLAG_SWITCH, field: F_NO_DEBUG },
        Flag { word: copy(view("--release")), kind: FLAG_SWITCH, field: F_RELEASE },
        Flag { word: copy(view("--cpu")), kind: FLAG_TEXT, field: F_CPU },
        Flag { word: copy(view("--deny-ambient-host")), kind: FLAG_SWITCH, field: F_DENY },
        Flag { word: copy(view("--split")), kind: FLAG_SWITCH, field: F_SPLIT },
        Flag { word: copy(view("--per-module")), kind: FLAG_IGNORED, field: 0 },
        Flag { word: copy(view("--whole-program")), kind: FLAG_SWITCH, field: F_WHOLE },
        Flag { word: copy(view("--cache")), kind: FLAG_SWITCH, field: F_CACHE },
        Flag { word: copy(view("--no-cache")), kind: FLAG_SWITCH, field: F_NO_CACHE },
        Flag { word: copy(view("--overflow=wrap")), kind: FLAG_SWITCH, field: F_OVERFLOW_WRAP },
        Flag {
            word: copy(view("--overflow=checked")),
            kind: FLAG_SWITCH,
            field: F_OVERFLOW_CHECKED,
        },
        Flag { word: copy(view("--no-error-sites")), kind: FLAG_SWITCH, field: F_NO_SITES },
        Flag { word: copy(view("--verify-facts")), kind: FLAG_SWITCH, field: F_VERIFY_FACTS },
        Flag { word: copy(view("--report")), kind: FLAG_TEXT, field: F_REPORT },
        Flag { word: copy(view("--strict-refinements")), kind: FLAG_SWITCH, field: F_STRICT },
        Flag { word: copy(view("--emit-ir")), kind: FLAG_SWITCH, field: F_EMIT_IR },
        Flag { word: copy(view("--interface")), kind: FLAG_TEXT, field: F_IFACE },
        Flag { word: copy(view("--verify")), kind: FLAG_SWITCH, field: F_VERIFY },
        Flag { word: copy(view("--watch")), kind: FLAG_SWITCH, field: F_WATCH },
        Flag { word: copy(view("--json")), kind: FLAG_SWITCH, field: F_JSON },
        Flag { word: copy(view("--diagnostics-json")), kind: FLAG_TEXT, field: F_DIAG },
        Flag { word: copy(view("--interval")), kind: FLAG_NUMBER, field: F_INTERVAL },
        Flag { word: copy(view("--debounce")), kind: FLAG_NUMBER, field: F_DEBOUNCE }
    ];
}
// The row for `word`, or `table.len()` when no row has it: a sentinel rather than an optional, so the
// caller's shape stays one comparison.
fn flag_index<a, b>(table: (&a Flag[]), word: &b [u8]) -> u64 {
    for i in table.len() {
        if eq(view(table[i].word), view(word)) {
            return i;
        }
    }
    return table.len();
}
// Refuse a `--word` no row has, and end the run: the word nearest to it in the table is offered when
// one is close, and a word that is a flag of the compiler proper but not of the driver says so. An
// argument for the program a `run` starts goes after `--`, which is never read here.
fn unknown_flag<a, b>(table: (&a Flag[]), word: &b [u8]) {
    mut text = copy(view("grail: unknown option `"));
    push_bytes(&mut text, word);
    push_bytes(&mut text, view("`"));
    say(view(text));
    if eq(word, view("--backend=llvm")) || eq(word, view("--range-facts")) || eq(word, view("--export")) || eq(word, view("--typed-refs")) {
        say(view("  it is an option of the compiler proper (`grail [options] OUT.s ENTRY.grl ...`)"));
        if eq(word, view("--backend=llvm")) {
            say(view("  `--release` builds every module through the LLVM backend and clang -O2"));
        }
    } else {
        mut best = table.len();
        mut best_cost = 4;
        for i in table.len() {
            cost := flag_distance(view(table[i].word), word);
            if cost < best_cost {
                best_cost = cost;
                best = i;
            }
        }
        if best != table.len() {
            mut help = copy(view("  did you mean `"));
            push_bytes(&mut help, view(table[best].word));
            push_bytes(&mut help, view("`?"));
            say(view(help));
        }
    }
    say(view("  arguments for the program itself go after `--`"));
    host::exit(1);
}
// How far apart two words are, as the count of positions that differ plus the difference in length:
// enough to catch a dropped, doubled or swapped letter without an edit-distance table.
fn flag_distance<a, b>(x: &a [u8], y: &b [u8]) -> u64 {
    mut short = x.len();
    mut long = y.len();
    if long < short {
        short = y.len();
        long = x.len();
    }
    // A dropped letter shifts everything after it, so compare from both ends and keep the better.
    mut front = 0;
    while (front < short) && (x[front] == y[front]) {
        front += 1;
    }
    mut back = 0;
    while (back < short - front) && (x[x.len() - 1 - back] == y[y.len() - 1 - back]) {
        back += 1;
    }
    return long - front - back;
}
// Whether a row takes the word after it.
fn flag_takes_value(kind: u64) -> bool {
    return (kind == FLAG_TEXT) || (kind == FLAG_LIST) || (kind == FLAG_NUMBER);
}
// `o.field = 1` for the words whose presence is the whole message; the two overflow spellings are two
// slots because they store two different numbers. A comparison per arm, not a `match` on the slot: an
// identifier is a binding in a pattern, so `match field { F_CHECK => .. }` would match every slot and
// the consts in the table above would mean nothing here.
fn switch_on<a>(o: (&a mut Options), field: u64) {
    if field == F_CHECK {
        o.check = 1;
    } else if field == F_DEBUG {
        o.debug = 1;
    } else if field == F_NO_DEBUG {
        o.no_debug = 1;
    } else if field == F_RELEASE {
        o.release = 1;
    } else if field == F_DENY {
        o.deny = 1;
    } else if field == F_SPLIT {
        o.split = 1;
    } else if field == F_OVERFLOW_WRAP {
        o.overflow = 1;
    } else if field == F_OVERFLOW_CHECKED {
        o.overflow = 2;
    } else if field == F_CACHE {
        o.cache = 1;
    } else if field == F_WHOLE {
        o.whole = 1;
    } else if field == F_NO_SITES {
        o.no_sites = 1;
    } else if field == F_VERIFY_FACTS {
        o.verify_facts = 1;
    } else if field == F_STRICT {
        o.strict = 1;
    } else if field == F_NO_CACHE {
        o.no_cache = 1;
    } else if field == F_EMIT_IR {
        o.emit_ir = 1;
    } else if field == F_VERIFY {
        o.verify = 1;
    } else if field == F_WATCH {
        o.watch = 1;
    } else if field == F_JSON {
        o.json = 1;
    } else if field == F_NO_ENTRY {
        o.no_entry = 1;
    }
}
// The word a flag takes, stored in the slot its row names. The kind decides which setter it is.
fn take_value<a, b>(o: (&a mut Options), kind: u64, field: u64, word: &b [u8]) {
    if kind == FLAG_TEXT {
        take_text(&mut o, field, word);
    } else if kind == FLAG_NUMBER {
        take_number(&mut o, field, word);
    } else {
        take_list(&mut o, field, word);
    }
}
fn take_text<a, b>(o: (&a mut Options), field: u64, word: &b [u8]) {
    if field == F_OUTPUT {
        o.output = copy(word);
    } else if field == F_TARGET {
        o.target = copy(word);
    } else if field == F_CPU {
        o.cpu = cpu_level(word);
    } else if field == F_REPORT {
        if !eq(word, view("checks")) {
            say(view("grail: `--report` takes `checks`: the runtime checks left in the program's own functions"));
            host::exit(2);
        }
        o.report_checks = 1;
    } else if field == F_IFACE {
        o.iface = copy(word);
    } else if field == F_IFACE_EMIT {
        // `--emit-interface DIR` is `--interface DIR` plus "write them": the slot holds the directory
        // and the second one says which of the two words it was.
        o.iface = copy(word);
        o.iface_emit = 1;
    } else if field == F_DIAG {
        o.diag = copy(word);
    } else if field == F_INPUTS {
        o.inputs = copy(word);
    }
}
fn take_number<a, b>(o: (&a mut Options), field: u64, word: &b [u8]) {
    if field == F_INTERVAL {
        o.interval = number_of(word);
    } else if field == F_DEBOUNCE {
        o.debounce = number_of(word);
    }
}
fn take_list<a, b>(o: (&a mut Options), field: u64, word: &b [u8]) {
    if field == F_ROOTS {
        o.roots.push(copy(word));
    }
}
fn options<a>(args: (&a u8[][])) -> Options {
    mut o = Options {
        file: u8[],
        output: u8[],
        target: target_name(host::target()),
        rest: u8[][],
        check: 0,
        debug: 0,
        no_debug: 0,
        deny: 0,
        split: 0,
        overflow: 0,
        cache: 0,
        whole: 0,
        no_sites: 0,
        iface: u8[],
        verify: 0,
        verify_facts: 0,
        report_checks: 0,
        strict: 0,
        emit_ir: 0,
        release: 0,
        cpu: 0,
        no_cache: 0,
        cache_quiet: 0,
        watch: 0,
        interval: 0,
        debounce: 0,
        json: 0,
        diag: u8[],
        paths: u8[][],
        roots: u8[][],
        iface_emit: 0,
        no_entry: 0,
        inputs: u8[],
    };
    table := flag_table();
    mut i = 0;
    mut passthrough = 0;
    while i < args.len() {
        a := item(&args, i);
        at := flag_index(&table, view(a));
        if passthrough != 0 {
            // Everything after `--` belongs to the program, a word that looks like a flag included.
            o.rest.push(a);
        } else if eq(view(a), view("--")) {
            // The terminator is neither an input nor a flag: it is what switches the branch above on.
            passthrough = 1;
        } else if starts(view(a), view("--cpu=")) {
            o.cpu = cpu_level(view(tail_from(view(a), 6)));
        } else if (at == table.len()) & starts(view(a), view("--")) {
            // A word that looks like a flag and is none of the driver's. It used to fall into the
            // input list, where a build ignored it: `grail build --strict-refinments main.grl`
            // compiled without the flag and said nothing.
            unknown_flag(&table, view(a));
        } else if at == table.len() {
            // Not a driver word: an input. The first `.grl` file is the entry, and the paths keep the
            // order they were given in.
            if ends(view(a), view(".grl")) & (o.file.len() == 0) {
                o.file = copy(view(a));
            }
            o.paths.push(a);
        } else if table[at].kind == FLAG_IGNORED {
            // `--per-module` names the shape a build already has: consumed, and nothing to store.
        } else if !flag_takes_value(table[at].kind) {
            switch_on(&mut o, table[at].field);
        } else if i + 1 < args.len() {
            i += 1;
            take_value(&mut o, table[at].kind, table[at].field, view(item(&args, i)));
        } else {
            // A flag whose argument is missing cannot be read as a flag; it stays in the input list,
            // which is where it went when the chain fell through.
            o.paths.push(a);
        }
        i += 1;
    }
    // The whole-program cache reuses the objects `--split` writes, so it is that shape's cache. An
    // interface build (`--interface`) checks every module against its interface in one run, which is
    // the whole program too.
    if (o.cache != 0) & ((o.whole != 0) || (o.iface.len() != 0)) {
        o.split = 1;
    }
    return o;
}
fn build<a, b>(args: (&a u8[][]), o: (&b mut Options)) -> u64 {
    mut h = home();
    for i in o.roots.len() {
        h.roots.push(item(&o.roots, i).copy());
    }
    // The named file's own directory is a root too, after any named ones: `grail build main.grl`
    // finds `shapes.grl` beside it for `use shapes;`, as most languages find a sibling file. It comes
    // before the stdlib, so a file there may shadow a std module by name (the order above).
    if o.file.len() != 0 {
        mut cut = 0;
        for i in o.file.len() {
            if (o.file[i] == 47) || (o.file[i] == 92) {
                cut = i + 1;
            }
        }
        mut dir = copy(view("."));
        if cut != 0 {
            dir = copy(o.file[0..cut - 1]);
            if dir.len() == 0 {
                dir = copy(view("/"));
            }
        }
        mut known = false;
        for i in h.roots.len() {
            if eq(view(item(&h.roots, i)), view(dir)) {
                known = true;
            }
        }
        if !known {
            h.roots.push(dir);
        }
    }
    if h.runtime.len() == 0 {
        return 1;
    }
    // A build goes through the store unless it was told not to or asks for something that is one
    // compiler run over the whole program by nature: a debug build, `--split`, `--whole-program`,
    // an interface build, the typed IR, the watcher, or one of the compiler's own seams. The store
    // changes what is redone, not what is built: a program built through it runs as fast as one
    // built whole (docs/design/compile-speed.md has the measurement).
    if (o.cache == 0)
        & (o.no_cache == 0)
        & !((o.report_checks != 0) && (o.release == 0))
        & linux_target(view(o.target))
        & (o.debug == 0)
        & (o.split == 0)
        & (o.whole == 0)
        & (o.iface.len() == 0)
        & (o.iface_emit == 0)
        & (o.emit_ir == 0)
        & (o.watch == 0)
        & (o.no_entry == 0)
        & (o.inputs.len() == 0)
        & (o.diag.len() == 0) {
        o.cache = 1;
        o.cache_quiet = 1;
    }
    // The cache keeps each module's compiler run and its object; the whole-program shape reuses the
    // objects `--split` writes, which is the Linux x86-64 assembler path. Name the limits here
    // instead of failing later with a --split error.
    if o.cache != 0 {
        if !linux_target(view(o.target)) {
            say(view("grail: --cache is implemented for the linux targets"));
            return 1;
        }
        if (o.whole != 0) & !eq(view(o.target), view("x86_64")) {
            say(
                view(
                    "grail: --cache --whole-program reuses the objects --split writes, which is the linux x86_64 assembler path"
                )
            );
            return 1;
        }
        if o.debug != 0 {
            say(view("grail: --cache is not implemented with --debug"));
            return 1;
        }
    }
    if o.watch != 0 {
        // Watch mode: the same build, once per cycle, in this process (`watch`).
        return watch(&h, o, 2);
    }
    host::mkdir(view("target"));
    // `--diagnostics-json FILE`: the driver starts the file, the compiler appends to it. Read out
    // of the options once, because the call below holds the options mutably.
    mut listener = copy(view(o.diag));
    if listener.len() != 0 {
        host::write_file(view(listener), view(""));
    }
    return build_pass(&h, o, view(listener));
}
// One build, in this process: the named file, or the project's entry, into `-o` or `target/`. `diag`
// is the file the compiler appends structured diagnostics to, and is empty for a plain `grail build`.
fn build_pass<a, b, c>(h: (&a Home), o: (&b mut Options), diag: &c [u8]) -> u64 {
    status := build_pass_inner(&h, &mut o, diag);
    if (status == 0) && (o.report_checks != 0) && (o.release != 0) {
        return release_checks_report(view(o.output));
    }
    return status;
}
// The kind a check's failure code names (rt_fail's codes, as the native report groups them).
fn check_kind_word(kind: u64) -> string {
    if (kind == 1) || (kind == 7) || (kind == 11) || (kind == 64) {
        return "index";
    }
    if kind == 2 {
        return "overflow";
    }
    if kind == 5 {
        return "divide";
    }
    if (kind == 3) || (kind == 9) || (kind == 14) || (kind == 15) {
        return "conversion";
    }
    if kind == 6 {
        return "unwrap";
    }
    if kind == 12 {
        return "assertion";
    }
    return "check";
}
// The immediate a `mov $K, REG` line puts in a register of `regs` (`%edx`, `%rdx`), or 0.
fn mov_imm<a, b>(line: &a [u8], reg32: &b [u8], reg64: &b [u8]) -> u64 {
    mut i = 0;
    while (i + 4 < line.len()) && !((line[i] == 109) && (line[i + 1] == 111) && (line[i + 2] == 118)) {
        i += 1;
    }
    if i + 4 >= line.len() {
        return 0;
    }
    mut d = i;
    while (d < line.len()) && (line[d] != 36) {
        d += 1;
    }
    if d >= line.len() {
        return 0;
    }
    d += 1;
    mut v: u64 = 0;
    mut hex = false;
    if (d + 1 < line.len()) && (line[d] == 48) && (line[d + 1] == 120) {
        hex = true;
        d += 2;
    }
    mut any = false;
    while d < line.len() {
        b := line[d];
        if (b >= 48) && (b <= 57) {
            if hex {
                v = v * 16 + u64(b) - 48;
            } else {
                v = v * 10 + u64(b) - 48;
            }
        } else if hex && (b >= 97) && (b <= 102) {
            v = v * 16 + u64(b) - 87;
        } else {
            break;
        }
        any = true;
        d += 1;
    }
    if !any {
        return 0;
    }
    rest := line[d..line.len()].copy();
    mut has = false;
    for j in rest.len() {
        if (j + reg32.len() <= rest.len()) && (eq(view(rest[j..j + reg32.len()]), reg32) || ((j + reg64.len() <= rest.len()) && eq(view(rest[j..j + reg64.len()]), reg64))) {
            has = true;
        }
    }
    if has {
        return v;
    }
    return 0;
}
// `grail build --release --report checks`: the checks that survived LLVM's optimisation and the
// thin-LTO link, read from the linked image itself - a branch to rt_fail, rt_trap, rt_abort (and
// its `.cold` parts) or rt_refine from a program function (`f_*`), counted per function and grouped
// by kind where the failure code is a constant moved just before the branch (x86-64). A release
// build has no line tables, so a function is the finest grain the report can name.
fn release_checks_report<a>(image: &a [u8]) -> u64 {
    listing := cat(image, view(".checks.txt"));
    mut argv = u8[][copy(view("sh")), copy(view("-c")), copy(view("exec \"$0\" -d --no-show-raw-insn \"$1\" > \"$2\"")), tool(view("GRAIL_OBJDUMP"), view("llvm-objdump")), copy(image), listing.copy()];
    if host::command(argv) != 0 {
        say(view("grail: --report checks on a release build reads the image with llvm-objdump, which failed (set GRAIL_OBJDUMP)"));
        return 1;
    }
    text := host::read_file(view(listing));
    host::remove(view(listing), 0);
    mut names = u8[][];
    mut counts = u64[];
    mut kinds = u8[][];
    mut func = u8[];
    mut recent = u8[][];
    mut total: u64 = 0;
    mut a = 0;
    while a < text.len() {
        mut e = a;
        while (e < text.len()) && (text[e] != 10) {
            e += 1;
        }
        line := text[a..e].copy();
        a = e + 1;
        // `0000000000401000 <f_main_main>:` starts a function.
        if (line.len() > 3) && (line[line.len() - 1] == 58) && (line[line.len() - 2] == 62) {
            mut lt = 0;
            while (lt < line.len()) && (line[lt] != 60) {
                lt += 1;
            }
            if lt < line.len() {
                func = line[lt + 1..line.len() - 2].copy();
                recent = u8[][];
            }
            continue;
        }
        if (func.len() < 2) || (func[0] != 102) || (func[1] != 95) {
            continue;
        }
        // A branch to a failure entry: `<rt_trap>`, `<rt_fail>`, `<rt_abort.cold.1>`, ...
        mut target = u8[];
        mut lt = 0;
        while (lt < line.len()) && (line[lt] != 60) {
            lt += 1;
        }
        if lt < line.len() {
            mut gt = lt;
            while (gt < line.len()) && (line[gt] != 62) {
                gt += 1;
            }
            target = line[lt + 1..gt].copy();
        }
        mut which = 0;
        if (target.len() >= 7) && eq(view(target[0..7]), view("rt_trap")) {
            which = 1;
        } else if (target.len() >= 7) && eq(view(target[0..7]), view("rt_fail")) {
            which = 2;
        } else if (target.len() >= 8) && eq(view(target[0..8]), view("rt_abort")) {
            which = 3;
        } else if (target.len() >= 9) && eq(view(target[0..9]), view("rt_refine")) {
            which = 4;
        }
        // `+0x..` inside the brackets is a jump within the runtime body, not a call of it.
        for j in target.len() {
            if target[j] == 43 {
                which = 0;
            }
        }
        if which == 0 {
            recent.push(line);
            if recent.len() > 8 {
                recent.remove(0);
            }
            continue;
        }
        mut kind = copy(view("check"));
        if which == 4 {
            kind = copy(view("refinement"));
        } else {
            mut r = recent.len();
            while r > 0 {
                r -= 1;
                mut k: u64 = 0;
                if which == 1 {
                    k = mov_imm(view(item(&recent, r)), view("%edx"), view("%rdx"));
                } else {
                    k = mov_imm(view(item(&recent, r)), view("%edi"), view("%rdi"));
                }
                if k != 0 {
                    kind = copy(view(check_kind_word(k)));
                    break;
                }
            }
        }
        recent = u8[][];
        total += 1;
        mut at = names.len();
        for n in names.len() {
            if eq(view(item(&names, n)), view(func)) {
                at = n;
            }
        }
        if at == names.len() {
            names.push(func.copy());
            counts.push(0);
            kinds.push(u8[]);
        }
        counts[at] = counts[at] + 1;
        mut ks = item(&kinds, at);
        if ks.len() != 0 {
            ks.push(32);
        }
        ks.append(view(kind));
        kinds[at] = ks;
    }
    mut out = cat(view("checks left in the program's own functions after optimisation (release): "), view(decimal(total)));
    out.push(10);
    for n in names.len() {
        // `index index overflow` reads as `index 2, overflow 1`.
        words := item(&kinds, n);
        mut seen = u8[][];
        mut tally = u64[];
        mut w = 0;
        while w < words.len() {
            mut x = w;
            while (x < words.len()) && (words[x] != 32) {
                x += 1;
            }
            word := words[w..x].copy();
            mut found = seen.len();
            for q in seen.len() {
                if eq(view(item(&seen, q)), view(word)) {
                    found = q;
                }
            }
            if found == seen.len() {
                seen.push(word);
                tally.push(0);
            }
            tally[found] = tally[found] + 1;
            w = x + 1;
        }
        out.append(view("  "));
        out.append(view(item(&names, n)));
        out.push(9);
        out.append(view(decimal(counts[n])));
        out.push(9);
        for q in seen.len() {
            if q != 0 {
                out.append(view(", "));
            }
            out.append(view(item(&seen, q)));
            out.push(32);
            out.append(view(decimal(tally[q])));
        }
        out.push(10);
    }
    host::print(view(out));
    return 0;
}
fn build_pass_inner<a, b, c>(h: (&a Home), o: (&b mut Options), diag: &c [u8]) -> u64 {
    if o.file.len() != 0 {
        if o.output.len() == 0 {
            stem := basename(view(o.file));
            o.output = path_join(view("target"), view(stem));
        }
        mut extra = u8[][];
        for i in o.paths.len() {
            p := item(&o.paths, i);
            if ends(view(p), view(".grl")) && !eq(view(p), view(o.file)) {
                extra.push(p);
            }
        }
        return compile(
            h: &h,
            entry: view(o.file),
            modules: &extra,
            output: view(o.output),
            target: view(o.target),
            flags: flag_bits(&o),
            iface: view(o.iface),
            verify: o.verify,
            diag: diag,
            force_emit: o.iface_emit != 0,
            no_entry: o.no_entry != 0,
            inputs: view(o.inputs)
        );
    }
    // A project build reads grail.lock: the package manager has already resolved, fetched and
    // verified the graph, and hands back the entry file plus every module file (B1's module list,
    // unchanged). No resolution and no network happen here.
    p := pkg::plan(0);
    if p.name.len() == 0 {
        return 1;
    }
    if o.output.len() == 0 {
        name := copy(view(p.name));
        o.output = path_join(view("target"), view(name));
    }
    project_overflow(&mut o, &p);
    return compile(
        h: &h,
        entry: view(p.entry),
        modules: &p.modules,
        output: view(o.output),
        target: view(o.target),
        flags: flag_bits(&o),
        iface: view(o.iface),
        verify: o.verify,
        diag: diag,
        force_emit: o.iface_emit != 0,
        no_entry: o.no_entry != 0,
        inputs: view(o.inputs)
    );
}
// One overflow mode per build, decided by the root (docs/design/release-builds-and-parity.md):
// `--overflow=` on the command line, else the root package's `overflow` key, else the build mode's
// default (checked, or wrap for `--release`). A dependency's own key is not used, and the build says
// so once, naming it.
fn project_overflow<a, b>(o: (&a mut Options), p: (&b pkg::Plan)) -> unit {
    if (o.overflow == 0) && eq(view(p.overflow), view("wrap")) {
        o.overflow = 1;
    }
    if (o.overflow == 0) && eq(view(p.overflow), view("checked")) {
        o.overflow = 2;
    }
    if p.ignored_overflow.len() != 0 {
        mut note = copy(view("grail: note: the `overflow` key of "));
        for i in p.ignored_overflow.len() {
            if i != 0 {
                push_bytes(&mut note, view(", "));
            }
            push_bytes(&mut note, view(item(&p.ignored_overflow, i)));
        }
        push_bytes(&mut note, view(" is not used: a build has one overflow mode, the root package's"));
        say(view(note));
    }
    return ();
}
fn check_command<a>(args: (&a u8[][])) -> u64 {
    mut o = options(&args);
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    // A check goes through the build store as a build does (docs/design/incremental-compilation.md,
    // "An incremental check"): one run per module, a module whose inputs did not move is not run
    // again, and inside a run the unchanged bodies are replayed - so a check after an edit costs the
    // edited module, not the program.
    if (o.cache == 0)
        & (o.no_cache == 0)
        & linux_target(view(o.target))
        & (o.debug == 0)
        & (o.split == 0)
        & (o.whole == 0)
        & (o.iface.len() == 0)
        & (o.iface_emit == 0)
        & (o.emit_ir == 0)
        & (o.watch == 0)
        & (o.no_entry == 0)
        & (o.inputs.len() == 0)
        & (o.diag.len() == 0) {
        o.cache = 1;
        o.cache_quiet = 1;
    }
    if o.watch != 0 {
        return watch(&h, &mut o, 1);
    }
    host::mkdir(view("target"));
    // `--diagnostics-json FILE`: the driver starts the file, the compiler appends to it, and nothing
    // is printed - the file is the whole report. Read out of the options once, because the call
    // below holds them.
    mut listener = copy(view(o.diag));
    if listener.len() != 0 {
        host::write_file(view(listener), view(""));
    }
    status := check_pass(&h, &o, view(listener));
    if (status == 0) & (listener.len() == 0) {
        say(view("ok"));
    }
    return status;
}
// One check, in this process: type-check the named file, or the project, without assembling or
// linking. `diag` is the file the compiler appends structured diagnostics to.
fn check_pass<a, b, c>(h: (&a Home), o: (&b Options), diag: &c [u8]) -> u64 {
    if o.file.len() != 0 {
        stem := basename(view(o.file));
        out := path_join(view("target"), view(stem));
        mut none = u8[][];
        return compile_mode(
            h: &h,
            entry: view(o.file),
            modules: &none,
            output: view(out),
            target: view(o.target),
            flags: flag_bits(&o, check_only: true),
            iface: view(o.iface),
            verify: o.verify,
            diag: diag,
            force_emit: o.iface_emit != 0,
            no_entry: o.no_entry != 0,
            inputs: view(o.inputs)
        );
    }
    p := pkg::plan(0);
    if p.name.len() == 0 {
        return 1;
    }
    name := copy(view(p.name));
    out := path_join(view("target"), view(name));
    return compile_mode(
        h: &h,
        entry: view(p.entry),
        modules: &p.modules,
        output: view(out),
        target: view(o.target),
        flags: flag_bits(&o, check_only: true),
        iface: view(o.iface),
        verify: o.verify,
        diag: diag,
        force_emit: o.iface_emit != 0,
        no_entry: o.no_entry != 0,
        inputs: view(o.inputs)
    );
}

// ---- watch mode: `grail check --watch`, `grail build --watch` -------------------------------------
// A warm process that re-runs the cycle when an input changes. The design is
// docs/design/incremental-compilation.md, "Watch mode"; the shape it settles on is:
//
//   * the input set is the files the cycle reads - the source named on the command line, or, for a
//     project, the entry and module list `grail.lock` resolves (through `pkg::plan`) plus the
//     standard modules the sources reach through `use`, and every interface in `--interface DIR`.
//     It is recomputed on every poll, so a file that appears or a new `use` is a change like any
//     other;
//   * change detection is a content hash (XXH64, two seeds), never a timestamp: a file rewritten
//     with the same bytes is not a change, and a source restored from a backup with an old mtime is;
//   * a burst of writes is collapsed by a quiet period: one cycle per burst, not per write;
//   * a cycle runs in this process, prints its diagnostics and then exactly one summary line
//     (`check ok 24 ms`, `error 3 diagnostics 31 ms`, `built target/app 210 ms`), and with `--json`
//     prints one JSON object and nothing else;
//   * a failed cycle does not end the process: the next change re-runs it;
//   * no lock is held between cycles, so a concurrent `grail build` in the same directory runs while
//     this process waits.
const WATCH_POLL_MS: u64 = 100;
const WATCH_QUIET_MS: u64 = 120;
// One diagnostic, as the compiler's structured channel writes it.
struct Diag {
    file: u8[],
    line: u64,
    col: u64,
    code: u8[],
    message: u8[],
    // The compiler's own rendering, verbatim: what a plain `grail check` would have printed.
    rendered: u8[]
}
// The project's files as the package manager resolves them: the entry and every module the lock
// names, the root's and its dependencies'. Planning reports the manifest's problems, so it runs once
// per cycle rather than on every poll.
fn planned_files() -> u8[][] {
    mut files = u8[][];
    p := pkg::plan(0);
    if p.name.len() == 0 {
        return files;
    }
    files.push(copy(view(p.entry)));
    for i in p.modules.len() {
        files.push(item(&p.modules, i));
    }
    return files;
}
// The 128-bit content stamp of one file: XXH64 twice, with different seeds. Two zero words for a
// file that is not there, which is a state like any other - a source appearing or disappearing is a
// change.
fn watch_stamp<a>(path: &a [u8]) -> u64[] {
    mut out = u64[];
    if host::exists(view(path)) == 0 {
        out.push(0);
        out.push(0);
        return out;
    }
    text := host::read_file(view(path));
    out.push(xxhash::hash64(view(text), 0));
    out.push(xxhash::hash64(view(text), 1099511628211));
    return out;
}
fn watch_stamps<a>(files: (&a u8[][])) -> u64[][] {
    mut out = u64[][];
    for i in files.len() {
        out.push(watch_stamp(view(item(files, i))));
    }
    return out;
}
fn watch_settled<a, b>(before: (&a u64[][]), after: (&b u64[][])) -> bool {
    if before.len() != after.len() {
        return false;
    }
    for i in before.len() {
        was := before[i];
        now := after[i];
        if (was[0] != now[0]) | (was[1] != now[1]) {
            return false;
        }
    }
    return true;
}
// The files the next cycle reads, in the order it reads them. The compiler owns which modules a
// program has (docs/design/module-resolution.md), so the watcher does not read `use` lines itself:
// it watches every standard module, which is a superset of the ones any one program reaches, and a
// change to any of them re-runs the cycle.
fn watch_inputs<a, b, c>(h: (&a Home), o: (&b Options), project: (&c u8[][])) -> u8[][] {
    mut files = u8[][];
    if o.file.len() != 0 {
        // The source a one-shot `grail check FILE` / `grail build FILE` compiles: the file named on
        // the command line, and no other (a second FILE argument is not a module of the first - the
        // driver compiles only the named entry, and watch mode watches what the cycle reads).
        files.push(copy(view(o.file)));
    } else {
        // The plan is the set. The manifest, the lock and a listing of `src/` are only how a change
        // to the plan itself - a new dependency, a new module - is noticed: the next cycle re-plans.
        files.push(copy(view("grail.toml")));
        files.push(copy(view("grail.lock")));
        mut listed = u8[][];
        collect(view("src"), &mut listed);
        for i in listed.len() {
            files.push(item(&listed, i));
        }
        for i in project.len() {
            found := item(project, i);
            files.push(copy(view(found)));
        }
    }
    // Every standard module, and the project's own modules from the plan: a file the roots resolve is
    // under one of them, so a change to it is a change to an input.
    if h.std.len() != 0 {
        mut reached = u8[][];
        collect(view(h.std), &mut reached);
        for i in reached.len() {
            files.push(item(&reached, i));
        }
    }
    if o.iface.len() != 0 {
        mut interfaces = u8[][];
        collect(view(o.iface), &mut interfaces);
        for i in interfaces.len() {
            files.push(item(&interfaces, i));
        }
    }
    return files;
}
// The image a build writes: `-o`, or target/<entry stem> for a named file, target/<project> for a
// project. Read, not written, so the summary line names what the cycle produced.
fn build_output<a>(o: (&a Options)) -> u8[] {
    if o.output.len() != 0 {
        return copy(view(o.output));
    }
    if o.file.len() != 0 {
        return path_join(view("target"), view(basename(view(o.file))));
    }
    p := pkg::plan(0);
    if p.name.len() == 0 {
        return u8[];
    }
    name := copy(view(p.name));
    return path_join(view("target"), view(name));
}
// One cycle: a fresh structured-diagnostics file, the check or build in this process, then the
// report. `mode` is 1 for check, 2 for build.
fn watch_cycle<a, b>(h: (&a Home), o: (&b mut Options), mode: u64, cycle: u64) -> u64 {
    host::mkdir(view("target"));
    // A listener the caller named is theirs: every cycle starts it, the file stays. Otherwise the
    // cycle gets its own - named after the moment, so two watch processes in one directory never
    // share it, and removed when the cycle ends.
    mut diag = copy(view(o.diag));
    mut own_listener = 0;
    if diag.len() == 0 {
        diag = path_join(view("target"), view(cat(view("watch-"), view(decimal(host::wall_ms())))));
        own_listener = 1;
    }
    host::write_file(view(diag), view(""));
    start := host::now_ms();
    mut status = 0;
    if mode == 1 {
        status = check_pass(h, &o, view(diag));
    } else {
        status = build_pass(h, o, view(diag));
    }
    elapsed := host::now_ms() - start;
    records := read_diagnostics(view(diag));
    if own_listener != 0 {
        host::remove(view(diag), 0);
    }
    produced := build_output(&o);
    if o.json != 0 {
        report_json(mode, cycle, status, elapsed, &records, view(produced));
    } else {
        report_text(mode, status, elapsed, &records, view(produced));
    }
    return status;
}
fn read_diagnostics<a>(path: &a [u8]) -> Diag[] {
    mut out = Diag[];
    if host::exists(view(path)) == 0 {
        return out;
    }
    text := host::read_file(view(path));
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        if 0 < row.len() {
            out.push(parse_diagnostic(view(row)));
        }
    }
    return out;
}
fn parse_diagnostic<a>(row: &a [u8]) -> Diag {
    return Diag {
        file: json_string(view(row), view("file")),
        line: json_uint(view(row), view("line")),
        col: json_uint(view(row), view("col")),
        code: json_string(view(row), view("code")),
        message: json_string(view(row), view("message")),
        rendered: json_string(view(row), view("rendered")),
    };
}
// The byte after `"key":` in one record, or the record's length when the key is not there. The
// records are this program's own (native.grl's `diag_record`), so the scan is the whole reader.
fn json_after<a, b>(row: &a [u8], key: &b [u8]) -> u64 {
    mut i = 0;
    while i < row.len() {
        if row[i] == 34 {
            mut j = 0;
            mut hit = true;
            while j < key.len() {
                at := i + 1 + j;
                if at < row.len() {
                    if row[at] != key[j] {
                        hit = false;
                    }
                } else {
                    hit = false;
                }
                j += 1;
            }
            q := i + 1 + key.len();
            if hit {
                if (q + 1 < row.len()) & (row[q] == 34) & (row[q + 1] == 58) {
                    return q + 2;
                }
            }
        }
        i += 1;
    }
    return row.len();
}
fn json_string<a, b>(row: &a [u8], key: &b [u8]) -> u8[] {
    mut out = u8[];
    at := json_after(view(row), view(key));
    if (at + 1 < row.len()) & (row[at] == 34) {
        mut i = at + 1;
        mut done = false;
        while (i < row.len()) & !done {
            ch := row[i];
            if ch == 34 {
                done = true;
            } else {
                if ch == 92 {
                    if i + 1 < row.len() {
                        esc := row[i + 1];
                        i += 1;
                        if esc == 110 {
                            out.push(10);
                        } else {
                            if esc == 116 {
                                out.push(9);
                            } else {
                                if esc == 114 {
                                    out.push(13);
                                } else {
                                    if esc == 117 {
                                        out.push(json_hex(view(row), i + 1));
                                        i += 4;
                                    } else {
                                        out.push(esc);
                                    }
                                }
                            }
                        }
                    }
                } else {
                    out.push(ch);
                }
            }
            i += 1;
        }
    }
    return out;
}
// The single byte of a `\u00XX` escape: control characters are the only thing written that way.
fn json_hex<a>(row: &a [u8], at: u64) -> u8 {
    mut out = u64(0);
    mut i = 0;
    while (i < 4) & (at + i < row.len()) {
        ch := u64(row[at + i]);
        mut digit = ch - 48;
        if 9 < digit {
            digit = ch - 87;
        }
        out = out * 16 + digit;
        i += 1;
    }
    return u8(out);
}
fn json_uint<a, b>(row: &a [u8], key: &b [u8]) -> u64 {
    at := json_after(view(row), view(key));
    mut out: u64 = 0;
    mut i = at;
    while (i < row.len()) & (row[i] != 44) & (row[i] != 125) {
        ch := u64(row[i]);
        if (ch < 48) || (57 < ch) {
            return out;
        }
        out = out * 10 + (ch - 48);
        i += 1;
    }
    return out;
}
// The cycle's report on a terminal: the diagnostics in the compiler's own rendering, then one
// summary line.
fn report_text<a, b>(mode: u64, status: u64, elapsed: u64, diags: (&a Diag[]), out: (&b [u8])) -> unit {
    for i in diags.len() {
        d := diags[i];
        host::print(view(d.rendered));
    }
    if status == 0 {
        if mode == 1 {
            host::print(view("check ok "));
        } else {
            host::print(view("built "));
            host::print(view(out));
            host::print(view(" "));
        }
    } else {
        host::print(view("error "));
        if 0 < diags.len() {
            host::print_num(diags.len());
            if diags.len() == 1 {
                host::print(view(" diagnostic "));
            } else {
                host::print(view(" diagnostics "));
            }
        }
    }
    host::print_num(elapsed);
    say(view(" ms"));
    return ();
}
// The cycle's report as one JSON object on one line: `cycle`, `status`, `ms`, `output` for a build,
// and `diagnostics` with the fields an editor needs. Nothing else is printed for a cycle, so a
// reader can take every line as an object.
fn report_json<a, b>(mode: u64, cycle: u64, status: u64, elapsed: u64, diags: (&a Diag[]), out: (&b [u8])) -> unit {
    mut line = u8[];
    push_bytes(&mut line, view("{\"cycle\":"));
    push_bytes(&mut line, view(decimal(cycle)));
    if status == 0 {
        push_bytes(&mut line, view(",\"status\":\"ok\""));
    } else {
        push_bytes(&mut line, view(",\"status\":\"error\""));
    }
    push_bytes(&mut line, view(",\"ms\":"));
    push_bytes(&mut line, view(decimal(elapsed)));
    if mode == 2 {
        push_bytes(&mut line, view(",\"output\":\""));
        json_text(&mut line, view(out));
        push_bytes(&mut line, view("\""));
    }
    push_bytes(&mut line, view(",\"diagnostics\":["));
    for i in diags.len() {
        d := diags[i];
        if i != 0 {
            line.push(44);
        }
        push_bytes(&mut line, view("{\"file\":\""));
        json_text(&mut line, view(d.file));
        push_bytes(&mut line, view("\",\"line\":"));
        push_bytes(&mut line, view(decimal(d.line)));
        push_bytes(&mut line, view(",\"col\":"));
        push_bytes(&mut line, view(decimal(d.col)));
        push_bytes(&mut line, view(",\"code\":\""));
        json_text(&mut line, view(d.code));
        push_bytes(&mut line, view("\",\"message\":\""));
        json_text(&mut line, view(d.message));
        push_bytes(&mut line, view("\"}"));
    }
    push_bytes(&mut line, view("]}"));
    say(view(line));
    return ();
}
// The loop: one cycle now, then one per settled change. The process ends when a signal ends it, so
// the return below is the shape of the function, not a path it takes.
fn watch<a, b>(h: (&a Home), o: (&b mut Options), mode: u64) -> u64 {
    if o.cache != 0 {
        // A cache hit is a cycle that does not run the compiler, and a watch cycle always does: the
        // point of watching is that every change is checked, and its report is one line.
        say(view("grail: --watch re-runs the compiler every cycle, so --cache is not used with it"));
        return 1;
    }
    mut poll = WATCH_POLL_MS;
    if o.interval != 0 {
        poll = o.interval;
    }
    mut quiet = WATCH_QUIET_MS;
    if o.debounce != 0 {
        quiet = o.debounce;
    }
    // The project's plan, refreshed after every cycle: it is what `grail build` and `grail check`
    // resolve from the lock, so the watcher polls the same files the cycle compiles. In file mode
    // there is no plan to resolve (and asking for one would report that there is no manifest).
    mut project = u8[][];
    if o.file.len() == 0 {
        project = planned_files();
    }
    // The first cycle runs before the first poll: a watch that said nothing until a file changed
    // would look broken on the program that is already correct.
    mut status = watch_cycle(h, o, mode, 1);
    mut cycle = 1;
    if o.file.len() == 0 {
        project = planned_files();
    }
    mut current = watch_stamps(&watch_inputs(h, &o, &project));
    // 0 while the files are settled, else the moment the last change was seen.
    mut changed_at = 0;
    while true {
        host::sleep_ms(poll);
        next := watch_stamps(&watch_inputs(h, &o, &project));
        now := host::now_ms();
        if watch_settled(&current, &next) {
            if changed_at != 0 {
                if quiet <= now - changed_at {
                    status = watch_cycle(h, o, mode, cycle + 1);
                    cycle += 1;
                    changed_at = 0;
                    if o.file.len() == 0 {
                        project = planned_files();
                    }
                }
            }
        } else {
            changed_at = now;
        }
        current = next;
    }
    return status;
}
fn run_command<a>(args: (&a u8[][])) -> u64 {
    mut o = options(&args);
    if o.watch != 0 {
        say(view("grail run: watch mode is `grail build --watch` and `grail check --watch`"));
        return 1;
    }
    host_target := target_name(host::target());
    if !eq(view(o.target), view(host_target)) {
        say(
            view(
                "grail run: cross-target executables must be run with an emulator; use grail build --target"
            )
        );
        return 1;
    }
    if build(&args, &mut o) != 0 {
        return 1;
    }
    mut command = u8[][];
    out := copy(view(o.output));
    if starts(view(out), view("/")) {
        command.push(out);
    } else {
        command.push(path_join(view("."), view(out)));
    }
    for i in o.rest.len() {
        command.push(item(&o.rest, i));
    }
    return host::command(command);
}
// ---- `grail test` -------------------------------------------------------------------------------
// Two corpora, one command. Inside this repository `tests/native-cases.json` is the regression
// corpus and `tools/test-native.mjs` is its engine, so `grail test` forwards every argument there:
// the semantics are the engine's, not a copy of them (docs/testing.md says which command owns what).
// A project - a grail.pkg and tests/*.grl programs - runs those programs instead, with the same
// selection flags, the same summary line and the same failure report shape.
struct TestOptions {
    paths: u8[][],
    filter: u8[],
    list: u64,
    // `--one FILE`: the mode `--jobs` uses to run exactly one test in a child process.
    one: u8[],
    fail_fast: u64,
    update: u64,
    jobs: u64,
    // 0 when --shard is absent; otherwise the 1-based index of this shard of `count`.
    shard_index: u64,
    shard_count: u64,
    target: u8[],
    debug: u64,
    no_debug: u64,
    deny: u64,
    overflow: u64,
    no_sites: u64,
    // `--release`: the tests are built the way `grail build --release` builds.
    release: u64,
    // Set when an argument cannot be understood: `grail test` then prints its usage.
    bad: u64
}
fn tail_from<a>(text: &a [u8], n: u64) -> u8[] {
    mut out = u8[];
    mut i = n;
    while i < text.len() {
        out.push(text[i]);
        i += 1;
    }
    return out;
}
fn contains<a, b>(text: &a [u8], part: &b [u8]) -> bool {
    if part.len() == 0 {
        return true;
    }
    if text.len() < part.len() {
        return false;
    }
    for i in text.len() - part.len() + 1 {
        mut same = true;
        for j in part.len() {
            if text[i + j] != part[j] {
                same = false;
                break;
            }
        }
        if same {
            return true;
        }
    }
    return false;
}
fn test_usage() -> unit {
    say(view("usage: grail test [FILES or DIRS] [--filter TEXT] [--list] [--shard i/n] [--jobs N] [--fail-fast]"));
    say(view("       in the Grail repository this forwards to tools/test-native.mjs (--update, --target, --shard, --jobs)"));
}
fn set_test_shard<a>(o: (&a mut TestOptions), text: &a [u8]) -> unit {
    mut slash: u64 = 0;
    for i in text.len() {
        if text[i] == 47 {
            slash = i + 1;
        }
    }
    if slash == 0 {
        o.bad = 1;
        return ();
    }
    mut left = u8[];
    for i in slash - 1 {
        left.push(text[i]);
    }
    o.shard_index = number_of(view(left));
    o.shard_count = number_of(view(tail_from(view(text), slash)));
    if (o.shard_count == 0) || (o.shard_index == 0) || (o.shard_count < o.shard_index) {
        o.bad = 1;
    }
    return ();
}
fn test_options<a>(args: (&a u8[][])) -> TestOptions {
    mut o = TestOptions {
        paths: u8[][],
        filter: u8[],
        list: 0,
        one: u8[],
        fail_fast: 0,
        update: 0,
        jobs: 1,
        shard_index: 0,
        shard_count: 0,
        target: target_name(host::target()),
        debug: 0,
        no_debug: 0,
        deny: 0,
        overflow: 0,
        no_sites: 0,
        release: 0,
        bad: 0
    };
    mut i: u64 = 0;
    while i < args.len() {
        a := item(&args, i);
        if eq(view(a), view("--filter")) & (i + 1 < args.len()) {
            i += 1;
            o.filter = item(&args, i);
        } else if starts(view(a), view("--filter=")) {
            o.filter = tail_from(view(a), 9);
        } else if eq(view(a), view("--list")) {
            o.list = 1;
        } else if eq(view(a), view("--one")) & (i + 1 < args.len()) {
            i += 1;
            o.one = item(&args, i);
        } else if eq(view(a), view("--fail-fast")) {
            o.fail_fast = 1;
        } else if eq(view(a), view("--update")) {
            o.update = 1;
        } else if eq(view(a), view("--jobs")) & (i + 1 < args.len()) {
            i += 1;
            o.jobs = number_of(view(item(&args, i)));
            if o.jobs == 0 {
                o.bad = 1;
            }
        } else if starts(view(a), view("--jobs=")) {
            o.jobs = number_of(view(tail_from(view(a), 7)));
            if o.jobs == 0 {
                o.bad = 1;
            }
        } else if eq(view(a), view("--shard")) & (i + 1 < args.len()) {
            i += 1;
            set_test_shard(&mut o, view(item(&args, i)));
        } else if starts(view(a), view("--shard=")) {
            set_test_shard(&mut o, view(tail_from(view(a), 8)));
        } else if eq(view(a), view("--target")) & (i + 1 < args.len()) {
            i += 1;
            o.target = item(&args, i);
        } else if eq(view(a), view("--debug")) {
            o.debug = 1;
        } else if eq(view(a), view("--no-debug-info")) {
            o.no_debug = 1;
        } else if eq(view(a), view("--release")) {
            o.release = 1;
        } else if eq(view(a), view("--deny-ambient-host")) {
            o.deny = 1;
        } else if eq(view(a), view("--no-error-sites")) {
            o.no_sites = 1;
        } else if eq(view(a), view("--overflow=wrap")) {
            o.overflow = 1;
        } else if eq(view(a), view("--overflow=checked")) {
            o.overflow = 2;
        } else if starts(view(a), view("--")) {
            o.bad = 1;
        } else {
            o.paths.push(a);
        }
        i += 1;
    }
    return o;
}
// The code-generation bits a test binary is built with: the same flags `grail build` takes, so a
// test can pin debug-info, overflow or authority behaviour.
fn test_bits<a>(o: (&a TestOptions)) -> u64 {
    return o.debug * 2 + o.deny * 4 + o.overflow * 16 + o.no_sites * 256 + o.release * 8192 + o.no_debug * 131072
        + u64((o.release != 0) && (o.overflow == 0)) * 16;
}
// The flags a `--jobs` child needs to build the same binary its parent would have built.
fn test_build_flags<a>(o: (&a TestOptions)) -> u8[][] {
    mut flags = u8[][];
    flags.push(copy(view("--target")));
    flags.push(copy(view(o.target)));
    if o.debug != 0 {
        flags.push(copy(view("--debug")));
    }
    if o.no_debug != 0 {
        flags.push(copy(view("--no-debug-info")));
    }
    if o.release != 0 {
        flags.push(copy(view("--release")));
    }
    if o.deny != 0 {
        flags.push(copy(view("--deny-ambient-host")));
    }
    if o.no_sites != 0 {
        flags.push(copy(view("--no-error-sites")));
    }
    if o.overflow == 1 {
        flags.push(copy(view("--overflow=wrap")));
    }
    if o.overflow == 2 {
        flags.push(copy(view("--overflow=checked")));
    }
    return flags;
}
// One binary name per test program, derived from its own path: `tests/a/x.grl` is
// `target/tests/tests-a-x.grl`, so two tests with the same file name never share an output and a
// `--jobs` child's build cannot collide with another's.
fn test_binary<a>(file: &a [u8]) -> u8[] {
    mut out = copy(view("target/tests/"));
    for i in file.len() {
        ch := file[i];
        if is_sep(ch) {
            out.push(45);
        } else {
            out.push(ch);
        }
    }
    return out;
}
fn test_log<a>(file: &a [u8]) -> u8[] {
    mut out = test_binary(view(file));
    push_bytes(&mut out, view(".log"));
    return out;
}
fn test_rc<a>(file: &a [u8]) -> u8[] {
    mut out = test_binary(view(file));
    push_bytes(&mut out, view(".rc"));
    return out;
}
fn has_shell() -> bool {
    mut probe = u8[][copy(view("sh")), copy(view("-c")), copy(view("exit 0"))];
    return host::command(probe) == 0;
}
// The test program's output is captured, not interleaved: a passing test says one line, and a
// failing one says what the program printed, which is where a test's diagnostics are.
fn run_captured<a, b>(exe: &a [u8], log_path: &b [u8]) -> u64 {
    mut script = u8[];
    sh_word(&mut script, view(exe));
    push_bytes(&mut script, view(" > "));
    sh_word(&mut script, view(log_path));
    push_bytes(&mut script, view(" 2>&1"));
    mut command = u8[][copy(view("sh")), copy(view("-c")), script];
    return host::command(command);
}
// `FAIL FILE`, then the source, what was expected, what happened and what the program printed.
fn test_failure<a, b>(file: &a [u8], status: u64, log_path: &b [u8], note: &b [u8]) -> unit {
    say2(view("FAIL "), view(file));
    say2(view("  source: "), view(file));
    mut wanted = copy(view("  exit:   status "));
    push_bytes(&mut wanted, view(decimal(status)));
    if 128 < status {
        push_bytes(&mut wanted, view(" (a signal: 128 + the signal)"));
    }
    push_bytes(&mut wanted, view(", expected 0"));
    say(view(wanted));
    if note.len() != 0 {
        say2(view("  note:   "), view(note));
    }
    if (log_path.len() != 0) & (host::exists(view(log_path)) != 0) {
        body := host::read_file(view(log_path));
        if body.len() != 0 {
            say(view("  output:"));
            rows := lines(view(body));
            for i in rows.len() {
                row := item(&rows, i);
                if row.len() != 0 {
                    say2(view("    "), view(row));
                }
            }
        }
    }
    return ();
}
// Build and run one test program in this process. With `log` non-empty its output is captured.
fn test_run_here<a, b, d>(h: (&a Home), o: (&a TestOptions), file: &a [u8], log: &b [u8]) -> u64 {
    // In a project, a test sees the root's modules and every dependency's - its dev-dependencies
    // too, which no other build sees (docs/packages.md): the plan grail.lock already resolved.
    mut modules = u8[][];
    if host::exists(view("grail.toml")) != 0 {
        p := pkg::plan(1);
        if p.name.len() == 0 {
            return 1;
        }
        for i in p.modules.len() {
            modules.push(item(&p.modules, i));
        }
    }
    out := test_binary(view(file));
    status := compile(h: h, entry: view(file), modules: &modules, output: view(out), target: view(o.target), flags: test_bits(&o));
    if status != 0 {
        return status;
    }
    exe := path_join(view("."), view(out));
    if log.len() != 0 {
        return run_captured(view(exe), view(log));
    }
    mut one = u8[][exe];
    return host::command(one);
}
// `--test`'s one-program mode: the same build and run, and its exit status is the program's, so a
// `--jobs` child can hand it back through `$?`.
fn test_one_mode<a>(o: (&a TestOptions)) -> u64 {
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    host::mkdir(view("target"));
    host::mkdir(view("target/tests"));
    return test_run_here(&h, &o, view(o.one), view(""));
}
fn test_summary(passed: u64, failed: u64, skipped: u64) -> unit {
    mut line = copy(view("passed "));
    push_bytes(&mut line, view(decimal(passed)));
    push_bytes(&mut line, view(" failed "));
    push_bytes(&mut line, view(decimal(failed)));
    push_bytes(&mut line, view(" skipped "));
    push_bytes(&mut line, view(decimal(skipped)));
    say(view(line));
    return ();
}
fn test_command<a>(args: (&a u8[][])) -> u64 {
    // The repository's regression corpus: one engine, driven by tools/test-native.mjs. Inside the
    // tree that is what `grail test` means; the tree's tests/ directory is not a project's tests.
    if host::exists(view("tests/native-cases.json")) != 0 && host::exists(view("tools/test-native.mjs")) != 0 {
        say(view("grail test: the repository regression corpus (tools/test-native.mjs)"));
        mut command = u8[][copy(view("bun")), copy(view("tools/test-native.mjs"))];
        for i in args.len() {
            command.push(item(&args, i));
        }
        return host::command(command);
    }
    o := test_options(&args);
    if o.bad != 0 {
        test_usage();
        return 1;
    }
    if o.one.len() != 0 {
        return test_one_mode(&o);
    }
    if o.update != 0 {
        say(view("grail test: --update rewrites expectations in the regression corpus (tests/native-cases.json)"));
        say(view("            a project test asserts inside its own program, so there is nothing to update here"));
        return 1;
    }
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    mut files = u8[][];
    if o.paths.len() != 0 {
        for i in o.paths.len() {
            x := item(&o.paths, i);
            if ends(view(x), view(".grl")) {
                files.push(x);
            } else {
                collect(view(x), &mut files);
            }
        }
    } else {
        collect(view("tests"), &mut files);
    }
    // Selection: a substring of the program's path, then one shard of the survivors, both by
    // position, which is what the corpus engine's --filter and --shard mean as well.
    mut selected = u8[][];
    for i in files.len() {
        f := item(&files, i);
        if !contains(view(f), view(o.filter)) {
            continue;
        }
        if o.shard_count != 0 {
            if i % o.shard_count != o.shard_index - 1 {
                continue;
            }
        }
        selected.push(f);
    }
    if o.list != 0 {
        for i in selected.len() {
            say(view(item(&selected, i)));
        }
        mut line = copy(view(""));
        push_bytes(&mut line, view(decimal(selected.len())));
        push_bytes(&mut line, view(" tests selected"));
        say(view(line));
        return 0;
    }
    if selected.len() == 0 {
        say(view("grail test: no tests found (put programs in tests/)"));
        test_summary(0, 0, 0);
        return 0;
    }
    host::mkdir(view("target"));
    host::mkdir(view("target/tests"));
    if !has_shell() {
        // No POSIX shell (Windows): run in process, one at a time, with the programs' own output
        // going to the terminal instead of a per-test log.
        mut passed: u64 = 0;
        mut failed: u64 = 0;
        for i in selected.len() {
            f := item(&selected, i);
            status := test_run_here(&h, &o, view(f), view(""));
            host::print(view("test "));
            host::print(view(f));
            if status == 0 {
                say(view(" ... ok"));
                passed += 1;
            } else {
                say(view(" ... FAILED"));
                test_failure(view(f), status, view(""), view("no shell: the program's output went to the terminal"));
                failed += 1;
                if o.fail_fast != 0 {
                    test_summary(passed, failed, selected.len() - i - 1);
                    return 1;
                }
            }
        }
        test_summary(passed, failed, 0);
        return failed != 0;
    }
    // One `sh` script, `--jobs N` tests in flight, each a child process running exactly one test
    // (`--one`) with its output in a per-test log and its exit status in a per-test `.rc` file. The
    // parent reports in case order, so the report does not depend on which test finished first.
    mut stop = copy(view("target/tests/.stop"));
    host::remove(view(stop), 0);
    // A status or log left by an earlier run would let a test this run never started report as ok;
    // the child writes both, so their absence is the only evidence that it ran.
    for i in selected.len() {
        host::remove(view(test_rc(view(item(&selected, i)))), 0);
        host::remove(view(test_log(view(item(&selected, i)))), 0);
    }
    mut jobs = o.jobs;
    if (jobs == 0) || (selected.len() < jobs) {
        jobs = selected.len();
    }
    exe := host::exe_path();
    mut script = u8[];
    mut w: u64 = 0;
    while w < jobs {
        push_bytes(&mut script, view("(\n"));
        mut i = w;
        while i < selected.len() {
            f := item(&selected, i);
            log_path := test_log(view(f));
            rc_path := test_rc(view(f));
            if o.fail_fast != 0 {
                push_bytes(&mut script, view("if [ ! -e "));
                sh_word(&mut script, view(stop));
                push_bytes(&mut script, view(" ]; then\n"));
            }
            sh_word(&mut script, view(exe));
            push_bytes(&mut script, view(" test --one "));
            sh_word(&mut script, view(f));
            flags := test_build_flags(&o);
            for j in flags.len() {
                script.push(32);
                sh_word(&mut script, view(item(&flags, j)));
            }
            push_bytes(&mut script, view(" > "));
            sh_word(&mut script, view(log_path));
            push_bytes(&mut script, view(" 2>&1\nprintf '%s' \"$?\" > "));
            sh_word(&mut script, view(rc_path));
            push_bytes(&mut script, view("\n"));
            if o.fail_fast != 0 {
                push_bytes(&mut script, view("if [ 0 != \"$(cat "));
                sh_word(&mut script, view(rc_path));
                push_bytes(&mut script, view(")\" ]; then printf 1 > "));
                sh_word(&mut script, view(stop));
                push_bytes(&mut script, view("; fi\nfi\n"));
            }
            i += jobs;
        }
        push_bytes(&mut script, view(") &\n"));
        w += 1;
    }
    push_bytes(&mut script, view("wait\n"));
    mut shell = u8[][copy(view("sh")), copy(view("-c")), script];
    host::command(shell);
    mut passed: u64 = 0;
    mut failed: u64 = 0;
    mut skipped: u64 = 0;
    mut i: u64 = 0;
    while i < selected.len() {
        f := item(&selected, i);
        host::print(view("test "));
        host::print(view(f));
        // No status file: --fail-fast stopped the run before this test started. (`host::read_file`
        // aborts on a missing file, so the check is the file's existence, not its length.)
        if host::exists(view(test_rc(view(f)))) == 0 {
            say(view(" ... skipped"));
            skipped += 1;
            i += 1;
            continue;
        }
        status := number_of(view(host::read_file(view(test_rc(view(f))))));
        if status == 0 {
            say(view(" ... ok"));
            passed += 1;
        } else {
            say(view(" ... FAILED"));
            failed += 1;
            test_failure(view(f), status, view(test_log(view(f))), view(""));
        }
        i += 1;
    }
    test_summary(passed, failed, skipped);
    return failed != 0;
}
fn fmt_command<a>(args: (&a u8[][])) -> u64 {
    o := options(&args);
    mut files = u8[][];
    if o.paths.len() == 0 {
        collect(view("."), &mut files);
    }
    for i in o.paths.len() {
        x := item(&o.paths, i);
        if ends(view(x), view(".grl")) {
            files.push(x);
        } else {
            collect(view(x), &mut files);
        }
    }
    mut changed = 0;
    for i in files.len() {
        f := item(&files, i);
        data := host::read_file(view(f));
        out := fmt::format(view(data));
        if !eq(view(data), view(out)) {
            changed += 1;
            if o.check != 0 {
                say2(view("would reformat "), view(f));
            } else {
                host::write_file(view(f), view(out));
                say2(view("formatted "), view(f));
            }
        }
    }
    if o.check != 0 {
        return changed != 0;
    }
    return 0;
}
fn new_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() == 0 {
        say(view("usage: grail new NAME"));
        return 1;
    }
    name := item(&args, 0);
    if host::exists(view(name)) != 0 {
        say2(view("grail new: already exists: "), view(name));
        return 1;
    }
    host::mkdir(view(name));
    src := path_join(view(name), view("src"));
    host::mkdir(view(src));
    tests := path_join(view(name), view("tests"));
    host::mkdir(view(tests));
    manifest := cat(
        view("[package]\nname = \""),
        view(cat(view(copy(view(name))), view("\"\nversion = \"0.1.0\"\n")))
    );
    pkg := path_join(view(name), view("grail.toml"));
    host::write_file(view(pkg), view(manifest));
    main := path_join(view(src), view("main.grl"));
    host::write_file(view(main), view("fn main() {\n    println(\"Hello, world!\");\n}\n"));
    test := path_join(view(tests), view("smoke.grl"));
    host::write_file(view(test), view("fn main() {\n    assert(1 + 1 == 2);\n}\n"));
    ignore := path_join(view(name), view(".gitignore"));
    host::write_file(view(ignore), view("target/\n"));
    say2(view("created project "), view(name));
    return 0;
}
fn debug_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() < 2 {
        say(view("usage: grail debug lines|info BINARY"));
        return 1;
    }
    sub := item(&args, 0);
    mut dump_flag = u8[];
    mut readelf_flag = u8[];
    if eq(view(sub), view("lines")) {
        dump_flag = copy(view("--debug-line"));
        readelf_flag = copy(view("--debug-dump=decodedline"));
    } else {
        if eq(view(sub), view("info")) {
            dump_flag = copy(view("--debug-info"));
            readelf_flag = copy(view("--debug-dump=info"));
        } else {
            say(view("usage: grail debug lines|info BINARY"));
            return 1;
        }
    }
    binary := item(&args, 1);
    if host::exists(view(binary)) == 0 {
        say(view("grail: no such file: "));
        say(view(binary));
        return 1;
    }
    mut dump = u8[][
        tool(view("GRAIL_DWARFDUMP"), view("llvm-dwarfdump")),
        dump_flag,
        copy(view(binary))
    ];
    if host::command(dump) == 0 {
        return 0;
    }
    say(view("grail: llvm-dwarfdump unavailable; trying readelf"));
    mut decoded = u8[][
        tool(view("GRAIL_READELF"), view("readelf")),
        readelf_flag,
        copy(view(binary))
    ];
    return host::command(decoded);
}
// ---- `grail profile` -------------------------------------------------------------------------
// The target profiles itself: its runtime reads GRAIL_PROFILE from its environment, arms an
// ITIMER_PROF timer and writes the interrupted instruction pointers to the file named there (see
// runtime.grl). This side owns the request, the scratch directory, the ELF symbol table and the
// report; no perf, nm or addr2line is involved, and only the program's own instruction pointer is
// sampled.
struct Symbol {
    start: u64,
    function: u8[],
    module: u8[]
}
fn byte_at<a>(image: &a [u8], at: u64) -> u64 {
    if at < image.len() {
        return u64(image[at]);
    }
    return 0;
}
fn le16<a>(image: &a [u8], at: u64) -> u64 {
    if image.len() < at + 2 {
        return 0;
    }
    return byte_at(view(image), at) + byte_at(view(image), at + 1) * 256;
}
fn le32<a>(image: &a [u8], at: u64) -> u64 {
    if image.len() < at + 4 {
        return 0;
    }
    return le16(view(image), at) + le16(view(image), at + 2) * 65536;
}
fn le64<a>(image: &a [u8], at: u64) -> u64 {
    if image.len() < at + 8 {
        return 0;
    }
    return le32(view(image), at) + le32(view(image), at + 4) * 4294967296;
}
fn bytes_between<a>(image: &a [u8], from: u64, to: u64) -> u8[] {
    mut out = u8[];
    mut i = from;
    while i < to {
        out.push(image[i]);
        i += 1;
    }
    return out;
}
fn cstring_at<a>(image: &a [u8], at: u64) -> u8[] {
    mut out = u8[];
    mut i = at;
    while (i < image.len()) && (image[i] != 0) {
        out.push(image[i]);
        i += 1;
    }
    return out;
}
fn starts_with<a, b>(text: &a [u8], prefix: &b [u8]) -> bool {
    if text.len() < prefix.len() {
        return false;
    }
    for i in prefix.len() {
        if text[i] != prefix[i] {
            return false;
        }
    }
    return true;
}
fn decimal(n: u64) -> u8[] {
    mut out = u8[];
    mut v = n;
    if v == 0 {
        out.push(48);
        return out;
    }
    while 0 < v {
        out.push(48 + v % 10);
        v = v / 10;
    }
    mut flipped = u8[];
    mut i = out.len();
    while 0 < i {
        i -= 1;
        flipped.push(out[i]);
    }
    return flipped;
}
fn number_of<a>(text: &a [u8]) -> u64 {
    mut value: u64 = 0;
    for i in text.len() {
        c := u64(text[i]);
        if (c < 48) || (57 < c) {
            return 0;
        }
        value = value * 10 + (c - 48);
    }
    return value;
}
fn pad_left<a>(text: &a [u8], width: u64) -> u8[] {
    mut out = u8[];
    mut i = text.len();
    while i < width {
        out.push(32);
        i += 1;
    }
    for i in text.len() {
        out.push(text[i]);
    }
    return out;
}
fn padded<a>(text: &a [u8], width: u64) -> u8[] {
    mut out = u8[];
    for i in text.len() {
        out.push(text[i]);
    }
    while out.len() < width {
        out.push(32);
    }
    return out;
}
fn share_text(count: u64, total: u64) -> u8[] {
    if total == 0 {
        return copy(view("0.0%"));
    }
    // One decimal place, rounded to the nearest tenth of a percent.
    tenths := (count * 1000 + total / 2) / total;
    mut out = decimal(tenths / 10);
    out.push(46);
    out.push(48 + tenths % 10);
    out.push(37);
    return out;
}
// Hundredths of a second of measured CPU time, with the unit.
fn nanos_text(ns: u64) -> u8[] {
    if ns == 0 {
        return copy(view("an unknown amount of time"));
    }
    hundredths := (ns + 5000000) / 10000000;
    mut out = decimal(hundredths / 100);
    out.push(46);
    out.push(48 + (hundredths / 10) % 10);
    out.push(48 + hundredths % 10);
    out.push(32);
    out.push(115);
    return out;
}
// Samples per second of measured CPU time: what the kernel actually delivered.
fn effective_rate(count: u64, ns: u64) -> u64 {
    if ns == 0 {
        return 0;
    }
    return count * 1000000000 / ns;
}
// True when the measured rate is less than three quarters of the request, which is how the kernel's
// per-tick accounting shows up above roughly one kHz.
fn capped(requested: u64, count: u64, ns: u64) -> bool {
    if ns == 0 {
        return false;
    }
    return effective_rate(count, ns) * 4 < requested * 3;
}
fn push_text<a>(out: (&mut u8[]), text: &a [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
}
fn push_line<a>(out: (&mut u8[]), text: &a [u8]) -> unit {
    push_text(&mut out, view(text));
    out.push(10);
}
// Every STT_FUNC symbol in .symtab, split into `f_<module>_<function>`. The compiler emits no
// st_size for its functions, so a range runs from a symbol's start to the next symbol's start.
fn elf_symbols<a>(image: &a [u8]) -> Symbol[] {
    mut out = Symbol[];
    if image.len() < 64 {
        return out;
    }
    if (image[0] != 127) || (image[1] != 69) || (image[2] != 76) || (image[3] != 70) {
        return out;
    }
    shoff := le64(view(image), 40);
    entsize := le16(view(image), 58);
    count := le16(view(image), 60);
    mut symoff: u64 = 0;
    mut symsize: u64 = 0;
    mut step: u64 = 0;
    mut stroff: u64 = 0;
    mut found: u64 = 0;
    mut i: u64 = 0;
    while i < count {
        base := shoff + i * entsize;
        if le32(view(image), base + 4) == 2 {
            symoff = le64(view(image), base + 24);
            symsize = le64(view(image), base + 32);
            step = le64(view(image), base + 56);
            link := le32(view(image), base + 40);
            stroff = le64(view(image), shoff + link * entsize + 24);
            found = 1;
        }
        i += 1;
    }
    if (found == 0) || (step == 0) {
        return out;
    }
    mut at: u64 = 0;
    while at + step <= symsize {
        entry := symoff + at;
        if byte_at(view(image), entry + 4) % 16 == 2 {
            address := le64(view(image), entry + 8);
            if address != 0 {
                name := cstring_at(view(image), stroff + le32(view(image), entry));
                mut module = u8[];
                mut function = copy(view(name));
                if starts_with(view(name), view("f_")) {
                    mut k: u64 = 2;
                    while (k < name.len()) && (name[k] != 95) {
                        k += 1;
                    }
                    module = bytes_between(view(name), 2, k);
                    function = bytes_between(view(name), k + 1, name.len());
                } else if starts_with(view(name), view("rt_")) {
                    module = copy(view("runtime"));
                }
                out.push(Symbol { start: address, function: function, module: module });
            }
        }
        at += step;
    }
    return out;
}
// Symbol indices ordered by start address.
fn by_start<a>(symbols: (&a Symbol[])) -> u64[] {
    mut order = u64[];
    for i in symbols.len() {
        order.push(i);
    }
    mut k: u64 = 1;
    while k < order.len() {
        mut j = k;
        while 0 < j {
            if symbols[order[j - 1]].start <= symbols[order[j]].start {
                break;
            }
            swapped := order[j - 1];
            order[j - 1] = order[j];
            order[j] = swapped;
            j -= 1;
        }
        k += 1;
    }
    return order;
}
// The symbol whose range holds `pc`, or symbols.len() when no known symbol covers it.
fn symbol_at<a, b>(symbols: (&a Symbol[]), order: (&b u64[]), pc: u64) -> u64 {
    mut lo: u64 = 0;
    mut hi: u64 = order.len();
    while lo < hi {
        mid := lo + (hi - lo) / 2;
        if symbols[order[mid]].start <= pc {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return symbols.len();
    }
    return order[lo - 1];
}
// Symbol indices with at least one sample, most samples first.
fn by_count<a, b>(counts: (&a u64[]), slots: (&b u64[])) -> u64[] {
    mut order = u64[];
    for i in slots.len() {
        if counts[slots[i]] != 0 {
            order.push(slots[i]);
        }
    }
    mut k: u64 = 1;
    while k < order.len() {
        mut j = k;
        while 0 < j {
            if counts[order[j - 1]] >= counts[order[j]] {
                break;
            }
            swapped := order[j - 1];
            order[j - 1] = order[j];
            order[j] = swapped;
            j -= 1;
        }
        k += 1;
    }
    return order;
}
// Where per-run scratch lives: TMPDIR when the environment names one, /tmp otherwise. `grail
// profile` refuses non-Linux targets, so there is no platform-specific temp directory here.
fn profile_temp() -> u8[] {
    named := host::env(view("TMPDIR"));
    if named.len() != 0 {
        return named;
    }
    return copy(view("/tmp"));
}
// A directory of our own for one run: `mkdir` is the atomic claim, so two profilers started in the
// same millisecond cannot share a sample file, and the directory is removed once the report is read.
fn profile_scratch() -> u8[] {
    base := profile_temp();
    stamp := host::now_ms();
    mut n: u64 = 0;
    while n < 10000 {
        name := cat(view("grail-profile-"), view(decimal(stamp + n)));
        dir := path_join(view(base), view(name));
        if host::mkdir(view(dir)) == 0 {
            return dir;
        }
        n += 1;
    }
    return u8[];
}
fn profile_command<a>(args: (&a u8[][])) -> u64 {
    mut rate: u64 = 200;
    // `--callers`: each sample also carries up to seven return addresses (the runtime walks the frame
    // pointers), and the report adds inclusive time and who calls the hottest functions. Without it
    // the request, the samples and the runtime's handler are exactly what they were.
    mut callers = false;
    mut out_path = u8[];
    mut i: u64 = 0;
    while i < args.len() {
        a := item(&args, i);
        if eq(view(a), view("--")) {
            i += 1;
            break;
        }
        if eq(view(a), view("--rate")) && (i + 1 < args.len()) {
            i += 1;
            rate = number_of(view(item(&args, i)));
        } else if eq(view(a), view("--out")) && (i + 1 < args.len()) {
            i += 1;
            out_path = item(&args, i);
        } else if eq(view(a), view("--callers")) {
            callers = true;
        } else {
            break;
        }
        i += 1;
    }
    mut rest = u8[][];
    while i < args.len() {
        rest.push(item(&args, i));
        i += 1;
    }
    if rest.len() == 0 {
        say(view("usage: grail profile [--rate N] [--callers] [--out FILE] -- PROGRAM [ARGS]"));
        return 2;
    }
    if (rate == 0) || (1000000 < rate) {
        say(view("grail profile: --rate must be between 1 and 1000000 samples per second"));
        return 2;
    }
    if host::target() != 0 {
        say(view("grail profile: sampling is implemented for Linux x86-64 only"));
        return 2;
    }
    program := item(&rest, 0);
    if host::exists(view(program)) == 0 {
        say(view("grail profile: no such file: "));
        say(view(program));
        return 2;
    }
    // The arming request travels in the child's environment, so the target needs no writable
    // working directory and a killed run cannot leave a stale request behind for the next one.
    dir := profile_scratch();
    if dir.len() == 0 {
        say(view("grail profile: cannot create a directory for the samples under "));
        say(view(profile_temp()));
        return 2;
    }
    samples := path_join(view(dir), view("samples"));
    mut text = decimal(1);
    if callers {
        text = decimal(2);
    }
    text.push(32);
    text = cat(view(text), view(decimal(rate)));
    text.push(32);
    text = cat(view(text), view(decimal(65536)));
    text.push(32);
    text = cat(view(text), view(samples));
    // The inherited environment plus the request, so the profiled program still sees everything it
    // would have seen; a child started with an explicit environment is not armed unless it copies
    // this entry.
    mut environment = host::environment();
    environment.push(cat(view("GRAIL_PROFILE="), view(text)));
    mut command = u8[][];
    command.push(item(&rest, 0));
    for n in rest.len() {
        if n != 0 {
            command.push(item(&rest, n));
        }
    }
    status := host::command_with(command, environment);
    mut out = u8[];
    mut title = cat(view("grail profile: "), view(program));
    push_line(&mut out, view(title));
    if host::exists(view(samples)) == 0 {
        push_line(
            &mut out,
            view("  no samples: the target did not arm the sampling runtime at startup")
        );
        say(view(out));
        host::remove(view(dir), 1);
        return status;
    }
    data := host::read_file(view(samples));
    host::remove(view(samples), 0);
    host::remove(view(dir), 1);
    if data.len() < 48 {
        say(view("grail profile: truncated sample file"));
        return 1;
    }
    if (data[0] != 71) || ((data[6] != 50) && (data[6] != 51)) {
        say(
            view("grail profile: unsupported sample format; rebuild the program with this compiler")
        );
        return 1;
    }
    sample_rate := le64(view(data), 8);
    capacity := le64(view(data), 16);
    count := le64(view(data), 24);
    dropped := le64(view(data), 32);
    cpu_ns := le64(view(data), 40);
    mut each: u64 = 1;
    if data[6] == 51 {
        each = 8;
    }
    if data.len() < 48 + count * 8 * each {
        say(view("grail profile: truncated sample file"));
        return 1;
    }
    image := host::read_file(view(program));
    symbols := elf_symbols(view(image));
    kind := le16(view(image), 16);
    mut elf = false;
    if 4 <= image.len() {
        if (image[0] == 127) && (image[1] == 69) && (image[2] == 76) && (image[3] == 70) {
            elf = true;
        }
    }
    if !elf {
        push_line(
            &mut out,
            view("  not an ELF image: no symbols to attribute, every sample is [unknown]")
        );
    } else if kind == 3 {
        push_line(
            &mut out,
            view("  position independent (ET_DYN): sample addresses are relocated")
        );
        push_line(
            &mut out,
            view("  and cannot be matched to link-time symbols, so every sample is [unknown]")
        );
    } else {
        push_line(
            &mut out,
            view(
                "  non-PIE (ET_EXEC): sample addresses are link-time .symtab addresses, no adjustment"
            )
        );
    }
    mut intro = cat(view("  "), view(decimal(sample_rate)));
    intro = cat(view(intro), view(" Hz ITIMER_PROF, "));
    intro = cat(view(intro), view(decimal(count)));
    intro = cat(view(intro), view(" samples in "));
    intro = cat(view(intro), view(nanos_text(cpu_ns)));
    intro = cat(view(intro), view(" of CPU time"));
    if cpu_ns != 0 {
        intro = cat(view(intro), view(" (effective "));
        intro = cat(view(intro), view(decimal(effective_rate(count, cpu_ns))));
        intro = cat(view(intro), view(" Hz)"));
    }
    push_line(&mut out, view(intro));
    if capped(sample_rate, count, cpu_ns) {
        push_line(
            &mut out,
            view("  the effective rate is far below the request: the kernel accounts CPU time per")
        );
        push_line(
            &mut out,
            view("  tick, so intervals shorter than its granularity are rounded up")
        );
    }
    mut dropped_line = cat(view("  "), view(decimal(dropped)));
    dropped_line = cat(view(dropped_line), view(" samples dropped after the "));
    dropped_line = cat(view(dropped_line), view(decimal(capacity)));
    dropped_line = cat(view(dropped_line), view("-sample buffer filled"));
    if dropped != 0 {
        push_line(&mut out, view(dropped_line));
    }
    order := by_start(&symbols);
    mut counts = u64[];
    for n in symbols.len() + 1 {
        counts.push(0);
    }
    if elf && (kind != 3) {
        mut k: u64 = 0;
        while k < count {
            slot := symbol_at(&symbols, &order, le64(view(data), 48 + k * 8 * each));
            counts[slot] = counts[slot] + 1;
            k += 1;
        }
    } else {
        counts[symbols.len()] = count;
    }
    mut width: u64 = 20;
    for n in symbols.len() {
        if width < symbols[n].function.len() {
            width = symbols[n].function.len();
        }
    }
    push_line(&mut out, view(""));
    mut header = copy(view("  "));
    header = cat(view(header), view(pad_left(view("samples"), 7)));
    header = cat(view(header), view(" "));
    header = cat(view(header), view(pad_left(view("share"), 6)));
    header = cat(view(header), view("  "));
    header = cat(view(header), view(padded(view("function"), width + 2)));
    header = cat(view(header), view("module"));
    push_line(&mut out, view(header));
    rows := by_count(&counts, &order);
    for n in rows.len() {
        s := &symbols[rows[n]];
        mut line = copy(view("  "));
        line = cat(view(line), view(pad_left(view(decimal(counts[rows[n]])), 7)));
        line = cat(view(line), view(" "));
        line = cat(view(line), view(pad_left(view(share_text(counts[rows[n]], count)), 6)));
        line = cat(view(line), view("  "));
        line = cat(view(line), view(padded(view(s.function), width + 2)));
        line = cat(view(line), view(s.module));
        push_line(&mut out, view(line));
    }
    mut unknown = copy(view("  "));
    unknown = cat(view(unknown), view(pad_left(view(decimal(counts[symbols.len()])), 7)));
    unknown = cat(view(unknown), view(" "));
    unknown = cat(view(unknown), view(pad_left(view(share_text(counts[symbols.len()], count)), 6)));
    unknown = cat(view(unknown), view("  "));
    unknown = cat(view(unknown), view(padded(view("[unknown]"), width + 2)));
    unknown = cat(view(unknown), view("-"));
    push_line(&mut out, view(unknown));
    mut total = copy(view("  "));
    total = cat(view(total), view(pad_left(view(decimal(count)), 7)));
    total = cat(view(total), view(" "));
    total = cat(view(total), view(pad_left(view(share_text(count, count)), 6)));
    total = cat(view(total), view("  total"));
    push_line(&mut out, view(total));
    if (each != 1) && elf && (kind != 3) {
        profile_callers(&mut out, view(data), count, each, &symbols, &order, &counts, &rows, width);
    }
    host::print(view(out));
    if out_path.len() != 0 {
        if host::write_file(view(out_path), out) != 0 {
            say(view("grail profile: cannot write "));
            say(view(out_path));
            return 1;
        }
    }
    return status;
}

// The caller view of a `--callers` profile: for every function, the samples in which it is anywhere
// on the stack (inclusive, each sample counted once per function); then, for the ten hottest leaf
// functions, which function called them and which was the first caller outside the runtime - the
// view that says *which* code allocates when `rt_alloc_unlocked` tops the table. A return address
// is attributed to the function containing the call (the address before it). A leaf caught before
// its frame is set up reports its caller's caller as its caller.
fn profile_callers<a, b, d, e, g>(out: (&a mut u8[]), data: &b [u8], count: u64, each: u64, symbols: (&d Symbol[]), order: (&e u64[]), leaf: (&g u64[]), rows: (&g u64[]), width: u64) -> unit {
    unknown := symbols.len();
    mut inclusive = u64[];
    for n in symbols.len() + 1 {
        inclusive.push(0);
    }
    mut seen = u64[];
    for n in symbols.len() + 1 {
        seen.push(0);
    }
    // frame(k, j): the function of the j-th address of sample k.
    for k in count {
        for j in each {
            pc := le64(view(data), 48 + (k * each + j) * 8);
            if (j != 0) && (pc == 0) {
                break;
            }
            mut at = pc;
            if (j != 0) && (0 < at) {
                at -= 1;
            }
            f := symbol_at(symbols, order, at);
            if seen[f] != k + 1 {
                seen[f] = k + 1;
                inclusive[f] = inclusive[f] + 1;
            }
        }
    }
    push_line(&mut out, view(""));
    push_line(&mut out, view("  inclusive: samples with the function anywhere on the stack"));
    by := by_count(&inclusive, order);
    mut shown = 0;
    for n in by.len() {
        if (25 <= shown) || (inclusive[by[n]] == 0) {
            break;
        }
        line := profile_row(inclusive[by[n]], count, view(symbols[by[n]].function), view(symbols[by[n]].module), width);
        push_line(&mut out, view(line));
        shown += 1;
    }
    push_line(&mut out, view(""));
    push_line(&mut out, view("  callers of the hottest functions: the caller, and the first caller outside the runtime"));
    mut top = 0;
    for r in rows.len() {
        hot := rows[r];
        if (10 <= top) || (leaf[hot] == 0) {
            break;
        }
        top += 1;
        mut direct = u64[];
        mut outside = u64[];
        for n in symbols.len() + 1 {
            direct.push(0);
            outside.push(0);
        }
        for k in count {
            pc := le64(view(data), 48 + k * each * 8);
            if symbol_at(symbols, order, pc) != hot {
                continue;
            }
            mut first = unknown;
            mut away = unknown;
            for j in each {
                if j == 0 {
                    continue;
                }
                ret := le64(view(data), 48 + (k * each + j) * 8);
                if ret == 0 {
                    break;
                }
                f := symbol_at(symbols, order, ret - 1);
                if first == unknown {
                    first = f;
                }
                if (away == unknown) && (f != unknown) && !eq(view(symbols[f].module), view("runtime")) {
                    away = f;
                    break;
                }
            }
            direct[first] = direct[first] + 1;
            outside[away] = outside[away] + 1;
        }
        mut head = copy(view("    "));
        head = cat(view(head), view(symbols[hot].function));
        head = cat(view(head), view(" ("));
        head = cat(view(head), view(decimal(leaf[hot])));
        head = cat(view(head), view(" samples)"));
        push_line(&mut out, view(head));
        for pass in 2 {
            mut list = direct.copy();
            mut label = copy(view("      called by"));
            if pass == 1 {
                list = outside.copy();
                label = copy(view("      from"));
            }
            push_line(&mut out, view(label));
            order_by := by_count(&list, order);
            mut listed = 0;
            for n in order_by.len() {
                if (6 <= listed) || (list[order_by[n]] == 0) {
                    break;
                }
                line := profile_row(list[order_by[n]], leaf[hot], view(symbols[order_by[n]].function), view(symbols[order_by[n]].module), width);
                push_line(&mut out, view(cat(view("    "), view(line))));
                listed += 1;
            }
            if list[unknown] != 0 {
                line := profile_row(list[unknown], leaf[hot], view("[unknown]"), view("-"), width);
                push_line(&mut out, view(cat(view("    "), view(line))));
            }
        }
    }
    return ();
}
fn profile_row<a, b>(n: u64, total: u64, function: &a [u8], module: &b [u8], width: u64) -> u8[] {
    mut line = copy(view("  "));
    line = cat(view(line), view(pad_left(view(decimal(n)), 7)));
    line = cat(view(line), view(" "));
    line = cat(view(line), view(pad_left(view(share_text(n, total)), 6)));
    line = cat(view(line), view("  "));
    line = cat(view(line), view(padded(function, width + 2)));
    line = cat(view(line), module);
    return line;
}

// `grail doc [--out DIR] [FILES or DIRS]`: the reference documentation of a source tree, as one HTML
// page per module plus a JSON index (compiler/docgen.grl). The default is the standard library into
// `docs/api`.
fn doc_usage() -> unit {
    say(view("usage: grail doc [--out DIR] [FILES or DIRS]   (default: docs/api from lib/)"));
    say(view("       the documentation of a declaration is the // comment block directly above it"));
}
fn put_label<a>(out: (&a mut u8[]), text: &a [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
    return ();
}
fn doc_command<a>(args: (&a u8[][])) -> u64 {
    mut dir = copy(view("docs/api"));
    mut paths = u8[][];
    mut i: u64 = 0;
    while i < args.len() {
        a := item(&args, i);
        if (eq(view(a), view("--out"))) & (i + 1 < args.len()) {
            i += 1;
            dir = item(&args, i);
        } else if starts(view(a), view("--out=")) {
            dir = tail_from(view(a), 6);
        } else if starts(view(a), view("--")) {
            doc_usage();
            return 1;
        } else {
            paths.push(a);
        }
        i += 1;
    }
    if paths.len() == 0 {
        paths.push(copy(view("lib")));
    }
    mut files = u8[][];
    for i in paths.len() {
        x := item(&paths, i);
        if ends(view(x), view(".grl")) {
            files.push(x);
        } else {
            collect(view(x), &mut files);
        }
    }
    if files.len() == 0 {
        say(view("grail doc: no .grl sources found in the paths given"));
        return 1;
    }
    // The sources the tree documents, named in the index: the paths as given, one line.
    mut label = u8[];
    for i in paths.len() {
        if 0 < i {
            label.push(32);
        }
        put_label(&mut label, view(item(&paths, i)));
    }
    return docgen::write(&files, view(dir), view(label));
}
fn help() {
    say(view("grail - the Grail compiler and project tool\n"));
    say(view("usage:"));
    say(
        view(
            "  grail build [FILE.grl] [-o OUT] [--target x86_64|aarch64|riscv64|macos-x86_64|macos-aarch64] [--release] [--debug|--no-debug-info] [--split] [--cache] [--overflow=wrap|checked] [--interface DIR [--verify]]"
        )
    );
    say(view("  grail check [FILE.grl]            type-check without building"));
    say(view("  grail check --watch [--json] [--interval MS] [--debounce MS]   re-check on every change"));
    say(view("  grail build --watch [--json] [--interval MS] [--debounce MS]   re-build on every change"));
    say(view("  grail check --diagnostics-json FILE   diagnostics as JSON records, nothing printed"));
    say(view("  grail check --interface DIR       write one checked interface per module"));
    say(
        view(
            "  grail check --interface DIR --verify   refuse an interface that disagrees with its sources"
        )
    );
    say(view("  grail debug lines|info BINARY     print DWARF line rows or .debug_info"));
    say(
        view(
            "  grail cache prune [--keep N]       drop cache entries no build used in the last N (10)"
        )
    );
    say(view("  grail cache clear                  empty the build cache"));
    say(view("  grail cache warm [--target T]      check and build the standard library into the cache"));
    say(view("  grail explain CODE                 what an error code means (error[E0004])"));
    say(view("  grail doc [--out DIR] [FILES|DIRS] reference documentation: HTML per module + index.json"));
    say(view("  grail bindgen HEADER.h -o OUT.grl  import a C header as extern \"C\" declarations [-I DIR] [-l LIB]"));
    say(view("  grail profile [--rate N] [--out FILE] -- PROGRAM [ARGS]   sampling profile"));
    say(view("  grail run [FILE.grl] [-- ARGS...]"));
    say(view("  grail test [FILES or DIRS] [--filter TEXT] [--list] [--shard i/n] [--jobs N] [--fail-fast]"));
    say(view("                                    compile and run tests/ (in the Grail tree: the regression corpus)"));
    say(view("  grail fmt [--check] [FILES or DIRS]"));
    say(view("  grail new NAME                    create a project (grail.toml, src/, tests/)"));
    say(
        view(
            "  grail add NAME[@REQ]              add a registry dependency (resolves and locks it)"
        )
    );
    say(view("  grail add --path DIR              add a path dependency"));
    say(
        view("  grail add --git URL [--rev R]     add a git dependency (--rev, --tag or --branch)")
    );
    say(view("  grail remove NAME                 drop a dependency and re-resolve"));
    say(view("  grail update [NAME...]            re-resolve, then fetch what the lock names"));
    say(
        view("  grail fetch [--force]             make the store hold exactly what grail.lock says")
    );
    say(view("  grail tree                        print the resolved dependency graph"));
    say(view("  (--offline works on add, update and fetch: no git or curl is run)"));
    say(view("  grail iface dump FILE        render the typed records one interface carries"));
    say(view("  grail iface roundtrip FILE   read it back, write it again, compare byte for byte"));
    say(
        view(
            "  grail [--target T] [--overflow=checked|wrap] OUT.s ENTRY.grl MODULE.grl...  (compiler)"
        )
    );
}
// `grail iface dump FILE` and `grail iface roundtrip FILE`: the typed record tree an interface
// carries, rendered field by field, and the proof that reading it back and writing it again
// reproduces the file byte for byte. Both run the compiler itself, because the dump *is* the
// reader's own view of the file - there is no second parser, and so no third spelling to drift.
fn iface_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() < 2 {
        say(view("usage: grail iface dump FILE | grail iface roundtrip FILE"));
        return 1;
    }
    what := item(&args, 0);
    mut flag = copy(view("--iface-dump"));
    if eq(view(what), view("roundtrip")) {
        flag = copy(view("--iface-roundtrip"));
    } else {
        if !eq(view(what), view("dump")) {
            say(view("grail: iface takes `dump` or `roundtrip`"));
            return 1;
        }
    }
    mut argv = u8[][host::exe_path(), flag, item(&args, 1)];
    return host::command(argv);
}
pub fn is_command<a>(name: &a [u8]) -> bool {
    return eq(view(name), view("build"))
        || eq(view(name), view("iface"))
        || eq(view(name), view("check"))
        || eq(view(name), view("run"))
        || eq(view(name), view("test"))
        || eq(view(name), view("fmt"))
        || eq(view(name), view("new"))
        || eq(view(name), view("add"))
        || eq(view(name), view("fetch"))
        || eq(view(name), view("remove"))
        || eq(view(name), view("update"))
        || eq(view(name), view("tree"))
        || eq(view(name), view("debug"))
        || eq(view(name), view("profile"))
        || eq(view(name), view("cache"))
        || eq(view(name), view("unit-build"))
        || eq(view(name), view("llvm-compile"))
        || eq(view(name), view("explain"))
        || eq(view(name), view("asm"))
        || eq(view(name), view("doc"))
        || eq(view(name), view("bindgen"))
        || eq(view(name), view("install"))
        || eq(view(name), view("help"))
        || eq(view(name), view("--help"))
        || eq(view(name), view("version"))
        || eq(view(name), view("--version"));
}
pub fn run() -> u64 {
    name := host::arg(1);
    mut args = u8[][];
    mut i = 2;
    while i < host::argc() {
        args.push(host::arg(i));
        i += 1;
    }
    if eq(view(name), view("build")) {
        mut o = options(&args);
        return build(&args, &mut o);
    }
    if eq(view(name), view("iface")) {
        return iface_command(&args);
    }
    if eq(view(name), view("check")) {
        return check_command(&args);
    }
    if eq(view(name), view("run")) {
        return run_command(&args);
    }
    if eq(view(name), view("test")) {
        return test_command(&args);
    }
    if eq(view(name), view("fmt")) {
        return fmt_command(&args);
    }
    if eq(view(name), view("new")) {
        return new_command(&args);
    }
    // The package manager owns these five commands (module pkg, docs/design/package-manager.md).
    if eq(view(name), view("add")) || eq(view(name), view("remove")) {
        return pkg::command(view(name), &args);
    }
    if eq(view(name), view("update"))
        || eq(view(name), view("fetch"))
        || eq(view(name), view("tree")) {
        return pkg::command(view(name), &args);
    }
    if eq(view(name), view("debug")) {
        return debug_command(&args);
    }
    if eq(view(name), view("cache")) {
        return cache_command(&args);
    }
    if eq(view(name), view("unit-build")) {
        return unit_build_command(&args);
    }
    if eq(view(name), view("llvm-compile")) {
        return llvm_compile_command(&args);
    }
    if eq(view(name), view("explain")) {
        // `grail explain E0004`: what an error code means and how it is usually fixed.
        if args.len() != 1 {
            say(view("usage: grail explain CODE   (the code an error prints, as in error[E0004])"));
            return 1;
        }
        text := explain::text(view(item(&args, 0)));
        if text.len() == 0 {
            say(view("grail: no such error code"));
            return 1;
        }
        host::print(view(text));
        return 0;
    }
    if eq(view(name), view("bindgen")) {
        return bindgen::run(&args);
    }
    if eq(view(name), view("asm")) {
        return asm_x86::command(&args);
    }
    if eq(view(name), view("doc")) {
        return doc_command(&args);
    }
    if eq(view(name), view("profile")) {
        return profile_command(&args);
    }
    if eq(view(name), view("version")) || eq(view(name), view("--version")) {
        out := cat(view("grail "), view(pkg::grail_version()));
        say(view(out));
        return 0;
    }
    help();
    return 0;
}
