module cli;
use host;
use docgen;
use fmt;
use explain;
use bindgen;
use pkg;
use xxhash;

// The `grail` command-line tool. The same binary is the compiler: subcommands drive it by
// re-invoking itself (`grail [--target T] OUT.s ENTRY.grl MODULE.grl...`), then assemble and link.
struct Home {
    runtime: u8[],
    std: u8[],
    // The directories `--module-root DIR` named, in the order given: a root is where `use` looks for
    // `NAME.grl`, and the first root that holds a module wins. They travel in `Home` so that the
    // resolution probe and the compile are built from one command and cannot disagree about the
    // list - that disagreement is what made the flag look ignored.
    roots: u8[][]
}

fn eq<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn starts<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() < y.len() {
        return false;
    }
    for i in y.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn ends<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() < y.len() {
        return false;
    }
    d := x.len() - y.len();
    for i in y.len() {
        if x[d + i] != y[i] {
            return false;
        }
    }
    return true;
}
fn cat<a, b>(x: &a [u8], y: &b [u8]) -> u8[] {
    mut o = u8[];
    for i in x.len() {
        o.push(x[i]);
    }
    for i in y.len() {
        o.push(y[i]);
    }
    return o;
}
// `text` as the inside of a JSON string: quotes, backslashes and control characters escaped, so a
// record stays on one line whatever the source or the message holds. Both structured-diagnostic
// writers use it - the compiler's per-diagnostic record and the driver's per-cycle object.
pub fn json_text<a>(out: (&mut u8[]), text: &a [u8]) -> unit {
    mut i = 0;
    while i < text.len() {
        ch := text[i];
        if (ch == 34) || (ch == 92) {
            out.push(92);
            out.push(ch);
        } else {
            if ch == 10 {
                out.push(92);
                out.push(110);
            } else {
                if ch == 9 {
                    out.push(92);
                    out.push(116);
                } else {
                    if ch == 13 {
                        out.push(92);
                        out.push(114);
                    } else {
                        if ch < 32 {
                            out.push(92);
                            out.push(117);
                            out.push(48);
                            out.push(48);
                            out.push(hex_digit(ch / 16));
                            out.push(hex_digit(ch % 16));
                        } else {
                            out.push(ch);
                        }
                    }
                }
            }
        }
        i += 1;
    }
    return ();
}
fn hex_digit(n: u64) -> u8 {
    if n < 10 {
        return 48 + u8(n);
    }
    return 87 + u8(n);
}
fn copy<a>(x: &a [u8]) -> u8[] {
    mut o = u8[];
    for i in x.len() {
        o.push(x[i]);
    }
    return o;
}
fn push_bytes<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    for i in s.len() {
        out.push(s[i]);
    }
    return ();
}
fn path_join<a, b>(dir: &a [u8], name: &b [u8]) -> u8[] {
    if (dir.len() == 0) || eq(view(dir), view(".")) {
        return copy(view(name));
    }
    // A Windows path ends in either separator, and both are accepted by every Win32 call.
    if is_sep(dir[dir.len() - 1]) {
        return cat(view(dir), view(name));
    }
    mut o = copy(view(dir));
    o.push(47);
    for i in name.len() {
        o.push(name[i]);
    }
    return o;
}
// `/` on Linux and macOS, `/` or `\\` on Windows: one predicate for every path split below.
// `C:` / `c:`: a Win32 path is absolute without a leading separator.
fn drive_letter<a>(path: &a [u8]) -> bool {
    if path.len() < 2 {
        return false;
    }
    if path[1] != 58 {
        return false;
    }
    return (65 <= path[0]) && (path[0] <= 90) || (97 <= path[0]) && (path[0] <= 122);
}
fn is_sep(ch: u64) -> bool {
    return (ch == 47) || (ch == 92);
}
fn dirname<a>(p: &a [u8]) -> u8[] {
    mut i = p.len();
    while 0 < i {
        i -= 1;
        if is_sep(p[i]) {
            mut o = u8[];
            for j in i {
                o.push(p[j]);
            }
            if i == 0 {
                o.push(47);
            }
            return o;
        }
    }
    return copy(view("."));
}
fn basename<a>(p: &a [u8]) -> u8[] {
    mut start = 0;
    for i in p.len() {
        if is_sep(p[i]) {
            start = i + 1;
        }
    }
    mut o = u8[];
    mut end = p.len();
    if ends(view(p), view(".grl")) {
        end -= 4;
    }
    mut i = start;
    while i < end {
        o.push(p[i]);
        i += 1;
    }
    return o;
}
fn say<a>(s: &a [u8]) {
    host::print(s);
    host::print(view("\n"));
}
fn say2<a, b>(s: &a [u8], t: &b [u8]) {
    host::print(s);
    host::print(t);
    host::print(view("\n"));
}
fn item<a>(v: (&a u8[][]), i: u64) -> u8[] {
    x := &v[i];
    return x.copy();
}
fn words<a>(line: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut cur = u8[];
    for i in line.len() {
        c := line[i];
        if c == 32 || c == 9 || c == 13 {
            if cur.len() != 0 {
                out.push(exchange(&mut cur, u8[]));
            }
        } else {
            cur.push(c);
        }
    }
    if cur.len() != 0 {
        out.push(cur);
    }
    return out;
}
fn lines<a>(text: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut cur = u8[];
    for i in text.len() {
        c := text[i];
        if c == 10 {
            out.push(exchange(&mut cur, u8[]));
        } else {
            cur.push(c);
        }
    }
    if cur.len() != 0 {
        out.push(cur);
    }
    return out;
}

fn home() -> Home {
    env := host::env(view("GRAIL_HOME"));
    if env.len() != 0 {
        installed := path_join(view(env), view("runtime.grl"));
        if host::exists(view(installed)) != 0 {
            return Home { runtime: installed, std: path_join(view(env), view("std")) , roots: u8[][] };
        }
        repo := path_join(view(env), view("compiler/runtime.grl"));
        if host::exists(view(repo)) != 0 {
            return Home { runtime: repo, std: path_join(view(env), view("lib")) , roots: u8[][] };
        }
    }
    exe := host::exe_path();
    mut dir = dirname(view(exe));
    for level in 6 {
        installed := path_join(view(dir), view("lib/grail/runtime.grl"));
        if host::exists(view(installed)) != 0 {
            prefix := path_join(view(dir), view("lib/grail"));
            return Home { runtime: installed, std: path_join(view(prefix), view("std")) , roots: u8[][] };
        }
        repo := path_join(view(dir), view("compiler/runtime.grl"));
        if host::exists(view(repo)) != 0 {
            return Home { runtime: repo, std: path_join(view(dir), view("lib")) , roots: u8[][] };
        }
        dir = path_join(view(dir), view(".."));
    }
    say(view("grail: cannot find the Grail runtime; set GRAIL_HOME"));
    return Home { runtime: u8[], std: u8[] , roots: u8[][] };
}
fn collect<a, b>(dir: &a [u8], out: (&b mut u8[][])) {
    entries := host::list_dir(view(dir));
    for i in entries.len() {
        name := item(&entries, i);
        if ends(view(name), view("/")) {
            if !(starts(view(name), view(".")) || eq(view(name), view("target/"))) {
                sub := path_join(view(dir), view(name));
                collect(view(sub), &mut out);
            }
        } else {
            if ends(view(name), view(".grl")) {
                out.push(path_join(view(dir), view(name)));
            }
        }
    }
}
// Whether a source of the build claims a checked effect (docs/design/effects.md).
fn effects_claimed<a>(command: (&a u8[][]), at: u64) -> bool {
    mut k = at;
    while k < command.len() {
        file := item(command, k);
        k += 1;
        if !ends_with_grl(view(file)) {
            continue;
        }
        text := host::read_file(view(file));
        if has_text(view(text), view("@no_alloc")) || has_text(view(text), view("@no_panic")) {
            return true;
        }
    }
    return false;
}
fn ends_with_grl<a>(s: &a [u8]) -> bool {
    n := s.len();
    if n < 4 {
        return false;
    }
    return (s[n - 4] == 46) && (s[n - 3] == 103) && (s[n - 2] == 114) && (s[n - 1] == 108);
}
fn has_text<a, b>(text: &a [u8], needle: &b [u8]) -> bool {
    if needle.len() > text.len() {
        return false;
    }
    mut i = 0;
    while i + needle.len() <= text.len() {
        mut j = 0;
        while (j < needle.len()) && (text[i + j] == needle[j]) {
            j += 1;
        }
        if j == needle.len() {
            return true;
        }
        i += 1;
    }
    return false;
}
// The compiler's link requests: each `// grail-link: INPUT` line of the assembly. Absolute paths
// and flags pass through, relative object/archive/shared inputs resolve against `base` (the entry
// file's directory) and bare names become -lNAME. Duplicates are dropped.
fn link_inputs<a, b>(asm: &a [u8], base: &b [u8]) -> u8[][] {
    text := host::read_file(view(asm));
    prefix := "// grail-link: ";
    mut out = u8[][];
    mut start: u64 = 0;
    mut i: u64 = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut line = u8[];
            for j in i - start {
                line.push(text[start + j]);
            }
            // A PE import note names a symbol in a DLL, not a linker input: windows_link turns it
            // into a short-import object. Every other note is an input.
            if starts(view(line), view(prefix))
                & !starts(view(line), view("// grail-link: import ")) {
                mut input = u8[];
                mut k = prefix.len();
                while k < line.len() {
                    input.push(line[k]);
                    k += 1;
                }
                while (input.len() > 0)
                    && ((input[input.len() - 1] == 32) || (input[input.len() - 1] == 13)) {
                    input.pop()!;
                }
                mut arg = u8[];
                if (input.len() > 0)
                    && (
                        (input[0] == 47)
                            || (input[0] == 45)
                            || ((input[0] == 92) || drive_letter(input))
                    ) {
                    arg = input.copy();
                } else {
                    mut has_slash = false;
                    for j in input.len() {
                        if is_sep(input[j]) {
                            has_slash = true;
                        }
                    }
                    if has_slash
                        || ends(view(input), view(".o"))
                        || ends(view(input), view(".a"))
                        || ends(view(input), view(".so"))
                        || ends(view(input), view(".dylib")) {
                        arg = path_join(view(base), view(input));
                    } else {
                        arg = cat(view("-l"), view(input));
                    }
                }
                mut seen = 0;
                for j in out.len() {
                    if eq(view(item(&out, j)), view(arg)) {
                        seen = 1;
                    }
                }
                if (seen == 0) && (arg.len() > 0) {
                    out.push(arg);
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return out;
}
// A shared-library input (-lNAME) makes the ELF executable dynamically linked: ld.lld then needs
// the platform loader, the system library directories, which it has no defaults for, and libc.
fn dynamic_link_flags<a, b>(target: &a [u8], inputs: (&b u8[][])) -> u8[][] {
    mut out = u8[][];
    mut shared = 0;
    for i in inputs.len() {
        if starts(view(item(&inputs, i)), view("-l")) {
            shared = 1;
        }
    }
    if shared == 0 {
        return out;
    }
    mut loaders = u8[][
        copy(view("/lib64/ld-linux-x86-64.so.2")),
        copy(view("/lib/ld-linux-x86-64.so.2"))
    ];
    if eq(view(target), view("aarch64")) {
        loaders = u8[][copy(view("/lib/ld-linux-aarch64.so.1"))];
    }
    if eq(view(target), view("riscv64")) {
        loaders = u8[][
            copy(view("/lib/ld-linux-riscv64-lp64d.so.1")),
            copy(view("/lib/ld-linux-riscv64-lp64.so.1"))
        ];
    }
    for i in loaders.len() {
        candidate := item(&loaders, i);
        if host::exists(view(candidate)) != 0 {
            out.push(copy(view("--dynamic-linker")));
            out.push(candidate);
            break;
        }
    }
    out.push(copy(view("-L/usr/lib")));
    out.push(copy(view("-L/usr/lib64")));
    // A dynamic process has loaded libc whatever it named, and the runtime creates its threads
    // through pthread_create so each has a libc TCB (docs/ffi.md); a weak reference only binds
    // when libc is on the link line.
    out.push(copy(view("-lc")));
    return out;
}
// ---- split assembly (B1 stage 1) ----
// With `--split` the compiler writes one assembly file per module plus OUT.parts, which lists them
// in link order and carries the `// grail-link:` request a single-file build puts at the head of
// its assembly. The parts are assembled concurrently and linked once.
struct Split {
    asm: u8[][],
    objects: u8[][],
    link: u8[][]
}
fn with_object_ext<a>(path: &a [u8]) -> u8[] {
    mut n = path.len();
    if (n > 1) & (path[n - 1] == 115) & (path[n - 2] == 46) {
        n = n - 2;
    }
    mut out = u8[];
    for i in n {
        out.push(path[i]);
    }
    push_bytes(&mut out, view(".o"));
    return out;
}
fn read_split<a, b>(manifest: &a [u8], base: &b [u8]) -> Split {
    text := host::read_file(view(manifest));
    mut parts = u8[][];
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        if (row.len() != 0) & !starts(view(row), view("//")) {
            parts.push(copy(view(row)));
        }
    }
    mut objects = u8[][];
    for i in parts.len() {
        part := item(&parts, i);
        objects.push(with_object_ext(view(part)));
    }
    return Split { asm: parts, objects: objects, link: link_inputs(view(manifest), view(base)) };
}
// Quote one argument for `sh -c`: single quotes keep every byte except a quote itself, which the
// usual close-escape-reopen sequence carries.
fn sh_word<a, b>(out: (&a mut u8[]), word: &b [u8]) -> unit {
    out.push(39);
    for i in word.len() {
        b := word[i];
        if b == 39 {
            out.push(39);
            out.push(92);
            out.push(39);
            out.push(39);
        } else {
            out.push(b);
        }
    }
    out.push(39);
    return ();
}
// Assemble every part at once: one assembler process per part, waited on together, so a build with
// many modules pays for the slowest one instead of their sum. The driver has no process API of its
// own, so the parallelism comes from the shell; a failure in any part fails the build.
fn assemble_parts<a, b, d>(prefix: (&a u8[][]), parts: (&b u8[][]), objects: (&d u8[][])) -> u64 {
    mut script = u8[];
    push_bytes(&mut script, view("set -e\npids=''\n"));
    for i in parts.len() {
        for j in prefix.len() {
            word := item(&prefix, j);
            sh_word(&mut script, view(word));
            script.push(32);
        }
        source := item(&parts, i);
        object := item(&objects, i);
        sh_word(&mut script, view(source));
        push_bytes(&mut script, view(" -o "));
        sh_word(&mut script, view(object));
        push_bytes(&mut script, view(" &\npids=\"$pids $!\"\n"));
    }
    push_bytes(&mut script, view("for p in $pids; do wait \"$p\" || exit 1; done\n"));
    mut command = u8[][copy(view("sh")), copy(view("-c")), script];
    return host::command(command);
}
// A --check build removes what the compiler wrote instead of publishing it.
fn remove_split<a>(output: &a [u8]) -> unit {
    manifest := cat(view(output), view(".parts"));
    text := host::read_file(view(manifest));
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        if (row.len() != 0) & !starts(view(row), view("//")) {
            host::remove(view(row), 0);
        }
    }
    host::remove(view(manifest), 0);
    return ();
}
fn target_name(t: u64) -> u8[] {
    if t == 1 {
        return copy(view("aarch64"));
    }
    if t == 2 {
        return copy(view("riscv64"));
    }
    return copy(view("x86_64"));
}
// The platform module a target is built with, as a file name next to runtime.grl.
fn platform_module<a>(target: &a [u8]) -> u8[] {
    if is_macho(view(target)) {
        return copy(view("darwin.grl"));
    }
    if starts(view(target), view("windows")) {
        return copy(view("os-windows.grl"));
    }
    return copy(view("os-linux.grl"));
}
// Mach-O targets compile the darwin module, which owns every libSystem call.
fn is_macho<a>(target: &a [u8]) -> bool {
    return eq(view(target), view("macos-x86_64")) || eq(view(target), view("macos-aarch64"));
}

// ---- Windows (PE/COFF) linking ----------------------------------------------------------------
// The image needs one import descriptor per Win32 entry point it calls, and lld-link builds those
// from COFF short-import objects - what an import library (.lib) is a collection of. The compiler
// already names every pair: `// grail-link: import DLL SYMBOL`, so the driver writes the objects
// itself and no Visual Studio, Windows SDK or checked-in .lib is needed. LLVM alone is enough:
// clang assembles, lld-link links.
fn push_le16<a>(out: (&a mut u8[]), v: u64) -> unit {
    out.push(v % 256);
    out.push((v / 256) % 256);
    return ();
}
fn push_le32<a>(out: (&a mut u8[]), v: u64) -> unit {
    out.push(v % 256);
    out.push((v / 256) % 256);
    out.push((v / 65536) % 256);
    out.push((v / 16777216) % 256);
    return ();
}
// One 20-byte COFF short import: the header lld reads, then "SYMBOL\0DLL.DLL\0".
fn pe_short_import<a, b>(dll: &a [u8], symbol: &b [u8]) -> u8[] {
    mut out = u8[];
    push_le16(&mut out, 0); // Sig1
    push_le16(&mut out, 65535); // Sig2: 0xFFFF marks a short import
    push_le16(&mut out, 0); // Version
    push_le16(&mut out, 34404); // Machine: IMAGE_FILE_MACHINE_AMD64
    push_le32(&mut out, 0); // TimeDateStamp
    push_le32(&mut out, symbol.len() + dll.len() + 6); // SizeOfData
    push_le16(&mut out, 0); // Ordinal/hint
    push_le16(&mut out, 4); // IMPORT_NAME_NOPREFIX
    for i in symbol.len() {
        out.push(symbol[i]);
    }
    out.push(0);
    for i in dll.len() {
        out.push(dll[i]);
    }
    // The import descriptor names a file: the DLL's own name, with the extension Win32 loads.
    out.push(46); // '.'
    out.push(100); // 'd'
    out.push(108); // 'l'
    out.push(108); // 'l'
    out.push(0);
    return out;
}
// Every `// grail-link: import DLL SYMBOL` note of one assembly file as a short-import object, in
// the order the notes appear. The compiler emits one note per entry point, so there is nothing to
// deduplicate here.
fn windows_imports<a, b>(asm: &a [u8], dir: &b [u8]) -> u8[][] {
    text := host::read_file(view(asm));
    prefix := "// grail-link: import ";
    mut out = u8[][];
    mut start: u64 = 0;
    mut i: u64 = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut line = u8[];
            for j in i - start {
                line.push(text[start + j]);
            }
            if starts(view(line), view(prefix)) {
                mut cut = line.len();
                for k in line.len() {
                    if (line[k] == 32) && (prefix.len() <= k) {
                        cut = k;
                        break;
                    }
                }
                dll := (line[prefix.len(): cut]).copy();
                mut symbol = u8[];
                for k in line.len() - (cut + 1) {
                    ch := line[cut + 1 + k];
                    if (ch != 32) && (ch != 13) {
                        symbol.push(ch);
                    }
                }
                image := pe_short_import(view(dll), view(symbol));
                path := path_join(view(dir), cat(cat(view("imp-"), view(symbol)), view(".obj")));
                host::write_file(view(path), view(image));
                out.push(path);
            }
            start = i + 1;
        }
        i += 1;
    }
    return out;
}
// The short-import objects as the archive lld-link takes them in: a standalone import object is
// refused ("not a COFF file"), while a member of an archive is read as an import. That archive is
// what an import library is, and llvm-ar writes it, so the toolchain stays LLVM-only.
fn import_library<a, b>(dir: &a [u8], objects: (&b u8[][])) -> u8[] {
    lib := path_join(view(dir), view("imports.lib"));
    host::remove(view(lib), 0);
    mut argv = u8[][tool(view("GRAIL_AR"), view("llvm-ar")), copy(view("rcs")), copy(view(lib))];
    for i in objects.len() {
        argv.push(item(objects, i));
    }
    if host::command(argv) != 0 {
        say(view("grail: cannot write the import library (needs llvm-ar, which ships with LLVM)"));
        return u8[];
    }
    return lib;
}
// The PE link: lld-link with the entry the compiler defines, no CRT, and the stack reserve a
// recursively written program needs (Windows gives a thread 1 MiB by default, Linux 8).
fn windows_link<a, b, d, e>(
    asm: &a [u8],
    output: &b [u8],
    object: &d [u8],
    entry: &e [u8],
    debug: u64
) -> u64 {
    dir := path_join(view(dirname(view(object))), view(".grail-win"));
    host::mkdir(view(dir));
    imports := windows_imports(view(asm), view(dir));
    mut link = u8[][
        tool(view("GRAIL_WIN_LINKER"), view("lld-link")),
        copy(view("/nologo")),
        copy(view("/machine:x64")),
        copy(view("/entry:grail_entry")),
        copy(view("/subsystem:console")),
        copy(view("/nodefaultlib")),
        copy(view("/dynamicbase")),
        copy(view("/nxcompat")),
        copy(view("/stack:8388608"))
    ];
    if debug != 0 {
        link.push(copy(view("/debug")));
        link.push(cat(view("/pdb:"), view(output)));
    }
    link.push(cat(view("/out:"), view(output)));
    link.push(copy(view(object)));
    if imports.len() != 0 {
        link.push(import_library(view(dir), &imports));
    }
    inputs := link_inputs(view(asm), view(dirname(view(entry))));
    for i in inputs.len() {
        link.push(item(&inputs, i));
    }
    if host::command(link) != 0 {
        say(view("grail: linking failed (needs lld-link, which ships with LLVM)"));
        return 1;
    }
    return 0;
}
fn put<a, b>(out: (&a mut u8[]), text: &b [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
    return ();
}
// The undefined C symbols of one object, exactly as the linker sees them: `nm -u` prints one per
// line. The shell passes the two paths as positional parameters, so a directory with a space in it
// is just a path here, and GRAIL_NM names the nm to use, as tools/native.mjs does. Returns 0 when
// the list was written.
fn macho_undefined<a, b>(object: &a [u8], out: &b [u8]) -> u64 {
    script := "nm=${GRAIL_NM:-llvm-nm}; \"$nm\" -u \"$1\" > \"$2\"";
    mut argv = u8[][
        copy(view("sh")),
        copy(view("-c")),
        copy(view(script)),
        copy(view("sh")),
        copy(view(object)),
        copy(view(out))
    ];
    return host::command(argv);
}
// A macOS link without an SDK: ld64.lld needs a libSystem, and a text-based stub that exports the C
// symbols the object leaves undefined is the whole of what a cross-link needs - the same linkage
// scaffolding tools/macos.mjs builds. The image still records the real /usr/lib/libSystem.B.dylib
// dependency, so a program linked here is inspected (and released) like a native one. Writes
// <object dir>/.grail-macos/libSystem.tbd and returns that directory, or nothing when the object
// has no imports to export or no nm could be run.
fn macho_libsystem<a, b, d>(object: &a [u8], arch: &b [u8], asm: &d [u8]) -> u8[] {
    dir := path_join(view(dirname(view(object))), view(".grail-macos"));
    host::mkdir(view(dir));
    names := path_join(view(dir), view("undefined"));
    if macho_undefined(view(object), view(names)) != 0 {
        return u8[];
    }
    text := host::read_file(view(names));
    host::remove(view(names), 0);
    mut symbols = u8[];
    mut count = 0;
    mut start: u64 = 0;
    mut i: u64 = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut name = u8[];
            for j in i - start {
                ch := text[start + j];
                if ch != 13 {
                    name.push(ch);
                }
            }
            if name.len() != 0 {
                if count != 0 {
                    symbols.push(44);
                    symbols.push(32);
                }
                put(&mut symbols, view(name));
                count += 1;
            }
            start = i + 1;
        }
        i += 1;
    }
    if count == 0 {
        return u8[];
    }
    // The binder is the one symbol every Mach-O image needs and no object names.
    put(&mut symbols, view(", dyld_stub_binder"));
    platform := cat(view(arch), view("-macos"));
    mut body = u8[];
    put(&mut body, view("--- !tapi-tbd\ntbd-version: 4\ntargets: [ "));
    put(&mut body, view(platform));
    put(
        &mut body,
        view(
            " ]\ninstall-name: '/usr/lib/libSystem.B.dylib'\ncurrent-version: 1311\nexports:\n  - targets: [ "
        )
    );
    put(&mut body, view(platform));
    put(&mut body, view(" ]\n    symbols: [ "));
    put(&mut body, view(symbols));
    put(&mut body, view(" ]\n...\n"));
    stub := path_join(view(dir), view("libSystem.tbd"));
    host::write_file(view(stub), view(body));
    return dir;
}
fn tool<a, b>(variable: &a [u8], fallback: &b [u8]) -> u8[] {
    v := host::env(variable);
    if v.len() != 0 {
        return v;
    }
    return copy(fallback);
}
fn compile<a, b, d, e, g, k>(
    h: (&a Home),
    entry: &b [u8],
    modules: (&d u8[][]),
    output: &e [u8],
    target: &g [u8],
    flags: u64,
    iface: &d [u8] = view(""),
    verify: u64 = 0,
    diag: &k [u8] = view(""),
    force_emit: bool = false,
    no_entry: bool = false,
    inputs: &e [u8] = view("")
) -> u64 {
    return compile_mode(
        h: h,
        entry: entry,
        modules: modules,
        output: output,
        target: target,
        flags: flags,
        iface: iface,
        verify: verify,
        diag: diag,
        force_emit: force_emit,
        no_entry: no_entry,
        inputs: inputs
    );
}
// The compiler invocation, spelled out in one place: the build cache keys on this vector, so a flag
// or an input that the driver passes is in the key by construction and cannot be forgotten there.
//   grail [--target T] [--debug] [--deny-ambient-host] [--split] [--overflow=...]
//         [--interface DIR [--verify-interface]] OUT.s ENTRY.grl MODULE.grl... RUNTIME PLATFORM
fn build_argv<a, b, d, e, g, k>(
    h: (&a Home),
    entry: &b [u8],
    modules: (&d u8[][]),
    asm: &e [u8],
    target: &g [u8],
    flags: u64,
    iface: &d [u8] = view(""),
    verify: u64 = 0,
    diag: &k [u8] = view(""),
    force_emit: bool = false,
    no_entry: bool = false,
    inputs: &d [u8] = view("")
) -> u8[][] {
    check_only := flags % 2;
    debug := (flags / 2) % 2;
    deny := (flags / 4) % 2;
    split := (flags / 8) % 2;
    wrap := (flags / 16) % 2;
    checked := (flags / 32) % 2;
    no_sites := (flags / 256) % 2;
    verify_facts := (flags / 512) % 2;
    strict := (flags / 1024) % 2;
    emit_ir := (flags / 2048) % 2;
    mut command = u8[][host::exe_path(), copy(view("--target")), copy(view(target))];
    if strict != 0 {
        command.push(copy(view("--strict-refinements")));
    }
    if emit_ir != 0 {
        command.push(copy(view("--emit-ir")));
    }
    if no_sites != 0 {
        command.push(copy(view("--no-error-sites")));
    }
    if verify_facts != 0 {
        command.push(copy(view("--verify-facts")));
    }
    if debug != 0 {
        command.push(copy(view("--debug")));
    }
    if deny != 0 {
        command.push(copy(view("--deny-ambient-host")));
    }
    if split != 0 {
        command.push(copy(view("--split")));
    }
    if wrap != 0 {
        command.push(copy(view("--overflow=wrap")));
    }
    if checked != 0 {
        command.push(copy(view("--overflow=checked")));
    }
    // B1 stage 2: `grail check --interface DIR` writes the interfaces, `grail build --interface DIR`
    // reads them instead of the modules' sources, and `--verify` compares the two.
    if no_entry {
        command.push(copy(view("--no-entry")));
    }

    if iface.len() != 0 {
        mut emit = u64(check_only != 0) * u64(verify == 0);
        if force_emit {
            emit = 1;
        }
        if emit != 0 {
            command.push(copy(view("--emit-interface")));
        } else {
            command.push(copy(view("--interface")));
        }
        command.push(copy(view(iface)));
        if (emit == 0) & (verify != 0) {
            command.push(copy(view("--verify-interface")));
        }
    }
    // A driver that asked for records gets them as well as a human-readable rendering:
    // `--diagnostics-json FILE` appends one JSON object per diagnostic there and prints nothing.
    if diag.len() != 0 {
        command.push(copy(view("--diagnostics-json")));
        command.push(copy(view(diag)));
    }
    // The modules the program reaches through `use` are the compiler's to resolve: a module root is
    // the directory it looks for `ROOT/NAME.grl` in (docs/design/module-resolution.md). The stdlib is
    // a root here, so `use fs;` is enough to build against it; a project's own `src/` is a root the
    // compiler takes from the grail.toml it finds in the working directory.
    // A root named on the command line comes before the stdlib's, so a project can shadow a std
    // module by name; among themselves they keep the order given and the first root that holds a
    // module wins. The probe and the compile are both built here, so they cannot disagree.
    for i in h.roots.len() {
        command.push(copy(view("--module-root")));
        command.push(item(&h.roots, i));
    }
    if h.std.len() != 0 {
        command.push(copy(view("--module-root")));
        command.push(copy(view(h.std)));
    }
    command.push(copy(view(asm)));
    command.push(copy(view(entry)));
    for i in modules.len() {
        command.push(item(&modules, i));
    }
    command.push(copy(view(h.runtime)));
    // One platform module per target, and the target decides which: darwin.grl owns the libSystem
    // boundary, os-windows.grl the Win32 one, os-linux.grl the Linux syscalls. They define the same
    // rt_syscall* set, so only one may be compiled. Choosing by target is what lets a Linux host
    // build a Windows or macOS program, and a Windows host native ones.
    command.push(path_join(view(dirname(view(h.runtime))), view(platform_module(view(target)))));
    return command;
}
// True when the entry or any module source mentions `@embed(`.
fn sources_embed<a, b>(entry: &a [u8], modules: (&b u8[][])) -> bool {
    mut files = u8[][copy(view(entry))];
    for i in modules.len() {
        files.push(item(&modules, i));
    }
    needle := "@embed(";
    for f in files.len() {
        path := item(&files, f);
        if host::exists(view(path)) == 0 {
            continue;
        }
        text := host::read_file(view(path));
        mut i = 0;
        while i + needle.len() <= text.len() {
            mut hit = true;
            for j in needle.len() {
                if text[i + j] != needle[j] {
                    hit = false;
                    break;
                }
            }
            if hit {
                return true;
            }
            i += 1;
        }
    }
    return false;
}
// check_only: type-check and generate code, but do not assemble or link.
fn compile_mode<a, b, d, e, g, k>(
    h: (&a Home),
    entry: &b [u8],
    modules: (&d u8[][]),
    output: &e [u8],
    target: &g [u8],
    flags: u64,
    iface: &d [u8] = view(""),
    verify: u64 = 0,
    diag: &k [u8] = view(""),
    force_emit: bool = false,
    no_entry: bool = false,
    inputs: &e [u8] = view("")
) -> u64 {
    check_only := flags % 2;
    debug := (flags / 2) % 2;
    deny := (flags / 4) % 2;
    split := (flags / 8) % 2;
    wrap := (flags / 16) % 2;
    checked := (flags / 32) % 2;
    mut cache = (flags / 64) % 2;
    whole := (flags / 128) % 2;
    if (cache != 0) && sources_embed(view(entry), &modules) {
        // `@embed` reads a file the cache does not key on, so its result cannot be reused safely.
        say(
            view(
                "grail: --cache is skipped: a source uses @embed, whose file the cache does not track"
            )
        );
        cache = 0;
    }
    asm := cat(view(output), view(".s"));
    object := cat(view(output), view(".o"));
    // The toolchain is decided by the target alone, so it is known before the compiler runs - which
    // is what lets a build cache key on the assembler and the linker as well as on the sources.
    mut triple = copy(view("--target=x86_64-linux-gnu"));
    mut emulation = copy(view("elf_x86_64"));
    // Mach-O targets reuse the CPU backends but have their own object format and linker.
    mut macho = 0;
    mut arch = copy(view("x86_64"));
    if eq(view(target), view("macos-x86_64")) {
        triple = copy(view("--target=x86_64-apple-macos11"));
        macho = 1;
    }
    if eq(view(target), view("macos-aarch64")) {
        triple = copy(view("--target=arm64-apple-macos11"));
        arch = copy(view("arm64"));
        macho = 1;
    }
    if eq(view(target), view("aarch64")) {
        triple = copy(view("--target=aarch64-linux-gnu"));
        emulation = copy(view("aarch64elf"));
    }
    // A PE/COFF object is not an ELF one: the assembler has to be told which object format to
    // write, and the link below is lld-link's, not ld.lld's.
    mut pe = 0;
    if eq(view(target), view("windows-x86_64")) {
        triple = copy(view("--target=x86_64-pc-windows-msvc"));
        pe = 1;
    }
    mut assemble = u8[][tool(view("GRAIL_ASSEMBLER"), view("clang"))];
    if eq(view(target), view("riscv64")) {
        triple = copy(view("--target=riscv64-linux-gnu"));
        emulation = copy(view("elf64lriscv"));
        assemble.push(copy(view("-march=rv64imafd")));
        assemble.push(copy(view("-mabi=lp64d")));
    }
    assemble.push(triple);
    assemble.push(copy(view("-c")));
    command := build_argv(
        h: &h,
        entry: view(entry),
        modules: &modules,
        asm: view(asm),
        target: view(target),
        flags: flags,
        iface: iface,
        verify: verify,
        diag: diag,
        force_emit: force_emit,
        no_entry: no_entry,
        inputs: inputs
    );
    if inputs.len() != 0 {
        // `--print-inputs FILE` is the resolution oracle: the same command runs once more with the
        // flag, writes the module set it settled, and stops before assembling. The build below is
        // the ordinary command, so a caller can ask what a build resolved and still get the build.
        probe := build_argv(
            h: &h,
            entry: view(entry),
            modules: &modules,
            asm: view(asm),
            target: view(target),
            flags: flags,
            iface: iface,
            verify: verify,
            diag: diag,
            force_emit: force_emit,
            no_entry: no_entry,
            inputs: inputs
        );
        host::command(probe);
    }
    // The shape of the build. A program of more than one module of its own is built one compiler run
    // per module, each reading the interfaces the runs before it wrote (B1 stage 4). `--whole-program`
    // and `--split` ask for the one-run shapes, an `--interface` build checks every module against its
    // interface in one run, a check-only run needs no code, and the modules are what the cache reuses,
    // so `--cache` asks for them too. Beyond the Linux targets there is no per-module object path, so
    // those targets build the whole program.
    mut per_module = 0;
    mut groups = ModuleGroup[];
    at := source_start(&command, view(asm));
    if (whole == 0)
        & (split == 0)
        & (check_only == 0)
        & (iface.len() == 0)
        & (at < command.len())
        & linux_target(view(target)) {
        groups = source_groups(&command, at);
        if (cache != 0) || (program_modules(&groups) > 1) {
            per_module = 1;
        }
        // `@no_alloc` and `@no_panic` are proved over every body the program can reach, the runtime's
        // included, so a program that claims them is compiled in one run.
        if effects_claimed(&command, at) {
            per_module = 0;
        }
        if per_module != 0 {
            // One run per module, so every module the program has needs a group, and the module set is
            // the compiler's: it resolves `use` through the roots and names what it will compile.
            groups = resolved_groups(&command, at, view(cat(view(asm), view(".inputs"))));
            if groups.len() == 0 {
                return 1;
            }
            if (cache == 0) & (program_modules(&groups) < 2) {
                // Resolution settled a program of one module (a lone entry that uses std modules):
                // that is one compiler run, not a per-module build, so nothing is split into parts.
                per_module = 0;
            }
        }
    }
    // B1 stage 4: an unchanged program is not rebuilt at all, and what is rebuilt assembles and links
    // through the content-addressed store. Without --cache nothing below changes a thing.
    mut store = Cache {
        root: cache_root(view(target)),
        fast: 0,
        tmp: u8[],
        hits: 0,
        misses: 0,
        names: u8[][],
    };
    mut id = BuildId {
        flags: u8[],
        compiler: u8[],
        assembler: u8[],
        linker: u8[],
        ifaces: u8[],
        iface_dir: u8[],
        sources: u8[][],
        digests: u8[][],
    };
    mut program = u8[];
    if cache != 0 {
        store.fast = cache_hash_tool();
        stage := cache_stage(&mut store);
        store.tmp = path_join(view(stage), view("digest"));
        cache_ensure(&mut store);
        id = cache_build_id(&mut store, &command, view(asm), view(emulation), &assemble);
        program = cache_program_key(&mut store, &id, view(target), view(asm));
        // `--verify` asks for the interfaces to be checked against the sources, and `--check` asks for
        // the program to be checked at all: a build that skips the compiler run has to skip the
        // shortcut instead.
        if (verify == 0) & (check_only == 0) {
            if cache_up_to_date(&mut store, view(program), view(output)) == 1 {
                return 0;
            }
        }
    }
    if per_module != 0 {
        return per_module_build(
            &command,
            at,
            &mut groups,
            view(output),
            view(target),
            view(emulation),
            &assemble,
            &mut store,
            &id,
            view(program),
            cache
        );
    }
    if host::command(command) != 0 {
        return 1;
    }
    if check_only != 0 {
        if split != 0 {
            remove_split(view(output));
        } else {
            host::remove(view(asm), 0);
        }
        return 0;
    }
    if split != 0 {
        if cache != 0 {
            return cache_split(
                &mut store,
                &id,
                view(dirname(view(entry))),
                view(output),
                view(target),
                view(emulation),
                &assemble,
                view(program)
            );
        }
        return build_split(
            view(dirname(view(entry))),
            view(output),
            view(target),
            view(emulation),
            &assemble
        );
    }
    assemble.push(copy(view(asm)));
    assemble.push(copy(view("-o")));
    assemble.push(copy(view(object)));
    if host::command(assemble) != 0 {
        say(view("grail: assembling failed (needs clang)"));
        return 1;
    }
    if pe != 0 {
        return windows_link(view(asm), view(output), view(object), view(entry), debug);
    }
    if macho != 0 {
        mut link = u8[][
            tool(view("GRAIL_LINKER"), view("ld64.lld")),
            copy(view("-arch")),
            copy(view(arch)),
            copy(view("-platform_version")),
            copy(view("macos")),
            copy(view("11.0")),
            copy(view("11.0"))
        ];
        sdk := host::env(view("GRAIL_SDK"));
        if sdk.len() != 0 {
            libs := path_join(view(sdk), view("usr/lib"));
            link.push(copy(view("-syslibroot")));
            link.push(copy(view(sdk)));
            link.push(cat(view("-L"), view(libs)));
            link.push(copy(view("-lSystem")));
        } else {
            // No SDK on this host: the stub stands in for libSystem (see macho_libsystem).
            stub := macho_libsystem(view(object), view(arch), view(asm));
            if stub.len() == 0 {
                say(
                    view(
                        "grail: the Mach-O object is assembled, but no libSystem to link it against"
                    )
                );
                say(view("grail: set GRAIL_SDK to a macOS SDK, or put llvm-nm on PATH"));
                return 1;
            }
            link.push(cat(view("-L"), view(stub)));
            link.push(copy(view("-lSystem")));
        }
        link.push(copy(view("-e")));
        link.push(copy(view("_main")));
        link.push(copy(view(object)));
        link.push(copy(view("-o")));
        link.push(copy(view(output)));
        inputs := link_inputs(view(asm), view(dirname(view(entry))));
        for i in inputs.len() {
            link.push(item(&inputs, i));
        }
        if host::command(link) != 0 {
            say(view("grail: linking failed (needs ld64.lld, and an SDK or llvm-nm)"));
            return 1;
        }
        return 0;
    }
    mut link = u8[][
        tool(view("GRAIL_LINKER"), view("ld.lld")),
        copy(view("-m")),
        emulation,
        copy(view(object))
    ];
    inputs := link_inputs(view(asm), view(dirname(view(entry))));
    for i in inputs.len() {
        link.push(item(&inputs, i));
    }
    dynamic := dynamic_link_flags(view(target), &inputs);
    for i in dynamic.len() {
        link.push(item(&dynamic, i));
    }
    link.push(copy(view("-o")));
    link.push(copy(view(output)));
    if host::command(link) != 0 {
        say(view("grail: linking failed (needs ld.lld)"));
        return 1;
    }
    return 0;
}
// A --split build: the compiler already wrote one assembly file per module and the manifest that
// lists them; assemble them concurrently and link them once, in manifest order.
fn build_split<a, b, d, e, g>(
    base: &a [u8],
    output: &b [u8],
    target: &d [u8],
    emulation: &e [u8],
    prefix: (&g u8[][])
) -> u64 {
    if is_macho(view(target)) {
        say(view("grail: --split is implemented for the Linux x86_64 assembler path"));
        return 1;
    }
    manifest := cat(view(output), view(".parts"));
    text := host::read_file(view(manifest));
    if !starts(view(text), view("// grail-parts 1")) {
        say(view("grail: missing or unreadable parts manifest "));
        say(view(manifest));
        return 1;
    }
    parts := read_split(view(manifest), view(base));
    if parts.asm.len() == 0 {
        say(view("grail: the parts manifest lists no modules"));
        return 1;
    }
    if assemble_parts(&prefix, &parts.asm, &parts.objects) != 0 {
        say(view("grail: assembling failed (needs clang)"));
        return 1;
    }
    return link_objects(view(output), view(target), view(emulation), &parts.objects, &parts.link);
}
// ---- B1 stage 4: one compiler invocation per module (`grail build --per-module`) ----
// The program's sources are grouped by the module each declares; the groups are compiled in
// dependency order, each by its own compiler run that reads only the interfaces of modules built
// before it and writes its own interface beside them, then every run's parts are assembled and the
// program is linked once. A module's run parses that module's source and no other.
struct ModuleGroup {
    name: u8[],
    files: u8[][],
    uses: u8[][],
    done: u64
}
fn ident_byte(c: u8) -> bool {
    return ((c >= 97) & (c <= 122))
        || ((c >= 65) & (c <= 90))
        || ((c >= 48) & (c <= 57))
        || (c == 95);
}
// The word after each line-leading `keyword` of a source file (`module NAME;`, `use NAME;`).
fn scan_words<a, b>(path: &a [u8], keyword: &b [u8]) -> u8[][] {
    text := host::read_file(view(path));
    mut out = u8[][];
    mut i = 0;
    while i < text.len() {
        while (i < text.len()) && ((text[i] == 32) || (text[i] == 9) || (text[i] == 13)) {
            i += 1;
        }
        mut word = u8[];
        while (i < text.len()) && ident_byte(text[i]) {
            word.push(text[i]);
            i += 1;
        }
        if eq(view(word), view(keyword)) {
            while (i < text.len()) && ((text[i] == 32) || (text[i] == 9)) {
                i += 1;
            }
            mut name = u8[];
            while (i < text.len()) && ident_byte(text[i]) {
                name.push(text[i]);
                i += 1;
            }
            if name.len() != 0 {
                out.push(name);
            }
        }
        while (i < text.len()) && (text[i] != 10) {
            i += 1;
        }
        i += 1;
    }
    return out;
}
fn group_of<a, b>(groups: (&a ModuleGroup[]), name: &b [u8]) -> u64 {
    for i in groups.len() {
        if eq(view(groups[i].name), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
// Where a build command's sources start: the output assembly file comes before them.
fn source_start<a, b>(command: (&a u8[][]), asm: &b [u8]) -> u64 {
    mut at = 0;
    while (at < command.len()) && !eq(view(item(&command, at)), view(asm)) {
        at += 1;
    }
    return at;
}
// The command's sources grouped by the module each declares. The runtime and platform files come
// last in every build command and declare no module: the compiler treats them as module `runtime`,
// the base every module's code calls into, so that group is built first. Any other file without a
// `module` line is the entry's, module `main`.
fn source_groups<a>(command: (&a u8[][]), at: u64) -> ModuleGroup[] {
    mut groups = ModuleGroup[];
    count := command.len() - at - 1;
    for j in count {
        file := item(&command, at + 1 + j);
        names := scan_words(view(file), view("module"));
        mut name = copy(view("main"));
        if count - 2 <= j {
            name = copy(view("runtime"));
        }
        if names.len() != 0 {
            name = item(&names, 0);
        }
        uses := scan_words(view(file), view("use"));
        g := group_of(&groups, view(name));
        if g == 0 {
            groups.push(ModuleGroup { name: name, files: u8[][file], uses: uses, done: 0 });
        } else {
            groups[g - 1].files.push(file);
            for u in uses.len() {
                groups[g - 1].uses.push(item(&uses, u));
            }
        }
    }
    return groups;
}
// The modules the build will really compile, as the compiler settles them: the entry, the modules named
// on the command line, the runtime and platform files, and everything the `use` lines reached through a
// module root (docs/design/module-resolution.md). The driver asks (`--print-inputs FILE`) rather than
// scanning for a module set of its own, so a per-module build has a group for every module the program
// has - including the standard ones - and no unit is compiled twice.
fn resolved_groups<a>(command: (&a u8[][]), at: u64, list: &a [u8]) -> ModuleGroup[] {
    mut probe = u8[][];
    for i in at {
        probe.push(item(&command, i));
    }
    probe.push(copy(view("--print-inputs")));
    probe.push(copy(view(list)));
    for i in command.len() - at {
        probe.push(item(&command, at + i));
    }
    mut groups = ModuleGroup[];
    if host::command(probe) != 0 {
        // The compiler printed why (an unresolvable `use` names the module and the roots it searched).
        return groups;
    }
    text := host::read_file(view(list));
    host::remove(view(list), 0);
    mut start = 0;
    mut i = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut cut = start;
            while cut < i {
                if text[cut] == 9 {
                    break;
                }
                cut += 1;
            }
            if (cut < i) & (cut > start) {
                mut name = u8[];
                for j in start..cut {
                    name.push(text[j]);
                }
                mut path = u8[];
                for j in cut + 1..i {
                    path.push(text[j]);
                }
                uses := scan_words(view(path), view("use"));
                g := group_of(&groups, view(name));
                if g == 0 {
                    groups.push(ModuleGroup { name: name, files: u8[][path], uses: uses, done: 0 });
                } else {
                    groups[g - 1].files.push(path);
                    for u in uses.len() {
                        groups[g - 1].uses.push(item(&uses, u));
                    }
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    // `core` is a dependency of every module, with no `use` line to say so: `Some(value)` and `None`
    // lower to its constructors, so a unit compiled before it looks up `some` in a module nothing
    // has declared yet ("unknown function `some` in `core`", in whichever module first writes one).
    // `core` has dependencies of its own - it `use`s `result`, whose `Option` is the type `T?` names
    // - and those are the bottom of the order rather than a cycle, so they are the prelude: built
    // before `core`, and the only modules that do not get the implicit dependency.
    if group_of(&groups, view("core")) != 0 {
        mut prelude = u8[][copy(view("core"))];
        mut k = 0;
        while k < prelude.len() {
            here := prelude[k].copy();
            k += 1;
            at := group_of(&groups, view(here));
            if at == 0 {
                continue;
            }
            for u in groups[at - 1].uses.len() {
                used := groups[at - 1].uses[u].copy();
                mut have = 0;
                for i in prelude.len() {
                    if eq(view(prelude[i]), view(used)) {
                        have = 1;
                    }
                }
                if have == 0 {
                    prelude.push(used);
                }
            }
        }
        for g in groups.len() {
            name := groups[g].name.copy();
            mut in_prelude = 0;
            for i in prelude.len() {
                if eq(view(prelude[i]), view(name)) {
                    in_prelude = 1;
                }
            }
            if (in_prelude == 0) & !eq(view(name), view("runtime")) {
                groups[g].uses.push(copy(view("core")));
            }
        }
    }
    return groups;
}
// The program's own modules. The runtime and platform files are the base group every program has,
// and the standard library's core prelude is compiled whether a module names it or not, so neither
// makes a program multi-module: what is left is what the program is made of.
fn program_modules<a>(groups: (&a ModuleGroup[])) -> u64 {
    mut n = groups.len();
    if group_of(&groups, view("runtime")) != 0 {
        n -= 1;
    }
    if group_of(&groups, view("core")) != 0 {
        n -= 1;
    }
    return n;
}
// The Linux ELF targets: the ones a program build makes separate objects for and links with ld.lld.
fn linux_target<a>(target: &a [u8]) -> bool {
    return !is_macho(view(target)) && !starts(view(target), view("windows"));
}
fn bytes_less<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    mut i = 0;
    while (i < x.len()) & (i < y.len()) {
        if x[i] != y[i] {
            return x[i] < y[i];
        }
        i += 1;
    }
    return x.len() < y.len();
}
// The cache key of one module's compiler run (B1 stage 4): the build's flags, compiler and assembler,
// the target, the module's name and its own source files, and every interface the run can read - the
// ones written by the runs before it, by name and content. An edit that leaves a module's interface
// unchanged therefore reruns that module alone; one that changes it reruns the modules after it.
fn unit_key<a, b, d, e, g, k>(
    store: (&a mut Cache),
    id: (&b BuildId),
    target: &d [u8],
    name: &e [u8],
    files: (&g u8[][]),
    ifaces: &k [u8]
) -> u8[] {
    mut buf = u8[];
    push_bytes(&mut buf, view("grail-cache-unit 1\ntarget "));
    push_bytes(&mut buf, view(target));
    push_bytes(&mut buf, view("\nflags "));
    push_bytes(&mut buf, view(id.flags));
    push_bytes(&mut buf, view("\ncompiler "));
    push_bytes(&mut buf, view(id.compiler));
    push_bytes(&mut buf, view("\nassembler "));
    push_bytes(&mut buf, view(id.assembler));
    push_bytes(&mut buf, view("\nmodule "));
    push_bytes(&mut buf, view(name));
    buf.push(10);
    for i in files.len() {
        f := item(&files, i);
        push_bytes(&mut buf, view("source "));
        push_bytes(&mut buf, view(cache_digest_file(&mut store, view(f))));
        buf.push(32);
        push_bytes(&mut buf, view(f));
        buf.push(10);
    }
    mut names = u8[][];
    listed := host::list_dir(view(ifaces));
    for i in listed.len() {
        n := item(&listed, i);
        if ends(view(n), view(".iface")) {
            mut at = names.len();
            while (0 < at) && bytes_less(view(n), view(names[at - 1])) {
                at -= 1;
            }
            names.insert(at, n);
        }
    }
    for i in names.len() {
        n := item(&names, i);
        // An interface's surface: every byte before the trailer, which carries only the source
        // digest and the file's own digest. An edit that keeps the surface keeps every other
        // module's key.
        text := host::read_file(view(path_join(view(ifaces), view(n))));
        surface := native::iface_surface(view(text));
        push_bytes(&mut buf, view("interface "));
        push_bytes(&mut buf, view(native::iface_digest(&surface)));
        buf.push(32);
        push_bytes(&mut buf, view(n));
        buf.push(10);
    }
    return native::iface_digest(&buf);
}
// Put a module run's outputs back from the store: its object, the link inputs its own sources ask
// for, and its interface. Any missing or damaged blob makes it a miss (nothing is half-restored that
// a later step would trust: the run that follows rewrites all of it).
fn unit_restore<a, b, d, e, g>(
    store: (&a mut Cache),
    key: &b [u8],
    stem: &d [u8],
    ifaces: &e [u8],
    name: &g [u8]
) -> bool {
    path := cache_record_path(view(store.root), view("unit"), view(key));
    if host::exists(view(path)) == 0 {
        return false;
    }
    cache_touch(view(store.root), view("unit"), view(key));
    text := host::read_file(view(path));
    rows := lines(view(text));
    mut links_blob = u8[];
    mut obj_blob = u8[];
    mut iface_blob = u8[];
    for i in rows.len() {
        w := words(view(item(&rows, i)));
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("links")) {
            links_blob = item(&w, 1);
        }
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("obj")) {
            obj_blob = item(&w, 1);
        }
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("iface")) {
            iface_blob = item(&w, 1);
        }
    }
    if (links_blob.len() == 0) || (obj_blob.len() == 0) {
        return false;
    }
    if !cache_blob_ok(&mut store, view(links_blob)) || !cache_blob_ok(&mut store, view(obj_blob)) {
        return false;
    }
    if (iface_blob.len() != 0) && !cache_blob_ok(&mut store, view(iface_blob)) {
        return false;
    }
    if cache_blob_restore(&mut store, view(links_blob), view(unit_links_path(view(stem))), 0) != 0 {
        return false;
    }
    if cache_blob_restore(&mut store, view(obj_blob), view(cat(view(stem), view(".o"))), 0) != 0 {
        return false;
    }
    if iface_blob.len() != 0 {
        dest := path_join(view(ifaces), view(cat(view(name), view(".iface"))));
        if cache_blob_restore(&mut store, view(iface_blob), view(dest), 0) != 0 {
            return false;
        }
    }
    return true;
}
// Where a unit's link inputs are written: beside its object, so a cached unit and a compiled one
// hand the link the same list.
fn unit_links_path<a>(stem: &a [u8]) -> u8[] {
    return cat(view(stem), view(".links"));
}
// The `// grail-link:` requests of one unit, one per line, resolved against its own sources.
fn write_unit_links<a>(stem: &a [u8], asm: &a [u8], files: (&a u8[][])) -> u64 {
    mut base = copy(view("."));
    if files.len() != 0 {
        base = dirname(view(item(&files, 0)));
    }
    if host::exists(view(asm)) == 0 {
        return 1;
    }
    inputs := link_inputs(view(asm), view(base));
    mut text = u8[];
    for i in inputs.len() {
        push_bytes(&mut text, view(item(&inputs, i)));
        text.push(10);
    }
    return host::write_file(view(unit_links_path(view(stem))), view(text));
}
// File a module run's outputs under its key, after they assembled: the object, the link inputs and
// the interface.
fn unit_file<a, b, d, e, g>(
    store: (&a mut Cache),
    key: &b [u8],
    stem: &d [u8],
    ifaces: &e [u8],
    name: &g [u8]
) -> unit {
    links_blob := cache_blob_put(&mut store, view(unit_links_path(view(stem))));
    if links_blob.len() != 64 {
        return ();
    }
    obj_blob := cache_blob_put(&mut store, view(cat(view(stem), view(".o"))));
    if obj_blob.len() != 64 {
        return ();
    }
    mut record = u8[];
    push_bytes(&mut record, view("// grail-cache-unit 2\nmodule "));
    push_bytes(&mut record, view(name));
    push_bytes(&mut record, view("\nlinks "));
    push_bytes(&mut record, view(links_blob));
    push_bytes(&mut record, view("\nobj "));
    push_bytes(&mut record, view(obj_blob));
    record.push(10);
    iface := path_join(view(ifaces), view(cat(view(name), view(".iface"))));
    if host::exists(view(iface)) != 0 {
        b := cache_blob_put(&mut store, view(iface));
        if b.len() != 64 {
            return ();
        }
        push_bytes(&mut record, view("iface "));
        push_bytes(&mut record, view(b));
        record.push(10);
    }
    cache_record_put(&mut store, view("unit"), view(key), view(record));
    return ();
}
fn per_module_build<a, d, e, g, k, m, n, x, y>(
    command: (&a u8[][]),
    at: u64,
    groups: (&x mut ModuleGroup[]),
    output: &d [u8],
    target: &e [u8],
    emulation: &g [u8],
    prefix: (&k u8[][]),
    store: (&m mut Cache),
    id: (&n BuildId),
    program: &y [u8],
    cache: u64
) -> u64 {
    compiler := item(&command, 0);
    mut flags = u8[][];
    mut i = 1;
    while i < at {
        a := item(&command, i);
        if eq(view(a), view("--interface")) {
            i += 2;
            continue;
        }
        // A unit is one module of a settled set: every module the program has is a group, so the unit
        // does not resolve `use` through the roots again - that is what would compile a module twice.
        if eq(view(a), view("--module-root")) {
            i += 2;
            continue;
        }
        // The whole program's shape is not a unit's: a unit is one module's code, compiled for a
        // separate object (`--separate`), and it reads the interfaces the runs before it wrote.
        if !eq(view(a), view("--split")) {
            flags.push(a);
        }
        i += 1;
    }
    entry_name := groups[0].name.copy();
    base := u8[][copy(view("runtime"))];
    dir := cat(view(output), view(".modules"));
    host::mkdir(view(dir));
    ifaces := path_join(view(dir), view("interfaces"));
    host::mkdir(view(ifaces));
    // Every build writes the interface directory afresh, so a module removed from the program leaves
    // no interface behind for another to read.
    old := host::list_dir(view(ifaces));
    for j in old.len() {
        host::remove(view(path_join(view(ifaces), view(old[j]))), 0);
    }
    mut objects = u8[][];
    mut link = u8[][];
    mut built = 0;
    while built < groups.len() {
        // The next group: a base group first, then any group whose program-local uses are built.
        mut pick = groups.len();
        for g in groups.len() {
            if (pick == groups.len()) && (groups[g].done == 0) {
                mut ready = true;
                mut is_base = false;
                for b in base.len() {
                    if eq(view(base[b]), view(groups[g].name)) {
                        is_base = true;
                    }
                }
                if !is_base {
                    for b in base.len() {
                        base_name := base[b].copy();
                        bg := group_of(&groups, view(base_name));
                        if (bg != 0) && (groups[bg - 1].done == 0) {
                            ready = false;
                        }
                    }
                    for u in groups[g].uses.len() {
                        // Hoisted: reading the group while `group_of` borrows the list is refused.
                        used := groups[g].uses[u].copy();
                        ug := group_of(&groups, view(used));
                        if (ug != 0) && (ug - 1 != g) && (groups[ug - 1].done == 0) {
                            ready = false;
                        }
                    }
                }
                if ready {
                    pick = g;
                }
            }
        }
        if pick == groups.len() {
            say(
                view(
                    "grail: --per-module found a cycle of `use` between modules; build without --per-module"
                )
            );
            return 1;
        }
        name := groups[pick].name.copy();
        stem := path_join(view(dir), view(name));
        unit_asm := cat(view(stem), view(".s"));
        unit_obj := cat(view(stem), view(".o"));
        mut key = u8[];
        mut reused = false;
        if cache != 0 {
            key = unit_key(
                &mut store,
                id,
                view(target),
                view(name),
                &groups[pick].files,
                view(ifaces)
            );
            reused = unit_restore(&mut store, view(key), view(stem), view(ifaces), view(name));
            if reused {
                store.hits += 1;
            } else {
                store.misses += 1;
                store.names.push(name.copy());
            }
        }
        if !reused {
            // One compiler run, one file: this module's code alone, global so the link can bind it,
            // with the interfaces of the modules built before it as its view of them.
            mut run = u8[][compiler.copy()];
            for f in flags.len() {
                run.push(item(&flags, f));
            }
            if built != 0 {
                run.push(copy(view("--use")));
                run.push(ifaces.copy());
            }
            run.push(copy(view("--emit-interface")));
            run.push(ifaces.copy());
            run.push(copy(view("--separate")));
            if cache != 0 {
                // The per-function codegen cache: a module run that misses can still replay the
                // functions whose inputs did not move (docs/design/incremental-compilation.md).
                // It is one directory inside this build's store, so a prune drops it with the rest.
                run.push(copy(view("--fn-cache")));
                run.push(fn_store(view(store.root)));
                // The compiler's own digest: a unit is code this binary emitted, so a rebuilt
                // compiler must not replay the previous one's.
                run.push(copy(view("--fn-cache-id")));
                run.push(id.compiler.copy());
            }
            if !eq(view(name), view(entry_name)) {
                run.push(copy(view("--no-entry")));
            }
            run.push(unit_asm.copy());
            for f in groups[pick].files.len() {
                run.push(groups[pick].files[f].copy());
            }
            if host::command(run) != 0 {
                return 1;
            }
            mut assemble = u8[][];
            for i in prefix.len() {
                assemble.push(item(&prefix, i));
            }
            assemble.push(unit_asm.copy());
            assemble.push(copy(view("-o")));
            assemble.push(unit_obj.copy());
            if host::command(assemble) != 0 {
                say(view("grail: assembling failed (needs clang)"));
                return 1;
            }
            if write_unit_links(view(stem), view(unit_asm), &groups[pick].files) != 0 {
                say(view("grail: could not write a module's link inputs"));
                return 1;
            }
            if cache != 0 {
                unit_file(&mut store, view(key), view(stem), view(ifaces), view(name));
            }
        }
        objects.push(unit_obj);
        for l in unit_links(view(stem)) {
            add_link(&mut link, view(l));
        }
        groups[pick].done = 1;
        built += 1;
    }
    if link_objects(view(output), view(target), view(emulation), &objects, &link) != 0 {
        return 1;
    }
    if cache != 0 {
        cache_report(&mut store, 1);
        // The image is this build's answer for as long as every input and every file the link named
        // is the one it was linked from, so a rebuild of unchanged sources runs nothing at all.
        image := cache_blob_put(&mut store, view(output));
        if image.len() == 64 {
            mut record = u8[];
            push_bytes(&mut record, view("// grail-cache-program 1\nblob "));
            push_bytes(&mut record, view(image));
            push_bytes(&mut record, view("\nparts "));
            cache_decimal(&mut record, groups.len());
            push_bytes(&mut record, view("\noutput "));
            push_bytes(&mut record, view(output));
            record.push(10);
            for i in link.len() {
                input := item(&link, i);
                if host::exists(view(input)) != 0 {
                    push_bytes(&mut record, view("link "));
                    push_bytes(&mut record, view(cache_digest_file(&mut store, view(input))));
                    record.push(32);
                    push_bytes(&mut record, view(input));
                    record.push(10);
                }
            }
            // Every module source this build compiles, not only the ones the command line named: `use`
            // resolution adds the standard closure, and the image shortcut has to see an edit there
            // (docs/design/separate-compilation.md, "What a run compiles, and what it writes").
            for g in groups.len() {
                for f in groups[g].files.len() {
                    source := groups[g].files[f].copy();
                    if host::exists(view(source)) != 0 {
                        push_bytes(&mut record, view("source "));
                        push_bytes(&mut record, view(cache_digest_file(&mut store, view(source))));
                        record.push(32);
                        push_bytes(&mut record, view(source));
                        record.push(10);
                    }
                }
            }
            cache_record_put(&mut store, view("prog"), view(program), view(record));
        }
    }
    return 0;
}
// A unit's link inputs, as `write_unit_links` left them.
fn unit_links<a>(stem: &a [u8]) -> u8[][] {
    path := unit_links_path(view(stem));
    text := host::read_file(view(path));
    rows := lines(view(text));
    mut out = u8[][];
    for i in rows.len() {
        row := item(&rows, i);
        if row.len() != 0 {
            out.push(row);
        }
    }
    return out;
}
// Add a link input once: two modules may ask for the same library, and the link needs it once.
fn add_link<a, b>(link: (&a mut u8[][]), input: &b [u8]) -> unit {
    for i in link.len() {
        if eq(view(link[i]), view(input)) {
            return ();
        }
    }
    mut copy_of = u8[];
    push_bytes(&mut copy_of, view(input));
    link.push(copy_of);
    return ();
}
// One link, from objects already on disk: the cache reuses exactly this, so a cached image and an
// uncached one are the same link of the same objects.
fn link_objects<a, b, d, e, g>(
    output: &a [u8],
    target: &b [u8],
    emulation: &d [u8],
    objects: (&e u8[][]),
    inputs: (&g u8[][])
) -> u64 {
    mut link = u8[][
        tool(view("GRAIL_LINKER"), view("ld.lld")),
        copy(view("-m")),
        copy(view(emulation))
    ];
    for i in objects.len() {
        link.push(item(&objects, i));
    }
    for i in inputs.len() {
        link.push(item(&inputs, i));
    }
    dynamic := dynamic_link_flags(view(target), inputs);
    for i in dynamic.len() {
        link.push(item(&dynamic, i));
    }
    link.push(copy(view("-o")));
    link.push(copy(view(output)));
    if host::command(link) != 0 {
        say(view("grail: linking failed (needs ld.lld)"));
        return 1;
    }
    return 0;
}
// ---- build cache (B1 stage 4) ----
//
// An unchanged module is not reassembled and an unchanged program is not relinked. Three keys, each
// over exactly what determines the artifact it names (docs/design/separate-compilation.md, "Stage 4
// as built: a build cache"):
//
//   map/prog/<key>   every input the build reads, the compiler and the toolchain  -> the image
//   map/lnk/<key>    the object set, the link inputs and the linker               -> the image
//   map/mod/<key>    one module's inputs and the assembler                        -> its object
//
// The store is content addressed under .work/cache/<target>:
//
//   blob/<sha256>    artifact bytes; the file name is the digest of the bytes inside it
//   map/KIND/<key>   a record: `field value` lines naming the blob the key produced
//   stage/           every write lands here first and is renamed into place, so a crash leaves no
//                    half-written entry
//
// A blob is only reused after its bytes have been hashed again and matched against the name it is
// filed under, so a corrupted, truncated or unreadable entry is a miss - never a wrong build.
//
// The module key is the one the design note asks for: the module's source digest, the digests of the
// interfaces it reads, the compiler's digest, the target, every flag that changes code generation and
// the assembler's identity. It does not cover one thing that today's whole-program front end decides:
// the module's emitted assembly depends on *other* modules' bodies, because the optimizer inlines
// across module boundaries. So a module record also carries the digest of the assembly the object was
// built from, and an entry is only reused when that digest still matches the assembly just emitted.
// When stage 4 proper (one compiler invocation per module) lands, the guard becomes redundant.
struct Cache {
    root: u8[],
    // 1 when the host has sha256sum: a 12 MB compiler binary then hashes in milliseconds instead of
    // the seconds the in-language reader costs.
    fast: u64,
    tmp: u8[],
    hits: u64,
    misses: u64,
    // The modules that missed, in emission order, for the one-line report.
    names: u8[][]
}
struct BuildId {
    flags: u8[],
    compiler: u8[],
    assembler: u8[],
    linker: u8[],
    ifaces: u8[],
    iface_dir: u8[],
    sources: u8[][],
    digests: u8[][]
}
// Where one target's per-function units live: a directory of the build store, so `cache clear`
// takes it with everything else.
fn fn_store<a>(root: &a [u8]) -> u8[] {
    return path_join(view(root), view("fn"));
}
fn cache_root<a>(target: &a [u8]) -> u8[] {
    return cat(view(".work/cache/"), view(target));
}
fn cache_stage<a>(c: (&a mut Cache)) -> u8[] {
    return path_join(view(c.root), view("stage"));
}
fn cache_ensure<a>(c: (&a mut Cache)) -> unit {
    host::mkdir(view(".work"));
    host::mkdir(view(".work/cache"));
    host::mkdir(view(c.root));
    host::mkdir(view(path_join(view(c.root), view("blob"))));
    host::mkdir(view(path_join(view(c.root), view("map"))));
    host::mkdir(view(path_join(view(c.root), view("map/prog"))));
    host::mkdir(view(path_join(view(c.root), view("map/lnk"))));
    host::mkdir(view(path_join(view(c.root), view("map/mod"))));
    host::mkdir(view(path_join(view(c.root), view("map/unit"))));
    host::mkdir(view(path_join(view(c.root), view("stage"))));
    // One generation per build that opens the store: what `grail cache prune` measures age in.
    generation := cache_generation(view(c.root)) + 1;
    host::write_file(view(path_join(view(c.root), view("generation"))), view(decimal(generation)));
    return ();
}
// The store's build counter (0 for a store no build has opened yet).
fn cache_generation<a>(root: &a [u8]) -> u64 {
    path := path_join(view(root), view("generation"));
    if host::exists(view(path)) == 0 {
        return 0;
    }
    return number_of(view(host::read_file(view(path))));
}
// Record that the current build used a record: `map/<kind>/<key>.used` holds its generation.
fn cache_touch<a, b, d>(root: &a [u8], kind: &b [u8], key: &d [u8]) -> unit {
    used := cat(view(cache_record_path(view(root), view(kind), view(key))), view(".used"));
    host::write_file(view(used), view(decimal(cache_generation(view(root)))));
    return ();
}
// Whether `sha256sum` can stand in for the in-language digest. It is the same SHA-256 either way.
fn cache_hash_tool() -> u64 {
    mut run = u8[][
        copy(view("sh")),
        copy(view("-c")),
        copy(view("command -v sha256sum >/dev/null 2>&1"))
    ];
    if host::command(run) == 0 {
        return 1;
    }
    return 0;
}
// The SHA-256 of a file as 64 lowercase hex characters; empty when the file cannot be read.
fn cache_digest_file<a, b>(c: (&a mut Cache), path: &b [u8]) -> u8[] {
    if host::exists(view(path)) == 0 {
        return u8[];
    }
    if c.fast != 0 {
        mut script = u8[];
        push_bytes(&mut script, view("sha256sum "));
        sh_word(&mut script, view(path));
        push_bytes(&mut script, view(" > "));
        sh_word(&mut script, view(c.tmp));
        mut run = u8[][copy(view("sh")), copy(view("-c")), script];
        if host::command(run) == 0 {
            if host::exists(view(c.tmp)) != 0 {
                text := host::read_file(view(c.tmp));
                if 64 <= text.len() {
                    mut out = u8[];
                    for i in 64 {
                        out.push(text[i]);
                    }
                    return out;
                }
            }
        }
    }
    return native::iface_digest(&host::read_file(view(path)));
}
// A toolchain's identity: the words it is invoked with plus the version it reports. Nothing cheaper
// separates two builds of the same tool.
fn cache_tool_id<a, b>(c: (&a mut Cache), words_in: (&b u8[][])) -> u8[] {
    mut text = u8[];
    mut script = u8[];
    for i in words_in.len() {
        word := item(&words_in, i);
        push_bytes(&mut text, view(word));
        text.push(10);
        sh_word(&mut script, view(word));
        script.push(32);
    }
    push_bytes(&mut script, view("--version > "));
    sh_word(&mut script, view(c.tmp));
    push_bytes(&mut script, view(" 2>&1"));
    mut run = u8[][copy(view("sh")), copy(view("-c")), script];
    if host::command(run) == 0 {
        if host::exists(view(c.tmp)) != 0 {
            version := host::read_file(view(c.tmp));
            push_bytes(&mut text, view(version));
        }
    }
    return native::iface_digest(&text);
}
fn cache_record_path<a, b, d>(root: &a [u8], kind: &b [u8], key: &d [u8]) -> u8[] {
    map := path_join(view(root), view("map"));
    dir := path_join(view(map), view(kind));
    return path_join(view(dir), view(key));
}
// One `field value` line of a record; empty when the record is absent or does not have that field.
fn cache_field<a, b, d, e>(root: &a [u8], kind: &b [u8], key: &d [u8], field: &e [u8]) -> u8[] {
    path := cache_record_path(view(root), view(kind), view(key));
    if host::exists(view(path)) == 0 {
        return u8[];
    }
    cache_touch(view(root), view(kind), view(key));
    text := host::read_file(view(path));
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        w := words(view(row));
        if (2 <= w.len()) & eq(view(item(&w, 0)), view(field)) {
            return item(&w, 1);
        }
    }
    return u8[];
}
// The rest of a line after a fixed-length field: paths may contain spaces, so a record names a file
// by writing its digest first and the path after it.
fn cache_rest<a>(row: &a [u8], start: u64) -> u8[] {
    mut i = start;
    while (i < row.len()) & (row[i] == 32) {
        i += 1;
    }
    mut out = u8[];
    while i < row.len() {
        out.push(row[i]);
        i += 1;
    }
    return out;
}
// Publish a record: write it in `stage/`, then rename it into place.
fn cache_record_put<a, b, d, e>(
    c: (&a mut Cache),
    kind: &b [u8],
    key: &d [u8],
    body: &e [u8]
) -> unit {
    stage := cache_stage(&mut c);
    name := cat(view("rec."), view(key));
    pending := path_join(view(stage), view(name));
    if host::write_file(view(pending), view(body)) != 0 {
        return ();
    }
    dest := cache_record_path(view(c.root), view(kind), view(key));
    mut run = u8[][copy(view("mv")), copy(view("-f")), pending, dest];
    host::command(run);
    cache_touch(view(c.root), view(kind), view(key));
    return ();
}
fn hex_byte(b: u8) -> bool {
    return ((48 <= b) & (b <= 57)) || ((97 <= b) & (b <= 102));
}
// `grail cache prune [--keep N]`: drop every record no build used in the last N (default 10), then
// every blob no remaining record names, and whatever a killed build left in `stage/`.
// `grail cache clear` empties the store. Both cover every target under .work/cache.
fn cache_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() == 0 {
        say(view("usage: grail cache prune [--keep N] | grail cache clear"));
        return 1;
    }
    sub := item(&args, 0);
    if eq(view(sub), view("clear")) {
        mut run = u8[][copy(view("rm")), copy(view("-rf")), copy(view(".work/cache"))];
        host::command(run);
        host::print(view("cache: cleared\n"));
        return 0;
    }
    if !eq(view(sub), view("prune")) {
        say(view("usage: grail cache prune [--keep N] | grail cache clear"));
        return 1;
    }
    mut keep = 10;
    if (args.len() == 3) && eq(view(item(&args, 1)), view("--keep")) {
        keep = number_of(view(item(&args, 2)));
    }
    mut records_dropped = 0;
    mut records_kept = 0;
    mut blobs_dropped = 0;
    mut blobs_kept = 0;
    if host::exists(view(".work/cache")) == 0 {
        host::print(view("cache: empty\n"));
        return 0;
    }
    targets := host::list_dir(view(".work/cache"));
    for t in targets.len() {
        root := path_join(view(".work/cache"), view(item(&targets, t)));
        now := cache_generation(view(root));
        mut live = u8[];
        kinds := u8[][copy(view("prog")), copy(view("lnk")), copy(view("mod")), copy(view("unit"))];
        for k in kinds.len() {
            dir := path_join(view(path_join(view(root), view("map"))), view(item(&kinds, k)));
            if host::exists(view(dir)) == 0 {
                continue;
            }
            entries := host::list_dir(view(dir));
            for e in entries.len() {
                name := item(&entries, e);
                if ends(view(name), view(".used")) {
                    continue;
                }
                record := path_join(view(dir), view(name));
                used_path := cat(view(record), view(".used"));
                mut used = 0;
                if host::exists(view(used_path)) != 0 {
                    used = number_of(view(host::read_file(view(used_path))));
                }
                if (used + keep) < now {
                    host::remove(view(record), 0);
                    host::remove(view(used_path), 0);
                    records_dropped += 1;
                    continue;
                }
                records_kept += 1;
                // Every 64-hex-digit run a record holds is a blob it names.
                text := host::read_file(view(record));
                mut run = 0;
                for i in text.len() {
                    if hex_byte(text[i]) {
                        run += 1;
                    } else {
                        run = 0;
                    }
                    if run == 64 {
                        for j in 64 {
                            live.push(text[i + 1 - 64 + j]);
                        }
                        live.push(10);
                    }
                }
            }
        }
        blobs := path_join(view(root), view("blob"));
        if host::exists(view(blobs)) != 0 {
            names := host::list_dir(view(blobs));
            for b in names.len() {
                name := item(&names, b);
                if cache_contains(view(live), view(name)) {
                    blobs_kept += 1;
                } else {
                    host::remove(view(path_join(view(blobs), view(name))), 0);
                    blobs_dropped += 1;
                }
            }
        }
        stage := path_join(view(root), view("stage"));
        if host::exists(view(stage)) != 0 {
            leftovers := host::list_dir(view(stage));
            for l in leftovers.len() {
                host::remove(view(path_join(view(stage), view(item(&leftovers, l)))), 0);
            }
        }
        // The per-function store is dropped whole: its entries carry no generation stamp, and one
        // is only reached by a module run that already missed, so dropping it costs the first such
        // run a re-emission and never a rebuild of anything the module cache holds. `rm -rf` rather
        // than a listing, so a killed build's `fn/stage/` goes with it.
        fn_dir := fn_store(view(root));
        if host::exists(view(fn_dir)) != 0 {
            removal := u8[][copy(view("rm")), copy(view("-rf")), fn_dir];
            host::command(removal);
        }
    }
    mut line = copy(view("cache: pruned "));
    push_bytes(&mut line, view(decimal(records_dropped)));
    push_bytes(&mut line, view(" records and "));
    push_bytes(&mut line, view(decimal(blobs_dropped)));
    push_bytes(&mut line, view(" blobs; kept "));
    push_bytes(&mut line, view(decimal(records_kept)));
    push_bytes(&mut line, view(" records and "));
    push_bytes(&mut line, view(decimal(blobs_kept)));
    push_bytes(&mut line, view(" blobs\n"));
    host::print(view(line));
    return 0;
}
// File an artifact under the digest of its bytes, through a staging copy and a rename.
fn cache_blob_put<a, b>(c: (&a mut Cache), path: &b [u8]) -> u8[] {
    digest := cache_digest_file(&mut c, view(path));
    if digest.len() != 64 {
        return u8[];
    }
    blobs := path_join(view(c.root), view("blob"));
    blob := path_join(view(blobs), view(digest));
    // A blob that is already filed under this name is only reused if its bytes still hash to it: a
    // corrupted entry is replaced, so corruption costs one rebuild and not every build after it.
    if cache_blob_ok(&mut c, view(digest)) {
        return digest;
    }
    stage := cache_stage(&mut c);
    name := cat(view("blob."), view(digest));
    pending := path_join(view(stage), view(name));
    host::remove(view(pending), 0);
    mut copy_run = u8[][copy(view("cp")), copy(view(path)), copy(view(pending))];
    if host::command(copy_run) != 0 {
        return u8[];
    }
    mut move_run = u8[][copy(view("mv")), copy(view("-f")), pending, blob];
    if host::command(move_run) != 0 {
        return u8[];
    }
    return digest;
}
// A blob is usable only when its bytes still hash to the name it is filed under.
fn cache_blob_ok<a, b>(c: (&a mut Cache), digest: &b [u8]) -> bool {
    if digest.len() != 64 {
        return false;
    }
    blobs := path_join(view(c.root), view("blob"));
    blob := path_join(view(blobs), view(digest));
    if host::exists(view(blob)) == 0 {
        return false;
    }
    actual := cache_digest_file(&mut c, view(blob));
    return eq(view(actual), view(digest));
}
// Put a filed artifact back at `dest`, through a staging name so `dest` is only ever the whole file.
fn cache_blob_restore<a, b, d>(
    c: (&a mut Cache),
    digest: &b [u8],
    dest: &d [u8],
    executable: u64
) -> u64 {
    blobs := path_join(view(c.root), view("blob"));
    blob := path_join(view(blobs), view(digest));
    if host::exists(view(blob)) == 0 {
        return 1;
    }
    pending := cat(view(dest), view(".cache-pending"));
    mut script = u8[];
    push_bytes(&mut script, view("set -e\ncp "));
    sh_word(&mut script, view(blob));
    script.push(32);
    sh_word(&mut script, view(pending));
    if executable != 0 {
        push_bytes(&mut script, view("\nchmod 755 "));
        sh_word(&mut script, view(pending));
    }
    push_bytes(&mut script, view("\nmv -f "));
    sh_word(&mut script, view(pending));
    script.push(32);
    sh_word(&mut script, view(dest));
    mut run = u8[][copy(view("sh")), copy(view("-c")), script];
    if host::command(run) != 0 {
        return 1;
    }
    return 0;
}
fn cache_contains<a, b>(text: &a [u8], needle: &b [u8]) -> bool {
    if needle.len() > text.len() {
        return false;
    }
    mut i: u64 = 0;
    while i + needle.len() <= text.len() {
        mut j: u64 = 0;
        mut ok = 1;
        while j < needle.len() {
            if text[i + j] != needle[j] {
                ok = 0;
                break;
            }
            j += 1;
        }
        if ok != 0 {
            return true;
        }
        i += 1;
    }
    return false;
}
fn cache_decimal<a>(out: (&a mut u8[]), n: u64) -> unit {
    if 9 < n {
        cache_decimal(&mut out, n / 10);
    }
    out.push(48 + n % 10);
    return ();
}
// The part a files holds: `STEM.NNN.module.s` -> `NNN.module`, unique within one build.
fn part_id<a>(path: &a [u8]) -> u8[] {
    mut end = path.len();
    if (end > 1) & (path[end - 1] == 115) & (path[end - 2] == 46) {
        end -= 2;
    }
    mut i = end;
    mut stop = end;
    mut count: u64 = 0;
    while i > 0 {
        i -= 1;
        if path[i] == 46 {
            count += 1;
            if count == 2 {
                stop = i + 1;
                break;
            }
        }
    }
    mut out = u8[];
    mut k = stop;
    while k < end {
        out.push(path[k]);
        k += 1;
    }
    return out;
}
// The module a part file holds: the last dot-separated segment of the stem.
fn part_module<a>(path: &a [u8]) -> u8[] {
    mut end = path.len();
    if (end > 1) & (path[end - 1] == 115) & (path[end - 2] == 46) {
        end -= 2;
    }
    mut i = end;
    mut at = end;
    while i > 0 {
        i -= 1;
        if path[i] == 46 {
            at = i + 1;
            break;
        }
    }
    mut out = u8[];
    mut k = at;
    while k < end {
        out.push(path[k]);
        k += 1;
    }
    return out;
}
// The index of the input a module was emitted from, plus one; 0 when no input declares it.
fn cache_source_of<s, d, n>(sources: (&s u8[][]), digests: (&d u8[][]), name: &n [u8]) -> u64 {
    for i in sources.len() {
        if eq(view(basename(view(item(&sources, i)))), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
// What an importer reads of a dependency: its interface when the build reads interfaces, and the
// dependency's source digest otherwise - a stand-in that costs extra misses instead of being wrong.
fn cache_dep_digest<a, b, n>(c: (&a mut Cache), id: (&b BuildId), name: &n [u8]) -> u8[] {
    if id.iface_dir.len() != 0 {
        name_file := cat(view(name), view(".iface"));
        path := path_join(view(id.iface_dir), view(name_file));
        if host::exists(view(path)) != 0 {
            return cache_digest_file(&mut c, view(path));
        }
    }
    i := cache_source_of(&id.sources, &id.digests, view(name));
    if i == 0 {
        return u8[];
    }
    return item(&id.digests, i - 1);
}
// Whether a module's source names another module: `use NAME` or a `NAME::` reference.
fn cache_mentions<a, b>(text: &a [u8], name: &b [u8]) -> bool {
    qualified := cat(view(name), view("::"));
    if cache_contains(view(text), view(qualified)) {
        return true;
    }
    used := cat(view("use "), view(name));
    return cache_contains(view(text), view(used));
}
// The key material of one build: the flag vector as the compiler will see it, the compiler's own
// digest, the inputs in command-line order with their digests, the interfaces read, and the tools.
fn cache_build_id<a, b, d, e, g>(
    c: (&a mut Cache),
    argv: (&b u8[][]),
    asm: &d [u8],
    emulation: &e [u8],
    assemble: (&g u8[][])
) -> BuildId {
    mut id = BuildId {
        flags: u8[],
        compiler: u8[],
        assembler: u8[],
        linker: u8[],
        ifaces: u8[],
        iface_dir: u8[],
        sources: u8[][],
        digests: u8[][],
    };
    mut flagbuf = u8[];
    push_bytes(&mut flagbuf, view("grail-cache-flags 1\n"));
    mut i: u64 = 1;
    while i < argv.len() {
        a := item(&argv, i);
        if eq(view(a), view("--target")) & (i + 1 < argv.len()) {
            push_bytes(&mut flagbuf, view("target "));
            push_bytes(&mut flagbuf, view(item(&argv, i + 1)));
            flagbuf.push(10);
            i += 2;
        } else if eq(view(a), view("--module-root")) & (i + 1 < argv.len()) {
            // `--module-root DIR` names the directory `use` resolves modules in, and DIR is a
            // *directory*: taken for a source it made the key hash the stdlib folder (`sha256sum`
            // on a directory) once the resolver started passing it. The flag is in the key; the
            // modules it makes reachable are hashed one by one as the sources they are.
            push_bytes(&mut flagbuf, view("module-root "));
            push_bytes(&mut flagbuf, view(item(&argv, i + 1)));
            flagbuf.push(10);
            i += 2;
        } else if eq(view(a), view("--diagnostics-json")) & (i + 1 < argv.len()) {
            i += 2;
        } else {
            if (eq(view(a), view("--interface")) || eq(view(a), view("--emit-interface")))
                & (i + 1 < argv.len()) {
                id.iface_dir = item(&argv, i + 1);
                // The interfaces a module reads are named one by one in its own key, so the set as a
                // whole belongs to the program key and not to the flag vector every module shares.
                manifest := path_join(view(id.iface_dir), view("interfaces.manifest"));
                id.ifaces = cache_digest_file(&mut c, view(manifest));
                i += 2;
            } else {
                if eq(view(a), view("--module-root")) & (i + 1 < argv.len()) {
                    // A module root is a directory, not an input: the modules it resolves are modules
                    // of the program, and the record written here lists each one's source.
                    i += 2;
                } else {
                    if (a.len() != 0) & (a[0] == 45) {
                        push_bytes(&mut flagbuf, view(a));
                        flagbuf.push(10);
                        i += 1;
                    } else {
                        if !eq(view(a), view(asm)) {
                            digest := cache_digest_file(&mut c, view(a));
                            id.sources.push(copy(view(a)));
                            id.digests.push(digest);
                        }
                        i += 1;
                    }
                }
            }
        }
    }
    id.flags = native::iface_digest(&flagbuf);
    exe := host::exe_path();
    id.compiler = cache_digest_file(&mut c, view(exe));
    id.assembler = cache_tool_id(&mut c, assemble);
    mut linker = u8[][
        tool(view("GRAIL_LINKER"), view("ld.lld")),
        copy(view("-m")),
        copy(view(emulation))
    ];
    id.linker = cache_tool_id(&mut c, &linker);
    return id;
}
fn cache_program_key<a, b, d, e>(
    c: (&a mut Cache),
    id: (&b BuildId),
    target: &d [u8],
    asm: &e [u8]
) -> u8[] {
    mut buf = u8[];
    push_bytes(&mut buf, view("grail-cache-program 1\ntarget "));
    push_bytes(&mut buf, view(target));
    push_bytes(&mut buf, view("\nflags "));
    push_bytes(&mut buf, view(id.flags));
    push_bytes(&mut buf, view("\ncompiler "));
    push_bytes(&mut buf, view(id.compiler));
    push_bytes(&mut buf, view("\nassembler "));
    push_bytes(&mut buf, view(id.assembler));
    push_bytes(&mut buf, view("\nlinker "));
    push_bytes(&mut buf, view(id.linker));
    push_bytes(&mut buf, view("\nifaces "));
    push_bytes(&mut buf, view(id.ifaces));
    push_bytes(&mut buf, view("\noutput "));
    push_bytes(&mut buf, view(asm));
    buf.push(10);
    for i in id.sources.len() {
        push_bytes(&mut buf, view(item(&id.sources, i)));
        buf.push(32);
        push_bytes(&mut buf, view(item(&id.digests, i)));
        buf.push(10);
    }
    return native::iface_digest(&buf);
}
fn cache_module_key<a, b, d, e, g>(
    c: (&a mut Cache),
    id: (&b BuildId),
    target: &d [u8],
    part: &e [u8],
    parts: (&g u8[][])
) -> u8[] {
    name := part_module(view(part));
    mut buf = u8[];
    push_bytes(&mut buf, view("grail-cache-module 1\npart "));
    push_bytes(&mut buf, view(part_id(view(part))));
    push_bytes(&mut buf, view("\ntarget "));
    push_bytes(&mut buf, view(target));
    push_bytes(&mut buf, view("\nflags "));
    push_bytes(&mut buf, view(id.flags));
    push_bytes(&mut buf, view("\ncompiler "));
    push_bytes(&mut buf, view(id.compiler));
    push_bytes(&mut buf, view("\nassembler "));
    push_bytes(&mut buf, view(id.assembler));
    // Only the interfaces *this* module reads, which the dependency lines below carry: the digest of
    // the whole interface set is an input of the program, not of any one module.
    at := cache_source_of(&id.sources, &id.digests, view(name));
    push_bytes(&mut buf, view("\nsource "));
    if at != 0 {
        push_bytes(&mut buf, view(item(&id.digests, at - 1)));
    }
    buf.push(10);
    // The trusted base: every module is emitted against the runtime and the platform module.
    for k in id.sources.len() {
        base_name := basename(view(item(&id.sources, k)));
        if eq(view(base_name), view("runtime"))
            || eq(view(base_name), view("os-linux"))
            || eq(view(base_name), view("darwin")) {
            push_bytes(&mut buf, view("base "));
            push_bytes(&mut buf, view(base_name));
            buf.push(32);
            push_bytes(&mut buf, view(item(&id.digests, k)));
            buf.push(10);
        }
    }
    // What this module reads of its dependencies, in emission order.
    if at != 0 {
        text := host::read_file(view(item(&id.sources, at - 1)));
        for k in parts.len() {
            other := part_module(view(item(&parts, k)));
            if !eq(view(other), view(name)) & cache_mentions(view(text), view(other)) {
                push_bytes(&mut buf, view("dep "));
                push_bytes(&mut buf, view(other));
                buf.push(32);
                push_bytes(&mut buf, view(cache_dep_digest(&mut c, id, view(other))));
                buf.push(10);
            }
        }
    }
    return native::iface_digest(&buf);
}
// The one line a cached build prints: what was reused, what was not, and what ran.
fn cache_report<a>(c: (&a mut Cache), relinked: u64) -> unit {
    host::print(view("grail: cache: "));
    host::print_num(c.hits);
    host::print(view(" hit, "));
    host::print_num(c.misses);
    host::print(view(" miss"));
    if c.misses != 0 {
        host::print(view(" ("));
        for i in c.names.len() {
            if i != 0 {
                host::print(view(", "));
            }
            host::print(view(item(&c.names, i)));
        }
        host::print(view(")"));
    }
    host::print(view("; "));
    if relinked == 0 {
        host::print(view("image reused"));
    } else {
        host::print(view("image linked"));
    }
    say(view(""));
    return ();
}
// The whole-program key is over every input the build reads, so a hit means nothing has to run: the
// image in the store is the image this build would produce.
fn cache_up_to_date<a, b, d>(c: (&a mut Cache), key: &b [u8], output: &d [u8]) -> u64 {
    blob := cache_field(view(c.root), view("prog"), view(key), view("blob"));
    if !cache_blob_ok(&mut c, view(blob)) {
        return 0;
    }
    count := cache_field(view(c.root), view("prog"), view(key), view("parts"));
    // The image a whole-program hit hands back is only this program's image if the files the link
    // named are still the files it was linked with.
    record := cache_record_path(view(c.root), view("prog"), view(key));
    if host::exists(view(record)) == 0 {
        return 0;
    }
    body := host::read_file(view(record));
    rows := lines(view(body));
    for i in rows.len() {
        row := item(&rows, i);
        // `link <digest> <path>` and `source <digest> <path>`: the digest is 64 hex, so the path
        // starts 65 bytes after the field name.
        mut skip = 0;
        if starts(view(row), view("link ")) {
            skip = 5;
        } else {
            if starts(view(row), view("source ")) {
                skip = 7;
            }
        }
        if (skip != 0) & (skip + 65 <= row.len()) {
            mut wanted = u8[];
            for k in 64 {
                wanted.push(row[skip + k]);
            }
            path := cache_rest(view(row), skip + 65);
            actual := cache_digest_file(&mut c, view(path));
            if !eq(view(actual), view(wanted)) {
                return 0;
            }
        }
    }
    mut here = u8[];
    if host::exists(view(output)) != 0 {
        here = cache_digest_file(&mut c, view(output));
    }
    if !eq(view(here), view(blob)) {
        if cache_blob_restore(&mut c, view(blob), view(output), 1) != 0 {
            return 0;
        }
    }
    // The same shape as a rebuild reports, so one line always says what hit, what missed and what ran.
    host::print(view("grail: cache: "));
    host::print(view(count));
    host::print(view(" hit, 0 miss; program up to date\n"));
    return 1;
}
// Assemble and link through the store, then file what was produced. The compiler has already written
// the parts manifest; everything after it is reused or recomputed per module.
fn cache_split<a, b, d, e, g, k, m>(
    c: (&a mut Cache),
    id: (&b BuildId),
    base: &d [u8],
    output: &e [u8],
    target: &g [u8],
    emulation: &k [u8],
    assemble: (&m u8[][]),
    program: &d [u8]
) -> u64 {
    manifest := cat(view(output), view(".parts"));
    mut text = u8[];
    if host::exists(view(manifest)) != 0 {
        text = host::read_file(view(manifest));
    }
    if !starts(view(text), view("// grail-parts 1")) {
        say(view("grail: missing or unreadable parts manifest "));
        say(view(manifest));
        return 1;
    }
    parts := read_split(view(manifest), view(base));
    if parts.asm.len() == 0 {
        say(view("grail: the parts manifest lists no modules"));
        return 1;
    }
    mut miss_sources = u8[][];
    mut miss_objects = u8[][];
    mut miss_at = u64[];
    mut digests = u8[][];
    for i in parts.asm.len() {
        part := item(&parts.asm, i);
        object := item(&parts.objects, i);
        key := cache_module_key(&mut c, id, view(target), view(part), &parts.asm);
        asm_digest := cache_digest_file(&mut c, view(part));
        recorded := cache_field(view(c.root), view("mod"), view(key), view("asm"));
        blob := cache_field(view(c.root), view("mod"), view(key), view("blob"));
        mut reused = 0;
        if (recorded.len() == 64)
            & eq(view(recorded), view(asm_digest))
            & cache_blob_ok(&mut c, view(blob)) {
            if cache_blob_restore(&mut c, view(blob), view(object), 0) == 0 {
                reused = 1;
            }
        }
        if reused != 0 {
            c.hits += 1;
            digests.push(blob);
        } else {
            c.misses += 1;
            c.names.push(part_module(view(part)));
            miss_sources.push(part);
            miss_objects.push(object);
            miss_at.push(i);
            digests.push(copy(view("")));
        }
    }
    if miss_sources.len() != 0 {
        if assemble_parts(assemble, &miss_sources, &miss_objects) != 0 {
            say(view("grail: assembling failed (needs clang)"));
            return 1;
        }
        // File the new objects only after they assembled, so a failed assembly leaves no entry.
        for i in miss_sources.len() {
            part := item(&miss_sources, i);
            object := item(&miss_objects, i);
            key := cache_module_key(&mut c, id, view(target), view(part), &parts.asm);
            asm_digest := cache_digest_file(&mut c, view(part));
            blob := cache_blob_put(&mut c, view(object));
            mut filed = copy(view(blob));
            if filed.len() != 64 {
                filed = cache_digest_file(&mut c, view(object));
            }
            // The object's position in link order is the position of its part.
            slot := miss_at[i];
            digests[slot] = filed;
            if blob.len() == 64 {
                mut record = u8[];
                push_bytes(&mut record, view("// grail-cache-module 1\nmodule "));
                push_bytes(&mut record, view(part_module(view(part))));
                push_bytes(&mut record, view("\nasm "));
                push_bytes(&mut record, view(asm_digest));
                push_bytes(&mut record, view("\nblob "));
                push_bytes(&mut record, view(blob));
                record.push(10);
                cache_record_put(&mut c, view("mod"), view(key), view(record));
            }
        }
    }
    // The image is determined by the object set, the link inputs and the linker.
    mut linkbuf = u8[];
    push_bytes(&mut linkbuf, view("grail-cache-link 1\ntarget "));
    push_bytes(&mut linkbuf, view(target));
    push_bytes(&mut linkbuf, view("\nlinker "));
    push_bytes(&mut linkbuf, view(id.linker));
    push_bytes(&mut linkbuf, view("\noutput "));
    push_bytes(&mut linkbuf, view(output));
    linkbuf.push(10);
    for i in digests.len() {
        push_bytes(&mut linkbuf, view(item(&digests, i)));
        linkbuf.push(10);
    }
    // A `// grail-link:` input that is a file on disk is part of what the image is: an archive or an
    // object that changed has to relink even though no source did.
    for i in parts.link.len() {
        input := item(&parts.link, i);
        push_bytes(&mut linkbuf, view(input));
        linkbuf.push(32);
        push_bytes(&mut linkbuf, view(cache_digest_file(&mut c, view(input))));
        linkbuf.push(10);
    }
    link_key := native::iface_digest(&linkbuf);
    image := cache_field(view(c.root), view("lnk"), view(link_key), view("blob"));
    mut linked: u64 = 0;
    mut final = copy(view(image));
    if cache_blob_ok(&mut c, view(image)) {
        if cache_blob_restore(&mut c, view(image), view(output), 1) != 0 {
            linked = 1;
        }
    } else {
        linked = 1;
    }
    if linked != 0 {
        if link_objects(view(output), view(target), view(emulation), &parts.objects, &parts.link)
            != 0 {
            return 1;
        }
        final = cache_blob_put(&mut c, view(output));
        if final.len() == 64 {
            mut record = u8[];
            push_bytes(&mut record, view("// grail-cache-link 1\nblob "));
            push_bytes(&mut record, view(final));
            record.push(10);
            cache_record_put(&mut c, view("lnk"), view(link_key), view(record));
        }
    }
    if final.len() == 64 {
        mut record = u8[];
        push_bytes(&mut record, view("// grail-cache-program 1\nblob "));
        push_bytes(&mut record, view(final));
        push_bytes(&mut record, view("\nparts "));
        cache_decimal(&mut record, parts.asm.len());
        push_bytes(&mut record, view("\noutput "));
        push_bytes(&mut record, view(output));
        record.push(10);
        for i in parts.link.len() {
            input := item(&parts.link, i);
            if host::exists(view(input)) != 0 {
                push_bytes(&mut record, view("link "));
                push_bytes(&mut record, view(cache_digest_file(&mut c, view(input))));
                record.push(32);
                push_bytes(&mut record, view(input));
                record.push(10);
            }
        }
        cache_record_put(&mut c, view("prog"), view(program), view(record));
    }
    cache_report(&mut c, linked);
    return 0;
}

struct Options {
    file: u8[],
    output: u8[],
    target: u8[],
    rest: u8[][],
    check: u64,
    debug: u64,
    deny: u64,
    split: u64,
    // 0 when the flag is absent, 1 for `--overflow=wrap`, 2 for `--overflow=checked`.
    overflow: u64,
    // The build cache (B1 stage 4): reuse per-module objects and an unchanged program.
    cache: u64,
    // `--whole-program`: one compiler run for the whole program, instead of the default one per
    // module (B1 stage 4).
    whole: u64,
    // `--no-error-sites`: no runtime-error location table (byte-for-byte comparisons with --split).
    no_sites: u64,
    // `--verify-facts`: every refinement the prover discharged still emits its runtime check, so a
    // proof that is wrong aborts at the call instead of passing unnoticed. Without it the flag
    // never reached the compiler, and the check it exists to keep was the check nobody saw.
    verify_facts: u64,
    // `--strict-refinements`: an obligation the prover cannot settle is refused, program-wide.
    strict: u64,
    // `--emit-ir`: the compiler writes the typed IR of the optimized stream beside the assembly.
    emit_ir: u64,
    // Module interfaces (B1 stage 2): `--interface DIR` reads them, `grail check` writes them, and
    // `--verify` compares the two instead of trusting either.
    iface: u8[],
    verify: u64,
    // Watch mode (`grail check --watch`, `grail build --watch`): re-run the cycle on change, with
    // the poll period (`--interval MS`) and the quiet period that collapses a burst of writes
    // (`--debounce MS`), and the cycle stream as one JSON object per line (`--json`).
    watch: u64,
    interval: u64,
    debounce: u64,
    json: u64,
    // `--diagnostics-json FILE`: the compiler appends one JSON object per diagnostic to FILE and
    // prints nothing, and the driver prints no summary, so a driver (an editor, the language
    // server) reads fields instead of text. Watch mode settles on its own file when this is empty.
    diag: u8[],
    paths: u8[][],
    // `--module-root DIR` (repeatable), and the two switches that were reachable only in the raw
    // compiler form: `grail build --emit-interface DIR` writes interfaces, and `grail build
    // --no-entry` suppresses entry selection for a library module.
    roots: u8[][],
    iface_emit: u64,
    no_entry: u64,
    // `--print-inputs FILE`: the compiler writes the module set it settled (`NAME<TAB>PATH`), which
    // is what a driver or a test uses as the oracle for "the roots the compile actually saw".
    inputs: u8[]
}
// The code-generation flag vector, in one place: it is what the compiler is told, and what the build
// cache keys on. Bit 0 check only, 1 debug, 2 deny ambient host, 3 split, 4/5 overflow, 6 cache,
// 7 whole program, 8 no runtime-error location table, 9 verify the facts a proof leaned on,
// 10 strict refinements, 11 write the typed IR beside the assembly.
// The compiler's flag word. `check_only` is the `--check` bit, which is about the caller rather than
// the options, so it is an argument instead of an option field.
fn flag_bits<a>(o: (&a Options), check_only: bool = false) -> u64 {
    return u64(check_only) + o.debug
        * 2
        + o.deny
        * 4
        + o.split
        * 8
        + o.overflow
        * 16
        + o.cache
        * 64
        + o.whole
        * 128
        + o.no_sites
        * 256
        + o.verify_facts
        * 512
        + o.strict
        * 1024
        + o.emit_ir
        * 2048;
}
// ---- The driver's own flags, as a table ----------------------------------------------------------
// One row per word the driver reads: `word` is what the command line says, `kind` says what follows
// it and what the driver does with it, and `field` names the `Options` slot the value lands in. A new
// flag is a new row plus one arm of the setter its kind picks, never another level of
// `else { if .. } else { .. }` - that nesting is what made a half-applied flag edit leave the
// compiler unable to parse its own source (docs/design/language-gaps-audit.md, 4.1).
struct Flag {
    word: u8[],
    kind: u64,
    field: u64
}
// No argument: the word's presence is the value.
const FLAG_SWITCH: u64 = 0;
// One argument, stored: `o.field = the word that follows`.
const FLAG_TEXT: u64 = 1;
// One argument, appended: `o.field.push(the word that follows)` (`--module-root` repeats).
const FLAG_LIST: u64 = 2;
// One argument, a decimal count: `o.field = number_of(the word that follows)`.
const FLAG_NUMBER: u64 = 3;
// The word is accepted and stores nothing: `--per-module` names the shape a build already has.
const FLAG_IGNORED: u64 = 4;
// The slots `field` names. The numbers are a private index into the setters below; a table row never
// says what a number means, and two words that store different numbers in one field are two slots.
const F_CHECK: u64 = 1;
const F_DEBUG: u64 = 2;
const F_DENY: u64 = 3;
const F_SPLIT: u64 = 4;
const F_OVERFLOW_WRAP: u64 = 5;
const F_OVERFLOW_CHECKED: u64 = 6;
const F_CACHE: u64 = 7;
const F_WHOLE: u64 = 8;
const F_NO_SITES: u64 = 9;
const F_VERIFY: u64 = 10;
const F_WATCH: u64 = 11;
const F_JSON: u64 = 12;
const F_NO_ENTRY: u64 = 13;
const F_VERIFY_FACTS: u64 = 14;
const F_STRICT: u64 = 15;
const F_EMIT_IR: u64 = 16;
const F_OUTPUT: u64 = 20;
const F_TARGET: u64 = 21;
const F_IFACE: u64 = 22;
const F_IFACE_EMIT: u64 = 23;
const F_DIAG: u64 = 24;
const F_INPUTS: u64 = 25;
const F_ROOTS: u64 = 30;
const F_INTERVAL: u64 = 40;
const F_DEBOUNCE: u64 = 41;
// The flag table: every word the driver reads. `--` and a positional path are not rows - the first
// ends the driver's words and the second is an input - so `options` handles both around the lookup.
fn flag_table() -> Flag[] {
    return Flag[
        Flag { word: copy(view("-o")), kind: FLAG_TEXT, field: F_OUTPUT },
        Flag { word: copy(view("--target")), kind: FLAG_TEXT, field: F_TARGET },
        Flag { word: copy(view("--module-root")), kind: FLAG_LIST, field: F_ROOTS },
        Flag { word: copy(view("--emit-interface")), kind: FLAG_TEXT, field: F_IFACE_EMIT },
        Flag { word: copy(view("--no-entry")), kind: FLAG_SWITCH, field: F_NO_ENTRY },
        Flag { word: copy(view("--print-inputs")), kind: FLAG_TEXT, field: F_INPUTS },
        Flag { word: copy(view("--check")), kind: FLAG_SWITCH, field: F_CHECK },
        Flag { word: copy(view("--debug")), kind: FLAG_SWITCH, field: F_DEBUG },
        Flag { word: copy(view("--deny-ambient-host")), kind: FLAG_SWITCH, field: F_DENY },
        Flag { word: copy(view("--split")), kind: FLAG_SWITCH, field: F_SPLIT },
        Flag { word: copy(view("--per-module")), kind: FLAG_IGNORED, field: 0 },
        Flag { word: copy(view("--whole-program")), kind: FLAG_SWITCH, field: F_WHOLE },
        Flag { word: copy(view("--cache")), kind: FLAG_SWITCH, field: F_CACHE },
        Flag { word: copy(view("--overflow=wrap")), kind: FLAG_SWITCH, field: F_OVERFLOW_WRAP },
        Flag {
            word: copy(view("--overflow=checked")),
            kind: FLAG_SWITCH,
            field: F_OVERFLOW_CHECKED,
        },
        Flag { word: copy(view("--no-error-sites")), kind: FLAG_SWITCH, field: F_NO_SITES },
        Flag { word: copy(view("--verify-facts")), kind: FLAG_SWITCH, field: F_VERIFY_FACTS },
        Flag { word: copy(view("--strict-refinements")), kind: FLAG_SWITCH, field: F_STRICT },
        Flag { word: copy(view("--emit-ir")), kind: FLAG_SWITCH, field: F_EMIT_IR },
        Flag { word: copy(view("--interface")), kind: FLAG_TEXT, field: F_IFACE },
        Flag { word: copy(view("--verify")), kind: FLAG_SWITCH, field: F_VERIFY },
        Flag { word: copy(view("--watch")), kind: FLAG_SWITCH, field: F_WATCH },
        Flag { word: copy(view("--json")), kind: FLAG_SWITCH, field: F_JSON },
        Flag { word: copy(view("--diagnostics-json")), kind: FLAG_TEXT, field: F_DIAG },
        Flag { word: copy(view("--interval")), kind: FLAG_NUMBER, field: F_INTERVAL },
        Flag { word: copy(view("--debounce")), kind: FLAG_NUMBER, field: F_DEBOUNCE }
    ];
}
// The row for `word`, or `table.len()` when no row has it: a sentinel rather than an optional, so the
// caller's shape stays one comparison.
fn flag_index<a, b>(table: (&a Flag[]), word: &b [u8]) -> u64 {
    for i in table.len() {
        if eq(view(table[i].word), view(word)) {
            return i;
        }
    }
    return table.len();
}
// Refuse a `--word` no row has, and end the run: the word nearest to it in the table is offered when
// one is close, and a word that is a flag of the compiler proper but not of the driver says so. An
// argument for the program a `run` starts goes after `--`, which is never read here.
fn unknown_flag<a, b>(table: (&a Flag[]), word: &b [u8]) {
    mut text = copy(view("grail: unknown option `"));
    push_bytes(&mut text, word);
    push_bytes(&mut text, view("`"));
    say(view(text));
    if eq(word, view("--backend=llvm")) || eq(word, view("--range-facts")) || eq(word, view("--export")) || eq(word, view("--typed-refs")) {
        say(view("  it is an option of the compiler proper (`grail [options] OUT.s ENTRY.grl ...`): the driver assembles and links the native stream only"));
    } else {
        mut best = table.len();
        mut best_cost = 4;
        for i in table.len() {
            cost := flag_distance(view(table[i].word), word);
            if cost < best_cost {
                best_cost = cost;
                best = i;
            }
        }
        if best != table.len() {
            mut help = copy(view("  did you mean `"));
            push_bytes(&mut help, view(table[best].word));
            push_bytes(&mut help, view("`?"));
            say(view(help));
        }
    }
    say(view("  arguments for the program itself go after `--`"));
    host::exit(1);
}
// How far apart two words are, as the count of positions that differ plus the difference in length:
// enough to catch a dropped, doubled or swapped letter without an edit-distance table.
fn flag_distance<a, b>(x: &a [u8], y: &b [u8]) -> u64 {
    mut short = x.len();
    mut long = y.len();
    if long < short {
        short = y.len();
        long = x.len();
    }
    // A dropped letter shifts everything after it, so compare from both ends and keep the better.
    mut front = 0;
    while (front < short) && (x[front] == y[front]) {
        front += 1;
    }
    mut back = 0;
    while (back < short - front) && (x[x.len() - 1 - back] == y[y.len() - 1 - back]) {
        back += 1;
    }
    return long - front - back;
}
// Whether a row takes the word after it.
fn flag_takes_value(kind: u64) -> bool {
    return (kind == FLAG_TEXT) || (kind == FLAG_LIST) || (kind == FLAG_NUMBER);
}
// `o.field = 1` for the words whose presence is the whole message; the two overflow spellings are two
// slots because they store two different numbers. A comparison per arm, not a `match` on the slot: an
// identifier is a binding in a pattern, so `match field { F_CHECK => .. }` would match every slot and
// the consts in the table above would mean nothing here.
fn switch_on<a>(o: (&a mut Options), field: u64) {
    if field == F_CHECK {
        o.check = 1;
    } else if field == F_DEBUG {
        o.debug = 1;
    } else if field == F_DENY {
        o.deny = 1;
    } else if field == F_SPLIT {
        o.split = 1;
    } else if field == F_OVERFLOW_WRAP {
        o.overflow = 1;
    } else if field == F_OVERFLOW_CHECKED {
        o.overflow = 2;
    } else if field == F_CACHE {
        o.cache = 1;
    } else if field == F_WHOLE {
        o.whole = 1;
    } else if field == F_NO_SITES {
        o.no_sites = 1;
    } else if field == F_VERIFY_FACTS {
        o.verify_facts = 1;
    } else if field == F_STRICT {
        o.strict = 1;
    } else if field == F_EMIT_IR {
        o.emit_ir = 1;
    } else if field == F_VERIFY {
        o.verify = 1;
    } else if field == F_WATCH {
        o.watch = 1;
    } else if field == F_JSON {
        o.json = 1;
    } else if field == F_NO_ENTRY {
        o.no_entry = 1;
    }
}
// The word a flag takes, stored in the slot its row names. The kind decides which setter it is.
fn take_value<a, b>(o: (&a mut Options), kind: u64, field: u64, word: &b [u8]) {
    if kind == FLAG_TEXT {
        take_text(&mut o, field, word);
    } else if kind == FLAG_NUMBER {
        take_number(&mut o, field, word);
    } else {
        take_list(&mut o, field, word);
    }
}
fn take_text<a, b>(o: (&a mut Options), field: u64, word: &b [u8]) {
    if field == F_OUTPUT {
        o.output = copy(word);
    } else if field == F_TARGET {
        o.target = copy(word);
    } else if field == F_IFACE {
        o.iface = copy(word);
    } else if field == F_IFACE_EMIT {
        // `--emit-interface DIR` is `--interface DIR` plus "write them": the slot holds the directory
        // and the second one says which of the two words it was.
        o.iface = copy(word);
        o.iface_emit = 1;
    } else if field == F_DIAG {
        o.diag = copy(word);
    } else if field == F_INPUTS {
        o.inputs = copy(word);
    }
}
fn take_number<a, b>(o: (&a mut Options), field: u64, word: &b [u8]) {
    if field == F_INTERVAL {
        o.interval = number_of(word);
    } else if field == F_DEBOUNCE {
        o.debounce = number_of(word);
    }
}
fn take_list<a, b>(o: (&a mut Options), field: u64, word: &b [u8]) {
    if field == F_ROOTS {
        o.roots.push(copy(word));
    }
}
fn options<a>(args: (&a u8[][])) -> Options {
    mut o = Options {
        file: u8[],
        output: u8[],
        target: target_name(host::target()),
        rest: u8[][],
        check: 0,
        debug: 0,
        deny: 0,
        split: 0,
        overflow: 0,
        cache: 0,
        whole: 0,
        no_sites: 0,
        iface: u8[],
        verify: 0,
        verify_facts: 0,
        strict: 0,
        emit_ir: 0,
        watch: 0,
        interval: 0,
        debounce: 0,
        json: 0,
        diag: u8[],
        paths: u8[][],
        roots: u8[][],
        iface_emit: 0,
        no_entry: 0,
        inputs: u8[],
    };
    table := flag_table();
    mut i = 0;
    mut passthrough = 0;
    while i < args.len() {
        a := item(&args, i);
        at := flag_index(&table, view(a));
        if passthrough != 0 {
            // Everything after `--` belongs to the program, a word that looks like a flag included.
            o.rest.push(a);
        } else if eq(view(a), view("--")) {
            // The terminator is neither an input nor a flag: it is what switches the branch above on.
            passthrough = 1;
        } else if (at == table.len()) & starts(view(a), view("--")) {
            // A word that looks like a flag and is none of the driver's. It used to fall into the
            // input list, where a build ignored it: `grail build --strict-refinments main.grl`
            // compiled without the flag and said nothing.
            unknown_flag(&table, view(a));
        } else if at == table.len() {
            // Not a driver word: an input. The first `.grl` file is the entry, and the paths keep the
            // order they were given in.
            if ends(view(a), view(".grl")) & (o.file.len() == 0) {
                o.file = copy(view(a));
            }
            o.paths.push(a);
        } else if table[at].kind == FLAG_IGNORED {
            // `--per-module` names the shape a build already has: consumed, and nothing to store.
        } else if !flag_takes_value(table[at].kind) {
            switch_on(&mut o, table[at].field);
        } else if i + 1 < args.len() {
            i += 1;
            take_value(&mut o, table[at].kind, table[at].field, view(item(&args, i)));
        } else {
            // A flag whose argument is missing cannot be read as a flag; it stays in the input list,
            // which is where it went when the chain fell through.
            o.paths.push(a);
        }
        i += 1;
    }
    // The whole-program cache reuses the objects `--split` writes, so it is that shape's cache. An
    // interface build (`--interface`) checks every module against its interface in one run, which is
    // the whole program too.
    if (o.cache != 0) & ((o.whole != 0) || (o.iface.len() != 0)) {
        o.split = 1;
    }
    return o;
}
fn build<a, b>(args: (&a u8[][]), o: (&b mut Options)) -> u64 {
    mut h = home();
    for i in o.roots.len() {
        h.roots.push(item(&o.roots, i).copy());
    }
    if h.runtime.len() == 0 {
        return 1;
    }
    // The cache keeps each module's compiler run and its object; the whole-program shape reuses the
    // objects `--split` writes, which is the Linux x86-64 assembler path. Name the limits here
    // instead of failing later with a --split error.
    if o.cache != 0 {
        if !linux_target(view(o.target)) {
            say(view("grail: --cache is implemented for the linux targets"));
            return 1;
        }
        if (o.whole != 0) & !eq(view(o.target), view("x86_64")) {
            say(
                view(
                    "grail: --cache --whole-program reuses the objects --split writes, which is the linux x86_64 assembler path"
                )
            );
            return 1;
        }
        if o.debug != 0 {
            say(view("grail: --cache is not implemented with --debug"));
            return 1;
        }
    }
    if o.watch != 0 {
        // Watch mode: the same build, once per cycle, in this process (`watch`).
        return watch(&h, o, 2);
    }
    host::mkdir(view("target"));
    // `--diagnostics-json FILE`: the driver starts the file, the compiler appends to it. Read out
    // of the options once, because the call below holds the options mutably.
    mut listener = copy(view(o.diag));
    if listener.len() != 0 {
        host::write_file(view(listener), view(""));
    }
    return build_pass(&h, o, view(listener));
}
// One build, in this process: the named file, or the project's entry, into `-o` or `target/`. `diag`
// is the file the compiler appends structured diagnostics to, and is empty for a plain `grail build`.
fn build_pass<a, b, c>(h: (&a Home), o: (&b mut Options), diag: &c [u8]) -> u64 {
    if o.file.len() != 0 {
        if o.output.len() == 0 {
            stem := basename(view(o.file));
            o.output = path_join(view("target"), view(stem));
        }
        mut none = u8[][];
        return compile(
            h: &h,
            entry: view(o.file),
            modules: &none,
            output: view(o.output),
            target: view(o.target),
            flags: flag_bits(&o),
            iface: view(o.iface),
            verify: o.verify,
            diag: diag,
            force_emit: o.iface_emit != 0,
            no_entry: o.no_entry != 0,
            inputs: view(o.inputs)
        );
    }
    // A project build reads grail.lock: the package manager has already resolved, fetched and
    // verified the graph, and hands back the entry file plus every module file (B1's module list,
    // unchanged). No resolution and no network happen here.
    p := pkg::plan(0);
    if p.name.len() == 0 {
        return 1;
    }
    if o.output.len() == 0 {
        name := copy(view(p.name));
        o.output = path_join(view("target"), view(name));
    }
    return compile(
        h: &h,
        entry: view(p.entry),
        modules: &p.modules,
        output: view(o.output),
        target: view(o.target),
        flags: flag_bits(&o),
        iface: view(o.iface),
        verify: o.verify,
        diag: diag,
        force_emit: o.iface_emit != 0,
        no_entry: o.no_entry != 0,
        inputs: view(o.inputs)
    );
}
fn check_command<a>(args: (&a u8[][])) -> u64 {
    mut o = options(&args);
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    if o.watch != 0 {
        return watch(&h, &mut o, 1);
    }
    host::mkdir(view("target"));
    // `--diagnostics-json FILE`: the driver starts the file, the compiler appends to it, and nothing
    // is printed - the file is the whole report. Read out of the options once, because the call
    // below holds them.
    mut listener = copy(view(o.diag));
    if listener.len() != 0 {
        host::write_file(view(listener), view(""));
    }
    status := check_pass(&h, &o, view(listener));
    if (status == 0) & (listener.len() == 0) {
        say(view("ok"));
    }
    return status;
}
// One check, in this process: type-check the named file, or the project, without assembling or
// linking. `diag` is the file the compiler appends structured diagnostics to.
fn check_pass<a, b, c>(h: (&a Home), o: (&b Options), diag: &c [u8]) -> u64 {
    if o.file.len() != 0 {
        stem := basename(view(o.file));
        out := path_join(view("target"), view(stem));
        mut none = u8[][];
        return compile_mode(
            h: &h,
            entry: view(o.file),
            modules: &none,
            output: view(out),
            target: view(o.target),
            flags: flag_bits(&o, check_only: true),
            iface: view(o.iface),
            verify: o.verify,
            diag: diag,
            force_emit: o.iface_emit != 0,
            no_entry: o.no_entry != 0,
            inputs: view(o.inputs)
        );
    }
    p := pkg::plan(0);
    if p.name.len() == 0 {
        return 1;
    }
    name := copy(view(p.name));
    out := path_join(view("target"), view(name));
    return compile_mode(
        h: &h,
        entry: view(p.entry),
        modules: &p.modules,
        output: view(out),
        target: view(o.target),
        flags: flag_bits(&o, check_only: true),
        iface: view(o.iface),
        verify: o.verify,
        diag: diag,
        force_emit: o.iface_emit != 0,
        no_entry: o.no_entry != 0,
        inputs: view(o.inputs)
    );
}

// ---- watch mode: `grail check --watch`, `grail build --watch` -------------------------------------
// A warm process that re-runs the cycle when an input changes. The design is
// docs/design/incremental-compilation.md, "Watch mode"; the shape it settles on is:
//
//   * the input set is the files the cycle reads - the source named on the command line, or, for a
//     project, the entry and module list `grail.lock` resolves (through `pkg::plan`) plus the
//     standard modules the sources reach through `use`, and every interface in `--interface DIR`.
//     It is recomputed on every poll, so a file that appears or a new `use` is a change like any
//     other;
//   * change detection is a content hash (XXH64, two seeds), never a timestamp: a file rewritten
//     with the same bytes is not a change, and a source restored from a backup with an old mtime is;
//   * a burst of writes is collapsed by a quiet period: one cycle per burst, not per write;
//   * a cycle runs in this process, prints its diagnostics and then exactly one summary line
//     (`check ok 24 ms`, `error 3 diagnostics 31 ms`, `built target/app 210 ms`), and with `--json`
//     prints one JSON object and nothing else;
//   * a failed cycle does not end the process: the next change re-runs it;
//   * no lock is held between cycles, so a concurrent `grail build` in the same directory runs while
//     this process waits.
const WATCH_POLL_MS: u64 = 100;
const WATCH_QUIET_MS: u64 = 120;
// One diagnostic, as the compiler's structured channel writes it.
struct Diag {
    file: u8[],
    line: u64,
    col: u64,
    code: u8[],
    message: u8[],
    // The compiler's own rendering, verbatim: what a plain `grail check` would have printed.
    rendered: u8[]
}
// The project's files as the package manager resolves them: the entry and every module the lock
// names, the root's and its dependencies'. Planning reports the manifest's problems, so it runs once
// per cycle rather than on every poll.
fn planned_files() -> u8[][] {
    mut files = u8[][];
    p := pkg::plan(0);
    if p.name.len() == 0 {
        return files;
    }
    files.push(copy(view(p.entry)));
    for i in p.modules.len() {
        files.push(item(&p.modules, i));
    }
    return files;
}
// The 128-bit content stamp of one file: XXH64 twice, with different seeds. Two zero words for a
// file that is not there, which is a state like any other - a source appearing or disappearing is a
// change.
fn watch_stamp<a>(path: &a [u8]) -> u64[] {
    mut out = u64[];
    if host::exists(view(path)) == 0 {
        out.push(0);
        out.push(0);
        return out;
    }
    text := host::read_file(view(path));
    out.push(xxhash::hash64(view(text), 0));
    out.push(xxhash::hash64(view(text), 1099511628211));
    return out;
}
fn watch_stamps<a>(files: (&a u8[][])) -> u64[][] {
    mut out = u64[][];
    for i in files.len() {
        out.push(watch_stamp(view(item(files, i))));
    }
    return out;
}
fn watch_settled<a, b>(before: (&a u64[][]), after: (&b u64[][])) -> bool {
    if before.len() != after.len() {
        return false;
    }
    for i in before.len() {
        was := before[i];
        now := after[i];
        if (was[0] != now[0]) | (was[1] != now[1]) {
            return false;
        }
    }
    return true;
}
// The files the next cycle reads, in the order it reads them. The compiler owns which modules a
// program has (docs/design/module-resolution.md), so the watcher does not read `use` lines itself:
// it watches every standard module, which is a superset of the ones any one program reaches, and a
// change to any of them re-runs the cycle.
fn watch_inputs<a, b, c>(h: (&a Home), o: (&b Options), project: (&c u8[][])) -> u8[][] {
    mut files = u8[][];
    if o.file.len() != 0 {
        // The source a one-shot `grail check FILE` / `grail build FILE` compiles: the file named on
        // the command line, and no other (a second FILE argument is not a module of the first - the
        // driver compiles only the named entry, and watch mode watches what the cycle reads).
        files.push(copy(view(o.file)));
    } else {
        // The plan is the set. The manifest, the lock and a listing of `src/` are only how a change
        // to the plan itself - a new dependency, a new module - is noticed: the next cycle re-plans.
        files.push(copy(view("grail.toml")));
        files.push(copy(view("grail.lock")));
        mut listed = u8[][];
        collect(view("src"), &mut listed);
        for i in listed.len() {
            files.push(item(&listed, i));
        }
        for i in project.len() {
            found := item(project, i);
            files.push(copy(view(found)));
        }
    }
    // Every standard module, and the project's own modules from the plan: a file the roots resolve is
    // under one of them, so a change to it is a change to an input.
    if h.std.len() != 0 {
        mut reached = u8[][];
        collect(view(h.std), &mut reached);
        for i in reached.len() {
            files.push(item(&reached, i));
        }
    }
    if o.iface.len() != 0 {
        mut interfaces = u8[][];
        collect(view(o.iface), &mut interfaces);
        for i in interfaces.len() {
            files.push(item(&interfaces, i));
        }
    }
    return files;
}
// The image a build writes: `-o`, or target/<entry stem> for a named file, target/<project> for a
// project. Read, not written, so the summary line names what the cycle produced.
fn build_output<a>(o: (&a Options)) -> u8[] {
    if o.output.len() != 0 {
        return copy(view(o.output));
    }
    if o.file.len() != 0 {
        return path_join(view("target"), view(basename(view(o.file))));
    }
    p := pkg::plan(0);
    if p.name.len() == 0 {
        return u8[];
    }
    name := copy(view(p.name));
    return path_join(view("target"), view(name));
}
// One cycle: a fresh structured-diagnostics file, the check or build in this process, then the
// report. `mode` is 1 for check, 2 for build.
fn watch_cycle<a, b>(h: (&a Home), o: (&b mut Options), mode: u64, cycle: u64) -> u64 {
    host::mkdir(view("target"));
    // A listener the caller named is theirs: every cycle starts it, the file stays. Otherwise the
    // cycle gets its own - named after the moment, so two watch processes in one directory never
    // share it, and removed when the cycle ends.
    mut diag = copy(view(o.diag));
    mut own_listener = 0;
    if diag.len() == 0 {
        diag = path_join(view("target"), view(cat(view("watch-"), view(decimal(host::wall_ms())))));
        own_listener = 1;
    }
    host::write_file(view(diag), view(""));
    start := host::now_ms();
    mut status = 0;
    if mode == 1 {
        status = check_pass(h, &o, view(diag));
    } else {
        status = build_pass(h, o, view(diag));
    }
    elapsed := host::now_ms() - start;
    records := read_diagnostics(view(diag));
    if own_listener != 0 {
        host::remove(view(diag), 0);
    }
    produced := build_output(&o);
    if o.json != 0 {
        report_json(mode, cycle, status, elapsed, &records, view(produced));
    } else {
        report_text(mode, status, elapsed, &records, view(produced));
    }
    return status;
}
fn read_diagnostics<a>(path: &a [u8]) -> Diag[] {
    mut out = Diag[];
    if host::exists(view(path)) == 0 {
        return out;
    }
    text := host::read_file(view(path));
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        if 0 < row.len() {
            out.push(parse_diagnostic(view(row)));
        }
    }
    return out;
}
fn parse_diagnostic<a>(row: &a [u8]) -> Diag {
    return Diag {
        file: json_string(view(row), view("file")),
        line: json_uint(view(row), view("line")),
        col: json_uint(view(row), view("col")),
        code: json_string(view(row), view("code")),
        message: json_string(view(row), view("message")),
        rendered: json_string(view(row), view("rendered")),
    };
}
// The byte after `"key":` in one record, or the record's length when the key is not there. The
// records are this program's own (native.grl's `diag_record`), so the scan is the whole reader.
fn json_after<a, b>(row: &a [u8], key: &b [u8]) -> u64 {
    mut i = 0;
    while i < row.len() {
        if row[i] == 34 {
            mut j = 0;
            mut hit = true;
            while j < key.len() {
                at := i + 1 + j;
                if at < row.len() {
                    if row[at] != key[j] {
                        hit = false;
                    }
                } else {
                    hit = false;
                }
                j += 1;
            }
            q := i + 1 + key.len();
            if hit {
                if (q + 1 < row.len()) & (row[q] == 34) & (row[q + 1] == 58) {
                    return q + 2;
                }
            }
        }
        i += 1;
    }
    return row.len();
}
fn json_string<a, b>(row: &a [u8], key: &b [u8]) -> u8[] {
    mut out = u8[];
    at := json_after(view(row), view(key));
    if (at + 1 < row.len()) & (row[at] == 34) {
        mut i = at + 1;
        mut done = false;
        while (i < row.len()) & !done {
            ch := row[i];
            if ch == 34 {
                done = true;
            } else {
                if ch == 92 {
                    if i + 1 < row.len() {
                        esc := row[i + 1];
                        i += 1;
                        if esc == 110 {
                            out.push(10);
                        } else {
                            if esc == 116 {
                                out.push(9);
                            } else {
                                if esc == 114 {
                                    out.push(13);
                                } else {
                                    if esc == 117 {
                                        out.push(json_hex(view(row), i + 1));
                                        i += 4;
                                    } else {
                                        out.push(esc);
                                    }
                                }
                            }
                        }
                    }
                } else {
                    out.push(ch);
                }
            }
            i += 1;
        }
    }
    return out;
}
// The single byte of a `\u00XX` escape: control characters are the only thing written that way.
fn json_hex<a>(row: &a [u8], at: u64) -> u8 {
    mut out = u64(0);
    mut i = 0;
    while (i < 4) & (at + i < row.len()) {
        ch := u64(row[at + i]);
        mut digit = ch - 48;
        if 9 < digit {
            digit = ch - 87;
        }
        out = out * 16 + digit;
        i += 1;
    }
    return u8(out);
}
fn json_uint<a, b>(row: &a [u8], key: &b [u8]) -> u64 {
    at := json_after(view(row), view(key));
    mut out: u64 = 0;
    mut i = at;
    while (i < row.len()) & (row[i] != 44) & (row[i] != 125) {
        ch := u64(row[i]);
        if (ch < 48) || (57 < ch) {
            return out;
        }
        out = out * 10 + (ch - 48);
        i += 1;
    }
    return out;
}
// The cycle's report on a terminal: the diagnostics in the compiler's own rendering, then one
// summary line.
fn report_text<a, b>(mode: u64, status: u64, elapsed: u64, diags: (&a Diag[]), out: (&b [u8])) -> unit {
    for i in diags.len() {
        d := diags[i];
        host::print(view(d.rendered));
    }
    if status == 0 {
        if mode == 1 {
            host::print(view("check ok "));
        } else {
            host::print(view("built "));
            host::print(view(out));
            host::print(view(" "));
        }
    } else {
        host::print(view("error "));
        if 0 < diags.len() {
            host::print_num(diags.len());
            if diags.len() == 1 {
                host::print(view(" diagnostic "));
            } else {
                host::print(view(" diagnostics "));
            }
        }
    }
    host::print_num(elapsed);
    say(view(" ms"));
    return ();
}
// The cycle's report as one JSON object on one line: `cycle`, `status`, `ms`, `output` for a build,
// and `diagnostics` with the fields an editor needs. Nothing else is printed for a cycle, so a
// reader can take every line as an object.
fn report_json<a, b>(mode: u64, cycle: u64, status: u64, elapsed: u64, diags: (&a Diag[]), out: (&b [u8])) -> unit {
    mut line = u8[];
    push_bytes(&mut line, view("{\"cycle\":"));
    push_bytes(&mut line, view(decimal(cycle)));
    if status == 0 {
        push_bytes(&mut line, view(",\"status\":\"ok\""));
    } else {
        push_bytes(&mut line, view(",\"status\":\"error\""));
    }
    push_bytes(&mut line, view(",\"ms\":"));
    push_bytes(&mut line, view(decimal(elapsed)));
    if mode == 2 {
        push_bytes(&mut line, view(",\"output\":\""));
        json_text(&mut line, view(out));
        push_bytes(&mut line, view("\""));
    }
    push_bytes(&mut line, view(",\"diagnostics\":["));
    for i in diags.len() {
        d := diags[i];
        if i != 0 {
            line.push(44);
        }
        push_bytes(&mut line, view("{\"file\":\""));
        json_text(&mut line, view(d.file));
        push_bytes(&mut line, view("\",\"line\":"));
        push_bytes(&mut line, view(decimal(d.line)));
        push_bytes(&mut line, view(",\"col\":"));
        push_bytes(&mut line, view(decimal(d.col)));
        push_bytes(&mut line, view(",\"code\":\""));
        json_text(&mut line, view(d.code));
        push_bytes(&mut line, view("\",\"message\":\""));
        json_text(&mut line, view(d.message));
        push_bytes(&mut line, view("\"}"));
    }
    push_bytes(&mut line, view("]}"));
    say(view(line));
    return ();
}
// The loop: one cycle now, then one per settled change. The process ends when a signal ends it, so
// the return below is the shape of the function, not a path it takes.
fn watch<a, b>(h: (&a Home), o: (&b mut Options), mode: u64) -> u64 {
    if o.cache != 0 {
        // A cache hit is a cycle that does not run the compiler, and a watch cycle always does: the
        // point of watching is that every change is checked, and its report is one line.
        say(view("grail: --watch re-runs the compiler every cycle, so --cache is not used with it"));
        return 1;
    }
    mut poll = WATCH_POLL_MS;
    if o.interval != 0 {
        poll = o.interval;
    }
    mut quiet = WATCH_QUIET_MS;
    if o.debounce != 0 {
        quiet = o.debounce;
    }
    // The project's plan, refreshed after every cycle: it is what `grail build` and `grail check`
    // resolve from the lock, so the watcher polls the same files the cycle compiles. In file mode
    // there is no plan to resolve (and asking for one would report that there is no manifest).
    mut project = u8[][];
    if o.file.len() == 0 {
        project = planned_files();
    }
    // The first cycle runs before the first poll: a watch that said nothing until a file changed
    // would look broken on the program that is already correct.
    mut status = watch_cycle(h, o, mode, 1);
    mut cycle = 1;
    if o.file.len() == 0 {
        project = planned_files();
    }
    mut current = watch_stamps(&watch_inputs(h, &o, &project));
    // 0 while the files are settled, else the moment the last change was seen.
    mut changed_at = 0;
    while true {
        host::sleep_ms(poll);
        next := watch_stamps(&watch_inputs(h, &o, &project));
        now := host::now_ms();
        if watch_settled(&current, &next) {
            if changed_at != 0 {
                if quiet <= now - changed_at {
                    status = watch_cycle(h, o, mode, cycle + 1);
                    cycle += 1;
                    changed_at = 0;
                    if o.file.len() == 0 {
                        project = planned_files();
                    }
                }
            }
        } else {
            changed_at = now;
        }
        current = next;
    }
    return status;
}
fn run_command<a>(args: (&a u8[][])) -> u64 {
    mut o = options(&args);
    if o.watch != 0 {
        say(view("grail run: watch mode is `grail build --watch` and `grail check --watch`"));
        return 1;
    }
    host_target := target_name(host::target());
    if !eq(view(o.target), view(host_target)) {
        say(
            view(
                "grail run: cross-target executables must be run with an emulator; use grail build --target"
            )
        );
        return 1;
    }
    if build(&args, &mut o) != 0 {
        return 1;
    }
    mut command = u8[][];
    out := copy(view(o.output));
    if starts(view(out), view("/")) {
        command.push(out);
    } else {
        command.push(path_join(view("."), view(out)));
    }
    for i in o.rest.len() {
        command.push(item(&o.rest, i));
    }
    return host::command(command);
}
// ---- `grail test` -------------------------------------------------------------------------------
// Two corpora, one command. Inside this repository `tests/native-cases.json` is the regression
// corpus and `tools/test-native.mjs` is its engine, so `grail test` forwards every argument there:
// the semantics are the engine's, not a copy of them (docs/testing.md says which command owns what).
// A project - a grail.pkg and tests/*.grl programs - runs those programs instead, with the same
// selection flags, the same summary line and the same failure report shape.
struct TestOptions {
    paths: u8[][],
    filter: u8[],
    list: u64,
    // `--one FILE`: the mode `--jobs` uses to run exactly one test in a child process.
    one: u8[],
    fail_fast: u64,
    update: u64,
    jobs: u64,
    // 0 when --shard is absent; otherwise the 1-based index of this shard of `count`.
    shard_index: u64,
    shard_count: u64,
    target: u8[],
    debug: u64,
    deny: u64,
    overflow: u64,
    no_sites: u64,
    // Set when an argument cannot be understood: `grail test` then prints its usage.
    bad: u64
}
fn tail_from<a>(text: &a [u8], n: u64) -> u8[] {
    mut out = u8[];
    mut i = n;
    while i < text.len() {
        out.push(text[i]);
        i += 1;
    }
    return out;
}
fn contains<a, b>(text: &a [u8], part: &b [u8]) -> bool {
    if part.len() == 0 {
        return true;
    }
    if text.len() < part.len() {
        return false;
    }
    for i in text.len() - part.len() + 1 {
        mut same = true;
        for j in part.len() {
            if text[i + j] != part[j] {
                same = false;
                break;
            }
        }
        if same {
            return true;
        }
    }
    return false;
}
fn test_usage() -> unit {
    say(view("usage: grail test [FILES or DIRS] [--filter TEXT] [--list] [--shard i/n] [--jobs N] [--fail-fast]"));
    say(view("       in the Grail repository this forwards to tools/test-native.mjs (--update, --target, --shard, --jobs)"));
}
fn set_test_shard<a>(o: (&a mut TestOptions), text: &a [u8]) -> unit {
    mut slash: u64 = 0;
    for i in text.len() {
        if text[i] == 47 {
            slash = i + 1;
        }
    }
    if slash == 0 {
        o.bad = 1;
        return ();
    }
    mut left = u8[];
    for i in slash - 1 {
        left.push(text[i]);
    }
    o.shard_index = number_of(view(left));
    o.shard_count = number_of(view(tail_from(view(text), slash)));
    if (o.shard_count == 0) || (o.shard_index == 0) || (o.shard_count < o.shard_index) {
        o.bad = 1;
    }
    return ();
}
fn test_options<a>(args: (&a u8[][])) -> TestOptions {
    mut o = TestOptions {
        paths: u8[][],
        filter: u8[],
        list: 0,
        one: u8[],
        fail_fast: 0,
        update: 0,
        jobs: 1,
        shard_index: 0,
        shard_count: 0,
        target: target_name(host::target()),
        debug: 0,
        deny: 0,
        overflow: 0,
        no_sites: 0,
        bad: 0
    };
    mut i: u64 = 0;
    while i < args.len() {
        a := item(&args, i);
        if eq(view(a), view("--filter")) & (i + 1 < args.len()) {
            i += 1;
            o.filter = item(&args, i);
        } else if starts(view(a), view("--filter=")) {
            o.filter = tail_from(view(a), 9);
        } else if eq(view(a), view("--list")) {
            o.list = 1;
        } else if eq(view(a), view("--one")) & (i + 1 < args.len()) {
            i += 1;
            o.one = item(&args, i);
        } else if eq(view(a), view("--fail-fast")) {
            o.fail_fast = 1;
        } else if eq(view(a), view("--update")) {
            o.update = 1;
        } else if eq(view(a), view("--jobs")) & (i + 1 < args.len()) {
            i += 1;
            o.jobs = number_of(view(item(&args, i)));
            if o.jobs == 0 {
                o.bad = 1;
            }
        } else if starts(view(a), view("--jobs=")) {
            o.jobs = number_of(view(tail_from(view(a), 7)));
            if o.jobs == 0 {
                o.bad = 1;
            }
        } else if eq(view(a), view("--shard")) & (i + 1 < args.len()) {
            i += 1;
            set_test_shard(&mut o, view(item(&args, i)));
        } else if starts(view(a), view("--shard=")) {
            set_test_shard(&mut o, view(tail_from(view(a), 8)));
        } else if eq(view(a), view("--target")) & (i + 1 < args.len()) {
            i += 1;
            o.target = item(&args, i);
        } else if eq(view(a), view("--debug")) {
            o.debug = 1;
        } else if eq(view(a), view("--deny-ambient-host")) {
            o.deny = 1;
        } else if eq(view(a), view("--no-error-sites")) {
            o.no_sites = 1;
        } else if eq(view(a), view("--overflow=wrap")) {
            o.overflow = 1;
        } else if eq(view(a), view("--overflow=checked")) {
            o.overflow = 2;
        } else if starts(view(a), view("--")) {
            o.bad = 1;
        } else {
            o.paths.push(a);
        }
        i += 1;
    }
    return o;
}
// The code-generation bits a test binary is built with: the same flags `grail build` takes, so a
// test can pin debug-info, overflow or authority behaviour.
fn test_bits<a>(o: (&a TestOptions)) -> u64 {
    return o.debug * 2 + o.deny * 4 + o.overflow * 16 + o.no_sites * 256;
}
// The flags a `--jobs` child needs to build the same binary its parent would have built.
fn test_build_flags<a>(o: (&a TestOptions)) -> u8[][] {
    mut flags = u8[][];
    flags.push(copy(view("--target")));
    flags.push(copy(view(o.target)));
    if o.debug != 0 {
        flags.push(copy(view("--debug")));
    }
    if o.deny != 0 {
        flags.push(copy(view("--deny-ambient-host")));
    }
    if o.no_sites != 0 {
        flags.push(copy(view("--no-error-sites")));
    }
    if o.overflow == 1 {
        flags.push(copy(view("--overflow=wrap")));
    }
    if o.overflow == 2 {
        flags.push(copy(view("--overflow=checked")));
    }
    return flags;
}
// One binary name per test program, derived from its own path: `tests/a/x.grl` is
// `target/tests/tests-a-x.grl`, so two tests with the same file name never share an output and a
// `--jobs` child's build cannot collide with another's.
fn test_binary<a>(file: &a [u8]) -> u8[] {
    mut out = copy(view("target/tests/"));
    for i in file.len() {
        ch := file[i];
        if is_sep(ch) {
            out.push(45);
        } else {
            out.push(ch);
        }
    }
    return out;
}
fn test_log<a>(file: &a [u8]) -> u8[] {
    mut out = test_binary(view(file));
    push_bytes(&mut out, view(".log"));
    return out;
}
fn test_rc<a>(file: &a [u8]) -> u8[] {
    mut out = test_binary(view(file));
    push_bytes(&mut out, view(".rc"));
    return out;
}
fn has_shell() -> bool {
    mut probe = u8[][copy(view("sh")), copy(view("-c")), copy(view("exit 0"))];
    return host::command(probe) == 0;
}
// The test program's output is captured, not interleaved: a passing test says one line, and a
// failing one says what the program printed, which is where a test's diagnostics are.
fn run_captured<a, b>(exe: &a [u8], log_path: &b [u8]) -> u64 {
    mut script = u8[];
    sh_word(&mut script, view(exe));
    push_bytes(&mut script, view(" > "));
    sh_word(&mut script, view(log_path));
    push_bytes(&mut script, view(" 2>&1"));
    mut command = u8[][copy(view("sh")), copy(view("-c")), script];
    return host::command(command);
}
// `FAIL FILE`, then the source, what was expected, what happened and what the program printed.
fn test_failure<a, b>(file: &a [u8], status: u64, log_path: &b [u8], note: &b [u8]) -> unit {
    say2(view("FAIL "), view(file));
    say2(view("  source: "), view(file));
    mut wanted = copy(view("  exit:   status "));
    push_bytes(&mut wanted, view(decimal(status)));
    if 128 < status {
        push_bytes(&mut wanted, view(" (a signal: 128 + the signal)"));
    }
    push_bytes(&mut wanted, view(", expected 0"));
    say(view(wanted));
    if note.len() != 0 {
        say2(view("  note:   "), view(note));
    }
    if (log_path.len() != 0) & (host::exists(view(log_path)) != 0) {
        body := host::read_file(view(log_path));
        if body.len() != 0 {
            say(view("  output:"));
            rows := lines(view(body));
            for i in rows.len() {
                row := item(&rows, i);
                if row.len() != 0 {
                    say2(view("    "), view(row));
                }
            }
        }
    }
    return ();
}
// Build and run one test program in this process. With `log` non-empty its output is captured.
fn test_run_here<a, b, d>(h: (&a Home), o: (&a TestOptions), file: &a [u8], log: &b [u8]) -> u64 {
    modules := u8[][];
    out := test_binary(view(file));
    status := compile(h: h, entry: view(file), modules: &modules, output: view(out), target: view(o.target), flags: test_bits(&o));
    if status != 0 {
        return status;
    }
    exe := path_join(view("."), view(out));
    if log.len() != 0 {
        return run_captured(view(exe), view(log));
    }
    mut one = u8[][exe];
    return host::command(one);
}
// `--test`'s one-program mode: the same build and run, and its exit status is the program's, so a
// `--jobs` child can hand it back through `$?`.
fn test_one_mode<a>(o: (&a TestOptions)) -> u64 {
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    host::mkdir(view("target"));
    host::mkdir(view("target/tests"));
    return test_run_here(&h, &o, view(o.one), view(""));
}
fn test_summary(passed: u64, failed: u64, skipped: u64) -> unit {
    mut line = copy(view("passed "));
    push_bytes(&mut line, view(decimal(passed)));
    push_bytes(&mut line, view(" failed "));
    push_bytes(&mut line, view(decimal(failed)));
    push_bytes(&mut line, view(" skipped "));
    push_bytes(&mut line, view(decimal(skipped)));
    say(view(line));
    return ();
}
fn test_command<a>(args: (&a u8[][])) -> u64 {
    // The repository's regression corpus: one engine, driven by tools/test-native.mjs. Inside the
    // tree that is what `grail test` means; the tree's tests/ directory is not a project's tests.
    if host::exists(view("tests/native-cases.json")) != 0 && host::exists(view("tools/test-native.mjs")) != 0 {
        say(view("grail test: the repository regression corpus (tools/test-native.mjs)"));
        mut command = u8[][copy(view("bun")), copy(view("tools/test-native.mjs"))];
        for i in args.len() {
            command.push(item(&args, i));
        }
        return host::command(command);
    }
    o := test_options(&args);
    if o.bad != 0 {
        test_usage();
        return 1;
    }
    if o.one.len() != 0 {
        return test_one_mode(&o);
    }
    if o.update != 0 {
        say(view("grail test: --update rewrites expectations in the regression corpus (tests/native-cases.json)"));
        say(view("            a project test asserts inside its own program, so there is nothing to update here"));
        return 1;
    }
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    mut files = u8[][];
    if o.paths.len() != 0 {
        for i in o.paths.len() {
            x := item(&o.paths, i);
            if ends(view(x), view(".grl")) {
                files.push(x);
            } else {
                collect(view(x), &mut files);
            }
        }
    } else {
        collect(view("tests"), &mut files);
    }
    // Selection: a substring of the program's path, then one shard of the survivors, both by
    // position, which is what the corpus engine's --filter and --shard mean as well.
    mut selected = u8[][];
    for i in files.len() {
        f := item(&files, i);
        if !contains(view(f), view(o.filter)) {
            continue;
        }
        if o.shard_count != 0 {
            if i % o.shard_count != o.shard_index - 1 {
                continue;
            }
        }
        selected.push(f);
    }
    if o.list != 0 {
        for i in selected.len() {
            say(view(item(&selected, i)));
        }
        mut line = copy(view(""));
        push_bytes(&mut line, view(decimal(selected.len())));
        push_bytes(&mut line, view(" tests selected"));
        say(view(line));
        return 0;
    }
    if selected.len() == 0 {
        say(view("grail test: no tests found (put programs in tests/)"));
        test_summary(0, 0, 0);
        return 0;
    }
    host::mkdir(view("target"));
    host::mkdir(view("target/tests"));
    if !has_shell() {
        // No POSIX shell (Windows): run in process, one at a time, with the programs' own output
        // going to the terminal instead of a per-test log.
        mut passed: u64 = 0;
        mut failed: u64 = 0;
        for i in selected.len() {
            f := item(&selected, i);
            status := test_run_here(&h, &o, view(f), view(""));
            host::print(view("test "));
            host::print(view(f));
            if status == 0 {
                say(view(" ... ok"));
                passed += 1;
            } else {
                say(view(" ... FAILED"));
                test_failure(view(f), status, view(""), view("no shell: the program's output went to the terminal"));
                failed += 1;
                if o.fail_fast != 0 {
                    test_summary(passed, failed, selected.len() - i - 1);
                    return 1;
                }
            }
        }
        test_summary(passed, failed, 0);
        return failed != 0;
    }
    // One `sh` script, `--jobs N` tests in flight, each a child process running exactly one test
    // (`--one`) with its output in a per-test log and its exit status in a per-test `.rc` file. The
    // parent reports in case order, so the report does not depend on which test finished first.
    mut stop = copy(view("target/tests/.stop"));
    host::remove(view(stop), 0);
    // A status or log left by an earlier run would let a test this run never started report as ok;
    // the child writes both, so their absence is the only evidence that it ran.
    for i in selected.len() {
        host::remove(view(test_rc(view(item(&selected, i)))), 0);
        host::remove(view(test_log(view(item(&selected, i)))), 0);
    }
    mut jobs = o.jobs;
    if (jobs == 0) || (selected.len() < jobs) {
        jobs = selected.len();
    }
    exe := host::exe_path();
    mut script = u8[];
    mut w: u64 = 0;
    while w < jobs {
        push_bytes(&mut script, view("(\n"));
        mut i = w;
        while i < selected.len() {
            f := item(&selected, i);
            log_path := test_log(view(f));
            rc_path := test_rc(view(f));
            if o.fail_fast != 0 {
                push_bytes(&mut script, view("if [ ! -e "));
                sh_word(&mut script, view(stop));
                push_bytes(&mut script, view(" ]; then\n"));
            }
            sh_word(&mut script, view(exe));
            push_bytes(&mut script, view(" test --one "));
            sh_word(&mut script, view(f));
            flags := test_build_flags(&o);
            for j in flags.len() {
                script.push(32);
                sh_word(&mut script, view(item(&flags, j)));
            }
            push_bytes(&mut script, view(" > "));
            sh_word(&mut script, view(log_path));
            push_bytes(&mut script, view(" 2>&1\nprintf '%s' \"$?\" > "));
            sh_word(&mut script, view(rc_path));
            push_bytes(&mut script, view("\n"));
            if o.fail_fast != 0 {
                push_bytes(&mut script, view("if [ 0 != \"$(cat "));
                sh_word(&mut script, view(rc_path));
                push_bytes(&mut script, view(")\" ]; then printf 1 > "));
                sh_word(&mut script, view(stop));
                push_bytes(&mut script, view("; fi\nfi\n"));
            }
            i += jobs;
        }
        push_bytes(&mut script, view(") &\n"));
        w += 1;
    }
    push_bytes(&mut script, view("wait\n"));
    mut shell = u8[][copy(view("sh")), copy(view("-c")), script];
    host::command(shell);
    mut passed: u64 = 0;
    mut failed: u64 = 0;
    mut skipped: u64 = 0;
    mut i: u64 = 0;
    while i < selected.len() {
        f := item(&selected, i);
        host::print(view("test "));
        host::print(view(f));
        // No status file: --fail-fast stopped the run before this test started. (`host::read_file`
        // aborts on a missing file, so the check is the file's existence, not its length.)
        if host::exists(view(test_rc(view(f)))) == 0 {
            say(view(" ... skipped"));
            skipped += 1;
            i += 1;
            continue;
        }
        status := number_of(view(host::read_file(view(test_rc(view(f))))));
        if status == 0 {
            say(view(" ... ok"));
            passed += 1;
        } else {
            say(view(" ... FAILED"));
            failed += 1;
            test_failure(view(f), status, view(test_log(view(f))), view(""));
        }
        i += 1;
    }
    test_summary(passed, failed, skipped);
    return failed != 0;
}
fn fmt_command<a>(args: (&a u8[][])) -> u64 {
    o := options(&args);
    mut files = u8[][];
    if o.paths.len() == 0 {
        collect(view("."), &mut files);
    }
    for i in o.paths.len() {
        x := item(&o.paths, i);
        if ends(view(x), view(".grl")) {
            files.push(x);
        } else {
            collect(view(x), &mut files);
        }
    }
    mut changed = 0;
    for i in files.len() {
        f := item(&files, i);
        data := host::read_file(view(f));
        out := fmt::format(view(data));
        if !eq(view(data), view(out)) {
            changed += 1;
            if o.check != 0 {
                say2(view("would reformat "), view(f));
            } else {
                host::write_file(view(f), view(out));
                say2(view("formatted "), view(f));
            }
        }
    }
    if o.check != 0 {
        return changed != 0;
    }
    return 0;
}
fn new_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() == 0 {
        say(view("usage: grail new NAME"));
        return 1;
    }
    name := item(&args, 0);
    if host::exists(view(name)) != 0 {
        say2(view("grail new: already exists: "), view(name));
        return 1;
    }
    host::mkdir(view(name));
    src := path_join(view(name), view("src"));
    host::mkdir(view(src));
    tests := path_join(view(name), view("tests"));
    host::mkdir(view(tests));
    manifest := cat(
        view("[package]\nname = \""),
        view(cat(view(copy(view(name))), view("\"\nversion = \"0.1.0\"\n")))
    );
    pkg := path_join(view(name), view("grail.toml"));
    host::write_file(view(pkg), view(manifest));
    main := path_join(view(src), view("main.grl"));
    host::write_file(view(main), view("fn main() {\n    println(\"Hello, world!\");\n}\n"));
    test := path_join(view(tests), view("smoke.grl"));
    host::write_file(view(test), view("fn main() {\n    assert(1 + 1 == 2);\n}\n"));
    ignore := path_join(view(name), view(".gitignore"));
    host::write_file(view(ignore), view("target/\n"));
    say2(view("created project "), view(name));
    return 0;
}
fn debug_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() < 2 {
        say(view("usage: grail debug lines|info BINARY"));
        return 1;
    }
    sub := item(&args, 0);
    mut dump_flag = u8[];
    mut readelf_flag = u8[];
    if eq(view(sub), view("lines")) {
        dump_flag = copy(view("--debug-line"));
        readelf_flag = copy(view("--debug-dump=decodedline"));
    } else {
        if eq(view(sub), view("info")) {
            dump_flag = copy(view("--debug-info"));
            readelf_flag = copy(view("--debug-dump=info"));
        } else {
            say(view("usage: grail debug lines|info BINARY"));
            return 1;
        }
    }
    binary := item(&args, 1);
    if host::exists(view(binary)) == 0 {
        say(view("grail: no such file: "));
        say(view(binary));
        return 1;
    }
    mut dump = u8[][
        tool(view("GRAIL_DWARFDUMP"), view("llvm-dwarfdump")),
        dump_flag,
        copy(view(binary))
    ];
    if host::command(dump) == 0 {
        return 0;
    }
    say(view("grail: llvm-dwarfdump unavailable; trying readelf"));
    mut decoded = u8[][
        tool(view("GRAIL_READELF"), view("readelf")),
        readelf_flag,
        copy(view(binary))
    ];
    return host::command(decoded);
}
// ---- `grail profile` -------------------------------------------------------------------------
// The target profiles itself: its runtime reads GRAIL_PROFILE from its environment, arms an
// ITIMER_PROF timer and writes the interrupted instruction pointers to the file named there (see
// runtime.grl). This side owns the request, the scratch directory, the ELF symbol table and the
// report; no perf, nm or addr2line is involved, and only the program's own instruction pointer is
// sampled.
struct Symbol {
    start: u64,
    function: u8[],
    module: u8[]
}
fn byte_at<a>(image: &a [u8], at: u64) -> u64 {
    if at < image.len() {
        return u64(image[at]);
    }
    return 0;
}
fn le16<a>(image: &a [u8], at: u64) -> u64 {
    if image.len() < at + 2 {
        return 0;
    }
    return byte_at(view(image), at) + byte_at(view(image), at + 1) * 256;
}
fn le32<a>(image: &a [u8], at: u64) -> u64 {
    if image.len() < at + 4 {
        return 0;
    }
    return le16(view(image), at) + le16(view(image), at + 2) * 65536;
}
fn le64<a>(image: &a [u8], at: u64) -> u64 {
    if image.len() < at + 8 {
        return 0;
    }
    return le32(view(image), at) + le32(view(image), at + 4) * 4294967296;
}
fn bytes_between<a>(image: &a [u8], from: u64, to: u64) -> u8[] {
    mut out = u8[];
    mut i = from;
    while i < to {
        out.push(image[i]);
        i += 1;
    }
    return out;
}
fn cstring_at<a>(image: &a [u8], at: u64) -> u8[] {
    mut out = u8[];
    mut i = at;
    while (i < image.len()) && (image[i] != 0) {
        out.push(image[i]);
        i += 1;
    }
    return out;
}
fn starts_with<a, b>(text: &a [u8], prefix: &b [u8]) -> bool {
    if text.len() < prefix.len() {
        return false;
    }
    for i in prefix.len() {
        if text[i] != prefix[i] {
            return false;
        }
    }
    return true;
}
fn decimal(n: u64) -> u8[] {
    mut out = u8[];
    mut v = n;
    if v == 0 {
        out.push(48);
        return out;
    }
    while 0 < v {
        out.push(48 + v % 10);
        v = v / 10;
    }
    mut flipped = u8[];
    mut i = out.len();
    while 0 < i {
        i -= 1;
        flipped.push(out[i]);
    }
    return flipped;
}
fn number_of<a>(text: &a [u8]) -> u64 {
    mut value: u64 = 0;
    for i in text.len() {
        c := u64(text[i]);
        if (c < 48) || (57 < c) {
            return 0;
        }
        value = value * 10 + (c - 48);
    }
    return value;
}
fn pad_left<a>(text: &a [u8], width: u64) -> u8[] {
    mut out = u8[];
    mut i = text.len();
    while i < width {
        out.push(32);
        i += 1;
    }
    for i in text.len() {
        out.push(text[i]);
    }
    return out;
}
fn padded<a>(text: &a [u8], width: u64) -> u8[] {
    mut out = u8[];
    for i in text.len() {
        out.push(text[i]);
    }
    while out.len() < width {
        out.push(32);
    }
    return out;
}
fn share_text(count: u64, total: u64) -> u8[] {
    if total == 0 {
        return copy(view("0.0%"));
    }
    // One decimal place, rounded to the nearest tenth of a percent.
    tenths := (count * 1000 + total / 2) / total;
    mut out = decimal(tenths / 10);
    out.push(46);
    out.push(48 + tenths % 10);
    out.push(37);
    return out;
}
// Hundredths of a second of measured CPU time, with the unit.
fn nanos_text(ns: u64) -> u8[] {
    if ns == 0 {
        return copy(view("an unknown amount of time"));
    }
    hundredths := (ns + 5000000) / 10000000;
    mut out = decimal(hundredths / 100);
    out.push(46);
    out.push(48 + (hundredths / 10) % 10);
    out.push(48 + hundredths % 10);
    out.push(32);
    out.push(115);
    return out;
}
// Samples per second of measured CPU time: what the kernel actually delivered.
fn effective_rate(count: u64, ns: u64) -> u64 {
    if ns == 0 {
        return 0;
    }
    return count * 1000000000 / ns;
}
// True when the measured rate is less than three quarters of the request, which is how the kernel's
// per-tick accounting shows up above roughly one kHz.
fn capped(requested: u64, count: u64, ns: u64) -> bool {
    if ns == 0 {
        return false;
    }
    return effective_rate(count, ns) * 4 < requested * 3;
}
fn push_text<a>(out: (&mut u8[]), text: &a [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
}
fn push_line<a>(out: (&mut u8[]), text: &a [u8]) -> unit {
    push_text(&mut out, view(text));
    out.push(10);
}
// Every STT_FUNC symbol in .symtab, split into `f_<module>_<function>`. The compiler emits no
// st_size for its functions, so a range runs from a symbol's start to the next symbol's start.
fn elf_symbols<a>(image: &a [u8]) -> Symbol[] {
    mut out = Symbol[];
    if image.len() < 64 {
        return out;
    }
    if (image[0] != 127) || (image[1] != 69) || (image[2] != 76) || (image[3] != 70) {
        return out;
    }
    shoff := le64(view(image), 40);
    entsize := le16(view(image), 58);
    count := le16(view(image), 60);
    mut symoff: u64 = 0;
    mut symsize: u64 = 0;
    mut step: u64 = 0;
    mut stroff: u64 = 0;
    mut found: u64 = 0;
    mut i: u64 = 0;
    while i < count {
        base := shoff + i * entsize;
        if le32(view(image), base + 4) == 2 {
            symoff = le64(view(image), base + 24);
            symsize = le64(view(image), base + 32);
            step = le64(view(image), base + 56);
            link := le32(view(image), base + 40);
            stroff = le64(view(image), shoff + link * entsize + 24);
            found = 1;
        }
        i += 1;
    }
    if (found == 0) || (step == 0) {
        return out;
    }
    mut at: u64 = 0;
    while at + step <= symsize {
        entry := symoff + at;
        if byte_at(view(image), entry + 4) % 16 == 2 {
            address := le64(view(image), entry + 8);
            if address != 0 {
                name := cstring_at(view(image), stroff + le32(view(image), entry));
                mut module = u8[];
                mut function = copy(view(name));
                if starts_with(view(name), view("f_")) {
                    mut k: u64 = 2;
                    while (k < name.len()) && (name[k] != 95) {
                        k += 1;
                    }
                    module = bytes_between(view(name), 2, k);
                    function = bytes_between(view(name), k + 1, name.len());
                } else if starts_with(view(name), view("rt_")) {
                    module = copy(view("runtime"));
                }
                out.push(Symbol { start: address, function: function, module: module });
            }
        }
        at += step;
    }
    return out;
}
// Symbol indices ordered by start address.
fn by_start<a>(symbols: (&a Symbol[])) -> u64[] {
    mut order = u64[];
    for i in symbols.len() {
        order.push(i);
    }
    mut k: u64 = 1;
    while k < order.len() {
        mut j = k;
        while 0 < j {
            if symbols[order[j - 1]].start <= symbols[order[j]].start {
                break;
            }
            swapped := order[j - 1];
            order[j - 1] = order[j];
            order[j] = swapped;
            j -= 1;
        }
        k += 1;
    }
    return order;
}
// The symbol whose range holds `pc`, or symbols.len() when no known symbol covers it.
fn symbol_at<a, b>(symbols: (&a Symbol[]), order: (&b u64[]), pc: u64) -> u64 {
    mut lo: u64 = 0;
    mut hi: u64 = order.len();
    while lo < hi {
        mid := lo + (hi - lo) / 2;
        if symbols[order[mid]].start <= pc {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return symbols.len();
    }
    return order[lo - 1];
}
// Symbol indices with at least one sample, most samples first.
fn by_count<a, b>(counts: (&a u64[]), slots: (&b u64[])) -> u64[] {
    mut order = u64[];
    for i in slots.len() {
        if counts[slots[i]] != 0 {
            order.push(slots[i]);
        }
    }
    mut k: u64 = 1;
    while k < order.len() {
        mut j = k;
        while 0 < j {
            if counts[order[j - 1]] >= counts[order[j]] {
                break;
            }
            swapped := order[j - 1];
            order[j - 1] = order[j];
            order[j] = swapped;
            j -= 1;
        }
        k += 1;
    }
    return order;
}
// Where per-run scratch lives: TMPDIR when the environment names one, /tmp otherwise. `grail
// profile` refuses non-Linux targets, so there is no platform-specific temp directory here.
fn profile_temp() -> u8[] {
    named := host::env(view("TMPDIR"));
    if named.len() != 0 {
        return named;
    }
    return copy(view("/tmp"));
}
// A directory of our own for one run: `mkdir` is the atomic claim, so two profilers started in the
// same millisecond cannot share a sample file, and the directory is removed once the report is read.
fn profile_scratch() -> u8[] {
    base := profile_temp();
    stamp := host::now_ms();
    mut n: u64 = 0;
    while n < 10000 {
        name := cat(view("grail-profile-"), view(decimal(stamp + n)));
        dir := path_join(view(base), view(name));
        if host::mkdir(view(dir)) == 0 {
            return dir;
        }
        n += 1;
    }
    return u8[];
}
fn profile_command<a>(args: (&a u8[][])) -> u64 {
    mut rate: u64 = 200;
    mut out_path = u8[];
    mut i: u64 = 0;
    while i < args.len() {
        a := item(&args, i);
        if eq(view(a), view("--")) {
            i += 1;
            break;
        }
        if eq(view(a), view("--rate")) && (i + 1 < args.len()) {
            i += 1;
            rate = number_of(view(item(&args, i)));
        } else if eq(view(a), view("--out")) && (i + 1 < args.len()) {
            i += 1;
            out_path = item(&args, i);
        } else {
            break;
        }
        i += 1;
    }
    mut rest = u8[][];
    while i < args.len() {
        rest.push(item(&args, i));
        i += 1;
    }
    if rest.len() == 0 {
        say(view("usage: grail profile [--rate N] [--out FILE] -- PROGRAM [ARGS]"));
        return 2;
    }
    if (rate == 0) || (1000000 < rate) {
        say(view("grail profile: --rate must be between 1 and 1000000 samples per second"));
        return 2;
    }
    if host::target() != 0 {
        say(view("grail profile: sampling is implemented for Linux x86-64 only"));
        return 2;
    }
    program := item(&rest, 0);
    if host::exists(view(program)) == 0 {
        say(view("grail profile: no such file: "));
        say(view(program));
        return 2;
    }
    // The arming request travels in the child's environment, so the target needs no writable
    // working directory and a killed run cannot leave a stale request behind for the next one.
    dir := profile_scratch();
    if dir.len() == 0 {
        say(view("grail profile: cannot create a directory for the samples under "));
        say(view(profile_temp()));
        return 2;
    }
    samples := path_join(view(dir), view("samples"));
    mut text = decimal(1);
    text.push(32);
    text = cat(view(text), view(decimal(rate)));
    text.push(32);
    text = cat(view(text), view(decimal(65536)));
    text.push(32);
    text = cat(view(text), view(samples));
    // The inherited environment plus the request, so the profiled program still sees everything it
    // would have seen; a child started with an explicit environment is not armed unless it copies
    // this entry.
    mut environment = host::environment();
    environment.push(cat(view("GRAIL_PROFILE="), view(text)));
    mut command = u8[][];
    command.push(item(&rest, 0));
    for n in rest.len() {
        if n != 0 {
            command.push(item(&rest, n));
        }
    }
    status := host::command_with(command, environment);
    mut out = u8[];
    mut title = cat(view("grail profile: "), view(program));
    push_line(&mut out, view(title));
    if host::exists(view(samples)) == 0 {
        push_line(
            &mut out,
            view("  no samples: the target did not arm the sampling runtime at startup")
        );
        say(view(out));
        host::remove(view(dir), 1);
        return status;
    }
    data := host::read_file(view(samples));
    host::remove(view(samples), 0);
    host::remove(view(dir), 1);
    if data.len() < 48 {
        say(view("grail profile: truncated sample file"));
        return 1;
    }
    if (data[0] != 71) || (data[6] != 50) {
        say(
            view("grail profile: unsupported sample format; rebuild the program with this compiler")
        );
        return 1;
    }
    sample_rate := le64(view(data), 8);
    capacity := le64(view(data), 16);
    count := le64(view(data), 24);
    dropped := le64(view(data), 32);
    cpu_ns := le64(view(data), 40);
    if data.len() < 48 + count * 8 {
        say(view("grail profile: truncated sample file"));
        return 1;
    }
    image := host::read_file(view(program));
    symbols := elf_symbols(view(image));
    kind := le16(view(image), 16);
    mut elf = false;
    if 4 <= image.len() {
        if (image[0] == 127) && (image[1] == 69) && (image[2] == 76) && (image[3] == 70) {
            elf = true;
        }
    }
    if !elf {
        push_line(
            &mut out,
            view("  not an ELF image: no symbols to attribute, every sample is [unknown]")
        );
    } else if kind == 3 {
        push_line(
            &mut out,
            view("  position independent (ET_DYN): sample addresses are relocated")
        );
        push_line(
            &mut out,
            view("  and cannot be matched to link-time symbols, so every sample is [unknown]")
        );
    } else {
        push_line(
            &mut out,
            view(
                "  non-PIE (ET_EXEC): sample addresses are link-time .symtab addresses, no adjustment"
            )
        );
    }
    mut intro = cat(view("  "), view(decimal(sample_rate)));
    intro = cat(view(intro), view(" Hz ITIMER_PROF, "));
    intro = cat(view(intro), view(decimal(count)));
    intro = cat(view(intro), view(" samples in "));
    intro = cat(view(intro), view(nanos_text(cpu_ns)));
    intro = cat(view(intro), view(" of CPU time"));
    if cpu_ns != 0 {
        intro = cat(view(intro), view(" (effective "));
        intro = cat(view(intro), view(decimal(effective_rate(count, cpu_ns))));
        intro = cat(view(intro), view(" Hz)"));
    }
    push_line(&mut out, view(intro));
    if capped(sample_rate, count, cpu_ns) {
        push_line(
            &mut out,
            view("  the effective rate is far below the request: the kernel accounts CPU time per")
        );
        push_line(
            &mut out,
            view("  tick, so intervals shorter than its granularity are rounded up")
        );
    }
    mut dropped_line = cat(view("  "), view(decimal(dropped)));
    dropped_line = cat(view(dropped_line), view(" samples dropped after the "));
    dropped_line = cat(view(dropped_line), view(decimal(capacity)));
    dropped_line = cat(view(dropped_line), view("-sample buffer filled"));
    if dropped != 0 {
        push_line(&mut out, view(dropped_line));
    }
    order := by_start(&symbols);
    mut counts = u64[];
    for n in symbols.len() + 1 {
        counts.push(0);
    }
    if elf && (kind != 3) {
        mut k: u64 = 0;
        while k < count {
            slot := symbol_at(&symbols, &order, le64(view(data), 48 + k * 8));
            counts[slot] = counts[slot] + 1;
            k += 1;
        }
    } else {
        counts[symbols.len()] = count;
    }
    mut width: u64 = 20;
    for n in symbols.len() {
        if width < symbols[n].function.len() {
            width = symbols[n].function.len();
        }
    }
    push_line(&mut out, view(""));
    mut header = copy(view("  "));
    header = cat(view(header), view(pad_left(view("samples"), 7)));
    header = cat(view(header), view(" "));
    header = cat(view(header), view(pad_left(view("share"), 6)));
    header = cat(view(header), view("  "));
    header = cat(view(header), view(padded(view("function"), width + 2)));
    header = cat(view(header), view("module"));
    push_line(&mut out, view(header));
    rows := by_count(&counts, &order);
    for n in rows.len() {
        s := &symbols[rows[n]];
        mut line = copy(view("  "));
        line = cat(view(line), view(pad_left(view(decimal(counts[rows[n]])), 7)));
        line = cat(view(line), view(" "));
        line = cat(view(line), view(pad_left(view(share_text(counts[rows[n]], count)), 6)));
        line = cat(view(line), view("  "));
        line = cat(view(line), view(padded(view(s.function), width + 2)));
        line = cat(view(line), view(s.module));
        push_line(&mut out, view(line));
    }
    mut unknown = copy(view("  "));
    unknown = cat(view(unknown), view(pad_left(view(decimal(counts[symbols.len()])), 7)));
    unknown = cat(view(unknown), view(" "));
    unknown = cat(view(unknown), view(pad_left(view(share_text(counts[symbols.len()], count)), 6)));
    unknown = cat(view(unknown), view("  "));
    unknown = cat(view(unknown), view(padded(view("[unknown]"), width + 2)));
    unknown = cat(view(unknown), view("-"));
    push_line(&mut out, view(unknown));
    mut total = copy(view("  "));
    total = cat(view(total), view(pad_left(view(decimal(count)), 7)));
    total = cat(view(total), view(" "));
    total = cat(view(total), view(pad_left(view(share_text(count, count)), 6)));
    total = cat(view(total), view("  total"));
    push_line(&mut out, view(total));
    host::print(view(out));
    if out_path.len() != 0 {
        if host::write_file(view(out_path), out) != 0 {
            say(view("grail profile: cannot write "));
            say(view(out_path));
            return 1;
        }
    }
    return status;
}

// `grail doc [--out DIR] [FILES or DIRS]`: the reference documentation of a source tree, as one HTML
// page per module plus a JSON index (compiler/docgen.grl). The default is the standard library into
// `docs/api`.
fn doc_usage() -> unit {
    say(view("usage: grail doc [--out DIR] [FILES or DIRS]   (default: docs/api from lib/)"));
    say(view("       the documentation of a declaration is the // comment block directly above it"));
}
fn put_label<a>(out: (&a mut u8[]), text: &a [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
    return ();
}
fn doc_command<a>(args: (&a u8[][])) -> u64 {
    mut dir = copy(view("docs/api"));
    mut paths = u8[][];
    mut i: u64 = 0;
    while i < args.len() {
        a := item(&args, i);
        if (eq(view(a), view("--out"))) & (i + 1 < args.len()) {
            i += 1;
            dir = item(&args, i);
        } else if starts(view(a), view("--out=")) {
            dir = tail_from(view(a), 6);
        } else if starts(view(a), view("--")) {
            doc_usage();
            return 1;
        } else {
            paths.push(a);
        }
        i += 1;
    }
    if paths.len() == 0 {
        paths.push(copy(view("lib")));
    }
    mut files = u8[][];
    for i in paths.len() {
        x := item(&paths, i);
        if ends(view(x), view(".grl")) {
            files.push(x);
        } else {
            collect(view(x), &mut files);
        }
    }
    if files.len() == 0 {
        say(view("grail doc: no .grl sources found in the paths given"));
        return 1;
    }
    // The sources the tree documents, named in the index: the paths as given, one line.
    mut label = u8[];
    for i in paths.len() {
        if 0 < i {
            label.push(32);
        }
        put_label(&mut label, view(item(&paths, i)));
    }
    return docgen::write(&files, view(dir), view(label));
}
fn help() {
    say(view("grail - the Grail compiler and project tool\n"));
    say(view("usage:"));
    say(
        view(
            "  grail build [FILE.grl] [-o OUT] [--target x86_64|aarch64|riscv64|macos-x86_64|macos-aarch64] [--split] [--cache] [--overflow=wrap|checked] [--interface DIR [--verify]]"
        )
    );
    say(view("  grail check [FILE.grl]            type-check without building"));
    say(view("  grail check --watch [--json] [--interval MS] [--debounce MS]   re-check on every change"));
    say(view("  grail build --watch [--json] [--interval MS] [--debounce MS]   re-build on every change"));
    say(view("  grail check --diagnostics-json FILE   diagnostics as JSON records, nothing printed"));
    say(view("  grail check --interface DIR       write one checked interface per module"));
    say(
        view(
            "  grail check --interface DIR --verify   refuse an interface that disagrees with its sources"
        )
    );
    say(view("  grail debug lines|info BINARY     print DWARF line rows or .debug_info"));
    say(
        view(
            "  grail cache prune [--keep N]       drop cache entries no build used in the last N (10)"
        )
    );
    say(view("  grail cache clear                  empty the build cache"));
    say(view("  grail explain CODE                 what an error code means (error[E0004])"));
    say(view("  grail doc [--out DIR] [FILES|DIRS] reference documentation: HTML per module + index.json"));
    say(view("  grail bindgen HEADER.h -o OUT.grl  import a C header as extern \"C\" declarations [-I DIR] [-l LIB]"));
    say(view("  grail profile [--rate N] [--out FILE] -- PROGRAM [ARGS]   sampling profile"));
    say(view("  grail run [FILE.grl] [-- ARGS...]"));
    say(view("  grail test [FILES or DIRS] [--filter TEXT] [--list] [--shard i/n] [--jobs N] [--fail-fast]"));
    say(view("                                    compile and run tests/ (in the Grail tree: the regression corpus)"));
    say(view("  grail fmt [--check] [FILES or DIRS]"));
    say(view("  grail new NAME                    create a project (grail.toml, src/, tests/)"));
    say(
        view(
            "  grail add NAME[@REQ]              add a registry dependency (resolves and locks it)"
        )
    );
    say(view("  grail add --path DIR              add a path dependency"));
    say(
        view("  grail add --git URL [--rev R]     add a git dependency (--rev, --tag or --branch)")
    );
    say(view("  grail remove NAME                 drop a dependency and re-resolve"));
    say(view("  grail update [NAME...]            re-resolve, then fetch what the lock names"));
    say(
        view("  grail fetch [--force]             make the store hold exactly what grail.lock says")
    );
    say(view("  grail tree                        print the resolved dependency graph"));
    say(view("  (--offline works on add, update and fetch: no git or curl is run)"));
    say(view("  grail iface dump FILE        render the typed records one interface carries"));
    say(view("  grail iface roundtrip FILE   read it back, write it again, compare byte for byte"));
    say(
        view(
            "  grail [--target T] [--overflow=checked|wrap] OUT.s ENTRY.grl MODULE.grl...  (compiler)"
        )
    );
}
// `grail iface dump FILE` and `grail iface roundtrip FILE`: the typed record tree an interface
// carries, rendered field by field, and the proof that reading it back and writing it again
// reproduces the file byte for byte. Both run the compiler itself, because the dump *is* the
// reader's own view of the file - there is no second parser, and so no third spelling to drift.
fn iface_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() < 2 {
        say(view("usage: grail iface dump FILE | grail iface roundtrip FILE"));
        return 1;
    }
    what := item(&args, 0);
    mut flag = copy(view("--iface-dump"));
    if eq(view(what), view("roundtrip")) {
        flag = copy(view("--iface-roundtrip"));
    } else {
        if !eq(view(what), view("dump")) {
            say(view("grail: iface takes `dump` or `roundtrip`"));
            return 1;
        }
    }
    mut argv = u8[][host::exe_path(), flag, item(&args, 1)];
    return host::command(argv);
}
pub fn is_command<a>(name: &a [u8]) -> bool {
    return eq(view(name), view("build"))
        || eq(view(name), view("iface"))
        || eq(view(name), view("check"))
        || eq(view(name), view("run"))
        || eq(view(name), view("test"))
        || eq(view(name), view("fmt"))
        || eq(view(name), view("new"))
        || eq(view(name), view("add"))
        || eq(view(name), view("fetch"))
        || eq(view(name), view("remove"))
        || eq(view(name), view("update"))
        || eq(view(name), view("tree"))
        || eq(view(name), view("debug"))
        || eq(view(name), view("profile"))
        || eq(view(name), view("cache"))
        || eq(view(name), view("explain"))
        || eq(view(name), view("doc"))
        || eq(view(name), view("bindgen"))
        || eq(view(name), view("install"))
        || eq(view(name), view("help"))
        || eq(view(name), view("--help"))
        || eq(view(name), view("version"))
        || eq(view(name), view("--version"));
}
pub fn run() -> u64 {
    name := host::arg(1);
    mut args = u8[][];
    mut i = 2;
    while i < host::argc() {
        args.push(host::arg(i));
        i += 1;
    }
    if eq(view(name), view("build")) {
        mut o = options(&args);
        return build(&args, &mut o);
    }
    if eq(view(name), view("iface")) {
        return iface_command(&args);
    }
    if eq(view(name), view("check")) {
        return check_command(&args);
    }
    if eq(view(name), view("run")) {
        return run_command(&args);
    }
    if eq(view(name), view("test")) {
        return test_command(&args);
    }
    if eq(view(name), view("fmt")) {
        return fmt_command(&args);
    }
    if eq(view(name), view("new")) {
        return new_command(&args);
    }
    // The package manager owns these five commands (module pkg, docs/design/package-manager.md).
    if eq(view(name), view("add")) || eq(view(name), view("remove")) {
        return pkg::command(view(name), &args);
    }
    if eq(view(name), view("update"))
        || eq(view(name), view("fetch"))
        || eq(view(name), view("tree")) {
        return pkg::command(view(name), &args);
    }
    if eq(view(name), view("debug")) {
        return debug_command(&args);
    }
    if eq(view(name), view("cache")) {
        return cache_command(&args);
    }
    if eq(view(name), view("explain")) {
        // `grail explain E0004`: what an error code means and how it is usually fixed.
        if args.len() != 1 {
            say(view("usage: grail explain CODE   (the code an error prints, as in error[E0004])"));
            return 1;
        }
        text := explain::text(view(item(&args, 0)));
        if text.len() == 0 {
            say(view("grail: no such error code"));
            return 1;
        }
        host::print(view(text));
        return 0;
    }
    if eq(view(name), view("bindgen")) {
        return bindgen::run(&args);
    }
    if eq(view(name), view("doc")) {
        return doc_command(&args);
    }
    if eq(view(name), view("profile")) {
        return profile_command(&args);
    }
    if eq(view(name), view("version")) || eq(view(name), view("--version")) {
        out := cat(view("grail "), view(pkg::grail_version()));
        say(view(out));
        return 0;
    }
    help();
    return 0;
}
