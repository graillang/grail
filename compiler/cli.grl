module cli;
use host;
use fmt;
use explain;

// The `grail` command-line tool. The same binary is the compiler: subcommands drive it by
// re-invoking itself (`grail [--target T] OUT.s ENTRY.grl MODULE.grl...`), then assemble and link.
struct Home {
    runtime: u8[],
    os: u8[],
    std: u8[]
}
struct Project {
    name: u8[],
    entry: u8[],
    deps: u8[][],
    urls: u8[][],
    revs: u8[][]
}

fn eq<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn starts<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() < y.len() {
        return false;
    }
    for i in y.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn ends<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() < y.len() {
        return false;
    }
    d := x.len() - y.len();
    for i in y.len() {
        if x[d + i] != y[i] {
            return false;
        }
    }
    return true;
}
fn cat<a, b>(x: &a [u8], y: &b [u8]) -> u8[] {
    mut o = u8[];
    for i in x.len() {
        o.push(x[i]);
    }
    for i in y.len() {
        o.push(y[i]);
    }
    return o;
}
fn copy<a>(x: &a [u8]) -> u8[] {
    mut o = u8[];
    for i in x.len() {
        o.push(x[i]);
    }
    return o;
}
fn push_bytes<a, b>(out: (&a mut u8[]), s: &b [u8]) -> unit {
    for i in s.len() {
        out.push(s[i]);
    }
    return ();
}
fn path_join<a, b>(dir: &a [u8], name: &b [u8]) -> u8[] {
    if (dir.len() == 0) || eq(view(dir), view(".")) {
        return copy(view(name));
    }
    if ends(view(dir), view("/")) {
        return cat(view(dir), view(name));
    }
    mut o = copy(view(dir));
    o.push(47);
    for i in name.len() {
        o.push(name[i]);
    }
    return o;
}
fn dirname<a>(p: &a [u8]) -> u8[] {
    mut i = p.len();
    while 0 < i {
        i -= 1;
        if p[i] == 47 {
            mut o = u8[];
            for j in i {
                o.push(p[j]);
            }
            if i == 0 {
                o.push(47);
            }
            return o;
        }
    }
    return copy(view("."));
}
fn basename<a>(p: &a [u8]) -> u8[] {
    mut start = 0;
    for i in p.len() {
        if p[i] == 47 {
            start = i + 1;
        }
    }
    mut o = u8[];
    mut end = p.len();
    if ends(view(p), view(".grl")) {
        end -= 4;
    }
    mut i = start;
    while i < end {
        o.push(p[i]);
        i += 1;
    }
    return o;
}
fn say<a>(s: &a [u8]) {
    host::print(s);
    host::print(view("\n"));
}
fn say2<a, b>(s: &a [u8], t: &b [u8]) {
    host::print(s);
    host::print(t);
    host::print(view("\n"));
}
fn item<a>(v: (&a u8[][]), i: u64) -> u8[] {
    x := &v[i];
    return x.copy();
}
fn words<a>(line: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut cur = u8[];
    for i in line.len() {
        c := line[i];
        if c == 32 || c == 9 || c == 13 {
            if cur.len() != 0 {
                out.push(exchange(&mut cur, u8[]));
            }
        } else {
            cur.push(c);
        }
    }
    if cur.len() != 0 {
        out.push(cur);
    }
    return out;
}
fn lines<a>(text: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut cur = u8[];
    for i in text.len() {
        c := text[i];
        if c == 10 {
            out.push(exchange(&mut cur, u8[]));
        } else {
            cur.push(c);
        }
    }
    if cur.len() != 0 {
        out.push(cur);
    }
    return out;
}

fn home() -> Home {
    env := host::env(view("GRAIL_HOME"));
    if env.len() != 0 {
        installed := path_join(view(env), view("runtime.grl"));
        if host::exists(view(installed)) != 0 {
            os := path_join(view(dirname(view(installed))), view("os-linux.grl"));
            return Home {
                runtime: installed,
                os: os,
                std: path_join(view(env), view("std"))
            };
        }
        repo := path_join(view(env), view("compiler/runtime.grl"));
        if host::exists(view(repo)) != 0 {
            os := path_join(view(dirname(view(repo))), view("os-linux.grl"));
            return Home {
                runtime: repo,
                os: os,
                std: path_join(view(env), view("lib"))
            };
        }
    }
    exe := host::exe_path();
    mut dir = dirname(view(exe));
    for level in 6 {
        installed := path_join(view(dir), view("lib/grail/runtime.grl"));
        if host::exists(view(installed)) != 0 {
            prefix := path_join(view(dir), view("lib/grail"));
            os := path_join(view(prefix), view("os-linux.grl"));
            return Home {
                runtime: installed,
                os: os,
                std: path_join(view(prefix), view("std"))
            };
        }
        repo := path_join(view(dir), view("compiler/runtime.grl"));
        if host::exists(view(repo)) != 0 {
            os := path_join(view(dirname(view(repo))), view("os-linux.grl"));
            return Home {
                runtime: repo,
                os: os,
                std: path_join(view(dir), view("lib"))
            };
        }
        dir = path_join(view(dir), view(".."));
    }
    say(view("grail: cannot find the Grail runtime; set GRAIL_HOME"));
    return Home { runtime: u8[], os: u8[], std: u8[] };
}
fn collect<a, b>(dir: &a [u8], out: (&b mut u8[][])) {
    entries := host::list_dir(view(dir));
    for i in entries.len() {
        name := item(&entries, i);
        if ends(view(name), view("/")) {
            if !(starts(view(name), view(".")) || eq(view(name), view("target/"))) {
                sub := path_join(view(dir), view(name));
                collect(view(sub), &mut out);
            }
        } else {
            if ends(view(name), view(".grl")) {
                out.push(path_join(view(dir), view(name)));
            }
        }
    }
}
// The names in `use NAME;` / `use NAME::...;` lines of a source file.
fn use_names<a>(text: &a [u8]) -> u8[][] {
    mut out = u8[][];
    mut start: u64 = 0;
    mut i: u64 = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut a = start;
            while (a < i) && ((text[a] == 32) || (text[a] == 9)) {
                a += 1;
            }
            if (i - a > 4) && (text[a] == 117) && (text[a + 1] == 115) && (text[a + 2] == 101) && (text[a + 3] == 32) {
                mut b = a + 4;
                while (b < i) && (text[b] == 32) {
                    b += 1;
                }
                mut name = u8[];
                while b < i {
                    ch := text[b];
                    ok := ((ch >= 97) && (ch <= 122)) || ((ch >= 65) && (ch <= 90)) || ((ch >= 48) && (ch <= 57)) || (ch == 95);
                    if ok == false {
                        break;
                    }
                    name.push(ch);
                    b += 1;
                }
                if name.len() > 0 {
                    out.push(name);
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return out;
}
fn contains_name<a, b>(list: (&a u8[][]), name: &b [u8]) -> bool {
    for i in list.len() {
        if eq(view(list[i]), view(name)) {
            return true;
        }
    }
    return false;
}
// Standard-library files reachable from `sources` through `use`, in discovery order.
fn used_std<a, b>(std: &a [u8], sources: (&b u8[][])) -> u8[][] {
    mut queue = u8[][];
    for i in sources.len() {
        queue.push(item(&sources, i));
    }
    mut seen = u8[][];
    mut out = u8[][];
    // core is always compiled: `Some(x)` and `None` lower to its constructors.
    prelude := path_join(view(std), view("core.grl"));
    if host::exists(view(prelude)) != 0 {
        seen.push(copy(view("core")));
        out.push(copy(view(prelude)));
    }
    mut k: u64 = 0;
    while k < queue.len() {
        file := item(&queue, k);
        k += 1;
        text := host::read_file(view(file));
        names := use_names(view(text));
        for n in names.len() {
            name := item(&names, n);
            if !contains_name(&seen, view(name)) {
                seen.push(copy(view(name)));
                candidate := path_join(view(std), view(cat(view(name), view(".grl"))));
                if host::exists(view(candidate)) != 0 {
                    out.push(copy(view(candidate)));
                    queue.push(candidate);
                }
            }
        }
    }
    return out;
}
// The compiler's link requests: each `// grail-link: INPUT` line of the assembly. Absolute paths
// and flags pass through, relative object/archive/shared inputs resolve against `base` (the entry
// file's directory) and bare names become -lNAME. Duplicates are dropped.
fn link_inputs<a, b>(asm: &a [u8], base: &b [u8]) -> u8[][] {
    text := host::read_file(view(asm));
    prefix := "// grail-link: ";
    mut out = u8[][];
    mut start: u64 = 0;
    mut i: u64 = 0;
    while i <= text.len() {
        if (i == text.len()) || (text[i] == 10) {
            mut line = u8[];
            for j in i - start {
                line.push(text[start + j]);
            }
            if starts(view(line), view(prefix)) {
                mut input = u8[];
                mut k = prefix.len();
                while k < line.len() {
                    input.push(line[k]);
                    k += 1;
                }
                while (input.len() > 0) && ((input[input.len() - 1] == 32) || (input[input.len() - 1] == 13)) {
                    input.pop();
                }
                mut arg = u8[];
                if (input.len() > 0) && ((input[0] == 47) || (input[0] == 45)) {
                    arg = input.copy();
                } else {
                    mut has_slash = false;
                    for j in input.len() {
                        if input[j] == 47 {
                            has_slash = true;
                        }
                    }
                    if has_slash || ends(view(input), view(".o")) || ends(view(input), view(".a")) || ends(view(input), view(".so")) || ends(view(input), view(".dylib")) {
                        arg = path_join(view(base), view(input));
                    } else {
                        arg = cat(view("-l"), view(input));
                    }
                }
                mut seen = 0;
                for j in out.len() {
                    if eq(view(item(&out, j)), view(arg)) {
                        seen = 1;
                    }
                }
                if (seen == 0) && (arg.len() > 0) {
                    out.push(arg);
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return out;
}
// A shared-library input (-lNAME) makes the ELF executable dynamically linked: ld.lld then needs
// the platform loader, the system library directories, which it has no defaults for, and libc.
fn dynamic_link_flags<a, b>(target: &a [u8], inputs: (&b u8[][])) -> u8[][] {
    mut out = u8[][];
    mut shared = 0;
    for i in inputs.len() {
        if starts(view(item(&inputs, i)), view("-l")) {
            shared = 1;
        }
    }
    if shared == 0 {
        return out;
    }
    mut loaders = u8[][copy(view("/lib64/ld-linux-x86-64.so.2")), copy(view("/lib/ld-linux-x86-64.so.2"))];
    if eq(view(target), view("aarch64")) {
        loaders = u8[][copy(view("/lib/ld-linux-aarch64.so.1"))];
    }
    if eq(view(target), view("riscv64")) {
        loaders = u8[][copy(view("/lib/ld-linux-riscv64-lp64d.so.1")), copy(view("/lib/ld-linux-riscv64-lp64.so.1"))];
    }
    for i in loaders.len() {
        candidate := item(&loaders, i);
        if host::exists(view(candidate)) != 0 {
            out.push(copy(view("--dynamic-linker")));
            out.push(candidate);
            break;
        }
    }
    out.push(copy(view("-L/usr/lib")));
    out.push(copy(view("-L/usr/lib64")));
    // A dynamic process has loaded libc whatever it named, and the runtime creates its threads
    // through pthread_create so each has a libc TCB (docs/ffi.md); a weak reference only binds
    // when libc is on the link line.
    out.push(copy(view("-lc")));
    return out;
}
// ---- split assembly (B1 stage 1) ----
// With `--split` the compiler writes one assembly file per module plus OUT.parts, which lists them
// in link order and carries the `// grail-link:` request a single-file build puts at the head of
// its assembly. The parts are assembled concurrently and linked once.
struct Split {
    asm: u8[][],
    objects: u8[][],
    link: u8[][]
}
fn with_object_ext<a>(path: &a [u8]) -> u8[] {
    mut n = path.len();
    if (n > 1) & (path[n - 1] == 115) & (path[n - 2] == 46) {
        n = n - 2;
    }
    mut out = u8[];
    for i in n {
        out.push(path[i]);
    }
    push_bytes(&mut out, view(".o"));
    return out;
}
fn read_split<a, b>(manifest: &a [u8], base: &b [u8]) -> Split {
    text := host::read_file(view(manifest));
    mut parts = u8[][];
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        if (row.len() != 0) & !starts(view(row), view("//")) {
            parts.push(copy(view(row)));
        }
    }
    mut objects = u8[][];
    for i in parts.len() {
        part := item(&parts, i);
        objects.push(with_object_ext(view(part)));
    }
    return Split { asm: parts, objects: objects, link: link_inputs(view(manifest), view(base)) };
}
// Quote one argument for `sh -c`: single quotes keep every byte except a quote itself, which the
// usual close-escape-reopen sequence carries.
fn sh_word<a, b>(out: (&a mut u8[]), word: &b [u8]) -> unit {
    out.push(39);
    for i in word.len() {
        b := word[i];
        if b == 39 {
            out.push(39);
            out.push(92);
            out.push(39);
            out.push(39);
        } else {
            out.push(b);
        }
    }
    out.push(39);
    return ();
}
// Assemble every part at once: one assembler process per part, waited on together, so a build with
// many modules pays for the slowest one instead of their sum. The driver has no process API of its
// own, so the parallelism comes from the shell; a failure in any part fails the build.
fn assemble_parts<a, b, d>(prefix: (&a u8[][]), parts: (&b u8[][]), objects: (&d u8[][])) -> u64 {
    mut script = u8[];
    push_bytes(&mut script, view("set -e\npids=''\n"));
    for i in parts.len() {
        for j in prefix.len() {
            word := item(&prefix, j);
            sh_word(&mut script, view(word));
            script.push(32);
        }
        source := item(&parts, i);
        object := item(&objects, i);
        sh_word(&mut script, view(source));
        push_bytes(&mut script, view(" -o "));
        sh_word(&mut script, view(object));
        push_bytes(&mut script, view(" &\npids=\"$pids $!\"\n"));
    }
    push_bytes(&mut script, view("for p in $pids; do wait \"$p\" || exit 1; done\n"));
    mut command = u8[][copy(view("sh")), copy(view("-c")), script];
    return host::command(command);
}
// A --check build removes what the compiler wrote instead of publishing it.
fn remove_split<a>(output: &a [u8]) -> unit {
    manifest := cat(view(output), view(".parts"));
    text := host::read_file(view(manifest));
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        if (row.len() != 0) & !starts(view(row), view("//")) {
            host::remove(view(row), 0);
        }
    }
    host::remove(view(manifest), 0);
    return ();
}
fn target_name(t: u64) -> u8[] {
    if t == 1 {
        return copy(view("aarch64"));
    }
    if t == 2 {
        return copy(view("riscv64"));
    }
    return copy(view("x86_64"));
}
// Mach-O targets compile the darwin module, which owns every libSystem call.
fn is_macho<a>(target: &a [u8]) -> bool {
    return eq(view(target), view("macos-x86_64")) || eq(view(target), view("macos-aarch64"));
}
fn tool<a, b>(variable: &a [u8], fallback: &b [u8]) -> u8[] {
    v := host::env(variable);
    if v.len() != 0 {
        return v;
    }
    return copy(fallback);
}
fn compile<a, b, d, e, g>(
    h: (&a Home),
    entry: &b [u8],
    modules: (&d u8[][]),
    output: &e [u8],
    target: &g [u8],
    flags: u64,
    iface: &d [u8],
    verify: u64
) -> u64 {
    return compile_mode(h, entry, modules, output, target, flags, iface, verify);
}
// The compiler invocation, spelled out in one place: the build cache keys on this vector, so a flag
// or an input that the driver passes is in the key by construction and cannot be forgotten there.
//   grail [--target T] [--debug] [--deny-ambient-host] [--split] [--overflow=...]
//         [--interface DIR [--verify-interface]] OUT.s ENTRY.grl MODULE.grl... RUNTIME PLATFORM
fn build_argv<a, b, d, e, g>(h: (&a Home), entry: &b [u8], modules: (&d u8[][]), asm: &e [u8], target: &g [u8], flags: u64, iface: &d [u8], verify: u64) -> u8[][] {
    check_only := flags % 2;
    debug := (flags / 2) % 2;
    deny := (flags / 4) % 2;
    split := (flags / 8) % 2;
    wrap := (flags / 16) % 2;
    checked := (flags / 32) % 2;
    mut command = u8[][host::exe_path(), copy(view("--target")), copy(view(target))];
    if debug != 0 {
        command.push(copy(view("--debug")));
    }
    if deny != 0 {
        command.push(copy(view("--deny-ambient-host")));
    }
    if split != 0 {
        command.push(copy(view("--split")));
    }
    if wrap != 0 {
        command.push(copy(view("--overflow=wrap")));
    }
    if checked != 0 {
        command.push(copy(view("--overflow=checked")));
    }
    // B1 stage 2: `grail check --interface DIR` writes the interfaces, `grail build --interface DIR`
    // reads them instead of the modules' sources, and `--verify` compares the two.
    if iface.len() != 0 {
        emit := u64(check_only != 0) * u64(verify == 0);
        if emit != 0 {
            command.push(copy(view("--emit-interface")));
        } else {
            command.push(copy(view("--interface")));
        }
        command.push(copy(view(iface)));
        if (emit == 0) & (verify != 0) {
            command.push(copy(view("--verify-interface")));
        }
    }
    command.push(copy(view(asm)));
    command.push(copy(view(entry)));
    for i in modules.len() {
        command.push(item(&modules, i));
    }
    // Only the standard-library modules the program reaches through `use` (transitively) are
    // compiled; lib/NAME.grl is module NAME.
    mut sources = u8[][];
    sources.push(copy(view(entry)));
    for i in modules.len() {
        sources.push(item(&modules, i));
    }
    used := used_std(view(h.std), &sources);
    for i in used.len() {
        command.push(item(&used, i));
    }
    command.push(copy(view(h.runtime)));
    // One platform module per target: darwin.grl owns the libSystem boundary, os-linux.grl the
    // Linux syscalls. They define the same rt_syscall* set, so only one may be compiled.
    if is_macho(view(target)) {
        command.push(path_join(view(dirname(view(h.runtime))), view("darwin.grl")));
    } else {
        command.push(copy(view(h.os)));
    }
    return command;
}
// True when the entry or any module source mentions `@embed(`.
fn sources_embed<a, b>(entry: &a [u8], modules: (&b u8[][])) -> bool {
    mut files = u8[][copy(view(entry))];
    for i in modules.len() {
        files.push(item(&modules, i));
    }
    needle := "@embed(";
    for f in files.len() {
        path := item(&files, f);
        if host::exists(view(path)) == 0 {
            continue;
        }
        text := host::read_file(view(path));
        mut i = 0;
        while i + needle.len() <= text.len() {
            mut hit = true;
            for j in needle.len() {
                if text[i + j] != needle[j] {
                    hit = false;
                    break;
                }
            }
            if hit {
                return true;
            }
            i += 1;
        }
    }
    return false;
}
// check_only: type-check and generate code, but do not assemble or link.
fn compile_mode<a, b, d, e, g>(
    h: (&a Home),
    entry: &b [u8],
    modules: (&d u8[][]),
    output: &e [u8],
    target: &g [u8],
    flags: u64,
    iface: &d [u8],
    verify: u64
) -> u64 {
    check_only := flags % 2;
    debug := (flags / 2) % 2;
    deny := (flags / 4) % 2;
    split := (flags / 8) % 2;
    wrap := (flags / 16) % 2;
    checked := (flags / 32) % 2;
    mut cache = (flags / 64) % 2;
    per_module := (flags / 128) % 2;
    if (cache != 0) && sources_embed(view(entry), &modules) {
        // `@embed` reads a file the cache does not key on, so its result cannot be reused safely.
        say(view("grail: --cache is skipped: a source uses @embed, whose file the cache does not track"));
        cache = 0;
    }
    asm := cat(view(output), view(".s"));
    object := cat(view(output), view(".o"));
    // The toolchain is decided by the target alone, so it is known before the compiler runs - which
    // is what lets a build cache key on the assembler and the linker as well as on the sources.
    mut triple = copy(view("--target=x86_64-linux-gnu"));
    mut emulation = copy(view("elf_x86_64"));
    // Mach-O targets reuse the CPU backends but have their own object format and linker.
    mut macho = 0;
    mut arch = copy(view("x86_64"));
    if eq(view(target), view("macos-x86_64")) {
        triple = copy(view("--target=x86_64-apple-macos11"));
        macho = 1;
    }
    if eq(view(target), view("macos-aarch64")) {
        triple = copy(view("--target=arm64-apple-macos11"));
        arch = copy(view("arm64"));
        macho = 1;
    }
    if eq(view(target), view("aarch64")) {
        triple = copy(view("--target=aarch64-linux-gnu"));
        emulation = copy(view("aarch64elf"));
    }
    mut assemble = u8[][tool(view("GRAIL_ASSEMBLER"), view("clang"))];
    if eq(view(target), view("riscv64")) {
        triple = copy(view("--target=riscv64-linux-gnu"));
        emulation = copy(view("elf64lriscv"));
        assemble.push(copy(view("-march=rv64imafd")));
        assemble.push(copy(view("-mabi=lp64d")));
    }
    assemble.push(triple);
    assemble.push(copy(view("-c")));
    command := build_argv(&h, view(entry), &modules, view(asm), view(target), flags, iface, verify);
    // B1 stage 4: an unchanged program is not rebuilt at all, and what is rebuilt assembles and links
    // through the content-addressed store. Without --cache nothing below changes a thing.
    mut store = Cache { root: cache_root(view(target)), fast: 0, tmp: u8[], hits: 0, misses: 0, names: u8[][] };
    mut id = BuildId {
        flags: u8[],
        compiler: u8[],
        assembler: u8[],
        linker: u8[],
        ifaces: u8[],
        iface_dir: u8[],
        sources: u8[][],
        digests: u8[][]
    };
    mut program = u8[];
    if cache != 0 {
        store.fast = cache_hash_tool();
        stage := cache_stage(&mut store);
        store.tmp = path_join(view(stage), view("digest"));
        cache_ensure(&mut store);
        id = cache_build_id(&mut store, &command, view(asm), view(emulation), &assemble);
        program = cache_program_key(&mut store, &id, view(target), view(asm));
        // `--verify` asks for the interfaces to be checked against the sources, and `--check` asks for
        // the program to be checked at all: a build that skips the compiler run has to skip the
        // shortcut instead.
        if (verify == 0) & (check_only == 0) {
            if cache_up_to_date(&mut store, view(program), view(output)) == 1 {
                return 0;
            }
        }
    }
    if per_module != 0 {
        return per_module_build(&command, view(asm), view(output), view(target), view(emulation), &assemble, &mut store, &id, cache);
    }
    if host::command(command) != 0 {
        return 1;
    }
    if check_only != 0 {
        if split != 0 {
            remove_split(view(output));
        } else {
            host::remove(view(asm), 0);
        }
        return 0;
    }
    if eq(view(target), view("windows-x86_64")) {
        say(view("grail: windows-x86_64 images are cross-built with `bun tools/windows.mjs`"));
        return 1;
    }
    if split != 0 {
        if cache != 0 {
            return cache_split(&mut store, &id, view(dirname(view(entry))), view(output), view(target), view(emulation), &assemble, view(program));
        }
        return build_split(view(dirname(view(entry))), view(output), view(target), view(emulation), &assemble);
    }
    assemble.push(copy(view(asm)));
    assemble.push(copy(view("-o")));
    assemble.push(copy(view(object)));
    if host::command(assemble) != 0 {
        say(view("grail: assembling failed (needs clang)"));
        return 1;
    }
    if macho != 0 {
        // Without an SDK there is no libSystem stub to link against, so the object is the result.
        root := host::env(view("GRAIL_SDK"));
        if root.len() == 0 {
            say(view("grail: wrote a Mach-O object; set GRAIL_SDK to a macOS SDK to link it"));
            return 1;
        }
        libs := path_join(view(root), view("usr/lib"));
        mut link = u8[][
            tool(view("GRAIL_LINKER"), view("ld64.lld")),
            copy(view("-arch")),
            arch,
            copy(view("-platform_version")),
            copy(view("macos")),
            copy(view("11.0")),
            copy(view("11.0")),
            copy(view("-syslibroot")),
            copy(view(root)),
            cat(view("-L"), view(libs)),
            copy(view("-lSystem")),
            copy(view("-e")),
            copy(view("_main")),
            copy(view(object)),
            copy(view("-o")),
            copy(view(output))
        ];
        inputs := link_inputs(view(asm), view(dirname(view(entry))));
        for i in inputs.len() {
            link.push(item(&inputs, i));
        }
        if host::command(link) != 0 {
            say(view("grail: linking failed (needs ld64.lld and a macOS SDK)"));
            return 1;
        }
        return 0;
    }
    mut link = u8[][
        tool(view("GRAIL_LINKER"), view("ld.lld")),
        copy(view("-m")),
        emulation,
        copy(view(object))
    ];
    inputs := link_inputs(view(asm), view(dirname(view(entry))));
    for i in inputs.len() {
        link.push(item(&inputs, i));
    }
    dynamic := dynamic_link_flags(view(target), &inputs);
    for i in dynamic.len() {
        link.push(item(&dynamic, i));
    }
    link.push(copy(view("-o")));
    link.push(copy(view(output)));
    if host::command(link) != 0 {
        say(view("grail: linking failed (needs ld.lld)"));
        return 1;
    }
    return 0;
}
// A --split build: the compiler already wrote one assembly file per module and the manifest that
// lists them; assemble them concurrently and link them once, in manifest order.
fn build_split<a, b, d, e, g>(
    base: &a [u8],
    output: &b [u8],
    target: &d [u8],
    emulation: &e [u8],
    prefix: (&g u8[][])
) -> u64 {
    if is_macho(view(target)) {
        say(view("grail: --split is implemented for the Linux x86_64 assembler path"));
        return 1;
    }
    manifest := cat(view(output), view(".parts"));
    text := host::read_file(view(manifest));
    if !starts(view(text), view("// grail-parts 1")) {
        say(view("grail: missing or unreadable parts manifest "));
        say(view(manifest));
        return 1;
    }
    parts := read_split(view(manifest), view(base));
    if parts.asm.len() == 0 {
        say(view("grail: the parts manifest lists no modules"));
        return 1;
    }
    if assemble_parts(&prefix, &parts.asm, &parts.objects) != 0 {
        say(view("grail: assembling failed (needs clang)"));
        return 1;
    }
    return link_objects(view(output), view(target), view(emulation), &parts.objects, &parts.link);
}
// ---- B1 stage 4: one compiler invocation per module (`grail build --per-module`) ----
// The program's sources are grouped by the module each declares; the groups are compiled in
// dependency order, each by its own compiler run that reads only the interfaces of modules built
// before it and writes its own interface beside them, then every run's parts are assembled and the
// program is linked once. A module's run parses that module's source and no other.
struct ModuleGroup {
    name: u8[],
    files: u8[][],
    uses: u8[][],
    done: u64
}
fn ident_byte(c: u8) -> bool {
    return ((c >= 97) & (c <= 122)) || ((c >= 65) & (c <= 90)) || ((c >= 48) & (c <= 57)) || (c == 95);
}
// The word after each line-leading `keyword` of a source file (`module NAME;`, `use NAME;`).
fn scan_words<a, b>(path: &a [u8], keyword: &b [u8]) -> u8[][] {
    text := host::read_file(view(path));
    mut out = u8[][];
    mut i = 0;
    while i < text.len() {
        while (i < text.len()) && ((text[i] == 32) || (text[i] == 9) || (text[i] == 13)) {
            i += 1;
        }
        mut word = u8[];
        while (i < text.len()) && ident_byte(text[i]) {
            word.push(text[i]);
            i += 1;
        }
        if eq(view(word), view(keyword)) {
            while (i < text.len()) && ((text[i] == 32) || (text[i] == 9)) {
                i += 1;
            }
            mut name = u8[];
            while (i < text.len()) && ident_byte(text[i]) {
                name.push(text[i]);
                i += 1;
            }
            if name.len() != 0 {
                out.push(name);
            }
        }
        while (i < text.len()) && (text[i] != 10) {
            i += 1;
        }
        i += 1;
    }
    return out;
}
fn group_of<a, b>(groups: (&a ModuleGroup[]), name: &b [u8]) -> u64 {
    for i in groups.len() {
        if eq(view(groups[i].name), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
fn bytes_less<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    mut i = 0;
    while (i < x.len()) & (i < y.len()) {
        if x[i] != y[i] {
            return x[i] < y[i];
        }
        i += 1;
    }
    return x.len() < y.len();
}
// The cache key of one module's compiler run (B1 stage 4): the build's flags, compiler and assembler,
// the target, the module's name and its own source files, and every interface the run can read - the
// ones written by the runs before it, by name and content. An edit that leaves a module's interface
// unchanged therefore reruns that module alone; one that changes it reruns the modules after it.
fn unit_key<a, b, d, e, g, k>(store: (&a mut Cache), id: (&b BuildId), target: &d [u8], name: &e [u8], files: (&g u8[][]), ifaces: &k [u8]) -> u8[] {
    mut buf = u8[];
    push_bytes(&mut buf, view("grail-cache-unit 1\ntarget "));
    push_bytes(&mut buf, view(target));
    push_bytes(&mut buf, view("\nflags "));
    push_bytes(&mut buf, view(id.flags));
    push_bytes(&mut buf, view("\ncompiler "));
    push_bytes(&mut buf, view(id.compiler));
    push_bytes(&mut buf, view("\nassembler "));
    push_bytes(&mut buf, view(id.assembler));
    push_bytes(&mut buf, view("\nmodule "));
    push_bytes(&mut buf, view(name));
    buf.push(10);
    for i in files.len() {
        f := item(&files, i);
        push_bytes(&mut buf, view("source "));
        push_bytes(&mut buf, view(cache_digest_file(&mut store, view(f))));
        buf.push(32);
        push_bytes(&mut buf, view(f));
        buf.push(10);
    }
    mut names = u8[][];
    listed := host::list_dir(view(ifaces));
    for i in listed.len() {
        n := item(&listed, i);
        if ends(view(n), view(".iface")) {
            mut at = names.len();
            while (0 < at) && bytes_less(view(n), view(names[at - 1])) {
                at -= 1;
            }
            names.insert(at, n);
        }
    }
    for i in names.len() {
        n := item(&names, i);
        // An interface's surface, without the lines that change with its module's body alone: the
        // source file's sha256 and the whole-file digest. An edit that keeps the surface keeps
        // every other module's key.
        text := host::read_file(view(path_join(view(ifaces), view(n))));
        rows := lines(view(text));
        mut surface = u8[];
        for r in rows.len() {
            row := item(&rows, r);
            if !starts(view(row), view("sha256 ")) & !starts(view(row), view("digest ")) {
                push_bytes(&mut surface, view(row));
                surface.push(10);
            }
        }
        push_bytes(&mut buf, view("interface "));
        push_bytes(&mut buf, view(native::iface_digest(&surface)));
        buf.push(32);
        push_bytes(&mut buf, view(n));
        buf.push(10);
    }
    return native::iface_digest(&buf);
}
// Put a module run's outputs back from the store: its parts manifest, its interface and every object
// the manifest names. Any missing or damaged blob makes it a miss (nothing is half-restored that a
// later step would trust: the run that follows rewrites all of it).
fn unit_restore<a, b, d, e, g>(store: (&a mut Cache), key: &b [u8], stem: &d [u8], ifaces: &e [u8], name: &g [u8], base: &d [u8]) -> bool {
    path := cache_record_path(view(store.root), view("unit"), view(key));
    if host::exists(view(path)) == 0 {
        return false;
    }
    cache_touch(view(store.root), view("unit"), view(key));
    text := host::read_file(view(path));
    rows := lines(view(text));
    mut parts_blob = u8[];
    mut iface_blob = u8[];
    mut objs = u8[][];
    for i in rows.len() {
        w := words(view(item(&rows, i)));
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("parts")) {
            parts_blob = item(&w, 1);
        }
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("iface")) {
            iface_blob = item(&w, 1);
        }
        if (2 <= w.len()) & eq(view(item(&w, 0)), view("obj")) {
            objs.push(item(&w, 1));
        }
    }
    if !cache_blob_ok(&mut store, view(parts_blob)) {
        return false;
    }
    for i in objs.len() {
        if !cache_blob_ok(&mut store, view(objs[i])) {
            return false;
        }
    }
    if (iface_blob.len() != 0) && !cache_blob_ok(&mut store, view(iface_blob)) {
        return false;
    }
    manifest := cat(view(stem), view(".parts"));
    if cache_blob_restore(&mut store, view(parts_blob), view(manifest), 0) != 0 {
        return false;
    }
    parts := read_split(view(manifest), view(base));
    if parts.objects.len() != objs.len() {
        return false;
    }
    for i in objs.len() {
        if cache_blob_restore(&mut store, view(objs[i]), view(item(&parts.objects, i)), 0) != 0 {
            return false;
        }
    }
    if iface_blob.len() != 0 {
        dest := path_join(view(ifaces), view(cat(view(name), view(".iface"))));
        if cache_blob_restore(&mut store, view(iface_blob), view(dest), 0) != 0 {
            return false;
        }
    }
    return true;
}
// File a module run's outputs under its key, after they assembled.
fn unit_file<a, b, d, e, g>(store: (&a mut Cache), key: &b [u8], stem: &d [u8], objects: (&e u8[][]), ifaces: &g [u8], name: &g [u8]) -> unit {
    manifest := cat(view(stem), view(".parts"));
    parts_blob := cache_blob_put(&mut store, view(manifest));
    if parts_blob.len() != 64 {
        return ();
    }
    mut record = u8[];
    push_bytes(&mut record, view("// grail-cache-unit 1\nmodule "));
    push_bytes(&mut record, view(name));
    push_bytes(&mut record, view("\nparts "));
    push_bytes(&mut record, view(parts_blob));
    record.push(10);
    iface := path_join(view(ifaces), view(cat(view(name), view(".iface"))));
    if host::exists(view(iface)) != 0 {
        b := cache_blob_put(&mut store, view(iface));
        if b.len() != 64 {
            return ();
        }
        push_bytes(&mut record, view("iface "));
        push_bytes(&mut record, view(b));
        record.push(10);
    }
    for i in objects.len() {
        b := cache_blob_put(&mut store, view(item(&objects, i)));
        if b.len() != 64 {
            return ();
        }
        push_bytes(&mut record, view("obj "));
        push_bytes(&mut record, view(b));
        record.push(10);
    }
    cache_record_put(&mut store, view("unit"), view(key), view(record));
    return ();
}
fn per_module_build<a, b, d, e, g, k, m, n>(
    command: (&a u8[][]),
    asm: &b [u8],
    output: &d [u8],
    target: &e [u8],
    emulation: &g [u8],
    prefix: (&k u8[][]),
    store: (&m mut Cache),
    id: (&n BuildId),
    cache: u64
) -> u64 {
    if !eq(view(target), view("x86_64")) {
        say(view("grail: --per-module is implemented for the linux x86_64 assembler path"));
        return 1;
    }
    mut at = 0;
    while (at < command.len()) && !eq(view(command[at]), view(asm)) {
        at += 1;
    }
    if at == command.len() {
        say(view("grail: --per-module could not find the program's sources in the build command"));
        return 1;
    }
    compiler := item(&command, 0);
    mut flags = u8[][];
    mut i = 1;
    while i < at {
        a := item(&command, i);
        if eq(view(a), view("--interface")) {
            i += 2;
            continue;
        }
        if !eq(view(a), view("--split")) {
            flags.push(a);
        }
        i += 1;
    }
    // Group the sources. The runtime and platform files come last in every build command and declare
    // no module: the compiler treats them as module `runtime`, the base every module's code calls
    // into, so that group is built first. Any other file without a `module` line is the entry's,
    // module `main`.
    mut groups = ModuleGroup[];
    count := command.len() - at - 1;
    for j in count {
        file := item(&command, at + 1 + j);
        names := scan_words(view(file), view("module"));
        mut name = copy(view("main"));
        if count - 2 <= j {
            name = copy(view("runtime"));
        }
        if names.len() != 0 {
            name = item(&names, 0);
        }
        uses := scan_words(view(file), view("use"));
        g := group_of(&groups, view(name));
        if g == 0 {
            groups.push(ModuleGroup { name: name, files: u8[][file], uses: uses, done: 0 });
        } else {
            groups[g - 1].files.push(file);
            for u in uses.len() {
                groups[g - 1].uses.push(item(&uses, u));
            }
        }
    }
    entry_name := groups[0].name.copy();
    base := u8[][copy(view("runtime"))];
    dir := cat(view(output), view(".modules"));
    host::mkdir(view(dir));
    ifaces := path_join(view(dir), view("interfaces"));
    host::mkdir(view(ifaces));
    // Every build writes the interface directory afresh, so a module removed from the program leaves
    // no interface behind for another to read.
    old := host::list_dir(view(ifaces));
    for j in old.len() {
        host::remove(view(path_join(view(ifaces), view(old[j]))), 0);
    }
    mut objects = u8[][];
    mut link = u8[][];
    mut built = 0;
    while built < groups.len() {
        // The next group: a base group first, then any group whose program-local uses are built.
        mut pick = groups.len();
        for g in groups.len() {
            if (pick == groups.len()) && (groups[g].done == 0) {
                mut ready = true;
                mut is_base = false;
                for b in base.len() {
                    if eq(view(base[b]), view(groups[g].name)) {
                        is_base = true;
                    }
                }
                if !is_base {
                    for b in base.len() {
                        bg := group_of(&groups, view(base[b]));
                        if (bg != 0) && (groups[bg - 1].done == 0) {
                            ready = false;
                        }
                    }
                    for u in groups[g].uses.len() {
                        ug := group_of(&groups, view(groups[g].uses[u]));
                        if (ug != 0) && (ug - 1 != g) && (groups[ug - 1].done == 0) {
                            ready = false;
                        }
                    }
                }
                if ready {
                    pick = g;
                }
            }
        }
        if pick == groups.len() {
            say(view("grail: --per-module found a cycle of `use` between modules; build without --per-module"));
            return 1;
        }
        name := groups[pick].name.copy();
        stem := path_join(view(dir), view(name));
        unit_asm := cat(view(stem), view(".s"));
        mut key = u8[];
        mut reused = false;
        if cache != 0 {
            key = unit_key(&mut store, id, view(target), view(name), &groups[pick].files, view(ifaces));
            reused = unit_restore(&mut store, view(key), view(stem), view(ifaces), view(name), view(dir));
            if reused {
                store.hits += 1;
            } else {
                store.misses += 1;
                store.names.push(name.copy());
            }
        }
        mut run = u8[][compiler.copy()];
        for f in flags.len() {
            run.push(item(&flags, f));
        }
        if built != 0 {
            run.push(copy(view("--use")));
            run.push(ifaces.copy());
        }
        run.push(copy(view("--emit-interface")));
        run.push(ifaces.copy());
        run.push(copy(view("--split")));
        if !eq(view(name), view(entry_name)) {
            run.push(copy(view("--no-entry")));
        }
        run.push(unit_asm.copy());
        for f in groups[pick].files.len() {
            run.push(groups[pick].files[f].copy());
        }
        if !reused {
            if host::command(run) != 0 {
                return 1;
            }
        }
        parts := read_split(view(cat(view(stem), view(".parts"))), view(dir));
        if !reused {
            if assemble_parts(&prefix, &parts.asm, &parts.objects) != 0 {
                say(view("grail: assembling failed (needs clang)"));
                return 1;
            }
            if cache != 0 {
                unit_file(&mut store, view(key), view(stem), &parts.objects, view(ifaces), view(name));
            }
        }
        for o in parts.objects.len() {
            objects.push(item(&parts.objects, o));
        }
        for l in parts.link.len() {
            input := item(&parts.link, l);
            mut seen = false;
            for m in link.len() {
                if eq(view(link[m]), view(input)) {
                    seen = true;
                }
            }
            if !seen {
                link.push(input);
            }
        }
        groups[pick].done = 1;
        built += 1;
    }
    if cache != 0 {
        mut line = copy(view("cache: "));
        push_bytes(&mut line, view(decimal(store.hits)));
        push_bytes(&mut line, view(" hit, "));
        push_bytes(&mut line, view(decimal(store.misses)));
        push_bytes(&mut line, view(" miss"));
        if store.names.len() != 0 {
            push_bytes(&mut line, view(" ("));
            for i in store.names.len() {
                if i != 0 {
                    push_bytes(&mut line, view(", "));
                }
                push_bytes(&mut line, view(store.names[i]));
            }
            push_bytes(&mut line, view(")"));
        }
        line.push(10);
        host::print(view(line));
    }
    return link_objects(view(output), view(target), view(emulation), &objects, &link);
}
// One link, from objects already on disk: the cache reuses exactly this, so a cached image and an
// uncached one are the same link of the same objects.
fn link_objects<a, b, d, e, g>(output: &a [u8], target: &b [u8], emulation: &d [u8], objects: (&e u8[][]), inputs: (&g u8[][])) -> u64 {
    mut link = u8[][
        tool(view("GRAIL_LINKER"), view("ld.lld")),
        copy(view("-m")),
        copy(view(emulation))
    ];
    for i in objects.len() {
        link.push(item(&objects, i));
    }
    for i in inputs.len() {
        link.push(item(&inputs, i));
    }
    dynamic := dynamic_link_flags(view(target), inputs);
    for i in dynamic.len() {
        link.push(item(&dynamic, i));
    }
    link.push(copy(view("-o")));
    link.push(copy(view(output)));
    if host::command(link) != 0 {
        say(view("grail: linking failed (needs ld.lld)"));
        return 1;
    }
    return 0;
}
// ---- build cache (B1 stage 4) ----
//
// An unchanged module is not reassembled and an unchanged program is not relinked. Three keys, each
// over exactly what determines the artifact it names (docs/design/separate-compilation.md, "Stage 4
// as built: a build cache"):
//
//   map/prog/<key>   every input the build reads, the compiler and the toolchain  -> the image
//   map/lnk/<key>    the object set, the link inputs and the linker               -> the image
//   map/mod/<key>    one module's inputs and the assembler                        -> its object
//
// The store is content addressed under .work/cache/<target>:
//
//   blob/<sha256>    artifact bytes; the file name is the digest of the bytes inside it
//   map/KIND/<key>   a record: `field value` lines naming the blob the key produced
//   stage/           every write lands here first and is renamed into place, so a crash leaves no
//                    half-written entry
//
// A blob is only reused after its bytes have been hashed again and matched against the name it is
// filed under, so a corrupted, truncated or unreadable entry is a miss - never a wrong build.
//
// The module key is the one the design note asks for: the module's source digest, the digests of the
// interfaces it reads, the compiler's digest, the target, every flag that changes code generation and
// the assembler's identity. It does not cover one thing that today's whole-program front end decides:
// the module's emitted assembly depends on *other* modules' bodies, because the optimizer inlines
// across module boundaries. So a module record also carries the digest of the assembly the object was
// built from, and an entry is only reused when that digest still matches the assembly just emitted.
// When stage 4 proper (one compiler invocation per module) lands, the guard becomes redundant.
struct Cache {
    root: u8[],
    // 1 when the host has sha256sum: a 12 MB compiler binary then hashes in milliseconds instead of
    // the seconds the in-language reader costs.
    fast: u64,
    tmp: u8[],
    hits: u64,
    misses: u64,
    // The modules that missed, in emission order, for the one-line report.
    names: u8[][]
}
struct BuildId {
    flags: u8[],
    compiler: u8[],
    assembler: u8[],
    linker: u8[],
    ifaces: u8[],
    iface_dir: u8[],
    sources: u8[][],
    digests: u8[][]
}
fn cache_root<a>(target: &a [u8]) -> u8[] {
    return cat(view(".work/cache/"), view(target));
}
fn cache_stage<a>(c: (&a mut Cache)) -> u8[] {
    return path_join(view(c.root), view("stage"));
}
fn cache_ensure<a>(c: (&a mut Cache)) -> unit {
    host::mkdir(view(".work"));
    host::mkdir(view(".work/cache"));
    host::mkdir(view(c.root));
    host::mkdir(view(path_join(view(c.root), view("blob"))));
    host::mkdir(view(path_join(view(c.root), view("map"))));
    host::mkdir(view(path_join(view(c.root), view("map/prog"))));
    host::mkdir(view(path_join(view(c.root), view("map/lnk"))));
    host::mkdir(view(path_join(view(c.root), view("map/mod"))));
    host::mkdir(view(path_join(view(c.root), view("map/unit"))));
    host::mkdir(view(path_join(view(c.root), view("stage"))));
    // One generation per build that opens the store: what `grail cache prune` measures age in.
    generation := cache_generation(view(c.root)) + 1;
    host::write_file(view(path_join(view(c.root), view("generation"))), view(decimal(generation)));
    return ();
}
// The store's build counter (0 for a store no build has opened yet).
fn cache_generation<a>(root: &a [u8]) -> u64 {
    path := path_join(view(root), view("generation"));
    if host::exists(view(path)) == 0 {
        return 0;
    }
    return number_of(view(host::read_file(view(path))));
}
// Record that the current build used a record: `map/<kind>/<key>.used` holds its generation.
fn cache_touch<a, b, d>(root: &a [u8], kind: &b [u8], key: &d [u8]) -> unit {
    used := cat(view(cache_record_path(view(root), view(kind), view(key))), view(".used"));
    host::write_file(view(used), view(decimal(cache_generation(view(root)))));
    return ();
}
// Whether `sha256sum` can stand in for the in-language digest. It is the same SHA-256 either way.
fn cache_hash_tool() -> u64 {
    mut run = u8[][
        copy(view("sh")),
        copy(view("-c")),
        copy(view("command -v sha256sum >/dev/null 2>&1"))
    ];
    if host::command(run) == 0 {
        return 1;
    }
    return 0;
}
// The SHA-256 of a file as 64 lowercase hex characters; empty when the file cannot be read.
fn cache_digest_file<a, b>(c: (&a mut Cache), path: &b [u8]) -> u8[] {
    if host::exists(view(path)) == 0 {
        return u8[];
    }
    if c.fast != 0 {
        mut script = u8[];
        push_bytes(&mut script, view("sha256sum "));
        sh_word(&mut script, view(path));
        push_bytes(&mut script, view(" > "));
        sh_word(&mut script, view(c.tmp));
        mut run = u8[][copy(view("sh")), copy(view("-c")), script];
        if host::command(run) == 0 {
            if host::exists(view(c.tmp)) != 0 {
                text := host::read_file(view(c.tmp));
                if 64 <= text.len() {
                    mut out = u8[];
                    for i in 64 {
                        out.push(text[i]);
                    }
                    return out;
                }
            }
        }
    }
    return native::iface_digest(&host::read_file(view(path)));
}
// A toolchain's identity: the words it is invoked with plus the version it reports. Nothing cheaper
// separates two builds of the same tool.
fn cache_tool_id<a, b>(c: (&a mut Cache), words_in: (&b u8[][])) -> u8[] {
    mut text = u8[];
    mut script = u8[];
    for i in words_in.len() {
        word := item(&words_in, i);
        push_bytes(&mut text, view(word));
        text.push(10);
        sh_word(&mut script, view(word));
        script.push(32);
    }
    push_bytes(&mut script, view("--version > "));
    sh_word(&mut script, view(c.tmp));
    push_bytes(&mut script, view(" 2>&1"));
    mut run = u8[][copy(view("sh")), copy(view("-c")), script];
    if host::command(run) == 0 {
        if host::exists(view(c.tmp)) != 0 {
            version := host::read_file(view(c.tmp));
            push_bytes(&mut text, view(version));
        }
    }
    return native::iface_digest(&text);
}
fn cache_record_path<a, b, d>(root: &a [u8], kind: &b [u8], key: &d [u8]) -> u8[] {
    map := path_join(view(root), view("map"));
    dir := path_join(view(map), view(kind));
    return path_join(view(dir), view(key));
}
// One `field value` line of a record; empty when the record is absent or does not have that field.
fn cache_field<a, b, d, e>(root: &a [u8], kind: &b [u8], key: &d [u8], field: &e [u8]) -> u8[] {
    path := cache_record_path(view(root), view(kind), view(key));
    if host::exists(view(path)) == 0 {
        return u8[];
    }
    cache_touch(view(root), view(kind), view(key));
    text := host::read_file(view(path));
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        w := words(view(row));
        if (2 <= w.len()) & eq(view(item(&w, 0)), view(field)) {
            return item(&w, 1);
        }
    }
    return u8[];
}
// The rest of a line after a fixed-length field: paths may contain spaces, so a record names a file
// by writing its digest first and the path after it.
fn cache_rest<a>(row: &a [u8], start: u64) -> u8[] {
    mut i = start;
    while (i < row.len()) & (row[i] == 32) {
        i += 1;
    }
    mut out = u8[];
    while i < row.len() {
        out.push(row[i]);
        i += 1;
    }
    return out;
}
// Publish a record: write it in `stage/`, then rename it into place.
fn cache_record_put<a, b, d, e>(c: (&a mut Cache), kind: &b [u8], key: &d [u8], body: &e [u8]) -> unit {
    stage := cache_stage(&mut c);
    name := cat(view("rec."), view(key));
    pending := path_join(view(stage), view(name));
    if host::write_file(view(pending), view(body)) != 0 {
        return ();
    }
    dest := cache_record_path(view(c.root), view(kind), view(key));
    mut run = u8[][copy(view("mv")), copy(view("-f")), pending, dest];
    host::command(run);
    cache_touch(view(c.root), view(kind), view(key));
    return ();
}
fn hex_byte(b: u8) -> bool {
    return ((48 <= b) & (b <= 57)) || ((97 <= b) & (b <= 102));
}
// `grail cache prune [--keep N]`: drop every record no build used in the last N (default 10), then
// every blob no remaining record names, and whatever a killed build left in `stage/`.
// `grail cache clear` empties the store. Both cover every target under .work/cache.
fn cache_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() == 0 {
        say(view("usage: grail cache prune [--keep N] | grail cache clear"));
        return 1;
    }
    sub := item(&args, 0);
    if eq(view(sub), view("clear")) {
        mut run = u8[][copy(view("rm")), copy(view("-rf")), copy(view(".work/cache"))];
        host::command(run);
        host::print(view("cache: cleared\n"));
        return 0;
    }
    if !eq(view(sub), view("prune")) {
        say(view("usage: grail cache prune [--keep N] | grail cache clear"));
        return 1;
    }
    mut keep = 10;
    if (args.len() == 3) && eq(view(item(&args, 1)), view("--keep")) {
        keep = number_of(view(item(&args, 2)));
    }
    mut records_dropped = 0;
    mut records_kept = 0;
    mut blobs_dropped = 0;
    mut blobs_kept = 0;
    if host::exists(view(".work/cache")) == 0 {
        host::print(view("cache: empty\n"));
        return 0;
    }
    targets := host::list_dir(view(".work/cache"));
    for t in targets.len() {
        root := path_join(view(".work/cache"), view(item(&targets, t)));
        now := cache_generation(view(root));
        mut live = u8[];
        kinds := u8[][copy(view("prog")), copy(view("lnk")), copy(view("mod")), copy(view("unit"))];
        for k in kinds.len() {
            dir := path_join(view(path_join(view(root), view("map"))), view(item(&kinds, k)));
            if host::exists(view(dir)) == 0 {
                continue;
            }
            entries := host::list_dir(view(dir));
            for e in entries.len() {
                name := item(&entries, e);
                if ends(view(name), view(".used")) {
                    continue;
                }
                record := path_join(view(dir), view(name));
                used_path := cat(view(record), view(".used"));
                mut used = 0;
                if host::exists(view(used_path)) != 0 {
                    used = number_of(view(host::read_file(view(used_path))));
                }
                if (used + keep) < now {
                    host::remove(view(record), 0);
                    host::remove(view(used_path), 0);
                    records_dropped += 1;
                    continue;
                }
                records_kept += 1;
                // Every 64-hex-digit run a record holds is a blob it names.
                text := host::read_file(view(record));
                mut run = 0;
                for i in text.len() {
                    if hex_byte(text[i]) {
                        run += 1;
                    } else {
                        run = 0;
                    }
                    if run == 64 {
                        for j in 64 {
                            live.push(text[i + 1 - 64 + j]);
                        }
                        live.push(10);
                    }
                }
            }
        }
        blobs := path_join(view(root), view("blob"));
        if host::exists(view(blobs)) != 0 {
            names := host::list_dir(view(blobs));
            for b in names.len() {
                name := item(&names, b);
                if cache_contains(view(live), view(name)) {
                    blobs_kept += 1;
                } else {
                    host::remove(view(path_join(view(blobs), view(name))), 0);
                    blobs_dropped += 1;
                }
            }
        }
        stage := path_join(view(root), view("stage"));
        if host::exists(view(stage)) != 0 {
            leftovers := host::list_dir(view(stage));
            for l in leftovers.len() {
                host::remove(view(path_join(view(stage), view(item(&leftovers, l)))), 0);
            }
        }
    }
    mut line = copy(view("cache: pruned "));
    push_bytes(&mut line, view(decimal(records_dropped)));
    push_bytes(&mut line, view(" records and "));
    push_bytes(&mut line, view(decimal(blobs_dropped)));
    push_bytes(&mut line, view(" blobs; kept "));
    push_bytes(&mut line, view(decimal(records_kept)));
    push_bytes(&mut line, view(" records and "));
    push_bytes(&mut line, view(decimal(blobs_kept)));
    push_bytes(&mut line, view(" blobs\n"));
    host::print(view(line));
    return 0;
}
// File an artifact under the digest of its bytes, through a staging copy and a rename.
fn cache_blob_put<a, b>(c: (&a mut Cache), path: &b [u8]) -> u8[] {
    digest := cache_digest_file(&mut c, view(path));
    if digest.len() != 64 {
        return u8[];
    }
    blobs := path_join(view(c.root), view("blob"));
    blob := path_join(view(blobs), view(digest));
    // A blob that is already filed under this name is only reused if its bytes still hash to it: a
    // corrupted entry is replaced, so corruption costs one rebuild and not every build after it.
    if cache_blob_ok(&mut c, view(digest)) {
        return digest;
    }
    stage := cache_stage(&mut c);
    name := cat(view("blob."), view(digest));
    pending := path_join(view(stage), view(name));
    host::remove(view(pending), 0);
    mut copy_run = u8[][copy(view("cp")), copy(view(path)), copy(view(pending))];
    if host::command(copy_run) != 0 {
        return u8[];
    }
    mut move_run = u8[][copy(view("mv")), copy(view("-f")), pending, blob];
    if host::command(move_run) != 0 {
        return u8[];
    }
    return digest;
}
// A blob is usable only when its bytes still hash to the name it is filed under.
fn cache_blob_ok<a, b>(c: (&a mut Cache), digest: &b [u8]) -> bool {
    if digest.len() != 64 {
        return false;
    }
    blobs := path_join(view(c.root), view("blob"));
    blob := path_join(view(blobs), view(digest));
    if host::exists(view(blob)) == 0 {
        return false;
    }
    actual := cache_digest_file(&mut c, view(blob));
    return eq(view(actual), view(digest));
}
// Put a filed artifact back at `dest`, through a staging name so `dest` is only ever the whole file.
fn cache_blob_restore<a, b, d>(c: (&a mut Cache), digest: &b [u8], dest: &d [u8], executable: u64) -> u64 {
    blobs := path_join(view(c.root), view("blob"));
    blob := path_join(view(blobs), view(digest));
    if host::exists(view(blob)) == 0 {
        return 1;
    }
    pending := cat(view(dest), view(".cache-pending"));
    mut script = u8[];
    push_bytes(&mut script, view("set -e\ncp "));
    sh_word(&mut script, view(blob));
    script.push(32);
    sh_word(&mut script, view(pending));
    if executable != 0 {
        push_bytes(&mut script, view("\nchmod 755 "));
        sh_word(&mut script, view(pending));
    }
    push_bytes(&mut script, view("\nmv -f "));
    sh_word(&mut script, view(pending));
    script.push(32);
    sh_word(&mut script, view(dest));
    mut run = u8[][copy(view("sh")), copy(view("-c")), script];
    if host::command(run) != 0 {
        return 1;
    }
    return 0;
}
fn cache_contains<a, b>(text: &a [u8], needle: &b [u8]) -> bool {
    if needle.len() > text.len() {
        return false;
    }
    mut i: u64 = 0;
    while i + needle.len() <= text.len() {
        mut j: u64 = 0;
        mut ok = 1;
        while j < needle.len() {
            if text[i + j] != needle[j] {
                ok = 0;
                break;
            }
            j += 1;
        }
        if ok != 0 {
            return true;
        }
        i += 1;
    }
    return false;
}
fn cache_decimal<a>(out: (&a mut u8[]), n: u64) -> unit {
    if 9 < n {
        cache_decimal(&mut out, n / 10);
    }
    out.push(48 + n % 10);
    return ();
}
// The part a files holds: `STEM.NNN.module.s` -> `NNN.module`, unique within one build.
fn part_id<a>(path: &a [u8]) -> u8[] {
    mut end = path.len();
    if (end > 1) & (path[end - 1] == 115) & (path[end - 2] == 46) {
        end -= 2;
    }
    mut i = end;
    mut stop = end;
    mut count: u64 = 0;
    while i > 0 {
        i -= 1;
        if path[i] == 46 {
            count += 1;
            if count == 2 {
                stop = i + 1;
                break;
            }
        }
    }
    mut out = u8[];
    mut k = stop;
    while k < end {
        out.push(path[k]);
        k += 1;
    }
    return out;
}
// The module a part file holds: the last dot-separated segment of the stem.
fn part_module<a>(path: &a [u8]) -> u8[] {
    mut end = path.len();
    if (end > 1) & (path[end - 1] == 115) & (path[end - 2] == 46) {
        end -= 2;
    }
    mut i = end;
    mut at = end;
    while i > 0 {
        i -= 1;
        if path[i] == 46 {
            at = i + 1;
            break;
        }
    }
    mut out = u8[];
    mut k = at;
    while k < end {
        out.push(path[k]);
        k += 1;
    }
    return out;
}
// The index of the input a module was emitted from, plus one; 0 when no input declares it.
fn cache_source_of<s, d, n>(sources: (&s u8[][]), digests: (&d u8[][]), name: &n [u8]) -> u64 {
    for i in sources.len() {
        if eq(view(basename(view(item(&sources, i)))), view(name)) {
            return i + 1;
        }
    }
    return 0;
}
// What an importer reads of a dependency: its interface when the build reads interfaces, and the
// dependency's source digest otherwise - a stand-in that costs extra misses instead of being wrong.
fn cache_dep_digest<a, b, n>(c: (&a mut Cache), id: (&b BuildId), name: &n [u8]) -> u8[] {
    if id.iface_dir.len() != 0 {
        name_file := cat(view(name), view(".iface"));
        path := path_join(view(id.iface_dir), view(name_file));
        if host::exists(view(path)) != 0 {
            return cache_digest_file(&mut c, view(path));
        }
    }
    i := cache_source_of(&id.sources, &id.digests, view(name));
    if i == 0 {
        return u8[];
    }
    return item(&id.digests, i - 1);
}
// Whether a module's source names another module: `use NAME` or a `NAME::` reference.
fn cache_mentions<a, b>(text: &a [u8], name: &b [u8]) -> bool {
    qualified := cat(view(name), view("::"));
    if cache_contains(view(text), view(qualified)) {
        return true;
    }
    used := cat(view("use "), view(name));
    return cache_contains(view(text), view(used));
}
// The key material of one build: the flag vector as the compiler will see it, the compiler's own
// digest, the inputs in command-line order with their digests, the interfaces read, and the tools.
fn cache_build_id<a, b, d, e, g>(c: (&a mut Cache), argv: (&b u8[][]), asm: &d [u8], emulation: &e [u8], assemble: (&g u8[][])) -> BuildId {
    mut id = BuildId {
        flags: u8[],
        compiler: u8[],
        assembler: u8[],
        linker: u8[],
        ifaces: u8[],
        iface_dir: u8[],
        sources: u8[][],
        digests: u8[][]
    };
    mut flagbuf = u8[];
    push_bytes(&mut flagbuf, view("grail-cache-flags 1\n"));
    mut i: u64 = 1;
    while i < argv.len() {
        a := item(&argv, i);
        if eq(view(a), view("--target")) & (i + 1 < argv.len()) {
            push_bytes(&mut flagbuf, view("target "));
            push_bytes(&mut flagbuf, view(item(&argv, i + 1)));
            flagbuf.push(10);
            i += 2;
        } else {
            if (eq(view(a), view("--interface")) || eq(view(a), view("--emit-interface"))) & (i + 1 < argv.len()) {
                id.iface_dir = item(&argv, i + 1);
                // The interfaces a module reads are named one by one in its own key, so the set as a
                // whole belongs to the program key and not to the flag vector every module shares.
                manifest := path_join(view(id.iface_dir), view("interfaces.manifest"));
                id.ifaces = cache_digest_file(&mut c, view(manifest));
                i += 2;
            } else {
                if (a.len() != 0) & (a[0] == 45) {
                    push_bytes(&mut flagbuf, view(a));
                    flagbuf.push(10);
                    i += 1;
                } else {
                    if !eq(view(a), view(asm)) {
                        digest := cache_digest_file(&mut c, view(a));
                        id.sources.push(copy(view(a)));
                        id.digests.push(digest);
                    }
                    i += 1;
                }
            }
        }
    }
    id.flags = native::iface_digest(&flagbuf);
    exe := host::exe_path();
    id.compiler = cache_digest_file(&mut c, view(exe));
    id.assembler = cache_tool_id(&mut c, assemble);
    mut linker = u8[][tool(view("GRAIL_LINKER"), view("ld.lld")), copy(view("-m")), copy(view(emulation))];
    id.linker = cache_tool_id(&mut c, &linker);
    return id;
}
fn cache_program_key<a, b, d, e>(c: (&a mut Cache), id: (&b BuildId), target: &d [u8], asm: &e [u8]) -> u8[] {
    mut buf = u8[];
    push_bytes(&mut buf, view("grail-cache-program 1\ntarget "));
    push_bytes(&mut buf, view(target));
    push_bytes(&mut buf, view("\nflags "));
    push_bytes(&mut buf, view(id.flags));
    push_bytes(&mut buf, view("\ncompiler "));
    push_bytes(&mut buf, view(id.compiler));
    push_bytes(&mut buf, view("\nassembler "));
    push_bytes(&mut buf, view(id.assembler));
    push_bytes(&mut buf, view("\nlinker "));
    push_bytes(&mut buf, view(id.linker));
    push_bytes(&mut buf, view("\nifaces "));
    push_bytes(&mut buf, view(id.ifaces));
    push_bytes(&mut buf, view("\noutput "));
    push_bytes(&mut buf, view(asm));
    buf.push(10);
    for i in id.sources.len() {
        push_bytes(&mut buf, view(item(&id.sources, i)));
        buf.push(32);
        push_bytes(&mut buf, view(item(&id.digests, i)));
        buf.push(10);
    }
    return native::iface_digest(&buf);
}
fn cache_module_key<a, b, d, e, g>(c: (&a mut Cache), id: (&b BuildId), target: &d [u8], part: &e [u8], parts: (&g u8[][])) -> u8[] {
    name := part_module(view(part));
    mut buf = u8[];
    push_bytes(&mut buf, view("grail-cache-module 1\npart "));
    push_bytes(&mut buf, view(part_id(view(part))));
    push_bytes(&mut buf, view("\ntarget "));
    push_bytes(&mut buf, view(target));
    push_bytes(&mut buf, view("\nflags "));
    push_bytes(&mut buf, view(id.flags));
    push_bytes(&mut buf, view("\ncompiler "));
    push_bytes(&mut buf, view(id.compiler));
    push_bytes(&mut buf, view("\nassembler "));
    push_bytes(&mut buf, view(id.assembler));
    // Only the interfaces *this* module reads, which the dependency lines below carry: the digest of
    // the whole interface set is an input of the program, not of any one module.
    at := cache_source_of(&id.sources, &id.digests, view(name));
    push_bytes(&mut buf, view("\nsource "));
    if at != 0 {
        push_bytes(&mut buf, view(item(&id.digests, at - 1)));
    }
    buf.push(10);
    // The trusted base: every module is emitted against the runtime and the platform module.
    for k in id.sources.len() {
        base_name := basename(view(item(&id.sources, k)));
        if eq(view(base_name), view("runtime")) || eq(view(base_name), view("os-linux")) || eq(view(base_name), view("darwin")) {
            push_bytes(&mut buf, view("base "));
            push_bytes(&mut buf, view(base_name));
            buf.push(32);
            push_bytes(&mut buf, view(item(&id.digests, k)));
            buf.push(10);
        }
    }
    // What this module reads of its dependencies, in emission order.
    if at != 0 {
        text := host::read_file(view(item(&id.sources, at - 1)));
        for k in parts.len() {
            other := part_module(view(item(&parts, k)));
            if !eq(view(other), view(name)) & cache_mentions(view(text), view(other)) {
                push_bytes(&mut buf, view("dep "));
                push_bytes(&mut buf, view(other));
                buf.push(32);
                push_bytes(&mut buf, view(cache_dep_digest(&mut c, id, view(other))));
                buf.push(10);
            }
        }
    }
    return native::iface_digest(&buf);
}
// The one line a cached build prints: what was reused, what was not, and what ran.
fn cache_report<a>(c: (&a mut Cache), relinked: u64) -> unit {
    host::print(view("grail: cache: "));
    host::print_num(c.hits);
    host::print(view(" hit, "));
    host::print_num(c.misses);
    host::print(view(" miss"));
    if c.misses != 0 {
        host::print(view(" ("));
        for i in c.names.len() {
            if i != 0 {
                host::print(view(", "));
            }
            host::print(view(item(&c.names, i)));
        }
        host::print(view(")"));
    }
    host::print(view("; "));
    if relinked == 0 {
        host::print(view("image reused"));
    } else {
        host::print(view("image linked"));
    }
    say(view(""));
    return ();
}
// The whole-program key is over every input the build reads, so a hit means nothing has to run: the
// image in the store is the image this build would produce.
fn cache_up_to_date<a, b, d>(c: (&a mut Cache), key: &b [u8], output: &d [u8]) -> u64 {
    blob := cache_field(view(c.root), view("prog"), view(key), view("blob"));
    if !cache_blob_ok(&mut c, view(blob)) {
        return 0;
    }
    count := cache_field(view(c.root), view("prog"), view(key), view("parts"));
    // The image a whole-program hit hands back is only this program's image if the files the link
    // named are still the files it was linked with.
    record := cache_record_path(view(c.root), view("prog"), view(key));
    if host::exists(view(record)) == 0 {
        return 0;
    }
    body := host::read_file(view(record));
    rows := lines(view(body));
    for i in rows.len() {
        row := item(&rows, i);
        if starts(view(row), view("link ")) & (69 <= row.len()) {
            mut wanted = u8[];
            for k in 64 {
                wanted.push(row[5 + k]);
            }
            path := cache_rest(view(row), 69);
            actual := cache_digest_file(&mut c, view(path));
            if !eq(view(actual), view(wanted)) {
                return 0;
            }
        }
    }
    mut here = u8[];
    if host::exists(view(output)) != 0 {
        here = cache_digest_file(&mut c, view(output));
    }
    if !eq(view(here), view(blob)) {
        if cache_blob_restore(&mut c, view(blob), view(output), 1) != 0 {
            return 0;
        }
    }
    // The same shape as a rebuild reports, so one line always says what hit, what missed and what ran.
    host::print(view("grail: cache: "));
    host::print(view(count));
    host::print(view(" hit, 0 miss; program up to date\n"));
    return 1;
}
// Assemble and link through the store, then file what was produced. The compiler has already written
// the parts manifest; everything after it is reused or recomputed per module.
fn cache_split<a, b, d, e, g, k, m>(
    c: (&a mut Cache),
    id: (&b BuildId),
    base: &d [u8],
    output: &e [u8],
    target: &g [u8],
    emulation: &k [u8],
    assemble: (&m u8[][]),
    program: &d [u8]
) -> u64 {
    manifest := cat(view(output), view(".parts"));
    mut text = u8[];
    if host::exists(view(manifest)) != 0 {
        text = host::read_file(view(manifest));
    }
    if !starts(view(text), view("// grail-parts 1")) {
        say(view("grail: missing or unreadable parts manifest "));
        say(view(manifest));
        return 1;
    }
    parts := read_split(view(manifest), view(base));
    if parts.asm.len() == 0 {
        say(view("grail: the parts manifest lists no modules"));
        return 1;
    }
    mut miss_sources = u8[][];
    mut miss_objects = u8[][];
    mut miss_at = u64[];
    mut digests = u8[][];
    for i in parts.asm.len() {
        part := item(&parts.asm, i);
        object := item(&parts.objects, i);
        key := cache_module_key(&mut c, id, view(target), view(part), &parts.asm);
        asm_digest := cache_digest_file(&mut c, view(part));
        recorded := cache_field(view(c.root), view("mod"), view(key), view("asm"));
        blob := cache_field(view(c.root), view("mod"), view(key), view("blob"));
        mut reused = 0;
        if (recorded.len() == 64) & eq(view(recorded), view(asm_digest)) & cache_blob_ok(&mut c, view(blob)) {
            if cache_blob_restore(&mut c, view(blob), view(object), 0) == 0 {
                reused = 1;
            }
        }
        if reused != 0 {
            c.hits += 1;
            digests.push(blob);
        } else {
            c.misses += 1;
            c.names.push(part_module(view(part)));
            miss_sources.push(part);
            miss_objects.push(object);
            miss_at.push(i);
            digests.push(copy(view("")));
        }
    }
    if miss_sources.len() != 0 {
        if assemble_parts(assemble, &miss_sources, &miss_objects) != 0 {
            say(view("grail: assembling failed (needs clang)"));
            return 1;
        }
        // File the new objects only after they assembled, so a failed assembly leaves no entry.
        for i in miss_sources.len() {
            part := item(&miss_sources, i);
            object := item(&miss_objects, i);
            key := cache_module_key(&mut c, id, view(target), view(part), &parts.asm);
            asm_digest := cache_digest_file(&mut c, view(part));
            blob := cache_blob_put(&mut c, view(object));
            mut filed = copy(view(blob));
            if filed.len() != 64 {
                filed = cache_digest_file(&mut c, view(object));
            }
            // The object's position in link order is the position of its part.
            slot := miss_at[i];
            digests[slot] = filed;
            if blob.len() == 64 {
                mut record = u8[];
                push_bytes(&mut record, view("// grail-cache-module 1\nmodule "));
                push_bytes(&mut record, view(part_module(view(part))));
                push_bytes(&mut record, view("\nasm "));
                push_bytes(&mut record, view(asm_digest));
                push_bytes(&mut record, view("\nblob "));
                push_bytes(&mut record, view(blob));
                record.push(10);
                cache_record_put(&mut c, view("mod"), view(key), view(record));
            }
        }
    }
    // The image is determined by the object set, the link inputs and the linker.
    mut linkbuf = u8[];
    push_bytes(&mut linkbuf, view("grail-cache-link 1\ntarget "));
    push_bytes(&mut linkbuf, view(target));
    push_bytes(&mut linkbuf, view("\nlinker "));
    push_bytes(&mut linkbuf, view(id.linker));
    push_bytes(&mut linkbuf, view("\noutput "));
    push_bytes(&mut linkbuf, view(output));
    linkbuf.push(10);
    for i in digests.len() {
        push_bytes(&mut linkbuf, view(item(&digests, i)));
        linkbuf.push(10);
    }
    // A `// grail-link:` input that is a file on disk is part of what the image is: an archive or an
    // object that changed has to relink even though no source did.
    for i in parts.link.len() {
        input := item(&parts.link, i);
        push_bytes(&mut linkbuf, view(input));
        linkbuf.push(32);
        push_bytes(&mut linkbuf, view(cache_digest_file(&mut c, view(input))));
        linkbuf.push(10);
    }
    link_key := native::iface_digest(&linkbuf);
    image := cache_field(view(c.root), view("lnk"), view(link_key), view("blob"));
    mut linked: u64 = 0;
    mut final = copy(view(image));
    if cache_blob_ok(&mut c, view(image)) {
        if cache_blob_restore(&mut c, view(image), view(output), 1) != 0 {
            linked = 1;
        }
    } else {
        linked = 1;
    }
    if linked != 0 {
        if link_objects(view(output), view(target), view(emulation), &parts.objects, &parts.link) != 0 {
            return 1;
        }
        final = cache_blob_put(&mut c, view(output));
        if final.len() == 64 {
            mut record = u8[];
            push_bytes(&mut record, view("// grail-cache-link 1\nblob "));
            push_bytes(&mut record, view(final));
            record.push(10);
            cache_record_put(&mut c, view("lnk"), view(link_key), view(record));
        }
    }
    if final.len() == 64 {
        mut record = u8[];
        push_bytes(&mut record, view("// grail-cache-program 1\nblob "));
        push_bytes(&mut record, view(final));
        push_bytes(&mut record, view("\nparts "));
        cache_decimal(&mut record, parts.asm.len());
        push_bytes(&mut record, view("\noutput "));
        push_bytes(&mut record, view(output));
        record.push(10);
        for i in parts.link.len() {
            input := item(&parts.link, i);
            if host::exists(view(input)) != 0 {
                push_bytes(&mut record, view("link "));
                push_bytes(&mut record, view(cache_digest_file(&mut c, view(input))));
                record.push(32);
                push_bytes(&mut record, view(input));
                record.push(10);
            }
        }
        cache_record_put(&mut c, view("prog"), view(program), view(record));
    }
    cache_report(&mut c, linked);
    return 0;
}

fn load_project() -> Project {
    mut p = Project {
        name: u8[],
        entry: copy(view("src/main.grl")),
        deps: u8[][],
        urls: u8[][],
        revs: u8[][],
    };
    if host::exists(view("grail.pkg")) == 0 {
        return p;
    }
    text := host::read_file(view("grail.pkg"));
    rows := lines(view(text));
    for i in rows.len() {
        row := item(&rows, i);
        w := words(view(row));
        if 1 < w.len() {
            key := item(&w, 0);
            value := item(&w, 1);
            if eq(view(key), view("name")) {
                p.name = value;
            } else {
                if eq(view(key), view("entry")) {
                    p.entry = value;
                } else {
                    if eq(view(key), view("dep")) & (2 < w.len()) {
                        p.deps.push(value);
                        p.urls.push(item(&w, 2));
                        mut rev = u8[];
                        if 3 < w.len() {
                            rev = item(&w, 3);
                        }
                        p.revs.push(rev);
                    }
                }
            }
        }
    }
    return p;
}
// Project modules: every .grl under src/ except the entry, plus every fetched dependency's src/.
fn project_modules<a>(p: (&a Project), skip_entry: u64) -> u8[][] {
    mut all = u8[][];
    collect(view("src"), &mut all);
    for i in p.deps.len() {
        name := item(&p.deps, i);
        d := path_join(view(".grail/deps"), view(name));
        src := path_join(view(d), view("src"));
        collect(view(src), &mut all);
    }
    mut out = u8[][];
    for i in all.len() {
        f := item(&all, i);
        if !(skip_entry != 0 && eq(view(f), view(p.entry))) {
            out.push(f);
        }
    }
    return out;
}
struct Options {
    file: u8[],
    output: u8[],
    target: u8[],
    rest: u8[][],
    check: u64,
    debug: u64,
    deny: u64,
    split: u64,
    // 0 when the flag is absent, 1 for `--overflow=wrap`, 2 for `--overflow=checked`.
    overflow: u64,
    // The build cache (B1 stage 4): reuse per-module objects and an unchanged program.
    cache: u64,
    // One compiler invocation per module (B1 stage 4): `--per-module`.
    per_module: u64,
    // Module interfaces (B1 stage 2): `--interface DIR` reads them, `grail check` writes them, and
    // `--verify` compares the two instead of trusting either.
    iface: u8[],
    verify: u64,
    paths: u8[][]
}
// The code-generation flag vector, in one place: it is what the compiler is told, and what the build
// cache keys on. Bit 0 check only, 1 debug, 2 deny ambient host, 3 split, 4/5 overflow, 6 cache,
// 7 one compiler invocation per module.
fn flag_bits<a>(o: (&a Options)) -> u64 {
    return o.debug * 2 + o.deny * 4 + o.split * 8 + o.overflow * 16 + o.cache * 64 + o.per_module * 128;
}
fn options<a>(args: (&a u8[][])) -> Options {
    mut o = Options {
        file: u8[],
        output: u8[],
        target: target_name(host::target()),
        rest: u8[][],
        check: 0,
        debug: 0,
        deny: 0,
        split: 0,
        overflow: 0,
        cache: 0,
        per_module: 0,
        iface: u8[],
        verify: 0,
        paths: u8[][],
    };
    mut i = 0;
    mut passthrough = 0;
    while i < args.len() {
        a := item(&args, i);
        if passthrough != 0 {
            o.rest.push(a);
        } else {
            if eq(view(a), view("--")) {
                passthrough = 1;
            } else {
                if eq(view(a), view("-o")) & (i + 1 < args.len()) {
                    i += 1;
                    o.output = item(&args, i);
                } else {
                    if eq(view(a), view("--target")) & (i + 1 < args.len()) {
                        i += 1;
                        o.target = item(&args, i);
                    } else {
                        if eq(view(a), view("--check")) {
                            o.check = 1;
                        } else {
                            if eq(view(a), view("--debug")) {
                                o.debug = 1;
                            } else {
                            if eq(view(a), view("--deny-ambient-host")) {
                                o.deny = 1;
                            } else {
                            if eq(view(a), view("--split")) {
                                // One object per module, assembled concurrently (B1 stage 1).
                                o.split = 1;
                            } else {
                            if eq(view(a), view("--per-module")) {
                                // One compiler invocation per module, in dependency order (B1 stage 4).
                                o.per_module = 1;
                            } else {
                            if eq(view(a), view("--cache")) {
                                // Reuse per-module objects and an unchanged program (B1 stage 4).
                                // Per-module objects only exist on the split path, so it implies it.
                                o.cache = 1;
                                o.split = 1;
                            } else {
                            if eq(view(a), view("--overflow=wrap")) {
                                o.overflow = 1;
                            } else {
                            if eq(view(a), view("--overflow=checked")) {
                                o.overflow = 2;
                            } else {
                            if eq(view(a), view("--interface")) & (i + 1 < args.len()) {
                                // Module interfaces (B1 stage 2): the directory holding them.
                                i += 1;
                                o.iface = item(&args, i);
                            } else {
                            if eq(view(a), view("--verify")) {
                                o.verify = 1;
                            } else {
                            if ends(view(a), view(".grl")) & (o.file.len() == 0) {
                                o.file = copy(view(a));
                                o.paths.push(a);
                            } else {
                                o.paths.push(a);
                            }
                            }
                            }
                            }
                            }
                            }
                            }
                            }
                            }
                            }
                        }
                    }
                }
            }
        }
        i += 1;
    }
    return o;
}
fn build<a, b>(args: (&a u8[][]), o: (&b mut Options)) -> u64 {
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    // The cache reuses the per-module objects only the split path produces, and the split path is
    // the Linux x86_64 assembler path: name that here instead of failing later with a --split error.
    if o.cache != 0 {
        if !eq(view(o.target), view("x86_64")) || (o.debug != 0) {
            say(view("grail: --cache is implemented for the linux x86_64 assembler path, without --debug"));
            return 1;
        }
    }
    host::mkdir(view("target"));
    if o.file.len() != 0 {
        if o.output.len() == 0 {
            stem := basename(view(o.file));
            o.output = path_join(view("target"), view(stem));
        }
        mut none = u8[][];
        return compile(&h, view(o.file), &none, view(o.output), view(o.target), flag_bits(&o), view(o.iface), o.verify);
    }
    p := load_project();
    if p.name.len() == 0 {
        say(view("grail: no .grl file given and no grail.pkg here (try `grail new NAME`)"));
        return 1;
    }
    if o.output.len() == 0 {
        o.output = path_join(view("target"), view(p.name));
    }
    modules := project_modules(&p, 1);
    return compile(&h, view(p.entry), &modules, view(o.output), view(o.target), flag_bits(&o), view(o.iface), o.verify);
}
fn check_command<a>(args: (&a u8[][])) -> u64 {
    o := options(&args);
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    host::mkdir(view("target"));
    mut status = 0;
    if o.file.len() != 0 {
        stem := basename(view(o.file));
        out := path_join(view("target"), view(stem));
        mut none = u8[][];
        status = compile_mode(&h, view(o.file), &none, view(out), view(o.target), 1 + flag_bits(&o), view(o.iface), o.verify);
    } else {
        p := load_project();
        if p.name.len() == 0 {
            say(view("grail: no .grl file given and no grail.pkg here"));
            return 1;
        }
        out := path_join(view("target"), view(p.name));
        modules := project_modules(&p, 1);
        status = compile_mode(&h, view(p.entry), &modules, view(out), view(o.target), 1 + flag_bits(&o), view(o.iface), o.verify);
    }
    if status == 0 {
        say(view("ok"));
    }
    return status;
}
fn run_command<a>(args: (&a u8[][])) -> u64 {
    mut o = options(&args);
    host_target := target_name(host::target());
    if !eq(view(o.target), view(host_target)) {
        say(
            view("grail run: cross-target executables must be run with an emulator; use grail build --target")
        );
        return 1;
    }
    if build(&args, &mut o) != 0 {
        return 1;
    }
    mut command = u8[][];
    out := copy(view(o.output));
    if starts(view(out), view("/")) {
        command.push(out);
    } else {
        command.push(path_join(view("."), view(out)));
    }
    for i in o.rest.len() {
        command.push(item(&o.rest, i));
    }
    return host::command(command);
}
fn test_command<a>(args: (&a u8[][])) -> u64 {
    o := options(&args);
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    mut files = u8[][];
    if o.paths.len() != 0 {
        for i in o.paths.len() {
            x := item(&o.paths, i);
            if ends(view(x), view(".grl")) {
                files.push(x);
            } else {
                collect(view(x), &mut files);
            }
        }
    } else {
        collect(view("tests"), &mut files);
    }
    p := load_project();
    modules := project_modules(&p, 1);
    host::mkdir(view("target"));
    host::mkdir(view("target/tests"));
    mut failed = 0;
    for i in files.len() {
        f := item(&files, i);
        stem := basename(view(f));
        out := path_join(view("target/tests"), view(stem));
        host::print(view("test "));
        host::print(view(f));
        host::print(view(" ... "));
        mut status = compile(&h, view(f), &modules, view(out), view(o.target), flag_bits(&o), view(o.iface), o.verify);
        if status == 0 {
            exe := path_join(view("."), view(out));
            status = host::command(u8[][exe]);
        }
        if status == 0 {
            say(view("ok"));
        } else {
            say(view("FAILED"));
            failed += 1;
        }
    }
    host::print_num(files.len() - failed);
    host::print(view(" passed, "));
    host::print_num(failed);
    say(view(" failed"));
    if files.len() == 0 {
        say(view("grail test: no tests found (put programs in tests/)"));
    }
    return failed != 0;
}
fn fmt_command<a>(args: (&a u8[][])) -> u64 {
    o := options(&args);
    mut files = u8[][];
    if o.paths.len() == 0 {
        collect(view("."), &mut files);
    }
    for i in o.paths.len() {
        x := item(&o.paths, i);
        if ends(view(x), view(".grl")) {
            files.push(x);
        } else {
            collect(view(x), &mut files);
        }
    }
    mut changed = 0;
    for i in files.len() {
        f := item(&files, i);
        data := host::read_file(view(f));
        out := fmt::format(view(data));
        if !eq(view(data), view(out)) {
            changed += 1;
            if o.check != 0 {
                say2(view("would reformat "), view(f));
            } else {
                host::write_file(view(f), view(out));
                say2(view("formatted "), view(f));
            }
        }
    }
    if o.check != 0 {
        return changed != 0;
    }
    return 0;
}
fn new_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() == 0 {
        say(view("usage: grail new NAME"));
        return 1;
    }
    name := item(&args, 0);
    if host::exists(view(name)) != 0 {
        say2(view("grail new: already exists: "), view(name));
        return 1;
    }
    host::mkdir(view(name));
    src := path_join(view(name), view("src"));
    host::mkdir(view(src));
    tests := path_join(view(name), view("tests"));
    host::mkdir(view(tests));
    mut manifest = copy(view("name "));
    for i in name.len() {
        manifest.push(name[i]);
    }
    manifest.push(10);
    pkg := path_join(view(name), view("grail.pkg"));
    host::write_file(view(pkg), view(manifest));
    main := path_join(view(src), view("main.grl"));
    host::write_file(view(main), view("fn main() {\n    println(\"Hello, world!\");\n}\n"));
    test := path_join(view(tests), view("smoke.grl"));
    host::write_file(view(test), view("fn main() {\n    assert(1 + 1 == 2);\n}\n"));
    ignore := path_join(view(name), view(".gitignore"));
    host::write_file(view(ignore), view("target/\n.grail/\n"));
    say2(view("created project "), view(name));
    return 0;
}
fn lock_lookup<a, b>(lock: &a [u8], name: &b [u8]) -> u8[] {
    rows := lines(view(lock));
    for i in rows.len() {
        row := item(&rows, i);
        w := words(view(row));
        if 1 < w.len() {
            k := item(&w, 0);
            if eq(view(k), view(name)) {
                return item(&w, 1);
            }
        }
    }
    return u8[];
}
fn fetch_command() -> u64 {
    p := load_project();
    if p.name.len() == 0 {
        say(view("grail: no grail.pkg here"));
        return 1;
    }
    mut lock = u8[];
    if host::exists(view("grail.lock")) != 0 {
        lock = host::read_file(view("grail.lock"));
    }
    host::mkdir(view(".grail"));
    host::mkdir(view(".grail/deps"));
    mut newlock = u8[];
    for i in p.deps.len() {
        name := item(&p.deps, i);
        url := item(&p.urls, i);
        rev := item(&p.revs, i);
        dir := path_join(view(".grail/deps"), view(name));
        if host::exists(view(dir)) == 0 {
            say2(view("fetching "), view(name));
            if host::command(
                u8[][copy(view("git")), copy(view("clone")), copy(view("--quiet")), copy(view(url)), copy(view(dir))]
            )
                != 0 {
                say2(view("grail: git clone failed for "), view(url));
                return 1;
            }
            mut pin = lock_lookup(view(lock), view(name));
            if pin.len() == 0 {
                pin = copy(view(rev));
            }
            if pin.len() != 0 {
                if host::command(
                    u8[][
                        copy(view("git")),
                        copy(view("-C")),
                        copy(view(dir)),
                        copy(view("checkout")),
                        copy(view("--quiet")),
                        pin
                    ]
                )
                    != 0 {
                    say2(view("grail: cannot check out revision for "), view(name));
                    return 1;
                }
            }
        }
        record := path_join(view(dir), view(".grail-commit"));
        mut script = copy(view("git -C '"));
        for j in dir.len() {
            script.push(dir[j]);
        }
        tail := cat(view("' rev-parse HEAD > '"), view(record));
        for j in tail.len() {
            script.push(tail[j]);
        }
        script.push(39);
        if host::command(u8[][copy(view("sh")), copy(view("-c")), script]) != 0 {
            return 1;
        }
        commit := host::read_file(view(record));
        for j in name.len() {
            newlock.push(name[j]);
        }
        newlock.push(32);
        for j in commit.len() {
            if commit[j] != 10 {
                newlock.push(commit[j]);
            }
        }
        newlock.push(10);
    }
    host::write_file(view("grail.lock"), view(newlock));
    return 0;
}
fn add_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() < 2 {
        say(view("usage: grail add NAME GIT-URL [REVISION]"));
        return 1;
    }
    if host::exists(view("grail.pkg")) == 0 {
        say(view("grail: no grail.pkg here"));
        return 1;
    }
    name := item(&args, 0);
    url := item(&args, 1);
    p := load_project();
    for i in p.deps.len() {
        d := item(&p.deps, i);
        if eq(view(d), view(name)) {
            say2(view("grail add: dependency already listed: "), view(name));
            return fetch_command();
        }
    }
    mut text = host::read_file(view("grail.pkg"));
    if text.len() != 0 {
        if text[text.len() - 1] != 10 {
            text.push(10);
        }
    }
    line := cat(view("dep "), view(name));
    for i in line.len() {
        text.push(line[i]);
    }
    text.push(32);
    for i in url.len() {
        text.push(url[i]);
    }
    if 2 < args.len() {
        rev := item(&args, 2);
        text.push(32);
        for i in rev.len() {
            text.push(rev[i]);
        }
    }
    text.push(10);
    host::write_file(view("grail.pkg"), view(text));
    return fetch_command();
}
fn debug_command<a>(args: (&a u8[][])) -> u64 {
    if args.len() < 2 {
        say(view("usage: grail debug lines|info BINARY"));
        return 1;
    }
    sub := item(&args, 0);
    mut dump_flag = u8[];
    mut readelf_flag = u8[];
    if eq(view(sub), view("lines")) {
        dump_flag = copy(view("--debug-line"));
        readelf_flag = copy(view("--debug-dump=decodedline"));
    } else {
        if eq(view(sub), view("info")) {
            dump_flag = copy(view("--debug-info"));
            readelf_flag = copy(view("--debug-dump=info"));
        } else {
            say(view("usage: grail debug lines|info BINARY"));
            return 1;
        }
    }
    binary := item(&args, 1);
    if host::exists(view(binary)) == 0 {
        say(view("grail: no such file: "));
        say(view(binary));
        return 1;
    }
    mut dump = u8[][
        tool(view("GRAIL_DWARFDUMP"), view("llvm-dwarfdump")),
        dump_flag,
        copy(view(binary))
    ];
    if host::command(dump) == 0 {
        return 0;
    }
    say(view("grail: llvm-dwarfdump unavailable; trying readelf"));
    mut decoded = u8[][
        tool(view("GRAIL_READELF"), view("readelf")),
        readelf_flag,
        copy(view(binary))
    ];
    return host::command(decoded);
}
// ---- `grail profile` -------------------------------------------------------------------------
// The target profiles itself: its runtime reads GRAIL_PROFILE from its environment, arms an
// ITIMER_PROF timer and writes the interrupted instruction pointers to the file named there (see
// runtime.grl). This side owns the request, the scratch directory, the ELF symbol table and the
// report; no perf, nm or addr2line is involved, and only the program's own instruction pointer is
// sampled.
struct Symbol {
    start: u64,
    function: u8[],
    module: u8[]
}
fn byte_at<a>(image: &a [u8], at: u64) -> u64 {
    if at < image.len() {
        return u64(image[at]);
    }
    return 0;
}
fn le16<a>(image: &a [u8], at: u64) -> u64 {
    if image.len() < at + 2 {
        return 0;
    }
    return byte_at(view(image), at) + byte_at(view(image), at + 1) * 256;
}
fn le32<a>(image: &a [u8], at: u64) -> u64 {
    if image.len() < at + 4 {
        return 0;
    }
    return le16(view(image), at) + le16(view(image), at + 2) * 65536;
}
fn le64<a>(image: &a [u8], at: u64) -> u64 {
    if image.len() < at + 8 {
        return 0;
    }
    return le32(view(image), at) + le32(view(image), at + 4) * 4294967296;
}
fn bytes_between<a>(image: &a [u8], from: u64, to: u64) -> u8[] {
    mut out = u8[];
    mut i = from;
    while i < to {
        out.push(image[i]);
        i += 1;
    }
    return out;
}
fn cstring_at<a>(image: &a [u8], at: u64) -> u8[] {
    mut out = u8[];
    mut i = at;
    while (i < image.len()) && (image[i] != 0) {
        out.push(image[i]);
        i += 1;
    }
    return out;
}
fn starts_with<a, b>(text: &a [u8], prefix: &b [u8]) -> bool {
    if text.len() < prefix.len() {
        return false;
    }
    for i in prefix.len() {
        if text[i] != prefix[i] {
            return false;
        }
    }
    return true;
}
fn decimal(n: u64) -> u8[] {
    mut out = u8[];
    mut v = n;
    if v == 0 {
        out.push(48);
        return out;
    }
    while 0 < v {
        out.push(48 + v % 10);
        v = v / 10;
    }
    mut flipped = u8[];
    mut i = out.len();
    while 0 < i {
        i -= 1;
        flipped.push(out[i]);
    }
    return flipped;
}
fn number_of<a>(text: &a [u8]) -> u64 {
    mut value: u64 = 0;
    for i in text.len() {
        c := u64(text[i]);
        if (c < 48) || (57 < c) {
            return 0;
        }
        value = value * 10 + (c - 48);
    }
    return value;
}
fn pad_left<a>(text: &a [u8], width: u64) -> u8[] {
    mut out = u8[];
    mut i = text.len();
    while i < width {
        out.push(32);
        i += 1;
    }
    for i in text.len() {
        out.push(text[i]);
    }
    return out;
}
fn padded<a>(text: &a [u8], width: u64) -> u8[] {
    mut out = u8[];
    for i in text.len() {
        out.push(text[i]);
    }
    while out.len() < width {
        out.push(32);
    }
    return out;
}
fn share_text(count: u64, total: u64) -> u8[] {
    if total == 0 {
        return copy(view("0.0%"));
    }
    // One decimal place, rounded to the nearest tenth of a percent.
    tenths := (count * 1000 + total / 2) / total;
    mut out = decimal(tenths / 10);
    out.push(46);
    out.push(48 + tenths % 10);
    out.push(37);
    return out;
}
// Hundredths of a second of measured CPU time, with the unit.
fn nanos_text(ns: u64) -> u8[] {
    if ns == 0 {
        return copy(view("an unknown amount of time"));
    }
    hundredths := (ns + 5000000) / 10000000;
    mut out = decimal(hundredths / 100);
    out.push(46);
    out.push(48 + (hundredths / 10) % 10);
    out.push(48 + hundredths % 10);
    out.push(32);
    out.push(115);
    return out;
}
// Samples per second of measured CPU time: what the kernel actually delivered.
fn effective_rate(count: u64, ns: u64) -> u64 {
    if ns == 0 {
        return 0;
    }
    return count * 1000000000 / ns;
}
// True when the measured rate is less than three quarters of the request, which is how the kernel's
// per-tick accounting shows up above roughly one kHz.
fn capped(requested: u64, count: u64, ns: u64) -> bool {
    if ns == 0 {
        return false;
    }
    return effective_rate(count, ns) * 4 < requested * 3;
}
fn push_text<a>(out: (&mut u8[]), text: &a [u8]) -> unit {
    for i in text.len() {
        out.push(text[i]);
    }
}
fn push_line<a>(out: (&mut u8[]), text: &a [u8]) -> unit {
    push_text(&mut out, view(text));
    out.push(10);
}
// Every STT_FUNC symbol in .symtab, split into `f_<module>_<function>`. The compiler emits no
// st_size for its functions, so a range runs from a symbol's start to the next symbol's start.
fn elf_symbols<a>(image: &a [u8]) -> Symbol[] {
    mut out = Symbol[];
    if image.len() < 64 {
        return out;
    }
    if (image[0] != 127) || (image[1] != 69) || (image[2] != 76) || (image[3] != 70) {
        return out;
    }
    shoff := le64(view(image), 40);
    entsize := le16(view(image), 58);
    count := le16(view(image), 60);
    mut symoff: u64 = 0;
    mut symsize: u64 = 0;
    mut step: u64 = 0;
    mut stroff: u64 = 0;
    mut found: u64 = 0;
    mut i: u64 = 0;
    while i < count {
        base := shoff + i * entsize;
        if le32(view(image), base + 4) == 2 {
            symoff = le64(view(image), base + 24);
            symsize = le64(view(image), base + 32);
            step = le64(view(image), base + 56);
            link := le32(view(image), base + 40);
            stroff = le64(view(image), shoff + link * entsize + 24);
            found = 1;
        }
        i += 1;
    }
    if (found == 0) || (step == 0) {
        return out;
    }
    mut at: u64 = 0;
    while at + step <= symsize {
        entry := symoff + at;
        if byte_at(view(image), entry + 4) % 16 == 2 {
            address := le64(view(image), entry + 8);
            if address != 0 {
                name := cstring_at(view(image), stroff + le32(view(image), entry));
                mut module = u8[];
                mut function = copy(view(name));
                if starts_with(view(name), view("f_")) {
                    mut k: u64 = 2;
                    while (k < name.len()) && (name[k] != 95) {
                        k += 1;
                    }
                    module = bytes_between(view(name), 2, k);
                    function = bytes_between(view(name), k + 1, name.len());
                } else if starts_with(view(name), view("rt_")) {
                    module = copy(view("runtime"));
                }
                out.push(Symbol { start: address, function: function, module: module });
            }
        }
        at += step;
    }
    return out;
}
// Symbol indices ordered by start address.
fn by_start<a>(symbols: (&a Symbol[])) -> u64[] {
    mut order = u64[];
    for i in symbols.len() {
        order.push(i);
    }
    mut k: u64 = 1;
    while k < order.len() {
        mut j = k;
        while 0 < j {
            if symbols[order[j - 1]].start <= symbols[order[j]].start {
                break;
            }
            swapped := order[j - 1];
            order[j - 1] = order[j];
            order[j] = swapped;
            j -= 1;
        }
        k += 1;
    }
    return order;
}
// The symbol whose range holds `pc`, or symbols.len() when no known symbol covers it.
fn symbol_at<a, b>(symbols: (&a Symbol[]), order: (&b u64[]), pc: u64) -> u64 {
    mut lo: u64 = 0;
    mut hi: u64 = order.len();
    while lo < hi {
        mid := lo + (hi - lo) / 2;
        if symbols[order[mid]].start <= pc {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return symbols.len();
    }
    return order[lo - 1];
}
// Symbol indices with at least one sample, most samples first.
fn by_count<a, b>(counts: (&a u64[]), slots: (&b u64[])) -> u64[] {
    mut order = u64[];
    for i in slots.len() {
        if counts[slots[i]] != 0 {
            order.push(slots[i]);
        }
    }
    mut k: u64 = 1;
    while k < order.len() {
        mut j = k;
        while 0 < j {
            if counts[order[j - 1]] >= counts[order[j]] {
                break;
            }
            swapped := order[j - 1];
            order[j - 1] = order[j];
            order[j] = swapped;
            j -= 1;
        }
        k += 1;
    }
    return order;
}
// Where per-run scratch lives: TMPDIR when the environment names one, /tmp otherwise. `grail
// profile` refuses non-Linux targets, so there is no platform-specific temp directory here.
fn profile_temp() -> u8[] {
    named := host::env(view("TMPDIR"));
    if named.len() != 0 {
        return named;
    }
    return copy(view("/tmp"));
}
// A directory of our own for one run: `mkdir` is the atomic claim, so two profilers started in the
// same millisecond cannot share a sample file, and the directory is removed once the report is read.
fn profile_scratch() -> u8[] {
    base := profile_temp();
    stamp := host::now_ms();
    mut n: u64 = 0;
    while n < 10000 {
        name := cat(view("grail-profile-"), view(decimal(stamp + n)));
        dir := path_join(view(base), view(name));
        if host::mkdir(view(dir)) == 0 {
            return dir;
        }
        n += 1;
    }
    return u8[];
}
fn profile_command<a>(args: (&a u8[][])) -> u64 {
    mut rate: u64 = 200;
    mut out_path = u8[];
    mut i: u64 = 0;
    while i < args.len() {
        a := item(&args, i);
        if eq(view(a), view("--")) {
            i += 1;
            break;
        }
        if eq(view(a), view("--rate")) && (i + 1 < args.len()) {
            i += 1;
            rate = number_of(view(item(&args, i)));
        } else if eq(view(a), view("--out")) && (i + 1 < args.len()) {
            i += 1;
            out_path = item(&args, i);
        } else {
            break;
        }
        i += 1;
    }
    mut rest = u8[][];
    while i < args.len() {
        rest.push(item(&args, i));
        i += 1;
    }
    if rest.len() == 0 {
        say(view("usage: grail profile [--rate N] [--out FILE] -- PROGRAM [ARGS]"));
        return 2;
    }
    if (rate == 0) || (1000000 < rate) {
        say(view("grail profile: --rate must be between 1 and 1000000 samples per second"));
        return 2;
    }
    if host::target() != 0 {
        say(view("grail profile: sampling is implemented for Linux x86-64 only"));
        return 2;
    }
    program := item(&rest, 0);
    if host::exists(view(program)) == 0 {
        say(view("grail profile: no such file: "));
        say(view(program));
        return 2;
    }
    // The arming request travels in the child's environment, so the target needs no writable
    // working directory and a killed run cannot leave a stale request behind for the next one.
    dir := profile_scratch();
    if dir.len() == 0 {
        say(view("grail profile: cannot create a directory for the samples under "));
        say(view(profile_temp()));
        return 2;
    }
    samples := path_join(view(dir), view("samples"));
    mut text = decimal(1);
    text.push(32);
    text = cat(view(text), view(decimal(rate)));
    text.push(32);
    text = cat(view(text), view(decimal(65536)));
    text.push(32);
    text = cat(view(text), view(samples));
    // The inherited environment plus the request, so the profiled program still sees everything it
    // would have seen; a child started with an explicit environment is not armed unless it copies
    // this entry.
    mut environment = host::environment();
    environment.push(cat(view("GRAIL_PROFILE="), view(text)));
    mut command = u8[][];
    command.push(item(&rest, 0));
    for n in rest.len() {
        if n != 0 {
            command.push(item(&rest, n));
        }
    }
    status := host::command_with(command, environment);
    mut out = u8[];
    mut title = cat(view("grail profile: "), view(program));
    push_line(&mut out, view(title));
    if host::exists(view(samples)) == 0 {
        push_line(
            &mut out,
            view("  no samples: the target did not arm the sampling runtime at startup")
        );
        say(view(out));
        host::remove(view(dir), 1);
        return status;
    }
    data := host::read_file(view(samples));
    host::remove(view(samples), 0);
    host::remove(view(dir), 1);
    if data.len() < 48 {
        say(view("grail profile: truncated sample file"));
        return 1;
    }
    if (data[0] != 71) || (data[6] != 50) {
        say(view("grail profile: unsupported sample format; rebuild the program with this compiler"));
        return 1;
    }
    sample_rate := le64(view(data), 8);
    capacity := le64(view(data), 16);
    count := le64(view(data), 24);
    dropped := le64(view(data), 32);
    cpu_ns := le64(view(data), 40);
    if data.len() < 48 + count * 8 {
        say(view("grail profile: truncated sample file"));
        return 1;
    }
    image := host::read_file(view(program));
    symbols := elf_symbols(view(image));
    kind := le16(view(image), 16);
    mut elf = false;
    if 4 <= image.len() {
        if (image[0] == 127) && (image[1] == 69) && (image[2] == 76) && (image[3] == 70) {
            elf = true;
        }
    }
    if !elf {
        push_line(&mut out, view("  not an ELF image: no symbols to attribute, every sample is [unknown]"));
    } else if kind == 3 {
        push_line(
            &mut out,
            view("  position independent (ET_DYN): sample addresses are relocated")
        );
        push_line(
            &mut out,
            view("  and cannot be matched to link-time symbols, so every sample is [unknown]")
        );
    } else {
        push_line(
            &mut out,
            view(
                "  non-PIE (ET_EXEC): sample addresses are link-time .symtab addresses, no adjustment"
            )
        );
    }
    mut intro = cat(view("  "), view(decimal(sample_rate)));
    intro = cat(view(intro), view(" Hz ITIMER_PROF, "));
    intro = cat(view(intro), view(decimal(count)));
    intro = cat(view(intro), view(" samples in "));
    intro = cat(view(intro), view(nanos_text(cpu_ns)));
    intro = cat(view(intro), view(" of CPU time"));
    if cpu_ns != 0 {
        intro = cat(view(intro), view(" (effective "));
        intro = cat(view(intro), view(decimal(effective_rate(count, cpu_ns))));
        intro = cat(view(intro), view(" Hz)"));
    }
    push_line(&mut out, view(intro));
    if capped(sample_rate, count, cpu_ns) {
        push_line(
            &mut out,
            view("  the effective rate is far below the request: the kernel accounts CPU time per")
        );
        push_line(
            &mut out,
            view("  tick, so intervals shorter than its granularity are rounded up")
        );
    }
    mut dropped_line = cat(view("  "), view(decimal(dropped)));
    dropped_line = cat(view(dropped_line), view(" samples dropped after the "));
    dropped_line = cat(view(dropped_line), view(decimal(capacity)));
    dropped_line = cat(view(dropped_line), view("-sample buffer filled"));
    if dropped != 0 {
        push_line(&mut out, view(dropped_line));
    }
    order := by_start(&symbols);
    mut counts = u64[];
    for n in symbols.len() + 1 {
        counts.push(0);
    }
    if elf && (kind != 3) {
        mut k: u64 = 0;
        while k < count {
            slot := symbol_at(&symbols, &order, le64(view(data), 48 + k * 8));
            counts[slot] = counts[slot] + 1;
            k += 1;
        }
    } else {
        counts[symbols.len()] = count;
    }
    mut width: u64 = 20;
    for n in symbols.len() {
        if width < symbols[n].function.len() {
            width = symbols[n].function.len();
        }
    }
    push_line(&mut out, view(""));
    mut header = copy(view("  "));
    header = cat(view(header), view(pad_left(view("samples"), 7)));
    header = cat(view(header), view(" "));
    header = cat(view(header), view(pad_left(view("share"), 6)));
    header = cat(view(header), view("  "));
    header = cat(view(header), view(padded(view("function"), width + 2)));
    header = cat(view(header), view("module"));
    push_line(&mut out, view(header));
    rows := by_count(&counts, &order);
    for n in rows.len() {
        s := &symbols[rows[n]];
        mut line = copy(view("  "));
        line = cat(view(line), view(pad_left(view(decimal(counts[rows[n]])), 7)));
        line = cat(view(line), view(" "));
        line = cat(view(line), view(pad_left(view(share_text(counts[rows[n]], count)), 6)));
        line = cat(view(line), view("  "));
        line = cat(view(line), view(padded(view(s.function), width + 2)));
        line = cat(view(line), view(s.module));
        push_line(&mut out, view(line));
    }
    mut unknown = copy(view("  "));
    unknown = cat(view(unknown), view(pad_left(view(decimal(counts[symbols.len()])), 7)));
    unknown = cat(view(unknown), view(" "));
    unknown = cat(view(unknown), view(pad_left(view(share_text(counts[symbols.len()], count)), 6)));
    unknown = cat(view(unknown), view("  "));
    unknown = cat(view(unknown), view(padded(view("[unknown]"), width + 2)));
    unknown = cat(view(unknown), view("-"));
    push_line(&mut out, view(unknown));
    mut total = copy(view("  "));
    total = cat(view(total), view(pad_left(view(decimal(count)), 7)));
    total = cat(view(total), view(" "));
    total = cat(view(total), view(pad_left(view(share_text(count, count)), 6)));
    total = cat(view(total), view("  total"));
    push_line(&mut out, view(total));
    host::print(view(out));
    if out_path.len() != 0 {
        if host::write_file(view(out_path), out) != 0 {
            say(view("grail profile: cannot write "));
            say(view(out_path));
            return 1;
        }
    }
    return status;
}

fn help() {
    say(view("grail - the Grail compiler and project tool\n"));
    say(view("usage:"));
    say(view("  grail build [FILE.grl] [-o OUT] [--target x86_64|aarch64|riscv64|macos-x86_64|macos-aarch64] [--split] [--cache] [--overflow=wrap|checked] [--interface DIR [--verify]]"));
    say(view("  grail check [FILE.grl]            type-check without building"));
    say(view("  grail check --interface DIR       write one checked interface per module"));
    say(view("  grail check --interface DIR --verify   refuse an interface that disagrees with its sources"));
    say(view("  grail debug lines|info BINARY     print DWARF line rows or .debug_info"));
    say(view("  grail cache prune [--keep N]       drop cache entries no build used in the last N (10)"));
    say(view("  grail cache clear                  empty the build cache"));
    say(view("  grail explain CODE                 what an error code means (error[E0004])"));
    say(view("  grail profile [--rate N] [--out FILE] -- PROGRAM [ARGS]   sampling profile"));
    say(view("  grail run [FILE.grl] [-- ARGS...]"));
    say(view("  grail test [FILES or DIRS]        compile and run tests/ (exit status 0 = pass)"));
    say(view("  grail fmt [--check] [FILES or DIRS]"));
    say(view("  grail new NAME                    create a project (grail.pkg, src/, tests/)"));
    say(view("  grail add NAME GIT-URL [REV]      add a dependency and fetch it"));
    say(view("  grail fetch                       fetch dependencies pinned in grail.lock"));
    say(
        view("  grail [--target T] [--overflow=checked|wrap] OUT.s ENTRY.grl MODULE.grl...  (compiler)")
    );
}
pub fn is_command<a>(name: &a [u8]) -> bool {
    return eq(view(name), view("build"))
        || eq(view(name), view("check"))
        || eq(view(name), view("run"))
        || eq(view(name), view("test"))
        || eq(view(name), view("fmt"))
        || eq(view(name), view("new"))
        || eq(view(name), view("add"))
        || eq(view(name), view("fetch"))
        || eq(view(name), view("debug"))
        || eq(view(name), view("profile"))
        || eq(view(name), view("cache"))
        || eq(view(name), view("explain"))
        || eq(view(name), view("install"))
        || eq(view(name), view("help"))
        || eq(view(name), view("--help"))
        || eq(view(name), view("version"))
        || eq(view(name), view("--version"));
}
pub fn run() -> u64 {
    name := host::arg(1);
    mut args = u8[][];
    mut i = 2;
    while i < host::argc() {
        args.push(host::arg(i));
        i += 1;
    }
    if eq(view(name), view("build")) {
        mut o = options(&args);
        return build(&args, &mut o);
    }
    if eq(view(name), view("check")) {
        return check_command(&args);
    }
    if eq(view(name), view("run")) {
        return run_command(&args);
    }
    if eq(view(name), view("test")) {
        return test_command(&args);
    }
    if eq(view(name), view("fmt")) {
        return fmt_command(&args);
    }
    if eq(view(name), view("new")) {
        return new_command(&args);
    }
    if eq(view(name), view("add")) {
        return add_command(&args);
    }
    if eq(view(name), view("fetch")) || eq(view(name), view("install")) {
        return fetch_command();
    }
    if eq(view(name), view("debug")) {
        return debug_command(&args);
    }
    if eq(view(name), view("cache")) {
        return cache_command(&args);
    }
    if eq(view(name), view("explain")) {
        // `grail explain E0004`: what an error code means and how it is usually fixed.
        if args.len() != 1 {
            say(view("usage: grail explain CODE   (the code an error prints, as in error[E0004])"));
            return 1;
        }
        text := explain::text(view(item(&args, 0)));
        if text.len() == 0 {
            say(view("grail: no such error code"));
            return 1;
        }
        host::print(view(text));
        return 0;
    }
    if eq(view(name), view("profile")) {
        return profile_command(&args);
    }
    if eq(view(name), view("version")) || eq(view(name), view("--version")) {
        say(view("grail 0.1.0"));
        return 0;
    }
    help();
    return 0;
}
