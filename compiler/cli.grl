module cli;
use host;
use fmt;

// The `grail` command-line tool. The same binary is the compiler: subcommands drive it by
// re-invoking itself (`grail [--target T] OUT.s ENTRY.grl MODULE.grl...`), then assemble and link.
struct Home {
    runtime: u8[],
    std: u8[]
}
struct Project {
    name: u8[],
    entry: u8[],
    deps: u8[][],
    urls: u8[][],
    revs: u8[][]
}

fn eq<a, b>(x: read<a>, y: read<b>) -> num {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn starts<a, b>(x: read<a>, y: read<b>) -> num {
    if x.len() < y.len() {
        return false;
    }
    for i in y.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn ends<a, b>(x: read<a>, y: read<b>) -> num {
    if x.len() < y.len() {
        return false;
    }
    d := x.len() - y.len();
    for i in y.len() {
        if x[d + i] != y[i] {
            return false;
        }
    }
    return true;
}
fn cat<a, b>(x: read<a>, y: read<b>) -> u8[] {
    mut o = u8[];
    for i in x.len() {
        o.push(x[i]);
    }
    for i in y.len() {
        o.push(y[i]);
    }
    return o;
}
fn copy<a>(x: read<a>) -> u8[] {
    mut o = u8[];
    for i in x.len() {
        o.push(x[i]);
    }
    return o;
}
fn path_join<a, b>(dir: read<a>, name: read<b>) -> u8[] {
    if (dir.len() == 0) + eq(&dir, &".") {
        return copy(&name);
    }
    if ends(&dir, &"/") {
        return cat(&dir, &name);
    }
    mut o = copy(&dir);
    o.push(47);
    for i in name.len() {
        o.push(name[i]);
    }
    return o;
}
fn dirname<a>(p: read<a>) -> u8[] {
    mut i = p.len();
    while 0 < i {
        i -= 1;
        if p[i] == 47 {
            mut o = u8[];
            for j in i {
                o.push(p[j]);
            }
            if i == 0 {
                o.push(47);
            }
            return o;
        }
    }
    return copy(&".");
}
fn basename<a>(p: read<a>) -> u8[] {
    mut start = 0;
    for i in p.len() {
        if p[i] == 47 {
            start = i + 1;
        }
    }
    mut o = u8[];
    mut end = p.len();
    if ends(&p, &".grl") {
        end -= 4;
    }
    mut i = start;
    while i < end {
        o.push(p[i]);
        i += 1;
    }
    return o;
}
fn say<a>(s: read<a>) {
    host::print(s);
    host::print(&"\n");
}
fn say2<a, b>(s: read<a>, t: read<b>) {
    host::print(s);
    host::print(t);
    host::print(&"\n");
}
fn item<a>(v: (&a u8[][]), i: num) -> u8[] {
    x := &v[i];
    return x.copy();
}
fn words<a>(line: read<a>) -> u8[][] {
    mut out = u8[][];
    mut cur = u8[];
    for i in line.len() {
        c := line[i];
        if (c == 32) + (c == 9) + (c == 13) {
            if cur.len() {
                out.push(exchange(borrow_mut(cur), u8[]));
            }
        } else {
            cur.push(c);
        }
    }
    if cur.len() {
        out.push(cur);
    }
    return out;
}
fn lines<a>(text: read<a>) -> u8[][] {
    mut out = u8[][];
    mut cur = u8[];
    for i in text.len() {
        c := text[i];
        if c == 10 {
            out.push(exchange(borrow_mut(cur), u8[]));
        } else {
            cur.push(c);
        }
    }
    if cur.len() {
        out.push(cur);
    }
    return out;
}

fn home() -> Home {
    env := host::env(&"GRAIL_HOME");
    if env.len() {
        installed := path_join(&env, &"runtime.grl");
        if host::exists(&installed) {
            return Home { runtime: installed, std: path_join(&env, &"std") };
        }
        repo := path_join(&env, &"compiler/runtime.grl");
        if host::exists(&repo) {
            return Home { runtime: repo, std: path_join(&env, &"lib") };
        }
    }
    exe := host::exe_path();
    mut dir = dirname(&exe);
    for level in 6 {
        installed := path_join(&dir, &"lib/grail/runtime.grl");
        if host::exists(&installed) {
            prefix := path_join(&dir, &"lib/grail");
            return Home { runtime: installed, std: path_join(&prefix, &"std") };
        }
        repo := path_join(&dir, &"compiler/runtime.grl");
        if host::exists(&repo) {
            return Home { runtime: repo, std: path_join(&dir, &"lib") };
        }
        dir = path_join(&dir, &"..");
    }
    say(&"grail: cannot find the Grail runtime; set GRAIL_HOME");
    return Home { runtime: u8[], std: u8[] };
}
fn collect<a, b>(dir: read<a>, out: (&mut b u8[][])) {
    entries := host::list_dir(&dir);
    for i in entries.len() {
        name := item(borrow(entries), i);
        if ends(&name, &"/") {
            if (starts(&name, &".") + eq(&name, &"target/")) == 0 {
                sub := path_join(&dir, &name);
                collect(&sub, borrow_mut(out));
            }
        } else {
            if ends(&name, &".grl") {
                out.push(path_join(&dir, &name));
            }
        }
    }
}
fn target_name(t: num) -> u8[] {
    if t == 1 {
        return copy(&"aarch64");
    }
    if t == 2 {
        return copy(&"riscv64");
    }
    return copy(&"x86_64");
}
fn tool<a, b>(variable: read<a>, fallback: read<b>) -> u8[] {
    v := host::env(variable);
    if v.len() {
        return v;
    }
    return copy(fallback);
}
fn compile<a, b, d, e, g>(
    h: (&a Home),
    entry: read<b>,
    modules: (&d u8[][]),
    output: read<e>,
    target: read<g>
) -> num {
    return compile_mode(h, entry, modules, output, target, 0);
}
// check_only: type-check and generate code, but do not assemble or link.
fn compile_mode<a, b, d, e, g>(
    h: (&a Home),
    entry: read<b>,
    modules: (&d u8[][]),
    output: read<e>,
    target: read<g>,
    check_only: num
) -> num {
    asm := cat(&output, &".s");
    object := cat(&output, &".o");
    mut command = u8[][
        host::exe_path(),
        copy(&"--target"),
        copy(&target),
        copy(&asm),
        copy(&entry)
    ];
    for i in modules.len() {
        command.push(item(borrow(modules), i));
    }
    std := host::list_dir(&h.std);
    for i in std.len() {
        name := item(borrow(std), i);
        if ends(&name, &".grl") {
            command.push(path_join(&h.std, &name));
        }
    }
    command.push(copy(&h.runtime));
    if host::command(command) != 0 {
        return 1;
    }
    if check_only {
        host::remove(&asm, 0);
        return 0;
    }
    mut triple = copy(&"--target=x86_64-linux-gnu");
    mut emulation = copy(&"elf_x86_64");
    if eq(&target, &"aarch64") {
        triple = copy(&"--target=aarch64-linux-gnu");
        emulation = copy(&"aarch64elf");
    }
    mut assemble = u8[][tool(&"GRAIL_ASSEMBLER", &"clang")];
    if eq(&target, &"riscv64") {
        triple = copy(&"--target=riscv64-linux-gnu");
        emulation = copy(&"elf64lriscv");
        assemble.push(copy(&"-march=rv64imafd"));
        assemble.push(copy(&"-mabi=lp64"));
    }
    assemble.push(triple);
    assemble.push(copy(&"-c"));
    assemble.push(copy(&asm));
    assemble.push(copy(&"-o"));
    assemble.push(copy(&object));
    if host::command(assemble) != 0 {
        say(&"grail: assembling failed (needs clang)");
        return 1;
    }
    link := u8[][
        tool(&"GRAIL_LINKER", &"ld.lld"),
        copy(&"-m"),
        emulation,
        copy(&object),
        copy(&"-o"),
        copy(&output)
    ];
    if host::command(link) != 0 {
        say(&"grail: linking failed (needs ld.lld)");
        return 1;
    }
    return 0;
}
fn load_project() -> Project {
    mut p = Project {
        name: u8[],
        entry: copy(&"src/main.grl"),
        deps: u8[][],
        urls: u8[][],
        revs: u8[][],
    };
    if host::exists(&"grail.pkg") == 0 {
        return p;
    }
    text := host::read_file(&"grail.pkg");
    rows := lines(&text);
    for i in rows.len() {
        row := item(borrow(rows), i);
        w := words(&row);
        if 1 < w.len() {
            key := item(borrow(w), 0);
            value := item(borrow(w), 1);
            if eq(&key, &"name") {
                p.name = value;
            } else {
                if eq(&key, &"entry") {
                    p.entry = value;
                } else {
                    if eq(&key, &"dep") & (2 < w.len()) {
                        p.deps.push(value);
                        p.urls.push(item(borrow(w), 2));
                        mut rev = u8[];
                        if 3 < w.len() {
                            rev = item(borrow(w), 3);
                        }
                        p.revs.push(rev);
                    }
                }
            }
        }
    }
    return p;
}
// Project modules: every .grl under src/ except the entry, plus every fetched dependency's src/.
fn project_modules<a>(p: (&a Project), skip_entry: num) -> u8[][] {
    mut all = u8[][];
    collect(&"src", borrow_mut(all));
    for i in p.deps.len() {
        name := item(borrow(p.deps), i);
        d := path_join(&".grail/deps", &name);
        src := path_join(&d, &"src");
        collect(&src, borrow_mut(all));
    }
    mut out = u8[][];
    for i in all.len() {
        f := item(borrow(all), i);
        if (skip_entry & eq(&f, &p.entry)) == 0 {
            out.push(f);
        }
    }
    return out;
}
struct Options {
    file: u8[],
    output: u8[],
    target: u8[],
    rest: u8[][],
    check: num,
    paths: u8[][]
}
fn options<a>(args: (&a u8[][])) -> Options {
    mut o = Options {
        file: u8[],
        output: u8[],
        target: target_name(host::target()),
        rest: u8[][],
        check: 0,
        paths: u8[][],
    };
    mut i = 0;
    mut passthrough = 0;
    while i < args.len() {
        a := item(borrow(args), i);
        if passthrough {
            o.rest.push(a);
        } else {
            if eq(&a, &"--") {
                passthrough = 1;
            } else {
                if eq(&a, &"-o") & (i + 1 < args.len()) {
                    i += 1;
                    o.output = item(borrow(args), i);
                } else {
                    if eq(&a, &"--target") & (i + 1 < args.len()) {
                        i += 1;
                        o.target = item(borrow(args), i);
                    } else {
                        if eq(&a, &"--check") {
                            o.check = 1;
                        } else {
                            if ends(&a, &".grl") & (o.file.len() == 0) {
                                o.file = copy(&a);
                                o.paths.push(a);
                            } else {
                                o.paths.push(a);
                            }
                        }
                    }
                }
            }
        }
        i += 1;
    }
    return o;
}
fn build<a, b>(args: (&a u8[][]), o: (&mut b Options)) -> num {
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    host::mkdir(&"target");
    if o.file.len() {
        if o.output.len() == 0 {
            stem := basename(&o.file);
            o.output = path_join(&"target", &stem);
        }
        mut none = u8[][];
        return compile(borrow(h), &o.file, borrow(none), &o.output, &o.target);
    }
    p := load_project();
    if p.name.len() == 0 {
        say(&"grail: no .grl file given and no grail.pkg here (try `grail new NAME`)");
        return 1;
    }
    if o.output.len() == 0 {
        o.output = path_join(&"target", &p.name);
    }
    modules := project_modules(borrow(p), 1);
    return compile(borrow(h), &p.entry, borrow(modules), &o.output, &o.target);
}
fn check_command<a>(args: (&a u8[][])) -> num {
    o := options(borrow(args));
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    host::mkdir(&"target");
    mut status = 0;
    if o.file.len() {
        stem := basename(&o.file);
        out := path_join(&"target", &stem);
        mut none = u8[][];
        status = compile_mode(borrow(h), &o.file, borrow(none), &out, &o.target, 1);
    } else {
        p := load_project();
        if p.name.len() == 0 {
            say(&"grail: no .grl file given and no grail.pkg here");
            return 1;
        }
        out := path_join(&"target", &p.name);
        modules := project_modules(borrow(p), 1);
        status = compile_mode(borrow(h), &p.entry, borrow(modules), &out, &o.target, 1);
    }
    if status == 0 {
        say(&"ok");
    }
    return status;
}
fn run_command<a>(args: (&a u8[][])) -> num {
    mut o = options(borrow(args));
    host_target := target_name(host::target());
    if eq(&o.target, &host_target) == 0 {
        say(
            &"grail run: cross-target executables must be run with an emulator; use grail build --target"
        );
        return 1;
    }
    if build(borrow(args), borrow_mut(o)) != 0 {
        return 1;
    }
    mut command = u8[][];
    out := copy(&o.output);
    if starts(&out, &"/") {
        command.push(out);
    } else {
        command.push(path_join(&".", &out));
    }
    for i in o.rest.len() {
        command.push(item(borrow(o.rest), i));
    }
    return host::command(command);
}
fn test_command<a>(args: (&a u8[][])) -> num {
    o := options(borrow(args));
    h := home();
    if h.runtime.len() == 0 {
        return 1;
    }
    mut files = u8[][];
    if o.paths.len() {
        for i in o.paths.len() {
            x := item(borrow(o.paths), i);
            if ends(&x, &".grl") {
                files.push(x);
            } else {
                collect(&x, borrow_mut(files));
            }
        }
    } else {
        collect(&"tests", borrow_mut(files));
    }
    p := load_project();
    modules := project_modules(borrow(p), 1);
    host::mkdir(&"target");
    host::mkdir(&"target/tests");
    mut failed = 0;
    for i in files.len() {
        f := item(borrow(files), i);
        stem := basename(&f);
        out := path_join(&"target/tests", &stem);
        host::print(&"test ");
        host::print(&f);
        host::print(&" ... ");
        mut status = compile(borrow(h), &f, borrow(modules), &out, &o.target);
        if status == 0 {
            exe := path_join(&".", &out);
            status = host::command(u8[][exe]);
        }
        if status == 0 {
            say(&"ok");
        } else {
            say(&"FAILED");
            failed += 1;
        }
    }
    host::print_num(files.len() - failed);
    host::print(&" passed, ");
    host::print_num(failed);
    say(&" failed");
    if files.len() == 0 {
        say(&"grail test: no tests found (put programs in tests/)");
    }
    return failed != 0;
}
fn fmt_command<a>(args: (&a u8[][])) -> num {
    o := options(borrow(args));
    mut files = u8[][];
    if o.paths.len() == 0 {
        collect(&".", borrow_mut(files));
    }
    for i in o.paths.len() {
        x := item(borrow(o.paths), i);
        if ends(&x, &".grl") {
            files.push(x);
        } else {
            collect(&x, borrow_mut(files));
        }
    }
    mut changed = 0;
    for i in files.len() {
        f := item(borrow(files), i);
        data := host::read_file(&f);
        out := fmt::format(&data);
        if eq(&data, &out) == 0 {
            changed += 1;
            if o.check {
                say2(&"would reformat ", &f);
            } else {
                host::write_file(&f, &out);
                say2(&"formatted ", &f);
            }
        }
    }
    if o.check {
        return changed != 0;
    }
    return 0;
}
fn new_command<a>(args: (&a u8[][])) -> num {
    if args.len() == 0 {
        say(&"usage: grail new NAME");
        return 1;
    }
    name := item(borrow(args), 0);
    if host::exists(&name) {
        say2(&"grail new: already exists: ", &name);
        return 1;
    }
    host::mkdir(&name);
    src := path_join(&name, &"src");
    host::mkdir(&src);
    tests := path_join(&name, &"tests");
    host::mkdir(&tests);
    mut manifest = copy(&"name ");
    for i in name.len() {
        manifest.push(name[i]);
    }
    manifest.push(10);
    pkg := path_join(&name, &"grail.pkg");
    host::write_file(&pkg, &manifest);
    main := path_join(&src, &"main.grl");
    host::write_file(&main, &"fn main() {\n    println(\"Hello, world!\");\n}\n");
    test := path_join(&tests, &"smoke.grl");
    host::write_file(&test, &"fn main() {\n    assert(1 + 1 == 2);\n}\n");
    ignore := path_join(&name, &".gitignore");
    host::write_file(&ignore, &"target/\n.grail/\n");
    say2(&"created project ", &name);
    return 0;
}
fn lock_lookup<a, b>(lock: read<a>, name: read<b>) -> u8[] {
    rows := lines(&lock);
    for i in rows.len() {
        row := item(borrow(rows), i);
        w := words(&row);
        if 1 < w.len() {
            k := item(borrow(w), 0);
            if eq(&k, &name) {
                return item(borrow(w), 1);
            }
        }
    }
    return u8[];
}
fn fetch_command() -> num {
    p := load_project();
    if p.name.len() == 0 {
        say(&"grail: no grail.pkg here");
        return 1;
    }
    mut lock = u8[];
    if host::exists(&"grail.lock") {
        lock = host::read_file(&"grail.lock");
    }
    host::mkdir(&".grail");
    host::mkdir(&".grail/deps");
    mut newlock = u8[];
    for i in p.deps.len() {
        name := item(borrow(p.deps), i);
        url := item(borrow(p.urls), i);
        rev := item(borrow(p.revs), i);
        dir := path_join(&".grail/deps", &name);
        if host::exists(&dir) == 0 {
            say2(&"fetching ", &name);
            if host::command(
                u8[][copy(&"git"), copy(&"clone"), copy(&"--quiet"), copy(&url), copy(&dir)]
            )
                != 0 {
                say2(&"grail: git clone failed for ", &url);
                return 1;
            }
            mut pin = lock_lookup(&lock, &name);
            if pin.len() == 0 {
                pin = copy(&rev);
            }
            if pin.len() {
                if host::command(
                    u8[][
                        copy(&"git"),
                        copy(&"-C"),
                        copy(&dir),
                        copy(&"checkout"),
                        copy(&"--quiet"),
                        pin
                    ]
                )
                    != 0 {
                    say2(&"grail: cannot check out revision for ", &name);
                    return 1;
                }
            }
        }
        record := path_join(&dir, &".grail-commit");
        mut script = copy(&"git -C '");
        for j in dir.len() {
            script.push(dir[j]);
        }
        tail := cat(&"' rev-parse HEAD > '", &record);
        for j in tail.len() {
            script.push(tail[j]);
        }
        script.push(39);
        if host::command(u8[][copy(&"sh"), copy(&"-c"), script]) != 0 {
            return 1;
        }
        commit := host::read_file(&record);
        for j in name.len() {
            newlock.push(name[j]);
        }
        newlock.push(32);
        for j in commit.len() {
            if commit[j] != 10 {
                newlock.push(commit[j]);
            }
        }
        newlock.push(10);
    }
    host::write_file(&"grail.lock", &newlock);
    return 0;
}
fn add_command<a>(args: (&a u8[][])) -> num {
    if args.len() < 2 {
        say(&"usage: grail add NAME GIT-URL [REVISION]");
        return 1;
    }
    if host::exists(&"grail.pkg") == 0 {
        say(&"grail: no grail.pkg here");
        return 1;
    }
    name := item(borrow(args), 0);
    url := item(borrow(args), 1);
    p := load_project();
    for i in p.deps.len() {
        d := item(borrow(p.deps), i);
        if eq(&d, &name) {
            say2(&"grail add: dependency already listed: ", &name);
            return fetch_command();
        }
    }
    mut text = host::read_file(&"grail.pkg");
    if text.len() {
        if text[text.len() - 1] != 10 {
            text.push(10);
        }
    }
    line := cat(&"dep ", &name);
    for i in line.len() {
        text.push(line[i]);
    }
    text.push(32);
    for i in url.len() {
        text.push(url[i]);
    }
    if 2 < args.len() {
        rev := item(borrow(args), 2);
        text.push(32);
        for i in rev.len() {
            text.push(rev[i]);
        }
    }
    text.push(10);
    host::write_file(&"grail.pkg", &text);
    return fetch_command();
}
fn help() {
    say(&"grail - the Grail compiler and project tool\n");
    say(&"usage:");
    say(&"  grail build [FILE.grl] [-o OUT] [--target x86_64|aarch64|riscv64]");
    say(&"  grail check [FILE.grl]            type-check without building");
    say(&"  grail run [FILE.grl] [-- ARGS...]");
    say(&"  grail test [FILES or DIRS]        compile and run tests/ (exit status 0 = pass)");
    say(&"  grail fmt [--check] [FILES or DIRS]");
    say(&"  grail new NAME                    create a project (grail.pkg, src/, tests/)");
    say(&"  grail add NAME GIT-URL [REV]      add a dependency and fetch it");
    say(&"  grail fetch                       fetch dependencies pinned in grail.lock");
    say(
        &"  grail [--target T] [--overflow=checked|wrap] OUT.s ENTRY.grl MODULE.grl...  (compiler)"
    );
}
pub fn is_command<a>(name: read<a>) -> num {
    return eq(&name, &"build")
        + eq(&name, &"check")
        + eq(&name, &"run")
        + eq(&name, &"test")
        + eq(&name, &"fmt")
        + eq(&name, &"new")
        + eq(&name, &"add")
        + eq(&name, &"fetch")
        + eq(&name, &"install")
        + eq(&name, &"help")
        + eq(&name, &"--help")
        + eq(&name, &"version")
        + eq(&name, &"--version");
}
pub fn run() -> num {
    name := host::arg(1);
    mut args = u8[][];
    mut i = 2;
    while i < host::argc() {
        args.push(host::arg(i));
        i += 1;
    }
    if eq(&name, &"build") {
        mut o = options(borrow(args));
        return build(borrow(args), borrow_mut(o));
    }
    if eq(&name, &"check") {
        return check_command(borrow(args));
    }
    if eq(&name, &"run") {
        return run_command(borrow(args));
    }
    if eq(&name, &"test") {
        return test_command(borrow(args));
    }
    if eq(&name, &"fmt") {
        return fmt_command(borrow(args));
    }
    if eq(&name, &"new") {
        return new_command(borrow(args));
    }
    if eq(&name, &"add") {
        return add_command(borrow(args));
    }
    if eq(&name, &"fetch") + eq(&name, &"install") {
        return fetch_command();
    }
    if eq(&name, &"version") + eq(&name, &"--version") {
        say(&"grail 0.1.0");
        return 0;
    }
    help();
    return 0;
}
