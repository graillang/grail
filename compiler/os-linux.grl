unsafe module runtime;

// Linux syscall boundary. The portable runtime calls these operation IDs; `os-windows.grl` is the
// PE counterpart with the same signatures. Operation IDs are stable runtime identifiers, not the
// target's syscall ABI.
fn rt_syscall(n: u64, a: u64, b: u64, c: u64) -> u64 {
    if raw_target() == 0 {
        return raw_syscall(n, a, b, c);
    }
    if n == 0 {
        return raw_syscall(63, a, b, c);
    }
    if n == 1 {
        return raw_syscall(64, a, b, c);
    }
    if n == 2 {
        return raw_syscall4(56, wrapping_sub(0, 100), a, b, c);
    }
    if n == 3 {
        return raw_syscall(57, a, b, c);
    }
    if n == 11 {
        return raw_syscall(215, a, b, c);
    }
    if n == 27 {
        return raw_syscall(232, a, b, c);
    }
    if n == 39 {
        return raw_syscall(172, a, b, c);
    }
    if n == 57 {
        return raw_syscall(220, 17, 0, 0);
    }
    if n == 202 {
        return raw_syscall(98, a, b, c);
    }
    if n == 10 {
        return raw_syscall(226, a, b, c);
    }
    if n == 204 {
        return raw_syscall(123, a, b, c);
    }
    if n == 231 {
        return raw_syscall(94, a, b, c);
    }
    if n == 291 {
        return raw_syscall(20, a, b, c);
    }
    if n == 283 {
        return raw_syscall(85, a, b, c);
    }
    if n == 293 {
        return raw_syscall(59, a, b, c);
    }
    if n == 271 {
        return raw_syscall(73, a, b, c);
    }
    if n == 228 {
        return raw_syscall(113, a, b, c);
    }
    if n == 35 {
        return raw_syscall(101, a, b, c);
    }
    if n == 290 {
        return raw_syscall(19, a, b, c);
    }
    if n == 263 {
        return raw_syscall(35, a, b, c);
    }
    if n == 217 {
        return raw_syscall(61, a, b, c);
    }
    if n == 41 {
        return raw_syscall(198, a, b, c);
    }
    if n == 49 {
        return raw_syscall(200, a, b, c);
    }
    if n == 50 {
        return raw_syscall(201, a, b, c);
    }
    if n == 42 {
        return raw_syscall(203, a, b, c);
    }
    if n == 51 {
        return raw_syscall(204, a, b, c);
    }
    if n == 258 {
        return raw_syscall(34, a, b, c);
    }
    if n == 59 {
        return raw_syscall(221, a, b, c);
    }
    if n == 60 {
        return raw_syscall(93, a, b, c);
    }
    if n == 61 {
        return raw_syscall(260, a, b, c);
    }
    if n == 62 {
        return raw_syscall(129, a, b, c);
    }
    return wrapping_sub(0, 38);
}

// Trusted native runtime, entirely Grail. Raw intrinsics below are the compiler/OS boundary.
// All runtime values are words. Sequence = {data,length,capacity}; allocation header = {class,link}.
// Process state: argc,argv,envp,live allocation count,arena chain; allocator bins start at byte 256.
// Freed blocks return to segregated free lists; mapped arenas are unmapped by rt_shutdown.

fn rt_syscall4(n: u64, a: u64, b: u64, c: u64, d: u64) -> u64 {
    if raw_target() == 0 {
        return raw_syscall4(n, a, b, c, d);
    }
    if n == 233 {
        return raw_syscall4(21, a, b, c, d);
    }
    if n == 281 {
        return raw_syscall4(22, a, b, c, d);
    }
    if n == 286 {
        return raw_syscall4(86, a, b, c, d);
    }
    if n == 25 {
        return raw_syscall4(216, a, b, c, d);
    }
    return wrapping_sub(0, 38);
}
// Abort's last step. Operation 231 is exit_group on every Linux target: it runs no atexit handlers,
// no C++ destructors and no stdio flush, so an abort can never execute foreign cleanup. exit(2)
// (operation 60 on x86-64) would, so the abort path never uses it.
fn rt_hard_exit(code: u64) -> u64 {
    rt_syscall(231, code, 0, 0);
    return 0;
}
fn rt_readlinkat(path: u64, buf: u64, size: u64) -> u64 {
    if raw_target() == 0 {
        return raw_syscall4(267, wrapping_sub(0, 100), path, buf, size);
    }
    return raw_syscall4(78, wrapping_sub(0, 100), path, buf, size);
}
fn rt_faccessat(path: u64) -> u64 {
    if raw_target() == 0 {
        return raw_syscall4(269, wrapping_sub(0, 100), path, 0, 0);
    }
    return raw_syscall4(48, wrapping_sub(0, 100), path, 0, 0);
}
fn rt_accept4(fd: u64) -> u64 {
    if raw_target() == 0 {
        return raw_syscall4(288, fd, 0, 0, 526336);
    }
    return raw_syscall4(242, fd, 0, 0, 526336);
}

// Linux keeps argv/envp from the entry stub and needs no further process setup.
fn rt_os_init() -> u64 {
    return 0;
}
