unsafe module runtime;

// Linux syscall boundary. The portable runtime calls these operation IDs; `os-windows.grl` is the
// PE counterpart with the same signatures. Operation IDs are stable runtime identifiers, not the
// target's syscall ABI.
fn rt_syscall(n: u64, a: u64, b: u64, c: u64) -> u64 {
    if raw_target() == 0 {
        if rt_comptime_on() {
            rt_comptime_check(n, a);
        }
        return raw_syscall(n, a, b, c);
    }
    if n == 0 {
        return raw_syscall(63, a, b, c);
    }
    if n == 1 {
        return raw_syscall(64, a, b, c);
    }
    if n == 2 {
        return raw_syscall4(56, wrapping_sub(0, 100), a, b, c);
    }
    if n == 3 {
        return raw_syscall(57, a, b, c);
    }
    if n == 11 {
        return raw_syscall(215, a, b, c);
    }
    if n == 27 {
        return raw_syscall(232, a, b, c);
    }
    if n == 39 {
        return raw_syscall(172, a, b, c);
    }
    if n == 57 {
        return raw_syscall(220, 17, 0, 0);
    }
    if n == 202 {
        return raw_syscall(98, a, b, c);
    }
    if n == 10 {
        return raw_syscall(226, a, b, c);
    }
    if n == 204 {
        return raw_syscall(123, a, b, c);
    }
    if n == 231 {
        return raw_syscall(94, a, b, c);
    }
    if n == 291 {
        return raw_syscall(20, a, b, c);
    }
    if n == 283 {
        return raw_syscall(85, a, b, c);
    }
    if n == 293 {
        return raw_syscall(59, a, b, c);
    }
    if n == 292 {
        return raw_syscall(24, a, b, c);
    }
    if n == 271 {
        return raw_syscall(73, a, b, c);
    }
    if n == 228 {
        return raw_syscall(113, a, b, c);
    }
    if n == 35 {
        return raw_syscall(101, a, b, c);
    }
    if n == 290 {
        return raw_syscall(19, a, b, c);
    }
    if n == 263 {
        return raw_syscall(35, a, b, c);
    }
    if n == 217 {
        return raw_syscall(61, a, b, c);
    }
    if n == 41 {
        return raw_syscall(198, a, b, c);
    }
    if n == 49 {
        return raw_syscall(200, a, b, c);
    }
    if n == 50 {
        return raw_syscall(201, a, b, c);
    }
    if n == 42 {
        return raw_syscall(203, a, b, c);
    }
    if n == 51 {
        return raw_syscall(204, a, b, c);
    }
    if n == 258 {
        return raw_syscall(34, a, b, c);
    }
    if n == 59 {
        return raw_syscall(221, a, b, c);
    }
    if n == 60 {
        return raw_syscall(93, a, b, c);
    }
    if n == 61 {
        return raw_syscall(260, a, b, c);
    }
    if n == 62 {
        return raw_syscall(129, a, b, c);
    }
    return wrapping_sub(0, 38);
}

// Trusted native runtime, entirely Grail. Raw intrinsics below are the compiler/OS boundary.
// All runtime values are words. Sequence = {data,length,capacity}; allocation header = {class,link}.
// Process state: argc,argv,envp,live allocation count,arena chain; allocator bins start at byte 256.
// Freed blocks return to segregated free lists; mapped arenas are unmapped by rt_shutdown.

fn rt_syscall4(n: u64, a: u64, b: u64, c: u64, d: u64) -> u64 {
    if raw_target() == 0 {
        return raw_syscall4(n, a, b, c, d);
    }
    if n == 233 {
        return raw_syscall4(21, a, b, c, d);
    }
    if n == 281 {
        return raw_syscall4(22, a, b, c, d);
    }
    if n == 286 {
        return raw_syscall4(86, a, b, c, d);
    }
    if n == 25 {
        return raw_syscall4(216, a, b, c, d);
    }
    // Signal setup: the portable runtime asks with the x86-64 numbers, and every other ELF target
    // uses the generic table (rt_sigaction 134, sigaltstack 132).
    if n == 13 {
        return raw_syscall4(134, a, b, c, d);
    }
    if n == 131 {
        return raw_syscall4(132, a, b, c, d);
    }
    if n == 262 {
        return raw_syscall4(79, a, b, c, d); // newfstatat
    }
    if n == 264 {
        return raw_syscall4(38, a, b, c, d); // renameat
    }
    if n == 266 {
        return raw_syscall4(36, a, b, c, d); // symlinkat
    }
    if n == 271 {
        return raw_syscall4(73, a, b, c, d); // ppoll
    }
    return wrapping_sub(0, 38);
}
// Abort's last step. Operation 231 is exit_group on every Linux target: it runs no atexit handlers,
// no C++ destructors and no stdio flush, so an abort can never execute foreign cleanup. exit(2)
// (operation 60 on x86-64) would, so the abort path never uses it.
fn rt_hard_exit(code: u64) -> u64 {
    rt_syscall(231, code, 0, 0);
    return 0;
}
// The running image: readlink(2) resolves /proc/self/exe to it.
fn rt_exe_path(buf: u64, size: u64) -> u64 {
    path := rt_alloc(16);
    raw_store(path, 7310238724270485551);
    raw_store(path + 8, 111567768086124); // "/proc/self/exe"
    n := rt_readlinkat(path, buf, size - 1);
    rt_free(path);
    if rt_error(n) == 0 {
        raw_putbyte(buf + n, 0);
    }
    return n;
}
fn rt_readlinkat(path: u64, buf: u64, size: u64) -> u64 {
    if raw_target() == 0 {
        return raw_syscall4(267, wrapping_sub(0, 100), path, buf, size);
    }
    return raw_syscall4(78, wrapping_sub(0, 100), path, buf, size);
}
fn rt_faccessat(path: u64) -> u64 {
    if raw_target() == 0 {
        return raw_syscall4(269, wrapping_sub(0, 100), path, 0, 0);
    }
    return raw_syscall4(48, wrapping_sub(0, 100), path, 0, 0);
}
fn rt_accept4(fd: u64) -> u64 {
    if raw_target() == 0 {
        return raw_syscall4(288, fd, 0, 0, 526336);
    }
    return raw_syscall4(242, fd, 0, 0, 526336);
}

// Runs `argv` (a NUL-terminated table of words) once per candidate in `paths` and waits for the
// child. `envp` is a NUL-terminated "NAME=VALUE" table the child starts with, or 0 to inherit this
// process's environment. fork/execve/wait4 only: every candidate, every string and the whole
// environment are prepared by the caller, so the post-fork child allocates nothing, takes no
// runtime lock and runs no cleanup.
//
// Returns 0..255 for an exit code, 128+N when signal N ended the child, and 256+errno when the child
// could not be forked or reaped.
fn rt_spawn_wait(paths: u64, argv: u64, envp: u64) -> u64 {
    mut environment = envp;
    if environment == 0 {
        environment = raw_load(raw_state() + 16);
    }
    child := rt_syscall(57, 0, 0, 0);
    if child == 0 {
        n := rt_len(paths);
        mut i = 0;
        while i < n {
            // execve only returns when the candidate failed; the next one is tried with the same
            // environment. No dynamic loader is involved, so envp is the child's whole environment.
            rt_syscall(59, rt_at(paths, i), argv, environment);
            i += 1;
        }
        rt_syscall(60, 127, 0, 0);
    }
    if rt_error(child) {
        return 256 + wrapping_sub(0, child);
    }
    status := rt_alloc(8);
    mut waited = 0;
    while 1 {
        waited = rt_syscall(61, child, status, 0);
        if waited != wrapping_sub(0, 4) {
            break;
        }
    }
    mut result = 0;
    if rt_error(waited) {
        result = 256 + wrapping_sub(0, waited);
    } else {
        code := raw_load(status);
        sig := code & 127;
        if sig != 0 {
            result = 128 + sig;
        } else {
            result = rt_div(code, 256) & 255;
        }
    }
    rt_free(status);
    return result;
}

// Linux keeps argv/envp from the entry stub and needs no further process setup beyond the stack
// fault handler: the main thread takes it, and an alternate stack to run it on, before any user code
// can run out of stack. A program that spawns a task installs the same pair on each worker when the
// worker starts (rt_os_sched_prepare).
fn rt_os_init() -> u64 {
    rt_os_stack_guard_install_main();
    return 0;
}

// ---- compile-time evaluation (docs/design/comptime.md, C3) ----
// A probe the compiler runs for a compile-time call has GRAIL_COMPTIME=1 in its environment. Then
// only what computing a value needs gets through: writing the value to stdout (and an abort's
// message to stderr), memory, signals, thread setup and exit. Files, the clock, randomness, the
// network and other processes are refused, so a compile-time result depends on the source alone.
// The decision is made once and kept in state word 3224.
// A probe reached a constant that is still being computed: a dependency cycle (exit 4).
fn rt_comptime_cycle() -> u64 {
    raw_syscall(231, 4, 0, 0);
    return 0;
}
fn rt_comptime_on() -> bool {
    word := raw_state() + 3224;
    mut mode = raw_load(word);
    if mode == 0 {
        mode = 1;
        envp := raw_load(raw_state() + 16);
        if envp != 0 {
            mut i = 0;
            while raw_load(envp + i * 8) != 0 {
                e := raw_load(envp + i * 8);
                if rt_comptime_entry(e) {
                    mode = 2;
                }
                i = i + 1;
            }
        }
        raw_store(word, mode);
    }
    return mode == 2;
}
fn rt_comptime_entry(e: u64) -> bool {
    // "GRAIL_COMPTIME=1" and its terminator. No allocation here: this runs inside rt_syscall,
    // which the allocator itself calls.
    return (raw_byte(e + 0) == 71) &
        (raw_byte(e + 1) == 82) &
        (raw_byte(e + 2) == 65) &
        (raw_byte(e + 3) == 73) &
        (raw_byte(e + 4) == 76) &
        (raw_byte(e + 5) == 95) &
        (raw_byte(e + 6) == 67) &
        (raw_byte(e + 7) == 79) &
        (raw_byte(e + 8) == 77) &
        (raw_byte(e + 9) == 80) &
        (raw_byte(e + 10) == 84) &
        (raw_byte(e + 11) == 73) &
        (raw_byte(e + 12) == 77) &
        (raw_byte(e + 13) == 69) &
        (raw_byte(e + 14) == 61) &
        (raw_byte(e + 15) == 49) &
        (raw_byte(e + 16) == 0);
}
fn rt_comptime_allowed(n: u64) -> bool {
    return (n == 9) | (n == 10) | (n == 11) | (n == 12) | (n == 13) | (n == 14) | (n == 24) | (n == 25)
        | (n == 28) | (n == 39) | (n == 60) | (n == 131) | (n == 158) | (n == 186) | (n == 202)
        | (n == 218) | (n == 231) | (n == 234);
}
fn rt_comptime_check(n: u64, a: u64) -> u64 {
    if (n == 1) & ((a == 1) | (a == 2)) {
        return 0;
    }
    if rt_comptime_allowed(n) {
        return 0;
    }
    // The message is built in state words 3232..3384 (claimed for this), not allocated.
    scratch := raw_state() + 3232;
    raw_store(scratch + 0, 7142773272180060773);
    raw_store(scratch + 8, 8371458798651469167);
    raw_store(scratch + 16, 7306086967037750633);
    raw_store(scratch + 24, 2338616626601091872);
    raw_store(scratch + 32, 7308332182666572661);
    raw_store(scratch + 40, 7142820508308876403);
    raw_store(scratch + 48, 7526676252395269996);
    raw_store(scratch + 56, 8245940784540295269);
    raw_store(scratch + 64, 8030604370216165483);
    raw_store(scratch + 72, 2941629332940131);
    raw_syscall(1, 2, scratch, 79);
    raw_syscall(231, 3, 0, 0);
    return 0;
}

// ---- green-task execution contexts ----
// Linux has both halves of the green design: a direct stack switch (raw_switch, emitted for the ELF
// targets) and a readiness reactor (epoll plus eventfd/timerfd), so a task parks on an epoll
// registration and a host operation that would block is offloaded instead (rt_offload).
fn rt_os_reactor() -> u64 {
    return 1;
}
// One scheduler worker per CPU. The floor of two keeps a cooperative program making progress on a
// single-core host (a task that spins waiting for a sibling must have a sibling thread to run on),
// and the ceiling bounds the per-worker deque and stack caches.
fn rt_os_workers() -> u64 {
    mut workers = rt_cpus();
    if workers < 2 {
        workers = 2;
    }
    if 64 < workers {
        workers = 64;
    }
    return workers;
}
fn rt_os_sched_prepare() -> u64 {
    // Installs the process-wide task-stack fault handler and this worker's alternate signal stack.
    rt_os_stack_guard_install();
    return 0;
}

// ---- reactor: epoll, eventfd and timerfd --------------------------------------------------------
// The portable scheduler owns the task states; this module owns the file descriptors. Readiness and
// timers are one-shot epoll registrations whose data word is the task to wake, and the eventfd is
// the fence that makes the reactor complete a batch.
fn rt_os_ready() -> u64 {
    return 1;
}
fn rt_os_reactor_open(s: u64) -> u64 {
    epoll := rt_syscall(291, 524288, 0, 0);
    if rt_error(epoll) {
        return 0;
    }
    fence := rt_syscall(290, 0, 526336, 0);
    if rt_error(fence) {
        rt_syscall(3, epoll, 0, 0);
        return 0;
    }
    ev := raw_map(4096);
    if rt_error(ev) {
        rt_syscall(3, fence, 0, 0);
        rt_syscall(3, epoll, 0, 0);
        return 0;
    }
    raw_store(ev, 1); // EPOLLIN, data 0 marks the fence descriptor
    if rt_error(rt_syscall4(233, epoll, 1, fence, ev)) {
        rt_syscall(11, ev, 4096, 0);
        rt_syscall(3, fence, 0, 0);
        rt_syscall(3, epoll, 0, 0);
        return 0;
    }
    rt_syscall(11, ev, 4096, 0);
    raw_store(s + 48, fence);
    return epoll;
}
fn rt_os_reactor_fence(s: u64) -> u64 {
    one := rt_alloc(8);
    raw_store(one, 1);
    rt_syscall(1, raw_load(s + 48), one, 8);
    rt_free(one);
    return 0;
}
fn rt_os_reactor_loop(s: u64) -> u64 {
    events := raw_map(4096);
    scratch := events + 2048;
    epoll := raw_load(s + 40);
    // epoll_event is packed on x86-64 (12 bytes) and padded on the other targets (16).
    mut width = 16;
    if raw_target() == 0 {
        width = 12;
    }
    while true {
        n := rt_syscall4(281, epoll, events, 64, wrapping_sub(0, 1));
        if rt_error(n) == 0 {
            mut i = 0;
            while i < n {
                mut at = events + i * width + 8;
                if width == 12 {
                    at = events + i * 12 + 4;
                }
                task := raw_load(at);
                if task == 0 {
                    rt_syscall(0, raw_load(s + 48), scratch, 8);
                } else {
                    rt_wake(task);
                }
                i += 1;
            }
        }
        rt_atomic_fetch_add(s + 56, 1);
    }
    return 0;
}
// One-shot readiness registration for `task`. Returns 0 when armed, non-zero when the descriptor
// cannot be watched (the caller then retries the operation instead of parking).
fn rt_os_wait_fd(s: u64, fd: u64, events: u64, task: u64) -> u64 {
    epoll := raw_load(s + 40);
    if epoll == 0 {
        return 1;
    }
    ev := rt_alloc(16);
    raw_store(ev, events + 1073741824); // EPOLLONESHOT
    if raw_target() == 0 {
        raw_store(ev + 4, task);
    } else {
        raw_store(ev + 8, task);
    }
    mut r = rt_syscall4(233, epoll, 1, fd, ev);
    if r == wrapping_sub(0, 17) {
        r = rt_syscall4(233, epoll, 3, fd, ev);
    }
    rt_free(ev);
    if rt_error(r) {
        return 1;
    }
    return 0;
}
fn rt_os_wait_done(s: u64, fd: u64) -> u64 {
    rt_syscall4(233, raw_load(s + 40), 2, fd, 0);
    return 0;
}
// A relative timer over the reactor: one timerfd per sleep, registered like any other readiness
// source, with its descriptor remembered in the task's wait key so the caller can close it.
fn rt_os_timer(s: u64, task: u64, ms: u64) -> u64 {
    fd := rt_syscall(283, 1, 526336, 0);
    if rt_error(fd) {
        return 1;
    }
    spec := rt_alloc(32);
    raw_store(spec + 16, rt_div(ms, 1000));
    raw_store(spec + 24, (ms % 1000) * 1000000);
    if rt_error(rt_syscall4(286, fd, 0, spec, 0)) {
        rt_free(spec);
        rt_syscall(3, fd, 0, 0);
        return 1;
    }
    rt_free(spec);
    if rt_os_wait_fd(s, fd, 1, task) != 0 {
        rt_syscall(3, fd, 0, 0);
        return 1;
    }
    raw_store(task + 32, fd);
    return 0;
}
fn rt_os_timer_done(s: u64, task: u64) -> u64 {
    fd := raw_load(task + 32);
    if fd != 0 {
        rt_os_wait_done(s, fd);
        rt_syscall(3, fd, 0, 0);
        raw_store(task + 32, 0);
    }
    return 0;
}
// A completion for an offload thread's task: Linux has no completion port, so the task goes back on
// a deque directly.
fn rt_os_complete(task: u64) -> u64 {
    return rt_wake(task);
}

// ---- task stacks -------------------------------------------------------------------------------
// A task stack is a 1 MiB anonymous reservation whose lowest page is PROT_NONE. mmap is lazy, so the
// kernel commits pages on first touch and a task that only uses a few KiB costs a few pages, while
// the guard page turns an overflow into SIGSEGV (or SIGBUS) instead of a silent write into whatever
// mapping happens to sit below. Finished stacks go on the finishing worker's free list and are
// reused, so a spawn/wake storm does not pay an mmap and mprotect per task.
fn rt_os_stack_size() -> u64 {
    return 1048576;
}
fn rt_os_stack_reserve() -> u64 {
    size := rt_os_stack_size();
    stack := raw_map(size);
    if rt_error(stack) {
        rt_abort();
    }
    // The range is reserved PROT_NONE, then only the usable part is made writable: the low page
    // stays PROT_NONE as the guard, and the kernel commits the writable pages on first touch (no
    // page of a task stack is backed until the task uses it).
    if rt_error(rt_syscall(10, stack, size, 0)) {
        rt_abort();
    }
    if rt_error(rt_syscall(10, stack + 4096, size - 4096, 3)) {
        rt_abort();
    }
    return stack;
}
// The free-list link lives in the top word of the stack, never in the guard page.
fn rt_os_stack_take() -> u64 {
    w := rt_worker_self();
    if w != 0 {
        head := raw_load(w + 56);
        if head != 0 {
            raw_store(w + 56, raw_load(head + rt_os_stack_size() - 8));
            raw_store(w + 64, raw_load(w + 64) - 1);
            return head;
        }
    }
    return rt_os_stack_reserve();
}
fn rt_os_stack_give(stack: u64) -> u64 {
    w := rt_worker_self();
    if (w != 0) && (raw_load(w + 64) < 32) {
        raw_store(stack + rt_os_stack_size() - 8, raw_load(w + 56));
        raw_store(w + 56, stack);
        raw_store(w + 64, raw_load(w + 64) + 1);
        return 0;
    }
    if rt_error(rt_syscall(11, stack, rt_os_stack_size(), 0)) {
        rt_abort();
    }
    return 0;
}
// True when the fault address lies in the guard page at the low end of the task that is running on
// this thread. Anything else is the program's own fault and keeps the default action.
fn rt_os_stack_guard_hit(addr: u64) -> u64 {
    tp := raw_tp_get();
    if tp == 0 {
        return 0;
    }
    t := raw_load(tp + 16);
    if t == 0 {
        return 0;
    }
    base := raw_load(t + 8);
    size := raw_load(t + 16);
    if size <= 4096 {
        return 0;
    }
    return (base <= addr) && (addr < base + 4096);
}
// Runs on the alternate stack: the faulting stack has no room for a frame. si_addr is the fourth
// member of the Linux siginfo_t union (offset 16 on every ELF target).
//
// Two stacks can run out and they are recognised differently. A task's stack is the runtime's own,
// so its lowest page is PROT_NONE and the fault address lands inside it (rt_os_stack_guard_hit).
// The main thread's stack is the kernel's - there is no page the runtime can make PROT_NONE there -
// so the fault is recognised by its distance from the interrupted stack pointer instead
// (rt_os_main_stack_hit), and only on a thread that is not running a task: a task's overflow is the
// guard page's job, and a second opinion by distance would only add a way to be wrong.
//
// Anything else is a fault of the program's own. The default disposition is put back and the
// handler returns, so the faulting instruction runs again and the process dies of the signal
// exactly as it does with no handler installed.
fn rt_os_stack_handler(sig: u64, info: u64, ctx: u64) -> u64 {
    mut addr = 0;
    if info != 0 {
        addr = raw_load(info + 16);
    }
    if rt_os_stack_guard_hit(addr) != 0 {
        rt_stack_overflow();
    }
    if (sig == 11) & (ctx != 0) & (rt_current() == 0) {
        if rt_os_main_stack_hit(addr, rt_os_ctx_sp(ctx)) != 0 {
            rt_stack_overflow_at(rt_stack_site_for_pc(rt_os_ctx_pc(ctx)));
        }
    }
    words := rt_state_stack_guard();
    rt_syscall4(13, sig, words + 80, 0, 8);
    return 0;
}
// How far from the interrupted stack pointer a fault address may be and still be this stack running
// out. 64 KiB, because a window has to hold a frame: the ordinary push faults a few bytes below sp,
// and a function whose frame is larger than a page first touches the address it just reserved. A
// frame that skips further than this still dies silently of its SIGSEGV, which is what it did
// before this handler existed - the window is a diagnostic's, not a promise about what a stack can
// hold, and it changes how much stack a program gets by nothing.
fn rt_os_stack_fault_window() -> u64 {
    return 65536;
}
// Is this fault the main thread's stack running out? The stack grows down, so the fault sits below
// the interrupted stack pointer; a frame taken off sp puts its first touch at or a little above sp,
// so one page upwards is admitted as well. An address anywhere else is the program's own pointer
// and keeps the default action.
fn rt_os_main_stack_hit(addr: u64, sp: u64) -> u64 {
    window := rt_os_stack_fault_window();
    if sp <= window {
        return 0;
    }
    return (sp - window <= addr) && (addr < sp + 4096);
}
// The interrupted stack pointer and instruction pointer, out of the ucontext_t the kernel passes as
// the handler's third argument, in the ucontext_t's own layout per target:
//
//   x86-64   uc_mcontext at 40:   gregs[15] RSP at 160, gregs[16] RIP at 168
//   aarch64  uc_mcontext at 176:  sp at 432, pc at 440   (asm-generic ucontext: the sigmask comes
//                                                        before the mcontext, which is 16-aligned)
//   riscv64  uc_mcontext at 176:  pc at 176, sp at 192   (user_regs_struct begins pc, ra, sp)
//
// The numbers are offsetof() against each target's own headers, not a guess:
//
//   struct ucontext uc; unsigned long v[] = {offsetof(ucontext_t, uc_mcontext.gregs[REG_RSP]), ...};
//
// compiled by aarch64-linux-gnu-gcc and riscv64-linux-gnu-gcc and read back with readelf -x .data
// gives 432/440 and 192/176, and x86-64's 160/168 is the pair the sampling profiler already reads
// RIP from (rt_prof_handler). A target that is not one of these three is answered with 0, and the
// caller then reports nothing rather than reading a field that may not be the stack pointer.
fn rt_os_ctx_sp(ctx: u64) -> u64 {
    t := raw_target();
    if t == 1 {
        return raw_load(ctx + 432);
    }
    if t == 2 {
        return raw_load(ctx + 192);
    }
    return raw_load(ctx + 160);
}
fn rt_os_ctx_pc(ctx: u64) -> u64 {
    t := raw_target();
    if t == 1 {
        return raw_load(ctx + 440);
    }
    if t == 2 {
        return raw_load(ctx + 176);
    }
    return raw_load(ctx + 168);
}
// SA_ONSTACK | SA_SIGINFO, plus SA_RESTORER on x86-64, which requires the restorer trampoline.
fn rt_os_stack_signal_flags() -> u64 {
    mut flags = 134217732;
    if raw_target() == 0 {
        flags = 201326596;
    }
    return flags;
}
fn rt_os_stack_guard_signal(sig: u64, words: u64) -> u64 {
    sa := words + 48;
    raw_store(sa, rt_os_stack_handler);
    raw_store(sa + 8, rt_os_stack_signal_flags());
    raw_store(sa + 16, raw_load(words));
    raw_store(sa + 24, 0);
    return rt_syscall4(13, sig, sa, 0, 8);
}
// This thread's alternate stack: Linux sigaltstack, {sp, flags, size} at `record`.
fn rt_os_sigaltstack(record: u64, sp: u64, size: u64) -> u64 {
    raw_store(record, sp);
    raw_store(record + 8, 0);
    raw_store(record + 16, size);
    return rt_syscall4(131, record, 0, 0, 0);
}
// The once-per-process half of installing, shared by every thread that installs: the restorer the
// kernel returns through, and the zeroed SIG_DFL action the handler swaps in for a fault that is
// not a stack overflow. Guarded by the install word, so the first thread builds it and the rest
// wait for it rather than racing to map it twice.
fn rt_os_stack_guard_prepare() -> u64 {
    words := rt_state_stack_guard();
    if raw_atomic_load(words + 8) != 2 {
        if raw_atomic_cas(words + 8, 0, 1) == 0 {
            // The restorer the kernel returns through: movl $__NR_rt_sigreturn,%eax; syscall; ud2.
            code := raw_map(4096);
            if rt_error(code) == 0 {
                raw_store(code, 1082287778126892984);
                raw_putbyte(code + 8, 11);
                if rt_error(rt_syscall4(10, code, 4096, 5, 0)) == 0 {
                    raw_store(words, code);
                }
            }
            mut i = 0;
            while i < 4 {
                raw_store(words + 80 + i * 8, 0);
                i += 1;
            }
            raw_atomic_store_release(words + 8, 2);
        } else {
            while raw_atomic_load(words + 8) != 2 {
                rt_syscall(24, 0, 0, 0);
            }
        }
    }
    return 0;
}
fn rt_os_stack_guard_install() -> u64 {
    words := rt_state_stack_guard();
    rt_os_stack_guard_prepare();
    w := rt_worker_self();
    if w != 0 {
        mut base = raw_load(w + 88);
        if base == 0 {
            base = raw_map(65536);
            if rt_error(base) == 0 {
                raw_store(w + 88, base);
            } else {
                return 0;
            }
        }
        rt_os_sigaltstack(w + 96, base, 65536);
        rt_os_stack_guard_signal(11, words);
        rt_os_stack_guard_signal(7, words);
    }
    return 0;
}
// The main thread installs the same handler at startup, because a program that never spawns a task
// never reaches rt_os_sched_prepare: with no handler at all, a main-stack overflow dies of SIGSEGV
// with empty stderr (docs/design/main-stack-overflow.md).
//
// The main thread has no worker block, so its alternate stack's base gets a process-state word of
// its own, and the sigaltstack record that describes it sits in the bottom 64 bytes of that same
// mapping: the handler's frames grow down from its top, 64 KiB above the record, so the two cannot
// meet. Only SIGSEGV is installed here - SIGBUS is the task guard's business (a worker installs
// both), and a main-stack overflow is a SIGSEGV on every target this covers.
fn rt_os_stack_guard_install_main() -> u64 {
    words := rt_state_stack_guard();
    rt_os_stack_guard_prepare();
    word := rt_state_stack_alt_main();
    mut base = raw_load(word);
    if base == 0 {
        base = raw_map(65536);
        if rt_error(base) != 0 {
            return 0;
        }
        raw_store(word, base);
    }
    rt_os_sigaltstack(base, base + 64, 65536 - 64);
    return rt_os_stack_guard_signal(11, words);
}
// A task's initial switch frame is what the target's switch saves, and the address it resumes into
// is rt_green_main.
fn rt_os_ctx_new(t: u64) -> u64 {
    size := rt_os_stack_size();
    stack := rt_os_stack_take();
    raw_store(t + 8, stack);
    raw_store(t + 16, size);
    // x86-64 8 words (resume first); AArch64 22 words (resume first); RISC-V 26 words (resume
    // last).
    target := raw_target();
    mut words = 8;
    mut slot = 0;
    if target == 1 {
        words = 22;
    }
    if target == 2 {
        words = 26;
        slot = 25;
    }
    frame := stack + size - words * 8;
    raw_store(frame + slot * 8, rt_green_main);
    raw_store(t, frame);
    return frame;
}
fn rt_os_ctx_enter(t: u64) -> u64 {
    w := raw_tp_get();
    raw_switch(w + 8, raw_load(t));
    return 0;
}
fn rt_os_ctx_leave(t: u64) -> u64 {
    w := raw_tp_get();
    raw_switch(t, raw_load(w + 8));
    return 0;
}
fn rt_os_ctx_release(t: u64) -> u64 {
    return rt_os_stack_give(raw_load(t + 8));
}

// ---- file metadata, rename, and a spawn that redirects stdio -----------------------------------
// The three operations the standard library's `fs` and `process` modules need beyond open/read/
// write. They live here because each one names a syscall and a structure layout; the portable half
// is in runtime.grl.

// The file's type, from the permission-and-type word of `stat`.
fn rt_stat_kind(mode: u64) -> u64 {
    t := mode & 61440;
    if t == 32768 {
        return 1; // S_IFREG
    }
    if t == 16384 {
        return 2; // S_IFDIR
    }
    if t == 40960 {
        return 3; // S_IFLNK
    }
    return 0; // fifo, socket, device, or nothing these callers distinguish
}

// newfstatat(2) on `path` (a NUL-terminated string): the link itself when `follow` is 0, what it
// names otherwise. `fields` receives eleven numbers - kind, size, mode, mtime seconds and
// nanoseconds, atime seconds and nanoseconds, uid, gid, inode, device - and the result is 0 or a
// positive errno. The x86-64 and generic `struct stat` layouts differ, so the offsets are next to
// the syscall that fills them.
fn rt_stat(path: u64, follow: u64, fields: u64) -> u64 {
    buf := rt_alloc(160);
    mut flags = 256; // AT_SYMLINK_NOFOLLOW
    if follow != 0 {
        flags = 0;
    }
    r := rt_syscall4(262, wrapping_sub(0, 100), path, buf, flags);
    if rt_error(r) {
        rt_free(buf);
        return wrapping_sub(0, r);
    }
    rt_push(fields, 0); // the errno slot: this call succeeded
    mut word = 0;
    mut mode = 0;
    mut uid = 0;
    mut gid = 0;
    if raw_target() == 0 {
        word = raw_load(buf + 24);
        mode = word & 65535;
        uid = rt_div(word, 4294967296);
        gid = raw_load(buf + 32) & 4294967295;
    } else {
        word = raw_load(buf + 16);
        mode = word & 65535;
        uid = raw_load(buf + 24) & 4294967295;
        gid = rt_div(raw_load(buf + 24), 4294967296);
    }
    rt_push(fields, rt_stat_kind(mode));
    rt_push(fields, raw_load(buf + 48));
    rt_push(fields, mode);
    rt_push(fields, raw_load(buf + 88));
    rt_push(fields, raw_load(buf + 96));
    rt_push(fields, raw_load(buf + 72));
    rt_push(fields, raw_load(buf + 80));
    rt_push(fields, uid);
    rt_push(fields, gid);
    rt_push(fields, raw_load(buf + 8));
    rt_push(fields, raw_load(buf));
    rt_free(buf);
    return 0;
}

// renameat(2) with both paths in the working directory. A file the destination names is replaced
// atomically; a non-empty directory is refused by the kernel. 0 or a positive errno.
fn rt_rename(from: u64, to: u64) -> u64 {
    r := rt_syscall4(264, wrapping_sub(0, 100), from, wrapping_sub(0, 100), to);
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
}

// symlinkat(2): `target` is the text the link holds. 0 or a positive errno.
fn rt_symlink(target: u64, link: u64) -> u64 {
    r := rt_syscall4(266, target, wrapping_sub(0, 100), link, 0);
    if rt_error(r) {
        return wrapping_sub(0, r);
    }
    return 0;
}

// Waits for the child `pid` and reaps it. The answer is the status word wait4(2) reports - the exit
// code in bits 8.., or the signal number when one ended the child - or a wrapped negative errno.
fn rt_wait_pid(pid: u64) -> u64 {
    status := rt_alloc(8);
    mut waited = 0;
    while 1 {
        waited = rt_syscall(61, pid, status, 0);
        if waited != wrapping_sub(0, 4) {
            break; // not EINTR
        }
    }
    if rt_error(waited) {
        rt_free(status);
        return waited;
    }
    word := raw_load(status);
    rt_free(status);
    return word;
}

// Runs `argv` once per candidate in `paths`, with the child's stdout connected to `out_fd` and its
// stderr to `err_fd` (1 and 2 leave that one inherited), and returns the child's id without waiting.
// The descriptors stay the caller's: a capture closes its own copies of the write ends after this
// returns, which is what lets the reading side see end-of-file.
//
// As in rt_spawn_wait, everything the child needs is built by the caller: after the fork it only
// rearranges descriptors and executes, so it takes no runtime lock and allocates nothing.
fn rt_spawn_redirect(paths: u64, argv: u64, envp: u64, out_fd: u64, err_fd: u64) -> u64 {
    mut environment = envp;
    if environment == 0 {
        environment = raw_load(raw_state() + 16);
    }
    child := rt_syscall(57, 0, 0, 0);
    if child == 0 {
        if out_fd != 1 {
            rt_syscall(292, out_fd, 1, 0); // dup3(out_fd, 1, 0)
        }
        if err_fd != 2 {
            rt_syscall(292, err_fd, 2, 0);
        }
        n := rt_len(paths);
        mut i = 0;
        while i < n {
            rt_syscall(59, rt_at(paths, i), argv, environment);
            i += 1;
        }
        rt_syscall(60, 127, 0, 0);
    }
    return child;
}

// The working directory, length without its terminator, or a wrapped negative errno. Linux keeps it
// reachable as the /proc/self/cwd link, which needs no buffer-size guessing.
fn rt_cwd(buf: u64, size: u64) -> u64 {
    link := rt_alloc(16);
    raw_putbyte(link, 47); // '/'
    raw_putbyte(link + 1, 112); // 'p'
    raw_putbyte(link + 2, 114); // 'r'
    raw_putbyte(link + 3, 111); // 'o'
    raw_putbyte(link + 4, 99); // 'c'
    raw_putbyte(link + 5, 47); // '/'
    raw_putbyte(link + 6, 115); // 's'
    raw_putbyte(link + 7, 101); // 'e'
    raw_putbyte(link + 8, 108); // 'l'
    raw_putbyte(link + 9, 102); // 'f'
    raw_putbyte(link + 10, 47); // '/'
    raw_putbyte(link + 11, 99); // 'c'
    raw_putbyte(link + 12, 119); // 'w'
    raw_putbyte(link + 13, 100); // 'd'
    n := rt_readlinkat(link, buf, size - 1);
    rt_free(link);
    if rt_error(n) {
        return n;
    }
    raw_putbyte(buf + n, 0);
    return n;
}

// Whether `fd` has data (or has reached its end) within `timeout_ms` milliseconds: 1 when it does,
// 0 when the time passed first, or a wrapped negative errno. ppoll with one pollfd and a timespec,
// on both ABIs: the generic table has no poll(2).
fn rt_ready(fd: u64, timeout_ms: u64) -> u64 {
    fds := rt_alloc(8);
    raw_store(fds, fd | 4294967296); // POLLIN in the low half of the events field
    spec := rt_alloc(16);
    raw_store(spec, rt_div(timeout_ms, 1000));
    raw_store(spec + 8, (timeout_ms % 1000) * 1000000);
    // sigmask is 0, which is what makes the fifth argument - one raw_syscall4 does not carry - the
    // only one the kernel may ignore.
    r := rt_syscall4(271, fds, 1, spec, 0);
    rt_free(fds);
    rt_free(spec);
    if rt_error(r) {
        return r;
    }
    return r;
}
// The two descriptors pipe2(2) wrote into `buf`, as the numbers a `host::pipe()` vector holds. The
// generic ABI writes them the same way, so only the Windows module overrides this.
fn rt_pipe_push(buf: u64, out: u64) -> u64 {
    word := raw_load(buf);
    rt_push(out, word & 4294967295);
    rt_push(out, rt_div(word, 4294967296));
    return 0;
}
