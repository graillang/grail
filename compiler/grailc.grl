module grailc;
use lexer;
use host;

// Grail bootstrap compiler: translates the source subset it is written in to C.
// Usage: grailc OUT.c ENTRY.grl [MODULE.grl...]. The first public function of the
// first file is the entry; like the seed shim it takes nothing or argv[1] as a byte view. Ownership is NOT checked here: the seed
// checks this compiler's own source. Output includes compiler/grail_rt.c (-I compiler).
// Type ids: 0 num, 1 unit, 2 bytes, 3 string, 4 view; others are interned below.
// Type kinds: 1 num, 2 unit, 3 bytes, 4 string, 5 view, 6 vec(arg), 7 ref(arg), 8 named(decl).

struct Tok { kind:num, start:num, end:num }
struct Ty { kind:num, arg:num }
struct Decl { module:bytes, name:bytes, is_enum:num, first:num, count:num }
struct Field { name:bytes, ty:num }
struct Func { module:bytes, name:bytes, first:num, count:num, ret:num }
struct Local { name:bytes, ty:num, id:num }
struct Val { t:num, ty:num }
struct C {
    src:bytes, toks:vec<Tok>, pos:num, out:vec<num>, module:bytes,
    types:vec<Ty>, decls:vec<Decl>, fields:vec<Field>, funcs:vec<Func>, params:vec<num>,
    locals:vec<Local>, next:num, entry:num, file:num
}

fn same<a,b>(x:read<a>,y:read<b>)->num {
    if len(x)!=len(y) { return 0; }
    for i in len(x) { if at(x,i)!=at(y,i) { return 0; } }
    return 1;
}
fn div(n:num,d:num)->num {
    var q=0;
    var r=n;
    while (r<d)==0 {
        var m=d;
        var k=1;
        while ((r<m+m)==0)&((m+m<m)==0) { m=m+m; k=k+k; }
        r=r-m;
        q=q+k;
    }
    return q;
}

// ---- output ----
fn o<a,b>(c:ref_mut<a,C>,s:read<b>)->unit {
    for i in len(s) { vec_push(c.out,at(s,i)); }
    return ();
}
fn on<a>(c:ref_mut<a,C>,n:num)->unit {
    if 9<n { on(borrow_mut(c),div(n,10)); }
    vec_push(c.out,48+n%10);
    return ();
}
fn ov<a>(c:ref_mut<a,C>,id:num)->unit {
    vec_push(c.out,118);
    on(borrow_mut(c),id);
    return ();
}
fn fresh<a>(c:ref_mut<a,C>)->num {
    let id=c.next;
    exchange(borrow_mut(c.next),id+1);
    return id;
}
// Emits "G vN=" and returns N.
fn def<a>(c:ref_mut<a,C>)->num {
    let id=fresh(borrow_mut(c));
    o(borrow_mut(c),read("G "));
    ov(borrow_mut(c),id);
    vec_push(c.out,61);
    return id;
}
fn val(t:num,ty:num)->Val { return Val{t:t,ty:ty}; }

// ---- tokens ----
fn kind<a>(c:ref_mut<a,C>)->num {
    let p=c.pos;
    let t=vec_get(c.toks,p);
    return t.kind;
}
fn kind_at<a>(c:ref_mut<a,C>,i:num)->num {
    let t=vec_get(c.toks,i);
    return t.kind;
}
fn advance<a>(c:ref_mut<a,C>)->unit {
    let p=c.pos+1;
    exchange(borrow_mut(c.pos),p);
    return ();
}
fn tok_text<a>(c:ref_mut<a,C>,i:num)->bytes {
    let t=vec_get(c.toks,i);
    let st=t.start;
    let en=t.end;
    return copy_bytes(slice(read(c.src),st,en));
}
fn is<a,b>(c:ref_mut<a,C>,s:read<b>)->num {
    let p=c.pos;
    let t=tok_text(borrow_mut(c),p);
    return same(read(t),s);
}
fn fail<a,b>(c:ref_mut<a,C>,msg:read<b>)->unit {
    let p=c.pos;
    let m=tok_text(borrow_mut(c),p);
    let t=vec_get(c.toks,p);
    let st=t.start;
    exchange(borrow_mut(c.out),vec<num>());
    o(borrow_mut(c),read("grailc: "));
    o(borrow_mut(c),msg);
    o(borrow_mut(c),read(" at byte "));
    on(borrow_mut(c),st);
    o(borrow_mut(c),read(" near '"));
    o(borrow_mut(c),read(m));
    o(borrow_mut(c),read("'\n"));
    let line=bytes();
    for i in len(c.out) { push(line,load(vec_get(c.out,i))); }
    host::print(read(line));
    assert(0);
    return ();
}
fn eat<a,b>(c:ref_mut<a,C>,s:read<b>)->num {
    if is(borrow_mut(c),s) { advance(borrow_mut(c)); return 1; }
    return 0;
}
fn expect<a,b>(c:ref_mut<a,C>,s:read<b>)->unit {
    let want=copy_bytes(read(s));
    if eat(borrow_mut(c),s)==0 {
        let msg="expected ";
        append_text(msg,read(want));
        fail(borrow_mut(c),read(msg));
    }
    return ();
}
fn ident<a>(c:ref_mut<a,C>)->bytes {
    if kind(borrow_mut(c))!=1 { fail(borrow_mut(c),read("expected identifier")); }
    let p=c.pos;
    let t=tok_text(borrow_mut(c),p);
    advance(borrow_mut(c));
    return t;
}
// Skips a balanced <...> group if present.
fn skip_angle<a>(c:ref_mut<a,C>)->unit {
    if kind(borrow_mut(c))!=60 { return (); }
    var depth=0;
    while 1 {
        let k=kind(borrow_mut(c));
        if k==60 { depth=depth+1; }
        if k==62 { depth=depth-1; }
        if k==0 { fail(borrow_mut(c),read("unclosed <")); }
        advance(borrow_mut(c));
        if depth==0 { return (); }
    }
    return ();
}
// Skips a balanced {...} group starting at the current '{'.
fn skip_braces<a>(c:ref_mut<a,C>)->unit {
    var depth=0;
    while 1 {
        let k=kind(borrow_mut(c));
        if k==123 { depth=depth+1; }
        if k==125 { depth=depth-1; }
        if k==0 { fail(borrow_mut(c),read("unclosed {")); }
        advance(borrow_mut(c));
        if depth==0 { return (); }
    }
    return ();
}
fn load_file<a>(c:ref_mut<a,C>,index:num)->unit {
    let path=host::arg(index);
    let src=host::read_file(read(path));
    let toks=vec<Tok>();
    let lexed=lexer::tokenize(read(src));
    for i in len(lexed) {
        let t=vec_get(lexed,i);
        vec_push(toks,Tok{kind:t.kind,start:t.start,end:t.end});
    }
    drop(lexed);
    exchange(borrow_mut(c.toks),toks);
    exchange(borrow_mut(c.src),src);
    exchange(borrow_mut(c.pos),0);
    return ();
}

// ---- types and declarations ----
fn intern<a>(c:ref_mut<a,C>,k:num,arg:num)->num {
    for i in len(c.types) {
        let t=vec_get(c.types,i);
        if (t.kind==k)&(t.arg==arg) { return i; }
    }
    vec_push(c.types,Ty{kind:k,arg:arg});
    return len(c.types)-1;
}
fn ty_kind<a>(c:ref_mut<a,C>,ty:num)->num {
    let t=vec_get(c.types,ty);
    return t.kind;
}
fn ty_arg<a>(c:ref_mut<a,C>,ty:num)->num {
    let t=vec_get(c.types,ty);
    return t.arg;
}
// Declaration index + 1, or 0.
fn find_decl<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->num {
    for i in len(c.decls) {
        let x=vec_get(c.decls,i);
        if same(read(x.module),read(m))&same(read(x.name),read(n)) { return i+1; }
    }
    return 0;
}
fn find_func<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->num {
    for i in len(c.funcs) {
        let x=vec_get(c.funcs,i);
        if same(read(x.module),read(m))&same(read(x.name),read(n)) { return i+1; }
    }
    return 0;
}
// Field index within decl, failing when absent.
fn find_field<a,b>(c:ref_mut<a,C>,decl:num,n:read<b>)->num {
    let d=vec_get(c.decls,decl);
    let first=d.first;
    let count=d.count;
    for i in count {
        let f=vec_get(c.fields,first+i);
        if same(read(f.name),read(n)) { return i; }
    }
    fail(borrow_mut(c),read("unknown field or variant"));
    return 0;
}
fn field_ty<a>(c:ref_mut<a,C>,decl:num,index:num)->num {
    let d=vec_get(c.decls,decl);
    let k=d.first+index;
    let f=vec_get(c.fields,k);
    return f.ty;
}
fn module_copy<a>(c:ref_mut<a,C>)->bytes { return copy_bytes(read(c.module)); }
fn parse_type<a>(c:ref_mut<a,C>)->num {
    let first=ident(borrow_mut(c));
    if eat(borrow_mut(c),read("::")) {
        let n=ident(borrow_mut(c));
        let d=find_decl(borrow_mut(c),read(first),read(n));
        if d==0 { fail(borrow_mut(c),read("unknown type")); }
        skip_angle(borrow_mut(c));
        return intern(borrow_mut(c),8,d-1);
    }
    if same(read(first),read("num")) { return 0; }
    if same(read(first),read("unit")) { return 1; }
    if same(read(first),read("bytes")) { return 2; }
    if same(read(first),read("string")) { return 3; }
    if same(read(first),read("read"))+same(read(first),read("mut")) {
        skip_angle(borrow_mut(c));
        return 4;
    }
    if same(read(first),read("vec")) {
        expect(borrow_mut(c),read("<"));
        let e=parse_type(borrow_mut(c));
        expect(borrow_mut(c),read(">"));
        return intern(borrow_mut(c),6,e);
    }
    if same(read(first),read("ref"))+same(read(first),read("ref_mut")) {
        expect(borrow_mut(c),read("<"));
        ident(borrow_mut(c));
        expect(borrow_mut(c),read(","));
        let e=parse_type(borrow_mut(c));
        expect(borrow_mut(c),read(">"));
        return intern(borrow_mut(c),7,e);
    }
    let m=module_copy(borrow_mut(c));
    let d=find_decl(borrow_mut(c),read(m),read(first));
    if d==0 { fail(borrow_mut(c),read("unknown type")); }
    skip_angle(borrow_mut(c));
    return intern(borrow_mut(c),8,d-1);
}

// ---- top level: pass 1 names, pass 2 fields/signatures/prototypes, pass 3 bodies ----
fn mangle<a,b,d>(c:ref_mut<a,C>,m:read<b>,n:read<d>)->unit {
    o(borrow_mut(c),read("f_"));
    o(borrow_mut(c),m);
    vec_push(c.out,95);
    o(borrow_mut(c),n);
    return ();
}
fn decl<a>(c:ref_mut<a,C>,pass:num)->unit {
    let is_enum=is(borrow_mut(c),read("enum"));
    advance(borrow_mut(c));
    let name=ident(borrow_mut(c));
    skip_angle(borrow_mut(c));
    if pass!=2 {
        if pass==1 {
            let m=module_copy(borrow_mut(c));
            vec_push(c.decls,Decl{module:m,name:name,is_enum:is_enum,first:0,count:0});
        }
        skip_braces(borrow_mut(c));
        eat(borrow_mut(c),read(";"));
        return ();
    }
    let m=module_copy(borrow_mut(c));
    let d=find_decl(borrow_mut(c),read(m),read(name));
    let first=len(c.fields);
    var count=0;
    expect(borrow_mut(c),read("{"));
    if eat(borrow_mut(c),read("}"))==0 {
        while 1 {
            let f=ident(borrow_mut(c));
            var ty=1;
            if is_enum {
                if eat(borrow_mut(c),read("(")) {
                    ty=parse_type(borrow_mut(c));
                    expect(borrow_mut(c),read(")"));
                }
            } else {
                expect(borrow_mut(c),read(":"));
                ty=parse_type(borrow_mut(c));
            }
            vec_push(c.fields,Field{name:f,ty:ty});
            count=count+1;
            if eat(borrow_mut(c),read("}")) { break; }
            expect(borrow_mut(c),read(","));
            if eat(borrow_mut(c),read("}")) { break; }
        }
    }
    eat(borrow_mut(c),read(";"));
    exchange(vec_get_mut(c.decls,d-1),Decl{module:m,name:name,is_enum:is_enum,first:first,count:count});
    return ();
}
fn bind<a>(c:ref_mut<a,C>,name:bytes,ty:num,id:num)->unit {
    vec_push(c.locals,Local{name:name,ty:ty,id:id});
    return ();
}
fn func<a>(c:ref_mut<a,C>,pass:num,public:num)->unit {
    expect(borrow_mut(c),read("fn"));
    let name=ident(borrow_mut(c));
    skip_angle(borrow_mut(c));
    if pass==1 {
        while kind(borrow_mut(c))!=123 { advance(borrow_mut(c)); }
        skip_braces(borrow_mut(c));
        return ();
    }
    let m=module_copy(borrow_mut(c));
    exchange(borrow_mut(c.locals),vec<Local>());
    exchange(borrow_mut(c.next),0);
    let first=len(c.params);
    var count=0;
    expect(borrow_mut(c),read("("));
    if eat(borrow_mut(c),read(")"))==0 {
        while 1 {
            let p=ident(borrow_mut(c));
            expect(borrow_mut(c),read(":"));
            let ty=parse_type(borrow_mut(c));
            if pass==2 { vec_push(c.params,ty); }
            let id=fresh(borrow_mut(c));
            bind(borrow_mut(c),p,ty,id);
            count=count+1;
            if eat(borrow_mut(c),read(")")) { break; }
            expect(borrow_mut(c),read(","));
        }
    }
    expect(borrow_mut(c),read("->"));
    let ret=parse_type(borrow_mut(c));
    o(borrow_mut(c),read("static G "));
    mangle(borrow_mut(c),read(m),read(name));
    vec_push(c.out,40);
    if count==0 { o(borrow_mut(c),read("void")); }
    for i in count {
        if i!=0 { vec_push(c.out,44); }
        o(borrow_mut(c),read("G "));
        ov(borrow_mut(c),i);
    }
    vec_push(c.out,41);
    if pass==2 {
        o(borrow_mut(c),read(";\n"));
        let entry=(c.entry==0)&(c.file==2)&public&(count<2);
        vec_push(c.funcs,Func{module:m,name:name,first:first,count:count,ret:ret});
        let index=len(c.funcs);
        if entry { exchange(borrow_mut(c.entry),index); }
        skip_braces(borrow_mut(c));
        return ();
    }
    vec_push(c.out,123);
    block(borrow_mut(c));
    o(borrow_mut(c),read("return 0;}\n"));
    return ();
}
fn toplevel<a>(c:ref_mut<a,C>,pass:num)->unit {
    expect(borrow_mut(c),read("module"));
    let m=ident(borrow_mut(c));
    exchange(borrow_mut(c.module),m);
    expect(borrow_mut(c),read(";"));
    while eat(borrow_mut(c),read("use")) {
        ident(borrow_mut(c));
        expect(borrow_mut(c),read(";"));
    }
    while kind(borrow_mut(c))!=0 {
        let public=eat(borrow_mut(c),read("pub"));
        if is(borrow_mut(c),read("struct"))+is(borrow_mut(c),read("enum")) {
            decl(borrow_mut(c),pass);
        } else {
            func(borrow_mut(c),pass,public);
        }
    }
    return ();
}

// ---- expressions: each value is a C local vN; operands are evaluated left to right ----
fn deref<a>(c:ref_mut<a,C>,v:Val)->Val {
    var t=v.t;
    var ty=v.ty;
    while ty_kind(borrow_mut(c),ty)==7 {
        let n=def(borrow_mut(c));
        o(borrow_mut(c),read("*(G*)"));
        ov(borrow_mut(c),t);
        o(borrow_mut(c),read(";\n"));
        t=n;
        ty=ty_arg(borrow_mut(c),ty);
    }
    return val(t,ty);
}
fn find_local<a,b>(c:ref_mut<a,C>,n:read<b>)->num {
    var i=len(c.locals);
    while 0<i {
        i=i-1;
        let l=vec_get(c.locals,i);
        if same(read(l.name),read(n)) { return i+1; }
    }
    return 0;
}
fn local_id<a>(c:ref_mut<a,C>,i:num)->num { let l=vec_get(c.locals,i); return l.id; }
fn local_ty<a>(c:ref_mut<a,C>,i:num)->num { let l=vec_get(c.locals,i); return l.ty; }
fn pop_locals<a>(c:ref_mut<a,C>,mark:num)->unit {
    while mark<len(c.locals) { vec_pop(c.locals); }
    return ();
}
// Emits "((G*)vB)[K]" for field K of the record value vB.
fn slot<a>(c:ref_mut<a,C>,base:num,k:num)->unit {
    o(borrow_mut(c),read("((G*)"));
    ov(borrow_mut(c),base);
    o(borrow_mut(c),read(")["));
    on(borrow_mut(c),k);
    vec_push(c.out,93);
    return ();
}
// Reads a field path after a local; the final field is loaded unless address is set.
fn field_path<a>(c:ref_mut<a,C>,id:num,lty:num,address:num)->Val {
    var t=id;
    var ty=lty;
    while eat(borrow_mut(c),read(".")) {
        let f=ident(borrow_mut(c));
        let base=deref(borrow_mut(c),val(t,ty));
        let b=base.t;
        let d=ty_arg(borrow_mut(c),base.ty);
        let k=find_field(borrow_mut(c),d,read(f));
        let fty=field_ty(borrow_mut(c),d,k);
        let n=def(borrow_mut(c));
        let last=(kind(borrow_mut(c))!=46)&address;
        if last { o(borrow_mut(c),read("(G)&")); }
        slot(borrow_mut(c),b,k);
        o(borrow_mut(c),read(";\n"));
        if last { return val(n,intern(borrow_mut(c),7,fty)); }
        t=n;
        ty=fty;
    }
    return val(t,ty);
}
fn place<a>(c:ref_mut<a,C>)->Val {
    let name=ident(borrow_mut(c));
    let l=find_local(borrow_mut(c),read(name));
    if l==0 { fail(borrow_mut(c),read("unknown borrowed place")); }
    let id=local_id(borrow_mut(c),l-1);
    let ty=local_ty(borrow_mut(c),l-1);
    if kind(borrow_mut(c))==46 { return field_path(borrow_mut(c),id,ty,1); }
    if ty_kind(borrow_mut(c),ty)==7 { return val(id,ty); }
    let n=def(borrow_mut(c));
    o(borrow_mut(c),read("(G)&"));
    ov(borrow_mut(c),id);
    o(borrow_mut(c),read(";\n"));
    return val(n,intern(borrow_mut(c),7,ty));
}
fn hex(b:num)->num {
    if b<58 { return b-48; }
    if b<71 { return b-55; }
    return b-87;
}
fn string_lit<a>(c:ref_mut<a,C>)->Val {
    let p=c.pos;
    let t=vec_get(c.toks,p);
    let st=t.start;
    let en=t.end;
    advance(borrow_mut(c));
    let n=def(borrow_mut(c));
    o(borrow_mut(c),read("rt_lit(\""));
    var i=st+1;
    var count=0;
    while i<en-1 {
        var b=at(read(c.src),i);
        if b==92 {
            i=i+1;
            let e=at(read(c.src),i);
            b=e;
            if e==110 { b=10; }
            if e==114 { b=13; }
            if e==116 { b=9; }
            if e==48 { b=0; }
            if e==120 {
                let h=hex(at(read(c.src),i+1));
                let l=hex(at(read(c.src),i+2));
                b=h*16+l;
                i=i+2;
            }
        }
        vec_push(c.out,92);
        vec_push(c.out,48+div(b,64));
        vec_push(c.out,48+div(b,8)%8);
        vec_push(c.out,48+b%8);
        count=count+1;
        i=i+1;
    }
    o(borrow_mut(c),read("\","));
    on(borrow_mut(c),count);
    o(borrow_mut(c),read(");\n"));
    return val(n,3);
}
fn record<a>(c:ref_mut<a,C>,d:num)->Val {
    expect(borrow_mut(c),read("{"));
    let x=vec_get(c.decls,d);
    let count=x.count;
    let n=def(borrow_mut(c));
    o(borrow_mut(c),read("rt_rec("));
    on(borrow_mut(c),count);
    o(borrow_mut(c),read(");\n"));
    if eat(borrow_mut(c),read("}"))==0 {
        while 1 {
            let f=ident(borrow_mut(c));
            expect(borrow_mut(c),read(":"));
            let v=expr(borrow_mut(c),0);
            let k=find_field(borrow_mut(c),d,read(f));
            slot(borrow_mut(c),n,k);
            vec_push(c.out,61);
            ov(borrow_mut(c),v.t);
            o(borrow_mut(c),read(";\n"));
            if eat(borrow_mut(c),read("}")) { break; }
            expect(borrow_mut(c),read(","));
            if eat(borrow_mut(c),read("}")) { break; }
        }
    }
    return val(n,intern(borrow_mut(c),8,d));
}
fn variant<a,b>(c:ref_mut<a,C>,d:num,name:read<b>)->Val {
    let k=find_field(borrow_mut(c),d,name);
    var payload=0;
    var has=0;
    if eat(borrow_mut(c),read("(")) {
        let v=expr(borrow_mut(c),0);
        payload=v.t;
        has=1;
        expect(borrow_mut(c),read(")"));
    }
    let n=def(borrow_mut(c));
    o(borrow_mut(c),read("rt_enum("));
    on(borrow_mut(c),k);
    vec_push(c.out,44);
    if has { ov(borrow_mut(c),payload); } else { vec_push(c.out,48); }
    o(borrow_mut(c),read(");\n"));
    return val(n,intern(borrow_mut(c),8,d));
}
fn call<a,b,d>(c:ref_mut<a,C>,m:read<b>,name:read<d>)->Val {
    let f=find_func(borrow_mut(c),read(m),read(name));
    if f==0 { fail(borrow_mut(c),read("unknown function")); }
    expect(borrow_mut(c),read("("));
    let args=vec<num>();
    if eat(borrow_mut(c),read(")"))==0 {
        while 1 {
            let v=expr(borrow_mut(c),0);
            vec_push(args,v.t);
            if eat(borrow_mut(c),read(")")) { break; }
            expect(borrow_mut(c),read(","));
        }
    }
    let x=vec_get(c.funcs,f-1);
    let ret=x.ret;
    let n=def(borrow_mut(c));
    mangle(borrow_mut(c),m,name);
    vec_push(c.out,40);
    for i in len(args) {
        if i!=0 { vec_push(c.out,44); }
        ov(borrow_mut(c),load(vec_get(args,i)));
    }
    o(borrow_mut(c),read(");\n"));
    return val(n,ret);
}
fn builtin_id<a>(n:read<a>)->num {
    if same(read(n),read("bytes")) { return 1; }
    if same(read(n),read("read")) { return 2; }
    if same(read(n),read("mut")) { return 3; }
    if same(read(n),read("len")) { return 4; }
    if same(read(n),read("copy_bytes")) { return 5; }
    if same(read(n),read("text")) { return 6; }
    if same(read(n),read("at")) { return 7; }
    if same(read(n),read("slice")) { return 8; }
    if same(read(n),read("vec_push")) { return 9; }
    if same(read(n),read("vec_pop")) { return 10; }
    if same(read(n),read("vec_get")) { return 11; }
    if same(read(n),read("vec_get_mut")) { return 12; }
    if same(read(n),read("borrow")) { return 13; }
    if same(read(n),read("borrow_mut")) { return 14; }
    if same(read(n),read("load")) { return 15; }
    if same(read(n),read("exchange")) { return 16; }
    return 0;
}
// Emits "G vN=F(vA[,vB[,vE]]);" and returns N.
fn apply<a,b>(c:ref_mut<a,C>,f:read<b>,args:vec<num>)->num {
    let n=def(borrow_mut(c));
    o(borrow_mut(c),f);
    vec_push(c.out,40);
    for i in len(args) {
        if i!=0 { vec_push(c.out,44); }
        ov(borrow_mut(c),load(vec_get(args,i)));
    }
    o(borrow_mut(c),read(");\n"));
    return n;
}
fn one(a:num)->vec<num> { let v=vec<num>(); vec_push(v,a); return v; }
fn two(a:num,b:num)->vec<num> { let v=vec<num>(); vec_push(v,a); vec_push(v,b); return v; }
fn builtin<a>(c:ref_mut<a,C>,id:num)->Val {
    expect(borrow_mut(c),read("("));
    if id==1 {
        expect(borrow_mut(c),read(")"));
        return val(apply(borrow_mut(c),read("rt_new"),vec<num>()),2);
    }
    if (id==13)+(id==14) {
        let v=place(borrow_mut(c));
        expect(borrow_mut(c),read(")"));
        return v;
    }
    let a=expr(borrow_mut(c),0);
    if id==16 {
        expect(borrow_mut(c),read(","));
        let b=expr(borrow_mut(c),0);
        expect(borrow_mut(c),read(")"));
        let ty=ty_arg(borrow_mut(c),a.ty);
        return val(apply(borrow_mut(c),read("rt_xchg"),two(a.t,b.t)),ty);
    }
    if id==15 {
        expect(borrow_mut(c),read(")"));
        let ty=ty_arg(borrow_mut(c),a.ty);
        let n=def(borrow_mut(c));
        o(borrow_mut(c),read("*(G*)"));
        ov(borrow_mut(c),a.t);
        o(borrow_mut(c),read(";\n"));
        return val(n,ty);
    }
    let x=deref(borrow_mut(c),a);
    let xt=x.t;
    let xty=x.ty;
    if id<7 {
        expect(borrow_mut(c),read(")"));
        if id<4 {
            if ty_kind(borrow_mut(c),xty)==5 { return val(xt,4); }
            return val(apply(borrow_mut(c),read("rt_view"),one(xt)),4);
        }
        if id==4 { return val(apply(borrow_mut(c),read("rt_len"),one(xt)),0); }
        return val(apply(borrow_mut(c),read("rt_copy"),one(xt)),id-3);
    }
    if id==10 {
        expect(borrow_mut(c),read(")"));
        let ty=ty_arg(borrow_mut(c),xty);
        return val(apply(borrow_mut(c),read("rt_pop"),one(xt)),ty);
    }
    expect(borrow_mut(c),read(","));
    let b=expr(borrow_mut(c),0);
    let bt=b.t;
    if id==7 {
        expect(borrow_mut(c),read(")"));
        return val(apply(borrow_mut(c),read("rt_at"),two(xt,bt)),0);
    }
    if id==9 {
        expect(borrow_mut(c),read(")"));
        o(borrow_mut(c),read("rt_push("));
        ov(borrow_mut(c),xt);
        vec_push(c.out,44);
        ov(borrow_mut(c),bt);
        o(borrow_mut(c),read(");\n"));
        let n=def(borrow_mut(c));
        o(borrow_mut(c),read("0;\n"));
        return val(n,1);
    }
    if id!=8 {
        expect(borrow_mut(c),read(")"));
        let elem=ty_arg(borrow_mut(c),xty);
        let ty=intern(borrow_mut(c),7,elem);
        return val(apply(borrow_mut(c),read("rt_slot"),two(xt,bt)),ty);
    }
    expect(borrow_mut(c),read(","));
    let e=expr(borrow_mut(c),0);
    expect(borrow_mut(c),read(")"));
    let args=two(xt,bt);
    vec_push(args,e.t);
    return val(apply(borrow_mut(c),read("rt_slice"),args),4);
}
fn primary<a>(c:ref_mut<a,C>)->Val {
    let k=kind(borrow_mut(c));
    if k==40 {
        advance(borrow_mut(c));
        if eat(borrow_mut(c),read(")")) {
            let n=def(borrow_mut(c));
            o(borrow_mut(c),read("0;\n"));
            return val(n,1);
        }
        let v=expr(borrow_mut(c),0);
        expect(borrow_mut(c),read(")"));
        return v;
    }
    if k==3 { return string_lit(borrow_mut(c)); }
    if k==2 {
        let p=c.pos;
        let t=tok_text(borrow_mut(c),p);
        advance(borrow_mut(c));
        let n=def(borrow_mut(c));
        o(borrow_mut(c),read(t));
        o(borrow_mut(c),read("ull;\n"));
        return val(n,0);
    }
    let first=ident(borrow_mut(c));
    if same(read(first),read("vec"))&is(borrow_mut(c),read("<")) {
        advance(borrow_mut(c));
        let e=parse_type(borrow_mut(c));
        expect(borrow_mut(c),read(">"));
        expect(borrow_mut(c),read("("));
        expect(borrow_mut(c),read(")"));
        let ty=intern(borrow_mut(c),6,e);
        return val(apply(borrow_mut(c),read("rt_new"),vec<num>()),ty);
    }
    let m=module_copy(borrow_mut(c));
    if eat(borrow_mut(c),read("::")) {
        let second=ident(borrow_mut(c));
        if eat(borrow_mut(c),read("::")) {
            let third=ident(borrow_mut(c));
            let d=find_decl(borrow_mut(c),read(first),read(second));
            if d==0 { fail(borrow_mut(c),read("unknown enum")); }
            return variant(borrow_mut(c),d-1,read(third));
        }
        let d=find_decl(borrow_mut(c),read(m),read(first));
        if d!=0 { return variant(borrow_mut(c),d-1,read(second)); }
        let r=find_decl(borrow_mut(c),read(first),read(second));
        if (r!=0)&is(borrow_mut(c),read("{")) { return record(borrow_mut(c),r-1); }
        return call(borrow_mut(c),read(first),read(second));
    }
    if is(borrow_mut(c),read("(")) {
        let b=builtin_id(read(first));
        if b!=0 { return builtin(borrow_mut(c),b); }
        return call(borrow_mut(c),read(m),read(first));
    }
    let l=find_local(borrow_mut(c),read(first));
    if l!=0 {
        let id=local_id(borrow_mut(c),l-1);
        let ty=local_ty(borrow_mut(c),l-1);
        return field_path(borrow_mut(c),id,ty,0);
    }
    let r=find_decl(borrow_mut(c),read(m),read(first));
    if r!=0 { return record(borrow_mut(c),r-1); }
    fail(borrow_mut(c),read("undefined name"));
    return val(0,0);
}
fn prec(k:num)->num {
    if k==38 { return 1; }
    if k==94 { return 2; }
    if (k==258)+(k==259)+(k==60) { return 3; }
    if (k==43)+(k==45) { return 4; }
    if (k==42)+(k==37) { return 5; }
    return 0;
}
// `?` returns a failure unchanged (payload layout is shared); `!` aborts on it.
fn propagate<a>(c:ref_mut<a,C>,v:Val,unwrap:num)->Val {
    let x=deref(borrow_mut(c),v);
    let xt=x.t;
    let d=ty_arg(borrow_mut(c),x.ty);
    var k=0;
    let dd=vec_get(c.decls,d);
    let fi=dd.first;
    let f=vec_get(c.fields,fi);
    if same(read(f.name),read("Ok"))+same(read(f.name),read("Some"))==0 { k=1; }
    o(borrow_mut(c),read("if(((G*)"));
    ov(borrow_mut(c),xt);
    o(borrow_mut(c),read(")[0]!="));
    on(borrow_mut(c),k);
    o(borrow_mut(c),read(")"));
    if unwrap { o(borrow_mut(c),read("abort();\n")); } else {
        o(borrow_mut(c),read("return "));
        ov(borrow_mut(c),xt);
        o(borrow_mut(c),read(";\n"));
    }
    let n=def(borrow_mut(c));
    slot(borrow_mut(c),xt,1);
    o(borrow_mut(c),read(";\n"));
    return val(n,field_ty(borrow_mut(c),d,k));
}
fn binary<a>(c:ref_mut<a,C>,k:num,left:num,right:num)->num {
    let n=def(borrow_mut(c));
    if k==37 {
        o(borrow_mut(c),read("rt_rem("));
        ov(borrow_mut(c),left);
        vec_push(c.out,44);
    } else {
        vec_push(c.out,40);
        ov(borrow_mut(c),left);
        if k==258 { o(borrow_mut(c),read("==")); }
        if k==259 { o(borrow_mut(c),read("!=")); }
        if prec(k)!=3 { vec_push(c.out,k); }
        if k==60 { vec_push(c.out,60); }
    }
    ov(borrow_mut(c),right);
    o(borrow_mut(c),read(");\n"));
    return n;
}
fn expr<a>(c:ref_mut<a,C>,min:num)->Val {
    let first=primary(borrow_mut(c));
    var t=first.t;
    var ty=first.ty;
    while 1 {
        let k=kind(borrow_mut(c));
        let p=prec(k);
        if (k==63)+(k==33) {
            advance(borrow_mut(c));
            let r=propagate(borrow_mut(c),val(t,ty),k==33);
            t=r.t;
            ty=r.ty;
        } else {
            if p==0 { break; }
            if p<min { break; }
            advance(borrow_mut(c));
            let right=expr(borrow_mut(c),p+1);
            t=binary(borrow_mut(c),k,t,right.t);
            ty=0;
        }
    }
    return val(t,ty);
}

// ---- statements ----
fn block<a>(c:ref_mut<a,C>)->unit {
    expect(borrow_mut(c),read("{"));
    o(borrow_mut(c),read("{\n"));
    let mark=len(c.locals);
    while is(borrow_mut(c),read("}"))==0 { stmt(borrow_mut(c)); }
    advance(borrow_mut(c));
    o(borrow_mut(c),read("}\n"));
    pop_locals(borrow_mut(c),mark);
    return ();
}
fn assignment_ahead<a>(c:ref_mut<a,C>)->num {
    if kind(borrow_mut(c))!=1 { return 0; }
    var e=c.pos+1;
    while kind_at(borrow_mut(c),e)==46 { e=e+2; }
    return kind_at(borrow_mut(c),e)==61;
}
// Evaluates one argument to its dereferenced value.
fn operand<a>(c:ref_mut<a,C>)->num {
    let v=expr(borrow_mut(c),0);
    let x=deref(borrow_mut(c),v);
    return x.t;
}
fn statement_call<a,b>(c:ref_mut<a,C>,f:read<b>,count:num)->unit {
    expect(borrow_mut(c),read("("));
    let args=vec<num>();
    for i in count {
        if i!=0 { expect(borrow_mut(c),read(",")); }
        vec_push(args,operand(borrow_mut(c)));
    }
    expect(borrow_mut(c),read(")"));
    expect(borrow_mut(c),read(";"));
    o(borrow_mut(c),f);
    vec_push(c.out,40);
    for i in len(args) {
        if i!=0 { vec_push(c.out,44); }
        ov(borrow_mut(c),load(vec_get(args,i)));
    }
    o(borrow_mut(c),read(");\n"));
    return ();
}
fn stmt<a>(c:ref_mut<a,C>)->unit {
    if eat(borrow_mut(c),read("break")) {
        expect(borrow_mut(c),read(";"));
        o(borrow_mut(c),read("break;\n"));
        return ();
    }
    if eat(borrow_mut(c),read("continue")) {
        expect(borrow_mut(c),read(";"));
        o(borrow_mut(c),read("continue;\n"));
        return ();
    }
    if eat(borrow_mut(c),read("return")) {
        let v=expr(borrow_mut(c),0);
        expect(borrow_mut(c),read(";"));
        o(borrow_mut(c),read("return "));
        ov(borrow_mut(c),v.t);
        o(borrow_mut(c),read(";\n"));
        return ();
    }
    if is(borrow_mut(c),read("{")) { block(borrow_mut(c)); return (); }
    if is(borrow_mut(c),read("let"))+is(borrow_mut(c),read("var")) {
        advance(borrow_mut(c));
        let name=ident(borrow_mut(c));
        if eat(borrow_mut(c),read(":")) {
            let ty=parse_type(borrow_mut(c));
            expect(borrow_mut(c),read(";"));
            let n=def(borrow_mut(c));
            o(borrow_mut(c),read("0;\n"));
            bind(borrow_mut(c),name,ty,n);
            return ();
        }
        expect(borrow_mut(c),read("="));
        let v=expr(borrow_mut(c),0);
        expect(borrow_mut(c),read(";"));
        let n=def(borrow_mut(c));
        ov(borrow_mut(c),v.t);
        o(borrow_mut(c),read(";\n"));
        bind(borrow_mut(c),name,v.ty,n);
        return ();
    }
    if eat(borrow_mut(c),read("while")) {
        o(borrow_mut(c),read("for(;;){\n"));
        let v=expr(borrow_mut(c),0);
        o(borrow_mut(c),read("if(!"));
        ov(borrow_mut(c),v.t);
        o(borrow_mut(c),read(")break;\n"));
        block(borrow_mut(c));
        o(borrow_mut(c),read("}\n"));
        return ();
    }
    if eat(borrow_mut(c),read("for")) {
        let name=ident(borrow_mut(c));
        expect(borrow_mut(c),read("in"));
        let v=expr(borrow_mut(c),0);
        let e=def(borrow_mut(c));
        ov(borrow_mut(c),v.t);
        o(borrow_mut(c),read(";\n"));
        let i=fresh(borrow_mut(c));
        o(borrow_mut(c),read("for(G "));
        ov(borrow_mut(c),i);
        o(borrow_mut(c),read("=0;"));
        ov(borrow_mut(c),i);
        vec_push(c.out,60);
        ov(borrow_mut(c),e);
        vec_push(c.out,59);
        ov(borrow_mut(c),i);
        o(borrow_mut(c),read("++)"));
        let mark=len(c.locals);
        bind(borrow_mut(c),name,0,i);
        block(borrow_mut(c));
        pop_locals(borrow_mut(c),mark);
        return ();
    }
    if eat(borrow_mut(c),read("match")) {
        let s=expr(borrow_mut(c),0);
        let x=deref(borrow_mut(c),s);
        let xt=x.t;
        let d=ty_arg(borrow_mut(c),x.ty);
        let tag=def(borrow_mut(c));
        slot(borrow_mut(c),xt,0);
        o(borrow_mut(c),read(";\n"));
        expect(borrow_mut(c),read("{"));
        while eat(borrow_mut(c),read("}"))==0 {
            let name=ident(borrow_mut(c));
            let k=find_field(borrow_mut(c),d,read(name));
            let pty=field_ty(borrow_mut(c),d,k);
            o(borrow_mut(c),read("if("));
            ov(borrow_mut(c),tag);
            o(borrow_mut(c),read("=="));
            on(borrow_mut(c),k);
            o(borrow_mut(c),read("){\n"));
            let mark=len(c.locals);
            if eat(borrow_mut(c),read("(")) {
                if eat(borrow_mut(c),read("_"))==0 {
                    let b=ident(borrow_mut(c));
                    let n=def(borrow_mut(c));
                    slot(borrow_mut(c),xt,1);
                    o(borrow_mut(c),read(";\n"));
                    bind(borrow_mut(c),b,pty,n);
                }
                expect(borrow_mut(c),read(")"));
            }
            expect(borrow_mut(c),read("=>"));
            block(borrow_mut(c));
            o(borrow_mut(c),read("}else "));
            pop_locals(borrow_mut(c),mark);
            if eat(borrow_mut(c),read(","))==0 {
                expect(borrow_mut(c),read("}"));
                break;
            }
        }
        o(borrow_mut(c),read("abort();\n"));
        return ();
    }
    if eat(borrow_mut(c),read("if")) {
        let v=expr(borrow_mut(c),0);
        o(borrow_mut(c),read("if("));
        ov(borrow_mut(c),v.t);
        vec_push(c.out,41);
        block(borrow_mut(c));
        if eat(borrow_mut(c),read("else")) {
            o(borrow_mut(c),read("else"));
            block(borrow_mut(c));
        }
        return ();
    }
    if eat(borrow_mut(c),read("drop")) {
        expect(borrow_mut(c),read("("));
        ident(borrow_mut(c));
        expect(borrow_mut(c),read(")"));
        expect(borrow_mut(c),read(";"));
        return ();
    }
    if eat(borrow_mut(c),read("append_text")) { statement_call(borrow_mut(c),read("rt_append"),2); return (); }
    if eat(borrow_mut(c),read("push")) { statement_call(borrow_mut(c),read("rt_pushb"),2); return (); }
    if eat(borrow_mut(c),read("write")) { statement_call(borrow_mut(c),read("rt_write"),3); return (); }
    if eat(borrow_mut(c),read("assert")) {
        expect(borrow_mut(c),read("("));
        let v=expr(borrow_mut(c),0);
        expect(borrow_mut(c),read(")"));
        expect(borrow_mut(c),read(";"));
        o(borrow_mut(c),read("if(!"));
        ov(borrow_mut(c),v.t);
        o(borrow_mut(c),read(")abort();\n"));
        return ();
    }
    if assignment_ahead(borrow_mut(c)) {
        let name=ident(borrow_mut(c));
        let l=find_local(borrow_mut(c),read(name));
        if l==0 { fail(borrow_mut(c),read("undefined assignment")); }
        let id=local_id(borrow_mut(c),l-1);
        let ty=local_ty(borrow_mut(c),l-1);
        var target=id;
        var through=0;
        if kind(borrow_mut(c))==46 {
            let a=field_path(borrow_mut(c),id,ty,1);
            target=a.t;
            through=1;
        }
        expect(borrow_mut(c),read("="));
        let v=expr(borrow_mut(c),0);
        expect(borrow_mut(c),read(";"));
        if through { o(borrow_mut(c),read("*(G*)")); }
        ov(borrow_mut(c),target);
        vec_push(c.out,61);
        ov(borrow_mut(c),v.t);
        o(borrow_mut(c),read(";\n"));
        return ();
    }
    let v=expr(borrow_mut(c),0);
    expect(borrow_mut(c),read(";"));
    return ();
}

fn host_fn<a,b>(c:ref_mut<a,C>,name:read<b>,ret:num)->unit {
    vec_push(c.funcs,Func{module:copy_bytes(read("host")),name:copy_bytes(name),first:0,count:0,ret:ret});
    return ();
}
pub fn main()->num {
    var c=C{
        src:bytes(), toks:vec<Tok>(), pos:0, out:vec<num>(), module:bytes(),
        types:vec<Ty>(), decls:vec<Decl>(), fields:vec<Field>(), funcs:vec<Func>(), params:vec<num>(),
        locals:vec<Local>(), next:0, entry:0, file:0
    };
    for k in 5 { intern(borrow_mut(c),k+1,0); }
    host_fn(borrow_mut(c),read("argc"),0);
    host_fn(borrow_mut(c),read("arg"),2);
    host_fn(borrow_mut(c),read("read_file"),2);
    host_fn(borrow_mut(c),read("write_file"),0);
    host_fn(borrow_mut(c),read("print"),1);
    host_fn(borrow_mut(c),read("command"),0);
    let n=host::argc();
    assert(2<n);
    for pass in 3 {
        if pass==1 { o(borrow_mut(c),read("#include \"grail_rt.c\"\n")); }
        var i=2;
        while i<n {
            load_file(borrow_mut(c),i);
            exchange(borrow_mut(c.file),i);
            toplevel(borrow_mut(c),pass+1);
            i=i+1;
        }
    }
    let e=c.entry;
    if e==0 { fail(borrow_mut(c),read("no public entry function with at most one parameter")); }
    let f=vec_get(c.funcs,e-1);
    let m=copy_bytes(read(f.module));
    let name=copy_bytes(read(f.name));
    let count=f.count;
    o(borrow_mut(c),read("int main(int argc,char**argv){rt_argc=argc;rt_argv=argv;"));
    if count==1 { o(borrow_mut(c),read("if(argc!=2)return 2;")); }
    o(borrow_mut(c),read("printf(\"%llu\\n\",(unsigned long long)"));
    mangle(borrow_mut(c),read(m),read(name));
    if count==1 { o(borrow_mut(c),read("(rt_view(f_host_arg(1))));return 0;}\n")); } else {
        o(borrow_mut(c),read("());return 0;}\n"));
    }
    let out=bytes();
    for i in len(c.out) { push(out,load(vec_get(c.out,i))); }
    let path=host::arg(1);
    return host::write_file(read(path),read(out));
}
