extern "C" record Bv16 { a: i64, b: i64 }
extern "C" record BvMd { d: f64, i: i64 }
extern "C" record Bv24 { a: i64, b: i64, c: i64 }
extern "C" lib "fb.o" fn c_add3(a: i64, b: i64, c: i64) -> i64;
extern "C" lib "fb.o" fn c_byval16(s: byval Bv16) -> i64;
extern "C" lib "fb.o" fn c_byval_md(s: byval BvMd) -> i64;
extern "C" lib "fb.o" fn c_byval24(s: byval Bv24) -> i64;
extern "C" lib "fb.o" fn c_make16(a: i64, b: i64) -> Bv16;
extern "C" lib "fb.o" fn c_fma(a: f64, b: f64, c: f64) -> f64;
extern "C" lib "fb.o" fn c_fmaf(a: f32, b: f32, c: f32) -> f32;
extern "C" lib "fb.o" fn c_sum_view(bytes: &[u8]) -> i64;
extern "C" lib "fb.o" fn c_apply(callback: cfn(i64) -> i64, v: i64) -> i64;
extern "C" lib "fb.o" fn c_loop(callback: cfn(i64) -> i64, n: i64) -> i64;
extern "C" fn cb(v: i64) -> i64 { return v + 1; }
fn main() -> u64 {
    mut t: i64 = 0;
    unsafe { t = c_loop(cb, 10000000); }
    println("{} {} {}", t, 0.0, 0.0);
    return 0;
}
