// x[i] = x[i] * a + y[i] over one million f64, 1000 passes; prints the sum of the result.
// The loop C vectorises: docs/design/simd-layout-parallel-loops.md, section 1.3.
fn scale_add(x: (&mut [f64]), y: (&[f64]), a: f64) -> unit {
    n := x.len();
    mut i = 0;
    while i < n {
        x[i] = x[i] * a + y[i];
        i += 1;
    }
}
fn main() {
    n := 1000000;
    mut x = f64[];
    mut y = f64[];
    mut xv: f64 = 0.0;
    mut yv: f64 = 0.0;
    for i in n {
        x.push(xv);
        y.push(yv);
        xv = xv + 0.5;
        if 3.0 < xv { xv = 0.0; }
        yv = yv + 0.25;
        if 1.0 < yv { yv = 0.0; }
    }
    mut a: f64 = 0.999;
    for pass in 1000 {
        scale_add(&mut x[0: n], &y[0: n], a);
        a = 0.999 - x[pass] * 0.000000001; // the next pass depends on this one
    }
    mut sum: f64 = 0.0;
    for i in n {
        sum = sum + f64(x[i]);
    }
    println(sum);
}
