// A hash-map workload: a million u64 keys inserted into the standard map, every key looked up,
// every other key removed and every key looked up again; prints checksums. Fixed seeds, so every
// run does the same work.
use hashmap;

fn main() {
    n: u64 := 1000000;
    mut m = [u64: u64]::with_seed(1, 2);
    mut keys = u64[];
    mut x: u64 = 88172645463325252;
    for i in n {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        keys.push(x);
        m[x] = i;
    }
    mut sum: u64 = 0;
    for i in n {
        if let Some(v) = m.get(&keys[i]) {
            sum = wrapping_add(sum, *v);
        }
    }
    mut removed: u64 = 0;
    for i in n {
        if i % 2 == 0 {
            if let Some(v) = m.remove(&keys[i]) {
                removed = wrapping_add(removed, v);
            }
        }
    }
    mut found: u64 = 0;
    for i in n {
        if m.contains(&keys[i]) {
            found += 1;
        }
    }
    println("{} {} {} {}", sum, removed, found, m.len());
}
