// The parallel twin of bench/ecs.grl: the same million entities, the same 600 frames, the same
// sum, with each frame's update run on the pool's workers through one fused parallel_for_zip over
// all six columns (matching OpenMP, rayon, C++ std::barrier, Go and Zig).
// Runs inside a structured green task so main sleeps and GRAIL_WORKERS=W uses exactly W threads
// total (matching OMP_NUM_THREADS, CPP_THREADS, RAYON_NUM_THREADS, GOMAXPROCS and ZIG_THREADS).
const GRAIN: u64 = 16384;
const DT: f32 = 0.016;
const DAMPING: f32 = 0.999;
const GRAVITY: f32 = 0.0981;

fn axis(v: &mut [f32], p: &mut [f32]) {
    if p.len() < v.len() { return (); }
    for i in v.len() {
        v[i] = v[i] * DAMPING;
        p[i] = p[i] + v[i] * DT;
    }
}

fn axis_y(v: &mut [f32], p: &mut [f32]) {
    if p.len() < v.len() { return (); }
    for i in v.len() {
        v[i] = v[i] * DAMPING - GRAVITY * DT;
        p[i] = p[i] + v[i] * DT;
    }
}

fn update(vx: &mut [f32], vy: &mut [f32], vz: &mut [f32], px: &mut [f32], py: &mut [f32], pz: &mut [f32]) {
    axis(vx, px);
    axis_y(vy, py);
    axis(vz, pz);
}

fn run_sim(_n: u64, _ctx: u64) -> f64 {
    n: u64 := 1000000;
    mut px = f32[0.0; n];
    mut py = f32[0.0; n];
    mut pz = f32[0.0; n];
    mut vx = f32[0.0; n];
    mut vy = f32[0.0; n];
    mut vz = f32[0.0; n];
    mut x: u64 = 88172645463325252;
    for i in n {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        px[i] = f32(i64(x % 1000)) * 0.5;
        py[i] = f32(i64((x >> 10) % 1000)) * 0.5;
        pz[i] = f32(i64((x >> 20) % 1000)) * 0.5;
        vx[i] = f32(i64((x >> 30) % 100)) * 0.01;
        vy[i] = f32(i64((x >> 40) % 100)) * 0.01;
        vz[i] = f32(i64((x >> 50) % 100)) * 0.01;
    }
    for frame in 600 {
        parallel_for_zip(GRAIN, update, &mut vx[0.. n], &mut vy[0.. n], &mut vz[0.. n], &mut px[0.. n], &mut py[0.. n], &mut pz[0.. n]);
    }
    mut sum: f64 = 0.0;
    for i in n {
        sum = sum + f64(px[i]) + f64(py[i]) + f64(pz[i]);
    }
    sum
}

fn body<s>(sc: (&s Scope<u64>), _ctx: u64) -> f64 {
    t := spawn(sc, 0, run_sim);
    join(t)
}

fn main() {
    println("{}", task_scope(0, body));
}
