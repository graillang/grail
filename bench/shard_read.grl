// The question behind lib/concurrent_map.grl's shards: under a read-mostly load, is a shard behind
// an RwLock faster than one behind a Mutex? W tasks look keys up in one 4096-entry map, 1 write in
// 64. Prints wall ms per W for each lock. Build and run it directly; docs/design/parking.md.
use sync;
use host;
use hashmap;
struct Shared { m: Mutex<[u64: u64]>, rw: sync::RwLock<[u64: u64]>, mode: u64 }
fn get_m<a>(v: (&a mut [u64: u64]), k: u64) -> u64 {
    return u64(hashmap::map_contains(&v, &k));
}
fn put_m<a>(v: (&a mut [u64: u64]), k: u64) -> u64 {
    hashmap::map_insert(v, k, k + 1);
    return 0;
}
fn work(n: u64, s: (&Shared)) -> u64 {
    mut total = 0;
    for i in 20000 {
        k := (i * 2654435761 + n) % 4096;
        if i % 64 == 0 {
            if s.mode == 0 {
                s.m.lock_with(k, put_m);
            } else {
                s.rw.write_with(k, |v: (&mut [u64: u64]), key: u64| -> u64 { hashmap::map_insert(v, key, key + 1); return 0; });
            }
        } else {
            if s.mode == 0 {
                total += s.m.lock_with(k, get_m);
            } else {
                total += s.rw.read_with(k, |v: (&[u64: u64]), key: u64| -> u64 u64(hashmap::map_contains(v, &key)));
            }
        }
    }
    return total;
}
fn body<sc>(scope: (&sc Scope<(&Shared)>), s: (&Shared)) -> u64 {
    mut many = Task<u64>[];
    for i in 24 {
        many.push(spawn(scope, i, work));
    }
    mut t = 0;
    while let Some(x) = many.pop() {
        t += join(x);
    }
    return t;
}
fn fill() -> [u64: u64] {
    mut m = hashmap::with_seed<u64, u64>(1, 2);
    for i in 4096 {
        hashmap::map_insert(&mut m, i, i + 1);
    }
    return m;
}
fn main() {
    for mode in 2 {
        s := Shared { m: Mutex::new(fill()), rw: sync::rwlock<[u64: u64]>(fill()), mode: mode };
        t0 := host::now_ms();
        r := task_scope(&s, body);
        if mode == 0 {
            println("mutex shard: {} ms ({})", host::now_ms() - t0, r);
        } else {
            println("rwlock shard: {} ms ({})", host::now_ms() - t0, r);
        }
    }
}
