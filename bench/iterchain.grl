// An iterator chain: ten million u64 through map(x * 2), filter(% 3 == 0) and a sum, the
// standard library's adapters with closures; prints the sum.
use vecs;

fn main() {
    n: u64 := 10000000;
    mut v = u64[];
    for i in n {
        v.push(i);
    }
    s := v.iter().map(|x: &u64| -> u64 *x * 2).filter(|x: &u64| -> bool *x % 3 == 0).fold(0, |acc: u64, x: u64| -> u64 wrapping_add(acc, x));
    println("{}", s);
}
