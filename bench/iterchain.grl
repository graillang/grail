// An iterator chain: 20 rounds over ten million u64 through map((x + round) * 2), filter(% 3 == 0)
// and a sum, using the standard library's adapters with closures; prints the total sum.
use vecs;

fn main() {
    n: u64 := 10000000;
    mut v = u64[0; n];
    for i in n {
        v[i] = i;
    }
    mut s: u64 = 0;
    for round in 20 {
        r := round;
        s = wrapping_add(
            s,
            v.iter()
                .map(|x: &u64| -> u64 (*x + r) * 2)
                .filter(|x: &u64| -> bool *x % 3 == 0)
                .fold(0, |acc: u64, x: u64| -> u64 wrapping_add(acc, x))
        );
    }
    println("{}", s);
}
