// Binary trees (the benchmarks game's, max depth 16): allocation-heavy. Trees are built bottom-up
// and walked; prints the check of each set of trees.
enum Tree {
    Leaf,
    Node(Branch),
}
struct Branch {
    left: Tree,
    right: Tree,
}
fn make(depth: u64) -> Tree {
    if depth == 0 {
        return Tree::Node(Branch { left: Tree::Leaf, right: Tree::Leaf });
    }
    return Tree::Node(Branch { left: make(depth - 1), right: make(depth - 1) });
}
fn check<a>(tree: (&a Tree)) -> u64 {
    match tree {
        Leaf => {
            return 0;
        },
        Node(b) => {
            return 1 + check(&b.left) + check(&b.right);
        },
    }
}
fn main() {
    max: u64 := 16;
    stretch := make(max + 1);
    println("{}", check(&stretch));
    long_lived := make(max);
    mut d: u64 = 4;
    while d <= max {
        iterations: u64 = 1 << (max - d + 4);
        mut total: u64 = 0;
        for i in iterations {
            t := make(d);
            total += check(&t);
        }
        println("{} {}", iterations, total);
        d += 2;
    }
    println("{}", check(&long_lived));
}
