// FNV-1a over 64 MiB of pseudo-random bytes, eight times; prints the final hash.
fn main() {
    n: u64 := 67108864;
    mut data = u8[];
    mut x: u64 = 88172645463325252;
    for i in n {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        data.push(x & 255);
    }
    mut h: u64 = 14695981039346656037;
    for round in 8 {
        for i in n {
            h = wrapping_mul(h ^ u64(data[i]), 1099511628211);
        }
    }
    println(h);
}
