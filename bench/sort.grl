// Bottom-up merge sort of 4 million pseudo-random u64 values, three times; prints a checksum.
fn main() {
    n: u64 := 4194304;
    mut check: u64 = 0;
    for round in 3 {
        mut v = u64[];
        mut x: u64 = 2463534242 + round;
        for i in n {
            x = x ^ (x << 13);
            x = x ^ (x >> 7);
            x = x ^ (x << 17);
            v.push(x);
        }
        mut tmp = v.copy();
        mut width: u64 = 1;
        while width < n {
            mut lo: u64 = 0;
            while lo < n {
                mut mid = lo + width;
                if mid > n {
                    mid = n;
                }
                mut hi = lo + 2 * width;
                if hi > n {
                    hi = n;
                }
                mut i = lo;
                mut j = mid;
                mut k = lo;
                while k < hi {
                    if (i < mid) && ((j >= hi) || (v[i] <= v[j])) {
                        tmp[k] = v[i];
                        i += 1;
                    } else {
                        tmp[k] = v[j];
                        j += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            mut swap = v;
            v = tmp;
            tmp = swap;
            width = width * 2;
        }
        check = check ^ v[0] ^ v[n / 2] ^ v[n - 1];
    }
    println(check);
}
