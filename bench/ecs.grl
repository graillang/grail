// An ECS-style update: a million entities as structure-of-arrays f32 positions and velocities,
// a hundred frames of gravity, damping and integration; prints the sum of the positions. The
// columns are vectors: a million-element array is too large for a frame in any of the languages.
// Each is made at its full length (`f32[0.0; n]`) and filled by index, as every twin sizes its
// columns once (C's malloc, Rust's with_capacity, Go's make, Zig's alloc).
fn main() {
    n: u64 := 1000000;
    mut px = f32[0.0; n];
    mut py = f32[0.0; n];
    mut pz = f32[0.0; n];
    mut vx = f32[0.0; n];
    mut vy = f32[0.0; n];
    mut vz = f32[0.0; n];
    mut x: u64 = 88172645463325252;
    for i in n {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        px[i] = f32(i64(x % 1000)) * 0.5;
        py[i] = f32(i64((x >> 10) % 1000)) * 0.5;
        pz[i] = f32(i64((x >> 20) % 1000)) * 0.5;
        vx[i] = f32(i64((x >> 30) % 100)) * 0.01;
        vy[i] = f32(i64((x >> 40) % 100)) * 0.01;
        vz[i] = f32(i64((x >> 50) % 100)) * 0.01;
    }
    dt: f32 := 0.016;
    damping: f32 := 0.999;
    gravity: f32 := 0.0981;
    for frame in 100 {
        for i in n {
            vx[i] = vx[i] * damping;
            vy[i] = vy[i] * damping - gravity * dt;
            vz[i] = vz[i] * damping;
            px[i] = px[i] + vx[i] * dt;
            py[i] = py[i] + vy[i] * dt;
            pz[i] = pz[i] + vz[i] * dt;
        }
    }
    mut sum: f64 = 0.0;
    for i in n {
        sum = sum + f64(px[i]) + f64(py[i]) + f64(pz[i]);
    }
    println("{}", sum);
}
