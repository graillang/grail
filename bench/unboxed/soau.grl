fn main() {
    n := 1000000;
    mut xs = u64[];
    mut ys = u64[];
    mut zs = u64[];
    for i in n {
        f := i % 1000;
        xs.push(f);
        ys.push(f * 3);
        zs.push(f * 5);
    }
    mut total = 0;
    for pass in 20 {
        for i in n {
            xs[i] = wrapping_add(xs[i] * 3, ys[i]);
            ys[i] = ys[i] ^ pass;
            zs[i] = wrapping_add(zs[i], 1);
        }
        for i in n {
            total = wrapping_add(total, wrapping_add(xs[i], wrapping_add(ys[i], zs[i])));
        }
    }
    println(total);
}
