// Integer twin of aos.grl: isolates layout from the native backend's float calls.
struct P3 {
    x: u64,
    y: u64,
    z: u64
}
fn main() {
    n := 1000000;
    mut v = P3[];
    for i in n {
        f := i % 1000;
        v.push(P3 { x: f, y: f * 3, z: f * 5 });
    }
    mut s = 88172645463325252;
    mut k = n - 1;
    while k > 0 {
        s = s ^ (s << 13);
        s = s ^ (s >> 7);
        s = s ^ (s << 17);
        v.swap(k, s % (k + 1));
        k -= 1;
    }
    mut total = 0;
    for pass in 20 {
        for i in n {
            p := &mut v[i];
            p.x = wrapping_add(p.x * 3, p.y);
            p.y = p.y ^ pass;
            p.z = wrapping_add(p.z, 1);
        }
        for i in n {
            q := &v[i];
            total = wrapping_add(total, wrapping_add(q.x, wrapping_add(q.y, q.z)));
        }
    }
    println(total);
}
