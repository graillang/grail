// 1M {x,y,z: f32} records in a vector: build, transform in place, sum. 20 passes.
struct V3 {
    x: f32,
    y: f32,
    z: f32
}
fn main() {
    n := 1000000;
    mut v = V3[];
    for i in n {
        f: f32 := f32(i % 1000);
        v.push(V3 { x: f, y: f * 0.5, z: f * 0.25 });
    }
    mut total: f32 = 0.0;
    for pass in 20 {
        for i in n {
            p := &mut v[i];
            p.x = p.x * 1.0001 + p.y;
            p.y = p.y * 0.9999;
            p.z = p.z + 1.0;
        }
        for i in n {
            q := &v[i];
            total = total + q.x + q.y + q.z;
        }
    }
    println(total);
}
