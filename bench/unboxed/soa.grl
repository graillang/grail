// The same work over three f32[] columns: the layout flat storage would give each field access.
fn main() {
    n := 1000000;
    mut xs = f32[];
    mut ys = f32[];
    mut zs = f32[];
    for i in n {
        f: f32 := f32(i % 1000);
        xs.push(f);
        ys.push(f * 0.5);
        zs.push(f * 0.25);
    }
    mut total: f32 = 0.0;
    for pass in 20 {
        for i in n {
            xs[i] = xs[i] * 1.0001 + ys[i];
            ys[i] = ys[i] * 0.9999;
            zs[i] = zs[i] + 1.0;
        }
        for i in n {
            total = total + xs[i] + ys[i] + zs[i];
        }
    }
    println(total);
}
