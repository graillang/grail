// 256x256 f32 matrix multiply, repeated; prints a checksum of the result.
fn main() {
    n: u64 := 256;
    mut a = f32[];
    mut b = f32[];
    mut c = f32[];
    for i in n * n {
        a.push(f32(i64(i % 7)) * 0.25);
        b.push(f32(i64(i % 11)) * 0.5);
        c.push(0.0);
    }
    for round in 20 {
        for i in n {
            for j in n {
                mut s: f32 = 0.0;
                for k in n {
                    s = s + a[i * n + k] * b[k * n + j];
                }
                c[i * n + j] = s;
            }
        }
    }
    mut sum: f64 = 0.0;
    for i in n * n {
        sum = sum + f64(c[i]);
    }
    println(sum);
}
