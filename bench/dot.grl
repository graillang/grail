// Dot product of two f32 vectors, 16 million lanes, three times. The kernel is written the way a
// portable vector facility (lib/simd.grl, docs/design/simd.md) would consume it: one multiply-add per
// lane with the accumulation kept in f64 so the result does not depend on the summation order.
fn main() {
    n: u64 := 16000000;
    mut a = f32[];
    mut b = f32[];
    mut x: u64 = 88172645463325252;
    for i in n {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        a.push(f32(i64(x & 1023)) * 0.5);
        b.push(f32(i64((x >> 10) & 1023)) * 0.25);
    }
    mut sum: f64 = 0.0;
    for round in 3 {
        sum = 0.0;
        mut i: u64 = 0;
        while i < a.len() {
            sum = sum + f64(a[i]) * f64(b[i]);
            i += 1;
        }
    }
    println(sum);
}
