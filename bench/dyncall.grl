// Dynamic dispatch: a million shapes of three kinds behind `dyn Shape`, their areas summed twenty
// times, one indirect call per element; prints the total.
interface Shape {
    fn area(self: &Self) -> u64;
}
struct Square {
    side: u64,
}
struct Rect {
    w: u64,
    h: u64,
}
struct Tri {
    b: u64,
    h: u64,
}
impl Shape for Square {
    fn area(self: &Self) -> u64 {
        return self.side * self.side;
    }
}
impl Shape for Rect {
    fn area(self: &Self) -> u64 {
        return self.w * self.h;
    }
}
impl Shape for Tri {
    fn area(self: &Self) -> u64 {
        return self.b * self.h / 2;
    }
}
fn main() {
    n: u64 := 1000000;
    mut shapes = (dyn Shape)[];
    mut x: u64 = 88172645463325252;
    for i in n {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        k := x % 3;
        a := x % 100;
        b := (x >> 8) % 100;
        if k == 0 {
            shapes.push(Square { side: a });
        } else {
            if k == 1 {
                shapes.push(Rect { w: a, h: b });
            } else {
                shapes.push(Tri { b: a, h: b });
            }
        }
    }
    mut total: u64 = 0;
    for pass in 20 {
        for s in &shapes {
            total = wrapping_add(total, s.area());
        }
    }
    println("{}", total);
}
