// Sieve of Eratosthenes up to 50 million, repeated; prints the prime count.
fn main() {
    n: u64 := 50000000;
    mut count: u64 = 0;
    for round in 3 {
        mut composite = u8[];
        for i in n + 1 {
            composite.push(0);
        }
        count = 0;
        mut i: u64 = 2;
        while i <= n {
            if composite[i] == 0 {
                count += 1;
                mut j = i * i;
                while j <= n {
                    composite[j] = 1;
                    j += i;
                }
            }
            i += 1;
        }
    }
    println(count);
}
