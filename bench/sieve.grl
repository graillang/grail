// Sieve of Eratosthenes up to 50 million, three rounds; prints the sum of the prime counts. Each
// round's limit depends on the previous round's count, so no round is dead code a compiler may drop.
fn main() {
    n: u64 := 50000000;
    mut count: u64 = 0;
    mut total: u64 = 0;
    for round in 3 {
        limit := n - (count & 1);
        mut composite = u8[0; limit + 1];
        count = 0;
        mut i: u64 = 2;
        while i <= limit {
            if composite[i] == 0 {
                count += 1;
                mut j = i * i;
                while j <= limit {
                    composite[j] = 1;
                    j += i;
                }
            }
            i += 1;
        }
        total += count;
    }
    println(total);
}
