// Sums every byte of a 64 MiB buffer three times: one load per iteration and the loop counter as the
// index, which is the shape a per-access bounds check costs the most in. The guard names the length
// (`while i < data.len()`), so the check is one the range facts remove.
fn main() {
    n: u64 := 67108864;
    mut data = u8[];
    mut x: u64 = 88172645463325252;
    for i in n {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        data.push(x & 255);
    }
    mut s: u64 = 0;
    for round in 3 {
        s = 0;
        mut i: u64 = 0;
        while i < data.len() {
            s += u64(data[i]);
            i += 1;
        }
    }
    println(s);
}
