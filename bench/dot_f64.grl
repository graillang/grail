// The dot product of two vectors of one million f64, 200 passes with one element changed between
// passes; prints the total. A strict-IEEE serial sum: C does not vectorise it either without
// -ffast-math (docs/design/simd-layout-parallel-loops.md, section 1.3).
fn dot(x: (&[f64]), y: (&[f64])) -> f64 {
    n := x.len();
    mut s: f64 = 0.0;
    mut i = 0;
    while i < n {
        s = s + x[i] * y[i];
        i += 1;
    }
    return s;
}
fn main() {
    n := 1000000;
    mut x = f64[];
    mut y = f64[];
    mut xv: f64 = 0.0;
    mut yv: f64 = 0.0;
    for i in n {
        x.push(xv);
        y.push(yv);
        xv = xv + 0.5;
        if 3.0 < xv { xv = 0.0; }
        yv = yv + 0.25;
        if 1.0 < yv { yv = 0.0; }
    }
    mut total: f64 = 0.0;
    for pass in 200 {
        x[pass] = x[pass] + 1.0;
        total = total + f64(dot(&x[0: n], &y[0: n]));
    }
    println(total);
}
