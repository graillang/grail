module arena;

// ---- arenas: stable handles into one collection --------------------------------------------------
//
// An arena hands out a `Key` for every value it stores and takes it back on `remove`, so a structure
// can point at its members without the lifetime gymnastics a tree of references demands. Keys are
// *generational*: a slot remembers which generation of its use a key was issued for, so a key kept
// past its value's end answers `None` instead of naming whatever was inserted into that slot later.
// A freed slot is reused with its generation bumped, which is what makes the stale key detectable.
//
// Everything here is safe Grail: the arena owns its values, and a value leaves it through `remove`
// (which returns it, still owned) or at the arena's own end. Each slot keeps its value in a vector
// of at most one element, so a slot can be empty and `remove` can hand the value back with `pop` -
// one owner throughout, no pointer of our own.

pub struct Key {
    index: u64,
    gen: u64
}

struct Slot<T> {
    // The generation this slot is in; `value` holds the value or is empty.
    gen: u64,
    value: T[]
}

pub struct Arena<T> {
    slots: Slot<T>[],
    // Slot indices whose value has been removed, ready to be reused with a new generation.
    free: u64[],
    live: u64
}

pub fn new<T>() -> Arena<T> {
    return Arena { slots: Slot<T>[], free: u64[], live: 0 };
}

// A fresh key for `v`.
pub fn insert<T>(self: &mut Arena<T>, v: T) -> Key {
    if self.free.len() != 0 {
        last := self.free.len() - 1;
        index := self.free[last];
        self.free.pop()!;
        slot := &mut self.slots[index];
        slot.gen = slot.gen + 1;
        slot.value.push(v);
        self.live = self.live + 1;
        return Key { index: index, gen: slot.gen };
    }
    index := self.slots.len();
    mut values = T[];
    values.push(v);
    self.slots.push(Slot { gen: 1, value: values });
    self.live = self.live + 1;
    return Key { index: index, gen: 1 };
}

// 1 when `k` still names the value it was issued for.
fn holds<a, T>(self: &a Arena<T>, k: (&Key)) -> u64 {
    if self.slots.len() <= k.index {
        return 0;
    }
    slot := &self.slots[k.index];
    if slot.gen != k.gen {
        return 0;
    }
    if slot.value.len() == 0 {
        return 0;
    }
    return 1;
}

// The value `k` names, borrowed from the arena.
pub fn get<a, T>(self: &a Arena<T>, k: (&Key)) -> (&a T)? {
    if holds(self, k) == 0 {
        return None;
    }
    slot := &self.slots[k.index];
    return Some(&slot.value[0]);
}

// The value `k` names, for writing.
pub fn get_mut<a, T>(self: &mut Arena<T>, k: (&Key)) -> (&a mut T)? {
    if self.slots.len() <= k.index {
        return None;
    }
    slot := &mut self.slots[k.index];
    if (slot.gen != k.gen) || (slot.value.len() == 0) {
        return None;
    }
    return Some(&mut slot.value[0]);
}

// Take the value back out. The slot is kept for reuse and its generation moves on, so `k` is dead
// afterwards and a second `remove` answers `None`.
pub fn remove<T>(self: &mut Arena<T>, k: (&Key)) -> T? {
    if self.slots.len() <= k.index {
        return None;
    }
    slot := &mut self.slots[k.index];
    if (slot.gen != k.gen) || (slot.value.len() == 0) {
        return None;
    }
    slot.gen = slot.gen + 1;
    self.live = self.live - 1;
    self.free.push(k.index);
    return Some(slot.value.pop()!);
}

pub fn len<T>(self: &Arena<T>) -> u64 {
    return self.live;
}

pub fn is_empty<T>(self: &Arena<T>) -> bool {
    return self.live == 0;
}
