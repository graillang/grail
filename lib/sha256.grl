module sha256;

// SHA-256 (FIPS 180-4). Incremental: `mut s=sha256::new(); s.update(&a); s.update(&b);
// digest:=s.finish();` or one-shot `sha256::digest(&data)` (32 bytes) and
// `sha256::hex_digest(&data)` (64 lowercase hex characters). Words are u32 values held in u64.
pub struct Sha256{h:u64[],k:u64[],w:u64[],buf:u8[],total:u64}

const MASK: u64 = 4294967295;

fn round_constants()->u64[]{
    return u64[0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];
}
pub fn new()->Sha256{
    mut w=u64[];for i in 64{w.push(0u64);}
    return Sha256{h:u64[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19],
        k:round_constants(),w:w,buf:u8[],total:0u64};
}
fn rotr(x:u64,n:u64)->u64{return ((x>>n)|(x<<(32-n)))&MASK;}
// Compresses the 64-byte block data[at:at+64] into the chaining state.
fn compress<a,b>(state:(&a mut Sha256),data:&b [u8],at:u64){
    for t in 16{
        o:=at+t*4;
        state.w[t]=(data[o]<<24)|(data[o+1]<<16)|(data[o+2]<<8)|data[o+3];
    }
    for t in 16..64{
        x:=state.w[t-15];y:=state.w[t-2];
        s0:=rotr(x,7)^rotr(x,18)^(x>>3);s1:=rotr(y,17)^rotr(y,19)^(y>>10);
        state.w[t]=(state.w[t-16]+s0+state.w[t-7]+s1)&MASK;
    }
    mut a=state.h[0];mut b=state.h[1];mut c=state.h[2];mut d=state.h[3];
    mut e=state.h[4];mut f=state.h[5];mut g=state.h[6];mut h=state.h[7];
    for t in 64{
        s1:=rotr(e,6)^rotr(e,11)^rotr(e,25);ch:=(e&f)^((e^MASK)&g);
        t1:=h+s1+ch+state.k[t]+state.w[t];
        s0:=rotr(a,2)^rotr(a,13)^rotr(a,22);maj:=(a&b)^(a&c)^(b&c);
        h=g;g=f;f=e;e=(d+t1)&MASK;d=c;c=b;b=a;a=(t1+s0+maj)&MASK;
    }
    state.h[0]=(state.h[0]+a)&MASK;state.h[1]=(state.h[1]+b)&MASK;state.h[2]=(state.h[2]+c)&MASK;state.h[3]=(state.h[3]+d)&MASK;
    state.h[4]=(state.h[4]+e)&MASK;state.h[5]=(state.h[5]+f)&MASK;state.h[6]=(state.h[6]+g)&MASK;state.h[7]=(state.h[7]+h)&MASK;
}
// Tops up the pending partial block from data, compressing it once full; returns bytes used.
fn fill<a,b>(state:(&a mut Sha256),data:&b [u8])->u64{
    mut i:u64=0;
    while (i<data.len())&(state.buf.len()<64){state.buf.push(data[i]);i+=1;}
    if state.buf.len()==64{block:=exchange(&mut state.buf,u8[]);compress(&mut state,&block,0);}
    return i;
}
impl Sha256{
    // Absorbs more message bytes; any split of the message gives the same digest.
    pub fn update<a,b>(self:(&a mut Sha256),data:&b [u8]){
        n:=data.len();self.total=wrapping_add(self.total,n);
        mut i:u64=0;
        if self.buf.len()!=0{i=fill(&mut self,&data);}
        while i+64<=n{compress(&mut self,&data,i);i+=64;}
        while i<n{self.buf.push(data[i]);i+=1;}
    }
    // Pads the message and returns the 32-byte digest.
    pub fn finish(self:Sha256)->u8[]{
        mut state=self;bit_length:=wrapping_mul(state.total,8);
        mut tail=exchange(&mut state.buf,u8[]);tail.push(128u64);
        while tail.len()%64!=56{tail.push(0u64);}
        for i in 8{tail.push((bit_length>>(56-i*8))&255);}
        mut at:u64=0;while at<tail.len(){compress(&mut state,&tail,at);at+=64;}
        mut out=u8[];for i in 8{word:=state.h[i];out.push(word>>24);out.push((word>>16)&255);out.push((word>>8)&255);out.push(word&255);}
        return out;
    }
}
// SHA-256 of a whole byte view: 32 bytes.
pub fn digest<a>(data:&a [u8])->u8[]{mut state=new();state.update(data);return state.finish();}
// Lowercase hexadecimal spelling of any bytes (two characters per byte).
pub fn hex<a>(bytes:&a [u8])->string{
    digits:="0123456789abcdef";mut out=u8[];
    for b in bytes{out.push(digits[b>>4]);out.push(digits[b&15]);}
    return out.text();
}
// SHA-256 of a byte view as 64 lowercase hex characters.
pub fn hex_digest<a>(data:&a [u8])->string{d:=digest(data);return hex(&d);}
