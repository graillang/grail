module debug;

// `@derive(Debug)` implements this interface: the text a value shows as (docs/design/derives.md).
// A derived implementation is also an inherent `show`, which is the method `println`, `print` and
// `format` already call when a `{}` spec meets a value of the type.
pub interface Debug {
    fn debug(self: &Self) -> string;
}

impl Debug for u64 {
    fn debug(self: &u64) -> string {
        return format("{}", *self);
    }
}
impl Debug for u8 {
    fn debug(self: &u8) -> string {
        return format("{}", *self);
    }
}
impl Debug for u16 {
    fn debug(self: &u16) -> string {
        return format("{}", *self);
    }
}
impl Debug for u32 {
    fn debug(self: &u32) -> string {
        return format("{}", *self);
    }
}
impl Debug for i8 {
    fn debug(self: &i8) -> string {
        return format("{}", *self);
    }
}
impl Debug for i16 {
    fn debug(self: &i16) -> string {
        return format("{}", *self);
    }
}
impl Debug for i32 {
    fn debug(self: &i32) -> string {
        return format("{}", *self);
    }
}
impl Debug for i64 {
    fn debug(self: &i64) -> string {
        return format("{}", *self);
    }
}
impl Debug for bool {
    fn debug(self: &bool) -> string {
        return format("{}", *self);
    }
}
impl Debug for f64 {
    fn debug(self: &f64) -> string {
        return format("{}", *self);
    }
}
impl Debug for f32 {
    fn debug(self: &f32) -> string {
        return format("{}", *self);
    }
}
impl Debug for char {
    fn debug(self: &char) -> string {
        return format("'{}'", *self);
    }
}
// Text is quoted, so `name: "ada"` cannot be read as a bare word.
impl Debug for string {
    fn debug(self: &string) -> string {
        return format("\"{}\"", self.copy().text());
    }
}
impl Debug for u8[] {
    fn debug(self: &u8[]) -> string {
        return format("\"{}\"", self.copy());
    }
}
