module io;

// Errors returned by fs and other I/O functions: the operating system's, plus the two failures a
// library layer of its own can detect - text that is not UTF-8, and a write the platform accepted
// only partly.
pub enum Error{NotFound,PermissionDenied,AlreadyExists,NotADirectory,IsADirectory,NotEmpty,InvalidUtf8(u64),ShortWrite(u64),Other(u64)}
pub fn from_errno(code:u64)->Error{
    match code{
        2=>{return Error::NotFound;},13=>{return Error::PermissionDenied;},1=>{return Error::PermissionDenied;},17=>{return Error::AlreadyExists;},
        20=>{return Error::NotADirectory;},21=>{return Error::IsADirectory;},39=>{return Error::NotEmpty;},_=>{return Error::Other(code);}
    }
}
impl Error{
    pub fn show<a>(self:(&a Error))->string{
        match self{
            NotFound=>{return "not found".text();},PermissionDenied=>{return "permission denied".text();},AlreadyExists=>{return "already exists".text();},
            NotADirectory=>{return "not a directory".text();},IsADirectory=>{return "is a directory".text();},NotEmpty=>{return "directory not empty".text();},
            InvalidUtf8(at)=>{return format("text is not valid UTF-8 (ill-formed at byte {})", at);},
            ShortWrite(written)=>{return format("short write: {} bytes accepted", written);},
            Other(code)=>{return format("os error {}", code);}
        }
    }
    pub fn is_not_found<a>(self:(&a Error))->bool{match self{NotFound=>{return true;},_=>{return false;}}}
}
