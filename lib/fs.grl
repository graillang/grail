module fs;
use host;
use core;
use io;

// Fallible file-system access: failures are io::Error values instead of stopping the program.
pub fn read<a>(path:read<a>)->u8[] | io::Error{
    fd:=host::open(path,0);
    if fd>9223372036854775807{return io::from_errno(wrapping_sub(0,fd));}
    mut out=u8[];
    while true{chunk:=host::read_fd(fd,65536);if chunk.len()==0{break;}for b in chunk{out.push(b);}}
    host::close(fd);return out;
}
pub fn read_text<a>(path:read<a>)->string | io::Error{data:=read(path)?;return data.text();}
pub fn write<a,b>(path:read<a>,data:read<b>)->unit | io::Error{
    error:=host::write_file(path,data);
    if error!=0{return io::from_errno(error);}return ();
}
pub fn exists<a>(path:read<a>)->bool{return host::exists(path)!=0;}
pub fn create_dir<a>(path:read<a>)->unit | io::Error{
    error:=host::create_dir(path);if error!=0{return io::from_errno(error);}return ();
}
// Entry names (directories end with "/"), sorted by the caller if order matters.
pub fn list_dir<a>(path:read<a>)->u8[][]{return host::list_dir(path);}
pub fn remove_file<a>(path:read<a>)->unit | io::Error{
    error:=host::remove(path,0);if error!=0{return io::from_errno(error);}return ();
}
pub fn remove_dir<a>(path:read<a>)->unit | io::Error{
    error:=host::remove(path,1);if error!=0{return io::from_errno(error);}return ();
}
