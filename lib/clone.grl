module clone;

// `@derive(Clone)` implements this interface: a deep copy of an owned value, field by field
// (docs/design/derives.md). A borrowed view has nothing of its own to copy into, so it has no
// implementation here and `@derive(Clone)` refuses a field of one instead of copying the handle.
pub interface Clone {
    fn clone(self: &Self) -> Self;
}

impl Clone for u64 {
    fn clone(self: &u64) -> u64 {
        return *self;
    }
}
impl Clone for u8 {
    fn clone(self: &u8) -> u8 {
        return *self;
    }
}
impl Clone for u16 {
    fn clone(self: &u16) -> u16 {
        return *self;
    }
}
impl Clone for u32 {
    fn clone(self: &u32) -> u32 {
        return *self;
    }
}
impl Clone for i8 {
    fn clone(self: &i8) -> i8 {
        return *self;
    }
}
impl Clone for i16 {
    fn clone(self: &i16) -> i16 {
        return *self;
    }
}
impl Clone for i32 {
    fn clone(self: &i32) -> i32 {
        return *self;
    }
}
impl Clone for i64 {
    fn clone(self: &i64) -> i64 {
        return *self;
    }
}
impl Clone for bool {
    fn clone(self: &bool) -> bool {
        return *self;
    }
}
impl Clone for char {
    fn clone(self: &char) -> char {
        return *self;
    }
}
impl Clone for f64 {
    fn clone(self: &f64) -> f64 {
        return *self;
    }
}
impl Clone for f32 {
    fn clone(self: &f32) -> f32 {
        return *self;
    }
}
// Text and bytes own their storage: `copy` allocates and copies it.
impl Clone for string {
    fn clone(self: &string) -> string {
        return self.copy().text();
    }
}
impl Clone for u8[] {
    fn clone(self: &u8[]) -> u8[] {
        return self.copy();
    }
}
