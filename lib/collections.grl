module collections;
use core;

pub fn new<T>()->T[]{return T[];}
pub fn push<a,T>(values:ref_mut<a,T[]>,value:T)->unit{
    values.push(value);
    return ();
}
pub fn pop<a,T>(values:ref_mut<a,T[]>)->core::Option<T>{
    if values.len()!=0{return core::some(values.pop());}
    return core::none<T>();
}
pub fn get<a,T>(values:ref<a,T[]>,index:num)->ref<a,T>{
    return &values[index];
}
pub fn get_mut<a,T>(values:ref_mut<a,T[]>,index:num)->ref_mut<a,T>{
    return &mut values[index];
}
