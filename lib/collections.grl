module collections;
use core;

pub fn new<T>()->T[]{return T[];}
pub fn push<a,T>(values:(&mut a T[]),value:T)->unit{
    values.push(value);
    return ();
}
pub fn pop<a,T>(values:(&mut a T[]))->T?{
    if values.len()!=0{return core::some(values.pop());}
    return core::none<T>();
}
pub fn get<a,T>(values:(&a T[]),index:u64)->(&a T){
    return &values[index];
}
pub fn get_mut<a,T>(values:(&mut a T[]),index:u64)->(&mut a T){
    return &mut values[index];
}
