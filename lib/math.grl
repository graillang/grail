module math;

use math_glibc;

// Elementary functions after fdlibm (Sun Microsystems), written in Grail on IEEE f64.
// exp/ln/atan are accurate to about 1 ulp; sin/cos/tan use Cody-Waite reduction and stay
// accurate for |x| < 1e6 (larger arguments lose precision); pow uses exact repeated squaring for
// integer exponents and a double-double exp(y*ln(x)) otherwise.
pub const PI: f64 = 3.141592653589793;
pub const TAU: f64 = 6.283185307179586;
pub const E: f64 = 2.718281828459045;
pub const LN2: f64 = 0.6931471805599453;
pub const LN10: f64 = 2.302585092994046;
pub const SQRT2: f64 = 1.4142135623730951;

fn high(x:f64)->i64{h:=i64(bits(x)>>32);if h>=2147483648{return h-4294967296;}return h;}
fn with_high(x:f64,h:i64)->f64{low:=bits(x)&4294967295;mut top=h;if top<0{top=top+4294967296;}return f64_from_bits((u64(top)<<32)|low);}
fn scale2(x:f64,k:i64)->f64{
    // x * 2^k for normal results; two steps keep subnormal and large cases exact.
    mut y=x;mut n=k;
    while n>1000{y=y*f64_from_bits(2023*4503599627370496);n-=1000;}
    while n< -1000{y=y*f64_from_bits(23*4503599627370496);n+=1000;}
    return y*f64_from_bits(u64(1023+n)*4503599627370496);
}
// glibc's own exp (lib/math_glibc.grl): the engine calls the C library, so this is the value a
// parity test sees. fdlibm's formulation differs in the last bit on some inputs.
@no_block
fn exp(x:f64)->f64{return math_glibc::exp(x);}
@no_block
fn ln(value:f64)->f64{
    mut x=value;mut hx=high(x);lx:=bits(x)&4294967295;mut k=0i64;
    if hx<1048576{
        if ((hx&2147483647)==0)&(lx==0){return -1.0/0.0;}
        if hx<0{return 0.0/0.0;}
        k-=54;x=x*1.80143985094819840000e+16;hx=high(x);
    }
    if hx>=2146435072{return x+x;}
    k+=(hx>>20)-1023;hx=hx&1048575;
    i:=(hx+614244)&1048576;
    x=with_high(x,hx|(i^1072693248));k+=i>>20;
    f:=x-1.0;dk:=f64(k);
    if (1048575&(2+hx))<3{
        if f==0.0{if k==0{return 0.0;}return dk*6.93147180369123816490e-01+dk*1.90821492927058770002e-10;}
        r:=f*f*(0.5-0.33333333333333333*f);
        if k==0{return f-r;}return dk*6.93147180369123816490e-01-((r-dk*1.90821492927058770002e-10)-f);
    }
    s:=f/(2.0+f);z:=s*s;mut ii=hx-398458;w:=z*z;j:=440401-hx;
    t1:=w*(3.999999999940941908e-01+w*(2.222219843214978396e-01+w*1.531383769920937332e-01));
    t2:=z*(6.666666666666735130e-01+w*(2.857142874366239149e-01+w*(1.818357216161805012e-01+w*1.479819860511658591e-01)));
    ii=ii|j;r:=t2+t1;
    if ii>0{
        hfsq:=0.5*f*f;
        if k==0{return f-(hfsq-s*(hfsq+r));}
        return dk*6.93147180369123816490e-01-((hfsq-(s*(hfsq+r)+dk*1.90821492927058770002e-10))-f);
    }
    if k==0{return f-s*(f-r);}
    return dk*6.93147180369123816490e-01-((s*(f-r)-dk*1.90821492927058770002e-10)-f);
}
// log2/log10 split off the binary exponent first (fdlibm e_log10), so exact powers stay exact.
fn split_log(value:f64,scale:f64,exponent_hi:f64,exponent_lo:f64)->f64{
    mut x=value;mut hx=high(x);lx:=bits(x)&4294967295;mut k=0i64;
    if hx<1048576{
        if ((hx&2147483647)==0)&(lx==0){return -1.0/0.0;}
        if hx<0{return 0.0/0.0;}
        k-=54;x=x*1.80143985094819840000e+16;hx=high(x);
    }
    if hx>=2146435072{return x+x;}
    k+=(hx>>20)-1023;mut i=0i64;if k<0{i=1;}
    hx=(hx&1048575)|((1023-i)<<20);y:=f64(k+i);x=with_high(x,hx);
    z:=y*exponent_lo+scale*ln(x);return z+y*exponent_hi;
}
@no_block
fn log10(x:f64)->f64{return split_log(x,4.34294481903251816668e-01,3.01029995663611771306e-01,3.69423907715893078616e-13);}
@no_block
fn log2(x:f64)->f64{return math_glibc::log2(x);}
fn kernel_sin(x:f64,y:f64,iy:u64)->f64{
    z:=x*x;v:=z*x;
    r:=8.33333333332248946124e-03+z*(-1.98412698298579493134e-04+z*(2.75573137070700676789e-06+z*(-2.50507602534068634195e-08+z*1.58969099521155010221e-10)));
    if iy==0{return x+v*(-1.66666666666666324348e-01+z*r);}
    return x-((z*(0.5*y-v*r)-y)-v*-1.66666666666666324348e-01);
}
fn kernel_cos(x:f64,y:f64)->f64{
    z:=x*x;
    r:=z*(4.16666666666666019037e-02+z*(-1.38888888888741095749e-03+z*(2.48015872894767294178e-05+z*(-2.75573143513906633035e-07+z*(2.08757232129817482790e-09+z*-1.13596475577881948265e-11)))));
    hz:=0.5*z;w:=1.0-hz;return w+(((1.0-w)-hz)+(z*r-x*y));
}
struct Reduced{n:i64,y0:f64,y1:f64}
fn exponent_of(x:f64)->i64{return i64((bits(x)>>52)&2047);}
fn reduce(x:f64)->Reduced{
    n:=i64((x*6.36619772367581382433e-01).round());fnv:=f64(n);
    mut r=x-fnv*1.57079632673412561417e+00;mut w=fnv*6.07710050650619224932e-11;mut y0=r-w;
    j:=exponent_of(x);
    if j-exponent_of(y0)>16{
        t:=r;w=fnv*6.07710050630396597660e-11;r=t-w;w=fnv*2.02226624879595063154e-21-((t-r)-w);y0=r-w;
        if j-exponent_of(y0)>49{t2:=r;w=fnv*2.02226624871116645580e-21;r=t2-w;w=fnv*8.47842766036889956997e-32-((t2-r)-w);y0=r-w;}
    }
    return Reduced{n:n,y0:y0,y1:(r-y0)-w};
}
@no_block
fn sin(x:f64)->f64{
    if (high(x)&2147483647)<=1072243195{return kernel_sin(x,0.0,0);}
    if x.is_nan()||((high(x)&2147483647)>=2146435072){return 0.0/0.0;}
    red:=reduce(x);q:=red.n&3;
    if q==0{return kernel_sin(red.y0,red.y1,1);}if q==1{return kernel_cos(red.y0,red.y1);}
    if q==2{return -kernel_sin(red.y0,red.y1,1);}return -kernel_cos(red.y0,red.y1);
}
@no_block
fn cos(x:f64)->f64{
    if (high(x)&2147483647)<=1072243195{return kernel_cos(x,0.0);}
    if x.is_nan()||((high(x)&2147483647)>=2146435072){return 0.0/0.0;}
    red:=reduce(x);q:=red.n&3;
    if q==0{return kernel_cos(red.y0,red.y1);}if q==1{return -kernel_sin(red.y0,red.y1,1);}
    if q==2{return -kernel_cos(red.y0,red.y1);}return kernel_sin(red.y0,red.y1,1);
}
@no_block
fn tan(x:f64)->f64{return sin(x)/cos(x);}
@no_block
fn atan(value:f64)->f64{
    hx:=high(value);ix:=hx&2147483647;mut x=value;mut id=-1i64;
    if ix>=1141899264{if x.is_nan(){return x;}if hx>0{return 1.57079632679489655800e+00+6.12323399573676603587e-17;}return -1.57079632679489655800e+00-6.12323399573676603587e-17;}
    if ix<1071382528{if ix<1044381696{return x;}}
    else{
        x=x.abs();
        if ix<1072889856{if ix<1072037888{id=0;x=(2.0*x-1.0)/(2.0+x);}else{id=1;x=(x-1.0)/(x+1.0);}}
        else{if ix<1073971200{id=2;x=(x-1.5)/(1.0+1.5*x);}else{id=3;x=-1.0/x;}}
    }
    z:=x*x;w:=z*z;
    s1:=z*(3.33333333333329318027e-01+w*(1.42857142725034663711e-01+w*(9.09088713343650656196e-02+w*(6.66107313738753120669e-02+w*(4.97687799461593236017e-02+w*1.62858201153657823623e-02)))));
    s2:=w*(-1.99999999998764832476e-01+w*(-1.11111104054623557880e-01+w*(-7.69187620504482999495e-02+w*(-5.83357013379057348645e-02+w*-3.65315727442169155270e-02))));
    if id<0{return x-x*(s1+s2);}
    mut hi=4.63647609000806093515e-01;mut lo=2.26987774529616870924e-17;
    if id==1{hi=7.85398163397448278999e-01;lo=3.06161699786838301793e-17;}
    if id==2{hi=9.82793723247329054082e-01;lo=1.39033110312309984516e-17;}
    if id==3{hi=1.57079632679489655800e+00;lo=6.12323399573676603587e-17;}
    r:=hi-((x*(s1+s2)-lo)-x);if hx<0{return -r;}return r;
}
@no_block
fn atan2(y:f64,x:f64)->f64{
    if x.is_nan()||y.is_nan(){return x+y;}
    if x>0.0{return atan(y/x);}
    if x<0.0{if y<0.0{return atan(y/x)-PI;}return atan(y/x)+PI;}
    if y>0.0{return PI/2.0;}if y<0.0{return -PI/2.0;}return 0.0;
}
@no_block
fn powi(x:f64,n:i64)->f64{
    mut base=x;mut e=n;if e<0{base=1.0/x;e=-e;}mut result=1.0;
    while e>0{if (e&1)==1{result=result*base;}base=base*base;e=e>>1;}return result;
}
@no_block
fn pow(x:f64,y:f64)->f64{
    if y==0.0{return 1.0;}
    if (y.floor()==y)&(y.abs()<2147483648.0){return powi(x,i64(y));}
    if y==0.5{return x.sqrt();}
    if x<0.0{return 0.0/0.0;}if x==0.0{if y>0.0{return 0.0;}return 1.0/0.0;}
    // y*ln(x) in double-double: Dekker's exact product plus a Newton correction of ln(x).
    l:=ln(x);correction:=x*exp(-l)-1.0;product:=y*l;
    error:=product_error(y,l,product)+y*correction;
    return exp(product)*(1.0+error);
}
fn product_error(a:f64,b:f64,p:f64)->f64{
    ca:=134217729.0*a;ah:=ca-(ca-a);al:=a-ah;cb:=134217729.0*b;bh:=cb-(cb-b);bl:=b-bh;
    return ((ah*bh-p)+ah*bl+al*bh)+al*bl;
}
// asin after fdlibm's __ieee754_asin (what glibc's double asin evaluates):
// the same rational approximation, the same two branches around |x| = 0.5 and
// 0.975, and the same pi/4 reconstruction. The huge+x guard forces the inexact
// flag for tiny x; the value is x either way.
@no_block
fn asin(x:f64)->f64{
    hx:=high(x);ix:=hx&2147483647;
    if ix>=1072693248{
        lx:=i64(bits(x)&4294967295);
        // |x| == 1: +-pi/2, split hi/lo so the sum rounds once.
        if ((ix-1072693248)|lx)==0{return x*1.57079632679489655800e+00+x*6.12323399573676603587e-17;}
        return (x-x)/(x-x);
    }
    if ix<1071644672{
        if ix<1044381696{return x;}
        t:=x*x;
        p:=t*(1.66666666666666657415e-01+t*(-3.25565818622400915405e-01+t*(2.01212532134862925881e-01+t*(-4.00555345006794114027e-02+t*(7.91534994289814532176e-04+t*3.47933107596021167570e-05)))));
        q:=1.0+t*(-2.40339491173441421878e+00+t*(2.02094576023350569471e+00+t*(-6.88283971605453293030e-01+t*7.70381505559019352791e-02)));
        return x+x*(p/q);
    }
    w:=1.0-x.abs();t2:=w*0.5;
    p2:=t2*(1.66666666666666657415e-01+t2*(-3.25565818622400915405e-01+t2*(2.01212532134862925881e-01+t2*(-4.00555345006794114027e-02+t2*(7.91534994289814532176e-04+t2*3.47933107596021167570e-05)))));
    q2:=1.0+t2*(-2.40339491173441421878e+00+t2*(2.02094576023350569471e+00+t2*(-6.88283971605453293030e-01+t2*7.70381505559019352791e-02)));
    s:=t2.sqrt();
    if ix>=1072640819{
        t:=1.57079632679489655800e+00-(2.0*(s+s*(p2/q2))-6.12323399573676603587e-17);
        if hx<0{return -t;}return t;
    }
    w2:=f64_from_bits(bits(s)&18446744069414584320);
    c:=(t2-w2*w2)/(s+w2);
    r:=p2/q2;
    pp:=2.0*s*r-(6.12323399573676603587e-17-2.0*c);
    qq:=7.85398163397448278999e-01-2.0*w2;
    tt:=7.85398163397448278999e-01-(pp-qq);
    if hx<0{return -tt;}return tt;
}
// acos: arccos in [0, pi], fdlibm's twin of asin above (same rational, the same pi/2 hi/lo split);
// about 1 ulp, NaN outside [-1, 1].
@no_block
fn acos(x:f64)->f64{
    hx:=high(x);ix:=hx&2147483647;
    if ix>=1072693248{
        lx:=i64(bits(x)&4294967295);
        if ((ix-1072693248)|lx)==0{if hx>0{return 0.0;}return 3.14159265358979311600e+00+2.0*6.12323399573676603587e-17;}
        return (x-x)/(x-x);
    }
    if ix<1071644672{
        if ix<=1012924416{return 1.57079632679489655800e+00+6.12323399573676603587e-17;}
        z:=x*x;r:=acos_r(z);
        return 1.57079632679489655800e+00-(x-(6.12323399573676603587e-17-x*r));
    }
    if hx<0{
        z:=(1.0+x)*0.5;s:=z.sqrt();w:=acos_r(z)*s-6.12323399573676603587e-17;
        return 3.14159265358979311600e+00-2.0*(s+w);
    }
    z:=(1.0-x)*0.5;s:=z.sqrt();df:=f64_from_bits(bits(s)&18446744069414584320);c:=(z-df*df)/(s+df);
    w:=acos_r(z)*s+c;return 2.0*(df+w);
}
fn acos_r(z:f64)->f64{
    p:=z*(1.66666666666666657415e-01+z*(-3.25565818622400915405e-01+z*(2.01212532134862925881e-01+z*(-4.00555345006794114027e-02+z*(7.91534994289814532176e-04+z*3.47933107596021167570e-05)))));
    q:=1.0+z*(-2.40339491173441421878e+00+z*(2.02094576023350569471e+00+z*(-6.88283971605453293030e-01+z*7.70381505559019352791e-02)));
    return p/q;
}
// The exact remainder of a division (IEEE 754 remainder-of-division, C fmod):
// no value is ever rounded, so this is the true remainder by construction.
// NaN when either input is NaN, the divisor is zero or the dividend is
// infinite; x itself when the divisor is infinite.
@no_block
fn fmod(x:f64,y:f64)->f64{
    if x.is_nan()||y.is_nan(){return x+y;}
    zero:=0.0;
    if (bits(x)&9223372036854775807)==9218868437227405312{return zero/zero;}
    if (bits(y)&9223372036854775807)==9218868437227405312{return x;}
    if y==zero{return zero/zero;}
    mut r=x;if r<zero{r=-r;}
    mut d=y;if d<zero{d=-d;}
    if r<d{return x;}
    while r>=d{
        mut s=d;
        while s<=r/2.0{s=s*2.0;}
        r=r-s;
    }
    if x<zero{return -r;}
    return r;
}
// hypot: the correctly rounded sqrt(x*x + y*y). glibc's double hypot is
// correctly rounded (newer than fdlibm's __ieee754_hypot, whose split-high-word
// expression still rounds twice); this takes the square root of the rounded
// sum and then corrects the last bit with the exact residual of
// x^2 + y^2 - s^2, computed with Dekker products. Large operands are scaled by
// powers of two first, which is exact, and infinite/NaN follow C's hypot.
struct HypotPair {
    hi: f64,
    lo: f64
}

fn two_product(a:f64,b:f64)->HypotPair{
    p:=a*b;
    ca:=134217729.0*a;ah:=ca-(ca-a);al:=a-ah;
    cb:=134217729.0*b;bh:=cb-(cb-b);bl:=b-bh;
    return HypotPair{hi:p,lo:((ah*bh-p)+ah*bl+al*bh)+al*bl};
}

fn two_sum(a:f64,b:f64)->HypotPair{
    s:=a+b;bb:=s-a;
    return HypotPair{hi:s,lo:(a-(s-bb))+(b-bb)};
}

@no_block
fn hypot(x:f64,y:f64)->f64{
    mut a = x.abs();
    mut b = y.abs();
    if b>a{const_swap:=a;a=b;b=const_swap;}
    if a.is_nan()||b.is_nan(){return a+b;}
    if (bits(a)&9223372036854775807)==9218868437227405312{return a;}
    // Exact power-of-two scaling so neither a*a nor the squares underflow:
    // 2^-600 for huge operands, 2^600 for subnormal ones.
    mut back = 1.0;
    if a>3.273390607896142e150{
        a=a*f64_from_bits(1905022642377719808);b=b*f64_from_bits(1905022642377719808);back=f64_from_bits(7309342195222315008);
    }else if b<2.7624420577613535e-151{
        a=a*f64_from_bits(7309342195222315008);b=b*f64_from_bits(7309342195222315008);back=f64_from_bits(1905022642377719808);
    }
    if b==0.0{return a*back;}
    s:=(a*a+b*b).sqrt();
    if s==0.0{return 0.0;}
    ap:=two_product(a,a);
    bp:=two_product(b,b);
    sp:=two_sum(ap.hi,bp.hi);
    err:=ap.lo+bp.lo+sp.lo;
    ss:=two_product(s,s);
    d1:=two_sum(sp.hi,-ss.hi);
    diff:=d1.hi+(err-ss.lo+d1.lo);
    return (s+diff/(2.0*s))*back;
}

// ---------------------------------------------------------------------------------------------
// Single precision, bit for bit what glibc computes: sinf, cosf, expf, exp2f, logf, log2f,
// powf, asinf.
//
// glibc's float routines (sysdeps/ieee754/flt-32, from ARM's optimized-routines) evaluate in double
// over small tables, and the x86-64 libm runs its FMA build, so each `a * b + c` there rounds once.
// These follow those routines step for step with their exact tables (the bit patterns of glibc's
// __exp2f_data, __logf_data, __log2f_data, __sincosf_table and __inv_pio4) and a software fused
// multiply-add, so the result is the libm's on every input, not merely within an ulp. A C prototype
// of exactly these steps matched the host libm on all 2^32 inputs of each function.
// The tables are packed hex text, 16 digits a word (8 for __inv_pio4).

static EXP2F_TAB: string = "";
static LOGF_TAB: string = "";
static LOG2F_TAB: string = "";
static SINCOSF_TAB: string = "";
static INV_PIO4: string = "000000a20000a2f900a2f983a2f9836ef9836e4e836e4e446e4e44154e441529441529fc1529fc2729fc2757fc2757d12757d1f557d1f534d1f534ddf534ddc034ddc0dbddc0db62c0db6295db6295996295993c95993c43993c43903c439041";

fn exp2f_tab(i: u64) -> u64 {
    // Indexed in place: passing the static to a helper would view it, which allocates.
    at := 16 * i;
    mut word = 0;
    for j in 16 {
        d := EXP2F_TAB[at + j];
        mut v = d - 48;
        if d >= 97 {
            v = d - 87;
        }
        word = (word << 4) | v;
    }
    return word;
}
fn logf_tab(i: u64) -> u64 {
    // Indexed in place: passing the static to a helper would view it, which allocates.
    at := 16 * i;
    mut word = 0;
    for j in 16 {
        d := LOGF_TAB[at + j];
        mut v = d - 48;
        if d >= 97 {
            v = d - 87;
        }
        word = (word << 4) | v;
    }
    return word;
}
fn log2f_tab(i: u64) -> u64 {
    // Indexed in place: passing the static to a helper would view it, which allocates.
    at := 16 * i;
    mut word = 0;
    for j in 16 {
        d := LOG2F_TAB[at + j];
        mut v = d - 48;
        if d >= 97 {
            v = d - 87;
        }
        word = (word << 4) | v;
    }
    return word;
}
fn sincosf_tab(i: u64) -> u64 {
    // Indexed in place: passing the static to a helper would view it, which allocates.
    at := 16 * i;
    mut word = 0;
    for j in 16 {
        d := SINCOSF_TAB[at + j];
        mut v = d - 48;
        if d >= 97 {
            v = d - 87;
        }
        word = (word << 4) | v;
    }
    return word;
}
fn inv_pio4(i: u64) -> u64 {
    // Indexed in place: passing the static to a helper would view it, which allocates.
    at := 8 * i;
    mut word = 0;
    for j in 8 {
        d := INV_PIO4[at + j];
        mut v = d - 48;
        if d >= 97 {
            v = d - 87;
        }
        word = (word << 4) | v;
    }
    return word;
}
// Arithmetic shift of a 32-bit two's-complement word.
fn sext32(u: u64) -> i64 {
    if u >= 2147483648 {
        return i64(u) - 4294967296;
    }
    return i64(u);
}
// Round-to-odd a + b: the two-sum, nudged one ulp toward its error when inexact and even.
fn add_odd(a: f64, b: f64) -> f64 {
    sum := two_sum(a, b);
    mut s = sum.hi;
    if (sum.lo != 0.0) && ((bits(s) & 1) == 0) {
        if (sum.lo > 0.0) == (s > 0.0) {
            s = f64_from_bits(bits(s) + 1);
        } else {
            s = f64_from_bits(bits(s) - 1);
        }
    }
    return s;
}
// a * b + c rounded once (Boldo and Melquiond, "Emulation of FMA and correctly rounded sums", 2008),
// for the normal-range operands these routines pass it.
fn fma_rn(a: f64, b: f64, c: f64) -> f64 {
    u := two_product(a, b);
    if u.hi == 0.0 {
        return a * b + c;
    }
    t := two_sum(c, u.hi);
    return t.hi + add_odd(t.lo, u.lo);
}
fn f32_top(x: f32) -> u64 {
    return (f32_bits(x) >> 20) & 2047;
}


@no_block
pub fn expf(x: f32) -> f32 {
    xd := f64(x);
    abstop := f32_top(x);
    if abstop >= 1067 {
        if f32_bits(x) == 4286578688 {
            return 0.0;
        }
        if abstop >= 2040 {
            return x + x;
        }
        if x > f32_from_bits(1118925335) {
            return f32_from_bits(2139095040);
        }
        if x < f32_from_bits(3268407732) {
            return 0.0;
        }
    }
    shift := f64_from_bits(4843621399236968448);
    invln2 := f64_from_bits(4631694138158056190);
    mut kd = fma_rn(invln2, xd, shift);
    ki := bits(kd);
    kd = kd - shift;
    r := fma_rn(invln2, xd, -kd);
    s := f64_from_bits(wrapping_add(exp2f_tab(ki % 32), ki << 47));
    z := fma_rn(f64_from_bits(4520605740625372052), r, f64_from_bits(4552787166160930035));
    r2 := r * r;
    mut y = fma_rn(f64_from_bits(4581900536177775318), r, 1.0);
    y = fma_rn(z, r2, y);
    return f32(y * s);
}

@no_block
pub fn exp2f(x: f32) -> f32 {
    xd := f64(x);
    abstop := f32_top(x);
    if abstop >= 1072 {
        if f32_bits(x) == 4286578688 {
            return 0.0;
        }
        if abstop >= 2040 {
            return x + x;
        }
        if x > 0.0 {
            return f32_from_bits(2139095040);
        }
        if x <= -150.0 {
            return 0.0;
        }
    }
    shift := f64_from_bits(4821103401100115968);
    mut kd = xd + shift;
    ki := bits(kd);
    kd = kd - shift;
    r := xd - kd;
    s := f64_from_bits(wrapping_add(exp2f_tab(ki % 32), ki << 47));
    z := fma_rn(f64_from_bits(4588159735035929492), r, f64_from_bits(4597823162434634995));
    r2 := r * r;
    mut y = fma_rn(f64_from_bits(4604418534314627798), r, 1.0);
    y = fma_rn(z, r2, y);
    return f32(y * s);
}

// The argument split both logarithms share: ix = 2^k z with z near 1, and the table index i.
struct LogfSplit {
    k: i64,
    i: u64,
    z: f64,
    // 0 when the split applies; otherwise the result is `special`.
    is_special: bool,
    special: f32
}
fn logf_split(x: f32) -> LogfSplit {
    mut ix = f32_bits(x);
    if ix == 1065353216 {
        return LogfSplit{k: 0, i: 0, z: 0.0, is_special: true, special: 0.0};
    }
    if wrapping_sub(ix, 8388608) >= 2130706432 {
        if ((ix * 2) & 4294967295) == 0 {
            return LogfSplit{k: 0, i: 0, z: 0.0, is_special: true, special: f32_from_bits(4286578688)};
        }
        if ix == 2139095040 {
            return LogfSplit{k: 0, i: 0, z: 0.0, is_special: true, special: x};
        }
        if ((ix & 2147483648) != 0) || (((ix * 2) & 4294967295) >= 4278190080) {
            return LogfSplit{k: 0, i: 0, z: 0.0, is_special: true, special: (x - x) / (x - x)};
        }
        // Subnormal: normalize.
        ix = wrapping_sub(f32_bits(x * f32_from_bits(1258291200)), 192937984);
    }
    tmp := wrapping_sub(ix, 1060306944) & 4294967295;
    iz := (wrapping_sub(ix, tmp & 4286578688)) & 4294967295;
    return LogfSplit{k: sext32(tmp) >> 23, i: (tmp >> 19) % 16, z: f64(f32_from_bits(iz)), is_special: false, special: 0.0};
}

@no_block
pub fn logf(x: f32) -> f32 {
    sp := logf_split(x);
    if sp.is_special {
        return sp.special;
    }
    invc := f64_from_bits(logf_tab(2 * sp.i));
    logc := f64_from_bits(logf_tab(2 * sp.i + 1));
    r := fma_rn(sp.z, invc, -1.0);
    y0 := fma_rn(f64(sp.k), f64_from_bits(4604418534313441775), logc);
    r2 := r * r;
    mut y = fma_rn(f64_from_bits(4599678642981702506), r, f64_from_bits(13826050851498246435));
    y = fma_rn(f64_from_bits(13821563350862562100), r2, y);
    y = fma_rn(y, r2, y0 + r);
    return f32(y);
}

@no_block
pub fn log2f(x: f32) -> f32 {
    sp := logf_split(x);
    if sp.is_special {
        return sp.special;
    }
    invc := f64_from_bits(log2f_tab(2 * sp.i));
    logc := f64_from_bits(log2f_tab(2 * sp.i + 1));
    r := fma_rn(sp.z, invc, -1.0);
    y0 := logc + f64(sp.k);
    r2 := r * r;
    mut y = fma_rn(f64_from_bits(4602338792138355424), r, f64_from_bits(13828044578235278302));
    y = fma_rn(f64_from_bits(13823538158275034701), r2, y);
    p := fma_rn(f64_from_bits(4609176139921213624), r, y0);
    y = fma_rn(y, r2, p);
    return f32(y);
}

// __sincosf_table row `row` (0, or 1 for the shifted quadrants): sign[4], hpi_inv, hpi, c0..c4, s1..s3.
fn sc(row: u64, field: u64) -> f64 {
    return f64_from_bits(sincosf_tab(14 * row + field));
}
struct SinReduced {
    x: f64,
    n: u64
}
// |x| < 120: x - n pi/2 with n rounded from x 2/pi (n as its low two bits).
fn sinf_reduce_fast(x: f64) -> SinReduced {
    r := x * sc(0, 4);
    n := (i64(r) + 8388608) >> 24;
    return SinReduced{x: fma_rn(-f64(n), sc(0, 5), x), n: u64(n & 3)};
}
// Large |x|: Payne-Hanek over __inv_pio4, in 32- and 64-bit integer steps.
fn sinf_reduce_large(word: u64) -> SinReduced {
    base := (word >> 26) & 15;
    shift := (word >> 23) & 7;
    m := ((word & 16777215) | 8388608) << shift;
    a0 := inv_pio4(base);
    a4 := inv_pio4(base + 4);
    a8 := inv_pio4(base + 8);
    mut res0 = (m * a0) & 4294967295;
    res1 := m * a4;
    res2 := m * a8;
    res0 = (res2 >> 32) | (res0 << 32);
    res0 = wrapping_add(res0, res1);
    n := wrapping_add(res0, 2305843009213693952) >> 62;
    res0 = wrapping_sub(res0, n << 62);
    mut v = 0.0;
    if res0 >= 9223372036854775808 {
        v = -f64(wrapping_sub(u64(0), res0));
    } else {
        v = f64(res0);
    }
    return SinReduced{x: v * f64_from_bits(4330529880027704600), n: n};
}
fn sincosf_poly(x: f64, x2: f64, row: u64, n: u64) -> f32 {
    if (n & 1) == 0 {
        x3 := x * x2;
        s1 := fma_rn(x2, sc(row, 13), sc(row, 12));
        x7 := x3 * x2;
        s := fma_rn(x3, sc(row, 11), x);
        return f32(fma_rn(x7, s1, s));
    }
    x4 := x2 * x2;
    c2 := fma_rn(x2, sc(row, 10), sc(row, 9));
    c1 := fma_rn(x2, sc(row, 7), sc(row, 6));
    x6 := x4 * x2;
    c := fma_rn(x4, sc(row, 8), c1);
    return f32(fma_rn(x6, c2, c));
}
// sinf when `cosine` is false, cosf when true (cosf is sinf a quadrant on).
fn sincosf_eval(y: f32, cosine: bool) -> f32 {
    mut odd = 0;
    if cosine {
        odd = 1;
    }
    x := f64(y);
    a := f32_top(y);
    if a < 1012 {
        if a < 920 {
            if cosine {
                return 1.0;
            }
            return y;
        }
        return sincosf_poly(x, x * x, 0, odd);
    }
    if a >= 2040 {
        return (y - y) / (y - y);
    }
    mut red = SinReduced{x: 0.0, n: 0};
    mut q = 0;
    if a < 1071 {
        red = sinf_reduce_fast(x);
        q = red.n;
    } else {
        word := f32_bits(y);
        red = sinf_reduce_large(word);
        q = (red.n + (word >> 31)) & 3;
    }
    mut row = 0;
    if (q & 2) != 0 {
        row = 1;
    }
    return sincosf_poly(red.x * sc(0, q & 3), red.x * red.x, row, red.n ^ odd);
}

@no_block
pub fn sinf(x: f32) -> f32 {
    return sincosf_eval(x, false);
}

@no_block
pub fn cosf(x: f32) -> f32 {
    return sincosf_eval(x, true);
}

// Single precision powf and asinf, bit for bit what glibc computes.
//
// powf is sysdeps/ieee754/flt-32/e_powf.c: log2_inline over __powf_log2_data, then exp2_inline
// over __exp2f_data. x86-64 libm resolves powf through an ifunc and this host has FMA/AVX2, so
// the FMA build is the one that runs: every `a * b + c` the C source writes as a single
// expression is a fused multiply-add here. asinf is e_asinf.c, CORE-MATH's correctly rounded
// arc-sine (Sibidanov), over its b[], C0 and C1 tables; it is correctly rounded in either build.
// A C prototype of these steps matched the host libm on all 2^32 asinf inputs and on millions of
// random (x, y) pairs for powf, special values included.
//
// Both tables are packed hex text, 16 digits a word: POWF_LOG2_DATA is __powf_log2_data's 16
// (invc, logc) pairs and then its 5 poly coefficients; ASINF_DATA is asinf's b[16], then C0[12]
// and C1[12].
static POWF_LOG2_DATA: string = "";
static ASINF_DATA: string = "";

fn powf_log2_data(i: u64) -> u64 {
    // Indexed in place: passing the static to a helper would view it, which allocates.
    at := 16 * i;
    mut word = 0;
    for j in 16 {
        d := POWF_LOG2_DATA[at + j];
        mut v = d - 48;
        if d >= 97 {
            v = d - 87;
        }
        word = (word << 4) | v;
    }
    return word;
}
fn asinf_data(i: u64) -> u64 {
    // Indexed in place: passing the static to a helper would view it, which allocates.
    at := 16 * i;
    mut word = 0;
    for j in 16 {
        d := ASINF_DATA[at + j];
        mut v = d - 48;
        if d >= 97 {
            v = d - 87;
        }
        word = (word << 4) | v;
    }
    return word;
}
// Two times a 32-bit word: powf's special cases classify x and y by 2*ix, as uint32 wraps.
fn dbl32(v: u64) -> u64 {
    return (2 * v) & 4294967295;
}
// True for a signaling NaN: a NaN whose quiet bit is clear.
fn f32_signaling(x: f32) -> bool {
    b := f32_bits(x);
    return ((b & 2147483647) > 2139095040) && ((b & 4194304) == 0);
}
// checkint: 0 when y is not an integer, 1 when it is odd, 2 when it is even (a finite non-zero
// float's bits).
fn powf_checkint(iy: u64) -> u64 {
    e := (iy >> 23) & 255;
    if e < 127 {
        return 0;
    }
    if e > 150 {
        return 2;
    }
    if (iy & ((1 << (150 - e)) - 1)) != 0 {
        return 0;
    }
    if (iy & (1 << (150 - e))) != 0 {
        return 1;
    }
    return 2;
}
// True for +-0, +-inf and NaN.
fn powf_zeroinfnan(ix: u64) -> bool {
    return (wrapping_sub(dbl32(ix), 1) & 4294967295) >= 4278190079;
}
// log2_inline: x = 2^k z with z in [OFF, 2*OFF], then
// log2(x) = log1p(z/c-1)/ln2 + log2(c) + k, the polynomial pipelined.
fn powf_log2(ix: u64) -> f64 {
    tmp := wrapping_sub(ix, 1060306944) & 4294967295;
    i := (tmp >> 19) % 16;
    top := tmp & 4286578688;
    iz := wrapping_sub(ix, top) & 4294967295;
    k := sext32(top) >> 23;
    invc := f64_from_bits(powf_log2_data(2 * i));
    logc := f64_from_bits(powf_log2_data(2 * i + 1));
    z := f64(f32_from_bits(iz));
    r := fma_rn(z, invc, -1.0);
    y0 := logc + f64(k);
    r2 := r * r;
    mut y = fma_rn(f64_from_bits(powf_log2_data(32)), r, f64_from_bits(powf_log2_data(33)));
    p := fma_rn(f64_from_bits(powf_log2_data(34)), r, f64_from_bits(powf_log2_data(35)));
    r4 := r2 * r2;
    mut q = fma_rn(f64_from_bits(powf_log2_data(36)), r, y0);
    q = fma_rn(p, r2, q);
    y = fma_rn(y, r4, q);
    return y;
}
// exp2_inline, the unscaled (no-toint) path: 2^(k/32) from __exp2f_data.tab times a cubic in r.
// sign_bias folds a negative sign into the result by adding 2^63 to the exponent word.
fn powf_exp2(xd: f64, sign_bias: u64) -> f64 {
    shift := f64_from_bits(4821103401100115968);
    mut kd = xd + shift;
    ki := bits(kd);
    kd = kd - shift;
    r := xd - kd;
    s := f64_from_bits(wrapping_add(exp2f_tab(ki % 32), wrapping_add(ki, sign_bias) << 47));
    z := fma_rn(f64_from_bits(4588159735035929492), r, f64_from_bits(4597823162434634995));
    r2 := r * r;
    mut y = fma_rn(f64_from_bits(4604418534314627798), r, 1.0);
    y = fma_rn(z, r2, y);
    return y * s;
}

@no_block

// The coefficient `i` of asinf's table whose base word is `tab` (0 b[], 16 C0, 28 C1).
fn asinf_coef(tab: u64, i: u64) -> f64 {
    return f64_from_bits(asinf_data(tab + i));
}
// CORE-MATH's poly12 over C0 (the middle range) or C1 (near +-1).
fn asinf_poly12(z: f64, tab: u64) -> f64 {
    z2 := z * z;
    z4 := z2 * z2;
    mut c0 = asinf_coef(tab, 0) + z * asinf_coef(tab, 1);
    c2 := asinf_coef(tab, 2) + z * asinf_coef(tab, 3);
    mut c4 = asinf_coef(tab, 4) + z * asinf_coef(tab, 5);
    c6 := asinf_coef(tab, 6) + z * asinf_coef(tab, 7);
    mut c8 = asinf_coef(tab, 8) + z * asinf_coef(tab, 9);
    c10 := asinf_coef(tab, 10) + z * asinf_coef(tab, 11);
    c0 += c2 * z2;
    c4 += c6 * z2;
    c8 += z2 * c10;
    c0 += z4 * (c4 + z4 * c8);
    return c0;
}

@no_block
pub fn asinf(x: f32) -> f32 {
    ax := dbl32(f32_bits(x));
    if ax > 2130706432 {
        // |x| > 1: NaN (a NaN passes through as x + x).
        if ax > 4278190080 {
            return x + x;
        }
        return f32_from_bits(2143289344);
    }
    xs := f64(x);
    if ax < 2124484608 {
        if ax < 1929379840 {
            // |x| < 115 << 24: fmaf(x, 0x1p-25, x). x * (1 + 2^-25) is exact in double (24
            // significant bits plus 25 more, and no underflow), so rounding that product to f32
            // once is the same fused rounding - two-step float arithmetic is not.
            return f32(xs * 1.0000000298023223876953125);
        }
        // |x| below 0x1.cp-3: the 16-term b[] polynomial, taken only when both ends of a
        // one-ulp-in-double bound round to the same float.
        z := xs;
        z2 := z * z;
        z4 := z2 * z2;
        z8 := z4 * z4;
        z16 := z8 * z8;
        p0 := (asinf_coef(0, 0) + z2 * asinf_coef(0, 1)) + z4 * (asinf_coef(0, 2) + z2 * asinf_coef(0, 3));
        p1 := (asinf_coef(0, 4) + z2 * asinf_coef(0, 5)) + z4 * (asinf_coef(0, 6) + z2 * asinf_coef(0, 7));
        p2 := (asinf_coef(0, 8) + z2 * asinf_coef(0, 9)) + z4 * (asinf_coef(0, 10) + z2 * asinf_coef(0, 11));
        p3 := (asinf_coef(0, 12) + z2 * asinf_coef(0, 13)) + z4 * (asinf_coef(0, 14) + z2 * asinf_coef(0, 15));
        r := z * ((p0 + z8 * p1) + z16 * (p2 + z8 * p3));
        ub := f32(r);
        lb := f32(r - z * f64_from_bits(4471786970770571264));
        if ub == lb {
            return ub;
        }
    }
    if ax < 2113929216 {
        // |x| below 0x7e<<24: asin(x) = x + x^3 P(x^2).
        z := xs;
        z2 := z * z;
        return f32(z + (z * z2) * asinf_poly12(z2, 16));
    }
    if ax == 2119526538 {
        // copysignf(0x1.75b8a2p-1, x) + copysignf(0x1p-26, x): the one input in this range whose
        // correctly rounded result the C1 route below does not produce.
        if xs < 0.0 {
            return -f32_from_bits(1060822097) - f32_from_bits(847249408);
        }
        return f32_from_bits(1060822097) + f32_from_bits(847249408);
    }
    if ax == 2115007540 {
        if xs < 0.0 {
            return -f32_from_bits(1057990066) - f32_from_bits(847249408);
        }
        return f32_from_bits(1057990066) + f32_from_bits(847249408);
    }
    // Near +-1: asin(x) = pi/2 - sqrt(1-|x|) P(1-|x|), the sign restored afterwards.
    z := 1.0 - xs.abs();
    s := z.sqrt();
    mut r = f64_from_bits(4609753056924675352) - s * asinf_poly12(z, 28);
    if xs < 0.0 {
        r = -r;
    }
    return f32(r);
}

// ---- the methods ------------------------------------------------------------------------------

// ---------------------------------------------------------------------------------------------
// expm1, log1p and tanh: fdlibm's s_expm1.c, s_log1p.c and s_tanh.c, the code glibc's dbl-64
// versions are, operation for operation, so a port matches the C library bit for bit. expm1(x) is
// e^x - 1 and log1p(x) is ln(1 + x) without the cancellation of writing them that way near zero.

fn high_word(x: f64) -> u64 { return bits(x) >> 32; }
fn set_high_word(x: f64, h: u64) -> f64 { return f64_from_bits((h << 32) | (bits(x) & 4294967295)); }
// x * 2^k by adding to the exponent field, as fdlibm's `SET_HIGH_WORD(y, high + (k << 20))`.
fn add_exponent(x: f64, k: i64) -> f64 {
    if k >= 0 {
        return f64_from_bits(wrapping_add(bits(x), u64(k) << 52));
    }
    return f64_from_bits(wrapping_sub(bits(x), u64(0 - k) << 52));
}

@no_block
pub fn expm1(x0: f64) -> f64 {
    mut x = x0;
    hx_all := high_word(x);
    xsb := hx_all & 2147483648;
    hx := hx_all & 2147483647;
    // Filter out huge and non-finite arguments.
    if hx >= 1078159482 {
        if hx >= 1082535490 {
            if hx >= 2146435072 {
                if (((hx & 1048575) | (bits(x) & 4294967295)) != 0) {
                    return x + x;
                }
                if xsb == 0 { return x; }
                return -1.0;
            }
            if x > 7.09782712893383973096e+02 {
                return 1.0e300 * 1.0e300;
            }
        }
        if xsb != 0 {
            if x + 1.0e-300 < 0.0 {
                return 1.0e-300 - 1.0;
            }
        }
    }
    mut k: i64 = 0;
    mut c = 0.0;
    if hx > 1071001154 {
        mut hi = 0.0;
        mut lo = 0.0;
        if hx < 1072734898 {
            if xsb == 0 {
                hi = x - 6.93147180369123816490e-01;
                lo = 1.90821492927058770002e-10;
                k = 1;
            } else {
                hi = x + 6.93147180369123816490e-01;
                lo = -1.90821492927058770002e-10;
                k = -1;
            }
        } else {
            mut half = 0.5;
            if xsb != 0 { half = -0.5; }
            k = i64(1.44269504088896338700e+00 * x + half);
            t := f64(k);
            hi = x - t * 6.93147180369123816490e-01;
            lo = t * 1.90821492927058770002e-10;
        }
        x = hi - lo;
        c = (hi - x) - lo;
    } else if hx < 1016070144 {
        t := 1.0e300 + x;
        return x - (t - (1.0e300 + x));
    }
    hfx := 0.5 * x;
    hxs := x * hfx;
    r1 := 1.0 + hxs * (-3.33333333333331316428e-02 + hxs * (1.58730158725481460165e-03 + hxs * (-7.93650757867487942473e-05 + hxs * (4.00821782732936239552e-06 + hxs * -2.01099218183624371326e-07))));
