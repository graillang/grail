@no_block
pub fn tanh(x: f64) -> f64 {
    jx := high_word(x);
    ix := jx & 2147483647;
    negative := (jx & 2147483648) != 0;
    if ix >= 2146435072 {
        if negative { return 1.0 / x - 1.0; }
        return 1.0 / x + 1.0;
    }
    mut z = 0.0;
    if ix < 1077280768 {
        if ix < 1015021568 {
            return x * (1.0 + x);
        }
        if ix >= 1072693248 {
            t := expm1(2.0 * x.abs());
            z = 1.0 - 2.0 / (t + 2.0);
        } else {
            t := expm1(-2.0 * x.abs());
            z = -t / (t + 2.0);
        }
    } else {
        z = 1.0 - 1.0e-300;
    }
    if negative { return -z; }
    return z;
}

// powf as a function, for a caller that writes `math::powf(x, y)`: the f32 method below.
pub fn powf(x: f32, y: f32) -> f32 { return x.pow(y); }

// `x.sin()`, `y.atan2(x)`, `x.powi(3)`: the functions above as methods of f64 and f32, next to the
// compiler's own `sqrt`, `abs`, `floor`, `ceil`, `trunc`, `round`, `min` and `max`. An f32 method
// is the f32 routine where this module has one (sinf, expf, powf, ...), and otherwise the f64
// routine rounded once to f32.
impl f64 {
    @no_block
    pub fn sin(self) -> f64 { return sin(self); }
    @no_block
    pub fn cos(self) -> f64 { return cos(self); }
    @no_block
    pub fn tan(self) -> f64 { return tan(self); }
    @no_block
    pub fn asin(self) -> f64 { return asin(self); }
    @no_block
    pub fn acos(self) -> f64 { return acos(self); }
    @no_block
    pub fn atan(self) -> f64 { return atan(self); }
    // The angle of the point (other, self): `y.atan2(x)`, as Rust writes it.
    @no_block
    pub fn atan2(self, other: f64) -> f64 { return atan2(self, other); }
    @no_block
    pub fn exp(self) -> f64 { return exp(self); }
    @no_block
    pub fn exp2(self) -> f64 { return pow(2.0, self); }
    @no_block
    pub fn ln(self) -> f64 { return ln(self); }
    @no_block
    pub fn log2(self) -> f64 { return log2(self); }
    @no_block
    pub fn log10(self) -> f64 { return log10(self); }
    @no_block
    pub fn pow(self, exponent: f64) -> f64 { return pow(self, exponent); }
    @no_block
    pub fn powi(self, exponent: i64) -> f64 { return powi(self, exponent); }
    @no_block
    pub fn hypot(self, other: f64) -> f64 { return hypot(self, other); }
    // e^self - 1 and ln(1 + self), exact near zero where the plain forms cancel (Rust's names).
    @no_block
    pub fn exp_m1(self) -> f64 { return expm1(self); }
    @no_block
    pub fn ln_1p(self) -> f64 { return log1p(self); }
    @no_block
    pub fn tanh(self) -> f64 { return tanh(self); }
    // The remainder of self / other with the sign of self, like C's fmod and Rust's `%` on floats.
    @no_block
    pub fn fmod(self, other: f64) -> f64 { return fmod(self, other); }
}
