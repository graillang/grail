}

pub fn thread_join(thread: Thread) -> u64 |? Error {
    mut out = LengthOut { value: 0 };
    mut status: i64 = 0;
    unsafe {
        status = grail_os_thread_join(thread, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out.value;
}

pub fn thread_detach(thread: Thread) -> unit |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_os_thread_detach(thread);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}
