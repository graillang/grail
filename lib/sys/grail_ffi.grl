// First Grail-facing wrappers over the C OS ABI.
//
// This module is deliberately under lib/sys/ rather than lib/: the current
// standard-library loader only auto-loads top-level lib/*.grl, so existing
// programs are unaffected until subdirectories are installed.  Pass
// lib/sys/grail_ffi.grl explicitly as a module.
//
// Ownership rules are documented in docs/design/grail-ffi-runtime.md:
//   - path/data arguments are call-scoped byte-view borrows;
//   - File, Socket, Process and Thread are opaque C-owned handles; call
//     close/socket_close/process_close or join/detach exactly once;
//   - out-records are Grail-owned storage written by C for this call;
//   - C never returns a Grail-owned pointer or a view.

module sys_grail;

handle File;
handle Socket;
handle Process;
handle Thread;

extern "C" record LengthOut { value: u64 }
extern "C" record TimeOut { value: i64 }
extern "C" record Address {
    struct_size: u64,
    abi_version: u64,
    family: u64,
    port: u64,
    scope_id: u64,
    a0: u8,
    a1: u8,
    a2: u8,
    a3: u8,
    a4: u8,
    a5: u8,
    a6: u8,
    a7: u8,
    a8: u8,
    a9: u8,
    a10: u8,
    a11: u8,
    a12: u8,
    a13: u8,
    a14: u8,
    a15: u8
}

extern "C" record ProcessStatus {
    struct_size: u64,
    abi_version: u64,
    kind: u64,
    exit_code: i64,
    term_signal: i64
}

extern "C" record FileStat {
    struct_size: u64,
    abi_version: u64,
    kind: u64,
    flags: u64,
    size: u64,
    mode: u64,
    link_count: u64,
    device: u64,
    inode: u64,
    modified_ns: i64,
    accessed_ns: i64,
    created_ns: i64
}

// The object is built by tools/test-ffi-runtime.mjs from the Linux reference
// backend plus runtime/abi/ffi/grail_ffi_shim.c.
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_init() -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_shutdown() -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_file_open(
    path: &[u8], flags: u64, mode: u64
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_file_handle() -> File;
extern "C" lib "grail_ffi_linux.o" fn grail_os_file_read(
    file: File, buffer: &mut [u8], out: LengthOut
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_file_write(
    file: File, data: &[u8], out: LengthOut
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_file_close(file: File) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_file_stat(
    file: File, out: FileStat
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_time_now(
    clock: u64, out: TimeOut
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_env_get(
    name: &[u8], out: &mut [u8]
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_env_set(
    name: &[u8], value: &[u8]
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_socket_create(
    family: u64, socket_type: u64
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_socket_handle() -> Socket;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_socket_accept(listener: Socket) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_socket_bind(
    socket: Socket, address: Address
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_socket_listen(
    socket: Socket, backlog: u64
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_socket_connect(
    socket: Socket, address: Address
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_socket_send(
    socket: Socket, data: &[u8], out: LengthOut
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_socket_recv(
    socket: Socket, buffer: &mut [u8], out: LengthOut
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_socket_shutdown(
    socket: Socket, how: u64
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_socket_close(socket: Socket) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_socket_local_address(
    socket: Socket, out: Address
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_socket_peer_address(
    socket: Socket, out: Address
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_process_spawn(
    program: &[u8], arguments: &[u8]
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_process_handle() -> Process;
extern "C" lib "grail_ffi_linux.o" fn grail_os_process_wait(
    process: Process, out: ProcessStatus
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_process_id(
    process: Process, out: LengthOut
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_process_close(process: Process) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_thread_spawn(
    entry: cfn(u64) -> u64, user: u64
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_ffi_thread_handle() -> Thread;
extern "C" lib "grail_ffi_linux.o" fn grail_os_thread_join(
    thread: Thread, out: LengthOut
) -> i64;
extern "C" lib "grail_ffi_linux.o" fn grail_os_thread_detach(thread: Thread) -> i64;

pub enum Error { Status(i64) }

impl Error {
    pub fn code(self: (&Error)) -> i64 {
        match self {
            Status(status) => {
                return status;
            }
        }
    }

    pub fn is_transient(self: (&Error)) -> bool {
        code := self.code();
        return code == -16 || code == -17 || code == -15 || code == -14;
    }
}

pub const OPEN_READ: u64 = 1;
pub const OPEN_WRITE: u64 = 2;
pub const OPEN_CREATE: u64 = 4;
pub const OPEN_TRUNCATE: u64 = 8;
pub const OPEN_APPEND: u64 = 16;
pub const OPEN_EXCLUSIVE: u64 = 32;
pub const CLOCK_MONOTONIC: u64 = 0;
pub const CLOCK_REALTIME: u64 = 1;
pub const ABI_VERSION: u64 = 4294967296;
pub const ADDRESS_INET: u64 = 1;
pub const SOCKET_STREAM: u64 = 1;
pub const SHUTDOWN_READ: u64 = 1;
pub const SHUTDOWN_WRITE: u64 = 2;
pub const SHUTDOWN_BOTH: u64 = 3;
pub const ERROR_INVALID_ARGUMENT: i64 = -1;
pub const PROCESS_EXITED: u64 = 0;
pub const PROCESS_SIGNALED: u64 = 1;
pub const PROCESS_STILL_ACTIVE: u64 = 2;

pub fn init() -> unit |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_ffi_init();
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}

pub fn shutdown() -> unit |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_ffi_shutdown();
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}

pub fn open(path: &[u8], flags: u64, mode: u64) -> File |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_ffi_file_open(path, flags, mode);
    }
    if status < 0 {
        return Error::Status(status);
    }
    unsafe {
        return grail_ffi_file_handle();
    }
}

pub fn read(file: File, buffer: &mut [u8]) -> u64 |? Error {
    mut out = LengthOut { value: 0 };
    mut status: i64 = 0;
    unsafe {
        status = grail_os_file_read(file, buffer, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out.value;
}

pub fn write(file: File, data: &[u8]) -> u64 |? Error {
    mut out = LengthOut { value: 0 };
    mut status: i64 = 0;
    unsafe {
        status = grail_os_file_write(file, data, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out.value;
}

pub fn read_bytes(file: File, capacity: u64) -> u8[] |? Error {
    mut buffer = u8[];
    mut i = 0;
    while i < capacity {
        buffer.push(0);
        i = i + 1;
    }
    count := read(file, &mut buffer)?;
    mut out = u8[];
    for i in count {
        out.push(buffer[i]);
    }
    return out;
}

pub fn close(file: File) -> unit |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_os_file_close(file);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}

pub fn stat(file: File) -> FileStat |? Error {
    mut out = FileStat {
        struct_size: 0,
        abi_version: 0,
        kind: 0,
        flags: 0,
        size: 0,
        mode: 0,
        link_count: 0,
        device: 0,
        inode: 0,
        modified_ns: 0,
        accessed_ns: 0,
        created_ns: 0
    };
    mut status: i64 = 0;
    unsafe {
        status = grail_os_file_stat(file, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out;
}

pub fn size(file: File) -> u64 |? Error {
    metadata := stat(file)?;
    return metadata.size;
}

pub fn now(clock: u64) -> i64 |? Error {
    mut out = TimeOut { value: 0 };
    mut status: i64 = 0;
    unsafe {
        status = grail_os_time_now(clock, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out.value;
}

pub fn monotonic() -> i64 |? Error {
    return now(CLOCK_MONOTONIC)?;
}

pub fn wall() -> i64 |? Error {
    return now(CLOCK_REALTIME)?;
}

pub fn env_get(name: &[u8], out: &mut [u8]) -> u64 |? Error {
    mut length: i64 = 0;
    unsafe {
        length = grail_os_env_get(name, out);
    }
    if length < 0 {
        return Error::Status(length);
    }
    return u64(length);
}

pub fn env_get_bytes(name: &[u8], capacity: u64) -> u8[] |? Error {
    mut buffer = u8[];
    mut i = 0;
    while i < capacity {
        buffer.push(0);
        i = i + 1;
    }
    length := env_get(name, &mut buffer)?;
    mut out = u8[];
    for i in length {
        out.push(buffer[i]);
    }
    return out;
}

pub fn env_set(name: &[u8], value: &[u8]) -> unit |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_os_env_set(name, value);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}


fn empty_address() -> Address {
    return Address {
        struct_size: 56,
        abi_version: ABI_VERSION,
        family: ADDRESS_INET,
        port: 0,
        scope_id: 0,
        a0: 0,
        a1: 0,
        a2: 0,
        a3: 0,
        a4: 0,
        a5: 0,
        a6: 0,
        a7: 0,
        a8: 0,
        a9: 0,
        a10: 0,
        a11: 0,
        a12: 0,
        a13: 0,
        a14: 0,
        a15: 0
    };
}

// Only a loopback constructor is exposed; the socket tests never open a
// non-loopback connection.
pub fn loopback(port: u64) -> Address {
    mut address = empty_address();
    address.port = port;
    address.a0 = 127;
    address.a3 = 1;
    return address;
}

pub fn tcp() -> Socket |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_ffi_socket_create(ADDRESS_INET, SOCKET_STREAM);
    }
    if status < 0 {
        return Error::Status(status);
    }
    unsafe {
        return grail_ffi_socket_handle();
    }
}

fn is_loopback(address: (&Address)) -> bool {
    return address.family == ADDRESS_INET &&
        address.a0 == 127 && address.a1 == 0 && address.a2 == 0 && address.a3 == 1 &&
        address.a4 == 0 && address.a5 == 0 && address.a6 == 0 && address.a7 == 0 &&
        address.a8 == 0 && address.a9 == 0 && address.a10 == 0 && address.a11 == 0 &&
        address.a12 == 0 && address.a13 == 0 && address.a14 == 0 && address.a15 == 0;
}

pub fn bind(socket: Socket, address: Address) -> unit |? Error {
    if !is_loopback(&address) {
        return Error::Status(ERROR_INVALID_ARGUMENT);
    }
    mut status: i64 = 0;
    unsafe {
        status = grail_os_socket_bind(socket, address);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}

pub fn listen(socket: Socket, backlog: u64) -> unit |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_os_socket_listen(socket, backlog);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}

pub fn accept(listener: Socket) -> Socket |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_ffi_socket_accept(listener);
    }
    if status < 0 {
        return Error::Status(status);
    }
    unsafe {
        return grail_ffi_socket_handle();
    }
}

pub fn connect(socket: Socket, address: Address) -> unit |? Error {
    if !is_loopback(&address) {
        return Error::Status(ERROR_INVALID_ARGUMENT);
    }
    mut status: i64 = 0;
    unsafe {
        status = grail_os_socket_connect(socket, address);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}

pub fn send(socket: Socket, data: &[u8]) -> u64 |? Error {
    mut out = LengthOut { value: 0 };
    mut status: i64 = 0;
    unsafe {
        status = grail_os_socket_send(socket, data, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out.value;
}

pub fn recv(socket: Socket, buffer: &mut [u8]) -> u64 |? Error {
    mut out = LengthOut { value: 0 };
    mut status: i64 = 0;
    unsafe {
        status = grail_os_socket_recv(socket, buffer, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out.value;
}

pub fn recv_bytes(socket: Socket, capacity: u64) -> u8[] |? Error {
    mut buffer = u8[];
    mut i = 0;
    while i < capacity {
        buffer.push(0);
        i = i + 1;
    }
    count := recv(socket, &mut buffer)?;
    mut out = u8[];
    for i in count {
        out.push(buffer[i]);
    }
    return out;
}

pub fn socket_shutdown(socket: Socket, how: u64) -> unit |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_os_socket_shutdown(socket, how);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}

pub fn socket_close(socket: Socket) -> unit |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_os_socket_close(socket);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}

pub fn local_address(socket: Socket) -> Address |? Error {
    mut out = empty_address();
    mut status: i64 = 0;
    unsafe {
        status = grail_os_socket_local_address(socket, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out;
}

pub fn peer_address(socket: Socket) -> Address |? Error {
    mut out = empty_address();
    mut status: i64 = 0;
    unsafe {
        status = grail_os_socket_peer_address(socket, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out;
}

pub fn local_port(socket: Socket) -> u64 |? Error {
    address := local_address(socket)?;
    return address.port;
}

pub fn peer_port(socket: Socket) -> u64 |? Error {
    address := peer_address(socket)?;
    return address.port;
}


// `arguments` is NUL-separated and excludes argv[0]; the shim prepends
// `program` and builds the full offset-addressed vector.  Child stdio is
// inherited and the environment is the runtime's.
pub fn spawn(program: &[u8], arguments: &[u8]) -> Process |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_ffi_process_spawn(program, arguments);
    }
    if status < 0 {
        return Error::Status(status);
    }
    unsafe {
        return grail_ffi_process_handle();
    }
}

pub fn wait(process: Process) -> ProcessStatus |? Error {
    mut out = ProcessStatus {
        struct_size: 40,
        abi_version: ABI_VERSION,
        kind: PROCESS_STILL_ACTIVE,
        exit_code: 0,
        term_signal: 0
    };
    mut status: i64 = 0;
    unsafe {
        status = grail_os_process_wait(process, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out;
}

pub fn process_id(process: Process) -> u64 |? Error {
    mut out = LengthOut { value: 0 };
    mut status: i64 = 0;
    unsafe {
        status = grail_os_process_id(process, out);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return out.value;
}

pub fn process_close(process: Process) -> unit |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_os_process_close(process);
    }
    if status < 0 {
        return Error::Status(status);
    }
    return ();
}

pub fn thread_spawn(entry: cfn(u64) -> u64, user: u64) -> Thread |? Error {
    mut status: i64 = 0;
    unsafe {
        status = grail_ffi_thread_spawn(entry, user);
