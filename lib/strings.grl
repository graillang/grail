module strings;
use core;
use iter;

// Byte-oriented text helpers. Inputs are read-only views (`&text`); results are new values.
pub fn starts_with<a,b>(text:&a [u8],prefix:&b [u8])->bool{
    if text.len()<prefix.len(){return false;}for i in prefix.len(){if text[i]!=prefix[i]{return false;}}return true;
}
pub fn ends_with<a,b>(text:&a [u8],suffix:&b [u8])->bool{
    if text.len()<suffix.len(){return false;}d:=text.len()-suffix.len();for i in suffix.len(){if text[d+i]!=suffix[i]{return false;}}return true;
}
// Index of the first occurrence of needle, or None.
pub fn find<a,b>(text:&a [u8],needle:&b [u8])->u64?{
    if needle.len()==0{return Some(0);}if text.len()<needle.len(){return None;}
    for i in text.len()-needle.len()+1{mut same=true;for j in needle.len(){if text[i+j]!=needle[j]{same=false;break;}}if same{return Some(i);}}
    return None;
}
pub fn contains<a,b>(text:&a [u8],needle:&b [u8])->bool{if let Some(i) = find(text,needle) {return true;}return false;}
pub fn split<a>(text:&a [u8],separator:u64)->u8[][]{
    mut parts=u8[][];mut current=u8[];
    for b in text{if b==separator{parts.push(current);current=u8[];}else{current.push(b);}}
    parts.push(current);return parts;
}
pub fn trim<a>(text:&a [u8])->u8[]{
    mut start=0;mut end=text.len();
    while start<end{b:=text[start];if (b!=32)&(b!=9)&(b!=10)&(b!=13){break;}start+=1;}
    while start<end{b:=text[end-1];if (b!=32)&(b!=9)&(b!=10)&(b!=13){break;}end-=1;}
    mut out=u8[];for i in start..end{out.push(text[i]);}return out;
}
pub fn join_with<a,b>(parts:(&a u8[][]),separator:&b [u8])->u8[]{
    mut out=u8[];for i in parts.len(){if i>0{for b in separator{out.push(b);}}part:=&parts[i];for b in part{out.push(b);}}return out;
}
pub fn to_upper<a>(text:&a [u8])->u8[]{mut out=u8[];for b in text{if (b>=97)&(b<=122){out.push(b-32);}else{out.push(b);}}return out;}
pub fn to_lower<a>(text:&a [u8])->u8[]{mut out=u8[];for b in text{if (b>=65)&(b<=90){out.push(b+32);}else{out.push(b);}}return out;}
// Decimal digits only; None for empty input, other characters or overflow.
pub fn parse_u64<a>(text:&a [u8])->u64?{
    if text.len()==0{return None;}mut value=0;
    for b in text{if (b<48)||(b>57){return None;}if value>1844674407370955161{return None;}
        next:=value*10;if next>18446744073709551615-(b-48){return None;}value=next+(b-48);}
    return Some(value);
}
// The same parser under its historical name, used by existing callers.
pub fn parse_num<a>(text:&a [u8])->u64?{return parse_u64(text);}
// An optional '-' or '+', then decimal digits; None for bad input or a value outside i64.
pub fn parse_i64<a>(text:&a [u8])->i64?{
    if text.len()==0{return None;}
    mut start=0;mut negative=false;
    if text[0]==45{negative=true;start=1;}else{if text[0]==43{start=1;}}
    if start==text.len(){return None;}
    mut magnitude=0;
    for i in start..text.len(){
        b:=text[i];if (b<48)||(b>57){return None;}
        if magnitude>922337203685477580{return None;}
        next:=magnitude*10;if next>18446744073709551615-(b-48){return None;}
        magnitude=next+(b-48);
    }
    if negative{
        if magnitude>9223372036854775808{return None;}
        if magnitude==9223372036854775808{return Some(i64(0)-i64(9223372036854775807)-i64(1));}
        return Some(i64(0)-i64(magnitude));
    }
    if magnitude>9223372036854775807{return None;}
    return Some(i64(magnitude));
}
// Decimal text of an unsigned value.
pub fn from_u64(value:u64)->string{
    if value==0{return "0".text();}
    mut digits=u8[];mut rest=value;
    while rest>0{digits.push(u8(rest%10)+48);rest=rest/10;}
    mut out=u8[];mut i=digits.len();
    while i>0{i-=1;out.push(digits[i]);}
    return out.text();
}
// Decimal text of a signed value, with a minus sign when negative.
pub fn from_i64(value:i64)->string{
    if value>=0{return from_u64(u64(value));}
    mut digits=u8[];mut rest=value;
    while rest<0{
        digit:=0-(rest%10);digits.push(u8(digit)+48);rest=rest/10;
    }
    digits.push(45);
    mut out=u8[];mut i=digits.len();
    while i>0{i-=1;out.push(digits[i]);}
    return out.text();
}

// ---- UTF-8 -------------------------------------------------------------------------------------
// Grail text is bytes; these helpers read them as UTF-8 and follow Rust's `str` API: the same strict
// validation (overlong forms, surrogates, scalars above U+10FFFF and truncated sequences are
// rejected) and the same replacement policy for invalid input - one U+FFFD for each *maximal
// subpart*, the longest prefix of a well-formed sequence plus the byte that broke it (Unicode's
// recommended practice, what Rust's `from_utf8_lossy` does).

// The sequence length a leading byte starts, or 0 when no sequence can start with it.
pub fn utf8_width(lead: u8) -> u64 {
    if lead < 128 { return 1; }
    if (lead >= 194) && (lead <= 223) { return 2; }
    if (lead >= 224) && (lead <= 239) { return 3; }
    if (lead >= 240) && (lead <= 244) { return 4; }
    return 0;
}
// Whether `byte` is a UTF-8 continuation byte (10xxxxxx).
fn continuation(byte: u8) -> bool {
    return (byte & 192) == 128;
}
// One decoding step from the bytes at hand: (value, bytes consumed, 1 when they were a valid
// sequence). Invalid input consumes its maximal subpart: 1 byte for a bad lead or a bad first
// continuation byte, 2 for a bad third byte, 3 for a bad fourth, and the bytes that are there when
// the input ends early.
fn step_at(lead: u8, b1: u8, b2: u8, b3: u8, left: u64) -> (char, u64, u64) {
    w := utf8_width(lead);
    if w == 1 { return (char(u64(lead)), 1, 1); }
    if w == 0 { return (char(65533), 1, 0); }
    if left < 2 { return (char(65533), 1, 0); }
    mut low = 128;
    mut high = 191;
    if lead == 224 { low = 160; }  // E0 80..9F would be overlong
    if lead == 237 { high = 159; } // ED A0..BF would be a surrogate
    if lead == 240 { low = 144; }  // F0 80..8F would be overlong
    if lead == 244 { high = 143; } // F4 90..BF would be above U+10FFFF
    if (b1 < low) || (b1 > high) { return (char(65533), 1, 0); }
    if w == 2 { return (char(u64(lead & 31) * 64 + u64(b1 & 63)), 2, 1); }
    if left < 3 { return (char(65533), 2, 0); }
    if !continuation(b2) { return (char(65533), 2, 0); }
    if w == 3 { return (char(u64(lead & 15) * 4096 + u64(b1 & 63) * 64 + u64(b2 & 63)), 3, 1); }
    if left < 4 { return (char(65533), 3, 0); }
    if !continuation(b3) { return (char(65533), 3, 0); }
    v := u64(lead & 7) * 262144 + u64(b1 & 63) * 4096 + u64(b2 & 63) * 64 + u64(b3 & 63);
    return (char(v), 4, 1);
}
fn decode_at<a>(text: &a [u8], at: u64) -> (char, u64, u64) {
    left := text.len() - at;
    mut b1 = u8(0);
    mut b2 = u8(0);
    mut b3 = u8(0);
    if left > 1 { b1 = u8(text[at + 1]); }
    if left > 2 { b2 = u8(text[at + 2]); }
    if left > 3 { b3 = u8(text[at + 3]); }
    return step_at(u8(text[at]), b1, b2, b3, left);
}
// The same step over bytes an iterator owns (a `&u8[]`); kept apart from `decode_at` so neither
// path allocates a view per character.
fn decode_owned<a>(bytes: &a u8[], at: u64) -> (char, u64, u64) {
    left := bytes.len() - at;
    mut b1 = u8(0);
    mut b2 = u8(0);
    mut b3 = u8(0);
    if left > 1 { b1 = u8(bytes[at + 1]); }
    if left > 2 { b2 = u8(bytes[at + 2]); }
    if left > 3 { b3 = u8(bytes[at + 3]); }
    return step_at(u8(bytes[at]), b1, b2, b3, left);
}
// Whether every byte is part of a well-formed UTF-8 sequence.
pub fn is_utf8<a>(text: &a [u8]) -> bool {
    mut at = 0;
    len := text.len();
    while at < len {
        step := decode_at(text, at);
        if step.2 == 0 { return false; }
        at = at + step.1;
    }
    return true;
}
// The byte offset where the first ill-formed sequence starts, or None for valid UTF-8.
pub fn utf8_error<a>(text: &a [u8]) -> u64? {
    mut at = 0;
    len := text.len();
    while at < len {
        step := decode_at(text, at);
        if step.2 == 0 { return Some(at); }
        at = at + step.1;
    }
    return None;
}
// Every code point in order, lazily; invalid sequences decode to U+FFFD by maximal subpart.
// The iterator owns a copy of the bytes: an `iter::Iter<T>` carries no lifetime, so Grail cannot
// keep a borrow of the argument alive inside it (Rust's `str::chars` borrows instead).
pub fn chars<a>(text: &a [u8]) -> iter::Iter<char> {
    mut bytes = text.copy();
    mut at = 0;
    return iter::from_fn(|| -> char? {
        if at >= bytes.len() { return None; }
        step := decode_owned(&bytes, at);
        at = at + step.1;
        return Some(step.0);
    });
}
// Every code point with the byte offset it starts at, lazily (byte offsets into `text`).
pub fn char_indices<a>(text: &a [u8]) -> iter::Iter<(u64, char)> {
    mut bytes = text.copy();
    mut at = 0;
    return iter::from_fn(|| -> (u64, char)? {
        if at >= bytes.len() { return None; }
        start := at;
        step := decode_owned(&bytes, at);
        at = at + step.1;
        return Some((start, step.0));
    });
}
pub fn char_count<a>(text: &a [u8]) -> u64 {
    mut at = 0;
    len := text.len();
    mut n = 0;
    while at < len {
        step := decode_at(text, at);
        at = at + step.1;
        n = n + 1;
    }
    return n;
}
// Whether offset `i` starts a character: 0, the end, or a byte that is not a continuation byte. A
// byte offset inside a multi-byte sequence is not a boundary, whatever the bytes say about validity.
pub fn is_char_boundary<a>(text: &a [u8], i: u64) -> bool {
    if i == 0 { return true; }
    if i >= text.len() { return i == text.len(); }
    return !continuation(text[i]);
}
// The bytes of the characters at [lo, hi): both offsets must be character boundaries, else the
// program stops with a runtime error naming the call site.
pub fn slice_chars<a>(text: &a [u8], lo: u64, hi: u64) -> &a [u8] {
    assert(is_char_boundary(text, lo) && is_char_boundary(text, hi) && (lo <= hi));
    return text[lo:hi];
}
// Appends the UTF-8 encoding of `c` to `out` (1 to 4 bytes).
pub fn encode_utf8<a>(c: char, out: (&a mut u8[])) {
    v := u64(c);
    if v < 128 { out.push(u8(v)); return (); }
    if v < 2048 {
        out.push(u8(192 + v / 64));
        out.push(u8(128 + v % 64));
        return ();
    }
    if v < 65536 {
        out.push(u8(224 + v / 4096));
        out.push(u8(128 + (v / 64) % 64));
        out.push(u8(128 + v % 64));
        return ();
    }
    out.push(u8(240 + v / 262144));
    out.push(u8(128 + (v / 4096) % 64));
    out.push(u8(128 + (v / 64) % 64));
    out.push(u8(128 + v % 64));
}
// `encode_utf8` with the buffer first, matching `out.push(...)`.
pub fn push_char<a>(out: (&a mut u8[]), c: char) {
    encode_utf8(c, out);
    return ();
}
pub fn replace<a,b,d>(text:&a [u8],from:&b [u8],to:&d [u8])->u8[]{
    mut out=u8[];if from.len()==0{for b in text{out.push(b);}return out;}mut i=0;
    while i<text.len(){
        mut hit=i+from.len()<=text.len();if hit{for j in from.len(){if text[i+j]!=from[j]{hit=false;break;}}}
        if hit{for b in to{out.push(b);}i+=from.len();}else{out.push(text[i]);i+=1;}
    }
    return out;
}
pub fn repeat<a>(text:&a [u8],count:u64)->u8[]{mut out=u8[];for i in count{for b in text{out.push(b);}}return out;}
