module strings;
use core;
use iter;
use float;
use bytes;

// Byte-oriented text helpers, as methods on `[u8]` (any byte text: a byte vector, a string, a view
// or a slice reads the same way). A value receiver is viewed for the call, so `bytes.find(x)` and
// `view(bytes).find(x)` are the same call.
//
// `starts_with`, `ends_with`, `replace`, `repeat`, `chars`, `to_upper`, `to_lower` and `contains`
// are the compiler's own methods on byte text; the rest live here, including `split`, `trim`,
// `lines` and `split_whitespace`, which return views of the text rather than copies.

impl [u8] {
    // Index of the first occurrence of `needle`, or None.
    pub fn find(&self, needle: (&[u8])) -> u64? {
        if needle.len() == 0 {
            return Some(0);
        }
        if self.len() < needle.len() {
            return None;
        }
        for i in self.len() - needle.len() + 1 {
            mut same = true;
            for j in needle.len() {
                if self[i + j] != needle[j] {
                    same = false;
                    break;
                }
            }
            if same {
                return Some(i);
            }
        }
        return None;
    }
    // Decimal digits only; None for empty input, other characters or overflow.
    pub fn parse_u64(&self) -> u64? {
        if self.len() == 0 {
            return None;
        }
        mut value = 0;
        for b in self {
            if (b < 48) || (b > 57) {
                return None;
            }
            if value > 1844674407370955161 {
                return None;
            }
            next := value * 10;
            if next > 18446744073709551615 - (b - 48) {
                return None;
            }
            value = next + (b - 48);
        }
        return Some(value);
    }
    // A decimal floating-point number, correctly rounded to the nearest double (ties to even), as
    // Rust's `str::parse::<f64>` reads it: an optional sign, then digits with an optional `.` (at
    // least one digit on one side of it), then an optional exponent `e`/`E` with an optional sign
    // and digits; or `inf`, `infinity` or `nan` in any case. A value beyond the largest double is an
    // infinity and one below the smallest subnormal is a zero, both with the sign. None for anything
    // else, including surrounding whitespace.
    pub fn parse_f64(&self) -> f64? {
        n := self.len();
        mut i: u64 = 0;
        mut negative = false;
        if (n != 0) && ((self[0] == 43) || (self[0] == 45)) {
            negative = self[0] == 45;
            i = 1;
        }
        if (i < n) && (((self[i] | 32) == 105) || ((self[i] | 32) == 110)) {
            rest := self[i: n];
            if strings::ascii_lower_is(rest, "inf") || strings::ascii_lower_is(rest, "infinity") {
                return Some(float::from_bits_signed(float::INFINITY_BITS, negative));
            }
            if strings::ascii_lower_is(rest, "nan") {
                return Some(float::from_bits_signed(9221120237041090560, negative));
            }
            return None;
        }
        int_start := i;
        while (i < n) && (self[i] >= 48) && (self[i] <= 57) {
            i += 1;
        }
        int_end := i;
        mut frac_start = i;
        mut frac_end = i;
        if (i < n) && (self[i] == 46) {
            i += 1;
            frac_start = i;
            while (i < n) && (self[i] >= 48) && (self[i] <= 57) {
                i += 1;
            }
            frac_end = i;
        }
        if (int_end == int_start) && (frac_end == frac_start) {
            return None;
        }
        mut exponent: i64 = 0;
        if (i < n) && ((self[i] == 101) || (self[i] == 69)) {
            i += 1;
            mut exp_negative = false;
            if (i < n) && ((self[i] == 43) || (self[i] == 45)) {
                exp_negative = self[i] == 45;
                i += 1;
            }
            if (i == n) || (self[i] < 48) || (self[i] > 57) {
                return None;
            }
            // Saturate: anything this large is out of range or zero whatever the digits.
            while (i < n) && (self[i] >= 48) && (self[i] <= 57) {
                if exponent < 1000000000000i64 {
                    exponent = exponent * 10 + i64(self[i] - 48);
                }
                i += 1;
            }
            if exp_negative {
                exponent = -exponent;
            }
        }
        if i != n {
            return None;
        }
        magnitude := float::digits_to_bits(self[int_start: int_end], self[frac_start: frac_end], exponent);
        return Some(float::from_bits_signed(magnitude, negative));
    }
    // An optional '-' or '+', then decimal digits; None for bad input or a value outside i64.
    pub fn parse_i64(&self) -> i64? {
        if self.len() == 0 {
            return None;
        }
        mut start = 0;
        mut negative = false;
        if self[0] == 45 {
            negative = true;
            start = 1;
        } else {
            if self[0] == 43 {
                start = 1;
            }
        }
        if start == self.len() {
            return None;
        }
        mut magnitude = 0;
        for i in start..self.len() {
            b := self[i];
            if (b < 48) || (b > 57) {
                return None;
            }
            if magnitude > 922337203685477580 {
                return None;
            }
            next := magnitude * 10;
            if next > 18446744073709551615 - (b - 48) {
                return None;
            }
            magnitude = next + (b - 48);
        }
        if negative {
            if magnitude > 9223372036854775808 {
                return None;
            }
            if magnitude == 9223372036854775808 {
                return Some(i64(0) - i64(9223372036854775807) - i64(1));
            }
            return Some(i64(0) - i64(magnitude));
        }
        if magnitude > 9223372036854775807 {
            return None;
        }
        return Some(i64(magnitude));
    }
    // ---- UTF-8 ---------------------------------------------------------------------------------
    // Grail text is bytes; these read them as UTF-8 and follow Rust's `str` API: the same strict
    // validation (overlong forms, surrogates, scalars above U+10FFFF and truncated sequences are
    // rejected) and the same replacement policy for invalid input - one U+FFFD for each *maximal
    // subpart*, the longest prefix of a well-formed sequence plus the byte that broke it (Unicode's
    // recommended practice, what Rust's `from_utf8_lossy` does).

    // Every code point in order, lazily: `for c in s.chars()`, `s.chars().count()`,
    // `s.chars().collect()`. Invalid sequences decode to U+FFFD by maximal subpart. The iterator owns
    // a copy of the bytes: an `iter::Iter<T>` carries no lifetime, so Grail cannot keep a borrow of
    // the text alive inside it (Rust's `str::chars` borrows instead).
    pub fn chars(&self) -> iter::Iter<char> {
        mut bytes = self.copy();
        mut at = 0;
        return iter::from_fn(|| -> char? {
            if at >= bytes.len() {
                return None;
            }
            step := decode_owned(&bytes, at);
            at = at + step.1;
            return Some(step.0);
        });
    }

    // Whether every byte is part of a well-formed UTF-8 sequence.
    pub fn is_utf8(&self) -> bool {
        mut at = 0;
        len := self.len();
        while at < len {
            step := decode_at(self, at);
            if step.2 == 0 {
                return false;
            }
            at = at + step.1;
        }
        return true;
    }
    // The byte offset where the first ill-formed sequence starts, or None for valid UTF-8.
    pub fn utf8_error(&self) -> u64? {
        mut at = 0;
        len := self.len();
        while at < len {
            step := decode_at(self, at);
            if step.2 == 0 {
                return Some(at);
            }
            at = at + step.1;
        }
        return None;
    }
    pub fn char_count(&self) -> u64 {
        mut at = 0;
        len := self.len();
        mut n = 0;
        while at < len {
            step := decode_at(self, at);
            at = at + step.1;
            n = n + 1;
        }
        return n;
    }
    // Whether offset `i` starts a character: 0, the end, or a byte that is not a continuation byte.
    // A byte offset inside a multi-byte sequence is not a boundary, whatever the bytes say about
    // validity.
    @no_alloc
    @no_block
    pub fn is_char_boundary(&self, i: u64) -> bool {
        if i == 0 {
            return true;
        }
        if i >= self.len() {
            return i == self.len();
        }
        return !continuation(self[i]);
    }
    // The bytes of the characters at [lo, hi): both offsets must be character boundaries, else the
    // program stops with a runtime error naming the call site.
    pub fn slice_chars(&self, lo: u64, hi: u64) -> (&[u8]) {
        assert(self.is_char_boundary(lo) && self.is_char_boundary(hi) && (lo <= hi));
        return self[lo:hi];
    }
    // Every code point with the byte offset it starts at, lazily.
    pub fn char_indices(&self) -> iter::Iter<(u64, char)> {
        mut bytes = self.copy();
        mut at = 0;
        return iter::from_fn(|| -> (u64, char)? {
            if at >= bytes.len() {
                return None;
            }
            start := at;
            step := decode_owned(&bytes, at);
            at = at + step.1;
            return Some((start, step.0));
        });
    }
    // `self` as owned string text, with one U+FFFD for each maximal ill-formed subpart. This is the
    // display form of bytes that may not be UTF-8 at all, such as a path or a line from a file:
    // nothing aborts, and nothing is silently dropped.
    pub fn to_text_lossy(&self) -> string {
        mut out = u8[];
        mut at = 0;
        len := self.len();
        while at < len {
            step := decode_at(self, at);
            out.push_char(step.0);
            at = at + step.1;
        }
        return out.text();
    }

    // ---- pieces of the text: views that borrow it, like Rust's `split`, `trim` and `lines` on
    // `str`. Each piece is a view into the receiver (a `string`, a byte vector or a view), so the
    // text must outlive the pieces and cannot change while they are live. `split_owned` copies
    // the pieces, for one that has to outlive the text (`piece.copy()` copies one).
    // The pieces between occurrences of the byte `sep`, in order: n separators give n + 1 pieces,
    // empty ones included ("a,,b" gives "a", "", "b"; "" gives one empty piece).
    pub fn split<a>(self: &a [u8], sep: u64) -> (&a [u8])[] {
        mut out = (&a [u8])[];
        n := self.len();
        mut start: u64 = 0;
        // Eight bytes per step to each separator (bytes::find_byte).
        while true {
            at := bytes::find_byte(self, start, sep);
            out.push(self[start: at]);
            if at == n {
                return out;
            }
            start = at + 1;
        }
        return out;
    }
    // `split` with each piece copied out.
    pub fn split_owned(&self, sep: u64) -> u8[][] {
        mut out = u8[][];
        n := self.len();
        mut start: u64 = 0;
        for i in n {
            if self[i] == sep {
                out.push(self[start: i].copy());
                start = i + 1;
            }
        }
        out.push(self[start: n].copy());
        return out;
    }
    // Without leading and trailing spaces, tabs, newlines and carriage returns.
    pub fn trim<a>(self: &a [u8]) -> (&a [u8]) {
        mut start: u64 = 0;
        mut end = self.len();
        while (start < end) && strings::blank(self[start]) {
            start += 1;
        }
        while (end > start) && strings::blank(self[end - 1]) {
            end -= 1;
        }
        return self[start: end];
    }
    pub fn trim_start<a>(self: &a [u8]) -> (&a [u8]) {
        mut start: u64 = 0;
        while (start < self.len()) && strings::blank(self[start]) {
            start += 1;
        }
        return self[start: self.len()];
    }
    pub fn trim_end<a>(self: &a [u8]) -> (&a [u8]) {
        mut end = self.len();
        while (end > 0) && strings::blank(self[end - 1]) {
            end -= 1;
        }
        return self[0: end];
    }
    // The lines, split at '\n' with the carriage return of a CRLF pair dropped. The last line has
    // no trailing newline; text that ends in a newline does not produce a final empty line.
    pub fn lines<a>(self: &a [u8]) -> (&a [u8])[] {
        mut out = (&a [u8])[];
        n := self.len();
        mut start: u64 = 0;
        while start < n {
            at := bytes::find_byte(self, start, 10);
            mut end = at;
            if (at < n) && (end > start) && (self[end - 1] == 13) {
                end -= 1;
            }
            out.push(self[start: end]);
            start = at + 1;
        }
        return out;
    }
    // The words, split at runs of spaces, tabs, newlines and carriage returns.
    pub fn split_whitespace<a>(self: &a [u8]) -> (&a [u8])[] {
        mut out = (&a [u8])[];
        n := self.len();
        mut start: u64 = 0;
        for i in n {
            if strings::blank(self[i]) {
                if i > start {
                    out.push(self[start: i]);
                }
                start = i + 1;
            }
        }
        if n > start {
            out.push(self[start: n]);
        }
        return out;
    }
}

// The runs of a byte vector.
impl u8[] {
    // `up_to`-sized runs of the bytes, in order; the last one may be shorter. No empty run is
    // produced, and `n == 0` gives an empty vector.
    pub fn chunks(&self, n: u64) -> u8[][] {
        mut out = u8[][];
        if n == 0 {
            return out;
        }
        mut at = 0;
        while at < self.len() {
            mut end = at + n;
            if end > self.len() {
                end = self.len();
            }
            mut part = u8[];
            for i in at..end {
                part.push(self[i]);
            }
            out.push(part);
            at = end;
        }
        return out;
    }
    // Every `n`-byte window of the bytes, in order: `len - n + 1` of them, or none when the vector
    // is shorter than the window.
    pub fn windows(&self, n: u64) -> u8[][] {
        mut out = u8[][];
        if (n == 0) || (self.len() < n) {
            return out;
        }
        for at in self.len() - n + 1 {
            mut part = u8[];
            for i in at..at + n {
                part.push(self[i]);
            }
            out.push(part);
        }
        return out;
    }
}

// Joining a vector of byte parts, with a separator between them.
impl u8[][] {
    pub fn join_with(&self, separator: (&[u8])) -> u8[] {
        mut out = u8[];
        for i in self.len() {
            if i > 0 {
                for b in separator {
                    out.push(b);
                }
            }
            part := &self[i];
            for b in part {
                out.push(b);
            }
        }
        return out;
    }
}

// The same for pieces that are views (what `split`, `lines` and `split_whitespace` give).
impl<a> (&a [u8])[] {
    pub fn join_with(&self, separator: (&[u8])) -> u8[] {
        mut out = u8[];
        for i in self.len() {
            if i > 0 {
                out.append(separator);
            }
            part := self[i];
            for b in part {
                out.push(b);
            }
        }
        return out;
    }
}

// ---- UTF-8 steps ------------------------------------------------------------------------------
// The sequence length a leading byte starts, or 0 when no sequence can start with it.
@no_alloc
@no_panic
@no_block
pub fn utf8_width(lead: u8) -> u64 {
    if lead < 128 {
        return 1;
    }
    if (lead >= 194) && (lead <= 223) {
        return 2;
    }
    if (lead >= 224) && (lead <= 239) {
        return 3;
    }
    if (lead >= 240) && (lead <= 244) {
        return 4;
    }
    return 0;
}
// Whether `byte` is a UTF-8 continuation byte (10xxxxxx).
fn continuation(byte: u8) -> bool {
    return (byte & 192) == 128;
}
// One decoding step from the bytes at hand: (value, bytes consumed, 1 when they were a valid
// sequence). Invalid input consumes its maximal subpart: 1 byte for a bad lead or a bad first
// continuation byte, 2 for a bad third byte, 3 for a bad fourth, and the bytes that are there when
// the input ends early.
fn step_at(lead: u8, b1: u8, b2: u8, b3: u8, left: u64) -> (char, u64, u64) {
    w := utf8_width(lead);
    if w == 1 {
        return (char(u64(lead)), 1, 1);
    }
    if w == 0 {
        return (char(65533), 1, 0);
    }
    if left < 2 {
        return (char(65533), 1, 0);
    }
    mut low = 128;
    mut high = 191;
    if lead == 224 {
        low = 160;
    }
    // E0 80..9F would be overlong
    if lead == 237 {
        high = 159;
    }
    // ED A0..BF would be a surrogate
    if lead == 240 {
        low = 144;
    }
    // F0 80..8F would be overlong
    if lead == 244 {
        high = 143;
    }
    // F4 90..BF would be above U+10FFFF
    if (b1 < low) || (b1 > high) {
        return (char(65533), 1, 0);
    }
    if w == 2 {
        return (char(u64(lead & 31) * 64 + u64(b1 & 63)), 2, 1);
    }
    if left < 3 {
        return (char(65533), 2, 0);
    }
    if !continuation(b2) {
        return (char(65533), 2, 0);
    }
    if w == 3 {
        return (char(u64(lead & 15) * 4096 + u64(b1 & 63) * 64 + u64(b2 & 63)), 3, 1);
    }
    if left < 4 {
        return (char(65533), 3, 0);
    }
    if !continuation(b3) {
        return (char(65533), 3, 0);
    }
    v := u64(lead & 7) * 262144 + u64(b1 & 63) * 4096 + u64(b2 & 63) * 64 + u64(b3 & 63);
    return (char(v), 4, 1);
}
fn decode_at<a>(text: (&a [u8]), at: u64) -> (char, u64, u64) {
    left := text.len() - at;
    mut b1 = u8(0);
    mut b2 = u8(0);
    mut b3 = u8(0);
    if left > 1 {
        b1 = u8(text[at + 1]);
    }
    if left > 2 {
        b2 = u8(text[at + 2]);
    }
    if left > 3 {
        b3 = u8(text[at + 3]);
    }
    return step_at(u8(text[at]), b1, b2, b3, left);
}
// The same step over bytes an iterator owns (a `&u8[]`); kept apart from `decode_at` so neither
// path allocates a view per character.
fn decode_owned<a>(bytes: (&a u8[]), at: u64) -> (char, u64, u64) {
    left := bytes.len() - at;
    mut b1 = u8(0);
    mut b2 = u8(0);
    mut b3 = u8(0);
    if left > 1 {
        b1 = u8(bytes[at + 1]);
    }
    if left > 2 {
        b2 = u8(bytes[at + 2]);
    }
    if left > 3 {
        b3 = u8(bytes[at + 3]);
    }
    return step_at(u8(bytes[at]), b1, b2, b3, left);
}

// Whether `text` is `word` (lowercase ASCII) in any case.
fn ascii_lower_is<a, b>(text: &a [u8], word: &b [u8]) -> bool {
    if text.len() != word.len() {
        return false;
    }
    for i in text.len() {
        mut b = text[i];
        if (b >= 65) && (b <= 90) {
            b += 32;
        }
        if b != word[i] {
            return false;
        }
    }
    return true;
}
// The bytes `trim` removes: space, tab, newline, carriage return.
fn blank(b: u64) -> bool {
    return (b == 32) || (b == 9) || (b == 10) || (b == 13);
}
