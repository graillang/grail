module socket;

use host;
use ip;
use io;
use order;

// ---- TCP and UDP over IPv4/IPv6, through libc's socket calls -----------------------------------
//
// `net` is the runtime's own socket layer: AF_INET only, and static-link friendly. This module is
// the other half - one address family per socket, `sockaddr_in6`, peer addresses and the dual-stack
// switch - and it gets them from the C library (`extern "C" lib "c"`), so a program that uses it is
// linked against libc. A build that cannot find `-lc` (a static cross build without a sysroot)
// cannot link it; build and test it where the host's libc is available.
//
// Every socket is created non-blocking, and every wait is a `poll` in one-millisecond slices with a
// deadline, so a waiting task suspends through `host::sleep_ms` and the other tasks on the worker keep
// running. Reads and writes go through `host::read_fd`/`host::write_fd`, which suspend the task on a
// descriptor the runtime did not create just as they do on one it did.
//
// A stream, a listener and a datagram socket each own one descriptor: `close` releases it, and a
// value that is simply dropped leaks it until the process exits (Grail has no destructor).

extern "C" lib "c" as "socket" fn c_socket(domain: i32, kind: i32, protocol: i32) -> i32;
extern "C" lib "c" as "bind" fn c_bind(fd: i32, addr: CPtr, len: u32) -> i32;
extern "C" lib "c" as "connect" fn c_connect(fd: i32, addr: CPtr, len: u32) -> i32;
extern "C" lib "c" as "listen" fn c_listen(fd: i32, backlog: i32) -> i32;
extern "C" lib "c" as "accept4" fn c_accept4(fd: i32, addr: CMutPtr, len: CMutPtr, flags: i32) -> i32;
extern "C" lib "c" as "getsockname" fn c_getsockname(fd: i32, addr: CMutPtr, len: CMutPtr) -> i32;
extern "C" lib "c" as "getpeername" fn c_getpeername(fd: i32, addr: CMutPtr, len: CMutPtr) -> i32;
extern "C" lib "c" as "setsockopt" fn c_setsockopt(fd: i32, level: i32, name: i32, value: CPtr, len: u32) -> i32;
extern "C" lib "c" as "getsockopt" fn c_getsockopt(fd: i32, level: i32, name: i32, value: CMutPtr, len: CMutPtr) -> i32;
extern "C" lib "c" as "sendto" fn c_sendto(fd: i32, data: &[u8], flags: i32, addr: CPtr, addrlen: u32) -> i64;
extern "C" lib "c" as "recvfrom" fn c_recvfrom(fd: i32, buffer: &mut [u8], flags: i32, addr: CMutPtr, addrlen: CMutPtr) -> i64;
extern "C" lib "c" as "poll" fn c_poll(fds: CMutPtr, count: u64, timeout: i32) -> i32;
extern "C" lib "c" as "memcpy" fn c_memcpy(dst: CMutPtr, src: CPtr, count: u64) -> CMutPtr;
extern "C" lib "c" as "__errno_location" fn c_errno_location() -> CPtr;
extern "C" lib "c" as "close" fn c_close(fd: i32) -> i32;

const AF_INET: u64 = 2;
const AF_INET6: u64 = 10;
const SOCK_STREAM: u64 = 1;
const SOCK_DGRAM: u64 = 2;
const SOCK_NONBLOCK: u64 = 2048;
const SOCK_CLOEXEC: u64 = 524288;
const SOL_SOCKET: u64 = 1;
const SO_ERROR: u64 = 4;
const SO_REUSEADDR: u64 = 2;
// IPPROTO_IPV6, the level IPV6_V6ONLY is set at (which is not AF_INET6).
const IPPROTO_IPV6: u64 = 41;
const IPV6_V6ONLY: u64 = 26;
const POLLIN: u64 = 1;
const POLLOUT: u64 = 4;
const EINPROGRESS: u64 = 115;
const EALREADY: u64 = 114;
const EAGAIN: u64 = 11;
const EINTR: u64 = 4;
const ETIMEDOUT: u64 = 110;
const ENOTCONN: u64 = 107;

// One open TCP connection.
pub struct Stream {
    fd: u64
}

// One listening TCP port.
pub struct Listener {
    fd: u64,
    family: u64,
    // 1 when the listener refuses IPv4 peers (IPV6_V6ONLY), 0 when it accepts them as mapped ones.
    v6_only: u64
}

// One UDP socket.
pub struct Datagram {
    fd: u64
}

// One received datagram and who sent it: what a server needs to answer.
pub struct Packet {
    count: u64,
    from: ip::Ip,
    port: u64
}

fn failure(errno: u64) -> io::Error {
    return io::from_errno(errno);
}

// The thread's errno, which the last failed C call set. Read immediately after the call: a C library
// call in between may overwrite it.
fn errno_now() -> u64 {
    mut cell = u8[0; 4];
    mut where: CPtr = cnull();
    unsafe {
        where = c_errno_location();
        c_memcpy(cptr_mut(&mut cell), where, 4);
    }
    return cell[0] + 256 * cell[1] + 65536 * cell[2] + 16777216 * cell[3];
}

// The bytes of `sockaddr_in` or `sockaddr_in6` for `addr`:`port`: what bind, connect and sendto take.
fn encode(addr: (&ip::Ip), port: u64) -> u8[] {
    mut out = u8[];
    family := addr.family();
    if family == 4 {
        for i in 16 {
            out.push(0);
        }
        out[0] = 2;
        out[1] = 0;
        // The port is network byte order: most significant byte first.
        out[2] = port / 256;
        out[3] = port % 256;
        match addr {
            V4(v4) => {
                octets := v4.octets();
                for i in 4 {
                    out[4 + i] = octets[i];
                }
            },
            V6(v6) => {
                return out;
            }
        }
        return out;
    }
    for i in 28 {
        out.push(0);
    }
    out[0] = AF_INET6 % 256;
    out[1] = AF_INET6 / 256;
    out[2] = port / 256;
    out[3] = port % 256;
    match addr {
        V4(v4) => {
            return out;
        },
        V6(v6) => {
            // The 16 address bytes, most significant first.
            hi := v6.hi;
            lo := v6.lo;
            out[8] = hi / 72057594037927936;
            out[9] = hi / 281474976710656 % 256;
            out[10] = hi / 1099511627776 % 256;
            out[11] = hi / 4294967296 % 256;
            out[12] = hi / 16777216 % 256;
            out[13] = hi / 65536 % 256;
            out[14] = hi / 256 % 256;
            out[15] = hi % 256;
            out[16] = lo / 72057594037927936;
            out[17] = lo / 281474976710656 % 256;
            out[18] = lo / 1099511627776 % 256;
            out[19] = lo / 4294967296 % 256;
            out[20] = lo / 16777216 % 256;
            out[21] = lo / 65536 % 256;
            out[22] = lo / 256 % 256;
            out[23] = lo % 256;
            // The zone becomes the scope id, which is what the kernel matches on.
            scope := v6.zone();
            out[24] = scope % 256;
            out[25] = scope / 256 % 256;
            out[26] = scope / 65536 % 256;
            out[27] = scope / 16777216 % 256;
        }
    }
    return out;
}

// The address in a `sockaddr` the kernel wrote, and 0 when it wrote something unrecognised.
fn decode(bytes: (&u8[])) -> ip::Ip? {
    if bytes.len() < 4 {
        return None;
    }
    family := bytes[0] + 256 * bytes[1];
    if family == 2 {
        if bytes.len() < 8 {
            return None;
        }
        bits := bytes[4] * 16777216 + bytes[5] * 65536 + bytes[6] * 256 + bytes[7];
        return Some(ip::Ip::V4(ip::Ipv4 { bits: bits }));
    }
    if family == 10 {
        if bytes.len() < 28 {
            return None;
        }
        hi := bytes[8] * 72057594037927936 + bytes[9] * 281474976710656 + bytes[10] * 1099511627776 + bytes[11] * 4294967296 + bytes[12] * 16777216 + bytes[13] * 65536 + bytes[14] * 256 + bytes[15];
        lo := bytes[16] * 72057594037927936 + bytes[17] * 281474976710656 + bytes[18] * 1099511627776 + bytes[19] * 4294967296 + bytes[20] * 16777216 + bytes[21] * 65536 + bytes[22] * 256 + bytes[23];
        zone := bytes[24] + bytes[25] * 256 + bytes[26] * 65536 + bytes[27] * 16777216;
        return Some(ip::Ip::V6(ip::Ipv6 { hi: hi, lo: lo, zone: zone }));
    }
    return None;
}

// The port a `sockaddr` names, in host order.
fn decode_port(bytes: (&u8[])) -> u64 {
    if bytes.len() < 4 {
        return 0;
    }
    return bytes[2] * 256 + bytes[3];
}

// Waits until `fd` is ready for `events` (POLLIN or POLLOUT), for at most `timeout_ms`. Each slice
// suspends the task, so a waiting read does not stop the other tasks on the worker.
fn ready(fd: u64, events: u64, timeout_ms: u64) -> bool {
    mut buf = u8[0; 8];
    buf[0] = fd % 256;
    buf[1] = fd / 256 % 256;
    buf[2] = fd / 65536 % 256;
    buf[3] = fd / 16777216 % 256;
    buf[4] = events % 256;
    deadline := host::now_ms() + timeout_ms;
    loop {
        mut ready_now: i32 = 0;
        unsafe {
            ready_now = c_poll(cptr_mut(&mut buf), 1, 0);
        }
        if ready_now > 0 {
            return true;
        }
        if host::now_ms() >= deadline {
            return false;
        }
        host::sleep_ms(1);
    }
}

// The pending error on a socket (SO_ERROR), which a completed non-blocking connect reports here.
fn pending_error(fd: u64) -> i64 {
    mut value = u8[0; 4];
    mut length = u8[0; 4];
    length[0] = 4;
    mut rc: i32 = 0;
    unsafe {
        rc = c_getsockopt(i32(fd), i32(SOL_SOCKET), i32(SO_ERROR), cptr_mut(&mut value), cptr_mut(&mut length));
    }
    if rc < 0 {
        return i64(rc);
    }
    return i64(value[0] + 256 * value[1] + 65536 * value[2] + 16777216 * value[3]);
}

fn open_socket(family: u64, kind: u64) -> i64 {
    mut domain = AF_INET;
    if family == 6 {
        domain = AF_INET6;
    }
    mut fd: i32 = 0;
    unsafe {
        fd = c_socket(i32(domain), i32(kind + SOCK_NONBLOCK + SOCK_CLOEXEC), 0);
    }
    return i64(fd);
}

// 1 when the socket has a peer (getpeername succeeds): what a completed connect established.
fn connected(fd: u64) -> bool {
    mut bytes = u8[0; 28];
    mut length = u8[0; 4];
    length[0] = 28;
    mut rc: i32 = 0;
    unsafe {
        rc = c_getpeername(i32(fd), cptr_mut(&mut bytes), cptr_mut(&mut length));
    }
    return rc == 0;
}

fn set_int_option(fd: u64, level: u64, name: u64, value: u64) -> bool {
    mut bytes = u8[0; 4];
    bytes[0] = value % 256;
    bytes[1] = value / 256 % 256;
    bytes[2] = value / 65536 % 256;
    bytes[3] = value / 16777216 % 256;
    mut rc: i32 = 0;
    unsafe {
        rc = c_setsockopt(i32(fd), i32(level), i32(name), cptr(&bytes), 4);
    }
    return rc == 0;
}

fn address_of(fd: u64, peer: bool) -> ip::Ip? {
    mut bytes = u8[0; 28];
    mut length = u8[0; 4];
    length[0] = 28;
    mut rc: i32 = 0;
    unsafe {
        if peer {
            rc = c_getpeername(i32(fd), cptr_mut(&mut bytes), cptr_mut(&mut length));
        } else {
            rc = c_getsockname(i32(fd), cptr_mut(&mut bytes), cptr_mut(&mut length));
        }
    }
    if rc != 0 {
        return None;
    }
    return decode(&bytes);
}

// Connects to `addr`:`port`, waiting for the handshake for at most `timeout_ms` (0 waits forever).
// A refusal or a timeout is an `io::Error`, like `net::connect`.
pub fn connect(addr: (&ip::Ip), port: u64, timeout_ms: u64) -> Stream |? io::Error {
    if port > 65535 {
        return failure(22);
    }
    family := addr.family();
    mut fd = open_socket(family, SOCK_STREAM);
    if fd < 0 {
        return failure(errno_now());
    }
    target := encode(addr, port);
    mut rc: i32 = 0;
    unsafe {
        rc = c_connect(i32(fd), cptr(&target), u32(target.len()));
    }
    if rc != 0 {
        errno := errno_now();
        if errno == EINPROGRESS || errno == EALREADY || errno == EINTR {
            // A non-blocking connect reports its result through poll and SO_ERROR.
            if !ready(fd, POLLOUT, timeout_ms) {
                unsafe {
                    c_close(i32(fd));
                }
                return failure(ETIMEDOUT);
            }
            pending := pending_error(fd);
            if pending != 0 {
                unsafe {
                    c_close(i32(fd));
                }
                return failure(u64(pending));
            }
            if !connected(fd) {
                unsafe {
                    c_close(i32(fd));
                }
                return failure(ENOTCONN);
            }
        } else {
            unsafe {
                c_close(i32(fd));
            }
            return failure(errno);
        }
    }
    return Stream { fd: u64(fd) };
}

// Listens on `addr`:`port`; port 0 asks the operating system for an unused port, which `port`
// reports. `addr` may be `::` for every interface (with IPv4 peers admitted as mapped addresses
// unless `v6_only` is set) or `0.0.0.0` for every IPv4 interface. `v6_only` is IPV6_V6ONLY: a
// dual-stack listener refuses it and accepts IPv4 peers as `::ffff:a.b.c.d`.
pub fn bind(addr: (&ip::Ip), port: u64, v6_only: bool) -> Listener |? io::Error {
    if port > 65535 {
        return failure(22);
    }
    family := addr.family();
    mut fd = open_socket(family, SOCK_STREAM);
    if fd < 0 {
        return failure(errno_now());
    }
    set_int_option(u64(fd), SOL_SOCKET, SO_REUSEADDR, 1);
    mut only = 0;
    if v6_only == true {
        only = 1;
    }
    if family == 6 {
        if !set_int_option(u64(fd), IPPROTO_IPV6, IPV6_V6ONLY, only) {
            errno := errno_now();
            unsafe {
                c_close(i32(fd));
            }
            return failure(errno);
        }
    } else {
        // An IPv4 listener is single-stack by construction.
        only = 1;
    }
    target := encode(addr, port);
    mut rc: i32 = 0;
    unsafe {
        rc = c_bind(i32(fd), cptr(&target), u32(target.len()));
    }
    if rc != 0 {
        errno := errno_now();
        unsafe {
            c_close(i32(fd));
        }
        return failure(errno);
    }
    mut listening: i32 = 0;
    unsafe {
        listening = c_listen(i32(fd), 128);
    }
    if listening != 0 {
        errno := errno_now();
        unsafe {
            c_close(i32(fd));
        }
        return failure(errno);
    }
    return Listener { fd: u64(fd), family: family, v6_only: u64(only) };
}

// A UDP socket bound to `addr`:`port` — what a server of its own needs; port 0 asks the operating
// system for an unused port, which the datagram reports as `bound_port`.
pub fn bound_datagram(addr: (&ip::Ip), port: u64, v6_only: bool) -> Datagram |? io::Error {
    opened := datagram(addr.family())?;
    mut only = 0;
    if v6_only == true {
        only = 1;
    }
    if addr.family() == 6 {
        set_int_option(opened.fd, IPPROTO_IPV6, IPV6_V6ONLY, only);
    }
    target := encode(addr, port);
    mut rc: i32 = 0;
    unsafe {
        rc = c_bind(i32(opened.fd), cptr(&target), u32(target.len()));
    }
    if rc != 0 {
        errno := errno_now();
        opened.close();
        return failure(errno);
    }
    return opened;
}

// A UDP socket for `family` (4 or 6).
pub fn datagram(family: u64) -> Datagram |? io::Error {
    mut fd = open_socket(family, SOCK_DGRAM);
    if fd < 0 {
        return failure(errno_now());
    }
    return Datagram { fd: u64(fd) };
}

impl Stream {
    // The underlying descriptor, for a host:: call this module does not wrap.
    pub fn fd(self: (&Stream)) -> u64 {
        return self.fd;
    }

    // Reads up to `buffer.len()` bytes; 0 means the peer closed the connection (or the wait timed
    // out first, which `timeout_ms` decides).
    pub fn read(self: (&mut Stream), buffer: (&mut u8[]), timeout_ms: u64) -> u64 {
        if !ready(self.fd, POLLIN, timeout_ms) {
            return 0;
        }
        data := host::read_fd(self.fd, buffer.len());
        count := data.len();
        mut i = 0;
        while i < count {
            buffer[i] = data[i];
            i += 1;
        }
        return count;
    }

    // Every byte until the peer closes the connection (or the wait times out).
    pub fn read_all(self: (&mut Stream), timeout_ms: u64) -> u8[] {
        mut out = u8[];
        loop {
            if !ready(self.fd, POLLIN, timeout_ms) {
                break;
            }
            data := host::read_fd(self.fd, 4096);
            count := data.len();
            if count == 0 {
                break;
            }
            for b in data {
                out.push(b);
            }
        }
        return out;
    }

    // Writes every byte; false means the connection failed partway and only a prefix was written.
    pub fn write_all(self: (&Stream), data: (&[u8])) -> bool {
        length := data.len();
        written := host::write_fd(self.fd, data);
        return written == length;
    }

    // The address at the other end, as the kernel reports it (an IPv4 peer of a dual-stack socket
    // reads as an IPv4-mapped IPv6 address).
    pub fn peer(self: (&Stream)) -> ip::Ip? {
        return address_of(self.fd, true);
    }

    // The local address of this connection.
    pub fn local(self: (&Stream)) -> ip::Ip? {
        return address_of(self.fd, false);
    }

    pub fn close(self: Stream) {
        host::close(self.fd);
        return ();
    }
}

impl Listener {
    // The port the listener is bound to (the operating system's choice when 0 was requested).
    pub fn port(self: (&Listener)) -> u64 {
        mut bytes = u8[0; 28];
        mut length = u8[0; 4];
        length[0] = 28;
        mut rc: i32 = 0;
        unsafe {
            rc = c_getsockname(i32(self.fd), cptr_mut(&mut bytes), cptr_mut(&mut length));
        }
        if rc != 0 {
            return 0;
        }
        return decode_port(&bytes);
    }

    // 6 for a listener that can take IPv6 peers, 4 for an IPv4-only one.
    pub fn family(self: (&Listener)) -> u64 {
        return self.family;
    }

    // 1 when the listener refuses IPv4 peers (IPV6_V6ONLY), 0 when it accepts them.
    pub fn v6_only(self: (&Listener)) -> u64 {
        return self.v6_only;
    }

    // Waits for the next connection, for at most `timeout_ms`.
    pub fn accept(self: (&Listener), timeout_ms: u64) -> Stream |? io::Error {
        loop {
            if !ready(self.fd, POLLIN, timeout_ms) {
                return failure(ETIMEDOUT);
            }
            mut peer = u8[0; 28];
            mut length = u8[0; 4];
            length[0] = 28;
            mut fd: i32 = 0;
            unsafe {
                fd = c_accept4(i32(self.fd), cptr_mut(&mut peer), cptr_mut(&mut length), i32(SOCK_NONBLOCK + SOCK_CLOEXEC));
            }
            if fd >= 0 {
                return Stream { fd: u64(fd) };
            }
            errno := errno_now();
            if errno != EAGAIN {
                if errno != EINTR {
                    return failure(errno);
                }
            }
        }
    }

    pub fn close(self: Listener) {
        host::close(self.fd);
        return ();
    }
}

impl Datagram {
    pub fn fd(self: (&Datagram)) -> u64 {
        return self.fd;
    }

    // The port this socket is bound to (the operating system's choice when 0 was requested).
    pub fn bound_port(self: (&Datagram)) -> u64 {
        mut bytes = u8[0; 28];
        mut length = u8[0; 4];
        length[0] = 28;
        mut rc: i32 = 0;
        unsafe {
            rc = c_getsockname(i32(self.fd), cptr_mut(&mut bytes), cptr_mut(&mut length));
        }
        if rc != 0 {
            return 0;
        }
        return decode_port(&bytes);
    }

    // Sends one datagram; false when the kernel refused it.
    pub fn send_to(self: (&Datagram), addr: (&ip::Ip), port: u64, data: (&[u8])) -> bool {
        target := encode(addr, port);
        mut sent: i64 = 0;
        unsafe {
            sent = c_sendto(i32(self.fd), data, 0, cptr(&target), u32(target.len()));
        }
        return sent == i64(data.len());
    }

    // One datagram and its sender, or none when the wait timed out.
    pub fn recv_packet(self: (&Datagram), buffer: (&mut u8[]), timeout_ms: u64) -> Packet? {
        if !ready(self.fd, POLLIN, timeout_ms) {
            return None;
        }
        mut source = u8[0; 28];
        mut length = u8[0; 4];
        length[0] = 28;
        mut got: i64 = 0;
        unsafe {
            got = c_recvfrom(i32(self.fd), buffer, 0, cptr_mut(&mut source), cptr_mut(&mut length));
        }
        if got < 0 {
            return None;
        }
        from := decode(&source);
        if from.is_none() {
            return None;
        }
        return Some(Packet { count: u64(got), from: from!, port: decode_port(&source) });
    }

    // One datagram, or 0 when the wait timed out (or the datagram was empty).
    pub fn recv_from(self: (&Datagram), buffer: (&mut u8[]), timeout_ms: u64) -> u64 {
        match self.recv_packet(buffer, timeout_ms) {
            Some(packet) => {
                return packet.count;
            },
            None => {
                return 0;
            }
        }
    }

    pub fn close(self: Datagram) {
        host::close(self.fd);
        return ();
    }
}
