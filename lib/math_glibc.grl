static POW_POLY: u64[] = u64[
    13826050856027422720, 13827552055903212896, 4602678819172646918,
    4605380978944857422, 13827552055900349562, 13831198063404271081,
    4607182605818150851
];

// e^(x), glibc's __exp: 2^(k/N) from the table times a degree-5 polynomial in the reduced
// argument, with a separate reconstruction when the result leaves the normal range.
@no_block
pub fn exp(x: f64) -> f64 {
    abstop := i64((bits(x) >> 52) & 2047);
    if abstop < 969 {
        // |x| < 2^-54: exp(x) rounds to 1 + x.
        return 1.0 + x;
    }
    mut subnormal = false;
    if abstop >= 1031 {
        if abstop >= 1033 {
            if bits(x) == bits(-1.0 / 0.0) {
                return 0.0;
            }
            if abstop >= 2047 {
                return 1.0 + x;
            }
            if (bits(x) >> 63) != 0 {
                return 0.0 * 0.0;
            }
            return (1.0 / 0.0) * (1.0 / 0.0);
        }
        subnormal = true;
    }
    z := from_u(INV_LN2_N) * x;
    mut kd = z + from_u(SHIFT);
    ki := bits(kd);
    kd = kd - from_u(SHIFT);
    mut r = x + kd * from_u(NEG_LN2_HI_N);
    r = r + kd * from_u(NEG_LN2_LO_N);
    idx := 2 * (ki % 128);
    top := ki << 45;
    tail := from_u(EXP_TAB[idx]);
    mut sbits = wadd(EXP_TAB[idx + 1], top);
    r2 := r * r;
    c2 := from_u(EXP_POLY[0]) + r * from_u(EXP_POLY[1]);
    c4 := from_u(EXP_POLY[2]) + r * from_u(EXP_POLY[3]);
    mut tmp = tail + r;
    tmp = fma(r2, c2, tmp);
    tmp = tmp + r2 * r2 * c4;
    if subnormal {
        mut y = 0.0;
        if (ki & 2147483648) == 0 {
            // A result too large for the normal range.
            sc := from_u(wsub(sbits, u64(1009) << 52));
            y = fma(sc, tmp, sc);
            return from_u(9151314442816847872) * y;
        }
        sc := from_u(wadd(sbits, u64(1022) << 52));
        y = fma(sc, tmp, sc);
        if y < 1.0 {
            mut lo = sc - y + sc * tmp;
            high := 1.0 + y;
            lo = (1.0 - high + y) + lo;
            y = (high + lo) - 1.0;
        }
        return from_u(4503599627370496) * y;
    }
    scale := from_u(sbits);
    return fma(scale, tmp, scale);
}

const LOG2_OFF: u64 = 4604367669032910848;
const LOG2_LO: u64 = 4606800540372828160;
const LOG2_HI: u64 = 4607381812656734208;

// log2(x), glibc's __log2: a table split with a degree-5 polynomial, and a separate series for x
// near 1 where the table's cancellation would cost accuracy.
@no_block
pub fn log2(x: f64) -> f64 {
    mut ix = bits(x);
    top := (ix >> 48) & 65535;
    if (ix >= LOG2_LO) && (ix - LOG2_LO < LOG2_HI - LOG2_LO) {
        if ix == bits(1.0) {
            return 0.0;
        }
        mut r = x - 1.0;
        r2 := r * r;
        r4 := r2 * r2;
        hi := r * from_u(INV_LN2_HI);
        mut lo = r * from_u(INV_LN2_LO) + fma(r, from_u(INV_LN2_HI), -hi);
        p0 := from_u(LOG2_POLY1[0]) + r * from_u(LOG2_POLY1[1]);
        pf := fma(r, from_u(LOG2_POLY1[1]), from_u(LOG2_POLY1[0]));
        y := fma(r2, pf, hi);
        lo = lo + fma(r2, p0, hi - y);
        a35 := fma(r2, from_u(LOG2_POLY1[4]) + r * from_u(LOG2_POLY1[5]), from_u(LOG2_POLY1[2]) + r * from_u(LOG2_POLY1[3]));
        a79 := fma(r2, from_u(LOG2_POLY1[8]) + r * from_u(LOG2_POLY1[9]), from_u(LOG2_POLY1[6]) + r * from_u(LOG2_POLY1[7]));
        lo = lo + r4 * fma(r4, a79, a35);
        return y + lo;
    }
    if (top < 16) || (top >= 32736) {
        if (ix == 0) || (ix == 9223372036854775808) {
            return -1.0 / 0.0;
        }
        if ix == bits(1.0 / 0.0) {
            return x;
        }
        if ((top & 32768) != 0) || ((top & 32752) == 32752) {
            return (x - x) / (x - x);
        }
        ix = wsub(bits(x * from_u(4841369599423283200)), u64(52) << 52);
    }
    tmp2 := wsub(ix, LOG2_OFF);
    tmp := tmp2;
    i := (tmp >> 46) % 64;
    k := as_i(tmp) >> 52;
    iz := wsub(ix, tmp & (u64(4095) << 52));
    invc := from_u(LOG2_TAB_INVC[i]);
    logc := from_u(LOG2_TAB_LOGC[i]);
    z := from_u(iz);
    mut kd = f64(k);
    mut r = fma(z, invc, -1.0);
    t1 := r * from_u(INV_LN2_HI);
    t2 := fma(r, from_u(INV_LN2_HI), -t1) + r * from_u(INV_LN2_LO);
    t3 := kd + logc;
    hi := t3 + t1;
    lo := (t3 - hi + t1) + t2;
    r2 := r * r;
    r4 := r2 * r2;
    q1 := fma(r, from_u(LOG2_POLY[1]), from_u(LOG2_POLY[0]));
    q3 := fma(r, from_u(LOG2_POLY[3]), from_u(LOG2_POLY[2]));
    q5 := fma(r, from_u(LOG2_POLY[5]), from_u(LOG2_POLY[4]));
    p := fma(r4, q5, fma(r2, q3, q1));
    return fma(r2, p, lo) + hi;
}

// ---------------------------------------------------------------------------------------------
// pow(x, y), glibc's __pow (sysdeps/ieee754/dbl-64/e_pow.c): log_inline over __pow_log_data and
// exp_inline over __exp_data, evaluated in double with the fused multiply-adds the FMA build of
// x86-64 libm performs. Which sites fuse is not a matter of reading the source (GCC contracts
// according to register pressure, so the same expression fuses in one instantiation and not in
// another): the sites below are the ones the compiler produced for *this* file's build, read off
// its own assembly and then confirmed by comparison against the host libm on 40 million pairs.
// The subnormal reconstruction is deliberately plain; the k > 0 saturation path fuses.

const POW_OFF: u64 = 4604531861337669632;      // 0x3fe6955500000000
const POW_SIGN_BIAS: u64 = 262144;             // 0x800 << EXP_TABLE_BITS

struct PowLog {
    hi: f64,
    tail: f64
}

// log_inline: x = 2^k z with z in [OFF, 2*OFF), split into 128 table intervals, then
// log(x) = k*ln2 + log(c) + log1p(z/c-1) with the polynomial pipelined and a trailing tail.
fn pow_log(ix: u64) -> PowLog {
    tmp := wsub(ix, POW_OFF);
    i := (tmp >> 45) % 128;
    k := as_i(tmp) >> 52;
    iz := wsub(ix, tmp & (u64(4095) << 52));
    z := from_u(iz);
    kd := f64(k);
    invc := from_u(POW_TAB_INVC[i]);
    logc := from_u(POW_TAB_LOGC[i]);
    logctail := from_u(POW_TAB_TAIL[i]);
    r := fma(z, invc, -1.0);
    t1 := fma(kd, from_u(LN2_HI), logc);
    t2 := t1 + r;
    lo1 := fma(kd, from_u(LN2_LO), logctail);
    lo2 := t1 - t2 + r;
    a0 := from_u(POW_POLY[0]);
    a1 := from_u(POW_POLY[1]);
    a2 := from_u(POW_POLY[2]);
    a3 := from_u(POW_POLY[3]);
    a4 := from_u(POW_POLY[4]);
    a5 := from_u(POW_POLY[5]);
    a6 := from_u(POW_POLY[6]);
    ar := a0 * r;
    ar2 := r * ar;
    ar3 := r * ar2;
    hi := t2 + ar2;
    lo3 := fma(ar, r, -ar2);
    lo4 := t2 - hi + ar2;
    q1 := fma(r, a2, a1);
    q2 := fma(r, a4, a3);
    q3 := fma(r, a6, a5);
    q4 := fma(ar2, q3, q2);
    q5 := fma(ar2, q4, q1);
    sum := ((lo1 + lo2) + lo3) + lo4;
    lo := fma(ar3, q5, sum);
    y := hi + lo;
    return PowLog{hi: y, tail: hi - y + lo};
}

// exp_inline: 2^(k/128) from __exp_data.tab times a degree-1/3 polynomial in the reduced argument,
// with a separate reconstruction when the result leaves the normal range. `xtail` carries log's
// trailing bits and `sign_bias` (0 or POW_SIGN_BIAS) folds in a negative sign.
fn pow_exp(x: f64, xtail: f64, sign_bias: u64) -> f64 {
    abstop := (bits(x) >> 52) & 2047;
    mut wide = false;
    if (abstop < 969) || (abstop >= 1032) {
        if abstop < 969 {
            // |x| < 2^-54: the result rounds to 1 + x.
            one := 1.0 + x;
            if sign_bias != 0 {
                return -one;
            }
            return one;
        }
        if abstop >= 1033 {
            // |x| >= 1024: an underflow to a signed zero or an overflow to a signed infinity.
            if (bits(x) >> 63) != 0 {
                if sign_bias != 0 {
                    return -0.0;
                }
                return 0.0;
            }
            if sign_bias != 0 {
                return -(1.0 / 0.0) * (1.0 / 0.0);
            }
            return (1.0 / 0.0) * (1.0 / 0.0);
        }
        // 1024 > |x| >= 512: the exponent words are handled below (the "specialcase" path).
        wide = true;
    }
    kd := fma(from_u(INV_LN2_N), x, from_u(SHIFT));
    ki := bits(kd);
    km := kd - from_u(SHIFT);
    mut r = fma(km, from_u(NEG_LN2_HI_N), x);
    r = fma(km, from_u(NEG_LN2_LO_N), r);
    r = r + xtail;
    idx := 2 * (ki % 128);
    top := wadd(ki, sign_bias) << 45;
    tail := from_u(EXP_TAB[idx]);
    mut sbits = wadd(EXP_TAB[idx + 1], top);
    r2 := r * r;
    a := fma(r, from_u(EXP_POLY[1]), from_u(EXP_POLY[0]));
    b := fma(r, from_u(EXP_POLY[3]), from_u(EXP_POLY[2]));
    mut tmp = tail + r;
    tmp = fma(r2, a, tmp);
    tmp = fma(r2 * r2, b, tmp);
    if wide {
        // specialcase(): the exponent of scale may have overflowed into the sign bit.
        if (ki & 2147483648) == 0 {
            // A result too large for the normal range; this step is fused.
            scale := from_u(wsub(sbits, u64(1009) << 52));
            y := fma(scale, tmp, scale);
            return y * from_u(9151314442816847872);
        }
        // A result in the subnormal range: round y back to the right precision first, all plain.
        // `sbits` is signed from here on, and the zero fix-up below reads this mutated word.
        sbits = wadd(sbits, u64(1022) << 52);
        scale := from_u(sbits);
        mut y = scale + scale * tmp;
        if y.abs() < 1.0 {
            mut one = 1.0;
            if y < 0.0 {
                one = -1.0;
            }
            lo := (scale - y) + scale * tmp;
            hi := one + y;
            lo2 := ((one - hi) + y) + lo;
            y = (hi + lo2) - one;
            if y == 0.0 {
                y = from_u(sbits & 9223372036854775808);
            }
        }
        return from_u(4503599627370496) * y;
    }
    scale := from_u(sbits);
    return fma(scale, tmp, scale);
}

// A signaling NaN: a NaN whose quiet bit is clear. Read with f64_bits: bits() reports every NaN
// as the canonical quiet one, which would hide exactly this.
fn pow_signaling(x: f64) -> bool {
    ix := f64_bits(x);
    return ((ix & 9218868437227405312) == 9218868437227405312)
        && ((ix & 4503599627370495) != 0) && ((ix & 2251799813685248) == 0);
}
// checkint: 0 when y is not an integer, 1 when it is odd, 2 when it is even.
fn pow_checkint(iy: u64) -> u64 {
    e := (iy >> 52) & 2047;
    if e < 1023 {
        return 0;
    }
    if e > 1075 {
        return 2;
    }
    if (iy & ((1 << (1075 - e)) - 1)) != 0 {
        return 0;
    }
    if (iy & (1 << (1075 - e))) != 0 {
        return 1;
    }
    return 2;
}
// True for +-0, +-inf and NaN.
fn pow_zeroinfnan(i: u64) -> bool {
    return wsub(wadd(i, i), 1) >= 18437736874454810623;
}
fn pow_twice(i: u64) -> u64 {
    return wadd(i, i);
}

@no_block
pub fn pow(x: f64, y: f64) -> f64 {
    mut sign_bias = u64(0);
    mut ix = bits(x);
    iy := bits(y);
    mut topx = (ix >> 52) & 65535;
    topy := (iy >> 52) & 65535;
    if (wsub(topx, 1) >= 2046) || (wsub(topy & 2047, 958) >= 128) {
        // Either x < 0x1p-1022 (so 0, subnormal, inf or nan) or |y| < 0x1p-65, |y| >= 0x1p63
        // or nan.
        if pow_zeroinfnan(iy) {
            if pow_twice(iy) == 0 {
                // y is zero: 1, except that a signaling x is quieted by x + y.
                if pow_signaling(x) {
                    return x + y;
                }
                return 1.0;
            }
            if ix == 4607182418800017408 {
                if pow_signaling(y) {
                    return x + y;
                }
                return 1.0;
            }
            if (pow_twice(ix) > 18437736874454810624) || (pow_twice(iy) > 18437736874454810624) {
                return x + y;
            }
            if pow_twice(ix) == 9214364837600034816 {
                return 1.0;
            }
            if (pow_twice(ix) < 9214364837600034816) == ((iy >> 63) == 0) {
                // |x| < 1 with y == inf, or |x| > 1 with y == -inf.
                return 0.0;
            }
            return y * y;
        }
        if pow_zeroinfnan(ix) {
            mut x2 = x * x;
            if ((ix >> 63) != 0) && (pow_checkint(iy) == 1) {
                x2 = -x2;
                sign_bias = 1;
            }
            if (pow_twice(ix) == 0) && ((iy >> 63) != 0) {
                // pow(+-0, negative): a signed infinity from glibc's __math_divzero.
                if sign_bias != 0 {
                    return -(1.0 / 0.0);
                }
                return 1.0 / 0.0;
            }
            if (iy >> 63) != 0 {
                return 1.0 / x2;
            }
            return x2;
        }
        // Here x and y are finite and non-zero.
        if (ix >> 63) != 0 {
            yi := pow_checkint(iy);
            if yi == 0 {
                // A negative x to a non-integer power: glibc's __math_invalid.
                return (x - x) / (x - x);
            }
            if yi == 1 {
                sign_bias = POW_SIGN_BIAS;
            }
            ix = ix & 9223372036854775807;
            topx = topx & 2047;
        }
        if wsub(topy & 2047, 958) >= 128 {
            // sign_bias is 0 here: y is not an odd integer.
            if ix == 4607182418800017408 {
                return 1.0;
            }
            if (topy & 2047) < 958 {
                // |y| < 2^-65: x^y is 1 + y*log(x) to the last bit.
                if ix > 4607182418800017408 {
                    return 1.0 + y;
                }
                return 1.0 - y;
            }
            if (ix > 4607182418800017408) == (topy < 2048) {
                return (1.0 / 0.0) * (1.0 / 0.0);
            }
            return 0.0 * 0.0;
        }
        if topx == 0 {
            // Normalize a subnormal x so its exponent becomes negative.
            ix = bits(x * from_u(4841369599423283200)) & 9223372036854775807;
            ix = wsub(ix, u64(52) << 52);
        }
    }
    lg := pow_log(ix);
    ehi := y * lg.hi;
    elo := fma(y, lg.tail, fma(y, lg.hi, -ehi));
    return pow_exp(ehi, elo, sign_bias);
}

// ---------------------------------------------------------------- sin / cos
//
// glibc 2.44's sin and cos: the IBM Accurate Mathematical Library's do_sin / do_cos over
// __sincostab (sincostab.c, 440 doubles), plus reduce_sincos for 2.426265 < |x| < 105414350.
// The engine's mover takes sin/cos of its yaw in radians, so that is the path every yaw takes;
// an argument at or beyond 105414350 (glibc's rem_pio2 branch, not carried here) answers NaN
// rather than a reduction this port does not have.
//
// On x86-64 glibc resolves sin/cos to the FMA build (s_sin.c through ifunc-avx-fma4.h with
// -mfma), so every a*b+c site below is the exactly rounded fma above.

const s1: f64 = -0.16666666666666666;
const s2: f64 = 0.008333333333332329;
const s3: f64 = -0.00019841269834414642;
const s4: f64 = 2.755729806860771e-06;
const s5: f64 = -2.5022014848318398e-08;
const sn3: f64 = -0.16666666666666488;
const sn5: f64 = 0.008333332142857223;
const cs2: f64 = 0.5;
const cs4: f64 = -0.04166666666666644;
const cs6: f64 = 0.001388888740079376;
const big: f64 = 52776558133248.0;
const hp0: f64 = 1.5707963267948966;
const hp1: f64 = 6.123233995736766e-17;
const mp1: f64 = 1.5707963407039642;
const mp2: f64 = -1.3909067564377153e-08;
const pp3: f64 = -4.97899623147991e-17;
const pp4: f64 = -1.9034889620193266e-25;
const hpinv: f64 = 0.6366197723675814;
const toint: f64 = 6755399441055744.0;

fn high_word(v: f64) -> u64 { return (bits(v) / 4294967296) & 4294967295; }

fn low_word(v: f64) -> u64 { return bits(v) & 4294967295; }

fn fabs_of(v: f64) -> f64 {
    if v < 0.0 { return -v; }
    return v;
}

fn copysign_of(magnitude: f64, sign_of: f64) -> f64 {
    mut b = bits(magnitude) & 9223372036854775807;
    if (bits(sign_of) & 9223372036854775808) != 0 { b = b | 9223372036854775808; }
    return f64_from_bits(b);
}

fn sincostab_bits() -> u64[] {
    return u64[
        0, 0, 4607182418800017408, 0,
        4575657129782734575, 13555348769362917244, 4607182143923508562, 4363787934786743726,
        4580160454536392405, 13547579073368098679, 4607181319310759071, 4360199296339566323,
        4582412002391175765, 4323172154323661622, 4607179945012099046, 4362553016938231741,
        4584662954719242351, 13563949304181312226, 4607178021111408595, 13583900207205620571,
