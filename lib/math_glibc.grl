fn sincostab(k: u64) -> f64 { return f64_from_bits(sincostab_bits()[k]); }

fn taylor_sin(xx: f64, x: f64, dx: f64) -> f64 {
    p := fma(fma(fma(fma(s5, xx, s4), xx, s3), xx, s2), xx, s1);
    t := fma(fma(p, x, -0.5 * dx), xx, dx);
    return x + t;
}

fn do_sin(x: f64, dx: f64) -> f64 {
    xold := x;
    if fabs_of(x) < 0.126 { return taylor_sin(x * x, x, dx); }
    mut dxh = dx;
    if x <= 0.0 { dxh = -dxh; }
    u := big + fabs_of(x);
    xl := fabs_of(x) - (u - big);
    xx := xl * xl;
    sn5x := fma(xx, sn5, sn3);
    s := xl + fma(xl * xx, sn5x, dxh);
    cs46 := fma(xx, cs6, cs4);
    cs246 := fma(xx, cs46, cs2);
    c := fma(xl, dxh, xx * cs246);
    k := low_word(u) << 2;
    sn := sincostab(k);
    ssn := sincostab(k + 1);
    cs := sincostab(k + 2);
    ccs := sincostab(k + 3);
    cor := fma(cs, s, fma(-sn, c, fma(s, ccs, ssn)));
    return copysign_of(sn + cor, xold);
}

fn do_cos(x: f64, dx: f64) -> f64 {
    mut dxh = dx;
    if x < 0.0 { dxh = -dxh; }
    u := big + fabs_of(x);
    xl := fabs_of(x) - (u - big) + dxh;
    xx := xl * xl;
    sn5x := fma(xx, sn5, sn3);
    s := fma(xl * xx, sn5x, xl);
    cs46 := fma(xx, cs6, cs4);
    cs246 := fma(xx, cs46, cs2);
    c := xx * cs246;
    k := low_word(u) << 2;
    sn := sincostab(k);
    ssn := sincostab(k + 1);
    cs := sincostab(k + 2);
    ccs := sincostab(k + 3);
    cor := fma(-sn, s, fma(-cs, c, fma(-s, ssn, ccs)));
    return cs + cor;
}

fn reduce_sincos(x: f64, a: (&mut f64), da: (&mut f64)) -> u64 {
    t := x * hpinv + toint;
    xn := t - toint;
    n := low_word(t) & 3;
    y := (x - xn * mp1) - xn * mp2;
    mut t1 = xn * pp3;
    t2 := y - t1;
    mut db = (y - t2) - t1;
    t1 = xn * pp4;
    b := t2 - t1;
    db = db + ((t2 - b) - t1);
    exchange(a, b);
    exchange(da, db);
    return n;
}

fn do_sincos(a: f64, da: f64, n: u64) -> f64 {
    mut retval = 0.0;
    if (n & 1) != 0 { retval = do_cos(a, da); } else { retval = do_sin(a, da); }
    if (n & 2) != 0 { return -retval; }
    return retval;
}

fn nan_of() -> f64 { return f64_from_bits(9221120237041090560); }

pub fn sin(x: f64) -> f64 {
    k := high_word(x) & 2147483647;
    if k < 1045430272 { return x; }
    if k < 1072390144 { return do_sin(x, 0.0); }
    if k < 1073965309 {
        t := hp0 - fabs_of(x);
        return copysign_of(do_cos(t, hp1), x);
    }
    if k < 1100554747 {
        mut a = 0.0;
        mut da = 0.0;
        n := reduce_sincos(x, &mut a, &mut da);
        return do_sincos(a, da, n);
    }
    return nan_of();
}

pub fn cos(x: f64) -> f64 {
    k := high_word(x) & 2147483647;
    if k < 1044381696 { return 1.0; }
    if k < 1072390144 { return do_cos(x, 0.0); }
    if k < 1073965309 {
        y := hp0 - fabs_of(x);
        a := y + hp1;
        da := (y - a) + hp1;
        return do_sin(a, da);
    }
    if k < 1100554747 {
        mut a = 0.0;
        mut da = 0.0;
        n := reduce_sincos(x, &mut a, &mut da);
        return do_sincos(a, da, n + 1);
    }
    return nan_of();
}
