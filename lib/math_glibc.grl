// e^(x), glibc's __exp: 2^(k/N) from the table times a degree-5 polynomial in the reduced
// argument, with a separate reconstruction when the result leaves the normal range.
@no_block
pub fn exp(x: f64) -> f64 {
    abstop := i64((bits(x) >> 52) & 2047);
    if abstop < 969 {
        // |x| < 2^-54: exp(x) rounds to 1 + x.
        return 1.0 + x;
    }
    mut subnormal = false;
    if abstop >= 1031 {
        if abstop >= 1033 {
            if bits(x) == bits(-1.0 / 0.0) {
                return 0.0;
            }
            if abstop >= 2047 {
                return 1.0 + x;
            }
            if (bits(x) >> 63) != 0 {
                return 0.0 * 0.0;
            }
            return (1.0 / 0.0) * (1.0 / 0.0);
        }
        subnormal = true;
    }
    z := from_u(INV_LN2_N) * x;
    mut kd = z + from_u(SHIFT);
    ki := bits(kd);
    kd = kd - from_u(SHIFT);
    mut r = x + kd * from_u(NEG_LN2_HI_N);
    r = r + kd * from_u(NEG_LN2_LO_N);
    idx := 2 * (ki % 128);
    top := ki << 45;
    tail := from_u(EXP_TAB[idx]);
    sbits := wadd(EXP_TAB[idx + 1], top);
    r2 := r * r;
    c2 := from_u(EXP_POLY[0]) + r * from_u(EXP_POLY[1]);
    c4 := from_u(EXP_POLY[2]) + r * from_u(EXP_POLY[3]);
    mut tmp = tail + r;
    tmp = fma(r2, c2, tmp);
    tmp = tmp + r2 * r2 * c4;
    if subnormal {
        mut y = 0.0;
        if (ki & 2147483648) == 0 {
            // A result too large for the normal range.
            sc := from_u(wsub(sbits, u64(1009) << 52));
            y = fma(sc, tmp, sc);
            return from_u(9151314442816847872) * y;
        }
        sc := from_u(wadd(sbits, u64(1022) << 52));
        y = fma(sc, tmp, sc);
        if y < 1.0 {
            mut lo = sc - y + sc * tmp;
            high := 1.0 + y;
            lo = (1.0 - high + y) + lo;
            y = (high + lo) - 1.0;
        }
        return from_u(4503599627370496) * y;
    }
    scale := from_u(sbits);
    return fma(scale, tmp, scale);
}

const LOG2_OFF: u64 = 4604367669032910848;
const LOG2_LO: u64 = 4606800540372828160;
const LOG2_HI: u64 = 4607381812656734208;

// log2(x), glibc's __log2: a table split with a degree-5 polynomial, and a separate series for x
// near 1 where the table's cancellation would cost accuracy.
@no_block
pub fn log2(x: f64) -> f64 {
    mut ix = bits(x);
    top := (ix >> 48) & 65535;
    if (ix >= LOG2_LO) && (ix - LOG2_LO < LOG2_HI - LOG2_LO) {
        if ix == bits(1.0) {
            return 0.0;
        }
        mut r = x - 1.0;
        r2 := r * r;
        r4 := r2 * r2;
        hi := r * from_u(INV_LN2_HI);
        mut lo = r * from_u(INV_LN2_LO) + fma(r, from_u(INV_LN2_HI), -hi);
        p0 := from_u(LOG2_POLY1[0]) + r * from_u(LOG2_POLY1[1]);
        pf := fma(r, from_u(LOG2_POLY1[1]), from_u(LOG2_POLY1[0]));
        y := fma(r2, pf, hi);
        lo = lo + fma(r2, p0, hi - y);
        a35 := fma(r2, from_u(LOG2_POLY1[4]) + r * from_u(LOG2_POLY1[5]), from_u(LOG2_POLY1[2]) + r * from_u(LOG2_POLY1[3]));
        a79 := fma(r2, from_u(LOG2_POLY1[8]) + r * from_u(LOG2_POLY1[9]), from_u(LOG2_POLY1[6]) + r * from_u(LOG2_POLY1[7]));
        lo = lo + r4 * fma(r4, a79, a35);
        return y + lo;
    }
    if (top < 16) || (top >= 32736) {
        if (ix == 0) || (ix == 9223372036854775808) {
            return -1.0 / 0.0;
        }
        if ix == bits(1.0 / 0.0) {
            return x;
        }
        if ((top & 32768) != 0) || ((top & 32752) == 32752) {
            return (x - x) / (x - x);
        }
        ix = wsub(bits(x * from_u(4841369599423283200)), u64(52) << 52);
    }
    tmp2 := wsub(ix, LOG2_OFF);
    tmp := tmp2;
    i := (tmp >> 46) % 64;
    k := as_i(tmp) >> 52;
    iz := wsub(ix, tmp & (u64(4095) << 52));
    invc := from_u(LOG2_TAB_INVC[i]);
    logc := from_u(LOG2_TAB_LOGC[i]);
    z := from_u(iz);
    mut kd = f64(k);
    mut r = fma(z, invc, -1.0);
    t1 := r * from_u(INV_LN2_HI);
    t2 := fma(r, from_u(INV_LN2_HI), -t1) + r * from_u(INV_LN2_LO);
    t3 := kd + logc;
    hi := t3 + t1;
    lo := (t3 - hi + t1) + t2;
    r2 := r * r;
    r4 := r2 * r2;
    q1 := fma(r, from_u(LOG2_POLY[1]), from_u(LOG2_POLY[0]));
    q3 := fma(r, from_u(LOG2_POLY[3]), from_u(LOG2_POLY[2]));
    q5 := fma(r, from_u(LOG2_POLY[5]), from_u(LOG2_POLY[4]));
    p := fma(r4, q5, fma(r2, q3, q1));
    return fma(r2, p, lo) + hi;
}

