module math_glibc;

// The double-precision elementary functions of glibc 2.44: `exp` (sysdeps/ieee754/dbl-64/
// e_exp.c), `log2` (e_log2.c) and `pow` (e_pow.c), the table-driven ARM optimized-routines
// implementations glibc ships. The engine calls the C library, so a port that wants bit-for-bit
// agreement must reproduce these and not an equivalent fdlibm formulation: fdlibm's results
// differ in the last bit on ordinary inputs.
//
// glibc compiles them with fused multiply-adds (`-ffp-contract=fast` on x86-64 with FMA), and the
// fused sites decide the last bit. Grail has no scalar fma, so `fma` below computes the exactly
// rounded `a*b + c` (Dekker's exact product, TwoSum and an odd-rounded sum: Boldo and Melquiond,
// "Emulation of FMA and correctly-rounded sums", 2008), and every site glibc fuses calls it. The
// fusion choices here were settled by exhaustive comparison against this host's libm.
//
// The tables are binary64 bit patterns exactly as glibc's data files define them.

// The exactly rounded a*b + c, for operands whose product is in the normal range (every step of
// these algorithms). Dekker splits give the product's leading and trailing halves without fma;
// TwoSum plus a round-to-odd addition then round once, as a fused operation would.


fn fma(a: f64, b: f64, c: f64) -> f64 {
    p := a * b;
    split := 134217729.0;
    ca := split * a;
    ah := ca - (ca - a);
    al := a - ah;
    cb := split * b;
    bh := cb - (cb - b);
    bl := b - bh;
    lo := ((ah * bh - p) + ah * bl + al * bh) + al * bl;
    if p == 0.0 {
        return a * b + c;
    }
    th := c + p;
    bb := th - c;
    tl := (c - (th - bb)) + (p - bb);
    return th + odd_sum(tl, lo);
}

// a + b with the sum made odd (its lowest bit set) when the exact sum is not representable, so the
// rounding of the final addition sees the true residual: the round-to-odd step of Boldo and
// Melquiond's fma emulation.
fn odd_sum(a: f64, b: f64) -> f64 {
    s := a + b;
    bb := s - a;
    e := (a - (s - bb)) + (b - bb);
    if (e != 0.0) && (s != 0.0) && ((bits(s) & 1) == 0) {
        if (e > 0.0) == (s > 0.0) {
            return f64_from_bits(bits(s) + 1);
        }
        return f64_from_bits(bits(s) - 1);
    }
    return s;
}

fn low(x: f64) -> u64 { return bits(x); }
fn from_u(u: u64) -> f64 { return f64_from_bits(u); }
// The same bits read as a signed value (`i64(x)` is a checked conversion and refuses the top half).
fn as_i(a: u64) -> i64 {
    if a > 9223372036854775807 {
        return i64(0) - i64(18446744073709551615 - a) - i64(1);
    }
    return i64(a);
}
// The unsigned wraparound glibc's bit arithmetic relies on (an exponent field below the one it is
// scaled by subtracts below zero on purpose). Grail's arithmetic is checked, so it is written out.
fn wadd(a: u64, b: u64) -> u64 {
    if a > 18446744073709551615 - b {
        return (a - (18446744073709551615 - b)) - 1;
    }
    return a + b;
}
fn wsub(a: u64, b: u64) -> u64 {
    if a >= b {
        return a - b;
    }
    d := b - a;
    return 18446744073709551615 - d + 1;
}

