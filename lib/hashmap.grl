module hashmap;

use iter;
use hash;
use core;

// Compact, insertion-ordered hash map (like Python's dict / indexmap): entries live densely in
// `entries`; each bucket lists entry indices. Iterate with `len`, `key_at`, `value_at`.
// Removal moves the last entry into the hole, so order is insertion order until a removal.
struct Slot<K, V> {
    key: K,
    value: V
}
// A borrowed view of one stored pair: the key is shared, the value is exclusive, and no operation
// yields a mutable key, so a live view can never invalidate the hash.
pub struct Entry<a, K, V> {
    key: (&a K),
    value: (&a mut V)
}
pub struct Map<K: hash::Hash + hash::Equal, V> {
    entries: Slot<K,
    V>[],
    buckets: u64[][],
    seed0: u64,
    seed1: u64
}
fn empty_buckets(capacity: u64) -> u64[][] {
    mut out = u64[][];
    for i in capacity {
        out.push(u64[]);
    }
    return out;
}
pub fn with_seed<K: hash::Hash + hash::Equal, V>(seed0: u64, seed1: u64) -> [K: V] {
    return Map { entries: Slot<K, V>[], buckets: empty_buckets(16), seed0: seed0, seed1: seed1 };
}
pub fn map_len<a, K: hash::Hash + hash::Equal, V>(map: (&a [K: V])) -> u64 {
    return map.entries.len();
}
fn bucket_of<a, b, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), key: (&b K)) -> u64 {
    return hash::hash(key, map.seed0, map.seed1) % map.buckets.len();
}
// Entry index of key, or len() when absent.
fn find<a, b, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), key: (&b K)) -> u64 {
    slot := bucket_of(&map, &key);
    bucket := &map.buckets[slot];
    for index in bucket {
        entry := &map.entries[*index];
        if hash::equal(&entry.key, &key) {
            return *index;
        }
    }
    return map.entries.len();
}
fn rebuild<a, K: hash::Hash + hash::Equal, V>(map: (&a mut [K: V]), capacity: u64) {
    exchange(&mut map.buckets, empty_buckets(capacity));
    for i in map.entries.len() {
        entry := &map.entries[i];
        slot := bucket_of(&map, &entry.key);
        target := &mut map.buckets[slot];
        target.push(i);
    }
}
pub fn map_contains<a, b, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), key: (&b K)) -> bool {
    return find(&map, key) < map.entries.len();
}
pub fn map_get<a, b, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), key: (&b K)) -> (&a V)? {
    index := find(&map, key);
    if index < map.entries.len() {
        entry := &map.entries[index];
        return Some(&entry.value);
    }
    return None;
}
pub fn map_get_mut<a, b, K: hash::Hash
    + hash::Equal, V>(map: (&a mut [K: V]), key: (&b K)) -> (&a mut V)? {
    index := find(&map, key);
    if index < map.entries.len() {
        entry := &mut map.entries[index];
        return Some(&mut entry.value);
    }
    return None;
}
pub fn map_insert<a, K: hash::Hash + hash::Equal, V>(map: (&a mut [K: V]), key: K, value: V) -> V? {
    index := find(&map, &key);
    if index < map.entries.len() {
        entry := &mut map.entries[index];
        old := exchange(&mut entry.value, value);
        return Some(old);
    }
    slot := bucket_of(&map, &key);
    next := map.entries.len();
    map.entries.push(Slot { key: key, value: value });
    bucket := &mut map.buckets[slot];
    bucket.push(next);
    capacity := map.buckets.len();
    if map.entries.len() >= capacity * 3 / 4 {
        rebuild(&mut map, capacity * 2);
    }
    return None;
}
fn unlink<a, K: hash::Hash + hash::Equal, V>(map: (&a mut [K: V]), slot: u64, index: u64) {
    bucket := &mut map.buckets[slot];
    for i in bucket.len() {
        if bucket[i] == index {
            last := bucket.pop()!;
            if i < bucket.len() {
                bucket[i] = last;
            }
            return ();
        }
    }
}
fn relink<a, K: hash::Hash + hash::Equal, V>(map: (&a mut [K: V]), slot: u64, from: u64, to: u64) {
    bucket := &mut map.buckets[slot];
    for i in bucket.len() {
        if bucket[i] == from {
            bucket[i] = to;
            return ();
        }
    }
}
pub fn map_remove<a, b, K: hash::Hash + hash::Equal, V>(map: (&a mut [K: V]), key: (&b K)) -> V? {
    index := find(&map, &key);
    if index >= map.entries.len() {
        return None;
    }
    slot := bucket_of(&map, &key);
    unlink(&mut map, slot, index);
    last := map.entries.len() - 1;
    if index == last {
        removed := map.entries.pop()!;
        return Some(removed.value);
    }
    moved := map.entries.pop()!;
    moved_slot := bucket_of(&map, &moved.key);
    removed := exchange(&mut map.entries[index], moved);
    relink(&mut map, moved_slot, last, index);
    return Some(removed.value);
}
// Borrowed view of an existing pair, or none. Holding it keeps the exclusive map borrow alive.
pub fn map_entry<a, b, K: hash::Hash
    + hash::Equal, V>(map: (&a mut [K: V]), key: (&b K)) -> Entry<a, K, V>? {
    index := find(&map, key);
    if index >= map.entries.len() {
        return None;
    }
    entry := &mut map.entries[index];
    view := Entry { key: &entry.key, value: &mut entry.value };
    return Some(view);
}
// Iteration by position: `for k, v in &m` lowers to these (`for i in map_len(&m) { k := key_at(&m, i); ... }`).
pub fn key_at<a, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), index: u64) -> (&a K) {
    entry := &map.entries[index];
    return &entry.key;
}
pub fn value_at<a, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), index: u64) -> (&a V) {
    entry := &map.entries[index];
    return &entry.value;
}
pub fn value_at_mut<a, K: hash::Hash
    + hash::Equal, V>(map: (&a mut [K: V]), index: u64) -> (&a mut V) {
    entry := &mut map.entries[index];
    return &mut entry.value;
}
// Both halves of one stored pair: the shared key and the exclusive value, like `entry`, so an
// exclusive iteration can update values without losing the key it is walking.
pub fn entry_at<a, K: hash::Hash
    + hash::Equal, V>(map: (&a mut [K: V]), index: u64) -> Entry<a, K, V> {
    entry := &mut map.entries[index];
    return Entry { key: &entry.key, value: &mut entry.value };
}
impl<K: hash::Hash + hash::Equal, V> Map<K, V> {
    pub fn len<a>(self: (&a Map<K, V>)) -> u64 {
        return hashmap::map_len(self);
    }
    pub fn contains<a, b>(self: (&a Map<K, V>), key: (&b K)) -> bool {
        return hashmap::map_contains(self, key);
    }
    pub fn get<a, b>(self: (&a Map<K, V>), key: (&b K)) -> (&a V)? {
        return hashmap::map_get(self, key);
    }
    pub fn get_mut<a, b>(self: (&a mut Map<K, V>), key: (&b K)) -> (&a mut V)? {
        return hashmap::map_get_mut(self, key);
    }
    pub fn insert<a>(self: (&a mut Map<K, V>), key: K, value: V) -> V? {
        return hashmap::map_insert(self, key, value);
    }
    pub fn remove<a, b>(self: (&a mut Map<K, V>), key: (&b K)) -> V? {
        return hashmap::map_remove(self, key);
    }
    pub fn entry<a, b>(self: (&a mut Map<K, V>), key: (&b K)) -> Entry<a, K, V>? {
        return hashmap::map_entry(self, key);
    }
    pub fn key_at<a>(self: (&a Map<K, V>), index: u64) -> (&a K) {
        return hashmap::key_at(self, index);
    }
    // Iterating a map. Keys and values are references into the map, so the borrow lasts as long as
    // the iterator or any item it handed out, exactly like `iter::refs(&v)` on a vector.
    pub fn keys<a>(self: (&a Map<K, V>)) -> iter::Iter<(&a K)> {
        mut i = 0;
        return iter::from_fn(|| -> (&a K)? {
            if i < self.len() {
                p := i;
                i = i + 1;
                return Some(self.key_at(p));
            }
            return None;
        });
    }
    pub fn values<a>(self: (&a Map<K, V>)) -> iter::Iter<(&a V)> {
        mut i = 0;
        return iter::from_fn(|| -> (&a V)? {
            if i < self.len() {
                p := i;
                i = i + 1;
                return Some(self.value_at(p));
            }
            return None;
        });
    }
    // Both at once, in the map's storage order (which is not sorted; use btree for that).
    pub fn iter<a>(self: (&a Map<K, V>)) -> iter::Iter<((&a K), (&a V))> {
        mut i = 0;
        return iter::from_fn(|| -> ((&a K), (&a V))? {
            if i < self.len() {
                p := i;
                i = i + 1;
                return Some((self.key_at(p), self.value_at(p)));
            }
            return None;
        });
    }
    pub fn value_at<a>(self: (&a Map<K, V>), index: u64) -> (&a V) {
        return hashmap::value_at(self, index);
    }
    pub fn value_at_mut<a>(self: (&a mut Map<K, V>), index: u64) -> (&a mut V) {
        return hashmap::value_at_mut(self, index);
    }
    pub fn entry_at<a>(self: (&a mut Map<K, V>), index: u64) -> Entry<a, K, V> {
        return hashmap::entry_at(self, index);
    }
}
