module hashmap;

use iter;
use hash;
use core;

// Compact, insertion-ordered hash map (like Python's dict / indexmap). The pairs live densely, in
// insertion order, in three flat vectors: each key's full hash in `codes`, the keys, the values.
// `slots` is one open-addressed index over them: linear probing with Robin Hood placement and
// backward-shift deletion, so there are no tombstones, and a miss stops as soon as it meets a slot
// nearer its home than the probe is. A slot word is 0 when empty, else (low 32 bits of the hash) <<
// 32 | (entry index + 1): the tag picks the home slot and rejects a mismatch before a key is read, and
// the stored hashes mean growth and relinking never rehash a key. The index is at most half full
// (measured against 3/4 and 7/8 on bench/hashmap.grl). Iterate with `len`, `key_at`, `value_at`.
// Removal moves the last entry into the hole, so order is insertion order until a removal. At most
// 2^32 - 1 entries.
// A borrowed view of one stored pair: the key is shared, the value is exclusive, and no operation
// yields a mutable key, so a live view can never invalidate the hash.
pub struct Entry<a, K, V> {
    key: (&a K),
    value: (&a mut V)
}
pub struct Map<K: hash::Hash + hash::Equal, V> {
    codes: u64[],
    keys: K[],
    values: V[],
    slots: u64[],
    // The seeded SipHash-1-3 state every key's hash starts from.
    base: hash::Hasher
}
const LOW: u64 = 4294967295;
pub fn with_seed<K: hash::Hash + hash::Equal, V>(seed0: u64, seed1: u64) -> [K: V] {
    return Map { codes: u64[], keys: K[], values: V[], slots: u64[], base: hash::table_hasher(seed0, seed1) };
}
// The free `map_*`, `key_at`, `value_at` and `entry_at` functions are what the compiler lowers map
// syntax to by name (`m[k]`, `m[k] = v`, `for k, v in &m`); programs call the methods on `Map`.
pub fn map_len<a, K: hash::Hash + hash::Equal, V>(map: (&a [K: V])) -> u64 {
    return map.codes.len();
}
// The slot holding key (whose hash is code), or slots.len() when absent.
fn locate<a, b, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), key: (&b K), code: u64) -> u64 {
    n := map.slots.len();
    if n == 0 {
        return 0;
    }
    mask := n - 1;
    tag := code & LOW;
    mut pos = tag & mask;
    mut dist: u64 = 0;
    while true {
        w := map.slots[pos];
        if w == 0 {
            return n;
        }
        if (w >> 32) == tag {
            if hash::equal(&map.keys[(w & LOW) - 1], &key) {
                return pos;
            }
        }
        if (wrapping_sub(pos, w >> 32) & mask) < dist {
            return n;
        }
        pos = (pos + 1) & mask;
        dist += 1;
    }
    return n;
}
// Robin Hood placement of a word that is not in the table: it takes the slot of any resident
// nearer its own home than the word is to its home, and that resident moves on.
fn place<a>(slots: (&a mut u64[]), word: u64) {
    mask := slots.len() - 1;
    mut w = word;
    mut pos = (w >> 32) & mask;
    mut dist: u64 = 0;
    while true {
        current := slots[pos];
        if current == 0 {
            slots[pos] = w;
            return ();
        }
        theirs := wrapping_sub(pos, current >> 32) & mask;
        if theirs < dist {
            slots[pos] = w;
            w = current;
            dist = theirs;
        }
        pos = (pos + 1) & mask;
        dist += 1;
    }
}
fn rebuild<a, K: hash::Hash + hash::Equal, V>(map: (&a mut [K: V]), capacity: u64) {
    exchange(&mut map.slots, u64[0; capacity]);
    for i in map.codes.len() {
        place(&mut map.slots, ((map.codes[i] & LOW) << 32) | (i + 1));
    }
}
// Empty slot pos, pulling the run after it back one step until a slot that is already home or empty.
fn erase<a>(slots: (&a mut u64[]), pos: u64) {
    mask := slots.len() - 1;
    mut hole = pos;
    mut next = (pos + 1) & mask;
    while true {
        w := slots[next];
        if (w == 0) || ((wrapping_sub(next, w >> 32) & mask) == 0) {
            slots[hole] = 0;
            return ();
        }
        slots[hole] = w;
        hole = next;
        next = (next + 1) & mask;
    }
}
pub fn map_get<a, b, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), key: (&b K)) -> (&a V)? {
    return map.get(key);
}
pub fn map_get_mut<a, b, K: hash::Hash
    + hash::Equal, V>(map: (&a mut [K: V]), key: (&b K)) -> (&a mut V)? {
    return map.get_mut(key);
}
pub fn map_insert<a, K: hash::Hash + hash::Equal, V>(map: (&a mut [K: V]), key: K, value: V) -> V? {
    return map.insert(key, value);
}
// Iteration by position: `for k, v in &m` lowers to these (`for i in map_len(&m) { k := key_at(&m, i); ... }`).
pub fn key_at<a, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), index: u64) -> (&a K) {
    return &map.keys[index];
}
pub fn value_at<a, K: hash::Hash + hash::Equal, V>(map: (&a [K: V]), index: u64) -> (&a V) {
    return &map.values[index];
}
// Both halves of one stored pair: the shared key and the exclusive value, like `entry`, so an
// exclusive iteration can update values without losing the key it is walking.
pub fn entry_at<a, K: hash::Hash
    + hash::Equal, V>(map: (&a mut [K: V]), index: u64) -> Entry<a, K, V> {
    return Entry { key: &map.keys[index], value: &mut map.values[index] };
}
impl<K: hash::Hash + hash::Equal, V> Map<K, V> {
    pub fn len<a>(self: (&a Map<K, V>)) -> u64 {
        return self.codes.len();
    }
    // The operations live here and the map_* functions call them: one call fewer on the hot path.
    pub fn contains<a, b>(self: (&a Map<K, V>), key: (&b K)) -> bool {
        return hashmap::locate(&self, key, hash::hash_from(key, &self.base)) < self.slots.len();
    }
    pub fn get<a, b>(self: (&a Map<K, V>), key: (&b K)) -> (&a V)? {
        pos := hashmap::locate(&self, key, hash::hash_from(key, &self.base));
        if pos < self.slots.len() {
            return Some(&self.values[(self.slots[pos] & hashmap::LOW) - 1]);
        }
        return None;
    }
    pub fn get_mut<a, b>(self: (&a mut Map<K, V>), key: (&b K)) -> (&a mut V)? {
        pos := hashmap::locate(&self, key, hash::hash_from(key, &self.base));
        if pos < self.slots.len() {
            return Some(&mut self.values[(self.slots[pos] & hashmap::LOW) - 1]);
        }
        return None;
    }
    pub fn insert<a>(self: (&a mut Map<K, V>), key: K, value: V) -> V? {
        code := hash::hash_from(&key, &self.base);
        pos := hashmap::locate(&self, &key, code);
        if pos < self.slots.len() {
            old := exchange(&mut self.values[(self.slots[pos] & hashmap::LOW) - 1], value);
            return Some(old);
        }
        next := self.codes.len();
        capacity := self.slots.len();
        if (next + 1) * 2 > capacity {
            if capacity == 0 {
                hashmap::rebuild(self, 8);
            } else {
                hashmap::rebuild(self, capacity * 2);
            }
        }
        self.codes.push(code);
        self.keys.push(key);
        self.values.push(value);
        hashmap::place(&mut self.slots, ((code & hashmap::LOW) << 32) | (next + 1));
        return None;
    }
    pub fn remove<a, b>(self: (&a mut Map<K, V>), key: (&b K)) -> V? {
        pos := hashmap::locate(&self, key, hash::hash_from(key, &self.base));
        if pos >= self.slots.len() {
            return None;
        }
        index := (self.slots[pos] & hashmap::LOW) - 1;
        hashmap::erase(&mut self.slots, pos);
        last := self.codes.len() - 1;
        code := self.codes.pop()!;
        moved_key := self.keys.pop()!;
        moved_value := self.values.pop()!;
        if index == last {
            return Some(moved_value);
        }
        // The last entry moves into the hole: its slot now names index.
        mask := self.slots.len() - 1;
        mut at = code & mask;
        while (self.slots[at] & hashmap::LOW) != last + 1 {
            at = (at + 1) & mask;
        }
        self.slots[at] = ((self.slots[at] >> 32) << 32) | (index + 1);
        self.codes[index] = code;
        self.keys[index] = moved_key;
        return Some(exchange(&mut self.values[index], moved_value));
    }
    // The Entry view of an existing pair, or none. Holding it keeps the exclusive map borrow alive.
    pub fn entry<a, b>(self: (&a mut Map<K, V>), key: (&b K)) -> Entry<a, K, V>? {
        pos := hashmap::locate(&self, key, hash::hash_from(key, &self.base));
        if pos >= self.slots.len() {
            return None;
        }
        index := (self.slots[pos] & hashmap::LOW) - 1;
        return Some(Entry { key: &self.keys[index], value: &mut self.values[index] });
    }
    pub fn key_at<a>(self: (&a Map<K, V>), index: u64) -> (&a K) {
        return hashmap::key_at(self, index);
    }
    // Iterating a map. Keys and values are references into the map, so the borrow lasts as long as
    // the iterator or any item it handed out, exactly like `iter::refs(&v)` on a vector.
    pub fn keys<a>(self: (&a Map<K, V>)) -> iter::Iter<(&a K)> {
        mut i = 0;
        return iter::from_fn(|| -> (&a K)? {
            if i < self.len() {
                p := i;
                i = i + 1;
                return Some(self.key_at(p));
            }
            return None;
        });
    }
    pub fn values<a>(self: (&a Map<K, V>)) -> iter::Iter<(&a V)> {
        mut i = 0;
        return iter::from_fn(|| -> (&a V)? {
            if i < self.len() {
                p := i;
                i = i + 1;
                return Some(self.value_at(p));
            }
            return None;
        });
    }
    // Both at once, in the map's storage order (which is not sorted; use btree for that).
    pub fn iter<a>(self: (&a Map<K, V>)) -> iter::Iter<((&a K), (&a V))> {
        mut i = 0;
        return iter::from_fn(|| -> ((&a K), (&a V))? {
            if i < self.len() {
                p := i;
                i = i + 1;
                return Some((self.key_at(p), self.value_at(p)));
            }
            return None;
        });
    }
    pub fn value_at<a>(self: (&a Map<K, V>), index: u64) -> (&a V) {
        return hashmap::value_at(self, index);
    }
    pub fn value_at_mut<a>(self: (&a mut Map<K, V>), index: u64) -> (&a mut V) {
        return &mut self.values[index];
    }
    pub fn entry_at<a>(self: (&a mut Map<K, V>), index: u64) -> Entry<a, K, V> {
        return hashmap::entry_at(self, index);
    }
}
