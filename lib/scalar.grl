module scalar;

// The methods of the scalar types, which every program has without a `use` line (the compiler adds
// this module beside `core`). Only the standard library may write an inherent impl for a built-in
// type; a program adds methods to one through an interface (book: Methods on built-in types).
// ---- integer methods ---------------------------------------------------------------------------
// Every program has these, because every program has `core`: `x.abs()`, `x.min(y)`, `x.pow(3)`,
// `x.checked_add(y)` (None on overflow), `x.saturating_sub(y)`, `x.wrapping_mul(y)`,
// `x.count_ones()`, `x.leading_zeros()`, `x.trailing_zeros()`, `x.to_string()` - Rust's names and
// results, for each of u8, u16, u32, u64, i8, i16, i32 and i64. The counts are `u32`, as Rust's are;
// `pow` takes a `u32` and traps on overflow, as `*` does. `wrapping_add`/`_sub`/`_mul` on u64 are the
// compiler's intrinsics of the same names (which the self-hosted compiler itself calls), so the
// free and the method form both stay.

const I64_MIN: i64 = -9223372036854775808;
// The two's-complement bits of an i64 (the inverse of `as_i64`).
fn i64_bits(value: i64) -> u64 {
    if value < 0 {
        return 18446744073709551615 - u64(0 - (value + 1));
    }
    return u64(value);
}
// |value| as a u64: i64's minimum has no i64 magnitude.
fn magnitude(value: i64) -> u64 {
    if value < 0 {
        return u64(0 - (value + 1)) + 1;
    }
    return u64(value);
}
fn count_ones_in(word: u64) -> u32 {
    mut n: u32 = 0;
    mut w = word;
    while w != 0 {
        w = w & (w - 1);
        n += 1;
    }
    return n;
}
fn leading_zeros_in(word: u64, width: u64) -> u32 {
    mut n: u32 = 0;
    mut bit = width;
    while bit > 0 {
        if ((word >> (bit - 1)) & 1) == 1 {
            return n;
        }
        n += 1;
        bit -= 1;
    }
    return n;
}
fn trailing_zeros_in(word: u64, width: u64) -> u32 {
    if word == 0 {
        return u32(width);
    }
    mut n: u32 = 0;
    mut w = word;
    while (w & 1) == 0 {
        w = w >> 1;
        n += 1;
    }
    return n;
}
fn unsigned_text(value: u64) -> string {
    if value == 0 {
        return "0".text();
    }
    mut digits = u8[];
    mut rest = value;
    while rest > 0 {
        digits.push(u8(rest % 10) + 48);
        rest = rest / 10;
    }
    mut out = u8[];
    mut i = digits.len();
    while i > 0 {
        i -= 1;
        out.push(digits[i]);
    }
    return out.text();
}
fn signed_text(value: i64) -> string {
    if value >= 0 {
        return unsigned_text(u64(value));
    }
    mut out = u8[45];
    tail := unsigned_text(magnitude(value));
    for i in tail.len() {
        out.push(tail[i]);
    }
    return out.text();
}
impl u8 {
    pub fn min(self, other: u8) -> u8 {
        if other < self {
            return other;
        }
        return self;
    }
    pub fn max(self, other: u8) -> u8 {
        if other > self {
            return other;
        }
        return self;
    }
    pub fn clamp(self, low: u8, high: u8) -> u8 {
        assert(low <= high);
        if self < low {
            return low;
        }
        if self > high {
            return high;
        }
        return self;
    }
    pub fn pow(self, exp: u32) -> u8 {
        mut result: u8 = 1;
        mut base = self;
        mut e = exp;
        while e > 0 {
            if (e & 1) == 1 {
                result = result * base;
            }
            e = e >> 1;
            if e > 0 {
                base = base * base;
            }
        }
        return result;
    }
    pub fn checked_add(self, other: u8) -> u8? {
        r := u64(self) + u64(other);
        if r > 255 {
            return None;
        }
        return Some(u8(r));
    }
    pub fn checked_sub(self, other: u8) -> u8? {
        if other > self {
            return None;
        }
        return Some(self - other);
    }
    pub fn checked_mul(self, other: u8) -> u8? {
        r := u64(self) * u64(other);
        if r > 255 {
            return None;
        }
        return Some(u8(r));
    }
    pub fn saturating_add(self, other: u8) -> u8 {
        r := u64(self) + u64(other);
        if r > 255 {
            return 255;
        }
        return u8(r);
    }
    pub fn saturating_sub(self, other: u8) -> u8 {
        if other > self {
            return 0;
        }
        return self - other;
    }
    pub fn wrapping_add(self, other: u8) -> u8 {
        return u8((u64(self) + u64(other)) & 255);
    }
    pub fn wrapping_sub(self, other: u8) -> u8 {
        return u8((u64(self) + 256 - u64(other)) & 255);
    }
    pub fn wrapping_mul(self, other: u8) -> u8 {
        return u8((u64(self) * u64(other)) & 255);
    }
    pub fn checked_div(self, other: u8) -> u8? {
        if other == 0 {
            return None;
        }
        return Some(self / other);
    }
    pub fn count_ones(self) -> u32 {
        return count_ones_in(u64(self));
    }
    pub fn leading_zeros(self) -> u32 {
        return leading_zeros_in(u64(self), 8);
    }
    pub fn trailing_zeros(self) -> u32 {
        return trailing_zeros_in(u64(self), 8);
    }
    pub fn to_string(self) -> string {
        return unsigned_text(u64(self));
    }
}
