    pub fn count_ones(self) -> u32 {
        return count_ones_in((i64_bits(i64(self)) & 4294967295));
    }
    pub fn leading_zeros(self) -> u32 {
        return leading_zeros_in((i64_bits(i64(self)) & 4294967295), 32);
    }
    pub fn trailing_zeros(self) -> u32 {
        return trailing_zeros_in((i64_bits(i64(self)) & 4294967295), 32);
    }
    pub fn to_string(self) -> string {
        return signed_text(i64(self));
    }
}
fn narrow_i32(value: i64) -> i32? {
    if (value < -2147483648) || (value > 2147483647) {
        return None;
    }
    return Some(i32(value));
}
fn wrap_i32(value: i64) -> i32 {
    low := i64_bits(value) & 4294967295;
    if low > 2147483647 {
        return i32(i64(low) - 4294967296);
    }
    return i32(i64(low));
}
impl i64 {
    pub fn min(self, other: i64) -> i64 {
        if other < self {
            return other;
        }
        return self;
    }
    pub fn max(self, other: i64) -> i64 {
        if other > self {
            return other;
        }
        return self;
    }
    pub fn clamp(self, low: i64, high: i64) -> i64 {
        assert(low <= high);
        if self < low {
            return low;
        }
        if self > high {
            return high;
        }
        return self;
    }
    pub fn abs(self) -> i64 {
        if self < 0 {
            return 0 - self;
        }
        return self;
    }
    pub fn signum(self) -> i64 {
        if self < 0 {
            return -1;
        }
        if self > 0 {
            return 1;
        }
        return 0;
    }
    pub fn is_negative(self) -> bool {
        return self < 0;
    }
    pub fn is_positive(self) -> bool {
        return self > 0;
    }
    pub fn pow(self, exp: u32) -> i64 {
        mut result: i64 = 1;
        mut base = self;
        mut e = exp;
        while e > 0 {
            if (e & 1) == 1 {
                result = result * base;
            }
            e = e >> 1;
            if e > 0 {
                base = base * base;
            }
        }
        return result;
    }
    pub fn checked_add(self, other: i64) -> i64? {
        r := self.wrapping_add(other);
        if ((self < 0) == (other < 0)) && ((r < 0) != (self < 0)) {
            return None;
        }
        return Some(r);
    }
    pub fn checked_sub(self, other: i64) -> i64? {
        r := self.wrapping_sub(other);
        if ((self < 0) != (other < 0)) && ((r < 0) != (self < 0)) {
            return None;
        }
        return Some(r);
    }
    pub fn checked_mul(self, other: i64) -> i64? {
        if (self == 0) || (other == 0) {
            return Some(i64(0));
        }
        product := magnitude(self).checked_mul(magnitude(other));
        match product {
            Some(m) => {
                if (self < 0) != (other < 0) {
                    if m > 9223372036854775808 {
                        return None;
                    }
                    return Some(core::as_i64(wrapping_sub(0, m)));
                }
                if m > 9223372036854775807 {
                    return None;
                }
                return Some(i64(m));
            },
            None => {
                return None;
            }
        }
    }
    pub fn saturating_add(self, other: i64) -> i64 {
        match self.checked_add(other) {
            Some(r) => {
                return r;
            },
            None => {
                if other < 0 {
                    return I64_MIN;
                }
                return 9223372036854775807;
            }
        }
    }
    pub fn saturating_sub(self, other: i64) -> i64 {
        match self.checked_sub(other) {
            Some(r) => {
                return r;
            },
            None => {
                if other > 0 {
                    return I64_MIN;
                }
                return 9223372036854775807;
            }
        }
    }
    pub fn wrapping_add(self, other: i64) -> i64 {
        return core::as_i64(wrapping_add(i64_bits(self), i64_bits(other)));
    }
    pub fn wrapping_sub(self, other: i64) -> i64 {
        return core::as_i64(wrapping_sub(i64_bits(self), i64_bits(other)));
    }
    pub fn wrapping_mul(self, other: i64) -> i64 {
        return core::as_i64(wrapping_mul(i64_bits(self), i64_bits(other)));
    }
    pub fn checked_div(self, other: i64) -> i64? {
        if (other == 0) || ((self == I64_MIN) && (other == -1)) {
            return None;
        }
        return Some(self / other);
    }
    pub fn count_ones(self) -> u32 {
        return count_ones_in(i64_bits(self));
    }
    pub fn leading_zeros(self) -> u32 {
        return leading_zeros_in(i64_bits(self), 64);
    }
    pub fn trailing_zeros(self) -> u32 {
        return trailing_zeros_in(i64_bits(self), 64);
    }
    pub fn to_string(self) -> string {
        return signed_text(i64(self));
    }
}

// ---- char methods ------------------------------------------------------------------------------
// The compiler answers `is_alphabetic`, `is_alphanumeric`, `is_ascii_digit`, `is_whitespace`,
// `is_uppercase`, `is_lowercase`, `is_ascii`, `to_uppercase`, `to_lowercase` and `len_utf8` itself;
// these are the rest of Rust's common set. `to_digit` and `is_digit` take a radix from 2 to 36.
impl char {
    pub fn to_digit(self, radix: u32) -> u32? {
        assert((radix >= 2) && (radix <= 36));
        code := u64(self);
        mut digit: u64 = 99;
        if (code >= 48) && (code <= 57) {
            digit = code - 48;
        } else if (code >= 97) && (code <= 122) {
            digit = code - 87;
        } else if (code >= 65) && (code <= 90) {
            digit = code - 55;
        }
        if digit >= u64(radix) {
            return None;
        }
        return Some(u32(digit));
    }
    pub fn is_digit(self, radix: u32) -> bool {
        return self.to_digit(radix).is_some();
    }
    pub fn is_control(self) -> bool {
        code := u64(self);
        return (code < 32) || ((code >= 127) && (code < 160));
    }
    pub fn is_ascii_alphabetic(self) -> bool {
        return self.is_ascii_uppercase() || self.is_ascii_lowercase();
    }
    pub fn is_ascii_uppercase(self) -> bool {
        code := u64(self);
        return (code >= 65) && (code <= 90);
    }
    pub fn is_ascii_lowercase(self) -> bool {
        code := u64(self);
        return (code >= 97) && (code <= 122);
    }
    pub fn is_ascii_alphanumeric(self) -> bool {
        return self.is_ascii_alphabetic() || self.is_ascii_digit();
    }
    pub fn is_ascii_hexdigit(self) -> bool {
        return self.is_digit(16);
    }
    pub fn is_ascii_whitespace(self) -> bool {
        code := u64(self);
        return (code == 32) || (code == 9) || (code == 10) || (code == 12) || (code == 13);
    }
    pub fn is_ascii_punctuation(self) -> bool {
        code := u64(self);
        return ((code >= 33) && (code <= 47))
            || ((code >= 58) && (code <= 64))
            || ((code >= 91) && (code <= 96))
            || ((code >= 123) && (code <= 126));
    }
    pub fn is_ascii_graphic(self) -> bool {
        code := u64(self);
        return (code >= 33) && (code <= 126);
    }
    pub fn is_ascii_control(self) -> bool {
        code := u64(self);
        return (code < 32) || (code == 127);
    }
    pub fn to_ascii_uppercase(self) -> char {
        if self.is_ascii_lowercase() {
            return char(u64(self) - 32);
        }
        return self;
    }
    pub fn to_ascii_lowercase(self) -> char {
        if self.is_ascii_uppercase() {
            return char(u64(self) + 32);
        }
        return self;
    }
    pub fn eq_ignore_ascii_case(self, other: char) -> bool {
        return self.to_ascii_lowercase() == other.to_ascii_lowercase();
    }
    pub fn to_string(self) -> string {
        mut out = u8[];
        out.push_char(self);
        return out.text();
    }
}

// ---- float bits --------------------------------------------------------------------------------
// `x.to_bits()` and `f64::from_bits(b)`: the IEEE bit pattern of a float and back (the intrinsics
// `bits`, `f64_from_bits`, `f32_bits` and `f32_from_bits`, which the compiler itself calls). A NaN's
// pattern is the one quiet NaN, as `bits` gives it.
impl f64 {
    pub fn to_bits(self) -> u64 {
        return bits(self);
    }
    pub fn from_bits(word: u64) -> f64 {
        return f64_from_bits(word);
    }
    // self limited to [low, high], as Rust's: a NaN stays NaN, and bounds out of order (or a NaN
    // bound) are a contract violation rather than a silent answer.
    pub fn clamp(self, low: f64, high: f64) -> f64 {
        assert(low <= high);
        if self < low {
            return low;
        }
        if self > high {
            return high;
        }
        return self;
    }
    // 1.0 for a positive number or +0.0, -1.0 for a negative one or -0.0, NaN for NaN (Rust's).
    pub fn signum(self) -> f64 {
        if self.is_nan() {
            return self;
        }
        if (bits(self) >> 63) != 0 {
            return -1.0;
        }
        return 1.0;
    }
}
impl f32 {
    pub fn to_bits(self) -> u32 {
        return u32(f32_bits(self));
    }
    pub fn from_bits(word: u32) -> f32 {
        return f32_from_bits(u64(word));
    }
    // self limited to [low, high], as Rust's: a NaN stays NaN, and bounds out of order (or a NaN
    // bound) are a contract violation rather than a silent answer.
    pub fn clamp(self, low: f32, high: f32) -> f32 {
        assert(low <= high);
        if self < low {
            return low;
        }
        if self > high {
            return high;
        }
        return self;
    }
    // 1.0 for a positive number or +0.0, -1.0 for a negative one or -0.0, NaN for NaN (Rust's).
    pub fn signum(self) -> f32 {
        if self.is_nan() {
            return self;
        }
        if (f32_bits(self) >> 31) != 0 {
            return -1.0;
        }
        return 1.0;
    }
}
