fn narrow_i8(value: i64) -> i8? {
    if (value < -128) || (value > 127) {
        return None;
    }
    return Some(i8(value));
}
fn wrap_i8(value: i64) -> i8 {
    low := i64_bits(value) & 255;
    if low > 127 {
        return i8(i64(low) - 256);
    }
    return i8(i64(low));
}
