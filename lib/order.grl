module order;

// Strict ordering used by vecs::sort, vecs::min and vecs::max.
pub interface Ord{fn less<a,b>(left:(&a Self),right:(&b Self))->bool;}
impl Ord for u64{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{return load(left)<load(right);}}
impl Ord for u8{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{return load(left)<load(right);}}
impl Ord for u16{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{return load(left)<load(right);}}
impl Ord for u32{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{return load(left)<load(right);}}
impl Ord for i8{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{return load(left)<load(right);}}
impl Ord for i16{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{return load(left)<load(right);}}
impl Ord for i32{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{return load(left)<load(right);}}
impl Ord for i64{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{return load(left)<load(right);}}
// f64: NaN sorts after every number (a total order for sorting).
impl Ord for f64{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{l:=load(left);r:=load(right);if l.is_nan(){return false;}if r.is_nan(){return true;}return l<r;}}
// Byte-wise (for UTF-8 text this is code point order); a shorter prefix sorts first.
impl Ord for u8[]{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{
    mut n=left.len();if right.len()<n{n=right.len();}
    for i in n{if left[i]!=right[i]{return left[i]<right[i];}}return left.len()<right.len();
}}
impl Ord for string{fn less<a,b>(left:(&a Self),right:(&b Self))->bool{
    mut n=left.len();if right.len()<n{n=right.len();}
    for i in n{if left[i]!=right[i]{return left[i]<right[i];}}return left.len()<right.len();
}}
pub fn less<a,b,T:Ord>(left:(&a T),right:(&b T))->bool{return Ord::less(left,right);}
