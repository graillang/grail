impl Add for f32 { fn add(self: Self, other: Self) -> Self { return self + other; } }
impl Sub for f32 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for f32 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
impl Div for f32 { fn div(self: Self, other: Self) -> Self { return self / other; } }
impl Eq for f32 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Add for f64 { fn add(self: Self, other: Self) -> Self { return self + other; } }
impl Sub for f64 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for f64 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
