module ops;

// Operators for your own types (Rust's std::ops). A binary `a + b` whose operands are a record or
// enum type with an `impl ops::Add` calls `add`, and so on; `==`/`!=` call `Eq::eq`, and `<`,
// `<=`, `>`, `>=` call `order::Ord::less`. Integers, floats and strings keep their own operators.
pub interface Eq {
    fn eq(self: &Self, other: &Self) -> bool;
}
pub interface Add {
    fn add(self: Self, other: Self) -> Self;
}
pub interface Sub {
    fn sub(self: Self, other: Self) -> Self;
}
pub interface Mul {
    fn mul(self: Self, other: Self) -> Self;
}
pub interface Div {
    fn div(self: Self, other: Self) -> Self;
}
pub interface Rem {
    fn rem(self: Self, other: Self) -> Self;
}

// The built-in numbers implement them, so a generic `T: ops::Add` also takes `u64` or `f64`.
impl Add for u8 { fn add(self: Self, other: Self) -> Self { return self + other; } }
impl Sub for u8 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for u8 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
impl Div for u8 { fn div(self: Self, other: Self) -> Self { return self / other; } }
impl Rem for u8 { fn rem(self: Self, other: Self) -> Self { return self % other; } }
impl Eq for u8 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Add for u16 { fn add(self: Self, other: Self) -> Self { return self + other; } }
impl Sub for u16 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for u16 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
impl Div for u16 { fn div(self: Self, other: Self) -> Self { return self / other; } }
impl Rem for u16 { fn rem(self: Self, other: Self) -> Self { return self % other; } }
impl Eq for u16 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Add for u32 { fn add(self: Self, other: Self) -> Self { return self + other; } }
impl Sub for u32 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for u32 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
impl Div for u32 { fn div(self: Self, other: Self) -> Self { return self / other; } }
impl Rem for u32 { fn rem(self: Self, other: Self) -> Self { return self % other; } }
impl Eq for u32 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Add for u64 { fn add(self: Self, other: Self) -> Self { return self + other; } }
impl Sub for u64 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for u64 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
impl Div for u64 { fn div(self: Self, other: Self) -> Self { return self / other; } }
impl Rem for u64 { fn rem(self: Self, other: Self) -> Self { return self % other; } }
impl Eq for u64 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
