impl Sub for i8 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for i8 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
impl Div for i8 { fn div(self: Self, other: Self) -> Self { return self / other; } }
impl Rem for i8 { fn rem(self: Self, other: Self) -> Self { return self % other; } }
impl Eq for i8 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Add for i16 { fn add(self: Self, other: Self) -> Self { return self + other; } }
impl Sub for i16 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for i16 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
impl Div for i16 { fn div(self: Self, other: Self) -> Self { return self / other; } }
impl Rem for i16 { fn rem(self: Self, other: Self) -> Self { return self % other; } }
impl Eq for i16 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Add for i32 { fn add(self: Self, other: Self) -> Self { return self + other; } }
impl Sub for i32 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for i32 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
impl Div for i32 { fn div(self: Self, other: Self) -> Self { return self / other; } }
impl Rem for i32 { fn rem(self: Self, other: Self) -> Self { return self % other; } }
impl Eq for i32 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Add for i64 { fn add(self: Self, other: Self) -> Self { return self + other; } }
impl Sub for i64 { fn sub(self: Self, other: Self) -> Self { return self - other; } }
impl Mul for i64 { fn mul(self: Self, other: Self) -> Self { return self * other; } }
impl Div for i64 { fn div(self: Self, other: Self) -> Self { return self / other; } }
