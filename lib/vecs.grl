module vecs;
use core;
use hash;
use iter;
use order;

// Everyday vector operations, as methods on `T[]`.
//
// A closure passed here is called on the caller's thread, one call at a time and in element order,
// so it is an `FnMut`: a closure that writes its captures (a counter, a `&mut` total) is accepted,
// and an `Fn` closure or a named `fn` widens to it. A by-value `FnMut` parameter is not mutable
// storage, so each body first moves it into a `mut` binding and calls that.
//
// `map`, `filter`, `fold`, `reduce`, `for_each` and `flat_map` consume the vector: each element is
// moved into the closure, so they work for any element type. The reading adapters (`any`, `all`,
// `count`, `find`, `position`, `get`, `first`, `last`) borrow it and hand the element out by
// reference. Nothing here aborts: an empty vector gives `None` to `reduce`/`min`/`max`/`get`, and
// `Some(len)`/`None` to `position`/`find`.

impl<T> T[] {
    pub fn map<U, Cb: FnMut(T) -> U>(self, f: Cb) -> U[] {
        mut call = f;
        mut source = self;
        mut reversed = source;
        reversed.reverse();
        mut out = U[];
        while reversed.len() != 0 {
            popped := reversed.pop()!;
            out.push(call(popped));
        }
        return out;
    }
    // fold consumes the vector and moves each element into `step` in order.
    pub fn fold<A, Cb: FnMut(A, T) -> A>(self, initial: A, step: Cb) -> A {
        mut call = step;
        mut source = self;
        mut reversed = source;
        reversed.reverse();
        mut acc = initial;
        while reversed.len() != 0 {
            popped := reversed.pop()!;
            acc = call(acc, popped);
        }
        return acc;
    }
    pub fn filter<Cb: FnMut(&T) -> bool>(self, keep: Cb) -> T[] {
        mut call = keep;
        mut source = self;
        mut reversed = source;
        reversed.reverse();
        mut out = T[];
        while reversed.len() != 0 {
            value := reversed.pop()!;
            if call(&value) {
                out.push(value);
            }
        }
        return out;
    }
    pub fn filter_map<U, Cb: FnMut(&T) -> U?>(self, f: Cb) -> U[] {
        mut call = f;
        mut source = self;
        mut reversed = source;
        reversed.reverse();
        mut out = U[];
        while reversed.len() != 0 {
            value := reversed.pop()!;
            if let Some(mapped) = call(&value) {
                out.push(mapped);
            }
        }
        return out;
    }
    pub fn flat_map<U, Cb: FnMut(T) -> U[]>(self, f: Cb) -> U[] {
        mut call = f;
        mut source = self;
        mut reversed = source;
        reversed.reverse();
        mut out = U[];
        while reversed.len() != 0 {
            part := call(reversed.pop()!);
            mut rest = part;
            mut back = rest;
            back.reverse();
            while back.len() != 0 {
                popped := back.pop()!;
                out.push(popped);
            }
        }
        return out;
    }
    pub fn for_each<Cb: FnMut(T) -> unit>(self, f: Cb) {
        mut call = f;
        mut source = self;
        mut reversed = source;
        reversed.reverse();
        while reversed.len() != 0 {
            popped := reversed.pop()!;
            call(popped);
        }
        return ();
    }
    // The one value `step` combines every element into, or None for an empty vector.
    pub fn reduce<Cb: FnMut(T, T) -> T>(self, step: Cb) -> T? {
        mut call = step;
        mut source = self;
        mut reversed = source;
        reversed.reverse();
        if reversed.len() == 0 {
            return None;
        }
        mut acc = reversed.pop()!;
        while reversed.len() != 0 {
            popped := reversed.pop()!;
            acc = call(acc, popped);
        }
        return Some(acc);
    }
    // Every element in order, moved out one at a time (`for x in v.into_iter()`).
    pub fn into_iter(self) -> iter::Iter<T> {
        return iter::of(self);
    }
    pub fn any<Cb: FnMut(&T) -> bool>(&self, test: Cb) -> bool {
        mut call = test;
        for x in self {
            if call(x) {
                return true;
            }
        }
        return false;
    }
    pub fn all<Cb: FnMut(&T) -> bool>(&self, test: Cb) -> bool {
        mut call = test;
        for x in self {
            if !call(x) {
                return false;
            }
        }
        return true;
    }
    // How many elements pass `test`.
    pub fn count<Cb: FnMut(&T) -> bool>(&self, test: Cb) -> u64 {
        mut call = test;
        mut n = 0;
        for x in self {
            if call(x) {
                n += 1;
            }
        }
        return n;
    }
    // The first element passing `test`, or None.
    pub fn find<Cb: FnMut(&T) -> bool>(&self, test: Cb) -> (&T)? {
        mut call = test;
        for i in self.len() {
            if call(&self[i]) {
                return Some(&self[i]);
            }
        }
        return None;
    }
    // The index of the first element passing `test`, or None.
    pub fn position<Cb: FnMut(&T) -> bool>(&self, test: Cb) -> u64? {
        mut call = test;
        for i in self.len() {
            if call(&self[i]) {
                return Some(i);
            }
        }
        return None;
    }
    // The element at `i`, or None: an index past the end is not an error here.
    pub fn get(&self, i: u64) -> (&T)? {
        if i >= self.len() {
            return None;
        }
        return Some(&self[i]);
    }
    pub fn first(&self) -> (&T)? {
        if self.len() == 0 {
            return None;
        }
        return Some(&self[0]);
    }
    pub fn last(&self) -> (&T)? {
        if self.len() == 0 {
            return None;
        }
        return Some(&self[self.len() - 1]);
    }
}

// Drops later elements that equal an earlier one, keeping first occurrences in order.
impl<T: hash::Equal> T[] {
    pub fn dedup(self) -> T[] {
        mut source = self;
        mut reversed = source;
        reversed.reverse();
        mut out = T[];
        while reversed.len() != 0 {
            value := reversed.pop()!;
            mut fresh = true;
            for i in out.len() {
                if hash::Equal::equal(&out[i], &value) {
                    fresh = false;
                }
            }
            if fresh {
                out.push(value);
            }
        }
        return out;
    }
}

// The one number every element adds up to.
impl u64[] {
    @no_alloc
    @no_block
    pub fn sum(&self) -> u64 {
        mut total = 0;
        for x in self {
            total += *x;
        }
        return total;
    }
}

// Stable merge sort for any element type with an order::Ord implementation; elements are moved,
// never copied. O(n log n).
impl<T: order::Ord> T[] {
    pub fn sort(&mut self) {
        taken := exchange(self, T[]);
        sorted := merge_sorted(taken);
        exchange(self, sorted);
        return ();
    }
    pub fn is_sorted(&self) -> bool {
        for i in 1..self.len() {
            if order::less(&self[i], &self[i - 1]) {
                return false;
            }
        }
        return true;
    }
    // The smallest/largest element, or None for an empty vector (first one on ties).
    pub fn min(&self) -> (&T)? {
        if self.len() == 0 {
            return None;
        }
        mut best = 0;
        for i in 1..self.len() {
            if order::less(&self[i], &self[best]) {
                best = i;
            }
        }
        return Some(&self[best]);
    }
    pub fn max(&self) -> (&T)? {
        if self.len() == 0 {
            return None;
        }
        mut best = 0;
        for i in 1..self.len() {
            if order::less(&self[best], &self[i]) {
                best = i;
            }
        }
        return Some(&self[best]);
    }
    // The index of the smallest/largest element (first one on ties), or None when empty.
    pub fn min_index(&self) -> u64? {
        if self.len() == 0 {
            return None;
        }
        mut best = 0;
        for i in 1..self.len() {
            if order::less(&self[i], &self[best]) {
                best = i;
            }
        }
        return Some(best);
    }
    pub fn max_index(&self) -> u64? {
        if self.len() == 0 {
            return None;
        }
        mut best = 0;
        for i in 1..self.len() {
            if order::less(&self[best], &self[i]) {
                best = i;
            }
        }
        return Some(best);
    }
    // The index of `value` if present, else None; O(log n). `self` must be sorted.
    pub fn binary_search(&self, value: &T) -> u64? {
        mut lo = 0;
        mut hi = self.len();
        while lo < hi {
            mid := lo + (hi - lo) / 2;
            if order::less(&self[mid], value) {
                lo = mid + 1;
            } else {
                if order::less(value, &self[mid]) {
                    hi = mid;
                } else {
                    return Some(mid);
                }
            }
        }
        return None;
    }
    // Inserts `value` in order unless it is present; true if inserted. `self` stays sorted.
    pub fn insert_sorted(&mut self, value: T) -> bool {
        mut lo = 0;
        mut hi = self.len();
        while lo < hi {
            mid := lo + (hi - lo) / 2;
            if order::less(&self[mid], &value) {
                lo = mid + 1;
            } else {
                if order::less(&value, &self[mid]) {
                    hi = mid;
                } else {
                    return false;
                }
            }
        }
        self.insert(lo, value);
        return true;
    }
    // The smallest/largest element by a u64 key computed once per element, or None when empty.
    pub fn min_by_key<Cb: FnMut(&T) -> u64>(&self, key_of: Cb) -> (&T)? {
        mut key = key_of;
        if self.len() == 0 {
            return None;
        }
        mut best = 0;
        mut best_key = key(&self[0]);
        for i in 1..self.len() {
            k := key(&self[i]);
            if k < best_key {
                best = i;
                best_key = k;
            }
        }
        return Some(&self[best]);
    }
    pub fn max_by_key<Cb: FnMut(&T) -> u64>(&self, key_of: Cb) -> (&T)? {
        mut key = key_of;
        if self.len() == 0 {
            return None;
        }
        mut best = 0;
        mut best_key = key(&self[0]);
        for i in 1..self.len() {
            k := key(&self[i]);
            if k > best_key {
                best = i;
                best_key = k;
            }
        }
        return Some(&self[best]);
    }
}

// Stable sort by a comparator: `less(a, b)` is true when `a` must come before `b`; equal elements
// keep their order. A bottom-up merge over an index permutation, then applied with swaps: elements
// are moved, never copied, and the comparator is called from one place. O(n log n). The comparator
// is an FnMut (it may count its calls); the order of the calls is the merge's, not specified.
impl<T> T[] {
    pub fn sort_by<Cb: FnMut(&T, &T) -> bool>(&mut self, order_by: Cb) {
        mut less = order_by;
        n := self.len();
        mut idx = u64[0; n];
        for i in n {
            idx[i] = i;
        }
        mut tmp = u64[0; n];
        mut width = 1;
        while width < n {
            mut lo = 0;
            while lo < n {
                mut mid = lo + width;
                if mid > n {
                    mid = n;
                }
                mut hi = lo + 2 * width;
                if hi > n {
                    hi = n;
                }
                mut i = lo;
                mut j = mid;
                mut k = lo;
                while k < hi {
                    // Take from the right only when it must come strictly first (stability).
                    if (i < mid) && ((j >= hi) || !less(&self[idx[j]], &self[idx[i]])) {
                        tmp[k] = idx[i];
                        i += 1;
                    } else {
                        tmp[k] = idx[j];
                        j += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            swapped := exchange(&mut idx, tmp);
            tmp = swapped;
            width = width * 2;
        }
        permute(self, &idx);
        return ();
    }
    // Stable sort by a u64 key computed once per element, in element order.
    pub fn sort_by_key<Cb: FnMut(&T) -> u64>(&mut self, key_of: Cb) {
        mut key = key_of;
        n := self.len();
        mut keys = u64[0; n];
        for i in n {
            keys[i] = key(&self[i]);
        }
        mut idx = u64[0; n];
        for i in n {
            idx[i] = i;
        }
        mut tmp = u64[0; n];
        mut width = 1;
        while width < n {
            mut lo = 0;
            while lo < n {
                mut mid = lo + width;
                if mid > n {
                    mid = n;
                }
                mut hi = lo + 2 * width;
                if hi > n {
                    hi = n;
                }
                mut i = lo;
                mut j = mid;
                mut k = lo;
                while k < hi {
                    if (i < mid) && ((j >= hi) || (keys[idx[j]] >= keys[idx[i]])) {
                        tmp[k] = idx[i];
                        i += 1;
                    } else {
                        tmp[k] = idx[j];
                        j += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            swapped := exchange(&mut idx, tmp);
            tmp = swapped;
            width = width * 2;
        }
        permute(self, &idx);
        return ();
    }
}

fn merge_sorted<T: order::Ord>(items: T[]) -> T[] {
    if items.len() < 2 {
        return items;
    }
    mut left = items;
    half := left.len() / 2;
    mut right_rev = T[];
    while left.len() > half {
        right_rev.push(left.pop()!);
    }
    mut a = merge_sorted(left);
    mut b = merge_sorted(reversed(right_rev));
    // Take the larger tail element each time (ties prefer the right half) to build a reversed
    // result, then reverse it; this keeps equal elements in their original order.
    mut out_rev = T[];
    while (a.len() != 0) && (b.len() != 0) {
        take_left := order::less(&b[b.len() - 1], &a[a.len() - 1]);
        if take_left {
            out_rev.push(a.pop()!);
        } else {
            out_rev.push(b.pop()!);
        }
    }
    while a.len() != 0 {
        popped := a.pop()!;
        out_rev.push(popped);
    }
    while b.len() != 0 {
        popped := b.pop()!;
        out_rev.push(popped);
    }
    return reversed(out_rev);
}

fn reversed<T>(items: T[]) -> T[] {
    mut source = items;
    mut out = source;
    out.reverse();
    return out;
}

// Rearranges `items` so position k holds the element that was at order[k] (a permutation).
fn permute<a, T>(items: (&a mut T[]), order: (&a u64[])) {
    n := items.len();
    // pos[o]: where original element o sits now; at[p]: which original element sits at p.
    mut pos = u64[0; n];
    mut at = u64[0; n];
    for i in n {
        pos[i] = i;
        at[i] = i;
    }
    for k in n {
        o := order[k];
        p := pos[o];
        if p != k {
            items.swap(k, p);
            moved := at[k];
            at[p] = moved;
            pos[moved] = p;
            at[k] = o;
            pos[o] = k;
        }
    }
    return ();
}

// Whether any element equals `wanted`. The `.contains` method on vectors is the compiler's own and
// takes integer or bool elements only; this one takes any element type with `hash::Equal`.
pub fn contains<a, b, T: hash::Equal>(items: (&a T[]), wanted: (&b T)) -> bool {
    for i in items.len() {
        item := &items[i];
        if hash::Equal::equal(item, wanted) {
            return true;
        }
    }
    return false;
}
