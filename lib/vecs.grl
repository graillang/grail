module vecs;
use hash;
use order;

// Everyday vector operations. Closures passed here own their captures (see closures.md).
pub fn map<T,U>(items:T[],f:Fn(T)->U)->U[]{
    mut source=items;mut reversed=T[];while source.len()!=0{reversed.push(source.pop());}
    mut out=U[];while reversed.len()!=0{out.push(f(reversed.pop()));}return out;
}
// fold consumes the vector and moves each element into `step` in order, so it works for any
// element type. Predicates over borrowed elements need closure parameters that hold borrows,
// which closures do not have yet (docs/design/closures.md); until then the predicate helpers
// below take u64 elements by value, like filter_nums.
pub fn fold<T,A>(items:T[],initial:A,step:Fn(A,T)->A)->A{
    mut source=items;mut reversed=T[];while source.len()!=0{reversed.push(source.pop());}
    mut acc=initial;while reversed.len()!=0{acc=step(acc,reversed.pop());}return acc;
}
pub fn any_num<a>(items:(&a u64[]),test:Fn(u64)->bool)->bool{for i in items.len(){if test(items[i]){return true;}}return false;}
pub fn all_num<a>(items:(&a u64[]),test:Fn(u64)->bool)->bool{for i in items.len(){if !test(items[i]){return false;}}return true;}
pub fn count_num<a>(items:(&a u64[]),test:Fn(u64)->bool)->u64{mut n=0;for i in items.len(){if test(items[i]){n+=1;}}return n;}
// The index of the first element passing `test`, or items.len() when none does.
pub fn position_num<a>(items:(&a u64[]),test:Fn(u64)->bool)->u64{for i in items.len(){if test(items[i]){return i;}}return items.len();}
pub fn filter_nums(items:u64[],keep:Fn(u64)->bool)->u64[]{
    mut out=u64[];for x in items{if keep(x){out.push(x);}}return out;
}
pub fn sum(items:u64[])->u64{mut total=0;for x in items{total+=x;}return total;}
pub fn max_num(items:u64[])->u64{assert(items.len()!=0);mut best=items[0];for x in items{if x>best{best=x;}}return best;}
pub fn reverse<a,T>(items:(&a mut T[])){
    mut taken=T[];while items.len()!=0{taken.push(items.pop());}
    mut back=T[];while taken.len()!=0{back.push(taken.pop());}
    while back.len()!=0{items.push(back.pop());}
}
// In-place merge-free insertion sort for numbers (stable, O(n^2); fine for small vectors).
pub fn sort_nums<a>(items:(&a mut u64[])){
    n:=items.len();for i in 1..n{mut j=i;while j>0{left:=items[j-1];right:=items[j];if left<=right{break;}
        exchange(&mut items[j-1],right);exchange(&mut items[j],left);j-=1;}}
}
pub fn contains<a,b,T:hash::Equal>(items:(&a T[]),wanted:(&b T))->bool{
    for i in items.len(){item:=&items[i];if hash::Equal::equal(item,&wanted){return true;}}return false;
}

// Stable merge sort for any element type with an order::Ord implementation; elements are moved,
// never copied. O(n log n).
fn reversed<T>(items:T[])->T[]{mut source=items;mut out=T[];while source.len()!=0{out.push(source.pop());}return out;}
fn merge_sorted<T:order::Ord>(items:T[])->T[]{
    if items.len()<2{return items;}
    mut left=items;half:=left.len()/2;mut right_rev=T[];
    while left.len()>half{right_rev.push(left.pop());}
    mut a=merge_sorted(left);mut b=merge_sorted(reversed(right_rev));
    // Take the larger tail element each time (ties prefer the right half) to build a reversed
    // result, then reverse it; this keeps equal elements in their original order.
    mut out_rev=T[];
    while (a.len()!=0)&&(b.len()!=0){
        take_left:=order::less(&b[b.len()-1],&a[a.len()-1]);
        if take_left{out_rev.push(a.pop());}else{out_rev.push(b.pop());}
    }
    while a.len()!=0{out_rev.push(a.pop());}while b.len()!=0{out_rev.push(b.pop());}
    return reversed(out_rev);
}
pub fn sort<a,T:order::Ord>(items:(&a mut T[])){taken:=exchange(items,T[]);sorted:=merge_sorted(taken);exchange(items,sorted);}
pub fn is_sorted<a,T:order::Ord>(items:(&a T[]))->bool{for i in 1..items.len(){if order::less(&items[i],&items[i-1]){return false;}}return true;}
// Index of the smallest/largest element (first one on ties); the vector must not be empty.
pub fn min_index<a,T:order::Ord>(items:(&a T[]))->u64{assert(items.len()!=0);mut best=0;for i in 1..items.len(){if order::less(&items[i],&items[best]){best=i;}}return best;}
pub fn max_index<a,T:order::Ord>(items:(&a T[]))->u64{assert(items.len()!=0);mut best=0;for i in 1..items.len(){if order::less(&items[best],&items[i]){best=i;}}return best;}
