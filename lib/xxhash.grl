// XXH64 (xxHash, Yann Collet; BSD 2-clause algorithm): the 64-bit hash zstd frames use for their
// content checksum and Abundance uses for fixture identities. Matches XXH64() for any seed.
module xxhash;
use bytes;

const P1: u64 = 11400714785074694791;
const P2: u64 = 14029467366897019727;
const P3: u64 = 1609587929392839161;
const P4: u64 = 9650029242287828579;
const P5: u64 = 2870177450012600261;

fn rotl(x: u64, r: u64) -> u64 {
    return (x << r) | (x >> (64 - r));
}

fn read64<a>(data: &a [u8], at: u64) -> u64 {
    return bytes::load_u64(data, at);
}

fn read32<a>(data: &a [u8], at: u64) -> u64 {
    // Written out: a loop with a `u64(...)` per byte was a runtime cast call per byte.
    return data[at] | (data[at + 1] << 8) | (data[at + 2] << 16) | (data[at + 3] << 24);
}

fn round(acc: u64, lane: u64) -> u64 {
    return wrapping_mul(rotl(wrapping_add(acc, wrapping_mul(lane, P2)), 31), P1);
}

fn merge(acc: u64, lane: u64) -> u64 {
    return wrapping_add(wrapping_mul(acc ^ round(0, lane), P1), P4);
}

// XXH64 of `data` with `seed`.
pub fn hash64<a>(data: &a [u8], seed: u64) -> u64 {
    n := data.len();
    mut at: u64 = 0;
    mut h: u64 = 0;
    if n >= 32 {
        mut v1 = wrapping_add(wrapping_add(seed, P1), P2);
        mut v2 = wrapping_add(seed, P2);
        mut v3 = seed;
        mut v4 = wrapping_sub(seed, P1);
        while at + 32 <= n {
            v1 = round(v1, read64(data, at));
            v2 = round(v2, read64(data, at + 8));
            v3 = round(v3, read64(data, at + 16));
            v4 = round(v4, read64(data, at + 24));
            at += 32;
        }
        h = wrapping_add(wrapping_add(rotl(v1, 1), rotl(v2, 7)), wrapping_add(rotl(v3, 12), rotl(v4, 18)));
        h = merge(h, v1);
        h = merge(h, v2);
        h = merge(h, v3);
        h = merge(h, v4);
    } else {
        h = wrapping_add(seed, P5);
    }
    h = wrapping_add(h, n);
    while at + 8 <= n {
        h = wrapping_add(wrapping_mul(rotl(h ^ round(0, read64(data, at)), 27), P1), P4);
        at += 8;
    }
    if at + 4 <= n {
        h = wrapping_add(wrapping_mul(rotl(h ^ wrapping_mul(read32(data, at), P1), 23), P2), P3);
        at += 4;
    }
    while at < n {
        h = wrapping_mul(rotl(h ^ wrapping_mul(u64(data[at]), P5), 11), P1);
        at += 1;
    }
    h = wrapping_mul(h ^ (h >> 33), P2);
    h = wrapping_mul(h ^ (h >> 29), P3);
    return h ^ (h >> 32);
}
