module env;
use host;
use core;

// Command-line arguments; args()[0] is the program path.
pub fn args()->string[]{
    mut out=string[];for i in host::argc(){a:=host::arg(i);out.push(a.text());}return out;
}
// An environment variable, or None when unset (an empty value counts as set only if non-empty).
pub fn var<a>(name:&a [u8])->string?{
    value:=host::env(name);if value.len()==0{return core::none<string>();}return core::some(value.text());
}
