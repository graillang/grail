module iter;

use core;

// Lazy iteration. `Iter<T>` is a closure that produces the next item or None; its `next` method
// makes it iterable by `for x in it` (the iterator protocol: any record with
// `fn next(self: &mut Self) -> T?`). Adapters wrap one iterator in another, so nothing runs and
// nothing is allocated until a loop or `collect` pulls items through.
pub struct Iter<T> { step: FnMut() -> T? }

// The iterator interface: anything with a `next` that yields its items (Rust's Iterator). Generic
// code takes `I: iter::Iterator` and names the item type `I::Item`.
pub interface Iterator {
    type Item;
    fn next(self: &mut Self) -> Self::Item?;
}

impl<T> Iterator for Iter<T> {
    type Item = T;
    fn next(self: &mut Self) -> T? {
        return (self.step)();
    }
}


impl<T> Iter<T> {
    pub fn next(self: &mut Self) -> T? {
        return (self.step)();
    }
    // The adapters as methods, so a chain reads left to right:
    // `iter::refs(&v).filter(|x: &&u64| -> bool **x > 1).map(|x: &u64| -> u64 *x * 2).collect()`.
    pub fn map<U>(self: Self, f: FnMut(T) -> U) -> Iter<U> {
        return map(self, f);
    }
    pub fn filter<a>(self: Self, keep: FnMut((&a T)) -> bool) -> Iter<T> {
        return filter(self, keep);
    }
    pub fn take(self: Self, n: u64) -> Iter<T> {
        return take(self, n);
    }
    pub fn enumerate(self: Self) -> Iter<(u64, T)> {
        return enumerate(self);
    }
    pub fn zip<B>(self: Self, other: Iter<B>) -> Iter<(T, B)> {
        return zip(self, other);
    }
    pub fn collect(self: Self) -> T[] {
        return collect(self);
    }
    // How many items remain (consuming them).
    pub fn count(self: Self) -> u64 {
        mut src = self;
        mut n = 0;
        while let Some(x) = src.next() {
            n = n + 1;
        }
        return n;
    }
    // Combine every item into one value, starting from `init`.
    pub fn fold<A>(self: Self, init: A, f: FnMut(A, T) -> A) -> A {
        mut src = self;
        mut acc = init;
        mut g = f;
        while let Some(x) = src.next() {
            acc = g(acc, x);
        }
        return acc;
    }
}

// An iterator from any closure that yields the next item.
pub fn from_fn<T>(step: FnMut() -> T?) -> Iter<T> {
    return Iter { step: step };
}

// lo, lo+1, ..., hi-1.
pub fn upto(lo: u64, hi: u64) -> Iter<u64> {
    mut i = lo;
    return Iter { step: || -> u64? {
        if i < hi {
            v := i;
            i = i + 1;
            return Some(v);
        }
        return None;
    } };
}

// Build an iterator from a step closure. This is the seam a module outside `iter` uses to make its
// own iterable (a map's keys, a file's lines): `Iter`'s field is private so that every iterator in
// the language is built one way and behaves the same in a `for` header.
pub fn from_step<T>(step: FnMut() -> T?) -> Iter<T> {
    return Iter { step: step };
}

// Every element of a vector you keep, in order, as references into it: the vector stays borrowed
// (and unchangeable) for as long as the iterator or any item it handed out is in use.
pub fn refs<a, T>(v: &a T[]) -> Iter<(&a T)> {
    mut i = 0;
    return Iter { step: || -> (&a T)? {
        if i < v.len() {
            p := i;
            i = i + 1;
            return Some(&v[p]);
        }
        return None;
    } };
}

// Every element of a vector, in order, moved out one at a time. (To iterate a vector you keep, use
// `refs(&v)` or `for x in &v`.)
pub fn of<T>(v: T[]) -> Iter<T> {
    mut src = v;
    mut rev = T[];
    while let Some(popped) = src.pop() { rev.push(popped); }
    return Iter { step: || -> T? {
        return rev.pop();
    } };
}

pub fn map<T, U>(it: Iter<T>, f: FnMut(T) -> U) -> Iter<U> {
    mut src = it;
    mut g = f;
    return Iter { step: || -> U? {
        match src.next() {
            Some(x) => {
                return Some(g(x));
            },
            None => {
                return None;
            }
        }
    } };
}

pub fn filter<a, T>(it: Iter<T>, keep: FnMut((&a T)) -> bool) -> Iter<T> {
    mut src = it;
    mut k = keep;
    return Iter { step: || -> T? {
        while let Some(x) = src.next() {
            if k(&x) {
                return Some(x);
            }
        }
        return None;
    } };
}

// At most the first n items.
pub fn take<T>(it: Iter<T>, n: u64) -> Iter<T> {
    mut src = it;
    mut left = n;
    return Iter { step: || -> T? {
        if left == 0 {
            return None;
        }
        left = left - 1;
        return src.next();
    } };
}

pub fn enumerate<T>(it: Iter<T>) -> Iter<(u64, T)> {
    mut src = it;
    mut n = 0;
    return Iter { step: || -> (u64, T)? {
        match src.next() {
            Some(x) => {
                i := n;
                n = n + 1;
                return Some((i, x));
            },
            None => {
                return None;
            }
        }
    } };
}

// Pairs items from both until either runs out.
pub fn zip<A, B>(left: Iter<A>, right: Iter<B>) -> Iter<(A, B)> {
    mut l = left;
    mut r = right;
    return Iter { step: || -> (A, B)? {
        match l.next() {
            Some(a) => {
                match r.next() {
                    Some(b) => {
                        return Some((a, b));
                    },
                    None => {
                        return None;
                    }
                }
            },
            None => {
                return None;
            }
        }
    } };
}

// Every remaining item, in order, in a new vector.
pub fn collect<T>(it: Iter<T>) -> T[] {
    mut src = it;
    mut out = T[];
    while let Some(x) = src.next() {
        out.push(x);
    }
    return out;
}
