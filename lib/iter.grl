module iter;

use core;

// Lazy iteration. `Iter<T>` is a closure that produces the next item or None; its `next` method
// makes it iterable by `for x in it` (the iterator protocol: any record with
// `fn next(self: &mut Self) -> T?`). Adapters wrap one iterator in another, so nothing runs and
// nothing is allocated until a loop or `collect` pulls items through.
pub struct Iter<T> { step: FnMut() -> T? }

// The iterator interface: anything with a `next` that yields its items (Rust's Iterator). Generic
// code takes `I: iter::Iterator` and names the item type `I::Item`.
pub interface Iterator {
    type Item;
    fn next(self: &mut Self) -> Self::Item?;
    // Every item combined into one value, starting from `init`. Adapters override it to pass a
    // composed callback down to the iterator they wrap (internal iteration, as Rust's `fold`): the
    // whole chain then runs as the innermost iterator's one loop, which the optimiser can vectorise,
    // instead of a `next` call per item that loops inside each filter.
    fn fold<A, G: FnMut(A, Self::Item) -> A>(self: Self, init: A, g: G) -> A {
        mut it = self;
        mut acc = init;
        mut f = g;
        while let Some(x) = it.next() {
            acc = f(acc, x);
        }
        return acc;
    }
}

impl<T> Iterator for Iter<T> {
    type Item = T;
    fn next(self: &mut Self) -> T? {
        return (self.step)();
    }
}

impl<T> Iter<T> {
    pub fn next(self: &mut Self) -> T? {
        return (self.step)();
    }
    // The adapters as methods, so a chain reads left to right:
    // `iter::refs(&v).filter(|x: &&u64| -> bool **x > 1).map(|x: &u64| -> u64 *x * 2).collect()`.
    pub fn map<U>(self: Self, f: FnMut<Owned>(T) -> U) -> Iter<U> {
        mut src = self;
        mut g = f;
        return Iter { step: || -> U? {
            match src.next() {
                Some(x) => {
                    return Some(g(x));
                },
                None => {
                    return None;
                }
            }
        } };
    }
    pub fn filter<a>(self: Self, keep: FnMut<Owned>((&a T)) -> bool) -> Iter<T> {
        mut src = self;
        mut k = keep;
        return Iter { step: || -> T? {
            while let Some(x) = src.next() {
                if k(&x) {
                    return Some(x);
                }
            }
            return None;
        } };
    }
    // At most the first n items.
    pub fn take(self: Self, n: u64) -> Iter<T> {
        mut src = self;
        mut left = n;
        return Iter { step: || -> T? {
            if left == 0 {
                return None;
            }
            left = left - 1;
            return src.next();
        } };
    }
    pub fn enumerate(self: Self) -> Iter<(u64, T)> {
        mut src = self;
        mut n = 0;
        return Iter { step: || -> (u64, T)? {
            match src.next() {
                Some(x) => {
                    i := n;
                    n = n + 1;
                    return Some((i, x));
                },
                None => {
                    return None;
                }
            }
        } };
    }
    // Pairs items from both until either runs out.
    pub fn zip<B>(self: Self, other: Iter<B>) -> Iter<(T, B)> {
        mut l = self;
        mut r = other;
        return Iter { step: || -> (T, B)? {
            match l.next() {
                Some(a) => {
                    match r.next() {
                        Some(b) => {
                            return Some((a, b));
                        },
                        None => {
                            return None;
                        }
                    }
                },
                None => {
                    return None;
                }
            }
        } };
    }
    // Every remaining item, in order, in a new vector.
    pub fn collect(self: Self) -> T[] {
        mut src = self;
        mut out = T[];
        while let Some(x) = src.next() {
            out.push(x);
        }
        return out;
    }
    // How many items remain (consuming them).
    pub fn count(self: Self) -> u64 {
        mut src = self;
        mut n = 0;
        while let Some(x) = src.next() {
            n = n + 1;
        }
        return n;
    }
    // Combine every item into one value, starting from `init`.
    pub fn fold<A>(self: Self, init: A, f: FnMut(A, T) -> A) -> A {
        mut src = self;
        mut acc = init;
        mut g = f;
        while let Some(x) = src.next() {
            acc = g(acc, x);
        }
        return acc;
    }
    // The one value `f` combines every item into, or None when there are none.
    pub fn reduce(self: Self, f: FnMut(T, T) -> T) -> T? {
        mut src = self;
        mut g = f;
        if let Some(seed) = src.next() {
            mut value = seed;
            while let Some(x) = src.next() {
                value = g(value, x);
            }
            return Some(value);
        }
        return None;
    }
    // At most the first `n` items are dropped.
    pub fn skip(self: Self, n: u64) -> Iter<T> {
        mut src = self;
        mut left = n;
        mut skipped = false;
        return Iter { step: || -> T? {
            if !skipped {
                while left > 0 {
                    if src.next().is_none() {
                        left = 0;
                    } else {
                        left = left - 1;
                    }
                }
                skipped = true;
            }
            return src.next();
        } };
    }
    // Every item of this iterator, then every item of `other`.
    pub fn chain(self: Self, other: Iter<T>) -> Iter<T> {
        mut first = self;
        mut second = other;
        mut on_second = false;
        return Iter { step: || -> T? {
            if !on_second {
                if let Some(x) = first.next() {
                    return Some(x);
                }
                on_second = true;
            }
            return second.next();
        } };
    }
    // Every item in reverse order (the whole iterator is pulled through first).
    pub fn rev(self: Self) -> Iter<T> {
        mut src = self;
        mut items = T[];
        while let Some(x) = src.next() {
            items.push(x);
        }
        return Iter { step: || -> T? {
            if items.len() == 0 {
                return None;
            }
            return Some(items.pop()!);
        } };
    }
    // One iterator per item, concatenated, in order.
    pub fn flat_map<U>(self: Self, f: FnMut<Owned>(T) -> Iter<U>) -> Iter<U> {
        mut src = self;
        mut g = f;
        mut current = from_fn(|| -> U? {
            return None;
        });
        mut have = false;
        return Iter { step: || -> U? {
            while true {
                if have {
                    if let Some(x) = current.next() {
                        return Some(x);
                    }
                    have = false;
                }
                match src.next() {
                    Some(v) => {
                        current = g(v);
                        have = true;
                    },
                    None => {
                        return None;
                    }
                }
            }
            return None;
        } };
    }
    // The mapped value of every item that has one.
    pub fn filter_map<U>(self: Self, f: FnMut<Owned>(T) -> U?) -> Iter<U> {
        mut src = self;
        mut g = f;
        return Iter { step: || -> U? {
            while let Some(x) = src.next() {
                if let Some(v) = g(x) {
                    return Some(v);
                }
            }
            return None;
        } };
    }
    // Calls `f` on every item, in order; the iterator is consumed.
    pub fn for_each(self: Self, f: FnMut(T) -> unit) {
        mut src = self;
        mut g = f;
        while let Some(x) = src.next() {
            g(x);
        }
        return ();
    }
    // `sum` and `min`/`max` are not here. `sum` needs `T` to be a number, and an impl of a declared
    // type must name that type's own parameters (`impl Iter<u64> { ... }` is not a header this
    // compiler accepts). `min`/`max` need `T: order::Ord`, and a bound stated on the impl header is
    // not carried by the type argument a method's receiver hands back, so `order::less` inside such
    // a body is refused. Both are one call away: `it.collect().sum()`, `it.collect().min()`.
    // Whether any item passes `test` (stops at the first that does).
    pub fn any(self: Self, test: FnMut(T) -> bool) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if t(x) {
                return true;
            }
        }
        return false;
    }
    // Whether every item passes `test` (stops at the first that does not).
    pub fn all(self: Self, test: FnMut(T) -> bool) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if !t(x) {
                return false;
            }
        }
        return true;
    }
    // The first item passing `test`, or None.
    pub fn find(self: Self, test: FnMut((&T)) -> bool) -> T? {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if t(&x) {
                return Some(x);
            }
        }
        return None;
    }
    // The index of the first item passing `test`, or None.
    pub fn position(self: Self, test: FnMut((&T)) -> bool) -> u64? {
        mut src = self;
        mut t = test;
        mut i = 0;
        while let Some(x) = src.next() {
            if t(&x) {
                return Some(i);
            }
            i = i + 1;
        }
        return None;
    }
    // The last item, or None.
    pub fn last(self: Self) -> T? {
        mut items = self.collect();
        if items.len() == 0 {
            return None;
        }
        return Some(items.remove(items.len() - 1));
    }
}

// An iterator from any closure that yields the next item. This is the seam a module outside `iter`
// uses to make its own iterable (a map's keys, a file's lines): `Iter`'s field is private so that
// every iterator in the language is built one way and behaves the same in a `for` header.
pub fn from_fn<T>(step: FnMut<Owned>() -> T?) -> Iter<T> {
    return Iter { step: step };
}

// lo, lo+1, ..., hi-1.
pub fn upto(lo: u64, hi: u64) -> Iter<u64> {
    mut i = lo;
    return Iter { step: || -> u64? {
        if i < hi {
            v := i;
            i = i + 1;
            return Some(v);
        }
        return None;
    } };
}

// Every element of a vector you keep, in order, as references into it: the vector stays borrowed
// (and unchangeable) for as long as the iterator or any item it handed out is in use.
pub fn refs<a, T>(v: &a T[]) -> Iter<(&a T)> {
    mut i = 0;
    return Iter { step: || -> (&a T)? {
        if i < v.len() {
            p := i;
            i = i + 1;
            return Some(&v[p]);
        }
        return None;
    } };
}

// Every element of a vector, in order, moved out one at a time. (To iterate a vector you keep, use
// `refs(&v)` or `for x in &v`.)
pub fn of<T>(v: T[]) -> Iter<T> {
    mut src = v;
    mut rev = src;
    rev.reverse();
    return Iter { step: || -> T? {
        return rev.pop();
    } };
}

// ---- Typed adapters (docs/design/dyn-and-callable-bounds.md, 2c) --------------------------------
// The same chain as `Iter`'s methods, but each adapter is its own type holding its callback by its
// own closure type (`F: FnMut(..)`), so a chain is one nested type, fully specialised: every `next`
// and every callback is a direct call, and nothing is allocated per element. `Iter<T>` stays the
// erased form - for `from_fn`, `dyn Iterator`, or an iterator kept in a field.
//
//     total := iter::over(v).map(|x: u64| -> u64 x * 2).filter(|x: &u64| -> bool *x % 3 == 0)
//         .fold(0, |s: u64, x: u64| -> u64 s + x);

// The elements of a vector, moved out in order (the vector is reversed once, in place).
pub struct VecIter<T> { rev: T[] }
pub fn over<T>(v: T[]) -> VecIter<T> {
    mut r = v;
    r.reverse();
    return VecIter { rev: r };
}
impl<T> Iterator for VecIter<T> {
    type Item = T;
    fn next(self: &mut Self) -> T? {
        if self.rev.len() == 0 {
            return None;
        }
        return Some(self.rev.pop()!);
    }
}
// The elements of a vector, a view or a slice by reference, in order: `v.iter()`, a method of every
// `T[]`, `&T[]` and `&[T]` that needs no `use` line. The vector stays borrowed, and usable, while
// the iterator or any item it handed out is in use. Its `fold` is a counted index loop, so a chain of
// adapters folded over it (`collect`, `count`, `fold`) is one loop the optimiser can unroll and
// vectorise.
pub struct SliceIter<a, T> { v: (&a [T]), at: u64 }
impl<T> T[] {
    pub fn iter<a>(self: (&a T[])) -> SliceIter<a, T> {
        return SliceIter { v: self[:], at: 0 };
    }
}
impl<T> [T] {
    pub fn iter<a>(self: (&a [T])) -> SliceIter<a, T> {
        return SliceIter { v: self, at: 0 };
    }
}
impl<a, T> Iterator for SliceIter<a, T> {
    type Item = (&a T);
    fn next(self: &mut Self) -> (&a T)? {
        if self.at < self.v.len() {
            p := self.at;
            self.at = p + 1;
            return Some(&self.v[p]);
        }
        return None;
    }
    fn fold<A, G: FnMut(A, (&a T)) -> A>(self: Self, init: A, g: G) -> A {
        mut acc = init;
        mut f = g;
        v := self.v;
        mut i = self.at;
        n := v.len();
        while i < n {
            acc = f(acc, &v[i]);
            i += 1;
        }
        return acc;
    }
}
impl<a, T> SliceIter<a, T> {
    pub fn next(self: &mut Self) -> (&a T)? {
        if self.at < self.v.len() {
            p := self.at;
            self.at = p + 1;
            return Some(&self.v[p]);
        }
        return None;
    }
    pub fn map<V, G: FnMut((&a T)) -> V>(self: Self, g: G) -> Map<SliceIter<a, T>, V, G> {
        return Map { it: self, f: g };
    }
    pub fn filter<G: FnMut((&(&a T))) -> bool>(self: Self, keep: G) -> Filter<SliceIter<a, T>, G> {
        return Filter { it: self, keep: keep };
    }
    pub fn take(self: Self, n: u64) -> Take<SliceIter<a, T>> {
        return Take { it: self, left: n };
    }
    pub fn enumerate(self: Self) -> Enumerate<SliceIter<a, T>> {
        return Enumerate { it: self, at: 0 };
    }
    // A counted loop over the slice: no `next` call per item.
    pub fn collect(self: Self) -> (&a T)[] {
        v := self.v;
        mut out: (&a T)[] = [];
        mut i = self.at;
        while i < v.len() {
            out.push(&v[i]);
            i += 1;
        }
        return out;
    }
    pub fn count(self: Self) -> u64 {
        return self.v.len() - self.at;
    }
    pub fn any<G: FnMut((&a T)) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if t(x) {
                return true;
            }
        }
        return false;
    }
    pub fn all<G: FnMut((&a T)) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if !t(x) {
                return false;
            }
        }
        return true;
    }
    pub fn find<G: FnMut((&(&a T))) -> bool>(self: Self, test: G) -> (&a T)? {
        mut kept = self.filter(test);
        return kept.next();
    }
}
// Each adapter names its item type (`U`, `T`), so the next adapter's callback is typed by it.
pub struct Map<I, U, F> { it: I, f: F }
impl<I: Iterator, U, F: FnMut(I::Item) -> U> Iterator for Map<I, U, F> {
    type Item = U;
    fn next(self: &mut Self) -> U? {
        match self.it.next() {
            Some(x) => {
                g := &mut self.f;
                return Some(g(x));
            },
            None => {
                return None;
            }
        }
    }
    fn fold<A, G: FnMut(A, U) -> A>(self: Self, init: A, g: G) -> A {
        mut h = g;
        mut m = self.f;
        return self.it.fold(init, |a: A, x: I::Item| -> A h(a, m(x)));
    }
}
pub struct Filter<I, F> { it: I, keep: F }
impl<I: Iterator, F: FnMut((&I::Item)) -> bool> Iterator for Filter<I, F> {
    type Item = I::Item;
    fn next(self: &mut Self) -> I::Item? {
        while let Some(x) = self.it.next() {
            (kept, item) := tested(&mut self.keep, x);
            if kept {
                return Some(item);
            }
        }
        return None;
    }
    fn fold<A, G: FnMut(A, I::Item) -> A>(self: Self, init: A, g: G) -> A {
        mut h = g;
        mut k = self.keep;
        return self.it.fold(init, |a: A, x: I::Item| -> A {
            (kept, item) := tested(&mut k, x);
            if kept {
                return h(a, item);
            }
            return a;
        });
    }
}
// A filter's test of one item, from code generic over the item type `T`. The item is a parameter of
// type `T` here, so `&x` is a `&T` - for `v.iter()`'s items a `&&T`, as the predicate takes - where
// written on an item the adapter holds as its concrete type it would reborrow the reference to a
// `&T`. It is handed back with the answer, so an owned item is not consumed.
fn tested<b, T, K: FnMut((&T)) -> bool>(keep: (&b mut K), x: T) -> (bool, T) {
    kept := keep(&x);
    return (kept, x);
}
// One step of a filtered fold: the item goes on to `step` when `keep` accepts it.
fn filter_step<b, d, T, A, K: FnMut((&T)) -> bool, H: FnMut(A, T) -> A>(keep: (&b mut K), step: (&d mut H), acc: A, x: T) -> A {
    if keep(&x) {
        return step(acc, x);
    }
    return acc;
}
// Each adapter's step is written twice - in its `Iterator` impl and in the inherent `next` a `for`
// loop calls - so neither path forwards through the other: the native optimiser does not inline a
// non-leaf call yet. When /root/xinline's early inlining lands, keep one body, make the other
// forward to it, and check in the asm that the hop is inlined away (docs/design/
// dyn-and-callable-bounds.md 5.1).
// The adapters chain as methods on each other, ending in `fold` (the Iterator interface's, which
// each adapter overrides) or a `while let` loop.
impl<T> VecIter<T> {
    pub fn next(self: &mut Self) -> T? {
        if self.rev.len() == 0 {
            return None;
        }
        return Some(self.rev.pop()!);
    }
    pub fn map<V, G: FnMut(T) -> V>(self: Self, g: G) -> Map<VecIter<T>, V, G> {
        return Map { it: self, f: g };
    }
    pub fn filter<G: FnMut((&T)) -> bool>(self: Self, keep: G) -> Filter<VecIter<T>, G> {
        return Filter { it: self, keep: keep };
    }
    pub fn take(self: Self, n: u64) -> Take<VecIter<T>> {
        return Take { it: self, left: n };
    }
    pub fn enumerate(self: Self) -> Enumerate<VecIter<T>> {
        return Enumerate { it: self, at: 0 };
    }
    pub fn collect(self: Self) -> T[] {
        mut src = self;
        mut out: T[] = [];
        while let Some(x) = src.next() {
            out.push(x);
        }
        return out;
    }
    pub fn count(self: Self) -> u64 {
        mut src = self;
        mut n = 0;
        while let Some(x) = src.next() {
            n += 1;
        }
        return n;
    }
    pub fn any<G: FnMut(T) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if t(x) {
                return true;
            }
        }
        return false;
    }
    pub fn all<G: FnMut(T) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if !t(x) {
                return false;
            }
        }
        return true;
    }
    pub fn find<G: FnMut((&T)) -> bool>(self: Self, test: G) -> T? {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            (hit, item) := tested(&mut t, x);
            if hit {
                return Some(item);
            }
        }
        return None;
    }
}
// (An inherent block over an adapter states the same parameters and bounds as its Iterator impl.)
impl<I: Iterator, U, F: FnMut(I::Item) -> U> Map<I, U, F> {
    pub fn next(self: &mut Self) -> U? {
        match self.it.next() {
            Some(x) => {
                g := &mut self.f;
                return Some(g(x));
            },
            None => {
                return None;
            }
        }
    }
    pub fn map<V, G: FnMut(U) -> V>(self: Self, g: G) -> Map<Map<I, U, F>, V, G> {
        return Map { it: self, f: g };
    }
    pub fn filter<G: FnMut((&U)) -> bool>(self: Self, keep: G) -> Filter<Map<I, U, F>, G> {
        return Filter { it: self, keep: keep };
    }
    pub fn take(self: Self, n: u64) -> Take<Map<I, U, F>> {
        return Take { it: self, left: n };
    }
    pub fn enumerate(self: Self) -> Enumerate<Map<I, U, F>> {
        return Enumerate { it: self, at: 0 };
    }
    // Through the wrapped iterator's `fold`, so the chain stays its one loop.
    pub fn collect(self: Self) -> U[] {
        mut m = self.f;
        mut out: U[] = [];
        return self.it.fold(out, |acc: U[], x: I::Item| -> U[] {
            mut o = acc;
            o.push(m(x));
            return o;
        });
    }
    pub fn count(self: Self) -> u64 {
        mut m = self.f;
        return self.it.fold(0, |n: u64, x: I::Item| -> u64 {
            y := m(x);
            return n + 1;
        });
    }
    pub fn any<G: FnMut(U) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if t(x) {
                return true;
            }
        }
        return false;
    }
    pub fn all<G: FnMut(U) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if !t(x) {
                return false;
            }
        }
        return true;
    }
    pub fn find<G: FnMut((&U)) -> bool>(self: Self, test: G) -> U? {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            (hit, item) := tested(&mut t, x);
            if hit {
                return Some(item);
            }
        }
        return None;
    }
}
impl<I: Iterator, F: FnMut((&I::Item)) -> bool> Filter<I, F> {
    pub fn next(self: &mut Self) -> I::Item? {
        while let Some(x) = self.it.next() {
            (kept, item) := tested(&mut self.keep, x);
            if kept {
                return Some(item);
            }
        }
        return None;
    }
    pub fn map<V, G: FnMut(I::Item) -> V>(self: Self, g: G) -> Map<Filter<I, F>, V, G> {
        return Map { it: self, f: g };
    }
    pub fn filter<G: FnMut((&I::Item)) -> bool>(self: Self, keep: G) -> Filter<Filter<I, F>, G> {
        return Filter { it: self, keep: keep };
    }
    pub fn take(self: Self, n: u64) -> Take<Filter<I, F>> {
        return Take { it: self, left: n };
    }
    pub fn enumerate(self: Self) -> Enumerate<Filter<I, F>> {
        return Enumerate { it: self, at: 0 };
    }
    // A `next` loop: the items kept may be references (`v.iter()`'s), which a fold's callback could
    // not store past the call it is handed each one for.
    pub fn collect(self: Self) -> I::Item[] {
        mut src = self;
        mut out: I::Item[] = [];
        while let Some(x) = src.next() {
            out.push(x);
        }
        return out;
    }
    pub fn count(self: Self) -> u64 {
        mut k = self.keep;
        mut one = |n: u64, x: I::Item| -> u64 n + 1;
        return self.it.fold(0, |n: u64, x: I::Item| -> u64 filter_step(&mut k, &mut one, n, x));
    }
    pub fn any<G: FnMut(I::Item) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if t(x) {
                return true;
            }
        }
        return false;
    }
    pub fn all<G: FnMut(I::Item) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if !t(x) {
                return false;
            }
        }
        return true;
    }
    pub fn find<G: FnMut((&I::Item)) -> bool>(self: Self, test: G) -> I::Item? {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            (hit, item) := tested(&mut t, x);
            if hit {
                return Some(item);
            }
        }
        return None;
    }
}
// At most the first `n` items of the iterator it wraps.
pub struct Take<I> { it: I, left: u64 }
impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;
    fn next(self: &mut Self) -> I::Item? {
        if self.left == 0 {
            return None;
        }
        self.left = self.left - 1;
        return self.it.next();
    }
}
impl<I: Iterator> Take<I> {
    pub fn next(self: &mut Self) -> I::Item? {
        if self.left == 0 {
            return None;
        }
        self.left = self.left - 1;
        return self.it.next();
    }
    pub fn map<V, G: FnMut(I::Item) -> V>(self: Self, g: G) -> Map<Take<I>, V, G> {
        return Map { it: self, f: g };
    }
    pub fn filter<G: FnMut((&I::Item)) -> bool>(self: Self, keep: G) -> Filter<Take<I>, G> {
        return Filter { it: self, keep: keep };
    }
    pub fn take(self: Self, n: u64) -> Take<Take<I>> {
        return Take { it: self, left: n };
    }
    pub fn enumerate(self: Self) -> Enumerate<Take<I>> {
        return Enumerate { it: self, at: 0 };
    }
    pub fn collect(self: Self) -> I::Item[] {
        mut src = self;
        mut out: I::Item[] = [];
        while let Some(x) = src.next() {
            out.push(x);
        }
        return out;
    }
    pub fn count(self: Self) -> u64 {
        mut src = self;
        mut n = 0;
        while let Some(x) = src.next() {
            n += 1;
        }
        return n;
    }
    pub fn any<G: FnMut(I::Item) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if t(x) {
                return true;
            }
        }
        return false;
    }
    pub fn all<G: FnMut(I::Item) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if !t(x) {
                return false;
            }
        }
        return true;
    }
    pub fn find<G: FnMut((&I::Item)) -> bool>(self: Self, test: G) -> I::Item? {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            (hit, item) := tested(&mut t, x);
            if hit {
                return Some(item);
            }
        }
        return None;
    }
}
// Each item with its position, counting from 0.
pub struct Enumerate<I> { it: I, at: u64 }
impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (u64, I::Item);
    fn next(self: &mut Self) -> (u64, I::Item)? {
        match self.it.next() {
            Some(x) => {
                i := self.at;
                self.at = i + 1;
                return Some((i, x));
            },
            None => {
                return None;
            }
        }
    }
    fn fold<A, G: FnMut(A, (u64, I::Item)) -> A>(self: Self, init: A, g: G) -> A {
        mut h = g;
        mut n = self.at;
        return self.it.fold(init, |a: A, x: I::Item| -> A {
            i := n;
            n = i + 1;
            return h(a, (i, x));
        });
    }
}
impl<I: Iterator> Enumerate<I> {
    pub fn next(self: &mut Self) -> (u64, I::Item)? {
        match self.it.next() {
            Some(x) => {
                i := self.at;
                self.at = i + 1;
                return Some((i, x));
            },
            None => {
                return None;
            }
        }
    }
    pub fn map<V, G: FnMut((u64, I::Item)) -> V>(self: Self, g: G) -> Map<Enumerate<I>, V, G> {
        return Map { it: self, f: g };
    }
    pub fn filter<G: FnMut((&(u64, I::Item))) -> bool>(self: Self, keep: G) -> Filter<Enumerate<I>, G> {
        return Filter { it: self, keep: keep };
    }
    pub fn take(self: Self, n: u64) -> Take<Enumerate<I>> {
        return Take { it: self, left: n };
    }
    pub fn enumerate(self: Self) -> Enumerate<Enumerate<I>> {
        return Enumerate { it: self, at: 0 };
    }
    pub fn collect(self: Self) -> (u64, I::Item)[] {
        mut src = self;
        mut out: (u64, I::Item)[] = [];
        while let Some(x) = src.next() {
            out.push(x);
        }
        return out;
    }
    pub fn count(self: Self) -> u64 {
        mut src = self;
        mut n = 0;
        while let Some(x) = src.next() {
            n += 1;
        }
        return n;
    }
    pub fn any<G: FnMut((u64, I::Item)) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if t(x) {
                return true;
            }
        }
        return false;
    }
    pub fn all<G: FnMut((u64, I::Item)) -> bool>(self: Self, test: G) -> bool {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            if !t(x) {
                return false;
            }
        }
        return true;
    }
    pub fn find<G: FnMut((&(u64, I::Item))) -> bool>(self: Self, test: G) -> (u64, I::Item)? {
        mut src = self;
        mut t = test;
        while let Some(x) = src.next() {
            (hit, item) := tested(&mut t, x);
            if hit {
                return Some(item);
            }
        }
        return None;
    }
}
// Combine every item of a typed iterator into one value, starting from `init`.
pub fn fold_all<I: Iterator, A, F: FnMut(A, I::Item) -> A>(it: I, init: A, f: F) -> A {
    return it.fold(init, f);
}
