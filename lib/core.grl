module core;

enum OptionStorage<T> { None, Some(T) }

pub fn some<T>(value:T)->T?{return OptionStorage::Some(value);}
pub fn none<T>()->T?{return OptionStorage::None;}
pub fn unwrap_option<T>(value:T?)->T{return value!;}
pub fn discard<T>(value:T)->unit{return ();}
pub fn identity<T>(value:T)->T{return value;}

pub fn replace<a,T>(slot:(&a mut T),value:T)->T{return exchange(slot,value);}

impl<T> OptionStorage<T>{
    pub fn is_some<a>(self:(&a T?))->bool{match self{Some(v)=>{return true;},None=>{return false;}}}
    pub fn is_none<a>(self:(&a T?))->bool{match self{Some(v)=>{return false;},None=>{return true;}}}
    pub fn unwrap_or(self:T?,fallback:T)->T{match self{Some(v)=>{return v;},None=>{return fallback;}}}
    pub fn map<U>(self:T?,f:FnMut(T)->U)->U?{mut call=f;match self{Some(v)=>{return OptionStorage::Some(call(v));},None=>{return OptionStorage::None;}}}
    pub fn ok_or<E>(self:T?,error:E)->T | E{match self{Some(v)=>{return v;},None=>{return error;}}}
}

// The same bits read as a signed value: a word whose top bit is set is a negative count in two's
// complement, which is how a platform reports a time before 1970 or an error passed as a status.
// `i64(x)` is a checked conversion and refuses those values, so the reinterpretation is written out.
pub fn as_i64(value:u64)->i64{
    if value>9223372036854775807{return i64(0)-i64(18446744073709551615-value)-i64(1);}
    return i64(value);
}
