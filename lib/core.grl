module core;
use result;

// `T?` is `result::Option<T>`: the option type and its methods live in `lib/result.grl` with
// `Result<T, E>`, and this module imports it so every program that could write `T?` still can. The
// functions below stay for the desugarings that name them; `Some(value)`/`None` is how a program
// constructs an optional value (the compiler refuses `core::some`/`core::none` by name).

pub fn some<T>(value:T)->T?{return result::Option::Some(value);}
pub fn none<T>()->T?{return result::Option::None;}
pub fn unwrap_option<T>(value:T?)->T{return value!;}
pub fn discard<T>(value:T)->unit{return ();}
pub fn identity<T>(value:T)->T{return value;}

pub fn replace<a,T>(slot:(&a mut T),value:T)->T{return exchange(slot,value);}

// The same bits read as a signed value: a word whose top bit is set is a negative count in two's
// complement, which is how a platform reports a time before 1970 or an error passed as a status.
// `i64(x)` is a checked conversion and refuses those values, so the reinterpretation is written out.
// C's `(u32)x` for a signed value: the low 32 bits, no check. `u32(x)` is Grail's checked
// conversion and traps on a negative value ("negative value converted to an unsigned type"), which
// is right for a count and wrong for a ported `static_cast<u32>` (C++ wraps: -1 is 4294967295). A
// truncation says so at the call, so a program still cannot narrow by accident.
pub fn trunc_u32(value:i64)->u32{return u32(value & 4294967295);}
pub fn as_i64(value:u64)->i64{
    if value>9223372036854775807{return i64(0)-i64(18446744073709551615-value)-i64(1);}
    return i64(value);
}

