module pool;

// Data-parallel jobs over owned values (docs/design/parallelism.md, stage 1).
//
// THE OWNERSHIP RULE, in one line: everything a job's closure touches it owns. A job takes its
// inputs by value (vector elements are moved into it), builds an owned result, and no reference
// ever crosses a job boundary - so no two jobs can address the same memory, and the compiler needs
// no new property for this stage.
//
// What the checker enforces here, and what it still does not:
//   - checked, structurally, through the compiler's transferable/shareable classification: the item,
//     the result, the shared context AND the closure's captured environment. A `handle` (file,
//     socket, window) is thread-affine and carries no audited classification, so a handle - bare,
//     nested in a record, or captured by the closure - is refused by name:
//         cannot share closure capture `h`: h.file is thread-affine (a foreign handle with no
//         audited classification)
//     An `FnMut` closure is refused (concurrent workers would race on its own environment, so a
//     capture is written through a Mutex or the result is owned instead); a `Task` handle, an
//     exclusive borrow, a mutable slice and a type parameter with no capability proof are refused
//     for the same reason. Plain data - integers, floats, bytes and records/enums of them - is
//     accepted, and so is an audited declaration (`handle File: transferable;` - which is still not
//     shareable unless it says `transferable, shareable`).
//   - not checked: whether the *foreign library* behind a value is safe on another thread is what an
//     audited declaration states, not something this module can see. `CStr`, `CPtr`, `CMutPtr` and
//     `cfn` are deliberately unclassified, so they are refused as "unclassified foreign authority"
//     rather than silently allowed, and there is no audited opt-in for them yet - a legitimate
//     foreign blob cannot cross a job boundary today. `unsafe module` code can build or convert
//     anything, so the classification above is exactly as strong as the safe surface over it. And
//     two jobs writing the same OS descriptor is not a data race any type system can catch; it stays
//     a documented hazard.
//   - also not expressible yet: a job that outlives the call. There is no user-visible job handle;
//     every function here is structured, so a job cannot outlive the memory of its caller.
//
// Ordering is a property of the API, not of the scheduler: results come back in input order
// whatever order the jobs finish in.

// One job per input element, results in input order. The closure captures are read-only on every
// worker, so they must be plain data (see above).
pub fn map<T:Send,U:Send>(items:T[],f:Fn(T)->U)->U[]{
    return parallel_map(items,0,|item: T, unused: u64| -> U f(item));
}

// `count` independent jobs, job `i` calling f(i); results in index order, so this is the parallel
// "map over 0..count" and the shape a chunked loop takes when the caller does its own splits.
pub fn run<U:Send>(count:u64,f:Fn(u64)->U)->U[]{
    mut index=u64[];
    for i in count{index.push(i);}
    return parallel_map(index,0,|i: u64, unused: u64| -> U f(i));
}

// The chunked shape, and the one Abundance's geometry/encode/compress work uses: consume the
// vector, hand each job one contiguous, exclusively owned chunk, and concatenate the results in
// chunk order. Elements are moved into their chunk, never copied, and no chunk can see another.
// The split is still two worth-paying passes over the data (each element leaves the vector and
// enters its chunk) because a split without an exclusive borrow cannot hand out slices; that pass
// is what stage 2's `&mut [T]` chunks remove.
pub fn for_chunks<T:Send,U:Send>(data:T[],chunks:u64,f:Fn(T[])->U)->U[]{
    n:=data.len();
    if n==0{return U[];}
    mut count=chunks;
    if count==0{count=1;}
    if n<count{count=n;}
    size:=(n+count-1)/count;
    // Reverse once so chunks come out in input order while elements are popped (moved), not copied.
    mut source=data;mut rev=T[];
    while source.len()!=0{rev.push(source.pop());}
    mut parts=T[][];
    while rev.len()!=0{
        mut take=size;
        if rev.len()<take{take=rev.len();}
        mut part=T[];
        mut i=0;
        while i<take{part.push(rev.pop());i+=1;}
        parts.push(part);
    }
    return parallel_map(parts,0,|part: T[], unused: u64| -> U f(part));
}

// Two branches of a job graph, both owned: `first` runs on a worker while `second` runs on the
// calling thread, so both make progress and the results come back owned, in the order given.
// This is what "spawn two jobs, then join" means without a handle that could outlive the call.
pub struct Pair<A,B>{first:A,second:B}
pub fn join<A:Send,B:Send>(first:Fn()->A,second:Fn()->B)->Pair<A,B>{
    mut one=u64[0];
    mut done=parallel_map(one,0,|i: u64, unused: u64| -> A first());
    return Pair{first:done.pop(),second:second()};
}
