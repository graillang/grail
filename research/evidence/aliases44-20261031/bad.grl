module f;struct Cell<a>{source:read<a>}fn select<outer,data>(left:ref_mut<outer,Cell<data>>,right:ref_mut<outer,Cell<data>>,n:num)->ref_mut<outer,Cell<data>>{if n{return left;}else{return right;}}pub fn bad(n:num)->num{let a=bytes();push(a,1);let b=bytes();push(b,2);let c=bytes();push(c,3);let left=Cell{source:read(a)};let right=Cell{source:read(b)};let chosen=select(borrow_mut(left),borrow_mut(right),n);exchange(borrow_mut(chosen.source),read(c));for i in 256{push(a,9);}return at(read(left.source),0)+at(read(right.source),0);}