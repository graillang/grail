module cleanup;
use core;
struct Token<a>{span:read<a>,name:string}
fn parse<a>(input:read<a>)->core::Result<Token<a>,string>{
    let local="parse";
    if len(input)==0{return core::err<Token<a>,string>("bad");}
    return core::ok<Token<a>,string>(Token{span:read(input),name:"token"});
}
fn process<a>(input:read<a>)->core::Result<num,string>{
    let before="before";
    let token=parse(read(input))?;
    core::pair("first","second");
    let copied=relay(core::identity(text(read(token.name))),4);
    return core::ok<num,string>(len(token.span)+len(token.name)+len(copied));
}
pub fn run(n:num)->num{
    let source=bytes();push(source,7);
    let result=process(slice(read(source),0,n));
    match result{Ok(value)=>{return value;},Err(reason)=>{return len(reason);}}
}

fn relay<type T>(value:T,n:num)->T{
    if n==0{return value;}
    return relay(value,n-1);
}
