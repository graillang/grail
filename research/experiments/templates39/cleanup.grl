module cleanup;
use core;
struct Token<a>{span:read<a>,name:string}
fn parse<a>(input:read<a>)->core::Result<Token<a>,string>{
    local :="parse";
    if input.len()==0{return core::err<Token<a>,string>("bad");}
    return core::ok<Token<a>,string>(Token{span:&input,name:"token"});
}
fn process<a>(input:read<a>)->core::Result<num,string>{
    before :="before";
    token :=parse(&input)?;
    core::pair("first","second");
    copied :=relay(core::identity(token.name.text()),4);
    return core::ok<num,string>(token.span.len()+token.name.len()+copied.len());
}
pub fn run(n:num)->num{
    mut source=bytes[];source.push(7);
    result :=process(source[0:n]);
    match result{Ok(value)=>{return value;},Err(reason)=>{return reason.len();}}
}

fn relay<T>(value:T,n:num)->T{
    if n==0{return value;}
    return relay(value,n-1);
}
