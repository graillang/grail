module lexer;
use core;
pub struct Token<a>{span:read<a>,spelling:string,offset:num}
pub fn token<a>(span:read<a>,offset:num)->core::Result<Token<a>,string>{
    if span.len()==0{return core::err<Token<a>,string>("empty token");}
    for i in span.len(){
        let c=span[i];
        let valid=((96<c)&(c<123))+((47<c)&(c<58))+(c==95);
        if valid==0{return core::err<Token<a>,string>("invalid token");}
    }
    return core::ok<Token<a>,string>(Token{span:&span,spelling:span.text(),offset:offset});
}
