module scanner;
use core;
use lexer;
fn scan<a>(input:read<a>)->core::Result<num,string>{
    let cursor=lexer::Cursor{source:&input,remaining:&input,name:"scanner"};
    mut index=0;mut count=0;mut hash=0;
    while index<input.len(){
        if input[index]==32{lexer::advance(borrow_mut(cursor),1);index=index+1;continue;}
        let start=index;
        while index<input.len(){
            if input[index]==32{break;}
            index=index+1;
        }
        let token=lexer::token(borrow_mut(cursor),index-start)?;
        let value=core::identity(core::unwrap_option(core::some(token)));
        hash=wrapping_add(wrapping_mul(hash,33),value.span.len()+value.spelling.len()+value.offset+value.spelling[0]);
        count=count+1;
    }
    return core::ok<num,string>(wrapping_add(hash,count*65537));
}
pub fn run<a>(input:read<a>)->num{return scan(&input)!;}
