module lexer;
use core;
pub struct Cursor<a>{source:read<a>,remaining:read<a>,name:string}
pub struct Token<a>{span:read<a>,spelling:string,offset:num}
pub fn advance<outer,a>(cursor:ref_mut<outer,Cursor<a>>,n:num)->unit{
    let remaining=&cursor.remaining;
    exchange(borrow_mut(cursor.remaining),remaining[n:remaining.len()]);
    return ();
}
pub fn token<outer,a>(cursor:ref_mut<outer,Cursor<a>>,n:num)->core::Result<Token<a>,string>{
    let remaining=&cursor.remaining;
    let offset=(&cursor.source).len()-remaining.len();
    let span=remaining[0:n];
    if span.len()==0{return core::err<Token<a>,string>("empty token");}
    for i in span.len(){
        let c=span[i];
        let valid=((96<c)&(c<123))+((47<c)&(c<58))+(c==95);
        if valid==0{return core::err<Token<a>,string>("invalid token");}
    }
    advance(borrow_mut(cursor),n);
    return core::ok<Token<a>,string>(Token{span:&span,spelling:span.text(),offset:offset});
}
