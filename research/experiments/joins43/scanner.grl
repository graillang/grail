module scanner;
use core;
use lexer;
fn scan<a>(input:read<a>)->core::Result<num,string>{
    let cursor=lexer::Cursor{source:read(input),remaining:read(input),name:"scanner"};
    var index=0;var count=0;var hash=0;
    while index<len(input){
        if at(input,index)==32{lexer::advance(borrow_mut(cursor),1);index=index+1;continue;}
        let start=index;
        while index<len(input){
            if at(input,index)==32{break;}
            index=index+1;
        }
        let token=lexer::token(borrow_mut(cursor),index-start)?;
        let value=core::identity(core::unwrap_option(core::some(token)));
        hash=hash*33+len(value.span)+len(value.spelling)+value.offset+at(read(value.spelling),0);
        count=count+1;
    }
    return core::ok<num,string>(hash+count*65537);
}
pub fn run<a>(input:read<a>)->num{return scan(read(input))!;}
