module stats;
pub struct State{hash:num,count:num}
pub fn step<a>(state:ref_mut<a,State>,value:num)->unit{
    let hash=wrapping_add(wrapping_mul(state.hash,33),value);
    exchange(borrow_mut(state.hash),hash);
    let count=state.count+1;
    exchange(borrow_mut(state.count),count);
    return ();
}
