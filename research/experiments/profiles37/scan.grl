module scan;
pub fn scan<a>(input:read<a>)->num{
    var hash=1469598103934665603;
    var words=0;
    var inside=0;
    for repeat in 128{
        for i in len(input){
            let byte=at(input,i);
            let current=word(byte);
            if current{if inside==0{words=words+1;}}
            inside=current;
            hash=(hash*1099511628211)^byte;
        }
    }
    return hash^words;
}
fn word(byte:num)->num{
    if byte==95{return 1;}
    if byte<48{return 0;}
    if byte<58{return 1;}
    if byte<65{return 0;}
    if byte<91{return 1;}
    if byte<97{return 0;}
    if byte<123{return 1;}
    return 0;
}
