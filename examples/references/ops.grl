module ops;
pub struct Record{count:num,name:string}
pub fn replace<a,T>(slot:ref_mut<a,T>,value:T)->T{return exchange(slot,value);}
pub fn update<a>(record:ref_mut<a,Record>)->num{
    before :=replace(borrow_mut(record.name),"newer");
    count :=replace(borrow_mut(record.count),11);
    return before.len()+count;
}
pub fn grow<a>(value:ref_mut<a,u8[]>,byte:num)->unit{value.push(byte);return ();}
pub fn choose<a>(left:ref_mut<a,num>,right:ref_mut<a,num>,flag:num)->ref_mut<a,num>{
    if flag{return left;}
    return right;
}
