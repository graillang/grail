module ops;
pub struct Record{count:num,name:string}
pub fn replace<a,T>(slot:(&mut a T),value:T)->T{return exchange(slot,value);}
pub fn update<a>(record:(&mut a Record))->num{
    before :=replace(borrow_mut(record.name),"newer");
    count :=replace(borrow_mut(record.count),11);
    return before.len()+count;
}
pub fn grow<a>(value:(&mut a u8[]),byte:num)->unit{value.push(byte);return ();}
pub fn choose<a>(left:(&mut a num),right:(&mut a num),flag:num)->(&mut a num){
    if flag{return left;}
    return right;
}
