module ops;
pub struct Record{count:u64,name:string}
pub fn replace<a,T>(slot:(&mut a T),value:T)->T{return exchange(slot,value);}
pub fn update<a>(record:(&mut a Record))->u64{
    before :=replace(borrow_mut(record.name),"newer");
    count :=replace(borrow_mut(record.count),11);
    return before.len()+count;
}
pub fn grow<a>(value:(&mut a u8[]),byte:u64)->unit{value.push(byte);return ();}
pub fn choose<a>(left:(&mut a u64),right:(&mut a u64),flag:u64)->(&mut a u64){
    if flag{return left;}
    return right;
}
