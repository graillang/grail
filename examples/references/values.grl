module values;
use ops;
pub fn run()->num{
    mut source =u8[];source.push(7);
    mut left ="left";right :="right";
    old :=ops::replace(borrow_mut(left),right);
    mut record =ops::Record{count:7,name:"data"};
    previous :=ops::update(borrow_mut(record));
    ops::grow(borrow_mut(source),9);
    return left.len()+old.len()+previous+record.name.len()+record.count+source[1];
}
