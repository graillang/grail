module views;
pub struct Cursor<a>{source:read<a>,name:string}
pub struct Unique<a>{source:mut<a>,name:string}
pub fn source<outer,data>(cursor:(&outer Cursor<data>))->read<data>{return &cursor.source;}
pub fn short<outer,data>(cursor:(&outer Unique<data>))->read<outer>{return &cursor.source;}
pub fn descriptor<outer,data>(slot:(&outer read<data>))->read<data>{return load(slot);}
pub fn peek<outer,data>(slot:(&outer read<data>))->read<data>{return &slot;}
pub fn pointer<outer,data>(slot:(&outer (&data num)))->(&data num){return load(slot);}
pub fn inspect<T>(value:T)->num{frame :=borrow(value);return 7;}
