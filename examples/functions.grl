fn functions()->u64 { return fib(12)+even(8)+odd(7); }
fn fib(n:u64)->u64 {
    mut value=n;
    if 1<n { value=fib(n-1)+fib(n-2); }
    return value;
}
fn even(n:u64)->u64 {
    mut value=1;
    if 0<n { value=odd(n-1); }
    return value;
}
fn odd(n:u64)->u64 {
    mut value=0;
    if 0<n { value=even(n-1); }
    return value;
}
