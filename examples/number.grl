// Parse a borrowed decimal token; no owning copy or allocation.
fn number<a>(token: read<a>) -> num {
    mut value = 0;
    assert(token.len() != 0);
    for i in token.len() {
        digit := token[i];
        assert((47 < digit) & (digit < 58));
        value = value * 10 + (digit - 48);
    }
    return value;
}
