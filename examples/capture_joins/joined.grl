module joined;
use core;
pub struct Cell<a>{source:read<a>,name:string}
struct Holder<a>{source:mut<a>,name:string}
pub fn fill<outer,data>(p:(&mut outer Cell<data>),a:read<data>,b:read<data>,n:u64)->read<data>{
    for i in n{
        if i&1{exchange(borrow_mut(p.source),&a);continue;}
        exchange(borrow_mut(p.source),&b);
        if n==3{break;}
    }
    return &p.source;
}
pub fn pop_loop<outer,data>(input:(&mut outer mut<data>?),slot:(&mut outer Cell<data>),n:u64)->read<data>{
    for i in n{
        old :=core::replace(borrow_mut(input),None);
        match old{
            None=>{break;},
            Some(value)=>{
                holder :=Holder{source:value,name:"holder"};
                span :=&holder.source;drop(holder);
                exchange(borrow_mut(slot.source),span);
            }
        }
    }
    return &slot.source;
}
