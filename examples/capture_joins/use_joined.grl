module use_joined;
use joined;
use core;
pub fn run()->num{
    mut a =bytes[];a.push(7);mut b =bytes[];b.push(11);mut c =bytes[];c.push(13);
    mut cell =joined::Cell{source:&a,name:"cell"};
    mut sum=0;
    sum=sum+(joined::fill(borrow_mut(cell),&b,&c,0))[0];
    sum=sum+(joined::fill(borrow_mut(cell),&b,&c,1))[0];
    sum=sum+(joined::fill(borrow_mut(cell),&b,&c,2))[0];
    sum=sum+(joined::fill(borrow_mut(cell),&b,&c,3))[0];
    drop(cell);
    mut option =core::some(&mut a);mut output =joined::Cell{source:&b,name:"output"};
    span :=joined::pop_loop(borrow_mut(option),borrow_mut(output),3);
    drop(option);drop(output);
    return sum+span[0]+span.len();
}
