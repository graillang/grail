module use_cells;
use cells;
use core;
pub fn run()->u64{
    mut a =u8[];a.push(3);a.push(4);a.push(5);
    mut b =u8[];b.push(7);
    mut cursor =cells::Cursor{source:&a,remaining:&a,name:"cursor"};
    mut sum=0;
    for i in 2{sum=sum+cells::advance(borrow_mut(cursor),1);}
    drop(cursor);
    mut unique =cells::Unique{source:&mut a,name:"unique"};
    mut old =cells::take(borrow_mut(unique),&mut b);
    write(old,0,9);drop(old);
    second :=unique.source[0];drop(unique);
    first :=a[0];
    mut option =Some(&mut a);
    taken :=cells::pop(borrow_mut(option));drop(option);
    mut extracted =taken!;write(extracted,2,13);drop(extracted);
    third :=a[2];
    retired :=cells::Unique{source:&mut a,name:"retired"};
    match cells::fail(retired){u64(n)=>{sum=sum+n;},string(e)=>{sum=sum+e.len();}}
    mut view =&mut a;
    mut previous =cells::replace(borrow_mut(view),&mut b);
    write(previous,1,11);drop(previous);
    return sum+first+second+third+view[0];
}
