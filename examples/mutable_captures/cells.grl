module cells;
use core;
pub struct Cursor<a>{source:read<a>,remaining:read<a>,name:string}
pub struct Unique<a>{source:mut<a>,name:string}
pub fn advance<outer,data>(p:(&mut outer Cursor<data>),n:u64)->u64{
    tail :=&p.remaining;
    next :=tail[n:tail.len()];
    exchange(borrow_mut(p.remaining),next);
    return (&p.remaining).len();
}
pub fn take<outer,data>(p:(&mut outer Unique<data>),replacement:mut<data>)->mut<data>{
    return exchange(borrow_mut(p.source),replacement);
}
pub fn replace<outer,T>(p:(&mut outer T),replacement:T)->T{
    return exchange(p,replacement);
}

pub fn pop<outer,data>(p:(&mut outer mut<data>?))->mut<data>?{
    return core::replace(p,core::none<mut<data>>());
}
pub fn fail<T>(value:T)->u64 | string{
    return "failure".text();
}
