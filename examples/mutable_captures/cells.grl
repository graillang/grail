module cells;
use core;
pub struct Cursor<a>{source:read<a>,remaining:read<a>,name:string}
pub struct Unique<a>{source:mut<a>,name:string}
pub fn advance<outer,data>(p:ref_mut<outer,Cursor<data>>,n:num)->num{
    tail :=&p.remaining;
    next :=tail[n:tail.len()];
    exchange(borrow_mut(p.remaining),next);
    return (&p.remaining).len();
}
pub fn take<outer,data>(p:ref_mut<outer,Unique<data>>,replacement:mut<data>)->mut<data>{
    return exchange(borrow_mut(p.source),replacement);
}
pub fn replace<outer,T>(p:ref_mut<outer,T>,replacement:T)->T{
    return exchange(p,replacement);
}

pub fn pop<outer,data>(p:ref_mut<outer,core::Option<mut<data>>>)->core::Option<mut<data>>{
    return core::replace(p,core::none<mut<data>>());
}
pub fn fail<T>(value:T)->core::Result<num,string>{
    return core::err<num,string>("failure");
}
