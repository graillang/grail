use number;
// Lex decimal spans separated by '+' and parse each without copying its bytes.
fn sum<a>(input: read<a>) -> u64 {
    mut total = 0;
    mut start = 0;
    for i in input.len() {
        if input[i] == 43 {
            token := input[start..i];
            total = total + number(token);
            start = i + 1;
        }
    }
    token := input[start..input.len()];
    return total + number(token);
}
