use echo_text;
fn text_check<a>(input: read<a>) -> u64 {
    mut s = echo_text(input.text());
    s.append("é");
    copied := s.text();
    mut empty = "";
    empty.append("");
    view := &copied;
    mut sum = 0;
    for i in view.len() { sum = sum + view[i]; }
    return sum * 257 + s.len();
}
