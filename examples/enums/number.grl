module number;
enum Parsed {Ok(u64),Err(string)}
pub fn parse<a>(input:read<a>)->Parsed{
    if input.len()==0{return Parsed::Err("empty");}
    mut value=0;
    for i in input.len(){
        byte :=input[i];
        if byte<48{return Parsed::Err("invalid");}
        if 57<byte{return Parsed::Err("invalid");}
        digit :=byte-48;
        if 1844674407370955161<value{return Parsed::Err("overflow");}
        if value==1844674407370955161{
            if 5<digit{return Parsed::Err("overflow");}
        }
        value=value*10+digit;
    }
    return Parsed::Ok(value);
}
