module client;
use parse;
use core;
pub fn run<a>(input:read<a>)->u64{
    wrapped :=core::some(parse::parse(input));
    result :=core::unwrap_option(wrapped);
    match result{
        parse::Token<a>(token)=>{return wrapping_add(token.value,token.name.len()+token.span.len());},
        string(error)=>{return error.len();}
    }
}
