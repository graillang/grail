module client;
use parse;
use core;
pub fn run<a>(input:read<a>)->num{
    wrapped :=core::some(parse::parse(input));
    result :=core::unwrap_option(wrapped);
    match result{
        Ok(token)=>{return wrapping_add(token.value,token.name.len()+token.span.len());},
        Err(error)=>{return error.len();}
    }
}
