module parse;
pub struct Token<a>{span:read<a>,name:string,value:u64}
pub fn parse<a>(input:read<a>)->Token<a> | string{
    value :=number(&input)?;
    return Token{span:input,name:"u64",value:value};
}
fn number<a>(input:read<a>)->u64 | string{
    if input.len()==0{return "empty".text();}
    mut value=0;
    for i in input.len(){
        byte :=input[i];
        if byte<48{return "invalid".text();}
        if 57<byte{return "invalid".text();}
        digit :=byte-48;
        if 1844674407370955161<value{return "overflow".text();}
        if value==1844674407370955161{
            if 5<digit{return "overflow".text();}
        }
        value=value*10+digit;
    }
    return value;
}
