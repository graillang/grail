module cleanup;
struct Pair{a:string,b:string}
pub fn run()->num{
    mut source =u8[];source.push(7);
    mut i=0;
    while (source.copy()).len(){
        pair :=Pair{a:"a",b:"bb"};
        first :=pair.a;
        r :=&first;assert(r.len()==1);
        i=i+1;assert(i<4);
        if i==1{continue;}
        break;
    }
    source.push(9);
    return source.len();
}
