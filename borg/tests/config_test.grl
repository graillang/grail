// Borg `agent.toml` loading test.
//
// Every line is `config.value <file> <key> <value>` in schema order, or `config.error <file> <path>`
// when the document is not a table or a key has the wrong type. The reference applies the same
// defaults — the ones `impl Default for CapabilityConfig` and its siblings compile in — to a value
// produced by the `toml` crate from the same bytes, so an invented default or a silent type
// fallback is a line difference.

use borg_config;
use borg_json;
use borg_toml;
use env;
use fs;

fn basename<a>(path: (&a [u8])) -> string {
    mut start = 0;
    for i in path.len() {
        if path[i] == 47 {
            start = i + 1;
        }
    }
    mut out = u8[];
    for i in start..path.len() {
        out.push(path[i]);
    }
    return out.text();
}

fn append<a, b>(out: (&a mut u8[]), text: (&b [u8])) {
    for byte in text {
        out.push(byte);
    }
}

fn line<a, b, c, d>(kind: (&a [u8]), name: (&b [u8]), one: (&c [u8]), two: (&d [u8])) {
    mut text = u8[];
    append(&mut text, "config.".text());
    append(&mut text, kind);
    text.push(32);
    append(&mut text, name);
    text.push(32);
    append(&mut text, one);
    if two.len() > 0 {
        text.push(32);
        append(&mut text, two);
    }
    println(text.text());
}

fn main() -> u64 {
    args := env::args();
    mut index = 1;
    while index < args.len() {
        path := args[index];
        name := basename(&path);
        data := fs::read(&path)!;
        match borg_toml::parse_fallible(&data) {
            document: borg_toml::Toml => {
                match borg_config::load(&document) {
                    settings: borg_config::Setting[] => {
                        mut at = 0;
                        while at < settings.len() {
                            key := borg_config::setting_name(&settings[at]);
                            value := borg_config::setting_text(&settings[at]);
                            // A string setting is quoted so an empty value stays distinguishable
                            // from an absent key.
                            mut rendered = "".text();
                            if borg_config::setting_quoted(&settings[at]) {
                                rendered = borg_json::quote(&value);
                            } else {
                                rendered = value;
                            }
                            line("value", &name, &key, &rendered);
                            at += 1;
                        }
                    },
                    failure: borg_config::ConfigError => {
                        match failure {
                            NotATable(at) => { line("error", &name, &at, ""); },
                            WrongType(at) => { line("error", &name, &at, ""); }
                        }
                    }
                }
            },
            failure: borg_toml::TomlError => { line("error", &name, "parse", ""); }
        }
        index += 1;
    }
    return 0;
}
