// Borg runtime-protocol *header* parity test.
//
// Every line is `wire.header <file> <field> <value>` for a document the header rule accepts, or
// `wire.error <file> <path> <reason>` for one it rejects, with reason naming the layer
// (`missing`, `type`, `protocol`, `version`, `envelope`). The reference performs the same extraction
// with serde_json over the same bytes, so a divergent rule or a divergent parser shows up as a
// line difference. Body modelling is out of scope for this increment (see borg/README.md).

use borg_json;
use borg_wire;
use env;
use fs;

fn basename<a>(path: (&a [u8])) -> string {
    mut start = 0;
    for i in path.len() {
        if path[i] == 47 {
            start = i + 1;
        }
    }
    return path[start..].text();
}

fn emit(text: string) {
    print(text);
    print("\n");
}

fn main() -> u64 {
    args := env::args();
    mut index = 1;
    while index < args.len() {
        path := args[index];
        name := basename(path);
        data := fs::read(path)!;
        match borg_json::parse(data) {
            document: borg_json::Json => {
                match borg_wire::decode(&document) {
                    header: borg_wire::Header => {
                        mut at = 0;
                        while at < borg_wire::field_count(&header) {
                            mut line = "wire.header ".text();
                            line = joined(line, name);
                            line = joined(line, " ".text());
                            line = joined(line, borg_wire::field_name(&header, at));
                            line = joined(line, " ".text());
                            line = joined(line, borg_wire::field_value(&header, at));
                            emit(line);
                            at += 1;
                        }
                    },
                    failure: borg_wire::WireError => {
                        match failure {
                            Missing(at) => { report(name, at, "missing"); },
                            WrongType(at) => { report(name, at, "type"); },
                            WrongProtocol(at) => { report(name, at, "protocol"); },
                            WrongVersion(at) => { report(name, at, "version"); },
                            UnknownEnvelope => { report(name, "$".text(), "envelope"); }
                        }
                    }
                }
            },
            failure: borg_json::ParseError => { report(name, "$".text(), "json"); }
        }
        index += 1;
    }
    return 0;
}

fn report(name: string, at: string, reason: &[u8]) {
    mut line = "wire.error ".text();
    line = joined(line, name);
    line = joined(line, " ".text());
    line = joined(line, at);
    line = joined(line, " ".text());
    line = joined(line, reason);
    print(line);
    print("\n");
}

fn joined<a, b>(left: (&a [u8]), right: (&b [u8])) -> string {
    mut out = u8[];
    for byte in left {
        out.push(byte);
    }
    for byte in right {
        out.push(byte);
    }
    return out.text();
}
