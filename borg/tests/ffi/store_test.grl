// Round-trip and refusal test for session-state persistence through the C OS ABI.
//
// Every line is `<case> <result>`; the build script compares them. A refused file names its reason,
// so a short file, a foreign magic and a length disagreement are distinguishable.

module store_test;

use env;
use sys_grail;
use sys_grail::Error;
use borg_store;

fn line<a, b, c>(label: (&a [u8]), name: (&b [u8]), value: (&c [u8])) {
    print(label);
    print(" ");
    print(name);
    print(" ");
    println(value);
}

fn reason(status: u64) -> string {
    if status == borg_store::OK {
        return "ok".text();
    }
    if status == borg_store::SHORT_FILE {
        return "short-file".text();
    }
    if status == borg_store::BAD_MAGIC {
        return "bad-magic".text();
    }
    if status == borg_store::LENGTH_MISMATCH {
        return "length-mismatch".text();
    }
    return "write-failed".text();
}

fn roundtrip<a, b, c>(directory: (&a [u8]), name: (&b [u8]), payload: (&c [u8])) -> u64 |? Error {
    mut path = directory.text();
    joined := path_join(&path, &name);
    path = joined;
    status := borg_store::persist(&path, &payload)?;
    if status != 0 {
        line("roundtrip", &name, "write-failed");
        return 0;
    }
    stored := borg_store::load(&path);
    match stored {
        value: borg_store::Loaded => {
            if borg_store::loaded_status(&value) != borg_store::OK {
                line("roundtrip", &name, "refused");
                return 0;
            }
            loaded := borg_store::loaded_payload(&value);
            if loaded.len() != payload.len() {
                line("roundtrip", &name, "length-differs");
                return 0;
            }
            mut index = 0;
            mut same = true;
            while index < payload.len() {
                if loaded[index] != payload[index] {
                    same = false;
                }
                index = index + 1;
            }
            if same {
                line("roundtrip", &name, "ok");
            } else {
                line("roundtrip", &name, "bytes-differ");
            }
        },
        failure: Error => { line("roundtrip", &name, "open-failed"); }
    }
    return 0;
}

fn path_join<a, b>(root: (&a [u8]), leaf: (&b [u8])) -> string {
    mut out = u8[];
    for byte in root {
        out.push(byte);
    }
    out.push(47);
    for byte in leaf {
        out.push(byte);
    }
    return out.text();
}

// Writes a raw byte vector (already framed or deliberately malformed) and reports how it loads.
fn refusal<a, b, c>(directory: (&a [u8]), name: (&b [u8]), bytes: (&c [u8])) -> u64 |? Error {
    mut path = directory.text();
    joined := path_join(&path, &name);
    path = joined;
    file := sys_grail::open(&path, sys_grail::OPEN_WRITE + sys_grail::OPEN_CREATE + sys_grail::OPEN_TRUNCATE, 384)?;
    written := sys_grail::write(file, &bytes)?;
    if written != bytes.len() {
        line("refuse", &name, "write-failed");
        return 0;
    }
    sys_grail::close(file)?;
    stored := borg_store::load(&path);
    match stored {
        value: borg_store::Loaded => {
            shown := reason(borg_store::loaded_status(&value));
            line("refuse", &name, &shown);
        },
        failure: Error => { line("refuse", &name, "missing"); }
    }
    return 0;
}

fn malformed<a>(directory: (&a [u8])) -> u64 |? Error {
    // A header-only file is short; a foreign magic is refused by name; a length that disagrees with
    // the payload is refused rather than truncated or padded.
    header_only := borg_store::frame(&u8[]);
    mut truncated = u8[];
    mut index = 0;
    while index < header_only.len() - 1 {
        truncated.push(header_only[index]);
        index = index + 1;
    }
    refusal(&directory, &"short.bin".text(), &truncated)?;

    mut foreign = borg_store::frame(&u8[65, 66]);
    foreign[0] = 88;
    refusal(&directory, &"magic.bin".text(), &foreign)?;

    mut longer = borg_store::frame(&u8[65, 66]);
    longer.push(67);
    refusal(&directory, &"length.bin".text(), &longer)?;

    empty := u8[];
    refusal(&directory, &"empty.bin".text(), &empty)?;
    return 0;
}

fn missing_file<a>(directory: (&a [u8])) -> u64 |? Error {
    mut path = directory.text();
    joined := path_join(&path, "absent.bin".text());
    path = joined;
    stored := borg_store::load(&path);
    match stored {
        value: borg_store::Loaded => { line("refuse", &"absent.bin", "accepted-a-missing-file"); },
        failure: Error => { line("refuse", &"absent.bin", "missing"); }
    }
    return 0;
}

fn main() -> u64 {
    args := env::args();
    mut directory = ".".text();
    if args.len() > 1 {
        mut copy = u8[];
        for byte in args[1] {
            copy.push(byte);
        }
        directory = copy.text();
    }
    outcome := run(&directory);
    match outcome {
        status: u64 => { return status; },
        failure: Error => {
            line("suite", &"ffi".text(), "error");
            return 1;
        }
    }
}

fn run<a>(directory: (&a [u8])) -> u64 |? Error {
    sys_grail::init()?;
    roundtrip(&directory, &"empty.bin", &u8[])?;
    roundtrip(&directory, &"small.bin", &u8[1, 2, 3, 4, 5])?;
    roundtrip(&directory, &"state.bin", &"{\"sequence\":3,\"status\":\"running\"}".text())?;
    malformed(&directory)?;
    missing_file(&directory)?;
    sys_grail::shutdown()?;
    return 0;
}
