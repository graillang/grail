// Borg JSON parity test.
//
// Every line is either `json.compact <file> <canonical>` (the document re-serialised the way
// serde_json writes it: no whitespace, keys in BTreeMap order) or `json.scalar <file> <path>
// <text>` for one scalar, or `json.error <file>` when the document is rejected.
//
// The reference is Borg's own JSON semantics: borg/tests/parity/ref is a Rust program that parses
// the same bytes with serde_json 1.0.151 and `arbitrary_precision` — the exact crate version and
// feature set crates/borg-* build with — and prints the same labels. Fixture paths arrive on the
// command line so the suite reads the committed corpus rather than a copy in the source.

use borg_json;
use env;
use fs;

fn basename<a>(path: (&a [u8])) -> string {
    mut start = 0;
    for i in path.len() {
        if path[i] == 47 {
            start = i + 1;
        }
    }
    return path[start:].text();
}

fn main() -> u64 {
    args := env::args();
    mut index = 1;
    while index < args.len() {
        path := args[index];
        name := basename(&path);
        data := fs::read(&path)!;
        match borg_json::parse(&data) {
            value: borg_json::Json => {
                print("json.compact ");
                print(name);
                print(" ");
                println(borg_json::write(&value));
                fields := borg_json::flatten(&value);
                mut at = 0;
                while at < fields.len() {
                    print("json.scalar ");
                    print(name);
                    print(" ");
                    print(borg_json::path_of(&fields[at]));
                    print(" ");
                    println(borg_json::text_of(&fields[at]));
                    at += 1;
                }
            },
            failure: borg_json::ParseError => {
                print("json.error ");
                println(name);
            }
        }
        index += 1;
    }
    return 0;
}
