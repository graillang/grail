{
  "name": "title-generated-sticky",
  "note": "session_store.rs:952 keeps a title that was generated and drops the later title event",
  "via": "events",
  "events": [
    { "id": "e1", "session_id": "s1", "sequence": 1, "created_at": "t1", "kind": { "type": "session_started" } },
    { "id": "e2", "session_id": "s1", "sequence": 2, "created_at": "t2", "kind": { "type": "session_titled", "title": "auto", "generated": true, "usage_tokens": 900, "model": "m1" } },
    { "id": "e3", "session_id": "s1", "sequence": 3, "created_at": "t3", "kind": { "type": "session_titled", "title": "named", "generated": false, "usage_tokens": 5, "model": "m2" } }
  ]
}
