module borg_events;
use borg_json;
use borg_journal;
use core;

// Typed session-event payloads: the transcript kinds a reader sees.
//
// `SessionEvent` is the journal row and `SessionEventKind` is a serde-tagged union
// (`contract.rs:2624`, `#[serde(tag = "type", rename_all = "snake_case")]`). This module ports the
// envelope and the five transcript kinds, with the serialization details that a hand-written port
// gets wrong:
//
//   SessionStarted                       no payload
//   SessionTitled                        title, generated (always written), usage_tokens, model
//   StatusChanged                        status, detail (always written, null when absent)
//   Message                              message_id, actor, text, attachments (omitted when empty),
//                                        status, delivery (always written)
//   MessageDelta                         message_id, delta
//
// Kinds outside this set are refused by name rather than half-decoded: a reader that silently
// ignores an unknown kind would drop transcript rows.

pub enum KindTag {
    Started,
    Titled,
    Status,
    Message,
    Delta
}

pub struct Event {
    id: string,
    session_id: string,
    sequence: u64,
    created_at: string,
    kind: Kind
}

pub enum Kind {
    Started,
    Titled(Titled),
    Status(StatusChange),
    Message(Message),
    Delta(Delta)
}

pub struct Titled {
    title: string,
    generated: bool,
    usage_tokens: u64?,
    model: string?
}

pub struct StatusChange {
    status: borg_journal::Status,
    detail: string?
}

pub struct Message {
    message_id: string,
    actor: string,
    text: string,
    attachments: string[],
    status: string,
    delivery: string?
}

pub struct Delta {
    message_id: string,
    delta: string
}

pub enum EventError {
    NotObject,
    Missing(string),
    WrongType(string),
    UnknownKind(string)
}

fn same<a, b>(left: (&a [u8]), right: (&b [u8])) -> bool {
    if left.len() != right.len() {
        return false;
    }
    for i in left.len() {
        if left[i] != right[i] {
            return false;
        }
    }
    return true;
}

fn text_of<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> string | EventError {
    match borg_json::member(&root, &key) {
        Some(node) => {
            match borg_json::as_string(&node) {
                Some(text) => { found := text; return found; },
                None => { reason := key.text(); return EventError::WrongType(reason); }
            }
        },
        None => { reason := key.text(); return EventError::Missing(reason); }
    }
}

fn number_of<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> u64 | EventError {
    match borg_json::member(&root, &key) {
        Some(node) => {
            match borg_json::as_number(&node) {
                Some(text) => {
                    match borg_json::whole_number(&text) {
                        Some(value) => { return value; },
                        None => { reason := key.text(); return EventError::WrongType(reason); }
                    }
                },
                None => { reason := key.text(); return EventError::WrongType(reason); }
            }
        },
        None => { reason := key.text(); return EventError::Missing(reason); }
    }
}

fn optional_text<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> string? {
    match borg_json::member(&root, &key) {
        Some(node) => {
            if borg_json::kind_of(&node) == borg_json::JsonKind::Null {
                return None;
            }
            return borg_json::as_string(&node);
        },
        None => { return None; }
    }
}

fn optional_number<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> u64? {
    match borg_json::member(&root, &key) {
        Some(node) => {
            match borg_json::as_number(&node) {
                Some(text) => { return borg_json::whole_number(&text); },
                None => { return None; }
            }
        },
        None => { return None; }
    }
}

fn flag_or<a, b>(root: (&a borg_json::Json), key: (&b [u8]), fallback: bool) -> bool {
    match borg_json::member(&root, &key) {
        Some(node) => {
            match borg_json::as_bool(&node) {
                Some(flag) => { return flag; },
                None => { return fallback; }
            }
        },
        None => { return fallback; }
    }
}

fn strings_of<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> string[] | EventError {
    mut out = string[];
    match borg_json::member(&root, &key) {
        Some(node) => {
            if borg_json::kind_of(&node) != borg_json::JsonKind::Arr {
                reason := key.text();
                return EventError::WrongType(reason);
            }
            mut index = 0;
            while index < borg_json::array_len(&node) {
                match borg_json::array_item(&node, index) {
                    Some(item) => {
                        match borg_json::as_string(&item) {
                            Some(text) => { out.push(text); },
                            None => { reason := key.text(); return EventError::WrongType(reason); }
                        }
                    },
                    None => { }
                }
                index += 1;
            }
            return out;
        },
        None => { return out; }
    }
}

pub fn status_of<a>(name: (&a [u8])) -> borg_journal::Status | EventError {
    if same(&name, "starting") { return borg_journal::starting(); }
    if same(&name, "ready") { return borg_journal::ready(); }
    if same(&name, "running") { return borg_journal::running(); }
    if same(&name, "waiting_for_approval") { return borg_journal::waiting_for_approval(); }
    if same(&name, "completed") { return borg_journal::completed(); }
    if same(&name, "failed") { return borg_journal::failed(); }
    if same(&name, "stopped") { return borg_journal::stopped(); }
    return EventError::UnknownKind(name.text());
}

fn decode_kind<a>(root: (&a borg_json::Json)) -> Kind | EventError {
    kind := text_of(&root, "type")?;
    if same(&kind, "session_started") {
        return Kind::Started;
    }
    if same(&kind, "session_titled") {
        title := text_of(&root, "title")?;
        generated := flag_or(&root, "generated", false);
        tokens := optional_number(&root, "usage_tokens");
        model := optional_text(&root, "model");
        return Kind::Titled(Titled { title: title, generated: generated, usage_tokens: tokens, model: model });
    }
    if same(&kind, "status_changed") {
        status_name := text_of(&root, "status")?;
        detail := optional_text(&root, "detail");
        return Kind::Status(StatusChange { status: status_of(&status_name)?, detail: detail });
    }
    if same(&kind, "message") {
        message_id := text_of(&root, "message_id")?;
        actor := text_of(&root, "actor")?;
        text := text_of(&root, "text")?;
        attachments := strings_of(&root, "attachments")?;
        status := text_of(&root, "status")?;
        delivery := optional_text(&root, "delivery");
        return Kind::Message(Message {
            message_id: message_id,
            actor: actor,
            text: text,
            attachments: attachments,
            status: status,
            delivery: delivery
        });
    }
    if same(&kind, "message_delta") {
        message_id := text_of(&root, "message_id")?;
        delta := text_of(&root, "delta")?;
        return Kind::Delta(Delta { message_id: message_id, delta: delta });
    }
    return EventError::UnknownKind(kind);
}

fn kind_field<a>(root: (&a borg_json::Json)) -> Kind | EventError {
    match borg_json::member(&root, "kind") {
        Some(node) => { return decode_kind(&node); },
        None => { return EventError::Missing("kind".text()); }
    }
}

pub fn decode<a>(root: (&a borg_json::Json)) -> Event | EventError {
    if borg_json::kind_of(&root) != borg_json::JsonKind::Obj {
        return EventError::NotObject;
    }
    id := text_of(&root, "id")?;
    session_id := text_of(&root, "session_id")?;
    sequence := number_of(&root, "sequence")?;
    created_at := text_of(&root, "created_at")?;
    kind := kind_field(&root)?;
    return Event {
        id: id,
        session_id: session_id,
        sequence: sequence,
        created_at: created_at,
        kind: kind
    };
}

// ---- accessors ----

pub fn event_id<a>(value: (&a Event)) -> string { return value.id.text(); }
pub fn event_session<a>(value: (&a Event)) -> string { return value.session_id.text(); }
pub fn event_sequence<a>(value: (&a Event)) -> u64 { return value.sequence; }
pub fn event_created<a>(value: (&a Event)) -> string { return value.created_at.text(); }

pub fn tag_of<a>(value: (&a Event)) -> string {
    return tag_name(&value.kind);
}

fn tag_name<a>(value: (&a Kind)) -> string {
    match value {
        Started => { return "session_started".text(); },
        Titled(inner) => { return "session_titled".text(); },
        Status(inner) => { return "status_changed".text(); },
        Message(inner) => { return "message".text(); },
        Delta(inner) => { return "message_delta".text(); }
    }
}

pub fn title_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Titled(inner) => { return inner.title.text(); },
        _ => { return "-".text(); }
    }
}

pub fn generated_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Titled(inner) => {
            if inner.generated { return "true".text(); }
            return "false".text();
        },
        _ => { return "-".text(); }
    }
}

pub fn tokens_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Titled(inner) => {
            match copy_optional_number(&inner.usage_tokens) {
                Some(count) => { return borg_json::number_text(count); },
                None => { return "-".text(); }
            }
        },
        _ => { return "-".text(); }
    }
}

pub fn status_text<a>(value: (&a Event)) -> string {
    match &value.kind {
        Status(inner) => { return borg_journal::status_name(&inner.status); },
        Message(inner) => { return inner.status.text(); },
        _ => { return "-".text(); }
    }
}

pub fn actor_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Message(inner) => { return inner.actor.text(); },
        _ => { return "-".text(); }
    }
}

pub fn text_of_message<a>(value: (&a Event)) -> string {
    match &value.kind {
        Message(inner) => { return inner.text.text(); },
        Delta(inner) => { return inner.delta.text(); },
        _ => { return "-".text(); }
    }
}

pub fn attachments_of<a>(value: (&a Event)) -> u64 {
    match &value.kind {
        Message(inner) => {
            mut count = 0;
            mut index = 0;
            while index < inner.attachments.len() {
                count = count + 1;
                index += 1;
            }
            return count;
        },
        _ => { return 0; }
    }
}

pub fn delivery_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Message(inner) => {
            match copy_optional(&inner.delivery) {
                Some(text) => { return text; },
                None => { return "-".text(); }
            }
        },
        _ => { return "-".text(); }
    }
}

pub fn detail_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Status(inner) => {
            match copy_optional(&inner.detail) {
                Some(text) => { return text; },
                None => { return "-".text(); }
            }
        },
        _ => { return "-".text(); }
    }
}

fn copy_optional_number<a>(value: (&a u64?)) -> u64? {
    match value {
        Some(number) => { return Some(number); },
        None => { return None; }
    }
}

fn copy_optional<a>(value: (&a string?)) -> string? {
    match value {
        Some(text) => { copied := text.text(); return Some(copied); },
        None => { return None; }
    }
}

// ---- encoding ----

fn put(members: (&mut borg_json::Member[]), key: (&[u8]), value: borg_json::Json) {
    members.push(borg_json::new_member(&key, value));
}

fn put_text(members: (&mut borg_json::Member[]), key: (&[u8]), text: (&[u8])) {
    members.push(borg_json::new_member(&key, borg_json::Json::Str(text.text())));
}

fn put_optional(members: (&mut borg_json::Member[]), key: (&[u8]), value: (&string?)) {
    match copy_optional(value) {
        Some(text) => { put_text(&mut members, &key, &text); },
        None => { put(&mut members, &key, borg_json::null_value()); }
    }
}

// The kind object, with the serialization details the Rust derive produces.
fn encode_kind<a>(value: (&a Kind)) -> borg_json::Json {
    mut out = borg_json::empty_members();
    match value {
        Started => { put_text(&mut out, "type", "session_started"); },
        Titled(inner) => {
            put_text(&mut out, "type", "session_titled");
            put_text(&mut out, "title", &inner.title);
            if inner.generated {
                put(&mut out, "generated", borg_json::Json::Bool(true));
            } else {
                put(&mut out, "generated", borg_json::Json::Bool(false));
            }
            // A count is a number on the wire, not a quoted string.
            match copy_optional_number(&inner.usage_tokens) {
                Some(count) => {
                    put(&mut out, "usage_tokens", borg_json::Json::Num(borg_json::number_text(count)));
                },
                None => { put(&mut out, "usage_tokens", borg_json::null_value()); }
            }
            put_optional(&mut out, "model", &inner.model);
        },
        Status(inner) => {
            put_text(&mut out, "type", "status_changed");
            status := borg_journal::status_name(&inner.status);
            put_text(&mut out, "status", &status);
            put_optional(&mut out, "detail", &inner.detail);
        },
        Message(inner) => {
            put_text(&mut out, "type", "message");
            put_text(&mut out, "message_id", &inner.message_id);
            put_text(&mut out, "actor", &inner.actor);
            put_text(&mut out, "text", &inner.text);
            // `skip_serializing_if = "Vec::is_empty"`: an empty attachment list is omitted.
            if inner.attachments.len() > 0 {
                mut items = borg_json::empty_list();
                mut index = 0;
                while index < inner.attachments.len() {
                    written := borg_json::Json::Str(inner.attachments[index].text());
                    items.push(written);
                    index += 1;
                }
                put(&mut out, "attachments", borg_json::Json::Arr(items));
            }
            put_text(&mut out, "status", &inner.status);
            put_optional(&mut out, "delivery", &inner.delivery);
        },
        Delta(inner) => {
            put_text(&mut out, "type", "message_delta");
            put_text(&mut out, "message_id", &inner.message_id);
            put_text(&mut out, "delta", &inner.delta);
        }
    }
    return borg_json::object_of(&out);
}

pub fn wire<a>(value: (&a Event)) -> string {
    encoded := encode(&value);
    return borg_json::write(&encoded);
}

pub fn encode<a>(value: (&a Event)) -> borg_json::Json {
    mut root = borg_json::empty_members();
    put_text(&mut root, "id", &value.id);
    put_text(&mut root, "session_id", &value.session_id);
    put(&mut root, "sequence", borg_json::Json::Num(borg_json::number_text(value.sequence)));
    put_text(&mut root, "created_at", &value.created_at);
    boxed := encode_kind(&value.kind);
    put(&mut root, "kind", boxed);
    return borg_json::object_of(&root);
}

// ---- binary event stream ----
//
// The persisted session state is a sequence of these events, not an opaque payload, so a reader can
// refuse by name what it does not understand instead of decoding the wrong fields:
//
//   event    u8      tag: 1 started, 2 titled, 3 status_changed, 4 message, 5 message_delta
//            u32 LE  body length N
//            N bytes body
//   body     text id, text session_id, u64 LE sequence, text created_at, then the kind
//              started         nothing
//              titled          text title, u8 generated, optional u64 usage_tokens, optional text model
//              status_changed  text status, optional text detail
//              message         text message_id, text actor, text text, text[] attachments,
//                              text status, optional text delivery
//              message_delta   text message_id, text delta
//   text     u32 LE byte length, then that many bytes
//   text[]   u32 LE count, then that many texts
//   u8       boolean 0 or 1; any other value is refused rather than read as "true"
//   optional u8 presence, 0 absent or 1 present and the value follows; any other value is refused
//
// A tag and a length per event make three things possible that an opaque payload cannot: an unknown
// tag is named instead of being decoded as some other kind, a final event whose bytes are missing is
// refused instead of truncated into a plausible row, and a declared length is always checked against
// the bytes that are actually present before it is used, so no attacker-controlled length is ever
// turned into an allocation. The list count is checked the same way (each element needs at least its
// four byte length) so a huge count cannot spin the reader.
pub const STREAM_OK: u64 = 0;
// A tag outside 1..5.
pub const UNKNOWN_TAG: u64 = 20;
// The bytes end before a declared extent (an event body, a text, or a list) does.
pub const TRUNCATED_EVENT: u64 = 21;
// A declared length exceeds what one event may occupy; refused before the read starts.
pub const LENGTH_OVERFLOW: u64 = 22;
// A presence or boolean byte that is neither 0 nor 1.
pub const BAD_FIELD: u64 = 23;
// An event body carried bytes past its last field.
pub const TRAILING_BYTES: u64 = 24;

const TAG_STARTED: u64 = 1;
const TAG_TITLED: u64 = 2;
const TAG_STATUS: u64 = 3;
const TAG_MESSAGE: u64 = 4;
const TAG_DELTA: u64 = 5;

// The ceiling on one event's body: a declared length above it is refused as LENGTH_OVERFLOW rather
// than compared against a file that would have to be that large to be honest.
pub const MAX_EVENT_BODY: u64 = 262144;

pub struct Stream {
    status: u64,
    events: Event[]
}

pub fn stream_status<a>(value: (&a Stream)) -> u64 {
    return value.status;
}


// A refused stream carries no events: nothing half-decoded is handed to a caller.
pub fn stream_events<a>(value: (&a Stream)) -> Event[] {
    mut out = Event[];
    mut index = 0;
    while index < value.events.len() {
        out.push(copy_event(&value.events[index]));
        index = index + 1;
    }
    return out;
}

pub fn copy_event<a>(value: (&a Event)) -> Event {
    return Event {
        id: copy_text(&value.id),
        session_id: copy_text(&value.session_id),
        sequence: value.sequence,
        created_at: copy_text(&value.created_at),
        kind: copy_kind(&value.kind)
    };
}

fn copy_kind<a>(value: (&a Kind)) -> Kind {
    // Built by assignment rather than returned from an arm: a `return` of an enum constructor around
    // a struct literal inside a match arm does not parse.
    mut out = Kind::Started;
    match value {
        Started => { },
        Titled(inner) => {
            out = Kind::Titled(Titled {
                title: copy_text(&inner.title),
                generated: inner.generated,
                usage_tokens: copy_optional_number(&inner.usage_tokens),
                model: copy_optional(&inner.model)
            });
        },
        Status(inner) => {
            out = Kind::Status(StatusChange {
                status: copy_status(&inner.status),
                detail: copy_optional(&inner.detail)
            });
        },
        Message(inner) => {
            out = Kind::Message(Message {
                message_id: copy_text(&inner.message_id),
                actor: copy_text(&inner.actor),
                text: copy_text(&inner.text),
                attachments: copy_list(&inner.attachments),
                status: copy_text(&inner.status),
                delivery: copy_optional(&inner.delivery)
            });
        },
        Delta(inner) => {
            out = Kind::Delta(Delta {
                message_id: copy_text(&inner.message_id),
                delta: copy_text(&inner.delta)
            });
        }
    }
    return out;
}

// A status is an enum, so it is copied by name rather than moved out of the borrowed event.
fn copy_status<a>(value: (&a borg_journal::Status)) -> borg_journal::Status {
    name := borg_journal::status_name(value);
    mut out = borg_journal::starting();
    match status_of(&name) {
        mapped: borg_journal::Status => { out = mapped; },
        failure: EventError => { }
    }
    return out;
}

fn copy_list<a>(value: (&a string[])) -> string[] {
    mut out = string[];
    mut index = 0;
    while index < value.len() {
        out.push(copy_text(&value[index]));
        index = index + 1;
    }
    return out;
}

fn empty_event() -> Event {
    return Event {
        id: "".text(),
        session_id: "".text(),
        sequence: 0,
        created_at: "".text(),
        kind: Kind::Started
    };
}

// ---- writer ----

fn push_uint(out: (&mut u8[]), value: u64, width: u64) {
    mut rest = value;
    mut index = u64(0);
    while index < width {
        out.push(u8(rest % 256));
        rest = rest / 256;
        index = index + 1;
    }
}

fn push_bytes<a>(out: (&mut u8[]), bytes: (&a [u8])) {
    for byte in bytes {
        out.push(byte);
    }
}

fn push_text<a>(out: (&mut u8[]), text: (&a [u8])) {
    push_uint(out, text.len(), 4);
    push_bytes(out, text);
}

fn push_bool(out: (&mut u8[]), value: bool) {
    if value {
        push_uint(out, 1, 1);
    } else {
        push_uint(out, 0, 1);
    }
}

fn push_optional_number<a>(out: (&mut u8[]), value: (&a u64?)) {
    match value {
        Some(number) => {
            push_uint(out, 1, 1);
            push_uint(out, number, 8);
        },
        None => { push_uint(out, 0, 1); }
    }
}

fn push_optional_text<a>(out: (&mut u8[]), value: (&a string?)) {
    match value {
        Some(text) => {
            push_uint(out, 1, 1);
            push_text(out, &text);
        },
        None => { push_uint(out, 0, 1); }
    }
}

fn push_text_list<a>(out: (&mut u8[]), items: (&a string[])) {
    push_uint(out, items.len(), 4);
    mut index = 0;
    while index < items.len() {
        push_text(out, &items[index]);
        index = index + 1;
    }
}

fn tag_code<a>(value: (&a Kind)) -> u64 {
    match value {
        Started => { return TAG_STARTED; },
        Titled(inner) => { return TAG_TITLED; },
        Status(inner) => { return TAG_STATUS; },
        Message(inner) => { return TAG_MESSAGE; },
        Delta(inner) => { return TAG_DELTA; }
    }
}

fn encode_body<a>(value: (&a Event)) -> u8[] {
    mut out = u8[];
    push_text(&mut out, &value.id);
    push_text(&mut out, &value.session_id);
    push_uint(&mut out, value.sequence, 8);
    push_text(&mut out, &value.created_at);
    match &value.kind {
        Started => { },
        Titled(inner) => {
            push_text(&mut out, &inner.title);
            push_bool(&mut out, inner.generated);
            push_optional_number(&mut out, &inner.usage_tokens);
            push_optional_text(&mut out, &inner.model);
        },
        Status(inner) => {
            name := borg_journal::status_name(&inner.status);
            push_text(&mut out, &name);
            push_optional_text(&mut out, &inner.detail);
        },
        Message(inner) => {
            push_text(&mut out, &inner.message_id);
            push_text(&mut out, &inner.actor);
            push_text(&mut out, &inner.text);
            push_text_list(&mut out, &inner.attachments);
            push_text(&mut out, &inner.status);
            push_optional_text(&mut out, &inner.delivery);
        },
        Delta(inner) => {
            push_text(&mut out, &inner.message_id);
            push_text(&mut out, &inner.delta);
        }
    }
    return out;
}

pub fn encode_stream<a>(events: (&a Event[])) -> u8[] {
    mut out = u8[];
    mut index = 0;
    while index < events.len() {
        body := encode_body(&events[index]);
        push_uint(&mut out, tag_code(&events[index].kind), 1);
        push_uint(&mut out, body.len(), 4);
        push_bytes(&mut out, &body);
        index = index + 1;
    }
    return out;
}

// ---- reader ----

// Little endian, most significant byte last: accumulating from the top keeps every intermediate
// inside u64, where a 256^width scale would overflow the checked arithmetic on the last step.
fn read_uint<a>(bytes: (&a [u8]), at: u64, width: u64) -> u64 {
    mut value = u64(0);
    mut index = width;
    while index > 0 {
        index = index - 1;
        value = value * 256 + u64(bytes[at + index]);
    }
    return value;
}

// Every field reader takes the cursor so a short read can both name its refusal and leave the rest of
// the decode harmless: once `status` is no longer STREAM_OK the readers return a default and the
// caller reports the first reason.
fn decode_text<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> string {
    mut out = u8[];
    if *status != STREAM_OK {
        return out.text();
    }
    if end - *at < 4 {
        *status = TRUNCATED_EVENT;
        return out.text();
    }
    length := read_uint(bytes, *at, 4);
    *at = *at + 4;
    if length > end - *at {
        *status = TRUNCATED_EVENT;
        return out.text();
    }
    mut index = *at;
    while index < *at + length {
        out.push(bytes[index]);
        index = index + 1;
    }
    *at = *at + length;
    return out.text();
}

fn decode_u64<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> u64 {
    if *status != STREAM_OK {
        return 0;
    }
    if end - *at < 8 {
        *status = TRUNCATED_EVENT;
        return 0;
    }
    value := read_uint(bytes, *at, 8);
    *at = *at + 8;
    return value;
}

fn decode_bool<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> bool {
    if *status != STREAM_OK {
        return false;
    }
    if end - *at < 1 {
        *status = TRUNCATED_EVENT;
        return false;
    }
    marker := u64(bytes[*at]);
    *at = *at + 1;
    if marker == 1 {
        return true;
    }
    if marker != 0 {
        *status = BAD_FIELD;
    }
    return false;
}

fn decode_optional_text<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> string? {
    if *status != STREAM_OK {
        return None;
    }
    if end - *at < 1 {
        *status = TRUNCATED_EVENT;
        return None;
    }
    marker := u64(bytes[*at]);
    *at = *at + 1;
    if marker == 0 {
        return None;
    }
    if marker != 1 {
        *status = BAD_FIELD;
        return None;
    }
    text := decode_text(bytes, at, end, status);
    if *status != STREAM_OK {
        return None;
    }
    return Some(text);
}

fn decode_optional_number<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> u64? {
    if *status != STREAM_OK {
        return None;
    }
    if end - *at < 1 {
        *status = TRUNCATED_EVENT;
        return None;
    }
    marker := u64(bytes[*at]);
    *at = *at + 1;
    if marker == 0 {
        return None;
    }
    if marker != 1 {
        *status = BAD_FIELD;
        return None;
    }
    value := decode_u64(bytes, at, end, status);
    if *status != STREAM_OK {
        return None;
    }
    return Some(value);
}

fn decode_text_list<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> string[] {
    mut out = string[];
    if *status != STREAM_OK {
        return out;
    }
    if end - *at < 4 {
        *status = TRUNCATED_EVENT;
        return out;
    }
    count := read_uint(bytes, *at, 4);
    *at = *at + 4;
    // Each element carries at least its own four byte length, so a count that could not fit in the
    // remaining bytes is refused before the loop rather than after billions of empty iterations.
    if count > (end - *at) / 4 {
        *status = TRUNCATED_EVENT;
        return out;
    }
    mut index = u64(0);
    while index < count {
        item := decode_text(bytes, at, end, status);
        if *status != STREAM_OK {
            return out;
        }
        out.push(item);
        index = index + 1;
    }
    return out;
}

fn decode_event<a>(bytes: (&a [u8]), tag: u64, at: (&mut u64), end: u64, status: (&mut u64)) -> Event {
    if *status != STREAM_OK {
        return empty_event();
    }
    id := decode_text(bytes, at, end, status);
    session_id := decode_text(bytes, at, end, status);
    sequence := decode_u64(bytes, at, end, status);
    created_at := decode_text(bytes, at, end, status);
    mut kind = Kind::Started;
    if tag == TAG_TITLED {
        title := decode_text(bytes, at, end, status);
        generated := decode_bool(bytes, at, end, status);
        tokens := decode_optional_number(bytes, at, end, status);
        model := decode_optional_text(bytes, at, end, status);
        kind = Kind::Titled(Titled {
            title: title,
            generated: generated,
            usage_tokens: tokens,
            model: model
        });
    } else if tag == TAG_STATUS {
        name := decode_text(bytes, at, end, status);
        detail := decode_optional_text(bytes, at, end, status);
        if *status == STREAM_OK {
            match status_of(&name) {
                mapped: borg_journal::Status => {
                    kind = Kind::Status(StatusChange { status: mapped, detail: detail });
                },
                failure: EventError => { *status = BAD_FIELD; }
            }
        }
    } else if tag == TAG_MESSAGE {
        message_id := decode_text(bytes, at, end, status);
        actor := decode_text(bytes, at, end, status);
        text := decode_text(bytes, at, end, status);
        attachments := decode_text_list(bytes, at, end, status);
        row_status := decode_text(bytes, at, end, status);
        delivery := decode_optional_text(bytes, at, end, status);
        kind = Kind::Message(Message {
            message_id: message_id,
            actor: actor,
            text: text,
            attachments: attachments,
            status: row_status,
            delivery: delivery
        });
    } else if tag == TAG_DELTA {
        message_id := decode_text(bytes, at, end, status);
        delta := decode_text(bytes, at, end, status);
        kind = Kind::Delta(Delta { message_id: message_id, delta: delta });
    }
    if (*status == STREAM_OK) && (*at != end) {
        *status = TRAILING_BYTES;
    }
    return Event {
        id: id,
        session_id: session_id,
        sequence: sequence,
        created_at: created_at,
        kind: kind
    };
}

pub fn decode_stream<a>(bytes: (&a [u8])) -> Stream {
    mut events = Event[];
    mut at = u64(0);
    while at < bytes.len() {
        if bytes.len() - at < 5 {
            // The stream ends inside an event header: its tag or its length is cut off.
            return Stream { status: TRUNCATED_EVENT, events: Event[] };
        }
        tag := read_uint(bytes, at, 1);
        length := read_uint(bytes, at + 1, 4);
        at = at + 5;
        if (tag < TAG_STARTED) || (tag > TAG_DELTA) {
            return Stream { status: UNKNOWN_TAG, events: Event[] };
        }
        if length > MAX_EVENT_BODY {
            return Stream { status: LENGTH_OVERFLOW, events: Event[] };
        }
        if length > bytes.len() - at {
            return Stream { status: TRUNCATED_EVENT, events: Event[] };
        }
        mut status = STREAM_OK;
        end := at + length;
        event := decode_event(bytes, tag, &mut at, end, &mut status);
        if status != STREAM_OK {
            return Stream { status: status, events: Event[] };
        }
        events.push(event);
        at = end;
    }
    return Stream { status: STREAM_OK, events: events };
}
