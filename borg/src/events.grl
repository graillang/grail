module borg_events;
use borg_json;
use borg_journal;
use core;

// Typed session-event payloads: the transcript kinds a reader sees, and the three aggregates.
//
// `SessionEvent` is the journal row and `SessionEventKind` is a serde-tagged union
// (`contract.rs:2624`, `#[serde(tag = "type", rename_all = "snake_case")]`). This module ports the
// envelope, the five transcript kinds and the four aggregate kinds, with the serialization details
// that a hand-written port gets wrong:
//
//   SessionStarted                       no payload
//   SessionTitled                        title, generated (always written), usage_tokens, model
//   StatusChanged                        status, detail (always written, null when absent)
//   Message                              message_id, actor, text, attachments (omitted when empty),
//                                        status, delivery (always written)
//   MessageDelta                         message_id, delta
//   GoalCreated                          goal_id, objective, token_budget (null when absent)
//   GoalUpdated                          goal_id, status (active, complete or blocked)
//   PlanProjected                        participant_id, workspace_revision, items
//   WorkProjected                        revision, items
//
// The aggregate kinds are what make a journal a runtime rather than a log: they carry the goal, the
// plan (the todo list a session is working through) and the shared work items those todos point at,
// and the fold in `borg_replay` reconstructs all three from them.
//
// Kinds outside this set are refused by name rather than half-decoded: a reader that silently
// ignores an unknown kind would drop transcript rows. A *status* outside its enum is refused by
// name too (`UnknownGoalStatus`, `UnknownItemStatus`), because a status coerced into a neighbouring
// variant is a state the model never had.

pub struct Event {
    id: string,
    session_id: string,
    sequence: u64,
    created_at: string,
    kind: Kind
}

pub enum Kind {
    Started,
    Titled(Titled),
    Status(StatusChange),
    Message(Message),
    Delta(Delta),
    GoalCreated(GoalCreated),
    GoalUpdated(GoalUpdated),
    PlanProjected(PlanProjected),
    WorkProjected(WorkProjected)
}

pub struct Titled {
    title: string,
    generated: bool,
    usage_tokens: u64?,
    model: string?
}

pub struct StatusChange {
    status: borg_journal::Status,
    detail: string?
}

pub struct Message {
    message_id: string,
    actor: string,
    text: string,
    attachments: string[],
    status: string,
    delivery: string?
}

pub struct Delta {
    message_id: string,
    delta: string
}

// ---- the goal, plan and work aggregates ----
//
// Three aggregates ride the journal beside the transcript, and each one is written the way the
// transcript is: a typed kind, a status enum whose *spelling* is part of the schema
// (`rename_all = "snake_case"`), and a refusal by name when a status is not one the model has.
//
//   GoalStatus    `GoalStatus` (contract.rs:2293) narrowed to the three a model may set
//                 (`ModelGoalStatus`, contract.rs:2337): active, complete, blocked. The other three
//                 Borg statuses describe the host's budget accounting, not a decision a turn makes,
//                 and modelling them here would mean inventing who sets them.
//   ItemStatus    `WorkStatus`/`PlanItemStatus` (workspace.rs:310, contract.rs:3082): pending,
//                 in_progress, blocked, awaiting_review, completed.
//
// `token_budget`, `work_id` and `assignee` are optionals that serialize as null rather than being
// omitted, which is what the derive does for a field without `skip_serializing_if`. A plan item's
// `work_id` is the port's own link from a todo to the shared work item it tracks; Borg's `PlanItem`
// has three fields, and the link is what lets the fold refuse a todo pointing at work that does not
// exist instead of silently losing the reference.

pub enum GoalStatus {
    Active,
    Complete,
    Blocked
}

pub enum ItemStatus {
    Pending,
    InProgress,
    Blocked,
    AwaitingReview,
    Completed
}

pub struct GoalCreated {
    goal_id: string,
    objective: string,
    token_budget: u64?
}

pub struct GoalUpdated {
    goal_id: string,
    status: GoalStatus
}

pub struct PlanItem {
    id: string,
    content: string,
    status: ItemStatus,
    work_id: string?
}

pub struct PlanProjected {
    participant: string,
    revision: u64,
    items: PlanItem[]
}

pub struct WorkItem {
    id: string,
    title: string,
    assignee: string?,
    status: ItemStatus
}

pub struct WorkProjected {
    revision: u64,
    items: WorkItem[]
}

pub enum EventError {
    NotObject,
    Missing(string),
    WrongType(string),
    UnknownKind(string),
    // A status string outside the enum it was read for. The two spaces are separate variants
    // rather than one carrying a label, so a diagnostic says which status was violated without a
    // second field to parse out of it.
    UnknownGoalStatus(string),
    UnknownItemStatus(string)
}

fn same<a, b>(left: (&a [u8]), right: (&b [u8])) -> bool {
    if left.len() != right.len() {
        return false;
    }
    for i in left.len() {
        if left[i] != right[i] {
            return false;
        }
    }
    return true;
}

fn text_of<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> string | EventError {
    match borg_json::member(&root, &key) {
        Some(node) => {
            match borg_json::as_string(&node) {
                Some(text) => { found := text; return found; },
                None => { reason := key.text(); return EventError::WrongType(reason); }
            }
        },
        None => { reason := key.text(); return EventError::Missing(reason); }
    }
}

fn number_of<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> u64 | EventError {
    match borg_json::member(&root, &key) {
        Some(node) => {
            match borg_json::as_number(&node) {
                Some(text) => {
                    match borg_json::whole_number(&text) {
                        Some(value) => { return value; },
                        None => { reason := key.text(); return EventError::WrongType(reason); }
                    }
                },
                None => { reason := key.text(); return EventError::WrongType(reason); }
            }
        },
        None => { reason := key.text(); return EventError::Missing(reason); }
    }
}

fn optional_text<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> string? {
    match borg_json::member(&root, &key) {
        Some(node) => {
            if borg_json::kind_of(&node) == borg_json::JsonKind::Null {
                return None;
            }
            return borg_json::as_string(&node);
        },
        None => { return None; }
    }
}

fn optional_number<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> u64? {
    match borg_json::member(&root, &key) {
        Some(node) => {
            match borg_json::as_number(&node) {
                Some(text) => { return borg_json::whole_number(&text); },
                None => { return None; }
            }
        },
        None => { return None; }
    }
}

fn flag_or<a, b>(root: (&a borg_json::Json), key: (&b [u8]), fallback: bool) -> bool {
    match borg_json::member(&root, &key) {
        Some(node) => {
            match borg_json::as_bool(&node) {
                Some(flag) => { return flag; },
                None => { return fallback; }
            }
        },
        None => { return fallback; }
    }
}

fn strings_of<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> string[] | EventError {
    mut out = string[];
    match borg_json::member(&root, &key) {
        Some(node) => {
            if borg_json::kind_of(&node) != borg_json::JsonKind::Arr {
                reason := key.text();
                return EventError::WrongType(reason);
            }
            mut index = 0;
            while index < borg_json::array_len(&node) {
                match borg_json::array_item(&node, index) {
                    Some(item) => {
                        match borg_json::as_string(&item) {
                            Some(text) => { out.push(text); },
                            None => { reason := key.text(); return EventError::WrongType(reason); }
                        }
                    },
                    None => { }
                }
                index += 1;
            }
            return out;
        },
        None => { return out; }
    }
}

pub fn status_of<a>(name: (&a [u8])) -> borg_journal::Status | EventError {
    if same(&name, "starting") { return borg_journal::starting(); }
    if same(&name, "ready") { return borg_journal::ready(); }
    if same(&name, "running") { return borg_journal::running(); }
    if same(&name, "waiting_for_approval") { return borg_journal::waiting_for_approval(); }
    if same(&name, "completed") { return borg_journal::completed(); }
    if same(&name, "failed") { return borg_journal::failed(); }
    if same(&name, "stopped") { return borg_journal::stopped(); }
    return EventError::UnknownKind(name.text());
}

// The goal statuses a model may set, spelled as `ModelGoalStatus` serializes them.
pub fn goal_status_of<a>(name: (&a [u8])) -> GoalStatus | EventError {
    if same(&name, "active") { return GoalStatus::Active; }
    if same(&name, "complete") { return GoalStatus::Complete; }
    if same(&name, "blocked") { return GoalStatus::Blocked; }
    return EventError::UnknownGoalStatus(name.text());
}

pub fn goal_status_name<a>(value: (&a GoalStatus)) -> string {
    match value {
        Active => { return "active".text(); },
        Complete => { return "complete".text(); },
        Blocked => { return "blocked".text(); }
    }
}

// `WorkStatus` (workspace.rs:310) as `PlanItemStatus` aliases it (contract.rs:3082).
pub fn item_status_of<a>(name: (&a [u8])) -> ItemStatus | EventError {
    if same(&name, "pending") { return ItemStatus::Pending; }
    if same(&name, "in_progress") { return ItemStatus::InProgress; }
    if same(&name, "blocked") { return ItemStatus::Blocked; }
    if same(&name, "awaiting_review") { return ItemStatus::AwaitingReview; }
    if same(&name, "completed") { return ItemStatus::Completed; }
    return EventError::UnknownItemStatus(name.text());
}

pub fn item_status_name<a>(value: (&a ItemStatus)) -> string {
    match value {
        Pending => { return "pending".text(); },
        InProgress => { return "in_progress".text(); },
        Blocked => { return "blocked".text(); },
        AwaitingReview => { return "awaiting_review".text(); },
        Completed => { return "completed".text(); }
    }
}

// One item of a plan projection. A list element that is not an object, or an item without the
// fields the model has, is refused by the item list's own key rather than by a field path, because
// a serde diagnostic for `items[3].status` is the same class of failure as `items`.
fn plan_item_of<a, b>(node: (&a borg_json::Json), key: (&b [u8])) -> PlanItem | EventError {
    if borg_json::kind_of(&node) != borg_json::JsonKind::Obj {
        reason := key.text();
        return EventError::WrongType(reason);
    }
    id := text_of(&node, "id")?;
    content := text_of(&node, "content")?;
    shown := text_of(&node, "status")?;
    status := item_status_of(&shown)?;
    work := optional_text(&node, "work_id");
    return PlanItem { id: id, content: content, status: status, work_id: work };
}

fn work_item_of<a, b>(node: (&a borg_json::Json), key: (&b [u8])) -> WorkItem | EventError {
    if borg_json::kind_of(&node) != borg_json::JsonKind::Obj {
        reason := key.text();
        return EventError::WrongType(reason);
    }
    id := text_of(&node, "id")?;
    title := text_of(&node, "title")?;
    assignee := optional_text(&node, "assignee");
    shown := text_of(&node, "status")?;
    status := item_status_of(&shown)?;
    return WorkItem { id: id, title: title, assignee: assignee, status: status };
}

fn plan_items_of<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> PlanItem[] | EventError {
    mut out = PlanItem[];
    match borg_json::member(&root, &key) {
        Some(list) => {
            if borg_json::kind_of(&list) != borg_json::JsonKind::Arr {
                reason := key.text();
                return EventError::WrongType(reason);
            }
            mut index = 0;
            while index < borg_json::array_len(&list) {
                match borg_json::array_item(&list, index) {
                    Some(node) => { out.push(plan_item_of(&node, &key)?); },
                    None => { }
                }
                index += 1;
            }
            return out;
        },
        None => { reason := key.text(); return EventError::Missing(reason); }
    }
}

fn work_items_of<a, b>(root: (&a borg_json::Json), key: (&b [u8])) -> WorkItem[] | EventError {
    mut out = WorkItem[];
    match borg_json::member(&root, &key) {
        Some(list) => {
            if borg_json::kind_of(&list) != borg_json::JsonKind::Arr {
                reason := key.text();
                return EventError::WrongType(reason);
            }
            mut index = 0;
            while index < borg_json::array_len(&list) {
                match borg_json::array_item(&list, index) {
                    Some(node) => { out.push(work_item_of(&node, &key)?); },
                    None => { }
                }
                index += 1;
            }
            return out;
        },
        None => { reason := key.text(); return EventError::Missing(reason); }
    }
}

fn decode_kind<a>(root: (&a borg_json::Json)) -> Kind | EventError {
    kind := text_of(&root, "type")?;
    if same(&kind, "session_started") {
        return Kind::Started;
    }
    if same(&kind, "session_titled") {
        title := text_of(&root, "title")?;
        generated := flag_or(&root, "generated", false);
        tokens := optional_number(&root, "usage_tokens");
        model := optional_text(&root, "model");
        return Kind::Titled(Titled { title: title, generated: generated, usage_tokens: tokens, model: model });
    }
    if same(&kind, "status_changed") {
        status_name := text_of(&root, "status")?;
        detail := optional_text(&root, "detail");
        return Kind::Status(StatusChange { status: status_of(&status_name)?, detail: detail });
    }
    if same(&kind, "message") {
        message_id := text_of(&root, "message_id")?;
        actor := text_of(&root, "actor")?;
        text := text_of(&root, "text")?;
        attachments := strings_of(&root, "attachments")?;
        status := text_of(&root, "status")?;
        delivery := optional_text(&root, "delivery");
        return Kind::Message(Message {
            message_id: message_id,
            actor: actor,
            text: text,
            attachments: attachments,
            status: status,
            delivery: delivery
        });
    }
    if same(&kind, "message_delta") {
        message_id := text_of(&root, "message_id")?;
        delta := text_of(&root, "delta")?;
        return Kind::Delta(Delta { message_id: message_id, delta: delta });
    }
    if same(&kind, "goal_created") {
        goal_id := text_of(&root, "goal_id")?;
        objective := text_of(&root, "objective")?;
        budget := optional_number(&root, "token_budget");
        return Kind::GoalCreated(GoalCreated {
            goal_id: goal_id,
            objective: objective,
            token_budget: budget
        });
    }
    if same(&kind, "goal_updated") {
        goal_id := text_of(&root, "goal_id")?;
        shown := text_of(&root, "status")?;
        status := goal_status_of(&shown)?;
        return Kind::GoalUpdated(GoalUpdated { goal_id: goal_id, status: status });
    }
    if same(&kind, "plan_projected") {
        participant := text_of(&root, "participant_id")?;
        revision := number_of(&root, "workspace_revision")?;
        items := plan_items_of(&root, "items")?;
        return Kind::PlanProjected(PlanProjected {
            participant: participant,
            revision: revision,
            items: items
        });
    }
    if same(&kind, "work_projected") {
        revision := number_of(&root, "revision")?;
        items := work_items_of(&root, "items")?;
        return Kind::WorkProjected(WorkProjected { revision: revision, items: items });
    }
    return EventError::UnknownKind(kind);
}

fn kind_field<a>(root: (&a borg_json::Json)) -> Kind | EventError {
    match borg_json::member(&root, "kind") {
        Some(node) => { return decode_kind(&node); },
        None => { return EventError::Missing("kind".text()); }
    }
}

pub fn decode<a>(root: (&a borg_json::Json)) -> Event | EventError {
    if borg_json::kind_of(&root) != borg_json::JsonKind::Obj {
        return EventError::NotObject;
    }
    id := text_of(&root, "id")?;
    session_id := text_of(&root, "session_id")?;
    sequence := number_of(&root, "sequence")?;
    created_at := text_of(&root, "created_at")?;
    kind := kind_field(&root)?;
    return Event {
        id: id,
        session_id: session_id,
        sequence: sequence,
        created_at: created_at,
        kind: kind
    };
}

// ---- accessors ----

pub fn event_id<a>(value: (&a Event)) -> string { return value.id.text(); }
pub fn event_session<a>(value: (&a Event)) -> string { return value.session_id.text(); }
pub fn event_sequence<a>(value: (&a Event)) -> u64 { return value.sequence; }
pub fn event_created<a>(value: (&a Event)) -> string { return value.created_at.text(); }

pub fn tag_of<a>(value: (&a Event)) -> string {
    return tag_name(&value.kind);
}

fn tag_name<a>(value: (&a Kind)) -> string {
    match value {
        Started => { return "session_started".text(); },
        Titled(inner) => { return "session_titled".text(); },
        Status(inner) => { return "status_changed".text(); },
        Message(inner) => { return "message".text(); },
        Delta(inner) => { return "message_delta".text(); },
        GoalCreated(inner) => { return "goal_created".text(); },
        GoalUpdated(inner) => { return "goal_updated".text(); },
        PlanProjected(inner) => { return "plan_projected".text(); },
        WorkProjected(inner) => { return "work_projected".text(); }
    }
}

pub fn title_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Titled(inner) => { return inner.title.text(); },
        _ => { return "-".text(); }
    }
}

pub fn generated_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Titled(inner) => {
            if inner.generated { return "true".text(); }
            return "false".text();
        },
        _ => { return "-".text(); }
    }
}

pub fn tokens_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Titled(inner) => {
            match copy_optional_number(&inner.usage_tokens) {
                Some(count) => { return borg_json::number_text(count); },
                None => { return "-".text(); }
            }
        },
        _ => { return "-".text(); }
    }
}

pub fn status_text<a>(value: (&a Event)) -> string {
    match &value.kind {
        Status(inner) => { return borg_journal::status_name(&inner.status); },
        Message(inner) => { return inner.status.text(); },
        _ => { return "-".text(); }
    }
}

pub fn actor_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Message(inner) => { return inner.actor.text(); },
        _ => { return "-".text(); }
    }
}

pub fn text_of_message<a>(value: (&a Event)) -> string {
    match &value.kind {
        Message(inner) => { return inner.text.text(); },
        Delta(inner) => { return inner.delta.text(); },
        _ => { return "-".text(); }
    }
}

pub fn attachments_of<a>(value: (&a Event)) -> u64 {
    match &value.kind {
        Message(inner) => {
            mut count = 0;
            mut index = 0;
            while index < inner.attachments.len() {
                count = count + 1;
                index += 1;
            }
            return count;
        },
        _ => { return 0; }
    }
}

pub fn delivery_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Message(inner) => {
            match copy_optional(&inner.delivery) {
                Some(text) => { return text; },
                None => { return "-".text(); }
            }
        },
        _ => { return "-".text(); }
    }
}

pub fn detail_of<a>(value: (&a Event)) -> string {
    match &value.kind {
        Status(inner) => {
            match copy_optional(&inner.detail) {
                Some(text) => { return text; },
                None => { return "-".text(); }
            }
        },
        _ => { return "-".text(); }
    }
}

fn copy_optional_number<a>(value: (&a u64?)) -> u64? {
    match value {
        Some(number) => { return Some(number); },
        None => { return None; }
    }
}

fn copy_optional<a>(value: (&a string?)) -> string? {
    match value {
        Some(text) => { copied := text.text(); return Some(copied); },
        None => { return None; }
    }
}

// ---- typed accessors ----
//
// The accessors above render a field for display and answer `-` when a kind has no such field. A
// fold over the journal needs the typed value instead: an absent optional has to stay
// distinguishable from a text that happens to be `-`, and a status has to be the enum the model
// compares rather than its name. Each of these returns `None` for every kind that does not carry
// the field.

pub fn title_value<a>(value: (&a Event)) -> string? {
    match &value.kind {
        Titled(inner) => { return Some(inner.title.text()); },
        _ => { return None; }
    }
}

pub fn generated_value<a>(value: (&a Event)) -> bool {
    match &value.kind {
        Titled(inner) => { return inner.generated; },
        _ => { return false; }
    }
}

pub fn tokens_value<a>(value: (&a Event)) -> u64? {
    match &value.kind {
        Titled(inner) => { return copy_optional_number(&inner.usage_tokens); },
        _ => { return None; }
    }
}

pub fn model_value<a>(value: (&a Event)) -> string? {
    match &value.kind {
        Titled(inner) => { return copy_optional(&inner.model); },
        _ => { return None; }
    }
}

pub fn status_value<a>(value: (&a Event)) -> borg_journal::Status? {
    match &value.kind {
        Status(inner) => { return Some(copy_status(&inner.status)); },
        _ => { return None; }
    }
}

pub fn detail_value<a>(value: (&a Event)) -> string? {
    match &value.kind {
        Status(inner) => { return copy_optional(&inner.detail); },
        _ => { return None; }
    }
}

pub fn actor_value<a>(value: (&a Event)) -> string? {
    match &value.kind {
        Message(inner) => { return Some(inner.actor.text()); },
        _ => { return None; }
    }
}

pub fn message_status_value<a>(value: (&a Event)) -> string? {
    match &value.kind {
        Message(inner) => { return Some(inner.status.text()); },
        _ => { return None; }
    }
}

pub fn text_value<a>(value: (&a Event)) -> string? {
    match &value.kind {
        Message(inner) => { return Some(inner.text.text()); },
        _ => { return None; }
    }
}

// ---- typed accessors for the aggregates ----
//
// The fold needs the typed value, and another module cannot read a field of a struct it did not
// define, so every aggregate field is readable here. Each accessor answers `None` for a kind that
// does not carry the field, which is what keeps "this event has no goal id" distinguishable from
// "the goal id is empty".

pub fn goal_id_value<a>(value: (&a Event)) -> string? {
    match &value.kind {
        GoalCreated(inner) => { return Some(inner.goal_id.text()); },
        GoalUpdated(inner) => { return Some(inner.goal_id.text()); },
        _ => { return None; }
    }
}

pub fn goal_objective_value<a>(value: (&a Event)) -> string? {
    match &value.kind {
        GoalCreated(inner) => { return Some(inner.objective.text()); },
        _ => { return None; }
    }
}

pub fn goal_budget_value<a>(value: (&a Event)) -> u64? {
    match &value.kind {
        GoalCreated(inner) => { return copy_optional_number(&inner.token_budget); },
        _ => { return None; }
    }
}

pub fn goal_status_value<a>(value: (&a Event)) -> GoalStatus? {
    match &value.kind {
        GoalUpdated(inner) => { return Some(copy_goal_status(&inner.status)); },
        _ => { return None; }
    }
}

pub fn plan_participant_value<a>(value: (&a Event)) -> string? {
    match &value.kind {
        PlanProjected(inner) => { return Some(inner.participant.text()); },
        _ => { return None; }
    }
}

pub fn plan_revision_value<a>(value: (&a Event)) -> u64? {
    match &value.kind {
        PlanProjected(inner) => { return Some(inner.revision); },
        _ => { return None; }
    }
}

pub fn plan_items_value<a>(value: (&a Event)) -> PlanItem[] {
    match &value.kind {
        PlanProjected(inner) => { return copy_plan_items(&inner.items); },
        _ => { return PlanItem[]; }
    }
}

pub fn work_revision_value<a>(value: (&a Event)) -> u64? {
    match &value.kind {
        WorkProjected(inner) => { return Some(inner.revision); },
        _ => { return None; }
    }
}

pub fn work_items_value<a>(value: (&a Event)) -> WorkItem[] {
    match &value.kind {
        WorkProjected(inner) => { return copy_work_items(&inner.items); },
        _ => { return WorkItem[]; }
    }
}

pub fn plan_item_id<a>(value: (&a PlanItem)) -> string { return value.id.text(); }
pub fn plan_item_content<a>(value: (&a PlanItem)) -> string { return value.content.text(); }
pub fn plan_item_status<a>(value: (&a PlanItem)) -> string { return item_status_name(&value.status); }
pub fn plan_item_work<a>(value: (&a PlanItem)) -> string? { return copy_optional(&value.work_id); }

pub fn work_item_id<a>(value: (&a WorkItem)) -> string { return value.id.text(); }
pub fn work_item_title<a>(value: (&a WorkItem)) -> string { return value.title.text(); }
pub fn work_item_status<a>(value: (&a WorkItem)) -> string { return item_status_name(&value.status); }
pub fn work_item_assignee<a>(value: (&a WorkItem)) -> string? { return copy_optional(&value.assignee); }

// ---- builders ----
//
// A command is an event, so the command line builds one here rather than in its own module: the
// payload types stay private, and an unknown status name is refused by the same function the JSON
// and byte readers use, so `update-goal --status done` refuses with one reason wherever it is read.
// An empty text in `work` or `assignee` means the optional is absent, because an empty work id is
// not a reference to anything.

// The class of a decode failure, by name: the names `borg/tests/events_test.grl` prints and the ones a
// command line reports when it cannot build an event from an argument.
pub fn error_class<a>(value: (&a EventError)) -> string {
    match value {
        NotObject => { return "not-object".text(); },
        Missing(key) => { return "missing".text(); },
        WrongType(key) => { return "type".text(); },
        UnknownKind(kind) => { return "unknown-kind".text(); },
        UnknownGoalStatus(name) => { return "unknown-goal-status".text(); },
        UnknownItemStatus(name) => { return "unknown-item-status".text(); }
    }
}

pub fn event_with<a, b, c>(id: (&a [u8]), session: (&b [u8]), sequence: u64, created_at: (&c [u8]), kind: Kind) -> Event {
    return Event {
        id: id.text(),
        session_id: session.text(),
        sequence: sequence,
        created_at: created_at.text(),
        kind: kind
    };
}

// The daemon appends, so it owns the envelope: it stamps a sequence and a timestamp onto what a
// client sent instead of trusting the client's placeholders.
pub fn stamped<a, b, c>(value: (&a Event), id: (&b [u8]), sequence: u64, created_at: (&c [u8])) -> Event {
    mut copied = copy_event(value);
    copied.id = id.text();
    copied.sequence = sequence;
    copied.created_at = created_at.text();
    return copied;
}

// A created goal is active: `SessionGoal::new` (contract.rs:2318) starts there, so the fold does not
// need to read a status the event does not carry.
pub fn goal_active() -> GoalStatus { return GoalStatus::Active; }

pub fn goal_created_kind<a, b>(goal_id: (&a [u8]), objective: (&b [u8]), budget: u64?) -> Kind {
    return Kind::GoalCreated(GoalCreated {
        goal_id: goal_id.text(),
        objective: objective.text(),
        token_budget: budget
    });
}

pub fn goal_updated_kind<a, b>(goal_id: (&a [u8]), status: (&b [u8])) -> Kind | EventError {
    typed := goal_status_of(&status)?;
    return Kind::GoalUpdated(GoalUpdated { goal_id: goal_id.text(), status: typed });
}

pub fn plan_item<a, b, c, d>(id: (&a [u8]), content: (&b [u8]), status: (&c [u8]), work: (&d [u8])) -> PlanItem | EventError {
    typed := item_status_of(&status)?;
    if work.len() == 0 {
        return PlanItem { id: id.text(), content: content.text(), status: typed, work_id: None };
    }
    return PlanItem {
        id: id.text(),
        content: content.text(),
        status: typed,
        work_id: Some(work.text())
    };
}

pub fn work_item<a, b, c, d>(id: (&a [u8]), title: (&b [u8]), assignee: (&c [u8]), status: (&d [u8])) -> WorkItem | EventError {
    typed := item_status_of(&status)?;
    if assignee.len() == 0 {
        return WorkItem { id: id.text(), title: title.text(), assignee: None, status: typed };
    }
    return WorkItem {
        id: id.text(),
        title: title.text(),
        assignee: Some(assignee.text()),
        status: typed
    };
}

pub fn plan_kind<a>(participant: (&a [u8]), revision: u64, items: PlanItem[]) -> Kind {
    return Kind::PlanProjected(PlanProjected {
        participant: participant.text(),
        revision: revision,
        items: items
    });
}

pub fn work_kind(revision: u64, items: WorkItem[]) -> Kind {
    return Kind::WorkProjected(WorkProjected { revision: revision, items: items });
}

// ---- encoding ----

fn put(members: (&mut borg_json::Member[]), key: (&[u8]), value: borg_json::Json) {
    members.push(borg_json::new_member(&key, value));
}

fn put_text(members: (&mut borg_json::Member[]), key: (&[u8]), text: (&[u8])) {
    members.push(borg_json::new_member(&key, borg_json::Json::Str(text.text())));
}

fn put_optional(members: (&mut borg_json::Member[]), key: (&[u8]), value: (&string?)) {
    match copy_optional(value) {
        Some(text) => { put_text(&mut members, &key, &text); },
        None => { put(&mut members, &key, borg_json::null_value()); }
    }
}

fn encode_plan_item<a>(value: (&a PlanItem)) -> borg_json::Json {
    mut members = borg_json::empty_members();
    put_text(&mut members, "id", &value.id);
    put_text(&mut members, "content", &value.content);
    shown := item_status_name(&value.status);
    put_text(&mut members, "status", &shown);
    put_optional(&mut members, "work_id", &value.work_id);
    return borg_json::object_of(&members);
}

fn encode_work_item<a>(value: (&a WorkItem)) -> borg_json::Json {
    mut members = borg_json::empty_members();
    put_text(&mut members, "id", &value.id);
    put_text(&mut members, "title", &value.title);
    put_optional(&mut members, "assignee", &value.assignee);
    shown := item_status_name(&value.status);
    put_text(&mut members, "status", &shown);
    return borg_json::object_of(&members);
}

// The kind object, with the serialization details the Rust derive produces.
fn encode_kind<a>(value: (&a Kind)) -> borg_json::Json {
    mut out = borg_json::empty_members();
    match value {
        Started => { put_text(&mut out, "type", "session_started"); },
        Titled(inner) => {
            put_text(&mut out, "type", "session_titled");
            put_text(&mut out, "title", &inner.title);
            if inner.generated {
                put(&mut out, "generated", borg_json::Json::Bool(true));
            } else {
                put(&mut out, "generated", borg_json::Json::Bool(false));
            }
            // A count is a number on the wire, not a quoted string.
            match copy_optional_number(&inner.usage_tokens) {
                Some(count) => {
                    put(&mut out, "usage_tokens", borg_json::Json::Num(borg_json::number_text(count)));
                },
                None => { put(&mut out, "usage_tokens", borg_json::null_value()); }
            }
            put_optional(&mut out, "model", &inner.model);
        },
        Status(inner) => {
            put_text(&mut out, "type", "status_changed");
            status := borg_journal::status_name(&inner.status);
            put_text(&mut out, "status", &status);
            put_optional(&mut out, "detail", &inner.detail);
        },
        Message(inner) => {
            put_text(&mut out, "type", "message");
            put_text(&mut out, "message_id", &inner.message_id);
            put_text(&mut out, "actor", &inner.actor);
            put_text(&mut out, "text", &inner.text);
            // `skip_serializing_if = "Vec::is_empty"`: an empty attachment list is omitted.
            if inner.attachments.len() > 0 {
                mut items = borg_json::empty_list();
                mut index = 0;
                while index < inner.attachments.len() {
                    written := borg_json::Json::Str(inner.attachments[index].text());
                    items.push(written);
                    index += 1;
                }
                put(&mut out, "attachments", borg_json::Json::Arr(items));
            }
            put_text(&mut out, "status", &inner.status);
            put_optional(&mut out, "delivery", &inner.delivery);
        },
        Delta(inner) => {
            put_text(&mut out, "type", "message_delta");
            put_text(&mut out, "message_id", &inner.message_id);
            put_text(&mut out, "delta", &inner.delta);
        },
        GoalCreated(inner) => {
            put_text(&mut out, "type", "goal_created");
            put_text(&mut out, "goal_id", &inner.goal_id);
            put_text(&mut out, "objective", &inner.objective);
            // A budget is a number on the wire, or null when the goal has none.
            match copy_optional_number(&inner.token_budget) {
                Some(count) => {
                    put(&mut out, "token_budget", borg_json::Json::Num(borg_json::number_text(count)));
                },
                None => { put(&mut out, "token_budget", borg_json::null_value()); }
            }
        },
        GoalUpdated(inner) => {
            put_text(&mut out, "type", "goal_updated");
            put_text(&mut out, "goal_id", &inner.goal_id);
            shown := goal_status_name(&inner.status);
            put_text(&mut out, "status", &shown);
        },
        PlanProjected(inner) => {
            put_text(&mut out, "type", "plan_projected");
            put_text(&mut out, "participant_id", &inner.participant);
            put(&mut out, "workspace_revision", borg_json::Json::Num(borg_json::number_text(inner.revision)));
            mut items = borg_json::empty_list();
            mut index = 0;
            while index < inner.items.len() {
                items.push(encode_plan_item(&inner.items[index]));
                index += 1;
            }
            put(&mut out, "items", borg_json::Json::Arr(items));
        },
        WorkProjected(inner) => {
            put_text(&mut out, "type", "work_projected");
            put(&mut out, "revision", borg_json::Json::Num(borg_json::number_text(inner.revision)));
            mut items = borg_json::empty_list();
            mut index = 0;
            while index < inner.items.len() {
                items.push(encode_work_item(&inner.items[index]));
                index += 1;
            }
            put(&mut out, "items", borg_json::Json::Arr(items));
        }
    }
    return borg_json::object_of(&out);
}

pub fn wire<a>(value: (&a Event)) -> string {
    encoded := encode(&value);
    return borg_json::write(&encoded);
}

pub fn encode<a>(value: (&a Event)) -> borg_json::Json {
    mut root = borg_json::empty_members();
    put_text(&mut root, "id", &value.id);
    put_text(&mut root, "session_id", &value.session_id);
    put(&mut root, "sequence", borg_json::Json::Num(borg_json::number_text(value.sequence)));
    put_text(&mut root, "created_at", &value.created_at);
    boxed := encode_kind(&value.kind);
    put(&mut root, "kind", boxed);
    return borg_json::object_of(&root);
}

// ---- binary event stream ----
//
// The persisted session state is a sequence of these events, not an opaque payload, so a reader can
// refuse by name what it does not understand instead of decoding the wrong fields:
//
//   event    u8      tag: 1 started, 2 titled, 3 status_changed, 4 message, 5 message_delta,
//                         6 goal_created, 7 goal_updated, 8 plan_projected, 9 work_projected
//            u32 LE  body length N
//            N bytes body
//   body     text id, text session_id, u64 LE sequence, text created_at, then the kind
//              started         nothing
//              titled          text title, u8 generated, optional u64 usage_tokens, optional text model
//              status_changed  text status, optional text detail
//              message         text message_id, text actor, text text, text[] attachments,
//                              text status, optional text delivery
//              message_delta   text message_id, text delta
//              goal_created    text goal_id, text objective, optional u64 token_budget
//              goal_updated    text goal_id, text status
//              plan_projected  text participant_id, u64 workspace_revision, plan item[] items
//              work_projected  u64 revision, work item[] items
//   plan item              text id, text content, text status, optional text work_id
//   work item              text id, text title, optional text assignee, text status
//   text     u32 LE byte length, then that many bytes
//   text[]   u32 LE count, then that many texts
//   u8       boolean 0 or 1; any other value is refused rather than read as "true"
//   optional u8 presence, 0 absent or 1 present and the value follows; any other value is refused
//
// A tag and a length per event make three things possible that an opaque payload cannot: an unknown
// tag is named instead of being decoded as some other kind, a final event whose bytes are missing is
// refused instead of truncated into a plausible row, and a declared length is always checked against
// the bytes that are actually present before it is used, so no attacker-controlled length is ever
// turned into an allocation. The list count is checked the same way (each element needs at least its
// four byte length) so a huge count cannot spin the reader.
pub const STREAM_OK: u64 = 0;
// A tag outside 1..9.
pub const UNKNOWN_TAG: u64 = 20;
// The bytes end before a declared extent (an event body, a text, or a list) does.
pub const TRUNCATED_EVENT: u64 = 21;
// A declared length exceeds what one event may occupy; refused before the read starts.
pub const LENGTH_OVERFLOW: u64 = 22;
// A presence or boolean byte that is neither 0 nor 1.
pub const BAD_FIELD: u64 = 23;
// An event body carried bytes past its last field.
pub const TRAILING_BYTES: u64 = 24;

const TAG_STARTED: u64 = 1;
const TAG_TITLED: u64 = 2;
const TAG_STATUS: u64 = 3;
const TAG_MESSAGE: u64 = 4;
const TAG_DELTA: u64 = 5;
const TAG_GOAL_CREATED: u64 = 6;
const TAG_GOAL_UPDATED: u64 = 7;
const TAG_PLAN: u64 = 8;
const TAG_WORK: u64 = 9;

// The ceiling on one event's body: a declared length above it is refused as LENGTH_OVERFLOW rather
// than compared against a file that would have to be that large to be honest.
pub const MAX_EVENT_BODY: u64 = 262144;

pub struct Stream {
    status: u64,
    events: Event[]
}

pub fn stream_status<a>(value: (&a Stream)) -> u64 {
    return value.status;
}


// A refused stream carries no events: nothing half-decoded is handed to a caller.
pub fn stream_events<a>(value: (&a Stream)) -> Event[] {
    mut out = Event[];
    mut index = 0;
    while index < value.events.len() {
        out.push(copy_event(&value.events[index]));
        index = index + 1;
    }
    return out;
}

pub fn copy_event<a>(value: (&a Event)) -> Event {
    return Event {
        id: value.id.text(),
        session_id: value.session_id.text(),
        sequence: value.sequence,
        created_at: value.created_at.text(),
        kind: copy_kind(&value.kind)
    };
}

fn copy_kind<a>(value: (&a Kind)) -> Kind {
    // Built by assignment rather than returned from an arm: a `return` of an enum constructor around
    // a struct literal inside a match arm does not parse.
    mut out = Kind::Started;
    match value {
        Started => { },
        Titled(inner) => {
            out = Kind::Titled(Titled {
                title: inner.title.text(),
                generated: inner.generated,
                usage_tokens: copy_optional_number(&inner.usage_tokens),
                model: copy_optional(&inner.model)
            });
        },
        Status(inner) => {
            out = Kind::Status(StatusChange {
                status: copy_status(&inner.status),
                detail: copy_optional(&inner.detail)
            });
        },
        Message(inner) => {
            out = Kind::Message(Message {
                message_id: inner.message_id.text(),
                actor: inner.actor.text(),
                text: inner.text.text(),
                attachments: copy_list(&inner.attachments),
                status: inner.status.text(),
                delivery: copy_optional(&inner.delivery)
            });
        },
        Delta(inner) => {
            out = Kind::Delta(Delta {
                message_id: inner.message_id.text(),
                delta: inner.delta.text()
            });
        },
        GoalCreated(inner) => {
            out = Kind::GoalCreated(GoalCreated {
                goal_id: inner.goal_id.text(),
                objective: inner.objective.text(),
                token_budget: copy_optional_number(&inner.token_budget)
            });
        },
        GoalUpdated(inner) => {
            out = Kind::GoalUpdated(GoalUpdated {
                goal_id: inner.goal_id.text(),
                status: copy_goal_status(&inner.status)
            });
        },
        PlanProjected(inner) => {
            out = Kind::PlanProjected(PlanProjected {
                participant: inner.participant.text(),
                revision: inner.revision,
                items: copy_plan_items(&inner.items)
            });
        },
        WorkProjected(inner) => {
            out = Kind::WorkProjected(WorkProjected {
                revision: inner.revision,
                items: copy_work_items(&inner.items)
            });
        }
    }
    return out;
}

pub fn copy_goal_status<a>(value: (&a GoalStatus)) -> GoalStatus {
    name := goal_status_name(value);
    mut out = GoalStatus::Active;
    match goal_status_of(&name) {
        mapped: GoalStatus => { out = mapped; },
        failure: EventError => { }
    }
    return out;
}

pub fn copy_item_status<a>(value: (&a ItemStatus)) -> ItemStatus {
    name := item_status_name(value);
    mut out = ItemStatus::Pending;
    match item_status_of(&name) {
        mapped: ItemStatus => { out = mapped; },
        failure: EventError => { }
    }
    return out;
}

pub fn copy_plan_item<a>(value: (&a PlanItem)) -> PlanItem {
    return PlanItem {
        id: value.id.text(),
        content: value.content.text(),
        status: copy_item_status(&value.status),
        work_id: copy_optional(&value.work_id)
    };
}

pub fn copy_plan_items<a>(value: (&a PlanItem[])) -> PlanItem[] {
    mut out = PlanItem[];
    mut index = 0;
    while index < value.len() {
        out.push(copy_plan_item(&value[index]));
        index += 1;
    }
    return out;
}

pub fn copy_work_item<a>(value: (&a WorkItem)) -> WorkItem {
    return WorkItem {
        id: value.id.text(),
        title: value.title.text(),
        assignee: copy_optional(&value.assignee),
        status: copy_item_status(&value.status)
    };
}

pub fn copy_work_items<a>(value: (&a WorkItem[])) -> WorkItem[] {
    mut out = WorkItem[];
    mut index = 0;
    while index < value.len() {
        out.push(copy_work_item(&value[index]));
        index += 1;
    }
    return out;
}

// A status is an enum, so it is copied by name rather than moved out of the borrowed event.
fn copy_status<a>(value: (&a borg_journal::Status)) -> borg_journal::Status {
    name := borg_journal::status_name(value);
    mut out = borg_journal::starting();
    match status_of(&name) {
        mapped: borg_journal::Status => { out = mapped; },
        failure: EventError => { }
    }
    return out;
}

fn copy_list<a>(value: (&a string[])) -> string[] {
    mut out = string[];
    mut index = 0;
    while index < value.len() {
        out.push(value[index].text());
        index = index + 1;
    }
    return out;
}

// The zero event. `decode_event` uses it on a refusal path; a caller that has to hold an `Event`
// where nothing decoded - a generated journal, a refused stream - gets it from here instead of
// borrowing one it would have to fabricate.
pub fn no_event() -> Event {
    return empty_event();
}

fn empty_event() -> Event {
    return Event {
        id: "".text(),
        session_id: "".text(),
        sequence: 0,
        created_at: "".text(),
        kind: Kind::Started
    };
}

// ---- writer ----

fn push_uint(out: (&mut u8[]), value: u64, width: u64) {
    mut rest = value;
    mut index = u64(0);
    while index < width {
        out.push(u8(rest % 256));
        rest = rest / 256;
        index = index + 1;
    }
}

fn push_bytes<a>(out: (&mut u8[]), bytes: (&a [u8])) {
    for byte in bytes {
        out.push(byte);
    }
}

fn push_text<a>(out: (&mut u8[]), text: (&a [u8])) {
    push_uint(out, text.len(), 4);
    push_bytes(out, text);
}

fn push_bool(out: (&mut u8[]), value: bool) {
    if value {
        push_uint(out, 1, 1);
    } else {
        push_uint(out, 0, 1);
    }
}

fn push_optional_number<a>(out: (&mut u8[]), value: (&a u64?)) {
    match value {
        Some(number) => {
            push_uint(out, 1, 1);
            push_uint(out, number, 8);
        },
        None => { push_uint(out, 0, 1); }
    }
}

fn push_optional_text<a>(out: (&mut u8[]), value: (&a string?)) {
    match value {
        Some(text) => {
            push_uint(out, 1, 1);
            push_text(out, &text);
        },
        None => { push_uint(out, 0, 1); }
    }
}

fn push_text_list<a>(out: (&mut u8[]), items: (&a string[])) {
    push_uint(out, items.len(), 4);
    mut index = 0;
    while index < items.len() {
        push_text(out, &items[index]);
        index = index + 1;
    }
}

fn tag_code<a>(value: (&a Kind)) -> u64 {
    match value {
        Started => { return TAG_STARTED; },
        Titled(inner) => { return TAG_TITLED; },
        Status(inner) => { return TAG_STATUS; },
        Message(inner) => { return TAG_MESSAGE; },
        Delta(inner) => { return TAG_DELTA; },
        GoalCreated(inner) => { return TAG_GOAL_CREATED; },
        GoalUpdated(inner) => { return TAG_GOAL_UPDATED; },
        PlanProjected(inner) => { return TAG_PLAN; },
        WorkProjected(inner) => { return TAG_WORK; }
    }
}

fn push_plan_items<a>(out: (&mut u8[]), items: (&a PlanItem[])) {
    push_uint(out, items.len(), 4);
    mut index = 0;
    while index < items.len() {
        push_text(out, &items[index].id);
        push_text(out, &items[index].content);
        shown := item_status_name(&items[index].status);
        push_text(out, &shown);
        push_optional_text(out, &items[index].work_id);
        index += 1;
    }
}

fn push_work_items<a>(out: (&mut u8[]), items: (&a WorkItem[])) {
    push_uint(out, items.len(), 4);
    mut index = 0;
    while index < items.len() {
        push_text(out, &items[index].id);
        push_text(out, &items[index].title);
        push_optional_text(out, &items[index].assignee);
        shown := item_status_name(&items[index].status);
        push_text(out, &shown);
        index += 1;
    }
}

fn encode_body<a>(value: (&a Event)) -> u8[] {
    mut out = u8[];
    push_text(&mut out, &value.id);
    push_text(&mut out, &value.session_id);
    push_uint(&mut out, value.sequence, 8);
    push_text(&mut out, &value.created_at);
    match &value.kind {
        Started => { },
        Titled(inner) => {
            push_text(&mut out, &inner.title);
            push_bool(&mut out, inner.generated);
            push_optional_number(&mut out, &inner.usage_tokens);
            push_optional_text(&mut out, &inner.model);
        },
        Status(inner) => {
            name := borg_journal::status_name(&inner.status);
            push_text(&mut out, &name);
            push_optional_text(&mut out, &inner.detail);
        },
        Message(inner) => {
            push_text(&mut out, &inner.message_id);
            push_text(&mut out, &inner.actor);
            push_text(&mut out, &inner.text);
            push_text_list(&mut out, &inner.attachments);
            push_text(&mut out, &inner.status);
            push_optional_text(&mut out, &inner.delivery);
        },
        Delta(inner) => {
            push_text(&mut out, &inner.message_id);
            push_text(&mut out, &inner.delta);
        },
        GoalCreated(inner) => {
            push_text(&mut out, &inner.goal_id);
            push_text(&mut out, &inner.objective);
            push_optional_number(&mut out, &inner.token_budget);
        },
        GoalUpdated(inner) => {
            push_text(&mut out, &inner.goal_id);
            shown := goal_status_name(&inner.status);
            push_text(&mut out, &shown);
        },
        PlanProjected(inner) => {
            push_text(&mut out, &inner.participant);
            push_uint(&mut out, inner.revision, 8);
            push_plan_items(&mut out, &inner.items);
        },
        WorkProjected(inner) => {
            push_uint(&mut out, inner.revision, 8);
            push_work_items(&mut out, &inner.items);
        }
    }
    return out;
}

pub fn encode_stream<a>(events: (&a Event[])) -> u8[] {
    mut out = u8[];
    mut index = 0;
    while index < events.len() {
        body := encode_body(&events[index]);
        push_uint(&mut out, tag_code(&events[index].kind), 1);
        push_uint(&mut out, body.len(), 4);
        push_bytes(&mut out, &body);
        index = index + 1;
    }
    return out;
}

// ---- reader ----

// Little endian, most significant byte last: accumulating from the top keeps every intermediate
// inside u64, where a 256^width scale would overflow the checked arithmetic on the last step.
fn read_uint<a>(bytes: (&a [u8]), at: u64, width: u64) -> u64 {
    mut value = u64(0);
    mut index = width;
    while index > 0 {
        index = index - 1;
        value = value * 256 + u64(bytes[at + index]);
    }
    return value;
}

// Every field reader takes the cursor so a short read can both name its refusal and leave the rest of
// the decode harmless: once `status` is no longer STREAM_OK the readers return a default and the
// caller reports the first reason.
fn decode_text<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> string {
    mut out = u8[];
    if *status != STREAM_OK {
        return out.text();
    }
    if end - *at < 4 {
        *status = TRUNCATED_EVENT;
        return out.text();
    }
    length := read_uint(bytes, *at, 4);
    *at = *at + 4;
    if length > end - *at {
        *status = TRUNCATED_EVENT;
        return out.text();
    }
    mut index = *at;
    while index < *at + length {
        out.push(bytes[index]);
        index = index + 1;
    }
    *at = *at + length;
    return out.text();
}

fn decode_u64<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> u64 {
    if *status != STREAM_OK {
        return 0;
    }
    if end - *at < 8 {
        *status = TRUNCATED_EVENT;
        return 0;
    }
    value := read_uint(bytes, *at, 8);
    *at = *at + 8;
    return value;
}

fn decode_bool<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> bool {
    if *status != STREAM_OK {
        return false;
    }
    if end - *at < 1 {
        *status = TRUNCATED_EVENT;
        return false;
    }
    marker := u64(bytes[*at]);
    *at = *at + 1;
    if marker == 1 {
        return true;
    }
    if marker != 0 {
        *status = BAD_FIELD;
    }
    return false;
}

fn decode_optional_text<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> string? {
    if *status != STREAM_OK {
        return None;
    }
    if end - *at < 1 {
        *status = TRUNCATED_EVENT;
        return None;
    }
    marker := u64(bytes[*at]);
    *at = *at + 1;
    if marker == 0 {
        return None;
    }
    if marker != 1 {
        *status = BAD_FIELD;
        return None;
    }
    text := decode_text(bytes, at, end, status);
    if *status != STREAM_OK {
        return None;
    }
    return Some(text);
}

fn decode_optional_number<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> u64? {
    if *status != STREAM_OK {
        return None;
    }
    if end - *at < 1 {
        *status = TRUNCATED_EVENT;
        return None;
    }
    marker := u64(bytes[*at]);
    *at = *at + 1;
    if marker == 0 {
        return None;
    }
    if marker != 1 {
        *status = BAD_FIELD;
        return None;
    }
    value := decode_u64(bytes, at, end, status);
    if *status != STREAM_OK {
        return None;
    }
    return Some(value);
}

fn decode_text_list<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> string[] {
    mut out = string[];
    if *status != STREAM_OK {
        return out;
    }
    if end - *at < 4 {
        *status = TRUNCATED_EVENT;
        return out;
    }
    count := read_uint(bytes, *at, 4);
    *at = *at + 4;
    // Each element carries at least its own four byte length, so a count that could not fit in the
    // remaining bytes is refused before the loop rather than after billions of empty iterations.
    if count > (end - *at) / 4 {
        *status = TRUNCATED_EVENT;
        return out;
    }
    mut index = u64(0);
    while index < count {
        item := decode_text(bytes, at, end, status);
        if *status != STREAM_OK {
            return out;
        }
        out.push(item);
        index = index + 1;
    }
    return out;
}

// A count whose elements could not fit in the remaining bytes is refused before the loop, exactly as
// `decode_text_list` does: each item carries at least its own four byte length somewhere, so a count
// larger than the remaining bytes divided by four cannot be honest.
fn decode_count<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> u64 {
    if *status != STREAM_OK {
        return 0;
    }
    if end - *at < 4 {
        *status = TRUNCATED_EVENT;
        return 0;
    }
    count := read_uint(bytes, *at, 4);
    *at = *at + 4;
    if count > (end - *at) / 4 {
        *status = TRUNCATED_EVENT;
        return 0;
    }
    return count;
}

fn decode_plan_items<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> PlanItem[] {
    mut out = PlanItem[];
    count := decode_count(bytes, at, end, status);
    if *status != STREAM_OK {
        return out;
    }
    mut index = u64(0);
    while index < count {
        id := decode_text(bytes, at, end, status);
        content := decode_text(bytes, at, end, status);
        shown := decode_text(bytes, at, end, status);
        work := decode_optional_text(bytes, at, end, status);
        mut typed = ItemStatus::Pending;
        match item_status_of(&shown) {
            mapped: ItemStatus => { typed = mapped; },
            failure: EventError => { *status = BAD_FIELD; }
        }
        if *status != STREAM_OK {
            return out;
        }
        out.push(PlanItem { id: id, content: content, status: typed, work_id: work });
        index = index + 1;
    }
    return out;
}

fn decode_work_items<a>(bytes: (&a [u8]), at: (&mut u64), end: u64, status: (&mut u64)) -> WorkItem[] {
    mut out = WorkItem[];
    count := decode_count(bytes, at, end, status);
    if *status != STREAM_OK {
        return out;
    }
    mut index = u64(0);
    while index < count {
        id := decode_text(bytes, at, end, status);
        title := decode_text(bytes, at, end, status);
        assignee := decode_optional_text(bytes, at, end, status);
        shown := decode_text(bytes, at, end, status);
        mut typed = ItemStatus::Pending;
        match item_status_of(&shown) {
            mapped: ItemStatus => { typed = mapped; },
            failure: EventError => { *status = BAD_FIELD; }
        }
        if *status != STREAM_OK {
            return out;
        }
        out.push(WorkItem { id: id, title: title, assignee: assignee, status: typed });
        index = index + 1;
    }
    return out;
}

fn decode_event<a>(bytes: (&a [u8]), tag: u64, at: (&mut u64), end: u64, status: (&mut u64)) -> Event {
    if *status != STREAM_OK {
        return empty_event();
    }
    id := decode_text(bytes, at, end, status);
    session_id := decode_text(bytes, at, end, status);
    sequence := decode_u64(bytes, at, end, status);
    created_at := decode_text(bytes, at, end, status);
    mut kind = Kind::Started;
    if tag == TAG_TITLED {
        title := decode_text(bytes, at, end, status);
        generated := decode_bool(bytes, at, end, status);
        tokens := decode_optional_number(bytes, at, end, status);
        model := decode_optional_text(bytes, at, end, status);
        kind = Kind::Titled(Titled {
            title: title,
            generated: generated,
            usage_tokens: tokens,
            model: model
        });
    } else if tag == TAG_STATUS {
        name := decode_text(bytes, at, end, status);
        detail := decode_optional_text(bytes, at, end, status);
        if *status == STREAM_OK {
            match status_of(&name) {
                mapped: borg_journal::Status => {
                    kind = Kind::Status(StatusChange { status: mapped, detail: detail });
                },
                failure: EventError => { *status = BAD_FIELD; }
            }
        }
    } else if tag == TAG_MESSAGE {
        message_id := decode_text(bytes, at, end, status);
        actor := decode_text(bytes, at, end, status);
        text := decode_text(bytes, at, end, status);
        attachments := decode_text_list(bytes, at, end, status);
        row_status := decode_text(bytes, at, end, status);
        delivery := decode_optional_text(bytes, at, end, status);
        kind = Kind::Message(Message {
            message_id: message_id,
            actor: actor,
            text: text,
            attachments: attachments,
            status: row_status,
            delivery: delivery
        });
    } else if tag == TAG_DELTA {
        message_id := decode_text(bytes, at, end, status);
        delta := decode_text(bytes, at, end, status);
        kind = Kind::Delta(Delta { message_id: message_id, delta: delta });
    } else if tag == TAG_GOAL_CREATED {
        goal_id := decode_text(bytes, at, end, status);
        objective := decode_text(bytes, at, end, status);
        budget := decode_optional_number(bytes, at, end, status);
        kind = Kind::GoalCreated(GoalCreated {
            goal_id: goal_id,
            objective: objective,
            token_budget: budget
        });
    } else if tag == TAG_GOAL_UPDATED {
        goal_id := decode_text(bytes, at, end, status);
        shown := decode_text(bytes, at, end, status);
        if *status == STREAM_OK {
            match goal_status_of(&shown) {
                mapped: GoalStatus => {
                    kind = Kind::GoalUpdated(GoalUpdated { goal_id: goal_id, status: mapped });
                },
                failure: EventError => { *status = BAD_FIELD; }
            }
        }
    } else if tag == TAG_PLAN {
        participant := decode_text(bytes, at, end, status);
        revision := decode_u64(bytes, at, end, status);
        items := decode_plan_items(bytes, at, end, status);
        kind = Kind::PlanProjected(PlanProjected {
            participant: participant,
            revision: revision,
            items: items
        });
    } else if tag == TAG_WORK {
        revision := decode_u64(bytes, at, end, status);
        items := decode_work_items(bytes, at, end, status);
        kind = Kind::WorkProjected(WorkProjected { revision: revision, items: items });
    }
    if (*status == STREAM_OK) && (*at != end) {
        *status = TRAILING_BYTES;
    }
    return Event {
        id: id,
        session_id: session_id,
        sequence: sequence,
        created_at: created_at,
        kind: kind
    };
}

pub fn decode_stream<a>(bytes: (&a [u8])) -> Stream {
    mut events = Event[];
    mut at = u64(0);
    while at < bytes.len() {
        if bytes.len() - at < 5 {
            // The stream ends inside an event header: its tag or its length is cut off.
            return Stream { status: TRUNCATED_EVENT, events: Event[] };
        }
        tag := read_uint(bytes, at, 1);
        length := read_uint(bytes, at + 1, 4);
        at = at + 5;
        if (tag < TAG_STARTED) || (tag > TAG_WORK) {
            return Stream { status: UNKNOWN_TAG, events: Event[] };
        }
        if length > MAX_EVENT_BODY {
            return Stream { status: LENGTH_OVERFLOW, events: Event[] };
        }
        if length > bytes.len() - at {
            return Stream { status: TRUNCATED_EVENT, events: Event[] };
        }
        mut status = STREAM_OK;
        end := at + length;
        event := decode_event(bytes, tag, &mut at, end, &mut status);
        if status != STREAM_OK {
            return Stream { status: status, events: Event[] };
        }
        events.push(event);
        at = end;
    }
    return Stream { status: STREAM_OK, events: events };
}
