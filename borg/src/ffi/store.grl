module borg_store;
use borg_events;
use core;
use sys_grail;

// Persisting session state through the C OS ABI.
//
// The write path is the one Borg uses for state that must survive a crash mid-write: write a
// same-directory temporary file, close it, then rename over the destination, because a rename within
// a directory is atomic while a partial overwrite is not (crates/borg-provider/src/credentials.rs:
// "Same-directory temp file keeps the rename atomic and never widens the file's mode"). The rename
// is the one operation the FFI wrapper does not declare, so it is declared here against the same
// object file; nothing under lib/ or compiler/ is touched.
//
// The file carries a versioned frame around a typed event stream (see borg_events for the payload
// layout: tag, length and explicitly typed fields per event):
//
//   offset 0   3 bytes   magic "BGS"
//   offset 3   1 byte    format version as an ASCII digit, "2" for the typed event stream
//   offset 4   8 bytes   payload length, little endian
//   offset 12  N bytes   payload, a sequence of tagged events
//
// Version "1" wrote an opaque payload behind the same magic, so it is refused by name instead of
// being decoded as events: disagreeing about what a byte means is exactly what the version is for.
// The digit stays ASCII so the header still reads as the magic the first format established.
//
// A file shorter than the frame, with another magic, written by another version, larger than
// MAX_PAYLOAD, or whose length disagrees with its header is refused with its reason, never partially
// accepted; a payload that is not a well-formed event stream is refused with the event reader's
// reason (borg_events: UNKNOWN_TAG, TRUNCATED_EVENT, LENGTH_OVERFLOW, BAD_FIELD, TRAILING_BYTES).
// A declared length is never trusted on its own: the frame length must equal the bytes present, and
// the size is checked before the file is read, so no header can make the reader allocate more than
// the file actually holds. Handles are never named here: the ABI's file type is opaque and
// module-scoped, so every call is threaded with `?` the way the landed FFI test threads it.

extern "C" lib "grail_ffi_linux.o" fn grail_os_fs_rename(
    from: &[u8], to: &[u8], flags: u64
) -> i64;

const RENAME_REPLACE: u64 = 1;
const MAGIC_0: u64 = 66;
const MAGIC_1: u64 = 71;
const MAGIC_2: u64 = 83;
const HEADER: u64 = 12;
const MODE_OWNER: u64 = 384;

// The format this build writes and the only one it reads: the ASCII digit "2" that follows "BGS",
// where "1" was the opaque payload. The digit, not its numeric value, so the header stays text.
pub const VERSION: u64 = 50;

// The ceiling on a stored payload: a header claiming more is refused before the file is read, so a
// corrupt or hostile length cannot turn into an allocation the file never had to back.
pub const MAX_PAYLOAD: u64 = 1048576;

// Decoded outcomes, so a caller can say why a file or a write was refused. The frame codes keep the
// numbers the first framing used; the event-stream codes live in borg_events and start at 20.
pub const OK: u64 = 0;
pub const SHORT_FILE: u64 = 2;
pub const BAD_MAGIC: u64 = 3;
pub const LENGTH_MISMATCH: u64 = 4;
pub const UNSUPPORTED_VERSION: u64 = 5;
pub const PAYLOAD_TOO_LARGE: u64 = 6;
pub const WRITE_SHORT: u64 = 7;
pub const RENAME_FAILED: u64 = 8;

pub struct Framed {
    status: u64,
    payload: u8[]
}

pub struct Loaded {
    status: u64,
    events: borg_events::Event[]
}

pub fn loaded_status<a>(value: (&a Loaded)) -> u64 {
    return value.status;
}

pub fn loaded_count<a>(value: (&a Loaded)) -> u64 {
    return value.events.len();
}

pub fn loaded_events<a>(value: (&a Loaded)) -> borg_events::Event[] {
    mut out = borg_events::Event[];
    mut index = 0;
    while index < value.events.len() {
        out.push(borg_events::copy_event(&value.events[index]));
        index = index + 1;
    }
    return out;
}

fn copy_text<a>(text: (&a [u8])) -> string {
    mut out = u8[];
    for byte in text {
        out.push(byte);
    }
    return out.text();
}

fn append_text<a, b>(out: (&a mut u8[]), text: (&b [u8])) {
    for byte in text {
        out.push(byte);
    }
}

fn put_u64(out: (&mut u8[]), value: u64) {
    mut rest = value;
    mut index = u64(0);
    while index < 8 {
        out.push(u8(rest % 256));
        rest = rest / 256;
        index = index + 1;
    }
}

fn revealed_length<a>(bytes: (&a [u8])) -> u64 {
    mut value = u64(0);
    mut index = u64(8);
    while index > 0 {
        index = index - 1;
        value = value * 256 + u64(bytes[4 + index]);
    }
    return value;
}

// Frames a payload: magic, version, little-endian length, payload.
pub fn frame<a>(payload: (&a [u8])) -> u8[] {
    mut out = u8[];
    out.push(MAGIC_0);
    out.push(MAGIC_1);
    out.push(MAGIC_2);
    out.push(VERSION);
    put_u64(&mut out, payload.len());
    append_text(&mut out, payload);
    return out;
}

// Splits a stored file into its payload, or reports the reason it cannot be trusted.
fn unframe<a>(bytes: (&a [u8])) -> Framed {
    if bytes.len() < HEADER {
        return Framed { status: SHORT_FILE, payload: u8[] };
    }
    if (bytes[0] != MAGIC_0) || (bytes[1] != MAGIC_1) || (bytes[2] != MAGIC_2) {
        return Framed { status: BAD_MAGIC, payload: u8[] };
    }
    if bytes[3] != VERSION {
        return Framed { status: UNSUPPORTED_VERSION, payload: u8[] };
    }
    declared := revealed_length(&bytes);
    if declared > MAX_PAYLOAD {
        return Framed { status: PAYLOAD_TOO_LARGE, payload: u8[] };
    }
    if bytes.len() != HEADER + declared {
        return Framed { status: LENGTH_MISMATCH, payload: u8[] };
    }
    mut payload = u8[];
    mut index = HEADER;
    while index < bytes.len() {
        payload.push(bytes[index]);
        index = index + 1;
    }
    return Framed { status: OK, payload: payload };
}

// Writes `events` to `path` atomically: same-directory temp, close, rename over the destination.
// Returns 0 on success, or a code naming which step failed.
pub fn persist<a, b>(path: (&a [u8]), events: (&b borg_events::Event[])) -> u64 |? sys_grail::Error {
    payload := borg_events::encode_stream(events);
    if payload.len() > MAX_PAYLOAD {
        return PAYLOAD_TOO_LARGE;
    }
    mut trailing = u8[];
    append_text(&mut trailing, &path);
    append_text(&mut trailing, &u8[46, 116, 109, 112]);
    bytes := frame(&payload);
    mut flags = sys_grail::OPEN_WRITE;
    flags = flags + sys_grail::OPEN_CREATE;
    flags = flags + sys_grail::OPEN_TRUNCATE;
    file := sys_grail::open(&trailing, flags, MODE_OWNER)?;
    written := sys_grail::write(file, &bytes)?;
    if written != bytes.len() {
        sys_grail::close(file)?;
        return WRITE_SHORT;
    }
    sys_grail::close(file)?;
    mut status: i64 = 0;
    unsafe {
        status = grail_os_fs_rename(&trailing, &path, RENAME_REPLACE);
    }
    if status < 0 {
        return RENAME_FAILED;
    }
    return OK;
}

// Reads and validates a stored file, returning the typed events it holds. A file that cannot be
// opened at all surfaces as the ABI's error, which the caller reports as missing rather than as a
// decode failure.
pub fn load<a>(path: (&a [u8])) -> Loaded |? sys_grail::Error {
    file := sys_grail::open(&path, sys_grail::OPEN_READ, 0)?;
    size := sys_grail::size(file)?;
    if size > HEADER + MAX_PAYLOAD {
        sys_grail::close(file)?;
        return Loaded { status: PAYLOAD_TOO_LARGE, events: borg_events::Event[] };
    }
    bytes := sys_grail::read_bytes(file, size)?;
    sys_grail::close(file)?;
    framed := unframe(&bytes);
    if framed.status != OK {
        return Loaded { status: framed.status, events: borg_events::Event[] };
    }
    stream := borg_events::decode_stream(&framed.payload);
    return Loaded {
        status: borg_events::stream_status(&stream),
        events: borg_events::stream_events(&stream)
    };
}
