module core;

pub enum Option<type T> { None, Some(T) }
pub enum Result<type T, type E> { Ok(T), Err(E) }
pub struct Pair<type T, type U> { first: T, second: U }

pub fn some<type T>(value:T)->Option<T>{return Option::Some(value);}
pub fn none<type T>()->Option<T>{return Option::None;}
pub fn ok<type T,type E>(value:T)->Result<T,E>{return Result::Ok(value);}
pub fn err<type T,type E>(error:E)->Result<T,E>{return Result::Err(error);}
pub fn pair<type T,type U>(first:T,second:U)->Pair<T,U>{
    return Pair{first:first,second:second};
}
pub fn unwrap_option<type T>(value:Option<T>)->T{return value!;}
pub fn unwrap_result<type T,type E>(value:Result<T,E>)->T{return value!;}
pub fn discard<type T>(value:T)->unit{return ();}
pub fn identity<type T>(value:T)->T{return value;}
