module collections;
use core;

pub fn new<type T>()->vec<T>{return vec<T>();}
pub fn push<a,type T>(values:ref_mut<a,vec<T>>,value:T)->unit{
    vec_push(values,value);
    return ();
}
pub fn pop<a,type T>(values:ref_mut<a,vec<T>>)->core::Option<T>{
    if len(values)!=0{return core::some(vec_pop(values));}
    return core::none<T>();
}
pub fn get<a,type T>(values:ref<a,vec<T>>,index:num)->ref<a,T>{
    return vec_get(values,index);
}
pub fn get_mut<a,type T>(values:ref_mut<a,vec<T>>,index:num)->ref_mut<a,T>{
    return vec_get_mut(values,index);
}
