use echo_text;
fn text_check<a>(input: read<a>) -> num {
    var s = echo_text(text(input));
    append_text(s, "é");
    copied := text(read(s));
    var empty = "";
    append_text(empty, "");
    view := read(copied);
    var sum = 0;
    for i in len(view) { sum = sum + at(view, i); }
    return sum * 257 + len(s);
}
