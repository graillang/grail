use echo_text;
fn text_check<a>(input: read<a>) -> num {
    let s = echo_text(text(input));
    append_text(s, "é");
    let copied = text(read(s));
    let empty = "";
    append_text(empty, "");
    let view = read(copied);
    var sum = 0;
    for i in len(view) { sum = sum + at(view, i); }
    return sum * 257 + len(s);
}
