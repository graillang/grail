module parse;
use core;
struct Token<a>{span:read<a>,name:string,value:num}
pub fn parse<a>(input:read<a>)->core::Result<Token<a>,string>{
    value :=number(read(input))?;
    return core::Result::Ok(Token{span:input,name:"num",value:value});
}
fn number<a>(input:read<a>)->core::Result<num,string>{
    if len(input)==0{return core::Result::Err("empty");}
    var value=0;
    for i in len(input){
        byte :=at(input,i);
        if byte<48{return core::Result::Err("invalid");}
        if 57<byte{return core::Result::Err("invalid");}
        digit :=byte-48;
        if 1844674407370955161<value{return core::Result::Err("overflow");}
        if value==1844674407370955161{
            if 5<digit{return core::Result::Err("overflow");}
        }
        value=value*10+digit;
    }
    return core::Result::Ok(value);
}
