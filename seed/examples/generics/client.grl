module client;
use parse;
use core;
pub fn run<a>(input:read<a>)->num{
    let wrapped=core::some(parse::parse(input));
    let result=core::unwrap_option(wrapped);
    match result{
        Ok(token)=>{return token.value+len(token.name)+len(token.span);},
        Err(error)=>{return len(error);}
    }
}
