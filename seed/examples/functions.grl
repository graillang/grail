fn functions()->num { return fib(12)+even(8)+odd(7); }
fn fib(n:num)->num {
    var value=n;
    if 1<n { value=fib(n-1)+fib(n-2); }
    return value;
}
fn even(n:num)->num {
    var value=1;
    if 0<n { value=odd(n-1); }
    return value;
}
fn odd(n:num)->num {
    var value=0;
    if 0<n { value=even(n-1); }
    return value;
}
