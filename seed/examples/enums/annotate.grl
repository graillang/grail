module annotate;
use number;
struct Token<a>{span:read<a>,name:string,value:num}
enum Outcome<a>{Err(string),Ok(Token<a>)}
pub fn parse<a>(input:read<a>)->Outcome<a>{
    let scratch="scratch";
    let value=number::parse(read(input))?;
    return Outcome::Ok(Token{span:input,name:"token",value:value});
}
