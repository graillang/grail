module cleanup;
struct Pair{a:string,b:string}
pub fn run()->num{
    var source =bytes();push(source,7);
    var i=0;
    while len(copy_bytes(source)){
        pair :=Pair{a:"a",b:"bb"};
        first :=pair.a;
        r :=read(first);assert(len(r)==1);
        i=i+1;assert(i<4);
        if i==1{continue;}
        break;
    }
    push(source,9);
    return len(source);
}
