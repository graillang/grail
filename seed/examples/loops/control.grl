module control;
pub fn counted(n:num)->num{
    var sum=0;
    for i in n{if i==2{continue;}if i==5{break;}sum=sum+i;}
    return sum;
}
pub fn repeated(n:num)->num{
    var i=0;var sum=0;
    while i<n{i=i+1;if i==2{continue;}if i==5{break;}sum=sum+i;}
    return sum;
}
pub fn nested(n:num)->num{
    var sum=0;
    for outer in n{
        for inner in 4{
            if inner==1{continue;}
            if outer==2{break;}
            sum=sum+outer*10+inner;
        }
        if outer==3{break;}
    }
    return sum;
}
pub fn unique<a>(p:mut<a>,n:num)->num{
    for i in n{
        local :=read(p);assert(len(local)==1);
        if i==0{continue;}
        break;
    }
    write(p,0,9);
    return at(read(p),0);
}
