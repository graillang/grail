use number;
// Lex decimal spans separated by '+' and parse each without copying its bytes.
fn sum<a>(input: read<a>) -> num {
    var total = 0;
    var start = 0;
    for i in len(input) {
        if at(input, i) == 43 {
            let token = slice(input, start, i);
            total = total + number(token);
            start = i + 1;
        }
    }
    let token = slice(input, start, len(input));
    return total + number(token);
}
