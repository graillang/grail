module unique;
struct Pair<a>{left:mut<a>,right:mut<a>}
pub fn run()->num{
 let a=bytes();push(a,1);let b=bytes();push(b,2);
 let p=pair(mut(a),mut(b));
 let l=mut(p.left);let r=mut(p.right);
 write(l,0,3);write(r,0,4);
 push(a,5);push(b,6);
 return at(read(a),0)+at(read(b),0)+len(a)+len(b);
}
fn pair<a>(x:mut<a>,y:mut<a>)->Pair<a>{
 return Pair{left:x,right:y};
}
