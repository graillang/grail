module use_cells;
use cells;
use core;
pub fn run()->num{
    var a =bytes();push(a,3);push(a,4);push(a,5);
    var b =bytes();push(b,7);
    var cursor =cells::Cursor{source:read(a),remaining:read(a),name:"cursor"};
    var sum=0;
    for i in 2{sum=sum+cells::advance(borrow_mut(cursor),1);}
    drop(cursor);
    var unique =cells::Unique{source:mut(a),name:"unique"};
    var old =cells::take(borrow_mut(unique),mut(b));
    write(old,0,9);drop(old);
    second :=at(read(unique.source),0);drop(unique);
    first :=at(read(a),0);
    var option =core::some(mut(a));
    taken :=cells::pop(borrow_mut(option));drop(option);
    var extracted =taken!;write(extracted,2,13);drop(extracted);
    third :=at(read(a),2);
    retired :=cells::Unique{source:mut(a),name:"retired"};
    match cells::fail(retired){Ok(n)=>{sum=sum+n;},Err(e)=>{sum=sum+len(e);}}
    var view =mut(a);
    var previous =cells::replace(borrow_mut(view),mut(b));
    write(previous,1,11);drop(previous);
    return sum+first+second+third+at(read(view),0);
}
