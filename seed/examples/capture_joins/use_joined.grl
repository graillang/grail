module use_joined;
use joined;
use core;
pub fn run()->num{
    var a =bytes();push(a,7);var b =bytes();push(b,11);var c =bytes();push(c,13);
    var cell =joined::Cell{source:read(a),name:"cell"};
    var sum=0;
    sum=sum+at(joined::fill(borrow_mut(cell),read(b),read(c),0),0);
    sum=sum+at(joined::fill(borrow_mut(cell),read(b),read(c),1),0);
    sum=sum+at(joined::fill(borrow_mut(cell),read(b),read(c),2),0);
    sum=sum+at(joined::fill(borrow_mut(cell),read(b),read(c),3),0);
    drop(cell);
    var option =core::some(mut(a));var output =joined::Cell{source:read(b),name:"output"};
    span :=joined::pop_loop(borrow_mut(option),borrow_mut(output),3);
    drop(option);drop(output);
    return sum+at(span,0)+len(span);
}
