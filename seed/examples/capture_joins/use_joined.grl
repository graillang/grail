module use_joined;
use joined;
use core;
pub fn run()->num{
    let a=bytes();push(a,7);let b=bytes();push(b,11);let c=bytes();push(c,13);
    let cell=joined::Cell{source:read(a),name:"cell"};
    var sum=0;
    sum=sum+at(joined::fill(borrow_mut(cell),read(b),read(c),0),0);
    sum=sum+at(joined::fill(borrow_mut(cell),read(b),read(c),1),0);
    sum=sum+at(joined::fill(borrow_mut(cell),read(b),read(c),2),0);
    sum=sum+at(joined::fill(borrow_mut(cell),read(b),read(c),3),0);
    drop(cell);
    let option=core::some(mut(a));let output=joined::Cell{source:read(b),name:"output"};
    let span=joined::pop_loop(borrow_mut(option),borrow_mut(output),3);
    drop(option);drop(output);
    return sum+at(span,0)+len(span);
}
