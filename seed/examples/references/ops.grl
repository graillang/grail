module ops;
pub struct Record{count:num,name:string}
pub fn replace<a,type T>(slot:ref_mut<a,T>,value:T)->T{return exchange(slot,value);}
pub fn update<a>(record:ref_mut<a,Record>)->num{
    let before=replace(borrow_mut(record.name),"newer");
    let count=replace(borrow_mut(record.count),11);
    return len(before)+count;
}
pub fn grow<a>(value:ref_mut<a,bytes>,byte:num)->unit{push(value,byte);return ();}
pub fn choose<a>(left:ref_mut<a,num>,right:ref_mut<a,num>,flag:num)->ref_mut<a,num>{
    if flag{return left;}
    return right;
}
