module values;
use ops;
pub fn run()->num{
    let source=bytes();push(source,7);
    let left="left";let right="right";
    let old=ops::replace(borrow_mut(left),right);
    let record=ops::Record{count:7,name:"data"};
    let previous=ops::update(borrow_mut(record));
    ops::grow(borrow_mut(source),9);
    return len(left)+len(old)+previous+len(record.name)+record.count+at(read(source),1);
}
