module values;
use ops;
pub fn run()->num{
    var source =bytes();push(source,7);
    var left ="left";right :="right";
    old :=ops::replace(borrow_mut(left),right);
    var record =ops::Record{count:7,name:"data"};
    previous :=ops::update(borrow_mut(record));
    ops::grow(borrow_mut(source),9);
    return len(left)+len(old)+previous+len(record.name)+record.count+at(read(source),1);
}
