module use_views;
use views;
struct Pointer<a>{value:ref<a,num>}
pub fn run()->num{
    let source=bytes();push(source,7);
    let cursor=views::Cursor{source:read(source),name:"owned"};
    let span=views::source(borrow(cursor));drop(cursor);
    let first=at(span,0)+len(span);
    push(source,8);
    let unique=views::Unique{source:mut(source),name:"unique"};
    let child=views::short(borrow(unique));
    let second=at(child,1)+len(child);
    drop(unique);push(source,9);
    var number=11;
    let holder=Pointer{value:borrow(number)};
    let pointer=views::pointer(borrow(holder.value));drop(holder);
    let third=load(pointer);
    let last=views::inspect(read(source));
    return first+second+third+last;
}
