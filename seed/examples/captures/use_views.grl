module use_views;
use views;
struct Pointer<a>{value:ref<a,num>}
pub fn run()->num{
    var source =bytes();push(source,7);
    cursor :=views::Cursor{source:read(source),name:"owned"};
    span :=views::source(borrow(cursor));drop(cursor);
    first :=at(span,0)+len(span);
    push(source,8);
    unique :=views::Unique{source:mut(source),name:"unique"};
    child :=views::short(borrow(unique));
    second :=at(child,1)+len(child);
    drop(unique);push(source,9);
    var number=11;
    holder :=Pointer{value:borrow(number)};
    pointer :=views::pointer(borrow(holder.value));drop(holder);
    third :=load(pointer);
    last :=views::inspect(read(source));
    return first+second+third+last;
}
