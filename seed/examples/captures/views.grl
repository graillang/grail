module views;
pub struct Cursor<a>{source:read<a>,name:string}
pub struct Unique<a>{source:mut<a>,name:string}
pub fn source<outer,data>(cursor:ref<outer,Cursor<data>>)->read<data>{return read(cursor.source);}
pub fn short<outer,data>(cursor:ref<outer,Unique<data>>)->read<outer>{return read(cursor.source);}
pub fn descriptor<outer,data>(slot:ref<outer,read<data>>)->read<data>{return load(slot);}
pub fn peek<outer,data>(slot:ref<outer,read<data>>)->read<data>{return read(slot);}
pub fn pointer<outer,data>(slot:ref<outer,ref<data,num>>)->ref<data,num>{return load(slot);}
pub fn inspect<type T>(value:T)->num{let frame=borrow(value);return 7;}
